                            add(assignTernAddOp.operands, assignTernFalseSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, assignTernAddOp)
                            assignTernDone = true
        if assignTernDone:
            return true
    var cmpAssignGate = false
    let assignLogicalRoot = PrimaryBodyIrConditionHasAnd(rhsText) ||
                            PrimaryBodyIrConditionHasOr(rhsText)
    if assignTernQPos > 0 || assignLogicalRoot:
        # Ternary and top-level logical rhs values are not comparison roots.
        # A nested compare inside `a == b && f()` used to claim this gate,
        # which then rejected the logical chain and emitted InvalidOp(718)
        # before the CBR short-circuit assigner below could consume it.
        cmpAssignGate = false
    elif texpr.TypedExprFindTopLevelTextToken(rhsText, "==") > 0 ||
       texpr.TypedExprFindTopLevelTextToken(rhsText, "!=") > 0 ||
       texpr.TypedExprFindTopLevelTextToken(rhsText, "<=") > 0 ||
       texpr.TypedExprFindTopLevelTextToken(rhsText, ">=") > 0:
        cmpAssignGate = true
    if !cmpAssignGate && !assignLogicalRoot:
        let cmpLtPos = texpr.TypedExprFindTopLevelTextToken(rhsText, "<")
        if cmpLtPos > 0 &&
           cmpLtPos + 1 < len(rhsText) &&
           rhsText[cmpLtPos + 1] != '<' &&
           rhsText[cmpLtPos - 1] != '<':
            cmpAssignGate = true
    if !cmpAssignGate && !assignLogicalRoot:
        let cmpGtPos = texpr.TypedExprFindTopLevelTextToken(rhsText, ">")
        if cmpGtPos > 0 &&
           cmpGtPos + 1 < len(rhsText) &&
           rhsText[cmpGtPos + 1] != '>' &&
           rhsText[cmpGtPos - 1] != '>':
            cmpAssignGate = true
    if assignTernQPos > 0:
        cmpAssignGate = false
    if cmpAssignGate:
        # Element-target comparison assign: `flags[i] = a > b`. The flat-slot
        # cmp-assign below keys the Cmp target by the raw LHS text, so an indexed
        # LHS would land the 0/1 result in a scratch slot named "flags[i]" and
        # never touch the array cell (the later `if flags[i]` re-reads the
        # unwritten element — silent miscompile). Materialize the comparison into
        # a real 0/1 value and store it through the element address, mirroring the
        # plain indexed-store path. Only a fixed-array aggregate root is handled;
        # anything else falls through to the flat path unchanged.
        var cmpIdxRoot = ""
        var cmpIdxText = ""
        if PrimaryBodyIrIndexExprParts(lhsName, cmpIdxRoot, cmpIdxText):
            let cmpIdxRootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, cmpIdxRoot)
            if cmpIdxRootSlot >= 0 &&
               cmpIdxRootSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[cmpIdxRootSlot].typeKind == coreir.LocalAggregateTag:
                var cmpIdxElemKind = coreir.LocalI32Tag
                var cmpIdxElemSize = 4
                var cmpIdxSeqElemKind: int32
                var cmpIdxSeqElemSize: int32
                let cmpIdxRootTypeText = texpr.TypedExprStripVarType(stmt_assignRootType)
                if PrimaryBodyIrSeqElementShapeFromText(lowering.typedIr,
                                                        stmt_sourcePath,
                                                        cmpIdxRootTypeText,
                                                        cmpIdxSeqElemKind,
                                                        cmpIdxSeqElemSize):
                    cmpIdxElemKind = cmpIdxSeqElemKind
                    cmpIdxElemSize = cmpIdxSeqElemSize
                # T78 v4: bare-root sibling of PrimaryBodyIrConditionFieldOperandSlot's
                # bareRootSlot fix — this comparison-assign element store
                # (`flags[i] = a > b`) shares the exact same FIXED-array
                # elemSize divergence: a fixed bool[N] array's inline element
                # slots are laid out at TypeShapeFromText's aligned register
                # width (4B), not the 1B packed width SeqElementShapeFromText
                # hands back for a GROWABLE seq's heap buffer. Dynamic seqs
                # keep the packed width (cmpIdxRootSlot is only ever resolved
                # via FindArgSlot on the bare index root, so a dotted struct-
                # field root never reaches this branch).
                if !PrimaryBodyIrTypeTextIsDynamicSeq(cmpIdxRootTypeText):
                    let cmpIdxFixedElemTypeText = PrimaryBodyIrIndexedElementTypeText(cmpIdxRootTypeText)
                    if cmpIdxFixedElemTypeText != "":
                        var cmpIdxFixedShapeKind: int32
                        var cmpIdxFixedShapeSize: int32
                        var cmpIdxFixedShapeAlign: int32
                        PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                       stmt_sourcePath,
                                                       cmpIdxFixedElemTypeText,
                                                       cmpIdxFixedShapeKind,
                                                       cmpIdxFixedShapeSize,
                                                       cmpIdxFixedShapeAlign)
                        if cmpIdxFixedShapeSize > 0 && cmpIdxFixedShapeSize >= cmpIdxElemSize:
                            cmpIdxElemSize = cmpIdxFixedShapeSize
                # T78 current (#134 根修): a growable seq local's aggregate slot holds
                # the {len,ptr} header inline — the element address needs one
                # extra `ldr [header,#8]` indirection to reach the heap buffer
                # before adding the index*elemSize stride (mirrors the generic
                # PrimaryBodyIrAppendSimpleIndexedAssign's `indexedStoreIsSeq`
                # flag at line ~43902 and the read-side `fieldIsDynamicSeq` flag
                # at ~11544). This retired cmpAssignGate/cmpIdxStoreOp builder
                # never set that flag, so a dynamic-seq target's store address
                # computation stopped one `ldr` short of the buffer and wrote
                # the value byte into the header struct itself (corrupting
                # `len`'s low byte) instead of the seq element — the real
                # element buffer kept its stale prior value, a silent
                # miscompile hidden behind T78's old eager-`&&` crash.
                let cmpIdxIsSeq = PrimaryBodyIrTypeTextIsDynamicSeq(cmpIdxRootTypeText)
                if cmpIdxElemKind == coreir.LocalI32Tag:
                    var cmpIdxValueSlot = PrimaryBodyIrCondValue01Slot(bodyIR,
                                                                       slotNames,
                                                                       lowering,

                                                                       typedFn,
                                                                       irFunction,
                                                                       stmt_sourcePath,
                                                                       stmt_lineNumber,
                                                                       rhsText,
                                                                       Fmt"#cmp_idx_store#{stmt_lineNumber}#{bodyIR.ops.len}",
                                                                       callOrdinal)
                    # T78: CondValue01Slot bails(-1) on `&&`/`||` text whose
                    # operand has a faulting eager surface (call/下标) — e.g.
                    # `flags[i] = j < arr.len && arr[j]` (cmpAssignGate fires on
                    # the `<`). Fall to the real CBR-chain assigner instead of
                    # leaving the element unwritten.
                    if cmpIdxValueSlot < 0:
                        let cmpIdxCbrScratchSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                 slotNames,
                                                                                 Fmt"#cmp_idx_store_cbr#{stmt_lineNumber}#{bodyIR.ops.len}",
                                                                                 coreir.LocalI32Tag)
                        if cmpIdxCbrScratchSlot >= 0:
                            var cmpIdxCbrBlockStart = currentBlockStart
                            if PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                                      slotNames,
                                                                      lowering,

                                                                      typedFn,
                                                                      irFunction,
                                                                      stmt_sourcePath,
                                                                      stmt_lineNumber,
                                                                      rhsText,
                                                                      cmpIdxCbrScratchSlot,
                                                                      callOrdinal,
                                                                      cmpIdxCbrBlockStart):
                                currentBlockStart = cmpIdxCbrBlockStart
                                cmpIdxValueSlot = cmpIdxCbrScratchSlot
                    let cmpIdxIndexSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                              slotNames,
                                                                              varI32ParamNames,
                                                                              lowering.typedIr,
                                                                              stmt_sourcePath,
                                                                              cmpIdxText,
                                                                              coreir.LocalI32Tag,
                                                                              callOrdinal)
                    if cmpIdxValueSlot >= 0 && cmpIdxIndexSlot >= 0:
                        var cmpIdxStoreOp: coreir.BodyOp
                        cmpIdxStoreOp.kind = coreir.BodyOpIndexedStoreTag
                        cmpIdxStoreOp.target = cmpIdxRootSlot
                        add(cmpIdxStoreOp.operands, cmpIdxRootSlot)
                        add(cmpIdxStoreOp.operands, cmpIdxValueSlot)
                        add(cmpIdxStoreOp.operands, cmpIdxIndexSlot)
                        add(cmpIdxStoreOp.operands, cmpIdxElemSize)
                        if cmpIdxIsSeq:
                            add(cmpIdxStoreOp.operands, 1)
                        let _ = coreir.BodyIRAppendOp(bodyIR, cmpIdxStoreOp)
                        return true
        # Comparison assign: lhs = a <op> b lowers to a Cmp op (0/1 result).
        var cmpAssignLhs: int32
        var cmpAssignRhs: int32
        var cmpAssignTag: int32
        var cmpAssignNextOpIndex: int32
        if PrimaryBodyIrEmitConditionOps(bodyIR,
                                         slotNames,
                                         lowering,

                                         typedFn,
                                         irFunction,
                                         stmt_sourcePath,
                                         stmt_lineNumber,
                                         stmt_rhsNodeIndex,
                                         rhsText,
                                         cmpAssignLhs,
                                         cmpAssignRhs,
                                         cmpAssignTag,
                                         callOrdinal,
                                         cmpAssignNextOpIndex):
            if cmpAssignLhs >= 0 && cmpAssignRhs >= 0:
                if stmt_assignFieldName != "":
                    # Field assign whose RHS is a bare comparison (e.g. `state.initiator =
                    # a == b`): here `lhsName` is only the ROOT object name (see the
                    # assignFieldName branch above), never the dotted field path — a plain
                    # FindOrCreateSlot(lhsName, LocalI32Tag) would (a) alias the Cmp's result
                    # onto the ROOT's own aggregate slot (never a scalar temp) and (b), as a
                    # FindOrCreateSlot side effect, silently rewrite that slot's typeKind from
                    # LocalAggregateTag to LocalI32Tag — corrupting every later statement's
                    # view of the root object's shape for the rest of the function. Route
                    # through a real field store instead: Cmp into a fresh scratch temp, then
                    # FieldStoreTag the temp into the field (mirrors every other field-store
                    # site in this file, e.g. PrimaryBodyIrAppendSimpleFieldAssignFast).
                    let cmpFieldBaseSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
                    var cmpFieldRootType = strings.CloneStr(stmt_assignRootType)
                    if texpr.TypedExprNormalizeTypeText(cmpFieldRootType) == "" ||
                       !PrimaryObjectMetadataTextStable(cmpFieldRootType):
                        cmpFieldRootType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                           typedFn,
                                                                           irFunction,
                                                                           stmt_lineNumber,
                                                                           lhsName)
                    var cmpFieldType = ""
                    var cmpFieldOffsetBytes: int32
                    var cmpFieldSizeBytes: int32
                    var cmpFieldAlignBytes: int32
                    if cmpFieldBaseSlot >= 0 &&
                       PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                                          stmt_sourcePath,
                                                          cmpFieldRootType,
                                                          stmt_assignFieldName,
                                                          cmpFieldType,
                                                          cmpFieldOffsetBytes,
                                                          cmpFieldSizeBytes,
                                                          cmpFieldAlignBytes) &&
                       cmpFieldOffsetBytes >= 0 &&
                       (cmpFieldSizeBytes == 4 || cmpFieldSizeBytes == 1):
                        let cmpFieldScratchSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                               slotNames,
                                                                               Fmt"#cmpfield#{stmt_lineNumber}#{bodyIR.ops.len}",
                                                                               coreir.LocalI32Tag)
                        if cmpFieldScratchSlot >= 0:
                            var cmpFieldOp: coreir.BodyOp
                            cmpFieldOp.kind = coreir.BodyOpCmpTag
                            cmpFieldOp.target = cmpFieldScratchSlot
                            add(cmpFieldOp.operands, cmpAssignTag)
                            add(cmpFieldOp.operands, cmpAssignLhs)
                            add(cmpFieldOp.operands, cmpAssignRhs)
                            let _ = coreir.BodyIRAppendOp(bodyIR, cmpFieldOp)
                            var cmpFieldStoreOp: coreir.BodyOp
                            cmpFieldStoreOp.kind = coreir.BodyOpFieldStoreTag
                            cmpFieldStoreOp.target = cmpFieldBaseSlot
                            add(cmpFieldStoreOp.operands, cmpFieldBaseSlot)
                            add(cmpFieldStoreOp.operands, cmpFieldScratchSlot)
                            add(cmpFieldStoreOp.operands, cmpFieldOffsetBytes)
                            add(cmpFieldStoreOp.operands, cmpFieldSizeBytes)
                            let _ = coreir.BodyIRAppendOp(bodyIR, cmpFieldStoreOp)
                            return true
                    # Array-indexed field assign whose RHS is a bare comparison, e.g.
                    # `slots.useLenField[idx] = bridge() != 0` (udpSlotResetAt,
                    # datapath_udp.cheng). Here `stmt_assignFieldName` carries the
                    # bracket suffix ("useLenField[idx]"); LookupSingleFieldMeta's
                    # ParserIdentPrefix strips it and resolves the WHOLE array field
                    # (fieldSizeBytes=64 for bool[64]) — never {1,4} — so the plain
                    # scalar branch above always misses this shape and would poison
                    # every indexed-field comparison store, not just the genuinely
                    # unsupported ones (struct-array subfield / non-1/4 element).
                    # Parse the `arrayField[idx]` shape (no trailing `.subField` —
                    # that shape is PrimaryBodyIrFieldArrayIndexedSubFieldParts's,
                    # handled elsewhere), resolve the ARRAY field's meta, derive the
                    # element type/size, and — only for a fixed (non-dynamic-seq)
                    # array whose element is 1 or 4 bytes — compute the real element
                    # address (base + arrayFieldOffset + idx*elemSize, mirroring
                    # PrimaryBodyIrFieldArrayIndexedElemAddrSlot's fixed-array branch)
                    # and FieldStore the Cmp result there. Any other shape (dynamic
                    # seq, aggregate element, unresolved meta) falls through to the
                    # existing poison — still severely typed, never a silent store.
                    var cmpIdxFieldArray = ""
                    var cmpIdxFieldIndexText = ""
                    let cmpIdxFieldOpenPos = parser.ParserFindText(stmt_assignFieldName, "[")
                    if cmpIdxFieldOpenPos > 0:
                        var cmpIdxFieldClosePos = -1
                        var cmpIdxFieldScan = cmpIdxFieldOpenPos
                        var cmpIdxFieldDepth: int32
                        while cmpIdxFieldScan < len(stmt_assignFieldName):
                            if stmt_assignFieldName[cmpIdxFieldScan] == '[':
                                cmpIdxFieldDepth = cmpIdxFieldDepth + 1
                            elif stmt_assignFieldName[cmpIdxFieldScan] == ']':
                                cmpIdxFieldDepth = cmpIdxFieldDepth - 1
                                if cmpIdxFieldDepth == 0:
                                    cmpIdxFieldClosePos = cmpIdxFieldScan
                                    break
                            cmpIdxFieldScan = cmpIdxFieldScan + 1
                        if cmpIdxFieldClosePos == len(stmt_assignFieldName) - 1:
                            cmpIdxFieldArray = strutil.Strip(strings.SliceBytes(stmt_assignFieldName,
                                                                                0,
                                                                                cmpIdxFieldOpenPos))
                            cmpIdxFieldIndexText = strutil.Strip(strings.SliceBytes(stmt_assignFieldName,
                                                                                    cmpIdxFieldOpenPos + 1,
                                                                                    cmpIdxFieldClosePos - cmpIdxFieldOpenPos - 1))
                    if cmpFieldBaseSlot >= 0 && cmpIdxFieldArray != "" && cmpIdxFieldIndexText != "":
                        var cmpIdxFieldArrayType = ""
                        var cmpIdxFieldArrayOffsetBytes: int32
                        var cmpIdxFieldArraySizeBytes: int32
                        var cmpIdxFieldArrayAlignBytes: int32
                        if PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                                              stmt_sourcePath,
                                                              cmpFieldRootType,
                                                              cmpIdxFieldArray,
                                                              cmpIdxFieldArrayType,
                                                              cmpIdxFieldArrayOffsetBytes,
                                                              cmpIdxFieldArraySizeBytes,
                                                              cmpIdxFieldArrayAlignBytes) &&
                           cmpIdxFieldArrayOffsetBytes >= 0 &&
                           !PrimaryBodyIrTypeTextIsDynamicSeq(cmpIdxFieldArrayType):
                            let cmpIdxFieldElemType = PrimaryBodyIrIndexedElementTypeText(cmpIdxFieldArrayType)
                            if cmpIdxFieldElemType != "":
                                var cmpIdxFieldElemKind = coreir.LocalInvalidTag
                                var cmpIdxFieldElemSize: int32
                                var cmpIdxFieldElemAlign: int32
                                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                               stmt_sourcePath,
                                                               cmpIdxFieldElemType,
                                                               cmpIdxFieldElemKind,
                                                               cmpIdxFieldElemSize,
                                                               cmpIdxFieldElemAlign)
                                if cmpIdxFieldElemSize == 4 || cmpIdxFieldElemSize == 1:
                                    let cmpIdxFieldArrBaseSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                                                                   slotNames,
                                                                                                   stmt_lineNumber,
                                                                                                   cmpFieldBaseSlot,
                                                                                                   cmpIdxFieldArrayOffsetBytes)
                                    let cmpIdxFieldIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                                                  slotNames,
                                                                                                  varI32ParamNames,
                                                                                                  lowering.typedIr,
                                                                                                  stmt_sourcePath,
                                                                                                  cmpIdxFieldIndexText,
                                                                                                  coreir.LocalI32Tag,
                                                                                                  callOrdinal)
                                    if cmpIdxFieldArrBaseSlot >= 0 && cmpIdxFieldIdxSlot >= 0:
                                        let cmpIdxFieldEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                                                  slotNames,
                                                                                                  Fmt"#cmpidxfesz#{stmt_lineNumber}#{bodyIR.ops.len}",
                                                                                                  coreir.LocalI64Tag,
                                                                                                  cmpIdxFieldElemSize)
                                        let cmpIdxFieldAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                                 slotNames,
                                                                                                 Fmt"#cmpidxfaddr#{stmt_lineNumber}#{bodyIR.ops.len}",
                                                                                                 coreir.LocalPtrTag)
                                        if cmpIdxFieldEszSlot >= 0 && cmpIdxFieldAddrSlot >= 0:
                                            var cmpIdxFieldAddrOp: coreir.BodyOp
                                            cmpIdxFieldAddrOp.kind = coreir.BodyOpBinOpTag
                                            cmpIdxFieldAddrOp.target = cmpIdxFieldAddrSlot
                                            add(cmpIdxFieldAddrOp.operands, coreir.LocalI64Tag)
                                            add(cmpIdxFieldAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
                                            add(cmpIdxFieldAddrOp.operands, cmpIdxFieldIdxSlot)
                                            add(cmpIdxFieldAddrOp.operands, cmpIdxFieldEszSlot)
                                            add(cmpIdxFieldAddrOp.operands, cmpIdxFieldArrBaseSlot)
                                            let _ = coreir.BodyIRAppendOp(bodyIR, cmpIdxFieldAddrOp)
                                            let cmpIdxFieldScratchSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                                        slotNames,
                                                                                                        Fmt"#cmpidxfval#{stmt_lineNumber}#{bodyIR.ops.len}",
                                                                                                        coreir.LocalI32Tag)
                                            if cmpIdxFieldScratchSlot >= 0:
                                                var cmpIdxFieldCmpOp: coreir.BodyOp
                                                cmpIdxFieldCmpOp.kind = coreir.BodyOpCmpTag
                                                cmpIdxFieldCmpOp.target = cmpIdxFieldScratchSlot
                                                add(cmpIdxFieldCmpOp.operands, cmpAssignTag)
                                                add(cmpIdxFieldCmpOp.operands, cmpAssignLhs)
                                                add(cmpIdxFieldCmpOp.operands, cmpAssignRhs)
                                                let _ = coreir.BodyIRAppendOp(bodyIR, cmpIdxFieldCmpOp)
                                                var cmpIdxFieldStoreOp: coreir.BodyOp
                                                cmpIdxFieldStoreOp.kind = coreir.BodyOpFieldStoreTag
                                                cmpIdxFieldStoreOp.target = cmpIdxFieldAddrSlot
                                                add(cmpIdxFieldStoreOp.operands, cmpIdxFieldAddrSlot)
                                                add(cmpIdxFieldStoreOp.operands, cmpIdxFieldScratchSlot)
                                                add(cmpIdxFieldStoreOp.operands, 0)
                                                add(cmpIdxFieldStoreOp.operands, cmpIdxFieldElemSize)
                                                let _ = coreir.BodyIRAppendOp(bodyIR, cmpIdxFieldStoreOp)
                                                return true
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt_lineNumber,
                                                 int32(stmt_kind),
                                                 718,
                                                 0)
                    return true
                # 全局 LHS（`gBool = a == b`）必须落 GlobalStore；此前无条件
                # 按裸名字建局部槽把 Cmp 结果写局部——全局从未被真正写入，
                # 之后读它的语句(如同函数内下一次 `if gBool:`)读到栈残留
                # （形态⑪ 主缺陷：全局被静默局部化）。镜像下方标量全局赋值
                # 分支的 GlobalStore 落法：先判局部同名是否遮蔽全局，否则
                # 查全局槽名，命中则落全局 store；否则保留原局部槽行为。
                var cmpAssignLocalShadowsGlobal = false
                let cmpAssignExistingLocal = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
                if cmpAssignExistingLocal >= 0 &&
                   cmpAssignExistingLocal < bodyIR.localSlots.len &&
                   bodyIR.localSlots[cmpAssignExistingLocal].placeKind != coreir.BodyPlaceGlobalAddressTag &&
                   !stmt_assignRootGlobalFlag:
                    cmpAssignLocalShadowsGlobal = true
                var cmpAssignGlobalSlotName = ""
                if stmt_assignFieldName == "" && !cmpAssignLocalShadowsGlobal:
                    cmpAssignGlobalSlotName = PrimaryBodyIrTypedGlobalSlotName(lowering.typedIr, stmt_sourcePath, lhsName)
                    if cmpAssignGlobalSlotName == "" &&
                       stmt_assignRootGlobalFlag &&
                       stmt_assignRootSourcePath != "":
                        cmpAssignGlobalSlotName = Fmt"{stmt_assignRootSourcePath}::{lhsName}"
                if cmpAssignGlobalSlotName != "":
                    let cmpAssignValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                          slotNames,
                                                                          Fmt"{lhsName}#cmp_assign_value#{stmt_lineNumber}",
                                                                          coreir.LocalI32Tag)
                    if cmpAssignValueSlot >= 0:
                        var cmpAssignValueOp: coreir.BodyOp
                        cmpAssignValueOp.kind = coreir.BodyOpCmpTag
                        cmpAssignValueOp.target = cmpAssignValueSlot
                        add(cmpAssignValueOp.operands, cmpAssignTag)
                        add(cmpAssignValueOp.operands, cmpAssignLhs)
                        add(cmpAssignValueOp.operands, cmpAssignRhs)
                        let _ = coreir.BodyIRAppendOp(bodyIR, cmpAssignValueOp)
                        let cmpAssignGlobalSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                               slotNames,
                                                                               cmpAssignGlobalSlotName,
                                                                               coreir.LocalI32Tag)
                        PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, cmpAssignGlobalSlot)
                        bodyIR.localSlots[cmpAssignGlobalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
                        var cmpAssignStoreOp: coreir.BodyOp
                        cmpAssignStoreOp.kind = coreir.BodyOpGlobalStoreTag
                        cmpAssignStoreOp.target = cmpAssignValueSlot
                        add(cmpAssignStoreOp.operands, cmpAssignGlobalSlot)
                        let _ = coreir.BodyIRAppendOp(bodyIR, cmpAssignStoreOp)
                        return true
                else:
                    let cmpAssignTarget = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                        slotNames,
                                                                        lhsName,
                                                                        coreir.LocalI32Tag)
                    if cmpAssignTarget >= 0:
                        var cmpAssignOp: coreir.BodyOp
                        cmpAssignOp.kind = coreir.BodyOpCmpTag
                        cmpAssignOp.target = cmpAssignTarget
                        add(cmpAssignOp.operands, cmpAssignTag)
                        add(cmpAssignOp.operands, cmpAssignLhs)
                        add(cmpAssignOp.operands, cmpAssignRhs)
                        let _ = coreir.BodyIRAppendOp(bodyIR, cmpAssignOp)
                        return true
        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                     stmt_lineNumber,
                                     int32(stmt_kind),
                                     718,
                                     0)
        return true
    # (c)族①: `已声明变量 = Value(res)` 赋值形态——前端把 callTarget 填成裸
    # "Value"(result.cheng 泛型模板, 无可解析函数体), 本分支若把它当真调用
    # 经 AppendCallOp 走 ABI 实参装配, 必然 missing_call_target(rsa.cheng:2294
    # rsaPssSignatureScratchLen 实锤)。Value 不是真调用——像下方
    # PrimaryBodyIrTextHasCallSurface 分支那样让位给 AppendWholeCallExprToSlot
    # 的 Value 内征投影臂(镜像 let/return 直接 RHS 形态的既有处理)。
    if stmt_callTarget != "" && PrimaryCallTargetTailName(stmt_callTarget) != "Value":
        let existingLhsSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
        if existingLhsSlot >= 0:
            var existingResultTypeText = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
            if existingResultTypeText == "" || existingResultTypeText == "unknown":
                existingResultTypeText = stmt_resultType
            let existingLhsKind = PrimaryBodyIrSlotType(bodyIR, existingLhsSlot)
            if existingLhsKind == coreir.LocalPtrTag &&
               texpr.TypedExprNormalizeTypeText(existingResultTypeText) == "str":
                let tempSlotName = strutil.Join([strings.CloneStr(lhsName),
                                                 "#assign_call_str#",
                                                 strings.IntToStr(stmt_lineNumber)], "")
                let tempSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                             slotNames,
                                                             tempSlotName,
                                                             coreir.LocalStrTag)
                if tempSlot < 0:
                    return false
                let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                  slotNames,
                                                  lowering,

                                                  typedFn,
                                                  irFunction,
                                                  stmt,
                                                  tempSlot,
                                                  varI32ParamNames,
                                                  callOrdinal,
                                                  currentBlockStart)
                PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                                     existingLhsSlot,
                                                     tempSlot,
                                                     24)
                return true
            if existingLhsKind == coreir.LocalStrTag ||
               existingLhsKind == coreir.LocalI32Tag ||
               existingLhsKind == coreir.LocalI64Tag ||
               existingLhsKind == coreir.LocalPtrTag ||
               existingLhsKind == coreir.LocalAggregateTag:
                let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                  slotNames,
                                                  lowering,

                                                  typedFn,
                                                  irFunction,
                                                  stmt,
                                                  existingLhsSlot,
                                                  varI32ParamNames,
                                                  callOrdinal,
                                                  currentBlockStart)
                return true
        if existingLhsSlot < 0:
            var resultTypeText = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
            if resultTypeText == "" || resultTypeText == "unknown":
                resultTypeText = stmt_resultType
            if resultTypeText == "" || resultTypeText == "unknown":
                return false
            # Global lhs with a call rhs: the result must store through the
            # global; a same-named local would orphan the assignment.
            let lhsCallGlobalType = PrimaryBodyIrTypedGlobalType(lowering.typedIr, stmt_sourcePath, lhsName)
            if lhsCallGlobalType != "" &&
               PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                               typedFn,
                                               irFunction,
                                               stmt_lineNumber,
                                               lhsName) == "":
                var lhsCallGlobalKind: int32
                var lhsCallGlobalSize: int32
                var lhsCallGlobalAlign: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               stmt_sourcePath,
                                               lhsCallGlobalType,
                                               lhsCallGlobalKind,
                                               lhsCallGlobalSize,
                                               lhsCallGlobalAlign)
                if lhsCallGlobalKind == coreir.LocalI32Tag ||
                   lhsCallGlobalKind == coreir.LocalI64Tag ||
                   lhsCallGlobalKind == coreir.LocalPtrTag:
                    let lhsCallGlobalSlotName = PrimaryBodyIrTypedGlobalSlotName(lowering.typedIr,
                                                                                 stmt_sourcePath,
                                                                                 lhsName)
                    if lhsCallGlobalSlotName != "":
                        let lhsCallValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                             slotNames,
                                                                             Fmt"{lhsName}#global_call_value#{stmt_lineNumber}",
                                                                             lhsCallGlobalKind)
                        if lhsCallValueSlot >= 0:
                            let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                              slotNames,
                                                              lowering,

                                                              typedFn,
                                                              irFunction,
                                                              stmt,
                                                              lhsCallValueSlot,
                                                              varI32ParamNames,
                                                              callOrdinal,
                                                              currentBlockStart)
                            let lhsCallGlobalSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                  slotNames,
                                                                                  lhsCallGlobalSlotName,
                                                                                  lhsCallGlobalKind)
                            PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, lhsCallGlobalSlot)
                            bodyIR.localSlots[lhsCallGlobalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
                            var lhsCallStoreOp: coreir.BodyOp
                            lhsCallStoreOp.kind = coreir.BodyOpGlobalStoreTag
                            lhsCallStoreOp.target = lhsCallValueSlot
                            add(lhsCallStoreOp.operands, lhsCallGlobalSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, lhsCallStoreOp)
                            return true
                if lhsCallGlobalKind == coreir.LocalStrTag:
                    # A managed sret must land in an owned local record first;
                    # the move-store runtime primitive releases the old global
                    # value and transfers this exact result without an extra rc.
                    let lhsStrGlobalSlotName = PrimaryBodyIrTypedGlobalSlotName(lowering.typedIr,
                                                                                stmt_sourcePath,
                                                                                lhsName)
                    if lhsStrGlobalSlotName != "":
                        let lhsStrGlobalSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                                  slotNames,
                                                                                  lowering.typedIr,
                                                                                  stmt_sourcePath,
                                                                                  lhsStrGlobalSlotName,
                                                                                  lhsCallGlobalType)
                        if lhsStrGlobalSlot >= 0 &&
                           lhsStrGlobalSlot < bodyIR.localSlots.len &&
                           PrimaryBodyIrSlotType(bodyIR, lhsStrGlobalSlot) == coreir.LocalStrTag &&
                           PrimaryLocalSlotSizeOf(bodyIR.localSlots[lhsStrGlobalSlot]) == 24:
                            let lhsStrCallValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(
                                bodyIR,
                                slotNames,
                                lowering.typedIr,
                                stmt_sourcePath,
                                Fmt"#global_call_str_value#{stmt_lineNumber}",
                                lhsCallGlobalType)
                            if lhsStrCallValueSlot < 0 ||
                               lhsStrCallValueSlot >= bodyIR.localSlots.len ||
                               PrimaryBodyIrSlotType(bodyIR, lhsStrCallValueSlot) != coreir.LocalStrTag:
                                let panicMsg = Fmt"primary: managed global call result slot unavailable source={stmt_sourcePath} line={stmt_lineNumber}"
                                panic(panicMsg)
                            PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, lhsStrGlobalSlot)
                            bodyIR.localSlots[lhsStrGlobalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
                            let lhsStrCallCountBefore = bodyIR.callSequence.len
                            let lhsStrCallEmitSlot = PrimaryBodyIrAppendCallOp(bodyIR,
                                                                              slotNames,
                                                                              lowering,

                                                                              typedFn,
                                                                              irFunction,
                                                                              stmt,
                                                                              lhsStrCallValueSlot,
                                                                              varI32ParamNames,
                                                                              callOrdinal,
                                                                              currentBlockStart)
                            if lhsStrCallEmitSlot != lhsStrCallValueSlot ||
                               bodyIR.callSequence.len <= lhsStrCallCountBefore ||
                               bodyIR.callSequence[bodyIR.callSequence.len - 1].resultSlot != lhsStrCallValueSlot:
                                let panicMsg = Fmt"primary: managed global str call emission failed source={stmt_sourcePath} line={stmt_lineNumber}"
                                panic(panicMsg)
                            if !PrimaryBodyIrAppendManagedGlobalStore(bodyIR,
                                                                     lowering,
                                                                     lhsStrGlobalSlot,
                                                                     lhsStrCallValueSlot,
                                                                     PrimaryBodyIrManagedSemanticValueDefinitionRowExact(
                                                                         lowering.typedIr, stmt_rhsNodeIndex),
                                                                     callOrdinal):
                                let panicMsg = Fmt"primary: managed global call store unavailable source={stmt_sourcePath} line={stmt_lineNumber}"
                                panic(panicMsg)
                            return true
                if lhsCallGlobalKind == coreir.LocalAggregateTag && lhsCallGlobalSize > 0:
                    # Managed dynamic-seq sret uses an owned local plus move-store;
                    # only proven plain inline aggregates may sret directly global.
                    let lhsAggGlobalSlotName = PrimaryBodyIrTypedGlobalSlotName(lowering.typedIr,
                                                                                stmt_sourcePath,
                                                                                lhsName)
                    if lhsAggGlobalSlotName != "":
                        let lhsAggGlobalSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                                  slotNames,
                                                                                  lowering.typedIr,
                                                                                  stmt_sourcePath,
                                                                                  lhsAggGlobalSlotName,
                                                                                  lhsCallGlobalType)
                        if lhsAggGlobalSlot >= 0 &&
                           lhsAggGlobalSlot < bodyIR.localSlots.len &&
                           PrimaryBodyIrSlotType(bodyIR, lhsAggGlobalSlot) == coreir.LocalAggregateTag &&
                           PrimaryLocalSlotSizeOf(bodyIR.localSlots[lhsAggGlobalSlot]) >= lhsCallGlobalSize:
                            PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, lhsAggGlobalSlot)
                            bodyIR.localSlots[lhsAggGlobalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
                            if PrimaryBodyIrTypeTextIsDynamicSeq(lhsCallGlobalType):
                                let lhsAggCallValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(
                                    bodyIR,
                                    slotNames,
                                    lowering.typedIr,
                                    stmt_sourcePath,
                                    Fmt"#global_call_seq_value#{stmt_lineNumber}",
                                    lhsCallGlobalType)
                                if lhsAggCallValueSlot < 0:
                                    let panicMsg = Fmt"primary: managed sequence call result slot unavailable source={stmt_sourcePath} line={stmt_lineNumber}"
                                    panic(panicMsg)
                                let lhsAggCallCountBefore = bodyIR.callSequence.len
                                let lhsAggCallEmitSlot = PrimaryBodyIrAppendCallOp(bodyIR,
                                                                                  slotNames,
                                                                                  lowering,

                                                                                  typedFn,
                                                                                  irFunction,
                                                                                  stmt,
                                                                                  lhsAggCallValueSlot,
                                                                                  varI32ParamNames,
                                                                                  callOrdinal,
                                                                                  currentBlockStart)
                                if lhsAggCallEmitSlot != lhsAggCallValueSlot ||
                                   bodyIR.callSequence.len <= lhsAggCallCountBefore ||
                                   bodyIR.callSequence[bodyIR.callSequence.len - 1].resultSlot != lhsAggCallValueSlot:
                                    let panicMsg = Fmt"primary: managed global sequence call emission failed source={stmt_sourcePath} line={stmt_lineNumber}"
                                    panic(panicMsg)
                                if !PrimaryBodyIrAppendManagedGlobalStore(bodyIR,
                                                                         lowering,
                                                                         lhsAggGlobalSlot,
                                                                         lhsAggCallValueSlot,
                                                                         PrimaryBodyIrManagedSemanticValueDefinitionRowExact(
                                                                             lowering.typedIr, stmt_rhsNodeIndex),
                                                                         callOrdinal):
                                    let panicMsg = Fmt"primary: managed sequence call global store unavailable source={stmt_sourcePath} line={stmt_lineNumber}"
                                    panic(panicMsg)
                            else:
                                let lhsAggCallValueSlot =
                                    PrimaryBodyIrFindOrCreateTypedSlot(
                                        bodyIR,
                                        slotNames,
                                        lowering.typedIr,
                                        stmt_sourcePath,
                                        Fmt"#global_call_aggregate_value#{stmt_rhsNodeIndex}",
                                        lhsCallGlobalType)
                                if lhsAggCallValueSlot < 0 ||
                                   lhsAggCallValueSlot ==
                                       lhsAggGlobalSlot:
                                    panic("primary: aggregate call result local unavailable")
                                let lhsAggCallEmitSlot =
                                    PrimaryBodyIrAppendCallOp(
                                        bodyIR,
                                        slotNames,
                                        lowering,

                                        typedFn,
                                        irFunction,
                                        stmt,
                                        lhsAggCallValueSlot,
                                        varI32ParamNames,
                                        callOrdinal,
                                        currentBlockStart)
                                if lhsAggCallEmitSlot !=
                                       lhsAggCallValueSlot ||
                                   !PrimaryBodyIrBindCanonicalAggregateCallGlobalStoreProof(
                                       bodyIR,
                                       lowering,

                                       stmt_sourcePath,
                                       lhsName,
                                       lhsAggGlobalSlot,
                                       lhsAggCallValueSlot,
                                       stmt_rhsNodeIndex):
                                    let panicMsg = Fmt"primary: canonical aggregate call global TypeArena proof unavailable source={stmt_sourcePath} line={stmt_lineNumber}"
                                    panic(panicMsg)
                                var lhsAggStoreOp: coreir.BodyOp
                                lhsAggStoreOp.kind =
                                    coreir.BodyOpGlobalStoreTag
                                lhsAggStoreOp.target =
                                    lhsAggCallValueSlot
                                add(lhsAggStoreOp.operands,
                                    lhsAggGlobalSlot)
                                let _ = coreir.BodyIRAppendOp(
                                    bodyIR, lhsAggStoreOp)
                            return true
            let resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                slotNames,
                                                                lowering.typedIr,
                                                                PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                                lhsName,
                                                                resultTypeText)
            if resultSlot < 0:
                return false
            let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                              slotNames,
                                              lowering,

                                              typedFn,
                                              irFunction,
                                              stmt,
                                              resultSlot,
                                              varI32ParamNames,
                                              callOrdinal,
                                              currentBlockStart)
            return true
    if stmt_callTarget == "" &&
       PrimaryBodyIrTextHasCallSurface(rhsText) &&
       PrimaryBodyIrHasSameLineCallForRhs(irFunction.statements,
                                          stmt_lineNumber,
                                          rhsText):
        PrimaryBodyIrNodeEvalOnlyOwn()
        return true
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_E function={typedFnName} line={stmt_lineNumber}")
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_F function={typedFnName} line={stmt_lineNumber}")
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_G function={typedFnName} line={stmt_lineNumber}")
    # A plain `ptr` local assigned a string literal (`var p: ptr; p = "..."`)
    # is a cstring-address store, not a str value store. Leave it for the
    # cstring-literal-assign path below; entering the str-literal block here
    # would mint a str-typed slot and reject the ptr slot as size-mismatched
    # (return false -> WCZ). Var-str params (Aggregate/aux=str) still belong
    # here, so only the non-param plain-ptr local is excluded.
    var litLhsIsPlainPtrLocal = false
    let litLhsSlotProbe = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
    if litLhsSlotProbe >= 0 &&
       litLhsSlotProbe < bodyIR.localSlots.len &&
       bodyIR.localSlots[litLhsSlotProbe].typeKind == coreir.LocalPtrTag &&
       !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[litLhsSlotProbe]) &&
       PrimaryBodyIrVarParamPointeeKind(bodyIR, litLhsSlotProbe) == coreir.LocalInvalidTag:
        litLhsIsPlainPtrLocal = true
    if PrimaryBodyIrTextIsStringLiteral(rhsText) && !litLhsIsPlainPtrLocal:
        var litSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
        var litGlobalLhs = false
        if litSlot < 0:
            # globals take the global-store path below
            if PrimaryBodyIrTypedGlobalType(lowering.typedIr, stmt_sourcePath, lhsName) != "" ||
               stmt_assignRootGlobalFlag:
                litGlobalLhs = true
            else:
                litSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                        slotNames,
                                                        lhsName,
                                                        coreir.LocalStrTag)
        if !litGlobalLhs:
            if litSlot < 0:
                return false
            # var str params hold the destination address: build the literal
            # in a unique temp str slot, then store the 24-byte value back
            # through the parameter.
            var litVarParamSlot: int32 = -1
            if bodyIR.localSlots[litSlot].typeKind != coreir.LocalStrTag &&
               PrimaryBodyIrLocalIsParam(bodyIR.localSlots[litSlot]):
                litVarParamSlot = litSlot
                litSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                        slotNames,
                                                        Fmt"{lhsName}#str_var#{stmt_lineNumber}",
                                                        coreir.LocalStrTag)
                if litSlot < 0:
                    return false
            if litSlot >= bodyIR.localSlots.len ||
               bodyIR.localSlots[litSlot].typeKind != coreir.LocalStrTag:
                return false
            let appendedLitValue = PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                                         slotNames,
                                                                         rhsText,
                                                                         litSlot,
                                                                         callOrdinal)
            if appendedLitValue && litVarParamSlot >= 0:
                PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                                     litVarParamSlot,
                                                     litSlot,
                                                     24)
            return appendedLitValue
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_H function={typedFnName} line={stmt_lineNumber}")
    let varStrParamLhsSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
    if varStrParamLhsSlot >= 0 &&
       varStrParamLhsSlot < bodyIR.localSlots.len &&
       bodyIR.localSlots[varStrParamLhsSlot].typeKind != coreir.LocalStrTag &&
       PrimaryBodyIrLocalIsParam(bodyIR.localSlots[varStrParamLhsSlot]) &&
       stmt_assignFieldName == "":
        let varStrParamRhsSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames,
                                                          strutil.Strip(rhsText))
        if varStrParamRhsSlot >= 0 &&
           varStrParamRhsSlot < bodyIR.localSlots.len &&
           PrimaryBodyIrSlotType(bodyIR, varStrParamRhsSlot) == coreir.LocalStrTag:
            PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                                 varStrParamLhsSlot,
                                                 varStrParamRhsSlot,
                                                 24)
            return true
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_I function={typedFnName} line={stmt_lineNumber}")
    if stmt_callTarget == "" &&
       len(lhsName) > 2 &&
       lhsName[len(lhsName) - 1] == ']':
        if PrimaryBodyIrAppendGlobalU8ArrayStore(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering.typedIr,
                                                 stmt_sourcePath,
                                                 lhsName,
                                                 rhsText,
                                                 callOrdinal):
            return true
        # 标量元素存储失败 → 试整槽 struct 存储(gArr[idx]=本地struct 变量)
        if PrimaryBodyIrAppendGlobalFixedArrayElemStructStore(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering.typedIr,
                                                              stmt_sourcePath,
                                                              lhsName,
                                                              rhsText,
                                                              callOrdinal):
            return true
    let lhsLocalSlotBeforeGlobal = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
    var lhsLocalShadowsGlobal = false
    if lhsLocalSlotBeforeGlobal >= 0 &&
       lhsLocalSlotBeforeGlobal < bodyIR.localSlots.len &&
       bodyIR.localSlots[lhsLocalSlotBeforeGlobal].placeKind != coreir.BodyPlaceGlobalAddressTag &&
       !stmt_assignRootGlobalFlag:
        lhsLocalShadowsGlobal = true
    var lhsGlobalType = ""
    if !lhsLocalShadowsGlobal:
        lhsGlobalType = PrimaryBodyIrTypedGlobalType(lowering.typedIr, stmt_sourcePath, lhsName)
        if lhsGlobalType == "" &&
           stmt_assignRootGlobalFlag &&
           stmt_assignRootType != "":
            lhsGlobalType = stmt_assignRootType
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_J function={typedFnName} line={stmt_lineNumber}")
    if lhsGlobalType != "" && stmt_assignFieldName == "":
        var lhsGlobalTypeKind: int32
        var lhsGlobalTypeSizeBytes: int32
        var lhsGlobalTypeAlignBytes: int32
        PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                       stmt_sourcePath,
                                       lhsGlobalType,
                                       lhsGlobalTypeKind,
                                       lhsGlobalTypeSizeBytes,
                                       lhsGlobalTypeAlignBytes)
        var lhsGlobalSlotName = PrimaryBodyIrTypedGlobalSlotName(lowering.typedIr, stmt_sourcePath, lhsName)
        if lhsGlobalSlotName == "" &&
           stmt_assignRootGlobalFlag &&
           stmt_assignRootSourcePath != "":
            lhsGlobalSlotName = Fmt"{stmt_assignRootSourcePath}::{lhsName}"
        if lhsGlobalSlotName == "":
            return false
        if lhsGlobalTypeKind == coreir.LocalAggregateTag &&
           stmt_rhsNodeIndex >= 0 &&
           stmt_rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
           lowering.typedIr.nodes2_opKinds[stmt_rhsNodeIndex] == texpr.TypedExprIrOpEmptySeqInit &&
           lhsGlobalTypeSizeBytes == 16:
            let emptySeqGlobalSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                                        slotNames,
                                                                        lhsGlobalSlotName,
                                                                        lhsGlobalTypeKind,
                                                                        lhsGlobalTypeSizeBytes,
                                                                        lhsGlobalTypeAlignBytes)
            let emptySeqValueSlot = PrimaryBodyIrEvalNode(
                bodyIR,
                slotNames,
                varI32ParamNames,
                lowering,

                share(typedFn),
                irFunction,
                stmt_rhsNodeIndex,
                callOrdinal)
            if emptySeqGlobalSlot >= 0 && emptySeqValueSlot >= 0:
                PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, emptySeqGlobalSlot)
                bodyIR.localSlots[emptySeqGlobalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
                if PrimaryBodyIrAppendManagedGlobalStore(bodyIR,
                                                         lowering,
                                                         emptySeqGlobalSlot,
                                                         emptySeqValueSlot,
                                                         PrimaryBodyIrManagedSemanticValueDefinitionRowExact(
                                                             lowering.typedIr, stmt_rhsNodeIndex),
                                                         callOrdinal):
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=empty_seq_init function={typedFnName} line={stmt_lineNumber}")
                    return true
            let _ = PrimaryBodyIrNodeEvalMissAt("empty_seq_zero")
            return false
        # Field-to-global assignment consumes the exact field layout before
        # generic aggregate node-eval or generic str name lookup. An unsized
        # value slot here would copy uninitialized tail bytes into the global.
        let fieldGlobalAuthorityComplete =
            stmt_assignValueFieldName != "" &&
            stmt_assignValueRootName != "" &&
            stmt_assignValueRootType != "" &&
            stmt_assignValueFieldType != "" &&
            stmt_assignValueFieldOffsetBytes >= 0 &&
            stmt_assignValueFieldSizeBytes > 0 &&
            stmt_assignValueFieldAlignBytes > 0
        if stmt_rhsNodeIndex >= 0 &&
           stmt_rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
           lowering.typedIr.nodes2_opKinds[stmt_rhsNodeIndex] == texpr.TypedExprIrOpFieldGet &&
           fieldGlobalAuthorityComplete &&
           (lhsGlobalTypeKind == coreir.LocalStrTag ||
            lhsGlobalTypeKind == coreir.LocalAggregateTag):
            let rhsFieldTypeSourceRes: Result[str] = langintern.LookupIntern(
                lowering.typedIr.internPool,
                lowering.typedIr.nodes2_fieldTypeSourcePathIds[stmt_rhsNodeIndex])
            let rhsFieldNodeTypeRes: Result[str] = langintern.LookupIntern(
                lowering.typedIr.internPool,
                lowering.typedIr.nodes2_resultTypeIds[stmt_rhsNodeIndex])
            if !IsOk(rhsFieldTypeSourceRes) || Value(rhsFieldTypeSourceRes) == "" ||
               !IsOk(rhsFieldNodeTypeRes) || Value(rhsFieldNodeTypeRes) == "" ||
               texpr.TypedExprNormalizeTypeText(Value(rhsFieldNodeTypeRes)) !=
                   texpr.TypedExprNormalizeTypeText(stmt_assignValueFieldType):
                let panicMsg = Fmt"primary: field-to-global type owner unavailable source={stmt_sourcePath} line={stmt_lineNumber}"
                panic(panicMsg)
            let rhsFieldTypeSourcePath = Value(rhsFieldTypeSourceRes)
            let rhsFieldNodeType = Value(rhsFieldNodeTypeRes)
            let rhsFieldSizeBytes = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldSizeBytes,
                stmt_rhsNodeIndex)
            let rhsFieldAlignBytes = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldAlignBytes,
                stmt_rhsNodeIndex)
            var rhsFieldKind: int32
            var resolvedRhsFieldSizeBytes: int32
            var resolvedRhsFieldAlignBytes: int32
            PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                           rhsFieldTypeSourcePath,
                                           rhsFieldNodeType,
                                           rhsFieldKind,
                                           resolvedRhsFieldSizeBytes,
                                           resolvedRhsFieldAlignBytes)
            if rhsFieldKind != lhsGlobalTypeKind ||
               rhsFieldSizeBytes <= 0 || rhsFieldAlignBytes <= 0 ||
               resolvedRhsFieldSizeBytes != rhsFieldSizeBytes ||
               resolvedRhsFieldAlignBytes != rhsFieldAlignBytes ||
               rhsFieldSizeBytes != stmt_assignValueFieldSizeBytes ||
               rhsFieldSizeBytes != lhsGlobalTypeSizeBytes ||
               rhsFieldAlignBytes != stmt_assignValueFieldAlignBytes ||
               rhsFieldAlignBytes != lhsGlobalTypeAlignBytes:
                let panicMsg = Fmt"primary: field-to-global layout mismatch source={stmt_sourcePath} line={stmt_lineNumber} lhs={lhsGlobalType} rhs={rhsFieldNodeType} rhs_owner={rhsFieldTypeSourcePath} lhs_kind={lhsGlobalTypeKind} rhs_kind={rhsFieldKind} lhs_size={lhsGlobalTypeSizeBytes} rhs_size={rhsFieldSizeBytes} resolved_rhs_size={resolvedRhsFieldSizeBytes} field_size={stmt_assignValueFieldSizeBytes} lhs_align={lhsGlobalTypeAlignBytes} rhs_align={rhsFieldAlignBytes} resolved_rhs_align={resolvedRhsFieldAlignBytes} field_align={stmt_assignValueFieldAlignBytes}"
                panic(panicMsg)
            let fieldGlobalValueSlot = PrimaryBodyIrFindOrCreateSlotSized(
                bodyIR,
                slotNames,
                Fmt"#global_field_value#{stmt_lineNumber}",
                rhsFieldKind,
                rhsFieldSizeBytes,
                rhsFieldAlignBytes)
            if fieldGlobalValueSlot < 0 ||
               fieldGlobalValueSlot >= bodyIR.localSlots.len ||
               PrimaryBodyIrSlotType(bodyIR, fieldGlobalValueSlot) != rhsFieldKind ||
               PrimaryLocalSlotSizeOf(bodyIR.localSlots[fieldGlobalValueSlot]) != rhsFieldSizeBytes ||
               bodyIR.localSlots[fieldGlobalValueSlot].alignBytes != rhsFieldAlignBytes:
                let panicMsg = Fmt"primary: exact field value slot unavailable source={stmt_sourcePath} line={stmt_lineNumber}"
                panic(panicMsg)
            if lhsGlobalTypeKind == coreir.LocalStrTag ||
               PrimaryBodyIrTypeTextIsDynamicSeq(lhsGlobalType):
                panic("primary: managed field-to-global load requires immutable producer value-def admission")
            if !PrimaryBodyIrAppendFieldLoadToSlot(bodyIR,
                                                   slotNames,
                                                   lowering.typedIr,
                                                   stmt_sourcePath,
                                                   stmt_assignValueRootName,
                                                   stmt_assignValueRootType,
                                                   stmt_assignValueFieldOffsetBytes,
                                                   stmt_assignValueFieldSizeBytes,
                                                   fieldGlobalValueSlot):
                let panicMsg = Fmt"primary: exact field load unavailable source={stmt_sourcePath} line={stmt_lineNumber}"
                panic(panicMsg)
            let fieldGlobalDestSlot = PrimaryBodyIrFindOrCreateSlotSized(
                bodyIR,
                slotNames,
                lhsGlobalSlotName,
                lhsGlobalTypeKind,
                lhsGlobalTypeSizeBytes,
                lhsGlobalTypeAlignBytes)
            if fieldGlobalDestSlot < 0 ||
               fieldGlobalDestSlot >= bodyIR.localSlots.len ||
               PrimaryBodyIrSlotType(bodyIR, fieldGlobalDestSlot) != lhsGlobalTypeKind ||
               PrimaryLocalSlotSizeOf(bodyIR.localSlots[fieldGlobalDestSlot]) != lhsGlobalTypeSizeBytes ||
               bodyIR.localSlots[fieldGlobalDestSlot].alignBytes != lhsGlobalTypeAlignBytes:
                let panicMsg = Fmt"primary: exact field global slot unavailable source={stmt_sourcePath} line={stmt_lineNumber} global={lhsName}"
                panic(panicMsg)
            PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, fieldGlobalDestSlot)
            bodyIR.localSlots[fieldGlobalDestSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
            if lhsGlobalTypeKind == coreir.LocalStrTag ||
               PrimaryBodyIrTypeTextIsDynamicSeq(lhsGlobalType):
                if !PrimaryBodyIrAppendManagedGlobalStore(bodyIR,
                                                           lowering,
                                                           fieldGlobalDestSlot,
                                                           fieldGlobalValueSlot,
                                                           PrimaryBodyIrManagedSemanticValueDefinitionRowExact(
                                                               lowering.typedIr, stmt_rhsNodeIndex),
                                                           callOrdinal):
                    let panicMsg = Fmt"primary: managed field-to-global store unavailable source={stmt_sourcePath} line={stmt_lineNumber} type={lhsGlobalType}"
                    panic(panicMsg)
            else:
                var fieldHasManaged: bool
                if !texpr.TypedExprIrTypeContainsManagedStorage(lowering.typedIr,
                                                                 stmt_sourcePath,
                                                                 lhsGlobalType,
                                                                 fieldHasManaged) ||
                   fieldHasManaged:
                    let panicMsg = Fmt"primary: unsupported managed aggregate field-to-global store source={stmt_sourcePath} line={stmt_lineNumber} type={lhsGlobalType}"
                    panic(panicMsg)
                var fieldGlobalStoreOp: coreir.BodyOp
                fieldGlobalStoreOp.kind = coreir.BodyOpGlobalStoreTag
                fieldGlobalStoreOp.target = fieldGlobalValueSlot
                add(fieldGlobalStoreOp.operands, fieldGlobalDestSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, fieldGlobalStoreOp)
            PrimaryBodyIrNodeEvalOnlyOwn()
            return true
        # `gAgg = box.paths` / `gAgg = src` : whole-aggregate global store from a
        # node-materializable value (struct field-get, seq[i], local aggregate).
        # The scalar global-store path below only handles i32/i64/ptr/str; an
        # aggregate (seq header / nested struct) needs the value materialized by
        # the node-eval emitter and copied byte-for-byte into the global data
        # label. Mirror the EmptySeqInit branch's GlobalAddress dest slot, then
        # emit a GlobalStore that memcpy's the exact aggregate width (handled in
        # PrimaryBodyIRFillGlobalStoreOp's aggregate branch).
        if lhsGlobalTypeKind == coreir.LocalAggregateTag &&
           stmt_rhsNodeIndex >= 0 &&
           stmt_rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
           lowering.typedIr.nodes2_opKinds[stmt_rhsNodeIndex] != texpr.TypedExprIrOpCallExpr:
            primaryBodyIrNodeEvalMissOp = ""
            let aggGlobalProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering,

                                                                share(typedFn),
                                                                irFunction,
                                                                stmt_rhsNodeIndex)
            if aggGlobalProbeKind == coreir.LocalAggregateTag:
                let aggGlobalValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering,

                                                               share(typedFn),
                                                               irFunction,
                                                               stmt_rhsNodeIndex,
                                                               callOrdinal)
                if aggGlobalValueSlot >= 0 &&
                   PrimaryBodyIrSlotType(bodyIR, aggGlobalValueSlot) == coreir.LocalAggregateTag &&
                   PrimaryLocalSlotSizeOf(bodyIR.localSlots[aggGlobalValueSlot]) == lhsGlobalTypeSizeBytes:
                    let aggGlobalDestSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                                              slotNames,
                                                                              lhsGlobalSlotName,
                                                                              lhsGlobalTypeKind,
                                                                              lhsGlobalTypeSizeBytes,
                                                                              lhsGlobalTypeAlignBytes)
                    if aggGlobalDestSlot >= 0:
                        PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, aggGlobalDestSlot)
                        bodyIR.localSlots[aggGlobalDestSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
                        if PrimaryBodyIrTypeTextIsDynamicSeq(lhsGlobalType):
                            if !PrimaryBodyIrAppendManagedGlobalStore(bodyIR,
                                                                       lowering,
                                                                       aggGlobalDestSlot,
                                                                       aggGlobalValueSlot,
                                                                       PrimaryBodyIrManagedSemanticValueDefinitionRowExact(
                                                                           lowering.typedIr, stmt_rhsNodeIndex),
                                                                       callOrdinal):
                                let panicMsg = Fmt"primary: managed aggregate global store unavailable source={stmt_sourcePath} line={stmt_lineNumber} type={lhsGlobalType}"
                                panic(panicMsg)
                        else:
                            var aggHasManaged: bool
                            if !texpr.TypedExprIrTypeContainsManagedStorage(lowering.typedIr,
                                                                             stmt_sourcePath,
                                                                             lhsGlobalType,
                                                                             aggHasManaged) ||
                               aggHasManaged:
                                let panicMsg = Fmt"primary: unsupported managed aggregate global store source={stmt_sourcePath} line={stmt_lineNumber} type={lhsGlobalType}"
                                panic(panicMsg)
                            var aggGlobalStoreOp: coreir.BodyOp
                            aggGlobalStoreOp.kind = coreir.BodyOpGlobalStoreTag
                            aggGlobalStoreOp.target = aggGlobalValueSlot
                            add(aggGlobalStoreOp.operands, aggGlobalDestSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, aggGlobalStoreOp)
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_global_aggregate function={typedFnName} line={stmt_lineNumber}")
                        return true
            let _ = PrimaryBodyIrNodeEvalMissAt("global_aggregate_store")
            return false
        if lhsGlobalTypeKind != coreir.LocalI32Tag &&
           lhsGlobalTypeKind != coreir.LocalI64Tag &&
           lhsGlobalTypeKind != coreir.LocalPtrTag &&
           lhsGlobalTypeKind != coreir.LocalStrTag:
            return false
        var valueSlot: int32
        valueSlot = -1
        if lhsGlobalTypeKind == coreir.LocalI32Tag && assignLogicalRoot:
            let boolGlobalValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                    slotNames,
                                                                    Fmt"{lhsName}#global_bool_value#{stmt_lineNumber}",
                                                                    coreir.LocalI32Tag)
            if boolGlobalValueSlot < 0:
                return false
            var boolGlobalBlockStart = currentBlockStart
            if !PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                       slotNames,
                                                       lowering,

                                                       typedFn,
                                                       irFunction,
                                                       stmt_sourcePath,
                                                       stmt_lineNumber,
                                                       rhsText,
                                                       boolGlobalValueSlot,
                                                       callOrdinal,
                                                       boolGlobalBlockStart):
                return false
            currentBlockStart = boolGlobalBlockStart
            valueSlot = boolGlobalValueSlot
        if valueSlot < 0 && PrimaryBodyIrTextHasCallSurface(rhsText):
            let callValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                              slotNames,
                                                              Fmt"{lhsName}#global_call_value#{stmt_lineNumber}",
                                                              lhsGlobalTypeKind)
            # (c)族①: 已声明全局标量 `= Value(res)` 赋值形态——传 -1 逼
            # AppendWholeCallExprToSlot 走"无 node2 索引"文本兜底臂
            # (PrimaryBodyIrBindingTypeForName 查不到 let 局部绑定类型即空手
            # falls through), Value 内征 miss、诚实 poison 落回 missing_call_target
            # (rsa.cheng:2294 rsaPssSignatureScratchLen 实锤)。此处 RHS 就是
            # 整语句节点 (stmt_rhsNodeIndex), 传真节点索引让 callHead=="Value"
            # 分支走 PrimaryBodyIrAppendResultValueProjection 的节点臂——与
            # let/return 直接 RHS 形态、node-eval 全部同款投影,零新增语义。
            if callValueSlot >= 0 &&
               PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                       slotNames,
                                                       lowering,

                                                       typedFn,
                                                       irFunction,
                                                       varI32ParamNames,
                                                       rhsText,
                                                       callValueSlot,
                                                       stmt_lineNumber,
                                                       stmt_rhsNodeIndex,
                                                       callOrdinal):
                valueSlot = callValueSlot
        if valueSlot < 0 && stmt_assignValueOpKind == texpr.TypedExprIrOpLocalBoolEnumTernary:
            valueSlot = PrimaryBodyIrTernaryValueSlotForStmt(bodyIR,
                                                             slotNames,
                                                             varI32ParamNames,
                                                             lowering.typedIr,
                                                             stmt,
                                                             lhsGlobalTypeKind)
        elif valueSlot < 0 &&
           (stmt_assignValueOpKind == texpr.TypedExprIrOpI32Add ||
            stmt_assignValueOpKind == texpr.TypedExprIrOpI32Sub ||
            stmt_assignValueOpKind == texpr.TypedExprIrOpI32BitAnd ||
            stmt_assignValueOpKind == texpr.TypedExprIrOpI32BitOr):
            if stmt_assignValueLhsText == "" || stmt_assignValueRhsText == "":
                return false
            let leftSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering.typedIr,
                                                               stmt_sourcePath,
                                                               stmt_assignValueLhsText,
                                                               lhsGlobalTypeKind, callOrdinal)
            let rightSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering.typedIr,
                                                                stmt_sourcePath,
                                                                stmt_assignValueRhsText,
                                                                lhsGlobalTypeKind, callOrdinal)
            if leftSlot < 0 || rightSlot < 0:
                return false
            valueSlot = leftSlot
            var op: coreir.BodyOp
            op.kind = coreir.BodyOpBinOpTag
            op.target = valueSlot
            add(op.operands, lhsGlobalTypeKind)
            add(op.operands, int32(stmt_assignValueOpKind))
            add(op.operands, leftSlot)
            add(op.operands, rightSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, op)
        elif valueSlot < 0 && lhsGlobalTypeKind == coreir.LocalStrTag:
            if PrimaryBodyIrTextIsStringLiteral(rhsText):
                valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"{lhsName}#global_str_value#{stmt_lineNumber}",
                                                           coreir.LocalStrTag)
                if valueSlot < 0 ||
                   !PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                          slotNames,
                                                          rhsText,
                                                          valueSlot,
                                                          callOrdinal):
                    return false
            else:
                valueSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
                # BACKFILL-2/T37 根修 (Bug#2, f24 61f2ff2 v3): `strGlobalA = strGlobalB`
                # (RHS 是另一个模块 str 全局的裸标识符, 该函数内此前从未以任何名义
                # 登记过它的槽): 上面 FindArgSlot 按裸文本查表必然落空 (全局槽只按
                # sourcePath::name 限定名登记), 若就此止步会在下面 FindOrCreateTypedSlot
                # 里用裸名现造一个从未被写入的空局部槽, 静默丢失读值 (栈残留/空串)。
                # 补一步"这个裸名会不会正好是模块 str 全局"判定: 命中就走已验证的
                # GlobalLoad 物化协议 (PrimaryBodyIrValueArgSlotForCall 等既有调用点
                # 同款机制), 不是全局就原样落回下面通用兜底。
                if valueSlot < 0:
                    valueSlot = PrimaryBodyIrNodeEvalGlobalLoadSlot(bodyIR,
                                                                    slotNames,
                                                                    lowering.typedIr,
                                                                    stmt_sourcePath,
                                                                    rhsText)
                if valueSlot < 0:
                    valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                   slotNames,
                                                                   lowering.typedIr,
                                                                   stmt_sourcePath,
                                                                   rhsText,
                                                                   lhsGlobalType)
        elif valueSlot < 0 &&
             stmt_assignValueFieldName != "" &&
             stmt_assignValueRootName != "" &&
             stmt_assignValueRootType != "" &&
             stmt_assignValueFieldSizeBytes > 0 &&
             (lhsGlobalTypeKind == coreir.LocalI32Tag ||
              lhsGlobalTypeKind == coreir.LocalI64Tag ||
              lhsGlobalTypeKind == coreir.LocalPtrTag):
            # `gInt64 = aggParam.scalarField`(如 gGlobal = csg.logicalPayloadBytes):
            # 聚合参数标量字段读入全局标量。前端已把 root/field/offset/size 解析进
            # assignValue* 元数据,但既有标量值路径(ScalarValueSlotForText 只认 str/
            # var-str-param .len)丢弃它 → return false → node_path_skip。直接复用
            # FieldLoad 原语读字段进值槽,下面既有 GlobalStore 落全局、宽度适配处理 i32/i64。
            let fieldValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                              slotNames,
                                                              Fmt"#global_field_value#{stmt_lineNumber}",
                                                              lhsGlobalTypeKind)
            if fieldValueSlot >= 0 &&
               PrimaryBodyIrAppendFieldLoadToSlot(bodyIR,
                                                  slotNames,
                                                  lowering.typedIr,
                                                  stmt_sourcePath,
                                                  stmt_assignValueRootName,
                                                  stmt_assignValueRootType,
                                                  stmt_assignValueFieldOffsetBytes,
                                                  stmt_assignValueFieldSizeBytes,
                                                  fieldValueSlot):
                valueSlot = fieldValueSlot
        elif valueSlot < 0:
            valueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering.typedIr,
                                                            stmt_sourcePath,
                                                            rhsText,
                                                            lhsGlobalTypeKind, callOrdinal)
            # `gInt = someSeq.len`: the scalar value path only knows str /
            # var-str-param `.len`; a plain seq `.len` (any element type) has
            # no value slot there. Resolve it through the seq-len helper, which
            # FieldLoads len from the seq header (offset 0) regardless of the
            # element type — the real value the global-store below needs.
            if valueSlot < 0 && lhsGlobalTypeKind == coreir.LocalI32Tag:
                valueSlot = PrimaryBodyIrSeqLenValueSlot(bodyIR,
                                                         slotNames,
                                                         lowering.typedIr,
                                                         typedFn,
                                                         irFunction,
                                                         stmt_sourcePath,
                                                         stmt_lineNumber,
                                                         rhsText)
        if valueSlot < 0:
            PrimaryObjectPlanTrace(strutil.Join(["phase=assign_global_value_slot_missing function=",
                                                 strings.CloneStr(typedFnName),
                                                 " line=",
                                                 strings.IntToStr(stmt_lineNumber),
                                                 " lhs=",
                                                 strings.CloneStr(lhsName),
                                                 " rhs=",
                                                 strings.CloneStr(rhsText),
                                                 " op=",
                                                 strings.IntToStr(int32(stmt_assignValueOpKind))], ""))
            return false
        let globalSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       lhsGlobalSlotName,
                                                       lhsGlobalTypeKind)
        PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, globalSlot)
        bodyIR.localSlots[globalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
        if PrimaryBodyIrSlotType(bodyIR, valueSlot) != lhsGlobalTypeKind &&
           (lhsGlobalTypeKind == coreir.LocalI32Tag ||
            lhsGlobalTypeKind == coreir.LocalI64Tag ||
            lhsGlobalTypeKind == coreir.LocalPtrTag) &&
           (PrimaryBodyIrSlotType(bodyIR, valueSlot) == coreir.LocalI32Tag ||
            PrimaryBodyIrSlotType(bodyIR, valueSlot) == coreir.LocalI64Tag ||
            PrimaryBodyIrSlotType(bodyIR, valueSlot) == coreir.LocalPtrTag):
            # Width-adapt the value to the global's slot kind (shared const-text
            # slots may carry a different int width).
            let globalAdaptSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                slotNames,
                                                                Fmt"#global_store_adapt#{bodyIR.ops.len}",
                                                                lhsGlobalTypeKind)
            if globalAdaptSlot < 0:
                return false
            var globalAdaptOp: coreir.BodyOp
            globalAdaptOp.kind = coreir.BodyOpCopyLocalTag
            globalAdaptOp.target = globalAdaptSlot
            add(globalAdaptOp.operands, valueSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, globalAdaptOp)
            valueSlot = globalAdaptSlot
        if lhsGlobalTypeKind == coreir.LocalStrTag:
            if !PrimaryBodyIrAppendManagedGlobalStore(bodyIR,
                                                       lowering,
                                                       globalSlot,
                                                       valueSlot,
                                                       PrimaryBodyIrManagedSemanticValueDefinitionRowExact(
                                                           lowering.typedIr, stmt_rhsNodeIndex),
                                                       callOrdinal):
                let panicMsg = Fmt"primary: managed string global store unavailable source={stmt_sourcePath} line={stmt_lineNumber}"
                panic(panicMsg)
        else:
            var storeOp: coreir.BodyOp
            storeOp.kind = coreir.BodyOpGlobalStoreTag
            storeOp.target = valueSlot
            add(storeOp.operands, globalSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
        PrimaryBodyIrNodeEvalOnlyOwn()
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_global_scalar function={typedFnName} line={stmt_lineNumber}")
        return true
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_K function={typedFnName} line={stmt_lineNumber}")
    if stmt_assignFieldName == "" &&
       stmt_assignValueFieldName != "":
        if PrimaryBodyIrTextHasFieldOrIndex(lhsName):
            return false
        let lhsSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
        let baseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                              slotNames,
                                                              lowering.typedIr,
                                                              stmt_sourcePath,
                                                              stmt_assignValueRootName,
                                                              stmt_assignValueRootType)
        let byteCount = stmt_assignValueFieldSizeBytes
        var primaryColdCond13: bool
        if lhsSlot < 0:
            primaryColdCond13 = true
        if baseSlot < 0:
            primaryColdCond13 = true
        if byteCount <= 0:
            primaryColdCond13 = true
        if PrimaryLocalSlotSizeOf(bodyIR.localSlots[lhsSlot]) < byteCount:
            primaryColdCond13 = true
        if primaryColdCond13:
            return false
        var loadOp: coreir.BodyOp
        loadOp.kind = coreir.BodyOpFieldLoadTag
        loadOp.target = lhsSlot
        add(loadOp.operands, baseSlot)
        add(loadOp.operands, lhsSlot)
        add(loadOp.operands, stmt_assignValueFieldOffsetBytes)
        add(loadOp.operands, byteCount)
        let _ = coreir.BodyIRAppendOp(bodyIR, loadOp)
        return true
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_L function={typedFnName} line={stmt_lineNumber}")
    if stmt_assignFieldName != "":
        var assignRootType = strings.CloneStr(stmt_assignRootType)
        if assignRootType == "" ||
           assignRootType == "unknown" ||
           !PrimaryObjectMetadataTextStable(assignRootType):
            assignRootType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                             typedFn,
                                                             irFunction,
                                                             stmt_lineNumber,
                                                             stmt_assignRootName)
        if assignRootType == "" ||
           assignRootType == "unknown" ||
           !PrimaryObjectMetadataTextStable(assignRootType):
            PrimaryObjectPlanGuardTick()
            if PrimaryObjectPlanProgressEnabled():
                PrimaryObjectPlanProgress(Fmt"assign_field_root_unstable function={typedFnName} line={stmt_lineNumber} root={stmt_assignRootName} root_type_len={assignRootType.len}")
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt_lineNumber,
                                         int32(stmt_kind),
                                         710,
                                         0)
            return true
        var assignFieldType = strings.CloneStr(stmt_assignFieldType)
        var assignFieldOffsetBytes = stmt_assignFieldOffsetBytes
        var assignFieldSizeBytes = stmt_assignFieldSizeBytes
        var assignFieldAlignBytes: int32
        var assignLookupFieldName = strings.CloneStr(stmt_assignFieldName)
        var assignLookupIndexText = ""
        var assignLookupIsIndexed = false
        if PrimaryBodyIrIndexExprParts(strings.CloneStr(stmt_assignFieldName),
                                       assignLookupFieldName,
                                       assignLookupIndexText):
            assignLookupIsIndexed = true
        # Rescue: a local declared `var e: typeof(seq[0])` carries an opaque
        # typeof(...) root type whose anonymous-tuple element field metadata is
        # unreachable to the recovery lookup below (which also sees the field
        # name cleared for a non-indexed field). Resolve typeof to its concrete
        # element type + re-derive field meta via stmt_assignFieldName, so
        # `e.field = rhs` lowers instead of bailing 711. Add-only.
        if assignFieldType == "" &&
           len(assignRootType) >= 9 &&
           strings.SliceBytes(assignRootType, 0, 7) == "typeof(" &&
           strings.SliceBytes(assignRootType, len(assignRootType) - 1, 1) == ")":
            let typeofResolvedRoot = PrimaryBodyIrResolveTypeOfTypeText(lowering.typedIr,
                                                                         typedFn,
                                                                         irFunction,
                                                                         stmt_lineNumber,
                                                                         assignRootType)
            if typeofResolvedRoot != "" &&
               PrimaryBodyIrTupleFieldMeta(lowering.typedIr,
                                            stmt_sourcePath,
                                            typeofResolvedRoot,
                                            stmt_assignFieldName,
                                            assignFieldType,
                                            assignFieldOffsetBytes,
                                            assignFieldSizeBytes,
                                            assignFieldAlignBytes):
                assignRootType = typeofResolvedRoot
        var primaryColdCond14: bool
        var primaryColdCond14Clause0: bool
        if assignRootType != "":
            if stmt_assignFieldName != "":
                if assignFieldType == "":
                    primaryColdCond14Clause0 = true
                if assignFieldType == "unknown":
                    primaryColdCond14Clause0 = true
                if !PrimaryObjectMetadataTextStable(assignFieldType):
                    primaryColdCond14Clause0 = true
                if assignFieldSizeBytes <= 0:
                    primaryColdCond14Clause0 = true
        if primaryColdCond14Clause0:
            primaryColdCond14 = true
        if primaryColdCond14:
            let _fieldRecovered = PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                                                      stmt_sourcePath,
                                                                      assignRootType,
                                                                      assignLookupFieldName,
                                                                      assignFieldType,
                                                                      assignFieldOffsetBytes,
                                                                      assignFieldSizeBytes,
                                                                      assignFieldAlignBytes)
        # bail=711 FAIS slow-path recovery:`outline.points[1].onCurve = false`
        # (indexed sub-field 多段路径)。31181 LookupSingleFieldMeta 只解 root 内
        # 首跳字段,对 `arr[idx].sub` 多段名 miss → assignFieldType 留空 → 既有 711。
        # fast-path 22660-22694 已有等价 leaf-meta 复原,但当 root 类型经 31021
        # BindingTypeForName 兜回(stmt-cached 漏)时落此 slow-path,需此处镜像。
        # 钻 FAIS shape leaf meta(arrayField → 元素类型 → 叶子 sub-field 元),
        # 全验通后 materialize RHS scalar 值,再走既有 FieldArrayIndexedSubFieldStore。
        # G1 严等:value slot 类型必须 == leaf sub-field kind 且 slot 字节宽 >= subSize。
        # Poison-on-miss:任一前置不满足 fall-through 既有 711,无静默落穿。
        # Scalar leaf 限 I32/I64/Ptr,Aggregate/Str leaf 仍走 711。
        var faisSlowArrayField = ""
        var faisSlowIndexText = ""
        var faisSlowSubField = ""
        if (assignFieldType == "" ||
            assignFieldType == "unknown" ||
            !PrimaryObjectMetadataTextStable(assignFieldType) ||
            assignFieldSizeBytes <= 0) &&
           PrimaryBodyIrFieldArrayIndexedSubFieldParts(stmt_assignFieldName,
                                                      faisSlowArrayField,
                                                      faisSlowIndexText,
                                                      faisSlowSubField):
            var faisSlowArrayType = ""
            var faisSlowArrayOffset: int32
            var faisSlowArraySize: int32
            var faisSlowArrayAlign: int32
            if PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                                  stmt_sourcePath,
                                                  assignRootType,
                                                  faisSlowArrayField,
                                                  faisSlowArrayType,
                                                  faisSlowArrayOffset,
                                                  faisSlowArraySize,
                                                  faisSlowArrayAlign) &&
               faisSlowArraySize > 0 &&
               faisSlowArrayOffset >= 0 &&
               PrimaryObjectMetadataTextStable(faisSlowArrayType):
                let faisSlowElemType = PrimaryBodyIrIndexedElementTypeText(faisSlowArrayType)
                var faisSlowElemKind: int32
                var faisSlowElemSize: int32
                var faisSlowElemAlign: int32
                if faisSlowElemType != "" &&
                   PrimaryObjectMetadataTextStable(faisSlowElemType):
                    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                   stmt_sourcePath,
                                                   faisSlowElemType,
                                                   faisSlowElemKind,
                                                   faisSlowElemSize,
                                                   faisSlowElemAlign)
                var faisSlowSubType = ""
                var faisSlowSubOffset: int32
                var faisSlowSubSize: int32
                var faisSlowSubAlign: int32
                if faisSlowElemKind == coreir.LocalAggregateTag &&
                   faisSlowElemSize > 0 &&
                   PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                                     stmt_sourcePath,
                                                     faisSlowElemType,
                                                     faisSlowSubField,
                                                     faisSlowSubType,
                                                     faisSlowSubOffset,
                                                     faisSlowSubSize,
                                                     faisSlowSubAlign) &&
                   faisSlowSubSize > 0 &&
                   faisSlowSubOffset >= 0 &&
                   faisSlowSubOffset + faisSlowSubSize <= faisSlowElemSize &&
                   PrimaryObjectMetadataTextStable(faisSlowSubType):
                    let faisSlowSubKind = PrimaryBodyIrTypeKindFromText(faisSlowSubType)
                    if faisSlowSubKind == coreir.LocalI32Tag ||
                       faisSlowSubKind == coreir.LocalI64Tag ||
                       faisSlowSubKind == coreir.LocalPtrTag:
                        let faisSlowValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                                    slotNames,
                                                                                    varI32ParamNames,
                                                                                    lowering.typedIr,
                                                                                    stmt_sourcePath,
                                                                                    rhsText,
                                                                                    faisSlowSubKind,
                                                                                    callOrdinal)
                        if faisSlowValueSlot >= 0 &&
                           PrimaryBodyIrSlotType(bodyIR, faisSlowValueSlot) == faisSlowSubKind &&
                           PrimaryLocalSlotSizeOf(bodyIR.localSlots[faisSlowValueSlot]) >= faisSlowSubSize:
                            if PrimaryBodyIrAppendFieldArrayIndexedSubFieldStore(bodyIR,
                                                                                 slotNames,
                                                                                 varI32ParamNames,
                                                                                 lowering.typedIr,
                                                                                 typedFn,
                                                                                 irFunction,
                                                                                 stmt_sourcePath,
                                                                                 stmt_lineNumber,
                                                                                 stmt_assignRootName,
                                                                                 assignRootType,
                                                                                 stmt_assignFieldName,
                                                                                 faisSlowValueSlot,
                                                                                 callOrdinal):
                                PrimaryBodyIrNodeEvalOnlyOwn()
                                if PrimaryObjectPlanProgressEnabled():
                                    PrimaryObjectPlanProgress(Fmt"assign_field_fais_slow_recovered function={typedFnName} line={stmt_lineNumber} arr={faisSlowArrayField} sub={faisSlowSubField} sub_off={faisSlowSubOffset} sub_sz={faisSlowSubSize}")
                                return true
        # bail=711 two-hop recovery: `grid.rows[i].cols[j].a = v` (nested
        # array-of-struct-of-array). The frontend (TypedExprIrPopulateAssignLhsMeta)
        # refuses to resolve a field path with a second surviving `[` so this
        # shape always reaches here with assignFieldType=="" (never the wrong
        # always-element-0 offset a flat dotted-path resolve would produce).
        # Mirrors the one-hop recovery above exactly, one level deeper: resolve
        # hop1 array meta -> hop1 element type -> hop2 array meta -> hop2
        # element type -> scalar leaf meta, all G1-gated (LocalAggregateTag
        # elements, I32/I64/Ptr leaf only, byte-size fit), then materialize the
        # RHS and store via PrimaryBodyIrAppendFieldArrayIndexedSubFieldStoreTwoLevel
        # (hop1 addr + hop2 addr composed from the same single-hop primitive).
        # Poison-on-miss: any G1 clause failing falls through to the 711 bail
        # below, no partial/best-effort store.
        var faisSlow2Arr1 = ""
        var faisSlow2Idx1 = ""
        var faisSlow2Arr2 = ""
        var faisSlow2Idx2 = ""
        var faisSlow2Sub = ""
        if (assignFieldType == "" ||
