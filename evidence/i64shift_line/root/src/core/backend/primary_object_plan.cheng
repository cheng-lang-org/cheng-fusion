                # a: I32=ref),会误判 cmp_eq/cmp_ne。改以值侧槽类标为权威信号
                # (前端仅对指针形态值侧建 NilPtr 节点,语义已保证)。
                let probeNilValueKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering,

                                                                   typedFn,
                                                                   irFunction,
                                                                   probeNilValueNode)
                if probeNilValueKind != coreir.LocalPtrTag &&
                   probeNilValueKind != coreir.LocalI64Tag:
                    return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
                return coreir.LocalI32Tag
        let probeCmpLhsKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         lowering,

                                                         typedFn,
                                                         irFunction,
                                                         arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex))
        if probeCmpLhsKind < 0:
            return -1
        let probeCmpRhsKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         lowering,

                                                         typedFn,
                                                         irFunction,
                                                         arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex))
        if probeCmpRhsKind < 0:
