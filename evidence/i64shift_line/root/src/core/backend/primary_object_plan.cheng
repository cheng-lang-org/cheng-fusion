    return false

@borrows
fn PrimaryObjectCallTargetIsPureCast(targetRaw: str): bool =
    let target = PrimaryCallTargetTailName(targetRaw)
    if target == "int32" || target == "Int32" || target == "i32":
        return true
    if target == "int64" || target == "Int64" || target == "i64":
        return true
    if target == "uint64" || target == "UInt64" || target == "u64":
        return true
    if target == "uint32" || target == "UInt32" || target == "u32":
        return true
    if target == "uint8" || target == "UInt8" || target == "u8":
        return true
    if target == "int8" || target == "Int8" || target == "i8":
        return true
    if target == "uint16" || target == "UInt16" || target == "u16":
        return true
    if target == "int16" || target == "Int16" || target == "i16":
        return true
    if target == "int" || target == "Int":
        return true
    if target == "uint" || target == "UInt":
        return true
    if target == "char" || target == "Char":
        return true
    return false

@borrows
fn PrimaryObjectBuiltinCallMatchesActual(actualSymbol: str,
                                          expectedTarget: str): bool =
    if actualSymbol == expectedTarget:
        return true
    if expectedTarget == "assert" && (actualSymbol == "assertPtrBridge" || actualSymbol == "assertPtrBridgeRuntime" || actualSymbol == "std/system::assert"):
        return true
    if expectedTarget == "Assert" && (actualSymbol == "AssertPtrBridge" || actualSymbol == "assertPtrBridgeRuntime" || actualSymbol == "std/system::Assert"):
        return true
    if (expectedTarget == "echo" || expectedTarget == "Echo") && actualSymbol == "puts":
        return true
    if (expectedTarget == "StrDataPtr" || expectedTarget == "strDataPtr") && actualSymbol == "std/system::StrDataPtr":
        return true
    if (expectedTarget == "StrLenFast" || expectedTarget == "strLenFast") && actualSymbol == "std/system::StrLenFast":
        return true
    if (expectedTarget == "StrEmpty" || expectedTarget == "strEmpty") && actualSymbol == "std/system::StrEmpty":
        return true
    let actualCanonical = PrimaryBodyIrCanonicalCallTargetSymbol(actualSymbol)
    let expectedCanonical = PrimaryBodyIrCanonicalCallTargetSymbol(expectedTarget)
    if actualCanonical != "" && actualCanonical == expectedTarget:
        return true
    if expectedCanonical != "" && expectedCanonical == actualSymbol:
        return true
    if actualCanonical != "" && expectedCanonical != "" && actualCanonical == expectedCanonical:
        return true
    return false

@borrows
fn PrimaryObjectCallTargetOrdinalMatchesActual(irFunction: lower.PrimaryObjectIrFunction,
                                                sourceOrdinal: int32,
                                                actualSymbol: str): bool =
    if actualSymbol == "":
        return false
    if sourceOrdinal < 0 || sourceOrdinal >= irFunction.callTargets.len:
        return false
    if sourceOrdinal < irFunction.callTargetImportcFlags.len &&
       irFunction.callTargetImportcFlags[sourceOrdinal]:
        if sourceOrdinal < irFunction.callImportcSymbols.len &&
           irFunction.callImportcSymbols[sourceOrdinal] == actualSymbol:
            return true
        return false
    if sourceOrdinal < irFunction.callImportcSymbols.len &&
       irFunction.callImportcSymbols[sourceOrdinal] != "" &&
       irFunction.callImportcSymbols[sourceOrdinal] == actualSymbol:
        return true
    return PrimaryObjectBuiltinCallMatchesActual(actualSymbol,
                                                irFunction.callTargets[sourceOrdinal])

@borrows
fn PrimaryObjectCallTargetOrdinalForActual(irFunction: lower.PrimaryObjectIrFunction,
                                            actualSymbol: str,
                                            startOrdinal: int32): int32 =
    if actualSymbol == "":
        return -1
    var start = startOrdinal
    if start < 0:
        start = 0
    if start > irFunction.callTargets.len:
        start = irFunction.callTargets.len
    for i in start..<irFunction.callTargets.len:
        if PrimaryObjectCallTargetOrdinalMatchesActual(irFunction, i, actualSymbol):
            return i
    for i in 0..<start:
        if PrimaryObjectCallTargetOrdinalMatchesActual(irFunction, i, actualSymbol):
            return i
    return -1

@borrows
fn PrimaryObjectIrFunctionHasRelocCallTarget(irFunction: lower.PrimaryObjectIrFunction): bool =
    for i in 0..<irFunction.callTargets.len:
        if PrimaryObjectCallTargetIsBuiltin(irFunction.callTargets[i]):
            continue
        if i < irFunction.callTargetImportcFlags.len &&
           irFunction.callTargetImportcFlags[i]:
            return true
        return true
    return false

@borrows
fn PrimaryCallSequenceNeedsRelocForIrFunction(bodyKind: str,
                                               bodyIrCallCount: int32,
                                               irFunction: lower.PrimaryObjectIrFunction): bool =
    if bodyIrCallCount > 0:
        return true
    if bodyKind == texpr.BodyKindStatementSequence:
        return PrimaryObjectIrFunctionHasRelocCallTarget(irFunction)
    return PrimaryCallSequenceNeedsReloc(bodyKind, bodyIrCallCount, irFunction.callTargets.len)

@borrows
fn PrimaryCallSequenceRequiredCallCount(bodyKind: str,
                                          bodyIrCallCount: int32,
                                          callTargetsLen: int32): int32 =
    if bodyIrCallCount > 0:
        return bodyIrCallCount
    if bodyKind == texpr.BodyKindBackendDriverRunCommand:
        return 4
    return 1

fn PrimaryObjectPlanMarkBodyIrAddressSlots(state: var PrimaryObjectPlanPhaseState,
                                            currentIndex: int32,
                                            nextFrontier: var int32[]) =
    if currentIndex < 0 || currentIndex >= state.tempBodyIRs.len:
        return
    for slotIndex in 0..<state.tempBodyIRs[currentIndex].localSlots.len:
        let functionIndex = PrimaryBodyIrFunctionAddressSlotIndex(state.tempBodyIRs[currentIndex].localSlots[slotIndex].name)
        if functionIndex >= 0 &&
           functionIndex < state.reachable.len &&
           !state.reachable[functionIndex]:
            state.reachable[functionIndex] = true
            add(nextFrontier, functionIndex)

@borrows
fn PrimaryObjectPlanFunctionSourcePathAt(lowering: var lower.LoweringPlanStub,
                                         functionIndex: int32): str =
    if functionIndex >= 0 && functionIndex < lowering.functionSourcePaths.len:
        return strings.CloneStr(lowering.functionSourcePaths[functionIndex])
    return strings.CloneStr("")

# Phase 3b blocker enumeration: append one not_ready record per complete receipt.
# Full receipt identity preserves same-named functions from different sources
# while collapsing only byte-equivalent diagnostics.
@borrows
fn PrimaryObjectPlanRecordError(state: var PrimaryObjectPlanPhaseState,
                                 functionName: str,
                                 functionSourcePath: str,
                                 bodyKind: str,
                                 reasonDetail: str,
                                 lineNumber: int32) =
    if len(functionName) <= 0:
        return
    if os.GetEnv("CHENG_REC_TRACE") == "1" && bodyKind == "missing_call_target":
        os.WriteLine(os.GetStderr(), Fmt"REC_TRACE fn={functionName} bodyKind={bodyKind} reasonDetail={reasonDetail} lineNumber={lineNumber}")
    var rec: PrimaryObjectError
    rec.functionName = functionName
    rec.functionSourcePath = functionSourcePath
    rec.bodyKind = bodyKind
    rec.callTarget = reasonDetail
    rec.lineNumber = lineNumber
    rec.callTargetOrdinal = -1
    rec.rhsBailReason = texpr.RhsBailNone
    rec.callTargetResolutionKind = texpr.CallTargetUnresolved
    let _added = PrimaryObjectErrorAppendUnique(state.errors, rec)

# Phase 3b (zero-C measurement 固化): record a not_ready function AND unconditionally
# capture its first-zero-op detail into the errors[] entry. The first-only state.error
# already got CaptureBodyIrDetails; without this, every other errors[] row only carried
# bodyKind, so a full-list dump could not tell which of N statement_sequence blockers
# bailed at 44 vs 631 vs 712. Capturing here makes each row carry a real bail号
# (firstZeroOpOperand0=statementKind, firstZeroOpOperand1=detail0=bail号) — no env gate.
@borrows
fn PrimaryObjectPlanRecordErrorWithBody(state: var PrimaryObjectPlanPhaseState,
                                         functionName: str,
                                         functionSourcePath: str,
                                         bodyKind: str,
                                         reasonDetail: str,
                                         lineNumber: int32,
                                         bodyIR: coreir.BodyIR) =
    if len(functionName) <= 0:
        return
    var rec: PrimaryObjectError
    rec.functionName = functionName
    rec.functionSourcePath = functionSourcePath
    rec.bodyKind = bodyKind
    rec.callTarget = reasonDetail
    rec.lineNumber = lineNumber
    rec.callTargetOrdinal = -1
    rec.rhsBailReason = texpr.RhsBailNone
    rec.callTargetResolutionKind = texpr.CallTargetUnresolved
    PrimaryObjectPlanCaptureBodyIrDetails(rec.bodyIrDetail, bodyIR)
    let _added = PrimaryObjectErrorAppendUnique(state.errors, rec)

fn PrimaryObjectPlanExpandIrCallTargets(state: var PrimaryObjectPlanPhaseState,
                                          lowering: var lower.LoweringPlanStub,
                                          currentIndex: int32,
                                          irIndex: int32,
                                          nextFrontier: var int32[]): bool =
    if irIndex < 0 || irIndex >= lowering.primaryObjectIr.functions.len:
        return true
    let irFunction = lowering.primaryObjectIr.functions[irIndex]
    if irFunction.callTargets.len <= 0:
        return true
    if irFunction.callArgCounts.len != irFunction.callTargets.len ||
       irFunction.callTargetSourcePaths.len != irFunction.callTargets.len ||
       irFunction.callTargetSignatureLineNumbers.len !=
           irFunction.callTargets.len ||
       irFunction.callTargetImportcFlags.len != irFunction.callTargets.len ||
       irFunction.callImportcSymbols.len != irFunction.callTargets.len:
        state.bodySemanticsMissing = true
        PrimaryObjectPlanRecordError(state, lowering.functionNames[currentIndex], PrimaryObjectPlanFunctionSourcePathAt(lowering, currentIndex), "missing_call_sequence", "", PrimaryObjectMissingLineNumber(lowering, irIndex))
        if len(state.error.functionName) <= 0:
            PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, currentIndex)
            state.error.bodyKind = "missing_call_sequence"
            state.error.typedIrKind = ""
            state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
        return false
    for sourceOrdinal in 0..<irFunction.callTargets.len:
        if sourceOrdinal < irFunction.callTargetImportcFlags.len &&
           irFunction.callTargetImportcFlags[sourceOrdinal]:
            continue
        let targetText = irFunction.callTargets[sourceOrdinal]
        if len(targetText) <= 0:
            continue
        if PrimaryObjectCallTargetIsBuiltin(targetText):
            continue
        # Qualified std/seqs.Add is a structured two-argument intrinsic. Its
        # statement node is consumed by the seq-add BodyIR lowering below, so
        # it has no callable std/seqs function body to mark reachable.
        if PrimaryObjectPlanCallOrdinalIsSeqAddIntrinsic(lowering,
                                                         irIndex,
                                                         sourceOrdinal,
                                                         targetText):
            continue
        if PrimaryBodyIrDirectExternalCallTarget(PrimaryBodyIrCanonicalCallTargetSymbol(targetText)):
            continue
        # Ok/Err 构造内征：return/let 等驱动语句经节点求值器内联物化 64B Result
        # 聚合（AppendResultConstruct，无 Ok/Err 调用 ordinal），但收集 pass 仍把
        # 构造头登记进 callTargets。Ok[T]/Err[T] 是泛型构造器、无可解析函数体
        # （typed_matches=0），登记为待解析目标会把整单元判 not_ready。与 builtin
        # 同理跳过——该 ordinal 槽不被任何 call op 消费（构造走 ResultProject/Construct）。
        let resultCtorTargetTail = PrimaryCallTargetTailName(targetText)
        if resultCtorTargetTail == "Ok" || resultCtorTargetTail == "Err":
            continue
        # Value(result) 内征同理跳过: node-eval(PrimaryBodyIrAppendCallExprNodeToSlot)
        # 与整调用文本路径(PrimaryBodyIrAppendWholeCallExprToSlot) 现在都把
        # `Value(x)`/`result.Value(x)` 純投影成 BodyOpResultProjectTag+
        # panic-guard(见两处 callHead=="Value" 分支), 从不发射引用该 ordinal 的
        # 真 CallOp。收集 pass 仍无条件把它登记进 callTargets(纯文本扫描, 不知
        # 道后续会被内征吸收), 若不跳过会把 Value[T] 模板判可达并尝试 lower 其
        # 原始声明体 —— 该体因 err 字段偏移依赖 sizeof/alignof(T) 在未具体化语境
        # 恒 bail_44(result.cheng:81), 挡住整单元 primary_object_plan readiness。
        # 两处内征分支任一 miss 都直接返回 false 诚实落 node-eval-miss/poison,
        # 不会退化成真调用, 故该 ordinal 与 Ok/Err 同理不被任何 call op 消费,
        # 跳过安全。
        if resultCtorTargetTail == "Value":
            continue
        # IsErr/IsOk/Error/ErrorInfoOf 内征同理跳过: 与 Ok/Err/Value 同一族
        # result.cheng 泛型模板(IsOk[T]/IsErr[T]/Error[T]/ErrorInfoOf[T]),
        # 无可解析函数体(typed_matches=0)。node-eval(PrimaryBodyIrEvalNode 的
        # enLit=="IsErr"/"IsOk"/"Error"/ErrorInfoOf 分支) 对每个 CallExpr 节点
        # (含嵌套在另一调用实参位/一元 `!` 内的形态)都无条件把它们純投影成
        # BodyOpResultProjectTag(ok-flag/errmsg/err块), miss 直接
        # PrimaryBodyIrNodeEvalMissAt poison, 从不发射引用该 ordinal 的真
        # CallOp。收集 pass 仍无条件把调用头登记进 callTargets(纯文本扫描,
        # 不知道后续会被内征吸收)——多数位置(if 条件/let 绑定/return/Fmt)该
        # ordinal 从未进这张表(专属语句路径直接绕过收集), 但当调用出现在
        # "嵌套实参位"(如 `Assert(!IsErr(r), msg)`、
        # `MobileCapiMoqError(result.Error(r))`)时收集 pass 仍会登记, 若不跳过
        # 会把 IsOk[T]/IsErr[T]/Error[T]/ErrorInfoOf[T] 模板判可达并尝试 lower
        # 其原始声明体——同 Value 一样在未具体化语境下无法定形, 挡住整单元
        # primary_object_plan readiness。跳过安全(与 Ok/Err/Value 同一论证)。
        # 门控: "Error" 与 src/std/log.cheng:107 的真实具体函数
        # `fn Error(logger: Logger, msg: str)` 撞尾名——那是可解析的真调用,
        # 不能跳过。result.cheng 四个内征全部严格 1 实参(r: var Result[T]),
        # log.Error 严格 2 实参; 用 callArgCounts[sourceOrdinal]==1 精确区分,
        # 2 实参的 "Error" 落穿到下方按真调用正常解析。
        if (resultCtorTargetTail == "IsErr" || resultCtorTargetTail == "IsOk" ||
            resultCtorTargetTail == "Error" || resultCtorTargetTail == "ErrorInfoOf") &&
           sourceOrdinal < irFunction.callArgCounts.len &&
           irFunction.callArgCounts[sourceOrdinal] == 1:
            continue
        # A primitive type cast `i64(x)` / `int32(x)` / ... and an aggregate type
        # constructor `Type(...)` get registered into callTargets by the collection pass,
        # but neither is a real call: the cast lowers to a bit reinterpret/copy and the
        # constructor materializes its value in place (default zero-init / field stores).
        # There is no function body to reach, so — like Ok/Err and builtins above — these
        # ordinals are consumed by no call op. Skip them so a built-in type name (i64) or an
        # aggregate type name (PrimaryObjectIrFunction) never registers as an unresolvable
        # call target.
        if PrimaryObjectCallTargetIsPureCast(targetText):
            continue
        if PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr,
                                                       irFunction.sourcePath,
                                                       targetText):
            continue
        if PrimaryBodyIrCallHeadIsSeqAliasConstructor(lowering.typedIr,
                                                      irFunction.sourcePath,
                                                      targetText):
            continue
        # A pointer reinterpret cast `ptr(x)`/`cstring(x)`/`owned_cstring(x)` or a pointer
        # alias / ref-handle cast `UInt8Ptr(x)`/`Int32Ptr(x)`/RefType(x) is likewise not a
        # call: it lowers to a pure pointer bit-reinterpret with no function body. The
        # collection pass registers the cast head as a callTarget; skip it so a pointer-type
        # alias (e.g. UInt8Ptr) never registers as an unresolvable call target.
        if PrimaryBodyIrPtrReinterpretCastHead(targetText):
            continue
        if PrimaryBodyIrPtrAliasReinterpretCastHead(lowering.typedIr,
                                                    irFunction.sourcePath,
                                                    targetText):
            continue
        var resolvedCallTargetSourcePath =
            PrimaryObjectCallTargetSourcePath(irFunction, sourceOrdinal)
        let importcTargetSymbol = texpr.TypedExprIrLookupImportcTargetSymbol(
            lowering.typedIr, resolvedCallTargetSourcePath, targetText)
        if len(importcTargetSymbol) > 0:
            continue
        var targetIndex: int32
        targetIndex = -1
        if sourceOrdinal >= 0 &&
           sourceOrdinal < irFunction.callTargetTypedFunctionIndexes.len:
            targetIndex = PrimaryPlanSymbolRowForTypedFunctionIndex(
                state,
                irFunction.callTargetTypedFunctionIndexes[sourceOrdinal])
        if targetIndex < 0:
            targetIndex = PrimaryObjectPlanResolveCallTargetIndex(lowering,
                                                                  irIndex,
                                                                  sourceOrdinal,
                                                                  irFunction.sourcePath,
                                                                  resolvedCallTargetSourcePath,
                                                                  targetText)
        if targetIndex < 0:
            targetIndex = PrimaryPlanUniqueFunctionTailRow(
                lowering, targetText)
        if os.GetEnv("CHENG_LOWERING_ROW_DEBUG") != "" &&
           strutil.Contains(targetText, os.GetEnv("CHENG_LOWERING_ROW_DEBUG")):
            os.WriteLine(os.GetStderr(),
                         Fmt"plan_row_target caller={lowering.functionNames[currentIndex]} target={targetText} resolved_index={targetIndex}")
        if targetIndex < 0 || targetIndex >= state.reachable.len:
            state.bodySemanticsMissing = true
            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                let rowTargetTail = PrimaryCallTargetTailName(targetText)
                var typedMatchCount: int32
                for typedProbeIndex in 0..<lowering.typedIr.functions2_functionNameIds.len:
                    let eictRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.functions2_functionNameIds[typedProbeIndex])
                    if IsOk(eictRes) && Value(eictRes) == rowTargetTail:
                        typedMatchCount = typedMatchCount + 1
                os.WriteLine(os.GetStderr(),
                             Fmt"phase=missing_call_target_row_ctx function={lowering.functionNames[currentIndex]} source_ordinal={sourceOrdinal} target_text={targetText} resolved_path={resolvedCallTargetSourcePath} function_source={irFunction.sourcePath} exact_index={PrimaryPlanResolveTargetIndexWithNames(lowering, resolvedCallTargetSourcePath, targetText)} typed_matches={typedMatchCount} typed_functions={lowering.typedIr.functions2_functionNameIds.len}")
            PrimaryObjectPlanRecordError(state, lowering.functionNames[currentIndex], PrimaryObjectPlanFunctionSourcePathAt(lowering, currentIndex), "missing_call_target", targetText, PrimaryObjectMissingLineNumber(lowering, irIndex))
            if len(state.error.functionName) <= 0:
                PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, currentIndex)
                state.error.bodyKind = "missing_call_target"
                state.error.typedIrKind = ""
                state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                state.error.callTargetOrdinal = sourceOrdinal
                state.error.callTarget = targetText
                state.error.callTargetSourcePath = resolvedCallTargetSourcePath
                PrimaryObjectPlanFillMissingCallTargetDiagnostic(state.error,
                                                                 lowering,
                                                                 currentIndex,
                                                                 strings.CloneStr(state.error.callTarget))
            return false
        if !state.reachable[targetIndex]:
            state.reachable[targetIndex] = true
            add(nextFrontier, targetIndex)
    return true

@borrows
fn PrimaryObjectPlanReachableStateCount(state: PrimaryObjectPlanPhaseState): int32 =
    var count: int32
    for i in 0..<state.reachable.len:
        if state.reachable[i]:
            count = count + 1
    return count

fn PrimaryObjectPlanRefreshFrontierFromReachable(state: var PrimaryObjectPlanPhaseState) =
    state.frontier = []
    if state.streamedEmitFirst:
        return
    for i in 0..<state.reachable.len:
        if state.reachable[i]:
            add(state.frontier, i)

@borrows
fn PrimaryObjectPlanReachabilityPhase(state: var PrimaryObjectPlanPhaseState,
                                       lowering: var lower.LoweringPlanStub,
                                       plan: var PrimaryObjectPlan,
                                       targetTriple: str) =
    var reachabilityPass: int32
    if PrimaryObjectPlanDebugEnabled():
        PrimaryObjectPlanDebugLine(Fmt"reachability_enter initial_frontier={state.frontier.len} functions={lowering.functionNames.len}")
    for _ in 0..<lowering.functionNames.len:
        if PrimaryObjectPlanDebugEnabled():
            PrimaryObjectPlanDebugLine(Fmt"reachability_pass_begin pass={reachabilityPass} frontier={state.frontier.len}")
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"reachability_pass_begin pass={reachabilityPass} frontier={state.frontier.len}")
        var nextFrontier: int32[]
        for frontierIndex in 0..<state.frontier.len:
            let currentIndex = state.frontier[frontierIndex]
            if PrimaryObjectPlanDebugEnabled():
                PrimaryObjectPlanDebugLine(Fmt"reach_visit idx={currentIndex}")
            if currentIndex < 0 || currentIndex >= lowering.functionNames.len:
                continue
            if state.streamReachabilityDiscovery && currentIndex < state.irIndexes.len:
                PrimaryObjectPlanMaterializeReachablePrimaryIr(state,
                                                               lowering,
                                                               currentIndex,
                                                               state.irIndexes[currentIndex],
                                                               targetTriple,
                                                               creq.EmitObj)
            let irIndex = state.irIndexes[currentIndex]
            if irIndex < 0:
                state.bodySemanticsMissing = true
                PrimaryObjectPlanRecordError(state, lowering.functionNames[currentIndex], PrimaryObjectPlanFunctionSourcePathAt(lowering, currentIndex), "missing_primary_object_ir", "", 0)
                if len(state.error.functionName) <= 0:
                    PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, currentIndex)
                    state.error.bodyKind = "missing_primary_object_ir"
                    state.error.typedIrKind = ""
                    state.error.lineNumber = 0
                continue
            let irFunction = lowering.primaryObjectIr.functions[irIndex]
            if irFunction.signatureLineNumber <= 0:
                state.bodySemanticsMissing = true
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(),
                                 Fmt"phase=reach_signature_missing function={irFunction.functionName} ir_index={irIndex} body_line={irFunction.bodyLineNumber} statements={irFunction.statements.len}")
                PrimaryObjectPlanRecordError(state, lowering.functionNames[currentIndex], PrimaryObjectPlanFunctionSourcePathAt(lowering, currentIndex), irFunction.bodyKind, "", PrimaryObjectMissingLineNumber(lowering, irIndex))
                if len(state.error.functionName) <= 0:
                    PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, currentIndex)
                    state.error.bodyKind = irFunction.bodyKind
                    state.error.typedIrKind = PrimaryObjectMissingTypedIrKind(lowering, irIndex)
                    state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                    PrimaryObjectPlanCaptureErrorStatementTrace(state.error, lowering, irIndex)
                continue
            let bodyKind = irFunction.bodyKind
            var bodyIrCallCount: int32
            if currentIndex < state.tempBodyIRs.len:
                bodyIrCallCount = state.tempBodyIRs[currentIndex].callSequence.len
                PrimaryObjectPlanMarkBodyIrAddressSlots(state,
                                                        currentIndex,
                                                        nextFrontier)
            if PrimaryObjectPlanDebugEnabled():
                PrimaryObjectPlanDebugLine(Fmt"reach_after_mark idx={currentIndex} body_ir_calls={bodyIrCallCount}")
            if !PrimaryObjectPlanExpandIrCallTargets(state,
                                                     lowering,
                                                     currentIndex,
                                                     irIndex,
                                                     nextFrontier):
                continue
            if PrimaryObjectPlanDebugEnabled():
                PrimaryObjectPlanDebugLine(Fmt"reach_after_expand idx={currentIndex}")
            if PrimaryCallSequenceNeedsRelocForIrFunction(bodyKind, bodyIrCallCount, irFunction):
                var callSequenceReady = true
                var requiredCallCount = PrimaryCallSequenceRequiredCallCount(bodyKind,
                                                                               bodyIrCallCount,
                                                                               irFunction.callTargets.len)
                var primaryColdCond37: bool
                if bodyIrCallCount <= 0:
                    if irFunction.callTargets.len < requiredCallCount:
                        primaryColdCond37 = true
                if irFunction.callArgCounts.len != irFunction.callTargets.len:
                    primaryColdCond37 = true
                if irFunction.callTargetSourcePaths.len != irFunction.callTargets.len:
                    primaryColdCond37 = true
                if irFunction.callTargetSignatureLineNumbers.len !=
                   irFunction.callTargets.len:
                    primaryColdCond37 = true
                if irFunction.callTargetImportcFlags.len != irFunction.callTargets.len:
                    primaryColdCond37 = true
                if irFunction.callImportcSymbols.len != irFunction.callTargets.len:
                    primaryColdCond37 = true
                if primaryColdCond37:
                    callSequenceReady = false
                    state.bodySemanticsMissing = true
                    PrimaryObjectPlanRecordError(state, lowering.functionNames[currentIndex], PrimaryObjectPlanFunctionSourcePathAt(lowering, currentIndex), "missing_call_sequence", "", PrimaryObjectMissingLineNumber(lowering, irIndex))
                    if len(state.error.functionName) <= 0:
                        PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, currentIndex)
                        state.error.bodyKind = "missing_call_sequence"
                        state.error.typedIrKind = ""
                        state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                if callSequenceReady:
                    var sourceOrdinal: int32
                    for callOrdinal in 0..<requiredCallCount:
                        var callSeqSym = ""
                        var bodyIrTargetSourcePath = ""
                        if bodyIrCallCount > 0:
                            if callOrdinal >= state.tempBodyIRs[currentIndex].callSequence.len:
                                callSequenceReady = false
                                state.bodySemanticsMissing = true
                                PrimaryObjectPlanRecordError(state, lowering.functionNames[currentIndex], PrimaryObjectPlanFunctionSourcePathAt(lowering, currentIndex), "body_ir_call_sequence_drift", Fmt"actual=<missing>;expected_index={sourceOrdinal}", PrimaryObjectMissingLineNumber(lowering, irIndex))
                                if len(state.error.functionName) <= 0:
                                    PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, currentIndex)
                                    state.error.bodyKind = "body_ir_call_sequence_drift"
                                    state.error.typedIrKind = ""
                                    state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                                    state.error.callTargetOrdinal = callOrdinal
                                    state.error.callTarget = Fmt"actual=<missing>;expected_index={sourceOrdinal};body_ir_calls={bodyIrCallCount};lowering_calls={irFunction.callTargets.len}"
                                break
                            callSeqSym = PrimaryBodyIrRelocCallTargetSymbol(
                                state.tempBodyIRs[currentIndex].callSequence[callOrdinal].targetSymbol)
                            bodyIrTargetSourcePath =
                                state.tempBodyIRs[currentIndex].callSequence[callOrdinal].targetSourcePath
                            # #95 wave5 根修 (可达性阶段镜像, provenance 门):
                            # float64(intExpr) SCVTF/UCVTF 内联 rescue 合成的
                            # CallOp 从未在 lowering-plan 登记进
                            # irFunction.callTargets(与下方
                            # PrimaryObjectPlanBuildItemsPhase 的两处豁免同一
                            # provenance 判据), 这里(可达性扩散阶段)先于 birc 循环
                            # 运行, 若不豁免会在"float64"从不作为独立可达符号出现
                            # 时把整函数判 missing_call_target。判据只认本 rescue
                            # 分支自己打的 provenance 标记
                            # (PrimaryCallOpWholeCallF64FromIntRescue), 不看多义的
                            # inlineF64FromIntKind 原值(wave4 REFUTED 教训:
                            # 无关的 PrimaryBodyIrAppendCallOp 通用路径也会置位同
                            # 一字段, 被误豁免会放过一条真实需要 BL 的调用)。
                            if PrimaryCallOpWholeCallF64FromIntRescue(state.tempBodyIRs[currentIndex].callSequence[callOrdinal]) &&
                               PrimaryCallOpInlineF64FromIntKind(state.tempBodyIRs[currentIndex].callSequence[callOrdinal],
                                                                  state.tempBodyIRs[currentIndex]) > 0:
                                continue
                            if PrimaryBodyIrDirectExternalCallTarget(callSeqSym):
                                let directExternalOrdinal = PrimaryObjectCallTargetOrdinalForActual(irFunction,
                                                                                                    callSeqSym,
                                                                                                    sourceOrdinal)
                                if directExternalOrdinal >= sourceOrdinal:
                                    sourceOrdinal = directExternalOrdinal + 1
                                    continue
                                if sourceOrdinal < irFunction.callImportcSymbols.len:
                                    let importcSym = irFunction.callImportcSymbols[sourceOrdinal]
                                    if importcSym == callSeqSym:
                                        sourceOrdinal = sourceOrdinal + 1
                                    elif len(importcSym) > 0:
                                        # BodyIR may have Cheng alias while lowering has C symbol.
                                        # Patch already attempted; align by position to avoid false drift.
                                        sourceOrdinal = sourceOrdinal + 1
                                continue
                            while sourceOrdinal < irFunction.callTargets.len:
                                let expectedBuiltinTarget = irFunction.callTargets[sourceOrdinal]
                                if !PrimaryObjectCallTargetIsBuiltin(expectedBuiltinTarget):
                                    break
                                if PrimaryObjectBuiltinCallMatchesActual(callSeqSym,
                                                                         expectedBuiltinTarget):
                                    break
                                sourceOrdinal = sourceOrdinal + 1
                            if PrimaryObjectCallTargetIsBuiltin(callSeqSym):
                                if sourceOrdinal < irFunction.callTargets.len &&
                                   PrimaryObjectBuiltinCallMatchesActual(callSeqSym,
                                                                         irFunction.callTargets[sourceOrdinal]):
                                    sourceOrdinal = sourceOrdinal + 1
                                continue
                            if PrimaryBodyIrIndirectCallIntrinsic(callSeqSym):
                                # Indirect call through a register: no symbol to
                                # resolve, no relocation.
                                if sourceOrdinal < irFunction.callTargets.len &&
                                   irFunction.callTargets[sourceOrdinal] == callSeqSym:
                                    sourceOrdinal = sourceOrdinal + 1
                                continue
                            let bodyIrTargetIndex = PrimaryPlanResolveTargetIndexWithNames(
                                lowering, bodyIrTargetSourcePath, callSeqSym)
                            if bodyIrTargetIndex >= 0 &&
                               bodyIrTargetIndex < state.reachable.len:
                                if !state.reachable[bodyIrTargetIndex]:
                                    if os.GetEnv("CHENG_LOWERING_ROW_DEBUG") != "" &&
                                       strutil.Contains(callSeqSym, os.GetEnv("CHENG_LOWERING_ROW_DEBUG")):
                                        os.WriteLine(os.GetStderr(),
                                                     Fmt"plan_bodyir_mark caller={lowering.functionNames[currentIndex]} target={callSeqSym}")
                                    state.reachable[bodyIrTargetIndex] = true
                                    add(nextFrontier, bodyIrTargetIndex)
                                if sourceOrdinal < irFunction.callTargets.len &&
                                   PrimaryObjectCallTargetOrdinalMatchesActual(irFunction,
                                                                               sourceOrdinal,
                                                                               callSeqSym):
                                    sourceOrdinal = sourceOrdinal + 1
                                continue
                            let bodyIrImportcSymbol =
                                texpr.TypedExprIrLookupImportcTargetSymbol(
                                    lowering.typedIr,
                                    bodyIrTargetSourcePath,
                                    callSeqSym)
                            if bodyIrImportcSymbol != "":
                                if sourceOrdinal < irFunction.callTargets.len &&
                                   PrimaryObjectCallTargetOrdinalMatchesActual(irFunction,
                                                                               sourceOrdinal,
                                                                               callSeqSym):
                                    sourceOrdinal = sourceOrdinal + 1
                                continue
                        var actualSourceOrdinal = sourceOrdinal
                        var matchedSourceOrdinal = -1
                        if bodyIrCallCount > 0 && len(callSeqSym) > 0:
                            matchedSourceOrdinal = PrimaryObjectCallTargetOrdinalForActual(irFunction,
                                                                                           callSeqSym,
                                                                                           sourceOrdinal)
                            if matchedSourceOrdinal >= 0:
                                actualSourceOrdinal = matchedSourceOrdinal
                            else:
                                let bodyIrOnlyTargetIndex =
                                    PrimaryPlanResolveTargetIndexWithNames(
                                        lowering,
                                        bodyIrTargetSourcePath,
                                        callSeqSym)
                                if bodyIrOnlyTargetIndex >= 0 &&
                                   bodyIrOnlyTargetIndex < state.reachable.len:
                                    if !state.reachable[bodyIrOnlyTargetIndex]:
                                        if os.GetEnv("CHENG_LOWERING_ROW_DEBUG") != "" &&
                                           strutil.Contains(callSeqSym, os.GetEnv("CHENG_LOWERING_ROW_DEBUG")):
                                            os.WriteLine(os.GetStderr(),
                                                         Fmt"plan_bodyir_mark caller={lowering.functionNames[currentIndex]} target={callSeqSym}")
                                        state.reachable[bodyIrOnlyTargetIndex] = true
                                        add(nextFrontier, bodyIrOnlyTargetIndex)
                                    continue
                                let bodyIrOnlyImportcSymbol =
                                    texpr.TypedExprIrLookupImportcTargetSymbol(
                                        lowering.typedIr,
                                        bodyIrTargetSourcePath,
                                        callSeqSym)
                                if bodyIrOnlyImportcSymbol != "":
                                    continue
                        if bodyIrCallCount <= 0 &&
                           matchedSourceOrdinal < 0 &&
                           sourceOrdinal < irFunction.callTargets.len:
                            let rowOnlyTarget = irFunction.callTargets[sourceOrdinal]
                            if sourceOrdinal < irFunction.callTargetImportcFlags.len &&
                               irFunction.callTargetImportcFlags[sourceOrdinal]:
                                sourceOrdinal = sourceOrdinal + 1
                                continue
                            let rowOnlySourcePath =
                                PrimaryObjectCallTargetSourcePath(irFunction,
                                                                  sourceOrdinal)
                            let rowOnlyImportcSymbol = texpr.TypedExprIrLookupImportcTargetSymbol(lowering.typedIr,
                                                                                                  rowOnlySourcePath,
                                                                                                  rowOnlyTarget)
                            if rowOnlyImportcSymbol != "":
                                sourceOrdinal = sourceOrdinal + 1
                                continue
                            if PrimaryObjectCallTargetIsBuiltin(rowOnlyTarget):
                                sourceOrdinal = sourceOrdinal + 1
                                continue
                            if PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr,
                                                                           irFunction.sourcePath,
                                                                           rowOnlyTarget):
                                sourceOrdinal = sourceOrdinal + 1
                                continue
                            var rowOnlyResolvedSourcePath = rowOnlySourcePath
                            let rowOnlyTargetIndex = PrimaryObjectPlanResolveCallTargetIndex(lowering,
                                                                                             irIndex,
                                                                                             sourceOrdinal,
                                                                                             irFunction.sourcePath,
                                                                                             rowOnlyResolvedSourcePath,
                                                                                             rowOnlyTarget)
                            if rowOnlyTargetIndex >= 0 &&
                               rowOnlyTargetIndex < state.reachable.len:
                                state.reachabilityRowOnlyCallTargetResolvedCount = state.reachabilityRowOnlyCallTargetResolvedCount + 1
                                if !state.reachable[rowOnlyTargetIndex]:
                                    state.reachable[rowOnlyTargetIndex] = true
                                    add(nextFrontier, rowOnlyTargetIndex)
                                sourceOrdinal = sourceOrdinal + 1
                                continue
                        var expectedCallSequenceTarget = ""
                        if matchedSourceOrdinal >= 0 &&
                           actualSourceOrdinal < irFunction.callTargetImportcFlags.len &&
                           irFunction.callTargetImportcFlags[actualSourceOrdinal] &&
                           actualSourceOrdinal < irFunction.callImportcSymbols.len &&
                           irFunction.callImportcSymbols[actualSourceOrdinal] != "":
                            expectedCallSequenceTarget = irFunction.callImportcSymbols[actualSourceOrdinal]
                        elif matchedSourceOrdinal >= 0 && actualSourceOrdinal < irFunction.callTargets.len:
                            expectedCallSequenceTarget = irFunction.callTargets[actualSourceOrdinal]
                        if bodyIrCallCount > 0:
                            var callSequenceTargetDrift = false
                            if expectedCallSequenceTarget != "" &&
                               callSeqSym != expectedCallSequenceTarget:
                                callSequenceTargetDrift = true
                                if PrimaryObjectBuiltinCallMatchesActual(callSeqSym,
                                                                         expectedCallSequenceTarget):
                                    callSequenceTargetDrift = false
                            if callSequenceTargetDrift:
                                callSequenceReady = false
                                state.bodySemanticsMissing = true
                                PrimaryObjectPlanRecordError(state, lowering.functionNames[currentIndex], PrimaryObjectPlanFunctionSourcePathAt(lowering, currentIndex), "body_ir_call_sequence_drift", Fmt"actual={callSeqSym};expected={expectedCallSequenceTarget}", PrimaryObjectMissingLineNumber(lowering, irIndex))
                                if len(state.error.functionName) <= 0:
                                    PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, currentIndex)
                                    state.error.bodyKind = "body_ir_call_sequence_drift"
                                    state.error.typedIrKind = ""
                                    state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                                    state.error.callTargetOrdinal = callOrdinal
                                    state.error.callTarget = Fmt"actual={callSeqSym};expected={expectedCallSequenceTarget};sourceOrdinal={actualSourceOrdinal};body_ir_calls={bodyIrCallCount};lowering_calls={irFunction.callTargets.len}"
                                break
                        if (matchedSourceOrdinal >= 0 ||
                           (bodyIrCallCount <= 0 && actualSourceOrdinal < irFunction.callTargets.len)) &&
                           actualSourceOrdinal < irFunction.callTargetImportcFlags.len &&
                           irFunction.callTargetImportcFlags[actualSourceOrdinal]:
                            if actualSourceOrdinal >= sourceOrdinal:
                                sourceOrdinal = actualSourceOrdinal + 1
                            continue
                        if bodyIrCallCount > 0 && len(callSeqSym) > 0:
                            let importcTargetSymbol =
                                texpr.TypedExprIrLookupImportcTargetSymbol(
                                    lowering.typedIr,
                                    bodyIrTargetSourcePath,
                                    callSeqSym)
                            if importcTargetSymbol != "":
                                if actualSourceOrdinal >= sourceOrdinal:
                                    sourceOrdinal = actualSourceOrdinal + 1
                                continue
                        var targetIndex: int32
                        var resolvedCallTargetSourcePath = ""
                        if (matchedSourceOrdinal >= 0 ||
                           (bodyIrCallCount <= 0 && actualSourceOrdinal < irFunction.callTargets.len)) &&
                           actualSourceOrdinal < irFunction.callTargetSourcePaths.len &&
                           actualSourceOrdinal < irFunction.callTargets.len:
                            if PrimaryObjectCallTargetIsBuiltin(irFunction.callTargets[actualSourceOrdinal]):
                                if actualSourceOrdinal >= sourceOrdinal:
                                    sourceOrdinal = actualSourceOrdinal + 1
                                continue
                            # Zero-arg aggregate constructor `Type()` (e.g. `PrimaryObjectIrFunction()`)
                            # is registered into callTargets but is not a real call: it materializes a
                            # zero-init value in place (no function body to reach, no relocation). The
                            # text path skips it at the same point; mirror that here so the pseudo-call
                            # op in the BodyIR call sequence is consumed without resolving a target. Named
                            # field constructors `Type(field: v)` materialize via
                            # PrimaryBodyIrAppendAggregateConstructorToSlot and emit no call op, so they
                            # never reach this loop — eae14f85c's H4/H5 handling is unaffected.
                            if PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr,
                                                                           irFunction.sourcePath,
                                                                           irFunction.callTargets[actualSourceOrdinal]):
                                if actualSourceOrdinal >= sourceOrdinal:
                                    sourceOrdinal = actualSourceOrdinal + 1
                                continue
                            resolvedCallTargetSourcePath = irFunction.callTargetSourcePaths[actualSourceOrdinal]
                            targetIndex = PrimaryObjectPlanResolveCallTargetIndex(lowering,
                                                                                  irIndex,
                                                                                  actualSourceOrdinal,
                                                                                  irFunction.sourcePath,
                                                                                  resolvedCallTargetSourcePath,
                                                                                  irFunction.callTargets[actualSourceOrdinal])
                        elif bodyIrCallCount > 0 && len(callSeqSym) > 0 &&
                             PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr,
                                                                         irFunction.sourcePath,
                                                                         callSeqSym):
                            # Zero-arg aggregate constructor `Type()` / `mod.Type()` with no matching
                            # callTarget row (qualified ctor names like `parser.NormalizedExprLayer`):
                            # materializes in place, no body to reach, no relocation. Skip the ordinal
                            # like the row-matched ctor and the text path above; do not advance
                            # sourceOrdinal (no row consumed). Named field constructors emit no call op.
                            continue
                        elif bodyIrCallCount > 0 && len(callSeqSym) > 0:
                            resolvedCallTargetSourcePath = bodyIrTargetSourcePath
                            targetIndex = PrimaryPlanResolveTargetIndexWithNames(
                                lowering,
                                resolvedCallTargetSourcePath,
                                callSeqSym)
                        else:
                            targetIndex = -1
                        if targetIndex < 0 && len(callSeqSym) > 0:
                            # bail=631/missing_call_target 补臂 (Commit D 前置): 同尾名跨源
                            # 多重载 (如 std/rawbytes.cheng 的
                            # `BytesBuilderNew(capacityHint: int32)` / `BytesBuilderNew()`)
                            # 在这条 reachability/birc 循环里也只走
                            # PrimaryObjectPlanResolveCallTargetIndex / WithNamesOrAnyUnique,
                            # 命中同一缺陷。复用同一 arg-aware 收窄 (先类型后元数两层),
                            # 只在上面两条分支都未解出时多试一层。poison-on-miss: 仍不可解 →
                            # targetIndex 保持 -1, 落回下方既有失败路径, 不改变既有行为。
                            targetIndex = PrimaryPlanResolveTargetIndexArgAwareExactSource(
                                lowering,
                                resolvedCallTargetSourcePath,
                                callSeqSym,
                                irIndex,
                                actualSourceOrdinal)
                        if targetIndex < 0 && len(callSeqSym) > 0:
                            targetIndex = PrimaryPlanSymbolRowFromTempBodyIrCall(
                                state, currentIndex, callOrdinal)
                        if targetIndex < 0 &&
                           actualSourceOrdinal >= 0 &&
                           actualSourceOrdinal <
                               irFunction.callTargetTypedFunctionIndexes.len:
                            targetIndex = PrimaryPlanSymbolRowForTypedFunctionIndex(
                                state,
                                irFunction.callTargetTypedFunctionIndexes[
                                    actualSourceOrdinal])
                        if targetIndex < 0 && len(callSeqSym) > 0:
                            targetIndex = PrimaryPlanUniqueFunctionTailRow(
                                lowering, callSeqSym)
                        if targetIndex < 0 || targetIndex >= state.reachable.len:
                            callSequenceReady = false
                            state.bodySemanticsMissing = true
                            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                var failTargetsText = ""
                                for ftIndex in 0..<irFunction.callTargets.len:
                                    failTargetsText = Fmt"{failTargetsText}|{irFunction.callTargets[ftIndex]}"
                                os.WriteLine(os.GetStderr(),
                                             Fmt"phase=missing_call_target_ctx function={lowering.functionNames[currentIndex]} call_ordinal={callOrdinal} source_ordinal={sourceOrdinal} actual_source_ordinal={actualSourceOrdinal} call_seq_sym={callSeqSym} resolved_path={resolvedCallTargetSourcePath} row_targets={failTargetsText} body_ir_calls={bodyIrCallCount}")
                            # #62 根修: 本分支下方 (companion state.error 单槽) 已用
                            # callSeqSym（BodyIR 实际尝试的调用符号，如
                            # cheng_f64_to_i64/GetRepeatedBytesField）算出真值，但此前
                            # RecordError 的 reasonDetail 硬编码 ""，致 errors[] 全量列表
                            # 该行永远拿不到这个已知目标名——与 489d33f5c(famC) 修的
                            # :62726 姊妹分支不对称。先算好同一优先级（callSeqSym 优先于
                            # row-only 猜测，因为 row 猜测在 ordinal 错位时会读到别的调用
                            # 目标，如 ModelGraphHash 处 row=ModelGraphHashStep 但真实
                            # 失败符号是 cheng_f64_to_i64，实测 CHENG_REC_TRACE 验证）
                            # 再传，errors[] 与单槽诊断口径统一，不臆猜。
                            var missingCallTargetDetail = ""
                            if bodyIrCallCount > 0 && len(callSeqSym) > 0:
                                missingCallTargetDetail = callSeqSym
                            elif actualSourceOrdinal < irFunction.callTargets.len:
                                missingCallTargetDetail = irFunction.callTargets[actualSourceOrdinal]
                            PrimaryObjectPlanRecordError(state, lowering.functionNames[currentIndex], PrimaryObjectPlanFunctionSourcePathAt(lowering, currentIndex), "missing_call_target", missingCallTargetDetail, PrimaryObjectMissingLineNumber(lowering, irIndex))
                            if len(state.error.functionName) <= 0:
                                PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, currentIndex)
                                state.error.bodyKind = "missing_call_target"
                                state.error.typedIrKind = ""
                                state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                                state.error.callTargetOrdinal = callOrdinal
                                # #62-r2 根修: 原两处各自独立的 if(非 elif) 致第二个
                                # `actualSourceOrdinal < irFunction.callTargets.len` 无条件
                                # 覆盖第一个已用 callSeqSym 设好的真值——row 表在 ordinal
                                # 错位时会读到别的调用目标（同上 missingCallTargetDetail
                                # 注释, ModelGraphHash 处 row=ModelGraphHashStep 但真实失败
                                # 符号是 cheng_f64_to_i64）。复用同一优先级结果，单槽与
                                # errors[] 全量列表口径统一，不再有第二个 if 覆盖第一个。
                                state.error.callTarget = missingCallTargetDetail
                                state.error.callTargetSourcePath = resolvedCallTargetSourcePath
                                PrimaryObjectPlanFillMissingCallTargetDiagnostic(state.error,
                                                                                 lowering,
                                                                                 currentIndex,
                                                                                 strings.CloneStr(state.error.callTarget))
                            break
                        if !state.reachable[targetIndex]:
                            state.reachable[targetIndex] = true
                            add(nextFrontier, targetIndex)
                        if actualSourceOrdinal >= sourceOrdinal:
                            sourceOrdinal = actualSourceOrdinal + 1
                if !callSequenceReady:
                    continue
        state.frontier = nextFrontier
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"reachability_pass_done pass={reachabilityPass} next_frontier={state.frontier.len}")
        if PrimaryObjectPlanDebugEnabled():
            PrimaryObjectPlanDebugLine(Fmt"reachability_pass_done pass={reachabilityPass} next_frontier={state.frontier.len}")
        reachabilityPass = reachabilityPass + 1
        # Stream discovery owns the work queue. Process exactly one function per
        # call so only that function's BodyIR is live, then return newly reached
        # functions to the caller for monotonic queueing.
        if state.streamReachabilityDiscovery:
            break
        if state.frontier.len <= 0:
            break
    if PrimaryObjectPlanDebugEnabled():
        PrimaryObjectPlanDebugLine(Fmt"reachability_done passes={reachabilityPass}")

fn PrimaryObjectPlanResetBodyIrMetrics(state: var PrimaryObjectPlanPhaseState) =
    state.bodyIROrcRetainReleasePairElidedCount = 0
    state.bodyIRScopeExitReleaseCount = 0
    state.bodyIRNoAliasFunctionCount = 0
    state.bodyIRNoAliasAppliedFunctionCount = 0
    state.bodyIRNoAliasLocalCount = 0
    state.bodyIRNoAliasForwardRewriteCount = 0
    state.bodyIRNoAliasDodSoAAllOk = true
    state.bodyIRPhaseArenaResetCount = 0
    state.bodyIRPhaseArenaReserveCount = 0
    state.bodyIRPhaseArenaCapacityBytes = int64(0)
    state.bodyIRPhaseArenaUsedBytes = int64(0)
    state.bodyIRPhaseArenaPeakBytes = int64(0)
    state.bodyIRPhaseArenaSpillCount = 0
    state.bodyIREGraphFunctionCount = 0
    state.bodyIREGraphAppliedFunctionCount = 0
    state.bodyIREGraphSkippedFunctionCount = 0
    state.bodyIREGraphHardFailFunctionCount = 0
    state.bodyIREGraphBlockCount = 0
    state.bodyIREGraphCandidateBlockCount = 0
    state.bodyIREGraphChangedBlockCount = 0
    state.bodyIREGraphSkippedBlockCount = 0
    state.bodyIREGraphUnsafeOpCount = 0
    state.bodyIREGraphClassCount = 0
    state.bodyIREGraphRoundCount = 0
    state.bodyIREGraphRuleHitCount = 0
    state.bodyIREGraphExtractedCount = 0
    state.bodyIREGraphOpDelta = 0
    state.bodyIREGraphMs = 0
    state.bodyIREGraphReason = ""
    state.bodyIROrcRetainReleasePairElidedCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIRNoAliasFunctionCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIRNoAliasAppliedFunctionCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIRNoAliasLocalCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIRNoAliasForwardRewriteCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIRNoAliasDodSoAContractOkPerIndex = PrimaryBoolSeqInit(state.wordCounts.len, true)
    state.bodyIRPhaseArenaResetCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIRPhaseArenaReserveCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIRPhaseArenaCapacityBytesPerIndex = PrimaryInt64SeqInit(state.wordCounts.len, int64(0))
    state.bodyIRPhaseArenaUsedBytesPerIndex = PrimaryInt64SeqInit(state.wordCounts.len, int64(0))
    state.bodyIRPhaseArenaPeakBytesPerIndex = PrimaryInt64SeqInit(state.wordCounts.len, int64(0))
    state.bodyIRPhaseArenaSpillCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphFunctionCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphAppliedFunctionCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphSkippedFunctionCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphHardFailFunctionCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphBlockCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphCandidateBlockCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphChangedBlockCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphSkippedBlockCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphUnsafeOpCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphClassCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphRoundCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphRuleHitCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphExtractedCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphOpDeltaPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphMsPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)
    state.bodyIREGraphReasonPerIndex = PrimaryStrSeqInit(state.wordCounts.len, "")
    state.bodyIRScopeExitReleaseCountPerIndex = PrimaryIntSeqInit(state.wordCounts.len, 0)

# F17 slice1: serial reduce pass for the per-index worker-local staging arrays
# declared on PrimaryObjectPlanPhaseState (see field comment above
# bodyIROrcRetainReleasePairElidedCountPerIndex). Must run after the lowering
# loop that populated the per-index slots has fully joined (both the classic
# PrimaryObjectPlanLoweringPhase while-loop and the streamed
# PrimaryObjectPlanBuildItemsPhase for-loop iterate i in the same ascending
# 0..<functionCount order, so a single ascending-i reduce is correct for
# either path) and before PrimaryObjectPlanFillAndCheckPhase reads the
# scalar state.bodyIR* fields into the output plan.
fn PrimaryObjectPlanReduceBodyIrPerIndexMetrics(state: var PrimaryObjectPlanPhaseState) =
    var i: int32
    let n = state.bodyIRNoAliasFunctionCountPerIndex.len
    while i < n:
        state.bodyIROrcRetainReleasePairElidedCount = state.bodyIROrcRetainReleasePairElidedCount + state.bodyIROrcRetainReleasePairElidedCountPerIndex[i]
        state.bodyIRNoAliasFunctionCount = state.bodyIRNoAliasFunctionCount + state.bodyIRNoAliasFunctionCountPerIndex[i]
        state.bodyIRNoAliasAppliedFunctionCount = state.bodyIRNoAliasAppliedFunctionCount + state.bodyIRNoAliasAppliedFunctionCountPerIndex[i]
        state.bodyIRNoAliasLocalCount = state.bodyIRNoAliasLocalCount + state.bodyIRNoAliasLocalCountPerIndex[i]
        state.bodyIRNoAliasForwardRewriteCount = state.bodyIRNoAliasForwardRewriteCount + state.bodyIRNoAliasForwardRewriteCountPerIndex[i]
        if !state.bodyIRNoAliasDodSoAContractOkPerIndex[i]:
            state.bodyIRNoAliasDodSoAAllOk = false
        state.bodyIRPhaseArenaResetCount = state.bodyIRPhaseArenaResetCount + state.bodyIRPhaseArenaResetCountPerIndex[i]
        state.bodyIRPhaseArenaReserveCount = state.bodyIRPhaseArenaReserveCount + state.bodyIRPhaseArenaReserveCountPerIndex[i]
        if state.bodyIRPhaseArenaCapacityBytesPerIndex[i] > state.bodyIRPhaseArenaCapacityBytes:
            state.bodyIRPhaseArenaCapacityBytes = state.bodyIRPhaseArenaCapacityBytesPerIndex[i]
        if state.bodyIRPhaseArenaUsedBytesPerIndex[i] > state.bodyIRPhaseArenaUsedBytes:
            state.bodyIRPhaseArenaUsedBytes = state.bodyIRPhaseArenaUsedBytesPerIndex[i]
        if state.bodyIRPhaseArenaPeakBytesPerIndex[i] > state.bodyIRPhaseArenaPeakBytes:
            state.bodyIRPhaseArenaPeakBytes = state.bodyIRPhaseArenaPeakBytesPerIndex[i]
        state.bodyIRPhaseArenaSpillCount = state.bodyIRPhaseArenaSpillCount + state.bodyIRPhaseArenaSpillCountPerIndex[i]
        state.bodyIREGraphFunctionCount = state.bodyIREGraphFunctionCount + state.bodyIREGraphFunctionCountPerIndex[i]
        state.bodyIREGraphAppliedFunctionCount = state.bodyIREGraphAppliedFunctionCount + state.bodyIREGraphAppliedFunctionCountPerIndex[i]
        state.bodyIREGraphSkippedFunctionCount = state.bodyIREGraphSkippedFunctionCount + state.bodyIREGraphSkippedFunctionCountPerIndex[i]
        state.bodyIREGraphHardFailFunctionCount = state.bodyIREGraphHardFailFunctionCount + state.bodyIREGraphHardFailFunctionCountPerIndex[i]
        state.bodyIREGraphBlockCount = state.bodyIREGraphBlockCount + state.bodyIREGraphBlockCountPerIndex[i]
        state.bodyIREGraphCandidateBlockCount = state.bodyIREGraphCandidateBlockCount + state.bodyIREGraphCandidateBlockCountPerIndex[i]
        state.bodyIREGraphChangedBlockCount = state.bodyIREGraphChangedBlockCount + state.bodyIREGraphChangedBlockCountPerIndex[i]
        state.bodyIREGraphSkippedBlockCount = state.bodyIREGraphSkippedBlockCount + state.bodyIREGraphSkippedBlockCountPerIndex[i]
        state.bodyIREGraphUnsafeOpCount = state.bodyIREGraphUnsafeOpCount + state.bodyIREGraphUnsafeOpCountPerIndex[i]
        state.bodyIREGraphClassCount = state.bodyIREGraphClassCount + state.bodyIREGraphClassCountPerIndex[i]
        state.bodyIREGraphRoundCount = state.bodyIREGraphRoundCount + state.bodyIREGraphRoundCountPerIndex[i]
        state.bodyIREGraphRuleHitCount = state.bodyIREGraphRuleHitCount + state.bodyIREGraphRuleHitCountPerIndex[i]
        state.bodyIREGraphExtractedCount = state.bodyIREGraphExtractedCount + state.bodyIREGraphExtractedCountPerIndex[i]
        state.bodyIREGraphOpDelta = state.bodyIREGraphOpDelta + state.bodyIREGraphOpDeltaPerIndex[i]
        state.bodyIREGraphMs = state.bodyIREGraphMs + state.bodyIREGraphMsPerIndex[i]
        if len(state.bodyIREGraphReason) <= 0:
            if len(state.bodyIREGraphReasonPerIndex[i]) > 0:
                state.bodyIREGraphReason = state.bodyIREGraphReasonPerIndex[i]
        state.bodyIRScopeExitReleaseCount = state.bodyIRScopeExitReleaseCount + state.bodyIRScopeExitReleaseCountPerIndex[i]
        i = i + 1

# F17 slice2: serial replay of the deferred lazyIrConsumerCounts decrement/
# release recorded by PrimaryBuildBodyIrForFunction into
# lazyIrReleaseCandidatePerIndex (see field comment on
# PrimaryObjectPlanPhaseState). Walks i in the same ascending 0..<functionCount
# order the original in-place code ran under (both PrimaryObjectPlanLoweringPhase
# and PrimaryObjectPlanBuildItemsPhase iterate i ascending — see
# PrimaryObjectPlanReduceBodyIrPerIndexMetrics doc comment above), decrementing
# the shared per-irIndex counter and releasing once it reaches zero. Every real
# consumer across every closure-pass round has already completed its own build
# (and read whatever it needed from the shared ir row's statements) strictly
# before this replay runs, so reordering the counter mutation to a single
# after-the-fact pass does not change which consumer sees which statements —
# only when the now-redundant shared statements memory gets freed. Must run
# before PrimaryObjectPlanFillAndCheckPhase (or any other reader) can observe a
# shared ir row's statements.
fn PrimaryObjectPlanReplayLazyIrReleases(state: var PrimaryObjectPlanPhaseState,
                                          lowering: var lower.LoweringPlanStub) =
    os.WriteLine(os.GetStderr(),
                 Fmt"replay_lazy_enter n={state.lazyIrReleaseCandidatePerIndex.len} shapeBuf={lower.LoweringPlanPrimaryObjectIrFunctionShapeAllocatorPhysicalBufferCount(lowering)}")
    var i: int32
    let n = state.lazyIrReleaseCandidatePerIndex.len
    let lifecycleTrackedBeforeBufferCount =
        lower.LoweringPlanLifecycleTrackedPhysicalBufferCount(lowering)
    let lifecycleTrackedBeforeBytes =
        lower.LoweringPlanLifecycleTrackedRetainedBytes(lowering)
    while i < n:
        if state.lazyIrReleaseCandidatePerIndex[i]:
            if i < state.irIndexes.len:
                let irIndex = state.irIndexes[i]
                if irIndex >= 0 && irIndex < state.lazyIrConsumerCounts.len:
                    state.lazyIrConsumerCounts[irIndex] = state.lazyIrConsumerCounts[irIndex] - 1
                    if state.lazyIrConsumerCounts[irIndex] <= 0:
                        PrimaryObjectPlanReleaseLazyFunctionStatements(lowering.primaryObjectIr,
                                                                       irIndex)
        i = i + 1
    lower.LoweringPlanLifecycleReleaseTrackingRecord(
        lowering,
        lifecycleTrackedBeforeBufferCount,
        lifecycleTrackedBeforeBytes,
        lower.LoweringPlanLifecycleTrackedPhysicalBufferCount(lowering),
        lower.LoweringPlanLifecycleTrackedRetainedBytes(lowering))
    os.WriteLine(os.GetStderr(),
                 Fmt"replay_lazy_leave shapeBuf={lower.LoweringPlanPrimaryObjectIrFunctionShapeAllocatorPhysicalBufferCount(lowering)}")

fn PrimaryObjectPlanPrepareDeclOrderStreamReachability(state: var PrimaryObjectPlanPhaseState,
                                                        linkPlan: var slplan.SystemLinkPlanStub,
                                                        lowering: var lower.LoweringPlanStub,
                                                        plan: var PrimaryObjectPlan) =
    state.streamedEmitFirst = true
    if state.emitObjectRootsAllFunctions:
        state.frontier = []
        return
    state.streamReachabilityDiscovery = true
    var pendingFunctions: int32[]
    for frontierIndex in 0..<state.frontier.len:
        add(pendingFunctions, state.frontier[frontierIndex])
    var pendingIndex: int32
    while pendingIndex < pendingFunctions.len:
        let nextIndex = pendingFunctions[pendingIndex]
        pendingIndex = pendingIndex + 1
        if nextIndex < 0 || nextIndex >= lowering.functionNames.len:
            panic(Fmt"primary_object_decl_order_stream invalid_reachability_index={nextIndex} function_count={lowering.functionNames.len}")
        PrimaryObjectPlanEnsureFunctionLowered(state,
                                               lowering,
                                               nextIndex,
                                               linkPlan.targetTriple,
                                               linkPlan.emitKind)
        state.frontier = [nextIndex]
        PrimaryObjectPlanReachabilityPhase(state,
                                           lowering,
                                           plan,
                                           linkPlan.targetTriple)
        for nextFrontierIndex in 0..<state.frontier.len:
            add(pendingFunctions, state.frontier[nextFrontierIndex])
        if nextIndex < state.tempBodyIRs.len:
            var nextFunctionIrIndex: int32 = -1
            if nextIndex < state.irIndexes.len:
                nextFunctionIrIndex = state.irIndexes[nextIndex]
            var releaseBodyIR_nextIndex = state.tempBodyIRs[nextIndex]
            state.tempBodyIRs[nextIndex] = coreir.BodyIRNew()
            PrimaryObjectPlanReleaseLoweredBodyIr(
                state,
                releaseBodyIR_nextIndex,
                nextFunctionIrIndex,
                bodylifecycle.BodyIrFunctionOutcomeEarlyReturn)
    state.streamReachabilityDiscovery = false
    state.frontier = []
    for i in 0..<lowering.functionNames.len:
        if i < state.tempBodyIRs.len:
            var functionIrIndex: int32 = -1
            if i < state.irIndexes.len:
                functionIrIndex = state.irIndexes[i]
            var releaseBodyIR = state.tempBodyIRs[i]
            state.tempBodyIRs[i] = coreir.BodyIRNew()
            PrimaryObjectPlanReleaseLoweredBodyIr(
                state,
                releaseBodyIR,
                functionIrIndex,
                bodylifecycle.BodyIrFunctionOutcomeEarlyReturn)
        if i < state.wordCounts.len:
            state.wordCounts[i] = 0
        if i < state.bodyIrLowered.len:
            state.bodyIrLowered[i] = false
    PrimaryObjectPlanResetBodyIrMetrics(state)
    if state.bodySemanticsMissing:
        PrimaryObjectPlanMarkDeclOrderStreamBuildAbort(state,
                                                        -1,
                                                        state.error.functionName,
                                                        state.error.functionSourcePath,
                                                        state.error.bodyKind)

fn PrimaryNodePathStrictMode(): str =
    # CHENG_NODE_PATH_STRICT instrumentation switch.
    #   ""        -> off (default; flag-off production behavior unchanged).
    #   "abort"   -> abort the compile on the first unhandled statement.
    #   any other -> record mode: log every unhandled statement to stderr, but
    #                still complete the (text/word-zero) compile so one run
    #                yields the full worklist.
    return os.GetEnv("CHENG_NODE_PATH_STRICT")

fn PrimaryNodePathStrictBodyOpKindText(kind: int32): str =
    if kind == coreir.BodyOpInvalidTag:
        return "invalid"
    if kind == coreir.BodyOpLoadConstTag:
        return "load_const"
    if kind == coreir.BodyOpCallTag:
        return "call"
    if kind == coreir.BodyOpBinOpTag:
        return "bin_op"
    if kind == coreir.BodyOpCmpTag:
        return "cmp"
    if kind == coreir.BodyOpBranchTag:
        return "branch"
    if kind == coreir.BodyOpReturnTag:
        return "return"
    if kind == coreir.BodyOpLoadLocalTag:
        return "load_local"
    if kind == coreir.BodyOpStoreLocalTag:
        return "store_local"
    if kind == coreir.BodyOpCopyLocalTag:
        return "copy_local"
    if kind == coreir.BodyOpResultProjectTag:
        return "result_project"
    if kind == coreir.BodyOpStrEqLiteralTag:
        return "str_eq_literal"
    if kind == coreir.BodyOpIndexedLoadTag:
        return "indexed_load"
    if kind == coreir.BodyOpIndexedStoreTag:
        return "indexed_store"
    if kind == coreir.BodyOpFieldLoadTag:
        return "field_load"
    if kind == coreir.BodyOpFieldStoreTag:
        return "field_store"
    if kind == coreir.BodyOpGlobalLoadTag:
        return "global_load"
    if kind == coreir.BodyOpGlobalStoreTag:
        return "global_store"
    if kind == coreir.BodyOpStrEqTag:
        return "str_eq"
    return strutil.Join(["op_", strings.IntToStr(kind)], "")

@borrows
fn PrimaryNodePathStrictStatementText(irFunction: lower.PrimaryObjectIrFunction,
                                       lineNumber: int32): str =
    # Recover the surface statement for a zero-size op by source line.
    if lineNumber <= 0:
        return ""
    for s in 0..<irFunction.statements.len:
        if irFunction.statements[s].lineNumber == lineNumber:
            if irFunction.statements[s].surfaceText != "":
                return strings.CloneStr(irFunction.statements[s].surfaceText)
            return PrimaryObjectStatementKindCodeText(int32(irFunction.statements[s].kind))
    return ""

@borrows
fn PrimaryNodePathStrictReport(bodyIR: coreir.BodyIR,
                                irFunction: lower.PrimaryObjectIrFunction,
                                bodyKind: str,
                                mode: str) =
    # Walk every zero-size op (the points where the node path failed to emit
    # real machine code for a statement) and report it. This is the true,
    # flag-off production worklist: each line is one statement form the node
    # path could not lower. In abort mode we stop at the first.
    let abortMode = mode == "abort"
    if bodyIR.ops.len <= 0:
        # Node path produced no ops at all (whole function not lowered). Pin
        # the first source statement so the worklist still names a form.
        var emptyLine: int32 = -1
        var emptyKind = "unsupported"
        if irFunction.statements.len > 0:
            emptyLine = irFunction.statements[0].lineNumber
            emptyKind = PrimaryObjectStatementKindCodeText(int32(irFunction.statements[0].kind))
        let emptyStmt = PrimaryNodePathStrictStatementText(irFunction, emptyLine)
        os.WriteLine(os.GetStderr(), strutil.Join([
            "unhandled function=",
            strings.CloneStr(irFunction.functionName),
            " source=",
            strings.CloneStr(irFunction.sourcePath),
            " line=",
            strings.IntToStr(emptyLine),
            " kind=",
            emptyKind,
            " body_kind=",
            strings.CloneStr(bodyKind),
            " reason=no_body_ir op_index=-1 stmt=",
            emptyStmt
        ], ""))
        if abortMode:
            panic(strutil.Join([
                "CHENG_NODE_PATH_STRICT abort: unhandled function=",
                strings.CloneStr(irFunction.functionName),
                " reason=no_body_ir"
            ], ""))
        return
    for opi in 0..<bodyIR.ops.len:
        if PrimaryBodyIROpSizeAt(bodyIR, opi) > 0:
            continue
        let op = bodyIR.ops[opi]
        var stmtKindText: str
        var lineNumber: int32
        var reason: str
        if op.kind == coreir.BodyOpInvalidTag:
            # Invalid op encoding: target=line, operands[0]=statementKind,
            # operands[1]=detail0 (bail reason code), operands[2]=detail1.
            lineNumber = op.target
            if op.operands.len > 0:
                stmtKindText = PrimaryObjectStatementKindCodeText(op.operands[0])
            else:
                stmtKindText = "unsupported"
            if op.operands.len > 1:
                reason = strutil.Join(["bail_", strings.IntToStr(op.operands[1])], "")
            else:
                reason = "bail"
        else:
            lineNumber = -1
            stmtKindText = PrimaryNodePathStrictBodyOpKindText(op.kind)
            reason = strutil.Join(["zero_size_", PrimaryNodePathStrictBodyOpKindText(op.kind)], "")
        let stmtText = PrimaryNodePathStrictStatementText(irFunction, lineNumber)
        os.WriteLine(os.GetStderr(), strutil.Join([
            "unhandled function=",
            strings.CloneStr(irFunction.functionName),
            " source=",
            strings.CloneStr(irFunction.sourcePath),
            " line=",
            strings.IntToStr(lineNumber),
            " kind=",
            share(stmtKindText),
            " body_kind=",
            strings.CloneStr(bodyKind),
            " reason=",
            share(reason),
            " op_index=",
            strings.IntToStr(opi),
            " stmt=",
            share(stmtText)
        ], ""))
        if abortMode:
            panic(strutil.Join([
                "CHENG_NODE_PATH_STRICT abort: unhandled function=",
                strings.CloneStr(irFunction.functionName),
                " line=",
                strings.IntToStr(lineNumber),
                " kind=",
                share(stmtKindText),
                " reason=",
                share(reason)
            ], ""))

fn PrimaryObjectPlanAccumulateStreamedBodyIrDod(plan: var PrimaryObjectPlan,
                                                 bodyIR: var coreir.BodyIR) =
    if bodyIR.ops.len <= 0 && bodyIR.terms.len <= 0:
        return
    plan.bodyIRDodSoAFunctionCount = plan.bodyIRDodSoAFunctionCount + 1
    plan.bodyIRDodSoAOpCount = plan.bodyIRDodSoAOpCount + bodyIR.ops.len
    plan.bodyIRDodSoATermCount = plan.bodyIRDodSoATermCount + bodyIR.terms.len
    plan.bodyIRDodSoAOpOperandCount = plan.bodyIRDodSoAOpOperandCount + coreir.BodyIRPhaseArenaOpOperandCount(bodyIR)
    plan.bodyIRDodSoATermOperandCount = plan.bodyIRDodSoATermOperandCount + coreir.BodyIRPhaseArenaTermOperandCount(bodyIR)

fn PrimaryObjectPlanBuildItemSnapshotCapture(state: var PrimaryObjectPlanPhaseState): PrimaryObjectBuildItemSnapshot =
    var out: PrimaryObjectBuildItemSnapshot
    out.itemIdsLen = state.itemIds.len
    out.symbolNamesLen = state.symbolNames.len
    out.symbolTypedFunctionIndexesLen =
        state.symbolTypedFunctionIndexes.len
    out.symbolNameIdsLen = state.symbolNameIds.len
    out.symbolRolesLen = state.symbolRoles.len
    out.symbolInterfaceCidsLen = state.symbolInterfaceCids.len
    out.functionWordOffsetsLen = state.functionWordOffsets.len
    out.functionWordCountsLen = state.functionWordCounts.len
    out.functionBodyKindsLen = state.functionBodyKinds.len
    out.functionInstructionBodyKindsLen = state.functionInstructionBodyKinds.len
    out.functionStatementReturnModesLen = state.functionStatementReturnModes.len
    out.functionStatementReturnI32ValuesLen = state.functionStatementReturnI32Values.len
    out.functionStatementCallCountsLen = state.functionStatementCallCounts.len
    out.functionIrIndexesLen = state.functionIrIndexes.len
    out.functionBodyIRsLen = state.functionBodyIRs.len
    out.dataLabelsLen = state.dataLabels.len
    out.dataPayloadTextsLen = state.dataPayloadTexts.len
    out.dataPayloadRawBytesLen = state.dataPayloadRawBytes.len
    out.dataPayloadRawByteCountsLen = state.dataPayloadRawByteCounts.len
    out.relocSourceItemIdsLen = state.relocSourceItemIds.len
    out.relocWordOffsetsLen = state.relocWordOffsets.len
    out.relocTargetSymbolsLen = state.relocTargetSymbols.len
    out.relocTargetDomainKindsLen =
        state.relocTargetDomainKinds.len
    out.relocTargetRowsLen = state.relocTargetRows.len
    out.relocTargetInterfaceCidsLen =
        state.relocTargetInterfaceCids.len
    out.relocCallOrdinalLen = state.relocCallOrdinal.len
    out.dataRelocSourceItemIdsLen = state.dataRelocSourceItemIds.len
    out.dataRelocWordOffsetsLen = state.dataRelocWordOffsets.len
    out.dataRelocPredictedKeyLen = state.dataRelocPredictedKey.len
    out.dataRelocOpIndexLen = state.dataRelocOpIndex.len
    out.dataRelocSubIndexLen = state.dataRelocSubIndex.len
    out.dataRelocTargetSymbolsLen = state.dataRelocTargetSymbols.len
    out.totalWordCount = state.totalWordCount
    out.needsRuntimeCommandData = state.needsRuntimeCommandData
    return out

fn PrimaryObjectPlanRollbackBuildItemState(state: var PrimaryObjectPlanPhaseState,
                                             snapshot: PrimaryObjectBuildItemSnapshot) =
    assert(snapshot.itemIdsLen <= state.itemIds.len &&
           snapshot.symbolNamesLen <= state.symbolNames.len &&
           snapshot.symbolTypedFunctionIndexesLen <=
               state.symbolTypedFunctionIndexes.len &&
           snapshot.symbolNameIdsLen <= state.symbolNameIds.len &&
           snapshot.symbolRolesLen <= state.symbolRoles.len &&
           snapshot.symbolInterfaceCidsLen <=
               state.symbolInterfaceCids.len &&
           snapshot.functionWordOffsetsLen <= state.functionWordOffsets.len &&
           snapshot.functionWordCountsLen <= state.functionWordCounts.len &&
           snapshot.functionBodyKindsLen <= state.functionBodyKinds.len &&
           snapshot.functionInstructionBodyKindsLen <= state.functionInstructionBodyKinds.len &&
           snapshot.functionStatementReturnModesLen <= state.functionStatementReturnModes.len &&
           snapshot.functionStatementReturnI32ValuesLen <= state.functionStatementReturnI32Values.len &&
           snapshot.functionStatementCallCountsLen <= state.functionStatementCallCounts.len &&
           snapshot.functionIrIndexesLen <= state.functionIrIndexes.len &&
           snapshot.functionBodyIRsLen <= state.functionBodyIRs.len &&
           snapshot.dataLabelsLen <= state.dataLabels.len &&
           snapshot.dataPayloadTextsLen <= state.dataPayloadTexts.len &&
           snapshot.dataPayloadRawBytesLen <= state.dataPayloadRawBytes.len &&
           snapshot.dataPayloadRawByteCountsLen <= state.dataPayloadRawByteCounts.len &&
           snapshot.relocSourceItemIdsLen <= state.relocSourceItemIds.len &&
           snapshot.relocWordOffsetsLen <= state.relocWordOffsets.len &&
           snapshot.relocTargetSymbolsLen <= state.relocTargetSymbols.len &&
           snapshot.relocTargetDomainKindsLen <=
               state.relocTargetDomainKinds.len &&
           snapshot.relocTargetRowsLen <= state.relocTargetRows.len &&
           snapshot.relocTargetInterfaceCidsLen <=
               state.relocTargetInterfaceCids.len &&
           snapshot.relocCallOrdinalLen <= state.relocCallOrdinal.len &&
           snapshot.dataRelocSourceItemIdsLen <= state.dataRelocSourceItemIds.len &&
           snapshot.dataRelocWordOffsetsLen <= state.dataRelocWordOffsets.len &&
           snapshot.dataRelocPredictedKeyLen <= state.dataRelocPredictedKey.len &&
           snapshot.dataRelocOpIndexLen <= state.dataRelocOpIndex.len &&
           snapshot.dataRelocSubIndexLen <= state.dataRelocSubIndex.len &&
           snapshot.dataRelocTargetSymbolsLen <= state.dataRelocTargetSymbols.len,
           " primary build item rollback: invalid snapshot")
    setLen(state.itemIds, snapshot.itemIdsLen)
    setLen(state.symbolNames, snapshot.symbolNamesLen)
    setLen(state.symbolTypedFunctionIndexes,
           snapshot.symbolTypedFunctionIndexesLen)
    setLen(state.symbolNameIds, snapshot.symbolNameIdsLen)
    setLen(state.symbolRoles, snapshot.symbolRolesLen)
    setLen(state.symbolInterfaceCids,
           snapshot.symbolInterfaceCidsLen)
    setLen(state.functionWordOffsets, snapshot.functionWordOffsetsLen)
    setLen(state.functionWordCounts, snapshot.functionWordCountsLen)
    setLen(state.functionBodyKinds, snapshot.functionBodyKindsLen)
    setLen(state.functionInstructionBodyKinds, snapshot.functionInstructionBodyKindsLen)
    setLen(state.functionStatementReturnModes, snapshot.functionStatementReturnModesLen)
    setLen(state.functionStatementReturnI32Values, snapshot.functionStatementReturnI32ValuesLen)
    setLen(state.functionStatementCallCounts, snapshot.functionStatementCallCountsLen)
    setLen(state.functionIrIndexes, snapshot.functionIrIndexesLen)
    setLen(state.functionBodyIRs, snapshot.functionBodyIRsLen)
    setLen(state.dataLabels, snapshot.dataLabelsLen)
    setLen(state.dataPayloadTexts, snapshot.dataPayloadTextsLen)
    setLen(state.dataPayloadRawBytes, snapshot.dataPayloadRawBytesLen)
    setLen(state.dataPayloadRawByteCounts, snapshot.dataPayloadRawByteCountsLen)
    setLen(state.relocSourceItemIds, snapshot.relocSourceItemIdsLen)
    setLen(state.relocWordOffsets, snapshot.relocWordOffsetsLen)
    setLen(state.relocTargetSymbols, snapshot.relocTargetSymbolsLen)
    setLen(state.relocTargetDomainKinds,
           snapshot.relocTargetDomainKindsLen)
    setLen(state.relocTargetRows, snapshot.relocTargetRowsLen)
    setLen(state.relocTargetInterfaceCids,
           snapshot.relocTargetInterfaceCidsLen)
    setLen(state.relocCallOrdinal, snapshot.relocCallOrdinalLen)
    setLen(state.dataRelocSourceItemIds, snapshot.dataRelocSourceItemIdsLen)
    setLen(state.dataRelocWordOffsets, snapshot.dataRelocWordOffsetsLen)
    setLen(state.dataRelocPredictedKey, snapshot.dataRelocPredictedKeyLen)
    setLen(state.dataRelocOpIndex, snapshot.dataRelocOpIndexLen)
    setLen(state.dataRelocSubIndex, snapshot.dataRelocSubIndexLen)
    setLen(state.dataRelocTargetSymbols, snapshot.dataRelocTargetSymbolsLen)
    state.totalWordCount = snapshot.totalWordCount
    state.needsRuntimeCommandData = snapshot.needsRuntimeCommandData

@borrows
fn PrimaryObjectPlanMarkDeclOrderStreamBuildAbort(state: var PrimaryObjectPlanPhaseState,
                                                    functionIndex: int32,
                                                    functionName: str,
                                                    functionSourcePath: str,
                                                    failureKind: str) =
    if state.streamedBuildAborted:
        state.bodySemanticsMissing = true
        return
    var stableFailureKind = failureKind
    if len(stableFailureKind) <= 0:
        stableFailureKind = "body_semantics_missing"
    state.streamedBuildAborted = true
    state.streamedBuildAbortReason = share(stableFailureKind)
    state.bodySemanticsMissing = true
    var stableFunctionName = functionName
    if len(state.error.functionName) > 0:
        stableFunctionName = state.error.functionName
    if len(stableFunctionName) <= 0 &&
       functionIndex >= 0 &&
       functionIndex < state.symbolNames.len:
        stableFunctionName = state.symbolNames[functionIndex]
    var failureDetail = ""
    if state.streamedBackpatchCallOrdinal >= 0 ||
       state.streamedBackpatchDataOpIndex >= 0 ||
       state.streamedBackpatchDataSubIndex >= 0:
        failureDetail = Fmt"call_ordinal={state.streamedBackpatchCallOrdinal};data_op_index={state.streamedBackpatchDataOpIndex};data_sub_index={state.streamedBackpatchDataSubIndex}"
    if len(state.error.functionName) <= 0:
        state.error.functionName = share(stableFunctionName)
        state.error.functionSourcePath = share(functionSourcePath)
        state.error.bodyKind = share(stableFailureKind)
        state.error.callTarget = share(failureDetail)
        state.error.callTargetOrdinal = state.streamedBackpatchCallOrdinal
        if functionIndex >= 0 && functionIndex < state.functionWordOffsets.len:
            state.error.wordOffset = state.functionWordOffsets[functionIndex]
        if functionIndex >= 0 && functionIndex < state.functionWordCounts.len:
            state.error.wordCount = state.functionWordCounts[functionIndex]
    PrimaryObjectPlanRecordError(state,
                                 stableFunctionName,
                                 functionSourcePath,
                                 stableFailureKind,
                                 failureDetail,
                                 state.error.lineNumber)

fn PrimaryObjectPlanReleaseAbortedBuildPayload(state: var PrimaryObjectPlanPhaseState,
                                                plan: var PrimaryObjectPlan) =
    var releasedFunctionCount: int32
    var releasedPayloadItemCount: int32
    for i in 0..<state.tempBodyIRs.len:
        let payloadCount = PrimaryBodyIrPayloadItemCount(state.tempBodyIRs[i])
        if payloadCount > 0:
            releasedFunctionCount = releasedFunctionCount + 1
            releasedPayloadItemCount = releasedPayloadItemCount + payloadCount
    for i in 0..<state.functionBodyIRs.len:
        let payloadCount = PrimaryBodyIrPayloadItemCount(state.functionBodyIRs[i])
        if payloadCount > 0:
            releasedFunctionCount = releasedFunctionCount + 1
            releasedPayloadItemCount = releasedPayloadItemCount + payloadCount
    for i in 0..<plan.functionBodyIRs.len:
        if bodylifecycle.BodyIrPayloadHasPhysicalStorage(
               plan.functionBodyIRs[i]):
            panic(
                "primary body ir lifecycle: aborted stream plan retained payload")
    state.fillCheckReleasedBodyIrFunctionCount = state.fillCheckReleasedBodyIrFunctionCount + releasedFunctionCount
    state.fillCheckReleasedBodyIrPayloadItemCount = state.fillCheckReleasedBodyIrPayloadItemCount + releasedPayloadItemCount
    for i in 0..<state.tempBodyIRs.len:
        var functionIrIndex: int32 = -1
        if i < state.irIndexes.len:
            functionIrIndex = state.irIndexes[i]
        # C5: hoist element out of state before dual-var call; write back.
        var releaseBodyIR = state.tempBodyIRs[i]
        PrimaryObjectPlanReleaseLoweredBodyIr(
            state,
            releaseBodyIR,
            functionIrIndex,
            bodylifecycle.BodyIrFunctionOutcomeDiagnostic)
        state.tempBodyIRs[i] = releaseBodyIR
    for i in 0..<state.functionBodyIRs.len:
        var functionIrIndex: int32 = -1
        if i < state.functionIrIndexes.len:
            functionIrIndex = state.functionIrIndexes[i]
        var releaseBodyIR = state.functionBodyIRs[i]
        PrimaryObjectPlanReleaseLoweredBodyIr(
            state,
            releaseBodyIR,
            functionIrIndex,
            bodylifecycle.BodyIrFunctionOutcomeDiagnostic)
        state.functionBodyIRs[i] = releaseBodyIR
    let _ = bodylifecycle.BodyIrPayloadReleaseSequence(
        state.tempBodyIRs)
    let _ = bodylifecycle.BodyIrPayloadReleaseSequence(
        state.functionBodyIRs)
    let _ = bodylifecycle.BodyIrPayloadReleaseSequence(
        plan.functionBodyIRs)
    state.relocSourceItemIds = []
    state.relocWordOffsets = []
    state.relocTargetSymbols = []
    state.relocTargetDomainKinds = []
    state.relocTargetRows = []
    state.relocTargetInterfaceCids = []
    state.relocCallOrdinal = []
    state.dataRelocSourceItemIds = []
    state.dataRelocWordOffsets = []
    state.dataRelocPredictedKey = []
    state.dataRelocOpIndex = []
    state.dataRelocSubIndex = []
    state.dataRelocTargetSymbols = []
    state.dataLabels = []
    state.dataPayloadTexts = []
    state.dataPayloadRawBytes = []
    state.dataPayloadRawByteCounts = []
    state.needsRuntimeCommandData = false
    state.totalWordCount = 0
    plan.instructionWords = []
    plan.regallocFrozenSnapshotSinglePayloads = []
    plan.regallocEmissionLedgerSinglePayloads = []
    plan.regallocFunctionSymbols = []
    plan.regallocFunctionIrIndexes = []
    plan.regallocFunctionKinds = []
    plan.regallocFunctionIndex =
        regart.RegallocProductionFunctionIndexInit(0)
    plan.regallocFunctionBodyIrSha256s = []
    plan.regallocFunctionSymbolByteStarts = []
    plan.regallocFunctionSymbolByteLengths = []
    plan.regallocFunctionSymbolBytesSha256s = []
    plan.regallocFunctionPlanSha256s = []
    plan.regallocFunctionActionSemanticRootSha256s = []
    plan.regallocFunctionActionLedgerRootSha256s = []
    plan.regallocFunctionMachineFragmentRootSha256s = []
    plan.regallocFunctionAbiIngressRootSha256s = []
    plan.regallocFunctionDeferReceiptStarts = []
    plan.regallocFunctionDeferReceiptCounts = []
    plan.regallocDeferFunctionRows = []
    plan.regallocDeferStatementRows = []
    plan.regallocDeferActionCids = []
    plan.regallocDeferFragmentCids = []
    plan.regallocFunctionDebugProvenanceBound = []
    plan.regallocFunctionDebugFunctionIds = []
    plan.regallocFunctionDebugProvenanceSha256s = []
    plan.regallocFunctionDebugMachineFragmentRootSha256s = []
    plan.regallocFunctionDebugFragmentStarts = []
    plan.regallocFunctionDebugFragmentCounts = []
    plan.regallocDebugFragmentFunctionIndexes = []
    plan.regallocDebugFragmentOpIds = []
    plan.regallocDebugFragmentSyntheticKinds = []
    plan.regallocDebugFragmentSiteKinds = []
    plan.regallocDebugFragmentSiteIndexes = []
    plan.regallocDebugFragmentMachineOwnerKinds = []
    plan.regallocDebugFragmentMachineOwnerOrdinals = []
    plan.regallocDebugFragmentActionConsumerOrdinals = []
    plan.regallocDebugFragmentTextByteStarts = []
    plan.regallocDebugFragmentByteLengths = []
    plan.regallocDebugFragmentBytesSha256s = []
    plan.regallocFunctionActionCounts = []
    plan.regallocFunctionExactCalleeMasks = []
    plan.regallocFunctionRegisterAssignmentCounts = []
    plan.regallocFunctionSpillActionCounts = []
    plan.regallocFunctionReloadActionCounts = []
    plan.regallocFunctionCallClobberActionCounts = []
    plan.regallocFunctionEdgeParallelCopyActionCounts = []
    plan.regallocFunctionParallelCopyCycleBreakActionCounts = []
    plan.regallocFunctionCriticalEdgeActionCounts = []
    plan.regallocFunctionSretExclusionCounts = []
    plan.regallocFunctionAddressEscapeMemoryActionCounts = []
    plan.regallocFunctionOutgoingStackArgActionCounts = []
    PrimaryBackpatchResetRelocRecords()
    primaryBackpatchActive = false

fn PrimaryObjectPlanStreamEmitSnapshotCapture(state: var PrimaryObjectPlanPhaseState,
                                                plan: var PrimaryObjectPlan,
                                                functionIndex: int32,
                                                relocStart: int32,
                                                dataRelocStart: int32): PrimaryObjectStreamEmitSnapshot =
    var out: PrimaryObjectStreamEmitSnapshot
    out.instructionWordCount = plan.instructionWords.len
    out.relocCount = relocStart
    out.dataRelocCount = dataRelocStart
    out.totalWordCount = state.totalWordCount
    out.bodyIRDodSoAFunctionCount = plan.bodyIRDodSoAFunctionCount
    out.bodyIRDodSoAOpCount = plan.bodyIRDodSoAOpCount
    out.bodyIRDodSoATermCount = plan.bodyIRDodSoATermCount
    out.bodyIRDodSoAOpOperandCount = plan.bodyIRDodSoAOpOperandCount
    out.bodyIRDodSoATermOperandCount = plan.bodyIRDodSoATermOperandCount
    out.backpatchFunctionBase = primaryBackpatchFunctionBase
    out.backpatchCallRelocCount = primaryBackpatchCallRelocFnBase.len
    out.backpatchDataRelocCount = primaryBackpatchDataRelocFnBase.len
    out.regallocEvidenceCount = plan.regallocFunctionSymbols.len
    out.regallocDebugFragmentCount = plan.regallocDebugFragmentOpIds.len
    out.regallocDeferReceiptCount = plan.regallocDeferActionCids.len
    if functionIndex >= 0 &&
       functionIndex < state.functionWordOffsets.len &&
       functionIndex < state.functionWordCounts.len:
        out.functionLayoutValid = true
        out.functionWordOffset = state.functionWordOffsets[functionIndex]
        out.functionWordCount = state.functionWordCounts[functionIndex]
    return out

fn PrimaryObjectPlanRecordBodyIrLifecycleReceipt(
        state: var PrimaryObjectPlanPhaseState,
        receipt: bodylifecycle.BodyIrFunctionLifecycleReceipt) =
    let sourceIdentityExact =
        receipt.functionIdentityKind ==
            bodylifecycle.BodyIrFunctionIdentitySource &&
        receipt.functionIrIndex >= 0 &&
        receipt.functionIdentityIndex == receipt.functionIrIndex
    let entryBridgeIdentityExact =
        receipt.functionIdentityKind ==
            bodylifecycle.BodyIrFunctionIdentitySyntheticEntryBridge &&
        receipt.functionIrIndex == -1 &&
        receipt.functionIdentityIndex ==
            bodylifecycle.BodyIrSyntheticEntryBridgeIndex
    var expectedOwnerTransferCount: int64
    if receipt.outcome ==
           bodylifecycle.BodyIrFunctionOutcomeEmitSuccess ||
       receipt.outcome ==
           bodylifecycle.BodyIrFunctionOutcomeEmitFailure ||
       receipt.outcome ==
           bodylifecycle.BodyIrFunctionOutcomeFragmentFrozen ||
       receipt.outcome ==
           bodylifecycle.BodyIrFunctionOutcomeCacheReuse:
        expectedOwnerTransferCount = int64(1)
    if (!sourceIdentityExact && !entryBridgeIdentityExact) ||
       receipt.allocated != int64(1) ||
       receipt.released != int64(1) ||
       receipt.live != int64(0) ||
       receipt.allocatedBytes != receipt.releasedBytes ||
       receipt.liveBytes != int64(0) ||
       receipt.retained != receipt.borrowReturnCount ||
       receipt.retained < int64(0) ||
       receipt.retained > int64(3) ||
       (receipt.outcome ==
            bodylifecycle.BodyIrFunctionOutcomeEmitSuccess &&
        receipt.retained != int64(3)) ||
       (receipt.outcome !=
            bodylifecycle.BodyIrFunctionOutcomeEmitSuccess &&
        receipt.outcome !=
            bodylifecycle.BodyIrFunctionOutcomeEmitFailure &&
        receipt.retained != int64(0)) ||
       receipt.ownerTransferCount != expectedOwnerTransferCount ||
       receipt.bodyPhysicalFreeCount !=
           int64(receipt.physicalBufferCount) ||
       !receipt.payloadReleased ||
       !receipt.ledgerStorageReleased ||
       receipt.ledgerStorageReleasedSequenceCount != 6 ||
       !receipt.phaseArenaStorageReleased ||
       receipt.phaseArenaReleasedBufferCount <= 0 ||
       receipt.phaseArenaReleasedBytes <= int64(0):
        panic("primary body ir lifecycle: unbalanced terminal receipt")
    state.bodyIrLifecycleFunctionCount =
        state.bodyIrLifecycleFunctionCount + 1
    state.bodyIrLifecycleAllocated =
        state.bodyIrLifecycleAllocated + receipt.allocated
    state.bodyIrLifecycleReleased =
        state.bodyIrLifecycleReleased + receipt.released
    state.bodyIrLifecycleLive =
        state.bodyIrLifecycleLive + receipt.live
    state.bodyIrLifecycleAllocatedBytes =
        state.bodyIrLifecycleAllocatedBytes + receipt.allocatedBytes
    state.bodyIrLifecycleReleasedBytes =
        state.bodyIrLifecycleReleasedBytes + receipt.releasedBytes
    state.bodyIrLifecycleLiveBytes =
        state.bodyIrLifecycleLiveBytes + receipt.liveBytes
    state.bodyIrLifecycleOwnerTransferCount =
        state.bodyIrLifecycleOwnerTransferCount +
            receipt.ownerTransferCount
    state.bodyIrLifecyclePhysicalBufferCount =
        state.bodyIrLifecyclePhysicalBufferCount +
            int64(receipt.physicalBufferCount)
    state.bodyIrLifecyclePhysicalFreeCount =
        state.bodyIrLifecyclePhysicalFreeCount +
            receipt.bodyPhysicalFreeCount
    state.bodyIrLifecycleLedgerStorageReleasedSequenceCount =
        state.bodyIrLifecycleLedgerStorageReleasedSequenceCount +
            int64(receipt.ledgerStorageReleasedSequenceCount)
    state.bodyIrLifecycleLedgerStorageReleasedBufferCount =
        state.bodyIrLifecycleLedgerStorageReleasedBufferCount +
            int64(receipt.ledgerStorageReleasedBufferCount)
    state.bodyIrLifecycleLedgerStorageReleasedBytes =
        state.bodyIrLifecycleLedgerStorageReleasedBytes +
            receipt.ledgerStorageReleasedBytes
    state.bodyIrLifecycleAllClosed =
        state.bodyIrLifecycleAllClosed &&
        receipt.payloadReleased &&
        receipt.ledgerStorageReleased &&
        receipt.ledgerStorageReleasedSequenceCount == 6 &&
        receipt.phaseArenaStorageReleased

fn PrimaryObjectPlanReleaseLoweredBodyIr(
        state: var PrimaryObjectPlanPhaseState,
        bodyIR: var coreir.BodyIR,
        functionIrIndex: int32,
        outcome: int32) =
    if !bodylifecycle.BodyIrPayloadHasPhysicalStorage(bodyIR):
        bodyIR = coreir.BodyIRNew()
        return
    if functionIrIndex < 0:
        panic("primary body ir lifecycle: exact function identity missing")
    var lifecycle: bodylifecycle.BodyIrFunctionLifecycle
    var receipt: bodylifecycle.BodyIrFunctionLifecycleReceipt
    bodylifecycle.BodyIrFunctionLifecycleBegin(
        lifecycle, bodyIR, functionIrIndex)
    bodylifecycle.BodyIrFunctionLifecycleRelease(
        lifecycle, bodyIR, outcome, receipt)
    PrimaryObjectPlanRecordBodyIrLifecycleReceipt(state, receipt)

fn PrimaryObjectPlanReleaseStreamedBodyIr(
        state: var PrimaryObjectPlanPhaseState,
        bodyIR: var coreir.BodyIR,
        sourceFunctionIndex: int32,
        lifecycle: var bodylifecycle.BodyIrFunctionLifecycle,
        lifecycleBegun: bool,
        lifecycleOutcome: int32) =
    let payloadCount = PrimaryBodyIrPayloadItemCount(bodyIR)
    if payloadCount > 0:
        state.fillCheckReleasedBodyIrFunctionCount = state.fillCheckReleasedBodyIrFunctionCount + 1
        state.fillCheckReleasedBodyIrPayloadItemCount = state.fillCheckReleasedBodyIrPayloadItemCount + payloadCount
    if lifecycleBegun:
        var receipt: bodylifecycle.BodyIrFunctionLifecycleReceipt
        bodylifecycle.BodyIrFunctionLifecycleRelease(
            lifecycle, bodyIR, lifecycleOutcome, receipt)
        PrimaryObjectPlanRecordBodyIrLifecycleReceipt(state, receipt)
    elif bodylifecycle.BodyIrPayloadHasPhysicalStorage(bodyIR):
        panic(
            "primary body ir lifecycle: physical payload has no exact ledger")
    else:
        bodyIR = coreir.BodyIRNew()
    if sourceFunctionIndex >= 0 && sourceFunctionIndex < state.tempBodyIRs.len:
        assert(PrimaryBodyIrPayloadItemCount(state.tempBodyIRs[sourceFunctionIndex]) == 0,
               " primary stream cleanup: source body ownership duplicated")
        state.tempBodyIRs[sourceFunctionIndex] = coreir.BodyIRNew()

fn PrimaryObjectPlanReleaseEntryBridgeBodyIr(
        state: var PrimaryObjectPlanPhaseState,
        bodyIR: var coreir.BodyIR,
        lifecycle: var bodylifecycle.BodyIrFunctionLifecycle,
        lifecycleOutcome: int32) =
    let payloadCount = PrimaryBodyIrPayloadItemCount(bodyIR)
    if payloadCount > 0:
        state.fillCheckReleasedBodyIrFunctionCount =
            state.fillCheckReleasedBodyIrFunctionCount + 1
        state.fillCheckReleasedBodyIrPayloadItemCount =
            state.fillCheckReleasedBodyIrPayloadItemCount + payloadCount
    var receipt: bodylifecycle.BodyIrFunctionLifecycleReceipt
    bodylifecycle.BodyIrFunctionLifecycleRelease(
        lifecycle, bodyIR, lifecycleOutcome, receipt)
    PrimaryObjectPlanRecordBodyIrLifecycleReceipt(state, receipt)

fn PrimaryObjectPlanAbortStreamEmit(state: var PrimaryObjectPlanPhaseState,
                                     plan: var PrimaryObjectPlan,
                                     bodyIR: var coreir.BodyIR,
                                     sourceFunctionIndex: int32,
                                     functionIndex: int32,
                                     snapshot: PrimaryObjectStreamEmitSnapshot,
                                     lifecycle: var bodylifecycle.BodyIrFunctionLifecycle,
                                     lifecycleBegun: bool): bool =
    assert(snapshot.instructionWordCount >= 0 &&
           snapshot.instructionWordCount <= plan.instructionWords.len,
           " primary stream cleanup: instruction snapshot")
    assert(snapshot.relocCount >= 0 &&
           snapshot.relocCount <= state.relocSourceItemIds.len &&
           snapshot.relocCount <= state.relocWordOffsets.len &&
           snapshot.relocCount <= state.relocTargetSymbols.len &&
           snapshot.relocCount <= state.relocTargetDomainKinds.len &&
           snapshot.relocCount <= state.relocTargetRows.len &&
           snapshot.relocCount <= state.relocTargetInterfaceCids.len &&
           snapshot.relocCount <= state.relocCallOrdinal.len,
           " primary stream cleanup: call reloc snapshot")
    assert(snapshot.dataRelocCount >= 0 &&
           snapshot.dataRelocCount <= state.dataRelocSourceItemIds.len &&
           snapshot.dataRelocCount <= state.dataRelocWordOffsets.len &&
           snapshot.dataRelocCount <= state.dataRelocPredictedKey.len &&
           snapshot.dataRelocCount <= state.dataRelocOpIndex.len &&
           snapshot.dataRelocCount <= state.dataRelocSubIndex.len &&
           snapshot.dataRelocCount <= state.dataRelocTargetSymbols.len,
           " primary stream cleanup: data reloc snapshot")
    setLen(plan.instructionWords, snapshot.instructionWordCount)
    setLen(state.relocSourceItemIds, snapshot.relocCount)
    setLen(state.relocWordOffsets, snapshot.relocCount)
    setLen(state.relocTargetSymbols, snapshot.relocCount)
    setLen(state.relocTargetDomainKinds, snapshot.relocCount)
    setLen(state.relocTargetRows, snapshot.relocCount)
    setLen(state.relocTargetInterfaceCids, snapshot.relocCount)
    setLen(state.relocCallOrdinal, snapshot.relocCount)
    setLen(state.dataRelocSourceItemIds, snapshot.dataRelocCount)
    setLen(state.dataRelocWordOffsets, snapshot.dataRelocCount)
    setLen(state.dataRelocPredictedKey, snapshot.dataRelocCount)
    setLen(state.dataRelocOpIndex, snapshot.dataRelocCount)
    setLen(state.dataRelocSubIndex, snapshot.dataRelocCount)
    setLen(state.dataRelocTargetSymbols, snapshot.dataRelocCount)
    setLen(plan.regallocFrozenSnapshotSinglePayloads,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocEmissionLedgerSinglePayloads,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionSymbols,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionIrIndexes,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionKinds,
           snapshot.regallocEvidenceCount)
    PrimaryObjectPlanRegallocFunctionIndexRebuild(plan)
    setLen(plan.regallocFunctionBodyIrSha256s,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionSymbolByteStarts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionSymbolByteLengths,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionSymbolBytesSha256s,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionPlanSha256s,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionActionSemanticRootSha256s,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionActionLedgerRootSha256s,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionMachineFragmentRootSha256s,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionAbiIngressRootSha256s,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionDeferReceiptStarts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionDeferReceiptCounts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocDeferFunctionRows,
           snapshot.regallocDeferReceiptCount)
    setLen(plan.regallocDeferStatementRows,
           snapshot.regallocDeferReceiptCount)
    setLen(plan.regallocDeferActionCids,
           snapshot.regallocDeferReceiptCount)
    setLen(plan.regallocDeferFragmentCids,
           snapshot.regallocDeferReceiptCount)
    setLen(plan.regallocFunctionDebugProvenanceBound,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionDebugFunctionIds,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionDebugProvenanceSha256s,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionDebugMachineFragmentRootSha256s,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionDebugFragmentStarts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionDebugFragmentCounts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionActionCounts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionExactCalleeMasks,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionRegisterAssignmentCounts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionSpillActionCounts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionReloadActionCounts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionCallClobberActionCounts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionEdgeParallelCopyActionCounts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionParallelCopyCycleBreakActionCounts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionCriticalEdgeActionCounts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionSretExclusionCounts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionAddressEscapeMemoryActionCounts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocFunctionOutgoingStackArgActionCounts,
           snapshot.regallocEvidenceCount)
    setLen(plan.regallocDebugFragmentFunctionIndexes,
           snapshot.regallocDebugFragmentCount)
    setLen(plan.regallocDebugFragmentOpIds,
           snapshot.regallocDebugFragmentCount)
    setLen(plan.regallocDebugFragmentSyntheticKinds,
           snapshot.regallocDebugFragmentCount)
    setLen(plan.regallocDebugFragmentSiteKinds,
           snapshot.regallocDebugFragmentCount)
    setLen(plan.regallocDebugFragmentSiteIndexes,
           snapshot.regallocDebugFragmentCount)
    setLen(plan.regallocDebugFragmentMachineOwnerKinds,
           snapshot.regallocDebugFragmentCount)
    setLen(plan.regallocDebugFragmentMachineOwnerOrdinals,
           snapshot.regallocDebugFragmentCount)
    setLen(plan.regallocDebugFragmentActionConsumerOrdinals,
           snapshot.regallocDebugFragmentCount)
    setLen(plan.regallocDebugFragmentTextByteStarts,
           snapshot.regallocDebugFragmentCount)
    setLen(plan.regallocDebugFragmentByteLengths,
           snapshot.regallocDebugFragmentCount)
    setLen(plan.regallocDebugFragmentBytesSha256s,
           snapshot.regallocDebugFragmentCount)
    plan.bodyIRDodSoAFunctionCount = snapshot.bodyIRDodSoAFunctionCount
    plan.bodyIRDodSoAOpCount = snapshot.bodyIRDodSoAOpCount
    plan.bodyIRDodSoATermCount = snapshot.bodyIRDodSoATermCount
    plan.bodyIRDodSoAOpOperandCount = snapshot.bodyIRDodSoAOpOperandCount
    plan.bodyIRDodSoATermOperandCount = snapshot.bodyIRDodSoATermOperandCount
    state.totalWordCount = snapshot.totalWordCount
    if snapshot.functionLayoutValid &&
       functionIndex >= 0 &&
       functionIndex < state.functionWordOffsets.len &&
       functionIndex < state.functionWordCounts.len:
        state.functionWordOffsets[functionIndex] = snapshot.functionWordOffset
        state.functionWordCounts[functionIndex] = snapshot.functionWordCount
    assert(snapshot.backpatchCallRelocCount >= 0 &&
           snapshot.backpatchCallRelocCount <= primaryBackpatchCallRelocFnBase.len &&
           snapshot.backpatchCallRelocCount <= primaryBackpatchCallRelocOrdinal.len &&
           snapshot.backpatchCallRelocCount <= primaryBackpatchCallRelocRealPos.len,
           " primary stream cleanup: backpatch call snapshot")
    assert(snapshot.backpatchDataRelocCount >= 0 &&
           snapshot.backpatchDataRelocCount <= primaryBackpatchDataRelocFnBase.len &&
           snapshot.backpatchDataRelocCount <= primaryBackpatchDataRelocOpIndex.len &&
           snapshot.backpatchDataRelocCount <= primaryBackpatchDataRelocSubIndex.len &&
           snapshot.backpatchDataRelocCount <= primaryBackpatchDataRelocRealPos.len,
           " primary stream cleanup: backpatch data snapshot")
    primaryBackpatchFunctionBase = snapshot.backpatchFunctionBase
    setLen(primaryBackpatchCallRelocFnBase, snapshot.backpatchCallRelocCount)
    setLen(primaryBackpatchCallRelocOrdinal, snapshot.backpatchCallRelocCount)
    setLen(primaryBackpatchCallRelocRealPos, snapshot.backpatchCallRelocCount)
    setLen(primaryBackpatchDataRelocFnBase, snapshot.backpatchDataRelocCount)
    setLen(primaryBackpatchDataRelocOpIndex, snapshot.backpatchDataRelocCount)
    setLen(primaryBackpatchDataRelocSubIndex, snapshot.backpatchDataRelocCount)
    setLen(primaryBackpatchDataRelocRealPos, snapshot.backpatchDataRelocCount)
    setLen(primaryBackpatchRealBlockStart, 0)
    setLen(primaryBackpatchFixupWordPos, 0)
    setLen(primaryBackpatchFixupTargetBlock, 0)
    setLen(primaryBackpatchFixupIsCond, 0)
    setLen(primaryBackpatchFixupCondCode, 0)
    PrimaryObjectPlanReleaseStreamedBodyIr(
        state, bodyIR, sourceFunctionIndex,
        lifecycle, lifecycleBegun,
        bodylifecycle.BodyIrFunctionOutcomeEmitFailure)
    PrimaryObjectPlanMarkDeclOrderStreamBuildAbort(state,
                                                    functionIndex,
                                                    "",
                                                    state.error.functionSourcePath,
                                                    state.streamedBackpatchFailureKind)
    return false

fn PrimaryObjectPlanResolveStreamedRelocsForFunction(state: var PrimaryObjectPlanPhaseState,
                                                      functionIndex: int32,
                                                      relocStart: int32,
                                                      dataRelocStart: int32): bool =
    if functionIndex < 0 ||
       functionIndex >= state.itemIds.len ||
       functionIndex >= state.functionWordOffsets.len:
        PrimaryObjectPlanRecordStreamedBackpatchFailure(state,
                                                         functionIndex,
                                                         "stream_function_layout_missing",
                                                         -1,
                                                         -1,
                                                         -1)
        return false
    let itemId = state.itemIds[functionIndex]
    let functionBase = state.functionWordOffsets[functionIndex]
    for ri in relocStart..<state.relocWordOffsets.len:
        if ri >= state.relocSourceItemIds.len ||
           ri >= state.relocTargetSymbols.len ||
           ri >= state.relocTargetDomainKinds.len ||
           ri >= state.relocTargetRows.len ||
           ri >= state.relocTargetInterfaceCids.len ||
           ri >= state.relocCallOrdinal.len ||
           state.relocSourceItemIds[ri] != itemId:
            PrimaryObjectPlanRecordStreamedBackpatchFailure(state,
                                                             functionIndex,
                                                             "call_reloc_structure_mismatch",
                                                             -1,
                                                             -1,
                                                             -1)
            return false
        let callOrdinal = state.relocCallOrdinal[ri]
        if callOrdinal < 0:
            continue
        let realPos = PrimaryBackpatchCallBlRealFor(functionBase, callOrdinal)
        if realPos < 0:
            PrimaryObjectPlanRecordStreamedBackpatchFailure(state,
                                                             functionIndex,
                                                             "call_bl_reloc_no_fill_record",
                                                             callOrdinal,
                                                             -1,
                                                             -1)
            return false
        state.relocWordOffsets[ri] = realPos
    for ri in dataRelocStart..<state.dataRelocWordOffsets.len:
        if ri >= state.dataRelocSourceItemIds.len ||
           ri >= state.dataRelocTargetSymbols.len ||
           ri >= state.dataRelocOpIndex.len ||
           ri >= state.dataRelocSubIndex.len ||
           state.dataRelocSourceItemIds[ri] != itemId:
            PrimaryObjectPlanRecordStreamedBackpatchFailure(state,
                                                             functionIndex,
                                                             "data_reloc_structure_mismatch",
                                                             -1,
                                                             -1,
                                                             -1)
            return false
        let opIndex = state.dataRelocOpIndex[ri]
        let subIndex = state.dataRelocSubIndex[ri]
        if opIndex < 0 || subIndex < 0:
            PrimaryObjectPlanRecordStreamedBackpatchFailure(state,
                                                             functionIndex,
                                                             "data_reloc_structure_mismatch",
                                                             -1,
                                                             opIndex,
                                                             subIndex)
            return false
        let realPos = PrimaryBackpatchDataRelocRealFor(functionBase,
                                                       opIndex,
                                                       subIndex)
        if realPos < 0:
            # [wall131] 判词富化 (fail-closed 显性化, 仅死点路径): RealFor
            # 二分的前提是 fill record 按 (fnBase,opIndex,subIndex) 字典序
            # append (发射流序=opIndex 单调)。嵌套 fmt/桥形态下发射序≠op
            # 存储序 (:73988 callSequence 序自证先例), 此处把命中失败的
            # 结构键与 record 数组排序实况一次入 stderr, 定位是乱序 miss
            # 还是键域漂移, 修法定性前不放宽任何消费谓词。
            var dumpTail = ""
            var dumpStart = primaryBackpatchDataRelocFnBase.len - 4
            if dumpStart < 0:
                dumpStart = 0
            var dumpRow = dumpStart
            while dumpRow < primaryBackpatchDataRelocFnBase.len:
                let dumpFb = primaryBackpatchDataRelocFnBase[dumpRow]
                let dumpOi = primaryBackpatchDataRelocOpIndex[dumpRow]
                let dumpSi = primaryBackpatchDataRelocSubIndex[dumpRow]
                dumpTail = Fmt"{dumpTail}|r{dumpRow}:fb={dumpFb}:oi={dumpOi}:si={dumpSi}"
                dumpRow = dumpRow + 1
            var sortedValid = true
            var sortedRow = 1
            while sortedRow < primaryBackpatchDataRelocFnBase.len:
                let prevFb = primaryBackpatchDataRelocFnBase[sortedRow - 1]
                let curFb = primaryBackpatchDataRelocFnBase[sortedRow]
                let prevOi = primaryBackpatchDataRelocOpIndex[sortedRow - 1]
                let curOi = primaryBackpatchDataRelocOpIndex[sortedRow]
                let prevSi = primaryBackpatchDataRelocSubIndex[sortedRow - 1]
                let curSi = primaryBackpatchDataRelocSubIndex[sortedRow]
                if curFb < prevFb ||
                   (curFb == prevFb && curOi < prevOi) ||
                   (curFb == prevFb && curOi == prevOi && curSi < prevSi):
                    sortedValid = false
                    sortedRow = primaryBackpatchDataRelocFnBase.len
                    break
                sortedRow = sortedRow + 1
            os.WriteLine(os.GetStderr(),
                         Fmt"phase=data_reloc_no_fill_record_detail function={state.symbolNames[functionIndex]} item_id={itemId} fn_base={functionBase} op_index={opIndex} sub_index={subIndex} fill_records={primaryBackpatchDataRelocFnBase.len} fill_sorted={sortedValid} data_reloc_rows={state.dataRelocWordOffsets.len} row={ri} tail={dumpTail}")
            PrimaryObjectPlanRecordStreamedBackpatchFailure(state,
                                                             functionIndex,
                                                             "data_reloc_no_fill_record",
                                                             -1,
                                                             opIndex,
                                                             subIndex)
            return false
        state.dataRelocWordOffsets[ri] = realPos
    return true

@borrows
fn PrimaryObjectPlanCloneStrRow(items: str[], index: int32): str =
    if index < 0 || index >= items.len:
        return ""
    return strings.CloneStr(items[index])

fn PrimaryObjectPlanRegallocResolvedCallTargets(
        state: var PrimaryObjectPlanPhaseState,
        functionIndex: int32,
        bodyIR: var coreir.BodyIR,
        relocStart: int32,
        resolved: var str[]): bool =
    setLen(resolved, 0)
    for _ in 0..<bodyIR.callSequence.len:
        add(resolved, "")
    if functionIndex < 0 || functionIndex >= state.itemIds.len ||
       relocStart < 0 || relocStart > state.relocWordOffsets.len ||
       state.relocTargetSymbols.len != state.relocWordOffsets.len ||
       state.relocTargetDomainKinds.len != state.relocWordOffsets.len ||
       state.relocTargetRows.len != state.relocWordOffsets.len ||
       state.relocTargetInterfaceCids.len !=
           state.relocWordOffsets.len ||
       state.relocCallOrdinal.len != state.relocWordOffsets.len:
        os.WriteLine(os.GetStderr(),
                     Fmt"phase=regalloc_call_reloc_structure_mismatch_shape function_index={functionIndex} reloc_start={relocStart} reloc_len={state.relocWordOffsets.len} src_len={state.relocSourceItemIds.len} sym_len={state.relocTargetSymbols.len} domain_len={state.relocTargetDomainKinds.len} row_len={state.relocTargetRows.len} cid_len={state.relocTargetInterfaceCids.len} ordinal_len={state.relocCallOrdinal.len} items={state.itemIds.len}")
        PrimaryObjectPlanRecordStreamedBackpatchFailure(
            state, functionIndex, "regalloc_call_reloc_structure_mismatch",
            -1, -1, -1)
        return false
    let itemId = state.itemIds[functionIndex]
    for relocIndex in relocStart..<state.relocWordOffsets.len:
        if relocIndex >= state.relocSourceItemIds.len ||
           relocIndex >= state.relocTargetSymbols.len ||
           relocIndex >= state.relocTargetDomainKinds.len ||
           relocIndex >= state.relocTargetRows.len ||
           relocIndex >= state.relocTargetInterfaceCids.len ||
           relocIndex >= state.relocCallOrdinal.len ||
           state.relocSourceItemIds[relocIndex] != itemId:
            os.WriteLine(os.GetStderr(),
                         Fmt"phase=regalloc_call_reloc_structure_mismatch_item function_index={functionIndex} reloc_index={relocIndex} item_id={itemId} reloc_start={relocStart} src_len={state.relocSourceItemIds.len}")
            PrimaryObjectPlanRecordStreamedBackpatchFailure(
                state, functionIndex,
                "regalloc_call_reloc_structure_mismatch", -1, -1, -1)
            return false
        let callOrdinal = state.relocCallOrdinal[relocIndex]
        if callOrdinal < 0 || callOrdinal >= resolved.len ||
           len(state.relocTargetSymbols[relocIndex]) <= 0 ||
           len(resolved[callOrdinal]) > 0:
            os.WriteLine(os.GetStderr(),
                         Fmt"phase=regalloc_call_reloc_structure_mismatch function_index={functionIndex} reloc_index={relocIndex} call_ordinal={callOrdinal} resolved_len={resolved.len} target_len={len(state.relocTargetSymbols[relocIndex])} body_calls={bodyIR.callSequence.len} reloc_rows={state.relocWordOffsets.len} reloc_start={relocStart}")
            PrimaryObjectPlanRecordStreamedBackpatchFailure(
                state, functionIndex,
                "regalloc_call_reloc_structure_mismatch",
                callOrdinal, -1, -1)
            return false
        resolved[callOrdinal] = PrimaryObjectPlanCloneStrRow(
            share(state.relocTargetSymbols), relocIndex)
    if bodyIR.callTargetDomainKinds.len != bodyIR.callSequence.len ||
       bodyIR.callTargetRows.len != bodyIR.callSequence.len ||
       bodyIR.callTargetInterfaceCids.len != bodyIR.callSequence.len:
        PrimaryObjectPlanRecordStreamedBackpatchFailure(
            state, functionIndex,
            "regalloc_call_target_identity_shape_mismatch",
            -1, -1, -1)
        return false
    for callOrdinal in 0..<bodyIR.callSequence.len:
        let domain = bodyIR.callTargetDomainKinds[callOrdinal]
        let targetRow = bodyIR.callTargetRows[callOrdinal]
        if !coreir.BodyIRCallTargetIdentityValid(domain, targetRow) ||
           !coreir.BodyIRTypeArenaArtifactCidValid(
               bodyIR.callTargetInterfaceCids[callOrdinal]):
            PrimaryObjectPlanRecordStreamedBackpatchFailure(
                state, functionIndex,
                "regalloc_call_target_identity_invalid",
                callOrdinal, -1, -1)
            return false
        if domain == coreir.BodyCallTargetDomainFunctionTag:
            if targetRow < 0 ||
               targetRow >=
                   state.allSymbolFunctionRowsByTypedFunctionIndex.len:
                PrimaryObjectPlanRecordStreamedBackpatchFailure(
                    state, functionIndex,
                    "regalloc_call_target_row_out_of_range",
                    callOrdinal, -1, -1)
                return false
            let symbolRow =
                state.allSymbolFunctionRowsByTypedFunctionIndex[
                    targetRow]
            if symbolRow < 0 ||
               symbolRow >= state.allSymbolNames.len ||
               len(resolved[callOrdinal]) <= 0 ||
               resolved[callOrdinal] !=
                   state.allSymbolNames[symbolRow]:
                PrimaryObjectPlanRecordStreamedBackpatchFailure(
                    state, functionIndex,
                    "regalloc_call_target_projection_mismatch",
                    callOrdinal, -1, -1)
                return false
        elif len(resolved[callOrdinal]) <= 0 &&
             !PrimaryBodyIrIndirectCallIntrinsic(
                 bodyIR.callSequence[callOrdinal].targetSymbol):
            PrimaryObjectPlanRecordStreamedBackpatchFailure(
                state, functionIndex,
                "regalloc_call_target_spelling_missing",
                callOrdinal, -1, -1)
            return false
    return true

@borrows
fn PrimaryObjectPlanRegallocResolvedDataTargets(
        bodyIR: var coreir.BodyIR,
        targetTriple: str,
        allSymbolNames: var str[],
        resolved: var str[]): bool =
    setLen(resolved, 0)
    for slotIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[slotIndex]
        var targetSymbol = ""
        if slot.placeKind == coreir.BodyPlaceGlobalAddressTag:
            if len(slot.name) <= 0:
                return false
            let functionIndex =
                PrimaryBodyIrFunctionAddressSlotIndex(slot.name)
            if functionIndex >= 0:
                if functionIndex >= allSymbolNames.len ||
                   len(allSymbolNames[functionIndex]) <= 0:
                    return false
                targetSymbol =
                    strings.CloneStr(allSymbolNames[functionIndex])
            else:
                targetSymbol = PrimaryGlobalDataLabel(
                    targetTriple, slot.name)
            if len(targetSymbol) <= 0:
                return false
        add(resolved, targetSymbol)
    return resolved.len == bodyIR.localSlots.len

fn PrimaryObjectPlanRegallocFunctionIndexInit(
        plan: var PrimaryObjectPlan,
        expectedFunctionCount: int32) =
    plan.regallocFunctionIndex =
        regart.RegallocProductionFunctionIndexInit(
            expectedFunctionCount)

fn PrimaryObjectPlanRegallocFunctionIndexRebuild(
        plan: var PrimaryObjectPlan) =
    if plan.regallocFunctionIrIndexes.len !=
           plan.regallocFunctionSymbols.len ||
       plan.regallocFunctionKinds.len !=
           plan.regallocFunctionSymbols.len:
        panic("primary regalloc function index rebuild shape mismatch")
    PrimaryObjectPlanRegallocFunctionIndexInit(
        plan, plan.regallocFunctionSymbols.len)
    for functionIndex in 0..<plan.regallocFunctionSymbols.len:
        if regart.RegallocProductionFunctionIndexAppend(
               plan.regallocFunctionIndex,
               plan.regallocFunctionIrIndexes[functionIndex],
               plan.regallocFunctionKinds[functionIndex],
               plan.regallocFunctionSymbols[functionIndex]) !=
               regart.RegallocProductionFunctionIndexAppendOk:
            panic("primary regalloc function index rebuild duplicate")

fn PrimaryObjectPlanRegallocFunctionIdentityCanAppend(
        plan: var PrimaryObjectPlan,
        functionIrIndex: int32,
        functionKind: int32,
        symbol: str): bool =
    if !regart.RegallocProductionFunctionIdentityValid(
           functionIrIndex, functionKind) ||
       len(symbol) <= 0 ||
       plan.regallocFunctionIrIndexes.len !=
           plan.regallocFunctionSymbols.len ||
       plan.regallocFunctionKinds.len != plan.regallocFunctionSymbols.len:
        return false
    return regart.RegallocProductionFunctionIndexCheck(
               plan.regallocFunctionIndex,
               functionIrIndex,
               functionKind,
               symbol) ==
           regart.RegallocProductionFunctionIndexAppendOk

fn PrimaryObjectPlanRecordRegallocProductionEvidence(
        plan: var PrimaryObjectPlan,
        bodyIR: var coreir.BodyIR,
        emission: var regprod.RegallocProductionFunctionEmission,
        functionIrIndex: int32,
        functionKind: int32): bool =
    let bodyIrSha256 = emission.bodyIrSha256
    if !regart.RegallocProductionTargetUsesCanonicalRegalloc(
           emission.targetTriple):
        os.WriteLine(os.GetStderr(),
                     Fmt"phase=regalloc_production_evidence_failed reason=target triple={emission.targetTriple}")
        return false
    if !PrimaryObjectPlanRegallocFunctionIdentityCanAppend(
           plan, functionIrIndex, functionKind,
           strings.CloneStr(emission.receipt.symbolName)):
        os.WriteLine(os.GetStderr(),
                     Fmt"phase=regalloc_production_evidence_failed reason=can_append ir={functionIrIndex} kind={functionKind} symlen={len(emission.receipt.symbolName)} idx_len={plan.regallocFunctionSymbols.len}")
        return false
    if os.GetEnv("CHENG_POBJ_EVIDENCE_DEBUG") != "":
        let c1 = strutil.Contains(
            emission.frozenSnapshotPayload,
            "phase=allocator_and_machine_recipe_freeze_before_fill\n")
        let c2 = strutil.Contains(
            emission.frozenSnapshotPayload, "function_count=1\n")
        let c3 = strutil.Contains(
            emission.frozenSnapshotPayload,
            strutil.Join([
                "function.0.symbol=", strings.CloneStr(emission.receipt.symbolName), "\n"
            ], ""))
        let c4 = strutil.Contains(
            emission.frozenSnapshotPayload,
            strutil.Join([
                "function.0.body_ir_sha256=", strings.CloneStr(bodyIrSha256), "\n"
            ], ""))
        let c5 = strutil.Contains(
            emission.frozenSnapshotPayload, "function.0.finalized=0\n")
        let c6 = strutil.Contains(
            emission.frozenSnapshotPayload,
            "function.0.emission_symbol_bound=0\n")
        let c7 = strutil.Contains(
            emission.frozenSnapshotPayload,
            strutil.Join([
                "snapshot_payload_sha256=",
                strings.CloneStr(emission.frozenSnapshotPayloadSha256), "\n"
            ], ""))
        os.WriteLine(
            os.GetStderr(),
            Fmt"pobj_evidence_dbg sha_len={len(bodyIrSha256)} valid={emission.valid} receipt={emission.receipt.valid} ingress={bodyIrSha256 == emission.plan.bodyIrIngressSha256} frozen={len(emission.frozenSnapshotPayload)} frozensha={len(emission.frozenSnapshotPayloadSha256)} c1={c1} c2={c2} c3={c3} c4={c4} c5={c5} c6={c6} c7={c7} origin={emission.recipeOrigin} want={regart.RegallocProductionRecipeOriginBodyIrAdapter} actions={emission.plan.actions.len} receipt_actions={emission.receipt.actionCount}")
    if len(bodyIrSha256) != 64 ||
       !regprod.RegallocProductionEmissionPublishedPayloadExact(
           emission) ||
       !emission.receipt.valid ||
       bodyIrSha256 != emission.plan.bodyIrIngressSha256 ||
       len(emission.frozenSnapshotPayload) <= 0 ||
       len(emission.frozenSnapshotPayloadSha256) != 64 ||
       !strutil.Contains(
           emission.frozenSnapshotPayload,
           "phase=allocator_and_machine_recipe_freeze_before_fill\n") ||
       !strutil.Contains(
           emission.frozenSnapshotPayload,
           strutil.Join([
               "target=", strings.CloneStr(emission.targetTriple), "\n"
           ], "")) ||
       !strutil.Contains(
           emission.frozenSnapshotPayload, "function_count=1\n") ||
       !strutil.Contains(
           emission.frozenSnapshotPayload,
           strutil.Join([
               "function.0.symbol=", strings.CloneStr(emission.receipt.symbolName), "\n"
           ], "")) ||
       !strutil.Contains(
           emission.frozenSnapshotPayload,
           strutil.Join([
               "function.0.function_ir_index=",
               strings.IntToStr(functionIrIndex), "\n"
           ], "")) ||
       !strutil.Contains(
           emission.frozenSnapshotPayload,
           strutil.Join([
               "function.0.function_kind=",
               strings.IntToStr(functionKind), "\n"
           ], "")) ||
       !strutil.Contains(
           emission.frozenSnapshotPayload,
           strutil.Join([
               "function.0.body_ir_sha256=", strings.CloneStr(bodyIrSha256), "\n"
           ], "")) ||
       !strutil.Contains(
           emission.frozenSnapshotPayload,
           "function.0.finalized=0\n") ||
       !strutil.Contains(
           emission.frozenSnapshotPayload,
           "function.0.emission_symbol_bound=0\n") ||
       !strutil.Contains(
           emission.frozenSnapshotPayload,
           strutil.Join([
               "snapshot_payload_sha256=",
               strings.CloneStr(emission.frozenSnapshotPayloadSha256), "\n"
           ], "")) ||
       emission.recipeOrigin !=
           regart.RegallocProductionRecipeOriginBodyIrAdapter:
        os.WriteLine(os.GetStderr(),
                     Fmt"phase=regalloc_production_evidence_failed reason=snapshot sha_len={len(bodyIrSha256)} published={regprod.RegallocProductionEmissionPublishedPayloadExact(emission)} receipt={emission.receipt.valid} frozen={len(emission.frozenSnapshotPayload)} frozensha={len(emission.frozenSnapshotPayloadSha256)} origin={emission.recipeOrigin}")
        return false
    let debugFragmentCount = emission.debugFragmentOpIds.len
    if emission.debugProvenanceBound:
        if !coreir.BodyIRDebugProvenanceShapeValid(bodyIR) ||
           bodyIR.debugFunctionId != emission.debugFunctionId ||
           debugFragmentCount <= 0 ||
           debugFragmentCount != emission.recipes.machineFragments.len ||
           emission.debugFragmentSyntheticKinds.len !=
               debugFragmentCount ||
           emission.debugFragmentSiteKinds.len != debugFragmentCount ||
           emission.debugFragmentSiteIndexes.len != debugFragmentCount ||
           emission.debugFragmentMachineOwnerKinds.len !=
               debugFragmentCount ||
           emission.debugFragmentMachineOwnerOrdinals.len !=
               debugFragmentCount ||
           emission.debugFragmentActionConsumerOrdinals.len !=
               debugFragmentCount ||
           emission.debugFragmentTextByteStarts.len !=
               debugFragmentCount ||
           emission.debugFragmentByteLengths.len !=
               debugFragmentCount ||
           emission.debugFragmentBytesSha256s.len !=
               debugFragmentCount ||
           regprod.RegallocProductionDebugMachineFragmentRootSha256(
               emission) !=
               emission.debugMachineFragmentRootSha256:
            return false
    elif bodyIR.debugProvenanceRequired || debugFragmentCount != 0 ||
         emission.debugFunctionId != -1 ||
         len(emission.debugMachineFragmentRootSha256) != 0:
        os.WriteLine(
            os.GetStderr(),
            Fmt"phase=regalloc_production_evidence_failed reason=debug_provenance bound={emission.debugProvenanceBound} required={bodyIR.debugProvenanceRequired} frag_count={debugFragmentCount} fn_id={emission.debugFunctionId} rootsha_len={len(emission.debugMachineFragmentRootSha256)}")
        return false
    let deferReceiptCount = emission.deferActionCids.len
    if emission.deferFunctionRows.len != deferReceiptCount ||
       emission.deferStatementRows.len != deferReceiptCount ||
       emission.deferFragmentCids.len != deferReceiptCount ||
       deferReceiptCount != bodyIR.deferActionCids.len:
        return false
    for deferId in 0..<deferReceiptCount:
        if emission.deferFunctionRows[deferId] !=
               bodyIR.controlFunctionRow ||
           emission.deferFunctionRows[deferId] !=
               bodyIR.deferFunctionRows[deferId] ||
           emission.deferStatementRows[deferId] !=
               bodyIR.deferStatementRows[deferId] ||
           !layout.FixedBytes32Equal(
               emission.deferActionCids[deferId],
               bodyIR.deferActionCids[deferId]) ||
           !layout.FixedBytes32Equal(
               emission.deferActionCids[deferId],
               coreir.BodyIRControlFlowDeferActionCid(
                   bodyIR, deferId)) ||
           layout.FixedBytes32Equal(
               emission.deferFragmentCids[deferId],
               layout.FixedBytes32()):
            return false
        for priorDeferId in 0..<deferId:
            if layout.FixedBytes32Equal(
                   emission.deferActionCids[priorDeferId],
                   emission.deferActionCids[deferId]) ||
               layout.FixedBytes32Equal(
                   emission.deferFragmentCids[priorDeferId],
                   emission.deferFragmentCids[deferId]):
                return false
    var registerAssignmentCount: int32
    var spillActionCount: int32
    var reloadActionCount: int32
    var callClobberActionCount: int32
    var edgeParallelCopyActionCount: int32
    var parallelCopyCycleBreakActionCount: int32
    var criticalEdgeActionCount: int32
    var sretExclusionCount: int32
    var addressEscapeMemoryActionCount: int32
    var outgoingStackArgActionCount: int32
    if emission.plan.actions.len != emission.receipt.actionCount:
        os.WriteLine(os.GetStderr(),
                     Fmt"phase=regalloc_production_evidence_failed reason=action_count plan={emission.plan.actions.len} receipt={emission.receipt.actionCount}")
        return false
    for actionIndex in 0..<emission.plan.actions.len:
        let ledgerKind =
            regart.RegallocProductionArtifactActionLedgerKind(
                emission.plan.actions[actionIndex])
        if ledgerKind == "register_assignment":
            registerAssignmentCount = registerAssignmentCount + 1
        elif ledgerKind == "spill":
            spillActionCount = spillActionCount + 1
        elif ledgerKind == "reload":
            reloadActionCount = reloadActionCount + 1
        elif ledgerKind == "call_clobber":
            callClobberActionCount = callClobberActionCount + 1
        elif ledgerKind == "edge_parallel_copy":
            edgeParallelCopyActionCount = edgeParallelCopyActionCount + 1
        elif ledgerKind == "parallel_copy_scratch_save":
            parallelCopyCycleBreakActionCount =
                parallelCopyCycleBreakActionCount + 1
        elif ledgerKind == "critical_edge_copy":
            criticalEdgeActionCount = criticalEdgeActionCount + 1
        elif ledgerKind == "sret_exclusion":
            sretExclusionCount = sretExclusionCount + 1
        elif ledgerKind == "address_escape_home":
            addressEscapeMemoryActionCount =
                addressEscapeMemoryActionCount + 1
        elif ledgerKind == "outgoing_stack_arg_store":
            outgoingStackArgActionCount =
                outgoingStackArgActionCount + 1
        elif len(ledgerKind) <= 0:
            if os.GetEnv("CHENG_POBJ_EVIDENCE_DEBUG") != "":
                os.WriteLine(
                    os.GetStderr(),
                    Fmt"pobj_evidence_dbg3 empty_ledger_kind action_index={actionIndex}")
            return false
    var ledgerMetadata: regart.RegallocProductionLedgerMetadata
    ledgerMetadata.fixtureSourceSha256 = alloc.RegallocValueEmptySha256
    ledgerMetadata.outputObjectSha256 = alloc.RegallocValueEmptySha256
    ledgerMetadata.target = emission.targetTriple
    var firstRelocSym: int32
    if emission.recipes.functionRelocs.len > 0:
        firstRelocSym = len(emission.recipes.functionRelocs[0].targetSymbol)
    os.WriteLine(os.GetStderr(),
                 Fmt"phase=regalloc_ledger_pre actions={emission.plan.actions.len} finalized={emission.plan.finalized} sealed={emission.plan.emissionSymbolSealed} bound={emission.plan.emissionSymbolBound} recipe_bound={emission.plan.productionRecipeBound} issue={emission.plan.nextIssueOrdinal} ack={emission.plan.nextAckOrdinal} emissions={emission.plan.actionEmissions.len} valid={emission.plan.valid} frozen={emission.plan.frozen} frag={emission.recipes.machineFragments.len} receipt_frag={emission.receipt.machineFragmentCount} abi={emission.recipes.abiIngressRegs.len} receipt_abi={emission.receipt.abiIngressCount} enc={emission.recipes.encoderEvents.kinds.len} receipt_enc={emission.receipt.riscvEncoderEventCount} relocs={emission.recipes.functionRelocs.len} first_reloc_sym={firstRelocSym} words={emission.recipes.functionWords.len} receipt_valid={emission.receipt.valid}")
    var ledgerFunction: regart.RegallocProductionLedgerFunction
    ledgerFunction.plan = emission.plan
    ledgerFunction.recipes = emission.recipes
    ledgerFunction.receipt = emission.receipt
    var ledgerFunctions: regart.RegallocProductionLedgerFunction[]
    add(ledgerFunctions, ledgerFunction)
    let ledgerArtifact =
        regart.RegallocProductionActionEmissionLedgerSerialize(
            ledgerMetadata, ledgerFunctions)
    if !ledgerArtifact.valid:
        os.WriteLine(os.GetStderr(),
                     Fmt"phase=regalloc_production_evidence_failed reason=ledger_serialize actions={emission.plan.actions.len} ledger_code={ledgerArtifact.errorCode} error_detail={ledgerFunctions[0].plan.errorDetail} finalized={emission.plan.finalized} sealed={emission.plan.emissionSymbolSealed} bound={emission.plan.emissionSymbolBound} recipe_bound={emission.plan.productionRecipeBound} issue={emission.plan.nextIssueOrdinal} ack={emission.plan.nextAckOrdinal} emissions={emission.plan.actionEmissions.len}")
        return false
    if regart.RegallocProductionFunctionIndexAppend(
           plan.regallocFunctionIndex,
           functionIrIndex,
           functionKind,
           strings.CloneStr(emission.receipt.symbolName)) !=
           regart.RegallocProductionFunctionIndexAppendOk:
        os.WriteLine(os.GetStderr(),
                     Fmt"phase=regalloc_production_evidence_failed reason=index_append ir={functionIrIndex} kind={functionKind} symlen={len(emission.receipt.symbolName)}")
        return false
    add(plan.regallocFrozenSnapshotSinglePayloads,
        strings.CloneStr(emission.frozenSnapshotPayload))
    add(plan.regallocEmissionLedgerSinglePayloads,
        strings.CloneStr(ledgerArtifact.payload))
    add(plan.regallocFunctionSymbols, strings.CloneStr(emission.receipt.symbolName))
    add(plan.regallocFunctionIrIndexes, functionIrIndex)
    add(plan.regallocFunctionKinds, functionKind)
    add(plan.regallocFunctionBodyIrSha256s, strings.CloneStr(bodyIrSha256))
    add(plan.regallocFunctionSymbolByteStarts,
        emission.receipt.symbolByteStart)
    add(plan.regallocFunctionSymbolByteLengths,
        emission.receipt.symbolByteLength)
    add(plan.regallocFunctionSymbolBytesSha256s,
        strings.CloneStr(emission.receipt.symbolBytesSha256))
    add(plan.regallocFunctionPlanSha256s,
        strings.CloneStr(emission.receipt.frozenSemanticSha256))
    add(plan.regallocFunctionActionSemanticRootSha256s,
        strings.CloneStr(emission.receipt.actionSemanticRootSha256))
    add(plan.regallocFunctionActionLedgerRootSha256s,
        strings.CloneStr(emission.receipt.actionBindingRootSha256))
    add(plan.regallocFunctionMachineFragmentRootSha256s,
        strings.CloneStr(emission.receipt.machineFragmentRootSha256))
    add(plan.regallocFunctionAbiIngressRootSha256s,
        strings.CloneStr(emission.receipt.abiIngressRootSha256))
    add(plan.regallocFunctionDeferReceiptStarts,
        plan.regallocDeferActionCids.len)
    add(plan.regallocFunctionDeferReceiptCounts,
        deferReceiptCount)
    for deferId in 0..<deferReceiptCount:
        add(plan.regallocDeferFunctionRows,
            emission.deferFunctionRows[deferId])
        add(plan.regallocDeferStatementRows,
            emission.deferStatementRows[deferId])
        add(plan.regallocDeferActionCids,
            layout.FixedBytes32Copy(emission.deferActionCids[deferId]))
        add(plan.regallocDeferFragmentCids,
            layout.FixedBytes32Copy(emission.deferFragmentCids[deferId]))
    let debugFunctionIndex = plan.regallocFunctionSymbols.len - 1
    add(plan.regallocFunctionDebugProvenanceBound,
        emission.debugProvenanceBound)
    add(plan.regallocFunctionDebugFunctionIds,
        emission.debugFunctionId)
    add(plan.regallocFunctionDebugProvenanceSha256s,
        strings.CloneStr(emission.receipt.debugProvenanceSha256))
    add(plan.regallocFunctionDebugMachineFragmentRootSha256s,
        strings.CloneStr(emission.debugMachineFragmentRootSha256))
    add(plan.regallocFunctionDebugFragmentStarts,
        plan.regallocDebugFragmentOpIds.len)
    add(plan.regallocFunctionDebugFragmentCounts,
        debugFragmentCount)
    for fragmentIndex in 0..<debugFragmentCount:
        add(plan.regallocDebugFragmentFunctionIndexes,
            debugFunctionIndex)
        add(plan.regallocDebugFragmentOpIds,
            emission.debugFragmentOpIds[fragmentIndex])
        add(plan.regallocDebugFragmentSyntheticKinds,
            emission.debugFragmentSyntheticKinds[fragmentIndex])
        add(plan.regallocDebugFragmentSiteKinds,
            emission.debugFragmentSiteKinds[fragmentIndex])
        add(plan.regallocDebugFragmentSiteIndexes,
            emission.debugFragmentSiteIndexes[fragmentIndex])
        add(plan.regallocDebugFragmentMachineOwnerKinds,
            emission.debugFragmentMachineOwnerKinds[fragmentIndex])
        add(plan.regallocDebugFragmentMachineOwnerOrdinals,
            emission.debugFragmentMachineOwnerOrdinals[fragmentIndex])
        add(plan.regallocDebugFragmentActionConsumerOrdinals,
            emission.debugFragmentActionConsumerOrdinals[fragmentIndex])
        add(plan.regallocDebugFragmentTextByteStarts,
            emission.debugFragmentTextByteStarts[fragmentIndex])
        add(plan.regallocDebugFragmentByteLengths,
            emission.debugFragmentByteLengths[fragmentIndex])
        add(plan.regallocDebugFragmentBytesSha256s,
            strings.CloneStr(emission.debugFragmentBytesSha256s[fragmentIndex]))
    add(plan.regallocFunctionActionCounts,
        emission.receipt.actionCount)
    add(plan.regallocFunctionExactCalleeMasks,
        emission.plan.usedCalleeMask)
    add(plan.regallocFunctionRegisterAssignmentCounts,
        registerAssignmentCount)
    add(plan.regallocFunctionSpillActionCounts, spillActionCount)
    add(plan.regallocFunctionReloadActionCounts, reloadActionCount)
    add(plan.regallocFunctionCallClobberActionCounts,
        callClobberActionCount)
    add(plan.regallocFunctionEdgeParallelCopyActionCounts,
        edgeParallelCopyActionCount)
    add(plan.regallocFunctionParallelCopyCycleBreakActionCounts,
        parallelCopyCycleBreakActionCount)
    add(plan.regallocFunctionCriticalEdgeActionCounts,
        criticalEdgeActionCount)
    add(plan.regallocFunctionSretExclusionCounts,
        sretExclusionCount)
    add(plan.regallocFunctionAddressEscapeMemoryActionCounts,
        addressEscapeMemoryActionCount)
    add(plan.regallocFunctionOutgoingStackArgActionCounts,
        outgoingStackArgActionCount)
    return true

fn PrimaryObjectPlanRegallocProductionEvidenceExact(
        state: var PrimaryObjectPlanPhaseState,
        plan: var PrimaryObjectPlan): bool =
    let count = state.symbolNames.len
    if count <= 0 ||
       state.symbolTypedFunctionIndexes.len != count ||
       state.symbolNameIds.len != count ||
       state.symbolRoles.len != count ||
       state.symbolInterfaceCids.len != count ||
       plan.regallocFrozenSnapshotSinglePayloads.len != count ||
       plan.regallocEmissionLedgerSinglePayloads.len != count ||
       plan.regallocFunctionSymbols.len != count ||
       plan.regallocFunctionIrIndexes.len != count ||
       plan.regallocFunctionKinds.len != count ||
       plan.regallocFunctionBodyIrSha256s.len != count ||
       plan.regallocFunctionSymbolByteStarts.len != count ||
       plan.regallocFunctionSymbolByteLengths.len != count ||
       plan.regallocFunctionSymbolBytesSha256s.len != count ||
       plan.regallocFunctionPlanSha256s.len != count ||
       plan.regallocFunctionActionSemanticRootSha256s.len != count ||
       plan.regallocFunctionActionLedgerRootSha256s.len != count ||
       plan.regallocFunctionMachineFragmentRootSha256s.len != count ||
       plan.regallocFunctionAbiIngressRootSha256s.len != count ||
       plan.regallocFunctionDeferReceiptStarts.len != count ||
       plan.regallocFunctionDeferReceiptCounts.len != count ||
       plan.regallocFunctionDebugProvenanceBound.len != count ||
       plan.regallocFunctionDebugFunctionIds.len != count ||
       plan.regallocFunctionDebugProvenanceSha256s.len != count ||
       plan.regallocFunctionDebugMachineFragmentRootSha256s.len != count ||
       plan.regallocFunctionDebugFragmentStarts.len != count ||
       plan.regallocFunctionDebugFragmentCounts.len != count ||
       plan.regallocFunctionActionCounts.len != count ||
       plan.regallocFunctionExactCalleeMasks.len != count ||
       plan.regallocFunctionRegisterAssignmentCounts.len != count ||
       plan.regallocFunctionSpillActionCounts.len != count ||
       plan.regallocFunctionReloadActionCounts.len != count ||
       plan.regallocFunctionCallClobberActionCounts.len != count ||
       plan.regallocFunctionEdgeParallelCopyActionCounts.len != count ||
       plan.regallocFunctionParallelCopyCycleBreakActionCounts.len != count ||
       plan.regallocFunctionCriticalEdgeActionCounts.len != count ||
       plan.regallocFunctionSretExclusionCounts.len != count ||
       plan.regallocFunctionAddressEscapeMemoryActionCounts.len != count ||
       plan.regallocFunctionOutgoingStackArgActionCounts.len != count ||
       state.functionWordOffsets.len != count ||
       state.functionWordCounts.len != count:
        return false
    let deferReceiptCount = plan.regallocDeferActionCids.len
    if plan.regallocDeferFunctionRows.len != deferReceiptCount ||
       plan.regallocDeferStatementRows.len != deferReceiptCount ||
       plan.regallocDeferFragmentCids.len != deferReceiptCount:
        return false
    let debugCount = plan.regallocDebugFragmentOpIds.len
    if plan.regallocDebugFragmentFunctionIndexes.len != debugCount ||
       plan.regallocDebugFragmentSyntheticKinds.len != debugCount ||
       plan.regallocDebugFragmentSiteKinds.len != debugCount ||
       plan.regallocDebugFragmentSiteIndexes.len != debugCount ||
       plan.regallocDebugFragmentMachineOwnerKinds.len != debugCount ||
       plan.regallocDebugFragmentMachineOwnerOrdinals.len != debugCount ||
       plan.regallocDebugFragmentActionConsumerOrdinals.len != debugCount ||
       plan.regallocDebugFragmentTextByteStarts.len != debugCount ||
       plan.regallocDebugFragmentByteLengths.len != debugCount ||
       plan.regallocDebugFragmentBytesSha256s.len != debugCount:
        return false
    var expectedDebugStart: int32
    var expectedDeferStart: int32
    var evidenceFunctionIndex =
        regart.RegallocProductionFunctionIndexInit(count)
    for functionIndex in 0..<count:
        if plan.regallocFunctionSymbols[functionIndex] !=
               state.symbolNames[functionIndex] ||
           plan.regallocFunctionSymbolByteStarts[functionIndex] !=
               state.functionWordOffsets[functionIndex] * 4 ||
           plan.regallocFunctionSymbolByteLengths[functionIndex] !=
               state.functionWordCounts[functionIndex] * 4 ||
           functionIndex >= state.functionIrIndexes.len ||
           functionIndex >= state.functionBodyKinds.len ||
           plan.regallocFunctionIrIndexes[functionIndex] !=
               state.functionIrIndexes[functionIndex] ||
           !regart.RegallocProductionFunctionIdentityValid(
               plan.regallocFunctionIrIndexes[functionIndex],
               plan.regallocFunctionKinds[functionIndex]) ||
           (plan.regallocFunctionKinds[functionIndex] ==
                regart.RegallocProductionFunctionKindEntryBridge) !=
               (state.functionBodyKinds[functionIndex] ==
                    texpr.BodyKindEntryBridge) ||
           plan.regallocFunctionActionCounts[functionIndex] < 0 ||
           plan.regallocFunctionExactCalleeMasks[functionIndex] < int64(0) ||
           plan.regallocFunctionRegisterAssignmentCounts[functionIndex] < 0 ||
           plan.regallocFunctionSpillActionCounts[functionIndex] < 0 ||
           plan.regallocFunctionReloadActionCounts[functionIndex] < 0 ||
           plan.regallocFunctionCallClobberActionCounts[functionIndex] < 0 ||
           plan.regallocFunctionEdgeParallelCopyActionCounts[functionIndex] < 0 ||
           plan.regallocFunctionParallelCopyCycleBreakActionCounts[functionIndex] < 0 ||
           plan.regallocFunctionCriticalEdgeActionCounts[functionIndex] < 0 ||
           plan.regallocFunctionSretExclusionCounts[functionIndex] < 0 ||
           plan.regallocFunctionAddressEscapeMemoryActionCounts[functionIndex] < 0 ||
           plan.regallocFunctionOutgoingStackArgActionCounts[functionIndex] < 0 ||
           len(plan.regallocFrozenSnapshotSinglePayloads[functionIndex]) <= 0 ||
           len(plan.regallocEmissionLedgerSinglePayloads[functionIndex]) <= 0 ||
           len(plan.regallocFunctionBodyIrSha256s[functionIndex]) != 64 ||
           len(plan.regallocFunctionSymbolBytesSha256s[functionIndex]) != 64 ||
           len(plan.regallocFunctionPlanSha256s[functionIndex]) != 64 ||
           len(plan.regallocFunctionActionSemanticRootSha256s[functionIndex]) != 64 ||
           len(plan.regallocFunctionActionLedgerRootSha256s[functionIndex]) != 64 ||
           len(plan.regallocFunctionMachineFragmentRootSha256s[functionIndex]) != 64 ||
           len(plan.regallocFunctionAbiIngressRootSha256s[functionIndex]) != 64:
            return false
        if regart.RegallocProductionFunctionIndexAppend(
               evidenceFunctionIndex,
               plan.regallocFunctionIrIndexes[functionIndex],
               plan.regallocFunctionKinds[functionIndex],
               plan.regallocFunctionSymbols[functionIndex]) !=
               regart.RegallocProductionFunctionIndexAppendOk:
            return false
        let deferStart =
            plan.regallocFunctionDeferReceiptStarts[functionIndex]
        let functionDeferCount =
            plan.regallocFunctionDeferReceiptCounts[functionIndex]
        if deferStart != expectedDeferStart ||
           functionDeferCount < 0 ||
           deferStart >
               deferReceiptCount - functionDeferCount:
            return false
        for deferRow in deferStart..<
                (deferStart + functionDeferCount):
            if plan.regallocDeferFunctionRows[deferRow] < 0 ||
               plan.regallocDeferStatementRows[deferRow] < 0 ||
               layout.FixedBytes32Equal(
                   plan.regallocDeferActionCids[deferRow],
                   layout.FixedBytes32()) ||
               layout.FixedBytes32Equal(
                   plan.regallocDeferFragmentCids[deferRow],
                   layout.FixedBytes32()):
                return false
            for priorDeferRow in 0..<deferRow:
                if layout.FixedBytes32Equal(
                       plan.regallocDeferActionCids[
                           priorDeferRow],
                       plan.regallocDeferActionCids[deferRow]) ||
                   layout.FixedBytes32Equal(
                       plan.regallocDeferFragmentCids[
                           priorDeferRow],
                       plan.regallocDeferFragmentCids[deferRow]):
                    return false
        expectedDeferStart =
            deferStart + functionDeferCount
        let debugStart =
            plan.regallocFunctionDebugFragmentStarts[functionIndex]
        let functionDebugCount =
            plan.regallocFunctionDebugFragmentCounts[functionIndex]
        if debugStart != expectedDebugStart || functionDebugCount < 0 ||
           debugStart > debugCount - functionDebugCount:
            return false
        if plan.regallocFunctionDebugProvenanceBound[functionIndex]:
            if plan.regallocFunctionDebugFunctionIds[functionIndex] < 0 ||
               functionDebugCount <= 0 ||
               len(plan.regallocFunctionDebugProvenanceSha256s[
                   functionIndex]) != 64 ||
               len(plan.regallocFunctionDebugMachineFragmentRootSha256s[
                   functionIndex]) != 64:
                return false
        elif plan.regallocFunctionDebugFunctionIds[functionIndex] != -1 ||
             functionDebugCount != 0 ||
             len(plan.regallocFunctionDebugProvenanceSha256s[
                 functionIndex]) != 64 ||
             len(plan.regallocFunctionDebugMachineFragmentRootSha256s[
                 functionIndex]) != 0:
            return false
        for fragmentIndex in debugStart..<(
                debugStart + functionDebugCount):
            if plan.regallocDebugFragmentFunctionIndexes[fragmentIndex] !=
                   functionIndex ||
               plan.regallocDebugFragmentByteLengths[fragmentIndex] <= 0 ||
               len(plan.regallocDebugFragmentBytesSha256s[
                   fragmentIndex]) != 64:
                return false
        expectedDebugStart = debugStart + functionDebugCount
    if expectedDebugStart != debugCount:
        return false
    if expectedDeferStart != deferReceiptCount:
        return false
    return true

@borrows
fn PrimaryObjectPlanDebugEmissionEvidenceInto(
        plan: PrimaryObjectPlan,
        out: var debugevidence.DebugEmissionPlanEvidence,
        err: var str): bool =
    out = debugevidence.DebugEmissionPlanEvidence()
    err = ""
    let count = plan.symbolNames.len
    let debugCount = plan.regallocDebugFragmentOpIds.len
    if (plan.actualBackendKind != "primary" &&
        plan.actualBackendKind != "backend2") ||
       count <= 0 ||
       plan.functionWordOffsets.len != count ||
       plan.functionWordCounts.len != count ||
       plan.functionIrIndexes.len != count ||
       plan.functionBodyKinds.len != count ||
       plan.regallocFrozenSnapshotSinglePayloads.len != count ||
       plan.regallocEmissionLedgerSinglePayloads.len != count ||
       plan.regallocFunctionSymbols.len != count ||
       plan.regallocFunctionIrIndexes.len != count ||
       plan.regallocFunctionKinds.len != count ||
       plan.regallocFunctionBodyIrSha256s.len != count ||
       plan.regallocFunctionSymbolByteStarts.len != count ||
       plan.regallocFunctionSymbolByteLengths.len != count ||
       plan.regallocFunctionSymbolBytesSha256s.len != count ||
       plan.regallocFunctionPlanSha256s.len != count ||
       plan.regallocFunctionActionSemanticRootSha256s.len != count ||
       plan.regallocFunctionActionLedgerRootSha256s.len != count ||
       plan.regallocFunctionMachineFragmentRootSha256s.len != count ||
       plan.regallocFunctionAbiIngressRootSha256s.len != count ||
       plan.regallocFunctionDebugProvenanceBound.len != count ||
       plan.regallocFunctionDebugFunctionIds.len != count ||
       plan.regallocFunctionDebugProvenanceSha256s.len != count ||
       plan.regallocFunctionDebugMachineFragmentRootSha256s.len != count ||
       plan.regallocFunctionDebugFragmentStarts.len != count ||
       plan.regallocFunctionDebugFragmentCounts.len != count ||
       plan.regallocDebugFragmentFunctionIndexes.len != debugCount ||
       plan.regallocDebugFragmentSyntheticKinds.len != debugCount ||
       plan.regallocDebugFragmentSiteKinds.len != debugCount ||
       plan.regallocDebugFragmentSiteIndexes.len != debugCount ||
       plan.regallocDebugFragmentMachineOwnerKinds.len != debugCount ||
       plan.regallocDebugFragmentMachineOwnerOrdinals.len != debugCount ||
       plan.regallocDebugFragmentActionConsumerOrdinals.len != debugCount ||
       plan.regallocDebugFragmentTextByteStarts.len != debugCount ||
       plan.regallocDebugFragmentByteLengths.len != debugCount ||
       plan.regallocDebugFragmentBytesSha256s.len != debugCount:
        err = "debug emission evidence: production plan shape mismatch"
        return false
    out.backendKind = strings.CloneStr(plan.actualBackendKind)
    var expectedDebugStart: int32
    for functionIndex in 0..<count:
        let rowStart =
            plan.regallocFunctionDebugFragmentStarts[functionIndex]
        let rowCount =
            plan.regallocFunctionDebugFragmentCounts[functionIndex]
        if plan.regallocFunctionSymbols[functionIndex] !=
               plan.symbolNames[functionIndex] ||
           functionIndex >= plan.functionIrIndexes.len ||
           plan.regallocFunctionIrIndexes[functionIndex] !=
               plan.functionIrIndexes[functionIndex] ||
           !regart.RegallocProductionFunctionIdentityValid(
               plan.regallocFunctionIrIndexes[functionIndex],
               plan.regallocFunctionKinds[functionIndex]) ||
           (plan.regallocFunctionKinds[functionIndex] ==
                regart.RegallocProductionFunctionKindEntryBridge) !=
               (plan.functionBodyKinds[functionIndex] ==
                    texpr.BodyKindEntryBridge) ||
           plan.regallocFunctionSymbolByteStarts[functionIndex] !=
               plan.functionWordOffsets[functionIndex] * 4 ||
           plan.regallocFunctionSymbolByteLengths[functionIndex] !=
               plan.functionWordCounts[functionIndex] * 4 ||
           rowStart != expectedDebugStart || rowCount < 0 ||
           rowStart > debugCount - rowCount:
            err = "debug emission evidence: function receipt mismatch"
            return false
        if !plan.regallocFunctionDebugProvenanceBound[functionIndex]:
            if plan.actualBackendKind != "primary" ||
               plan.functionBodyKinds[functionIndex] !=
                   texpr.BodyKindEntryBridge ||
               plan.regallocFunctionDebugFunctionIds[functionIndex] != -1 ||
               rowCount != 0 ||
               plan.regallocFunctionDebugMachineFragmentRootSha256s[
                   functionIndex].len != 0:
                err = "debug emission evidence: unbound source function"
                return false
            expectedDebugStart = rowStart
            continue
        if plan.regallocFunctionDebugFunctionIds[functionIndex] < 0 ||
           rowCount <= 0 ||
           plan.regallocFunctionBodyIrSha256s[functionIndex].len != 64 ||
           plan.regallocFunctionSymbolBytesSha256s[functionIndex].len != 64 ||
           plan.regallocFunctionPlanSha256s[functionIndex].len != 64 ||
           plan.regallocFunctionActionSemanticRootSha256s[
               functionIndex].len != 64 ||
           plan.regallocFunctionActionLedgerRootSha256s[
               functionIndex].len != 64 ||
           plan.regallocFunctionMachineFragmentRootSha256s[
               functionIndex].len != 64 ||
           plan.regallocFunctionAbiIngressRootSha256s[
               functionIndex].len != 64 ||
           plan.regallocFunctionDebugProvenanceSha256s[
               functionIndex].len != 64 ||
           plan.regallocFunctionDebugMachineFragmentRootSha256s[
               functionIndex].len != 64:
            err = "debug emission evidence: incomplete function receipt"
            return false
        let projectedFunctionIndex = out.symbolNames.len
        add(out.symbolNames,
            strings.CloneStr(plan.symbolNames[functionIndex]))
        add(out.functionWordOffsets,
            plan.functionWordOffsets[functionIndex])
        add(out.functionWordCounts,
            plan.functionWordCounts[functionIndex])
        add(out.frozenSnapshotPayloads,
            strings.CloneStr(
                plan.regallocFrozenSnapshotSinglePayloads[functionIndex]))
        add(out.emissionLedgerPayloads,
            strings.CloneStr(
                plan.regallocEmissionLedgerSinglePayloads[functionIndex]))
        add(out.bodyIrSha256s,
            strings.CloneStr(
                plan.regallocFunctionBodyIrSha256s[functionIndex]))
        add(out.symbolByteStarts,
            plan.regallocFunctionSymbolByteStarts[functionIndex])
        add(out.symbolByteLengths,
            plan.regallocFunctionSymbolByteLengths[functionIndex])
        add(out.symbolBytesSha256s,
            strings.CloneStr(
                plan.regallocFunctionSymbolBytesSha256s[functionIndex]))
        add(out.planSha256s,
            strings.CloneStr(
                plan.regallocFunctionPlanSha256s[functionIndex]))
        add(out.actionSemanticRootSha256s,
            strings.CloneStr(
                plan.regallocFunctionActionSemanticRootSha256s[functionIndex]))
        add(out.actionBindingRootSha256s,
            strings.CloneStr(
                plan.regallocFunctionActionLedgerRootSha256s[functionIndex]))
        add(out.machineFragmentRootSha256s,
            strings.CloneStr(
                plan.regallocFunctionMachineFragmentRootSha256s[functionIndex]))
        add(out.abiIngressRootSha256s,
            strings.CloneStr(
                plan.regallocFunctionAbiIngressRootSha256s[functionIndex]))
        add(out.debugProvenanceBound, true)
        add(out.debugFunctionIds,
            plan.regallocFunctionDebugFunctionIds[functionIndex])
        add(out.debugProvenanceSha256s,
            strings.CloneStr(
                plan.regallocFunctionDebugProvenanceSha256s[functionIndex]))
        add(out.debugMachineFragmentRootSha256s,
            strings.CloneStr(
                plan.regallocFunctionDebugMachineFragmentRootSha256s[
                    functionIndex]))
        add(out.debugFragmentStarts, out.fragmentDebugOpIds.len)
        add(out.debugFragmentCounts, rowCount)
        for rowIndex in rowStart..<(rowStart + rowCount):
            if plan.regallocDebugFragmentFunctionIndexes[rowIndex] !=
                   functionIndex:
                err = "debug emission evidence: fragment owner mismatch"
                return false
            add(out.fragmentFunctionIndexes, projectedFunctionIndex)
            add(out.fragmentDebugOpIds,
                plan.regallocDebugFragmentOpIds[rowIndex])
            add(out.fragmentSyntheticKinds,
                plan.regallocDebugFragmentSyntheticKinds[rowIndex])
            add(out.fragmentSiteKinds,
                plan.regallocDebugFragmentSiteKinds[rowIndex])
            add(out.fragmentSiteIndexes,
                plan.regallocDebugFragmentSiteIndexes[rowIndex])
            add(out.fragmentMachineOwnerKinds,
                plan.regallocDebugFragmentMachineOwnerKinds[rowIndex])
            add(out.fragmentMachineOwnerOrdinals,
                plan.regallocDebugFragmentMachineOwnerOrdinals[rowIndex])
            add(out.fragmentActionConsumerOrdinals,
                plan.regallocDebugFragmentActionConsumerOrdinals[rowIndex])
            add(out.fragmentTextByteStarts,
                plan.regallocDebugFragmentTextByteStarts[rowIndex])
            add(out.fragmentByteLengths,
                plan.regallocDebugFragmentByteLengths[rowIndex])
            add(out.fragmentBytesSha256s,
                strings.CloneStr(
                    plan.regallocDebugFragmentBytesSha256s[rowIndex]))
        let rebuiltRoot =
            debugevidence.DebugEmissionPlanEvidenceDebugMachineFragmentRootSha256(
                out, projectedFunctionIndex)
        if rebuiltRoot != out.debugMachineFragmentRootSha256s[
               projectedFunctionIndex]:
            err = "debug emission evidence: fragment root mismatch"
            return false
        expectedDebugStart = rowStart + rowCount
    if expectedDebugStart != debugCount || out.symbolNames.len <= 0:
        err = "debug emission evidence: incomplete DebugFact coverage"
        return false
    return true

@borrows
fn PrimaryObjectPlanConsumeDebugSectionPlanReceiptInto(
        lowering: lower.LoweringPlanStub,
        plan: var PrimaryObjectPlan,
        err: var str): bool =
    err = ""
    if !lowering.semanticDebugBound:
        return true
    var emissionEvidence: debugevidence.DebugEmissionPlanEvidence
    if !PrimaryObjectPlanDebugEmissionEvidenceInto(
           plan, emissionEvidence, err):
        return false
    var built: debugsectionconsumer.DebugSectionPlanConsumption
    if !debugsectionconsumer.DebugSectionPlanConsumptionBuildInto(
           lowering, emissionEvidence, built, err) ||
       !debugsectionconsumer.DebugSectionPlanConsumptionStrictValidateInto(
           built, lowering, emissionEvidence, err):
        return false
    if plan.debugSectionPlanConsumed:
        if !debugbindingreceipt.SemanticSnapshotDebugBindingReceiptEqual(
               plan.semanticDebugBindingReceipt,
               built.bindingReceipt) ||
           !debugsectionplan.DebugSectionPlanReceiptStrictValidateInto(
               plan.debugSectionPlanReceipt,
               built.bindingReceipt,
               lowering.semanticDebugFacts, emissionEvidence, err):
            if err == "":
                err = "debug section plan: immutable plan receipt changed"
            return false
        return true
    plan.semanticDebugBindingReceipt = built.bindingReceipt
    plan.debugSectionPlanReceipt = built.sectionPlanReceipt
    plan.debugSectionPlanConsumed = true
    return true

@borrows
fn PrimaryObjectPlanEntryBridgeRuntimeCallInterfaceCid(
        typeArenaArtifactCid: layout.FixedBytes32,
        contractRoleKind: int32,
        call: coreir.CallOp): layout.FixedBytes32 =
    if !coreir.BodyIRTypeArenaArtifactCidValid(typeArenaArtifactCid) ||
       contractRoleKind < PrimaryEntryBridgeRuntimeCallRoleSetCmdLine ||
       contractRoleKind > PrimaryEntryBridgeRuntimeCallRoleProfileFlush ||
       call.resultSlot != -1 ||
       call.resultPassKind != coreir.BodyCallPassStackValueTag ||
       call.argSlots.len <= 0 ||
       call.argSlots.len != call.argPassKinds.len ||
       call.argSlots.len != call.argAbiSizes.len:
        panic("primary regalloc entry bridge: runtime call identity invalid")
    var buf = layout.ByteBufInit(192)
    primaryObjectSymbolIdentityAppendText(
        buf, "cheng.primary.entry_bridge.runtime_call.interface.v1")
    layout.ByteBufAppendFixed32(buf, typeArenaArtifactCid)
    primaryObjectSymbolIdentityAppendU32(buf, contractRoleKind)
    primaryObjectSymbolIdentityAppendU32(buf, call.resultPassKind)
    primaryObjectSymbolIdentityAppendU32(buf, call.argSlots.len)
    for argIndex in 0..<call.argSlots.len:
        primaryObjectSymbolIdentityAppendU32(
            buf, call.argPassKinds[argIndex])
        primaryObjectSymbolIdentityAppendU32(
            buf, call.argAbiSizes[argIndex])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    if layout.FixedBytes32Equal(out, layout.FixedBytes32()):
        panic("primary regalloc entry bridge: zero runtime call cid")
    return out

@borrows
fn PrimaryObjectPlanRegallocEntryBridgeBodyIr(
        entryFunctionSymbol: str,
        typeArenaArtifactCid: layout.FixedBytes32,
        entryTypedFunctionIndex: int32,
        entryInterfaceCid: layout.FixedBytes32): coreir.BodyIR =
    var bodyIR = coreir.BodyIRNew()
    if !coreir.BodyIRBindTypeArenaArtifactCid(
           bodyIR, typeArenaArtifactCid):
        panic("primary regalloc entry bridge: TypeArena artifact CID missing")
    if len(entryFunctionSymbol) <= 0 ||
       entryTypedFunctionIndex < 0 ||
       !coreir.BodyIRTypeArenaArtifactCidValid(entryInterfaceCid):
        return bodyIR
    bodyIR.entryIsCAbi = true

    PrimaryBodyIrLocalSlotNewSized(
        bodyIR, 0, "__entry_argc", coreir.LocalI32Tag, 4, 4)
    PrimaryBodyIrMarkParamSlot(bodyIR, 0, 0)
    PrimaryBodyIrLocalSlotNewSized(
        bodyIR, 1, "__entry_argv", coreir.LocalPtrTag, 8, 8)
    PrimaryBodyIrMarkParamSlot(bodyIR, 1, 1)
    PrimaryBodyIrLocalSlotNewSized(
        bodyIR, 2, "__entry_argv0", coreir.LocalPtrTag, 8, 8)
    PrimaryBodyIrLocalSlotNewSized(
        bodyIR, 3, "__entry_result", coreir.LocalI32Tag, 4, 4)
    # Entry parameter sidecar: ordinal → slot CSR, mirroring the physical
    # stackOffset<0 param markers above (BodyIREntryParameterSlotsShapeValid).
    add(bodyIR.entryParameterSlotIds, 0)
    add(bodyIR.entryParameterSlotIds, 1)

    # Entry definition ownership authority (same canonical freeze lowering
    # applies to source-lowered bodies): params (stackOffset<0) hold plain
    # entry definitions; non-param locals are undefined at entry.
    var entryOwnershipKinds: int32[]
    for slotId in 0..<bodyIR.localSlots.len:
        var ownership = coreir.OwnInvalid
        if bodyIR.localSlots[slotId].stackOffset < 0:
            ownership = coreir.OwnPlain
        add(entryOwnershipKinds, int32(ownership))
    coreir.BodyIRFreezeEntryDefinitionOwnershipKinds(
        bodyIR, entryOwnershipKinds)

    # Control-flow authority: the bridge body belongs to the source entry it
    # bridges (no defer/managed consumer reads the row on this path; the plan
    # records the bridge's own synthetic identity separately).
    coreir.BodyIRControlFlowBegin(bodyIR, entryTypedFunctionIndex)

    var setCmdLine: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(setCmdLine)
    setCmdLine.targetSymbol = "__cheng_setCmdLine"
    setCmdLine.resultSlot = -1
    setCmdLine.resultPassKind = coreir.BodyCallPassStackValueTag
    setCmdLine.relocWordOffset = -1
    add(setCmdLine.argSlots, 0)
    add(setCmdLine.argSlots, 1)
    add(setCmdLine.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(setCmdLine.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(setCmdLine.argAbiSizes, 4)
    add(setCmdLine.argAbiSizes, 8)
    let setCmdLineCid =
        PrimaryObjectPlanEntryBridgeRuntimeCallInterfaceCid(
            typeArenaArtifactCid,
            PrimaryEntryBridgeRuntimeCallRoleSetCmdLine,
            setCmdLine)
    add(bodyIR.callSequence, setCmdLine)
    var setCmdLineOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(setCmdLineOp)
    setCmdLineOp.kind = coreir.BodyOpCallTag
    setCmdLineOp.target = -1
    add(setCmdLineOp.operands, 0)
    let _ = coreir.BodyIRAppendOp(bodyIR, setCmdLineOp)

    var loadArgv0: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(loadArgv0)
    loadArgv0.kind = coreir.BodyOpLoadLocalTag
    loadArgv0.target = 2
    add(loadArgv0.operands, coreir.BodyLoadLocalPtrDerefU64Tag)
    add(loadArgv0.operands, 1)
    add(loadArgv0.operands, 8)
    let _ = coreir.BodyIRAppendOp(bodyIR, loadArgv0)

    var registerLineMap: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(registerLineMap)
    registerLineMap.targetSymbol =
        "cheng_native_register_line_map_from_argv0"
    registerLineMap.resultSlot = -1
    registerLineMap.resultPassKind = coreir.BodyCallPassStackValueTag
    registerLineMap.relocWordOffset = -1
    add(registerLineMap.argSlots, 2)
    add(registerLineMap.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(registerLineMap.argAbiSizes, 8)
    let registerLineMapCid =
        PrimaryObjectPlanEntryBridgeRuntimeCallInterfaceCid(
            typeArenaArtifactCid,
            PrimaryEntryBridgeRuntimeCallRoleRegisterLineMap,
            registerLineMap)
    add(bodyIR.callSequence, registerLineMap)
    var registerLineMapOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(registerLineMapOp)
    registerLineMapOp.kind = coreir.BodyOpCallTag
    registerLineMapOp.target = -1
    add(registerLineMapOp.operands, 1)
    let _ = coreir.BodyIRAppendOp(bodyIR, registerLineMapOp)

    var entryCall: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(entryCall)
    entryCall.targetSymbol = share(entryFunctionSymbol)
    entryCall.resultSlot = 3
    entryCall.resultPassKind = coreir.BodyCallPassStackValueTag
    entryCall.relocWordOffset = -1
    add(entryCall.argSlots, 0)
    add(entryCall.argSlots, 1)
    add(entryCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(entryCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(entryCall.argAbiSizes, 4)
    add(entryCall.argAbiSizes, 8)
    add(bodyIR.callSequence, entryCall)
    var entryCallOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(entryCallOp)
    entryCallOp.kind = coreir.BodyOpCallTag
    entryCallOp.target = 3
    add(entryCallOp.operands, 2)
    let _ = coreir.BodyIRAppendOp(bodyIR, entryCallOp)

    var profileFlush: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(profileFlush)
    profileFlush.targetSymbol = "cheng_debug_profile_flush_from_argv0"
    profileFlush.resultSlot = -1
    profileFlush.resultPassKind = coreir.BodyCallPassStackValueTag
    profileFlush.relocWordOffset = -1
    add(profileFlush.argSlots, 2)
    add(profileFlush.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(profileFlush.argAbiSizes, 8)
    let profileFlushCid =
        PrimaryObjectPlanEntryBridgeRuntimeCallInterfaceCid(
            typeArenaArtifactCid,
            PrimaryEntryBridgeRuntimeCallRoleProfileFlush,
            profileFlush)
    add(bodyIR.callSequence, profileFlush)
    var profileFlushOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(profileFlushOp)
    profileFlushOp.kind = coreir.BodyOpCallTag
    profileFlushOp.target = -1
    add(profileFlushOp.operands, 3)
    let _ = coreir.BodyIRAppendOp(bodyIR, profileFlushOp)

    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = 3
    let termIndex = coreir.BodyIRAppendTerm(bodyIR, term)
    let _ = coreir.BodyIRAppendBlock(
        bodyIR, 0, bodyIR.ops.len, termIndex)

    # Call-target identity authority rides the canonical control-flow binders
    # (coreir.BodyIRControlFlowBindCallTarget); BodyIRControlFlowSeal then
    # canonicalizes the runtime-intrinsic rows and validates the frozen
    # shape, exactly as for source-lowered bodies.
    coreir.BodyIRControlFlowBindBlockScope(bodyIR, 0, 0)
    var noSuccessors: int32[]
    var noEdgeKinds: int32[]
    coreir.BodyIRControlFlowBindTermSuccessors(
        bodyIR, 0, noSuccessors, noEdgeKinds)
    coreir.BodyIRControlFlowBindCallTarget(
        bodyIR, 0,
        coreir.BodyCallTargetDomainRuntimeIntrinsicTag, 0,
        setCmdLineCid)
    coreir.BodyIRControlFlowBindCallTarget(
        bodyIR, 1,
        coreir.BodyCallTargetDomainRuntimeIntrinsicTag, 0,
        registerLineMapCid)
    coreir.BodyIRControlFlowBindCallTarget(
        bodyIR, 2,
        coreir.BodyCallTargetDomainFunctionTag,
        entryTypedFunctionIndex,
        entryInterfaceCid)
    coreir.BodyIRControlFlowBindCallTarget(
        bodyIR, 3,
        coreir.BodyCallTargetDomainRuntimeIntrinsicTag, 0,
        profileFlushCid)
    coreir.BodyIRControlFlowSeal(bodyIR)
    return bodyIR

@borrows
fn primaryObjectPlanRegallocProductionEmit(
        targetTriple: str,
        bodyIR: var coreir.BodyIR,
        symbolName: str,
        symbolByteStart: int32,
        resolvedCallTargets: var str[],
        resolvedDataTargets: var str[],
        functionIrIndex: int32,
        functionKind: int32,
        encoderSourceRow: int32,
        encoderRuntimeAuthorityCid: layout.FixedBytes32):
        regprod.RegallocProductionFunctionEmission =
    let managedReplace =
        managedreplace.ManagedLvalueReplaceProductionVerify(bodyIR)
    if !managedReplace.valid:
        panic("primary: managed replace production receipt invalid")
    var emission =
        regprod.RegallocProductionEmitFunctionWithEncoderAuthority(
        strings.CloneStr(targetTriple), bodyIR,
        strings.CloneStr(symbolName), symbolByteStart,
        resolvedCallTargets, resolvedDataTargets,
        functionIrIndex, functionKind,
        encoderSourceRow, encoderRuntimeAuthorityCid)
    return emission

fn PrimaryObjectPlanEmitRegallocEntryBridge(
        state: var PrimaryObjectPlanPhaseState,
        linkPlan: var slplan.SystemLinkPlanStub,
        plan: var PrimaryObjectPlan,
        typeArenaArtifactCid: layout.FixedBytes32,
        entryTypedFunctionIndex: int32,
        entryInterfaceCid: layout.FixedBytes32): bool =
    if !state.streamedEmitFirst ||
       state.totalWordCount < 0 ||
       state.totalWordCount != plan.instructionWords.len:
        return false
    let functionBase = state.totalWordCount
    let bridgeSymbol = PrimaryRuntimeEntryBridgeSymbol(linkPlan)
    var bodyIR = PrimaryObjectPlanRegallocEntryBridgeBodyIr(
        strings.CloneStr(state.entryFunctionSymbol), typeArenaArtifactCid,
        entryTypedFunctionIndex, entryInterfaceCid)
    if !bodylifecycle.BodyIrPayloadHasPhysicalStorage(bodyIR):
        return false
    var lifecycle: bodylifecycle.BodyIrFunctionLifecycle
    bodylifecycle.BodyIrFunctionLifecycleBeginSyntheticEntryBridge(
        lifecycle, bodyIR)
    bodylifecycle.BodyIrFunctionLifecycleMoveToEmitter(lifecycle)
    bodylifecycle.BodyIrFunctionLifecycleBorrowForPrimaryPreRegalloc(
        lifecycle)
    let bodyShapeExact =
        bodyIR.ops.len == 5 &&
        bodyIR.callSequence.len == 4 &&
        bodyIR.callTargetDomainKinds.len == 4 &&
        bodyIR.callTargetRows.len == 4 &&
        bodyIR.callTargetInterfaceCids.len == 4 &&
        bodyIR.blocks.len == 1 &&
        bodyIR.terms.len == 1
    bodylifecycle.BodyIrFunctionLifecycleReturnPrimaryPreRegallocBorrow(
        lifecycle)
    if !bodyShapeExact:
        PrimaryObjectPlanReleaseEntryBridgeBodyIr(
            state,
            bodyIR,
            lifecycle,
            bodylifecycle.BodyIrFunctionOutcomeEmitFailure)
        return false
    let sourceEntryIdentityExact =
        bodyIR.callTargetDomainKinds[2] ==
            coreir.BodyCallTargetDomainFunctionTag &&
        bodyIR.callTargetRows[2] == entryTypedFunctionIndex &&
        layout.FixedBytes32Equal(
            bodyIR.callTargetInterfaceCids[2], entryInterfaceCid)
    let runtimeIdentityMissing =
        bodyIR.callTargetDomainKinds[0] ==
            coreir.BodyCallTargetDomainInvalidTag ||
        bodyIR.callTargetDomainKinds[1] ==
            coreir.BodyCallTargetDomainInvalidTag ||
        bodyIR.callTargetDomainKinds[3] ==
            coreir.BodyCallTargetDomainInvalidTag
    if !sourceEntryIdentityExact || runtimeIdentityMissing:
        var failureKind =
            "entry_bridge_runtime_call_identity_authority_missing"
        if !sourceEntryIdentityExact:
            failureKind =
                "entry_bridge_source_entry_identity_missing"
        PrimaryObjectPlanRecordStreamedBackpatchFailure(
            state, -1, failureKind, -1, -1, -1)
        PrimaryObjectPlanReleaseEntryBridgeBodyIr(
            state,
            bodyIR,
            lifecycle,
            bodylifecycle.BodyIrFunctionOutcomeEmitFailure)
        return false
    var resolvedCallTargets: str[]
    add(resolvedCallTargets,
        PrimaryTargetSymbolName(linkPlan.targetTriple,
                                "__cheng_setCmdLine"))
    add(resolvedCallTargets,
        PrimaryTargetSymbolName(
            linkPlan.targetTriple,
            "cheng_native_register_line_map_from_argv0"))
    add(resolvedCallTargets, share(state.entryFunctionSymbol))
    add(resolvedCallTargets,
        PrimaryTargetSymbolName(
            linkPlan.targetTriple,
            "cheng_debug_profile_flush_from_argv0"))
    var resolvedDataTargets: str[]
    bodylifecycle.BodyIrFunctionLifecycleBorrowForRegalloc(lifecycle)
    var emission = primaryObjectPlanRegallocProductionEmit(
        strings.CloneStr(linkPlan.targetTriple),
        bodyIR, strings.CloneStr(bridgeSymbol), functionBase * 4,
        resolvedCallTargets, resolvedDataTargets,
        -1, regart.RegallocProductionFunctionKindEntryBridge,
        state.encoderSourceRow,
        state.encoderRuntimeAuthorityCid)
    bodylifecycle.BodyIrFunctionLifecycleReturnRegallocBorrow(lifecycle)
    if !emission.valid ||
       emission.targetTriple != linkPlan.targetTriple ||
       emission.recipeOrigin !=
           regart.RegallocProductionRecipeOriginBodyIrAdapter ||
       !regprod.RegallocProductionEmissionPublishedPayloadExact(
           emission) ||
       emission.receipt.symbolName != bridgeSymbol ||
       emission.receipt.symbolByteStart != functionBase * 4 ||
       emission.receipt.symbolByteLength !=
           emission.recipes.functionWords.len * 4:
        # Diagnostic wiring (kernel-chain-probe-20260826, atlas blind spot 1):
        # surface emission.errorCode/errorDetail instead of collapsing every
        # bridge emission rejection into regalloc_entry_bridge_emit_failed.
        # Pure verdict fidelity: the accept/reject decision is unchanged.
        PrimaryObjectPlanRecordStreamedBackpatchFailure(
            state, -1,
            Fmt"regalloc_entry_bridge_emission_rejected valid={emission.valid} err={emission.errorCode} detail={emission.errorDetail} words={emission.recipes.functionWords.len} origin={emission.recipeOrigin} receiptStart={emission.receipt.symbolByteStart} wantStart={functionBase * 4} receiptLen={emission.receipt.symbolByteLength} wordsLen4={emission.recipes.functionWords.len * 4}",
            emission.errorCode, emission.errorDetail, -1)
        PrimaryObjectPlanReleaseEntryBridgeBodyIr(
            state,
            bodyIR,
            lifecycle,
            bodylifecycle.BodyIrFunctionOutcomeEmitFailure)
        return false
    let relocStart = state.relocWordOffsets.len
    let dataRelocStart = state.dataRelocWordOffsets.len
    let entryBridgeItemIdRaw = 900000 + state.itemIds.len
    let entryBridgeItemId = int32(entryBridgeItemIdRaw)
    let functionIndex = state.itemIds.len
    add(state.itemIds, entryBridgeItemId)
    add(state.symbolNames, share(bridgeSymbol))
    add(state.symbolTypedFunctionIndexes, -1)
    add(state.symbolNameIds, -1)
    add(state.symbolRoles,
        PrimaryObjectSymbolRoleSyntheticEntryBridge)
    add(state.symbolInterfaceCids, layout.FixedBytes32())
    add(state.functionWordOffsets, functionBase)
    add(state.functionWordCounts, emission.recipes.functionWords.len)
    add(state.functionBodyKinds, texpr.BodyKindEntryBridge)
    add(state.functionInstructionBodyKinds, texpr.BodyKindEntryBridge)
    add(state.functionStatementReturnModes, PrimaryStatementReturnModeNone())
    add(state.functionStatementReturnI32Values, 0)
    bodylifecycle.BodyIrFunctionLifecycleBorrowForPrimaryPostRegalloc(
        lifecycle)
    add(state.functionStatementCallCounts, bodyIR.callSequence.len)
    add(state.functionIrIndexes, -1)
    for wordIndex in 0..<emission.recipes.functionWords.len:
        add(plan.instructionWords,
            emission.recipes.functionWords[wordIndex])
    PrimaryObjectPlanAppendEntryBridgeRelocs(state,
                                             linkPlan,
                                             entryBridgeItemId,
                                             functionBase)
    var entryResolvedCallTargets: str[]
    let postRegallocReadersExact =
        PrimaryObjectPlanRecordRegallocProductionRelocs(
            state, functionIndex, bodyIR, relocStart,
            dataRelocStart, emission, entryResolvedCallTargets) &&
        PrimaryObjectPlanResolveStreamedRelocsForFunction(
            state, functionIndex, relocStart, dataRelocStart) &&
        PrimaryObjectPlanRecordRegallocProductionEvidence(
            plan, bodyIR, emission, -1,
            regart.RegallocProductionFunctionKindEntryBridge)
    if postRegallocReadersExact:
        PrimaryObjectPlanAccumulateStreamedBodyIrDod(plan, bodyIR)
    bodylifecycle.BodyIrFunctionLifecycleReturnPrimaryPostRegallocBorrow(
        lifecycle)
    if !postRegallocReadersExact:
        PrimaryObjectPlanReleaseEntryBridgeBodyIr(
            state,
            bodyIR,
            lifecycle,
            bodylifecycle.BodyIrFunctionOutcomeEmitFailure)
        return false
    PrimaryObjectPlanReleaseEntryBridgeBodyIr(
        state,
        bodyIR,
        lifecycle,
        bodylifecycle.BodyIrFunctionOutcomeEmitSuccess)
    if state.bodyIrLifecycleFunctionCount !=
           state.fillCheckReleasedBodyIrFunctionCount ||
       state.bodyIrLifecycleAllocated !=
           int64(state.bodyIrLifecycleFunctionCount) ||
       state.bodyIrLifecycleReleased !=
           int64(state.bodyIrLifecycleFunctionCount) ||
       state.bodyIrLifecycleLive != int64(0) ||
       state.bodyIrLifecycleAllocatedBytes !=
           state.bodyIrLifecycleReleasedBytes ||
       state.bodyIrLifecycleLiveBytes != int64(0) ||
       state.bodyIrLifecycleOwnerTransferCount !=
           int64(state.bodyIrLifecycleFunctionCount) ||
       state.bodyIrLifecyclePhysicalBufferCount !=
           state.bodyIrLifecyclePhysicalFreeCount ||
       state.bodyIrLifecycleLedgerStorageReleasedSequenceCount !=
           int64(state.bodyIrLifecycleFunctionCount) * int64(6) ||
       state.bodyIrLifecycleLedgerStorageReleasedBufferCount <= int64(0) ||
       state.bodyIrLifecycleLedgerStorageReleasedBufferCount >
           state.bodyIrLifecycleLedgerStorageReleasedSequenceCount ||
       state.bodyIrLifecycleLedgerStorageReleasedBytes <= int64(0) ||
       !state.bodyIrLifecycleAllClosed:
        panic(
            "primary body ir lifecycle: entry bridge release unbalanced")
    add(state.functionBodyIRs, coreir.BodyIRNew())
    state.totalWordCount =
        functionBase + emission.recipes.functionWords.len
    # [MEM-RELIEF] Per-function lowering/emission allocates and then releases
    # the whole BodyIR plus regalloc/ledger transients.  Without a zone
    # pressure relief the freed spans stay dirty and the per-function
    # high-water mark accumulates across the stream.  Relief changes no
    # bytes/receipts, only the allocator's return of ownerless pages.
    let _entryBridgeReleaseRelief = os.ProcessMemoryPressureRelief()
    return true

fn PrimaryObjectPlanRecordRegallocProductionRelocs(
        state: var PrimaryObjectPlanPhaseState,
        functionIndex: int32,
        bodyIR: var coreir.BodyIR,
        relocStart: int32,
        dataRelocStart: int32,
        emission: var regprod.RegallocProductionFunctionEmission,
        resolvedCallTargets: str[]): bool =
    if functionIndex < 0 || functionIndex >= state.itemIds.len ||
       functionIndex >= state.functionWordOffsets.len ||
       relocStart < 0 || relocStart > state.relocWordOffsets.len ||
       state.relocSourceItemIds.len != state.relocWordOffsets.len ||
       state.relocTargetSymbols.len != state.relocWordOffsets.len ||
       state.relocTargetDomainKinds.len != state.relocWordOffsets.len ||
       state.relocTargetRows.len != state.relocWordOffsets.len ||
       state.relocTargetInterfaceCids.len !=
           state.relocWordOffsets.len ||
       state.relocCallOrdinal.len != state.relocWordOffsets.len ||
       dataRelocStart < 0 ||
       dataRelocStart != state.dataRelocWordOffsets.len ||
       state.dataRelocSourceItemIds.len != dataRelocStart ||
       state.dataRelocPredictedKey.len != dataRelocStart ||
       state.dataRelocOpIndex.len != dataRelocStart ||
       state.dataRelocSubIndex.len != dataRelocStart ||
       state.dataRelocTargetSymbols.len != dataRelocStart:
        PrimaryObjectPlanRecordStreamedBackpatchFailure(
            state, functionIndex, "regalloc_reloc_structure_mismatch",
            -1, -1, -1)
        return false
    let itemId = state.itemIds[functionIndex]
    let functionBase = state.functionWordOffsets[functionIndex]
    if functionBase < 0:
        PrimaryObjectPlanRecordStreamedBackpatchFailure(
            state, functionIndex, "regalloc_reloc_structure_mismatch",
            -1, -1, -1)
        return false
    var matchedCallRows: bool[]
    for _ in relocStart..<state.relocWordOffsets.len:
        add(matchedCallRows, false)
    var callRowByOrdinal: int32[]
    for _ in 0..<bodyIR.callSequence.len:
        add(callRowByOrdinal, -1)
    for rowIndex in relocStart..<state.relocWordOffsets.len:
        if rowIndex >= state.relocSourceItemIds.len ||
           rowIndex >= state.relocTargetSymbols.len ||
           rowIndex >= state.relocTargetDomainKinds.len ||
           rowIndex >= state.relocTargetRows.len ||
           rowIndex >= state.relocTargetInterfaceCids.len ||
           rowIndex >= state.relocCallOrdinal.len ||
           state.relocSourceItemIds[rowIndex] != itemId:
            os.WriteLine(os.GetStderr(),
                         Fmt"phase=regalloc_call_reloc_structure_mismatch_record_item function_index={functionIndex} row_index={rowIndex} item_id={itemId} reloc_start={relocStart} src_len={state.relocSourceItemIds.len} call_seq={bodyIR.callSequence.len}")
            PrimaryObjectPlanRecordStreamedBackpatchFailure(
                state, functionIndex,
                "regalloc_call_reloc_structure_mismatch", -1, -1, -1)
            return false
        let callOrdinal = state.relocCallOrdinal[rowIndex]
        var spellingLen: int32
        if callOrdinal >= 0 && callOrdinal < resolvedCallTargets.len:
            spellingLen = len(resolvedCallTargets[callOrdinal])
        if spellingLen <= 0 && rowIndex < state.relocTargetSymbols.len:
            spellingLen = len(state.relocTargetSymbols[rowIndex])
        if callOrdinal < 0 || callOrdinal >= callRowByOrdinal.len ||
           spellingLen <= 0 ||
           callRowByOrdinal[callOrdinal] >= 0:
            var dupOrd: int32
            dupOrd = -2
            if callOrdinal >= 0 && callOrdinal < callRowByOrdinal.len:
                dupOrd = callRowByOrdinal[callOrdinal]
            os.WriteLine(os.GetStderr(),
                         Fmt"phase=regalloc_call_reloc_structure_mismatch_record_ord function_index={functionIndex} row_index={rowIndex} call_ordinal={callOrdinal} call_seq={callRowByOrdinal.len} target_len={len(state.relocTargetSymbols[rowIndex])} dup={dupOrd}")
            PrimaryObjectPlanRecordStreamedBackpatchFailure(
                state, functionIndex,
                "regalloc_call_reloc_structure_mismatch",
                callOrdinal, -1, -1)
            return false
        callRowByOrdinal[callOrdinal] = rowIndex
    # Data relocation identity is frozen by the final production emission.
    # The adapter assigns dense sub-indices while walking the emitted stream;
    # validating the same sequence here proves uniqueness without a predictor
    # table or an O(relocs^2) duplicate scan.
    var nextDataSubIndex: int32[]
    for _ in 0..<bodyIR.ops.len:
        add(nextDataSubIndex, 0)
    var pageRelocOpen: bool
    var pageRelocWordIndex: int32 = -1
    var pageRelocOpIndex: int32 = -1
    var pageRelocSubIndex: int32 = -1
    var pageRelocTarget = ""
    PrimaryBackpatchResetForFunction(functionBase, bodyIR.blocks.len)
    let callBlRecordCountBefore = primaryBackpatchCallRelocOrdinal.len
    let dataRecordCountBefore = primaryBackpatchDataRelocFnBase.len
    for recipeRelocIndex in 0..<emission.recipes.functionRelocs.len:
        let reloc = emission.recipes.functionRelocs[recipeRelocIndex]
        if pageRelocOpen &&
           reloc.kind != contract.RegallocA64RelocPageOff12:
            PrimaryObjectPlanRecordStreamedBackpatchFailure(
                state, functionIndex, "regalloc_data_reloc_pair_mismatch",
                -1, -1, -1)
            return false
        if contract.CodegenUnitRelocKindIsCall(reloc.kind):
            if reloc.wordIndex < 0 ||
               reloc.wordIndex >= emission.recipes.functionWords.len ||
               reloc.byteOffset < 0 ||
               reloc.byteOffset >
                   emission.recipes.functionWords.len * 4 - 4 ||
               reloc.opIndex < 0 || reloc.opIndex >= bodyIR.ops.len ||
               reloc.subIndex >= 0 ||
               reloc.callOrdinal < 0 ||
               reloc.callOrdinal >= callRowByOrdinal.len ||
               reloc.callOrdinal >= bodyIR.callTargetDomainKinds.len ||
               reloc.callOrdinal >= bodyIR.callTargetRows.len ||
               reloc.callOrdinal >= bodyIR.callTargetInterfaceCids.len ||
               callRowByOrdinal[reloc.callOrdinal] < 0:
                PrimaryObjectPlanRecordStreamedBackpatchFailure(
                    state, functionIndex, "regalloc_call_reloc_missing",
                    reloc.callOrdinal, -1, -1)
                return false
            let matchedRow = callRowByOrdinal[reloc.callOrdinal]
            var spellingMatches = false
            if reloc.callOrdinal >= 0 &&
               reloc.callOrdinal < resolvedCallTargets.len &&
               len(resolvedCallTargets[reloc.callOrdinal]) > 0:
                spellingMatches =
                    resolvedCallTargets[reloc.callOrdinal] ==
                        reloc.targetSymbol
            elif matchedRow < state.relocTargetSymbols.len:
                spellingMatches =
                    state.relocTargetSymbols[matchedRow] ==
                        reloc.targetSymbol
            if matchedCallRows[matchedRow - relocStart] ||
               !spellingMatches ||
               reloc.targetDomain !=
                   bodyIR.callTargetDomainKinds[reloc.callOrdinal] ||
               reloc.targetRow !=
                   bodyIR.callTargetRows[reloc.callOrdinal] ||
               !layout.FixedBytes32Equal(
                   reloc.targetInterfaceCid,
                   bodyIR.callTargetInterfaceCids[reloc.callOrdinal]):
                PrimaryObjectPlanRecordStreamedBackpatchFailure(
                    state, functionIndex,
                    "regalloc_call_reloc_structure_mismatch",
                    reloc.callOrdinal, -1, -1)
                return false
            if !PrimaryObjectPlanBindCallRelocIdentityFromRecipe(
                   state, matchedRow, reloc):
                PrimaryObjectPlanRecordStreamedBackpatchFailure(
                    state, functionIndex,
                    "regalloc_call_reloc_identity_bind_failed",
                    reloc.callOrdinal, -1, -1)
                return false
            matchedCallRows[matchedRow - relocStart] = true
            if reloc.kind == contract.RegallocMachineRelocRiscvCall &&
               (!regart.RegallocProductionTargetIsRiscv(
                    emission.targetTriple) ||
                reloc.wordIndex >=
                    emission.recipes.functionWords.len - 1):
                PrimaryObjectPlanRecordStreamedBackpatchFailure(
                    state, functionIndex,
                    "regalloc_riscv_call_pair_mismatch",
                    reloc.callOrdinal, -1, -1)
                return false
            if reloc.kind == contract.RegallocA64RelocCall26 &&
               !regart.RegallocProductionTargetIsA64(
                    emission.targetTriple):
                PrimaryObjectPlanRecordStreamedBackpatchFailure(
                    state, functionIndex,
                    "regalloc_call_reloc_target_mismatch",
                    reloc.callOrdinal, -1, -1)
                return false
            var exactRelocOffset = functionBase + reloc.wordIndex
            if reloc.kind ==
                   contract.RegallocMachineRelocPcRel32:
                exactRelocOffset =
                    functionBase * 4 + reloc.byteOffset
            PrimaryBackpatchRecordCallBlReloc(
                reloc.callOrdinal, exactRelocOffset)
        elif reloc.kind == contract.RegallocA64RelocPage21:
            if reloc.wordIndex < 0 ||
               reloc.wordIndex >=
                   emission.recipes.functionWords.len - 1 ||
               reloc.callOrdinal >= 0 ||
               reloc.opIndex < 0 ||
               reloc.opIndex >= nextDataSubIndex.len ||
               reloc.subIndex < 0 ||
               reloc.subIndex != nextDataSubIndex[reloc.opIndex] ||
               len(reloc.targetSymbol) <= 0:
                PrimaryObjectPlanRecordStreamedBackpatchFailure(
                    state, functionIndex, "regalloc_data_reloc_mismatch",
                    -1, reloc.opIndex, reloc.subIndex)
                return false
            pageRelocOpen = true
            pageRelocWordIndex = reloc.wordIndex
            pageRelocOpIndex = reloc.opIndex
            pageRelocSubIndex = reloc.subIndex
            pageRelocTarget = reloc.targetSymbol
        elif reloc.kind == contract.RegallocA64RelocPageOff12:
            if !pageRelocOpen ||
               reloc.callOrdinal >= 0 ||
               reloc.wordIndex != pageRelocWordIndex + 1 ||
               reloc.opIndex != pageRelocOpIndex ||
               reloc.subIndex != pageRelocSubIndex ||
               reloc.targetSymbol != pageRelocTarget:
                PrimaryObjectPlanRecordStreamedBackpatchFailure(
                    state, functionIndex,
                    "regalloc_data_reloc_pair_mismatch", -1, -1, -1)
                return false
            let exactWordOffset = functionBase + pageRelocWordIndex
            add(state.dataRelocSourceItemIds, itemId)
            add(state.dataRelocWordOffsets, exactWordOffset)
            add(state.dataRelocPredictedKey, exactWordOffset)
            add(state.dataRelocOpIndex, pageRelocOpIndex)
            add(state.dataRelocSubIndex, pageRelocSubIndex)
            add(state.dataRelocTargetSymbols, pageRelocTarget)
            PrimaryBackpatchRecordDataRelocEmitFirst(
                pageRelocOpIndex, pageRelocSubIndex, exactWordOffset)
            nextDataSubIndex[pageRelocOpIndex] =
                nextDataSubIndex[pageRelocOpIndex] + 1
            pageRelocOpen = false
            pageRelocWordIndex = -1
            pageRelocOpIndex = -1
            pageRelocSubIndex = -1
            pageRelocTarget = ""
        else:
            PrimaryObjectPlanRecordStreamedBackpatchFailure(
                state, functionIndex, "regalloc_reloc_kind_invalid",
                -1, -1, -1)
            return false
    if pageRelocOpen:
        PrimaryObjectPlanRecordStreamedBackpatchFailure(
            state, functionIndex, "regalloc_data_reloc_count_mismatch",
            -1, -1, -1)
        return false
    for matchedIndex in 0..<matchedCallRows.len:
        if !matchedCallRows[matchedIndex]:
            let rowIndex = relocStart + matchedIndex
            var callOrdinal: int32 = -1
            if rowIndex < state.relocCallOrdinal.len:
                callOrdinal = state.relocCallOrdinal[rowIndex]
            PrimaryObjectPlanRecordStreamedBackpatchFailure(
                state, functionIndex, "regalloc_call_reloc_count_mismatch",
                callOrdinal, -1, -1)
            return false
    # 块发射序不保证 callSequence 序(多 block 函数,如 panicCString 的
    # driver_c_new_string 两次调用 co2 先于 co1 发射):RealFor 的二分查找
    # 要求记录按 (fnBase, ordinal) 字典序。对本函数新加记录做插入排序
    # (fnBase 单调递增跨函数,函数内排序后全局仍字典序)。
    var sortCursor = callBlRecordCountBefore + 1
    while sortCursor < primaryBackpatchCallRelocOrdinal.len:
        let sortBase = primaryBackpatchCallRelocFnBase[sortCursor]
        let sortOrd = primaryBackpatchCallRelocOrdinal[sortCursor]
        let sortPos = primaryBackpatchCallRelocRealPos[sortCursor]
        var sortScan = sortCursor
        while sortScan > callBlRecordCountBefore &&
           (primaryBackpatchCallRelocFnBase[sortScan - 1] > sortBase ||
            (primaryBackpatchCallRelocFnBase[sortScan - 1] == sortBase &&
             primaryBackpatchCallRelocOrdinal[sortScan - 1] > sortOrd)):
            primaryBackpatchCallRelocFnBase[sortScan] =
                primaryBackpatchCallRelocFnBase[sortScan - 1]
            primaryBackpatchCallRelocOrdinal[sortScan] =
                primaryBackpatchCallRelocOrdinal[sortScan - 1]
            primaryBackpatchCallRelocRealPos[sortScan] =
                primaryBackpatchCallRelocRealPos[sortScan - 1]
            sortScan = sortScan - 1
        primaryBackpatchCallRelocFnBase[sortScan] = sortBase
        primaryBackpatchCallRelocOrdinal[sortScan] = sortOrd
        primaryBackpatchCallRelocRealPos[sortScan] = sortPos
        sortCursor = sortCursor + 1
    # [wall131] data reloc fill record 同款字典序恢复 (call reloc 先例同构,
    # 见上方插入排序): recipe reloc 流按 wordIndex (发射序) 遍历, opIndex 由
    # ownerOpByWord 反查, 嵌套 fmt/桥形态下发射序≠op 存储序, 流序 append 的
    # (fnBase,opIndex,subIndex) 非字典序 → PrimaryBackpatchDataRelocRealFor
    # 二分 miss → data_reloc_no_fill_record (cold_nested 实证)。对本函数新
    # 加记录段做插入排序: fnBase 单调递增跨函数, 函数内排序后全局仍字典序。
    # 四列并行移动, 配对关系与记录内容零变化, 查找前提恢复为声明契约。
    var dataSortCursor = dataRecordCountBefore + 1
    while dataSortCursor < primaryBackpatchDataRelocFnBase.len:
        let dataSortBase = primaryBackpatchDataRelocFnBase[dataSortCursor]
        let dataSortOp = primaryBackpatchDataRelocOpIndex[dataSortCursor]
        let dataSortSub = primaryBackpatchDataRelocSubIndex[dataSortCursor]
        let dataSortPos = primaryBackpatchDataRelocRealPos[dataSortCursor]
        var dataSortScan = dataSortCursor
        while dataSortScan > dataRecordCountBefore:
            let prevBase = primaryBackpatchDataRelocFnBase[dataSortScan - 1]
            let prevOp = primaryBackpatchDataRelocOpIndex[dataSortScan - 1]
            let prevSub = primaryBackpatchDataRelocSubIndex[dataSortScan - 1]
            if prevBase < dataSortBase ||
               (prevBase == dataSortBase &&
                (prevOp < dataSortOp ||
                 (prevOp == dataSortOp && prevSub < dataSortSub))):
                break
            primaryBackpatchDataRelocFnBase[dataSortScan] = prevBase
            primaryBackpatchDataRelocOpIndex[dataSortScan] = prevOp
            primaryBackpatchDataRelocSubIndex[dataSortScan] = prevSub
            primaryBackpatchDataRelocRealPos[dataSortScan] =
                primaryBackpatchDataRelocRealPos[dataSortScan - 1]
            dataSortScan = dataSortScan - 1
        primaryBackpatchDataRelocFnBase[dataSortScan] = dataSortBase
        primaryBackpatchDataRelocOpIndex[dataSortScan] = dataSortOp
        primaryBackpatchDataRelocSubIndex[dataSortScan] = dataSortSub
        primaryBackpatchDataRelocRealPos[dataSortScan] = dataSortPos
        dataSortCursor = dataSortCursor + 1
    return true

fn PrimaryObjectPlanStreamEmitAndReleaseCurrent(state: var PrimaryObjectPlanPhaseState,
                                                 lowering: var lower.LoweringPlanStub,
                                                 plan: var PrimaryObjectPlan,
                                                 sourceFunctionIndex: int32,
                                                 functionIndex: int32,
                                                 bodyIR: var coreir.BodyIR,
                                                 relocStart: int32,
                                                 dataRelocStart: int32): bool =
    var lifecycle: bodylifecycle.BodyIrFunctionLifecycle
    var lifecycleBegun = false
    let streamSnapshot = PrimaryObjectPlanStreamEmitSnapshotCapture(state,
                                                                     plan,
                                                                     functionIndex,
                                                                     relocStart,
                                                                     dataRelocStart)
    if functionIndex < 0 ||
       functionIndex >= state.functionWordOffsets.len ||
       functionIndex >= state.functionWordCounts.len ||
       functionIndex >= state.functionIrIndexes.len ||
       state.functionIrIndexes[functionIndex] < 0:
        PrimaryObjectPlanRecordStreamedBackpatchFailure(state,
                                                         functionIndex,
                                                         "stream_function_layout_missing",
                                                         -1,
                                                         -1,
                                                         -1)
        return PrimaryObjectPlanAbortStreamEmit(state,
                                                 plan,
                                                 bodyIR,
                                                 sourceFunctionIndex,
                                                 functionIndex,
                                                 streamSnapshot,
                                                 lifecycle,
                                                 lifecycleBegun)
    let functionBase = plan.instructionWords.len
    state.functionWordOffsets[functionIndex] = functionBase
    if functionBase > 536870911:
        PrimaryObjectPlanRecordStreamedBackpatchFailure(
            state, functionIndex, "regalloc_symbol_range_invalid",
            -1, -1, -1)
        return PrimaryObjectPlanAbortStreamEmit(
            state, plan, bodyIR, sourceFunctionIndex,
            functionIndex, streamSnapshot, lifecycle, lifecycleBegun)
    if !bodylifecycle.BodyIrPayloadHasPhysicalStorage(bodyIR):
        PrimaryObjectPlanRecordStreamedBackpatchFailure(
            state, functionIndex,
            Fmt"regalloc_body_ir_missing ops={bodyIR.ops.len}/{bodyIR.ops.cap} terms={bodyIR.terms.len}/{bodyIR.terms.cap} blocks={bodyIR.blocks.len}/{bodyIR.blocks.cap} calls={bodyIR.callSequence.len}/{bodyIR.callSequence.cap} slots={bodyIR.localSlots.len}/{bodyIR.localSlots.cap}",
            -1, -1, -1)
        return PrimaryObjectPlanAbortStreamEmit(
            state, plan, bodyIR, sourceFunctionIndex,
            functionIndex, streamSnapshot, lifecycle, lifecycleBegun)
    bodylifecycle.BodyIrFunctionLifecycleBegin(
        lifecycle, bodyIR, state.functionIrIndexes[functionIndex])
    bodylifecycle.BodyIrFunctionLifecycleMoveToEmitter(lifecycle)
    lifecycleBegun = true
    bodylifecycle.BodyIrFunctionLifecycleBorrowForPrimaryPreRegalloc(
        lifecycle)
    PrimaryObjectPlanAccumulateStreamedBodyIrDod(plan, bodyIR)
    var hasBodyIR: bool
    if bodyIR.ops.len > 0 || bodyIR.terms.len > 0:
        hasBodyIR = true
    if !hasBodyIR:
        bodylifecycle.BodyIrFunctionLifecycleReturnPrimaryPreRegallocBorrow(
            lifecycle)
        PrimaryObjectPlanRecordStreamedBackpatchFailure(
            state, functionIndex, "regalloc_body_ir_missing",
            -1, -1, -1)
        return PrimaryObjectPlanAbortStreamEmit(
            state, plan, bodyIR, sourceFunctionIndex,
            functionIndex, streamSnapshot, lifecycle, lifecycleBegun)
    var emittedWordCount: int32
    emittedWordCount = -1
    if hasBodyIR:
        var resolvedCallTargets: str[]
        if !PrimaryObjectPlanRegallocResolvedCallTargets(
               state, functionIndex, bodyIR, relocStart,
               resolvedCallTargets):
            bodylifecycle.BodyIrFunctionLifecycleReturnPrimaryPreRegallocBorrow(
                lifecycle)
            return PrimaryObjectPlanAbortStreamEmit(
                state, plan, bodyIR, sourceFunctionIndex,
                functionIndex, streamSnapshot, lifecycle, lifecycleBegun)
        var resolvedDataTargets: str[]
        if !PrimaryObjectPlanRegallocResolvedDataTargets(
               bodyIR, plan.targetTriple, state.allSymbolNames,
               resolvedDataTargets):
            bodylifecycle.BodyIrFunctionLifecycleReturnPrimaryPreRegallocBorrow(
                lifecycle)
            PrimaryObjectPlanRecordStreamedBackpatchFailure(
                state, functionIndex,
                "regalloc_data_target_resolution_failed",
                -1, -1, -1)
            return PrimaryObjectPlanAbortStreamEmit(
                state, plan, bodyIR, sourceFunctionIndex,
                functionIndex, streamSnapshot, lifecycle, lifecycleBegun)
        bodylifecycle.BodyIrFunctionLifecycleReturnPrimaryPreRegallocBorrow(
            lifecycle)
        bodylifecycle.BodyIrFunctionLifecycleBorrowForRegalloc(
            lifecycle)
        var emission = primaryObjectPlanRegallocProductionEmit(
            plan.targetTriple,
            bodyIR, state.symbolNames[functionIndex],
            functionBase * 4, resolvedCallTargets,
            resolvedDataTargets,
            state.functionIrIndexes[functionIndex],
            regart.RegallocProductionFunctionKindNormal,
            state.encoderSourceRow,
            state.encoderRuntimeAuthorityCid)
        bodylifecycle.BodyIrFunctionLifecycleReturnRegallocBorrow(
            lifecycle)
        if !regprod.RegallocProductionEmissionPublishedPayloadExact(
               emission):
            var slotDump = ""
            for slotIndex in 0..<bodyIR.localSlots.len:
                let dumpSlot = bodyIR.localSlots[slotIndex]
                slotDump = Fmt"{slotDump}|s{slotIndex}:id={dumpSlot.id}:n={dumpSlot.name}:tk={dumpSlot.typeKind}:sz={dumpSlot.sizeBytes}:al={dumpSlot.alignBytes}"
            var ingBlocks = false
            var ingTerms = false
            var ingLayouts = false
            var ingLegacy = false
            var ingDeferReplay = false
            var ingProv = false
            let _ = alloc.RegallocSinglePassBodyIrCanonicalIngressConjunctsValid(
                bodyIR, ingBlocks, ingTerms, ingLayouts,
                ingLegacy, ingDeferReplay, ingProv)
            var opDump = ""
            for opIndex in 0..<bodyIR.ops.len:
                let dumpOp = bodyIR.ops[opIndex]
                var op0 = -1
                if dumpOp.operands.len > 0:
                    op0 = dumpOp.operands[0]
                opDump = Fmt"{opDump}|o{opIndex}:k={dumpOp.kind}:t={dumpOp.target}:n={dumpOp.operands.len}:a0={op0}"
            var callDump = ""
            if bodyIR.callSequence.len > 0:
                let dumpCall = bodyIR.callSequence[0]
                var a0 = -9
                var a1 = -9
                if dumpCall.argSlots.len > 0:
                    a0 = dumpCall.argSlots[0]
                if dumpCall.argSlots.len > 1:
                    a1 = dumpCall.argSlots[1]
                callDump = Fmt"args={dumpCall.argSlots.len}:a0={a0}:a1={a1}:result={dumpCall.resultSlot}:symlen={dumpCall.targetSymbol.len}"
            # [wall103] data symbol projection receipt 判词富化（wall84 同款，
            # 仅 reject 路径）：code=10（DataTargetInvalid）时 receipt.valid
            # 的子条件不可见，把逐列实况 + 判词时刻 bodyIR ingress sha 与
            # plan（before）sha 的等值观测一并入判词，定点暴露漂移源。
            var dspShaNowEqPlan = false
            if len(emission.plan.bodyIrIngressSha256) == 64:
                dspShaNowEqPlan =
                    alloc.RegallocSinglePassBodyIrIngressSha256(bodyIR) ==
                        emission.plan.bodyIrIngressSha256
            let dspReceipt = emission.dataSymbolProjectionReceipt
            os.WriteLine(os.GetStderr(),
                         Fmt"phase=regalloc_production_emit_failed function={state.symbolNames[functionIndex]} valid={emission.valid} code={emission.errorCode} detail={emission.errorDetail} plan_code={emission.plan.errorCode} plan_detail={emission.plan.errorDetail} plan_valid={emission.plan.valid} plan_frozen={emission.plan.frozen} words={emission.recipes.functionWords.len} published={emission.publishedWordCount} ops={bodyIR.ops.len} calls={bodyIR.callSequence.len} resolved_calls={resolvedCallTargets.len} ir_index={state.functionIrIndexes[functionIndex]} origin={emission.recipeOrigin} blocks={bodyIR.blocks.len} terms={bodyIR.terms.len} slots={bodyIR.localSlots.len} ingress={alloc.RegallocSinglePassBodyIrCanonicalIngressValid(bodyIR)} ingress_b={ingBlocks} ingress_t={ingTerms} ingress_l={ingLayouts} ingress_g={ingLegacy} ingress_d={ingDeferReplay} ingress_p={ingProv} ing_prov_req={bodyIR.debugProvenanceRequired} ing_prov_cmpl={bodyIR.debugProvenanceComplete} ing_prov_fn={bodyIR.debugFunctionId} ing_prov_opl={bodyIR.debugOpIdsByOpIndex.len} ing_prov_tmpl={bodyIR.debugOpIdsByTermIndex.len} ing_g_fmr={bodyIR.frameMetricsReady} ing_g_x64r={bodyIR.x64StackLayoutReady} ing_g_lle={bodyIR.layoutLhsElide.len} ing_g_fsb={bodyIR.frameStackByteCount} ing_dre_b={bodyIR.deferReplay.building} ing_dre_s={bodyIR.deferReplay.sealed} ing_dre_ms={bodyIR.deferReplay.templateOpMapStarts.len} ing_ci={bodyIR.cleanupIntent.unitKinds.len} dsp_rows={dspReceipt.slotProjectionRows} dsp_crows={dspReceipt.cstringProjectionRows} dsp_slb={dspReceipt.sourceLocalSlotLenBefore} dsp_sla={dspReceipt.sourceLocalSlotLenAfter} dsp_clb={dspReceipt.sourceCStringLenBefore} dsp_cla={dspReceipt.sourceCStringLenAfter} dsp_rbuf={dspReceipt.retainedBufferCount} dsp_relbuf={dspReceipt.releasedBufferCount} dsp_rmvc={dspReceipt.retainedManagedStringValueCount} dsp_relmvc={dspReceipt.releasedManagedStringValueCount} dsp_free={dspReceipt.physicalFreeCount} dsp_orc={dspReceipt.orcReleaseCount} dsp_stor={dspReceipt.storageReleased} dsp_cid={layout.FixedBytes32Equal(dspReceipt.sourceBodyIrIngressCidBefore, dspReceipt.sourceBodyIrIngressCidAfter)} dsp_sha_now_eq_plan={dspShaNowEqPlan} slots_dump={slotDump} ops_dump={opDump} call0={callDump}")
            PrimaryObjectPlanRecordStreamedBackpatchFailure(
                state, functionIndex, "regalloc_production_emit_failed",
                emission.errorCode, emission.errorDetail, -1)
            return PrimaryObjectPlanAbortStreamEmit(
                state, plan, bodyIR, sourceFunctionIndex,
                functionIndex, streamSnapshot, lifecycle, lifecycleBegun)
        if emission.targetTriple != plan.targetTriple:
            PrimaryObjectPlanRecordStreamedBackpatchFailure(
                state, functionIndex,
                "regalloc_production_target_identity_mismatch",
                emission.errorCode, emission.errorDetail, -1)
            return PrimaryObjectPlanAbortStreamEmit(
                state, plan, bodyIR, sourceFunctionIndex,
                functionIndex, streamSnapshot, lifecycle, lifecycleBegun)
        emittedWordCount = emission.recipes.functionWords.len
        for wordIndex in 0..<emission.recipes.functionWords.len:
            add(plan.instructionWords,
                emission.recipes.functionWords[wordIndex])
        bodylifecycle.BodyIrFunctionLifecycleBorrowForPrimaryPostRegalloc(
            lifecycle)
        if !PrimaryObjectPlanRecordRegallocProductionRelocs(
               state, functionIndex, bodyIR, relocStart,
               dataRelocStart, emission, resolvedCallTargets):
            bodylifecycle.BodyIrFunctionLifecycleReturnPrimaryPostRegallocBorrow(
                lifecycle)
            return PrimaryObjectPlanAbortStreamEmit(
                state, plan, bodyIR, sourceFunctionIndex,
                functionIndex, streamSnapshot, lifecycle, lifecycleBegun)
        if !PrimaryObjectPlanRecordRegallocProductionEvidence(
               plan, bodyIR, emission,
               state.functionIrIndexes[functionIndex],
               regart.RegallocProductionFunctionKindNormal):
            bodylifecycle.BodyIrFunctionLifecycleReturnPrimaryPostRegallocBorrow(
                lifecycle)
            PrimaryObjectPlanRecordStreamedBackpatchFailure(
                state, functionIndex,
                "regalloc_production_evidence_failed",
                emission.errorCode, emission.errorDetail, -1)
            return PrimaryObjectPlanAbortStreamEmit(
                state, plan, bodyIR, sourceFunctionIndex,
                functionIndex, streamSnapshot, lifecycle, lifecycleBegun)
    if emittedWordCount < 0:
        bodylifecycle.BodyIrFunctionLifecycleReturnPrimaryPostRegallocBorrow(
            lifecycle)
        PrimaryObjectPlanRecordStreamedBackpatchFailure(state,
                                                         functionIndex,
                                                         "stream_function_emit_failed",
                                                         -1,
                                                         -1,
                                                         -1)
        return PrimaryObjectPlanAbortStreamEmit(state,
                                                 plan,
                                                 bodyIR,
                                                 sourceFunctionIndex,
                                                 functionIndex,
                                                 streamSnapshot,
                                                 lifecycle,
                                                 lifecycleBegun)
    setLen(plan.instructionWords, functionBase + emittedWordCount)
    state.functionWordCounts[functionIndex] = emittedWordCount
    state.totalWordCount = functionBase + emittedWordCount
    if !PrimaryObjectPlanResolveStreamedRelocsForFunction(state,
                                                          functionIndex,
                                                          relocStart,
                                                          dataRelocStart):
        bodylifecycle.BodyIrFunctionLifecycleReturnPrimaryPostRegallocBorrow(
            lifecycle)
        return PrimaryObjectPlanAbortStreamEmit(state,
                                                 plan,
                                                 bodyIR,
                                                 sourceFunctionIndex,
                                                 functionIndex,
                                                 streamSnapshot,
                                                 lifecycle,
                                                 lifecycleBegun)
    let itemId = state.itemIds[functionIndex]
    var functionBranchRelocCoverage: bool[]
    if !PrimaryObjectPlanBuildFunctionBranchRelocCoverage(
           state, itemId, functionBase, emittedWordCount,
           relocStart, dataRelocStart,
           functionBranchRelocCoverage):
        PrimaryObjectPlanRecordStreamedBackpatchFailure(
            state, functionIndex,
            "stream_function_reloc_coverage_invalid",
            -1, -1, -1)
        return PrimaryObjectPlanAbortStreamEmit(
            state, plan, bodyIR, sourceFunctionIndex,
            functionIndex, streamSnapshot, lifecycle, lifecycleBegun)
    for wordIndex in functionBase..<(functionBase + emittedWordCount):
        if (plan.instructionWords[wordIndex] == 0 ||
            plan.instructionWords[wordIndex] == PrimaryObjectPlanBlSelfWord()) &&
           !functionBranchRelocCoverage[wordIndex - functionBase]:
            var failureKind = "unrelocated_call_bl"
            if plan.instructionWords[wordIndex] == 0:
                failureKind = "zero_instruction_word"
            PrimaryObjectPlanRecordStreamedBackpatchFailure(state,
                                                             functionIndex,
                                                             failureKind,
                                                             -1,
                                                             -1,
                                                             -1)
            state.bodySemanticsMissing = true
            if len(state.error.functionName) <= 0:
                state.error.functionName = state.symbolNames[functionIndex]
                state.error.functionSourcePath =
                    PrimaryObjectPlanFunctionSourcePathAt(lowering, sourceFunctionIndex)
                state.error.bodyKind = state.functionBodyKinds[functionIndex]
                state.error.wordOffset = functionBase
                state.error.wordRelOffset = wordIndex - functionBase
                state.error.wordCount = emittedWordCount
                if functionIndex < state.functionIrIndexes.len:
                    PrimaryObjectPlanCaptureErrorStatementTrace(state.error,
                                                                lowering,
                                                                state.functionIrIndexes[functionIndex])
                PrimaryObjectPlanCaptureBodyIrDetails(state.error.bodyIrDetail,
                                                      bodyIR)
                PrimaryObjectPlanCaptureBodyIrWordDetail(state.error.bodyIrDetail,
                                                         bodyIR,
                                                         state.error.wordRelOffset)
            PrimaryObjectPlanRecordErrorWithBody(state,
                                                 state.symbolNames[functionIndex],
                                                 state.error.functionSourcePath,
                                                 failureKind,
                                                 "",
                                                 0,
                                                 bodyIR)
            bodylifecycle.BodyIrFunctionLifecycleReturnPrimaryPostRegallocBorrow(
                lifecycle)
            return PrimaryObjectPlanAbortStreamEmit(state,
                                                     plan,
                                                     bodyIR,
                                                     sourceFunctionIndex,
                                                     functionIndex,
                                                     streamSnapshot,
                                                     lifecycle,
                                                     lifecycleBegun)
    bodylifecycle.BodyIrFunctionLifecycleReturnPrimaryPostRegallocBorrow(
        lifecycle)
    PrimaryObjectPlanReleaseStreamedBodyIr(
        state, bodyIR, sourceFunctionIndex,
        lifecycle, lifecycleBegun,
        bodylifecycle.BodyIrFunctionOutcomeEmitSuccess)
    # [MEM-RELIEF] Per-function lowering/emission allocates and then releases
    # the whole BodyIR plus regalloc/ledger transients.  Without a zone
    # pressure relief the freed spans stay dirty and the per-function
    # high-water mark accumulates across the stream.  Relief changes no
    # bytes/receipts, only the allocator's return of ownerless pages.
    let _streamEmitReleaseRelief = os.ProcessMemoryPressureRelief()
    return true

fn PrimaryObjectPlanBuildItemsPhase(state: var PrimaryObjectPlanPhaseState,
                                     linkPlan: var slplan.SystemLinkPlanStub,
                                     lowering: var lower.LoweringPlanStub,
                                     plan: var PrimaryObjectPlan) =
    if PrimaryObjectPlanDebugEnabled():
        PrimaryObjectPlanDebugLine(Fmt"build_items_enter functions={lowering.functionNames.len}")
    if !state.streamedEmitFirst:
        panic("primary single-function lifecycle requires decl-order stream")
    # #75(c): stream 分波 fork-join lower（波内并行 lower → 串行 emit/release）。
    # 全量一次 lower 会常驻全部 bodyIR 顶穿 RSS 护栏（dispatch_min 实测 8GB 杀）。
    # 波宽默认 jobs*16（上限 128），峰值 bodyIR 数受控。
    let lowerJobs = PrimaryObjectPlanLowerJobs()
    var useWaveParallelLower = false
    var waveReachList: int32[]
    var waveSize: int32 = 64
    var waveReachCursor: int32
    if state.streamedEmitFirst && lowerJobs > 1:
        useWaveParallelLower = true
        waveSize = lowerJobs * 16
        if waveSize < 32:
            waveSize = 32
        if waveSize > 128:
            waveSize = 128
        for ri in 0..<lowering.functionNames.len:
            if ri < state.reachable.len && state.reachable[ri]:
                add(waveReachList, ri)
    # Darwin arm64 production drops predictor offsets for call/data relocs. BuildItems appends call
    # identities; the final frozen emission appends exact data identities after regalloc/DCE. The
    # same declaration-loop iteration then resolves, checks and releases.
    let primaryBuildUseDeclOrderStream = true
    let primaryBuildUseCallBlEmitFirst = primaryBuildUseDeclOrderStream
    if primaryBuildUseDeclOrderStream:
        plan.instructionWords = []
        plan.bodyIRDodSoAAllOk = true
        state.streamedEmitFirst = true
        state.fillCheckReleasedBodyIrFunctionCount = 0
        state.fillCheckReleasedBodyIrPayloadItemCount = 0
        state.bodyIrLifecycleFunctionCount = 0
        state.bodyIrLifecycleAllocated = int64(0)
        state.bodyIrLifecycleReleased = int64(0)
        state.bodyIrLifecycleLive = int64(0)
        state.bodyIrLifecycleAllocatedBytes = int64(0)
        state.bodyIrLifecycleReleasedBytes = int64(0)
        state.bodyIrLifecycleLiveBytes = int64(0)
        state.bodyIrLifecycleOwnerTransferCount = int64(0)
        state.bodyIrLifecyclePhysicalBufferCount = int64(0)
        state.bodyIrLifecyclePhysicalFreeCount = int64(0)
        state.bodyIrLifecycleLedgerStorageReleasedSequenceCount = int64(0)
        state.bodyIrLifecycleLedgerStorageReleasedBufferCount = int64(0)
        state.bodyIrLifecycleLedgerStorageReleasedBytes = int64(0)
        state.bodyIrLifecycleAllClosed = true
        PrimaryBackpatchResetRelocRecords()
        primaryBackpatchActive = true
    var debugBuiltItemCount: int32
    for i in 0..<lowering.functionNames.len:
        if primaryBuildUseDeclOrderStream && state.bodySemanticsMissing:
            PrimaryObjectPlanMarkDeclOrderStreamBuildAbort(state,
                                                            i,
                                                            lowering.functionNames[i],
                                                            PrimaryObjectPlanFunctionSourcePathAt(lowering, i),
                                                            state.error.bodyKind)
            break
        if i >= state.reachable.len || !state.reachable[i]:
            continue
        if useWaveParallelLower:
            # 波起点：fork 并行 lower 本波 indexes，随后本循环串行 emit/release。
            if waveReachCursor % waveSize == 0:
                var waveIndexes: int32[]
                var waveEnd = waveReachCursor + waveSize
                if waveEnd > waveReachList.len:
                    waveEnd = waveReachList.len
                for wk in waveReachCursor..<waveEnd:
                    add(waveIndexes, waveReachList[wk])
                state.streamedEmitFirst = false
                state.streamReachabilityDiscovery = false
                PrimaryObjectPlanLoweringPhaseParallelIndexes(state,
                                                             lowering,
                                                             linkPlan.targetTriple,
                                                             linkPlan.emitKind,
                                                             lowerJobs,
                                                             waveIndexes)
                state.streamedEmitFirst = true
                if state.bodySemanticsMissing:
                    PrimaryObjectPlanMarkDeclOrderStreamBuildAbort(state,
                                                                    i,
                                                                    state.error.functionName,
                                                                    state.error.functionSourcePath,
                                                                    state.error.bodyKind)
                    break
            waveReachCursor = waveReachCursor + 1
        # An uninstantiated generic template (sizeof(T) unknown) has no standalone
        # object-code body — same invariant PrimaryObjectPlanLinkPhase's seed-root
        # loop already enforces (line ~59048: "Never seed it as an emit root").
        # The reachability frontier walk has several call-target-resolution arms
        # (bare-name / qualified / row-only) that mark a resolved target reachable
        # without that same exclusion, so a *qualified* reference to a seq builtin
        # family member (`seqs.Reserve(x, n)` etc.) that a concrete caller fully
        # consumes via inline lowering (PrimaryBodyIrAppendSeqReserveBuiltin and
        # siblings — no CallOp ever references the template symbol) still leaks the
        # raw template onto the frontier. Building its body then re-enters the same
        # inline-lowering arm with T unresolved (fails: no concrete elemSize),
        # falls to the generic call path, and empties the reloc
        # (body_ir_call_empty_reloc_target) for a body that was never supposed to
        # exist. Skip it here regardless of how it became reachable — this mirrors
        # the seed-root gate at the single point that actually decides whether a
        # body gets built, so no scattered reachability-marking site needs auditing
        # for completeness. A genuine unresolvable call to a template still bails —
        # honestly, at the real blocked caller — because that caller's own reloc
        # resolution finds no reachable concrete overload either.
        if PrimaryObjectPlanFunctionIsGenericTemplate(lowering, state.irIndexes[i]):
            continue
        PrimaryObjectPlanEnsureFunctionLowered(state,
                                               lowering,
                                               i,
                                               linkPlan.targetTriple,
                                               linkPlan.emitKind)
        if primaryBuildUseDeclOrderStream && state.bodySemanticsMissing:
            PrimaryObjectPlanMarkDeclOrderStreamBuildAbort(state,
                                                            i,
                                                            lowering.functionNames[i],
                                                            PrimaryObjectPlanFunctionSourcePathAt(lowering, i),
                                                            state.error.bodyKind)
            break
        debugBuiltItemCount = debugBuiltItemCount + 1
        if debugBuiltItemCount == 1 || debugBuiltItemCount % 32 == 0:
            if PrimaryObjectPlanDebugEnabled():
                PrimaryObjectPlanDebugLine(Fmt"build_items_progress built={debugBuiltItemCount} index={i}")
        var targetSymbols: str[]
        let irIndex = state.irIndexes[i]
        if irIndex < 0:
            state.bodySemanticsMissing = true
            PrimaryObjectPlanRecordError(state, lowering.functionNames[i], PrimaryObjectPlanFunctionSourcePathAt(lowering, i), "missing_primary_object_ir", "", 0)
            if len(state.error.functionName) <= 0:
                PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, i)
                state.error.bodyKind = "missing_primary_object_ir"
                state.error.typedIrKind = ""
                state.error.lineNumber = 0
            continue
        let irFunction = lowering.primaryObjectIr.functions[irIndex]
        # Owned local: irFunction.bodyKind is a field borrow; replace-state
        # rejects rebinding a borrow-carrying var across the special/x64 arms.
        var bodyKind = strings.CloneStr(irFunction.bodyKind)
        let specialBodyKind = PrimarySpecialExportBodyKindForFunction(lowering, i)
        if specialBodyKind != "":
            bodyKind = strings.CloneStr(specialBodyKind)
        if contract.CodegenBodyEmitUnit(linkPlan.targetTriple) == contract.CodegenUnitX64 &&
           !PrimaryBodyKindSupportedByX64Text(bodyKind):
            bodyKind = strings.CloneStr(texpr.BodyKindStatementSequence)
        var bodyIrCallCount: int32
        if i < state.tempBodyIRs.len:
            bodyIrCallCount = state.tempBodyIRs[i].callSequence.len
        if plan.exactFunctionRequested &&
           irFunction.typedFunctionIndex == plan.exactFunctionTypedFunctionIndex:
            plan.exactFunctionPrimaryMatchCount = plan.exactFunctionPrimaryMatchCount + 1
            if plan.exactFunctionPrimaryMatchCount == 1 &&
               i < state.tempBodyIRs.len:
                plan.exactFunctionBodyIrCapturedBeforeRelease = true
                plan.exactFunctionBodyIrOpCount = state.tempBodyIRs[i].ops.len
                plan.exactFunctionBodyIrTermCount = state.tempBodyIRs[i].terms.len
                plan.exactFunctionBodyIrBlockCount = state.tempBodyIRs[i].blocks.len
                plan.exactFunctionBodyIrLocalSlotCount = state.tempBodyIRs[i].localSlots.len
            elif plan.exactFunctionPrimaryMatchCount > 1:
                plan.exactFunctionBodyIrCapturedBeforeRelease = false
                plan.exactFunctionBodyIrOpCount = 0
                plan.exactFunctionBodyIrTermCount = 0
                plan.exactFunctionBodyIrBlockCount = 0
                plan.exactFunctionBodyIrLocalSlotCount = 0
        if i == 0:
            if PrimaryObjectPlanDebugEnabled():
                PrimaryObjectPlanDebugLine(Fmt"build_i0 body_kind={bodyKind} body_ir_calls={bodyIrCallCount} lowering_calls={irFunction.callTargets.len} has_reloc={PrimaryObjectIrFunctionHasRelocCallTarget(irFunction)}")
            var debugCallLimit = irFunction.callTargets.len
            if debugCallLimit > 8:
                debugCallLimit = 8
            for debugCallIndex in 0..<debugCallLimit:
                var debugImportcFlag: bool
                var debugImportcSymbol = ""
                if debugCallIndex < irFunction.callTargetImportcFlags.len:
                    debugImportcFlag = irFunction.callTargetImportcFlags[debugCallIndex]
                if debugCallIndex < irFunction.callImportcSymbols.len:
                    debugImportcSymbol = irFunction.callImportcSymbols[debugCallIndex]
                if PrimaryObjectPlanDebugEnabled():
                    PrimaryObjectPlanDebugLine(Fmt"build_i0_call index={debugCallIndex} target={irFunction.callTargets[debugCallIndex]} builtin={PrimaryObjectCallTargetIsBuiltin(irFunction.callTargets[debugCallIndex])} importc_flag={debugImportcFlag} importc_symbol={debugImportcSymbol}")
        if PrimaryCallSequenceNeedsRelocForIrFunction(bodyKind, bodyIrCallCount, irFunction):
            var callSequenceReady = true
            var requiredCallCount = PrimaryCallSequenceRequiredCallCount(bodyKind,
                                                                           bodyIrCallCount,
                                                                           irFunction.callTargets.len)
            var primaryColdCond38: bool
            var primaryColdCond38Clause0: bool
            if bodyIrCallCount <= 0:
                if irFunction.callTargets.len < requiredCallCount:
                    primaryColdCond38Clause0 = true
            if primaryColdCond38Clause0:
                primaryColdCond38 = true
            if primaryColdCond38:
                callSequenceReady = false
                state.bodySemanticsMissing = true
                PrimaryObjectPlanRecordError(state, lowering.functionNames[i], PrimaryObjectPlanFunctionSourcePathAt(lowering, i), "missing_call_sequence", "", PrimaryObjectMissingLineNumber(lowering, irIndex))
                if len(state.error.functionName) <= 0:
                    PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, i)
                    state.error.bodyKind = "missing_call_sequence"
                    state.error.typedIrKind = ""
                    state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
            if irFunction.callArgCounts.len != irFunction.callTargets.len ||
               irFunction.callTargetSourcePaths.len != irFunction.callTargets.len ||
               irFunction.callTargetSignatureLineNumbers.len !=
                   irFunction.callTargets.len ||
               irFunction.callTargetImportcFlags.len != irFunction.callTargets.len ||
               irFunction.callImportcSymbols.len != irFunction.callTargets.len:
                callSequenceReady = false
                state.bodySemanticsMissing = true
                PrimaryObjectPlanRecordError(state, lowering.functionNames[i], PrimaryObjectPlanFunctionSourcePathAt(lowering, i), "missing_call_sequence", "", PrimaryObjectMissingLineNumber(lowering, irIndex))
                if len(state.error.functionName) <= 0:
                    PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, i)
                    state.error.bodyKind = "missing_call_sequence"
                    state.error.typedIrKind = ""
                    state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
            if callSequenceReady:
                var sourceOrdinal: int32
                for callOrdinal in 0..<requiredCallCount:
                    var targetSymbol = ""
                    if bodyIrCallCount > 0:
                        if callOrdinal >= state.tempBodyIRs[i].callSequence.len:
                            callSequenceReady = false
                            state.bodySemanticsMissing = true
                            PrimaryObjectPlanRecordError(state, lowering.functionNames[i], PrimaryObjectPlanFunctionSourcePathAt(lowering, i), "body_ir_call_sequence_drift", Fmt"actual=<missing>;expected_index={sourceOrdinal}", PrimaryObjectMissingLineNumber(lowering, irIndex))
                            if len(state.error.functionName) <= 0:
                                PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, i)
                                state.error.bodyKind = "body_ir_call_sequence_drift"
                                state.error.typedIrKind = ""
                                state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                                state.error.callTargetOrdinal = callOrdinal
                                state.error.callTarget = Fmt"actual=<missing>;expected_index={sourceOrdinal};body_ir_calls={bodyIrCallCount};lowering_calls={irFunction.callTargets.len}"
                                break
                        let bodyIrCall = state.tempBodyIRs[i].callSequence[callOrdinal]
                        # Read scalar provenance first. Reloc/CloneStr of managed
                        # fields consume this local CallOp copy; do not pass it
                        # after those calls.
                        if PrimaryCallOpWholeCallF64FromIntRescue(bodyIrCall) &&
                           PrimaryCallOpInlineF64FromIntKind(bodyIrCall,
                                                              state.tempBodyIRs[i]) > 0:
                            continue
                        let callSeqSym = PrimaryBodyIrRelocCallTargetSymbol(
                            bodyIrCall.targetSymbol)
                        let bodyIrTargetSourcePath = bodyIrCall.targetSourcePath
                        while sourceOrdinal < irFunction.callTargets.len:
                            let expectedBuiltinTarget = irFunction.callTargets[sourceOrdinal]
                            if !PrimaryObjectCallTargetIsBuiltin(expectedBuiltinTarget):
                                break
                            if PrimaryObjectBuiltinCallMatchesActual(callSeqSym,
                                                                     expectedBuiltinTarget):
                                break
                            sourceOrdinal = sourceOrdinal + 1
                        if PrimaryObjectCallTargetIsBuiltin(callSeqSym):
                            if sourceOrdinal < irFunction.callTargets.len &&
                               PrimaryObjectBuiltinCallMatchesActual(callSeqSym,
                                                                     irFunction.callTargets[sourceOrdinal]):
                                sourceOrdinal = sourceOrdinal + 1
                            continue
                        if PrimaryBodyIrIndirectCallIntrinsic(callSeqSym):
                            if sourceOrdinal < irFunction.callTargets.len &&
                               irFunction.callTargets[sourceOrdinal] == callSeqSym:
                                sourceOrdinal = sourceOrdinal + 1
                            continue
                        var actualSourceOrdinal = sourceOrdinal
                        let matchedSourceOrdinal = PrimaryObjectCallTargetOrdinalForActual(irFunction,
                                                                                           callSeqSym,
                                                                                           sourceOrdinal)
                        if matchedSourceOrdinal >= 0:
                            actualSourceOrdinal = matchedSourceOrdinal
                        if PrimaryBodyIrDirectExternalCallTarget(callSeqSym):
                            targetSymbol = PrimaryTargetSymbolName(linkPlan.targetTriple,
                                                                   callSeqSym)
                            if actualSourceOrdinal < irFunction.callImportcSymbols.len:
                                let importcSym = irFunction.callImportcSymbols[actualSourceOrdinal]
                                if importcSym == callSeqSym && actualSourceOrdinal >= sourceOrdinal:
                                    sourceOrdinal = actualSourceOrdinal + 1
                                elif len(importcSym) > 0 && actualSourceOrdinal >= sourceOrdinal:
                                    # Name mismatch (Cheng alias vs C symbol). Align by position.
                                    sourceOrdinal = actualSourceOrdinal + 1
                        elif matchedSourceOrdinal >= 0 &&
                           actualSourceOrdinal < irFunction.callTargetImportcFlags.len &&
                           irFunction.callTargetImportcFlags[actualSourceOrdinal] &&
                           actualSourceOrdinal < irFunction.callImportcSymbols.len:
                            targetSymbol = PrimaryTargetSymbolName(linkPlan.targetTriple,
                                                                   irFunction.callImportcSymbols[actualSourceOrdinal])
                            if actualSourceOrdinal >= sourceOrdinal:
                                sourceOrdinal = actualSourceOrdinal + 1
                        elif len(callSeqSym) > 0:
                            if PrimaryObjectCallTargetIsBuiltin(callSeqSym):
                                if actualSourceOrdinal >= sourceOrdinal:
                                    sourceOrdinal = actualSourceOrdinal + 1
                                continue
                            # Zero-arg aggregate constructor `Type()` / `mod.Type()`: no function body,
                            # no relocation; consume the call op and skip resolution (mirrors
                            # reachability/birc loops and the text path). Check both the matched row and
                            # the actual call-seq symbol so qualified ctor names with no matching row
                            # (e.g. `parser.NormalizedExprLayer`) are also skipped. Named field
                            # constructors emit no call op.
                            if PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr,
                                                                           irFunction.sourcePath,
                                                                           callSeqSym) ||
                               (actualSourceOrdinal < irFunction.callTargets.len &&
                                PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr,
                                                                            irFunction.sourcePath,
                                                                            irFunction.callTargets[actualSourceOrdinal])):
                                if actualSourceOrdinal >= sourceOrdinal:
                                    sourceOrdinal = actualSourceOrdinal + 1
                                continue
                            var callTargetSourcePath = bodyIrTargetSourcePath
                            let importcTargetSymbol =
                                texpr.TypedExprIrLookupImportcTargetSymbol(
                                    lowering.typedIr,
                                    callTargetSourcePath,
                                    callSeqSym)
                            if importcTargetSymbol != "":
                                targetSymbol = PrimaryTargetSymbolName(linkPlan.targetTriple,
                                                                       importcTargetSymbol)
                                if actualSourceOrdinal >= sourceOrdinal:
                                    sourceOrdinal = actualSourceOrdinal + 1
                            else:
                                var targetIndex: int32
                                targetIndex = PrimaryPlanSymbolRowFromTempBodyIrCall(
                                    state, i, callOrdinal)
                                if targetIndex < 0 &&
                                   actualSourceOrdinal >= 0 &&
                                   actualSourceOrdinal <
                                       irFunction.callTargetTypedFunctionIndexes.len:
                                    targetIndex =
                                        PrimaryPlanSymbolRowForTypedFunctionIndex(
                                            state,
                                            irFunction.callTargetTypedFunctionIndexes[
                                                actualSourceOrdinal])
                                if targetIndex < 0 &&
                                   i < state.tempBodyIRs.len &&
                                   callOrdinal <
                                       state.tempBodyIRs[i].callSequence.len:
                                    let callNode =
                                        state.tempBodyIRs[i].callSequence[
                                            callOrdinal].semanticCallExprNodeIndex
                                    let snapshotCallId =
                                        lower.LoweringPlanSnapshotCallIdForTypedIrNodeIndex(
                                            lowering, callNode)
                                    if snapshotCallId >= 0:
                                        targetIndex =
                                            PrimaryPlanSymbolRowForTypedFunctionIndex(
                                                state,
                                                lower.LoweringPlanSnapshotCallTargetTypedFunctionIndexAt(
                                                    lowering, snapshotCallId))
                                if targetIndex < 0:
                                    var resolveSourcePath = callTargetSourcePath
                                    if resolveSourcePath.len <= 0 &&
                                       actualSourceOrdinal >= 0 &&
                                       actualSourceOrdinal <
                                           irFunction.callTargetSourcePaths.len:
                                        resolveSourcePath =
                                            irFunction.callTargetSourcePaths[
                                                actualSourceOrdinal]
                                    targetIndex = PrimaryObjectPlanResolveCallTargetIndex(lowering,
                                                                                          irIndex,
                                                                                          actualSourceOrdinal,
                                                                                          irFunction.sourcePath,
                                                                                          resolveSourcePath,
                                                                                          callSeqSym)
                                if targetIndex < 0:
                                    targetIndex = PrimaryPlanUniqueReachableTailRow(
                                        state, lowering, callSeqSym)
                                if targetIndex < 0:
                                    targetIndex = PrimaryPlanUniqueFunctionTailRow(
                                        lowering, callSeqSym)
                                if targetIndex >= 0 &&
                                   targetIndex < state.allSymbolNames.len &&
                                   targetIndex < state.reachable.len &&
                                   state.reachable[targetIndex]:
                                    targetSymbol = state.allSymbolNames[targetIndex]
                                if targetIndex >= 0 &&
                                   targetIndex < state.allSymbolNames.len &&
                                   targetIndex < state.reachable.len &&
                                   state.reachable[targetIndex]:
                                    targetSymbol = state.allSymbolNames[targetIndex]
                                else:
                                    callSequenceReady = false
                                    state.bodySemanticsMissing = true
                                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                        var patchTargetsText = ""
                                        for ptIndex in 0..<irFunction.callTargets.len:
                                            patchTargetsText = Fmt"{patchTargetsText}|{irFunction.callTargets[ptIndex]}"
                                        os.WriteLine(os.GetStderr(),
                                                     Fmt"phase=missing_call_target_patch_ctx function={lowering.functionNames[i]} call_ordinal={callOrdinal} source_ordinal={sourceOrdinal} actual_source_ordinal={actualSourceOrdinal} call_seq_sym={callSeqSym} target_index={targetIndex} row_targets={patchTargetsText}")
                                    PrimaryObjectPlanRecordError(state, lowering.functionNames[i], PrimaryObjectPlanFunctionSourcePathAt(lowering, i), "missing_call_target", callSeqSym, PrimaryObjectMissingLineNumber(lowering, irIndex))
                                    if len(state.error.functionName) <= 0:
                                        PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, i)
                                        state.error.bodyKind = "missing_call_target"
                                        state.error.typedIrKind = ""
                                        state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                                        state.error.callTargetOrdinal = callOrdinal
                                        state.error.callTarget = callSeqSym
                                        state.error.callTargetSourcePath = callTargetSourcePath
                                        PrimaryObjectPlanFillMissingCallTargetDiagnostic(state.error,
                                                                                         lowering,
                                                                                         i,
                                                                                         strings.CloneStr(state.error.callTarget))
                                    break
                                if actualSourceOrdinal >= sourceOrdinal:
                                    sourceOrdinal = actualSourceOrdinal + 1
                        else:
                            callSequenceReady = false
                            state.bodySemanticsMissing = true
                            PrimaryObjectPlanRecordError(state, lowering.functionNames[i], PrimaryObjectPlanFunctionSourcePathAt(lowering, i), "missing_call_target", "", PrimaryObjectMissingLineNumber(lowering, irIndex))
                            if len(state.error.functionName) <= 0:
                                PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, i)
                                state.error.bodyKind = "missing_call_target"
                                state.error.typedIrKind = ""
                                state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                                state.error.callTargetOrdinal = callOrdinal
                            break
                    elif callOrdinal < irFunction.callTargetImportcFlags.len && irFunction.callTargetImportcFlags[callOrdinal]:
                        if callOrdinal >= irFunction.callImportcSymbols.len:
                            callSequenceReady = false
                            state.bodySemanticsMissing = true
                            PrimaryObjectPlanRecordError(state, lowering.functionNames[i], PrimaryObjectPlanFunctionSourcePathAt(lowering, i), "missing_call_sequence", "", PrimaryObjectMissingLineNumber(lowering, irIndex))
                            if len(state.error.functionName) <= 0:
                                PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, i)
                                state.error.bodyKind = "missing_call_sequence"
                                state.error.typedIrKind = ""
                                state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                            break
                        targetSymbol = PrimaryTargetSymbolName(linkPlan.targetTriple,
                                                               irFunction.callImportcSymbols[callOrdinal])
                    else:
                        if callOrdinal < irFunction.callTargets.len &&
                           PrimaryObjectCallTargetIsBuiltin(irFunction.callTargets[callOrdinal]):
                            continue
                        # bail=0 C3: 命名字段聚合构造器行（含 alias-to-seq 头，如
                        # `hashMap_seq_int32(len: ...)`）经 AppendAggregateConstructorToSlot
                        # 就地物化、body-IR 无 call op（bodyIrCallCount==0），该行不被任何
                        # BL 消费。其余三处 call-sequence 走查（reachability 行走查 / birc
                        # 行走查 / bodyIrCallCount>0 臂）已有同款豁免，唯独此 else 臂漏配
                        # → 构造头被当调用目标解析、无同名 fn → missing_call_target。
                        if callOrdinal < irFunction.callTargets.len &&
                           PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr,
                                                                       irFunction.sourcePath,
                                                                       irFunction.callTargets[callOrdinal]):
                            continue
                        var resolvedCallTargetSourcePath =
                            PrimaryObjectCallTargetSourcePath(irFunction,
                                                              callOrdinal)
                        var targetIndex: int32
                        targetIndex = PrimaryPlanSymbolRowFromTempBodyIrCall(
                            state, i, callOrdinal)
                        if targetIndex < 0 &&
                           callOrdinal >= 0 &&
                           callOrdinal <
                               irFunction.callTargetTypedFunctionIndexes.len:
                            targetIndex =
                                PrimaryPlanSymbolRowForTypedFunctionIndex(
                                    state,
                                    irFunction.callTargetTypedFunctionIndexes[
                                        callOrdinal])
                        if targetIndex < 0:
                            targetIndex = PrimaryObjectPlanResolveCallTargetIndex(lowering,
                                                                                  irIndex,
                                                                                  callOrdinal,
                                                                                  irFunction.sourcePath,
                                                                                  resolvedCallTargetSourcePath,
                                                                                  irFunction.callTargets[callOrdinal])
                        if targetIndex < 0 &&
                           callOrdinal < irFunction.callTargets.len:
                            targetIndex = PrimaryPlanUniqueReachableTailRow(
                                state,
                                lowering,
                                irFunction.callTargets[callOrdinal])
                        if targetIndex < 0 &&
                           callOrdinal < irFunction.callTargets.len:
                            targetIndex = PrimaryPlanUniqueFunctionTailRow(
                                lowering,
                                irFunction.callTargets[callOrdinal])
                        if targetIndex >= 0 &&
                           targetIndex < state.allSymbolNames.len &&
                           targetIndex < state.reachable.len &&
                           state.reachable[targetIndex]:
                            targetSymbol = state.allSymbolNames[targetIndex]
                        else:
                            callSequenceReady = false
                            state.bodySemanticsMissing = true
                            # 报告层缺陷: 本分支下方 (state.error.callTarget 单槽,
                            # 仅首个 error 拿到) 已有 irFunction.callTargets[callOrdinal]
                            # 真值可用, 但此前 RecordError 的 reasonDetail 硬编码 "",
                            # 致 errors[] 全量列表该行永远拿不到这个已知调用目标名 ——
                            # 与 :62373 的姊妹分支 (callSeqSym 直接传入) 不对称。先算好
                            # 同一真值再传, errors[] 与单槽诊断口径统一。
                            var missingCallTargetDetail = ""
                            if callOrdinal < irFunction.callTargets.len:
                                missingCallTargetDetail = irFunction.callTargets[callOrdinal]
                            PrimaryObjectPlanRecordError(state, lowering.functionNames[i], PrimaryObjectPlanFunctionSourcePathAt(lowering, i), "missing_call_target", missingCallTargetDetail, PrimaryObjectMissingLineNumber(lowering, irIndex))
                            if len(state.error.functionName) <= 0:
                                PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, i)
                                state.error.bodyKind = "missing_call_target"
                                state.error.typedIrKind = ""
                                state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                                state.error.callTargetOrdinal = callOrdinal
                                if callOrdinal < irFunction.callTargets.len:
                                    state.error.callTarget = irFunction.callTargets[callOrdinal]
                                state.error.callTargetSourcePath = resolvedCallTargetSourcePath
                                PrimaryObjectPlanFillMissingCallTargetDiagnostic(state.error,
                                                                                 lowering,
                                                                                 i,
                                                                                 strings.CloneStr(state.error.callTarget))
                            break
                    add(targetSymbols, targetSymbol)
            if !callSequenceReady:
                continue
        var wordCount = state.wordCounts[i]
        var hasProductionRegallocBody: bool
        if primaryBuildUseDeclOrderStream &&
           PrimaryObjectPlanBodyIrReady(state, i):
            hasProductionRegallocBody = true
            if wordCount < 0:
                wordCount = 0
        if wordCount <= 0 && !hasProductionRegallocBody:
            state.bodySemanticsMissing = true
            let nodePathStrictMode = PrimaryNodePathStrictMode()
            if nodePathStrictMode != "" && i < state.tempBodyIRs.len:
                PrimaryNodePathStrictReport(state.tempBodyIRs[i],
                                            irFunction,
                                            bodyKind,
                                            nodePathStrictMode)
            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                var wczOpKind: int32
                var wczOpLine: int32
                var wczOpDetail0: int32
                var wczOpDetail1: int32
                var wczOpDetail2: int32
                var wczOpIndex: int32
                wczOpKind = -1
                wczOpLine = -1
                wczOpIndex = -1
                if i < state.tempBodyIRs.len:
                    for wczI in 0..<state.tempBodyIRs[i].ops.len:
                        if PrimaryBodyIROpSizeAt(state.tempBodyIRs[i], wczI) <= 0:
                            wczOpIndex = wczI
                            wczOpKind = state.tempBodyIRs[i].ops[wczI].kind
                            wczOpLine = state.tempBodyIRs[i].ops[wczI].target
                            if state.tempBodyIRs[i].ops[wczI].operands.len > 0:
                                wczOpDetail0 = state.tempBodyIRs[i].ops[wczI].operands[0]
                            if state.tempBodyIRs[i].ops[wczI].operands.len > 1:
                                wczOpDetail1 = state.tempBodyIRs[i].ops[wczI].operands[1]
                            if state.tempBodyIRs[i].ops[wczI].operands.len > 2:
                                wczOpDetail2 = state.tempBodyIRs[i].ops[wczI].operands[2]
                            break
                os.WriteLine(os.GetStderr(), strutil.Join(["phase=build_word_count_zero function=",
                                                           share(irFunction.functionName),
                                                           " source=",
                                                           share(irFunction.sourcePath),
                                                           " index=",
                                                           strings.IntToStr(i),
                                                           " body_kind=",
                                                           share(bodyKind),
                                                           " statements=",
                                                           strings.IntToStr(irFunction.statements.len),
                                                           " zero_op_index=",
                                                           strings.IntToStr(wczOpIndex),
                                                           " zero_op_kind=",
                                                           strings.IntToStr(wczOpKind),
                                                           " zero_op_line=",
                                                           strings.IntToStr(wczOpLine),
                                                           " zero_op_d0=",
                                                           strings.IntToStr(wczOpDetail0),
                                                           " zero_op_d1=",
                                                           strings.IntToStr(wczOpDetail1),
                                                           " zero_op_d2=",
                                                           strings.IntToStr(wczOpDetail2)], ""))
            if i < state.tempBodyIRs.len:
                PrimaryObjectPlanRecordErrorWithBody(state, lowering.functionNames[i], PrimaryObjectPlanFunctionSourcePathAt(lowering, i), bodyKind, "", PrimaryObjectMissingLineNumber(lowering, irIndex), state.tempBodyIRs[i])
            else:
                PrimaryObjectPlanRecordError(state, lowering.functionNames[i], PrimaryObjectPlanFunctionSourcePathAt(lowering, i), bodyKind, "", PrimaryObjectMissingLineNumber(lowering, irIndex))
            if len(state.error.functionName) <= 0:
                PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, i)
                state.error.bodyKind = bodyKind
                state.error.typedIrKind = PrimaryObjectMissingTypedIrKind(lowering, irIndex)
                state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                PrimaryObjectPlanCaptureErrorStatementTrace(state.error, lowering, irIndex)
                if i < state.tempBodyIRs.len:
                    PrimaryObjectPlanCaptureBodyIrDetails(state.error.bodyIrDetail, state.tempBodyIRs[i])
            continue
        if PrimaryCallSequenceNeedsRelocForIrFunction(bodyKind, bodyIrCallCount, irFunction):
            var requiredCallCount = PrimaryCallSequenceRequiredCallCount(bodyKind,
                                                                           bodyIrCallCount,
                                                                           targetSymbols.len)
            if bodyIrCallCount <= 0 && targetSymbols.len < requiredCallCount:
                state.bodySemanticsMissing = true
                PrimaryObjectPlanRecordError(state, lowering.functionNames[i], PrimaryObjectPlanFunctionSourcePathAt(lowering, i), "missing_call_sequence", "", PrimaryObjectMissingLineNumber(lowering, irIndex))
                if len(state.error.functionName) <= 0:
                    PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, i)
                    state.error.bodyKind = "missing_call_sequence"
                    state.error.typedIrKind = ""
                    state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                continue
        if primaryBuildUseDeclOrderStream && state.bodySemanticsMissing:
            PrimaryObjectPlanMarkDeclOrderStreamBuildAbort(state,
                                                            i,
                                                            lowering.functionNames[i],
                                                            PrimaryObjectPlanFunctionSourcePathAt(lowering, i),
                                                            state.error.bodyKind)
            break
        let buildItemSnapshot = PrimaryObjectPlanBuildItemSnapshotCapture(state)
        let itemId = int32(100000 + i)
        let wordOffset = state.totalWordCount
        add(state.itemIds, itemId)
        add(state.symbolNames, share(state.allSymbolNames[i]))
        if i >= lowering.functionTypedIrIndexes.len ||
           i >= lowering.functionNameIds.len ||
           i >= state.allSymbolRoles.len:
            panic("primary object: emitted symbol identity row missing")
        add(state.symbolTypedFunctionIndexes,
            lowering.functionTypedIrIndexes[i])
        add(state.symbolNameIds, lowering.functionNameIds[i])
        add(state.symbolRoles, state.allSymbolRoles[i])
        var symbolInterfaceCid: layout.FixedBytes32
        if !lower.LoweringPlanFunctionInterfaceCidAt(
               lowering,
               lowering.functionTypedIrIndexes[i],
               symbolInterfaceCid):
            panic("primary object: emitted symbol interface identity missing")
        add(state.symbolInterfaceCids,
            layout.FixedBytes32Copy(symbolInterfaceCid))
        add(state.functionWordOffsets, wordOffset)
        add(state.functionWordCounts, wordCount)
        var planBodyKind = PrimaryPlanBodyKind(bodyKind)
        if i < state.tempBodyIRs.len:
            if state.tempBodyIRs[i].ops.len > 0 || state.tempBodyIRs[i].terms.len > 0:
                planBodyKind = texpr.BodyKindStatementSequence
        add(state.functionBodyKinds, planBodyKind)
        add(state.functionInstructionBodyKinds, share(bodyKind))
        add(state.functionStatementReturnModes, PrimaryStatementSequenceReturnMode(bodyKind))
        add(state.functionStatementReturnI32Values, PrimaryStatementSequenceI32Value(bodyKind))
        add(state.functionStatementCallCounts, irFunction.callTargets.len)
        add(state.functionIrIndexes, irIndex)
        var retainedBodyIR = PrimaryBodyIRTakeFromTable(state.tempBodyIRs, i)
        PrimaryBodyIrAppendGlobalDataLabels(retainedBodyIR,
                                            lowering.typedIr,
                                            linkPlan.targetTriple,
                                            state.dataLabels,
                                            state.dataPayloadTexts,
                                            state.dataPayloadRawByteCounts)
        if retainedBodyIR.cstringLiterals.len > 0:
            PrimaryBodyIrAppendCStringDataLabels(retainedBodyIR,
                                                 strings.CloneStr(state.allSymbolNames[i]),
                                                 state.dataLabels,
                                                 state.dataPayloadTexts,
                                                 state.dataPayloadRawBytes,
                                                 state.dataPayloadRawByteCounts)
        # Decl-order production emission owns the exact frozen instruction
        # stream. Its structural data-reloc rows are appended from that stream
        # after regalloc/DCE; pre-harvesting BodyIR ops would retain dead rows
        # and can miss new live address-producing shapes.
        if !primaryBuildUseDeclOrderStream:
            PrimaryBodyIrAppendCStringArgRelocs(retainedBodyIR,
                                                itemId,
                                                wordOffset,
                                                linkPlan.targetTriple,
                                                strings.CloneStr(state.allSymbolNames[i]),
                                                state.allSymbolNames,
                                                primaryBuildUseCallBlEmitFirst,
                                                state.dataRelocSourceItemIds,
                                                state.dataRelocWordOffsets,
                                                state.dataRelocPredictedKey,
                                                state.dataRelocOpIndex,
                                                state.dataRelocSubIndex,
                                                state.dataRelocTargetSymbols)
            PrimaryBodyIrAppendGlobalOpRelocs(retainedBodyIR,
                                              itemId,
                                              wordOffset,
                                              linkPlan.targetTriple,
                                              state.allSymbolNames,
                                              primaryBuildUseCallBlEmitFirst,
                                              state.dataRelocSourceItemIds,
                                              state.dataRelocWordOffsets,
                                              state.dataRelocPredictedKey,
                                              state.dataRelocOpIndex,
                                              state.dataRelocSubIndex,
                                              state.dataRelocTargetSymbols)
        if bodyKind == texpr.BodyKindRuntimeSetCmdLine ||
           bodyKind == texpr.BodyKindRuntimeParamCount ||
           bodyKind == texpr.BodyKindRuntimeParamStrCopyBridge:
            state.needsRuntimeCommandData = true
        var primaryColdCond39: bool
        var primaryColdCond39Clause0: bool
        var hasBodyIrRelocOwner: bool
        if retainedBodyIR.ops.len > 0 ||
           retainedBodyIR.terms.len > 0 ||
           retainedBodyIR.callSequence.len > 0:
            hasBodyIrRelocOwner = true
        if bodyIrCallCount <= 0 && !hasBodyIrRelocOwner:
            if PrimaryCallSequenceNeedsRelocForIrFunction(bodyKind, bodyIrCallCount, irFunction):
                primaryColdCond39Clause0 = true
        if primaryColdCond39Clause0:
            primaryColdCond39 = true
        # segment-b: these cold non-BodyIR template functions are SKIPPED by the x86
        # BodyIR reloc consumer (which reads relocWordOffsets as byte offsets), but the
        # list must stay homogeneous so the consumer's function attribution scan is not
        # tripped by a stray word value falling inside a BodyIR function's byte range.
        # x86 stores these at the function's byte base (wordOffset×4); arm64 unchanged.
        var relocFnBase = wordOffset
        if contract.CodegenBodyEmitUnit(linkPlan.targetTriple) == contract.CodegenUnitX64:
            relocFnBase = wordOffset * 4
        if primaryColdCond39:
            var relocWordOffset = relocFnBase
            if PrimaryIsLetCallNoargReturnI32ConstBodyKind(bodyKind):
                relocWordOffset = relocFnBase + 2
            elif bodyKind == texpr.BodyKindBackendDriverRunCommand:
                relocWordOffset = relocFnBase + 2
            add(state.relocSourceItemIds, itemId)
            add(state.relocWordOffsets, relocWordOffset)
            add(state.relocTargetSymbols, share(targetSymbols[0]))
            add(state.relocCallOrdinal, -1)
            primaryObjectPlanAppendInvalidCallRelocIdentity(state)
            if bodyKind == texpr.BodyKindBackendDriverRunCommand:
                add(state.relocSourceItemIds, itemId)
                add(state.relocWordOffsets, relocFnBase + 5)
                add(state.relocTargetSymbols, share(targetSymbols[1]))
                add(state.relocCallOrdinal, -1)
                primaryObjectPlanAppendInvalidCallRelocIdentity(state)
                add(state.relocSourceItemIds, itemId)
                add(state.relocWordOffsets, relocFnBase + 13)
                add(state.relocTargetSymbols, share(targetSymbols[2]))
                add(state.relocCallOrdinal, -1)
                primaryObjectPlanAppendInvalidCallRelocIdentity(state)
                add(state.relocSourceItemIds, itemId)
                add(state.relocWordOffsets, relocFnBase + 15)
                add(state.relocTargetSymbols, share(targetSymbols[3]))
                add(state.relocCallOrdinal, -1)
                primaryObjectPlanAppendInvalidCallRelocIdentity(state)
        elif bodyKind == texpr.BodyKindCstringToStrCopy:
            add(state.relocSourceItemIds, itemId)
            add(state.relocWordOffsets, relocFnBase + 5)
            add(state.relocTargetSymbols, PrimaryTargetSymbolName(linkPlan.targetTriple, "cheng_cstrlen"))
            add(state.relocCallOrdinal, -1)
            primaryObjectPlanAppendInvalidCallRelocIdentity(state)
            add(state.relocSourceItemIds, itemId)
            add(state.relocWordOffsets, relocFnBase + 11)
            add(state.relocTargetSymbols, PrimaryTargetSymbolName(linkPlan.targetTriple, "driver_c_new_string_copy_n"))
            add(state.relocCallOrdinal, -1)
            primaryObjectPlanAppendInvalidCallRelocIdentity(state)
        elif bodyKind == texpr.BodyKindRuntimeParamStrCopyBridge:
            add(state.relocSourceItemIds, itemId)
            add(state.relocWordOffsets, relocFnBase + 18)
            add(state.relocTargetSymbols, PrimaryTargetSymbolName(linkPlan.targetTriple, "strlen"))
            add(state.relocCallOrdinal, -1)
            primaryObjectPlanAppendInvalidCallRelocIdentity(state)
        let birc = retainedBodyIR.callSequence.len
        if birc > 0:
            var bircTargetSymbols: str[]
            # No positional verbatim copy: body-ir synthesized calls
            # (zero-init setMem etc.) shift the sequence relative to the
            # lowering call list, so every entry resolves by name.
            var bircUseVerbatim = false
            if bircUseVerbatim:
                bircTargetSymbols = targetSymbols
            else:
                var sourceOrdinal: int32
                for co in 0..<birc:
                    # #95 wave5 根修 (bircTargetSymbols 构造收尾, provenance
                    # 门): float64(intExpr) 整句 RHS/return/call-arg 形态
                    # (PrimaryBodyIrAppendWholeCallExprToSlot 的 int->float64
                    # SCVTF/UCVTF 内联 rescue)合成的 CallOp, targetSymbol=
                    # "float64" 从未在 lowering-plan 阶段登记进
                    # irFunction.callTargets——不为它补登记行, 而是复用下方
                    # reloc-emit 循环已经验证过的同一 provenance 判据在这里也
                    # 豁免符号解析: 只认本 rescue 分支自己打的
                    # wholeCallF64FromIntRescue 标记, 不看多义的
                    # inlineF64FromIntKind 原值——避免豁免既有无关的
                    # PrimaryBodyIrAppendCallOp 通用路径构造出的、真正需要 BL 的
                    # 同名调用(wave4 REFUTED finding 1)。空占位与下方内建/间接
                    # intrinsic 分支同款, 下面的 reloc-emit 循环会在消费前先
                    # continue 跳过, 不读这个空字符串。
                    let bodyIrCall = retainedBodyIR.callSequence[co]
                    if PrimaryCallOpWholeCallF64FromIntRescue(bodyIrCall) &&
                       PrimaryCallOpInlineF64FromIntKind(bodyIrCall,
                                                          retainedBodyIR) > 0:
                        add(bircTargetSymbols, "")
                        continue
                    var sym = PrimaryBodyIrRelocCallTargetSymbol(bodyIrCall.targetSymbol)
                    let bodyIrTargetSourcePath = bodyIrCall.targetSourcePath
                    var symResolved = false
                    var resolvedCallTargetSourcePath = ""
                    while sourceOrdinal < irFunction.callTargets.len:
                        let expectedBuiltinTarget = irFunction.callTargets[sourceOrdinal]
                        if !PrimaryObjectCallTargetIsBuiltin(expectedBuiltinTarget):
                            break
                        if PrimaryObjectBuiltinCallMatchesActual(sym,
                                                                 expectedBuiltinTarget):
                            break
                        sourceOrdinal = sourceOrdinal + 1
                    var actualSourceOrdinal = sourceOrdinal
                    let matchedSourceOrdinal =
                        PrimaryObjectCallTargetOrdinalForActual(irFunction,
                                                               sym,
                                                               sourceOrdinal)
                    if matchedSourceOrdinal >= 0:
                        actualSourceOrdinal = matchedSourceOrdinal
                    if PrimaryObjectCallTargetIsBuiltin(sym) &&
                       !PrimaryBodyIrDirectExternalCallTarget(sym):
                        # A user-defined function may shadow a builtin name (e.g. `fn add(a,b)`).
                        # The builtin of that name is always lowered to a distinct target before
                        # the body IR (`add`->cheng_seq_set_grow, `len` inlined, ...), so a call op
                        # that still carries the builtin name here and resolves to a reachable
                        # user function is genuinely that function and MUST get a relocation —
                        # emptying it drops the call reloc and segfaults at link time.
                        let shadowIndex =
                            PrimaryPlanResolveTargetIndexArgAwareExactSource(
                                lowering,
                                bodyIrTargetSourcePath,
                                sym,
                                irIndex,
                                actualSourceOrdinal)
                        if shadowIndex >= 0 &&
                           shadowIndex < state.allSymbolNames.len &&
                           shadowIndex < state.reachable.len &&
                           state.reachable[shadowIndex]:
                            let shadowOrdinal = PrimaryObjectCallTargetOrdinalForActual(irFunction,
                                                                                        sym,
                                                                                        sourceOrdinal)
                            if shadowOrdinal >= sourceOrdinal:
                                sourceOrdinal = shadowOrdinal + 1
                            add(bircTargetSymbols, share(state.allSymbolNames[shadowIndex]))
                            continue
                        # Overloaded builtin-classified reloc call: the bare-name shadow resolver
                        # (PrimaryPlanResolveTargetIndexWithNamesOrAnyUnique) abstains on ambiguity,
                        # so an overloaded library head such as `RawmemAsVoid` (str/cstring/ptr, all
                        # in the same source file) returns shadowIndex=-1 and would be emptied here —
                        # dropping the call reloc and leaving an unbackpatched bl-self (imm26=0) that
                        # the zero-scan flags as a missing body. The callTarget row carries the
                        # resolved target source path, so resolve through it exactly as the
                        # non-builtin path does (PrimaryObjectPlanResolveCallTargetIndex) to recover
                        # the concrete overload symbol. Gate on a reachable target so genuine builtins
                        # (len/add/assert/…), whose name never resolves to a reachable Cheng function,
                        # still fall through to the empty-reloc (no-reloc) path below.
                        let shadowRowMatch = PrimaryObjectCallTargetOrdinalForActual(irFunction,
                                                                                     sym,
                                                                                     sourceOrdinal)
                        if shadowRowMatch >= 0 && shadowRowMatch < irFunction.callTargets.len:
                            var shadowRowSrc =
                                PrimaryObjectCallTargetSourcePath(irFunction,
                                                                  shadowRowMatch)
                            let shadowRowIndex = PrimaryObjectPlanResolveCallTargetIndex(lowering,
                                                                                         irIndex,
                                                                                         shadowRowMatch,
                                                                                         irFunction.sourcePath,
                                                                                         shadowRowSrc,
                                                                                         sym)
                            if shadowRowIndex >= 0 &&
                               shadowRowIndex < state.allSymbolNames.len &&
                               shadowRowIndex < state.reachable.len &&
                               state.reachable[shadowRowIndex]:
                                if shadowRowMatch >= sourceOrdinal:
                                    sourceOrdinal = shadowRowMatch + 1
                                add(bircTargetSymbols, share(state.allSymbolNames[shadowRowIndex]))
                                continue
                            # @importc 头同时被 builtin 归类 (如 paramCount, cmdline.cheng:61):
                            # builtin 支抢断了非 builtin 路径的 importc 解析臂 (下方
                            # callTargetImportcFlags 臂) → 空 reloc → 未回填 bl-self。行携带
                            # importc 标志与符号, 按位镜像该臂发外部符号 reloc。
                            if shadowRowMatch < irFunction.callTargetImportcFlags.len &&
                               irFunction.callTargetImportcFlags[shadowRowMatch] &&
                               shadowRowMatch < irFunction.callImportcSymbols.len &&
                               len(irFunction.callImportcSymbols[shadowRowMatch]) > 0:
                                if shadowRowMatch >= sourceOrdinal:
                                    sourceOrdinal = shadowRowMatch + 1
                                add(bircTargetSymbols,
                                    PrimaryTargetSymbolName(linkPlan.targetTriple,
                                                            irFunction.callImportcSymbols[shadowRowMatch]))
                                continue
                        if sourceOrdinal < irFunction.callTargets.len &&
                           PrimaryObjectBuiltinCallMatchesActual(sym,
                                                                 irFunction.callTargets[sourceOrdinal]):
                            # callTargets 行按位确认这就是被内联/消解掉的 builtin
                            # 本身 (非 shadow) —— 该位没有 BL 需要回填, 空 reloc
                            # 安全, 不是猜测。
                            sourceOrdinal = sourceOrdinal + 1
                            add(bircTargetSymbols, "")
                            continue
                        # F02 (resolve-miss 收口): 行未确认这是真 builtin, 且
                        # shadow/import-scoped/row 三层 resolve 已全部失败——不能
                        # 再假定"必是内联 builtin, 空 reloc 安全", 唯一出路是收口
                        # trap, 禁止 add(bircTargetSymbols, "") 静默放行 (历史
                        # bl-self BL imm26=0 自跳根因)。
                        let f02X1Trapped = PrimaryPlanResolveTargetIndexOrTrap(state, lowering, i, irIndex,
                                                                               strings.CloneStr(bodyIrTargetSourcePath), strings.CloneStr(sym), co, true)
                        if f02X1Trapped < 0:
                            break
                        add(bircTargetSymbols, share(state.allSymbolNames[f02X1Trapped]))
                        continue
                    if PrimaryBodyIrIndirectCallIntrinsic(sym):
                        if sourceOrdinal < irFunction.callTargets.len &&
                           irFunction.callTargets[sourceOrdinal] == sym:
                            sourceOrdinal = sourceOrdinal + 1
                        add(bircTargetSymbols, "")
                        continue
                    if PrimaryBodyIrDirectExternalCallTarget(sym):
                        let directExternalSym = share(sym)
                        sym = PrimaryTargetSymbolName(linkPlan.targetTriple, sym)
                        symResolved = true
                        if actualSourceOrdinal < irFunction.callImportcSymbols.len:
                            let importcSym = irFunction.callImportcSymbols[actualSourceOrdinal]
                            if importcSym == directExternalSym && actualSourceOrdinal >= sourceOrdinal:
                                sourceOrdinal = actualSourceOrdinal + 1
                            elif len(importcSym) > 0 && actualSourceOrdinal >= sourceOrdinal:
                                # Name mismatch (Cheng alias vs C symbol). Align by position.
                                sourceOrdinal = actualSourceOrdinal + 1
                        if matchedSourceOrdinal >= 0 && actualSourceOrdinal >= sourceOrdinal:
                            sourceOrdinal = actualSourceOrdinal + 1
                    elif matchedSourceOrdinal >= 0 && irFunction.callTargetImportcFlags.len > actualSourceOrdinal && irFunction.callTargetImportcFlags[actualSourceOrdinal]:
                        if irFunction.callImportcSymbols.len > actualSourceOrdinal:
                            sym = PrimaryTargetSymbolName(linkPlan.targetTriple, irFunction.callImportcSymbols[actualSourceOrdinal])
                            symResolved = true
                        if actualSourceOrdinal >= sourceOrdinal:
                            sourceOrdinal = actualSourceOrdinal + 1
                    elif matchedSourceOrdinal >= 0 && irFunction.callTargetSourcePaths.len > actualSourceOrdinal && irFunction.callTargets.len > actualSourceOrdinal:
                        if PrimaryObjectCallTargetIsBuiltin(irFunction.callTargets[actualSourceOrdinal]):
                            if !PrimaryObjectCallTargetIsBuiltin(sym):
                                let bodyIrTargetIndex =
                                    PrimaryPlanResolveTargetIndexArgAwareExactSource(
                                        lowering,
                                        bodyIrTargetSourcePath,
                                        sym,
                                        irIndex,
                                        actualSourceOrdinal)
                                if bodyIrTargetIndex >= 0 &&
                                   bodyIrTargetIndex < state.allSymbolNames.len &&
                                   bodyIrTargetIndex < state.reachable.len &&
                                   state.reachable[bodyIrTargetIndex]:
                                    sym = state.allSymbolNames[bodyIrTargetIndex]
                                    symResolved = true
                                    if actualSourceOrdinal >= sourceOrdinal:
                                        sourceOrdinal = actualSourceOrdinal + 1
                                if symResolved:
                                    add(bircTargetSymbols, sym)
                                    continue
                                # F02 (resolve-miss 收口): row 把这个 ordinal 标成
                                # builtin, 但 body-IR 实际调用符号 sym 本身并非
                                # builtin 名 (真符号, 非泛化 builtin 归类)——上面
                                # 唯一的 resolve 尝试已失败, 不能落到下面"sym 自身
                                # 也是 builtin"的双重确认空 reloc 分支, 唯一出路是
                                # 收口 trap (break 退出 birc 循环, sourceOrdinal 游标
                                # 已无意义, 不必再推进)。
                                let f02X2Trapped = PrimaryPlanResolveTargetIndexOrTrap(state, lowering, i, irIndex,
                                                                                       strings.CloneStr(bodyIrTargetSourcePath), strings.CloneStr(sym), co, true)
                                if f02X2Trapped < 0:
                                    break
                                add(bircTargetSymbols, share(state.allSymbolNames[f02X2Trapped]))
                                continue
                            if actualSourceOrdinal >= sourceOrdinal:
                                sourceOrdinal = actualSourceOrdinal + 1
                            add(bircTargetSymbols, "")
                            continue
                        # Zero-arg aggregate constructor `Type()`: materializes a zero-init value in
                        # place, no function body, no relocation. Consume the call op with an empty
                        # reloc symbol (skipped like builtins/indirect-intrinsics above). Mirrors the
                        # reachability loop and the text path; named field constructors emit no call op.
                        if PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr,
                                                                       irFunction.sourcePath,
                                                                       irFunction.callTargets[actualSourceOrdinal]):
                            if actualSourceOrdinal >= sourceOrdinal:
                                sourceOrdinal = actualSourceOrdinal + 1
                            add(bircTargetSymbols, "")
                            continue
                        resolvedCallTargetSourcePath = bodyIrTargetSourcePath
                        var targetIndex = PrimaryObjectPlanResolveCallTargetIndex(lowering,
                                                                                  irIndex,
                                                                                  actualSourceOrdinal,
                                                                                  irFunction.sourcePath,
                                                                                  resolvedCallTargetSourcePath,
                                                                                  irFunction.callTargets[actualSourceOrdinal])
                        if targetIndex < 0 &&
                           co < retainedBodyIR.callTargetDomainKinds.len &&
                           co < retainedBodyIR.callTargetRows.len &&
                           retainedBodyIR.callTargetDomainKinds[co] ==
                               coreir.BodyCallTargetDomainFunctionTag:
                            targetIndex = PrimaryPlanSymbolRowForTypedFunctionIndex(
                                state, retainedBodyIR.callTargetRows[co])
                        if targetIndex < 0 &&
                           co < retainedBodyIR.callSequence.len:
                            let bircMatchCallNode =
                                retainedBodyIR.callSequence[co].semanticCallExprNodeIndex
                            let bircMatchSnapshotCallId =
                                lower.LoweringPlanSnapshotCallIdForTypedIrNodeIndex(
                                    lowering, bircMatchCallNode)
                            if bircMatchSnapshotCallId >= 0:
                                targetIndex = PrimaryPlanSymbolRowForTypedFunctionIndex(
                                    state,
                                    lower.LoweringPlanSnapshotCallTargetTypedFunctionIndexAt(
                                        lowering, bircMatchSnapshotCallId))
                        if targetIndex < 0:
                            targetIndex = PrimaryPlanUniqueFunctionTailRow(
                                lowering,
                                irFunction.callTargets[actualSourceOrdinal])
                        # form60: hoist .len before three-way conj with [targetIndex]
                        let reachableLen_f60: int32 = state.reachable.len
                        if targetIndex >= 0 && targetIndex < state.allSymbolNames.len &&
                           targetIndex < reachableLen_f60 && state.reachable[targetIndex]:
                            sym = state.allSymbolNames[targetIndex]
                            symResolved = true
                        if actualSourceOrdinal >= sourceOrdinal:
                            sourceOrdinal = actualSourceOrdinal + 1
                    elif len(sym) > 0:
                        # Zero-arg aggregate constructor `Type()` / `mod.Type()` that did not match a
                        # callTarget row (matchedSourceOrdinal < 0, e.g. a qualified ctor name like
                        # `parser.NormalizedExprLayer`): materializes a zero-init value in place, no
                        # function body, no relocation. Consume the call op with an empty reloc symbol
                        # (skipped like builtins). Mirrors the reachability loop and the text path;
                        # named field constructors emit no call op so they never reach here.
                        if PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr,
                                                                       irFunction.sourcePath,
                                                                       sym):
                            add(bircTargetSymbols, "")
                            continue
                        let importcTargetSymbol =
                            texpr.TypedExprIrLookupImportcTargetSymbol(
                                lowering.typedIr,
                                bodyIrTargetSourcePath,
                                sym)
                        if importcTargetSymbol != "":
                            sym = PrimaryTargetSymbolName(linkPlan.targetTriple,
                                                          importcTargetSymbol)
                            symResolved = true
                        else:
                            resolvedCallTargetSourcePath = bodyIrTargetSourcePath
                            var targetIndex = PrimaryObjectPlanResolveCallTargetIndex(lowering,
                                                                                      irIndex,
                                                                                      actualSourceOrdinal,
                                                                                      irFunction.sourcePath,
                                                                                      resolvedCallTargetSourcePath,
                                                                                      sym)
                            if targetIndex < 0 &&
                               co < retainedBodyIR.callTargetDomainKinds.len &&
                               co < retainedBodyIR.callTargetRows.len &&
                               retainedBodyIR.callTargetDomainKinds[co] ==
                                   coreir.BodyCallTargetDomainFunctionTag:
                                targetIndex = PrimaryPlanSymbolRowForTypedFunctionIndex(
                                    state, retainedBodyIR.callTargetRows[co])
                            if targetIndex < 0 &&
                               co < retainedBodyIR.callSequence.len:
                                let bircMissCallNode =
                                    retainedBodyIR.callSequence[co].semanticCallExprNodeIndex
                                let bircMissSnapshotCallId =
                                    lower.LoweringPlanSnapshotCallIdForTypedIrNodeIndex(
                                        lowering, bircMissCallNode)
                                if bircMissSnapshotCallId >= 0:
                                    targetIndex = PrimaryPlanSymbolRowForTypedFunctionIndex(
                                        state,
                                        lower.LoweringPlanSnapshotCallTargetTypedFunctionIndexAt(
                                            lowering, bircMissSnapshotCallId))
                            if targetIndex < 0 && len(sym) > 0:
                                targetIndex = PrimaryPlanUniqueFunctionTailRow(
                                    lowering, sym)
                            # form60: hoist .len before three-way conj with [targetIndex]
                            let reachableLen_f60: int32 = state.reachable.len
                            if targetIndex >= 0 && targetIndex < state.allSymbolNames.len &&
                               targetIndex < reachableLen_f60 && state.reachable[targetIndex]:
                                sym = state.allSymbolNames[targetIndex]
                                symResolved = true
                                if actualSourceOrdinal >= sourceOrdinal:
                                    sourceOrdinal = actualSourceOrdinal + 1
                    if !symResolved:
                        if os.GetEnv("CHENG_BIRC_TRACE") == "1" && lowering.functionNames[i] == "TypedExprFactsValidateCallResolutionRange":
                            var bircRowDump = ""
                            for bircRowIdx in 0..<irFunction.callTargets.len:
                                var bircRowSrc = ""
                                if bircRowIdx < irFunction.callTargetSourcePaths.len:
                                    bircRowSrc = irFunction.callTargetSourcePaths[bircRowIdx]
                                bircRowDump = Fmt"{bircRowDump}|[{bircRowIdx}]={irFunction.callTargets[bircRowIdx]}@{bircRowSrc}"
                            var bircRawSym = ""
                            if co < retainedBodyIR.callSequence.len:
                                bircRawSym = retainedBodyIR.callSequence[co].targetSymbol
                            os.WriteLine(os.GetStderr(), Fmt"BIRC_TRACE_FAIL fn={lowering.functionNames[i]} co={co} birc={birc} sym={sym} rawSym={bircRawSym} matchedSrcOrd={matchedSourceOrdinal} actualSrcOrd={actualSourceOrdinal} cursorSrcOrd={sourceOrdinal} callTargetsLen={irFunction.callTargets.len} rows={bircRowDump}")
                        state.bodySemanticsMissing = true
                        PrimaryObjectPlanRecordError(state, lowering.functionNames[i], PrimaryObjectPlanFunctionSourcePathAt(lowering, i), "missing_call_target", sym, PrimaryObjectMissingLineNumber(lowering, irIndex))
                        if len(state.error.functionName) <= 0:
                            PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, i)
                            state.error.bodyKind = "missing_call_target"
                            state.error.typedIrKind = ""
                            state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                            state.error.callTargetOrdinal = co
                            state.error.callTarget = sym
                            state.error.callTargetSourcePath = resolvedCallTargetSourcePath
                            PrimaryObjectPlanFillMissingCallTargetDiagnostic(state.error,
                                                                             lowering,
                                                                             i,
                                                                             strings.CloneStr(state.error.callTarget))
                        break
                    add(bircTargetSymbols, sym)
            if bircTargetSymbols.len < birc:
                if PrimaryObjectPlanDebugEnabled():
                    PrimaryObjectPlanDebugLine(Fmt"body_ir_birc_target_short function={lowering.functionNames[i]} birc={birc} targets={bircTargetSymbols.len} body_kind={bodyKind} lowering_calls={irFunction.callTargets.len}")
                state.bodySemanticsMissing = true
                PrimaryObjectPlanRecordError(state, lowering.functionNames[i], PrimaryObjectPlanFunctionSourcePathAt(lowering, i), "missing_call_target", "zero_scan", PrimaryObjectMissingLineNumber(lowering, irIndex))
                if len(state.error.functionName) <= 0:
                    PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, i)
                    state.error.bodyKind = "missing_call_target"
                    state.error.typedIrKind = ""
                    state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                    state.error.callTargetOrdinal = bircTargetSymbols.len
                PrimaryObjectPlanRollbackBuildItemState(state, buildItemSnapshot)
                continue
            for co in 0..<birc:
                let call = retainedBodyIR.callSequence[co]
                if PrimaryCallOpInlineAtomicFetchAddKind(call) > 0:
                    continue
                if PrimaryCallOpInlinePtrSlotKind(call) > 0 &&
                   contract.CodegenBodyEmitUnit(linkPlan.targetTriple) != contract.CodegenUnitX64:
                    continue
                if PrimaryCallOpInlineAesBlockKind(call) > 0:
                    continue
                if PrimaryCallOpInlineSha256BlockKind(call) > 0:
                    continue
                if PrimaryCallOpInlineF64TruncKind(call) > 0:
                    continue
                # #95 wave5 根修 (reloc-emit 循环, 同一 provenance 门): 这条
                # 豁免是 #73/#77 时代既有代码(先于 wave4/wave5 存在), 但同样只看
                # inlineF64FromIntKind 字段值——PrimaryBodyIrAppendCallOp 通用
                # 调用构造器对任何 target 尾名="float64" 的调用也无条件置位同一
                # 字段(与本 rescue 无关), 被这条既有豁免一并放过 reloc 登记, 让
                # 一条真正需要 BL 的调用永远拿不到目标符号(bircRelocTargetSymbol
                # 检查在这条 continue 之后, 被跳过, 下方"body_ir_call_empty_reloc
                # _target"响亮拒绝machine从未触发)。加 provenance 门收窄到只豁免
                # 本 rescue 分支自己构造的 CallOp, 不relies于多义字段值。
                if PrimaryCallOpWholeCallF64FromIntRescue(call) &&
                   PrimaryCallOpInlineF64FromIntKind(call, retainedBodyIR) > 0:
                    continue
                if PrimaryBodyIrIndirectCallIntrinsic(call.targetSymbol):
                    continue
                var bircRelocTargetSymbol = ""
                if co < bircTargetSymbols.len:
                    bircRelocTargetSymbol = bircTargetSymbols[co]
                if len(bircRelocTargetSymbol) <= 0:
                    state.bodySemanticsMissing = true
                    PrimaryObjectPlanRecordError(state, lowering.functionNames[i], PrimaryObjectPlanFunctionSourcePathAt(lowering, i), "body_ir_call_empty_reloc_target", call.targetSymbol, PrimaryObjectMissingLineNumber(lowering, irIndex))
                    if len(state.error.functionName) <= 0:
                        PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, i)
                        state.error.bodyKind = "body_ir_call_empty_reloc_target"
                        state.error.typedIrKind = ""
                        state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
                        state.error.callTargetOrdinal = co
                        state.error.callTarget = call.targetSymbol
                    continue
                if contract.CodegenBodyEmitUnit(linkPlan.targetTriple) == contract.CodegenUnitWasm32:
                    if len(bircRelocTargetSymbol) > 0:
                        add(state.relocSourceItemIds, itemId)
                        add(state.relocWordOffsets, 0)
                        add(state.relocTargetSymbols, share(bircRelocTargetSymbol))
                        add(state.relocCallOrdinal, -1)
                        primaryObjectPlanAppendInvalidCallRelocIdentity(state)
                    continue
                if primaryBuildUseCallBlEmitFirst:
                    # Step B (arm64 call-BL emit-first): do NOT predict the BL reloc word offset.
                    # Append a -1 placeholder offset plus the callOrdinal `co`; FillAndCheck writes the
                    # real offset from the serial-fill record (PrimaryBackpatchCallBlRealFor) keyed by
                    # (realFunctionBase, callOrdinal). The arm64 call-BL predictor
                    # (PrimaryBodyIrGeneralCfgRelocWordOffset / layoutCallRelocWordOffsets) is gone from
                    # this path. Empty-symbol calls are rejected above because fill would still emit a BL.
                    add(state.relocSourceItemIds, itemId)
                    add(state.relocWordOffsets, -1)
                    add(state.relocTargetSymbols, share(bircRelocTargetSymbol))
                    add(state.relocCallOrdinal, co)
                    primaryObjectPlanAppendInvalidCallRelocIdentity(state)
                    continue
                var bro: int32
                if contract.CodegenBodyEmitUnit(linkPlan.targetTriple) == contract.CodegenUnitX64:
                    bro = x64units.CodegenX64BodyRelocWordOffset(retainedBodyIR, co)
                else:
                    # Non-emit-first arm64 (zero-scan / fail-trace debug builds): keep the predictor.
                    bro = PrimaryBodyIrGeneralCfgRelocWordOffset(retainedBodyIR, itemId, co)
                if os.GetEnv("CHENG_RELOC_DEBUG") == "1":
                    var relocDebugSym = ""
                    if co < bircTargetSymbols.len:
                        relocDebugSym = bircTargetSymbols[co]
                    os.WriteLine(os.GetStderr(), Fmt"phase=body_ir_call_reloc function={lowering.functionNames[i]} co={co} target={call.targetSymbol} sym={relocDebugSym} bro={bro}")
                if bro >= 0 && len(bircRelocTargetSymbol) > 0:
                    add(state.relocSourceItemIds, itemId)
                    # segment-b: x86 bro is a function-relative BYTE offset and the
                    # function byte base is wordOffset×4; store the absolute byte
                    # offset. arm64 stays word-granular (wordOffset+bro words).
                    if contract.CodegenBodyEmitUnit(linkPlan.targetTriple) == contract.CodegenUnitX64:
                        add(state.relocWordOffsets, wordOffset * 4 + bro)
                    else:
                        add(state.relocWordOffsets, wordOffset + bro)
                    add(state.relocTargetSymbols, share(bircRelocTargetSymbol))
                    add(state.relocCallOrdinal, -1)
                    primaryObjectPlanAppendInvalidCallRelocIdentity(state)
                elif bro < 0:
                    state.bodySemanticsMissing = true
                    PrimaryObjectPlanRecordError(state, lowering.functionNames[i], PrimaryObjectPlanFunctionSourcePathAt(lowering, i), "body_ir_call_reloc_missing", "", PrimaryObjectMissingLineNumber(lowering, irIndex))
                    if len(state.error.functionName) <= 0:
                        PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, i)
                        state.error.bodyKind = "body_ir_call_reloc_missing"
                        state.error.typedIrKind = ""
                        state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
        if primaryBuildUseDeclOrderStream && state.bodySemanticsMissing:
            PrimaryObjectPlanRollbackBuildItemState(state, buildItemSnapshot)
            PrimaryObjectPlanMarkDeclOrderStreamBuildAbort(state,
                                                            i,
                                                            lowering.functionNames[i],
                                                            PrimaryObjectPlanFunctionSourcePathAt(lowering, i),
                                                            state.error.bodyKind)
            break
        if primaryBuildUseDeclOrderStream:
            let streamFunctionIndex = state.functionWordOffsets.len - 1
            if !PrimaryObjectPlanStreamEmitAndReleaseCurrent(state,
                                                              lowering,
                                                              plan,
                                                              i,
                                                              streamFunctionIndex,
                                                              retainedBodyIR,
                                                              buildItemSnapshot.relocSourceItemIdsLen,
                                                              buildItemSnapshot.dataRelocSourceItemIdsLen):
                PrimaryObjectPlanRollbackBuildItemState(state, buildItemSnapshot)
                break
    if primaryBuildUseDeclOrderStream:
        primaryBackpatchActive = false
        if !state.bodySemanticsMissing &&
           (state.bodyIrLifecycleFunctionCount !=
                state.fillCheckReleasedBodyIrFunctionCount ||
            state.bodyIrLifecycleAllocated !=
                int64(state.bodyIrLifecycleFunctionCount) ||
            state.bodyIrLifecycleReleased !=
                int64(state.bodyIrLifecycleFunctionCount) ||
            state.bodyIrLifecycleLive != int64(0) ||
            state.bodyIrLifecycleAllocatedBytes !=
                state.bodyIrLifecycleReleasedBytes ||
            state.bodyIrLifecycleLiveBytes != int64(0) ||
            state.bodyIrLifecycleOwnerTransferCount !=
                int64(state.bodyIrLifecycleFunctionCount) ||
            state.bodyIrLifecyclePhysicalBufferCount !=
                state.bodyIrLifecyclePhysicalFreeCount ||
            state.bodyIrLifecycleLedgerStorageReleasedSequenceCount !=
                int64(state.bodyIrLifecycleFunctionCount) * int64(6) ||
            state.bodyIrLifecycleLedgerStorageReleasedBufferCount <= int64(0) ||
            state.bodyIrLifecycleLedgerStorageReleasedBufferCount >
                state.bodyIrLifecycleLedgerStorageReleasedSequenceCount ||
            state.bodyIrLifecycleLedgerStorageReleasedBytes <= int64(0) ||
            !state.bodyIrLifecycleAllClosed):
            panic("primary body ir lifecycle: successful stream is unbalanced")
        if state.bodySemanticsMissing && !state.streamedBuildAborted:
            PrimaryObjectPlanMarkDeclOrderStreamBuildAbort(state,
                                                            state.streamedFillFailedIndex,
                                                            state.error.functionName,
                                                            state.error.functionSourcePath,
                                                            state.error.bodyKind)
        state.wordFillSchedule = "decl_order_stream_emit_release"
        state.wordFillRequestedJobCount = linkPlan.jobCount
        if state.wordFillRequestedJobCount <= 0:
            state.wordFillRequestedJobCount = 1
        state.wordFillWorkerCount = 1
        state.wordFillCompletedWorkerCount = 1
        state.wordFillTaskCount = state.functionInstructionBodyKinds.len
        state.wordFillMergeOrder = "decl_ordinal"
        if state.streamedBuildAborted:
            state.wordFillSchedule = "decl_order_stream_aborted"
            state.wordFillCompletedWorkerCount = 0
            state.wordFillTaskCount = 0
            PrimaryObjectPlanReleaseAbortedBuildPayload(state, plan)
        else:
            let _ = bodylifecycle.BodyIrPayloadReleaseSequence(
                state.functionBodyIRs)
            let _ = bodylifecycle.BodyIrPayloadReleaseSequence(
                state.tempBodyIRs)
    if PrimaryObjectPlanDebugEnabled():
        PrimaryObjectPlanDebugLine(Fmt"build_items_done items={state.itemIds.len} total_words={state.totalWordCount}")
    if !state.bodySemanticsMissing &&
       !state.streamedBuildAborted &&
       linkPlan.emitKind == creq.EmitExe &&
       len(linkPlan.entrySymbol) > 0 &&
       len(state.entryFunctionSymbol) > 0 &&
       state.itemIds.len > 0:
        if primaryBuildUseDeclOrderStream:
            # The entry bridge emits after the decl-order stream finalized and
            # switched the backpatch recorder off (:70227).  Its call-BL fill
            # records are mandatory for the resolve step in
            # RecordRegallocProductionRelocs/ResolveStreamedRelocsForFunction;
            # without the recorder the bridge always fails with
            # call_bl_reloc_no_fill_record.
            primaryBackpatchActive = true
            var entryInterfaceCid: layout.FixedBytes32
            let entryTypedFunctionIndex =
                lowering.sourceEntryTypedFunctionIndex
            if !lower.LoweringPlanFunctionInterfaceCidAt(
                   lowering, entryTypedFunctionIndex,
                   entryInterfaceCid):
                panic("primary entry bridge: source-entry interface identity missing")
            if !PrimaryObjectPlanEmitRegallocEntryBridge(state,
                                                          linkPlan,
                                                          plan,
                                                          lowering.typeArenaArtifactCid,
                                                          entryTypedFunctionIndex,
                                                          entryInterfaceCid):
                var bridgeFailureKind = strings.CloneStr(
                    state.streamedBackpatchFailureKind)
                if len(bridgeFailureKind) <= 0:
                    bridgeFailureKind =
                        "regalloc_entry_bridge_emit_failed"
                # Pass through the recorded structural coordinates so the
                # emission verdict's errorCode/errorDetail int32 binding
                # survives this consolidating record (upstream recorders
                # leave them at their -1 sentinels when nothing was bound).
                PrimaryObjectPlanRecordStreamedBackpatchFailure(
                    state, -1, bridgeFailureKind,
                    state.streamedBackpatchCallOrdinal,
                    state.streamedBackpatchDataOpIndex,
                    state.streamedBackpatchDataSubIndex)
                PrimaryObjectPlanMarkDeclOrderStreamBuildAbort(
                    state, -1, PrimaryRuntimeEntryBridgeSymbol(linkPlan),
                    linkPlan.entryPath,
                    bridgeFailureKind)
                PrimaryObjectPlanReleaseAbortedBuildPayload(state, plan)
        else:
            let entryBridgeItemIdRaw = 900000 + state.itemIds.len
            let entryBridgeItemId = int32(entryBridgeItemIdRaw)
            add(state.itemIds, entryBridgeItemId)
            add(state.symbolNames, PrimaryRuntimeEntryBridgeSymbol(linkPlan))
            add(state.symbolTypedFunctionIndexes, -1)
            add(state.symbolNameIds, -1)
            add(state.symbolRoles,
                PrimaryObjectSymbolRoleSyntheticEntryBridge)
            add(state.symbolInterfaceCids, layout.FixedBytes32())
            add(state.functionWordOffsets, state.totalWordCount)
            add(state.functionWordCounts, texpr.BodyKindEntryBridgeWordCount)
            add(state.functionBodyKinds, texpr.BodyKindEntryBridge)
            add(state.functionInstructionBodyKinds, texpr.BodyKindEntryBridge)
            add(state.functionStatementReturnModes, PrimaryStatementReturnModeNone())
            add(state.functionStatementReturnI32Values, 0)
            add(state.functionStatementCallCounts, 0)
            add(state.functionIrIndexes, -1)
            add(state.functionBodyIRs, coreir.BodyIRNew())
            PrimaryObjectPlanAppendEntryBridgeRelocs(state,
                                                     linkPlan,
                                                     entryBridgeItemId,
                                                     state.totalWordCount)
            state.totalWordCount = state.totalWordCount + texpr.BodyKindEntryBridgeWordCount
    if primaryBuildUseDeclOrderStream &&
       !state.streamedBuildAborted &&
       !PrimaryObjectPlanRegallocProductionEvidenceExact(state, plan):
        PrimaryObjectPlanRecordStreamedBackpatchFailure(
            state, -1, "regalloc_production_evidence_coverage_mismatch",
            -1, -1, -1)
        PrimaryObjectPlanMarkDeclOrderStreamBuildAbort(
            state, -1, "regalloc_production_evidence", linkPlan.entryPath,
            "regalloc_production_evidence_coverage_mismatch")
        PrimaryObjectPlanReleaseAbortedBuildPayload(state, plan)

@borrows
fn PrimaryObjectPlanExportRootsForTarget(linkPlan: slplan.SystemLinkPlanStub): str[] =
    var out: str[]
    for i in 0..<linkPlan.exportRootSymbols.len:
        add(out, PrimaryTargetSymbolName(linkPlan.targetTriple, linkPlan.exportRootSymbols[i]))
    return out

@borrows
fn PrimaryObjectPlanBlSelfWord(): int32 =
    # BL imm26=0 (0x94000000, int32 =-1811939328) = 调用目标解析 miss 后的静默占位,
    # 运行必 bl 跳自身死循环 (gen2 万能挂死根因: strutilsAppendStr→seqs.Add 等 63 站)。
    # 合法自递归不可能编出 imm=0 (bl 位置 ≠ 函数首字)。zero_scan 将其视同缺体。
    return -1811939328

@borrows
fn PrimaryObjectPlanBuildFunctionBranchRelocCoverage(
        state: PrimaryObjectPlanPhaseState,
        itemId: int32,
        wordStart: int32,
        wordCount: int32,
        relocStart: int32,
        dataRelocStart: int32,
        covered: var bool[]): bool =
    setLen(covered, 0)
    if wordStart < 0 || wordCount < 0 ||
       wordStart > 2147483647 - wordCount ||
       relocStart < 0 || relocStart > state.relocWordOffsets.len ||
       dataRelocStart < 0 ||
       dataRelocStart > state.dataRelocWordOffsets.len ||
       state.relocSourceItemIds.len != state.relocWordOffsets.len ||
       state.relocTargetSymbols.len != state.relocWordOffsets.len ||
       state.relocTargetDomainKinds.len != state.relocWordOffsets.len ||
       state.relocTargetRows.len != state.relocWordOffsets.len ||
       state.relocTargetInterfaceCids.len !=
           state.relocWordOffsets.len ||
       state.relocCallOrdinal.len != state.relocWordOffsets.len ||
       state.dataRelocSourceItemIds.len !=
           state.dataRelocWordOffsets.len ||
       state.dataRelocTargetSymbols.len !=
           state.dataRelocWordOffsets.len:
        return false
    let wordEnd = wordStart + wordCount
    setLen(covered, wordCount)
    for row in relocStart..<state.relocWordOffsets.len:
        if state.relocSourceItemIds[row] != itemId:
            return false
        let wordIndex = state.relocWordOffsets[row]
        # ResolvedCallTargets moves the spelling into the emit-side
        # resolved[] array. Call rows still have callOrdinal >= 0 and a
        # filled word offset; skipping them here leaves the BL placeholder
        # uncovered (unrelocated_call_bl).
        var rowIsCallReloc = false
        if state.relocCallOrdinal[row] >= 0:
            rowIsCallReloc = true
        if (state.relocTargetSymbols[row] != "" || rowIsCallReloc) &&
           wordIndex >= wordStart &&
           wordIndex < wordEnd:
            covered[wordIndex - wordStart] = true
    for row in dataRelocStart..<state.dataRelocWordOffsets.len:
        if state.dataRelocSourceItemIds[row] != itemId:
            return false
        let wordIndex = state.dataRelocWordOffsets[row]
        if state.dataRelocTargetSymbols[row] != "" &&
           wordIndex >= wordStart &&
           wordIndex < wordEnd:
            covered[wordIndex - wordStart] = true
    return true

@borrows
fn PrimaryObjectPlanBuildBranchRelocWordOwners(
        state: PrimaryObjectPlanPhaseState,
        wordCount: int32,
        covered: var bool[],
        ownerItemIds: var int32[]): bool =
    setLen(covered, 0)
    setLen(ownerItemIds, 0)
    if wordCount < 0 ||
       state.relocSourceItemIds.len != state.relocWordOffsets.len ||
       state.relocTargetSymbols.len != state.relocWordOffsets.len ||
       state.relocTargetDomainKinds.len != state.relocWordOffsets.len ||
       state.relocTargetRows.len != state.relocWordOffsets.len ||
       state.relocTargetInterfaceCids.len !=
           state.relocWordOffsets.len ||
       state.dataRelocSourceItemIds.len !=
           state.dataRelocWordOffsets.len ||
       state.dataRelocTargetSymbols.len !=
           state.dataRelocWordOffsets.len:
        return false
    setLen(covered, wordCount)
    for _ in 0..<wordCount:
        add(ownerItemIds, -1)
    for row in 0..<state.relocWordOffsets.len:
        let wordIndex = state.relocWordOffsets[row]
        var rowIsCallReloc = false
        if row < state.relocCallOrdinal.len &&
           state.relocCallOrdinal[row] >= 0:
            rowIsCallReloc = true
        if (state.relocTargetSymbols[row] == "" && !rowIsCallReloc) ||
           wordIndex < 0 || wordIndex >= wordCount:
            continue
        if covered[wordIndex] &&
           ownerItemIds[wordIndex] != state.relocSourceItemIds[row]:
            return false
        covered[wordIndex] = true
        ownerItemIds[wordIndex] = state.relocSourceItemIds[row]
    for row in 0..<state.dataRelocWordOffsets.len:
        let wordIndex = state.dataRelocWordOffsets[row]
        if state.dataRelocTargetSymbols[row] == "" ||
           wordIndex < 0 || wordIndex >= wordCount:
            continue
        if covered[wordIndex] &&
           ownerItemIds[wordIndex] !=
               state.dataRelocSourceItemIds[row]:
            return false
        covered[wordIndex] = true
        ownerItemIds[wordIndex] = state.dataRelocSourceItemIds[row]
    return ownerItemIds.len == wordCount

fn PrimaryObjectPlanFillAndCheckPhase(state: var PrimaryObjectPlanPhaseState,
                                       linkPlan: var slplan.SystemLinkPlanStub,
                                       lowering: var lower.LoweringPlanStub,
                                       plan: var PrimaryObjectPlan) =
    # Abort already released payloads and may have zero symbol rows.
    # Do not seal identity on that empty state — the abort reason is the
    # real error and DiagnoseAndFinalize reports it.
    plan.targetTriple = strings.CloneStr(linkPlan.targetTriple)
    if !state.streamedBuildAborted:
        # Seal from state before any seq assign (assign may move and empty
        # state) and before lazy statement release (intern still live).
        PrimaryObjectPlanSealSymbolIdentityFromLowering(
            state, lowering, plan)
    plan.itemIds = state.itemIds
    plan.symbolNames = state.symbolNames
    plan.functionBodyKinds = state.functionBodyKinds
    if !state.streamedBuildAborted:
        var identityErr: str
        if !PrimaryObjectPlanSymbolIdentityStrictValidateInto(
               plan, identityErr):
            panic(identityErr)
    # F17 slice2: replay the deferred lazyIrConsumerCounts decrement/release
    # before anything below can observe a shared ir row's statements.
    if !state.streamedBuildAborted:
        PrimaryObjectPlanReplayLazyIrReleases(state, lowering)
    if PrimaryObjectPlanDebugEnabled():
        PrimaryObjectPlanDebugLine(Fmt"fill_check_enter items={state.itemIds.len} total_words={state.totalWordCount} body_irs={state.functionBodyIRs.len}")
    state.fillCheckBeginRssBytes = PrimaryObjectPlanFillCheckSnapshot("fill_check_begin",
                                                                      state.functionBodyIRs,
                                                                      plan.instructionWords.len,
                                                                      state.relocSourceItemIds.len,
                                                                      state.dataLabels.len)
    if PrimaryObjectPlanDebugEnabled():
        PrimaryObjectPlanDebugLine(Fmt"fill_check_after_begin_snapshot rss={state.fillCheckBeginRssBytes}")
    plan.objectFormat = tmat.TargetPrimaryObjectFormat(linkPlan.targetTriple)
    if linkPlan.emitKind == creq.EmitObj:
        plan.outputPath = linkPlan.outputPath
    else:
        plan.outputPath = Fmt"{linkPlan.outputPath}.primary.o"
    plan.entryPath = linkPlan.entryPath
    plan.entrySymbol = linkPlan.entrySymbol
    plan.entryFunctionSymbol = state.entryFunctionSymbol
    if PrimaryObjectPlanDebugEnabled():
        PrimaryObjectPlanDebugLine("fill_check_before_export_roots")
    plan.exportRootSymbols = PrimaryObjectPlanExportRootsForTarget(linkPlan)
    if PrimaryObjectPlanDebugEnabled():
        PrimaryObjectPlanDebugLine("fill_check_after_export_roots")
    plan.symbolVisibility = linkPlan.symbolVisibility
    plan.functionWordOffsets = state.functionWordOffsets
    plan.functionWordCounts = state.functionWordCounts
    plan.functionStatementReturnModes = state.functionStatementReturnModes
    plan.functionStatementReturnI32Values = state.functionStatementReturnI32Values
    plan.functionStatementCallCounts = state.functionStatementCallCounts
    plan.functionIrIndexes = state.functionIrIndexes
    # F17 slice1: fold the per-index worker-local staging arrays (populated by
    # PrimaryBuildBodyIrForFunction during whichever lowering loop actually ran —
    # classic or streamed, see reduce fn doc comment) back into the state.bodyIR*
    # scalars below, in original ascending-i order, before this phase reads them.
    PrimaryObjectPlanReduceBodyIrPerIndexMetrics(state)
    plan.bodyIROrcRetainReleasePairElidedCount = state.bodyIROrcRetainReleasePairElidedCount
    plan.bodyIRScopeExitReleaseCount = state.bodyIRScopeExitReleaseCount
    plan.bodyIROrcDiagObserverPresent = state.bodyIROrcDiagObserverPresent
    plan.bodyIRNoAliasFunctionCount = state.bodyIRNoAliasFunctionCount
    plan.bodyIRNoAliasAppliedFunctionCount = state.bodyIRNoAliasAppliedFunctionCount
    plan.bodyIRNoAliasLocalCount = state.bodyIRNoAliasLocalCount
    plan.bodyIRNoAliasForwardRewriteCount = state.bodyIRNoAliasForwardRewriteCount
    plan.bodyIRNoAliasDodSoAAllOk = state.bodyIRNoAliasDodSoAAllOk
    plan.bodyIRPhaseArenaResetCount = state.bodyIRPhaseArenaResetCount
    plan.bodyIRPhaseArenaReserveCount = state.bodyIRPhaseArenaReserveCount
    plan.bodyIRPhaseArenaCapacityBytes = state.bodyIRPhaseArenaCapacityBytes
    plan.bodyIRPhaseArenaUsedBytes = state.bodyIRPhaseArenaUsedBytes
    plan.bodyIRPhaseArenaPeakBytes = state.bodyIRPhaseArenaPeakBytes
    plan.bodyIRPhaseArenaSpillCount = state.bodyIRPhaseArenaSpillCount
    plan.bodyIREGraphFunctionCount = state.bodyIREGraphFunctionCount
    plan.bodyIREGraphAppliedFunctionCount = state.bodyIREGraphAppliedFunctionCount
    plan.bodyIREGraphSkippedFunctionCount = state.bodyIREGraphSkippedFunctionCount
    plan.bodyIREGraphHardFailFunctionCount = state.bodyIREGraphHardFailFunctionCount
    plan.bodyIREGraphBlockCount = state.bodyIREGraphBlockCount
    plan.bodyIREGraphCandidateBlockCount = state.bodyIREGraphCandidateBlockCount
    plan.bodyIREGraphChangedBlockCount = state.bodyIREGraphChangedBlockCount
    plan.bodyIREGraphSkippedBlockCount = state.bodyIREGraphSkippedBlockCount
    plan.bodyIREGraphUnsafeOpCount = state.bodyIREGraphUnsafeOpCount
    plan.bodyIREGraphClassCount = state.bodyIREGraphClassCount
    plan.bodyIREGraphRoundCount = state.bodyIREGraphRoundCount
    plan.bodyIREGraphRuleHitCount = state.bodyIREGraphRuleHitCount
    plan.bodyIREGraphExtractedCount = state.bodyIREGraphExtractedCount
    plan.bodyIREGraphOpDelta = state.bodyIREGraphOpDelta
    plan.bodyIREGraphMs = state.bodyIREGraphMs
    plan.bodyIREGraphReason = state.bodyIREGraphReason
    plan.fillCheckBeginRssBytes = state.fillCheckBeginRssBytes
    plan.streamedEmitFirst = state.streamedEmitFirst
    plan.streamedBuildAborted = state.streamedBuildAborted
    plan.streamedBuildAbortReason = state.streamedBuildAbortReason
    plan.fillCheckSkippedForBuildAbort = state.fillCheckSkippedForBuildAbort
    plan.wordFillSchedule = state.wordFillSchedule
    plan.wordFillRequestedJobCount = state.wordFillRequestedJobCount
    plan.wordFillWorkerCount = state.wordFillWorkerCount
    plan.wordFillCompletedWorkerCount = state.wordFillCompletedWorkerCount
    plan.wordFillTaskCount = state.wordFillTaskCount
    plan.wordFillMergeOrder = state.wordFillMergeOrder
    plan.reachabilityRowOnlyCallTargetResolvedCount = state.reachabilityRowOnlyCallTargetResolvedCount
    if state.streamedBuildAborted:
        state.fillCheckSkippedForBuildAbort = true
        state.fillCheckAfterDodRssBytes = state.fillCheckBeginRssBytes
        state.fillCheckAfterInstructionAllocRssBytes = state.fillCheckBeginRssBytes
        state.fillCheckAfterWordFillRssBytes = state.fillCheckBeginRssBytes
        state.fillCheckAfterBodyIrReleaseRssBytes = state.fillCheckBeginRssBytes
        state.fillCheckAfterZeroScanRssBytes = state.fillCheckBeginRssBytes
        plan.fillCheckSkippedForBuildAbort = true
        plan.fillCheckAfterDodRssBytes = state.fillCheckAfterDodRssBytes
        plan.fillCheckAfterInstructionAllocRssBytes = state.fillCheckAfterInstructionAllocRssBytes
        plan.fillCheckAfterWordFillRssBytes = state.fillCheckAfterWordFillRssBytes
        plan.fillCheckAfterBodyIrReleaseRssBytes = state.fillCheckAfterBodyIrReleaseRssBytes
        plan.fillCheckAfterZeroScanRssBytes = state.fillCheckAfterZeroScanRssBytes
        plan.fillCheckReleasedBodyIrFunctionCount = state.fillCheckReleasedBodyIrFunctionCount
        plan.fillCheckReleasedBodyIrPayloadItemCount = state.fillCheckReleasedBodyIrPayloadItemCount
        plan.bodyIrLifecycleFunctionCount = state.bodyIrLifecycleFunctionCount
        plan.bodyIrLifecycleAllocated = state.bodyIrLifecycleAllocated
        plan.bodyIrLifecycleReleased = state.bodyIrLifecycleReleased
        plan.bodyIrLifecycleLive = state.bodyIrLifecycleLive
        plan.bodyIrLifecycleAllocatedBytes =
            state.bodyIrLifecycleAllocatedBytes
        plan.bodyIrLifecycleReleasedBytes =
            state.bodyIrLifecycleReleasedBytes
        plan.bodyIrLifecycleLiveBytes = state.bodyIrLifecycleLiveBytes
        plan.bodyIrLifecycleOwnerTransferCount =
            state.bodyIrLifecycleOwnerTransferCount
        plan.bodyIrLifecyclePhysicalBufferCount =
            state.bodyIrLifecyclePhysicalBufferCount
        plan.bodyIrLifecyclePhysicalFreeCount =
            state.bodyIrLifecyclePhysicalFreeCount
        plan.bodyIrLifecycleLedgerStorageReleasedSequenceCount =
            state.bodyIrLifecycleLedgerStorageReleasedSequenceCount
        plan.bodyIrLifecycleLedgerStorageReleasedBufferCount =
            state.bodyIrLifecycleLedgerStorageReleasedBufferCount
        plan.bodyIrLifecycleLedgerStorageReleasedBytes =
            state.bodyIrLifecycleLedgerStorageReleasedBytes
        plan.bodyIrLifecycleAllClosed = state.bodyIrLifecycleAllClosed
        plan.functionBodyIRs = []
        plan.instructionWords = []
        return
    if !state.streamedEmitFirst:
        panic("primary canonical production fill requires decl-order stream")
    if (linkPlan.emitKind != creq.EmitObj &&
        linkPlan.emitKind != creq.EmitExe) ||
       !regart.RegallocProductionTargetUsesCanonicalRegalloc(
           linkPlan.targetTriple):
        panic("primary canonical production fill target mismatch")
    if PrimaryObjectPlanDebugEnabled():
        PrimaryObjectPlanDebugLine("fill_check_before_canonical_stream_receipt")
    plan.functionBodyIRs = []
    if plan.bodyIRDodSoAFunctionCount <= 0:
        plan.bodyIRDodSoAAllOk = false
    state.fillCheckAfterDodRssBytes = PrimaryObjectPlanFillCheckSnapshot("after_body_ir_dod",
                                                                         state.functionBodyIRs,
                                                                         plan.instructionWords.len,
                                                                         state.relocSourceItemIds.len,
                                                                         state.dataLabels.len)
    plan.fillCheckAfterDodRssBytes = state.fillCheckAfterDodRssBytes
    state.fillCheckAfterInstructionAllocRssBytes = PrimaryObjectPlanFillCheckSnapshot("after_instruction_alloc",
                                                                                      state.functionBodyIRs,
                                                                                      plan.instructionWords.len,
                                                                                      state.relocSourceItemIds.len,
                                                                                      state.dataLabels.len)
    plan.fillCheckAfterInstructionAllocRssBytes = state.fillCheckAfterInstructionAllocRssBytes
    if state.streamedFillFailedIndex >= 0:
        panic("primary canonical production stream retained fill failure")
    state.fillCheckAfterWordFillRssBytes = PrimaryObjectPlanFillCheckSnapshot("after_word_fill",
                                                                              state.functionBodyIRs,
                                                                              plan.instructionWords.len,
                                                                              state.relocSourceItemIds.len,
                                                                              state.dataLabels.len)
    state.fillCheckAfterBodyIrReleaseRssBytes = state.fillCheckAfterWordFillRssBytes
    plan.fillCheckAfterWordFillRssBytes = state.fillCheckAfterWordFillRssBytes
    plan.fillCheckAfterBodyIrReleaseRssBytes = state.fillCheckAfterBodyIrReleaseRssBytes
    plan.fillCheckReleasedBodyIrFunctionCount = state.fillCheckReleasedBodyIrFunctionCount
    plan.fillCheckReleasedBodyIrPayloadItemCount = state.fillCheckReleasedBodyIrPayloadItemCount
    plan.bodyIrLifecycleFunctionCount = state.bodyIrLifecycleFunctionCount
    plan.bodyIrLifecycleAllocated = state.bodyIrLifecycleAllocated
    plan.bodyIrLifecycleReleased = state.bodyIrLifecycleReleased
    plan.bodyIrLifecycleLive = state.bodyIrLifecycleLive
    plan.bodyIrLifecycleAllocatedBytes =
        state.bodyIrLifecycleAllocatedBytes
    plan.bodyIrLifecycleReleasedBytes =
        state.bodyIrLifecycleReleasedBytes
    plan.bodyIrLifecycleLiveBytes = state.bodyIrLifecycleLiveBytes
    plan.bodyIrLifecycleOwnerTransferCount =
        state.bodyIrLifecycleOwnerTransferCount
    plan.bodyIrLifecyclePhysicalBufferCount =
        state.bodyIrLifecyclePhysicalBufferCount
    plan.bodyIrLifecyclePhysicalFreeCount =
        state.bodyIrLifecyclePhysicalFreeCount
    plan.bodyIrLifecycleLedgerStorageReleasedSequenceCount =
        state.bodyIrLifecycleLedgerStorageReleasedSequenceCount
    plan.bodyIrLifecycleLedgerStorageReleasedBufferCount =
        state.bodyIrLifecycleLedgerStorageReleasedBufferCount
    plan.bodyIrLifecycleLedgerStorageReleasedBytes =
        state.bodyIrLifecycleLedgerStorageReleasedBytes
    plan.bodyIrLifecycleAllClosed = state.bodyIrLifecycleAllClosed
    plan.functionBodyIRs = state.functionBodyIRs
    state.fillCheckAfterZeroScanRssBytes = PrimaryObjectPlanFillCheckSnapshot("after_zero_scan_begin",
                                                                             state.functionBodyIRs,
                                                                             plan.instructionWords.len,
                                                                             state.relocSourceItemIds.len,
                                                                             state.dataLabels.len)
    PrimaryObjectPlanDebugLine("fill_check_before_zero_scan")
    var branchRelocWordCovered: bool[]
    var branchRelocWordOwnerItemIds: int32[]
    if !PrimaryObjectPlanBuildBranchRelocWordOwners(
           state, plan.instructionWords.len,
           branchRelocWordCovered,
           branchRelocWordOwnerItemIds):
        panic("primary canonical production branch reloc coverage invalid")
    for functionIndex in 0..<plan.functionBodyKinds.len:
        if functionIndex >= plan.symbolNames.len ||
           functionIndex >= plan.functionWordOffsets.len ||
           functionIndex >= plan.functionWordCounts.len:
            continue
        let startWord = plan.functionWordOffsets[functionIndex]
        let endWord = startWord + plan.functionWordCounts[functionIndex]
        let itemId = plan.itemIds[functionIndex]
        var replacedZero = false
        # ★诊断真凶字: 必须在剥 reloc 表之前记录 — 下方 wordRelOffset 若在剥表后
        # 重扫, HasBranchReloc 对空表恒 false, 首爆定位永远错指函数第一个 BL
        # (wave-36 七试 if_call 伪影根因)。
        var firstFlaggedWord: int32
        firstFlaggedWord = -1
        for wordIndex in startWord..<endWord:
            # form60: hoist .len before three-way conj with [wordIndex]
            let instructionWordsLen_f60: int32 = plan.instructionWords.len
            if wordIndex >= 0 && wordIndex < instructionWordsLen_f60 &&
               (plan.instructionWords[wordIndex] == 0 ||
                plan.instructionWords[wordIndex] == PrimaryObjectPlanBlSelfWord()) &&
               !(branchRelocWordCovered[wordIndex] &&
                 branchRelocWordOwnerItemIds[wordIndex] == itemId):
                if PrimaryObjectPlanTraceActive():
                    PrimaryObjectPlanTrace(Fmt"phase=zero_scan function_index={functionIndex} symbol={plan.symbolNames[functionIndex]} body_kind={plan.functionBodyKinds[functionIndex]} word_index={wordIndex} rel={wordIndex - startWord}")
                if firstFlaggedWord < 0:
                    firstFlaggedWord = wordIndex
                replacedZero = true
        if replacedZero:
            state.bodySemanticsMissing = true
            if len(plan.error.functionName) <= 0:
                plan.error.functionName = plan.symbolNames[functionIndex]
                plan.error.bodyKind = plan.functionBodyKinds[functionIndex]
                if functionIndex >= 0 && functionIndex < plan.functionIrIndexes.len:
                    PrimaryObjectPlanCaptureErrorStatementTrace(plan.error,
                                                                lowering,
                                                                plan.functionIrIndexes[functionIndex])
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    for dumpWord in startWord..<endWord:
                        if dumpWord >= 0 && dumpWord < plan.instructionWords.len:
                            os.WriteLine(os.GetStderr(),
                                         Fmt"phase=zero_scan_words rel={dumpWord - startWord} word={plan.instructionWords[dumpWord]}")
            var cleanS: int32[]
            var cleanW: int32[]
            var cleanT: str[]
            var cleanD: int32[]
            var cleanR: int32[]
            var cleanC: layout.FixedBytes32[]
            var cleanO: int32[]
            for ri in 0..<state.relocSourceItemIds.len:
                if state.relocSourceItemIds[ri] != itemId:
                    add(cleanS, state.relocSourceItemIds[ri])
                    add(cleanW, state.relocWordOffsets[ri])
                    add(cleanT, share(state.relocTargetSymbols[ri]))
                    add(cleanD, state.relocTargetDomainKinds[ri])
                    add(cleanR, state.relocTargetRows[ri])
                    add(cleanC, layout.FixedBytes32Copy(
                        state.relocTargetInterfaceCids[ri]))
                    if ri < state.relocCallOrdinal.len:
                        add(cleanO, state.relocCallOrdinal[ri])
                    else:
                        add(cleanO, -1)
            state.relocSourceItemIds = cleanS
            state.relocWordOffsets = cleanW
            state.relocTargetSymbols = cleanT
            state.relocTargetDomainKinds = cleanD
            state.relocTargetRows = cleanR
            state.relocTargetInterfaceCids = cleanC
            state.relocCallOrdinal = cleanO
            plan.error.wordOffset = startWord
            plan.error.wordCount = plan.functionWordCounts[functionIndex]
            if firstFlaggedWord >= 0:
                plan.error.wordRelOffset = firstFlaggedWord - startWord
            if functionIndex < state.functionBodyIRs.len:
                PrimaryObjectPlanCaptureBodyIrDetails(plan.error.bodyIrDetail,
                                                       state.functionBodyIRs[functionIndex])
                PrimaryObjectPlanCaptureBodyIrWordDetail(plan.error.bodyIrDetail,
                                                          state.functionBodyIRs[functionIndex],
                                                          plan.error.wordRelOffset)
                if state.functionBodyIRs[functionIndex].terms.len > 0:
                    let term = state.functionBodyIRs[functionIndex].terms[state.functionBodyIRs[functionIndex].terms.len - 1]
                    plan.error.bodyIrDetail.lastTermKind = term.kind
                    plan.error.bodyIrDetail.lastTermResultSlot = term.resultSlot
                    if term.operands.len > 0:
                        plan.error.bodyIrDetail.lastTermOperand0 = term.operands[0]
                    if term.resultSlot >= 0 && term.resultSlot < state.functionBodyIRs[functionIndex].localSlots.len:
                        plan.error.bodyIrDetail.lastTermResultType = state.functionBodyIRs[functionIndex].localSlots[term.resultSlot].typeKind
                if state.functionBodyIRs[functionIndex].callSequence.len > 0:
                    let lastCallOrdinal = state.functionBodyIRs[functionIndex].callSequence.len - 1
                    let call = state.functionBodyIRs[functionIndex].callSequence[lastCallOrdinal]
                    plan.error.bodyIrDetail.lastCallTarget = call.targetSymbol
                    if functionIndex < lowering.primaryObjectIr.functions.len &&
                       lastCallOrdinal < lowering.primaryObjectIr.functions[functionIndex].callTargetSourcePaths.len:
                        plan.error.bodyIrDetail.lastCallTargetSourcePath = lowering.primaryObjectIr.functions[functionIndex].callTargetSourcePaths[lastCallOrdinal]
                    plan.error.bodyIrDetail.lastCallResultSlot = call.resultSlot
                    if call.resultSlot >= 0 && call.resultSlot < state.functionBodyIRs[functionIndex].localSlots.len:
                        plan.error.bodyIrDetail.lastCallResultType = state.functionBodyIRs[functionIndex].localSlots[call.resultSlot].typeKind
            if state.streamedEmitFirst:
                PrimaryObjectPlanMarkDeclOrderStreamBuildAbort(state,
                                                                functionIndex,
                                                                plan.symbolNames[functionIndex],
                                                                PrimaryObjectPlanFunctionSourcePathAt(lowering,
                                                                                                      functionIndex),
                                                                "post_release_zero_scan_failed")
                PrimaryObjectPlanReleaseAbortedBuildPayload(state, plan)
            break
    state.fillCheckAfterZeroScanRssBytes = PrimaryObjectPlanFillCheckSnapshot("after_zero_scan",
                                                                             state.functionBodyIRs,
                                                                             plan.instructionWords.len,
                                                                             state.relocSourceItemIds.len,
                                                                             state.dataLabels.len)
    plan.fillCheckAfterZeroScanRssBytes = state.fillCheckAfterZeroScanRssBytes
    PrimaryObjectPlanDebugLine("fill_check_done")

@borrows
fn PrimaryObjectPlanFinalizeErrorReceipt(state: PrimaryObjectPlanPhaseState,
                                         plan: var PrimaryObjectPlan) =
    if len(plan.error.functionName) <= 0:
        PrimaryObjectErrorCopy(plan.error, state.error)

fn PrimaryObjectPlanDiagnoseAndFinalizePhase(state: var PrimaryObjectPlanPhaseState,
                                              linkPlan: var slplan.SystemLinkPlanStub,
                                              lowering: var lower.LoweringPlanStub,
                                              plan: var PrimaryObjectPlan) =
    plan.streamedBuildAborted = state.streamedBuildAborted
    plan.streamedBuildAbortReason = state.streamedBuildAbortReason
    plan.fillCheckSkippedForBuildAbort = state.fillCheckSkippedForBuildAbort
    if state.needsRuntimeCommandData && !state.streamedBuildAborted:
        add(state.dataLabels, PrimaryTargetSymbolName(linkPlan.targetTriple, "__cheng_saved_argc"))
        add(state.dataPayloadTexts, "zero:8")
        add(state.dataLabels, PrimaryTargetSymbolName(linkPlan.targetTriple, "__cheng_saved_argv"))
        add(state.dataPayloadTexts, "zero:8")
    plan.dataLabels = state.dataLabels
    plan.dataPayloadTexts = state.dataPayloadTexts
    plan.dataPayloadRawBytes = state.dataPayloadRawBytes
    plan.dataPayloadRawByteCounts = state.dataPayloadRawByteCounts
    plan.relocSourceItemIds = state.relocSourceItemIds
    plan.relocWordOffsets = state.relocWordOffsets
    plan.relocTargetSymbols = state.relocTargetSymbols
    plan.relocTargetDomainKinds = state.relocTargetDomainKinds
    plan.relocTargetRows = state.relocTargetRows
    plan.relocTargetInterfaceCids = state.relocTargetInterfaceCids
    plan.relocCallTargetIdentityReceiptCid =
        PrimaryObjectPlanCallRelocIdentityReceiptCid(plan)
    var callRelocIdentityErr: str
    if !PrimaryObjectPlanCallRelocIdentityStrictValidateInto(
           plan, callRelocIdentityErr):
        panic(callRelocIdentityErr)
    plan.dataRelocSourceItemIds = state.dataRelocSourceItemIds
    plan.dataRelocWordOffsets = state.dataRelocWordOffsets
    plan.dataRelocTargetSymbols = state.dataRelocTargetSymbols
    plan.reachableFunctionCount = 0
    for i in 0..<state.reachable.len:
        if state.reachable[i]:
            plan.reachableFunctionCount = plan.reachableFunctionCount + 1
    PrimaryObjectPlanFinalizeErrorReceipt(state, plan)
    # Phase 3b: export the full not_ready list (one entry per blocked function),
    # not just the first. Diagnostic builds skip-and-continue so this enumerates
    # every blocker in a single driver run.
    plan.errors = state.errors
    plan.typedIrTypeLayoutCount = lowering.typedIr.typeLayoutNames.len
    plan.typedIrTypeFieldCount = lowering.typedIr.typeFieldOwnerTypes.len
    plan.typedIrTypeFieldSourcePathCount = lowering.typedIr.typeFieldSourcePaths.len
    plan.typedIrTypeFieldNameCount = lowering.typedIr.typeFieldNames.len
    plan.typedIrTypeFieldTypeCount = lowering.typedIr.typeFieldTypes.len
    plan.typedIrTypeFieldOffsetCount = lowering.typedIr.typeFieldOffsetBytes.len
    plan.typedIrTypeFieldSizeCount = lowering.typedIr.typeFieldSizeBytes.len
    plan.typedIrTypeFieldAlignCount = lowering.typedIr.typeFieldAlignBytes.len
    plan.typedIrTypeDefAliasCount = lowering.typedIr.typeDefAliasNames.len
    plan.typedIrChengMemHeaderPtrAliasCount = PrimaryObjectTypedIrTypeDefAliasCount(lowering.typedIr,
                                                                                    "ChengMemHeaderPtr",
                                                                                    "ChengMemHeader*")
    plan.typedIrColdCsgTypeRowCount = lowering.typedIr.coldCsgTypeRows.len
    plan.typedIrLocalBindingCount = lowering.typedIr.localBindingNames.len
    plan.typedIrChengMemHeaderRcFieldCount = PrimaryObjectTypedIrFieldCount(lowering.typedIr,
                                                                            "ChengMemHeader",
                                                                            "rc")
    plan.typedIrChengMemHeaderRcFieldType = PrimaryObjectTypedIrFieldTypeText(lowering.typedIr,
                                                                              "ChengMemHeader",
                                                                              "rc")
    plan.typedIrChengMemHeaderRcFieldOffset = PrimaryObjectTypedIrFieldMetric(lowering.typedIr,
                                                                              "ChengMemHeader",
                                                                              "rc",
                                                                              "offset")
    plan.typedIrChengMemHeaderRcFieldSize = PrimaryObjectTypedIrFieldMetric(lowering.typedIr,
                                                                            "ChengMemHeader",
                                                                            "rc",
                                                                            "size")
    plan.typedIrChengMemHeaderRcFieldAlign = PrimaryObjectTypedIrFieldMetric(lowering.typedIr,
                                                                             "ChengMemHeader",
                                                                             "rc",
                                                                             "align")
    plan.missingReasons = PrimaryObjectMissingReasons(linkPlan,
                                                        lowering,
                                                        state.itemIds,
                                                        plan.instructionWords,
                                                        state.bodySemanticsMissing,
                                                        state.streamedBuildAborted)
    plan.pipelineStage = "lowering_plan_to_primary_object_plan"
    if plan.missingReasons.len > 0:
        PrimaryObjectPlanDebugError("first_missing", plan.error)

@borrows
fn PrimaryObjectPlanSevenStageReceiptObserveObjectBytes(
        plan: PrimaryObjectPlan,
        objectBytes: rawbytes.Bytes): bool =
    if !ssr.SevenStageReceiptActive():
        return true
    if rawbytes.BytesLen(objectBytes) <= 0:
        return false
    var lane = ssr.SevenStageReceiptLanePrimary
    var contentStage = ssr.SevenStageReceiptStagePrimary
    var regallocStage = ssr.SevenStageReceiptStagePrimaryRegalloc
    var contentProducerSource =
        "src/core/backend/direct_object_emit.cheng"
    var regallocProducerSource =
        "src/core/backend/regalloc_production_emitter.cheng"
    if plan.actualBackendKind == "backend2":
        lane = ssr.SevenStageReceiptLaneBackend2
        contentStage = ssr.SevenStageReceiptStageBackend2
        regallocStage = ssr.SevenStageReceiptStageBackend2Regalloc
        regallocProducerSource =
            "src/core/backend2/backend2_assemble.cheng"
    elif plan.actualBackendKind != "primary":
        return false
    var identity = ssr.SevenStageSourceIdentityCurrent()
    let objectRaw32 =
        hash256.Sha256Fixed(layout.ByteSpanFromBytes(objectBytes))
    let objectSha256 = layout.FixedBytes32Hex(objectRaw32)
    var contentParts: str[]
    add(contentParts,
        "schema=cheng.compiler.production_object_bytes\n")
    add(contentParts,
        Fmt"lane={lane}\ntarget={plan.targetTriple}\nobject_format={plan.objectFormat}\nobject_byte_length={strings.IntToStr(rawbytes.BytesLen(objectBytes))}\nobject_sha256={objectSha256}\nfunction_count={strings.IntToStr(plan.regallocEmissionLedgerSinglePayloads.len)}\n")
    for functionIndex in
            0..<plan.regallocEmissionLedgerSinglePayloads.len:
        let payload =
            plan.regallocEmissionLedgerSinglePayloads[functionIndex]
        let payloadHex =
            rawbytes.BytesToHex(rawbytes.BytesFromString(payload))
        add(contentParts,
            Fmt"function={strings.IntToStr(functionIndex)}\tbyte_length={strings.IntToStr(len(payload))}\tpayload_hex={payloadHex}\tplan_sha256={plan.regallocFunctionPlanSha256s[functionIndex]}\taction_root_sha256={plan.regallocFunctionActionSemanticRootSha256s[functionIndex]}\tmachine_fragment_root_sha256={plan.regallocFunctionMachineFragmentRootSha256s[functionIndex]}\n")
        let deferStart =
            plan.regallocFunctionDeferReceiptStarts[functionIndex]
        let deferCount =
            plan.regallocFunctionDeferReceiptCounts[functionIndex]
        for deferRow in deferStart..<(deferStart + deferCount):
            add(contentParts,
                Fmt"defer\tfunction={strings.IntToStr(functionIndex)}\tfunction_row={strings.IntToStr(plan.regallocDeferFunctionRows[deferRow])}\tstatement_row={strings.IntToStr(plan.regallocDeferStatementRows[deferRow])}\ttarget={plan.targetTriple}\taction_cid={layout.FixedBytes32Hex(plan.regallocDeferActionCids[deferRow])}\tfragment_cid={layout.FixedBytes32Hex(plan.regallocDeferFragmentCids[deferRow])}\n")
    let contentArtifact = strutil.Join(contentParts, "")
    if !ssr.SevenStageReceiptObserve(
           contentStage,
           lane,
           identity,
           contentProducerSource,
           rawbytes.BytesFromString(contentArtifact),
           objectBytes):
        return false

    var regallocSidecarParts: str[]
    add(regallocSidecarParts,
        "schema=cheng.compiler.regalloc_object_binding\n")
    add(regallocSidecarParts,
        Fmt"lane={lane}\ntarget={plan.targetTriple}\nobject_format={plan.objectFormat}\nobject_byte_length={strings.IntToStr(rawbytes.BytesLen(objectBytes))}\nobject_sha256={objectSha256}\nfunction_count={strings.IntToStr(plan.regallocFrozenSnapshotSinglePayloads.len)}\n")
    for functionIndex in
            0..<plan.regallocFrozenSnapshotSinglePayloads.len:
        let payload =
            plan.regallocFrozenSnapshotSinglePayloads[functionIndex]
        let payloadHex =
            rawbytes.BytesToHex(rawbytes.BytesFromString(payload))
        add(regallocSidecarParts,
            Fmt"function={strings.IntToStr(functionIndex)}\tbyte_length={strings.IntToStr(len(payload))}\tpayload_hex={payloadHex}\tplan_sha256={plan.regallocFunctionPlanSha256s[functionIndex]}\taction_root_sha256={plan.regallocFunctionActionSemanticRootSha256s[functionIndex]}\taction_ledger_root_sha256={plan.regallocFunctionActionLedgerRootSha256s[functionIndex]}\tmachine_fragment_root_sha256={plan.regallocFunctionMachineFragmentRootSha256s[functionIndex]}\tabi_ingress_root_sha256={plan.regallocFunctionAbiIngressRootSha256s[functionIndex]}\n")
        let deferStart =
            plan.regallocFunctionDeferReceiptStarts[functionIndex]
        let deferCount =
            plan.regallocFunctionDeferReceiptCounts[functionIndex]
        for deferRow in deferStart..<(deferStart + deferCount):
            add(regallocSidecarParts,
                Fmt"defer\tfunction={strings.IntToStr(functionIndex)}\tfunction_row={strings.IntToStr(plan.regallocDeferFunctionRows[deferRow])}\tstatement_row={strings.IntToStr(plan.regallocDeferStatementRows[deferRow])}\ttarget={plan.targetTriple}\taction_cid={layout.FixedBytes32Hex(plan.regallocDeferActionCids[deferRow])}\tfragment_cid={layout.FixedBytes32Hex(plan.regallocDeferFragmentCids[deferRow])}\n")
    let regallocSidecar = strutil.Join(regallocSidecarParts, "")
    if !ssr.SevenStageReceiptObserve(
           regallocStage,
           lane,
           identity,
           regallocProducerSource,
           rawbytes.BytesFromString(regallocSidecar),
           objectBytes):
        return false
    return true

fn BuildPrimaryObjectPlanInto(linkPlan: var slplan.SystemLinkPlanStub,
                                lowering: var lower.LoweringPlanStub,
                                plan: var PrimaryObjectPlan) =
    var state: PrimaryObjectPlanPhaseState
    PrimaryObjectPlanRegallocFunctionIndexInit(
        plan, lowering.functionNames.len + 1)
    let traceEnabled = PrimaryObjectPlanTraceActive()
    plan.actualPipelineStage = "lowering_plan_to_primary_object_plan"
    plan.actualBackendKind = "primary"
    # plan.targetTriple 是 plan 身份, 必须早于 BuildItemsPhase 的 decl-order
    # stream 发射就位 — RegallocProductionEmitFunction 在流内消费它做
    # TargetUsesCanonicalRegalloc 门禁; FillAndCheckPhase 的同名赋值是重申。
    plan.targetTriple = linkPlan.targetTriple
    plan.actualNodeEvalOnlyActive = PrimaryBodyIrNodeEvalOnlyActive()
    plan.seqAddCandidateCount = 0
    plan.seqAddTypedContractCount = 0
    plan.structuredSeqAddConsumeCount = 0
    plan.seqAddNodeProbeHitCount = 0
    plan.seqAddTypeMismatchCount = 0
    plan.seqAddLegacyTextConsumeCount = 0
    plan.seqAddNodeEvalGapCount = 0
    plan.structuredResultIntrinsicConsumeCount = 0
    if plan.exactFunctionRequested:
        if plan.exactFunctionTypedFunctionIndex < 0:
            panic("primary object plan: invalid exact-function typed index")
    else:
        plan.exactFunctionTypedFunctionIndex = -1
    plan.exactFunctionPrimaryMatchCount = 0
    plan.exactFunctionBodyIrCapturedBeforeRelease = false
    plan.exactFunctionBodyIrOpCount = 0
    plan.exactFunctionBodyIrTermCount = 0
    plan.exactFunctionBodyIrBlockCount = 0
    plan.exactFunctionBodyIrLocalSlotCount = 0
    PrimaryObjectPlanSetPackedStackArgsForTriple(linkPlan.targetTriple)
    PrimaryObjectPlanSetSibRouteForTriple(linkPlan.targetTriple)
    PrimaryBodyIrResetLookupCaches()
    PrimaryBodyIrPrepareFunctionLookupCache(lowering.typedIr)
    if false:
        plan = PrimaryObjectPlan()
    if traceEnabled:
        PrimaryObjectPlanTrace("primary_object_plan_after_plan_init_skip")
    if false:
        PrimaryObjectPlanProgress("init_begin")
    PrimaryObjectPlanInitPhase(state, linkPlan, lowering)
    if traceEnabled:
        PrimaryObjectPlanTrace("primary_object_plan_after_init_phase")
    if PrimaryObjectPlanDebugEnabled():
        PrimaryObjectPlanDebugLine(Fmt"after_init functions={lowering.functionNames.len}")
    if false:
        PrimaryObjectPlanProgress("init_done")
        PrimaryObjectPlanProgress("link_begin")
    PrimaryObjectPlanLinkPhase(state, linkPlan, lowering)
    if traceEnabled:
        PrimaryObjectPlanTrace(Fmt"primary_object_plan_after_link_phase frontier={state.frontier.len}")
    var emitAllText = "0"
    if state.emitObjectRootsAllFunctions:
        emitAllText = "1"
    if PrimaryObjectPlanDebugEnabled():
        PrimaryObjectPlanDebugLine(Fmt"after_link frontier={state.frontier.len} exported={state.exportedFunctionCount} entry={state.entryFunctionCount} emit_all={emitAllText}")
    if false:
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"link_done frontier={state.frontier.len}")
        PrimaryObjectPlanProgress("lowering_begin")
    let _ = PrimaryObjectPlanDeclOrderStreamEnabled(linkPlan)
    PrimaryObjectPlanPrepareDeclOrderStreamReachability(state,
                                                        linkPlan,
                                                        lowering,
                                                        plan)
    PrimaryObjectPlanLoweringPhase(state, lowering, linkPlan.targetTriple, linkPlan.emitKind)
    if traceEnabled:
        PrimaryObjectPlanTrace("primary_object_plan_after_lowering_phase")
    PrimaryObjectPlanDebugLine("after_lowering")
    if false:
        PrimaryObjectPlanProgress("lowering_done")
        PrimaryObjectPlanProgress("reachability_begin")
    PrimaryObjectPlanReachabilityPhase(state, lowering, plan, linkPlan.targetTriple)
    if traceEnabled:
        PrimaryObjectPlanTrace("primary_object_plan_after_reachability_phase")
    PrimaryObjectPlanDebugLine("after_reachability")
    PrimaryObjectPlanLoweringPhase(state, lowering, linkPlan.targetTriple, linkPlan.emitKind)
    if traceEnabled:
        PrimaryObjectPlanTrace("primary_object_plan_after_reachability_lowering_phase")
    PrimaryObjectPlanDebugLine("after_reachability_lowering")
    for closurePass in 0..<lowering.functionNames.len:
        let reachableBefore = PrimaryObjectPlanReachableStateCount(state)
        PrimaryObjectPlanRefreshFrontierFromReachable(state)
        if state.frontier.len <= 0:
            break
        if PrimaryObjectPlanDebugEnabled():
            PrimaryObjectPlanDebugLine(Fmt"post_lowering_reachability_begin pass={closurePass} frontier={state.frontier.len} reachable={reachableBefore}")
        PrimaryObjectPlanReachabilityPhase(state, lowering, plan, linkPlan.targetTriple)
        let reachableAfter = PrimaryObjectPlanReachableStateCount(state)
        PrimaryObjectPlanLoweringPhase(state, lowering, linkPlan.targetTriple, linkPlan.emitKind)
        if PrimaryObjectPlanDebugEnabled():
            PrimaryObjectPlanDebugLine(Fmt"post_lowering_reachability_done pass={closurePass} reachable={reachableAfter}")
        if reachableAfter <= reachableBefore:
            break
        if closurePass + 1 >= lowering.functionNames.len:
            panic("primary object: reachability fixed point did not converge")
    PrimaryObjectPlanDebugLine("after_post_lowering_reachability")
    if false:
        PrimaryObjectPlanProgress("reachability_done")
        PrimaryObjectPlanProgress("build_items_begin")
    PrimaryObjectPlanBuildItemsPhase(state, linkPlan, lowering, plan)
    if traceEnabled:
        PrimaryObjectPlanTrace(Fmt"primary_object_plan_after_build_items_phase total_words={state.totalWordCount}")
    PrimaryObjectPlanDebugLine("after_build_items")
    PrimaryBodyIrResetLookupCaches()
    if false:
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"build_items_done total_words={state.totalWordCount}")
        PrimaryObjectPlanProgress("fill_check_begin")
    PrimaryObjectPlanFillAndCheckPhase(state, linkPlan, lowering, plan)
    if traceEnabled:
        PrimaryObjectPlanTrace("primary_object_plan_after_fill_check_phase")
    PrimaryObjectPlanDebugLine("after_fill_check")
    if false:
        PrimaryObjectPlanProgress("fill_check_done")
        PrimaryObjectPlanProgress("diagnose_finalize_begin")
    PrimaryObjectPlanDiagnoseAndFinalizePhase(state, linkPlan, lowering, plan)
    if traceEnabled:
        PrimaryObjectPlanTrace("primary_object_plan_after_diagnose_finalize_phase")
    if PrimaryObjectPlanDebugEnabled():
        PrimaryObjectPlanDebugLine(Fmt"after_diagnose_finalize reachable={plan.reachableFunctionCount} missing={plan.missingReasons.len}")
    PrimaryBindingTierProbeDump()
    let receiptRowCount = state.seqAddCandidateCountPerIndex.len
    if state.seqAddTypedContractCountPerIndex.len != receiptRowCount ||
       state.structuredSeqAddConsumeCountPerIndex.len != receiptRowCount ||
       state.seqAddNodeProbeHitCountPerIndex.len != receiptRowCount ||
       state.seqAddTypeMismatchCountPerIndex.len != receiptRowCount ||
       state.seqAddLegacyTextConsumeCountPerIndex.len != receiptRowCount ||
       state.seqAddNodeEvalGapCountPerIndex.len != receiptRowCount ||
       state.structuredResultIntrinsicConsumeCountPerIndex.len != receiptRowCount:
        panic("primary_object_receipt_array_shape_invalid")
    for receiptIndex in 0..<receiptRowCount:
        if !PrimarySeqAddReceiptCountersValid(
            state.seqAddCandidateCountPerIndex[receiptIndex],
            state.seqAddTypedContractCountPerIndex[receiptIndex],
            state.structuredSeqAddConsumeCountPerIndex[receiptIndex],
            state.seqAddNodeProbeHitCountPerIndex[receiptIndex],
            state.seqAddTypeMismatchCountPerIndex[receiptIndex],
            state.seqAddLegacyTextConsumeCountPerIndex[receiptIndex],
            state.seqAddNodeEvalGapCountPerIndex[receiptIndex],
            state.structuredResultIntrinsicConsumeCountPerIndex[receiptIndex]
        ):
            panic("primary_object_receipt_semantic_relation_invalid")
    var receiptAggregateNext: int32
    for receiptIndex in 0..<state.seqAddCandidateCountPerIndex.len:
        if !PrimaryObjectPlanReceiptCounterAddChecked(
               plan.seqAddCandidateCount,
               state.seqAddCandidateCountPerIndex[receiptIndex],
               receiptAggregateNext):
            panic("primary_object_receipt_candidate_count_overflow")
        plan.seqAddCandidateCount = receiptAggregateNext
    for receiptIndex in 0..<state.seqAddTypedContractCountPerIndex.len:
        if !PrimaryObjectPlanReceiptCounterAddChecked(
               plan.seqAddTypedContractCount,
               state.seqAddTypedContractCountPerIndex[receiptIndex],
               receiptAggregateNext):
            panic("primary_object_receipt_contract_count_overflow")
        plan.seqAddTypedContractCount = receiptAggregateNext
    for receiptIndex in 0..<state.structuredSeqAddConsumeCountPerIndex.len:
        if !PrimaryObjectPlanReceiptCounterAddChecked(
               plan.structuredSeqAddConsumeCount,
               state.structuredSeqAddConsumeCountPerIndex[receiptIndex],
               receiptAggregateNext):
            panic("primary_object_receipt_seq_consume_count_overflow")
        plan.structuredSeqAddConsumeCount = receiptAggregateNext
    for receiptIndex in 0..<state.seqAddNodeProbeHitCountPerIndex.len:
        if !PrimaryObjectPlanReceiptCounterAddChecked(
               plan.seqAddNodeProbeHitCount,
               state.seqAddNodeProbeHitCountPerIndex[receiptIndex],
               receiptAggregateNext):
            panic("primary_object_receipt_probe_count_overflow")
        plan.seqAddNodeProbeHitCount = receiptAggregateNext
    for receiptIndex in 0..<state.seqAddTypeMismatchCountPerIndex.len:
        if !PrimaryObjectPlanReceiptCounterAddChecked(
               plan.seqAddTypeMismatchCount,
               state.seqAddTypeMismatchCountPerIndex[receiptIndex],
               receiptAggregateNext):
            panic("primary_object_receipt_mismatch_count_overflow")
        plan.seqAddTypeMismatchCount = receiptAggregateNext
    for receiptIndex in 0..<state.seqAddLegacyTextConsumeCountPerIndex.len:
        if !PrimaryObjectPlanReceiptCounterAddChecked(
               plan.seqAddLegacyTextConsumeCount,
               state.seqAddLegacyTextConsumeCountPerIndex[receiptIndex],
               receiptAggregateNext):
            panic("primary_object_receipt_legacy_count_overflow")
        plan.seqAddLegacyTextConsumeCount = receiptAggregateNext
    for receiptIndex in 0..<state.seqAddNodeEvalGapCountPerIndex.len:
        if !PrimaryObjectPlanReceiptCounterAddChecked(
               plan.seqAddNodeEvalGapCount,
               state.seqAddNodeEvalGapCountPerIndex[receiptIndex],
               receiptAggregateNext):
            panic("primary_object_receipt_gap_count_overflow")
        plan.seqAddNodeEvalGapCount = receiptAggregateNext
    for receiptIndex in 0..<state.structuredResultIntrinsicConsumeCountPerIndex.len:
        if !PrimaryObjectPlanReceiptCounterAddChecked(
               plan.structuredResultIntrinsicConsumeCount,
               state.structuredResultIntrinsicConsumeCountPerIndex[receiptIndex],
               receiptAggregateNext):
            panic("primary_object_receipt_result_consume_count_overflow")
        plan.structuredResultIntrinsicConsumeCount = receiptAggregateNext
    PrimaryBodyIrResetLookupCaches()
    if false:
        PrimaryObjectPlanProgress("diagnose_finalize_done")
    var debugSectionPlanErr: str
    if !PrimaryObjectPlanConsumeDebugSectionPlanReceiptInto(
           lowering, plan, debugSectionPlanErr):
        panic(Fmt"primary debug section plan receipt: {debugSectionPlanErr}")

fn BuildPrimaryObjectPlanWithExactFunctionInto(linkPlan: var slplan.SystemLinkPlanStub,
                                                 lowering: var lower.LoweringPlanStub,
                                                 exactFunctionTypedIndex: int32,
                                                 plan: var PrimaryObjectPlan) =
    plan.exactFunctionRequested = true
    plan.exactFunctionTypedFunctionIndex = exactFunctionTypedIndex
    BuildPrimaryObjectPlanInto(linkPlan, lowering, plan)

fn BuildPrimaryObjectPlan(linkPlan: slplan.SystemLinkPlanStub,
                            lowering: var lower.LoweringPlanStub): PrimaryObjectPlan =
    var linkPlanLocal = linkPlan
    var loweringLocal = lowering
    var plan: PrimaryObjectPlan
    BuildPrimaryObjectPlanInto(linkPlanLocal, loweringLocal, plan)
    return plan

@borrows
fn PrimaryObjectPlanIntListText(items: int32[]): str =
    if items.len <= 0:
        return "-"
    # str[] + Join 避免 out = Fmt"{out}..." 的 O(L^2) 串复制。
    var parts: str[]
    for i in 0..<items.len:
        if i > 0:
            add(parts, ",")
        add(parts, strings.IntToStr(items[i]))
    return strutil.Join(parts, "")

fn PrimaryObjectPlanStatementTraceText(irFunction: var lower.PrimaryObjectIrFunction): str =
    if irFunction.statements.len <= 0:
        return "-"
    # 用 str[] + 末尾单次 Join 收集每条 statement 的 trace 片段, 避免 out = Fmt"{out}..."
    # 在 N 条 statement 上 O(N^2) 复制整个累积串 (findings 06-27 点名的 RSS 尖峰主犯)。
    var parts: str[]
    for stmtIndex in 0..<irFunction.statements.len:
        let stmt = irFunction.statements[stmtIndex]
        if stmtIndex > 0:
            add(parts, "|")
        var returnRootText = "0"
        if stmt.returnRoot:
            returnRootText = "1"
        add(parts, Fmt"{strings.IntToStr(stmtIndex)}:{strings.IntToStr(stmt.lineNumber)}:{PrimaryObjectStatementKindCodeText(int32(stmt.kind))}:returnRoot={returnRootText}:binding={stmt.bindingName}:type={stmt.resultType}:target={stmt.callTarget}:targetSource={stmt.callTargetSourcePath}:targetImportc={stmt.callTargetImportc}:argc={strings.IntToStr(stmt.callArgCount)}:args={stmt.callArgsText}:root={stmt.assignRootName}:rootType={stmt.assignRootType}:field={stmt.assignFieldName}:fieldType={stmt.assignFieldType}:fieldOffset={strings.IntToStr(stmt.assignFieldOffsetBytes)}:fieldSize={strings.IntToStr(stmt.assignFieldSizeBytes)}:valueOp={texpr.TypedExprIrOpKindText(stmt.assignValueOpKind)}:valueLhs={stmt.assignValueLhsText}:valueRhs={stmt.assignValueRhsText}:valueElse={stmt.conditionRhsText}:surface={stmt.surfaceText}")
    if parts.len <= 0:
        return "-"
    return strutil.Join(parts, "")

@borrows
fn PrimaryObjectPlanParamTraceText(irFunction: lower.PrimaryObjectIrFunction): str =
    if irFunction.paramNames.len <= 0:
        return "-"
    # str[] + Join 避免 out = Fmt"{out}..." 的 O(L^2) 串复制。
    var parts: str[]
    for i in 0..<irFunction.paramNames.len:
        if i > 0:
            add(parts, "|")
        var paramType = ""
        if i < irFunction.paramTypes.len:
            paramType = irFunction.paramTypes[i]
        add(parts, Fmt"{strings.IntToStr(i)}:{irFunction.paramNames[i]}:{paramType}")
    if parts.len <= 0:
        return "-"
    return strutil.Join(parts, "")

fn PrimaryObjectPlanCaptureErrorStatementTrace(error: var PrimaryObjectError,
                                                lowering: var lower.LoweringPlanStub,
                                                irIndex: int32) =
    if len(error.statementTrace) > 0:
        return
    if irIndex < 0 || irIndex >= lowering.primaryObjectIr.functions.len:
        return
    # StatementTraceText 形参是 var(纯读, 未写字段), 但元素级数组下标直接作
    # var 实参的语法形状与 C5 铁律同源隐患: 经局部 var 落地后传, 消除该形状
    # 即便当前无写发生。
    var traceRow = lowering.primaryObjectIr.functions[irIndex]
    error.statementTrace = PrimaryObjectPlanStatementTraceText(traceRow)
    error.paramTrace = PrimaryObjectPlanParamTraceText(lowering.primaryObjectIr.functions[irIndex])

@borrows
fn PrimaryObjectPlanAppendLine(out: var str, key: str, value: str) =
    out = Fmt"{out}{key}={value}\n"

fn PrimaryObjectPlanRetainedBodyIrFunctionCount(plan: var PrimaryObjectPlan): int32 =
    var count: int32
    for i in 0..<plan.functionBodyIRs.len:
        let bodyIR = plan.functionBodyIRs[i]
        if bodyIR.ops.len > 0 ||
           bodyIR.terms.len > 0 ||
           bodyIR.blocks.len > 0 ||
           bodyIR.callSequence.len > 0 ||
           bodyIR.localSlots.len > 0 ||
           bodyIR.cstringLiterals.len > 0:
            count = count + 1
    return count

fn PrimaryObjectPlanRetainedBodyIrPayloadItemCount(plan: var PrimaryObjectPlan): int32 =
    var count: int32
    for i in 0..<plan.functionBodyIRs.len:
        let bodyIR = plan.functionBodyIRs[i]
        count = count + bodyIR.ops.len
        count = count + bodyIR.callSequence.len
        count = count + bodyIR.localSlots.len
        count = count + bodyIR.blocks.len
        count = count + bodyIR.terms.len
        count = count + bodyIR.cstringLiterals.len
        for opIndex in 0..<bodyIR.ops.len:
            count = count + bodyIR.ops[opIndex].operands.len
        for termIndex in 0..<bodyIR.terms.len:
            count = count + bodyIR.terms[termIndex].operands.len
        for callIndex in 0..<bodyIR.callSequence.len:
            count = count + bodyIR.callSequence[callIndex].argSlots.len
            count = count + bodyIR.callSequence[callIndex].argPassKinds.len
    return count

fn PrimaryObjectPlanRetainedCompactItemCount(plan: var PrimaryObjectPlan): int32 =
    return plan.instructionWords.len +
           plan.relocSourceItemIds.len +
           plan.relocWordOffsets.len +
           plan.relocTargetSymbols.len +
           plan.relocTargetDomainKinds.len +
           plan.relocTargetRows.len +
           plan.relocTargetInterfaceCids.len +
           plan.dataRelocSourceItemIds.len +
           plan.dataRelocWordOffsets.len +
           plan.dataRelocTargetSymbols.len +
           plan.dataLabels.len +
           plan.dataPayloadTexts.len +
           plan.dataPayloadRawBytes.len

fn PrimaryObjectPlanRetainedApproxBytes(plan: var PrimaryObjectPlan): int64 =
    let bodyIrBytes = int64(PrimaryObjectPlanRetainedBodyIrPayloadItemCount(plan)) * int64(32)
    let compactBytes = int64(PrimaryObjectPlanRetainedCompactItemCount(plan)) * int64(8)
    let functionBytes = int64(plan.symbolNames.len + plan.functionBodyKinds.len + plan.functionWordOffsets.len + plan.functionWordCounts.len) * int64(24)
    return bodyIrBytes + compactBytes + functionBytes

fn PrimaryObjectPlanBodyIrStructuredLiveBytes(plan: var PrimaryObjectPlan): int64 =
    return int64(PrimaryObjectPlanRetainedBodyIrPayloadItemCount(plan)) * int64(32)

fn PrimaryObjectPlanStructuredLiveBytes(plan: var PrimaryObjectPlan): int64 =
    return PrimaryObjectPlanRetainedApproxBytes(plan)

fn primaryObjectPlanRetainedRecordSequence(
        report: var PrimaryObjectPlanRetainedStorageReport,
        length: int32,
        capacity: int32,
        elementBytes: int32) =
    if length < 0 || capacity < 0 || length > capacity ||
       elementBytes <= 0:
        panic("primary object plan: invalid owned sequence shape")
    if capacity > 0:
        report.physicalBufferCount =
            report.physicalBufferCount + 1
        report.retainedBytes =
            report.retainedBytes +
            int64(capacity) * int64(elementBytes)

@borrows
fn primaryObjectPlanRetainedRecordString(
        report: var PrimaryObjectPlanRetainedStorageReport,
        value: str) =
    report.retainedBytes =
        report.retainedBytes + int64(value.len)

fn primaryObjectPlanRetainedRecordStringArray(
        report: var PrimaryObjectPlanRetainedStorageReport,
        values: var str[]) =
    primaryObjectPlanRetainedRecordSequence(
        report, values.len, values.cap, sizeof(str))
    for valueIndex in 0..<values.len:
        primaryObjectPlanRetainedRecordString(
            report, values[valueIndex])

fn primaryObjectPlanRetainedRecordError(
        report: var PrimaryObjectPlanRetainedStorageReport,
        error: var PrimaryObjectError) =
    primaryObjectPlanRetainedRecordString(
        report, error.functionName)
    primaryObjectPlanRetainedRecordString(
        report, error.functionSourcePath)
    primaryObjectPlanRetainedRecordString(
        report, error.bodyKind)
    primaryObjectPlanRetainedRecordString(
        report, error.typedIrKind)
    primaryObjectPlanRetainedRecordString(
        report, error.callTarget)
    primaryObjectPlanRetainedRecordString(
        report, error.callTargetSourcePath)
    primaryObjectPlanRetainedRecordString(
        report, error.statementTrace)
    primaryObjectPlanRetainedRecordString(
        report, error.paramTrace)
    primaryObjectPlanRetainedRecordString(
        report, error.bodyIrDetail.lastCallTarget)
    primaryObjectPlanRetainedRecordString(
        report, error.bodyIrDetail.lastCallTargetSourcePath)
    primaryObjectPlanRetainedRecordString(
        report, error.bodyIrDetail.firstZeroTargetSlotName)
    primaryObjectPlanRetainedRecordString(
        report, error.bodyIrDetail.firstZeroBaseSlotName)
    primaryObjectPlanRetainedRecordString(
        report, error.bodyIrDetail.firstZeroValueSlotName)
    primaryObjectPlanRetainedRecordString(
        report, error.bodyIrDetail.firstZeroSlotDiag)
    primaryObjectPlanRetainedRecordString(
        report, error.bodyIrDetail.firstZeroCallTarget)
    primaryObjectPlanRetainedRecordString(
        report, error.bodyIrDetail.firstZeroCallDiag)

fn primaryObjectPlanRetainedRecordFunctionIndex(
        report: var PrimaryObjectPlanRetainedStorageReport,
        index: var regart.RegallocProductionFunctionIndex) =
    primaryObjectPlanRetainedRecordSequence(
        report,
        index.normalFunctionIrIndexes.len,
        index.normalFunctionIrIndexes.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        index.normalFunctionIrIndexOccupied.len,
        index.normalFunctionIrIndexOccupied.cap,
        sizeof(bool))
    primaryObjectPlanRetainedRecordStringArray(
        report, index.symbols.map.keys)
    primaryObjectPlanRetainedRecordSequence(
        report,
        index.symbols.map.vals.len,
        index.symbols.map.vals.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        index.symbols.map.hashes.len,
        index.symbols.map.hashes.cap,
        sizeof(uint64))
    primaryObjectPlanRetainedRecordSequence(
        report,
        index.symbols.map.states.len,
        index.symbols.map.states.cap,
        sizeof(uint8))

fn primaryObjectPlanRetainedRecordDebugSectionPlan(
        report: var PrimaryObjectPlanRetainedStorageReport,
        receipt: var debugsectionplan.DebugSectionPlanReceipt) =
    primaryObjectPlanRetainedRecordString(
        report, receipt.backendKind)
    primaryObjectPlanRetainedRecordString(
        report, receipt.packageId)
    primaryObjectPlanRetainedRecordSequence(
        report,
        receipt.sourceIds.len,
        receipt.sourceIds.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordStringArray(
        report, receipt.sourceModulePaths)
    primaryObjectPlanRetainedRecordSequence(
        report,
        receipt.sourceDocumentCids.len,
        receipt.sourceDocumentCids.cap,
        sizeof(layout.FixedBytes32))
    primaryObjectPlanRetainedRecordStringArray(
        report, receipt.functionNames)
    primaryObjectPlanRetainedRecordSequence(
        report,
        receipt.functions.len,
        receipt.functions.cap,
        sizeof(debugsectionplan.DebugSectionPlanFunctionRow))
    for functionIndex in 0..<receipt.functions.len:
        primaryObjectPlanRetainedRecordString(
            report,
            receipt.functions[functionIndex].functionSymbolName)
        primaryObjectPlanRetainedRecordString(
            report,
            receipt.functions[
                functionIndex].plannedSymbolBytesSha256)
        primaryObjectPlanRetainedRecordString(
            report,
            receipt.functions[functionIndex].bodyIrSha256)
        primaryObjectPlanRetainedRecordString(
            report,
            receipt.functions[functionIndex].frozenPlanSha256)
        primaryObjectPlanRetainedRecordString(
            report,
            receipt.functions[functionIndex].regallocPlanSha256)
        primaryObjectPlanRetainedRecordString(
            report,
            receipt.functions[
                functionIndex].emissionLedgerSha256)
        primaryObjectPlanRetainedRecordString(
            report,
            receipt.functions[
                functionIndex].actionSemanticRootSha256)
        primaryObjectPlanRetainedRecordString(
            report,
            receipt.functions[
                functionIndex].actionBindingRootSha256)
        primaryObjectPlanRetainedRecordString(
            report,
            receipt.functions[
                functionIndex].machineFragmentRootSha256)
        primaryObjectPlanRetainedRecordString(
            report,
            receipt.functions[functionIndex].abiIngressRootSha256)
        primaryObjectPlanRetainedRecordString(
            report,
            receipt.functions[
                functionIndex].debugProvenanceSha256)
        primaryObjectPlanRetainedRecordString(
            report,
            receipt.functions[
                functionIndex].debugMachineFragmentRootSha256)
    primaryObjectPlanRetainedRecordSequence(
        report,
        receipt.rows.len,
        receipt.rows.cap,
        sizeof(debugsectionplan.DebugSectionPlanRow))
    for rowIndex in 0..<receipt.rows.len:
        primaryObjectPlanRetainedRecordString(
            report, receipt.rows[rowIndex].plannedBytesSha256)

fn PrimaryObjectPlanRetainedStorage(
        plan: var PrimaryObjectPlan):
        PrimaryObjectPlanRetainedStorageReport =
    var report: PrimaryObjectPlanRetainedStorageReport
    primaryObjectPlanRetainedRecordString(report, plan.targetTriple)
    primaryObjectPlanRetainedRecordString(
        report, plan.actualPipelineStage)
    primaryObjectPlanRetainedRecordString(
        report, plan.actualBackendKind)
    primaryObjectPlanRetainedRecordString(report, plan.objectFormat)
    primaryObjectPlanRetainedRecordString(report, plan.outputPath)
    primaryObjectPlanRetainedRecordString(report, plan.entryPath)
    primaryObjectPlanRetainedRecordString(report, plan.entrySymbol)
    primaryObjectPlanRetainedRecordString(
        report, plan.entryFunctionSymbol)
    primaryObjectPlanRetainedRecordSequence(
        report, plan.itemIds.len, plan.itemIds.cap, sizeof(int32))
    primaryObjectPlanRetainedRecordStringArray(
        report, plan.symbolNames)
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.symbolTypedFunctionIndexes.len,
        plan.symbolTypedFunctionIndexes.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.symbolNameIds.len,
        plan.symbolNameIds.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.symbolRoles.len,
        plan.symbolRoles.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.symbolInterfaceCids.len,
        plan.symbolInterfaceCids.cap,
        sizeof(layout.FixedBytes32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.functionWordOffsets.len,
        plan.functionWordOffsets.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.functionWordCounts.len,
        plan.functionWordCounts.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordStringArray(
        report, plan.functionBodyKinds)
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.functionStatementReturnModes.len,
        plan.functionStatementReturnModes.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.functionStatementReturnI32Values.len,
        plan.functionStatementReturnI32Values.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.functionStatementCallCounts.len,
        plan.functionStatementCallCounts.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.functionIrIndexes.len,
        plan.functionIrIndexes.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.functionBodyIRs.len,
        plan.functionBodyIRs.cap,
        sizeof(coreir.BodyIR))
    for bodyIndex in 0..<plan.functionBodyIRs.len:
        let retained =
            bodylifecycle.BodyIrPayloadRetained(
                plan.functionBodyIRs[bodyIndex])
        report.physicalBufferCount =
            report.physicalBufferCount +
            retained.physicalBufferCount
        report.retainedBytes =
            report.retainedBytes + retained.retainedBytes
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.instructionWords.len,
        plan.instructionWords.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordStringArray(
        report, plan.dataLabels)
    primaryObjectPlanRetainedRecordStringArray(
        report, plan.dataPayloadTexts)
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.dataPayloadRawBytes.len,
        plan.dataPayloadRawBytes.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.dataPayloadRawByteCounts.len,
        plan.dataPayloadRawByteCounts.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.relocSourceItemIds.len,
        plan.relocSourceItemIds.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.relocWordOffsets.len,
        plan.relocWordOffsets.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordStringArray(
        report, plan.relocTargetSymbols)
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.relocTargetDomainKinds.len,
        plan.relocTargetDomainKinds.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.relocTargetRows.len,
        plan.relocTargetRows.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.relocTargetInterfaceCids.len,
        plan.relocTargetInterfaceCids.cap,
        sizeof(layout.FixedBytes32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.dataRelocSourceItemIds.len,
        plan.dataRelocSourceItemIds.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.dataRelocWordOffsets.len,
        plan.dataRelocWordOffsets.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordStringArray(
        report, plan.dataRelocTargetSymbols)
    primaryObjectPlanRetainedRecordString(
        report, plan.bodyIREGraphReason)
    primaryObjectPlanRetainedRecordStringArray(
        report, plan.regallocFrozenSnapshotSinglePayloads)
    primaryObjectPlanRetainedRecordStringArray(
        report, plan.regallocEmissionLedgerSinglePayloads)
    primaryObjectPlanRetainedRecordStringArray(
        report, plan.regallocFunctionSymbols)
    primaryObjectPlanRetainedRecordSequence(
        report,
        plan.regallocFunctionIrIndexes.len,
        plan.regallocFunctionIrIndexes.cap,
        sizeof(int32))
    primaryObjectPlanRetainedRecordSequence(
        report,
