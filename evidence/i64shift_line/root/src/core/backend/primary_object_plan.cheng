            let probeReinterpretArgKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,

                                                                     typedFn,
                                                                     irFunction,
                                                                     probeReinterpretArgNode)
            if probeReinterpretArgKind < 0:
                return -1
            if probeReinterpretArgKind != coreir.LocalPtrTag &&
               probeReinterpretArgKind != coreir.LocalI64Tag:
                return PrimaryBodyIrNodeEvalMissAt("cast_arg_kind")
            return coreir.LocalPtrTag
        if PrimaryBodyIrPtrAliasReinterpretCastHead(lowering.typedIr, npSrc, probeCallHead):
            let probeAliasArgNode = PrimaryBodyIrPtrAliasReinterpretCastArgNodeIndex(lowering.typedIr,
                                                                                    npSrc,
                                                                                    nodeIndex)
            if probeAliasArgNode < 0:
                return PrimaryBodyIrNodeEvalMissAt("cast_arg_shape")
            let probeAliasArgKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering,

                                                               typedFn,
                                                               irFunction,
                                                               probeAliasArgNode)
            if probeAliasArgKind < 0:
                return -1
            if probeAliasArgKind != coreir.LocalPtrTag &&
               probeAliasArgKind != coreir.LocalI64Tag:
                return PrimaryBodyIrNodeEvalMissAt("cast_arg_kind")
            return coreir.LocalPtrTag
        var probeProjectionKind = coreir.BodyResultProjectInvalidTag
        if PrimaryBodyIrResultProjectionArgNodeIndex(lowering.typedIr,
                                                      nodeIndex,
                                                      probeProjectionKind) >= 0:
            let projectionResultKind = PrimaryBodyIrResultProjectionNodeProbe(
                bodyIR,
                slotNames,
                share(varI32ParamNames),
                lowering,

                share(typedFn),
                irFunction,
                nodeIndex)
