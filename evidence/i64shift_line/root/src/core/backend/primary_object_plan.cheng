                if fldRootKind == coreir.LocalAggregateTag || fldRootKind == coreir.LocalPtrTag:
                    let fldIdxSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                           slotNames,
                                                           varI32ParamNames,
                                                           lowering,

                                                           typedFn,
                                                           irFunction,
                                                           arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                                           callOrdinal)
                    if fldIdxSlot >= 0:
                        let fldIdxKind = PrimaryBodyIrSlotType(bodyIR, fldIdxSlot)
                        if fldIdxKind == coreir.LocalI32Tag || fldIdxKind == coreir.LocalI64Tag:
                            let fldElemTypeText = PrimaryBodyIrIndexedElementTypeText(idxBaseType)
                            if fldElemTypeText != "":
                                var fldElemShapeKind: int32
                                var fldElemShapeSize: int32
                                var fldElemShapeAlign: int32
                                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                               enSrc,
                                                               fldElemTypeText,
                                                               fldElemShapeKind,
                                                               fldElemShapeSize,
                                                               fldElemShapeAlign)
                                # Scalar-element fast path only: the element address
                                # feeds a single FieldLoad of width node.elemSizeBytes.
                                # When the element is an aggregate (shape size > load
                                # width, e.g. struct[N] read by value) the whole-field
                                # materialize path below is required — a width-elemSizeBytes
                                # load from a computed #faddr ptr would truncate it.
                                # T78 v4: require only shape>=load-width, not equality.
                                # A FIXED bool[N] struct field's front-end elemSizeBytes
                                # (node.elemSizeBytes) is the packed logical width (1B,
                                # TypedExprTypeLayout convention), but its true inline
                                # stride is the backend's aligned register width
                                # (fldElemShapeSize, bool=4B, TypeShapeFromText — same
                                # family as every other fixed-array elemSize consumer in
                                # this T78 series). The old `==` gate rejected this
                                # (4 != 1) and fell through to the whole-field-materialize
                                # path below, which copies only node.elemSizeBytes*count
                                # bytes (front-end packed size) into the temp aggregate
                                # slot and then indexes it at the ALIGNED stride computed
                                # further down (idxElemStride) — walking off the end of
                                # the undersized copy for index>0 (silent wrong value /
                                # stack-garbage read, adv_struct_field_arr_if/
                                # adv_struct_field_arr_noand). Taking this direct-address
                                # fast path instead (struct_base+field_offset+idx*aligned
                                # stride) sidesteps the undersized copy entirely; the
                                # FieldLoad below keeps the narrower node.elemSizeBytes
                                # width, which is correct at the aligned address (the
                                # logical value lives in the low bytes of each
                                # register-width-aligned slot, matching the store side).
                                let idxNodeElemSizeBytes = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_elemSizeBytes, nodeIndex)
                                # T78 v5: the >= widening above only re-derives the
                                # element stride; it says nothing about whether
                                # fldRootSlot (g in g.field[i]) is actually a simple,
                                # single-address root. When idxBaseNodeIndex's own
                                # base is an IndexGet (array-of-struct: xs[i].arr[j],
                                # confirmed via node inspection to hold even for a
                                # literal index like xs[0] — the front end does not
                                # constant-fold it away), the recursive eval below
                                # still returns an Aggregate/Ptr slot, but it is not
                                # guaranteed to be the per-index element address this
                                # fast path assumes — this combination was never in
                                # the verified fixture set and produced a
                                # data-independent constant (adv_nested_arrstruct_*
                                # regression) because the paired array-of-struct
                                # WRITE path stores at a different location (task
                                # #10, separately tracked). Require the base to be a
                                # bare identifier (ParamRef/LocalRef) or a
                                # single-hop FieldGet chain (s.t.arr[i], already
                                # verified to generalize correctly); anything else,
                                # in particular IndexGet, falls through to the
                                # existing whole-field-materialize path below.
                                let idxBaseFieldRootKind = lowering.typedIr.nodes2_opKinds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, idxBaseNodeIndex)]
                                # Task #147 root fix: xs[i].arr[j] (array-of-struct root,
                                # idxBaseFieldRootKind==IndexGet) does NOT have to fall
                                # through to the buggy whole-materialize path above (which
                                # walks off the end of an undersized copy — see that
                                # function's fallback code for the diagnosis). fldRootSlot
                                # already holds a byte-faithful materialized copy of xs[i]
                                # (the generic IndexGet evaluator above copies the full
                                # struct width from the live address regardless of element
                                # kind), so it is a valid SeqAddHeaderPtrSlot base — the
                                # ONLY defect was reusing fldElemShapeSize (the ALIGNED
                                # register-width stride, bool=4B) to index into that copy.
                                # Disassembly of the paired WRITE realizer for this exact
                                # shape (PrimaryBodyIrAppendNestedFixedArrayIndexedFieldStore)
                                # confirms it stores the field array at the PACKED width
                                # from PrimaryBodyIrSeqElementShapeFromText (bool=1B: `strb`
                                # at stride 1), not the aligned-4 family entry#16 uses for
                                # the ParamRef/LocalRef/FieldGet roots above — those two
                                # roots are written by a *different* store realizer
                                # (whole-field-owner is not array-indexed) that does use the
                                # aligned stride, so the two conventions must stay separate
                                # per root kind, not unified. Restrict the IndexGet case to
                                # a plain fixed array of structs (mirrors the store
                                # realizer's own `rootType` rejection of dynamic seqs) so a
                                # `seq[Elem]` root — addressed via a header+data-pointer
                                # indirection this fast path never computes — still falls
                                # through to the existing fallback untouched.
                                var fldAddrStride = fldElemShapeSize
                                var fldAddrStrideValid = true
                                var fldRootIsIndexGetFixedArray = false
                                if idxBaseFieldRootKind == texpr.TypedExprIrOpIndexGet:
                                    let outerIndexNodeIndex = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, idxBaseNodeIndex)
                                    let outerArrayNodeIndex = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, outerIndexNodeIndex)
                                    if outerArrayNodeIndex >= 0 && outerArrayNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                                        let outerArrayTypeRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[outerArrayNodeIndex])
                                        if IsOk(outerArrayTypeRes):
                                            let outerArrayType_f147: str = Value(outerArrayTypeRes)
                                            let outerArrayTypeText = texpr.TypedExprStripVarType(outerArrayType_f147)
                                            var fldOuterArrayCtx: texpr.TypedExprSourceContext
                                            fldOuterArrayCtx.sourcePath = typedFn.sourcePath
                                            if !PrimaryBodyIrTypeTextIsDynamicSeq(outerArrayTypeText) &&
                                               texpr.TypedExprIrTypeTextIsFixedArray(fldOuterArrayCtx, outerArrayTypeText):
                                                fldRootIsIndexGetFixedArray = true
                                    if fldRootIsIndexGetFixedArray:
                                        var fldPackedElemKind: int32
                                        var fldPackedElemSize: int32
                                        # Task #147 current (round27, narrowing round22's REFUTED
                                        # verdict): "reuses the write realizer's own shape
                                        # function" is only a *provable* read/write match when
                                        # that function's packed answer is 1 byte. It is 1 only
                                        # via the bool-specific T77 force-to-1 correction above
                                        # in this same function (or any other element kind whose
                                        # natural TypeShapeFromText answer already lands on 1) —
                                        # every width this fast path was seen to independently
                                        # regress on (int16[N] field arrays: iso_int16_v0g /
                                        # iso_int16_onlyfield / iso_int16_static, round22
                                        # adversarial A/B) is a packed size > 1 where no such
                                        # proof exists; the deeper aggregate-layout mismatch that
                                        # causes that regression is tracked separately (#148).
                                        # Gate on the numeric packed-size==1 structural fact
                                        # itself, not on comparing idxBaseType's element type
                                        # name — this keeps every other packed width (2/4/8)
                                        # falling through unchanged to the existing whole-
                                        # materialize fallback below, i.e. exactly the baseline
                                        # behavior for those widths (no new regression, no gain).
                                        fldAddrStrideValid = PrimaryBodyIrSeqElementShapeFromText(lowering.typedIr, enSrc, idxBaseType, fldPackedElemKind, fldPackedElemSize) && fldPackedElemSize == 1
