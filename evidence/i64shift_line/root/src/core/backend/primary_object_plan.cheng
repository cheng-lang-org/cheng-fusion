            let probeStrDataArgLink = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)
            if probeStrDataArgLink < 0 ||
               probeStrDataArgLink >= lowering.typedIr.nodes2_nodeIndexs.len ||
