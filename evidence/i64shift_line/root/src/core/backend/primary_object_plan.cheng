    PrimaryObjectPlanAppendLine(out, "backend2_assembler_temp_physical_free_count", strings.Int64ToStr(plan.backend2AssemblerTempPhysicalFreeCount))
    PrimaryObjectPlanAppendLine(out, "backend2_assembler_temp_ledger_storage_released", if plan.backend2AssemblerTempLedgerStorageReleased: "1" else: "0")
    PrimaryObjectPlanAppendLine(out, "primary_object_word_fill_schedule", plan.wordFillSchedule)
