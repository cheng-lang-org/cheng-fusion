                                                                        stmt_sourcePath,
                                                                        stmt_lineNumber,
                                                                        stmt_assignRootName,
                                                                        assignRootType,
                                                                        nestedOuterIdxText,
                                                                        indexedFieldName,
                                                                        indexedFieldIndexText,
                                                                        rhsText,
                                                                        baseSlot,
                                                                        varI32ParamNames,
                                                                        callOrdinal):
