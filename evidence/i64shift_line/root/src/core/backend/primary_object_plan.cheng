            if lowering.typedIr.nodes2_opKinds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex)] == texpr.TypedExprIrOpStrLit:
                if PrimaryBodyIrTextIsStringLiteral(npOp1Lit):
                    probeStrCmpValueNode = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)
            if probeStrCmpValueNode < 0 &&
