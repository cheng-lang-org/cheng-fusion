            var evalProjectionInner = ""
            var evalProjectionResultKind: int32
            var evalProjectionResultSize: int32
            var evalProjectionResultAlign: int32
            var evalProjectionOffset: int32
            var evalProjectionErrMsgOffset: int32
            var evalProjectionSourceTotalSize: int32
            if !PrimaryBodyIrResultProjectionNodeShape(
                lowering.typedIr,
                nodeIndex,
                evalProjectionKind,
                evalProjectionArgNode,
                evalProjectionSourcePath,
                evalProjectionInner,
                evalProjectionResultKind,
                evalProjectionResultSize,
                evalProjectionResultAlign,
                evalProjectionOffset,
                evalProjectionErrMsgOffset,
                evalProjectionSourceTotalSize):
                return PrimaryBodyIrNodeEvalMissAt("result_projection")
            var evalProjectionSlot: int32 = -1
            if evalProjectionResultKind == coreir.LocalAggregateTag:
                evalProjectionSlot = PrimaryBodyIrFindOrCreateSlotSized(
                    bodyIR,
                    slotNames,
                    Fmt"#nev{nodeIndex}#result_projection",
                    evalProjectionResultKind,
                    evalProjectionResultSize,
                    evalProjectionResultAlign)
            else:
                evalProjectionSlot = PrimaryBodyIrFindOrCreateSlot(
                    bodyIR,
                    slotNames,
                    Fmt"#nev{nodeIndex}#result_projection",
                    evalProjectionResultKind)
            if evalProjectionSlot < 0 ||
               !PrimaryBodyIrAppendResultProjectionNodeToSlot(
                   bodyIR,
                   slotNames,
                   share(varI32ParamNames),
                   lowering,

                   share(typedFn),
                   irFunction,
                   nodeIndex,
                   evalProjectionSlot,
                   callOrdinal):
                return PrimaryBodyIrNodeEvalMissAt("result_projection")
            return evalProjectionSlot
        if enLit == "Value" || enLit == "result.Value" ||
           enLit == "IsOk" || enLit == "result.IsOk" ||
           enLit == "IsErr" || enLit == "result.IsErr":
            return PrimaryBodyIrNodeEvalMissAt("result_projection")
        if enLit == "Error" || enLit == "result.Error":
            # Error 内征：纯 errmsg 投影替代泛型调用（与文本路径 24020 同款
            # BodyResultProjectErrorStrTag，读源聚合 errmsg@偏移 w24 → str）。
            # 这是 Err[T](Error(r)) 构造的 payload 求值与裸 Error(r) 子表达式
            # 的统一下降：源 Result 聚合的错误串投影到 str 结果槽。errmsg 偏移
            # 随源内型解算（标量内型 Result errmsg 落 < 40）；解不出即 miss。
            # call-arg 臂：实参是调用 Error(<call>) 而非绑定，无命名源槽。errmsg
            # 偏移在物化前先解（勿与 ok-flag 混），解不出 MissAt 落回（无副作用）；
            # 通过后递归 EvalNode 物化 Result[T] 临时源槽再投影 errmsg。
            let errArgNode = PrimaryBodyIrResultErrorArgNodeIndex(lowering.typedIr, nodeIndex)
            if errArgNode >= 0 && lowering.typedIr.nodes2_opKinds[errArgNode] == texpr.TypedExprIrOpCallExpr:
                let errCallMsgOffset = PrimaryBodyIrResultErrorSourceErrMsgOffset(lowering.typedIr, nodeIndex)
                if errCallMsgOffset < 0:
                    return PrimaryBodyIrNodeEvalMissAt("call_special_head")
                let errCallSrcSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          errArgNode,
                                                          callOrdinal)
                if errCallSrcSlot < 0:
                    return -1
                if errCallSrcSlot >= bodyIR.localSlots.len ||
                   PrimaryBodyIrSlotType(bodyIR, errCallSrcSlot) != coreir.LocalAggregateTag ||
                   PrimaryLocalSlotSizeOf(bodyIR.localSlots[errCallSrcSlot]) < errCallMsgOffset + 24:
                    return PrimaryBodyIrNodeEvalMissAt("call_special_head")
                let errCallResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                      slotNames,
                                                                      Fmt"#nev{nodeIndex}#error",
                                                                      coreir.LocalStrTag)
                if errCallResultSlot < 0:
                    return PrimaryBodyIrNodeEvalMissAt("call_special_head")
                var errCallProjOp: coreir.BodyOp
                errCallProjOp.kind = coreir.BodyOpResultProjectTag
                errCallProjOp.target = errCallResultSlot
                add(errCallProjOp.operands, coreir.BodyResultProjectErrorStrTag)
                add(errCallProjOp.operands, errCallSrcSlot)
                add(errCallProjOp.operands, errCallMsgOffset)
                add(errCallProjOp.operands, 24)
                let _ = coreir.BodyIRAppendOp(bodyIR, errCallProjOp)
                return errCallResultSlot
            let errSrcSlot = PrimaryBodyIrResultErrorSourceSlot(bodyIR, slotNames, lowering.typedIr, nodeIndex)
            if errSrcSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            let errMsgOffset = PrimaryBodyIrResultErrorSourceErrMsgOffset(lowering.typedIr, nodeIndex)
            if errMsgOffset < 0:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            let errResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                              slotNames,
                                                              Fmt"#nev{nodeIndex}#error",
                                                              coreir.LocalStrTag)
            if errResultSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            var errProjOp: coreir.BodyOp
            errProjOp.kind = coreir.BodyOpResultProjectTag
            errProjOp.target = errResultSlot
            add(errProjOp.operands, coreir.BodyResultProjectErrorStrTag)
            add(errProjOp.operands, errSrcSlot)
            add(errProjOp.operands, errMsgOffset)
            add(errProjOp.operands, 24)
            let _ = coreir.BodyIRAppendOp(bodyIR, errProjOp)
            return errResultSlot
        if texpr.TypedExprQualifiedCallLeaf(enLit) == "ErrorInfoOf":
            # ErrorInfoOf[T](r) 内征：把源 Result 聚合的整块 err{code,msg} 子聚合
            # （32B = ErrorInfo 布局）投影到 ErrorInfo 结果槽。err 块偏移随源内型
            # 解算（与 Error 投影同源），解不出即 miss 落回文本路径。
            let eiSrcSlot = PrimaryBodyIrResultErrInfoSourceSlot(bodyIR, slotNames, lowering.typedIr, nodeIndex)
            if eiSrcSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            var eiErrBlockOffset: int32
            var eiErrBlockSize: int32
            if !PrimaryBodyIrResultErrInfoSourceBlock(lowering.typedIr, nodeIndex, eiErrBlockOffset, eiErrBlockSize):
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            let eiResultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                  slotNames,
                                                                  lowering.typedIr,
                                                                  enSrc,
                                                                  Fmt"#nev{nodeIndex}#errinfo",
                                                                  "ErrorInfo")
            if eiResultSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            if PrimaryBodyIrSlotType(bodyIR, eiResultSlot) != coreir.LocalAggregateTag:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            if PrimaryLocalSlotSizeOf(bodyIR.localSlots[eiResultSlot]) < eiErrBlockSize:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            var eiProjOp: coreir.BodyOp
            eiProjOp.kind = coreir.BodyOpResultProjectTag
            eiProjOp.target = eiResultSlot
            add(eiProjOp.operands, coreir.BodyResultProjectErrInfoTag)
            add(eiProjOp.operands, eiSrcSlot)
            add(eiProjOp.operands, eiErrBlockOffset)
            add(eiProjOp.operands, eiErrBlockSize)
            let _ = coreir.BodyIRAppendOp(bodyIR, eiProjOp)
            return eiResultSlot
        if enLit == "len" || enLit == "Len" ||
           texpr.TypedExprQualifiedCallLeaf(enLit) == "bytesLen":
            # len/Len/bytesLen 内征：纯 len 字段读替代泛型调用（与文本路径
            # AppendStrLenArgValue str@8 同款 FieldLoad 宽 4 → i32）。单实参节点
            # 求值出 str 值槽或 rawbytes.Bytes 16B 聚合槽后读 len@8。偏移由
            # LenFieldOffsetForType 严格按 str/Bytes 定（其它类型 -1 即 miss）。
            let lenArgNode = PrimaryBodyIrLenCallArgNodeIndex(lowering.typedIr, nodeIndex)
            if lenArgNode < 0:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            let lenArgRtRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[lenArgNode])
            if !IsOk(lenArgRtRes):
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            # form59 residual: hoist Value(Result[str]) before StripVarType
            let lenArgRt_f59: str = Value(lenArgRtRes)
            let lenArgType = texpr.TypedExprStripVarType(lenArgRt_f59)
            if PrimaryBodyIrTypeTextIsDynamicSeq(lenArgType):
                # seq len(x)/Len(x) 内征：镜像已验证的 `.len` FieldGet 快路径
                # （PrimaryBodyIrEvalNode 内 OpFieldGet 分支），直接复用文本路径
                # PrimaryBodyIrSeqLenValueSlot（root+offset 累加解算，len@header
                # offset0 宽4，含 var-param 存地址 deref、nested struct.field
                # 路径），与 probe 侧同一套只读解算严格镜像。不对已求值节点槽
                # 猜测 header 偏移（str/Bytes 走值槽内 8 字节偏移，seq 走 root+
                # 累加字段偏移直读，两者不是同一形态，不可共用 lenFieldOffset）。
                let lenArgSurfRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_surfaceTextIds[lenArgNode])
                if !IsOk(lenArgSurfRes):
                    return PrimaryBodyIrNodeEvalMissAt("call_special_head")
                let seqLenSlot = PrimaryBodyIrSeqLenValueSlot(bodyIR,
                                                               slotNames,
                                                               lowering.typedIr,
                                                               share(typedFn),
                                                               irFunction,
                                                               enSrc,
                                                               arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex),
                                                               Fmt"{Value(lenArgSurfRes)}.len")
                if seqLenSlot < 0:
                    return PrimaryBodyIrNodeEvalMissAt("call_special_head")
                return seqLenSlot
            let lenFieldOffset = PrimaryBodyIrLenFieldOffsetForType(lenArgType)
            if lenFieldOffset < 0:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            let lenArgSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                   slotNames,
                                                   varI32ParamNames,
                                                   lowering,

                                                   typedFn,
                                                   irFunction,
                                                   lenArgNode,
                                                   callOrdinal)
            if lenArgSlot < 0:
                return -1
            let lenArgSlotKind = PrimaryBodyIrSlotType(bodyIR, lenArgSlot)
            if lenArgSlotKind != coreir.LocalStrTag &&
               lenArgSlotKind != coreir.LocalAggregateTag:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            let lenResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                              slotNames,
                                                              Fmt"#nev{nodeIndex}#len",
                                                              coreir.LocalI32Tag)
            if lenResultSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            var lenLoadOp: coreir.BodyOp
            lenLoadOp.kind = coreir.BodyOpFieldLoadTag
            lenLoadOp.target = lenResultSlot
            add(lenLoadOp.operands, lenArgSlot)
            add(lenLoadOp.operands, lenResultSlot)
            add(lenLoadOp.operands, lenFieldOffset)
            add(lenLoadOp.operands, 4)
            let _ = coreir.BodyIRAppendOp(bodyIR, lenLoadOp)
            return lenResultSlot
        if PrimaryCallTargetTailName(enLit) == "StrDataPtr" ||
           PrimaryCallTargetTailName(enLit) == "strDataPtr":
            # StrDataPtr(s) 内征：纯 data 字段读替代泛型调用（镜像文本路径
            # PrimaryBodyIrAppendStrDataPtrValue：FieldLoad@0 宽 8 → ptr）。
            # 单实参节点求值出 str 值槽后读 data@0。仅 str；其它类型 miss。
            let strDataArgLink = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)
            if strDataArgLink < 0 || strDataArgLink >= lowering.typedIr.nodes2_nodeIndexs.len:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            if lowering.typedIr.nodes2_opKinds[strDataArgLink] != texpr.TypedExprIrOpArgLink:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, strDataArgLink) >= 0:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            let strDataArgNode = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, strDataArgLink)
            if strDataArgNode < 0 || strDataArgNode >= lowering.typedIr.nodes2_nodeIndexs.len:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            let strDataArgSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       lowering,

                                                       typedFn,
                                                       irFunction,
                                                       strDataArgNode,
                                                       callOrdinal)
            if strDataArgSlot < 0:
                return -1
            if PrimaryBodyIrSlotType(bodyIR, strDataArgSlot) != coreir.LocalStrTag:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            let strDataResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                  slotNames,
                                                                  Fmt"#nev{nodeIndex}#strdata",
                                                                  coreir.LocalPtrTag)
            if strDataResultSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            var strDataLoadOp: coreir.BodyOp
            strDataLoadOp.kind = coreir.BodyOpFieldLoadTag
            strDataLoadOp.target = strDataResultSlot
            add(strDataLoadOp.operands, strDataArgSlot)
            add(strDataLoadOp.operands, strDataResultSlot)
            add(strDataLoadOp.operands, 0)
            add(strDataLoadOp.operands, 8)
            let _ = coreir.BodyIRAppendOp(bodyIR, strDataLoadOp)
            return strDataResultSlot
        if PrimaryCallTargetTailName(enLit) == "RawmemAsVoid":
            # RawmemAsVoid(x) 内征：str 根读 data@0 宽 8 → ptr（与 StrDataPtr 臂
            # 同构，镜像文本路径 PrimaryBodyIrAppendRawmemAsVoidValue）；ptr 根
            # identity 直接返回源槽。其它类型诚实 miss，绝不落穿通用 CallExpr
            # 派发——AppendCallExprNodeToSlot 的特殊头委托臂对本头回调 EvalNode，
            # 落穿即互递归成环（队列 #12 案卷）。
            let rmvArgLink = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)
            if rmvArgLink < 0 || rmvArgLink >= lowering.typedIr.nodes2_nodeIndexs.len:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            if lowering.typedIr.nodes2_opKinds[rmvArgLink] != texpr.TypedExprIrOpArgLink:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, rmvArgLink) >= 0:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            let rmvArgNode = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, rmvArgLink)
            if rmvArgNode < 0 || rmvArgNode >= lowering.typedIr.nodes2_nodeIndexs.len:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            let rmvArgSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                   slotNames,
                                                   varI32ParamNames,
                                                   lowering,

                                                   typedFn,
                                                   irFunction,
                                                   rmvArgNode,
                                                   callOrdinal)
            if rmvArgSlot < 0:
                return -1
            if PrimaryBodyIrSlotType(bodyIR, rmvArgSlot) == coreir.LocalPtrTag:
                return rmvArgSlot
            if PrimaryBodyIrSlotType(bodyIR, rmvArgSlot) != coreir.LocalStrTag:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            let rmvResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                              slotNames,
                                                              Fmt"#nev{nodeIndex}#rawmemvoid",
                                                              coreir.LocalPtrTag)
            if rmvResultSlot < 0:
                return PrimaryBodyIrNodeEvalMissAt("call_special_head")
            var rmvLoadOp: coreir.BodyOp
            rmvLoadOp.kind = coreir.BodyOpFieldLoadTag
            rmvLoadOp.target = rmvResultSlot
            add(rmvLoadOp.operands, rmvArgSlot)
            add(rmvLoadOp.operands, rmvResultSlot)
            add(rmvLoadOp.operands, 0)
            add(rmvLoadOp.operands, 8)
            let _ = coreir.BodyIRAppendOp(bodyIR, rmvLoadOp)
            return rmvResultSlot
        # 操作数位置的普通 CallExpr 经 CallExpr 发射器物化进按节点返回类型
        # 定形的临时槽；Result 投影已由上面的统一节点投影器消费。
        var callExprSlotType = texpr.TypedExprStripVarType(enRt)
        var callExprIsErrHead = false
        if PrimaryBodyIrResultConstructHead(enLit, callExprIsErrHead):
            # Ok[T]/Err[T]：node.resultType 是泛型 Result[T]，临时槽须按调用头
            # 显式类型实参定形为具体 Result[innerT]（64B）。
            let callExprRcInner = PrimaryBodyIrResultConstructInnerType(enLit)
            if callExprRcInner != "":
                callExprSlotType = Fmt"Result[{callExprRcInner}]"
        let callExprValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                   slotNames,
                                                                   lowering.typedIr,
                                                                   enSrc,
                                                                   Fmt"#nev{nodeIndex}",
                                                                   callExprSlotType)
        if callExprValueSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        if !PrimaryBodyIrAppendCallExprNodeToSlot(bodyIR,
                                                  slotNames,
                                                  lowering,

                                                  share(typedFn),
                                                  irFunction,
                                                  share(varI32ParamNames),
                                                  nodeIndex,
                                                  callExprValueSlot,
                                                  arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex),
                                                  callOrdinal):
            return -1
        return callExprValueSlot
    if opKind == texpr.TypedExprIrOpLocalBoolEnumTernary:
        # `cond ? then : else` 标量 select：守卫与 probe 一致（任一臂含真调用 STOP，
        # 避免 eager 求值破坏副作用/短路）。比较 op 现成产 0/1，照搬既有 declTern
        # 回退码（~11286）：delta=Sub(then,else)、scaled=Mul(cond,delta)、
        # result=Add(else,scaled)，三条 BodyOpBinOpTag。arithKind 由臂槽类（I32/I64）
        # 定，无新增 op-kind/BodyTerm。str 臂需分块（无 currentBlockStart 上下文）→
        # 诚实落 miss。
        if PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex)) ||
           PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand2NodeIndexs, nodeIndex)):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let ternCondSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering,

                                                 typedFn,
                                                 irFunction,
                                                 arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                                 callOrdinal)
        if ternCondSlot < 0:
            return -1
        if PrimaryBodyIrSlotType(bodyIR, ternCondSlot) != coreir.LocalI32Tag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let ternThenSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering,

                                                 typedFn,
                                                 irFunction,
                                                 arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                                 callOrdinal)
        if ternThenSlot < 0:
            return -1
        let ternElseSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering,

                                                 typedFn,
                                                 irFunction,
                                                 arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand2NodeIndexs, nodeIndex),
                                                 callOrdinal)
        if ternElseSlot < 0:
            return -1
        let ternThenKind = PrimaryBodyIrSlotType(bodyIR, ternThenSlot)
        let ternElseKind = PrimaryBodyIrSlotType(bodyIR, ternElseSlot)
        if ternThenKind != ternElseKind:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        if ternThenKind != coreir.LocalI32Tag && ternThenKind != coreir.LocalI64Tag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let ternDeltaSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#nev{nodeIndex}#ternd",
                                                          ternThenKind)
        let ternScaledSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"#nev{nodeIndex}#terns",
                                                           ternThenKind)
        let ternResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"#nev{nodeIndex}#ternr",
                                                           ternThenKind)
        if ternDeltaSlot < 0 || ternScaledSlot < 0 || ternResultSlot < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var ternDeltaOp: coreir.BodyOp
        ternDeltaOp.kind = coreir.BodyOpBinOpTag
        ternDeltaOp.target = ternDeltaSlot
        add(ternDeltaOp.operands, ternThenKind)
        add(ternDeltaOp.operands, int32(texpr.TypedExprIrOpI32Sub))
        add(ternDeltaOp.operands, ternThenSlot)
        add(ternDeltaOp.operands, ternElseSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, ternDeltaOp)
        var ternScaledOp: coreir.BodyOp
        ternScaledOp.kind = coreir.BodyOpBinOpTag
        ternScaledOp.target = ternScaledSlot
        add(ternScaledOp.operands, ternThenKind)
        add(ternScaledOp.operands, int32(texpr.TypedExprIrOpI32Mul))
        add(ternScaledOp.operands, ternCondSlot)
        add(ternScaledOp.operands, ternDeltaSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, ternScaledOp)
        var ternResultOp: coreir.BodyOp
        ternResultOp.kind = coreir.BodyOpBinOpTag
        ternResultOp.target = ternResultSlot
        add(ternResultOp.operands, ternThenKind)
        add(ternResultOp.operands, int32(texpr.TypedExprIrOpI32Add))
        add(ternResultOp.operands, ternElseSlot)
        add(ternResultOp.operands, ternScaledSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, ternResultOp)
        return ternResultSlot
    return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))

# 短路条件链：log_and/log_or 根节点按文本路径同款 Cbr 链降。每个叶子
# 在独立块内求值（含调用恰好执行一次且仅在其分支可达时执行），&& 假边
# 汇入 falseTerms（-1 哨兵延迟补丁），|| 真边直跳 successBlock。块数静态
# 可数（每叶恰一块），successBlock = 起始块号 + 链块数。
@borrows
fn PrimaryBodyIrNodeCondCbrBlockCount(typedIr: texpr.TypedExprIr,
                                       nodeIndex: int32): int32 =
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return 0
    let opKind = typedIr.nodes2_opKinds[nodeIndex]
    if opKind == texpr.TypedExprIrOpLogNot:
        return PrimaryBodyIrNodeCondCbrBlockCount(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex))
    if opKind == texpr.TypedExprIrOpLogAnd ||
       opKind == texpr.TypedExprIrOpLogOr:
        let lhsCount = PrimaryBodyIrNodeCondCbrBlockCount(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex))
        if lhsCount <= 0:
            return 0
        let rhsCount = PrimaryBodyIrNodeCondCbrBlockCount(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, nodeIndex))
        if rhsCount <= 0:
            return 0
        return lhsCount + rhsCount
    return 1

@borrows
fn PrimaryBodyIrNodeCondChainProbe(bodyIR: var coreir.BodyIR,
                                    slotNames: var str[],
                                    varI32ParamNames: str[],
                                    lowering: var lower.LoweringPlanStub,
                                    typedFn: texpr.TypedExprIrFunction,
                                    irFunction: lower.PrimaryObjectIrFunction,
                                    nodeIndex: int32): bool =
    var pending: int32[]
    add(pending, nodeIndex)
    var scan: int32
    while scan < pending.len:
        let cur = pending[scan]
        scan = scan + 1
        if cur < 0 || cur >= lowering.typedIr.nodes2_nodeIndexs.len:
            return false
        let opKind = lowering.typedIr.nodes2_opKinds[cur]
        if opKind == texpr.TypedExprIrOpLogNot:
            add(pending, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena,
                                                     lowering.typedIr.nodes2_operand0NodeIndexs,
                                                     cur))
            continue
        if opKind == texpr.TypedExprIrOpLogAnd ||
           opKind == texpr.TypedExprIrOpLogOr:
            add(pending, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena,
                                                     lowering.typedIr.nodes2_operand0NodeIndexs,
                                                     cur))
            add(pending, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena,
                                                     lowering.typedIr.nodes2_operand1NodeIndexs,
                                                     cur))
            continue
        if PrimaryBodyIrNodeEvalProbe(bodyIR,
                                      slotNames,
                                      varI32ParamNames,
                                      lowering,
                                      typedFn,
                                      irFunction,
                                      cur) != coreir.LocalI32Tag:
            return false
    return true

@borrows
fn PrimaryBodyIrNodeEmitCondCbrChain(bodyIR: var coreir.BodyIR,
                                      slotNames: var str[],
                                      varI32ParamNames: str[],
                                      lowering: var lower.LoweringPlanStub,
                                      typedFn: texpr.TypedExprIrFunction,
                                      irFunction: lower.PrimaryObjectIrFunction,
                                      nodeIndex: int32,
                                      trueTarget: int32,
                                      falseTarget: int32,
                                      callOrdinal: var int32,
                                      currentBlockStart: var int32,
                                      falseTerms: var int32[]): bool =
    return PrimaryBodyIrNodeEmitCondCbrChainNeg(bodyIR,
                                                slotNames,
                                                varI32ParamNames,
                                                lowering,

                                                typedFn,
                                                irFunction,
                                                nodeIndex,
                                                trueTarget,
                                                falseTarget,
                                                callOrdinal,
                                                currentBlockStart,
                                                falseTerms,
                                                false)

# `!(a && b)` 作 if/elif 条件:LogNot 根进不去 cond-chain 派发(门禁只认 LogAnd/LogOr),
# 落文本路径标 log_and。这里用 De Morgan 下推:negate 沿 AND/OR 互换路由下传,叶条件
# NonZero↔Zero 翻转,`-1` 哨兵恒留 falseBlock(不交换目标块,patch 不变量不破),CFG 块
# 几何对 negate 不变(BlockCount 对称),字节等价于文本路径既有正确下降。公开壳零体委托
# negate=false,5 个外部派发调用点一字不改。
@borrows
fn PrimaryBodyIrNodeEmitCondCbrChainNeg(bodyIR: var coreir.BodyIR,
                                         slotNames: var str[],
                                         varI32ParamNames: str[],
                                         lowering: var lower.LoweringPlanStub,
                                         typedFn: texpr.TypedExprIrFunction,
                                         irFunction: lower.PrimaryObjectIrFunction,
                                         nodeIndex: int32,
                                         trueTarget: int32,
                                         falseTarget: int32,
                                         callOrdinal: var int32,
                                         currentBlockStart: var int32,
                                         falseTerms: var int32[],
                                         negate: bool): bool =
    if nodeIndex < 0 || nodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        return false
    let opKind = lowering.typedIr.nodes2_opKinds[nodeIndex]
    if opKind == texpr.TypedExprIrOpLogNot:
        return PrimaryBodyIrNodeEmitCondCbrChainNeg(bodyIR,
                                                    slotNames,
                                                    varI32ParamNames,
                                                    lowering,

                                                    typedFn,
                                                    irFunction,
                                                    arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                                    trueTarget,
                                                    falseTarget,
                                                    callOrdinal,
                                                    currentBlockStart,
                                                    falseTerms,
                                                    !negate)
    let chainTreatAsAnd = (opKind == texpr.TypedExprIrOpLogAnd && !negate) ||
                          (opKind == texpr.TypedExprIrOpLogOr && negate)
    let chainTreatAsOr = (opKind == texpr.TypedExprIrOpLogOr && !negate) ||
                         (opKind == texpr.TypedExprIrOpLogAnd && negate)
    if chainTreatAsAnd:
        let andRhsFirstBlock = bodyIR.blocks.len +
                               PrimaryBodyIrNodeCondCbrBlockCount(lowering.typedIr, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex))
        if !PrimaryBodyIrNodeEmitCondCbrChainNeg(bodyIR,
                                              slotNames,
                                              varI32ParamNames,
                                              lowering,

                                              typedFn,
                                              irFunction,
                                              arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                              andRhsFirstBlock,
                                              falseTarget,
                                              callOrdinal,
                                              currentBlockStart,
                                              falseTerms,
                                              negate):
            return false
        return PrimaryBodyIrNodeEmitCondCbrChainNeg(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering,

                                                 typedFn,
                                                 irFunction,
                                                 arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                                 trueTarget,
                                                 falseTarget,
                                                 callOrdinal,
                                                 currentBlockStart,
                                                 falseTerms,
                                                 negate)
    if chainTreatAsOr:
        let orRhsFirstBlock = bodyIR.blocks.len +
                              PrimaryBodyIrNodeCondCbrBlockCount(lowering.typedIr, arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex))
        if !PrimaryBodyIrNodeEmitCondCbrChainNeg(bodyIR,
                                              slotNames,
                                              varI32ParamNames,
                                              lowering,

                                              typedFn,
                                              irFunction,
                                              arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                              trueTarget,
                                              orRhsFirstBlock,
                                              callOrdinal,
                                              currentBlockStart,
                                              falseTerms,
                                              negate):
            return false
        return PrimaryBodyIrNodeEmitCondCbrChainNeg(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering,

                                                 typedFn,
                                                 irFunction,
                                                 arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex),
                                                 trueTarget,
                                                 falseTarget,
                                                 callOrdinal,
                                                 currentBlockStart,
                                                 falseTerms,
                                                 negate)
    let chainLeafSlot = PrimaryBodyIrEvalNode(bodyIR,
                                              slotNames,
                                              varI32ParamNames,
                                              lowering,

                                              typedFn,
                                              irFunction,
                                              nodeIndex,
                                              callOrdinal)
    if chainLeafSlot < 0:
        return false
    if PrimaryBodyIrSlotType(bodyIR, chainLeafSlot) != coreir.LocalI32Tag:
        return false
    var chainLeafTerm: coreir.BodyTerm
    chainLeafTerm.kind = coreir.BodyTermCbrTag
    if negate:
        chainLeafTerm.conditionKind = coreir.BodyCondLocalZeroTag
    else:
        chainLeafTerm.conditionKind = coreir.BodyCondLocalNonZeroTag
    chainLeafTerm.lhsSlot = chainLeafSlot
    chainLeafTerm.rhsSlot = -1
    chainLeafTerm.resultSlot = -1
    chainLeafTerm.trueBlock = trueTarget
    chainLeafTerm.falseBlock = falseTarget
    let chainLeafTermIndex = coreir.BodyIRAppendTerm(bodyIR, chainLeafTerm)
    let chainLeafOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR,
                                     currentBlockStart,
                                     chainLeafOpCount,
                                     chainLeafTermIndex)
    currentBlockStart = bodyIR.ops.len
    if falseTarget < 0:
        add(falseTerms, chainLeafTermIndex)
    return true

# 值位短路 log-chain bool 发射器：return/store 位的 LogOr/LogAnd 含 CallExpr
# 操作数不能用非短路位运算（短路语义可能跳过调用）。这里把整条链下降成
# CBR 链 → true 块存 1、false 块存 0、汇合块，返回承载 0/1 的 i32 结果槽。
# 复用 NodeEmitCondCbrChain（短路 CBR 链）+ store-1/store-0/join 模式，与文本
# 路径 PrimaryBodyIrAppendBoolConditionAssign 镜像，但全程走节点（含调用叶）。
fn PrimaryBodyIrNodeBoolChainTransactionCacheEntryEmpty(
        bodyIR: var coreir.BodyIR): bool =
    return !bodyIR.frameMetricsReady &&
           bodyIR.frameStackByteCount == 0 &&
           bodyIR.frameParamSaveCount == 0 &&
           bodyIR.frameParamSaveOffset == 0 &&
           bodyIR.frameReturnBufferSaveOffset == 0 &&
           bodyIR.frameBytes == 0 &&
           bodyIR.framePrologueWordCount == 0 &&
           bodyIR.frameRestoreWordCount == 0 &&
           bodyIR.layoutLhsElide.len == 0 &&
           bodyIR.layoutStoreElide.len == 0 &&
           bodyIR.layoutCopySrcElide.len == 0 &&
           bodyIR.layoutCmpFuse.len == 0 &&
           bodyIR.layoutCbrFuse.len == 0 &&
           !bodyIR.x64StackLayoutReady &&
           bodyIR.x64SlotReadCnt.len == 0 &&
           !bodyIR.x64BlockStartReady &&
           bodyIR.x64BlockByteStart.len == 0

@borrows
fn PrimaryBodyIrNodeBoolChainCheckpointTake(
        bodyIR: var coreir.BodyIR,
        slotNames: var str[],
        irFunction: lower.PrimaryObjectIrFunction,
        callOrdinal: int32,
        currentBlockStart: int32): PrimaryBodyIrNodeBoolChainCheckpoint =
    var checkpoint: PrimaryBodyIrNodeBoolChainCheckpoint
    checkpoint.opCount = bodyIR.ops.len
    checkpoint.callOpCount = bodyIR.callSequence.len
    checkpoint.slotCount = bodyIR.localSlots.len
    checkpoint.blockCount = bodyIR.blocks.len
    checkpoint.termCount = bodyIR.terms.len
    checkpoint.cstringCount = bodyIR.cstringLiterals.len
    checkpoint.slotNameCount = slotNames.len
    checkpoint.callOrdinal = callOrdinal
    checkpoint.currentBlockStart = currentBlockStart
    checkpoint.nodeEvalCallEmitCount = primaryBodyIrNodeEvalCallEmitCount
    checkpoint.nodeEvalMissOp = primaryBodyIrNodeEvalMissOp
    checkpoint.irCallArgCountCount = irFunction.callArgCounts.len
    checkpoint.irCallTargetCount = irFunction.callTargets.len
    checkpoint.irCallTargetSourcePathCount = irFunction.callTargetSourcePaths.len
    checkpoint.irCallTargetSignatureLineNumberCount =
        irFunction.callTargetSignatureLineNumbers.len
    checkpoint.irCallTargetImportcFlagCount = irFunction.callTargetImportcFlags.len
    checkpoint.irCallImportcSymbolCount = irFunction.callImportcSymbols.len
    return checkpoint

@borrows
fn PrimaryBodyIrNodeBoolChainCheckpointClone(
        src: PrimaryBodyIrNodeBoolChainCheckpoint): PrimaryBodyIrNodeBoolChainCheckpoint =
    var out: PrimaryBodyIrNodeBoolChainCheckpoint
    out.opCount = src.opCount
    out.callOpCount = src.callOpCount
    out.slotCount = src.slotCount
    out.blockCount = src.blockCount
    out.termCount = src.termCount
    out.cstringCount = src.cstringCount
    out.slotNameCount = src.slotNameCount
    out.callOrdinal = src.callOrdinal
    out.currentBlockStart = src.currentBlockStart
    out.nodeEvalCallEmitCount = src.nodeEvalCallEmitCount
    out.nodeEvalMissOp = strings.CloneStr(src.nodeEvalMissOp)
    out.irCallArgCountCount = src.irCallArgCountCount
    out.irCallTargetCount = src.irCallTargetCount
    out.irCallTargetSourcePathCount = src.irCallTargetSourcePathCount
    out.irCallTargetSignatureLineNumberCount = src.irCallTargetSignatureLineNumberCount
    out.irCallTargetImportcFlagCount = src.irCallTargetImportcFlagCount
    out.irCallImportcSymbolCount = src.irCallImportcSymbolCount
    return out

fn PrimaryBodyIrNodeBoolChainTransactionBegin(
        bodyIR: var coreir.BodyIR,
        checkpoint: PrimaryBodyIrNodeBoolChainCheckpoint,
        receipt: var PrimaryBodyIrNodeBoolChainTransactionReceipt) =
    if primaryBodyIrNodeBoolChainMutationJournal.active:
        panic("body_ir_bool_chain_transaction_nested")
    if !PrimaryBodyIrNodeBoolChainTransactionCacheEntryEmpty(bodyIR):
        panic("body_ir_bool_chain_transaction_cache_not_empty")
    if checkpoint.irCallArgCountCount != checkpoint.irCallTargetCount ||
       checkpoint.irCallTargetSourcePathCount != checkpoint.irCallTargetCount ||
       checkpoint.irCallTargetSignatureLineNumberCount !=
           checkpoint.irCallTargetCount ||
       checkpoint.irCallTargetImportcFlagCount != checkpoint.irCallTargetCount ||
       checkpoint.irCallImportcSymbolCount != checkpoint.irCallTargetCount:
        panic("body_ir_bool_chain_transaction_ir_call_rows_inconsistent")
    PrimaryBodyIrNodeBoolChainJournalReset()
    primaryBodyIrNodeBoolChainMutationJournal.active = true
    primaryBodyIrNodeBoolChainMutationJournal.opPrefixCount = checkpoint.opCount
    primaryBodyIrNodeBoolChainMutationJournal.callPrefixCount = checkpoint.callOpCount
    primaryBodyIrNodeBoolChainMutationJournal.slotPrefixCount = checkpoint.slotCount
    primaryBodyIrNodeBoolChainMutationJournal.termPrefixCount = checkpoint.termCount
    primaryBodyIrNodeBoolChainMutationJournal.slotNamePrefixCount = checkpoint.slotNameCount
    primaryBodyIrNodeBoolChainMutationJournal.irCallRowPrefixCount = checkpoint.irCallTargetCount
    receipt.cacheEntryContractProved = true

fn PrimaryBodyIrNodeBoolChainTransactionCommit(
        bodyIR: var coreir.BodyIR,
        slotNames: var str[],
        receipt: var PrimaryBodyIrNodeBoolChainTransactionReceipt) =
    if !primaryBodyIrNodeBoolChainMutationJournal.active:
        panic("body_ir_bool_chain_transaction_commit_inactive")
    if !PrimaryBodyIrNodeBoolChainTransactionCacheEntryEmpty(bodyIR):
        panic("body_ir_bool_chain_transaction_cache_became_live")
    if primaryBodyIrNodeBoolChainMutationJournal.newSlotNames.len !=
       primaryBodyIrNodeBoolChainMutationJournal.newSlotIndexes.len:
        panic("body_ir_bool_chain_transaction_name_overlay_corrupt")
    for i in 0..<primaryBodyIrNodeBoolChainMutationJournal.newSlotNames.len:
        let slotIndex = primaryBodyIrNodeBoolChainMutationJournal.newSlotIndexes[i]
        let slotName = primaryBodyIrNodeBoolChainMutationJournal.newSlotNames[i]
        if slotIndex < 0 || slotIndex >= slotNames.len:
            panic("body_ir_bool_chain_transaction_name_overlay_invalid")
        # A transaction-local slot may be retired and renamed before commit.
        # Its earlier overlay row is then deliberately stale, just like the
        # non-transactional retire path; only the final live name is published.
        if slotNames[slotIndex] != slotName:
            continue
        hashmaps.HashMapStrIntPut(
            bodyIR.slotNameIndex,
            strings.CloneStr(slotName),
            slotIndex)
    receipt.commitCount = receipt.commitCount + 1
    PrimaryBodyIrNodeBoolChainJournalReset()

@borrows
fn PrimaryBodyIrNodeBoolChainRollback(
        bodyIR: var coreir.BodyIR,
        slotNames: var str[],
        irFunction: var lower.PrimaryObjectIrFunction,
        callOrdinal: var int32,
        currentBlockStart: var int32,
        checkpoint: PrimaryBodyIrNodeBoolChainCheckpoint) =
    if bodyIR.ops.len < checkpoint.opCount ||
       bodyIR.callSequence.len < checkpoint.callOpCount ||
       bodyIR.localSlots.len < checkpoint.slotCount ||
       bodyIR.blocks.len < checkpoint.blockCount ||
       bodyIR.terms.len < checkpoint.termCount ||
       bodyIR.cstringLiterals.len < checkpoint.cstringCount ||
       slotNames.len < checkpoint.slotNameCount ||
       irFunction.callArgCounts.len < checkpoint.irCallArgCountCount ||
       irFunction.callTargets.len < checkpoint.irCallTargetCount ||
       irFunction.callTargetSourcePaths.len < checkpoint.irCallTargetSourcePathCount ||
       irFunction.callTargetSignatureLineNumbers.len <
           checkpoint.irCallTargetSignatureLineNumberCount ||
       irFunction.callTargetImportcFlags.len < checkpoint.irCallTargetImportcFlagCount ||
       irFunction.callImportcSymbols.len < checkpoint.irCallImportcSymbolCount:
        panic("body_ir_bool_chain_transaction_prefix_corrupt")
    if !primaryBodyIrNodeBoolChainMutationJournal.active:
        panic("body_ir_bool_chain_transaction_rollback_inactive")
    if primaryBodyIrNodeBoolChainMutationJournal.slotMutationIndexes.len !=
       primaryBodyIrNodeBoolChainMutationJournal.slotMutationOldValues.len ||
       primaryBodyIrNodeBoolChainMutationJournal.slotNameMutationIndexes.len !=
       primaryBodyIrNodeBoolChainMutationJournal.slotNameMutationOldValues.len ||
       primaryBodyIrNodeBoolChainMutationJournal.opMutationIndexes.len !=
       primaryBodyIrNodeBoolChainMutationJournal.opMutationOldValues.len ||
       primaryBodyIrNodeBoolChainMutationJournal.callMutationIndexes.len !=
       primaryBodyIrNodeBoolChainMutationJournal.callMutationOldValues.len ||
       primaryBodyIrNodeBoolChainMutationJournal.termMutationIndexes.len !=
       primaryBodyIrNodeBoolChainMutationJournal.termMutationOldValues.len ||
       primaryBodyIrNodeBoolChainMutationJournal.irCallRowMutationOrdinals.len !=
       primaryBodyIrNodeBoolChainMutationJournal.irCallArgCountOldValues.len ||
       primaryBodyIrNodeBoolChainMutationJournal.irCallRowMutationOrdinals.len !=
       primaryBodyIrNodeBoolChainMutationJournal.irCallTargetOldValues.len ||
       primaryBodyIrNodeBoolChainMutationJournal.irCallRowMutationOrdinals.len !=
       primaryBodyIrNodeBoolChainMutationJournal.irCallTargetSourcePathOldValues.len ||
       primaryBodyIrNodeBoolChainMutationJournal.irCallRowMutationOrdinals.len !=
       primaryBodyIrNodeBoolChainMutationJournal.irCallTargetSignatureLineNumberOldValues.len ||
       primaryBodyIrNodeBoolChainMutationJournal.irCallRowMutationOrdinals.len !=
       primaryBodyIrNodeBoolChainMutationJournal.irCallTargetImportcFlagOldValues.len ||
       primaryBodyIrNodeBoolChainMutationJournal.irCallRowMutationOrdinals.len !=
       primaryBodyIrNodeBoolChainMutationJournal.irCallImportcSymbolOldValues.len:
        panic("body_ir_bool_chain_transaction_journal_corrupt")
    var rowMutationIndex = primaryBodyIrNodeBoolChainMutationJournal.irCallRowMutationOrdinals.len - 1
    while rowMutationIndex >= 0:
        let ordinal = primaryBodyIrNodeBoolChainMutationJournal.irCallRowMutationOrdinals[rowMutationIndex]
        irFunction.callArgCounts[ordinal] = primaryBodyIrNodeBoolChainMutationJournal.irCallArgCountOldValues[rowMutationIndex]
        irFunction.callTargets[ordinal] = primaryBodyIrNodeBoolChainMutationJournal.irCallTargetOldValues[rowMutationIndex]
        irFunction.callTargetSourcePaths[ordinal] = primaryBodyIrNodeBoolChainMutationJournal.irCallTargetSourcePathOldValues[rowMutationIndex]
        irFunction.callTargetSignatureLineNumbers[ordinal] = primaryBodyIrNodeBoolChainMutationJournal.irCallTargetSignatureLineNumberOldValues[rowMutationIndex]
        irFunction.callTargetImportcFlags[ordinal] = primaryBodyIrNodeBoolChainMutationJournal.irCallTargetImportcFlagOldValues[rowMutationIndex]
        irFunction.callImportcSymbols[ordinal] = primaryBodyIrNodeBoolChainMutationJournal.irCallImportcSymbolOldValues[rowMutationIndex]
        rowMutationIndex = rowMutationIndex - 1
    var termMutationIndex = primaryBodyIrNodeBoolChainMutationJournal.termMutationIndexes.len - 1
    while termMutationIndex >= 0:
        let termIndex = primaryBodyIrNodeBoolChainMutationJournal.termMutationIndexes[termMutationIndex]
        bodyIR.terms[termIndex] = primaryBodyIrNodeBoolChainMutationJournal.termMutationOldValues[termMutationIndex]
        termMutationIndex = termMutationIndex - 1
    var callMutationIndex = primaryBodyIrNodeBoolChainMutationJournal.callMutationIndexes.len - 1
    while callMutationIndex >= 0:
        let callIndex = primaryBodyIrNodeBoolChainMutationJournal.callMutationIndexes[callMutationIndex]
        bodyIR.callSequence[callIndex] = primaryBodyIrNodeBoolChainMutationJournal.callMutationOldValues[callMutationIndex]
        callMutationIndex = callMutationIndex - 1
    var opMutationIndex = primaryBodyIrNodeBoolChainMutationJournal.opMutationIndexes.len - 1
    while opMutationIndex >= 0:
        let opIndex = primaryBodyIrNodeBoolChainMutationJournal.opMutationIndexes[opMutationIndex]
        bodyIR.ops[opIndex] = primaryBodyIrNodeBoolChainMutationJournal.opMutationOldValues[opMutationIndex]
        opMutationIndex = opMutationIndex - 1
    var slotNameMutationIndex = primaryBodyIrNodeBoolChainMutationJournal.slotNameMutationIndexes.len - 1
    while slotNameMutationIndex >= 0:
        let slotIndex = primaryBodyIrNodeBoolChainMutationJournal.slotNameMutationIndexes[slotNameMutationIndex]
        slotNames[slotIndex] = primaryBodyIrNodeBoolChainMutationJournal.slotNameMutationOldValues[slotNameMutationIndex]
        slotNameMutationIndex = slotNameMutationIndex - 1
    var slotMutationIndex = primaryBodyIrNodeBoolChainMutationJournal.slotMutationIndexes.len - 1
    while slotMutationIndex >= 0:
        let slotIndex = primaryBodyIrNodeBoolChainMutationJournal.slotMutationIndexes[slotMutationIndex]
        let restored = primaryBodyIrNodeBoolChainMutationJournal.slotMutationOldValues[slotMutationIndex]
        var slotCopy: coreir.LocalSlot
        # [bodyir-ownership-wall] W5 前置读数（只读）：恢复源＝日志快照是否已零/身份漂移。
        # 快照本应镜像 `slotMutationIndexes[j]` 那一行 ⇒ 其 id 必等于该行号；写成默认值
        # （tk==0 ∧ name 空）即"快照本身零"。这条与写回后回读（下方 J2）合起来把
        # "快照零" 与 "写回丢落地" 彻底分开。
        if restored.id != primaryBodyIrNodeBoolChainMutationJournal.slotMutationIndexes[slotMutationIndex] ||
           (restored.typeKind == 0 && len(restored.name) == 0):
            panic(Fmt"primary journal restore snapshot zero j={slotMutationIndex} slot={slotIndex} src_id={restored.id} src_tk={Int32(restored.typeKind)} snap_len={primaryBodyIrNodeBoolChainMutationJournal.slotMutationOldValues.len} len={bodyIR.localSlots.len} cap={bodyIR.localSlots.cap}")
        slotCopy.id = restored.id
        slotCopy.name = strings.CloneStr(restored.name)
        slotCopy.typeKind = restored.typeKind
        slotCopy.typeArenaTypeId = restored.typeArenaTypeId
        slotCopy.managedStorageKind = restored.managedStorageKind
        slotCopy.placeKind = restored.placeKind
        slotCopy.stackOffset = restored.stackOffset
        slotCopy.sizeBytes = restored.sizeBytes
        slotCopy.alignBytes = restored.alignBytes
        slotCopy.auxValue = restored.auxValue
        slotCopy.ownership = restored.ownership
        slotCopy.aliasClass = restored.aliasClass
        slotCopy.escapeKind = restored.escapeKind
        slotCopy.noAlias = restored.noAlias
        bodyIR.localSlots[slotIndex] = slotCopy
        # [bodyir-ownership-wall] 日志恢复写回回读（只读）：元素写入是否落地
        if bodyIR.localSlots[slotIndex].id != slotCopy.id ||
           bodyIR.localSlots[slotIndex].typeKind != slotCopy.typeKind ||
           len(bodyIR.localSlots[slotIndex].name) != len(slotCopy.name):
            panic(Fmt"primary journal restore element store lost slot={slotIndex} restored_id={slotCopy.id} tk={Int32(slotCopy.typeKind)} inplace_id={bodyIR.localSlots[slotIndex].id} len={bodyIR.localSlots.len} cap={bodyIR.localSlots.cap}")
        slotMutationIndex = slotMutationIndex - 1
    setLen(bodyIR.ops, checkpoint.opCount)
    setLen(bodyIR.callSequence, checkpoint.callOpCount)
    setLen(bodyIR.localSlots, checkpoint.slotCount)
    setLen(bodyIR.localBindingValueDefinitionRows,
           checkpoint.slotCount)
    setLen(bodyIR.blocks, checkpoint.blockCount)
    setLen(bodyIR.terms, checkpoint.termCount)
    setLen(bodyIR.cstringLiterals, checkpoint.cstringCount)
    setLen(slotNames, checkpoint.slotNameCount)
    setLen(irFunction.callArgCounts, checkpoint.irCallArgCountCount)
    setLen(irFunction.callTargets, checkpoint.irCallTargetCount)
    setLen(irFunction.callTargetSourcePaths,
           checkpoint.irCallTargetSourcePathCount)
    setLen(irFunction.callTargetSignatureLineNumbers,
           checkpoint.irCallTargetSignatureLineNumberCount)
    setLen(irFunction.callTargetImportcFlags,
           checkpoint.irCallTargetImportcFlagCount)
    setLen(irFunction.callImportcSymbols,
           checkpoint.irCallImportcSymbolCount)
    callOrdinal = checkpoint.callOrdinal
    currentBlockStart = checkpoint.currentBlockStart
    primaryBodyIrNodeEvalCallEmitCount = checkpoint.nodeEvalCallEmitCount
    primaryBodyIrNodeEvalMissOp = checkpoint.nodeEvalMissOp
    if !PrimaryBodyIrNodeBoolChainTransactionCacheEntryEmpty(bodyIR):
        panic("body_ir_bool_chain_transaction_cache_restore_invalid")
    PrimaryBodyIrNodeBoolChainJournalReset()

@borrows
fn PrimaryBodyIrNodeBoolChainAbort(
        bodyIR: var coreir.BodyIR,
        slotNames: var str[],
        typedIr: texpr.TypedExprIr,
        irFunction: var lower.PrimaryObjectIrFunction,
        nodeIndex: int32,
        callOrdinal: var int32,
        currentBlockStart: var int32,
        resultSlotOut: var int32,
        checkpoint: PrimaryBodyIrNodeBoolChainCheckpoint,
        receipt: var PrimaryBodyIrNodeBoolChainTransactionReceipt,
        reason: int32): PrimaryBodyIrNodeBoolChainOutcome =
    receipt.preRollbackOpDelta = bodyIR.ops.len - checkpoint.opCount
    receipt.preRollbackCallDelta = bodyIR.callSequence.len - checkpoint.callOpCount
    receipt.preRollbackSlotDelta = bodyIR.localSlots.len - checkpoint.slotCount
    receipt.preRollbackBlockDelta = bodyIR.blocks.len - checkpoint.blockCount
    receipt.preRollbackTermDelta = bodyIR.terms.len - checkpoint.termCount
    receipt.preRollbackCStringDelta = bodyIR.cstringLiterals.len - checkpoint.cstringCount
    receipt.preRollbackSlotNameDelta = slotNames.len - checkpoint.slotNameCount
    receipt.preRollbackIrCallRowDelta = irFunction.callTargets.len - checkpoint.irCallTargetCount
    receipt.prefixSlotMutationCount = primaryBodyIrNodeBoolChainMutationJournal.slotMutationIndexes.len
    receipt.prefixSlotNameMutationCount = primaryBodyIrNodeBoolChainMutationJournal.slotNameMutationIndexes.len
    receipt.prefixOpMutationCount = primaryBodyIrNodeBoolChainMutationJournal.opMutationIndexes.len
    receipt.prefixCallMutationCount = primaryBodyIrNodeBoolChainMutationJournal.callMutationIndexes.len
    receipt.prefixTermMutationCount = primaryBodyIrNodeBoolChainMutationJournal.termMutationIndexes.len
    receipt.prefixIrCallRowMutationCount = primaryBodyIrNodeBoolChainMutationJournal.irCallRowMutationOrdinals.len
    receipt.rollbackCount = receipt.rollbackCount + 1
    PrimaryBodyIrNodeBoolChainRollback(bodyIR,
                                       slotNames,
                                       irFunction,
                                       callOrdinal,
                                       currentBlockStart,
                                       checkpoint)
    resultSlotOut = -1
    var lineNumber: int32
    var statementKind: int32
    if nodeIndex >= 0 && nodeIndex < typedIr.nodes2_nodeIndexs.len:
        lineNumber = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                typedIr.nodes2_lineNumbers,
                                                nodeIndex)
        statementKind = int32(typedIr.nodes2_opKinds[nodeIndex])
    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                 lineNumber,
                                 statementKind,
                                 6101,
                                 reason)
    receipt.poisonCount = receipt.poisonCount + 1
    return PrimaryBodyIrNodeBoolChainClaimedFailed

# Generic value-position NodeEval transaction. The read-only probe is the only
# point at which this path may decline ownership. Once the probe matches the
# requested shape, every mutation made by EvalNode is journaled: ops, calls,
# local slots, blocks/terms, cstring rows, slot-name overlay, call-relocation
# rows, call ordinal and block cursor. A malformed producer cannot leave a
# partially emitted non-call tree behind and fall through to another lowering
# path; rollback restores the exact prefix and appends one structured poison.
@borrows
fn PrimaryBodyIrEvalNodeToExpectedSlotTransactional(
        bodyIR: var coreir.BodyIR,
        slotNames: var str[],
        varI32ParamNames: str[],
        lowering: var lower.LoweringPlanStub,
        typedFn: texpr.TypedExprIrFunction,
        irFunction: var lower.PrimaryObjectIrFunction,
        nodeIndex: int32,
        expectedKind: int32,
        expectedSize: int32,
        exactSize: bool,
        callOrdinal: var int32,
        currentBlockStart: var int32,
        resultSlotOut: var int32,
        receiptOut: var PrimaryBodyIrNodeBoolChainTransactionReceipt): PrimaryBodyIrNodeBoolChainOutcome =
    resultSlotOut = -1
    var emptyReceipt: PrimaryBodyIrNodeBoolChainTransactionReceipt
    receiptOut = emptyReceipt
    if nodeIndex < 0 || expectedKind == coreir.LocalInvalidTag || expectedSize <= 0:
        return PrimaryBodyIrNodeBoolChainNotApplicable
    # Short-circuit roots own a dedicated CFG transaction and must never nest
    # inside this value transaction.
    if PrimaryBodyIrNodeIsShortCircuitChainRoot(lowering.typedIr, nodeIndex):
        return PrimaryBodyIrNodeBoolChainNotApplicable
    let probeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering,

                                               share(typedFn),
                                               irFunction,
                                               nodeIndex)
    if probeKind != expectedKind:
        return PrimaryBodyIrNodeBoolChainNotApplicable
    let checkpoint = PrimaryBodyIrNodeBoolChainCheckpointTake(bodyIR,
                                                              slotNames,
                                                              irFunction,
                                                              callOrdinal,
                                                              currentBlockStart)
    PrimaryBodyIrNodeBoolChainTransactionBegin(bodyIR,
                                                PrimaryBodyIrNodeBoolChainCheckpointClone(checkpoint),
                                                receiptOut)
    let resultSlot = PrimaryBodyIrEvalNode(bodyIR,
                                           slotNames,
                                           varI32ParamNames,
                                           lowering,

                                           typedFn,
                                           irFunction,
                                           nodeIndex,
                                           callOrdinal)
    var shapeMatches = resultSlot >= 0 && resultSlot < bodyIR.localSlots.len
    if shapeMatches:
        shapeMatches = PrimaryBodyIrSlotType(bodyIR, resultSlot) == expectedKind
    if shapeMatches:
        let resultSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[resultSlot])
        if exactSize:
            shapeMatches = resultSize == expectedSize
        else:
            shapeMatches = resultSize >= expectedSize
    if !shapeMatches:
        return PrimaryBodyIrNodeBoolChainAbort(bodyIR,
                                               slotNames,
                                               lowering.typedIr,
                                               irFunction,
                                               nodeIndex,
                                               callOrdinal,
                                               currentBlockStart,
                                               resultSlotOut,
                                               checkpoint,
                                               receiptOut,
                                               20)
    PrimaryBodyIrNodeBoolChainTransactionCommit(bodyIR,
                                                 slotNames,
                                                 receiptOut)
    resultSlotOut = resultSlot
    return PrimaryBodyIrNodeBoolChainSuccess

# Called only after the read-only probe has claimed the root. Keeping this
# emission phase separate makes the mutation-journal transaction directly
# testable with malformed internal TypedIR without treating legal source as a
# failure.
@borrows
fn PrimaryBodyIrAppendNodeBoolConditionChainClaimed(
        bodyIR: var coreir.BodyIR,
        slotNames: var str[],
        varI32ParamNames: str[],
        lowering: var lower.LoweringPlanStub,
        typedFn: texpr.TypedExprIrFunction,
        irFunction: var lower.PrimaryObjectIrFunction,
        nodeIndex: int32,
        callOrdinal: var int32,
        currentBlockStart: var int32,
        resultSlotOut: var int32,
        receiptOut: var PrimaryBodyIrNodeBoolChainTransactionReceipt): PrimaryBodyIrNodeBoolChainOutcome =
    resultSlotOut = -1
    var emptyReceipt: PrimaryBodyIrNodeBoolChainTransactionReceipt
    receiptOut = emptyReceipt
    let checkpoint = PrimaryBodyIrNodeBoolChainCheckpointTake(bodyIR,
                                                              slotNames,
                                                              irFunction,
                                                              callOrdinal,
                                                              currentBlockStart)
    PrimaryBodyIrNodeBoolChainTransactionBegin(bodyIR,
                                                PrimaryBodyIrNodeBoolChainCheckpointClone(checkpoint),
                                                receiptOut)
    let chainBlockCount = PrimaryBodyIrNodeCondCbrBlockCount(lowering.typedIr, nodeIndex)
    if chainBlockCount <= 0:
        return PrimaryBodyIrNodeBoolChainAbort(bodyIR,
                                               slotNames,
                                               lowering.typedIr,
                                               irFunction,
                                               nodeIndex,
                                               callOrdinal,
                                               currentBlockStart,
                                               resultSlotOut,
                                               checkpoint,
                                               receiptOut,
                                               1)
    let resultSlotName = Fmt"#nev_bool{nodeIndex}"
    var resultSlot = PrimaryBodyIrFindSlotIndex(bodyIR,
                                                slotNames,
                                                resultSlotName)
    if resultSlot < 0:
        resultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   resultSlotName,
                                                   coreir.LocalI32Tag)
    if resultSlot < 0 || resultSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, resultSlot) != coreir.LocalI32Tag:
        return PrimaryBodyIrNodeBoolChainAbort(bodyIR,
                                               slotNames,
                                               lowering.typedIr,
                                               irFunction,
                                               nodeIndex,
                                               callOrdinal,
                                               currentBlockStart,
                                               resultSlotOut,
                                               checkpoint,
                                               receiptOut,
                                               2)
    # The false default is both semantic initialization and an append barrier.
    # Node evaluation may fold into its most recently appended op; placing this
    # transaction-owned op first prevents any fold from rewriting the committed
    # prefix. The false block can therefore branch without another store.
    var falseDefaultOp: coreir.BodyOp
    falseDefaultOp.kind = coreir.BodyOpLoadConstTag
    falseDefaultOp.target = resultSlot
    add(falseDefaultOp.operands, coreir.LocalI32Tag)
    add(falseDefaultOp.operands, 0)
    let _ = coreir.BodyIRAppendOp(bodyIR, falseDefaultOp)
    let chainFirstBlock = bodyIR.blocks.len
    let trueValueBlock = chainFirstBlock + chainBlockCount
    let falseValueBlock = trueValueBlock + 1
    let joinBlock = falseValueBlock + 1
    var chainFalseTerms: int32[]
    chainFalseTerms = []
    if !PrimaryBodyIrNodeEmitCondCbrChain(bodyIR,
                                          slotNames,
                                          varI32ParamNames,
                                          lowering,

                                          typedFn,
                                          irFunction,
                                          nodeIndex,
                                          trueValueBlock,
                                          falseValueBlock,
                                          callOrdinal,
                                          currentBlockStart,
                                          chainFalseTerms):
        return PrimaryBodyIrNodeBoolChainAbort(bodyIR,
                                               slotNames,
                                               lowering.typedIr,
                                               irFunction,
                                               nodeIndex,
                                               callOrdinal,
                                               currentBlockStart,
                                               resultSlotOut,
                                               checkpoint,
                                               receiptOut,
                                               3)
    if bodyIR.blocks.len != trueValueBlock:
        return PrimaryBodyIrNodeBoolChainAbort(bodyIR,
                                               slotNames,
                                               lowering.typedIr,
                                               irFunction,
                                               nodeIndex,
                                               callOrdinal,
                                               currentBlockStart,
                                               resultSlotOut,
                                               checkpoint,
                                               receiptOut,
                                               4)
    var trueOp: coreir.BodyOp
    trueOp.kind = coreir.BodyOpLoadConstTag
    trueOp.target = resultSlot
    add(trueOp.operands, coreir.LocalI32Tag)
    add(trueOp.operands, 1)
    let _ = coreir.BodyIRAppendOp(bodyIR, trueOp)
    var trueBr: coreir.BodyTerm
    trueBr.kind = coreir.BodyTermBrTag
    trueBr.conditionKind = coreir.BodyCondInvalidTag
    trueBr.lhsSlot = -1
    trueBr.rhsSlot = -1
    trueBr.resultSlot = -1
    trueBr.trueBlock = joinBlock
    trueBr.falseBlock = -1
    let trueTermIndex = coreir.BodyIRAppendTerm(bodyIR, trueBr)
    let trueBlockOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR,
                                     currentBlockStart,
                                     trueBlockOpCount,
                                     trueTermIndex)
    currentBlockStart = bodyIR.ops.len
    if bodyIR.blocks.len != falseValueBlock:
        return PrimaryBodyIrNodeBoolChainAbort(bodyIR,
                                               slotNames,
                                               lowering.typedIr,
                                               irFunction,
                                               nodeIndex,
                                               callOrdinal,
                                               currentBlockStart,
                                               resultSlotOut,
                                               checkpoint,
                                               receiptOut,
                                               5)

    var falseBr: coreir.BodyTerm
    falseBr.kind = coreir.BodyTermBrTag
    falseBr.conditionKind = coreir.BodyCondInvalidTag
    falseBr.lhsSlot = -1
    falseBr.rhsSlot = -1
    falseBr.resultSlot = -1
    falseBr.trueBlock = joinBlock
    falseBr.falseBlock = -1
    let falseTermIndex = coreir.BodyIRAppendTerm(bodyIR, falseBr)
    let falseBlockOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR,
                                     currentBlockStart,
                                     falseBlockOpCount,
                                     falseTermIndex)
    currentBlockStart = bodyIR.ops.len
    if bodyIR.blocks.len != joinBlock:
        return PrimaryBodyIrNodeBoolChainAbort(bodyIR,
                                               slotNames,
                                               lowering.typedIr,
                                               irFunction,
                                               nodeIndex,
                                               callOrdinal,
                                               currentBlockStart,
                                               resultSlotOut,
                                               checkpoint,
                                               receiptOut,
                                               6)
    # The only commit point: every append and scalar mutation is now valid.
    PrimaryBodyIrNodeBoolChainTransactionCommit(bodyIR,
                                                 slotNames,
                                                 receiptOut)
    resultSlotOut = resultSlot
    return PrimaryBodyIrNodeBoolChainSuccess

# Value-position short-circuit lowering. The probe is read-only; once it
# succeeds the claimed emitter either commits once or rolls back to a single
# structured poison op.
@borrows
fn PrimaryBodyIrAppendNodeBoolConditionChain(bodyIR: var coreir.BodyIR,
                                              slotNames: var str[],
                                              varI32ParamNames: str[],
                                              lowering: var lower.LoweringPlanStub,
                                              typedFn: texpr.TypedExprIrFunction,
                                              irFunction: var lower.PrimaryObjectIrFunction,
                                              nodeIndex: int32,
                                              callOrdinal: var int32,
                                              currentBlockStart: var int32,
                                              resultSlotOut: var int32): PrimaryBodyIrNodeBoolChainOutcome =
    resultSlotOut = -1
    if !PrimaryBodyIrNodeIsShortCircuitChainRoot(lowering.typedIr, nodeIndex):
        return PrimaryBodyIrNodeBoolChainNotApplicable
    if !PrimaryBodyIrNodeCondChainProbe(bodyIR,
                                        slotNames,
                                        varI32ParamNames,
                                        lowering,

                                        typedFn,
                                        irFunction,
                                        nodeIndex):
        return PrimaryBodyIrNodeBoolChainNotApplicable
    var receipt: PrimaryBodyIrNodeBoolChainTransactionReceipt
    return PrimaryBodyIrAppendNodeBoolConditionChainClaimed(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering,

                                                            typedFn,
                                                            irFunction,
                                                            nodeIndex,
                                                            callOrdinal,
                                                            currentBlockStart,
                                                            resultSlotOut,
                                                            receipt)

@borrows
fn PrimaryBodyIrAppendI32Assign(bodyIR: var coreir.BodyIR,
                                 bindingProjection:
                                     var coreir.BodyIRLocalBindingValueDefinitionProjection,
                                 slotNames: var str[],
                                 varI32ParamNames: str[],
                                 lowering: var lower.LoweringPlanStub,
                                 typedFn: texpr.TypedExprIrFunction,
                                 irFunction: var lower.PrimaryObjectIrFunction,
                                 stmt: lower.PrimaryObjectIrStatement,
                                 callOrdinal: var int32,
                                 currentBlockStart: var int32): bool =
    # Hoist typedFn managed str fields once (physical-source class).
    let typedFnName = typedFn.functionName
    let stmt_assignFieldName = stmt.assignFieldName
    let stmt_assignFieldOffsetBytes = stmt.assignFieldOffsetBytes
    let stmt_assignFieldSizeBytes = stmt.assignFieldSizeBytes
    let stmt_assignFieldType = stmt.assignFieldType
    let stmt_assignIndexNodeIndex = stmt.assignIndexNodeIndex
    let stmt_assignLvalueNodeIndex = stmt.assignLvalueNodeIndex
    let stmt_assignRootGlobalFlag = stmt.assignRootGlobalFlag
    let stmt_assignRootName = stmt.assignRootName
    let stmt_assignRootSourcePath = stmt.assignRootSourcePath
    let stmt_assignRootType = stmt.assignRootType
    let stmt_assignValueFieldAlignBytes = stmt.assignValueFieldAlignBytes
    let stmt_assignValueFieldName = stmt.assignValueFieldName
    let stmt_assignValueFieldOffsetBytes = stmt.assignValueFieldOffsetBytes
    let stmt_assignValueFieldSizeBytes = stmt.assignValueFieldSizeBytes
    let stmt_assignValueFieldType = stmt.assignValueFieldType
    let stmt_assignValueLhsText = stmt.assignValueLhsText
    let stmt_assignValueOpKind = stmt.assignValueOpKind
    let stmt_assignValueRhsText = stmt.assignValueRhsText
    let stmt_assignValueRootName = stmt.assignValueRootName
    let stmt_assignValueRootType = stmt.assignValueRootType
    let stmt_bindingName = stmt.bindingName
    let stmt_callTarget = stmt.callTarget
    let stmt_conditionRhsText = stmt.conditionRhsText
    let stmt_kind = stmt.kind
    let stmt_lineNumber = stmt.lineNumber
    let stmt_resultType = stmt.resultType
    let stmt_rhsNodeIndex = stmt.rhsNodeIndex
    let stmt_sourcePath = stmt.sourcePath
    let stmt_statementIndex = stmt.statementIndex
    let stmt_surfaceText = stmt.surfaceText
    let stmt_bindingTargetDefinitionRow = stmt.bindingTargetDefinitionRow
    PrimaryObjectPlanGuardTick()
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_i32_enter function={typedFnName} line={stmt_lineNumber} binding_len={stmt_bindingName.len} surface_len={stmt_surfaceText.len} field_len={stmt_assignFieldName.len} root_len={stmt_assignRootName.len}")
    let rhsText = strings.CloneStr(strutil.Strip(stmt_surfaceText))
    var lhsName = ""
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_A function={typedFnName} line={stmt_lineNumber}")
    if stmt_assignFieldName != "" && stmt_assignRootName != "":
        lhsName = stmt_assignRootName
    else:
        lhsName = PrimaryBodyIrCanonicalAssignLhsName(stmt_bindingName)
    # Multi-dimensional fixed-array store `grid[i][j] = v`: row-major flatten the
    # LHS to a single-index text `grid[(i)*cols+(j)]` so the existing 1-D indexed
    # store path computes the correct element address. Without this the multi-
    # bracket index parsed as a single garbage index and the store missed the
    # intended cell.
    if stmt_assignFieldName == "":
        var assignMultiRoot = ""
        var assignMultiList: str[]
        assignMultiList = []
        if PrimaryBodyIrMultiIndexParts(lhsName, assignMultiRoot, assignMultiList) >= 2:
            var assignMultiType = strings.CloneStr(stmt_assignRootType)
            if texpr.TypedExprNormalizeTypeText(assignMultiType) == "" ||
               assignMultiRoot != stmt_assignRootName:
                assignMultiType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt_lineNumber,
                                                                  assignMultiRoot)
            var assignFlatLhs = ""
            if assignMultiType != "" &&
               PrimaryBodyIrFlattenMultiIndexText(lowering.typedIr,
                                                  stmt_sourcePath,
                                                  texpr.TypedExprStripVarType(assignMultiType),
                                                  lhsName,
                                                  assignFlatLhs):
                lhsName = assignFlatLhs
    PrimaryObjectPlanGuardTick()
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_i32_lhs_done function={typedFnName} line={stmt_lineNumber} lhs_len={lhsName.len} rhs_len={rhsText.len} field={stmt_assignFieldName}")
    var primaryColdCond12: bool
    if len(lhsName) <= 0:
        primaryColdCond12 = true
    if len(rhsText) <= 0:
        primaryColdCond12 = true
    if primaryColdCond12:
        return false
    # A typed short-circuit local RHS is owned by the structured node path.
    # Once the root is known, neither probe failure nor emission failure may
    # fall through to the retired text CBR builder: that would let a partially
    # emitted CFG be retried and could duplicate a reachable RHS call.
    if stmt_assignFieldName == "" &&
       lhsName != "_" &&
       !stmt_assignRootGlobalFlag &&
       stmt_rhsNodeIndex >= 0 &&
       stmt_rhsNodeIndex < lowering.typedIr.nodes2_opKinds.len &&
       PrimaryBodyIrNodeIsShortCircuitChainRoot(lowering.typedIr, stmt_rhsNodeIndex):
        let assignBoolNodeLhsSlot = PrimaryBodyIrFindSlotIndex(bodyIR,
                                                               slotNames,
                                                               lhsName)
        if assignBoolNodeLhsSlot < 0 ||
           PrimaryBodyIrSlotType(bodyIR, assignBoolNodeLhsSlot) != coreir.LocalI32Tag:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt_lineNumber,
                                         int32(stmt_kind),
                                         6101,
                                         1)
            PrimaryBodyIrNodeEvalOnlyOwn()
            return true
        var assignBoolNodeValueSlot: int32
        let assignBoolNodeOutcome = PrimaryBodyIrAppendNodeBoolConditionChain(bodyIR,
                                                                               slotNames,
                                                                               varI32ParamNames,
                                                                               lowering,

                                                                               typedFn,
                                                                               irFunction,
                                                                               stmt_rhsNodeIndex,
                                                                               callOrdinal,
                                                                               currentBlockStart,
                                                                               assignBoolNodeValueSlot)
        if assignBoolNodeOutcome == PrimaryBodyIrNodeBoolChainClaimedFailed:
            PrimaryBodyIrNodeEvalOnlyOwn()
            return true
        if assignBoolNodeOutcome != PrimaryBodyIrNodeBoolChainSuccess ||
           assignBoolNodeValueSlot < 0 ||
           assignBoolNodeValueSlot >= bodyIR.localSlots.len ||
           PrimaryBodyIrSlotType(bodyIR, assignBoolNodeValueSlot) != coreir.LocalI32Tag:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt_lineNumber,
                                         int32(stmt_kind),
                                         6101,
                                         2)
            PrimaryBodyIrNodeEvalOnlyOwn()
            return true
        var assignBoolNodeCopy: coreir.BodyOp
        assignBoolNodeCopy.kind = coreir.BodyOpCopyLocalTag
        assignBoolNodeCopy.target = assignBoolNodeLhsSlot
        add(assignBoolNodeCopy.operands, assignBoolNodeValueSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, assignBoolNodeCopy)
        PrimaryBodyIrNodeEvalOnlyOwn()
        return true
    # T78 v6 根修: 纯量重赋值 `x = a && b`（x 已声明, 非 decl-init）若某臂含
    # 越界故障面(下标读, 如 `resolved = idx < state.reachable.len &&
    # state.reachable[idx]`), 下面通用节点求值臂只按"含真调用"探路（历史门,
    # 42094 一带）, 对无调用但含下标的复合形不设防——会直接调 EvalNode; EvalNode
    # 自身的 HasFaultingEagerSurface 门确会诚实 miss(不越界读), 落穿到本函数
    # 末尾更早已有的同款 CBR 链兜底(assignLogicalRoot 分支)理论上仍可命中, 但
    # T78 v5 门控扩面后该链路对此形判定不 productive, 实测诚实 bail(T78 v6 案卷)。
    # 显式在此优先走真短路 CBR 链(与 decl-init/field-store 同款 T78 v5 修法一致,
    # 不依赖后面数千行的落穿链)。门前(未真调用发射器前)不满足则原样落穿到既有
    # 逻辑, 行为不退化; 一旦真调用发射器就不再回退, 原样透传其成败(见下方内层
    # 注释)。剥括号后再探 &&/||(T78 current 教训: `((a && arr[i]))` 顶层 && 被括号
    # 盖住, 裸文本探测会漏判), 传给 AppendBoolConditionAssign 的仍是未剥括号
    # 原文本(其内部 ConditionCbrBlockCount/EmitConditionCbrChain 已各自剥括号)。
    if stmt_assignFieldName == "" &&
       lhsName != "_" &&
       !stmt_assignRootGlobalFlag &&
       stmt_rhsNodeIndex >= 0:
        let assignBoolEarlyGateText = PrimaryBodyIrStripOuterParens(rhsText)
        if (PrimaryBodyIrConditionHasAnd(assignBoolEarlyGateText) ||
            PrimaryBodyIrConditionHasOr(assignBoolEarlyGateText)) &&
           PrimaryBodyIrNodeTreeHasFaultingEagerSurface(lowering.typedIr, stmt_rhsNodeIndex):
            let assignBoolEarlyLhsSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
            if assignBoolEarlyLhsSlot >= 0 &&
               PrimaryBodyIrSlotType(bodyIR, assignBoolEarlyLhsSlot) == coreir.LocalI32Tag:
                # 一旦真开始调用 CBR 链发射器就不再回退：链内部一条 AND/OR 子项
                # 失败即整条链已带着前面子项已发射的 ops/blocks 半途而废，落穿
                # 到下面另一策略重试会在同一 bodyIR 上留两份不一致的产出
                # （悬挂 block / 潜在重复副作用调用）。已确认此形有故障面—— 若
                # 这条本就是"唯一安全解"的真短路链本身都失败，没有更安全的
                # 备选，原样透传结果（失败则由调用方既有 detail 分类 + poison
                # 兜底），与下面 45536 一带既有的同款调用点行为一致。
                var assignBoolEarlyBlockStart = currentBlockStart
                let assignBoolEarlyAssigned = PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                                                     slotNames,
                                                                                     lowering,

                                                                                     typedFn,
                                                                                     irFunction,
                                                                                     stmt_sourcePath,
                                                                                     stmt_lineNumber,
                                                                                     rhsText,
                                                                                     assignBoolEarlyLhsSlot,
                                                                                     callOrdinal,
                                                                                     assignBoolEarlyBlockStart)
                currentBlockStart = assignBoolEarlyBlockStart
                return assignBoolEarlyAssigned
    # 批次2c：rhs 已节点化时先走节点求值器（本地标量/str LHS）；批次3 扩展
    # var-i32/i64 形参 LHS（求值后经 var-store 回写指针目标）。求值失败或
    # LHS 形态不符落回文本路径（迁移窗口双轨）。
    if stmt_rhsNodeIndex >= 0 &&
       stmt_assignFieldName == "" &&
       lhsName != "_" &&
       (!stmt_assignRootGlobalFlag ||
        (len(lhsName) > 3 &&
         strings.SliceBytes(lhsName, len(lhsName) - 1, 1) == "]")) &&
       !PrimaryBodyIrHasSameLineLetCallBinding(irFunction.statements,
                                               stmt_lineNumber,
                                               lhsName):
        # 批次6b：same-line letcall 孪生行（绑定同名）拥有该语句的调用
        # 发射权——assign 行再走节点路径会双发调用；让位（letcall 行的
        # 节点拦截负责整树）。
        if len(lhsName) > 3 &&
           strings.SliceBytes(lhsName, len(lhsName) - 1, 1) == "]":
            var assignIdxOpen = -1
            var assignIdxLevel = 0
            var assignIdxScan = len(lhsName) - 2
            while assignIdxScan >= 0:
                if PrimaryBodyIrTextByteCodeEquals(lhsName, assignIdxScan, 93):
                    assignIdxLevel = assignIdxLevel + 1
                elif PrimaryBodyIrTextByteCodeEquals(lhsName, assignIdxScan, 91):
                    if assignIdxLevel == 0:
                        assignIdxOpen = assignIdxScan
                        break
                    assignIdxLevel = assignIdxLevel - 1
                assignIdxScan = assignIdxScan - 1
            var assignIdxBaseText = ""
            var assignIdxText = ""
            if assignIdxOpen > 0:
                assignIdxBaseText = strutil.Strip(strings.SliceBytes(lhsName, 0, assignIdxOpen))
                assignIdxText = strutil.Strip(strings.SliceBytes(lhsName,
                                                                 assignIdxOpen + 1,
                                                                 len(lhsName) - assignIdxOpen - 2))
            # 嵌套 seq-of-seq 元素存储 `grid[i][j] = v`：base 本身是下标
            # `grid[i]`（含 `[`），其值是内层 seq 头（16B 聚合，len@0/buf@8）。
            # 先按读路径（SeqIndexValueSlot）取内层头聚合槽，再从 header+8 取
            # 内层 buffer 指针，按内层元素步长定址 `innerBuf + j*esz`，把求值后的
            # RHS 存进去——内层 buffer 共享堆指针，故经头副本读出的指针即真地址。
            if assignIdxBaseText != "" &&
               assignIdxText != "" &&
               !PrimaryBodyIrTextHasCallSurface(assignIdxText) &&
               parser.ParserFindText(assignIdxBaseText, "[") >= 0 &&
               PrimaryBodyIrTextByteCodeEquals(assignIdxBaseText, len(assignIdxBaseText) - 1, 93):
                var nestRoot = ""
                var nestList: str[]
                nestList = []
                # base 必须是纯 `ident[...]...` 链（外层根为裸标识）。
                if PrimaryBodyIrMultiIndexParts(assignIdxBaseText, nestRoot, nestList) >= 1:
                    var nestOuterType = texpr.TypedExprStripVarType(PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                                                    typedFn,
                                                                                                    irFunction,
                                                                                                    stmt_lineNumber,
                                                                                                    nestRoot))
                    # 逐维剥下标得到 base（=grid[i]）的元素类型，再取内层元素类型。
                    var nestBaseType = nestOuterType
                    for nestDimIndex in 0..<nestList.len:
                        nestBaseType = PrimaryBodyIrIndexedElementTypeText(nestBaseType)
                    let nestElemType = PrimaryBodyIrIndexedElementTypeText(nestBaseType)
                    var nestElemKind = coreir.LocalInvalidTag
                    var nestElemSize = 0
                    var nestElemAlign = 0
                    if nestElemType != "":
                        PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                       stmt_sourcePath,
                                                       nestElemType,
                                                       nestElemKind,
                                                       nestElemSize,
                                                       nestElemAlign)
                    # 仅处理内层为动态 seq（base 类型 `...[]`）且元素为标量/聚合。
                    if PrimaryBodyIrTypeTextIsDynamicSeq(nestBaseType) &&
                       nestElemSize > 0 &&
                       (nestElemKind == coreir.LocalI32Tag ||
                        nestElemKind == coreir.LocalI64Tag ||
                        nestElemKind == coreir.LocalPtrTag ||
                        nestElemKind == coreir.LocalAggregateTag):
                        primaryBodyIrNodeEvalMissOp = ""
                        let nestEmitMark = primaryBodyIrNodeEvalCallEmitCount
                        var nestReady = true
                        if PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, stmt_rhsNodeIndex):
                            let nestProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering,

                                                                           share(typedFn),
                                                                           irFunction,
                                                                           stmt_rhsNodeIndex)
                            if nestProbeKind < 0:
                                nestReady = false
                        # 内层头聚合槽：与读路径同款（SeqIndexValueSlot 取元素副本）。
                        var nestHdrSlot = -1
                        if nestReady:
                            nestHdrSlot = PrimaryBodyIrSeqIndexValueSlot(bodyIR,
                                                                         slotNames,
                                                                         varI32ParamNames,
                                                                         lowering.typedIr,
                                                                         typedFn,
                                                                         irFunction,
                                                                         stmt_sourcePath,
                                                                         stmt_lineNumber,
                                                                         assignIdxBaseText,
                                                                         callOrdinal)
                        var nestIdxSlot = -1
                        if nestHdrSlot >= 0 &&
                           (PrimaryBodyIrSlotType(bodyIR, nestHdrSlot) == coreir.LocalAggregateTag ||
                            PrimaryBodyIrSlotType(bodyIR, nestHdrSlot) == coreir.LocalPtrTag) &&
                           stmt_assignIndexNodeIndex >= 0:
                            # 阶段1 迁移：嵌套 seq 末层下标 `grid[i][j]` 的 `j` 从文本派发
                            # （ScalarValueSlotForText i32/i64 两路）改为节点求值器
                            # PrimaryBodyIrEvalNode(stmt_assignIndexNodeIndex)。前端
                            # typed_expr:20135 以 expected int32 为末层下标 idxText 建
                            # assignIndexNodeIndex（1:1 末层，与本路径 assignIdxText 同串）；
                            # EvalNode/Probe 覆盖变量(ParamRef/LocalRef)、算术、字段读
                            # (OpFieldGet)、索引读(OpIndexGet)族，与被删文本两路同覆盖面。
                            # 探针放行 i32/i64（madd 两宽皆收），求值在调用已发射后失败禁止
                            # 落回（6101 毒标，与单层索引赋值迁移 701f2a19d / for-range 起界
                            # dac2ed490 同款；外层 6102 守卫亦覆盖，此处更早更专一）。
                            let nestIdxNodeProbe = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                             slotNames,
                                                                             varI32ParamNames,
                                                                             lowering,

                                                                             share(typedFn),
                                                                             irFunction,
                                                                             stmt_assignIndexNodeIndex)
                            if nestIdxNodeProbe == coreir.LocalI32Tag ||
                               nestIdxNodeProbe == coreir.LocalI64Tag:
                                let nestIdxEmitMark = primaryBodyIrNodeEvalCallEmitCount
                                nestIdxSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                    slotNames,
                                                                    varI32ParamNames,
                                                                    lowering,

                                                                    share(typedFn),
                                                                    irFunction,
                                                                    stmt_assignIndexNodeIndex,
                                                                    callOrdinal)
                                if nestIdxSlot < 0 &&
                                   primaryBodyIrNodeEvalCallEmitCount != nestIdxEmitMark:
                                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                                 stmt_lineNumber,
                                                                 int32(stmt_kind),
                                                                 6101,
                                                                 0)
                                    return true
                        var nestValueSlot = -1
                        if nestIdxSlot >= 0:
                            nestValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,

                                                                  share(typedFn),
                                                                  irFunction,
                                                                  stmt_rhsNodeIndex,
                                                                  callOrdinal)
                        var nestStored = false
                        if nestValueSlot >= 0:
                            var nestValueKind = PrimaryBodyIrSlotType(bodyIR, nestValueSlot)
                            if nestElemKind == coreir.LocalI64Tag &&
                               nestValueKind == coreir.LocalI32Tag:
                                let nestWideSlot = PrimaryBodyIrNodeEvalWidenToI64(bodyIR,
                                                                                   slotNames,
                                                                                   nestValueSlot,
                                                                                   stmt_rhsNodeIndex,
                                                                                   4)
                                if nestWideSlot >= 0:
                                    nestValueSlot = nestWideSlot
                                    nestValueKind = coreir.LocalI64Tag
                            var nestKindOk = false
                            if nestElemKind == coreir.LocalI32Tag:
                                nestKindOk = nestValueKind == coreir.LocalI32Tag
                            elif nestElemKind == coreir.LocalI64Tag:
                                nestKindOk = nestValueKind == coreir.LocalI64Tag
                            elif nestElemKind == coreir.LocalPtrTag:
                                nestKindOk = nestValueKind == coreir.LocalPtrTag ||
                                             nestValueKind == coreir.LocalI64Tag
                            else:
                                nestKindOk = nestValueKind == coreir.LocalAggregateTag
                            if nestKindOk:
                                let nestBufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                slotNames,
                                                                                Fmt"#nest_buf#{stmt_lineNumber}#{bodyIR.ops.len}",
                                                                                coreir.LocalPtrTag)
                                let nestEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                                  slotNames,
                                                                                  Fmt"#nest_esz#{stmt_lineNumber}#{bodyIR.ops.len}",
                                                                                  coreir.LocalI64Tag,
                                                                                  nestElemSize)
                                let nestAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                 slotNames,
                                                                                 Fmt"#nest_addr#{stmt_lineNumber}#{bodyIR.ops.len}",
                                                                                 coreir.LocalPtrTag)
                                if nestBufSlot >= 0 && nestEszSlot >= 0 && nestAddrSlot >= 0:
                                    # 内层 buffer = *(内层头 + 8)。聚合头槽的 FieldLoad
                                    # 从槽地址+8 读出 buf 指针。
                                    var nestBufLoadOp: coreir.BodyOp
                                    nestBufLoadOp.kind = coreir.BodyOpFieldLoadTag
                                    nestBufLoadOp.target = nestBufSlot
                                    add(nestBufLoadOp.operands, nestHdrSlot)
                                    add(nestBufLoadOp.operands, nestBufSlot)
                                    add(nestBufLoadOp.operands, 8)
                                    add(nestBufLoadOp.operands, 8)
                                    let _ = coreir.BodyIRAppendOp(bodyIR, nestBufLoadOp)
                                    var nestAddrOp: coreir.BodyOp
                                    nestAddrOp.kind = coreir.BodyOpBinOpTag
                                    nestAddrOp.target = nestAddrSlot
                                    add(nestAddrOp.operands, coreir.LocalI64Tag)
                                    add(nestAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
                                    add(nestAddrOp.operands, nestIdxSlot)
                                    add(nestAddrOp.operands, nestEszSlot)
                                    add(nestAddrOp.operands, nestBufSlot)
                                    let _ = coreir.BodyIRAppendOp(bodyIR, nestAddrOp)
                                    PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                                                         nestAddrSlot,
                                                                         nestValueSlot,
                                                                         nestElemSize)
                                    nestStored = true
                        if nestStored:
                            PrimaryBodyIrNodeEvalOnlyOwn()
                            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_index_nested function={typedFnName} line={stmt_lineNumber}")
                            return true
                        if primaryBodyIrNodeEvalCallEmitCount != nestEmitMark:
                            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                         stmt_lineNumber,
                                                         int32(stmt_kind),
                                                         6102,
                                                         0)
                            return true
                        if primaryBodyIrNodeEvalMissOp == "":
                            let _ = PrimaryBodyIrNodeEvalMissAt("store_index_nested_shape")
            if stmt_assignLvalueNodeIndex >= 0 &&
               stmt_assignLvalueNodeIndex <
                   lowering.typedIr.nodes2_nodeIndexs.len &&
               lowering.typedIr.nodes2_opKinds[
                   stmt_assignLvalueNodeIndex] ==
                   texpr.TypedExprIrOpIndexGet &&
               lowering.typedIr.nodes2_opKinds[
                   arenamod.ArenaArrayInt32Get(
                       lowering.typedIr.arena,
                       lowering.typedIr.nodes2_operand0NodeIndexs,
                       stmt_assignLvalueNodeIndex)] !=
                   texpr.TypedExprIrOpIndexGet:
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"DIAG aidx_enter fn={typedFnName} line={stmt_lineNumber} lhs={stmt_bindingName} base={assignIdxBaseText} idxt={assignIdxText} rhs={stmt_surfaceText} rhsn={stmt_rhsNodeIndex} idxn={stmt_assignIndexNodeIndex}")
                var assignIdxRootSlot: int32
                var assignIdxHeaderOffset: int32
                var assignIdxElemKind = coreir.LocalInvalidTag
                var assignIdxElemSize = 0
                var exactIndexNode: int32
                var assignIdxIsFixedArray = false
                if stmt_rhsNodeIndex < 0 ||
                   !PrimaryBodyIrIndexedLvalueIdentityExact(
                       bodyIR,
                       bindingProjection,
                       lowering,
                       typedFn,
                       stmt_statementIndex,
                       stmt_assignLvalueNodeIndex,
                       stmt_rhsNodeIndex,
                       assignIdxRootSlot,
                       assignIdxHeaderOffset,
                       assignIdxElemKind,
                       assignIdxElemSize,
                       exactIndexNode,
                       assignIdxIsFixedArray) ||
                   exactIndexNode != stmt_assignIndexNodeIndex:
                    panic("primary body ir indexed assignment: immutable lvalue identity invalid")
                if assignIdxElemSize > 0 &&
                   (assignIdxElemKind == coreir.LocalI32Tag ||
                    assignIdxElemKind == coreir.LocalI64Tag ||
                    assignIdxElemKind == coreir.LocalPtrTag ||
                    assignIdxElemKind == coreir.LocalStrTag ||
                    assignIdxElemKind == coreir.LocalAggregateTag):
                    primaryBodyIrNodeEvalMissOp = ""
                    var assignIdxReady = true
                    if PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, stmt_rhsNodeIndex):
                        let assignIdxProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                            slotNames,
                                                                            varI32ParamNames,
                                                                            lowering,

                                                                            share(typedFn),
                                                                            irFunction,
                                                                            stmt_rhsNodeIndex)
                        if assignIdxProbeKind < 0:
                            assignIdxReady = false
                        elif assignIdxElemKind == coreir.LocalI32Tag:
                            assignIdxReady = assignIdxProbeKind == coreir.LocalI32Tag
                        elif assignIdxElemKind == coreir.LocalI64Tag:
                            assignIdxReady = assignIdxProbeKind == coreir.LocalI32Tag ||
                                             assignIdxProbeKind == coreir.LocalI64Tag
                        elif assignIdxElemKind == coreir.LocalPtrTag:
                            assignIdxReady = assignIdxProbeKind == coreir.LocalPtrTag ||
                                             assignIdxProbeKind == coreir.LocalI64Tag
                        elif assignIdxElemKind == coreir.LocalAggregateTag:
                            assignIdxReady = assignIdxProbeKind == coreir.LocalAggregateTag
                        else:
                            assignIdxReady = assignIdxProbeKind == coreir.LocalStrTag
                    var assignIdxSlot = -1
                    if assignIdxReady && stmt_assignIndexNodeIndex >= 0:
                        # 阶段1 迁移：索引下标从文本派发（ScalarValueSlotForText i32/i64
                        # + ContextScalarValueSlotForText 字段读 共 3 派发点）改为节点
                        # 求值器 PrimaryBodyIrEvalNode。前端 typed_expr:20019 以 expected
                        # int32 为末层下标 idxText 建 assignIndexNodeIndex；EvalNode/Probe
                        # 覆盖变量(ParamRef/LocalRef)、算术、字段读(OpFieldGet)、索引读
                        # (OpIndexGet)族下标，与被删文本三路同覆盖面。探针放行 i32/i64
                        # （下标既可 i32 也可 i64 索引，madd 两宽皆收），求值在调用已发射
                        # 后失败禁止落回（6101 毒标，与 for-range 起界迁移 dac2ed490 同款）。
                        let assignIdxNodeProbe = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                            slotNames,
                                                                            varI32ParamNames,
                                                                            lowering,

                                                                            share(typedFn),
                                                                            irFunction,
                                                                            stmt_assignIndexNodeIndex)
                        if assignIdxNodeProbe == coreir.LocalI32Tag ||
                           assignIdxNodeProbe == coreir.LocalI64Tag:
                            let assignIdxIdxEmitMark = primaryBodyIrNodeEvalCallEmitCount
                            assignIdxSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,

                                                                  share(typedFn),
                                                                  irFunction,
                                                                  stmt_assignIndexNodeIndex,
                                                                  callOrdinal)
                            if assignIdxSlot < 0 &&
                               primaryBodyIrNodeEvalCallEmitCount != assignIdxIdxEmitMark:
                                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                             stmt_lineNumber,
                                                             int32(stmt_kind),
                                                             6101,
                                                             0)
                                return true
                    let assignIdxEmitMark = primaryBodyIrNodeEvalCallEmitCount
                    var assignIdxValueSlot = -1
                    if assignIdxReady && assignIdxSlot >= 0:
                        assignIdxValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering,

                                                                   share(typedFn),
                                                                   irFunction,
                                                                   stmt_rhsNodeIndex,
                                                                   callOrdinal)
                    var assignIdxStored = false
                    if assignIdxValueSlot >= 0:
                        var assignIdxValueKind = PrimaryBodyIrSlotType(bodyIR, assignIdxValueSlot)
                        if assignIdxElemKind == coreir.LocalI64Tag &&
                           assignIdxValueKind == coreir.LocalI32Tag:
                            let assignIdxWideSlot = PrimaryBodyIrNodeEvalWidenToI64(bodyIR,
                                                                                    slotNames,
                                                                                    assignIdxValueSlot,
                                                                                    stmt_rhsNodeIndex,
                                                                                    4)
                            if assignIdxWideSlot >= 0:
                                assignIdxValueSlot = assignIdxWideSlot
                                assignIdxValueKind = coreir.LocalI64Tag
                        var assignIdxKindOk = false
                        if assignIdxElemKind == coreir.LocalI32Tag:
                            assignIdxKindOk = assignIdxValueKind == coreir.LocalI32Tag
                        elif assignIdxElemKind == coreir.LocalI64Tag:
                            assignIdxKindOk = assignIdxValueKind == coreir.LocalI64Tag
                        elif assignIdxElemKind == coreir.LocalPtrTag:
                            assignIdxKindOk = assignIdxValueKind == coreir.LocalPtrTag ||
                                              assignIdxValueKind == coreir.LocalI64Tag
                        elif assignIdxElemKind == coreir.LocalAggregateTag:
                            assignIdxKindOk = assignIdxValueKind == coreir.LocalAggregateTag
                        else:
                            assignIdxKindOk = assignIdxValueKind == coreir.LocalStrTag
                        if assignIdxKindOk &&
                           assignIdxValueKind == coreir.LocalStrTag &&
                           PrimaryBodyIrLocalIsParam(bodyIR.localSlots[assignIdxValueSlot]):
                            let assignIdxStrTmpSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                    slotNames,
                                                                                    Fmt"#aidxs{stmt_rhsNodeIndex}#{bodyIR.ops.len}",
                                                                                    coreir.LocalStrTag)
                            if assignIdxStrTmpSlot >= 0:
                                var assignIdxStrMatOp: coreir.BodyOp
                                assignIdxStrMatOp.kind = coreir.BodyOpFieldLoadTag
                                assignIdxStrMatOp.target = assignIdxStrTmpSlot
                                add(assignIdxStrMatOp.operands, assignIdxValueSlot)
                                add(assignIdxStrMatOp.operands, assignIdxStrTmpSlot)
                                add(assignIdxStrMatOp.operands, 0)
                                add(assignIdxStrMatOp.operands, 24)
                                let _ = coreir.BodyIRAppendOp(bodyIR, assignIdxStrMatOp)
                                assignIdxValueSlot = assignIdxStrTmpSlot
                            else:
                                assignIdxKindOk = false
                        if assignIdxKindOk:
                            let assignIdxBufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                 slotNames,
                                                                                 Fmt"#aidx_buf#{stmt_lineNumber}#{bodyIR.ops.len}",
                                                                                 coreir.LocalPtrTag)
                            let assignIdxEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                                   slotNames,
                                                                                   Fmt"#aidx_esz#{stmt_lineNumber}#{bodyIR.ops.len}",
                                                                                   coreir.LocalI64Tag,
                                                                                   assignIdxElemSize)
                            let assignIdxAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                  slotNames,
                                                                                  Fmt"#aidx_addr#{stmt_lineNumber}#{bodyIR.ops.len}",
                                                                                  coreir.LocalPtrTag)
                            if assignIdxBufSlot >= 0 && assignIdxEszSlot >= 0 && assignIdxAddrSlot >= 0:
                                var assignIdxBaseReady = true
                                if assignIdxIsFixedArray:
                                    # 定长数组：base = 聚合首地址（off=0），元素内联，
                                    # 无 buf 间接。复用 SeqAddHeaderPtrSlot 物化首地址。
                                    let assignFaBaseSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                                                           slotNames,
                                                                                           stmt_lineNumber,
                                                                                           assignIdxRootSlot,
                                                                                           assignIdxHeaderOffset)
                                    if assignFaBaseSlot < 0:
                                        let _ = PrimaryBodyIrNodeEvalMissAt("store_index_fixed_base")
                                        assignIdxBaseReady = false
                                    else:
                                        assignIdxBufSlot = assignFaBaseSlot
                                else:
                                    var assignIdxBufLoadOp: coreir.BodyOp
                                    assignIdxBufLoadOp.kind = coreir.BodyOpFieldLoadTag
                                    assignIdxBufLoadOp.target = assignIdxBufSlot
                                    add(assignIdxBufLoadOp.operands, assignIdxRootSlot)
                                    add(assignIdxBufLoadOp.operands, assignIdxBufSlot)
                                    add(assignIdxBufLoadOp.operands, assignIdxHeaderOffset + 8)
                                    add(assignIdxBufLoadOp.operands, 8)
                                    let _ = coreir.BodyIRAppendOp(bodyIR, assignIdxBufLoadOp)
                                if assignIdxBaseReady:
                                    var assignIdxAddrOp: coreir.BodyOp
                                    assignIdxAddrOp.kind = coreir.BodyOpBinOpTag
                                    assignIdxAddrOp.target = assignIdxAddrSlot
                                    add(assignIdxAddrOp.operands, coreir.LocalI64Tag)
                                    add(assignIdxAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
                                    add(assignIdxAddrOp.operands, assignIdxSlot)
                                    add(assignIdxAddrOp.operands, assignIdxEszSlot)
                                    add(assignIdxAddrOp.operands, assignIdxBufSlot)
                                    let _ = coreir.BodyIRAppendOp(bodyIR, assignIdxAddrOp)
                                    PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                                                         assignIdxAddrSlot,
                                                                         assignIdxValueSlot,
                                                                         assignIdxElemSize)
                                    assignIdxStored = true
                    if assignIdxStored:
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_index function={typedFnName} line={stmt_lineNumber}")
                        return true
                    if primaryBodyIrNodeEvalCallEmitCount != assignIdxEmitMark:
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt_lineNumber,
                                                     int32(stmt_kind),
                                                     6101,
                                                     0)
                        return true
                    if primaryBodyIrNodeEvalMissOp == "":
                        let _ = PrimaryBodyIrNodeEvalMissAt("store_index_shape")
        # A subscripted LHS (`arr[i]`, including a row-major-flattened multi-dim
        # `grid[(i)*cols+(j)]`) is an indexed store, never a plain scalar-slot
        # store. Resolving it as a named slot here would collide with the value
        # slot a prior indexed READ created under the same flattened text and
        # corrupt that cached value instead of the array cell. Leave it for the
        # text indexed-store path below.
        let nodeEvalLhsSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
        if nodeEvalLhsSlot >= 0 &&
           nodeEvalLhsSlot < bodyIR.localSlots.len &&
           !PrimaryBodyIrTextHasFieldOrIndex(lhsName):
            let nodeEvalLhsPointee = PrimaryBodyIrVarParamPointeeKind(bodyIR, nodeEvalLhsSlot)
            let nodeEvalLhsVarI32 = PrimaryBodyIrNameInList(varI32ParamNames, lhsName) ||
                                    nodeEvalLhsPointee == coreir.LocalI32Tag
            var nodeEvalLhsKind = PrimaryBodyIrSlotType(bodyIR, nodeEvalLhsSlot)
            if nodeEvalLhsPointee == coreir.LocalInvalidTag &&
               !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[nodeEvalLhsSlot]):
                var nodeEvalLhsType = strings.CloneStr(stmt_resultType)
                if nodeEvalLhsType == "" || nodeEvalLhsType == "unknown" || nodeEvalLhsType == "call_expr":
                    nodeEvalLhsType = PrimaryBodyIrNodeResultTypeText(lowering.typedIr, stmt_rhsNodeIndex)
                if PrimaryBodyIrRetypeLocalScalarSlotForType(bodyIR,
                                                             lowering.typedIr,
                                                             stmt_sourcePath,
                                                             nodeEvalLhsSlot,
                                                             nodeEvalLhsType):
                    nodeEvalLhsKind = PrimaryBodyIrSlotType(bodyIR, nodeEvalLhsSlot)
            if stmt_rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               lowering.typedIr.nodes2_opKinds[stmt_rhsNodeIndex] == texpr.TypedExprIrOpEmptySeqInit &&
               !nodeEvalLhsVarI32 &&
               nodeEvalLhsPointee == coreir.LocalInvalidTag &&
               nodeEvalLhsKind == coreir.LocalAggregateTag &&
               !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[nodeEvalLhsSlot]):
                primaryBodyIrNodeEvalMissOp = ""
                if PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                    slotNames,
                                                    nodeEvalLhsSlot,
                                                    callOrdinal):
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=empty_seq_init function={typedFnName} line={stmt_lineNumber}")
                    return true
                let _ = PrimaryBodyIrNodeEvalMissAt("empty_seq_zero")
            # new(T):堆对象分配内征。前端给 `var a: I32 = new(I32)` 建占位
            # CallExpr 节点(literalText=="new"、surfaceText 保留完整 `new(I32)`)。
            # LHS 是 ref 对象槽(LocalPtrTag、无 pointee=非 var 形参指针写回)时,
            # 按 surfaceText 调 AppendNewObjectValue(→AppendHeapObjectAllocZero)
            # 直接分配零初始化对象写入目标槽。必须在下面 OpCallExpr 通用支之前——
            # 否则 new 被当函数调用 miss(call_ordinal)。命中即权威返回；分配失败
            # 落 MissAt("new_object")让位文本路径(无回归)。
            var ai3Lit = ""
            var ai3Surf = ""
            if stmt_rhsNodeIndex >= 0 && stmt_rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                let ai3LitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[stmt_rhsNodeIndex])
                let ai3SurfRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_surfaceTextIds[stmt_rhsNodeIndex])
                if IsOk(ai3LitRes) && IsOk(ai3SurfRes):
                    ai3Lit = Value(ai3LitRes)
                    ai3Surf = Value(ai3SurfRes)
            if stmt_rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               lowering.typedIr.nodes2_opKinds[stmt_rhsNodeIndex] == texpr.TypedExprIrOpCallExpr &&
               ai3Lit == "new" &&
               nodeEvalLhsKind == coreir.LocalPtrTag &&
               nodeEvalLhsPointee == coreir.LocalInvalidTag:
                primaryBodyIrNodeEvalMissOp = ""
                # [wall80] 锚点契约修正：同 decl-init 臂，「append 前 ops.len」
                # 盖到的是发射器内部 LoadConst 而非 alloc Call op（v6 现位墙
                # 死因）；alloc op 精确索引改由发射器 out 参回传。
                var newObjectAllocOpIndex: int32
                if PrimaryBodyIrAppendNewObjectValue(bodyIR,
                                                     slotNames,
                                                     lowering.typedIr,
                                                     stmt_sourcePath,
                                                     ai3Surf,
                                                     nodeEvalLhsSlot,
                                                     callOrdinal,
                                                     newObjectAllocOpIndex):
                    # [wall72] alloc 定义盖章：行源=语句级绑定目标定义行
                    # （声明组权威 R_decl），节点行通道按设计不可达。
                    PrimaryBodyIrBindNewObjectAllocValueDefinitionExact(
                        bodyIR,
                        lowering.typedIr,
                        lowering.typeArenaStructuralKinds,
                        lowering.typeArenaScalarKinds,
                        lowering.typeArenaChildTypeIds,
                        lowering.typeArenaFixedLengths,
                        lowering.typeArenaSizeBytes,
                        lowering.typeArenaAlignBytes,
                        nodeEvalLhsSlot,
                        newObjectAllocOpIndex,
                        stmt_bindingTargetDefinitionRow)
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=new_object function={typedFnName} line={stmt_lineNumber}")
                    return true
                let _ = PrimaryBodyIrNodeEvalMissAt("new_object")
            # 批次5：RHS 整为 CallExpr 节点且 LHS 是平凡本地标量/str 槽时
            #（var 形参经指针写回的协议另算，留文本路径）走 CallExpr 节点
            # 发射器。命中即权威返回；miss 落回文本路径（迁移窗口双轨）。
            if stmt_rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               lowering.typedIr.nodes2_opKinds[stmt_rhsNodeIndex] == texpr.TypedExprIrOpCallExpr &&
               PrimaryBodyIrCastCallTargetKind(ai3Lit) == coreir.LocalInvalidTag &&
               nodeEvalLhsPointee == coreir.LocalInvalidTag &&
               (nodeEvalLhsKind == coreir.LocalI32Tag ||
                nodeEvalLhsKind == coreir.LocalI64Tag ||
                nodeEvalLhsKind == coreir.LocalStrTag ||
                nodeEvalLhsKind == coreir.LocalPtrTag ||
                nodeEvalLhsKind == coreir.LocalAggregateTag):
                primaryBodyIrNodeEvalMissOp = ""
                let callExprEmitMark = primaryBodyIrNodeEvalCallEmitCount
                var callExprNodeDone = false
                # 批次6b：嵌套调用实参一旦发射不可落回文本路径，发射前
                # 必须先过纯探针。
                if PrimaryBodyIrNodeEvalProbe(bodyIR,
                                              slotNames,
                                              varI32ParamNames,
                                              lowering,

                                              share(typedFn),
                                              irFunction,
                                              stmt_rhsNodeIndex) >= 0:
                    callExprNodeDone = PrimaryBodyIrAppendCallExprNodeToSlot(bodyIR,
                                                                             slotNames,
                                                                             lowering,

                                                                             typedFn,
                                                                             irFunction,
                                                                             varI32ParamNames,
                                                                             stmt_rhsNodeIndex,
                                                                             nodeEvalLhsSlot,
                                                                             stmt_lineNumber,
                                                                             callOrdinal)
                if callExprNodeDone:
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit function={typedFnName} line={stmt_lineNumber}")
                    return true
                if primaryBodyIrNodeEvalCallEmitCount != callExprEmitMark:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt_lineNumber,
                                                 int32(stmt_kind),
                                                 6101,
                                                 0)
                    return true
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    var callExprMissOpText = primaryBodyIrNodeEvalMissOp
                    if callExprMissOpText == "":
                        callExprMissOpText = "call_expr"
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={callExprMissOpText} function={typedFnName} line={stmt_lineNumber}")
            if stmt_rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               lowering.typedIr.nodes2_opKinds[stmt_rhsNodeIndex] == texpr.TypedExprIrOpEmptySeqInit &&
               nodeEvalLhsPointee == coreir.LocalInvalidTag:
                primaryBodyIrNodeEvalMissOp = ""
                if nodeEvalLhsKind == coreir.LocalAggregateTag &&
                   PrimaryLocalSlotSizeOf(bodyIR.localSlots[nodeEvalLhsSlot]) == 16:
                    let emptySeqZeroSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                           slotNames,
                                                                           Fmt"{lhsName}#seq_zero64",
                                                                           coreir.LocalI64Tag,
                                                                           0)
                    if emptySeqZeroSlot >= 0:
                        var emptySeqZeroLo: coreir.BodyOp
                        emptySeqZeroLo.kind = coreir.BodyOpFieldStoreTag
                        emptySeqZeroLo.target = nodeEvalLhsSlot
                        add(emptySeqZeroLo.operands, nodeEvalLhsSlot)
                        add(emptySeqZeroLo.operands, emptySeqZeroSlot)
                        add(emptySeqZeroLo.operands, 0)
                        add(emptySeqZeroLo.operands, 8)
                        let _ = coreir.BodyIRAppendOp(bodyIR, emptySeqZeroLo)
                        var emptySeqZeroHi: coreir.BodyOp
                        emptySeqZeroHi.kind = coreir.BodyOpFieldStoreTag
                        emptySeqZeroHi.target = nodeEvalLhsSlot
                        add(emptySeqZeroHi.operands, nodeEvalLhsSlot)
                        add(emptySeqZeroHi.operands, emptySeqZeroSlot)
                        add(emptySeqZeroHi.operands, 8)
                        add(emptySeqZeroHi.operands, 8)
                        let _ = coreir.BodyIRAppendOp(bodyIR, emptySeqZeroHi)
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=empty_seq_init function={typedFnName} line={stmt_lineNumber}")
                        return true
                let _ = PrimaryBodyIrNodeEvalMissAt("empty_seq_init")
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op=empty_seq_init function={typedFnName} line={stmt_lineNumber}")
            if stmt_rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               lowering.typedIr.nodes2_opKinds[stmt_rhsNodeIndex] == texpr.TypedExprIrOpNilPtr &&
               nodeEvalLhsPointee == coreir.LocalInvalidTag:
                primaryBodyIrNodeEvalMissOp = ""
                let nilLhsBindingType = texpr.TypedExprNormalizeTypeText(PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                                                          typedFn,
                                                                                                          irFunction,
                                                                                                          stmt_lineNumber,
                                                                                                          lhsName))
                if nodeEvalLhsKind == coreir.LocalPtrTag &&
                   !PrimaryStartsWith(nilLhsBindingType, "var"):
                    var nilAssignOp: coreir.BodyOp
                    nilAssignOp.kind = coreir.BodyOpLoadConstTag
                    nilAssignOp.target = nodeEvalLhsSlot
                    add(nilAssignOp.operands, coreir.LocalPtrTag)
                    add(nilAssignOp.operands, 0)
                    let _ = coreir.BodyIRAppendOp(bodyIR, nilAssignOp)
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=nil_ptr function={typedFnName} line={stmt_lineNumber}")
                    return true
                if nodeEvalLhsKind == coreir.LocalPtrTag &&
                   PrimaryStartsWith(nilLhsBindingType, "var") &&
                   PrimaryBodyIrLocalIsParam(bodyIR.localSlots[nodeEvalLhsSlot]):
                    let nilVarPtrZeroSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                            slotNames,
                                                                            Fmt"{lhsName}#var_ptr_nil_zero",
                                                                            coreir.LocalI64Tag,
                                                                            0)
                    if nilVarPtrZeroSlot >= 0:
                        PrimaryBodyIrAppendVarI64Store(bodyIR, nodeEvalLhsSlot, nilVarPtrZeroSlot)
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=nil_var_ptr function={typedFnName} line={stmt_lineNumber}")
                        return true
                let _ = PrimaryBodyIrNodeEvalMissAt("nil_ptr")
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op=nil_ptr function={typedFnName} line={stmt_lineNumber}")
            let nodeEvalLhsVarStr = nodeEvalLhsKind == coreir.LocalAggregateTag &&
                                    bodyIR.localSlots[nodeEvalLhsSlot].auxValue == coreir.LocalStrTag &&
                                    PrimaryBodyIrLocalIsParam(bodyIR.localSlots[nodeEvalLhsSlot])
            var nodeEvalAttempt = false
            if nodeEvalLhsVarI32 ||
               nodeEvalLhsPointee == coreir.LocalI64Tag ||
               nodeEvalLhsPointee == coreir.LocalF64Tag ||
               nodeEvalLhsVarStr:
                nodeEvalAttempt = true
            elif nodeEvalLhsPointee == coreir.LocalInvalidTag &&
                 (nodeEvalLhsKind == coreir.LocalI32Tag ||
                  nodeEvalLhsKind == coreir.LocalI64Tag ||
                  nodeEvalLhsKind == coreir.LocalF64Tag ||
                  nodeEvalLhsKind == coreir.LocalStrTag ||
                  nodeEvalLhsKind == coreir.LocalPtrTag):
                nodeEvalAttempt = true
            if nodeEvalAttempt:
                primaryBodyIrNodeEvalMissOp = ""
                # 批次6b：子树含调用时先过纯探针并预检存储形态——调用一旦
                # 发射不可落回文本路径。
                var nodeEvalReady = true
                if PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, stmt_rhsNodeIndex):
                    let nodeEvalProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       lowering,

                                                                       share(typedFn),
                                                                       irFunction,
                                                                       stmt_rhsNodeIndex)
                    if nodeEvalProbeKind < 0:
                        nodeEvalReady = false
                    elif nodeEvalLhsVarI32:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalI32Tag
                    elif nodeEvalLhsPointee == coreir.LocalI64Tag:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalI32Tag ||
                                        nodeEvalProbeKind == coreir.LocalI64Tag
                    elif nodeEvalLhsPointee == coreir.LocalF64Tag:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalF64Tag
                    elif nodeEvalLhsVarStr:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalStrTag
                    elif nodeEvalLhsKind == coreir.LocalStrTag:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalStrTag
                    elif nodeEvalLhsKind == coreir.LocalI32Tag:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalI32Tag
                    elif nodeEvalLhsKind == coreir.LocalI64Tag:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalI32Tag ||
                                        nodeEvalProbeKind == coreir.LocalI64Tag
                    elif nodeEvalLhsKind == coreir.LocalF64Tag:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalF64Tag
                    elif nodeEvalLhsKind == coreir.LocalPtrTag:
                        nodeEvalReady = nodeEvalProbeKind == coreir.LocalPtrTag
                    else:
                        nodeEvalReady = false
                let nodeEvalEmitMark = primaryBodyIrNodeEvalCallEmitCount
                var nodeEvalValueSlot: int32 = -1
                if nodeEvalReady:
                    nodeEvalValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering,

                                                              share(typedFn),
                                                              irFunction,
                                                              stmt_rhsNodeIndex,
                                                              callOrdinal)
                var nodeEvalStored = false
                if nodeEvalValueSlot >= 0:
                    if nodeEvalLhsVarI32:
                        if PrimaryBodyIrSlotType(bodyIR, nodeEvalValueSlot) == coreir.LocalI32Tag:
                            PrimaryBodyIrAppendVarI32Store(bodyIR, nodeEvalLhsSlot, nodeEvalValueSlot)
                            nodeEvalStored = true
                        else:
                            let _ = PrimaryBodyIrNodeEvalMissAt("store_shape_var_i32")
                    elif nodeEvalLhsPointee == coreir.LocalI64Tag:
                        var nodeEvalVarI64Slot = nodeEvalValueSlot
                        if PrimaryBodyIrSlotType(bodyIR, nodeEvalVarI64Slot) == coreir.LocalI32Tag:
                            nodeEvalVarI64Slot = PrimaryBodyIrNodeEvalWidenToI64(bodyIR,
                                                                                 slotNames,
                                                                                 nodeEvalVarI64Slot,
                                                                                 stmt_rhsNodeIndex,
                                                                                 2)
                        if nodeEvalVarI64Slot >= 0 &&
                           PrimaryBodyIrSlotType(bodyIR, nodeEvalVarI64Slot) == coreir.LocalI64Tag:
                            PrimaryBodyIrAppendVarI64Store(bodyIR, nodeEvalLhsSlot, nodeEvalVarI64Slot)
                            nodeEvalStored = true
                        else:
                            let _ = PrimaryBodyIrNodeEvalMissAt("store_shape_var_i64")
                    elif nodeEvalLhsPointee == coreir.LocalF64Tag:
                        if PrimaryBodyIrSlotType(bodyIR, nodeEvalValueSlot) == coreir.LocalF64Tag:
                            PrimaryBodyIrAppendVarI64Store(bodyIR, nodeEvalLhsSlot, nodeEvalValueSlot)
                            nodeEvalStored = true
                        else:
                            let _ = PrimaryBodyIrNodeEvalMissAt("store_shape_var_f64")
                    elif nodeEvalLhsVarStr:
                        if PrimaryBodyIrSlotType(bodyIR, nodeEvalValueSlot) == coreir.LocalStrTag:
                            var nodeEvalVarStrSlot = nodeEvalValueSlot
                            if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[nodeEvalValueSlot]):
                                nodeEvalVarStrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                   slotNames,
                                                                                   Fmt"#nevs{nodeEvalLhsSlot}#{bodyIR.ops.len}",
                                                                                   coreir.LocalStrTag)
                                if nodeEvalVarStrSlot >= 0:
                                    var nodeEvalVarStrMatOp: coreir.BodyOp
                                    nodeEvalVarStrMatOp.kind = coreir.BodyOpFieldLoadTag
                                    nodeEvalVarStrMatOp.target = nodeEvalVarStrSlot
                                    add(nodeEvalVarStrMatOp.operands, nodeEvalValueSlot)
                                    add(nodeEvalVarStrMatOp.operands, nodeEvalVarStrSlot)
                                    add(nodeEvalVarStrMatOp.operands, 0)
                                    add(nodeEvalVarStrMatOp.operands, 24)
                                    let _ = coreir.BodyIRAppendOp(bodyIR, nodeEvalVarStrMatOp)
                            if nodeEvalVarStrSlot >= 0:
                                PrimaryBodyIrAppendVarAggregateStore(bodyIR, nodeEvalLhsSlot, nodeEvalVarStrSlot, 24)
                                nodeEvalStored = true
                        if !nodeEvalStored:
                            let _ = PrimaryBodyIrNodeEvalMissAt("store_shape_var_str")
                    else:
                        nodeEvalStored = PrimaryBodyIrNodeEvalStore(bodyIR,
                                                                    slotNames,
                                                                    nodeEvalLhsSlot,
                                                                    nodeEvalValueSlot)
                if nodeEvalStored:
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit function={typedFnName} line={stmt_lineNumber}")
                    return true
                if primaryBodyIrNodeEvalCallEmitCount != nodeEvalEmitMark:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt_lineNumber,
                                                 int32(stmt_kind),
                                                 6101,
                                                 0)
                    return true
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    var nodeEvalMissOpText = primaryBodyIrNodeEvalMissOp
                    if nodeEvalMissOpText == "":
                        nodeEvalMissOpText = "store_shape"
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={nodeEvalMissOpText} function={typedFnName} line={stmt_lineNumber}")
    if stmt_assignFieldName != "":
        # #76c: `obj.field = new(T)` (shape06) 字段赋值 RHS——AppendSimpleFieldAssignFast
        # 自身对 ptr 类型 RHS 无字面量 "new(...)" 物化臂(诚实 bail=712), 但它的裸标识符
        # 兜底(FindArgSlot)本就支持"字段=已存在的同类型局部变量"。先把 "new(T)" hoist
        # 成一个已分配好的 ptr 局部, 用它的名字替换 rhsText 送进去, 其余逻辑一行不改。
        # hoist 必须在 fieldAssignEmitMark 取样之前做, 否则 hoist 自身的 malloc 调用会
        # 让下面 "调用已发射禁止回退" 的安全网误判。
        var fieldAssignRhsText = strings.CloneStr(rhsText)
        let fieldAssignHoistName = PrimaryBodyIrHoistNewCallToPtrSlotName(bodyIR,
                                                                          slotNames,
                                                                          lowering.typedIr,
                                                                          stmt_sourcePath,
                                                                          stmt_lineNumber,
                                                                          rhsText,
                                                                          callOrdinal)
        if fieldAssignHoistName != "":
            fieldAssignRhsText = fieldAssignHoistName
        let fieldAssignEmitMark = primaryBodyIrNodeEvalCallEmitCount
        if PrimaryBodyIrAppendSimpleFieldAssignFast(bodyIR,
                                                    slotNames,
                                                    varI32ParamNames,
                                                    lowering,

                                                    typedFn,
                                                    irFunction,
                                                    stmt,
                                                    fieldAssignRhsText,
                                                    callOrdinal,
                                                    currentBlockStart):
            return true
        if primaryBodyIrNodeEvalCallEmitCount != fieldAssignEmitMark:
            # 求值已发射调用后失败：禁止落回文本路径（调用会二次发射）；
            # 显式无效操作暴露（节点探针应已拦截，此处为最后防线）。
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt_lineNumber,
                                         int32(stmt_kind),
                                         6101,
                                         0)
            return true
        # wall7 poison: `root.field[idx] = rhs`（assignFieldName 以 `]` 收尾的
        # 下标字段形态）之下 lhsName 已在上面折叠成裸 root 名（字段/下标语境
        # 丢失），继续落到下面裸名标量赋值机器只会认领错误形态或彻底不认领——
        # 语句静默蒸发（wall7 实锤：fixedBytes32FromBytes 的 out.data[i]=v 整句
        # 消失，字段维持零初始化)。AppendSimpleFieldAssignFast 已覆盖该形态的
        # 全部已知元素宽/root 存放方式；此处仍失败只可能是未覆盖的值/元素形
        # 态，必须响亮失败而非静默改道。
        # 让路例外: root 段本身带下标(`root[k].field[idx]`)时, Fast 让路
        # (见上方 fieldIndexedRootProbe 守卫) 不是"未覆盖形态失败"——是主动
        # 让位给下游通用 assign-field 路径(它有专用嵌套下标 store 接管)。
        # 按基线行为, 这种形态本就是通用路径接住、结果正确, 不该被当成响亮
        # 失败的靶子, 否则会把"让路成功"误判成"无路可走"而误 poison。
        var poison6102RootIdxProbe = ""
        if stmt_assignRootName != "" &&
           len(stmt_assignFieldName) > 0 &&
           stmt_assignFieldName[len(stmt_assignFieldName) - 1] == ']' &&
           !PrimaryBodyIrAssignLhsRootIndexText(strings.CloneStr(stmt_bindingName), strings.CloneStr(stmt_assignRootName), poison6102RootIdxProbe):
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt_lineNumber,
                                         int32(stmt_kind),
                                         6102,
                                         0)
            return true
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_B function={typedFnName} line={stmt_lineNumber}")
    if lhsName == "_":
        if stmt_callTarget != "":
            let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                              slotNames,
                                              lowering,

                                              typedFn,
                                              irFunction,
                                              stmt,
                                              -1,
                                              varI32ParamNames,
                                              callOrdinal,
                                              currentBlockStart)
            return true
        if PrimaryBodyIrTextHasCallSurface(rhsText):
            if PrimaryBodyIrHasSameLineCallForRhs(irFunction.statements,
                                                  stmt_lineNumber,
                                                  rhsText):
                PrimaryBodyIrNodeEvalOnlyOwn()
                return true
            return false
        return true
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_C function={typedFnName} line={stmt_lineNumber}")
    let lhsPointerText = PrimaryBodyIrUInt8PtrDerefPointerText(lhsName)
    if lhsPointerText != "":
        var storeFailureDetail: int32
        if !PrimaryBodyIrAppendUInt8PtrDerefStore(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering.typedIr,
                                                  stmt_sourcePath,
                                                  lhsName,
                                                  rhsText,
                                                  storeFailureDetail,
                                                  callOrdinal):
            if storeFailureDetail == 713:
                # Contextual retry: values like root.field[i] need binding-type
                # context; the pointer call backscan dedups the prior ops.
                let ctxRetryValueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                                   slotNames,
                                                                                   varI32ParamNames,
                                                                                   lowering.typedIr,
                                                                                   share(typedFn),
                                                                                   irFunction,
                                                                                   stmt_sourcePath,
                                                                                   stmt_lineNumber,
                                                                                   rhsText,
                                                                                   coreir.LocalI32Tag)
                if ctxRetryValueSlot >= 0:
                    let ctxRetryPtrSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                                         slotNames,
                                                                         varI32ParamNames,
                                                                         lowering.typedIr,
                                                                         stmt_sourcePath,
                                                                         lhsPointerText,
                                                                         callOrdinal)
                    if ctxRetryPtrSlot >= 0:
                        var ctxRetryStoreOp: coreir.BodyOp
                        ctxRetryStoreOp.kind = coreir.BodyOpIndexedStoreTag
                        ctxRetryStoreOp.target = ctxRetryPtrSlot
                        add(ctxRetryStoreOp.operands, ctxRetryPtrSlot)
                        add(ctxRetryStoreOp.operands, ctxRetryValueSlot)
                        add(ctxRetryStoreOp.operands, coreir.BodyStoreLocalPtrDerefU8Tag)
                        let _ = coreir.BodyIRAppendOp(bodyIR, ctxRetryStoreOp)
                        return true
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt_lineNumber,
                                         int32(stmt_kind),
                                         storeFailureDetail,
                                         0)
        return true
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_D function={typedFnName} line={stmt_lineNumber}")
    if len(lhsName) > 1 && lhsName[0] == '*':
        # General pointer-deref store: *ptrExpr = value (width by value slot).
        var derefInner = strutil.Strip(strings.SliceBytes(lhsName, 1, len(lhsName) - 1))
        derefInner = PrimaryBodyIrStripOuterParens(derefInner)
        var derefPtrSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering.typedIr,
                                                          stmt_sourcePath,
                                                          derefInner,
                                                          callOrdinal)
        var derefCtxPointeeSize: int32
        if derefPtrSlot < 0 && PrimaryBodyIrTextHasCallSurface(derefInner):
            let panicMsg = Fmt"primary: pointer-deref lvalue call lacks parser-owned TypedExpr node function={typedFnName} line={stmt_lineNumber}"
            panic(panicMsg)
        if derefPtrSlot < 0:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt_lineNumber,
                                         int32(stmt_kind),
                                         715,
                                         0)
            return true
        if derefCtxPointeeSize == 1:
            # 1 字节 pointee (uint8*): 值按 I32 上下文求值, U8-tag 存储 (镜像
            # 713 ctx-retry 的存储形)。宽存会踩相邻字节, 必须走 tag 臂。
            var derefCtxU8ValueSlot: int32 = -1
            # RHS 也是 `*(userCall())` 1 字节 deref-load (ArenaClone 逐字节
            # 拷贝循环): 同款 ctx 指针物化 + U8-tag load 进 I32 槽。
            if len(rhsText) > 1 && rhsText[0] == '*':
                var derefCtxRhsInner = strutil.Strip(strings.SliceBytes(rhsText, 1, len(rhsText) - 1))
                derefCtxRhsInner = PrimaryBodyIrStripOuterParens(derefCtxRhsInner)
                if PrimaryBodyIrTextHasCallSurface(derefCtxRhsInner):
                    let panicMsg = Fmt"primary: pointer-deref RHS call lacks parser-owned TypedExpr node function={typedFnName} line={stmt_lineNumber}"
                    panic(panicMsg)
            if derefCtxU8ValueSlot < 0:
                derefCtxU8ValueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                                 slotNames,
                                                                                 varI32ParamNames,
                                                                                 lowering.typedIr,
