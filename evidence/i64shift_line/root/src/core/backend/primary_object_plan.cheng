var primaryBodyIrNodeBoolChainMutationJournal: PrimaryBodyIrNodeBoolChainMutationJournal

@borrows
fn PrimaryObjectErrorCopy(dst: var PrimaryObjectError,
                          src: PrimaryObjectError) =
    dst.functionName = strings.CloneStr(src.functionName)
    dst.functionSourcePath = strings.CloneStr(src.functionSourcePath)
    dst.bodyKind = strings.CloneStr(src.bodyKind)
    dst.typedIrKind = strings.CloneStr(src.typedIrKind)
    dst.lineNumber = src.lineNumber
    dst.wordOffset = src.wordOffset
    dst.wordRelOffset = src.wordRelOffset
    dst.wordCount = src.wordCount
    dst.callTargetOrdinal = src.callTargetOrdinal
    dst.callTarget = strings.CloneStr(src.callTarget)
    dst.callTargetSourcePath = strings.CloneStr(src.callTargetSourcePath)
    dst.statementTrace = strings.CloneStr(src.statementTrace)
    dst.paramTrace = strings.CloneStr(src.paramTrace)
    dst.bodyIrDetail.opCount = src.bodyIrDetail.opCount
    dst.bodyIrDetail.termCount = src.bodyIrDetail.termCount
    dst.bodyIrDetail.blockCount = src.bodyIrDetail.blockCount
    dst.bodyIrDetail.callCount = src.bodyIrDetail.callCount
    dst.bodyIrDetail.slotCount = src.bodyIrDetail.slotCount
    dst.bodyIrDetail.frameBytes = src.bodyIrDetail.frameBytes
    dst.bodyIrDetail.prologueWordCount = src.bodyIrDetail.prologueWordCount
    dst.bodyIrDetail.paramSaveCount = src.bodyIrDetail.paramSaveCount
    dst.bodyIrDetail.paramSaveOffset = src.bodyIrDetail.paramSaveOffset
    dst.bodyIrDetail.returnBufferSaveOffset = src.bodyIrDetail.returnBufferSaveOffset
    dst.bodyIrDetail.returnBufferStoreWord = src.bodyIrDetail.returnBufferStoreWord
    dst.bodyIrDetail.lastTermKind = src.bodyIrDetail.lastTermKind
    dst.bodyIrDetail.lastTermResultSlot = src.bodyIrDetail.lastTermResultSlot
    dst.bodyIrDetail.lastTermOperand0 = src.bodyIrDetail.lastTermOperand0
    dst.bodyIrDetail.lastTermResultType = src.bodyIrDetail.lastTermResultType
    dst.bodyIrDetail.lastCallResultSlot = src.bodyIrDetail.lastCallResultSlot
    dst.bodyIrDetail.lastCallResultType = src.bodyIrDetail.lastCallResultType
    dst.bodyIrDetail.lastCallTarget = strings.CloneStr(src.bodyIrDetail.lastCallTarget)
    dst.bodyIrDetail.lastCallTargetSourcePath = strings.CloneStr(src.bodyIrDetail.lastCallTargetSourcePath)
    dst.bodyIrDetail.firstZeroOpIndex = src.bodyIrDetail.firstZeroOpIndex
    dst.bodyIrDetail.firstZeroOpKind = src.bodyIrDetail.firstZeroOpKind
    dst.bodyIrDetail.firstZeroOpTarget = src.bodyIrDetail.firstZeroOpTarget
    dst.bodyIrDetail.firstZeroTargetSlotName = strings.CloneStr(src.bodyIrDetail.firstZeroTargetSlotName)
    dst.bodyIrDetail.firstZeroTargetSlotType = src.bodyIrDetail.firstZeroTargetSlotType
    dst.bodyIrDetail.firstZeroTargetSlotSize = src.bodyIrDetail.firstZeroTargetSlotSize
    dst.bodyIrDetail.firstZeroTargetSlotOffset = src.bodyIrDetail.firstZeroTargetSlotOffset
    dst.bodyIrDetail.firstZeroOpOperand0 = src.bodyIrDetail.firstZeroOpOperand0
    dst.bodyIrDetail.firstZeroOpOperand1 = src.bodyIrDetail.firstZeroOpOperand1
    dst.bodyIrDetail.firstZeroOpOperand2 = src.bodyIrDetail.firstZeroOpOperand2
    dst.bodyIrDetail.firstZeroOpOperand3 = src.bodyIrDetail.firstZeroOpOperand3
    dst.bodyIrDetail.firstZeroBaseSlotName = strings.CloneStr(src.bodyIrDetail.firstZeroBaseSlotName)
    dst.bodyIrDetail.firstZeroBaseSlotType = src.bodyIrDetail.firstZeroBaseSlotType
    dst.bodyIrDetail.firstZeroBaseSlotSize = src.bodyIrDetail.firstZeroBaseSlotSize
    dst.bodyIrDetail.firstZeroBaseSlotOffset = src.bodyIrDetail.firstZeroBaseSlotOffset
    dst.bodyIrDetail.firstZeroValueSlotName = strings.CloneStr(src.bodyIrDetail.firstZeroValueSlotName)
    dst.bodyIrDetail.firstZeroValueSlotType = src.bodyIrDetail.firstZeroValueSlotType
    dst.bodyIrDetail.firstZeroValueSlotSize = src.bodyIrDetail.firstZeroValueSlotSize
    dst.bodyIrDetail.firstZeroValueSlotOffset = src.bodyIrDetail.firstZeroValueSlotOffset
    dst.bodyIrDetail.firstZeroSlotDiag = strings.CloneStr(src.bodyIrDetail.firstZeroSlotDiag)
    dst.bodyIrDetail.firstZeroTermIndex = src.bodyIrDetail.firstZeroTermIndex
    dst.bodyIrDetail.firstZeroTermKind = src.bodyIrDetail.firstZeroTermKind
    dst.bodyIrDetail.firstZeroBlockIndex = src.bodyIrDetail.firstZeroBlockIndex
    dst.bodyIrDetail.firstZeroWordInnerOffset = src.bodyIrDetail.firstZeroWordInnerOffset
    dst.bodyIrDetail.firstZeroCallTarget = strings.CloneStr(src.bodyIrDetail.firstZeroCallTarget)
    dst.bodyIrDetail.firstZeroCallDiag = strings.CloneStr(src.bodyIrDetail.firstZeroCallDiag)
    dst.rhsBailReason = src.rhsBailReason
    dst.callTargetResolutionKind = src.callTargetResolutionKind

fn PrimaryObjectPlanSetErrorFunctionIdentity(error: var PrimaryObjectError,
                                             lowering: var lower.LoweringPlanStub,
                                             functionIndex: int32) =
    if functionIndex < 0 || functionIndex >= lowering.functionNames.len:
        panic("primary_object_error_function_identity_index_invalid")
    error.functionName = lowering.functionNames[functionIndex]
    if functionIndex < lowering.functionSourcePaths.len:
        error.functionSourcePath = lowering.functionSourcePaths[functionIndex]

fn PrimaryObjectPlanDeclOrderStreamEnabled(linkPlan: var slplan.SystemLinkPlanStub): bool =
    if linkPlan.emitKind != creq.EmitObj &&
       linkPlan.emitKind != creq.EmitExe:
        panic("primary canonical production emitter requires obj or exe")
    if !regart.RegallocProductionTargetUsesCanonicalRegalloc(
           linkPlan.targetTriple):
        panic("primary canonical regalloc target unsupported")
    return true

fn PrimaryObjectPlanLowerJobs(): int32 =
    let raw = os.GetEnv("BACKEND_JOBS")
    if len(raw) <= 0:
        return 1
    let parsed = strutil.ParseInt(raw)
    if parsed < 1:
        return 1
    return parsed

fn PrimaryObjectPlanBodyIrReady(state: var PrimaryObjectPlanPhaseState,
                                 functionIndex: int32): bool =
    if functionIndex < 0 ||
       functionIndex >= state.bodyIrLowered.len ||
       functionIndex >= state.tempBodyIRs.len ||
       !state.bodyIrLowered[functionIndex]:
        return false
    return state.tempBodyIRs[functionIndex].blocks.len > 0 &&
           state.tempBodyIRs[functionIndex].terms.len > 0

@borrows
fn PrimaryObjectPlanRecordStreamedBackpatchFailure(state: var PrimaryObjectPlanPhaseState,
                                                     functionIndex: int32,
                                                     failureKind: str,
                                                     callOrdinal: int32,
                                                     dataOpIndex: int32,
                                                     dataSubIndex: int32) =
    if state.streamedFillFailedIndex >= 0:
        return
    state.streamedFillFailedIndex = functionIndex
    state.streamedBackpatchFailureKind = strings.CloneStr(failureKind)
    state.streamedBackpatchCallOrdinal = callOrdinal
    state.streamedBackpatchDataOpIndex = dataOpIndex
    state.streamedBackpatchDataSubIndex = dataSubIndex

# --- Single-pass back-patch: Darwin arm64 EmitObj declaration-order stream only. ---
# The arm64 size predictor is DELETED: there is no predicted layout to trust or to A/B against.
# These phases source branch targets and call relocations DIRECTLY from the REAL serial fill
# (recorded block starts / BL & data reloc positions). The block-start prefix-sum used for branch
# fallbacks is recomputed on demand from the *Raw size functions, the single source of truth.
# Active only while one Darwin arm64 object function is emitted (primaryBackpatchActive).
var primaryBackpatchActive: bool
var primaryBackpatchFunctionBase: int32   # absolute word base of the function currently being filled
var primaryBackpatchRealBlockStart: int32[]      # realBlockStart[bi] (absolute); -1 = not yet filled (forward)
# Forward-branch fixups: target block not yet filled when its branch is emitted.
var primaryBackpatchFixupWordPos: int32[]
var primaryBackpatchFixupTargetBlock: int32[]
var primaryBackpatchFixupIsCond: bool[]
var primaryBackpatchFixupCondCode: int32[]
# Step B (call-BL reloc emit-first): the call BL reloc word offset is sourced DIRECTLY from the
# real serial fill, keyed by the structural identity (realFunctionBase, callOrdinal) — NOT by a
# predicted absolute word position. BuildItems no longer predicts the call-BL offset for arm64
# (PrimaryBodyIrGeneralCfgRelocWordOffset is x64-only now); it appends a -1 placeholder and the
# call ordinal. FillCallOp records (functionBase, callOrdinal -> real BL pos) here at the moment it
# emits the BL placeholder; FillAndCheck looks the real pos up by (realFunctionBase, callOrdinal)
# and writes relocWordOffsets directly. Both key components are values both passes compute without
# any predictor, so no re-base / binary-search / RealFor is needed for call-BL relocs.
var primaryBackpatchCallRelocFnBase: int32[]
var primaryBackpatchCallRelocOrdinal: int32[]
var primaryBackpatchCallRelocRealPos: int32[]
# Step B-data (data reloc emit-first): the data reloc word offset (the anchoring ADRP position) is
# sourced DIRECTLY from the real serial fill, keyed by the STRUCTURAL identity (realFunctionBase,
# opIndex, subIndex) — NOT by a predicted absolute word position. BuildItems no longer predicts the
# data-reloc offset for the Darwin-arm64 emit-first path; it appends the structural key and a -1
# placeholder offset. The fill records (functionBase, oi, subIndex -> real ADRP pos) here at the
# moment it emits each ADRP (FillBlockOp for bare cstring / global load-store; FillCallOp for the
# call-cstring-args + sret-global). FillAndCheck looks the real pos up by (realFunctionBase, oi,
# subIndex) and writes dataRelocWordOffsets directly. All three key components are values both passes
# compute without any predictor, so no re-base / dataRelocPredictedKey / RealFor is used for these.
var primaryBackpatchDataRelocFnBase: int32[]
var primaryBackpatchDataRelocOpIndex: int32[]
var primaryBackpatchDataRelocSubIndex: int32[]
var primaryBackpatchDataRelocRealPos: int32[]
# Canonical data-reloc mutation hook. False in production; focused mutation gates flip it to
# prove the structural real-record consumer rejects a perturbed consumed offset.
var primaryDataRelocPerturb: bool
# Phase 2.5+ call-internal data reloc negative-test source escape hatches (call-cstring-arg /
# sret-global). All false in every steady/production build; flipped by hand for the manual A/B
# negative test then reverted before the clean gate run (os.GetEnv returns empty inside the
# selfhost compiler binary, so env gates cannot reach this code).
#   primaryCallDataRelocPerturb : +1 the COVERED call-cstring-arg / sret-global consumed offset
#                                 (dataRelocWordOffsets) while leaving the predicted key true.
var primaryCallDataRelocPerturb: bool
var primaryCallDataRelocCStringArgClassOnly: bool
var primaryCallDataRelocSretGlobalClassOnly: bool
fn PrimaryBackpatchResetForFunction(functionBase: int32, blockCount: int32) =
    primaryBackpatchFunctionBase = functionBase
    setLen(primaryBackpatchRealBlockStart, 0)
    for _ in 0..<blockCount:
        add(primaryBackpatchRealBlockStart, -1)
    setLen(primaryBackpatchFixupWordPos, 0)
    setLen(primaryBackpatchFixupTargetBlock, 0)
    setLen(primaryBackpatchFixupIsCond, 0)
    setLen(primaryBackpatchFixupCondCode, 0)

fn PrimaryBackpatchResetRelocRecords() =
    setLen(primaryBackpatchCallRelocFnBase, 0)
    setLen(primaryBackpatchCallRelocOrdinal, 0)
    setLen(primaryBackpatchCallRelocRealPos, 0)
    setLen(primaryBackpatchDataRelocFnBase, 0)
    setLen(primaryBackpatchDataRelocOpIndex, 0)
    setLen(primaryBackpatchDataRelocSubIndex, 0)
    setLen(primaryBackpatchDataRelocRealPos, 0)

# Step B (call-BL emit-first): record the real BL placeholder fill position keyed by the structural
# identity (current function base, callOrdinal). FillAndCheck looks this up by (realFunctionBase,
# callOrdinal) to write the call reloc word offset directly from the emit. No predictor / desync
# assert: the real position IS the offset, there is no predicted value to compare against.
fn PrimaryBackpatchRecordCallBlReloc(callOrdinal: int32, realBlPos: int32) =
    if !primaryBackpatchActive:
        return
    add(primaryBackpatchCallRelocFnBase, primaryBackpatchFunctionBase)
    add(primaryBackpatchCallRelocOrdinal, callOrdinal)
    add(primaryBackpatchCallRelocRealPos, realBlPos)

# Step B: resolve the real BL fill position for a call reloc keyed by (realFunctionBase, callOrdinal).
# Records are appended in serial-fill order: function index increasing => functionBase strictly
# increasing; within a function the BL ops fire in callOrdinal-increasing order. So the (fnBase,
# ordinal) pairs are lexicographically sorted, enabling a lexicographic binary search (O(log N)).
# Returns -1 when no record exists (never happens for a real call-BL reloc, which by construction
# emitted a BL placeholder and recorded its position).
fn PrimaryBackpatchCallBlRealFor(functionBase: int32, callOrdinal: int32): int32 =
    var lo = 0
    var hi = primaryBackpatchCallRelocFnBase.len - 1
    while lo <= hi:
        let mid = lo + (hi - lo) / 2
        let midBase = primaryBackpatchCallRelocFnBase[mid]
        let midOrd = primaryBackpatchCallRelocOrdinal[mid]
        var less = false
        var greater = false
        if midBase < functionBase:
            less = true
        elif midBase > functionBase:
            greater = true
        elif midOrd < callOrdinal:
            less = true
        elif midOrd > callOrdinal:
            greater = true
        if less:
            lo = mid + 1
        elif greater:
            hi = mid - 1
        else:
            return primaryBackpatchCallRelocRealPos[mid]
    return -1

# Step B-data (data reloc emit-first): record the real ADRP fill position keyed by the structural
# identity (current function base, opIndex, subIndex). FillAndCheck looks this up by (realFunctionBase,
# opIndex, subIndex) to write the data reloc word offset directly from the emit. No predictor / no
# desync assert: the real position IS the offset, there is no predicted value to compare against.
fn PrimaryBackpatchRecordDataRelocEmitFirst(opIndex: int32, subIndex: int32, realAdrpPos: int32) =
    if !primaryBackpatchActive:
        return
    add(primaryBackpatchDataRelocFnBase, primaryBackpatchFunctionBase)
    add(primaryBackpatchDataRelocOpIndex, opIndex)
    add(primaryBackpatchDataRelocSubIndex, subIndex)
    add(primaryBackpatchDataRelocRealPos, realAdrpPos)

# Step B-data: resolve the real ADRP fill position for a data reloc keyed by (realFunctionBase,
# opIndex, subIndex). Records are appended in serial-fill order: function index increasing =>
# functionBase strictly increasing; within a function ops fire in opIndex-increasing order; within
# one call op the cstring-arg / sret-global ADRPs fire in subIndex-increasing order. So the
# (fnBase, opIndex, subIndex) triples are lexicographically sorted, enabling a lexicographic binary
# search (O(log N)). Returns -1 when no record exists (never happens for a real data reloc, which by
# construction emitted an ADRP and recorded its position).
fn PrimaryBackpatchDataRelocRealFor(functionBase: int32, opIndex: int32, subIndex: int32): int32 =
    var lo = 0
    var hi = primaryBackpatchDataRelocFnBase.len - 1
    while lo <= hi:
        let mid = lo + (hi - lo) / 2
        let midBase = primaryBackpatchDataRelocFnBase[mid]
        let midOp = primaryBackpatchDataRelocOpIndex[mid]
        let midSub = primaryBackpatchDataRelocSubIndex[mid]
        var less = false
        var greater = false
        if midBase < functionBase:
            less = true
        elif midBase > functionBase:
            greater = true
        elif midOp < opIndex:
            less = true
        elif midOp > opIndex:
            greater = true
        elif midSub < subIndex:
            less = true
        elif midSub > subIndex:
            greater = true
        if less:
            lo = mid + 1
        elif greater:
            hi = mid - 1
        else:
            return primaryBackpatchDataRelocRealPos[mid]
    return -1

# Step B-data (data reloc emit-first): the former predictor-keyed data-reloc record functions
# (PrimaryBackpatchRecordDataReloc / PrimaryBackpatchRecordCallInternalDataReloc) are gone. The fill
# now records each data reloc by its structural identity via PrimaryBackpatchRecordDataRelocEmitFirst
# (above), and FillAndCheck joins (realFunctionBase, opIndex, subIndex) — no predicted-absolute key.

@borrows
fn PrimaryTargetSymbolName(targetTriple: str,
                             raw: str): str =
    var symbolRaw = raw
    if symbolRaw == "std/system::assert":
        symbolRaw = "assert"
    elif symbolRaw == "std/system::Assert":
        symbolRaw = "Assert"
    if contract.CodegenUnitDecoratesLeadingUnderscore(targetTriple):
        if len(symbolRaw) >= 2 && symbolRaw[0] == 'L' && symbolRaw[1] == '_':
            return strings.CloneStr(symbolRaw)
        return Fmt"_{symbolRaw}"
    return strings.CloneStr(symbolRaw)

@borrows
fn PrimaryInlineAtomicFetchAddKind(targetSymbol: str): int32 =
    if targetSymbol == "__cheng_runtime_atomic_add_i32" ||
       targetSymbol == "___cheng_runtime_atomic_add_i32":
        return 1
    if targetSymbol == "cheng_atomic_fetch_add_i32" ||
       targetSymbol == "_cheng_atomic_fetch_add_i32":
        return 2
    return 0

@borrows
fn PrimaryCallOpInlineAtomicFetchAddKind(call: coreir.CallOp): int32 =
    let inlineKind = PrimaryInlineAtomicFetchAddKind(call.targetSymbol)
    if inlineKind <= 0:
        return 0
    if call.argSlots.len != 2:
        return 0
    if PrimaryCallOpStackArgBytes(call) != 0:
        return 0
    return inlineKind

fn PrimaryInlineAtomicFetchAddInstructionWordCount(inlineKind: int32): int32 =
    if inlineKind == 1:
        return 1
    if inlineKind == 2:
        return 4
    return 0

@borrows
fn PrimaryInlinePtrSlotKind(targetSymbol: str): int32 =
    if targetSymbol == "__cheng_runtime_ptr_slot_load_raw" ||
       targetSymbol == "___cheng_runtime_ptr_slot_load_raw":
        return 1
    if targetSymbol == "__cheng_runtime_ptr_slot_store_raw" ||
       targetSymbol == "___cheng_runtime_ptr_slot_store_raw":
        return 2
    return 0

@borrows
fn PrimaryCallOpInlinePtrSlotKind(call: coreir.CallOp): int32 =
    let inlineKind = PrimaryInlinePtrSlotKind(call.targetSymbol)
    if inlineKind == 1:
        if call.argSlots.len != 2:
            return 0
        if PrimaryCallOpStackArgBytes(call) != 0:
            return 0
        return inlineKind
    if inlineKind == 2:
        if call.argSlots.len != 3:
            return 0
        if PrimaryCallOpStackArgBytes(call) != 0:
            return 0
        return inlineKind
    return 0

fn PrimaryInlinePtrSlotInstructionWordCount(inlineKind: int32): int32 =
    if inlineKind == 1 || inlineKind == 2:
        return 4
    return 0

# Path C: hardware AES-128 single-block encrypt. Recognized at call sites (inside straight-line
# BodyIR hosts) of the @importc symbol cheng_crypto_aes_block_enc128(state: ptr, roundKeys: ptr).
# On arm64 the BL is replaced inline with ARMv8 AESE/AESMC (state pinned in V0). The compiler never
# calls it, so its own emission is byte-identical (fixed point preserved). Match all mangling prefixes.
@borrows
fn PrimaryInlineAesBlockKind(targetSymbol: str): int32 =
    if targetSymbol == "cheng_crypto_aes_block_enc128" ||
       targetSymbol == "_cheng_crypto_aes_block_enc128" ||
       targetSymbol == "__cheng_crypto_aes_block_enc128" ||
       targetSymbol == "___cheng_crypto_aes_block_enc128":
        return 1
    if targetSymbol == "cheng_crypto_aes4_block_enc128" ||
       targetSymbol == "_cheng_crypto_aes4_block_enc128" ||
       targetSymbol == "__cheng_crypto_aes4_block_enc128" ||
       targetSymbol == "___cheng_crypto_aes4_block_enc128":
        return 2
    return 0

@borrows
fn PrimaryCallOpInlineAesBlockKind(call: coreir.CallOp): int32 =
    let inlineKind = PrimaryInlineAesBlockKind(call.targetSymbol)
    if inlineKind <= 0:
        return 0
    # kind 1: (state, roundKeys) = 2 ptr args; kind 2: (s0, s1, s2, s3, roundKeys) = 5 ptr args.
    if inlineKind == 1 && call.argSlots.len != 2:
        return 0
    if inlineKind == 2 && call.argSlots.len != 5:
        return 0
    if PrimaryCallOpStackArgBytes(call) != 0:
        return 0
    return inlineKind

# EXACTLY 33 words (kind 1): 1 (ldr state) + 9*3 (rounds 1..9: ldr rk; aese; aesmc)
# + 2 (round 10: ldr rk; aese) + 2 (final: ldr rk; eor) + 1 (str state).
# EXACTLY 99 words (kind 2): 4 (ldr states) + 9*9 (interleaved rounds) + 5 (round 10)
# + 5 (final eor) + 4 (str states). fill + predictor MUST agree or the
# buffer_size_desync guard aborts.
fn PrimaryInlineAesBlockInstructionWordCount(inlineKind: int32): int32 =
    if inlineKind == 1:
        return 33
    if inlineKind == 2:
        return 99
    return 0

# Path C follow-on: hardware ARMv8 SHA-256 single-block compress. Recognized at call sites (inside
# straight-line BodyIR hosts) of the symbol cheng_crypto_sha256_compress_block(state: ptr, block: ptr,
# k256: ptr). On arm64 the BL is replaced inline with the SHA256H/SHA256H2/SHA256SU0/SHA256SU1 crypto
# extension kernel (mirrors the verified sha256_hw_v3.s sequence instruction-for-instruction). state =
# 8x uint32 hash words (native-endian, in/out); block = 64-byte raw big-endian message block; k256 =
# 64x uint32 round constants (native-endian). Match all mangling prefixes.
# Also recognizes cheng_sha256_compress_block, the same-shape seam in
# program_support_backend.cheng (the always-linked runtime provider feeding
# the mobile CID bridge cheng_sha256_hex_bridge/cheng_sha256_word_bridge):
# a distinct symbol name so the provider never has to import/collide with
# std/crypto/sha256.cheng's copy (see program_support_backend.cheng comment).
@borrows
fn PrimaryInlineSha256BlockKind(targetSymbol: str): int32 =
    if targetSymbol == "cheng_crypto_sha256_compress_block" ||
       targetSymbol == "_cheng_crypto_sha256_compress_block" ||
       targetSymbol == "__cheng_crypto_sha256_compress_block" ||
       targetSymbol == "___cheng_crypto_sha256_compress_block" ||
       targetSymbol == "cheng_sha256_compress_block" ||
       targetSymbol == "_cheng_sha256_compress_block" ||
       targetSymbol == "__cheng_sha256_compress_block" ||
       targetSymbol == "___cheng_sha256_compress_block":
        return 1
    if targetSymbol == "cheng_crypto_sha256x3_block_compress" ||
       targetSymbol == "_cheng_crypto_sha256x3_block_compress" ||
       targetSymbol == "__cheng_crypto_sha256x3_block_compress" ||
       targetSymbol == "___cheng_crypto_sha256x3_block_compress":
        return 3
    if targetSymbol == "cheng_crypto_sha256_serial64_compress" ||
       targetSymbol == "_cheng_crypto_sha256_serial64_compress" ||
       targetSymbol == "__cheng_crypto_sha256_serial64_compress" ||
       targetSymbol == "___cheng_crypto_sha256_serial64_compress":
        return 2
    return 0

@borrows
fn PrimaryCallOpInlineSha256BlockKind(call: coreir.CallOp): int32 =
    let inlineKind = PrimaryInlineSha256BlockKind(call.targetSymbol)
    if inlineKind <= 0:
        return 0
    # kind 1: (state, block, k256) = 3 ptr args; kind 3: (states, blocks, k256) = 3 ptr args.
    if call.argSlots.len != 3:
        return 0
    if PrimaryCallOpStackArgBytes(call) != 0:
        return 0
    return inlineKind

# EXACTLY 193 words (kind 1): mirrors sha256_hw_v3.s 1:1 (12 prologue + 4*5 initial rounds +
# 1 x9-init + 12*13 unrolled message-schedule rounds + 4 epilogue), excluding the trailing `ret`
# (the inline substitution needs no return branch).
# EXACTLY 324 words (kind 3): 3-stream interleaved form — 6 (ldr states) + 2 (IV save) +
# 24 (ldr+rev32 blocks) + 16 groups (K ldr + 3 lanes x {mov,add,hq,h2} + su0/su1 pairs
# through group 11) + 12 epilogue. fill + predictor MUST agree or the buffer_size_desync
# guard aborts.
fn PrimaryInlineSha256BlockInstructionWordCount(inlineKind: int32): int32 =
    if inlineKind == 1:
        return 193
    if inlineKind == 3:
        return 324
    if inlineKind == 2:
        return 7492
    return 0

# #68 root fix: the warm backend has no native f64->int32/int64 BodyOp, so a
# pure-cast int(floatExpr)/int64(floatExpr) synthesizes a CallOp to
# cheng_f64_to_i32/cheng_f64_to_i64 (see #62/#73 above). Those symbols have no
# Cheng-side definition and no linkable provider object in the driver-direct
# (selfhost, zero-C) exe path, so the `bl` is unresolved at link time. Recognized
# at the call site (mirrors PrimaryInlineSha256BlockKind): the arg is already in
# d0 (the #73 fmov), so the CallOp is replaced inline with a single FCVTZS —
# this gives the backend the missing native BodyOp instead of routing around the
# missing symbol.
@borrows
fn PrimaryInlineF64TruncKind(targetSymbol: str): int32 =
    if targetSymbol == "cheng_f64_to_i32":
        return 1
    if targetSymbol == "cheng_f64_to_i64":
        return 2
    return 0

@borrows
fn PrimaryCallOpInlineF64TruncKind(call: coreir.CallOp): int32 =
    let inlineKind = PrimaryInlineF64TruncKind(call.targetSymbol)
    if inlineKind <= 0:
        return 0
    if call.argSlots.len != 1:
        return 0
    if PrimaryCallOpStackArgBytes(call) != 0:
        return 0
    return inlineKind

# EXACTLY 1 word: FCVTZS Wd,Dn (kind 1, cheng_f64_to_i32) or Xd,Dn (kind 2,
# cheng_f64_to_i64). Matches the default `callWordCount = 1` a plain `bl`
# already predicts in PrimaryBodyIRCallWordCount, so no predictor wiring there.
fn PrimaryInlineF64TruncInstructionWordCount(inlineKind: int32): int32 =
    if inlineKind == 1 || inlineKind == 2:
        return 1
    return 0

# Current sibling of the #68 fix above (opposite direction): the warm backend has no
# native int32/int64->f64 BodyOp either. The generic template
# `fn float64(x: T): float64 = return 0.0` (src/std/system.cheng:544, the ONLY
# lowercase "float64" declaration in std/system.cheng -- unambiguous by tail
# name alone, unlike the capitalized Float64(int32/int64/float64) wrapper trio)
# never matches the whole-function-body pure-cast recognizer (LoweringApply
# PureCastReturnBodyKind requires a literal `return CAST(param)` shape; this
# template's body is a type-erased placeholder `return 0.0`), so every caller
# of it synthesizes a real CallOp -- which never gets a compiled body in the
# driver-direct closure and is unresolved at link time.
#
# Unlike #68 (a hardcoded-literal synthesized CallOp whose targetSymbol the
# inline recognizer can match directly), rewriting THIS call's targetSymbol is
# unsafe: (a) coreir.CallOp.targetSymbol must stay exactly the lowering plan's
# expected call-head text ("float64") for the birc resolution walk in
# PrimaryObjectPlanBuildItemsPhase to match it against irFunction.callTargets
# (mutating it desyncs that walk); (b) empirically, PrimaryBodyIrAppendCallOp
# runs TWICE per function -- once building the throwaway state.tempBodyIRs
# validation copy, once for the real fill-consumed BodyIR (confirmed via
# CHENG_PRIMARY_OBJECT_TRACE: the whole primary_body_ir_call_append trace block
# repeats identically) -- so a mutation applied to state.tempBodyIRs's instance
# is invisible to the fill pass's independently-reconstructed instance anyway.
# Recognition instead uses a dedicated CallOp field (inlineF64FromIntKind,
# core_types.cheng) set ONCE here at construction time (present identically on
# both passes since both call this same function) and read verbatim by both
# the birc-loop BL-reloc exclusion (PrimaryObjectPlanBuildItemsPhase) and the
# fill-time emitter below -- targetSymbol itself is never touched, so the
# resolution walk and (if reached) the real symbol table lookup are unaffected.
# The caller's actual argument is converted inline with SCVTF instead of
# routing through the never-compiled generic body. This call is Cheng-internal
# (targetIsImportc==false) -- its args/result travel the normal
# all-raw-bits-in-X convention, so the SCVTF result (a D register) is fmov'd
# back into X0 to match what the shared post-call PrimaryBodyIRStoreRegToSlot
# step (reads A64X0 unconditionally) already expects for every other call kind.
@borrows
fn PrimaryBodyIrCallOpInlineF64FromIntKindForConstruction(call: coreir.CallOp,
                                                            bodyIR: coreir.BodyIR,
                                                            callTargetRaw: str): int32 =
    if call.targetIsImportc:
        return 0
    if PrimaryCallTargetTailName(callTargetRaw) != "float64":
        return 0
    if call.argSlots.len != 1:
        return 0
    if PrimaryCallOpStackArgBytes(call) != 0:
        return 0
    let argSlot = call.argSlots[0]
    if argSlot < 0 || argSlot >= bodyIR.localSlots.len:
        return 0
    let argType = bodyIR.localSlots[argSlot].typeKind
    if argType == coreir.LocalI32Tag:
        return 1
    if argType == coreir.LocalI64Tag:
        return 2
    return 0

@borrows
fn PrimaryCallOpInlineF64FromIntKind(call: coreir.CallOp,
                                      bodyIR: coreir.BodyIR): int32 =
    if call.inlineF64FromIntKind != 1 && call.inlineF64FromIntKind != 2:
        return 0
    return call.inlineF64FromIntKind

# #95 wave5 fix1: provenance gate. inlineF64FromIntKind alone is ambiguous --
# the pre-existing, unrelated PrimaryBodyIrAppendCallOp call constructor
# ALSO sets it (for any call whose target tail literally is "float64") via
# the exact same PrimaryBodyIrCallOpInlineF64FromIntKindForConstruction
# helper above, regardless of whether the call actually originates from the
# whole-call-expr rescue branch below. wave4 (REFUTED) exempted symbol
# registration for ANY call with inlineF64FromIntKind>0 at 3 sites
# (reachability phase + 2 build-items sub-loops) -- that silently exempted
# the UNRELATED AppendCallOp-constructed CallOp too (e.g.
# `let f: float64 = float64(getN())`, whose nested-call argument gets
# materialized into a real I32 temp slot first, then the outer "float64"
# call happens to satisfy the same arg-type/target-tail heuristic), whose
# fill-time re-derivation never actually takes the inline path -- leaving an
# unresolved `bl` self-jump (reloc to an empty symbol) that silently reads
# garbage from an unwritten d0. This dedicated field is set ONLY by the
# rescue branch's own CallOp construction (gen1 here and the gen2
# backend2_lower_slots.cheng mirror) -- the 3 exemption sites gate on THIS
# field, never on the ambiguous inlineF64FromIntKind alone.
@borrows
fn PrimaryCallOpWholeCallF64FromIntRescue(call: coreir.CallOp): bool =
    return call.wholeCallF64FromIntRescue

# #95 wave5 fix2: LocalSlot.typeKind (LocalI32Tag/LocalI64Tag) never carries
# signed/unsigned -- int32 and uint32 share LocalI32Tag. SCVTF (signed
# convert) on a uint32/uint64 value whose high bit is set silently produces
# a negative float64. Looks the arg's *declared* type text up
# (PrimaryBodyIrBindingTypeForName, canonical lowercase keyword per
# docs/cheng-formal-spec.md) to recover true signedness at CallOp
# construction time, while it is still available. Returns 0 (unknown -- not
# a scalar int keyword this rescue recognizes, or the lookup failed) / 1
# (signed) / 2 (unsigned); the rescue branch must poison rather than default
# to signed on an unknown result.
@borrows
fn PrimaryIntTypeTextSignedness(typeTextRaw: str): int32 =
    let t = texpr.TypedExprNormalizeTypeText(typeTextRaw)
    if t == "int8" || t == "int16" || t == "int32" || t == "int64" || t == "int":
        return 1
    if t == "uint8" || t == "uint16" || t == "uint32" || t == "uint64" || t == "uint":
        return 2
    return 0

# 2 words: SCVTF Dtmp,Wn (kind 1, int32 source) or Dtmp,Xn (kind 2, int64
# source), then FMOV X0,Dtmp to hand the raw bits back in X0 -- one more word
# than the default `callWordCount = 1` a plain `bl` predicts, so (unlike
# PrimaryInlineF64TruncInstructionWordCount) this DOES need PrimaryBodyIRCall
# WordCount wired below to stay in sync with the real fill.
fn PrimaryInlineF64FromIntInstructionWordCount(inlineKind: int32): int32 =
    if inlineKind == 1 || inlineKind == 2:
        return 2
    return 0


@borrows
fn PrimarySanitizeSymbolPart(text: str): str =
    var out = ""
    for i in 0..<len(text):
        let ch = text[i]
        var digit: bool
        if int32(ch) >= '0':
            if int32(ch) <= '9':
                digit = true
        var upper: bool
        if int32(ch) >= 'A':
            if int32(ch) <= 'Z':
                upper = true
        var lower: bool
        if int32(ch) >= 'a':
            if int32(ch) <= 'z':
                lower = true
        if digit:
            out = Fmt"{out}{strings.SliceBytes(text, i, 1)}"
        elif upper:
            out = Fmt"{out}{strings.SliceBytes(text, i, 1)}"
        elif lower:
            out = Fmt"{out}{strings.SliceBytes(text, i, 1)}"
        elif ch == '_':
            out = Fmt"{out}{strings.SliceBytes(text, i, 1)}"
        elif (int32(ch) & 255) >= 128:
            # Object string tables are byte payloads. Preserve UTF-8 bytes
            # while normalizing only ASCII punctuation in internal names.
            out = Fmt"{out}{strings.SliceBytes(text, i, 1)}"
        else:
            out = Fmt"{out}_"
    return out


fn primaryObjectSymbolIdentityAppendU32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

@borrows
fn primaryObjectSymbolIdentityAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    primaryObjectSymbolIdentityAppendU32(buf, value.len)
    for byteIndex in 0..<value.len:
        layout.ByteBufAppendByte(buf, int32(value[byteIndex]) & 255)

@borrows
fn PrimaryObjectPlanSymbolIdentityReceiptCid(
        plan: PrimaryObjectPlan): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    primaryObjectSymbolIdentityAppendText(
        buf, "cheng.compiler.primary_symbol_identity.v1")
    primaryObjectSymbolIdentityAppendText(buf, plan.targetTriple)
    layout.ByteBufAppendFixed32(
        buf, plan.symbolNameInternPoolDomainCid)
    layout.ByteBufAppendFixed32(
        buf, plan.symbolLoweringIdentityReceiptCid)
    primaryObjectSymbolIdentityAppendU32(buf, plan.symbolNames.len)
    for symbolIndex in 0..<plan.symbolNames.len:
        primaryObjectSymbolIdentityAppendU32(
            buf, plan.itemIds[symbolIndex])
        primaryObjectSymbolIdentityAppendU32(
            buf, plan.symbolTypedFunctionIndexes[symbolIndex])
        primaryObjectSymbolIdentityAppendU32(
            buf, plan.symbolNameIds[symbolIndex])
        primaryObjectSymbolIdentityAppendU32(
            buf, plan.symbolRoles[symbolIndex])
        layout.ByteBufAppendFixed32(
            buf, plan.symbolInterfaceCids[symbolIndex])
        primaryObjectSymbolIdentityAppendText(
            buf, plan.symbolNames[symbolIndex])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn PrimaryObjectPlanSymbolIdentityStrictValidateInto(
        plan: PrimaryObjectPlan,
        err: var str): bool =
    err = ""
    if plan.actualBackendKind != "primary":
        return true
    let rowCount = plan.symbolNames.len
    if rowCount <= 0:
        err = "primary object: symbol identity rows empty"
        return false
    if plan.itemIds.len != rowCount ||
       plan.symbolTypedFunctionIndexes.len != rowCount ||
       plan.symbolNameIds.len != rowCount ||
       plan.symbolRoles.len != rowCount ||
       plan.symbolInterfaceCids.len != rowCount:
        err = Fmt"primary object: symbol identity column mismatch names={rowCount} items={plan.itemIds.len} tfi={plan.symbolTypedFunctionIndexes.len} nameIds={plan.symbolNameIds.len} roles={plan.symbolRoles.len} cids={plan.symbolInterfaceCids.len}"
        return false
    if layout.FixedBytes32Equal(
           plan.symbolNameInternPoolDomainCid,
           layout.FixedBytes32()):
        err = "primary object: symbol identity intern domain cid zero"
        return false
    if layout.FixedBytes32Equal(
           plan.symbolLoweringIdentityReceiptCid,
           layout.FixedBytes32()):
        err = "primary object: symbol identity lowering receipt cid zero"
        return false
    if layout.FixedBytes32Equal(
           plan.symbolIdentityReceiptCid,
           layout.FixedBytes32()):
        err = "primary object: symbol identity receipt cid zero"
        return false
    for symbolIndex in 0..<rowCount:
        let role = plan.symbolRoles[symbolIndex]
        let typedFunctionIndex =
            plan.symbolTypedFunctionIndexes[symbolIndex]
        let nameId = plan.symbolNameIds[symbolIndex]
        let interfaceCid = plan.symbolInterfaceCids[symbolIndex]
        if len(plan.symbolNames[symbolIndex]) <= 0:
            err = "primary object: materialized symbol name empty"
            return false
        if role == PrimaryObjectSymbolRoleSyntheticEntryBridge:
            if typedFunctionIndex != -1 || nameId != -1 ||
               !layout.FixedBytes32Equal(
                   interfaceCid, layout.FixedBytes32()) ||
               symbolIndex >= plan.functionBodyKinds.len ||
               plan.functionBodyKinds[symbolIndex] !=
                   texpr.BodyKindEntryBridge:
                err = "primary object: synthetic symbol carries intern identity"
                return false
            continue
        elif role == PrimaryObjectSymbolRoleTypedName ||
             role == PrimaryObjectSymbolRoleExplicitExport ||
             role == PrimaryObjectSymbolRoleSourceEntry:
            if typedFunctionIndex < 0 || nameId < 0 ||
               layout.FixedBytes32Equal(
                   interfaceCid, layout.FixedBytes32()):
                err = "primary object: typed symbol identity missing"
                return false
        else:
            err = "primary object: symbol role invalid"
            return false
    if !layout.FixedBytes32Equal(
           plan.symbolIdentityReceiptCid,
           PrimaryObjectPlanSymbolIdentityReceiptCid(plan)):
        err = "primary object: symbol identity receipt mismatch"
        return false
    return true

fn PrimaryObjectPlanSealSymbolIdentityFromLowering(
        state: var PrimaryObjectPlanPhaseState,
        lowering: var lower.LoweringPlanStub,
        plan: var PrimaryObjectPlan) =
    let rowCount = state.symbolNames.len
    if !lower.LoweringFunctionNameIdentityStrictValid(lowering):
        panic("primary object: symbol identity source shape invalid: lowering identity")
    if rowCount <= 0:
        panic("primary object: symbol identity source shape invalid: empty symbol rows")
    if state.itemIds.len != rowCount ||
       state.symbolTypedFunctionIndexes.len != rowCount ||
       state.symbolNameIds.len != rowCount ||
       state.symbolRoles.len != rowCount ||
       state.symbolInterfaceCids.len != rowCount:
        panic("primary object: symbol identity source shape invalid: column length")
    if !layout.FixedBytes32Equal(
           state.symbolNameInternPoolDomainCid,
           lowering.functionNameInternPoolDomainCid):
        panic("primary object: symbol identity source shape invalid: intern domain")
    if !layout.FixedBytes32Equal(
           state.symbolLoweringIdentityReceiptCid,
           lowering.functionNameIdentityReceiptCid):
        panic("primary object: symbol identity source shape invalid: identity receipt")
    for symbolIndex in 0..<rowCount:
        let role = state.symbolRoles[symbolIndex]
        let typedFunctionIndex =
            state.symbolTypedFunctionIndexes[symbolIndex]
        let nameId = state.symbolNameIds[symbolIndex]
        if role == PrimaryObjectSymbolRoleSyntheticEntryBridge:
            if typedFunctionIndex != -1 || nameId != -1 ||
               !layout.FixedBytes32Equal(
                   state.symbolInterfaceCids[symbolIndex],
                   layout.FixedBytes32()):
                panic("primary object: synthetic symbol identity invalid")
            continue
        var expectedInterfaceCid: layout.FixedBytes32
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >=
               lowering.typedIr.functions2_functionNameIds.len ||
           nameId != lowering.typedIr.functions2_functionNameIds[
               typedFunctionIndex] ||
           !lower.LoweringPlanFunctionInterfaceCidAt(
               lowering, typedFunctionIndex,
               expectedInterfaceCid) ||
           !layout.FixedBytes32Equal(
               state.symbolInterfaceCids[symbolIndex],
               expectedInterfaceCid):
            panic("primary object: emitted exact intern identity drift")
        var explicitExportSourceEntry = false
        if typedFunctionIndex == lowering.sourceEntryTypedFunctionIndex &&
           typedFunctionIndex >= 0 &&
           typedFunctionIndex <
               state.allSymbolFunctionRowsByTypedFunctionIndex.len:
            let loweringFunctionRow =
                state.allSymbolFunctionRowsByTypedFunctionIndex[
                    typedFunctionIndex]
            explicitExportSourceEntry =
                loweringFunctionRow >= 0 &&
                loweringFunctionRow <
                    lowering.functionExportedFlags.len &&
                loweringFunctionRow <
                    lowering.functionExportNameExplicitFlags.len &&
                lowering.functionExportedFlags[loweringFunctionRow] != 0 &&
                lowering.functionExportNameExplicitFlags[
                    loweringFunctionRow] != 0 &&
                role == PrimaryObjectSymbolRoleExplicitExport
        if (role == PrimaryObjectSymbolRoleSourceEntry &&
            typedFunctionIndex !=
                lowering.sourceEntryTypedFunctionIndex) ||
           (typedFunctionIndex ==
                lowering.sourceEntryTypedFunctionIndex &&
            role != PrimaryObjectSymbolRoleSourceEntry &&
            !explicitExportSourceEntry):
            panic("primary object: structured source-entry role drift")
    plan.symbolTypedFunctionIndexes =
        state.symbolTypedFunctionIndexes
    plan.symbolNameIds = state.symbolNameIds
    plan.symbolRoles = state.symbolRoles
    plan.symbolInterfaceCids = state.symbolInterfaceCids
    plan.symbolNameInternPoolDomainCid =
        layout.FixedBytes32Copy(
            state.symbolNameInternPoolDomainCid)
    plan.symbolLoweringIdentityReceiptCid =
        layout.FixedBytes32Copy(
            state.symbolLoweringIdentityReceiptCid)
    for symbolIndex in 0..<rowCount:
        add(plan.itemIds, state.itemIds[symbolIndex])
        add(plan.symbolNames, strings.CloneStr(state.symbolNames[symbolIndex]))
    plan.symbolIdentityReceiptCid =
        PrimaryObjectPlanSymbolIdentityReceiptCid(plan)

fn primaryObjectPlanAppendInvalidCallRelocIdentity(
        state: var PrimaryObjectPlanPhaseState) =
    add(state.relocTargetDomainKinds,
        coreir.BodyCallTargetDomainInvalidTag)
    add(state.relocTargetRows, -1)
    add(state.relocTargetInterfaceCids, layout.FixedBytes32())

@borrows
fn PrimaryObjectPlanBindCallRelocIdentityFromRecipe(
        state: var PrimaryObjectPlanPhaseState,
        relocRow: int32,
        reloc: contract.RegallocA64ActionReloc): bool =
    let isCall = contract.CodegenUnitRelocKindIsCall(reloc.kind)
    if !isCall || relocRow < 0 ||
       relocRow >= state.relocTargetSymbols.len ||
       relocRow >= state.relocTargetDomainKinds.len ||
       relocRow >= state.relocTargetRows.len ||
       relocRow >= state.relocTargetInterfaceCids.len ||
       state.relocTargetDomainKinds[relocRow] !=
           coreir.BodyCallTargetDomainInvalidTag ||
       state.relocTargetRows[relocRow] != -1 ||
       !layout.FixedBytes32Equal(
           state.relocTargetInterfaceCids[relocRow],
           layout.FixedBytes32()) ||
       !coreir.BodyIRCallTargetIdentityValid(
           reloc.targetDomain, reloc.targetRow) ||
       !coreir.BodyIRTypeArenaArtifactCidValid(
           reloc.targetInterfaceCid):
        return false
    state.relocTargetDomainKinds[relocRow] = reloc.targetDomain
    state.relocTargetRows[relocRow] = reloc.targetRow
    state.relocTargetInterfaceCids[relocRow] =
        layout.FixedBytes32Copy(reloc.targetInterfaceCid)
    return true

@borrows
fn PrimaryObjectPlanCallRelocIdentityReceiptCid(
        plan: PrimaryObjectPlan): layout.FixedBytes32 =
    let rowCount = plan.relocTargetSymbols.len
    if plan.relocSourceItemIds.len != rowCount ||
       plan.relocWordOffsets.len != rowCount ||
       plan.relocTargetDomainKinds.len != rowCount ||
       plan.relocTargetRows.len != rowCount ||
       plan.relocTargetInterfaceCids.len != rowCount:
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(256)
    primaryObjectSymbolIdentityAppendText(
        buf, "cheng.compiler.primary_call_reloc_identity.v1")
    primaryObjectSymbolIdentityAppendText(buf, plan.targetTriple)
    primaryObjectSymbolIdentityAppendU32(buf, rowCount)
    for relocIndex in 0..<rowCount:
        primaryObjectSymbolIdentityAppendU32(
            buf, plan.relocSourceItemIds[relocIndex])
        primaryObjectSymbolIdentityAppendU32(
            buf, plan.relocWordOffsets[relocIndex])
        primaryObjectSymbolIdentityAppendText(
            buf, plan.relocTargetSymbols[relocIndex])
        primaryObjectSymbolIdentityAppendU32(
            buf, plan.relocTargetDomainKinds[relocIndex])
        primaryObjectSymbolIdentityAppendU32(
            buf, plan.relocTargetRows[relocIndex])
        layout.ByteBufAppendFixed32(
            buf, plan.relocTargetInterfaceCids[relocIndex])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn PrimaryObjectPlanCallRelocIdentityStrictValidateInto(
        plan: PrimaryObjectPlan,
        err: var str): bool =
    err = ""
    let rowCount = plan.relocTargetSymbols.len
    if plan.relocSourceItemIds.len != rowCount ||
       plan.relocWordOffsets.len != rowCount ||
       plan.relocTargetDomainKinds.len != rowCount ||
       plan.relocTargetRows.len != rowCount ||
       plan.relocTargetInterfaceCids.len != rowCount:
        err = "primary object: call reloc identity shape incomplete"
        return false
    for relocIndex in 0..<rowCount:
        let domain = plan.relocTargetDomainKinds[relocIndex]
        let row = plan.relocTargetRows[relocIndex]
        let cid = plan.relocTargetInterfaceCids[relocIndex]
        if len(plan.relocTargetSymbols[relocIndex]) <= 0:
            err = "primary object: call reloc target spelling empty"
            return false
        let exact =
            coreir.BodyIRCallTargetIdentityValid(domain, row) &&
            coreir.BodyIRTypeArenaArtifactCidValid(cid)
        if !exact:
            if domain == coreir.BodyCallTargetDomainInvalidTag &&
               row == -1 &&
               layout.FixedBytes32Equal(cid, layout.FixedBytes32()):
                err = "primary object: call reloc exact identity missing"
            else:
                err = "primary object: call reloc identity row invalid"
            return false
    if layout.FixedBytes32Equal(
           plan.relocCallTargetIdentityReceiptCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           plan.relocCallTargetIdentityReceiptCid,
           PrimaryObjectPlanCallRelocIdentityReceiptCid(plan)):
        err = "primary object: call reloc identity receipt mismatch"
        return false
    return true


@borrows
fn PrimaryRuntimeEntryBridgeSymbol(linkPlan: slplan.SystemLinkPlanStub): str =
    var raw = "cheng_program_argv_entry"
    if linkPlan.moduleKind == slplan.SystemCompilerControlPlane:
        raw = "cheng_tooling_argv_entry"
    return PrimaryTargetSymbolName(linkPlan.targetTriple, raw)


@borrows
fn PrimaryStartsWith(text: str,
                      prefix: str): bool =
    if len(prefix) > len(text):
        return false
    for i in 0..<len(prefix):
        if text[i] != prefix[i]:
            return false
    return true

@borrows
fn PrimaryBodyIrCanonicalAssignLhsName(lhsRaw: str): str =
    let lhs = strutil.Strip(lhsRaw)
    var prefixLen: int32
    if PrimaryStartsWith(lhs, "let "):
        prefixLen = 4
    elif PrimaryStartsWith(lhs, "var "):
        prefixLen = 4
    elif PrimaryStartsWith(lhs, "const "):
        prefixLen = 6
    if prefixLen <= 0:
        return lhs
    var cursor = prefixLen
    while cursor < len(lhs):
        let code = Int32(lhs[cursor])
        if code == 32 || code == 9:
            cursor = cursor + 1
            continue
        break
    let start = cursor
    while cursor < len(lhs):
        let code = Int32(lhs[cursor])
        var digit: bool
        if code >= int32('0'):
            if code <= int32('9'):
                digit = true
        var upper: bool
        if code >= int32('A'):
            if code <= int32('Z'):
                upper = true
        var lower: bool
        if code >= int32('a'):
            if code <= int32('z'):
                lower = true
        var underscore: bool
        if code == int32('_'):
            underscore = true
        var valid: bool
        if digit:
            valid = true
        elif upper:
            valid = true
        elif lower:
            valid = true
        elif underscore:
            valid = true
        if !valid:
            break
        cursor = cursor + 1
    if cursor <= start:
        return lhs
    let normalizedLhs = strings.SliceBytes(lhs, start, cursor - start)
    return normalizedLhs

@borrows
fn PrimaryPathTrimStart(text: str): int32 =
    var start: int32
    while start < len(text):
        let code = Int32(text[start])
        if code != 32 && code != 9 && code != 10 && code != 13:
            break
        start = start + 1
    return start


@borrows
fn PrimaryPathTrimStop(text: str,
                         start: int32): int32 =
    var stop = len(text)
    while stop > start:
        let code = Int32(text[stop - 1])
        if code != 32 && code != 9 && code != 10 && code != 13:
            break
        stop = stop - 1
    return stop


@borrows
fn PrimaryPathNormalizedStop(text: str,
                               start: int32,
                               stopRaw: int32): int32 =
    var stop = stopRaw
    while stop > start + 1:
        let last = text[stop - 1]
        if last != '/' && last != '\\':
            break
        stop = stop - 1
    return stop


@borrows
fn PrimaryPathNormalizedEquals(left: str,
                                 right: str): bool =
    let leftStart = PrimaryPathTrimStart(left)
    let rightStart = PrimaryPathTrimStart(right)
    let leftStop = PrimaryPathNormalizedStop(left, leftStart, PrimaryPathTrimStop(left, leftStart))
    let rightStop = PrimaryPathNormalizedStop(right, rightStart, PrimaryPathTrimStop(right, rightStart))
    let leftLen = leftStop - leftStart
    let rightLen = rightStop - rightStart
    if leftLen == rightLen:
        for i in 0..<leftLen:
            if left[leftStart + i] != right[rightStart + i]:
                return false
        return true
    # mixed absolute/relative forms of the same source: match the relative
    # side as a /-anchored suffix of the absolute side
    if leftLen <= 0 || rightLen <= 0:
        return false
    let leftAbs = left[leftStart] == '/'
    let rightAbs = right[rightStart] == '/'
    if leftAbs == rightAbs:
        return false
    var absText = left
    var absStart = leftStart
    var absLen = leftLen
    var relText = right
    var relStart = rightStart
    var relLen = rightLen
    if rightAbs:
        absText = right
        absStart = rightStart
        absLen = rightLen
        relText = left
        relStart = leftStart
        relLen = leftLen
    if absLen <= relLen:
        return false
    if absText[absStart + absLen - relLen - 1] != '/':
        return false
    for i in 0..<relLen:
        if absText[absStart + absLen - relLen + i] != relText[relStart + i]:
            return false
    return true


@borrows
fn PrimaryFunctionTailName(functionName: str): str =
    var tailStart = 0
    for i in 0..<len(functionName):
        if functionName[i] == '.':
            tailStart = i + 1
    if len(functionName) >= 2:
        for j in 0..<(len(functionName) - 1):
            if functionName[j] == ':' && functionName[j + 1] == ':':
                tailStart = j + 2
    if tailStart > 0 && tailStart < len(functionName):
        return strings.CloneStr(strings.SliceBytes(functionName, tailStart, len(functionName) - tailStart))
    return strings.CloneStr(functionName)


@borrows
fn PrimaryCallTargetTailName(targetText: str): str =
    var tailStart = 0
    for i in 0..<len(targetText):
        if targetText[i] == '.':
            tailStart = i + 1
    if len(targetText) >= 2:
        for j in 0..<(len(targetText) - 1):
            if targetText[j] == ':' && targetText[j + 1] == ':':
                tailStart = j + 2
    if tailStart > 0 && tailStart < len(targetText):
        return strings.CloneStr(strings.SliceBytes(targetText, tailStart, len(targetText) - tailStart))
    return strings.CloneStr(targetText)

@borrows
fn PrimaryBodyIrResetLookupCaches() =
    primaryBodyIrFunctionLookupSourcePaths = []
    primaryBodyIrFunctionSourceIndexes = []
    primaryBodyIrFunctionTailNames = []
    primaryBodyIrFunctionTailBucketHeads = []
    primaryBodyIrFunctionTailEntryTails = []
    primaryBodyIrFunctionTailEntryFnIndexes = []
    primaryBodyIrFunctionTailEntryNext = []
    primaryObjectIrFunctionIndexBucketHeads = []
    primaryObjectIrFunctionIndexEntryNames = []
    primaryObjectIrFunctionIndexEntryFunctionIndexes = []
    primaryObjectIrFunctionIndexEntryNext = []
    primaryPlanResolveSymbolTailBucketHeads = []
    primaryPlanResolveSymbolTailEntryTails = []
    primaryPlanResolveSymbolTailEntryFnIndexes = []
    primaryPlanResolveSymbolTailEntryNext = []
    primaryPlanResolveNameTailBucketHeads = []
    primaryPlanResolveNameTailEntryTails = []
    primaryPlanResolveNameTailEntryFnIndexes = []
    primaryPlanResolveNameTailEntryNext = []
    primaryPlanResolveBuiltCount = 0
    primaryObjectIrFunctionIndexBuiltCount = -1
    primaryObjectIrFunctionIndexFingerprint = 0
@borrows
fn PrimaryBodyIrFunctionLookupSourcePathIndex(sourcePath: str): int32 =
    if sourcePath == "":
        return -1
    for i in 0..<primaryBodyIrFunctionLookupSourcePaths.len:
        if PrimaryPathNormalizedEquals(primaryBodyIrFunctionLookupSourcePaths[i], sourcePath):
            return i
    return -1

@borrows
fn PrimaryBodyIrPrepareFunctionLookupCache(typedIr: texpr.TypedExprIr) =
    if primaryBodyIrFunctionTailNames.len == typedIr.functions2_functionNameIds.len &&
       primaryBodyIrFunctionSourceIndexes.len == typedIr.functions2_functionNameIds.len &&
       primaryBodyIrFunctionTailBucketHeads.len > 0:
        return
    primaryBodyIrFunctionTailNames = []
    primaryBodyIrFunctionLookupSourcePaths = []
    primaryBodyIrFunctionSourceIndexes = []
    primaryBodyIrFunctionTailEntryTails = []
    primaryBodyIrFunctionTailEntryFnIndexes = []
    primaryBodyIrFunctionTailEntryNext = []
    primaryBodyIrFunctionTailBucketHeads = []
    for bucketIndex in 0..<16384:
        add(primaryBodyIrFunctionTailBucketHeads, -1)
    for i in 0..<typedIr.functions2_functionNameIds.len:
        let fnNameRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.functions2_functionNameIds[i])
        let fnSrcRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.functions2_sourcePathIds[i])
        let fnName = Value(fnNameRes)
        let fnSrc = Value(fnSrcRes)
        let candidateTail = PrimaryCallTargetTailName(fnName)
        # The same immutable tail is indexed in both the flat function row and
        # the hash-chain entry.  Retain the first collection owner explicitly;
        # the final add below consumes the local owner.
        add(primaryBodyIrFunctionTailNames, share(candidateTail))
        var sourceIndex = PrimaryBodyIrFunctionLookupSourcePathIndex(fnSrc)
        if sourceIndex < 0:
            sourceIndex = primaryBodyIrFunctionLookupSourcePaths.len
            add(primaryBodyIrFunctionLookupSourcePaths, fnSrc)
        add(primaryBodyIrFunctionSourceIndexes, sourceIndex)
        # Index by tail name with head insertion (O(1)); the lookup tracks the
        # minimum matching function index so chain order is irrelevant.
        let tailBucket = PrimaryObjectIrFunctionIndexHash(candidateTail,
                                                          primaryBodyIrFunctionTailBucketHeads.len)
        if tailBucket >= 0:
            let entryIndex = primaryBodyIrFunctionTailEntryFnIndexes.len
            add(primaryBodyIrFunctionTailEntryTails, candidateTail)
            add(primaryBodyIrFunctionTailEntryFnIndexes, i)
            add(primaryBodyIrFunctionTailEntryNext, primaryBodyIrFunctionTailBucketHeads[tailBucket])
            primaryBodyIrFunctionTailBucketHeads[tailBucket] = entryIndex

@borrows
fn PrimaryObjectIrFunctionIndexHash(name: str, bucketCount: int32): int32 =
    if bucketCount <= 0:
        return -1
    var h: int32
    for i in 0..<len(name):
        h = h * 31 + int32(name[i])
    if h < 0:
        h = -h
    return h & (bucketCount - 1)

@borrows
fn PrimaryObjectIrFunctionIndexFingerprintText(seed: int32, text: str): int32 =
    var h = seed
    h = h * 31 + len(text)
    for i in 0..<len(text):
        h = h * 131 + int32(text[i])
    return h

@borrows
fn PrimaryObjectIrFunctionIndexFingerprint(ir: lower.PrimaryObjectIr): int32 =
    var h: int32
    h = 17
    h = h * 31 + ir.functions.len
    for i in 0..<ir.functions.len:
        h = PrimaryObjectIrFunctionIndexFingerprintText(h, ir.functions[i].sourcePath)
        h = PrimaryObjectIrFunctionIndexFingerprintText(h, ir.functions[i].functionName)
    if h == 0:
        h = 1
    return h

@borrows
fn PrimaryObjectIrFunctionIndexPrepare(ir: lower.PrimaryObjectIr) =
    # census perf 真根因(profiling 实测 ~40% CPU):此 Prepare 每次 lookup 都被调,原本每次
    # 重算 O(函数数×名长) 的 Fingerprint 来判缓存过期 → 整体 O(语句×函数) = O(n²) 主峰。
    # fingerprint 只哈希 sourcePath+functionName,这俩在 lowering 期 in-place mutation 下不变,
    # 故 length 未变即可断定哈希仍有效——先廉价 length 早返回,跳过昂贵 fingerprint。
    if primaryObjectIrFunctionIndexBuiltCount == ir.functions.len &&
       primaryObjectIrFunctionIndexBucketHeads.len > 0:
        return
    let fingerprint = PrimaryObjectIrFunctionIndexFingerprint(ir)
    if primaryObjectIrFunctionIndexBuiltCount == ir.functions.len &&
       primaryObjectIrFunctionIndexFingerprint == fingerprint &&
       primaryObjectIrFunctionIndexBucketHeads.len > 0:
        return
    primaryObjectIrFunctionIndexBucketHeads = []
    primaryObjectIrFunctionIndexEntryNames = []
    primaryObjectIrFunctionIndexEntryFunctionIndexes = []
    primaryObjectIrFunctionIndexEntryNext = []
    for bucketIndex in 0..<16384:
        add(primaryObjectIrFunctionIndexBucketHeads, -1)
    for i in 0..<ir.functions.len:
        let storedName = ir.functions[i].functionName
        let bucket = PrimaryObjectIrFunctionIndexHash(storedName,
                                                      primaryObjectIrFunctionIndexBucketHeads.len)
        if bucket < 0:
            continue
        let entryIndex = primaryObjectIrFunctionIndexEntryFunctionIndexes.len
        add(primaryObjectIrFunctionIndexEntryFunctionIndexes, i)
        add(primaryObjectIrFunctionIndexEntryNames, share(storedName))
        add(primaryObjectIrFunctionIndexEntryNext, primaryObjectIrFunctionIndexBucketHeads[bucket])
        primaryObjectIrFunctionIndexBucketHeads[bucket] = entryIndex
    primaryObjectIrFunctionIndexBuiltCount = ir.functions.len
    primaryObjectIrFunctionIndexFingerprint = fingerprint

@borrows
fn PrimaryObjectIrFunctionIndexBucketUnique(ir: lower.PrimaryObjectIr,
                                             sourcePath: str,
                                             matchName: str): int32 =
    let bucket = PrimaryObjectIrFunctionIndexHash(matchName,
                                                  primaryObjectIrFunctionIndexBucketHeads.len)
    if bucket < 0:
        return -1
    var result: int32 = -1
    var entryIndex = primaryObjectIrFunctionIndexBucketHeads[bucket]
    while entryIndex >= 0:
        if primaryObjectIrFunctionIndexEntryNames[entryIndex] == matchName:
            let candidate = primaryObjectIrFunctionIndexEntryFunctionIndexes[entryIndex]
            if candidate >= 0:
                if candidate < ir.functions.len:
                    if ir.functions[candidate].functionName == matchName:
                        if PrimaryPathNormalizedEquals(ir.functions[candidate].sourcePath, sourcePath):
                            if result >= 0 && result != candidate:
                                return -2
                            result = candidate
        entryIndex = primaryObjectIrFunctionIndexEntryNext[entryIndex]
    return result

@borrows
fn PrimaryObjectIrFunctionIndex(ir: lower.PrimaryObjectIr,
                                  sourcePath: str,
                                  functionName: str): int32 =
    if sourcePath == "" || functionName == "":
        return -1
    let tailName = PrimaryFunctionTailName(functionName)
    PrimaryObjectIrFunctionIndexPrepare(ir)
    if primaryObjectIrFunctionIndexBucketHeads.len > 0 &&
       primaryObjectIrFunctionIndexBuiltCount == ir.functions.len:
        let exact = PrimaryObjectIrFunctionIndexBucketUnique(ir, sourcePath, functionName)
        if exact >= 0:
            return exact
        if exact == -2:
            return -1
        if tailName == functionName:
            return -1
        let tail = PrimaryObjectIrFunctionIndexBucketUnique(ir, sourcePath, tailName)
        if tail >= 0:
            return tail
        return -1
    var exact: int32 = -1
    for i in 0..<ir.functions.len:
        if !PrimaryPathNormalizedEquals(ir.functions[i].sourcePath, sourcePath):
            continue
        if ir.functions[i].functionName == functionName:
            if exact >= 0:
                return -1
            exact = i
    if exact >= 0 || tailName == functionName:
        return exact
    var tail: int32 = -1
    for i in 0..<ir.functions.len:
        if !PrimaryPathNormalizedEquals(ir.functions[i].sourcePath, sourcePath):
            continue
        if ir.functions[i].functionName == tailName:
            if tail >= 0:
                return -1
            tail = i
    return tail

@borrows
fn PrimaryObjectIrFunctionIndexAtLine(ir: lower.PrimaryObjectIr,
                                       sourcePath: str,
                                       functionName: str,
                                       signatureLineNumber: int32): int32 =
    if signatureLineNumber <= 0:
        return -1
    if sourcePath == "" || functionName == "":
        return -1
    let tailName = PrimaryFunctionTailName(functionName)
    var exact: int32 = -1
    for i in 0..<ir.functions.len:
        if !PrimaryPathNormalizedEquals(ir.functions[i].sourcePath, sourcePath):
            continue
        if ir.functions[i].functionName != functionName:
            continue
        if ir.functions[i].signatureLineNumber == signatureLineNumber:
            if exact >= 0:
                return -1
            exact = i
    if exact >= 0:
        return exact
    # Form-B header continuation can disagree on the physical signature
    # line. A unique source+name row is the same function.
    let unique = PrimaryObjectIrFunctionIndexUnique(ir, sourcePath, functionName)
    if unique >= 0:
        return unique
    if tailName == functionName:
        return -1
    var tail: int32 = -1
    for i in 0..<ir.functions.len:
        if !PrimaryPathNormalizedEquals(ir.functions[i].sourcePath, sourcePath):
            continue
        if ir.functions[i].functionName != tailName:
            continue
        if ir.functions[i].signatureLineNumber == signatureLineNumber:
            if tail >= 0:
                return -1
            tail = i
    return tail

@borrows
fn PrimaryObjectIrFunctionIndexUnique(
        ir: lower.PrimaryObjectIr,
        sourcePath: str,
        functionName: str): int32 =
    if sourcePath == "" || functionName == "":
        return -1
    let tailName = PrimaryFunctionTailName(functionName)
    var exact: int32 = -1
    for i in 0..<ir.functions.len:
        if !PrimaryPathNormalizedEquals(ir.functions[i].sourcePath, sourcePath):
            continue
        if ir.functions[i].functionName != functionName &&
           ir.functions[i].functionName != tailName:
            continue
        if exact >= 0 && exact != i:
            return -1
        exact = i
    return exact

# P2 diagnostic overlay (round4 gapB dup-name/type-mismatch relabel): the typedIr-space
# name producer (PrimaryBodyIrTargetFunctionIndexWithKind) can only see "same name,
# same source" candidate counts — it has no access to the call site's argument types,
# so it cannot distinguish a genuinely ambiguous overload (2+ same-source candidates
# that ALSO match the call's argument types) from a name collision where every
# same-source candidate is ruled out by type (0 survive, e.g. two same-named functions
# with disjoint parameter types called with a third unrelated argument type). This
# walks the lowering-side (arg-type-aware) candidate list for the same (sourcePath,
# name) and narrows the label using the same match predicate
# PrimaryObjectPlanCallCandidateMatchesArgTypes/PrimaryObjectPlanUniqueCallCandidateIndex
# already use for the real call-target resolver (PrimaryObjectPlanResolveCallTargetIndex,
# gapB 4dda8e62c), so the diagnostic label agrees with why resolution actually failed
# instead of guessing from name-only candidate counts.
@borrows
fn PrimaryObjectPlanSameSourceNameCandidates(lowering: var lower.LoweringPlanStub,
                                               sourcePath: str,
                                               name: str): int32[] =
    var out: int32[]
    if sourcePath == "" || name == "":
        return out
    let nameTail = PrimaryCallTargetTailName(name)
    for i in 0..<lowering.functionNames.len:
        if i >= lowering.functionSourcePaths.len:
            continue
        if !PrimaryPathNormalizedEquals(lowering.functionSourcePaths[i], sourcePath):
            continue
        let candidateName = lowering.functionNames[i]
        if candidateName != name && PrimaryCallTargetTailName(candidateName) != nameTail:
            continue
        add(out, i)
    return out

@borrows
fn PrimaryObjectPlanMissingCallTargetTypeAliveCount(lowering: var lower.LoweringPlanStub,
                                                      candidateIndexes: int32[],
                                                      irIndex: int32,
                                                      callOrdinal: int32): int32 =
    let actualArgCount = PrimaryObjectPlanCallArgCountAt(lowering, irIndex, callOrdinal)
    let argTypeParts = PrimaryObjectPlanCallArgTypePartsAt(lowering, irIndex, callOrdinal)
    var callerSourcePath = ""
    if irIndex >= 0 && irIndex < lowering.primaryObjectIr.functions.len:
        callerSourcePath = strings.CloneStr(
            lowering.primaryObjectIr.functions[irIndex].sourcePath)
    var aliveCount: int32
    for k in 0..<candidateIndexes.len:
        if PrimaryObjectPlanCallCandidateMatchesArgTypes(lowering, candidateIndexes[k], actualArgCount, argTypeParts, callerSourcePath):
            aliveCount = aliveCount + 1
    return aliveCount

@borrows
fn PrimaryObjectPlanFillMissingCallTargetDiagnostic(error: var PrimaryObjectError,
                                                     lowering: var lower.LoweringPlanStub,
                                                     functionIndex: int32,
                                                     targetText: str) =
    if functionIndex >= 0 && functionIndex < lowering.functionSourcePaths.len:
        error.functionSourcePath = lowering.functionSourcePaths[functionIndex]
    # P2 atomic consumer: sealed 10-case CallTargetResolutionKind replaces
    # the (callTargetAnySourceIndex, callTargetAnySourceCount) 6-state旁路
    # double-int32 + the count-阈值 reverse guess下面. Producer
    # PrimaryBodyIrTargetFunctionIndexWithKind runs against the typedIr
    # candidate table; the kind out-param carries the explicit terminal state.
    let resolveSourcePath = error.callTargetSourcePath
    var resolutionKind: texpr.CallTargetResolutionKind
    resolutionKind = texpr.CallTargetUnresolved
    let resolvedIndex = PrimaryBodyIrTargetFunctionIndexWithKind(lowering.typedIr,
                                                                 resolveSourcePath,
                                                                 targetText,
                                                                 resolutionKind)
    if resolutionKind == texpr.CallTargetSameSourceAmbiguous:
        let sameSourceCandidates = PrimaryObjectPlanSameSourceNameCandidates(lowering,
                                                                             resolveSourcePath,
                                                                             targetText)
        if sameSourceCandidates.len >= 2:
            let aliveCount = PrimaryObjectPlanMissingCallTargetTypeAliveCount(lowering,
                                                                              sameSourceCandidates,
                                                                              functionIndex,
                                                                              error.callTargetOrdinal)
            if aliveCount == 0:
                # No same-source candidate's parameter types match the call site's
                # actual argument types — 0 alive is "no matching overload", not
                # "which one?" ambiguity. CallTargetMissing (existing sealed-enum
                # case) already carries that meaning; not inventing a new case.
                resolutionKind = texpr.CallTargetMissing
            elif aliveCount == 1:
                resolutionKind = texpr.CallTargetSameSourceUnique
    # P2 producer site #10 (DeadOverload): producer returned no index but the
    # lowering-side symbol table still has a hit. Surface table has the name
    # (typed_expr-side overload table pruned it as dead). Reconciles producer
    # vs lowering candidate divergence directly — no count阈值 reverse猜.
    if resolvedIndex < 0 && resolutionKind == texpr.CallTargetMissing:
        let exactSurfaceCandidates =
            PrimaryObjectPlanSameSourceNameCandidates(lowering,
                                                      resolveSourcePath,
                                                      targetText)
        if exactSurfaceCandidates.len > 0:
            resolutionKind = texpr.CallTargetDeadOverload
    error.callTargetResolutionKind = resolutionKind
    # P1 consumer (5th PObjP rhsBailReason read site): 在 error 填充阶段
    # 同步派生 rhsBailReason — 当 stmt 上下文已写过具体根因时保留, 否则
    # 派生自 P2 resolutionKind (多 case → 2 二元 RhsBailReason); 这是
    # dispatch_min 1808/4127 输出 rhsBailReason 之前的最后一道补全.
    if error.rhsBailReason == texpr.RhsBailNone:
        if resolutionKind == texpr.CallTargetMissing ||
           resolutionKind == texpr.CallTargetDeadOverload:
            error.rhsBailReason = texpr.RhsBailCallTargetMissing
        elif resolutionKind == texpr.CallTargetSameSourceAmbiguous ||
             resolutionKind == texpr.CallTargetQualifiedCrossSourceAmbiguous ||
             resolutionKind == texpr.CallTargetGlobalAmbiguous:
            error.rhsBailReason = texpr.RhsBailCallTargetAmbiguous
        elif resolutionKind == texpr.CallTargetTailLeafSplitFail:
            error.rhsBailReason = texpr.RhsBailTailLeafSplitFail
    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
        let reasonLabel = texpr.TypedExprIrRhsBailReasonLabel(error.rhsBailReason)
        let resolutionLabel = texpr.TypedExprIrCallTargetResolutionKindLabel(resolutionKind)
        os.WriteLine(os.GetStderr(), Fmt"phase=fill_missing_call_target_diag fn={error.functionName} target={targetText} resolution_kind={int32(resolutionKind)} resolution_label={resolutionLabel} reason_label={reasonLabel}")

@borrows
fn PrimaryObjectPlanDebugError(prefix: str,
                                error: PrimaryObjectError) =
    if PrimaryObjectPlanDebugEnabled():
        PrimaryObjectPlanDebugLine(Fmt"{prefix} function={error.functionName} source={error.functionSourcePath} body_kind={error.bodyKind} typed_ir_kind={error.typedIrKind} line={error.lineNumber} word_count={error.wordCount} call_ord={error.callTargetOrdinal} call_target={error.callTarget} call_source={error.callTargetSourcePath} resolution_kind={int32(error.callTargetResolutionKind)} resolution_label={texpr.TypedExprIrCallTargetResolutionKindLabel(error.callTargetResolutionKind)} body_ir_ops={error.bodyIrDetail.opCount} body_ir_terms={error.bodyIrDetail.termCount} body_ir_calls={error.bodyIrDetail.callCount} body_ir_slots={error.bodyIrDetail.slotCount} body_ir_frame={error.bodyIrDetail.frameBytes} first_zero_op={error.bodyIrDetail.firstZeroOpIndex} first_zero_op_kind={error.bodyIrDetail.firstZeroOpKind} first_zero_op_target={error.bodyIrDetail.firstZeroOpTarget} first_zero_op_operand0={error.bodyIrDetail.firstZeroOpOperand0} first_zero_op_operand1={error.bodyIrDetail.firstZeroOpOperand1} first_zero_op_operand2={error.bodyIrDetail.firstZeroOpOperand2} first_zero_op_operand3={error.bodyIrDetail.firstZeroOpOperand3} first_zero_call={error.bodyIrDetail.firstZeroCallTarget} first_zero_call_diag={error.bodyIrDetail.firstZeroCallDiag} first_zero_slot_diag={error.bodyIrDetail.firstZeroSlotDiag} first_zero_term={error.bodyIrDetail.firstZeroTermIndex} first_zero_term_kind={error.bodyIrDetail.firstZeroTermKind} last_call={error.bodyIrDetail.lastCallTarget}")

fn PrimaryBoolSeqInit(count: int32,
                       value: bool): bool[] =
    var out: bool[]
    for _ in 0..<count:
        add(out, value)
    return out

fn PrimaryIntSeqInit(count: int32,
                      value: int32): int32[] =
    var out: int32[]
    for _ in 0..<count:
        add(out, value)
    return out

# F17 slice1: per-index worker-local staging arrays for the hotPathReport-driven
# bodyIR* accumulators need int64/str seq inits mirroring PrimaryIntSeqInit/
# PrimaryBoolSeqInit above (phaseArena byte counters are int64; the eGraph
# skip-reason per-index latch is str).
fn PrimaryInt64SeqInit(count: int32,
                        value: int64): int64[] =
    var out: int64[]
    for _ in 0..<count:
        add(out, value)
    return out

fn PrimaryStrSeqInit(count: int32,
                      value: str): str[] =
    var out: str[]
    for _ in 0..<count:
        add(out, share(value))
    return out

@borrows
fn PrimaryIsLetCallNoargReturnI32ConstBodyKind(bodyKind: str): bool =
    return PrimaryStartsWith(bodyKind, texpr.BodyKindLetCallNoargReturnI32ConstPrefix)

fn PrimaryStatementReturnModeNone(): int32 =
    return 0

fn PrimaryStatementReturnModeI32Const(): int32 =
    return 1

@borrows
fn PrimaryBodyIrIsCallSequenceReturnInt32(bodyIR: coreir.BodyIR): bool =
    if bodyIR.callSequence.len <= 0:
        return false
    if bodyIR.ops.len <= 0:
        return false
    let lastIndex = bodyIR.ops.len - 1
    let lastOp = bodyIR.ops[lastIndex]
    if lastOp.kind != coreir.BodyOpReturnTag:
        return false
    if lastOp.operands.len <= 0:
        return false
    if lastOp.operands[0] == coreir.LocalI32Tag:
        return true
    if lastOp.operands[0] == PrimaryStatementReturnModeI32Const():
        return true
    return false

@borrows
fn PrimaryBodyIrIsI32TwoCallGuardFirstReturn(bodyIR: coreir.BodyIR): bool =
    if bodyIR.ops.len != 4 || bodyIR.callSequence.len != 2:
        return false
    if bodyIR.ops[0].kind != coreir.BodyOpCallTag ||
       bodyIR.ops[1].kind != coreir.BodyOpCallTag ||
       bodyIR.ops[2].kind != coreir.BodyOpBranchTag ||
       bodyIR.ops[3].kind != coreir.BodyOpReturnTag:
        return false
    if bodyIR.ops[0].operands.len < 1 ||
       bodyIR.ops[1].operands.len < 1 ||
       bodyIR.ops[2].operands.len < 3 ||
       bodyIR.ops[3].operands.len < 1:
        return false
    if bodyIR.ops[0].operands[0] != 0 ||
       bodyIR.ops[1].operands[0] != 1:
        return false
    if bodyIR.ops[2].operands[0] != coreir.BodyBranchIfLocalLeZeroReturnI32ConstTag:
        return false
    if bodyIR.ops[3].operands[0] == coreir.LocalI32Tag:
        return true
    return false

@borrows
fn PrimaryBodyIrIsI32GuardThenCommandReturn(bodyIR: coreir.BodyIR): bool =
    if bodyIR.ops.len != 4 || bodyIR.callSequence.len != 2:
        return false
    if bodyIR.ops[0].kind != coreir.BodyOpCallTag ||
       bodyIR.ops[1].kind != coreir.BodyOpBranchTag ||
       bodyIR.ops[2].kind != coreir.BodyOpCallTag ||
       bodyIR.ops[3].kind != coreir.BodyOpReturnTag:
        return false
    if bodyIR.ops[0].operands.len < 1 ||
       bodyIR.ops[1].operands.len < 3 ||
       bodyIR.ops[2].operands.len < 1 ||
       bodyIR.ops[3].operands.len < 1:
        return false
    if bodyIR.ops[0].operands[0] != 0 ||
       bodyIR.ops[2].operands[0] != 1:
        return false
    if bodyIR.ops[1].operands[0] != coreir.BodyBranchIfLocalLeZeroReturnI32ConstTag:
        return false
    if bodyIR.ops[3].operands[0] == coreir.LocalI32Tag:
        return true
    return false

@borrows
fn PrimaryBodyIrIsI32GuardHelpThenCommandReturn(bodyIR: coreir.BodyIR): bool =
    if bodyIR.ops.len != 4 || bodyIR.callSequence.len != 3:
        return false
    if bodyIR.ops[0].kind != coreir.BodyOpCallTag ||
       bodyIR.ops[1].kind != coreir.BodyOpBranchTag ||
       bodyIR.ops[2].kind != coreir.BodyOpCallTag ||
       bodyIR.ops[3].kind != coreir.BodyOpReturnTag:
        return false
    if bodyIR.ops[0].operands.len < 1 ||
       bodyIR.ops[1].operands.len < 3 ||
       bodyIR.ops[2].operands.len < 1 ||
       bodyIR.ops[3].operands.len < 1:
        return false
    if bodyIR.ops[0].operands[0] != 0 ||
       bodyIR.ops[2].operands[0] != 2:
        return false
    if bodyIR.ops[1].operands[0] != coreir.BodyBranchIfLocalLeZeroReturnCallNoargTag:
        return false
    if bodyIR.ops[3].operands[0] == coreir.LocalI32Tag:
        return true
    return false

@borrows
fn PrimaryBodyIrIsStrCallConstThenCallArg0ReturnI32(bodyIR: coreir.BodyIR): bool =
    if bodyIR.ops.len != 3 || bodyIR.callSequence.len != 2:
        return false
    if bodyIR.ops[0].kind != coreir.BodyOpCallTag ||
       bodyIR.ops[1].kind != coreir.BodyOpCallTag ||
       bodyIR.ops[2].kind != coreir.BodyOpReturnTag:
        return false
    if bodyIR.ops[0].operands.len < 2 ||
       bodyIR.ops[1].operands.len < 1 ||
       bodyIR.ops[2].operands.len < 1:
        return false
    if bodyIR.ops[0].operands[0] != 0 ||
       bodyIR.ops[1].operands[0] != 1:
        return false
    if bodyIR.ops[0].operands[1] != 1:
        return false
    if bodyIR.ops[0].target < 0 ||
       bodyIR.ops[0].target >= bodyIR.localSlots.len:
        return false
    if bodyIR.localSlots[bodyIR.ops[0].target].typeKind != coreir.LocalStrTag:
        return false
    if bodyIR.ops[2].operands[0] == coreir.LocalI32Tag:
        return true
    return false

@borrows
fn PrimaryBodyIrIsStrLetCallThenCallArg0ReturnI32(bodyIR: coreir.BodyIR): bool =
    if bodyIR.ops.len != 3:
        return false
    if bodyIR.callSequence.len != 2:
        return false
    if bodyIR.ops[0].kind != coreir.BodyOpCallTag:
        return false
    if bodyIR.ops[1].kind != coreir.BodyOpCallTag:
        return false
    if bodyIR.ops[2].kind != coreir.BodyOpReturnTag:
        return false
    if bodyIR.ops[0].operands.len != 1:
        return false
    if bodyIR.ops[1].operands.len < 1:
        return false
    if bodyIR.ops[2].operands.len < 1:
        return false
    if bodyIR.ops[0].operands[0] != 0:
        return false
    if bodyIR.ops[1].operands[0] != 1:
        return false
    if bodyIR.ops[0].target < 0:
        return false
    if bodyIR.ops[0].target >= bodyIR.localSlots.len:
        return false
    if bodyIR.localSlots[bodyIR.ops[0].target].typeKind != coreir.LocalStrTag:
        return false
    if bodyIR.ops[2].operands[0] != coreir.LocalI32Tag:
        return false
    return true

@borrows
fn PrimaryBodyIrIsArg0AggregateCallThenReturnCallArg0Arg1(bodyIR: coreir.BodyIR): bool =
    if bodyIR.ops.len != 3:
        return false
    if bodyIR.callSequence.len != 2:
        return false
    if bodyIR.ops[0].kind != coreir.BodyOpCallTag:
        return false
    if bodyIR.ops[1].kind != coreir.BodyOpCallTag:
        return false
    if bodyIR.ops[2].kind != coreir.BodyOpReturnTag:
        return false
    if bodyIR.ops[2].operands.len < 1:
        return false
    if bodyIR.ops[2].operands[0] != coreir.LocalI32Tag:
        return false
    if bodyIR.callSequence[0].resultSlot < 0:
        return false
    if bodyIR.callSequence[0].resultSlot >= bodyIR.localSlots.len:
        return false
    if bodyIR.localSlots[bodyIR.callSequence[0].resultSlot].typeKind != coreir.LocalAggregateTag:
        return false
    return true

@borrows
fn PrimaryBodyIrIsStrI32GuardCallArg0ThenDispatchReturnI32(bodyIR: coreir.BodyIR): bool =
    if bodyIR.ops.len != 7:
        return false
    if bodyIR.callSequence.len != 5:
        return false
    if bodyIR.ops[3].kind != coreir.BodyOpBranchTag:
        return false
    if bodyIR.ops[3].operands.len < 1:
        return false
    if bodyIR.ops[3].operands[0] != coreir.BodyBranchIfLocalLeZeroCallArg0ReturnI32ConstTag:
        return false
    return true

fn PrimaryStatementReturnModeCstringLiteralCallsReturnI32Const0(): int32 =
    return texpr.StatementReturnModeCstringLiteralCallsReturnI32Const0

@borrows
fn PrimaryBodyIrGeneralCfgWordCount(bodyIR: coreir.BodyIR): int32 =
    let frameBytes = PrimaryBodyIrFrameBytes(bodyIR)
    if frameBytes <= 0:
        return 0
    # The prologue saves the incoming params and the sret pointer at fixed
    # stack offsets. When those slots overflow the STR scaled-immediate ceiling
    # (32760 for 8-byte stores) the prologue materializes the param-save base
    # into a scratch register and stores relative to it; the extra words are
    # accounted for in PrimaryBodyIrPrologueWordCount.
    var count = PrimaryBodyIrPrologueWordCount(bodyIR)
    if bodyIR.blocks.len <= 0:
        return 0
    for blockIndex in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockIndex]
        if block.opStart < 0 ||
           block.opCount < 0 ||
           block.opStart + block.opCount > bodyIR.ops.len:
            return 0
        let opEnd = block.opStart + block.opCount
        for opIndex in block.opStart..<opEnd:
            let opSize = PrimaryBodyIROpSizeAt(bodyIR, opIndex)
            if opSize <= 0:
                var opDetail0: int32
                var opDetail1: int32
                var opDetail2: int32
                if bodyIR.ops[opIndex].operands.len > 0:
                    opDetail0 = bodyIR.ops[opIndex].operands[0]
                if bodyIR.ops[opIndex].operands.len > 1:
                    opDetail1 = bodyIR.ops[opIndex].operands[1]
                if bodyIR.ops[opIndex].operands.len > 2:
                    opDetail2 = bodyIR.ops[opIndex].operands[2]
                if PrimaryObjectPlanTraceActive():
                    PrimaryObjectPlanTrace(Fmt"phase=body_ir_word_count_op_zero block={blockIndex} op_index={opIndex} op_kind={bodyIR.ops[opIndex].kind} target={bodyIR.ops[opIndex].target} operands={bodyIR.ops[opIndex].operands.len} operand0={opDetail0} operand1={opDetail1} operand2={opDetail2}")
                return 0
            count = count + opSize
        let termSize = PrimaryBodyIRTermSize(bodyIR, block.termIndex)
        if termSize <= 0:
            var termKind: int32
            if block.termIndex >= 0 && block.termIndex < bodyIR.terms.len:
                termKind = bodyIR.terms[block.termIndex].kind
            if PrimaryObjectPlanTraceActive():
                PrimaryObjectPlanTrace(Fmt"phase=body_ir_word_count_term_zero block={blockIndex} term_index={block.termIndex} term_kind={termKind}")
            return 0
        count = count + termSize
    return count

@borrows
fn PrimaryBodyIrWasmWordCount(bodyIR: coreir.BodyIR): int32 =
    if bodyIR.ops.len <= 0:
        if bodyIR.terms.len <= 0:
            return 0
    return bodyIR.ops.len + bodyIR.terms.len

@borrows
fn PrimaryBodyIrWordCountForTarget(targetTriple: str,
                                    bodyIR: coreir.BodyIR): int32 =
    # B6d：三臂显式单元派发（契约 CodegenBodyEmitUnit 表键），废除原
    # else=arm64 默认兜底臂——缺 triple/单元显式失败，不留隐式默认。
    let emitUnit = contract.CodegenBodyEmitUnit(targetTriple)
    if emitUnit == contract.CodegenUnitWasm32:
        return PrimaryBodyIrWasmWordCount(bodyIR)
    if os.GetEnv("CHENG_X64_DBG") != "":
        for dbgBi in 0..<bodyIR.blocks.len:
            let dbgBlock = bodyIR.blocks[dbgBi]
            os.WriteLine(os.GetStderr(), Fmt"x64dbg block={dbgBi} opStart={dbgBlock.opStart} opCount={dbgBlock.opCount} term={dbgBlock.termIndex}")
        for dbgTi in 0..<bodyIR.terms.len:
            let dbgTerm = bodyIR.terms[dbgTi]
            os.WriteLine(os.GetStderr(), Fmt"x64dbg term={dbgTi} kind={dbgTerm.kind} cond={dbgTerm.conditionKind} result={dbgTerm.resultSlot} lhs={dbgTerm.lhsSlot} rhs={dbgTerm.rhsSlot} true={dbgTerm.trueBlock} false={dbgTerm.falseBlock}")
        for dbgOi in 0..<bodyIR.ops.len:
            let dbgOp = bodyIR.ops[dbgOi]
            os.WriteLine(os.GetStderr(), Fmt"x64dbg op={dbgOi} kind={dbgOp.kind} target={dbgOp.target} operands={dbgOp.operands.len}")
    if emitUnit == contract.CodegenUnitX64:
        return x64units.CodegenX64BodyIrWordCount(bodyIR)
    if emitUnit == contract.CodegenUnitA64:
        return PrimaryBodyIrGeneralCfgWordCount(bodyIR)
    # Step4 两臂收口（2026-08-29，案 A 报文收敛最小案；依据
    # cheng-patches/step4-final-20260829/CLOSEOUT-MANUAL.md §3）：未命中臂先
    # 经组合准入包装 CodegenCompositionAcquireArtifactForTriple 尝试取件——
    # Ok 即插件件已过字节门并入本地 store，供后续组合构建消费。按 D1「编译期
    # 组合、进程内不装载插件」铁律，本进程仍 fail-closed：Ok/Err 同抛规范报文
    # contract.CodegenPluginMissingError，不恢复任何隐式默认兜底臂。
    # 案 B（取件成功后按插件单元表续发）需下游插件分派面就绪，当前未就绪，
    # 禁第三案。
    var missingUnits: str[]
    var composeArtifact: rawbytes.Bytes
    let _ = pickup.CodegenCompositionAcquireArtifactForTriple(
        targetTriple, composeArtifact)
    panic(contract.CodegenPluginMissingError(targetTriple, missingUnits))

@borrows
fn PrimaryBodyIrCharLiteralValue(textRaw: str): int32 =
    let text = strutil.Strip(textRaw)
    if len(text) < 3 || text[0] != '\'' || text[len(text) - 1] != '\'':
        return -1
    let payloadLen = len(text) - 2
    if payloadLen == 1:
        return int32(text[1])
    if payloadLen == 2 && text[1] == '\\':
        let esc = text[2]
        if esc == 'n':
            return 10
        if esc == 'r':
            return 13
        if esc == 't':
            return 9
        if esc == '0':
            return 0
        return int32(esc)
    return -1

@borrows
fn PrimaryBodyIrExtractIntFromText(textRaw: str): int32 =
    let text = strutil.Strip(textRaw)
    let charValue = PrimaryBodyIrCharLiteralValue(text)
    if charValue >= 0:
        return charValue
    let int32Inner = PrimaryBodyIrWholeCallInnerForHead(text, "int32")
    if int32Inner != "":
        return PrimaryBodyIrExtractIntFromText(int32Inner)
    let int32Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "Int32")
    if int32Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(int32Inner2)
    let int64Inner = PrimaryBodyIrWholeCallInnerForHead(text, "int64")
    if int64Inner != "":
        return PrimaryBodyIrExtractIntFromText(int64Inner)
    let int64Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "Int64")
    if int64Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(int64Inner2)
    let uint8Inner = PrimaryBodyIrWholeCallInnerForHead(text, "uint8")
    if uint8Inner != "":
        return PrimaryBodyIrExtractIntFromText(uint8Inner)
    let uint8Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "UInt8")
    if uint8Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(uint8Inner2)
    let uint64Inner = PrimaryBodyIrWholeCallInnerForHead(text, "uint64")
    if uint64Inner != "":
        return PrimaryBodyIrExtractIntFromText(uint64Inner)
    let uint64Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "UInt64")
    if uint64Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(uint64Inner2)
    # uint32/uint16/int16/int8 casts wrap a value that fits the i32 word — strip
    # them too (the i64 extractor already did). Without these, e.g.
    # `uint32(0xFFFFFFFF)` fell through to the digit parser, returned the 0
    # failure-sentinel, and the const was never materialized (uninitialized slot).
    let uint32Inner = PrimaryBodyIrWholeCallInnerForHead(text, "uint32")
    if uint32Inner != "":
        return PrimaryBodyIrExtractIntFromText(uint32Inner)
    let uint32Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "UInt32")
    if uint32Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(uint32Inner2)
    let uint16Inner = PrimaryBodyIrWholeCallInnerForHead(text, "uint16")
    if uint16Inner != "":
        return PrimaryBodyIrExtractIntFromText(uint16Inner)
    let uint16Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "UInt16")
    if uint16Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(uint16Inner2)
    let int16Inner = PrimaryBodyIrWholeCallInnerForHead(text, "int16")
    if int16Inner != "":
        return PrimaryBodyIrExtractIntFromText(int16Inner)
    let int16Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "Int16")
    if int16Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(int16Inner2)
    let int8Inner = PrimaryBodyIrWholeCallInnerForHead(text, "int8")
    if int8Inner != "":
        return PrimaryBodyIrExtractIntFromText(int8Inner)
    let int8Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "Int8")
    if int8Inner2 != "":
        return PrimaryBodyIrExtractIntFromText(int8Inner2)
    let sizeofInner = PrimaryBodyIrWholeCallInnerForHead(text, "sizeof")
    if sizeofInner != "":
        let sizeofType = texpr.TypedExprNormalizeTypeText(strutil.Strip(sizeofInner))
        if sizeofType == "int8" || sizeofType == "uint8" || sizeofType == "bool" || sizeofType == "char":
            return 1
        if sizeofType == "int16" || sizeofType == "uint16":
            return 2
        if sizeofType == "int32" || sizeofType == "uint32" || sizeofType == "f32":
            return 4
        if sizeofType == "int64" || sizeofType == "uint64" || sizeofType == "f64" ||
           sizeofType == "ptr" || sizeofType == "cstring":
            return 8
        return 0
    if text == "":
        return 0
    if len(text) > 2 && text[0] == '0' && (text[1] == 'x' || text[1] == 'X'):
        var hexOut: int32
        for hi in 2..<len(text):
            let hch = text[hi]
            var hv: int32 = -1
            if hch >= '0' && hch <= '9':
                hv = int32(hch) - int32('0')
            elif hch >= 'a' && hch <= 'f':
                hv = int32(hch) - int32('a') + 10
            elif hch >= 'A' && hch <= 'F':
                hv = int32(hch) - int32('A') + 10
            if hv < 0:
                return 0
            hexOut = hexOut * 16 + hv
        return hexOut
    var sign: int32 = 1
    var start: int32
    if text[0] == '-':
        sign = -1
        start = 1
    if start >= len(text):
        return 0
    # hex literal (0x.. / 0X..): parse base-16, reject int32 overflow
    if start + 1 < len(text) && text[start] == '0' &&
       (text[start + 1] == 'x' || text[start + 1] == 'X'):
        let hexStart = start + 2
        if hexStart >= len(text):
            return 0
        var outHex: int32
        for i in hexStart..<len(text):
            let ch = text[i]
            if ch == '_':
                continue
            var digit: int32 = -1
            if ch >= '0' && ch <= '9':
                digit = int32(ch) - int32('0')
            elif ch >= 'a' && ch <= 'f':
                digit = 10 + int32(ch) - int32('a')
            elif ch >= 'A' && ch <= 'F':
                digit = 10 + int32(ch) - int32('A')
            else:
                return 0
            # reject int32 overflow instead of silently wrapping
            if outHex > 134217727:
                return 0
            if outHex == 134217727 && digit > 15:
                return 0
            outHex = outHex * 16 + digit
        if sign < 0:
            return 0 - outHex
        return outHex
    # binary literal (0b.. / 0B..): parse base-2, reject int32 overflow
    if start + 1 < len(text) && text[start] == '0' &&
       (text[start + 1] == 'b' || text[start + 1] == 'B'):
        let binStart = start + 2
        if binStart >= len(text):
            return 0
        var outBin: int32
        for i in binStart..<len(text):
            let ch = text[i]
            if ch == '_':
                continue
            if ch != '0' && ch != '1':
                return 0
            let digit = int32(ch) - int32('0')
            if outBin > 1073741823:
                return 0
            outBin = outBin * 2 + digit
        if sign < 0:
            return 0 - outBin
        return outBin
    # Accumulate in 64 bits so a decimal literal in the uint32 range (i.e.
    # > INT32_MAX up to 4294967295) is materialized by wrapping into the i32
    # word — the same as the hex path (0xFFFFFFFE -> -2). The previous code
    # bailed to the 0 failure-sentinel once `out` crossed INT32_MAX, so a
    # compare-RHS like `uint32(4294967294)` was never stored and `cmp` read an
    # uninitialized slot (DRIVER miscompile #40). Reject only when the magnitude
    # exceeds the uint32 range; genuinely-wider literals are handled by the i64
    # extractor elsewhere.
    var out64: int64
    for i in start..<len(text):
        let ch = text[i]
        if ch == '_':
            continue
        if ch < '0' || ch > '9':
            return 0
        let digit = int64(int32(ch) - int32('0'))
        # reject beyond the uint32 range (4294967295) instead of wrapping
        if out64 > int64(429496729):
            return 0
        if out64 == int64(429496729) && digit > int64(5):
            return 0
        out64 = out64 * int64(10) + digit
    if sign < 0:
        return 0 - int32(out64)
    return int32(out64)

@borrows
fn PrimaryBodyIrExtractInt64FromDigits(text: str, valueOut: var int64): bool =
    if text == "":
        return false
    var sign: int64 = 1
    var start: int32
    if text[0] == '-':
        sign = int64(0) - int64(1)
        start = 1
    if start >= len(text):
        return false
    # hex literal (0x.. / 0X..): parse base-16 with uint64-range acceptance
    if start + 1 < len(text) && text[start] == '0' &&
       (text[start + 1] == 'x' || text[start + 1] == 'X'):
        let hexStart = start + 2
        if hexStart >= len(text):
            return false
        var outHex: int64
        var hexDigits: int32
        for i in hexStart..<len(text):
            let ch = text[i]
            if ch == '_':
                continue
            var digit: int64 = int64(-1)
            if ch >= '0' && ch <= '9':
                digit = int64(int32(ch) - int32('0'))
            elif ch >= 'a' && ch <= 'f':
                digit = int64(10 + int32(ch) - int32('a'))
            elif ch >= 'A' && ch <= 'F':
                digit = int64(10 + int32(ch) - int32('A'))
            else:
                return false
            hexDigits = hexDigits + 1
            # cap at 16 hex digits (64 bits); reject wider literals
            if hexDigits > 16:
                return false
            outHex = outHex * int64(16) + digit
        if hexDigits == 0:
            return false
        valueOut = outHex * sign
        return true
    # binary literal (0b.. / 0B..): parse base-2
    if start + 1 < len(text) && text[start] == '0' &&
       (text[start + 1] == 'b' || text[start + 1] == 'B'):
        let binStart = start + 2
        if binStart >= len(text):
            return false
        var outBin: int64
        var binDigits: int32
        for i in binStart..<len(text):
            let ch = text[i]
            if ch == '_':
                continue
            if ch != '0' && ch != '1':
                return false
            binDigits = binDigits + 1
            if binDigits > 64:
                return false
            outBin = outBin * int64(2) + int64(int32(ch) - int32('0'))
        if binDigits == 0:
            return false
        valueOut = outBin * sign
        return true
    var out: int64
    for i in start..<len(text):
        let ch = text[i]
        if ch == '_':
            continue
        if ch < '0' || ch > '9':
            return false
        let digit = int64(int32(ch) - int32('0'))
        if out > int64(922337203685477580):
            return false
        if out == int64(922337203685477580) && digit > int64(7):
            return false
        out = out * int64(10) + digit
    valueOut = out * sign
    return true

@borrows
fn PrimaryBodyIrExtractInt64FromText(textRaw: str,
                                      valueOut: var int64): bool =
    let text = strutil.Strip(textRaw)
    if text == "":
        return false
    # strip primitive integer cast wrappers (int64(..)/uint64(..)/int32(..)/...)
    # Fast path: plain numeric literals (first char digit/sign) skip the seven
    # head probes — this runs per numeric token and dominated compile time.
    let firstCh = text[0]
    if (firstCh >= '0' && firstCh <= '9') || firstCh == '-' || firstCh == '+':
        return PrimaryBodyIrExtractInt64FromDigits(text, valueOut)
    let int64Inner = PrimaryBodyIrWholeCallInnerForHead(text, "int64")
    if int64Inner != "":
        return PrimaryBodyIrExtractInt64FromText(int64Inner, valueOut)
    let int64Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "Int64")
    if int64Inner2 != "":
        return PrimaryBodyIrExtractInt64FromText(int64Inner2, valueOut)
    let uint64Inner = PrimaryBodyIrWholeCallInnerForHead(text, "uint64")
    if uint64Inner != "":
        return PrimaryBodyIrExtractInt64FromText(uint64Inner, valueOut)
    let uint64Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "UInt64")
    if uint64Inner2 != "":
        return PrimaryBodyIrExtractInt64FromText(uint64Inner2, valueOut)
    let int32Inner = PrimaryBodyIrWholeCallInnerForHead(text, "int32")
    if int32Inner != "":
        return PrimaryBodyIrExtractInt64FromText(int32Inner, valueOut)
    let int32Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "Int32")
    if int32Inner2 != "":
        return PrimaryBodyIrExtractInt64FromText(int32Inner2, valueOut)
    let uint32Inner = PrimaryBodyIrWholeCallInnerForHead(text, "uint32")
    if uint32Inner != "":
        return PrimaryBodyIrExtractInt64FromText(uint32Inner, valueOut)
    let uint32Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "UInt32")
    if uint32Inner2 != "":
        return PrimaryBodyIrExtractInt64FromText(uint32Inner2, valueOut)
    let int8Inner = PrimaryBodyIrWholeCallInnerForHead(text, "int8")
    if int8Inner != "":
        return PrimaryBodyIrExtractInt64FromText(int8Inner, valueOut)
    let int8Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "Int8")
    if int8Inner2 != "":
        return PrimaryBodyIrExtractInt64FromText(int8Inner2, valueOut)
    let uint8Inner = PrimaryBodyIrWholeCallInnerForHead(text, "uint8")
    if uint8Inner != "":
        return PrimaryBodyIrExtractInt64FromText(uint8Inner, valueOut)
    let uint8Inner2 = PrimaryBodyIrWholeCallInnerForHead(text, "UInt8")
    if uint8Inner2 != "":
        return PrimaryBodyIrExtractInt64FromText(uint8Inner2, valueOut)
    return PrimaryBodyIrExtractInt64FromDigits(text, valueOut)

@borrows
fn PrimaryBodyIrTextIsF64Literal(textRaw: str): bool =
    let text = strutil.Strip(textRaw)
    if text.len < 3:
        return false
    var start: int32
    if text[0] == '-':
        if text.len < 4:
            return false
        start = 1
    var dotCount: int32
    var digitsBefore: int32
    var digitsAfter: int32
    for i in start..<text.len:
        let ch = text[i]
        if ch == '.':
            dotCount = dotCount + 1
            if dotCount > 1:
                return false
            continue
        if ch < '0' || ch > '9':
            return false
        if dotCount == 0:
            digitsBefore = digitsBefore + 1
        else:
            digitsAfter = digitsAfter + 1
    return dotCount == 1 && digitsBefore > 0 && digitsAfter > 0

@borrows
fn PrimaryBodyIrPow2U64(exp: int32,
                         out: var uint64): bool =
    if exp < 0 || exp >= 64:
        return false
    out = uint64(1)
    for _ in 0..<exp:
        out = out * uint64(2)
    return true

@borrows
fn PrimaryBodyIrF64LiteralFail(literalRaw: str,
                                reason: str): bool =
    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
        os.WriteLine(os.GetStderr(), Fmt"phase=f64_literal_bits_guard_fail lit={literalRaw} reason={reason}")
    return false

# DECIMAL_F64_EXACT_BEGIN. Keep this block byte-identical in backend2_lower_util.
# std/system ParseF64Bits repeatedly rounds binary64 multiply/add/div steps, so
# it is not a correctly-rounded compiler-literal oracle. This path keeps the
# decimal numerator/denominator exact until one ties-to-even rounding step.
const
    PrimaryBodyIrDecimalBigBase: uint64 = uint64(1000000000)
    PrimaryBodyIrDecimalBigShiftChunk: int32 = 29
    PrimaryBodyIrDecimalBigShiftFactor: uint64 = uint64(536870912)

type
    PrimaryBodyIrDecimalBig =
        limbs: uint64[]

@borrows
fn PrimaryBodyIrDecimalBigNormalize(value: var PrimaryBodyIrDecimalBig) =
    var count = value.limbs.len
    while count > 0 && value.limbs[count - 1] == uint64(0):
        count = count - 1
    if count != value.limbs.len:
        setLen(value.limbs, count)

@borrows
fn PrimaryBodyIrDecimalBigCopyInto(value: PrimaryBodyIrDecimalBig,
                                    out: var PrimaryBodyIrDecimalBig) =
    out.limbs = []
    for i in 0..<value.limbs.len:
        add(out.limbs, value.limbs[i])

@borrows
fn PrimaryBodyIrDecimalBigCompare(lhs: PrimaryBodyIrDecimalBig,
                                   rhs: PrimaryBodyIrDecimalBig): int32 =
    if lhs.limbs.len < rhs.limbs.len:
        return -1
    if lhs.limbs.len > rhs.limbs.len:
        return 1
    var i = lhs.limbs.len - 1
    while i >= 0:
        if lhs.limbs[i] < rhs.limbs[i]:
            return -1
        if lhs.limbs[i] > rhs.limbs[i]:
            return 1
        i = i - 1
    return 0

@borrows
fn PrimaryBodyIrDecimalBigMulSmall(value: var PrimaryBodyIrDecimalBig,
                                    factor: uint64): bool =
    if factor == uint64(0) || value.limbs.len == 0:
        value.limbs = []
        return true
    var carry: uint64
    for i in 0..<value.limbs.len:
        let wide = value.limbs[i] * factor + carry
        value.limbs[i] = wide % PrimaryBodyIrDecimalBigBase
        carry = wide / PrimaryBodyIrDecimalBigBase
    while carry > uint64(0):
        add(value.limbs, carry % PrimaryBodyIrDecimalBigBase)
        carry = carry / PrimaryBodyIrDecimalBigBase
    return true

@borrows
fn PrimaryBodyIrDecimalBigShiftLeft(value: var PrimaryBodyIrDecimalBig,
                                     bitCount: int32): bool =
    if bitCount < 0:
        return false
    var remaining = bitCount
    while remaining >= PrimaryBodyIrDecimalBigShiftChunk:
        if !PrimaryBodyIrDecimalBigMulSmall(value,
                                            PrimaryBodyIrDecimalBigShiftFactor):
            return false
        remaining = remaining - PrimaryBodyIrDecimalBigShiftChunk
    if remaining > 0:
        var factor = uint64(1)
        for _ in 0..<remaining:
            factor = factor * uint64(2)
        if !PrimaryBodyIrDecimalBigMulSmall(value, factor):
            return false
    return true

@borrows
fn PrimaryBodyIrDecimalBigShiftRightOne(value: var PrimaryBodyIrDecimalBig) =
    var carry: uint64
    var i = value.limbs.len - 1
    while i >= 0:
        let wide = value.limbs[i] + carry * PrimaryBodyIrDecimalBigBase
        value.limbs[i] = wide / uint64(2)
        carry = wide % uint64(2)
        i = i - 1
    PrimaryBodyIrDecimalBigNormalize(value)

@borrows
fn PrimaryBodyIrDecimalBigSubInPlace(value: var PrimaryBodyIrDecimalBig,
                                      rhs: PrimaryBodyIrDecimalBig): bool =
    if PrimaryBodyIrDecimalBigCompare(value, rhs) < 0:
        return false
    var borrow: uint64
    for i in 0..<value.limbs.len:
        var rhsLimb: uint64
        if i < rhs.limbs.len:
            rhsLimb = rhs.limbs[i]
        let subtrahend = rhsLimb + borrow
        let current = value.limbs[i]
        if current >= subtrahend:
            value.limbs[i] = current - subtrahend
            borrow = uint64(0)
        else:
            value.limbs[i] = current + PrimaryBodyIrDecimalBigBase - subtrahend
            borrow = uint64(1)
    if borrow != uint64(0):
        return false
    PrimaryBodyIrDecimalBigNormalize(value)
    return true

@borrows
fn PrimaryBodyIrDecimalPow10Into(scale: int32,
                                  out: var PrimaryBodyIrDecimalBig): bool =
    if scale < 0:
        return false
    out.limbs = []
    let fullLimbs = scale / 9
    let tailDigits = scale % 9
    for _ in 0..<fullLimbs:
        add(out.limbs, uint64(0))
    var high = uint64(1)
    for _ in 0..<tailDigits:
        high = high * uint64(10)
    add(out.limbs, high)
    return true

@borrows
fn PrimaryBodyIrParseDecimalBig(literalRaw: str,
                                 negativeOut: var bool,
                                 numeratorOut: var PrimaryBodyIrDecimalBig,
                                 scaleOut: var int32,
                                 decimalExponentOut: var int32): bool =
    let text = strutil.Strip(literalRaw)
    negativeOut = false
    numeratorOut.limbs = []
    scaleOut = 0
    decimalExponentOut = 0
    if !PrimaryBodyIrTextIsF64Literal(text):
        return false
    var start: int32
    if text[0] == '-':
        negativeOut = true
        start = 1
    var dotIndex: int32 = -1
    var digitIndex: int32
    var firstNonZeroDigit: int32 = -1
    for i in start..<text.len:
        let ch = text[i]
        if ch == '.':
            dotIndex = i
            continue
        if firstNonZeroDigit < 0 && ch != '0':
            firstNonZeroDigit = digitIndex
        digitIndex = digitIndex + 1
        if dotIndex >= 0:
            scaleOut = scaleOut + 1
    if dotIndex < 0:
        return false
    if firstNonZeroDigit < 0:
        return true
    let digitsBeforeDot = dotIndex - start
    decimalExponentOut = digitsBeforeDot - firstNonZeroDigit - 1

    var groupValue: uint64
    var groupFactor = uint64(1)
    var groupDigits: int32
    var i = text.len - 1
    while i >= start:
        let ch = text[i]
        if ch != '.':
            let digit = uint64(int32(ch) - int32('0'))
            groupValue = groupValue + digit * groupFactor
            groupDigits = groupDigits + 1
            if groupDigits == 9:
                add(numeratorOut.limbs, groupValue)
                groupValue = uint64(0)
                groupFactor = uint64(1)
                groupDigits = 0
            else:
                groupFactor = groupFactor * uint64(10)
        i = i - 1
    if groupDigits > 0:
        add(numeratorOut.limbs, groupValue)
    PrimaryBodyIrDecimalBigNormalize(numeratorOut)
    return numeratorOut.limbs.len > 0

@borrows
fn PrimaryBodyIrDecimalRatioComparePow2(numerator: PrimaryBodyIrDecimalBig,
                                         denominator: PrimaryBodyIrDecimalBig,
                                         exponent: int32): int32 =
    var scaled: PrimaryBodyIrDecimalBig
    if exponent >= 0:
        PrimaryBodyIrDecimalBigCopyInto(denominator, scaled)
        if !PrimaryBodyIrDecimalBigShiftLeft(scaled, exponent):
            return -2
        return PrimaryBodyIrDecimalBigCompare(numerator, scaled)
    PrimaryBodyIrDecimalBigCopyInto(numerator, scaled)
    if !PrimaryBodyIrDecimalBigShiftLeft(scaled, 0 - exponent):
        return -2
    return PrimaryBodyIrDecimalBigCompare(scaled, denominator)

@borrows
fn PrimaryBodyIrDecimalBinaryExponent(numerator: PrimaryBodyIrDecimalBig,
                                       denominator: PrimaryBodyIrDecimalBig,
                                       decimalExponent: int32,
                                       exponentOut: var int32): bool =
    let scaledDecimalExponent = decimalExponent * 3321928
    if scaledDecimalExponent >= 0:
        exponentOut = scaledDecimalExponent / 1000000
    else:
        exponentOut = 0 - ((0 - scaledDecimalExponent + 999999) / 1000000)
    var settled = false
    for _ in 0..<8:
        let cmp = PrimaryBodyIrDecimalRatioComparePow2(numerator,
                                                       denominator,
                                                       exponentOut)
        if cmp == -2:
            return false
        if cmp >= 0:
            settled = true
            break
        exponentOut = exponentOut - 1
    if !settled:
        return false
    settled = false
    for _ in 0..<8:
        let cmp = PrimaryBodyIrDecimalRatioComparePow2(numerator,
                                                       denominator,
                                                       exponentOut + 1)
        if cmp == -2:
            return false
        if cmp < 0:
            settled = true
            break
        exponentOut = exponentOut + 1
    return settled

@borrows
fn PrimaryBodyIrDecimalQuotientRemainder(numerator: PrimaryBodyIrDecimalBig,
                                          denominator: PrimaryBodyIrDecimalBig,
                                          quotientOut: var uint64,
                                          remainderOut: var PrimaryBodyIrDecimalBig): bool =
    quotientOut = uint64(0)
    PrimaryBodyIrDecimalBigCopyInto(numerator, remainderOut)
    if denominator.limbs.len == 0:
        return false
    if PrimaryBodyIrDecimalBigCompare(remainderOut, denominator) < 0:
        return true
    var shifted: PrimaryBodyIrDecimalBig
    PrimaryBodyIrDecimalBigCopyInto(denominator, shifted)
    var topBit: int32
    while topBit < 63 &&
          PrimaryBodyIrDecimalBigCompare(shifted, remainderOut) <= 0:
        if !PrimaryBodyIrDecimalBigMulSmall(shifted, uint64(2)):
            return false
        topBit = topBit + 1
    if PrimaryBodyIrDecimalBigCompare(shifted, remainderOut) <= 0:
        return false
    PrimaryBodyIrDecimalBigShiftRightOne(shifted)
    topBit = topBit - 1
    var bit = topBit
    while bit >= 0:
        if PrimaryBodyIrDecimalBigCompare(remainderOut, shifted) >= 0:
            if !PrimaryBodyIrDecimalBigSubInPlace(remainderOut, shifted):
                return false
            var bitValue: uint64
            if !PrimaryBodyIrPow2U64(bit, bitValue):
                return false
            quotientOut = quotientOut + bitValue
        if bit > 0:
            PrimaryBodyIrDecimalBigShiftRightOne(shifted)
        bit = bit - 1
    return true

@borrows
fn PrimaryBodyIrDecimalRoundedQuotient(numerator: PrimaryBodyIrDecimalBig,
                                        denominator: PrimaryBodyIrDecimalBig,
                                        quotientOut: var uint64): bool =
    var remainder: PrimaryBodyIrDecimalBig
    if !PrimaryBodyIrDecimalQuotientRemainder(numerator,
                                              denominator,
                                              quotientOut,
                                              remainder):
        return false
    var twiceRemainder: PrimaryBodyIrDecimalBig
    PrimaryBodyIrDecimalBigCopyInto(remainder, twiceRemainder)
    if !PrimaryBodyIrDecimalBigMulSmall(twiceRemainder, uint64(2)):
        return false
    let roundCmp = PrimaryBodyIrDecimalBigCompare(twiceRemainder, denominator)
    if roundCmp > 0 ||
       (roundCmp == 0 && (quotientOut & uint64(1)) == uint64(1)):
        quotientOut = quotientOut + uint64(1)
    return true

@borrows
fn PrimaryBodyIrF64LiteralBits(literalRaw: str,
                                bitsOut: var uint64): bool =
    var negative: bool
    var numerator: PrimaryBodyIrDecimalBig
    var scale: int32
    var decimalExponent: int32
    if !PrimaryBodyIrParseDecimalBig(literalRaw,
                                     negative,
                                     numerator,
                                     scale,
                                     decimalExponent):
        return PrimaryBodyIrF64LiteralFail(literalRaw, "parse")
    var signBit: uint64
    if negative && !PrimaryBodyIrPow2U64(63, signBit):
        return PrimaryBodyIrF64LiteralFail(literalRaw, "sign_pow2")
    if numerator.limbs.len == 0:
        bitsOut = uint64(0)
        if negative:
            bitsOut = signBit
        return true
    var hiddenBit: uint64
    if !PrimaryBodyIrPow2U64(52, hiddenBit):
        return PrimaryBodyIrF64LiteralFail(literalRaw, "hidden_pow2")

    # Decimal exponents outside these bounds are unambiguous without building
    # 10^scale: >=1e309 rounds to infinity; <1e-324 is below half min-subnormal.
    if decimalExponent >= 309:
        bitsOut = uint64(0x7ff) * hiddenBit
        if negative:
            bitsOut = bitsOut | signBit
        return true
    if decimalExponent < -324:
        bitsOut = uint64(0)
        if negative:
            bitsOut = signBit
        return true

    var denominator: PrimaryBodyIrDecimalBig
    if !PrimaryBodyIrDecimalPow10Into(scale, denominator):
        return PrimaryBodyIrF64LiteralFail(literalRaw, "pow10")
    var exponent: int32
    if !PrimaryBodyIrDecimalBinaryExponent(numerator,
                                           denominator,
                                           decimalExponent,
                                           exponent):
        return PrimaryBodyIrF64LiteralFail(literalRaw, "binary_exponent")
    if exponent > 1023:
        bitsOut = uint64(0x7ff) * hiddenBit
        if negative:
            bitsOut = bitsOut | signBit
        return true

    var scaledNumerator: PrimaryBodyIrDecimalBig
    var scaledDenominator: PrimaryBodyIrDecimalBig
    PrimaryBodyIrDecimalBigCopyInto(numerator, scaledNumerator)
    PrimaryBodyIrDecimalBigCopyInto(denominator, scaledDenominator)
    if exponent < -1022:
        if !PrimaryBodyIrDecimalBigShiftLeft(scaledNumerator, 1074):
            return PrimaryBodyIrF64LiteralFail(literalRaw, "subnormal_shift")
        var subnormal: uint64
        if !PrimaryBodyIrDecimalRoundedQuotient(scaledNumerator,
                                                scaledDenominator,
                                                subnormal):
            return PrimaryBodyIrF64LiteralFail(literalRaw, "subnormal_round")
        if subnormal >= hiddenBit:
            bitsOut = hiddenBit
        else:
            bitsOut = subnormal
        if negative:
            bitsOut = bitsOut | signBit
        return true

    let significandShift = 52 - exponent
    if significandShift >= 0:
        if !PrimaryBodyIrDecimalBigShiftLeft(scaledNumerator,
                                             significandShift):
            return PrimaryBodyIrF64LiteralFail(literalRaw, "normal_num_shift")
    else:
        if !PrimaryBodyIrDecimalBigShiftLeft(scaledDenominator,
                                             0 - significandShift):
            return PrimaryBodyIrF64LiteralFail(literalRaw, "normal_den_shift")
    var significand: uint64
    if !PrimaryBodyIrDecimalRoundedQuotient(scaledNumerator,
                                            scaledDenominator,
                                            significand):
        return PrimaryBodyIrF64LiteralFail(literalRaw, "normal_round")
    var overflowBit: uint64
    if !PrimaryBodyIrPow2U64(53, overflowBit):
        return PrimaryBodyIrF64LiteralFail(literalRaw, "overflow_pow2")
    if significand >= overflowBit:
        significand = significand / uint64(2)
        exponent = exponent + 1
    if exponent > 1023:
        bitsOut = uint64(0x7ff) * hiddenBit
    else:
        if significand < hiddenBit:
            return PrimaryBodyIrF64LiteralFail(literalRaw, "normal_significand")
        bitsOut = uint64(exponent + 1023) * hiddenBit +
                  (significand - hiddenBit)
    if negative:
        bitsOut = bitsOut | signBit
    return true
# DECIMAL_F64_EXACT_END

@borrows
fn PrimaryBodyIrAppendF64ConstOperands(op: var coreir.BodyOp,
                                        literalRaw: str): bool =
    var bits: uint64
    if !PrimaryBodyIrF64LiteralBits(literalRaw, bits):
        return false
    let chunk = uint64(65536)
    let chunk2 = chunk * chunk
    let chunk3 = chunk2 * chunk
    add(op.operands, coreir.LocalF64Tag)
    add(op.operands, int32(bits % chunk))
    add(op.operands, int32((bits / chunk) % chunk))
    add(op.operands, int32((bits / chunk2) % chunk))
    add(op.operands, int32((bits / chunk3) % chunk))
    return true


@borrows
fn PrimaryBodyIrPrimitiveCastConstTypeKind(textRaw: str): int32 =
    let text = strutil.Strip(textRaw)
    if PrimaryBodyIrWholeCallInnerForHead(text, "int8") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "Int8") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "uint8") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "UInt8") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "uint32") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "UInt32") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "int32") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "Int32") != "":
        return coreir.LocalI32Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "uint64") != "":
        return coreir.LocalI64Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "UInt64") != "":
        return coreir.LocalI64Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "int64") != "":
        return coreir.LocalI64Tag
    if PrimaryBodyIrWholeCallInnerForHead(text, "Int64") != "":
        return coreir.LocalI64Tag
    return coreir.LocalInvalidTag

@borrows
fn PrimaryBodyIrCanonicalConstInt64(typedIr: texpr.TypedExprIr,
                                     sourcePath: str,
                                     textRaw: str,
                                     found: var bool): int64 =
    found = false
    let text = strutil.Strip(textRaw)
    if sourcePath == "" || text == "":
        return int64(0)
    var visitedOwners: str[]
    var visitedNames: str[]
    var recognized = false
    var value: int64
    let resolved = texpr.TypedExprIrCallConstIntValue(
        typedIr,
        sourcePath,
        text,
        visitedOwners,
        visitedNames,
        recognized,
        value)
    if visitedOwners.len != 0 || visitedNames.len != 0:
        panic(Fmt"primary: canonical const evaluator leaked visit state source={sourcePath} text={text}")
    if !recognized || !resolved:
        # Speculative folding only: the evaluator's shape recognition also
        # accepts arithmetic over runtime locals (`ptrBytes + i32Bytes`),
        # which is not provably const. Leave it to the general evaluator;
        # genuinely malformed const text still fails there, fail-stop.
        return int64(0)
    found = true
    return value

@borrows
fn PrimaryBodyIrCanonicalConstI32(typedIr: texpr.TypedExprIr,
                                   sourcePath: str,
                                   textRaw: str,
                                   found: var bool): int32 =
    var found64 = false
    let value = PrimaryBodyIrCanonicalConstInt64(typedIr,
                                                  sourcePath,
                                                  textRaw,
                                                  found64)
    if !found64:
        found = false
        return 0
    if value < Int64(-2147483648) || value > Int64(2147483647):
        panic(Fmt"primary: canonical int32 const out of range source={sourcePath} text={textRaw} value={value}")
    found = true
    return Int32(value)

@borrows
fn PrimaryBodyIrCanonicalConstStringLiteralAt(
        typedIr: texpr.TypedExprIr,
        sourcePath: str,
        textRaw: str,
        visitedOwners: var str[],
        visitedNames: var str[]): str =
    let text = strutil.Strip(textRaw)
    if sourcePath == "" || text == "":
        return ""
    if PrimaryBodyIrTextIsStringLiteral(text):
        return strings.CloneStr(text)
    var targetOwnerSourcePath = ""
    var literal = ""
    var found = false
    var cycle = false
    if !texpr.TypedExprIrCallConstTarget(
            typedIr,
            strings.CloneStr(sourcePath),
            strings.CloneStr(text),
            visitedOwners,
            visitedNames,
            targetOwnerSourcePath,
            literal,
            found,
            cycle):
        if cycle:
            panic(Fmt"primary: canonical string const cycle source={sourcePath} text={text}")
        if found:
            panic(Fmt"primary: canonical string const payload invalid source={sourcePath} text={text}")
        return ""
    if PrimaryBodyIrTextIsStringLiteral(literal):
        return strings.CloneStr(literal)
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(literal):
        panic(Fmt"primary: canonical string const is not a literal or const reference source={targetOwnerSourcePath} text={literal}")
    return PrimaryBodyIrCanonicalConstStringLiteralAt(typedIr,
                                                       targetOwnerSourcePath,
                                                       literal,
                                                       visitedOwners,
                                                       visitedNames)

@borrows
fn PrimaryBodyIrCanonicalConstStringLiteral(typedIr: texpr.TypedExprIr,
                                              sourcePath: str,
                                              textRaw: str): str =
    var visitedOwners: str[]
    var visitedNames: str[]
    return PrimaryBodyIrCanonicalConstStringLiteralAt(typedIr,
                                                       sourcePath,
                                                       textRaw,
                                                       visitedOwners,
                                                       visitedNames)

@borrows
fn PrimaryBodyIrLookupQualifiedSourceEnumI32(typedIr: texpr.TypedExprIr,
                                              sourcePath: str,
                                              nameRaw: str,
                                              found: var bool): int32 =
    found = false
    let nameText = strutil.Strip(nameRaw)
    if !texpr.TypedExprTextIsSimpleFieldPath(nameText):
        return 0
    let qualifier = texpr.TypedExprAssignLhsRootName(nameText)
    let memberName = texpr.TypedExprAssignFieldPath(nameText)
    if qualifier == "" || memberName == "":
        return 0
    if PrimaryBodyIrTextHasFieldOrIndex(memberName):
        return 0
    var targetSourcePath = texpr.TypedExprIrLookupTypeAliasTargetSourcePath(typedIr,
                                                                           sourcePath,
                                                                           qualifier)
    if targetSourcePath == "":
        targetSourcePath = PrimaryBodyIrCanonicalImportTargetSourcePath(typedIr,
                                                                        sourcePath,
                                                                        qualifier)
    # bail=44 同模块: qualifier 非 import/type 别名, 但确为【本源】定义的枚举类型
    # (enum_value/nested_match/r15/r16 全族根)。链尾补一手, 严等 qualifier 是本源
    # enum 类型才把 targetSourcePath 定回本源; 非枚举 qualifier 保持 "" → return 0
    # (poison 不变), 与既有跨模块/别名路径形态严不重叠。
    if targetSourcePath == "" &&
       texpr.TypedExprIrTypeIsEnum(typedIr, sourcePath, qualifier):
        targetSourcePath = sourcePath
    if targetSourcePath == "":
        return 0
    var enumTypeName = ""
    var enumOrdinal: int32
    if !texpr.TypedExprIrLookupEnumConstValue(typedIr,
                                              targetSourcePath,
                                              memberName,
                                              enumTypeName,
                                              enumOrdinal):
        return 0
    found = true
    return enumOrdinal

@borrows
fn PrimaryBodyIrParseCondition(
    conditionText: str,
    var lhsText: str,
    var rhsText: str,
    var cmpTag: int32
): bool =
    var opPos: int32 = -1
    var opLen: int32
    var tag: int32
    for i in 0..<len(conditionText):
        let ch = conditionText[i]
        if ch == '=' && i + 1 < len(conditionText) && conditionText[i + 1] == '=':
            opPos = i
            opLen = 2
            tag = coreir.BodyCondI32EqTag
            break
        if ch == '!' && i + 1 < len(conditionText) && conditionText[i + 1] == '=':
            opPos = i
            opLen = 2
            tag = coreir.BodyCondI32NeTag
            break
        if ch == '<' && i + 1 < len(conditionText) && conditionText[i + 1] == '=':
            opPos = i
            opLen = 2
            tag = coreir.BodyCondI32LeTag
            break
        if ch == '>' && i + 1 < len(conditionText) && conditionText[i + 1] == '=':
            opPos = i
            opLen = 2
            tag = coreir.BodyCondI32GeTag
            break
        if ch == '<' && (i + 1 >= len(conditionText) || conditionText[i + 1] != '='):
            opPos = i
            opLen = 1
            tag = coreir.BodyCondI32LtTag
            break
        if ch == '>' && (i + 1 >= len(conditionText) || conditionText[i + 1] != '='):
            opPos = i
            opLen = 1
            tag = coreir.BodyCondI32GtTag
            break
    if opPos < 0:
        return false
    lhsText = strings.SliceBytes(conditionText, 0, opPos)
    var lhsEnd = len(lhsText)
    while lhsEnd > 0 && lhsText[lhsEnd - 1] == ' ':
        lhsEnd = lhsEnd - 1
    lhsText = strings.SliceBytes(lhsText, 0, lhsEnd)
    var rhsRaw = strings.SliceBytes(conditionText, opPos + opLen, len(conditionText) - opPos - opLen)
    var rhsStart: int32
    while rhsStart < len(rhsRaw) && rhsRaw[rhsStart] == ' ':
        rhsStart = rhsStart + 1
    rhsText = strings.SliceBytes(rhsRaw, rhsStart, len(rhsRaw) - rhsStart)
    cmpTag = tag
    return true

@borrows
fn PrimaryBodyIrNodeBoolChainJournalReset() =
    var empty: PrimaryBodyIrNodeBoolChainMutationJournal
    primaryBodyIrNodeBoolChainMutationJournal = empty

@borrows
fn PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(
        bodyIR: var coreir.BodyIR,
        slotIndex: int32) =
    if !primaryBodyIrNodeBoolChainMutationJournal.active:
        return
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        panic("body_ir_bool_chain_slot_journal_index_invalid")
    if slotIndex >= primaryBodyIrNodeBoolChainMutationJournal.slotPrefixCount:
        return
    add(primaryBodyIrNodeBoolChainMutationJournal.slotMutationIndexes,
        slotIndex)
    var oldSlot: coreir.LocalSlot
    oldSlot.id = bodyIR.localSlots[slotIndex].id
    oldSlot.name = strings.CloneStr(bodyIR.localSlots[slotIndex].name)
    oldSlot.typeKind = bodyIR.localSlots[slotIndex].typeKind
    oldSlot.typeArenaTypeId = bodyIR.localSlots[slotIndex].typeArenaTypeId
    oldSlot.managedStorageKind = bodyIR.localSlots[slotIndex].managedStorageKind
    oldSlot.placeKind = bodyIR.localSlots[slotIndex].placeKind
    oldSlot.stackOffset = bodyIR.localSlots[slotIndex].stackOffset
    oldSlot.sizeBytes = bodyIR.localSlots[slotIndex].sizeBytes
    oldSlot.alignBytes = bodyIR.localSlots[slotIndex].alignBytes
    oldSlot.auxValue = bodyIR.localSlots[slotIndex].auxValue
    oldSlot.ownership = bodyIR.localSlots[slotIndex].ownership
    oldSlot.aliasClass = bodyIR.localSlots[slotIndex].aliasClass
    oldSlot.escapeKind = bodyIR.localSlots[slotIndex].escapeKind
    oldSlot.noAlias = bodyIR.localSlots[slotIndex].noAlias
    add(primaryBodyIrNodeBoolChainMutationJournal.slotMutationOldValues,
        oldSlot)
    # [bodyir-ownership-wall] 日志快照落地回读（只读）：刚追加的快照元素是否等于 oldSlot
    let primaryJournalSnapshotLast =
        primaryBodyIrNodeBoolChainMutationJournal.slotMutationOldValues.len - 1
    if primaryJournalSnapshotLast < 0 ||
       primaryBodyIrNodeBoolChainMutationJournal.slotMutationOldValues[
           primaryJournalSnapshotLast].id != oldSlot.id ||
       primaryBodyIrNodeBoolChainMutationJournal.slotMutationOldValues[
           primaryJournalSnapshotLast].typeKind != oldSlot.typeKind ||
       len(primaryBodyIrNodeBoolChainMutationJournal.slotMutationOldValues[
           primaryJournalSnapshotLast].name) != len(oldSlot.name):
        panic(Fmt"primary journal snapshot element lost slot={slotIndex} snap_len={primaryBodyIrNodeBoolChainMutationJournal.slotMutationOldValues.len} snap_cap={primaryBodyIrNodeBoolChainMutationJournal.slotMutationOldValues.cap} id={oldSlot.id} tk={Int32(oldSlot.typeKind)}")

@borrows
fn PrimaryBodyIrNodeBoolChainJournalSlotNameBeforeWrite(
        slotNames: var str[],
        slotIndex: int32) =
    if !primaryBodyIrNodeBoolChainMutationJournal.active:
        return
    if slotIndex < 0 || slotIndex >= slotNames.len:
        panic("body_ir_bool_chain_slot_name_journal_index_invalid")
    if slotIndex >= primaryBodyIrNodeBoolChainMutationJournal.slotNamePrefixCount:
        return
    add(primaryBodyIrNodeBoolChainMutationJournal.slotNameMutationIndexes,
        slotIndex)
    add(primaryBodyIrNodeBoolChainMutationJournal.slotNameMutationOldValues,
        share(slotNames[slotIndex]))

@borrows
fn PrimaryBodyIrNodeBoolChainJournalOpBeforeWrite(
        bodyIR: var coreir.BodyIR,
        opIndex: int32) =
    if !primaryBodyIrNodeBoolChainMutationJournal.active:
        return
    if opIndex < 0 || opIndex >= bodyIR.ops.len:
        panic("body_ir_bool_chain_op_journal_index_invalid")
    if opIndex >= primaryBodyIrNodeBoolChainMutationJournal.opPrefixCount:
        return
    add(primaryBodyIrNodeBoolChainMutationJournal.opMutationIndexes, opIndex)
    add(primaryBodyIrNodeBoolChainMutationJournal.opMutationOldValues, share(bodyIR.ops[opIndex]))

@borrows
fn PrimaryBodyIrNodeBoolChainJournalCallBeforeWrite(
        bodyIR: var coreir.BodyIR,
        callIndex: int32) =
    if !primaryBodyIrNodeBoolChainMutationJournal.active:
        return
    if callIndex < 0 || callIndex >= bodyIR.callSequence.len:
        panic("body_ir_bool_chain_call_journal_index_invalid")
    if callIndex >= primaryBodyIrNodeBoolChainMutationJournal.callPrefixCount:
        return
    add(primaryBodyIrNodeBoolChainMutationJournal.callMutationIndexes, callIndex)
    add(primaryBodyIrNodeBoolChainMutationJournal.callMutationOldValues, share(bodyIR.callSequence[callIndex]))

@borrows
fn PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(
        bodyIR: var coreir.BodyIR,
        termIndex: int32) =
    if !primaryBodyIrNodeBoolChainMutationJournal.active:
        return
    if termIndex < 0 || termIndex >= bodyIR.terms.len:
        panic("body_ir_bool_chain_term_journal_index_invalid")
    if termIndex >= primaryBodyIrNodeBoolChainMutationJournal.termPrefixCount:
        return
    add(primaryBodyIrNodeBoolChainMutationJournal.termMutationIndexes, termIndex)
    add(primaryBodyIrNodeBoolChainMutationJournal.termMutationOldValues,
        share(bodyIR.terms[termIndex]))

@borrows
fn PrimaryBodyIrNodeBoolChainJournalIrCallRowBeforeWrite(
        irFunction: var lower.PrimaryObjectIrFunction,
        ordinal: int32) =
    if !primaryBodyIrNodeBoolChainMutationJournal.active:
        return
    if ordinal < 0 ||
       ordinal >= irFunction.callArgCounts.len ||
       ordinal >= irFunction.callTargets.len ||
       ordinal >= irFunction.callTargetSourcePaths.len ||
       ordinal >= irFunction.callTargetSignatureLineNumbers.len ||
       ordinal >= irFunction.callTargetImportcFlags.len ||
       ordinal >= irFunction.callImportcSymbols.len:
        panic("body_ir_bool_chain_ir_call_row_journal_index_invalid")
    if ordinal >= primaryBodyIrNodeBoolChainMutationJournal.irCallRowPrefixCount:
        return
    add(primaryBodyIrNodeBoolChainMutationJournal.irCallRowMutationOrdinals,
        ordinal)
    add(primaryBodyIrNodeBoolChainMutationJournal.irCallArgCountOldValues,
        irFunction.callArgCounts[ordinal])
    add(primaryBodyIrNodeBoolChainMutationJournal.irCallTargetOldValues,
        share(irFunction.callTargets[ordinal]))
    add(primaryBodyIrNodeBoolChainMutationJournal.irCallTargetSourcePathOldValues,
        share(irFunction.callTargetSourcePaths[ordinal]))
    add(primaryBodyIrNodeBoolChainMutationJournal.irCallTargetSignatureLineNumberOldValues,
        irFunction.callTargetSignatureLineNumbers[ordinal])
    add(primaryBodyIrNodeBoolChainMutationJournal.irCallTargetImportcFlagOldValues,
        irFunction.callTargetImportcFlags[ordinal])
    add(primaryBodyIrNodeBoolChainMutationJournal.irCallImportcSymbolOldValues,
        share(irFunction.callImportcSymbols[ordinal]))

@borrows
fn PrimaryBodyIrNodeBoolChainSlotNameIndexLookup(
        bodyIR: var coreir.BodyIR,
        slotNames: var str[],
        name: str,
        found: var bool): int32 =
    found = false
    if primaryBodyIrNodeBoolChainMutationJournal.active:
        var overlayIndex = primaryBodyIrNodeBoolChainMutationJournal.newSlotNames.len - 1
        while overlayIndex >= 0:
            if primaryBodyIrNodeBoolChainMutationJournal.newSlotNames[overlayIndex] == name:
                let slotIndex = primaryBodyIrNodeBoolChainMutationJournal.newSlotIndexes[overlayIndex]
                if slotIndex >= 0 && slotIndex < slotNames.len &&
                   slotNames[slotIndex] == name:
                    found = true
                    return slotIndex
            overlayIndex = overlayIndex - 1
    return hashmaps.HashMapStrIntGetMutEx(bodyIR.slotNameIndex, name, found)

@borrows
fn PrimaryBodyIrNodeBoolChainSlotNameIndexPut(
        bodyIR: var coreir.BodyIR,
        name: str,
        slotIndex: int32) =
    if primaryBodyIrNodeBoolChainMutationJournal.active:
        add(primaryBodyIrNodeBoolChainMutationJournal.newSlotNames, share(name))
        add(primaryBodyIrNodeBoolChainMutationJournal.newSlotIndexes, slotIndex)
        return
    hashmaps.HashMapStrIntPut(bodyIR.slotNameIndex, strings.CloneStr(name), slotIndex)

@borrows
fn PrimaryBodyIrNextLocalStackOffset(bodyIR: coreir.BodyIR,
                                      sizeBytes: int32,
                                      alignBytes: int32): int32 =
    var offset: int32 = 16
    for i in 0..<bodyIR.localSlots.len:
        if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[i]):
            continue
        let slotSize = PrimaryBodyIrLocalFrameFootprint(bodyIR.localSlots[i])
        if slotSize <= 0:
            continue
        let slotEnd = bodyIR.localSlots[i].stackOffset + slotSize
        if slotEnd > offset:
            offset = slotEnd
    var align = alignBytes
    if align <= 0:
        align = 1
    if align > 16:
        align = 16
    return ((offset + align - 1) / align) * align

@borrows
fn PrimaryBodyIrReflowLocalStackOffsets(bodyIR: var coreir.BodyIR) =
    # Two passes: scalar slots (<= 8 bytes, accessed with single scaled-imm
    # ldr/str whose range is 16380/32760 bytes) first so they keep small
    # offsets; wide slots (str 24B, aggregates) after — they are accessed
    # through materialized address registers that handle any offset.
    var offset: int32 = 16
    for i in 0..<bodyIR.localSlots.len:
        if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[i]):
            continue
        let slotSize = PrimaryBodyIrLocalFrameFootprint(bodyIR.localSlots[i])
        if slotSize <= 0 || slotSize > 8:
            continue
        var align = bodyIR.localSlots[i].alignBytes
        if align <= 0:
            align = 1
        if align > 16:
            align = 16
        offset = ((offset + align - 1) / align) * align
        PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, i)
        bodyIR.localSlots[i].stackOffset = offset
        offset = offset + slotSize
    for i in 0..<bodyIR.localSlots.len:
        if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[i]):
            continue
        let slotSize = PrimaryBodyIrLocalFrameFootprint(bodyIR.localSlots[i])
        if slotSize <= 8:
            continue
        var align = bodyIR.localSlots[i].alignBytes
        if align <= 0:
            align = 1
        if align > 16:
            align = 16
        offset = ((offset + align - 1) / align) * align
        PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, i)
        bodyIR.localSlots[i].stackOffset = offset
        offset = offset + slotSize

@borrows
fn PrimaryBodyIrDefaultSlotSizeBytes(typeKind: int32): int32 =
    if typeKind == coreir.LocalI32Tag:
        return 4
    if typeKind == coreir.LocalI64Tag ||
       typeKind == coreir.LocalF64Tag ||
       typeKind == coreir.LocalPtrTag:
        return 8
    if typeKind == coreir.LocalStrTag:
        return 24
    if typeKind == coreir.LocalAggregateTag:
        return coreir.ResultStrSizeBytes
    return 0

@borrows
fn PrimaryBodyIrDefaultSlotAlignBytes(typeKind: int32): int32 =
    if typeKind == coreir.LocalI32Tag:
        return 4
    if typeKind == coreir.LocalI64Tag ||
       typeKind == coreir.LocalF64Tag ||
       typeKind == coreir.LocalPtrTag:
        return 8
    if typeKind == coreir.LocalStrTag:
        return 8
    if typeKind == coreir.LocalAggregateTag:
        # 地板是 8 不是 16: 聚合槽拷贝走 8 字节缩放装载(见 Normalize 注释),
        # 只需 8 对齐栈偏移; 用 ResultStrAlignBytes(16) 是把未知布局兜底形状
        # 误当全体聚合对齐地板, 真实 align≤8 的类型会被 canonical ingress 拒。
        return 8
    return 0

@borrows
fn PrimaryBodyIrNormalizeSlotSizeBytes(typeKind: int32, sizeBytes: int32): int32 =
    let defaultSize = PrimaryBodyIrDefaultSlotSizeBytes(typeKind)
    if sizeBytes <= 0:
        return defaultSize
    if typeKind != coreir.LocalAggregateTag && defaultSize > 0 && sizeBytes < defaultSize:
        return defaultSize
    return sizeBytes

# Aggregate slots are copied with 8-byte scaled loads (sret return copy,
# slot-to-slot copies), whose encodings require 8-aligned stack offsets, so
# the per-type alignment (e.g. FixedBytes32 align 1) is only a lower bound.
@borrows
fn PrimaryBodyIrNormalizeSlotAlignBytes(typeKind: int32, alignBytes: int32): int32 =
    let defaultAlign = PrimaryBodyIrDefaultSlotAlignBytes(typeKind)
    if alignBytes <= 0:
        return defaultAlign
    if defaultAlign > 0 && alignBytes < defaultAlign:
        return defaultAlign
    return alignBytes

@borrows
fn PrimaryBodyIrNodeResultTypeText(typedIr: texpr.TypedExprIr, nodeIndex: int32): str =
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return ""
    let resultTypeRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                             typedIr.nodes2_resultTypeIds[nodeIndex])
    if IsOk(resultTypeRes):
        return Value(resultTypeRes)
    return ""

@borrows
fn PrimaryBodyIrScalarRetypeKind(kind: int32): bool =
    return kind == coreir.LocalI32Tag ||
           kind == coreir.LocalI64Tag ||
           kind == coreir.LocalF64Tag

@borrows
fn PrimaryBodyIrRetypeLocalScalarSlotForType(bodyIR: var coreir.BodyIR,
                                             typedIr: texpr.TypedExprIr,
                                             sourcePath: str,
                                             slotId: int32,
                                             typeRaw: str): bool =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return false
    var desiredKind: int32
    var desiredSize: int32
    var desiredAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, typeRaw, desiredKind, desiredSize, desiredAlign)
    if !PrimaryBodyIrScalarRetypeKind(desiredKind) && desiredKind != coreir.LocalStrTag:
        return false
    if bodyIR.localSlots[slotId].stackOffset < 0:
        return false
    if !PrimaryBodyIrScalarRetypeKind(bodyIR.localSlots[slotId].typeKind):
        return false
    if bodyIR.localSlots[slotId].typeKind == desiredKind:
        return true
    PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, slotId)
    var slot = bodyIR.localSlots[slotId]
    slot.typeKind = desiredKind
    slot.sizeBytes = PrimaryBodyIrNormalizeSlotSizeBytes(desiredKind, desiredSize)
    slot.alignBytes = PrimaryBodyIrNormalizeSlotAlignBytes(desiredKind, desiredAlign)
    slot.auxValue = 0
    bodyIR.localSlots[slotId] = slot
    primarySlotElementWriteBackCheck(bodyIR, slotId, "retype_scalar_slot", 4411)
    PrimaryBodyIrReflowLocalStackOffsets(bodyIR)
    return true

@borrows
fn PrimaryBodyIrLocalSlotNewSized(bodyIR: var coreir.BodyIR,
                                   slotId: int32,
                                   name: str,
                                   typeKind: int32,
                                   sizeBytes: int32,
                                   alignBytes: int32) =
    var ls: coreir.LocalSlot
    ls.id = slotId
    ls.name = name
    ls.typeKind = typeKind
    ls.placeKind = coreir.BodyPlaceStackValueTag
    ls.auxValue = 0
    ls.ownership = coreir.OwnPlainTag
    ls.aliasClass = coreir.AliasUnknownTag
    ls.escapeKind = coreir.EscapeNoneTag
    ls.noAlias = false
    coreir.BodyIRApplyLocalSlotDefaultProof(ls)
    if typeKind == coreir.LocalI32Tag:
        ls.sizeBytes = 4
        ls.alignBytes = 4
    elif typeKind == coreir.LocalI64Tag:
        ls.sizeBytes = 8
        ls.alignBytes = 8
    elif typeKind == coreir.LocalF64Tag:
        ls.sizeBytes = 8
        ls.alignBytes = 8
    elif typeKind == coreir.LocalStrTag:
        ls.sizeBytes = 24
        ls.alignBytes = 8
    elif typeKind == coreir.LocalPtrTag:
        ls.sizeBytes = 8
        ls.alignBytes = 8
    elif typeKind == coreir.LocalAggregateTag:
        ls.sizeBytes = coreir.ResultStrSizeBytes
        ls.alignBytes = coreir.ResultStrAlignBytes
    let desiredSize = PrimaryBodyIrNormalizeSlotSizeBytes(typeKind, sizeBytes)
    let desiredAlign = PrimaryBodyIrNormalizeSlotAlignBytes(typeKind, alignBytes)
    if desiredSize > 0:
        ls.sizeBytes = desiredSize
    if desiredAlign > 0:
        ls.alignBytes = desiredAlign
    ls.stackOffset = PrimaryBodyIrNextLocalStackOffset(bodyIR, ls.sizeBytes, ls.alignBytes)
    # [bodyir-ownership-wall] R4a 扩容完整性检查（只读）：区分"老行在扩容途中被打坏"与"新行没写好"。
    # cap 策略已**静态确认** = cheng_seq_next_cap_calc（program_support_backend.cheng:7144-7155，
    # 自 4 起倍增）⇒ 扩容追加点 = 索引 4/8/16/32。append **前后各扫一次全表身份**：
    #   phase=pre_growth  ⇒ 本次扩容之前表已坏（该次扩容被排除，坏点在其之前）；
    #   phase=post_growth ⇒ 坏行数在本次扩容后出现/增多（扩容路径可疑：rc>1 分支为
    #                       malloc + copy(min(old,new)) + release 旧块，见 program_support_backend.cheng:6221-6236）。
    var primarySlotGrowthCapBefore = bodyIR.localSlots.cap
    var primarySlotGrowthWillGrow = bodyIR.localSlots.len == bodyIR.localSlots.cap
    var primarySlotGrowthBadBefore: int32
    if primarySlotGrowthWillGrow:
        for primaryGrowthPreIndex in 0..<bodyIR.localSlots.len:
            if bodyIR.localSlots[primaryGrowthPreIndex].id != primaryGrowthPreIndex:
                primarySlotGrowthBadBefore = primarySlotGrowthBadBefore + 1
    add(bodyIR.localSlots, ls)
    coreir.BodyIRAppendUnboundLocalBindingValueDefinitionRow(
        bodyIR, slotId)
    # [bodyir-ownership-wall] 槽元素落地回读守卫（诊断，只读）：追加记账执行了、
    # 元素字节是否真的落进活缓冲。健康编译恒假（len/id/tk/name 四项全等），
    # 只有已经坏掉时才 hard-fail；不写任何 body 字段、不改数据流。
    var primarySlotElementStoreLostDetail = ""
    if bodyIR.localSlots.len != slotId + 1 ||
       slotId < 0 || slotId >= bodyIR.localSlots.len:
        primarySlotElementStoreLostDetail = Fmt"len={bodyIR.localSlots.len} cap={bodyIR.localSlots.cap}"
    else:
        let primaryStoredSlot = bodyIR.localSlots[slotId]
        if primaryStoredSlot.id != slotId ||
           primaryStoredSlot.typeKind != typeKind ||
           len(primaryStoredSlot.name) != len(name):
            primarySlotElementStoreLostDetail = Fmt"len={bodyIR.localSlots.len} cap={bodyIR.localSlots.cap} id={primaryStoredSlot.id} tk={Int32(primaryStoredSlot.typeKind)} name={primaryStoredSlot.name}"
    if len(primarySlotElementStoreLostDetail) > 0:
        panic(Fmt"primary slot element store lost slot={slotId} {primarySlotElementStoreLostDetail}")
    # [bodyir-ownership-wall] R4a 后半：仅在本次追加触顶扩容时检查（判词带 grown_from/grown_to）
    if primarySlotGrowthWillGrow:
        var primarySlotGrowthBadAfter: int32
        var primarySlotGrowthFirstBad: int32 = -1
        for primaryGrowthPostIndex in 0..<bodyIR.localSlots.len:
            if bodyIR.localSlots[primaryGrowthPostIndex].id != primaryGrowthPostIndex:
                primarySlotGrowthBadAfter = primarySlotGrowthBadAfter + 1
                if primarySlotGrowthFirstBad < 0:
                    primarySlotGrowthFirstBad = primaryGrowthPostIndex
        if primarySlotGrowthBadBefore > 0 || primarySlotGrowthBadAfter > 0:
            var primarySlotGrowthPhase = "post_growth"
            if primarySlotGrowthBadBefore > 0:
                primarySlotGrowthPhase = "pre_growth"
            if primarySlotGrowthFirstBad >= 0:
                panic(Fmt"primary slot table corrupted across growth phase={primarySlotGrowthPhase} appended={slotId} grown_from={primarySlotGrowthCapBefore} grown_to={bodyIR.localSlots.cap} bad_before={primarySlotGrowthBadBefore} bad_after={primarySlotGrowthBadAfter} index={primarySlotGrowthFirstBad} id={bodyIR.localSlots[primarySlotGrowthFirstBad].id} tk={Int32(bodyIR.localSlots[primarySlotGrowthFirstBad].typeKind)} name={bodyIR.localSlots[primarySlotGrowthFirstBad].name} len={bodyIR.localSlots.len} cap={bodyIR.localSlots.cap}")
            panic(Fmt"primary slot table corrupted across growth phase={primarySlotGrowthPhase} appended={slotId} grown_from={primarySlotGrowthCapBefore} grown_to={bodyIR.localSlots.cap} bad_before={primarySlotGrowthBadBefore} bad_after={primarySlotGrowthBadAfter} len={bodyIR.localSlots.len} cap={bodyIR.localSlots.cap}")

@borrows
fn PrimaryBodyIrLocalSlotNew(bodyIR: var coreir.BodyIR,
                              slotId: int32,
                              name: str,
                              typeKind: int32) =
    PrimaryBodyIrLocalSlotNewSized(bodyIR, slotId, name, typeKind, 0, 0)

@borrows
fn PrimaryBodyIrTypeKindFromText(typeRaw: str): int32 =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if PrimaryStartsWith(normType, "var"):
        return coreir.LocalPtrTag
    if PrimaryStartsWith(normType, "ref"):
        return coreir.LocalPtrTag
    if len(normType) > 0 && normType[len(normType) - 1] == '*':
        return coreir.LocalPtrTag
    if normType == "int64" || normType == "uint64" || normType == "u64" || normType == "i64":
        return coreir.LocalI64Tag
    if normType == "float64" || normType == "f64":
        return coreir.LocalF64Tag
    if normType == "str":
        return coreir.LocalStrTag
    if normType == "cstring" || normType == "ptr" || normType == "void*":
        return coreir.LocalPtrTag
    if normType == "Bytes" ||
       normType == "bytes.Bytes" ||
       normType == "rawbytes.Bytes" ||
       normType == "ByteBuffer" ||
       normType == "GrowByteBuffer" ||
       normType == "buffer.GrowByteBuffer":
        return coreir.LocalAggregateTag
    if PrimaryStartsWith(normType, "Result["):
        return coreir.LocalAggregateTag
    # Option[T] = { has: bool@0; value: T } builtin generic aggregate. Without
    # this branch the `Option`-leaf (uppercase first char) falls to the
    # LocalPtrTag default below, so a local `var opt: Option[Inner]` is minted
    # as an 8-byte pointer slot and the `.has` read derefs struct content ->
    # SIGSEGV/SIGBUS. Mirror the Result[ aggregate classification; also accept
    # the module-qualified `<mod>.Option[Inner]` binding text (import std/option).
    # Top-level token search keeps nested generics (`Foo[option.Option[X]]`) out.
    if PrimaryStartsWith(normType, "Option["):
        return coreir.LocalAggregateTag
    if len(normType) > 0 &&
       normType[len(normType) - 1] == ']' &&
       texpr.TypedExprFindTopLevelTextToken(normType, ".Option[") >= 0:
        return coreir.LocalAggregateTag
    if PrimaryStartsWith(normType, "seq[") ||
       (len(normType) >= 2 && strings.SliceBytes(normType, len(normType) - 2, 2) == "[]"):
        return coreir.LocalAggregateTag
    if len(normType) > 0:
        var leafStart = 0
        for ci in 0..<len(normType):
            if normType[ci] == '.':
                leafStart = ci + 1
        let firstCh = normType[leafStart]
        if firstCh >= 'A':
            if firstCh <= 'Z':
                return coreir.LocalPtrTag
    return coreir.LocalI32Tag

@borrows
fn PrimaryBodyIrPointeeTypeText(typeRaw: str): str =
    let typeText = texpr.TypedExprStripVarType(typeRaw)
    if typeText == "":
        return ""
    if len(typeText) > 0 && typeText[len(typeText) - 1] == '*':
        return strutil.Strip(strings.SliceBytes(typeText, 0, len(typeText) - 1))
    var primaryColdCond1: bool
    var primaryColdCond1Clause0: bool
    if len(typeText) > 3:
        if strings.SliceBytes(typeText, 0, 3) == "ref":
            if typeText[3] >= 'A':
                if typeText[3] <= 'Z':
                    primaryColdCond1Clause0 = true
    if primaryColdCond1Clause0:
        primaryColdCond1 = true
    if primaryColdCond1:
        return strutil.Strip(strings.SliceBytes(typeText, 3, len(typeText) - 3))
    return ""

@borrows
fn PrimaryBodyIrPointeeTypeTextForSource(typedIr: texpr.TypedExprIr,
                                          sourcePath: str,
                                          typeRaw: str): str =
    let aliasTarget = texpr.TypedExprIrLookupTypeDefAliasTargetType(typedIr,
                                                                    sourcePath,
                                                                    typeRaw)
    if aliasTarget != "":
        let aliasPointee = PrimaryBodyIrPointeeTypeText(aliasTarget)
        if aliasPointee != "":
            return aliasPointee
    return PrimaryBodyIrPointeeTypeText(typeRaw)

@borrows
fn PrimaryBodyIrFixedArrayLengthFromText(typedIr: texpr.TypedExprIr,
                                         sourcePath: str,
                                         countRaw: str): int32 =
    let countText = strutil.Strip(countRaw)
    if countText == "":
        return 0
    var visitedOwners: str[]
    var visitedNames: str[]
    var recognized: bool
    var constValue: int64
    if !texpr.TypedExprIrCallConstIntValue(
            typedIr,
                                         sourcePath,
                                         countText,
                                         visitedOwners,
                                         visitedNames,
                                         recognized,
                                         constValue):
        if recognized:
            panic(Fmt"primary object: invalid fixed-array dimension source={sourcePath} expr={countText}")
        return 0
    if constValue <= 0 || constValue > Int64(2147483647):
        panic(Fmt"primary object: fixed-array dimension out of range source={sourcePath} expr={countText}")
    if visitedOwners.len != 0 || visitedNames.len != 0:
        panic("primary object: fixed-array const evaluator leaked visited identities")
    return Int32(constValue)

type
    PrimaryBodyIrTypeShapeContext =
        activeSourcePaths: str[]
        activeTypes: str[]

@borrows
fn PrimaryBodyIrFixedArrayShapeFromText(typedIr: texpr.TypedExprIr,
                                        sourcePath: str,
                                        typeRaw: str,
                                        context: var PrimaryBodyIrTypeShapeContext,
                                        sizeBytes: var int32,
                                        alignBytes: var int32): bool =
    sizeBytes = 0
    alignBytes = 0
    let typeText = texpr.TypedExprNormalizeTypeText(typeRaw)
    if typeText == "" ||
       PrimaryStartsWith(typeText, "seq[") ||
       PrimaryStartsWith(typeText, "array[") ||
       PrimaryStartsWith(typeText, "Result["):
        return false
    if len(typeText) < 4 || typeText[len(typeText) - 1] != ']':
        return false
    let openPos = parser.ParserFindText(typeText, "[")
    if openPos <= 0:
        return false
    let elemType = strings.SliceBytes(typeText, 0, openPos)
    var elemKind: int32
    var elemSize: int32
    var elemAlign: int32
    PrimaryBodyIrTypeShapeFromTextWithContext(typedIr,
                                              sourcePath,
                                              elemType,
                                              context,
                                              elemKind,
                                              elemSize,
                                              elemAlign)
    if elemSize <= 0:
        return false
    if elemAlign <= 0:
        return false
    # Multi-dimensional fixed arrays `T[d0][d1]...` lay out row-major as one
    # flat block of (d0*d1*...) elements. Walk every `[N]` group and accumulate
    # the product so the slot size (and thus the zero-init fill) covers all
    # cells. A single group reduces to the 1-D case.
    var total: int64
    total = Int64(1)
    var groupCount: int32
    groupCount = 0
    var pos = openPos
    while pos < len(typeText):
        if typeText[pos] != '[':
            return false
        var closePos: int32
        closePos = -1
        for j in pos..<len(typeText):
            if typeText[j] == ']':
                closePos = j
                break
        if closePos < 0:
            return false
        let countText = strutil.Strip(strings.SliceBytes(typeText, pos + 1, closePos - pos - 1))
        let count = PrimaryBodyIrFixedArrayLengthFromText(typedIr, sourcePath, countText)
        if count <= 0:
            return false
        if total > Int64(9223372036854775807) / Int64(count):
            panic(Fmt"primary object: fixed-array dimension product overflow source={sourcePath} type={typeText}")
        total = total * Int64(count)
        groupCount = groupCount + 1
        pos = closePos + 1
    if groupCount <= 0:
        return false
    if total > Int64(9223372036854775807) / Int64(elemSize):
        panic(Fmt"primary object: fixed-array byte size overflow source={sourcePath} type={typeText}")
    let rawSize = Int64(elemSize) * total
    if rawSize <= 0 ||
       rawSize > Int64(2147483647) - Int64(elemAlign - 1):
        panic(Fmt"primary object: fixed-array byte size overflow source={sourcePath} type={typeText}")
    sizeBytes = PrimaryBodyIrAlignedOffset(Int32(rawSize), elemAlign)
    alignBytes = elemAlign
    return true

@borrows
fn PrimaryBodyIrTypeTextIsGenericPointer(typeRaw: str): bool =
    let typeText = texpr.TypedExprNormalizeTypeText(typeRaw)
    if typeText == "ptr":
        return true
    if typeText == "void*":
        return true
    return false

# Option[T] = { has: bool@0; value: T@align(1,alignT) } builtin generic aggregate
# shape. Split out of PrimaryBodyIrTypeShapeFromTextImpl to keep that large
# function's frame small. Accepts both the bare `Option[Inner]` text and the
# module-qualified `<mod>.Option[Inner]` form (import std/option records the
# binding type qualified). Returns true and fills the shape when the inner
# shape resolves; false otherwise. Layout mirrors the front-end
# TypedExprTypeLayoutImpl Option handler byte-for-byte (has flag first, value
# aligned to its own alignment, whole struct aligned to the value's).
@borrows
fn PrimaryBodyIrOptionShapeFromText(typedIr: texpr.TypedExprIr,
                                    sourcePath: str,
                                    normType: str,
                                    context: var PrimaryBodyIrTypeShapeContext,
                                    typeKind: var int32,
                                    sizeBytes: var int32,
                                    alignBytes: var int32): bool =
    var optionType = normType
    if !PrimaryStartsWith(optionType, "Option["):
        let optionDotPos = texpr.TypedExprFindTopLevelTextToken(optionType, ".Option[")
        if optionDotPos < 0:
            return false
        optionType = strings.SliceBytes(optionType,
                                        optionDotPos + 1,
                                        len(optionType) - optionDotPos - 1)
    if len(optionType) <= 8:
        return false
    if strings.SliceBytes(optionType, len(optionType) - 1, 1) != "]":
        return false
    let optInner = strings.SliceBytes(optionType, 7, len(optionType) - 8)
    var optValueKind: int32
    var optValueSize: int32
    var optValueAlign: int32
    PrimaryBodyIrTypeShapeFromTextWithContext(typedIr,
                                              sourcePath,
                                              optInner,
                                              context,
                                              optValueKind,
                                              optValueSize,
                                              optValueAlign)
    if optValueSize <= 0:
        return false
    if optValueAlign <= 0:
        return false
    let optValueOffset = PrimaryBodyIrAlignedOffset(1, optValueAlign)
    typeKind = coreir.LocalAggregateTag
    sizeBytes = PrimaryBodyIrAlignedOffset(optValueOffset + optValueSize, optValueAlign)
    alignBytes = optValueAlign
    return true

# `None[T]()` is a generic function call whose value is exactly the zero
# representation of `Option[T]`. Aggregate-constructor materialization sees
# raw surface text, so the explicit type argument keeps the call head from
# matching the generic `None` function record and used to misclassify it as a
# type constructor named `None[T]`. Recognize only the exact zero-argument
# shape with an exactly matching Option inner type; all other calls retain the
# normal resolver/poison-on-miss path.
@borrows
fn PrimaryBodyIrIsExactOptionNoneConstruct(callHeadRaw: str,
                                            callArgsRaw: str,
                                            expectedTypeRaw: str): bool =
    if strutil.Strip(callArgsRaw) != "":
        return false
    var callHead = texpr.TypedExprNormalizeTypeText(callHeadRaw)
    if !PrimaryStartsWith(callHead, "None["):
        let noneDotPos = texpr.TypedExprFindTopLevelTextToken(callHead, ".None[")
        if noneDotPos < 0:
            return false
        callHead = strings.SliceBytes(callHead,
                                      noneDotPos + 1,
                                      len(callHead) - noneDotPos - 1)
    var expectedType = texpr.TypedExprNormalizeTypeText(expectedTypeRaw)
    if !PrimaryStartsWith(expectedType, "Option["):
        let optionDotPos = texpr.TypedExprFindTopLevelTextToken(expectedType, ".Option[")
        if optionDotPos < 0:
            return false
        expectedType = strings.SliceBytes(expectedType,
                                          optionDotPos + 1,
                                          len(expectedType) - optionDotPos - 1)
    if len(callHead) <= 6 || callHead[len(callHead) - 1] != ']':
        return false
    if len(expectedType) <= 8 || expectedType[len(expectedType) - 1] != ']':
        return false
    let noneInner = texpr.TypedExprNormalizeTypeText(strings.SliceBytes(callHead,
                                                                        5,
                                                                        len(callHead) - 6))
    let optionInner = texpr.TypedExprNormalizeTypeText(strings.SliceBytes(expectedType,
                                                                          7,
                                                                          len(expectedType) - 8))
    return noneInner != "" && noneInner == optionInner

@borrows
fn PrimaryBodyIrTypeShapeFromText(typedIr: texpr.TypedExprIr,
                                   sourcePath: str,
                                   typeRaw: str,
                                   typeKind: var int32,
                                   sizeBytes: var int32,
                                   alignBytes: var int32) =
    var context: PrimaryBodyIrTypeShapeContext
    PrimaryBodyIrTypeShapeFromTextWithContext(typedIr,
                                              sourcePath,
                                              typeRaw,
                                              context,
                                              typeKind,
                                              sizeBytes,
                                              alignBytes)
    if context.activeSourcePaths.len != 0 || context.activeTypes.len != 0:
        panic("primary object: type-shape context leaked active identities")

@borrows
fn PrimaryBodyIrTypeShapeFromTextWithContext(typedIr: texpr.TypedExprIr,
                                             sourcePath: str,
                                             typeRaw: str,
                                             context: var PrimaryBodyIrTypeShapeContext,
                                             typeKind: var int32,
                                             sizeBytes: var int32,
                                             alignBytes: var int32) =
    let normalizedType = texpr.TypedExprNormalizeTypeText(typeRaw)
    for activeIndex in 0..<context.activeTypes.len:
        if context.activeTypes[activeIndex] == normalizedType &&
           PrimaryPathNormalizedEquals(context.activeSourcePaths[activeIndex],
                                       sourcePath):
            os.WriteLine(os.GetStderr(), strutil.Join([
                "phase=recursion_cycle helper=type_shape text=",
                strings.CloneStr(typeRaw),
                " source=",
                strings.CloneStr(sourcePath)
            ], ""))
            typeKind = coreir.LocalInvalidTag
            sizeBytes = 0
            alignBytes = 0
            return
    add(context.activeSourcePaths, strings.CloneStr(sourcePath))
    add(context.activeTypes, normalizedType)
    PrimaryBodyIrTypeShapeFromTextImpl(typedIr,
                                       sourcePath,
                                       typeRaw,
                                       context,
                                       typeKind,
                                       sizeBytes,
                                       alignBytes)
    setLen(context.activeSourcePaths, context.activeSourcePaths.len - 1)
    setLen(context.activeTypes, context.activeTypes.len - 1)

@borrows
fn PrimaryBodyIrTypeShapeFromTextImpl(typedIr: texpr.TypedExprIr,
                                      sourcePath: str,
                                      typeRaw: str,
                                      context: var PrimaryBodyIrTypeShapeContext,
                                      typeKind: var int32,
                                      sizeBytes: var int32,
                                      alignBytes: var int32) =
    typeKind = PrimaryBodyIrTypeKindFromText(typeRaw)
    sizeBytes = 0
    alignBytes = 0
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if normType == "uint8" || normType == "int8" || normType == "u8" || normType == "i8":
        typeKind = coreir.LocalI32Tag
        sizeBytes = 1
        alignBytes = 1
        return
    if normType == "uint16" || normType == "int16" || normType == "u16" || normType == "i16":
        typeKind = coreir.LocalI32Tag
        sizeBytes = 2
        alignBytes = 2
        return
    if normType == "bool" || normType == "int32" || normType == "i32":
        typeKind = coreir.LocalI32Tag
        sizeBytes = 4
        alignBytes = 4
        return
    if normType == "int64" || normType == "uint64" || normType == "u64" || normType == "i64":
        typeKind = coreir.LocalI64Tag
        sizeBytes = 8
        alignBytes = 8
        return
    # f64 shape mirror of the i64 branch above. TypeKindFromText already maps
    # float64/f64 -> LocalF64Tag, but without this branch sizeBytes/alignBytes
    # stay 0, so any field-read scalar resolver that probes a float64 field via
    # TypeShapeFromText (ConditionFieldOperandSlot direct `root.field` path)
    # rejects it on `fieldSize <= 0` and the cast-arm f64 rescue can't mint the
    # arg slot -> bail=803 on `out = int64(node.f)` direct field reads. The
    # indexed-field path (node.ovalues[i].f) sizes f64 through
    # SeqElementShapeFromText, which is why the indexed form clears.
    if normType == "float64" || normType == "f64":
        typeKind = coreir.LocalF64Tag
        sizeBytes = 8
        alignBytes = 8
        return
    if normType == "str":
        typeKind = coreir.LocalStrTag
        sizeBytes = 24
        alignBytes = 8
        return
    if normType == "FixedBytes32" || normType == "layout.FixedBytes32" || normType == "bytes_layout.FixedBytes32":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 32
        alignBytes = 1
        return
    if normType == "FixedBytes64" || normType == "layout.FixedBytes64" || normType == "bytes_layout.FixedBytes64":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 64
        alignBytes = 1
        return
    if normType == "FixedBytes65" || normType == "layout.FixedBytes65" || normType == "bytes_layout.FixedBytes65":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 65
        alignBytes = 1
        return
    if normType == "ErrorInfo":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 32
        alignBytes = 8
        return
    # Arena / ArenaArrayInt32 cross-module nested layout still needs explicit
    # registration. TypedExprFactTable is different: its live Cheng type is the
    # unique layout source, so schema growth cannot silently stale this branch.
    if normType == "Arena" || normType == "arenamod.Arena" || normType == "arena.Arena":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 24
        alignBytes = 8
        return
    if normType == "ArenaArrayInt32" || normType == "arenamod.ArenaArrayInt32" ||
       normType == "arena.ArenaArrayInt32":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 16
        alignBytes = 4
        return
    if normType == "TypedExprFactTable" || normType == "texpr.TypedExprFactTable" ||
       normType == "typed_expr.TypedExprFactTable":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = Int32(sizeof(texpr.TypedExprFactTable))
        alignBytes = 8
        return
    if normType == "NormalizedExprLookup" || normType == "parser.NormalizedExprLookup":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 32
        alignBytes = 8
        return
    if normType == "NormalizedExprLayer" || normType == "parser.NormalizedExprLayer":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 80
        alignBytes = 8
        return
    if normType == "SystemLinkPlanStub" || normType == "slplan.SystemLinkPlanStub" || normType == "system_link_plan.SystemLinkPlanStub":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 744
        alignBytes = 8
        return
    if normType == "cstring" || normType == "owned_cstring" ||
       normType == "ptr" || normType == "void*":
        typeKind = coreir.LocalPtrTag
        sizeBytes = 8
        alignBytes = 8
        return
    # bigint.BigInt cross-module: {count: int32(4) + limbs: int32[256](1024)} = 1028.
    # Layout registered only in bigint.cheng sourcePath-scoped table, so cross-module
    # callers (rsa.cheng) can't resolve via TypeShapeFromText. Hard-code like ErrorInfo.
    if normType == "BigInt" || normType == "bigint.BigInt":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 1028
        alignBytes = 4
        return
    # p256_fixed.P256Fixed cross-module: {limbs: int32[8]} = 32 bytes.
    if normType == "P256Fixed" || normType == "p256_fixed.P256Fixed" ||
       normType == "pfix.P256Fixed":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 32
        alignBytes = 4
        return
    # ecnist.EcPointFixed cross-module: {x: P256Fixed(32) + y: P256Fixed(32) + inf: bool(4)} = 68.
    if normType == "EcPointFixed" || normType == "ecnist.EcPointFixed":
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 68
        alignBytes = 4
        return
    # Function-pointer types (`fn(...)`) — directly or as an alias target like
    # `IoMeterHook = fn(...)` — lower to a raw 8-byte code pointer. Without this
    # the `fn(`-leaf recurses to the lowercase-leaf default (I32, size 0) and
    # truncates the slot, so `hook == nil` probes mis-classify the value side.
    if texpr.TypedExprTypeTextIsFnPtr(normType):
        typeKind = coreir.LocalPtrTag
        sizeBytes = 8
        alignBytes = 8
        return
    var shapeAliasTarget = texpr.TypedExprIrLookupTypeDefAliasTargetType(typedIr,
                                                                         sourcePath,
                                                                         normType)
    if shapeAliasTarget == "" &&
       texpr.TypedExprQualifiedCallDot(normType) >= 0 &&
       !PrimaryStartsWith(normType, "seq[") &&
       !PrimaryStartsWith(normType, "array[") &&
       !PrimaryStartsWith(normType, "Result[") &&
       !(len(normType) >= 2 && strings.SliceBytes(normType, len(normType) - 2, 2) == "[]"):
        # 限定标量 typedef（如 langintern.InternId = int32）：别名表按未限定 leaf
        # 建键，但 lookup 内部 ParserIdentPrefix 把限定名截到限定符（"langintern"）
        # 而 miss，导致大写-leaf 标量 typedef 默认落 8 字节指针。限定全名 miss 时按
        # 限定 leaf 重试，使其归一到底层标量。seq/array/Result 形不走此回退（由后续
        # 分支按聚合定形），避免 InternId[] 被误折成 int32。
        let shapeAliasLeaf = texpr.TypedExprQualifiedCallLeaf(normType)
        if shapeAliasLeaf != "" && shapeAliasLeaf != normType:
            shapeAliasTarget = texpr.TypedExprIrLookupTypeDefAliasTargetType(typedIr,
                                                                             sourcePath,
                                                                             shapeAliasLeaf)
    # Dynamic seq (`T[]`), `seq[...]`, fixed `array[...]`, and `Result[...]`
    # forms are shaped by their own branches below, never by the element/alias
    # target. The alias lookup strips the `[]` suffix and resolves the element
    # name (e.g. `TypedExprFact[]` → `texpr.TypedExprFact`), so without this
    # guard a seq-of-alias field would be mis-shaped as the bare element (8B for
    # a cross-module struct alias) instead of the 16B seq header — collapsing
    # `csg.typedExprFacts.len` (header off0 w4) at the node path. Mirrors the
    # qualified-leaf retry guard above.
    var shapeNormIsSeqLike: bool
    if PrimaryStartsWith(normType, "seq[") ||
       PrimaryStartsWith(normType, "array[") ||
       PrimaryStartsWith(normType, "Result[") ||
       (len(normType) >= 2 && strings.SliceBytes(normType, len(normType) - 2, 2) == "[]"):
        shapeNormIsSeqLike = true
    if !shapeNormIsSeqLike &&
       shapeAliasTarget != "" &&
       texpr.TypedExprNormalizeTypeText(shapeAliasTarget) != normType:
        # Type alias (e.g. File = ptr): shape by the alias target, or an
        # 8-byte pointer would be classified as an aggregate and loaded
        # with the wrong width. Pointer-target aliases (T = U *) are
        # always pointer-shaped.
        if PrimaryBodyIrPointeeTypeText(shapeAliasTarget) != "":
            typeKind = coreir.LocalPtrTag
            sizeBytes = 8
            alignBytes = 8
            return
        # `Name = ref` / `ref object` / `ref Other` 声明在解析期同时落入 ref-object
        # 注册表和 typedef-alias 表(别名目标文本恒为 `ref`...)。此处通用别名整形
        # 分支先于下方 line~2739 的权威 ref 判定触发,会把字面串 `ref` 递归整形为
        # size 0,使 Result[<ref>] 的 Ok/Err 构造布局门失败而落 result_construct 缺口。
        # 命名 ref 句柄恒为 8 字节指针:在递归前按 ref 注册表如实定形。
        if texpr.TypedExprIrTypeIsRef(typedIr, sourcePath, typeRaw):
            typeKind = coreir.LocalPtrTag
            sizeBytes = 8
            alignBytes = 8
            return
        let shapeAliasNorm = texpr.TypedExprNormalizeTypeText(shapeAliasTarget)
        var shapeIsVarOrPtrType: bool
        if PrimaryStartsWith(normType, "var"):
            shapeIsVarOrPtrType = true
        elif len(normType) > 0:
            if normType[len(normType) - 1] == '*':
                shapeIsVarOrPtrType = true
        if !shapeIsVarOrPtrType &&
           (texpr.TypedExprIrTypeIsEnum(typedIr, sourcePath, typeRaw) ||
            shapeAliasNorm == "enum" ||
            PrimaryStartsWith(shapeAliasNorm, "enum ")):
            typeKind = coreir.LocalI32Tag
            sizeBytes = 4
            alignBytes = 4
            return
        PrimaryBodyIrTypeShapeFromTextWithContext(typedIr,
                                                  sourcePath,
                                                  shapeAliasTarget,
                                                  context,
                                                  typeKind,
                                                  sizeBytes,
                                                  alignBytes)
        return
    var fixedArraySize: int32
    var fixedArrayAlign: int32
    if PrimaryBodyIrFixedArrayShapeFromText(typedIr,
                                           sourcePath,
                                           normType,
                                           context,
                                           fixedArraySize,
                                           fixedArrayAlign):
        typeKind = coreir.LocalAggregateTag
        sizeBytes = fixedArraySize
        alignBytes = fixedArrayAlign
        return
    # Anonymous tuple literal `array<name:type,...>`:非 seq 形(用 <>),非命名类型 →
    # 布局注册表 miss,sizeBytes 留 0,破坏每个 seq-of-anon-tuple 元素形状门(bail_44)。
    # 解析字段列表按 C 对齐求和(同 Result[..] 规则)。
    if PrimaryStartsWith(normType, "array<") &&
       len(normType) > 7 &&
       normType[len(normType) - 1] == '>':
        var atFType = ""
        var atOff: int32
        var atSize: int32
        var atAlign: int32
        var atWholeSize: int32
        var atWholeAlign: int32
        if PrimaryBodyIrAnonTupleFieldMeta(typedIr, sourcePath, normType, "",
                                           atFType, atOff, atSize, atAlign,
                                           atWholeSize, atWholeAlign) &&
           atWholeSize > 0:
            typeKind = coreir.LocalAggregateTag
            sizeBytes = atWholeSize
            alignBytes = atWholeAlign
            if alignBytes <= 0:
                alignBytes = 8
            return
    if PrimaryStartsWith(normType, "seq[") ||
       (len(normType) >= 2 && strings.SliceBytes(normType, len(normType) - 2, 2) == "[]"):
        typeKind = coreir.LocalAggregateTag
        sizeBytes = 16
        alignBytes = 8
        return
    if PrimaryStartsWith(normType, "Result[") &&
       len(normType) > 8 &&
       strings.SliceBytes(normType, len(normType) - 1, 1) == "]":
        let innerType = strings.SliceBytes(normType, 7, len(normType) - 8)
        var valueKind: int32
        var valueSize: int32
        var valueAlign: int32
        PrimaryBodyIrTypeShapeFromTextWithContext(typedIr,
                                                  sourcePath,
                                                  innerType,
                                                  context,
                                                  valueKind,
                                                  valueSize,
                                                  valueAlign)
        if valueSize <= 0:
            return
        if valueAlign <= 0:
            return
        let valueOffset = PrimaryBodyIrAlignedOffset(1, valueAlign)
        let errOffset = PrimaryBodyIrAlignedOffset(valueOffset + valueSize, 8)
        var resultAlign = valueAlign
        if resultAlign < 8:
            resultAlign = 8
        typeKind = coreir.LocalAggregateTag
        sizeBytes = PrimaryBodyIrAlignedOffset(errOffset + 32, resultAlign)
        alignBytes = resultAlign
        return
    # Option[T] = { has: bool@0; value: T@align(1,alignT) } builtin generic.
    # Sizing is delegated to PrimaryBodyIrOptionShapeFromText (a small sibling
    # helper) so this already-large function's frame does not grow. Byte-
    # consistent with the front-end TypedExprTypeLayoutImpl Option handler so a
    # local `var opt: Option[Inner]` gets a right-sized aggregate slot instead
    # of the size-0 fallthrough.
    if PrimaryBodyIrOptionShapeFromText(typedIr, sourcePath, normType, context,
                                        typeKind, sizeBytes, alignBytes):
        return
    let aliasTarget = texpr.TypedExprIrLookupTypeDefAliasTargetType(typedIr,
                                                                    sourcePath,
                                                                    typeRaw)
    if PrimaryBodyIrPointeeTypeText(aliasTarget) != "":
        typeKind = coreir.LocalPtrTag
        sizeBytes = 8
        alignBytes = 8
        return
    # ref-object types (`Name = ref`, e.g. atomic.I32) are 8-byte pointers.
    # Must precede the layout-registry lookup, which would otherwise inline
    # the ref's pointee struct and load the handle at the wrong width.
    if texpr.TypedExprIrTypeIsRef(typedIr, sourcePath, typeRaw):
        typeKind = coreir.LocalPtrTag
        sizeBytes = 8
        alignBytes = 8
        return
    # named struct types resolve through the typed-ir layout registry
    var layoutSizeBytes: int32
    var layoutAlignBytes: int32
    var layoutFieldCount: int32
    if texpr.TypedExprIrLookupTypeLayout(typedIr,
                                         sourcePath,
                                         normType,
                                         layoutSizeBytes,
                                         layoutAlignBytes,
                                         layoutFieldCount):
        if layoutSizeBytes > 0 && layoutFieldCount > 0:
            typeKind = coreir.LocalAggregateTag
            sizeBytes = layoutSizeBytes
            alignBytes = layoutAlignBytes
            if alignBytes <= 0:
                alignBytes = 8
            return
    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1" &&
       texpr.TypedExprQualifiedTypeDot(normType) > 0:
        let shapeDotPos = texpr.TypedExprQualifiedTypeDot(normType)
        let shapeQualifier = strutil.Strip(strings.SliceBytes(normType, 0, shapeDotPos))
        var shapeImportedSource = ""
        if sourcePath != "":
            let shapeImportState = texpr.TypedExprIrImportAliasTargetState(typedIr,
                                                                           sourcePath,
                                                                           shapeQualifier,
                                                                           shapeImportedSource)
            if shapeImportState == texpr.TypedExprBuildIndexAmbiguous:
                panic(Fmt"primary object: ambiguous type-shape qualifier source={sourcePath} qualifier={shapeQualifier}")
        os.WriteLine(os.GetStderr(), Fmt"phase=type_shape_qualified_miss type={normType} source={sourcePath} qualifier={shapeQualifier} imported_source={shapeImportedSource}")
    # Enum types lower as int32-class scalars; everything else keeps the
    # retired fallthrough (kind from text, size 0, align 8) that downstream
    # aggregate/let-call paths are tuned to.
    var isVarOrPtrType: bool
    if PrimaryStartsWith(normType, "var"):
        isVarOrPtrType = true
    elif len(normType) > 0:
        if normType[len(normType) - 1] == '*':
            isVarOrPtrType = true
    if !isVarOrPtrType && texpr.TypedExprIrTypeIsEnum(typedIr, sourcePath, typeRaw):
        typeKind = coreir.LocalI32Tag
        sizeBytes = 4
        alignBytes = 4
        return
    alignBytes = 8

@borrows
fn PrimaryBodyIrSeqElementShapeFromText(typedIr: texpr.TypedExprIr,
                                         sourcePath: str,
                                         seqTypeRaw: str,
                                         elemKind: var int32,
                                         elemSize: var int32): bool =
    elemKind = coreir.LocalInvalidTag
    elemSize = 0
    let normType = texpr.TypedExprNormalizeTypeText(seqTypeRaw)
    var innerType = ""
    if PrimaryStartsWith(normType, "seq[") &&
       len(normType) > 5 &&
       strings.SliceBytes(normType, len(normType) - 1, 1) == "]":
        innerType = strings.SliceBytes(normType, 4, len(normType) - 5)
    elif len(normType) >= 2 && strings.SliceBytes(normType, len(normType) - 2, 2) == "[]":
        innerType = strings.SliceBytes(normType, 0, len(normType) - 2)
    elif len(normType) >= 4 &&
         strings.SliceBytes(normType, len(normType) - 1, 1) == "]" &&
         !PrimaryStartsWith(normType, "array[") &&
         !PrimaryStartsWith(normType, "Result["):
        let openPos = parser.ParserFindText(normType, "[")
        if openPos > 0:
            let countText = strings.SliceBytes(normType,
                                               openPos + 1,
                                               len(normType) - openPos - 2)
            if strutil.Strip(countText) != "":
                innerType = strings.SliceBytes(normType, 0, openPos)
    if innerType == "":
        return false
    var innerKind: int32
    var innerSize: int32
    var innerAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   innerType,
                                   innerKind,
                                   innerSize,
                                   innerAlign)
    if innerKind == coreir.LocalInvalidTag || innerSize <= 0:
        return false
    # bool values occupy 4-byte local slots, but growable sequence storage is
    # packed and follows elemSize[bool]() == 1. Fixed arrays widen explicitly
    # at their call sites; dynamic sequence consumers must keep this width.
    if texpr.TypedExprNormalizeTypeText(innerType) == "bool":
        innerSize = 1
    elemKind = innerKind
    elemSize = innerSize
    return true

@borrows
fn PrimaryBodyIrIndexedElementTypeText(typeRaw: str): str =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if PrimaryStartsWith(normType, "seq[") &&
       len(normType) > 5 &&
       strings.SliceBytes(normType, len(normType) - 1, 1) == "]":
        return strutil.Strip(strings.SliceBytes(normType, 4, len(normType) - 5))
    if len(normType) >= 2 && strings.SliceBytes(normType, len(normType) - 2, 2) == "[]":
        return strutil.Strip(strings.SliceBytes(normType, 0, len(normType) - 2))
    if len(normType) >= 4 &&
       strings.SliceBytes(normType, len(normType) - 1, 1) == "]" &&
       !PrimaryStartsWith(normType, "array[") &&
       !PrimaryStartsWith(normType, "Result["):
        let openPos = parser.ParserFindText(normType, "[")
        if openPos > 0:
            let countText = strings.SliceBytes(normType,
                                               openPos + 1,
                                               len(normType) - openPos - 2)
            if strutil.Strip(countText) != "":
                return strutil.Strip(strings.SliceBytes(normType, 0, openPos))
    return ""

@borrows
fn PrimaryBodyIrTypeTextIsDynamicSeq(typeRaw: str): bool =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if PrimaryStartsWith(normType, "seq["):
        return true
    if len(normType) >= 2 && strings.SliceBytes(normType, len(normType) - 2, 2) == "[]":
        return true
    return false

@borrows
fn PrimaryBodyIrTypeTextIsVarI32(typeRaw: str): bool =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if !PrimaryStartsWith(normType, "var"):
        return false
    let pointeeType = texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(typeRaw))
    if normType == "varint32":
        return true
    if normType == "vari32":
        return true
    if normType == "varbool":
        return true
    if pointeeType == "int32":
        return true
    if pointeeType == "i32":
        return true
    if pointeeType == "bool":
        return true
    return false

@borrows
fn PrimaryBodyIrVarPointeeTypeKindFromText(typedIr: texpr.TypedExprIr,
                                            sourcePath: str,
                                            typeRaw: str): int32 =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    let pointeeType = texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(typeRaw))
    if normType == "varint32":
        return coreir.LocalI32Tag
    if normType == "vari32":
        return coreir.LocalI32Tag
    if normType == "varbool":
        return coreir.LocalI32Tag
    if pointeeType == "int32":
        return coreir.LocalI32Tag
    if pointeeType == "i32":
        return coreir.LocalI32Tag
    if pointeeType == "bool":
        return coreir.LocalI32Tag
    if normType == "varint64":
        return coreir.LocalI64Tag
    if normType == "vari64":
        return coreir.LocalI64Tag
    if normType == "varuint64":
        return coreir.LocalI64Tag
    if normType == "varu64":
        return coreir.LocalI64Tag
    if pointeeType == "int64":
        return coreir.LocalI64Tag
    if pointeeType == "i64":
        return coreir.LocalI64Tag
    if pointeeType == "uint64":
        return coreir.LocalI64Tag
    if pointeeType == "u64":
        return coreir.LocalI64Tag
    if normType == "varfloat64":
        return coreir.LocalF64Tag
    if normType == "varf64":
        return coreir.LocalF64Tag
    if pointeeType == "float64":
        return coreir.LocalF64Tag
    if pointeeType == "f64":
        return coreir.LocalF64Tag
    if normType == "varstr":
        return coreir.LocalStrTag
    if pointeeType == "str":
        return coreir.LocalStrTag
    # `var <Enum>` 形参：枚举底层即 i32，指向 i32 槽。前置标量映射不识别
    # 具名枚举类型，遂经类型系统判定后归并入 i32 指针指代，使 var-enum
    # 形参的 `out = EnumConst` 经指针写回路径下降（此前静默落 cold）。
    if texpr.TypedExprIrTypeIsEnum(typedIr, sourcePath, typeRaw):
        return coreir.LocalI32Tag
    return coreir.LocalInvalidTag

@borrows
fn PrimaryBodyIrMarkVarPointeeKind(bodyIR: var coreir.BodyIR,
                                    typedIr: texpr.TypedExprIr,
                                    sourcePath: str,
                                    slotId: int32,
                                    typeRaw: str) =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return
    # pointee kind is only consulted for ptr slots (var params); writing it on
    # plain scalar slots collides with the packed bool ABI marker in auxValue
    if bodyIR.localSlots[slotId].typeKind == coreir.LocalAggregateTag:
        # var str 形参槽按源布局建成 Aggregate(24)：补 aux=Str 标记，
        # 使既有 Aggregate+aux=Str+param 地址间接协议可判别。
        let normVarType = texpr.TypedExprNormalizeTypeText(typeRaw)
        if PrimaryStartsWith(normVarType, "var") &&
           PrimaryBodyIrVarPointeeTypeKindFromText(typedIr, sourcePath, typeRaw) == coreir.LocalStrTag:
            PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, slotId)
            bodyIR.localSlots[slotId].auxValue = coreir.LocalStrTag
        return
    if bodyIR.localSlots[slotId].typeKind != coreir.LocalPtrTag:
        return
    let pointeeKind = PrimaryBodyIrVarPointeeTypeKindFromText(typedIr, sourcePath, typeRaw)
    if pointeeKind != coreir.LocalInvalidTag:
        PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, slotId)
        bodyIR.localSlots[slotId].auxValue = pointeeKind

@borrows
fn PrimaryBodyIrVarParamPointeeKind(bodyIR: coreir.BodyIR,
                                     slotId: int32): int32 =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return coreir.LocalInvalidTag
    let slot = bodyIR.localSlots[slotId]
    if slot.typeKind != coreir.LocalPtrTag:
        return coreir.LocalInvalidTag
    if slot.auxValue == coreir.LocalI32Tag ||
       slot.auxValue == coreir.LocalI64Tag ||
       slot.auxValue == coreir.LocalF64Tag ||
       slot.auxValue == coreir.LocalStrTag:
        return slot.auxValue
    return coreir.LocalInvalidTag

@borrows
fn PrimaryBodyIrIntInList(values: int32[], value: int32): bool =
    for i in 0..<values.len:
        if values[i] == value:
            return true
    return false

@borrows
fn PrimaryBodyIrNameInList(names: str[], name: str): bool =
    for i in 0..<names.len:
        if names[i] == name:
            return true
    return false

@borrows
fn PrimaryBodyIrReturnTypeIsVoid(typeRaw: str): bool =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if normType == "":
        return true
    if normType == "void":
        return true
    return false

@borrows
fn PrimaryBodyIrTypeTextIsSeqStr(typeRaw: str): bool =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if normType == "str[]":
        return true
    if normType == "seq[str]":
        return true
    return false

@borrows
fn PrimaryBodyIrCallFullText(stmt: lower.PrimaryObjectIrStatement): str =
    if stmt.callArgCount > 0:
        return Fmt"{stmt.surfaceText}({stmt.callArgsText})"
    return Fmt"{stmt.surfaceText}()"

@borrows
fn PrimaryBodyIrHasSameLineCallForRhs(statements: var lower.PrimaryObjectIrStatement[],
                                       lineNumber: int32,
                                       rhsText: str): bool =
    for scanIndex in 0..<statements.len:
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != lineNumber:
            continue
        if scanStmt.kind != texpr.TypedExprIrStmtCall &&
           scanStmt.kind != texpr.TypedExprIrStmtLetCall &&
           scanStmt.kind != texpr.TypedExprIrStmtIfCall &&
           scanStmt.kind != texpr.TypedExprIrStmtResultIntrinsic:
            continue
        if os.GetEnv("CHENG_PRIMARY_OBJECT_CALL_SURFACE_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=same_line_call_for_rhs line={lineNumber} surface_kind={int32(scanStmt.callSurfaceKind)}")
        if strutil.Strip(scanStmt.surfaceText) == rhsText:
            return true
        if PrimaryBodyIrCallFullText(scanStmt) == rhsText:
            return true
    return false

@borrows
fn PrimaryBodyIrHasSameLineAssignForCallExpr(statements: var lower.PrimaryObjectIrStatement[],
                                              lineNumber: int32,
                                              callExprRaw: str): bool =
    let callExpr = strutil.Strip(callExprRaw)
    if callExpr == "":
        return false
    let openPos = texpr.TypedExprFindWholeCallOpenParen(callExpr)
    if openPos <= 0:
        return false
    let callHead = strutil.Strip(strings.SliceBytes(callExpr, 0, openPos))
    let callTail = PrimaryCallTargetTailName(callHead)
    for scanIndex in 0..<statements.len:
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != lineNumber:
            continue
        if scanStmt.kind != texpr.TypedExprIrStmtAssign:
            continue
        if strutil.Contains(scanStmt.surfaceText, callExpr):
            return true
        if scanStmt.callTarget == callHead ||
           PrimaryCallTargetTailName(scanStmt.callTarget) == callTail:
            if strutil.Contains(scanStmt.surfaceText, callHead):
                return true
            if callTail != "" && strutil.Contains(scanStmt.surfaceText, callTail):
                return true
    return false

@borrows
fn PrimaryBodyIrHasSameLineAssignForCallTarget(statements: var lower.PrimaryObjectIrStatement[],
                                                lineNumber: int32,
                                                callTargetRaw: str,
                                                callArgsRaw: str): bool =
    let callTarget = strutil.Strip(callTargetRaw)
    if callTarget == "":
        return false
    let callTail = PrimaryCallTargetTailName(callTarget)
    let callArgs = strutil.Strip(callArgsRaw)
    for scanIndex in 0..<statements.len:
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != lineNumber:
            continue
        if scanStmt.kind != texpr.TypedExprIrStmtAssign:
            continue
        let scanTargetTail = PrimaryCallTargetTailName(scanStmt.callTarget)
        if scanStmt.callTarget != callTarget &&
           scanTargetTail != callTarget &&
           scanTargetTail != callTail:
            continue
        if callArgs != "" &&
           strutil.Strip(scanStmt.callArgsText) == callArgs:
            return true
        if strutil.Contains(scanStmt.surfaceText, callTarget):
            return true
        if callTail != "" && strutil.Contains(scanStmt.surfaceText, callTail):
            return true
    return false

@borrows
fn PrimaryBodyIrHasSameLineLetCallBinding(statements: var lower.PrimaryObjectIrStatement[],
                                           lineNumber: int32,
                                           bindingName: str): bool =
    if bindingName == "":
        return false
    for scanIndex in 0..<statements.len:
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != lineNumber:
            continue
        if scanStmt.kind != texpr.TypedExprIrStmtLetCall:
            continue
        if scanStmt.bindingName == bindingName:
            return true
    return false

@borrows
fn PrimaryBodyIrHasSameLineResultIntrinsicBinding(statements: var lower.PrimaryObjectIrStatement[],
                                                  lineNumber: int32,
                                                  bindingName: str): bool =
    if bindingName == "":
        return false
    for scanIndex in 0..<statements.len:
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != lineNumber:
            continue
        if scanStmt.kind != texpr.TypedExprIrStmtResultIntrinsic:
            continue
        if scanStmt.bindingName == bindingName:
            return true
    return false

@borrows
fn PrimaryBodyIrHasPreviousDuplicateWholeLetCall(statements: var lower.PrimaryObjectIrStatement[],
                                                 stmtIndex: int32): bool =
    if stmtIndex < 0 || stmtIndex >= statements.len:
        return false
    let stmt = statements[stmtIndex]
    if stmt.kind != texpr.TypedExprIrStmtLetCall:
        return false
    if stmt.bindingName == "" || stmt.callTarget == "":
        return false
    for scanIndex in 0..<statements.len:
        if scanIndex == stmtIndex:
            continue
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != stmt.lineNumber:
            continue
        if scanStmt.bindingName != stmt.bindingName:
            continue
        if scanStmt.kind == texpr.TypedExprIrStmtLocalDecl ||
           scanStmt.kind == texpr.TypedExprIrStmtAssign:
            if !PrimaryBodyIrTextIsBareWholeCall(scanStmt.surfaceText):
                return false
    for scanIndex in 0..<stmtIndex:
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != stmt.lineNumber:
            continue
        if scanStmt.kind != texpr.TypedExprIrStmtLetCall:
            continue
        if scanStmt.bindingName == stmt.bindingName &&
           scanStmt.callTarget == stmt.callTarget &&
           scanStmt.callTargetSourcePath == stmt.callTargetSourcePath &&
           scanStmt.callTargetImportc == stmt.callTargetImportc &&
           scanStmt.callArgCount == stmt.callArgCount &&
           scanStmt.callArgsText == stmt.callArgsText &&
           scanStmt.surfaceText == stmt.surfaceText &&
           scanStmt.resultType == stmt.resultType:
            return true
    return false

@borrows
fn PrimaryBodyIrHasPreviousDuplicateWholeCall(statements: var lower.PrimaryObjectIrStatement[],
                                              stmtIndex: int32): bool =
    if stmtIndex < 0 || stmtIndex >= statements.len:
        return false
    let stmt = statements[stmtIndex]
    if stmt.kind != texpr.TypedExprIrStmtCall:
        return false
    if stmt.callTarget == "":
        return false
    for scanIndex in 0..<statements.len:
        if scanIndex == stmtIndex:
            continue
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != stmt.lineNumber:
            continue
        if scanStmt.kind == texpr.TypedExprIrStmtLocalDecl ||
           scanStmt.kind == texpr.TypedExprIrStmtAssign:
            if !PrimaryBodyIrTextIsBareWholeCall(scanStmt.surfaceText):
                return false
    for scanIndex in 0..<stmtIndex:
        let scanStmt = statements[scanIndex]
        if scanStmt.lineNumber != stmt.lineNumber:
            continue
        if scanStmt.kind != texpr.TypedExprIrStmtCall:
            continue
        if scanStmt.callKind == stmt.callKind &&
           scanStmt.callCallee == stmt.callCallee &&
           scanStmt.callTarget == stmt.callTarget &&
           scanStmt.callTargetSourcePath == stmt.callTargetSourcePath &&
           scanStmt.callTargetImportc == stmt.callTargetImportc &&
           scanStmt.callArgCount == stmt.callArgCount &&
           scanStmt.callArgsText == stmt.callArgsText &&
           scanStmt.surfaceText == stmt.surfaceText &&
           scanStmt.resultType == stmt.resultType:
            return true
    return false

@borrows
fn PrimaryBodyIrVarI32ValueSlotName(name: str): str =
    return Fmt"{name}#var_i32_value"

@borrows
fn PrimaryBodyIrVarI64ValueSlotName(name: str): str =
    return Fmt"{name}#var_i64_value"

@borrows
fn PrimaryBodyIrFindOrCreateSlot(bodyIR: var coreir.BodyIR,
                                  slotNames: var str[],
                                  name: str,
                                  typeKind: int32): int32 =
    primarySlotStageProbe(bodyIR, "find_or_create_enter", 5651)
    var slotFound: bool
    let slotHit = PrimaryBodyIrNodeBoolChainSlotNameIndexLookup(bodyIR,
                                                                slotNames,
                                                                share(name),
                                                                slotFound)
    # form60: hoist .len before three-way conj with [slotHit]
    let slotNamesLen_f60: int32 = slotNames.len
    if slotFound && slotHit >= 0 && slotHit < slotNamesLen_f60 && slotNames[slotHit] == name:
        let i = slotHit
        if i < bodyIR.localSlots.len:
            let desiredSize = PrimaryBodyIrNormalizeSlotSizeBytes(typeKind, 0)
            let desiredAlign = PrimaryBodyIrNormalizeSlotAlignBytes(typeKind, 0)
            var changed = false
            if desiredSize > 0 &&
               PrimaryLocalSlotSizeOf(bodyIR.localSlots[i]) < desiredSize:
                changed = true
            if desiredAlign > 0 &&
               bodyIR.localSlots[i].alignBytes < desiredAlign:
                changed = true
            if bodyIR.localSlots[i].typeKind != typeKind &&
               (bodyIR.localSlots[i].typeKind == coreir.LocalI32Tag ||
                bodyIR.localSlots[i].typeKind == coreir.LocalAggregateTag ||
                typeKind == coreir.LocalAggregateTag):
                changed = true
            if changed:
                PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, i)
            var slot = bodyIR.localSlots[i]
            if desiredSize > 0 && PrimaryLocalSlotSizeOf(slot) < desiredSize:
                slot.sizeBytes = desiredSize
            if desiredAlign > 0 && slot.alignBytes < desiredAlign:
                slot.alignBytes = desiredAlign
            if slot.typeKind != typeKind &&
               (slot.typeKind == coreir.LocalI32Tag ||
                slot.typeKind == coreir.LocalAggregateTag ||
                typeKind == coreir.LocalAggregateTag):
                slot.typeKind = typeKind
            if changed:
                bodyIR.localSlots[i] = slot
                primarySlotElementWriteBackCheck(bodyIR, i, "findorcreate_update", 5658)
        return i
    let newSlot = slotNames.len
    add(slotNames, share(name))
    PrimaryBodyIrLocalSlotNew(bodyIR, newSlot, name, typeKind)
    PrimaryBodyIrNodeBoolChainSlotNameIndexPut(bodyIR, name, newSlot)
    return newSlot

@borrows
fn PrimaryBodyIrFindOrCreateSlotSized(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       name: str,
                                       typeKind: int32,
                                       sizeBytes: int32,
                                       alignBytes: int32): int32 =
    primarySlotStageProbe(bodyIR, "find_or_create_sized_enter", 5704)
    let desiredSize = PrimaryBodyIrNormalizeSlotSizeBytes(typeKind, sizeBytes)
    let desiredAlign = PrimaryBodyIrNormalizeSlotAlignBytes(typeKind, alignBytes)
    var slotFound: bool
    let slotHit = PrimaryBodyIrNodeBoolChainSlotNameIndexLookup(bodyIR,
                                                                slotNames,
                                                                name,
                                                                slotFound)
    # form60: hoist .len before three-way conj with [slotHit]
    let slotNamesLen_f60: int32 = slotNames.len
    if slotFound && slotHit >= 0 && slotHit < slotNamesLen_f60 && slotNames[slotHit] == name:
        let i = slotHit
        if i < bodyIR.localSlots.len:
            var changed = false
            if desiredSize > 0 &&
               PrimaryLocalSlotSizeOf(bodyIR.localSlots[i]) < desiredSize:
                changed = true
            if desiredAlign > 0 &&
               bodyIR.localSlots[i].alignBytes < desiredAlign:
                changed = true
            if bodyIR.localSlots[i].typeKind != typeKind &&
               (bodyIR.localSlots[i].typeKind == coreir.LocalI32Tag ||
                bodyIR.localSlots[i].typeKind == coreir.LocalAggregateTag ||
                typeKind == coreir.LocalAggregateTag):
                changed = true
            if changed:
                PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, i)
            var slot = bodyIR.localSlots[i]
            if desiredSize > 0 && PrimaryLocalSlotSizeOf(slot) < desiredSize:
                slot.sizeBytes = desiredSize
            if desiredAlign > 0 && slot.alignBytes < desiredAlign:
                slot.alignBytes = desiredAlign
            if slot.typeKind != typeKind &&
               (slot.typeKind == coreir.LocalI32Tag ||
                slot.typeKind == coreir.LocalAggregateTag ||
                typeKind == coreir.LocalAggregateTag):
                slot.typeKind = typeKind
            if changed:
                bodyIR.localSlots[i] = slot
                primarySlotElementWriteBackCheck(bodyIR, i, "findorcreate_sized_update", 5710)
        return i
    let newSlot = slotNames.len
    add(slotNames, share(name))
    PrimaryBodyIrLocalSlotNewSized(bodyIR, newSlot, name, typeKind, desiredSize, desiredAlign)
    PrimaryBodyIrNodeBoolChainSlotNameIndexPut(bodyIR, name, newSlot)
    return newSlot

@borrows
fn PrimaryBodyIrTypedSlotShape(typedIr: texpr.TypedExprIr,
                                sourcePath: str,
                                typeRaw: str,
                                typeKindOut: var int32,
                                sizeBytesOut: var int32,
                                alignBytesOut: var int32) =
    var typeKind: int32
    var sizeBytes: int32
    var alignBytes: int32
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, typeRaw, typeKind, sizeBytes, alignBytes)
    var needsSourceLayout: bool
    if sourcePath != "":
        if sizeBytes <= 0:
            needsSourceLayout = true
        elif alignBytes <= 0:
            needsSourceLayout = true
    if needsSourceLayout:
        var sourceSizeBytes: int32
        var sourceAlignBytes: int32
        if PrimaryBodyIrCanonicalTypeLayout(typedIr,
                                                  sourcePath,
                                                  "",
                                                  typeRaw,
                                                  0,
                                                  sourceSizeBytes,
                                                  sourceAlignBytes):
            typeKind = coreir.LocalAggregateTag
            sizeBytes = sourceSizeBytes
            alignBytes = sourceAlignBytes
    typeKindOut = typeKind
    sizeBytesOut = sizeBytes
    alignBytesOut = alignBytes

@borrows
fn PrimaryBodyIrFindOrCreateTypedSlot(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       typedIr: texpr.TypedExprIr,
                                       sourcePath: str,
                                       name: str,
                                       typeRaw: str): int32 =
    var typeKind: int32
    var sizeBytes: int32
    var alignBytes: int32
    PrimaryBodyIrTypedSlotShape(typedIr, share(sourcePath), share(typeRaw), typeKind, sizeBytes, alignBytes)
    return PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                              slotNames,
                                              share(name),
                                              typeKind,
                                              sizeBytes,
                                              alignBytes)

@borrows
fn PrimaryBodyIrBindLocalSlotValueDefinitionExact(
        bodyIR: var coreir.BodyIR,
        bindingProjection:
            var coreir.BodyIRLocalBindingValueDefinitionProjection,
        typedIr: texpr.TypedExprIr,
        slotId: int32,
        definitionRow: int32,
        expectedOrigin: texpr.TypedExprValueDefinitionOriginKind) =
    if slotId < 0 || slotId >= bodyIR.localSlots.len ||
       definitionRow < 0 ||
       definitionRow >=
           texpr.TypedExprValueDefinitionAuthorityCount(typedIr) ||
       texpr.TypedExprValueDefinitionOriginKindAt(
           typedIr, definitionRow) != expectedOrigin:
        panic("primary body ir local binding: value-definition row invalid")
    let definingNodeIndex =
        texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
            typedIr, definitionRow)
    if definingNodeIndex < 0 ||
       definingNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        panic("primary body ir local binding: defining node invalid")
    let exactTypeId =
        texpr.TypedExprValueDefinitionExactTypeIdAt(
            typedIr, definitionRow)
    if exactTypeId < 0 ||
       exactTypeId !=
           texpr.TypedExprIrNodeStructuralTypeIdAt(
               typedIr, definingNodeIndex) ||
       exactTypeId != arenamod.ArenaArrayInt32Get(
           typedIr.arena,
           typedIr.nodes2_exactTypeArenaIds,
           definingNodeIndex) ||
       !typedIr.valueDefinitionTypeArenaBound ||
       !typedIr.nodeAuthorityTypeArenaBound ||
       !layout.FixedBytes32Equal(
           typedIr.valueDefinitionTypeArenaArtifactCid,
           typedIr.nodeAuthorityTypeArenaArtifactCid):
        panic("primary body ir local binding: immutable TypeId proof missing")
    let managedStorageKind =
        typedIr.nodes2_resultTypeManagedFlags[definingNodeIndex] ?
            coreir.BodyManagedStorageManagedTag :
            coreir.BodyManagedStorageUnmanagedTag
    coreir.BodyIRBindLocalBindingValueDefinitionRow(
        bodyIR, bindingProjection, slotId, definitionRow)
    if !coreir.BodyIRBindLocalSlotTypeArenaProof(
           bodyIR,
           slotId,
           typedIr.nodeAuthorityTypeArenaArtifactCid,
           exactTypeId,
           managedStorageKind):
        panic("primary body ir local binding: slot TypeId bind failed")

@borrows
fn PrimaryBodyIrBindLocalSlotFromTypedProducerExact(
        bodyIR: var coreir.BodyIR,
        bindingProjection:
            var coreir.BodyIRLocalBindingValueDefinitionProjection,
        typedIr: texpr.TypedExprIr,
        slotId: int32,
        producerNodeIndex: int32) =
    if producerNodeIndex < 0 ||
       producerNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        panic("primary body ir local binding: producer node invalid")
    let definitionRow =
        texpr.TypedExprIrNodeProducedValueDefinitionRowAt(
            typedIr, producerNodeIndex)
    if definitionRow < 0 ||
       definitionRow >=
           texpr.TypedExprValueDefinitionAuthorityCount(typedIr) ||
       texpr.TypedExprValueDefinitionOriginKindAt(
           typedIr, definitionRow) !=
           texpr.TypedExprValueDefinitionOriginBindingInitializer ||
       texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
           typedIr, definitionRow) != producerNodeIndex:
        panic("primary body ir local binding: immutable producer proof missing")
    PrimaryBodyIrBindLocalSlotValueDefinitionExact(
        bodyIR,
        bindingProjection,
        typedIr,
        slotId,
        definitionRow,
        texpr.TypedExprValueDefinitionOriginBindingInitializer)

# Scope-aware rebind shadowing for a `let`/`var` local declaration. node-eval slots
# are keyed by binding name only (no lexical scope) and grow monotonically, so a
# same-name re-declaration in a DIFFERENT lexical block whose new aggregate size
# differs from the existing slot is forced to share one over-grown slot — the
# store of the smaller value into the larger slot is an honest shape mismatch
# (store_shape_agg_l<big>_v<small>). Because statement lowering is strictly
# single-pass in source order and emitted ops reference slots by integer index,
# the prior scope's reads are already lowered against the existing slot index
# before this re-declaration is reached. Renaming that existing slot to a dead
# synthetic name here lets the new declaration allocate a fresh slot under the
# original binding name, so every subsequent read of the name (this new scope)
# resolves to the new slot via FindSlotIndex first-match — precise read-side
# shadowing without touching the hot name resolver. Strictly scoped to the
# incompatible aggregate-size rebind: compatible same-name reuse is untouched.
@borrows
fn PrimaryBodyIrRetireIncompatibleAggregateRebind(bodyIR: var coreir.BodyIR,
                                                   slotNames: var str[],
                                                   typedIr: texpr.TypedExprIr,
                                                   sourcePath: str,
                                                   name: str,
                                                   typeRaw: str) =
    var newKind: int32
    var newSize: int32
    var newAlign: int32
    PrimaryBodyIrTypedSlotShape(typedIr, sourcePath, typeRaw, newKind, newSize, newAlign)
    if newKind != coreir.LocalAggregateTag || newSize <= 0:
        return
    for i in 0..<slotNames.len:
        if slotNames[i] != name:
            continue
        if i >= bodyIR.localSlots.len:
            return
        var existing = bodyIR.localSlots[i]
        if existing.typeKind != coreir.LocalAggregateTag:
            return
        if PrimaryBodyIrLocalIsParam(existing):
            return
        let existingSize = PrimaryLocalSlotSizeOf(existing)
        if existingSize <= 0 || existingSize == newSize:
            return
        let deadName = Fmt"{name}#shadowed{i}#{bodyIR.ops.len}"
        PrimaryBodyIrNodeBoolChainJournalSlotNameBeforeWrite(slotNames, i)
        slotNames[i] = strings.CloneStr(deadName)
        existing.name = deadName
        PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, i)
        bodyIR.localSlots[i] = existing
        primarySlotElementWriteBackCheck(bodyIR, i, "retire_rebind_rename", 5899)
        return

@borrows
fn PrimaryBodyIrFindSlotIndex(bodyIR: var coreir.BodyIR, slotNamesRaw: var str[], name: str): int32 =
    if len(name) < 0:
        add(slotNamesRaw, share(name))
    var idxFound: bool
    let idxHit = PrimaryBodyIrNodeBoolChainSlotNameIndexLookup(bodyIR,
                                                               slotNamesRaw,
                                                               name,
                                                               idxFound)
    # form60: hoist .len before three-way conj with [idxHit]
    let slotNamesRawLen_f60: int32 = slotNamesRaw.len
    if idxFound && idxHit >= 0 && idxHit < slotNamesRawLen_f60 && slotNamesRaw[idxHit] == name:
        return idxHit
    return -1

@borrows
fn PrimaryBodyIrGlobalNameIndexFingerprint(typedIr: texpr.TypedExprIr): int32 =
    var h: int32
    h = 17
    h = h * 31 + typedIr.globalNames.len
    for i in 0..<typedIr.globalNames.len:
        h = PrimaryObjectIrFunctionIndexFingerprintText(h, typedIr.globalNames[i])
    if h == 0:
        h = 1
    return h

@borrows
fn PrimaryBodyIrGlobalNameIndexPrepare(typedIr: texpr.TypedExprIr) =
    # 同 PrimaryObjectIrFunctionIndexPrepare 的真根因:跳过 per-lookup 的 O(全局数×名长)
    # fingerprint,length 未变即缓存有效(globalNames 内容随 len 单调)。
    if primaryBodyIrGlobalNameIndexBuiltCount == typedIr.globalNames.len &&
       primaryBodyIrGlobalNameIndexBucketHeads.len > 0:
        return
    let fingerprint = PrimaryBodyIrGlobalNameIndexFingerprint(typedIr)
    if primaryBodyIrGlobalNameIndexBuiltCount == typedIr.globalNames.len &&
       primaryBodyIrGlobalNameIndexFingerprint == fingerprint &&
       primaryBodyIrGlobalNameIndexBucketHeads.len > 0:
        return
    primaryBodyIrGlobalNameIndexBucketHeads = []
    primaryBodyIrGlobalNameIndexEntryNames = []
    primaryBodyIrGlobalNameIndexEntryGlobalIndexes = []
    primaryBodyIrGlobalNameIndexEntryNext = []
    for bucketIndex in 0..<16384:
        add(primaryBodyIrGlobalNameIndexBucketHeads, -1)
    for i in 0..<typedIr.globalNames.len:
        let storedName = typedIr.globalNames[i]
        let bucket = PrimaryObjectIrFunctionIndexHash(storedName,
                                                      primaryBodyIrGlobalNameIndexBucketHeads.len)
        if bucket < 0:
            continue
        let entryIndex = primaryBodyIrGlobalNameIndexEntryGlobalIndexes.len
        add(primaryBodyIrGlobalNameIndexEntryGlobalIndexes, i)
        add(primaryBodyIrGlobalNameIndexEntryNames, share(storedName))
        add(primaryBodyIrGlobalNameIndexEntryNext, primaryBodyIrGlobalNameIndexBucketHeads[bucket])
        primaryBodyIrGlobalNameIndexBucketHeads[bucket] = entryIndex
    primaryBodyIrGlobalNameIndexBuiltCount = typedIr.globalNames.len
    primaryBodyIrGlobalNameIndexFingerprint = fingerprint

# 兼容旧调用签名的精确索引适配器；不再扫描全局列或按奇偶命中取最后一项。
@borrows
fn PrimaryBodyIrGlobalNameResolve(typedIr: texpr.TypedExprIr,
                                   sourcePath: str,
                                   name: str,
                                   minExactOut: var int32,
                                   maxNonExactOut: var int32,
                                   nonExactCountOut: var int32) =
    minExactOut = -1
    maxNonExactOut = -1
    nonExactCountOut = 0
    let exactRow = PrimaryBodyIrExactGlobalRow(typedIr, sourcePath, name)
    if exactRow >= 0:
        minExactOut = exactRow
        return
    var definingSourcePath: str
    let visibleRow = PrimaryBodyIrVisibleGlobalRow(typedIr,
                                                    sourcePath,
                                                    name,
                                                    definingSourcePath)
    if visibleRow >= 0:
        maxNonExactOut = visibleRow
        nonExactCountOut = 1

@borrows
fn PrimaryBodyIrVisibleGlobalRow(typedIr: texpr.TypedExprIr,
                                  sourcePathRaw: str,
                                  nameRaw: str,
                                  definingSourcePathOut: var str): int32 =
    definingSourcePathOut = ""
    let nameText = chengpath.PathTrim(nameRaw)
    let name = parser.ParserIdentPrefix(nameText)
    if name == "" || name != nameText:
        return -1
    var rowIndex: int32
    let state = texpr.TypedExprIrVisibleSourceRowState(
        typedIr,
        "ir_global_source",
        sourcePathRaw,
        name,
        "",
        rowIndex,
        definingSourcePathOut)
    if state == texpr.TypedExprBuildIndexAmbiguous:
        panic(Fmt"primary: ambiguous visible global source={sourcePathRaw} name={name}")
    if state != texpr.TypedExprBuildIndexUnique:
        definingSourcePathOut = ""
        return -1
    if rowIndex < 0 || rowIndex >= typedIr.globalNames.len ||
       rowIndex >= typedIr.globalSourcePaths.len ||
       rowIndex >= typedIr.globalTypes.len ||
       typedIr.globalNames[rowIndex] != name ||
       !PrimaryPathNormalizedEquals(typedIr.globalSourcePaths[rowIndex],
                                    definingSourcePathOut):
        panic("primary: visible global index payload mismatch")
    return rowIndex

@borrows
fn PrimaryBodyIrExactGlobalRow(typedIr: texpr.TypedExprIr,
                                sourcePathRaw: str,
                                nameRaw: str): int32 =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let nameText = chengpath.PathTrim(nameRaw)
    let name = parser.ParserIdentPrefix(nameText)
    if sourcePath == "" || name == "" || name != nameText:
        return -1
    var rowIndex: int32
    let state = texpr.TypedExprBuildIndexLookup(
        texpr.TypedExprIrCanonicalMetadataIndex(typedIr),
                                                "ir_global_source",
                                                sourcePath,
                                                name,
                                                "",
                                                rowIndex)
    if state == texpr.TypedExprBuildIndexAmbiguous:
        panic(Fmt"primary: ambiguous exact global source={sourcePath} name={name}")
    if state != texpr.TypedExprBuildIndexUnique:
        return -1
    if rowIndex < 0 || rowIndex >= typedIr.globalNames.len ||
       rowIndex >= typedIr.globalSourcePaths.len ||
       rowIndex >= typedIr.globalTypes.len ||
       typedIr.globalNames[rowIndex] != name ||
       !PrimaryPathNormalizedEquals(typedIr.globalSourcePaths[rowIndex],
                                    sourcePath):
        panic("primary: exact global index payload mismatch")
    return rowIndex

@borrows
fn PrimaryBodyIrTypedGlobalType(typedIr: texpr.TypedExprIr,
                                 sourcePath: str,
                                 name: str): str =
    var definingSourcePath: str
    let rowIndex = PrimaryBodyIrVisibleGlobalRow(typedIr,
                                                  sourcePath,
                                                  name,
                                                  definingSourcePath)
    if rowIndex < 0:
        return ""
    return typedIr.globalTypes[rowIndex]

@borrows
fn PrimaryBodyIrTypedGlobalSlotName(typedIr: texpr.TypedExprIr,
                                     sourcePath: str,
                                     name: str): str =
    var definingSourcePath: str
    let rowIndex = PrimaryBodyIrVisibleGlobalRow(typedIr,
                                                  sourcePath,
                                                  name,
                                                  definingSourcePath)
    if rowIndex < 0:
        return ""
    return Fmt"{definingSourcePath}::{typedIr.globalNames[rowIndex]}"

@borrows
fn PrimaryBodyIrTypedGlobalTypeExact(typedIr: texpr.TypedExprIr,
                                      sourcePath: str,
                                      name: str): str =
    let rowIndex = PrimaryBodyIrExactGlobalRow(typedIr, sourcePath, name)
    if rowIndex >= 0:
        return typedIr.globalTypes[rowIndex]
    return ""

@borrows
fn PrimaryBodyIrTypedGlobalSlotNameExact(typedIr: texpr.TypedExprIr,
                                          sourcePath: str,
                                          name: str): str =
    let rowIndex = PrimaryBodyIrExactGlobalRow(typedIr, sourcePath, name)
    if rowIndex >= 0:
        return Fmt"{typedIr.globalSourcePaths[rowIndex]}::{typedIr.globalNames[rowIndex]}"
    return ""

@borrows
fn PrimaryBodyIrBindCanonicalAggregateCallGlobalStoreProof(
        bodyIR: var coreir.BodyIR,
        lowering: var lower.LoweringPlanStub,
        sourcePath: str,
        globalName: str,
        globalSlot: int32,
        valueSlot: int32,
        valueNodeIndex: int32): bool =
    let globalRow =
        PrimaryBodyIrExactGlobalRow(lowering.typedIr, sourcePath, globalName)
    if globalRow < 0 ||
       globalRow >= lowering.globalTypeArenaTypeIds.len ||
       globalRow >= lowering.globalManagedStorageKinds.len ||
       valueNodeIndex < 0 ||
       valueNodeIndex >= lowering.typedIr.nodes2_callDeclarationIndexes.len ||
       globalSlot < 0 || globalSlot >= bodyIR.localSlots.len ||
       valueSlot < 0 || valueSlot >= bodyIR.localSlots.len:
        return false
    let targetTypedFunctionIndex = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_callDeclarationIndexes,
        valueNodeIndex)
    if targetTypedFunctionIndex < 0 ||
       targetTypedFunctionIndex >=
           lowering.typedFunctionReturnTypeArenaTypeIds.len ||
       targetTypedFunctionIndex >=
           lowering.typedFunctionReturnManagedStorageKinds.len:
        return false
    let globalTypeId = lowering.globalTypeArenaTypeIds[globalRow]
    let valueTypeId =
        lowering.typedFunctionReturnTypeArenaTypeIds[
            targetTypedFunctionIndex]
    if globalTypeId < 0 || globalTypeId != valueTypeId ||
       lowering.globalManagedStorageKinds[globalRow] !=
           coreir.BodyManagedStorageUnmanagedTag ||
       lowering.typedFunctionReturnManagedStorageKinds[
           targetTypedFunctionIndex] !=
           coreir.BodyManagedStorageUnmanagedTag:
        return false
    return coreir.BodyIRBindLocalSlotTypeArenaProof(
               bodyIR,
               globalSlot,
               lowering.typeArenaArtifactCid,
               globalTypeId,
               coreir.BodyManagedStorageUnmanagedTag) &&
           coreir.BodyIRBindLocalSlotTypeArenaProof(
               bodyIR,
               valueSlot,
               lowering.typeArenaArtifactCid,
               valueTypeId,
               coreir.BodyManagedStorageUnmanagedTag)

# The TRUE registered module source-path of a module-global `name` (exact match
# preferred; the c857 non-exact uniqueness fallback when the caller's normalized
# source-path does not equal the registration path). Used to bind a global's
# aggregate element-type shape resolution to the module that actually declares
# the type, instead of the calling function's sourcePath (which fails the
# source-path-scoped layout registry when the two normalize differently).
@borrows
fn PrimaryBodyIrTypedGlobalSourcePath(typedIr: texpr.TypedExprIr,
                                       sourcePath: str,
                                       name: str): str =
    var definingSourcePath: str
    let rowIndex = PrimaryBodyIrVisibleGlobalRow(typedIr,
                                                  sourcePath,
                                                  name,
                                                  definingSourcePath)
    if rowIndex < 0:
        return ""
    return definingSourcePath

@borrows
fn PrimaryBodyIrCanonicalArgName(argRaw: str): str =
    let arg = strutil.Strip(argRaw)
    var openPos: int32 = -1
    for i in 0..<len(arg):
        if arg[i] == '(':
            openPos = i
            break
    if openPos <= 0:
        return arg
    var tailStart: int32
    for i in 0..<openPos:
        if arg[i] == '.':
            tailStart = i + 1
    if tailStart <= 0:
        return arg
    return strings.SliceBytes(arg, tailStart, len(arg) - tailStart)

@borrows
fn PrimaryBodyIrFindArgSlot(bodyIR: var coreir.BodyIR, slotNames: var str[], argName: str): int32 =
    let exact = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, share(argName))
    if exact >= 0:
        return exact
    let canonical = PrimaryBodyIrCanonicalArgName(share(argName))
    if canonical != argName:
        return PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, canonical)
    return -1

# 查某槽最近一次 def: 若恰为 LoadConst (operands==2) 则回填其 type/value 并返回
# true, 否则 (无 def 或最近 def 非 LoadConst) false。供条件操作数复用臂在引用点
# 重新物化同值常量, 保证常量槽的 LoadConst 支配每个跨块 use。
@borrows
fn PrimaryBodyIrLoadConstOperandsForSlot(bodyIR: var coreir.BodyIR,
                                         slot: int32,
                                         outType: var int32,
                                         outVal: var int32): bool =
    var opIndex = bodyIR.ops.len - 1
    while opIndex >= 0:
        let lcOp = bodyIR.ops[opIndex]
        let lcOpTarget = lcOp.target
        if lcOpTarget == slot:
            let lcOpKind = lcOp.kind
            let lcOpOperandsLen = lcOp.operands.len
            if lcOpKind == coreir.BodyOpLoadConstTag && lcOpOperandsLen == 2:
                outType = lcOp.operands[0]
                outVal = lcOp.operands[1]
                return true
            return false
        opIndex = opIndex - 1
    return false

@borrows
fn PrimaryBodyIrNodeTypeShape(typedIr: texpr.TypedExprIr,
                              sourcePath: str,
                              typeRaw: str,
                              kindOut: var int32,
                              sizeOut: var int32,
                              alignOut: var int32) =
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, typeRaw, kindOut, sizeOut, alignOut)
    var needsSourceLayout: bool
    if sourcePath != "":
        if sizeOut <= 0:
            needsSourceLayout = true
        elif alignOut <= 0:
            needsSourceLayout = true
    if needsSourceLayout:
        var sourceSize: int32
        var sourceAlign: int32
        if PrimaryBodyIrCanonicalTypeLayout(typedIr,
                                                  sourcePath,
                                                  "",
                                                  typeRaw,
                                                  0,
                                                  sourceSize,
                                                  sourceAlign):
            kindOut = coreir.LocalAggregateTag
            sizeOut = sourceSize
            alignOut = sourceAlign

@borrows
fn PrimaryBodyIrNodeValueTypeShape(typedIr: texpr.TypedExprIr,
                                   nodeIndex: int32,
                                   kindOut: var int32,
                                   sizeOut: var int32,
                                   alignOut: var int32) =
    let nvsSrcRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_sourcePathIds[nodeIndex])
    let nvsTypeRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_resultTypeIds[nodeIndex])
    # form59: hoist Value(Result[str]) before StripVarType — nested Value-as-call-arg
    # is miscompiled by gen1 as 32-bit ldr (should pass struct address).
    let nvsSrc: str = Value(nvsSrcRes)
    let nvsType: str = Value(nvsTypeRes)
    let nvsTypeStripped: str = texpr.TypedExprStripVarType(nvsType)
    PrimaryBodyIrNodeTypeShape(typedIr,
                               nvsSrc,
                               nvsTypeStripped,
                               kindOut,
                               sizeOut,
                               alignOut)

@borrows
fn PrimaryBodyIrNodeExactPhysicalTypeIdForCast(
        lowering: var lower.LoweringPlanStub,
        nodeIndex: int32): int32 =
    if nodeIndex < 0 ||
       nodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
       lowering.typedIr.nodes2_exactTypeArenaIds.len !=
           lowering.typedIr.nodes2_nodeIndexs.len:
        panic("primary cast: node TypeId coordinate missing")
    if !lowering.typedIr.nodeAuthorityTypeArenaBound ||
       !layout.FixedBytes32Equal(
           lowering.typedIr.nodeAuthorityTypeArenaArtifactCid,
           lowering.typeArenaArtifactCid):
        panic("primary cast: node TypeArena domain missing")
    let exactTypeId = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_exactTypeArenaIds,
        nodeIndex)
    return typechain.CanonicalTypeChainPhysicalTypeId(
        lowering, exactTypeId)

@borrows
fn PrimaryBodyIrNodeExactTypeIsPointerLike(
        lowering: var lower.LoweringPlanStub,
        nodeIndex: int32): bool =
    let physicalTypeId =
        PrimaryBodyIrNodeExactPhysicalTypeIdForCast(
            lowering,  nodeIndex)
    let structuralKind =
        lowering.typeArenaStructuralKinds[physicalTypeId]
    if structuralKind ==
           Int32(typearena.TypedExprStructuralTypeRefObject) ||
       structuralKind ==
           Int32(typearena.TypedExprStructuralTypeFunction):
        return true
    if structuralKind !=
           Int32(typearena.TypedExprStructuralTypeScalar):
        return false
    return lowering.typeArenaScalarKinds[physicalTypeId] ==
        Int32(typearena.TypedExprStructuralScalarCString)

@borrows
fn PrimaryBodyIrNodeEvalGlobalLoadSlot(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       typedIr: texpr.TypedExprIr,
                                       sourcePath: str,
                                       nameRaw: str): int32 =
    let name = strutil.Strip(nameRaw)
    if sourcePath == "" || name == "":
        return -1
    if PrimaryBodyIrTextHasFieldOrIndex(name):
        return -1
    let globalType = PrimaryBodyIrTypedGlobalTypeExact(typedIr, sourcePath, name)
    if globalType == "":
        return -1
    var globalKind: int32
    var globalSize: int32
    var globalAlign: int32
    PrimaryBodyIrNodeTypeShape(typedIr,
                               sourcePath,
                               globalType,
                               globalKind,
                               globalSize,
                               globalAlign)
    if globalKind != coreir.LocalI32Tag &&
       globalKind != coreir.LocalI64Tag &&
       globalKind != coreir.LocalPtrTag &&
       globalKind != coreir.LocalStrTag &&
       globalKind != coreir.LocalAggregateTag:
        return -1
    if globalKind == coreir.LocalAggregateTag:
        # 聚合/seq 全局头内联在数据标号；按标量值加载得 size 0（无标量 GlobalLoad
        # 分支）会截断函数体。物化其地址到 Ptr 槽，下游 FieldLoad/IndexGet 经指针读头。
        return PrimaryBodyIrGlobalSeqAddressSlot(bodyIR,
                                                 slotNames,
                                                 typedIr,
                                                 sourcePath,
                                                 name)
    let globalSlotName = PrimaryBodyIrTypedGlobalSlotNameExact(typedIr, sourcePath, name)
    if globalSlotName == "":
        return -1
    let globalSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                        slotNames,
                                                        globalSlotName,
                                                        globalKind,
                                                        globalSize,
                                                        globalAlign)
    if globalSlot < 0 || globalSlot >= bodyIR.localSlots.len:
        return -1
    PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, globalSlot)
    bodyIR.localSlots[globalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
    let valueSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                       slotNames,
                                                       Fmt"{globalSlotName}#global_value",
                                                       globalKind,
                                                       globalSize,
                                                       globalAlign)
    if valueSlot < 0 || valueSlot >= bodyIR.localSlots.len:
        return -1
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpGlobalLoadTag
    op.target = valueSlot
    add(op.operands, globalSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    return valueSlot

@borrows
fn PrimaryBodyIrValueArgSlotForCall(bodyIR: var coreir.BodyIR,
                                     slotNames: var str[],
                                     typedIr: texpr.TypedExprIr,
                                     sourcePath: str,
                                     argName: str,
                                     slotId: int32): int32 =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return -1
    if bodyIR.localSlots[slotId].placeKind != coreir.BodyPlaceGlobalAddressTag:
        return slotId
    return PrimaryBodyIrNodeEvalGlobalLoadSlot(bodyIR,
                                               slotNames,
                                               typedIr,
                                               sourcePath,
                                               argName)

@borrows
fn PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           typedIr: texpr.TypedExprIr,
                                           sourcePath: str,
                                           rootName: str,
                                           rootTypeRaw: str): int32 =
    if rootTypeRaw != "" && !PrimaryObjectMetadataTextStable(rootTypeRaw):
        return -1
    let rootType = texpr.TypedExprNormalizeTypeText(rootTypeRaw)
    if rootName == "":
        return -1
    # A multi-part field-arg chain (e.g. `buf.storage.data`) materializes each
    # intermediate value into a synthetic slot named `<prefix>#field_arg`. When
    # the next part loads off that slot, rootName carries the synthetic name
    # (which contains a '.'), so the field/index bail below would reject it.
    # The intermediate value already lives in an exact-named slot; address the
    # next field-load off it directly.
    let existingChainSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, rootName)
    if existingChainSlot >= 0 &&
       (PrimaryBodyIrSlotType(bodyIR, existingChainSlot) == coreir.LocalAggregateTag ||
        PrimaryBodyIrSlotType(bodyIR, existingChainSlot) == coreir.LocalPtrTag):
        return existingChainSlot
    # A same-named SCALAR slot is NOT a valid field/index base. Module-global seq
    # element by value (`loweringParallelResults[i]`, PrimaryObjectIrFunction[]): an
    # earlier scalar resolver mis-materializes a bare-name `loweringParallelResults`
    # I32 shadow slot (the global's correct slot is the SOURCE-PATH-QUALIFIED
    # `<path>::loweringParallelResults` aggregate). The original unconditional
    # existingChainSlot return picked up that I32 shadow → the indexed-member
    # field-base kind check rejected (Aggregate/Ptr only) → the address walk bailed
    # before the seq header / element-address arithmetic → bail_44 → BodyOpInvalidTag
    # → word_count=0 → not_ready. Only short-circuit to a pre-existing slot when it is
    # an aggregate/ptr (a real field/index base); a scalar shadow falls through to the
    # module-global GlobalSeqAddressSlot path (adrp+add real symbol) below, or to
    # FindOrCreateTypedSlot (which upgrades the slot kind for a genuine local aggregate).
    if rootType == "" || PrimaryStartsWith(rootType, "var"):
        let varArgSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rootName)
        if varArgSlot >= 0:
            return varArgSlot
        # var param aggregate (var bigint.BigInt) not in slotNames via FindArgSlot —
        # the param slot may use a different naming. Fall back to FindOrCreateTypedSlot
        # with the var-stripped type, creating an aggregate slot enabling field/index
        # addressing for a.limbs[idx] as call-arg (bail=44 fix 2026-06-30).
        let varStrippedType = texpr.TypedExprStripVarType(rootTypeRaw)
        if varStrippedType != "" && PrimaryObjectMetadataTextStable(varStrippedType):
            let typedSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                       slotNames,
                                                       typedIr,
                                                       sourcePath,
                                                       rootName,
                                                       varStrippedType)
            if typedSlot >= 0:
                return typedSlot
            # Cross-module type (bigint.BigInt registered under bigint.cheng sourcePath,
            # not the caller's rsa.cheng). Retry with empty sourcePath for global lookup.
            return PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                       slotNames,
                                                       typedIr,
                                                       "",
                                                       rootName,
                                                       varStrippedType)
        return -1
    # A GLOBAL aggregate's fields must be addressed off the global symbol
    # (adrp+add), not a fresh stack slot. Without this `gAcc.total` reads/writes
    # land on a frame-local copy (stack garbage init, writeback invisible to
    # other calls). Materialize the global's address into a Ptr slot; the
    # FieldLoad/FieldStore emitters already address fields through a Ptr base.
    if PrimaryBodyIrTextHasFieldOrIndex(rootName):
        return -1
    if PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rootName) < 0:
        var globalType = PrimaryBodyIrTypedGlobalTypeExact(typedIr, sourcePath, rootName)
        if globalType == "":
            # A directly imported exported global is absent from the same-source
            # exact query. Resolve it through the canonical visibility index so an
            # aggregate global still routes through GlobalSeqAddressSlot; ambiguity
            # and private symbols fail before this point.
            globalType = PrimaryBodyIrTypedGlobalType(typedIr, sourcePath, rootName)
        if globalType != "":
            var globalTypeKind: int32
            var globalSizeBytes: int32
            var globalAlignBytes: int32
            PrimaryBodyIrTypeShapeFromText(typedIr,
                                           sourcePath,
                                           globalType,
                                           globalTypeKind,
                                           globalSizeBytes,
                                           globalAlignBytes)
            if globalTypeKind != coreir.LocalAggregateTag:
                # type-shape may be 0 under the caller sourcePath when the type is
                # registered in the global's declaring module; re-resolve under the
                # global's true registration sourcePath before giving up.
                let baseGlobalSource = PrimaryBodyIrTypedGlobalSourcePath(typedIr,
                                                                          sourcePath,
                                                                          rootName)
                if baseGlobalSource != "" && baseGlobalSource != sourcePath:
                    PrimaryBodyIrTypeShapeFromText(typedIr,
                                                   baseGlobalSource,
                                                   globalType,
                                                   globalTypeKind,
                                                   globalSizeBytes,
                                                   globalAlignBytes)
            if globalTypeKind == coreir.LocalAggregateTag:
                let globalAddrSlot = PrimaryBodyIrGlobalSeqAddressSlot(bodyIR,
                                                                       slotNames,
                                                                       typedIr,
                                                                       sourcePath,
                                                                       rootName)
                if globalAddrSlot >= 0:
                    return globalAddrSlot
    return PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                              slotNames,
                                              typedIr,
                                              sourcePath,
                                              rootName,
                                              rootType)

@borrows
fn PrimaryBodyIrAppendFieldLoadToSlot(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       typedIr: texpr.TypedExprIr,
                                       sourcePath: str,
                                       rootName: str,
                                       rootTypeRaw: str,
                                       fieldOffsetBytes: int32,
                                       fieldSizeBytes: int32,
                                       targetSlot: int32): bool =
    if rootName == "" ||
       targetSlot < 0 ||
       targetSlot >= bodyIR.localSlots.len:
        return false
    let baseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                          slotNames,
                                                          typedIr,
                                                          sourcePath,
                                                          rootName,
                                                          rootTypeRaw)
    var primaryColdCond2: bool
    if baseSlot < 0:
        primaryColdCond2 = true
    if fieldOffsetBytes < 0:
        primaryColdCond2 = true
    if fieldSizeBytes <= 0:
        primaryColdCond2 = true
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) < fieldSizeBytes:
        primaryColdCond2 = true
    if primaryColdCond2:
        return false
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpFieldLoadTag
    op.target = targetSlot
    add(op.operands, baseSlot)
    add(op.operands, targetSlot)
    add(op.operands, fieldOffsetBytes)
    add(op.operands, fieldSizeBytes)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    return true

@borrows
fn PrimaryBodyIrShiftRightLhsIsUnsignedCast(lhsTextRaw: str): bool =
    let lhsText = strutil.Strip(lhsTextRaw)
    if PrimaryBodyIrWholeCallInnerForHead(lhsText, "uint64") != "" ||
       PrimaryBodyIrWholeCallInnerForHead(lhsText, "u64") != "" ||
       PrimaryBodyIrWholeCallInnerForHead(lhsText, "UInt64") != "" ||
       PrimaryBodyIrWholeCallInnerForHead(lhsText, "uint32") != "" ||
       PrimaryBodyIrWholeCallInnerForHead(lhsText, "u32") != "" ||
       PrimaryBodyIrWholeCallInnerForHead(lhsText, "UInt32") != "" ||
       PrimaryBodyIrWholeCallInnerForHead(lhsText, "uint16") != "" ||
       PrimaryBodyIrWholeCallInnerForHead(lhsText, "uint8") != "":
        return true
    return false

@borrows
fn PrimaryBodyIrTypeTextIsUnsignedInt(typeTextRaw: str): bool =
    let typeText = texpr.TypedExprNormalizeTypeText(typeTextRaw)
    return typeText == "uint64" || typeText == "u64" ||
           typeText == "uint32" || typeText == "u32" ||
           typeText == "uint16" || typeText == "uint8"

# Publish the function currently being lowered so the context-less base scalar
# slot builder can resolve `>>` LHS signedness (params + locals).
@borrows
fn PrimaryBodyIrSetCurrentShiftContext(typedFn: texpr.TypedExprIrFunction,
                                        irFunction: lower.PrimaryObjectIrFunction) =
    primaryBodyIrCurrentShiftCtxValid = true
    primaryBodyIrCurrentShiftCtxSourcePath = typedFn.sourcePath
    primaryBodyIrCurrentShiftCtxFunctionName = typedFn.functionName
    primaryBodyIrCurrentShiftCtxEndLine = typedFn.endLineNumber
    primaryBodyIrCurrentShiftCtxParamNames = irFunction.paramNames
    primaryBodyIrCurrentShiftCtxParamTypes = irFunction.paramTypes

# Resolve whether the `>>` LHS (a bare param or local name) is unsigned using the
# published current-function context. Mirrors PrimaryBodyIrShiftRightOpKind's
# type sources but without needing the typedFn/irFunction passed in.
@borrows
fn PrimaryBodyIrCurrentShiftLhsIsUnsigned(typedIr: texpr.TypedExprIr,
                                           lhsTextRaw: str): bool =
    if !primaryBodyIrCurrentShiftCtxValid:
        return false
    let lhsText = strutil.Strip(lhsTextRaw)
    if lhsText == "":
        return false
    for i in 0..<primaryBodyIrCurrentShiftCtxParamNames.len:
        if i >= primaryBodyIrCurrentShiftCtxParamTypes.len:
            break
        if primaryBodyIrCurrentShiftCtxParamNames[i] == lhsText:
            return PrimaryBodyIrTypeTextIsUnsignedInt(primaryBodyIrCurrentShiftCtxParamTypes[i])
    let localType = texpr.TypedExprIrLookupLocalBindingType(typedIr,
                                                            primaryBodyIrCurrentShiftCtxSourcePath,
                                                            primaryBodyIrCurrentShiftCtxFunctionName,
                                                            primaryBodyIrCurrentShiftCtxEndLine,
                                                            lhsText)
    if localType != "":
        return PrimaryBodyIrTypeTextIsUnsignedInt(localType)
    return false

@borrows
fn PrimaryBodyIrShiftRightOpKind(typedIr: texpr.TypedExprIr,
                                  typedFn: texpr.TypedExprIrFunction,
                                  irFunction: lower.PrimaryObjectIrFunction,
                                  lineNumber: int32,
                                  lhsTextRaw: str): int32 =
    # uint 左操作数的 >> 必须发逻辑右移；查不到类型则维持算术右移（现状不变）。
    let lhsText = strutil.Strip(lhsTextRaw)
    if PrimaryBodyIrShiftRightLhsIsUnsignedCast(lhsText):
        return int32(texpr.TypedExprIrOpI32Lsr)
    let lhsTypeText = texpr.TypedExprNormalizeTypeText(
        PrimaryBodyIrBindingTypeForName(typedIr, typedFn, irFunction, lineNumber, lhsText))
    if lhsTypeText == "uint64" || lhsTypeText == "u64" ||
       lhsTypeText == "uint32" || lhsTypeText == "u32" ||
       lhsTypeText == "uint16" || lhsTypeText == "uint8":
        return int32(texpr.TypedExprIrOpI32Lsr)
    return int32(texpr.TypedExprIrOpI32Asr)

var primaryBindingTierProbeTotal: int64
var primaryBindingTierProbeParam: int64
var primaryBindingTierProbeLocalHash: int64
var primaryBindingTierProbeTypedScan: int64
var primaryBindingTierProbeReparse: int64
var primaryBindingTierProbeIrScan: int64
var primaryBindingTierProbeMiss: int64

fn PrimaryBindingTierProbeDump() =
    if os.GetEnv("CHENG_BINDING_TIER_PROBE") == "":
        return
    os.WriteLine(os.GetStderr(), strutil.Join(["binding_tier_probe total=", strings.Int64ToStr(primaryBindingTierProbeTotal),
        " param=", strings.Int64ToStr(primaryBindingTierProbeParam),
        " local_hash=", strings.Int64ToStr(primaryBindingTierProbeLocalHash),
        " typed_scan=", strings.Int64ToStr(primaryBindingTierProbeTypedScan),
        " reparse=", strings.Int64ToStr(primaryBindingTierProbeReparse),
        " ir_scan=", strings.Int64ToStr(primaryBindingTierProbeIrScan),
        " miss=", strings.Int64ToStr(primaryBindingTierProbeMiss)], ""))

@borrows
fn PrimaryBodyIrForBindingElementType(typedIr: texpr.TypedExprIr,
                                       typedFn: texpr.TypedExprIrFunction,
                                       irFunction: lower.PrimaryObjectIrFunction,
                                       lineNumber: int32,
                                       name: str): str =
    var foundType = ""
    var foundLine: int32 = -1
    var foundIndex: int32 = -1
    var foundSeqType = ""
    var foundSeqLine: int32 = -1
    var foundSeqIndex: int32 = -1
    for i in 0..<irFunction.statements.len:
        let stmt = irFunction.statements[i]
        if stmt.lineNumber >= lineNumber ||
           stmt.kind != texpr.TypedExprIrStmtFor ||
           stmt.bindingName != name:
            continue
        if stmt.forStartNodeIndex < 0 || stmt.rhsNodeIndex < 0:
            # for-SEQ 循环(`for x in xs`): range 节点不存在, 元素类型由
            # 可迭代表达式的序列类型给出 —— 与 typed_expr 的
            # TypedExprForSeqBindingElementType 同规则。
            let iterableText = texpr.TypedExprForHeaderIterableText(strings.CloneStr(stmt.surfaceText))
            if iterableText == "" || iterableText == name:
                continue
            let iterableType = PrimaryBodyIrSeqStructuredBindingType(typedIr,
                                                                      typedFn,
                                                                      irFunction,
                                                                      stmt.lineNumber,
                                                                      iterableText)
            if iterableType == "":
                continue
            let normSeqType = texpr.TypedExprNormalizeTypeText(
                texpr.TypedExprStripVarType(iterableType))
            if len(normSeqType) < 2 ||
               strings.SliceBytes(normSeqType, len(normSeqType) - 2, 2) != "[]":
                continue
            let seqElemType = texpr.TypedExprNormalizeTypeText(
                strings.SliceBytes(normSeqType, 0, len(normSeqType) - 2))
            if seqElemType == "":
                continue
            if stmt.lineNumber < foundSeqLine ||
               (stmt.lineNumber == foundSeqLine && i <= foundSeqIndex):
                continue
            foundSeqLine = stmt.lineNumber
            foundSeqIndex = i
            foundSeqType = seqElemType
            continue
        if !PrimaryBodyIrSeqNodeBelongsToStatement(typedIr,
                                                   typedFn,
                                                   irFunction,
                                                   stmt,
                                                   stmt.forStartNodeIndex) ||
           !PrimaryBodyIrSeqNodeBelongsToStatement(typedIr,
                                                   typedFn,
                                                   irFunction,
                                                   stmt,
                                                   stmt.rhsNodeIndex):
            continue
        let startTypeRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool,
            typedIr.nodes2_resultTypeIds[stmt.forStartNodeIndex])
        let endTypeRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool,
            typedIr.nodes2_resultTypeIds[stmt.rhsNodeIndex])
        if !IsOk(startTypeRes) || !IsOk(endTypeRes) ||
           texpr.TypedExprNormalizeTypeText(Value(startTypeRes)) != "int32" ||
           texpr.TypedExprNormalizeTypeText(Value(endTypeRes)) != "int32":
            continue
        if stmt.lineNumber < foundLine ||
           (stmt.lineNumber == foundLine && i <= foundIndex):
            continue
        foundLine = stmt.lineNumber
        foundIndex = i
        foundType = "int32"
    if foundType != "":
        return foundType
    return foundSeqType
@borrows
fn PrimaryBodyIrStructuredStatementBindingType(irFunction: lower.PrimaryObjectIrFunction,
                                               lineNumber: int32,
                                               nameRaw: str,
                                               bindingNameGlobalType: str): str =
    let name = strutil.Strip(nameRaw)
    if name == "":
        return ""
    var foundType = ""
    var foundLine: int32 = -1
    var foundIndex: int32 = -1
    for i in 0..<irFunction.statements.len:
        let stmt = irFunction.statements[i]
        if stmt.lineNumber >= lineNumber || stmt.bindingName != name:
            continue
        if bindingNameGlobalType != "" &&
           stmt.kind != texpr.TypedExprIrStmtLocalDecl:
            continue
        if stmt.resultType == "" || stmt.resultType == "unknown" ||
           stmt.resultType == "call_expr" ||
           !PrimaryObjectMetadataTextStable(stmt.resultType):
            continue
        if stmt.lineNumber < foundLine ||
           (stmt.lineNumber == foundLine && i <= foundIndex):
            continue
        if foundType != "" &&
           !PrimaryBodyIrTypeTextIsGenericPointer(foundType) &&
           PrimaryBodyIrTypeTextIsGenericPointer(stmt.resultType):
            continue
        foundLine = stmt.lineNumber
        foundIndex = i
        foundType = stmt.resultType
    return foundType

@borrows
fn PrimaryBodyIrLazyTypedStatementBindingType(typedIr: texpr.TypedExprIr,
                                              typedFn: texpr.TypedExprIrFunction,
                                              lineNumber: int32,
                                              nameRaw: str,
                                              bindingNameGlobalType: str): str =
    let name = strutil.Strip(nameRaw)
    let statementCount = typedIr.statements2_statementIndexs.len
    if name == "" || statementCount <= 0 || typedFn.statementStart < 0 ||
       typedFn.statementStart >= statementCount || typedFn.statementCount <= 0:
        return ""
    var statementEnd = typedFn.statementStart + typedFn.statementCount
    if statementEnd > statementCount:
        statementEnd = statementCount
    var foundType = ""
    var foundLine: int32 = -1
    var foundIndex: int32 = -1
    for statementIndex in typedFn.statementStart..<statementEnd:
        let bindingNameRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool,
            typedIr.statements2_bindingNameIds[statementIndex])
        let resultTypeRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool,
            typedIr.statements2_resultTypeIds[statementIndex])
        if !IsOk(bindingNameRes) || !IsOk(resultTypeRes):
            continue
        let statementLine = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.statements2_lineNumbers,
            statementIndex)
        let resultType = Value(resultTypeRes)
        if statementLine >= lineNumber || Value(bindingNameRes) != name:
            continue
        if bindingNameGlobalType != "" &&
           typedIr.statements2_kinds[statementIndex] != texpr.TypedExprIrStmtLocalDecl:
            continue
        if resultType == "" || resultType == "unknown" ||
           resultType == "call_expr" || !PrimaryObjectMetadataTextStable(resultType):
            continue
        if statementLine < foundLine ||
           (statementLine == foundLine && statementIndex <= foundIndex):
            continue
        if foundType != "" &&
           !PrimaryBodyIrTypeTextIsGenericPointer(foundType) &&
           PrimaryBodyIrTypeTextIsGenericPointer(resultType):
            continue
        foundLine = statementLine
        foundIndex = statementIndex
        foundType = resultType
    return foundType

@borrows
fn PrimaryBodyIrBindingTypeForName(typedIr: texpr.TypedExprIr,
                                    typedFn: texpr.TypedExprIrFunction,
                                    irFunction: lower.PrimaryObjectIrFunction,
                                    lineNumber: int32,
                                    nameRaw: str): str =
    let name = strutil.Strip(nameRaw)
    if name == "":
        return ""
    primaryBindingTierProbeTotal = primaryBindingTierProbeTotal + 1
    var traceFunction: bool
    if typedFn.functionName == "PureSystemLinkExecRunFull":
        traceFunction = true
    elif typedFn.functionName == "PureSystemLinkExecFixedOrdinaryRequest":
        traceFunction = true
    var traceName: bool
    if name == "parsedReq":
        traceName = true
    elif name == "req":
        traceName = true
    var traceMiss: bool
    if traceFunction:
        if traceName:
            traceMiss = true
    for i in 0..<irFunction.paramNames.len:
        if i >= irFunction.paramTypes.len:
            continue
        if irFunction.paramNames[i] == name:
            primaryBindingTierProbeParam = primaryBindingTierProbeParam + 1
            return irFunction.paramTypes[i]
    let localBindingType = texpr.TypedExprIrLookupLocalBindingType(typedIr,
                                                                   typedFn.sourcePath,
                                                                   typedFn.functionName,
                                                                   lineNumber,
                                                                   name)
    if localBindingType != "":
        primaryBindingTierProbeLocalHash = primaryBindingTierProbeLocalHash + 1
        if localBindingType == "range":
            return PrimaryBodyIrForBindingElementType(typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       lineNumber,
                                                       name)
        return localBindingType
    # 模块全局：对全局的赋值语句不是本地绑定证据（误判会让调用方给
    # 全局造同名未初始化本地槽，读取绕过 GlobalLoad）。仅 local_decl
    # （真实遮蔽声明）可作为绑定类型来源。
    let bindingNameGlobalType = PrimaryBodyIrTypedGlobalType(typedIr,
                                                             typedFn.sourcePath,
                                                             name)
    if traceMiss:
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"binding_type_lookup_local_miss function={typedFn.functionName} line={lineNumber} name={name} typed_start={typedFn.statementStart} typed_count={typedFn.statementCount} ir_stmt_count={irFunction.statements.len}")
    var foundType = PrimaryBodyIrStructuredStatementBindingType(irFunction,
                                                                 lineNumber,
                                                                 name,
                                                                 bindingNameGlobalType)
    if foundType != "":
        primaryBindingTierProbeIrScan = primaryBindingTierProbeIrScan + 1
    elif irFunction.statements.len <= 0:
        foundType = PrimaryBodyIrLazyTypedStatementBindingType(typedIr,
                                                               typedFn,
                                                               lineNumber,
                                                               name,
                                                               bindingNameGlobalType)
        if foundType != "":
            primaryBindingTierProbeTypedScan = primaryBindingTierProbeTypedScan + 1
    if traceMiss && foundType == "":
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"binding_type_lookup_miss function={typedFn.functionName} line={lineNumber} name={name}")
    if foundType == "":
        primaryBindingTierProbeMiss = primaryBindingTierProbeMiss + 1
        return ""
    if traceMiss:
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"binding_type_lookup_structured_candidate function={typedFn.functionName} line={lineNumber} result_len={foundType.len} stable={PrimaryObjectMetadataTextStable(foundType)}")
    if foundType == "range":
        return PrimaryBodyIrForBindingElementType(typedIr,
                                                   typedFn,
                                                   irFunction,
                                                   lineNumber,
                                                   name)
    return foundType

@borrows
fn PrimaryBodyIrTextHasDot(text: str): bool =
    for i in 0..<len(text):
        if text[i] == '.':
            return true
    return false

# Byte offset (into the STRIPPED text) just past the leading root identifier of a
# member-access text — the position of the first '.' or '[', or 0 when the text is
# empty / starts with a separator (no usable root). Mirrors the root parse in
# PrimaryBodyIrIndexedMemberAddressSlot so callers can recover the root name.
@borrows
fn PrimaryBodyIrTextRootIdentifierEnd(textRaw: str): int32 =
    let stripped = strutil.Strip(textRaw)
    if stripped == "":
        return 0
    var rootEnd = len(stripped)
    var scan = 0
    while scan < len(stripped):
        let ch = stripped[scan]
        if ch == '.' || ch == '[':
            rootEnd = scan
            break
        scan = scan + 1
    if rootEnd <= 0 || rootEnd > len(stripped):
        return 0
    return rootEnd

@borrows
fn PrimaryBodyIrSourceRootFromPath(sourcePath: str): str =
    let marker = "/src/"
    for i in 0..<len(sourcePath):
        if i + len(marker) > len(sourcePath):
            break
        if strings.SliceBytes(sourcePath, i, len(marker)) == marker:
            return strings.SliceBytes(sourcePath, 0, i)
    return ""

@borrows
fn PrimaryBodyIrModuleSourcePath(currentSourcePath: str,
                                  moduleNameRaw: str): str =
    var moduleName = strutil.Strip(moduleNameRaw)
    if moduleName == "":
        return ""
    if PrimaryStartsWith(moduleName, "cheng/"):
        moduleName = strings.SliceBytes(moduleName, 6, len(moduleName) - 6)
    let root = PrimaryBodyIrSourceRootFromPath(currentSourcePath)
    if root == "":
        return ""
    var workspaceRoot = share(root)
    let rootBase = chengpath.PathBaseName(root)
    if rootBase == "codex" || rootBase == "rust-csg-core":
        let parentRoot = chengpath.PathParentDir(root)
        if parentRoot != "":
            workspaceRoot = parentRoot
    let packageIdRaw = parser.ParserPackageId(root)
    var packagePrefix = packageIdRaw
    if PrimaryStartsWith(packagePrefix, "cheng/"):
        packagePrefix = strings.SliceBytes(packagePrefix, 6, len(packagePrefix) - 6)
    if packagePrefix != "":
        let packagePrefixSlash = Fmt"{packagePrefix}/"
        if PrimaryStartsWith(moduleName, packagePrefixSlash):
            let packageModule = strings.SliceBytes(moduleName,
                                                  len(packagePrefixSlash),
                                                  len(moduleName) - len(packagePrefixSlash))
            let manifestText = parser.ParserPackageManifestText(root)
            var sourceRoot = parser.ParserManifestValue(manifestText, "root")
            if sourceRoot == "":
                sourceRoot = "src"
            return Fmt"{root}/{sourceRoot}/{packageModule}.cheng"
    if PrimaryStartsWith(moduleName, "codex/"):
        let packageModule = strings.SliceBytes(moduleName, 6, len(moduleName) - 6)
        return Fmt"{workspaceRoot}/codex/src/{packageModule}.cheng"
    if PrimaryStartsWith(moduleName, "rust-csg-core/"):
        let packageModule = strings.SliceBytes(moduleName, 14, len(moduleName) - 14)
        return Fmt"{workspaceRoot}/rust-csg-core/src/{packageModule}.cheng"
    if (rootBase == "codex" || rootBase == "rust-csg-core") &&
       (PrimaryStartsWith(moduleName, "std/") ||
        PrimaryStartsWith(moduleName, "core/")):
        return Fmt"{workspaceRoot}/src/{moduleName}.cheng"
    return Fmt"{root}/src/{moduleName}.cheng"

@borrows
fn PrimaryBodyIrCanonicalImportTargetSourcePath(typedIr: texpr.TypedExprIr,
                                                 currentSourcePath: str,
                                                 qualifierRaw: str): str =
    let qualifier = strutil.Strip(qualifierRaw)
    if currentSourcePath == "" || qualifier == "":
        return ""
    var targetSourcePath: str
    let state = texpr.TypedExprIrImportAliasTargetState(typedIr,
                                                        currentSourcePath,
                                                        qualifier,
                                                        targetSourcePath)
    if state == texpr.TypedExprBuildIndexAmbiguous:
        panic(Fmt"primary object: ambiguous import qualifier source={currentSourcePath} qualifier={qualifier}")
    if state != texpr.TypedExprBuildIndexUnique:
        return ""
    return targetSourcePath

@borrows
fn PrimaryBodyIrCanonicalTypeIsEnum(typedIr: texpr.TypedExprIr,
                                     sourcePath: str,
                                     typeRaw: str): bool =
    return texpr.TypedExprIrTypeIsEnum(typedIr, sourcePath, typeRaw)

@borrows
fn PrimaryBodyIrTypeBracketArgs(typeTextRaw: str): str[] =
    var argsOut: str[]
    let typeText = chengpath.PathTrim(typeTextRaw)
    let openPos = parser.ParserFindText(typeText, "[")
    if openPos <= 0:
        return argsOut
    let closePos = texpr.TypedExprFindMatchingBracket(typeText, openPos)
    if closePos <= openPos:
        return argsOut
    let inner = chengpath.TextSlice(typeText, openPos + 1, closePos - openPos - 1)
    if chengpath.PathTrim(inner) == "":
        return argsOut
    var depth: int32
    var partStart: int32
    for i in 0..<inner.len:
        let ch = inner[i]
        if ch == '[':
            depth = depth + 1
        elif ch == ']':
            depth = depth - 1
        elif ch == ',' && depth == 0:
            add(argsOut, chengpath.PathTrim(chengpath.TextSlice(inner, partStart, i - partStart)))
            partStart = i + 1
    add(argsOut, chengpath.PathTrim(chengpath.TextSlice(inner, partStart, inner.len - partStart)))
    return argsOut

@borrows
fn PrimaryBodyIrCanonicalTypeLayout(typedIr: texpr.TypedExprIr,
                                     sourcePathRaw: str,
                                     _sourceTextRaw: str,
                                     typeRaw: str,
                                     _depth: int32,
                                     sizeBytes: var int32,
                                     alignBytes: var int32): bool =
    var fieldCount: int32
    if !texpr.TypedExprIrLookupTypeLayout(typedIr,
                                          sourcePathRaw,
                                          typeRaw,
                                          sizeBytes,
                                          alignBytes,
                                          fieldCount):
        sizeBytes = 0
        alignBytes = 0
        return false
    if sizeBytes <= 0 || alignBytes <= 0:
        panic(Fmt"primary: canonical type layout invalid source={sourcePathRaw} type={typeRaw} size={sizeBytes} align={alignBytes}")
    return true

@borrows
fn PrimaryBodyIrCanonicalFieldShape(typedIr: texpr.TypedExprIr,
                                    sourcePath: str,
                                    _sourceText: str,
                                    fieldTypeRaw: str,
                                    _depth: int32,
                                    fieldSizeBytes: var int32,
                                    fieldAlignBytes: var int32): bool =
    var fieldCount: int32
    if texpr.TypedExprIrLookupTypeLayout(typedIr,
                                         sourcePath,
                                         fieldTypeRaw,
                                         fieldSizeBytes,
                                         fieldAlignBytes,
                                         fieldCount):
        if fieldSizeBytes <= 0 || fieldAlignBytes <= 0:
            panic(Fmt"primary: canonical field shape invalid source={sourcePath} type={fieldTypeRaw} size={fieldSizeBytes} align={fieldAlignBytes}")
        return true
    if PrimaryBodyIrCanonicalTypeIsEnum(typedIr, sourcePath, fieldTypeRaw):
        fieldSizeBytes = 4
        fieldAlignBytes = 4
        return true
    fieldSizeBytes = 0
    fieldAlignBytes = 0
    return false

@borrows
fn PrimaryBodyIrCanonicalFieldMeta(typedIr: texpr.TypedExprIr,
                                    sourcePathRaw: str,
                                    ownerTypeRaw: str,
                                    fieldNameRaw: str,
                                    fieldType: var str,
                                    fieldOffsetBytes: var int32,
                                    fieldSizeBytes: var int32,
                                    fieldAlignBytes: var int32): bool =
    fieldType = ""
    fieldOffsetBytes = 0
    fieldSizeBytes = 0
    fieldAlignBytes = 0
    var fieldTypeSourcePath: str
    var ownerType = texpr.TypedExprStripVarType(ownerTypeRaw)
    let ownerPointeeType = PrimaryBodyIrPointeeTypeTextForSource(typedIr,
                                                                 sourcePathRaw,
                                                                 ownerType)
    if ownerPointeeType != "":
        ownerType = ownerPointeeType
    var fieldRow: int32
    let state = texpr.TypedExprIrCanonicalFieldMetaState(typedIr,
                                                          strings.CloneStr(sourcePathRaw),
                                                          ownerType,
                                                          fieldNameRaw,
                                                          fieldTypeSourcePath,
                                                          fieldType,
                                                          fieldOffsetBytes,
                                                          fieldSizeBytes,
                                                          fieldAlignBytes,
                                                          fieldRow)
    if state == texpr.TypedExprBuildIndexAmbiguous:
        panic(Fmt"primary: canonical field metadata ambiguous source={sourcePathRaw} owner={ownerType} field={fieldNameRaw}")
    return state == texpr.TypedExprBuildIndexUnique

@borrows
fn PrimaryBodyIrLookupResultFieldMeta(typedIr: texpr.TypedExprIr,
                                      sourcePathRaw: str,
                                      ownerTypeRaw: str,
                                      fieldNameRaw: str,
                                      fieldType: var str,
                                      fieldOffsetBytes: var int32,
                                      fieldSizeBytes: var int32,
                                      fieldAlignBytes: var int32): bool =
    fieldType = ""
    fieldOffsetBytes = 0
    fieldSizeBytes = 0
    fieldAlignBytes = 0
    let ownerType = texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(ownerTypeRaw))
    let fieldName = strutil.Strip(fieldNameRaw)
    var resultType = ownerType
    if !PrimaryStartsWith(resultType, "Result["):
        let resultDotPos = texpr.TypedExprFindTopLevelTextToken(resultType, ".Result[")
        if resultDotPos < 0:
            return false
        resultType = strings.SliceBytes(resultType,
                                        resultDotPos + 1,
                                        len(resultType) - resultDotPos - 1)
    var resultTypeInvalid: bool
    if len(resultType) <= 8:
        resultTypeInvalid = true
    elif strings.SliceBytes(resultType, len(resultType) - 1, 1) != "]":
        resultTypeInvalid = true
    elif fieldName == "":
        resultTypeInvalid = true
    if resultTypeInvalid:
        return false
    let innerType = strings.SliceBytes(resultType, 7, len(resultType) - 8)
    if fieldName == "ok":
        fieldType = "bool"
        fieldOffsetBytes = 0
        fieldSizeBytes = 1
        fieldAlignBytes = 1
        return true
    var valueKind: int32
    var valueSize: int32
    var valueAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePathRaw,
                                   innerType,
                                   valueKind,
                                   valueSize,
                                   valueAlign)
    var valueShapeMissing: bool
    if valueSize <= 0:
        valueShapeMissing = true
    elif valueAlign <= 0:
        valueShapeMissing = true
    if valueShapeMissing:
        let innerLeaf = texpr.TypedExprTypeLeafName(innerType)
        if PrimaryBodyIrCanonicalFieldShape(typedIr,
                                                sourcePathRaw,
                                                "",
                                                innerType,
                                                0,
                                                valueSize,
                                                valueAlign):
            valueKind = PrimaryBodyIrTypeKindFromText(innerType)
        elif innerLeaf == "CompilerEmit":
            valueKind = coreir.LocalI32Tag
            valueSize = 4
            valueAlign = 4
        else:
            return false
    let valueOffset = PrimaryBodyIrAlignedOffset(1, valueAlign)
    let errOffset = PrimaryBodyIrAlignedOffset(valueOffset + valueSize, 8)
    if fieldName == "value":
        fieldType = innerType
        fieldOffsetBytes = valueOffset
        fieldSizeBytes = valueSize
        fieldAlignBytes = valueAlign
        return true
    if fieldName == "err":
        fieldType = "ErrorInfo"
        fieldOffsetBytes = errOffset
        fieldSizeBytes = 32
        fieldAlignBytes = 8
        return true
    if fieldName == "err.code":
        fieldType = "int32"
        fieldOffsetBytes = errOffset
        fieldSizeBytes = 4
        fieldAlignBytes = 4
        return true
    if fieldName == "err.msg":
        fieldType = "str"
        fieldOffsetBytes = errOffset + 8
        fieldSizeBytes = 24
        fieldAlignBytes = 8
        return true
    return false

# Option[T] = { has: bool@0; value: T@align(1,alignT) } builtin generic field
# metadata, mirroring PrimaryBodyIrLookupResultFieldMeta above (has replaces ok,
# no err trailer). The generic-instance text `Option[Inner]` has no concrete
# entry in the typed-ir field registry (the registry only records the template
# owner "Option" with `value: T` at an unsubstituted-T offset), so the registry
# path resolves the wrong `value` offset for each concrete instantiation. Resolve
# the concrete offset here — tried before the registry lookup in the dispatch —
# so it stays byte-consistent with the TypeShapeFromText Option slot sizing and
# the front-end TypedExprTypeLayoutImpl Option handler.
@borrows
fn PrimaryBodyIrLookupOptionFieldMeta(typedIr: texpr.TypedExprIr,
                                      sourcePathRaw: str,
                                      ownerTypeRaw: str,
                                      fieldNameRaw: str,
                                      fieldType: var str,
                                      fieldOffsetBytes: var int32,
                                      fieldSizeBytes: var int32,
                                      fieldAlignBytes: var int32): bool =
    fieldType = ""
    fieldOffsetBytes = 0
    fieldSizeBytes = 0
    fieldAlignBytes = 0
    let ownerType = texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(ownerTypeRaw))
    let fieldName = strutil.Strip(fieldNameRaw)
    var optionType = ownerType
    if !PrimaryStartsWith(optionType, "Option["):
        let optionDotPos = texpr.TypedExprFindTopLevelTextToken(optionType, ".Option[")
        if optionDotPos < 0:
            return false
        optionType = strings.SliceBytes(optionType,
                                        optionDotPos + 1,
                                        len(optionType) - optionDotPos - 1)
    var optionTypeInvalid: bool
    if len(optionType) <= 8:
        optionTypeInvalid = true
    elif strings.SliceBytes(optionType, len(optionType) - 1, 1) != "]":
        optionTypeInvalid = true
    elif fieldName == "":
        optionTypeInvalid = true
    if optionTypeInvalid:
        return false
    let innerType = strings.SliceBytes(optionType, 7, len(optionType) - 8)
    if fieldName == "has":
        fieldType = "bool"
        fieldOffsetBytes = 0
        fieldSizeBytes = 1
        fieldAlignBytes = 1
        return true
    var valueKind: int32
    var valueSize: int32
    var valueAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePathRaw,
                                   innerType,
                                   valueKind,
                                   valueSize,
                                   valueAlign)
    var valueShapeMissing: bool
    if valueSize <= 0:
        valueShapeMissing = true
    elif valueAlign <= 0:
        valueShapeMissing = true
    if valueShapeMissing:
        if PrimaryBodyIrCanonicalFieldShape(typedIr,
                                                sourcePathRaw,
                                                "",
                                                innerType,
                                                0,
                                                valueSize,
                                                valueAlign):
            valueKind = PrimaryBodyIrTypeKindFromText(innerType)
        else:
            return false
    let valueOffset = PrimaryBodyIrAlignedOffset(1, valueAlign)
    if fieldName == "value":
        fieldType = innerType
        fieldOffsetBytes = valueOffset
        fieldSizeBytes = valueSize
        fieldAlignBytes = valueAlign
        return true
    return false

# Resolve an opaque `typeof(expr)` type text to its concrete element/root type,
# so field-metadata lookups on locals declared `var e: typeof(seqOfTuples[0])`
# reach the real anonymous-tuple aggregate. Returns "" when not a typeof text or
# the inner binding type is unavailable.
@borrows
fn PrimaryBodyIrResolveTypeOfTypeText(typedIr: texpr.TypedExprIr,
                                       typedFn: texpr.TypedExprIrFunction,
                                       irFunction: lower.PrimaryObjectIrFunction,
                                       lineNumber: int32,
                                       typeTextRaw: str): str =
    let typeText = strutil.Strip(typeTextRaw)
    if len(typeText) < 9:
        return ""
    if strings.SliceBytes(typeText, 0, 7) != "typeof(":
        return ""
    if strings.SliceBytes(typeText, len(typeText) - 1, 1) != ")":
        return ""
    let innerExpr = strings.CloneStr(strutil.Strip(strings.SliceBytes(typeText, 7, len(typeText) - 8)))
    if innerExpr == "":
        return ""
    var typeofBase = strings.CloneStr(innerExpr)
    var indexBaseName = ""
    var indexBaseIdx = ""
    if PrimaryBodyIrIndexExprParts(innerExpr, indexBaseName, indexBaseIdx):
        typeofBase = strings.CloneStr(strutil.Strip(indexBaseName))
    if typeofBase == "":
        return ""
    let baseType = PrimaryBodyIrBindingTypeForName(typedIr,
                                                    typedFn,
                                                    irFunction,
                                                    lineNumber,
                                                    typeofBase)
    if baseType == "":
        return ""
    if len(baseType) >= 2 &&
       strings.SliceBytes(baseType, len(baseType) - 2, 2) == "[]":
        return strings.CloneStr(strings.SliceBytes(baseType, 0, len(baseType) - 2))
    return strings.CloneStr(baseType)

# Field metadata for an anonymous tuple/record type text `array<f0:t0,f1:t1,...>`
# by summing per-field shapes from PrimaryBodyIrTypeShapeFromText with alignment.
# Lets `e.field = rhs` / `e.field` lower on a local declared
# `var e: typeof(seqOfTuples[0])` without a named struct declaration.
@borrows
fn PrimaryBodyIrTupleFieldMeta(typedIr: texpr.TypedExprIr,
                                sourcePath: str,
                                ownerTypeRaw: str,
                                fieldNameRaw: str,
                                fieldType: var str,
                                fieldOffsetBytes: var int32,
                                fieldSizeBytes: var int32,
                                fieldAlignBytes: var int32): bool =
    fieldType = ""
    fieldOffsetBytes = 0
    fieldSizeBytes = 0
    fieldAlignBytes = 0
    let ownerType = strutil.Strip(ownerTypeRaw)
    let fieldName = strutil.Strip(fieldNameRaw)
    if fieldName == "" || len(ownerType) < 8:
        return false
    if strings.SliceBytes(ownerType, 0, 6) != "array<":
        return false
    if strings.SliceBytes(ownerType, len(ownerType) - 1, 1) != ">":
        return false
    let inner = strings.SliceBytes(ownerType, 6, len(ownerType) - 7)
    let parts = texpr.TypedExprSplitTopLevelCsv(inner)
    if parts.len <= 0:
        return false
    var cursor: int32
    cursor = 0
    for partIndex in 0..<parts.len:
        let part = strutil.Strip(parts[partIndex])
        var colonPos: int32
        colonPos = 0
        while colonPos < len(part):
            if strings.SliceBytes(part, colonPos, 1) == ":":
                break
            colonPos = colonPos + 1
        if colonPos >= len(part):
            return false
        let partName = strutil.Strip(strings.SliceBytes(part, 0, colonPos))
        let partType = strutil.Strip(strings.SliceBytes(part, colonPos + 1, len(part) - colonPos - 1))
        if partName == "" || partType == "":
            return false
        var shapeKind: int32
        var shapeSize: int32
        var shapeAlign: int32
        PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, partType, shapeKind, shapeSize, shapeAlign)
        if shapeSize <= 0:
            return false
        if shapeAlign > 0 && cursor % shapeAlign != 0:
            cursor = cursor + (shapeAlign - cursor % shapeAlign)
        if partName == fieldName:
            fieldType = partType
            fieldOffsetBytes = cursor
            fieldSizeBytes = shapeSize
            fieldAlignBytes = shapeAlign
        cursor = cursor + shapeSize
    return fieldType != ""

# Anonymous tuple literal `array<name:type, name2:type2, ...>` 不在命名类型注册表,
# TypeShapeFromText 返 size 0、字段表查不到 → 每个 seq-of-anon-tuple 链 bail
# (bail_44 on `scored[i].item` where scored: array<item:..., score:...>[])。
# 字段列表全文编码,直接解析(括号感知)。fieldName=="" → 返整 size/align;否则返该字段 meta。
@borrows
fn PrimaryBodyIrAnonTupleFieldMeta(typedIr: texpr.TypedExprIr,
                                   sourcePath: str,
                                   typeRaw: str,
                                   fieldNameRaw: str,
                                   fieldTypeOut: var str,
                                   fieldOffsetOut: var int32,
                                   fieldSizeOut: var int32,
                                   fieldAlignOut: var int32,
                                   wholeSizeOut: var int32,
                                   wholeAlignOut: var int32): bool =
    fieldTypeOut = ""
    fieldOffsetOut = 0
    fieldSizeOut = 0
    fieldAlignOut = 0
    wholeSizeOut = 0
    wholeAlignOut = 0
    let t = texpr.TypedExprStripVarType(typeRaw)
    if len(t) < 7 || !PrimaryStartsWith(t, "array<") || t[len(t) - 1] != '>':
        return false
    let inner = strings.SliceBytes(t, 6, len(t) - 7)
    if inner == "":
        return false
    var pos: int32
    var offset: int32
    var maxAlign: int32
    var found: bool
    while pos < len(inner):
        var nameEnd: int32 = pos
        var depth: int32
        while nameEnd < len(inner):
            let ch = inner[nameEnd]
            if ch == '<' || ch == '[' || ch == '(':
                depth = depth + 1
            elif ch == '>' || ch == ']' || ch == ')':
                depth = depth - 1
            elif ch == ':' && depth == 0:
                break
            nameEnd = nameEnd + 1
        let fName = strutil.Strip(strings.SliceBytes(inner, pos, nameEnd - pos))
        var typeEnd: int32 = nameEnd + 1
        depth = 0
        while typeEnd < len(inner):
            let ch = inner[typeEnd]
            if ch == '<' || ch == '[' || ch == '(':
                depth = depth + 1
            elif ch == '>' || ch == ']' || ch == ')':
                depth = depth - 1
            elif ch == ',' && depth == 0:
                break
            typeEnd = typeEnd + 1
        let fType = strutil.Strip(strings.SliceBytes(inner, nameEnd + 1, typeEnd - nameEnd - 1))
        pos = typeEnd + 1
        if fName == "" || fType == "":
            return false
        var fKind: int32
        var fSize: int32
        var fAlign: int32
        PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, fType, fKind, fSize, fAlign)
        if fSize <= 0:
            return false
        if fAlign <= 0:
            fAlign = 1
        if fAlign > maxAlign:
            maxAlign = fAlign
        offset = PrimaryBodyIrAlignedOffset(offset, fAlign)
        if fName == fieldNameRaw && !found:
            fieldTypeOut = fType
            fieldOffsetOut = offset
            fieldSizeOut = fSize
            fieldAlignOut = fAlign
            found = true
        offset = offset + fSize
    if maxAlign <= 0:
        return false
    wholeSizeOut = PrimaryBodyIrAlignedOffset(offset, maxAlign)
    wholeAlignOut = maxAlign
    return found || fieldNameRaw == ""

@borrows
fn PrimaryBodyIrLookupSingleFieldMeta(typedIr: texpr.TypedExprIr,
                                       sourcePathRaw: str,
                                       ownerTypeRaw: str,
                                       fieldNameRaw: str,
                                       fieldType: var str,
                                       fieldOffsetBytes: var int32,
                                       fieldSizeBytes: var int32,
                                       fieldAlignBytes: var int32): bool =
    fieldType = ""
    fieldOffsetBytes = 0
    fieldSizeBytes = 0
    fieldAlignBytes = 0
    let ownerType = texpr.TypedExprStripVarType(share(ownerTypeRaw))
    let fieldName = strutil.Strip(share(fieldNameRaw))
    if ownerType == "" || fieldName == "":
        return false
    # form60: multi-segment field paths belong to FieldPathMeta, not Single.
    if PrimaryBodyIrTextHasDot(fieldName):
        return false
    var ownerTypeIsDynamicSeq: bool
    if len(ownerType) >= 2:
        let ownerTypeSuffix = strings.SliceBytes(ownerType, len(ownerType) - 2, 2)
        if ownerTypeSuffix == "[]":
            ownerTypeIsDynamicSeq = true
    if ownerTypeIsDynamicSeq:
        if fieldName == "len":
            fieldType = "int32"
            fieldOffsetBytes = 0
            fieldSizeBytes = 4
            fieldAlignBytes = 4
            return true
        if fieldName == "cap":
            fieldType = "int32"
            fieldOffsetBytes = 4
            fieldSizeBytes = 4
            fieldAlignBytes = 4
            return true
        if fieldName == "buffer":
            fieldType = "ptr"
            fieldOffsetBytes = 8
            fieldSizeBytes = 8
            fieldAlignBytes = 8
            return true
        return false
    # Anonymous tuple owner `array<name:type,...>`:字段注册表只键命名类型,
    # LookupSingleFieldMeta miss → 链式 walker 死(bail_44 on `scored[i].item`)。
    # 解析字面字段列表返命名字段。
    if !ownerTypeIsDynamicSeq &&
       PrimaryStartsWith(ownerType, "array<") &&
       len(ownerType) > 7 &&
       ownerType[len(ownerType) - 1] == '>':
        var atFType = ""
        var atOff: int32
        var atSize: int32
        var atAlign: int32
        var atWholeSize: int32
        var atWholeAlign: int32
        if PrimaryBodyIrAnonTupleFieldMeta(typedIr,
                                           sourcePathRaw,
                                           ownerType,
                                           fieldName,
                                           atFType,
                                           atOff,
                                           atSize,
                                           atAlign,
                                           atWholeSize,
                                           atWholeAlign) &&
           atSize > 0:
            fieldType = atFType
            fieldOffsetBytes = atOff
            fieldSizeBytes = atSize
            fieldAlignBytes = atAlign
            return true
    var resultFieldType: str
    var resultFieldOffsetBytes: int32
    var resultFieldSizeBytes: int32
    var resultFieldAlignBytes: int32
    if PrimaryBodyIrLookupOptionFieldMeta(typedIr,
                                          sourcePathRaw,
                                          ownerType,
                                          fieldName,
                                          resultFieldType,
                                          resultFieldOffsetBytes,
                                          resultFieldSizeBytes,
                                          resultFieldAlignBytes):
        fieldType = resultFieldType
        fieldOffsetBytes = resultFieldOffsetBytes
        fieldSizeBytes = resultFieldSizeBytes
        fieldAlignBytes = resultFieldAlignBytes
        return true
    if PrimaryBodyIrLookupResultFieldMeta(typedIr,
                                          sourcePathRaw,
                                          ownerType,
                                          fieldName,
                                          resultFieldType,
                                          resultFieldOffsetBytes,
                                          resultFieldSizeBytes,
                                          resultFieldAlignBytes):
        fieldType = resultFieldType
        fieldOffsetBytes = resultFieldOffsetBytes
        fieldSizeBytes = resultFieldSizeBytes
        fieldAlignBytes = resultFieldAlignBytes
        return true
    return PrimaryBodyIrCanonicalFieldMeta(typedIr,
                                           sourcePathRaw,
                                           ownerType,
                                           fieldName,
                                           fieldType,
                                           fieldOffsetBytes,
                                           fieldSizeBytes,
                                           fieldAlignBytes)

# bail=32 (R-G): 多级字段路径元数据 walker——`root.a.b.c` 沿段逐跳
# LookupSingleFieldMeta 并累加内联偏移(与 SeqRefForText 14300 段游走同构)。
# 每段必须精确解析且中间段为内联聚合布局(偏移在父布局内), 任一段 miss →
# false(调用方既有 bail 路径接管, 无静默落穿)。单段路径与直接调
# LookupSingleFieldMeta 完全等价。
@borrows
fn PrimaryBodyIrLookupFieldPathMeta(typedIr: texpr.TypedExprIr,
                                     sourcePathRaw: str,
                                     rootTypeRaw: str,
                                     fieldPathRaw: str,
                                     leafType: var str,
                                     leafOffsetBytes: var int32,
                                     leafSizeBytes: var int32,
                                     leafAlignBytes: var int32): bool =
    leafType = ""
    leafOffsetBytes = 0
    leafSizeBytes = 0
    leafAlignBytes = 0
    var fpOwnerType = texpr.TypedExprStripVarType(rootTypeRaw)
    var fpRest = strutil.Strip(fieldPathRaw)
    if fpOwnerType == "" || fpRest == "":
        return false
    var fpAccumOffset: int32
    while fpRest != "":
        var fpSegment = ""
        var fpSegmentDot: int32
        fpSegmentDot = -1
        for fpSegIndex in 0..<len(fpRest):
            if PrimaryBodyIrTextByteCodeEquals(fpRest, fpSegIndex, 46):
                fpSegmentDot = fpSegIndex
                break
        if fpSegmentDot >= 0:
            fpSegment = strutil.Strip(strings.SliceBytes(fpRest, 0, fpSegmentDot))
            fpRest = strutil.Strip(strings.SliceBytes(fpRest,
                                                      fpSegmentDot + 1,
                                                      len(fpRest) - fpSegmentDot - 1))
        else:
            fpSegment = fpRest
            fpRest = ""
        if fpSegment == "":
            return false
        var fpSegType = ""
        var fpSegOffset: int32
        var fpSegSize: int32
        var fpSegAlign: int32
        if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                               sourcePathRaw,
                                               fpOwnerType,
                                               fpSegment,
                                               fpSegType,
                                               fpSegOffset,
                                               fpSegSize,
                                               fpSegAlign):
            return false
        fpAccumOffset = fpAccumOffset + fpSegOffset
        leafType = strings.CloneStr(fpSegType)
        leafSizeBytes = fpSegSize
        leafAlignBytes = fpSegAlign
        fpOwnerType = texpr.TypedExprStripVarType(fpSegType)
    leafOffsetBytes = fpAccumOffset
    return leafType != "" && leafSizeBytes > 0

@borrows
fn PrimaryBodyIrTypeDefinitionSourcePath(typedIr: texpr.TypedExprIr,
                                          sourcePathRaw: str,
                                          typeRaw: str): str =
    let typeText = texpr.TypedExprStripVarType(typeRaw)
    let dotPos = texpr.TypedExprQualifiedTypeDot(typeText)
    if dotPos <= 0:
        return sourcePathRaw
    let qualifier = strutil.Strip(strings.SliceBytes(typeText, 0, dotPos))
    if qualifier == "":
        return sourcePathRaw
    var targetSourcePath = texpr.TypedExprIrLookupTypeAliasTargetSourcePath(typedIr,
                                                                           sourcePathRaw,
                                                                           qualifier)
    if targetSourcePath == "":
        targetSourcePath = PrimaryBodyIrCanonicalImportTargetSourcePath(typedIr,
                                                                         sourcePathRaw,
                                                                         qualifier)
    if targetSourcePath == "":
        return sourcePathRaw
    return targetSourcePath

@borrows
fn PrimaryBodyIrNormalizeFieldTypeForSource(typedIr: texpr.TypedExprIr,
                                             sourcePathRaw: str,
                                             fieldTypeRaw: str,
                                             normalizedSourcePath: var str): str =
    normalizedSourcePath = sourcePathRaw
    let fieldType = texpr.TypedExprStripVarType(fieldTypeRaw)
    if fieldType == "":
        return ""
    let definitionSourcePath = PrimaryBodyIrTypeDefinitionSourcePath(typedIr,
                                                                     sourcePathRaw,
                                                                     fieldType)
    if definitionSourcePath != sourcePathRaw:
        normalizedSourcePath = definitionSourcePath
        let leaf = texpr.TypedExprTypeLeafName(fieldType)
        if leaf != "":
            # bail=44 R4: TypeLeafName 对限定动态 seq 字段类型 (langintern.InternId[])
            # 在 '[' 截断丢 `[]` 后缀 → 16B seq 头字段按裸元素别名 (int32 4B) 建槽,
            # AppendFieldLoadToSlot 尺寸门失败 → bail_434/44。定义源重试保留 seq
            # 后缀:元素 leaf 归一到定义源,seq 形状由 TypeShapeFromText `[]` 臂定形。
            if len(fieldType) >= 2 &&
               strings.SliceBytes(fieldType, len(fieldType) - 2, 2) == "[]":
                return Fmt"{leaf}[]"
            return leaf
    return fieldType

@borrows
fn PrimaryBodyIrLookupChainFieldMeta(typedIr: texpr.TypedExprIr,
                                      sourcePathRaw: str,
                                      ownerTypeRaw: str,
                                      fieldNameRaw: str,
                                      fieldType: var str,
                                      fieldOffsetBytes: var int32,
                                      fieldSizeBytes: var int32,
                                      fieldAlignBytes: var int32,
                                      nextSourcePath: var str): bool =
    fieldType = ""
    fieldOffsetBytes = 0
    fieldSizeBytes = 0
    fieldAlignBytes = 0
    nextSourcePath = sourcePathRaw
    var ownerDefinitionSourcePath = PrimaryBodyIrTypeDefinitionSourcePath(typedIr,
                                                                         sourcePathRaw,
                                                                         ownerTypeRaw)
    let fieldMetaOk = PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                                         sourcePathRaw,
                                                         ownerTypeRaw,
                                                         fieldNameRaw,
                                                         fieldType,
                                                         fieldOffsetBytes,
                                                         fieldSizeBytes,
                                                         fieldAlignBytes)
    if !fieldMetaOk:
        return false
    if ownerDefinitionSourcePath == "":
        ownerDefinitionSourcePath = sourcePathRaw
    var normalizedSourcePath = strings.CloneStr(ownerDefinitionSourcePath)
    let normalizedFieldType = PrimaryBodyIrNormalizeFieldTypeForSource(typedIr,
                                                                      share(ownerDefinitionSourcePath),
                                                                      fieldType,
                                                                      normalizedSourcePath)
    if normalizedFieldType == "":
        return false
    fieldType = normalizedFieldType
    nextSourcePath = normalizedSourcePath
    return true

@borrows
fn PrimaryBodyIrMaterializeFieldArgSlot(bodyIR: var coreir.BodyIR,
                                         slotNames: var str[],
                                         typedIr: texpr.TypedExprIr,
                                         typedFn: texpr.TypedExprIrFunction,
                                         irFunction: lower.PrimaryObjectIrFunction,
                                         sourcePath: str,
                                         lineNumber: int32,
                                         argTextRaw: str,
                                         failureDetail0: var int32,
                                         failureDetail1: var int32): int32 =
    let argText = strutil.Strip(strings.CloneStr(argTextRaw))
    var lookupSourcePath = strings.CloneStr(sourcePath)
    if lookupSourcePath == "":
        lookupSourcePath = strings.CloneStr(typedFn.sourcePath)
    if !texpr.TypedExprTextIsSimpleFieldPath(argText):
        failureDetail0 = 431
        return -1
    let rootName = texpr.TypedExprAssignLhsRootName(argText)
    let fieldPath = texpr.TypedExprAssignFieldPath(argText)
    if rootName == "" || fieldPath == "":
        failureDetail0 = 432
        return -1
    let rootType = strings.CloneStr(PrimaryBodyIrBindingTypeForName(typedIr,
                                                                      typedFn,
                                                                      irFunction,
                                                                      lineNumber,
                                                                      rootName))
    if rootType == "" || rootType == "unknown" || !PrimaryObjectMetadataTextStable(rootType):
        failureDetail0 = 433
        return -1
    var rootLayoutType = strutil.Strip(
        texpr.TypedExprStripVarType(strings.CloneStr(rootType)))
    if rootLayoutType == "":
        rootLayoutType = strings.CloneStr(rootType)
    var fieldType = ""
    var fieldOffsetBytes: int32
    var fieldSizeBytes: int32
    var fieldAlignBytes: int32
    var fieldMetaOk = PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                                         lookupSourcePath,
                                                         rootLayoutType,
                                                         fieldPath,
                                                         fieldType,
                                                         fieldOffsetBytes,
                                                         fieldSizeBytes,
                                                         fieldAlignBytes)
    if PrimaryBodyIrTextHasDot(fieldPath):
        fieldMetaOk = false
    if !fieldMetaOk:
        fieldMetaOk = PrimaryBodyIrLookupFieldPathMeta(typedIr,
                                                       lookupSourcePath,
                                                       rootLayoutType,
                                                       fieldPath,
                                                       fieldType,
                                                       fieldOffsetBytes,
                                                       fieldSizeBytes,
                                                       fieldAlignBytes)
    # bail=44 R2: 单层 field metadata miss 回退链式 walker (范式 :14203
    # PrimaryBodyIrIndexedMemberAddressSlot 的 .field 段解析)。LookupChainFieldMeta
    # 在 LookupSingleFieldMeta 之上加 ownerDefinitionSourcePath 重试 + 字段类型/源
    # 归一化,恢复跨模块 owner 定义路径的 single-field call-arg metadata (此前单层
    # field 在此 miss → 直接 bail_434,缺 owner-定义源重试;链式 walker 6119 仅解
    # dot 路径,单层无 dot 被门控跳过)。命中即流向 6211 happy path 物化;仍 miss
    # 落 6105 block 既有 434 poison,不落穿弱 fallback 读栈垃圾 (CLAUDE.md 4b.4)。
    if !fieldMetaOk && !PrimaryBodyIrTextHasDot(fieldPath):
        var singleFieldChainNextSource = strings.CloneStr(lookupSourcePath)
        fieldMetaOk = PrimaryBodyIrLookupChainFieldMeta(typedIr,
                                                        lookupSourcePath,
                                                        rootLayoutType,
                                                        fieldPath,
                                                        fieldType,
                                                        fieldOffsetBytes,
                                                        fieldSizeBytes,
                                                        fieldAlignBytes,
                                                        singleFieldChainNextSource)
        if fieldMetaOk:
            lookupSourcePath = singleFieldChainNextSource
    if !fieldMetaOk:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=field_arg_meta_direct_fail function=",
                                                       strings.CloneStr(typedFn.functionName),
                                                       " line=",
                                                       strings.IntToStr(lineNumber),
                                                       " arg=",
                                                       strings.CloneStr(argText),
                                                       " root_type=",
                                                       strings.CloneStr(rootType),
                                                       " root_layout_type=",
                                                       strings.CloneStr(rootLayoutType),
                                                       " field_path=",
                                                       strings.CloneStr(fieldPath)], ""))
        if PrimaryBodyIrTextHasDot(fieldPath):
            var cursor: int32
            var currentRootName = strings.CloneStr(rootName)
            var currentRootType = strings.CloneStr(rootLayoutType)
            var currentLoadRootType = strings.CloneStr(rootType)
            var currentSourcePath = strings.CloneStr(lookupSourcePath)
            var currentPrefix = strings.CloneStr(rootName)
            var finalSlot: int32
            finalSlot = -1
            var nestedOk = true
            while cursor < len(fieldPath) && nestedOk:
                var dotPos = -1
                for scan in cursor..<len(fieldPath):
                    if fieldPath[scan] == '.':
                        dotPos = scan
                        break
                var part = ""
                if dotPos >= 0:
                    part = strings.SliceBytes(fieldPath, cursor, dotPos - cursor)
                else:
                    part = strings.SliceBytes(fieldPath, cursor, len(fieldPath) - cursor)
                part = strutil.Strip(part)
                if part == "":
                    nestedOk = false
                    break
                var partType = ""
                var partOffsetBytes: int32
                var partSizeBytes: int32
                var partAlignBytes: int32
                var nextSourcePath = strings.CloneStr(currentSourcePath)
                if !PrimaryBodyIrLookupChainFieldMeta(typedIr,
                                                      currentSourcePath,
                                                      currentRootType,
                                                      part,
                                                      partType,
                                                      partOffsetBytes,
                                                      partSizeBytes,
                                                      partAlignBytes,
                                                      nextSourcePath):
                    nestedOk = false
                    break
                currentPrefix = Fmt"{currentPrefix}.{part}"
                let partSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                  slotNames,
                                                                  typedIr,
                                                                  nextSourcePath,
                                                                  Fmt"{currentPrefix}#field_arg",
                                                                  partType)
                if partSlot < 0 ||
                   !PrimaryBodyIrAppendFieldLoadToSlot(bodyIR,
                                                       slotNames,
                                                       typedIr,
                                                       currentSourcePath,
                                                       currentRootName,
                                                       currentLoadRootType,
                                                       partOffsetBytes,
                                                       partSizeBytes,
                                                       partSlot):
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), strutil.Join(["phase=field_arg_nested_load_fail function=",
                                                                   strings.CloneStr(typedFn.functionName),
                                                                   " line=",
                                                                   strings.IntToStr(lineNumber),
                                                                   " arg=",
                                                                   strings.CloneStr(argText),
                                                                   " part=",
                                                                   strings.CloneStr(part),
                                                                   " current_root_type=",
                                                                   strings.CloneStr(currentRootType),
                                                                   " current_load_root_type=",
                                                                   strings.CloneStr(currentLoadRootType),
                                                                   " part_type=",
                                                                   strings.CloneStr(partType),
                                                                   " offset=",
                                                                   strings.IntToStr(partOffsetBytes),
                                                                   " size=",
                                                                   strings.IntToStr(partSizeBytes)], ""))
                    nestedOk = false
                    break
                finalSlot = partSlot
                currentRootName = Fmt"{currentPrefix}#field_arg"
                currentRootType = strings.CloneStr(partType)
                currentLoadRootType = strings.CloneStr(partType)
                currentSourcePath = strings.CloneStr(nextSourcePath)
                if dotPos < 0:
                    cursor = len(fieldPath)
                else:
                    cursor = dotPos + 1
            if nestedOk && finalSlot >= 0:
                return finalSlot
        failureDetail0 = 434
        return -1
    let baseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                          slotNames,
                                                          typedIr,
                                                          lookupSourcePath,
                                                          rootName,
                                                          strings.CloneStr(rootType))
    if baseSlot < 0:
        failureDetail0 = 435
        return -1
    let valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                       slotNames,
                                                       typedIr,
                                                       lookupSourcePath,
                                                       Fmt"{argText}#field_arg",
                                                       fieldType)
    if valueSlot < 0:
        failureDetail0 = 436
        failureDetail1 = fieldSizeBytes
        return -1
    if !PrimaryBodyIrAppendFieldLoadToSlot(bodyIR,
                                           slotNames,
                                           typedIr,
                                           lookupSourcePath,
                                           rootName,
                                           strings.CloneStr(rootType),
                                           fieldOffsetBytes,
                                           fieldSizeBytes,
                                           valueSlot):
        failureDetail0 = 436
        failureDetail1 = fieldSizeBytes
        return -1
    return valueSlot

@borrows
fn PrimaryBodyIrAlignedOffset(offset: int32, alignRaw: int32): int32 =
    var align = alignRaw
    if align <= 0:
        align = 1
    return ((offset + align - 1) / align) * align

@borrows
fn PrimaryBodyIrStableTypeText(typeRaw: str): str =
    let typeText = texpr.TypedExprNormalizeTypeText(typeRaw)
    if typeText == "":
        return ""
    for i in 0..<len(typeText):
        let ch = typeText[i]
        if ch < char(32) || ch > char(126):
            return ""
    return typeText

@borrows
fn PrimaryBodyIrMarkParamSlot(bodyIR: var coreir.BodyIR,
                               slotId: int32,
                               paramSlot: int32) =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return
    PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, slotId)
    bodyIR.localSlots[slotId].stackOffset = 0 - 1 - paramSlot

# bool params keep 4-byte local storage but a 1-byte ABI footprint on Darwin
# packed stacks; the marker travels in auxValue (unused for non-ptr slots).
@borrows
fn PrimaryBodyIrMarkParamAbiSize(bodyIR: var coreir.BodyIR,
                                  slotId: int32,
                                  typeRaw: str) =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return
    if bodyIR.localSlots[slotId].typeKind != coreir.LocalI32Tag:
        return
    if texpr.TypedExprNormalizeTypeText(typeRaw) == "bool":
        PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, slotId)
        bodyIR.localSlots[slotId].auxValue = 1

@borrows
fn PrimaryBodyIrLocalIsParam(slot: coreir.LocalSlot): bool =
    if slot.stackOffset < 0:
        return true
    return false

@borrows
fn PrimaryBodyIrParamIndex(slot: coreir.LocalSlot): int32 =
    if slot.stackOffset >= 0:
        return -1
    return 0 - 1 - slot.stackOffset

@borrows
fn PrimaryBodyIrParamCopyCount(bodyIR: coreir.BodyIR): int32 =
    var count: int32
    for i in 0..<bodyIR.localSlots.len:
        if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[i]):
            count = count + 1
    return count

@borrows
fn PrimaryBodyIrStackAdjustWordCount(bytesRaw: int32): int32 =
    if bytesRaw < 0:
        panic("primary object: negative stack adjustment")
    var bytes = bytesRaw
    var count: int32
    while bytes > 4095:
        count = count + 1
        bytes = bytes - 4095
    if bytes > 0:
        count = count + 1
    return count

@borrows
fn PrimaryBodyIrCheckedStackOffsetAdd(lhs: int32, rhs: int32): int32 =
    if lhs < 0 || rhs < 0 || lhs > 2147483647 - rhs:
        panic("primary object: stack offset overflow")
    return lhs + rhs

# PrimaryBodyIrStackAddressWordCount is defined once, below (:51713-ish after this
# edit shifts line numbers), paired with PrimaryBodyIrStackAccessImmFits /
# PrimaryBodyIrStackAccessWordCount. This duplicate definition (same name, same
# int32->int32 signature, equivalent ceil(x/4095)-with-x==0=>1 semantics) caused
# the self-hosted backend's call-target index to treat every caller of this name
# as missing_call_target (bail=0) — a same-symbol duplicate-definition collision,
# not a real missing callee. Removed; all call sites below resolve to the
# surviving definition unchanged (verified byte-identical results for all inputs
# by hand: both are ceil(x/4095) for x>0, 1 for x==0, 0 for x<0).

@borrows
fn PrimaryBodyIrPrologueSaveBaseWordCount(bodyIR: coreir.BodyIR): int32 =
    # Extra words for the param-save base address materialization when the
    # fixed prologue stores overflow the STR scaled-immediate ceiling (see
    # PrimaryBodyIRFillPrologue). Zero when the slots encode directly.
    if PrimaryBodyIrStackAccessImmFits(PrimaryBodyIrReturnBufferSaveOffset(bodyIR), 8):
        return 0
    return PrimaryBodyIrStackAddressWordCount(PrimaryBodyIrParamSaveOffset(bodyIR))

@borrows
fn PrimaryBodyIrPrologueWordCount(bodyIR: coreir.BodyIR): int32 =
    if bodyIR.frameMetricsReady:
        return bodyIR.framePrologueWordCount
    let frameBytes = PrimaryBodyIrFrameBytes(bodyIR)
    return PrimaryBodyIrStackAdjustWordCount(frameBytes) + 3 +
           PrimaryBodyIrParamSaveCount(bodyIR) +
           PrimaryBodyIrPrologueSaveBaseWordCount(bodyIR)

@borrows
fn PrimaryBodyIrFrameRestoreWordCount(bodyIR: coreir.BodyIR): int32 =
    if bodyIR.frameMetricsReady:
        return bodyIR.frameRestoreWordCount
    return PrimaryBodyIrStackAdjustWordCount(PrimaryBodyIrFrameBytes(bodyIR)) + 2

@borrows
fn PrimaryBodyIrTypeIs64(typeKind: int32): bool =
    if typeKind == coreir.LocalStrTag:
        return true
    if typeKind == coreir.LocalPtrTag:
        return true
    if typeKind == coreir.LocalI64Tag:
        return true
    if typeKind == coreir.LocalAggregateTag:
        return true
    if typeKind == coreir.LocalF64Tag:
        return true
    return false

@borrows
fn PrimaryBodyIrSlotType(bodyIR: coreir.BodyIR, slotId: int32): int32 =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return coreir.LocalI32Tag
    return bodyIR.localSlots[slotId].typeKind

# A str-valued root for FieldLoad-through-str protocols: either a plain str
# slot (24-byte str record inline) or a `var str` param slot (Aggregate(24)+
# aux=Str holding the str record address). Both feed BodyOpFieldLoad, which
# already derefs the param-aggregate address indirection (see the len read at
# the I32Tag branch and x64BodyFillFieldLoadOp's LocalAggregateTag+param arm).
@borrows
fn PrimaryBodyIrSlotIsStrRoot(bodyIR: coreir.BodyIR, slotId: int32): bool =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return false
    if bodyIR.localSlots[slotId].typeKind == coreir.LocalStrTag:
        return true
    return bodyIR.localSlots[slotId].typeKind == coreir.LocalAggregateTag &&
           bodyIR.localSlots[slotId].auxValue == coreir.LocalStrTag &&
           PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotId])

# Frame/copy footprint of a slot. A BodyPlaceGlobalAddressTag slot only HOLDS
# THE ADDRESS of a global (which lives in .bss/.data, not on the stack), so its
# stack-frame footprint and slot-to-slot copy width are pointer-sized (8 bytes),
# NOT the global's full data size. The full data size (slot.sizeBytes) is retained
# by PrimaryLocalSlotSizeOf for element-offset/index math on the global. Using the
# full data size for frame layout / copy word count made functions that reference
# large aggregate globals (e.g. yamux/muxer state tables: YamuxMuxerState[64]=~102MB)
# reserve 100+ MB stack frames and emit ~800M-word aggregate copies, exploding
# totalWordCount and blowing the ohos instructionWords fill (2^29 int32[] SIGBUS).
@borrows
fn PrimaryBodyIrLocalFrameFootprint(slot: coreir.LocalSlot): int32 =
    if slot.placeKind == coreir.BodyPlaceGlobalAddressTag:
        return 8
    return PrimaryLocalSlotSizeOf(slot)

@borrows
fn PrimaryLocalSlotSizeOf(slot: coreir.LocalSlot): int32 =
    if slot.sizeBytes > 0:
        return slot.sizeBytes
    if slot.typeKind == coreir.LocalI32Tag:
        return 4
    if slot.typeKind == coreir.LocalF64Tag ||
       slot.typeKind == coreir.LocalI64Tag ||
       slot.typeKind == coreir.LocalPtrTag:
        return 8
    if slot.typeKind == coreir.LocalStrTag:
        return 24
    if slot.typeKind == coreir.LocalAggregateTag:
        return coreir.ResultStrSizeBytes
    return 0

# Number of ldr/str instruction PAIRS to copy exactly `byteCount` bytes of an
# sret aggregate, choosing the widest exact chunk: 8-byte words when 8-aligned
# (str=24B→3, Result[str]=64B→8), else 4-byte words when 4-aligned (Row 12B→3).
# A precise count is mandatory: rounding up to 8-byte words over-writes the
# caller's adjacent (tightly packed) stack slot — e.g. add(seq, helper()) sret
# clobbers the seq header pointer → segfault.
fn PrimaryReturnSretCopyPairCount(byteCount: int32): int32 =
    if byteCount <= 0:
        return 0
    if byteCount % 8 == 0:
        return byteCount / 8
    return (byteCount + 3) / 4

# true when the sret copy uses 64-bit chunks (8-aligned), false for 32-bit.
fn PrimaryReturnSretCopyIs64(byteCount: int32): bool =
    return byteCount % 8 == 0

@borrows
fn PrimaryCallOpRegisterArgCount(call: coreir.CallOp): int32 =
    if call.argSlots.len > 8:
        return 8
    return call.argSlots.len

@borrows
fn PrimaryCallOpStackArgCount(call: coreir.CallOp): int32 =
    if call.argSlots.len <= 8:
        return 0
    return call.argSlots.len - 8

# Current boundary poison: the register/stack split above assumes "first 8
# positional args are register args, the rest spill to the stack" -- that
# assumption is only valid when every arg shares one register class. Real
# AAPCS64 keeps GP (NGRN) and FP (NSRN) as two INDEPENDENT 8-slot pools, so a
# real C-ABI call (targetIsImportc) mixing >8 total args with at least one f64
# arg can need a genuinely different register/stack split than "first 8" (an
# f64 beyond position 8 may still belong in a register if NSRN<8, or a GP arg
# at position <8 may need to spill if NGRN is already exhausted by earlier f64
# args). This shape needs real stack-arg re-layout (not yet implemented) --
# poison it loudly (bail=817) instead of silently mis-emitting per the "first
# 8" assumption. Calls with <=8 total args are unaffected (no stack spill
# possible, so no split-order question -- the NGRN/NSRN register fix above is
# complete and correct for them on its own).
@borrows
fn PrimaryCallOpAbiRegisterStackBoundaryNeedsPoison(call: coreir.CallOp,
                                                     bodyIR: coreir.BodyIR): bool =
    if !call.targetIsImportc:
        return false
    if call.argSlots.len <= 8:
        return false
    for i in 0..<call.argSlots.len:
        let argSlot = call.argSlots[i]
        if argSlot >= 0 && argSlot < bodyIR.localSlots.len &&
           bodyIR.localSlots[argSlot].typeKind == coreir.LocalF64Tag:
            return true
    return false

# ABI storage size for one argument/parameter from its declared type text.
# Mirrors cold_abi_arg_storage_bytes: bool packs as 1 byte on Darwin arm64;
# all other int32-class types stay 4; 64-bit/address types are 8.
# Returns 0 when the type is unknown (caller falls back to a slot-derived size).
@borrows
fn PrimaryAbiArgSizeFromTypeText(typeRaw: str): int32 =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if normType == "":
        return 0
    if PrimaryStartsWith(normType, "var") || PrimaryStartsWith(normType, "ref"):
        return 8
    if normType == "bool":
        return 1
    if normType == "int8" || normType == "uint8" || normType == "u8" || normType == "i8" ||
       normType == "int16" || normType == "uint16" || normType == "u16" || normType == "i16" ||
       normType == "int32" || normType == "uint32" || normType == "u32" || normType == "i32" ||
       normType == "int" || normType == "char" ||
       normType == "float32" || normType == "f32":
        return 4
    if normType == "int64" || normType == "uint64" || normType == "u64" || normType == "i64" ||
       normType == "float64" || normType == "f64":
        return 8
    # str/cstring/ptr/aggregates/slices all pass as 8-byte values or addresses
    return 8

@borrows
fn PrimaryCallOpArgAbiSize(call: coreir.CallOp, argIndex: int32): int32 =
    if argIndex >= 0 && argIndex < call.argAbiSizes.len:
        let size = call.argAbiSizes[argIndex]
        if size == 1 || size == 2 || size == 4 || size == 8:
            return size
    return 8

# Packed (Darwin arm64) byte offset of the stackArgIndex-th stack argument.
# Non-packed targets use fixed 8-byte slots.
@borrows
fn PrimaryCallOpStackArgOffset(call: coreir.CallOp, stackArgIndex: int32): int32 =
    if stackArgIndex < 0 || stackArgIndex >= PrimaryCallOpStackArgCount(call):
        panic("primary object: stack argument index out of bounds")
    if !PrimaryDarwinPackedStackArgsActive():
        if stackArgIndex > 2147483647 / 8:
            panic("primary object: stack argument offset overflow")
        return stackArgIndex * 8
    var offset: int32
    for i in 0..<stackArgIndex + 1:
        let size = PrimaryCallOpArgAbiSize(call, i + 8)
        offset = PrimaryAlignStackBytes(offset, size)
        if i == stackArgIndex:
            return offset
        if offset > 2147483647 - size:
            panic("primary object: stack argument offset overflow")
        offset = offset + size
    return offset

@borrows
fn PrimaryCallOpStackArgSize(call: coreir.CallOp, stackArgIndex: int32): int32 =
    if stackArgIndex < 0 || stackArgIndex >= PrimaryCallOpStackArgCount(call):
        panic("primary object: stack argument index out of bounds")
    if !PrimaryDarwinPackedStackArgsActive():
        return 8
    return PrimaryCallOpArgAbiSize(call, stackArgIndex + 8)

@borrows
fn PrimaryCallOpStackArgBytes(call: coreir.CallOp): int32 =
    let stackArgCount = PrimaryCallOpStackArgCount(call)
    if stackArgCount <= 0:
        return 0
    if !PrimaryDarwinPackedStackArgsActive():
        if stackArgCount > 2147483647 / 8:
            panic("primary object: stack argument byte count overflow")
        return PrimaryAlignStackBytes(stackArgCount * 8, 16)
    let lastIndex = stackArgCount - 1
    let lastOffset = PrimaryCallOpStackArgOffset(call, lastIndex)
    let lastSize = PrimaryCallOpStackArgSize(call, lastIndex)
    if lastOffset > 2147483647 - lastSize:
        panic("primary object: stack argument byte count overflow")
    let endOffset = lastOffset + lastSize
    return PrimaryAlignStackBytes(endOffset, 16)

@borrows
fn PrimaryCallOpArgPassKind(call: coreir.CallOp,
                             argIndex: int32): int32 =
    if argIndex >= 0 && argIndex < call.argPassKinds.len:
        return call.argPassKinds[argIndex]
    panic("primary object: call pass kind missing")
    return 0

@borrows
fn PrimaryBodyIrCallArgIsCString(argSlot: int32): bool =
    return coreir.CallArgSlotIsCString(argSlot)

@borrows
fn PrimaryBodyIrCallArgCStringId(argSlot: int32): int32 =
    return coreir.CallArgSlotCStringId(argSlot)

@borrows
fn PrimaryBodyIrCallArgWordCount(bodyIR: coreir.BodyIR,
                                  argSlot: int32,
                                  passKind: int32,
                                  spBias: int32,
                                  regArgCrossesCAbi: bool): int32 =
    if passKind == coreir.BodyCallPassGlobalAddressTag:
        if argSlot < 0 ||
           argSlot >= bodyIR.localSlots.len ||
           bodyIR.localSlots[argSlot].placeKind != coreir.BodyPlaceGlobalAddressTag:
            return 0
        return 2
    if coreir.CallArgSlotIsConst(argSlot):
        return 1
    if coreir.CallArgSlotIsCString(argSlot):
        return 2
    if coreir.CallArgSlotIsAddress(argSlot):
        let slotId = coreir.CallArgSlotAddressId(argSlot)
        # form60: hoist .len before three-way conj with [slotId]
        let localSlotsLen_f60: int32 = bodyIR.localSlots.len
        if slotId >= 0 && slotId < localSlotsLen_f60 &&
           PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotId]) &&
           (bodyIR.localSlots[slotId].typeKind == coreir.LocalStrTag ||
            bodyIR.localSlots[slotId].typeKind == coreir.LocalAggregateTag):
            # Mirror PrimaryBodyIRFillCallArgToReg exactly: str and aggregate
            # params store the incoming value address, so passing their address
            # loads that pointer instead of materializing the param-save slot.
            return PrimaryBodyIrLoadSlotBiasedWordCount(bodyIR, slotId, spBias)
        let slotOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                       slotId,
                                                       PrimaryBodyIrFrameBytes(bodyIR),
                                                       PrimaryBodyIrParamSaveOffset(bodyIR),
                                                       PrimaryBodyIrParamSaveCount(bodyIR))
        if slotOffset < 0:
            return 0
        return PrimaryBodyIrStackAddressWordCount(
            PrimaryBodyIrCheckedStackOffsetAdd(slotOffset, spBias))
    if spBias != 0 && argSlot >= 0 && argSlot < bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[argSlot]
        if (slot.typeKind == coreir.LocalStrTag ||
            slot.typeKind == coreir.LocalAggregateTag) &&
           !PrimaryBodyIrLocalIsParam(slot):
            # sp is moved by the outgoing stack-arg area while args load, so
            # the address materialization width follows the biased offset
            let stackOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                            argSlot,
                                                            PrimaryBodyIrFrameBytes(bodyIR),
                                                            PrimaryBodyIrParamSaveOffset(bodyIR),
                                                            PrimaryBodyIrParamSaveCount(bodyIR))
            if stackOffset < 0:
                return 0
            return PrimaryBodyIrStackAddressWordCount(
                PrimaryBodyIrCheckedStackOffsetAdd(stackOffset, spBias))
    let baseWords = PrimaryBodyIrLoadSlotBiasedWordCount(bodyIR, argSlot, spBias)
    # #73: a register arg crossing the real AAPCS64 C ABI boundary needs one
    # extra word for the fmov d{n},x{n} that moves the raw f64 bits onto the
    # float register file (Cheng-internal calls keep the raw-bits X convention).
    if baseWords > 0 &&
       regArgCrossesCAbi &&
       argSlot >= 0 && argSlot < bodyIR.localSlots.len &&
       bodyIR.localSlots[argSlot].typeKind == coreir.LocalF64Tag:
        return baseWords + 1
    return baseWords

@borrows
fn PrimaryIncomingParamStackOffset(frameBytes: int32,
                                    paramSlot: int32): int32 =
    if paramSlot < 8:
        return -1
    if frameBytes < 0:
        panic("primary object: negative frame byte count")
    let stackParamIndex = paramSlot - 8
    if stackParamIndex > (2147483647 - frameBytes) / 8:
        panic("primary object: incoming parameter stack offset overflow")
    return frameBytes + stackParamIndex * 8

# ABI storage size of an incoming parameter slot. Param slots keep 4-byte
# local storage for bool, so the packed ABI width travels in auxValue
# (set by PrimaryBodyIrSeedParamSlots; only ever 1 for bool params).
@borrows
fn PrimaryParamSlotAbiSize(slot: coreir.LocalSlot): int32 =
    if slot.typeKind == coreir.LocalI32Tag:
        if slot.auxValue == 1:
            return 1
        if slot.auxValue == 0:
            return 4
        panic("primary object: incoming i32 parameter ABI metadata invalid")
        return 0
    if slot.typeKind == coreir.LocalF64Tag ||
       slot.typeKind == coreir.LocalI64Tag ||
       slot.typeKind == coreir.LocalPtrTag ||
       slot.typeKind == coreir.LocalStrTag ||
       slot.typeKind == coreir.LocalAggregateTag:
        return 8
    panic("primary object: incoming parameter ABI kind unavailable")
    return 0

@borrows
fn PrimaryIncomingParamStackOffsetPacked(bodyIR: coreir.BodyIR,
                                          frameBytes: int32,
                                          paramSlot: int32): int32 =
    if paramSlot < 8:
        return -1
    if !PrimaryDarwinPackedStackArgsActive():
        return PrimaryIncomingParamStackOffset(frameBytes, paramSlot)
    var offset: int32
    var index = 8
    while index <= paramSlot:
        var size: int32
        var found = false
        for li in 0..<bodyIR.localSlots.len:
            let slot = bodyIR.localSlots[li]
            if PrimaryBodyIrLocalIsParam(slot) &&
               PrimaryBodyIrParamIndex(slot) == index:
                if found:
                    panic("primary object: duplicate incoming parameter slot")
                size = PrimaryParamSlotAbiSize(slot)
                found = true
        if !found:
            panic("primary object: incoming parameter slot missing")
        offset = PrimaryAlignStackBytes(offset, size)
        if index == paramSlot:
            return PrimaryBodyIrCheckedStackOffsetAdd(frameBytes, offset)
        offset = PrimaryBodyIrCheckedStackOffsetAdd(offset, size)
        index = index + 1
    panic("primary object: incoming parameter stack offset unavailable")
    return -1

@borrows
fn PrimaryBodyIrLocalStackOffset(bodyIR: coreir.BodyIR,
                                  slotIndex: int32,
                                  frameBytes: int32,
                                  paramSaveOffset: int32,
                                  paramSaveCount: int32): int32 =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return -1
    let slot = bodyIR.localSlots[slotIndex]
    if !PrimaryBodyIrLocalIsParam(slot):
        return slot.stackOffset
    let paramSlot = PrimaryBodyIrParamIndex(slot)
    if paramSlot < 0:
        return -1
    if paramSlot < 8:
        if paramSlot >= paramSaveCount:
            return -1
        return paramSaveOffset + paramSlot * 8
    return PrimaryIncomingParamStackOffsetPacked(bodyIR, frameBytes, paramSlot)

@borrows
fn PrimaryBodyIrLoadSlotBiasedWordCount(bodyIR: coreir.BodyIR,
                                         slotIndex: int32,
                                         spBias: int32): int32 =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return 0
    let slot = bodyIR.localSlots[slotIndex]
    let stackOffsetRaw = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                       slotIndex,
                                                       PrimaryBodyIrFrameBytes(bodyIR),
                                                       PrimaryBodyIrParamSaveOffset(bodyIR),
                                                       PrimaryBodyIrParamSaveCount(bodyIR))
    if stackOffsetRaw < 0:
        return 0
    let stackOffset = PrimaryBodyIrCheckedStackOffsetAdd(stackOffsetRaw, spBias)
    let slotType = slot.typeKind
    if slotType == coreir.LocalI32Tag:
        var byteCount = 4
        if PrimaryDarwinPackedStackArgsActive():
            if PrimaryBodyIrLocalIsParam(slot):
                if PrimaryBodyIrParamIndex(slot) >= 8:
                    if PrimaryParamSlotAbiSize(slot) == 1:
                        byteCount = 1
        return PrimaryBodyIrStackAccessWordCount(stackOffset, byteCount)
    if slotType == coreir.LocalI64Tag ||
       slotType == coreir.LocalPtrTag ||
       slotType == coreir.LocalF64Tag:
        return PrimaryBodyIrStackAccessWordCount(stackOffset, 8)
    if slotType == coreir.LocalStrTag ||
       slotType == coreir.LocalAggregateTag:
        if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotIndex]):
            return PrimaryBodyIrStackAccessWordCount(stackOffset, 8)
        return PrimaryBodyIrStackAddressWordCount(stackOffset)
    return 0

@borrows
fn PrimaryBodyIrLoadSlotWordCount(bodyIR: coreir.BodyIR,
                                   slotIndex: int32): int32 =
    return PrimaryBodyIrLoadSlotBiasedWordCount(bodyIR, slotIndex, 0)

@borrows
fn PrimaryBodyIrStoreSlotWordCount(bodyIR: coreir.BodyIR,
                                    slotIndex: int32): int32 =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return 0
    let slot = bodyIR.localSlots[slotIndex]
    let stackOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                   slotIndex,
                                                   PrimaryBodyIrFrameBytes(bodyIR),
                                                   PrimaryBodyIrParamSaveOffset(bodyIR),
                                                   PrimaryBodyIrParamSaveCount(bodyIR))
    if stackOffset < 0:
        return 0
    let slotType = slot.typeKind
    if slotType == coreir.LocalI32Tag:
        var byteCount = 4
        if PrimaryDarwinPackedStackArgsActive():
            if PrimaryBodyIrLocalIsParam(slot):
                if PrimaryBodyIrParamIndex(slot) >= 8:
                    if PrimaryParamSlotAbiSize(slot) == 1:
                        byteCount = 1
        return PrimaryBodyIrStackAccessWordCount(stackOffset, byteCount)
    if slotType == coreir.LocalI64Tag ||
       slotType == coreir.LocalPtrTag ||
       slotType == coreir.LocalF64Tag:
        return PrimaryBodyIrStackAccessWordCount(stackOffset, 8)
    return 0

@borrows
fn PrimaryBodyIrIndexedScaleWordCount(elemSize: int32): int32 =
    if elemSize == 1:
        return 1
    if elemSize == 4 || elemSize == 8 || elemSize == 16:
        return 3
    if elemSize == 24:
        return 6
    # General stride: materialize the complete positive int32 stride, then MADD.
    # Values above imm16 require MOVZ(low16)+MOVK(high16); the encoding width is
    # not a language/layout ceiling.
    if elemSize <= 0:
        return 0
    if elemSize <= 65535:
        return 2
    return 3

# Innermost integer-literal token of `text`, or "" if `text` is not a literal.
# Strips the same cast wrappers PrimaryBodyIrExtractIntFromText recognizes plus
# the uint16/uint32 widths it lacks, so the returned token is a bare
# hex/bin/decimal/char literal that the extractor parses unambiguously. Lets
# callers distinguish a genuine zero literal (any spelling) from a non-literal
# that the extractor maps to its 0 failure-sentinel.
@borrows
fn PrimaryBodyIrIntLiteralInner(textRaw: str): str =
    let text = strutil.Strip(textRaw)
    if text == "":
        return ""
    if PrimaryBodyIrCharLiteralValue(text) >= 0:
        return text
    let castHeads = ["int32", "Int32", "int64", "Int64",
                     "uint8", "UInt8", "uint16", "UInt16",
                     "uint32", "UInt32", "uint64", "UInt64"]
    for ci in 0..<castHeads.len:
        let castInner = PrimaryBodyIrWholeCallInnerForHead(text, castHeads[ci])
        if castInner != "":
            return PrimaryBodyIrIntLiteralInner(castInner)
    var start: int32
    if text[0] == '-' || text[0] == '+':
        start = 1
    if start >= len(text):
        return ""
    # 0x / 0b prefixed literals: at least one base digit must follow the prefix.
    var digitBase: int32 = 10
    var digitStart = start
    if start + 1 < len(text) && text[start] == '0' &&
       (text[start + 1] == 'x' || text[start + 1] == 'X'):
        digitBase = 16
        digitStart = start + 2
    elif start + 1 < len(text) && text[start] == '0' &&
         (text[start + 1] == 'b' || text[start + 1] == 'B'):
        digitBase = 2
        digitStart = start + 2
    if digitStart >= len(text):
        return ""
    var sawDigit = false
    for i in digitStart..<len(text):
        let ch = text[i]
        if ch == '_':
            continue
        var ok = false
        if digitBase == 16:
            ok = (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f') || (ch >= 'A' && ch <= 'F')
        elif digitBase == 2:
            ok = ch == '0' || ch == '1'
        else:
            ok = ch >= '0' && ch <= '9'
        if !ok:
            return ""
        sawDigit = true
    if !sawDigit:
        return ""
    return text

@borrows
fn PrimaryBodyIrTextIsI32Zero(textRaw: str): bool =
    let inner = PrimaryBodyIrIntLiteralInner(textRaw)
    if inner == "":
        return false
    # Use the 64-bit extractor on the bare token: the int32 extractor maps any
    # >int32 literal to its 0 overflow-sentinel, which would mis-tag a wide
    # nonzero value (e.g. uint64(1099511627776)) as zero.
    var innerValue64: int64
    if !PrimaryBodyIrExtractInt64FromText(inner, innerValue64):
        return false
    return innerValue64 == int64(0)

@borrows
fn PrimaryBodyIrTextIsI64IntegerCast(textRaw: str): bool =
    let text = strutil.Strip(textRaw)
    if PrimaryBodyIrWholeCallInnerForHead(text, "int64") != "":
        return true
    if PrimaryBodyIrWholeCallInnerForHead(text, "Int64") != "":
        return true
    if PrimaryBodyIrWholeCallInnerForHead(text, "uint64") != "":
        return true
    if PrimaryBodyIrWholeCallInnerForHead(text, "UInt64") != "":
        return true
    return false

@borrows
fn PrimaryBodyIrTextIsI32One(textRaw: str): bool =
    let text = strutil.Strip(textRaw)
    if text == "1":
        return true
    if text == "int32(1)":
        return true
    return false

@borrows
fn PrimaryBodyIrTextIsStringLiteral(textRaw: str): bool =
    let text = strutil.Strip(share(textRaw))
    if len(text) < 2:
        return false
    if text[0] != '"':
        return false
    if text[len(text) - 1] != '"':
        return false
    return true

# True iff text looks like a str slice expression: ident[lo..<hi] / ident[lo..hi].
# Quick classifier used to gate the slice-materialization arm in
# PrimaryBodyIrAppendSeqStrAddBuiltin; definitive parsing is SplitStrSliceText.
@borrows
fn PrimaryBodyIrTextIsStrSlice(textRaw: str): bool =
    let text = strutil.Strip(textRaw)
    if len(text) < 6:
        return false
    var hasOpen = false
    var hasDot = false
    var i: int32
    while i < len(text) - 1:
        if text[i] == '[':
            hasOpen = true
        if text[i] == '.' && text[i + 1] == '.':
            hasDot = true
        i = i + 1
    return hasOpen && hasDot && text[len(text) - 1] == ']'

# Parse a str slice expression ident[lo..<hi] / ident[lo..hi] into base/lo/hi text.
# base must be a bare identifier; lo/hi are returned as int-expr text (handled by
# PrimaryBodyIrContextScalarValueSlotForText: bindings, int consts, and .len). For
# the inclusive form a..b, hi is emitted as "b + 1" so the caller's count = hi-lo
# (via I32Sub) stays correct. Returns false on any parse failure (caller degrades
# to the pre-change AppendInvalidOp behavior for that one site -- no crash).
@borrows
fn PrimaryBodyIrSplitStrSliceText(textRaw: str,
                                   baseOut: var str,
                                   loOut: var str,
                                   hiOut: var str): bool =
    baseOut = ""
    loOut = ""
    hiOut = ""
    let text = strutil.Strip(textRaw)
    if len(text) < 6 || text[len(text) - 1] != ']':
        return false
    var openPos: int32
    openPos = -1
    var i: int32
    while i < len(text):
        if text[i] == '[':
            openPos = i
            break
        i = i + 1
    if openPos <= 0:
        return false
    let baseText = strutil.Strip(strings.SliceBytes(text, 0, openPos))
    if baseText == "":
        return false
    var j: int32
    while j < len(baseText):
        let rc = baseText[j]
        let okChar = (rc >= 'a' && rc <= 'z') ||
                     (rc >= 'A' && rc <= 'Z') ||
                     (rc >= '0' && rc <= '9') ||
                     rc == '_'
        if !okChar:
            return false
        j = j + 1
    let innerStart = openPos + 1
    let innerCount = len(text) - openPos - 2
    if innerCount <= 0:
        return false
    let inner = strings.SliceBytes(text, innerStart, innerCount)
    var dotPos: int32
    dotPos = -1
    var k: int32
    while k < len(inner) - 1:
        if inner[k] == '.' && inner[k + 1] == '.':
            dotPos = k
            break
        k = k + 1
    if dotPos <= 0:
        return false
    let loText = strutil.Strip(strings.SliceBytes(inner, 0, dotPos))
    if loText == "":
        return false
    var afterDots = dotPos + 2
    var inclusive = true
    if afterDots < len(inner) && inner[afterDots] == '<':
        inclusive = false
        afterDots = afterDots + 1
    let hiRaw = strutil.Strip(strings.SliceBytes(inner,
                                                  afterDots,
                                                  len(inner) - afterDots))
    if hiRaw == "":
        return false
    baseOut = baseText
    loOut = loText
    if inclusive:
        hiOut = Fmt"{hiRaw} + 1"
    else:
        hiOut = hiRaw
    return true

# Strip Cheng `//` line comments from an expression tail. surfaceText retains
# trailing `// ...` notes (ParserStripLineComment only handles `#`); a bare cut
# at the first `//` is safe here because the only caller validates the result
# (int-literal + field-name gates reject any corrupted piece).
@borrows
fn PrimaryBodyIrStripSlashLineComment(textRaw: str): str =
    var i: int32
    while i + 1 < textRaw.len:
        if textRaw[i] == '/' && textRaw[i + 1] == '/':
            return strings.SliceBytes(textRaw, 0, i)
        i = i + 1
    return textRaw

# Field-store RHS self-field arithmetic `<root>.<field> <arithop> <int>` (and the
# reverse): ContextScalarValueSlotForText returns -1 for a var-struct field read
# (e.g. state.pos), so the whole binary falls to bail_712. Reuse this assignment's
# already-resolved baseSlot/offset/size (FieldLoad itself is correct), and only
# materialize field-load + int-const + BinOp. Mirrors the str-slice rescue; only
# i32/i64 scalar field arithmetic is admitted, else returns -1 (unchanged path).
@borrows
fn PrimaryBodyIrLowerSelfFieldArithRhsToSlot(bodyIR: var coreir.BodyIR,
                                             slotNames: var str[],
                                             varI32ParamNames: str[],
                                             typedIr: texpr.TypedExprIr,
                                             typedFn: texpr.TypedExprIrFunction,
                                             irFunction: lower.PrimaryObjectIrFunction,
                                             sourcePath: str,
                                             lineNumber: int32,
                                             rhsTextRaw: str,
                                             baseSlot: int32,
                                             fieldOffsetBytes: int32,
                                             fieldSizeBytes: int32,
                                             selfFieldText: str,
                                             fieldTypeKind: int32): int32 =
    if baseSlot < 0 || fieldOffsetBytes < 0 || fieldSizeBytes <= 0:
        return -1
    if fieldTypeKind != coreir.LocalI32Tag && fieldTypeKind != coreir.LocalI64Tag:
        return -1
    let selfField = strutil.Strip(selfFieldText)
    if selfField == "":
        return -1
    var text = strutil.Strip(parser.ParserStripLineComment(rhsTextRaw))
    text = strutil.Strip(PrimaryBodyIrStripSlashLineComment(text))
    if text == "" || PrimaryBodyIrTextHasCallSurface(text):
        return -1
    var opPos: int32 = -1
    var opKind: int32
    var opLen: int32 = 1
    let addPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, int32('+'))
    let subPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, int32('-'))
    let mulPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, int32('*'))
    let divPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, int32('/'))
    if addPos > 0:
        opPos = addPos
        opKind = int32(texpr.TypedExprIrOpI32Add)
    elif subPos > 0:
        opPos = subPos
        opKind = int32(texpr.TypedExprIrOpI32Sub)
    elif mulPos > 0:
        opPos = mulPos
        opKind = int32(texpr.TypedExprIrOpI32Mul)
    elif divPos > 0:
        opPos = divPos
        opKind = int32(texpr.TypedExprIrOpI32Sdiv)
    if opPos <= 0 || opPos + opLen >= len(text):
        return -1
    let lhsText = strutil.Strip(strings.SliceBytes(text, 0, opPos))
    let rhsText = strutil.Strip(strings.SliceBytes(text, opPos + opLen, len(text) - opPos - opLen))
    var fieldOnLhs: bool
    var constText: str
    constText = ""
    if lhsText == selfField && PrimaryBodyIrTextIsIntLiteral(rhsText):
        fieldOnLhs = true
        constText = rhsText
    elif rhsText == selfField && PrimaryBodyIrTextIsIntLiteral(lhsText):
        fieldOnLhs = false
        constText = lhsText
    else:
        return -1
    let fieldValSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"{selfField}#arith_self_load#{bodyIR.ops.len}",
                                                     fieldTypeKind)
    if fieldValSlot < 0:
        return -1
    var loadOp: coreir.BodyOp
    loadOp.kind = coreir.BodyOpFieldLoadTag
    loadOp.target = fieldValSlot
    add(loadOp.operands, baseSlot)
    add(loadOp.operands, fieldValSlot)
    add(loadOp.operands, fieldOffsetBytes)
    add(loadOp.operands, fieldSizeBytes)
    let _ = coreir.BodyIRAppendOp(bodyIR, loadOp)
    let constSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               typedIr,
                                                               typedFn,
                                                               irFunction,
                                                               sourcePath,
                                                               lineNumber,
                                                               constText,
                                                               fieldTypeKind)
    if constSlot < 0:
        return -1
    let resultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"{selfField}#arith_self_result#{bodyIR.ops.len}",
                                                    fieldTypeKind)
    if resultSlot < 0:
        return -1
    var binOp: coreir.BodyOp
    binOp.kind = coreir.BodyOpBinOpTag
    binOp.target = resultSlot
    add(binOp.operands, fieldTypeKind)
    add(binOp.operands, opKind)
    if fieldOnLhs:
        add(binOp.operands, fieldValSlot)
        add(binOp.operands, constSlot)
    else:
        add(binOp.operands, constSlot)
        add(binOp.operands, fieldValSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, binOp)
    return resultSlot

@borrows
fn PrimaryBodyIrLowerStrSliceToSlot(bodyIR: var coreir.BodyIR,
                                    slotNames: var str[],
                                    varI32ParamNames: str[],
                                    typedIr: texpr.TypedExprIr,
                                    typedFn: texpr.TypedExprIrFunction,
                                    irFunction: lower.PrimaryObjectIrFunction,
                                    sourcePath: str,
                                    lineNumber: int32,
                                    sliceText: str,
                                    namingTag: str,
                                    callOrdinal: var int32): int32 =
    var sliceBase = ""
    var sliceLoText = ""
    var sliceHiText = ""
    if !PrimaryBodyIrSplitStrSliceText(sliceText, sliceBase, sliceLoText, sliceHiText):
        return -1
    let baseSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, sliceBase)
    if baseSlot < 0 ||
       baseSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, baseSlot) != coreir.LocalStrTag:
        return -1
    let loSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR, slotNames, varI32ParamNames, typedIr, share(typedFn), share(irFunction), sourcePath, lineNumber, sliceLoText, coreir.LocalI32Tag)
    let hiSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR, slotNames, varI32ParamNames, typedIr, typedFn, irFunction, sourcePath, lineNumber, sliceHiText, coreir.LocalI32Tag)
    if loSlot < 0 || hiSlot < 0:
        return -1
    let countSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, Fmt"{namingTag}#slice_count#{bodyIR.ops.len}", coreir.LocalI32Tag)
    if countSlot < 0:
        return -1
    var countOp: coreir.BodyOp
    countOp.kind = coreir.BodyOpBinOpTag
    countOp.target = countSlot
    add(countOp.operands, coreir.LocalI32Tag)
    add(countOp.operands, int32(texpr.TypedExprIrOpI32Sub))
    add(countOp.operands, hiSlot)
    add(countOp.operands, loSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, countOp)
    let tempSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, Fmt"{namingTag}#slice#{bodyIR.ops.len}", coreir.LocalStrTag)
    if tempSlot < 0:
        return -1
    var call: coreir.CallOp
    call.targetSymbol = "driver_c_str_slice_bridge"
    call.resultSlot = tempSlot
    call.resultPassKind = coreir.BodyCallPassSretResultTag
    if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[baseSlot]):
        add(call.argSlots, baseSlot)
        add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    else:
        add(call.argSlots, coreir.CallArgSlotAddress(baseSlot))
        add(call.argPassKinds, coreir.BodyCallPassParamAddressTag)
    add(call.argSlots, loSlot)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(call.argSlots, countSlot)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(bodyIR.callSequence, call)
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpCallTag
    op.target = tempSlot
    add(op.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    callOrdinal = callOrdinal + 1
    return tempSlot

@borrows
fn PrimaryBodyIrStringLiteralPayload(textRaw: str): str =
    # Fmt 洞转义引号形 `\\"…\\"` 优先按外层转义语义解码 (lowering_plan
    # 行内 if 插值族; 精确形谓词在 parser 词法权威)。
    var escapedPayload = ""
    if parser.ParserValueExprFmtEscapedQuotedPayload(textRaw, escapedPayload):
        return escapedPayload
    let text = strutil.Strip(textRaw)
    if !PrimaryBodyIrTextIsStringLiteral(text):
        return ""
    let inner = strings.SliceBytes(text, 1, len(text) - 2)
    if !strutil.Contains(inner, "\\"):
        return strings.CloneStr(inner)
    # Decode source escapes; the surface text carries them verbatim.
    # 用 str[] + 末尾单次 Join 收集片段, 避免 out = Fmt"{out}..." 的 O(L^2) 中间串复制
    # (实测: N=32000 字面量 Fmt-loop 吃 1.2GB RSS, Join 仅 1.6MB)。
    var parts: str[]
    var escapeIndex = 0
    let innerLen = len(inner)
    let quoteChar = strings.SliceBytes(text, 0, 1)
    while escapeIndex < innerLen:
        let escapeChar = inner[escapeIndex]
        if escapeChar == '\\' && escapeIndex + 1 < innerLen:
            let escapeNext = inner[escapeIndex + 1]
            if escapeNext == 'n':
                add(parts, "\n")
            elif escapeNext == 't':
                add(parts, "\t")
            elif escapeNext == 'r':
                add(parts, "\r")
            elif escapeNext == '\\':
                add(parts, "\\")
            elif escapeNext == '"':
                add(parts, share(quoteChar))
            else:
                add(parts, strings.CharToStr(escapeChar))
                add(parts, strings.CharToStr(escapeNext))
            escapeIndex = escapeIndex + 2
            continue
        add(parts, strings.CharToStr(escapeChar))
        escapeIndex = escapeIndex + 1
    return strutil.Join(parts, "")

@borrows
fn PrimaryBodyIrCstringCastArgText(textRaw: str): str =
    let text = strutil.Strip(textRaw)
    if len(text) <= 9:
        return ""
    if !PrimaryStartsWith(text, "cstring("):
        return ""
    if text[len(text) - 1] != ')':
        return ""
    return strutil.Strip(strings.SliceBytes(text, 8, len(text) - 9))

@borrows
fn PrimaryBodyIrPtrAddressArgName(textRaw: str): str =
    let text = strutil.Strip(textRaw)
    if len(text) > 1 && text[0] == '&':
        var rawName = strutil.Strip(strings.SliceBytes(text, 1, len(text) - 1))
        if len(rawName) > 3 &&
           rawName[len(rawName) - 3] == '[' &&
           rawName[len(rawName) - 2] == '0' &&
           rawName[len(rawName) - 1] == ']':
            # &arr[0] is the array base address: same as &arr.
            let elementBaseName = strutil.Strip(strings.SliceBytes(rawName, 0, len(rawName) - 3))
            if elementBaseName != "" &&
               parser.ParserIdentPrefix(elementBaseName) == elementBaseName:
                rawName = elementBaseName
        if rawName == "" ||
           PrimaryBodyIrTextHasCallSurface(rawName) ||
           (PrimaryBodyIrTextHasFieldOrIndex(rawName) && !texpr.TypedExprTextIsSimpleFieldPath(rawName)):
            return ""
        return rawName
    if len(text) <= 6:
        return ""
    if !PrimaryStartsWith(text, "ptr("):
        return ""
    if text[len(text) - 1] != ')':
        return ""
    let inner = strutil.Strip(strings.SliceBytes(text, 4, len(text) - 5))
    if len(inner) <= 1:
        return ""
    if inner[0] != '&':
        return ""
    let name = strutil.Strip(strings.SliceBytes(inner, 1, len(inner) - 1))
    if name == "" ||
       PrimaryBodyIrTextHasCallSurface(name) ||
       (PrimaryBodyIrTextHasFieldOrIndex(name) && !texpr.TypedExprTextIsSimpleFieldPath(name)):
        return ""
    return name

@borrows
fn PrimaryBodyIrFunctionAddressSlotName(functionIndex: int32): str =
    return Fmt"__cheng_function_address#{functionIndex}"

@borrows
fn PrimaryBodyIrFunctionAddressSlotIndex(slotName: str): int32 =
    let prefix = "__cheng_function_address#"
    if len(slotName) <= len(prefix):
        return -1
    if !PrimaryStartsWith(slotName, prefix):
        return -1
    return int32(strutil.ParseInt(strings.SliceBytes(slotName, len(prefix), len(slotName) - len(prefix))))

@borrows
fn PrimaryBodyIrWholeCallInnerForHead(textRaw: str,
                                       headRaw: str): str =
    let text = strutil.Strip(share(textRaw))
    let head = strutil.Strip(share(headRaw))
    if text == "" || head == "":
        return ""
    let openPos = len(head)
    if len(text) <= openPos + 1:
        return ""
    if !PrimaryStartsWith(text, head):
        return ""
    if text[openPos] != '(':
        return ""
    if text[len(text) - 1] != ')':
        return ""
    let closePos = texpr.TypedExprFindMatchingParen(text, openPos)
    if closePos != len(text) - 1:
        return ""
    return strutil.Strip(strings.SliceBytes(text, openPos + 1, len(text) - openPos - 2))

@borrows
fn PrimaryBodyIrWholeCallInnerForHeadSuffix(textRaw: str,
                                             suffixRaw: str): str =
    let text = strutil.Strip(textRaw)
    let suffix = strutil.Strip(suffixRaw)
    if text == "" || suffix == "":
        return ""
    var openPos: int32 = -1
    for i in 0..<len(text):
        if text[i] == '(':
            openPos = i
            break
    if openPos <= 0:
        return ""
    if len(text) <= openPos + 1:
        return ""
    if text[len(text) - 1] != ')':
        return ""
    let closePos = texpr.TypedExprFindMatchingParen(text, openPos)
    if closePos != len(text) - 1:
        return ""
    let head = strutil.Strip(strings.SliceBytes(text, 0, openPos))
    if len(head) < len(suffix):
        return ""
    let suffixStart = len(head) - len(suffix)
    var i: int32
    while i < len(suffix):
        if head[suffixStart + i] != suffix[i]:
            return ""
        i = i + 1
    return strutil.Strip(strings.SliceBytes(text, openPos + 1, len(text) - openPos - 2))

@borrows
fn PrimaryBodyIrUInt8PtrDerefPointerText(textRaw: str): str =
    let text = strutil.Strip(textRaw)
    if len(text) <= 4:
        return ""
    if text[0] != '*':
        return ""
    if text[1] == '(':
        if text[len(text) - 1] != ')':
            return ""
        let closePos = texpr.TypedExprFindMatchingParen(text, 1)
        if closePos != len(text) - 1:
            return ""
        let inner = strutil.Strip(strings.SliceBytes(text, 2, len(text) - 3))
        return PrimaryBodyIrWholeCallInnerForHeadSuffix(inner, "UInt8Ptr")
    # 根修 T45: 无额外括号包裹的强制转型解引用 `*UInt8Ptr(x)`(不是
    # `*(UInt8Ptr(x))`) 此前 text[1]!='(' 直接返回 "", 导致本函数对
    # `programName == nil || *UInt8Ptr(programName) == uint8(0)` 这种
    # if-guard 第二个 || 分支视而不见, 落回下方按名复用的候选路径——
    # 目标槽被 FindOrCreateSlot 提前登记但从未真正装载 (ScalarValueSlotForText
    # 的真 callOrdinal 专用路径被短路), 比较读到未初始化的栈残留值 (在
    # cheng_exec_program_capture_with_timeout 里表现为 GEN2 自举二进制对
    # provider fork 子进程的 programName 判空静默走错分支, 秒死零输出)。
    # 两种书写在 Cheng 语法里等价, 补齐无括号形式同样交给
    # WholeCallInnerForHeadSuffix 识别。
    return PrimaryBodyIrWholeCallInnerForHeadSuffix(strutil.Strip(strings.SliceBytes(text, 1, len(text) - 1)), "UInt8Ptr")

@borrows
fn PrimaryBodyIrI32PtrDerefPointerText(textRaw: str): str =
    let text = strutil.Strip(textRaw)
    if len(text) <= 1:
        return ""
    if text[0] != '*':
        return ""
    if len(text) > 4 && text[1] == '(' && text[len(text) - 1] == ')':
        let closePos = texpr.TypedExprFindMatchingParen(text, 1)
        if closePos != len(text) - 1:
            return ""
        let inner = strutil.Strip(strings.SliceBytes(text, 2, len(text) - 3))
        let castInner = PrimaryBodyIrWholeCallInnerForHeadSuffix(inner, "Int32Ptr")
        if castInner != "":
            return castInner
        return ""
    let pointerText = strutil.Strip(strings.SliceBytes(text, 1, len(text) - 1))
    if pointerText == "" ||
       PrimaryBodyIrTextHasCallSurface(pointerText) ||
       PrimaryBodyIrTextHasFieldOrIndex(pointerText):
        return ""
    return pointerText

@borrows
fn PrimaryBodyIrCanonicalCallText(textRaw: str): str =
    let text = strutil.Strip(textRaw)
    var openPos: int32 = -1
    for i in 0..<len(text):
        if text[i] == '(':
            openPos = i
            break
    if openPos <= 0:
        return text
    if len(text) <= openPos + 1:
        return text
    if text[len(text) - 1] != ')':
        return text
    let closePos = texpr.TypedExprFindMatchingParen(text, openPos)
    if closePos != len(text) - 1:
        return text
    let head = strutil.Strip(strings.SliceBytes(text, 0, openPos))
    let inner = strings.SliceBytes(text, openPos + 1, len(text) - openPos - 2)
    let args = texpr.TypedExprSplitTopLevelCsv(inner)
    var out = Fmt"{head}("
    for i in 0..<args.len:
        if i > 0:
            out = Fmt"{out},"
        out = Fmt"{out}{strutil.Strip(args[i])}"
    out = Fmt"{out})"
    return out

@borrows
fn PrimaryBodyIrTextIsCastHead(headRaw: str): bool =
    let head = strutil.Strip(headRaw)
    # bail=706 家族根修: 本表原缺 int/Int/uint/UInt 及大写/短形 cast 名,
    # ScalarCallSynthesisSlot/genHead 合成臂据此漏判,把 `int(i)` 捏造成真调用
    # (BodyOpCall sym=int → plan 审计 missing_call_target)。统一委托权威纯 cast
    # 判定 PrimaryObjectCallTargetIsPureCast(int8..uint64 短/大写/平台宽全形),
    # 指针别名与 f32/f64/bool/cstring 保留原有显式项。cast 命中 → 合成臂返 -1
    # poison,由调用方既有 bail 路径接管,绝不静默捏造调用。
    if PrimaryObjectCallTargetIsPureCast(head):
        return true
    if head == "ptr" || head == "UInt8Ptr" || head == "Int32Ptr" || head == "VoidPtrPtr" ||
       head == "f32" || head == "f64" || head == "bool" || head == "cstring":
        return true
    return false

@borrows
fn PrimaryBodyIrPtrExpressionSlot(bodyIR: var coreir.BodyIR,
                                   slotNames: var str[],
                                   varI32ParamNames: str[],
                                   typedIr: texpr.TypedExprIr,
                                   sourcePath: str,
                                   textRaw: str,
                                   callOrdinal: var int32): int32 =
    var text = strutil.Strip(share(textRaw))
    if text == "":
        return -1
    var ptrCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "UInt8Ptr")
    if ptrCastInner == "":
        ptrCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "Int32Ptr")
    if ptrCastInner == "":
        ptrCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "VoidPtrPtr")
    if ptrCastInner == "":
        ptrCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "UInt32Ptr")
    if ptrCastInner == "":
        ptrCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "UInt64Ptr")
    if ptrCastInner == "":
        ptrCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "Int64Ptr")
    if ptrCastInner != "":
        return PrimaryBodyIrPtrExpressionSlot(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, ptrCastInner, callOrdinal)
    var directSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, text)
    if directSlot < 0:
        let canonicalText = PrimaryBodyIrCanonicalCallText(text)
        if canonicalText != text:
            directSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, canonicalText)
    if directSlot >= 0 &&
       directSlot < bodyIR.localSlots.len &&
       PrimaryBodyIrSlotType(bodyIR, directSlot) == coreir.LocalPtrTag:
        return directSlot
    if directSlot >= 0 &&
       directSlot < bodyIR.localSlots.len &&
       PrimaryBodyIrWholeCallInnerForHead(text, "cheng_ptr_plus") != "":
        PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, directSlot)
        bodyIR.localSlots[directSlot].typeKind = coreir.LocalPtrTag
        bodyIR.localSlots[directSlot].sizeBytes = 8
        bodyIR.localSlots[directSlot].alignBytes = 8
        for ci in 0..<bodyIR.callSequence.len:
            if bodyIR.callSequence[ci].resultSlot == directSlot &&
               PrimaryCallTargetTailName(bodyIR.callSequence[ci].targetSymbol) == "cheng_ptr_plus":
                PrimaryBodyIrNodeBoolChainJournalCallBeforeWrite(bodyIR, ci)
                bodyIR.callSequence[ci].resultPassKind = coreir.BodyCallPassStackValueTag
        return directSlot
    let ptrPlusArgsText = PrimaryBodyIrWholeCallInnerForHead(text, "cheng_ptr_plus")
    if ptrPlusArgsText != "":
        let argNames = PrimaryBodyIrCallArgNames(ptrPlusArgsText)
        # No CSE across prior cheng_ptr_plus calls. Arg slots (e.g. loop `idx`) are
        # frequently mutated, and a call on another CFG arm must not be reused:
        # pure-path u64_to_string wrote digits through a zero-arm result slot that
        # stayed 0 on the non-zero loop arm → null-buffer SEGV.
        if callOrdinal >= 0 && argNames.len == 2:
            let synthBaseText = strutil.Strip(argNames[0])
            let synthOffText = strutil.Strip(argNames[1])
            let synthBaseSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               typedIr,
                                                               sourcePath,
                                                               synthBaseText,
                                                               callOrdinal)
            var synthOffSlot = -1
            if synthBaseSlot >= 0:
                synthOffSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, synthOffText)
                if synthOffSlot < 0:
                    let synthOffConst = PrimaryBodyIrExtractIntFromText(synthOffText)
                    if synthOffConst != 0 || PrimaryBodyIrTextIsI32Zero(synthOffText):
                        synthOffSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                       slotNames,
                                                                       Fmt"#ptr_plus_off#{bodyIR.callSequence.len}",
                                                                       coreir.LocalI32Tag,
                                                                       synthOffConst)
                if synthOffSlot < 0:
                    synthOffSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       typedIr,
                                                                       sourcePath,
                                                                       synthOffText,
                                                                       coreir.LocalI32Tag, callOrdinal)
            if synthBaseSlot >= 0 && synthOffSlot >= 0:
                let synthResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                    slotNames,
                                                                    Fmt"#ptr_plus#{bodyIR.callSequence.len}",
                                                                    coreir.LocalPtrTag)
                if synthResultSlot >= 0:
                    let synthCallIndex = bodyIR.callSequence.len
                    var synthCall: coreir.CallOp
                    synthCall.targetSymbol = "cheng_ptr_plus"
                    synthCall.resultSlot = synthResultSlot
                    synthCall.resultPassKind = coreir.BodyCallPassStackValueTag
                    add(synthCall.argSlots, synthBaseSlot)
                    add(synthCall.argPassKinds, coreir.BodyCallPassStackValueTag)
                    add(synthCall.argSlots, synthOffSlot)
                    add(synthCall.argPassKinds, coreir.BodyCallPassStackValueTag)
                    add(bodyIR.callSequence, synthCall)
                    var synthOp: coreir.BodyOp
                    synthOp.kind = coreir.BodyOpCallTag
                    synthOp.target = synthResultSlot
                    add(synthOp.operands, synthCallIndex)
                    let _ = coreir.BodyIRAppendOp(bodyIR, synthOp)
                    callOrdinal = callOrdinal + 1
                    return synthResultSlot
    let ptrInner = PrimaryBodyIrWholeCallInnerForHead(text, "ptr")
    if ptrInner != "":
        let innerSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, ptrInner)
        if innerSlot >= 0 &&
           innerSlot < bodyIR.localSlots.len &&
           PrimaryBodyIrSlotType(bodyIR, innerSlot) == coreir.LocalPtrTag:
            return innerSlot
        if innerSlot >= 0 &&
           innerSlot < bodyIR.localSlots.len &&
           PrimaryBodyIrSlotType(bodyIR, innerSlot) == coreir.LocalI64Tag:
            # ptr(u64Local)：uint64 位模式即指针值，经 Ptr 槽 CopyLocal 传递。
            let ptrFromI64Slot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                               slotNames,
                                                               Fmt"{text}#ptr_cast",
                                                               coreir.LocalPtrTag)
            if ptrFromI64Slot >= 0:
                var ptrCastCopyOp: coreir.BodyOp
                ptrCastCopyOp.kind = coreir.BodyOpCopyLocalTag
                ptrCastCopyOp.target = ptrFromI64Slot
                add(ptrCastCopyOp.operands, innerSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, ptrCastCopyOp)
                return ptrFromI64Slot
        let ptrCastRecursed = PrimaryBodyIrPtrExpressionSlot(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, ptrInner, callOrdinal)
        if ptrCastRecursed >= 0:
            return ptrCastRecursed
    if callOrdinal >= 0 && ptrPlusArgsText == "":
        let genOpen = texpr.TypedExprFindWholeCallOpenParen(text)
        if genOpen > 0:
            let genClose = texpr.TypedExprFindMatchingParen(text, genOpen)
            if genClose == len(text) - 1:
                let genHead = strutil.Strip(strings.SliceBytes(text, 0, genOpen))
                if texpr.TypedExprCallHeadIsPlainQualifiedIdent(genHead) &&
                   !PrimaryBodyIrTextIsCastHead(genHead):
                    let genArgsText = strutil.Strip(strings.SliceBytes(text,
                                                                       genOpen + 1,
                                                                       genClose - genOpen - 1))
                    var genArgNames: str[]
                    if genArgsText != "":
                        genArgNames = PrimaryBodyIrCallArgNames(genArgsText)
                    var genArgSlots: int32[]
                    var genArgsOk = true
                    for genArgIndex in 0..<genArgNames.len:
                        let genArgText = strutil.Strip(genArgNames[genArgIndex])
                        var genArgSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, genArgText)
                        if genArgSlot < 0:
                            let genArgConst = PrimaryBodyIrExtractIntFromText(genArgText)
                            if genArgConst != 0 || PrimaryBodyIrTextIsI32Zero(genArgText):
                                genArgSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                             slotNames,
                                                                             Fmt"#deref_call_arg#{bodyIR.callSequence.len}#{genArgIndex}",
                                                                             coreir.LocalI32Tag,
                                                                             genArgConst)
                        if genArgSlot < 0 &&
                           PrimaryBodyIrWholeCallInnerForHead(genArgText, "ptr") != "":
                            # 指针强转实参先走 Ptr 槽，I32-first 会截断 64 位指针。
                            genArgSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                                        slotNames,
                                                                        varI32ParamNames,
                                                                        typedIr,
                                                                        sourcePath,
                                                                        genArgText,
                                                                        callOrdinal)
                        if genArgSlot < 0:
                            genArgSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                             slotNames,
                                                                             varI32ParamNames,
                                                                             typedIr,
                                                                             sourcePath,
                                                                             genArgText,
                                                                             coreir.LocalI32Tag, callOrdinal)
                        if genArgSlot < 0:
                            genArgSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                             slotNames,
                                                                             varI32ParamNames,
                                                                             typedIr,
                                                                             sourcePath,
                                                                             genArgText,
                                                                             coreir.LocalPtrTag, callOrdinal)
                        if genArgSlot < 0:
                            genArgSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                             slotNames,
                                                                             varI32ParamNames,
                                                                             typedIr,
                                                                             sourcePath,
                                                                             genArgText,
                                                                             coreir.LocalI64Tag, callOrdinal)
                        if genArgSlot < 0 || genArgSlot >= bodyIR.localSlots.len:
                            genArgsOk = false
                            break
                        # A2 str 实参 (FindArgSlot 命中的具名 str 形参/局部, 或以
                        # by-pointer 聚合携带 str 的形参 aux==Str): 镜像语句级 call-arg
                        # 终端 (ValueArgSlotForCall + ByValAggregateArgCopySlot) 的按值
                        # 语义 — 形参槽存 by-pointer 值原样传 (StackValue), 全局 str 载值。
                        # 使 `f(strArg)` 结果作指针表达式内联时真发 call (与 v3/v4 同款),
                        # 不再落穿尾部 arithSlot 读未写槽 (静默 miscompile)。严限 str 形态:
                        # 通用聚合 (rawbytes.Bytes 等) 不放宽, 保持既有 call-arg 路径不扰动。
                        let genArgTypeRaw = PrimaryBodyIrSlotType(bodyIR, genArgSlot)
                        let genArgIsStrForm = genArgTypeRaw == coreir.LocalStrTag ||
                                              (genArgTypeRaw == coreir.LocalAggregateTag &&
                                               bodyIR.localSlots[genArgSlot].auxValue == coreir.LocalStrTag)
                        if genArgIsStrForm:
                            genArgSlot = PrimaryBodyIrValueArgSlotForCall(bodyIR,
                                                                          slotNames,
                                                                          typedIr,
                                                                          sourcePath,
                                                                          genArgText,
                                                                          genArgSlot)
                            if genArgSlot < 0 || genArgSlot >= bodyIR.localSlots.len:
                                genArgsOk = false
                                break
                            genArgSlot = PrimaryBodyIrByValAggregateArgCopySlot(bodyIR,
                                                                                slotNames,
                                                                                genArgSlot,
                                                                                callOrdinal,
                                                                                genArgIndex)
                            if genArgSlot < 0 || genArgSlot >= bodyIR.localSlots.len:
                                genArgsOk = false
                                break
                        let genArgType = PrimaryBodyIrSlotType(bodyIR, genArgSlot)
                        let genArgTypeOk = genArgType == coreir.LocalI32Tag ||
                                           genArgType == coreir.LocalI64Tag ||
                                           genArgType == coreir.LocalPtrTag ||
                                           genArgType == coreir.LocalStrTag ||
                                           (genArgType == coreir.LocalAggregateTag &&
                                            bodyIR.localSlots[genArgSlot].auxValue == coreir.LocalStrTag)
                        if !genArgTypeOk:
                            genArgsOk = false
                            break
                        add(genArgSlots, genArgSlot)
                    if genArgsOk:
                        let genResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                          slotNames,
                                                                          Fmt"#deref_call#{bodyIR.callSequence.len}",
                                                                          coreir.LocalPtrTag)
                        if genResultSlot >= 0:
                            let genCallIndex = bodyIR.callSequence.len
                            var genCall: coreir.CallOp
                            genCall.targetSymbol = genHead
                            genCall.resultSlot = genResultSlot
                            genCall.resultPassKind = coreir.BodyCallPassStackValueTag
                            for genArgIndex in 0..<genArgSlots.len:
                                add(genCall.argSlots, genArgSlots[genArgIndex])
                                add(genCall.argPassKinds, coreir.BodyCallPassStackValueTag)
                            add(bodyIR.callSequence, genCall)
                            var genOp: coreir.BodyOp
                            genOp.kind = coreir.BodyOpCallTag
                            genOp.target = genResultSlot
                            add(genOp.operands, genCallIndex)
                            let _ = coreir.BodyIRAppendOp(bodyIR, genOp)
                            callOrdinal = callOrdinal + 1
                            return genResultSlot
    if os.GetEnv("CHENG_X64_DBG4") != "":
        let ptrExprTailOrdinal: int32 = callOrdinal
        os.WriteLine(os.GetStderr(), Fmt"x64dbg4 ptr_expr_tail text=[{text}] call_ordinal={ptrExprTailOrdinal}")
    # Bare global pointer name (`*(UInt8Ptr(g_buf))` where g_buf is a module
    # global of ptr type): a local slot named g_buf either doesn't exist or
    # carries the global-address place, so reads need a GlobalLoad. Emit it so
    # the deref-store resolves the pointer value instead of bailing.
    if !PrimaryBodyIrTextHasFieldOrIndex(text) &&
       !PrimaryBodyIrTextHasCallSurface(text) &&
       PrimaryBodyIrTypedGlobalTypeExact(typedIr, sourcePath, text) != "":
        let globalPtrSlot = PrimaryBodyIrNodeEvalGlobalLoadSlot(bodyIR,
                                                                slotNames,
                                                                typedIr,
                                                                sourcePath,
                                                                text)
        if globalPtrSlot >= 0 &&
           globalPtrSlot < bodyIR.localSlots.len &&
           PrimaryBodyIrSlotType(bodyIR, globalPtrSlot) == coreir.LocalPtrTag:
            return globalPtrSlot
    # wave-36 ptr_expr_slot_8548_no_poison: 算术兜底对无法真物化的指针形态
    # 曾返回错型未填槽 → 静默 miscompile。取址局部 (&x / ptr(&x)) 与整体为
    # 非 cast-head 调用的 text 一律 return -1，让消费点 poison
    # (addr_of_local_ptr_decl / deref-load false)。cast-head 整调用
    # (uint64(x) 等) 仍走 ScalarValueSlotForText —— synth 臂本就按
    # TextIsCastHead 跳过它们，交给标量机器折叠。
    if PrimaryBodyIrPtrAddressArgName(text) != "":
        return -1
    let tailWholeOpen = texpr.TypedExprFindWholeCallOpenParen(text)
    if tailWholeOpen > 0 &&
       texpr.TypedExprFindMatchingParen(text, tailWholeOpen) == len(text) - 1:
        let tailWholeHead = strutil.Strip(strings.SliceBytes(text, 0, tailWholeOpen))
        if !PrimaryBodyIrTextIsCastHead(tailWholeHead) && tailWholeHead != "sizeof":
            return -1
    let arithSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                        slotNames,
                                                        varI32ParamNames,
                                                        typedIr,
                                                        sourcePath,
                                                        text,
                                                        coreir.LocalI64Tag, callOrdinal)
    if arithSlot >= 0 &&
       arithSlot < bodyIR.localSlots.len &&
       (PrimaryBodyIrSlotType(bodyIR, arithSlot) == coreir.LocalI64Tag ||
        PrimaryBodyIrSlotType(bodyIR, arithSlot) == coreir.LocalPtrTag):
        return arithSlot
    return -1

# W2C 裸 `*name` deref 宽度分派配套: 在当前函数上下文 (shift ctx) 解析裸指针名
# 的绑定类型 —— 参数查参数表, 局部查 typed-ir 局部绑定。供无 typedFn/irFunction
# 作用域的表达式 deref 臂使用; decl-init 臂直接用 BindingTypeForName。
@borrows
fn PrimaryBodyIrCurrentCtxBindingTypeForName(typedIr: texpr.TypedExprIr,
                                             name: str): str =
    if !primaryBodyIrCurrentShiftCtxValid:
        return ""
    for i in 0..<primaryBodyIrCurrentShiftCtxParamNames.len:
        if i >= primaryBodyIrCurrentShiftCtxParamTypes.len:
            break
        if primaryBodyIrCurrentShiftCtxParamNames[i] == name:
            return primaryBodyIrCurrentShiftCtxParamTypes[i]
    return texpr.TypedExprIrLookupLocalBindingTypeAnyLine(typedIr,
                                                          primaryBodyIrCurrentShiftCtxSourcePath,
                                                          primaryBodyIrCurrentShiftCtxFunctionName,
                                                          name)

# W2C 裸 `*name` deref 宽度分派配套: 无条件 U8 deref 发射 (调用方已按声明类型/
# pointee 判定宽度为 1 字节)。裸 `*p` (p 已是 UInt8Ptr) 不匹配
# UInt8PtrDerefPointerText 的 cast 形, 此前一律落 I32 默认臂读成 32 位窗口
# (std/bytes.cheng bufByteAt 实案: readU32LEAt/Mach-O 头解析全灭, GEN2
# got_magic 错位)。int8/uint16 不在本波 (需 ldrsb/U16 tag, 列跟进项)。
@borrows
fn PrimaryBodyIrBarePointerPointeeType(typedIr: texpr.TypedExprIr,
                                       sourcePath: str,
                                       bindingType: str): str =
    if bindingType == "":
        return ""
    let aliasedPointee = PrimaryBodyIrPointeeTypeTextForSource(typedIr, sourcePath, bindingType)
    if aliasedPointee != "":
        return aliasedPointee
    # 别名注册表外的具名指针头 (与 10251 既有指针头清单同源): UInt8Ptr 等的
    # pointee 由类型名直接确定 —— 别名未入本编译闭包时仍能拿到正确宽度。
    let normBindingType = texpr.TypedExprNormalizeTypeText(bindingType)
    if normBindingType == "UInt8Ptr":
        return "uint8"
    if normBindingType == "Int32Ptr":
        return "int32"
    if normBindingType == "UInt32Ptr":
        return "uint32"
    if normBindingType == "Int64Ptr":
        return "int64"
    if normBindingType == "UInt64Ptr":
        return "uint64"
    return ""

@borrows
fn PrimaryBodyIrAppendU8PtrDerefLoadBare(bodyIR: var coreir.BodyIR,
                                         slotNames: var str[],
                                         varI32ParamNames: str[],
                                         typedIr: texpr.TypedExprIr,
                                         sourcePath: str,
                                         pointerText: str,
                                         targetSlot: int32,
                                         callOrdinal: var int32): bool =
    if targetSlot < 0 ||
       targetSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalI32Tag:
        return false
    let pointerSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, pointerText, callOrdinal)
    if pointerSlot < 0:
        return false
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpLoadLocalTag
    op.target = targetSlot
    add(op.operands, coreir.BodyLoadLocalPtrDerefU8Tag)
    add(op.operands, pointerSlot)
    add(op.operands, 1)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    return true

@borrows
fn PrimaryBodyIrAppendUInt8PtrDerefLoad(bodyIR: var coreir.BodyIR,
                                         slotNames: var str[],
                                         varI32ParamNames: str[],
                                         typedIr: texpr.TypedExprIr,
                                         sourcePath: str,
                                         textRaw: str,
                                         targetSlot: int32,
                                         callOrdinal: var int32): bool =
    let pointerText = PrimaryBodyIrUInt8PtrDerefPointerText(textRaw)
    if pointerText == "":
        return false
    if targetSlot < 0 ||
       targetSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalI32Tag:
        return false
    let pointerSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, pointerText, callOrdinal)
    if pointerSlot < 0:
        return false
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpLoadLocalTag
    op.target = targetSlot
    add(op.operands, coreir.BodyLoadLocalPtrDerefU8Tag)
    add(op.operands, pointerSlot)
    add(op.operands, 1)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    return true

@borrows
fn PrimaryBodyIrAppendI32PtrDerefLoad(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       varI32ParamNames: str[],
                                       typedIr: texpr.TypedExprIr,
                                       sourcePath: str,
                                       textRaw: str,
                                       targetSlot: int32,
                                       callOrdinal: var int32): bool =
    let pointerText = PrimaryBodyIrI32PtrDerefPointerText(textRaw)
    if pointerText == "":
        return false
    if targetSlot < 0 ||
       targetSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalI32Tag:
        return false
    let pointerSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, pointerText, callOrdinal)
    if pointerSlot < 0:
        return false
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpLoadLocalTag
    op.target = targetSlot
    add(op.operands, coreir.BodyLoadLocalPtrDerefI32Tag)
    add(op.operands, pointerSlot)
    add(op.operands, 4)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    return true

@borrows
fn PrimaryBodyIrTextIsIntLiteral(textRaw: str): bool =
    let text = strutil.Strip(textRaw)
    if len(text) <= 0:
        return false
    var startPos: int32
    if text[0] == '-':
        if len(text) <= 1:
            return false
        startPos = 1
    for i in startPos..<len(text):
        let ch = text[i]
        if int32(ch) < '0' || int32(ch) > '9':
            return false
    return true

@borrows
fn PrimaryBodyIrUInt64PtrDerefPointerText(textRaw: str): str =
    let text = strutil.Strip(textRaw)
    if len(text) <= 4:
        return ""
    if text[0] != '*':
        return ""
    if text[1] != '(':
        return ""
    if text[len(text) - 1] != ')':
        return ""
    let closePos = texpr.TypedExprFindMatchingParen(text, 1)
    if closePos != len(text) - 1:
        return ""
    let inner = strutil.Strip(strings.SliceBytes(text, 2, len(text) - 3))
    return PrimaryBodyIrWholeCallInnerForHeadSuffix(inner, "UInt64Ptr")

@borrows
fn PrimaryBodyIrAppendUInt64PtrDerefLoad(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          varI32ParamNames: str[],
                                          typedIr: texpr.TypedExprIr,
                                          sourcePath: str,
                                          textRaw: str,
                                          targetSlot: int32,
                                          callOrdinal: var int32): bool =
    let pointerText = PrimaryBodyIrUInt64PtrDerefPointerText(textRaw)
    if pointerText == "":
        return false
    if targetSlot < 0 ||
       targetSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalI64Tag:
        return false
    let pointerSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, pointerText, callOrdinal)
    if pointerSlot < 0:
        return false
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpLoadLocalTag
    op.target = targetSlot
    add(op.operands, coreir.BodyLoadLocalPtrDerefU64Tag)
    add(op.operands, pointerSlot)
    add(op.operands, 8)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    return true

@borrows
fn PrimaryBodyIrU64ValueSlotForText(bodyIR: var coreir.BodyIR,
                                     slotNames: var str[],
                                     varI32ParamNames: str[],
                                     typedIr: texpr.TypedExprIr,
                                     sourcePath: str,
                                     textRaw: str,
                                     callOrdinal: var int32): int32 =
    var text = strutil.Strip(textRaw)
    if text == "":
        return -1
    var u64CastInner = PrimaryBodyIrWholeCallInnerForHead(text, "uint64")
    if u64CastInner == "":
        u64CastInner = PrimaryBodyIrWholeCallInnerForHead(text, "int64")
    if u64CastInner == "":
        u64CastInner = PrimaryBodyIrWholeCallInnerForHead(text, "UInt64")
    if u64CastInner == "":
        u64CastInner = PrimaryBodyIrWholeCallInnerForHead(text, "Int64")
    if u64CastInner != "":
        text = strutil.Strip(u64CastInner)
    if PrimaryBodyIrUInt64PtrDerefPointerText(text) != "":
        let derefSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, text, coreir.LocalI64Tag)
        if derefSlot < 0 ||
           !PrimaryBodyIrAppendUInt64PtrDerefLoad(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, text, derefSlot, callOrdinal):
            return -1
        return derefSlot
    let u64SizeofValue = PrimaryBodyIrSizeofConst(typedIr, sourcePath, text)
    if u64SizeofValue >= 0:
        # sizeof 常量每次使用点新发 LoadConst（唯一槽名）：
        # 复用其它分支内初始化的槽会破坏支配性（mem_header 慢路径曾读到垃圾）。
        let u64SzSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                      slotNames,
                                                      Fmt"#u64sz#{strings.IntToStr(bodyIR.ops.len)}",
                                                      coreir.LocalI64Tag)
        if u64SzSlot < 0:
            return -1
        var u64SzOp: coreir.BodyOp
        u64SzOp.kind = coreir.BodyOpLoadConstTag
        u64SzOp.target = u64SzSlot
        add(u64SzOp.operands, coreir.LocalI64Tag)
        add(u64SzOp.operands, u64SizeofValue)
        let _ = coreir.BodyIRAppendOp(bodyIR, u64SzOp)
        return u64SzSlot
    # Top-level add/sub split (left-assoc: rightmost operator at depth 0).
    var binDepth: int32
    var binOpPos: int32 = -1
    var binOpIsAdd = false
    var binScan: int32 = len(text) - 1
    while binScan > 0:
        let binCh = text[binScan]
        if binCh == ')':
            binDepth = binDepth + 1
        elif binCh == '(':
            binDepth = binDepth - 1
        elif binDepth == 0 && (binCh == '+' || binCh == '-') && text[binScan - 1] == ' ':
            binOpPos = binScan
            binOpIsAdd = binCh == '+'
            break
        binScan = binScan - 1
    if binOpPos > 0:
        let binLhsText = strutil.Strip(strings.SliceBytes(text, 0, binOpPos))
        let binRhsText = strutil.Strip(strings.SliceBytes(text, binOpPos + 1, len(text) - binOpPos - 1))
        let binLhsSlot = PrimaryBodyIrU64ValueSlotForText(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, binLhsText, callOrdinal)
        if binLhsSlot < 0:
            return -1
        let binRhsSlot = PrimaryBodyIrU64ValueSlotForText(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, binRhsText, callOrdinal)
        if binRhsSlot < 0:
            return -1
        let binOutSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"#u64bin#{strings.IntToStr(bodyIR.ops.len)}",
                                                       coreir.LocalI64Tag)
        if binOutSlot < 0:
            return -1
        var binOp: coreir.BodyOp
        binOp.kind = coreir.BodyOpBinOpTag
        binOp.target = binOutSlot
        add(binOp.operands, coreir.LocalI64Tag)
        if binOpIsAdd:
            add(binOp.operands, int32(texpr.TypedExprIrOpI32Add))
        else:
            add(binOp.operands, int32(texpr.TypedExprIrOpI32Sub))
        add(binOp.operands, binLhsSlot)
        add(binOp.operands, binRhsSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, binOp)
        return binOutSlot
    if PrimaryBodyIrTextIsIntLiteral(text):
        let constValue = PrimaryBodyIrExtractIntFromText(text)
        let constSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                      slotNames,
                                                      Fmt"#u64c#{text}",
                                                      coreir.LocalI64Tag)
        if constSlot < 0:
            return -1
        var constOp: coreir.BodyOp
        constOp.kind = coreir.BodyOpLoadConstTag
        constOp.target = constSlot
        add(constOp.operands, coreir.LocalI64Tag)
        add(constOp.operands, constValue)
        let _ = coreir.BodyIRAppendOp(bodyIR, constOp)
        return constSlot
    let directSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, text)
    if directSlot >= 0 && directSlot < bodyIR.localSlots.len:
        let directType = PrimaryBodyIrSlotType(bodyIR, directSlot)
        # A global variable's slot holds its ADDRESS (placeKind=GlobalAddress).
        # Reading it as a value (e.g. inside `uint64(g)` / `int64(g)`) must emit
        # a GlobalLoad — returning the address slot raw yields &g, not g.
        if bodyIR.localSlots[directSlot].placeKind == coreir.BodyPlaceGlobalAddressTag:
            let gValueSlot = PrimaryBodyIrNodeEvalGlobalLoadSlot(bodyIR,
                                                                 slotNames,
                                                                 typedIr,
                                                                 sourcePath,
                                                                 text)
            if gValueSlot >= 0:
                if PrimaryBodyIrSlotType(bodyIR, gValueSlot) == coreir.LocalI32Tag:
                    let gWideSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                  slotNames,
                                                                  Fmt"#u64gw#{text}",
                                                                  coreir.LocalI64Tag)
                    if gWideSlot < 0:
                        return -1
                    var gWideOp: coreir.BodyOp
                    gWideOp.kind = coreir.BodyOpCopyLocalTag
                    gWideOp.target = gWideSlot
                    add(gWideOp.operands, gValueSlot)
                    let _ = coreir.BodyIRAppendOp(bodyIR, gWideOp)
                    return gWideSlot
                return gValueSlot
        elif directType == coreir.LocalI64Tag || directType == coreir.LocalPtrTag:
            return directSlot
        elif directType == coreir.LocalI32Tag:
            let wideSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                         slotNames,
                                                         Fmt"#u64w#{text}",
                                                         coreir.LocalI64Tag)
            if wideSlot < 0:
                return -1
            var wideOp: coreir.BodyOp
            wideOp.kind = coreir.BodyOpCopyLocalTag
            wideOp.target = wideSlot
            add(wideOp.operands, directSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, wideOp)
            return wideSlot
    return PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               typedIr,
                                               sourcePath,
                                               text,
                                               coreir.LocalI64Tag,
                                               callOrdinal)

@borrows
fn PrimaryBodyIrAppendUInt64PtrDerefStore(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           varI32ParamNames: str[],
                                           typedIr: texpr.TypedExprIr,
                                           sourcePath: str,
                                           lhsTextRaw: str,
                                           rhsTextRaw: str,
                                           callOrdinal: var int32): bool =
    let pointerText = PrimaryBodyIrUInt64PtrDerefPointerText(lhsTextRaw)
    if pointerText == "":
        return false
    let pointerSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, pointerText, callOrdinal)
    if pointerSlot < 0:
        return false
    let valueSlot = PrimaryBodyIrU64ValueSlotForText(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, rhsTextRaw, callOrdinal)
    if valueSlot < 0:
        return false
    if PrimaryBodyIrSlotType(bodyIR, valueSlot) == coreir.LocalI32Tag:
        return false
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpIndexedStoreTag
    op.target = pointerSlot
    add(op.operands, pointerSlot)
    add(op.operands, valueSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    return true

@borrows
fn PrimaryBodyIrAppendUInt8PtrDerefStore(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          varI32ParamNames: str[],
                                          typedIr: texpr.TypedExprIr,
                                          sourcePath: str,
                                          lhsTextRaw: str,
                                          rhsTextRaw: str,
                                          failureDetail: var int32,
                                          callOrdinal: var int32): bool =
    failureDetail = 0
    let pointerText = PrimaryBodyIrUInt8PtrDerefPointerText(lhsTextRaw)
    if pointerText == "":
        failureDetail = 711
        return false
    let pointerSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, pointerText, callOrdinal)
    if pointerSlot < 0:
        failureDetail = 712
        return false
    var valueSlot = -1
    if PrimaryBodyIrUInt8PtrDerefPointerText(rhsTextRaw) != "":
        valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"#deref_load#{bodyIR.ops.len}",
                                                  coreir.LocalI32Tag)
        if valueSlot < 0 ||
           !PrimaryBodyIrAppendUInt8PtrDerefLoad(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 typedIr,
                                                 sourcePath,
                                                 rhsTextRaw,
                                                 valueSlot,
                                                 callOrdinal):
            failureDetail = 714
            return false
    else:
        valueSlot = PrimaryBodyIrLocalInitValueSlot(bodyIR,
                                                    slotNames,
                                                    varI32ParamNames,
                                                    typedIr,
                                                    sourcePath,
                                                    "uint8",
                                                    coreir.LocalI32Tag,
                                                    rhsTextRaw, callOrdinal)
        # uint8(call(...)) value: the cast head blocks call synthesis; store8
        # keeps the low byte, so the cast strip is exact.
        var derefStoreValueText = rhsTextRaw
        let derefStoreU8Inner = PrimaryBodyIrTypeCastInnerForTarget(rhsTextRaw, "uint8")
        if derefStoreU8Inner != "":
            derefStoreValueText = strutil.Strip(derefStoreU8Inner)
        if valueSlot < 0 && PrimaryBodyIrTextHasCallSurface(derefStoreValueText):
            # Byte store of a scalar call result: store8 keeps the low byte.
            valueSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       typedIr,
                                                       sourcePath,
                                                       derefStoreValueText,
                                                       callOrdinal)
        if valueSlot < 0:
            valueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            typedIr,
                                                            sourcePath,
                                                            derefStoreValueText,
                                                            coreir.LocalI32Tag, callOrdinal)
    if valueSlot < 0:
        failureDetail = 713
        if os.GetEnv("CHENG_X64_DBG3") != "":
            os.WriteLine(os.GetStderr(), Fmt"x64dbg3 u8store_fail lhs=[{lhsTextRaw}] rhs=[{rhsTextRaw}]")
        return false
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpIndexedStoreTag
    op.target = pointerSlot
    add(op.operands, pointerSlot)
    add(op.operands, valueSlot)
    add(op.operands, coreir.BodyStoreLocalPtrDerefU8Tag)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    return true

@borrows
fn PrimaryBodyIrTypeCastInnerForTarget(textRaw: str,
                                        targetTypeRaw: str): str =
    let text = strutil.Strip(textRaw)
    let targetType = texpr.TypedExprNormalizeTypeText(targetTypeRaw)
    if text == "" || targetType == "":
        return ""
    var openPos: int32 = -1
    for i in 0..<len(text):
        if text[i] == '(':
            openPos = i
            break
    if openPos <= 0:
        return ""
    if text[len(text) - 1] != ')':
        return ""
    let closePos = texpr.TypedExprFindMatchingParen(text, openPos)
    if closePos != len(text) - 1:
        return ""
    let rawHead = strutil.Strip(strings.SliceBytes(text, 0, openPos))
    let head = texpr.TypedExprNormalizeTypeText(rawHead)
    var targetLeafStart: int32
    for i in 0..<len(targetType):
        if targetType[i] == '.':
            targetLeafStart = i + 1
    let targetLeaf = strings.SliceBytes(targetType, targetLeafStart, len(targetType) - targetLeafStart)
    # bail=706 家族: `raw[int(i)]` / `setLen(raw, int(n + ...))` 的平台宽
    # int/uint cast 头原不在剥离表 → 文本标量链 miss 后落 ScalarCall 合成,
    # 把纯 cast 捏造成真调用(call_seq_sym=int → plan 审计 missing_call_target)。
    # int/uint 为 64 位平台宽,与 int64/uint64 头同治(I32 目标经 direct/wide
    # 求值 + CopyLocal 收窄,I64 目标直取)。注释不得嵌进多行 || 条件中间
    # (cold parser 会破坏条件解析 — elemSize sizeof(T) 回归实测)。
    if head == targetType ||
       head == targetLeaf ||
       head == "int64" ||
       head == "Int64" ||
       head == "i64" ||
       head == "I64" ||
       head == "uint64" ||
       head == "UInt64" ||
       head == "u64" ||
       head == "U64" ||
       head == "int" ||
       head == "Int" ||
       head == "uint" ||
       head == "UInt" ||
       head == "ptr":
        return strutil.Strip(strings.SliceBytes(text, openPos + 1, len(text) - openPos - 2))
    return ""

@borrows
fn PrimaryBodyIrStripOuterParens(textRaw: str): str =
    var text = strutil.Strip(textRaw)
    var stripping = true
    while stripping:
        stripping = false
        if len(text) >= 2 && text[0] == '(' && text[len(text) - 1] == ')':
            let closePos = texpr.TypedExprFindMatchingParen(text, 0)
            if closePos == len(text) - 1:
                text = strutil.Strip(strings.SliceBytes(text, 1, len(text) - 2))
                stripping = true
    return text

@borrows
fn PrimaryBodyIrIndexExprParts(textRaw: str,
                               rootOut: var str,
                               indexOut: var str): bool =
    rootOut = ""
    indexOut = ""
    let text = strutil.Strip(textRaw)
    if len(text) < 4 || text[len(text) - 1] != ']':
        return false
    var openPos: int32
    openPos = -1
    for i in 0..<len(text):
        if text[i] == '[':
            openPos = i
            break
    if openPos <= 0:
        return false
    let rootText = strutil.Strip(strings.SliceBytes(text, 0, openPos))
    let indexText = strutil.Strip(strings.SliceBytes(text,
                                                     openPos + 1,
                                                     len(text) - openPos - 2))
    if rootText == "" || indexText == "":
        return false
    rootOut = strings.CloneStr(rootText)
    indexOut = strings.CloneStr(indexText)
    return true

# Split a (possibly multi-dimensional) subscript expression `root[i][j]...`
# into the leading identifier root and the ordered list of per-dimension index
# expression texts. Bracket nesting inside an index expression (e.g.
# `a[b[k]][j]`) is tracked so only top-level `]` close a dimension. Returns the
# number of dimensions found (>=1) or 0 when the text is not a subscript of a
# bare-identifier root.
@borrows
fn PrimaryBodyIrMultiIndexParts(textRaw: str,
                                rootOut: var str,
                                indexListOut: var str[]): int32 =
    rootOut = ""
    indexListOut = []
    let text = strutil.Strip(textRaw)
    if len(text) < 4 || text[len(text) - 1] != ']':
        return 0
    var openPos: int32
    openPos = -1
    for i in 0..<len(text):
        if text[i] == '[':
            openPos = i
            break
    if openPos <= 0:
        return 0
    let rootText = strutil.Strip(strings.SliceBytes(text, 0, openPos))
    if rootText == "":
        return 0
    # A bare-identifier root only: a dotted/arrow/call root is not this shape.
    for i in 0..<len(rootText):
        let rc = rootText[i]
        let okChar = (rc >= 'a' && rc <= 'z') ||
                     (rc >= 'A' && rc <= 'Z') ||
                     (rc >= '0' && rc <= '9') ||
                     rc == '_'
        if !okChar:
            return 0
    var dimCount: int32
    dimCount = 0
    var pos = openPos
    while pos < len(text):
        if text[pos] != '[':
            # any non-bracket character between dimension groups means this is
            # not a pure `root[...][...]` chain.
            return 0
        var depth: int32
        depth = 0
        var closePos: int32
        closePos = -1
        for j in pos..<len(text):
            if text[j] == '[':
                depth = depth + 1
            elif text[j] == ']':
                depth = depth - 1
                if depth == 0:
                    closePos = j
                    break
        if closePos < 0:
            return 0
        let inner = strutil.Strip(strings.SliceBytes(text, pos + 1, closePos - pos - 1))
        if inner == "":
            return 0
        add(indexListOut, inner)
        dimCount = dimCount + 1
        pos = closePos + 1
    if dimCount <= 0:
        return 0
    rootOut = rootText
    return dimCount

# Extract the ordered fixed-array dimension sizes from a type text like
# `int32[3][4]` -> [3, 4] (row-major: outer dim first), plus the scalar element
# byte size. Returns the dimension count, or 0 when the type is not a chain of
# fixed `[N]` groups over a known-size scalar/aggregate element.
@borrows
fn PrimaryBodyIrFixedArrayDimsFromText(typedIr: texpr.TypedExprIr,
                                       sourcePath: str,
                                       typeRaw: str,
                                       dimsOut: var int32[],
                                       elemSizeOut: var int32): int32 =
    dimsOut = []
    elemSizeOut = 0
    let typeText = texpr.TypedExprNormalizeTypeText(typeRaw)
    if typeText == "" ||
       PrimaryStartsWith(typeText, "seq[") ||
       PrimaryStartsWith(typeText, "array[") ||
       PrimaryStartsWith(typeText, "Result["):
        return 0
    if len(typeText) < 4 || typeText[len(typeText) - 1] != ']':
        return 0
    # Find the element-type prefix: everything before the FIRST top-level `[`.
    var firstOpen: int32
    firstOpen = -1
    for i in 0..<len(typeText):
        if typeText[i] == '[':
            firstOpen = i
            break
    if firstOpen <= 0:
        return 0
    let elemType = strings.SliceBytes(typeText, 0, firstOpen)
    var elemKind: int32
    var elemSize: int32
    var elemAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   elemType,
                                   elemKind,
                                   elemSize,
                                   elemAlign)
    if elemSize <= 0:
        return 0
    # Walk each `[N]` group left-to-right collecting the dimension sizes.
    var dimCount: int32
    dimCount = 0
    var pos = firstOpen
    while pos < len(typeText):
        if typeText[pos] != '[':
            return 0
        var closePos: int32
        closePos = -1
        for j in pos..<len(typeText):
            if typeText[j] == ']':
                closePos = j
                break
        if closePos < 0:
            return 0
        let countText = strutil.Strip(strings.SliceBytes(typeText, pos + 1, closePos - pos - 1))
        let count = PrimaryBodyIrFixedArrayLengthFromText(typedIr, sourcePath, countText)
        if count <= 0:
            return 0
        add(dimsOut, count)
        dimCount = dimCount + 1
        pos = closePos + 1
    if dimCount <= 0:
        return 0
    elemSizeOut = elemSize
    return dimCount

# Row-major flatten of a multi-dimensional subscript `root[i0][i1]...` against a
# fixed-array binding type `T[d0][d1]...` into the equivalent single-index text
# `root[((i0)*d1+(i1))*d2+(i2)...]`. The flattened index reuses the existing
# 1-D indexed load/store machinery (the scalar evaluator builds the i*cols+j
# arithmetic). Returns true and fills flatTextOut only when the subscript and the
# type agree on dimension count >= 2; 1-D or mismatched shapes return false and
# leave the caller on its existing path.
@borrows
fn PrimaryBodyIrFlattenMultiIndexText(typedIr: texpr.TypedExprIr,
                                      sourcePath: str,
                                      bindingType: str,
                                      subscriptText: str,
                                      flatTextOut: var str): bool =
    flatTextOut = ""
    var root = ""
    var indexList: str[]
    indexList = []
    let dimCount = PrimaryBodyIrMultiIndexParts(subscriptText, root, indexList)
    if dimCount < 2:
        return false
    var dims: int32[]
    dims = []
    var elemSize: int32
    let typeDimCount = PrimaryBodyIrFixedArrayDimsFromText(typedIr,
                                                           sourcePath,
                                                           bindingType,
                                                           dims,
                                                           elemSize)
    if typeDimCount != dimCount:
        return false
    # Horner row-major fold: flat = (((i0)*d1 + i1)*d2 + i2)...  The accumulated
    # sub-expression is parenthesized before each multiply so operator precedence
    # is preserved; each leaf index is parenthesized so a compound index keeps its
    # grouping. The first leaf is emitted bare to avoid a redundant double wrap.
    var flat = strings.CloneStr(indexList[0])
    for d in 1..<dimCount:
        flat = strutil.Join(["(", share(flat), ")*", strings.IntToStr(dims[d]), "+(", strings.CloneStr(indexList[d]), ")"], "")
    flatTextOut = strutil.Join([share(root), "[", share(flat), "]"], "")
    return true

@borrows
fn PrimaryBodyIrLenCallInner(textRaw: str): str =
    let lowerInner = PrimaryBodyIrWholeCallInnerForHead(textRaw, "len")
    if lowerInner != "":
        return lowerInner
    let lenInner = PrimaryBodyIrWholeCallInnerForHeadSuffix(textRaw, "Len")
    if lenInner != "":
        return lenInner
    return ""

@borrows
fn PrimaryBodyIrMaterializeStrValueSlot(bodyIR: var coreir.BodyIR,
                                         slotNames: var str[],
                                         varI32ParamNames: str[],
                                         typedIr: texpr.TypedExprIr,
                                         typedFn: texpr.TypedExprIrFunction,
                                         irFunction: lower.PrimaryObjectIrFunction,
                                         sourcePath: str,
                                         lineNumber: int32,
                                         textRaw: str): int32 =
    let text = strutil.Strip(textRaw)
    if text == "":
        return -1
    let directSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, text)
    if directSlot >= 0 &&
       PrimaryBodyIrSlotIsStrRoot(bodyIR, directSlot):
        # SlotIsStrRoot(:6700) 是 LocalStrTag 严格超集: 额外认领 var str 形参槽
        # (Aggregate+auxValue=Str+IsParam), 使 `var str` 形参作 str 值时经 param
        # 间接协议物化 (下游 FieldLoad aggregate+param 臂已内建, StrDataPtrValue 平行
        # 铁证)。plain str 无回归 (超集), miss 仍返 -1 保 poison。目标清 osHostProcessWireArgLen 622。
        return directSlot
    var indexRoot = ""
    var indexText = ""
    if PrimaryBodyIrIndexExprParts(text, indexRoot, indexText):
        let rootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, indexRoot)
        if rootSlot >= 0 &&
           rootSlot < bodyIR.localSlots.len &&
           bodyIR.localSlots[rootSlot].typeKind == coreir.LocalAggregateTag:
            let rootType = PrimaryBodyIrBindingTypeForName(typedIr,
                                                           typedFn,
                                                           irFunction,
                                                           lineNumber,
                                                           indexRoot)
            var elemKind: int32
            var elemSize: int32
            if !PrimaryBodyIrSeqElementShapeFromText(typedIr,
                                                     sourcePath,
                                                     rootType,
                                                     elemKind,
                                                     elemSize):
                return -1
            let rootIsDynamicSeq = PrimaryBodyIrTypeTextIsDynamicSeq(rootType)
            if elemKind != coreir.LocalStrTag || elemSize != 24:
                return -1
            let indexSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       typedIr,
                                                                       share(typedFn),
                                                                       share(irFunction),
                                                                       sourcePath,
                                                                       lineNumber,
                                                                       indexText,
                                                                       coreir.LocalI32Tag)
            let valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          text,
                                                          coreir.LocalStrTag)
            if indexSlot < 0 || valueSlot < 0:
                return -1
            var indexOp: coreir.BodyOp
            indexOp.kind = coreir.BodyOpIndexedLoadTag
            indexOp.target = valueSlot
            add(indexOp.operands, rootSlot)
            add(indexOp.operands, valueSlot)
            add(indexOp.operands, indexSlot)
            add(indexOp.operands, 24)
            if rootIsDynamicSeq:
                add(indexOp.operands, 1)
            let _ = coreir.BodyIRAppendOp(bodyIR, indexOp)
            return valueSlot
    if PrimaryBodyIrTextHasFieldOrIndex(text) &&
       texpr.TypedExprTextIsSimpleFieldPath(text):
        var fieldFailure0: int32
        var fieldFailure1: int32
        let fieldSlot = PrimaryBodyIrMaterializeFieldArgSlot(bodyIR,
                                                             slotNames,
                                                             typedIr,
                                                             typedFn,
                                                             irFunction,
                                                             sourcePath,
                                                             lineNumber,
                                                             text,
                                                             fieldFailure0,
                                                             fieldFailure1)
        if fieldSlot >= 0 &&
           fieldSlot < bodyIR.localSlots.len &&
           PrimaryBodyIrSlotType(bodyIR, fieldSlot) == coreir.LocalStrTag:
            return fieldSlot
    # `Value(resultVar)` 裸投影（无尾随 `.field`）：整聚合构造器字段值链里常见
    # `manifestBytes: len(Value(wireRes))`（wireRes: Result[str]) 形态。既有
    # ContextResultValueFieldSlot（11299）只认 `Value(x).field` 尾随字段投影;
    # 这里补裸投影本身当 str 值源（成功 payload 定宽 24B, 按 ResultConstructLayout
    # 的 valueOffset 定位, 与既有 FieldLoad 发射同款), 使 len(Value(x)) 等纯标量
    # 上下文里的 Result[str] 裸投影可解, 不新增回落语义(非 str 内型/非聚合 Result
    # 槽/布局查不到均原样 -1)。
    if parser.ParserStartsWith(text, "Value(") &&
       text[text.len - 1] == ')':
        let bareOpenPos = parser.ParserFindText(text, "(")
        if bareOpenPos > 0:
            let bareClosePos = texpr.TypedExprFindMatchingParen(text, bareOpenPos)
            if bareClosePos == text.len - 1:
                let bareResultName = strutil.Strip(strings.SliceBytes(text,
                                                                      bareOpenPos + 1,
                                                                      bareClosePos - bareOpenPos - 1))
                if bareResultName != "" && parser.ParserIdentPrefix(bareResultName) == bareResultName:
                    let bareResultSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, bareResultName)
                    if bareResultSlot >= 0 &&
                       bareResultSlot < bodyIR.localSlots.len &&
                       PrimaryBodyIrSlotType(bodyIR, bareResultSlot) == coreir.LocalAggregateTag:
                        let bareResultType = texpr.TypedExprStripVarType(PrimaryBodyIrBindingTypeForName(typedIr,
                                                                                                          typedFn,
                                                                                                          irFunction,
                                                                                                          lineNumber,
                                                                                                          bareResultName))
                        let bareInnerType = texpr.TypedExprResultSuccessType(bareResultType)
                        if bareInnerType != "":
                            var bareValueKind: int32
                            var bareValueSize: int32
                            var bareValueOffset: int32
                            var bareErrCodeOffset: int32
                            var bareErrMsgOffset: int32
                            var bareTotalSize: int32
                            if PrimaryBodyIrResultConstructLayout(typedIr,
                                                                  sourcePath,
                                                                  bareInnerType,
                                                                  bareValueKind,
                                                                  bareValueSize,
                                                                  bareValueOffset,
                                                                  bareErrCodeOffset,
                                                                  bareErrMsgOffset,
                                                                  bareTotalSize):
                                if bareValueKind == coreir.LocalStrTag &&
                                   PrimaryLocalSlotSizeOf(bodyIR.localSlots[bareResultSlot]) >= bareValueOffset + bareValueSize:
                                    let bareValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                      slotNames,
                                                                                      text,
                                                                                      coreir.LocalStrTag)
                                    if bareValueSlot >= 0:
                                        var bareValueOp: coreir.BodyOp
                                        bareValueOp.kind = coreir.BodyOpFieldLoadTag
                                        bareValueOp.target = bareValueSlot
                                        add(bareValueOp.operands, bareResultSlot)
                                        add(bareValueOp.operands, bareValueSlot)
                                        add(bareValueOp.operands, bareValueOffset)
                                        add(bareValueOp.operands, bareValueSize)
                                        let _ = coreir.BodyIRAppendOp(bodyIR, bareValueOp)
                                        return bareValueSlot
    return -1

@borrows
fn PrimaryBodyIrAppendStrLenArgValue(bodyIR: var coreir.BodyIR,
                                      slotNames: var str[],
                                      varI32ParamNames: str[],
                                      typedIr: texpr.TypedExprIr,
                                      typedFn: texpr.TypedExprIrFunction,
                                      irFunction: lower.PrimaryObjectIrFunction,
                                      sourcePath: str,
                                      lineNumber: int32,
                                      argText: str,
                                      targetSlot: int32): bool =
    if targetSlot < 0 ||
       targetSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalI32Tag:
        return false
    let strSlot = PrimaryBodyIrMaterializeStrValueSlot(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       sourcePath,
                                                       lineNumber,
                                                       argText)
    if strSlot < 0:
        return false
    var lenOp: coreir.BodyOp
    lenOp.kind = coreir.BodyOpFieldLoadTag
    lenOp.target = targetSlot
    add(lenOp.operands, strSlot)
    add(lenOp.operands, targetSlot)
    add(lenOp.operands, 8)
    add(lenOp.operands, 4)
    let _ = coreir.BodyIRAppendOp(bodyIR, lenOp)
    return true

@borrows
fn PrimaryBodyIrCallTargetIsLen(callee: str, target: str, surface: str): bool =
    if callee == "len" || callee == "Len":
        return true
    if target == "len" || target == "Len":
        return true
    let targetTail = PrimaryCallTargetTailName(target)
    if targetTail == "len" || targetTail == "Len":
        return true
    if surface == "len" || surface == "Len":
        return true
    return false

@borrows
fn PrimaryBodyIrSizeofConst(typedIr: texpr.TypedExprIr,
                             sourcePath: str,
                             textRaw: str): int32 =
    let typeText = PrimaryBodyIrWholeCallInnerForHead(textRaw, "sizeof")
    if typeText == "":
        return -1
    var typeKind: int32
    var sizeBytes: int32
    var alignBytes: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   typeText,
                                   typeKind,
                                   sizeBytes,
                                   alignBytes)
    if sizeBytes > 0:
        return sizeBytes
    if typeKind == coreir.LocalI32Tag:
        return 4
    if typeKind == coreir.LocalI64Tag ||
       typeKind == coreir.LocalPtrTag ||
       typeKind == coreir.LocalF64Tag:
        return 8
    if typeKind == coreir.LocalStrTag:
        return 24
    if typeKind == coreir.LocalAggregateTag:
        return coreir.ResultStrSizeBytes
    return -1

@borrows
fn PrimaryBodyIrConditionText(textRaw: str): str =
    var text = strutil.Strip(textRaw)
    if PrimaryStartsWith(text, "if "):
        text = strutil.Strip(strings.SliceBytes(text, 3, len(text) - 3))
    elif PrimaryStartsWith(text, "elif "):
        text = strutil.Strip(strings.SliceBytes(text, 5, len(text) - 5))
    elif PrimaryStartsWith(text, "while "):
        text = strutil.Strip(strings.SliceBytes(text, 6, len(text) - 6))
    if len(text) > 0 && text[len(text) - 1] == ':':
        text = strutil.Strip(strings.SliceBytes(text, 0, len(text) - 1))
    return text

# Identifier byte: a-z A-Z 0-9 _. Keyword operators (`and`/`or`) must match on
# word boundaries so that e.g. `band`/`random`/`orientation` are never split.
@borrows
fn PrimaryBodyIrConditionIdentByte(ch: int32): bool =
    if ch >= 'a' && ch <= 'z':
        return true
    if ch >= 'A' && ch <= 'Z':
        return true
    if ch >= '0' && ch <= '9':
        return true
    if ch == '_':
        return true
    return false

# Token match at `pos` that also enforces word boundaries when the token begins
# with an identifier byte (the keyword operators `and`/`or`). Symbolic tokens
# (`&&`/`||`) keep the original boundary-free match.
@borrows
fn PrimaryBodyIrConditionTokenMatchAt(condText: str,
                                       pos: int32,
                                       tokenText: str): bool =
    if !texpr.TypedExprTextAt(condText, pos, tokenText):
        return false
    if len(tokenText) <= 0 || !PrimaryBodyIrConditionIdentByte(int32(tokenText[0])):
        return true
    if pos > 0 && PrimaryBodyIrConditionIdentByte(int32(condText[pos - 1])):
        return false
    let after = pos + len(tokenText)
    if after < len(condText) && PrimaryBodyIrConditionIdentByte(int32(condText[after])):
        return false
    return true

@borrows
fn PrimaryBodyIrConditionTopLevelTokenPos(condText: str,
                                           tokenText: str): int32 =
    if tokenText == "":
        return -1
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    var inString = false
    var inChar = false
    var escaped = false
    var i: int32
    while i < len(condText):
        let ch = condText[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif inChar:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '\'':
                inChar = false
        elif ch == '"':
            inString = true
        elif ch == '\'':
            inChar = true
        elif ch == '[':
            bracketDepth = bracketDepth + 1
        elif ch == ']':
            bracketDepth = bracketDepth - 1
        elif ch == '(':
            parenDepth = parenDepth + 1
        elif ch == ')':
            parenDepth = parenDepth - 1
        elif ch == '{':
            braceDepth = braceDepth + 1
        elif ch == '}':
            braceDepth = braceDepth - 1
        elif bracketDepth == 0 && parenDepth == 0 && braceDepth == 0:
            if PrimaryBodyIrConditionTokenMatchAt(condText, i, tokenText):
                return i
        i = i + 1
    return -1

@borrows
fn PrimaryBodyIrConditionHasAnd(condText: str): bool =
    let rootText = PrimaryBodyIrStripOuterParens(condText)
    if PrimaryBodyIrConditionTopLevelTokenPos(rootText, "&&") >= 0:
        return true
    if PrimaryBodyIrConditionTopLevelTokenPos(rootText, "and") >= 0:
        return true
    return false

@borrows
fn PrimaryBodyIrConditionHasOr(condText: str): bool =
    let rootText = PrimaryBodyIrStripOuterParens(condText)
    if PrimaryBodyIrConditionTopLevelTokenPos(rootText, "||") >= 0:
        return true
    if PrimaryBodyIrConditionTopLevelTokenPos(rootText, "or") >= 0:
        return true
    return false

@borrows
fn PrimaryBodyIrConditionHasTrailingConnector(condTextRaw: str): bool =
    let condText = strutil.Strip(condTextRaw)
    if len(condText) < 2:
        return false
    let lastTwo = strings.SliceBytes(condText, len(condText) - 2, 2)
    if lastTwo == "&&":
        return true
    if lastTwo == "||":
        return true
    # Trailing keyword connector: `... and` / `... or` (preceded by whitespace).
    if len(condText) >= 4 &&
       strings.SliceBytes(condText, len(condText) - 4, 4) == " and":
        return true
    if len(condText) >= 3 &&
       strings.SliceBytes(condText, len(condText) - 3, 3) == " or":
        return true
    return false

@borrows
fn PrimaryBodyIrSplitConditionToken(condText: str,
                                     tokenText: str): str[] =
    var parts: str[]
    if tokenText == "":
        return parts
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    var inString = false
    var inChar = false
    var escaped = false
    var start: int32
    var i: int32
    while i < len(condText):
        let ch = condText[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
        elif inChar:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '\'':
                inChar = false
        elif ch == '"':
            inString = true
        elif ch == '\'':
            inChar = true
        elif ch == '[':
            bracketDepth = bracketDepth + 1
        elif ch == ']':
            bracketDepth = bracketDepth - 1
        elif ch == '(':
            parenDepth = parenDepth + 1
        elif ch == ')':
            parenDepth = parenDepth - 1
        elif ch == '{':
            braceDepth = braceDepth + 1
        elif ch == '}':
            braceDepth = braceDepth - 1
        elif bracketDepth == 0 && parenDepth == 0 && braceDepth == 0:
            if PrimaryBodyIrConditionTokenMatchAt(condText, i, tokenText):
                add(parts, strutil.Strip(strings.SliceBytes(condText, start, i - start)))
                i = i + len(tokenText)
                start = i
                continue
        i = i + 1
    if start < len(condText):
        add(parts, strutil.Strip(strings.SliceBytes(condText, start, len(condText) - start)))
    else:
        if parts.len == 0:
            add(parts, strutil.Strip(condText))
    return parts

# `&&` and the keyword `and` are the same operator; the condition splitter must
# treat whichever form the surface text carries. A condition never mixes both at
# top level, so pick the form that is actually present.
@borrows
fn PrimaryBodyIrSplitAndConditions(condText: str): str[] =
    if PrimaryBodyIrConditionTopLevelTokenPos(condText, "&&") >= 0:
        return PrimaryBodyIrSplitConditionToken(condText, "&&")
    return PrimaryBodyIrSplitConditionToken(condText, "and")

@borrows
fn PrimaryBodyIrSplitOrConditions(condText: str): str[] =
    if PrimaryBodyIrConditionTopLevelTokenPos(condText, "||") >= 0:
        return PrimaryBodyIrSplitConditionToken(condText, "||")
    return PrimaryBodyIrSplitConditionToken(condText, "or")

@borrows
fn PrimaryBodyIrConditionFieldOperandSlot(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           typedIr: texpr.TypedExprIr,
                                           typedFn: texpr.TypedExprIrFunction,
                                           irFunction: lower.PrimaryObjectIrFunction,
                                           sourcePath: str,
                                           lineNumber: int32,
                                           textRaw: str,
                                           nextOpIndex: var int32): int32 =
    primarySlotStageProbe(bodyIR, "cond_field_enter", 10656)
    let text = PrimaryBodyIrStripOuterParens(textRaw)
    if text == "":
        return -1
    # 条件字段操作数路径不参与调用序列：ordinal=-1 禁用调用物化，
    # 否则局部计数与 callSequence 注册错位（callSequence[callOrdinal] 会错引）。
    var callOrdinal: int32 = -1
    # Multi-dimensional fixed-array compare operand `grid[i][j]`: row-major flatten
    # to `grid[(i)*cols+(j)]` and re-enter so the bare-root indexed-load path below
    # resolves the real element address. Without this the multi-bracket index text
    # failed to parse and the operand degraded to a sub-array address.
    if !PrimaryBodyIrTextHasCallSurface(text):
        var condMultiRoot = ""
        var condMultiList: str[]
        condMultiList = []
        if PrimaryBodyIrMultiIndexParts(text, condMultiRoot, condMultiList) >= 2:
            var condMultiType = PrimaryBodyIrBindingTypeForName(typedIr,
                                                                typedFn,
                                                                irFunction,
                                                                lineNumber,
                                                                condMultiRoot)
            if texpr.TypedExprNormalizeTypeText(condMultiType) == "":
                condMultiType = texpr.TypedExprIrLookupLocalBindingTypeAnyLine(typedIr,
                                                                               sourcePath,
                                                                               typedFn.functionName,
                                                                               condMultiRoot)
            var condFlatText = ""
            if condMultiType != "" &&
               PrimaryBodyIrFlattenMultiIndexText(typedIr,
                                                  sourcePath,
                                                  condMultiType,
                                                  text,
                                                  condFlatText):
                return PrimaryBodyIrConditionFieldOperandSlot(bodyIR,
                                                              slotNames,
                                                              typedIr,
                                                              typedFn,
                                                              irFunction,
                                                              sourcePath,
                                                              lineNumber,
                                                              condFlatText,
                                                              nextOpIndex)
    # Fixed-array element field read `xs[i].field` (index in the root segment,
    # plain field tail): compute base+idx*stride and FieldLoad. The bare-root and
    # field-tail-index paths below only fire when text ENDS with `]`, so this
    # `[i].field` form would otherwise fall through to a stale fresh slot.
    if !PrimaryBodyIrTextHasCallSurface(text):
        var faeCondParamNames: str[]
        faeCondParamNames = []
        let opsBeforeFaeCond = bodyIR.ops.len
        let faeCondSlot = PrimaryBodyIrFixedArrayIndexedFieldValueSlot(bodyIR,
                                                                       slotNames,
                                                                       faeCondParamNames,
                                                                       typedIr,
                                                                       share(typedFn),
                                                                       irFunction,
                                                                       sourcePath,
                                                                       lineNumber,
                                                                       text,
                                                                       callOrdinal)
        if faeCondSlot >= 0:
            nextOpIndex = nextOpIndex + (bodyIR.ops.len - opsBeforeFaeCond)
            return faeCondSlot
        # `root.arrayField[idx].subField` read: array of structs as a struct
        # field. The bare-root handler above rejects a dotted root; without this
        # the read collapses to a static field offset (index + inner offset both
        # dropped) and reads the wrong cell.
        var faisCondParamNames: str[]
        faisCondParamNames = []
        let opsBeforeFaisCond = bodyIR.ops.len
        let faisCondSlot = PrimaryBodyIrFieldArrayIndexedSubFieldValueSlot(bodyIR,
                                                                           slotNames,
                                                                           faisCondParamNames,
                                                                           typedIr,
                                                                           share(typedFn),
                                                                           irFunction,
                                                                           sourcePath,
                                                                           lineNumber,
                                                                           text,
                                                                           callOrdinal)
        if faisCondSlot >= 0:
            nextOpIndex = nextOpIndex + (bodyIR.ops.len - opsBeforeFaisCond)
            return faisCondSlot
    var indexedRoot = ""
    var indexedText = ""
    # Bare-identifier seq roots (locals and var seq params) index through
    # the slot directly: aggregate slots address the header on the stack,
    # ptr param slots hold the header address, and the seq deref flag
    # resolves the data pointer either way.
    if PrimaryBodyIrIndexExprParts(text, indexedRoot, indexedText) &&
       !PrimaryBodyIrTextHasDot(indexedRoot):
        let bareIdxRoot = strings.CloneStr(indexedRoot)
        let bareIdxText = strings.CloneStr(indexedText)
        let bareRootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, bareIdxRoot)
        if bareRootSlot >= 0 && bareRootSlot < bodyIR.localSlots.len:
            let bareRootKind = PrimaryBodyIrSlotType(bodyIR, bareRootSlot)
            if bareRootKind == coreir.LocalAggregateTag ||
               bareRootKind == coreir.LocalPtrTag:
                let bareRootType = PrimaryBodyIrBindingTypeForName(typedIr,
                                                                   typedFn,
                                                                   irFunction,
                                                                   lineNumber,
                                                                   bareIdxRoot)
                var bareElemKind: int32
                var bareElemSize: int32
                if bareRootType != "" &&
                   PrimaryBodyIrSeqElementShapeFromText(typedIr,
                                                        sourcePath,
                                                        texpr.TypedExprStripVarType(bareRootType),
                                                        bareElemKind,
                                                        bareElemSize):
                    let bareRootIsDynamicSeq = PrimaryBodyIrTypeTextIsDynamicSeq(texpr.TypedExprStripVarType(bareRootType))
                    # T78 v3: a FIXED inline array's element slots are laid out at
                    # PrimaryBodyIrTypeShapeFromText's aligned register width (bool
                    # slot 4B, not the 1B packed width SeqElementShapeFromText hands
                    # back for a GROWABLE seq's tightly-packed heap buffer) — the
                    # store side (`arr[i]=v`, and every other fixed-array indexed
                    # read, e.g. EvalNode's IndexGet ~38289) already uses that wider
                    # stride. This text-CBR-chain condition leaf never picked up the
                    # correction, so a fixed bool[N] array read as a bare `&&`/`||`
                    # operand (`i < 4 && arr[i]`) computed the address at the wrong
                    # (1-byte) stride and loaded a neighboring byte instead of the
                    # element — a silent wrong value, not a bail (T78 current adversarial
                    # review declbool_fixedsrc/decltern_fixedsrc/assigntern_fixedsrc/
                    # fstore_bool_fixedsrc). Dynamic seqs keep the packed width.
                    if !bareRootIsDynamicSeq:
                        let bareFixedElemTypeText = PrimaryBodyIrIndexedElementTypeText(texpr.TypedExprStripVarType(bareRootType))
                        if bareFixedElemTypeText != "":
                            var bareFixedShapeKind: int32
                            var bareFixedShapeSize: int32
                            var bareFixedShapeAlign: int32
                            PrimaryBodyIrTypeShapeFromText(typedIr,
                                                           sourcePath,
                                                           bareFixedElemTypeText,
                                                           bareFixedShapeKind,
                                                           bareFixedShapeSize,
                                                           bareFixedShapeAlign)
                            if bareFixedShapeSize > 0 && bareFixedShapeSize >= bareElemSize:
                                bareElemSize = bareFixedShapeSize
                    var bareVarI32ParamNames: str[]
                    bareVarI32ParamNames = []
                    let opsBeforeBareIndexed = bodyIR.ops.len
                    let bareIndexSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                            slotNames,
                                                                            bareVarI32ParamNames,
                                                                            typedIr,
                                                                            sourcePath,
                                                                            bareIdxText,
                                                                            coreir.LocalI32Tag, callOrdinal)
                    if bareIndexSlot >= 0:
                        var bareValueKind = bareElemKind
                        if bareElemSize == 1:
                            bareValueKind = coreir.LocalI32Tag
                        # unique name: a typed slot named after the raw index
                        # text may already exist with an aggregate kind
                        let bareValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                          slotNames,
                                                                          Fmt"{text}#seq_elem#{lineNumber}",
                                                                          bareValueKind)
                        if bareValueSlot >= 0:
                            var bareIndexOp: coreir.BodyOp
                            bareIndexOp.kind = coreir.BodyOpIndexedLoadTag
                            bareIndexOp.target = bareValueSlot
                            add(bareIndexOp.operands, bareRootSlot)
                            add(bareIndexOp.operands, bareValueSlot)
                            add(bareIndexOp.operands, bareIndexSlot)
                            add(bareIndexOp.operands, bareElemSize)
                            if bareRootIsDynamicSeq:
                                add(bareIndexOp.operands, 1)
                            let _ = coreir.BodyIRAppendOp(bodyIR, bareIndexOp)
                            nextOpIndex = nextOpIndex + (bodyIR.ops.len - opsBeforeBareIndexed)
                            return bareValueSlot
    if PrimaryBodyIrIndexExprParts(text, indexedRoot, indexedText) &&
       texpr.TypedExprTextIsSimpleFieldPath(indexedRoot):
        let fieldIdxRoot = strings.CloneStr(indexedRoot)
        let fieldIdxText = strings.CloneStr(indexedText)
        let rootName = texpr.TypedExprAssignLhsRootName(fieldIdxRoot)
        let fieldPath = texpr.TypedExprAssignFieldPath(fieldIdxRoot)
        let rootType = PrimaryBodyIrBindingTypeForName(typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       lineNumber,
                                                       rootName)
        if rootName == "" ||
           fieldPath == "" ||
           rootType == "" ||
           rootType == "unknown" ||
           !PrimaryObjectMetadataTextStable(rootType):
            return -1
        var fieldType = ""
        var fieldOffsetBytes: int32
        var fieldSizeBytes: int32
        var fieldAlignBytes: int32
        var fieldMetaOk = PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                                             sourcePath,
                                                             rootType,
                                                             fieldPath,
                                                             fieldType,
                                                             fieldOffsetBytes,
                                                             fieldSizeBytes,
                                                             fieldAlignBytes)
        if !fieldMetaOk && PrimaryBodyIrTextHasDot(fieldPath):
            fieldMetaOk = texpr.TypedExprIrLookupFieldPathMeta(typedIr,
                                                               strings.CloneStr(sourcePath),
                                                               rootType,
                                                               fieldPath,
                                                               fieldType,
                                                               fieldOffsetBytes,
                                                               fieldSizeBytes,
                                                               fieldAlignBytes)
        if !fieldMetaOk:
            return -1
        var elemKind: int32
        var elemSize: int32
        if !PrimaryBodyIrSeqElementShapeFromText(typedIr,
                                                 sourcePath,
                                                 fieldType,
                                                 elemKind,
                                                 elemSize):
            return -1
        let fieldIsDynamicSeq = PrimaryBodyIrTypeTextIsDynamicSeq(fieldType)
        # T78 v4: FIXED array struct-field root (`s.arr[i]`) reads the element
        # by DIRECT address (struct_base+fieldOffsetBytes+idx*alignedStride),
        # mirroring both the write side's own addressing
        # (PrimaryBodyIrAppendSimpleFieldAssignFast: SeqAddHeaderPtrSlot(base,
        # fieldOffsetBytes) + Madd(idx, TypeShapeFromText-aligned elemSize))
        # and EvalNode IndexGet's "Fast path: g.field[i]" direct-address arm.
        # A FIXED array field's inline element slots are laid out at
        # TypeShapeFromText's aligned register width (bool 4B), not the 1B
        # packed width SeqElementShapeFromText hands back for a GROWABLE
        # seq's heap buffer. An earlier version of this fix tried instead to
        # keep the existing "materialize the whole field into a temp
        # aggregate slot, then IndexedLoad within it" shape and just widen
        # the temp slot / copy width to the aligned total size — that is
        # UNSAFE: the temp copy's source bytes only exist inside the OWNING
        # STRUCT's own (front-end packed-sized) allocation, and widening the
        # copy past it is an out-of-bounds read of the struct itself (this
        # compiler's own bounds gate correctly refused it, ZC_NOT_READY, on
        # a `type X=(arr:bool[4];other:int32)` repro — the struct is only
        # 8B, an aligned bool[4] copy would need 16B). Reading the element
        # directly off the struct's real address needs no such copy, and is
        # exactly what the store side already does, so read-after-write
        # stays byte-consistent without ever needing to know the struct's
        # total size. Dynamic seq fields are unaffected (unchanged below,
        # packed width, buffer-indirect).
        if !fieldIsDynamicSeq:
            let fixedFieldElemTypeText = PrimaryBodyIrIndexedElementTypeText(fieldType)
            if fixedFieldElemTypeText == "":
                return -1
            var fixedFieldShapeKind: int32
            var fixedFieldShapeSize: int32
            var fixedFieldShapeAlign: int32
            PrimaryBodyIrTypeShapeFromText(typedIr,
                                           sourcePath,
                                           fixedFieldElemTypeText,
                                           fixedFieldShapeKind,
                                           fixedFieldShapeSize,
                                           fixedFieldShapeAlign)
            if fixedFieldShapeSize <= 0 || fixedFieldShapeSize < elemSize:
                return -1
            let fixedFieldBaseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                                            slotNames,
                                                                            typedIr,
                                                                            sourcePath,
                                                                            rootName,
                                                                            rootType)
            if fixedFieldBaseSlot < 0:
                return -1
            let fixedFieldAddrBaseSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                                          slotNames,
                                                                          lineNumber,
                                                                          fixedFieldBaseSlot,
                                                                          fieldOffsetBytes)
            if fixedFieldAddrBaseSlot < 0:
                return -1
            var emptyFixedFieldVarI32ParamNames: str[]
            emptyFixedFieldVarI32ParamNames = []
            let fixedFieldIndexSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                          slotNames,
                                                                          emptyFixedFieldVarI32ParamNames,
                                                                          typedIr,
                                                                          sourcePath,
                                                                          fieldIdxText,
                                                                          coreir.LocalI32Tag, callOrdinal)
            if fixedFieldIndexSlot < 0:
                return -1
            let fixedFieldStrideSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                       slotNames,
                                                                       strutil.Join([share(fieldIdxRoot), "#cond_field_esz#", strings.IntToStr(nextOpIndex)], ""),
                                                                       coreir.LocalI64Tag,
                                                                       fixedFieldShapeSize)
            if fixedFieldStrideSlot < 0:
                return -1
            let fixedFieldAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                   slotNames,
                                                                   strutil.Join([share(fieldIdxRoot), "#cond_field_addr#", strings.IntToStr(nextOpIndex)], ""),
                                                                   coreir.LocalPtrTag)
            if fixedFieldAddrSlot < 0:
                return -1
            var fixedFieldAddrOp: coreir.BodyOp
            fixedFieldAddrOp.kind = coreir.BodyOpBinOpTag
            fixedFieldAddrOp.target = fixedFieldAddrSlot
            add(fixedFieldAddrOp.operands, coreir.LocalI64Tag)
            add(fixedFieldAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
            add(fixedFieldAddrOp.operands, fixedFieldIndexSlot)
            add(fixedFieldAddrOp.operands, fixedFieldStrideSlot)
            add(fixedFieldAddrOp.operands, fixedFieldAddrBaseSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, fixedFieldAddrOp)
            var fixedFieldValueKind = elemKind
            if elemSize == 1:
                fixedFieldValueKind = coreir.LocalI32Tag
            let fixedFieldValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                    slotNames,
                                                                    text,
                                                                    fixedFieldValueKind)
            if fixedFieldValueSlot < 0:
                return -1
            var fixedFieldLoadOp: coreir.BodyOp
            fixedFieldLoadOp.kind = coreir.BodyOpFieldLoadTag
            fixedFieldLoadOp.target = fixedFieldValueSlot
            add(fixedFieldLoadOp.operands, fixedFieldAddrSlot)
            add(fixedFieldLoadOp.operands, fixedFieldValueSlot)
            add(fixedFieldLoadOp.operands, 0)
            add(fixedFieldLoadOp.operands, elemSize)
            let _ = coreir.BodyIRAppendOp(bodyIR, fixedFieldLoadOp)
            nextOpIndex = nextOpIndex + 2
            return fixedFieldValueSlot
        let seqSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                         slotNames,
                                                         typedIr,
                                                         sourcePath,
                                                         strutil.Join([share(fieldIdxRoot),
                                                                       "#condition_seq#",
                                                                       strings.IntToStr(nextOpIndex)], ""),
                                                         fieldType)
        if seqSlot < 0 ||
           fieldOffsetBytes < 0 ||
           fieldSizeBytes <= 0 ||
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[seqSlot]) < fieldSizeBytes:
            return -1
        if !PrimaryBodyIrAppendFieldLoadToSlot(bodyIR,
                                               slotNames,
                                               typedIr,
                                               sourcePath,
                                               rootName,
                                               rootType,
                                               fieldOffsetBytes,
                                               fieldSizeBytes,
                                               seqSlot):
            return -1
        var emptyVarI32ParamNames: str[]
        emptyVarI32ParamNames = []
        let indexSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                           slotNames,
                                                           emptyVarI32ParamNames,
                                                           typedIr,
                                                           sourcePath,
                                                           fieldIdxText,
                                                           coreir.LocalI32Tag, callOrdinal)
        if indexSlot < 0:
            return -1
        var valueKind = elemKind
        if elemSize == 1:
            valueKind = coreir.LocalI32Tag
        let valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                      slotNames,
                                                      text,
                                                      valueKind)
        if valueSlot < 0:
            return -1
        var indexOp: coreir.BodyOp
        indexOp.kind = coreir.BodyOpIndexedLoadTag
        indexOp.target = valueSlot
        add(indexOp.operands, seqSlot)
        add(indexOp.operands, valueSlot)
        add(indexOp.operands, indexSlot)
        add(indexOp.operands, elemSize)
        if fieldIsDynamicSeq:
            add(indexOp.operands, 1)
        let _ = coreir.BodyIRAppendOp(bodyIR, indexOp)
        nextOpIndex = nextOpIndex + 2
        return valueSlot
    let arrowCondSlot = PrimaryBodyIrPtrArrowFieldValueSlot(bodyIR,
                                                            slotNames,
                                                            typedIr,
                                                            typedFn,
                                                            irFunction,
                                                            sourcePath,
                                                            lineNumber,
                                                            text,
                                                            -1)
    if arrowCondSlot >= 0:
        nextOpIndex = nextOpIndex + 1
        return arrowCondSlot
    if !texpr.TypedExprTextIsSimpleFieldPath(text):
        return -1
    let rootName = texpr.TypedExprAssignLhsRootName(text)
    let fieldPath = texpr.TypedExprAssignFieldPath(text)
    var rootType = PrimaryBodyIrBindingTypeForName(typedIr,
                                                   typedFn,
                                                   irFunction,
                                                   lineNumber,
                                                   rootName)
    if texpr.TypedExprNormalizeTypeText(rootType) == "":
        # Condition-operand probes (arithmetic/BinOp decomposition inside
        # ContextScalarValueSlotForTextImpl) resolve through here with
        # lineNumber==0 — a sentinel, not a real source line — so the
        # line-scoped scan above always misses (every real declaration line
        # is >= 0). Same fallback already used for the multi-index condition
        # probe: a line-independent decl-type lookup still recovers the
        # binding unambiguously.
        rootType = texpr.TypedExprIrLookupLocalBindingTypeAnyLine(typedIr,
                                                                   sourcePath,
                                                                   typedFn.functionName,
                                                                   rootName)
    if rootName == "" ||
       fieldPath == "" ||
       rootType == "" ||
       rootType == "unknown" ||
       !PrimaryObjectMetadataTextStable(rootType):
        return -1
    var fieldType = ""
    var fieldOffsetBytes: int32
    var fieldSizeBytes: int32
    var fieldAlignBytes: int32
    # rootType may carry a `ref`-pointer wrapper (`refProbeObject` for `var out =
    # new(ProbeObject)`): the field-metadata tables are keyed by the plain owner
    # type name, so a ref-wrapped rootType makes both lookups below miss on a
    # dotted (2+-hop) fieldPath (single-hop reads are covered earlier by
    # PtrArrowFieldValueSlot and never reach here ref-wrapped). Strip it the same
    # way PrimaryBodyIrPointeeTypeText already does for every other pointer-owner
    # field lookup in this file; non-pointer owners (embedded/value structs) are
    # untouched since PointeeTypeText returns "" for them.
    var fieldOwnerType = share(rootType)
    let rootPointeeType = PrimaryBodyIrPointeeTypeText(rootType)
    if rootPointeeType != "":
        fieldOwnerType = rootPointeeType
    # form60: dotted paths must try FieldPathMeta first — SingleField used to
    # IdentPrefix-truncate "flags.len"→"flags" and return Aggregate for Cmp.
    var fieldMetaOk: bool
    if PrimaryBodyIrTextHasDot(fieldPath):
        fieldMetaOk = texpr.TypedExprIrLookupFieldPathMeta(typedIr,
                                                           sourcePath,
                                                           fieldOwnerType,
                                                           fieldPath,
                                                           fieldType,
                                                           fieldOffsetBytes,
                                                           fieldSizeBytes,
                                                           fieldAlignBytes)
        if !fieldMetaOk:
            fieldMetaOk = PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                                             sourcePath,
                                                             fieldOwnerType,
                                                             fieldPath,
                                                             fieldType,
                                                             fieldOffsetBytes,
                                                             fieldSizeBytes,
                                                             fieldAlignBytes)
    else:
        fieldMetaOk = PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                                         sourcePath,
                                                         fieldOwnerType,
                                                         fieldPath,
                                                         fieldType,
                                                         fieldOffsetBytes,
                                                         fieldSizeBytes,
                                                         fieldAlignBytes)
    if !fieldMetaOk:
        return -1
    var fieldKind: int32
    var fieldSize: int32
    var fieldAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   fieldType,
                                   fieldKind,
                                   fieldSize,
                                   fieldAlign)
    if fieldKind == coreir.LocalInvalidTag ||
       fieldSize <= 0 ||
       fieldAlign <= 0:
        return -1
    # form60: relational Cmp must not consume Aggregate (stack address as i32).
    if fieldKind == coreir.LocalAggregateTag || fieldKind == coreir.LocalStrTag:
        return -1
    # 槽绑定根修 (W2 R1): 条件字段操作数槽禁用裸表达式名。裸名槽会被函数内任意
    # 后续 FindArgSlot(text) 按名复用, 而本 FieldLoad 只支配当前条件区域; 跨条件
    # 区域的 use (如 dedup 循环后的 add(table.X, fact.X)) 读到的是从未支配它的
    # 陈旧栈槽 (I2 五列垃圾案, GEN2 体内 CompilerCsgSemanticAppendResolvedCallFact)。
    # 唯一名使每次出现各自物化: FieldLoad 无副作用, 重读即内存当前值, 语义不变。
    let valueSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                       slotNames,
                                                       Fmt"{text}#cfval#{bodyIR.ops.len}",
                                                       fieldKind,
                                                       fieldSize,
                                                       fieldAlign)
    if valueSlot < 0:
        return -1
    if !PrimaryBodyIrAppendFieldLoadToSlot(bodyIR,
                                           slotNames,
                                           typedIr,
                                           sourcePath,
                                           rootName,
                                           rootType,
                                           fieldOffsetBytes,
                                           fieldSizeBytes,
                                           valueSlot):
        # 槽绑定根修 (W2 R2): 失败臂必须注销刚注册的槽名。已注册而未发定义的槽
        # 一旦留存, 后续按名查找 (FindArgSlot/FindOrCreate) 会把它当已物化值复用
        # (孤儿槽, 读必为栈垃圾)。毒化名字使一切按名查找必失, 调用方走重物化或
        # 诚实 bail, 绝不静默落穿。
        slotNames[valueSlot] = Fmt"{text}#cfos_fail#{bodyIR.ops.len}"
        return -1
    nextOpIndex = nextOpIndex + 1
    return valueSlot

@borrows
fn PrimaryBodyIrArrowTextIsPlainName(text: str): bool =
    if len(text) <= 0:
        return false
    for i in 0..<len(text):
        let c = text[i]
        if c >= 'a' && c <= 'z':
            continue
        if c >= 'A' && c <= 'Z':
            continue
        if c >= '0' && c <= '9':
            continue
        if c == '_':
            continue
        return false
    return true

@borrows
fn PrimaryBodyIrPtrArrowFieldValueSlot(bodyIR: var coreir.BodyIR,
                                        slotNames: var str[],
                                        typedIr: texpr.TypedExprIr,
                                        typedFn: texpr.TypedExprIrFunction,
                                        irFunction: lower.PrimaryObjectIrFunction,
                                        sourcePath: str,
                                        lineNumber: int32,
                                        textRaw: str,
                                        typeKind: int32): int32 =
    # Pointer field value read: root->field. Emits a FieldLoad through the
    # pointer slot (x64 encoder handles Ptr-typed bases as indirect loads).
    let text = strutil.Strip(textRaw)
    if len(text) < 4:
        return -1
    var arrowPos: int32 = -1
    let arrowScanEnd = len(text) - 1
    for i in 0..<arrowScanEnd:
        if text[i] == '-' && text[i + 1] == '>':
            if arrowPos >= 0:
                return -1
            arrowPos = i
    if arrowPos <= 0:
        return -1
    let arrowRootName = strutil.Strip(strings.SliceBytes(text, 0, arrowPos))
    let arrowFieldName = strutil.Strip(strings.SliceBytes(text, arrowPos + 2, len(text) - arrowPos - 2))
    if !PrimaryBodyIrArrowTextIsPlainName(arrowRootName) ||
       !PrimaryBodyIrArrowTextIsPlainName(arrowFieldName):
        return -1
    let arrowRootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, arrowRootName)
    if arrowRootSlot < 0 || arrowRootSlot >= bodyIR.localSlots.len:
        return -1
    # root 既可以是裸 LocalPtrTag 槽, 也可以是 seq/str `T[]*` 形参的
    # LocalAggregateTag+param 槽 (ABI 上仍是持址寄存器, x64/arm64 FieldLoad
    # 编码器的 baseSlot 分支本就同时接纳这两种 — 见
    # PrimaryBodyIRFillFieldLoadOp 的 LocalPtrTag||(LocalAggregateTag&&IsParam)
    # 判据)。此处只认 LocalPtrTag 是过严的历史遗留, 把 T[]*/str[]* 形参的
    # `->field` 调用实参错误地判成"物化失败"→bail_44, 尽管编码器完全能发射。
    var arrowRootIsValidBase = false
    let arrowRootSlotType = PrimaryBodyIrSlotType(bodyIR, arrowRootSlot)
    if arrowRootSlotType == coreir.LocalPtrTag:
        arrowRootIsValidBase = true
    elif arrowRootSlotType == coreir.LocalAggregateTag &&
         PrimaryBodyIrLocalIsParam(bodyIR.localSlots[arrowRootSlot]):
        arrowRootIsValidBase = true
    if !arrowRootIsValidBase:
        return -1
    let arrowRootType = PrimaryBodyIrBindingTypeForName(typedIr,
                                                        typedFn,
                                                        irFunction,
                                                        lineNumber,
                                                        arrowRootName)
    if arrowRootType == "":
        return -1
    let arrowPointeeType = PrimaryBodyIrPointeeTypeTextForSource(typedIr,
                                                                 sourcePath,
                                                                 texpr.TypedExprStripVarType(arrowRootType))
    if arrowPointeeType == "":
        return -1
    var arrowFieldType = ""
    var arrowFieldOffsetBytes: int32
    var arrowFieldSizeBytes: int32
    var arrowFieldAlignBytes: int32
    if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                           sourcePath,
                                           arrowPointeeType,
                                           arrowFieldName,
                                           arrowFieldType,
                                           arrowFieldOffsetBytes,
                                           arrowFieldSizeBytes,
                                           arrowFieldAlignBytes):
        return -1
    if arrowFieldSizeBytes <= 0 || arrowFieldOffsetBytes < 0:
        return -1
    let arrowFieldKind = PrimaryBodyIrTypeKindFromText(texpr.TypedExprNormalizeTypeText(arrowFieldType))
    if arrowFieldKind != coreir.LocalI32Tag &&
       arrowFieldKind != coreir.LocalI64Tag &&
       arrowFieldKind != coreir.LocalPtrTag:
        return -1
    var arrowNeedsWiden = false
    if typeKind >= 0 && arrowFieldKind != typeKind:
        if typeKind == coreir.LocalI64Tag && arrowFieldKind == coreir.LocalI32Tag:
            arrowNeedsWiden = true
        else:
            return -1
    let arrowValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       text,
                                                       arrowFieldKind)
    if arrowValueSlot < 0:
        return -1
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[arrowValueSlot]) < arrowFieldSizeBytes:
        return -1
    var arrowLoadOp: coreir.BodyOp
    arrowLoadOp.kind = coreir.BodyOpFieldLoadTag
    arrowLoadOp.target = arrowValueSlot
    add(arrowLoadOp.operands, arrowRootSlot)
    add(arrowLoadOp.operands, arrowValueSlot)
    add(arrowLoadOp.operands, arrowFieldOffsetBytes)
    add(arrowLoadOp.operands, arrowFieldSizeBytes)
    let _ = coreir.BodyIRAppendOp(bodyIR, arrowLoadOp)
    if !arrowNeedsWiden:
        return arrowValueSlot
    let arrowWidenSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"i64({text})",
                                                       coreir.LocalI64Tag)
    if arrowWidenSlot < 0:
        return -1
    var arrowWidenOp: coreir.BodyOp
    arrowWidenOp.kind = coreir.BodyOpCopyLocalTag
    arrowWidenOp.target = arrowWidenSlot
    add(arrowWidenOp.operands, arrowValueSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, arrowWidenOp)
    return arrowWidenSlot

var primaryBodyIrContextScalarActiveSourcePaths: str[]
var primaryBodyIrContextScalarActiveFunctionNames: str[]
var primaryBodyIrContextScalarActiveLineNumbers: int32[]
var primaryBodyIrContextScalarActiveTexts: str[]
var primaryBodyIrContextScalarActiveTypeKinds: int32[]

fn PrimaryBodyIrContextScalarActivePush(sourcePath: str,
                                         functionName: str,
                                         lineNumber: int32,
                                         text: str,
                                         typeKind: int32) =
    add(primaryBodyIrContextScalarActiveSourcePaths, sourcePath)
    add(primaryBodyIrContextScalarActiveFunctionNames, functionName)
    add(primaryBodyIrContextScalarActiveLineNumbers, lineNumber)
    add(primaryBodyIrContextScalarActiveTexts, text)
    add(primaryBodyIrContextScalarActiveTypeKinds, typeKind)

fn PrimaryBodyIrContextScalarActivePop() =
    let depth = primaryBodyIrContextScalarActiveSourcePaths.len
    if depth > 0:
        let keep = depth - 1
        var nextSourcePaths: str[]
        var nextFunctionNames: str[]
        var nextLineNumbers: int32[]
        var nextTexts: str[]
        var nextTypeKinds: int32[]
        for i in 0..<depth:
            add(nextSourcePaths, strings.CloneStr(primaryBodyIrContextScalarActiveSourcePaths[i]))
            add(nextFunctionNames, strings.CloneStr(primaryBodyIrContextScalarActiveFunctionNames[i]))
            add(nextLineNumbers, primaryBodyIrContextScalarActiveLineNumbers[i])
            add(nextTexts, strings.CloneStr(primaryBodyIrContextScalarActiveTexts[i]))
            add(nextTypeKinds, primaryBodyIrContextScalarActiveTypeKinds[i])
        setLen(nextSourcePaths, keep)
        setLen(nextFunctionNames, keep)
        setLen(nextLineNumbers, keep)
        setLen(nextTexts, keep)
        setLen(nextTypeKinds, keep)
        primaryBodyIrContextScalarActiveSourcePaths = nextSourcePaths
        primaryBodyIrContextScalarActiveFunctionNames = nextFunctionNames
        primaryBodyIrContextScalarActiveLineNumbers = nextLineNumbers
        primaryBodyIrContextScalarActiveTexts = nextTexts
        primaryBodyIrContextScalarActiveTypeKinds = nextTypeKinds

@borrows
fn PrimaryBodyIrContextScalarValueSlotForText(bodyIR: var coreir.BodyIR,
                                               slotNames: var str[],
                                               varI32ParamNames: str[],
                                               typedIr: texpr.TypedExprIr,
                                               typedFn: texpr.TypedExprIrFunction,
                                               irFunction: lower.PrimaryObjectIrFunction,
                                               sourcePath: str,
                                               lineNumber: int32,
                                               textRaw: str,
                                               typeKind: int32): int32 =
    let typedFnName = typedFn.functionName
    let contextActiveText = strings.CloneStr(PrimaryBodyIrStripOuterParens(textRaw))
    for activeIndex in 0..<primaryBodyIrContextScalarActiveSourcePaths.len:
        if primaryBodyIrContextScalarActiveLineNumbers[activeIndex] == lineNumber &&
           primaryBodyIrContextScalarActiveTypeKinds[activeIndex] == typeKind &&
           primaryBodyIrContextScalarActiveFunctionNames[activeIndex] == typedFnName &&
           primaryBodyIrContextScalarActiveTexts[activeIndex] == contextActiveText &&
           PrimaryPathNormalizedEquals(primaryBodyIrContextScalarActiveSourcePaths[activeIndex],
                                       sourcePath):
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=recursion_cycle helper=context_scalar function=",
                                                       strings.CloneStr(typedFnName),
                                                       " line=",
                                                       strings.IntToStr(lineNumber),
                                                       " text=",
                                                       strings.CloneStr(textRaw)], ""))
            return -1
    PrimaryBodyIrContextScalarActivePush(strings.CloneStr(sourcePath),
                                         strings.CloneStr(typedFnName),
                                         lineNumber,
                                         contextActiveText,
                                         typeKind)
    let contextScalarResultSlot = PrimaryBodyIrContextScalarValueSlotForTextImpl(bodyIR,
                                                                                slotNames,
                                                                                varI32ParamNames,
                                                                                typedIr,
                                                                                typedFn,
                                                                                irFunction,
                                                                                sourcePath,
                                                                                lineNumber,
                                                                                textRaw,
                                                                                typeKind)
    PrimaryBodyIrContextScalarActivePop()
    return contextScalarResultSlot

@borrows
fn PrimaryBodyIrContextSeqIndexedScalarValueSlot(bodyIR: var coreir.BodyIR,
                                                 slotNames: var str[],
                                                 varI32ParamNames: str[],
                                                 typedIr: texpr.TypedExprIr,
                                                 typedFn: texpr.TypedExprIrFunction,
                                                 irFunction: lower.PrimaryObjectIrFunction,
                                                 sourcePath: str,
                                                 lineNumber: int32,
                                                 textRaw: str,
                                                 typeKind: int32,
                                                 callOrdinal: var int32): int32 =
    let text = PrimaryBodyIrStripOuterParens(textRaw)
    var rootName = ""
    var indexText = ""
    if !PrimaryBodyIrIndexExprParts(text, rootName, indexText):
        return -1
    if PrimaryBodyIrTextHasDot(rootName):
        return -1
    let rootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rootName)
    if rootSlot < 0 || rootSlot >= bodyIR.localSlots.len:
        return -1
    let rootKind = PrimaryBodyIrSlotType(bodyIR, rootSlot)
    if rootKind != coreir.LocalAggregateTag &&
       rootKind != coreir.LocalPtrTag:
        return -1
    let rootType = texpr.TypedExprStripVarType(PrimaryBodyIrBindingTypeForName(typedIr,
                                                                               typedFn,
                                                                               irFunction,
                                                                               lineNumber,
                                                                               rootName))
    if rootType == "":
        return -1
    var elemKind: int32
    var elemSize: int32
    if !PrimaryBodyIrSeqElementShapeFromText(typedIr,
                                             sourcePath,
                                             rootType,
                                             elemKind,
                                             elemSize):
        return -1
    let ctxSeqRootIsDynamicSeq = PrimaryBodyIrTypeTextIsDynamicSeq(rootType)
    # T78 v4: bare-root sibling of PrimaryBodyIrConditionFieldOperandSlot's
    # bareRootSlot fix — this context-scalar (non-condition operand, e.g.
    # `grid[i][j]` flatten / arithmetic BinOp operand) indexed-load resolver
    # shares the exact same FIXED-array elemSize divergence: a fixed bool[N]
    # array's inline element slots are laid out at TypeShapeFromText's
    # aligned register width (4B), not the 1B packed width
    # SeqElementShapeFromText hands back for a GROWABLE seq's heap buffer.
    # Dynamic seqs keep the packed width.
    if !ctxSeqRootIsDynamicSeq:
        let ctxSeqFixedElemTypeText = PrimaryBodyIrIndexedElementTypeText(rootType)
        if ctxSeqFixedElemTypeText != "":
            var ctxSeqFixedShapeKind: int32
            var ctxSeqFixedShapeSize: int32
            var ctxSeqFixedShapeAlign: int32
            PrimaryBodyIrTypeShapeFromText(typedIr,
                                           sourcePath,
                                           ctxSeqFixedElemTypeText,
                                           ctxSeqFixedShapeKind,
                                           ctxSeqFixedShapeSize,
                                           ctxSeqFixedShapeAlign)
            if ctxSeqFixedShapeSize > 0 && ctxSeqFixedShapeSize >= elemSize:
                elemSize = ctxSeqFixedShapeSize
    var valueKind = elemKind
    if elemSize == 1:
        valueKind = coreir.LocalI32Tag
    if valueKind != typeKind:
        return -1
    let indexSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               typedIr,
                                                               typedFn,
                                                               irFunction,
                                                               sourcePath,
                                                               lineNumber,
                                                               indexText,
                                                               coreir.LocalI32Tag)
    if indexSlot < 0:
        return -1
    let valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"{text}#ctx_seq_elem#{lineNumber}#{bodyIR.ops.len}",
                                                  valueKind)
    if valueSlot < 0:
        return -1
    var indexOp: coreir.BodyOp
    indexOp.kind = coreir.BodyOpIndexedLoadTag
    indexOp.target = valueSlot
    add(indexOp.operands, rootSlot)
    add(indexOp.operands, valueSlot)
    add(indexOp.operands, indexSlot)
    add(indexOp.operands, elemSize)
    if ctxSeqRootIsDynamicSeq:
        add(indexOp.operands, 1)
    let _ = coreir.BodyIRAppendOp(bodyIR, indexOp)
    return valueSlot

@borrows
fn PrimaryBodyIrContextResultValueFieldSlot(bodyIR: var coreir.BodyIR,
                                             slotNames: var str[],
                                             typedIr: texpr.TypedExprIr,
                                             typedFn: texpr.TypedExprIrFunction,
                                             irFunction: lower.PrimaryObjectIrFunction,
                                             sourcePath: str,
                                             lineNumber: int32,
                                             textRaw: str,
                                             typeKind: int32): int32 =
    let text = strutil.Strip(textRaw)
    if !parser.ParserStartsWith(text, "Value("):
        return -1
    let openPos = parser.ParserFindText(text, "(")
    if openPos <= 0:
        return -1
    let closePos = texpr.TypedExprFindMatchingParen(text, openPos)
    if closePos <= openPos || closePos + 2 >= len(text):
        return -1
    if text[closePos + 1] != '.':
        return -1
    let resultName = strutil.Strip(strings.SliceBytes(text, openPos + 1, closePos - openPos - 1))
    let fieldPath = strutil.Strip(strings.SliceBytes(text, closePos + 2, len(text) - closePos - 2))
    if resultName == "" || fieldPath == "":
        return -1
    if parser.ParserIdentPrefix(resultName) != resultName:
        return -1
    let resultSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, resultName)
    if resultSlot < 0 || resultSlot >= bodyIR.localSlots.len:
        return -1
    if PrimaryBodyIrSlotType(bodyIR, resultSlot) != coreir.LocalAggregateTag:
        return -1
    let resultType = texpr.TypedExprStripVarType(PrimaryBodyIrBindingTypeForName(typedIr,
                                                                                 typedFn,
                                                                                 irFunction,
                                                                                 lineNumber,
                                                                                 resultName))
    let innerType = texpr.TypedExprResultSuccessType(resultType)
    if innerType == "":
        return -1
    # innerType 可能是本地类型别名（`type X = module.Y`，如
    # QuicPacketHeaderVarIntDecoded = quic_varint.QuicVarIntDecoded）：别名声明
    # 自身零字段，字段元数据只在别名目标类型下可查。跟随
    # AppendAggregateConstructorToSlot（:25636）的同款别名穿透，取别名目标作为
    # 字段查询的宿主类型；非别名（target==""或与自身相同）时原样使用 innerType，
    # 行为不变。
    # Take would consume innerType before NormalizeTypeText / ResultConstructLayout.
    var innerFieldOwnerType = strings.CloneStr(innerType)
    let innerAliasTarget = texpr.TypedExprIrLookupTypeDefAliasTargetType(typedIr,
                                                                         sourcePath,
                                                                         texpr.TypedExprNormalizeTypeText(innerType))
    if innerAliasTarget != "" &&
       texpr.TypedExprNormalizeTypeText(innerAliasTarget) != texpr.TypedExprNormalizeTypeText(innerType):
        innerFieldOwnerType = innerAliasTarget
    var valueKind: int32
    var valueSize: int32
    var valueOffset: int32
    var errCodeOffset: int32
    var errMsgOffset: int32
    var totalSize: int32
    if !PrimaryBodyIrResultConstructLayout(typedIr,
                                           sourcePath,
                                           innerType,
                                           valueKind,
                                           valueSize,
                                           valueOffset,
                                           errCodeOffset,
                                           errMsgOffset,
                                           totalSize):
        return -1
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[resultSlot]) < valueOffset + valueSize:
        return -1
    var fieldType = ""
    var fieldOffsetBytes: int32
    var fieldSizeBytes: int32
    var fieldAlignBytes: int32
    var fieldMetaOk = false
    # formal=8 is var out; do not alias borrowed sourcePath into the var actual.
    var fieldSourcePath = strings.CloneStr(sourcePath)
    if !PrimaryBodyIrTextHasDot(fieldPath):
        fieldMetaOk = PrimaryBodyIrLookupChainFieldMeta(typedIr,
                                                        sourcePath,
                                                        innerFieldOwnerType,
                                                        fieldPath,
                                                        fieldType,
                                                        fieldOffsetBytes,
                                                        fieldSizeBytes,
                                                        fieldAlignBytes,
                                                        fieldSourcePath)
    else:
        fieldMetaOk = texpr.TypedExprIrLookupFieldPathMeta(typedIr,
                                                           sourcePath,
                                                           innerFieldOwnerType,
                                                           fieldPath,
                                                           fieldType,
                                                           fieldOffsetBytes,
                                                           fieldSizeBytes,
                                                           fieldAlignBytes)
    if !fieldMetaOk || fieldSizeBytes <= 0:
        return -1
    var fieldKind: int32
    var fieldShapeSize: int32
    var fieldShapeAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   fieldSourcePath,
                                   fieldType,
                                   fieldKind,
                                   fieldShapeSize,
                                   fieldShapeAlign)
    if fieldKind != typeKind:
        return -1
    if fieldOffsetBytes < 0 || fieldOffsetBytes + fieldSizeBytes > valueSize:
        return -1
    let valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                       slotNames,
                                                       typedIr,
                                                       fieldSourcePath,
                                                       Fmt"{text}#result_value_field",
                                                       fieldType)
    if valueSlot < 0:
        return -1
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < fieldSizeBytes:
        return -1
    var loadOp: coreir.BodyOp
    loadOp.kind = coreir.BodyOpFieldLoadTag
    loadOp.target = valueSlot
    add(loadOp.operands, resultSlot)
    add(loadOp.operands, valueSlot)
    add(loadOp.operands, valueOffset + fieldOffsetBytes)
    add(loadOp.operands, fieldSizeBytes)
    let _ = coreir.BodyIRAppendOp(bodyIR, loadOp)
    return valueSlot

@borrows
fn PrimaryBodyIrContextScalarValueSlotForTextImpl(bodyIR: var coreir.BodyIR,
                                               slotNames: var str[],
                                               varI32ParamNames: str[],
                                               typedIr: texpr.TypedExprIr,
                                               typedFn: texpr.TypedExprIrFunction,
                                               irFunction: lower.PrimaryObjectIrFunction,
                                               sourcePath: str,
                                               lineNumber: int32,
                                               textRaw: str,
                                               typeKind: int32): int32 =
    let text = PrimaryBodyIrStripOuterParens(textRaw)
    if text == "":
        return -1
    # 上下文标量值解析不参与外层调用序列：ordinal=-1 禁用调用物化（仿 ConditionFieldOperandSlot）
    var callOrdinal: int32 = -1
    var targetTypeTextForCast = ""
    if typeKind == coreir.LocalI32Tag:
        targetTypeTextForCast = "int32"
    elif typeKind == coreir.LocalI64Tag:
        targetTypeTextForCast = "int64"
    elif typeKind == coreir.LocalPtrTag:
        targetTypeTextForCast = "ptr"
    elif typeKind == coreir.LocalF64Tag:
        targetTypeTextForCast = "float64"
    if targetTypeTextForCast != "":
        let castInner = PrimaryBodyIrTypeCastInnerForTarget(text, targetTypeTextForCast)
        if castInner != "":
            return PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                             slotNames,
                                                             varI32ParamNames,
                                                             typedIr,
                                                             share(typedFn),
                                                             share(irFunction),
                                                             sourcePath,
                                                             lineNumber,
                                                             castInner,
                                                             typeKind)
    if typeKind == coreir.LocalI64Tag:
        let uint64CastInner = PrimaryBodyIrTypeCastInnerForTarget(text, "uint64")
        if uint64CastInner != "":
            return PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                             slotNames,
                                                             varI32ParamNames,
                                                             typedIr,
                                                             share(typedFn),
                                                             share(irFunction),
                                                             sourcePath,
                                                             lineNumber,
                                                             uint64CastInner,
                                                             typeKind)
        let u64CastInner = PrimaryBodyIrTypeCastInnerForTarget(text, "u64")
        if u64CastInner != "":
            return PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                             slotNames,
                                                             varI32ParamNames,
                                                             typedIr,
                                                             share(typedFn),
                                                             share(irFunction),
                                                             sourcePath,
                                                             lineNumber,
                                                             u64CastInner,
                                                             typeKind)
    let resultValueFieldSlot = PrimaryBodyIrContextResultValueFieldSlot(bodyIR,
                                                                        slotNames,
                                                                        typedIr,
                                                                        typedFn,
                                                                        irFunction,
                                                                        sourcePath,
                                                                        lineNumber,
                                                                        text,
                                                                        typeKind)
    if resultValueFieldSlot >= 0:
        return resultValueFieldSlot
    let arrowFieldValueSlot = PrimaryBodyIrPtrArrowFieldValueSlot(bodyIR,
                                                                  slotNames,
                                                                  typedIr,
                                                                  typedFn,
                                                                  irFunction,
                                                                  sourcePath,
                                                                  lineNumber,
                                                                  text,
                                                                  typeKind)
    if arrowFieldValueSlot >= 0:
        return arrowFieldValueSlot
    if typeKind == coreir.LocalI32Tag:
        let lenInner = PrimaryBodyIrLenCallInner(text)
        if lenInner != "":
            let lenSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                        slotNames,
                                                        text,
                                                        coreir.LocalI32Tag)
            if lenSlot >= 0 &&
               PrimaryBodyIrAppendStrLenArgValue(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 typedIr,
                                                 typedFn,
                                                 irFunction,
                                                 sourcePath,
                                                 lineNumber,
                                                 lenInner,
                                                 lenSlot):
                return lenSlot
        if len(text) >= 5 &&
           strings.SliceBytes(text, len(text) - 4, 4) == ".len":
            let seqLenSlot = PrimaryBodyIrSeqLenValueSlot(bodyIR,
                                                          slotNames,
                                                          typedIr,
                                                          typedFn,
                                                          irFunction,
                                                          sourcePath,
                                                          lineNumber,
                                                          text)
            if seqLenSlot >= 0 &&
               seqLenSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, seqLenSlot) == coreir.LocalI32Tag:
                return seqLenSlot
    # Multi-dimensional fixed-array read `grid[i][j]`: row-major flatten to a
    # single-index text `grid[(i)*cols+(j)]` and re-enter so the existing 1-D
    # aggregate indexed-load path handles it. The binding type supplies the
    # column strides; without this the multi-bracket text degraded to an
    # uninitialized phantom slot (stack garbage read).
    if (typeKind == coreir.LocalI32Tag ||
        typeKind == coreir.LocalI64Tag ||
        typeKind == coreir.LocalPtrTag) &&
       !PrimaryBodyIrTextHasCallSurface(text):
        var ctxMultiRoot = ""
        var ctxMultiList: str[]
        ctxMultiList = []
        if PrimaryBodyIrMultiIndexParts(text, ctxMultiRoot, ctxMultiList) >= 2:
            var ctxMultiType = PrimaryBodyIrBindingTypeForName(typedIr,
                                                               typedFn,
                                                               irFunction,
                                                               lineNumber,
                                                               ctxMultiRoot)
            if texpr.TypedExprNormalizeTypeText(ctxMultiType) == "":
                # Condition probes resolve operands with line 0; fall back to a
                # line-independent (unambiguous) decl-type lookup so the fixed
                # 2-D shape is still recovered.
                ctxMultiType = texpr.TypedExprIrLookupLocalBindingTypeAnyLine(typedIr,
                                                                              sourcePath,
                                                                              typedFn.functionName,
                                                                              ctxMultiRoot)
            var ctxFlatText = ""
            if ctxMultiType != "" &&
               PrimaryBodyIrFlattenMultiIndexText(typedIr,
                                                  sourcePath,
                                                  ctxMultiType,
                                                  text,
                                                  ctxFlatText):
                return PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 typedIr,
                                                                 share(typedFn),
                                                                 share(irFunction),
                                                                 sourcePath,
                                                                 lineNumber,
                                                                 ctxFlatText,
                                                                 typeKind)
        let ctxSeqIndexedSlot = PrimaryBodyIrContextSeqIndexedScalarValueSlot(bodyIR,
                                                                              slotNames,
                                                                              varI32ParamNames,
                                                                              typedIr,
                                                                              typedFn,
                                                                              irFunction,
                                                                              sourcePath,
                                                                              lineNumber,
                                                                              text,
                                                                              typeKind,
                                                                              callOrdinal)
        if ctxSeqIndexedSlot >= 0:
            return ctxSeqIndexedSlot
    if typeKind == coreir.LocalI32Tag:
        var ctxIdxRoot = ""
        var ctxIdxText = ""
        if PrimaryBodyIrIndexExprParts(text, ctxIdxRoot, ctxIdxText) &&
           PrimaryBodyIrTextHasDot(ctxIdxRoot):
            # Fixed uint8[N] array field byte read: root.field[idx].
            let ctxFieldRootName = texpr.TypedExprAssignLhsRootName(ctxIdxRoot)
            let ctxFieldPath = texpr.TypedExprAssignFieldPath(ctxIdxRoot)
            let ctxRootType = PrimaryBodyIrBindingTypeForName(typedIr,
                                                              typedFn,
                                                              irFunction,
                                                              lineNumber,
                                                              ctxFieldRootName)
            var ctxFieldType = ""
            var ctxFieldOffsetBytes: int32
            var ctxFieldSizeBytes: int32
            var ctxFieldAlignBytes: int32
            if ctxFieldRootName != "" &&
               ctxFieldPath != "" &&
               ctxRootType != "" &&
               PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                                  sourcePath,
                                                  ctxRootType,
                                                  ctxFieldPath,
                                                  ctxFieldType,
                                                  ctxFieldOffsetBytes,
                                                  ctxFieldSizeBytes,
                                                  ctxFieldAlignBytes) &&
               PrimaryStartsWith(texpr.TypedExprNormalizeTypeText(ctxFieldType), "uint8["):
                let ctxBaseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                                         slotNames,
                                                                         typedIr,
                                                                         sourcePath,
                                                                         ctxFieldRootName,
                                                                         ctxRootType)
                var ctxIdxSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                            slotNames,
                                                                            varI32ParamNames,
                                                                            typedIr,
                                                                            share(typedFn),
                                                                            share(irFunction),
                                                                            sourcePath,
                                                                            lineNumber,
                                                                            ctxIdxText,
                                                                            coreir.LocalI32Tag)
                if ctxIdxSlot >= 0 && ctxFieldOffsetBytes > 0:
                    let ctxOffSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                     slotNames,
                                                                     Fmt"#ctx_u8_off#{bodyIR.ops.len}",
                                                                     coreir.LocalI32Tag,
                                                                     ctxFieldOffsetBytes)
                    let ctxAdjSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                   slotNames,
                                                                   Fmt"#ctx_u8_adj#{bodyIR.ops.len}",
                                                                   coreir.LocalI32Tag)
                    if ctxOffSlot < 0 || ctxAdjSlot < 0:
                        ctxIdxSlot = -1
                    else:
                        var ctxAddOp: coreir.BodyOp
                        ctxAddOp.kind = coreir.BodyOpBinOpTag
                        ctxAddOp.target = ctxAdjSlot
                        add(ctxAddOp.operands, coreir.LocalI32Tag)
                        add(ctxAddOp.operands, int32(texpr.TypedExprIrOpI32Add))
                        add(ctxAddOp.operands, ctxIdxSlot)
                        add(ctxAddOp.operands, ctxOffSlot)
                        let _ = coreir.BodyIRAppendOp(bodyIR, ctxAddOp)
                        ctxIdxSlot = ctxAdjSlot
                if ctxBaseSlot >= 0 && ctxIdxSlot >= 0:
                    let ctxU8ValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                       slotNames,
                                                                       text,
                                                                       coreir.LocalI32Tag)
                    if ctxU8ValueSlot >= 0:
                        var ctxLoadOp: coreir.BodyOp
                        ctxLoadOp.kind = coreir.BodyOpIndexedLoadTag
                        ctxLoadOp.target = ctxU8ValueSlot
                        add(ctxLoadOp.operands, ctxBaseSlot)
                        add(ctxLoadOp.operands, ctxU8ValueSlot)
                        add(ctxLoadOp.operands, ctxIdxSlot)
                        add(ctxLoadOp.operands, 1)
                        let _ = coreir.BodyIRAppendOp(bodyIR, ctxLoadOp)
                        return ctxU8ValueSlot
    # Fixed-array element field read `xs[i].field`: compute the real element
    # address (base + idx*stride) and FieldLoad the field. Without this the
    # index is dropped and a stale/uninitialized slot is read. The index is
    # resolved through the (call-free) scalar path; a call-bearing index is not
    # handled here and is left to the general path.
    if (typeKind == coreir.LocalI32Tag ||
        typeKind == coreir.LocalI64Tag ||
        typeKind == coreir.LocalPtrTag) &&
       !PrimaryBodyIrTextHasCallSurface(text):
        var faeReadOrdinal = 0
        let faeReadSlot = PrimaryBodyIrFixedArrayIndexedFieldValueSlot(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       typedIr,
                                                                       typedFn,
                                                                       irFunction,
                                                                       sourcePath,
                                                                       lineNumber,
                                                                       text,
                                                                       faeReadOrdinal)
        if faeReadSlot >= 0:
            let faeReadKind = PrimaryBodyIrSlotType(bodyIR, faeReadSlot)
            if faeReadKind == typeKind:
                return faeReadSlot
        # `root.arrayField[idx].subField` read (array of structs as a struct
        # field): the bare-root handler rejects a dotted root, so without this
        # the read collapses to a static field offset and reads the wrong cell.
        var faisReadOrdinal = 0
        let faisReadSlot = PrimaryBodyIrFieldArrayIndexedSubFieldValueSlot(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           typedIr,
                                                                           typedFn,
                                                                           irFunction,
                                                                           sourcePath,
                                                                           lineNumber,
                                                                           text,
                                                                           faisReadOrdinal)
        if faisReadSlot >= 0:
            let faisReadKind = PrimaryBodyIrSlotType(bodyIR, faisReadSlot)
            if faisReadKind == typeKind:
                return faisReadSlot
    var fieldNextOpIndex: int32
    fieldNextOpIndex = bodyIR.ops.len
    let fieldSlot = PrimaryBodyIrConditionFieldOperandSlot(bodyIR,
                                                           slotNames,
                                                           typedIr,
                                                           typedFn,
                                                           irFunction,
                                                           sourcePath,
                                                           lineNumber,
                                                           text,
                                                           fieldNextOpIndex)
    if fieldSlot >= 0:
        let fieldSlotType = PrimaryBodyIrSlotType(bodyIR, fieldSlot)
        if fieldSlotType == typeKind:
            return fieldSlot
        if typeKind == coreir.LocalI64Tag &&
           fieldSlotType == coreir.LocalI32Tag:
            let widenedSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                            slotNames,
                                                            Fmt"i64({text})",
                                                            coreir.LocalI64Tag)
            if widenedSlot < 0:
                return -1
            var widenOp: coreir.BodyOp
            widenOp.kind = coreir.BodyOpCopyLocalTag
            widenOp.target = widenedSlot
            add(widenOp.operands, fieldSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, widenOp)
            return widenedSlot
        if typeKind == coreir.LocalI32Tag &&
           fieldSlotType == coreir.LocalI64Tag:
            let narrowSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"i32({text})",
                                                           coreir.LocalI32Tag)
            if narrowSlot < 0:
                return -1
            var narrowOp: coreir.BodyOp
            narrowOp.kind = coreir.BodyOpCopyLocalTag
            narrowOp.target = narrowSlot
            add(narrowOp.operands, fieldSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, narrowOp)
            return narrowSlot
    if typeKind == coreir.LocalI32Tag || typeKind == coreir.LocalI64Tag:
        var binPos: int32 = -1
        var binKind: int32
        let bitOrPos = texpr.TypedExprFindTopLevelBitwiseTextToken(text, "|")
        let bitXorPos = texpr.TypedExprFindTopLevelBitwiseTextToken(text, "^")
        let bitAndPos = texpr.TypedExprFindTopLevelBitwiseTextToken(text, "&")
        let addPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '+')
        let subPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '-')
        let mulPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '*')
        let divPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '/')
        let modPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '%')
        let shrPos = texpr.TypedExprFindTopLevelTextToken(text, ">>")
        let shlPos = texpr.TypedExprFindTopLevelTextToken(text, "<<")
        var binOpLen: int32
        binOpLen = 1
        if bitOrPos > 0:
            binPos = bitOrPos
            binKind = int32(texpr.TypedExprIrOpI32BitOr)
        elif bitXorPos > 0:
            binPos = bitXorPos
            binKind = int32(texpr.TypedExprIrOpI32BitXor)
        elif bitAndPos > 0:
            binPos = bitAndPos
            binKind = int32(texpr.TypedExprIrOpI32BitAnd)
        elif addPos > 0 || subPos > 0:
            # additive class is left-associative: split at the rightmost +/-
            if addPos > subPos:
                binPos = addPos
                binKind = int32(texpr.TypedExprIrOpI32Add)
            else:
                binPos = subPos
                binKind = int32(texpr.TypedExprIrOpI32Sub)
        elif mulPos > 0 || divPos > 0 || modPos > 0:
            # multiplicative class is left-associative: rightmost of *,/,%
            binPos = mulPos
            binKind = int32(texpr.TypedExprIrOpI32Mul)
            if divPos > binPos:
                binPos = divPos
                binKind = int32(texpr.TypedExprIrOpI32Sdiv)
            if modPos > binPos:
                binPos = modPos
                binKind = -100
        elif shrPos > 0:
            binPos = shrPos
            binKind = int32(texpr.TypedExprIrOpI32Asr)
            binOpLen = 2
        elif shlPos > 0:
            binPos = shlPos
            binKind = int32(texpr.TypedExprIrOpI32Lsl)
            binOpLen = 2
        if binPos > 0 && binPos + binOpLen < len(text):
            let lhsText = strutil.Strip(strings.SliceBytes(text, 0, binPos))
            if binKind == int32(texpr.TypedExprIrOpI32Asr):
                binKind = PrimaryBodyIrShiftRightOpKind(typedIr, typedFn, irFunction, lineNumber, lhsText)
            let rhsText = strutil.Strip(strings.SliceBytes(text,
                                                           binPos + binOpLen,
                                                           len(text) - binPos - binOpLen))
            let lhsSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     typedIr,
                                                                     share(typedFn),
                                                                     share(irFunction),
                                                                     sourcePath,
                                                                     lineNumber,
                                                                     lhsText,
                                                                     typeKind)
            let rhsSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     typedIr,
                                                                     typedFn,
                                                                     irFunction,
                                                                     sourcePath,
                                                                     lineNumber,
                                                                     rhsText,
                                                                     typeKind)
            if lhsSlot < 0 || rhsSlot < 0:
                return -1
            let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, text, typeKind)
            if slotId < 0:
                return -1
            if binKind == -100:
                return PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                           slotNames,
                                                           varI32ParamNames,
                                                           typedIr,
                                                           sourcePath,
                                                           text,
                                                           typeKind, callOrdinal)
            var binOp: coreir.BodyOp
            binOp.kind = coreir.BodyOpBinOpTag
            binOp.target = slotId
            add(binOp.operands, typeKind)
            add(binOp.operands, binKind)
            add(binOp.operands, lhsSlot)
            add(binOp.operands, rhsSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, binOp)
            return slotId
    return PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               typedIr,
                                               sourcePath,
                                               text,
                                               typeKind, callOrdinal)

# Call-aware scalar materializer: whole-call subexpressions append real call
# ops, and binop operands recurse so call results can feed arithmetic
# (e.g. `f(x) + 1`). Everything else defers to the context scalar path.
var primaryBodyIrCallScalarActiveSourcePaths: str[]
var primaryBodyIrCallScalarActiveFunctionNames: str[]
var primaryBodyIrCallScalarActiveLineNumbers: int32[]
var primaryBodyIrCallScalarActiveTexts: str[]
var primaryBodyIrCallScalarActiveTypeKinds: int32[]

fn PrimaryBodyIrCallScalarActivePush(sourcePath: str,
                                      functionName: str,
                                      lineNumber: int32,
                                      text: str,
                                      typeKind: int32) =
    add(primaryBodyIrCallScalarActiveSourcePaths, sourcePath)
    add(primaryBodyIrCallScalarActiveFunctionNames, functionName)
    add(primaryBodyIrCallScalarActiveLineNumbers, lineNumber)
    add(primaryBodyIrCallScalarActiveTexts, text)
    add(primaryBodyIrCallScalarActiveTypeKinds, typeKind)

fn PrimaryBodyIrCallScalarActivePop() =
    let depth = primaryBodyIrCallScalarActiveSourcePaths.len
    if depth > 0:
        let keep = depth - 1
        var nextSourcePaths: str[]
        var nextFunctionNames: str[]
        var nextLineNumbers: int32[]
        var nextTexts: str[]
        var nextTypeKinds: int32[]
        for i in 0..<keep:
            add(nextSourcePaths, strings.CloneStr(primaryBodyIrCallScalarActiveSourcePaths[i]))
            add(nextFunctionNames, strings.CloneStr(primaryBodyIrCallScalarActiveFunctionNames[i]))
            add(nextLineNumbers, primaryBodyIrCallScalarActiveLineNumbers[i])
            add(nextTexts, strings.CloneStr(primaryBodyIrCallScalarActiveTexts[i]))
            add(nextTypeKinds, primaryBodyIrCallScalarActiveTypeKinds[i])
        primaryBodyIrCallScalarActiveSourcePaths = nextSourcePaths
        primaryBodyIrCallScalarActiveFunctionNames = nextFunctionNames
        primaryBodyIrCallScalarActiveLineNumbers = nextLineNumbers
        primaryBodyIrCallScalarActiveTexts = nextTexts
        primaryBodyIrCallScalarActiveTypeKinds = nextTypeKinds

@borrows
fn PrimaryBodyIrCallScalarValueSlotForText(bodyIR: var coreir.BodyIR,
                                            slotNames: var str[],
                                            varI32ParamNames: str[],
                                            lowering: var lower.LoweringPlanStub,
                                            typedFn: texpr.TypedExprIrFunction,
                                            irFunction: lower.PrimaryObjectIrFunction,
                                            sourcePath: str,
                                            lineNumber: int32,
                                            textRaw: str,
                                            typeKind: int32,
                                            callOrdinal: var int32): int32 =
    let typedFnName = typedFn.functionName
    let callActiveText = strings.CloneStr(PrimaryBodyIrStripOuterParens(textRaw))
    for activeIndex in 0..<primaryBodyIrCallScalarActiveSourcePaths.len:
        if primaryBodyIrCallScalarActiveLineNumbers[activeIndex] == lineNumber &&
           primaryBodyIrCallScalarActiveTypeKinds[activeIndex] == typeKind &&
           primaryBodyIrCallScalarActiveFunctionNames[activeIndex] == typedFnName &&
           primaryBodyIrCallScalarActiveTexts[activeIndex] == callActiveText &&
           PrimaryPathNormalizedEquals(primaryBodyIrCallScalarActiveSourcePaths[activeIndex],
                                       sourcePath):
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=recursion_cycle helper=call_scalar function=",
                                                       strings.CloneStr(typedFnName),
                                                       " line=",
                                                       strings.IntToStr(lineNumber),
                                                       " text=",
                                                       strings.CloneStr(textRaw)], ""))
            return -1
    PrimaryBodyIrCallScalarActivePush(strings.CloneStr(sourcePath),
                                      strings.CloneStr(typedFnName),
                                      lineNumber,
                                      callActiveText,
                                      typeKind)
    let callScalarResultSlot = PrimaryBodyIrCallScalarValueSlotForTextImpl(bodyIR,
                                                                          slotNames,
                                                                          varI32ParamNames,
                                                                          lowering,

                                                                          typedFn,
                                                                          irFunction,
                                                                          sourcePath,
                                                                          lineNumber,
                                                                          textRaw,
                                                                          typeKind,
                                                                          callOrdinal)
    PrimaryBodyIrCallScalarActivePop()
    return callScalarResultSlot

@borrows
fn PrimaryBodyIrCallScalarValueSlotForTextImpl(bodyIR: var coreir.BodyIR,
                                            slotNames: var str[],
                                            varI32ParamNames: str[],
                                            lowering: var lower.LoweringPlanStub,
                                            typedFn: texpr.TypedExprIrFunction,
                                            irFunction: lower.PrimaryObjectIrFunction,
                                            sourcePath: str,
                                            lineNumber: int32,
                                            textRaw: str,
                                            typeKind: int32,
                                            callOrdinal: var int32): int32 =
    let typedFnName = typedFn.functionName
    let text = PrimaryBodyIrStripOuterParens(textRaw)
    if text == "":
        return -1
    let contextSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 lowering.typedIr,
                                                                 typedFn,
                                                                 irFunction,
                                                                 sourcePath,
                                                                 lineNumber,
                                                                 text,
                                                                 typeKind)
    if contextSlot >= 0:
        return contextSlot
    # `int(seqBase.len)` cast arg (bail_803 root): pureCast 臂重解析 inner text 为
    # 标量槽,但 cast-arg 路径从不到 PrimaryBodyIrSeqLenValueSlot(只语句级臂到)。
    # 镜像 call-arg SeqLen 兜底:`<seq>.len` 文本以 i32 请求时即 i32 len 槽,直接物化。
    if typeKind == coreir.LocalI32Tag &&
       len(text) >= 5 &&
       strings.SliceBytes(text, len(text) - 4, 4) == ".len":
        let castLenSlot = PrimaryBodyIrSeqLenValueSlot(bodyIR,
                                                       slotNames,
                                                       lowering.typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       sourcePath,
                                                       lineNumber,
                                                       text)
        if castLenSlot >= 0 &&
           castLenSlot < bodyIR.localSlots.len &&
           PrimaryBodyIrSlotType(bodyIR, castLenSlot) == coreir.LocalI32Tag:
            return castLenSlot
    if !PrimaryBodyIrTextHasCallSurface(text):
        return -1
    var targetTypeTextForCast = ""
    if typeKind == coreir.LocalI32Tag:
        targetTypeTextForCast = "int32"
    elif typeKind == coreir.LocalI64Tag:
        targetTypeTextForCast = "int64"
    elif typeKind == coreir.LocalPtrTag:
        targetTypeTextForCast = "ptr"
    if targetTypeTextForCast != "":
        let castInner = PrimaryBodyIrTypeCastInnerForTarget(text, targetTypeTextForCast)
        if castInner != "":
            return PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                           slotNames,
                                                           varI32ParamNames,
                                                           lowering,

                                                           typedFn,
                                                           irFunction,
                                                           sourcePath,
                                                           lineNumber,
                                                           castInner,
                                                           typeKind,
                                                           callOrdinal)
    let openPos = texpr.TypedExprFindWholeCallOpenParen(text)
    if openPos > 0:
        let closePos = texpr.TypedExprFindMatchingParen(text, openPos)
        if closePos > openPos && closePos + 1 == len(text):
            let callHead = strutil.Strip(strings.SliceBytes(text, 0, openPos))
            # new(T) 堆对象分配内征 (#76b 根修): 前面 R4/qualcall 等门控在此之前都
            # 已按 TargetFunctionIndex 精确排除 "new"(它不是真函数), 落到这条通用
            # 标量兜底臂时, callHead=="new" 必然会让下面的 FindOrCreateSlot 先按
            # 原文本名(如 "new(Sym)")建一个从未写入的孤儿槽, 再让
            # AppendWholeCallExprToSlot 内部符号解析失败返回 false——但孤儿槽已经
            # 留在 slotNames 里, 后续任何按同一文本名做 FindArgSlot 的独立兜底路径
            # (PrimaryBodyIrScalarValueSlotForTextImpl 的裸标识符臂等) 会把它当合法
            # 已初始化槽复用, 读到栈残留值——即 call-arg/binop/nested-call 等非顶层
            # 表达式位的静默 miscompile 根因(#76b)。在孤儿槽诞生前拦截:
            # new(...) 唯一正确的物化者本是两条已验证 realizer(AppendLocalDeclInitializer
            # 21481/AppendI32Assign 39179), 它们只认顶层 let/var 声明与顶层赋值 RHS。
            # #76c: 落到这里(它们不覆盖的嵌套表达式位, call-arg/嵌套调用/混合实参/
            # 双 new)不再诚实 miss——改为原地 hoist: 立即分配一个全新 ptr 槽, 调用
            # 与两条既有 realizer 完全相同的分配原语填好它, 把槽交回当前值请求。
            # 失败(类型不 concrete/分配失败)仍返回 -1, 不建孤儿槽, 行为不变。
            if callHead == "new":
                return PrimaryBodyIrHoistNewCallToPtrSlot(bodyIR,
                                                          slotNames,
                                                          lowering.typedIr,
                                                          sourcePath,
                                                          lineNumber,
                                                          text,
                                                          callOrdinal)
            if texpr.TypedExprCallHeadIsPlainQualifiedIdent(callHead):
                let callSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                             slotNames,
                                                             text,
                                                             typeKind)
                let panicMsg = Fmt"primary: scalar whole call lacks parser-owned TypedExpr node function={typedFnName} line={lineNumber}"
                panic(panicMsg)
    if typeKind != coreir.LocalI32Tag && typeKind != coreir.LocalI64Tag:
        return -1
    var binPos: int32 = -1
    var binKind: int32
    let bitOrPos = texpr.TypedExprFindTopLevelBitwiseTextToken(text, "|")
    let bitXorPos = texpr.TypedExprFindTopLevelBitwiseTextToken(text, "^")
    let bitAndPos = texpr.TypedExprFindTopLevelBitwiseTextToken(text, "&")
    let addPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '+')
    let subPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '-')
    let mulPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '*')
    let divPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '/')
    let modPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '%')
    let shrPos = texpr.TypedExprFindTopLevelTextToken(text, ">>")
    let shlPos = texpr.TypedExprFindTopLevelTextToken(text, "<<")
    var binOpLen: int32
    binOpLen = 1
    if bitOrPos > 0:
        binPos = bitOrPos
        binKind = int32(texpr.TypedExprIrOpI32BitOr)
    elif bitXorPos > 0:
        binPos = bitXorPos
        binKind = int32(texpr.TypedExprIrOpI32BitXor)
    elif bitAndPos > 0:
        binPos = bitAndPos
        binKind = int32(texpr.TypedExprIrOpI32BitAnd)
    elif addPos > 0 || subPos > 0:
        if addPos > subPos:
            binPos = addPos
            binKind = int32(texpr.TypedExprIrOpI32Add)
        else:
            binPos = subPos
            binKind = int32(texpr.TypedExprIrOpI32Sub)
    elif mulPos > 0 || divPos > 0 || modPos > 0:
        binPos = mulPos
        binKind = int32(texpr.TypedExprIrOpI32Mul)
        if divPos > binPos:
            binPos = divPos
            binKind = int32(texpr.TypedExprIrOpI32Sdiv)
        if modPos > binPos:
            binPos = modPos
            binKind = -100
    elif shrPos > 0:
        binPos = shrPos
        binKind = int32(texpr.TypedExprIrOpI32Asr)
        binOpLen = 2
    elif shlPos > 0:
        binPos = shlPos
        binKind = int32(texpr.TypedExprIrOpI32Lsl)
        binOpLen = 2
    if binPos <= 0 || binPos + binOpLen >= len(text):
        return -1
    let lhsText = strutil.Strip(strings.SliceBytes(text, 0, binPos))
    if binKind == int32(texpr.TypedExprIrOpI32Asr):
        binKind = PrimaryBodyIrShiftRightOpKind(lowering.typedIr, typedFn, irFunction, lineNumber, lhsText)
    let rhsText = strutil.Strip(strings.SliceBytes(text,
                                                   binPos + binOpLen,
                                                   len(text) - binPos - binOpLen))
    if lhsText == "" || rhsText == "":
        return -1
    let lhsSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          sourcePath,
                                                          lineNumber,
                                                          lhsText,
                                                          typeKind,
                                                          callOrdinal)
    let rhsSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          sourcePath,
                                                          lineNumber,
                                                          rhsText,
                                                          typeKind,
                                                          callOrdinal)
    if lhsSlot < 0 || rhsSlot < 0:
        return -1
    let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, text, typeKind)
    if slotId < 0:
        return -1
    if binKind == -100:
        let quotientSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                         slotNames,
                                                         Fmt"{text}#quotient",
                                                         typeKind)
        let productSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                        slotNames,
                                                        Fmt"{text}#product",
                                                        typeKind)
        if quotientSlot < 0 || productSlot < 0:
            return -1
        var divOp: coreir.BodyOp
        divOp.kind = coreir.BodyOpBinOpTag
        divOp.target = quotientSlot
        add(divOp.operands, typeKind)
        add(divOp.operands, int32(texpr.TypedExprIrOpI32Sdiv))
        add(divOp.operands, lhsSlot)
        add(divOp.operands, rhsSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, divOp)
        var mulOp: coreir.BodyOp
        mulOp.kind = coreir.BodyOpBinOpTag
        mulOp.target = productSlot
        add(mulOp.operands, typeKind)
        add(mulOp.operands, int32(texpr.TypedExprIrOpI32Mul))
        add(mulOp.operands, quotientSlot)
        add(mulOp.operands, rhsSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, mulOp)
        var remOp: coreir.BodyOp
        remOp.kind = coreir.BodyOpBinOpTag
        remOp.target = slotId
        add(remOp.operands, typeKind)
        add(remOp.operands, int32(texpr.TypedExprIrOpI32Sub))
        add(remOp.operands, lhsSlot)
        add(remOp.operands, productSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, remOp)
        return slotId
    var binOp: coreir.BodyOp
    binOp.kind = coreir.BodyOpBinOpTag
    binOp.target = slotId
    add(binOp.operands, typeKind)
    add(binOp.operands, binKind)
    add(binOp.operands, lhsSlot)
    add(binOp.operands, rhsSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, binOp)
    return slotId

# True when a condition-operand expression must be evaluated at 64-bit width.
# A bare i64 cast, a known i64/ptr local, or a top-level arithmetic/bitwise
# binop with an i64 sub-operand all force i64 — otherwise the i32-first operand
# resolver builds a 32-bit add/op and truncates the high word (e.g.
# `(base + uint64(16))` with a uint64 base).
@borrows
fn PrimaryBodyIrConditionOperandTextIsI64(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          textRaw: str): bool =
    let text = PrimaryBodyIrStripOuterParens(textRaw)
    if text == "":
        return false
    if PrimaryBodyIrTextIsI64IntegerCast(text):
        return true
    let argSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, text)
    if argSlot >= 0:
        let argType = PrimaryBodyIrSlotType(bodyIR, argSlot)
        if argType == coreir.LocalI64Tag:
            return true
        let argPointee = PrimaryBodyIrVarParamPointeeKind(bodyIR, argSlot)
        if argPointee == coreir.LocalI64Tag:
            return true
        return false
    let binTokens = ["+", "-", "*", "|", "&", "^", ">>", "<<"]
    for ti in 0..<binTokens.len:
        var binPos: int32 = -1
        if binTokens[ti] == "|" || binTokens[ti] == "&" || binTokens[ti] == "^":
            binPos = texpr.TypedExprFindTopLevelBitwiseTextToken(text, binTokens[ti])
        else:
            binPos = texpr.TypedExprFindTopLevelTextToken(text, binTokens[ti])
        if binPos > 0 && binPos + len(binTokens[ti]) < len(text):
            let binLhs = strutil.Strip(strings.SliceBytes(text, 0, binPos))
            let binRhs = strutil.Strip(strings.SliceBytes(text, binPos + len(binTokens[ti]), len(text) - binPos - len(binTokens[ti])))
            if PrimaryBodyIrConditionOperandTextIsI64(bodyIR, slotNames, binLhs) ||
               PrimaryBodyIrConditionOperandTextIsI64(bodyIR, slotNames, binRhs):
                return true
    return false

# True when `text` carries a top-level arithmetic/bitwise/shift operator — i.e.
# it is a *computed* expression whose value slot is synthesized (named after the
# expression text), not a stable local/param/field place. Such a slot must be
# re-materialized at every use because the earlier computation lives in whatever
# block first referenced it, which does not dominate later sibling blocks (an
# if/elif chain): caching the slot across blocks reads a stale/uninitialized
# value. Mirrors the operator set the binop materializer dispatches on.
@borrows
fn PrimaryBodyIrTextHasTopLevelArithBinOp(textRaw: str): bool =
    let text = PrimaryBodyIrStripOuterParens(textRaw)
    if text == "":
        return false
    if PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '+') > 0:
        return true
    if PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '-') > 0:
        return true
    if PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '*') > 0:
        return true
    if PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '/') > 0:
        return true
    if PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '%') > 0:
        return true
    if texpr.TypedExprFindTopLevelTextToken(text, ">>") > 0:
        return true
    if texpr.TypedExprFindTopLevelTextToken(text, "<<") > 0:
        return true
    if texpr.TypedExprFindTopLevelBitwiseTextToken(text, "|") > 0:
        return true
    if texpr.TypedExprFindTopLevelBitwiseTextToken(text, "&") > 0:
        return true
    if texpr.TypedExprFindTopLevelBitwiseTextToken(text, "^") > 0:
        return true
    return false

@borrows
fn PrimaryBodyIrConditionOperandSlot(bodyIR: var coreir.BodyIR,
                                      slotNames: var str[],
                                      lowering: var lower.LoweringPlanStub,
                                      typedFn: texpr.TypedExprIrFunction,
                                      irFunction: lower.PrimaryObjectIrFunction,
                                      sourcePath: str,
                                      lineNumber: int32,
                                      operandNodeIndex: int32,
                                      textRaw: str,
                                      callOrdinal: var int32,
                                      nextOpIndex: var int32): int32 =
    let text = strings.CloneStr(strutil.Strip(textRaw))
    if text == "":
        return -1
    let typedFnName = typedFn.functionName
    let fieldSlot = PrimaryBodyIrConditionFieldOperandSlot(bodyIR,
                                                           slotNames,
                                                           lowering.typedIr,
                                                           typedFn,
                                                           irFunction,
                                                           sourcePath,
                                                           lineNumber,
                                                           text,
                                                           nextOpIndex)
    if fieldSlot >= 0:
        return fieldSlot
    if text == "nil":
        let nilSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    "nil#ptr_zero",
                                                    coreir.LocalPtrTag)
        var nilOp: coreir.BodyOp
        nilOp.kind = coreir.BodyOpLoadConstTag
        nilOp.target = nilSlot
        add(nilOp.operands, coreir.LocalPtrTag)
        add(nilOp.operands, 0)
        let _ = coreir.BodyIRAppendOp(bodyIR, nilOp)
        nextOpIndex = nextOpIndex + 1
        return nilSlot
    let constVal = PrimaryBodyIrExtractIntFromText(text)
    if constVal != 0 || PrimaryBodyIrTextIsI32Zero(text):
        var constType = coreir.LocalI32Tag
        if PrimaryBodyIrTextIsI64IntegerCast(text):
            constType = coreir.LocalI64Tag
        var condConstSlotName = strings.CloneStr(text)
        if constType != coreir.LocalI32Tag:
            condConstSlotName = Fmt"{text}#k{constType}"
        let constSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                      slotNames,
                                                      condConstSlotName,
                                                      constType)
        var constOp: coreir.BodyOp
        constOp.kind = coreir.BodyOpLoadConstTag
        constOp.target = constSlot
        add(constOp.operands, constType)
        add(constOp.operands, constVal)
        let _ = coreir.BodyIRAppendOp(bodyIR, constOp)
        nextOpIndex = nextOpIndex + 1
        return constSlot
    if PrimaryBodyIrTextIsF64Literal(text):
        # #85 根修: 小数点后 >18 位 (自然精度写法, 如 20 位 Pi) 会通过上面纯形状
        # 检查, 但 AppendF64ConstOperands 内部数值物化会失败。物化前先用同一
        # 位级换算 (PrimaryBodyIrF64LiteralBits) 探路——探路失败直接 -1, 不先
        # FindOrCreateSlot 登记槽名, 避免留孤儿槽被别的裸文本查找臂误捡
        # (同 #76b callHead=="new" 孤儿槽机制, 见 orphan_audit_76d.md)。
        var f64PrecheckBits: uint64
        if !PrimaryBodyIrF64LiteralBits(text, f64PrecheckBits):
            return -1
        let f64ConstSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                         slotNames,
                                                         Fmt"{text}#kf64",
                                                         coreir.LocalF64Tag)
        if f64ConstSlot < 0:
            return -1
        var f64ConstOp: coreir.BodyOp
        f64ConstOp.kind = coreir.BodyOpLoadConstTag
        f64ConstOp.target = f64ConstSlot
        if !PrimaryBodyIrAppendF64ConstOperands(f64ConstOp, text):
            return -1
        let _ = coreir.BodyIRAppendOp(bodyIR, f64ConstOp)
        nextOpIndex = nextOpIndex + 1
        return f64ConstSlot
    # A side-effecting call operand must re-materialize on every textual
    # occurrence: reusing a cached result slot keyed by the call text would skip
    # the second `bl` in chains like `... and bump() and bump()`, leaving a stale
    # slot read (and the call uncalled). Only reuse cached slots for non-call
    # operands (locals/params) where the value is stable.
    # A *computed* expression (`0 - 7`, `a * b`, ...) is likewise unsafe to cache
    # across textual occurrences: its synthesized value slot was filled in the
    # block that first referenced it, which does not dominate later sibling
    # if/elif blocks, so a cached read sees a stale/uninitialized value (DRIVER
    # miscompile: a `(0 - 7)` compare-RHS repeated across two if-tests read an
    # uninitialized slot). Force re-materialization for arithmetic/bitwise exprs.
    # An ENUM-LABEL constant (`North`, `Dir.South`) is the same hazard: its slot is
    # keyed by the label text and filled by a LoadConst emitted in the FIRST match's
    # arm block. A second `match` on the same enum reuses that slot but its LoadConst
    # lives in the first match's possibly-skipped arm, so the compare reads garbage
    # (DRIVER miscompile r16: two consecutive enum matches — the 2nd arm-tag slot was
    # never re-loaded). Force the enum const down to the re-materializing const path.
    var condTextIsEnumConst: bool
    var condEnumTypeNameOut = ""
    var condEnumValueOut: int32
    if texpr.TypedExprIrLookupEnumConstValue(lowering.typedIr,
                                             sourcePath,
                                             text,
                                             condEnumTypeNameOut,
                                             condEnumValueOut):
        condTextIsEnumConst = true
    if !PrimaryBodyIrTextHasRealCallSurface(text) &&
       !PrimaryBodyIrTextHasTopLevelArithBinOp(text) &&
       !condTextIsEnumConst:
        let existingSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, text)
        if existingSlot >= 0:
            if PrimaryBodyIrVarParamPointeeKind(bodyIR, existingSlot) == coreir.LocalI64Tag:
                let valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                              slotNames,
                                                              PrimaryBodyIrVarI64ValueSlotName(text),
                                                              coreir.LocalI64Tag)
                PrimaryBodyIrAppendVarI64Load(bodyIR, existingSlot, valueSlot)
                nextOpIndex = nextOpIndex + 1
                return valueSlot
            # 常量槽跨块复用根修 (chengStrStoreCompat UninitializedUse): 模块 const
            # 标识符 (如 chengStrFlagOwned) 首引时经下方调用臂 FindOrCreateSlot 建槽
            # 并就地发射 LoadConst; 后续引用命中本复用臂直接返回槽而不再物化。首引
            # 若在某 if 分支块内, 其 LoadConst 不支配 join/兄弟块里的后续 use, CFG
            # 初始化校验报 UninitializedUse (liveness 沿无 def 路径反传至入口块)。
            # 与 enum-label 先例 (#85 上方注释) 同理: LoadConst 是纯值, 复用时在
            # 引用点重新物化同值 LoadConst, 支配性天然满足。仅当该槽最近一次 def
            # 恰为 LoadConst (operands==2) 时重新物化; 任何被后续非 const 写过的
            # 槽一律保持原复用语义。
            var reuseConstType: int32
            var reuseConstVal: int32
            if PrimaryBodyIrLoadConstOperandsForSlot(bodyIR,
                                                     existingSlot,
                                                     reuseConstType,
                                                     reuseConstVal):
                var reuseConstOp: coreir.BodyOp
                reuseConstOp.kind = coreir.BodyOpLoadConstTag
                reuseConstOp.target = existingSlot
                add(reuseConstOp.operands, reuseConstType)
                add(reuseConstOp.operands, reuseConstVal)
                let _ = coreir.BodyIRAppendOp(bodyIR, reuseConstOp)
                nextOpIndex = nextOpIndex + 1
            return existingSlot
    if PrimaryBodyIrTextHasCallSurface(text):
        # new(T) 堆对象分配内征 (#76b 根修): 与 CallScalarValueSlotForTextImpl 的
        # 同名镜像 guard 同理——条件/二元操作数位的 new(...) 落到这条通用调用兜底
        # 臂时, 下面会先 FindOrCreateSlot 建一个从未写入的孤儿槽再尝试
        # AppendWholeCallExprToSlot(对 "new" 恒失败, 无函数体可解析), 孤儿槽留在
        # slotNames 里被后续裸标识符查找臂当合法槽复用, 读到栈残留值(if/binop
        # 条件比较静默 miscompile)。#76c: 不再诚实 miss, 原地 hoist(见
        # PrimaryBodyIrHoistNewCallToPtrSlot 注释); 失败仍 -1, 零回归。
        if PrimaryBodyIrWholeCallInnerForHead(text, "new") != "":
            let condNewOpsBefore = bodyIR.ops.len
            let condNewSlot = PrimaryBodyIrHoistNewCallToPtrSlot(bodyIR,
                                                                 slotNames,
                                                                 lowering.typedIr,
                                                                 sourcePath,
                                                                 lineNumber,
                                                                 text,
                                                                 callOrdinal)
            if condNewSlot >= 0:
                nextOpIndex = nextOpIndex + (bodyIR.ops.len - condNewOpsBefore)
            return condNewSlot
        var emptyCallVarI32ParamNames: str[]
        emptyCallVarI32ParamNames = []
        var condCallText = share(text)
        var condCallSlotType = coreir.LocalI32Tag
        var condCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "uint64")
        if condCastInner == "":
            condCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "int64")
        if condCastInner != "":
            condCallText = strutil.Strip(condCastInner)
            condCallSlotType = coreir.LocalI64Tag
        else:
            condCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "float64")
            if condCastInner == "":
                condCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "f64")
            if condCastInner != "":
                condCallText = strutil.Strip(condCastInner)
                condCallSlotType = coreir.LocalF64Tag
            else:
                condCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "int32")
                if condCastInner == "":
                    condCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "uint32")
                if condCastInner != "":
                    condCallText = strutil.Strip(condCastInner)
                else:
                    # Bare call (no scalar cast wrapper): the result slot width must
                    # follow the callee's declared return type, else an i64-returning
                    # call (e.g. `widen(5)` returning int64) is stored/loaded as a
                    # 32-bit value and the high word is truncated.
                    let condCallOpen = texpr.TypedExprFindWholeCallOpenParen(condCallText)
                    if condCallOpen > 0:
                        let condCallClose = texpr.TypedExprFindMatchingParen(condCallText, condCallOpen)
                        if condCallClose > condCallOpen && condCallClose + 1 == len(condCallText):
                            let condCallHead = strutil.Strip(strings.SliceBytes(condCallText, 0, condCallOpen))
                            let condCallArgsText = strutil.Strip(strings.SliceBytes(condCallText, condCallOpen + 1, condCallClose - condCallOpen - 1))
                            var condCallReturnType = ""
                            let _condCallOrdinal = PrimaryBodyIrResolvedOrRegisteredWholeCallOrdinal(irFunction,
                                                                                                    lowering.typedIr,
                                                                                                    sourcePath,
                                                                                                    condCallHead,
                                                                                                    PrimaryBodyIrCallArgNames(condCallArgsText).len,
                                                                                                    condCallReturnType)
                            let condCallReturnKind = PrimaryBodyIrTypeKindFromText(condCallReturnType)
                            if condCallReturnKind == coreir.LocalI64Tag:
                                condCallSlotType = coreir.LocalI64Tag
                            elif condCallReturnKind == coreir.LocalF64Tag:
                                condCallSlotType = coreir.LocalF64Tag
                            elif condCallReturnKind == coreir.LocalStrTag:
                                # str 返回调用作比较操作数 (`os.GetEnv(...) == "1"`):
                                # 此前恒落 I32Tag 默认——AppendWholeCallExprToSlot
                                # 把 str sret 结果硬塞 4 字节槽，且下游 str==str
                                # 内容比较特判(EmitConditionOps)因本操作数非
                                # LocalStrTag 而永不命中，退化成整型比较读垃圾。
                                condCallSlotType = coreir.LocalStrTag
        # Numeric cast wrapping a multi-dimensional fixed-array read
        # (`int32(b[i][j])`, `int64(m[i][j])`): the cast makes the whole text a
        # call surface, so the row-major multi-index flatten in the bare-operand
        # and scalar paths is skipped and the whole-call path below degrades the
        # nested subscript to a field-pointer deref — the outer index is dropped
        # and the element scale is wrong, so the read dereferences stack garbage
        # and segfaults. Route the cast inner through the bare-operand field path
        # (which flattens `root[i][j]` to the true element address), but only when
        # the element's read width equals the cast's target width, so a
        # widening/narrowing cast emits no orphan ops and keeps its existing path.
        if condCastInner != "":
            var condMdRoot = ""
            var condMdList: str[]
            condMdList = []
            if PrimaryBodyIrMultiIndexParts(condCastInner, condMdRoot, condMdList) >= 2:
                var condMdType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                 typedFn,
                                                                 irFunction,
                                                                 lineNumber,
                                                                 condMdRoot)
                if texpr.TypedExprNormalizeTypeText(condMdType) == "":
                    condMdType = texpr.TypedExprIrLookupLocalBindingTypeAnyLine(lowering.typedIr,
                                                                                sourcePath,
                                                                                typedFnName,
                                                                                condMdRoot)
                var condMdElemKind: int32
                var condMdElemSize: int32
                if condMdType != "" &&
                   PrimaryBodyIrSeqElementShapeFromText(lowering.typedIr,
                                                        strings.CloneStr(sourcePath),
                                                        texpr.TypedExprStripVarType(condMdType),
                                                        condMdElemKind,
                                                        condMdElemSize):
                    var condMdValueKind = condMdElemKind
                    if condMdElemSize == 1:
                        condMdValueKind = coreir.LocalI32Tag
                    if condMdValueKind == condCallSlotType:
                        var condMdNextOp = nextOpIndex
                        let condMdSlot = PrimaryBodyIrConditionFieldOperandSlot(bodyIR,
                                                                                slotNames,
                                                                                lowering.typedIr,
                                                                                typedFn,
                                                                                irFunction,
                                                                                sourcePath,
                                                                                lineNumber,
                                                                                condCastInner,
                                                                                condMdNextOp)
                        if condMdSlot >= 0 &&
                           PrimaryBodyIrSlotType(bodyIR, condMdSlot) == condCallSlotType:
                            nextOpIndex = condMdNextOp
                            return condMdSlot
        if !PrimaryBodyIrTextHasCallSurface(condCallText):
            condCallText = share(text)
            condCallSlotType = coreir.LocalI32Tag
        if operandNodeIndex < 0 ||
           operandNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
            let panicMsg = Fmt"primary: condition call operand lacks exact TypedExpr node function={typedFnName} line={lineNumber} node={operandNodeIndex}"
            panic(panicMsg)
        # Real (side-effecting) call result slots are per-occurrence unique so a
        # repeated call text (`bump()` twice in one chain) does not collapse onto
        # one slot and skip the second `bl`. Pure inline casts keep the stable
        # text key (no side effect, dedup is correct and saves a slot).
        var condCallSlotName = share(text)
        if PrimaryBodyIrTextHasRealCallSurface(condCallText):
            condCallSlotName = Fmt"{text}#condcall#{bodyIR.callSequence.len}"
        let callSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     condCallSlotName,
                                                     condCallSlotType)
        if callSlot >= 0 &&
           PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                  slotNames,
                                                  lowering,

                                                  typedFn,
                                                  irFunction,
                                                  emptyCallVarI32ParamNames,
                                                  condCallText,
                                                  callSlot,
                                                  lineNumber,
                                                  operandNodeIndex,
                                                  callOrdinal):
            nextOpIndex = nextOpIndex + 1
            return callSlot
    # 指针解引用操作数含真调用 (如 `*(UInt8Ptr(cheng_ptr_plus(data, i)))`)：下面的
    # ContextScalarValueSlotForText 内部 callOrdinal 恒为 -1 (禁用调用物化,仿
    # ConditionFieldOperandSlot)，会让 Append{UInt8,I32}PtrDerefLoad 因 callOrdinal<0
    # 静默失败——但目标槽已被 FindOrCreateSlot 提前注册且从未装载。紧随其后的 i64
    # 宽化臂用同一文本再探测时 FindArgSlot 命中这个"存在但从未写入"的槽，把栈残留值
    # 当合法 i32 结果宽化返回，比较即读取未初始化局部 (循环体内 if 条件比较取决于
    # 栈残留值)。用本函数持有的真实 callOrdinal 直接走 ScalarValueSlotForText，使
    # 槽创建与装载在同一次、ordinal 有效的尝试内完成，不留孤儿槽。
    if PrimaryBodyIrUInt8PtrDerefPointerText(text) != "" ||
       PrimaryBodyIrI32PtrDerefPointerText(text) != "":
        var emptyDerefVarI32ParamNames: str[]
        emptyDerefVarI32ParamNames = []
        let derefSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            emptyDerefVarI32ParamNames,
                                                            lowering.typedIr,
                                                            sourcePath,
                                                            text,
                                                            coreir.LocalI32Tag,
                                                            callOrdinal)
        if derefSlot >= 0:
            nextOpIndex = nextOpIndex + 1
            return derefSlot
    var emptyVarI32ParamNames: str[]
    emptyVarI32ParamNames = []
    # i64-flavored operands (uint64/int64 cast, an i64 local, or a binop with an
    # i64 sub-operand) must resolve at 64-bit width first; the i32-first path
    # would otherwise build a truncating 32-bit op for e.g. `(base + uint64(16))`.
    if PrimaryBodyIrConditionOperandTextIsI64(bodyIR, slotNames, text):
        let i64FirstSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                      slotNames,
                                                                      emptyVarI32ParamNames,
                                                                      lowering.typedIr,
                                                                      typedFn,
                                                                      irFunction,
                                                                      sourcePath,
                                                                      0,
                                                                      text,
                                                                      coreir.LocalI64Tag)
        if i64FirstSlot >= 0:
            nextOpIndex = nextOpIndex + 1
            return i64FirstSlot
    let scalar32Slot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                  slotNames,
                                                                  emptyVarI32ParamNames,
                                                                  lowering.typedIr,
                                                                  typedFn,
                                                                  irFunction,
                                                                  sourcePath,
                                                                  0,
                                                                  text,
                                                                  coreir.LocalI32Tag)
    if scalar32Slot >= 0:
        nextOpIndex = nextOpIndex + 1
        return scalar32Slot
    let scalar64Slot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                  slotNames,
                                                                  emptyVarI32ParamNames,
                                                                  lowering.typedIr,
                                                                  typedFn,
                                                                  irFunction,
                                                                  sourcePath,
                                                                  0,
                                                                  text,
                                                                  coreir.LocalI64Tag)
    if scalar64Slot >= 0:
        nextOpIndex = nextOpIndex + 1
        return scalar64Slot
    let globalType = PrimaryBodyIrTypedGlobalTypeExact(lowering.typedIr, sourcePath, text)
    if globalType != "":
        var globalTypeKind: int32
        var globalSizeBytes: int32
        var globalAlignBytes: int32
        PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                       sourcePath,
                                       globalType,
                                       globalTypeKind,
                                       globalSizeBytes,
                                       globalAlignBytes)
        if globalTypeKind == coreir.LocalAggregateTag:
            # 聚合全局无标量 GlobalLoad（size 0=静默截断）；seq 全局经地址物化读取，
            # 其余聚合全局返回 -1 留诚实缺口，不发射截断体的零宽 op。
            let aggregateOpsBefore = bodyIR.ops.len
            let aggregateAddrSlot = PrimaryBodyIrGlobalSeqAddressSlot(bodyIR,
                                                                      slotNames,
                                                                      lowering.typedIr,
                                                                      sourcePath,
                                                                      text)
            nextOpIndex = nextOpIndex + (bodyIR.ops.len - aggregateOpsBefore)
            return aggregateAddrSlot
        let globalSlotName = PrimaryBodyIrTypedGlobalSlotNameExact(lowering.typedIr, sourcePath, text)
        if globalSlotName == "":
            return -1
        let globalSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       globalSlotName,
                                                       globalTypeKind)
        PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, globalSlot)
        bodyIR.localSlots[globalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
        let valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                      slotNames,
                                                      Fmt"{globalSlotName}#global_value",
                                                      globalTypeKind)
        var op: coreir.BodyOp
        op.kind = coreir.BodyOpGlobalLoadTag
        op.target = valueSlot
        add(op.operands, globalSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, op)
        nextOpIndex = nextOpIndex + 1
        return valueSlot
    if PrimaryBodyIrTextIsStringLiteral(text):
        # 字符串字面量比较操作数 (`x == "1"`)：此前无分支覆盖，落穿到本函数
        # 末尾的裸 int32 占位槽创建——从未装载，后续 Cmp 读栈垃圾（形态⑪
        # 伴生缺口：cmp w9,w10 的 w10 读 [sp,#0x30]，全函数无一处写它）。
        # 真物化：str 槽 + AppendStringLiteralValue（与其它字面量赋值路径
        # 同款 driver_c_str_from_utf8_copy_bridge 物化），使下游 str==str
        # 内容比较特判（EmitConditionOps）真正命中。
        let strLitSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"{text}#cond_str_lit#{bodyIR.ops.len}",
                                                       coreir.LocalStrTag)
        # [wall107b] 物化 call 的 def 发布补全（wall33 EvalNode StrLit 臂
        # 逐字同型，同 call-arg 实参臂 [wall107b] 注记）：非空载荷物化后按
        # 本操作数节点的 ManagedTemporary 权威行落 wall28 binder 全列戳；
        # 节点缺失/非 StrLit 即 panic（同 :condition call operand lacks
        # exact TypedExpr node 的 fail-closed 口径），不发射无权威 def 形。
        let condStrLitPayloadEmpty =
            len(PrimaryBodyIrStringLiteralPayload(text)) == 0
        if strLitSlot >= 0 &&
           PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                 slotNames,
                                                 text,
                                                 strLitSlot,
                                                 callOrdinal):
            if !condStrLitPayloadEmpty:
                if operandNodeIndex < 0 ||
                   operandNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
                   lowering.typedIr.nodes2_opKinds[operandNodeIndex] !=
                       texpr.TypedExprIrOpStrLit:
                    let panicMsg = Fmt"primary: condition str literal operand lacks exact TypedExpr StrLit authority line={lineNumber} node={operandNodeIndex}"
                    panic(panicMsg)
                PrimaryBodyIrBindManagedBridgeResultDefinition(
                    bodyIR,
                    lowering,
                    irFunction.ownershipTransport,
                    operandNodeIndex,
                    bodyIR.callSequence.len - 1,
                    bodyIR.ops.len - 1)
            nextOpIndex = nextOpIndex + 1
            return strLitSlot
        return -1
    return PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, text, coreir.LocalI32Tag)

@borrows
fn PrimaryBodyIrCondValue01Slot(bodyIR: var coreir.BodyIR,
                                slotNames: var str[],
                                lowering: var lower.LoweringPlanStub,
                                typedFn: texpr.TypedExprIrFunction,
                                irFunction: lower.PrimaryObjectIrFunction,
                                sourcePath: str,
                                lineNumber: int32,
                                condTextRaw: str,
                                slotNameHint: str,
                                callOrdinal: var int32): int32 =
    let condText = PrimaryBodyIrStripOuterParens(strutil.Strip(condTextRaw))
    if condText == "":
        return -1
    let andPos = texpr.TypedExprFindTopLevelTextToken(condText, "&&")
    let orPos = texpr.TypedExprFindTopLevelTextToken(condText, "||")
    if andPos > 0 || orPos > 0:
        # T78 短路契约根修：非短路位运算(位与/位或)等价仅在两操作数都无副作用
        # 且无故障风险时成立。此前只递归求两臂 0/1 值就直接位与，无控制流跳转
        # ——是 docs/cheng-formal-spec.md:121 短路契约的 eager 违例：两臂含真调用
        # 时会多跑一次调用(副作用错)，含下标读(`arr[i]`)时会在无边界守卫下越界
        # 读(SIGSEGV，sc_repro 实证)。两臂任一含调用或下标即诚实 bail(-1)，让
        # 调用方落到已有的真短路 lowering(语句位 CBR 链 / decl 位
        # AppendBoolConditionAssign 等，见调用点审计)，不得继续走本函数的位运算
        # 快路径。
        var splitPos = andPos
        var isAnd = true
        if andPos <= 0 || (orPos > 0 && orPos < andPos):
            splitPos = orPos
            isAnd = false
        let leftText = strings.SliceBytes(condText, 0, splitPos)
        let rightText = strings.SliceBytes(condText, splitPos + 2, len(condText) - splitPos - 2)
        if PrimaryBodyIrTextHasFaultingEagerSurface(leftText) ||
           PrimaryBodyIrTextHasFaultingEagerSurface(rightText):
            return -1
        let leftSlot = PrimaryBodyIrCondValue01Slot(bodyIR, slotNames, lowering,  typedFn,
                                                    irFunction, sourcePath, lineNumber,
                                                    leftText,
                                                    Fmt"{slotNameHint}#l", callOrdinal)
        if leftSlot < 0:
            return -1
        let rightSlot = PrimaryBodyIrCondValue01Slot(bodyIR, slotNames, lowering,  typedFn,
                                                     irFunction, sourcePath, lineNumber,
                                                     rightText,
                                                     Fmt"{slotNameHint}#r", callOrdinal)
        if rightSlot < 0:
            return -1
        let combineSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, slotNameHint, coreir.LocalI32Tag)
        if combineSlot < 0:
            return -1
        var combineOp: coreir.BodyOp
        combineOp.kind = coreir.BodyOpBinOpTag
        combineOp.target = combineSlot
        add(combineOp.operands, coreir.LocalI32Tag)
        if isAnd:
            add(combineOp.operands, int32(texpr.TypedExprIrOpI32BitAnd))
        else:
            add(combineOp.operands, int32(texpr.TypedExprIrOpI32BitOr))
        add(combineOp.operands, leftSlot)
        add(combineOp.operands, rightSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, combineOp)
        return combineSlot
    var condLhs: int32 = -1
    var condRhs: int32 = -1
    var condTag: int32 = -1
    var condNextOp: int32
    condNextOp = bodyIR.ops.len
    if PrimaryBodyIrEmitConditionOps(bodyIR, slotNames, lowering,  typedFn,
                                     irFunction, sourcePath, lineNumber, -1, condText,
                                     condLhs, condRhs, condTag, callOrdinal, condNextOp):
        if condLhs >= 0 && condRhs < 0:
            # 布尔单槽（NonZero/Zero）转与 0 比较的 0/1 值。
            let zeroRhsSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                              slotNames,
                                                              Fmt"{slotNameHint}#zero",
                                                              coreir.LocalI32Tag,
                                                              0)
            if zeroRhsSlot < 0:
                return -1
            condRhs = zeroRhsSlot
            if condTag == coreir.BodyCondLocalZeroTag:
                condTag = coreir.BodyCondI32EqTag
            else:
                condTag = coreir.BodyCondI32NeTag
    if condLhs < 0 || condRhs < 0:
        # EmitConditionOps 操作数覆盖不足时自行解析（nil/ptr/u64 操作数）。
        var selfCmpPos: int32 = -1
        var selfCmpLen: int32 = 2
        var selfCmpTag: int32
        selfCmpPos = texpr.TypedExprFindTopLevelTextToken(condText, "==")
        if selfCmpPos >= 0:
            selfCmpTag = coreir.BodyCondI32EqTag
        if selfCmpPos < 0:
            selfCmpPos = texpr.TypedExprFindTopLevelTextToken(condText, "!=")
            if selfCmpPos >= 0:
                selfCmpTag = coreir.BodyCondI32NeTag
        if selfCmpPos < 0:
            selfCmpPos = texpr.TypedExprFindTopLevelTextToken(condText, ">=")
            if selfCmpPos >= 0:
                selfCmpTag = coreir.BodyCondI32GeTag
        if selfCmpPos < 0:
            let selfLeTok = strutil.Join(["<", "="], "")
            selfCmpPos = texpr.TypedExprFindTopLevelTextToken(condText, selfLeTok)
            if selfCmpPos >= 0:
                selfCmpTag = coreir.BodyCondI32LeTag
        if selfCmpPos < 0:
            selfCmpPos = texpr.TypedExprFindTopLevelTextToken(condText, ">")
            if selfCmpPos >= 0:
                selfCmpLen = 1
                selfCmpTag = coreir.BodyCondI32GtTag
        if selfCmpPos < 0:
            selfCmpPos = texpr.TypedExprFindTopLevelTextToken(condText, "<")
            if selfCmpPos >= 0:
                selfCmpLen = 1
                selfCmpTag = coreir.BodyCondI32LtTag
        if selfCmpPos <= 0:
            return -1
        let selfLhsText = strutil.Strip(strings.SliceBytes(condText, 0, selfCmpPos))
        let selfRhsText = strutil.Strip(strings.SliceBytes(condText,
                                                           selfCmpPos + selfCmpLen,
                                                           len(condText) - selfCmpPos - selfCmpLen))
        condLhs = PrimaryBodyIrCondCmpOperandSlot(bodyIR, slotNames, lowering.typedIr, sourcePath,
                                                  selfLhsText, Fmt"{slotNameHint}#cl", callOrdinal)
        condRhs = PrimaryBodyIrCondCmpOperandSlot(bodyIR, slotNames, lowering.typedIr, sourcePath,
                                                  selfRhsText, Fmt"{slotNameHint}#cr", callOrdinal)
        condTag = selfCmpTag
        if condLhs < 0 || condRhs < 0:
            return -1
        let selfLhsKind = PrimaryBodyIrSlotType(bodyIR, condLhs)
        let selfRhsKind = PrimaryBodyIrSlotType(bodyIR, condRhs)
        if selfLhsKind == coreir.LocalF64Tag || selfRhsKind == coreir.LocalF64Tag:
            if selfLhsKind != coreir.LocalF64Tag || selfRhsKind != coreir.LocalF64Tag:
                return -1
            condTag = PrimaryBodyIrNodeEvalF64CmpCondTag(condTag)
            if condTag < 0:
                return -1
    let cmpSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, slotNameHint, coreir.LocalI32Tag)
    if cmpSlot < 0:
        return -1
    var cmpOp: coreir.BodyOp
    cmpOp.kind = coreir.BodyOpCmpTag
    cmpOp.target = cmpSlot
    add(cmpOp.operands, condTag)
    add(cmpOp.operands, condLhs)
    add(cmpOp.operands, condRhs)
    let _ = coreir.BodyIRAppendOp(bodyIR, cmpOp)
    return cmpSlot

@borrows
fn PrimaryBodyIrCondCmpOperandSlot(bodyIR: var coreir.BodyIR,
                                   slotNames: var str[],
                                   typedIr: texpr.TypedExprIr,
                                   sourcePath: str,
                                   operandTextRaw: str,
                                   slotNameHint: str,
                                   callOrdinal: var int32): int32 =
    let operandText = strutil.Strip(operandTextRaw)
    if operandText == "":
        return -1
    if operandText == "nil":
        let nilSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, slotNameHint, coreir.LocalPtrTag)
        if nilSlot < 0:
            return -1
        var nilOp: coreir.BodyOp
        nilOp.kind = coreir.BodyOpLoadConstTag
        nilOp.target = nilSlot
        add(nilOp.operands, coreir.LocalPtrTag)
        add(nilOp.operands, 0)
        let _ = coreir.BodyIRAppendOp(bodyIR, nilOp)
        return nilSlot
    var emptyVarI32: str[]
    emptyVarI32 = []
    let directSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, operandText)
    if directSlot >= 0:
        # 常量槽跨块复用根修 (同 ConditionOperandSlot/I32ValueSlotForText 两臂):
        # 模块 const 标识符 (chengStrFlagOwned) 首引在分支块内建槽并就地 LoadConst,
        # 条件比较操作数经本臂命中同槽直接返回时, 首引 LoadConst 不支配 join/兄弟
        # 块的 use → CFG UninitializedUse (chengStrStoreCompat :437/:447)。
        # LoadConst 为纯值, 引用点重新物化同值即可满足支配; 仅限最近 def 恰为
        # LoadConst 的槽, 其余保持原复用语义。
        var cmpReuseConstType: int32
        var cmpReuseConstVal: int32
        if PrimaryBodyIrLoadConstOperandsForSlot(bodyIR,
                                                 directSlot,
                                                 cmpReuseConstType,
                                                 cmpReuseConstVal):
            var cmpReuseConstOp: coreir.BodyOp
            cmpReuseConstOp.kind = coreir.BodyOpLoadConstTag
            cmpReuseConstOp.target = directSlot
            add(cmpReuseConstOp.operands, cmpReuseConstType)
            add(cmpReuseConstOp.operands, cmpReuseConstVal)
            let _ = coreir.BodyIRAppendOp(bodyIR, cmpReuseConstOp)
        return directSlot
    let ptrSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR, slotNames, emptyVarI32, typedIr,
                                                 sourcePath, operandText, callOrdinal)
    if ptrSlot >= 0:
        return ptrSlot
    let u64Slot = PrimaryBodyIrU64ValueSlotForText(bodyIR, slotNames, emptyVarI32, typedIr,
                                                   sourcePath, operandText, callOrdinal)
    if u64Slot >= 0:
        return u64Slot
    let f64Slot = PrimaryBodyIrScalarValueSlotForText(bodyIR, slotNames, emptyVarI32, typedIr,
                                                      sourcePath, operandText, coreir.LocalF64Tag, callOrdinal)
    if f64Slot >= 0:
        return f64Slot
    return PrimaryBodyIrScalarValueSlotForText(bodyIR, slotNames, emptyVarI32, typedIr,
                                               sourcePath, operandText, coreir.LocalI32Tag, callOrdinal)

@borrows
fn PrimaryBodyIrEmitConditionOps(bodyIR: var coreir.BodyIR,
                                   slotNames: var str[],
                                   lowering: var lower.LoweringPlanStub,
                                   typedFn: texpr.TypedExprIrFunction,
                                   irFunction: lower.PrimaryObjectIrFunction,
                                   sourcePath: str,
                                   lineNumber: int32,
                                   conditionNodeIndex: int32,
                                   condText: str,
                                   lhsSlot: var int32,
                                   rhsSlot: var int32,
                                   cmpTag: var int32,
                                   callOrdinal: var int32,
                                   nextOpIndex: var int32): bool =
    let cond = PrimaryBodyIrStripOuterParens(condText)
    if cond == "":
        return false
    if PrimaryBodyIrConditionHasAnd(cond) ||
       PrimaryBodyIrConditionHasOr(cond):
        return false
    var cmpOpPos: int32
    cmpOpPos = -1
    var cmpOpLen: int32
    cmpOpLen = 0
    cmpTag = 0
    cmpOpPos = texpr.TypedExprFindTopLevelTextToken(cond, "==")
    if cmpOpPos >= 0:
        cmpOpLen = 2
        cmpTag = coreir.BodyCondI32EqTag
    if cmpOpPos < 0:
        cmpOpPos = texpr.TypedExprFindTopLevelTextToken(cond, "!=")
        if cmpOpPos >= 0:
            cmpOpLen = 2
            cmpTag = coreir.BodyCondI32NeTag
    if cmpOpPos < 0:
        let leToken = strutil.Join(["<", "="], "")
        cmpOpPos = texpr.TypedExprFindTopLevelTextToken(cond, leToken)
        if cmpOpPos >= 0:
            cmpOpLen = 2
            cmpTag = coreir.BodyCondI32LeTag
    if cmpOpPos < 0:
        cmpOpPos = texpr.TypedExprFindTopLevelTextToken(cond, ">=")
        if cmpOpPos >= 0:
            cmpOpLen = 2
            cmpTag = coreir.BodyCondI32GeTag
    if cmpOpPos < 0:
        cmpOpPos = texpr.TypedExprFindTopLevelTextToken(cond, "<")
        if cmpOpPos >= 0:
            cmpOpLen = 1
            cmpTag = coreir.BodyCondI32LtTag
    if cmpOpPos < 0:
        cmpOpPos = texpr.TypedExprFindTopLevelTextToken(cond, ">")
        if cmpOpPos >= 0:
            cmpOpLen = 1
            cmpTag = coreir.BodyCondI32GtTag
    if cmpOpPos < 0:
        let condLen = len(cond)
        var boolText = strings.CloneStr(cond)
        cmpTag = coreir.BodyCondLocalNonZeroTag
        if len(boolText) > 1 && boolText[0] == '!':
            boolText = strutil.Strip(strings.SliceBytes(boolText, 1, len(boolText) - 1))
            cmpTag = coreir.BodyCondLocalZeroTag
        var boolNodeIndex = conditionNodeIndex
        if len(boolText) < condLen &&
           conditionNodeIndex >= 0 &&
           conditionNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
           lowering.typedIr.nodes2_opKinds[conditionNodeIndex] ==
               texpr.TypedExprIrOpLogNot:
            boolNodeIndex = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_operand0NodeIndexs,
                conditionNodeIndex)
        lhsSlot = PrimaryBodyIrConditionOperandSlot(bodyIR,
                                                   slotNames,
                                                   lowering,

                                                   typedFn,
                                                   irFunction,
                                                   sourcePath,
                                                   lineNumber,
                                                   boolNodeIndex,
                                                   boolText,
                                                   callOrdinal,
                                                   nextOpIndex)
        rhsSlot = -1
        if lhsSlot >= 0:
            return true
        return false
    var condLhs = strings.SliceBytes(cond, 0, cmpOpPos)
    var lhsEnd = len(condLhs)
    while lhsEnd > 0:
        if condLhs[lhsEnd - 1] != ' ':
            break
        lhsEnd = lhsEnd - 1
    if lhsEnd > 0:
        condLhs = strings.SliceBytes(condLhs, 0, lhsEnd)
    var condRhsRaw = strings.SliceBytes(cond, cmpOpPos + cmpOpLen, len(cond) - cmpOpPos - cmpOpLen)
    var rhsStartPos: int32
    rhsStartPos = 0
    while rhsStartPos < len(condRhsRaw):
        if condRhsRaw[rhsStartPos] != ' ':
            break
        rhsStartPos = rhsStartPos + 1
    # t13: spec 迁移——condRhsRaw 在重赋值臂内仍被读，move 形静态非法。
    var condRhs = share(condRhsRaw)
    if rhsStartPos > 0:
        condRhs = strings.SliceBytes(condRhsRaw, rhsStartPos, len(condRhsRaw) - rhsStartPos)
    var lhsNodeIndex: int32 = -1
    var rhsNodeIndex: int32 = -1
    if conditionNodeIndex >= 0 &&
       conditionNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
        let conditionOpKind =
            lowering.typedIr.nodes2_opKinds[conditionNodeIndex]
        let conditionOpMatches =
            (cmpTag == coreir.BodyCondI32EqTag &&
             conditionOpKind == texpr.TypedExprIrOpCmpEq) ||
            (cmpTag == coreir.BodyCondI32NeTag &&
             conditionOpKind == texpr.TypedExprIrOpCmpNe) ||
            (cmpTag == coreir.BodyCondI32LtTag &&
             conditionOpKind == texpr.TypedExprIrOpCmpLt) ||
            (cmpTag == coreir.BodyCondI32LeTag &&
             conditionOpKind == texpr.TypedExprIrOpCmpLe) ||
            (cmpTag == coreir.BodyCondI32GtTag &&
             conditionOpKind == texpr.TypedExprIrOpCmpGt) ||
            (cmpTag == coreir.BodyCondI32GeTag &&
             conditionOpKind == texpr.TypedExprIrOpCmpGe)
        if conditionOpMatches:
            lhsNodeIndex = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_operand0NodeIndexs,
                conditionNodeIndex)
            rhsNodeIndex = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_operand1NodeIndexs,
                conditionNodeIndex)
    lhsSlot = PrimaryBodyIrConditionOperandSlot(bodyIR, slotNames, lowering,  typedFn, irFunction, sourcePath, lineNumber, lhsNodeIndex, condLhs, callOrdinal, nextOpIndex)
    rhsSlot = PrimaryBodyIrConditionOperandSlot(bodyIR, slotNames, lowering,  typedFn, irFunction, sourcePath, lineNumber, rhsNodeIndex, condRhs, callOrdinal, nextOpIndex)
    if lhsSlot < 0 || rhsSlot < 0:
        return false
    # str == str / str != str is value (content) comparison; the bare scalar Cmp
    # produced below would compare the two str-struct addresses (pointer compare),
    # so distinct copies of equal text wrongly mismatch. When both operands are
    # str slots and the op is ==/!=, emit the proven BodyOpStrEq content-compare
    # (len + byte loop -> i32 0/1) and reframe the condition as that i32 vs 0:
    #   ==  true when equal  -> StrEq != 0  (cmpTag Ne)
    #   !=  true when differ -> StrEq == 0  (cmpTag Eq)
    if (cmpTag == coreir.BodyCondI32EqTag || cmpTag == coreir.BodyCondI32NeTag) &&
       PrimaryBodyIrSlotType(bodyIR, lhsSlot) == coreir.LocalStrTag &&
       PrimaryBodyIrSlotType(bodyIR, rhsSlot) == coreir.LocalStrTag:
        let strEqKey = bodyIR.ops.len
        let strEqResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                            slotNames,
                                                            Fmt"#cond_streq#{strEqKey}",
                                                            coreir.LocalI32Tag)
        if strEqResultSlot < 0:
            return false
        var strEqOp: coreir.BodyOp
        strEqOp.kind = coreir.BodyOpStrEqTag
        strEqOp.target = strEqResultSlot
        add(strEqOp.operands, lhsSlot)
        add(strEqOp.operands, rhsSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, strEqOp)
        nextOpIndex = nextOpIndex + 1
        let strEqZeroSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                            slotNames,
                                                            Fmt"#cond_streq#{strEqKey}#zero",
                                                            coreir.LocalI32Tag,
                                                            0)
        if strEqZeroSlot < 0:
            return false
        nextOpIndex = nextOpIndex + 1
        if cmpTag == coreir.BodyCondI32EqTag:
            cmpTag = coreir.BodyCondI32NeTag
        else:
            cmpTag = coreir.BodyCondI32EqTag
        lhsSlot = strEqResultSlot
        rhsSlot = strEqZeroSlot
        return true
    let condLhsType = PrimaryBodyIrSlotType(bodyIR, lhsSlot)
    let condRhsType = PrimaryBodyIrSlotType(bodyIR, rhsSlot)
    if condLhsType == coreir.LocalF64Tag || condRhsType == coreir.LocalF64Tag:
        if condLhsType != coreir.LocalF64Tag || condRhsType != coreir.LocalF64Tag:
            return false
        cmpTag = PrimaryBodyIrNodeEvalF64CmpCondTag(cmpTag)
        if cmpTag < 0:
            return false
    elif PrimaryBodyIrConditionOperandNeedsI64(bodyIR, lhsSlot) ||
       PrimaryBodyIrConditionOperandNeedsI64(bodyIR, rhsSlot):
        cmpTag = PrimaryBodyIrConditionI64TagFor(cmpTag)
    return true

@borrows
fn PrimaryBodyIrConditionCbrBlockCount(condTextRaw: str): int32 =
    let condText = PrimaryBodyIrStripOuterParens(condTextRaw)
    if condText == "":
        return 0
    if PrimaryBodyIrConditionHasTrailingConnector(condText):
        return 0
    if PrimaryBodyIrConditionHasOr(condText):
        let parts = PrimaryBodyIrSplitOrConditions(condText)
        var total: int32
        for i in 0..<parts.len:
            total = total + PrimaryBodyIrConditionCbrBlockCount(parts[i])
        return total
    if PrimaryBodyIrConditionHasAnd(condText):
        let parts = PrimaryBodyIrSplitAndConditions(condText)
        var total: int32
        for i in 0..<parts.len:
            total = total + PrimaryBodyIrConditionCbrBlockCount(parts[i])
        return total
    return 1

@borrows
fn PrimaryBodyIrConditionOperandNeedsI64(bodyIR: coreir.BodyIR,
                                         slotId: int32): bool =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return false
    let slotType = PrimaryBodyIrSlotType(bodyIR, slotId)
    if slotType == coreir.LocalI64Tag:
        return true
    if slotType == coreir.LocalPtrTag:
        return true
    return false

@borrows
fn PrimaryBodyIrConditionI64TagFor(tag: int32): int32 =
    if tag == coreir.BodyCondI32EqTag:
        return coreir.BodyCondI64EqTag
    if tag == coreir.BodyCondI32NeTag:
        return coreir.BodyCondI64NeTag
    if tag == coreir.BodyCondI32LtTag:
        return coreir.BodyCondI64LtTag
    if tag == coreir.BodyCondI32LeTag:
        return coreir.BodyCondI64LeTag
    if tag == coreir.BodyCondI32GtTag:
        return coreir.BodyCondI64GtTag
    if tag == coreir.BodyCondI32GeTag:
        return coreir.BodyCondI64GeTag
    return tag

@borrows
fn PrimaryBodyIrEmitConditionCbrChain(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       lowering: var lower.LoweringPlanStub,
                                       typedFn: texpr.TypedExprIrFunction,
                                       irFunction: lower.PrimaryObjectIrFunction,
                                       sourcePath: str,
                                       lineNumber: int32,
                                       condTextRaw: str,
                                       successBlock: int32,
                                       failureBlock: int32,
                                       callOrdinal: var int32,
                                       nextOpIndex: var int32,
                                       currentBlockStart: var int32,
                                       pendingFailureTerms: var int32[]): bool =
    let condText = PrimaryBodyIrStripOuterParens(condTextRaw)
    if condText == "":
        return false
    if PrimaryBodyIrConditionHasOr(condText):
        let parts = PrimaryBodyIrSplitOrConditions(condText)
        for i in 0..<parts.len:
            let partCount = PrimaryBodyIrConditionCbrBlockCount(parts[i])
            if partCount <= 0:
                return false
            var partFailureBlock = failureBlock
            if i < parts.len - 1:
                partFailureBlock = bodyIR.blocks.len + partCount
            if !PrimaryBodyIrEmitConditionCbrChain(bodyIR,
                                                   slotNames,
                                                   lowering,

                                                   typedFn,
                                                   irFunction,
                                                   sourcePath,
                                                   lineNumber,
                                                   parts[i],
                                                   successBlock,
                                                   partFailureBlock,
                                                   callOrdinal,
                                                   nextOpIndex,
                                                   currentBlockStart,
                                                   pendingFailureTerms):
                return false
        return true
    if PrimaryBodyIrConditionHasAnd(condText):
        let parts = PrimaryBodyIrSplitAndConditions(condText)
        for i in 0..<parts.len:
            let partCount = PrimaryBodyIrConditionCbrBlockCount(parts[i])
            if partCount <= 0:
                return false
            var partSuccessBlock = successBlock
            if i < parts.len - 1:
                partSuccessBlock = bodyIR.blocks.len + partCount
            if !PrimaryBodyIrEmitConditionCbrChain(bodyIR,
                                                   slotNames,
                                                   lowering,

                                                   typedFn,
                                                   irFunction,
                                                   sourcePath,
                                                   lineNumber,
                                                   parts[i],
                                                   partSuccessBlock,
                                                   failureBlock,
                                                   callOrdinal,
                                                   nextOpIndex,
                                                   currentBlockStart,
                                                   pendingFailureTerms):
                return false
        return true
    var lhsSlot: int32
    var rhsSlot: int32
    var cmpTag: int32
    if !PrimaryBodyIrEmitConditionOps(bodyIR,
                                      slotNames,
                                      lowering,

                                      typedFn,
                                      irFunction,
                                      sourcePath,
                                      lineNumber,
                                      -1,
                                      condText,
                                      lhsSlot,
                                      rhsSlot,
                                      cmpTag,
                                      callOrdinal,
                                      nextOpIndex):
        return false
    var cbrTerm: coreir.BodyTerm
    cbrTerm.kind = coreir.BodyTermCbrTag
    cbrTerm.conditionKind = cmpTag
    cbrTerm.lhsSlot = lhsSlot
    cbrTerm.rhsSlot = rhsSlot
    cbrTerm.trueBlock = successBlock
    cbrTerm.falseBlock = failureBlock
    cbrTerm.resultSlot = -1
    let cbrTermIndex = coreir.BodyIRAppendTerm(bodyIR, cbrTerm)
    let cbrBlockOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, cbrBlockOpCount, cbrTermIndex)
    currentBlockStart = bodyIR.ops.len
    if failureBlock < 0:
        add(pendingFailureTerms, cbrTermIndex)
    return true

@borrows
fn PrimaryBodyIrAppendConditionTerm(bodyIR: var coreir.BodyIR,
                                     conditionSlot: int32,
                                     conditionKind: int32,
                                     currentBlockStart: var int32,
                                     pendingFalseTerm: var int32) =
    var term: coreir.BodyTerm
    term.kind = coreir.BodyTermCbrTag
    term.conditionKind = conditionKind
    term.lhsSlot = conditionSlot
    term.rhsSlot = -1
    term.trueBlock = -1
    term.falseBlock = -1
    term.resultSlot = -1
    let termIndex = coreir.BodyIRAppendTerm(bodyIR, term)
    let opCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, opCount, termIndex)
    currentBlockStart = bodyIR.ops.len
    pendingFalseTerm = termIndex

@borrows
fn PrimaryBodyIrAppendBoolConditionAssign(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           lowering: var lower.LoweringPlanStub,
                                           typedFn: texpr.TypedExprIrFunction,
                                           irFunction: lower.PrimaryObjectIrFunction,
                                           sourcePath: str,
                                           lineNumber: int32,
                                           rhsTextRaw: str,
                                           targetSlot: int32,
                                           callOrdinal: var int32,
                                           currentBlockStart: var int32): bool =
    if targetSlot < 0 ||
       targetSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalI32Tag:
        return false
    let rhsText = strutil.Strip(rhsTextRaw)
    if rhsText == "":
        return false
    let conditionBlockCount = PrimaryBodyIrConditionCbrBlockCount(rhsText)
    if conditionBlockCount <= 0:
        return false
    var dummyNextOpIndex: int32
    var pendingFailureTerms: int32[]
    let successBlock = bodyIR.blocks.len + conditionBlockCount
    let failureBlock = successBlock + 1
    let joinBlock = successBlock + 2
    if !PrimaryBodyIrEmitConditionCbrChain(bodyIR,
                                          slotNames,
                                          lowering,

                                          typedFn,
                                          irFunction,
                                          sourcePath,
                                          lineNumber,
                                          rhsText,
                                          successBlock,
                                          failureBlock,
                                          callOrdinal,
                                          dummyNextOpIndex,
                                          currentBlockStart,
                                          pendingFailureTerms):
        return false

    var trueOp: coreir.BodyOp
    trueOp.kind = coreir.BodyOpLoadConstTag
    trueOp.target = targetSlot
    add(trueOp.operands, coreir.LocalI32Tag)
    add(trueOp.operands, 1)
    let _ = coreir.BodyIRAppendOp(bodyIR, trueOp)
    var trueBr: coreir.BodyTerm
    trueBr.kind = coreir.BodyTermBrTag
    trueBr.conditionKind = coreir.BodyCondInvalidTag
    trueBr.lhsSlot = -1
    trueBr.rhsSlot = -1
    trueBr.resultSlot = -1
    trueBr.trueBlock = joinBlock
    trueBr.falseBlock = -1
    let trueTermIndex = coreir.BodyIRAppendTerm(bodyIR, trueBr)
    let trueBlockOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, trueBlockOpCount, trueTermIndex)
    currentBlockStart = bodyIR.ops.len

    var falseOp: coreir.BodyOp
    falseOp.kind = coreir.BodyOpLoadConstTag
    falseOp.target = targetSlot
    add(falseOp.operands, coreir.LocalI32Tag)
    add(falseOp.operands, 0)
    let _ = coreir.BodyIRAppendOp(bodyIR, falseOp)
    var falseBr: coreir.BodyTerm
    falseBr.kind = coreir.BodyTermBrTag
    falseBr.conditionKind = coreir.BodyCondInvalidTag
    falseBr.lhsSlot = -1
    falseBr.rhsSlot = -1
    falseBr.resultSlot = -1
    falseBr.trueBlock = joinBlock
    falseBr.falseBlock = -1
    let falseTermIndex = coreir.BodyIRAppendTerm(bodyIR, falseBr)
    let falseBlockOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, falseBlockOpCount, falseTermIndex)
    currentBlockStart = bodyIR.ops.len
    return true

@borrows
fn PrimaryBodyIrAppendTypedStrLiteralCondition(bodyIR: var coreir.BodyIR,
                                                slotNames: var str[],
                                                stmt: lower.PrimaryObjectIrStatement,
                                                currentBlockStart: var int32,
                                                pendingFalseTerm: var int32): bool =
    if stmt.conditionKind != texpr.TypedExprIrCondStrEqLiteral &&
       stmt.conditionKind != texpr.TypedExprIrCondStrNeLiteral:
        return false
    let conditionLhsText = stmt.conditionLhsText
    let conditionLiteralText = stmt.conditionLiteralText
    let strSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, conditionLhsText)
    if strSlot < 0:
        return false
    if PrimaryBodyIrSlotType(bodyIR, strSlot) != coreir.LocalStrTag:
        return false
    let resultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   Fmt"{conditionLhsText}#str_eq_literal#{conditionLiteralText}",
                                                   coreir.LocalI32Tag)
    let literalId = coreir.BodyIRAppendCStringLiteral(bodyIR,
                                                      conditionLiteralText,
                                                      "")
    var op: coreir.BodyOp
    add(op.operands, strSlot)
    add(op.operands, literalId)
    op.kind = coreir.BodyOpStrEqLiteralTag
    op.target = resultSlot
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    var condKind = coreir.BodyCondLocalNonZeroTag
    if stmt.conditionKind == texpr.TypedExprIrCondStrNeLiteral:
        condKind = coreir.BodyCondLocalZeroTag
    PrimaryBodyIrAppendConditionTerm(bodyIR,
                                     resultSlot,
                                     condKind,
                                     currentBlockStart,
                                     pendingFalseTerm)
    return true

@borrows
fn PrimaryBodyIrParameterBindingDefinitionRowExact(
        typedIr: texpr.TypedExprIr,
        typedFn: texpr.TypedExprIrFunction,
        parameterOrdinal: int32): int32 =
    return texpr.TypedExprIrParameterValueDefinitionRowExact(
        typedIr, typedFn, parameterOrdinal)

@borrows
fn PrimaryBodyIrSeedParamSlots(bodyIR: var coreir.BodyIR,
                                bindingProjection:
                                    var coreir.BodyIRLocalBindingValueDefinitionProjection,
                                slotNames: var str[],
                                typedIr: texpr.TypedExprIr,
                                typedFn: texpr.TypedExprIrFunction,
                                irFunction: lower.PrimaryObjectIrFunction) =
    PrimaryBodyIrSetCurrentShiftContext(typedFn, irFunction)
    var seededCount: int32
    let traceEnabled = PrimaryObjectPlanTraceActive()
    if traceEnabled:
        PrimaryObjectPlanTrace(Fmt"phase=seed_params_begin function={typedFn.functionName} ir_param_names={irFunction.paramNames.len} ir_param_types={irFunction.paramTypes.len} node_start={typedFn.nodeStart} node_count={typedFn.nodeCount}")
    for paramIndex in 0..<irFunction.paramNames.len:
        if paramIndex >= irFunction.paramTypes.len:
            return
        let paramName = irFunction.paramNames[paramIndex]
        if len(paramName) <= 0:
            continue
        let paramType = PrimaryBodyIrStableTypeText(irFunction.paramTypes[paramIndex])
        if paramType == "":
            continue
        let slotId = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                        slotNames,
                                                        typedIr,
                                                        irFunction.sourcePath,
                                                        paramName,
                                                        paramType)
        let parameterDefinitionRow =
            PrimaryBodyIrParameterBindingDefinitionRowExact(
                typedIr, typedFn, paramIndex)
        PrimaryBodyIrBindLocalSlotValueDefinitionExact(
            bodyIR,
            bindingProjection,
            typedIr,
            slotId,
            parameterDefinitionRow,
            texpr.TypedExprValueDefinitionOriginParameter)
        PrimaryBodyIrMarkParamSlot(bodyIR, slotId, paramIndex)
        coreir.BodyIRBindEntryParameterSlot(
            bodyIR, paramIndex, slotId)
        PrimaryBodyIrMarkVarPointeeKind(bodyIR, typedIr, irFunction.sourcePath, slotId, paramType)
        PrimaryBodyIrMarkParamAbiSize(bodyIR, slotId, paramType)
        seededCount = seededCount + 1
        if traceEnabled:
            PrimaryObjectPlanTrace(Fmt"phase=seed_params_ir function={typedFn.functionName} slot={slotId} param={paramName} type={paramType} index={paramIndex}")
    if seededCount > 0:
        return
    var nodeEnd = typedFn.nodeStart + typedFn.nodeCount
    if nodeEnd > typedIr.nodes2_nodeIndexs.len:
        nodeEnd = typedIr.nodes2_nodeIndexs.len
    for nodeIndex in typedFn.nodeStart..<nodeEnd:
        if typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpParamRef:
            continue
        let spPnRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_paramNameIds[nodeIndex])
        let spRtRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_resultTypeIds[nodeIndex])
        if !IsOk(spPnRes) || !IsOk(spRtRes):
            continue
        let spParamName = Value(spPnRes)
        let spResultType = Value(spRtRes)
        if arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_paramSlots, nodeIndex) < 0 || spParamName == "":
            continue
        let nodeParamType = PrimaryBodyIrStableTypeText(spResultType)
        if nodeParamType == "":
            continue
        let slotId = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                        slotNames,
                                                        typedIr,
                                                        typedFn.sourcePath,
                                                        spParamName,
                                                        nodeParamType)
        let exactParamOrdinal = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.nodes2_paramSlots, nodeIndex)
        let parameterDefinitionRow =
            PrimaryBodyIrParameterBindingDefinitionRowExact(
                typedIr, typedFn, exactParamOrdinal)
        PrimaryBodyIrBindLocalSlotValueDefinitionExact(
            bodyIR,
            bindingProjection,
            typedIr,
            slotId,
            parameterDefinitionRow,
            texpr.TypedExprValueDefinitionOriginParameter)
        PrimaryBodyIrMarkParamSlot(bodyIR, slotId, exactParamOrdinal)
        coreir.BodyIRBindEntryParameterSlot(
            bodyIR, exactParamOrdinal, slotId)
        PrimaryBodyIrMarkVarPointeeKind(bodyIR, typedIr, typedFn.sourcePath, slotId, nodeParamType)
        PrimaryBodyIrMarkParamAbiSize(bodyIR, slotId, nodeParamType)
        if traceEnabled:
            PrimaryObjectPlanTrace(Fmt"phase=seed_params_typed function={typedFn.functionName} slot={slotId} param={spParamName} type={nodeParamType} index={arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_paramSlots, nodeIndex)}")

@borrows
fn PrimaryBodyIrCollectVarI32ParamNames(typedIr: texpr.TypedExprIr,
                                          typedFn: texpr.TypedExprIrFunction,
                                          irFunction: lower.PrimaryObjectIrFunction): str[] =
    var out: str[]
    out = []
    for paramIndex in 0..<irFunction.paramNames.len:
        if paramIndex >= irFunction.paramTypes.len:
            return out
        if PrimaryBodyIrTypeTextIsVarI32(irFunction.paramTypes[paramIndex]):
            add(out, strings.CloneStr(irFunction.paramNames[paramIndex]))
    var nodeEnd = typedFn.nodeStart + typedFn.nodeCount
    if nodeEnd > typedIr.nodes2_nodeIndexs.len:
        nodeEnd = typedIr.nodes2_nodeIndexs.len
    for nodeIndex in typedFn.nodeStart..<nodeEnd:
        if typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpParamRef:
            continue
        let cvPnRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_paramNameIds[nodeIndex])
        let cvRtRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_resultTypeIds[nodeIndex])
        if !IsOk(cvPnRes) || !IsOk(cvRtRes):
            continue
        let cvParamName = Value(cvPnRes)
        let cvResultType = Value(cvRtRes)
        if cvParamName == "" || !PrimaryBodyIrTypeTextIsVarI32(cvResultType):
            continue
        if !PrimaryBodyIrNameInList(out, cvParamName):
            add(out, strings.CloneStr(cvParamName))
    return out

@borrows
fn PrimaryBodyIrCollectVarI32ParamNamesFromIrFunction(irFunction: lower.PrimaryObjectIrFunction): str[] =
    var out: str[]
    for i in 0..<irFunction.paramNames.len:
        if i >= irFunction.paramTypes.len:
            continue
        if irFunction.paramNames[i] == "" ||
           !PrimaryBodyIrTypeTextIsVarI32(irFunction.paramTypes[i]):
            continue
        if !PrimaryBodyIrNameInList(out, irFunction.paramNames[i]):
            let ownedParamName = parser.ParserOwnedText(irFunction.paramNames[i])
            add(out, ownedParamName)
    return out

@borrows
fn PrimaryBodyIrCallArgNames(callArgsText: str): str[] =
    var out: str[]
    let pieces = texpr.TypedExprSplitTopLevelCsv(callArgsText)
    for i in 0..<pieces.len:
        let name = strutil.Strip(pieces[i])
        if len(name) > 0:
            add(out, name)
    return out

@borrows
fn PrimaryBodyIrTargetFunctionIndex(typedIr: texpr.TypedExprIr,
                                     sourcePath: str,
                                     functionName: str): int32 =
    # P2 atomic thin wrapper: existing 22+ callers don't care about resolution
    # kind detail (they're surface predicates: index >= 0 ↔ visible). Sites
    # :11059 / :11102 (the 2 path-decision consumers identified in the design)
    # call PrimaryBodyIrTargetFunctionIndexWithKind directly.
    var kindDiscard: texpr.CallTargetResolutionKind
    kindDiscard = texpr.CallTargetUnresolved
    return PrimaryBodyIrTargetFunctionIndexWithKind(typedIr,
                                                    sourcePath,
                                                    functionName,
                                                    kindDiscard)

@borrows
fn PrimaryBodyIrTargetFunctionIndexAtLine(
        typedIr: texpr.TypedExprIr,
        sourcePathRaw: str,
        functionNameRaw: str,
        signatureLineNumber: int32): int32 =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let functionName = strutil.Strip(functionNameRaw)
    let tailName = PrimaryCallTargetTailName(functionName)
    if sourcePath == "" || functionName == "" ||
       signatureLineNumber <= 0:
        return -1
    var foundIndex: int32 = -1
    for fnIndex in 0..<typedIr.functions2_functionNameIds.len:
        let sourceRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool, typedIr.functions2_sourcePathIds[fnIndex])
        let nameRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool, typedIr.functions2_functionNameIds[fnIndex])
        if !IsOk(sourceRes) || !IsOk(nameRes) ||
           parser.ParserNormalizePath(Value(sourceRes)) != sourcePath ||
           (Value(nameRes) != functionName && Value(nameRes) != tailName) ||
           arenamod.ArenaArrayInt32Get(
               typedIr.arena,
               typedIr.functions2_signatureLineNumbers,
               fnIndex) != signatureLineNumber:
            continue
        if foundIndex >= 0:
            return -1
        foundIndex = fnIndex
    return foundIndex

@borrows
fn PrimaryBodyIrTargetFunctionIndexWithKind(typedIr: texpr.TypedExprIr,
                                             sourcePath: str,
                                             functionName: str,
                                             kindOut: var texpr.CallTargetResolutionKind): int32 =
    # P2 atomic producer (sealed 10-case CallTargetResolutionKind):
    # init out kind, then assign at each return path so consumers never have
    # to reverse-guess "missing vs ambiguous" from foundQualifiedAnySource
    # {-1/-2/>=0} × PrimaryFunctionTargetCountAnySource {0/1/>=2} 6-state旁路.
    kindOut = texpr.CallTargetUnresolved
    PrimaryBodyIrPrepareFunctionLookupCache(typedIr)
    let tailName = PrimaryCallTargetTailName(functionName)
    let qualifier = texpr.TypedExprQualifiedCallQualifier(functionName)
    # P2 atomic producer site #9 (TailLeafSplitFail): targetText contains '.' or
    # '::' but the split silently fell back to the full string (PrimaryCallTargetTailName
    # at :1260-1271 returns functionName unchanged when tailStart >= len(targetText)).
    # Detect at producer entry so consumer reads kind and early-bails before any
    # tail consumer (3541/3565/19267/19619 + lowering_plan:1398) uses the wrong leaf.
    if tailName == functionName && len(functionName) > 0:
        var hasDot = false
        for i in 0..<len(functionName):
            if functionName[i] == '.':
                hasDot = true
        if !hasDot && len(functionName) >= 2:
            for j in 0..<(len(functionName) - 1):
                if functionName[j] == ':' && functionName[j + 1] == ':':
                    hasDot = true
        if hasDot:
            # Trailing separator (e.g. "Err[layout.FixedBytes32]") collapsed
            # tailStart back to 0 — the silent path of design CallTargetTailLeafSplitFail.
            kindOut = texpr.CallTargetTailLeafSplitFail
            return -1
    # The caller must supply the declaration owner selected by TypedExpr. A
    # source-agnostic lookup is not a visibility rule: it can bind a private
    # declaration or a same-named function in an unrelated module merely because
    # that declaration happens to be globally unique in this compilation unit.
    if sourcePath == "" || tailName == "":
        kindOut = texpr.CallTargetMissing
        return -1
    PrimaryBodyIrPrepareFunctionLookupCache(typedIr)
    let exactSourceIndex = PrimaryBodyIrFunctionLookupSourcePathIndex(sourcePath)
    if exactSourceIndex < 0:
        kindOut = texpr.CallTargetMissing
        return -1
    let exactTailBucket = PrimaryObjectIrFunctionIndexHash(
        tailName, primaryBodyIrFunctionTailBucketHeads.len)
    if exactTailBucket < 0:
        kindOut = texpr.CallTargetMissing
        return -1
    var exactEntryIndex = primaryBodyIrFunctionTailBucketHeads[exactTailBucket]
    var exactMatchIndex: int32 = -1
    var exactMatchCount: int32
    while exactEntryIndex >= 0:
        if primaryBodyIrFunctionTailEntryTails[exactEntryIndex] == tailName:
            let exactCandidateIndex =
                primaryBodyIrFunctionTailEntryFnIndexes[exactEntryIndex]
            if exactCandidateIndex >= 0 &&
               exactCandidateIndex < primaryBodyIrFunctionSourceIndexes.len &&
               primaryBodyIrFunctionSourceIndexes[exactCandidateIndex] ==
                   exactSourceIndex:
                let exactNameRes: Result[str] = langintern.LookupIntern(
                    typedIr.internPool,
                    typedIr.functions2_functionNameIds[exactCandidateIndex])
                if !IsOk(exactNameRes):
                    panic("primary: corrupt typed function name row")
                let exactCandidateName = Value(exactNameRes)
                let exactCandidateTail =
                    PrimaryCallTargetTailName(exactCandidateName)
                if exactCandidateName == functionName ||
                   exactCandidateTail == functionName ||
                   exactCandidateTail == tailName:
                    exactMatchCount = exactMatchCount + 1
                    if exactMatchIndex < 0 ||
                       exactCandidateIndex < exactMatchIndex:
                        exactMatchIndex = exactCandidateIndex
        exactEntryIndex =
            primaryBodyIrFunctionTailEntryNext[exactEntryIndex]
    if exactMatchCount == 0:
        kindOut = texpr.CallTargetMissing
        return -1
    if exactMatchCount == 1:
        kindOut = texpr.CallTargetSameSourceUnique
    else:
        kindOut = texpr.CallTargetSameSourceAmbiguous
    return exactMatchIndex

@borrows
fn PrimaryBodyIrVisibleFunctionIndex(typedIr: texpr.TypedExprIr,
                                      sourcePath: str,
                                      functionName: str): int32 =
    if sourcePath == "" || functionName == "":
        return -1
    let qualifier = texpr.TypedExprQualifiedCallQualifier(functionName)
    if qualifier != "":
        let leaf = texpr.TypedExprQualifiedCallLeaf(functionName)
        if leaf == "" ||
           !texpr.TypedExprTopLevelDeclarationExportedByCase(leaf):
            return -1
        let targetSourcePath = PrimaryBodyIrCanonicalImportTargetSourcePath(
            typedIr, sourcePath, qualifier)
        if targetSourcePath == "":
            return -1
        return PrimaryBodyIrTargetFunctionIndex(typedIr,
                                                targetSourcePath,
                                                leaf)
    let localIndex = PrimaryBodyIrTargetFunctionIndex(typedIr,
                                                      sourcePath,
                                                      functionName)
    if localIndex >= 0:
        return localIndex
    # Only ASCII-uppercase declarations are visible through a direct import.
    if !texpr.TypedExprTopLevelDeclarationExportedByCase(functionName):
        return -1
    var foundIndex: int32
    foundIndex = -1
    for i in 0..<typedIr.typeAliasSourcePaths.len:
        if i >= typedIr.typeAliasTargetSourcePaths.len:
            continue
        if !PrimaryPathNormalizedEquals(typedIr.typeAliasSourcePaths[i], sourcePath):
            continue
        let targetIndex = PrimaryBodyIrTargetFunctionIndex(typedIr,
                                                           typedIr.typeAliasTargetSourcePaths[i],
                                                           functionName)
        if targetIndex < 0:
            continue
        if foundIndex >= 0 && foundIndex != targetIndex:
            return -1
        foundIndex = targetIndex
    return foundIndex

@borrows
fn PrimaryBodyIrCallResultLayoutSourcePath(stmt: lower.PrimaryObjectIrStatement): str =
    if stmt.callTargetSourcePath == "":
        panic("primary object: call result target source path missing")
    return stmt.callTargetSourcePath

@borrows
fn PrimaryBodyIrResolvedCallResultType(typedIr: texpr.TypedExprIr,
                                        stmt: lower.PrimaryObjectIrStatement): str =
    # TypedExpr seals the statement result type together with the exact call
    # owner. Re-scanning same-named functions here would silently replace that
    # authority with compilation-unit order. Importc metadata is the only
    # declaration-side override, and is queried only through its exact owner.
    if stmt.callTargetImportc && stmt.callTargetSourcePath != "":
        let importcResultType = texpr.TypedExprIrLookupImportcReturnType(
            typedIr, stmt.callTargetSourcePath, stmt.callTarget)
        if importcResultType != "":
            return importcResultType
    return stmt.resultType

@borrows
fn PrimaryBodyIrUniqueTypedFunctionIndex(typedIr: texpr.TypedExprIr,
                                          sourcePath: str,
                                          functionName: str): int32 =
    if sourcePath == "" || functionName == "" ||
       typedIr.internPool == nil:
        return -1
    let tailName = PrimaryFunctionTailName(functionName)
    var found: int32 = -1
    for fnIndex in 0..<typedIr.functions2_functionNameIds.len:
        let sourceRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool, typedIr.functions2_sourcePathIds[fnIndex])
        let nameRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool, typedIr.functions2_functionNameIds[fnIndex])
        if !IsOk(sourceRes) || !IsOk(nameRes):
            continue
        if !PrimaryPathNormalizedEquals(Value(sourceRes), sourcePath):
            continue
        let observedName = Value(nameRes)
        if observedName != functionName && observedName != tailName:
            continue
        if found >= 0:
            return -1
        found = fnIndex
    return found

@borrows
fn PrimaryBodyIrTypedParamTypeAt(lowering: var lower.LoweringPlanStub,
                                  sourcePath: str,
                                  functionName: str,
                                  argIndex: int32): str =
    if sourcePath == "" || functionName == "" || argIndex < 0:
        return ""
    let typedFnIndex = PrimaryBodyIrUniqueTypedFunctionIndex(
        lowering.typedIr, sourcePath, functionName)
    if typedFnIndex < 0 ||
       typedFnIndex >= lowering.typedIr.functions2_functionNameIds.len:
        return ""
    let nodeStart = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.functions2_nodeStarts,
        typedFnIndex)
    let nodeCount = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.functions2_nodeCounts,
        typedFnIndex)
    if nodeStart < 0 || nodeCount < 0 ||
       nodeStart > lowering.typedIr.nodes2_nodeIndexs.len ||
       nodeCount > lowering.typedIr.nodes2_nodeIndexs.len - nodeStart:
        return ""
    for nodeIndex in nodeStart..<(nodeStart + nodeCount):
        if lowering.typedIr.nodes2_opKinds[nodeIndex] !=
               texpr.TypedExprIrOpParamRef:
            continue
        if arenamod.ArenaArrayInt32Get(
               lowering.typedIr.arena,
               lowering.typedIr.nodes2_paramSlots,
               nodeIndex) != argIndex:
            continue
        let paramTypeRes: Result[str] = langintern.LookupIntern(
            lowering.typedIr.internPool,
            lowering.typedIr.nodes2_resultTypeIds[nodeIndex])
        if !IsOk(paramTypeRes):
            return ""
        return texpr.TypedExprNormalizeTypeText(Value(paramTypeRes))
    return ""

# [wall131] callee 形参 var 性的结构化权威：遍历 callee TypedExpr 函数体的
# ParamRef 声明节点 (paramSlots==argIndex)，读 nodes2_paramMutableFlags。
# 列语义经两处既有权威互证：TypedExpr 绑定校验「non-parameter mutable
# authority」（仅 ParamRef 可 true）与 primary 参数借主臂（Owned=不可变托管
# 形参 / Borrowed=var 形参自根，:17947 消费先例）。返回 1=var 形参，
# 0=非 var 形参，-1=callee 无 TypedExpr 权威（调用方走文本 fallback）。
# 文本权威 (paramTypes/ResolvedTargetParamType) 实测丢 var 前缀 (r2 trace
# owns=2,2 实证)，不得作为 var 性第一权威。
@borrows
fn PrimaryBodyIrTypedParamMutableAt(lowering: var lower.LoweringPlanStub,
                                    sourcePath: str,
                                    functionName: str,
                                    argIndex: int32): int32 =
    if sourcePath == "" || functionName == "" || argIndex < 0:
        return -1
    let typedFnIndex = PrimaryBodyIrUniqueTypedFunctionIndex(
        lowering.typedIr, sourcePath, functionName)
    if typedFnIndex < 0 ||
       typedFnIndex >= lowering.typedIr.functions2_functionNameIds.len:
        return -1
    let nodeStart = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.functions2_nodeStarts,
        typedFnIndex)
    let nodeCount = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.functions2_nodeCounts,
        typedFnIndex)
    if nodeStart < 0 || nodeCount < 0 ||
       nodeStart > lowering.typedIr.nodes2_nodeIndexs.len ||
       nodeCount > lowering.typedIr.nodes2_nodeIndexs.len - nodeStart:
        return -1
    for nodeIndex in nodeStart..<(nodeStart + nodeCount):
        if lowering.typedIr.nodes2_opKinds[nodeIndex] !=
               texpr.TypedExprIrOpParamRef:
            continue
        if arenamod.ArenaArrayInt32Get(
               lowering.typedIr.arena,
               lowering.typedIr.nodes2_paramSlots,
               nodeIndex) != argIndex:
            continue
        if lowering.typedIr.nodes2_paramMutableFlags[nodeIndex]:
            return 1
        return 0
    return -1

@borrows
fn PrimaryBodyIrTargetParamType(lowering: var lower.LoweringPlanStub,
                                 stmt: lower.PrimaryObjectIrStatement,
                                 argIndex: int32,
                                 callerTag: str,
                                 callerOrdinal: int32,
                                 nodeSourcePath: str,
                                 nodeTargetName: str,
                                 nodeSignatureLine: int32,
                                 diagText: str): str =
    if stmt.callTargetImportc || argIndex < 0:
        return ""
    if stmt.callTargetSourcePath == "" || stmt.callTarget == "" ||
       stmt.callTargetSignatureLineNumber <= 0:
        # wall66 判词富化：caller 路由标签 + ordinal + 节点权威三值 + stmt
        # 上下文 + r2 三方对质串（列直读/权威/等价性/重读稳定性）。
        # 仅判词字符串扩展，通过/失败边界逐字节不变（wall40/45/47 先例）。
        let panicMsg = Fmt"primary object: call target declaration identity missing caller={callerTag} ordinal={callerOrdinal} target_source={stmt.callTargetSourcePath} target={stmt.callTarget} target_signature_line={stmt.callTargetSignatureLineNumber} node_source={nodeSourcePath} node_target={nodeTargetName} node_signature={nodeSignatureLine} stmt_source={stmt.sourcePath} stmt_line={stmt.lineNumber} importc={stmt.callTargetImportc} diag={diagText}"
        panic(panicMsg)
    var fnIndex = PrimaryObjectIrFunctionIndexAtLine(
        lowering.primaryObjectIr,
        stmt.callTargetSourcePath,
        stmt.callTarget,
        stmt.callTargetSignatureLineNumber)
    if fnIndex < 0:
        fnIndex = PrimaryObjectIrFunctionIndexUnique(
            lowering.primaryObjectIr,
            stmt.callTargetSourcePath,
            stmt.callTarget)
    if fnIndex >= 0 && fnIndex < lowering.primaryObjectIr.functions.len:
        let targetFn = lowering.primaryObjectIr.functions[fnIndex]
        if argIndex >= targetFn.paramTypes.len:
            let panicMsg = Fmt"primary object: call argument exceeds exact target ABI target={stmt.callTarget} target_signature_line={stmt.callTargetSignatureLineNumber} arg_index={argIndex} param_count={targetFn.paramTypes.len}"
            panic(panicMsg)
        return targetFn.paramTypes[argIndex]
    let typedParamType = PrimaryBodyIrTypedParamTypeAt(
        lowering,
        stmt.callTargetSourcePath,
        stmt.callTarget,
        argIndex)
    if typedParamType != "":
        return typedParamType
    let panicMsg = Fmt"primary object: exact call target declaration missing or ambiguous target_source={stmt.callTargetSourcePath} target={stmt.callTarget} target_signature_line={stmt.callTargetSignatureLineNumber}"
    panic(panicMsg)
    return ""

@borrows
fn PrimaryBodyIrCallArgTypeAt(stmt: lower.PrimaryObjectIrStatement,
                               argIndex: int32): str =
    if argIndex < 0 || stmt.callArgTypesText == "":
        return ""
    let argTypes = texpr.TypedExprSplitTopLevelCsv(stmt.callArgTypesText)
    if argIndex >= argTypes.len:
        return ""
    return texpr.TypedExprNormalizeTypeText(strutil.Strip(argTypes[argIndex]))

@borrows
fn PrimaryBodyIrSourcePathIsStdSystem(sourcePathRaw: str): bool =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let suffix = "/src/std/system.cheng"
    if len(sourcePath) < len(suffix):
        return false
    return strings.SliceBytes(sourcePath,
                              len(sourcePath) - len(suffix),
                              len(suffix)) == suffix

@borrows
fn PrimaryBodyIrInternalSlotTextCode(text: str): str =
    var parts: str[]
    for i in 0..<len(text):
        add(parts, strings.IntToStr(int32(text[i])))
    if parts.len <= 0:
        return "0"
    return strutil.Join(parts, "_")

@borrows
fn PrimaryBodyIrCallIsStdSystemLoad(lowering: var lower.LoweringPlanStub,
                                     sourcePath: str,
                                     lineNumber: int32,
                                     callHead: str,
                                     callArgsText: str): bool =
    let callQualifier = texpr.TypedExprQualifiedCallQualifier(callHead)
    let callLeaf = texpr.TypedExprQualifiedCallLeaf(callHead)
    if callLeaf != "load" || PrimaryBodyIrCallArgNames(callArgsText).len != 1:
        return false
    let factIndex = lower.LoweringFindResolvedCallFactExact(lowering,
                                                             strings.CloneStr(sourcePath),
                                                             lineNumber,
                                                             strings.CloneStr(callQualifier),
                                                             strings.CloneStr(callLeaf),
                                                             1,
                                                             strings.CloneStr(callArgsText))
    if factIndex < 0:
        return false
    let fact = lower.LoweringResolvedCallSnapshotFactAt(lowering, factIndex)
    if fact.callTargetImportc ||
       PrimaryCallTargetTailName(fact.callTarget) != "load" ||
       !PrimaryBodyIrSourcePathIsStdSystem(fact.callTargetSourcePath):
        return false
    return true

@borrows
fn PrimaryBodyIrStdSystemLoadNodeTypeContract(typedIr: texpr.TypedExprIr,
                                               nodeIndex: int32,
                                               targetKindOut: var int32,
                                               loadKindOut: var int32,
                                               loadSizeOut: var int32): bool =
    targetKindOut = coreir.LocalInvalidTag
    loadKindOut = 0
    loadSizeOut = 0
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        return false
    let headRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                       typedIr.nodes2_literalTextIds[nodeIndex])
    if !IsOk(headRes) ||
       texpr.TypedExprQualifiedCallLeaf(Value(headRes)) != "load":
        return false
    let resultType = texpr.TypedExprNormalizeTypeText(
        texpr.TypedExprStripVarType(PrimaryBodyIrNodeResultTypeText(typedIr,
                                                                   nodeIndex)))
    if resultType == "uint8" || resultType == "u8" || resultType == "UInt8":
        targetKindOut = coreir.LocalI32Tag
        loadKindOut = coreir.BodyLoadLocalPtrDerefU8Tag
        loadSizeOut = 1
        return true
    if resultType == "int32" || resultType == "i32" || resultType == "Int32" ||
       resultType == "int" || resultType == "uint32" || resultType == "u32" ||
       resultType == "UInt32" || resultType == "uint":
        targetKindOut = coreir.LocalI32Tag
        loadKindOut = coreir.BodyLoadLocalPtrDerefI32Tag
        loadSizeOut = 4
        return true
    if resultType == "int64" || resultType == "i64" || resultType == "Int64" ||
       resultType == "uint64" || resultType == "u64" || resultType == "UInt64":
        targetKindOut = coreir.LocalI64Tag
        loadKindOut = coreir.BodyLoadLocalPtrDerefU64Tag
        loadSizeOut = 8
        return true
    return false

@borrows
fn PrimaryBodyIrStdSystemLoadArgNodeIndex(typedIr: texpr.TypedExprIr,
                                           nodeIndex: int32): int32 =
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        return -1
    let linkIndex = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                typedIr.nodes2_operand0NodeIndexs,
                                                nodeIndex)
    if linkIndex < 0 || linkIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[linkIndex] != texpr.TypedExprIrOpArgLink ||
       arenamod.ArenaArrayInt32Get(typedIr.arena,
                                   typedIr.nodes2_operand1NodeIndexs,
                                   linkIndex) >= 0:
        return -1
    return arenamod.ArenaArrayInt32Get(typedIr.arena,
                                       typedIr.nodes2_operand0NodeIndexs,
                                       linkIndex)

@borrows
fn PrimaryBodyIrCallExprIsStdSystemLoad(lowering: var lower.LoweringPlanStub,
                                         nodeIndex: int32): bool =
    if nodeIndex < 0 || nodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
       lowering.typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        return false
    let sourceRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool,
                                                         lowering.typedIr.nodes2_sourcePathIds[nodeIndex])
    let surfaceRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool,
                                                          lowering.typedIr.nodes2_surfaceTextIds[nodeIndex])
    if !IsOk(sourceRes) || !IsOk(surfaceRes):
        return false
    let surfaceText: str = Value(surfaceRes)
    let openPos = texpr.TypedExprFindWholeCallOpenParen(surfaceText)
    if openPos <= 0:
        return false
    let closePos = texpr.TypedExprFindMatchingParen(surfaceText, openPos)
    if closePos <= openPos || closePos + 1 != surfaceText.len:
        return false
    let callHead = strutil.Strip(strings.SliceBytes(surfaceText, 0, openPos))
    let callArgsText = strutil.Strip(strings.SliceBytes(surfaceText,
                                                        openPos + 1,
                                                        closePos - openPos - 1))
    return PrimaryBodyIrCallIsStdSystemLoad(lowering,
                                             Value(sourceRes),
                                             arenamod.ArenaArrayInt32Get(lowering.typedIr.arena,
                                                                         lowering.typedIr.nodes2_lineNumbers,
                                                                         nodeIndex),
                                             callHead,
                                             callArgsText)

@borrows
fn PrimaryBodyIrAppendStdSystemLoadNodeValue(bodyIR: var coreir.BodyIR,
                                              slotNames: var str[],
                                              varI32ParamNames: str[],
                                              lowering: var lower.LoweringPlanStub,
                                              typedFn: texpr.TypedExprIrFunction,
                                              irFunction: lower.PrimaryObjectIrFunction,
                                              nodeIndex: int32,
                                              targetSlot: int32,
                                              callOrdinal: var int32): bool =
    if !PrimaryBodyIrCallExprIsStdSystemLoad(lowering,  nodeIndex) ||
       targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        return false
    var targetKind: int32
    var loadKind: int32
    var loadSize: int32
    if !PrimaryBodyIrStdSystemLoadNodeTypeContract(lowering.typedIr,
                                                   nodeIndex,
                                                   targetKind,
                                                   loadKind,
                                                   loadSize) ||
       PrimaryBodyIrSlotType(bodyIR, targetSlot) != targetKind:
        return false
    let argNodeIndex = PrimaryBodyIrStdSystemLoadArgNodeIndex(lowering.typedIr, nodeIndex)
    if argNodeIndex < 0 ||
       PrimaryBodyIrNodeEvalProbe(bodyIR,
                                  slotNames,
                                  varI32ParamNames,
                                  lowering,

                                  share(typedFn),
                                  irFunction,
                                  argNodeIndex) != coreir.LocalPtrTag:
        return false
    let pointerSlot = PrimaryBodyIrEvalNode(bodyIR,
                                            slotNames,
                                            varI32ParamNames,
                                            lowering,

                                            typedFn,
                                            irFunction,
                                            argNodeIndex,
                                            callOrdinal)
    if pointerSlot < 0 || pointerSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, pointerSlot) != coreir.LocalPtrTag:
        return false
    var loadOp: coreir.BodyOp
    loadOp.kind = coreir.BodyOpLoadLocalTag
    loadOp.target = targetSlot
    add(loadOp.operands, loadKind)
    add(loadOp.operands, pointerSlot)
    add(loadOp.operands, loadSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, loadOp)
    return true

@borrows
fn PrimaryBodyIrStatementIsStdAssertBridgeCall(stmt: lower.PrimaryObjectIrStatement): bool =
    let targetTail = PrimaryCallTargetTailName(stmt.callTarget)
    if targetTail != "assert" && targetTail != "Assert":
        return false
    if stmt.callTargetImportc || stmt.callArgCount != 2:
        return false
    if stmt.callKind != texpr.TypedExprCallBuiltin &&
       stmt.callTargetSourcePath != "" &&
       !PrimaryBodyIrSourcePathIsStdSystem(stmt.callTargetSourcePath):
        return false
    let arg0Type = PrimaryBodyIrCallArgTypeAt(stmt, 0)
    let arg1Type = PrimaryBodyIrCallArgTypeAt(stmt, 1)
    if arg0Type != "" || arg1Type != "":
        return arg0Type == "bool" && arg1Type == "str"
    let args = PrimaryBodyIrCallArgNames(stmt.callArgsText)
    if args.len != 2:
        return false
    if PrimaryBodyIrTextIsStringLiteral(args[0]):
        return false
    if !PrimaryBodyIrTextIsStringLiteral(args[1]):
        return false
    return true

@borrows
fn PrimaryBodyIrDirectExternalParamType(symbolRaw: str,
                                         argIndex: int32): str =
    if argIndex < 0:
        return ""
    let symbol = PrimaryCallTargetTailName(symbolRaw)
    if symbol == "__cheng_runtime_ptr_slot_load_raw" ||
       symbol == "___cheng_runtime_ptr_slot_load_raw" ||
       symbol == "cheng_runtime_ptr_slot_load_raw_intrinsic":
        if argIndex == 0:
            return "uint64"
        if argIndex == 1:
            return "int32"
        return ""
    if symbol == "__cheng_runtime_ptr_slot_store_raw" ||
       symbol == "___cheng_runtime_ptr_slot_store_raw" ||
       symbol == "cheng_runtime_ptr_slot_store_raw_intrinsic":
        if argIndex == 0:
            return "uint64"
        if argIndex == 1:
            return "int32"
        if argIndex == 2:
            return "uint64"
        return ""
    if symbol == "copyMem":
        if argIndex == 0 || argIndex == 1:
            return "ptr"
        if argIndex == 2:
            return "int32"
        return ""
    if symbol == "setMem":
        if argIndex == 0:
            return "ptr"
        if argIndex == 1 || argIndex == 2:
            return "int32"
        return ""
    if symbol == "ptr_add":
        if argIndex == 0:
            return "ptr"
        if argIndex == 1:
            return "int32"
        return ""
    if symbol == "cheng_rawmem_write_i8":
        if argIndex == 0:
            return "ptr"
        if argIndex == 1:
            return "int32"
        if argIndex == 2:
            return "int8"
        return ""
    if symbol == "cheng_rawmem_write_char":
        if argIndex == 0:
            return "ptr"
        if argIndex == 1:
            return "int32"
        if argIndex == 2:
            return "char"
        return ""
    if symbol == "cheng_seq_set_grow":
        if argIndex == 0:
            return "ptr"
        if argIndex == 1 || argIndex == 2:
            return "int32"
        return ""
    if symbol == "cheng_seq_set_len":
        if argIndex == 0:
            return "ptr"
        if argIndex == 1 || argIndex == 2:
            return "int32"
        return ""
    if symbol == "cheng_seq_drop_str_field_tail":
        if argIndex == 0:
            return "ptr"
        if argIndex == 1 || argIndex == 2 || argIndex == 3:
            return "int32"
        return ""
    if symbol == "cheng_seq_str_add" ||
       symbol == "cheng_str_store_managed" ||
       symbol == "cheng_seq_store_plain_managed" ||
       symbol == "cheng_str_move_store_managed" ||
       symbol == "cheng_seq_move_store_plain_managed":
        if argIndex == 0 || argIndex == 1:
            return "ptr"
        return ""
    if symbol == "cheng_strformat_fmt_bridge" ||
       symbol == "cheng_strformat_lines_bridge":
        if argIndex == 0:
            return "ptr"
        return ""
    if symbol == "cheng_strutils_join_bridge":
        if argIndex == 0 || argIndex == 1:
            return "ptr"
        return ""
    if symbol == "cheng_seq_header_len_get" ||
       symbol == "cheng_seq_header_buffer_get":
        if argIndex == 0:
            return "ptr"
        return ""
    if symbol == "cheng_seq_header_len_set":
        if argIndex == 0:
            return "ptr"
        if argIndex == 1:
            return "int32"
        return ""
    if symbol == "driver_c_str_from_utf8_copy_bridge":
        if argIndex == 0:
            return "ptr"
        if argIndex == 1:
            return "int32"
        return ""
    if symbol == "driver_c_str_alloc_bridge":
        if argIndex == 0:
            return "int32"
        return ""
    if symbol == "driver_c_new_string":
        if argIndex == 0:
            return "int32"
        return ""
    if symbol == "driver_c_new_string_copy_n":
        if argIndex == 0:
            return "ptr"
        if argIndex == 1:
            return "int32"
        return ""
    if symbol == "cheng_str_to_cstring_temp_bridge":
        if argIndex == 0:
            return "ptr"
        return ""
    if symbol == "__cheng_call_indirect_sret_agg1":
        if argIndex == 0:
            return "ptr"
        if argIndex == 1:
            return "ptr"
        return ""
    if symbol == "__cheng_call_indirect_void":
        if argIndex == 0:
            return "ptr"
        if argIndex == 1:
            return "ptr"
        return ""
    if symbol == "cheng_cstrlen":
        if argIndex == 0:
            return "ptr"
        return ""
    if symbol == "puts" || symbol == "echo" || symbol == "Echo":
        if argIndex == 0:
            # echo/puts 的第 0 参真实声明型是 cstring（src/std/system.cheng:49
            # `importc fn puts(s: cstring)`），此前这里返给 "ptr" 丢失了
            # cstring 信号：下游 AppendCallArgs 对裸标识符实参（`echo(a)`,
            # a 为局部 str 值）就没有 str→cstring 隐式转换分支可命中，
            # 落回通用聚合按址回退，把 str 结构体自身栈地址当 char* 传
            # （driver str-echo miscompile 根因之一）。"ptr" 与 "cstring"
            # 在本文件所有既有消费点（ABI 宽度/scalar 指针分支）语义等价，
            # 改回真实声明型不改变既有行为，只补回丢失的转换信号。
            return "cstring"
        return ""
    return ""

@borrows
fn PrimaryBodyIrResolvedTargetParamType(lowering: var lower.LoweringPlanStub,
                                         stmt: lower.PrimaryObjectIrStatement,
                                         argIndex: int32,
                                         callerTag: str,
                                         callerOrdinal: int32): str =
    if argIndex < 0:
        return ""
    if PrimaryBodyIrStatementIsStdAssertBridgeCall(stmt):
        if argIndex == 0:
            return "bool"
        if argIndex == 1:
            return "str"
        return ""
    let importcSourcePath = stmt.callTargetSourcePath
    if importcSourcePath == "" || stmt.callTarget == "":
        return ""
    let importcJoin = texpr.TypedExprIrLookupImportcParamTypeJoin(lowering.typedIr,
                                                                   importcSourcePath,
                                                                   stmt.callTarget)
    if importcJoin != "":
        let importcParamTypes = texpr.TypedExprSplitParamTypeJoin(importcJoin)
        if argIndex < importcParamTypes.len:
            return importcParamTypes[argIndex]
    let directParamType = PrimaryBodyIrDirectExternalParamType(stmt.callTarget,
                                                              argIndex)
    if directParamType != "":
        return directParamType
    return PrimaryBodyIrTargetParamType(lowering, stmt, argIndex,
                                        callerTag, callerOrdinal,
                                        "", "", 0, "")

@borrows
fn PrimaryBodyIrTextIsPlainCallShape(typedIr: texpr.TypedExprIr,
                                      sourcePath: str,
                                      textRaw: str): bool =
    let text = strutil.Strip(textRaw)
    let openPos = texpr.TypedExprFindWholeCallOpenParen(text)
    if openPos <= 0:
        return false
    let closePos = texpr.TypedExprFindMatchingParen(text, openPos)
    if closePos <= openPos || closePos + 1 != len(text):
        return false
    let head = strutil.Strip(strings.SliceBytes(text, 0, openPos))
    return texpr.TypedExprCallHeadIsPlainQualifiedIdent(head)

@borrows
fn PrimaryBodyIrCallArgTextIsValueOrErrorIntrinsic(argName: str): bool =
    let text = strutil.Strip(argName)
    let openPos = texpr.TypedExprFindWholeCallOpenParen(text)
    if openPos <= 0:
        return false
    let closePos = texpr.TypedExprFindMatchingParen(text, openPos)
    if closePos <= openPos || closePos + 1 != len(text):
        return false
    let head = strutil.Strip(strings.SliceBytes(text, 0, openPos))
    let leaf = texpr.TypedExprQualifiedCallLeaf(head)
    return leaf == "Value" || leaf == "Error" || leaf == "IsOk" || leaf == "IsErr"

@borrows
fn PrimaryBodyIrTargetParamTypeIsAggregateOrStr(typedIr: texpr.TypedExprIr,
                                                 sourcePath: str,
                                                 typeRaw: str): bool =
    if typeRaw == "":
        return false
    var typeKind: int32
    var sizeBytes: int32
    var alignBytes: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   texpr.TypedExprStripVarType(typeRaw),
                                   typeKind,
                                   sizeBytes,
                                   alignBytes)
    return typeKind == coreir.LocalAggregateTag || typeKind == coreir.LocalStrTag

@borrows
fn PrimaryBodyIrAbiSizeFromTypedText(typedIr: texpr.TypedExprIr,
                                      sourcePath: str,
                                      typeRaw: str): int32 =
    let directSize = PrimaryAbiArgSizeFromTypeText(typeRaw)
    if directSize > 0:
        return directSize
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if normType == "" || PrimaryStartsWith(normType, "varargs"):
        return 0
    var typeKind: int32
    var sizeBytes: int32
    var alignBytes: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   normType,
                                   typeKind,
                                   sizeBytes,
                                   alignBytes)
    if sizeBytes <= 0 || alignBytes <= 0:
        return 0
    if typeKind == coreir.LocalI32Tag:
        return 4
    if typeKind == coreir.LocalF64Tag ||
       typeKind == coreir.LocalI64Tag ||
       typeKind == coreir.LocalPtrTag ||
       typeKind == coreir.LocalStrTag ||
       typeKind == coreir.LocalAggregateTag:
        return 8
    return 0

@borrows
fn PrimaryBodyIrVarargsElementType(typeRaw: str,
                                    elementTypeOut: var str): bool =
    elementTypeOut = ""
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if len(normType) <= 9 || !PrimaryStartsWith(normType, "varargs["):
        return false
    if texpr.TypedExprFindMatchingBracket(normType, 7) != len(normType) - 1:
        return false
    elementTypeOut = texpr.TypedExprNormalizeTypeText(
        strings.SliceBytes(normType, 8, len(normType) - 9))
    return elementTypeOut != ""

@borrows
fn PrimaryBodyIrAbiSizeFromCallSlot(call: coreir.CallOp,
                                     bodyIR: coreir.BodyIR,
                                     argIndex: int32): int32 =
    if argIndex < 0 || argIndex >= call.argSlots.len ||
       argIndex >= call.argPassKinds.len:
        return 0
    let passKind = call.argPassKinds[argIndex]
    if passKind == coreir.BodyCallPassParamAddressTag ||
       passKind == coreir.BodyCallPassBorrowAddressTag ||
       passKind == coreir.BodyCallPassByAddressAggregateTag ||
       passKind == coreir.BodyCallPassGlobalAddressTag ||
       passKind == coreir.BodyCallPassPtrNilTag:
        return 8
    if passKind != coreir.BodyCallPassStackValueTag:
        return 0
    let argSlot = call.argSlots[argIndex]
    if coreir.CallArgSlotIsCString(argSlot) ||
       coreir.CallArgSlotIsAddress(argSlot):
        return 8
    if coreir.CallArgSlotIsConst(argSlot) ||
       argSlot < 0 || argSlot >= bodyIR.localSlots.len:
        return 0
    let slot = bodyIR.localSlots[argSlot]
    if slot.typeKind == coreir.LocalI32Tag:
        if slot.auxValue == 1:
            return 1
        if slot.auxValue == 0:
            return 4
        return 0
    if slot.typeKind == coreir.LocalF64Tag ||
       slot.typeKind == coreir.LocalI64Tag ||
       slot.typeKind == coreir.LocalPtrTag ||
       slot.typeKind == coreir.LocalStrTag ||
       slot.typeKind == coreir.LocalAggregateTag:
        return 8
    return 0

# Synthetic bridge calls have no source-level signature lookup, so their ABI
# widths must still be derived from the same exact slot/pass-kind authority.
@borrows
fn PrimaryBodyIrFillPendingCallArgAbiSizes(call: var coreir.CallOp,
                                            bodyIR: coreir.BodyIR) =
    if call.argPassKinds.len != call.argSlots.len ||
       call.argAbiSizes.len > call.argSlots.len:
        panic("primary object: synthetic call ABI cardinality mismatch")
    while call.argAbiSizes.len < call.argSlots.len:
        let argIndex = call.argAbiSizes.len
        let abiSize = PrimaryBodyIrAbiSizeFromCallSlot(call, bodyIR, argIndex)
        if abiSize <= 0:
            panic("primary object: synthetic call ABI size unavailable")
        add(call.argAbiSizes, abiSize)

# Exact 1:1 ABI widths. A single final importc `varargs[T]` marker permits a
# tail; no unknown parameter or tail argument may widen to 8 by default.
@borrows
fn PrimaryBodyIrFillCallArgAbiSizes(call: var coreir.CallOp,
                                     bodyIR: coreir.BodyIR,
                                     lowering: var lower.LoweringPlanStub,
                                     stmt: lower.PrimaryObjectIrStatement) =
    if call.argPassKinds.len != call.argSlots.len ||
       call.argAbiSizes.len != 0:
        panic("primary object: call ABI cardinality mismatch")
    var importcParamTypes: str[]
    let importcSourcePath = stmt.callTargetSourcePath
    if importcSourcePath == "" || stmt.callTarget == "":
        panic("primary object: call ABI target owner missing")
    let importcJoin = texpr.TypedExprIrLookupImportcParamTypeJoin(lowering.typedIr,
                                                                   importcSourcePath,
                                                                   stmt.callTarget)
    if importcJoin != "":
        importcParamTypes = texpr.TypedExprSplitParamTypeJoin(importcJoin)
    var variadicParamIndex: int32 = -1
    var variadicElementType = ""
    for paramIndex in 0..<importcParamTypes.len:
        let normalizedParamType =
            texpr.TypedExprNormalizeTypeText(importcParamTypes[paramIndex])
        var candidateElementType = ""
        if PrimaryBodyIrVarargsElementType(normalizedParamType,
                                           candidateElementType):
            if !stmt.callTargetImportc ||
               variadicParamIndex >= 0 ||
               paramIndex != importcParamTypes.len - 1:
                panic("primary object: invalid call ABI variadic declaration")
            variadicParamIndex = paramIndex
            variadicElementType = candidateElementType
        elif normalizedParamType == "varargs" ||
             PrimaryStartsWith(normalizedParamType, "varargs["):
            panic("primary object: malformed call ABI variadic declaration")
    if importcParamTypes.len > 0:
        if variadicParamIndex >= 0:
            if call.argSlots.len < variadicParamIndex:
                panic("primary object: call argument count below exact ABI declaration")
        elif call.argSlots.len != importcParamTypes.len:
            panic("primary object: call argument count differs from exact ABI declaration")
    if call.argSlots.len <= 0:
        return
    if PrimaryObjectPlanTraceActive():
        PrimaryObjectPlanTrace(Fmt"phase=call_arg_abi_sizes function={stmt.functionName} target={stmt.callTarget} source={importcSourcePath} join={importcJoin} argc={call.argSlots.len}")
    var abiSizes: int32[]
    for argIndex in 0..<call.argSlots.len:
        var paramType = ""
        var abiTypeSourcePath = importcSourcePath
        var variadicTail = false
        if variadicParamIndex >= 0 && argIndex >= variadicParamIndex:
            variadicTail = true
            paramType = PrimaryBodyIrCallArgTypeAt(stmt, argIndex)
            abiTypeSourcePath = stmt.sourcePath
            if paramType != "" && abiTypeSourcePath == "":
                panic("primary object: call ABI variadic argument owner missing")
        elif argIndex < importcParamTypes.len:
            paramType = importcParamTypes[argIndex]
        elif importcParamTypes.len > 0:
            panic("primary object: call argument exceeds exact ABI declaration")
        else:
            paramType = PrimaryBodyIrResolvedTargetParamType(lowering,

                                                             stmt,
                                                             argIndex,
                                                             "abi_sizes",
                                                             -1)
        var abiSize: int32
        if paramType != "":
            if texpr.TypedExprNormalizeTypeText(paramType) == "unknown":
                panic("primary object: call ABI parameter type unknown")
            abiSize = PrimaryBodyIrAbiSizeFromTypedText(lowering.typedIr,
                                                        abiTypeSourcePath,
                                                        paramType)
        elif variadicTail:
            abiSize = PrimaryBodyIrAbiSizeFromCallSlot(call,
                                                       bodyIR,
                                                       argIndex)
        else:
            panic("primary object: call ABI parameter type missing")
        if variadicTail:
            let declaredTailSize =
                PrimaryBodyIrAbiSizeFromTypedText(lowering.typedIr,
                                                  importcSourcePath,
                                                  variadicElementType)
            if declaredTailSize != 1 &&
               declaredTailSize != 2 &&
               declaredTailSize != 4 &&
               declaredTailSize != 8:
                panic("primary object: call ABI variadic element type unavailable")
            if abiSize != declaredTailSize:
                panic("primary object: call ABI variadic argument type mismatch")
        if abiSize != 1 && abiSize != 2 && abiSize != 4 && abiSize != 8:
            panic("primary object: call ABI parameter width unavailable")
        add(abiSizes, abiSize)
    if abiSizes.len != call.argSlots.len:
        panic("primary object: call ABI width cardinality mismatch")
    call.argAbiSizes = abiSizes

# [wall131] callee 形参 ownership 权威落列 (v6 call-arg 伪消费根修的生产侧
# 半边)。正槽 StackValue 实参在 derive 批 2 只有定义行 valueDefOwnership
# 可镜像 (exact_def_derive.cheng)，var 形参被伪 Move 戳 → CFG Kill → 调用
# 后基使用撞 states<0 (phase=4746)。本函数在 PrimaryBodyIrAppendCallOp 构
# 造点把 callee 形参声明权威逐列写进 CallOp：var/借用形参 → OwnBorrowUnique，
# 值/owned 形参 → OwnMove。sentinel 契约：importc 目标不落列 (len==0)，
# 消费侧对 len==0 与 OwnInvalid 行保持既有行为逐字节不变。到达本函数的
# call 已过 PrimaryBodyIrFillCallArgAbiSizes，每个 argIndex 的形参类型必有
# 非空非 unknown 权威 (missing/unknown 在 ABI fill 已 panic)，故此处权威
# 缺失 = 形状洞 = panic fail-closed，无兜底。
@borrows
fn PrimaryBodyIrFillCallArgFormalOwnerships(call: var coreir.CallOp,
                                            lowering: var lower.LoweringPlanStub,
                                            stmt: lower.PrimaryObjectIrStatement) =
    if call.targetIsImportc:
        return
    if call.argSlots.len <= 0:
        return
    if call.argFormalOwnerships.len != 0:
        panic("primary object: call arg formal ownership cardinality mismatch")
    for argIndex in 0..<call.argSlots.len:
        # [wall131] var 性第一权威 = callee TypedExpr paramMutableFlags 结构
        # 列 (PrimaryBodyIrTypedParamMutableAt)；无 TypedExpr 权威 (-1) 才
        # 走文本 fallback (importc join/桥形态)。文本权威实测丢 var 前缀，
        # 只作兜底不作第一权威。
        let mutableFlag = PrimaryBodyIrTypedParamMutableAt(
            lowering,
            stmt.callTargetSourcePath,
            stmt.callTarget,
            argIndex)
        if mutableFlag >= 0:
            if mutableFlag == 1:
                add(call.argFormalOwnerships, Int32(coreir.OwnBorrowUnique))
            else:
                add(call.argFormalOwnerships, Int32(coreir.OwnMove))
            continue
        let paramType = PrimaryBodyIrResolvedTargetParamType(lowering,
                                                             stmt,
                                                             argIndex,
                                                             "call_arg_formal_ownership",
                                                             -1)
        if paramType == "" ||
           texpr.TypedExprNormalizeTypeText(paramType) == "unknown":
            panic(Fmt"primary object: call arg formal ownership authority missing arg={argIndex}")
        if PrimaryBodyIrTypeTextIsVarParam(paramType):
            add(call.argFormalOwnerships, Int32(coreir.OwnBorrowUnique))
        else:
            add(call.argFormalOwnerships, Int32(coreir.OwnMove))
    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
        var fillOwnsDump = ""
        var fillOwnsRow = 0
        while fillOwnsRow < call.argFormalOwnerships.len:
            let fillOwnVal = call.argFormalOwnerships[fillOwnsRow]
            fillOwnsDump = Fmt"{fillOwnsDump}{fillOwnVal},"
            fillOwnsRow = fillOwnsRow + 1
        os.WriteLine(os.GetStderr(),
                     Fmt"phase=call_arg_formal_ownership_fill function={stmt.functionName} line={stmt.lineNumber} target={call.targetSymbol} argc={call.argSlots.len} owns={fillOwnsDump}")

@borrows
fn PrimaryBodyIrRewriteStrutilsJoinBridgeAddressArgs(call: var coreir.CallOp): bool =
    # wall93: Fmt join 迁移 parts-only fmt 桥后, 地址传参改写覆盖两符号;
    # join 桥 2 参 (parts,sep), fmt 桥 1 参 (parts), arity 各自精确守卫。
    if call.targetSymbol != "cheng_strutils_join_bridge" &&
       call.targetSymbol != "cheng_strformat_fmt_bridge":
        return true
    if call.targetSymbol == "cheng_strutils_join_bridge" &&
       (call.argSlots.len != 2 || call.argPassKinds.len != 2):
        return false
    if call.targetSymbol == "cheng_strformat_fmt_bridge" &&
       (call.argSlots.len != 1 || call.argPassKinds.len != 1):
        return false
    for argIndex in 0..<call.argSlots.len:
        let argSlot = call.argSlots[argIndex]
        if coreir.CallArgSlotIsAddress(argSlot):
            call.argPassKinds[argIndex] = coreir.BodyCallPassParamAddressTag
        elif argSlot >= 0:
            call.argSlots[argIndex] = coreir.CallArgSlotAddress(argSlot)
            call.argPassKinds[argIndex] = coreir.BodyCallPassParamAddressTag
        else:
            return false
    return true

@borrows
fn PrimaryBodyIrTypeTextIsVarParam(typeRaw: str): bool =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    return PrimaryStartsWith(normType, "var")

# [wall148] var 形参类型文本 → 运行时内型：优先剥内部借用标记拼写
# （TypedExprCallParamType 对 mutable 形参的编码），否则按既有 var 前缀剥。
@borrows
fn PrimaryBodyIrVarParamRuntimeInnerType(typeRaw: str): str =
    var markerInner = ""
    if texpr.TypedExprCallBorrowModeInner(typeRaw, markerInner):
        return markerInner
    return texpr.TypedExprStripVarType(typeRaw)

# [wall148] var 借用视图形参根基址：形参槽承载「句柄槽地址」时先解一跳
# 得对象基址（与 backend2 侧 MaterializeExactFieldPathAddress 同契约）。
# 非可变 ParamRef/LocalRef 根零改动直返；槽不可用返回 -1（fail-closed）。
@borrows
fn PrimaryBodyIrMaterializeVarBorrowBase(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          typedIr: texpr.TypedExprIr,
                                          pathRootNodeIndex: int32,
                                          rootSlot: int32,
                                          targetName: str): int32 =
    var hopIndex = pathRootNodeIndex
    while hopIndex >= 0 && hopIndex < typedIr.nodes2_nodeIndexs.len &&
          typedIr.nodes2_opKinds[hopIndex] == texpr.TypedExprIrOpFieldGet:
        hopIndex = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, hopIndex)
    if hopIndex < 0 || hopIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[hopIndex] != texpr.TypedExprIrOpParamRef ||
       rootSlot < 0 || rootSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, rootSlot) != coreir.LocalPtrTag ||
       !typedIr.nodes2_paramMutableFlags[hopIndex]:
        return rootSlot
    let borrowDerefSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                         slotNames,
                                                         Fmt"{targetName}#vfbase",
                                                         coreir.LocalPtrTag)
    if borrowDerefSlot < 0:
        return -1
    var borrowDerefOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(borrowDerefOp)
    borrowDerefOp.kind = coreir.BodyOpFieldLoadTag
    borrowDerefOp.target = borrowDerefSlot
    add(borrowDerefOp.operands, rootSlot)
    add(borrowDerefOp.operands, borrowDerefSlot)
    add(borrowDerefOp.operands, 0)
    add(borrowDerefOp.operands, 8)
    let _ = coreir.BodyIRAppendOp(bodyIR, borrowDerefOp)
    return borrowDerefSlot

# [wall148] 借用视图/引用中跳字段 store（plan 侧孪生，与 backend2 侧
# PrimaryBodyIrAppendBorrowViewFieldStore 同契约）：var 借用视图形参根
# 先解一跳句柄槽；点路径 ref 中跳经句柄装载。全链 meta 先验后发射，
# 任一 miss 返回 false 交回既有 naive FieldStore（零行为漂移）。
@borrows
fn PrimaryBodyIrAppendBorrowViewFieldStore(bodyIR: var coreir.BodyIR,
                                            slotNames: var str[],
                                            typedIr: texpr.TypedExprIr,
                                            sourcePath: str,
                                            rootTypeRaw: str,
                                            baseSlot: int32,
                                            fieldPath: str,
                                            valueSlot: int32): bool =
    if baseSlot < 0 || baseSlot >= bodyIR.localSlots.len:
        return false
    if strutil.Contains(fieldPath, "[") || strutil.Contains(fieldPath, "("):
        return false
    var parts: str[]
    parts = []
    var bvfPartStart = 0
    var bvfScan = 0
    while bvfScan < len(fieldPath):
        if fieldPath[bvfScan] == '.':
            add(parts, share(strings.SliceBytes(fieldPath, bvfPartStart, bvfScan - bvfPartStart)))
            bvfPartStart = bvfScan + 1
        bvfScan = bvfScan + 1
    add(parts, share(strings.SliceBytes(fieldPath, bvfPartStart, len(fieldPath) - bvfPartStart)))
    if parts.len <= 0:
        return false
    var bvfIdx = 0
    while bvfIdx < parts.len:
        if strutil.Strip(parts[bvfIdx]) == "":
            return false
        bvfIdx = bvfIdx + 1
    var curType = PrimaryBodyIrVarParamRuntimeInnerType(rootTypeRaw)
    if curType == "" || !PrimaryObjectMetadataTextStable(curType):
        return false
    var fire = false
    let rootIsRef = texpr.TypedExprIrTypeIsRef(typedIr, sourcePath, curType)
    let rootIsBorrowFormal = rootIsRef &&
        PrimaryBodyIrLocalIsParam(bodyIR.localSlots[baseSlot]) &&
        PrimaryBodyIrSlotType(bodyIR, baseSlot) == coreir.LocalPtrTag
    if rootIsBorrowFormal:
        fire = true
    var probeType = curType
    var probeIdx = 0
    var probeOffsets: int32[]
    probeOffsets = []
    var probeSizes: int32[]
    probeSizes = []
    var probeRefFlags: int32[]
    probeRefFlags = []
    while probeIdx < parts.len:
        var hopFieldType = ""
        var hopOffset: int32
        var hopSize: int32
        var hopAlign: int32
        if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                                sourcePath,
                                                probeType,
                                                parts[probeIdx],
                                                hopFieldType,
                                                hopOffset,
                                                hopSize,
                                                hopAlign):
            return false
        if hopOffset < 0 || hopSize <= 0:
            return false
        let hopIsRef = texpr.TypedExprIrTypeIsRef(typedIr, sourcePath, hopFieldType)
        add(probeOffsets, hopOffset)
        add(probeSizes, hopSize)
        if hopIsRef:
            add(probeRefFlags, 1)
        else:
            add(probeRefFlags, 0)
        if probeIdx < parts.len - 1:
            if hopIsRef:
                fire = true
                probeType = texpr.TypedExprNormalizeTypeText(hopFieldType)
            else:
                probeType = texpr.TypedExprNormalizeTypeText(hopFieldType)
                if !PrimaryObjectMetadataTextStable(probeType):
                    return false
        probeIdx = probeIdx + 1
    if !fire:
        return false
    var emitSlot = baseSlot
    if rootIsBorrowFormal:
        let bvfDerefSlot = PrimaryBodyIrFindOrCreateSlot(
            bodyIR,
            slotNames,
            Fmt"#bvfbase#{bodyIR.ops.len}",
            coreir.LocalPtrTag)
        if bvfDerefSlot < 0:
            return false
        var bvfDerefOp: coreir.BodyOp
        coreir.BodyIRApplyBodyOpDefaultProof(bvfDerefOp)
        bvfDerefOp.kind = coreir.BodyOpFieldLoadTag
        bvfDerefOp.target = bvfDerefSlot
        add(bvfDerefOp.operands, baseSlot)
        add(bvfDerefOp.operands, bvfDerefSlot)
        add(bvfDerefOp.operands, 0)
        add(bvfDerefOp.operands, 8)
        let _ = coreir.BodyIRAppendOp(bodyIR, bvfDerefOp)
        emitSlot = bvfDerefSlot
    var emitIdx = 0
    var runningOffset: int32
    while emitIdx < parts.len:
        if emitIdx == parts.len - 1:
            var storeOp: coreir.BodyOp
            coreir.BodyIRApplyBodyOpDefaultProof(storeOp)
            storeOp.kind = coreir.BodyOpFieldStoreTag
            storeOp.target = emitSlot
            add(storeOp.operands, emitSlot)
            add(storeOp.operands, valueSlot)
            add(storeOp.operands, runningOffset + probeOffsets[emitIdx])
            add(storeOp.operands, probeSizes[emitIdx])
            let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
            return true
        if probeRefFlags[emitIdx] == 1:
            let hopHandleSlot = PrimaryBodyIrFindOrCreateSlot(
                bodyIR,
                slotNames,
                Fmt"#bvfhop#{emitIdx}#{bodyIR.ops.len}",
                coreir.LocalPtrTag)
            if hopHandleSlot < 0:
                return false
            var hopLoadOp: coreir.BodyOp
            coreir.BodyIRApplyBodyOpDefaultProof(hopLoadOp)
            hopLoadOp.kind = coreir.BodyOpFieldLoadTag
            hopLoadOp.target = hopHandleSlot
            add(hopLoadOp.operands, emitSlot)
            add(hopLoadOp.operands, hopHandleSlot)
            add(hopLoadOp.operands, runningOffset + probeOffsets[emitIdx])
            add(hopLoadOp.operands, 8)
            let _ = coreir.BodyIRAppendOp(bodyIR, hopLoadOp)
            emitSlot = hopHandleSlot
            runningOffset = 0
        else:
            runningOffset = runningOffset + probeOffsets[emitIdx]
        emitIdx = emitIdx + 1
    return false

@borrows
fn PrimaryBodyIrCallArgSlotCarriesAddressValue(bodyIR: coreir.BodyIR,
                                                slotId: int32,
                                                bindingTypeRaw: str): bool =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return false
    let slot = bodyIR.localSlots[slotId]
    if !PrimaryBodyIrLocalIsParam(slot):
        return false
    if slot.typeKind == coreir.LocalPtrTag:
        return true
    if !PrimaryBodyIrTypeTextIsVarParam(bindingTypeRaw):
        return false
    if slot.typeKind == coreir.LocalAggregateTag ||
       slot.typeKind == coreir.LocalStrTag:
        return true
    return false

@borrows
fn PrimaryBodyIrTargetParamIsVarI32(typedIr: texpr.TypedExprIr,
                                     stmt: lower.PrimaryObjectIrStatement,
                                     argIndex: int32): bool =
    return false

@borrows
fn PrimaryBodyIrAppendInvalidOp(bodyIR: var coreir.BodyIR,
                                lineNumber: int32,
                                statementKind: int32,
                                detail0: int32,
                                detail1: int32) =
    if os.GetEnv("CHENG_X64_DBG3") != "":
        os.WriteLine(os.GetStderr(), Fmt"x64dbg3 invalid_op line={lineNumber} kind={statementKind} detail0={detail0} detail1={detail1}")
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpInvalidTag
    op.target = lineNumber
    add(op.operands, statementKind)
    add(op.operands, detail0)
    add(op.operands, detail1)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)

@borrows
fn PrimaryBodyIrAppendVarI32Load(bodyIR: var coreir.BodyIR,
                                  addressSlot: int32,
                                  valueSlot: int32) =
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpIndexedLoadTag
    op.target = valueSlot
    add(op.operands, addressSlot)
    add(op.operands, valueSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)

@borrows
fn PrimaryBodyIrAppendVarI32Store(bodyIR: var coreir.BodyIR,
                                   addressSlot: int32,
                                   valueSlot: int32) =
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpIndexedStoreTag
    op.target = addressSlot
    add(op.operands, addressSlot)
    add(op.operands, valueSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)

@borrows
fn PrimaryBodyIrAppendVarI64Load(bodyIR: var coreir.BodyIR,
                                  addressSlot: int32,
                                  valueSlot: int32) =
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpIndexedLoadTag
    op.target = valueSlot
    add(op.operands, addressSlot)
    add(op.operands, valueSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)

@borrows
fn PrimaryBodyIrAppendVarI64Store(bodyIR: var coreir.BodyIR,
                                   addressSlot: int32,
                                   valueSlot: int32) =
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpIndexedStoreTag
    op.target = addressSlot
    add(op.operands, addressSlot)
    add(op.operands, valueSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)

@borrows
fn PrimaryBodyIrAppendVarAggregateStore(bodyIR: var coreir.BodyIR,
                                         addressSlot: int32,
                                         valueSlot: int32,
                                         byteCount: int32) =
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpFieldStoreTag
    op.target = addressSlot
    add(op.operands, addressSlot)
    add(op.operands, valueSlot)
    add(op.operands, 0)
    add(op.operands, byteCount)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)

@borrows
fn PrimaryBodyIrSlotIsAggregateParam(bodyIR: coreir.BodyIR,
                                      slotId: int32): bool =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return false
    return bodyIR.localSlots[slotId].typeKind == coreir.LocalAggregateTag &&
           PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotId])

@borrows
fn PrimaryBodyIrAppendAggregateParamStoreIfNeeded(bodyIR: var coreir.BodyIR,
                                                   targetSlot: int32,
                                                   valueSlot: int32): bool =
    if !PrimaryBodyIrSlotIsAggregateParam(bodyIR, targetSlot):
        return false
    if valueSlot < 0 || valueSlot >= bodyIR.localSlots.len:
        return false
    let targetSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot])
    let valueSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot])
    if targetSize <= 0 || valueSize != targetSize:
        return false
    let valueKind = PrimaryBodyIrSlotType(bodyIR, valueSlot)
    if bodyIR.localSlots[targetSlot].auxValue == coreir.LocalStrTag:
        if valueKind != coreir.LocalStrTag:
            return false
    elif valueKind != coreir.LocalAggregateTag:
        return false
    PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                         targetSlot,
                                         valueSlot,
                                         targetSize)
    return true

# Materialize a relational comparison condition (`a > b`, `1 < 0`, `a + b > 10`)
# into a 0/1 value slot using only the scalar-path context (no lowering/typedFn/
# irFunction). This is the value-producing sibling of the cbr cond in
# PrimaryBodyIrCondValue01Slot's self-resolve block: cmp + cset -> {0,1}. Used by
# the branchless ternary scalar path so a `?:` whose condition is a compare can
# feed an arithmetic operand (`5 + (1 > 0 ? 3 : 9) * 2`). `&&`/`||` conditions
# are refused (return -1) — short-circuit semantics are not a branchless value.
@borrows
fn PrimaryBodyIrCmpCondValue01ScalarSlot(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          varI32ParamNames: str[],
                                          typedIr: texpr.TypedExprIr,
                                          sourcePath: str,
                                          condTextRaw: str,
                                          slotNameHint: str,
                                          callOrdinal: var int32): int32 =
    let condText = PrimaryBodyIrStripOuterParens(strutil.Strip(condTextRaw))
    if condText == "":
        return -1
    if PrimaryBodyIrConditionHasAnd(condText) ||
       PrimaryBodyIrConditionHasOr(condText):
        return -1
    var cmpPos: int32 = -1
    var cmpLen: int32 = 2
    var cmpTag: int32
    cmpPos = texpr.TypedExprFindTopLevelTextToken(condText, "==")
    if cmpPos >= 0:
        cmpTag = coreir.BodyCondI32EqTag
    if cmpPos < 0:
        cmpPos = texpr.TypedExprFindTopLevelTextToken(condText, "!=")
        if cmpPos >= 0:
            cmpTag = coreir.BodyCondI32NeTag
    if cmpPos < 0:
        cmpPos = texpr.TypedExprFindTopLevelTextToken(condText, ">=")
        if cmpPos >= 0:
            cmpTag = coreir.BodyCondI32GeTag
    if cmpPos < 0:
        let leTok = strutil.Join(["<", "="], "")
        cmpPos = texpr.TypedExprFindTopLevelTextToken(condText, leTok)
        if cmpPos >= 0:
            cmpTag = coreir.BodyCondI32LeTag
    if cmpPos < 0:
        cmpPos = texpr.TypedExprFindTopLevelTextToken(condText, ">")
        if cmpPos >= 0:
            cmpLen = 1
            cmpTag = coreir.BodyCondI32GtTag
    if cmpPos < 0:
        cmpPos = texpr.TypedExprFindTopLevelTextToken(condText, "<")
        if cmpPos >= 0:
            cmpLen = 1
            cmpTag = coreir.BodyCondI32LtTag
    if cmpPos <= 0:
        return -1
    let lhsText = strutil.Strip(strings.SliceBytes(condText, 0, cmpPos))
    let rhsText = strutil.Strip(strings.SliceBytes(condText,
                                                   cmpPos + cmpLen,
                                                   len(condText) - cmpPos - cmpLen))
    if lhsText == "" || rhsText == "":
        return -1
    # Resolve both compare operands as i32 scalars first: this is an i32
    # relational cond, so a bare `0`/`-4` must land in an i32 slot. Falling
    # straight to PrimaryBodyIrCondCmpOperandSlot would let `0` resolve as a u64
    # slot, forcing PrimaryBodyIRFillCmpOp into a 64-bit compare — a negative i32
    # (zero-extended) would then read as a large positive (`-4 > 0` true).
    var condLhs = PrimaryBodyIrScalarValueSlotForText(bodyIR, slotNames, varI32ParamNames, typedIr,
                                                      sourcePath, lhsText, coreir.LocalI32Tag, callOrdinal)
    if condLhs < 0:
        condLhs = PrimaryBodyIrCondCmpOperandSlot(bodyIR, slotNames, typedIr, sourcePath,
                                                  lhsText, Fmt"{slotNameHint}#cl", callOrdinal)
    var condRhs = PrimaryBodyIrScalarValueSlotForText(bodyIR, slotNames, varI32ParamNames, typedIr,
                                                      sourcePath, rhsText, coreir.LocalI32Tag, callOrdinal)
    if condRhs < 0:
        condRhs = PrimaryBodyIrCondCmpOperandSlot(bodyIR, slotNames, typedIr, sourcePath,
                                                  rhsText, Fmt"{slotNameHint}#cr", callOrdinal)
    if condLhs < 0 || condRhs < 0:
        return -1
    # Only a genuine scalar integer compare is a branchless 0/1 here. A `str ==
    # str` / aggregate cond resolves to non-integer slots — emitting BodyOpCmp on
    # those would compare descriptor words as ints (silent miscompile). Refuse so
    # the caller bails and the real str-eq / branch path handles it.
    let condLhsType = PrimaryBodyIrSlotType(bodyIR, condLhs)
    let condRhsType = PrimaryBodyIrSlotType(bodyIR, condRhs)
    if (condLhsType != coreir.LocalI32Tag && condLhsType != coreir.LocalI64Tag) ||
       (condRhsType != coreir.LocalI32Tag && condRhsType != coreir.LocalI64Tag):
        return -1
    let cmpSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, slotNameHint, coreir.LocalI32Tag)
    if cmpSlot < 0:
        return -1
    var cmpOp: coreir.BodyOp
    cmpOp.kind = coreir.BodyOpCmpTag
    cmpOp.target = cmpSlot
    add(cmpOp.operands, cmpTag)
    add(cmpOp.operands, condLhs)
    add(cmpOp.operands, condRhs)
    let _ = coreir.BodyIRAppendOp(bodyIR, cmpOp)
    return cmpSlot

@borrows
fn PrimaryBodyIrI32ValueSlotForText(bodyIR: var coreir.BodyIR,
                                     slotNames: var str[],
                                     varI32ParamNames: str[],
                                     textRaw: str): int32 =
    let text = strutil.Strip(textRaw)
    if len(text) <= 0:
        return -1
    let constVal = PrimaryBodyIrExtractIntFromText(text)
    if constVal != 0 || PrimaryBodyIrTextIsI32Zero(text):
        let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, text, coreir.LocalI32Tag)
        var constOp: coreir.BodyOp
        constOp.kind = coreir.BodyOpLoadConstTag
        constOp.target = slotId
        add(constOp.operands, coreir.LocalI32Tag)
        add(constOp.operands, constVal)
        let _ = coreir.BodyIRAppendOp(bodyIR, constOp)
        return slotId
    let slotId = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, text)
    if slotId < 0:
        return -1
    if PrimaryBodyIrNameInList(varI32ParamNames, text):
        let valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                      slotNames,
                                                      PrimaryBodyIrVarI32ValueSlotName(text),
                                                      coreir.LocalI32Tag)
        PrimaryBodyIrAppendVarI32Load(bodyIR, slotId, valueSlot)
        return valueSlot
    if PrimaryBodyIrSlotType(bodyIR, slotId) != coreir.LocalI32Tag:
        return -1
    # 常量槽跨块复用根修 (同 PrimaryBodyIrConditionOperandSlot 复用臂):
    # 模块 const 标识符 (chengStrFlagOwned) 首引在分支块内建槽并就地 LoadConst,
    # 短路条件链 (&&/||) 后续引用经本函数命中同槽直接返回, 首引 LoadConst 不支配
    # join/兄弟块的 use → CFG UninitializedUse。LoadConst 为纯值, 引用点重新物化
    # 同值即可满足支配; 仅限最近 def 恰为 LoadConst 的槽, 其余保持原复用语义。
    var i32ReuseConstType: int32
    var i32ReuseConstVal: int32
    if PrimaryBodyIrLoadConstOperandsForSlot(bodyIR,
                                             slotId,
                                             i32ReuseConstType,
                                             i32ReuseConstVal):
        var i32ReuseConstOp: coreir.BodyOp
        i32ReuseConstOp.kind = coreir.BodyOpLoadConstTag
        i32ReuseConstOp.target = slotId
        add(i32ReuseConstOp.operands, i32ReuseConstType)
        add(i32ReuseConstOp.operands, i32ReuseConstVal)
        let _ = coreir.BodyIRAppendOp(bodyIR, i32ReuseConstOp)
    return slotId

@borrows
fn PrimaryBodyIrScalarCallSynthesisSlot(bodyIR: var coreir.BodyIR,
                                         slotNames: var str[],
                                         varI32ParamNames: str[],
                                         typedIr: texpr.TypedExprIr,
                                         sourcePath: str,
                                         text: str,
                                         typeKind: int32,
                                         callOrdinal: var int32): int32 =
    if callOrdinal < 0:
        return -1
    let scOpen = texpr.TypedExprFindWholeCallOpenParen(text)
    if scOpen <= 0:
        return -1
    let scClose = texpr.TypedExprFindMatchingParen(text, scOpen)
    if scClose != len(text) - 1:
        return -1
    let scHead = strutil.Strip(strings.SliceBytes(text, 0, scOpen))
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(scHead) ||
       PrimaryBodyIrTextIsCastHead(scHead):
        return -1
    let scArgsText = strutil.Strip(strings.SliceBytes(text,
                                                      scOpen + 1,
                                                      scClose - scOpen - 1))
    if PrimaryBodyIrPointeeTypeTextForSource(typedIr, sourcePath, scHead) != "":
        # Pointer-type alias cast (e.g. ChengFfiHandleSlotPtr(mem)): not a call;
        # the value is the inner expression.
        return PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                   slotNames,
                                                   varI32ParamNames,
                                                   typedIr,
                                                   sourcePath,
                                                   scArgsText,
                                                   typeKind,
                                                   callOrdinal)
    var scArgNames: str[]
    if scArgsText != "":
        scArgNames = PrimaryBodyIrCallArgNames(scArgsText)
    var scArgSlots: int32[]
    for scArgIndex in 0..<scArgNames.len:
        let scArgText = strutil.Strip(scArgNames[scArgIndex])
        var scArgSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, scArgText)
        if scArgSlot < 0:
            # 指针强转实参必须先走 Ptr 槽：I32-first 会把 64 位指针截断为 32 位。
            var scArgIsPtrCast = PrimaryBodyIrWholeCallInnerForHead(scArgText, "ptr") != ""
            if !scArgIsPtrCast:
                if PrimaryBodyIrWholeCallInnerForHead(scArgText, "UInt8Ptr") != "":
                    scArgIsPtrCast = true
                elif PrimaryBodyIrWholeCallInnerForHead(scArgText, "Int32Ptr") != "":
                    scArgIsPtrCast = true
                elif PrimaryBodyIrWholeCallInnerForHead(scArgText, "UInt32Ptr") != "":
                    scArgIsPtrCast = true
                elif PrimaryBodyIrWholeCallInnerForHead(scArgText, "UInt64Ptr") != "":
                    scArgIsPtrCast = true
                elif PrimaryBodyIrWholeCallInnerForHead(scArgText, "Int64Ptr") != "":
                    scArgIsPtrCast = true
                elif PrimaryBodyIrWholeCallInnerForHead(scArgText, "VoidPtrPtr") != "":
                    scArgIsPtrCast = true
            if scArgIsPtrCast:
                scArgSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                           slotNames,
                                                           varI32ParamNames,
                                                           typedIr,
                                                           sourcePath,
                                                           scArgText,
                                                           callOrdinal)
        if scArgSlot < 0:
            scArgSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            typedIr,
                                                            sourcePath,
                                                            scArgText,
                                                            coreir.LocalI32Tag, callOrdinal)
        if scArgSlot < 0:
            scArgSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            typedIr,
                                                            sourcePath,
                                                            scArgText,
                                                            coreir.LocalPtrTag, callOrdinal)
        if scArgSlot < 0:
            scArgSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            typedIr,
                                                            sourcePath,
                                                            scArgText,
                                                            coreir.LocalI64Tag, callOrdinal)
        if scArgSlot < 0 || scArgSlot >= bodyIR.localSlots.len:
            return -1
        let scArgType = PrimaryBodyIrSlotType(bodyIR, scArgSlot)
        if scArgType != coreir.LocalI32Tag &&
           scArgType != coreir.LocalI64Tag &&
           scArgType != coreir.LocalPtrTag:
            return -1
        add(scArgSlots, scArgSlot)
    # This retired synthesizer is no longer reachable from lowering because it
    # has no exact declaration tuple. Keep its result width caller-owned.
    var scResultTypeKind = typeKind
    let scRetNorm = ""
    if scRetNorm == "ptr" || scRetNorm == "cstring":
        scResultTypeKind = coreir.LocalPtrTag
    elif PrimaryBodyIrPointeeTypeTextForSource(typedIr, sourcePath, scRetNorm) != "":
        scResultTypeKind = coreir.LocalPtrTag
    let scResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#scalar_call#{bodyIR.callSequence.len}",
                                                     scResultTypeKind)
    if scResultSlot < 0:
        return -1
    let scCallIndex = bodyIR.callSequence.len
    var scCall: coreir.CallOp
    scCall.targetSymbol = scHead
    scCall.resultSlot = scResultSlot
    scCall.resultPassKind = coreir.BodyCallPassStackValueTag
    for scCopyIndex in 0..<scArgSlots.len:
        add(scCall.argSlots, scArgSlots[scCopyIndex])
        add(scCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(bodyIR.callSequence, scCall)
    var scOp: coreir.BodyOp
    scOp.kind = coreir.BodyOpCallTag
    scOp.target = scResultSlot
    add(scOp.operands, scCallIndex)
    let _ = coreir.BodyIRAppendOp(bodyIR, scOp)
    callOrdinal = callOrdinal + 1
    return scResultSlot

# Rightmost top-level occurrence of a binary +,-,*,/,% token so that
# left-associative chains split as (a op b) op c, not a op (b op c).
# Skips '->' and unary +/- (an operator, '(' or ',' on the left).
@borrows
fn PrimaryBodyIrBinOpPrevDisallowsBinary(prev: char): bool =
    if prev == '(':
        return true
    if prev == ',':
        return true
    if prev == '+':
        return true
    if prev == '-':
        return true
    if prev == '*':
        return true
    if prev == '/':
        return true
    if prev == '%':
        return true
    if prev == '&':
        return true
    if prev == '|':
        return true
    if prev == '^':
        return true
    if prev == '<':
        return true
    if prev == '>':
        return true
    if prev == '?':
        return true
    if prev == ':':
        return true
    if prev == '=':
        return true
    return false

@borrows
fn PrimaryBodyIrFindTopLevelBinOpTokenLast(textRaw: str, token: int32): int32 =
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    var found = -1
    for i in 0..<textRaw.len:
        let piece = textRaw[i]
        if piece == '[':
            bracketDepth = bracketDepth + 1
        elif piece == ']':
            bracketDepth = bracketDepth - 1
        elif piece == '(':
            parenDepth = parenDepth + 1
        elif piece == ')':
            parenDepth = parenDepth - 1
        elif piece == '{':
            braceDepth = braceDepth + 1
        elif piece == '}':
            braceDepth = braceDepth - 1
        elif bracketDepth == 0:
            if parenDepth == 0:
                if braceDepth == 0:
                    if int32(piece) == token:
                        var isArrow: bool
                        if int32(piece) == '-':
                            if i + 1 < textRaw.len:
                                if textRaw[i + 1] == '>':
                                    isArrow = true
                        if !isArrow:
                            var j = i - 1
                            var scanSpaces = true
                            while scanSpaces:
                                if j < 0:
                                    scanSpaces = false
                                elif textRaw[j] == ' ':
                                    j = j - 1
                                else:
                                    scanSpaces = false
                            if j >= 0:
                                let prev = textRaw[j]
                                if !PrimaryBodyIrBinOpPrevDisallowsBinary(prev):
                                    found = i
    return found

var primaryBodyIrScalarActiveSourcePaths: str[]
var primaryBodyIrScalarActiveTexts: str[]
var primaryBodyIrScalarActiveTypeKinds: int32[]

@borrows
fn PrimaryBodyIrScalarValueSlotForText(bodyIR: var coreir.BodyIR,
                                        slotNames: var str[],
                                        varI32ParamNames: str[],
                                        typedIr: texpr.TypedExprIr,
                                        sourcePath: str,
                                        textRaw: str,
                                        typeKind: int32,
                                        callOrdinal: var int32): int32 =
    primarySlotStageProbe(bodyIR, "scalar_text_enter", 15560)
    let scalarActiveText = strings.CloneStr(PrimaryBodyIrStripOuterParens(textRaw))
    for activeIndex in 0..<primaryBodyIrScalarActiveTexts.len:
        if primaryBodyIrScalarActiveTypeKinds[activeIndex] == typeKind &&
           primaryBodyIrScalarActiveTexts[activeIndex] == scalarActiveText &&
           PrimaryPathNormalizedEquals(primaryBodyIrScalarActiveSourcePaths[activeIndex],
                                       sourcePath):
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=recursion_cycle helper=scalar text=",
                                                       share(textRaw),
                                                       " source=",
                                                       share(sourcePath)], ""))
            return -1
    add(primaryBodyIrScalarActiveSourcePaths, strings.CloneStr(sourcePath))
    add(primaryBodyIrScalarActiveTexts, strings.CloneStr(scalarActiveText))
    add(primaryBodyIrScalarActiveTypeKinds, typeKind)
    let scalarResultSlot = PrimaryBodyIrScalarValueSlotForTextImpl(bodyIR,
                                                                  slotNames,
                                                                  share(varI32ParamNames),
                                                                  typedIr,
                                                                  share(sourcePath),
                                                                  share(textRaw),
                                                                  typeKind,
                                                                  callOrdinal)
    let scalarKeep = primaryBodyIrScalarActiveSourcePaths.len - 1
    var nextScalarSourcePaths: str[]
    var nextScalarTexts: str[]
    var nextScalarTypeKinds: int32[]
    for i in 0..<primaryBodyIrScalarActiveSourcePaths.len:
        add(nextScalarSourcePaths, strings.CloneStr(primaryBodyIrScalarActiveSourcePaths[i]))
        add(nextScalarTexts, strings.CloneStr(primaryBodyIrScalarActiveTexts[i]))
        add(nextScalarTypeKinds, primaryBodyIrScalarActiveTypeKinds[i])
    setLen(nextScalarSourcePaths, scalarKeep)
    setLen(nextScalarTexts, scalarKeep)
    setLen(nextScalarTypeKinds, scalarKeep)
    primaryBodyIrScalarActiveSourcePaths = nextScalarSourcePaths
    primaryBodyIrScalarActiveTexts = nextScalarTexts
    primaryBodyIrScalarActiveTypeKinds = nextScalarTypeKinds
    return scalarResultSlot

@borrows
fn PrimaryBodyIrScalarValueSlotForTextImpl(bodyIR: var coreir.BodyIR,
                                        slotNames: var str[],
                                        varI32ParamNames: str[],
                                        typedIr: texpr.TypedExprIr,
                                        sourcePath: str,
                                        textRaw: str,
                                        typeKind: int32,
                                        callOrdinal: var int32): int32 =
    primarySlotStageProbe(bodyIR, "scalar_text_impl_enter", 15607)
    let text = PrimaryBodyIrStripOuterParens(textRaw)
    if len(text) <= 0:
        return -1
    var targetTypeTextForCast = ""
    if typeKind == coreir.LocalI32Tag:
        targetTypeTextForCast = "int32"
    elif typeKind == coreir.LocalI64Tag:
        targetTypeTextForCast = "int64"
    elif typeKind == coreir.LocalPtrTag:
        targetTypeTextForCast = "ptr"
    if targetTypeTextForCast != "":
        let castInner = PrimaryBodyIrTypeCastInnerForTarget(text, targetTypeTextForCast)
        if castInner != "":
            let directCastSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     typedIr,
                                                                     sourcePath,
                                                                     castInner,
                                                                     typeKind, callOrdinal)
            if directCastSlot >= 0:
                return directCastSlot
            if typeKind == coreir.LocalI32Tag:
                let wideCastSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       typedIr,
                                                                       sourcePath,
                                                                       castInner,
                                                                       coreir.LocalI64Tag, callOrdinal)
                if wideCastSlot >= 0:
                    let castSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                 slotNames,
                                                                 text,
                                                                 coreir.LocalI32Tag)
                    var castOp: coreir.BodyOp
                    castOp.kind = coreir.BodyOpCopyLocalTag
                    castOp.target = castSlot
                    add(castOp.operands, wideCastSlot)
                    let _ = coreir.BodyIRAppendOp(bodyIR, castOp)
                    return castSlot
            return -1
    # [bodyir-ownership-wall] Impl 中段探针（只读）：cast 前导段之后。与入口探针一起把
    # "坏点在 Impl 前导段"与"在前导段之后"分开；trail 携带 ops=N ⇒ 包夹可按 op 计数精确对齐。
    primarySlotStageProbe(bodyIR, "impl_after_cast_prologue", 15658)
    if typeKind == coreir.LocalI64Tag:
        let uint64CastInner = PrimaryBodyIrTypeCastInnerForTarget(text, "uint64")
        if uint64CastInner != "":
            return PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       typedIr,
                                                       sourcePath,
                                                       uint64CastInner,
                                                       typeKind, callOrdinal)
        let u64CastInner = PrimaryBodyIrTypeCastInnerForTarget(text, "u64")
        if u64CastInner != "":
            return PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       typedIr,
                                                       sourcePath,
                                                       u64CastInner,
                                                       typeKind, callOrdinal)
    if typeKind == coreir.LocalI32Tag:
        var narrowCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "uint8")
        if narrowCastInner == "":
            narrowCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "UInt8")
        if narrowCastInner == "":
            narrowCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "uint16")
        if narrowCastInner == "":
            narrowCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "UInt16")
        if narrowCastInner == "":
            narrowCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "uint32")
        if narrowCastInner == "":
            narrowCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "UInt32")
        if narrowCastInner == "":
            narrowCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "int8")
        if narrowCastInner == "":
            narrowCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "Int8")
        if narrowCastInner == "":
            narrowCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "int16")
        if narrowCastInner == "":
            narrowCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "Int16")
        if narrowCastInner == "":
            narrowCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "int32")
        if narrowCastInner == "":
            narrowCastInner = PrimaryBodyIrWholeCallInnerForHead(text, "Int32")
        if narrowCastInner != "":
            # 32 位壳(int32/Int32/uint32/UInt32)内层表达式可能天然是 i64
            # (如 `Int32((v >> 32) & int64(65535))`): 原以 typeKind=i32 递归内层,
            # 使 int64 移位/位算全程降 32 位(arm64 32 位移位量 mod-32, `>>32`→`>>0`,
            # `>>48`→`>>16`, 64 位常量分块高 32 位被复制成低 32 位, cheng_fwrite
            # 钳位常数 2147483648 物化成 0x8000000080000000 → gen2 提供者
            # cheng_fwrite 恒返 0 → WriteFile 误报 "os write: write failed")。
            # 先按自然宽度(LocalI64Tag)求内层再 CopyLocal 收窄, 镜像
            # wideCast 既有模式; miss 回落既有 i32 递归, 覆盖面无回归。
            var narrowWideInner = PrimaryBodyIrWholeCallInnerForHead(text, "uint32")
            if narrowWideInner == "":
                narrowWideInner = PrimaryBodyIrWholeCallInnerForHead(text, "UInt32")
            if narrowWideInner == "":
                narrowWideInner = PrimaryBodyIrWholeCallInnerForHead(text, "int32")
            if narrowWideInner == "":
                narrowWideInner = PrimaryBodyIrWholeCallInnerForHead(text, "Int32")
            if narrowWideInner != "":
                let narrowWideSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                         slotNames,
                                                                         varI32ParamNames,
                                                                         typedIr,
                                                                         sourcePath,
                                                                         narrowWideInner,
                                                                         coreir.LocalI64Tag,
                                                                         callOrdinal)
                if narrowWideSlot >= 0:
                    let narrowTruncSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                        slotNames,
                                                                        text,
                                                                        coreir.LocalI32Tag)
                    var narrowTruncOp: coreir.BodyOp
                    narrowTruncOp.kind = coreir.BodyOpCopyLocalTag
                    narrowTruncOp.target = narrowTruncSlot
                    add(narrowTruncOp.operands, narrowWideSlot)
                    let _ = coreir.BodyIRAppendOp(bodyIR, narrowTruncOp)
                    return narrowTruncSlot
            let narrowCastSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     typedIr,
                                                                     sourcePath,
                                                                     narrowCastInner,
                                                                     typeKind, callOrdinal)
            if narrowCastSlot >= 0:
                return narrowCastSlot
    if typeKind == coreir.LocalPtrTag && text == "nil":
        let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   "nil#ptr_zero",
                                                   coreir.LocalPtrTag)
        var nilOp: coreir.BodyOp
        nilOp.kind = coreir.BodyOpLoadConstTag
        nilOp.target = slotId
        add(nilOp.operands, coreir.LocalPtrTag)
        add(nilOp.operands, 0)
        let _ = coreir.BodyIRAppendOp(bodyIR, nilOp)
        return slotId
    # `str[]` / field element assign `xs[i] = nil` needs a full LocalStrTag zero
    # (24B header). Ptr-nil is only 8B and fails SimpleFieldAssignFast's
    # storeSizeBytes gate → false → wall7 6102 poison (hashMapStrIntClear).
    if typeKind == coreir.LocalStrTag && text == "nil":
        let nilStrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       "nil#str_zero",
                                                       coreir.LocalStrTag)
        if nilStrSlot < 0:
            return -1
        if !PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                             slotNames,
                                             nilStrSlot,
                                             callOrdinal):
            return -1
        return nilStrSlot
    if typeKind == coreir.LocalI32Tag &&
       (text == "true" || text == "false"):
        var boolValue: int32
        if text == "true":
            boolValue = 1
        let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, text, coreir.LocalI32Tag)
        var boolOp: coreir.BodyOp
        boolOp.kind = coreir.BodyOpLoadConstTag
        boolOp.target = slotId
        add(boolOp.operands, coreir.LocalI32Tag)
        add(boolOp.operands, boolValue)
        let _ = coreir.BodyIRAppendOp(bodyIR, boolOp)
        return slotId
    if typeKind == coreir.LocalF64Tag && PrimaryBodyIrTextIsF64Literal(text):
        # #85 根修: 槽名就是字面量原文 `text`——物化失败若先建槽, 孤儿槽会被
        # 下游 PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText) 用同一字面
        # 量原文误捡为"已存在的值槽", 把从未 store 的垃圾当合法值 CopyLocal
        # 进赋值目标 (assign 路径实测复现, 见 result_85.md)。物化前先探路。
        var f64PrecheckBits: uint64
        if !PrimaryBodyIrF64LiteralBits(text, f64PrecheckBits):
            return -1
        let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   text,
                                                   coreir.LocalF64Tag)
        if slotId < 0:
            return -1
        var f64ConstOp: coreir.BodyOp
        f64ConstOp.kind = coreir.BodyOpLoadConstTag
        f64ConstOp.target = slotId
        if !PrimaryBodyIrAppendF64ConstOperands(f64ConstOp, text):
            return -1
        let _ = coreir.BodyIRAppendOp(bodyIR, f64ConstOp)
        return slotId
    # W2G/R3 配套: `float64(<整数字面量>)` 常量折叠。cond/表达式路径的
    # `t > float64(0)` 这类 f64 比较右值, 既不是 f64 字面量文本(上臂落空)、
    # 在闭包内又无 float64 函数可解析 (与 return 路径 801 同根, 此形为 83)。
    # 内层为十进制整数字面量时直接按 f64 字面量物化 ("0"→"0.0"),
    # 零运行时开销; 非字面量内层不落此臂 (运行时 SCVTF 走 return/rescue 路径)。
    if typeKind == coreir.LocalF64Tag:
        let f64CastLitInner = PrimaryBodyIrWholeCallInnerForHead(text, "float64")
        if f64CastLitInner != "" &&
           PrimaryBodyIrTextIsIntLiteral(f64CastLitInner):
            var f64CastLitText = strings.CloneStr(f64CastLitInner)
            if !PrimaryBodyIrTextIsF64Literal(f64CastLitText):
                f64CastLitText = strutil.Join([strings.CloneStr(f64CastLitInner), ".0"], "")
            var f64CastLitBits: uint64
            if !PrimaryBodyIrF64LiteralBits(f64CastLitText, f64CastLitBits):
                return -1
            let f64CastLitSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                               slotNames,
                                                               text,
                                                               coreir.LocalF64Tag)
            if f64CastLitSlot < 0:
                return -1
            var f64CastLitOp: coreir.BodyOp
            f64CastLitOp.kind = coreir.BodyOpLoadConstTag
            f64CastLitOp.target = f64CastLitSlot
            if !PrimaryBodyIrAppendF64ConstOperands(f64CastLitOp, f64CastLitText):
                return -1
            let _ = coreir.BodyIRAppendOp(bodyIR, f64CastLitOp)
            return f64CastLitSlot
    if typeKind == coreir.LocalI32Tag &&
       len(text) > 1 && text[0] == '!' && text[1] != '=':
        # boolean not: canonical 0/1 values flip via xor 1
        let notInnerText = strutil.Strip(strings.SliceBytes(text, 1, len(text) - 1))
        let notInnerSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               typedIr,
                                                               sourcePath,
                                                               notInnerText,
                                                               coreir.LocalI32Tag,
                                                               callOrdinal)
        if notInnerSlot < 0:
            return -1
        var notOneSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"{text}#not_one",
                                                       coreir.LocalI32Tag)
        if notOneSlot < 0:
            return -1
        var notOneOp: coreir.BodyOp
        notOneOp.kind = coreir.BodyOpLoadConstTag
        notOneOp.target = notOneSlot
        add(notOneOp.operands, coreir.LocalI32Tag)
        add(notOneOp.operands, 1)
        let _ = coreir.BodyIRAppendOp(bodyIR, notOneOp)
        let notResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"{text}#not_result",
                                                          coreir.LocalI32Tag)
        if notResultSlot < 0:
            return -1
        var notOp: coreir.BodyOp
        notOp.kind = coreir.BodyOpBinOpTag
        notOp.target = notResultSlot
        add(notOp.operands, coreir.LocalI32Tag)
        add(notOp.operands, int32(texpr.TypedExprIrOpI32BitXor))
        add(notOp.operands, notInnerSlot)
        add(notOp.operands, notOneSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, notOp)
        return notResultSlot
    if typeKind == coreir.LocalI32Tag:
        let lenInner = PrimaryBodyIrLenCallInner(text)
        if lenInner != "":
            let strSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, lenInner)
            var lenRootOk = false
            var lenFieldOffset = 8
            if strSlot >= 0 && strSlot < bodyIR.localSlots.len:
                if PrimaryBodyIrSlotType(bodyIR, strSlot) == coreir.LocalStrTag:
                    lenRootOk = true
                    lenFieldOffset = 8
                elif PrimaryBodyIrSlotType(bodyIR, strSlot) == coreir.LocalAggregateTag &&
                     bodyIR.localSlots[strSlot].auxValue == coreir.LocalStrTag &&
                     PrimaryBodyIrLocalIsParam(bodyIR.localSlots[strSlot]):
                    # var str 形参槽存地址：FieldLoad 经地址间接读 len，
                    # 与既有 param 槽 FieldLoad 协议一致。
                    lenRootOk = true
                    lenFieldOffset = 8
                elif PrimaryBodyIrSlotType(bodyIR, strSlot) == coreir.LocalAggregateTag &&
                     PrimaryLocalSlotSizeOf(bodyIR.localSlots[strSlot]) == 16 &&
                     bodyIR.localSlots[strSlot].auxValue != coreir.LocalStrTag:
                    # len(seq): ChengSeqHeader {len@0,cap@4,buffer@8}.
                    lenRootOk = true
                    lenFieldOffset = 0
            if !lenRootOk:
                return -1
            let lenSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       text,
                                                       coreir.LocalI32Tag)
            if lenSlot < 0:
                return -1
            var lenOp: coreir.BodyOp
            lenOp.kind = coreir.BodyOpFieldLoadTag
            lenOp.target = lenSlot
            add(lenOp.operands, strSlot)
            add(lenOp.operands, lenSlot)
            add(lenOp.operands, lenFieldOffset)
            add(lenOp.operands, 4)
            let _ = coreir.BodyIRAppendOp(bodyIR, lenOp)
            return lenSlot
    # `seq.len` / `param.len` field form (not len() call): seq header len@0.
    # Covers Aggregate(16) inline headers and ptr/param slots that hold a
    # header address (FieldLoad fill does the param-address indirection).
    if typeKind == coreir.LocalI32Tag &&
       len(text) >= 5 &&
       strings.SliceBytes(text, len(text) - 4, 4) == ".len":
        let seqLenBase = strutil.Strip(strings.SliceBytes(text, 0, len(text) - 4))
        if seqLenBase != "":
            let seqBaseSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, seqLenBase)
            var seqBaseOk = false
            if seqBaseSlot >= 0 && seqBaseSlot < bodyIR.localSlots.len:
                let seqBaseKind = PrimaryBodyIrSlotType(bodyIR, seqBaseSlot)
                if seqBaseKind == coreir.LocalPtrTag:
                    seqBaseOk = true
                elif seqBaseKind == coreir.LocalAggregateTag &&
                     bodyIR.localSlots[seqBaseSlot].auxValue != coreir.LocalStrTag:
                    seqBaseOk = true
            if seqBaseOk:
                let seqFieldLenSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                   slotNames,
                                                                   text,
                                                                   coreir.LocalI32Tag)
                if seqFieldLenSlot >= 0:
                    var seqFieldLenOp: coreir.BodyOp
                    seqFieldLenOp.kind = coreir.BodyOpFieldLoadTag
                    seqFieldLenOp.target = seqFieldLenSlot
                    add(seqFieldLenOp.operands, seqBaseSlot)
                    add(seqFieldLenOp.operands, seqFieldLenSlot)
                    add(seqFieldLenOp.operands, 0)
                    add(seqFieldLenOp.operands, 4)
                    let _ = coreir.BodyIRAppendOp(bodyIR, seqFieldLenOp)
                    return seqFieldLenSlot
    if typeKind == coreir.LocalI32Tag:
        var indexRoot = ""
        var indexText = ""
        if PrimaryBodyIrIndexExprParts(text, indexRoot, indexText):
            # bare global fixed non-u8 array element read (g[idx]): not an arg
            # slot, so the str/aggregate cases below miss it. Lower it to the
            # scaled global element address + IndexedLoad.
            let globalArrLoadSlot = PrimaryBodyIrGlobalFixedArrayIndexedLoadSlot(bodyIR,
                                                                                slotNames,
                                                                                varI32ParamNames,
                                                                                typedIr,
                                                                                sourcePath,
                                                                                text,
                                                                                0,
                                                                                coreir.LocalI32Tag,
                                                                                callOrdinal)
            if globalArrLoadSlot >= 0:
                return globalArrLoadSlot
            let rootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, indexRoot)
            if rootSlot >= 0 &&
               rootSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[rootSlot].typeKind == coreir.LocalStrTag:
                let indexSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                    slotNames,
                                                                    varI32ParamNames,
                                                                    typedIr,
                                                                    sourcePath,
                                                                    indexText,
                                                                    coreir.LocalI32Tag, callOrdinal)
                if indexSlot < 0:
                    return -1
                let valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                              slotNames,
                                                              text,
                                                              coreir.LocalI32Tag)
                var indexOp: coreir.BodyOp
                indexOp.kind = coreir.BodyOpLoadLocalTag
                indexOp.target = valueSlot
                add(indexOp.operands, coreir.BodyLoadLocalStrIndexU8Tag)
                add(indexOp.operands, rootSlot)
                add(indexOp.operands, indexSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, indexOp)
                return valueSlot
            if rootSlot >= 0 &&
               rootSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[rootSlot].typeKind == coreir.LocalAggregateTag:
                let indexSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                    slotNames,
                                                                    varI32ParamNames,
                                                                    typedIr,
                                                                    sourcePath,
                                                                    indexText,
                                                                    coreir.LocalI32Tag, callOrdinal)
                if indexSlot < 0:
                    return -1
                let valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                              slotNames,
                                                              text,
                                                              coreir.LocalI32Tag)
                if valueSlot < 0:
                    return -1
                var indexOp: coreir.BodyOp
                indexOp.kind = coreir.BodyOpIndexedLoadTag
                indexOp.target = valueSlot
                add(indexOp.operands, rootSlot)
                add(indexOp.operands, valueSlot)
                add(indexOp.operands, indexSlot)
                add(indexOp.operands, 4)
                # The Aggregate root here is a dynamic seq header (Cheng `[]`
                # types map to a {len,cap,buffer@+8} 16-byte header; struct/Result
                # roots use `.field`/no-`[]` indexing, never this elemSize-4
                # element load). For BOTH a local seq (slot holds the inline
                # header address) and a param seq (slot holds the incoming header
                # pointer) the element data lives one indirection away at
                # buffer(+8), so the address fill must deref the buffer field
                # before scaling the index. The operand[4]==1 flag drives that
                # +8 load in PrimaryBodyIRFillIndexedAggregateAddressToReg;
                # without it the index scaled off the header pointer itself
                # (reading len/cap/ptr bytes as elements — the seq-param element
                # miscompile).
                add(indexOp.operands, 1)
                let _ = coreir.BodyIRAppendOp(bodyIR, indexOp)
                return valueSlot
    if typeKind == coreir.LocalI32Tag &&
       texpr.TypedExprTextIsSimpleFieldPath(text):
        let rootName = texpr.TypedExprAssignLhsRootName(text)
        let fieldPath = texpr.TypedExprAssignFieldPath(text)
        let rootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rootName)
        var fieldLenRootOk = false
        if rootSlot >= 0 && rootSlot < bodyIR.localSlots.len:
            if bodyIR.localSlots[rootSlot].typeKind == coreir.LocalStrTag:
                fieldLenRootOk = true
            elif bodyIR.localSlots[rootSlot].typeKind == coreir.LocalAggregateTag &&
                 bodyIR.localSlots[rootSlot].auxValue == coreir.LocalStrTag &&
                 PrimaryBodyIrLocalIsParam(bodyIR.localSlots[rootSlot]):
                fieldLenRootOk = true
        if fieldLenRootOk &&
           fieldPath == "len":
            let lenSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                        slotNames,
                                                        text,
                                                        coreir.LocalI32Tag)
            if lenSlot < 0:
                return -1
            var lenOp: coreir.BodyOp
            lenOp.kind = coreir.BodyOpFieldLoadTag
            lenOp.target = lenSlot
            add(lenOp.operands, rootSlot)
            add(lenOp.operands, lenSlot)
            add(lenOp.operands, 8)
            add(lenOp.operands, 4)
            let _ = coreir.BodyIRAppendOp(bodyIR, lenOp)
            return lenSlot
    let sizeofValue = PrimaryBodyIrSizeofConst(typedIr, sourcePath, text)
    if sizeofValue >= 0:
        let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   text,
                                                   typeKind)
        if typeKind != coreir.LocalI32Tag &&
           typeKind != coreir.LocalI64Tag &&
           typeKind != coreir.LocalPtrTag:
            PrimaryObjectPlanTrace(strutil.Join(["phase=unsupported_const_emit source=sizeof text=",
                                                 text,
                                                 " type_kind=",
                                                 strings.IntToStr(typeKind),
                                                 " value=",
                                                 strings.IntToStr(sizeofValue),
                                                 " slot=",
                                                 strings.IntToStr(slotId)], ""))
        var sizeofOp: coreir.BodyOp
        sizeofOp.kind = coreir.BodyOpLoadConstTag
        sizeofOp.target = slotId
        add(sizeofOp.operands, typeKind)
        add(sizeofOp.operands, sizeofValue)
        let _ = coreir.BodyIRAppendOp(bodyIR, sizeofOp)
        return slotId
    if typeKind == coreir.LocalI64Tag:
        # bare global fixed int64[N] array element read (g[idx]): scaled global
        # element address + 8-byte IndexedLoad. Mirrors the i32 read above.
        let global64ArrLoadSlot = PrimaryBodyIrGlobalFixedArrayIndexedLoadSlot(bodyIR,
                                                                              slotNames,
                                                                              varI32ParamNames,
                                                                              typedIr,
                                                                              sourcePath,
                                                                              text,
                                                                              0,
                                                                              coreir.LocalI64Tag,
                                                                              callOrdinal)
        if global64ArrLoadSlot >= 0:
            return global64ArrLoadSlot
        var constVal64: int64
        if PrimaryBodyIrExtractInt64FromText(text, constVal64) &&
           (constVal64 > int64(2147483647) || constVal64 < int64(0) - int64(2147483648)):
            let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, text, coreir.LocalI64Tag)
            var const64Op: coreir.BodyOp
            const64Op.kind = coreir.BodyOpLoadConstTag
            const64Op.target = slotId
            add(const64Op.operands, coreir.LocalI64Tag)
            add(const64Op.operands, Int32(constVal64 & int64(65535)))
            add(const64Op.operands, Int32((constVal64 >> 16) & int64(65535)))
            add(const64Op.operands, Int32((constVal64 >> 32) & int64(65535)))
            add(const64Op.operands, Int32((constVal64 >> 48) & int64(65535)))
            let _ = coreir.BodyIRAppendOp(bodyIR, const64Op)
            return slotId
    let constVal = PrimaryBodyIrExtractIntFromText(text)
    if constVal != 0 || PrimaryBodyIrTextIsI32Zero(text):
        var constTypeKind = typeKind
        let primitiveConstTypeKind = PrimaryBodyIrPrimitiveCastConstTypeKind(text)
        if primitiveConstTypeKind != coreir.LocalInvalidTag:
            constTypeKind = primitiveConstTypeKind
        # Type-segregated const slot name: sharing one text slot across widths
        # would retype it and invalidate already-emitted ops.
        var constSlotName = strings.CloneStr(text)
        if constTypeKind != coreir.LocalI32Tag:
            constSlotName = Fmt"{text}#k{constTypeKind}"
        let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, constSlotName, constTypeKind)
        if constTypeKind != coreir.LocalI32Tag &&
           constTypeKind != coreir.LocalI64Tag &&
           constTypeKind != coreir.LocalPtrTag:
            PrimaryObjectPlanTrace(strutil.Join(["phase=unsupported_const_emit source=int text=",
                                                 text,
                                                 " type_kind=",
                                                 strings.IntToStr(constTypeKind),
                                                 " value=",
                                                 strings.IntToStr(constVal),
                                                 " slot=",
                                                 strings.IntToStr(slotId)], ""))
        var constOp: coreir.BodyOp
        constOp.kind = coreir.BodyOpLoadConstTag
        constOp.target = slotId
        add(constOp.operands, constTypeKind)
        add(constOp.operands, constVal)
        let _ = coreir.BodyIRAppendOp(bodyIR, constOp)
        return slotId
    if (typeKind == coreir.LocalI32Tag ||
        typeKind == coreir.LocalI64Tag ||
        typeKind == coreir.LocalF64Tag) &&
       len(text) > 1 && text[0] == '-':
        let negInner = strutil.Strip(strings.SliceBytes(text, 1, len(text) - 1))
        let negInnerSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               typedIr,
                                                               sourcePath,
                                                               negInner,
                                                               typeKind,
                                                               callOrdinal)
        if negInnerSlot >= 0:
            var negZeroSlot: int32
            var negOpKind = int32(texpr.TypedExprIrOpI32Sub)
            if typeKind == coreir.LocalF64Tag:
                negZeroSlot = PrimaryBodyIrLocalInitF64ConstSlot(bodyIR,
                                                                 slotNames,
                                                                 Fmt"#neg_zero#{bodyIR.ops.len}",
                                                                 "0.0")
                negOpKind = int32(texpr.TypedExprIrOpF64Sub)
            else:
                negZeroSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                              slotNames,
                                                              Fmt"#neg_zero#{bodyIR.ops.len}",
                                                              typeKind,
                                                              0)
            let negResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, text, typeKind)
            if negZeroSlot >= 0 && negResultSlot >= 0:
                var negOp: coreir.BodyOp
                negOp.kind = coreir.BodyOpBinOpTag
                negOp.target = negResultSlot
                add(negOp.operands, typeKind)
                add(negOp.operands, negOpKind)
                add(negOp.operands, negZeroSlot)
                add(negOp.operands, negInnerSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, negOp)
                return negResultSlot
    # F07: I64 限定 const 走 I64 表 (宽字面量); I32 仍走原 I32 表。形态不重叠。
    if typeKind == coreir.LocalI64Tag:
        var qualifiedConst64Found = false
        let qualifiedConst64Value = PrimaryBodyIrCanonicalConstInt64(typedIr,
                                                                      sourcePath,
                                                                      text,
                                                                      qualifiedConst64Found)
        if qualifiedConst64Found:
            let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, text, coreir.LocalI64Tag)
            var const64Op: coreir.BodyOp
            const64Op.kind = coreir.BodyOpLoadConstTag
            const64Op.target = slotId
            add(const64Op.operands, coreir.LocalI64Tag)
            if qualifiedConst64Value > int64(2147483647) ||
               qualifiedConst64Value < int64(0) - int64(2147483648):
                add(const64Op.operands, Int32(qualifiedConst64Value & int64(65535)))
                add(const64Op.operands, Int32((qualifiedConst64Value >> 16) & int64(65535)))
                add(const64Op.operands, Int32((qualifiedConst64Value >> 32) & int64(65535)))
                add(const64Op.operands, Int32((qualifiedConst64Value >> 48) & int64(65535)))
            else:
                add(const64Op.operands, Int32(qualifiedConst64Value))
            let _ = coreir.BodyIRAppendOp(bodyIR, const64Op)
            return slotId
    if typeKind == coreir.LocalI32Tag:
        var qualifiedConstFound = false
        let qualifiedConstValue = PrimaryBodyIrCanonicalConstI32(typedIr,
                                                                  sourcePath,
                                                                  text,
                                                                  qualifiedConstFound)
        if qualifiedConstFound:
            let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, text, coreir.LocalI32Tag)
            var constOp: coreir.BodyOp
            constOp.kind = coreir.BodyOpLoadConstTag
            constOp.target = slotId
            add(constOp.operands, coreir.LocalI32Tag)
            add(constOp.operands, qualifiedConstValue)
            let _ = coreir.BodyIRAppendOp(bodyIR, constOp)
            return slotId
    if typeKind == coreir.LocalI32Tag:
        var enumTypeName = ""
        var enumValue: int32
        if texpr.TypedExprIrLookupEnumConstValue(typedIr,
                                                sourcePath,
                                                text,
                                                enumTypeName,
                                                enumValue):
            # T28 current 根修: 之前用裸 `text` (枚举成员名, 如 "NormalizedExprIf")
            # 作槽名 — 同一函数体内两处非支配的兄弟分支 (如 if/elif 的不同臂)
            # 各自把同一枚举成员当标量 call-arg 传入时，FindOrCreateSlot 按名
            # 复用了第一次出现时创建的槽；第二处虽仍 unconditionally 生成
            # LoadConst op，但发射后与第一处共享同一物理栈槽，只有先出现的
            # 分支真正写入，另一分支的写在到达其调用点前从未执行 → 读到该槽
            # 从未初始化或被其它无关计算残留的垃圾 int32 (锚B: "if" 关键字
            # 扫描分支把 NormalizedExprIf(0) 读成残留的 7, fact.typeText 顺着
            # 错误的 DefaultInit kind 走 NormalizedExprDefaultInitType→"if"字面
            # 源码首词, 产出 "type-call fact must materialize composite ...
            # type=if")。同一枚举成员在别处已用 callOrdinal/argIndex/ops.len
            # make 槽名唯一强制重物化 (12078 条件操作数注释同款教训, 22210/
            # 22268 的 #qualconst#/#qualenum# 同款修法)；此处补齐裸(非限定)
            # 枚举成员 call-arg 分支同一防线。
            let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       strutil.Join(["#enumconst#", text, "#", strings.IntToStr(callOrdinal), "#", strings.IntToStr(bodyIR.ops.len)], ""),
                                                       coreir.LocalI32Tag)
            var constOp: coreir.BodyOp
            constOp.kind = coreir.BodyOpLoadConstTag
            constOp.target = slotId
            add(constOp.operands, coreir.LocalI32Tag)
            add(constOp.operands, enumValue)
            let _ = coreir.BodyIRAppendOp(bodyIR, constOp)
            return slotId
        let ptrDerefText = PrimaryBodyIrUInt8PtrDerefPointerText(text)
        if ptrDerefText != "":
            let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, text, coreir.LocalI32Tag)
            if !PrimaryBodyIrAppendUInt8PtrDerefLoad(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, text, slotId, callOrdinal):
                return -1
            return slotId
        let i32PtrDerefText = PrimaryBodyIrI32PtrDerefPointerText(text)
        if i32PtrDerefText != "":
            let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, text, coreir.LocalI32Tag)
            # W2C 裸 `*name` deref 宽度分派 (同 decl-init 臂): 指针 pointee 为
            # uint8 时必须 ldrb, 否则 I32 默认臂把字节读成 32 位窗口。解析失败
            # 或非 uint8: 让位 I32 臂, 宽度与行为不变。
            let bareDerefBindingType = PrimaryBodyIrCurrentCtxBindingTypeForName(typedIr, i32PtrDerefText)
            let bareDerefPointee = PrimaryBodyIrBarePointerPointeeType(typedIr, sourcePath, bareDerefBindingType)
            if bareDerefPointee == "uint8":
                if PrimaryBodyIrAppendU8PtrDerefLoadBare(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, i32PtrDerefText, slotId, callOrdinal):
                    return slotId
            if !PrimaryBodyIrAppendI32PtrDerefLoad(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, text, slotId, callOrdinal):
                return -1
            return slotId
    if typeKind == coreir.LocalI64Tag &&
       len(text) > 1 && text[1] != '(' &&
       PrimaryBodyIrI32PtrDerefPointerText(text) != "":
        # 裸 `*name` 宽解引用（声明形 ptr/i64，8字节机器字）：twin 臂已保留 i64 槽形。
        # 此前 i32 门内无 i64 臂，i64 槽落穿读栈垃圾。按 8 字节 U64 load 装入 i64
        # 临时（op 形同 AppendUInt64PtrDerefLoad）；显式 `*(Int32Ptr/UInt8Ptr(...))`
        # cast 形（text[1]=='('）不入此臂，窄语义不动。
        let wideDerefPtrText = PrimaryBodyIrI32PtrDerefPointerText(text)
        let wideDerefPtrSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, wideDerefPtrText, callOrdinal)
        if wideDerefPtrSlot < 0:
            return -1
        let wideDerefSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, text, coreir.LocalI64Tag)
        var wideDerefOp: coreir.BodyOp
        wideDerefOp.kind = coreir.BodyOpLoadLocalTag
        wideDerefOp.target = wideDerefSlot
        add(wideDerefOp.operands, coreir.BodyLoadLocalPtrDerefU64Tag)
        add(wideDerefOp.operands, wideDerefPtrSlot)
        add(wideDerefOp.operands, 8)
        let _ = coreir.BodyIRAppendOp(bodyIR, wideDerefOp)
        return wideDerefSlot
    if typeKind == coreir.LocalI32Tag ||
       typeKind == coreir.LocalI64Tag ||
       typeKind == coreir.LocalF64Tag:
        let ternaryQuestionPos = texpr.TypedExprFindTopLevelTextToken(text, "?")
        if typeKind != coreir.LocalF64Tag &&
           ternaryQuestionPos > 0 &&
           ternaryQuestionPos + 1 < len(text):
            let ternaryTail = strings.SliceBytes(text,
                                                 ternaryQuestionPos + 1,
                                                 len(text) - ternaryQuestionPos - 1)
            let ternaryColonRel = texpr.TypedExprFindTopLevelTextToken(ternaryTail, ":")
            if ternaryColonRel <= 0:
                return -1
            let ternaryCondText = strutil.Strip(strings.SliceBytes(text, 0, ternaryQuestionPos))
            let ternaryTrueText = strutil.Strip(strings.SliceBytes(ternaryTail, 0, ternaryColonRel))
            let ternaryFalseText = strutil.Strip(strings.SliceBytes(ternaryTail,
                                                                    ternaryColonRel + 1,
                                                                    len(ternaryTail) - ternaryColonRel - 1))
            if ternaryCondText == "" || ternaryTrueText == "" || ternaryFalseText == "":
                return -1
            # 急切无分支三元(delta=T-F;scaled=cond*delta;F+scaled)对两臂都求值——
            # 臂含真调用时未被选中的调用也会执行(副作用/panic)且冲掉 cond 槽，选错。
            # 仅当两臂都无真调用(内联 cast/分组括号安全)时才走无分支快路径；含真调用
            # 则让位(返回 -1)，由语句级真分支下降处理(只执行被选中臂)。
            if PrimaryBodyIrTextHasRealCallSurface(ternaryTrueText) ||
               PrimaryBodyIrTextHasRealCallSurface(ternaryFalseText):
                return -1
            # The cond is usually a relational compare (`1 > 0`, `a < b`); the
            # plain i32-value builder can only resolve a constant or bare bool
            # var, so a compare-cond ternary used as an arith operand was bailing
            # (return -1) — the whole RHS then dropped to an uninitialised slot.
            # Materialize a compare cond into a 0/1 slot (cmp+cset) first; only a
            # bare bool var/const falls back to the plain i32-value builder.
            var ternaryCondSlot = PrimaryBodyIrCmpCondValue01ScalarSlot(bodyIR,
                                                                        slotNames,
                                                                        varI32ParamNames,
                                                                        typedIr,
                                                                        sourcePath,
                                                                        ternaryCondText,
                                                                        Fmt"{text}#ternary_cond",
                                                                        callOrdinal)
            if ternaryCondSlot < 0:
                ternaryCondSlot = PrimaryBodyIrI32ValueSlotForText(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   ternaryCondText)
            let ternaryTrueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      typedIr,
                                                                      sourcePath,
                                                                      ternaryTrueText,
                                                                      typeKind,
                                                                      callOrdinal)
            let ternaryFalseSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       typedIr,
                                                                       sourcePath,
                                                                       ternaryFalseText,
                                                                       typeKind,
                                                                       callOrdinal)
            if ternaryCondSlot < 0 || ternaryTrueSlot < 0 || ternaryFalseSlot < 0:
                if PrimaryObjectPlanTraceActive():
                    PrimaryObjectPlanTrace(Fmt"phase=scalar_ternary_slot_missing text={text} cond_slot={ternaryCondSlot} true_slot={ternaryTrueSlot} false_slot={ternaryFalseSlot}")
                return -1
            let ternaryDeltaSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                 slotNames,
                                                                 Fmt"{text}#ternary_delta",
                                                                 typeKind)
            let ternaryScaledSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                  slotNames,
                                                                  Fmt"{text}#ternary_scaled",
                                                                  typeKind)
            let ternaryResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                  slotNames,
                                                                  Fmt"{text}#ternary_result",
                                                                  typeKind)
            if ternaryDeltaSlot < 0 || ternaryScaledSlot < 0 || ternaryResultSlot < 0:
                return -1
            var ternaryDeltaOp: coreir.BodyOp
            ternaryDeltaOp.kind = coreir.BodyOpBinOpTag
            ternaryDeltaOp.target = ternaryDeltaSlot
            add(ternaryDeltaOp.operands, typeKind)
            add(ternaryDeltaOp.operands, int32(texpr.TypedExprIrOpI32Sub))
            add(ternaryDeltaOp.operands, ternaryTrueSlot)
            add(ternaryDeltaOp.operands, ternaryFalseSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, ternaryDeltaOp)
            var ternaryScaledOp: coreir.BodyOp
            ternaryScaledOp.kind = coreir.BodyOpBinOpTag
            ternaryScaledOp.target = ternaryScaledSlot
            add(ternaryScaledOp.operands, typeKind)
            add(ternaryScaledOp.operands, int32(texpr.TypedExprIrOpI32Mul))
            add(ternaryScaledOp.operands, ternaryCondSlot)
            add(ternaryScaledOp.operands, ternaryDeltaSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, ternaryScaledOp)
            var ternaryResultOp: coreir.BodyOp
            ternaryResultOp.kind = coreir.BodyOpBinOpTag
            ternaryResultOp.target = ternaryResultSlot
            add(ternaryResultOp.operands, typeKind)
            add(ternaryResultOp.operands, int32(texpr.TypedExprIrOpI32Add))
            add(ternaryResultOp.operands, ternaryFalseSlot)
            add(ternaryResultOp.operands, ternaryScaledSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, ternaryResultOp)
            return ternaryResultSlot
        var binPos: int32 = -1
        var binKind: int32
        let bitOrPos = texpr.TypedExprFindTopLevelBitwiseTextToken(text, "|")
        let bitXorPos = texpr.TypedExprFindTopLevelBitwiseTextToken(text, "^")
        let bitAndPos = texpr.TypedExprFindTopLevelBitwiseTextToken(text, "&")
        let addPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '+')
        let subPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '-')
        let mulPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '*')
        let divPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '/')
        let modPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '%')
        let shrPos = texpr.TypedExprFindTopLevelTextToken(text, ">>")
        let shlPos = texpr.TypedExprFindTopLevelTextToken(text, "<<")
        var binOpLen: int32
        binOpLen = 1
        if typeKind == coreir.LocalF64Tag:
            let f64AddPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '+')
            let f64SubPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '-')
            let f64MulPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '*')
            let f64DivPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '/')
            if f64AddPos > 0 || f64SubPos > 0:
                if f64AddPos > f64SubPos:
                    binPos = f64AddPos
                    binKind = int32(texpr.TypedExprIrOpF64Add)
                else:
                    binPos = f64SubPos
                    binKind = int32(texpr.TypedExprIrOpF64Sub)
            elif f64MulPos > 0 || f64DivPos > 0:
                if f64MulPos > f64DivPos:
                    binPos = f64MulPos
                    binKind = int32(texpr.TypedExprIrOpF64Mul)
                else:
                    binPos = f64DivPos
                    binKind = int32(texpr.TypedExprIrOpF64Div)
        elif bitOrPos > 0:
            binPos = bitOrPos
            binKind = int32(texpr.TypedExprIrOpI32BitOr)
        elif bitXorPos > 0:
            binPos = bitXorPos
            binKind = int32(texpr.TypedExprIrOpI32BitXor)
        elif bitAndPos > 0:
            binPos = bitAndPos
            binKind = int32(texpr.TypedExprIrOpI32BitAnd)
        elif addPos > 0 || subPos > 0:
            # additive class is left-associative: split at the rightmost +/-
            if addPos > subPos:
                binPos = addPos
                binKind = int32(texpr.TypedExprIrOpI32Add)
            else:
                binPos = subPos
                binKind = int32(texpr.TypedExprIrOpI32Sub)
        elif mulPos > 0 || divPos > 0 || modPos > 0:
            # multiplicative class is left-associative: rightmost of *,/,%
            binPos = mulPos
            binKind = int32(texpr.TypedExprIrOpI32Mul)
            if divPos > binPos:
                binPos = divPos
                binKind = int32(texpr.TypedExprIrOpI32Sdiv)
            if modPos > binPos:
                binPos = modPos
                binKind = -100
        elif shrPos > 0:
            binPos = shrPos
            binKind = int32(texpr.TypedExprIrOpI32Asr)
            binOpLen = 2
        elif shlPos > 0:
            binPos = shlPos
            binKind = int32(texpr.TypedExprIrOpI32Lsl)
            binOpLen = 2
        if binPos > 0 && binPos + binOpLen < len(text):
            let lhsText = strutil.Strip(strings.SliceBytes(text, 0, binPos))
            if typeKind != coreir.LocalF64Tag &&
               binKind == int32(texpr.TypedExprIrOpI32Asr) &&
               (PrimaryBodyIrShiftRightLhsIsUnsignedCast(lhsText) ||
                PrimaryBodyIrCurrentShiftLhsIsUnsigned(typedIr, lhsText)):
                binKind = int32(texpr.TypedExprIrOpI32Lsr)
            let rhsText = strutil.Strip(strings.SliceBytes(text,
                                                           binPos + binOpLen,
                                                           len(text) - binPos - binOpLen))
            if lhsText == "" || rhsText == "":
                return -1
            let lhsSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              typedIr,
                                                              sourcePath,
                                                              lhsText,
                                                              typeKind, callOrdinal)
            let rhsSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              typedIr,
                                                              sourcePath,
                                                              rhsText,
                                                              typeKind, callOrdinal)
            if lhsSlot < 0 || rhsSlot < 0:
                return -1
            let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, text, typeKind)
            if binKind == -100:
                let quotientSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                 slotNames,
                                                                 Fmt"{text}#quotient",
                                                                 typeKind)
                let productSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                               slotNames,
                                                               Fmt"{text}#product",
                                                               typeKind)
                if quotientSlot < 0 || productSlot < 0 || slotId < 0:
                    return -1
                var divOp: coreir.BodyOp
                divOp.kind = coreir.BodyOpBinOpTag
                divOp.target = quotientSlot
                add(divOp.operands, typeKind)
                add(divOp.operands, int32(texpr.TypedExprIrOpI32Sdiv))
                add(divOp.operands, lhsSlot)
                add(divOp.operands, rhsSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, divOp)
                var mulOp: coreir.BodyOp
                mulOp.kind = coreir.BodyOpBinOpTag
                mulOp.target = productSlot
                add(mulOp.operands, typeKind)
                add(mulOp.operands, int32(texpr.TypedExprIrOpI32Mul))
                add(mulOp.operands, quotientSlot)
                add(mulOp.operands, rhsSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, mulOp)
                var remOp: coreir.BodyOp
                remOp.kind = coreir.BodyOpBinOpTag
                remOp.target = slotId
                add(remOp.operands, typeKind)
                add(remOp.operands, int32(texpr.TypedExprIrOpI32Sub))
                add(remOp.operands, lhsSlot)
                add(remOp.operands, productSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, remOp)
                return slotId
            if slotId < 0:
                return -1
            var binOp: coreir.BodyOp
            binOp.kind = coreir.BodyOpBinOpTag
            binOp.target = slotId
            add(binOp.operands, typeKind)
            add(binOp.operands, binKind)
            add(binOp.operands, lhsSlot)
            add(binOp.operands, rhsSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, binOp)
            return slotId
    # [bodyir-ownership-wall] Impl 尾部「裸文本 → 既有槽」臂入口探针（只读）：这是
    # `s.values[…]` 这类文本在语句 3 上最可能走到的收尾臂（`FindArgSlot` 命中已建槽）。
    primarySlotStageProbe(bodyIR, "impl_generic_text_arm", 16543)
    let slotId = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, text)
    if os.GetEnv("CHENG_X64_DBG4") != "":
        var dbg4SlotType: int32 = -1
        if slotId >= 0:
            dbg4SlotType = PrimaryBodyIrSlotType(bodyIR, slotId)
        os.WriteLine(os.GetStderr(), Fmt"x64dbg4 scalar_ident text=[{text}] type_kind={typeKind} slot={slotId} slot_type={dbg4SlotType}")
    if slotId >= 0:
        if PrimaryBodyIrNameInList(varI32ParamNames, text):
            return PrimaryBodyIrI32ValueSlotForText(bodyIR, slotNames, varI32ParamNames, text)
        if typeKind == coreir.LocalI64Tag &&
           PrimaryBodyIrVarParamPointeeKind(bodyIR, slotId) == coreir.LocalI64Tag:
            let valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          PrimaryBodyIrVarI64ValueSlotName(text),
                                                          coreir.LocalI64Tag)
            PrimaryBodyIrAppendVarI64Load(bodyIR, slotId, valueSlot)
            if PrimaryObjectPlanTraceActive():
                PrimaryObjectPlanTrace(Fmt"phase=scalar_load_var_i64 text={text} address_slot={slotId} value_slot={valueSlot}")
            return valueSlot
        if PrimaryBodyIrSlotType(bodyIR, slotId) == typeKind:
            return slotId
        if typeKind == coreir.LocalI64Tag &&
           (PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI32Tag ||
            PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalPtrTag):
            let widenedSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                            slotNames,
                                                            Fmt"i64({text})",
                                                            coreir.LocalI64Tag)
            var widenOp: coreir.BodyOp
            widenOp.kind = coreir.BodyOpCopyLocalTag
            widenOp.target = widenedSlot
            add(widenOp.operands, slotId)
            let _ = coreir.BodyIRAppendOp(bodyIR, widenOp)
            if PrimaryObjectPlanTraceActive():
                PrimaryObjectPlanTrace(Fmt"phase=scalar_widen_to_i64 text={text} source_slot={slotId} target_slot={widenedSlot}")
            return widenedSlot
        if typeKind == coreir.LocalI32Tag &&
           PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI64Tag:
            let narrowedSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                             slotNames,
                                                             Fmt"i32({text})",
                                                             coreir.LocalI32Tag)
            if narrowedSlot < 0:
                return -1
            var narrowOp: coreir.BodyOp
            narrowOp.kind = coreir.BodyOpCopyLocalTag
            narrowOp.target = narrowedSlot
            add(narrowOp.operands, slotId)
            let _ = coreir.BodyIRAppendOp(bodyIR, narrowOp)
            return narrowedSlot
        return -1
    if typeKind == coreir.LocalI64Tag:
        # Width adaptation: resolve the expression as i32 and sign-extend.
        let narrowResolved = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 typedIr,
                                                                 sourcePath,
                                                                 text,
                                                                 coreir.LocalI32Tag, callOrdinal)
        if narrowResolved >= 0 &&
           narrowResolved < bodyIR.localSlots.len &&
           PrimaryBodyIrSlotType(bodyIR, narrowResolved) == coreir.LocalI32Tag:
            let narrowWidenSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                slotNames,
                                                                Fmt"i64({text})",
                                                                coreir.LocalI64Tag)
            var narrowWidenOp: coreir.BodyOp
            narrowWidenOp.kind = coreir.BodyOpCopyLocalTag
            narrowWidenOp.target = narrowWidenSlot
            add(narrowWidenOp.operands, narrowResolved)
            let _ = coreir.BodyIRAppendOp(bodyIR, narrowWidenOp)
            return narrowWidenSlot
    let globalType = PrimaryBodyIrTypedGlobalType(typedIr, sourcePath, text)
    if globalType == "":
        # A text-only call has no resolved declaration tuple. The call-aware
        # structured path must own it; synthesizing by name is overload-unsafe.
        return -1
    var globalTypeKind: int32
    var globalSizeBytes: int32
    var globalAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   globalType,
                                   globalTypeKind,
                                   globalSizeBytes,
                                   globalAlignBytes)
    if globalTypeKind != typeKind:
        return -1
    if globalTypeKind == coreir.LocalAggregateTag:
        # 聚合全局(Bytes 等)走地址物化(GlobalSeqAddressSlot),
        # 不发标量 GlobalLoad 零宽 op(镜像 NodeEvalGlobalLoadSlot 3965 / 9447 函数 9423)
        return PrimaryBodyIrGlobalSeqAddressSlot(bodyIR,
                                                  slotNames,
                                                  typedIr,
                                                  sourcePath,
                                                  text)
    let globalSlotName = PrimaryBodyIrTypedGlobalSlotName(typedIr, sourcePath, text)
    if globalSlotName == "":
        return -1
    let globalSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   globalSlotName,
                                                   typeKind)
    PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, globalSlot)
    bodyIR.localSlots[globalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
    let valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"{globalSlotName}#global_value",
                                                  typeKind)
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpGlobalLoadTag
    op.target = valueSlot
    add(op.operands, globalSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    return valueSlot

@borrows
fn PrimaryBodyIrAddressSlotForName(bodyIR: var coreir.BodyIR,
                                    slotNames: var str[],
                                    lowering: var lower.LoweringPlanStub,
                                    typedFn: texpr.TypedExprIrFunction,
                                    irFunction: lower.PrimaryObjectIrFunction,
                                    sourcePath: str,
                                    lineNumber: int32,
                                    nameRaw: str,
                                    rootTypeHintName: str,
                                    rootTypeHint: str,
                                    addressPassKind: var int32): int32 =
    let name = strutil.Strip(nameRaw)
    addressPassKind = coreir.BodyCallPassParamAddressTag
    if name == "":
        addressPassKind = -1
        return -1
    if texpr.TypedExprTextIsSimpleFieldPath(name):
        let rootName = texpr.TypedExprAssignLhsRootName(name)
        let fieldPath = texpr.TypedExprAssignFieldPath(name)
        if rootName == "" || fieldPath == "":
            addressPassKind = -2
            return -1
        var rootType = ""
        if rootTypeHintName == rootName && rootTypeHint != "":
            rootType = rootTypeHint
        if rootType == "":
            rootType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       lineNumber,
                                                       rootName)
        if rootType == "" || rootType == "unknown" || !PrimaryObjectMetadataTextStable(rootType):
            addressPassKind = -3
            return -1
        if PrimaryBodyIrTypeTextIsGenericPointer(rootType):
            addressPassKind = -10
            return -1
        var ownerType = strings.CloneStr(rootType)
        let pointeeType = PrimaryBodyIrPointeeTypeTextForSource(lowering.typedIr,
                                                                sourcePath,
                                                                rootType)
        # wave6 R-D (44-C1 ref 布局基建续篇): ref-object 根 (a: RefI32) 的
        # &a.field — ref 句柄槽本身是 8B 指针 (44-C1), 字段地址语义 = 指针值 +
        # 偏移, 与 `T *` 根同款按值传根指针 (offset==0 门下即根指针本身)。
        # ownerType 保持 ref 类型名 (字段 meta 按 ref 类型注册, f7b 读路径实测
        # 已通)。原先落 ParamAddressTag 会传 &槽 = 指针的指针, 静默错址。
        var rootIsRefObject: bool
        if pointeeType == "":
            rootIsRefObject = texpr.TypedExprIrTypeIsRef(lowering.typedIr, sourcePath, rootType)
        var passRootPointer: bool
        if pointeeType != "":
            passRootPointer = true
        if rootIsRefObject:
            passRootPointer = true
        if passRootPointer && !rootIsRefObject:
            ownerType = strings.CloneStr(pointeeType)
            if ownerType == "":
                addressPassKind = -11
                return -1
        var fieldType = ""
        var fieldOffsetBytes: int32
        var fieldSizeBytes: int32
        var fieldAlignBytes: int32
        var fieldMetaOk = PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                                             sourcePath,
                                                             ownerType,
                                                             fieldPath,
                                                             fieldType,
                                                             fieldOffsetBytes,
                                                             fieldSizeBytes,
                                                             fieldAlignBytes)
        if !fieldMetaOk && PrimaryBodyIrTextHasDot(fieldPath):
            fieldMetaOk = texpr.TypedExprIrLookupFieldPathMeta(lowering.typedIr,
                                                               sourcePath,
                                                               ownerType,
                                                               fieldPath,
                                                               fieldType,
                                                               fieldOffsetBytes,
                                                               fieldSizeBytes,
                                                               fieldAlignBytes)
        if !fieldMetaOk:
            if pointeeType == "":
                addressPassKind = -12
            elif ownerType == "ChengMemHeader" && fieldPath == "rc":
                addressPassKind = -13
            elif ownerType == "ChengMemHeader":
                addressPassKind = -14
            elif fieldPath == "rc":
                addressPassKind = -15
            else:
                addressPassKind = -4
            return -1
        if fieldOffsetBytes != 0:
            addressPassKind = -5
            return -1
        let rootSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                              slotNames,
                                                              lowering.typedIr,
                                                              sourcePath,
                                                              rootName,
                                                              rootType)
        if rootSlot < 0 || rootSlot >= bodyIR.localSlots.len:
            addressPassKind = -6
            return -1
        if passRootPointer:
            if PrimaryBodyIrSlotType(bodyIR, rootSlot) != coreir.LocalPtrTag:
                addressPassKind = -7
                return -1
            addressPassKind = coreir.BodyCallPassStackValueTag
        return rootSlot
    let localSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, name)
    if localSlot >= 0:
        return localSlot
    let bindingType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                      typedFn,
                                                      irFunction,
                                                      lineNumber,
                                                      name)
    if bindingType != "":
        return PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                  slotNames,
                                                  lowering.typedIr,
                                                  sourcePath,
                                                  name,
                                                  bindingType)
    let functionIndex = PrimaryPlanResolveTargetIndex(lowering,
                                                      sourcePath,
                                                      name)
    if PrimaryObjectPlanTraceActive():
        PrimaryObjectPlanTrace(Fmt"phase=address_function_lookup source={sourcePath} name={name} function_index={functionIndex}")
    if functionIndex >= 0:
        let functionSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                         slotNames,
                                                         PrimaryBodyIrFunctionAddressSlotName(functionIndex),
                                                         coreir.LocalPtrTag)
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"phase=address_function_slot name={name} function_index={functionIndex} slot={functionSlot} slots={bodyIR.localSlots.len}")
        if functionSlot < 0 || functionSlot >= bodyIR.localSlots.len:
            addressPassKind = -16
            return -1
        PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, functionSlot)
        bodyIR.localSlots[functionSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
        return functionSlot
    let globalType = PrimaryBodyIrTypedGlobalType(lowering.typedIr, sourcePath, name)
    if globalType == "":
        addressPassKind = -8
        return -1
    let globalSlotName = PrimaryBodyIrTypedGlobalSlotName(lowering.typedIr, sourcePath, name)
    if globalSlotName == "":
        addressPassKind = -9
        return -1
    var typeKind: int32
    var sizeBytes: int32
    var alignBytes: int32
    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                   sourcePath,
                                   globalType,
                                   typeKind,
                                   sizeBytes,
                                   alignBytes)
    let globalSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                        slotNames,
                                                        globalSlotName,
                                                        typeKind,
                                                        sizeBytes,
                                                        alignBytes)
    PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, globalSlot)
    bodyIR.localSlots[globalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
    return globalSlot

@borrows
fn PrimaryBodyIrLocalInitConstSlot(bodyIR: var coreir.BodyIR,
                                    slotNames: var str[],
                                    nameRaw: str,
                                    typeKind: int32,
                                    value: int32): int32 =
    let name = strutil.Strip(nameRaw)
    if name == "":
        return -1
    let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                               slotNames,
                                               name,
                                               typeKind)
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpLoadConstTag
    op.target = slotId
    add(op.operands, typeKind)
    add(op.operands, value)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    return slotId

@borrows
fn PrimaryBodyIrLocalInitF64ConstSlot(bodyIR: var coreir.BodyIR,
                                      slotNames: var str[],
                                      nameRaw: str,
                                      literalRaw: str): int32 =
    let name = strutil.Strip(nameRaw)
    if name == "":
        return -1
    let slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                               slotNames,
                                               name,
                                               coreir.LocalF64Tag)
    if slotId < 0:
        return -1
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpLoadConstTag
    op.target = slotId
    if !PrimaryBodyIrAppendF64ConstOperands(op, literalRaw):
        return -1
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    return slotId

@borrows
fn PrimaryBodyIrTernaryValueSlotForStmt(bodyIR: var coreir.BodyIR,
                                         slotNames: var str[],
                                         varI32ParamNames: str[],
                                         typedIr: texpr.TypedExprIr,
                                         stmt: lower.PrimaryObjectIrStatement,
                                         targetTypeKind: int32): int32 =
    if stmt.assignValueOpKind != texpr.TypedExprIrOpLocalBoolEnumTernary:
        return -1
    if targetTypeKind != coreir.LocalI32Tag &&
       targetTypeKind != coreir.LocalI64Tag:
        return -1
    let condText = strutil.Strip(stmt.assignValueLhsText)
    let trueText = strutil.Strip(stmt.assignValueRhsText)
    let falseText = strutil.Strip(stmt.conditionRhsText)
    if condText == "" || trueText == "" || falseText == "":
        return -1
    # 急切无分支三元对两臂都求值——臂含真调用时未被选中的调用也会执行。
    # 与 ScalarValueSlotForTextImpl(11325) 同守卫：含调用则让位给语句级真分支。
    if PrimaryBodyIrTextHasRealCallSurface(trueText) ||
       PrimaryBodyIrTextHasRealCallSurface(falseText):
        return -1
    # T78: cond 含 `&&`/`||` 时下面的 I32ValueSlotForText 只是裸标识符/常量查找
    # （无比较/位运算能力），会把整段 `&&` 文本当槽名查找——多半查无, 但一旦
    # 恰好命中同名孤儿槽就会读栈残留值当 cond 静默参与select(未验证的假 0/1)。
    # 诚实 bail，让位给上层 AppendScalarTernaryBlockValue 真分支 CBR 链
    # (T78 尚未支持 &&/|| cond 分支下降，见调用点 PARTIAL 备注)。
    if PrimaryBodyIrConditionHasAnd(condText) || PrimaryBodyIrConditionHasOr(condText):
        return -1
    # 标量臂三元解析不参与外层调用序列：ordinal=-1 禁用调用物化（仿 ConditionFieldOperandSlot）
    var callOrdinal: int32 = -1
    let condSlot = PrimaryBodyIrI32ValueSlotForText(bodyIR,
                                                    slotNames,
                                                    varI32ParamNames,
                                                    condText)
    let trueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       typedIr,
                                                       stmt.sourcePath,
                                                       trueText,
                                                       targetTypeKind, callOrdinal)
    let falseSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                        slotNames,
                                                        varI32ParamNames,
                                                        typedIr,
                                                        stmt.sourcePath,
                                                        falseText,
                                                        targetTypeKind, callOrdinal)
    if condSlot < 0 || trueSlot < 0 || falseSlot < 0:
        PrimaryObjectPlanTrace(strutil.Join(["phase=ternary_slot_missing function=",
                                             strings.CloneStr(stmt.functionName),
                                             " line=",
                                             strings.IntToStr(stmt.lineNumber),
                                             " target_type=",
                                             strings.IntToStr(targetTypeKind),
                                             " cond=",
                                             strings.CloneStr(condText),
                                             " cond_slot=",
                                             strings.IntToStr(condSlot),
                                             " true=",
                                             strings.CloneStr(trueText),
                                             " true_slot=",
                                             strings.IntToStr(trueSlot),
                                             " false=",
                                             strings.CloneStr(falseText),
                                             " false_slot=",
                                             strings.IntToStr(falseSlot)], ""))
        return -1
    let deltaSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"{stmt.bindingName}#ternary_delta#{stmt.lineNumber}",
                                                  targetTypeKind)
    let scaledSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   Fmt"{stmt.bindingName}#ternary_scaled#{stmt.lineNumber}",
                                                   targetTypeKind)
    let resultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   Fmt"{stmt.bindingName}#ternary_result#{stmt.lineNumber}",
                                                   targetTypeKind)
    if deltaSlot < 0 || scaledSlot < 0 || resultSlot < 0:
        return -1
    var deltaOp: coreir.BodyOp
    deltaOp.kind = coreir.BodyOpBinOpTag
    deltaOp.target = deltaSlot
    add(deltaOp.operands, targetTypeKind)
    add(deltaOp.operands, int32(texpr.TypedExprIrOpI32Sub))
    add(deltaOp.operands, trueSlot)
    add(deltaOp.operands, falseSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, deltaOp)
    var scaledOp: coreir.BodyOp
    scaledOp.kind = coreir.BodyOpBinOpTag
    scaledOp.target = scaledSlot
    add(scaledOp.operands, targetTypeKind)
    add(scaledOp.operands, int32(texpr.TypedExprIrOpI32Mul))
    add(scaledOp.operands, condSlot)
    add(scaledOp.operands, deltaSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, scaledOp)
    var resultOp: coreir.BodyOp
    resultOp.kind = coreir.BodyOpBinOpTag
    resultOp.target = resultSlot
    add(resultOp.operands, targetTypeKind)
    add(resultOp.operands, int32(texpr.TypedExprIrOpI32Add))
    add(resultOp.operands, falseSlot)
    add(resultOp.operands, scaledSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, resultOp)
    return resultSlot

@borrows
fn PrimaryBodyIrLocalInitValueSlot(bodyIR: var coreir.BodyIR,
                                    slotNames: var str[],
                                    varI32ParamNames: str[],
                                    typedIr: texpr.TypedExprIr,
                                    sourcePath: str,
                                    targetTypeRaw: str,
                                    targetTypeKind: int32,
                                    textRaw: str,
                                    callOrdinal: var int32): int32 =
    var text = strutil.Strip(textRaw)
    if text == "":
        return -1
    let castInner = PrimaryBodyIrTypeCastInnerForTarget(text, targetTypeRaw)
    let hasCastInner = castInner != ""
    if hasCastInner:
        text = strings.CloneStr(castInner)
    if targetTypeKind == coreir.LocalI64Tag &&
       PrimaryBodyIrUInt64PtrDerefPointerText(text) != "":
        let u64DerefSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, text, coreir.LocalI64Tag)
        if u64DerefSlot >= 0 &&
           PrimaryBodyIrAppendUInt64PtrDerefLoad(bodyIR, slotNames, varI32ParamNames, typedIr, sourcePath, text, u64DerefSlot, callOrdinal):
            return u64DerefSlot
        return -1
    if targetTypeKind == coreir.LocalStrTag &&
       PrimaryBodyIrTextIsStringLiteral(text):
        return -1
    let sizeofValue = PrimaryBodyIrSizeofConst(typedIr, sourcePath, text)
    if sizeofValue >= 0:
        return PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                              slotNames,
                                              Fmt"{targetTypeRaw}({text})",
                                              targetTypeKind,
                                              sizeofValue)
    let directSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, text)
    if directSlot >= 0:
        if PrimaryBodyIrSlotType(bodyIR, directSlot) == targetTypeKind:
            return directSlot
        if targetTypeKind == coreir.LocalI64Tag &&
           PrimaryBodyIrVarParamPointeeKind(bodyIR, directSlot) == coreir.LocalI64Tag:
            let valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          PrimaryBodyIrVarI64ValueSlotName(text),
                                                          coreir.LocalI64Tag)
            PrimaryBodyIrAppendVarI64Load(bodyIR, directSlot, valueSlot)
            if PrimaryObjectPlanTraceActive():
                PrimaryObjectPlanTrace(Fmt"phase=local_init_load_var_i64 text={text} address_slot={directSlot} value_slot={valueSlot}")
            return valueSlot
        if targetTypeKind == coreir.LocalI64Tag &&
           PrimaryBodyIrSlotType(bodyIR, directSlot) == coreir.LocalI32Tag:
            return directSlot
        if targetTypeKind == coreir.LocalI32Tag &&
           PrimaryBodyIrSlotType(bodyIR, directSlot) == coreir.LocalI64Tag:
            let castSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                         slotNames,
                                                         Fmt"{targetTypeRaw}({text})",
                                                         coreir.LocalI32Tag)
            var castOp: coreir.BodyOp
            castOp.kind = coreir.BodyOpCopyLocalTag
            castOp.target = castSlot
            add(castOp.operands, directSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, castOp)
            return castSlot
        return -1
    if targetTypeKind == coreir.LocalPtrTag:
        let strDataInner = PrimaryBodyIrWholeCallInnerForHead(text, "StrDataPtr")
        if strDataInner != "":
            let strSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, strDataInner)
            if strSlot < 0 ||
               strSlot >= bodyIR.localSlots.len ||
               PrimaryBodyIrSlotType(bodyIR, strSlot) != coreir.LocalStrTag:
                return -1
            let dataSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                         slotNames,
                                                         text,
                                                         coreir.LocalPtrTag)
            if dataSlot < 0:
                return -1
            var dataOp: coreir.BodyOp
            dataOp.kind = coreir.BodyOpFieldLoadTag
            dataOp.target = dataSlot
            add(dataOp.operands, strSlot)
            add(dataOp.operands, dataSlot)
            add(dataOp.operands, 0)
            add(dataOp.operands, 8)
            let _ = coreir.BodyIRAppendOp(bodyIR, dataOp)
            return dataSlot
        let scalar64Slot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               typedIr,
                                                               sourcePath,
                                                               text,
                                                               coreir.LocalI64Tag, callOrdinal)
        if scalar64Slot >= 0:
            let ptrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                        slotNames,
                                                        Fmt"{targetTypeRaw}({text})",
                                                        coreir.LocalPtrTag)
            var ptrCopyOp: coreir.BodyOp
            ptrCopyOp.kind = coreir.BodyOpCopyLocalTag
            ptrCopyOp.target = ptrSlot
            add(ptrCopyOp.operands, scalar64Slot)
            let _ = coreir.BodyIRAppendOp(bodyIR, ptrCopyOp)
            return ptrSlot
    let scalarSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         typedIr,
                                                         sourcePath,
                                                         text,
                                                         targetTypeKind, callOrdinal)
    if scalarSlot >= 0:
        return scalarSlot
    if targetTypeKind == coreir.LocalI32Tag && hasCastInner:
        let wideSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                           slotNames,
                                                           varI32ParamNames,
                                                           typedIr,
                                                           sourcePath,
                                                           text,
                                                           coreir.LocalI64Tag, callOrdinal)
        if wideSlot >= 0:
            let narrowSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"{targetTypeRaw}({text})",
                                                           coreir.LocalI32Tag)
            var narrowOp: coreir.BodyOp
            narrowOp.kind = coreir.BodyOpCopyLocalTag
            narrowOp.target = narrowSlot
            add(narrowOp.operands, wideSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, narrowOp)
            if PrimaryObjectPlanTraceActive():
                PrimaryObjectPlanTrace(Fmt"phase=local_init_narrow_i64 text={text} wide_slot={wideSlot} narrow_slot={narrowSlot}")
            return narrowSlot
    return -1

@borrows
fn PrimaryBodyIrIndirectCallIntrinsic(nameRaw: str): bool =
    return nameRaw == "cheng_call_ptr_i32_raw" ||
           nameRaw == "cheng_call_ptr_void_raw" ||
           nameRaw == "cheng_call_ptr_sret_agg1_raw"

@borrows
fn PrimaryBodyIrDirectExternalCallTarget(symbolRaw: str): bool =
    if symbolRaw == "std/system::assert":
        return true
    if symbolRaw == "std/system::Assert":
        return true
    if symbolRaw == "driver_c_str_from_utf8_copy_bridge":
        return true
    if symbolRaw == "driver_c_str_alloc_bridge":
        return true
    if symbolRaw == "driver_c_get_env_bridge":
        return true
    if symbolRaw == "driver_c_str_slice_bridge":
        return true
    if symbolRaw == "cheng_i32_to_str_bridge":
        return true
    if symbolRaw == "cheng_i64_to_str_bridge":
        return true
    # #62 根修: f64->i32/i64 pure-cast rescue (:24193-24197 与 backend2 镜像
    # :14964-14968) 合成的 CallOp 目标——host_runtime.c 提供的 C provider bridge
    # (int32_t cheng_f64_to_i32(double)/int64_t cheng_f64_to_i64(double))，无
    # Cheng 侧函数体可达，冷后端 cheng_cold.c:39448-39449 早已同款白名单放行。
    # 自举侧此前漏收，致任何 int(floatExpr)/int64(floatExpr) 转换在 reachability
    # 阶段被当作缺失调用目标 bail（math.cheng floorFloat 等实测命中）。
    if symbolRaw == "cheng_f64_to_i32":
        return true
    if symbolRaw == "cheng_f64_to_i64":
        return true
    if symbolRaw == "cheng_malloc":
        return true
    if symbolRaw == "cheng_mem_retain":
        return true
    if symbolRaw == "cheng_mem_release":
        return true
    if symbolRaw == "cheng_mem_retain_atomic":
        return true
    if symbolRaw == "cheng_mem_release_atomic":
        return true
    if symbolRaw == "copyMem":
        return true
    if symbolRaw == "setMem":
        return true
    if symbolRaw == "ptr_add":
        return true
    if symbolRaw == "cheng_ptr_plus":
        return true
    if symbolRaw == "__cheng_runtime_ptr_slot_load_raw":
        return true
    if symbolRaw == "__cheng_runtime_ptr_slot_store_raw":
        return true
    if symbolRaw == "cheng_rawmem_write_i8":
        return true
    if symbolRaw == "cheng_rawmem_write_char":
        return true
    if symbolRaw == "cheng_seq_str_add":
        return true
    if symbolRaw == "cheng_str_store_managed":
        return true
    # scope-exit release pass 合成的释放调用 (PrimaryBodyIrScopeExitEmitRelease)
    # —— 目标为 provider 导出 (program_support_backend.cheng
    # @exportc("cheng_str_release_scope")), 无 Cheng 侧函数体可达, 与
    # cheng_malloc/cheng_mem_release 同款, 白名单放行。
    if symbolRaw == "cheng_str_release_scope":
        return true
    if symbolRaw == "cheng_str_drop_owned":
        return true
    if symbolRaw == "cheng_str_snapshot_retain_owned":
        return true
    # [wall118] var-ptr ABI glue 合成释放调用 (CleanupPlan drop/retain unit
    # 按 structural kind=RefObject 绑定的目标, 见
    # ownership_body_ir_production CleanupPlanBindOwnershipDropGlue 段;
    # program_support_backend.cheng @exportc("cheng_ref_drop_owned") /
    # @exportc("cheng_ref_retain_owned")), 8B ref 句柄槽地址实参, 与
    # cheng_str_drop_owned 同款白名单放行。
    if symbolRaw == "cheng_ref_drop_owned":
        return true
    if symbolRaw == "cheng_ref_retain_owned":
        return true
    if symbolRaw == "cheng_seq_store_plain_managed":
        return true
    if symbolRaw == "cheng_str_move_store_managed":
        return true
    if symbolRaw == "cheng_seq_move_store_plain_managed":
        return true
    if symbolRaw == "cheng_seq_set_grow":
        return true
    if symbolRaw == "cheng_seq_set_len":
        return true
    if symbolRaw == "cheng_seq_drop_str_field_tail":
        return true
    if symbolRaw == "cheng_seq_grow_inst":
        return true
    if symbolRaw == "cheng_seq_header_len_get":
        return true
    if symbolRaw == "cheng_strutils_join_bridge":
        return true
    # wall93: Fmt 臂合成的 parts-only join 调用目标 (无源 call 行可消费,
    # 与上一行 join 桥同理由): 不入列则 PatchCallTargetSymbols 会误吞源行。
    if symbolRaw == "cheng_strformat_fmt_bridge":
        return true
    if symbolRaw == "driver_c_str_concat_bridge":
        return true
    if symbolRaw == "__cheng_call_indirect_sret_agg1":
        return true
    if symbolRaw == "__cheng_call_indirect_void":
        return true
    if symbolRaw == "puts":
        return true
    if symbolRaw == "exit":
        return true
    return false

@borrows
fn PrimaryBodyIrCanonicalCallTargetSymbol(symbolRaw: str): str =
    let symbolTail = PrimaryCallTargetTailName(symbolRaw)
    if symbolTail == "SliceBytes":
        return "driver_c_str_slice_bridge"
    if symbolTail == "ParamCount":
        return "paramCount"
    if symbolTail == "IntToStr":
        return "cheng_i32_to_str_bridge"
    if symbolTail == "Int64ToStr":
        return "cheng_i64_to_str_bridge"
    if symbolTail == "StrDataPtr" || symbolTail == "strDataPtr":
        return "std/system::StrDataPtr"
    if symbolTail == "StrLenFast" || symbolTail == "strLenFast":
        return symbolTail
    if symbolTail == "StrEmpty" || symbolTail == "strEmpty":
        return "std/system::StrEmpty"
    if symbolTail == "SystemPtrAdd" || symbolTail == "system_ptr_add":
        return "ptr_add"
    if symbolTail == "HeapNewCompat" || symbolTail == "heapNewCompat" || symbolTail == "heapNewLegacy" || symbolTail == "heapAllocLegacy":
        return "cheng_malloc"
    if symbolTail == "NewStringAlloc" || symbolTail == "newStringAlloc":
        return "driver_c_str_alloc_bridge"
    if symbolTail == "NewStringCopy" || symbolTail == "newStringCopy":
        return "driver_c_str_from_utf8_copy_bridge"
    if symbolTail == "memRetain":
        return "cheng_mem_retain"
    if symbolTail == "memRelease":
        return "cheng_mem_release"
    if symbolTail == "memRetainAtomic":
        return "cheng_mem_retain_atomic"
    if symbolTail == "memReleaseAtomic":
        return "cheng_mem_release_atomic"
    if symbolTail == "rawmemCopy" || symbolTail == "RawmemCopy" || symbolTail == "rawmemCopyRaw":
        return "copyMem"
    if symbolTail == "rawmemSet" || symbolTail == "RawmemSet":
        return "setMem"
    if symbolTail == "rawmemPtrAdd" || symbolTail == "RawmemPtrAdd":
        return "ptr_add"
    if symbolTail == "rawmemWriteI8" || symbolTail == "RawmemWriteI8":
        return "cheng_rawmem_write_i8"
    if symbolTail == "rawmemWriteChar" || symbolTail == "RawmemWriteChar":
        return "cheng_rawmem_write_char"
    if symbolTail == "echo" || symbolTail == "Echo":
        return "puts"
    return strings.CloneStr(symbolRaw)

@borrows
fn PrimaryBodyIrCanonicalCallTargetSymbolForStatement(stmt: lower.PrimaryObjectIrStatement): str =
    if PrimaryBodyIrStatementIsStdAssertBridgeCall(stmt):
        let targetTail = PrimaryCallTargetTailName(stmt.callTarget)
        if targetTail == "Assert":
            return "Assert"
        return "assert"
    return PrimaryBodyIrCanonicalCallTargetSymbol(stmt.callTarget)

@borrows
fn PrimaryBodyIrRelocCallTargetSymbol(symbolRaw: str): str =
    let targetTail = PrimaryCallTargetTailName(symbolRaw)
    if targetTail == "assert":
        return "std/system::assert"
    if targetTail == "Assert":
        return "std/system::Assert"
    if targetTail == "echo" || targetTail == "Echo":
        return "puts"
    if targetTail == "StrDataPtr" || targetTail == "strDataPtr":
        return "std/system::StrDataPtr"
    if targetTail == "StrLenFast" || targetTail == "strLenFast":
        return targetTail
    if targetTail == "StrEmpty" || targetTail == "strEmpty":
        return "std/system::StrEmpty"
    if targetTail == "SystemPtrAdd" || targetTail == "system_ptr_add":
        return "ptr_add"
    return strings.CloneStr(symbolRaw)

@borrows
fn PrimaryBodyIrAppendHeapObjectAllocZero(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           typedIr: texpr.TypedExprIr,
                                           sourcePath: str,
                                           objectTypeText: str,
                                           targetSlot: int32,
                                           callOrdinal: var int32,
                                           allocOpIndexOut: var int32): bool =
    # [wall80] 锚点契约：本发射器内部先经 LocalInitConstSlot 落 size/zero 两
    # 个 LoadConst op，之后才落 alloc Call op——「append 前 ops.len」锚定的
    # 是 LoadConst 而非 alloc op（v6 `n = new(Node)` 盖章形状守卫首次可达即
    # 死于此）。alloc op 精确索引改由 BodyIRAppendOp 返回值经 allocOpIndexOut
    # 回传，锚点=被盖 op 本体；失败路径一律 -1，fail-closed。
    allocOpIndexOut = -1
    if targetSlot < 0 ||
       targetSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalPtrTag:
        return false
    if objectTypeText == "":
        return false
    var allocSize: int32
    var allocAlign: int32
    var fieldCount: int32
    if !texpr.TypedExprIrLookupTypeLayout(typedIr,
                                         sourcePath,
                                         objectTypeText,
                                         allocSize,
                                         allocAlign,
                                         fieldCount):
        return false
    var primaryColdCond3: bool
    if allocSize <= 0:
        primaryColdCond3 = true
    if allocAlign <= 0:
        primaryColdCond3 = true
    if primaryColdCond3:
        return false
    let sizeSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                   slotNames,
                                                   Fmt"{bodyIR.localSlots[targetSlot].name}#new_size",
                                                   coreir.LocalI32Tag,
                                                   allocSize)
    let zeroSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                   slotNames,
                                                   Fmt"{bodyIR.localSlots[targetSlot].name}#new_zero",
                                                   coreir.LocalI32Tag,
                                                   0)
    if sizeSlot < 0 || zeroSlot < 0:
        return false
    var allocCall: coreir.CallOp
    allocCall.targetSymbol = "cheng_malloc"
    allocCall.resultSlot = targetSlot
    allocCall.resultPassKind = coreir.BodyCallPassStackValueTag
    add(allocCall.argSlots, sizeSlot)
    add(allocCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(bodyIR.callSequence, allocCall)
    var allocOp: coreir.BodyOp
    allocOp.kind = coreir.BodyOpCallTag
    allocOp.target = targetSlot
    add(allocOp.operands, callOrdinal)
    allocOpIndexOut = coreir.BodyIRAppendOp(bodyIR, allocOp)
    callOrdinal = callOrdinal + 1
    var zeroCall: coreir.CallOp
    zeroCall.targetSymbol = "setMem"
    zeroCall.resultSlot = -1
    zeroCall.resultPassKind = coreir.BodyCallPassStackValueTag
    add(zeroCall.argSlots, targetSlot)
    add(zeroCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(zeroCall.argSlots, zeroSlot)
    add(zeroCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(zeroCall.argSlots, sizeSlot)
    add(zeroCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    # [wall136] 堆对象 setMem 的 arg0（裸 targetSlot，堆块指针值）必须携带
    # 形参所有权权威：裸槽实参在 exact_def derive 的 mirror 臂（formalOwns
    # 空 = importc/合成 call 既有行为）按定义行 vd_own 镜像为 OwnMove，经
    # exact-call-arg consume fact（consumesDefinition = arg==OwnMove）落到
    # ownership 生产 AppendConsume，把 new(T) 目标槽的定义在 setMem 处伪消
    # 费——清理流从此视该槽为死，return 边零 drop 动作，v6 fn3 清理计划
    # 全域 0 动作，cleanup_cfg「return snapshot action authority missing」
    # 墙死点（r2 失败臂取数铁证：places=1 sites=2 siteActions=0 qual=1，
    # 唯一消费=本 setMem arg0）。语义 = 借用传入、调用后归还：setMem 只
    # 读指针值清零堆块，对象仍归声明槽所有（C 参照链同形发 release）。
    # 逐参 [BorrowUnique, OwnInvalid, OwnInvalid]：arg0 走 exact_def 既有
    # BorrowUnique 覆盖臂（wall131 形参权威同机制），arg1/2 哨兵行保持
    # mirror 逐字节不变；passKinds/argSlots/ABI 零改动。
    add(zeroCall.argFormalOwnerships, Int32(coreir.OwnBorrowUnique))
    add(zeroCall.argFormalOwnerships, Int32(coreir.OwnInvalid))
    add(zeroCall.argFormalOwnerships, Int32(coreir.OwnInvalid))
    add(bodyIR.callSequence, zeroCall)
    var zeroOp: coreir.BodyOp
    zeroOp.kind = coreir.BodyOpCallTag
    zeroOp.target = -1
    add(zeroOp.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, zeroOp)
    callOrdinal = callOrdinal + 1
    return true

# [wall72] new(T) alloc 定义盖章（w68 r2 helper 重落，行源改读语句级
# 「绑定目标定义行」新列——LHS lvalue 节点行按 w31 契约恒 -1，节点通道
# 不可达；语句列是声明组唯一 definitionRows 的直读暴露，精确身份禁令不破）。
# 盖章语义 = decl-init 同款：alloc CallOp 携带 (R_decl, OwnMove) 精确
# value-def 权威（canonical call-result 镜像族字段与 lowering transport
# binder :27017 同款），借主物化扫描（Prepare 非参数借主臂）由此定位唯一
# 定义 op。首个定义权在先：全表已有 (R_decl, OwnMove) op 即幂等跳过
# （重复赋值 stale-owner 锚定容忍，decl-init 节点路径先行盖章场景不重复），
# 不产生 scan 侧 duplicated。守卫 fail-closed：行无效 = w68 r2 同款原判词。
@borrows
fn PrimaryBodyIrBindNewObjectAllocValueDefinitionExact(
        bodyIR: var coreir.BodyIR,
        typedIr: texpr.TypedExprIr,
        structuralKinds: int32[],
        scalarKinds: int32[],
        childTypeIds: int32[],
        fixedLengths: int32[],
        sizeBytes: int32[],
        alignBytes: int32[],
        targetSlot: int32,
        allocOpIndex: int32,
        semanticDefinitionRow: int32) =
    if semanticDefinitionRow < 0 ||
       semanticDefinitionRow >=
           texpr.TypedExprValueDefinitionAuthorityCount(typedIr):
        # [wall74] 判词富化（wall40/45/47/73 同款，原文本作前缀 grep 仍
        # 命中）：行守卫携带行值与权威表行数实况，区分「列供给缺失
        # （row=-1，语句列未填充族）」与「越界行」两族死因。
        let panicMsg = Fmt"primary: new object alloc definition row invalid row={semanticDefinitionRow} authorityCount={Int32(texpr.TypedExprValueDefinitionAuthorityCount(typedIr))}"
        panic(panicMsg)
    if texpr.TypedExprValueDefinitionOriginKindAt(
           typedIr, semanticDefinitionRow) !=
           texpr.TypedExprValueDefinitionOriginBindingInitializer ||
       texpr.TypedExprValueDefinitionOwnershipAt(
           typedIr, semanticDefinitionRow) !=
           texpr.TypedExprExprOwned ||
       texpr.TypedExprValueDefinitionBorrowOwnerValueDefinitionRowAt(
           typedIr, semanticDefinitionRow) != -1:
        let panicMsg = Fmt"primary: new object alloc definition authority invalid row={semanticDefinitionRow} origin={Int32(texpr.TypedExprValueDefinitionOriginKindAt(typedIr, semanticDefinitionRow))} own={Int32(texpr.TypedExprValueDefinitionOwnershipAt(typedIr, semanticDefinitionRow))} owncol={texpr.TypedExprValueDefinitionBorrowOwnerValueDefinitionRowAt(typedIr, semanticDefinitionRow)}"
        panic(panicMsg)
    let definingNode =
        texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
            typedIr, semanticDefinitionRow)
    if definingNode < 0 || definingNode >= typedIr.nodes2_nodeIndexs.len:
        panic(Fmt"primary: new object alloc definition node invalid row={semanticDefinitionRow} node={definingNode}")
    for opIndex in 0..<bodyIR.ops.len:
        let candidate = bodyIR.ops[opIndex]
        if candidate.valueDefSemanticRow == semanticDefinitionRow &&
           candidate.valueDefOwnership == coreir.OwnMove:
            return
    if allocOpIndex < 0 || allocOpIndex >= bodyIR.ops.len ||
       targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        panic("primary: new object alloc op index invalid")
    var op = bodyIR.ops[allocOpIndex]
    if op.kind != coreir.BodyOpCallTag ||
       op.target != targetSlot ||
       op.operands.len != 1 ||
       op.operands[0] < 0 ||
       op.operands[0] >= bodyIR.callSequence.len:
        # [wall80] 判词富化（wall40/45/47/73/74 同款，原文本作前缀 grep 仍
        # 命中）：形状守卫携带被盖 op 实况（kind/target/operands[0]）与期望
        # target、callSequence 界，区分「锚点漂移（盖到发射器内部 LoadConst
        # 等 non-alloc op）」与「op 本体形状非法」两族死因。
        var shapeOperand0Text = "none"
        if op.operands.len > 0:
            shapeOperand0Text = strings.IntToStr(op.operands[0])
        let panicMsg = Fmt"primary: new object alloc op shape invalid opIndex={allocOpIndex} opKind={op.kind} opTarget={op.target} expectTarget={targetSlot} operandCount={Int32(op.operands.len)} operand0={shapeOperand0Text} callCount={Int32(bodyIR.callSequence.len)}"
        panic(panicMsg)
    let callIndex = op.operands[0]
    var call = bodyIR.callSequence[callIndex]
    if call.resultSlot != targetSlot ||
       call.resultPassKind != coreir.BodyCallPassStackValueTag:
        panic("primary: new object alloc call result shape invalid")
    if op.valueDefSlot != -1 ||
       op.valueDefExprNodeIndex != -1 ||
       op.valueDefSemanticRow != -1 ||
       op.valueDefOwnership != coreir.OwnInvalid ||
       op.valueDefConsumeOpIndexPlusOne != 0 ||
       op.valueDefOriginKind != coreir.BodyDefinitionOriginUnknownTag ||
       op.valueDefOriginId != -1 ||
       op.valueDefBorrowOwnerSemanticRow != -1 ||
       op.valueDefBorrowOwnerDefinitionDomain !=
           coreir.BodyDefinitionDomainInvalidTag ||
       op.valueDefBorrowOwnerDefinitionRow != -1 ||
       op.sourceDefinitionDomain != coreir.BodyDefinitionDomainInvalidTag ||
       op.sourceDefinitionRow != -1 ||
       op.consumeActionRow != -1 ||
       call.resultOwnership != coreir.OwnInvalid ||
       call.resultExprNodeIndex != -1 ||
       call.resultValueDefinitionRow != -1 ||
       call.resultBorrowOwnerValueDefinitionRow != -1 ||
       call.resultBorrowOwnerDefinitionDomain !=
           coreir.BodyDefinitionDomainInvalidTag ||
       call.resultBorrowOwnerDefinitionRow != -1 ||
       call.resultDefinitionOriginKind !=
           coreir.BodyDefinitionOriginUnknownTag ||
       call.resultDefinitionOriginId != -1 ||
       call.sourceDefinitionDomain != coreir.BodyDefinitionDomainInvalidTag ||
       call.sourceDefinitionRow != -1 ||
       call.consumeActionRow != -1:
        panic("primary: new object alloc definition authority already bound")
    let exactTypeId = texpr.TypedExprIrNodeStructuralTypeIdAt(
        typedIr, definingNode)
    if !typedIr.valueDefinitionTypeArenaBound:
        panic("primary: new object alloc TypeArena domain missing")
    # [wall117] 槽 proof 配对 fact closure（wall98 定性「绑托管槽 proof 必配
    # fact closure」契约形——PrimaryBodyIrAppendManagedGlobalStore 与
    # lowering transport bridge 两在树先例同款联立；wall116 移交修法）：
    # new-object def 盖 (R_decl, OwnMove) 精确戳后，ownership production
    # 对该 def 逐列审 slot 权威 fact 行（drift 四条件 + RefObject/Sequence
    # 臂 child 在册）——只绑槽 proof 不绑 closure 即 wall98/wall100 同族
    # 唯一缺臂绑定面（v6 fn=3 op=3 slot=n tid=17 实况 fact_row=-1）。
    # 行值 = TypeArena 证据窗六列 + artifactCid 直传权威（与各绑定面同
    # 源），走 ManagedLvalueReplaceProductionBindTypeClosure 单子链闭包
    # 既有先例；BodyIRBindCanonicalTypeFact 幂等（既有同值行→true），
    # 已过程序 fact 表与发射字节零变化。绑定失败 = 窗值不可 bind = 证据
    # 洞，判词如实 hard fail，无兜底。
    if exactTypeId < 0 ||
       !coreir.BodyIRBindTypeArenaArtifactCid(
           bodyIR, typedIr.valueDefinitionTypeArenaArtifactCid) ||
       !coreir.BodyIRBindLocalSlotTypeArenaProof(
           bodyIR,
           targetSlot,
           typedIr.valueDefinitionTypeArenaArtifactCid,
           exactTypeId,
           coreir.BodyManagedStorageManagedTag) ||
       !managedreplace.ManagedLvalueReplaceProductionBindTypeClosure(
           bodyIR,
           typedIr.valueDefinitionTypeArenaArtifactCid,
           exactTypeId,
           structuralKinds,
           scalarKinds,
           childTypeIds,
           fixedLengths,
           sizeBytes,
           alignBytes):
        # [wall117] 判词富化（wall74/80 同款，原文本作前缀 grep 仍命中）：
        # 携 TypeId/fn/fact 表实况，区分「窗界外 TypeId」与「fact 表漂移」。
        panic(Fmt"primary: new object alloc exact TypeArena proof unavailable tid={exactTypeId} fn={bodyIR.controlFunctionRow} fact_count={bodyIR.typeFactTypeIds.len}")
    call.resultOwnership = coreir.OwnMove
    call.resultExprNodeIndex = definingNode
    call.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    call.resultDefinitionOriginId = semanticDefinitionRow
    call.resultValueDefinitionRow = semanticDefinitionRow
    call.resultBorrowOwnerValueDefinitionRow = -1
    call.resultBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainInvalidTag
    call.resultBorrowOwnerDefinitionRow = -1
    op.valueDefSlot = targetSlot
    op.valueDefExprNodeIndex = definingNode
    op.valueDefOwnership = coreir.OwnMove
    op.valueDefOriginKind = coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = semanticDefinitionRow
    op.valueDefSemanticRow = semanticDefinitionRow
    op.valueDefBorrowOwnerSemanticRow = -1
    op.valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainInvalidTag
    op.valueDefBorrowOwnerDefinitionRow = -1
    bodyIR.callSequence[callIndex] = call
    bodyIR.ops[allocOpIndex] = op

@borrows
fn PrimaryBodyIrAppendNewObjectValue(bodyIR: var coreir.BodyIR,
                                      slotNames: var str[],
                                      typedIr: texpr.TypedExprIr,
                                      sourcePath: str,
                                      newExprTextRaw: str,
                                      targetSlot: int32,
                                      callOrdinal: var int32,
                                      allocOpIndexOut: var int32): bool =
    let newTypeText = PrimaryBodyIrWholeCallInnerForHead(newExprTextRaw, "new")
    return PrimaryBodyIrAppendHeapObjectAllocZero(bodyIR,
                                                  slotNames,
                                                  typedIr,
                                                  sourcePath,
                                                  newTypeText,
                                                  targetSlot,
                                                  callOrdinal,
                                                  allocOpIndexOut)

# #76c 表达式位 new(T) 归一化: `new(T)` 出现在 call-arg/条件操作数/字段赋值 RHS/
# return 直返等非顶层位时, 已验证正确的两条专用 realizer(AppendLocalDeclInitializer
# 21481 一带、AppendI32Assign 39179 一带)够不到——#76b 已把这些位的静默孤儿槽风险
# 转成诚实 miss(poison)。本函数在“诚实 miss”这一刻改为：立即在当前 bodyIR 里分配
# 一个全新的、绝不会与任何既有文本键碰撞的 ptr 槽，直接调用与两条既有 realizer
# 完全相同的分配原语(AppendNewObjectValue→AppendHeapObjectAllocZero，逐字节同一份
# cheng_malloc+setMem 序列)把它填好，再把这个槽原样交回调用方当作“已经算出来的值”
# ——等价于把 `let __newTmpN = new(T)` 提到当前位置之前先求值，但不需要合成任何
# 前端语句/节点，不接触 statements2_*/nodes2_* 的行号/节点区间记账(这两套记账被
# 转义分析/regalloc liveness/census 等整函数级 range 扫描信任，事后插入极易产生
# "槽存在但不在任何一致范围内"的隐蔽错配——同一 CLAUDE.md 铁律"合法表面 residual
# 改 primary/backend realizer, 禁止业务层换 API/裸指针补丁"，这里选择的正是同一份
# 后端原语，只是换了个触发点，不是另起炉灶)。失败(类型不concrete/建槽失败/分配
# 失败)一律返回 -1，调用方保持原有 poison-on-miss 行为，零回归。
@borrows
fn PrimaryBodyIrHoistNewCallToPtrSlot(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       typedIr: texpr.TypedExprIr,
                                       sourcePath: str,
                                       lineNumber: int32,
                                       textRaw: str,
                                       callOrdinal: var int32): int32 =
    let text = strutil.Strip(textRaw)
    let newTypeText = PrimaryBodyIrWholeCallInnerForHead(text, "new")
    if newTypeText == "":
        return -1
    let newRefType = texpr.TypedExprNormalizeTypeText(Fmt"ref{newTypeText}")
    if !texpr.TypedExprTypeTextIsConcrete(newRefType):
        return -1
    let hoistSlotName = strutil.Join(["#new_hoist#",
                                      strings.IntToStr(lineNumber),
                                      "#",
                                      strings.IntToStr(callOrdinal),
                                      "#",
                                      strings.IntToStr(bodyIR.ops.len)], "")
    let hoistSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                  slotNames,
                                                  hoistSlotName,
                                                  coreir.LocalPtrTag)
    if hoistSlot < 0:
        return -1
    # [wall80] hoist 位不消费盖章锚点，仅承接 out 契约。
    var hoistNewAllocOpIndex: int32
    if !PrimaryBodyIrAppendNewObjectValue(bodyIR,
                                          slotNames,
                                          typedIr,
                                          sourcePath,
                                          text,
                                          hoistSlot,
                                          callOrdinal,
                                          hoistNewAllocOpIndex):
        return -1
    return hoistSlot

# 同上，但返回槽名(供仍以“文本”为契约的既有 realizer——FieldAssign RHS/return
# 值——原样按“已有局部变量的裸标识符”消费；这两条既有路径本就支持“字段/返回值
# 是一个已存在的 ref 局部变量”，命名替换后无需再改它们自身任何一行)。
@borrows
fn PrimaryBodyIrHoistNewCallToPtrSlotName(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           typedIr: texpr.TypedExprIr,
                                           sourcePath: str,
                                           lineNumber: int32,
                                           textRaw: str,
                                           callOrdinal: var int32): str =
    let hoistSlot = PrimaryBodyIrHoistNewCallToPtrSlot(bodyIR,
                                                       slotNames,
                                                       typedIr,
                                                       sourcePath,
                                                       lineNumber,
                                                       textRaw,
                                                       callOrdinal)
    if hoistSlot < 0:
        return ""
    return bodyIR.localSlots[hoistSlot].name

@borrows
fn PrimaryBodyIrFindTopLevelBrace(text: str): int32 =
    var parenDepth: int32
    var bracketDepth: int32
    for i in 0..<len(text):
        let ch = text[i]
        if ch == '(':
            parenDepth = parenDepth + 1
        elif ch == ')':
            parenDepth = parenDepth - 1
        elif ch == '[':
            bracketDepth = bracketDepth + 1
        elif ch == ']':
            bracketDepth = bracketDepth - 1
        elif ch == '{' && parenDepth == 0 && bracketDepth == 0:
            return i
    return -1

# 零实参类型构造器 `TypeName()` 判定：RHS 文本恰为 `Head()`（空实参），调用
# 头叶名首字母大写、经 TypeShape 解析为聚合且尺寸与 LHS 聚合槽精确相等，且不
# 解析为真函数 ordinal（构造器不是函数）。满足即该赋值是默认零初始化（语义=
# 整槽清零）。`Type()` 构造器 RHS 在前端不建节点，故走文本路径。
@borrows
fn PrimaryBodyIrAssignZeroConstructorMatches(bodyIR: coreir.BodyIR,
                                              typedIr: texpr.TypedExprIr,
                                              irFunction: lower.PrimaryObjectIrFunction,
                                              sourcePath: str,
                                              rhsTextRaw: str,
                                              lhsSlot: int32): bool =
    if lhsSlot < 0 || lhsSlot >= bodyIR.localSlots.len:
        return false
    let rhsText = strutil.Strip(rhsTextRaw)
    if rhsText.len < 3 || rhsText[rhsText.len - 1] != ')':
        return false
    let openPos = texpr.TypedExprFindWholeCallOpenParen(rhsText)
    if openPos <= 0:
        return false
    if texpr.TypedExprFindMatchingParen(rhsText, openPos) != rhsText.len - 1:
        return false
    if strutil.Strip(strings.SliceBytes(rhsText, openPos + 1, rhsText.len - openPos - 2)) != "":
        return false
    let callHead = strutil.Strip(strings.SliceBytes(rhsText, 0, openPos))
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        return false
    let ctorLeaf = texpr.TypedExprQualifiedCallLeaf(callHead)
    if ctorLeaf == "":
        return false
    if ctorLeaf[0] < 'A' || ctorLeaf[0] > 'Z':
        return false
    var ctorKind: int32
    var ctorSize: int32
    var ctorAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, callHead, ctorKind, ctorSize, ctorAlign)
    if ctorKind != coreir.LocalAggregateTag || ctorSize <= 0:
        return false
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[lhsSlot]) != ctorSize:
        # TypeShapeFromText 的布局登记对含跨模块嵌套 struct 字段的类型（如
        # TypedExprFactTable 的 Arena/InternPool/ArenaArrayInt32）在大闭包 in-context
        # 会把嵌套求和成 0→聚合 size 塌成标量字段和 4，与槽的权威尺寸（源自前端
        # 形参布局，非后端类型名解析器可复现）失配。此处改判「RHS 构造器类型名是否
        # 与 LHS 形参绑定类型同名」：同名即同型同布局，AppendZeroLocalSlot 按槽权威
        # 尺寸清零即正确；异名（或 LHS 非形参）仍拒，绝不静默放行异型。
        let zeroCtorLhsName = bodyIR.localSlots[lhsSlot].name
        var zeroCtorTypeMatch = false
        for zeroCtorParamIndex in 0..<irFunction.paramNames.len:
            if zeroCtorParamIndex >= irFunction.paramTypes.len:
                continue
            if irFunction.paramNames[zeroCtorParamIndex] == zeroCtorLhsName:
                let zeroCtorLhsLeaf = texpr.TypedExprTypeLeafName(texpr.TypedExprStripVarType(irFunction.paramTypes[zeroCtorParamIndex]))
                if zeroCtorLhsLeaf != "" && zeroCtorLhsLeaf == ctorLeaf:
                    zeroCtorTypeMatch = true
        if !zeroCtorTypeMatch:
            return false
    # 头名必须是纯类型（无同名函数体）——构造器不是函数。前端会给构造器调用
    # 登记一个未解析 ordinal，故不能用 ordinal 判定；用是否存在函数定义判定。
    if PrimaryBodyIrVisibleFunctionIndex(typedIr, sourcePath, callHead) >= 0:
        return false
    return true

@borrows
fn PrimaryBodyIrAppendObjectConstructorValue(bodyIR: var coreir.BodyIR,
                                              slotNames: var str[],
                                              varI32ParamNames: str[],
                                              typedIr: texpr.TypedExprIr,
                                              sourcePath: str,
                                              targetTypeRaw: str,
                                              rhsTextRaw: str,
                                              targetSlot: int32,
                                              callOrdinal: var int32): bool =
    let rhsText = strutil.Strip(rhsTextRaw)
    let bracePos = PrimaryBodyIrFindTopLevelBrace(rhsText)
    var primaryColdCond4: bool
    if bracePos <= 0:
        primaryColdCond4 = true
    if len(rhsText) <= bracePos + 1:
        primaryColdCond4 = true
    if rhsText[len(rhsText) - 1] != '}':
        primaryColdCond4 = true
    if primaryColdCond4:
        return false
    let ctorType = texpr.TypedExprNormalizeTypeText(strutil.Strip(strings.SliceBytes(rhsText, 0, bracePos)))
    let targetType = texpr.TypedExprNormalizeTypeText(targetTypeRaw)
    if ctorType == "" || targetType == "" || ctorType != targetType:
        return false
    # [wall80] 构造器位不消费盖章锚点，仅承接 out 契约。
    var ctorAllocOpIndex: int32
    if !PrimaryBodyIrAppendHeapObjectAllocZero(bodyIR,
                                               slotNames,
                                               typedIr,
                                               sourcePath,
                                               ctorType,
                                               targetSlot,
                                               callOrdinal,
                                               ctorAllocOpIndex):
        return false
    let fieldsText = strings.SliceBytes(rhsText,
                                        bracePos + 1,
                                        len(rhsText) - bracePos - 2)
    let fieldItems = texpr.TypedExprSplitTopLevelCsv(fieldsText)
    for itemIndex in 0..<fieldItems.len:
        let item = strutil.Strip(fieldItems[itemIndex])
        if item == "":
            continue
        let colonPos = texpr.TypedExprFindTopLevelTextToken(item, ":")
        if colonPos <= 0:
            return false
        let fieldName = strutil.Strip(strings.SliceBytes(item, 0, colonPos))
        let valueText = strutil.Strip(strings.SliceBytes(item,
                                                        colonPos + 1,
                                                        len(item) - colonPos - 1))
        if fieldName == "" || valueText == "":
            return false
        var fieldType: str
        var fieldOffsetBytes: int32
        var fieldSizeBytes: int32
        var fieldAlignBytes: int32
        if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                               sourcePath,
                                               ctorType,
                                               fieldName,
                                               fieldType,
                                               fieldOffsetBytes,
                                               fieldSizeBytes,
                                               fieldAlignBytes):
            if !texpr.TypedExprIrLookupFieldPathMeta(typedIr,
                                                     sourcePath,
                                                     ctorType,
                                                     fieldName,
                                                     fieldType,
                                                     fieldOffsetBytes,
                                                     fieldSizeBytes,
                                                     fieldAlignBytes):
                return false
        var fieldTypeKind: int32
        var fieldShapeSize: int32
        var fieldShapeAlign: int32
        PrimaryBodyIrTypeShapeFromText(typedIr,
                                       sourcePath,
                                       fieldType,
                                       fieldTypeKind,
                                       fieldShapeSize,
                                       fieldShapeAlign)
        if fieldSizeBytes <= 0:
            fieldSizeBytes = fieldShapeSize
        if fieldSizeBytes <= 0:
            return false
        let valueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            typedIr,
                                                            sourcePath,
                                                            valueText,
                                                            fieldTypeKind, callOrdinal)
        if valueSlot < 0 ||
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < fieldSizeBytes:
            return false
        var storeOp: coreir.BodyOp
        storeOp.kind = coreir.BodyOpFieldStoreTag
        storeOp.target = targetSlot
        add(storeOp.operands, targetSlot)
        add(storeOp.operands, valueSlot)
        add(storeOp.operands, fieldOffsetBytes)
        add(storeOp.operands, fieldSizeBytes)
        let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
    return true

@borrows
fn PrimaryBodyIrAppendStringLiteralValue(bodyIR: var coreir.BodyIR,
                                         slotNames: var str[],
                                         literalTextRaw: str,
                                         targetSlot: int32,
                                         callOrdinal: var int32): bool =
    if targetSlot < 0 ||
       targetSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalStrTag:
        if os.GetEnv("CHENG_X64_DBG4") != "":
            os.WriteLine(os.GetStderr(), Fmt"x64dbg4 str_lit_value_fail reason=target slot={targetSlot}")
        return false
    if !PrimaryBodyIrTextIsStringLiteral(literalTextRaw):
        if os.GetEnv("CHENG_X64_DBG4") != "":
            os.WriteLine(os.GetStderr(), Fmt"x64dbg4 str_lit_value_fail reason=literal text=[{literalTextRaw}]")
        return false
    let literalPayload = PrimaryBodyIrStringLiteralPayload(literalTextRaw)
    if len(literalPayload) == 0:
        return PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                slotNames,
                                                targetSlot,
                                                callOrdinal)
    let literalOrdinal = bodyIR.cstringLiterals.len
    let lenSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"{bodyIR.localSlots[targetSlot].name}#str_literal_len#{literalOrdinal}",
                                                  coreir.LocalI32Tag,
                                                  len(literalPayload))
    if lenSlot < 0:
        if os.GetEnv("CHENG_X64_DBG4") != "":
            os.WriteLine(os.GetStderr(), Fmt"x64dbg4 str_lit_value_fail reason=len_slot")
        return false
    let literalId = coreir.BodyIRAppendCStringLiteral(bodyIR,
                                                      literalPayload,
                                                      "")
    var call: coreir.CallOp
    call.targetSymbol = "driver_c_str_from_utf8_copy_bridge"
    call.resultSlot = targetSlot
    call.resultPassKind = coreir.BodyCallPassSretResultTag
    add(call.argSlots, coreir.CallArgSlotCString(literalId))
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(call.argSlots, lenSlot)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(bodyIR.callSequence, call)
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpCallTag
    op.target = targetSlot
    add(op.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    callOrdinal = callOrdinal + 1
    return true

@borrows
fn PrimaryBodyIrAppendStrDataPtrValue(bodyIR: var coreir.BodyIR,
                                      slotNames: var str[],
                                      callArgsText: str,
                                      targetSlot: int32): bool =
    if targetSlot < 0 ||
       targetSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalPtrTag:
        return false
    let args = PrimaryBodyIrCallArgNames(callArgsText)
    if args.len != 1:
        return false
    let strSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, strutil.Strip(args[0]))
    if strSlot < 0 ||
       strSlot >= bodyIR.localSlots.len ||
       !PrimaryBodyIrSlotIsStrRoot(bodyIR, strSlot):
        return false
    var dataOp: coreir.BodyOp
    dataOp.kind = coreir.BodyOpFieldLoadTag
    dataOp.target = targetSlot
    add(dataOp.operands, strSlot)
    add(dataOp.operands, targetSlot)
    add(dataOp.operands, 0)
    add(dataOp.operands, 8)
    let _ = coreir.BodyIRAppendOp(bodyIR, dataOp)
    return true

@borrows
fn PrimaryBodyIrAppendRawmemAsVoidValue(bodyIR: var coreir.BodyIR,
                                        slotNames: var str[],
                                        callArgsText: str,
                                        targetSlot: int32): bool =
    if targetSlot < 0 ||
       targetSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalPtrTag:
        return false
    let args = PrimaryBodyIrCallArgNames(callArgsText)
    if args.len != 1:
        return false
    let argText = strutil.Strip(args[0])
    let argSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, argText)
    if argSlot < 0 || argSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryBodyIrSlotIsStrRoot(bodyIR, argSlot):
        return PrimaryBodyIrAppendStrDataPtrValue(bodyIR,
                                                  slotNames,
                                                  argText,
                                                  targetSlot)
    if PrimaryBodyIrSlotType(bodyIR, argSlot) == coreir.LocalPtrTag:
        if argSlot != targetSlot:
            var copyOp: coreir.BodyOp
            copyOp.kind = coreir.BodyOpCopyLocalTag
            copyOp.target = targetSlot
            add(copyOp.operands, argSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, copyOp)
        return true
    return false

@borrows
fn PrimaryBodyIrAppendZeroLocalSlot(bodyIR: var coreir.BodyIR,
                                     slotNames: var str[],
                                     targetSlot: int32,
                                     callOrdinal: var int32): bool =
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        return false
    let byteCount = PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot])
    if byteCount <= 0:
        return false
    let zeroSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                   slotNames,
                                                   Fmt"{bodyIR.localSlots[targetSlot].name}#zero",
                                                   coreir.LocalI32Tag,
                                                   0)
    let sizeSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                   slotNames,
                                                   Fmt"{bodyIR.localSlots[targetSlot].name}#size",
                                                   coreir.LocalI32Tag,
                                                   byteCount)
    if zeroSlot < 0 || sizeSlot < 0:
        return false
    var call: coreir.CallOp
    call.targetSymbol = "setMem"
    call.resultSlot = -1
    call.resultPassKind = coreir.BodyCallPassStackValueTag
    if bodyIR.localSlots[targetSlot].placeKind == coreir.BodyPlaceGlobalAddressTag:
        add(call.argSlots, targetSlot)
        add(call.argPassKinds, coreir.BodyCallPassGlobalAddressTag)
    else:
        add(call.argSlots, coreir.CallArgSlotAddress(targetSlot))
        add(call.argPassKinds, coreir.BodyCallPassParamAddressTag)
    add(call.argSlots, zeroSlot)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(call.argSlots, sizeSlot)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(bodyIR.callSequence, call)
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpCallTag
    op.target = -1
    add(op.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    callOrdinal = callOrdinal + 1
    return true

fn PrimaryBodyIrSeqStrAddRecordSlot(bodyIR: var coreir.BodyIR,
                                     slotNames: var str[],
                                     valueSlot: int32): int32 =
    if valueSlot < 0 || valueSlot >= bodyIR.localSlots.len:
        return -1
    let valueKind = PrimaryBodyIrSlotType(bodyIR, valueSlot)
    if valueKind == coreir.LocalStrTag &&
       !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[valueSlot]):
        return valueSlot
    var needsLoad = false
    if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[valueSlot]):
        if valueKind == coreir.LocalStrTag:
            needsLoad = true
        elif valueKind == coreir.LocalAggregateTag &&
             bodyIR.localSlots[valueSlot].auxValue == coreir.LocalStrTag:
            needsLoad = true
    if !needsLoad:
        return -1
    let recordSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   Fmt"{bodyIR.localSlots[valueSlot].name}#seq_str_record#{bodyIR.ops.len}",
                                                   coreir.LocalStrTag)
    if recordSlot < 0:
        return -1
    var loadOp: coreir.BodyOp
    loadOp.kind = coreir.BodyOpFieldLoadTag
    loadOp.target = recordSlot
    add(loadOp.operands, valueSlot)
    add(loadOp.operands, recordSlot)
    add(loadOp.operands, 0)
    add(loadOp.operands, 24)
    let _ = coreir.BodyIRAppendOp(bodyIR, loadOp)
    return recordSlot

@borrows
fn PrimaryBodyIrDynamicSeqGlobalStorePlainContract(
        typedIr: texpr.TypedExprIr,
        sourcePath: str,
        typeRaw: str): bool =
    if !PrimaryBodyIrTypeTextIsDynamicSeq(typeRaw):
        return false
    let elemType = PrimaryBodyIrIndexedElementTypeText(typeRaw)
    if elemType == "":
        return false
    var elemHasManaged: bool
    if !texpr.TypedExprIrTypeContainsManagedStorage(typedIr,
                                                    sourcePath,
                                                    elemType,
                                                    elemHasManaged) ||
       elemHasManaged:
        return false
    var elemKind: int32
    var elemSize: int32
    var elemAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   elemType,
                                   elemKind,
                                   elemSize,
                                   elemAlign)
    if elemSize <= 0 || elemAlign <= 0:
        return false
    return elemKind == coreir.LocalI32Tag ||
           elemKind == coreir.LocalI64Tag ||
           elemKind == coreir.LocalF64Tag ||
           elemKind == coreir.LocalPtrTag ||
           elemKind == coreir.LocalAggregateTag

@borrows
fn PrimaryBodyIrManagedExprOwnershipExact(
        typedIr: texpr.TypedExprIr,
        sourcePath: str,
        typeRaw: str,
        nodeIndex: int32): coreir.OwnershipKind =
    var hasManaged: bool
    if !texpr.TypedExprIrTypeContainsManagedStorage(typedIr,
                                                    sourcePath,
                                                    typeRaw,
                                                    hasManaged) ||
       !hasManaged:
        let panicMsg = Fmt"primary: managed value type authority unavailable source={sourcePath} type={typeRaw} node={nodeIndex}"
        panic(panicMsg)
    let exprClass = texpr.TypedExprIrNodeExprClassAt(typedIr, nodeIndex)
    if exprClass == texpr.TypedExprExprOwned:
        return coreir.OwnMove
    if exprClass == texpr.TypedExprExprBorrowed:
        return coreir.OwnBorrowShared
    let panicMsg = Fmt"primary: managed value ownership unknown source={sourcePath} type={typeRaw} node={nodeIndex} class={texpr.TypedExprExprClassText(exprClass)}"
    panic(panicMsg)
@borrows
fn PrimaryBodyIrManagedSemanticValueDefinitionRowExact(
        typedIr: texpr.TypedExprIr,
        nodeIndex: int32): int32 =
    var currentNodeIndex = nodeIndex
    var visitedCount: int32
    while currentNodeIndex >= 0 &&
          currentNodeIndex < typedIr.nodes2_nodeIndexs.len:
        visitedCount = visitedCount + 1
        if visitedCount > typedIr.nodes2_nodeIndexs.len:
            let panicMsg = Fmt"primary: managed semantic value-definition projection cycle node={nodeIndex}"
            panic(panicMsg)
        let producedRow =
            texpr.TypedExprIrNodeProducedValueDefinitionRowAt(
                typedIr, currentNodeIndex)
        if producedRow >= 0:
            if producedRow >=
                   texpr.TypedExprValueDefinitionAuthorityCount(typedIr):
                let panicMsg = Fmt"primary: managed semantic produced value-definition invalid node={currentNodeIndex} row={producedRow}"
                panic(panicMsg)
            return producedRow
        let opKind =
            texpr.TypedExprIrNodeOpKindAt(typedIr, currentNodeIndex)
        if opKind == texpr.TypedExprIrOpParamRef ||
           opKind == texpr.TypedExprIrOpLocalRef:
            let bindingRow =
                texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
                    typedIr, currentNodeIndex)
            if bindingRow < 0 ||
               bindingRow >=
                   texpr.TypedExprValueDefinitionAuthorityCount(typedIr):
                let panicMsg = Fmt"primary: managed semantic binding value-definition missing node={currentNodeIndex}"
                panic(panicMsg)
            return bindingRow
        if opKind == texpr.TypedExprIrOpFieldGet ||
           opKind == texpr.TypedExprIrOpIndexGet:
            currentNodeIndex =
                texpr.TypedExprIrNodeOperand0At(
                    typedIr, currentNodeIndex)
            continue
        let panicMsg = Fmt"primary: managed semantic value-definition missing node={currentNodeIndex} op={texpr.TypedExprIrOpKindText(opKind)}"
        panic(panicMsg)
    let panicMsg = Fmt"primary: managed semantic projection source invalid node={nodeIndex}"
    panic(panicMsg)

@borrows
fn PrimaryBodyIrPrepareManagedBodyOpValueDefinitionExact(
        bodyIR: var coreir.BodyIR,
        typedIr: texpr.TypedExprIr,
        sourcePath: str,
        typeRaw: str,
        nodeIndex: int32,
        op: var coreir.BodyOp) =
    let valueSlot = op.target
    if valueSlot < 0 || valueSlot >= bodyIR.localSlots.len ||
       op.valueDefSlot != -1 ||
       op.valueDefOwnership != coreir.OwnInvalid:
        panic("primary: managed BodyOp value-def prepare ingress invalid")
    let ownership = PrimaryBodyIrManagedExprOwnershipExact(
        typedIr, sourcePath, typeRaw, nodeIndex)
    let semanticDefinitionRow =
        PrimaryBodyIrManagedSemanticValueDefinitionRowExact(
            typedIr, nodeIndex)
    if !typedIr.valueDefinitionTypeArenaBound:
        panic("primary: managed BodyOp TypeArena domain missing")
    let exactTypeId =
        texpr.TypedExprIrNodeStructuralTypeIdAt(typedIr, nodeIndex)
    if exactTypeId < 0 ||
       !coreir.BodyIRBindTypeArenaArtifactCid(
           bodyIR, typedIr.valueDefinitionTypeArenaArtifactCid) ||
       !coreir.BodyIRBindLocalSlotTypeArenaProof(
           bodyIR,
           valueSlot,
           typedIr.valueDefinitionTypeArenaArtifactCid,
           exactTypeId,
           coreir.BodyManagedStorageManagedTag):
        panic("primary: managed BodyOp exact TypeArena proof unavailable")
    var borrowOwnerSemanticRow: int32 = -1
    var borrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainInvalidTag
    var borrowOwnerDefinitionRow: int32 = -1
    if ownership == coreir.OwnBorrowShared:
        borrowOwnerSemanticRow =
            texpr.TypedExprValueDefinitionBorrowOwnerValueDefinitionRowAt(
                typedIr, semanticDefinitionRow)
        # 借主权威行：borrow-owner 列在场的非参数借主行；列缺席时是
        # Borrowed 物化的权威定义行自身（自根拼写，与 typed-ir 发布侧
        # 参数借主 borrowOwnerRow=definitionRow 同族）。参数定义行按
        # 发布契约必带自根借主；[w65] 例外=var 托管视图参数（见下
        # 镜像臂）；[w117f] 例外=不可变 Owned 托管形参（见下镜像臂），
        # 其余列缺席即 authority 拼写非法，不放行。
        var borrowOwnerAuthorityRow: int32 = -1
        if borrowOwnerSemanticRow < 0 &&
           texpr.TypedExprValueDefinitionOriginKindAt(
               typedIr, semanticDefinitionRow) ==
               texpr.TypedExprValueDefinitionOriginParameter &&
           texpr.TypedExprValueDefinitionOwnershipAt(
               typedIr, semanticDefinitionRow) ==
               texpr.TypedExprExprBorrowed:
            # [w65] var 托管视图参数（`var T` 参数）发布侧缺列镜像：行按
            # 文本权威盖 Borrowed，但定义节点 exact 类型是 var 视图
            # （BorrowedView 不置 managed=1），typed-ir 发布侧
            # typedExprIrAppendValueDefinitionExact 的自根列以节点
            # managed flag 为前置，flag=0 短路 → 借主列缺席。列缺席且
            # 行/节点满足 canonical borrowed-view 参数指纹全联立（wall61
            # 八列同族：参数原点 ∧ Borrowed ∧ 定义节点 ParamRef ∧
            # parser=-1 ∧ synthetic=Parameter ∧ span=NoSource ∧
            # proof=Reference ∧ managed=0）时恢复发布契约自根拼写
            # （borrowOwnerRow=definitionRow），流入下方参数借主权威臂
            # （entry-slot 身份链原样）；任一列不符仍走原判词。
            let parameterOwnerNode =
                texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                    typedIr, semanticDefinitionRow)
            if parameterOwnerNode >= 0 &&
               parameterOwnerNode < typedIr.nodes2_nodeIndexs.len &&
               typedIr.nodes2_opKinds[parameterOwnerNode] ==
                   texpr.TypedExprIrOpParamRef &&
               arenamod.ArenaArrayInt32Get(
                   typedIr.arena,
                   typedIr.nodes2_originParserNodeIds,
                   parameterOwnerNode) == -1 &&
               arenamod.ArenaArrayInt32Get(
                   typedIr.arena,
                   typedIr.nodes2_syntheticOriginKinds,
                   parameterOwnerNode) ==
                   texpr.TypedExprSyntheticOriginParameter &&
               arenamod.ArenaArrayInt32Get(
                   typedIr.arena,
                   typedIr.nodes2_spanAuthorityKinds,
                   parameterOwnerNode) ==
                   texpr.TypedExprSpanAuthorityNoSource &&
               arenamod.ArenaArrayInt32Get(
                   typedIr.arena,
                   typedIr.nodes2_resultTypeProofKinds,
                   parameterOwnerNode) ==
                   texpr.TypedExprSnapshotTypeProofReference &&
               !typedIr.nodes2_resultTypeManagedFlags[parameterOwnerNode]:
                borrowOwnerSemanticRow = semanticDefinitionRow
        # [w117f] 不可变 Owned 托管形参（`name: str`，非 @borrows 非
        # var）发布侧缺列镜像：typed-ir 发布侧自根借主列只在
        # managedFlag && Borrowed 时盖章
        # （typedExprIrAppendValueDefinitionExact），而不可变托管形参的
        # 定义所有权=Owned（typedExprIrParameterDefinitionOwnershipExact：
        # ParamRef 节点恒为借视，不可变绑定自持来值；不可变且非托管即
        # 发布端 panic）→ 借主列恒缺席，且 canonical 借主裁定
        # （typedExprIrCanonicalBorrowOwnerForDefinitionRow）对 Owned 行
        # 返回行自身为权威。列缺席且行/节点满足 immutable-owned 参数
        # 指纹全联立（参数原点 ∧ Owned ∧ 定义节点 ParamRef ∧
        # parser=-1 ∧ synthetic=Parameter ∧ span=NoSource ∧ managed=1 ∧
        # paramMutable=0；proof 不约束：发布契约只要求 managed 行
        # proof≠None，随结构类别取 Scalar/ManagedValue/Reference/
        # Sequence/Aggregate）时恢复发布契约自根拼写，流入下方参数借主
        # 权威臂（entry-slot 身份链原样）；任一列不符仍走原判词
        # （site=c 全列实况）。
        if borrowOwnerSemanticRow < 0 &&
           texpr.TypedExprValueDefinitionOriginKindAt(
               typedIr, semanticDefinitionRow) ==
               texpr.TypedExprValueDefinitionOriginParameter &&
           texpr.TypedExprValueDefinitionOwnershipAt(
               typedIr, semanticDefinitionRow) ==
               texpr.TypedExprExprOwned:
            let parameterOwnerNode =
                texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                    typedIr, semanticDefinitionRow)
            if parameterOwnerNode >= 0 &&
               parameterOwnerNode < typedIr.nodes2_nodeIndexs.len &&
               typedIr.nodes2_opKinds[parameterOwnerNode] ==
                   texpr.TypedExprIrOpParamRef &&
               arenamod.ArenaArrayInt32Get(
                   typedIr.arena,
                   typedIr.nodes2_originParserNodeIds,
                   parameterOwnerNode) == -1 &&
               arenamod.ArenaArrayInt32Get(
                   typedIr.arena,
                   typedIr.nodes2_syntheticOriginKinds,
                   parameterOwnerNode) ==
                   texpr.TypedExprSyntheticOriginParameter &&
               arenamod.ArenaArrayInt32Get(
                   typedIr.arena,
                   typedIr.nodes2_spanAuthorityKinds,
                   parameterOwnerNode) ==
                   texpr.TypedExprSpanAuthorityNoSource &&
               typedIr.nodes2_resultTypeManagedFlags[parameterOwnerNode] &&
               !typedIr.nodes2_paramMutableFlags[parameterOwnerNode]:
                borrowOwnerSemanticRow = semanticDefinitionRow
        if borrowOwnerSemanticRow >= 0:
            if texpr.TypedExprValueDefinitionOriginKindAt(
                   typedIr, borrowOwnerSemanticRow) ==
                   texpr.TypedExprValueDefinitionOriginParameter:
                # [w117f] 参数借主权威对 Owned（不可变托管形参，发布
                # canonical 裁定 owned 行自身即权威）与 Borrowed（var/
                # @borrows 形参自根）双形放行；entry-slot 身份链下方
                # 原样（ParamRef+序数+entry slot+stackOffset 互证），
                # 其余所有权（Unmanaged 等）仍拒。
                if texpr.TypedExprValueDefinitionOwnershipAt(
                       typedIr, borrowOwnerSemanticRow) !=
                       texpr.TypedExprExprBorrowed &&
                   texpr.TypedExprValueDefinitionOwnershipAt(
                       typedIr, borrowOwnerSemanticRow) !=
                       texpr.TypedExprExprOwned:
                    let panicMsg = Fmt"primary: managed BodyOp non-parameter borrow owner requires immutable semantic index site=a node={nodeIndex} def_row={semanticDefinitionRow} def_origin={Int32(texpr.TypedExprValueDefinitionOriginKindAt(typedIr, semanticDefinitionRow))} def_own={Int32(texpr.TypedExprValueDefinitionOwnershipAt(typedIr, semanticDefinitionRow))} owner_row={borrowOwnerSemanticRow} owner_origin={Int32(texpr.TypedExprValueDefinitionOriginKindAt(typedIr, borrowOwnerSemanticRow))} owner_own={Int32(texpr.TypedExprValueDefinitionOwnershipAt(typedIr, borrowOwnerSemanticRow))} owner_node={texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(typedIr, borrowOwnerSemanticRow)}"
                    panic(panicMsg)
                let ownerNode =
                    texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                        typedIr, borrowOwnerSemanticRow)
                if ownerNode < 0 ||
                   ownerNode >= typedIr.nodes2_nodeIndexs.len ||
                   typedIr.nodes2_opKinds[ownerNode] !=
                       texpr.TypedExprIrOpParamRef:
                    panic("primary: managed BodyOp parameter owner node invalid")
                let parameterOrdinal = arenamod.ArenaArrayInt32Get(
                    typedIr.arena, typedIr.nodes2_paramSlots, ownerNode)
                if parameterOrdinal < 0 ||
                   parameterOrdinal >= bodyIR.entryParameterSlotIds.len:
                    panic("primary: managed BodyOp parameter owner index missing")
                borrowOwnerDefinitionRow =
                    bodyIR.entryParameterSlotIds[parameterOrdinal]
                if borrowOwnerDefinitionRow < 0 ||
                   borrowOwnerDefinitionRow >= bodyIR.localSlots.len ||
                   bodyIR.localSlots[borrowOwnerDefinitionRow].stackOffset !=
                       0 - 1 - parameterOrdinal:
                    panic("primary: managed BodyOp parameter owner identity drift")
                borrowOwnerDefinitionDomain =
                    coreir.BodyDefinitionDomainEntrySlotTag
            else:
                # 非参数借主（loweringBodyIrBorrowOwnerPhysicalRef 非参数臂
                # 同一契约）：只能是无自身借主的 Owned 定义行。
                if texpr.TypedExprValueDefinitionOwnershipAt(
                       typedIr, borrowOwnerSemanticRow) !=
                       texpr.TypedExprExprOwned ||
                   texpr.TypedExprValueDefinitionBorrowOwnerValueDefinitionRowAt(
                       typedIr, borrowOwnerSemanticRow) != -1:
                    let panicMsg = Fmt"primary: managed BodyOp non-parameter borrow owner requires immutable semantic index site=b node={nodeIndex} def_row={semanticDefinitionRow} def_origin={Int32(texpr.TypedExprValueDefinitionOriginKindAt(typedIr, semanticDefinitionRow))} def_own={Int32(texpr.TypedExprValueDefinitionOwnershipAt(typedIr, semanticDefinitionRow))} owner_row={borrowOwnerSemanticRow} owner_origin={Int32(texpr.TypedExprValueDefinitionOriginKindAt(typedIr, borrowOwnerSemanticRow))} owner_own={Int32(texpr.TypedExprValueDefinitionOwnershipAt(typedIr, borrowOwnerSemanticRow))} owner_owncol={texpr.TypedExprValueDefinitionBorrowOwnerValueDefinitionRowAt(typedIr, borrowOwnerSemanticRow)} owner_node={texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(typedIr, borrowOwnerSemanticRow)}"
                    panic(panicMsg)
                borrowOwnerAuthorityRow = borrowOwnerSemanticRow
        else:
            let defOriginKind =
                texpr.TypedExprValueDefinitionOriginKindAt(
                    typedIr, semanticDefinitionRow)
            let defOwnership =
                texpr.TypedExprValueDefinitionOwnershipAt(
                    typedIr, semanticDefinitionRow)
            if defOriginKind ==
                   texpr.TypedExprValueDefinitionOriginParameter ||
               defOwnership != texpr.TypedExprExprOwned:
                # [w117f] 列缺席且两参数镜像臂均未恢复的自根缺席形：
                # 判词带 def 行+定义节点全列实况（wall65 三站点富化
                # 先例同款），定性剩余家族；守卫判定零改动。
                let defNode =
                    texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                        typedIr, semanticDefinitionRow)
                var defNodeOpText = "out_of_range"
                var defNodeClass: int32 = -2
                var defNodeManaged: int32 = -2
                var defNodeProof: int32 = -2
                var defNodeParser: int32 = -2
                var defNodeSynthetic: int32 = -2
                var defNodeSpan: int32 = -2
                var defNodeParamSlot: int32 = -2
                if defNode >= 0 &&
                   defNode < typedIr.nodes2_nodeIndexs.len:
                    defNodeOpText = texpr.TypedExprIrOpKindText(
                        typedIr.nodes2_opKinds[defNode])
                    defNodeClass = Int32(
                        typedIr.nodes2_exprClasses[defNode])
                    defNodeProof = arenamod.ArenaArrayInt32Get(
                        typedIr.arena,
                        typedIr.nodes2_resultTypeProofKinds,
                        defNode)
                    defNodeParser = arenamod.ArenaArrayInt32Get(
                        typedIr.arena,
                        typedIr.nodes2_originParserNodeIds,
                        defNode)
                    defNodeSynthetic = arenamod.ArenaArrayInt32Get(
                        typedIr.arena,
                        typedIr.nodes2_syntheticOriginKinds,
                        defNode)
                    defNodeSpan = arenamod.ArenaArrayInt32Get(
                        typedIr.arena,
                        typedIr.nodes2_spanAuthorityKinds,
                        defNode)
                    defNodeParamSlot = arenamod.ArenaArrayInt32Get(
                        typedIr.arena,
                        typedIr.nodes2_paramSlots,
                        defNode)
                    defNodeManaged = 0
                    if typedIr.nodes2_resultTypeManagedFlags[defNode]:
                        defNodeManaged = 1
                let panicMsg = Fmt"primary: managed BodyOp non-parameter borrow owner requires immutable semantic index site=c node={nodeIndex} def_row={semanticDefinitionRow} def_origin={Int32(defOriginKind)} def_own={Int32(defOwnership)} owner_row={borrowOwnerSemanticRow} owner_node={defNode} def_owncol={borrowOwnerSemanticRow} def_node_op={defNodeOpText} def_node_class={defNodeClass} def_node_managed={defNodeManaged} def_node_proof={defNodeProof} def_node_parser={defNodeParser} def_node_synthetic={defNodeSynthetic} def_node_span={defNodeSpan} def_node_param_slot={defNodeParamSlot}"
                panic(panicMsg)
            borrowOwnerSemanticRow = semanticDefinitionRow
            borrowOwnerAuthorityRow = semanticDefinitionRow
        if borrowOwnerAuthorityRow >= 0:
            # BodyOp 物理定位（lowering 范本同款）：唯一
            # valueDefSemanticRow==权威行 且 OwnMove 的既有定义 op。
            # 调用点均先构造本 op、Prepare、再 append，扫到的定义行
            # 必然先于本 op（exact-def owner<walk 链契约）。
            var ownerOpIndex: int32 = -1
            for opIndex in 0..<bodyIR.ops.len:
                let candidate = bodyIR.ops[opIndex]
                if candidate.valueDefSemanticRow !=
                       borrowOwnerAuthorityRow ||
                   candidate.valueDefOwnership != coreir.OwnMove:
                    continue
                if ownerOpIndex >= 0:
                    panic("primary: managed BodyOp borrow owner BodyOp definition duplicated")
                ownerOpIndex = opIndex
            if ownerOpIndex < 0:
                panic("primary: managed BodyOp borrow owner BodyOp definition missing")
            borrowOwnerDefinitionDomain =
                coreir.BodyDefinitionDomainBodyOpTag
            borrowOwnerDefinitionRow = ownerOpIndex
    elif ownership == coreir.OwnMove:
        if texpr.TypedExprValueDefinitionBorrowOwnerValueDefinitionRowAt(
               typedIr, semanticDefinitionRow) != -1:
            panic("primary: owned managed BodyOp carries borrow owner")
    else:
        panic("primary: managed BodyOp ownership invalid")
    op.valueDefSlot = valueSlot
    op.valueDefExprNodeIndex = nodeIndex
    op.valueDefSemanticRow = semanticDefinitionRow
    op.valueDefOwnership = ownership
    op.valueDefBorrowOwnerSemanticRow = borrowOwnerSemanticRow
    op.valueDefBorrowOwnerDefinitionDomain =
        borrowOwnerDefinitionDomain
    op.valueDefBorrowOwnerDefinitionRow = borrowOwnerDefinitionRow
    op.valueDefOriginKind = coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = semanticDefinitionRow

@borrows
fn PrimaryBodyIrMaterializeManagedBorrowedNodeValueExact(
        bodyIR: var coreir.BodyIR,
        slotNames: var str[],
        typedIr: texpr.TypedExprIr,
        sourcePath: str,
        typeRaw: str,
        sourceSlot: int32,
        nodeIndex: int32): int32 =
    var hasManaged: bool
    if !texpr.TypedExprIrTypeContainsManagedStorage(typedIr,
                                                    sourcePath,
                                                    typeRaw,
                                                    hasManaged):
        panic("primary: borrowed node managed-storage authority unavailable")
    if !hasManaged:
        return sourceSlot
    if sourceSlot < 0 || sourceSlot >= bodyIR.localSlots.len:
        panic("primary: borrowed node source slot invalid")
    let source = bodyIR.localSlots[sourceSlot]
    var valueSlot: int32
    if source.typeKind == coreir.LocalStrTag:
        valueSlot = PrimaryBodyIrFindOrCreateSlot(
            bodyIR, slotNames, Fmt"#nev{nodeIndex}#borrowed", coreir.LocalStrTag)
    else:
        valueSlot = PrimaryBodyIrFindOrCreateSlotSized(
            bodyIR,
            slotNames,
            Fmt"#nev{nodeIndex}#borrowed",
            source.typeKind,
            source.sizeBytes,
            source.alignBytes)
        if valueSlot >= 0:
            bodyIR.localSlots[valueSlot].auxValue = source.auxValue
    if valueSlot < 0 || valueSlot == sourceSlot:
        panic("primary: borrowed node materialization slot invalid")
    var valueOp: coreir.BodyOp
    valueOp.target = valueSlot
    if source.placeKind == coreir.BodyPlaceGlobalAddressTag ||
       PrimaryBodyIrLocalIsParam(source):
        valueOp.kind = coreir.BodyOpFieldLoadTag
        add(valueOp.operands, sourceSlot)
        add(valueOp.operands, valueSlot)
        add(valueOp.operands, 0)
        add(valueOp.operands, source.sizeBytes)
    else:
        valueOp.kind = coreir.BodyOpCopyLocalTag
        add(valueOp.operands, sourceSlot)
    PrimaryBodyIrPrepareManagedBodyOpValueDefinitionExact(
        bodyIR, typedIr, sourcePath, typeRaw, nodeIndex, valueOp)
    let _ = coreir.BodyIRAppendOp(bodyIR, valueOp)
    return valueSlot

# Whole-value managed global store.  The destination is always a canonical
# GlobalAddress slot. The canonical action derives TypeId, ownership, source
# value-definition, runtime semantic CID and address passing from frozen
# BodyIR facts; text, callee spelling and mutable LocalSlot ownership are not
# authority.
@borrows
fn PrimaryBodyIrAppendManagedGlobalStore(bodyIR: var coreir.BodyIR,
                                          lowering: var lower.LoweringPlanStub,
                                          globalSlot: int32,
                                          valueSlot: int32,
                                          valueDefinitionRow: int32,
                                          callOrdinal: var int32): bool =
    if globalSlot < 0 || globalSlot >= bodyIR.localSlots.len ||
       valueSlot < 0 || valueSlot >= bodyIR.localSlots.len ||
       bodyIR.localSlots[globalSlot].placeKind != coreir.BodyPlaceGlobalAddressTag:
        return false
    let valueKind = PrimaryBodyIrSlotType(bodyIR, valueSlot)
    if PrimaryBodyIrSlotType(bodyIR, globalSlot) != valueKind:
        return false
    let exactTypeId =
        bodyIR.localSlots[valueSlot].typeArenaTypeId
    if exactTypeId < 0 ||
       bodyIR.localSlots[valueSlot].managedStorageKind !=
           coreir.BodyManagedStorageManagedTag:
        panic("primary: managed replace source TypeId proof invalid")
    let _ =
        managedreplace.ManagedLvalueReplaceProductionPreflightStoreTypeExact(
            exactTypeId,
            lowering.typeArenaStructuralKinds,
            lowering.typeArenaScalarKinds,
            lowering.typeArenaChildTypeIds,
            lowering.typeArenaFixedLengths,
            lowering.typeArenaSizeBytes,
            lowering.typeArenaAlignBytes)
    if !coreir.BodyIRBindLocalSlotTypeArenaProof(
           bodyIR,
           globalSlot,
           lowering.typeArenaArtifactCid,
           exactTypeId,
           coreir.BodyManagedStorageManagedTag) ||
       !managedreplace.ManagedLvalueReplaceProductionBindTypeClosure(
           bodyIR,
           lowering.typeArenaArtifactCid,
           exactTypeId,
           lowering.typeArenaStructuralKinds,
           lowering.typeArenaScalarKinds,
           lowering.typeArenaChildTypeIds,
           lowering.typeArenaFixedLengths,
           lowering.typeArenaSizeBytes,
           lowering.typeArenaAlignBytes):
        panic("primary: managed replace TypeId closure bind failed")
    let action =
        managedreplace.ManagedLvalueReplaceProductionBuildGlobalAction(
            bodyIR,
            globalSlot,
            valueSlot,
            valueDefinitionRow)
    return managedreplace.ManagedLvalueReplaceProductionAppendGlobal(
        bodyIR, action, callOrdinal)

# wall33 根修 b/c 公共定位: `slot` 最近的、带完整 TypedExpr+OwnMove 权威戳的
# 托管值定义 op 行 (primary 三处 binder/WholeCall 戳的唯一生产形), 无则 -1。
# 借视 (OwnBorrowShared) / 清理动作 / 未戳 op 一律不返回 —— decode 对它们
# 本就不承认任何消费边, 返回即会诱导非法接线。
@borrows
fn PrimaryBodyIrLastManagedOwnMoveDefOpIndexForSlot(
        bodyIR: var coreir.BodyIR,
        slot: int32): int32 =
    if slot < 0 || slot >= bodyIR.localSlots.len:
        return -1
    var scanIndex = bodyIR.ops.len - 1
    while scanIndex >= 0:
        let candidate = bodyIR.ops[scanIndex]
        if candidate.valueDefSlot == slot &&
           candidate.valueDefOwnership == coreir.OwnMove &&
           candidate.valueDefOriginKind ==
               coreir.BodyDefinitionOriginTypedExprTag:
            return scanIndex
        scanIndex = scanIndex - 1
    return -1

@borrows
fn PrimaryBodyIrAppendSeqStrAddValueSlot(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          seqSlot: int32,
                                          valueSlot: int32,
                                          callOrdinal: var int32): bool =
    if seqSlot < 0 ||
       seqSlot >= bodyIR.localSlots.len ||
       valueSlot < 0 ||
       valueSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryBodyIrSlotType(bodyIR, seqSlot) != coreir.LocalAggregateTag:
        return false
    let recordSlot = PrimaryBodyIrSeqStrAddRecordSlot(bodyIR, slotNames, valueSlot)
    if recordSlot < 0 || recordSlot >= bodyIR.localSlots.len:
        return false
    var call: coreir.CallOp
    call.targetSymbol = "cheng_seq_str_add"
    call.resultSlot = -1
    call.resultPassKind = coreir.BodyCallPassStackValueTag
    add(call.argSlots, coreir.CallArgSlotAddress(seqSlot))
    add(call.argPassKinds, coreir.BodyCallPassParamAddressTag)
    add(call.argSlots, coreir.CallArgSlotAddress(recordSlot))
    add(call.argPassKinds, coreir.BodyCallPassParamAddressTag)
    # wall33 根修 b + wall35 收口: 托管 OwnMove piece 定义被本 seq-add 收编时,
    # 本 call 就是该定义的 canonical 消费 op。消费动作权威在 managed-lvalue-
    # replace 生产道（ManagedLvalueReplaceProductionBindIntrinsicSourceConsume,
    # 与 managed-replace move 道的 replaceOpId 戳同域）：它逐列证明源定义的
    # exact TypedExpr OwnMove mirror 拼写、绑 def 消费边到即将追加的 op 行,
    # 返回 action 行; call/op 对携带 sourceDefinition=(BodyOpTag, defRow) 与
    # consumeActionRow=op 行 —— DecodeCallOrdinal else 臂对 ManagedStoreNone
    # 消费 call 唯一承认的 explicitSourceConsumer ingress 拼写。每 piece 恰有
    # 一个 seq-add call, 单坐标对即合法表达。借视/无定义/已消费 piece 不接线。
    let seqAddPieceDefOpIndex = PrimaryBodyIrLastManagedOwnMoveDefOpIndexForSlot(
        bodyIR, recordSlot)
    var seqAddConsumeActionRow = -1
    if seqAddPieceDefOpIndex >= 0 &&
       bodyIR.ops[seqAddPieceDefOpIndex].valueDefConsumeOpIndexPlusOne == 0:
        seqAddConsumeActionRow =
            managedreplace.ManagedLvalueReplaceProductionBindIntrinsicSourceConsume(
                bodyIR, recordSlot, seqAddPieceDefOpIndex)
        call.sourceDefinitionDomain = coreir.BodyDefinitionDomainBodyOpTag
        call.sourceDefinitionRow = seqAddPieceDefOpIndex
        call.consumeActionRow = seqAddConsumeActionRow
    add(bodyIR.callSequence, call)
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpCallTag
    op.target = -1
    add(op.operands, callOrdinal)
    if seqAddConsumeActionRow >= 0:
        op.sourceDefinitionDomain = coreir.BodyDefinitionDomainBodyOpTag
        op.sourceDefinitionRow = seqAddPieceDefOpIndex
        op.consumeActionRow = seqAddConsumeActionRow
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    callOrdinal = callOrdinal + 1
    return true

@borrows
fn PrimaryBodyIrAppendSeqScalarValueSlot(bodyIR: var coreir.BodyIR,
                                         slotNames: var str[],
                                         seqSlot: int32,
                                         valueSlot: int32,
                                         elemKind: int32,
                                         elemSize: int32,
                                         callOrdinal: var int32): bool =
    if seqSlot < 0 || seqSlot >= bodyIR.localSlots.len ||
       valueSlot < 0 || valueSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryBodyIrSlotType(bodyIR, seqSlot) != coreir.LocalAggregateTag ||
       PrimaryLocalSlotSizeOf(bodyIR.localSlots[seqSlot]) < 16 ||
       PrimaryBodyIrSlotType(bodyIR, valueSlot) != elemKind ||
       PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < elemSize:
        return false
    let i32Width = elemKind == coreir.LocalI32Tag &&
                   (elemSize == 1 || elemSize == 2 || elemSize == 4)
    let wideWidth = (elemKind == coreir.LocalI64Tag ||
                     elemKind == coreir.LocalF64Tag) && elemSize == 8
    if !i32Width && !wideWidth:
        return false
    let seqLenSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   Fmt"#seq_scalar_len#{bodyIR.ops.len}",
                                                   coreir.LocalI32Tag)
    let elemSizeSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"#seq_scalar_esz#{bodyIR.ops.len}",
                                                       coreir.LocalI32Tag,
                                                       elemSize)
    let elemPtrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#seq_scalar_ptr#{bodyIR.ops.len}",
                                                    coreir.LocalPtrTag)
    if seqLenSlot < 0 || elemSizeSlot < 0 || elemPtrSlot < 0:
        return false
    var lenLoadOp: coreir.BodyOp
    lenLoadOp.kind = coreir.BodyOpFieldLoadTag
    lenLoadOp.target = seqLenSlot
    add(lenLoadOp.operands, seqSlot)
    add(lenLoadOp.operands, seqLenSlot)
    add(lenLoadOp.operands, 0)
    add(lenLoadOp.operands, 4)
    let _ = coreir.BodyIRAppendOp(bodyIR, lenLoadOp)
    var growCall: coreir.CallOp
    growCall.targetSymbol = "cheng_seq_set_grow"
    growCall.resultSlot = elemPtrSlot
    growCall.resultPassKind = coreir.BodyCallPassStackValueTag
    add(growCall.argSlots, coreir.CallArgSlotAddress(seqSlot))
    add(growCall.argPassKinds, coreir.BodyCallPassParamAddressTag)
    add(growCall.argSlots, seqLenSlot)
    add(growCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(growCall.argSlots, elemSizeSlot)
    add(growCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(bodyIR.callSequence, growCall)
    var growOp: coreir.BodyOp
    growOp.kind = coreir.BodyOpCallTag
    growOp.target = elemPtrSlot
    add(growOp.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, growOp)
    callOrdinal = callOrdinal + 1
    var elemStoreOp: coreir.BodyOp
    elemStoreOp.kind = coreir.BodyOpFieldStoreTag
    elemStoreOp.target = elemPtrSlot
    add(elemStoreOp.operands, elemPtrSlot)
    add(elemStoreOp.operands, valueSlot)
    add(elemStoreOp.operands, 0)
    add(elemStoreOp.operands, elemSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, elemStoreOp)
    return true

# Struct 字段标量 seq(obj.nums, 见 PrimaryBodyIrResolveSeqRootHeader 的
# 嵌套字段偏移解析)版 grow+store 原语。与 PrimaryBodyIrAppendSeqScalarValueSlot
# 的差异只在 header 定位方式：局部聚合变量自身 seqSlot 即头指针(offset 0,
# ParamAddress 取址)；这里 seq 头嵌在 root+seqHeaderOffset 处，先经
# PrimaryBodyIrSeqAddHeaderPtrSlot 算出 root+offset 的头指针，再与普通
# PrimaryBodyIrAppendSeqGeneralAddBuiltin 路径共用 grow/store 语义。
@borrows
fn PrimaryBodyIrAppendSeqScalarValueHeaderPtrSlot(bodyIR: var coreir.BodyIR,
                                                   slotNames: var str[],
                                                   lineNumber: int32,
                                                   seqRootSlot: int32,
                                                   seqHeaderOffset: int32,
                                                   valueSlot: int32,
                                                   elemKind: int32,
                                                   elemSize: int32,
                                                   callOrdinal: var int32): bool =
    if seqRootSlot < 0 || seqRootSlot >= bodyIR.localSlots.len ||
       valueSlot < 0 || valueSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, valueSlot) != elemKind ||
       PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < elemSize:
        return false
    let i32Width = elemKind == coreir.LocalI32Tag &&
                   (elemSize == 1 || elemSize == 2 || elemSize == 4)
    let wideWidth = (elemKind == coreir.LocalI64Tag ||
                     elemKind == coreir.LocalF64Tag) && elemSize == 8
    if !i32Width && !wideWidth:
        return false
    let hdrPtrSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                      slotNames,
                                                      lineNumber,
                                                      seqRootSlot,
                                                      seqHeaderOffset)
    if hdrPtrSlot < 0:
        return false
    let seqLenSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   Fmt"#seq_scalar_hlen#{bodyIR.ops.len}",
                                                   coreir.LocalI32Tag)
    let elemSizeSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"#seq_scalar_hesz#{bodyIR.ops.len}",
                                                       coreir.LocalI32Tag,
                                                       elemSize)
    let elemPtrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#seq_scalar_hval#{bodyIR.ops.len}",
                                                    coreir.LocalPtrTag)
    if seqLenSlot < 0 || elemSizeSlot < 0 || elemPtrSlot < 0:
        return false
    var lenLoadOp: coreir.BodyOp
    lenLoadOp.kind = coreir.BodyOpFieldLoadTag
    lenLoadOp.target = seqLenSlot
    add(lenLoadOp.operands, seqRootSlot)
    add(lenLoadOp.operands, seqLenSlot)
    add(lenLoadOp.operands, seqHeaderOffset)
    add(lenLoadOp.operands, 4)
    let _ = coreir.BodyIRAppendOp(bodyIR, lenLoadOp)
    var growCall: coreir.CallOp
    growCall.targetSymbol = "cheng_seq_set_grow"
    growCall.resultSlot = elemPtrSlot
    growCall.resultPassKind = coreir.BodyCallPassStackValueTag
    add(growCall.argSlots, hdrPtrSlot)
    add(growCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(growCall.argSlots, seqLenSlot)
    add(growCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(growCall.argSlots, elemSizeSlot)
    add(growCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(bodyIR.callSequence, growCall)
    var growOp: coreir.BodyOp
    growOp.kind = coreir.BodyOpCallTag
    growOp.target = elemPtrSlot
    add(growOp.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, growOp)
    callOrdinal = callOrdinal + 1
    var elemStoreOp: coreir.BodyOp
    elemStoreOp.kind = coreir.BodyOpFieldStoreTag
    elemStoreOp.target = elemPtrSlot
    add(elemStoreOp.operands, elemPtrSlot)
    add(elemStoreOp.operands, valueSlot)
    add(elemStoreOp.operands, 0)
    add(elemStoreOp.operands, elemSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, elemStoreOp)
    return true

@borrows
fn PrimaryBodyIrGlobalAggregateDestSlot(bodyIR: var coreir.BodyIR,
                                         slotNames: var str[],
                                         typedIr: texpr.TypedExprIr,
                                         sourcePath: str,
                                         rootName: str): int32 =
    let globalType = PrimaryBodyIrTypedGlobalTypeExact(typedIr, sourcePath, rootName)
    if globalType == "":
        return -1
    var globalTypeKind: int32
    var globalSizeBytes: int32
    var globalAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   globalType,
                                   globalTypeKind,
                                   globalSizeBytes,
                                   globalAlignBytes)
    if globalTypeKind != coreir.LocalAggregateTag:
        return -1
    let globalSlotName = PrimaryBodyIrTypedGlobalSlotNameExact(typedIr, sourcePath, rootName)
    if globalSlotName == "":
        return -1
    let globalSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                        slotNames,
                                                        globalSlotName,
                                                        globalTypeKind,
                                                        globalSizeBytes,
                                                        globalAlignBytes)
    if globalSlot < 0 || globalSlot >= bodyIR.localSlots.len:
        return -1
    PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, globalSlot)
    bodyIR.localSlots[globalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
    return globalSlot

# Materialize a module-global aggregate's (struct/seq) ADDRESS into a Ptr slot.
# The global data label holds the aggregate bytes inline (struct fields, or the
# seq len/cap/buf header), so fields/elements are read by treating the returned
# Ptr slot as the aggregate base. Returns -1 unless the name is a module-global
# whose slot is inline aggregate data (a `ref`/pointer global classifies as Ptr,
# not Aggregate, and must be value-loaded through the scalar path instead).
@borrows
fn PrimaryBodyIrGlobalSeqAddressSlot(bodyIR: var coreir.BodyIR,
                                      slotNames: var str[],
                                      typedIr: texpr.TypedExprIr,
                                      sourcePath: str,
                                      rootName: str): int32 =
    # exact source-path match preferred; c857 non-exact uniqueness fallback for a
    # module-global whose registration sourcePath normalizes differently from the
    # caller's (e.g. `loweringParallelResults`). The slot name is keyed off the SAME
    # registered sourcePath as the type so the emitted global symbol stays correct.
    let globalSource = PrimaryBodyIrTypedGlobalSourcePath(typedIr, sourcePath, rootName)
    if globalSource == "":
        return -1
    var globalType = PrimaryBodyIrTypedGlobalTypeExact(typedIr, sourcePath, rootName)
    if globalType == "":
        globalType = PrimaryBodyIrTypedGlobalType(typedIr, sourcePath, rootName)
    if globalType == "":
        return -1
    var globalTypeKind: int32
    var globalSizeBytes: int32
    var globalAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   globalSource,
                                   globalType,
                                   globalTypeKind,
                                   globalSizeBytes,
                                   globalAlignBytes)
    if globalTypeKind != coreir.LocalAggregateTag:
        return -1
    var globalSlotName = PrimaryBodyIrTypedGlobalSlotNameExact(typedIr, sourcePath, rootName)
    if globalSlotName == "":
        globalSlotName = PrimaryBodyIrTypedGlobalSlotName(typedIr, sourcePath, rootName)
    if globalSlotName == "":
        return -1
    let globalSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                        slotNames,
                                                        globalSlotName,
                                                        globalTypeKind,
                                                        globalSizeBytes,
                                                        globalAlignBytes)
    if globalSlot < 0 || globalSlot >= bodyIR.localSlots.len:
        return -1
    PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, globalSlot)
    bodyIR.localSlots[globalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
    let addrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"{globalSlotName}#global_seq_addr",
                                                 coreir.LocalPtrTag)
    if addrSlot < 0 || addrSlot >= bodyIR.localSlots.len:
        return -1
    var addrOp: coreir.BodyOp
    addrOp.kind = coreir.BodyOpGlobalLoadTag
    addrOp.target = addrSlot
    add(addrOp.operands, globalSlot)
    add(addrOp.operands, 1)
    let _ = coreir.BodyIRAppendOp(bodyIR, addrOp)
    return addrSlot

@borrows
fn PrimaryBodyIrTextHasIndexBracket(text: str): bool =
    for sricBrkScan in 0..<len(text):
        if PrimaryBodyIrTextByteCodeEquals(text, sricBrkScan, 91):
            return true
    return false

# bail=631 reason=18/21 deep chain: 解析任意 `root(.field|[idx])*` place 链, 物化到
# "该 seq header 的基址槽 + 常量头偏移" —— 与 SeqRefForText 的 (rootSlot, headerOffset)
# 契约同构, 但支持链中任意位置的下标 (根 `conns[i]` 或中间字段 `functions[i]`)。原
# SeqRefForText 只按裸名/纯字段路径解根, 链中含 `[` 一律解不出 → reason=18/21 bail。
# 遇 `[idx]` 就按 SeqIndexValueSlot 同款三步物化元素地址 ptr:bufload@(base+off+8) +
# I32Madd(idx*esz+buf), 之后 off 清零、curType 换成元素类型继续走 `.field`/`[idx]`。
# 发的全是既有 golden 已验算子 (FieldLoad/BinOp-Madd/LoadConst), 无新后端行为, 深链
# 正确性即浅链 `arr[i].field` 的逐层复合。仅当 seq-base 含 `[` 时被调用 (无下标链走原
# 快路径 golden 字节不变)。poison-on-miss: 任一段解析失败 return false, 保持原 reason bail。
@borrows
fn PrimaryBodyIrSeqRefIndexedChain(bodyIR: var coreir.BodyIR,
                                    slotNames: var str[],
                                    varI32ParamNames: str[],
                                    typedIr: texpr.TypedExprIr,
                                    typedFn: texpr.TypedExprIrFunction,
                                    irFunction: lower.PrimaryObjectIrFunction,
                                    sourcePath: str,
                                    lineNumber: int32,
                                    chainTextRaw: str,
                                    seqRefRootSlot: var int32,
                                    seqRefHeaderOffset: var int32,
                                    seqRefTypeText: var str,
                                    callOrdinal: var int32): bool =
    seqRefRootSlot = -1
    seqRefHeaderOffset = 0
    seqRefTypeText = ""
    let chainText = strutil.Strip(chainTextRaw)
    if chainText == "":
        return false
    let sricRootName = parser.ParserIdentPrefix(chainText)
    if sricRootName == "" || len(sricRootName) >= len(chainText):
        return false
    var sricBaseSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, sricRootName)
    if sricBaseSlot < 0 || sricBaseSlot >= bodyIR.localSlots.len:
        sricBaseSlot = PrimaryBodyIrGlobalSeqAddressSlot(bodyIR,
                                                         slotNames,
                                                         typedIr,
                                                         sourcePath,
                                                         sricRootName)
        if sricBaseSlot < 0 || sricBaseSlot >= bodyIR.localSlots.len:
            return false
    let sricBaseKind = PrimaryBodyIrSlotType(bodyIR, sricBaseSlot)
    if sricBaseKind != coreir.LocalAggregateTag && sricBaseKind != coreir.LocalPtrTag:
        return false
    var sricType = texpr.TypedExprStripVarType(PrimaryBodyIrBindingTypeForName(typedIr,
                                                                               typedFn,
                                                                               irFunction,
                                                                               lineNumber,
                                                                               sricRootName))
    if sricType == "":
        sricType = texpr.TypedExprStripVarType(PrimaryBodyIrTypedGlobalTypeExact(typedIr,
                                                                                 sourcePath,
                                                                                 sricRootName))
    if sricType == "":
        return false
    var sricOffset: int32
    var sricCursor = len(sricRootName)
    while sricCursor < len(chainText):
        if PrimaryBodyIrTextByteCodeEquals(chainText, sricCursor, 46):
            let sricFieldRest = strings.SliceBytes(chainText,
                                                   sricCursor + 1,
                                                   len(chainText) - sricCursor - 1)
            let sricFieldName = parser.ParserIdentPrefix(sricFieldRest)
            if sricFieldName == "":
                return false
            var sricFieldType = ""
            var sricFieldOffset: int32
            var sricFieldSize: int32
            var sricFieldAlign: int32
            if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                                   sourcePath,
                                                   sricType,
                                                   sricFieldName,
                                                   sricFieldType,
                                                   sricFieldOffset,
                                                   sricFieldSize,
                                                   sricFieldAlign):
                return false
            sricOffset = sricOffset + sricFieldOffset
            sricType = texpr.TypedExprStripVarType(sricFieldType)
            sricCursor = sricCursor + 1 + len(sricFieldName)
        elif PrimaryBodyIrTextByteCodeEquals(chainText, sricCursor, 91):
            var sricLvl: int32
            var sricScan = sricCursor
            var sricClose = -1
            while sricScan < len(chainText):
                if PrimaryBodyIrTextByteCodeEquals(chainText, sricScan, 91):
                    sricLvl = sricLvl + 1
                elif PrimaryBodyIrTextByteCodeEquals(chainText, sricScan, 93):
                    sricLvl = sricLvl - 1
                    if sricLvl == 0:
                        sricClose = sricScan
                        break
                sricScan = sricScan + 1
            if sricClose < 0:
                return false
            let sricIdxText = strutil.Strip(strings.SliceBytes(chainText,
                                                               sricCursor + 1,
                                                               sricClose - sricCursor - 1))
            if sricIdxText == "":
                return false
            if len(sricType) < 3 ||
               strings.SliceBytes(sricType, len(sricType) - 2, 2) != "[]":
                return false
            let sricElemType = strutil.Strip(strings.SliceBytes(sricType, 0, len(sricType) - 2))
            if sricElemType == "":
                return false
            var sricElemKind: int32
            var sricElemSize: int32
            var sricElemAlign: int32
            PrimaryBodyIrTypeShapeFromText(typedIr,
                                           sourcePath,
                                           sricElemType,
                                           sricElemKind,
                                           sricElemSize,
                                           sricElemAlign)
            if sricElemSize <= 0 &&
               len(sricElemType) >= 2 &&
               strings.SliceBytes(sricElemType, len(sricElemType) - 2, 2) == "[]":
                sricElemKind = coreir.LocalAggregateTag
                sricElemSize = 16
                sricElemAlign = 8
            if sricElemSize <= 0:
                return false
            let sricBufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                            slotNames,
                                                            Fmt"#sric_buf#{lineNumber}#{bodyIR.ops.len}",
                                                            coreir.LocalPtrTag)
            if sricBufSlot < 0:
                return false
            var sricBufOp: coreir.BodyOp
            sricBufOp.kind = coreir.BodyOpFieldLoadTag
            sricBufOp.target = sricBufSlot
            add(sricBufOp.operands, sricBaseSlot)
            add(sricBufOp.operands, sricBufSlot)
            add(sricBufOp.operands, sricOffset + 8)
            add(sricBufOp.operands, 8)
            let _ = coreir.BodyIRAppendOp(bodyIR, sricBufOp)
            var sricIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  typedIr,
                                                                  sourcePath,
                                                                  sricIdxText,
                                                                  coreir.LocalI32Tag,
                                                                  callOrdinal)
            if sricIdxSlot < 0:
                sricIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  typedIr,
                                                                  sourcePath,
                                                                  sricIdxText,
                                                                  coreir.LocalI64Tag,
                                                                  callOrdinal)
            if sricIdxSlot < 0:
                return false
            let sricEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                              slotNames,
                                                              Fmt"#sric_esz#{lineNumber}#{bodyIR.ops.len}",
                                                              coreir.LocalI64Tag,
                                                              sricElemSize)
            if sricEszSlot < 0:
                return false
            let sricAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                             slotNames,
                                                             Fmt"#sric_addr#{lineNumber}#{bodyIR.ops.len}",
                                                             coreir.LocalPtrTag)
            if sricAddrSlot < 0:
                return false
            var sricAddrOp: coreir.BodyOp
            sricAddrOp.kind = coreir.BodyOpBinOpTag
            sricAddrOp.target = sricAddrSlot
            add(sricAddrOp.operands, coreir.LocalI64Tag)
            add(sricAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
            add(sricAddrOp.operands, sricIdxSlot)
            add(sricAddrOp.operands, sricEszSlot)
            add(sricAddrOp.operands, sricBufSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, sricAddrOp)
            sricBaseSlot = sricAddrSlot
            sricOffset = 0
            sricType = sricElemType
            sricCursor = sricClose + 1
        else:
            return false
    if len(sricType) < 3 ||
       strings.SliceBytes(sricType, len(sricType) - 2, 2) != "[]":
        return false
    seqRefRootSlot = sricBaseSlot
    seqRefHeaderOffset = sricOffset
    seqRefTypeText = sricType
    return true

# Pure feasibility mirror of PrimaryBodyIrSeqRefIndexedChain: decides whether the
# chain text `a[i].b[j].c` resolves to a var seq-by-address WITHOUT emitting any
# ops, so the NodeEval probe stays symmetric with the emit (a probe must never
# green-light a chain the emit can't materialize). Conservative by design: the
# root must be a function param (its type is line-independent, so no binding-line
# context is needed) and each index sub-expr must be a bare identifier bound to a
# scalar arg-slot — a strict subset of what the emit's ScalarValueSlotForText
# accepts, so probe-yes always implies emit-success (no poison); every other
# shape returns false and bails cleanly.
@borrows
fn PrimaryBodyIrSeqRefIndexedChainProbe(bodyIR: var coreir.BodyIR,
                                         slotNames: var str[],
                                         typedIr: texpr.TypedExprIr,
                                         irFunction: lower.PrimaryObjectIrFunction,
                                         sourcePath: str,
                                         chainTextRaw: str): bool =
    let chainText = strutil.Strip(chainTextRaw)
    if chainText == "":
        return false
    let sricRootName = parser.ParserIdentPrefix(chainText)
    if sricRootName == "" || len(sricRootName) >= len(chainText):
        return false
    let sricRootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, sricRootName)
    if sricRootSlot < 0 || sricRootSlot >= bodyIR.localSlots.len:
        return false
    let sricRootKind = PrimaryBodyIrSlotType(bodyIR, sricRootSlot)
    if sricRootKind != coreir.LocalAggregateTag && sricRootKind != coreir.LocalPtrTag:
        return false
    var sricType = ""
    for sricParamIndex in 0..<irFunction.paramNames.len:
        if sricParamIndex >= irFunction.paramTypes.len:
            continue
        if irFunction.paramNames[sricParamIndex] == sricRootName:
            sricType = texpr.TypedExprStripVarType(irFunction.paramTypes[sricParamIndex])
    if sricType == "":
        return false
    var sricCursor = len(sricRootName)
    while sricCursor < len(chainText):
        if PrimaryBodyIrTextByteCodeEquals(chainText, sricCursor, 46):
            let sricFieldRest = strings.SliceBytes(chainText,
                                                   sricCursor + 1,
                                                   len(chainText) - sricCursor - 1)
            let sricFieldName = parser.ParserIdentPrefix(sricFieldRest)
            if sricFieldName == "":
                return false
            var sricFieldType = ""
            var sricFieldOffset: int32
            var sricFieldSize: int32
            var sricFieldAlign: int32
            if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                                   sourcePath,
                                                   sricType,
                                                   sricFieldName,
                                                   sricFieldType,
                                                   sricFieldOffset,
                                                   sricFieldSize,
                                                   sricFieldAlign):
                return false
            sricType = texpr.TypedExprStripVarType(sricFieldType)
            sricCursor = sricCursor + 1 + len(sricFieldName)
        elif PrimaryBodyIrTextByteCodeEquals(chainText, sricCursor, 91):
            var sricLvl: int32
            var sricScan = sricCursor
            var sricClose = -1
            while sricScan < len(chainText):
                if PrimaryBodyIrTextByteCodeEquals(chainText, sricScan, 91):
                    sricLvl = sricLvl + 1
                elif PrimaryBodyIrTextByteCodeEquals(chainText, sricScan, 93):
                    sricLvl = sricLvl - 1
                    if sricLvl == 0:
                        sricClose = sricScan
                        break
                sricScan = sricScan + 1
            if sricClose < 0:
                return false
            let sricIdxText = strutil.Strip(strings.SliceBytes(chainText,
                                                               sricCursor + 1,
                                                               sricClose - sricCursor - 1))
            if sricIdxText == "":
                return false
            if len(sricType) < 3 ||
               strings.SliceBytes(sricType, len(sricType) - 2, 2) != "[]":
                return false
            let sricElemType = strutil.Strip(strings.SliceBytes(sricType, 0, len(sricType) - 2))
            if sricElemType == "":
                return false
            var sricElemKind: int32
            var sricElemSize: int32
            var sricElemAlign: int32
            PrimaryBodyIrTypeShapeFromText(typedIr,
                                           sourcePath,
                                           sricElemType,
                                           sricElemKind,
                                           sricElemSize,
                                           sricElemAlign)
            if sricElemSize <= 0 &&
               len(sricElemType) >= 2 &&
               strings.SliceBytes(sricElemType, len(sricElemType) - 2, 2) == "[]":
                sricElemSize = 16
            if sricElemSize <= 0:
                return false
            if parser.ParserIdentPrefix(sricIdxText) != sricIdxText:
                return false
            let sricIdxSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, sricIdxText)
            if sricIdxSlot < 0 || sricIdxSlot >= bodyIR.localSlots.len:
                return false
            let sricIdxKind = PrimaryBodyIrSlotType(bodyIR, sricIdxSlot)
            if sricIdxKind != coreir.LocalI32Tag && sricIdxKind != coreir.LocalI64Tag:
                return false
            sricType = sricElemType
            sricCursor = sricClose + 1
        else:
            return false
    if len(sricType) < 3 ||
       strings.SliceBytes(sricType, len(sricType) - 2, 2) != "[]":
        return false
    return true

# Resolve a seq reference text (plain name or nested field path) into its
# root slot, header byte offset, and seq type text.
@borrows
fn PrimaryBodyIrSeqRefForText(bodyIR: var coreir.BodyIR,
                               slotNames: var str[],
                               typedIr: texpr.TypedExprIr,
                               typedFn: texpr.TypedExprIrFunction,
                               irFunction: lower.PrimaryObjectIrFunction,
                               sourcePath: str,
                               lineNumber: int32,
                               seqTextRaw: str,
                               seqRefRootSlot: var int32,
                               seqRefHeaderOffset: var int32,
                               seqRefTypeText: var str): bool =
    seqRefRootSlot = -1
    seqRefHeaderOffset = 0
    seqRefTypeText = ""
    let seqText = strutil.Strip(seqTextRaw)
    if seqText == "":
        return false
    var seqRootName = strings.CloneStr(seqText)
    var seqFieldName = ""
    var dotPos: int32
    dotPos = -1
    for seqCharIndex in 0..<len(seqText):
        if PrimaryBodyIrTextByteCodeEquals(seqText, seqCharIndex, 46):
            dotPos = seqCharIndex
            break
    if dotPos >= 0:
        if dotPos <= 0 || dotPos + 1 >= len(seqText):
            return false
        seqRootName = strutil.Strip(strings.SliceBytes(seqText, 0, dotPos))
        seqFieldName = strutil.Strip(strings.SliceBytes(seqText,
                                                        dotPos + 1,
                                                        len(seqText) - dotPos - 1))
        if seqRootName == "" || seqFieldName == "":
            return false
    var seqRootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, seqRootName)
    if seqRootSlot < 0 || seqRootSlot >= bodyIR.localSlots.len:
        seqRootSlot = PrimaryBodyIrGlobalSeqAddressSlot(bodyIR,
                                                        slotNames,
                                                        typedIr,
                                                        sourcePath,
                                                        seqRootName)
        if seqRootSlot < 0 || seqRootSlot >= bodyIR.localSlots.len:
            return false
    let seqRootTypeKind = PrimaryBodyIrSlotType(bodyIR, seqRootSlot)
    if seqRootTypeKind != coreir.LocalAggregateTag &&
       seqRootTypeKind != coreir.LocalPtrTag:
        return false
    var seqTypeText = ""
    var seqHeaderOffset: int32
    if seqFieldName == "":
        seqTypeText = texpr.TypedExprStripVarType(PrimaryBodyIrBindingTypeForName(typedIr,
                                                                                  typedFn,
                                                                                  irFunction,
                                                                                  lineNumber,
                                                                                  seqRootName))
        if seqTypeText == "":
            seqTypeText = texpr.TypedExprStripVarType(PrimaryBodyIrTypedGlobalTypeExact(typedIr,
                                                                                        sourcePath,
                                                                                        seqRootName))
    else:
        var seqOwnerType = PrimaryBodyIrBindingTypeForName(typedIr,
                                                           typedFn,
                                                           irFunction,
                                                           lineNumber,
                                                           seqRootName)
        var seqFieldRest = strings.CloneStr(seqFieldName)
        while seqFieldRest != "":
            var seqSegment = strings.CloneStr(seqFieldRest)
            var seqSegmentDot: int32
            seqSegmentDot = -1
            for seqSegIndex in 0..<len(seqFieldRest):
                if PrimaryBodyIrTextByteCodeEquals(seqFieldRest, seqSegIndex, 46):
                    seqSegmentDot = seqSegIndex
                    break
            if seqSegmentDot >= 0:
                seqSegment = strings.CloneStr(strutil.Strip(strings.SliceBytes(seqFieldRest,
                                                                               0,
                                                                               seqSegmentDot)))
                seqFieldRest = strings.CloneStr(strutil.Strip(strings.SliceBytes(seqFieldRest,
                                                                                 seqSegmentDot + 1,
                                                                                 len(seqFieldRest) - seqSegmentDot - 1)))
            else:
                seqFieldRest = ""
            if seqSegment == "":
                return false
            var seqFieldType = ""
            var seqFieldOffsetBytes: int32
            var seqFieldSizeBytes: int32
            var seqFieldAlignBytes: int32
            if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                                   sourcePath,
                                                   seqOwnerType,
                                                   seqSegment,
                                                   seqFieldType,
                                                   seqFieldOffsetBytes,
                                                   seqFieldSizeBytes,
                                                   seqFieldAlignBytes):
                return false
            seqHeaderOffset = seqHeaderOffset + seqFieldOffsetBytes
            seqOwnerType = strings.CloneStr(texpr.TypedExprStripVarType(seqFieldType))
        seqTypeText = seqOwnerType
    if len(seqTypeText) < 3:
        return false
    if strings.SliceBytes(seqTypeText, len(seqTypeText) - 2, 2) != "[]":
        return false
    seqRefRootSlot = seqRootSlot
    seqRefHeaderOffset = seqHeaderOffset
    seqRefTypeText = seqTypeText
    return true

# Materialize `base.len` for a seq base (plain or field path): the len field
# sits at header offset 0 as i32.
@borrows
fn PrimaryBodyIrSeqLenValueSlot(bodyIR: var coreir.BodyIR,
                                 slotNames: var str[],
                                 typedIr: texpr.TypedExprIr,
                                 typedFn: texpr.TypedExprIrFunction,
                                 irFunction: lower.PrimaryObjectIrFunction,
                                 sourcePath: str,
                                 lineNumber: int32,
                                 textRaw: str): int32 =
    let text = strutil.Strip(textRaw)
    if len(text) < 5:
        return -1
    if strings.SliceBytes(text, len(text) - 4, 4) != ".len":
        return -1
    let seqLenBase = strutil.Strip(strings.SliceBytes(text, 0, len(text) - 4))
    if seqLenBase == "":
        return -1
    var seqLenRootSlot: int32
    var seqLenHeaderOffset: int32
    var seqLenTypeText = ""
    if !PrimaryBodyIrSeqRefForText(bodyIR,
                                   slotNames,
                                   typedIr,
                                   typedFn,
                                   irFunction,
                                   sourcePath,
                                   lineNumber,
                                   seqLenBase,
                                   seqLenRootSlot,
                                   seqLenHeaderOffset,
                                   seqLenTypeText):
        return -1
    let seqLenSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   Fmt"#seq_len#{lineNumber}#{bodyIR.ops.len}",
                                                   coreir.LocalI32Tag)
    if seqLenSlot < 0:
        return -1
    var seqLenLoadOp: coreir.BodyOp
    seqLenLoadOp.kind = coreir.BodyOpFieldLoadTag
    seqLenLoadOp.target = seqLenSlot
    add(seqLenLoadOp.operands, seqLenRootSlot)
    add(seqLenLoadOp.operands, seqLenSlot)
    add(seqLenLoadOp.operands, seqLenHeaderOffset)
    add(seqLenLoadOp.operands, 4)
    let _ = coreir.BodyIRAppendOp(bodyIR, seqLenLoadOp)
    return seqLenSlot

# Materialize `base[idx]` for a seq base: load the buffer pointer from the
# header, compute buffer + idx*elemSize, and copy the element bytes into a
# typed slot.
@borrows
fn PrimaryBodyIrSeqIndexValueSlot(bodyIR: var coreir.BodyIR,
                                   slotNames: var str[],
                                   varI32ParamNames: str[],
                                   typedIr: texpr.TypedExprIr,
                                   typedFn: texpr.TypedExprIrFunction,
                                   irFunction: lower.PrimaryObjectIrFunction,
                                   sourcePath: str,
                                   lineNumber: int32,
                                   textRaw: str,
                                   callOrdinal: var int32): int32 =
    let text = strutil.Strip(textRaw)
    if len(text) < 4 || !PrimaryBodyIrTextByteCodeEquals(text, len(text) - 1, 93):
        return -1
    var bracketLevel: int32
    var bracketScan = len(text) - 1
    var bracketOpen: int32
    bracketOpen = -1
    while bracketScan >= 0:
        if PrimaryBodyIrTextByteCodeEquals(text, bracketScan, 93):
            bracketLevel = bracketLevel + 1
        elif PrimaryBodyIrTextByteCodeEquals(text, bracketScan, 91):
            bracketLevel = bracketLevel - 1
            if bracketLevel == 0:
                bracketOpen = bracketScan
                break
        bracketScan = bracketScan - 1
    if bracketOpen <= 0:
        return -1
    let seqBaseText = strutil.Strip(strings.SliceBytes(text, 0, bracketOpen))
    let seqIndexText = strutil.Strip(strings.SliceBytes(text,
                                                        bracketOpen + 1,
                                                        len(text) - bracketOpen - 2))
    if seqBaseText == "" || seqIndexText == "":
        return -1
    var seqRefRootSlot: int32
    var seqRefHeaderOffset: int32
    var seqRefTypeText = ""
    var seqRefOk = false
    if PrimaryBodyIrTextHasIndexBracket(seqBaseText):
        seqRefOk = PrimaryBodyIrSeqRefIndexedChain(bodyIR,
                                                   slotNames,
                                                   varI32ParamNames,
                                                   typedIr,
                                                   typedFn,
                                                   irFunction,
                                                   sourcePath,
                                                   lineNumber,
                                                   seqBaseText,
                                                   seqRefRootSlot,
                                                   seqRefHeaderOffset,
                                                   seqRefTypeText,
                                                   callOrdinal)
    else:
        seqRefOk = PrimaryBodyIrSeqRefForText(bodyIR,
                                              slotNames,
                                              typedIr,
                                              typedFn,
                                              irFunction,
                                              sourcePath,
                                              lineNumber,
                                              seqBaseText,
                                              seqRefRootSlot,
                                              seqRefHeaderOffset,
                                              seqRefTypeText)
    if !seqRefOk:
        return -1
    let seqElemType = strutil.Strip(strings.SliceBytes(seqRefTypeText,
                                                       0,
                                                       len(seqRefTypeText) - 2))
    if seqElemType == "":
        return -1
    var seqElemTypeKind: int32
    var seqElemSizeBytes: int32
    var seqElemAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   seqElemType,
                                   seqElemTypeKind,
                                   seqElemSizeBytes,
                                   seqElemAlignBytes)
    if seqElemSizeBytes <= 0 &&
       len(seqElemType) >= 2 &&
       strings.SliceBytes(seqElemType, len(seqElemType) - 2, 2) == "[]":
        seqElemTypeKind = coreir.LocalAggregateTag
        seqElemSizeBytes = 16
        seqElemAlignBytes = 8
    if seqElemSizeBytes <= 0:
        return -1
    let seqIdxBufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                      slotNames,
                                                      Fmt"#seq_idx_buf#{lineNumber}#{bodyIR.ops.len}",
                                                      coreir.LocalPtrTag)
    if seqIdxBufSlot < 0:
        return -1
    var bufLoadOp: coreir.BodyOp
    bufLoadOp.kind = coreir.BodyOpFieldLoadTag
    bufLoadOp.target = seqIdxBufSlot
    add(bufLoadOp.operands, seqRefRootSlot)
    add(bufLoadOp.operands, seqIdxBufSlot)
    add(bufLoadOp.operands, seqRefHeaderOffset + 8)
    add(bufLoadOp.operands, 8)
    let _ = coreir.BodyIRAppendOp(bodyIR, bufLoadOp)
    var seqIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         typedIr,
                                                         sourcePath,
                                                         seqIndexText,
                                                         coreir.LocalI32Tag,
                                                         callOrdinal)
    if seqIdxSlot < 0:
        seqIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         typedIr,
                                                         sourcePath,
                                                         seqIndexText,
                                                         coreir.LocalI64Tag,
                                                         callOrdinal)
    if seqIdxSlot < 0:
        return -1
    let seqIdxEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                        slotNames,
                                                        Fmt"#seq_idx_esz#{lineNumber}#{bodyIR.ops.len}",
                                                        coreir.LocalI64Tag,
                                                        seqElemSizeBytes)
    if seqIdxEszSlot < 0:
        return -1
    let seqIdxAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"#seq_idx_addr#{lineNumber}#{bodyIR.ops.len}",
                                                       coreir.LocalPtrTag)
    if seqIdxAddrSlot < 0:
        return -1
    var addrOp: coreir.BodyOp
    addrOp.kind = coreir.BodyOpBinOpTag
    addrOp.target = seqIdxAddrSlot
    add(addrOp.operands, coreir.LocalI64Tag)
    add(addrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
    add(addrOp.operands, seqIdxSlot)
    add(addrOp.operands, seqIdxEszSlot)
    add(addrOp.operands, seqIdxBufSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, addrOp)
    let seqIdxValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                             slotNames,
                                                             typedIr,
                                                             sourcePath,
                                                             Fmt"#seq_idx_val#{lineNumber}#{bodyIR.ops.len}",
                                                             seqElemType)
    if seqIdxValueSlot < 0:
        return -1
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[seqIdxValueSlot]) < seqElemSizeBytes:
        return -1
    var elemLoadOp: coreir.BodyOp
    elemLoadOp.kind = coreir.BodyOpFieldLoadTag
    elemLoadOp.target = seqIdxValueSlot
    add(elemLoadOp.operands, seqIdxAddrSlot)
    add(elemLoadOp.operands, seqIdxValueSlot)
    add(elemLoadOp.operands, 0)
    add(elemLoadOp.operands, seqElemSizeBytes)
    let _ = coreir.BodyIRAppendOp(bodyIR, elemLoadOp)
    return seqIdxValueSlot

# 物化 `root[idx].field` 值：先按 root[idx] 求元素地址（与 SeqIndexValueSlot
# 同款 buf 装载 + I32Madd 寻址），再按元素类型解析 field 偏移，从
# elementAddr + fieldOffset 读出字段值入定形槽。单级字段、元素为命名 struct。
@borrows
fn PrimaryBodyIrSeqIndexFieldValueSlot(bodyIR: var coreir.BodyIR,
                                        slotNames: var str[],
                                        varI32ParamNames: str[],
                                        typedIr: texpr.TypedExprIr,
                                        typedFn: texpr.TypedExprIrFunction,
                                        irFunction: lower.PrimaryObjectIrFunction,
                                        sourcePath: str,
                                        lineNumber: int32,
                                        textRaw: str,
                                        callOrdinal: var int32): int32 =
    let text = strutil.Strip(textRaw)
    var dotPos = -1
    var dotScan = len(text) - 1
    var dotBracketLevel: int32
    while dotScan >= 0:
        if PrimaryBodyIrTextByteCodeEquals(text, dotScan, 93):
            dotBracketLevel = dotBracketLevel + 1
        elif PrimaryBodyIrTextByteCodeEquals(text, dotScan, 91):
            dotBracketLevel = dotBracketLevel - 1
        elif dotBracketLevel == 0 && PrimaryBodyIrTextByteCodeEquals(text, dotScan, 46):
            dotPos = dotScan
            break
        dotScan = dotScan - 1
    if dotPos <= 0 || dotPos + 1 >= len(text):
        return -1
    let sifIndexText = strutil.Strip(strings.SliceBytes(text, 0, dotPos))
    let sifFieldName = strutil.Strip(strings.SliceBytes(text, dotPos + 1, len(text) - dotPos - 1))
    if sifIndexText == "" || sifFieldName == "":
        return -1
    if len(sifIndexText) < 4 || !PrimaryBodyIrTextByteCodeEquals(sifIndexText, len(sifIndexText) - 1, 93):
        return -1
    var sifBracketLevel: int32
    var sifBracketScan = len(sifIndexText) - 1
    var sifBracketOpen = -1
    while sifBracketScan >= 0:
        if PrimaryBodyIrTextByteCodeEquals(sifIndexText, sifBracketScan, 93):
            sifBracketLevel = sifBracketLevel + 1
        elif PrimaryBodyIrTextByteCodeEquals(sifIndexText, sifBracketScan, 91):
            sifBracketLevel = sifBracketLevel - 1
            if sifBracketLevel == 0:
                sifBracketOpen = sifBracketScan
                break
        sifBracketScan = sifBracketScan - 1
    if sifBracketOpen <= 0:
        return -1
    let sifSeqBaseText = strutil.Strip(strings.SliceBytes(sifIndexText, 0, sifBracketOpen))
    let sifSeqIndexText = strutil.Strip(strings.SliceBytes(sifIndexText,
                                                           sifBracketOpen + 1,
                                                           len(sifIndexText) - sifBracketOpen - 2))
    if sifSeqBaseText == "" || sifSeqIndexText == "":
        return -1
    var sifRootSlot: int32
    var sifHeaderOffset: int32
    var sifSeqTypeText = ""
    var sifSeqRefOk = false
    if PrimaryBodyIrTextHasIndexBracket(sifSeqBaseText):
        sifSeqRefOk = PrimaryBodyIrSeqRefIndexedChain(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      typedIr,
                                                      typedFn,
                                                      irFunction,
                                                      sourcePath,
                                                      lineNumber,
                                                      sifSeqBaseText,
                                                      sifRootSlot,
                                                      sifHeaderOffset,
                                                      sifSeqTypeText,
                                                      callOrdinal)
    else:
        sifSeqRefOk = PrimaryBodyIrSeqRefForText(bodyIR,
                                                 slotNames,
                                                 typedIr,
                                                 typedFn,
                                                 irFunction,
                                                 sourcePath,
                                                 lineNumber,
                                                 sifSeqBaseText,
                                                 sifRootSlot,
                                                 sifHeaderOffset,
                                                 sifSeqTypeText)
    if !sifSeqRefOk:
        return -1
    let sifElemType = strutil.Strip(strings.SliceBytes(sifSeqTypeText, 0, len(sifSeqTypeText) - 2))
    if sifElemType == "":
        return -1
    var sifElemTypeKind: int32
    var sifElemSizeBytes: int32
    var sifElemAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   sifElemType,
                                   sifElemTypeKind,
                                   sifElemSizeBytes,
                                   sifElemAlignBytes)
    if sifElemTypeKind != coreir.LocalAggregateTag || sifElemSizeBytes <= 0:
        return -1
    var sifFieldType = ""
    var sifFieldOffsetBytes: int32
    var sifFieldSizeBytes: int32
    var sifFieldAlignBytes: int32
    if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                           sourcePath,
                                           sifElemType,
                                           sifFieldName,
                                           sifFieldType,
                                           sifFieldOffsetBytes,
                                           sifFieldSizeBytes,
                                           sifFieldAlignBytes):
        return -1
    if sifFieldSizeBytes <= 0 || sifFieldOffsetBytes + sifFieldSizeBytes > sifElemSizeBytes:
        return -1
    let sifBufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   Fmt"#sif_buf#{lineNumber}#{bodyIR.ops.len}",
                                                   coreir.LocalPtrTag)
    if sifBufSlot < 0:
        return -1
    var sifBufLoadOp: coreir.BodyOp
    sifBufLoadOp.kind = coreir.BodyOpFieldLoadTag
    sifBufLoadOp.target = sifBufSlot
    add(sifBufLoadOp.operands, sifRootSlot)
    add(sifBufLoadOp.operands, sifBufSlot)
    add(sifBufLoadOp.operands, sifHeaderOffset + 8)
    add(sifBufLoadOp.operands, 8)
    let _ = coreir.BodyIRAppendOp(bodyIR, sifBufLoadOp)
    var sifIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         typedIr,
                                                         sourcePath,
                                                         sifSeqIndexText,
                                                         coreir.LocalI32Tag,
                                                         callOrdinal)
    if sifIdxSlot < 0:
        sifIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         typedIr,
                                                         sourcePath,
                                                         sifSeqIndexText,
                                                         coreir.LocalI64Tag,
                                                         callOrdinal)
    if sifIdxSlot < 0:
        return -1
    let sifEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#sif_esz#{lineNumber}#{bodyIR.ops.len}",
                                                     coreir.LocalI64Tag,
                                                     sifElemSizeBytes)
    if sifEszSlot < 0:
        return -1
    let sifAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#sif_addr#{lineNumber}#{bodyIR.ops.len}",
                                                    coreir.LocalPtrTag)
    if sifAddrSlot < 0:
        return -1
    var sifAddrOp: coreir.BodyOp
    sifAddrOp.kind = coreir.BodyOpBinOpTag
    sifAddrOp.target = sifAddrSlot
    add(sifAddrOp.operands, coreir.LocalI64Tag)
    add(sifAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
    add(sifAddrOp.operands, sifIdxSlot)
    add(sifAddrOp.operands, sifEszSlot)
    add(sifAddrOp.operands, sifBufSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, sifAddrOp)
    let sifValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                          slotNames,
                                                          typedIr,
                                                          sourcePath,
                                                          Fmt"#sif_val#{lineNumber}#{bodyIR.ops.len}",
                                                          sifFieldType)
    if sifValueSlot < 0:
        return -1
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[sifValueSlot]) < sifFieldSizeBytes:
        return -1
    var sifFieldLoadOp: coreir.BodyOp
    sifFieldLoadOp.kind = coreir.BodyOpFieldLoadTag
    sifFieldLoadOp.target = sifValueSlot
    add(sifFieldLoadOp.operands, sifAddrSlot)
    add(sifFieldLoadOp.operands, sifValueSlot)
    add(sifFieldLoadOp.operands, sifFieldOffsetBytes)
    add(sifFieldLoadOp.operands, sifFieldSizeBytes)
    let _ = coreir.BodyIRAppendOp(bodyIR, sifFieldLoadOp)
    return sifValueSlot

# General indexed-member value resolver (wcz Lane 3 / bail_44): materialize the
# value of an arbitrary chain mixing `.field` and `[idx]` segments over dynamic
# seqs, e.g. `t.rows[0].cols[1].owner`, `ctx.scopes[i].name`,
# `ir.functions[i].statements[3].kind`. The pre-existing resolvers only handled a
# single trailing `[i]` (SeqIndexValueSlot) or a single `seqBase[i].field`
# (SeqIndexFieldValueSlot); deeper / mixed chains bailed.
#
# Walk left to right keeping (currentBaseSlot, accumOffset, currentType):
#   `.field` -> accumulate the field offset against currentType (struct), keep
#               the same base.
#   `[idx]`  -> currentType must be a dynamic seq `T[]`. Load the buf ptr from
#               header (currentBase + accumOffset + 8), compute the element
#               address via Madd(idx, elemSize, buf), reset accumOffset=0 and
#               currentType=elemType (the new base is a Ptr to the element).
# Finally load the leaf value (size from currentType) from
# (currentBase + accumOffset) into a typed slot. The FieldLoad emitter already
# addresses fields off a Ptr base (through the pointer) or off a local aggregate
# base (stack + offset), so a Ptr element address and a never-indexed local
# aggregate both resolve correctly.
# Address-resolving sibling of PrimaryBodyIrIndexedMemberValueSlot. Walks the same
# mixed `.field`+`[idx]` chain over dynamic seqs but stops at the LEAF ADDRESS:
# returns (base Ptr/aggregate slot, accumulated byte offset, leaf source, leaf
# type) so callers can load the value (scalar leaf), copy the bytes (aggregate
# leaf passed by value), or use it directly as a seq-header pointer (the leaf is
# itself a `T[]` seq). This is the one shared addressing primitive: the value
# resolver, the aggregate-by-value call-arg path, and the indexed seq-add/setLen
# target all consume it, so they agree op-for-op on header indirection + Madd.
@borrows
fn PrimaryBodyIrIndexedMemberAddressSlot(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          varI32ParamNames: str[],
                                          typedIr: texpr.TypedExprIr,
                                          typedFn: texpr.TypedExprIrFunction,
                                          irFunction: lower.PrimaryObjectIrFunction,
                                          sourcePath: str,
                                          lineNumber: int32,
                                          textRaw: str,
                                          callOrdinal: var int32,
                                          imaBaseSlotOut: var int32,
                                          imaAccumOffsetOut: var int32,
                                          imaLeafSourceOut: var str,
                                          imaLeafTypeOut: var str): bool =
    imaBaseSlotOut = -1
    imaAccumOffsetOut = 0
    imaLeafSourceOut = ""
    imaLeafTypeOut = ""
    let imvText = strutil.Strip(textRaw)
    if imvText == "":
        return false
    # require at least one index segment (single trailing `[i]` and single
    # `seqBase[i].field` already have dedicated, simpler resolvers).
    var imvHasIndex = false
    for imvScan in 0..<len(imvText):
        if PrimaryBodyIrTextByteCodeEquals(imvText, imvScan, 91):
            imvHasIndex = true
            break
    if !imvHasIndex:
        return false
    # parse the leading root identifier (up to first '.' or '[').
    var imvRootEnd = len(imvText)
    var imvFindRoot = 0
    while imvFindRoot < len(imvText):
        let imvCh = imvText[imvFindRoot]
        if imvCh == '.' || imvCh == '[':
            imvRootEnd = imvFindRoot
            break
        imvFindRoot = imvFindRoot + 1
    if imvRootEnd <= 0 || imvRootEnd >= len(imvText):
        return false
    let imvRootName = strutil.Strip(strings.SliceBytes(imvText, 0, imvRootEnd))
    if imvRootName == "":
        return false
    var imvRootTypeRaw = PrimaryBodyIrBindingTypeForName(typedIr,
                                                         typedFn,
                                                         irFunction,
                                                         lineNumber,
                                                         imvRootName)
    if imvRootTypeRaw == "":
        # 模块全局根（无本地绑定证据时 BindingTypeForName 返空，避免标量全局读写被
        # 误造同名本地槽绕过 GlobalLoad）：在此 indexed-member 地址解析语境下，根类型
        # 仅用于驱动元素地址算术，下游 FindOrCreateFieldBaseSlot 对聚合全局走
        # GlobalSeqAddressSlot（adrp+add 真符号），不会造同名本地槽。回落到全局类型，
        # 使 `loweringParallelResults[i]` 这类模块全局 seq 大聚合元素按值传参的地址
        # 解析能在 root-type 步骤通过（此前恒在此 bail_44 → bodySemanticsMissing）。
        imvRootTypeRaw = PrimaryBodyIrTypedGlobalType(typedIr,
                                                      typedFn.sourcePath,
                                                      imvRootName)
    if imvRootTypeRaw == "" ||
       imvRootTypeRaw == "unknown" ||
       !PrimaryObjectMetadataTextStable(imvRootTypeRaw):
        return false
    let imvRootType = strutil.Strip(texpr.TypedExprStripVarType(imvRootTypeRaw))
    if imvRootType == "":
        return false
    var imvBaseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                             slotNames,
                                                             typedIr,
                                                             sourcePath,
                                                             imvRootName,
                                                             imvRootTypeRaw)
    if imvBaseSlot < 0 || imvBaseSlot >= bodyIR.localSlots.len:
        return false
    let imvBaseKind = PrimaryBodyIrSlotType(bodyIR, imvBaseSlot)
    if imvBaseKind != coreir.LocalAggregateTag && imvBaseKind != coreir.LocalPtrTag:
        return false
    var imvCurrentType = imvRootType
    var imvCurrentSource = strings.CloneStr(sourcePath)
    var imvAccumOffset: int32
    var imvPos = imvRootEnd
    # The cursor is a node in the parsed segment path. A repeated cursor means
    # the walk did not consume input; otherwise the finite input itself is the
    # strict termination bound, with no maximum legal chain depth.
    var imvVisitedPositions: int32[]
    while imvPos < len(imvText):
        if imvPos < 0:
            return false
        for imvVisitedIndex in 0..<imvVisitedPositions.len:
            if imvVisitedPositions[imvVisitedIndex] == imvPos:
                return false
        add(imvVisitedPositions, imvPos)
        let imvSegCh = imvText[imvPos]
        if imvSegCh == '.':
            var imvNameEnd = len(imvText)
            var imvNameScan = imvPos + 1
            while imvNameScan < len(imvText):
                let imvNameCh = imvText[imvNameScan]
                if imvNameCh == '.' || imvNameCh == '[':
                    imvNameEnd = imvNameScan
                    break
                imvNameScan = imvNameScan + 1
            let imvFieldName = strutil.Strip(strings.SliceBytes(imvText,
                                                               imvPos + 1,
                                                               imvNameEnd - imvPos - 1))
            if imvFieldName == "":
                return false
            var imvFieldType = ""
            var imvFieldOffset: int32
            var imvFieldSize: int32
            var imvFieldAlign: int32
            # Output storage must be uniquely owned. The lookup overwrites it on
            # every path, so do not seed it from the borrowed current source.
            var imvNextSource = ""
            if !PrimaryBodyIrLookupChainFieldMeta(typedIr,
                                                  imvCurrentSource,
                                                  imvCurrentType,
                                                  imvFieldName,
                                                  imvFieldType,
                                                  imvFieldOffset,
                                                  imvFieldSize,
                                                  imvFieldAlign,
                                                  imvNextSource):
                return false
            if imvFieldOffset < 0:
                return false
            imvAccumOffset = imvAccumOffset + imvFieldOffset
            imvCurrentType = strutil.Strip(texpr.TypedExprStripVarType(imvFieldType))
            imvCurrentSource = imvNextSource
            imvPos = imvNameEnd
        elif imvSegCh == '[':
            # 索引段:动态 seq `T[]`(堆 buf header 间接)或定长数组 `T[N]`(元素内联于
            # struct,含跨模块 const 维 `int32[CONST]`)。后者 IndexedElementTypeText 只验
            # count 文本非空、不解 const 数值,故跨模块 const 维定长数组字段索引(`a.limbs[i]`,
            # limbs:int32[跨模块CONST])在此可解 leaf 地址,不再落 bail_44。
            var imvIsDynSeq = false
            var imvElemType = ""
            if len(imvCurrentType) >= 3 &&
               strings.SliceBytes(imvCurrentType, len(imvCurrentType) - 2, 2) == "[]":
                imvIsDynSeq = true
                imvElemType = strutil.Strip(strings.SliceBytes(imvCurrentType,
                                                              0,
                                                              len(imvCurrentType) - 2))
            else:
                imvElemType = PrimaryBodyIrIndexedElementTypeText(imvCurrentType)
            if imvElemType == "":
                return false
            # parse the index expression inside balanced brackets.
            var imvBracketLevel = 0
            var imvClosePos = -1
            var imvBracketScan = imvPos
            while imvBracketScan < len(imvText):
                if PrimaryBodyIrTextByteCodeEquals(imvText, imvBracketScan, 91):
                    imvBracketLevel = imvBracketLevel + 1
                elif PrimaryBodyIrTextByteCodeEquals(imvText, imvBracketScan, 93):
                    imvBracketLevel = imvBracketLevel - 1
                    if imvBracketLevel == 0:
                        imvClosePos = imvBracketScan
                        break
                imvBracketScan = imvBracketScan + 1
            if imvClosePos <= imvPos + 1:
                return false
            let imvIndexText = strutil.Strip(strings.SliceBytes(imvText,
                                                              imvPos + 1,
                                                              imvClosePos - imvPos - 1))
            if imvIndexText == "":
                return false
            var imvElemKind: int32
            var imvElemSize: int32
            var imvElemAlign: int32
            PrimaryBodyIrTypeShapeFromText(typedIr,
                                           imvCurrentSource,
                                           imvElemType,
                                           imvElemKind,
                                           imvElemSize,
                                           imvElemAlign)
            if imvElemSize <= 0:
                # element type registered in the seq root's DECLARING module, not the
                # caller's sourcePath. Module-global seq element passed by value
                # (`loweringParallelResults[i]`, PrimaryObjectIrFunction[]): the global's
                # element type `PrimaryObjectIrFunction` is keyed under lowering_plan's
                # registration path, which need not PrimaryPathNormalizedEquals the
                # statement's sourcePath, so the source-path-scoped layout registry yields
                # size 0 here and the whole address walk bailed at this `[idx]` step →
                # the downstream aggregate-by-value call-arg fell to bail_44. Re-resolve the
                # element shape under the root global's true registration source (symmetric
                # to c857 root-type + FindOrCreateFieldBaseSlot:4078) and ADOPT that source
                # for the leaf + any later chain steps. Gated to globals
                # (TypedGlobalSourcePath returns "" for locals/params), so plain local
                # field/index chains keep caller-scoped resolution.
                let imvElemGlobalSource = PrimaryBodyIrTypedGlobalSourcePath(typedIr,
                                                                             imvCurrentSource,
                                                                             imvRootName)
                if imvElemGlobalSource != "" && imvElemGlobalSource != imvCurrentSource:
                    PrimaryBodyIrTypeShapeFromText(typedIr,
                                                   imvElemGlobalSource,
                                                   imvElemType,
                                                   imvElemKind,
                                                   imvElemSize,
                                                   imvElemAlign)
                    if imvElemSize > 0:
                        imvCurrentSource = imvElemGlobalSource
            if imvElemSize <= 0:
                return false
            # 索引基址:动态 seq 从 (currentBase + accumOffset + 8) load 堆 buf ptr;
            # 定长数组元素内联,基址 = 字段起始地址 (currentBase 地址 + accumOffset),
            # 经 SeqAddHeaderPtrSlot 物化成 ptr(无 buf 间接)。两者后续 idx*esz+base 同形。
            var imvBufSlot: int32 = -1
            if imvIsDynSeq:
                imvBufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"#imv_buf#{lineNumber}#{bodyIR.ops.len}",
                                                           coreir.LocalPtrTag)
                if imvBufSlot < 0:
                    return false
                var imvBufLoadOp: coreir.BodyOp
                imvBufLoadOp.kind = coreir.BodyOpFieldLoadTag
                imvBufLoadOp.target = imvBufSlot
                add(imvBufLoadOp.operands, imvBaseSlot)
                add(imvBufLoadOp.operands, imvBufSlot)
                add(imvBufLoadOp.operands, imvAccumOffset + 8)
                add(imvBufLoadOp.operands, 8)
                let _ = coreir.BodyIRAppendOp(bodyIR, imvBufLoadOp)
            else:
                imvBufSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                              slotNames,
                                                              lineNumber,
                                                              imvBaseSlot,
                                                              imvAccumOffset)
            if imvBufSlot < 0:
                return false
            var imvIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 typedIr,
                                                                 imvCurrentSource,
                                                                 imvIndexText,
                                                                 coreir.LocalI32Tag,
                                                                 callOrdinal)
            if imvIdxSlot < 0:
                imvIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 typedIr,
                                                                 imvCurrentSource,
                                                                 imvIndexText,
                                                                 coreir.LocalI64Tag,
                                                                 callOrdinal)
            if imvIdxSlot < 0:
                imvIdxSlot = PrimaryBodyIrContextSeqIndexedScalarValueSlot(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           typedIr,
                                                                           typedFn,
                                                                           irFunction,
                                                                           imvCurrentSource,
                                                                           lineNumber,
                                                                           imvIndexText,
                                                                           coreir.LocalI32Tag,
                                                                           callOrdinal)
            if imvIdxSlot < 0 &&
               texpr.TypedExprTextIsSimpleFieldPath(imvIndexText):
                # field-path index (`block.termIndex`): the bare scalar parser only
                # resolves an index slot that already exists by name; materialize
                # the field read directly so the index is owned in any statement
                # context (plain-call vs assign-with-call differ in pre-state).
                var imvIdxFieldFail0: int32
                var imvIdxFieldFail1: int32
                imvIdxSlot = PrimaryBodyIrMaterializeFieldArgSlot(bodyIR,
                                                                  slotNames,
                                                                  typedIr,
                                                                  typedFn,
                                                                  irFunction,
                                                                  imvCurrentSource,
                                                                  lineNumber,
                                                                  imvIndexText,
                                                                  imvIdxFieldFail0,
                                                                  imvIdxFieldFail1)
                if imvIdxSlot >= 0 &&
                   imvIdxSlot < bodyIR.localSlots.len &&
                   PrimaryBodyIrSlotType(bodyIR, imvIdxSlot) != coreir.LocalI32Tag &&
                   PrimaryBodyIrSlotType(bodyIR, imvIdxSlot) != coreir.LocalI64Tag:
                    imvIdxSlot = -1
            if imvIdxSlot < 0:
                return false
            let imvEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                             slotNames,
                                                             Fmt"#imv_esz#{lineNumber}#{bodyIR.ops.len}",
                                                             coreir.LocalI64Tag,
                                                             imvElemSize)
            if imvEszSlot < 0:
                return false
            let imvAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                            slotNames,
                                                            Fmt"#imv_addr#{lineNumber}#{bodyIR.ops.len}",
                                                            coreir.LocalPtrTag)
            if imvAddrSlot < 0:
                return false
            var imvAddrOp: coreir.BodyOp
            imvAddrOp.kind = coreir.BodyOpBinOpTag
            imvAddrOp.target = imvAddrSlot
            add(imvAddrOp.operands, coreir.LocalI64Tag)
            add(imvAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
            add(imvAddrOp.operands, imvIdxSlot)
            add(imvAddrOp.operands, imvEszSlot)
            add(imvAddrOp.operands, imvBufSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, imvAddrOp)
            imvBaseSlot = imvAddrSlot
            imvAccumOffset = 0
            imvCurrentType = imvElemType
            imvPos = imvClosePos + 1
        else:
            return false
    # chain fully walked: the leaf lives at (imvBaseSlot + imvAccumOffset). Hand
    # the address back; the caller decides how to consume the leaf type.
    imaBaseSlotOut = imvBaseSlot
    imaAccumOffsetOut = imvAccumOffset
    imaLeafSourceOut = imvCurrentSource
    imaLeafTypeOut = imvCurrentType
    return true

# General indexed-member VALUE resolver: materialize the scalar value of a mixed
# `.field`+`[idx]` chain. Thin wrapper over the address primitive that loads the
# leaf into a typed slot. Scalar leaves only (I32/I64/Ptr/Str); aggregate/seq
# leaves need an address/copy pass the caller performs directly.
@borrows
fn PrimaryBodyIrIndexedMemberValueSlot(bodyIR: var coreir.BodyIR,
                                        slotNames: var str[],
                                        varI32ParamNames: str[],
                                        typedIr: texpr.TypedExprIr,
                                        typedFn: texpr.TypedExprIrFunction,
                                        irFunction: lower.PrimaryObjectIrFunction,
                                        sourcePath: str,
                                        lineNumber: int32,
                                        textRaw: str,
                                        callOrdinal: var int32): int32 =
    var imvBaseSlot: int32
    var imvAccumOffset: int32
    var imvLeafSource = ""
    var imvLeafType = ""
    if !PrimaryBodyIrIndexedMemberAddressSlot(bodyIR,
                                              slotNames,
                                              share(varI32ParamNames),
                                              typedIr,
                                              share(typedFn),
                                              irFunction,
                                              strings.CloneStr(sourcePath),
                                              lineNumber,
                                              strings.CloneStr(textRaw),
                                              callOrdinal,
                                              imvBaseSlot,
                                              imvAccumOffset,
                                              imvLeafSource,
                                              imvLeafType):
        return -1
    var imvLeafKind: int32
    var imvLeafSize: int32
    var imvLeafAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   imvLeafSource,
                                   imvLeafType,
                                   imvLeafKind,
                                   imvLeafSize,
                                   imvLeafAlign)
    if imvLeafSize <= 0:
        return -1
    if imvLeafKind != coreir.LocalI32Tag &&
       imvLeafKind != coreir.LocalI64Tag &&
       imvLeafKind != coreir.LocalPtrTag &&
       imvLeafKind != coreir.LocalStrTag:
        return -1
    let imvValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                          slotNames,
                                                          typedIr,
                                                          imvLeafSource,
                                                          Fmt"#imv_val#{lineNumber}#{bodyIR.ops.len}",
                                                          imvLeafType)
    if imvValueSlot < 0 || imvValueSlot >= bodyIR.localSlots.len:
        return -1
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[imvValueSlot]) < imvLeafSize:
        return -1
    var imvLeafLoadOp: coreir.BodyOp
    imvLeafLoadOp.kind = coreir.BodyOpFieldLoadTag
    imvLeafLoadOp.target = imvValueSlot
    add(imvLeafLoadOp.operands, imvBaseSlot)
    add(imvLeafLoadOp.operands, imvValueSlot)
    add(imvLeafLoadOp.operands, imvAccumOffset)
    add(imvLeafLoadOp.operands, imvLeafSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, imvLeafLoadOp)
    return imvValueSlot

# Aggregate-leaf sibling of PrimaryBodyIrIndexedMemberValueSlot. Walks the same
# mixed `.field`+`[idx]` chain to the leaf ADDRESS, then — when the leaf is an
# aggregate struct (bail_44 / wcz Lane 3: `bodyIR.ops[opIndex]`,
# `out.terms[block.termIndex]`, `ctx.coldCsgStatementRows[i]` passed by value to
# a non-var aggregate parameter) — loads the whole struct from the element
# address into a fresh stack aggregate slot via the FieldLoad emitter (its
# byteCount block-copy arms already handle multi-word aggregates). The returned
# slot is a private stack copy, so passing it by value cannot alias the source.
@borrows
fn PrimaryBodyIrIndexedMemberAggregateValueSlot(bodyIR: var coreir.BodyIR,
                                                 slotNames: var str[],
                                                 varI32ParamNames: str[],
                                                 typedIr: texpr.TypedExprIr,
                                                 typedFn: texpr.TypedExprIrFunction,
                                                 irFunction: lower.PrimaryObjectIrFunction,
                                                 sourcePath: str,
                                                 lineNumber: int32,
                                                 textRaw: str,
                                                 callOrdinal: var int32): int32 =
    var imaBaseSlot: int32
    var imaAccumOffset: int32
    var imaLeafSource = ""
    var imaLeafType = ""
    if !PrimaryBodyIrIndexedMemberAddressSlot(bodyIR,
                                              slotNames,
                                              varI32ParamNames,
                                              typedIr,
                                              typedFn,
                                              irFunction,
                                              sourcePath,
                                              lineNumber,
                                              textRaw,
                                              callOrdinal,
                                              imaBaseSlot,
                                              imaAccumOffset,
                                              imaLeafSource,
                                              imaLeafType):
        return -1
    var imaLeafKind: int32
    var imaLeafSize: int32
    var imaLeafAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   imaLeafSource,
                                   imaLeafType,
                                   imaLeafKind,
                                   imaLeafSize,
                                   imaLeafAlign)
    if imaLeafSize <= 0 || imaLeafKind != coreir.LocalAggregateTag:
        # leaf-aggregate of a module-global seq element (`loweringParallelResults[i]`,
        # PrimaryObjectIrFunction[]): the chain walker leaves imaLeafSource = the
        # CALLING function's sourcePath, but the element type is registered in the
        # module that DECLARES the global, which here normalizes differently
        # (PrimaryPathNormalizedEquals != ) so the source-path-scoped layout registry
        # yields size 0 → bail_44. Re-resolve the leaf shape under the type's true
        # registration module: the global's registered sourcePath. Same locus / same
        # root as c857 (which only fixed the root-type address step); this covers the
        # downstream leaf whole-element by-value load. Bare-name roots only (no `.`/`[`),
        # so plain field/index leaves keep the caller-scoped resolution.
        let imaRootEnd0 = PrimaryBodyIrTextRootIdentifierEnd(textRaw)
        if imaRootEnd0 > 0:
            let imaRootName0 = strutil.Strip(strings.SliceBytes(strutil.Strip(textRaw),
                                                                0,
                                                                imaRootEnd0))
            if imaRootName0 != "":
                let imaGlobalSource = PrimaryBodyIrTypedGlobalSourcePath(typedIr,
                                                                         imaLeafSource,
                                                                         imaRootName0)
                if imaGlobalSource != "" && imaGlobalSource != imaLeafSource:
                    PrimaryBodyIrTypeShapeFromText(typedIr,
                                                   imaGlobalSource,
                                                   imaLeafType,
                                                   imaLeafKind,
                                                   imaLeafSize,
                                                   imaLeafAlign)
    if imaLeafKind != coreir.LocalAggregateTag:
        return -1
    if imaLeafSize <= 0:
        return -1
    # FieldLoad block-copy supports 1/2/4-byte and 4/8-byte-multiple struct loads.
    if !(imaLeafSize == 1 || imaLeafSize == 2 || imaLeafSize == 4 ||
         (imaLeafSize > 0 && imaLeafSize % 4 == 0)):
        return -1
    if imaLeafAlign <= 0:
        imaLeafAlign = 8
    let imaValueSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                          slotNames,
                                                          Fmt"#imvagg#{lineNumber}#{bodyIR.ops.len}",
                                                          coreir.LocalAggregateTag,
                                                          imaLeafSize,
                                                          imaLeafAlign)
    if imaValueSlot < 0 || imaValueSlot >= bodyIR.localSlots.len:
        return -1
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[imaValueSlot]) < imaLeafSize:
        return -1
    var imaLeafLoadOp: coreir.BodyOp
    imaLeafLoadOp.kind = coreir.BodyOpFieldLoadTag
    imaLeafLoadOp.target = imaValueSlot
    add(imaLeafLoadOp.operands, imaBaseSlot)
    add(imaLeafLoadOp.operands, imaValueSlot)
    add(imaLeafLoadOp.operands, imaAccumOffset)
    add(imaLeafLoadOp.operands, imaLeafSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, imaLeafLoadOp)
    return imaValueSlot

# Resolve a seq mutation target exclusively from the frozen first argument
# node. Surface text is not part of this identity.
@borrows
fn PrimaryBodyIrResolveSeqRootHeader(bodyIR: var coreir.BodyIR,
                                      slotNames: var str[],
                                      lowering: var lower.LoweringPlanStub,
                                      typedFn: texpr.TypedExprIrFunction,
                                      irFunction: lower.PrimaryObjectIrFunction,
                                      stmt: lower.PrimaryObjectIrStatement,
                                      seqRootSlotOut: var int32,
                                      seqRootIsGlobalOut: var bool,
                                      seqRootTypeKindOut: var int32,
                                      seqFieldNameOut: var str,
                                      seqHeaderOffsetOut: var int32,
                                      seqElemSizeBytesOut: var int32,
                                      seqElemTypeKindOut: var int32,
                                      seqElemTypeIdOut: var int32): bool =
    let seqNodeIndex = PrimaryBodyIrStatementCallArgNodeIndexAt(
        lowering.typedIr, stmt, stmt.rhsNodeIndex, 0)
    if seqNodeIndex < 0:
        panic("seq root: typed argument node missing")
    return PrimaryBodyIrResolveSeqRootHeaderFromNode(
        bodyIR,
        slotNames,
        lowering,

        typedFn,
        irFunction,
        stmt,
        seqNodeIndex,
        seqRootSlotOut,
        seqRootIsGlobalOut,
        seqRootTypeKindOut,
        seqFieldNameOut,
        seqHeaderOffsetOut,
        seqElemSizeBytesOut,
        seqElemTypeKindOut,
        seqElemTypeIdOut)

# Seq.add mutation targets are resolved from the typed seq node only. Field
# names, offsets and types come from FieldGet metadata; display/surface text is
# never parsed. Indexed mutation roots are rejected until TypedIR carries a
# first-class address node for that chain.
# Seq.add contracts must not fall through BindingTypeForName's source reparse
# tier. Only structured parameter, local-binding, statement and global facts are
# admissible; absence is a capability failure.
@borrows
fn PrimaryBodyIrSeqStructuredBindingType(typedIr: texpr.TypedExprIr,
                                          typedFn: texpr.TypedExprIrFunction,
                                          irFunction: lower.PrimaryObjectIrFunction,
                                          lineNumber: int32,
                                          nameRaw: str): str =
    let name = strutil.Strip(nameRaw)
    if name == "":
        return ""
    for paramIndex in 0..<irFunction.paramNames.len:
        if paramIndex < irFunction.paramTypes.len &&
           irFunction.paramNames[paramIndex] == name:
            return irFunction.paramTypes[paramIndex]
    let localType = texpr.TypedExprIrLookupLocalBindingType(typedIr,
                                                            typedFn.sourcePath,
                                                            typedFn.functionName,
                                                            lineNumber,
                                                            name)
    if localType != "":
        if localType == "range":
            return PrimaryBodyIrForBindingElementType(typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       lineNumber,
                                                       name)
        return localType
    let globalType = PrimaryBodyIrTypedGlobalTypeExact(typedIr,
                                                       typedFn.sourcePath,
                                                       name)
    var statementType = PrimaryBodyIrStructuredStatementBindingType(irFunction,
                                                                     lineNumber,
                                                                     name,
                                                                     globalType)
    if statementType == "" && irFunction.statements.len <= 0:
        statementType = PrimaryBodyIrLazyTypedStatementBindingType(typedIr,
                                                                   typedFn,
                                                                   lineNumber,
                                                                   name,
                                                                   globalType)
    if statementType != "":
        if statementType == "range":
            return PrimaryBodyIrForBindingElementType(typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       lineNumber,
                                                       name)
        return statementType
    return globalType

@borrows
fn PrimaryBodyIrResolveSeqRootHeaderFromNode(bodyIR: var coreir.BodyIR,
                                              slotNames: var str[],
                                              lowering: var lower.LoweringPlanStub,
                                              typedFn: texpr.TypedExprIrFunction,
                                              irFunction: lower.PrimaryObjectIrFunction,
                                              stmt: lower.PrimaryObjectIrStatement,
                                              seqNodeIndex: int32,
                                              seqRootSlotOut: var int32,
                                              seqRootIsGlobalOut: var bool,
                                              seqRootTypeKindOut: var int32,
                                              seqFieldNameOut: var str,
                                              seqHeaderOffsetOut: var int32,
                                              seqElemSizeBytesOut: var int32,
                                              seqElemTypeKindOut: var int32,
                                              seqElemTypeIdOut: var int32): bool =
    seqRootSlotOut = -1
    seqRootIsGlobalOut = false
    seqRootTypeKindOut = coreir.LocalInvalidTag
    seqFieldNameOut = ""
    seqHeaderOffsetOut = 0
    seqElemSizeBytesOut = 0
    seqElemTypeKindOut = coreir.LocalInvalidTag
    seqElemTypeIdOut = -1
    if !PrimaryBodyIrSeqNodeBelongsToStatement(lowering.typedIr,
                                               typedFn,
                                               irFunction,
                                               stmt,
                                               seqNodeIndex):
        return false
    if !lowering.typedIr.nodeAuthorityTypeArenaBound ||
       !layout.FixedBytes32Equal(
           lowering.typedIr.nodeAuthorityTypeArenaArtifactCid,
           lowering.typeArenaArtifactCid):
        panic("seq root: canonical TypeArena domain missing")
    let seqTypeId = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_exactTypeArenaIds,
        seqNodeIndex)
    let seqElemTypeId =
        typechain.CanonicalTypeChainSequenceElementTypeId(
            lowering, seqTypeId, false)
    let seqElemPhysicalTypeId =
        typechain.CanonicalTypeChainPhysicalTypeId(
            lowering, seqElemTypeId)
    let seqElemKind =
        typechain.CanonicalTypeChainLocalKind(
            lowering, seqElemTypeId)
    let seqElemSize =
        lowering.typeArenaSizeBytes[seqElemPhysicalTypeId]
    if seqElemKind == coreir.LocalInvalidTag ||
       seqElemSize <= 0:
        panic("seq root: canonical element layout invalid")

    var rootNodeIndex = seqNodeIndex
    var headerOffset: int32
    var fieldLeaf = ""
    while rootNodeIndex >= 0 &&
          rootNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
          lowering.typedIr.nodes2_opKinds[rootNodeIndex] == texpr.TypedExprIrOpFieldGet:
        let baseNodeIndex = arenamod.ArenaArrayInt32Get(
            lowering.typedIr.arena,
            lowering.typedIr.nodes2_operand0NodeIndexs,
            rootNodeIndex)
        if baseNodeIndex < 0 || baseNodeIndex >= rootNodeIndex:
            return false
        let fieldNameRes: Result[str] = langintern.LookupIntern(
            lowering.typedIr.internPool,
            lowering.typedIr.nodes2_literalTextIds[rootNodeIndex])
        if !IsOk(fieldNameRes):
            return false
        let fieldName = Value(fieldNameRes)
        if fieldName == "":
            return false
        var ownerTypeId: int32
        var fieldTypeId: int32
        var fieldOffset: int32
        var fieldSize: int32
        var fieldAlign: int32
        typechain.CanonicalTypeChainFieldHop(
            lowering,
            rootNodeIndex,
            ownerTypeId,
            fieldTypeId,
            fieldOffset,
            fieldSize,
            fieldAlign)
        headerOffset = headerOffset + fieldOffset
        if fieldLeaf == "":
            fieldLeaf = fieldName
        rootNodeIndex = baseNodeIndex

    if rootNodeIndex < 0 || rootNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        return false
    let rootOp = lowering.typedIr.nodes2_opKinds[rootNodeIndex]
    if rootOp != texpr.TypedExprIrOpLocalRef &&
       rootOp != texpr.TypedExprIrOpParamRef:
        return false
    let rootNameRes: Result[str] = langintern.LookupIntern(
        lowering.typedIr.internPool,
        lowering.typedIr.nodes2_paramNameIds[rootNodeIndex])
    let rootSourceRes: Result[str] = langintern.LookupIntern(
        lowering.typedIr.internPool,
        lowering.typedIr.nodes2_sourcePathIds[rootNodeIndex])
    if !IsOk(rootNameRes) || !IsOk(rootSourceRes):
        return false
    let rootName = Value(rootNameRes)
    if rootName == "":
        return false
    let rootTypeId = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_exactTypeArenaIds,
        rootNodeIndex)
    let rootPhysicalTypeId =
        typechain.CanonicalTypeChainPhysicalTypeId(
            lowering, rootTypeId)
    let rootCanonicalKind =
        typechain.CanonicalTypeChainLocalKind(
            lowering, rootTypeId)
    let rootCanonicalSize =
        lowering.typeArenaSizeBytes[rootPhysicalTypeId]
    let rootCanonicalAlign =
        lowering.typeArenaAlignBytes[rootPhysicalTypeId]

    var rootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rootName)
    var rootIsGlobal = false
    if rootSlot < 0:
        if fieldLeaf != "":
            return false
        let globalRow = PrimaryBodyIrExactGlobalRow(
            lowering.typedIr, Value(rootSourceRes), rootName)
        if globalRow < 0 ||
           globalRow >= lowering.globalTypeArenaTypeIds.len ||
           lowering.globalTypeArenaTypeIds[globalRow] != rootTypeId:
            panic("seq root: global TypeId drift")
        let globalSlotName = PrimaryBodyIrTypedGlobalSlotName(lowering.typedIr,
                                                              Value(rootSourceRes),
                                                              rootName)
        if globalSlotName == "" ||
           rootCanonicalKind != coreir.LocalAggregateTag ||
           rootCanonicalSize <= 0:
            panic("seq root: global canonical layout invalid")
        rootSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                      slotNames,
                                                      globalSlotName,
                                                      rootCanonicalKind,
                                                      rootCanonicalSize,
                                                      rootCanonicalAlign)
        if rootSlot < 0:
            return false
        PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, rootSlot)
        bodyIR.localSlots[rootSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
        rootIsGlobal = true
    if rootSlot < 0 || rootSlot >= bodyIR.localSlots.len:
        return false
    let rootKind = PrimaryBodyIrSlotType(bodyIR, rootSlot)
    if (rootKind != coreir.LocalAggregateTag &&
        rootKind != coreir.LocalPtrTag) ||
       (rootKind != rootCanonicalKind &&
        !(rootKind == coreir.LocalPtrTag &&
          rootCanonicalKind == coreir.LocalAggregateTag)):
        panic("seq root: slot canonical kind drift")
    let rootManagedKind =
        lowering.typedIr.nodes2_resultTypeManagedFlags[rootNodeIndex] ?
            coreir.BodyManagedStorageManagedTag :
            coreir.BodyManagedStorageUnmanagedTag
    if !coreir.BodyIRBindTypeArenaArtifactCid(
           bodyIR, lowering.typeArenaArtifactCid) ||
       !coreir.BodyIRBindLocalSlotTypeArenaProof(
           bodyIR,
           rootSlot,
           lowering.typeArenaArtifactCid,
           rootTypeId,
           rootManagedKind):
        panic("seq root: slot TypeId bind failed")

    seqRootSlotOut = rootSlot
    seqRootIsGlobalOut = rootIsGlobal
    seqRootTypeKindOut = rootKind
    seqFieldNameOut = fieldLeaf
    seqHeaderOffsetOut = headerOffset
    seqElemSizeBytesOut = seqElemSize
    seqElemTypeKindOut = seqElemKind
    seqElemTypeIdOut = seqElemTypeId
    return true


# True when the value text has a top-level comparison/logical operator that
# produces a bool 0/1 (the relational forms PrimaryBodyIrCondValue01Slot lowers).
# Used by the seq-add scalar branch so `add(flags, a.len > 0)` materializes the
# comparison instead of failing the bare scalar parser.
@borrows
fn PrimaryBodyIrTextIsBoolCompareExpr(textRaw: str): bool =
    let text = strutil.Strip(textRaw)
    if text == "":
        return false
    if texpr.TypedExprFindTopLevelTextToken(text, "&&") > 0:
        return true
    if texpr.TypedExprFindTopLevelTextToken(text, "==") > 0:
        return true
    if texpr.TypedExprFindTopLevelTextToken(text, "!=") > 0:
        return true
    if texpr.TypedExprFindTopLevelTextToken(text, ">=") > 0:
        return true
    if texpr.TypedExprFindTopLevelTextToken(text, strutil.Join(["<", "="], "")) > 0:
        return true
    if texpr.TypedExprFindTopLevelTextToken(text, ">") > 0:
        return true
    if texpr.TypedExprFindTopLevelTextToken(text, "<") > 0:
        return true
    return false

# General add(seq, value) lowering: works for plain seq locals/params and
# single-level field-path seqs (root.field). The seq header pointer is
# materialized uniformly via BinOp add (aggregate slot loads yield the slot
# address for locals and the stored address for params), then
# cheng_seq_set_grow(header, len, elemSize) grows and returns the element
# address, and the element bytes are stored through that pointer.
#
@borrows
fn PrimaryBodyIrSeqNodeBelongsToStatement(typedIr: texpr.TypedExprIr,
                                           typedFn: texpr.TypedExprIrFunction,
                                           irFunction: lower.PrimaryObjectIrFunction,
                                           stmt: lower.PrimaryObjectIrStatement,
                                           nodeIndex: int32): bool =
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       nodeIndex >= typedIr.nodes2_opKinds.len ||
       nodeIndex >= typedIr.nodes2_lineNumbers.len ||
       nodeIndex >= typedIr.nodes2_sourcePathIds.len ||
       nodeIndex >= typedIr.nodes2_functionNameIds.len ||
       nodeIndex >= typedIr.nodes2_resultTypeIds.len ||
       nodeIndex >= typedIr.nodes2_paramNameIds.len ||
       nodeIndex >= typedIr.nodes2_literalTextIds.len:
        return false
    if typedFn.nodeStart < 0 || typedFn.nodeCount <= 0 ||
       typedFn.nodeCount > typedIr.nodes2_nodeIndexs.len ||
       typedFn.nodeStart >
           typedIr.nodes2_nodeIndexs.len - typedFn.nodeCount ||
       nodeIndex < typedFn.nodeStart ||
       nodeIndex >= typedFn.nodeStart + typedFn.nodeCount:
        return false
    let opKind = typedIr.nodes2_opKinds[nodeIndex]
    let expectedLine = opKind == texpr.TypedExprIrOpParamRef ?
                       typedFn.signatureLineNumber : stmt.lineNumber
    if arenamod.ArenaArrayInt32Get(typedIr.arena,
                                    typedIr.nodes2_nodeIndexs,
                                    nodeIndex) != nodeIndex ||
       arenamod.ArenaArrayInt32Get(typedIr.arena,
                                    typedIr.nodes2_lineNumbers,
                                    nodeIndex) != expectedLine:
        return false
    let sourceRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                         typedIr.nodes2_sourcePathIds[nodeIndex])
    let functionRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                           typedIr.nodes2_functionNameIds[nodeIndex])
    let resultTypeRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                             typedIr.nodes2_resultTypeIds[nodeIndex])
    if !IsOk(sourceRes) || !IsOk(functionRes) || !IsOk(resultTypeRes):
        return false
    let nodeSource: str = Value(sourceRes)
    let nodeFunction: str = Value(functionRes)
    let nodeResultType: str = Value(resultTypeRes)
    if parser.ParserNormalizePath(nodeSource) != parser.ParserNormalizePath(stmt.sourcePath) ||
       nodeFunction != stmt.functionName || nodeFunction != typedFn.functionName ||
       nodeResultType == "":
        return false
    if opKind == texpr.TypedExprIrOpLocalRef ||
       opKind == texpr.TypedExprIrOpParamRef:
        let paramNameRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                                typedIr.nodes2_paramNameIds[nodeIndex])
        if !IsOk(paramNameRes):
            return false
        let paramName: str = Value(paramNameRes)
        if paramName == "":
            return false
        let bindingType = PrimaryBodyIrSeqStructuredBindingType(typedIr,
                                                                 typedFn,
                                                                 irFunction,
                                                                 stmt.lineNumber,
                                                                 paramName)
        if bindingType == "" ||
           texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(bindingType)) !=
               texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(nodeResultType)):
            return false
    return true

@borrows
fn PrimaryBodyIrSeqNodeIdentityMatches(typedIr: texpr.TypedExprIr,
                                        typedFn: texpr.TypedExprIrFunction,
                                        irFunction: lower.PrimaryObjectIrFunction,
                                        stmt: lower.PrimaryObjectIrStatement,
                                        leftRoot: int32,
                                        rightRoot: int32): bool =
    var leftWork: int32[]
    var rightWork: int32[]
    var seenLeft: int32[]
    var seenRight: int32[]
    add(leftWork, leftRoot)
    add(rightWork, rightRoot)
    var cursor: int32
    while cursor < leftWork.len:
        if cursor >= rightWork.len:
            return false
        let leftNode = leftWork[cursor]
        let rightNode = rightWork[cursor]
        cursor = cursor + 1
        if leftNode < 0 || rightNode < 0:
            if leftNode != rightNode:
                return false
            continue
        var alreadySeen = false
        for seenIndex in 0..<seenLeft.len:
            if seenLeft[seenIndex] == leftNode && seenRight[seenIndex] == rightNode:
                alreadySeen = true
                break
        if alreadySeen:
            continue
        add(seenLeft, leftNode)
        add(seenRight, rightNode)
        if !PrimaryBodyIrSeqNodeBelongsToStatement(typedIr,
                                                    typedFn,
                                                    irFunction,
                                                    stmt,
                                                    leftNode) ||
           !PrimaryBodyIrSeqNodeBelongsToStatement(typedIr,
                                                    typedFn,
                                                    irFunction,
                                                    stmt,
                                                    rightNode):
            return false
        if typedIr.nodes2_opKinds[leftNode] != typedIr.nodes2_opKinds[rightNode] ||
           typedIr.nodes2_sourcePathIds[leftNode] != typedIr.nodes2_sourcePathIds[rightNode] ||
           typedIr.nodes2_functionNameIds[leftNode] != typedIr.nodes2_functionNameIds[rightNode] ||
           typedIr.nodes2_resultTypeIds[leftNode] != typedIr.nodes2_resultTypeIds[rightNode] ||
           typedIr.nodes2_paramNameIds[leftNode] != typedIr.nodes2_paramNameIds[rightNode] ||
           typedIr.nodes2_literalTextIds[leftNode] != typedIr.nodes2_literalTextIds[rightNode] ||
           typedIr.nodes2_fieldTypeSourcePathIds[leftNode] != typedIr.nodes2_fieldTypeSourcePathIds[rightNode] ||
           arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldOffsetBytes, leftNode) !=
               arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldOffsetBytes, rightNode) ||
           arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldSizeBytes, leftNode) !=
               arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldSizeBytes, rightNode) ||
           arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldAlignBytes, leftNode) !=
               arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldAlignBytes, rightNode) ||
           arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_elemSizeBytes, leftNode) !=
               arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_elemSizeBytes, rightNode):
            return false
        let left0 = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, leftNode)
        let left1 = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, leftNode)
        let left2 = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand2NodeIndexs, leftNode)
        let right0 = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, rightNode)
        let right1 = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, rightNode)
        let right2 = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand2NodeIndexs, rightNode)
        if (left0 >= 0 && left0 >= leftNode) || (left1 >= 0 && left1 >= leftNode) ||
           (left2 >= 0 && left2 >= leftNode) || (right0 >= 0 && right0 >= rightNode) ||
           (right1 >= 0 && right1 >= rightNode) || (right2 >= 0 && right2 >= rightNode):
            return false
        add(leftWork, left0)
        add(rightWork, right0)
        add(leftWork, left1)
        add(rightWork, right1)
        add(leftWork, left2)
        add(rightWork, right2)
    return cursor == rightWork.len

# add/seqs.Add 的权威语义源是 stmt.rhsNodeIndex 指向的 CallExpr 及其 ArgLink 链。
# statement 自带的 ArgLink 链只作为结构镜像参与逐节点身份校验。展示 surface 与
# callArgsText 不参与接受、拒绝或发射。任一结构、来源、类型或绑定身份漂移都返回
# detail1=1；真实 enum 元素类型错配由后续合同返回 detail1=2。
@borrows
fn PrimaryBodyIrSeqAddArgsFromStatement(typedIr: texpr.TypedExprIr,
                                         typedFn: texpr.TypedExprIrFunction,
                                         irFunction: lower.PrimaryObjectIrFunction,
                                         stmt: lower.PrimaryObjectIrStatement,
                                         seqNodeIndexOut: var int32,
                                         valueNodeIndexOut: var int32,
                                         detail1Out: var int32): bool =
    seqNodeIndexOut = -1
    valueNodeIndexOut = -1
    detail1Out = 1
    if stmt.callArgCount != 2 ||
       stmt.callArgNodeCount != 2 ||
       stmt.callArgNodeStart < 0 ||
       stmt.rhsNodeIndex < 0 ||
       stmt.rhsNodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[stmt.rhsNodeIndex] != texpr.TypedExprIrOpCallExpr ||
       !PrimaryBodyIrSeqNodeBelongsToStatement(typedIr,
                                               typedFn,
                                               irFunction,
                                               stmt,
                                               stmt.rhsNodeIndex):
        return false
    let callHeadRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                           typedIr.nodes2_literalTextIds[stmt.rhsNodeIndex])
    let callResultRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                             typedIr.nodes2_resultTypeIds[stmt.rhsNodeIndex])
    if !IsOk(callHeadRes) || !IsOk(callResultRes):
        return false
    let callHead: str = Value(callHeadRes)
    let callLeaf = texpr.TypedExprQualifiedCallLeaf(callHead)
    let typedAddBuiltin = stmt.callKind == texpr.TypedExprCallBuiltin &&
                          callLeaf == "add"
    let typedSeqsAdd = callLeaf == "Add" &&
                       strings.HasSuffix(stmt.callTargetSourcePath, "std/seqs.cheng")
    if callHead == "" || (!typedAddBuiltin && !typedSeqsAdd) ||
       (callLeaf != "add" && callLeaf != "Add") ||
       callLeaf != stmt.callCallee ||
       texpr.TypedExprNormalizeTypeText(Value(callResultRes)) !=
           texpr.TypedExprNormalizeTypeText(stmt.resultType) ||
       arenamod.ArenaArrayInt32Get(typedIr.arena,
                                    typedIr.nodes2_operand1NodeIndexs,
                                    stmt.rhsNodeIndex) >= 0 ||
       arenamod.ArenaArrayInt32Get(typedIr.arena,
                                    typedIr.nodes2_operand2NodeIndexs,
                                    stmt.rhsNodeIndex) >= 0:
        return false
    var argLink = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                              typedIr.nodes2_operand0NodeIndexs,
                                              stmt.rhsNodeIndex)
    var stmtArgLink = stmt.callArgNodeStart
    var argIndex: int32
    var seqNodeIndex: int32 = -1
    var valueNodeIndex: int32 = -1
    while argIndex < 2:
        if argLink < 0 || stmtArgLink < 0 ||
           argLink >= typedIr.nodes2_nodeIndexs.len ||
           stmtArgLink >= typedIr.nodes2_nodeIndexs.len ||
           typedIr.nodes2_opKinds[argLink] != texpr.TypedExprIrOpArgLink ||
           typedIr.nodes2_opKinds[stmtArgLink] != texpr.TypedExprIrOpArgLink ||
           !PrimaryBodyIrSeqNodeBelongsToStatement(typedIr, typedFn, irFunction, stmt, argLink) ||
           !PrimaryBodyIrSeqNodeBelongsToStatement(typedIr, typedFn, irFunction, stmt, stmtArgLink):
            return false
        let argNodeIndex = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                       typedIr.nodes2_operand0NodeIndexs,
                                                       argLink)
        let stmtArgNodeIndex = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                           typedIr.nodes2_operand0NodeIndexs,
                                                           stmtArgLink)
        if argNodeIndex < 0 || stmtArgNodeIndex < 0 ||
           !PrimaryBodyIrSeqNodeIdentityMatches(typedIr,
                                                typedFn,
                                                irFunction,
                                                stmt,
                                                argNodeIndex,
                                                stmtArgNodeIndex):
            return false
        let linkResultRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool,
            typedIr.nodes2_resultTypeIds[argLink])
        let nodeResultRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool,
            typedIr.nodes2_resultTypeIds[argNodeIndex])
        if !IsOk(linkResultRes) || !IsOk(nodeResultRes) ||
           Value(linkResultRes) == "" ||
           texpr.TypedExprNormalizeTypeText(Value(linkResultRes)) !=
               texpr.TypedExprNormalizeTypeText(Value(nodeResultRes)):
            return false
        if argIndex == 0:
            seqNodeIndex = argNodeIndex
        else:
            valueNodeIndex = argNodeIndex
        argIndex = argIndex + 1
        argLink = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                              typedIr.nodes2_operand1NodeIndexs,
                                              argLink)
        stmtArgLink = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                  typedIr.nodes2_operand1NodeIndexs,
                                                  stmtArgLink)
    if argLink >= 0 || stmtArgLink >= 0 || seqNodeIndex < 0 || valueNodeIndex < 0:
        return false
    seqNodeIndexOut = seqNodeIndex
    valueNodeIndexOut = valueNodeIndex
    return true

# Shared by the real Seq.add dispatcher and the contract smoke. This counter is
# local to one function build; the caller transports it through the per-function
# receipt and deterministic reduce, never through module mutable state.
@borrows
fn PrimaryBodyIrConsumeSeqAddContract(typedIr: texpr.TypedExprIr,
                                       typedFn: texpr.TypedExprIrFunction,
                                       irFunction: lower.PrimaryObjectIrFunction,
                                       stmt: lower.PrimaryObjectIrStatement,
                                       typedContractCount: var int32,
                                       seqNodeIndexOut: var int32,
                                       valueNodeIndexOut: var int32,
                                       detail1Out: var int32): bool =
    if !PrimaryBodyIrSeqAddArgsFromStatement(typedIr,
                                              typedFn,
                                              irFunction,
                                              stmt,
                                              seqNodeIndexOut,
                                              valueNodeIndexOut,
                                              detail1Out):
        return false
    typedContractCount = typedContractCount + 1
    return true

@borrows
fn PrimaryBodyIrResultProjectionContract(typedIr: texpr.TypedExprIr,
                                          typedFn: texpr.TypedExprIrFunction,
                                          irFunction: lower.PrimaryObjectIrFunction,
                                          stmt: lower.PrimaryObjectIrStatement,
                                          sourceNodeIndexOut: var int32,
                                          sourceBindingOut: var str,
                                          sourceResultTypeOut: var str,
                                          sourceInnerTypeOut: var str): bool =
    sourceNodeIndexOut = -1
    sourceBindingOut = ""
    sourceResultTypeOut = ""
    sourceInnerTypeOut = ""
    let intrinsicName = stmt.callCallee
    if intrinsicName != "Value" && intrinsicName != "Error" &&
       intrinsicName != "ErrorInfoOf" && intrinsicName != "IsOk" &&
       intrinsicName != "IsErr":
        return false
    var expectedDetail = parser.NormalizedExprDetailNone
    if intrinsicName == "Value":
        expectedDetail = parser.NormalizedExprDetailResultValue
    elif intrinsicName == "Error":
        expectedDetail = parser.NormalizedExprDetailResultError
    elif intrinsicName == "ErrorInfoOf":
        expectedDetail = parser.NormalizedExprDetailResultErrorInfoOf
    elif intrinsicName == "IsOk":
        expectedDetail = parser.NormalizedExprDetailResultIsOk
    else:
        expectedDetail = parser.NormalizedExprDetailResultIsErr
    if stmt.kind != texpr.TypedExprIrStmtResultIntrinsic ||
       stmt.callKind != texpr.TypedExprCallResultIntrinsic ||
       stmt.detailKind != expectedDetail ||
       parser.ParserResultIntrinsicDetailKind(intrinsicName) != expectedDetail ||
       stmt.callArgCount != 1 ||
       stmt.callArgNodeCount != 1 ||
       stmt.callArgNodeStart < 0 ||
       !PrimaryBodyIrSeqNodeBelongsToStatement(typedIr,
                                               typedFn,
                                               irFunction,
                                               stmt,
                                               stmt.callArgNodeStart) ||
       typedIr.nodes2_opKinds[stmt.callArgNodeStart] != texpr.TypedExprIrOpArgLink ||
       arenamod.ArenaArrayInt32Get(typedIr.arena,
                                    typedIr.nodes2_operand1NodeIndexs,
                                    stmt.callArgNodeStart) >= 0 ||
       arenamod.ArenaArrayInt32Get(typedIr.arena,
                                    typedIr.nodes2_operand2NodeIndexs,
                                    stmt.callArgNodeStart) >= 0:
        return false
    let stmtSourceNode = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.nodes2_operand0NodeIndexs,
        stmt.callArgNodeStart)
    if stmtSourceNode < 0 ||
       !PrimaryBodyIrSeqNodeBelongsToStatement(typedIr,
                                               typedFn,
                                               irFunction,
                                               stmt,
                                               stmtSourceNode):
        return false
    let sourceOp = typedIr.nodes2_opKinds[stmtSourceNode]
    if sourceOp != texpr.TypedExprIrOpLocalRef &&
       sourceOp != texpr.TypedExprIrOpParamRef:
        return false
    let sourceBindingRes: Result[str] = langintern.LookupIntern(
        typedIr.internPool,
        typedIr.nodes2_paramNameIds[stmtSourceNode])
    let sourceTypeRes: Result[str] = langintern.LookupIntern(
        typedIr.internPool,
        typedIr.nodes2_resultTypeIds[stmtSourceNode])
    let linkTypeRes: Result[str] = langintern.LookupIntern(
        typedIr.internPool,
        typedIr.nodes2_resultTypeIds[stmt.callArgNodeStart])
    if !IsOk(sourceBindingRes) || !IsOk(sourceTypeRes) || !IsOk(linkTypeRes):
        return false
    let sourceBinding: str = Value(sourceBindingRes)
    let sourceResultType: str = Value(sourceTypeRes)
    let sourceInnerType = texpr.TypedExprResultSuccessType(
        texpr.TypedExprStripVarType(sourceResultType))
    if sourceBinding == "" ||
       texpr.TypedExprNormalizeTypeText(sourceResultType) !=
           texpr.TypedExprNormalizeTypeText(Value(linkTypeRes)) ||
       sourceInnerType == "":
        return false
    let bindingType = PrimaryBodyIrSeqStructuredBindingType(typedIr,
                                                             typedFn,
                                                             irFunction,
                                                             stmt.lineNumber,
                                                             sourceBinding)
    if bindingType == "" ||
       texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(bindingType)) !=
           texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(sourceResultType)):
        return false
    var expectedResultType = ""
    if intrinsicName == "Value":
        # Do not take sourceInnerType; it is written to sourceInnerTypeOut below.
        expectedResultType = strings.CloneStr(sourceInnerType)
    elif intrinsicName == "Error":
        expectedResultType = "str"
    elif intrinsicName == "ErrorInfoOf":
        expectedResultType = "ErrorInfo"
    else:
        expectedResultType = "bool"
    if texpr.TypedExprNormalizeTypeText(stmt.resultType) !=
       texpr.TypedExprNormalizeTypeText(expectedResultType):
        return false
    sourceNodeIndexOut = stmtSourceNode
    sourceBindingOut = sourceBinding
    sourceResultTypeOut = sourceResultType
    sourceInnerTypeOut = sourceInnerType
    return true

@borrows
fn PrimaryBodyIrResultConstructorContract(typedIr: texpr.TypedExprIr,
                                           typedFn: texpr.TypedExprIrFunction,
                                           irFunction: lower.PrimaryObjectIrFunction,
                                           stmt: lower.PrimaryObjectIrStatement): bool =
    var expectedDetail = parser.NormalizedExprDetailNone
    if stmt.callCallee == "Ok":
        expectedDetail = parser.NormalizedExprDetailResultOk
    elif stmt.callCallee == "Err":
        expectedDetail = parser.NormalizedExprDetailResultErr
    else:
        return false
    if stmt.kind != texpr.TypedExprIrStmtResultIntrinsic ||
       stmt.callKind != texpr.TypedExprCallResultIntrinsic ||
       stmt.detailKind != expectedDetail ||
       parser.ParserResultIntrinsicDetailKind(stmt.callCallee) != expectedDetail ||
       stmt.callArgCount != 1 || stmt.callArgNodeCount != 1 ||
       stmt.callArgNodeStart < 0 ||
       !PrimaryBodyIrSeqNodeBelongsToStatement(typedIr,
                                               typedFn,
                                               irFunction,
                                               stmt,
                                               stmt.callArgNodeStart) ||
       typedIr.nodes2_opKinds[stmt.callArgNodeStart] != texpr.TypedExprIrOpArgLink:
        return false
    let valueNode = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                 typedIr.nodes2_operand0NodeIndexs,
                                                 stmt.callArgNodeStart)
    let nextLink = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                typedIr.nodes2_operand1NodeIndexs,
                                                stmt.callArgNodeStart)
    let extraOperand = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                    typedIr.nodes2_operand2NodeIndexs,
                                                    stmt.callArgNodeStart)
    return valueNode >= 0 && nextLink < 0 && extraOperand < 0 &&
           PrimaryBodyIrSeqNodeBelongsToStatement(typedIr,
                                                   typedFn,
                                                   irFunction,
                                                   stmt,
                                                   valueNode)

# Contract acceptance and actual consumption are deliberately separate. A
# projection can pass the typed contract and still fail slot/layout/guard
# lowering; such a failure must never appear in the execution receipt.
@borrows
fn PrimaryBodyIrAcceptResultIntrinsicContract(typedIr: texpr.TypedExprIr,
                                               typedFn: texpr.TypedExprIrFunction,
                                               irFunction: lower.PrimaryObjectIrFunction,
                                               stmt: lower.PrimaryObjectIrStatement,
                                               sourceNodeIndexOut: var int32,
                                               sourceBindingOut: var str,
                                               sourceResultTypeOut: var str,
                                               sourceInnerTypeOut: var str): bool =
    return PrimaryBodyIrResultProjectionContract(typedIr,
                                                  typedFn,
                                                  irFunction,
                                                  stmt,
                                                  sourceNodeIndexOut,
                                                  sourceBindingOut,
                                                  sourceResultTypeOut,
                                                  sourceInnerTypeOut)

@borrows
fn PrimaryBodyIrDispatchResultIntrinsicConsumer(
    typedIr: texpr.TypedExprIr,
    typedFn: texpr.TypedExprIrFunction,
    irFunction: lower.PrimaryObjectIrFunction,
    stmt: lower.PrimaryObjectIrStatement,
    sourceNodeIndexOut: var int32,
    sourceBindingOut: var str,
    sourceResultTypeOut: var str,
    sourceInnerTypeOut: var str,
    projectKindOut: var int32
): bool =
    projectKindOut = coreir.BodyResultProjectInvalidTag
    if !PrimaryBodyIrAcceptResultIntrinsicContract(typedIr,
                                                   typedFn,
                                                   irFunction,
                                                   stmt,
                                                   sourceNodeIndexOut,
                                                   sourceBindingOut,
                                                   sourceResultTypeOut,
                                                   sourceInnerTypeOut):
        return false
    if stmt.callCallee == "Value":
        projectKindOut = coreir.BodyResultProjectValueStrTag
    elif stmt.callCallee == "Error":
        projectKindOut = coreir.BodyResultProjectErrorStrTag
    elif stmt.callCallee == "ErrorInfoOf":
        projectKindOut = coreir.BodyResultProjectErrInfoTag
    elif stmt.callCallee == "IsOk":
        projectKindOut = coreir.BodyResultProjectIsOkTag
    elif stmt.callCallee == "IsErr":
        projectKindOut = coreir.BodyResultProjectIsErrTag
    return projectKindOut != coreir.BodyResultProjectInvalidTag

@borrows
fn PrimaryBodyIrDispatchResultIntrinsicStatementOp(
    bodyIR: var coreir.BodyIR,
    slotNames: var str[],
    typedIr: texpr.TypedExprIr,
    typedFn: texpr.TypedExprIrFunction,
    irFunction: lower.PrimaryObjectIrFunction,
    stmt: lower.PrimaryObjectIrStatement,
    targetSlot: int32,
    projectOffset: int32,
    projectByteCount: int32,
    structuredConsumeCount: var int32
): bool =
    var sourceNodeIndex: int32
    var sourceBinding = ""
    var sourceResultType = ""
    var sourceInnerType = ""
    var projectKind = coreir.BodyResultProjectInvalidTag
    if !PrimaryBodyIrDispatchResultIntrinsicConsumer(typedIr,
                                                      typedFn,
                                                      irFunction,
                                                      stmt,
                                                      sourceNodeIndex,
                                                      sourceBinding,
                                                      sourceResultType,
                                                      sourceInnerType,
                                                      projectKind):
        PrimaryBodyIrAppendInvalidOp(bodyIR, stmt.lineNumber, int32(stmt.kind), 61, 0)
        PrimaryBodyIrNodeEvalOnlyOwn()
        return false
    let sourceSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, sourceBinding)
    if sourceSlot < 0 || targetSlot < 0 || targetSlot >= bodyIR.localSlots.len ||
       ((projectKind != coreir.BodyResultProjectIsErrTag &&
         projectKind != coreir.BodyResultProjectIsOkTag) && projectByteCount <= 0):
        PrimaryBodyIrAppendInvalidOp(bodyIR, stmt.lineNumber, int32(stmt.kind), 61, projectKind)
        PrimaryBodyIrNodeEvalOnlyOwn()
        return false
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpResultProjectTag
    op.target = targetSlot
    add(op.operands, projectKind)
    add(op.operands, sourceSlot)
    if projectKind != coreir.BodyResultProjectIsErrTag &&
       projectKind != coreir.BodyResultProjectIsOkTag:
        add(op.operands, projectOffset)
        add(op.operands, projectByteCount)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    PrimaryBodyIrCommitResultIntrinsicActualConsume(structuredConsumeCount)
    PrimaryBodyIrNodeEvalOnlyOwn()
    return true

@borrows
fn PrimaryBodyIrCommitResultIntrinsicActualConsume(
    structuredConsumeCount: var int32
) =
    structuredConsumeCount = structuredConsumeCount + 1

@borrows
fn PrimaryBodyIrCommitCompletedReturnResultIntrinsic(
    completedReturnLineNumber: int32,
    statementLineNumber: int32,
    bindingName: str,
    projectKind: int32,
    structuredConsumeCount: var int32
): bool =
    if completedReturnLineNumber != statementLineNumber || bindingName != "":
        return false
    if projectKind != coreir.BodyResultProjectIsOkTag &&
       projectKind != coreir.BodyResultProjectIsErrTag:
        return false
    PrimaryBodyIrCommitResultIntrinsicActualConsume(structuredConsumeCount)
    return true

# 通用调用实参节点索引查找：给定 let-call 语句的 OpCallExpr 节点(callNodeIndex)
# 与实参序号(argPosition,0-based),沿 ArgLink 链取该位实参的值节点。
# 供 Fmt/聚合等需走 node-eval 的 call-arg 物化复用(SeqAddValueArgNodeIndex 的泛化版)。
# callNodeIndex 非 OpCallExpr、越界、链结构异常或序号超出实参数 → 返回 -1(调用方落 bail)。
@borrows
fn PrimaryBodyIrCallArgNodeIndexAt(typedIr: texpr.TypedExprIr,
                                    callNodeIndex: int32,
                                    argPosition: int32): int32 =
    if callNodeIndex < 0 || callNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return -1
    if typedIr.nodes2_opKinds[callNodeIndex] != texpr.TypedExprIrOpCallExpr:
        return -1
    if argPosition < 0:
        return -1
    var argNodes: int32[]
    if !PrimaryBodyIrCollectArgLinkValueNodes(
        typedIr,
        arenamod.ArenaArrayInt32Get(typedIr.arena,
                                     typedIr.nodes2_operand0NodeIndexs,
                                     callNodeIndex),
        argNodes) ||
       argPosition >= argNodes.len:
        return -1
    return argNodes[argPosition]

# 结构性预检（第九代终解 findings 2e3cd25f）：纯只读结构走 rootNodeIndex 表达式子树，
# 收集其中全部 FieldGet 节点的字段 meta。任一 FieldGet 的 fieldOffset<0 或 fieldSize<=0
# 表示该链在 node-eval 里不可解——node-eval 会先发射外层 call/index，再于此 miss，亲手
# 制造 partial-emission poison（CALL 已发射不可撤销 bail=6101）。整树任一链不可解 → 返
# false：调用方对该字段传 fieldNodeIndex=-1 走文本臂（零求值零发射 = 今日行为）。反之整树
# 每条 FieldGet 链 meta 合法（== FieldGet 原子化的 emit 前置条件 30e82f52）→ 返 true，
# node-eval 必不因字段 meta miss。三色迭代 DFS 精确区分合法 DAG 共享与非法环，
# 不使用任何与程序规模无关的步数上限。
@borrows
fn PrimaryBodyIrCtorFieldNodeTreeResolvable(typedIr: texpr.TypedExprIr,
                                            rootNodeIndex: int32): bool =
    if rootNodeIndex < 0:
        return true
    let ctfNodeCount = typedIr.nodes2_nodeIndexs.len
    if rootNodeIndex >= ctfNodeCount ||
       typedIr.nodes2_operand0NodeIndexs.len < ctfNodeCount ||
       typedIr.nodes2_operand1NodeIndexs.len < ctfNodeCount ||
       typedIr.nodes2_operand2NodeIndexs.len < ctfNodeCount:
        return false
    var ctfNodes: int32[]
    var ctfNextEdges: int32[]
    add(ctfNodes, rootNodeIndex)
    add(ctfNextEdges, 0)
    var ctfStates = hashmaps.HashMapPtrIntInit(8)
    while ctfNodes.len > 0:
        let ctfTop = ctfNodes.len - 1
        let ctfNode = ctfNodes[ctfTop]
        var ctfStateFound = false
        let ctfState = hashmaps.HashMapPtrIntGetEx(
            ctfStates,
            int64(ctfNode) + int64(1),
            ctfStateFound)
        if ctfNextEdges[ctfTop] == 0:
            if ctfStateFound:
                if ctfState == 1:
                    return false
                setLen(ctfNodes, ctfTop)
                setLen(ctfNextEdges, ctfTop)
                continue
            hashmaps.HashMapPtrIntPut(ctfStates,
                                      int64(ctfNode) + int64(1),
                                      1)
            if typedIr.nodes2_opKinds[ctfNode] == texpr.TypedExprIrOpFieldGet:
                if typedIr.nodes2_fieldTypeSourcePathIds.len <= ctfNode ||
                   typedIr.nodes2_fieldOffsetBytes.len <= ctfNode ||
                   typedIr.nodes2_fieldSizeBytes.len <= ctfNode ||
                   typedIr.nodes2_fieldAlignBytes.len <= ctfNode ||
                   arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                typedIr.nodes2_fieldOffsetBytes,
                                                ctfNode) < 0 ||
                   arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                typedIr.nodes2_fieldSizeBytes,
                                                ctfNode) <= 0 ||
                   arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                typedIr.nodes2_fieldAlignBytes,
                                                ctfNode) <= 0:
                    return false
        if ctfNextEdges[ctfTop] < 3:
            let ctfEdge = ctfNextEdges[ctfTop]
            ctfNextEdges[ctfTop] = ctfEdge + 1
            var ctfChild: int32
            if ctfEdge == 0:
                ctfChild = arenamod.ArenaArrayInt32Get(
                    typedIr.arena,
                    typedIr.nodes2_operand0NodeIndexs,
                    ctfNode)
            elif ctfEdge == 1:
                ctfChild = arenamod.ArenaArrayInt32Get(
                    typedIr.arena,
                    typedIr.nodes2_operand1NodeIndexs,
                    ctfNode)
            else:
                ctfChild = arenamod.ArenaArrayInt32Get(
                    typedIr.arena,
                    typedIr.nodes2_operand2NodeIndexs,
                    ctfNode)
            if ctfChild < 0:
                continue
            if ctfChild >= ctfNodeCount:
                return false
            var ctfChildStateFound = false
            let ctfChildState = hashmaps.HashMapPtrIntGetEx(
                ctfStates,
                int64(ctfChild) + int64(1),
                ctfChildStateFound)
            if ctfChildStateFound && ctfChildState == 1:
                return false
            if ctfChildStateFound:
                continue
            add(ctfNodes, ctfChild)
            add(ctfNextEdges, 0)
            continue
        hashmaps.HashMapPtrIntPut(ctfStates,
                                  int64(ctfNode) + int64(1),
                                  2)
        setLen(ctfNodes, ctfTop)
        setLen(ctfNextEdges, ctfTop)
    return true

@borrows
fn PrimaryBodyIrArgLinkValueNodeIndexAt(typedIr: texpr.TypedExprIr,
                                         argLinkStart: int32,
                                         argCount: int32,
                                         argPosition: int32): int32 =
    if argPosition < 0 || argPosition >= argCount:
        return -1
    var argNodes: int32[]
    if !PrimaryBodyIrCollectArgLinkValueNodes(typedIr,
                                              argLinkStart,
                                              argNodes) ||
       argNodes.len != argCount:
        return -1
    return argNodes[argPosition]

@borrows
fn PrimaryBodyIrStatementCallArgNodeIndexAt(typedIr: texpr.TypedExprIr,
                                             stmt: lower.PrimaryObjectIrStatement,
                                             callNodeIndex: int32,
                                             argPosition: int32): int32 =
    let callArgNodeIndex = PrimaryBodyIrCallArgNodeIndexAt(typedIr,
                                                           callNodeIndex,
                                                           argPosition)
    if callArgNodeIndex >= 0:
        return callArgNodeIndex
    return PrimaryBodyIrArgLinkValueNodeIndexAt(typedIr,
                                                stmt.callArgNodeStart,
                                                stmt.callArgNodeCount,
                                                argPosition)

# bail=631 additive-with-indexed-operand operand materializer. Resolves ONE
# integer operand text to a slot: the scalar lowerer first (covers literals,
# locals, casts, simple-local index, nested additive), then the field-seq
# indexed reader (SeqIndexValueSlot) for `struct.field[idx]` operands the scalar
# path cannot resolve — the same reader that already lowers the pure
# `add(intSeq, f.words[w])` sibling. poison-on-miss: unresolved -> -1.
@borrows
fn PrimaryBodyIrSeqAddIntOperandSlot(bodyIR: var coreir.BodyIR,
                                     slotNames: var str[],
                                     varI32ParamNames: str[],
                                     typedIr: texpr.TypedExprIr,
                                     typedFn: texpr.TypedExprIrFunction,
                                     irFunction: lower.PrimaryObjectIrFunction,
                                     sourcePath: str,
                                     lineNumber: int32,
                                     opTextRaw: str,
                                     elemTypeKind: int32,
                                     callOrdinal: var int32): int32 =
    let opText = strutil.Strip(opTextRaw)
    if opText == "":
        return -1
    let scalarSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         typedIr,
                                                         sourcePath,
                                                         opText,
                                                         elemTypeKind,
                                                         callOrdinal)
    if scalarSlot >= 0:
        return scalarSlot
    if PrimaryBodyIrTextByteCodeEquals(opText, len(opText) - 1, 93):
        return PrimaryBodyIrSeqIndexValueSlot(bodyIR,
                                              slotNames,
                                              varI32ParamNames,
                                              typedIr,
                                              typedFn,
                                              irFunction,
                                              sourcePath,
                                              lineNumber,
                                              opText,
                                              callOrdinal)
    return -1

@borrows
fn PrimaryBodyIrSeqExactNodeTypeId(
        typedIr: texpr.TypedExprIr,
        nodeIndex: int32): int32 =
    if !typedIr.nodeAuthorityTypeArenaBound ||
       nodeIndex < 0 ||
       nodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_exactTypeArenaIds.len !=
           typedIr.nodes2_nodeIndexs.len:
        panic("seq enum: exact node TypeId missing")
    let typeId = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.nodes2_exactTypeArenaIds,
        nodeIndex)
    if typeId < 0:
        panic("seq enum: exact node TypeId invalid")
    return typeId

fn PrimaryBodyIrSeqEnumIdentity(
        lowering: var lower.LoweringPlanStub,
        typeId: int32,
        enumTypeIdOut: var int32): PrimaryBodyIrSeqEnumIdentityStatus =
    enumTypeIdOut =
        typechain.CanonicalTypeChainEnumTypeId(lowering, typeId)
    if enumTypeIdOut < 0:
        return PrimaryBodyIrSeqEnumNotEnum
    return PrimaryBodyIrSeqEnumResolved

fn PrimaryBodyIrSeqNodeMatchesResolvedTarget(
        lowering: var lower.LoweringPlanStub,
        seqNodeIndex: int32,
        elemTypeId: int32,
        elemKind: int32,
        elemSize: int32): bool =
    let seqTypeId =
        PrimaryBodyIrSeqExactNodeTypeId(lowering.typedIr, seqNodeIndex)
    let nodeElemTypeId =
        typechain.CanonicalTypeChainSequenceElementTypeId(
            lowering, seqTypeId, false)
    let nodePhysicalTypeId =
        typechain.CanonicalTypeChainPhysicalTypeId(
            lowering, nodeElemTypeId)
    return nodeElemTypeId == elemTypeId &&
           typechain.CanonicalTypeChainLocalKind(
               lowering, nodeElemTypeId) == elemKind &&
           lowering.typeArenaSizeBytes[nodePhysicalTypeId] == elemSize

fn PrimaryBodyIrSeqEnumNodeContract(
        lowering: var lower.LoweringPlanStub,
        valueNodeIndex: int32,
        targetTypeId: int32): PrimaryBodyIrSeqEnumArgClass =
    var targetEnumTypeId: int32
    if PrimaryBodyIrSeqEnumIdentity(
           lowering,
           targetTypeId,
           targetEnumTypeId) ==
           PrimaryBodyIrSeqEnumNotEnum:
        return PrimaryBodyIrSeqEnumArgNonEnum
    let valueTypeId =
        PrimaryBodyIrSeqExactNodeTypeId(
            lowering.typedIr, valueNodeIndex)
    var valueEnumTypeId: int32
    if PrimaryBodyIrSeqEnumIdentity(
           lowering,
           valueTypeId,
           valueEnumTypeId) ==
           PrimaryBodyIrSeqEnumNotEnum:
        return PrimaryBodyIrSeqEnumArgMismatch
    if valueEnumTypeId == targetEnumTypeId:
        return PrimaryBodyIrSeqEnumArgSame
    return PrimaryBodyIrSeqEnumArgMismatch

fn PrimaryBodyIrSeqEnumArgContract(
        lowering: var lower.LoweringPlanStub,
        valueNodeIndex: int32,
        elemTypeId: int32): PrimaryBodyIrSeqEnumArgClass =
    return PrimaryBodyIrSeqEnumNodeContract(
        lowering,

        valueNodeIndex,
        elemTypeId)

fn PrimaryBodyIrSeqEnumProjectedValueContract(
        lowering: var lower.LoweringPlanStub,
        valueNodeIndex: int32,
        elemTypeId: int32): PrimaryBodyIrSeqEnumArgClass =
    return PrimaryBodyIrSeqEnumNodeContract(
        lowering,

        valueNodeIndex,
        elemTypeId)

# Collects one complete ArgLink chain. Every link and value edge is validated;
# a repeated link is a malformed TypedIR cycle, while repeated value nodes are
# legal DAG sharing.
@borrows
fn PrimaryBodyIrCollectArgLinkValueNodes(typedIr: texpr.TypedExprIr,
                                         firstLink: int32,
                                         valueNodesOut: var int32[]): bool =
    valueNodesOut = []
    var visitedLinks = hashmaps.HashMapPtrIntInit(8)
    var linkIndex = firstLink
    while linkIndex >= 0:
        if linkIndex >= typedIr.nodes2_nodeIndexs.len ||
           typedIr.nodes2_opKinds[linkIndex] != texpr.TypedExprIrOpArgLink:
            return false
        var linkVisited = false
        let _ = hashmaps.HashMapPtrIntGetEx(visitedLinks,
                                            int64(linkIndex) + int64(1),
                                            linkVisited)
        if linkVisited:
            return false
        hashmaps.HashMapPtrIntPut(visitedLinks,
                                  int64(linkIndex) + int64(1),
                                  1)
        let valueNode = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_operand0NodeIndexs,
            linkIndex)
        if valueNode < 0 || valueNode >= typedIr.nodes2_nodeIndexs.len:
            return false
        add(valueNodesOut, valueNode)
        linkIndex = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_operand1NodeIndexs,
            linkIndex)
    return linkIndex == -1

# Proves that Seq.add value evaluation cannot enter any retired surface-text
# branch. LiteralText, paramName, resultType and node edges are typed facts;
# surfaceText/callArgsText are deliberately ignored.
@borrows
fn PrimaryBodyIrSeqAddValueNodeIsStructured(bodyIR: var coreir.BodyIR,
                                             slotNames: var str[],
                                             lowering: var lower.LoweringPlanStub,
                                             typedFn: texpr.TypedExprIrFunction,
                                             irFunction: lower.PrimaryObjectIrFunction,
                                             stmt: lower.PrimaryObjectIrStatement,
                                             rootNodeIndex: int32): bool =
    var work: int32[]
    add(work, rootNodeIndex)
    var visitedNodes = hashmaps.HashMapPtrIntInit(8)
    var cursor: int32
    while cursor < work.len:
        let nodeIndex = work[cursor]
        cursor = cursor + 1
        var nodeVisited = false
        let _ = hashmaps.HashMapPtrIntGetEx(visitedNodes,
                                            int64(nodeIndex) + int64(1),
                                            nodeVisited)
        if nodeVisited:
            continue
        hashmaps.HashMapPtrIntPut(visitedNodes,
                                  int64(nodeIndex) + int64(1),
                                  1)
        if !PrimaryBodyIrSeqNodeBelongsToStatement(lowering.typedIr,
                                                   typedFn,
                                                   irFunction,
                                                   stmt,
                                                   nodeIndex):
            return false
        let opKind = lowering.typedIr.nodes2_opKinds[nodeIndex]
        if opKind == texpr.TypedExprIrOpLocalRef ||
           opKind == texpr.TypedExprIrOpParamRef:
            let bindingRes: Result[str] = langintern.LookupIntern(
                lowering.typedIr.internPool,
                lowering.typedIr.nodes2_paramNameIds[nodeIndex])
            if !IsOk(bindingRes) || Value(bindingRes) == "":
                return false
        if opKind == texpr.TypedExprIrOpFieldGet:
            let fieldRes: Result[str] = langintern.LookupIntern(
                lowering.typedIr.internPool,
                lowering.typedIr.nodes2_literalTextIds[nodeIndex])
            let baseNodeIndex = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_operand0NodeIndexs,
                nodeIndex)
            if !IsOk(fieldRes) || baseNodeIndex < 0 ||
               baseNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
                return false
            if Value(fieldRes) == "len":
                let baseTypeRes: Result[str] = langintern.LookupIntern(
                    lowering.typedIr.internPool,
                    lowering.typedIr.nodes2_resultTypeIds[baseNodeIndex])
                if !IsOk(baseTypeRes) ||
                   PrimaryBodyIrTypeTextIsDynamicSeq(
                       texpr.TypedExprStripVarType(Value(baseTypeRes))):
                    return false
        if opKind == texpr.TypedExprIrOpCallExpr:
            let headRes: Result[str] = langintern.LookupIntern(
                lowering.typedIr.internPool,
                lowering.typedIr.nodes2_literalTextIds[nodeIndex])
            let sourceRes: Result[str] = langintern.LookupIntern(
                lowering.typedIr.internPool,
                lowering.typedIr.nodes2_sourcePathIds[nodeIndex])
            if !IsOk(headRes) || !IsOk(sourceRes):
                return false
            let callHead = Value(headRes)
            if PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr,
                                                            Value(sourceRes),
                                                            callHead):
                return false
            let callLeaf = texpr.TypedExprQualifiedCallLeaf(callHead)
            if callLeaf == "len" || callLeaf == "Len":
                let firstLink = arenamod.ArenaArrayInt32Get(
                    lowering.typedIr.arena,
                    lowering.typedIr.nodes2_operand0NodeIndexs,
                    nodeIndex)
                if firstLink >= 0 &&
                   firstLink < lowering.typedIr.nodes2_nodeIndexs.len &&
                   lowering.typedIr.nodes2_opKinds[firstLink] == texpr.TypedExprIrOpArgLink:
                    let firstValue = arenamod.ArenaArrayInt32Get(
                        lowering.typedIr.arena,
                        lowering.typedIr.nodes2_operand0NodeIndexs,
                        firstLink)
                    if firstValue >= 0 &&
                       firstValue < lowering.typedIr.nodes2_nodeIndexs.len:
                        let firstTypeRes: Result[str] = langintern.LookupIntern(
                            lowering.typedIr.internPool,
                            lowering.typedIr.nodes2_resultTypeIds[firstValue])
                        if !IsOk(firstTypeRes) ||
                           PrimaryBodyIrTypeTextIsDynamicSeq(
                               texpr.TypedExprStripVarType(Value(firstTypeRes))):
                            return false
            var callArgNodes: int32[]
            if !PrimaryBodyIrCollectArgLinkValueNodes(
                lowering.typedIr,
                arenamod.ArenaArrayInt32Get(lowering.typedIr.arena,
                                             lowering.typedIr.nodes2_operand0NodeIndexs,
                                             nodeIndex),
                callArgNodes):
                return false
            var callResultType = ""
            let callOrdinal = PrimaryBodyIrResolvedOrRegisteredWholeCallOrdinal(
                irFunction,
                lowering.typedIr,
                typedFn.sourcePath,
                callHead,
                callArgNodes.len,
                callResultType)
            if callOrdinal >= 0 &&
               callOrdinal < irFunction.callTargets.len &&
               callOrdinal < irFunction.callTargetSourcePaths.len &&
               callOrdinal < irFunction.callTargetSignatureLineNumbers.len &&
               callOrdinal < irFunction.callTargetImportcFlags.len:
                var callStmt: lower.PrimaryObjectIrStatement
                callStmt.sourcePath = typedFn.sourcePath
                callStmt.callTarget = irFunction.callTargets[callOrdinal]
                callStmt.callTargetSourcePath = irFunction.callTargetSourcePaths[callOrdinal]
                callStmt.callTargetSignatureLineNumber =
                    irFunction.callTargetSignatureLineNumbers[callOrdinal]
                callStmt.callTargetImportc = irFunction.callTargetImportcFlags[callOrdinal]
                for callArgIndex in 0..<callArgNodes.len:
                    let callArgNode = callArgNodes[callArgIndex]
                    if callArgNode < 0 || callArgNode >= lowering.typedIr.nodes2_nodeIndexs.len:
                        return false
                    if !PrimaryBodyIrTypeTextIsVarParam(
                            PrimaryBodyIrTargetParamType(lowering, callStmt, callArgIndex,
                                                         "seqadd_vararg", callOrdinal,
                                                         "", "", 0, "")):
                        continue
                    let callArgKind = lowering.typedIr.nodes2_opKinds[callArgNode]
                    if callArgKind == texpr.TypedExprIrOpLocalRef ||
                       callArgKind == texpr.TypedExprIrOpParamRef:
                        continue
                    var rootSlot: int32
                    var totalOffset: int32
                    if PrimaryBodyIrVarArgFieldPathInfo(bodyIR,
                                                        slotNames,
                                                        lowering.typedIr,
                                                        callArgNode,
                                                        rootSlot,
                                                        totalOffset):
                        continue
                    var headerOffset: int32
                    var elemSize: int32
                    var indexNode: int32
                    if PrimaryBodyIrVarArgIndexInfo(bodyIR,
                                                    slotNames,
                                                    lowering.typedIr,
                                                    callArgNode,
                                                    rootSlot,
                                                    headerOffset,
                                                    elemSize,
                                                    indexNode):
                        continue
                    var fieldOffset: int32
                    if PrimaryBodyIrVarArgIndexedFieldInfo(bodyIR,
                                                           slotNames,
                                                           lowering.typedIr,
                                                           callArgNode,
                                                           rootSlot,
                                                           headerOffset,
                                                           elemSize,
                                                           indexNode,
                                                           fieldOffset):
                        continue
                    return false
        let op0 = arenamod.ArenaArrayInt32Get(
            lowering.typedIr.arena,
            lowering.typedIr.nodes2_operand0NodeIndexs,
            nodeIndex)
        let op1 = arenamod.ArenaArrayInt32Get(
            lowering.typedIr.arena,
            lowering.typedIr.nodes2_operand1NodeIndexs,
            nodeIndex)
        let op2 = arenamod.ArenaArrayInt32Get(
            lowering.typedIr.arena,
            lowering.typedIr.nodes2_operand2NodeIndexs,
            nodeIndex)
        if (op0 >= 0 && op0 >= nodeIndex) ||
           (op1 >= 0 && op1 >= nodeIndex) ||
           (op2 >= 0 && op2 >= nodeIndex):
            return false
        if op0 >= 0:
            add(work, op0)
        if op1 >= 0:
            add(work, op1)
        if op2 >= 0:
            add(work, op2)
    return true

@borrows
fn PrimaryBodyIrSeqAddHardFail(bodyIR: var coreir.BodyIR,
                                stmt: lower.PrimaryObjectIrStatement,
                                detail1: int32): PrimaryBodyIrSeqAddOutcome =
    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                 stmt.lineNumber,
                                 int32(stmt.kind),
                                 819,
                                 detail1)
    return PrimaryBodyIrSeqAddOutcomeHardFail

fn PrimaryBodyIrRecordSeqAddReceipt(nodeEvalOnlyActive: bool,
                                    outcome: PrimaryBodyIrSeqAddOutcome,
                                    typedContract: bool,
                                    nodeProbeHit: bool,
                                    typeMismatch: bool,
                                    candidateCount: var int32,
                                    typedContractCount: var int32,
                                    structuredConsumeCount: var int32,
                                    nodeProbeHitCount: var int32,
                                    typeMismatchCount: var int32,
                                    legacyTextConsumeCount: var int32,
                                    nodeEvalGapCount: var int32) =
    candidateCount = candidateCount + 1
    if typedContract:
        typedContractCount = typedContractCount + 1
    if outcome == PrimaryBodyIrSeqAddOutcomeStructuredConsumed:
        if !typedContract || !nodeProbeHit || typeMismatch:
            panic("primary_seq_add_structured_outcome_contract_mismatch")
        structuredConsumeCount = structuredConsumeCount + 1
    elif outcome == PrimaryBodyIrSeqAddOutcomeNotOwned:
        if typedContract || nodeProbeHit || typeMismatch:
            panic("primary_seq_add_not_owned_outcome_contract_mismatch")
        if nodeEvalOnlyActive:
            nodeEvalGapCount = nodeEvalGapCount + 1
    elif outcome == PrimaryBodyIrSeqAddOutcomeHardFail:
        if (nodeProbeHit || typeMismatch) && !typedContract:
            panic("primary_seq_add_hard_fail_outcome_contract_mismatch")
    else:
        panic("primary_seq_add_unknown_outcome")
    if nodeProbeHit:
        nodeProbeHitCount = nodeProbeHitCount + 1
    if typeMismatch:
        typeMismatchCount = typeMismatchCount + 1


@borrows
fn PrimaryBodyIrAppendSeqGeneralAddBuiltin(bodyIR: var coreir.BodyIR,
                                            slotNames: var str[],
                                            lowering: var lower.LoweringPlanStub,
                                            typedFn: texpr.TypedExprIrFunction,
                                            irFunction: lower.PrimaryObjectIrFunction,
                                            varI32ParamNames: str[],
                                            stmt: lower.PrimaryObjectIrStatement,
                                            callOrdinal: var int32,
                                            typedContractOut: var bool,
                                            nodeProbeHitOut: var bool,
                                            typeMismatchOut: var bool): PrimaryBodyIrSeqAddOutcome =
    typedContractOut = false
    nodeProbeHitOut = false
    typeMismatchOut = false
    let candidateBuiltin = stmt.callKind == texpr.TypedExprCallBuiltin &&
                           (stmt.callCallee == "add" || stmt.callCallee == "Add")
    let candidateSeqs = (stmt.callCallee == "Add" ||
                         PrimaryCallTargetTailName(stmt.callTarget) == "Add") &&
                        strings.HasSuffix(stmt.callTargetSourcePath, "std/seqs.cheng")
    if !candidateBuiltin && !candidateSeqs:
        return PrimaryBodyIrSeqAddOutcomeNotOwned
    var seqNodeIndex: int32
    var valueNodeIndex: int32
    var contractDetail: int32
    var typedContractCount: int32
    if !PrimaryBodyIrConsumeSeqAddContract(lowering.typedIr,
                                            typedFn,
                                            irFunction,
                                            stmt,
                                            typedContractCount,
                                            seqNodeIndex,
                                            valueNodeIndex,
                                            contractDetail):
        return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, contractDetail)
    typedContractOut = typedContractCount == 1

    var seqRootSlot: int32
    var seqRootIsGlobal: bool
    var seqRootTypeKind: int32
    var seqFieldName: str
    var seqHeaderOffset: int32
    var seqElemSizeBytes: int32
    var seqElemTypeKind: int32
    var seqElemTypeId: int32
    if !PrimaryBodyIrResolveSeqRootHeaderFromNode(bodyIR,
                                                  slotNames,
                                                  lowering,

                                                  typedFn,
                                                  irFunction,
                                                  stmt,
                                                  seqNodeIndex,
                                                  seqRootSlot,
                                                  seqRootIsGlobal,
                                                  seqRootTypeKind,
                                                  seqFieldName,
                                                  seqHeaderOffset,
                                                  seqElemSizeBytes,
                                                  seqElemTypeKind,
                                                  seqElemTypeId):
        return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)
    if !PrimaryBodyIrSeqNodeMatchesResolvedTarget(lowering,

                                                   seqNodeIndex,
                                                   seqElemTypeId,
                                                   seqElemTypeKind,
                                                   seqElemSizeBytes):
        typeMismatchOut = true
        return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)

    var enumClass = PrimaryBodyIrSeqEnumProjectedValueContract(lowering,

                                                                valueNodeIndex,
                                                                seqElemTypeId)
    if enumClass == PrimaryBodyIrSeqEnumArgNonEnum:
        enumClass = PrimaryBodyIrSeqEnumArgContract(lowering,

                                                     valueNodeIndex,
                                                     seqElemTypeId)
    if enumClass == PrimaryBodyIrSeqEnumArgStructure:
        return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)
    if enumClass == PrimaryBodyIrSeqEnumArgMismatch:
        typeMismatchOut = true
        return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 2)

    if !PrimaryBodyIrSeqAddValueNodeIsStructured(bodyIR,
                                                  slotNames,
                                                  lowering,

                                                  typedFn,
                                                  irFunction,
                                                  stmt,
                                                  valueNodeIndex):
        return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)
    let valueProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                    slotNames,
                                                    varI32ParamNames,
                                                    lowering,

                                                    share(typedFn),
                                                    irFunction,
                                                    valueNodeIndex)
    if valueProbeKind == coreir.LocalInvalidTag:
        return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)
    nodeProbeHitOut = true
    var valueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                          slotNames,
                                          varI32ParamNames,
                                          lowering,

                                          typedFn,
                                          irFunction,
                                          valueNodeIndex,
                                          callOrdinal)
    if valueSlot < 0 || valueSlot >= bodyIR.localSlots.len:
        return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)

    if seqElemTypeKind == coreir.LocalStrTag:
        if PrimaryBodyIrSlotType(bodyIR, valueSlot) != coreir.LocalStrTag:
            typeMismatchOut = true
            return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)
        if seqRootIsGlobal:
            let recordSlot = PrimaryBodyIrSeqStrAddRecordSlot(bodyIR,
                                                               slotNames,
                                                               valueSlot)
            if recordSlot < 0:
                return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)
            var addCall: coreir.CallOp
            addCall.targetSymbol = "cheng_seq_str_add"
            addCall.resultSlot = -1
            addCall.resultPassKind = coreir.BodyCallPassStackValueTag
            add(addCall.argSlots, seqRootSlot)
            add(addCall.argPassKinds, coreir.BodyCallPassGlobalAddressTag)
            add(addCall.argSlots, coreir.CallArgSlotAddress(recordSlot))
            add(addCall.argPassKinds, coreir.BodyCallPassParamAddressTag)
            add(bodyIR.callSequence, addCall)
            var addOp: coreir.BodyOp
            addOp.kind = coreir.BodyOpCallTag
            addOp.target = -1
            add(addOp.operands, callOrdinal)
            let _ = coreir.BodyIRAppendOp(bodyIR, addOp)
            callOrdinal = callOrdinal + 1
            return PrimaryBodyIrSeqAddOutcomeStructuredConsumed
        if seqFieldName == "" &&
           seqRootTypeKind == coreir.LocalAggregateTag &&
           !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[seqRootSlot]):
            if !PrimaryBodyIrAppendSeqStrAddValueSlot(bodyIR,
                                                       slotNames,
                                                       seqRootSlot,
                                                       valueSlot,
                                                       callOrdinal):
                return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)
            return PrimaryBodyIrSeqAddOutcomeStructuredConsumed
        let headerPtrSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                             slotNames,
                                                             stmt.lineNumber,
                                                             seqRootSlot,
                                                             seqHeaderOffset)
        if headerPtrSlot < 0:
            return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)
        let recordSlot = PrimaryBodyIrSeqStrAddRecordSlot(bodyIR,
                                                           slotNames,
                                                           valueSlot)
        if recordSlot < 0:
            return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)
        var addCall: coreir.CallOp
        addCall.targetSymbol = "cheng_seq_str_add"
        addCall.resultSlot = -1
        addCall.resultPassKind = coreir.BodyCallPassStackValueTag
        add(addCall.argSlots, headerPtrSlot)
        add(addCall.argPassKinds, coreir.BodyCallPassStackValueTag)
        add(addCall.argSlots, coreir.CallArgSlotAddress(recordSlot))
        add(addCall.argPassKinds, coreir.BodyCallPassParamAddressTag)
        add(bodyIR.callSequence, addCall)
        var addOp: coreir.BodyOp
        addOp.kind = coreir.BodyOpCallTag
        addOp.target = -1
        add(addOp.operands, callOrdinal)
        let _ = coreir.BodyIRAppendOp(bodyIR, addOp)
        callOrdinal = callOrdinal + 1
        return PrimaryBodyIrSeqAddOutcomeStructuredConsumed

    if (PrimaryBodyIrSlotType(bodyIR, valueSlot) == coreir.LocalAggregateTag &&
        PrimaryBodyIrLocalIsParam(bodyIR.localSlots[valueSlot])) ||
       PrimaryBodyIrVarParamPointeeKind(bodyIR, valueSlot) != coreir.LocalInvalidTag:
        let seqElemPhysicalTypeId =
            typechain.CanonicalTypeChainPhysicalTypeId(
                lowering, seqElemTypeId)
        let copySlot = PrimaryBodyIrFindOrCreateSlotSized(
            bodyIR,
            slotNames,
            Fmt"#seq_add_val_copy#{stmt.lineNumber}#{bodyIR.ops.len}",
            seqElemTypeKind,
            seqElemSizeBytes,
            lowering.typeArenaAlignBytes[seqElemPhysicalTypeId])
        let copyManagedKind =
            lowering.typedIr.nodes2_resultTypeManagedFlags[valueNodeIndex] ?
                coreir.BodyManagedStorageManagedTag :
                coreir.BodyManagedStorageUnmanagedTag
        if copySlot < 0 ||
           !coreir.BodyIRBindTypeArenaArtifactCid(
               bodyIR, lowering.typeArenaArtifactCid) ||
           !coreir.BodyIRBindLocalSlotTypeArenaProof(
               bodyIR,
               copySlot,
               lowering.typeArenaArtifactCid,
               seqElemTypeId,
               copyManagedKind):
            return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)
        var derefOp: coreir.BodyOp
        derefOp.kind = coreir.BodyOpFieldLoadTag
        derefOp.target = copySlot
        add(derefOp.operands, valueSlot)
        add(derefOp.operands, copySlot)
        add(derefOp.operands, 0)
        add(derefOp.operands, seqElemSizeBytes)
        let _ = coreir.BodyIRAppendOp(bodyIR, derefOp)
        valueSlot = copySlot
    if PrimaryBodyIrSlotType(bodyIR, valueSlot) != seqElemTypeKind ||
       PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < seqElemSizeBytes:
        typeMismatchOut = true
        return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)

    let lenSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                slotNames,
                                                Fmt"#seq_add_len#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                coreir.LocalI32Tag)
    if lenSlot < 0:
        return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)
    if seqRootIsGlobal:
        var lenCall: coreir.CallOp
        lenCall.targetSymbol = "cheng_seq_header_len_get"
        lenCall.resultSlot = lenSlot
        lenCall.resultPassKind = coreir.BodyCallPassStackValueTag
        add(lenCall.argSlots, seqRootSlot)
        add(lenCall.argPassKinds, coreir.BodyCallPassGlobalAddressTag)
        add(bodyIR.callSequence, lenCall)
        var lenOp: coreir.BodyOp
        lenOp.kind = coreir.BodyOpCallTag
        lenOp.target = lenSlot
        add(lenOp.operands, callOrdinal)
        let _ = coreir.BodyIRAppendOp(bodyIR, lenOp)
        callOrdinal = callOrdinal + 1
    else:
        var lenOp: coreir.BodyOp
        lenOp.kind = coreir.BodyOpFieldLoadTag
        lenOp.target = lenSlot
        add(lenOp.operands, seqRootSlot)
        add(lenOp.operands, lenSlot)
        add(lenOp.operands, seqHeaderOffset)
        add(lenOp.operands, 4)
        let _ = coreir.BodyIRAppendOp(bodyIR, lenOp)

    let elemSizeSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                        slotNames,
                                                        Fmt"#seq_add_esz#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                        coreir.LocalI32Tag,
                                                        seqElemSizeBytes)
    if elemSizeSlot < 0:
        return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)
    var headerArgSlot: int32
    var headerArgPassKind = coreir.BodyCallPassStackValueTag
    if seqRootIsGlobal:
        headerArgSlot = seqRootSlot
        headerArgPassKind = coreir.BodyCallPassGlobalAddressTag
    elif seqFieldName == "" &&
         seqRootTypeKind == coreir.LocalAggregateTag &&
         !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[seqRootSlot]):
        headerArgSlot = coreir.CallArgSlotAddress(seqRootSlot)
        headerArgPassKind = coreir.BodyCallPassParamAddressTag
    elif seqFieldName == "" && seqRootTypeKind == coreir.LocalPtrTag:
        headerArgSlot = seqRootSlot
    else:
        headerArgSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                         slotNames,
                                                         stmt.lineNumber,
                                                         seqRootSlot,
                                                         seqHeaderOffset)
        if headerArgSlot < 0:
            return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)

    let elemPtrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#seq_add_elem#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                    coreir.LocalPtrTag)
    if elemPtrSlot < 0:
        return PrimaryBodyIrSeqAddHardFail(bodyIR, stmt, 1)
    var growCall: coreir.CallOp
    growCall.targetSymbol = "cheng_seq_set_grow"
    growCall.resultSlot = elemPtrSlot
    growCall.resultPassKind = coreir.BodyCallPassStackValueTag
    add(growCall.argSlots, headerArgSlot)
    add(growCall.argPassKinds, headerArgPassKind)
    add(growCall.argSlots, lenSlot)
    add(growCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(growCall.argSlots, elemSizeSlot)
    add(growCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(bodyIR.callSequence, growCall)
    var growOp: coreir.BodyOp
    growOp.kind = coreir.BodyOpCallTag
    growOp.target = elemPtrSlot
    add(growOp.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, growOp)
    callOrdinal = callOrdinal + 1

    var storeOp: coreir.BodyOp
    storeOp.kind = coreir.BodyOpFieldStoreTag
    storeOp.target = elemPtrSlot
    add(storeOp.operands, elemPtrSlot)
    add(storeOp.operands, valueSlot)
    add(storeOp.operands, 0)
    add(storeOp.operands, seqElemSizeBytes)
    let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
    return PrimaryBodyIrSeqAddOutcomeStructuredConsumed

fn PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR: var coreir.BodyIR,
                                     slotNames: var str[],
                                     lineNumber: int32,
                                     rootSlot: int32,
                                     offsetBytes: int32): int32 =
    let offConstSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"#seq_add_off#{lineNumber}#{bodyIR.ops.len}",
                                                       coreir.LocalI64Tag,
                                                       offsetBytes)
    if offConstSlot < 0:
        return -1
    let hdrPtrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   Fmt"#seq_add_hdr#{lineNumber}#{bodyIR.ops.len}",
                                                   coreir.LocalPtrTag)
    if hdrPtrSlot < 0:
        return -1
    var addrOp: coreir.BodyOp
    addrOp.kind = coreir.BodyOpBinOpTag
    addrOp.target = hdrPtrSlot
    add(addrOp.operands, coreir.LocalI64Tag)
    add(addrOp.operands, int32(texpr.TypedExprIrOpI32Add))
    add(addrOp.operands, rootSlot)
    add(addrOp.operands, offConstSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, addrOp)
    return hdrPtrSlot

@borrows
fn PrimaryBodyIrAppendSeqDropStrFieldTail(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           lineNumber: int32,
                                           headerSlot: int32,
                                           headerPassKind: int32,
                                           newLenSlot: int32,
                                           elemSizeSlot: int32,
                                           fieldOffset: int32,
                                           callOrdinal: var int32): bool =
    let fieldOffsetSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"#seq_drop_str_off#{lineNumber}#{bodyIR.ops.len}",
                                                           coreir.LocalI32Tag,
                                                           fieldOffset)
    if fieldOffsetSlot < 0:
        return false
    let resultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#seq_drop_str_void#{lineNumber}#{bodyIR.ops.len}",
                                                    coreir.LocalI32Tag)
    if resultSlot < 0:
        return false
    var call: coreir.CallOp
    call.targetSymbol = "cheng_seq_drop_str_field_tail"
    call.resultSlot = resultSlot
    call.resultPassKind = coreir.BodyCallPassStackValueTag
    add(call.argSlots, headerSlot)
    add(call.argPassKinds, headerPassKind)
    add(call.argSlots, newLenSlot)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(call.argSlots, elemSizeSlot)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(call.argSlots, fieldOffsetSlot)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(bodyIR.callSequence, call)
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpCallTag
    op.target = resultSlot
    add(op.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    callOrdinal = callOrdinal + 1
    return true

# setLen(seq, target) lowering: resolves the seq header (plain local/param,
# global, or nested field-path) identically to the general add path, materializes
# the i32 target into a value slot, and emits a single cheng_seq_set_len(header,
# target, elemSize) bridge call (grow+zero-tail+set-len done in the runtime,
# mirroring std/seqs.cheng setLen).
@borrows
fn PrimaryBodyIrAppendSeqSetLenBuiltin(bodyIR: var coreir.BodyIR,
                                        slotNames: var str[],
                                        lowering: var lower.LoweringPlanStub,
                                        typedFn: texpr.TypedExprIrFunction,
                                        irFunction: lower.PrimaryObjectIrFunction,
                                        varI32ParamNames: str[],
                                        stmt: lower.PrimaryObjectIrStatement,
                                        callOrdinal: var int32): bool =
    let argNames = PrimaryBodyIrCallArgNames(stmt.callArgsText)
    if argNames.len != 2:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=seq_setlen_fail reason=1 args={stmt.callArgsText}")
        return false
    let seqText = strutil.Strip(argNames[0])
    let lenText = strutil.Strip(argNames[1])
    if seqText == "" || lenText == "":
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=seq_setlen_fail reason=2 args={stmt.callArgsText}")
        return false
    var seqRootSlot: int32
    var seqRootIsGlobal: bool
    var seqRootTypeKind: int32
    var seqFieldName: str
    var seqHeaderOffset: int32
    var seqElemSizeBytes: int32
    var seqElemTypeKind: int32
    var seqElemTypeId: int32
    if !PrimaryBodyIrResolveSeqRootHeader(bodyIR,
                                          slotNames,
                                          lowering,

                                          typedFn,
                                          irFunction,
                                          stmt,
                                          seqRootSlot,
                                          seqRootIsGlobal,
                                          seqRootTypeKind,
                                          seqFieldName,
                                          seqHeaderOffset,
                                          seqElemSizeBytes,
                                          seqElemTypeKind,
                                          seqElemTypeId):
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=seq_setlen_fail reason=3 args={stmt.callArgsText}")
        return false
    let seqLenSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering.typedIr,
                                                                typedFn,
                                                                irFunction,
                                                                stmt.sourcePath,
                                                                stmt.lineNumber,
                                                                lenText,
                                                                coreir.LocalI32Tag)
    if seqLenSlot < 0 || seqLenSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, seqLenSlot) != coreir.LocalI32Tag:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=seq_setlen_fail reason=4 args={stmt.callArgsText}")
        return false
    let seqElemSizeSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#seq_setlen_esz#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                          coreir.LocalI32Tag,
                                                          seqElemSizeBytes)
    if seqElemSizeSlot < 0:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=seq_setlen_fail reason=5 args={stmt.callArgsText}")
        return false
    var setLenHdrArgSlot: int32
    var setLenHdrArgPassKind = coreir.BodyCallPassStackValueTag
    if seqRootIsGlobal:
        setLenHdrArgSlot = seqRootSlot
        setLenHdrArgPassKind = coreir.BodyCallPassGlobalAddressTag
    elif seqFieldName == "" && seqRootTypeKind == coreir.LocalAggregateTag &&
       !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[seqRootSlot]):
        setLenHdrArgSlot = coreir.CallArgSlotAddress(seqRootSlot)
        setLenHdrArgPassKind = coreir.BodyCallPassParamAddressTag
    elif seqFieldName == "" && seqRootTypeKind == coreir.LocalPtrTag:
        setLenHdrArgSlot = seqRootSlot
    else:
        let hdrPtrSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                          slotNames,
                                                          stmt.lineNumber,
                                                          seqRootSlot,
                                                          seqHeaderOffset)
        if hdrPtrSlot < 0:
            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                os.WriteLine(os.GetStderr(), Fmt"phase=seq_setlen_fail reason=6 args={stmt.callArgsText}")
            return false
        setLenHdrArgSlot = hdrPtrSlot
    let seqNodeIndex = PrimaryBodyIrStatementCallArgNodeIndexAt(
        lowering.typedIr, stmt, stmt.rhsNodeIndex, 0)
    if seqNodeIndex < 0:
        panic("seq setLen: typed argument node missing")
    let seqTypeRes: Result[str] = langintern.LookupIntern(
        lowering.typedIr.internPool,
        lowering.typedIr.nodes2_resultTypeIds[seqNodeIndex])
    let seqSourceRes: Result[str] = langintern.LookupIntern(
        lowering.typedIr.internPool,
        lowering.typedIr.nodes2_sourcePathIds[seqNodeIndex])
    if !IsOk(seqTypeRes) || !IsOk(seqSourceRes):
        return false
    let seqElemType = PrimaryBodyIrIndexedElementTypeText(
        texpr.TypedExprNormalizeTypeText(
            texpr.TypedExprStripVarType(Value(seqTypeRes))))
    let seqElemSourcePath = parser.ParserNormalizePath(Value(seqSourceRes))
    if seqElemType == "" || seqElemSourcePath == "":
        return false
    var managedStrFieldCount: int32
    if !texpr.TypedExprIrManagedStrFieldCount(lowering.typedIr,
                                              strings.CloneStr(seqElemSourcePath),
                                              strings.CloneStr(seqElemType),
                                              managedStrFieldCount):
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=seq_setlen_fail reason=8 type={seqElemType}")
        return false
    if managedStrFieldCount > 0:
        var strSizeBytes: int32
        var strAlignBytes: int32
        var strFieldCount: int32
        if !texpr.TypedExprIrLookupTypeLayout(lowering.typedIr,
                                              strings.CloneStr(seqElemSourcePath),
                                              "str",
                                              strSizeBytes,
                                              strAlignBytes,
                                              strFieldCount) ||
           strSizeBytes <= 0:
            return false
        for managedIndex in 0..<managedStrFieldCount:
            var fieldOffset: int32
            if !texpr.TypedExprIrManagedStrFieldOffsetAt(lowering.typedIr,
                                                          strings.CloneStr(seqElemSourcePath),
                                                          strings.CloneStr(seqElemType),
                                                          managedIndex,
                                                          fieldOffset):
                return false
            if fieldOffset < 0 || fieldOffset > seqElemSizeBytes - strSizeBytes:
                return false
            if !PrimaryBodyIrAppendSeqDropStrFieldTail(bodyIR,
                                                        slotNames,
                                                        stmt.lineNumber,
                                                        setLenHdrArgSlot,
                                                        setLenHdrArgPassKind,
                                                        seqLenSlot,
                                                        seqElemSizeSlot,
                                                        fieldOffset,
                                                        callOrdinal):
                return false
    let setLenVoidSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"#seq_setlen_void#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                       coreir.LocalI32Tag)
    if setLenVoidSlot < 0:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=seq_setlen_fail reason=7 args={stmt.callArgsText}")
        return false
    var setLenCall: coreir.CallOp
    setLenCall.targetSymbol = "cheng_seq_set_len"
    setLenCall.resultSlot = setLenVoidSlot
    setLenCall.resultPassKind = coreir.BodyCallPassStackValueTag
    add(setLenCall.argSlots, setLenHdrArgSlot)
    add(setLenCall.argPassKinds, setLenHdrArgPassKind)
    add(setLenCall.argSlots, seqLenSlot)
    add(setLenCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(setLenCall.argSlots, seqElemSizeSlot)
    add(setLenCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(bodyIR.callSequence, setLenCall)
    var setLenOp: coreir.BodyOp
    setLenOp.kind = coreir.BodyOpCallTag
    setLenOp.target = setLenVoidSlot
    add(setLenOp.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, setLenOp)
    callOrdinal = callOrdinal + 1
    return true

# reserve(seq, newCap) lowering: resolves the seq header identically to the
# setLen path, materializes the i32 capacity into a value slot, and emits a
# single cheng_seq_grow_inst(header, newCap, elemSize) bridge call. The runtime
# grow_inst carries the same guard as std/seqs.cheng reserve (buffer==nil ||
# newCap>cap, plus newCap<=0 no-op), so this is a 1:1 lowering of reserve with no
# len/zero-tail side effect — mirrors the setLen bridge minus the resize semantics.
@borrows
fn PrimaryBodyIrAppendSeqReserveBuiltin(bodyIR: var coreir.BodyIR,
                                         slotNames: var str[],
                                         lowering: var lower.LoweringPlanStub,
                                         typedFn: texpr.TypedExprIrFunction,
                                         irFunction: lower.PrimaryObjectIrFunction,
                                         varI32ParamNames: str[],
                                         stmt: lower.PrimaryObjectIrStatement,
                                         callOrdinal: var int32): bool =
    let argNames = PrimaryBodyIrCallArgNames(stmt.callArgsText)
    if argNames.len != 2:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=seq_reserve_fail reason=1 args={stmt.callArgsText}")
        return false
    let seqText = strutil.Strip(argNames[0])
    let capText = strutil.Strip(argNames[1])
    if seqText == "" || capText == "":
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=seq_reserve_fail reason=2 args={stmt.callArgsText}")
        return false
    var seqRootSlot: int32
    var seqRootIsGlobal: bool
    var seqRootTypeKind: int32
    var seqFieldName: str
    var seqHeaderOffset: int32
    var seqElemSizeBytes: int32
    var seqElemTypeKind: int32
    var seqElemTypeId: int32
    if !PrimaryBodyIrResolveSeqRootHeader(bodyIR,
                                          slotNames,
                                          lowering,

                                          typedFn,
                                          irFunction,
                                          stmt,
                                          seqRootSlot,
                                          seqRootIsGlobal,
                                          seqRootTypeKind,
                                          seqFieldName,
                                          seqHeaderOffset,
                                          seqElemSizeBytes,
                                          seqElemTypeKind,
                                          seqElemTypeId):
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=seq_reserve_fail reason=3 args={stmt.callArgsText}")
        return false
    let seqCapSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering.typedIr,
                                                                typedFn,
                                                                irFunction,
                                                                stmt.sourcePath,
                                                                stmt.lineNumber,
                                                                capText,
                                                                coreir.LocalI32Tag)
    if seqCapSlot < 0 || seqCapSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, seqCapSlot) != coreir.LocalI32Tag:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=seq_reserve_fail reason=4 args={stmt.callArgsText}")
        return false
    let seqElemSizeSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#seq_reserve_esz#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                          coreir.LocalI32Tag,
                                                          seqElemSizeBytes)
    if seqElemSizeSlot < 0:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=seq_reserve_fail reason=5 args={stmt.callArgsText}")
        return false
    var reserveHdrArgSlot: int32
    var reserveHdrArgPassKind = coreir.BodyCallPassStackValueTag
    if seqRootIsGlobal:
        reserveHdrArgSlot = seqRootSlot
        reserveHdrArgPassKind = coreir.BodyCallPassGlobalAddressTag
    elif seqFieldName == "" && seqRootTypeKind == coreir.LocalAggregateTag &&
       !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[seqRootSlot]):
        reserveHdrArgSlot = coreir.CallArgSlotAddress(seqRootSlot)
        reserveHdrArgPassKind = coreir.BodyCallPassParamAddressTag
    elif seqFieldName == "" && seqRootTypeKind == coreir.LocalPtrTag:
        reserveHdrArgSlot = seqRootSlot
    else:
        let hdrPtrSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                          slotNames,
                                                          stmt.lineNumber,
                                                          seqRootSlot,
                                                          seqHeaderOffset)
        if hdrPtrSlot < 0:
            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                os.WriteLine(os.GetStderr(), Fmt"phase=seq_reserve_fail reason=6 args={stmt.callArgsText}")
            return false
        reserveHdrArgSlot = hdrPtrSlot
    let reserveVoidSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"#seq_reserve_void#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                       coreir.LocalI32Tag)
    if reserveVoidSlot < 0:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=seq_reserve_fail reason=7 args={stmt.callArgsText}")
        return false
    var reserveCall: coreir.CallOp
    reserveCall.targetSymbol = "cheng_seq_grow_inst"
    reserveCall.resultSlot = reserveVoidSlot
    reserveCall.resultPassKind = coreir.BodyCallPassStackValueTag
    add(reserveCall.argSlots, reserveHdrArgSlot)
    add(reserveCall.argPassKinds, reserveHdrArgPassKind)
    add(reserveCall.argSlots, seqCapSlot)
    add(reserveCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(reserveCall.argSlots, seqElemSizeSlot)
    add(reserveCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(bodyIR.callSequence, reserveCall)
    var reserveOp: coreir.BodyOp
    reserveOp.kind = coreir.BodyOpCallTag
    reserveOp.target = reserveVoidSlot
    add(reserveOp.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, reserveOp)
    callOrdinal = callOrdinal + 1
    return true

@borrows
fn PrimaryBodyIrFmtLiteralPayload(textRaw: str): str =
    let text = strutil.Strip(textRaw)
    if len(text) < 5:
        return ""
    if !PrimaryStartsWith(text, "Fmt"):
        return ""
    var quotePos = 3
    while quotePos < len(text) &&
          (strings.SliceBytes(text, quotePos, 1) == strings.CharToStr(Char(32)) ||
           strings.SliceBytes(text, quotePos, 1) == strings.CharToStr(Char(9))):
        quotePos = quotePos + 1
    if quotePos >= len(text) ||
       strings.SliceBytes(text, quotePos, 1) != strings.CharToStr(Char(34)):
        return ""
    if strings.SliceBytes(text, len(text) - 1, 1) != strings.CharToStr(Char(34)):
        return ""
    return strings.SliceBytes(text, quotePos + 1, len(text) - quotePos - 2)

@borrows
fn PrimaryBodyIrTextByteCodeEquals(text: str,
                                    index: int32,
                                    expectedCode: int32): bool =
    if index < 0 || index >= len(text):
        return false
    if strings.SliceBytes(share(text), index, 1) == strings.CharToStr(Char(expectedCode)):
        return true
    return false

@borrows
fn PrimaryBodyIrAppendFmtPieceSlot(bodyIR: var coreir.BodyIR,
                                    slotNames: var str[],
                                    targetSlot: int32,
                                    seqSlot: int32,
                                    pieceSlot: int32,
                                    callOrdinal: var int32): bool =
    let _ = targetSlot
    return PrimaryBodyIrAppendSeqStrAddValueSlot(bodyIR,
                                                 slotNames,
                                                 seqSlot,
                                                 pieceSlot,
                                                 callOrdinal)

@borrows
fn PrimaryBodyIrAppendScalarToStrBridge(bodyIR: var coreir.BodyIR,
                                         slotNames: var str[],
                                         lowering: lower.LoweringPlanStub,
                                         transport: lower.LoweringOwnershipTransportSoA,
                                         fmtNodeIndex: int32,
                                         sourceSlot: int32,
                                         sourceTypeKind: int32,
                                         targetSlot: int32,
                                         callOrdinal: var int32): bool =
    let _ = slotNames
    if sourceSlot < 0 ||
       sourceSlot >= bodyIR.localSlots.len ||
       targetSlot < 0 ||
       targetSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalStrTag:
        return false
    var bridgeName = ""
    if sourceTypeKind == coreir.LocalI32Tag:
        bridgeName = "cheng_i32_to_str_bridge"
    elif sourceTypeKind == coreir.LocalI64Tag:
        bridgeName = "cheng_i64_to_str_bridge"
    else:
        return false
    var call: coreir.CallOp
    call.targetSymbol = bridgeName
    call.resultSlot = targetSlot
    call.resultPassKind = coreir.BodyCallPassSretResultTag
    add(call.argSlots, sourceSlot)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(bodyIR.callSequence, call)
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpCallTag
    op.target = targetSlot
    add(op.operands, callOrdinal)
    let scalarBridgeOpIndex = coreir.BodyIRAppendOp(bodyIR, op)
    # wall92 根修 (wall28 桥 bind 漏网第三座桥): scalar->str 桥的托管 str
    # 产物槽此前只有 sret writer, 无 def 戳无槽 proof —— identity 槽循环
    # `slot row=N has partial authority` 判词。与 wall28 StrAdd/Fmt join
    # 兄弟桥同一 binder 契约: 物化 call 挂 Fmt 节点的 ManagedTemporary
    # 权威行 (发射细节槽无独立 transport 行, Fmt 行是该桥产物的唯一语义
    # 权威), 落 call/op 全列 OwnMove 戳 + BodyIRBindLocalSlotTypeArenaProof。
    # 消费闭合走既有 wall35 权威道: 本产物作为 join piece 进 seq 时,
    # PrimaryBodyIrAppendSeqStrAddValueSlot 的 LastManagedOwnMoveDefOpIndex
    # ForSlot 回扫即命中本 def, BindIntrinsicSourceConsume 接线。
    PrimaryBodyIrBindManagedBridgeResultDefinition(
        bodyIR,
        lowering,
        transport,
        fmtNodeIndex,
        bodyIR.callSequence.len - 1,
        scalarBridgeOpIndex)
    callOrdinal = callOrdinal + 1
    return true

@borrows
fn PrimaryBodyIrAppendFmtExprValueSlot(bodyIR: var coreir.BodyIR,
                                        slotNames: var str[],
                                        lowering: lower.LoweringPlanStub,
                                        transport: lower.LoweringOwnershipTransportSoA,
                                        fmtNodeIndex: int32,
                                        targetSlot: int32,
                                        seqSlot: int32,
                                        valueSlot: int32,
                                        pieceIndex: int32,
                                        callOrdinal: var int32): bool =
    if valueSlot < 0 ||
       valueSlot >= bodyIR.localSlots.len:
        return false
    var valueTypeKind = PrimaryBodyIrSlotType(bodyIR, valueSlot)
    if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[valueSlot]):
        # var 形参槽存的是目的地址：先经地址物化值再进 fmt 拼接
        #（与 NodeEvalStore/var-str-assign 同款 FieldLoad/IndexedLoad 协议）。
        var fmtVarPointeeKind = PrimaryBodyIrVarParamPointeeKind(bodyIR, valueSlot)
        if fmtVarPointeeKind == coreir.LocalInvalidTag &&
           valueTypeKind == coreir.LocalAggregateTag &&
           bodyIR.localSlots[valueSlot].auxValue == coreir.LocalStrTag:
            fmtVarPointeeKind = coreir.LocalStrTag
        if fmtVarPointeeKind == coreir.LocalInvalidTag &&
           valueTypeKind == coreir.LocalStrTag:
            # 普通 str 形参槽同样存地址（NodeEvalStore 同款约定）：
            # 直接拼接会把地址槽当 str 头，必须先物化。
            fmtVarPointeeKind = coreir.LocalStrTag
        if fmtVarPointeeKind == coreir.LocalStrTag:
            let fmtVarStrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                              slotNames,
                                                              Fmt"{bodyIR.localSlots[targetSlot].name}#fmt_var_str#{pieceIndex}",
                                                              coreir.LocalStrTag)
            if fmtVarStrSlot < 0:
                return false
            var fmtVarStrLoadOp: coreir.BodyOp
            fmtVarStrLoadOp.kind = coreir.BodyOpFieldLoadTag
            fmtVarStrLoadOp.target = fmtVarStrSlot
            add(fmtVarStrLoadOp.operands, valueSlot)
            add(fmtVarStrLoadOp.operands, fmtVarStrSlot)
            add(fmtVarStrLoadOp.operands, 0)
            add(fmtVarStrLoadOp.operands, 24)
            let _ = coreir.BodyIRAppendOp(bodyIR, fmtVarStrLoadOp)
            valueSlot = fmtVarStrSlot
            valueTypeKind = coreir.LocalStrTag
        elif fmtVarPointeeKind == coreir.LocalI32Tag ||
             fmtVarPointeeKind == coreir.LocalI64Tag:
            let fmtVarScalarSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                 slotNames,
                                                                 Fmt"{bodyIR.localSlots[targetSlot].name}#fmt_var_scalar#{pieceIndex}",
                                                                 fmtVarPointeeKind)
            if fmtVarScalarSlot < 0:
                return false
            PrimaryBodyIrAppendVarI32Load(bodyIR, valueSlot, fmtVarScalarSlot)
            valueSlot = fmtVarScalarSlot
            valueTypeKind = fmtVarPointeeKind
    if valueTypeKind == coreir.LocalStrTag:
        return PrimaryBodyIrAppendFmtPieceSlot(bodyIR,
                                               slotNames,
                                               targetSlot,
                                               seqSlot,
                                               valueSlot,
                                               callOrdinal)
    if valueTypeKind == coreir.LocalI32Tag ||
       valueTypeKind == coreir.LocalI64Tag:
        let exprStrSlotName = strutil.Join([strings.CloneStr(bodyIR.localSlots[targetSlot].name),
                                            "#fmt_expr_scalar#",
                                            IntToStr(pieceIndex)], "")
        let exprStrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                        slotNames,
                                                        exprStrSlotName,
                                                        coreir.LocalStrTag)
        if exprStrSlot < 0 ||
           !PrimaryBodyIrAppendScalarToStrBridge(bodyIR,
                                                 slotNames,
                                                 lowering,
                                                 transport,
                                                 fmtNodeIndex,
                                                 valueSlot,
                                                 valueTypeKind,
                                                 exprStrSlot,
                                                 callOrdinal):
            return false
        return PrimaryBodyIrAppendFmtPieceSlot(bodyIR,
                                               slotNames,
                                               targetSlot,
                                               seqSlot,
                                               exprStrSlot,
                                               callOrdinal)
    return false

@borrows
fn PrimaryBodyIrAppendStrTernaryDeclValue(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           varI32ParamNames: str[],
                                           lowering: var lower.LoweringPlanStub,
                                           typedFn: texpr.TypedExprIrFunction,
                                           irFunction: lower.PrimaryObjectIrFunction,
                                           stmt: lower.PrimaryObjectIrStatement,
                                           ternaryNodeIndex: int32,
                                           rhsText: str,
                                           targetSlot: int32,
                                           callOrdinal: var int32,
                                           currentBlockStart: var int32): bool =
    if ternaryNodeIndex < 0 ||
       ternaryNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
       lowering.typedIr.nodes2_opKinds[ternaryNodeIndex] !=
           texpr.TypedExprIrOpLocalBoolEnumTernary:
        let panicMsg = Fmt"primary: str ternary lacks canonical ternary row statement={stmt.statementIndex} node={ternaryNodeIndex}"
        panic(panicMsg)
    let strTernCondNodeIndex = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_operand0NodeIndexs,
        ternaryNodeIndex)
    let strTernThenNodeIndex = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_operand1NodeIndexs,
        ternaryNodeIndex)
    let strTernElseNodeIndex = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_operand2NodeIndexs,
        ternaryNodeIndex)
    if strTernCondNodeIndex < 0 ||
       strTernCondNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
       strTernThenNodeIndex < 0 ||
       strTernThenNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
       strTernElseNodeIndex < 0 ||
       strTernElseNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        let panicMsg = Fmt"primary: str ternary children invalid statement={stmt.statementIndex} node={ternaryNodeIndex} cond={strTernCondNodeIndex} then={strTernThenNodeIndex} else={strTernElseNodeIndex}"
        panic(panicMsg)
    # str 三元 decl：let s = cond ? "a" : "b"（臂为字面量或已有 str 槽），
    # 分支式实现；不支持的臂形态显式 InvalidOp 后返回 true（已消费，不再回落）。
    # ?/: 顶层切分必须 quote-aware：臂字面量本身可能含字面 `:` 字符（如
    # IPv6 "::1"、URL "http://..."），非 quote-aware 版本会把顶层扫描
    # 停在字符串内部的 `:` 上，切错 then/else 边界，误判为不支持形态。
    let strTernQPos = texpr.TypedExprFindTopLevelTextTokenStringAware(rhsText, "?")
    let strTernTailLen = len(rhsText) - strTernQPos - 1
    if strTernTailLen > 0:
        let strTernTail = strings.SliceBytes(rhsText, strTernQPos + 1, strTernTailLen)
        let strTernColonRel = texpr.TypedExprFindTopLevelTextTokenStringAware(strTernTail, ":")
        if strTernColonRel >= 0:
            let strTernCond = strutil.Strip(strings.SliceBytes(rhsText, 0, strTernQPos))
            let strTernThen = strutil.Strip(strings.SliceBytes(strTernTail, 0, strTernColonRel))
            let strTernElse = strutil.Strip(strings.SliceBytes(strTernTail,
                                                               strTernColonRel + 1,
                                                               len(strTernTail) - strTernColonRel - 1))
            var strTernThenSlot = -1
            var strTernThenIsCall = false
            var strTernThenOk = PrimaryBodyIrTextIsStringLiteral(strTernThen)
            if !strTernThenOk:
                strTernThenSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, strTernThen)
                if strTernThenSlot >= 0 &&
                   PrimaryBodyIrSlotType(bodyIR, strTernThenSlot) == coreir.LocalStrTag:
                    strTernThenOk = true
            # BACKFILL-2/T25C 关联根修 (main-repo 独立缺口, 由 T25C Gap① 的 fact
            # 抑制暴露): 臂为真调用面 (如 `sayA()`)——既非字面量也非既有 str 槽,
            # 此前直接落 805 让 targetSlot 维持未写状态。走真分支下 whole-call
            # 机器物化 (与标量三元 AppendScalarTernaryArmValue 的整调用臂处理
            # 同款), 而非误诊断成"不支持形态"。此前这条形态从未被真正触达: T25C
            # 之前, 前端的 leftmost-column fact 启发式会先行(错误地)把三元
            # RHS 提升成无条件 LetCall, 这个函数对 str 调用臂根本没机会运行;
            # Gap① 把整条 RHS 正确让位给这里之后, 才第一次真正暴露这个此前
            # 从未验证过的分支——按 poison-on-miss 纪律补全, 不是新增特判。
            if !strTernThenOk && PrimaryBodyIrTextHasRealCallSurface(strTernThen):
                strTernThenIsCall = true
                strTernThenOk = true
            var strTernElseSlot = -1
            var strTernElseIsCall = false
            var strTernElseOk = PrimaryBodyIrTextIsStringLiteral(strTernElse)
            if !strTernElseOk:
                strTernElseSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, strTernElse)
                if strTernElseSlot >= 0 &&
                   PrimaryBodyIrSlotType(bodyIR, strTernElseSlot) == coreir.LocalStrTag:
                    strTernElseOk = true
            if !strTernElseOk && PrimaryBodyIrTextHasRealCallSurface(strTernElse):
                strTernElseIsCall = true
                strTernElseOk = true
            # 嵌套三元 else 臂（右结合 `a ? x : (b ? y : z)`）：递归发子三元写同一
            # targetSlot，下方 else 块走递归路径。先放行守卫，避免误落 805。
            let strTernElseInner = PrimaryBodyIrStripOuterParens(strTernElse)
            let strTernElseIsNested = texpr.TypedExprFindTopLevelTextTokenStringAware(strTernElseInner, "?") > 0
            if strTernElseIsNested:
                strTernElseOk = true
            if strTernCond == "" || !strTernThenOk || !strTernElseOk:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             805,
                                             0)
                return true
            var strTernNextOpIndex: int32
            # 806 修复：str-ternary 条件含 `&&`/`||` 时走节点求值短路链
            # (EmitConditionCbrChain，递归 split `&&`/`||` + 真 cbr 短路 +
            # currentBlockStart 上下文)，而非 EmitConditionOps text-side
            # (无 currentBlockStart，遇 `&&`/`||` bail 806)。链路即
            # AppendBoolConditionAssign 处理 `bool v = a && b` 的同款已验证基建，
            # 1:1 复刻 `a && b ? x : y` 的短路求值；叶节点仍走 EmitConditionOps。
            var strTernCondHasConnector = PrimaryBodyIrConditionHasAnd(strTernCond) ||
                                          PrimaryBodyIrConditionHasOr(strTernCond)
            if strTernCondHasConnector:
                let strTernCondBlockCount = PrimaryBodyIrConditionCbrBlockCount(strTernCond)
                if strTernCondBlockCount <= 0:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 806,
                                                 0)
                    return true
                let strTernChainSuccessBlock = bodyIR.blocks.len + strTernCondBlockCount
                let strTernChainFailureBlock = strTernChainSuccessBlock + 1
                var strTernPendingFailureTerms: int32[]
                if !PrimaryBodyIrEmitConditionCbrChain(bodyIR,
                                                       slotNames,
                                                       lowering,

                                                       typedFn,
                                                       irFunction,
                                                       stmt.sourcePath,
                                                       stmt.lineNumber,
                                                       strTernCond,
                                                       strTernChainSuccessBlock,
                                                       strTernChainFailureBlock,
                                                       callOrdinal,
                                                       strTernNextOpIndex,
                                                       currentBlockStart,
                                                       strTernPendingFailureTerms):
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 806,
                                                 0)
                    return true
            else:
                var strTernCmpLhs: int32
                var strTernCmpRhs: int32
                var strTernCmpTag: int32
                if !PrimaryBodyIrEmitConditionOps(bodyIR,
                                                  slotNames,
                                                  lowering,

                                                  typedFn,
                                                  irFunction,
                                                  stmt.sourcePath,
                                                  stmt.lineNumber,
                                                  strTernCondNodeIndex,
                                                  strTernCond,
                                                  strTernCmpLhs,
                                                  strTernCmpRhs,
                                                  strTernCmpTag,
                                                  callOrdinal,
                                                  strTernNextOpIndex):
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 806,
                                                 0)
                    return true
                let strTernCbrBlock = bodyIR.blocks.len
                var strTernCbr: coreir.BodyTerm
                strTernCbr.kind = coreir.BodyTermCbrTag
                strTernCbr.conditionKind = strTernCmpTag
                strTernCbr.lhsSlot = strTernCmpLhs
                strTernCbr.rhsSlot = strTernCmpRhs
                strTernCbr.resultSlot = -1
                strTernCbr.trueBlock = strTernCbrBlock + 1
                strTernCbr.falseBlock = strTernCbrBlock + 2
                let strTernCbrIdx = coreir.BodyIRAppendTerm(bodyIR, strTernCbr)
                let strTernCbrOpCount = bodyIR.ops.len - currentBlockStart
                let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, strTernCbrOpCount, strTernCbrIdx)
                currentBlockStart = bodyIR.ops.len
            if PrimaryBodyIrTextIsStringLiteral(strTernThen):
                # [wall107b] 物化 call 的 def 发布补全（wall33 EvalNode StrLit
                # 臂逐字同型，同 call-arg 实参臂 [wall107b] 注记）：非空载荷
                # 物化后按 then 子节点 ManagedTemporary 权威行落 wall28
                # binder 全列戳；节点列已在函数入口验证界内，非 StrLit 即
                # panic fail-closed。
                let strTernThenPayloadEmpty =
                    len(PrimaryBodyIrStringLiteralPayload(strTernThen)) == 0
                if !PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                          slotNames,
                                                          strTernThen,
                                                          targetSlot,
                                                          callOrdinal):
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 807,
                                                 0)
                    return true
                if !strTernThenPayloadEmpty:
                    if lowering.typedIr.nodes2_opKinds[strTernThenNodeIndex] !=
                           texpr.TypedExprIrOpStrLit:
                        let panicMsg = Fmt"primary: str ternary then literal lacks exact TypedExpr StrLit authority statement={stmt.statementIndex} node={strTernThenNodeIndex}"
                        panic(panicMsg)
                    PrimaryBodyIrBindManagedBridgeResultDefinition(
                        bodyIR,
                        lowering,
                        irFunction.ownershipTransport,
                        strTernThenNodeIndex,
                        bodyIR.callSequence.len - 1,
                        bodyIR.ops.len - 1)
            elif strTernThenIsCall:
                if !PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                           slotNames,
                                                           lowering,

                                                           typedFn,
                                                           irFunction,
                                                           varI32ParamNames,
                                                           strTernThen,
                                                           targetSlot,
                                                           stmt.lineNumber,
                                                           strTernThenNodeIndex,
                                                           callOrdinal):
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 807,
                                                 0)
                    return true
            else:
                var strTernThenCopy: coreir.BodyOp
                strTernThenCopy.kind = coreir.BodyOpCopyLocalTag
                strTernThenCopy.target = targetSlot
                add(strTernThenCopy.operands, strTernThenSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, strTernThenCopy)
            var strTernThenBr: coreir.BodyTerm
            strTernThenBr.kind = coreir.BodyTermBrTag
            strTernThenBr.conditionKind = coreir.BodyCondInvalidTag
            strTernThenBr.lhsSlot = -1
            strTernThenBr.rhsSlot = -1
            strTernThenBr.resultSlot = -1
            strTernThenBr.trueBlock = -1
            strTernThenBr.falseBlock = -1
            let strTernThenBrIdx = coreir.BodyIRAppendTerm(bodyIR, strTernThenBr)
            let strTernThenOpCount = bodyIR.ops.len - currentBlockStart
            let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, strTernThenOpCount, strTernThenBrIdx)
            currentBlockStart = bodyIR.ops.len
            if strTernElseIsNested:
                # 嵌套 else：递归发子三元写同一 targetSlot。子调用的 cbr 块天然接续本层
                # else 区(本层 cbr=N、then=N+1、子 cbr=N+2，正是外层 cbr.falseBlock=N+2)，
                # 子帧内回填子树 then/else-Br 到子 join；返回后本层 then-Br 回填到同一最终
                # join(=blocks.len)。本层不再单独发 else-Br，子 else 流已由子 else-Br 终结。
                if !PrimaryBodyIrAppendStrTernaryDeclValue(bodyIR,
                                                           slotNames,
                                                           varI32ParamNames,
                                                           lowering,

                                                           typedFn,
                                                           irFunction,
                                                           stmt,
                                                           strTernElseNodeIndex,
                                                           strTernElseInner,
                                                           targetSlot,
                                                           callOrdinal,
                                                           currentBlockStart):
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 809,
                                                 0)
                    return true
                PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, strTernThenBrIdx)
                bodyIR.terms[strTernThenBrIdx].trueBlock = bodyIR.blocks.len
                return true
            if PrimaryBodyIrTextIsStringLiteral(strTernElse):
                # [wall107b] 物化 call 的 def 发布补全（wall33 EvalNode StrLit
                # 臂逐字同型，同 call-arg 实参臂 [wall107b] 注记）：非空载荷
                # 物化后按 else 子节点 ManagedTemporary 权威行落 wall28
                # binder 全列戳；节点列已在函数入口验证界内，非 StrLit 即
                # panic fail-closed。
                let strTernElsePayloadEmpty =
                    len(PrimaryBodyIrStringLiteralPayload(strTernElse)) == 0
                if !PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                          slotNames,
                                                          strTernElse,
                                                          targetSlot,
                                                          callOrdinal):
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 808,
                                                 0)
                    return true
                if !strTernElsePayloadEmpty:
                    if lowering.typedIr.nodes2_opKinds[strTernElseNodeIndex] !=
                           texpr.TypedExprIrOpStrLit:
                        let panicMsg = Fmt"primary: str ternary else literal lacks exact TypedExpr StrLit authority statement={stmt.statementIndex} node={strTernElseNodeIndex}"
                        panic(panicMsg)
                    PrimaryBodyIrBindManagedBridgeResultDefinition(
                        bodyIR,
                        lowering,
                        irFunction.ownershipTransport,
                        strTernElseNodeIndex,
                        bodyIR.callSequence.len - 1,
                        bodyIR.ops.len - 1)
            elif strTernElseIsCall:
                if !PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                           slotNames,
                                                           lowering,

                                                           typedFn,
                                                           irFunction,
                                                           varI32ParamNames,
                                                           strTernElse,
                                                           targetSlot,
                                                           stmt.lineNumber,
                                                           strTernElseNodeIndex,
                                                           callOrdinal):
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 808,
                                                 0)
                    return true
            else:
                var strTernElseCopy: coreir.BodyOp
                strTernElseCopy.kind = coreir.BodyOpCopyLocalTag
                strTernElseCopy.target = targetSlot
                add(strTernElseCopy.operands, strTernElseSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, strTernElseCopy)
            var strTernElseBr: coreir.BodyTerm
            strTernElseBr.kind = coreir.BodyTermBrTag
            strTernElseBr.conditionKind = coreir.BodyCondInvalidTag
            strTernElseBr.lhsSlot = -1
            strTernElseBr.rhsSlot = -1
            strTernElseBr.resultSlot = -1
            strTernElseBr.trueBlock = -1
            strTernElseBr.falseBlock = -1
            let strTernElseBrIdx = coreir.BodyIRAppendTerm(bodyIR, strTernElseBr)
            let strTernElseOpCount = bodyIR.ops.len - currentBlockStart
            let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, strTernElseOpCount, strTernElseBrIdx)
            currentBlockStart = bodyIR.ops.len
            PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, strTernThenBrIdx)
            bodyIR.terms[strTernThenBrIdx].trueBlock = bodyIR.blocks.len
            PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, strTernElseBrIdx)
            bodyIR.terms[strTernElseBrIdx].trueBlock = bodyIR.blocks.len
            return true
    return false

# 标量三元臂求值：把 armText 求值写入 targetSlot（i32/i64/f64）。臂可为
#   - 嵌套三元 → 递归发射真分支；
#   - 整调用 cond ? f() : g() → 经 whole-call 机器发射（调用只在被选中块内执行）；
#   - 无调用标量臂 → 经标量值解析槽求值后拷入 targetSlot（无副作用，安全）。
# 任何含调用但非整调用/非三元的臂形态不支持（返回 false，上游落 InvalidOp）——
# 绝不在此回落到急切无分支算术（那正是本批要根除的 miscompile）。
@borrows
fn PrimaryBodyIrAppendScalarTernaryArmValue(bodyIR: var coreir.BodyIR,
                                             slotNames: var str[],
                                             varI32ParamNames: str[],
                                             lowering: var lower.LoweringPlanStub,
                                             typedFn: texpr.TypedExprIrFunction,
                                             irFunction: lower.PrimaryObjectIrFunction,
                                             sourcePath: str,
                                             lineNumber: int32,
                                             armNodeIndex: int32,
                                             armTextRaw: str,
                                             targetSlot: int32,
                                             typeKind: int32,
                                             callOrdinal: var int32,
                                             currentBlockStart: var int32): bool =
    let armText = PrimaryBodyIrStripOuterParens(armTextRaw)
    if armText == "":
        return false
    if armNodeIndex < 0 ||
       armNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        let panicMsg = Fmt"primary: scalar ternary arm lacks canonical TypedExpr row line={lineNumber} node={armNodeIndex}"
        panic(panicMsg)
    # 顶层二元算术分解(call/ternary 活值跨调用安全)：`A <op> B` 的某一臂含真调用
    # /三元时，两臂各自递归求值进**独立命名栈槽**(slot 即栈槽，天然跨调用 spill/
    # reload)，再发 BinOp 入 targetSlot。被选中三元臂的调用只在其块内执行、用栈槽
    # 承载已算出的另一操作数，根除"内联三元-调用相加只返回左操作数"miscompile。
    # 无真调用的纯算术不在此分解(下游无分支标量快路径仍正确且更省)。
    if (typeKind == coreir.LocalI32Tag ||
        typeKind == coreir.LocalI64Tag ||
        typeKind == coreir.LocalF64Tag) &&
       PrimaryBodyIrTextHasRealCallSurface(armText):
        var armBinPos: int32 = -1
        var armBinKind: int32
        var armBinOpLen: int32
        armBinOpLen = 1
        let armBitOrPos = texpr.TypedExprFindTopLevelBitwiseTextToken(armText, "|")
        let armBitXorPos = texpr.TypedExprFindTopLevelBitwiseTextToken(armText, "^")
        let armBitAndPos = texpr.TypedExprFindTopLevelBitwiseTextToken(armText, "&")
        let armAddPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(armText, '+')
        let armSubPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(armText, '-')
        let armMulPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(armText, '*')
        let armDivPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(armText, '/')
        let armModPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(armText, '%')
        if typeKind == coreir.LocalF64Tag:
            if armAddPos > 0 || armSubPos > 0:
                if armAddPos > armSubPos:
                    armBinPos = armAddPos
                    armBinKind = int32(texpr.TypedExprIrOpF64Add)
                else:
                    armBinPos = armSubPos
                    armBinKind = int32(texpr.TypedExprIrOpF64Sub)
            elif armMulPos > 0 || armDivPos > 0:
                if armMulPos > armDivPos:
                    armBinPos = armMulPos
                    armBinKind = int32(texpr.TypedExprIrOpF64Mul)
                else:
                    armBinPos = armDivPos
                    armBinKind = int32(texpr.TypedExprIrOpF64Div)
        elif armBitOrPos > 0:
            armBinPos = armBitOrPos
            armBinKind = int32(texpr.TypedExprIrOpI32BitOr)
        elif armBitXorPos > 0:
            armBinPos = armBitXorPos
            armBinKind = int32(texpr.TypedExprIrOpI32BitXor)
        elif armBitAndPos > 0:
            armBinPos = armBitAndPos
            armBinKind = int32(texpr.TypedExprIrOpI32BitAnd)
        elif armAddPos > 0 || armSubPos > 0:
            if armAddPos > armSubPos:
                armBinPos = armAddPos
                armBinKind = int32(texpr.TypedExprIrOpI32Add)
            else:
                armBinPos = armSubPos
                armBinKind = int32(texpr.TypedExprIrOpI32Sub)
        elif armMulPos > 0 || armDivPos > 0 || armModPos > 0:
            armBinPos = armMulPos
            armBinKind = int32(texpr.TypedExprIrOpI32Mul)
            if armDivPos > armBinPos:
                armBinPos = armDivPos
                armBinKind = int32(texpr.TypedExprIrOpI32Sdiv)
            if armModPos > armBinPos:
                armBinPos = armModPos
                armBinKind = -100
        if armBinPos > 0 && armBinPos + armBinOpLen < len(armText):
            var armExpectedOpKind = armBinKind
            if armExpectedOpKind == -100:
                armExpectedOpKind = int32(texpr.TypedExprIrOpI32Mod)
            if lowering.typedIr.nodes2_opKinds[armNodeIndex] != armExpectedOpKind:
                let panicMsg = Fmt"primary: scalar ternary arm binary text/node mismatch line={lineNumber} node={armNodeIndex} expected={armExpectedOpKind} actual={lowering.typedIr.nodes2_opKinds[armNodeIndex]}"
                panic(panicMsg)
            let armLhsNodeIndex = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_operand0NodeIndexs,
                armNodeIndex)
            let armRhsNodeIndex = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_operand1NodeIndexs,
                armNodeIndex)
            if armLhsNodeIndex < 0 ||
               armLhsNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
               armRhsNodeIndex < 0 ||
               armRhsNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
                let panicMsg = Fmt"primary: scalar ternary arm binary children invalid line={lineNumber} node={armNodeIndex} lhs={armLhsNodeIndex} rhs={armRhsNodeIndex}"
                panic(panicMsg)
            let armLhsText = strutil.Strip(strings.SliceBytes(armText, 0, armBinPos))
            let armRhsText = strutil.Strip(strings.SliceBytes(armText,
                                                              armBinPos + armBinOpLen,
                                                              len(armText) - armBinPos - armBinOpLen))
            if armLhsText == "" || armRhsText == "":
                return false
            let armLhsSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"{armText}#bin_lhs#{lineNumber}",
                                                           typeKind)
            let armRhsSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"{armText}#bin_rhs#{lineNumber}",
                                                           typeKind)
            if armLhsSlot < 0 || armRhsSlot < 0:
                return false
            if !PrimaryBodyIrAppendScalarTernaryArmValue(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         lowering,

                                                         typedFn,
                                                         irFunction,
                                                         sourcePath,
                                                         lineNumber,
                                                         armLhsNodeIndex,
                                                         armLhsText,
                                                         armLhsSlot,
                                                         typeKind,
                                                         callOrdinal,
                                                         currentBlockStart):
                return false
            if !PrimaryBodyIrAppendScalarTernaryArmValue(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         lowering,

                                                         typedFn,
                                                         irFunction,
                                                         sourcePath,
                                                         lineNumber,
                                                         armRhsNodeIndex,
                                                         armRhsText,
                                                         armRhsSlot,
                                                         typeKind,
                                                         callOrdinal,
                                                         currentBlockStart):
                return false
            if armBinKind == -100:
                let armQuotientSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                    slotNames,
                                                                    Fmt"{armText}#bin_quot#{lineNumber}",
                                                                    typeKind)
                let armProductSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                   slotNames,
                                                                   Fmt"{armText}#bin_prod#{lineNumber}",
                                                                   typeKind)
                if armQuotientSlot < 0 || armProductSlot < 0:
                    return false
                var armDivOp: coreir.BodyOp
                armDivOp.kind = coreir.BodyOpBinOpTag
                armDivOp.target = armQuotientSlot
                add(armDivOp.operands, typeKind)
                add(armDivOp.operands, int32(texpr.TypedExprIrOpI32Sdiv))
                add(armDivOp.operands, armLhsSlot)
                add(armDivOp.operands, armRhsSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, armDivOp)
                var armMulOp: coreir.BodyOp
                armMulOp.kind = coreir.BodyOpBinOpTag
                armMulOp.target = armProductSlot
                add(armMulOp.operands, typeKind)
                add(armMulOp.operands, int32(texpr.TypedExprIrOpI32Mul))
                add(armMulOp.operands, armQuotientSlot)
                add(armMulOp.operands, armRhsSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, armMulOp)
                var armRemOp: coreir.BodyOp
                armRemOp.kind = coreir.BodyOpBinOpTag
                armRemOp.target = targetSlot
                add(armRemOp.operands, typeKind)
                add(armRemOp.operands, int32(texpr.TypedExprIrOpI32Sub))
                add(armRemOp.operands, armLhsSlot)
                add(armRemOp.operands, armProductSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, armRemOp)
                return true
            var armBinOp: coreir.BodyOp
            armBinOp.kind = coreir.BodyOpBinOpTag
            armBinOp.target = targetSlot
            add(armBinOp.operands, typeKind)
            add(armBinOp.operands, armBinKind)
            add(armBinOp.operands, armLhsSlot)
            add(armBinOp.operands, armRhsSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, armBinOp)
            return true
    if texpr.TypedExprFindTopLevelTextToken(armText, "?") > 0:
        return PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          sourcePath,
                                                          lineNumber,
                                                          armNodeIndex,
                                                          armText,
                                                          targetSlot,
                                                          typeKind,
                                                          callOrdinal,
                                                          currentBlockStart)
    if PrimaryBodyIrTextHasRealCallSurface(armText):
        return PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                      slotNames,
                                                      lowering,

                                                      typedFn,
                                                      irFunction,
                                                      varI32ParamNames,
                                                      armText,
                                                      targetSlot,
                                                      lineNumber,
                                                      armNodeIndex,
                                                      callOrdinal)
    let armSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      lowering.typedIr,
                                                      sourcePath,
                                                      armText,
                                                      typeKind,
                                                      callOrdinal)
    if armSlot < 0:
        return false
    if armSlot != targetSlot:
        var armCopy: coreir.BodyOp
        armCopy.kind = coreir.BodyOpCopyLocalTag
        armCopy.target = targetSlot
        add(armCopy.operands, armSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, armCopy)
    return true

# 标量三元真分支下降：`cond ? then : else`(i32/i64)经 cbr 把 then/else 各自块
# 内的求值写入 targetSlot 后 br 到 join 块。仅被选中臂执行——根除"急切求值两臂"
# miscompile（被选中臂含调用时另一臂的调用不再无条件执行/冲掉 cond 槽）。
# 形态与 str 三元(PrimaryBodyIrAppendStrTernaryDeclValue)精确对齐的真分支路径。
# 返回 false 表示非三元/不支持的臂形态（未发射任何块），调用方继续别的处理。
@borrows
fn PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR: var coreir.BodyIR,
                                              slotNames: var str[],
                                              varI32ParamNames: str[],
                                              lowering: var lower.LoweringPlanStub,
                                              typedFn: texpr.TypedExprIrFunction,
                                              irFunction: lower.PrimaryObjectIrFunction,
                                              sourcePath: str,
                                              lineNumber: int32,
                                              ternaryNodeIndex: int32,
                                              exprTextRaw: str,
                                              targetSlot: int32,
                                              typeKind: int32,
                                              callOrdinal: var int32,
                                              currentBlockStart: var int32): bool =
    if typeKind != coreir.LocalI32Tag &&
       typeKind != coreir.LocalI64Tag &&
       typeKind != coreir.LocalF64Tag:
        return false
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        return false
    let exprText = PrimaryBodyIrStripOuterParens(exprTextRaw)
    let qPos = texpr.TypedExprFindTopLevelTextToken(exprText, "?")
    if qPos <= 0 || qPos + 1 >= len(exprText):
        return false
    let tail = strings.SliceBytes(exprText, qPos + 1, len(exprText) - qPos - 1)
    let colonRel = texpr.TypedExprFindTopLevelTextToken(tail, ":")
    if colonRel <= 0:
        return false
    let condText = strutil.Strip(strings.SliceBytes(exprText, 0, qPos))
    let thenText = strutil.Strip(strings.SliceBytes(tail, 0, colonRel))
    let elseText = strutil.Strip(strings.SliceBytes(tail, colonRel + 1, len(tail) - colonRel - 1))
    if condText == "" || thenText == "" || elseText == "":
        return false
    var cmpLhs: int32
    var cmpRhs: int32
    var cmpTag: int32
    var condNextOpIndex: int32
    if ternaryNodeIndex < 0 ||
       ternaryNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
       lowering.typedIr.nodes2_opKinds[ternaryNodeIndex] !=
           texpr.TypedExprIrOpLocalBoolEnumTernary:
        let panicMsg = Fmt"primary: scalar ternary lacks canonical ternary row line={lineNumber} node={ternaryNodeIndex}"
        panic(panicMsg)
    let condNodeIndex = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_operand0NodeIndexs,
        ternaryNodeIndex)
    let thenNodeIndex = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_operand1NodeIndexs,
        ternaryNodeIndex)
    let elseNodeIndex = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_operand2NodeIndexs,
        ternaryNodeIndex)
    if condNodeIndex < 0 ||
       condNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
       thenNodeIndex < 0 ||
       thenNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
       elseNodeIndex < 0 ||
       elseNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        let panicMsg = Fmt"primary: scalar ternary children invalid line={lineNumber} node={ternaryNodeIndex} cond={condNodeIndex} then={thenNodeIndex} else={elseNodeIndex}"
        panic(panicMsg)
    if !PrimaryBodyIrEmitConditionOps(bodyIR,
                                      slotNames,
                                      lowering,

                                      typedFn,
                                      irFunction,
                                      sourcePath,
                                      lineNumber,
                                      condNodeIndex,
                                      condText,
                                      cmpLhs,
                                      cmpRhs,
                                      cmpTag,
                                      callOrdinal,
                                      condNextOpIndex):
        return false
    let cbrBlock = bodyIR.blocks.len
    var cbr: coreir.BodyTerm
    cbr.kind = coreir.BodyTermCbrTag
    cbr.conditionKind = cmpTag
    cbr.lhsSlot = cmpLhs
    cbr.rhsSlot = cmpRhs
    cbr.resultSlot = -1
    cbr.trueBlock = cbrBlock + 1
    cbr.falseBlock = cbrBlock + 2
    let cbrIdx = coreir.BodyIRAppendTerm(bodyIR, cbr)
    let cbrOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, cbrOpCount, cbrIdx)
    currentBlockStart = bodyIR.ops.len
    # then 块：仅当 cond 真时执行，臂的调用/副作用只在此发射。
    if !PrimaryBodyIrAppendScalarTernaryArmValue(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering,

                                                 typedFn,
                                                 irFunction,
                                                 sourcePath,
                                                 lineNumber,
                                                 thenNodeIndex,
                                                 thenText,
                                                 targetSlot,
                                                 typeKind,
                                                 callOrdinal,
                                                 currentBlockStart):
        PrimaryBodyIrAppendInvalidOp(bodyIR, lineNumber, 0, 815, 0)
        return true
    var thenBr: coreir.BodyTerm
    thenBr.kind = coreir.BodyTermBrTag
    thenBr.conditionKind = coreir.BodyCondInvalidTag
    thenBr.lhsSlot = -1
    thenBr.rhsSlot = -1
    thenBr.resultSlot = -1
    thenBr.trueBlock = cbrBlock + 3
    thenBr.falseBlock = -1
    let thenBrIdx = coreir.BodyIRAppendTerm(bodyIR, thenBr)
    let thenOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, thenOpCount, thenBrIdx)
    currentBlockStart = bodyIR.ops.len
    # else 块：仅当 cond 假时执行。
    if !PrimaryBodyIrAppendScalarTernaryArmValue(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering,

                                                 typedFn,
                                                 irFunction,
                                                 sourcePath,
                                                 lineNumber,
                                                 elseNodeIndex,
                                                 elseText,
                                                 targetSlot,
                                                 typeKind,
                                                 callOrdinal,
                                                 currentBlockStart):
        PrimaryBodyIrAppendInvalidOp(bodyIR, lineNumber, 0, 816, 0)
        return true
    var elseBr: coreir.BodyTerm
    elseBr.kind = coreir.BodyTermBrTag
    elseBr.conditionKind = coreir.BodyCondInvalidTag
    elseBr.lhsSlot = -1
    elseBr.rhsSlot = -1
    elseBr.resultSlot = -1
    elseBr.trueBlock = cbrBlock + 3
    elseBr.falseBlock = -1
    let elseBrIdx = coreir.BodyIRAppendTerm(bodyIR, elseBr)
    let elseOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, elseOpCount, elseBrIdx)
    currentBlockStart = bodyIR.ops.len
    return true

# 含调用臂的三元作为二元运算子式（如 `(n>0 ? f(n) : 0) + (n>0 ? f(n) : 0)`）在
# call-binop 文本路径下原本丢值：CallScalarValueSlotForText 对三元叶返回 -1，使整个
# RHS 被丢弃。本函数递归切分顶层二元运算，对三元叶（含或不含真调用）用 cbr 块下推到
# 临时槽（仅选中臂的调用副作用触发、结果保留），对裸调用/常量/普通槽走既有物化路径，
# 将子式槽合并为临时槽返回。currentBlockStart 由 cbr 推进，后续运算落入合并块。
@borrows
fn PrimaryBodyIrCallBinOpTernaryAwareSlot(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          varI32ParamNames: str[],
                                          lowering: var lower.LoweringPlanStub,
                                          typedFn: texpr.TypedExprIrFunction,
                                          irFunction: lower.PrimaryObjectIrFunction,
                                          sourcePath: str,
                                          lineNumber: int32,
                                          exprNodeIndex: int32,
                                          textRaw: str,
                                          typeKind: int32,
                                          callOrdinal: var int32,
                                          currentBlockStart: var int32): int32 =
    let text = PrimaryBodyIrStripOuterParens(textRaw)
    if text == "":
        return -1
    if exprNodeIndex < 0 ||
       exprNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        let panicMsg = Fmt"primary: call-binop expression lacks canonical TypedExpr row line={lineNumber} node={exprNodeIndex}"
        panic(panicMsg)
    let opsLen = bodyIR.ops.len
    if (typeKind == coreir.LocalI32Tag ||
        typeKind == coreir.LocalI64Tag ||
        typeKind == coreir.LocalF64Tag) &&
       texpr.TypedExprFindTopLevelTextToken(text, "?") > 0:
        let ternSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#tern_binop#{opsLen}",
                                                     typeKind)
        if ternSlot >= 0 &&
           PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      lowering,

                                                      typedFn,
                                                      irFunction,
                                                      sourcePath,
                                                      lineNumber,
                                                      exprNodeIndex,
                                                      text,
                                                      ternSlot,
                                                      typeKind,
                                                      callOrdinal,
                                                      currentBlockStart):
            return ternSlot
    if typeKind == coreir.LocalI32Tag ||
       typeKind == coreir.LocalI64Tag ||
       typeKind == coreir.LocalF64Tag:
        var binPos: int32 = -1
        var binKind: int32
        var binOpLen: int32 = 1
        let bitOrPos = texpr.TypedExprFindTopLevelBitwiseTextToken(text, "|")
        let bitAndPos = texpr.TypedExprFindTopLevelBitwiseTextToken(text, "&")
        let addPos = texpr.TypedExprFindTopLevelTextToken(text, "+")
        let subPos = texpr.TypedExprFindTopLevelTextToken(text, "-")
        let mulPos = texpr.TypedExprFindTopLevelTextToken(text, "*")
        let divPos = texpr.TypedExprFindTopLevelTextToken(text, "/")
        let modPos = texpr.TypedExprFindTopLevelTextToken(text, "%")
        let shrPos = texpr.TypedExprFindTopLevelTextToken(text, ">>")
        let shlPos = texpr.TypedExprFindTopLevelTextToken(text, "<<")
        if typeKind == coreir.LocalF64Tag:
            let f64AddPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '+')
            let f64SubPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '-')
            let f64MulPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '*')
            let f64DivPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(text, '/')
            if f64AddPos > 0 || f64SubPos > 0:
                if f64AddPos > f64SubPos:
                    binPos = f64AddPos
                    binKind = int32(texpr.TypedExprIrOpF64Add)
                else:
                    binPos = f64SubPos
                    binKind = int32(texpr.TypedExprIrOpF64Sub)
            elif f64MulPos > 0 || f64DivPos > 0:
                if f64MulPos > f64DivPos:
                    binPos = f64MulPos
                    binKind = int32(texpr.TypedExprIrOpF64Mul)
                else:
                    binPos = f64DivPos
                    binKind = int32(texpr.TypedExprIrOpF64Div)
        elif bitOrPos > 0:
            binPos = bitOrPos
            binKind = int32(texpr.TypedExprIrOpI32BitOr)
        elif bitAndPos > 0:
            binPos = bitAndPos
            binKind = int32(texpr.TypedExprIrOpI32BitAnd)
        elif addPos > 0:
            binPos = addPos
            binKind = int32(texpr.TypedExprIrOpI32Add)
        elif subPos > 0:
            binPos = subPos
            binKind = int32(texpr.TypedExprIrOpI32Sub)
        elif mulPos > 0:
            binPos = mulPos
            binKind = int32(texpr.TypedExprIrOpI32Mul)
        elif divPos > 0:
            binPos = divPos
            binKind = int32(texpr.TypedExprIrOpI32Sdiv)
        elif modPos > 0:
            binPos = modPos
            binKind = -100
        elif shrPos > 0:
            binPos = shrPos
            binKind = int32(texpr.TypedExprIrOpI32Asr)
            binOpLen = 2
        elif shlPos > 0:
            binPos = shlPos
            binKind = int32(texpr.TypedExprIrOpI32Lsl)
            binOpLen = 2
        if binPos > 0 && binPos + binOpLen < len(text):
            let lhsText = strutil.Strip(strings.SliceBytes(text, 0, binPos))
            if typeKind != coreir.LocalF64Tag &&
               binKind == int32(texpr.TypedExprIrOpI32Asr):
                binKind = PrimaryBodyIrShiftRightOpKind(lowering.typedIr, typedFn, irFunction, lineNumber, lhsText)
            var expectedBinOpKind = binKind
            if expectedBinOpKind == -100:
                expectedBinOpKind = int32(texpr.TypedExprIrOpI32Mod)
            if lowering.typedIr.nodes2_opKinds[exprNodeIndex] != expectedBinOpKind:
                let panicMsg = Fmt"primary: call-binop text/node mismatch line={lineNumber} node={exprNodeIndex} expected={expectedBinOpKind} actual={lowering.typedIr.nodes2_opKinds[exprNodeIndex]}"
                panic(panicMsg)
            let lhsNodeIndex = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_operand0NodeIndexs,
                exprNodeIndex)
            let rhsNodeIndex = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_operand1NodeIndexs,
                exprNodeIndex)
            if lhsNodeIndex < 0 ||
               lhsNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
               rhsNodeIndex < 0 ||
               rhsNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
                let panicMsg = Fmt"primary: call-binop children invalid line={lineNumber} node={exprNodeIndex} lhs={lhsNodeIndex} rhs={rhsNodeIndex}"
                panic(panicMsg)
            let rhsText = strutil.Strip(strings.SliceBytes(text,
                                                            binPos + binOpLen,
                                                            len(text) - binPos - binOpLen))
            if lhsText == "" || rhsText == "":
                return -1
            let lhsSlot = PrimaryBodyIrCallBinOpTernaryAwareSlot(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 lowering,

                                                                 typedFn,
                                                                 irFunction,
                                                                 sourcePath,
                                                                 lineNumber,
                                                                 lhsNodeIndex,
                                                                 lhsText,
                                                                 typeKind,
                                                                 callOrdinal,
                                                                 currentBlockStart)
            let rhsSlot = PrimaryBodyIrCallBinOpTernaryAwareSlot(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 lowering,

                                                                 typedFn,
                                                                 irFunction,
                                                                 sourcePath,
                                                                 lineNumber,
                                                                 rhsNodeIndex,
                                                                 rhsText,
                                                                 typeKind,
                                                                 callOrdinal,
                                                                 currentBlockStart)
            if lhsSlot < 0 || rhsSlot < 0:
                return -1
            let binSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                        slotNames,
                                                        Fmt"#binop_tmp#{opsLen}",
                                                        typeKind)
            if binSlot < 0:
                return -1
            if binKind == -100:
                let quotSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                             slotNames,
                                                             Fmt"#binop_quot#{opsLen}",
                                                             typeKind)
                let prodSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                             slotNames,
                                                             Fmt"#binop_prod#{opsLen}",
                                                             typeKind)
                if quotSlot < 0 || prodSlot < 0:
                    return -1
                var divOp: coreir.BodyOp
                divOp.kind = coreir.BodyOpBinOpTag
                divOp.target = quotSlot
                add(divOp.operands, typeKind)
                add(divOp.operands, int32(texpr.TypedExprIrOpI32Sdiv))
                add(divOp.operands, lhsSlot)
                add(divOp.operands, rhsSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, divOp)
                var mulOp: coreir.BodyOp
                mulOp.kind = coreir.BodyOpBinOpTag
                mulOp.target = prodSlot
                add(mulOp.operands, typeKind)
                add(mulOp.operands, int32(texpr.TypedExprIrOpI32Mul))
                add(mulOp.operands, quotSlot)
                add(mulOp.operands, rhsSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, mulOp)
                var remOp: coreir.BodyOp
                remOp.kind = coreir.BodyOpBinOpTag
                remOp.target = binSlot
                add(remOp.operands, typeKind)
                add(remOp.operands, int32(texpr.TypedExprIrOpI32Sub))
                add(remOp.operands, lhsSlot)
                add(remOp.operands, prodSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, remOp)
                return binSlot
            var binOp: coreir.BodyOp
            binOp.kind = coreir.BodyOpBinOpTag
            binOp.target = binSlot
            add(binOp.operands, typeKind)
            add(binOp.operands, binKind)
            add(binOp.operands, lhsSlot)
            add(binOp.operands, rhsSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, binOp)
            return binSlot
    if !PrimaryBodyIrTextHasRealCallSurface(text):
        return PrimaryBodyIrLocalInitValueSlot(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering.typedIr,
                                               sourcePath,
                                               "",
                                               typeKind,
                                               text,
                                               callOrdinal)
    if PrimaryBodyIrTextIsBareWholeCall(text):
        let callSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#call_binop#{opsLen}",
                                                     typeKind)
        if callSlot < 0:
            return -1
        if !PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                   slotNames,
                                                   lowering,

                                                   typedFn,
                                                   irFunction,
                                                   varI32ParamNames,
                                                   text,
                                                   callSlot,
                                                   lineNumber,
                                                   exprNodeIndex,
                                                   callOrdinal):
            return -1
        return callSlot
    return PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                   slotNames,
                                                   varI32ParamNames,
                                                   lowering,

                                                   typedFn,
                                                   irFunction,
                                                   sourcePath,
                                                   lineNumber,
                                                   text,
                                                   typeKind,
                                                   callOrdinal)

# `var a: T[N] = [e0, e1, ...]` — fixed-array braced/bracket literal initializer.
# The decl slot is a LocalAggregate; the literal must lower to N element stores at
# compile-time indices 0..N-1. Without this the initializer is dropped entirely
# and the array reads stack garbage (net-audit r14 array_init_list). Each element
# reuses the proven local fixed-array element-store form: an IndexedStore with
# operands [baseSlot, valueSlot, indexSlot(const k), elemSize] — identical to the
# `a[idx] = v` store path. Element value text goes through the scalar value slot
# lowering so constant expressions (`0 - 5`, `1 + 1`, `2 * 3`) materialize.
@borrows
fn PrimaryBodyIrAppendFixedArrayBracketInitializer(bodyIR: var coreir.BodyIR,
                                                    slotNames: var str[],
                                                    varI32ParamNames: str[],
                                                    typedIr: texpr.TypedExprIr,
                                                    sourcePath: str,
                                                    arrayTypeRaw: str,
                                                    rhsTextRaw: str,
                                                    targetSlot: int32,
                                                    callOrdinal: var int32): bool =
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalAggregateTag:
        return false
    let rhsText = strutil.Strip(rhsTextRaw)
    if len(rhsText) < 2 || rhsText[0] != '[' || rhsText[len(rhsText) - 1] != ']':
        return false
    # element type/size from the declared array type (`int32[6]` -> i32/4).
    let arrayType = texpr.TypedExprStripVarType(arrayTypeRaw)
    var elemKind: int32
    var elemSize: int32
    if !PrimaryBodyIrSeqElementShapeFromText(typedIr,
                                             sourcePath,
                                             arrayType,
                                             elemKind,
                                             elemSize):
        return false
    # dynamic seqs are NOT fixed arrays; their `[...]` literal is a different form.
    if PrimaryBodyIrTypeTextIsDynamicSeq(arrayType):
        return false
    # T78 v4: this FIXED-array literal initializer is itself a store-side
    # elemSize consumer, same family as every other fixed-array indexed
    # write/read in this series — a fixed bool[N] array's inline element
    # slots are laid out at TypeShapeFromText's aligned register width (4B),
    # not the 1B packed width SeqElementShapeFromText hands back for a
    # GROWABLE seq's heap buffer (already excluded above). Without this the
    # literal-initializer store below writes each element at the packed
    # 1-byte stride while every other fixed bool[] consumer (plain
    # `arr[i]=v` assign, indexed read) uses the 4-byte aligned stride,
    # corrupting the array from the 2nd element onward (silent wrong value).
    let bracketInitElemTypeText = PrimaryBodyIrIndexedElementTypeText(arrayType)
    if bracketInitElemTypeText != "":
        var bracketInitShapeKind: int32
        var bracketInitShapeSize: int32
        var bracketInitShapeAlign: int32
        PrimaryBodyIrTypeShapeFromText(typedIr,
                                       sourcePath,
                                       bracketInitElemTypeText,
                                       bracketInitShapeKind,
                                       bracketInitShapeSize,
                                       bracketInitShapeAlign)
        if bracketInitShapeSize > 0 && bracketInitShapeSize >= elemSize:
            elemSize = bracketInitShapeSize
    if elemSize != 1 && elemSize != 4 && elemSize != 8:
        return false
    let innerText = strutil.Strip(strings.SliceBytes(rhsText, 1, len(rhsText) - 2))
    let elements = texpr.TypedExprSplitTopLevelCsv(innerText)
    if elements.len <= 0:
        return false
    var valueKind = elemKind
    if elemSize == 1:
        valueKind = coreir.LocalI32Tag
    for k in 0..<elements.len:
        let elemText = strutil.Strip(elements[k])
        if elemText == "":
            return false
        let elemValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                typedIr,
                                                                sourcePath,
                                                                elemText,
                                                                valueKind,
                                                                callOrdinal)
        if elemValueSlot < 0:
            return false
        let elemIndexSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                            slotNames,
                                                            Fmt"#arrinit_idx#{bodyIR.ops.len}",
                                                            coreir.LocalI32Tag,
                                                            k)
        if elemIndexSlot < 0:
            return false
        var elemStoreOp: coreir.BodyOp
        elemStoreOp.kind = coreir.BodyOpIndexedStoreTag
        elemStoreOp.target = targetSlot
        add(elemStoreOp.operands, targetSlot)
        add(elemStoreOp.operands, elemValueSlot)
        add(elemStoreOp.operands, elemIndexSlot)
        add(elemStoreOp.operands, elemSize)
        let _ = coreir.BodyIRAppendOp(bodyIR, elemStoreOp)
    return true

# Pre-hoist call-armed ternary CALL ARGUMENTS. `f((cond ? call() : call()), ...)`:
# the arg-value lowering (CallScalarValueSlotForText) cannot emit a CBR (it has no
# block context) and the branchless scalar ternary deliberately bails when an arm
# holds a real call (it would run BOTH calls). So such an arg silently resolves to
# an uninitialized slot — the whole ternary is dropped (net-audit r14
# nested_ternary_call_arg). Here, at statement level where block context exists,
# each call-armed ternary arg is lowered once via the CBR-block ternary (only the
# selected arm's call runs) into a fresh i32 temp, and the call text is rewritten
# to reference that temp by name. Non-ternary / call-free-arm args are untouched.
# Returns the rewritten call text; the bool out-param flags whether any hoist ran.
@borrows
fn PrimaryBodyIrHoistCallArmedTernaryArgs(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           varI32ParamNames: str[],
                                           lowering: var lower.LoweringPlanStub,
                                           typedFn: texpr.TypedExprIrFunction,
                                           irFunction: lower.PrimaryObjectIrFunction,
                                           sourcePath: str,
                                           lineNumber: int32,
                                           callExprNodeIndex: int32,
                                           callExprRaw: str,
                                           callOrdinal: var int32,
                                           currentBlockStart: var int32,
                                           changed: var bool): str =
    changed = false
    let callExpr = strutil.Strip(callExprRaw)
    if callExprNodeIndex < 0 ||
       callExprNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
       lowering.typedIr.nodes2_opKinds[callExprNodeIndex] !=
           texpr.TypedExprIrOpCallExpr:
        let panicMsg = Fmt"primary: ternary-argument call lacks canonical CallExpr row line={lineNumber} node={callExprNodeIndex}"
        panic(panicMsg)
    let openPos = texpr.TypedExprFindWholeCallOpenParen(callExpr)
    if openPos <= 0:
        return callExprRaw
    let closePos = texpr.TypedExprFindMatchingParen(callExpr, openPos)
    if closePos <= openPos || closePos + 1 != len(callExpr):
        return callExprRaw
    let callHead = strutil.Strip(strings.SliceBytes(callExpr, 0, openPos))
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        return callExprRaw
    let argsText = strutil.Strip(strings.SliceBytes(callExpr,
                                                    openPos + 1,
                                                    closePos - openPos - 1))
    if argsText == "":
        return callExprRaw
    let args = texpr.TypedExprSplitTopLevelCsv(argsText)
    if args.len <= 0:
        return callExprRaw
    var outArgs: str[]
    for ai in 0..<args.len:
        let argNodeIndex = PrimaryBodyIrCallArgNodeIndexAt(
            lowering.typedIr,
            callExprNodeIndex,
            ai)
        if argNodeIndex < 0 ||
           argNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
            let panicMsg = Fmt"primary: ternary-argument call lacks canonical argument row line={lineNumber} call={callExprNodeIndex} ordinal={ai}"
            panic(panicMsg)
        let argRaw = strutil.Strip(args[ai])
        let argInner = PrimaryBodyIrStripOuterParens(argRaw)
        let qPos = texpr.TypedExprFindTopLevelTextToken(argInner, "?")
        var hoisted = false
        if qPos > 0 && qPos + 1 < len(argInner):
            let tail = strings.SliceBytes(argInner, qPos + 1, len(argInner) - qPos - 1)
            let colonRel = texpr.TypedExprFindTopLevelTextToken(tail, ":")
            if colonRel > 0:
                let thenText = strutil.Strip(strings.SliceBytes(tail, 0, colonRel))
                let elseText = strutil.Strip(strings.SliceBytes(tail,
                                                                colonRel + 1,
                                                                len(tail) - colonRel - 1))
                if (PrimaryBodyIrTextHasRealCallSurface(thenText) ||
                    PrimaryBodyIrTextHasRealCallSurface(elseText)):
                    if lowering.typedIr.nodes2_opKinds[argNodeIndex] !=
                       texpr.TypedExprIrOpLocalBoolEnumTernary:
                        let panicMsg = Fmt"primary: ternary argument text/node mismatch line={lineNumber} call={callExprNodeIndex} ordinal={ai} node={argNodeIndex}"
                        panic(panicMsg)
                    let hoistName = strutil.Join(["#tern_arg#",
                                                  strings.IntToStr(lineNumber),
                                                  "_",
                                                  strings.IntToStr(ai),
                                                  "_",
                                                  strings.IntToStr(callOrdinal),
                                                  "_",
                                                  strings.IntToStr(bodyIR.ops.len)], "")
                    let hoistSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                  slotNames,
                                                                  hoistName,
                                                                  coreir.LocalI32Tag)
                    if hoistSlot >= 0 &&
                       PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,

                                                                  typedFn,
                                                                  irFunction,
                                                                  sourcePath,
                                                                  lineNumber,
                                                                  argNodeIndex,
                                                                  argInner,
                                                                  hoistSlot,
                                                                  coreir.LocalI32Tag,
                                                                  callOrdinal,
                                                                  currentBlockStart):
                        add(outArgs, hoistName)
                        changed = true
                        hoisted = true
        if !hoisted:
            add(outArgs, argRaw)
    if !changed:
        return callExprRaw
    return strutil.Join([callHead, "(", strutil.Join(outArgs, ", "), ")"], "")

# `let p: ptr = &a[k]` — take the address of a fixed-array element and bind it
# into a `ptr` local. The front-end does not node-ify the prefix `&`, so this is
# reached as raw text (`&root[idx]`). Resolves root's fixed-array slot and the
# element size (TypeShapeFromText), materializes root's base address (off=0,
# SeqAddHeaderPtrSlot — `add x, sp, #rootOff`), then computes
# `base + idx*elemSize` with the same I32Madd address op the indexed-store path
# uses, storing the element address straight into the ptr target slot. Returns
# false (let downstream handle) for any non-`&root[idx]` form or non-fixed-array
# root, so no partial state is left behind.
@borrows
fn PrimaryBodyIrAppendAddrOfArrayElemToPtr(bodyIR: var coreir.BodyIR,
                                            slotNames: var str[],
                                            varI32ParamNames: str[],
                                            typedIr: texpr.TypedExprIr,
                                            typedFn: texpr.TypedExprIrFunction,
                                            irFunction: lower.PrimaryObjectIrFunction,
                                            sourcePath: str,
                                            lineNumber: int32,
                                            rhsTextRaw: str,
                                            targetSlot: int32,
                                            callOrdinal: var int32): bool =
    if targetSlot < 0 ||
       targetSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalPtrTag:
        return false
    let rhsText = strutil.Strip(rhsTextRaw)
    if len(rhsText) < 5 || rhsText[0] != '&':
        return false
    let addrInner = strutil.Strip(strings.SliceBytes(rhsText, 1, len(rhsText) - 1))
    var addrRoot = ""
    var addrIndexText = ""
    if !PrimaryBodyIrIndexExprParts(addrInner, addrRoot, addrIndexText):
        return false
    if addrRoot == "" || addrIndexText == "":
        return false
    let addrRootType = texpr.TypedExprStripVarType(PrimaryBodyIrBindingTypeForName(typedIr,
                                                                                   typedFn,
                                                                                   irFunction,
                                                                                   lineNumber,
                                                                                   addrRoot))
    var addrFixedArrayCtx: texpr.TypedExprSourceContext
    addrFixedArrayCtx.sourcePath = sourcePath
    if !texpr.TypedExprIrTypeTextIsFixedArray(addrFixedArrayCtx, addrRootType):
        return false
    let addrElemType = PrimaryBodyIrIndexedElementTypeText(addrRootType)
    if addrElemType == "":
        return false
    var addrElemKind = coreir.LocalInvalidTag
    var addrElemSize = 0
    var addrElemAlign = 0
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   addrElemType,
                                   addrElemKind,
                                   addrElemSize,
                                   addrElemAlign)
    if addrElemSize <= 0:
        return false
    var addrRootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, addrRoot)
    if addrRootSlot < 0 || addrRootSlot >= bodyIR.localSlots.len:
        addrRootSlot = PrimaryBodyIrGlobalSeqAddressSlot(bodyIR,
                                                         slotNames,
                                                         typedIr,
                                                         sourcePath,
                                                         addrRoot)
    if addrRootSlot < 0 ||
       addrRootSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, addrRootSlot) != coreir.LocalAggregateTag:
        return false
    # base = &root (element inlined in the aggregate, header offset 0).
    let addrBaseSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                        slotNames,
                                                        lineNumber,
                                                        addrRootSlot,
                                                        0)
    if addrBaseSlot < 0:
        return false
    var addrIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          typedIr,
                                                          sourcePath,
                                                          addrIndexText,
                                                          coreir.LocalI32Tag,
                                                          callOrdinal)
    if addrIdxSlot < 0:
        addrIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          typedIr,
                                                          sourcePath,
                                                          addrIndexText,
                                                          coreir.LocalI64Tag,
                                                          callOrdinal)
    if addrIdxSlot < 0:
        return false
    let addrEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                      slotNames,
                                                      Fmt"#aoe_esz#{lineNumber}#{bodyIR.ops.len}",
                                                      coreir.LocalI64Tag,
                                                      addrElemSize)
    if addrEszSlot < 0:
        return false
    # elemAddr = idx*elemSize + base  ->  ptr target slot.
    var addrOp: coreir.BodyOp
    addrOp.kind = coreir.BodyOpBinOpTag
    addrOp.target = targetSlot
    add(addrOp.operands, coreir.LocalI64Tag)
    add(addrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
    add(addrOp.operands, addrIdxSlot)
    add(addrOp.operands, addrEszSlot)
    add(addrOp.operands, addrBaseSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, addrOp)
    return true

# Rewrite a one-line if-expr `if <cond>: <then> else: <else>` into the ternary
# spelling `<cond> ? <then> : <else>` so the str-ternary cbr lowering can take
# it. Returns "" when the text is not an if-expr. Mirrors the cond/then/else
# split the conditional-expression assign path uses (see line ~25627).
@borrows
fn PrimaryBodyIrIfExprToTernaryText(rhsRaw: str): str =
    let rhs = strutil.Strip(rhsRaw)
    if rhs.len < 4 || !PrimaryStartsWith(rhs, "if "):
        return ""
    let elsePos = texpr.TypedExprFindTopLevelTextToken(rhs, "else:")
    if elsePos <= 3:
        return ""
    var colonPos = -1
    var scan = 3
    var depth = 0
    while scan < elsePos:
        if rhs[scan] == '(' || rhs[scan] == '[':
            depth = depth + 1
        elif rhs[scan] == ')' || rhs[scan] == ']':
            depth = depth - 1
        elif rhs[scan] == ':' && depth == 0:
            colonPos = scan
            break
        scan = scan + 1
    if colonPos <= 3:
        return ""
    let condText = strutil.Strip(strings.SliceBytes(rhs, 3, colonPos - 3))
    let thenText = strutil.Strip(strings.SliceBytes(rhs, colonPos + 1, elsePos - colonPos - 1))
    let elseText = strutil.Strip(strings.SliceBytes(rhs, elsePos + 5, len(rhs) - elsePos - 5))
    if condText == "" || thenText == "" || elseText == "":
        return ""
    return strutil.Join([condText, " ? ", thenText, " : ", elseText], "")

@borrows
fn PrimaryBodyIrAppendLocalDeclInitializer(bodyIR: var coreir.BodyIR,
                                            slotNames: var str[],
                                            varI32ParamNames: str[],
                                            lowering: var lower.LoweringPlanStub,
                                            typedFn: texpr.TypedExprIrFunction,
                                            irFunction: lower.PrimaryObjectIrFunction,
                                            stmt: lower.PrimaryObjectIrStatement,
                                            targetSlot: int32,
                                            callOrdinal: var int32,
                                            currentBlockStart: var int32): bool =
    # surfaceText carries the raw source line including any trailing `# comment`
    # (`let big: int64 = 2147483647   # INT32_MAX`). The integer/literal text
    # parsers below treat the comment bytes as part of the value, fail to parse,
    # and silently leave the slot uninitialized (driver reads stack garbage).
    # Strip the string/char-aware line comment so the literal materializes.
    let rhsText = strutil.Strip(parser.ParserStripLineComment(stmt.surfaceText))
    if rhsText == "" || targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        return false
    let targetTypeKind = PrimaryBodyIrSlotType(bodyIR, targetSlot)
    # `let p: ptr = &a[k]` — address-of a fixed-array element into a ptr local.
    if targetTypeKind == coreir.LocalPtrTag &&
       PrimaryBodyIrVarParamPointeeKind(bodyIR, targetSlot) == coreir.LocalInvalidTag &&
       len(rhsText) >= 1 && rhsText[0] == '&' &&
       PrimaryBodyIrAppendAddrOfArrayElemToPtr(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering.typedIr,
                                               typedFn,
                                               irFunction,
                                               stmt.sourcePath,
                                               stmt.lineNumber,
                                               rhsText,
                                               targetSlot,
                                               callOrdinal):
        return true
    # 定长数组花括号/方括号初始化列表：`var a: T[N] = [e0, e1, ...]`。整列下降为
    # N 个常量索引 IndexedStore（复用 a[idx]=v 存储形态）。不命中（非聚合槽/非
    # 方括号列表/动态 seq）则让位下游。
    if targetTypeKind == coreir.LocalAggregateTag &&
       PrimaryBodyIrAppendFixedArrayBracketInitializer(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       lowering.typedIr,
                                                       stmt.sourcePath,
                                                       stmt.resultType,
                                                       rhsText,
                                                       targetSlot,
                                                       callOrdinal):
        return true
    # 局部位「值聚合构造器」字面量：`let o = Type(field: v, ...)` 绑到聚合槽。
    # 构造器不是函数，落到下方调用发射器只会让位（resolvedOrdinal<0）并留下
    # 未初始化槽（读出垃圾，ctor_local 即此缺陷）。与 return 位共用核心：形状
    # 校验 → 零初始化目标槽 → 逐字段 FieldStore（标量+嵌套聚合字段）。
    if targetTypeKind == coreir.LocalAggregateTag &&
       PrimaryBodyIrAppendAggregateConstructorToSlot(bodyIR,
                                                     slotNames,
                                                     varI32ParamNames,
                                                     lowering,

                                                     typedFn,
                                                     irFunction,
                                                     rhsText,
                                                     stmt.rhsNodeIndex,
                                                     stmt.resultType,
                                                     stmt.sourcePath,
                                                     stmt.lineNumber,
                                                     targetSlot,
                                                     stmt.lineNumber,
                                                     callOrdinal):
        return true
    if targetTypeKind == coreir.LocalPtrTag &&
       PrimaryBodyIrAppendObjectConstructorValue(bodyIR,
                                                 slotNames,
                                                 varI32ParamNames,
                                                 lowering.typedIr,
                                                 stmt.sourcePath,
                                                 stmt.resultType,
                                                 rhsText,
                                                 targetSlot,
                                                 callOrdinal):
        return true
    if targetTypeKind == coreir.LocalPtrTag &&
       PrimaryBodyIrWholeCallInnerForHead(rhsText, "new") != "":
        # [wall72] 文本落臂的 decl-init new(T) 同样按语句列盖 (R_decl,
        # OwnMove) 定义戳；节点路径先行盖章时 helper 幂等跳过。
        # [wall80] 锚点契约修正：发射器内部先落 size/zero 两个 LoadConst
        # op，「append 前 ops.len」盖到的是 LoadConst（v6 同族形状守卫死因）。
        # alloc op 精确索引改由发射器 out 参回传，零启发式。
        var declNewAllocOpIndex: int32
        if !PrimaryBodyIrAppendNewObjectValue(bodyIR,
                                              slotNames,
                                              lowering.typedIr,
                                              stmt.sourcePath,
                                              rhsText,
                                              targetSlot,
                                              callOrdinal,
                                              declNewAllocOpIndex):
            return false
        PrimaryBodyIrBindNewObjectAllocValueDefinitionExact(
            bodyIR,
            lowering.typedIr,
            lowering.typeArenaStructuralKinds,
            lowering.typeArenaScalarKinds,
            lowering.typeArenaChildTypeIds,
            lowering.typeArenaFixedLengths,
            lowering.typeArenaSizeBytes,
            lowering.typeArenaAlignBytes,
            targetSlot,
            declNewAllocOpIndex,
            stmt.bindingTargetDefinitionRow)
        return true
    if stmt.callTarget != "":
        let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                          slotNames,
                                          lowering,

                                          typedFn,
                                          irFunction,
                                          stmt,
                                          targetSlot,
                                          varI32ParamNames,
                                          callOrdinal,
                                          currentBlockStart)
        return true
    if PrimaryBodyIrTextIsBareWholeCall(rhsText):
        if stmt.rhsNodeIndex < 0 ||
           stmt.rhsNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
           lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] != texpr.TypedExprIrOpCallExpr:
            let panicMsg = Fmt"primary: local initializer whole call lacks exact TypedExpr CallExpr function={typedFn.functionName} line={stmt.lineNumber} node={stmt.rhsNodeIndex}"
            panic(panicMsg)
        if PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                 slotNames,
                                                 lowering,

                                                 typedFn,
                                                 irFunction,
                                                 varI32ParamNames,
                                                 rhsText,
                                                 targetSlot,
                                                 stmt.lineNumber,
                                                 stmt.rhsNodeIndex,
                                                 callOrdinal):
            return true
    if targetTypeKind == coreir.LocalStrTag &&
       PrimaryBodyIrTextIsStringLiteral(rhsText):
        return PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                     slotNames,
                                                     rhsText,
                                                     targetSlot,
                                                     callOrdinal)
    # wave9-const 根修 (跨模块无限定 const 静默 miscompile, str decl-RHS 面):
    # 裸标识符 RHS (无点前缀, 如 `let s: str = QPlain`) 既非字符串字面量, node-eval
    # 侧对这形也不建 rhsNode (front-end 未把裸跨模块 const 折成节点), 落到本文本
    # 兜底路径原恒 return false → 槽未写读栈垃圾。先探本文件同源 const 块 (复用
    # LookupSourceConstStrLiteral, 此前只有递归自调无真调用方), 再探跨模块无限定
    # const (LookupUnqualifiedImportedConstStrLiteral, 撞名即 "" 维持 poison 不猜)。
    # 限定形 `mod.CONST` 有点前缀, ParserIdentPrefix != 原文本, 不落此臂——与既有
    # 节点求值/文本限定路径形态严等不重叠。
    if targetTypeKind == coreir.LocalStrTag &&
       rhsText != "" &&
       parser.ParserIdentPrefix(rhsText) == rhsText:
        let declConstStrLit = PrimaryBodyIrCanonicalConstStringLiteral(lowering.typedIr,
                                                                       stmt.sourcePath,
                                                                       rhsText)
        if declConstStrLit != "":
            return PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                         slotNames,
                                                         declConstStrLit,
                                                         targetSlot,
                                                         callOrdinal)
    # `var p: ptr = "..."` — cstring literal address into a plain ptr slot
    # (same form as the cstring-assign path in AppendI32Assign). Without this
    # the decl left the slot uninitialized and a later read returned garbage;
    # only the call-arg-inlined case happened to work.
    if targetTypeKind == coreir.LocalPtrTag &&
       PrimaryBodyIrVarParamPointeeKind(bodyIR, targetSlot) == coreir.LocalInvalidTag &&
       PrimaryBodyIrTextIsStringLiteral(rhsText) &&
       stmt.callTarget == "":
        let declCstrLiteralId = coreir.BodyIRAppendCStringLiteral(bodyIR,
                                                                  PrimaryBodyIrStringLiteralPayload(rhsText),
                                                                  "")
        if declCstrLiteralId >= 0:
            var declCstrOp: coreir.BodyOp
            declCstrOp.kind = coreir.BodyOpLoadLocalTag
            declCstrOp.target = targetSlot
            add(declCstrOp.operands, coreir.BodyLoadLocalCStringTag)
            add(declCstrOp.operands, declCstrLiteralId)
            let _ = coreir.BodyIRAppendOp(bodyIR, declCstrOp)
            return true
    # 外层分组括号 `(cond ? a : b)` 会把顶层 `?` 藏在括号深处，使顶层扫描失配，
    # 三元下降被跳过 → let-call 误降只取条件首调用。先剥外层括号再探测 `?`，
    # 让带括号的三元绑定也走 cbr 真分支(下游 ternary 函数自身亦剥括号，幂等)。
    let rhsTernaryText = PrimaryBodyIrStripOuterParens(rhsText)
    if targetTypeKind == coreir.LocalStrTag &&
       texpr.TypedExprFindTopLevelTextToken(rhsTernaryText, "?") > 0 &&
       PrimaryBodyIrAppendStrTernaryDeclValue(bodyIR,
                                              slotNames,
                                              varI32ParamNames,
                                              lowering,

                                              typedFn,
                                              irFunction,
                                              stmt,
                                              stmt.rhsNodeIndex,
                                              rhsTernaryText,
                                              targetSlot,
                                              callOrdinal,
                                              currentBlockStart):
        return true
    # `let s = if cond: a else: b` is the if-expr spelling of the str ternary.
    # Normalize it to `cond ? a : b` and reuse the proven cbr branch lowering
    # (the inline-if-expr form otherwise reached no str-decl path and fell to a
    # dropped InvalidOp, wcz-ing the whole function — e.g. the `importcText`
    # decl feeding a Fmt arg in TypedExprFactsValidateCallResolutionRange).
    if targetTypeKind == coreir.LocalStrTag:
        let ifExprTernaryText = PrimaryBodyIrIfExprToTernaryText(strings.CloneStr(rhsTernaryText))
        if ifExprTernaryText != "" &&
           PrimaryBodyIrAppendStrTernaryDeclValue(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering,

                                                  typedFn,
                                                  irFunction,
                                                  stmt,
                                                  stmt.rhsNodeIndex,
                                                  ifExprTernaryText,
                                                  targetSlot,
                                                  callOrdinal,
                                                  currentBlockStart):
            return true
    # 标量三元含真调用臂：走真分支(只执行被选中臂)，根除急切两臂求值 miscompile。
    # 纯常量/cast/无真调用臂仍由下游标量值槽的无分支快路径处理。
    if (targetTypeKind == coreir.LocalI32Tag || targetTypeKind == coreir.LocalI64Tag) &&
       texpr.TypedExprFindTopLevelTextToken(rhsTernaryText, "?") > 0 &&
       PrimaryBodyIrTextHasRealCallSurface(rhsTernaryText) &&
       PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering,

                                                  typedFn,
                                                  irFunction,
                                                  stmt.sourcePath,
                                                  stmt.lineNumber,
                                                  stmt.rhsNodeIndex,
                                                  rhsTernaryText,
                                                  targetSlot,
                                                  targetTypeKind,
                                                  callOrdinal,
                                                  currentBlockStart):
        return true
    if targetTypeKind == coreir.LocalI32Tag &&
       PrimaryBodyIrUInt8PtrDerefPointerText(rhsText) != "":
        return PrimaryBodyIrAppendUInt8PtrDerefLoad(bodyIR,
                                                    slotNames,
                                                    varI32ParamNames,
                                                    lowering.typedIr,
                                                    stmt.sourcePath,
                                                    rhsText,
                                                    targetSlot,
                                                    callOrdinal)
    if targetTypeKind == coreir.LocalI32Tag &&
       PrimaryBodyIrI32PtrDerefPointerText(rhsText) != "":
        # W2C 裸 `*name` deref 宽度分派: 声明类型为 uint8 (bufByteAt 实案:
        # `let byteValue: uint8 = *p`) 或指针 pointee 为 uint8 时必须 ldrb ——
        # 落下方 I32 默认臂会把字节读成 32 位窗口 (readU32LEAt/Mach-O 头解析
        # 全灭, GEN2 got_magic 错位)。其它一律让位 I32 臂, 宽度与行为不变。
        let bareDerefPointerText = PrimaryBodyIrI32PtrDerefPointerText(rhsText)
        var bareDerefPointee = ""
        if texpr.TypedExprNormalizeTypeText(stmt.resultType) == "uint8":
            bareDerefPointee = "uint8"
        else:
            bareDerefPointee = PrimaryBodyIrBarePointerPointeeType(lowering.typedIr,
                                                                     stmt.sourcePath,
                                                                     PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                                                       typedFn,
                                                                                                       irFunction,
                                                                                                       stmt.lineNumber,
                                                                                                       bareDerefPointerText))
        if bareDerefPointee == "uint8":
            if PrimaryBodyIrAppendU8PtrDerefLoadBare(bodyIR,
                                                     slotNames,
                                                     varI32ParamNames,
                                                     lowering.typedIr,
                                                     stmt.sourcePath,
                                                     bareDerefPointerText,
                                                     targetSlot,
                                                     callOrdinal):
                return true
        return PrimaryBodyIrAppendI32PtrDerefLoad(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering.typedIr,
                                                  stmt.sourcePath,
                                                  rhsText,
                                                  targetSlot,
                                                  callOrdinal)
    # T48 根修: decl-RHS 通用指针宽 deref 装载，镜像 assign 路径
    # （AppendI32Assign :38010 "General pointer-width deref load"）的同款分支。
    # UInt8Ptr/Int32Ptr 两窄形已被上面两个专用分支（连同其内部的裸 `*name`
    # 兼容形）接管，本分支只会在两者都返回 "" 时触达——即 VoidPtrPtr/
    # UInt32Ptr/Int64Ptr/UInt64Ptr 全宽 cast 族（`*(Cast(x))` 与 `*Cast(x)`
    # 两形皆认，复用同一对文本判别器，T45 教训已内建）。decl 语句此前对这族
    # 完全没有对应分支：RHS 文本以 '*' 打头就直接落空，目标槽早被上游
    # FindOrCreateTypedSlot 按未解析类型（默认 int32/4B）登记，装载指令永不
    # 发射——T48 案字节级证据 program 槽 `ldr w9,[sp,#0x20]` 读的是全函数从未
    # 写过的槽。
    #
    # ptrDerefLoadWhole 守卫（不可省）：RHS 必须整体就是这一个 deref 表达式，
    # 一个字符都不能多——`let next: int32 = *(Int32Ptr(cell)) + delta` 这类
    # 复合表达式（deref 只是加法左操作数）rhsText[0] 同样是 '*'，若不校验
    # cast 调用的右括号就是 rhsText 的最后一个字符，会抢在下面 21397 附近
    # 既有的二元 '+' 分解分支之前把整条语句错吞成纯 deref、丢掉 " + delta"
    # （实测 program_support_backend.cheng 的 cheng_ffi_handle_add_i32_export/
    # cheng_ffi_raw_add_i32_export 两个真函数命中此形，回归会致其 719 poison）。
    # 守卫不满足时既不发射也不 poison，原样落空到下面既有分支，行为与本补丁
    # 之前完全一致（纯增量）。
    if len(rhsText) > 1 && rhsText[0] == '*' &&
       PrimaryBodyIrUInt8PtrDerefPointerText(rhsText) == "" &&
       PrimaryBodyIrI32PtrDerefPointerText(rhsText) == "":
        var ptrDerefLoadWhole = false
        if rhsText[1] == '(' && rhsText[len(rhsText) - 1] == ')' &&
           texpr.TypedExprFindMatchingParen(rhsText, 1) == len(rhsText) - 1:
            ptrDerefLoadWhole = true
        elif rhsText[1] != '(' && rhsText[len(rhsText) - 1] == ')':
            var ptrDerefLoadOpenPos: int32 = -1
            for ptrDerefLoadI in 1..<len(rhsText):
                if rhsText[ptrDerefLoadI] == '(':
                    ptrDerefLoadOpenPos = ptrDerefLoadI
                    break
            if ptrDerefLoadOpenPos > 1 &&
               texpr.TypedExprFindMatchingParen(rhsText, ptrDerefLoadOpenPos) == len(rhsText) - 1:
                ptrDerefLoadWhole = true
        if ptrDerefLoadWhole:
            var ptrDerefLoadInner = strutil.Strip(strings.SliceBytes(rhsText, 1, len(rhsText) - 1))
            ptrDerefLoadInner = PrimaryBodyIrStripOuterParens(ptrDerefLoadInner)
            let ptrDerefLoadPtrSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      lowering.typedIr,
                                                                      stmt.sourcePath,
                                                                      ptrDerefLoadInner,
                                                                      callOrdinal)
            if ptrDerefLoadPtrSlot >= 0:
                # 宽度按 cast 头名取，与既有 uint8/int32 两窄形金标同一套
                # FindOrCreateTypedSlot 宽化机制对齐：VoidPtrPtr/裸指针形→
                # ptr 8B；Int64Ptr/UInt64Ptr→int64 8B；UInt32Ptr→uint32 4B。
                var ptrDerefLoadType = "ptr"
                if PrimaryBodyIrWholeCallInnerForHead(ptrDerefLoadInner, "Int64Ptr") != "" ||
                   PrimaryBodyIrWholeCallInnerForHead(ptrDerefLoadInner, "UInt64Ptr") != "":
                    ptrDerefLoadType = "int64"
                elif PrimaryBodyIrWholeCallInnerForHead(ptrDerefLoadInner, "UInt32Ptr") != "":
                    ptrDerefLoadType = "uint32"
                let ptrDerefLoadTargetSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                                slotNames,
                                                                                lowering.typedIr,
                                                                                stmt.sourcePath,
                                                                                stmt.bindingName,
                                                                                ptrDerefLoadType)
                if ptrDerefLoadTargetSlot >= 0:
                    var ptrDerefLoadOp: coreir.BodyOp
                    ptrDerefLoadOp.kind = coreir.BodyOpIndexedLoadTag
                    ptrDerefLoadOp.target = ptrDerefLoadTargetSlot
                    add(ptrDerefLoadOp.operands, ptrDerefLoadPtrSlot)
                    add(ptrDerefLoadOp.operands, ptrDerefLoadTargetSlot)
                    let _ = coreir.BodyIRAppendOp(bodyIR, ptrDerefLoadOp)
                    return true
            # miss 必须 poison（719，同 :38010 款式），绝不静默落穿弱路径。
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         719,
                                         0)
            return true
    if targetTypeKind == coreir.LocalI32Tag &&
       (PrimaryBodyIrConditionHasAnd(rhsText) ||
        PrimaryBodyIrConditionHasOr(rhsText)):
        var boolConditionBlockStart: int32
        boolConditionBlockStart = currentBlockStart
        let boolConditionAssigned = PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                                          slotNames,
                                                                          lowering,

                                                                          typedFn,
                                                                          irFunction,
                                                                          stmt.sourcePath,
                                                                          stmt.lineNumber,
                                                                          rhsText,
                                                                          targetSlot,
                                                                          callOrdinal,
                                                                          boolConditionBlockStart)
        currentBlockStart = boolConditionBlockStart
        return boolConditionAssigned
    if stmt.assignValueFieldName != "":
        return PrimaryBodyIrAppendFieldLoadToSlot(bodyIR,
                                                  slotNames,
                                                  lowering.typedIr,
                                                  stmt.sourcePath,
                                                  stmt.assignValueRootName,
                                                  stmt.assignValueRootType,
                                                  stmt.assignValueFieldOffsetBytes,
                                                  stmt.assignValueFieldSizeBytes,
                                                  targetSlot)
    if targetTypeKind != coreir.LocalI32Tag &&
       targetTypeKind != coreir.LocalI64Tag &&
       targetTypeKind != coreir.LocalPtrTag:
        return false
    if (targetTypeKind == coreir.LocalI32Tag || targetTypeKind == coreir.LocalI64Tag) &&
       PrimaryBodyIrTextHasCallSurface(rhsText):
        var callBinPos: int32 = -1
        var callBinKind: int32
        var callBinOpLen: int32
        callBinOpLen = 1
        let callBitOrPos = texpr.TypedExprFindTopLevelBitwiseTextToken(rhsText, "|")
        let callBitAndPos = texpr.TypedExprFindTopLevelBitwiseTextToken(rhsText, "&")
        let callAddPos = texpr.TypedExprFindTopLevelTextToken(rhsText, "+")
        let callSubPos = texpr.TypedExprFindTopLevelTextToken(rhsText, "-")
        let callMulPos = texpr.TypedExprFindTopLevelTextToken(rhsText, "*")
        let callDivPos = texpr.TypedExprFindTopLevelTextToken(rhsText, "/")
        let callModPos = texpr.TypedExprFindTopLevelTextToken(rhsText, "%")
        let callShrPos = texpr.TypedExprFindTopLevelTextToken(rhsText, ">>")
        let callShlPos = texpr.TypedExprFindTopLevelTextToken(rhsText, "<<")
        if callBitOrPos > 0:
            callBinPos = callBitOrPos
            callBinKind = int32(texpr.TypedExprIrOpI32BitOr)
        elif callBitAndPos > 0:
            callBinPos = callBitAndPos
            callBinKind = int32(texpr.TypedExprIrOpI32BitAnd)
        elif callAddPos > 0:
            callBinPos = callAddPos
            callBinKind = int32(texpr.TypedExprIrOpI32Add)
        elif callSubPos > 0:
            callBinPos = callSubPos
            callBinKind = int32(texpr.TypedExprIrOpI32Sub)
        elif callMulPos > 0:
            callBinPos = callMulPos
            callBinKind = int32(texpr.TypedExprIrOpI32Mul)
        elif callDivPos > 0:
            callBinPos = callDivPos
            callBinKind = int32(texpr.TypedExprIrOpI32Sdiv)
        elif callModPos > 0:
            callBinPos = callModPos
            callBinKind = -100
        elif callShrPos > 0:
            callBinPos = callShrPos
            callBinKind = int32(texpr.TypedExprIrOpI32Asr)
            callBinOpLen = 2
        elif callShlPos > 0:
            callBinPos = callShlPos
            callBinKind = int32(texpr.TypedExprIrOpI32Lsl)
            callBinOpLen = 2
        if callBinPos > 0 && callBinPos + callBinOpLen < len(rhsText):
            let callLhsText = strutil.Strip(strings.SliceBytes(rhsText, 0, callBinPos))
            if callBinKind == int32(texpr.TypedExprIrOpI32Asr):
                callBinKind = PrimaryBodyIrShiftRightOpKind(lowering.typedIr, typedFn, irFunction, stmt.lineNumber, callLhsText)
            let callRhsText = strutil.Strip(strings.SliceBytes(rhsText,
                                                              callBinPos + callBinOpLen,
                                                              len(rhsText) - callBinPos - callBinOpLen))
            if callLhsText == "" || callRhsText == "":
                return false
            var expectedCallBinKind = callBinKind
            if expectedCallBinKind == -100:
                expectedCallBinKind = int32(texpr.TypedExprIrOpI32Mod)
            if stmt.rhsNodeIndex < 0 ||
               stmt.rhsNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
               lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] !=
                   expectedCallBinKind:
                let panicMsg = Fmt"primary: statement call-binop lacks matching canonical row statement={stmt.statementIndex} node={stmt.rhsNodeIndex} expected={expectedCallBinKind}"
                panic(panicMsg)
            let callLhsNodeIndex = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_operand0NodeIndexs,
                stmt.rhsNodeIndex)
            let callRhsNodeIndex = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_operand1NodeIndexs,
                stmt.rhsNodeIndex)
            # 含调用臂的三元子式（如 `(n>0 ? f(n) : 0) + ...`）交给 ternary-aware
            # 递归求值器：三元叶走 cbr 块下推到临时槽，避免 CallScalarValueSlotForText
            # 对三元叶返回 -1 而丢整个 RHS。裸调用/cast 头/常量/普通槽沿用既有路径。
            let callLhsSlot = PrimaryBodyIrCallBinOpTernaryAwareSlot(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,

                                                                     typedFn,
                                                                     irFunction,
                                                                     stmt.sourcePath,
                                                                     stmt.lineNumber,
                                                                     callLhsNodeIndex,
                                                                     callLhsText,
                                                                     targetTypeKind,
                                                                     callOrdinal,
                                                                     currentBlockStart)
            let callRhsSlot = PrimaryBodyIrCallBinOpTernaryAwareSlot(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,

                                                                     typedFn,
                                                                     irFunction,
                                                                     stmt.sourcePath,
                                                                     stmt.lineNumber,
                                                                     callRhsNodeIndex,
                                                                     callRhsText,
                                                                     targetTypeKind,
                                                                     callOrdinal,
                                                                     currentBlockStart)
            if callLhsSlot < 0 || callRhsSlot < 0:
                return false
            if callBinKind == -100:
                let callQuotientSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                     slotNames,
                                                                     Fmt"{stmt.bindingName}#bin_quotient#{stmt.lineNumber}",
                                                                     targetTypeKind)
                let callProductSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                    slotNames,
                                                                    Fmt"{stmt.bindingName}#bin_product#{stmt.lineNumber}",
                                                                    targetTypeKind)
                if callQuotientSlot < 0 || callProductSlot < 0:
                    return false
                var callDivOp: coreir.BodyOp
                callDivOp.kind = coreir.BodyOpBinOpTag
                callDivOp.target = callQuotientSlot
                add(callDivOp.operands, targetTypeKind)
                add(callDivOp.operands, int32(texpr.TypedExprIrOpI32Sdiv))
                add(callDivOp.operands, callLhsSlot)
                add(callDivOp.operands, callRhsSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, callDivOp)
                var callMulOp: coreir.BodyOp
                callMulOp.kind = coreir.BodyOpBinOpTag
                callMulOp.target = callProductSlot
                add(callMulOp.operands, targetTypeKind)
                add(callMulOp.operands, int32(texpr.TypedExprIrOpI32Mul))
                add(callMulOp.operands, callQuotientSlot)
                add(callMulOp.operands, callRhsSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, callMulOp)
                var callRemOp: coreir.BodyOp
                callRemOp.kind = coreir.BodyOpBinOpTag
                callRemOp.target = targetSlot
                add(callRemOp.operands, targetTypeKind)
                add(callRemOp.operands, int32(texpr.TypedExprIrOpI32Sub))
                add(callRemOp.operands, callLhsSlot)
                add(callRemOp.operands, callProductSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, callRemOp)
                return true
            var callBinOp: coreir.BodyOp
            callBinOp.kind = coreir.BodyOpBinOpTag
            callBinOp.target = targetSlot
            add(callBinOp.operands, targetTypeKind)
            add(callBinOp.operands, callBinKind)
            add(callBinOp.operands, callLhsSlot)
            add(callBinOp.operands, callRhsSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, callBinOp)
            return true
    if targetTypeKind == coreir.LocalI32Tag ||
       targetTypeKind == coreir.LocalI64Tag:
        let scalarInitSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 lowering.typedIr,
                                                                 stmt.sourcePath,
                                                                 rhsText,
                                                                 targetTypeKind, callOrdinal)
        if scalarInitSlot >= 0:
            if scalarInitSlot != targetSlot:
                var scalarCopyOp: coreir.BodyOp
                scalarCopyOp.kind = coreir.BodyOpCopyLocalTag
                scalarCopyOp.target = targetSlot
                add(scalarCopyOp.operands, scalarInitSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, scalarCopyOp)
            return true
    let addPos = texpr.TypedExprFindTopLevelTextToken(rhsText, "+")
    if addPos >= 0 &&
       (targetTypeKind == coreir.LocalI32Tag || targetTypeKind == coreir.LocalI64Tag):
        let lhsText = strutil.Strip(strings.SliceBytes(rhsText, 0, addPos))
        let rhsPart = strutil.Strip(strings.SliceBytes(rhsText,
                                                       addPos + 1,
                                                       len(rhsText) - addPos - 1))
        let lhsSlot = PrimaryBodyIrLocalInitValueSlot(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      lowering.typedIr,
                                                      stmt.sourcePath,
                                                      stmt.resultType,
                                                      targetTypeKind,
                                                      lhsText, callOrdinal)
        let rhsSlot = PrimaryBodyIrLocalInitValueSlot(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      lowering.typedIr,
                                                      stmt.sourcePath,
                                                      stmt.resultType,
                                                      targetTypeKind,
                                                      rhsPart, callOrdinal)
        if lhsSlot < 0 || rhsSlot < 0:
            return false
        var op: coreir.BodyOp
        op.kind = coreir.BodyOpBinOpTag
        op.target = targetSlot
        add(op.operands, targetTypeKind)
        add(op.operands, int32(texpr.TypedExprIrOpI32Add))
        add(op.operands, lhsSlot)
        add(op.operands, rhsSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, op)
        return true
    let valueSlot = PrimaryBodyIrLocalInitValueSlot(bodyIR,
                                                   slotNames,
                                                   varI32ParamNames,
                                                   lowering.typedIr,
                                                   stmt.sourcePath,
                                                   stmt.resultType,
                                                   targetTypeKind,
                                                   rhsText, callOrdinal)
    if valueSlot < 0:
        return false
    if valueSlot == targetSlot:
        return true
    if targetTypeKind == coreir.LocalI64Tag &&
       PrimaryBodyIrSlotType(bodyIR, valueSlot) == coreir.LocalI32Tag:
        let zeroSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"{stmt.bindingName}#i64_zero",
                                                       coreir.LocalI64Tag,
                                                       0)
        if zeroSlot < 0:
            return false
        var widenOp: coreir.BodyOp
        widenOp.kind = coreir.BodyOpBinOpTag
        widenOp.target = targetSlot
        add(widenOp.operands, coreir.LocalI64Tag)
        add(widenOp.operands, int32(texpr.TypedExprIrOpI32Add))
        add(widenOp.operands, valueSlot)
        add(widenOp.operands, zeroSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, widenOp)
        return true
    if PrimaryBodyIrSlotType(bodyIR, valueSlot) != targetTypeKind:
        return false
    var copyOp: coreir.BodyOp
    copyOp.kind = coreir.BodyOpCopyLocalTag
    copyOp.target = targetSlot
    add(copyOp.operands, valueSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, copyOp)
    return true

@borrows
fn PrimaryBodyIrAppendSeqStrLiteralArgSlot(bodyIR: var coreir.BodyIR,
                                            slotNames: var str[],
                                            varI32ParamNames: str[],
                                            lowering: var lower.LoweringPlanStub,
                                            typedFn: texpr.TypedExprIrFunction,
                                            irFunction: lower.PrimaryObjectIrFunction,
                                            sourcePath: str,
                                            lineNumber: int32,
                                            argText: str,
                                            slotBaseName: str,
                                            callOrdinal: var int32): int32 =
    # seq[str] 字面量实参（[a, "b", Fmt"..."]）：fmt 同款 seq 构造
    #（零初始化 16 字节头 + 逐元素 cheng_seq_str_add），元素支持
    # str 字面量 / Fmt 字面量 / str 槽名（param 槽存地址者先物化）。
    if len(argText) < 2 ||
       !PrimaryBodyIrTextByteCodeEquals(argText, 0, 91) ||
       !PrimaryBodyIrTextByteCodeEquals(argText, len(argText) - 1, 93):
        return -1
    let seqSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                     slotNames,
                                                     Fmt"{slotBaseName}#seq_str_lit",
                                                     coreir.LocalAggregateTag,
                                                     16,
                                                     8)
    if seqSlot < 0:
        return -1
    if !PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                         slotNames,
                                         seqSlot,
                                         callOrdinal):
        return -1
    let innerText = strutil.Strip(strings.SliceBytes(argText, 1, len(argText) - 2))
    if innerText == "":
        return seqSlot
    let elementTexts = PrimaryBodyIrCallArgNames(innerText)
    for elemIndex in 0..<elementTexts.len:
        let elemText = strutil.Strip(elementTexts[elemIndex])
        var elemSlot: int32 = -1
        if PrimaryBodyIrTextIsStringLiteral(elemText):
            elemSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"{slotBaseName}#seq_str_lit#{elemIndex}",
                                                     coreir.LocalStrTag)
            if elemSlot < 0 ||
               !PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                      slotNames,
                                                      elemText,
                                                      elemSlot,
                                                      callOrdinal):
                return -1
        else:
            let namedSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, elemText)
            if namedSlot < 0 || namedSlot >= bodyIR.localSlots.len:
                return -1
            let namedKind = PrimaryBodyIrSlotType(bodyIR, namedSlot)
            var namedNeedsLoad = false
            if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[namedSlot]):
                if namedKind == coreir.LocalStrTag:
                    namedNeedsLoad = true
                elif namedKind == coreir.LocalAggregateTag &&
                     bodyIR.localSlots[namedSlot].auxValue == coreir.LocalStrTag:
                    namedNeedsLoad = true
                else:
                    return -1
            elif namedKind != coreir.LocalStrTag:
                return -1
            if namedNeedsLoad:
                elemSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                         slotNames,
                                                         Fmt"{slotBaseName}#seq_str_lit#{elemIndex}",
                                                         coreir.LocalStrTag)
                if elemSlot < 0:
                    return -1
                var seqElemLoadOp: coreir.BodyOp
                seqElemLoadOp.kind = coreir.BodyOpFieldLoadTag
                seqElemLoadOp.target = elemSlot
                add(seqElemLoadOp.operands, namedSlot)
                add(seqElemLoadOp.operands, elemSlot)
                add(seqElemLoadOp.operands, 0)
                add(seqElemLoadOp.operands, 24)
                let _ = coreir.BodyIRAppendOp(bodyIR, seqElemLoadOp)
            else:
                elemSlot = namedSlot
        if !PrimaryBodyIrAppendSeqStrAddValueSlot(bodyIR,
                                                  slotNames,
                                                  seqSlot,
                                                  elemSlot,
                                                  callOrdinal):
            return -1
    return seqSlot

# 定长数组/聚合按值实参的拷贝守卫（#59 fixed_array_byval）：plain 标识符实参
# 解析出的槽若是「非 param 本地聚合」（即 caller 帧里的真实聚合，如 int32[N]），
# 直接把它的栈地址传进 x0 会让 callee 按引用改穿 caller 数组——违反值语义。
# 按值聚合 ABI 要求在调用点先把整块拷到独立临时栈区，再传该临时地址；callee
# 改的是副本。仅对「非 param、非 global、CopyLocal 可搬运宽度」的聚合做拷贝；
# str（24B 内联头）与 param/global 槽保持原协议。返回应实际传递的 argSlot。
fn PrimaryBodyIrByValAggregateArgCopySlot(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           slotId: int32,
                                           callOrdinal: int32,
                                           argIndex: int32): int32 =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return slotId
    let slot = bodyIR.localSlots[slotId]
    if slot.typeKind != coreir.LocalAggregateTag:
        return slotId
    if PrimaryBodyIrLocalIsParam(slot):
        return slotId
    if slot.placeKind == coreir.BodyPlaceGlobalAddressTag:
        return slotId
    let aggSize = PrimaryLocalSlotSizeOf(slot)
    # CopyLocal 支持 1/2/4 标量宽、8 字节整块整数倍、以及 4 字节整数倍整块拷贝
    # （PrimaryBodyIRCopySlot 的 %4 分支）。20 字节嵌套结构（5 个 word）也必须复制，
    # 否则按值聚合形参会直接传原址，被调用方原地改坏调用方的源结构体。
    let copyable = aggSize == 1 || aggSize == 2 || aggSize == 4 || (aggSize > 0 && aggSize % 4 == 0)
    if !copyable:
        return slotId
    var aggAlign = slot.alignBytes
    if aggAlign <= 0:
        aggAlign = 8
    let copySlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                      slotNames,
                                                      Fmt"#byvalcopy#c{callOrdinal}#a{argIndex}#{bodyIR.ops.len}",
                                                      coreir.LocalAggregateTag,
                                                      aggSize,
                                                      aggAlign)
    if copySlot < 0:
        return slotId
    var aggCopyOp: coreir.BodyOp
    aggCopyOp.kind = coreir.BodyOpCopyLocalTag
    aggCopyOp.target = copySlot
    add(aggCopyOp.operands, slotId)
    let _ = coreir.BodyIRAppendOp(bodyIR, aggCopyOp)
    return copySlot

@borrows
fn PrimaryBodyIrExactCallAuthorityResultType(
    typedIr: texpr.TypedExprIr,
    targetSourcePath: str,
    targetName: str,
    targetSignatureLine: int32,
    targetImportc: bool,
    targetIndexOut: var int32
): str =
    targetIndexOut = -1
    if targetImportc:
        panic(Fmt"primary: function authority helper received importc target source={targetSourcePath} target={targetName}")
    if targetSourcePath == "" || targetName == "" || targetSignatureLine <= 0:
        panic(Fmt"primary: exact call authority identity missing source={targetSourcePath} target={targetName} signature_line={targetSignatureLine} importc={targetImportc}")
    let targetIndex = PrimaryBodyIrTargetFunctionIndexAtLine(typedIr,
                                                             targetSourcePath,
                                                             targetName,
                                                             targetSignatureLine)
    if targetIndex < 0 || targetIndex >= typedIr.functions2_returnTypeIds.len:
        panic(Fmt"primary: exact call authority missing or ambiguous source={targetSourcePath} target={targetName} signature_line={targetSignatureLine}")
    let returnTypeRes: Result[str] = langintern.LookupIntern(
        typedIr.internPool,
        typedIr.functions2_returnTypeIds[targetIndex])
    if !IsOk(returnTypeRes):
        panic(Fmt"primary: exact call authority return type unavailable source={targetSourcePath} target={targetName} signature_line={targetSignatureLine}")
    let returnType = Value(returnTypeRes)
    # Typed IR keeps the empty void marker from the source scope; canonicalize
    # to the explicit "void" name before the stability gate (same convention as
    # the CSG semantic record).
    var canonicalReturnType = strings.CloneStr(returnType)
    if canonicalReturnType == "":
        canonicalReturnType = "void"
    if canonicalReturnType == "unknown" ||
       canonicalReturnType == "call_expr" ||
       !PrimaryObjectMetadataTextStable(canonicalReturnType):
        let panicMsg = Fmt"primary: exact call authority return type invalid source={targetSourcePath} target={targetName} signature_line={targetSignatureLine} return_type={canonicalReturnType}"
        panic(panicMsg)
    targetIndexOut = targetIndex
    return canonicalReturnType

@borrows
fn PrimaryBodyIrExactImportcAuthorityResultType(
    typedIr: texpr.TypedExprIr,
    targetSourcePath: str,
    targetName: str
): str =
    if targetSourcePath == "" || targetName == "":
        panic(Fmt"primary: exact importc authority identity missing source={targetSourcePath} target={targetName}")
    let returnType = texpr.TypedExprIrLookupImportcReturnType(typedIr,
                                                              targetSourcePath,
                                                              targetName)
    if returnType == "" || returnType == "unknown" ||
       returnType == "call_expr" ||
       !PrimaryObjectMetadataTextStable(returnType):
        panic(Fmt"primary: exact importc authority return type invalid source={targetSourcePath} target={targetName} return_type={returnType}")
    return returnType

# Read a real CallExpr's declaration identity only from its node columns.  Surface
# text, line matching and name-only lookup are deliberately excluded: overloads
# with the same spelling/arity must remain distinguishable here.
@borrows
fn PrimaryBodyIrExactCallNodeAuthority(
    typedIr: texpr.TypedExprIr,
    nodeIndex: int32,
    targetSourcePathOut: var str,
    targetNameOut: var str,
    targetSignatureLineOut: var int32,
    targetImportcOut: var bool,
    resultTypeOut: var str
): bool =
    targetSourcePathOut = ""
    targetNameOut = ""
    targetSignatureLineOut = 0
    targetImportcOut = false
    resultTypeOut = ""
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        return false
    let targetRes: Result[str] = langintern.LookupIntern(
        typedIr.internPool, typedIr.nodes2_callTargetIds[nodeIndex])
    let sourceRes: Result[str] = langintern.LookupIntern(
        typedIr.internPool, typedIr.nodes2_callTargetSourcePathIds[nodeIndex])
    let resultRes: Result[str] = langintern.LookupIntern(
        typedIr.internPool, typedIr.nodes2_resultTypeIds[nodeIndex])
    if !IsOk(targetRes) || !IsOk(sourceRes) || !IsOk(resultRes):
        panic(Fmt"primary: exact call-node authority intern invalid node={nodeIndex}")
    targetNameOut = Value(targetRes)
    targetSourcePathOut = Value(sourceRes)
    resultTypeOut = Value(resultRes)
    targetSignatureLineOut = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.nodes2_callTargetSignatureLineNumbers,
        nodeIndex)
    targetImportcOut = typedIr.nodes2_callTargetImportcs[nodeIndex]
    if targetNameOut == "" && targetSourcePathOut == "":
        # 内征/内建调用节点(sizeof、primitive conversion、result 内征)按构造
        # 不携带函数声明身份(typed IR 追加门已拒绝真实调用裸奔),不是精确函数
        # 调用 —— 报告 not-exact,由调用方落回内征通道。
        return false
    if targetNameOut == "" || targetSourcePathOut == "" ||
       resultTypeOut == "" || resultTypeOut == "unknown" ||
       resultTypeOut == "call_expr" ||
       !PrimaryObjectMetadataTextStable(resultTypeOut):
        var diagNodeSurface = "<nointern>"
        let diagNodeSurfaceRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool, typedIr.nodes2_surfaceTextIds[nodeIndex])
        if IsOk(diagNodeSurfaceRes):
            diagNodeSurface = Value(diagNodeSurfaceRes)
        var diagNodeFn = "<nointern>"
        let diagNodeFnRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool, typedIr.nodes2_functionNameIds[nodeIndex])
        if IsOk(diagNodeFnRes):
            diagNodeFn = Value(diagNodeFnRes)
        var diagNodeSource = "<nointern>"
        let diagNodeSourceRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool, typedIr.nodes2_sourcePathIds[nodeIndex])
        if IsOk(diagNodeSourceRes):
            diagNodeSource = Value(diagNodeSourceRes)
        let diagNodeLine = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.nodes2_lineNumbers, nodeIndex)
        panic(Fmt"primary: exact call-node authority incomplete node={nodeIndex} source={targetSourcePathOut} target={targetNameOut} result={resultTypeOut} surface={diagNodeSurface} fn={diagNodeFn} node_source={diagNodeSource} line={diagNodeLine}")
    var exactReturnType = ""
    if targetImportcOut:
        if targetSignatureLineOut != 0:
            panic(Fmt"primary: exact importc call-node carries signature line node={nodeIndex} signature_line={targetSignatureLineOut}")
        exactReturnType = PrimaryBodyIrExactImportcAuthorityResultType(
            typedIr,
            strings.CloneStr(targetSourcePathOut),
            strings.CloneStr(targetNameOut))
    else:
        if targetSignatureLineOut <= 0:
            panic(Fmt"primary: exact function call-node lacks signature line node={nodeIndex} source={targetSourcePathOut} target={targetNameOut}")
        var exactTargetIndex: int32
        exactReturnType = PrimaryBodyIrExactCallAuthorityResultType(
            typedIr,
            strings.CloneStr(targetSourcePathOut),
            strings.CloneStr(targetNameOut),
            targetSignatureLineOut,
            false,
            exactTargetIndex)
    if exactReturnType != resultTypeOut:
        panic(Fmt"primary: exact call-node result authority drift node={nodeIndex} source={targetSourcePathOut} target={targetNameOut} signature_line={targetSignatureLineOut} node_type={resultTypeOut} exact_type={exactReturnType}")
    return true

@borrows
fn PrimaryBodyIrExactCallNodeOrdinal(
    irFunction: lower.PrimaryObjectIrFunction,
    typedIr: texpr.TypedExprIr,
    nodeIndex: int32,
    callArgCount: int32
): int32 =
    var targetSourcePath = ""
    var targetName = ""
    var targetSignatureLine: int32
    var targetImportc: bool
    var resultType = ""
    if callArgCount < 0 ||
       !PrimaryBodyIrExactCallNodeAuthority(typedIr,
                                             nodeIndex,
                                             targetSourcePath,
                                             targetName,
                                             targetSignatureLine,
                                             targetImportc,
                                             resultType):
        return -1
    var foundOrdinal: int32 = -1
    for ordinal in 0..<irFunction.callTargets.len:
        if ordinal >= irFunction.callArgCounts.len ||
           ordinal >= irFunction.callTargetSourcePaths.len ||
           ordinal >= irFunction.callTargetSignatureLineNumbers.len ||
           ordinal >= irFunction.callTargetImportcFlags.len ||
           ordinal >= irFunction.callImportcSymbols.len:
            panic("primary: call metadata columns incomplete during exact node lookup")
        if irFunction.callArgCounts[ordinal] != callArgCount ||
           irFunction.callTargets[ordinal] != targetName ||
           !texpr.TypedExprSourcePathsEquivalent(
               irFunction.callTargetSourcePaths[ordinal], targetSourcePath) ||
           irFunction.callTargetSignatureLineNumbers[ordinal] !=
               targetSignatureLine ||
           irFunction.callTargetImportcFlags[ordinal] != targetImportc:
            continue
        if foundOrdinal < 0:
            foundOrdinal = ordinal
    return foundOrdinal

@borrows
fn PrimaryBodyIrMaterializeStrSeqLiteralArgSlot(bodyIR: var coreir.BodyIR,
                                                slotNames: var str[],
                                                varI32ParamNames: str[],
                                                lowering: var lower.LoweringPlanStub,
                                                typedFn: texpr.TypedExprIrFunction,
                                                irFunction: lower.PrimaryObjectIrFunction,
                                                sourcePath: str,
                                                lineNumber: int32,
                                                argNodeIndex: int32,
                                                argText: str,
                                                uniqueTag: int32,
                                                callOrdinal: var int32): int32 =
    if len(argText) < 2 ||
       !PrimaryBodyIrTextByteCodeEquals(argText, 0, 91) ||
       !PrimaryBodyIrTextByteCodeEquals(argText, len(argText) - 1, 93):
        return -1
    let innerText = strutil.Strip(strings.SliceBytes(argText, 1, len(argText) - 2))
    if innerText == "":
        return -1
    let elements = texpr.TypedExprSplitTopLevelCsv(innerText)
    if elements.len <= 0:
        return -1
    if argNodeIndex < 0 || argNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
       lowering.typedIr.nodes2_opKinds[argNodeIndex] != texpr.TypedExprIrOpSeqLiteral:
        return -1
    var elementNodes: int32[]
    if !PrimaryBodyIrCollectArgLinkValueNodes(
        lowering.typedIr,
        arenamod.ArenaArrayInt32Get(lowering.typedIr.arena,
                                     lowering.typedIr.nodes2_operand0NodeIndexs,
                                     argNodeIndex),
        elementNodes) ||
       elementNodes.len != elements.len:
        panic(Fmt"primary: sequence literal text/node arity drift line={lineNumber} text_count={elements.len} node_count={elementNodes.len}")
    for elemProbeIndex in 0..<elementNodes.len:
        let elemProbeNode = elementNodes[elemProbeIndex]
        if lowering.typedIr.nodes2_opKinds[elemProbeNode] == texpr.TypedExprIrOpCallExpr:
            var elemTargetSource = ""
            var elemTargetName = ""
            var elemTargetSignature: int32
            var elemTargetImportc: bool
            var elemResultType = ""
            if !PrimaryBodyIrExactCallNodeAuthority(lowering.typedIr,
                                                     elemProbeNode,
                                                     elemTargetSource,
                                                     elemTargetName,
                                                     elemTargetSignature,
                                                     elemTargetImportc,
                                                     elemResultType) ||
               elemResultType != "str":
                return -1
        let elemProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       lowering,

                                                       share(typedFn),
                                                       irFunction,
                                                       elemProbeNode)
        if elemProbeKind != coreir.LocalStrTag:
            return -1
    let seqSlotName = Fmt"#strseqlit#t{lineNumber}#{uniqueTag}#{bodyIR.ops.len}"
    let seqSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                     slotNames,
                                                     seqSlotName,
                                                     coreir.LocalAggregateTag,
                                                     16,
                                                     8)
    if seqSlot < 0 ||
       !PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                         slotNames,
                                         seqSlot,
                                         callOrdinal):
        return -1
    # Baseline after probe: emit must not register call metadata beyond probed.
    let baselineCallTargetsLen = irFunction.callTargets.len
    let baselineCallTargetSourcePathsLen = irFunction.callTargetSourcePaths.len
    let baselineCallTargetSignatureLineNumbersLen =
        irFunction.callTargetSignatureLineNumbers.len
    let baselineCallTargetImportcFlagsLen = irFunction.callTargetImportcFlags.len
    let baselineCallImportcSymbolsLen = irFunction.callImportcSymbols.len
    for elemIndex in 0..<elementNodes.len:
        let elemSlot = PrimaryBodyIrEvalNode(bodyIR,
                                             slotNames,
                                             varI32ParamNames,
                                             lowering,

                                             typedFn,
                                             irFunction,
                                             elementNodes[elemIndex],
                                             callOrdinal)
        if elemSlot < 0 || elemSlot >= bodyIR.localSlots.len ||
           PrimaryBodyIrSlotType(bodyIR, elemSlot) != coreir.LocalStrTag:
            panic(Fmt"primary: sequence literal probe/emission drift line={lineNumber} element={elemIndex}")
        if !PrimaryBodyIrAppendSeqStrAddValueSlot(bodyIR,
                                                  slotNames,
                                                  seqSlot,
                                                  elemSlot,
                                                  callOrdinal):
            panic(Fmt"primary: sequence literal append failed after exact probe line={lineNumber} element={elemIndex}")
    if irFunction.callTargets.len != baselineCallTargetsLen ||
       irFunction.callTargetSourcePaths.len != baselineCallTargetSourcePathsLen ||
       irFunction.callTargetSignatureLineNumbers.len !=
           baselineCallTargetSignatureLineNumbersLen ||
       irFunction.callTargetImportcFlags.len != baselineCallTargetImportcFlagsLen ||
       irFunction.callImportcSymbols.len != baselineCallImportcSymbolsLen:
        panic(Fmt"primary: sequence literal emission registered unprobed call metadata line={lineNumber}")
    return seqSlot

# Pure-subscript splitter: `base[inner]` where base is a bare ident (no `.`/`[`
# of its own). Loop isolated here so the rescue helper stays loop-free (cold
# compiler body budget). Returns false for chains the IndexedMember*/SeqIndex
# handlers own (base carrying its own `.` or `[`).
@borrows
fn PrimaryBodyIrSubscriptSplitBaseInner(textRaw: str,
                                         baseOut: var str,
                                         innerOut: var str): bool =
    baseOut = ""
    innerOut = ""
    let text = strutil.Strip(textRaw)
    if len(text) < 4 || !PrimaryBodyIrTextByteCodeEquals(text, len(text) - 1, 93):
        return false
    var depth: int32
    var scan = len(text) - 1
    var openPos: int32 = -1
    while scan >= 0:
        if PrimaryBodyIrTextByteCodeEquals(text, scan, 93):
            depth = depth + 1
        elif PrimaryBodyIrTextByteCodeEquals(text, scan, 91):
            depth = depth - 1
            if depth == 0:
                openPos = scan
                break
        scan = scan - 1
    if openPos <= 0:
        return false
    let baseText = strutil.Strip(strings.SliceBytes(text, 0, openPos))
    let innerText = strutil.Strip(strings.SliceBytes(text, openPos + 1, len(text) - openPos - 2))
    if baseText == "" || innerText == "":
        return false
    if PrimaryBodyIrTextHasFieldOrIndex(baseText):
        return false
    baseOut = baseText
    innerOut = innerText
    return true

# bail=44 rescue: a pure subscript `base[inner]` nested as a call arg is a
# runtime `[]` operator-CALL returning a by-value aggregate (e.g.
# json.GetStr(node["uri"])). 配 A-minimal([] 现在在 typedIr.functions),物化进
# typed temp slot 经 AppendCallOp 发射。Returns -1 if [] unresolvable → bail=44 原样。
# bail=44 R1: 嵌套调用实参的合成 sub-stmt 原先硬编码 rhsNodeIndex=-1,
# AppendCallArgs 拿不到节点 → callarg_fi_node_missing (聚合/str 元素无按值
# 物化路)。本 helper 做守卫式节点回挂:候选节点(外层语句节点树经 ArgLink
# 下钻所得)确为本调用的 CallExpr 节点(同 head)才返回其索引;不符返回 -1
# → 维持既有 poison,绝不错挂异调用节点(错挂 = 实参错位 miscompile)。
@borrows
fn PrimaryBodyIrWholeCallStmtNodeIndex(typedIr: texpr.TypedExprIr,
                                        candidateNodeIndex: int32,
                                        callHead: str): int32 =
    if candidateNodeIndex < 0 || candidateNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return -1
    if typedIr.nodes2_opKinds[candidateNodeIndex] != texpr.TypedExprIrOpCallExpr:
        return -1
    let wcsnHeadRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_literalTextIds[candidateNodeIndex])
    if !IsOk(wcsnHeadRes) || Value(wcsnHeadRes) != callHead:
        return -1
    return candidateNodeIndex

@borrows
fn PrimaryBodyIrSubscriptOpCallArgSlot(bodyIR: var coreir.BodyIR,
                                        slotNames: var str[],
                                        varI32ParamNames: str[],
                                        lowering: var lower.LoweringPlanStub,
                                        typedFn: texpr.TypedExprIrFunction,
                                        irFunction: lower.PrimaryObjectIrFunction,
                                        sourcePath: str,
                                        lineNumber: int32,
                                        textRaw: str,
                                        argNodeIndex: int32,
                                        callOrdinal: var int32): int32 =
    var baseText = ""
    var innerText = ""
    if !PrimaryBodyIrSubscriptSplitBaseInner(textRaw, baseText, innerText):
        return -1
    # JsonNode base → emit json.JsonGetField(常规名,A-minimal 保留可解析);算子名 []
    # 不经 resolver 匹配。非 Aggregate base 仍试 [] 算子(数组/映射)。
    let typedFnSourcePath = typedFn.sourcePath
    let typedFnName = typedFn.functionName
    let opBaseSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, baseText)
    let opBaseIsAggregate =
        opBaseSlot >= 0 && opBaseSlot < bodyIR.localSlots.len &&
        PrimaryBodyIrSlotType(bodyIR, opBaseSlot) == coreir.LocalAggregateTag
    let opCallHead = if opBaseIsAggregate: "json.JsonGetField" else: "[]"
    var opRetType = ""
    let opOrd = PrimaryBodyIrResolvedOrRegisteredWholeCallOrdinal(irFunction,
                                                                  lowering.typedIr,
                                                                  sourcePath,
                                                                  opCallHead,
                                                                  2,
                                                                  opRetType)
    if opOrd < 0 || opOrd >= irFunction.callTargets.len ||
       opOrd >= irFunction.callTargetSourcePaths.len ||
       opOrd >= irFunction.callTargetSignatureLineNumbers.len ||
       opOrd >= irFunction.callTargetImportcFlags.len ||
       opRetType == "" || opRetType == "void":
        return -1
    let tempSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                       slotNames,
                                                       lowering.typedIr,
                                                       sourcePath,
                                                       Fmt"#sub_op_call#{lineNumber}#{bodyIR.ops.len}",
                                                       opRetType)
    if tempSlot < 0 || tempSlot >= bodyIR.localSlots.len:
        return -1
    var subStmt: lower.PrimaryObjectIrStatement
    subStmt.sourcePath = typedFnSourcePath
    subStmt.functionName = typedFnName
    subStmt.lineNumber = lineNumber
    subStmt.kind = texpr.TypedExprIrStmtLetCall
    subStmt.callKind = texpr.TypedExprCallNone
    # bail=44 R1: 外层实参节点(若确为本 op 调用的 CallExpr)回挂,
    # AppendCallArgs 才能走 node 臂;不符维持 -1 → 既有 poison。
    subStmt.rhsNodeIndex = PrimaryBodyIrWholeCallStmtNodeIndex(lowering.typedIr,
                                                               argNodeIndex,
                                                               opCallHead)
    subStmt.surfaceText = strings.CloneStr(opCallHead)
    subStmt.bindingName = bodyIR.localSlots[tempSlot].name
    subStmt.resultType = opRetType
    subStmt.conditionKind = texpr.TypedExprIrCondNone
    subStmt.assignPlaceKind = texpr.TypedExprPlaceTemporary
    subStmt.assignValueOpKind = texpr.TypedExprIrOpUnsupported
    subStmt.callCallee = opCallHead
    subStmt.callTarget = irFunction.callTargets[opOrd]
    subStmt.callTargetSourcePath = irFunction.callTargetSourcePaths[opOrd]
    subStmt.callTargetSignatureLineNumber =
        irFunction.callTargetSignatureLineNumbers[opOrd]
    subStmt.callTargetImportc = irFunction.callTargetImportcFlags[opOrd]
    subStmt.callArgCount = 2
    subStmt.callArgsText = strutil.Join([strings.CloneStr(baseText), strings.CloneStr(innerText)], ",")
    subStmt.returnRoot = false
    var subCallBlockStart: int32 = -1
    let emitSlot = PrimaryBodyIrAppendCallOp(bodyIR,
                                             slotNames,
                                             lowering,

                                             typedFn,
                                             irFunction,
                                             subStmt,
                                             tempSlot,
                                             varI32ParamNames,
                                             callOrdinal,
                                             subCallBlockStart)
    if emitSlot != tempSlot:
        return -1
    return tempSlot

# BACKFILL-2/T25C (f24 33f086d, 缺口③): identifies call-argument text that
# PrimaryBodyIrAppendCallArgs (below) and PrimaryBodyIrScalarValueSlotForText
# materialize into a slot NAMED after the literal's own text (a cache keyed by
# value, shared across the whole function) rather than a normal named local/
# param slot (keyed by a stable declaration that dominates every read).
# Reusing an already-found slot for these via PrimaryBodyIrFindArgSlot is
# unsound when the same literal text is used as an argument in two different
# real-branch blocks (see the call site's write-up) — the caller uses this to
# force literal arguments through fresh (re-)materialization at every call
# site instead.
@borrows
fn PrimaryBodyIrCallArgTextIsBareLiteralConstant(argNameRaw: str): bool =
    let argName = strutil.Strip(argNameRaw)
    if argName == "true" || argName == "false":
        return true
    if PrimaryBodyIrTextIsStringLiteral(argName):
        return true
    if PrimaryBodyIrTextIsF64Literal(argName):
        return true
    var digitsText = argName
    if len(digitsText) > 1 && digitsText[0] == '-':
        digitsText = strings.SliceBytes(digitsText, 1, len(digitsText) - 1)
    if len(digitsText) <= 0:
        return false
    for i in 0..<len(digitsText):
        if digitsText[i] < '0' || digitsText[i] > '9':
            return false
    return true

@borrows
fn PrimaryBodyIrNodeIsShortCircuitChainRoot(typedIr: texpr.TypedExprIr,
                                             nodeIndex: int32): bool =
    var rootNode = nodeIndex
    while rootNode >= 0 && rootNode < typedIr.nodes2_nodeIndexs.len &&
          typedIr.nodes2_opKinds[rootNode] == texpr.TypedExprIrOpLogNot:
        let innerNode = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                    typedIr.nodes2_operand0NodeIndexs,
                                                    rootNode)
        if innerNode < 0 || innerNode >= rootNode:
            return false
        rootNode = innerNode
    if rootNode < 0 || rootNode >= typedIr.nodes2_nodeIndexs.len:
        return false
    return typedIr.nodes2_opKinds[rootNode] == texpr.TypedExprIrOpLogAnd ||
           typedIr.nodes2_opKinds[rootNode] == texpr.TypedExprIrOpLogOr

@borrows
fn PrimaryBodyIrMaterializeVarFieldAddressSlot(bodyIR: var coreir.BodyIR,
                                                slotNames: var str[],
                                                typedIr: texpr.TypedExprIr,
                                                typedFn: texpr.TypedExprIrFunction,
                                                irFunction: lower.PrimaryObjectIrFunction,
                                                stmt: lower.PrimaryObjectIrStatement,
                                                argIndex: int32,
                                                argName: str,
                                                targetParamType: str): int32 =
    # [wall148] var 性判定双拼写：既有 var 前缀或内部借用标记拼写。
    var mvfaBorrowMarkerInner = ""
    if !PrimaryBodyIrTypeTextIsVarParam(targetParamType) &&
       !texpr.TypedExprCallBorrowModeInner(targetParamType, mvfaBorrowMarkerInner):
        return -1
    if !texpr.TypedExprTextIsSimpleFieldPath(argName):
        return -1
    var targetKind: int32
    var targetSize: int32
    var targetAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   stmt.callTargetSourcePath,
                                   PrimaryBodyIrVarParamRuntimeInnerType(targetParamType),
                                   targetKind,
                                   targetSize,
                                   targetAlign)
    if targetKind == coreir.LocalInvalidTag || targetSize <= 0 || targetAlign <= 0:
        return -1

    var rootSlot: int32 = -1
    var totalOffset: int32
    var fieldKind = coreir.LocalInvalidTag
    var fieldSize: int32
    var fieldAlign: int32
    let argNodeIndex = PrimaryBodyIrStatementCallArgNodeIndexAt(typedIr,
                                                                 stmt,
                                                                 stmt.rhsNodeIndex,
                                                                 argIndex)
    if argNodeIndex >= 0 &&
       PrimaryBodyIrVarArgFieldPathInfo(bodyIR,
                                        slotNames,
                                        typedIr,
                                        argNodeIndex,
                                        rootSlot,
                                        totalOffset):
        PrimaryBodyIrNodeValueTypeShape(typedIr,
                                        argNodeIndex,
                                        fieldKind,
                                        fieldSize,
                                        fieldAlign)

    if rootSlot < 0:
        let rootName = texpr.TypedExprAssignLhsRootName(argName)
        let fieldPath = texpr.TypedExprAssignFieldPath(argName)
        let rootType = PrimaryBodyIrBindingTypeForName(typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       stmt.lineNumber,
                                                       rootName)
        var fieldType = ""
        if rootName == "" || fieldPath == "" || rootType == "" ||
           !PrimaryObjectMetadataTextStable(rootType) ||
           !PrimaryBodyIrLookupFieldPathMeta(typedIr,
                                             stmt.sourcePath,
                                             texpr.TypedExprStripVarType(rootType),
                                             fieldPath,
                                             fieldType,
                                             totalOffset,
                                             fieldSize,
                                             fieldAlign):
            return -1
        rootSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                          slotNames,
                                                          typedIr,
                                                          stmt.sourcePath,
                                                          rootName,
                                                          rootType)
        if rootSlot < 0 || rootSlot >= bodyIR.localSlots.len ||
           PrimaryBodyIrVarParamPointeeKind(bodyIR, rootSlot) != coreir.LocalInvalidTag ||
           (PrimaryBodyIrSlotType(bodyIR, rootSlot) != coreir.LocalAggregateTag &&
            PrimaryBodyIrSlotType(bodyIR, rootSlot) != coreir.LocalPtrTag):
            return -1
        var resolvedFieldSize: int32
        var resolvedFieldAlign: int32
        PrimaryBodyIrTypeShapeFromText(typedIr,
                                       stmt.sourcePath,
                                       fieldType,
                                       fieldKind,
                                       resolvedFieldSize,
                                       resolvedFieldAlign)
        if resolvedFieldSize != fieldSize || resolvedFieldAlign != fieldAlign:
            return -1

    if totalOffset < 0 || fieldKind != targetKind ||
       fieldSize != targetSize || fieldAlign != targetAlign:
        return -1
    # [wall148] var 借用视图形参根先解一跳句柄槽得对象基址（校验后发射，
    # 被拒路径零发射契约不变）。
    let borrowBaseSlot = PrimaryBodyIrMaterializeVarBorrowBase(bodyIR,
                                                                slotNames,
                                                                typedIr,
                                                                argNodeIndex,
                                                                rootSlot,
                                                                Fmt"#vfaddr#field#{stmt.lineNumber}#{argIndex}#{bodyIR.ops.len}")
    if borrowBaseSlot < 0:
        return -1
    let offsetSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                      slotNames,
                                                      Fmt"#vfaddr#field#{stmt.lineNumber}#{argIndex}#{bodyIR.ops.len}#off",
                                                      coreir.LocalI64Tag,
                                                      totalOffset)
    let addressSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#vfaddr#field#{stmt.lineNumber}#{argIndex}#{bodyIR.ops.len}",
                                                     coreir.LocalPtrTag)
    if offsetSlot < 0 || addressSlot < 0:
        return -1
    var addressOp: coreir.BodyOp
    addressOp.kind = coreir.BodyOpBinOpTag
    addressOp.target = addressSlot
    add(addressOp.operands, coreir.LocalI64Tag)
    add(addressOp.operands, int32(texpr.TypedExprIrOpI32Add))
    add(addressOp.operands, borrowBaseSlot)
    add(addressOp.operands, offsetSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, addressOp)
    return addressSlot

@borrows
fn PrimaryBodyIrAppendCallArgs(bodyIR: var coreir.BodyIR,
                                slotNames: var str[],
                                call: var coreir.CallOp,
                                lowering: var lower.LoweringPlanStub,
                                typedFn: texpr.TypedExprIrFunction,
                                irFunction: lower.PrimaryObjectIrFunction,
                                stmt: lower.PrimaryObjectIrStatement,
                                varI32ParamNames: str[],
                                callOrdinal: var int32,
                                currentBlockStart: var int32,
                                failureDetail0: var int32,
                                failureDetail1: var int32,
                                failureAlreadyPoisoned: var bool): bool =
    failureAlreadyPoisoned = false
    if stmt.callArgCount <= 0:
        return true
    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
        # P1 consumer expand: 4→15 case label dispatch via helper (append_call_args).
        let reasonLabel = texpr.TypedExprIrRhsBailReasonLabel(stmt.rhsBailReason)
        os.WriteLine(os.GetStderr(), Fmt"phase=append_call_args_entry fn={stmt.functionName} line={stmt.lineNumber} reason_label={reasonLabel}")

    let argNames = PrimaryBodyIrCallArgNames(strings.CloneStr(stmt.callArgsText))
    for argIndex in 0..<argNames.len:
        let argName = argNames[argIndex]
        let targetParamType = PrimaryBodyIrResolvedTargetParamType(lowering,

                                                                   stmt,
                                                                   argIndex,
                                                                   "append_call_args",
                                                                   callOrdinal)
        let targetParamTypeNorm = texpr.TypedExprNormalizeTypeText(targetParamType)
        # [wall148] var 性第一权威 = 结构列（[wall131] 同源裁定），文本 fallback
        # 仅兜底。文本权威实测丢 var 前缀（var Box → 内部借用标记拼写），
        # 判定失真即借用视图实参降级值通道（v6 SIGSEGV 根因）。
        let targetNeedsAddress =
            PrimaryBodyIrTypedParamMutableAt(lowering,
                                              stmt.callTargetSourcePath,
                                              stmt.callTarget,
                                              argIndex) == 1 ||
            PrimaryBodyIrTypeTextIsVarParam(targetParamType)
        # A logical call argument owns control flow, so route its typed ArgLink
        # root before any literal/field/text value realizer can append eager
        # operands. Probe and emission are atomic at this dispatch boundary:
        # failure hard-stops this call and never falls through to an eager path.
        let structuredArgNodeIndex = PrimaryBodyIrStatementCallArgNodeIndexAt(
            lowering.typedIr,
            stmt,
            stmt.rhsNodeIndex,
            argIndex)
        if PrimaryBodyIrNodeIsShortCircuitChainRoot(lowering.typedIr,
                                                     structuredArgNodeIndex):
            if targetNeedsAddress || currentBlockStart < 0:
                failureDetail0 = 44
                failureDetail1 = argIndex
                return false
            var structuredArgSlot: int32
            # call var unique authority: AppendCallArgs 的 irFunction 为非 var 形参,
            # BoolConditionChain/Abort/Rollback 形参保持 var。裸传或 `var x = irFunction`
            # 都是共享载体(BORROW_SHARED)过不了 unique 门。正形=空构造 + 字段级
            # CloneStr/PlanClone*Array(与 MaterializeStrSeqLiteralArgSlot 诊断正形同构),
            # 得到唯一载体后再传入;成功/回滚后把 call 行元数据写回原 irFunction
            # (add/下标写, 非 var 形参下与 AppendResolvedCallTargetFields 同口径)。
            var boolChainIrFunction: lower.PrimaryObjectIrFunction
            boolChainIrFunction.sourcePath = strings.CloneStr(irFunction.sourcePath)
            boolChainIrFunction.functionName = strings.CloneStr(irFunction.functionName)
            boolChainIrFunction.signatureLineNumber = irFunction.signatureLineNumber
            boolChainIrFunction.bodyLineNumber = irFunction.bodyLineNumber
            boolChainIrFunction.bodyKind = strings.CloneStr(irFunction.bodyKind)
            boolChainIrFunction.typedFunctionIndex = irFunction.typedFunctionIndex
            boolChainIrFunction.paramNames = PrimaryObjectPlanCloneStrArray(irFunction.paramNames)
            boolChainIrFunction.paramTypes = PrimaryObjectPlanCloneStrArray(irFunction.paramTypes)
            boolChainIrFunction.statementCount = irFunction.statementCount
            boolChainIrFunction.callTargetCount = irFunction.callTargetCount
            boolChainIrFunction.callArgCounts = PrimaryObjectPlanCloneI32Array(irFunction.callArgCounts)
            boolChainIrFunction.callTargets = PrimaryObjectPlanCloneStrArray(irFunction.callTargets)
            boolChainIrFunction.callTargetSourcePaths = PrimaryObjectPlanCloneStrArray(irFunction.callTargetSourcePaths)
            boolChainIrFunction.callTargetSignatureLineNumbers = PrimaryObjectPlanCloneI32Array(irFunction.callTargetSignatureLineNumbers)
            boolChainIrFunction.callTargetImportcFlags = PrimaryObjectPlanCloneBoolArray(irFunction.callTargetImportcFlags)
            boolChainIrFunction.callTargetTypedFunctionIndexes = PrimaryObjectPlanCloneI32Array(irFunction.callTargetTypedFunctionIndexes)
            boolChainIrFunction.callImportcSymbols = PrimaryObjectPlanCloneStrArray(irFunction.callImportcSymbols)
            boolChainIrFunction.callArgTypesTexts = PrimaryObjectPlanCloneStrArray(irFunction.callArgTypesTexts)
            let structuredArgOutcome = PrimaryBodyIrAppendNodeBoolConditionChain(
                bodyIR,
                slotNames,
                varI32ParamNames,
                lowering,

                typedFn,
                boolChainIrFunction,
                structuredArgNodeIndex,
                callOrdinal,
                currentBlockStart,
                structuredArgSlot)
            # 写回 call 行: 仅尾部 add 增长(原数组仍是调用方共享缓冲)。
            # JournalIrCallRowBeforeWrite 无调用点, Success 路径只 append 新行;
            # 禁止 irFunction.callTargets[i]=... 下标写(inline sequence field projection 门)。
            while irFunction.callTargets.len < boolChainIrFunction.callTargets.len:
                let boolChainSyncJ = irFunction.callTargets.len
                add(irFunction.callArgCounts, boolChainIrFunction.callArgCounts[boolChainSyncJ])
                add(irFunction.callTargets, strings.CloneStr(boolChainIrFunction.callTargets[boolChainSyncJ]))
                add(irFunction.callTargetSourcePaths, strings.CloneStr(boolChainIrFunction.callTargetSourcePaths[boolChainSyncJ]))
                add(irFunction.callTargetSignatureLineNumbers, boolChainIrFunction.callTargetSignatureLineNumbers[boolChainSyncJ])
