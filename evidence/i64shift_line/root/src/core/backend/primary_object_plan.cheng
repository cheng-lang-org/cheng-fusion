            if PrimaryBodyIrResultErrorSourceSlot(bodyIR, slotNames, lowering.typedIr, nodeIndex) >= 0:
                return coreir.LocalStrTag
            return PrimaryBodyIrNodeEvalMissAt("call_special_head")
        if probeCallHeadLeaf == "ErrorInfoOf":
