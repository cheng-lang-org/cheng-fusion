                let probeEcMsgKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering,

                                                                typedFn,
                                                                irFunction,
                                                                probeRcArgNodes[1])
                if probeEcMsgKind < 0:
