               !PrimaryBodyIrTextHasFieldOrIndex(qualEnumMember):
                var qualEnumTargetSource = texpr.TypedExprIrLookupTypeAliasTargetSourcePath(lowering.typedIr,
                                                                                            strings.CloneStr(stmt.sourcePath),
                                                                                            qualEnumQualifier)
                if qualEnumTargetSource == "":
                    qualEnumTargetSource = PrimaryBodyIrCanonicalImportTargetSourcePath(lowering.typedIr,
                                                                                         strings.CloneStr(stmt.sourcePath),
                                                                                         qualEnumQualifier)
                if qualEnumTargetSource != "":
                    qualEnumFound = texpr.TypedExprIrLookupEnumConstValueInSource(lowering.typedIr,
                                                                                  qualEnumTargetSource,
                                                                                  qualEnumMember,
                                                                                  qualEnumValue)
            if qualEnumFound:
                if targetParamType != "":
                    var qualEnumExpectKind: int32
                    var qualEnumExpectSize: int32
                    var qualEnumExpectAlign: int32
                    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                   strings.CloneStr(stmt.sourcePath),
                                                   texpr.TypedExprStripVarType(targetParamType),
                                                   qualEnumExpectKind,
                                                   qualEnumExpectSize,
                                                   qualEnumExpectAlign)
                    if qualEnumExpectKind != coreir.LocalInvalidTag &&
                       qualEnumExpectKind != coreir.LocalI32Tag:
                        failureDetail0 = 44
                        failureDetail1 = argIndex
                        return false
                let qualEnumSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                 slotNames,
                                                                 strutil.Join(["#qualenum#", strings.CloneStr(argName), "#", strings.IntToStr(callOrdinal), "#", strings.IntToStr(argIndex)], ""),
                                                                 coreir.LocalI32Tag)
                if qualEnumSlot < 0:
                    failureDetail0 = 44
                    failureDetail1 = argIndex
                    return false
                var qualEnumLoadOp: coreir.BodyOp
                qualEnumLoadOp.kind = coreir.BodyOpLoadConstTag
                qualEnumLoadOp.target = qualEnumSlot
                add(qualEnumLoadOp.operands, coreir.LocalI32Tag)
                add(qualEnumLoadOp.operands, qualEnumValue)
                let _ = coreir.BodyIRAppendOp(bodyIR, qualEnumLoadOp)
                add(call.argSlots, qualEnumSlot)
                add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
                continue
            # bail=44 Root A (str 常量): 跨模块限定 const 字符串 call-arg
            # (cert.FinanceDialectVersion = "csg_dialect::finance::current" 等)。qualConst 只解
            # i32 常量、qualEnum 只解枚举成员, 值为字符串常量的跨模块限定引用两臂皆
            # miss → 落 MaterializeFieldArgSlot 把 `cert` 当 binding 查型 = 空 → bail_44。
            # 前端已在 ArgLink 链把该实参解析并建成 StrLit 叶 (const 字面量已入节点),
            # 取该实参节点经 EvalNode 物化成定形 str 槽 (与上方 Fmt-arg 同范式)。
            # 严格限定: qualifier 必须解析为 import/type 别名模块源 (排除局部 binding
            # 字段路径, 那类走下方 MaterializeField 不受影响, 无回归), 且目标形参型
            # 折为 str。poison-on-miss: 节点缺失/求值非 str → failureDetail0=44 落回 bail,
            # 绝不静默落穿弱文本路径读栈垃圾。
            if texpr.TypedExprNormalizeTypeText(targetParamType) == "str":
                let qcsQualifier = texpr.TypedExprAssignLhsRootName(argName)
                let qcsMember = texpr.TypedExprAssignFieldPath(argName)
                if qcsQualifier != "" &&
                   qcsMember != "" &&
                   !PrimaryBodyIrTextHasFieldOrIndex(qcsMember):
                    var qcsTargetSource = texpr.TypedExprIrLookupTypeAliasTargetSourcePath(lowering.typedIr,
                                                                                           strings.CloneStr(stmt.sourcePath),
                                                                                           qcsQualifier)
                    if qcsTargetSource == "":
                        qcsTargetSource = PrimaryBodyIrCanonicalImportTargetSourcePath(lowering.typedIr,
                                                                                        strings.CloneStr(stmt.sourcePath),
                                                                                        qcsQualifier)
                    if qcsTargetSource != "":
                        let qcsArgNodeIndex = PrimaryBodyIrStatementCallArgNodeIndexAt(lowering.typedIr,
                                                                                       stmt,
                                                                                       stmt.rhsNodeIndex,
                                                                                       argIndex)
                        if qcsArgNodeIndex < 0:
                            failureDetail0 = 44
                            failureDetail1 = argIndex
                            return false
                        let qcsArgSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering,

                                                               share(typedFn),
                                                               irFunction,
                                                               qcsArgNodeIndex,
                                                               callOrdinal)
                        if qcsArgSlot < 0 ||
                           qcsArgSlot >= bodyIR.localSlots.len ||
                           PrimaryBodyIrSlotType(bodyIR, qcsArgSlot) != coreir.LocalStrTag:
                            failureDetail0 = 44
                            failureDetail1 = argIndex
                            return false
                        add(call.argSlots, qcsArgSlot)
                        add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
                        continue
            var simpleFieldMatDetail0: int32
            var simpleFieldMatDetail1: int32
            let simpleFieldArgSlot = PrimaryBodyIrMaterializeFieldArgSlot(bodyIR,
                                                                         slotNames,
                                                                         lowering.typedIr,
                                                                         typedFn,
                                                                         irFunction,
                                                                         strings.CloneStr(stmt.sourcePath),
                                                                         stmt.lineNumber,
                                                                         argName,
                                                                         simpleFieldMatDetail0,
                                                                         simpleFieldMatDetail1)
            if simpleFieldArgSlot < 0 ||
               simpleFieldArgSlot >= bodyIR.localSlots.len:
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=callarg_simplefield_mat_fail function={strings.CloneStr(typedFn.functionName)} line={stmt.lineNumber} argIndex={argIndex} argName={argName} detail={simpleFieldMatDetail0}")
                failureDetail0 = 44
                failureDetail1 = argIndex
                return false
            if targetParamType != "":
                var simpleFieldExpectKind: int32
                var simpleFieldExpectSize: int32
                var simpleFieldExpectAlign: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               strings.CloneStr(stmt.sourcePath),
                                               texpr.TypedExprStripVarType(targetParamType),
                                               simpleFieldExpectKind,
                                               simpleFieldExpectSize,
                                               simpleFieldExpectAlign)
                let simpleFieldGotKind = PrimaryBodyIrSlotType(bodyIR, simpleFieldArgSlot)
                if simpleFieldExpectKind != coreir.LocalInvalidTag &&
                   simpleFieldExpectKind != simpleFieldGotKind:
                    # bail=44 R2 亚族: i32 simple-field 实参对 i64 形参
                    # (如 CompilerCsgAppendU32BE(buf, text.len))。与文本路
                    # let/assign 既有 widening 语义一致: CopyLocal i32→i64 槽
                    # = sign-extend widen 后放行 (样板 :9678/:12879)。
                    # 其余 kind 不等仍 poison → bail_44。
                    if simpleFieldExpectKind == coreir.LocalI64Tag &&
                       simpleFieldGotKind == coreir.LocalI32Tag:
                        let simpleFieldWidenSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                 slotNames,
                                                                                 strutil.Join(["#sfwiden#", strings.IntToStr(callOrdinal), "#a", strings.IntToStr(argIndex)], ""),
                                                                                 coreir.LocalI64Tag)
                        if simpleFieldWidenSlot < 0:
                            failureDetail0 = 44
                            failureDetail1 = argIndex
                            return false
                        var simpleFieldWidenOp: coreir.BodyOp
                        simpleFieldWidenOp.kind = coreir.BodyOpCopyLocalTag
                        simpleFieldWidenOp.target = simpleFieldWidenSlot
                        add(simpleFieldWidenOp.operands, simpleFieldArgSlot)
                        let _ = coreir.BodyIRAppendOp(bodyIR, simpleFieldWidenOp)
                        add(call.argSlots, simpleFieldWidenSlot)
                        add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
                        continue
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=callarg_simplefield_kind_mismatch function={strings.CloneStr(typedFn.functionName)} line={stmt.lineNumber} argIndex={argIndex} argName={argName} expect={simpleFieldExpectKind} got={simpleFieldGotKind}")
                    failureDetail0 = 44
                    failureDetail1 = argIndex
                    return false
            var simpleFieldPassSlot = simpleFieldArgSlot
            if PrimaryBodyIrSlotType(bodyIR, simpleFieldArgSlot) == coreir.LocalAggregateTag:
                let simpleFieldCopySlot = PrimaryBodyIrByValAggregateArgCopySlot(bodyIR,
                                                                                slotNames,
                                                                                simpleFieldArgSlot,
                                                                                callOrdinal,
                                                                                argIndex)
                if simpleFieldCopySlot < 0 ||
                   simpleFieldCopySlot >= bodyIR.localSlots.len:
                    failureDetail0 = 44
                    failureDetail1 = argIndex
                    return false
                simpleFieldPassSlot = simpleFieldCopySlot
            add(call.argSlots, simpleFieldPassSlot)
            add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
        elif !targetNeedsAddress &&
             PrimaryBodyIrFindArgSlot(bodyIR, slotNames, argName) < 0 &&
             PrimaryBodyIrPtrAddressArgName(argName) == "" &&
             PrimaryBodyIrTextHasFieldOrIndex(argName):
            # wave6 R-D 门修: 与上方 simplefield 臂同款 — PtrAddressArgName 能
            # 认领的取址形 (&a.value / &arr[0] / ptr(&x.y)) 放行到 19414 取址臂。
            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1" && argIndex == 0:
                os.WriteLine(os.GetStderr(), Fmt"phase=callarg_fi_elif_match function={strings.CloneStr(typedFn.functionName)} line={stmt.lineNumber} argName={argName}")
            # Field-access / index-access / 复合 expression call-arg
            # (e.g. dst.data, tree.styles[i].marginLeft, dst.data != nil)
            # 纯标量 call-arg 文本路径不识别 . 或 [], 直接落 bail_44。
            # node-eval 下降: 取该实参节点, 经 EvalNode 物化(支持 FieldGet/IndexGet/
            # CmpNe/BinOp/NilPtr 等组合形)成 slot, 兼容 targetParamType (任何
            # local slot kind 均可作 stack value 传递)。
            # poison-on-miss: 节点缺失/求值失败→bail_44, 不静默落穿弱路径。
            # bail=44 Root B (阶段 10, 6 条): argName 形如 `mod.fn(args)` qualified-call
            # 作 nested call-arg。EvalNode 下降跨模块 Call 节点 lower 失败 → bail。
            # 改路:直接调 PrimaryBodyIrAppendWholeCallExprToSlot 把 argName 整体作
            # whole-call lower 进 tmp slot。G1 严等 expectKind 派生于 targetParamType,
            # 不匹配/任何失败 fall through 到下方 EvalNode 路径(双层 poison)。
            if targetParamType != "":
                let qualOpenPos = texpr.TypedExprFindWholeCallOpenParen(argName)
                if qualOpenPos > 0:
                    let qualClosePos = texpr.TypedExprFindMatchingParen(argName, qualOpenPos)
                    if qualClosePos > qualOpenPos && qualClosePos + 1 == len(argName):
                        let qualHead = strutil.Strip(strings.SliceBytes(argName, 0, qualOpenPos))
                        if texpr.TypedExprCallHeadIsPlainQualifiedIdent(qualHead):
                            var qualCallExpectKind: int32
                            var qualCallExpectSize: int32
                            var qualCallExpectAlign: int32
                            PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                           strings.CloneStr(stmt.sourcePath),
                                                           texpr.TypedExprStripVarType(targetParamType),
                                                           qualCallExpectKind,
                                                           qualCallExpectSize,
                                                           qualCallExpectAlign)
                            if qualCallExpectKind != coreir.LocalInvalidTag:
                                let qualCallSlotName = strutil.Join(["#qualcall#",
                                                                     strings.IntToStr(callOrdinal),
                                                                     "#a",
                                                                     strings.IntToStr(argIndex)], "")
                                let qualCallSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                 slotNames,
                                                                                 qualCallSlotName,
                                                                                 qualCallExpectKind)
                                if qualCallSlot >= 0 &&
                                   PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                                          slotNames,
                                                                          lowering,

                                                                          typedFn,
                                                                          irFunction,
                                                                          varI32ParamNames,
                                                                          argName,
                                                                          qualCallSlot,
                                                                          stmt.lineNumber,
                                                                          PrimaryBodyIrStatementCallArgNodeIndexAt(lowering.typedIr,
                                                                                                                   stmt,
                                                                                                                   stmt.rhsNodeIndex,
                                                                                                                   argIndex),
                                                                          callOrdinal) &&
                                   PrimaryBodyIrSlotType(bodyIR, qualCallSlot) == qualCallExpectKind:
                                    add(call.argSlots, qualCallSlot)
                                    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
                                    continue
            # bail=44 族B: argName 形如 `mod.Type(field: v, ...)` 嵌套聚合构造器
            # 实参 (如 multiaddress.MultiAddress(raw: "", data: EmptyBytes()) 作
            # streamconn.NewConnection(...) 的实参)。上方 qualcall 分支把 argName
            # 当函数调用走 WholeCallExprToSlot, 对类型构造器(非函数)其内部
            # resolvedOrdinal 必 <0 而静默让位(既有行为不变, 不受影响)。EvalNode
            # 的 OpCallExpr 分支同样只认 cast/IsErr/IsOk/Value/Error 等固定内征
            # 特例, 无聚合构造器分支, 落统一 MissAt → bail_44。复用已验证的
            # PrimaryBodyIrAppendAggregateConstructorToSlot helper 现有 11 处调用点
            # 含 let/index-store/seq-elem 等场景)按目标形参类型建槽逐字段物化,
            # 该物化器自身对 ctor head 做函数遮蔽检查(fail=6/7)与聚合形状精确匹配
            # (fail=8/9, 尺寸/kind 不符即拒), 是纯增量新分支, 不改任何既有已通过
            # 路径。poison-on-miss: 任何失败态不 continue, 落回下方既有 R3/
            # EvalNode 链继续尝试(双层 poison, 与本函数其余分支同款约定)。
            if targetParamType != "":
                var ctorArgExpectKind: int32
                var ctorArgExpectSize: int32
                var ctorArgExpectAlign: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               strings.CloneStr(stmt.sourcePath),
                                               texpr.TypedExprStripVarType(targetParamType),
                                               ctorArgExpectKind,
                                               ctorArgExpectSize,
                                               ctorArgExpectAlign)
                if ctorArgExpectKind == coreir.LocalAggregateTag && ctorArgExpectSize > 0:
                    let ctorArgSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                                         slotNames,
                                                                         strutil.Join(["#nevctorarg#", strings.IntToStr(callOrdinal), "#a", strings.IntToStr(argIndex)], ""),
                                                                         coreir.LocalAggregateTag,
                                                                         ctorArgExpectSize,
                                                                         ctorArgExpectAlign)
                    if ctorArgSlot >= 0 &&
                       PrimaryBodyIrAppendAggregateConstructorToSlot(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,

                                                                     typedFn,
                                                                     irFunction,
                                                                     argName,
                                                                     PrimaryBodyIrStatementCallArgNodeIndexAt(
                                                                         lowering.typedIr,
                                                                         stmt,
                                                                         stmt.rhsNodeIndex,
                                                                         argIndex),
                                                                     texpr.TypedExprStripVarType(targetParamType),
                                                                     strings.CloneStr(stmt.sourcePath),
                                                                     stmt.lineNumber,
                                                                     ctorArgSlot,
                                                                     callOrdinal * 131 + argIndex + 1,
                                                                     callOrdinal):
                        let ctorArgCopySlot = PrimaryBodyIrByValAggregateArgCopySlot(bodyIR,
                                                                                     slotNames,
                                                                                     ctorArgSlot,
                                                                                     callOrdinal,
                                                                                     argIndex)
                        if ctorArgCopySlot >= 0:
                            add(call.argSlots, ctorArgCopySlot)
                            add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
                            continue
            # R3 bail=44 misc 4 别形 (if-call / var=!call / subscript-lvalue= /
            # call-as-arg-in-add). fi-qualcall (:18272) 仅 targetParamType!="" 时
            # whole-call lower; targetParamType 空 (builtin 元素形参如 add) 时不匹配,
            # 落 EvalNode CallExpr 发射器, 内层 arg miss → bail_44.
            # form 4 (call-as-arg-in-add) 改路: targetParamType 空且 argName 含
            # call-surface 且 arg 节点确为 CallExpr 时, 按 call 节点 resultType 定形
            # 槽 whole-call lower (镜像 fi-qualcall targetParamType 派生). 成功
            # continue; 失败 fall through 到下方 drill-down + EvalNode descent
            # (节点位 CallExpr 发射器同源再试, 双层 poison; 仍 miss → bail_44).
            if targetParamType == "" &&
               PrimaryBodyIrTextHasCallSurface(argName):
                let r3CaOpenPos = texpr.TypedExprFindWholeCallOpenParen(argName)
                if r3CaOpenPos > 0:
                    let r3CaClosePos = texpr.TypedExprFindMatchingParen(argName, r3CaOpenPos)
                    if r3CaClosePos > r3CaOpenPos && r3CaClosePos + 1 == len(argName):
                        let r3CaHead = strutil.Strip(strings.SliceBytes(argName, 0, r3CaOpenPos))
                        if texpr.TypedExprCallHeadIsPlainQualifiedIdent(r3CaHead):
                            let r3CaArgNodeIndex = PrimaryBodyIrStatementCallArgNodeIndexAt(lowering.typedIr,
                                                                                            stmt,
                                                                                            stmt.rhsNodeIndex,
                                                                                            argIndex)
                            if r3CaArgNodeIndex >= 0 &&
                               r3CaArgNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                               lowering.typedIr.nodes2_opKinds[r3CaArgNodeIndex] == texpr.TypedExprIrOpCallExpr:
                                let r3CaRtRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[r3CaArgNodeIndex])
                                if IsOk(r3CaRtRes):
                                    # form59: hoist Value before StripVarType (must be outside call-arg list)
                                    let r3CaRt_f59: str = Value(r3CaRtRes)
                                    var r3CaExpectKind: int32
                                    var r3CaExpectSize: int32
                                    var r3CaExpectAlign: int32
                                    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                                   strings.CloneStr(stmt.sourcePath),
                                                                   texpr.TypedExprStripVarType(r3CaRt_f59),
                                                                   r3CaExpectKind,
                                                                   r3CaExpectSize,
                                                                   r3CaExpectAlign)
                                    if r3CaExpectKind != coreir.LocalInvalidTag:
                                        let r3CaSlotName = strutil.Join(["#r3ca#",
                                                                          strings.IntToStr(callOrdinal),
                                                                          "#a",
                                                                          strings.IntToStr(argIndex)], "")
                                        let r3CaSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                     slotNames,
                                                                                     r3CaSlotName,
                                                                                     r3CaExpectKind)
                                        if r3CaSlot >= 0 &&
                                           PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                                                   slotNames,
                                                                                   lowering,

                                                                                   typedFn,
                                                                                   irFunction,
                                                                                   varI32ParamNames,
                                                                                   argName,
                                                                                   r3CaSlot,
                                                                                   stmt.lineNumber,
                                                                                   r3CaArgNodeIndex,
                                                                                   callOrdinal) &&
                                           PrimaryBodyIrSlotType(bodyIR, r3CaSlot) == r3CaExpectKind:
                                            add(call.argSlots, r3CaSlot)
                                            add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
                                            continue
                                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                            os.WriteLine(os.GetStderr(), Fmt"phase=callarg_r3_callarg_fallthrough function={strings.CloneStr(typedFn.functionName)} line={stmt.lineNumber} argIndex={argIndex} argName={argName}")
            # R3 drill-down (form 1/2: if-call / var=!call / if-call-negation):
            # stmt.rhsNodeIndex 非 CallExpr (LogNot/Neg 单目负包裹 CallExpr) 时
            # PrimaryBodyIrCallArgNodeIndexAt 直接查 miss → bail_44. 顺 operand0 链
            # (仅 LogNot/Neg) 找真 CallExpr 再取 arg 节点送 EvalNode；重复节点
            # 是 malformed TypedIR cycle，立即 fail closed。非
            # CallExpr 且无单目负包裹 → 保持 miss 落既有 bail_44 poison (不静默落穿
            # 弱文本路径, CLAUDE.md 4b.4).
            var r3DrillCallNode = stmt.rhsNodeIndex
            var r3DrillDepth: int32
            var r3DrillVisitedNodes = hashmaps.HashMapPtrIntInit(8)
            while r3DrillCallNode >= 0 &&
                  r3DrillCallNode < lowering.typedIr.nodes2_nodeIndexs.len &&
                  lowering.typedIr.nodes2_opKinds[r3DrillCallNode] != texpr.TypedExprIrOpCallExpr:
                var r3DrillVisited = false
                let _ = hashmaps.HashMapPtrIntGetEx(
                    r3DrillVisitedNodes,
                    int64(r3DrillCallNode) + int64(1),
                    r3DrillVisited)
                if r3DrillVisited:
                    r3DrillCallNode = -1
                    break
                hashmaps.HashMapPtrIntPut(r3DrillVisitedNodes,
                                          int64(r3DrillCallNode) + int64(1),
                                          1)
                let r3DrillOp = lowering.typedIr.nodes2_opKinds[r3DrillCallNode]
                if r3DrillOp != texpr.TypedExprIrOpLogNot && r3DrillOp != texpr.TypedExprIrOpNeg:
                    break
                r3DrillCallNode = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, r3DrillCallNode)
                r3DrillDepth = r3DrillDepth + 1
            if os.GetEnv("CHENG_PRIMARY_OBJECT_R3_DRILL_TRACE") == "1":
                os.WriteLine(os.GetStderr(), Fmt"phase=callarg_r3_drill_exit function={strings.CloneStr(typedFn.functionName)} line={stmt.lineNumber} argIndex={argIndex} rhsNodeIndex={stmt.rhsNodeIndex} r3DrillCallNode={r3DrillCallNode} r3DrillDepth={r3DrillDepth}")
            let fieldArgNodeIndex = PrimaryBodyIrStatementCallArgNodeIndexAt(lowering.typedIr,
                                                                             stmt,
                                                                             r3DrillCallNode,
                                                                             argIndex)
            if fieldArgNodeIndex < 0:
                var fbMatDetail0: int32
                var fbMatDetail1: int32
                let fbSlot = PrimaryBodyIrMaterializeFieldArgSlot(bodyIR,
                                                                   slotNames,
                                                                   lowering.typedIr,
                                                                   typedFn,
                                                                   irFunction,
                                                                   strings.CloneStr(stmt.sourcePath),
                                                                   stmt.lineNumber,
                                                                   argName,
                                                                   fbMatDetail0,
                                                                   fbMatDetail1)
                if fbSlot >= 0 && fbSlot < bodyIR.localSlots.len:
                    add(call.argSlots, fbSlot)
                    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
                    continue
                var fbHasIndex = false
                for fbIdxScan in 0..<len(argName):
                    if PrimaryBodyIrTextByteCodeEquals(argName, fbIdxScan, 91):
                        fbHasIndex = true
                        break
                if fbHasIndex:
                    var fbImaBase: int32
                    var fbImaOffset: int32
                    var fbImaLeafSource = ""
                    var fbImaLeafType = ""
                    let fbImaOk = PrimaryBodyIrIndexedMemberAddressSlot(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering.typedIr,
                                                              typedFn,
                                                              irFunction,
                                                              strings.CloneStr(stmt.sourcePath),
                                                              stmt.lineNumber,
                                                              argName,
                                                              callOrdinal,
                                                              fbImaBase,
                                                              fbImaOffset,
                                                              fbImaLeafSource,
                                                              fbImaLeafType)
                    if fbImaOk && fbImaLeafType != "":
                        var fbElemKind: int32
                        var fbElemSize: int32
                        var fbElemAlign: int32
                        PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                       fbImaLeafSource,
                                                       fbImaLeafType,
                                                       fbElemKind,
                                                       fbElemSize,
                                                       fbElemAlign)
                        # 标量 1/2/4/8 之外, 聚合/str 叶元素同样放行: 地址链
                        # (IndexedMemberAddressSlot) 已按真 shape 步长算出元素
                        # 地址, 建全宽典型槽 + FieldLoad byteCount=fbElemSize
                        # 整元素拷贝 (镜像 EvalNode IndexGet 臂整字段读语义),
                        # 聚合再过 ByValAggregateArgCopySlot ABI by-val (镜像
                        # simpleField 聚合臂)。槽宽 < 元素宽或任何失败仍
                        # poison 44, 不落穿。
                        if fbElemSize > 0 &&
                           (fbElemSize == 1 || fbElemSize == 2 || fbElemSize == 4 || fbElemSize == 8 ||
                            fbElemKind == coreir.LocalAggregateTag || fbElemKind == coreir.LocalStrTag):
                            let fbPtrSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                                              slotNames,
                                                                              stmt.lineNumber,
                                                                              fbImaBase,
