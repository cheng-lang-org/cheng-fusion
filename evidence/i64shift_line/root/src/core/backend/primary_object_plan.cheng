                        add(call.argSlots, varArgGlobalSlot)
                        add(call.argPassKinds, coreir.BodyCallPassGlobalAddressTag)
                        continue
                    # [wall148] 双拼写剥法：借用标记/var 前缀都不漏进槽型。
                    let valueType = PrimaryBodyIrVarParamRuntimeInnerType(targetParamType)
                    let layoutSourcePath = stmt.callTargetSourcePath
                    if layoutSourcePath == "":
                        failureDetail0 = 31
                        failureDetail1 = argIndex
                        return false
                    slotId = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                slotNames,
                                                                lowering.typedIr,
                                                                layoutSourcePath,
                                                                argName,
                                                                valueType)
                elif !(PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotId]) &&
                       PrimaryBodyIrCallArgSlotCarriesAddressValue(bodyIR,
                                                                    slotId,
                                                                    argBindingType)):
                    # [wall148] 双拼写剥法：借用标记/var 前缀都不漏进槽型。
                    let valueType = PrimaryBodyIrVarParamRuntimeInnerType(targetParamType)
                    let layoutSourcePath = stmt.callTargetSourcePath
                    if layoutSourcePath == "":
                        failureDetail0 = 31
                        failureDetail1 = argIndex
                        return false
                    slotId = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                slotNames,
                                                                lowering.typedIr,
                                                                layoutSourcePath,
                                                                argName,
                                                                valueType)
                if slotId < 0:
                    failureDetail0 = 31
                    failureDetail1 = argIndex
                    return false
                if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotId]) &&
                   PrimaryBodyIrCallArgSlotCarriesAddressValue(bodyIR,
                                                                slotId,
                                                                argBindingType):
                    add(call.argSlots, slotId)
                    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
                else:
                    add(call.argSlots, coreir.CallArgSlotAddress(slotId))
                    add(call.argPassKinds, coreir.BodyCallPassParamAddressTag)
                continue
            elif PrimaryBodyIrNameInList(varI32ParamNames, argName):
                slotId = PrimaryBodyIrI32ValueSlotForText(bodyIR, slotNames, varI32ParamNames, argName)
            elif targetParamTypeNorm == "str" &&
                 texpr.TypedExprFindTopLevelTextToken(argName, "?") > 0:
                # 任务#149 根修: str 三元表达式直接(不经 let 中转)作调用实参,
                # 如 `record(requireProof ? "on" : "off")`。argName 是复合三元
                # 文本, 既非裸标识符也非 field/index, 下方 `elif slotId < 0:`
                # 那条数值求值链硬编码 argScalarTypeKind=I32 (只认标量
                # I32/I64/F64), 对 str 目标解不出真值, 最终落到该链末尾的
                # FindOrCreateSlot(argName, LocalI32Tag) 兜底——建一个从不写入
                # 的 4 字节幽灵槽当 str 实参地址传给被调用方, 被调用方按 str
                # (16B ptr+len) 解引用即读栈垃圾 SIGSEGV(反汇编实证:
                # `ldr w0,[sp,#0x18]` 读一个从未 store 过的槽, record() 内
                # `ldr x9,[x10]` 解引用垃圾地址崩)。这里先于该数值管线拦截
                # "目标是 str 且实参含顶层三元" 这一形, 复用与 let/return 绑定
                # 位完全同源、已验证过的真分支物化器
                # (PrimaryBodyIrAppendStrTernaryDeclValue), 建一个真正的 str
                # 槽并走 cbr 真分支求值两臂；物化失败(不支持的臂形态)由该
                # 函数自身写 InvalidOp poison, 这里按 44 bail, 绝不落回下方
                # 标量兜底生成从未写入的槽。
                let strTernArgSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                   slotNames,
                                                                   strutil.Join(["#str_tern_arg#",
                                                                                strings.IntToStr(stmt.lineNumber),
                                                                                "#",
                                                                                strings.IntToStr(callOrdinal),
                                                                                "#",
                                                                                strings.IntToStr(argIndex)], ""),
                                                                   coreir.LocalStrTag)
                if strTernArgSlot < 0 ||
                   !PrimaryBodyIrAppendStrTernaryDeclValue(bodyIR,
                                                           slotNames,
                                                           varI32ParamNames,
                                                           lowering,

                                                           typedFn,
                                                           irFunction,
                                                           stmt,
                                                           PrimaryBodyIrStatementCallArgNodeIndexAt(
                                                               lowering.typedIr,
                                                               stmt,
                                                               stmt.rhsNodeIndex,
                                                               argIndex),
                                                           argName,
                                                           strTernArgSlot,
                                                           callOrdinal,
                                                           currentBlockStart):
                    failureDetail0 = 44
                    failureDetail1 = argIndex
                    return false
                add(call.argSlots, strTernArgSlot)
                add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
                continue
            elif slotId < 0:
                var argScalarTypeKind = coreir.LocalI32Tag
                let argParamTypeNorm = targetParamTypeNorm
                var argIsPtrCast = PrimaryBodyIrWholeCallInnerForHead(argName, "ptr") != ""
                if !argIsPtrCast:
                    if PrimaryBodyIrWholeCallInnerForHead(argName, "UInt8Ptr") != "":
                        argIsPtrCast = true
                    elif PrimaryBodyIrWholeCallInnerForHead(argName, "Int32Ptr") != "":
                        argIsPtrCast = true
                    elif PrimaryBodyIrWholeCallInnerForHead(argName, "UInt32Ptr") != "":
                        argIsPtrCast = true
                    elif PrimaryBodyIrWholeCallInnerForHead(argName, "UInt64Ptr") != "":
                        argIsPtrCast = true
                    elif PrimaryBodyIrWholeCallInnerForHead(argName, "Int64Ptr") != "":
                        argIsPtrCast = true
                    elif PrimaryBodyIrWholeCallInnerForHead(argName, "VoidPtrPtr") != "":
                        argIsPtrCast = true
                if !argIsPtrCast && argParamTypeNorm == "":
                    # 被调签名不可得时按实参调用头的返回类型判定指针性。
                    let argCallOpen = texpr.TypedExprFindWholeCallOpenParen(argName)
                    if argCallOpen > 0:
                        let argCallClose = texpr.TypedExprFindMatchingParen(argName, argCallOpen)
                        if argCallClose + 1 == len(argName):
                            var argTargetSource = ""
                            var argTargetName = ""
                            var argTargetSignature: int32
                            var argTargetImportc: bool
                            var argCallResultType = ""
                            if !PrimaryBodyIrExactCallNodeAuthority(
                                lowering.typedIr,
                                structuredArgNodeIndex,
                                argTargetSource,
                                argTargetName,
                                argTargetSignature,
                                argTargetImportc,
                                argCallResultType):
                                panic(Fmt"primary: pointer-shape call argument lacks exact node authority line={stmt.lineNumber} arg_index={argIndex} text={argName}")
                            let argCallRetNorm = texpr.TypedExprNormalizeTypeText(
                                argCallResultType)
                            if argCallRetNorm == "ptr" || argCallRetNorm == "cstring":
                                argIsPtrCast = true
                if argParamTypeNorm == "ptr" || argParamTypeNorm == "cstring" || argIsPtrCast:
                    # 指针参数的表达式实参（如 c_free(ptr(header))）必须走 Ptr 槽，
                    # 否则经 I32 标量槽会把 64 位指针截断为 32 位。
                    # 前向声明的 callee 拿不到参数类型文本（norm==""），
                    # 此时以实参自身的指针强转形态判定。
                    let ptrArgSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                                    slotNames,
                                                                    varI32ParamNames,
                                                                    lowering.typedIr,
                                                                    strings.CloneStr(stmt.sourcePath),
                                                                    argName,
                                                                    callOrdinal)
                    if ptrArgSlot >= 0:
                        add(call.argSlots, ptrArgSlot)
                        add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
                        continue
                if argParamTypeNorm == "int64" ||
                   argParamTypeNorm == "i64" ||
                   argParamTypeNorm == "uint64" ||
                   argParamTypeNorm == "u64":
                    argScalarTypeKind = coreir.LocalI64Tag
                slotId = PrimaryBodyIrCmpCondValue01ScalarSlot(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering.typedIr,
                                                               strings.CloneStr(stmt.sourcePath),
                                                               argName,
                                                               Fmt"#call_cmp#{stmt.lineNumber}#{argIndex}#{bodyIR.ops.len}",
                                                               callOrdinal)
                if slotId < 0 && PrimaryBodyIrTextHasCallSurface(argName):
                    slotId = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,

                                                                     typedFn,
                                                                     irFunction,
                                                                     strings.CloneStr(stmt.sourcePath),
                                                                     stmt.lineNumber,
                                                                     argName,
                                                                     argScalarTypeKind,
                                                                     callOrdinal)
                    var binOpPos: int32
                    binOpPos = -1
                    if slotId < 0:
                        for bi in 0..<len(argName):
                            if argName[bi] == '/':
                                binOpPos = bi
                                break
                    if slotId < 0 && binOpPos < 0:
                        for bi in 0..<len(argName):
                            if argName[bi] == '+':
                                binOpPos = bi
                                break
                    if slotId < 0 && binOpPos < 0:
                        for bi in 0..<len(argName):
                            if argName[bi] == '-':
                                binOpPos = bi
                                break
                    if binOpPos > 0 && binOpPos + 1 < len(argName):
                        let binLeftRaw = strings.SliceBytes(argName, 0, binOpPos)
                        let binLeftText = strutil.Strip(binLeftRaw)
                        let binRightRaw = strings.SliceBytes(argName,
                                                              binOpPos + 1,
                                                              len(argName) - binOpPos - 1)
                        let binRightText = strutil.Strip(binRightRaw)
                        if binLeftText != "" && binRightText != "":
                            let lhsSlot: int32 = PrimaryBodyIrFindArgSlot(bodyIR, slotNames,
                                                                          binLeftText)
                            let rhsSlot: int32 = PrimaryBodyIrFindArgSlot(bodyIR, slotNames,
                                                                          binRightText)
                            if lhsSlot >= 0 && rhsSlot >= 0:
                                var binOpKind: int32
                                binOpKind = 0
                                if argName[binOpPos] == '/':
                                    binOpKind = int32(texpr.TypedExprIrOpI32Sdiv)
                                elif argName[binOpPos] == '+':
                                    binOpKind = int32(texpr.TypedExprIrOpI32Add)
                                elif argName[binOpPos] == '-':
                                    binOpKind = int32(texpr.TypedExprIrOpI32Sub)
                                if binOpKind != 0:
                                    var binTypeKind: int32
                                    binTypeKind = bodyIR.localSlots[lhsSlot].typeKind
                                    let rhsTypeKind2 = bodyIR.localSlots[rhsSlot].typeKind
                                    if binTypeKind != rhsTypeKind2:
                                        if binTypeKind == coreir.LocalI32Tag && rhsTypeKind2 == coreir.LocalI64Tag:
                                            binTypeKind = coreir.LocalI64Tag
                                        elif binTypeKind == coreir.LocalI64Tag && rhsTypeKind2 == coreir.LocalI32Tag:
                                            binTypeKind = coreir.LocalI64Tag
                                    var binResultTag: int32
                                    binResultTag = coreir.LocalI32Tag
                                    if binTypeKind == coreir.LocalI64Tag:
                                        binResultTag = coreir.LocalI64Tag
                                    slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                           slotNames,
                                                                           argName,
                                                                           binResultTag)
                                    if slotId >= 0:
                                        var binOp: coreir.BodyOp
                                        binOp.kind = coreir.BodyOpBinOpTag
                                        binOp.target = slotId
                                        add(binOp.operands, binTypeKind)
                                        add(binOp.operands, binOpKind)
                                        add(binOp.operands, lhsSlot)
                                        add(binOp.operands, rhsSlot)
                                        let _ = coreir.BodyIRAppendOp(bodyIR, binOp)
                    if slotId < 0:
                        slotId = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering.typedIr,
                                                                     strings.CloneStr(stmt.sourcePath),
                                                                     argName,
                                                                     coreir.LocalI32Tag, callOrdinal)
                    if slotId < 0:
                        # ptr_expr_slot_8548 poison-on-miss (A2 str_arg_nested_call):
                        # 嵌套 call-surface 实参无任何 realizer 可物化
                        # (PtrExpressionSlot + ScalarValueSlotForText 皆 -1，如
                        # `cheng_ptr_plus(cheng_str_data(strArg), n)` 的内层 str-arg
                        # call 被类型门拒)。此处凭空 FindOrCreateSlot 建一个从不填的
                        # I32 槽 → 外层 call 读未写 4 字节槽 = 静默 miscompile。
                        # 诚实 poison，不落穿建垃圾槽。
                        failureDetail0 = 8548
                        failureDetail1 = argIndex
                        return false
                elif slotId < 0:
                    # 原 else: 在 slotId 已被上游 (如 CmpCondValue01ScalarSlot) 正确
                    # 求值 (>=0) 时仍会触发, 用 argName 原文重算失败后 FindOrCreateSlot
                    # 建从未写入的幽灵槽覆盖正确结果 (#1b 形态九真根, BytesCopyInto
                    # Assert(offset>=0) 指令级实证 store@0x54/reload@0x58)。
                    # 只在尚未求值 (slotId<0) 时才进本兜底链。
                    slotId = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 lowering.typedIr,
                                                                 strings.CloneStr(stmt.sourcePath),
                                                                 argName,
                                                                 argScalarTypeKind, callOrdinal)
                    if slotId < 0:
                        slotId = PrimaryBodyIrSeqLenValueSlot(bodyIR,
                                                              slotNames,
                                                              lowering.typedIr,
                                                              typedFn,
                                                              irFunction,
                                                              strings.CloneStr(stmt.sourcePath),
                                                              stmt.lineNumber,
                                                              argName)
                    if slotId < 0 &&
                       len(argName) > 0 &&
                       PrimaryBodyIrTextByteCodeEquals(argName, len(argName) - 1, 93):
                        let indexedArgSlot = PrimaryBodyIrSeqIndexValueSlot(bodyIR,
                                                                            slotNames,
                                                                            varI32ParamNames,
                                                                            lowering.typedIr,
                                                                            typedFn,
                                                                            irFunction,
                                                                            strings.CloneStr(stmt.sourcePath),
                                                                            stmt.lineNumber,
                                                                            argName,
                                                                            callOrdinal)
                        if indexedArgSlot >= 0 &&
                           (PrimaryBodyIrSlotType(bodyIR, indexedArgSlot) == coreir.LocalI32Tag ||
                            PrimaryBodyIrSlotType(bodyIR, indexedArgSlot) == coreir.LocalI64Tag ||
                            PrimaryBodyIrSlotType(bodyIR, indexedArgSlot) == coreir.LocalPtrTag):
                            slotId = indexedArgSlot
                    if slotId < 0 &&
                       PrimaryBodyIrTextHasFieldOrIndex(argName):
                        # deep / mixed `.field`+`[idx]` chain over dynamic seqs
                        # (wcz Lane 3 / bail_44): `t.rows[0].cols[1].owner`,
                        # `ctx.scopes[i].name`, `ir.functions[i].statements[3].kind`.
                        let imvSlot = PrimaryBodyIrIndexedMemberValueSlot(bodyIR,
                                                                          slotNames,
                                                                          varI32ParamNames,
                                                                          lowering.typedIr,
                                                                          typedFn,
                                                                          irFunction,
                                                                          strings.CloneStr(stmt.sourcePath),
                                                                          stmt.lineNumber,
                                                                          argName,
                                                                          callOrdinal)
                        if imvSlot >= 0 &&
                           (PrimaryBodyIrSlotType(bodyIR, imvSlot) == coreir.LocalI32Tag ||
                            PrimaryBodyIrSlotType(bodyIR, imvSlot) == coreir.LocalI64Tag ||
                            PrimaryBodyIrSlotType(bodyIR, imvSlot) == coreir.LocalPtrTag ||
                            PrimaryBodyIrSlotType(bodyIR, imvSlot) == coreir.LocalStrTag):
                            slotId = imvSlot
                    if slotId < 0 &&
                       PrimaryBodyIrTextHasFieldOrIndex(argName):
                        # aggregate leaf of a `.field`+`[idx]` chain passed by value
                        # to a non-var aggregate parameter (bail_44 / wcz Lane 3):
                        # load the whole element struct from its address into a
                        # private stack slot; it then flows through the by-value
                        # aggregate copy path below.
                        let imvAggSlot = PrimaryBodyIrIndexedMemberAggregateValueSlot(bodyIR,
                                                                                      slotNames,
                                                                                      varI32ParamNames,
                                                                                      lowering.typedIr,
                                                                                      typedFn,
                                                                                      irFunction,
                                                                                      strings.CloneStr(stmt.sourcePath),
                                                                                      stmt.lineNumber,
                                                                                      argName,
                                                                                      callOrdinal)
                        if imvAggSlot >= 0 &&
                           PrimaryBodyIrSlotType(bodyIR, imvAggSlot) == coreir.LocalAggregateTag:
                            slotId = imvAggSlot
                    if slotId < 0 &&
                       PrimaryBodyIrTextByteCodeEquals(argName, len(argName) - 1, 93):
                        let subOpSlot = PrimaryBodyIrSubscriptOpCallArgSlot(bodyIR,
                                                                            slotNames,
                                                                            varI32ParamNames,
                                                                            lowering,

                                                                            typedFn,
                                                                            irFunction,
                                                                            strings.CloneStr(stmt.sourcePath),
                                                                            stmt.lineNumber,
                                                                            argName,
                                                                            PrimaryBodyIrStatementCallArgNodeIndexAt(lowering.typedIr,
                                                                                                                     stmt,
                                                                                                                     stmt.rhsNodeIndex,
                                                                                                                     argIndex),
                                                                            callOrdinal)
                        if subOpSlot >= 0:
                            slotId = subOpSlot
                    if slotId < 0:
                        if PrimaryBodyIrTextHasFieldOrIndex(argName):
                            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                os.WriteLine(os.GetStderr(), strutil.Join(["phase=call_arg_scalar_field_fallback function=",
                                                                           strings.CloneStr(typedFn.functionName),
                                                                           " line=",
                                                                           strings.IntToStr(stmt.lineNumber),
                                                                           " arg_index=",
                                                                           strings.IntToStr(argIndex),
                                                                           " arg=",
                                                                           strings.CloneStr(argName),
                                                                           " target_param_type=",
                                                                           strings.CloneStr(targetParamType),
                                                                           " field_root_type=",
                                                                           strings.CloneStr(fieldRootType)], ""))
                            failureDetail0 = 44
                            failureDetail1 = argIndex
                            return false
                        # form43 案卷根修 (BACKFILL-9 F47 收尾, 危险形a): 到此为止
                        # 所有既有解析器(全局/局部/字面量/调用合成/索引/字段等)
                        # 均已尝试过且落空 —— argName 是裸标识符时, 下一步原样
                        # 落到 FindOrCreateSlot(argName, LocalI32Tag) 建一个从
                        # 不写入的幽灵槽当实参：类型检查静默通过, 但实参值是
                        # 未初始化栈垃圾, 运行时 SIGSEGV(实测 f47_probe_two_
                        # globals: `setGlobals(fnA, fnB)` 裸函数名当实参落此
                        # 幽灵槽, blr 一个垃圾地址崩)。
                        #
                        # 先兜底一个相邻的既有 kind-mismatch 缺口: argName 实际
                        # 是已注册的全局(如 Ptr 形 fn-ptr 别名), 但上游标量解析
                        # 器按目标形参"猜"出的 kind(默认 I32) 与全局真实 kind
                        # (Ptr) 不符而漏判——GlobalLoadSlot 直接按全局自身声明
                        # 类型定 kind 建正确槽, 不依赖上游猜测, 解不出(非全局)
                        # 才继续往下。
                        if parser.ParserIdentPrefix(argName) == argName:
                            let fnvGlobalValueSlot = PrimaryBodyIrNodeEvalGlobalLoadSlot(bodyIR,
                                                                                          slotNames,
                                                                                          lowering.typedIr,
                                                                                          strings.CloneStr(stmt.sourcePath),
                                                                                          argName)
                            if fnvGlobalValueSlot >= 0:
                                slotId = fnvGlobalValueSlot
                        # 仅当形参声明类型确实是 fn-ptr 形状(含具名别名)且上面
                        # 全局值兜底未命中时才拦截: 复用既有 `&FunctionName` 取址
                        # 机器(PrimaryBodyIrFuncRefAddressSlot)把函数符号地址
                        # 按值物化; 解不出(非可见顶层函数符号)则诚实 poison,
                        # 绝不落穿建垃圾槽。非 fn-ptr 目标类型不受影响, 原样
                        # 落回既有 FindOrCreateSlot(保持所有既有形态零回归)。
                        if slotId < 0 && parser.ParserIdentPrefix(argName) == argName:
                            let fnvArgFnPtrType = PrimaryBodyIrResolvedFnPtrDeclType(lowering.typedIr,
                                                                                     strings.CloneStr(stmt.sourcePath),
                                                                                     targetParamType)
                            if fnvArgFnPtrType != "":
                                let fnvArgAddrSlot = PrimaryBodyIrFuncRefAddressSlot(bodyIR,
                                                                                     slotNames,
                                                                                     lowering,
                                                                                     strings.CloneStr(stmt.sourcePath),
                                                                                     argName)
                                if fnvArgAddrSlot >= 0:
                                    # 函数地址槽必须直接以 GlobalAddressTag
                                    # continue, 不能落进下面通用的
                                    # ValueArgSlotForCall/ByValAggregateArgCopySlot
                                    # 流水线——那两者对 GlobalAddressTag 槽会
                                    # 当作"全局变量地址"尝试按名 GlobalLoad 取值
                                    # (函数名不是注册全局, 必然 -1 误 poison),
                                    # 不是把地址本身按值传递。
                                    add(call.argSlots, fnvArgAddrSlot)
                                    add(call.argPassKinds, coreir.BodyCallPassGlobalAddressTag)
                                    continue
                                failureDetail0 = 6650
                                failureDetail1 = argIndex
                                return false
                        if slotId < 0:
                            slotId = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                   slotNames,
                                                                   argName,
                                                                   coreir.LocalI32Tag)
            if slotId < 0:
                failureDetail0 = 42
                failureDetail1 = argIndex
                return false
            slotId = PrimaryBodyIrValueArgSlotForCall(bodyIR,
                                                      slotNames,
                                                      lowering.typedIr,
                                                      strings.CloneStr(stmt.sourcePath),
                                                      argName,
                                                      slotId)
            if slotId < 0:
                failureDetail0 = 47
                failureDetail1 = argIndex
                return false
            slotId = PrimaryBodyIrByValAggregateArgCopySlot(bodyIR,
                                                            slotNames,
                                                            slotId,
                                                            callOrdinal,
                                                            argIndex)
            if slotId < 0:
                failureDetail0 = 48
                failureDetail1 = argIndex
                return false
            add(call.argSlots, slotId)
            add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    return true

@borrows
fn PrimaryBodyIrPureCastResultTypeKind(targetRaw: str): int32 =
    let target = PrimaryCallTargetTailName(targetRaw)
    if target == "int64" || target == "Int64":
        return coreir.LocalI64Tag
    if target == "uint64" || target == "UInt64":
        return coreir.LocalI64Tag
    if target == "int32" || target == "Int32":
        return coreir.LocalI32Tag
    if target == "uint32" || target == "UInt32":
        return coreir.LocalI32Tag
    if target == "int8" || target == "Int8":
        return coreir.LocalI32Tag
    if target == "uint8" || target == "UInt8":
        return coreir.LocalI32Tag
    if target == "int" || target == "Int":
        return coreir.LocalI32Tag
    if target == "uint" || target == "UInt":
        return coreir.LocalI32Tag
    return coreir.LocalInvalidTag

@borrows
fn PrimaryBodyIrExactStatementCallResultOwnership(
        typedIr: texpr.TypedExprIr,
        stmt: lower.PrimaryObjectIrStatement,
        resultSlot: int32,
        resultExprNodeIndexOut: var int32,
        managedLocalDefinitionOut: var bool): coreir.OwnershipKind =
    resultExprNodeIndexOut = -1
    managedLocalDefinitionOut = false
    if resultSlot < 0:
        return coreir.OwnInvalid
    let nodeIndex = stmt.rhsNodeIndex
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        var statementResultHasManaged: bool
        if texpr.TypedExprIrTypeContainsManagedStorage(typedIr,
                                                       strings.CloneStr(stmt.sourcePath),
                                                       stmt.resultType,
                                                       statementResultHasManaged) &&
           statementResultHasManaged:
            panic(Fmt"primary: managed call result lacks exact CallExpr authority source={strings.CloneStr(stmt.sourcePath)} line={stmt.lineNumber}")
        return coreir.OwnInvalid
    var exactSourcePath = ""
    var exactTarget = ""
    var exactSignatureLine: int32
    var exactImportc: bool
    var exactResultType = ""
    if !PrimaryBodyIrExactCallNodeAuthority(typedIr,
                                             nodeIndex,
                                             exactSourcePath,
                                             exactTarget,
                                             exactSignatureLine,
                                             exactImportc,
                                             exactResultType):
        panic(Fmt"primary: exact CallExpr authority unavailable node={nodeIndex}")
    if stmt.callTarget != exactTarget ||
       stmt.callTargetSourcePath != exactSourcePath ||
       stmt.callTargetSignatureLineNumber != exactSignatureLine ||
       stmt.callTargetImportc != exactImportc:
        panic(Fmt"primary: statement/call-node declaration identity drift source={strings.CloneStr(stmt.sourcePath)} line={stmt.lineNumber} node={nodeIndex}")
    let exprClass = texpr.TypedExprIrNodeExprClassAt(typedIr, nodeIndex)
    if exprClass == texpr.TypedExprExprOwned ||
       exprClass == texpr.TypedExprExprBorrowed:
        # Cheng 函数结果默认 Owned,但非托管标量没有可消费所有权。
        # CallOp 非托管结果必须 OwnInvalid: OwnPlain 没有 TypedExpr value-def,
        # AccessDecode 会在 decodeCallOrdinal 上 Ownership 失败。
        var classResultHasManaged: bool
        if !texpr.TypedExprIrTypeContainsManagedStorage(typedIr,
                                                        exactSourcePath,
                                                        exactResultType,
                                                        classResultHasManaged):
            panic(Fmt"primary: call result type authority unavailable source={exactSourcePath} target={exactTarget} signature_line={exactSignatureLine} node={nodeIndex}")
        if classResultHasManaged:
            let definitionRow =
                texpr.TypedExprIrNodeProducedValueDefinitionRowAt(
                    typedIr, nodeIndex)
            if definitionRow < 0 ||
               definitionRow >=
                   texpr.TypedExprValueDefinitionAuthorityCount(typedIr):
                panic(Fmt"primary: managed CallExpr produced value-definition missing node={nodeIndex}")
            let originKind =
                texpr.TypedExprValueDefinitionOriginKindAt(
                    typedIr, definitionRow)
            if originKind !=
                   texpr.TypedExprValueDefinitionOriginBindingInitializer &&
               originKind !=
                   texpr.TypedExprValueDefinitionOriginCallResult:
                panic(Fmt"primary: managed CallExpr value-definition origin invalid node={nodeIndex} row={definitionRow}")
            # Bind only after CallOp and BodyOp have canonical coordinates.
            # The lowering transport carries the exact TypedExpr producer row;
            # no destination LocalSlot ownership or callee spelling participates.
            managedLocalDefinitionOut = true
            return coreir.OwnInvalid
        return coreir.OwnInvalid
    if exprClass == texpr.TypedExprExprUnmanaged:
        # [wall106] 契约注记（结论不变，语义半区澄清）：非托管 call 结果
        # 的 CallOp 行六列（resultOwnership/exprNodeIndex/originKind/
        # originId/valueDefinitionRow/borrowOwner*）保持 OwnInvalid/Unknown/
        # -1 哨兵 —— 这是 AccessDecode decodeCallOrdinal 的既有契约，
        # 本函数返回值不变。但「OwnPlain 没有 TypedExpr value-def」的
        # 前提只对 CallOp 行成立：绑定面早在 TypedExpr 发布侧为该
        # CallExpr 节点持有 produced value-definition 权威行
        # （PrimaryBodyIrBindLocalSlotFromTypedProducerExact 消费的同一
        # 行，非 sentinel 绑定槽的 TypeId/storage 证明即其投影）。该行
        # 由发射侧 PrimaryBodyIrBindUnmanagedCallResultDefinition 以
        # OwnPlain 纯值定义落到 BodyOp valueDef 全列（无所有权转移、
        # 无 cleanup 义务），derive/identity 既有臂原样消费。
        return coreir.OwnInvalid
    var exactResultHasManaged: bool
    if !texpr.TypedExprIrTypeContainsManagedStorage(typedIr,
                                                    exactSourcePath,
                                                    exactResultType,
                                                    exactResultHasManaged) ||
       exactResultHasManaged:
        panic(Fmt"primary: managed call result ownership unknown source={exactSourcePath} target={exactTarget} signature_line={exactSignatureLine} node={nodeIndex}")
    return coreir.OwnInvalid

# [wall106] 非托管 call-result 定义行权威落戳（发布侧三层补全之②的
# 非托管半；wall28/LoweringBindManagedCallResultDefinition 同契约形态，
# 落「纯值定义」而非所有权转移）。触发面 = 通用 call 发射臂里托管两臂
# （OwnMove/OwnBorrowShared 戳臂与 managedLocalDefinition 绑定臂）皆
# 不接的非托管形：此前该形 lowering 无戳可落 → 非 sentinel 目标槽
# defs==0 → derive [wall105] 判词硬炸。本函数把 TypedExpr 发布侧既有
# 权威行（绑定面 produced 行，origin∈{BindingInitializer,CallResult}）
# 按 OwnPlain 落到 op valueDef 全列；call 行权威列不动（OwnInvalid
# 语义保留，AccessDecode else 臂契约零接触）。sentinel 槽（tid 未绑的
# temp call-result）不在本臂触发面，原样豁免零扰动；权威行查不到/
# origin 越域/定义节点漂移/TypeId 漂移/borrow owner 非法/transport 窗
# 不符/已绑非零戳即 panic，fail-closed 零启发式。
@borrows
fn PrimaryBodyIrBindUnmanagedCallResultDefinition(
        bodyIR: coreir.BodyIR,
        typedIr: texpr.TypedExprIr,
        transport: lower.LoweringOwnershipTransportSoA,
        functionName: str,
        stmt: lower.PrimaryObjectIrStatement,
        resultSlot: int32,
        op: var coreir.BodyOp) =
    if op.valueDefOwnership != coreir.OwnInvalid ||
       op.valueDefSlot != -1 ||
       op.valueDefExprNodeIndex != -1 ||
       op.valueDefOriginKind != coreir.BodyDefinitionOriginUnknownTag ||
       op.valueDefOriginId != -1 ||
       op.valueDefSemanticRow != -1 ||
       op.valueDefBorrowOwnerSemanticRow != -1 ||
       op.valueDefBorrowOwnerDefinitionDomain !=
           coreir.BodyDefinitionDomainInvalidTag ||
       op.valueDefBorrowOwnerDefinitionRow != -1 ||
       op.consumeActionRow != -1 ||
       op.sourceDefinitionDomain !=
           coreir.BodyDefinitionDomainInvalidTag ||
       op.sourceDefinitionRow != -1:
        panic(Fmt"primary: unmanaged call result authority already bound fn={functionName} line={stmt.lineNumber} slot={resultSlot}")
    if resultSlot < 0 || resultSlot >= bodyIR.localSlots.len:
        return
    let slot = bodyIR.localSlots[resultSlot]
    if slot.typeArenaTypeId < 0:
        # sentinel 槽（temp call-result，identity 豁免面）：原样不戳。
        return
    if slot.managedStorageKind != coreir.BodyManagedStorageUnmanagedTag:
        panic(Fmt"primary: unmanaged call result storage drift fn={functionName} line={stmt.lineNumber} slot={resultSlot} slot_tid={slot.typeArenaTypeId} mg={Int32(slot.managedStorageKind)}")
    if stmt.rhsNodeIndex < 0 ||
       stmt.rhsNodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[stmt.rhsNodeIndex] !=
           texpr.TypedExprIrOpCallExpr:
        panic(Fmt"primary: unmanaged call result node drift fn={functionName} line={stmt.lineNumber} node={stmt.rhsNodeIndex} slot={resultSlot}")
    let unmanagedDefinitionRow =
        texpr.TypedExprIrNodeProducedValueDefinitionRowAt(
            typedIr, stmt.rhsNodeIndex)
    if unmanagedDefinitionRow < 0 ||
       unmanagedDefinitionRow >=
           texpr.TypedExprValueDefinitionAuthorityCount(typedIr):
        panic(Fmt"primary: unmanaged call result value-definition missing fn={functionName} line={stmt.lineNumber} node={stmt.rhsNodeIndex} slot={resultSlot} slot_tid={slot.typeArenaTypeId}")
    let unmanagedOriginKind = texpr.TypedExprValueDefinitionOriginKindAt(
        typedIr, unmanagedDefinitionRow)
    if unmanagedOriginKind !=
           texpr.TypedExprValueDefinitionOriginBindingInitializer &&
       unmanagedOriginKind !=
           texpr.TypedExprValueDefinitionOriginCallResult:
        panic(Fmt"primary: unmanaged call result value-definition origin invalid fn={functionName} line={stmt.lineNumber} row={unmanagedDefinitionRow} origin={Int32(unmanagedOriginKind)}")
    if texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
           typedIr, unmanagedDefinitionRow) != stmt.rhsNodeIndex:
        panic(Fmt"primary: unmanaged call result definition node drift fn={functionName} line={stmt.lineNumber} row={unmanagedDefinitionRow} node={stmt.rhsNodeIndex}")
    let unmanagedExactTypeId = texpr.TypedExprValueDefinitionExactTypeIdAt(
        typedIr, unmanagedDefinitionRow)
    if unmanagedExactTypeId != slot.typeArenaTypeId:
        panic(Fmt"primary: unmanaged call result TypeId drift fn={functionName} line={stmt.lineNumber} row={unmanagedDefinitionRow} exact_tid={unmanagedExactTypeId} slot_tid={slot.typeArenaTypeId}")
    if texpr.TypedExprValueDefinitionBorrowOwnerValueDefinitionRowAt(
           typedIr, unmanagedDefinitionRow) != -1:
        panic(Fmt"primary: unmanaged call result carries borrow owner fn={functionName} line={stmt.lineNumber} row={unmanagedDefinitionRow}")
    if !transport.complete ||
       transport.sourceValueDefinitionStart < 0 ||
       transport.sourceValueDefinitionCount < 0:
        panic(Fmt"primary: unmanaged call result transport incomplete fn={functionName} line={stmt.lineNumber} row={unmanagedDefinitionRow}")
    let unmanagedTransportRow =
        unmanagedDefinitionRow - transport.sourceValueDefinitionStart
    if unmanagedTransportRow < 0 ||
       unmanagedTransportRow >= transport.sourceValueDefinitionCount ||
       transport.definitionRows[unmanagedTransportRow] !=
           unmanagedDefinitionRow ||
       transport.originKinds[unmanagedTransportRow] !=
           Int32(unmanagedOriginKind) ||
       transport.exactTypeIds[unmanagedTransportRow] !=
           unmanagedExactTypeId ||
       transport.definingNodeIndexes[unmanagedTransportRow] !=
           stmt.rhsNodeIndex ||
       transport.nodeOpKinds[unmanagedTransportRow] !=
           texpr.TypedExprIrOpCallExpr ||
       transport.managedFlags[unmanagedTransportRow] ||
       transport.borrowOwnerValueDefinitionRows[unmanagedTransportRow] != -1:
        panic(Fmt"primary: unmanaged call result transport row drift fn={functionName} line={stmt.lineNumber} row={unmanagedDefinitionRow} transport_row={unmanagedTransportRow} start={transport.sourceValueDefinitionStart} count={transport.sourceValueDefinitionCount}")
    op.valueDefSlot = resultSlot
    op.valueDefExprNodeIndex = stmt.rhsNodeIndex
    op.valueDefOwnership = coreir.OwnPlain
    op.valueDefOriginKind = coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = unmanagedDefinitionRow
    op.valueDefSemanticRow = unmanagedDefinitionRow

@borrows
fn PrimaryBodyIrAppendCallOp(bodyIR: var coreir.BodyIR,
                              slotNames: var str[],
                              lowering: var lower.LoweringPlanStub,
                              typedFn: texpr.TypedExprIrFunction,
                              irFunction: lower.PrimaryObjectIrFunction,
                              stmt: lower.PrimaryObjectIrStatement,
                              resultSlot: int32,
                              varI32ParamNames: str[],
                              callOrdinal: var int32,
                              currentBlockStart: var int32): int32 =
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"call_op_enter function={typedFn.functionName} line={stmt.lineNumber} target={stmt.callTarget} args={stmt.callArgsText}")
    # Zero-arg aggregate type constructor `Type()` is default initialization, not a
    # function call. The front-end builds no node for it and never registers it as a
    # function, so an emit path that funnels a bare `Type()` here would otherwise
    # append an unresolvable BL to a non-existent symbol. Materialize an exact
    # whole-slot zero-init into the matching aggregate result slot instead. The
    # empty-args guard is load-bearing: a named-field constructor `Type(field: v)`
    # also reports callArgCount==0 (named fields are not positional call args) but
    # MUST be field-materialized, not zeroed — gate strictly on empty `()`.
    if resultSlot >= 0 &&
       resultSlot < bodyIR.localSlots.len &&
       stmt.callArgCount == 0 &&
       strutil.Strip(share(stmt.callArgsText)) == "" &&
       PrimaryBodyIrSlotType(bodyIR, resultSlot) == coreir.LocalAggregateTag &&
       PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr, share(stmt.sourcePath), share(stmt.callTarget)):
        var ctorZeroKind: int32
        var ctorZeroSize: int32
        var ctorZeroAlign: int32
        PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                       stmt.sourcePath,
                                       stmt.callTarget,
                                       ctorZeroKind,
                                       ctorZeroSize,
                                       ctorZeroAlign)
        if ctorZeroSize > 0 &&
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[resultSlot]) == ctorZeroSize:
            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                os.WriteLine(os.GetStderr(), Fmt"phase=ctor_call_zeroinit function={typedFn.functionName} kind={int32(stmt.kind)} line={stmt.lineNumber} target={stmt.callTarget}")
            if PrimaryBodyIrAppendZeroLocalSlot(bodyIR, slotNames, resultSlot, callOrdinal):
                return resultSlot
    # Generic primitive-cast templates from system.cheng have no lowered
    # instance body to call; materialize them as scalar copies/truncations.
    let pureCastResultKind = PrimaryBodyIrPureCastResultTypeKind(share(stmt.callTarget))
    if pureCastResultKind != coreir.LocalInvalidTag:
        if resultSlot < 0:
            return resultSlot
        var castArgSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,

                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt.sourcePath,
                                                                  stmt.lineNumber,
                                                                  stmt.callArgsText,
                                                                  pureCastResultKind,
                                                                  callOrdinal)
        if castArgSlot < 0 && pureCastResultKind == coreir.LocalI32Tag:
            castArgSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,

                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt.sourcePath,
                                                                  stmt.lineNumber,
                                                                  stmt.callArgsText,
                                                                  coreir.LocalI64Tag,
                                                                  callOrdinal)
        if castArgSlot < 0 && pureCastResultKind == coreir.LocalI64Tag:
            castArgSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,

                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt.sourcePath,
                                                                  stmt.lineNumber,
                                                                  stmt.callArgsText,
                                                                  coreir.LocalI32Tag,
                                                                  callOrdinal)
        if castArgSlot < 0 &&
           (pureCastResultKind == coreir.LocalI32Tag ||
            pureCastResultKind == coreir.LocalI64Tag):
            # f64 -> i32/i64 pure-cast rescue。后端无 f64->int BodyOp,arg 槽 LocalF64Tag
            # 无法满足 I32/I64 cast(I32<->I64 widen/narrow 拒)→ 每 int(floatExpr) bail=803。
            # 重解析同一 arg 文本为 f64;物化则发 CallOp 到 C 运行时截断器(host_runtime.c)。
            # reloc 从 call.targetSymbol 注册符号,合成 CallOp 在 emit 解析。
            let f64ArgSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,

                                                                     typedFn,
                                                                     irFunction,
                                                                     stmt.sourcePath,
                                                                     stmt.lineNumber,
                                                                     stmt.callArgsText,
                                                                     coreir.LocalF64Tag,
                                                                     callOrdinal)
            if f64ArgSlot >= 0 &&
               f64ArgSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, f64ArgSlot) == coreir.LocalF64Tag:
                var truncCall: coreir.CallOp
                if pureCastResultKind == coreir.LocalI32Tag:
                    truncCall.targetSymbol = "cheng_f64_to_i32"
                else:
                    truncCall.targetSymbol = "cheng_f64_to_i64"
                truncCall.resultSlot = resultSlot
                truncCall.resultPassKind = coreir.BodyCallPassStackValueTag
                # #73: cheng_f64_to_i32/i64 are real C runtime symbols (host_runtime.c),
                # always cross the AAPCS64 boundary -- the f64 arg needs the fmov.
                truncCall.targetIsImportc = true
                add(truncCall.argSlots, f64ArgSlot)
                add(bodyIR.callSequence, truncCall)
                var truncOp: coreir.BodyOp
                truncOp.kind = coreir.BodyOpCallTag
                truncOp.target = resultSlot
                add(truncOp.operands, callOrdinal)
                let _ = coreir.BodyIRAppendOp(bodyIR, truncOp)
                callOrdinal = callOrdinal + 1
                return resultSlot
        if castArgSlot < 0:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         803,
                                         0)
            return resultSlot
        if castArgSlot != resultSlot:
            var castCopyOp: coreir.BodyOp
            castCopyOp.kind = coreir.BodyOpCopyLocalTag
            castCopyOp.target = resultSlot
            add(castCopyOp.operands, castArgSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, castCopyOp)
        return resultSlot
    # C5 poison-on-miss（与 lowering 侧登记豁免同判据）：`binding.fnPtrField()`
    # 间接调用没有静态符号可发——按文本发 call op 会把 `task.entry` 这类幻影
    # 目标带进 callSequence，plan 阶段永不可解析（missing_call_target bail=0）。
    # 零实参语句级形态已由 __cheng_call_indirect_void 桥 realizer 接通发射；
    # 其余形态（实参/结果槽）仍如实 invalid op（64/646），不落穿。
    if strutil.Contains(share(stmt.callTarget), "."):
        var sourceTexts: texpr.TypedExprSourceText[]
        if lower.LoweringPrimaryObjectIrCallTargetIsFnPtrBinding(irFunction,
                                                                 lowering,
                                                                 sourceTexts,
                                                                 share(stmt.callTarget)):
            if PrimaryBodyIrAppendFnPtrFieldVoidCallStatement(bodyIR,
                                                              slotNames,
                                                              share(varI32ParamNames),
                                                              lowering,

                                                              typedFn,
                                                              irFunction,
                                                              stmt,
                                                              resultSlot,
                                                              callOrdinal):
                return resultSlot
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         64,
                                         646)
            return resultSlot
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = PrimaryBodyIrCanonicalCallTargetSymbolForStatement(stmt)
    call.targetSourcePath = stmt.callTargetSourcePath
    call.resultSlot = resultSlot
    call.resultPassKind = coreir.BodyCallPassStackValueTag
    var exactResultExprNodeIndex: int32 = -1
    var managedLocalDefinition: bool
    call.resultOwnership = PrimaryBodyIrExactStatementCallResultOwnership(
        lowering.typedIr,
        stmt,
        resultSlot,
        exactResultExprNodeIndex,
        managedLocalDefinition)
    call.resultExprNodeIndex = exactResultExprNodeIndex
    # #73: thread the @importc flag so the arg-fill emitter knows whether this
    # call crosses the real AAPCS64 C ABI boundary (f64 args need fmov d{n},x{n}).
    call.targetIsImportc = stmt.callTargetImportc
    if resultSlot >= 0 && resultSlot < bodyIR.localSlots.len:
        let resultType = bodyIR.localSlots[resultSlot].typeKind
        if resultType == coreir.LocalStrTag ||
           resultType == coreir.LocalAggregateTag:
            call.resultPassKind = coreir.BodyCallPassSretResultTag
    var failureDetail0: int32
    var failureDetail1: int32
    var failureAlreadyPoisoned: bool
    if !PrimaryBodyIrAppendCallArgs(bodyIR,
                                    slotNames,
                                    call,
                                    lowering,

                                    typedFn,
                                    irFunction,
                                  stmt,
                                  share(varI32ParamNames),
                                  callOrdinal,
                                  currentBlockStart,
                                  failureDetail0,
                                  failureDetail1,
                                  failureAlreadyPoisoned):
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"primary_body_ir_call_arg_fail function={typedFn.functionName} line={stmt.lineNumber} target={call.targetSymbol} detail0={failureDetail0} detail1={failureDetail1} args={stmt.callArgsText}")
        if !failureAlreadyPoisoned:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         failureDetail0,
                                         failureDetail1)
        return resultSlot
    if !PrimaryBodyIrRewriteStrutilsJoinBridgeAddressArgs(call):
        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                     stmt.lineNumber,
                                     int32(stmt.kind),
                                     44,
                                     909)
        return resultSlot
    PrimaryBodyIrFillCallArgAbiSizes(call, bodyIR, lowering,  stmt)
    # [wall131] 形参权威落列：ABI fill 成功 = 每实参形参类型权威已证，
    # 紧随其后落列（见 PrimaryBodyIrFillCallArgFormalOwnerships 头注）。
    PrimaryBodyIrFillCallArgFormalOwnerships(call, lowering, stmt)
    # Current boundary poison (mirrors #69 poison-on-miss): real C-ABI call, >8 total
    # args, at least one f64 among them -- the register/stack split this backend
    # computes ("first 8 positional args") is not valid AAPCS64 NGRN/NSRN
    # dual-pool semantics for this shape and no real stack re-layout is
    # implemented yet. Loudly reject instead of silently mis-emitting.
    if PrimaryCallOpAbiRegisterStackBoundaryNeedsPoison(share(call), bodyIR):
        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                     stmt.lineNumber,
                                     int32(stmt.kind),
                                     817,
                                     0)
        return resultSlot
    call.inlineF64FromIntKind = PrimaryBodyIrCallOpInlineF64FromIntKindForConstruction(share(call),
                                                                                       bodyIR,
                                                                                       stmt.callTarget)
    if call.inlineF64FromIntKind > 0:
        # #95 wave5 根修 (AppendCallOp 侧收口, 实测新增缺陷位): 这条通用
        # "let X = 真实函数调用()"语句构造器对任何 target 尾名="float64" 的调用
        # 都会无条件把这个字段置位(既有 #73/#77 时代代码, 本为支撑 call-arg 嵌套
        # 位置的 float64(x) 内联识别——那条路径走
        # PrimaryBodyIrCallScalarValueSlotForTextImpl→
        # PrimaryBodyIrAppendWholeCallExprToSlot 的 rescue 分支, 不经过这里)。
        # 但当调度到本函数的语句(如整句 RHS/return 是"嵌套真实函数调用"的
        # `let f = float64(getN())`, node-eval 对这个形态诚实放弃后落到本函数)
        # 恰好也满足这个字段判据时, 继续走下面 add(bodyIR.callSequence, call)+
        # 真 BL 占位——目标符号"float64"从来不是可解析的真调用
        # (std/system.cheng:544 是从不编译的类型擦除占位符), 实测(cc 真链接+真
        # 运行值)确认通用符号解析对它会静默解析成错误的目标(读到程序里其他函数
        # 的地址), 是响亮 poison 缺失导致的静默 miscompile, 与豁免门 provenance
        # 是两个独立层次的同源问题。这个构造路径从未被验证过对"float64"目标
        # 安全, 唯一已验证安全的路径是 PrimaryBodyIrAppendWholeCallExprToSlot 的
        # rescue 分支——本函数不是它, 诚实拒绝, 不构造这个歧义 CallOp。
        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                     stmt.lineNumber,
                                     int32(stmt.kind),
                                     818,
                                     0)
        return resultSlot
    # share(call) aliases the local CallOp into callSequence. Zero-arg calls
    # never mutate nested seq fields, so the local still owns targetSymbol;
    # AppendCallOp return then releases it and BIRC reads empty
    # (body_ir_call_empty_reloc_target / target_len=0). Move the CallOp so
    # the sequence row owns the symbol. Capture non-str fields first.
    let callResultOwnershipSaved = call.resultOwnership
    let callResultExprNodeIndexSaved = call.resultExprNodeIndex
    var callTraceTarget = ""
    if PrimaryObjectPlanTraceActive():
        callTraceTarget = strings.CloneStr(call.targetSymbol)
    add(bodyIR.callSequence, call)
    PrimaryBodyIrControlBindCanonicalCallTarget(
        bodyIR,
        lowering,
        bodyIR.callSequence.len - 1,
        stmt.rhsNodeIndex)
    if PrimaryObjectPlanTraceActive():
        PrimaryObjectPlanTrace(strutil.Join(["primary_body_ir_call_append function=",
                                             strings.CloneStr(typedFn.functionName),
                                             " line=",
                                             strings.IntToStr(stmt.lineNumber),
                                             " kind=",
                                             strings.IntToStr(int32(stmt.kind)),
                                             " target=",
                                             strings.CloneStr(callTraceTarget),
                                             " ordinal=",
                                             strings.IntToStr(callOrdinal),
                                             " result_slot=",
                                             strings.IntToStr(resultSlot),
                                             " binding=",
                                             strings.CloneStr(stmt.bindingName),
                                             " surface=",
                                             strings.CloneStr(stmt.surfaceText)], ""))
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    op.target = resultSlot
    if callResultOwnershipSaved == coreir.OwnMove ||
       callResultOwnershipSaved == coreir.OwnBorrowShared:
        op.valueDefSlot = resultSlot
        op.valueDefExprNodeIndex = callResultExprNodeIndexSaved
        op.valueDefOwnership = callResultOwnershipSaved
    elif callResultOwnershipSaved == coreir.OwnInvalid &&
         !managedLocalDefinition:
        # [wall106] 非托管形第三臂：权威行 → op 全列纯值定义戳（见
        # PrimaryBodyIrBindUnmanagedCallResultDefinition 头注）。sentinel
        # 槽在该函数内部原样豁免，托管两臂与本臂互斥接入。
        PrimaryBodyIrBindUnmanagedCallResultDefinition(
            bodyIR,
            lowering.typedIr,
            irFunction.ownershipTransport,
            typedFn.functionName,
            stmt,
            resultSlot,
            op)
    add(op.operands, callOrdinal)
    let bodyOpIndex = coreir.BodyIRAppendOp(bodyIR, op)
    if managedLocalDefinition:
        lower.LoweringBindManagedCallResultDefinition(
            bodyIR,
            lowering,
            irFunction.ownershipTransport,
            stmt.statementIndex,
            stmt.rhsNodeIndex,
            callOrdinal,
            bodyOpIndex)
    callOrdinal = callOrdinal + 1
    return resultSlot

@borrows
fn PrimaryBodyIrBindManagedBridgeResultDefinition(
        bodyIR: var coreir.BodyIR,
        lowering: lower.LoweringPlanStub,
        transport: lower.LoweringOwnershipTransportSoA,
        nodeIndex: int32,
        callIndex: int32,
        bodyOpIndex: int32) =
    # Fmt 插值 join / str concat 桥的托管返回物化 exact 戳 (wall28 根修)。
    # typed_expr 已为 Fmt/StrAdd 生产者发 ManagedTemporary value-def 权威行
    # (TypedExprIrOpIsExactManagedTemporaryProducer), transport 窗原样携带;
    # 发布侧此前漏戳, 返回槽在 exact-def 证据链无任何 def op 行 → derive
    # 相 4 return admission 判词 `managed function return lacks exact
    # value definition`。本函数把该权威按行落到 op/call, 与
    # LoweringBindManagedCallResultDefinition 同一契约形态: 行查不到/域
    # 不符/已绑非零戳即 hard fail, TypeId 闭包与槽证明同款绑定, 零启发式。
    if nodeIndex < 0 ||
       nodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        panic("lowering ownership transport: managed temporary node out of range")
    let nodeOpKind = lowering.typedIr.nodes2_opKinds[nodeIndex]
    if !texpr.TypedExprIrOpIsExactManagedTemporaryProducer(nodeOpKind):
        panic(Fmt"lowering ownership transport: managed temporary producer node drift node={nodeIndex}")
    let ownerStatementIndex = texpr.TypedExprIrNodeOwnerStatementIndexAt(
        lowering.typedIr, nodeIndex)
    let row = lower.LoweringOwnershipTransportRowForDefinition(
        transport, ownerStatementIndex, nodeIndex)
    if row < 0 ||
       !transport.managedFlags[row] ||
       transport.nodeOpKinds[row] != nodeOpKind ||
       transport.callDeclarationIndexes[row] != -1 ||
       transport.originKinds[row] !=
           Int32(texpr.TypedExprValueDefinitionOriginManagedTemporary) ||
       transport.ownershipKinds[row] != texpr.TypedExprExprOwned ||
       transport.borrowOwnerValueDefinitionRows[row] != -1:
        panic(Fmt"lowering ownership transport: managed temporary definition missing node={nodeIndex} row={row}")
    if callIndex < 0 || callIndex >= bodyIR.callSequence.len ||
       bodyOpIndex < 0 || bodyOpIndex >= bodyIR.ops.len:
        panic("lowering ownership transport: BodyIR coordinate invalid")
    var call = bodyIR.callSequence[callIndex]
    var op = bodyIR.ops[bodyOpIndex]
    if op.kind != coreir.BodyOpCallTag ||
       op.operands.len != 1 ||
       op.operands[0] != callIndex ||
       op.target != call.resultSlot ||
       call.resultSlot < 0 ||
       call.resultSlot >= bodyIR.localSlots.len ||
       call.resultPassKind == coreir.BodyCallPassForwardEntrySretTag:
        panic("lowering ownership transport: bridge result is not a local value definition")
    if call.resultOwnership != coreir.OwnInvalid ||
       call.resultExprNodeIndex != -1 ||
       call.resultDefinitionOriginKind !=
           coreir.BodyDefinitionOriginUnknownTag ||
       call.resultDefinitionOriginId != -1 ||
       call.resultValueDefinitionRow != -1 ||
       call.resultBorrowOwnerValueDefinitionRow != -1 ||
       call.resultBorrowOwnerDefinitionDomain !=
           coreir.BodyDefinitionDomainInvalidTag ||
       call.resultBorrowOwnerDefinitionRow != -1 ||
       call.sourceDefinitionDomain !=
           coreir.BodyDefinitionDomainInvalidTag ||
       call.sourceDefinitionRow != -1 ||
       call.consumeActionRow != -1 ||
       op.valueDefOwnership != coreir.OwnInvalid ||
       op.valueDefSlot != -1 ||
       op.valueDefExprNodeIndex != -1 ||
       op.valueDefOriginKind != coreir.BodyDefinitionOriginUnknownTag ||
       op.valueDefOriginId != -1 ||
       op.valueDefSemanticRow != -1 ||
       op.valueDefBorrowOwnerSemanticRow != -1 ||
       op.valueDefBorrowOwnerDefinitionDomain !=
           coreir.BodyDefinitionDomainInvalidTag ||
       op.valueDefBorrowOwnerDefinitionRow != -1 ||
       op.sourceDefinitionDomain !=
           coreir.BodyDefinitionDomainInvalidTag ||
       op.sourceDefinitionRow != -1 ||
       op.consumeActionRow != -1:
        panic("lowering ownership transport: bridge result authority already bound")
    let semanticDefinitionRow = transport.definitionRows[row]
    let exactTypeId = transport.exactTypeIds[row]
    if semanticDefinitionRow <
           transport.sourceValueDefinitionStart ||
       semanticDefinitionRow !=
           transport.sourceValueDefinitionStart + row ||
       exactTypeId < 0 ||
       exactTypeId >= lowering.typeArenaStructuralKinds.len ||
       exactTypeId >= lowering.typeArenaScalarKinds.len ||
       exactTypeId >= lowering.typeArenaChildTypeIds.len ||
       exactTypeId >= lowering.typeArenaFixedLengths.len ||
       exactTypeId >= lowering.typeArenaSizeBytes.len ||
       exactTypeId >= lowering.typeArenaAlignBytes.len ||
       !layout.FixedBytes32Equal(
           transport.typeArenaArtifactCid,
           lowering.typeArenaArtifactCid):
        panic("lowering ownership transport: exact semantic TypeId authority invalid")
    if !managedreplace.ManagedLvalueReplaceProductionBindTypeClosure(
           bodyIR,
           lowering.typeArenaArtifactCid,
           exactTypeId,
           lowering.typeArenaStructuralKinds,
           lowering.typeArenaScalarKinds,
           lowering.typeArenaChildTypeIds,
           lowering.typeArenaFixedLengths,
           lowering.typeArenaSizeBytes,
           lowering.typeArenaAlignBytes) ||
       !coreir.BodyIRBindLocalSlotTypeArenaProof(
           bodyIR,
           call.resultSlot,
           lowering.typeArenaArtifactCid,
           exactTypeId,
           coreir.BodyManagedStorageManagedTag):
        panic("lowering ownership transport: exact TypeId closure bind failed")
    call.resultOwnership = coreir.OwnMove
    call.resultExprNodeIndex = transport.definingNodeIndexes[row]
    call.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    call.resultDefinitionOriginId =
        semanticDefinitionRow
    call.resultValueDefinitionRow =
        semanticDefinitionRow
    call.resultBorrowOwnerValueDefinitionRow = -1
    call.resultBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainInvalidTag
    call.resultBorrowOwnerDefinitionRow = -1
    op.valueDefSlot = call.resultSlot
    op.valueDefExprNodeIndex = transport.definingNodeIndexes[row]
    op.valueDefOwnership = coreir.OwnMove
    op.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = semanticDefinitionRow
    op.valueDefSemanticRow = semanticDefinitionRow
    op.valueDefBorrowOwnerSemanticRow = -1
    op.valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainInvalidTag
    op.valueDefBorrowOwnerDefinitionRow = -1
    bodyIR.callSequence[callIndex] = call
    bodyIR.ops[bodyOpIndex] = op

@borrows
fn PrimaryBodyIrPatchTargetMatchesExisting(existing: str,
                                            expectedTarget: str,
                                            expectedImportc: str): bool =
    if existing == "":
        return true
    if expectedImportc != "":
        if existing == expectedImportc:
            return true
        if PrimaryBodyIrCanonicalCallTargetSymbol(existing) == expectedImportc:
            return true
        if existing == PrimaryBodyIrCanonicalCallTargetSymbol(expectedImportc):
            return true
    if expectedTarget == "":
        return false
    if expectedTarget == "assert" && (existing == "assertPtrBridge" || existing == "assertPtrBridgeRuntime" || existing == "std/system::assert"):
        return true
    if expectedTarget == "Assert" && (existing == "AssertPtrBridge" || existing == "assertPtrBridgeRuntime" || existing == "std/system::Assert"):
        return true
    if (expectedTarget == "echo" || expectedTarget == "Echo") && existing == "puts":
        return true
    if (expectedTarget == "StrDataPtr" || expectedTarget == "strDataPtr") && existing == "std/system::StrDataPtr":
        return true
    if existing == expectedTarget:
        return true
    if PrimaryBodyIrCanonicalCallTargetSymbol(existing) == expectedTarget:
        return true
    if existing == PrimaryBodyIrCanonicalCallTargetSymbol(expectedTarget):
        return true
    return false

@borrows
fn PrimaryBodyIrPatchCallTargetSymbols(bodyIR: var coreir.BodyIR,
                                         callTargets: str[],
                                         callImportcSymbols: str[]) =
    var sourceOrdinal: int32
    for ci in 0..<bodyIR.callSequence.len:
        let existingSymbol = bodyIR.callSequence[ci].targetSymbol
        var expectedTarget = ""
        if sourceOrdinal < callTargets.len:
            expectedTarget = callTargets[sourceOrdinal]
        var expectedImportc = ""
        if sourceOrdinal < callImportcSymbols.len:
            expectedImportc = callImportcSymbols[sourceOrdinal]
        if PrimaryBodyIrDirectExternalCallTarget(existingSymbol):
            # Direct runtime calls can be synthesized by BodyIR (setMem/copyMem/ptr_add).
            # Only consume a source call row when the row actually matches this call.
            var matchedDirectOrdinal = -1
            if PrimaryBodyIrPatchTargetMatchesExisting(existingSymbol,
                                                       expectedTarget,
                                                       expectedImportc):
                matchedDirectOrdinal = sourceOrdinal
            else:
                for scanOrdinal in sourceOrdinal..<callTargets.len:
                    var scanTarget = ""
                    var scanImportc = ""
                    if scanOrdinal < callTargets.len:
                        scanTarget = callTargets[scanOrdinal]
                    if scanOrdinal < callImportcSymbols.len:
                        scanImportc = callImportcSymbols[scanOrdinal]
                    if PrimaryBodyIrPatchTargetMatchesExisting(existingSymbol,
                                                               scanTarget,
                                                               scanImportc):
                        matchedDirectOrdinal = scanOrdinal
                        break
            if matchedDirectOrdinal >= 0:
                sourceOrdinal = matchedDirectOrdinal
                expectedTarget = callTargets[sourceOrdinal]
                if sourceOrdinal < callImportcSymbols.len:
                    expectedImportc = callImportcSymbols[sourceOrdinal]
                if len(expectedImportc) > 0 && expectedImportc != existingSymbol:
                    PrimaryBodyIrNodeBoolChainJournalCallBeforeWrite(bodyIR, ci)
                    bodyIR.callSequence[ci].targetSymbol = share(expectedImportc)
                sourceOrdinal = sourceOrdinal + 1
            continue
        if !PrimaryBodyIrPatchTargetMatchesExisting(existingSymbol,
                                                    expectedTarget,
                                                    expectedImportc):
            var matchedOrdinal: int32
            matchedOrdinal = -1
            for scanOrdinal in sourceOrdinal..<callTargets.len:
                var scanTarget = ""
                var scanImportc = ""
                if scanOrdinal < callTargets.len:
                    scanTarget = callTargets[scanOrdinal]
                if scanOrdinal < callImportcSymbols.len:
                    scanImportc = callImportcSymbols[scanOrdinal]
                if PrimaryBodyIrPatchTargetMatchesExisting(existingSymbol,
                                                           scanTarget,
                                                           scanImportc):
                    matchedOrdinal = scanOrdinal
                    break
            if matchedOrdinal < 0:
                for scanOrdinal in 0..<sourceOrdinal:
                    var scanTarget = ""
                    var scanImportc = ""
                    if scanOrdinal < callTargets.len:
                        scanTarget = callTargets[scanOrdinal]
                    if scanOrdinal < callImportcSymbols.len:
                        scanImportc = callImportcSymbols[scanOrdinal]
                    if PrimaryBodyIrPatchTargetMatchesExisting(existingSymbol,
                                                               scanTarget,
                                                               scanImportc):
                        matchedOrdinal = scanOrdinal
                        break
            if matchedOrdinal < 0:
                continue
            sourceOrdinal = matchedOrdinal
            expectedTarget = callTargets[sourceOrdinal]
            if sourceOrdinal < callImportcSymbols.len:
                expectedImportc = callImportcSymbols[sourceOrdinal]
        var targetSymbol = ""
        if len(expectedImportc) > 0:
            targetSymbol = share(expectedImportc)
        elif len(expectedTarget) > 0:
            targetSymbol = share(expectedTarget)
        if targetSymbol == "assert" && (existingSymbol == "assertPtrBridge" || existingSymbol == "assertPtrBridgeRuntime" || existingSymbol == "std/system::assert"):
            targetSymbol = "assert"
        if targetSymbol == "Assert" && (existingSymbol == "AssertPtrBridge" || existingSymbol == "assertPtrBridgeRuntime" || existingSymbol == "std/system::Assert"):
            targetSymbol = "Assert"
        if (targetSymbol == "echo" || targetSymbol == "Echo") && existingSymbol == "puts":
            targetSymbol = share(existingSymbol)
        if targetSymbol == "StrDataPtr" && existingSymbol == "std/system::StrDataPtr":
            targetSymbol = share(existingSymbol)
        if len(targetSymbol) > 0:
            PrimaryBodyIrNodeBoolChainJournalCallBeforeWrite(bodyIR, ci)
            bodyIR.callSequence[ci].targetSymbol = share(targetSymbol)
        if sourceOrdinal < callTargets.len:
            sourceOrdinal = sourceOrdinal + 1

@borrows
fn PrimaryBodyIrTraceCallSequence(label: str,
                                   functionName: str,
                                   bodyIR: coreir.BodyIR) =
    if !PrimaryObjectPlanTraceActive():
        return
    if PrimaryObjectPlanTraceActive():
        PrimaryObjectPlanTrace(Fmt"{label} function={functionName} calls={bodyIR.callSequence.len}")
    for ci in 0..<bodyIR.callSequence.len:
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"{label}_call function={functionName} index={ci} target={bodyIR.callSequence[ci].targetSymbol}")

@borrows
fn PrimarySymbolStripLeadingUnderscores(text: str): str =
    var start: int32
    while start < len(text):
        if text[start] != '_':
            break
        start = start + 1
    if start <= 0:
        return text
    if start >= len(text):
        return ""
    return strings.SliceBytes(text, start, len(text) - start)

@borrows
fn PrimaryCallTargetMatchesName(targetText: str,
                                 name: str): bool =
    if targetText == name:
        return true
    let targetPlain = PrimarySymbolStripLeadingUnderscores(targetText)
    if targetPlain == name:
        return true
    let targetTail = PrimaryCallTargetTailName(targetText)
    if targetTail == name:
        return true
    let tailPlain = PrimarySymbolStripLeadingUnderscores(targetTail)
    if tailPlain == name:
        return true
    return false

@borrows
fn PrimaryBodyIrIsOrcRetainAtomicTarget(targetText: str): bool =
    if PrimaryCallTargetMatchesName(targetText, "cheng_mem_retain_atomic"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "memRetainAtomic"):
        return true
    return false

@borrows
fn PrimaryBodyIrIsOrcReleaseAtomicTarget(targetText: str): bool =
    if PrimaryCallTargetMatchesName(targetText, "cheng_mem_release_atomic"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "memReleaseAtomic"):
        return true
    return false

@borrows
fn PrimaryBodyIrIsChengMallocTarget(targetText: str): bool =
    if PrimaryCallTargetMatchesName(targetText, "cheng_malloc"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "baselineMalloc"):
        return true
    return false

@borrows
fn PrimaryBodyIrIsOrcDiagObserverTarget(targetText: str): bool =
    if PrimaryCallTargetMatchesName(targetText, "memDiagReset"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "cheng_mm_diag_reset"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "memRetainCount"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "memReleaseCount"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "memAllocCount"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "memFreeCount"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "memLiveCount"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "memRefCount"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "memRefCountAtomic"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "cheng_mm_retain_count"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "cheng_mm_release_count"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "cheng_mm_alloc_count"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "cheng_mm_free_count"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "cheng_mm_live_count"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "cheng_mem_refcount"):
        return true
    if PrimaryCallTargetMatchesName(targetText, "cheng_mem_refcount_atomic"):
        return true
    return false

fn PrimaryLoweringHasOrcDiagObserver(lowering: var lower.LoweringPlanStub): bool =
    for fi in 0..<lowering.primaryObjectIr.functions.len:
        let irFunction = lowering.primaryObjectIr.functions[fi]
        for ci in 0..<irFunction.callTargets.len:
            if PrimaryBodyIrIsOrcDiagObserverTarget(irFunction.callTargets[ci]):
                return true
        for ci in 0..<irFunction.callImportcSymbols.len:
            if PrimaryBodyIrIsOrcDiagObserverTarget(irFunction.callImportcSymbols[ci]):
                return true
    return false

@borrows
fn PrimaryBodyIrCallOrdinalAtOp(bodyIR: coreir.BodyIR,
                                 opIndex: int32): int32 =
    if opIndex < 0:
        return -1
    if opIndex >= bodyIR.ops.len:
        return -1
    let op = bodyIR.ops[opIndex]
    if op.kind != coreir.BodyOpCallTag:
        return -1
    if op.operands.len <= 0:
        return -1
    let callOrdinal = op.operands[0]
    if callOrdinal < 0:
        return -1
    if callOrdinal >= bodyIR.callSequence.len:
        return -1
    return callOrdinal

@borrows
fn PrimaryBodyIrCallUsesSlot(call: coreir.CallOp,
                              slot: int32): bool =
    for ai in 0..<call.argSlots.len:
        let argSlot = call.argSlots[ai]
        if argSlot == slot:
            return true
        if coreir.CallArgSlotIsAddress(argSlot):
            if coreir.CallArgSlotAddressId(argSlot) == slot:
                return true
    return false

@borrows
fn PrimaryBodyIrSlotWrittenAfterMalloc(bodyIR: coreir.BodyIR,
                                        slot: int32,
                                        startOpIndex: int32,
                                        stopOpIndex: int32): bool =
    if startOpIndex < 0:
        return true
    if stopOpIndex > bodyIR.ops.len:
        return true
    for oi in startOpIndex..<stopOpIndex:
        let op = bodyIR.ops[oi]
        if op.target == slot:
            return true
    return false

@borrows
fn PrimaryBodyIrSlotEscapesBetween(bodyIR: coreir.BodyIR,
                                    slot: int32,
                                    startOpIndex: int32,
                                    stopOpIndex: int32): bool =
    if startOpIndex < 0:
        return true
    if stopOpIndex > bodyIR.ops.len:
        return true
    for oi in startOpIndex..<stopOpIndex:
        let callOrdinal = PrimaryBodyIrCallOrdinalAtOp(bodyIR, oi)
        if callOrdinal < 0:
            continue
        if PrimaryBodyIrCallUsesSlot(bodyIR.callSequence[callOrdinal], slot):
            return true
    return false

@borrows
fn PrimaryBodyIrSlotIsFreshChengMallocResult(bodyIR: coreir.BodyIR,
                                              slot: int32,
                                              beforeOpIndex: int32): bool =
    if slot < 0:
        return false
    if slot >= bodyIR.localSlots.len:
        return false
    if bodyIR.localSlots[slot].typeKind != coreir.LocalPtrTag:
        return false
    var mallocOpIndex: int32
    mallocOpIndex = -1
    for oi in 0..<beforeOpIndex:
        let callOrdinal = PrimaryBodyIrCallOrdinalAtOp(bodyIR, oi)
        if callOrdinal < 0:
            continue
        let call = bodyIR.callSequence[callOrdinal]
        if call.resultSlot != slot:
            continue
        if call.resultPassKind != coreir.BodyCallPassStackValueTag:
            continue
        if !PrimaryBodyIrIsChengMallocTarget(call.targetSymbol):
            continue
        mallocOpIndex = oi
    if mallocOpIndex < 0:
        return false
    if PrimaryBodyIrSlotWrittenAfterMalloc(bodyIR,
                                           slot,
                                           mallocOpIndex + 1,
                                           beforeOpIndex):
        return false
    if PrimaryBodyIrSlotEscapesBetween(bodyIR,
                                       slot,
                                       mallocOpIndex + 1,
                                       beforeOpIndex):
        return false
    return true

@borrows
fn PrimaryBodyIrCanElideOrcRetainReleasePair(bodyIR: coreir.BodyIR,
                                              retainOpIndex: int32,
                                              releaseOpIndex: int32): bool =
    let retainCallOrdinal = PrimaryBodyIrCallOrdinalAtOp(bodyIR, retainOpIndex)
    if retainCallOrdinal < 0:
        return false
    let releaseCallOrdinal = PrimaryBodyIrCallOrdinalAtOp(bodyIR, releaseOpIndex)
    if releaseCallOrdinal < 0:
        return false
    let retainCall = bodyIR.callSequence[retainCallOrdinal]
    let releaseCall = bodyIR.callSequence[releaseCallOrdinal]
    if !PrimaryBodyIrIsOrcRetainAtomicTarget(retainCall.targetSymbol):
        return false
    if !PrimaryBodyIrIsOrcReleaseAtomicTarget(releaseCall.targetSymbol):
        return false
    if retainCall.resultSlot >= 0:
        return false
    if releaseCall.resultSlot >= 0:
        return false
    if retainCall.argSlots.len != 1:
        return false
    if releaseCall.argSlots.len != 1:
        return false
    if retainCall.argPassKinds.len != 1:
        return false
    if releaseCall.argPassKinds.len != 1:
        return false
    if retainCall.argPassKinds[0] != coreir.BodyCallPassStackValueTag:
        return false
    if releaseCall.argPassKinds[0] != coreir.BodyCallPassStackValueTag:
        return false
    let ptrSlot = retainCall.argSlots[0]
    if ptrSlot != releaseCall.argSlots[0]:
        return false
    return PrimaryBodyIrSlotIsFreshChengMallocResult(bodyIR, ptrSlot, retainOpIndex)

@borrows
fn PrimaryBodyIrCloneCallOp(call: coreir.CallOp): coreir.CallOp =
    var out: coreir.CallOp
    out.targetSymbol = strings.CloneStr(call.targetSymbol)
    out.targetSourcePath = strings.CloneStr(call.targetSourcePath)
    for i in 0..<call.argSlots.len:
        add(out.argSlots, call.argSlots[i])
    for i in 0..<call.argPassKinds.len:
        add(out.argPassKinds, call.argPassKinds[i])
    for i in 0..<call.argAbiSizes.len:
        add(out.argAbiSizes, call.argAbiSizes[i])
    out.resultSlot = call.resultSlot
    out.resultPassKind = call.resultPassKind
    out.resultOwnership = call.resultOwnership
    out.resultExprNodeIndex = call.resultExprNodeIndex
    out.resultValueDefinitionRow = call.resultValueDefinitionRow
    out.resultDefinitionOriginKind = call.resultDefinitionOriginKind
    out.resultDefinitionOriginId = call.resultDefinitionOriginId
    out.sourceDefinitionDomain = call.sourceDefinitionDomain
    out.sourceDefinitionRow = call.sourceDefinitionRow
    out.semanticCallExprNodeIndex = call.semanticCallExprNodeIndex
    out.consumeActionRow = call.consumeActionRow
    out.managedStoreKind = call.managedStoreKind
    out.relocWordOffset = call.relocWordOffset
    out.targetIsImportc = call.targetIsImportc
    out.inlineF64FromIntKind = call.inlineF64FromIntKind
    out.wholeCallF64FromIntRescue = call.wholeCallF64FromIntRescue
    out.inlineF64FromIntUnsigned = call.inlineF64FromIntUnsigned
    return out

@borrows
fn PrimaryBodyIrElideOrcRetainReleasePairs(bodyIR: var coreir.BodyIR,
                                            orcDiagObserverPresent: bool): int32 =
    if orcDiagObserverPresent:
        return 0
    if bodyIR.ops.len <= 1:
        return 0
    if bodyIR.callSequence.len <= 1:
        return 0
    var removeOps = PrimaryBoolSeqInit(bodyIR.ops.len, false)
    var removeCalls = PrimaryBoolSeqInit(bodyIR.callSequence.len, false)
    var elidedCount: int32
    for bi in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[bi]
        let blockStart = block.opStart
        let blockEnd = block.opStart + block.opCount
        if blockStart < 0:
            continue
        if blockEnd > bodyIR.ops.len:
            continue
        var oi = blockStart
        while oi + 1 < blockEnd:
            if removeOps[oi]:
                oi = oi + 1
                continue
            if PrimaryBodyIrCanElideOrcRetainReleasePair(bodyIR, oi, oi + 1):
                let retainCallOrdinal = PrimaryBodyIrCallOrdinalAtOp(bodyIR, oi)
                let releaseCallOrdinal = PrimaryBodyIrCallOrdinalAtOp(bodyIR, oi + 1)
                if retainCallOrdinal >= 0 && releaseCallOrdinal >= 0:
                    removeOps[oi] = true
                    removeOps[oi + 1] = true
                    removeCalls[retainCallOrdinal] = true
                    removeCalls[releaseCallOrdinal] = true
                    elidedCount = elidedCount + 1
                    oi = oi + 2
                    continue
            oi = oi + 1
    if elidedCount <= 0:
        return 0
    var callOrdinalMap = PrimaryIntSeqInit(bodyIR.callSequence.len, -1)
    var newCallSequence: coreir.CallOp[]
    for ci in 0..<bodyIR.callSequence.len:
        if removeCalls[ci]:
            continue
        callOrdinalMap[ci] = newCallSequence.len
        add(newCallSequence, PrimaryBodyIrCloneCallOp(bodyIR.callSequence[ci]))
    var newOps: coreir.BodyOp[]
    var newBlocks: coreir.BodyBlock[]
    for bi in 0..<bodyIR.blocks.len:
        var nextBlock = bodyIR.blocks[bi]
        let blockStart = nextBlock.opStart
        let blockEnd = nextBlock.opStart + nextBlock.opCount
        nextBlock.opStart = newOps.len
        nextBlock.opCount = 0
        var primaryColdCond5: bool
        var primaryColdCond5Clause0: bool
        if blockStart >= 0:
            if blockEnd <= bodyIR.ops.len:
                primaryColdCond5Clause0 = true
        if primaryColdCond5Clause0:
            primaryColdCond5 = true
        if primaryColdCond5:
            for oi in blockStart..<blockEnd:
                if removeOps[oi]:
                    continue
                var nextOp = bodyIR.ops[oi]
                if nextOp.kind == coreir.BodyOpCallTag && nextOp.operands.len > 0:
                    let oldCallOrdinal = nextOp.operands[0]
                    if oldCallOrdinal >= 0 && oldCallOrdinal < callOrdinalMap.len:
                        let newCallOrdinal = callOrdinalMap[oldCallOrdinal]
                        if newCallOrdinal >= 0:
                            nextOp.operands[0] = newCallOrdinal
                add(newOps, nextOp)
                nextBlock.opCount = nextBlock.opCount + 1
        add(newBlocks, nextBlock)
    bodyIR.callSequence = newCallSequence
    bodyIR.ops = newOps
    bodyIR.blocks = newBlocks
    coreir.BodyIRClearFrameLayoutCache(bodyIR)
    return elidedCount

# --- Scope-exit deterministic release, first cut ---
# (docs/beat-c.md §11 §5.4). The canonical BodyIR access decoder is the only
# use/def source. Predicate for slot i:
#   1) typeKind == LocalStrTag (str only, first cut — see §5.4 for why not
#      seq/Bytes/struct yet)
#   2) placeKind == BodyPlaceStackValueTag and NOT a param (plain local only)
#   3) ownership == OwnPlain (never release a borrowed/moved slot)
#   4) EscapeArenaRouteSlotIsArenaSafe (EscapeNone/EscapeLocal only)
#   5) firstDef..lastUse from canonical access facts falls inside a single
#      block that is not part of ANY back-edge-reachable loop range, and whose
#      terminator does not itself read the slot.
# Gate: CHENG_SCOPE_EXIT_RELEASE=0 opts out, default ON (wave-17: the off
# default left every pure-backend-built driver leaking abandoned str
# temporaries — self-bake RSS grew unboundedly while the cold-built driver
# peaked ~10.8GB). Cross-block / loop-carried / seq / Bytes / struct-field
# slots are explicitly out of scope for this cut (left to the next slice, per
# the plan's risk section on use-after-free).

@borrows
fn PrimaryBodyIrScopeExitReleaseEnabled(): bool =
    let gate = os.GetEnv("CHENG_SCOPE_EXIT_RELEASE")
    return gate != "0"

@borrows
fn PrimaryBodyIrScopeExitBlockContainingOp(bodyIR: coreir.BodyIR, opIndex: int32): int32 =
    if opIndex < 0:
        return -1
    for bi in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[bi]
        if block.opStart >= 0 && block.opCount >= 0 &&
           opIndex >= block.opStart && opIndex < block.opStart + block.opCount:
            return bi
    return -1

# Conservative superset loop-block test: ANY back-edge (a term whose target
# block index is < its own block index) marks every block in [target..source]
# as loop-participating. Scope-exit release must not depend on a machine
# register planner, so it recognizes every loop shape directly.
@borrows
fn PrimaryBodyIrScopeExitBlockInAnyLoop(bodyIR: coreir.BodyIR, blockId: int32): bool =
    for bi in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[bi]
        if block.termIndex < 0 || block.termIndex >= bodyIR.terms.len:
            continue
        let term = bodyIR.terms[block.termIndex]
        if term.kind == coreir.BodyTermBrTag:
            if term.trueBlock >= 0 && term.trueBlock < bi &&
               blockId >= term.trueBlock && blockId <= bi:
                return true
        elif term.kind == coreir.BodyTermCbrTag:
            if term.trueBlock >= 0 && term.trueBlock < bi &&
               blockId >= term.trueBlock && blockId <= bi:
                return true
            if term.falseBlock >= 0 && term.falseBlock < bi &&
               blockId >= term.falseBlock && blockId <= bi:
                return true
    return false

@borrows
fn PrimaryBodyIrScopeExitTermUsesSlot(bodyIR: coreir.BodyIR, blockId: int32, slot: int32): bool =
    if blockId < 0 || blockId >= bodyIR.blocks.len:
        return true
    let block = bodyIR.blocks[blockId]
    if block.termIndex < 0 || block.termIndex >= bodyIR.terms.len:
        return false
    let term = bodyIR.terms[block.termIndex]
    if term.resultSlot == slot:
        return true
    if term.lhsSlot == slot:
        return true
    if term.rhsSlot == slot:
        return true
    for oi in 0..<term.operands.len:
        if term.operands[oi] == slot:
            return true
    return false

# wave-17 定点修复: explicit escape-kind gate for the scope-exit release pass.
# The scaffold's IsArenaSafe marks every non-scalar slot Unknown (its noAlias
# proof covers scalars only), which made the whole pass inert. Release is
# allowed for slots with NO observed escape (None) or no alias proof
# (Unknown), and rejected for Global (stored to a global), Return (handed to
# the caller) and Local (indexed-stored into a container).
@borrows
fn PrimaryBodyIrScopeExitEscapeKindBlocked(escape: ear.EscapeArenaRouteResult, slot: int32): bool =
    let kind = ear.EscapeArenaRouteSlotEscape(escape, slot)
    if kind == ear.EscapeKindGlobal:
        return true
    if kind == ear.EscapeKindReturn:
        return true
    if kind == ear.EscapeKindLocal:
        return true
    return false

# A slot whose payload is handed out as a whole-aggregate copy (CopyLocal
# source) or written into a container (IndexedStore/FieldStore value source)
# shares ownership with that copy/container; releasing the slot would free
# the shared payload while the copy is still alive. Reject those slots.
@borrows
fn PrimaryBodyIrScopeExitSlotIsCopyOrStoreSource(bodyIR: coreir.BodyIR, slot: int32): bool =
    for oi in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[oi]
        if op.kind == coreir.BodyOpCopyLocalTag:
            if op.operands.len > 0 && op.operands[0] == slot:
                return true
        elif op.kind == coreir.BodyOpIndexedStoreTag || op.kind == coreir.BodyOpFieldStoreTag:
            if op.operands.len > 1 && op.operands[1] == slot:
                return true
    return false

# Freshness: the slot's first definition must be a call result (sret) — a
# value this frame uniquely owns. Anything defined from another slot (copy
# chain) shares the payload and is rejected.
@borrows
fn PrimaryBodyIrScopeExitSlotFirstDefIsFreshCall(bodyIR: coreir.BodyIR, firstDef: int32): bool =
    if firstDef < 0 || firstDef >= bodyIR.ops.len:
        return false
    return bodyIR.ops[firstDef].kind == coreir.BodyOpCallTag

@borrows
fn PrimaryBodyIrScopeExitSlotQualifies(bodyIR: coreir.BodyIR,
                                         accesses: bodyaccess.BodyIrAccessTable,
                                         escape: ear.EscapeArenaRouteResult,
                                         slot: int32,
                                         insertAfterOpOut: var int32): bool =
    if slot < 0 || slot >= bodyIR.localSlots.len:
        return false
    let ls = bodyIR.localSlots[slot]
    if ls.typeKind != coreir.LocalStrTag:
        return false
    if ls.placeKind != coreir.BodyPlaceStackValueTag:
        return false
    if PrimaryBodyIrLocalIsParam(ls):
        return false
    if ls.ownership != coreir.OwnPlain:
        return false
    if PrimaryBodyIrScopeExitEscapeKindBlocked(escape, slot):
        return false
    if PrimaryBodyIrScopeExitSlotIsCopyOrStoreSource(bodyIR, slot):
        return false
    var firstDef: int32 = -1
    var lastUse: int32 = -1
    for factIndex in 0..<accesses.facts.len:
        let fact = accesses.facts[factIndex]
        if fact.slotIndex != slot ||
           fact.siteKind != bodyaccess.BodyIrAccessSiteOp:
            continue
        if fact.kind == bodyaccess.BodyIrAccessFactDef &&
           (firstDef < 0 || fact.siteIndex < firstDef):
            firstDef = fact.siteIndex
        if fact.kind == bodyaccess.BodyIrAccessFactUse &&
           fact.siteIndex > lastUse:
            lastUse = fact.siteIndex
    if firstDef < 0 || lastUse < 0:
        return false
    if !PrimaryBodyIrScopeExitSlotFirstDefIsFreshCall(bodyIR, firstDef):
        return false
    let defBlock = PrimaryBodyIrScopeExitBlockContainingOp(bodyIR, firstDef)
    let useBlock = PrimaryBodyIrScopeExitBlockContainingOp(bodyIR, lastUse)
    if defBlock < 0 || useBlock < 0 || defBlock != useBlock:
        return false
    if PrimaryBodyIrScopeExitBlockInAnyLoop(bodyIR, defBlock):
        return false
    if PrimaryBodyIrScopeExitTermUsesSlot(bodyIR, defBlock, slot):
        return false
    insertAfterOpOut = lastUse
    return true

# Emits (FieldLoad data@0/8, FieldLoad flags@16/4, Call cheng_str_release_scope)
# straight-line into newOps (no new block/term — the guard lives inside the
# runtime callee, see cheng_str_release_scope_export in
# program_support_backend.cheng), appending the two temp slots to
# bodyIR.localSlots. Returns the op count added (for opCount bookkeeping by
# the caller).
fn PrimaryBodyIrScopeExitEmitRelease(bodyIR: var coreir.BodyIR,
                                       newOps: var coreir.BodyOp[],
                                       slot: int32): int32 =
    let dataSlotId = bodyIR.localSlots.len
    PrimaryBodyIrLocalSlotNewSized(bodyIR, dataSlotId,
                                  Fmt"#scope_exit_data{dataSlotId}",
                                  coreir.LocalPtrTag, 0, 0)
    let flagsSlotId = bodyIR.localSlots.len
    PrimaryBodyIrLocalSlotNewSized(bodyIR, flagsSlotId,
                                  Fmt"#scope_exit_flags{flagsSlotId}",
                                  coreir.LocalI32Tag, 0, 0)
    var dataOp: coreir.BodyOp
    dataOp.kind = coreir.BodyOpFieldLoadTag
    dataOp.target = dataSlotId
    add(dataOp.operands, slot)
    add(dataOp.operands, dataSlotId)
    add(dataOp.operands, 0)
    add(dataOp.operands, 8)
    add(newOps, dataOp)
    var flagsOp: coreir.BodyOp
    flagsOp.kind = coreir.BodyOpFieldLoadTag
    flagsOp.target = flagsSlotId
    add(flagsOp.operands, slot)
    add(flagsOp.operands, flagsSlotId)
    add(flagsOp.operands, 16)
    add(flagsOp.operands, 4)
    add(newOps, flagsOp)
    var releaseCall: coreir.CallOp
    releaseCall.targetSymbol = "cheng_str_release_scope"
    releaseCall.resultSlot = -1
    releaseCall.resultPassKind = coreir.BodyCallPassStackValueTag
    add(releaseCall.argSlots, dataSlotId)
    add(releaseCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(releaseCall.argSlots, flagsSlotId)
    add(releaseCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    let callOrdinal = bodyIR.callSequence.len
    add(bodyIR.callSequence, releaseCall)
    var callOp: coreir.BodyOp
    callOp.kind = coreir.BodyOpCallTag
    callOp.target = -1
    add(callOp.operands, callOrdinal)
    add(newOps, callOp)
    return 3

# Single mutation point: scans once, decides once, splices real ops into
# bodyIR.ops/blocks/callSequence once — mirrors the exact
# rebuild-newOps/newBlocks bookkeeping PrimaryBodyIrElideOrcRetainReleasePairs
# already uses above, so every downstream reader (frame metrics, the arm64
# *Raw size predictors, the fillers) sees the post-insertion body as simply
# "the body" with no separate parallel decision array to keep in lockstep.
# Block ids/term indices are unaffected (no block/term is added or removed,
# only op counts and opStart offsets grow); PrimaryBodyIrReflowLocalStackOffsets
# re-runs afterward so the new temp slots get real stack offsets before frame
# metrics are computed.
fn PrimaryBodyIrApplyScopeExitReleases(bodyIR: var coreir.BodyIR): int32 =
    if !PrimaryBodyIrScopeExitReleaseEnabled():
        return 0
    if bodyIR.ops.len <= 0:
        return 0
    if bodyIR.blocks.len <= 0:
        return 0
    let accesses = bodyaccess.BodyIrAccessDecode(bodyIR)
    # 域守卫 (非兜底): 无有效 canonical access facts 的 body 不在本 pass 的
    # 可证安全域内 —— 例如 seq-add 内征消化后 callSequence 残留 0-use
    # ordinal (主管线自身合法容忍的形态, 见
    # PrimaryObjectPlanCallOrdinalIsSeqAddIntrinsic 的同款特判), 原样交还
    # 主管线 (其自身发射或 bail, 与本 pass 无关)。gate 默认开后该守卫替代
    # 原 assert: facts 无效是主管线可容忍形态, 不是本 pass 的崩溃条件。
    if !accesses.valid:
        return 0
    let escape = ear.EscapeArenaRouteAnalyze(bodyIR)
    var candidateSlots: int32[]
    var candidateInsertAfter: int32[]
    for i in 0..<bodyIR.localSlots.len:
        var insertAfterOp: int32
        if PrimaryBodyIrScopeExitSlotQualifies(bodyIR, accesses, escape, i, insertAfterOp):
            add(candidateSlots, i)
            add(candidateInsertAfter, insertAfterOp)
    if candidateSlots.len <= 0:
        return 0
    var newOps: coreir.BodyOp[]
    var newBlocks: coreir.BodyBlock[]
    var releasedCount: int32
    for bi in 0..<bodyIR.blocks.len:
        var block = bodyIR.blocks[bi]
        let blockStart = block.opStart
        let blockEnd = block.opStart + block.opCount
        block.opStart = newOps.len
        block.opCount = 0
        if blockStart >= 0 && blockEnd <= bodyIR.ops.len:
            for oi in blockStart..<blockEnd:
                add(newOps, share(bodyIR.ops[oi]))
                block.opCount = block.opCount + 1
                for ci in 0..<candidateSlots.len:
                    if candidateInsertAfter[ci] == oi:
                        let added = PrimaryBodyIrScopeExitEmitRelease(bodyIR, newOps, candidateSlots[ci])
                        block.opCount = block.opCount + added
                        releasedCount = releasedCount + 1
        add(newBlocks, block)
    bodyIR.ops = newOps
    bodyIR.blocks = newBlocks
    coreir.BodyIRClearFrameLayoutCache(bodyIR)
    if releasedCount > 0:
        PrimaryBodyIrReflowLocalStackOffsets(bodyIR)
    return releasedCount

@borrows
fn PrimaryBodyIrAppendReturnTerm(bodyIR: var coreir.BodyIR,
                                  currentBlockStart: var int32,
                                  resultSlot: int32,
                                  resultTypeKind: int32,
                                  constValue: int32,
                                  hasConst: bool) =
    var retTerm: coreir.BodyTerm
    retTerm.kind = coreir.BodyTermReturnTag
    retTerm.resultSlot = resultSlot
    retTerm.trueBlock = -1
    retTerm.falseBlock = -1
    # Return reads no guard slot: pin lhs/rhs to -1 so the phantom slot-0 default never
    # feeds the blanket terminator poison (WT-off) nor the body-wide slot read counts.
    retTerm.lhsSlot = -1
    retTerm.rhsSlot = -1
    # wall33 根修 c: 本 return terminator 移交的托管 OwnMove 值定义必须携带精确
    # return-term 消费边 —— decode 契约 (body_ir_access) 对「返回槽带托管 op 定义
    # 而 term 无 sourceDefinition 边」硬失败, 且 consume=0 定义除 append-only move
    # 事件外唯一 admitted 出路就是该边。被移交定义 = 返回槽最近的、带完整 TypedExpr
    # +OwnMove 权威戳的定义 op (primary 三处 binder/WholeCall 戳的唯一生产形)。
    # 借视 (OwnBorrowShared) 与无定义槽不落边, 与 decode 的 OwnMove-only term
    # 边契约逐字对齐; 定义已带 op 消费链 (valueDefConsumeOpIndexPlusOne != 0)
    # 时同样不落边 —— 边+链并存按契约必炸, 该形本就是 use-after-move。
    if resultSlot >= 0:
        var retDefScanIndex = bodyIR.ops.len - 1
        while retDefScanIndex >= 0:
            let retDefCandidate = bodyIR.ops[retDefScanIndex]
            if retDefCandidate.valueDefSlot == resultSlot &&
               retDefCandidate.valueDefOwnership == coreir.OwnMove &&
               retDefCandidate.valueDefOriginKind ==
                   coreir.BodyDefinitionOriginTypedExprTag:
                if retDefCandidate.valueDefConsumeOpIndexPlusOne == 0:
                    retTerm.sourceDefinitionDomain =
                        coreir.BodyDefinitionDomainBodyOpTag
                    retTerm.sourceDefinitionRow = retDefScanIndex
                break
            retDefScanIndex = retDefScanIndex - 1
    if hasConst:
        add(retTerm.operands, PrimaryStatementReturnModeI32Const())
        add(retTerm.operands, constValue)
    else:
        add(retTerm.operands, resultTypeKind)
    let retTermIndex = coreir.BodyIRAppendTerm(bodyIR, retTerm)
    let blockOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, blockOpCount, retTermIndex)
    currentBlockStart = bodyIR.ops.len

@borrows
fn PrimaryBodyIrResolveReturnCallOrdinal(irFunction: lower.PrimaryObjectIrFunction,
                                           callHead: str,
                                           callArgCount: int32): int32 =
    let callTail = PrimaryCallTargetTailName(callHead)
    var foundIndex: int32
    foundIndex = -1
    for i in 0..<irFunction.callTargets.len:
        if i >= irFunction.callArgCounts.len ||
           i >= irFunction.callTargetSourcePaths.len ||
           i >= irFunction.callTargetSignatureLineNumbers.len ||
           i >= irFunction.callTargetImportcFlags.len ||
           i >= irFunction.callImportcSymbols.len:
            return -1
        if irFunction.callArgCounts[i] != callArgCount:
            continue
        let targetTail = PrimaryCallTargetTailName(irFunction.callTargets[i])
        let importcTail = PrimaryCallTargetTailName(irFunction.callImportcSymbols[i])
        if irFunction.callTargets[i] != callHead &&
           targetTail != callHead &&
           targetTail != callTail &&
           irFunction.callImportcSymbols[i] != callHead &&
           importcTail != callHead &&
           importcTail != callTail:
            continue
        if foundIndex >= 0:
            # 同一调用在一个函数里出现多次（同名+同实参数，且解析目标、源路径、
            # importc 标志/符号全等）不是重载二义：返回的 ordinal 只用来读元数据
            # (callTarget/callTargetSourcePath/callTargetImportc/importcSymbol)，
            # 重复项元数据完全相同，取首个即正确；实际重定位用的是按发射位推进的
            # callOrdinal 计数器（与本 ordinal 无关）。仅当元数据真不同（真重载）
            # 才保留 -1 二义守卫，让节点路径让位。
            if irFunction.callTargets[i] == irFunction.callTargets[foundIndex] &&
               irFunction.callTargetSourcePaths[i] == irFunction.callTargetSourcePaths[foundIndex] &&
               irFunction.callTargetSignatureLineNumbers[i] ==
                   irFunction.callTargetSignatureLineNumbers[foundIndex] &&
               irFunction.callTargetImportcFlags[i] == irFunction.callTargetImportcFlags[foundIndex] &&
               irFunction.callImportcSymbols[i] == irFunction.callImportcSymbols[foundIndex]:
                continue
            return -1
        foundIndex = i
    return foundIndex

# 根修(移植自 T54v2, cheng-f24 diag_T54 复核 confirmed): 本函数(编译后 ~32KB/
# 8000+ 指令的巨函数)内 13 处内联的「5 行连续 add()」块(callArgCounts→
# callTargets→callTargetSourcePaths→callTargetImportcFlags→callImportcSymbols)
# 在 GEN2(纯自举后端)编译该巨函数时被实测证实静默丢第 2/3 位(callTargets/
# callTargetSourcePaths,均为 str[]、相邻);同一 5 行模式在体积小 10 倍以上的
# lowering_plan.cheng 的 LoweringAppendPrimaryObjectIrCallTargetFields 里由
# GEN2 编译时完全正确(运行时 trace 验证)。抽成独立小函数(与该先例同构)后
# 巨函数体积缩小,DRV/GEN2 双路 5 路计数在 oracle 6/6+terminal 2/2 上实测一致。
# 通用机制修复,不改变任何业务逻辑/分支条件/字面量,13 处调用点覆盖该函数
# 全部内联 add 块。
@borrows
fn PrimaryBodyIrAppendResolvedCallTargetFields(irFunction: lower.PrimaryObjectIrFunction,
                                                 callArgCount: int32,
                                                 callTarget: str,
                                                 callTargetSourcePath: str,
                                                 callTargetSignatureLineNumber: int32,
                                                 callTargetTypedFunctionIndex: int32,
                                                 callTargetImportc: bool,
                                                 callImportcSymbol: str) =
    add(irFunction.callArgCounts, callArgCount)
    add(irFunction.callTargets, share(callTarget))
    add(irFunction.callTargetSourcePaths, share(callTargetSourcePath))
    add(irFunction.callTargetSignatureLineNumbers,
        callTargetSignatureLineNumber)
    add(irFunction.callTargetTypedFunctionIndexes,
        callTargetTypedFunctionIndex)
    add(irFunction.callTargetImportcFlags, callTargetImportc)
    add(irFunction.callImportcSymbols, share(callImportcSymbol))
    add(irFunction.callArgTypesTexts, "")

@borrows
fn PrimaryBodyIrResolvedOrRegisteredWholeCallOrdinal(irFunction: lower.PrimaryObjectIrFunction,
                                                      typedIr: texpr.TypedExprIr,
                                                      sourcePath: str,
                                                      callHead: str,
                                                      callArgCount: int32,
                                                      resultType: var str): int32 =
    resultType = ""
    if sourcePath == "" || callHead == "" || callArgCount < 0:
        return -1
    # Force NewString* → driver bridges before any local/any-source body lookup.
    let callTailEarly = PrimaryCallTargetTailName(callHead)
    if (callHead == "NewStringCopy" || callTailEarly == "NewStringCopy" ||
        callHead == "newStringCopy" || callTailEarly == "newStringCopy") && callArgCount == 2:
        PrimaryBodyIrAppendResolvedCallTargetFields(irFunction, callArgCount, "driver_c_str_from_utf8_copy_bridge", sourcePath, 0, -1, true, "driver_c_str_from_utf8_copy_bridge")
        resultType = "str"
        return irFunction.callTargets.len - 1
    if (callHead == "NewStringAlloc" || callTailEarly == "NewStringAlloc" ||
        callHead == "newStringAlloc" || callTailEarly == "newStringAlloc") && callArgCount == 1:
        PrimaryBodyIrAppendResolvedCallTargetFields(irFunction, callArgCount, "driver_c_str_alloc_bridge", sourcePath, 0, -1, true, "driver_c_str_alloc_bridge")
        resultType = "str"
        return irFunction.callTargets.len - 1
    var resolvedOrdinal = PrimaryBodyIrResolveReturnCallOrdinal(irFunction,
                                                                callHead,
                                                                callArgCount)
    if resolvedOrdinal >= 0:
        if resolvedOrdinal >= irFunction.callTargetSourcePaths.len ||
           resolvedOrdinal >= irFunction.callTargetSignatureLineNumbers.len ||
           irFunction.callTargetSourcePaths[resolvedOrdinal] == "":
            return -1
        let lookupSourcePath = irFunction.callTargetSourcePaths[resolvedOrdinal]
        if resolvedOrdinal < irFunction.callTargetImportcFlags.len &&
           irFunction.callTargetImportcFlags[resolvedOrdinal]:
            var importcLookupName = callHead
            if resolvedOrdinal < irFunction.callTargets.len &&
               irFunction.callTargets[resolvedOrdinal] != "":
                importcLookupName = irFunction.callTargets[resolvedOrdinal]
            resultType = texpr.TypedExprIrLookupImportcReturnType(typedIr,
                                                                   lookupSourcePath,
                                                                   importcLookupName)
            if resultType == "" &&
               resolvedOrdinal < irFunction.callImportcSymbols.len:
                resultType = texpr.TypedExprIrLookupImportcReturnType(typedIr,
                                                                       lookupSourcePath,
                                                                       irFunction.callImportcSymbols[resolvedOrdinal])
        else:
            var targetLookupName = callHead
            if resolvedOrdinal < irFunction.callTargets.len &&
               irFunction.callTargets[resolvedOrdinal] != "":
                targetLookupName = irFunction.callTargets[resolvedOrdinal]
            let targetFnIndex = PrimaryBodyIrTargetFunctionIndexAtLine(
                typedIr,
                lookupSourcePath,
                targetLookupName,
                irFunction.callTargetSignatureLineNumbers[resolvedOrdinal])
            if targetFnIndex >= 0 && targetFnIndex < typedIr.functions2_functionNameIds.len:
                let targetFnRetRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.functions2_returnTypeIds[targetFnIndex])
                if !IsOk(targetFnRetRes):
                    return -1
                resultType = Value(targetFnRetRes)
                if resultType == "":
                    resultType = "void"
            else:
                # A registered executable call row must already carry the exact
                # declaration owner selected by TypedExpr. Do not repair a bad row
                # by searching unrelated modules.
                return -1
        return resolvedOrdinal
    # Bridge rewrites must win over any-source/local NewString* body lookup.
    # Otherwise pure plan keeps NewStringAlloc as a local target and later dies
    # missing_call_target when that body is not pure-lowerable.
    let callTail = PrimaryCallTargetTailName(callHead)
    if (callHead == "NewStringCopy" || callTail == "NewStringCopy" ||
        callHead == "newStringCopy" || callTail == "newStringCopy") && callArgCount == 2:
        PrimaryBodyIrAppendResolvedCallTargetFields(irFunction, callArgCount, "driver_c_str_from_utf8_copy_bridge", sourcePath, 0, -1, true, "driver_c_str_from_utf8_copy_bridge")
        resultType = "str"
        return irFunction.callTargets.len - 1
    if (callHead == "NewStringAlloc" || callTail == "NewStringAlloc" ||
        callHead == "newStringAlloc" || callTail == "newStringAlloc") && callArgCount == 1:
        PrimaryBodyIrAppendResolvedCallTargetFields(irFunction, callArgCount, "driver_c_str_alloc_bridge", sourcePath, 0, -1, true, "driver_c_str_alloc_bridge")
        resultType = "str"
        return irFunction.callTargets.len - 1
    let targetFnIndex2 = PrimaryBodyIrVisibleFunctionIndex(typedIr,
                                                           sourcePath,
                                                           callHead)
    if targetFnIndex2 >= 0 && targetFnIndex2 < typedIr.functions2_functionNameIds.len:
        let fn2NameRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.functions2_functionNameIds[targetFnIndex2])
        let fn2SrcRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.functions2_sourcePathIds[targetFnIndex2])
        let fn2RetRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.functions2_returnTypeIds[targetFnIndex2])
        if !IsOk(fn2NameRes) || !IsOk(fn2SrcRes) || !IsOk(fn2RetRes):
            return -1
        PrimaryBodyIrAppendResolvedCallTargetFields(
            irFunction,
            callArgCount,
            Value(fn2NameRes),
            Value(fn2SrcRes),
            arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.functions2_signatureLineNumbers,
                targetFnIndex2),
            targetFnIndex2,
            false,
            "")
        resultType = Value(fn2RetRes)
        if resultType == "":
            resultType = "void"
        return irFunction.callTargets.len - 1
    let qualifiedCallQualifier = texpr.TypedExprQualifiedCallQualifier(callHead)
    if qualifiedCallQualifier != "":
        let qualifiedCallLeaf = texpr.TypedExprQualifiedCallLeaf(callHead)
        let importedSourcePath = PrimaryBodyIrCanonicalImportTargetSourcePath(typedIr,
                                                                               sourcePath,
                                                                               qualifiedCallQualifier)
        if importedSourcePath != "" && qualifiedCallLeaf != "":
            let importedTargetIndex = PrimaryBodyIrTargetFunctionIndex(typedIr,
                                                                       importedSourcePath,
                                                                       qualifiedCallLeaf)
            if importedTargetIndex >= 0 && importedTargetIndex < typedIr.functions2_functionNameIds.len:
                let impNameRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.functions2_functionNameIds[importedTargetIndex])
                let impSrcRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.functions2_sourcePathIds[importedTargetIndex])
                let impRetRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.functions2_returnTypeIds[importedTargetIndex])
                if !IsOk(impNameRes) || !IsOk(impSrcRes) || !IsOk(impRetRes):
                    return -1
                PrimaryBodyIrAppendResolvedCallTargetFields(
                    irFunction,
                    callArgCount,
                    Value(impNameRes),
                    Value(impSrcRes),
                    arenamod.ArenaArrayInt32Get(
                        typedIr.arena,
                        typedIr.functions2_signatureLineNumbers,
                        importedTargetIndex),
                    importedTargetIndex,
                    false,
                    "")
                resultType = Value(impRetRes)
                if resultType == "":
                    resultType = "void"
                return irFunction.callTargets.len - 1
    if callHead == "NewStringCopy" && callArgCount == 2:
        PrimaryBodyIrAppendResolvedCallTargetFields(irFunction, callArgCount, "driver_c_str_from_utf8_copy_bridge", sourcePath, 0, -1, true, "driver_c_str_from_utf8_copy_bridge")
        resultType = "str"
        return irFunction.callTargets.len - 1
    if (callHead == "NewStringAlloc" || callHead == "newStringAlloc") && callArgCount == 1:
        PrimaryBodyIrAppendResolvedCallTargetFields(irFunction, callArgCount, "driver_c_str_alloc_bridge", sourcePath, 0, -1, true, "driver_c_str_alloc_bridge")
        resultType = "str"
        return irFunction.callTargets.len - 1
    if callHead == "os.GetEnv" && callArgCount == 1:
        PrimaryBodyIrAppendResolvedCallTargetFields(irFunction, callArgCount, "driver_c_get_env_bridge", sourcePath, 0, -1, true, "driver_c_get_env_bridge")
        resultType = "str"
        return irFunction.callTargets.len - 1
    if callHead == "GetEnv" && callArgCount == 1:
        PrimaryBodyIrAppendResolvedCallTargetFields(irFunction, callArgCount, "driver_c_get_env_bridge", sourcePath, 0, -1, true, "driver_c_get_env_bridge")
        resultType = "str"
        return irFunction.callTargets.len - 1
    let importcResultType = texpr.TypedExprIrLookupImportcReturnType(typedIr,
                                                                      sourcePath,
                                                                      callHead)
    if importcResultType == "":
        return -1
    var importcSymbol = texpr.TypedExprIrLookupImportcTargetSymbol(typedIr,
                                                                    sourcePath,
                                                                    callHead)
    if importcSymbol == "":
        importcSymbol = callHead
    PrimaryBodyIrAppendResolvedCallTargetFields(irFunction, callArgCount, callHead, sourcePath, 0, -1, true, importcSymbol)
    resultType = importcResultType
    return irFunction.callTargets.len - 1

# bail=64/detail1=644 修复(additive + poison-on-miss + 类型严等):
# 上游 typed_expr 把 `echo(Fmt"...")` / `Echo(Fmt"...")` / `puts(Fmt"...")`
# 整调用归入 TypedExprIrStmtUnsupported(rhsNodeIndex=-1, callTarget="");
# PrimaryBodyIrAppendWholeCallStatement 的 resolve 对 echo→puts 无映射
# (qualifier=="" → probe 644)。本 helper 对 Fmt 体不含 {expr} 插值的纯文本
# 子集做 self-contained 下降:fmtPayload 直接做 cstring 字面量,单 puts
# 调用一次性发射,不经 EvalNode(rhsNodeIndex 缺失)。含 {expr} 插值或形态
# 偏离一律 return false 让原 InvalidOp 发 bail(绝不静默落穿弱路径)。
@borrows
fn PrimaryBodyIrAppendUnsupportedEchoFmtCall(bodyIR: var coreir.BodyIR,
                                             slotNames: var str[],
                                             callExprRaw: str,
                                             lineNumber: int32,
                                             callOrdinal: var int32): bool =
    let callExpr = strutil.Strip(callExprRaw)
    let openPos = texpr.TypedExprFindWholeCallOpenParen(callExpr)
    if openPos <= 0:
        return false
    let closePos = texpr.TypedExprFindMatchingParen(callExpr, openPos)
    if closePos <= openPos || closePos + 1 != len(callExpr):
        return false
    let callHead = strutil.Strip(strings.SliceBytes(callExpr, 0, openPos))
    if callHead != "echo" && callHead != "Echo" && callHead != "puts":
        return false
    let callArgsText = strutil.Strip(strings.SliceBytes(callExpr,
                                                       openPos + 1,
                                                       closePos - openPos - 1))
    let argNames = PrimaryBodyIrCallArgNames(callArgsText)
    if argNames.len != 1:
        return false
    let fmtArgText = strutil.Strip(argNames[0])
    var echoPayload = PrimaryBodyIrFmtLiteralPayload(fmtArgText)
    if echoPayload == "":
        # 普通字符串字面量臂: exe_entry typed_ir 子集无 std/system::echo 记录时,
        # "..." 字面量自包含落地(与 Fmt 纯文本共用 puts 路径); plain string 不插值,
        # `{` 按字面落地, 不做 { 判定。非字面量实参仍 return false → poison。
        if !PrimaryBodyIrTextIsStringLiteral(fmtArgText):
            return false
        echoPayload = PrimaryBodyIrStringLiteralPayload(fmtArgText)
    elif strutil.Contains(echoPayload, "{"):
        # 仅纯文本 Fmt(无 {expr} 插值)落地;含插值需 EvalNode 而本路径
        # rhsNodeIndex 缺失,让其落回 InvalidOp bail(poison-on-miss)。
        return false
    let echoLiteralId = coreir.BodyIRAppendCStringLiteral(bodyIR, echoPayload, "")
    let echoVoidSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#echo_fmt_void#{lineNumber}#{bodyIR.ops.len}",
                                                    coreir.LocalI32Tag)
    if echoVoidSlot < 0:
        return false
    var echoCall: coreir.CallOp
    echoCall.targetSymbol = "puts"
    echoCall.resultSlot = echoVoidSlot
    echoCall.resultPassKind = coreir.BodyCallPassStackValueTag
    add(echoCall.argSlots, coreir.CallArgSlotCString(echoLiteralId))
    add(echoCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(bodyIR.callSequence, echoCall)
    var echoOp: coreir.BodyOp
    echoOp.kind = coreir.BodyOpCallTag
    echoOp.target = echoVoidSlot
    add(echoOp.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, echoOp)
    callOrdinal = callOrdinal + 1
    return true

@borrows
fn PrimaryBodyIrAppendWholeCallStatement(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          lowering: var lower.LoweringPlanStub,
                                          typedFn: texpr.TypedExprIrFunction,
                                          irFunction: lower.PrimaryObjectIrFunction,
                                          varI32ParamNames: str[],
                                          callExprRaw: str,
                                          lineNumber: int32,
                                          callOrdinal: var int32): bool =
    let callExpr = strutil.Strip(callExprRaw)
    if PrimaryObjectPlanTraceActive():
        PrimaryObjectPlanTrace(Fmt"whole_call_statement_probe function={typedFn.functionName} line={lineNumber} expr={callExpr}")
    let openPos = texpr.TypedExprFindWholeCallOpenParen(callExpr)
    if openPos <= 0:
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"whole_call_statement_skip function={typedFn.functionName} line={lineNumber} reason=open")
        return false
    let closePos = texpr.TypedExprFindMatchingParen(callExpr, openPos)
    if closePos <= openPos || closePos + 1 != len(callExpr):
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"whole_call_statement_skip function={typedFn.functionName} line={lineNumber} reason=close close={closePos} len={callExpr.len}")
        return false
    let callHead = strutil.Strip(strings.SliceBytes(callExpr, 0, openPos))
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"whole_call_statement_skip function={typedFn.functionName} line={lineNumber} reason=head head={callHead}")
        return false
    let callArgsText = strutil.Strip(strings.SliceBytes(callExpr,
                                                       openPos + 1,
                                                       closePos - openPos - 1))
    let callArgCount = PrimaryBodyIrCallArgNames(callArgsText).len
    var callResultType = ""
    let resolvedOrdinal = PrimaryBodyIrResolvedOrRegisteredWholeCallOrdinal(irFunction,
                                                                            lowering.typedIr,
                                                                            typedFn.sourcePath,
                                                                            callHead,
                                                                            callArgCount,
                                                                            callResultType)
    if resolvedOrdinal < 0 ||
       resolvedOrdinal >= irFunction.callTargets.len ||
       resolvedOrdinal >= irFunction.callTargetSourcePaths.len ||
       resolvedOrdinal >= irFunction.callTargetSignatureLineNumbers.len ||
       resolvedOrdinal >= irFunction.callTargetImportcFlags.len:
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"whole_call_statement_skip function={typedFn.functionName} line={lineNumber} reason=resolve head={callHead} argc={callArgCount} ordinal={resolvedOrdinal} targets={irFunction.callTargets.len}")
        return false
    if callResultType == "" || callResultType == "unknown":
        callResultType = "void"
    var stmt: lower.PrimaryObjectIrStatement
    stmt.sourcePath = typedFn.sourcePath
    stmt.functionName = typedFn.functionName
    stmt.lineNumber = lineNumber
    stmt.lineIndent = 0
    stmt.kind = texpr.TypedExprIrStmtCall
    stmt.callKind = texpr.TypedExprCallNone
    stmt.rhsNodeIndex = -1
    stmt.surfaceText = strings.CloneStr(callHead)
    stmt.resultType = strings.CloneStr(callResultType)
    stmt.callCallee = texpr.TypedExprQualifiedCallLeaf(callHead)
    stmt.callTarget = irFunction.callTargets[resolvedOrdinal]
    stmt.callTargetSourcePath = irFunction.callTargetSourcePaths[resolvedOrdinal]
    stmt.callTargetSignatureLineNumber =
        irFunction.callTargetSignatureLineNumbers[resolvedOrdinal]
    stmt.callTargetImportc = irFunction.callTargetImportcFlags[resolvedOrdinal]
    stmt.callArgCount = callArgCount
    stmt.callArgsText = callArgsText
    var wholeCallBlockStart: int32 = -1
    let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                      slotNames,
                                      lowering,

                                      typedFn,
                                      irFunction,
                                      stmt,
                                      -1,
                                      varI32ParamNames,
                                      callOrdinal,
                                      wholeCallBlockStart)
    if PrimaryObjectPlanTraceActive():
        PrimaryObjectPlanTrace(Fmt"whole_call_statement_emit function={typedFn.functionName} line={lineNumber} head={callHead} target={stmt.callTarget} target_source={stmt.callTargetSourcePath} argc={callArgCount}")
    return true

@borrows
fn PrimaryBodyIrWholeCallStatementProbeCode(lowering: var lower.LoweringPlanStub,
                                             typedFn: texpr.TypedExprIrFunction,
                                             irFunction: lower.PrimaryObjectIrFunction,
                                             callExprRaw: str): int32 =
    let callExpr = strutil.Strip(callExprRaw)
    let openPos = texpr.TypedExprFindWholeCallOpenParen(callExpr)
    if openPos <= 0:
        return 641
    let closePos = texpr.TypedExprFindMatchingParen(callExpr, openPos)
    if closePos <= openPos || closePos + 1 != len(callExpr):
        return 642
    let callHead = strutil.Strip(strings.SliceBytes(callExpr, 0, openPos))
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        return 643
    let callArgsText = strutil.Strip(strings.SliceBytes(callExpr,
                                                       openPos + 1,
                                                       closePos - openPos - 1))
    let callArgCount = PrimaryBodyIrCallArgNames(callArgsText).len
    let resolvedOrdinal = PrimaryBodyIrResolveReturnCallOrdinal(irFunction,
                                                                callHead,
                                                                callArgCount)
    if resolvedOrdinal >= 0:
        return 650
    let targetIndex = PrimaryBodyIrVisibleFunctionIndex(lowering.typedIr,
                                                       typedFn.sourcePath,
                                                       callHead)
    if targetIndex >= 0:
        return 651
    let qualifier = texpr.TypedExprQualifiedCallQualifier(callHead)
    let leaf = texpr.TypedExprQualifiedCallLeaf(callHead)
    if qualifier == "" || leaf == "":
        return 644
    let importedSourcePath = PrimaryBodyIrCanonicalImportTargetSourcePath(lowering.typedIr,
                                                                           typedFn.sourcePath,
                                                                           qualifier)
    if importedSourcePath != "":
        let importedTargetIndex = PrimaryBodyIrTargetFunctionIndex(lowering.typedIr,
                                                                   importedSourcePath,
                                                                   leaf)
        if importedTargetIndex >= 0:
            return 652
    return 645

@borrows
fn PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           lowering: var lower.LoweringPlanStub,
                                           typedFn: texpr.TypedExprIrFunction,
                                           irFunction: lower.PrimaryObjectIrFunction,
                                           varI32ParamNames: str[],
                                           callExprRaw: str,
                                           targetSlot: int32,
                                           lineNumber: int32,
                                           callExprNodeIndex: int32,
                                           callOrdinal: var int32): bool =
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"whole_call_enter function={typedFn.functionName} line={lineNumber} expr={callExprRaw}")
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        return false
    let callExpr = strutil.Strip(share(callExprRaw))
    let openPos = texpr.TypedExprFindWholeCallOpenParen(share(callExpr))
    if openPos <= 0:
        return false
    let closePos = texpr.TypedExprFindMatchingParen(share(callExpr), openPos)
    var primaryColdCond7: bool
    if closePos <= openPos:
        primaryColdCond7 = true
    if closePos + 1 != len(callExpr):
        primaryColdCond7 = true
    if primaryColdCond7:
        return false
    let callHead = strutil.Strip(strings.SliceBytes(share(callExpr), 0, openPos))
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(share(callHead)):
        return false
    # bail=44 R1: 调用方经 ArgLink 下钻传入的本调用 CallExpr 节点(守卫校验
    # 同 head);合成 sub-stmt 时挂到 rhsNodeIndex,AppendCallArgs 的 node 臂
    # 才能物化聚合/str 等非标量嵌套实参。miss 仍 -1 → 既有 poison。
    let wholeCallOwnNodeIndex = PrimaryBodyIrWholeCallStmtNodeIndex(lowering.typedIr,
                                                                    callExprNodeIndex,
                                                                    share(callHead))
    var callArgsText = strutil.Strip(strings.SliceBytes(share(callExpr),
                                                       openPos + 1,
                                                       closePos - openPos - 1))
    let callIsStdSystemLoad = wholeCallOwnNodeIndex >= 0 &&
                              PrimaryBodyIrCallExprIsStdSystemLoad(lowering,

                                                                   wholeCallOwnNodeIndex)
    if PrimaryBodyIrSlotType(bodyIR, targetSlot) == coreir.LocalI32Tag:
        let lenInner = PrimaryBodyIrLenCallInner(share(callExpr))
        if lenInner != "" &&
           PrimaryBodyIrAppendStrLenArgValue(bodyIR,
                                             slotNames,
                                             share(varI32ParamNames),
                                             lowering.typedIr,
                                             typedFn,
                                             irFunction,
                                             typedFn.sourcePath,
                                             lineNumber,
                                             lenInner,
                                             targetSlot):
            return true
    # 聚合构造器临时作按值实参（`f(Type(field: v, ...))`，无具名局部）：在此唯一
    # 整调用下降汇聚点物化进等宽聚合临时槽，按名替换实参，使其经按值聚合实参 ABI
    # 传地址（与具名局部 `let r = Type(...)` 同路）。覆盖所有整调用形态（if 条件
    # 操作数 / return / 嵌套实参）。非构造器实参不动。
    let wholeCallArgs = PrimaryBodyIrCallArgNames(share(callArgsText))
    if wholeCallArgs.len > 0:
        var ctorMatArgs: str[]
        var ctorMatChanged = false
        for ctorArgIndex in 0..<wholeCallArgs.len:
            var ctorArgText = wholeCallArgs[ctorArgIndex]
            let ctorArgOpen = texpr.TypedExprFindWholeCallOpenParen(ctorArgText)
            if ctorArgOpen > 0:
                let ctorArgClose = texpr.TypedExprFindMatchingParen(ctorArgText, ctorArgOpen)
                if ctorArgClose > ctorArgOpen && ctorArgClose + 1 == len(ctorArgText):
                    let ctorArgHead = strutil.Strip(strings.SliceBytes(ctorArgText, 0, ctorArgOpen))
                    if PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr,
                                                                   share(typedFn.sourcePath),
                                                                   ctorArgHead):
                        let ctorArgSlotName = strutil.Join(["#wholecall_ctor_arg#",
                                                            strings.IntToStr(lineNumber),
                                                            "_",
                                                            strings.IntToStr(ctorArgIndex),
                                                            "_",
                                                            strings.IntToStr(callOrdinal),
                                                            "_",
                                                            strings.IntToStr(bodyIR.callSequence.len)], "")
                        let ctorArgSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                             slotNames,
                                                                             lowering.typedIr,
                                                                             typedFn.sourcePath,
                                                                             ctorArgSlotName,
                                                                             ctorArgHead)
                        if ctorArgSlot >= 0 &&
                           PrimaryBodyIrAppendAggregateConstructorToSlot(bodyIR,
                                                                         slotNames,
                                                                         share(varI32ParamNames),
                                                                         lowering,

                                                                         typedFn,
                                                                         irFunction,
                                                                         ctorArgText,
                                                                         PrimaryBodyIrCallArgNodeIndexAt(
                                                                             lowering.typedIr,
                                                                             wholeCallOwnNodeIndex,
                                                                             ctorArgIndex),
                                                                         ctorArgHead,
                                                                         share(typedFn.sourcePath),
                                                                         lineNumber,
                                                                         ctorArgSlot,
                                                                         lineNumber * 131 + ctorArgIndex + 1,
                                                                         callOrdinal):
                            ctorArgText = ctorArgSlotName
                            ctorMatChanged = true
            add(ctorMatArgs, ctorArgText)
        if ctorMatChanged:
            callArgsText = strutil.Join(ctorMatArgs, ",")
    let nestedWholeCallArgs = PrimaryBodyIrCallArgNames(share(callArgsText))
    if nestedWholeCallArgs.len > 0:
        var nestedMatArgs: str[]
        var nestedMatChanged = false
        for nestedArgIndex in 0..<nestedWholeCallArgs.len:
            var nestedArgText = nestedWholeCallArgs[nestedArgIndex]
            let nestedOpenPos = texpr.TypedExprFindWholeCallOpenParen(nestedArgText)
            if nestedOpenPos > 0:
                let nestedClosePos = texpr.TypedExprFindMatchingParen(nestedArgText, nestedOpenPos)
                if nestedClosePos > nestedOpenPos && nestedClosePos + 1 == len(nestedArgText):
                    let nestedCallHead = strutil.Strip(strings.SliceBytes(nestedArgText, 0, nestedOpenPos))
                    if texpr.TypedExprCallHeadIsPlainQualifiedIdent(nestedCallHead):
                        let nestedArgOwnNodeIndex = PrimaryBodyIrCallArgNodeIndexAt(lowering.typedIr,
                                                                                     wholeCallOwnNodeIndex,
                                                                                     nestedArgIndex)
                        var nestedResultType = ""
                        # bail=44 Value 内征族: `Value(x)` 作嵌套 call-arg
                        # (如 `layout.FixedBytes65Hex(Value(pubRes))`) 时, 下方
                        # VisibleFunctionIndex 通用臂按普通函数查到 Value[T] 的
                        # 声明返回类型文本, 拿到的是字面未具体化的 "T"（Value[T]
                        # 是从不按实例化单独 lower 的泛型模板, 见
                        # PrimaryObjectPlanFunctionIsGenericTemplate 注释), 把临时槽
                        # 错定形成 "T"（零尺寸/非法 kind), 目标槽 kind/size 不配,
                        # 下方新增的 callHead=="Value" 投影分支必 miss。此处先按同一
                        # ResultValueInnerTypeText 助手（节点路径/StmtResultIntrinsic
                        # 共用同款）解出 arg 绑定的真实内型, 让临时槽按真实 T 定形;
                        # 找不到时静默落回原通用查找(其余调用头零漂移)。
                        if nestedCallHead == "Value" || nestedCallHead == "result.Value":
                            if nestedArgOwnNodeIndex >= 0:
                                let nestedValueArgNodeIndex = PrimaryBodyIrResultValueArgNodeIndex(lowering.typedIr, nestedArgOwnNodeIndex)
                                if nestedValueArgNodeIndex >= 0:
                                    nestedResultType = PrimaryBodyIrResultValueInnerTypeText(lowering.typedIr,
                                                                                              nestedArgOwnNodeIndex,
                                                                                              nestedValueArgNodeIndex)
                        if nestedResultType == "":
                            let nestedIsStdSystemLoad = nestedArgOwnNodeIndex >= 0 &&
                                                        PrimaryBodyIrCallExprIsStdSystemLoad(
                                                            lowering,

                                                            nestedArgOwnNodeIndex)
                            if nestedIsStdSystemLoad:
                                var nestedLoadTargetKind: int32
                                var nestedLoadKind: int32
                                var nestedLoadSize: int32
                                if !PrimaryBodyIrStdSystemLoadNodeTypeContract(
                                       lowering.typedIr,
                                       nestedArgOwnNodeIndex,
                                       nestedLoadTargetKind,
                                       nestedLoadKind,
                                       nestedLoadSize):
                                    return false
                                nestedResultType = PrimaryBodyIrNodeResultTypeText(
                                    lowering.typedIr,
                                    nestedArgOwnNodeIndex)
                                let _ = nestedLoadTargetKind
                                let _ = nestedLoadKind
                                let _ = nestedLoadSize
                        if nestedResultType == "":
                            let nestedFnPtrType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                               typedFn,
                                                                               irFunction,
                                                                               lineNumber,
                                                                               nestedCallHead)
                            if texpr.TypedExprTypeTextIsFnPtr(nestedFnPtrType):
                                nestedResultType = PrimaryBodyIrFnPtrReturnType(nestedFnPtrType)
                        if nestedResultType == "":
                            let nestedTargetFnIndex = PrimaryBodyIrVisibleFunctionIndex(lowering.typedIr,
                                                                                         share(typedFn.sourcePath),
                                                                                         share(nestedCallHead))
                            if nestedTargetFnIndex >= 0 && nestedTargetFnIndex < lowering.typedIr.functions2_functionNameIds.len:
                                let nrwRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool,
                                                                                   lowering.typedIr.functions2_returnTypeIds[nestedTargetFnIndex])
                                if IsOk(nrwRes):
                                    nestedResultType = Value(nrwRes)
                        if nestedResultType == "":
                            nestedResultType = texpr.TypedExprIrLookupImportcReturnType(lowering.typedIr,
                                                                                         typedFn.sourcePath,
                                                                                         nestedCallHead)
                        if nestedResultType != "" && nestedResultType != "unknown" && nestedResultType != "void":
                            let nestedSlotName = strutil.Join(["#wholecall_arg#",
                                                               strings.IntToStr(lineNumber),
                                                               "_",
                                                               PrimaryBodyIrInternalSlotTextCode(nestedCallHead),
                                                               "_",
                                                               strings.IntToStr(nestedArgOwnNodeIndex + 1),
                                                               "_",
                                                               strings.IntToStr(nestedArgIndex),
                                                               "_",
                                                               strings.IntToStr(callOrdinal),
                                                               "_",
                                                               strings.IntToStr(bodyIR.callSequence.len)], "")
                            let nestedSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                                 slotNames,
                                                                                 lowering.typedIr,
                                                                                 typedFn.sourcePath,
                                                                                 nestedSlotName,
                                                                                 nestedResultType)
                            if nestedSlot >= 0 &&
                               PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                                       slotNames,
                                                                       lowering,

                                                                       typedFn,
                                                                       irFunction,
                                                                       varI32ParamNames,
                                                                       nestedArgText,
                                                                       nestedSlot,
                                                                       lineNumber,
                                                                       nestedArgOwnNodeIndex,
                                                                       callOrdinal):
                                nestedArgText = nestedSlotName
                                nestedMatChanged = true
            add(nestedMatArgs, share(nestedArgText))
        if nestedMatChanged:
            callArgsText = strutil.Join(nestedMatArgs, ",")
    let callHeadTail = PrimaryCallTargetTailName(share(callHead))
    let callArgCount = PrimaryBodyIrCallArgNames(share(callArgsText)).len
    if callIsStdSystemLoad:
        return PrimaryBodyIrAppendStdSystemLoadNodeValue(bodyIR,
                                                          slotNames,
                                                          share(varI32ParamNames),
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          wholeCallOwnNodeIndex,
                                                          targetSlot,
                                                          callOrdinal)
    if callHeadTail == "StrDataPtr" || callHeadTail == "strDataPtr":
        return PrimaryBodyIrAppendStrDataPtrValue(bodyIR,
                                                  slotNames,
                                                  share(callArgsText),
                                                  targetSlot)
    if callHeadTail == "RawmemAsVoid":
        return PrimaryBodyIrAppendRawmemAsVoidValue(bodyIR,
                                                    slotNames,
                                                    share(callArgsText),
                                                    targetSlot)
    var wholeProjectionKind = coreir.BodyResultProjectInvalidTag
    if PrimaryBodyIrResultProjectionArgNodeIndex(lowering.typedIr,
                                                  wholeCallOwnNodeIndex,
                                                  wholeProjectionKind) >= 0:
        return PrimaryBodyIrAppendResultProjectionNodeToSlot(bodyIR,
                                                              slotNames,
                                                              share(varI32ParamNames),
                                                              lowering,

                                                              typedFn,
                                                              irFunction,
                                                              wholeCallOwnNodeIndex,
                                                              targetSlot,
                                                              callOrdinal)
    # IsErr(result) in expression position (e.g. if-conditions) is the
    # Result projection intrinsic, not a call: the generic template has no
    # lowered body to call into.
    if callHead == "IsErr" || callHead == "result.IsErr":
        let isErrArgSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, callArgsText)
        if isErrArgSlot >= 0 &&
           isErrArgSlot < bodyIR.localSlots.len &&
           PrimaryBodyIrSlotType(bodyIR, isErrArgSlot) == coreir.LocalAggregateTag:
            var isErrProjOp: coreir.BodyOp
            isErrProjOp.kind = coreir.BodyOpResultProjectTag
            isErrProjOp.target = targetSlot
            add(isErrProjOp.operands, coreir.BodyResultProjectIsErrTag)
            add(isErrProjOp.operands, isErrArgSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, isErrProjOp)
            return true
    # IsOk(result) in expression position mirrors IsErr: pure ok-flag
    # projection (IsErr logical-not), not a generic call.
    if callHead == "IsOk" || callHead == "result.IsOk":
        let isOkArgSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, callArgsText)
        if isOkArgSlot >= 0 &&
           isOkArgSlot < bodyIR.localSlots.len &&
           PrimaryBodyIrSlotType(bodyIR, isOkArgSlot) == coreir.LocalAggregateTag:
            var isOkProjOp: coreir.BodyOp
            isOkProjOp.kind = coreir.BodyOpResultProjectTag
            isOkProjOp.target = targetSlot
            add(isOkProjOp.operands, coreir.BodyResultProjectIsOkTag)
            add(isOkProjOp.operands, isOkArgSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, isOkProjOp)
            return true
    # Value(result) in expression position (whole-call qualified-arg text
    # lowering — e.g. `layout.FixedBytes65Hex(Value(pubRes))` nested arg, or
    # `Fn(Value(x))` top-level qualcall arg) mirrors IsErr/IsOk above: it is
    # the Result projection intrinsic, not a call. Unlike IsErr/IsOk (which
    # project the T-independent `ok` flag @offset 0 and so would still lower
    # correctly even via a real call to IsOk[T]/IsErr[T]'s own generic body),
    # Value[T]'s literal declaration can NEVER lower on its own: its `err`
    # field sits after `value: T`, so its offset depends on sizeof/alignof(T),
    # which is unresolved in the un-instantiated template's own source context
    # (PrimaryObjectPlanFunctionIsGenericTemplate — Value is never emitted as
    # a standalone symbol, every concrete call site is meant to be
    # intrinsified inline). Falling through to the generic call-target
    # resolution below would mark Value[T] reachable and force a real lowering
    # attempt of its own body, which unconditionally bails (result.cheng:81,
    # bail_44) and blocks primary_object_plan readiness for the whole unit —
    # this was the corpus's last standing bail_44 row (mobile_capi Value@81).
    # Reuse the exact projection/panic-guard machinery node-eval already uses
    # for this same intrinsic (PrimaryBodyIrAppendResultValueProjection) —
    # zero new offset computation, and poison-on-miss: an unresolvable
    # projection here returns false directly rather than falling through to
    # the generic call path, so a genuinely unsupported shape still bails
    # instead of silently recreating the same unreachable-template landmine.
    if callHead == "Value" || callHead == "result.Value":
        if callExprNodeIndex >= 0:
            return PrimaryBodyIrAppendResultValueProjection(bodyIR,
                                                             slotNames,
                                                             share(varI32ParamNames),
                                                             lowering,

                                                             typedFn,
                                                             irFunction,
                                                             callExprNodeIndex,
                                                             targetSlot,
                                                             callOrdinal)
        # Some producers of this whole-call text form (e.g. an aggregate
        # constructor's named-field value materializer) have no node2
        # CallExpr index to hand in. `callArgsText` is still the plain bound
        # identifier (`Value(pubRes)` -> "pubRes"), so resolve its source slot
        # and its declared `Result[T]` binding type by name instead of by
        # node — mirrors PrimaryBodyIrAppendResultValueProjection's
        # ParamRef/LocalRef arm exactly (same shared
        # ResultValueProjectionFromSlot machinery), just without the node2
        # lookup. Any resolution miss here poisons (returns false) rather
        # than falling through to the generic call path below.
        let textArgSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, callArgsText)
        let textBindingType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                               typedFn,
                                                               irFunction,
                                                               lineNumber,
                                                               share(callArgsText))
        let textInner = texpr.TypedExprResultSuccessType(texpr.TypedExprStripVarType(textBindingType))
        if textInner == "":
            return false
        return PrimaryBodyIrAppendResultValueProjectionFromSlot(bodyIR,
                                                                 slotNames,
                                                                 lowering.typedIr,
                                                                 share(typedFn.sourcePath),
                                                                 share(typedFn.functionName),
                                                                 lineNumber,
                                                                 textArgSlot,
                                                                 textInner,
                                                                 targetSlot,
                                                                 callOrdinal)
    if PrimaryBodyIrAppendFnPtrSretAgg1CallToSlot(bodyIR,
                                                  slotNames,
                                                  lowering.typedIr,
                                                  typedFn,
                                                  irFunction,
                                                  share(callHead),
                                                  share(callArgsText),
                                                  targetSlot,
                                                  lineNumber,
                                                  callOrdinal):
        return true
    var callResultType = ""
    let resolvedOrdinal = PrimaryBodyIrResolvedOrRegisteredWholeCallOrdinal(irFunction,
                                                                            lowering.typedIr,
                                                                            share(typedFn.sourcePath),
                                                                            share(callHead),
                                                                            callArgCount,
                                                                            callResultType)
    if resolvedOrdinal < 0 ||
       resolvedOrdinal >= irFunction.callTargets.len ||
       resolvedOrdinal >= irFunction.callTargetSourcePaths.len ||
       resolvedOrdinal >= irFunction.callTargetSignatureLineNumbers.len ||
       resolvedOrdinal >= irFunction.callTargetImportcFlags.len:
        # #69 根修: callHead 是 int32/int64 等纯类型转换伪函数(从无函数体、从不在
        # callTargets 注册)时, ordinal 解析恒 -1 落到此分支——这不是"函数缺失"是
        # "根本不是函数"。姊妹函数 PrimaryBodyIrAppendCallOp(:24140-24221) 已有可用
        # 的 f64->i32/i64 cast rescue(LocalF64Tag 物化实参 + 合成 CallOp 到
        # cheng_f64_to_i32/i64, 目标符号已由 9b4c520e6 收编白名单), 但只焊在"调用
        # 出现在更大表达式内部"的形态(CallScalarValueSlotForText 派发), 未覆盖"整句
        # RHS=一个调用表达式"的 local_decl/let_call 形态(本函数)。复用同一套物化+
        # 合成 CallOp 逻辑; 不复用则 targetSlot 槽永不写, 下游读栈垃圾静默 miscompile。
        let wholeCallPureCastResultKind = PrimaryBodyIrPureCastResultTypeKind(share(callHead))
        if wholeCallPureCastResultKind != coreir.LocalInvalidTag:
            # A real CallExpr/ArgLink owns integer-cast lowering. Its value node
            # can be a local, field, index, or another scalar expression; width
            # and signedness are proven before evaluation. Once claimed, a miss
            # is terminal and must not fall through to the surface-text rescue.
            var wholeCallStructuredCastClaimed = false
            let wholeCallStructuredCastSlot = PrimaryBodyIrEvalProvenIntegerCastNode(
                bodyIR,
                slotNames,
                share(varI32ParamNames),
                lowering,

                typedFn,
                irFunction,
                wholeCallOwnNodeIndex,
                callOrdinal,
                wholeCallStructuredCastClaimed)
            if wholeCallStructuredCastClaimed:
                if wholeCallStructuredCastSlot < 0 ||
                   wholeCallStructuredCastSlot >= bodyIR.localSlots.len ||
                   PrimaryBodyIrSlotType(bodyIR, wholeCallStructuredCastSlot) !=
                       wholeCallPureCastResultKind ||
                   PrimaryBodyIrSlotType(bodyIR, targetSlot) != wholeCallPureCastResultKind:
                    return false
                if wholeCallStructuredCastSlot != targetSlot:
                    var wholeCallStructuredCastCopy: coreir.BodyOp
                    wholeCallStructuredCastCopy.kind = coreir.BodyOpCopyLocalTag
                    wholeCallStructuredCastCopy.target = targetSlot
                    add(wholeCallStructuredCastCopy.operands, wholeCallStructuredCastSlot)
                    let _ = coreir.BodyIRAppendOp(bodyIR, wholeCallStructuredCastCopy)
                return true
            let wholeCallF64ArgSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                              slotNames,
                                                                              varI32ParamNames,
                                                                              lowering,

                                                                              typedFn,
                                                                              irFunction,
                                                                              typedFn.sourcePath,
                                                                              lineNumber,
                                                                              callArgsText,
                                                                              coreir.LocalF64Tag,
                                                                              callOrdinal)
            if wholeCallF64ArgSlot >= 0 &&
               wholeCallF64ArgSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, wholeCallF64ArgSlot) == coreir.LocalF64Tag:
                var wholeCallTruncCall: coreir.CallOp
                if wholeCallPureCastResultKind == coreir.LocalI32Tag:
                    wholeCallTruncCall.targetSymbol = "cheng_f64_to_i32"
                else:
                    wholeCallTruncCall.targetSymbol = "cheng_f64_to_i64"
                wholeCallTruncCall.resultSlot = targetSlot
                wholeCallTruncCall.resultPassKind = coreir.BodyCallPassStackValueTag
                # #69 reverify fix: cheng_f64_to_i32/i64 are real C runtime symbols
                # (host_runtime.c), always cross the AAPCS64 boundary -- mirrors the
                # sibling PrimaryBodyIrAppendCallOp rescue (:24530). Missing this line
                # made arg-lowering treat the synthesized CallOp as a Cheng-internal
                # call (GP-register arg convention), leaving the f64 raw bits in X0
                # while #68's inline optimizer emits `FCVTZS Xd,Dn` (reads D0, which
                # was never written) -- a silent read of an unwritten D-register.
                wholeCallTruncCall.targetIsImportc = true
                add(wholeCallTruncCall.argSlots, wholeCallF64ArgSlot)
                add(bodyIR.callSequence, wholeCallTruncCall)
                var wholeCallTruncOp: coreir.BodyOp
                wholeCallTruncOp.kind = coreir.BodyOpCallTag
                wholeCallTruncOp.target = targetSlot
                add(wholeCallTruncOp.operands, callOrdinal)
                let _ = coreir.BodyIRAppendOp(bodyIR, wholeCallTruncOp)
                callOrdinal = callOrdinal + 1
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=whole_call_pure_cast_rescue_hit head={callHead}")
                return true
            # Integer/pointer pure cast: same widen/narrow arms as
            # PrimaryBodyIrAppendCallOp pure-cast path. int32(x)/uint64(n) etc.
            # are NOT f64 trunc — f64 rescue miss must not poison with 810
            # (blocks pure selfhost of hashmaps/ExtractIntFromText).
            var wholeCallCastArgSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                                slotNames,
                                                                                varI32ParamNames,
                                                                                lowering,

                                                                                typedFn,
                                                                                irFunction,
                                                                                typedFn.sourcePath,
                                                                                lineNumber,
                                                                                callArgsText,
                                                                                wholeCallPureCastResultKind,
                                                                                callOrdinal)
            if wholeCallCastArgSlot < 0 && wholeCallPureCastResultKind == coreir.LocalI32Tag:
                wholeCallCastArgSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                              slotNames,
                                                                              varI32ParamNames,
                                                                              lowering,

                                                                              typedFn,
                                                                              irFunction,
                                                                              typedFn.sourcePath,
                                                                              lineNumber,
                                                                              callArgsText,
                                                                              coreir.LocalI64Tag,
                                                                              callOrdinal)
            if wholeCallCastArgSlot < 0 && wholeCallPureCastResultKind == coreir.LocalI64Tag:
                wholeCallCastArgSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                              slotNames,
                                                                              varI32ParamNames,
                                                                              lowering,

                                                                              typedFn,
                                                                              irFunction,
                                                                              typedFn.sourcePath,
                                                                              lineNumber,
                                                                              callArgsText,
                                                                              coreir.LocalI32Tag,
                                                                              callOrdinal)
            if wholeCallCastArgSlot >= 0:
                if wholeCallCastArgSlot != targetSlot:
                    var wholeCallCastCopy: coreir.BodyOp
                    wholeCallCastCopy.kind = coreir.BodyOpCopyLocalTag
                    wholeCallCastCopy.target = targetSlot
                    add(wholeCallCastCopy.operands, wholeCallCastArgSlot)
                    let _ = coreir.BodyIRAppendOp(bodyIR, wholeCallCastCopy)
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=whole_call_pure_cast_int_hit head={callHead}")
                return true
        # #95 wave5 根修 (形态A/B: int->float64 方向, 上面的 #69 分支是相反方向
        # f64->int 截断): callHead 尾名恰为 "float64" 时同样从不在 callTargets
        # 注册(std/system.cheng:544 的通用模板 `fn float64(x:T):float64 = return
        # 0.0` 是类型擦除占位符, 从不参与本函数的按签名 ordinal 解析), ordinal
        # 解析同样恒 -1 落到此分支。
        #
        # wave4(REFUTED) 的豁免门只看 inlineF64FromIntKind 字段值, 被既有无关的
        # PrimaryBodyIrAppendCallOp 通用调用构造器(它对任何 target 尾名="float64"
        # 的调用也无条件置位同一字段)误伤放行, 产出未登记符号的自跳 bl。这里改为
        # 本分支自己构造的 CallOp 显式打 wholeCallF64FromIntRescue=true 专属
        # provenance 标记, 3 处豁免门(见 Reachability/BuildItems 两阶段)只认这个
        # 标记(PrimaryCallOpWholeCallF64FromIntRescue), 不再看多义的
        # inlineF64FromIntKind 原值。
        #
        # wave4 defect2: SCVTF 是有符号转换, uint32/uint64 高位为 1 时静默产出
        # 错误的负值区间结果。LocalSlot.typeKind 不携带有符号性(int32/uint32 共用
        # LocalI32Tag)——查实参的声明类型文本(PrimaryBodyIrBindingTypeForName)
        # 找回真实有符号性; 查不到/非标量整型时诚实 poison(818), 绝不默认按有
        # 符号静默算错。
        if PrimaryCallTargetTailName(share(callHead)) == "float64" &&
           targetSlot < bodyIR.localSlots.len &&
           PrimaryBodyIrSlotType(bodyIR, targetSlot) == coreir.LocalF64Tag &&
           callArgCount == 1:
            # 实参必须按其"已登记的真实类型"原样取用, 绝不speculative按 I32 试探
            # 再按 I64 试探——简单变量实参此刻必然已经是一个登记过的槽(函数形参
            # 在 seed_params_ir 阶段登记; 更早的 let/var 局部在其自身 LocalDecl
            # 语句时已登记), 直接按精确名找既有槽读它已定形的真实 typeKind, 零
            # 覆写零猜测。非登记槽的复合表达式(如 `float64(n+1)`)不在本次任务
            # 范围("简单变量参数"), 找不到时落到下方诚实 poison, 不新增覆盖面。
            let wholeCallF64FromIntArgSlot = PrimaryBodyIrFindArgSlot(bodyIR,
                                                                      slotNames,
                                                                      strutil.Strip(share(callArgsText)))
            var wholeCallF64FromIntArgSlotTypeOk: bool
            if wholeCallF64FromIntArgSlot >= 0 &&
               wholeCallF64FromIntArgSlot < bodyIR.localSlots.len &&
               (PrimaryBodyIrSlotType(bodyIR, wholeCallF64FromIntArgSlot) == coreir.LocalI32Tag ||
                PrimaryBodyIrSlotType(bodyIR, wholeCallF64FromIntArgSlot) == coreir.LocalI64Tag):
                wholeCallF64FromIntArgSlotTypeOk = true
            var wholeCallF64FromIntSignedness: int32
            if wholeCallF64FromIntArgSlotTypeOk:
                let wholeCallF64FromIntArgTypeText = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                                     typedFn,
                                                                                     irFunction,
                                                                                     lineNumber,
                                                                                     strutil.Strip(share(callArgsText)))
                wholeCallF64FromIntSignedness = PrimaryIntTypeTextSignedness(wholeCallF64FromIntArgTypeText)
            if wholeCallF64FromIntArgSlotTypeOk && wholeCallF64FromIntSignedness > 0:
                var wholeCallF64FromIntCall: coreir.CallOp
                wholeCallF64FromIntCall.targetSymbol = "float64"
                wholeCallF64FromIntCall.resultSlot = targetSlot
                wholeCallF64FromIntCall.resultPassKind = coreir.BodyCallPassStackValueTag
                wholeCallF64FromIntCall.targetIsImportc = false
                add(wholeCallF64FromIntCall.argSlots, wholeCallF64FromIntArgSlot)
                wholeCallF64FromIntCall.inlineF64FromIntKind = PrimaryBodyIrCallOpInlineF64FromIntKindForConstruction(share(wholeCallF64FromIntCall),
                                                                                                                        bodyIR,
                                                                                                                        "float64")
                if wholeCallF64FromIntCall.inlineF64FromIntKind > 0:
                    wholeCallF64FromIntCall.wholeCallF64FromIntRescue = true
                    wholeCallF64FromIntCall.inlineF64FromIntUnsigned = (wholeCallF64FromIntSignedness == 2)
                    add(bodyIR.callSequence, wholeCallF64FromIntCall)
                    var wholeCallF64FromIntOp: coreir.BodyOp
                    wholeCallF64FromIntOp.kind = coreir.BodyOpCallTag
                    wholeCallF64FromIntOp.target = targetSlot
                    add(wholeCallF64FromIntOp.operands, callOrdinal)
                    let _ = coreir.BodyIRAppendOp(bodyIR, wholeCallF64FromIntOp)
                    callOrdinal = callOrdinal + 1
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=whole_call_f64_from_int_rescue_hit head={callHead}")
                    return true
            # 实参既非已登记的 I32/I64 槽(如嵌套聚合/str 误标 float64 目标——理论
            # 不可达, 前端类型检查应已拒绝; 或复合表达式实参, 不在本次范围), 也非
            # 可判定有符号性的标量整型声明(查不到——响亮 poison, 不许静默留未写
            # 槽/不许默认按有符号算错)。
            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                os.WriteLine(os.GetStderr(), Fmt"phase=whole_call_f64_from_int_rescue_miss head={callHead}")
            PrimaryBodyIrAppendInvalidOp(bodyIR, lineNumber, 0, 818, 0)
            return true
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=whole_call_ordinal_fail head=",
                                                       share(callHead),
                                                       " ordinal=",
                                                       strings.IntToStr(resolvedOrdinal),
                                                       " targets=",
                                                       strings.IntToStr(irFunction.callTargets.len)], ""))
        # Pure-cast still unresolved after f64+int rescues: poison (do not
        # leave targetSlot unread). Non-cast heads fall through return false.
        if PrimaryBodyIrPureCastResultTypeKind(share(callHead)) != coreir.LocalInvalidTag:
            PrimaryBodyIrAppendInvalidOp(bodyIR, lineNumber, 0, 810, 0)
            return true
        return false
    if callResultType == "" || callResultType == "unknown" || callResultType == "void":
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=whole_call_result_type_fail head=",
                                                       share(callHead),
                                                       " ordinal=",
                                                       strings.IntToStr(resolvedOrdinal),
                                                       " result_type=",
                                                       share(callResultType)], ""))
        return false
    var stmt: lower.PrimaryObjectIrStatement
    stmt.sourcePath = typedFn.sourcePath
    stmt.functionName = typedFn.functionName
    stmt.lineNumber = lineNumber
    stmt.lineIndent = 0
    stmt.kind = texpr.TypedExprIrStmtLetCall
    stmt.callKind = texpr.TypedExprCallNone
    stmt.rhsNodeIndex = wholeCallOwnNodeIndex
    stmt.surfaceText = callHead
    stmt.bindingName = bodyIR.localSlots[targetSlot].name
    stmt.resultType = share(callResultType)
    stmt.conditionKind = texpr.TypedExprIrCondNone
    stmt.conditionLhsText = ""
    stmt.conditionRhsText = ""
    stmt.conditionLiteralText = ""
    stmt.assignRootName = ""
    stmt.assignRootType = ""
    stmt.assignRootSourcePath = ""
    stmt.assignRootGlobalFlag = false
    stmt.assignPlaceKind = texpr.TypedExprPlaceTemporary
    stmt.assignFieldName = ""
    stmt.assignFieldType = ""
    stmt.assignFieldOffsetBytes = 0
    stmt.assignFieldSizeBytes = 0
    stmt.assignValueRootName = ""
    stmt.assignValueRootType = ""
    stmt.assignValueFieldName = ""
    stmt.assignValueFieldType = ""
    stmt.assignValueFieldOffsetBytes = 0
    stmt.assignValueFieldSizeBytes = 0
    stmt.assignValueOpKind = texpr.TypedExprIrOpUnsupported
    stmt.assignValueLhsText = ""
    stmt.assignValueRhsText = ""
    stmt.callCallee = texpr.TypedExprQualifiedCallLeaf(share(callHead))
    stmt.callTarget = irFunction.callTargets[resolvedOrdinal]
    stmt.callTargetSourcePath = irFunction.callTargetSourcePaths[resolvedOrdinal]
    stmt.callTargetSignatureLineNumber =
        irFunction.callTargetSignatureLineNumbers[resolvedOrdinal]
    stmt.callTargetImportc = irFunction.callTargetImportcFlags[resolvedOrdinal]
    stmt.callArgCount = callArgCount
    stmt.callArgsText = callArgsText
    stmt.returnRoot = false
    var resultTypeKind: int32
    var resultSizeBytes: int32
    var resultAlignBytes: int32
    let resultSourcePath = stmt.callTargetSourcePath
    if resultSourcePath == "":
        return false
    PrimaryBodyIrNodeTypeShape(lowering.typedIr,
                               resultSourcePath,
                               share(callResultType),
                               resultTypeKind,
                               resultSizeBytes,
                               resultAlignBytes)
    let targetTypeKind = PrimaryBodyIrSlotType(bodyIR, targetSlot)
    var resultSlot = targetSlot
    if resultTypeKind != targetTypeKind:
        resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                        slotNames,
                                                        lowering.typedIr,
                                                        resultSourcePath,
                                                        Fmt"{bodyIR.localSlots[targetSlot].name}#call_cast_value#{lineNumber}",
                                                        callResultType)
        if resultSlot < 0:
            return false
    var wholeCallSlotBlockStart: int32 = -1
    let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                      slotNames,
                                      lowering,

                                      typedFn,
                                      irFunction,
                                      stmt,
                                      resultSlot,
                                      varI32ParamNames,
                                      callOrdinal,
                                      wholeCallSlotBlockStart)
    if resultSlot != targetSlot:
        var copyOp: coreir.BodyOp
        copyOp.kind = coreir.BodyOpCopyLocalTag
        copyOp.target = targetSlot
        add(copyOp.operands, resultSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, copyOp)
    return true

# Group G 融合:JsonNode `obj["key"] = rhs` bracket-assign。配合 compiler_csg 的
# A-minimal 保留(json.cheng 的 []/[]=/Json* 现在在 lowering.typedIr.functions),合成
# json.JsonSetField* 调用经 AppendCallOp 发射(resultSlot=-1 void 裸调用协议)。
# ==== Group G: exact FieldGet/IndexGet chain; no source-text reconstruction. ====

@borrows
fn PrimaryBodyIrFieldChainDeclarationIndex(
        typedIr: texpr.TypedExprIr,
        producerSourceIndex: int32,
        declarationSourceLocalRow: int32): int32 =
    if producerSourceIndex < 0 ||
       producerSourceIndex + 1 >=
           typedIr.exactLayoutIndexSourceStarts.len ||
       declarationSourceLocalRow < 0:
        return -1
    let start =
        typedIr.exactLayoutIndexSourceStarts[producerSourceIndex]
    let stop =
        typedIr.exactLayoutIndexSourceStarts[
            producerSourceIndex + 1]
    if start < 0 || stop < start ||
       declarationSourceLocalRow >= stop - start:
        return -1
    return start + declarationSourceLocalRow

fn PrimaryBodyIrFieldChainRequireTypeFact(
        lowering: var lower.LoweringPlanStub,
        typeId: int32): bool =
    let count = lowering.typeArenaStructuralKinds.len
    return typeId >= 0 && typeId < count &&
           lowering.typeArenaScalarKinds.len == count &&
           lowering.typeArenaChildTypeIds.len == count &&
           lowering.typeArenaFixedLengths.len == count &&
           lowering.typeArenaSizeBytes.len == count &&
           lowering.typeArenaAlignBytes.len == count &&
           lowering.typeArenaLayoutPresent.len == count &&
           lowering.typeArenaLayoutPresent[typeId] == 1 &&
           lowering.typeArenaSizeBytes[typeId] >= 0 &&
           lowering.typeArenaAlignBytes[typeId] > 0

fn PrimaryBodyIrFieldChainPreflight(
        bodyIR: var coreir.BodyIR,
        lowering: var lower.LoweringPlanStub,
        chainNodeIndex: int32,
        requiredTypeIds: var int32[]): bool =
    requiredTypeIds = []
    let nodeCount = lowering.typedIr.nodes2_nodeIndexs.len
    if chainNodeIndex < 0 || chainNodeIndex >= nodeCount:
        return false
    let rootKind = lowering.typedIr.nodes2_opKinds[chainNodeIndex]
    if rootKind != texpr.TypedExprIrOpFieldGet &&
       rootKind != texpr.TypedExprIrOpIndexGet:
        return false
    if !lowering.typedIr.nodeAuthorityTypeArenaBound ||
       !coreir.BodyIRBindTypeArenaArtifactCid(
           bodyIR, lowering.typedIr.nodeAuthorityTypeArenaArtifactCid) ||
       lowering.typedIr.nodes2_operand0NodeIndexs.len != nodeCount ||
       lowering.typedIr.nodes2_operand1NodeIndexs.len != nodeCount ||
       lowering.typedIr.nodes2_exactTypeArenaIds.len != nodeCount ||
       lowering.typedIr.nodes2_resultTypeProofKinds.len != nodeCount:
        panic("field chain: frozen node authority unavailable")
    var visited: bool[]
    setLen(visited, nodeCount)
    var current = chainNodeIndex
    while current >= 0:
        if current >= nodeCount || visited[current]:
            panic("field chain: node coordinate cycle or overflow")
        visited[current] = true
        let exactTypeId = arenamod.ArenaArrayInt32Get(
            lowering.typedIr.arena,
            lowering.typedIr.nodes2_exactTypeArenaIds,
            current)
        if !PrimaryBodyIrFieldChainRequireTypeFact(
               lowering, exactTypeId):
            panic("field chain: exact TypeArena fact missing")
        add(requiredTypeIds, exactTypeId)
        let opKind = lowering.typedIr.nodes2_opKinds[current]
        if opKind == texpr.TypedExprIrOpParamRef ||
           opKind == texpr.TypedExprIrOpLocalRef:
            break
        let baseNode = arenamod.ArenaArrayInt32Get(
            lowering.typedIr.arena,
            lowering.typedIr.nodes2_operand0NodeIndexs,
            current)
        if baseNode < 0 || baseNode >= current:
            panic("field chain: owner node identity invalid")
        let baseTypeId = arenamod.ArenaArrayInt32Get(
            lowering.typedIr.arena,
            lowering.typedIr.nodes2_exactTypeArenaIds,
            baseNode)
        if !PrimaryBodyIrFieldChainRequireTypeFact(
               lowering, baseTypeId):
            panic("field chain: owner TypeArena fact missing")
        add(requiredTypeIds, baseTypeId)
        if opKind == texpr.TypedExprIrOpFieldGet:
            if lowering.typedIr.nodes2_fieldOffsetBytes.len != nodeCount ||
               lowering.typedIr.nodes2_fieldSizeBytes.len != nodeCount ||
               lowering.typedIr.nodes2_fieldAlignBytes.len != nodeCount ||
               lowering.typedIr.nodes2_fieldProducerSourceIndexes.len !=
                   nodeCount ||
               lowering.typedIr.nodes2_fieldOwnerDeclarationSourceLocalRows.len !=
                   nodeCount ||
               lowering.typedIr.nodes2_fieldDeclarationSourceLocalRows.len !=
                   nodeCount ||
               lowering.typedIr.nodes2_fieldOrdinals.len != nodeCount ||
               lowering.typedIr.nodes2_fieldBuiltinKinds.len != nodeCount:
                panic("field chain: field SoA shape split")
            let offset = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldOffsetBytes,
                current)
            let size = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldSizeBytes,
                current)
            let align = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldAlignBytes,
                current)
            let sourceId = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldProducerSourceIndexes,
                current)
            let ownerRow = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldOwnerDeclarationSourceLocalRows,
                current)
            let fieldRow = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldDeclarationSourceLocalRows,
                current)
            let ordinal = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldOrdinals,
                current)
            let builtin = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_fieldBuiltinKinds,
                current)
            if offset < 0 || size <= 0 || align <= 0 ||
               sourceId < 0 || ordinal < 0 ||
               builtin <
                   Int32(texpr.TypedExprLayoutBuiltinNone) ||
               builtin >
                   Int32(texpr.TypedExprLayoutBuiltinOptional):
                panic("field chain: field layout authority invalid")
            var ownerLayoutRow: int32 = -1
            var exactFieldRow: int32 = -1
            if builtin ==
                   Int32(texpr.TypedExprLayoutBuiltinNone):
                let ownerIndex =
                    PrimaryBodyIrFieldChainDeclarationIndex(
                        lowering.typedIr, sourceId, ownerRow)
                let fieldIndex =
                    PrimaryBodyIrFieldChainDeclarationIndex(
                        lowering.typedIr, sourceId, fieldRow)
                if ownerIndex < 0 || fieldIndex < 0 ||
                   ownerIndex >=
                       lowering.typedIr.exactLayoutTypeDeclarationRows.len ||
                   fieldIndex >=
                       lowering.typedIr.exactLayoutFieldDeclarationRows.len ||
                   ownerIndex >=
                       lowering.typedIr.exactLayoutDeclarationTypeArenaIds.len ||
                   fieldIndex >=
                       lowering.typedIr.exactLayoutDeclarationTypeArenaIds.len:
                    panic("field chain: declaration coordinate invalid")
                ownerLayoutRow =
                    lowering.typedIr.exactLayoutTypeDeclarationRows[
                        ownerIndex]
                exactFieldRow =
                    lowering.typedIr.exactLayoutFieldDeclarationRows[
                        fieldIndex]
                let physicalBaseTypeId =
                    typechain.CanonicalTypeChainPhysicalTypeId(
                        lowering, baseTypeId)
                if physicalBaseTypeId !=
                       lowering.typedIr.exactLayoutDeclarationTypeArenaIds[
                           ownerIndex] ||
                   exactTypeId !=
                       lowering.typedIr.exactLayoutDeclarationTypeArenaIds[
                           fieldIndex]:
                    panic("field chain: declaration TypeId drift")
            else:
                let ownerIndex = sourceId * 4 + builtin
                let fieldIndex =
                    sourceId * 16 + builtin * 4 + ordinal
                if ownerIndex < 0 ||
                   ownerIndex >=
                       lowering.typedIr.exactLayoutTypeBuiltinRows.len ||
                   fieldIndex < 0 ||
                   fieldIndex >=
                       lowering.typedIr.exactLayoutFieldBuiltinRows.len:
                    panic("field chain: builtin coordinate invalid")
                ownerLayoutRow =
                    lowering.typedIr.exactLayoutTypeBuiltinRows[ownerIndex]
                exactFieldRow =
                    lowering.typedIr.exactLayoutFieldBuiltinRows[fieldIndex]
            if ownerLayoutRow < 0 ||
               ownerLayoutRow >= lowering.typedIr.typeLayoutSizeBytes.len ||
               exactFieldRow < 0 ||
               exactFieldRow >= lowering.typedIr.typeFieldOffsetBytes.len ||
               exactFieldRow >= lowering.typedIr.typeFieldSizeBytes.len ||
               exactFieldRow >= lowering.typedIr.typeFieldAlignBytes.len ||
               lowering.typedIr.typeFieldOffsetBytes[exactFieldRow] != offset ||
               lowering.typedIr.typeFieldSizeBytes[exactFieldRow] != size ||
               lowering.typedIr.typeFieldAlignBytes[exactFieldRow] != align:
                panic("field chain: exact field row drift")
            let ownerSize =
                lowering.typedIr.typeLayoutSizeBytes[ownerLayoutRow]
            if ownerSize <= 0 ||
               Int64(offset) + Int64(size) >
                   Int64(ownerSize) ||
               offset % align != 0:
                panic("field chain: field layout overflow")
        elif opKind == texpr.TypedExprIrOpIndexGet:
            let indexNode = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_operand1NodeIndexs,
                current)
            if indexNode < 0 || indexNode >= current ||
               lowering.typedIr.nodes2_elemSizeBytes.len != nodeCount:
                panic("field chain: index coordinate invalid")
            let indexProof = arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_resultTypeProofKinds,
                indexNode)
            if indexProof !=
                   texpr.TypedExprSnapshotTypeProofScalar:
                panic("field chain: index TypeId is not scalar")
            let physicalBaseTypeId =
                typechain.CanonicalTypeChainPhysicalTypeId(
                    lowering, baseTypeId)
            let physicalKind =
                lowering.typeArenaStructuralKinds[
                    physicalBaseTypeId]
            let scalarKind =
                lowering.typeArenaScalarKinds[
                    physicalBaseTypeId]
            let isString =
                physicalKind ==
                    Int32(typearena.TypedExprStructuralTypeScalar) &&
                scalarKind ==
                    Int32(typearena.TypedExprStructuralScalarStr)
            let isSequence =
                physicalKind ==
                    Int32(typearena.TypedExprStructuralTypeSequence)
            let isFixed =
                physicalKind ==
                    Int32(typearena.TypedExprStructuralTypeFixedArray)
            if !isString && !isSequence && !isFixed:
                panic("field chain: indexed owner structural kind invalid")
            if !isString:
                let childTypeId =
                    lowering.typeArenaChildTypeIds[
                        physicalBaseTypeId]
                let elemSize = arenamod.ArenaArrayInt32Get(
                    lowering.typedIr.arena,
                    lowering.typedIr.nodes2_elemSizeBytes,
                    current)
                if childTypeId < 0 ||
                   childTypeId != exactTypeId ||
                   !PrimaryBodyIrFieldChainRequireTypeFact(
                       lowering, childTypeId) ||
                   elemSize !=
                       lowering.typeArenaSizeBytes[childTypeId] ||
                   (isFixed &&
                    lowering.typeArenaFixedLengths[
                        physicalBaseTypeId] <= 0):
                    panic("field chain: indexed element TypeId/layout drift")
            add(requiredTypeIds, arenamod.ArenaArrayInt32Get(
                lowering.typedIr.arena,
                lowering.typedIr.nodes2_exactTypeArenaIds,
                indexNode))
        else:
            panic("field chain: unsupported structural hop")
        current = baseNode
    if current < 0:
        panic("field chain: root binding missing")
    return true

@borrows
fn PrimaryBodyIrLowerFieldReadChainSlot(
        bodyIR: var coreir.BodyIR,
        slotNames: var str[],
        varI32ParamNames: str[],
        lowering: var lower.LoweringPlanStub,
        typedFn: texpr.TypedExprIrFunction,
        irFunction: lower.PrimaryObjectIrFunction,
        chainNodeIndex: int32,
        callOrdinal: var int32): int32 =
    var requiredTypeIds: int32[]
    if !PrimaryBodyIrFieldChainPreflight(
           bodyIR,
           lowering,

           chainNodeIndex,
           requiredTypeIds):
        return -1
    # Bind only after the entire chain has passed read-only validation.  Sort
    # exact TypeIds so BodyIR's sparse fact table has one deterministic order
    # independent of traversal direction and chain depth.
    for i in 1..<requiredTypeIds.len:
        let picked = requiredTypeIds[i]
        var j = i - 1
        while j >= 0 && requiredTypeIds[j] > picked:
            requiredTypeIds[j + 1] = requiredTypeIds[j]
            j = j - 1
        requiredTypeIds[j + 1] = picked
    var previousTypeId: int32 = -1
    for requiredIndex in 0..<requiredTypeIds.len:
        let typeId = requiredTypeIds[requiredIndex]
        if typeId == previousTypeId:
            continue
        if !coreir.BodyIRBindCanonicalTypeFact(
               bodyIR,
               lowering.typeArenaArtifactCid,
               typeId,
               lowering.typeArenaStructuralKinds[typeId],
               lowering.typeArenaScalarKinds[typeId],
               lowering.typeArenaChildTypeIds[typeId],
               lowering.typeArenaFixedLengths[typeId],
               lowering.typeArenaSizeBytes[typeId],
               lowering.typeArenaAlignBytes[typeId]):
            panic("field chain: BodyIR TypeArena fact bind failed")
        previousTypeId = typeId
    let resultSlot = PrimaryBodyIrEvalNode(
        bodyIR,
        slotNames,
        varI32ParamNames,
        lowering,

        typedFn,
        irFunction,
        chainNodeIndex,
        callOrdinal)
    if resultSlot < 0 || resultSlot >= bodyIR.localSlots.len:
        panic("field chain: structured lowering failed")
    let resultTypeId = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_exactTypeArenaIds,
        chainNodeIndex)
    let managedKind =
        lowering.typedIr.nodes2_resultTypeManagedFlags[chainNodeIndex] ?
            coreir.BodyManagedStorageManagedTag :
            coreir.BodyManagedStorageUnmanagedTag
    if !coreir.BodyIRBindLocalSlotTypeArenaProof(
           bodyIR,
           resultSlot,
           lowering.typeArenaArtifactCid,
           resultTypeId,
           managedKind):
        panic("field chain: result slot exact TypeId bind failed")
    return resultSlot

@borrows
fn PrimaryBodyIrLowerJsonBracketKeyArgText(bodyIR: var coreir.BodyIR,
                                            slotNames: var str[],
                                            varI32ParamNames: str[],
                                            lowering: var lower.LoweringPlanStub,
                                            typedFn: texpr.TypedExprIrFunction,
                                            irFunction: lower.PrimaryObjectIrFunction,
                                            sourcePath: str,
                                            lineNumber: int32,
                                            keyTextRaw: str,
                                            keyNodeIndex: int32,
                                            callOrdinal: var int32): str =
    let keyText = strutil.Strip(keyTextRaw)
    if keyText == "":
        return ""
    if PrimaryBodyIrTextIsStringLiteral(keyText):
        return keyText
    let keySlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, keyText)
    if keySlot >= 0 && keySlot < bodyIR.localSlots.len && PrimaryBodyIrSlotType(bodyIR, keySlot) == coreir.LocalStrTag:
        return slotNames[keySlot]
    if PrimaryBodyIrTextHasFieldOrIndex(keyText):
        let chainSlot = PrimaryBodyIrLowerFieldReadChainSlot(
            bodyIR,
            slotNames,
            varI32ParamNames,
            lowering,

            typedFn,
            irFunction,
            keyNodeIndex,
            callOrdinal)
        if chainSlot >= 0 && chainSlot < bodyIR.localSlots.len && PrimaryBodyIrSlotType(bodyIR, chainSlot) == coreir.LocalStrTag:
            return slotNames[chainSlot]
    return ""

@borrows
fn PrimaryBodyIrEmitJsonSetterCall(bodyIR: var coreir.BodyIR,
                                    slotNames: var str[],
                                    lowering: var lower.LoweringPlanStub,
                                    typedFn: texpr.TypedExprIrFunction,
                                    irFunction: lower.PrimaryObjectIrFunction,
                                    varI32ParamNames: str[],
                                    sourcePath: str,
                                    functionName: str,
                                    lineNumber: int32,
                                    setterHead: str,
                                    setterArgText: str,
                                    callOrdinal: var int32): bool =
    let setterArgCount = PrimaryBodyIrCallArgNames(setterArgText).len
    if setterArgCount <= 0:
        return false
    var setterResultType = ""
    let setterOrdinal = PrimaryBodyIrResolvedOrRegisteredWholeCallOrdinal(irFunction, lowering.typedIr, sourcePath, setterHead, setterArgCount, setterResultType)
    if setterOrdinal < 0 || setterOrdinal >= irFunction.callTargets.len ||
       setterOrdinal >= irFunction.callTargetSourcePaths.len ||
       setterOrdinal >= irFunction.callTargetSignatureLineNumbers.len ||
       setterOrdinal >= irFunction.callTargetImportcFlags.len:
        return false
    var s: lower.PrimaryObjectIrStatement
    s.sourcePath = sourcePath
    s.functionName = functionName
    s.lineNumber = lineNumber
    s.lineIndent = 0
    s.kind = texpr.TypedExprIrStmtCall
    s.callKind = texpr.TypedExprCallNone
    s.rhsNodeIndex = -1
    s.surfaceText = setterHead
    s.bindingName = ""
    s.resultType = "void"
    s.conditionKind = texpr.TypedExprIrCondNone
    s.assignPlaceKind = texpr.TypedExprPlaceTemporary
    s.assignValueOpKind = texpr.TypedExprIrOpUnsupported
    s.callCallee = texpr.TypedExprQualifiedCallLeaf(share(setterHead))
    s.callTarget = irFunction.callTargets[setterOrdinal]
    s.callTargetSourcePath = irFunction.callTargetSourcePaths[setterOrdinal]
    s.callTargetSignatureLineNumber =
        irFunction.callTargetSignatureLineNumbers[setterOrdinal]
    s.callTargetImportc = irFunction.callTargetImportcFlags[setterOrdinal]
    s.callArgCount = setterArgCount
    s.callArgsText = setterArgText
    s.returnRoot = false
    var setterBlockStart: int32 = -1
    let _ = PrimaryBodyIrAppendCallOp(bodyIR, slotNames, lowering,  typedFn, irFunction, s, -1, varI32ParamNames, callOrdinal, setterBlockStart)
    return true

@borrows
fn PrimaryBodyIrLowerJsonNestedBracketAssign(bodyIR: var coreir.BodyIR,
                                              slotNames: var str[],
                                              lowering: var lower.LoweringPlanStub,
                                              typedFn: texpr.TypedExprIrFunction,
                                              irFunction: lower.PrimaryObjectIrFunction,
                                              varI32ParamNames: str[],
                                              stmt: lower.PrimaryObjectIrStatement,
                                              lineNumber: int32,
                                              callOrdinal: var int32): bool =
    let lhsText = PrimaryBodyIrCanonicalAssignLhsName(stmt.bindingName)
    var rootText = ""
    var dims: str[]
    let dimCount = PrimaryBodyIrMultiIndexParts(lhsText, rootText, dims)
    if dimCount != 2:
        return false
    var baseTypeText = stmt.assignRootType
    if baseTypeText == "" || baseTypeText == "unknown" || !PrimaryObjectMetadataTextStable(baseTypeText):
        baseTypeText = PrimaryBodyIrBindingTypeForName(lowering.typedIr, typedFn, irFunction, lineNumber, rootText)
    if !PrimaryBodyIrTypeTextIsJsonNode(baseTypeText):
        return false
    let rootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rootText)
    if rootSlot < 0 || rootSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryBodyIrSlotType(bodyIR, rootSlot) != coreir.LocalAggregateTag:
        return false
    let dim0 = dims[0]
    let dim1 = dims[1]
    if !PrimaryBodyIrTextIsStringLiteral(dim0):
        return false
    let innerExpr = Fmt"{rootText}[{dim0}]"
    let innerSlot = PrimaryBodyIrSubscriptOpCallArgSlot(bodyIR, slotNames, varI32ParamNames, lowering,  typedFn, irFunction, stmt.sourcePath, lineNumber, innerExpr, -1, callOrdinal)
    if innerSlot < 0 || innerSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryBodyIrSlotType(bodyIR, innerSlot) != coreir.LocalAggregateTag:
        return false
    let innerName = slotNames[innerSlot]
    let outerKeyArg = PrimaryBodyIrLowerJsonBracketKeyArgText(
        bodyIR, slotNames, varI32ParamNames, lowering,
        typedFn, irFunction, stmt.sourcePath, lineNumber, dim1,
        stmt.assignIndexNodeIndex, callOrdinal)
    if outerKeyArg == "":
        return false
    let rhsText = strutil.Strip(stmt.surfaceText)
    if rhsText == "":
        return false
    var mutateHead = ""
    var mutateArgText = ""
    if PrimaryBodyIrTextIsStringLiteral(rhsText):
        mutateHead = "json.JsonSetFieldStr"
        mutateArgText = strutil.Join([strings.CloneStr(innerName), strings.CloneStr(outerKeyArg), strings.CloneStr(rhsText)], ", ")
    elif rhsText == "true" || rhsText == "false":
        mutateHead = "json.JsonSetFieldBool"
        mutateArgText = strutil.Join([strings.CloneStr(innerName), strings.CloneStr(outerKeyArg), strings.CloneStr(rhsText)], ", ")
    elif PrimaryBodyIrTextIsIntLiteral(rhsText):
        mutateHead = "json.JsonSetFieldInt64"
        mutateArgText = strutil.Join([strings.CloneStr(innerName), strings.CloneStr(outerKeyArg), strings.CloneStr(rhsText)], ", ")
    else:
        let rhsSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
        if rhsSlot < 0 || rhsSlot >= bodyIR.localSlots.len:
            return false
        let rhsKind = PrimaryBodyIrSlotType(bodyIR, rhsSlot)
        if rhsKind == coreir.LocalAggregateTag:
            mutateHead = "json.JsonSetField"
        elif rhsKind == coreir.LocalStrTag:
            mutateHead = "json.JsonSetFieldStr"
        elif rhsKind == coreir.LocalI32Tag:
            mutateHead = "json.JsonSetFieldInt32"
        elif rhsKind == coreir.LocalI64Tag:
            mutateHead = "json.JsonSetFieldInt64"
        elif rhsKind == coreir.LocalF64Tag:
            mutateHead = "json.JsonSetFieldFloat64"
        else:
            return false
        mutateArgText = strutil.Join([strings.CloneStr(innerName), strings.CloneStr(outerKeyArg), strings.CloneStr(slotNames[rhsSlot])], ", ")
    if !PrimaryBodyIrEmitJsonSetterCall(bodyIR, slotNames, lowering,  typedFn, irFunction, varI32ParamNames, stmt.sourcePath, stmt.functionName, lineNumber, mutateHead, mutateArgText, callOrdinal):
        return false
    let writebackArgText = strutil.Join([strings.CloneStr(rootText), strings.CloneStr(dim0), strings.CloneStr(innerName)], ", ")
    if !PrimaryBodyIrEmitJsonSetterCall(bodyIR, slotNames, lowering,  typedFn, irFunction, varI32ParamNames, stmt.sourcePath, stmt.functionName, lineNumber, "json.JsonSetField", writebackArgText, callOrdinal):
        return false
    return true

@borrows
fn PrimaryBodyIrTypeTextIsJsonNode(typeRaw: str): bool =
    let normType = texpr.TypedExprNormalizeTypeText(typeRaw)
    if normType == "JsonNode":
        return true
    let suffix = ".JsonNode"
    let suffixLen = len(suffix)
    if len(normType) > suffixLen &&
       PrimaryStartsWith(strings.SliceBytes(normType, len(normType) - suffixLen, suffixLen), suffix):
        return true
    return false

@borrows
fn PrimaryBodyIrLowerJsonBracketAssign(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       lowering: var lower.LoweringPlanStub,
                                       typedFn: texpr.TypedExprIrFunction,
                                       irFunction: lower.PrimaryObjectIrFunction,
                                       varI32ParamNames: str[],
                                       stmt: lower.PrimaryObjectIrStatement,
                                       lineNumber: int32,
                                       callOrdinal: var int32): bool =
    # Hoist typedFn/stmt managed fields once (physical-source class).
    let typedFnName = typedFn.functionName
    let stmt_bindingName = stmt.bindingName
    let stmt_sourcePath = stmt.sourcePath
    let stmt_functionName = stmt.functionName
    let stmt_assignRootType = stmt.assignRootType
    let stmt_surfaceText = stmt.surfaceText
    let stmt_rhsNodeIndex = stmt.rhsNodeIndex
    let stmt_assignIndexNodeIndex = stmt.assignIndexNodeIndex
    let lhsText = PrimaryBodyIrCanonicalAssignLhsName(stmt_bindingName)
    var baseName = ""
    var keyText = ""
    if !PrimaryBodyIrIndexExprParts(lhsText, baseName, keyText):
        return false
    if baseName == "" || PrimaryBodyIrTextHasFieldOrIndex(baseName):
        return false
    # Group G 子形 5:key 非串字面量(field-read 链 / bare-ident str)物化进 str 槽。
    let keyArgText = PrimaryBodyIrLowerJsonBracketKeyArgText(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering,

                                                              typedFn,
                                                              irFunction,
                                                              stmt_sourcePath,
                                                              lineNumber,
                                                              keyText,
                                                              stmt_assignIndexNodeIndex,
                                                              callOrdinal)
    if keyArgText == "":
        return false
    var baseTypeText = stmt_assignRootType
    if baseTypeText == "" || baseTypeText == "unknown" ||
       !PrimaryObjectMetadataTextStable(baseTypeText):
        baseTypeText = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       lineNumber,
                                                       baseName)
    if !PrimaryBodyIrTypeTextIsJsonNode(baseTypeText):
        return false
    let baseSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, baseName)
    if baseSlot < 0 || baseSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryBodyIrSlotType(bodyIR, baseSlot) != coreir.LocalAggregateTag:
        return false
    let rhsText = strutil.Strip(stmt_surfaceText)
    if rhsText == "":
        return false
    var setterHead = ""
    var setterArgText = ""
    if PrimaryBodyIrTextIsStringLiteral(rhsText):
        setterHead = "json.JsonSetFieldStr"
        setterArgText = Fmt"{baseName}, {keyArgText},{rhsText}"
    elif rhsText == "true" || rhsText == "false":
        setterHead = "json.JsonSetFieldBool"
        setterArgText = Fmt"{baseName}, {keyArgText},{rhsText}"
    elif PrimaryBodyIrTextIsIntLiteral(rhsText):
        setterHead = "json.JsonSetFieldInt64"
        setterArgText = Fmt"{baseName}, {keyArgText},{rhsText}"
    else:
        var rhsSlotTypeKind = coreir.LocalInvalidTag
        var rhsArgName = ""
        if PrimaryBodyIrTextHasCallSurface(rhsText):
            if stmt_rhsNodeIndex < 0 ||
               stmt_rhsNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
               lowering.typedIr.nodes2_opKinds[stmt_rhsNodeIndex] != texpr.TypedExprIrOpCallExpr:
                let panicMsg = Fmt"primary: json bracket call RHS lacks exact TypedExpr CallExpr function={typedFnName} line={lineNumber} node={stmt_rhsNodeIndex}"
                panic(panicMsg)
            let rhsCallSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                  slotNames,
                                                                  lowering.typedIr,
                                                                  stmt_sourcePath,
                                                                  Fmt"#json_rhs_call#{lineNumber}#{bodyIR.ops.len}",
                                                                  "json.JsonNode")
            if rhsCallSlot < 0:
                return false
            if !PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                       slotNames,
                                                       lowering,

                                                       typedFn,
                                                       irFunction,
                                                       varI32ParamNames,
                                                       rhsText,
                                                       rhsCallSlot,
                                                       lineNumber,
                                                       stmt_rhsNodeIndex,
                                                       callOrdinal):
                return false
            rhsSlotTypeKind = coreir.LocalAggregateTag
            rhsArgName = bodyIR.localSlots[rhsCallSlot].name
        else:
            let rhsSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
            if rhsSlot < 0 || rhsSlot >= bodyIR.localSlots.len:
                let resolvedFieldReadSlot =
                    PrimaryBodyIrLowerFieldReadChainSlot(
                        bodyIR,
                        slotNames,
                        varI32ParamNames,
                        lowering,

                        typedFn,
                        irFunction,
                        stmt_rhsNodeIndex,
                        callOrdinal)
                if resolvedFieldReadSlot < 0:
                    return false
                rhsSlotTypeKind = PrimaryBodyIrSlotType(bodyIR, resolvedFieldReadSlot)
                rhsArgName = slotNames[resolvedFieldReadSlot]
            else:
                rhsSlotTypeKind = PrimaryBodyIrSlotType(bodyIR, rhsSlot)
                rhsArgName = slotNames[rhsSlot]
        if rhsSlotTypeKind == coreir.LocalAggregateTag:
            setterHead = "json.JsonSetField"
        elif rhsSlotTypeKind == coreir.LocalStrTag:
            setterHead = "json.JsonSetFieldStr"
        elif rhsSlotTypeKind == coreir.LocalI32Tag:
            setterHead = "json.JsonSetFieldInt32"
        elif rhsSlotTypeKind == coreir.LocalI64Tag:
            setterHead = "json.JsonSetFieldInt64"
        elif rhsSlotTypeKind == coreir.LocalF64Tag:
            setterHead = "json.JsonSetFieldFloat64"
        else:
            return false
        setterArgText = Fmt"{baseName}, {keyArgText},{rhsArgName}"
    var setterResultType = ""
    let setterArgCount = PrimaryBodyIrCallArgNames(setterArgText).len
    let setterOrdinal = PrimaryBodyIrResolvedOrRegisteredWholeCallOrdinal(irFunction,
                                                                          lowering.typedIr,
                                                                          stmt_sourcePath,
                                                                          setterHead,
                                                                          setterArgCount,
                                                                          setterResultType)
    if setterOrdinal < 0 || setterOrdinal >= irFunction.callTargets.len ||
       setterOrdinal >= irFunction.callTargetSourcePaths.len ||
       setterOrdinal >= irFunction.callTargetSignatureLineNumbers.len ||
       setterOrdinal >= irFunction.callTargetImportcFlags.len:
        return false
    var setterStmt: lower.PrimaryObjectIrStatement
    setterStmt.sourcePath = stmt_sourcePath
    setterStmt.functionName = stmt_functionName
    setterStmt.lineNumber = lineNumber
    setterStmt.lineIndent = 0
    setterStmt.kind = texpr.TypedExprIrStmtCall
    setterStmt.callKind = texpr.TypedExprCallNone
    setterStmt.rhsNodeIndex = -1
    setterStmt.surfaceText = strings.CloneStr(setterHead)
    setterStmt.bindingName = ""
    setterStmt.resultType = "void"
    setterStmt.conditionKind = texpr.TypedExprIrCondNone
    setterStmt.assignPlaceKind = texpr.TypedExprPlaceTemporary
    setterStmt.assignValueOpKind = texpr.TypedExprIrOpUnsupported
    setterStmt.callCallee = texpr.TypedExprQualifiedCallLeaf(share(setterHead))
    setterStmt.callTarget = irFunction.callTargets[setterOrdinal]
    setterStmt.callTargetSourcePath = irFunction.callTargetSourcePaths[setterOrdinal]
    setterStmt.callTargetSignatureLineNumber =
        irFunction.callTargetSignatureLineNumbers[setterOrdinal]
    setterStmt.callTargetImportc = irFunction.callTargetImportcFlags[setterOrdinal]
    setterStmt.callArgCount = setterArgCount
    setterStmt.callArgsText = setterArgText
    setterStmt.returnRoot = false
    var nestedSetterBlockStart: int32 = -1
    let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                      slotNames,
                                      lowering,

                                      typedFn,
                                      irFunction,
                                      setterStmt,
                                      -1,
                                      varI32ParamNames,
                                      callOrdinal,
                                      nestedSetterBlockStart)
    return true
# 沿 ArgLink 链取实参值节点：引用实参（param/local）按名字直传（保留
# var 形参地址协议），字面量串/bool 按文本直传（保留 cstring/str 字面
# 量协议），其余实参经节点求值器物化为槽后按槽名传入；调用发射复用
# PrimaryBodyIrAppendCallOp（槽传参+callOrdinal 协议），不经文本
# WholeCall 解析层。标量/str 返回进 targetSlot；聚合返回、var 形参的
# 非引用实参、特殊投影头（StrDataPtr/IsErr/int 铸型）本批 miss 落回。
# 纪律：所有可失败的门一律在 AppendCallOp 之前判定——一旦发射调用即
# 不可回落（避免文本路径重复发射产生双副作用）。
@borrows
fn PrimaryBodyIrAppendCallExprNodeToSlot(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          lowering: var lower.LoweringPlanStub,
                                          typedFn: texpr.TypedExprIrFunction,
                                          irFunction: lower.PrimaryObjectIrFunction,
                                          varI32ParamNames: str[],
                                          nodeIndex: int32,
                                          targetSlot: int32,
                                          lineNumber: int32,
                                          callOrdinal: var int32): bool =
    if nodeIndex < 0 || nodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("call_node_shape")
        return false
    if lowering.typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        let _ = PrimaryBodyIrNodeEvalMissAt("call_node_shape")
        return false
    # 批次6e：targetSlot == -1 = 裸调用语句丢弃返回值（文本路径同款
    # resultSlot=-1 协议）；sret 形返回（str/聚合）必须有结果槽，拒绝。
    if targetSlot < -1 || targetSlot >= bodyIR.localSlots.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("call_target_slot")
        return false
    let callHeadRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[nodeIndex])
    if !IsOk(callHeadRes):
        return false
    # Bind Value to a named local first (nested CloneStr(Value(...)) leaves no
    # exact live source for later @borrows). Then clone a TailName loan carrier.
    let callHead = Value(callHeadRes)
    # 内征/内建调用节点(sizeof/builtin conversion 等)不携带函数声明身份
    # (callTarget=="" 合法):精确函数身份门(:28198)只服务真实函数调用,
    # 内征节点在此 miss,落回文本/专用内征通道(sizeof 常量折叠等)。
    let callTargetRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_callTargetIds[nodeIndex])
    if !IsOk(callTargetRes) || Value(callTargetRes) == "":
        let _ = PrimaryBodyIrNodeEvalMissAt("call_builtin_node")
        return false
    # PrimaryCallTargetTailName is @borrow_result: the source must outlive the
    # tail view. Keep callHeadForTail alive; do not pass a temporary CloneStr.
    let callHeadForTail = strings.CloneStr(callHead)
    let callHeadTail = PrimaryCallTargetTailName(callHeadForTail)
    if targetSlot >= 0 &&
       (callHeadTail == "StrDataPtr" ||
        callHeadTail == "strDataPtr" ||
        callHeadTail == "RawmemAsVoid"):
        # StrDataPtr(s) 内征：纯 data 字段读替代泛型调用（无 call、无 ordinal、
        # 无 debris）。求值单实参出 str 值槽后读 data@0 宽 8 → ptr，存入目的
        # ptr 槽（镜像文本路径 PrimaryBodyIrAppendStrDataPtrValue）。裸调用
        # （targetSlot==-1）无目的槽，落回通用路径处置。
        if PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalPtrTag:
            let _ = PrimaryBodyIrNodeEvalMissAt("call_special_head")
            return false
        let strDataNodeSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                    slotNames,
                                                    varI32ParamNames,
                                                    lowering,

                                                    share(typedFn),
                                                    irFunction,
                                                    nodeIndex,
                                                    callOrdinal)
        if strDataNodeSlot < 0:
            return false
        return PrimaryBodyIrNodeEvalStore(bodyIR, slotNames, targetSlot, strDataNodeSlot)
    var callProjectionKind = coreir.BodyResultProjectInvalidTag
    if targetSlot >= 0 &&
       PrimaryBodyIrResultProjectionArgNodeIndex(lowering.typedIr,
                                                  nodeIndex,
                                                  callProjectionKind) >= 0:
        return PrimaryBodyIrAppendResultProjectionNodeToSlot(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering,

                                                              typedFn,
                                                              irFunction,
                                                              nodeIndex,
                                                              targetSlot,
                                                              callOrdinal)
    if callHead == "" ||
       callHeadTail == "StrDataPtr" ||
       callHeadTail == "strDataPtr" ||
       callHead == "IsErr" ||
       callHead == "IsOk" ||
       callHead == "result.IsErr" ||
       callHead == "result.IsOk" ||
       callHead == "Value" ||
       callHead == "result.Value" ||
       callHead == "int" ||
       callHead == "Int":
        let _ = PrimaryBodyIrNodeEvalMissAt("call_special_head")
        return false
    var callHeadIsErr = false
    if targetSlot >= 0 && PrimaryBodyIrResultConstructHead(callHead, callHeadIsErr):
        # Ok[T]/Err[T] 构造内征：识别构造头→直接物化 64B 聚合（无 Ok/Err
        # 调用 ordinal）；裸调用（targetSlot==-1）无目的槽，落回通用路径处置。
        return PrimaryBodyIrAppendResultConstruct(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering,

                                                  typedFn,
                                                  irFunction,
                                                  nodeIndex,
                                                  targetSlot,
                                                  callHeadIsErr,
                                                  callOrdinal)
    if callHeadTail == "ErrorInfoOf" && targetSlot >= 0:
        # Result ErrorInfoOf 内征：纯 err 子聚合投影替代泛型调用（无 call、无
        # ordinal、无 debris）；裸调用（targetSlot==-1）无目的槽，落回通用路径。
        return PrimaryBodyIrAppendResultErrInfoProjection(bodyIR,
                                                          slotNames,
                                                          lowering.typedIr,
                                                          typedFn,
                                                          nodeIndex,
                                                          targetSlot)
    let nodeSrcRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_sourcePathIds[nodeIndex])
    let nodeSurfRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_surfaceTextIds[nodeIndex])
    if !IsOk(nodeSrcRes) || !IsOk(nodeSurfRes):
        return false
    let nodeSourcePath = Value(nodeSrcRes)
    let nodeSurfaceText = Value(nodeSurfRes)
    if PrimaryBodyIrCallExprIsStdSystemLoad(lowering,  nodeIndex):
        if targetSlot < 0:
            let _ = PrimaryBodyIrNodeEvalMissAt("std_load_target_slot")
            return false
        return PrimaryBodyIrAppendStdSystemLoadNodeValue(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          nodeIndex,
                                                          targetSlot,
                                                          callOrdinal)
    if targetSlot >= 0 &&
       PrimaryBodyIrSlotType(bodyIR, targetSlot) == coreir.LocalAggregateTag &&
       !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[targetSlot]) &&
       PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr, nodeSourcePath, callHead):
        # 命名字段聚合构造器 `Type(field: v, ...)` 作节点位 payload（Ok[T](Type(...))
        # 的 payload、嵌套实参等）：构造头是聚合类型名（非函数），按 surfaceText 逐
        # 字段物化进等宽聚合目标槽（与文本整调用路径 ~17461、seq-add 同款
        # AppendAggregateConstructorToSlot），让聚合内型 Result 构造的 payload 真物化。
        return PrimaryBodyIrAppendAggregateConstructorToSlot(bodyIR,
                                                             slotNames,
                                                             varI32ParamNames,
                                                             lowering,

                                                             typedFn,
                                                             irFunction,
                                                             nodeSurfaceText,
                                                             nodeIndex,
                                                             callHead,
                                                             nodeSourcePath,
                                                             lineNumber,
                                                             targetSlot,
                                                             nodeIndex,
                                                             callOrdinal)
    if targetSlot >= 0 &&
       PrimaryBodyIrSlotType(bodyIR, targetSlot) == coreir.LocalPtrTag &&
       !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[targetSlot]) &&
       (PrimaryBodyIrPtrReinterpretCastHead(callHead) ||
        PrimaryBodyIrPtrAliasReinterpretCastHead(lowering.typedIr, nodeSourcePath, callHead)):
        # Tptr(x) where Tptr is a `T *` typedef: pure pointer reinterpret. The node
        # evaluator materializes the inner pointer value (with full field-load
        # context); store it into the binding slot. Keeps the str-seq element-store
        # family (StrPtr(cheng_ptr_plus(hdr->buffer, …))) off the text synth path.
        # 707 解封：plain `ptr(x)`/`cstring(x)` 同为纯指针位重解释（EvalNode
        # 30486 段已实现 i64→ptr 同宽复制），此前只放 alias 头导致
        # `p = ptr(uint64(p) + uint64(8))` 落到 whole-call ordinal 解析 miss
        # （call_ordinal）→ bail 707。miss 仍原路 return false（未发射先判定）。
        let aliasNodeSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering,

                                                  share(typedFn),
                                                  irFunction,
                                                  nodeIndex,
                                                  callOrdinal)
        if aliasNodeSlot < 0:
            return false
        return PrimaryBodyIrNodeEvalStore(bodyIR, slotNames, targetSlot, aliasNodeSlot)
    var targetKind = coreir.LocalInvalidTag
    if targetSlot >= 0:
        targetKind = PrimaryBodyIrSlotType(bodyIR, targetSlot)
        if targetKind != coreir.LocalI32Tag &&
           targetKind != coreir.LocalI64Tag &&
           targetKind != coreir.LocalF64Tag &&
           targetKind != coreir.LocalStrTag &&
           targetKind != coreir.LocalPtrTag &&
           targetKind != coreir.LocalAggregateTag:
            let _ = PrimaryBodyIrNodeEvalMissAt("call_target_kind")
            return false
        if (targetKind == coreir.LocalAggregateTag || targetKind == coreir.LocalPtrTag) &&
           PrimaryBodyIrLocalIsParam(bodyIR.localSlots[targetSlot]):
            let _ = PrimaryBodyIrNodeEvalMissAt("call_target_kind")
            return false
    var argValueNodes: int32[]
    if !PrimaryBodyIrCollectArgLinkValueNodes(
        lowering.typedIr,
        arenamod.ArenaArrayInt32Get(lowering.typedIr.arena,
                                     lowering.typedIr.nodes2_operand0NodeIndexs,
                                     nodeIndex),
        argValueNodes):
        let _ = PrimaryBodyIrNodeEvalMissAt("call_arg_chain")
        return false
    var nodeTargetSourcePath = ""
    var nodeTargetName = ""
    var nodeTargetSignatureLine: int32
    var nodeTargetImportc: bool
    var callResultType = ""
    if !PrimaryBodyIrExactCallNodeAuthority(lowering.typedIr,
                                             nodeIndex,
                                             nodeTargetSourcePath,
                                             nodeTargetName,
                                             nodeTargetSignatureLine,
                                             nodeTargetImportc,
                                             callResultType):
        let _ = PrimaryBodyIrNodeEvalMissAt("call_node_authority")
        return false
    let resolvedResultType = strings.CloneStr(callResultType)
    let resolvedOrdinal = PrimaryBodyIrExactCallNodeOrdinal(irFunction,
                                                             lowering.typedIr,
                                                             nodeIndex,
                                                             argValueNodes.len)
    if resolvedOrdinal < 0 ||
       resolvedOrdinal >= irFunction.callTargets.len ||
       resolvedOrdinal >= irFunction.callTargetSourcePaths.len ||
       resolvedOrdinal >= irFunction.callTargetSignatureLineNumbers.len ||
       resolvedOrdinal >= irFunction.callTargetImportcFlags.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("call_ordinal")
        return false
    if irFunction.callTargets[resolvedOrdinal] != nodeTargetName ||
       !texpr.TypedExprSourcePathsEquivalent(
           irFunction.callTargetSourcePaths[resolvedOrdinal],
           nodeTargetSourcePath) ||
       irFunction.callTargetSignatureLineNumbers[resolvedOrdinal] !=
           nodeTargetSignatureLine ||
       irFunction.callTargetImportcFlags[resolvedOrdinal] != nodeTargetImportc ||
       resolvedResultType != callResultType:
        panic(Fmt"primary: emitted call-node authority drift node={nodeIndex} ordinal={resolvedOrdinal} node_source={nodeTargetSourcePath} node_target={nodeTargetName} node_signature={nodeTargetSignatureLine} node_type={callResultType} ordinal_type={resolvedResultType}")
    if callResultType == "void" && targetSlot >= 0:
        let _ = PrimaryBodyIrNodeEvalMissAt("call_result_type")
        return false
    var stmt: lower.PrimaryObjectIrStatement
    stmt.sourcePath = typedFn.sourcePath
    stmt.functionName = typedFn.functionName
    stmt.lineNumber = lineNumber
    stmt.lineIndent = 0
    stmt.kind = texpr.TypedExprIrStmtLetCall
    stmt.callKind = texpr.TypedExprCallNone
    # 本函数的身份已从 nodeIndex 经 ExactCallNodeAuthority 校验并与注册
    # ordinal 逐字段对齐(:28213),挂回精确 CallExpr 节点:AppendCallArgs 的
    # node 臂与 managed 结果的 ownership 取证(ExactStatementCallResultOwnership)
    # 都只吃这个下标;-1 会让 str/聚合返回在 ownership 门硬 fail。
    stmt.rhsNodeIndex = nodeIndex
    stmt.surfaceText = callHead
    stmt.bindingName = ""
    if targetSlot >= 0:
        stmt.bindingName = bodyIR.localSlots[targetSlot].name
    stmt.resultType = strings.CloneStr(callResultType)
    stmt.conditionKind = texpr.TypedExprIrCondNone
    stmt.conditionLhsText = ""
    stmt.conditionRhsText = ""
    stmt.conditionLiteralText = ""
    stmt.assignRootName = ""
    stmt.assignRootType = ""
    stmt.assignRootSourcePath = ""
    stmt.assignRootGlobalFlag = false
    stmt.assignPlaceKind = texpr.TypedExprPlaceTemporary
    stmt.assignFieldName = ""
    stmt.assignFieldType = ""
    stmt.assignFieldOffsetBytes = 0
    stmt.assignFieldSizeBytes = 0
    stmt.assignValueRootName = ""
    stmt.assignValueRootType = ""
    stmt.assignValueFieldName = ""
    stmt.assignValueFieldType = ""
    stmt.assignValueFieldOffsetBytes = 0
    stmt.assignValueFieldSizeBytes = 0
    stmt.assignValueOpKind = texpr.TypedExprIrOpUnsupported
    stmt.assignValueLhsText = ""
    stmt.assignValueRhsText = ""
    stmt.callCallee = strings.CloneStr(callHeadTail)
    stmt.callTarget = nodeTargetName
    stmt.callTargetSourcePath = nodeTargetSourcePath
    stmt.callTargetSignatureLineNumber = nodeTargetSignatureLine
    stmt.callTargetImportc = nodeTargetImportc
    stmt.callArgCount = argValueNodes.len
    stmt.callArgsText = ""
    stmt.returnRoot = false
    var resultTypeKind: int32
    var resultSizeBytes: int32
    var resultAlignBytes: int32
    let resultSourcePath = stmt.callTargetSourcePath
    if resultSourcePath == "":
        return false
    PrimaryBodyIrNodeTypeShape(lowering.typedIr,
                               resultSourcePath,
                               callResultType,
                               resultTypeKind,
                               resultSizeBytes,
                               resultAlignBytes)
    var discardSretSlot = -1
    if targetSlot < 0:
        # 丢弃返回值：void/寄存器标量直接丢；sret 形（str/聚合）需一个
        # 一次性 sret 缓冲槽承接返回字节（调用约定要求），物化后不读回。
        if callResultType != "void" &&
           (resultTypeKind == coreir.LocalStrTag ||
            resultTypeKind == coreir.LocalAggregateTag):
            if resultSizeBytes <= 0:
                let _ = PrimaryBodyIrNodeEvalMissAt("call_ret_shape")
                return false
            discardSretSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                 slotNames,
                                                                 lowering.typedIr,
                                                                 resultSourcePath,
                                                                 Fmt"#nev{nodeIndex}#discard_sret",
                                                                 callResultType)
            if discardSretSlot < 0 ||
               discardSretSlot >= bodyIR.localSlots.len ||
               PrimaryBodyIrSlotType(bodyIR, discardSretSlot) != resultTypeKind ||
               PrimaryLocalSlotSizeOf(bodyIR.localSlots[discardSretSlot]) < resultSizeBytes:
                let _ = PrimaryBodyIrNodeEvalMissAt("call_ret_shape")
                return false
    elif resultTypeKind == coreir.LocalAggregateTag ||
         targetKind == coreir.LocalAggregateTag:
        # 聚合返回：sret 直写目标槽（与 str 同协议）；目标槽必须同形且容量足够
        if resultTypeKind != coreir.LocalAggregateTag ||
           targetKind != coreir.LocalAggregateTag ||
           resultSizeBytes <= 0 ||
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) < resultSizeBytes:
            let _ = PrimaryBodyIrNodeEvalMissAt("call_ret_shape")
            return false
    elif resultTypeKind == coreir.LocalStrTag || targetKind == coreir.LocalStrTag:
        if resultTypeKind != coreir.LocalStrTag || targetKind != coreir.LocalStrTag:
            let _ = PrimaryBodyIrNodeEvalMissAt("call_ret_shape")
            return false
    elif resultTypeKind == coreir.LocalPtrTag || targetKind == coreir.LocalPtrTag:
        # 指针返回按 8 字节标量处理：仅允许 Ptr/I64 配对（I32 截断、Str 异形拒绝）
        if (resultTypeKind != coreir.LocalPtrTag && resultTypeKind != coreir.LocalI64Tag) ||
           (targetKind != coreir.LocalPtrTag && targetKind != coreir.LocalI64Tag):
            let _ = PrimaryBodyIrNodeEvalMissAt("call_ret_shape")
            return false
    elif resultTypeKind == coreir.LocalF64Tag || targetKind == coreir.LocalF64Tag:
        if resultTypeKind != coreir.LocalF64Tag || targetKind != coreir.LocalF64Tag:
            let _ = PrimaryBodyIrNodeEvalMissAt("call_ret_shape")
            return false
    elif resultTypeKind != coreir.LocalI32Tag &&
         resultTypeKind != coreir.LocalI64Tag:
        let _ = PrimaryBodyIrNodeEvalMissAt("call_ret_shape")
        return false
    # 实参分类与求值（发射前最后的可失败段；节点树由 2b/批次5 保证
    # call-free，求值失败只留下无副作用死操作，可安全落回文本路径）。
    var argTexts: str[]
    argTexts = []
    for argIndex in 0..<argValueNodes.len:
        let argNodeIndex = argValueNodes[argIndex]
        if argNodeIndex < 0 || argNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
            let _ = PrimaryBodyIrNodeEvalMissAt("call_arg_chain")
            return false
        let argParamNameRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_paramNameIds[argNodeIndex])
        let argSurfRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_surfaceTextIds[argNodeIndex])
        let argSrcRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_sourcePathIds[argNodeIndex])
        let argLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[argNodeIndex])
        if !IsOk(argParamNameRes) || !IsOk(argSurfRes) || !IsOk(argSrcRes) || !IsOk(argLitRes):
            return false
        let argParamName = Value(argParamNameRes)
        let argSurfaceText = Value(argSurfRes)
        let argSourcePath = Value(argSrcRes)
        let argLiteralText = Value(argLitRes)
        let targetParamType = PrimaryBodyIrTargetParamType(lowering, stmt, argIndex,
                                                           "node_eval_stmt",
                                                           resolvedOrdinal,
                                                           nodeTargetSourcePath,
                                                           nodeTargetName,
                                                           nodeTargetSignatureLine,
                                                           "")
        # [wall148] var 性第一权威 = 结构列（[wall131] 同源裁定），文本 fallback
        # 仅兜底；判定失真即借用视图实参降级值通道（v6 SIGSEGV 根因）。
        let targetNeedsAddress =
            PrimaryBodyIrTypedParamMutableAt(lowering,
                                              stmt.callTargetSourcePath,
                                              stmt.callTarget,
                                              argIndex) == 1 ||
            PrimaryBodyIrTypeTextIsVarParam(targetParamType)
        if lowering.typedIr.nodes2_opKinds[argNodeIndex] == texpr.TypedExprIrOpParamRef ||
           lowering.typedIr.nodes2_opKinds[argNodeIndex] == texpr.TypedExprIrOpLocalRef:
            var argName = argParamName
            if argName == "":
                argName = strutil.Strip(argSurfaceText)
            if argName == "":
                let _ = PrimaryBodyIrNodeEvalMissAt("call_arg_name")
                return false
            if PrimaryBodyIrFindArgSlot(bodyIR, slotNames, argName) < 0 &&
               !PrimaryBodyIrNameInList(varI32ParamNames, argName):
                if lowering.typedIr.nodes2_opKinds[argNodeIndex] == texpr.TypedExprIrOpLocalRef && !targetNeedsAddress:
                    let globalArgSlot = PrimaryBodyIrNodeEvalGlobalLoadSlot(bodyIR,
                                                                            slotNames,
                                                                            lowering.typedIr,
                                                                            argSourcePath,
                                                                            argName)
                    if globalArgSlot >= 0 && globalArgSlot < bodyIR.localSlots.len:
                        add(argTexts, share(bodyIR.localSlots[globalArgSlot].name))
                        continue
                if lowering.typedIr.nodes2_opKinds[argNodeIndex] == texpr.TypedExprIrOpLocalRef && targetNeedsAddress:
                    # 全局 seq/聚合按 var 形参传地址：物化全局头地址进 #vfaddr
                    # Ptr 槽（GlobalLoad address-of 模式，镜像 GlobalSeqAddressSlot），
                    # 按值传指针——下游 AppendCallArgs 16618 #vfaddr 协议承接。
                    let globalAddrDestSlot = PrimaryBodyIrGlobalAggregateDestSlot(bodyIR,
                                                                                 slotNames,
                                                                                 lowering.typedIr,
                                                                                 argSourcePath,
                                                                                 argName)
                    if globalAddrDestSlot >= 0 && globalAddrDestSlot < bodyIR.localSlots.len:
                        let globalVarArgAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                 slotNames,
                                                                                 Fmt"#vfaddr_g{nodeIndex}#{argIndex}",
                                                                                 coreir.LocalPtrTag)
                        if globalVarArgAddrSlot >= 0 && globalVarArgAddrSlot < bodyIR.localSlots.len:
                            var globalVarArgAddrOp: coreir.BodyOp
                            globalVarArgAddrOp.kind = coreir.BodyOpGlobalLoadTag
                            globalVarArgAddrOp.target = globalVarArgAddrSlot
                            add(globalVarArgAddrOp.operands, globalAddrDestSlot)
                            add(globalVarArgAddrOp.operands, 1)
                            let _ = coreir.BodyIRAppendOp(bodyIR, globalVarArgAddrOp)
                            add(argTexts, share(bodyIR.localSlots[globalVarArgAddrSlot].name))
                            continue
                let _ = PrimaryBodyIrNodeEvalMissAt("call_arg_slot")
                return false
            add(argTexts, argName)
        elif lowering.typedIr.nodes2_opKinds[argNodeIndex] == texpr.TypedExprIrOpStrLit ||
             lowering.typedIr.nodes2_opKinds[argNodeIndex] == texpr.TypedExprIrOpBoolLit:
            # 字面量按文本传入：保留既有 cstring/str 字面量与 const
            # true/false 协议（由被调形参类型裁决）。
            if targetNeedsAddress:
                let _ = PrimaryBodyIrNodeEvalMissAt("call_var_arg")
                return false
            add(argTexts, argLiteralText)
        elif lowering.typedIr.nodes2_opKinds[argNodeIndex] == texpr.TypedExprIrOpAddrOf:
            # `&place` 取址实参（如 atomicLoadI32(&a.value)）：operand0 是 place
            # 子节点（字段路径）。求 root 槽 + 总偏移，发 base+offset 进 #vfaddr_ao
            # Ptr 槽，按值传指针——与 var 形参字段取址（17827 分支）同款协议。被调
            # 形参类型是 ptr，调用发射走既有 call op，不新增原子特判。
            var addrOfOk = false
            # `&FunctionName` 取顶层函数符号地址实参（如 thread.StartPtr(&worker,
            # ...)）：operand0 是 FuncRef 叶子。建函数地址 GlobalAddress 槽，按
            # 槽名传入——AppendCallArgs 见 GlobalAddress 槽发 GlobalAddress 实参，
            # reloc 阶段把函数符号 adrp+add 进寄存器。
            if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, argNodeIndex) >= 0 &&
               arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, argNodeIndex) < lowering.typedIr.nodes2_nodeIndexs.len &&
               lowering.typedIr.nodes2_opKinds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, argNodeIndex)] == texpr.TypedExprIrOpFuncRef:
                let addrOfFuncLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, argNodeIndex)])
                if !IsOk(addrOfFuncLitRes):
                    return false
                let addrOfFuncSlot = PrimaryBodyIrFuncRefAddressSlot(bodyIR,
                                                                     slotNames,
                                                                     lowering,
                                                                     argSourcePath,
                                                                     Value(addrOfFuncLitRes))
                if addrOfFuncSlot >= 0:
                    add(argTexts, share(bodyIR.localSlots[addrOfFuncSlot].name))
                    addrOfOk = true
                if !addrOfOk:
                    let _ = PrimaryBodyIrNodeEvalMissAt("call_addr_of_func_ref")
                    return false
                continue
            var addrOfRootSlot: int32
            var addrOfTotalOffset: int32
            if PrimaryBodyIrAddrOfPlaceRootInfo(bodyIR,
                                                slotNames,
                                                lowering.typedIr,
                                                arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, argNodeIndex),
                                                addrOfRootSlot,
                                                addrOfTotalOffset):
                let addrOfAddrSlot = PrimaryBodyIrMaterializeAddrOfPlaceSlot(
                    bodyIR,
                    slotNames,
                    lowering.typedIr,
                    arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, argNodeIndex),
                    addrOfRootSlot,
                    addrOfTotalOffset,
                    Fmt"#vfaddr_ao{nodeIndex}#{argIndex}")
                if addrOfAddrSlot >= 0:
                    add(argTexts, share(bodyIR.localSlots[addrOfAddrSlot].name))
                    addrOfOk = true
            if !addrOfOk:
                let _ = PrimaryBodyIrNodeEvalMissAt("call_addr_of_arg")
                return false
        elif targetNeedsAddress:
            # 批次6b：var 形参的字段实参——物化字段地址（聚合基址 + 偏移
            # 常量）入 #vfaddr 指针槽，调用参装载按值传指针（AppendCallArgs
            # 名协议）。仅支持根为 ParamRef/LocalRef 的单级字段：多级根求值
            # 产物是副本，取址会丢写回。
            var varArgOk = false
            var varArgRootSlot: int32
            var varArgTotalOffset: int32
            if PrimaryBodyIrVarArgFieldPathInfo(bodyIR,
                                                slotNames,
                                                lowering.typedIr,
                                                argNodeIndex,
                                                varArgRootSlot,
                                                varArgTotalOffset):
                # [wall148] var 借用视图形参根先解一跳句柄槽得对象基址。
                let varArgBaseSlot = PrimaryBodyIrMaterializeVarBorrowBase(
                    bodyIR,
                    slotNames,
                    lowering.typedIr,
                    argNodeIndex,
                    varArgRootSlot,
                    Fmt"#vfaddr{nodeIndex}#{argIndex}")
                if varArgBaseSlot < 0:
                    let _ = PrimaryBodyIrNodeEvalMissAt("call_var_arg")
                    return false
                let varArgOffSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                    slotNames,
                                                                    Fmt"#vfaddr{nodeIndex}#{argIndex}#off",
                                                                    coreir.LocalI64Tag,
                                                                    varArgTotalOffset)
                let varArgAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                   slotNames,
                                                                   Fmt"#vfaddr{nodeIndex}#{argIndex}",
                                                                   coreir.LocalPtrTag)
                if varArgOffSlot >= 0 && varArgAddrSlot >= 0:
                    var varArgAddrOp: coreir.BodyOp
                    varArgAddrOp.kind = coreir.BodyOpBinOpTag
                    varArgAddrOp.target = varArgAddrSlot
                    add(varArgAddrOp.operands, coreir.LocalI64Tag)
                    add(varArgAddrOp.operands, int32(texpr.TypedExprIrOpI32Add))
                    add(varArgAddrOp.operands, varArgBaseSlot)
                    add(varArgAddrOp.operands, varArgOffSlot)
                    let _ = coreir.BodyIRAppendOp(bodyIR, varArgAddrOp)
                    add(argTexts, share(bodyIR.localSlots[varArgAddrSlot].name))
                    varArgOk = true
            if !varArgOk:
                var varIdxRootSlot: int32
                var varIdxHeaderOffset: int32
                var varIdxElemSize: int32
                var varIdxNode: int32
                if PrimaryBodyIrVarArgIndexInfo(bodyIR,
                                                slotNames,
                                                lowering.typedIr,
                                                argNodeIndex,
                                                varIdxRootSlot,
                                                varIdxHeaderOffset,
                                                varIdxElemSize,
                                                varIdxNode):
                    let varIdxValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering,

                                                                share(typedFn),
                                                                irFunction,
                                                                varIdxNode,
                                                                callOrdinal)
                    if varIdxValueSlot >= 0 &&
                       PrimaryBodyIrSlotType(bodyIR, varIdxValueSlot) == coreir.LocalI32Tag:
                        let varIdxBufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                          slotNames,
                                                                          Fmt"#vfidx{nodeIndex}#{argIndex}#buf",
                                                                          coreir.LocalPtrTag)
                        let varIdxEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                            slotNames,
                                                                            Fmt"#vfidx{nodeIndex}#{argIndex}#esz",
                                                                            coreir.LocalI64Tag,
                                                                            varIdxElemSize)
                        let varIdxAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                           slotNames,
                                                                           Fmt"#vfaddr_i{nodeIndex}#{argIndex}",
                                                                           coreir.LocalPtrTag)
                        if varIdxBufSlot >= 0 && varIdxEszSlot >= 0 && varIdxAddrSlot >= 0:
                            var varIdxBufLoadOp: coreir.BodyOp
                            varIdxBufLoadOp.kind = coreir.BodyOpFieldLoadTag
                            varIdxBufLoadOp.target = varIdxBufSlot
                            add(varIdxBufLoadOp.operands, varIdxRootSlot)
                            add(varIdxBufLoadOp.operands, varIdxBufSlot)
                            add(varIdxBufLoadOp.operands, varIdxHeaderOffset + 8)
                            add(varIdxBufLoadOp.operands, 8)
                            let _ = coreir.BodyIRAppendOp(bodyIR, varIdxBufLoadOp)
                            var varIdxAddrOp: coreir.BodyOp
                            varIdxAddrOp.kind = coreir.BodyOpBinOpTag
                            varIdxAddrOp.target = varIdxAddrSlot
                            add(varIdxAddrOp.operands, coreir.LocalI64Tag)
                            add(varIdxAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
                            add(varIdxAddrOp.operands, varIdxValueSlot)
                            add(varIdxAddrOp.operands, varIdxEszSlot)
                            add(varIdxAddrOp.operands, varIdxBufSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, varIdxAddrOp)
                            add(argTexts, share(bodyIR.localSlots[varIdxAddrSlot].name))
                            varArgOk = true
            if !varArgOk:
                var varIfRootSlot: int32
                var varIfHeaderOffset: int32
                var varIfElemSize: int32
                var varIfIdxNode: int32
                var varIfFieldOffset: int32
                if PrimaryBodyIrVarArgIndexedFieldInfo(bodyIR,
                                                       slotNames,
                                                       lowering.typedIr,
                                                       argNodeIndex,
                                                       varIfRootSlot,
                                                       varIfHeaderOffset,
                                                       varIfElemSize,
                                                       varIfIdxNode,
                                                       varIfFieldOffset):
                    let varIfIdxValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,

                                                                  share(typedFn),
                                                                  irFunction,
                                                                  varIfIdxNode,
                                                                  callOrdinal)
                    if varIfIdxValueSlot >= 0 &&
                       PrimaryBodyIrSlotType(bodyIR, varIfIdxValueSlot) == coreir.LocalI32Tag:
                        let varIfBufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                         slotNames,
                                                                         Fmt"#vfif{nodeIndex}#{argIndex}#buf",
                                                                         coreir.LocalPtrTag)
                        let varIfEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                           slotNames,
                                                                           Fmt"#vfif{nodeIndex}#{argIndex}#esz",
                                                                           coreir.LocalI64Tag,
                                                                           varIfElemSize)
                        let varIfElemAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                              slotNames,
                                                                              Fmt"#vfif_e{nodeIndex}#{argIndex}",
                                                                              coreir.LocalPtrTag)
                        let varIfFieldOffSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                                slotNames,
                                                                                Fmt"#vfif{nodeIndex}#{argIndex}#foff",
                                                                                coreir.LocalI64Tag,
                                                                                varIfFieldOffset)
                        let varIfAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                          slotNames,
                                                                          Fmt"#vfaddr_if{nodeIndex}#{argIndex}",
                                                                          coreir.LocalPtrTag)
                        if varIfBufSlot >= 0 && varIfEszSlot >= 0 && varIfElemAddrSlot >= 0 && varIfFieldOffSlot >= 0 && varIfAddrSlot >= 0:
                            var varIfBufLoadOp: coreir.BodyOp
                            varIfBufLoadOp.kind = coreir.BodyOpFieldLoadTag
                            varIfBufLoadOp.target = varIfBufSlot
                            add(varIfBufLoadOp.operands, varIfRootSlot)
                            add(varIfBufLoadOp.operands, varIfBufSlot)
                            add(varIfBufLoadOp.operands, varIfHeaderOffset + 8)
                            add(varIfBufLoadOp.operands, 8)
                            let _ = coreir.BodyIRAppendOp(bodyIR, varIfBufLoadOp)
                            var varIfElemAddrOp: coreir.BodyOp
                            varIfElemAddrOp.kind = coreir.BodyOpBinOpTag
                            varIfElemAddrOp.target = varIfElemAddrSlot
                            add(varIfElemAddrOp.operands, coreir.LocalI64Tag)
                            add(varIfElemAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
                            add(varIfElemAddrOp.operands, varIfIdxValueSlot)
                            add(varIfElemAddrOp.operands, varIfEszSlot)
                            add(varIfElemAddrOp.operands, varIfBufSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, varIfElemAddrOp)
                            var varIfAddrOp: coreir.BodyOp
                            varIfAddrOp.kind = coreir.BodyOpBinOpTag
                            varIfAddrOp.target = varIfAddrSlot
                            add(varIfAddrOp.operands, coreir.LocalI64Tag)
                            add(varIfAddrOp.operands, int32(texpr.TypedExprIrOpI32Add))
                            add(varIfAddrOp.operands, varIfElemAddrSlot)
                            add(varIfAddrOp.operands, varIfFieldOffSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, varIfAddrOp)
                            add(argTexts, share(bodyIR.localSlots[varIfAddrSlot].name))
                            varArgOk = true
            if !varArgOk:
                # `a[i].b[j].c` 双下标链 var seq 实参：单级 VarArg* 解不出（根落在
                # IndexGet 上），复用 SeqRefIndexedChain 逐段物化 buf 装载 + 元素
                # 寻址，得 (seqHeader 基址槽, 头偏移)，再 base+offset 取 seq header
                # 地址按值传指针——与上面 VarArgFieldPath 分支同款按址协议。
                var sricArgRootSlot: int32
                var sricArgHeaderOffset: int32
                var sricArgTypeText = ""
                if PrimaryBodyIrSeqRefIndexedChain(bodyIR,
                                                   slotNames,
                                                   varI32ParamNames,
                                                   lowering.typedIr,
                                                   typedFn,
                                                   irFunction,
                                                   argSourcePath,
                                                   lineNumber,
                                                   argSurfaceText,
                                                   sricArgRootSlot,
                                                   sricArgHeaderOffset,
                                                   sricArgTypeText,
                                                   callOrdinal):
                    let sricArgOffSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                         slotNames,
                                                                         Fmt"#vfaddr_sric{nodeIndex}#{argIndex}#off",
                                                                         coreir.LocalI64Tag,
                                                                         sricArgHeaderOffset)
                    let sricArgAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                        slotNames,
                                                                        Fmt"#vfaddr_sric{nodeIndex}#{argIndex}",
                                                                        coreir.LocalPtrTag)
                    if sricArgOffSlot >= 0 && sricArgAddrSlot >= 0:
                        var sricArgAddrOp: coreir.BodyOp
                        sricArgAddrOp.kind = coreir.BodyOpBinOpTag
                        sricArgAddrOp.target = sricArgAddrSlot
                        add(sricArgAddrOp.operands, coreir.LocalI64Tag)
                        add(sricArgAddrOp.operands, int32(texpr.TypedExprIrOpI32Add))
                        add(sricArgAddrOp.operands, sricArgRootSlot)
                        add(sricArgAddrOp.operands, sricArgOffSlot)
                        let _ = coreir.BodyIRAppendOp(bodyIR, sricArgAddrOp)
                        add(argTexts, share(bodyIR.localSlots[sricArgAddrSlot].name))
                        varArgOk = true
            if !varArgOk:
                let _ = PrimaryBodyIrNodeEvalMissAt("call_var_arg")
                return false
        else:
            let argEvalSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                    slotNames,
                                                    varI32ParamNames,
                                                    lowering,

                                                    share(typedFn),
                                                    irFunction,
                                                    argNodeIndex,
                                                    callOrdinal)
            if argEvalSlot < 0:
                return false
            if argEvalSlot >= bodyIR.localSlots.len ||
               bodyIR.localSlots[argEvalSlot].name == "":
                let _ = PrimaryBodyIrNodeEvalMissAt("call_arg_slot")
                return false
            add(argTexts, share(bodyIR.localSlots[argEvalSlot].name))
    stmt.callArgsText = strutil.Join(argTexts, ",")
    var resultSlot = targetSlot
    if targetSlot < 0 && discardSretSlot >= 0:
        resultSlot = discardSretSlot
    if targetSlot >= 0 && resultTypeKind != targetKind:
        resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                        slotNames,
                                                        lowering.typedIr,
                                                        resultSourcePath,
                                                        Fmt"{bodyIR.localSlots[targetSlot].name}#call_cast_value#{lineNumber}",
                                                        callResultType)
        if resultSlot < 0:
            let _ = PrimaryBodyIrNodeEvalMissAt("call_ret_cast_slot")
            return false
    var nodeCallBlockStart: int32 = -1
    let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                      slotNames,
                                      lowering,

                                      typedFn,
                                      irFunction,
                                      stmt,
                                      resultSlot,
                                      varI32ParamNames,
                                      callOrdinal,
                                      nodeCallBlockStart)
    primaryBodyIrNodeEvalCallEmitCount = primaryBodyIrNodeEvalCallEmitCount + 1
    if targetSlot >= 0 && resultSlot != targetSlot:
        var callExprCopyOp: coreir.BodyOp
        callExprCopyOp.kind = coreir.BodyOpCopyLocalTag
        callExprCopyOp.target = targetSlot
        add(callExprCopyOp.operands, resultSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, callExprCopyOp)
    return true

# 判别：一个 call-shaped 实参子表达式的 head 是否命名「聚合构造器」——
# head 命名一个聚合（结构体/seq 别名头）类型，且不解析为可见函数（构造器不是
# 函数）。call-arg 物化循环用此区分「嵌套整调用实参」与「构造器临时实参」。
@borrows
fn PrimaryBodyIrCallHeadIsAggregateConstructor(typedIr: texpr.TypedExprIr,
                                               sourcePath: str,
                                               callHead: str): bool =
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        return false
    if PrimaryBodyIrVisibleFunctionIndex(typedIr, sourcePath, callHead) >= 0:
        return false
    var ctorTypeKind: int32
    var ctorSizeBytes: int32
    var ctorAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   callHead,
                                   ctorTypeKind,
                                   ctorSizeBytes,
                                   ctorAlignBytes)
    return ctorTypeKind == coreir.LocalAggregateTag && ctorSizeBytes > 0

# wave3 0-B: seq 别名类型构造头 `my_seq_int32(len:, cap:, buffer:)`
# (hashmaps.cheng hashMap_seq_* = int32[] 等)。头名经 typeDefAlias 折到 `T[]`
# = seq 类型构造 (16B 头重解释), 非函数调用 — 与 Aggregate ctor 同理不得登记为
# 可解析调用目标 (否则幻影 missing_call_target)。仅供 reachability 跳过判定;
# body 物化路径不用 (seq 头构造 ≠ 聚合字段布局)。
@borrows
fn PrimaryBodyIrCallHeadIsSeqAliasConstructor(typedIr: texpr.TypedExprIr,
                                              sourcePath: str,
                                              callHead: str): bool =
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        return false
    if PrimaryBodyIrVisibleFunctionIndex(typedIr, sourcePath, callHead) >= 0:
        return false
    # 严格同源 (Lookup 的全局唯一回退会把撞名真函数误判成构造器 → reachability
    # 丢真目标 → typedIr 覆盖崩)。
    return texpr.TypedExprIrTypeDefAliasIsSameSourceSeq(typedIr,
                                                        sourcePath,
                                                        callHead)

@borrows
fn PrimaryBodyIrFindTopLevelOpenBrace(textRaw: str): int32 =
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    var inString = false
    var inChar = false
    var escaped = false
    for i in 0..<len(textRaw):
        let ch = textRaw[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
            continue
        if inChar:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '\'':
                inChar = false
            continue
        if ch == '"':
            inString = true
        elif ch == '\'':
            inChar = true
        elif ch == '[':
            bracketDepth = bracketDepth + 1
        elif ch == ']':
            bracketDepth = bracketDepth - 1
        elif ch == '(':
            parenDepth = parenDepth + 1
        elif ch == ')':
            parenDepth = parenDepth - 1
        elif ch == '{':
            if bracketDepth == 0 && parenDepth == 0 && braceDepth == 0:
                return i
            braceDepth = braceDepth + 1
        elif ch == '}':
            braceDepth = braceDepth - 1
    return -1

@borrows
fn PrimaryBodyIrFindMatchingBrace(textRaw: str,
                                  openPos: int32): int32 =
    if openPos < 0 || openPos >= len(textRaw) || textRaw[openPos] != '{':
        return -1
    var braceDepth: int32
    var inString = false
    var inChar = false
    var escaped = false
    for i in openPos..<len(textRaw):
        let ch = textRaw[i]
        if inString:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                inString = false
            continue
        if inChar:
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '\'':
                inChar = false
            continue
        if ch == '"':
            inString = true
        elif ch == '\'':
            inChar = true
        elif ch == '{':
            braceDepth = braceDepth + 1
        elif ch == '}':
            braceDepth = braceDepth - 1
            if braceDepth == 0:
                return i
    return -1

@borrows
fn PrimaryBodyIrAppendSeqLiteralToSlot(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       varI32ParamNames: str[],
                                       lowering: var lower.LoweringPlanStub,
                                       typedFn: texpr.TypedExprIrFunction,
                                       irFunction: lower.PrimaryObjectIrFunction,
                                       seqLiteralRaw: str,
                                       seqLiteralNodeIndex: int32,
                                       seqTypeRaw: str,
                                       sourcePath: str,
                                       bodyLineNumber: int32,
                                       targetSlot: int32,
                                       uniqueTag: int32,
                                       callOrdinal: var int32): bool =
    let seqLiteral = strutil.Strip(seqLiteralRaw)
    if seqLiteralNodeIndex < 0 ||
       seqLiteralNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
       lowering.typedIr.nodes2_opKinds[seqLiteralNodeIndex] != texpr.TypedExprIrOpSeqLiteral:
        let panicMsg = Fmt"primary: seq literal lacks exact TypedExpr node function={typedFn.functionName} line={bodyLineNumber} node={seqLiteralNodeIndex}"
        panic(panicMsg)
    if len(seqLiteral) < 2 || seqLiteral[0] != '[':
        return false
    let closePos = texpr.TypedExprFindMatchingBracket(seqLiteral, 0)
    if closePos != len(seqLiteral) - 1:
        return false
    let seqType = texpr.TypedExprStripVarType(seqTypeRaw)
    if !PrimaryBodyIrTypeTextIsDynamicSeq(seqType):
        return false
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalAggregateTag ||
       PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) < 16:
        return false
    let elemType = strutil.Strip(strings.SliceBytes(seqType, 0, len(seqType) - 2))
    if elemType == "":
        return false
    var elemKind: int32
    var elemSize: int32
    var elemAlign: int32
    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                   sourcePath,
                                   elemType,
                                   elemKind,
                                   elemSize,
                                   elemAlign)
    if elemSize <= 0 &&
       len(elemType) >= 2 &&
       strings.SliceBytes(elemType, len(elemType) - 2, 2) == "[]":
        elemKind = coreir.LocalAggregateTag
        elemSize = 16
        elemAlign = 8
    if elemSize <= 0:
        return false
    if !PrimaryBodyIrAppendZeroLocalSlot(bodyIR, slotNames, targetSlot, callOrdinal):
        return false
    let innerText = strutil.Strip(strings.SliceBytes(seqLiteral, 1, len(seqLiteral) - 2))
    if innerText == "":
        return true
    let elemTexts = texpr.TypedExprSplitTopLevelCsv(innerText)
    var seqElemNodeIndexs: int32[]
    if !PrimaryBodyIrCollectArgLinkValueNodes(
            lowering.typedIr,
            arenamod.ArenaArrayInt32Get(lowering.typedIr.arena,
                                         lowering.typedIr.nodes2_operand0NodeIndexs,
                                         seqLiteralNodeIndex),
            seqElemNodeIndexs):
        let panicMsg = Fmt"primary: seq literal exact child chain invalid function={typedFn.functionName} line={bodyLineNumber} node={seqLiteralNodeIndex}"
        panic(panicMsg)
    for elemIndex in 0..<elemTexts.len:
        let elemText = strutil.Strip(elemTexts[elemIndex])
        if elemText == "":
            if elemIndex == elemTexts.len - 1:
                continue
            return false
        var elemSlot: int32 = -1
        let elemCallOpen = texpr.TypedExprFindWholeCallOpenParen(elemText)
        if elemCallOpen > 0:
            let elemCallClose = texpr.TypedExprFindMatchingParen(elemText, elemCallOpen)
            if elemCallClose > elemCallOpen && elemCallClose + 1 == len(elemText):
                if elemIndex >= seqElemNodeIndexs.len:
                    let panicMsg = Fmt"primary: seq literal call element lacks exact child function={typedFn.functionName} line={bodyLineNumber} seq_node={seqLiteralNodeIndex} element={elemIndex}"
                    panic(panicMsg)
                let elemNodeIndex = seqElemNodeIndexs[elemIndex]
                if elemNodeIndex < 0 ||
                   elemNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
                   lowering.typedIr.nodes2_opKinds[elemNodeIndex] != texpr.TypedExprIrOpCallExpr:
                    let panicMsg = Fmt"primary: seq literal call element exact child invalid function={typedFn.functionName} line={bodyLineNumber} seq_node={seqLiteralNodeIndex} element={elemIndex} child={elemNodeIndex}"
                    panic(panicMsg)
                let elemCallSignatureLine = arenamod.ArenaArrayInt32Get(
                    lowering.typedIr.arena,
                    lowering.typedIr.nodes2_callTargetSignatureLineNumbers,
                    elemNodeIndex)
                let elemIsFunctionCall =
                    lowering.typedIr.nodes2_callTargetImportcs[elemNodeIndex] ||
                    elemCallSignatureLine > 0
                elemSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                              slotNames,
                                                              lowering.typedIr,
                                                              sourcePath,
                                                              Fmt"#seq_literal_elem#{uniqueTag}#{elemIndex}",
                                                              elemType)
                if elemSlot < 0:
                    return false
                var elemCtorDone = false
                if elemKind == coreir.LocalAggregateTag &&
                   !elemIsFunctionCall:
                    elemCtorDone = PrimaryBodyIrAppendAggregateConstructorToSlot(bodyIR,
                                                                                 slotNames,
                                                                                 varI32ParamNames,
                                                                                 lowering,

                                                                                 typedFn,
                                                                                 irFunction,
                                                                                 elemText,
                                                                                 elemNodeIndex,
                                                                                 elemType,
                                                                                 sourcePath,
                                                                                 bodyLineNumber,
                                                                                 elemSlot,
                                                                                 uniqueTag * 31 + elemIndex + 1,
                                                                                 callOrdinal)
                if !elemCtorDone && !elemIsFunctionCall:
                    let panicMsg = Fmt"primary: seq literal aggregate call child has neither constructor nor function authority function={typedFn.functionName} line={bodyLineNumber} child={elemNodeIndex}"
                    panic(panicMsg)
                if !elemCtorDone && elemIsFunctionCall &&
                   !PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                           slotNames,
                                                           lowering,

                                                           typedFn,
                                                           irFunction,
                                                           varI32ParamNames,
                                                           elemText,
                                                           elemSlot,
                                                           bodyLineNumber,
                                                           elemNodeIndex,
                                                           callOrdinal):
                    return false
        if elemSlot < 0 &&
           (elemKind == coreir.LocalI32Tag ||
            elemKind == coreir.LocalI64Tag ||
            elemKind == coreir.LocalF64Tag ||
            elemKind == coreir.LocalPtrTag):
            elemSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering.typedIr,
                                                                  typedFn,
                                                                  irFunction,
                                                                  sourcePath,
                                                                  bodyLineNumber,
                                                                  elemText,
                                                                  elemKind)
        if elemSlot < 0 && elemKind == coreir.LocalStrTag && PrimaryBodyIrTextIsStringLiteral(elemText):
            elemSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#seq_literal_str#{uniqueTag}#{elemIndex}",
                                                     coreir.LocalStrTag)
            if elemSlot < 0 ||
               !PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                      slotNames,
                                                      elemText,
                                                      elemSlot,
                                                      callOrdinal):
                return false
        if elemSlot < 0 && texpr.TypedExprTextIsSimpleIdent(elemText):
            elemSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, elemText)
        if elemSlot < 0 || elemSlot >= bodyIR.localSlots.len:
            return false
        # 批 6 W6 门 (C cold_parser.c:42689-42710 同族): str 序列字面量
        # 的非字面量元素 (裸名/字段路径等值源) 若持借用权威 (TypedExpr
        # 冻结 exprClass==Borrowed), 未显式物化 owned 值 → 判词 die。
        # 纯静态串/owned 元素经上方字面量臂/owned 物化已证。字段按
        # Cheng 形态填: def/ownership/kind/slot/source/op_a/b/c 由元素
        # 当前定义行 (发射序末定义) 直读, place/origin 车道在 lowering
        # 触发点未落 → -1 (设计 §6 注)。
        if elemKind == coreir.LocalStrTag &&
           !PrimaryBodyIrTextIsStringLiteral(elemText) &&
           elemIndex < seqElemNodeIndexs.len:
            let w6ElemNode = seqElemNodeIndexs[elemIndex]
            if w6ElemNode >= 0 &&
               w6ElemNode < lowering.typedIr.nodes2_nodeIndexs.len &&
               texpr.TypedExprIrNodeExprClassAt(
                   lowering.typedIr, w6ElemNode) ==
                   texpr.TypedExprExprBorrowed:
                var w6Def: int32 = -1
                var w6Scan = bodyIR.ops.len - 1
                while w6Scan >= 0:
                    if bodyIR.ops[w6Scan].valueDefSlot == elemSlot:
                        w6Def = w6Scan
                        break
                    w6Scan = w6Scan - 1
                var w6Ownership: int32 = -1
                var w6Source: int32 = -1
                var w6OpA: int32 = -1
                var w6OpB: int32 = -1
                var w6OpC: int32 = -1
                if w6Def >= 0:
                    w6Ownership =
                        Int32(bodyIR.ops[w6Def].valueDefOwnership)
                    if bodyIR.ops[w6Def].sourceDefinitionDomain ==
                           coreir.BodyDefinitionDomainBodyOpTag:
                        w6Source = bodyIR.ops[w6Def].sourceDefinitionRow
                    if bodyIR.ops[w6Def].operands.len > 0:
                        w6OpA = bodyIR.ops[w6Def].operands[0]
                    if bodyIR.ops[w6Def].operands.len > 1:
                        w6OpB = bodyIR.ops[w6Def].operands[1]
                    if bodyIR.ops[w6Def].operands.len > 2:
                        w6OpC = bodyIR.ops[w6Def].operands[2]
                exactdefcallauthority.ExactDefCallAuthorityStrSeqBorrowedElementReject(
                    bodyIR.controlFunctionRow, elemIndex, w6Def,
                    w6Ownership, -1, -1,
                    bodyIR.localSlots[elemSlot].typeKind, elemSlot,
                    w6Source, w6OpA, w6OpB, w6OpC)
        if PrimaryLocalSlotSizeOf(bodyIR.localSlots[elemSlot]) < elemSize:
            return false
        let seqLenSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"#seq_literal_len#{uniqueTag}#{elemIndex}",
                                                       coreir.LocalI32Tag)
        let seqElemSizeSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                              slotNames,
                                                              Fmt"#seq_literal_esz#{uniqueTag}#{elemIndex}",
                                                              coreir.LocalI32Tag,
                                                              elemSize)
        let seqElemPtrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"#seq_literal_elem_ptr#{uniqueTag}#{elemIndex}",
                                                           coreir.LocalPtrTag)
        if seqLenSlot < 0 || seqElemSizeSlot < 0 || seqElemPtrSlot < 0:
            return false
        var lenLoadOp: coreir.BodyOp
        lenLoadOp.kind = coreir.BodyOpFieldLoadTag
        lenLoadOp.target = seqLenSlot
        add(lenLoadOp.operands, targetSlot)
        add(lenLoadOp.operands, seqLenSlot)
        add(lenLoadOp.operands, 0)
        add(lenLoadOp.operands, 4)
        let _ = coreir.BodyIRAppendOp(bodyIR, lenLoadOp)
        var growCall: coreir.CallOp
        growCall.targetSymbol = "cheng_seq_set_grow"
        growCall.resultSlot = seqElemPtrSlot
        growCall.resultPassKind = coreir.BodyCallPassStackValueTag
        add(growCall.argSlots, coreir.CallArgSlotAddress(targetSlot))
        add(growCall.argPassKinds, coreir.BodyCallPassParamAddressTag)
        add(growCall.argSlots, seqLenSlot)
        add(growCall.argPassKinds, coreir.BodyCallPassStackValueTag)
        add(growCall.argSlots, seqElemSizeSlot)
        add(growCall.argPassKinds, coreir.BodyCallPassStackValueTag)
        add(bodyIR.callSequence, growCall)
        var growOp: coreir.BodyOp
        growOp.kind = coreir.BodyOpCallTag
        growOp.target = seqElemPtrSlot
        add(growOp.operands, callOrdinal)
        let _ = coreir.BodyIRAppendOp(bodyIR, growOp)
        callOrdinal = callOrdinal + 1
        var elemStoreOp: coreir.BodyOp
        elemStoreOp.kind = coreir.BodyOpFieldStoreTag
        elemStoreOp.target = seqElemPtrSlot
        add(elemStoreOp.operands, seqElemPtrSlot)
        add(elemStoreOp.operands, elemSlot)
        add(elemStoreOp.operands, 0)
        add(elemStoreOp.operands, elemSize)
        let _ = coreir.BodyIRAppendOp(bodyIR, elemStoreOp)
    return true

# 共享核心：把值聚合构造器字面量 `Type(field0: v0, ...)` 物化进一个调用方
# 已建好且类型化为 expectedAggType 的目标槽。语义=校验形状匹配 → 逐字段求值
# （标量/指针经标量求值器、聚合/str 经聚合物化器）→ 零初始化目标槽 → 逐字段
# 按偏移 FieldStore。求值在任何 FieldStore 发射前完成全部校验——一旦发射即不可
# 回落（保证无半构造 debris）。返回位与局部位共用此核心，位别由调用方各自决定
# 目标槽来源（返回=sret 关联的 result 槽；局部=声明槽）与后续 term。
# uniqueTag 用于临时槽命名去重（同一函数内多处构造器各自独立）。
@borrows
fn PrimaryBodyIrAppendAggregateConstructorToSlot(bodyIR: var coreir.BodyIR,
                                                 slotNames: var str[],
                                                 varI32ParamNames: str[],
                                                 lowering: var lower.LoweringPlanStub,
                                                 typedFn: texpr.TypedExprIrFunction,
                                                 irFunction: lower.PrimaryObjectIrFunction,
                                                 ctorExprRaw: str,
                                                 ctorNodeIndex: int32,
                                                 expectedAggType: str,
                                                 sourcePath: str,
                                                 bodyLineNumber: int32,
                                                 targetSlot: int32,
                                                 uniqueTag: int32,
                                                 callOrdinal: var int32): bool =
    primaryAggCtorLastFailIndex = -1
    primaryAggCtorLastFailCode = 0
    if ctorNodeIndex < 0 ||
       ctorNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
       lowering.typedIr.nodes2_opKinds[ctorNodeIndex] != texpr.TypedExprIrOpCallExpr:
        let panicMsg = Fmt"primary: aggregate constructor lacks exact TypedExpr CallExpr function={typedFn.functionName} line={bodyLineNumber} node={ctorNodeIndex}"
        panic(panicMsg)
    let ctorCallSignatureLine = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_callTargetSignatureLineNumbers,
        ctorNodeIndex)
    if lowering.typedIr.nodes2_callTargetImportcs[ctorNodeIndex] ||
       ctorCallSignatureLine > 0:
        return false
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        primaryAggCtorLastFailIndex = -1
        primaryAggCtorLastFailCode = 1
        return false
    let ctorExpr = strutil.Strip(ctorExprRaw)
    if len(ctorExpr) <= 0:
        primaryAggCtorLastFailIndex = -1
        primaryAggCtorLastFailCode = 2
        return false
    var ctorHead = ""
    var ctorArgsText = ""
    let openPos = texpr.TypedExprFindWholeCallOpenParen(ctorExpr)
    if openPos > 0:
        let closePos = texpr.TypedExprFindMatchingParen(ctorExpr, openPos)
        if closePos <= openPos || closePos + 1 != len(ctorExpr):
            primaryAggCtorLastFailIndex = -1
            primaryAggCtorLastFailCode = 4
            return false
        ctorHead = strutil.Strip(strings.SliceBytes(ctorExpr, 0, openPos))
        ctorArgsText = strutil.Strip(strings.SliceBytes(ctorExpr,
                                                        openPos + 1,
                                                        closePos - openPos - 1))
    else:
        let braceOpenPos = PrimaryBodyIrFindTopLevelOpenBrace(ctorExpr)
        if braceOpenPos <= 0:
            primaryAggCtorLastFailIndex = -1
            primaryAggCtorLastFailCode = 3
            return false
        let braceClosePos = PrimaryBodyIrFindMatchingBrace(ctorExpr, braceOpenPos)
        if braceClosePos <= braceOpenPos || braceClosePos + 1 != len(ctorExpr):
            primaryAggCtorLastFailIndex = -1
            primaryAggCtorLastFailCode = 4
            return false
        ctorHead = strutil.Strip(strings.SliceBytes(ctorExpr, 0, braceOpenPos))
        ctorArgsText = strutil.Strip(strings.SliceBytes(ctorExpr,
                                                        braceOpenPos + 1,
                                                        braceClosePos - braceOpenPos - 1))
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(ctorHead):
        primaryAggCtorLastFailIndex = -1
        primaryAggCtorLastFailCode = 5
        return false
    let exactOptionNone = PrimaryBodyIrIsExactOptionNoneConstruct(ctorHead,
                                                                  ctorArgsText,
                                                                  expectedAggType)
    # 构造器/函数判定只消费上方 CallExpr 的 target signature/importc authority。
    # 目标聚合型须为聚合，且 head 命名的类型形状与之精确一致。
    var aggTypeKind: int32
    var aggSizeBytes: int32
    var aggAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                   sourcePath,
                                   expectedAggType,
                                   aggTypeKind,
                                   aggSizeBytes,
                                   aggAlignBytes)
    if aggTypeKind != coreir.LocalAggregateTag || aggSizeBytes <= 0:
        primaryAggCtorLastFailIndex = -1
        primaryAggCtorLastFailCode = 8
        return false
    if exactOptionNone:
        if PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalAggregateTag ||
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) < aggSizeBytes:
            primaryAggCtorLastFailIndex = -1
            primaryAggCtorLastFailCode = 11
            return false
        return PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                slotNames,
                                                targetSlot,
                                                callOrdinal)
    var ctorTypeKind: int32
    var ctorSizeBytes: int32
    var ctorAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                   sourcePath,
                                   ctorHead,
                                   ctorTypeKind,
                                   ctorSizeBytes,
                                   ctorAlignBytes)
    if ctorTypeKind != coreir.LocalAggregateTag || ctorSizeBytes != aggSizeBytes:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=agg_ctor_shape_mismatch expectedAggType={expectedAggType} aggTypeKind={aggTypeKind} aggSizeBytes={aggSizeBytes} ctorHead={ctorHead} ctorTypeKind={ctorTypeKind} ctorSizeBytes={ctorSizeBytes}")
        primaryAggCtorLastFailIndex = -1
        primaryAggCtorLastFailCode = 9
        return false
    # 目标槽须为等宽聚合槽。
    if PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalAggregateTag ||
       PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) < aggSizeBytes:
        primaryAggCtorLastFailIndex = -1
        primaryAggCtorLastFailCode = 11
        return false
    # 字段元数据按字段宿主类型查；若 head 是类型别名（如 seq_string = str[]），
    # 用别名目标作为宿主，使 `len/cap/buffer` 等 seq 头字段可被查到。
    # Take would consume ctorHead before the NormalizeTypeText uses below.
    var ctorFieldOwnerType = strings.CloneStr(ctorHead)
    let ctorAliasTarget = texpr.TypedExprIrLookupTypeDefAliasTargetType(lowering.typedIr,
                                                                        sourcePath,
                                                                        texpr.TypedExprNormalizeTypeText(ctorHead))
    if ctorAliasTarget != "" &&
       texpr.TypedExprNormalizeTypeText(ctorAliasTarget) != texpr.TypedExprNormalizeTypeText(ctorHead):
        ctorFieldOwnerType = ctorAliasTarget
    if len(ctorArgsText) <= 0:
        # Zero-arg aggregate constructor `Type()` = whole-aggregate default (zero)
        # initialization, not a field-by-field ctor. Every shape/identity guard
        # above already proved ctorHead is a genuine aggregate type constructor
        # (plain ident, NOT a visible function) whose layout exactly matches the
        # caller's target aggregate slot, so zero-fill the slot in place. Mirrors
        # AppendCallOp's ctor_call_zeroinit (~17446) and the field-store zero-arg
        # ctor fallback; closes `add(seq, Type())` seq-of-aggregate zero-arg
        # element 631 0-op (e.g. lowering_plan.cheng:3089
        # `add(loweringParallelResults, PrimaryObjectIrFunction())`). The empty-args
        # gate is exact: a named-field ctor `Type(field: v)` carries non-empty args
        # and still walks the field-store path below.
        return PrimaryBodyIrAppendZeroLocalSlot(bodyIR, slotNames, targetSlot, callOrdinal)
    let ctorItems = texpr.TypedExprSplitTopLevelCsv(ctorArgsText)
    if ctorItems.len <= 0:
        primaryAggCtorLastFailIndex = -1
        primaryAggCtorLastFailCode = 10
        return false
    # 预校验阶段：所有字段须命名、字段元数据可查、字段类标为标量/指针/聚合/str、
    # 值可求值为尺寸匹配的槽。任一不满足即整体让位（不发射）。
    var fieldValueSlots: int32[]
    var fieldOffsets: int32[]
    var fieldSizes: int32[]
    for itemIndex in 0..<ctorItems.len:
        let item = strutil.Strip(ctorItems[itemIndex])
        if item == "":
            # Skip trailing-empty: TypedExprSplitTopLevelCsv keeps the empty
            # fragment after a trailing comma in struct literals (e.g.
            # CompilerCsgTypedIrStatementFromSoA compiler_csg.cheng:3032-3092
            # has 57 fields + trailing comma → 58 items, item[57]="").
            # Generic root-cause fix lives in TypedExprSplitTopLevelCsv
            # (typed_expr.cheng, op-lane domain); this surgical guard handles
            # the consumer side. Any non-trailing empty item is still rejected.
            if itemIndex == ctorItems.len - 1:
                continue
            primaryAggCtorLastFailIndex = itemIndex
            primaryAggCtorLastFailCode = 70
            return false
        let colonPos = texpr.TypedExprFindTopLevelTextToken(item, ":")
        if colonPos <= 0:
            primaryAggCtorLastFailIndex = itemIndex
            primaryAggCtorLastFailCode = 71
            return false
        let fieldName = strutil.Strip(strings.SliceBytes(item, 0, colonPos))
        let valueText = strutil.Strip(strings.SliceBytes(item,
                                                         colonPos + 1,
                                                         len(item) - colonPos - 1))
        if fieldName == "" || valueText == "":
            primaryAggCtorLastFailIndex = itemIndex
            primaryAggCtorLastFailCode = 20
            return false
        var fieldType: str
        var fieldOffsetBytes: int32
        var fieldSizeBytes: int32
        var fieldAlignBytes: int32
        if !PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                               sourcePath,
                                               ctorFieldOwnerType,
                                               fieldName,
                                               fieldType,
                                               fieldOffsetBytes,
                                               fieldSizeBytes,
                                               fieldAlignBytes):
            primaryAggCtorLastFailIndex = itemIndex
            primaryAggCtorLastFailCode = 21
            return false
        var fieldKind: int32
        var fieldShapeSize: int32
        var fieldShapeAlign: int32
        PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                       sourcePath,
                                       fieldType,
                                       fieldKind,
                                       fieldShapeSize,
                                       fieldShapeAlign)
        if fieldSizeBytes <= 0:
            fieldSizeBytes = fieldShapeSize
        if fieldSizeBytes <= 0:
            primaryAggCtorLastFailIndex = itemIndex
            primaryAggCtorLastFailCode = 22
            return false
        var valueSlot: int32 = -1
        let fieldValueNodeIndex = PrimaryBodyIrCallArgNodeIndexAt(lowering.typedIr,
                                                                  ctorNodeIndex,
                                                                  itemIndex)
        if fieldKind == coreir.LocalI32Tag ||
           fieldKind == coreir.LocalI64Tag ||
           fieldKind == coreir.LocalF64Tag ||
           fieldKind == coreir.LocalPtrTag:
            # 标量/指针/f64 字段：标量求值器 → 等宽 FieldStore。f64 走同一
            # 字节拷贝 FieldStore(8B, 槽=栈内存, 发射器 kind 无关), 此前落
            # else 分支 failCode=50 (connectionInfo `score: float64` 801 根)。
            valueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering.typedIr,
                                                                   share(typedFn),
                                                                   irFunction,
                                                                   sourcePath,
                                                                   bodyLineNumber,
                                                                   valueText,
                                                                   fieldKind)
            if valueSlot < 0:
                # 标量/指针字段值是对可见函数的整调用（`Ok[T](makeX(...))` 的 i32/i64/ptr
                # 字段 payload 内含真调用）：ContextScalarValueSlotForText 不认领整调用→
                # valueSlot=-1→上抛 801 bail。镜像聚合/str 臂的整调用物化（19581）：建
                # fieldType 定形标量槽，经 AppendWholeCallExprToSlot 物化调用结果写入。
                let scalarCallOpen = texpr.TypedExprFindWholeCallOpenParen(valueText)
                if scalarCallOpen > 0:
                    let scalarCallClose = texpr.TypedExprFindMatchingParen(valueText, scalarCallOpen)
                    if scalarCallClose > scalarCallOpen && scalarCallClose + 1 == len(valueText):
                        let scalarCallHead = strutil.Strip(strings.SliceBytes(valueText, 0, scalarCallOpen))
                        if texpr.TypedExprCallHeadIsPlainQualifiedIdent(scalarCallHead):
                            if fieldValueNodeIndex < 0 ||
                               fieldValueNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
                               lowering.typedIr.nodes2_opKinds[fieldValueNodeIndex] != texpr.TypedExprIrOpCallExpr:
                                let panicMsg = Fmt"primary: aggregate scalar call field lacks exact child function={typedFn.functionName} line={bodyLineNumber} ctor_node={ctorNodeIndex} field={itemIndex} child={fieldValueNodeIndex}"
                                panic(panicMsg)
                            if !lowering.typedIr.nodes2_callTargetImportcs[fieldValueNodeIndex] &&
                               arenamod.ArenaArrayInt32Get(
                                   lowering.typedIr.arena,
                                   lowering.typedIr.nodes2_callTargetSignatureLineNumbers,
                                   fieldValueNodeIndex) <= 0:
                                let panicMsg = Fmt"primary: aggregate scalar call child lacks exact function authority function={typedFn.functionName} line={bodyLineNumber} child={fieldValueNodeIndex}"
                                panic(panicMsg)
                            let scalarCallSlotName = strutil.Join(["#ctor_scalar_call#",
                                                                   strings.CloneStr(typedFn.functionName),
                                                                   "#",
                                                                   strings.IntToStr(uniqueTag),
                                                                   "#",
                                                                   strings.IntToStr(itemIndex)], "")
                            let scalarCallSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                                    slotNames,
                                                                                    lowering.typedIr,
                                                                                    sourcePath,
                                                                                    scalarCallSlotName,
                                                                                    fieldType)
                            if scalarCallSlot >= 0 &&
                               PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                                      slotNames,
                                                                      lowering,

                                                                      typedFn,
                                                                      irFunction,
                                                                      varI32ParamNames,
                                                                      valueText,
                                                                      scalarCallSlot,
                                                                      bodyLineNumber,
                                                                      fieldValueNodeIndex,
                                                                      callOrdinal):
                                valueSlot = scalarCallSlot
        elif fieldKind == coreir.LocalStrTag ||
             fieldKind == coreir.LocalAggregateTag:
            # 聚合/str 字段：值须物化为栈上等宽聚合槽，再经宽 FieldStore 拷入。
            # 值形态三类：整调用（含嵌套构造器）、简单字段路径、裸局部/形参名。
            if fieldKind == coreir.LocalAggregateTag &&
               PrimaryBodyIrTypeTextIsDynamicSeq(fieldType) &&
               len(valueText) >= 2 &&
               valueText[0] == '[':
                let seqLitSlotName = strutil.Join(["#ctor_seq_lit#",
                                                   strings.CloneStr(typedFn.functionName),
                                                   "#",
                                                   strings.IntToStr(uniqueTag),
                                                   "#",
                                                   strings.IntToStr(itemIndex)], "")
                let seqLitSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                    slotNames,
                                                                    lowering.typedIr,
                                                                    sourcePath,
                                                                    seqLitSlotName,
                                                                    fieldType)
                if seqLitSlot >= 0 &&
                   PrimaryBodyIrAppendSeqLiteralToSlot(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       lowering,

                                                       typedFn,
                                                       irFunction,
                                                       valueText,
                                                       fieldValueNodeIndex,
                                                       fieldType,
                                                       sourcePath,
                                                       bodyLineNumber,
                                                       seqLitSlot,
                                                       uniqueTag * 31 + itemIndex + 1,
                                                       callOrdinal):
                    valueSlot = seqLitSlot
            var qcsStrConstLit: str
            if valueSlot < 0 && fieldKind == coreir.LocalStrTag:
                qcsStrConstLit = PrimaryBodyIrCanonicalConstStringLiteral(lowering.typedIr,
                                                                          sourcePath,
                                                                          valueText)
                # 同模块无限定 str const 字段值 (如 `schema: MediaAssetLifecycleSchema`,
                # 常量与 ctor 同源文件声明、无 `module.` 前缀)：上面的 Qualified 分支要求
                # valueText 含点号限定符, 裸标识符必空手而归。裸名先查本源文件自身声明
                # 的 const（sourcePath==targetSourcePath 场景, 复用既有单声明者去重的
                # LookupSourceConstStrLiteral, 非本文件声明/撞名一律返回 "" 维持 poison）。
                # 守卫: valueText 若已解析为局部/形参绑定（PrimaryBodyIrFindArgSlot 命中,
                # 与下方 27634 行「裸局部/形参名」分支同一名字空间), 运行时绑定优先,
                # const 回退让路——否则局部/形参与同文件 str const 撞名时, const
                # 字面量会静默顶替运行时真值 (对抗复核实测: 形参与同文件 const 撞名时
                # 字段读出 const 字面量而非调用方传入值, rc=0 无诊断)。
                if qcsStrConstLit == "" &&
                   parser.ParserIdentPrefix(valueText) == valueText &&
                   PrimaryBodyIrFindArgSlot(bodyIR, slotNames, valueText) < 0:
                    qcsStrConstLit = PrimaryBodyIrCanonicalConstStringLiteral(lowering.typedIr,
                                                                              sourcePath,
                                                                              valueText)
            let aggValueOpen = texpr.TypedExprFindWholeCallOpenParen(valueText)
            var aggWholeCall = false
            if aggValueOpen > 0:
                let aggValueClose = texpr.TypedExprFindMatchingParen(valueText, aggValueOpen)
                if aggValueClose > aggValueOpen && aggValueClose + 1 == len(valueText):
                    let aggCallHead = strutil.Strip(strings.SliceBytes(valueText, 0, aggValueOpen))
                    if texpr.TypedExprCallHeadIsPlainQualifiedIdent(aggCallHead):
                        aggWholeCall = true
            if valueSlot < 0 && aggWholeCall:
                # 嵌套整调用值：先建等宽聚合槽。若 head 解析为构造器（非函数）则
                # 递归走本核心物化字段（嵌套构造器），否则走整调用物化器。
                let aggCallSlotName = strutil.Join(["#ctor_agg_call#",
                                                    strings.CloneStr(typedFn.functionName),
                                                    "#",
                                                    strings.IntToStr(uniqueTag),
                                                    "#",
                                                    strings.IntToStr(itemIndex)], "")
                let aggCallSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                     slotNames,
                                                                     lowering.typedIr,
                                                                     sourcePath,
                                                                     aggCallSlotName,
                                                                     fieldType)
                if aggCallSlot >= 0:
                    if fieldValueNodeIndex < 0 ||
                       fieldValueNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
                       lowering.typedIr.nodes2_opKinds[fieldValueNodeIndex] != texpr.TypedExprIrOpCallExpr:
                        let panicMsg = Fmt"primary: aggregate call field exact child invalid function={typedFn.functionName} line={bodyLineNumber} ctor_node={ctorNodeIndex} field={itemIndex} child={fieldValueNodeIndex}"
                        panic(panicMsg)
                    let aggFieldSignatureLine = arenamod.ArenaArrayInt32Get(
                        lowering.typedIr.arena,
                        lowering.typedIr.nodes2_callTargetSignatureLineNumbers,
                        fieldValueNodeIndex)
                    let aggNestedIsCtor =
                        fieldKind == coreir.LocalAggregateTag &&
                        !lowering.typedIr.nodes2_callTargetImportcs[fieldValueNodeIndex] &&
                        aggFieldSignatureLine <= 0
                    if aggNestedIsCtor:
                        if PrimaryBodyIrAppendAggregateConstructorToSlot(bodyIR,
                                                                         slotNames,
                                                                         varI32ParamNames,
                                                                         lowering,

                                                                         typedFn,
                                                                         irFunction,
                                                                         valueText,
                                                                         fieldValueNodeIndex,
                                                                         fieldType,
                                                                         sourcePath,
                                                                         bodyLineNumber,
                                                                         aggCallSlot,
                                                                         uniqueTag * 31 + itemIndex + 1,
                                                                         callOrdinal):
                            valueSlot = aggCallSlot
                    elif PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                                slotNames,
                                                                lowering,

                                                                typedFn,
                                                                irFunction,
                                                                varI32ParamNames,
                                                                valueText,
                                                                aggCallSlot,
                                                                bodyLineNumber,
                                                                fieldValueNodeIndex,
                                                                callOrdinal):
                        valueSlot = aggCallSlot
            elif valueSlot < 0 && qcsStrConstLit != "":
                # bail=801 Root: str 字段值是跨模块限定 str 常量 (sourceKind:
                # cert.FinanceSourceUserIntent = "user_intent")。它是 SimpleFieldPath,
                # 旧路径落 MaterializeFieldArgSlot 把 `cert` 当 binding 查型=空 → valueSlot
                # -1 → failCode 60 → return 位聚合构造 bail=801。跨模块限定 str 常量解得纯
                # 字面量后与下方 str 字面量臂同款经 AppendStringLiteralValue 物化 str 槽。
                # 严格: qualifier 须解析为 import/type 别名模块源且 RHS 为纯字面量; 局部
                # binding.strField 解得空跳过本臂落既有 MaterializeField (无回归/poison-on-miss)。
                let qcsCtorSlotName = strutil.Join(["#ctor_qual_str_const#",
                                                    strings.CloneStr(typedFn.functionName),
                                                    "#",
                                                    strings.IntToStr(uniqueTag),
                                                    "#",
                                                    strings.IntToStr(itemIndex)], "")
                let qcsCtorSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                slotNames,
                                                                qcsCtorSlotName,
                                                                coreir.LocalStrTag)
                if qcsCtorSlot >= 0 &&
                   PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                         slotNames,
                                                         qcsStrConstLit,
                                                         qcsCtorSlot,
                                                         callOrdinal):
                    valueSlot = qcsCtorSlot
            elif valueSlot < 0 &&
                 texpr.TypedExprTextIsSimpleFieldPath(valueText) &&
                 PrimaryBodyIrTextHasFieldOrIndex(valueText):
                var aggFieldFail0: int32
                var aggFieldFail1: int32
                valueSlot = PrimaryBodyIrMaterializeFieldArgSlot(bodyIR,
                                                                 slotNames,
                                                                 lowering.typedIr,
                                                                 typedFn,
                                                                 irFunction,
                                                                 sourcePath,
                                                                 bodyLineNumber,
                                                                 valueText,
                                                                 aggFieldFail0,
                                                                 aggFieldFail1)
            elif valueSlot < 0 &&
                 fieldKind == coreir.LocalStrTag && PrimaryBodyIrTextIsStringLiteral(valueText):
                # str 字段值是字符串字面量（`error: ""`/`error: "boom"`）：建 str 槽经
                # 字面量物化器写入（与返回位 str 字面量同款 AppendStringLiteralValue），
                # 否则字面量既非整调用/字段路径/裸名、落 valueSlot=-1 让整构造失败
                # (bare 结构体返回多 str 字段时表现为 return_shape miss)。
                let aggStrLitSlotName = strutil.Join(["#ctor_str_lit#",
                                                      strings.CloneStr(typedFn.functionName),
                                                      "#",
                                                      strings.IntToStr(uniqueTag),
                                                      "#",
                                                      strings.IntToStr(itemIndex)], "")
                let aggStrLitSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                  slotNames,
                                                                  aggStrLitSlotName,
                                                                  coreir.LocalStrTag)
                if aggStrLitSlot >= 0 &&
                   PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                         slotNames,
                                                         valueText,
                                                         aggStrLitSlot,
                                                         callOrdinal):
                    valueSlot = aggStrLitSlot
            elif valueSlot < 0:
                # 裸局部/形参名：取其槽，须是等宽聚合/str。
                let aggNameSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, valueText)
                if aggNameSlot >= 0 &&
                   aggNameSlot < bodyIR.localSlots.len &&
                   (PrimaryBodyIrSlotType(bodyIR, aggNameSlot) == coreir.LocalAggregateTag ||
                    PrimaryBodyIrSlotType(bodyIR, aggNameSlot) == coreir.LocalStrTag):
                    valueSlot = aggNameSlot
        else:
            primaryAggCtorLastFailIndex = itemIndex
            primaryAggCtorLastFailCode = 50
            return false
        # 批 6 构造器 OBJECT_REF→OBJECT 物化臂 (C parse_object_constructor_typed
        # :42031-42116 同族): 字段期望 OBJECT 值而值源是 OBJECT_REF (ref 槽)
        # → 物化解引用副本到等宽 owned 槽 (managed 经 Prepare :17479 落戳,
        # 批 1 共享面同戳族), 再进宽 FieldStore。身份双解 (C :42054-42062
        # 物化前核对): 值节点 structural==RefObject 且 pointee childTypeId==
        # 字段期望 TypeId (宿主 layoutChild CSR 按 offset/width 唯一命中)。
        # 字段自身是 ref 时豁免 (ref-to-ref 由既有等宽道处理); pointee 不
        # 等属 TypedExpr 先拒形 → return false 真空锚 (C 的 die
        # `object constructor field type mismatch` 是防御面, 类型正确的输
        # 入不可达)。
        if valueSlot >= 0 && fieldKind == coreir.LocalAggregateTag &&
           fieldValueNodeIndex >= 0 &&
           !texpr.TypedExprIrTypeIsRef(lowering.typedIr, sourcePath,
                                       fieldType):
            let fieldValueTypeId = texpr.TypedExprIrNodeStructuralTypeIdAt(
                lowering.typedIr, fieldValueNodeIndex)
            if fieldValueTypeId >= 0 &&
               fieldValueTypeId < lowering.typeArenaStructuralKinds.len &&
               lowering.typeArenaStructuralKinds[fieldValueTypeId] ==
                   Int32(typearena.TypedExprStructuralTypeRefObject):
                var expectedFieldTypeId: int32 = -1
                let ctorTypeId = texpr.TypedExprIrNodeStructuralTypeIdAt(
                    lowering.typedIr, ctorNodeIndex)
                if ctorTypeId >= 0 &&
                   ctorTypeId < lowering.typeArenaLayoutChildStarts.len:
                    let childStart =
                        lowering.typeArenaLayoutChildStarts[ctorTypeId]
                    let childCount =
                        lowering.typeArenaLayoutChildCounts[ctorTypeId]
                    if childStart >= 0 && childCount >= 0 &&
                       childStart <=
                           lowering.typeArenaLayoutChildTypeIds.len -
                               childCount:
                        for childOffset in 0..<childCount:
                            let childRow = childStart + childOffset
                            if lowering.typeArenaLayoutChildOffsets[
                                   childRow] == fieldOffsetBytes &&
                               lowering.typeArenaLayoutChildWidths[
                                   childRow] == fieldSizeBytes:
                                expectedFieldTypeId =
                                    lowering.typeArenaLayoutChildTypeIds[
                                        childRow]
                                break
                if expectedFieldTypeId >= 0:
                    if lowering.typeArenaChildTypeIds[fieldValueTypeId] !=
                           expectedFieldTypeId:
                        # TypedExpr 先拒形 (防御面真空锚, 见臂头注释)。
                        return false
                    let objDerefSlotName = strutil.Join(["#ctor_obj_deref#",
                                                         strings.CloneStr(typedFn.functionName),
                                                         "#",
                                                         strings.IntToStr(uniqueTag),
                                                         "#",
                                                         strings.IntToStr(itemIndex)], "")
                    let objDerefSlot = PrimaryBodyIrFindOrCreateTypedSlot(
                        bodyIR, slotNames, lowering.typedIr, sourcePath,
                        objDerefSlotName, fieldType)
                    if objDerefSlot < 0:
                        primaryAggCtorLastFailIndex = itemIndex
                        primaryAggCtorLastFailCode = 62
                        return false
                    var objDerefOp: coreir.BodyOp
                    objDerefOp.kind = coreir.BodyOpFieldLoadTag
                    objDerefOp.target = objDerefSlot
                    add(objDerefOp.operands, valueSlot)
                    add(objDerefOp.operands, objDerefSlot)
                    add(objDerefOp.operands, 0)
                    add(objDerefOp.operands, fieldSizeBytes)
                    var objDerefHasManaged: bool
                    if texpr.TypedExprIrTypeContainsManagedStorage(
                           lowering.typedIr, sourcePath, fieldType,
                           objDerefHasManaged) && objDerefHasManaged:
                        PrimaryBodyIrPrepareManagedBodyOpValueDefinitionExact(
                            bodyIR, lowering.typedIr, sourcePath,
                            fieldType, fieldValueNodeIndex, objDerefOp)
                    let _ = coreir.BodyIRAppendOp(bodyIR, objDerefOp)
                    valueSlot = objDerefSlot
        if valueSlot < 0 ||
           valueSlot >= bodyIR.localSlots.len ||
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < fieldSizeBytes:
            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                var dbgSlotSize = -1
                if valueSlot >= 0 && valueSlot < bodyIR.localSlots.len:
                    dbgSlotSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot])
                os.WriteLine(os.GetStderr(), strutil.Join(["phase=agg_ctor_field_valueslot_fail itemIndex=",
                                                           strings.IntToStr(itemIndex),
                                                           " fieldName=", fieldName,
                                                           " valueText=", valueText,
                                                           " fieldKind=", strings.IntToStr(fieldKind),
                                                           " fieldSizeBytes=", strings.IntToStr(fieldSizeBytes),
                                                           " valueSlot=", strings.IntToStr(valueSlot),
                                                           " slotSize=", strings.IntToStr(dbgSlotSize)], ""))
            primaryAggCtorLastFailIndex = itemIndex
            primaryAggCtorLastFailCode = 60
            return false
        # 宽 FieldStore 的值源须读栈上聚合体，形参地址槽语义不符；聚合/str 值源
        # 若落在形参槽，先物化等宽本地副本。
        if (fieldKind == coreir.LocalStrTag || fieldKind == coreir.LocalAggregateTag) &&
           PrimaryBodyIrLocalIsParam(bodyIR.localSlots[valueSlot]):
            let aggCopySlotName = strutil.Join(["#ctor_agg_copy#",
                                                strings.CloneStr(typedFn.functionName),
                                                "#",
                                                strings.IntToStr(uniqueTag),
                                                "#",
                                                strings.IntToStr(itemIndex)], "")
            let aggCopySlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                                 slotNames,
                                                                 aggCopySlotName,
                                                                 coreir.LocalAggregateTag,
                                                                 fieldSizeBytes,
                                                                 8)
            if aggCopySlot < 0:
                primaryAggCtorLastFailIndex = itemIndex
                primaryAggCtorLastFailCode = 61
                return false
            var aggCopyOp: coreir.BodyOp
            aggCopyOp.kind = coreir.BodyOpFieldLoadTag
            aggCopyOp.target = aggCopySlot
            add(aggCopyOp.operands, valueSlot)
            add(aggCopyOp.operands, aggCopySlot)
            add(aggCopyOp.operands, 0)
            add(aggCopyOp.operands, fieldSizeBytes)
            let _ = coreir.BodyIRAppendOp(bodyIR, aggCopyOp)
            valueSlot = aggCopySlot
        add(fieldValueSlots, valueSlot)
        add(fieldOffsets, fieldOffsetBytes)
        add(fieldSizes, fieldSizeBytes)
    # 发射阶段（不可回落）：零初始化目标槽 → 逐字段 FieldStore。
    if !PrimaryBodyIrAppendZeroLocalSlot(bodyIR, slotNames, targetSlot, callOrdinal):
        primaryAggCtorLastFailIndex = -1
        primaryAggCtorLastFailCode = 72
        return false
    for storeIndex in 0..<fieldValueSlots.len:
        var fieldStoreOp: coreir.BodyOp
        fieldStoreOp.kind = coreir.BodyOpFieldStoreTag
        fieldStoreOp.target = targetSlot
        add(fieldStoreOp.operands, targetSlot)
        add(fieldStoreOp.operands, fieldValueSlots[storeIndex])
        add(fieldStoreOp.operands, fieldOffsets[storeIndex])
        add(fieldStoreOp.operands, fieldSizes[storeIndex])
        let _ = coreir.BodyIRAppendOp(bodyIR, fieldStoreOp)
    return true

# 返回位的「值聚合构造器」下降：`return Type(field0: v0, field1: v1, ...)`，
# 其中 Type 命名一个聚合（结构体或 seq 别名头），形状与函数返回型精确一致，
# 且 Type 不解析为可见函数（构造器不是函数——这是与「return 整函数调用」的
# 判别）。语义=经共享核心物化进 result 槽后走 sret 返回 term。
@borrows
fn PrimaryBodyIrAppendReturnAggregateConstructor(bodyIR: var coreir.BodyIR,
                                                  slotNames: var str[],
                                                  varI32ParamNames: str[],
                                                  lowering: var lower.LoweringPlanStub,
                                                  typedFn: texpr.TypedExprIrFunction,
                                                  irFunction: lower.PrimaryObjectIrFunction,
                                                  returnExprRaw: str,
                                                  returnExprNodeIndex: int32,
                                                  currentBlockStart: var int32,
                                                  callOrdinal: var int32): bool =
    let returnExpr = strutil.Strip(returnExprRaw)
    if len(returnExpr) <= 0:
        return false
    # 返回型须为聚合（return term 需其 typeKind）。
    var retTypeKind: int32
    var retSizeBytes: int32
    var retAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                   typedFn.sourcePath,
                                   typedFn.returnType,
                                   retTypeKind,
                                   retSizeBytes,
                                   retAlignBytes)
    if retTypeKind != coreir.LocalAggregateTag || retSizeBytes <= 0:
        return false
    # result 槽：sret 关联的返回聚合槽。共享核心负责形状校验+零初始化+字段写入。
    let resultSlotName = strutil.Join(["#return_ctor#",
                                       strings.CloneStr(typedFn.functionName),
                                       "#",
                                       strings.IntToStr(currentBlockStart)], "")
    let resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                        slotNames,
                                                        lowering.typedIr,
                                                        typedFn.sourcePath,
                                                        resultSlotName,
                                                        typedFn.returnType)
    if resultSlot < 0:
        return false
    if !PrimaryBodyIrAppendAggregateConstructorToSlot(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      lowering,

                                                      typedFn,
                                                      irFunction,
                                                      returnExpr,
                                                      returnExprNodeIndex,
                                                      typedFn.returnType,
                                                      typedFn.sourcePath,
                                                      typedFn.bodyLineNumber,
                                                      resultSlot,
                                                      currentBlockStart,
                                                      callOrdinal):
        return false
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  resultSlot,
                                  retTypeKind,
                                  0,
                                  false)
    return true

# 批 6 return 沉口 (规格 §5): 返回位定长数组 bracket 字面量物化臂
# (`return [e0, e1, ...]`, 返回型为定长数组)。现形无 lowering 臂, 落
# 801 bail 族。语义=建 sret 关联的定长数组 result 槽, 经 bracket 一
# 次成型器整列下降为 N 个常量索引 IndexedStore (批 6 落戳: 声明类
# 型含托管存储时元素物化行经 Prepare 落 exact 生产者戳, 戳随物化
# 落), 再走返回 term。动态 seq 的 bracket 是 seq literal 另一族,
# 由 bracket 器自身让位; 长度/元素类型由 TypedExpr 上游门 (C 的同
# 宽同文本直接发布对应物 — Cheng 一次成型无 restage)。
@borrows
fn PrimaryBodyIrAppendReturnFixedArrayBracket(bodyIR: var coreir.BodyIR,
                                              slotNames: var str[],
                                              varI32ParamNames: str[],
                                              lowering: var lower.LoweringPlanStub,
                                              typedFn: texpr.TypedExprIrFunction,
                                              irFunction: lower.PrimaryObjectIrFunction,
                                              returnExprRaw: str,
                                              returnExprNodeIndex: int32,
                                              currentBlockStart: var int32,
                                              callOrdinal: var int32): bool =
    let returnExpr = strutil.Strip(returnExprRaw)
    if len(returnExpr) < 2 || returnExpr[0] != '[':
        return false
    # 返回型须为定长数组聚合 (sret 返回 term 需其 typeKind)。
    var retTypeKind: int32
    var retSizeBytes: int32
    var retAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                   typedFn.sourcePath,
                                   typedFn.returnType,
                                   retTypeKind,
                                   retSizeBytes,
                                   retAlignBytes)
    if retTypeKind != coreir.LocalAggregateTag || retSizeBytes <= 0:
        return false
    let resultSlotName = strutil.Join(["#return_arrlit#",
                                       strings.CloneStr(typedFn.functionName),
                                       "#",
                                       strings.IntToStr(currentBlockStart)], "")
    let resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                        slotNames,
                                                        lowering.typedIr,
                                                        typedFn.sourcePath,
                                                        resultSlotName,
                                                        typedFn.returnType)
    if resultSlot < 0:
        return false
    if !PrimaryBodyIrAppendFixedArrayBracketInitializer(
           bodyIR,
           slotNames,
           varI32ParamNames,
           lowering.typedIr,
           typedFn.sourcePath,
           typedFn.returnType,
           returnExpr,
           resultSlot,
           callOrdinal):
        return false
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  resultSlot,
                                  retTypeKind,
                                  0,
                                  false)
    return true

# wave15-quicsent-fam801: return-statement mirror of the array-of-aggregate
# element address composition already proven in FieldArrayIndexedElemAddrSlot's
# SubField store/read siblings (SeqAddHeaderPtrSlot fixed-array offset + Madd
# element-address arithmetic, w13 udpslot cf03c7bfb) and in the fam712b
# global-aggregate whole-value FieldLoadTag read (55f2a6e0f) — combined here
# for the shape `return root.arrayField[indexExpr]` where the WHOLE aggregate
# array element (no trailing `.subField`) is the return value and `indexExpr`
# may itself be a plain call (msquicConnImplSentPacketAtStore:
# `return msquicConnImplStore.sentPacketStore[msquicConnImplSentStoreIdx(slot, idx)]`).
# AppendAggregateConstructorToSlot only recognizes `Type(...)`/`Type{...}` ctor
# syntax and correctly fails (failCode=3, no top-level brace) on this
# index-read shape — it is a value SOURCE, not a constructor, so it needs its
# own narrow branch rather than a change inside the shared ctor helper. Every
# resolution step below returns false on any mismatch (unresolved root,
# dynamic-seq field, non-aggregate or size/type-mismatched element, unresolved
# index) and falls straight through to the existing
# AppendReturnAggregateConstructor / 801 bail — poison-on-miss, no silent
# fallback.
@borrows
fn PrimaryBodyIrAppendReturnFieldArrayIndexedElemValue(bodyIR: var coreir.BodyIR,
                                                        slotNames: var str[],
                                                        varI32ParamNames: str[],
                                                        lowering: var lower.LoweringPlanStub,
                                                        typedFn: texpr.TypedExprIrFunction,
                                                        irFunction: lower.PrimaryObjectIrFunction,
                                                        returnExprRaw: str,
                                                        returnExprNodeIndex: int32,
                                                        currentBlockStart: var int32,
                                                        callOrdinal: var int32): bool =
    let text = strutil.Strip(returnExprRaw)
    if len(text) <= 0:
        return false
    # Hoist managed str fields off typedFn once: CFG-forked PAYLOAD_LOAD of the
    # same PARAM+BORROW_SHARED projection loses exact physical source (same class
    # as ConditionOperandSlot). int32 bodyLineNumber needs no hoist.
    let typedFnName = typedFn.functionName
    let typedFnSourcePath = typedFn.sourcePath
    let typedFnReturnType = typedFn.returnType
    var retTypeKind: int32
    var retSizeBytes: int32
    var retAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                   typedFnSourcePath,
                                   typedFnReturnType,
                                   retTypeKind,
                                   retSizeBytes,
                                   retAlignBytes)
    if retTypeKind != coreir.LocalAggregateTag || retSizeBytes <= 0:
        return false
    let rootName = texpr.TypedExprAssignLhsRootName(text)
    if rootName == "" || PrimaryBodyIrTextHasDot(rootName):
        return false
    let fieldPath = texpr.TypedExprAssignFieldPath(text)
    if fieldPath == "":
        return false
    # Parse `arrayField[indexText]` — the WHOLE fieldPath, no trailing
    # `.subField` (that shape is FieldArrayIndexedSubFieldParts's, handled
    # elsewhere by the store/read siblings).
    let openPos = parser.ParserFindText(fieldPath, "[")
    if openPos <= 0:
        return false
    var closePos = -1
    var scan = openPos
    var depth: int32
    while scan < len(fieldPath):
        if fieldPath[scan] == '[':
            depth = depth + 1
        elif fieldPath[scan] == ']':
            depth = depth - 1
            if depth == 0:
                closePos = scan
                break
        scan = scan + 1
    if closePos <= openPos || closePos + 1 != len(fieldPath):
        return false
    let arrayFieldName = strutil.Strip(strings.SliceBytes(fieldPath, 0, openPos))
    let indexText = strutil.Strip(strings.SliceBytes(fieldPath,
                                                      openPos + 1,
                                                      closePos - openPos - 1))
    if arrayFieldName == "" || indexText == "" ||
       PrimaryBodyIrTextHasDot(arrayFieldName) ||
       parser.ParserFindText(arrayFieldName, "[") >= 0:
        return false
    # Resolve root's own type: local/param binding first, module global next
    # (mirrors FindOrCreateFieldBaseSlot's own global-resolution contract —
    # that shared helper requires a non-empty, non-"var"-prefixed rootType to
    # route a bare-name global root through GlobalSeqAddressSlot).
    var rootType = texpr.TypedExprStripVarType(PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                                typedFn,
                                                                                irFunction,
                                                                                typedFn.bodyLineNumber,
                                                                                rootName))
    if rootType == "" || rootType == "unknown":
        rootType = PrimaryBodyIrTypedGlobalTypeExact(lowering.typedIr, typedFnSourcePath, rootName)
    if rootType == "":
        rootType = PrimaryBodyIrTypedGlobalType(lowering.typedIr, typedFnSourcePath, rootName)
    if rootType == "" || rootType == "unknown" || !PrimaryObjectMetadataTextStable(rootType):
        return false
    # Array field meta: must be a FIXED (non-dynamic-seq) array of aggregate
    # elements whose exact shape (size AND normalized type name) matches the
    # function's return type.
    var arrayFieldType = ""
    var arrayFieldOffset: int32
    var arrayFieldSize: int32
    var arrayFieldAlign: int32
    if !PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                           typedFnSourcePath,
                                           rootType,
                                           arrayFieldName,
                                           arrayFieldType,
                                           arrayFieldOffset,
                                           arrayFieldSize,
                                           arrayFieldAlign):
        return false
    if arrayFieldOffset < 0 || arrayFieldSize <= 0:
        return false
    if PrimaryBodyIrTypeTextIsDynamicSeq(arrayFieldType):
        return false
    let elemType = PrimaryBodyIrIndexedElementTypeText(arrayFieldType)
    if elemType == "":
        return false
    var elemKind: int32
    var elemSize: int32
    var elemAlign: int32
    PrimaryBodyIrTypeShapeFromText(lowering.typedIr, typedFnSourcePath, elemType, elemKind, elemSize, elemAlign)
    if elemKind != coreir.LocalAggregateTag || elemSize != retSizeBytes:
        return false
    if texpr.TypedExprNormalizeTypeText(elemType) != texpr.TypedExprNormalizeTypeText(typedFnReturnType):
        return false
    # Root base address (module-global aggregate → adrp+add real symbol;
    # local/param aggregate → its own slot) — shared, already-verified
    # primitive used by the SubField store/read siblings.
    let baseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                          slotNames,
                                                          lowering.typedIr,
                                                          typedFnSourcePath,
                                                          rootName,
                                                          rootType)
    if baseSlot < 0:
        return false
    # Array-field base address = root base + arrayFieldOffset (w13 udpslot combo).
    let arrBaseSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                       slotNames,
                                                       typedFn.bodyLineNumber,
                                                       baseSlot,
                                                       arrayFieldOffset)
    if arrBaseSlot < 0:
        return false
    # Index: bare var/const/cast first (existing scalar resolver); a genuine
    # whole-call index expression (msquicConnImplSentStoreIdx(slot, idx)) next,
    # via the same call-eval primitive AppendReturnWholeCall already uses for
    # `return call(...)`. Any other shape misses → poison-on-miss below.
    var idxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      lowering.typedIr,
                                                      typedFnSourcePath,
                                                      indexText,
                                                      coreir.LocalI32Tag,
                                                      callOrdinal)
    if idxSlot < 0:
        let idxCallOpen = texpr.TypedExprFindWholeCallOpenParen(indexText)
        if idxCallOpen > 0:
            let idxCallClose = texpr.TypedExprFindMatchingParen(indexText, idxCallOpen)
            if idxCallClose > idxCallOpen && idxCallClose + 1 == len(indexText):
                let idxCallHead = strutil.Strip(strings.SliceBytes(indexText, 0, idxCallOpen))
                if texpr.TypedExprCallHeadIsPlainQualifiedIdent(idxCallHead):
                    if returnExprNodeIndex < 0 ||
                       returnExprNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
                       lowering.typedIr.nodes2_opKinds[returnExprNodeIndex] !=
                           texpr.TypedExprIrOpIndexGet:
                        let panicMsg = Fmt"primary: return indexed field call lacks canonical IndexGet row function={typedFnName} line={typedFn.bodyLineNumber} node={returnExprNodeIndex}"
                        panic(panicMsg)
                    let idxCallNodeIndex = arenamod.ArenaArrayInt32Get(
                        lowering.typedIr.arena,
                        lowering.typedIr.nodes2_operand1NodeIndexs,
                        returnExprNodeIndex)
                    if idxCallNodeIndex < 0 ||
                       idxCallNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
                       lowering.typedIr.nodes2_opKinds[idxCallNodeIndex] !=
                           texpr.TypedExprIrOpCallExpr:
                        let panicMsg = Fmt"primary: return indexed field call index lacks canonical CallExpr row function={typedFnName} line={typedFn.bodyLineNumber} node={returnExprNodeIndex} index={idxCallNodeIndex}"
                        panic(panicMsg)
                    let idxCallSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                    slotNames,
                                                                    Fmt"#raie_idx#{typedFn.bodyLineNumber}#{bodyIR.ops.len}",
                                                                    coreir.LocalI32Tag)
                    if idxCallSlot >= 0 &&
                       PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                              slotNames,
                                                              lowering,

                                                              typedFn,
                                                              irFunction,
                                                              varI32ParamNames,
                                                              indexText,
                                                              idxCallSlot,
                                                              typedFn.bodyLineNumber,
                                                              idxCallNodeIndex,
                                                              callOrdinal):
                        idxSlot = idxCallSlot
    if idxSlot < 0:
        return false
    let eszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"#raie_esz#{typedFn.bodyLineNumber}#{bodyIR.ops.len}",
                                                  coreir.LocalI64Tag,
                                                  elemSize)
    let addrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"#raie_addr#{typedFn.bodyLineNumber}#{bodyIR.ops.len}",
                                                 coreir.LocalPtrTag)
    if eszSlot < 0 || addrSlot < 0:
        return false
    # elemAddr = idx*elemSize + arrBase (Madd), identical to the SubField
    # sibling's address arithmetic.
    var addrOp: coreir.BodyOp
    addrOp.kind = coreir.BodyOpBinOpTag
    addrOp.target = addrSlot
    add(addrOp.operands, coreir.LocalI64Tag)
    add(addrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
    add(addrOp.operands, idxSlot)
    add(addrOp.operands, eszSlot)
    add(addrOp.operands, arrBaseSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, addrOp)
    let resultSlotName = strutil.Join(["#return_arr_elem#",
                                       strings.CloneStr(typedFnName),
                                       "#",
                                       strings.IntToStr(currentBlockStart)], "")
    let resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                        slotNames,
                                                        lowering.typedIr,
                                                        typedFnSourcePath,
                                                        resultSlotName,
                                                        typedFnReturnType)
    if resultSlot < 0 || PrimaryLocalSlotSizeOf(bodyIR.localSlots[resultSlot]) < elemSize:
        return false
    # Whole-element FieldLoad from the computed address (fam712b's proven
    # read-side FieldLoadTag semantics, here sourced from an array element
    # address instead of a bare global's own address).
    var loadOp: coreir.BodyOp
    loadOp.kind = coreir.BodyOpFieldLoadTag
    loadOp.target = resultSlot
    add(loadOp.operands, addrSlot)
    add(loadOp.operands, resultSlot)
    add(loadOp.operands, 0)
    add(loadOp.operands, elemSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, loadOp)
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  resultSlot,
                                  retTypeKind,
                                  0,
                                  false)
    return true

@borrows
fn PrimaryBodyIrTopLevelColonPos(textRaw: str): int32 =
    var parenDepth: int32
    var bracketDepth: int32
    for i in 0..<len(textRaw):
        let ch = textRaw[i]
        if ch == '(':
            parenDepth = parenDepth + 1
        elif ch == ')':
            parenDepth = parenDepth - 1
        elif ch == '[':
            bracketDepth = bracketDepth + 1
        elif ch == ']':
            bracketDepth = bracketDepth - 1
        elif ch == ':' && parenDepth == 0 && bracketDepth == 0:
            return i
    return -1

@borrows
fn PrimaryBodyIrFnPtrOpenParenPos(typeRaw: str): int32 =
    let typeText = texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(typeRaw))
    if !PrimaryStartsWith(typeText, "fn"):
        return -1
    for i in 0..<len(typeText):
        if typeText[i] == '(':
            return i
    return -1

@borrows
fn PrimaryBodyIrFnPtrReturnType(typeRaw: str): str =
    let typeText = texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(typeRaw))
    let openPos = PrimaryBodyIrFnPtrOpenParenPos(typeText)
    if openPos < 0:
        return ""
    let closePos = texpr.TypedExprFindMatchingParen(typeText, openPos)
    if closePos <= openPos || closePos + 1 >= len(typeText):
        return ""
    if typeText[closePos + 1] != ':':
        return ""
    return strings.CloneStr(strutil.Strip(strings.SliceBytes(typeText,
                                                             closePos + 2,
                                                             len(typeText) - closePos - 2)))

@borrows
fn PrimaryBodyIrFnPtrParamTypes(typeRaw: str): str[] =
    var out: str[]
    let typeText = texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(typeRaw))
    let openPos = PrimaryBodyIrFnPtrOpenParenPos(typeText)
    if openPos < 0:
        return out
    let closePos = texpr.TypedExprFindMatchingParen(typeText, openPos)
    if closePos <= openPos:
        return out
    let paramsText = strutil.Strip(strings.SliceBytes(typeText,
                                                      openPos + 1,
                                                      closePos - openPos - 1))
    if paramsText == "":
        return out
    let parts = texpr.TypedExprSplitTopLevelCsv(paramsText)
    for i in 0..<parts.len:
        let part = strutil.Strip(parts[i])
        if part == "":
            continue
        let colonPos = PrimaryBodyIrTopLevelColonPos(part)
        var paramType = strings.CloneStr(part)
        if colonPos >= 0 && colonPos + 1 < len(part):
            paramType = strings.CloneStr(strutil.Strip(strings.SliceBytes(part,
                                                                          colonPos + 1,
                                                                          len(part) - colonPos - 1)))
        if paramType == "":
            return []
        add(out, paramType)
    return out

@borrows
fn PrimaryBodyIrAppendFnPtrSretAgg1CallToSlot(bodyIR: var coreir.BodyIR,
                                               slotNames: var str[],
                                               typedIr: texpr.TypedExprIr,
                                               typedFn: texpr.TypedExprIrFunction,
                                               irFunction: lower.PrimaryObjectIrFunction,
                                               callHead: str,
                                               callArgsText: str,
                                               targetSlot: int32,
                                               lineNumber: int32,
                                               callOrdinal: var int32): bool =
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        return false
    var fnPtrType = PrimaryBodyIrBindingTypeForName(typedIr,
                                                    typedFn,
                                                    irFunction,
                                                    lineNumber,
                                                    callHead)
    if !texpr.TypedExprTypeTextIsFnPtr(fnPtrType):
        # form47 案卷回灌 (BACKFILL-9): PrimaryBodyIrBindingTypeForName 只把
        # 全局的 bindingNameGlobalType 当局部候选否决过滤用, 从不当返回值,
        # 所以模块级全局 callHead (如 var globalA: IntFn) 走到这里恒为 "".
        # 单独查一次全局类型表补上对称一条腿。
        let globalFnPtrType = PrimaryBodyIrTypedGlobalType(typedIr, typedFn.sourcePath, callHead)
        if texpr.TypedExprTypeTextIsFnPtr(globalFnPtrType):
            fnPtrType = globalFnPtrType
        elif globalFnPtrType != "":
            let globalAliasResolved = texpr.TypedExprIrLookupTypeDefAliasTargetType(typedIr, typedFn.sourcePath, globalFnPtrType)
            if texpr.TypedExprTypeTextIsFnPtr(globalAliasResolved):
                fnPtrType = globalAliasResolved
            else:
                return false
        else:
            return false
    let fnParamTypes: str[] = PrimaryBodyIrFnPtrParamTypes(fnPtrType)
    let callArgs: str[] = PrimaryBodyIrCallArgNames(callArgsText)
    if len(fnParamTypes) != 1 || len(callArgs) != 1:
        return false
    let resultType = PrimaryBodyIrFnPtrReturnType(fnPtrType)
    if resultType == "" || resultType == "void":
        return false
    var resultTypeKind: int32
    var resultTypeSizeBytes: int32
    var resultTypeAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   typedFn.sourcePath,
                                   resultType,
                                   resultTypeKind,
                                   resultTypeSizeBytes,
                                   resultTypeAlignBytes)
    if resultTypeKind != coreir.LocalAggregateTag &&
       resultTypeKind != coreir.LocalStrTag:
        return false
    if resultTypeSizeBytes <= 0:
        return false
    if PrimaryBodyIrSlotType(bodyIR, targetSlot) != resultTypeKind ||
       PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) < resultTypeSizeBytes:
        return false
    var fnPtrSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, callHead)
    if fnPtrSlot < 0:
        # form47 案卷回灌 (BACKFILL-9): callHead 是裸标识符且注册为模块级全局
        # (而非局部/形参) 时, FindOrCreateTypedSlot 只会造一个从不发射
        # GlobalLoad 的同名空栈槽, 调用读栈垃圾。先判定是否模块全局, 是则走真实
        # GlobalLoad 拿到实际写入的值槽; 读不出就诚实 bail。
        if parser.ParserIdentPrefix(callHead) == callHead &&
           PrimaryBodyIrTypedGlobalType(typedIr, typedFn.sourcePath, callHead) != "":
            fnPtrSlot = PrimaryBodyIrNodeEvalGlobalLoadSlot(bodyIR,
                                                            slotNames,
                                                            typedIr,
                                                            typedFn.sourcePath,
                                                            callHead)
            if fnPtrSlot < 0:
                return false
        else:
            fnPtrSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                           slotNames,
                                                           typedIr,
                                                           typedFn.sourcePath,
                                                           callHead,
                                                           fnPtrType)
    if fnPtrSlot < 0 || fnPtrSlot >= bodyIR.localSlots.len:
        return false
    let fnPtrSlotKind = PrimaryBodyIrSlotType(bodyIR, fnPtrSlot)
    if fnPtrSlotKind != coreir.LocalPtrTag && fnPtrSlotKind != coreir.LocalI64Tag:
        return false
    var argTextRaw: str
    for callArgIndex in 0..<len(callArgs):
        if callArgIndex == 0:
            argTextRaw = callArgs[callArgIndex]
    let argText = strutil.Strip(argTextRaw)
    if argText == "":
        return false
    var argSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, argText)
    if argSlot < 0:
        return false
    var paramTypeRaw: str
    for fnParamTypeIndex in 0..<len(fnParamTypes):
        if fnParamTypeIndex == 0:
            paramTypeRaw = fnParamTypes[fnParamTypeIndex]
    let paramType = texpr.TypedExprStripVarType(paramTypeRaw)
    var paramKind: int32
    var paramSize: int32
    var paramAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   typedFn.sourcePath,
                                   paramType,
                                   paramKind,
                                   paramSize,
                                   paramAlign)
    if paramKind == coreir.LocalInvalidTag:
        return false
    var call: coreir.CallOp
    call.targetSymbol = "__cheng_call_indirect_sret_agg1"
    call.resultSlot = targetSlot
    call.resultPassKind = coreir.BodyCallPassSretResultTag
    add(call.argSlots, fnPtrSlot)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    if paramKind == coreir.LocalAggregateTag ||
       paramKind == coreir.LocalStrTag:
        argSlot = PrimaryBodyIrByValAggregateArgCopySlot(bodyIR,
                                                         slotNames,
                                                         argSlot,
                                                         callOrdinal,
                                                         1)
        if argSlot < 0 || argSlot >= bodyIR.localSlots.len:
            return false
        if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[argSlot]) ||
           bodyIR.localSlots[argSlot].placeKind == coreir.BodyPlaceGlobalAddressTag:
            add(call.argSlots, argSlot)
            add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
        else:
            add(call.argSlots, coreir.CallArgSlotAddress(argSlot))
            add(call.argPassKinds, coreir.BodyCallPassParamAddressTag)
    else:
        if PrimaryBodyIrSlotType(bodyIR, argSlot) != paramKind:
            if !(paramKind == coreir.LocalI64Tag && PrimaryBodyIrSlotType(bodyIR, argSlot) == coreir.LocalI32Tag):
                return false
        add(call.argSlots, argSlot)
        add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    PrimaryBodyIrFillPendingCallArgAbiSizes(call, bodyIR)
    add(bodyIR.callSequence, call)
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpCallTag
    op.target = targetSlot
    add(op.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    callOrdinal = callOrdinal + 1
    return true

@borrows
fn PrimaryBodyIrAppendFnPtrFieldVoidCallStatement(bodyIR: var coreir.BodyIR,
                                                   slotNames: var str[],
                                                   varI32ParamNames: str[],
                                                   lowering: var lower.LoweringPlanStub,
                                                   typedFn: texpr.TypedExprIrFunction,
                                                   irFunction: lower.PrimaryObjectIrFunction,
                                                   stmt: lower.PrimaryObjectIrStatement,
                                                   resultSlot: int32,
                                                   callOrdinal: var int32): bool =
    # C5 间接调用发射 realizer（bail=64/646 原形态收编）：`binding.fnPtrField()`
    # 零实参、语句级（无结果槽消费）的 fn-ptr 字段调用。发射走正典间接调用桥
    # __cheng_call_indirect_void(fnPtr, ctx=nil) —— 与 __cheng_call_indirect_sret_agg1
    # realizer 同协议（a64 桥体模板 BLR x16 / x64 桥体 call r10 / cold BODY_OP_CALL_PTR）。
    # 桥对 fn() 目标多传一个 nil ctx（首参寄存器），零参被调方按 AAPCS/SysV 忽略，ABI 中性。
    # 任一条件不满足即 false → 调用点保持 poison 64/646，绝不落穿直呼路径。
    if resultSlot >= 0:
        return false
    if strutil.Strip(stmt.callArgsText) != "":
        return false
    var fnPtrSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering,

                                                            typedFn,
                                                            irFunction,
                                                            stmt.sourcePath,
                                                            stmt.lineNumber,
                                                            stmt.callTarget,
                                                            coreir.LocalPtrTag,
                                                            callOrdinal)
    if fnPtrSlot < 0:
        fnPtrSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering,

                                                            typedFn,
                                                            irFunction,
                                                            stmt.sourcePath,
                                                            stmt.lineNumber,
                                                            stmt.callTarget,
                                                            coreir.LocalI64Tag,
                                                            callOrdinal)
    if fnPtrSlot < 0 || fnPtrSlot >= bodyIR.localSlots.len:
        return false
    let fnPtrSlotKind = PrimaryBodyIrSlotType(bodyIR, fnPtrSlot)
    if fnPtrSlotKind != coreir.LocalPtrTag && fnPtrSlotKind != coreir.LocalI64Tag:
        return false
    var call: coreir.CallOp
    call.targetSymbol = "__cheng_call_indirect_void"
    call.resultSlot = -1
    call.resultPassKind = coreir.BodyCallPassStackValueTag
    add(call.argSlots, fnPtrSlot)
    add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(call.argSlots, coreir.CallArgSlotConstPtrNil())
    add(call.argPassKinds, coreir.BodyCallPassPtrNilTag)
    PrimaryBodyIrFillPendingCallArgAbiSizes(call, bodyIR)
    add(bodyIR.callSequence, call)
    var op: coreir.BodyOp
    op.kind = coreir.BodyOpCallTag
    op.target = -1
    add(op.operands, callOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    callOrdinal = callOrdinal + 1
    return true

@borrows
fn PrimaryBodyIrAppendReturnFnPtrSretAgg1Call(bodyIR: var coreir.BodyIR,
                                               slotNames: var str[],
                                               typedIr: texpr.TypedExprIr,
                                               typedFn: texpr.TypedExprIrFunction,
                                               irFunction: lower.PrimaryObjectIrFunction,
                                               callHead: str,
                                               callArgsText: str,
                                               currentBlockStart: var int32,
                                               callOrdinal: var int32): bool =
    let fnPtrType = PrimaryBodyIrBindingTypeForName(typedIr,
                                                    typedFn,
                                                    irFunction,
                                                    typedFn.bodyLineNumber,
                                                    callHead)
    if !texpr.TypedExprTypeTextIsFnPtr(fnPtrType):
        return false
    let fnParamTypes: str[] = PrimaryBodyIrFnPtrParamTypes(fnPtrType)
    let callArgs: str[] = PrimaryBodyIrCallArgNames(callArgsText)
    if fnParamTypes.len != 1 || callArgs.len != 1:
        return false
    let resultType = PrimaryBodyIrFnPtrReturnType(fnPtrType)
    if resultType == "" || resultType == "void":
        return false
    var resultTypeKind: int32
    var resultTypeSizeBytes: int32
    var resultTypeAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   typedFn.sourcePath,
                                   resultType,
                                   resultTypeKind,
                                   resultTypeSizeBytes,
                                   resultTypeAlignBytes)
    if resultTypeKind != coreir.LocalAggregateTag &&
       resultTypeKind != coreir.LocalStrTag:
        return false
    if resultTypeSizeBytes <= 0:
        return false
    let resultSlotName = strutil.Join(["#return_fnptr_sret#",
                                       strings.CloneStr(typedFn.functionName),
                                       "#",
                                       strings.IntToStr(currentBlockStart),
                                       "#",
                                       strings.IntToStr(callOrdinal)], "")
    let resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                        slotNames,
                                                        typedIr,
                                                        typedFn.sourcePath,
                                                        resultSlotName,
                                                        resultType)
    if resultSlot < 0 ||
       resultSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, resultSlot) != resultTypeKind ||
       PrimaryLocalSlotSizeOf(bodyIR.localSlots[resultSlot]) < resultTypeSizeBytes:
        return false
    if !PrimaryBodyIrAppendFnPtrSretAgg1CallToSlot(bodyIR,
                                                   slotNames,
                                                   typedIr,
                                                   typedFn,
                                                   irFunction,
                                                   callHead,
                                                   callArgsText,
                                                   resultSlot,
                                                   typedFn.bodyLineNumber,
                                                   callOrdinal):
        return false
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  resultSlot,
                                  resultTypeKind,
                                  0,
                                  false)
    return true

@borrows
fn PrimaryBodyIrFunctionTailExprNode(
        irFunction: lower.PrimaryObjectIrFunction): int32 =
    var tailExprNodeIndex: int32 = -1
    for statementIndex in 0..<irFunction.statements.len:
        let stmt = irFunction.statements[statementIndex]
        if !stmt.returnRoot ||
           stmt.rhsNodeIndex < 0:
            continue
        tailExprNodeIndex = stmt.rhsNodeIndex
    return tailExprNodeIndex

@borrows
fn PrimaryBodyIrFunctionTailCallNode(
        typedIr: texpr.TypedExprIr,
        irFunction: lower.PrimaryObjectIrFunction): int32 =
    let tailExprNodeIndex =
        PrimaryBodyIrFunctionTailExprNode(irFunction)
    if tailExprNodeIndex < 0 ||
       tailExprNodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[tailExprNodeIndex] !=
           texpr.TypedExprIrOpCallExpr:
        return -1
    return tailExprNodeIndex

@borrows
fn PrimaryBodyIrAppendReturnWholeCall(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       lowering: var lower.LoweringPlanStub,
                                       typedFn: texpr.TypedExprIrFunction,
                                       irFunction: lower.PrimaryObjectIrFunction,
                                       varI32ParamNames: str[],
                                       returnCallNodeIndex: int32,
                                       currentBlockStart: var int32,
                                       callOrdinal: var int32): bool =
    # Hoist managed str fields off typedFn once (ConditionOperandSlot class).
    let typedFnName = typedFn.functionName
    let typedFnSourcePath = typedFn.sourcePath
    let typedFnReturnType = typedFn.returnType
    let typedFnReturnExpr = typedFn.returnExpr
    let returnExpr = strings.CloneStr(strutil.Strip(typedFnReturnExpr))
    if returnCallNodeIndex < 0 ||
       returnCallNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
       lowering.typedIr.nodes2_opKinds[returnCallNodeIndex] !=
           texpr.TypedExprIrOpCallExpr:
        let panicMsg = Fmt"primary: return whole call lacks canonical CallExpr row function={typedFnName} line={typedFn.bodyLineNumber} node={returnCallNodeIndex}"
        panic(panicMsg)
    if PrimaryObjectPlanTraceActive():
        PrimaryObjectPlanTrace(Fmt"phase=return_call_probe function={typedFnName} expr={returnExpr} lowering_calls={irFunction.callTargets.len}")
    if len(returnExpr) <= 0:
        return false
    let openPos = texpr.TypedExprFindWholeCallOpenParen(returnExpr)
    if openPos <= 0:
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"phase=return_call_skip function={typedFnName} reason=no_whole_call_open expr={returnExpr}")
        return false
    let closePos = texpr.TypedExprFindMatchingParen(returnExpr, openPos)
    var primaryColdCond8: bool
    if closePos <= openPos:
        primaryColdCond8 = true
    if closePos + 1 != len(returnExpr):
        primaryColdCond8 = true
    if primaryColdCond8:
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"phase=return_call_skip function={typedFnName} reason=not_whole_call expr={returnExpr} close={closePos}")
        return false
    let callHead = strings.CloneStr(strutil.Strip(strings.SliceBytes(returnExpr, 0, openPos)))
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"phase=return_call_skip function={typedFnName} reason=bad_call_head head={callHead}")
        return false
    # bail=0 C3: 构造器不是调用。命名字段 seq 别名构造器（如 hashmaps.cheng
    # `hashMap_seq_int32(len: ...)`）的 head 是类型别名（非函数），但 lowering 把它
    # 登记成 callTargets 行 → 下方 ordinal 解析命中并发射 call，命名字段实参走
    # AppendCallArgs 必败（bail_44 毒标）。让位给两处调用点（39127/40139）紧随的
    # AppendReturnAggregateConstructor 逐字段物化；零实参 `return Type()` 亦由其
    # 零初始化臂等价处理（同 AppendCallOp ctor_call_zeroinit 语义）。
    if PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr, typedFnSourcePath, callHead):
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"phase=return_call_skip function={typedFnName} reason=aggregate_ctor_head head={callHead}")
        return false
    var callArgsText = strutil.Strip(strings.SliceBytes(returnExpr,
                                                       openPos + 1,
                                                       closePos - openPos - 1))
    let returnCallArgs = PrimaryBodyIrCallArgNames(callArgsText)
    var returnCallNestedArgSignedness: int32
    if returnCallArgs.len > 0:
        var materializedArgs: str[]
        var changedArgs = false
        for argIndex in 0..<returnCallArgs.len:
            var argText = returnCallArgs[argIndex]
            let argOpenPos = texpr.TypedExprFindWholeCallOpenParen(argText)
            if argOpenPos > 0:
                let argClosePos = texpr.TypedExprFindMatchingParen(argText, argOpenPos)
                if argClosePos > argOpenPos && argClosePos + 1 == len(argText):
                    let argCallHead = strutil.Strip(strings.SliceBytes(argText, 0, argOpenPos))
                    if texpr.TypedExprCallHeadIsPlainQualifiedIdent(argCallHead):
                        var nestedResultType = ""
                        let nestedCallNodeIndex =
                            PrimaryBodyIrCallArgNodeIndexAt(
                                lowering.typedIr,
                                returnCallNodeIndex,
                                argIndex)
                        if nestedCallNodeIndex >= 0 &&
                           nestedCallNodeIndex <
                               lowering.typedIr.nodes2_nodeIndexs.len &&
                           lowering.typedIr.nodes2_opKinds[nestedCallNodeIndex] ==
                               texpr.TypedExprIrOpCallExpr:
                            let nestedResultTypeRes: Result[str] =
                                langintern.LookupIntern(
                                    lowering.typedIr.internPool,
                                    lowering.typedIr.nodes2_resultTypeIds[
                                        nestedCallNodeIndex])
                            if IsOk(nestedResultTypeRes):
                                nestedResultType =
                                    Value(nestedResultTypeRes)
                        if nestedResultType != "" && nestedResultType != "unknown":
                            returnCallNestedArgSignedness = PrimaryIntTypeTextSignedness(nestedResultType)
                            let nestedSlotName = strutil.Join(["#return_call_arg#",
                                                               strings.IntToStr(typedFn.bodyLineNumber),
                                                               "_",
                                                               strings.IntToStr(argIndex),
                                                               "_",
                                                               strings.IntToStr(callOrdinal)], "")
                            let nestedSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                                 slotNames,
                                                                                 lowering.typedIr,
                                                                                 typedFnSourcePath,
                                                                                 nestedSlotName,
                                                                                 nestedResultType)
                            if nestedSlot >= 0 &&
                               PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                                       slotNames,
                                                                       lowering,

                                                                       typedFn,
                                                                       irFunction,
                                                                       varI32ParamNames,
                                                                       argText,
                                                                       nestedSlot,
                                                                       typedFn.bodyLineNumber,
                                                                       nestedCallNodeIndex,
                                                                       callOrdinal):
                                argText = nestedSlotName
                                changedArgs = true
            add(materializedArgs, argText)
        if changedArgs:
            callArgsText = strutil.Join(materializedArgs, ",")
    let callArgCount = PrimaryBodyIrCallArgNames(callArgsText).len
    if PrimaryBodyIrAppendReturnFnPtrSretAgg1Call(bodyIR,
                                                  slotNames,
                                                  lowering.typedIr,
                                                  typedFn,
                                                  irFunction,
                                                  callHead,
                                                  callArgsText,
                                                  currentBlockStart,
                                                  callOrdinal):
        return true
    var callResultType = ""
    let resolvedOrdinal = PrimaryBodyIrResolvedOrRegisteredWholeCallOrdinal(irFunction,
                                                                            lowering.typedIr,
                                                                            typedFnSourcePath,
                                                                            callHead,
                                                                            callArgCount,
                                                                            callResultType)
    if resolvedOrdinal < 0 &&
       PrimaryCallTargetTailName(callHead) == "float64" &&
       callArgCount == 1 &&
       texpr.TypedExprNormalizeTypeText(typedFnReturnType) == "float64":
        # W2G/R3 根修: `return float64(x)` — float64 是 std/system.cheng:544 的通用
        # 模板(类型擦除占位符), 在不含该声明的闭包(provider 单文件/fixture)里
        # ordinal 恒 -1, 旧路一律 target_unresolved → bail=801
        # (provider cheng_epoch_time_export `return float64(libc_time(nil))` 实案)。
        # 与 whole-call rescue (27966-28015) 同构: 实参取嵌套物化/已登记的
        # I32/I64 槽, 有符号性按实参真实类型文本(嵌套调用取其声明返回型
        # returnCallNestedArgSignedness, 简单变量按 BindingTypeForName),
        # 构造 SCVTF 内联 CallOp (wholeCallF64FromIntRescue provenance,
        # 豁免门只认此标记); 判定不全则诚实 poison(818), 不默认有符号。
        let retF64ArgSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, strutil.Strip(callArgsText))
        var retF64ArgSignedness = returnCallNestedArgSignedness
        if retF64ArgSignedness <= 0 && retF64ArgSlot >= 0:
            let retF64ArgTypeText = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                     typedFn,
                                                                     irFunction,
                                                                     typedFn.bodyLineNumber,
                                                                     strutil.Strip(callArgsText))
            retF64ArgSignedness = PrimaryIntTypeTextSignedness(retF64ArgTypeText)
        var retF64Done = false
        if retF64ArgSlot >= 0 &&
           retF64ArgSlot < bodyIR.localSlots.len &&
           (PrimaryBodyIrSlotType(bodyIR, retF64ArgSlot) == coreir.LocalI32Tag ||
            PrimaryBodyIrSlotType(bodyIR, retF64ArgSlot) == coreir.LocalI64Tag) &&
           retF64ArgSignedness > 0:
            let retF64ResultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                      slotNames,
                                                                      lowering.typedIr,
                                                                      typedFnSourcePath,
                                                                      "#return_call",
                                                                      "float64")
            if retF64ResultSlot >= 0 &&
               retF64ResultSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, retF64ResultSlot) == coreir.LocalF64Tag:
                var retF64Call: coreir.CallOp
                retF64Call.targetSymbol = "float64"
                retF64Call.resultSlot = retF64ResultSlot
                retF64Call.resultPassKind = coreir.BodyCallPassStackValueTag
                retF64Call.targetIsImportc = false
                add(retF64Call.argSlots, retF64ArgSlot)
                retF64Call.inlineF64FromIntKind = PrimaryBodyIrCallOpInlineF64FromIntKindForConstruction(retF64Call,
                                                                                                         bodyIR,
                                                                                                         "float64")
                if retF64Call.inlineF64FromIntKind > 0:
                    retF64Call.wholeCallF64FromIntRescue = true
                    retF64Call.inlineF64FromIntUnsigned = (retF64ArgSignedness == 2)
                    add(bodyIR.callSequence, retF64Call)
                    var retF64CallOp: coreir.BodyOp
                    retF64CallOp.kind = coreir.BodyOpCallTag
                    retF64CallOp.target = retF64ResultSlot
                    add(retF64CallOp.operands, callOrdinal)
                    let _ = coreir.BodyIRAppendOp(bodyIR, retF64CallOp)
                    callOrdinal = callOrdinal + 1
                    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                  currentBlockStart,
                                                  retF64ResultSlot,
                                                  coreir.LocalF64Tag,
                                                  0,
                                                  false)
                    retF64Done = true
        if retF64Done:
            return true
        PrimaryBodyIrAppendInvalidOp(bodyIR, typedFn.bodyLineNumber, 0, 818, 0)
        return true
    if resolvedOrdinal < 0:
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"phase=return_call_skip function={typedFnName} reason=target_unresolved head={callHead} argc={callArgCount}")
        return false
    if PrimaryObjectPlanTraceActive():
        PrimaryObjectPlanTrace(Fmt"phase=return_call_resolved function={typedFnName} target={irFunction.callTargets[resolvedOrdinal]} argc={callArgCount}")
    if callResultType == "" || callResultType == "void":
        callResultType = typedFnReturnType
    var stmt: lower.PrimaryObjectIrStatement
    stmt.sourcePath = strings.CloneStr(typedFnSourcePath)
    stmt.functionName = strings.CloneStr(typedFnName)
    stmt.lineNumber = typedFn.bodyLineNumber
    if stmt.lineNumber <= 0:
        stmt.lineNumber = irFunction.bodyLineNumber
    stmt.lineIndent = 0
    stmt.kind = texpr.TypedExprIrStmtLetCall
    stmt.callKind = texpr.TypedExprCallNone
    stmt.rhsNodeIndex = returnCallNodeIndex
    stmt.surfaceText = strings.CloneStr(callHead)
    stmt.bindingName = "#return_call"
    stmt.resultType = strings.CloneStr(callResultType)
    stmt.conditionKind = texpr.TypedExprIrCondNone
    stmt.conditionLhsText = ""
    stmt.conditionRhsText = ""
    stmt.conditionLiteralText = ""
    stmt.assignRootName = ""
    stmt.assignRootType = ""
    stmt.assignRootSourcePath = ""
    stmt.assignRootGlobalFlag = false
    stmt.assignPlaceKind = texpr.TypedExprPlaceTemporary
    stmt.assignFieldName = ""
    stmt.assignFieldType = ""
    stmt.assignFieldOffsetBytes = 0
    stmt.assignFieldSizeBytes = 0
    stmt.assignValueRootName = ""
    stmt.assignValueRootType = ""
    stmt.assignValueFieldName = ""
    stmt.assignValueFieldType = ""
    stmt.assignValueFieldOffsetBytes = 0
    stmt.assignValueFieldSizeBytes = 0
    stmt.assignValueOpKind = texpr.TypedExprIrOpUnsupported
    stmt.assignValueLhsText = ""
    stmt.assignValueRhsText = ""
    stmt.callCallee = strings.CloneStr(texpr.TypedExprQualifiedCallLeaf(callHead))
    stmt.callTarget = irFunction.callTargets[resolvedOrdinal]
    stmt.callTargetSourcePath = irFunction.callTargetSourcePaths[resolvedOrdinal]
    stmt.callTargetSignatureLineNumber =
        irFunction.callTargetSignatureLineNumbers[resolvedOrdinal]
    stmt.callTargetImportc = irFunction.callTargetImportcFlags[resolvedOrdinal]
    stmt.callArgCount = callArgCount
    stmt.callArgsText = strings.CloneStr(callArgsText)
    stmt.returnRoot = true
    let resultType = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
    let resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                        slotNames,
                                                        lowering.typedIr,
                                                        PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                        "#return_call",
                                                        resultType)
    let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                      slotNames,
                                      lowering,

                                      typedFn,
                                      irFunction,
                                      stmt,
                                      resultSlot,
                                      varI32ParamNames,
                                      callOrdinal,
                                      currentBlockStart)
    if PrimaryObjectPlanTraceActive():
        PrimaryObjectPlanTrace(Fmt"phase=return_call_appended function={typedFnName} target={stmt.callTarget} call_count={bodyIR.callSequence.len} ops={bodyIR.ops.len}")
    var resultTypeKind: int32
    var resultTypeSizeBytes: int32
    var resultTypeAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                   PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                   resultType,
                                   resultTypeKind,
                                   resultTypeSizeBytes,
                                   resultTypeAlignBytes)
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  resultSlot,
                                  resultTypeKind,
                                  0,
                                  false)
    return true

@borrows
fn PrimaryBodyIrExactI32ZeroNode(
        typedIr: texpr.TypedExprIr,
        nodeIndex: int32): bool =
    if nodeIndex < 0 ||
       nodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[nodeIndex] !=
           texpr.TypedExprIrOpI32Const:
        return false
    let literalResult: Result[str] = langintern.LookupIntern(
        typedIr.internPool,
        typedIr.nodes2_literalTextIds[nodeIndex])
    return IsOk(literalResult) &&
           strutil.Strip(Value(literalResult)) == "0"

@borrows
fn PrimaryBodyIrAppendReturnCallCompareZero(bodyIR: var coreir.BodyIR,
                                            slotNames: var str[],
                                            lowering: var lower.LoweringPlanStub,
                                            typedFn: texpr.TypedExprIrFunction,
                                            irFunction: lower.PrimaryObjectIrFunction,
                                            varI32ParamNames: str[],
                                            returnExprRaw: str,
                                            lineNumber: int32,
                                            returnExprNodeIndex: int32,
                                            currentBlockStart: var int32,
                                            callOrdinal: var int32): bool =
    let returnExpr = strutil.Strip(returnExprRaw)
    var cmpPos = texpr.TypedExprFindTopLevelTextToken(returnExpr, "==")
    var trueWhenZero = true
    if cmpPos < 0:
        cmpPos = texpr.TypedExprFindTopLevelTextToken(returnExpr, "!=")
        trueWhenZero = false
    if cmpPos < 0:
        return false
    let lhsText = strings.CloneStr(strutil.Strip(strings.SliceBytes(returnExpr, 0, cmpPos)))
    let rhsText = strings.CloneStr(strutil.Strip(strings.SliceBytes(returnExpr, cmpPos + 2, len(returnExpr) - cmpPos - 2)))
    var callExpr = strings.CloneStr(lhsText)
    if PrimaryBodyIrTextIsI32Zero(lhsText):
        callExpr = strings.CloneStr(rhsText)
    elif !PrimaryBodyIrTextIsI32Zero(rhsText):
        return false
    let openPos = texpr.TypedExprFindWholeCallOpenParen(callExpr)
    if openPos <= 0:
        return false
    let closePos = texpr.TypedExprFindMatchingParen(callExpr, openPos)
    var primaryColdCond9: bool
    if closePos <= openPos:
        primaryColdCond9 = true
    if closePos + 1 != len(callExpr):
        primaryColdCond9 = true
    if primaryColdCond9:
        return false
    let callHead = strutil.Strip(strings.SliceBytes(callExpr, 0, openPos))
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        return false
    if returnExprNodeIndex < 0 ||
       returnExprNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        panic(Fmt"primary: return call comparison lacks canonical comparison node line={lineNumber}")
    let returnCmpOpKind =
        lowering.typedIr.nodes2_opKinds[returnExprNodeIndex]
    if returnCmpOpKind != texpr.TypedExprIrOpCmpEq &&
       returnCmpOpKind != texpr.TypedExprIrOpCmpNe:
        panic(Fmt"primary: return call comparison node kind mismatch node={returnExprNodeIndex}")
    let returnCmpLhsNode = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_operand0NodeIndexs,
        returnExprNodeIndex)
    let returnCmpRhsNode = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_operand1NodeIndexs,
        returnExprNodeIndex)
    let returnCmpLhsIsZero =
        PrimaryBodyIrExactI32ZeroNode(lowering.typedIr, returnCmpLhsNode)
    let returnCmpRhsIsZero =
        PrimaryBodyIrExactI32ZeroNode(lowering.typedIr, returnCmpRhsNode)
    if returnCmpLhsIsZero == returnCmpRhsIsZero:
        panic(Fmt"primary: return call comparison exact zero operand missing or ambiguous node={returnExprNodeIndex}")
    var callNodeIndex = returnCmpLhsNode
    if returnCmpLhsIsZero:
        callNodeIndex = returnCmpRhsNode
    if callNodeIndex < 0 ||
       callNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
       lowering.typedIr.nodes2_opKinds[callNodeIndex] !=
           texpr.TypedExprIrOpCallExpr:
        panic(Fmt"primary: return comparison call operand lacks canonical CallExpr row node={returnExprNodeIndex}")
    trueWhenZero = returnCmpOpKind ==
        texpr.TypedExprIrOpCmpEq
    # f64 CALL wave3 adversarial-review poison (third mirror point): this fast
    # path hardcodes the call's result slot as int32 and lowers `== 0`/`!= 0`
    # as an integer CBR. When callHead's declared return type is float64, the
    # forced-int32 slot mismatches the CALL's real f64 result inside
    # PrimaryBodyIrAppendWholeCallExprToSlot, which reconciles the mismatch by
    # materializing the correct f64 value into a separate temp and then
    # BodyOpCopyLocalTag-narrowing it into the int32 slot -- a raw low-32-bit
    # truncating copy of the IEEE-754 bit pattern, not a numeric conversion.
    # The subsequent plain-integer `cmp` then silently compares half the
    # double's raw bits against 0 instead of doing an FCMP, giving wrong
    # answers whenever those low 32 bits happen to be zero for a nonzero
    # value (e.g. `return sqrt(4.0) == 0` -- 2.0's low 32 raw bits are all
    # zero -- silently evaluates true; ground-truthed against clang -O2 and
    # a real ARM64 linked run, see f64_wave3_verdict.md 对抗复核 addendum).
    # Decline this fast path for float64 callees so the caller falls through
    # to a lowering that either does the comparison correctly or bails --
    # never silently miscompiles.
    var returnCmpHeadResultType = ""
    let returnCmpHeadRes: Result[str] = langintern.LookupIntern(
        lowering.typedIr.internPool,
        lowering.typedIr.nodes2_resultTypeIds[callNodeIndex])
    if IsOk(returnCmpHeadRes):
        returnCmpHeadResultType = Value(returnCmpHeadRes)
    if returnCmpHeadResultType == "float64":
        return false
    var callArgsText = strutil.Strip(strings.SliceBytes(callExpr,
                                                       openPos + 1,
                                                       closePos - openPos - 1))
    let callArgs = PrimaryBodyIrCallArgNames(callArgsText)
    if callArgs.len > 0:
        var materializedArgs: str[]
        var changedArgs = false
        for argIndex in 0..<callArgs.len:
            var argText = callArgs[argIndex]
            let argOpenPos = texpr.TypedExprFindWholeCallOpenParen(argText)
            if argOpenPos > 0:
                let argClosePos = texpr.TypedExprFindMatchingParen(argText, argOpenPos)
                if argClosePos > argOpenPos && argClosePos + 1 == len(argText):
                    let argCallHead = strutil.Strip(strings.SliceBytes(argText, 0, argOpenPos))
                    if texpr.TypedExprCallHeadIsPlainQualifiedIdent(argCallHead):
                        var nestedResultType = ""
                        let nestedCallNodeIndex =
                            PrimaryBodyIrCallArgNodeIndexAt(
                                lowering.typedIr,
                                callNodeIndex,
                                argIndex)
                        if nestedCallNodeIndex >= 0 &&
                           nestedCallNodeIndex <
                               lowering.typedIr.nodes2_nodeIndexs.len &&
                           lowering.typedIr.nodes2_opKinds[nestedCallNodeIndex] ==
                               texpr.TypedExprIrOpCallExpr:
                            let nestedResultTypeRes: Result[str] =
                                langintern.LookupIntern(
                                    lowering.typedIr.internPool,
                                    lowering.typedIr.nodes2_resultTypeIds[
                                        nestedCallNodeIndex])
                            if IsOk(nestedResultTypeRes):
                                nestedResultType =
                                    Value(nestedResultTypeRes)
                        if nestedResultType != "" && nestedResultType != "unknown":
                            let nestedSlotName = strutil.Join(["#return_call_cmp_arg#",
                                                               strings.IntToStr(lineNumber),
                                                               "_",
                                                               strings.IntToStr(argIndex),
                                                               "_",
                                                               strings.IntToStr(callOrdinal)], "")
                            let nestedSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                                 slotNames,
                                                                                 lowering.typedIr,
                                                                                 typedFn.sourcePath,
                                                                                 nestedSlotName,
                                                                                 nestedResultType)
                            if nestedSlot >= 0 &&
                               PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                                       slotNames,
                                                                       lowering,

                                                                       typedFn,
                                                                       irFunction,
                                                                       varI32ParamNames,
                                                                       argText,
                                                                       nestedSlot,
                                                                       lineNumber,
                                                                       nestedCallNodeIndex,
                                                                       callOrdinal):
                                argText = nestedSlotName
                                changedArgs = true
            add(materializedArgs, argText)
        if changedArgs:
            callArgsText = strutil.Join(materializedArgs, ",")
            callExpr = strutil.Join([callHead, "(", callArgsText, ")"], "")
    let callResultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"#return_call_cmp_result#{lineNumber}",
                                                       coreir.LocalI32Tag)
    if callResultSlot < 0 ||
       !PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                               slotNames,
                                               lowering,

                                               typedFn,
                                               irFunction,
                                               varI32ParamNames,
                                               callExpr,
                                               callResultSlot,
                                               lineNumber,
                                               callNodeIndex,
                                               callOrdinal):
        return false
    let zeroSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"#return_call_cmp_zero#{lineNumber}",
                                                 coreir.LocalI32Tag)
    if zeroSlot < 0:
        return false
    var zeroOp: coreir.BodyOp
    zeroOp.kind = coreir.BodyOpLoadConstTag
    zeroOp.target = zeroSlot
    add(zeroOp.operands, coreir.LocalI32Tag)
    add(zeroOp.operands, 0)
    let _ = coreir.BodyIRAppendOp(bodyIR, zeroOp)
    var cbrTerm: coreir.BodyTerm
    cbrTerm.kind = coreir.BodyTermCbrTag
    cbrTerm.conditionKind = coreir.BodyCondI32EqTag
    cbrTerm.lhsSlot = callResultSlot
    cbrTerm.rhsSlot = zeroSlot
    cbrTerm.resultSlot = -1
    cbrTerm.trueBlock = bodyIR.blocks.len + 1
    cbrTerm.falseBlock = bodyIR.blocks.len + 2
    let cbrTermIndex = coreir.BodyIRAppendTerm(bodyIR, cbrTerm)
    let cbrBlockOpCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, cbrBlockOpCount, cbrTermIndex)
    currentBlockStart = bodyIR.ops.len
    if trueWhenZero:
        PrimaryBodyIrAppendReturnTerm(bodyIR, currentBlockStart, -1, coreir.LocalI32Tag, 1, true)
        PrimaryBodyIrAppendReturnTerm(bodyIR, currentBlockStart, -1, coreir.LocalI32Tag, 0, true)
    else:
        PrimaryBodyIrAppendReturnTerm(bodyIR, currentBlockStart, -1, coreir.LocalI32Tag, 0, true)
        PrimaryBodyIrAppendReturnTerm(bodyIR, currentBlockStart, -1, coreir.LocalI32Tag, 1, true)
    return true

@borrows
fn PrimaryBodyIrAppendReturnScalarContext(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          varI32ParamNames: str[],
                                          typedIr: texpr.TypedExprIr,
                                          typedFn: texpr.TypedExprIrFunction,
                                          irFunction: lower.PrimaryObjectIrFunction,
                                          sourcePath: str,
                                          lineNumber: int32,
                                          valText: str,
                                          returnTypeKind: int32,
                                          currentBlockStart: var int32): bool =
    # Scalar return values resolve through the context-aware resolver first
    # so ptr->field reads emit their loads; otherwise the bool-condition
    # lowering would clamp arbitrary int returns to 0/1.
    if returnTypeKind != coreir.LocalI32Tag &&
       returnTypeKind != coreir.LocalI64Tag &&
       returnTypeKind != coreir.LocalPtrTag:
        return false
    # 仅真 bl 调用面才不可经此急切求值；内联数值/指针 cast（uint64(...)）与
    # 分组括号无副作用，可在上下文标量求值器内安全下降，否则
    # `(uint64(p->f) << n) | uint64(x)` 这类 u64 位运算 return 会被
    # 粗粒度括号探测误判为调用面而 bail 回退 cold（wcz）。
    if PrimaryBodyIrTextHasRealCallSurface(valText):
        return false
    if !strutil.Contains(valText, "->"):
        return false
    var returnScalarOrdinal: int32 = -1
    let returnScalarSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      typedIr,
                                                                      typedFn,
                                                                      irFunction,
                                                                      sourcePath,
                                                                      lineNumber,
                                                                      valText,
                                                                      returnTypeKind)
    if returnScalarSlot < 0:
        return false
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  returnScalarSlot,
                                  returnTypeKind,
                                  0,
                                  false)
    return true

@borrows
fn PrimaryBodyIrAppendReturnBoolCondition(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          lowering: var lower.LoweringPlanStub,
                                          typedFn: texpr.TypedExprIrFunction,
                                          irFunction: lower.PrimaryObjectIrFunction,
                                          sourcePath: str,
                                          lineNumber: int32,
                                          returnExprRaw: str,
                                          currentBlockStart: var int32,
                                          callOrdinal: var int32,
                                          nextOpIndex: var int32): bool =
    let returnExpr = PrimaryBodyIrStripOuterParens(returnExprRaw)
    if returnExpr == "":
        return false
    if texpr.TypedExprNormalizeTypeText(typedFn.returnType) != "bool":
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"phase=return_bool_cond_skip function={typedFn.functionName} return_type={typedFn.returnType} expr={returnExpr}")
        return false
    let conditionBlockCount = PrimaryBodyIrConditionCbrBlockCount(returnExpr)
    if conditionBlockCount <= 0:
        return false
    let successBlock = bodyIR.blocks.len + conditionBlockCount
    var pendingFailureTerms: int32[]
    if !PrimaryBodyIrEmitConditionCbrChain(bodyIR,
                                          slotNames,
                                          lowering,

                                          typedFn,
                                          irFunction,
                                          sourcePath,
                                          lineNumber,
                                          returnExpr,
                                          successBlock,
                                          -1,
                                          callOrdinal,
                                          nextOpIndex,
                                          currentBlockStart,
                                          pendingFailureTerms):
        return false
    let failureBlock = successBlock + 1
    for failureIndex in 0..<pendingFailureTerms.len:
        let termIndex = pendingFailureTerms[failureIndex]
        if termIndex >= 0 && termIndex < bodyIR.terms.len:
            PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, termIndex)
            bodyIR.terms[termIndex].falseBlock = failureBlock
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  -1,
                                  coreir.LocalI32Tag,
                                  1,
                                  true)
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  -1,
                                  coreir.LocalI32Tag,
                                  0,
                                  true)
    return true

@borrows
fn PrimaryBodyIrTextIsPlainArrowField(textRaw: str): bool =
    # 只将单层 `ptr->field` 交给箭头字段物化器。整调用如
    # `cheng_seq_set(seqInst->buffer, ...)` 含箭头但不是该形态，必须留给
    # whole-call realizer。
    let text = strutil.Strip(textRaw)
    let n = len(text)
    if n < 4:
        return false
    var arrowPos: int32 = -1
    var i = 0
    while i + 1 < n:
        if text[i] == '-' && text[i + 1] == '>':
            if arrowPos >= 0:
                return false
            arrowPos = i
            i = i + 2
            continue
        i = i + 1
    if arrowPos <= 0 || arrowPos + 2 >= n:
        return false
    let rootName = strutil.Strip(strings.SliceBytes(text, 0, arrowPos))
    let fieldName = strutil.Strip(
        strings.SliceBytes(text, arrowPos + 2, n - arrowPos - 2))
    return texpr.TypedExprTextIsSimpleIdent(rootName) &&
           texpr.TypedExprTextIsSimpleIdent(fieldName)

@borrows
fn PrimaryBodyIrTextHasFieldOrIndex(text: str): bool =
    var i = 0
    while i < len(text):
        if text[i] == '.':
            return true
        if text[i] == '-' && i + 1 < len(text) && text[i + 1] == '>':
            return true
        if text[i] == '[':
            # 排除泛型/数组类型占位符 [T]/[K,V]/[T;N]: '[' 后首个非空字符为大写字母
            # (真 index 首字符为数字或小写变量名), 此类 [...] 不计为 index.
            var j = i + 1
            while j < len(text) && text[j] == ' ':
                j = j + 1
            if j < len(text) && text[j] >= 'A' && text[j] <= 'Z':
                var depth = 1
                j = j + 1
                while j < len(text) && depth > 0:
                    if text[j] == '[':
                        depth = depth + 1
                    elif text[j] == ']':
                        depth = depth - 1
                    j = j + 1
                i = j
                continue
            return true
        if text[i] == ']':
            return true
        i = i + 1
    return false

@borrows
fn PrimaryBodyIrTextHasCallSurface(text: str): bool =
    for i in 0..<len(text):
        if text[i] == '(' || text[i] == ')':
            return true
    return false

@borrows
fn PrimaryBodyIrIsNumericCastHeadName(name: str): bool =
    # 数值/指针内联 cast 内建（大小写两式）：这些不下降为真 bl，无副作用、
    # 不冲寄存器——三元臂仅含这类"调用面"时无分支急切求值仍然安全。
    return name == "Int8" || name == "Int16" || name == "Int32" || name == "Int64" ||
           name == "UInt8" || name == "UInt16" || name == "UInt32" || name == "UInt64" ||
           name == "Float32" || name == "Float64" ||
           name == "int8" || name == "int16" || name == "int32" || name == "int64" ||
           name == "uint8" || name == "uint16" || name == "uint32" || name == "uint64" ||
           name == "f32" || name == "f64" || name == "bool" || name == "char" ||
           name == "ptr" || name == "cstring" ||
           name == "UInt8Ptr" || name == "Int32Ptr" || name == "UInt32Ptr" ||
           name == "UInt64Ptr" || name == "Int64Ptr" || name == "VoidPtrPtr" ||
           name == "sizeof"

# 真调用面探测：text 含一个下降为真 bl 的函数调用（区别于内联数值/指针 cast
# 与分组括号）。三元臂含真调用时急切两臂求值不安全(未选中臂的 bl 也执行、冲
# cond 槽)，必须走真分支；仅含 cast/分组括号时无分支快路径仍安全。
@borrows
fn PrimaryBodyIrTextHasRealCallSurface(text: str): bool =
    var i = 0
    while i < len(text):
        if text[i] == '(':
            # 回扫紧邻 '(' 之前的标识符段（调用头尾名）。
            var headEnd = i
            var headStart = i
            while headStart > 0:
                let prev = text[headStart - 1]
                if (prev >= 'a' && prev <= 'z') ||
                   (prev >= 'A' && prev <= 'Z') ||
                   (prev >= '0' && prev <= '9') ||
                   prev == '_':
                    headStart = headStart - 1
                else:
                    break
            if headStart < headEnd:
                let headName = strings.SliceBytes(text, headStart, headEnd - headStart)
                # 点限定头（如 strings.Len）必为真调用。
                var dotted = false
                if headStart > 0 && text[headStart - 1] == '.':
                    dotted = true
                if dotted || !PrimaryBodyIrIsNumericCastHeadName(headName):
                    return true
            # 否则是分组括号或 cast 头：继续扫描，可能仍有真调用嵌套其中。
        i = i + 1
    return false

# T78 短路契约根修：HasRealCallSurface 只扫 '(' 识别调用，不识别 '[' 下标——
# `i < arr.len && arr[i]` 的 rhs 被判"无真调用可安全 eager 求值"，实际下标读
# 本身可越界故障(SIGSEGV)，与真调用同属"不可无分支急切求值"的操作数类。
# 新谓词=调用 OR 下标，只替换 CondValue01Slot 内部的 &&/|| eager-safety 门；
# 不改 HasRealCallSurface 本身（三元/其余~13 处调用点问的是"有没有真调用"，
# 语义不同，扩大会误伤——见调用点审计）。
@borrows
fn PrimaryBodyIrTextHasFaultingEagerSurface(text: str): bool =
    if PrimaryBodyIrTextHasRealCallSurface(text):
        return true
    var i = 0
    while i < len(text):
        if text[i] == '[':
            return true
        i = i + 1
    return false

# True when `text` is a single bare whole-call `head(args)` — the first top-level
# `(` opens right after a plain qualified call head and its matching `)` closes at
# the very end. A call-containing binop chain (`f(a) + f(b)`) is NOT bare: its
# matching paren closes mid-text, so AppendWholeCallExprToSlot would bail and emit
# only the first call. Callers use this to route nested call-sums to the recursive
# scalar resolver instead.
@borrows
fn PrimaryBodyIrTextIsBareWholeCall(textRaw: str): bool =
    let text = strutil.Strip(textRaw)
    if text == "" || text[len(text) - 1] != ')':
        return false
    let openPos = texpr.TypedExprFindWholeCallOpenParen(text)
    if openPos <= 0:
        return false
    let closePos = texpr.TypedExprFindMatchingParen(text, openPos)
    if closePos != len(text) - 1:
        return false
    let head = strutil.Strip(strings.SliceBytes(text, 0, openPos))
    return texpr.TypedExprCallHeadIsPlainQualifiedIdent(head)

# Indexed-root field LHS, e.g. `xs[i].field`. The typed layer splits the root
# index off into stmt.assignRootName="xs" (the bare ident) so the structured
# fields carry NO index — only the full LHS in stmt.bindingName has it. Recover
# the index expression text from bindingName: split at the top-level `.`
# (bracket-aware), then peel the `[...]` off the root segment. Returns true and
# fills indexOut with the inner index text when the root segment is subscripted.
fn PrimaryBodyIrAssignLhsRootIndexText(bindingNameRaw: str,
                                        rootIdent: str,
                                        indexOut: var str): bool =
    indexOut = ""
    let bindingName = strutil.Strip(bindingNameRaw)
    if bindingName == "" || rootIdent == "":
        return false
    # Top-level (bracket-aware) `.` separates the root segment from the field
    # tail. The root segment is everything before it.
    var depth = 0
    var dotPos = -1
    var i = 0
    while i < len(bindingName):
        let ch = bindingName[i]
        if ch == '[' || ch == '(':
            depth = depth + 1
        elif ch == ']' || ch == ')':
            if depth > 0:
                depth = depth - 1
        elif depth == 0 && ch == '.':
            dotPos = i
            break
        i = i + 1
    if dotPos <= 0:
        return false
    let rootSegment = strutil.Strip(strings.SliceBytes(bindingName, 0, dotPos))
    # Root segment must be exactly `rootIdent[<index>]` (subscripted root). A
    # bare `rootIdent` (no subscript) or a `rootIdent.sub` chain is not this
    # form and must be left to the existing field-store path.
    if !PrimaryStartsWith(rootSegment, rootIdent):
        return false
    let afterRoot = strings.SliceBytes(rootSegment, len(rootIdent), len(rootSegment) - len(rootIdent))
    if len(afterRoot) < 3 || afterRoot[0] != '[':
        return false
    if strings.SliceBytes(afterRoot, len(afterRoot) - 1, 1) != "]":
        return false
    let inner = strutil.Strip(strings.SliceBytes(afterRoot, 1, len(afterRoot) - 2))
    if inner == "" ||
       parser.ParserFindText(inner, "[") >= 0 ||
       parser.ParserFindText(inner, "]") >= 0:
        return false
    indexOut = strings.CloneStr(inner)
    return true

# Real element-address field store for `xs[i].field = v` where `xs` is a
# fixed-length array of structs (root type `Elem[N]`). The array storage is
# inline, so the element address is `base_addr + idx*elemStride`; we then
# FieldStore the value at `elemAddr + fieldOffset`. Without this the index is
# dropped and every `xs[k].field` writes element 0's field (a real miscompile).
# Returns false (leaving bodyIR untouched of a committed store) when the shape
# is not a fixed-array indexed-root field store, so callers can fall through.
@borrows
fn PrimaryBodyIrAppendFixedArrayIndexedFieldStore(bodyIR: var coreir.BodyIR,
                                                   slotNames: var str[],
                                                   typedIr: texpr.TypedExprIr,
                                                   sourcePath: str,
                                                   lineNumber: int32,
                                                   rootType: str,
                                                   indexText: str,
                                                   baseSlot: int32,
                                                   valueSlot: int32,
                                                   fieldOffsetBytes: int32,
                                                   fieldSizeBytes: int32,
                                                   varI32ParamNames: str[],
                                                   callOrdinal: var int32): bool =
    if baseSlot < 0 || valueSlot < 0 || fieldSizeBytes <= 0 || indexText == "":
        return false
    let elemType = PrimaryBodyIrIndexedElementTypeText(rootType)
    if elemType == "":
        return false
    # Reject dynamic seqs — their element buffer is behind a header pointer; only
    # fixed `Elem[N]` arrays have inline storage addressed off the base slot.
    if PrimaryBodyIrTypeTextIsDynamicSeq(rootType):
        return false
    var elemKind: int32
    var elemSize: int32
    var elemAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, elemType, elemKind, elemSize, elemAlign)
    if elemKind != coreir.LocalAggregateTag || elemSize <= 0:
        return false
    if fieldOffsetBytes < 0 || fieldOffsetBytes + fieldSizeBytes > elemSize:
        return false
    # base address ptr: aggregate local slot value already yields its address,
    # so `base + 0` materializes the array start as a ptr.
    let baseAddrSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR, slotNames, lineNumber, baseSlot, 0)
    if baseAddrSlot < 0:
        return false
    let idxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      typedIr,
                                                      sourcePath,
                                                      indexText,
                                                      coreir.LocalI32Tag,
                                                      callOrdinal)
    if idxSlot < 0:
        return false
    let eszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"#fae_esz#{lineNumber}#{bodyIR.ops.len}",
                                                  coreir.LocalI64Tag,
                                                  elemSize)
    let addrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"#fae_addr#{lineNumber}#{bodyIR.ops.len}",
                                                 coreir.LocalPtrTag)
    if eszSlot < 0 || addrSlot < 0:
        return false
    var addrOp: coreir.BodyOp
    addrOp.kind = coreir.BodyOpBinOpTag
    addrOp.target = addrSlot
    add(addrOp.operands, coreir.LocalI64Tag)
    add(addrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
    add(addrOp.operands, idxSlot)
    add(addrOp.operands, eszSlot)
    add(addrOp.operands, baseAddrSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, addrOp)
    var storeOp: coreir.BodyOp
    storeOp.kind = coreir.BodyOpFieldStoreTag
    storeOp.target = addrSlot
    add(storeOp.operands, addrSlot)
    add(storeOp.operands, valueSlot)
    add(storeOp.operands, fieldOffsetBytes)
    add(storeOp.operands, fieldSizeBytes)
    let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
    return true

# Nested indexed-field store `arr[i].field[j] = v` where `arr` is a fixed array
# of structs and `field` is itself a fixed inline scalar array inside the struct.
# The structured root name kept only `arr` and the field tail kept only `field[j]`,
# so the existing indexed-field arm stores at the bare root base + fieldOffset,
# SILENTLY DROPPING the outer `[i]` — every element writes element 0's field-array
# (a real miscompile). Recover the outer index and build the full inline address:
#   &arr           = base
#   &arr[i]        = base + i*elemSize          (madd)
#   &arr[i].field  = &arr[i] + fieldOffset      (add)
#   &arr[i].f[j]   = &arr[i].field + j*fElemSz  (madd)
# then FieldStore v there (offset 0, width fElemSz). Returns false — no store
# committed — when the shape is not this clean fixed/fixed nesting with a scalar
# inner element, so the caller can honestly poison rather than drop the index.
@borrows
fn PrimaryBodyIrAppendNestedFixedArrayIndexedFieldStore(bodyIR: var coreir.BodyIR,
                                                        slotNames: var str[],
                                                        typedIr: texpr.TypedExprIr,
                                                        typedFn: texpr.TypedExprIrFunction,
                                                        irFunction: lower.PrimaryObjectIrFunction,
                                                        sourcePath: str,
                                                        lineNumber: int32,
                                                        rootName: str,
                                                        rootTypeHint: str,
                                                        outerIndexText: str,
                                                        fieldName: str,
                                                        innerIndexText: str,
                                                        rhsText: str,
                                                        baseSlot: int32,
                                                        varI32ParamNames: str[],
                                                        callOrdinal: var int32): bool =
    if baseSlot < 0 || outerIndexText == "" || innerIndexText == "" || fieldName == "":
        return false
    # Root must be a fixed array of structs (inline element storage). Dynamic
    # seqs keep their elements behind a header pointer — reject so caller poisons.
    # The stmt-resolved rootTypeHint is the array type (`Elem[N]`) for both global
    # and local roots (BindingTypeForName only resolves locals); prefer it and
    # fall back to the binding lookup only when the hint is not an indexable array.
    var rootType = texpr.TypedExprStripVarType(rootTypeHint)
    if rootType == "" ||
       PrimaryBodyIrTypeTextIsDynamicSeq(rootType) ||
       PrimaryBodyIrIndexedElementTypeText(rootType) == "":
        rootType = texpr.TypedExprStripVarType(PrimaryBodyIrBindingTypeForName(typedIr,
                                                                               typedFn,
                                                                               irFunction,
                                                                               lineNumber,
                                                                               rootName))
    if rootType == "" || PrimaryBodyIrTypeTextIsDynamicSeq(rootType):
        return false
    let elemType = PrimaryBodyIrIndexedElementTypeText(rootType)
    if elemType == "":
        return false
    var elemKind: int32
    var elemSize: int32
    var elemAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, elemType, elemKind, elemSize, elemAlign)
    if elemKind != coreir.LocalAggregateTag || elemSize <= 0:
        return false
    # Mid field: a fixed inline scalar array inside the element.
    var fieldType = ""
    var fieldOffsetBytes: int32
    var fieldSizeBytes: int32
    var fieldAlignBytes: int32
    if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                           sourcePath,
                                           elemType,
                                           fieldName,
                                           fieldType,
                                           fieldOffsetBytes,
                                           fieldSizeBytes,
                                           fieldAlignBytes):
        return false
    if fieldOffsetBytes < 0 || fieldSizeBytes <= 0 || fieldOffsetBytes + fieldSizeBytes > elemSize:
        return false
    if PrimaryBodyIrTypeTextIsDynamicSeq(fieldType):
        return false
    var fieldElemKind: int32
    var fieldElemSize: int32
    if !PrimaryBodyIrSeqElementShapeFromText(typedIr, sourcePath, fieldType, fieldElemKind, fieldElemSize):
        return false
    if fieldElemSize <= 0 || fieldOffsetBytes + fieldElemSize > elemSize:
        return false
    # Scalar inner element only (i32/i64/ptr, or byte via i32). Aggregate/str
    # inner elements are out of surgical scope — reject so the caller poisons.
    var valueKind = fieldElemKind
    if fieldElemSize == 1:
        valueKind = coreir.LocalI32Tag
    if valueKind != coreir.LocalI32Tag &&
       valueKind != coreir.LocalI64Tag &&
       valueKind != coreir.LocalPtrTag:
        return false
    var valueText = rhsText
    if fieldElemSize == 1:
        let u8Inner = PrimaryBodyIrTypeCastInnerForTarget(rhsText, "uint8")
        if u8Inner != "":
            valueText = u8Inner
    var valueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                        slotNames,
                                                        varI32ParamNames,
                                                        typedIr,
                                                        sourcePath,
                                                        valueText,
                                                        valueKind,
                                                        callOrdinal)
    if valueSlot < 0:
        valueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               typedIr,
                                                               typedFn,
                                                               irFunction,
                                                               sourcePath,
                                                               lineNumber,
                                                               valueText,
                                                               valueKind)
    if valueSlot < 0 || PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < fieldElemSize:
        return false
    # Address chain (all inline).
    let baseAddrSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR, slotNames, lineNumber, baseSlot, 0)
    if baseAddrSlot < 0:
        return false
    let outerIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          typedIr,
                                                          sourcePath,
                                                          outerIndexText,
                                                          coreir.LocalI32Tag,
                                                          callOrdinal)
    if outerIdxSlot < 0:
        return false
    let elemSzSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#nfae_esz#{lineNumber}#{bodyIR.ops.len}",
                                                    coreir.LocalI64Tag,
                                                    elemSize)
    let elemAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#nfae_eaddr#{lineNumber}#{bodyIR.ops.len}",
                                                    coreir.LocalPtrTag)
    if elemSzSlot < 0 || elemAddrSlot < 0:
        return false
    var elemAddrOp: coreir.BodyOp
    elemAddrOp.kind = coreir.BodyOpBinOpTag
    elemAddrOp.target = elemAddrSlot
    add(elemAddrOp.operands, coreir.LocalI64Tag)
    add(elemAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
    add(elemAddrOp.operands, outerIdxSlot)
    add(elemAddrOp.operands, elemSzSlot)
    add(elemAddrOp.operands, baseAddrSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, elemAddrOp)
    let fieldArrAddrSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR, slotNames, lineNumber, elemAddrSlot, fieldOffsetBytes)
    if fieldArrAddrSlot < 0:
        return false
    let innerIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          typedIr,
                                                          sourcePath,
                                                          innerIndexText,
                                                          coreir.LocalI32Tag,
                                                          callOrdinal)
    if innerIdxSlot < 0:
        return false
    let felemSzSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#nfae_fesz#{lineNumber}#{bodyIR.ops.len}",
                                                     coreir.LocalI64Tag,
                                                     fieldElemSize)
    let innerAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#nfae_iaddr#{lineNumber}#{bodyIR.ops.len}",
                                                     coreir.LocalPtrTag)
    if felemSzSlot < 0 || innerAddrSlot < 0:
        return false
    var innerAddrOp: coreir.BodyOp
    innerAddrOp.kind = coreir.BodyOpBinOpTag
    innerAddrOp.target = innerAddrSlot
    add(innerAddrOp.operands, coreir.LocalI64Tag)
    add(innerAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
    add(innerAddrOp.operands, innerIdxSlot)
    add(innerAddrOp.operands, felemSzSlot)
    add(innerAddrOp.operands, fieldArrAddrSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, innerAddrOp)
    var nestedStoreOp: coreir.BodyOp
    nestedStoreOp.kind = coreir.BodyOpFieldStoreTag
    nestedStoreOp.target = innerAddrSlot
    add(nestedStoreOp.operands, innerAddrSlot)
    add(nestedStoreOp.operands, valueSlot)
    add(nestedStoreOp.operands, 0)
    add(nestedStoreOp.operands, fieldElemSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, nestedStoreOp)
    return true

# Element-address field store for `xs[i].field = v` where `xs` is a *dynamic
# seq* of structs (root type `Elem[]` / `seq[Elem]`). Unlike the fixed-array
# form the element storage lives behind the seq header's data pointer, so the
# element address is `*(base + 8) + idx*elemSize`; we then FieldStore the value
# at `elemAddr + fieldOffset`. The header layout is {len: i64 @0, data: ptr @8}.
# Returns false (no store committed) when the shape does not apply.
@borrows
fn PrimaryBodyIrAppendDynamicSeqIndexedFieldStore(bodyIR: var coreir.BodyIR,
                                                  slotNames: var str[],
                                                  typedIr: texpr.TypedExprIr,
                                                  sourcePath: str,
                                                  lineNumber: int32,
                                                  rootType: str,
                                                  indexText: str,
                                                  baseSlot: int32,
                                                  valueSlot: int32,
                                                  fieldOffsetBytes: int32,
                                                  fieldSizeBytes: int32,
                                                  varI32ParamNames: str[],
                                                  callOrdinal: var int32): bool =
    if baseSlot < 0 || valueSlot < 0 || fieldSizeBytes <= 0 || indexText == "":
        return false
    if !PrimaryBodyIrTypeTextIsDynamicSeq(rootType):
        return false
    let elemType = PrimaryBodyIrIndexedElementTypeText(rootType)
    if elemType == "":
        return false
    var elemKind: int32
    var elemSize: int32
    var elemAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, elemType, elemKind, elemSize, elemAlign)
    if elemKind != coreir.LocalAggregateTag || elemSize <= 0:
        return false
    if fieldOffsetBytes < 0 || fieldOffsetBytes + fieldSizeBytes > elemSize:
        return false
    # Load the seq buffer pointer from the header (base + 8).
    let bufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                slotNames,
                                                Fmt"#dsfs_buf#{lineNumber}#{bodyIR.ops.len}",
                                                coreir.LocalPtrTag)
    if bufSlot < 0:
        return false
    var bufLoadOp: coreir.BodyOp
    bufLoadOp.kind = coreir.BodyOpFieldLoadTag
    bufLoadOp.target = bufSlot
    add(bufLoadOp.operands, baseSlot)
    add(bufLoadOp.operands, bufSlot)
    add(bufLoadOp.operands, 8)
    add(bufLoadOp.operands, 8)
    let _ = coreir.BodyIRAppendOp(bodyIR, bufLoadOp)
    let idxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      typedIr,
                                                      sourcePath,
                                                      indexText,
                                                      coreir.LocalI32Tag,
                                                      callOrdinal)
    if idxSlot < 0:
        return false
    let eszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"#dsfs_esz#{lineNumber}#{bodyIR.ops.len}",
                                                  coreir.LocalI64Tag,
                                                  elemSize)
    let addrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"#dsfs_addr#{lineNumber}#{bodyIR.ops.len}",
                                                 coreir.LocalPtrTag)
    if eszSlot < 0 || addrSlot < 0:
        return false
    # elemAddr = idx*elemSize + buf (Madd: a*b + c).
    var addrOp: coreir.BodyOp
    addrOp.kind = coreir.BodyOpBinOpTag
    addrOp.target = addrSlot
    add(addrOp.operands, coreir.LocalI64Tag)
    add(addrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
    add(addrOp.operands, idxSlot)
    add(addrOp.operands, eszSlot)
    add(addrOp.operands, bufSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, addrOp)
    var storeOp: coreir.BodyOp
    storeOp.kind = coreir.BodyOpFieldStoreTag
    storeOp.target = addrSlot
    add(storeOp.operands, addrSlot)
    add(storeOp.operands, valueSlot)
    add(storeOp.operands, fieldOffsetBytes)
    add(storeOp.operands, fieldSizeBytes)
    let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
    return true

# Element-address field load for `xs[i].field` where `xs` is a fixed-length
# array of structs. Mirror of the store path: elemAddr = base_addr + idx*stride,
# then FieldLoad at elemAddr + fieldOffset into a typed value slot. Returns the
# value slot, or -1 when the shape does not apply.
@borrows
fn PrimaryBodyIrFixedArrayIndexedFieldValueSlot(bodyIR: var coreir.BodyIR,
                                                 slotNames: var str[],
                                                 varI32ParamNames: str[],
                                                 typedIr: texpr.TypedExprIr,
                                                 typedFn: texpr.TypedExprIrFunction,
                                                 irFunction: lower.PrimaryObjectIrFunction,
                                                 sourcePath: str,
                                                 lineNumber: int32,
                                                 textRaw: str,
                                                 callOrdinal: var int32): int32 =
    let text = strutil.Strip(textRaw)
    # Split off the trailing `.field` at the top level (bracket-aware).
    var depth = 0
    var dotPos = -1
    var i = len(text) - 1
    while i >= 0:
        let ch = text[i]
        if ch == ']' || ch == ')':
            depth = depth + 1
        elif ch == '[' || ch == '(':
            if depth > 0:
                depth = depth - 1
        elif depth == 0 && ch == '.':
            dotPos = i
            break
        i = i - 1
    if dotPos <= 0 || dotPos + 1 >= len(text):
        return -1
    let rootSegment = strutil.Strip(strings.SliceBytes(text, 0, dotPos))
    let fieldName = strutil.Strip(strings.SliceBytes(text, dotPos + 1, len(text) - dotPos - 1))
    if rootSegment == "" || fieldName == "" || parser.ParserFindText(fieldName, "[") >= 0:
        return -1
    var rootIdent = ""
    var indexText = ""
    if !PrimaryBodyIrIndexExprParts(rootSegment, rootIdent, indexText):
        return -1
    if PrimaryBodyIrTextHasDot(rootIdent):
        return -1
    let rootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rootIdent)
    if rootSlot < 0 ||
       rootSlot >= bodyIR.localSlots.len ||
       (bodyIR.localSlots[rootSlot].typeKind != coreir.LocalAggregateTag &&
        !(bodyIR.localSlots[rootSlot].typeKind == coreir.LocalPtrTag &&
          PrimaryBodyIrLocalIsParam(bodyIR.localSlots[rootSlot]))):
        return -1
    let rootType = texpr.TypedExprStripVarType(PrimaryBodyIrBindingTypeForName(typedIr,
                                                                               typedFn,
                                                                               irFunction,
                                                                               lineNumber,
                                                                               rootIdent))
    if PrimaryBodyIrTypeTextIsDynamicSeq(rootType):
        return -1
    let elemType = PrimaryBodyIrIndexedElementTypeText(rootType)
    if elemType == "":
        return -1
    var elemKind: int32
    var elemSize: int32
    var elemAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, elemType, elemKind, elemSize, elemAlign)
    if elemKind != coreir.LocalAggregateTag || elemSize <= 0:
        return -1
    var fieldType = ""
    var fieldOffsetBytes: int32
    var fieldSizeBytes: int32
    var fieldAlignBytes: int32
    if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                           sourcePath,
                                           elemType,
                                           fieldName,
                                           fieldType,
                                           fieldOffsetBytes,
                                           fieldSizeBytes,
                                           fieldAlignBytes):
        return -1
    if fieldSizeBytes <= 0 || fieldOffsetBytes < 0 || fieldOffsetBytes + fieldSizeBytes > elemSize:
        return -1
    let baseAddrSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR, slotNames, lineNumber, rootSlot, 0)
    if baseAddrSlot < 0:
        return -1
    let idxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      typedIr,
                                                      sourcePath,
                                                      indexText,
                                                      coreir.LocalI32Tag,
                                                      callOrdinal)
    if idxSlot < 0:
        return -1
    let eszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"#fael_esz#{lineNumber}#{bodyIR.ops.len}",
                                                  coreir.LocalI64Tag,
                                                  elemSize)
    let addrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"#fael_addr#{lineNumber}#{bodyIR.ops.len}",
                                                 coreir.LocalPtrTag)
    if eszSlot < 0 || addrSlot < 0:
        return -1
    var addrOp: coreir.BodyOp
    addrOp.kind = coreir.BodyOpBinOpTag
    addrOp.target = addrSlot
    add(addrOp.operands, coreir.LocalI64Tag)
    add(addrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
    add(addrOp.operands, idxSlot)
    add(addrOp.operands, eszSlot)
    add(addrOp.operands, baseAddrSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, addrOp)
    let valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                       slotNames,
                                                       typedIr,
                                                       sourcePath,
                                                       Fmt"#fael_val#{lineNumber}#{bodyIR.ops.len}",
                                                       fieldType)
    if valueSlot < 0:
        return -1
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < fieldSizeBytes:
        return -1
    var fieldLoadOp: coreir.BodyOp
    fieldLoadOp.kind = coreir.BodyOpFieldLoadTag
    fieldLoadOp.target = valueSlot
    add(fieldLoadOp.operands, addrSlot)
    add(fieldLoadOp.operands, valueSlot)
    add(fieldLoadOp.operands, fieldOffsetBytes)
    add(fieldLoadOp.operands, fieldSizeBytes)
    let _ = coreir.BodyIRAppendOp(bodyIR, fieldLoadOp)
    return valueSlot

# Parse a `arrayField[idx].subField` field path (the LHS/RHS tail under a struct
# root, e.g. `b.cells[2].x` has fieldPath `cells[2].x`). Splits into the array
# field name, the index expression text, and the trailing scalar subfield name.
# Returns false for any other shape (no index or no trailing field) so callers
# fall through to their existing paths. This is the
# `struct.arrayOfStruct[idx].field` shape that `[idx]`-trailing and bare-root
# handlers both miss — without it the index AND the inner offset collapse to a
# single static field offset (a real miscompile: every element writes elem 0).
@borrows
fn PrimaryBodyIrFieldArrayIndexedSubFieldParts(fieldPathRaw: str,
                                               arrayFieldOut: var str,
                                               indexOut: var str,
                                               subFieldOut: var str): bool =
    arrayFieldOut = ""
    indexOut = ""
    subFieldOut = ""
    let fieldPath = strutil.Strip(fieldPathRaw)
    let openPos = parser.ParserFindText(fieldPath, "[")
    if openPos <= 0:
        return false
    var closePos = -1
    var scan = openPos
    var depth: int32
    while scan < len(fieldPath):
        if fieldPath[scan] == '[':
            depth = depth + 1
        elif fieldPath[scan] == ']':
            depth = depth - 1
            if depth == 0:
                closePos = scan
                break
        scan = scan + 1
    if closePos <= openPos:
        return false
    # The trailing `.subField` must immediately follow the close bracket.
    if closePos + 2 >= len(fieldPath) || fieldPath[closePos + 1] != '.':
        return false
    let arrayField = strutil.Strip(strings.SliceBytes(fieldPath, 0, openPos))
    let indexText = strutil.Strip(strings.SliceBytes(fieldPath,
                                                     openPos + 1,
                                                     closePos - openPos - 1))
    let subField = strutil.Strip(strings.SliceBytes(fieldPath,
                                                    closePos + 2,
                                                    len(fieldPath) - closePos - 2))
    # Reject names that are not single segments (no dots/brackets in array name
    # or subfield). The index expression may itself contain an indexed read such
    # as `bucketTails[bucket]`; it is lowered through the indexed-member walker.
    if arrayField == "" || indexText == "" || subField == "":
        return false
    if PrimaryBodyIrTextHasDot(arrayField) ||
       PrimaryBodyIrTextHasDot(subField) ||
       parser.ParserFindText(subField, "[") >= 0 ||
       parser.ParserFindText(arrayField, "[") >= 0:
        return false
    # The trailing subfield must be a bare identifier. A subfield text carrying a
    # top-level operator (`weight + 1`, `weight * 2`) means the surface form is a
    # compound `arr[idx].field OP rhs`, not a pure element-field read; matching it
    # here swallows the operator and stores/reads only the bare field (a real RMW
    # miscompile: `bag.items[K].weight = bag.items[K].weight + 1` dropped the +1).
    # Refuse so the binop-splitting value path lowers the operator correctly.
    if !texpr.TypedExprTextIsSimpleIdent(subField):
        return false
    arrayFieldOut = strings.CloneStr(arrayField)
    indexOut = strings.CloneStr(indexText)
    subFieldOut = strings.CloneStr(subField)
    return true

# Build the element address slot for `root.arrayField[idx]` where `arrayField`
# is a fixed `Elem[N]` array field of the `root` struct (inline storage). The
# address is `fieldBaseAddr(root) + arrayFieldOffset + idx*elemStride`. Fills
# elemSizeOut/subfield metadata via the caller's resolved meta. Returns the ptr
# slot holding the element base, or -1 when the shape is not a fixed-array
# struct-field element address (caller falls through). Shared by the load and
# store wrappers so both compute the identical address arithmetic.
@borrows
fn PrimaryBodyIrFieldArrayIndexedElemAddrSlot(bodyIR: var coreir.BodyIR,
                                              slotNames: var str[],
                                              varI32ParamNames: str[],
                                              typedIr: texpr.TypedExprIr,
                                              typedFn: texpr.TypedExprIrFunction,
                                              irFunction: lower.PrimaryObjectIrFunction,
                                              sourcePath: str,
                                              lineNumber: int32,
                                              rootName: str,
                                              rootType: str,
                                              arrayFieldName: str,
                                              indexText: str,
                                              elemTypeOut: var str,
                                              elemSizeOut: var int32,
                                              callOrdinal: var int32): int32 =
    let baseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                          slotNames,
                                                          typedIr,
                                                          sourcePath,
                                                          rootName,
                                                          rootType)
    if baseSlot < 0:
        elemTypeOut = ""
        elemSizeOut = 0
        return -1
    return PrimaryBodyIrFieldArrayIndexedElemAddrSlotFromBase(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               typedIr,
                                                               typedFn,
                                                               irFunction,
                                                               sourcePath,
                                                               lineNumber,
                                                               baseSlot,
                                                               rootType,
                                                               arrayFieldName,
                                                               indexText,
                                                               elemTypeOut,
                                                               elemSizeOut,
                                                               callOrdinal)

# Same address arithmetic as PrimaryBodyIrFieldArrayIndexedElemAddrSlot, but
# starting from an already-materialized `baseSlot` pointer (of type `baseType`)
# instead of resolving one from a named root binding. This is the composable
# primitive: a second (or Nth) `.arrayField[idx]` hop reuses the ptr slot the
# previous hop just produced as its base, so chained indexed accesses
# (`root.a[i].b[j]`) recurse through this exact same arithmetic per hop
# instead of a bespoke multi-level parser.
@borrows
fn PrimaryBodyIrFieldArrayIndexedElemAddrSlotFromBase(bodyIR: var coreir.BodyIR,
                                                       slotNames: var str[],
                                                       varI32ParamNames: str[],
                                                       typedIr: texpr.TypedExprIr,
                                                       typedFn: texpr.TypedExprIrFunction,
                                                       irFunction: lower.PrimaryObjectIrFunction,
                                                       sourcePath: str,
                                                       lineNumber: int32,
                                                       baseSlot: int32,
                                                       baseType: str,
                                                       arrayFieldName: str,
                                                       indexText: str,
                                                       elemTypeOut: var str,
                                                       elemSizeOut: var int32,
                                                       callOrdinal: var int32): int32 =
    elemTypeOut = ""
    elemSizeOut = 0
    if baseSlot < 0:
        return -1
    # Resolve the array field within the base struct: its byte offset and type.
    var arrayFieldType = ""
    var arrayFieldOffset: int32
    var arrayFieldSize: int32
    var arrayFieldAlign: int32
    if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                           sourcePath,
                                           baseType,
                                           arrayFieldName,
                                           arrayFieldType,
                                           arrayFieldOffset,
                                           arrayFieldSize,
                                           arrayFieldAlign):
        return -1
    if arrayFieldOffset < 0 || arrayFieldSize <= 0:
        return -1
    let arrayFieldIsDynamicSeq = PrimaryBodyIrTypeTextIsDynamicSeq(arrayFieldType)
    let elemType = PrimaryBodyIrIndexedElementTypeText(arrayFieldType)
    if elemType == "":
        return -1
    var elemKind: int32
    var elemSize: int32
    var elemAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, elemType, elemKind, elemSize, elemAlign)
    if elemKind != coreir.LocalAggregateTag || elemSize <= 0:
        return -1
    var arrBaseSlot: int32 = -1
    if arrayFieldIsDynamicSeq:
        # Dynamic seq field (`xs: Elem[]`): the element storage lives behind the
        # seq header's data pointer at fieldOffset+8 (a 16-byte {len,cap,buf@+8}
        # header), not inline. Load the buffer pointer through the root base, then
        # scale the index off it — mirrors the bare `root.field[i]` dynamic-seq
        # element store. The fixed-array branch below keeps the inline base+offset.
        arrBaseSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    Fmt"#fais_buf#{lineNumber}#{bodyIR.ops.len}",
                                                    coreir.LocalPtrTag)
        if arrBaseSlot < 0:
            return -1
        var arrBufLoadOp: coreir.BodyOp
        arrBufLoadOp.kind = coreir.BodyOpFieldLoadTag
        arrBufLoadOp.target = arrBaseSlot
        add(arrBufLoadOp.operands, baseSlot)
        add(arrBufLoadOp.operands, arrBaseSlot)
        add(arrBufLoadOp.operands, arrayFieldOffset + 8)
        add(arrBufLoadOp.operands, 8)
        let _ = coreir.BodyIRAppendOp(bodyIR, arrBufLoadOp)
    else:
        # Array-field base address = root base address + arrayFieldOffset.
        arrBaseSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                       slotNames,
                                                       lineNumber,
                                                       baseSlot,
                                                       arrayFieldOffset)
    if arrBaseSlot < 0:
        return -1
    var idxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      typedIr,
                                                      sourcePath,
                                                      indexText,
                                                      coreir.LocalI32Tag,
                                                      callOrdinal)
    if idxSlot < 0:
        idxSlot = PrimaryBodyIrContextSeqIndexedScalarValueSlot(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                typedIr,
                                                                typedFn,
                                                                irFunction,
                                                                sourcePath,
                                                                lineNumber,
                                                                indexText,
                                                                coreir.LocalI32Tag,
                                                                callOrdinal)
    if idxSlot < 0 && PrimaryBodyIrTextHasFieldOrIndex(indexText):
        idxSlot = PrimaryBodyIrIndexedMemberValueSlot(bodyIR,
                                                      slotNames,
                                                      share(varI32ParamNames),
                                                      typedIr,
                                                      share(typedFn),
                                                      irFunction,
                                                      strings.CloneStr(sourcePath),
                                                      lineNumber,
                                                      indexText,
                                                      callOrdinal)
    if idxSlot < 0:
        return -1
    let eszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"#fais_esz#{lineNumber}#{bodyIR.ops.len}",
                                                  coreir.LocalI64Tag,
                                                  elemSize)
    let addrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"#fais_addr#{lineNumber}#{bodyIR.ops.len}",
                                                 coreir.LocalPtrTag)
    if eszSlot < 0 || addrSlot < 0:
        return -1
    # elemAddr = idx*elemSize + arrBase (Madd: a*b + c).
    var addrOp: coreir.BodyOp
    addrOp.kind = coreir.BodyOpBinOpTag
    addrOp.target = addrSlot
    add(addrOp.operands, coreir.LocalI64Tag)
    add(addrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
    add(addrOp.operands, idxSlot)
    add(addrOp.operands, eszSlot)
    add(addrOp.operands, arrBaseSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, addrOp)
    elemTypeOut = elemType
    elemSizeOut = elemSize
    return addrSlot

# Store path for `root.arrayField[idx].subField = v` (fixed array of structs as
# a struct field). Mirror of the bare-root `xs[i].field` store. Returns false
# (no ops committed for the store) when the shape does not apply.
@borrows
fn PrimaryBodyIrAppendFieldArrayIndexedSubFieldStore(bodyIR: var coreir.BodyIR,
                                                     slotNames: var str[],
                                                     varI32ParamNames: str[],
                                                     typedIr: texpr.TypedExprIr,
                                                     typedFn: texpr.TypedExprIrFunction,
                                                     irFunction: lower.PrimaryObjectIrFunction,
                                                     sourcePath: str,
                                                     lineNumber: int32,
                                                     rootName: str,
                                                     rootType: str,
                                                     fieldPath: str,
                                                     valueSlot: int32,
                                                     callOrdinal: var int32): bool =
    if valueSlot < 0:
        return false
    var arrayFieldName = ""
    var indexText = ""
    var subFieldName = ""
    if !PrimaryBodyIrFieldArrayIndexedSubFieldParts(fieldPath,
                                                    arrayFieldName,
                                                    indexText,
                                                    subFieldName):
        return false
    var elemType = ""
    var elemSize: int32
    let addrSlot = PrimaryBodyIrFieldArrayIndexedElemAddrSlot(bodyIR,
                                                              slotNames,
                                                              share(varI32ParamNames),
                                                              typedIr,
                                                              share(typedFn),
                                                              share(irFunction),
                                                              strings.CloneStr(sourcePath),
                                                              lineNumber,
                                                              strings.CloneStr(rootName),
                                                              rootType,
                                                              arrayFieldName,
                                                              indexText,
                                                              elemType,
                                                              elemSize,
                                                              callOrdinal)
    if addrSlot < 0 || elemType == "" || elemSize <= 0:
        return false
    # Resolve the scalar subfield within the element type.
    var subFieldType = ""
    var subFieldOffset: int32
    var subFieldSize: int32
    var subFieldAlign: int32
    if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                           sourcePath,
                                           elemType,
                                           subFieldName,
                                           subFieldType,
                                           subFieldOffset,
                                           subFieldSize,
                                           subFieldAlign):
        return false
    if subFieldOffset < 0 || subFieldSize <= 0 || subFieldOffset + subFieldSize > elemSize:
        return false
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < subFieldSize:
        return false
    var storeOp: coreir.BodyOp
    storeOp.kind = coreir.BodyOpFieldStoreTag
    storeOp.target = addrSlot
    add(storeOp.operands, addrSlot)
    add(storeOp.operands, valueSlot)
    add(storeOp.operands, subFieldOffset)
    add(storeOp.operands, subFieldSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
    return true

# Parse `arrayField1[idx1].arrayField2[idx2].subField` -- two chained
# array-index hops followed by a bare scalar leaf. Rejects anything that
# doesn't match exactly this shape (three or more hops, a non-bare subField,
# a dotted/bracketed array1 name) so the caller falls through to the existing
# single-hop path or the bail_711 poison; never a partial/best-effort match.
# Hop 2 + the leaf reuse PrimaryBodyIrFieldArrayIndexedSubFieldParts verbatim
# (identical grammar for `arrayField2[idx2].subField`).
@borrows
fn PrimaryBodyIrFieldArrayIndexedSubFieldPartsTwoLevel(fieldPathRaw: str,
                                                       arrayField1Out: var str,
                                                       index1Out: var str,
                                                       arrayField2Out: var str,
                                                       index2Out: var str,
                                                       subFieldOut: var str): bool =
    arrayField1Out = ""
    index1Out = ""
    arrayField2Out = ""
    index2Out = ""
    subFieldOut = ""
    let fieldPath = strutil.Strip(fieldPathRaw)
    let open1 = parser.ParserFindText(fieldPath, "[")
    if open1 <= 0:
        return false
    var close1 = -1
    var scan1 = open1
    var depth1: int32
    while scan1 < len(fieldPath):
        if fieldPath[scan1] == '[':
            depth1 = depth1 + 1
        elif fieldPath[scan1] == ']':
            depth1 = depth1 - 1
            if depth1 == 0:
                close1 = scan1
                break
        scan1 = scan1 + 1
    if close1 <= open1:
        return false
    if close1 + 2 >= len(fieldPath) || fieldPath[close1 + 1] != '.':
        return false
    let arrayField1 = strutil.Strip(strings.SliceBytes(fieldPath, 0, open1))
    let index1 = strutil.Strip(strings.SliceBytes(fieldPath, open1 + 1, close1 - open1 - 1))
    let rest = strutil.Strip(strings.SliceBytes(fieldPath, close1 + 2, len(fieldPath) - close1 - 2))
    if arrayField1 == "" || index1 == "" || rest == "":
        return false
    if PrimaryBodyIrTextHasDot(arrayField1) || parser.ParserFindText(arrayField1, "[") >= 0:
        return false
    if !PrimaryBodyIrFieldArrayIndexedSubFieldParts(rest,
                                                    arrayField2Out,
                                                    index2Out,
                                                    subFieldOut):
        return false
    arrayField1Out = strings.CloneStr(arrayField1)
    index1Out = strings.CloneStr(index1)
    return true

# Store path for `root.arrayField1[idx1].arrayField2[idx2].subField = v` (two
# chained array-index hops, each either a fixed `Elem[N]` field or a dynamic
# `Elem[]` seq field). Composes PrimaryBodyIrFieldArrayIndexedElemAddrSlot for
# hop 1 with PrimaryBodyIrFieldArrayIndexedElemAddrSlotFromBase for hop 2 --
# the same per-hop address arithmetic the single-hop store uses, applied
# twice. Returns false (no ops committed) when the shape does not apply.
@borrows
fn PrimaryBodyIrAppendFieldArrayIndexedSubFieldStoreTwoLevel(bodyIR: var coreir.BodyIR,
                                                             slotNames: var str[],
                                                             varI32ParamNames: str[],
                                                             typedIr: texpr.TypedExprIr,
                                                             typedFn: texpr.TypedExprIrFunction,
                                                             irFunction: lower.PrimaryObjectIrFunction,
                                                             sourcePath: str,
                                                             lineNumber: int32,
                                                             rootName: str,
                                                             rootType: str,
                                                             fieldPath: str,
                                                             valueSlot: int32,
                                                             callOrdinal: var int32): bool =
    if valueSlot < 0:
        return false
    var arrayField1 = ""
    var index1 = ""
    var arrayField2 = ""
    var index2 = ""
    var subFieldName = ""
    if !PrimaryBodyIrFieldArrayIndexedSubFieldPartsTwoLevel(fieldPath,
                                                            arrayField1,
                                                            index1,
                                                            arrayField2,
                                                            index2,
                                                            subFieldName):
        return false
    var elemType1 = ""
    var elemSize1: int32
    let addrSlot1 = PrimaryBodyIrFieldArrayIndexedElemAddrSlot(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                typedIr,
                                                                typedFn,
                                                                irFunction,
                                                                sourcePath,
                                                                lineNumber,
                                                                rootName,
                                                                rootType,
                                                                arrayField1,
                                                                index1,
                                                                elemType1,
                                                                elemSize1,
                                                                callOrdinal)
    if addrSlot1 < 0 || elemType1 == "" || elemSize1 <= 0:
        return false
    var elemType2 = ""
    var elemSize2: int32
    let addrSlot2 = PrimaryBodyIrFieldArrayIndexedElemAddrSlotFromBase(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       typedIr,
                                                                       typedFn,
                                                                       irFunction,
                                                                       sourcePath,
                                                                       lineNumber,
                                                                       addrSlot1,
                                                                       elemType1,
                                                                       arrayField2,
                                                                       index2,
                                                                       elemType2,
                                                                       elemSize2,
                                                                       callOrdinal)
    if addrSlot2 < 0 || elemType2 == "" || elemSize2 <= 0:
        return false
    var subFieldType = ""
    var subFieldOffset: int32
    var subFieldSize: int32
    var subFieldAlign: int32
    if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                           sourcePath,
                                           elemType2,
                                           subFieldName,
                                           subFieldType,
                                           subFieldOffset,
                                           subFieldSize,
                                           subFieldAlign):
        return false
    if subFieldOffset < 0 || subFieldSize <= 0 || subFieldOffset + subFieldSize > elemSize2:
        return false
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < subFieldSize:
        return false
    var storeOp2: coreir.BodyOp
    storeOp2.kind = coreir.BodyOpFieldStoreTag
    storeOp2.target = addrSlot2
    add(storeOp2.operands, addrSlot2)
    add(storeOp2.operands, valueSlot)
    add(storeOp2.operands, subFieldOffset)
    add(storeOp2.operands, subFieldSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, storeOp2)
    return true

# Read path for `root.arrayField[idx].subField` (fixed array of structs as a
# struct field). Mirror of the store; FieldLoad the scalar subfield into a typed
# value slot. Returns the value slot, or -1 when the shape does not apply.
@borrows
fn PrimaryBodyIrFieldArrayIndexedSubFieldValueSlot(bodyIR: var coreir.BodyIR,
                                                   slotNames: var str[],
                                                   varI32ParamNames: str[],
                                                   typedIr: texpr.TypedExprIr,
                                                   typedFn: texpr.TypedExprIrFunction,
                                                   irFunction: lower.PrimaryObjectIrFunction,
                                                   sourcePath: str,
                                                   lineNumber: int32,
                                                   textRaw: str,
                                                   callOrdinal: var int32): int32 =
    let text = strutil.Strip(textRaw)
    let rootName = texpr.TypedExprAssignLhsRootName(text)
    if rootName == "":
        return -1
    let fieldPath = texpr.TypedExprAssignFieldPath(text)
    var arrayFieldName = ""
    var indexText = ""
    var subFieldName = ""
    if !PrimaryBodyIrFieldArrayIndexedSubFieldParts(fieldPath,
                                                    arrayFieldName,
                                                    indexText,
                                                    subFieldName):
        return -1
    let rootType = texpr.TypedExprStripVarType(PrimaryBodyIrBindingTypeForName(typedIr,
                                                                               typedFn,
                                                                               irFunction,
                                                                               lineNumber,
                                                                               rootName))
    if rootType == "" || rootType == "unknown" || !PrimaryObjectMetadataTextStable(rootType):
        return -1
    var elemType = ""
    var elemSize: int32
    let addrSlot = PrimaryBodyIrFieldArrayIndexedElemAddrSlot(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              typedIr,
                                                              typedFn,
                                                              irFunction,
                                                              sourcePath,
                                                              lineNumber,
                                                              rootName,
                                                              rootType,
                                                              arrayFieldName,
                                                              indexText,
                                                              elemType,
                                                              elemSize,
                                                              callOrdinal)
    if addrSlot < 0 || elemType == "" || elemSize <= 0:
        return -1
    var subFieldType = ""
    var subFieldOffset: int32
    var subFieldSize: int32
    var subFieldAlign: int32
    if !PrimaryBodyIrLookupSingleFieldMeta(typedIr,
                                           sourcePath,
                                           elemType,
                                           subFieldName,
                                           subFieldType,
                                           subFieldOffset,
                                           subFieldSize,
                                           subFieldAlign):
        return -1
    if subFieldOffset < 0 || subFieldSize <= 0 || subFieldOffset + subFieldSize > elemSize:
        return -1
    let valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                       slotNames,
                                                       typedIr,
                                                       sourcePath,
                                                       Fmt"#fais_val#{lineNumber}#{bodyIR.ops.len}",
                                                       subFieldType)
    if valueSlot < 0:
        return -1
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < subFieldSize:
        return -1
    var fieldLoadOp: coreir.BodyOp
    fieldLoadOp.kind = coreir.BodyOpFieldLoadTag
    fieldLoadOp.target = valueSlot
    add(fieldLoadOp.operands, addrSlot)
    add(fieldLoadOp.operands, valueSlot)
    add(fieldLoadOp.operands, subFieldOffset)
    add(fieldLoadOp.operands, subFieldSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, fieldLoadOp)
    return valueSlot

@borrows
fn PrimaryBodyIrAppendSimpleFieldAssignFast(bodyIR: var coreir.BodyIR,
                                            slotNames: var str[],
                                            varI32ParamNames: str[],
                                            lowering: var lower.LoweringPlanStub,
                                            typedFn: texpr.TypedExprIrFunction,
                                            irFunction: lower.PrimaryObjectIrFunction,
                                            stmt: lower.PrimaryObjectIrStatement,
                                            rhsText: str,
                                            callOrdinal: var int32,
                                            currentBlockStart: var int32): bool =
    primarySlotStageProbe(bodyIR, "field_assign_enter", 35161)
    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
        # P1 consumer expand: 4→15 case label dispatch via helper (assign_field).
        let reasonLabel = texpr.TypedExprIrRhsBailReasonLabel(stmt.rhsBailReason)
        os.WriteLine(os.GetStderr(), Fmt"phase=assign_field_fast_entry fn={typedFn.functionName} line={stmt.lineNumber} reason_label={reasonLabel}")
    if stmt.assignFieldName == "" || stmt.assignRootName == "":
        return false
    var rootType = stmt.assignRootType
    PrimaryObjectPlanGuardTick()
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_field_fast_meta_begin function={typedFn.functionName} line={stmt.lineNumber} root={stmt.assignRootName} root_type_len={rootType.len} field={stmt.assignFieldName} field_type_len={stmt.assignFieldType.len} field_size={stmt.assignFieldSizeBytes}")
    if rootType == "" || rootType == "unknown" || !PrimaryObjectMetadataTextStable(rootType):
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"assign_field_fast_root_lookup_begin function={typedFn.functionName} line={stmt.lineNumber} root={stmt.assignRootName}")
        rootType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                   typedFn,
                                                   irFunction,
                                                   stmt.lineNumber,
                                                   stmt.assignRootName)
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"assign_field_fast_root_lookup_done function={typedFn.functionName} line={stmt.lineNumber} root_type_len={rootType.len}")
    if rootType == "" || rootType == "unknown" || !PrimaryObjectMetadataTextStable(rootType):
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"assign_field_fast_root_unstable function={typedFn.functionName} line={stmt.lineNumber} root_type_len={rootType.len}")
        return false
    var fieldType = stmt.assignFieldType
    var fieldOffsetBytes = stmt.assignFieldOffsetBytes
    var fieldSizeBytes = stmt.assignFieldSizeBytes
    var fieldAlignBytes: int32
    # w-wall7: the single-hop field-meta fallback below (LookupSingleFieldMeta)
    # matches by EXACT field name against the struct's registered field list —
    # it has no bracket awareness. `assignFieldName` carries the raw surface
    # text INCLUDING a trailing `[idx]` for indexed-field-assign statements
    # (`root.field[idx] = rhs`), and `idx` itself may be a dotted expression
    # (e.g. `plan.requests[plan.requestCount] = request`). A raw scan/lookup
    # against the WHOLE text (bracket and all) either false-bails on the
    # index's own dot (PrimaryBodyIrTextHasDot) or fails to match the
    # registered base field name ("requests" != "requests[plan.requestCount]").
    # Only the base field name (before the first `[`) is what the struct's
    # field table is keyed by; the bracket/index text is parsed separately by
    # the fieldBracketPos block further below.
    #
    # `fieldPathHasStructuralDot` mirrors the OLD unscoped
    # `PrimaryBodyIrTextHasDot(stmt.assignFieldName)` gate's intent (bail to
    # the leaf-meta-preserving path for a genuine multi-hop dotted field, e.g.
    # `arrayField[idx].subField`, already resolved by the faisEarly* block
    # above) while excluding dots that live PURELY inside the index
    # expression. A dot before the first `[` or AFTER its matching `]` is
    # structural; a dot only inside `[...]` is not.
    var fieldLookupName = stmt.assignFieldName
    var fieldPathHasStructuralDot = PrimaryBodyIrTextHasDot(stmt.assignFieldName)
    let fieldLookupBracketPos = parser.ParserFindText(stmt.assignFieldName, "[")
    if fieldLookupBracketPos > 0:
        fieldLookupName = strings.SliceBytes(stmt.assignFieldName, 0, fieldLookupBracketPos)
        var fieldLookupClosePos = -1
        var fieldLookupScan = fieldLookupBracketPos
        var fieldLookupDepth: int32
        while fieldLookupScan < len(stmt.assignFieldName):
            if stmt.assignFieldName[fieldLookupScan] == '[':
                fieldLookupDepth = fieldLookupDepth + 1
            elif stmt.assignFieldName[fieldLookupScan] == ']':
                fieldLookupDepth = fieldLookupDepth - 1
                if fieldLookupDepth == 0:
                    fieldLookupClosePos = fieldLookupScan
                    break
            fieldLookupScan = fieldLookupScan + 1
        if fieldLookupClosePos >= 0:
            let fieldLookupAfter = strings.SliceBytes(stmt.assignFieldName,
                                                       fieldLookupClosePos + 1,
                                                       len(stmt.assignFieldName) - fieldLookupClosePos - 1)
            fieldPathHasStructuralDot = PrimaryBodyIrTextHasDot(fieldLookupName) ||
                                        PrimaryBodyIrTextHasDot(fieldLookupAfter)
    # G6/G7: `root.arrayField[idx].subField = v` — the seq/array lives behind a
    # struct FIELD, so the field path is dotted *and* indexed (e.g.
    # `localSlots[si].noAlias`, `statements[i].statementIndex`). The stmt carries
    # no leaf meta (the cumulative probe only sees the seq-header field), and the
    # plain dotted-path guard below would bail to cold. Resolve the LEAF subfield
    # meta now (arrayField -> element type -> subField), so `fieldType`/size are
    # the scalar subfield and the value materialization + faisIsShape element
    # store fire instead of the cold drop. The element store itself
    # (AppendFieldArrayIndexedSubFieldStore) re-resolves the same meta, so this
    # only unblocks the value path; offsets remain authoritative there.
    var faisEarlyArrayField = ""
    var faisEarlyIndexText = ""
    var faisEarlySubField = ""
    if (fieldType == "" || fieldSizeBytes <= 0) &&
       PrimaryBodyIrFieldArrayIndexedSubFieldParts(stmt.assignFieldName,
                                                   faisEarlyArrayField,
                                                   faisEarlyIndexText,
                                                   faisEarlySubField):
        var faisArrayFieldType = ""
        var faisArrayFieldOffset: int32
        var faisArrayFieldSize: int32
        var faisArrayFieldAlign: int32
        if PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                              stmt.sourcePath,
                                              rootType,
                                              faisEarlyArrayField,
                                              faisArrayFieldType,
                                              faisArrayFieldOffset,
                                              faisArrayFieldSize,
                                              faisArrayFieldAlign):
            let faisArrayFieldNorm = texpr.TypedExprNormalizeTypeText(faisArrayFieldType)
            var faisLeafElemType = ""
            if PrimaryStartsWith(faisArrayFieldNorm, "seq[") &&
               len(faisArrayFieldNorm) > 5 &&
               strings.SliceBytes(faisArrayFieldNorm, len(faisArrayFieldNorm) - 1, 1) == "]":
                faisLeafElemType = strings.SliceBytes(faisArrayFieldNorm, 4, len(faisArrayFieldNorm) - 5)
            elif len(faisArrayFieldNorm) >= 2 &&
                 strings.SliceBytes(faisArrayFieldNorm, len(faisArrayFieldNorm) - 2, 2) == "[]":
                faisLeafElemType = strings.SliceBytes(faisArrayFieldNorm, 0, len(faisArrayFieldNorm) - 2)
            if faisLeafElemType != "":
                var faisSubType = ""
                var faisSubOffset: int32
                var faisSubSize: int32
                var faisSubAlign: int32
                if PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                                      stmt.sourcePath,
                                                      faisLeafElemType,
                                                      faisEarlySubField,
                                                      faisSubType,
                                                      faisSubOffset,
                                                      faisSubSize,
                                                      faisSubAlign):
                    if faisSubSize > 0 && faisSubOffset >= 0:
                        fieldType = faisSubType
                        fieldOffsetBytes = faisSubOffset
                        fieldSizeBytes = faisSubSize
    # Authoritative field meta first: stmt-provided offsets may be unset (0)
    # even when type/size are present, which would silently store every
    # field at offset 0. 多跳路径（a.b.c）除外：单字段查询按 IdentPrefix
    # 只解析首跳，覆写会把叶子累计 meta 换成首跳 meta（offset/size 全错）；
    # 点路径以 stmt 累计 meta 为准（同 4280 处实参机器的点路径守卫）。
    var fieldMetaProbeType = ""
    var fieldMetaProbeOffset: int32
    var fieldMetaProbeSize: int32
    var fieldMetaProbeAlign: int32
    if !fieldPathHasStructuralDot &&
       PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                          stmt.sourcePath,
                                          rootType,
                                          fieldLookupName,
                                          fieldMetaProbeType,
                                          fieldMetaProbeOffset,
                                          fieldMetaProbeSize,
                                          fieldMetaProbeAlign):
        if fieldMetaProbeSize > 0 && fieldMetaProbeOffset >= 0:
            fieldType = fieldMetaProbeType
            fieldOffsetBytes = fieldMetaProbeOffset
            fieldSizeBytes = fieldMetaProbeSize
            fieldAlignBytes = fieldMetaProbeAlign
    var primaryColdCond10: bool
    if fieldType == "":
        primaryColdCond10 = true
    if fieldType == "unknown":
        primaryColdCond10 = true
    if !PrimaryObjectMetadataTextStable(fieldType):
        primaryColdCond10 = true
    if fieldSizeBytes <= 0:
        primaryColdCond10 = true
    if primaryColdCond10:
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"assign_field_fast_field_lookup_begin function={typedFn.functionName} line={stmt.lineNumber} root_type_len={rootType.len} field={stmt.assignFieldName}")
        if fieldPathHasStructuralDot:
            # 点路径无 stmt 累计 meta 时不可用首跳单字段查询补——留文本路径
            return false
        if !PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                               stmt.sourcePath,
                                               rootType,
                                               fieldLookupName,
                                               fieldType,
                                               fieldOffsetBytes,
                                               fieldSizeBytes,
                                               fieldAlignBytes):
            PrimaryObjectPlanGuardTick()
            if PrimaryObjectPlanProgressEnabled():
                PrimaryObjectPlanProgress(Fmt"assign_field_fast_field_lookup_miss function={typedFn.functionName} line={stmt.lineNumber} root_type_len={rootType.len} field={stmt.assignFieldName}")
            return false
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"assign_field_fast_field_lookup_done function={typedFn.functionName} line={stmt.lineNumber} field_type={fieldType} size={fieldSizeBytes}")
    var primaryColdCond11: bool
    if fieldType == "":
        primaryColdCond11 = true
    if fieldType == "unknown":
        primaryColdCond11 = true
    if !PrimaryObjectMetadataTextStable(fieldType):
        primaryColdCond11 = true
    if fieldSizeBytes <= 0:
        primaryColdCond11 = true
    if primaryColdCond11:
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"assign_field_fast_field_unstable function={typedFn.functionName} line={stmt.lineNumber} field_type_len={fieldType.len} size={fieldSizeBytes}")
        return false
    PrimaryObjectPlanGuardTick()
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_field_fast_begin function={typedFn.functionName} line={stmt.lineNumber} root_type_len={rootType.len} field={stmt.assignFieldName} field_type={fieldType} size={fieldSizeBytes}")
    # `root.arrayField[idx].subField = v` (fixed array of structs as a struct
    # field). The mid-path index means the stmt-resolved field offset collapsed
    # the index out (every element wrote elem 0), and the field-tail-index block
    # below only fires when the field path ENDS with `]`. Route to the real
    # element-address store: base + arrayFieldOffset + idx*elemStride, then
    # FieldStore the subfield at its offset. `fieldType`/`fieldSizeBytes` already
    # describe the scalar subfield (resolved via the field-path meta), so the
    # value materialized below is the subfield value.
    var faisArrayField = ""
    var faisIndexText = ""
    var faisSubField = ""
    let faisIsShape = PrimaryBodyIrFieldArrayIndexedSubFieldParts(stmt.assignFieldName,
                                                                  faisArrayField,
                                                                  faisIndexText,
                                                                  faisSubField)
    # 批次6b：LHS 形态拆解。字段元数据描述的是字段本体（seq 字段=16 字节
    # 头），路径尾下标（a.b[i]/a.b.c[i]）必须按动态 seq 元素店降（buf 间接
    # + 元素地址 + 元素宽 FieldStore）；其余含下标形态留文本路径——直接
    # FieldStore 会覆写 seq 头。
    var fieldIndexText = ""
    var fieldElemKind = coreir.LocalInvalidTag
    var fieldElemSize: int32
    var storeSizeBytes = fieldSizeBytes
    # w-wall7: root.field[idx]=rhs where `field` is an INLINE FIXED array
    # (`elem[N]`, e.g. struct field `data: uint8[fixedBytes32Size]`) rather
    # than a dynamic seq/slice header (`seq[elem]` / `elem[]`). The fixed-array
    # element lives directly at base+fieldOffsetBytes+idx*elemSize — no buffer
    # pointer indirection like a seq header. Flagged here so the store address
    # computation below picks the direct-address arm instead of the seq
    # buf-pointer-indirect arm.
    var fieldIsFixedArray: bool
    let fieldBracketPos = parser.ParserFindText(stmt.assignFieldName, "[")
    if fieldBracketPos >= 0 && !faisIsShape:
        var fieldClosePos = -1
        var fieldScan = fieldBracketPos
        var fieldDepth: int32
        while fieldScan < len(stmt.assignFieldName):
            if stmt.assignFieldName[fieldScan] == '[':
                fieldDepth = fieldDepth + 1
            elif stmt.assignFieldName[fieldScan] == ']':
                fieldDepth = fieldDepth - 1
                if fieldDepth == 0:
                    fieldClosePos = fieldScan
                    break
            fieldScan = fieldScan + 1
        if fieldBracketPos <= 0 ||
           fieldClosePos != len(stmt.assignFieldName) - 1:
            return false
        fieldIndexText = strutil.Strip(strings.SliceBytes(stmt.assignFieldName,
                                                          fieldBracketPos + 1,
                                                          fieldClosePos - fieldBracketPos - 1))
        if fieldIndexText == "":
            return false
        let fieldTypeNorm = texpr.TypedExprNormalizeTypeText(fieldType)
        # Reuse the same element-type resolver the plain indexed-load/address
        # paths use (PrimaryBodyIrIndexedElementTypeText): it already covers
        # `seq[elem]`, `elem[]`, and inline fixed `elem[N]`. Only the first
        # two are dynamic-seq shapes (buf-pointer indirection); `elem[N]`
        # (fixed array) stores its element bytes inline in the struct.
        let fieldElemInner = PrimaryBodyIrIndexedElementTypeText(fieldTypeNorm)
        fieldIsFixedArray = !PrimaryBodyIrTypeTextIsDynamicSeq(fieldTypeNorm)
        if fieldElemInner == "":
            return false
        # 元素内存步长/写宽必须用 TypeShape 真宽（uint8=1），禁止走
        # NodeEvalTypedSlotShape：后者经 NormalizeSlotSizeBytes 把 I32 槽抬到
        # default 4，致 `root.field[i]=uint8(v)` 以 stride4+STR 写，读侧 stride1+LDRB
        # 永远对不上（HashMap states[] / keys 同根）。槽宽归一只服务栈槽分配。
        var fieldElemAlign: int32
        PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                       stmt.sourcePath,
                                       fieldElemInner,
                                       fieldElemKind,
                                       fieldElemSize,
                                       fieldElemAlign)
        if fieldElemKind == coreir.LocalInvalidTag || fieldElemSize <= 0:
            return false
        storeSizeBytes = fieldElemSize
    var storeValueKind = PrimaryBodyIrTypeKindFromText(fieldType)
    if fieldIndexText != "":
        storeValueKind = fieldElemKind
    let baseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                          slotNames,
                                                          lowering.typedIr,
                                                          stmt.sourcePath,
                                                          stmt.assignRootName,
                                                          rootType)
    if baseSlot < 0:
        return false
    # 批次3：rhs 已节点化时先经节点求值器物化字段值槽（FieldStore 值源）；
    # 形态不符落回既有文本值查找（迁移窗口双轨）。批次6b：子树含调用时
    # 先过纯探针并预检值形态——调用一旦发射不可落回文本路径。
    var valueSlot: int32 = -1
    # Comparison-condition ternary field store `r.v = a > b ? x : y` (Lane 2,
    # the field-store sibling of Lane B's return form). The eager/branchless
    # text scalar evaluators below cannot produce a cond slot from a compare, so
    # they would either decline (whole fill bails / SKIP) or — worse — collapse
    # the ternary into an unconditional value (silent miscompile: every store
    # took one fixed arm). Route the cmp-cond ternary through the real cbr
    # lowering (cmp + branch, only the selected arm runs) into a value slot, then
    # FieldStore that. Only the plain scalar i32/i64 field form (no field index,
    # no indexed root) is handled here; an `&&`/`||` condition is refused by
    # EmitConditionOps -> AppendScalarTernaryBlockValue returns false and we
    # honestly STOP (return false, no fallback to the miscompiling text path).
    if stmt.assignValueOpKind == texpr.TypedExprIrOpLocalBoolEnumTernary &&
       fieldIndexText == "" &&
       !PrimaryBodyIrTextHasDot(stmt.assignFieldName) &&
       (storeValueKind == coreir.LocalI32Tag || storeValueKind == coreir.LocalI64Tag):
        var fternRootIndexText = ""
        # Indexed-root field LHS (`xs[i].v = ...`) needs element-address store;
        # combining it with a cbr ternary value is out of this surgical scope —
        # leave it to STOP rather than store at the wrong element.
        if !PrimaryBodyIrAssignLhsRootIndexText(strings.CloneStr(stmt.bindingName), strings.CloneStr(stmt.assignRootName), fternRootIndexText):
            let fternValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                               slotNames,
                                                               Fmt"#fstern#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                               storeValueKind)
            if fternValueSlot < 0:
                return false
            if !PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                           slotNames,
                                                           varI32ParamNames,
                                                           lowering,

                                                           typedFn,
                                                           irFunction,
                                                           stmt.sourcePath,
                                                           stmt.lineNumber,
                                                           stmt.rhsNodeIndex,
                                                           rhsText,
                                                           fternValueSlot,
                                                           storeValueKind,
                                                           callOrdinal,
                                                           currentBlockStart):
                # Cmp-cond ternary recognized but its condition is unsupported
                # here (e.g. `&&`/`||`, refused by EmitConditionOps). Returning
                # false would let the statement fall through and be silently
                # DROPPED (the field keeps its zero-init -> a fresh miscompile).
                # Append an explicit InvalidOp so the function becomes
                # unencodable and the driver honestly bails (no .o) instead.
                PrimaryBodyIrAppendInvalidOp(bodyIR, stmt.lineNumber, int32(stmt.kind), 817, 0)
                return true
            valueSlot = fternValueSlot
    # G7: field/element store of a boolean `&&`/`||` value, e.g.
    #   xs[i].flag = proofBacked && refCount[i] <= 1
    # The scalar/node evaluators below cannot lower a top-level `&&`/`||` (the
    # comparison sub-token would make EmitConditionOps bail), so the statement
    # used to fall to the InvalidOp(718) cold drop. When the whole RHS is
    # call-free both operands are side-effect-free, so the non-short-circuit
    # CondValue01Slot (bitwise-AND/OR of the two 0/1 sub-values) is byte-exact
    # with short-circuit `&&`/`||`. A real call surface on either side could
    # need short-circuit skipping, so we restrict to the pure form and otherwise
    # leave the later handlers to STOP rather than risk an eager-eval miscompile.
    if valueSlot < 0 &&
       storeValueKind == coreir.LocalI32Tag &&
       (PrimaryBodyIrConditionHasAnd(rhsText) || PrimaryBodyIrConditionHasOr(rhsText)):
        var boolValueSlot = PrimaryBodyIrCondValue01Slot(bodyIR,
                                                         slotNames,
                                                         lowering,

                                                         typedFn,
                                                         irFunction,
                                                         stmt.sourcePath,
                                                         stmt.lineNumber,
                                                         rhsText,
                                                         Fmt"#fstore_bool#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                         callOrdinal)
        # T78: CondValue01Slot honestly bails(-1) when either operand has a
        # faulting eager surface (call/下标) — the non-short-circuit bitwise
        # combine above is no longer byte-exact for those. Fall to the same
        # real CBR-chain assigner the plain-assign path uses instead of
        # dropping to InvalidOp(718): a call/下标-bearing `&&`/`||` field-store
        # value is exactly as short-circuit-sensitive as the assign case.
        if boolValueSlot < 0:
            let fstoreBoolScratchSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                      slotNames,
                                                                      Fmt"#fstore_bool_cbr#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                                      coreir.LocalI32Tag)
            if fstoreBoolScratchSlot >= 0:
                var fstoreBoolBlockStart = currentBlockStart
                if PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                          slotNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          stmt.sourcePath,
                                                          stmt.lineNumber,
                                                          rhsText,
                                                          fstoreBoolScratchSlot,
                                                          callOrdinal,
                                                          fstoreBoolBlockStart):
                    currentBlockStart = fstoreBoolBlockStart
                    boolValueSlot = fstoreBoolScratchSlot
        if boolValueSlot >= 0:
            valueSlot = boolValueSlot
    if valueSlot < 0 && stmt.rhsNodeIndex >= 0:
        primaryBodyIrNodeEvalMissOp = ""
        var nodeFieldReady = true
        if PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, stmt.rhsNodeIndex):
            let nodeFieldProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering,

                                                                share(typedFn),
                                                                irFunction,
                                                                stmt.rhsNodeIndex)
            if nodeFieldProbeKind < 0:
                nodeFieldReady = false
            elif storeSizeBytes <= 4 && nodeFieldProbeKind == coreir.LocalI32Tag:
                nodeFieldReady = true
            elif storeSizeBytes == 8 &&
                 (nodeFieldProbeKind == coreir.LocalI64Tag ||
                  nodeFieldProbeKind == coreir.LocalPtrTag ||
                  (nodeFieldProbeKind == coreir.LocalI32Tag &&
                   storeValueKind == coreir.LocalI64Tag)):
                nodeFieldReady = true
            elif storeSizeBytes == 24 && nodeFieldProbeKind == coreir.LocalStrTag:
                nodeFieldReady = true
            elif nodeFieldProbeKind == coreir.LocalAggregateTag:
                # 聚合预检尺寸：Value 内征投影按 Result 内型算（node.resultType
                # 对泛型内征不可靠），其余按节点返回类型形状。
                var nodeFieldProbeSize: int32
                var nodeFieldShapeDone = false
                if lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpCallExpr:
                    let nodeFieldRhsLiteralRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool,
                                                                                       lowering.typedIr.nodes2_literalTextIds[stmt.rhsNodeIndex])
                    if IsOk(nodeFieldRhsLiteralRes) &&
                       Value(nodeFieldRhsLiteralRes) == "Value":
                        let nodeFieldRvArgIndex = PrimaryBodyIrResultValueArgNodeIndex(lowering.typedIr, stmt.rhsNodeIndex)
                        if nodeFieldRvArgIndex >= 0:
                            var nodeFieldRvKind: int32
                            var nodeFieldRvOffset: int32
                            let nodeFieldRhsSrcRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool,
                                                                                           lowering.typedIr.nodes2_sourcePathIds[stmt.rhsNodeIndex])
                            var nodeFieldRhsSourcePath = ""
                            if IsOk(nodeFieldRhsSrcRes):
                                nodeFieldRhsSourcePath = Value(nodeFieldRhsSrcRes)
                            if PrimaryBodyIrResultValueProjectShape(lowering.typedIr,
                                                                    nodeFieldRhsSourcePath,
                                                                    PrimaryBodyIrResultValueInnerTypeText(lowering.typedIr,
                                                                                                          stmt.rhsNodeIndex,
                                                                                                          nodeFieldRvArgIndex),
                                                                    nodeFieldRvKind,
                                                                    nodeFieldProbeSize,
                                                                    nodeFieldRvOffset):
                                nodeFieldShapeDone = true
                if !nodeFieldShapeDone:
                    var safSrc = ""
                    var safType = ""
                    if stmt.rhsNodeIndex >= 0 && stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                        let safSrcRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_sourcePathIds[stmt.rhsNodeIndex])
                        let safTypeRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[stmt.rhsNodeIndex])
                        if IsOk(safSrcRes) && IsOk(safTypeRes):
                            safSrc = Value(safSrcRes)
                            safType = Value(safTypeRes)
                    let _ = PrimaryBodyIrNodeEvalTypedSlotShape(lowering.typedIr,
                                                                safSrc,
                                                                texpr.TypedExprStripVarType(safType),
                                                                nodeFieldProbeSize)
                nodeFieldReady = nodeFieldProbeSize >= storeSizeBytes
            else:
                nodeFieldReady = false
        var nodeFieldValueSlot: int32 = -1
        if nodeFieldReady:
            nodeFieldValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       lowering,

                                                       share(typedFn),
                                                       irFunction,
                                                       stmt.rhsNodeIndex,
                                                       callOrdinal)
        if nodeFieldValueSlot >= 0:
            var nodeFieldValueKind = PrimaryBodyIrSlotType(bodyIR, nodeFieldValueSlot)
            if storeSizeBytes == 8 &&
               storeValueKind == coreir.LocalI64Tag &&
               nodeFieldValueKind == coreir.LocalI32Tag:
                # i64 字段 + i32 值：显式 sign-extend（与 NodeEvalStore 同语义）
                let nodeFieldWideSlot = PrimaryBodyIrNodeEvalWidenToI64(bodyIR,
                                                                        slotNames,
                                                                        nodeFieldValueSlot,
                                                                        stmt.rhsNodeIndex,
                                                                        3)
                if nodeFieldWideSlot >= 0:
                    nodeFieldValueSlot = nodeFieldWideSlot
                    nodeFieldValueKind = coreir.LocalI64Tag
            var nodeFieldKindOk = false
            if storeSizeBytes <= 4 && nodeFieldValueKind == coreir.LocalI32Tag:
                nodeFieldKindOk = true
            elif storeSizeBytes == 8 &&
                 (nodeFieldValueKind == coreir.LocalI64Tag ||
                  nodeFieldValueKind == coreir.LocalPtrTag):
                nodeFieldKindOk = true
            elif storeSizeBytes == 24 && nodeFieldValueKind == coreir.LocalStrTag:
                nodeFieldKindOk = true
            elif nodeFieldValueKind == coreir.LocalAggregateTag && storeSizeBytes > 0:
                # 聚合值（seq 头/结构体）按宽拷贝：FieldStore 任意字节宽
                nodeFieldKindOk = true
            if nodeFieldKindOk &&
               PrimaryLocalSlotSizeOf(bodyIR.localSlots[nodeFieldValueSlot]) >= storeSizeBytes:
                # FieldStore 值源读栈上槽：param 槽（保存区/地址语义）先物化本地副本
                if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[nodeFieldValueSlot]):
                    var nodeFieldTmpSlot: int32 = -1
                    if nodeFieldValueKind == coreir.LocalAggregateTag:
                        nodeFieldTmpSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                                              slotNames,
                                                                              Fmt"#nff{stmt.rhsNodeIndex}#{bodyIR.ops.len}",
                                                                              coreir.LocalAggregateTag,
                                                                              storeSizeBytes,
                                                                              8)
                    else:
                        nodeFieldTmpSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                         slotNames,
                                                                         Fmt"#nff{stmt.rhsNodeIndex}#{bodyIR.ops.len}",
                                                                         nodeFieldValueKind)
                    if nodeFieldTmpSlot >= 0:
                        if nodeFieldValueKind == coreir.LocalStrTag ||
                           nodeFieldValueKind == coreir.LocalAggregateTag:
                            var nodeFieldMatSize = storeSizeBytes
                            if nodeFieldValueKind == coreir.LocalStrTag:
                                nodeFieldMatSize = 24
                            var nodeFieldStrMatOp: coreir.BodyOp
                            nodeFieldStrMatOp.kind = coreir.BodyOpFieldLoadTag
                            nodeFieldStrMatOp.target = nodeFieldTmpSlot
                            add(nodeFieldStrMatOp.operands, nodeFieldValueSlot)
                            add(nodeFieldStrMatOp.operands, nodeFieldTmpSlot)
                            add(nodeFieldStrMatOp.operands, 0)
                            add(nodeFieldStrMatOp.operands, nodeFieldMatSize)
                            let _ = coreir.BodyIRAppendOp(bodyIR, nodeFieldStrMatOp)
                        else:
                            var nodeFieldCopyOp: coreir.BodyOp
                            nodeFieldCopyOp.kind = coreir.BodyOpCopyLocalTag
                            nodeFieldCopyOp.target = nodeFieldTmpSlot
                            add(nodeFieldCopyOp.operands, nodeFieldValueSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, nodeFieldCopyOp)
                        nodeFieldValueSlot = nodeFieldTmpSlot
                        valueSlot = nodeFieldValueSlot
                else:
                    valueSlot = nodeFieldValueSlot
        if valueSlot >= 0:
            PrimaryBodyIrNodeEvalOnlyOwn()
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            if valueSlot >= 0:
                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit function={typedFn.functionName} line={stmt.lineNumber}")
            else:
                var nodeFieldMissOpText = primaryBodyIrNodeEvalMissOp
                if nodeFieldMissOpText == "":
                    nodeFieldMissOpText = "store_field_shape"
                var nodeFieldTraceKind: int32 = -1
                if nodeFieldValueSlot >= 0:
                    nodeFieldTraceKind = PrimaryBodyIrSlotType(bodyIR, nodeFieldValueSlot)
                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={nodeFieldMissOpText} function={typedFn.functionName} line={stmt.lineNumber} detail=s{storeSizeBytes}_v{nodeFieldTraceKind}")
    if valueSlot < 0:
        valueSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
    if valueSlot < 0 && (rhsText == "[]" || rhsText == "{}"):
        valueSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                       slotNames,
                                                       Fmt"{stmt.assignFieldName}_zero",
                                                       coreir.LocalAggregateTag,
                                                       storeSizeBytes,
                                                       8)
    if valueSlot < 0 && PrimaryBodyIrTextIsStringLiteral(rhsText):
        valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"{stmt.assignFieldName}#str_value#{stmt.lineNumber}",
                                                  coreir.LocalStrTag)
        if valueSlot < 0 ||
           !PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                  slotNames,
                                                  rhsText,
                                                  valueSlot,
                                                  callOrdinal):
            return false
    if valueSlot < 0:
        valueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                        slotNames,
                                                        varI32ParamNames,
                                                        lowering.typedIr,
                                                        stmt.sourcePath,
                                                        rhsText,
                                                        storeValueKind, callOrdinal)
    if valueSlot < 0:
        valueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering.typedIr,
                                                               share(typedFn),
                                                               irFunction,
                                                               stmt.sourcePath,
                                                               stmt.lineNumber,
                                                               rhsText,
                                                               storeValueKind)
    if valueSlot < 0 &&
       PrimaryBodyIrTextHasFieldOrIndex(rhsText) &&
       texpr.TypedExprTextIsSimpleFieldPath(rhsText):
        # 字段路径值（str/聚合元素店源）：按元数据 FieldLoad 物化值槽
        var fieldValueFail0: int32
        var fieldValueFail1: int32
        valueSlot = PrimaryBodyIrMaterializeFieldArgSlot(bodyIR,
                                                         slotNames,
                                                         lowering.typedIr,
                                                         typedFn,
                                                         irFunction,
                                                         stmt.sourcePath,
                                                         stmt.lineNumber,
                                                         rhsText,
                                                         fieldValueFail0,
                                                         fieldValueFail1)
    if valueSlot < 0:
        # Last resort only for names with an existing slot: a fresh slot
        # here would feed the field store uninitialized bytes.
        valueSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, rhsText)
    # root.field[i]=nil for str[] field: ScalarValueSlot(LocalStrTag,"nil") zeros
    # full str; keep storeSizeBytes=elem size. (6102 was Fast miss then poison.)
    if valueSlot < 0 &&
       fieldIndexText != "" &&
       fieldElemKind == coreir.LocalStrTag &&
       rhsText == "nil":
        valueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                        slotNames,
                                                        varI32ParamNames,
                                                        lowering.typedIr,
                                                        stmt.sourcePath,
                                                        "nil",
                                                        coreir.LocalStrTag,
                                                        callOrdinal)
    if valueSlot < 0 || PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < storeSizeBytes:
        return false
    if faisIsShape:
        if !PrimaryBodyIrAppendFieldArrayIndexedSubFieldStore(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering.typedIr,
                                                              typedFn,
                                                              irFunction,
                                                              stmt.sourcePath,
                                                              stmt.lineNumber,
                                                              stmt.assignRootName,
                                                              rootType,
                                                              stmt.assignFieldName,
                                                              valueSlot,
                                                              callOrdinal):
            # Indexed struct-field element store but not a clean fixed-array
            # element store: refuse rather than silently dropping the index.
            return false
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"assign_field_fast_struct_array_done function={typedFn.functionName} line={stmt.lineNumber} field={stmt.assignFieldName} idx={faisIndexText}")
        return true
    if fieldIndexText != "":
        # wall7 让路守卫: `root[k].field[idx] = rhs` — root 段本身带下标
        # (`root[k]`) 时, stmt.assignRootName 只保留裸 root 名 (前端剥离了
        # `[k]`), 上面 baseSlot 只按裸 root 名解出的地址恒等于 root[0] 的地址
        # ——对 k != 0 的任何元素/字段数组店在此提交都是写错地址(实测:
        # items[1].data[2]=v 写穿成 items[0].data[2])。root 是否带下标是结构
        # 信号(bindingName 的 root 段 `[...]`), 与 field 本身是否带下标
        # (fieldIndexText) 正交。
        # 让路仅限 fieldIsFixedArray 分支(本 wall7 补丁新引入的直接寻址臂):
        # 该臂新加的 fieldElemInner 解析原先对内联定长数组恒早退(baseline 从
        # 未走到这里), 现在因本补丁能解出而误接管——这是本补丁引入的新回归,
        # 必须让路。动态 seq 分支(else, buf 间接臂)在带下标 root 下的错址是
        # wall7 补丁之前就存在的独立问题(实测: mobile_capi MobileCapiMoqSolveObject
        # `equations[row].coeffs[i]=..`, root/field 均为动态 seq), 已在 else
        # 分支内部根修(先解 root[k] 元素地址再喂给既有 field buf 间接店逻辑,
        # 见下方 fieldDynBaseSlot), 故此处不需要为 else 分支让路。
        if fieldIsFixedArray:
            var fieldIndexedRootProbe = ""
            if PrimaryBodyIrAssignLhsRootIndexText(strings.CloneStr(stmt.bindingName), strings.CloneStr(stmt.assignRootName), fieldIndexedRootProbe):
                return false
        # 动态 seq 元素店：buf@offset+8 间接 + madd 元素地址 + 元素宽 FieldStore。
        # 内联定长数组字段（fieldIsFixedArray）没有 buf 间接层——元素就地存在
        # base+fieldOffsetBytes 起，直接 madd 求元素地址（同 :20930 一带地址取
        # 址臂对本地定长数组的地址公式，仅把 root 换成 base+fieldOffset）。
        var fieldIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering.typedIr,
                                                               stmt.sourcePath,
                                                               fieldIndexText,
                                                               coreir.LocalI32Tag, callOrdinal)
        if fieldIdxSlot < 0:
            # 字段路径下标（fnIr.paramNames[node.paramSlot]）走上下文解析
            fieldIdxSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      lowering.typedIr,
                                                                      share(typedFn),
                                                                      irFunction,
                                                                      stmt.sourcePath,
                                                                      stmt.lineNumber,
                                                                      fieldIndexText,
                                                                      coreir.LocalI32Tag)
        if fieldIdxSlot < 0 && PrimaryBodyIrTextHasFieldOrIndex(fieldIndexText):
            fieldIdxSlot = PrimaryBodyIrIndexedMemberValueSlot(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering.typedIr,
                                                               typedFn,
                                                               irFunction,
                                                               stmt.sourcePath,
                                                               stmt.lineNumber,
                                                               fieldIndexText,
                                                               callOrdinal)
        if fieldIdxSlot < 0:
            return false
        let fieldEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"#fidx{stmt.lineNumber}#{bodyIR.ops.len}#esz",
                                                           coreir.LocalI64Tag,
                                                           storeSizeBytes)
        let fieldAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#fidx{stmt.lineNumber}#{bodyIR.ops.len}#addr",
                                                          coreir.LocalPtrTag)
        if fieldEszSlot < 0 || fieldAddrSlot < 0:
            return false
        if fieldIsFixedArray:
            let fieldFixedBaseSlot = PrimaryBodyIrSeqAddHeaderPtrSlot(bodyIR,
                                                                      slotNames,
                                                                      stmt.lineNumber,
                                                                      baseSlot,
                                                                      fieldOffsetBytes)
            if fieldFixedBaseSlot < 0:
                return false
            var fieldFixedAddrOp: coreir.BodyOp
            fieldFixedAddrOp.kind = coreir.BodyOpBinOpTag
            fieldFixedAddrOp.target = fieldAddrSlot
            add(fieldFixedAddrOp.operands, coreir.LocalI64Tag)
            add(fieldFixedAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
            add(fieldFixedAddrOp.operands, fieldIdxSlot)
            add(fieldFixedAddrOp.operands, fieldEszSlot)
            add(fieldFixedAddrOp.operands, fieldFixedBaseSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, fieldFixedAddrOp)
        else:
            # wall7 跟进根修(动态 seq 根+动态 seq 字段错址): root 自身带下标
            # (`root[k].field[idx]=v`)且 field 也是动态 seq 时, 上面的
            # baseSlot 只是裸 root 名(`equations`)解出的地址——对一个 seq
            # 类型局部变量, 那是 root 自己的 seq 头(len@0/buf@8), 不是
            # root[k] 的元素地址。原逻辑直接拿 baseSlot 当 struct 基址去做
            # field 的 buf 间接店, 会把 root 自己 seq 头里 offset 8 的字节
            # (即 root 的 buf 指针, 与 k 无关) 当成 field 的偏移量再叠加
            # fieldOffsetBytes 读取, 解出野指针后解引用——野指针写崩溃
            # (实测: MobileCapiMoqSolveObject equations[row].coeffs[i]=..
            # SIGSEGV/SIGBUS, k=0 时也崩溃, 并非"恒写[0]"而是恒错址)。
            # 根修: 先用 root 自身的 buf 指针(baseSlot+8 间接)+ k*elemSize
            # (I32Madd)算出 root[k] 的真实元素地址, 再把它当 struct 基址喂
            # 给下面既有的 field buf 间接店逻辑(未带下标的 root 分支不变,
            # fieldDynBaseSlot 仍等于 baseSlot)。
            var fieldDynBaseSlot = baseSlot
            var fieldDynRootIndexText = ""
            if PrimaryBodyIrAssignLhsRootIndexText(strings.CloneStr(stmt.bindingName), strings.CloneStr(stmt.assignRootName), fieldDynRootIndexText):
                if !PrimaryBodyIrTypeTextIsDynamicSeq(rootType):
                    return false
                let dynRootElemType = PrimaryBodyIrIndexedElementTypeText(rootType)
                if dynRootElemType == "":
                    return false
                var dynRootElemKind: int32
                var dynRootElemSize: int32
                var dynRootElemAlign: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               stmt.sourcePath,
                                               dynRootElemType,
                                               dynRootElemKind,
                                               dynRootElemSize,
                                               dynRootElemAlign)
                if dynRootElemKind != coreir.LocalAggregateTag || dynRootElemSize <= 0:
                    return false
                let dynRootBufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                   slotNames,
                                                                   Fmt"#fidx{stmt.lineNumber}#{bodyIR.ops.len}#rootbuf",
                                                                   coreir.LocalPtrTag)
                if dynRootBufSlot < 0:
                    return false
                var dynRootBufLoadOp: coreir.BodyOp
                dynRootBufLoadOp.kind = coreir.BodyOpFieldLoadTag
                dynRootBufLoadOp.target = dynRootBufSlot
                add(dynRootBufLoadOp.operands, baseSlot)
                add(dynRootBufLoadOp.operands, dynRootBufSlot)
                add(dynRootBufLoadOp.operands, 8)
                add(dynRootBufLoadOp.operands, 8)
                let _ = coreir.BodyIRAppendOp(bodyIR, dynRootBufLoadOp)
                let dynRootIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                        slotNames,
                                                                        varI32ParamNames,
                                                                        lowering.typedIr,
                                                                        stmt.sourcePath,
                                                                        fieldDynRootIndexText,
                                                                        coreir.LocalI32Tag,
                                                                        callOrdinal)
                if dynRootIdxSlot < 0:
                    return false
                let dynRootEszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                     slotNames,
                                                                     Fmt"#fidx{stmt.lineNumber}#{bodyIR.ops.len}#rootesz",
                                                                     coreir.LocalI64Tag,
                                                                     dynRootElemSize)
                let dynRootElemAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                        slotNames,
                                                                        Fmt"#fidx{stmt.lineNumber}#{bodyIR.ops.len}#rootaddr",
                                                                        coreir.LocalPtrTag)
                if dynRootEszSlot < 0 || dynRootElemAddrSlot < 0:
                    return false
                var dynRootAddrOp: coreir.BodyOp
                dynRootAddrOp.kind = coreir.BodyOpBinOpTag
                dynRootAddrOp.target = dynRootElemAddrSlot
                add(dynRootAddrOp.operands, coreir.LocalI64Tag)
                add(dynRootAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
                add(dynRootAddrOp.operands, dynRootIdxSlot)
                add(dynRootAddrOp.operands, dynRootEszSlot)
                add(dynRootAddrOp.operands, dynRootBufSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, dynRootAddrOp)
                fieldDynBaseSlot = dynRootElemAddrSlot
            let fieldBufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                             slotNames,
                                                             Fmt"#fidx{stmt.lineNumber}#{bodyIR.ops.len}#buf",
                                                             coreir.LocalPtrTag)
            if fieldBufSlot < 0:
                return false
            var fieldBufLoadOp: coreir.BodyOp
            fieldBufLoadOp.kind = coreir.BodyOpFieldLoadTag
            fieldBufLoadOp.target = fieldBufSlot
            add(fieldBufLoadOp.operands, fieldDynBaseSlot)
            add(fieldBufLoadOp.operands, fieldBufSlot)
            add(fieldBufLoadOp.operands, fieldOffsetBytes + 8)
            add(fieldBufLoadOp.operands, 8)
            let _ = coreir.BodyIRAppendOp(bodyIR, fieldBufLoadOp)
            var fieldAddrOp: coreir.BodyOp
            fieldAddrOp.kind = coreir.BodyOpBinOpTag
            fieldAddrOp.target = fieldAddrSlot
            add(fieldAddrOp.operands, coreir.LocalI64Tag)
            add(fieldAddrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
            add(fieldAddrOp.operands, fieldIdxSlot)
            add(fieldAddrOp.operands, fieldEszSlot)
            add(fieldAddrOp.operands, fieldBufSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, fieldAddrOp)
        var fieldElemStoreOp: coreir.BodyOp
        fieldElemStoreOp.kind = coreir.BodyOpFieldStoreTag
        fieldElemStoreOp.target = fieldAddrSlot
        add(fieldElemStoreOp.operands, fieldAddrSlot)
        add(fieldElemStoreOp.operands, valueSlot)
        add(fieldElemStoreOp.operands, 0)
        add(fieldElemStoreOp.operands, storeSizeBytes)
        let _ = coreir.BodyIRAppendOp(bodyIR, fieldElemStoreOp)
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"assign_field_fast_done function={typedFn.functionName} line={stmt.lineNumber} base_slot={baseSlot} value_slot={valueSlot}")
        return true
    # Indexed-root field LHS (`xs[i].field`): the structured root name dropped
    # the `[i]`, so a plain base+offset FieldStore would write element 0. Recover
    # the index from bindingName and store at the real element address.
    var rootIndexText = ""
    if PrimaryBodyIrAssignLhsRootIndexText(strings.CloneStr(stmt.bindingName), strings.CloneStr(stmt.assignRootName), rootIndexText):
        if PrimaryBodyIrAppendFixedArrayIndexedFieldStore(bodyIR,
                                                          slotNames,
                                                          lowering.typedIr,
                                                          stmt.sourcePath,
                                                          stmt.lineNumber,
                                                          rootType,
                                                          rootIndexText,
                                                          baseSlot,
                                                          valueSlot,
                                                          fieldOffsetBytes,
                                                          fieldSizeBytes,
                                                          varI32ParamNames,
                                                          callOrdinal):
            PrimaryObjectPlanGuardTick()
            if PrimaryObjectPlanProgressEnabled():
                PrimaryObjectPlanProgress(Fmt"assign_field_fast_indexed_done function={typedFn.functionName} line={stmt.lineNumber} base_slot={baseSlot} value_slot={valueSlot} idx={rootIndexText}")
            return true
        # Dynamic seq of structs (`xs[i].field` where `xs: Elem[]`): element
        # storage is behind the seq header data pointer; the fixed-array path
        # above refuses it. Store at `*(base+8) + idx*elemSize + fieldOffset`.
        if PrimaryBodyIrAppendDynamicSeqIndexedFieldStore(bodyIR,
                                                          slotNames,
                                                          lowering.typedIr,
                                                          stmt.sourcePath,
                                                          stmt.lineNumber,
                                                          rootType,
                                                          rootIndexText,
                                                          baseSlot,
                                                          valueSlot,
                                                          fieldOffsetBytes,
                                                          fieldSizeBytes,
                                                          varI32ParamNames,
                                                          callOrdinal):
            PrimaryObjectPlanGuardTick()
            if PrimaryObjectPlanProgressEnabled():
                PrimaryObjectPlanProgress(Fmt"assign_field_fast_seq_indexed_done function={typedFn.functionName} line={stmt.lineNumber} base_slot={baseSlot} value_slot={valueSlot} idx={rootIndexText}")
            return true
        # Indexed root but not a clean element store: refuse rather than
        # silently dropping the index into a base+offset store.
        return false
    # [wall148] 借用视图/引用中跳 store 臂：仅接管 var 形参 ref 根与含 ref
    # 中跳的点路径；其余形态返回 false，原样走下方既有 FieldStore（零漂移）。
    if PrimaryBodyIrAppendBorrowViewFieldStore(bodyIR,
                                                slotNames,
                                                lowering.typedIr,
                                                stmt.sourcePath,
                                                rootType,
                                                baseSlot,
                                                stmt.assignFieldName,
                                                valueSlot):
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"assign_field_fast_done function={typedFn.functionName} line={stmt.lineNumber} base_slot={baseSlot} value_slot={valueSlot} borrow_view=1")
        return true
    var storeOp: coreir.BodyOp
    storeOp.kind = coreir.BodyOpFieldStoreTag
    storeOp.target = baseSlot
    add(storeOp.operands, baseSlot)
    add(storeOp.operands, valueSlot)
    add(storeOp.operands, fieldOffsetBytes)
    add(storeOp.operands, fieldSizeBytes)
    let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
    PrimaryObjectPlanGuardTick()
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_field_fast_done function={typedFn.functionName} line={stmt.lineNumber} base_slot={baseSlot} value_slot={valueSlot}")
    return true

# Global array element-address: returns a LocalPtr slot holding the byte
# address of `g[idxText]` for a bare global array `g`. For a fixed array
# (`Elem[N]`) the base is &g; for a dynamic seq (`Elem[]`/`seq[Elem]`) the base
# is the seq data pointer at *(&g + 8). In both cases the element address is
# base + idx*elemSize. Sets elemKindOut/elemSizeOut from the element type;
# returns -1 (size 0) for dotted roots, non-globals, or non-scalar element
# widths. Both the indexed store and read build on this so one scaled-address
# protocol drives writes and reads.
@borrows
fn PrimaryBodyIrGlobalFixedArrayElemAddrSlot(bodyIR: var coreir.BodyIR,
                                             slotNames: var str[],
                                             varI32ParamNames: str[],
                                             typedIr: texpr.TypedExprIr,
                                             sourcePath: str,
                                             rootName: str,
                                             idxText: str,
                                             elemKindOut: var int32,
                                             elemSizeOut: var int32,
                                             callOrdinal: var int32,
                                             allowStructElem: bool): int32 =
    elemKindOut = coreir.LocalInvalidTag
    elemSizeOut = 0
    if PrimaryBodyIrTextHasDot(rootName):
        return -1
    let gArrGlobalType = PrimaryBodyIrTypedGlobalType(typedIr, sourcePath, rootName)
    let gArrNormType = texpr.TypedExprNormalizeTypeText(gArrGlobalType)
    let gArrIsDynamicSeq = PrimaryBodyIrTypeTextIsDynamicSeq(gArrNormType)
    var gArrElemKind: int32
    var gArrElemSize: int32
    if !PrimaryBodyIrSeqElementShapeFromText(typedIr,
                                             sourcePath,
                                             gArrNormType,
                                             gArrElemKind,
                                             gArrElemSize):
        return -1
    # only scalar element widths the IndexedLoad/Store op can materialize directly.
    # allowStructElem=true(整槽 struct 存储调用)放宽:地址计算 base+idx*elemSize 与
    # 元素宽度无关,struct 用 AppendVarAggregateStore(FieldStore byteCount) 拷贝非 IndexedStore。
    if !allowStructElem && gArrElemSize != 1 && gArrElemSize != 4 && gArrElemSize != 8:
        return -1
    let gArrGlobalSlotName = PrimaryBodyIrTypedGlobalSlotName(typedIr, sourcePath, rootName)
    if gArrGlobalSlotName == "":
        return -1
    let gArrGlobalSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                            slotNames,
                                                            typedIr,
                                                            sourcePath,
                                                            gArrGlobalSlotName,
                                                            gArrGlobalType)
    if gArrGlobalSlot < 0:
        return -1
    PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, gArrGlobalSlot)
    bodyIR.localSlots[gArrGlobalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
    let gArrAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#global_arr_addr#{bodyIR.ops.len}",
                                                     coreir.LocalPtrTag)
    let gArrIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          typedIr,
                                                          sourcePath,
                                                          idxText,
                                                          coreir.LocalI32Tag, callOrdinal)
    if gArrAddrSlot < 0 || gArrIdxSlot < 0:
        return -1
    var gArrAddrOp: coreir.BodyOp
    gArrAddrOp.kind = coreir.BodyOpGlobalLoadTag
    gArrAddrOp.target = gArrAddrSlot
    add(gArrAddrOp.operands, gArrGlobalSlot)
    add(gArrAddrOp.operands, 1)
    let _ = coreir.BodyIRAppendOp(bodyIR, gArrAddrOp)
    # dynamic seq: the global holds a {len,cap,data@+8} header; the elements
    # live one indirection away at *(headerAddr + 8). Deref the data pointer so
    # the index scaling below addresses the element buffer, not the header.
    var gArrBaseAddrSlot = gArrAddrSlot
    if gArrIsDynamicSeq:
        let gArrDataPtrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                            slotNames,
                                                            Fmt"#global_seq_data#{bodyIR.ops.len}",
                                                            coreir.LocalPtrTag)
        if gArrDataPtrSlot < 0:
            return -1
        var gArrDataLoadOp: coreir.BodyOp
        gArrDataLoadOp.kind = coreir.BodyOpFieldLoadTag
        gArrDataLoadOp.target = gArrDataPtrSlot
        add(gArrDataLoadOp.operands, gArrAddrSlot)
        add(gArrDataLoadOp.operands, gArrDataPtrSlot)
        add(gArrDataLoadOp.operands, 8)
        add(gArrDataLoadOp.operands, 8)
        let _ = coreir.BodyIRAppendOp(bodyIR, gArrDataLoadOp)
        gArrBaseAddrSlot = gArrDataPtrSlot
    let gArrIdxWideSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                        slotNames,
                                                        Fmt"#idx_wide#{bodyIR.ops.len}",
                                                        coreir.LocalI64Tag)
    var gArrWidenOp: coreir.BodyOp
    gArrWidenOp.kind = coreir.BodyOpCopyLocalTag
    gArrWidenOp.target = gArrIdxWideSlot
    add(gArrWidenOp.operands, gArrIdxSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, gArrWidenOp)
    # byte offset = idx * elemSize. uint8[N] keeps elemSize 1 (no scale); wider
    # element arrays scale the i64 index by the element size so neighbouring
    # slots are not aliased.
    var gArrByteIdxSlot = gArrIdxWideSlot
    if gArrElemSize != 1:
        let gArrElemSizeSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                               slotNames,
                                                               Fmt"#elem_size#{bodyIR.ops.len}",
                                                               coreir.LocalI64Tag,
                                                               gArrElemSize)
        let gArrScaledSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"#idx_scaled#{bodyIR.ops.len}",
                                                           coreir.LocalI64Tag)
        if gArrElemSizeSlot < 0 || gArrScaledSlot < 0:
            return -1
        var gArrMulOp: coreir.BodyOp
        gArrMulOp.kind = coreir.BodyOpBinOpTag
        gArrMulOp.target = gArrScaledSlot
        add(gArrMulOp.operands, coreir.LocalI64Tag)
        add(gArrMulOp.operands, int32(texpr.TypedExprIrOpI32Mul))
        add(gArrMulOp.operands, gArrIdxWideSlot)
        add(gArrMulOp.operands, gArrElemSizeSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, gArrMulOp)
        gArrByteIdxSlot = gArrScaledSlot
    let gArrElemAddrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                         slotNames,
                                                         Fmt"#idx_addr#{bodyIR.ops.len}",
                                                         coreir.LocalPtrTag)
    var gArrAddOp: coreir.BodyOp
    gArrAddOp.kind = coreir.BodyOpBinOpTag
    gArrAddOp.target = gArrElemAddrSlot
    add(gArrAddOp.operands, coreir.LocalI64Tag)
    add(gArrAddOp.operands, int32(texpr.TypedExprIrOpI32Add))
    add(gArrAddOp.operands, gArrBaseAddrSlot)
    add(gArrAddOp.operands, gArrByteIdxSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, gArrAddOp)
    elemKindOut = gArrElemKind
    elemSizeOut = gArrElemSize
    return gArrElemAddrSlot

# segment-s7: base-address + raw-index form for a bare global FIXED array
# (`Elem[N]`) scalar element `g[idxText]`, elemSize 1/4/8. Returns the Ptr slot
# holding &g (address-only GlobalLoad — same reloc plumbing as every other global
# address) and, via idxSlotOut, the raw i32 index slot. The IndexedLoad/Store SIB
# arm folds base+idx*scale straight into its ModRM+SIB byte, so NO idx*elemSize
# imul / base+offset add / stack-slot address round-trip is emitted (that was the
# k2/k4 debt vs gcc -O2). Refuses dynamic seq / dotted roots / non-scalar widths
# with -1 so the caller keeps the existing full-address (imul+add) path unchanged
# — refusal is path selection, not a fallback.
@borrows
fn PrimaryBodyIrGlobalFixedArraySibBaseIndex(bodyIR: var coreir.BodyIR,
                                             slotNames: var str[],
                                             varI32ParamNames: str[],
                                             typedIr: texpr.TypedExprIr,
                                             sourcePath: str,
                                             rootName: str,
                                             idxText: str,
                                             elemKindOut: var int32,
                                             elemSizeOut: var int32,
                                             idxSlotOut: var int32,
                                             callOrdinal: var int32): int32 =
    elemKindOut = coreir.LocalInvalidTag
    elemSizeOut = 0
    idxSlotOut = -1
    if !primaryX64SibRouteActive:
        return -1
    if PrimaryBodyIrTextHasDot(rootName):
        return -1
    let gSibGlobalType = PrimaryBodyIrTypedGlobalType(typedIr, sourcePath, rootName)
    let gSibNormType = texpr.TypedExprNormalizeTypeText(gSibGlobalType)
    # fixed `Elem[N]` only; a dynamic seq keeps its data-pointer deref path.
    if PrimaryBodyIrTypeTextIsDynamicSeq(gSibNormType):
        return -1
    var gSibElemKind: int32
    var gSibElemSize: int32
    if !PrimaryBodyIrSeqElementShapeFromText(typedIr,
                                             sourcePath,
                                             gSibNormType,
                                             gSibElemKind,
                                             gSibElemSize):
        return -1
    if gSibElemSize != 1 && gSibElemSize != 4 && gSibElemSize != 8:
        return -1
    let gSibGlobalSlotName = PrimaryBodyIrTypedGlobalSlotName(typedIr, sourcePath, rootName)
    if gSibGlobalSlotName == "":
        return -1
    let gSibGlobalSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                            slotNames,
                                                            typedIr,
                                                            sourcePath,
                                                            gSibGlobalSlotName,
                                                            gSibGlobalType)
    if gSibGlobalSlot < 0:
        return -1
    PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, gSibGlobalSlot)
    bodyIR.localSlots[gSibGlobalSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
    let gSibBaseSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#gsib_base#{bodyIR.ops.len}",
                                                     coreir.LocalPtrTag)
    let gSibIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          typedIr,
                                                          sourcePath,
                                                          idxText,
                                                          coreir.LocalI32Tag, callOrdinal)
    if gSibBaseSlot < 0 || gSibIdxSlot < 0:
        return -1
    var gSibAddrOp: coreir.BodyOp
    gSibAddrOp.kind = coreir.BodyOpGlobalLoadTag
    gSibAddrOp.target = gSibBaseSlot
    add(gSibAddrOp.operands, gSibGlobalSlot)
    add(gSibAddrOp.operands, 1)
    let _ = coreir.BodyIRAppendOp(bodyIR, gSibAddrOp)
    elemKindOut = gSibElemKind
    elemSizeOut = gSibElemSize
    idxSlotOut = gSibIdxSlot
    return gSibBaseSlot

@borrows
fn PrimaryBodyIrAppendGlobalU8ArrayStore(bodyIR: var coreir.BodyIR,
                                          slotNames: var str[],
                                          varI32ParamNames: str[],
                                          typedIr: texpr.TypedExprIr,
                                          sourcePath: str,
                                          lhsName: str,
                                          rhsText: str,
                                          callOrdinal: var int32): bool =
    # Global array indexed store: g[idx] = v (fixed `Elem[N]` or dynamic
    # `Elem[]` seq). Handles any scalar element width — the element address is
    # base + idx*elemSize (base = &g for fixed, *(&g+8) for seq), and the store
    # width is picked from the element slot type (i32 -> 4-byte, i64 -> 8-byte
    # store). uint8 keeps its byte path (elemSize 1, explicit U8 store tag).
    var gArrRoot = ""
    var gArrIdxText = ""
    if !PrimaryBodyIrIndexExprParts(lhsName, gArrRoot, gArrIdxText):
        return false
    var gArrElemKind: int32
    var gArrElemSize: int32
    # segment-s7: prefer the SIB base+index form (fixed array, elemSize 1/4/8) so
    # the IndexedStore folds base+idx*scale into one ModRM+SIB byte; -1 refusal
    # (dynamic seq / dotted / non-scalar) keeps the full-address imul+add path.
    var gArrSibIdxSlot = -1
    let gArrSibBaseSlot = PrimaryBodyIrGlobalFixedArraySibBaseIndex(bodyIR,
                                                                    slotNames,
                                                                    varI32ParamNames,
                                                                    typedIr,
                                                                    sourcePath,
                                                                    gArrRoot,
                                                                    gArrIdxText,
                                                                    gArrElemKind,
                                                                    gArrElemSize,
                                                                    gArrSibIdxSlot,
                                                                    callOrdinal)
    var gArrElemAddrSlot = gArrSibBaseSlot
    if gArrSibBaseSlot < 0:
        gArrElemAddrSlot = PrimaryBodyIrGlobalFixedArrayElemAddrSlot(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     typedIr,
                                                                     sourcePath,
                                                                     gArrRoot,
                                                                     gArrIdxText,
                                                                     gArrElemKind,
                                                                     gArrElemSize,
                                                                     callOrdinal,
                                                                     false)
    if gArrElemAddrSlot < 0:
        return false
    var gArrValueText = rhsText
    # element value slot width follows the element type: byte path strips the
    # uint8(...) cast and stores via an i32 slot; wider elements materialize an
    # i32 (4-byte) or i64 (8-byte) slot so the IndexedStore picks the right
    # store width from the value slot type.
    var gArrValueKind = coreir.LocalI32Tag
    if gArrElemSize == 1:
        let gArrU8Inner = PrimaryBodyIrTypeCastInnerForTarget(rhsText, "uint8")
        if gArrU8Inner != "":
            gArrValueText = strutil.Strip(gArrU8Inner)
    elif gArrElemSize == 8:
        gArrValueKind = coreir.LocalI64Tag
    let gArrValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            typedIr,
                                                            sourcePath,
                                                            gArrValueText,
                                                            gArrValueKind, callOrdinal)
    if gArrValueSlot < 0:
        return false
    var gArrStoreOp: coreir.BodyOp
    gArrStoreOp.kind = coreir.BodyOpIndexedStoreTag
    gArrStoreOp.target = gArrElemAddrSlot
    add(gArrStoreOp.operands, gArrElemAddrSlot)
    add(gArrStoreOp.operands, gArrValueSlot)
    # segment-s7 SIB form: [base(&g), value, rawIndex, elemSize, 2] — the emit
    # arm-1 folds base+idx*scale (mod=00 ModRM+SIB) and picks the store width from
    # elemSize (byte/dword/qword), so no separate u8 store tag is needed.
    if gArrSibBaseSlot >= 0:
        add(gArrStoreOp.operands, gArrSibIdxSlot)
        add(gArrStoreOp.operands, gArrElemSize)
        add(gArrStoreOp.operands, 2)
    elif gArrElemSize == 1:
        # elemSize 1: explicit byte store tag; wider elements drop the tag so the
        # IndexedStore picks its store width from the value slot type.
        add(gArrStoreOp.operands, coreir.BodyStoreLocalPtrDerefU8Tag)
    let _ = coreir.BodyIRAppendOp(bodyIR, gArrStoreOp)
    return true

# 全局定长数组元素**整槽 struct** 存储 `gArr[idx] = slot`(slot 为本地 struct 变量)。
# AppendGlobalU8ArrayStore 只处理标量元素(1/4/8 字节);struct 元素(>8 字节,如
# MsQuicNativeAppStreamSlot)的整槽存储走这里:GlobalFixedArrayElemAddrSlot 算元素地址
# (base + idx*elemSize 的 adrp+add+madd),AppendVarAggregateStore 发 FieldStore 聚合拷贝
# (byteCount=elemSize) 从本地 struct 槽到该地址。仅当 RHS 是已命名的本地 struct 变量
# (FindArgSlot)且槽宽≥elemSize 时放行;构造器/字段读 RHS 维持 bail_0(不冒险物化)。
@borrows
fn PrimaryBodyIrAppendGlobalFixedArrayElemStructStore(bodyIR: var coreir.BodyIR,
                                                      slotNames: var str[],
                                                      varI32ParamNames: str[],
                                                      typedIr: texpr.TypedExprIr,
                                                      sourcePath: str,
                                                      lhsName: str,
                                                      rhsText: str,
                                                      callOrdinal: var int32): bool =
    var gStructRoot = ""
    var gStructIdxText = ""
    if !PrimaryBodyIrIndexExprParts(lhsName, gStructRoot, gStructIdxText):
        return false
    var gStructElemKind: int32
    var gStructElemSize: int32
    let gStructElemAddrSlot = PrimaryBodyIrGlobalFixedArrayElemAddrSlot(bodyIR,
                                                                        slotNames,
                                                                        varI32ParamNames,
                                                                        typedIr,
                                                                        sourcePath,
                                                                        gStructRoot,
                                                                        gStructIdxText,
                                                                        gStructElemKind,
                                                                        gStructElemSize,
                                                                        callOrdinal,
                                                                        true)
    # elemSize<=8 是标量,归 AppendGlobalU8ArrayStore;这里只接聚合(>8)。
    if gStructElemAddrSlot < 0 || gStructElemSize <= 8:
        return false
    let gStructValueSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
    if gStructValueSlot < 0 || gStructValueSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[gStructValueSlot]) < gStructElemSize:
        return false
    PrimaryBodyIrAppendVarAggregateStore(bodyIR, gStructElemAddrSlot, gStructValueSlot, gStructElemSize)
    return true

# Non-emitting probe: element kind/size for a bare global scalar array `g[...]`
# (fixed `Elem[N]` or dynamic seq `Elem[]`). Returns false (size 0) for dotted
# roots, non-globals, or element widths the IndexedLoad/Store op cannot
# materialize directly.
@borrows
fn PrimaryBodyIrGlobalFixedArrayElemShape(typedIr: texpr.TypedExprIr,
                                          sourcePath: str,
                                          rootName: str,
                                          elemKindOut: var int32,
                                          elemSizeOut: var int32): bool =
    elemKindOut = coreir.LocalInvalidTag
    elemSizeOut = 0
    if PrimaryBodyIrTextHasDot(rootName):
        return false
    let normType = texpr.TypedExprNormalizeTypeText(PrimaryBodyIrTypedGlobalType(typedIr, sourcePath, rootName))
    if normType == "":
        return false
    if !PrimaryBodyIrSeqElementShapeFromText(typedIr, sourcePath, normType, elemKindOut, elemSizeOut):
        return false
    if elemSizeOut != 1 && elemSizeOut != 4 && elemSizeOut != 8:
        elemKindOut = coreir.LocalInvalidTag
        elemSizeOut = 0
        return false
    return true

# Global fixed array indexed read: g[idx] as a scalar value. Mirrors the store
# — element address = &g + idx*elemSize, then an IndexedLoad whose width is
# taken from the result slot type. `wantKind` is the caller's expected scalar
# width (i32/i64); a non-matching element (e.g. an int64[] read in an i32 slot)
# returns -1 WITHOUT emitting any ops, so the caller's other paths stay intact.
# uint8[N] reads keep their existing LoadLocal/U8 path and are refused here.
@borrows
fn PrimaryBodyIrGlobalFixedArrayIndexedLoadSlot(bodyIR: var coreir.BodyIR,
                                                slotNames: var str[],
                                                varI32ParamNames: str[],
                                                typedIr: texpr.TypedExprIr,
                                                sourcePath: str,
                                                text: str,
                                                lineNumber: int32,
                                                wantKind: int32,
                                                callOrdinal: var int32): int32 =
    var gLoadRoot = ""
    var gLoadIdxText = ""
    if !PrimaryBodyIrIndexExprParts(text, gLoadRoot, gLoadIdxText):
        return -1
    var gProbeKind: int32
    var gProbeSize: int32
    if !PrimaryBodyIrGlobalFixedArrayElemShape(typedIr, sourcePath, gLoadRoot, gProbeKind, gProbeSize):
        return -1
    # uint8[N] reads keep their existing path; only wider scalars (4/8) lower here.
    if gProbeSize == 1:
        return -1
    var gLoadValueKind = coreir.LocalI32Tag
    if gProbeSize == 8:
        gLoadValueKind = coreir.LocalI64Tag
    if gLoadValueKind != wantKind:
        return -1
    var gLoadElemKind: int32
    var gLoadElemSize: int32
    # segment-s7: prefer the SIB base+index form (fixed array, elemSize 4/8 here —
    # gProbeSize==1 already bailed above) so the IndexedLoad folds base+idx*scale;
    # -1 refusal (dynamic seq / dotted) keeps the full-address imul+add path.
    var gLoadSibIdxSlot = -1
    let gLoadSibBaseSlot = PrimaryBodyIrGlobalFixedArraySibBaseIndex(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     typedIr,
                                                                     sourcePath,
                                                                     gLoadRoot,
                                                                     gLoadIdxText,
                                                                     gLoadElemKind,
                                                                     gLoadElemSize,
                                                                     gLoadSibIdxSlot,
                                                                     callOrdinal)
    var gLoadElemAddrSlot = gLoadSibBaseSlot
    if gLoadSibBaseSlot < 0:
        gLoadElemAddrSlot = PrimaryBodyIrGlobalFixedArrayElemAddrSlot(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      typedIr,
                                                                      sourcePath,
                                                                      gLoadRoot,
                                                                      gLoadIdxText,
                                                                      gLoadElemKind,
                                                                      gLoadElemSize,
                                                                      callOrdinal,
                                                                      false)
    if gLoadElemAddrSlot < 0:
        return -1
    let gLoadValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"{text}#global_arr_elem#{lineNumber}",
                                                       gLoadValueKind)
    if gLoadValueSlot < 0:
        return -1
    var gLoadOp: coreir.BodyOp
    gLoadOp.kind = coreir.BodyOpIndexedLoadTag
    gLoadOp.target = gLoadValueSlot
    add(gLoadOp.operands, gLoadElemAddrSlot)
    add(gLoadOp.operands, gLoadValueSlot)
    # segment-s7 SIB form: [base(&g), value, rawIndex, elemSize, 2].
    if gLoadSibBaseSlot >= 0:
        add(gLoadOp.operands, gLoadSibIdxSlot)
        add(gLoadOp.operands, gLoadElemSize)
        add(gLoadOp.operands, 2)
    let _ = coreir.BodyIRAppendOp(bodyIR, gLoadOp)
    return gLoadValueSlot

# 批次2c：通用表达式节点求值器。消费 2b 产出的 rhsNodeIndex 节点 DAG，
# 组合 opKind 全部映射到既有槽位机器（LoadConst/FieldLoad/BinOp/Cmp/
# StringLiteral/VarLoad）。求值失败返回 -1，首因 opKind 文本记入
# primaryBodyIrNodeEvalMissOp（迁移窗口 miss 直方图）。

fn PrimaryBodyIrNodeEvalMissAt(opText: str): int32 =
    if primaryBodyIrNodeEvalMissOp == "":
        primaryBodyIrNodeEvalMissOp = opText
    return -1

# Arithmetic BinOp (i32/i64/f64 add/sub/mul/madd/sdiv/bitwise/shift) result type
# kind for the node-eval path, or LocalInvalidTag if opKind isn't one the node
# path handles. The node path previously bailed on BinOp index expressions
# (e.g. `curSlot*count+idx` = I32Add): the probe had no BinOp branch → returned
# -1 → IndexGet probe failed → node path skipped → text path couldn't lower
# nested `g[binop].field` aggregate (Bytes) returns, blocking 44
# gClientAppStream/gServerAppStream accessors (and the 2 full-slot getters).
# Handling BinOps here lets the node path evaluate computed indices — mirrors
# the text-path BinOp emission (8879-8886) and the IndexGet address Madd
# (25189-25195). Madd is 3-operand (a*b+c, operand2=c). Set limited to opKinds
# the backend BodyOpBinOpTag already executes (text-path-proven i32 set + i64
# counterparts + Madd); Udiv/Mod/Umod/I32Lsr/Neg/StrAdd stay text-path for now.
# I64Lsr admitted (707 解封): BinOpMeta already folds I64Lsr→I32Lsr and the
# arm64 filler dispatches A64EncLsrv with opIs64 — only this gate was missing,
# so `u64expr >> u64(shift)` trees (rsa.cheng:743 rsaBigToBytesLocalFill) fell
# to the text path, which can't lower imported-struct indexed reads → bail 707.
fn PrimaryBodyIrNodeEvalArithBinOpResultKind(opKind: int32): int32 =
    if opKind == texpr.TypedExprIrOpI32Add ||
       opKind == texpr.TypedExprIrOpI32Sub ||
       opKind == texpr.TypedExprIrOpI32Mul ||
       opKind == texpr.TypedExprIrOpI32Madd ||
       opKind == texpr.TypedExprIrOpI32Sdiv ||
       opKind == texpr.TypedExprIrOpI32BitAnd ||
       opKind == texpr.TypedExprIrOpI32BitOr ||
       opKind == texpr.TypedExprIrOpI32BitXor ||
       opKind == texpr.TypedExprIrOpI32Asr ||
       opKind == texpr.TypedExprIrOpI32Lsl:
        return coreir.LocalI32Tag
    if opKind == texpr.TypedExprIrOpI64Add ||
       opKind == texpr.TypedExprIrOpI64Sub ||
       opKind == texpr.TypedExprIrOpI64Mul ||
       opKind == texpr.TypedExprIrOpI64Sdiv ||
       opKind == texpr.TypedExprIrOpI64BitAnd ||
       opKind == texpr.TypedExprIrOpI64BitOr ||
       opKind == texpr.TypedExprIrOpI64BitXor ||
       opKind == texpr.TypedExprIrOpI64Asr ||
       opKind == texpr.TypedExprIrOpI64Lsr ||
       opKind == texpr.TypedExprIrOpI64Lsl:
        return coreir.LocalI64Tag
    if opKind == texpr.TypedExprIrOpF64Add ||
       opKind == texpr.TypedExprIrOpF64Sub ||
       opKind == texpr.TypedExprIrOpF64Mul ||
       opKind == texpr.TypedExprIrOpF64Div:
        return coreir.LocalF64Tag
    return coreir.LocalInvalidTag

# i32 槽显式 sign-extend 到 i64 临时槽（CopyLocal i32→i64 = ldrsw）：
# FillBinOp/FillCmpOp 装载 i32 槽是零扩展，混宽度运算必须先显式加宽。
fn PrimaryBodyIrNodeEvalWidenToI64(bodyIR: var coreir.BodyIR,
                                    slotNames: var str[],
                                    slotId: int32,
                                    nodeIndex: int32,
                                    lane: int32): int32 =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return -1
    let slotKind = PrimaryBodyIrSlotType(bodyIR, slotId)
    if slotKind == coreir.LocalI64Tag:
        return slotId
    if slotKind != coreir.LocalI32Tag:
        return -1
    let wideSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"#nev{nodeIndex}#w{lane}",
                                                 coreir.LocalI64Tag)
    if wideSlot < 0:
        return -1
    var widenOp: coreir.BodyOp
    widenOp.kind = coreir.BodyOpCopyLocalTag
    widenOp.target = wideSlot
    add(widenOp.operands, slotId)
    let _ = coreir.BodyIRAppendOp(bodyIR, widenOp)
    return wideSlot

# 算术/位/移位节点 → BinOp 元数据。arm64 FillBinOp 的 opKind 命名空间是
# I32 系枚举值 + 类型标签定宽，I64 变体折算回 I32 基操作码 + LocalI64Tag。
# mod 没有单 op，置 isModOut 走 div/mul/sub 三连（既有 -100 模式同款）。
fn PrimaryBodyIrNodeEvalBinOpMeta(opKind: texpr.TypedExprIrOpKind,
                                   typeTagOut: var int32,
                                   baseOpOut: var int32,
                                   isModOut: var bool,
                                   modDivBaseOpOut: var int32): bool =
    typeTagOut = coreir.LocalI32Tag
    baseOpOut = -1
    isModOut = false
    modDivBaseOpOut = int32(texpr.TypedExprIrOpI32Sdiv)
    if opKind == texpr.TypedExprIrOpI32Add ||
       opKind == texpr.TypedExprIrOpI32Sub ||
       opKind == texpr.TypedExprIrOpI32Mul ||
       opKind == texpr.TypedExprIrOpI32Sdiv ||
       opKind == texpr.TypedExprIrOpI32Udiv ||
       opKind == texpr.TypedExprIrOpI32BitAnd ||
       opKind == texpr.TypedExprIrOpI32BitOr ||
       opKind == texpr.TypedExprIrOpI32BitXor ||
       opKind == texpr.TypedExprIrOpI32Lsl ||
       opKind == texpr.TypedExprIrOpI32Lsr ||
       opKind == texpr.TypedExprIrOpI32Asr:
        baseOpOut = int32(opKind)
        return true
    if opKind == texpr.TypedExprIrOpI32Mod:
        isModOut = true
        modDivBaseOpOut = int32(texpr.TypedExprIrOpI32Sdiv)
        return true
    if opKind == texpr.TypedExprIrOpI32Umod:
        isModOut = true
        modDivBaseOpOut = int32(texpr.TypedExprIrOpI32Udiv)
        return true
    typeTagOut = coreir.LocalI64Tag
    if opKind == texpr.TypedExprIrOpI64Add:
        baseOpOut = int32(texpr.TypedExprIrOpI32Add)
        return true
    if opKind == texpr.TypedExprIrOpI64Sub:
        baseOpOut = int32(texpr.TypedExprIrOpI32Sub)
        return true
    if opKind == texpr.TypedExprIrOpI64Mul:
        baseOpOut = int32(texpr.TypedExprIrOpI32Mul)
        return true
    if opKind == texpr.TypedExprIrOpI64Sdiv:
        baseOpOut = int32(texpr.TypedExprIrOpI32Sdiv)
        return true
    if opKind == texpr.TypedExprIrOpI64Udiv:
        baseOpOut = int32(texpr.TypedExprIrOpI32Udiv)
        return true
    if opKind == texpr.TypedExprIrOpI64Lsr:
        baseOpOut = int32(texpr.TypedExprIrOpI32Lsr)
        return true
    if opKind == texpr.TypedExprIrOpI64BitAnd:
        baseOpOut = int32(texpr.TypedExprIrOpI32BitAnd)
        return true
    if opKind == texpr.TypedExprIrOpI64BitOr:
        baseOpOut = int32(texpr.TypedExprIrOpI32BitOr)
        return true
    if opKind == texpr.TypedExprIrOpI64BitXor:
        baseOpOut = int32(texpr.TypedExprIrOpI32BitXor)
        return true
    if opKind == texpr.TypedExprIrOpI64Lsl:
        baseOpOut = int32(texpr.TypedExprIrOpI32Lsl)
        return true
    if opKind == texpr.TypedExprIrOpI64Asr:
        baseOpOut = int32(texpr.TypedExprIrOpI32Asr)
        return true
    if opKind == texpr.TypedExprIrOpI64Mod:
        isModOut = true
        modDivBaseOpOut = int32(texpr.TypedExprIrOpI32Sdiv)
        return true
    if opKind == texpr.TypedExprIrOpI64Umod:
        isModOut = true
        modDivBaseOpOut = int32(texpr.TypedExprIrOpI32Udiv)
        return true
    typeTagOut = coreir.LocalF64Tag
    if opKind == texpr.TypedExprIrOpF64Add ||
       opKind == texpr.TypedExprIrOpF64Sub ||
       opKind == texpr.TypedExprIrOpF64Mul ||
       opKind == texpr.TypedExprIrOpF64Div:
        baseOpOut = int32(opKind)
        return true
    return false

fn PrimaryBodyIrNodeEvalCmpCondTag(opKind: texpr.TypedExprIrOpKind): int32 =
    if opKind == texpr.TypedExprIrOpCmpEq:
        return coreir.BodyCondI32EqTag
    if opKind == texpr.TypedExprIrOpCmpNe:
        return coreir.BodyCondI32NeTag
    if opKind == texpr.TypedExprIrOpCmpLt:
        return coreir.BodyCondI32LtTag
    if opKind == texpr.TypedExprIrOpCmpLe:
        return coreir.BodyCondI32LeTag
    if opKind == texpr.TypedExprIrOpCmpGt:
        return coreir.BodyCondI32GtTag
    if opKind == texpr.TypedExprIrOpCmpGe:
        return coreir.BodyCondI32GeTag
    return -1

fn PrimaryBodyIrNodeEvalF64CmpCondTag(signedTag: int32): int32 =
    if signedTag == coreir.BodyCondI32EqTag:
        return coreir.BodyCondF64EqTag
    if signedTag == coreir.BodyCondI32NeTag:
        return coreir.BodyCondF64NeTag
    if signedTag == coreir.BodyCondI32LtTag:
        return coreir.BodyCondF64LtTag
    if signedTag == coreir.BodyCondI32LeTag:
        return coreir.BodyCondF64LeTag
    if signedTag == coreir.BodyCondI32GtTag:
        return coreir.BodyCondF64GtTag
    if signedTag == coreir.BodyCondI32GeTag:
        return coreir.BodyCondF64GeTag
    return -1

# 无符号比较的条件码选择(hi/hs/lo/ls)与有符号(gt/ge/lt/le)不同：高位
# 置位的无符号操作数当作大正数而非负数。仅当两侧操作数都是无符号整型时
# 才把有符号序比较 tag(Lt/Le/Gt/Ge)提升为无符号变体；Eq/Ne 与符号无关
# 不变。is64 决定 U32 还是 U64 变体(机器码 cmp 宽度由槽宽决定，tag 仅选
# 条件码)。混入任一有符号操作数时保持有符号(返回原 tag)。
fn PrimaryBodyIrNodeEvalUnsignedCmpCondTag(signedTag: int32, is64: bool): int32 =
    if signedTag == coreir.BodyCondI32LtTag:
        return is64 ? coreir.BodyCondU64LtTag : coreir.BodyCondU32LtTag
    if signedTag == coreir.BodyCondI32LeTag:
        return is64 ? coreir.BodyCondU64LeTag : coreir.BodyCondU32LeTag
    if signedTag == coreir.BodyCondI32GtTag:
        return is64 ? coreir.BodyCondU64GtTag : coreir.BodyCondU32GtTag
    if signedTag == coreir.BodyCondI32GeTag:
        return is64 ? coreir.BodyCondU64GeTag : coreir.BodyCondU32GeTag
    return signedTag

# GlobalSeqAddressSlot 产出的"持源地址 Ptr"槽以 `#global_seq_addr` 结尾
#（见 PrimaryBodyIrGlobalSeqAddressSlot：addrSlot 名 = `{slot}#global_seq_addr`，
# typeKind=Ptr，值经 BodyOpGlobalLoad(globalSlot, 1) = &global）。该 Ptr 持
# 全局聚合/seq 头的源地址，不是数据指针。严格按槽名后缀辨别，绝不对任意
# Ptr→Agg 开块拷路径（否则把已是数据指针的 Ptr 多解引用一层读错=miscompile）。
fn PrimaryBodyIrSlotIsGlobalSeqAddress(slotNames: var str[], slotId: int32): bool =
    if slotId < 0 || slotId >= slotNames.len:
        return false
    let name = slotNames[slotId]
    let suffix = "#global_seq_addr"
    if len(name) < len(suffix):
        return false
    let base = len(name) - len(suffix)
    for k in 0..<len(suffix):
        if name[base + k] != suffix[k]:
            return false
    return true

# 求值结果槽 → 标量/str LHS 槽。允许 i32→i32、i64→i64、
# i32→i64（CopySlot sign-extend）、str→str。str param 槽存的是地址
#（8 字节 save slot）：param 值经 FieldLoad 24 字节间接物化，str 形参
# LHS（必为 var str 形参，非 var 形参不可赋值）经 FieldStore 24 字节
# 回写目的地址——与既有文本路径 var-str-param 机器同款。
fn PrimaryBodyIrNodeEvalStore(bodyIR: var coreir.BodyIR,
                               slotNames: var str[],
                               lhsSlot: int32,
                               valueSlot: int32): bool =
    if lhsSlot < 0 || lhsSlot >= bodyIR.localSlots.len ||
       valueSlot < 0 || valueSlot >= bodyIR.localSlots.len:
        return false
    if lhsSlot == valueSlot:
        return true
    let lhsKind = PrimaryBodyIrSlotType(bodyIR, lhsSlot)
    let valueKind = PrimaryBodyIrSlotType(bodyIR, valueSlot)
    if lhsKind == coreir.LocalStrTag && valueKind == coreir.LocalStrTag:
        let lhsIsParam = PrimaryBodyIrLocalIsParam(bodyIR.localSlots[lhsSlot])
        let valueIsParam = PrimaryBodyIrLocalIsParam(bodyIR.localSlots[valueSlot])
        if lhsIsParam:
            var strSrcSlot = valueSlot
            if valueIsParam:
                strSrcSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"#nevs{lhsSlot}#{bodyIR.ops.len}",
                                                           coreir.LocalStrTag)
                if strSrcSlot < 0:
                    let _ = PrimaryBodyIrNodeEvalMissAt("store_shape_str_tmp")
                    return false
                var strMatOp: coreir.BodyOp
                strMatOp.kind = coreir.BodyOpFieldLoadTag
                strMatOp.target = strSrcSlot
                add(strMatOp.operands, valueSlot)
                add(strMatOp.operands, strSrcSlot)
                add(strMatOp.operands, 0)
                add(strMatOp.operands, 24)
                let _ = coreir.BodyIRAppendOp(bodyIR, strMatOp)
            PrimaryBodyIrAppendVarAggregateStore(bodyIR, lhsSlot, strSrcSlot, 24)
            return true
        if valueIsParam:
            var strLoadOp: coreir.BodyOp
            strLoadOp.kind = coreir.BodyOpFieldLoadTag
            strLoadOp.target = lhsSlot
            add(strLoadOp.operands, valueSlot)
            add(strLoadOp.operands, lhsSlot)
            add(strLoadOp.operands, 0)
            add(strLoadOp.operands, 24)
            let _ = coreir.BodyIRAppendOp(bodyIR, strLoadOp)
            return true
        var copyStrOp: coreir.BodyOp
        copyStrOp.kind = coreir.BodyOpCopyLocalTag
        copyStrOp.target = lhsSlot
        add(copyStrOp.operands, valueSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, copyStrOp)
        return true
    if lhsKind == coreir.LocalAggregateTag && valueKind == coreir.LocalAggregateTag:
        # 聚合整体拷贝（seq[i]/字段路径/本地聚合）：源与目标大小必须精确相等；
        # 任何不等都是错宽 miscompile，诚实拒绝转 gap。搬运宽度约束按发射器
        # 实际能力分支收：param 侧走 FieldLoad/FieldStore（%4 块 + 逐字节
        # FillCopyMemory，任意大小都可），非 param 侧走 CopyLocal（仅 1/2/4 或
        # 8 字节块）。单 int32 字段结构体（size 4）从按值形参拷进 var local 即
        # 此前 %8 守卫误拒、留未初始化槽（byval_struct_local_copy miscompile）。
        let aggLhsSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[lhsSlot])
        let aggValueSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot])
        if aggLhsSize <= 0 || aggLhsSize != aggValueSize:
            let _ = PrimaryBodyIrNodeEvalMissAt(Fmt"store_shape_agg_l{aggLhsSize}_v{aggValueSize}")
            return false
        let aggLhsIsParam = PrimaryBodyIrLocalIsParam(bodyIR.localSlots[lhsSlot])
        let aggValueIsParam = PrimaryBodyIrLocalIsParam(bodyIR.localSlots[valueSlot])
        # param 侧 FieldLoad/FieldStore 支持 %4 与逐字节任意大小；非 param 侧
        # CopyLocal 支持 1/2 标量宽、4 字节整块、以及任意 %4==0 大小（8 字节块
        # 对齐则走 8 字节块，否则按 4 字节块拷贝，嵌套 struct 如 12 字节经此路径）。
        let aggSizeFieldCopyable = aggLhsSize % 4 == 0 || aggLhsSize == 1 || aggLhsSize == 2
        let aggSizeCopyLocalable = aggLhsSize == 1 || aggLhsSize == 2 ||
                                   aggLhsSize % 4 == 0
        if aggLhsIsParam || aggValueIsParam:
            if !aggSizeFieldCopyable:
                let _ = PrimaryBodyIrNodeEvalMissAt(Fmt"store_shape_agg_l{aggLhsSize}_v{aggValueSize}")
                return false
        else:
            if !aggSizeCopyLocalable:
                let _ = PrimaryBodyIrNodeEvalMissAt(Fmt"store_shape_agg_l{aggLhsSize}_v{aggValueSize}")
                return false
        if aggLhsIsParam:
            var aggSrcSlot = valueSlot
            if aggValueIsParam:
                aggSrcSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                                slotNames,
                                                                Fmt"#nevagg{lhsSlot}#{bodyIR.ops.len}",
                                                                coreir.LocalAggregateTag,
                                                                aggLhsSize,
                                                                8)
                if aggSrcSlot < 0:
                    let _ = PrimaryBodyIrNodeEvalMissAt("store_shape_agg_tmp")
                    return false
                var aggMatOp: coreir.BodyOp
                aggMatOp.kind = coreir.BodyOpFieldLoadTag
                aggMatOp.target = aggSrcSlot
                add(aggMatOp.operands, valueSlot)
                add(aggMatOp.operands, aggSrcSlot)
                add(aggMatOp.operands, 0)
                add(aggMatOp.operands, aggLhsSize)
                let _ = coreir.BodyIRAppendOp(bodyIR, aggMatOp)
            PrimaryBodyIrAppendVarAggregateStore(bodyIR, lhsSlot, aggSrcSlot, aggLhsSize)
            return true
        if aggValueIsParam:
            var aggLoadOp: coreir.BodyOp
            aggLoadOp.kind = coreir.BodyOpFieldLoadTag
            aggLoadOp.target = lhsSlot
            add(aggLoadOp.operands, valueSlot)
            add(aggLoadOp.operands, lhsSlot)
            add(aggLoadOp.operands, 0)
            add(aggLoadOp.operands, aggLhsSize)
            let _ = coreir.BodyIRAppendOp(bodyIR, aggLoadOp)
            return true
        var aggCopyOp: coreir.BodyOp
        aggCopyOp.kind = coreir.BodyOpCopyLocalTag
        aggCopyOp.target = lhsSlot
        add(aggCopyOp.operands, valueSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, aggCopyOp)
        return true
    # `var local = <裸全局聚合/seq>`：RHS 裸全局经 GlobalSeqAddressSlot 物化成
    # 持源地址的 Ptr 槽（名后缀 `#global_seq_addr`，值=&global）。LHS 是本地
    # 聚合 var（非 param），整值快照拷贝。发 FieldLoad[ptrSrc, lhsSlot, 0,
    # aggLhsSize]：base=Ptr → 填充器解引用源地址、X64BodyCopyMemory 原始块拷
    # 精确 aggLhsSize 字节进 lhsSlot 栈槽（与 str-param 24 字节 FieldLoad 同款
    # 机器）。byteCount 必须精确 = aggLhsSize（源全局头精确尺寸，严禁向上取整，
    # 越写相邻栈槽=corrupt header）。seq 只浅拷 16 字节头 {len,cap,buf}，buffer
    # 指针别名共享（Cheng seq-by-value 只读快照语义，不触发 grow）。
    if lhsKind == coreir.LocalAggregateTag &&
       valueKind == coreir.LocalPtrTag &&
       !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[lhsSlot]) &&
       PrimaryBodyIrSlotIsGlobalSeqAddress(slotNames, valueSlot):
        let gsaLhsSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[lhsSlot])
        if gsaLhsSize <= 0:
            let _ = PrimaryBodyIrNodeEvalMissAt(Fmt"store_shape_gsa_l{gsaLhsSize}")
            return false
        var gsaLoadOp: coreir.BodyOp
        gsaLoadOp.kind = coreir.BodyOpFieldLoadTag
        gsaLoadOp.target = lhsSlot
        add(gsaLoadOp.operands, valueSlot)
        add(gsaLoadOp.operands, lhsSlot)
        add(gsaLoadOp.operands, 0)
        add(gsaLoadOp.operands, gsaLhsSize)
        let _ = coreir.BodyIRAppendOp(bodyIR, gsaLoadOp)
        return true
    var storeOk = false
    if lhsKind == coreir.LocalI32Tag && valueKind == coreir.LocalI32Tag:
        storeOk = true
    elif lhsKind == coreir.LocalI64Tag &&
         (valueKind == coreir.LocalI64Tag || valueKind == coreir.LocalI32Tag):
        storeOk = true
    elif lhsKind == coreir.LocalF64Tag && valueKind == coreir.LocalF64Tag:
        storeOk = true
    elif lhsKind == coreir.LocalPtrTag && valueKind == coreir.LocalPtrTag:
        storeOk = true
    if !storeOk:
        # 残余形态带槽类标注进 miss 直方图（迁移窗口观测）
        let _ = PrimaryBodyIrNodeEvalMissAt(Fmt"store_shape_l{lhsKind}_v{valueKind}")
        return false
    var copyOp: coreir.BodyOp
    copyOp.kind = coreir.BodyOpCopyLocalTag
    copyOp.target = lhsSlot
    add(copyOp.operands, valueSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, copyOp)
    return true

# len(x)/Len(x) 内征：不是真调用——文本路径经 AppendStrLenArgValue（str@8 w4）
# 做纯字段读。节点路径若按泛型调用解析会在 ordinal 注册失败（len 非真函数）→
# call_ordinal miss。此处镜像文本内征：单实参节点（str），FieldLoad 读 len 字段
# 宽 4 → i32。仅 str 单值（值传递、24B 内联头）经此路径；seq T[] 头按引用/指针
# 传参，偏移随上下文变（与 SeqRefForText 一致），由现有文本路径处理，节点路径
# 这里返回 miss 不接管。
@borrows
fn PrimaryBodyIrLenCallArgNodeIndex(typedIr: texpr.TypedExprIr,
                                     nodeIndex: int32): int32 =
    if typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        return -1
    let lenLitRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_literalTextIds[nodeIndex])
    if !IsOk(lenLitRes):
        return -1
    let lenLit = Value(lenLitRes)
    if lenLit != "len" && lenLit != "Len" &&
       texpr.TypedExprQualifiedCallLeaf(lenLit) != "bytesLen":
        return -1
    let lenArgLink = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex)
    if lenArgLink < 0 || lenArgLink >= typedIr.nodes2_nodeIndexs.len:
        return -1
    if typedIr.nodes2_opKinds[lenArgLink] != texpr.TypedExprIrOpArgLink:
        return -1
    if arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, lenArgLink) >= 0:
        return -1
    let lenArgNodeIndex = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, lenArgLink)
    if lenArgNodeIndex < 0 || lenArgNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return -1
    return lenArgNodeIndex

# len 字段偏移：str→8（24B 值头，len@8）；rawbytes.Bytes→8（{data:ptr@0,len:int32@8}
# 16B 聚合,见 src/std/rawbytes.cheng:16-20,BytesLen(b)=b.len）。seq/其它类型返回
# -1,由文本路径处理。
fn PrimaryBodyIrLenFieldOffsetForType(typeTextRaw: str): int32 =
    let lenType = texpr.TypedExprStripVarType(typeTextRaw)
    if lenType == "str":
        return 8
    if lenType == "Bytes" || lenType == "rawbytes.Bytes":
        return 8
    return -1

@borrows
fn PrimaryBodyIrResultProjectionArgNodeIndex(typedIr: texpr.TypedExprIr,
                                               nodeIndex: int32,
                                               projectKindOut: var int32): int32 =
    projectKindOut = coreir.BodyResultProjectInvalidTag
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        return -1
    let callHeadRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                           typedIr.nodes2_literalTextIds[nodeIndex])
    if !IsOk(callHeadRes):
        return -1
    let callHead: str = Value(callHeadRes)
    if callHead == "Value" || callHead == "result.Value":
        projectKindOut = coreir.BodyResultProjectValueStrTag
    elif callHead == "IsOk" || callHead == "result.IsOk":
        projectKindOut = coreir.BodyResultProjectIsOkTag
    elif callHead == "IsErr" || callHead == "result.IsErr":
        projectKindOut = coreir.BodyResultProjectIsErrTag
    else:
        return -1
    let argLink = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                               typedIr.nodes2_operand0NodeIndexs,
                                               nodeIndex)
    if argLink < 0 || argLink >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[argLink] != texpr.TypedExprIrOpArgLink ||
       arenamod.ArenaArrayInt32Get(typedIr.arena,
                                    typedIr.nodes2_operand1NodeIndexs,
                                    argLink) >= 0 ||
       arenamod.ArenaArrayInt32Get(typedIr.arena,
                                    typedIr.nodes2_operand2NodeIndexs,
                                    argLink) >= 0:
        projectKindOut = coreir.BodyResultProjectInvalidTag
        return -1
    let argNodeIndex = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                    typedIr.nodes2_operand0NodeIndexs,
                                                    argLink)
    if argNodeIndex < 0 || argNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        projectKindOut = coreir.BodyResultProjectInvalidTag
        return -1
    let argOp = typedIr.nodes2_opKinds[argNodeIndex]
    if argOp != texpr.TypedExprIrOpParamRef &&
       argOp != texpr.TypedExprIrOpLocalRef &&
       argOp != texpr.TypedExprIrOpCallExpr:
        projectKindOut = coreir.BodyResultProjectInvalidTag
        return -1
    return argNodeIndex

@borrows
fn PrimaryBodyIrResultValueArgNodeIndex(typedIr: texpr.TypedExprIr,
                                         nodeIndex: int32): int32 =
    var projectKind = coreir.BodyResultProjectInvalidTag
    let argNodeIndex = PrimaryBodyIrResultProjectionArgNodeIndex(typedIr,
                                                                  nodeIndex,
                                                                  projectKind)
    if projectKind != coreir.BodyResultProjectValueStrTag:
        return -1
    return argNodeIndex

@borrows
fn PrimaryBodyIrResultValueArgName(typedIr: texpr.TypedExprIr, argNodeIndex: int32): str =
    let rvaPnRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_paramNameIds[argNodeIndex])
    let rvaStRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_surfaceTextIds[argNodeIndex])
    var rvArgName = ""
    if IsOk(rvaPnRes):
        rvArgName = Value(rvaPnRes)
    if rvArgName == "" && IsOk(rvaStRes):
        rvArgName = strutil.Strip(Value(rvaStRes))
    return rvArgName

@borrows
fn PrimaryBodyIrResultProjectionArgBindingName(typedIr: texpr.TypedExprIr,
                                                argNodeIndex: int32): str =
    if argNodeIndex < 0 || argNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return ""
    let argOp = typedIr.nodes2_opKinds[argNodeIndex]
    if argOp != texpr.TypedExprIrOpParamRef && argOp != texpr.TypedExprIrOpLocalRef:
        return ""
    let nameRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                       typedIr.nodes2_paramNameIds[argNodeIndex])
    if !IsOk(nameRes):
        return ""
    return Value(nameRes)

# Error(r) 投影：与 IsErr 同形态识别（Result 源聚合的 errmsg@40 w24 → str）。
# literalText 头为 Error / result.Error，单参指向 Param/LocalRef 的 Result 槽。
@borrows
fn PrimaryBodyIrResultErrorArgNodeIndex(typedIr: texpr.TypedExprIr,
                                         nodeIndex: int32): int32 =
    if typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        return -1
    let erLitRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_literalTextIds[nodeIndex])
    if !IsOk(erLitRes):
        return -1
    let erLit = Value(erLitRes)
    if erLit != "Error" && erLit != "result.Error":
        return -1
    let erArgLink = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex)
    if erArgLink < 0 || erArgLink >= typedIr.nodes2_nodeIndexs.len:
        return -1
    if typedIr.nodes2_opKinds[erArgLink] != texpr.TypedExprIrOpArgLink:
        return -1
    if arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, erArgLink) >= 0:
        return -1
    let erArgNodeIndex = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, erArgLink)
    if erArgNodeIndex < 0 || erArgNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return -1
    if typedIr.nodes2_opKinds[erArgNodeIndex] != texpr.TypedExprIrOpParamRef &&
       typedIr.nodes2_opKinds[erArgNodeIndex] != texpr.TypedExprIrOpLocalRef &&
       typedIr.nodes2_opKinds[erArgNodeIndex] != texpr.TypedExprIrOpCallExpr:
        return -1
    return erArgNodeIndex

@borrows
fn PrimaryBodyIrResultErrorSourceSlot(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       typedIr: texpr.TypedExprIr,
                                       nodeIndex: int32): int32 =
    let erArgNodeIndex = PrimaryBodyIrResultErrorArgNodeIndex(typedIr, nodeIndex)
    if erArgNodeIndex < 0:
        return -1
    let erArgName = PrimaryBodyIrResultValueArgName(typedIr, erArgNodeIndex)
    if erArgName == "":
        return -1
    let erSrcSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, erArgName)
    if erSrcSlot < 0 || erSrcSlot >= bodyIR.localSlots.len:
        return -1
    if PrimaryBodyIrSlotType(bodyIR, erSrcSlot) != coreir.LocalAggregateTag:
        return -1
    # errmsg 偏移须随源内型解算（标量内型 Result 的 errmsg 落 < 40）；解不出
    # 内型/布局即拒绝（不可用固定 40 读小 Result 的越界字节）。
    let erMsgOffset = PrimaryBodyIrResultErrorSourceErrMsgOffset(typedIr, nodeIndex)
    if erMsgOffset < 0:
        return -1
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[erSrcSlot]) < erMsgOffset + 24:
        return -1
    return erSrcSlot

# Error(r) 投影偏移：errmsg 在源 Result 聚合里的字节偏移随源内型 T 而变
#（value@aligned(1,align(T))，err 块@aligned(value+size(T),8)，errmsg=err+8）。
# 仅当源内型为 str/聚合等使 errmsg 落 40 时旧的固定常量才对；int32/enum 等
# 标量内型的源 Result errmsg 落更低偏移（如 16）。本函数从源节点的 Result
# 类型解出内型并用构造布局公式算出准确 errmsg 偏移，供探针/发射两路共享。
# 失败（拿不到具体内型/布局）返回 -1，调用方落回 miss（绝不发错偏移投影）。
@borrows
fn PrimaryBodyIrResultErrorSourceErrMsgOffset(typedIr: texpr.TypedExprIr,
                                               nodeIndex: int32): int32 =
    let erArgNodeIndex = PrimaryBodyIrResultErrorArgNodeIndex(typedIr, nodeIndex)
    if erArgNodeIndex < 0:
        return -1
    let ersmFnRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_functionNameIds[nodeIndex])
    let ersmSrcRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_sourcePathIds[nodeIndex])
    let ersmArgTypeRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_resultTypeIds[erArgNodeIndex])
    if !IsOk(ersmFnRes) || !IsOk(ersmSrcRes) || !IsOk(ersmArgTypeRes):
        return -1
    # form59 residual: hoist Value(Result[str]) before StripVarType
    let ersmArgType_f59: str = Value(ersmArgTypeRes)
    var erInner = texpr.TypedExprResultSuccessType(texpr.TypedExprStripVarType(ersmArgType_f59))
    if erInner == "":
        let erArgName = PrimaryBodyIrResultValueArgName(typedIr, erArgNodeIndex)
        if erArgName == "":
            return -1
        erInner = texpr.TypedExprResultSuccessType(texpr.TypedExprIrPriorBindingType(typedIr,
                                                                                     Value(ersmSrcRes),
                                                                                     Value(ersmFnRes),
                                                                                     arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_lineNumbers, nodeIndex),
                                                                                     erArgName))
    if erInner == "":
        return -1
    var erValueKind: int32
    var erValueSize: int32
    var erValueOffset: int32
    var erErrCodeOffset: int32
    var erErrMsgOffset: int32
    var erTotalSize: int32
    if !PrimaryBodyIrResultConstructLayout(typedIr,
                                           Value(ersmSrcRes),
                                           erInner,
                                           erValueKind,
                                           erValueSize,
                                           erValueOffset,
                                           erErrCodeOffset,
                                           erErrMsgOffset,
                                           erTotalSize):
        return -1
    return erErrMsgOffset

# ErrorInfoOf(r) 投影：与 Error 同形态识别（Result 源聚合的 err 子块 → ErrorInfo
# 聚合）。literalText 头为 ErrorInfoOf / result.ErrorInfoOf，单参指向 Param/
# LocalRef 的 Result 槽。
@borrows
fn PrimaryBodyIrResultErrInfoArgNodeIndex(typedIr: texpr.TypedExprIr,
                                           nodeIndex: int32): int32 =
    if typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
        return -1
    let eiLitRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_literalTextIds[nodeIndex])
    if !IsOk(eiLitRes):
        return -1
    if texpr.TypedExprQualifiedCallLeaf(Value(eiLitRes)) != "ErrorInfoOf":
        return -1
    let eiArgLink = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex)
    if eiArgLink < 0 || eiArgLink >= typedIr.nodes2_nodeIndexs.len:
        return -1
    if typedIr.nodes2_opKinds[eiArgLink] != texpr.TypedExprIrOpArgLink:
        return -1
    if arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, eiArgLink) >= 0:
        return -1
    let eiArgNodeIndex = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, eiArgLink)
    if eiArgNodeIndex < 0 || eiArgNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return -1
    if typedIr.nodes2_opKinds[eiArgNodeIndex] != texpr.TypedExprIrOpParamRef &&
       typedIr.nodes2_opKinds[eiArgNodeIndex] != texpr.TypedExprIrOpLocalRef:
        return -1
    return eiArgNodeIndex

# ErrorInfoOf(r) 源 Result 内型 → err 子块字节偏移与大小。err 块在源 Result
# 聚合里从 errCodeOffset 起、到 totalSize 止（含 code+pad+msg），整块即
# ErrorInfo 布局。偏移随源内型 T 解算（与 Error/Value 投影同源）。
@borrows
fn PrimaryBodyIrResultErrInfoSourceBlock(typedIr: texpr.TypedExprIr,
                                          nodeIndex: int32,
                                          blockOffsetOut: var int32,
                                          blockSizeOut: var int32): bool =
    blockOffsetOut = 0
    blockSizeOut = 0
    let eiArgNodeIndex = PrimaryBodyIrResultErrInfoArgNodeIndex(typedIr, nodeIndex)
    if eiArgNodeIndex < 0:
        return false
    let eisbFnRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_functionNameIds[nodeIndex])
    let eisbSrcRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_sourcePathIds[nodeIndex])
    let eisbArgTypeRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_resultTypeIds[eiArgNodeIndex])
    if !IsOk(eisbFnRes) || !IsOk(eisbSrcRes) || !IsOk(eisbArgTypeRes):
        return false
    # form59 residual: hoist Value(Result[str]) before StripVarType
    let eisbArgType_f59: str = Value(eisbArgTypeRes)
    var eiInner = texpr.TypedExprResultSuccessType(texpr.TypedExprStripVarType(eisbArgType_f59))
    if eiInner == "":
        let eiArgName = PrimaryBodyIrResultValueArgName(typedIr, eiArgNodeIndex)
        if eiArgName == "":
            return false
        eiInner = texpr.TypedExprResultSuccessType(texpr.TypedExprIrPriorBindingType(typedIr,
                                                                                     Value(eisbSrcRes),
                                                                                     Value(eisbFnRes),
                                                                                     arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_lineNumbers, nodeIndex),
                                                                                     eiArgName))
    if eiInner == "":
        return false
    var eiValueKind: int32
    var eiValueSize: int32
    var eiValueOffset: int32
    var eiErrCodeOffset: int32
    var eiErrMsgOffset: int32
    var eiTotalSize: int32
    if !PrimaryBodyIrResultConstructLayout(typedIr,
                                           Value(eisbSrcRes),
                                           eiInner,
                                           eiValueKind,
                                           eiValueSize,
                                           eiValueOffset,
                                           eiErrCodeOffset,
                                           eiErrMsgOffset,
                                           eiTotalSize):
        return false
    if eiTotalSize <= eiErrCodeOffset:
        return false
    blockOffsetOut = eiErrCodeOffset
    blockSizeOut = eiTotalSize - eiErrCodeOffset
    return true

# (c)族②精修: 尺寸门豁免只许"地址间接的 var 形参"(物理槽 sizeBytes 是不透明
# 占位), by-value 形参槽 sizeBytes 是真实聚合尺寸(实测 Result[int32]=40), 该
# 校验对其仍是有意义的安全网, 不得笼统按 IsParam 豁免。判定=形参槽 且 源实参
# 节点声明类型文本带 var 前缀(与 CallArgSlotCarriesAddressValue 同款口径)。
@borrows
fn PrimaryBodyIrResultErrInfoSrcSlotIsVarParam(srcSlot: coreir.LocalSlot,
                                                typedIr: texpr.TypedExprIr,
                                                nodeIndex: int32): bool =
    if !PrimaryBodyIrLocalIsParam(srcSlot):
        return false
    let evpArgNodeIndex = PrimaryBodyIrResultErrInfoArgNodeIndex(typedIr, nodeIndex)
    if evpArgNodeIndex < 0:
        return false
    let evpTypeRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_resultTypeIds[evpArgNodeIndex])
    if !IsOk(evpTypeRes):
        return false
    let evpTypeText: str = Value(evpTypeRes)
    return PrimaryBodyIrTypeTextIsVarParam(evpTypeText)

@borrows
fn PrimaryBodyIrResultErrInfoSourceSlot(bodyIR: var coreir.BodyIR,
                                         slotNames: var str[],
                                         typedIr: texpr.TypedExprIr,
                                         nodeIndex: int32): int32 =
    let eiArgNodeIndex = PrimaryBodyIrResultErrInfoArgNodeIndex(typedIr, nodeIndex)
    if eiArgNodeIndex < 0:
        return -1
    let eiArgName = PrimaryBodyIrResultValueArgName(typedIr, eiArgNodeIndex)
    if eiArgName == "":
        return -1
    let eiSrcSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, eiArgName)
    if eiSrcSlot < 0 || eiSrcSlot >= bodyIR.localSlots.len:
        return -1
    if PrimaryBodyIrSlotType(bodyIR, eiSrcSlot) != coreir.LocalAggregateTag:
        return -1
    var eiBlockOffset: int32
    var eiBlockSize: int32
    if !PrimaryBodyIrResultErrInfoSourceBlock(typedIr, nodeIndex, eiBlockOffset, eiBlockSize):
        return -1
    # (c)族②: var 形参 Result 源(按地址传递)的物理槽 sizeBytes 是不透明占位
    # (PrimaryLocalSlotSizeOf 观测=1, 不是被指向聚合的真实字节数)——按它校验
    # eiBlockOffset+eiBlockSize(如 ErrorInfo 40B)必假阴性拒绝, 与已验证生效的
    # StmtResultIntrinsic 姊妹路径(46046 一带 sourceSlot 同款按名取槽、从不做
    # 此项尺寸校验、对同一 var 形参源运行正确)不对称。尺寸校验只对值槽
    # (本地 let/var 与 by-value 形参, sizeBytes 即真实占位)有意义, var 形参
    # 一律经地址解引用, 真实布局已由上面 SourceBlock 用源内型 T 精确解算,
    # 不需要再靠物理槽宽二次把关。豁免口径=SrcSlotIsVarParam(精确 var 形参判
    # 定, 不笼统 IsParam——by-value 形参保留安全网)。
    let eiSrcIsVarParam = PrimaryBodyIrResultErrInfoSrcSlotIsVarParam(bodyIR.localSlots[eiSrcSlot], typedIr, nodeIndex)
    if !eiSrcIsVarParam &&
       PrimaryLocalSlotSizeOf(bodyIR.localSlots[eiSrcSlot]) < eiBlockOffset + eiBlockSize:
        return -1
    return eiSrcSlot

@borrows
fn PrimaryBodyIrResultValueInnerTypeText(typedIr: texpr.TypedExprIr,
                                          nodeIndex: int32,
                                          argNodeIndex: int32): str =
    let rvitFnRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_functionNameIds[nodeIndex])
    let rvitSrcRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_sourcePathIds[nodeIndex])
    let rvitArgRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_resultTypeIds[argNodeIndex])
    if !IsOk(rvitFnRes) || !IsOk(rvitSrcRes) || !IsOk(rvitArgRes):
        return ""
    # form59 residual: hoist Value(Result[str]) before StripVarType
    let rvitArg_f59: str = Value(rvitArgRes)
    let rvDirectInner = texpr.TypedExprResultSuccessType(texpr.TypedExprStripVarType(rvitArg_f59))
    if rvDirectInner != "":
        return rvDirectInner
    let rvArgName = PrimaryBodyIrResultValueArgName(typedIr, argNodeIndex)
    if rvArgName == "":
        return ""
    return texpr.TypedExprResultSuccessType(texpr.TypedExprIrPriorBindingType(typedIr,
                                                                              Value(rvitSrcRes),
                                                                              Value(rvitFnRes),
                                                                              arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_lineNumbers, nodeIndex),
                                                                              rvArgName))

@borrows
fn PrimaryBodyIrResultValueProjectShape(typedIr: texpr.TypedExprIr,
                                         sourcePath: str,
                                         innerType: str,
                                         kindOut: var int32,
                                         sizeOut: var int32,
                                         offsetOut: var int32): bool =
    kindOut = coreir.LocalInvalidTag
    sizeOut = 0
    offsetOut = 0
    if innerType == "":
        return false
    var rvInnerKind: int32
    var rvInnerSize: int32
    var rvInnerAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   sourcePath,
                                   innerType,
                                   rvInnerKind,
                                   rvInnerSize,
                                   rvInnerAlign)
    if rvInnerSize <= 0 || rvInnerAlign <= 0:
        return false
    if rvInnerKind != coreir.LocalI32Tag &&
       rvInnerKind != coreir.LocalI64Tag &&
       rvInnerKind != coreir.LocalStrTag &&
       rvInnerKind != coreir.LocalPtrTag &&
       rvInnerKind != coreir.LocalAggregateTag:
        return false
    kindOut = rvInnerKind
    sizeOut = rvInnerSize
    offsetOut = PrimaryBodyIrAlignedOffset(1, rvInnerAlign)
    return true

# Value/IsOk/IsErr share one typed node contract. A projection is accepted only
# when its single ArgLink proves a concrete Result[T] and the complete Result
# layout is derivable from T.
@borrows
fn PrimaryBodyIrResultProjectionNodeShape(typedIr: texpr.TypedExprIr,
                                           nodeIndex: int32,
                                           projectKindOut: var int32,
                                           argNodeIndexOut: var int32,
                                           sourcePathOut: var str,
                                           innerTypeOut: var str,
                                           resultKindOut: var int32,
                                           resultSizeOut: var int32,
                                           resultAlignOut: var int32,
                                           projectOffsetOut: var int32,
                                           errMsgOffsetOut: var int32,
                                           sourceTotalSizeOut: var int32): bool =
    projectKindOut = coreir.BodyResultProjectInvalidTag
    argNodeIndexOut = -1
    sourcePathOut = ""
    innerTypeOut = ""
    resultKindOut = coreir.LocalInvalidTag
    resultSizeOut = 0
    resultAlignOut = 0
    projectOffsetOut = 0
    errMsgOffsetOut = 0
    sourceTotalSizeOut = 0
    var projectKind = coreir.BodyResultProjectInvalidTag
    let argNodeIndex = PrimaryBodyIrResultProjectionArgNodeIndex(typedIr,
                                                                  nodeIndex,
                                                                  projectKind)
    if argNodeIndex < 0:
        return false
    let sourcePathRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                             typedIr.nodes2_sourcePathIds[nodeIndex])
    let argTypeRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                          typedIr.nodes2_resultTypeIds[argNodeIndex])
    if !IsOk(sourcePathRes) || !IsOk(argTypeRes):
        return false
    let sourcePath: str = Value(sourcePathRes)
    let argType: str = Value(argTypeRes)
    var innerType = texpr.TypedExprResultSuccessType(texpr.TypedExprStripVarType(argType))
    if innerType == "":
        let sourceBinding = PrimaryBodyIrResultProjectionArgBindingName(typedIr,
                                                                         argNodeIndex)
        let functionNameRes: Result[str] = langintern.LookupIntern(
            typedIr.internPool,
            typedIr.nodes2_functionNameIds[nodeIndex])
        if sourceBinding == "" || !IsOk(functionNameRes):
            return false
        let priorType = texpr.TypedExprIrPriorBindingType(
            typedIr,
            sourcePath,
            Value(functionNameRes),
            arenamod.ArenaArrayInt32Get(typedIr.arena,
                                         typedIr.nodes2_lineNumbers,
                                         nodeIndex),
            sourceBinding)
        innerType = texpr.TypedExprResultSuccessType(texpr.TypedExprStripVarType(priorType))
    if innerType == "":
        return false
    var valueKind: int32
    var valueSize: int32
    var valueOffset: int32
    var errCodeOffset: int32
    var errMsgOffset: int32
    var sourceTotalSize: int32
    if !PrimaryBodyIrResultConstructLayout(typedIr,
                                           sourcePath,
                                           innerType,
                                           valueKind,
                                           valueSize,
                                           valueOffset,
                                           errCodeOffset,
                                           errMsgOffset,
                                           sourceTotalSize):
        return false
    if valueOffset < 0 || valueSize <= 0 ||
       valueOffset + valueSize > sourceTotalSize ||
       errMsgOffset < 0 || errMsgOffset + 24 > sourceTotalSize:
        return false
    var resultKind = coreir.LocalI32Tag
    var resultSize: int32 = 4
    var resultAlign: int32 = 4
    var projectOffset: int32
    if projectKind == coreir.BodyResultProjectValueStrTag:
        PrimaryBodyIrTypedSlotShape(typedIr,
                                    sourcePath,
                                    innerType,
                                    resultKind,
                                    resultSize,
                                    resultAlign)
        if resultKind != valueKind || resultSize != valueSize ||
           resultSize <= 0 || resultAlign <= 0:
            return false
        projectOffset = valueOffset
    else:
        let nodeResultType = PrimaryBodyIrNodeResultTypeText(typedIr, nodeIndex)
        if texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(nodeResultType)) != "bool":
            return false
        if projectKind != coreir.BodyResultProjectIsOkTag &&
           projectKind != coreir.BodyResultProjectIsErrTag:
            return false
    projectKindOut = projectKind
    argNodeIndexOut = argNodeIndex
    sourcePathOut = sourcePath
    innerTypeOut = innerType
    resultKindOut = resultKind
    resultSizeOut = resultSize
    resultAlignOut = resultAlign
    projectOffsetOut = projectOffset
    errMsgOffsetOut = errMsgOffset
    sourceTotalSizeOut = sourceTotalSize
    return true

@borrows
fn PrimaryBodyIrResultProjectionArgIsVarParam(typedIr: texpr.TypedExprIr,
                                               argNodeIndex: int32): bool =
    if argNodeIndex < 0 || argNodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[argNodeIndex] != texpr.TypedExprIrOpParamRef:
        return false
    let typeRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                       typedIr.nodes2_resultTypeIds[argNodeIndex])
    if !IsOk(typeRes):
        return false
    return PrimaryBodyIrTypeTextIsVarParam(Value(typeRes))

@borrows
fn PrimaryBodyIrResultProjectionNodeProbe(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           varI32ParamNames: str[],
                                           lowering: var lower.LoweringPlanStub,
                                           typedFn: texpr.TypedExprIrFunction,
                                           irFunction: lower.PrimaryObjectIrFunction,
                                           nodeIndex: int32): int32 =
    var projectKind: int32
    var argNodeIndex: int32
    var sourcePath = ""
    var innerType = ""
    var resultKind: int32
    var resultSize: int32
    var resultAlign: int32
    var projectOffset: int32
    var errMsgOffset: int32
    var sourceTotalSize: int32
    if !PrimaryBodyIrResultProjectionNodeShape(lowering.typedIr,
                                                nodeIndex,
                                                projectKind,
                                                argNodeIndex,
                                                sourcePath,
                                                innerType,
                                                resultKind,
                                                resultSize,
                                                resultAlign,
                                                projectOffset,
                                                errMsgOffset,
                                                sourceTotalSize):
        return -1
    if lowering.typedIr.nodes2_opKinds[argNodeIndex] == texpr.TypedExprIrOpCallExpr:
        let sourceKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                    slotNames,
                                                    varI32ParamNames,
                                                    lowering,

                                                    typedFn,
                                                    irFunction,
                                                    argNodeIndex)
        if sourceKind != coreir.LocalAggregateTag:
            return -1
        return resultKind
    let sourceBinding = PrimaryBodyIrResultProjectionArgBindingName(lowering.typedIr,
                                                                     argNodeIndex)
    let sourceSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, sourceBinding)
    if sourceBinding == "" || sourceSlot < 0 || sourceSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, sourceSlot) != coreir.LocalAggregateTag:
        return -1
    if !PrimaryBodyIrResultProjectionArgIsVarParam(lowering.typedIr, argNodeIndex) &&
       PrimaryLocalSlotSizeOf(bodyIR.localSlots[sourceSlot]) < sourceTotalSize:
        return -1
    return resultKind

@borrows
fn PrimaryBodyIrAppendResultProjectionNodeToSlot(bodyIR: var coreir.BodyIR,
                                                  slotNames: var str[],
                                                  varI32ParamNames: str[],
                                                  lowering: var lower.LoweringPlanStub,
                                                  typedFn: texpr.TypedExprIrFunction,
                                                  irFunction: lower.PrimaryObjectIrFunction,
                                                  nodeIndex: int32,
                                                  targetSlot: int32,
                                                  callOrdinal: var int32): bool =
    var projectKind: int32
    var argNodeIndex: int32
    var sourcePath = ""
    var innerType = ""
    var resultKind: int32
    var resultSize: int32
    var resultAlign: int32
    var projectOffset: int32
    var errMsgOffset: int32
    var sourceTotalSize: int32
    if !PrimaryBodyIrResultProjectionNodeShape(lowering.typedIr,
                                                nodeIndex,
                                                projectKind,
                                                argNodeIndex,
                                                sourcePath,
                                                innerType,
                                                resultKind,
                                                resultSize,
                                                resultAlign,
                                                projectOffset,
                                                errMsgOffset,
                                                sourceTotalSize):
        return false
    var sourceSlot: int32 = -1
    var sourceIsVarParam = false
    if lowering.typedIr.nodes2_opKinds[argNodeIndex] == texpr.TypedExprIrOpCallExpr:
        if PrimaryBodyIrNodeEvalProbe(bodyIR,
                                      slotNames,
                                      varI32ParamNames,
                                      lowering,

                                      share(typedFn),
                                      irFunction,
                                      argNodeIndex) != coreir.LocalAggregateTag:
            return false
    else:
        let sourceBinding = PrimaryBodyIrResultProjectionArgBindingName(lowering.typedIr,
                                                                         argNodeIndex)
        sourceSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, sourceBinding)
        sourceIsVarParam = PrimaryBodyIrResultProjectionArgIsVarParam(lowering.typedIr,
                                                                      argNodeIndex)
        if sourceBinding == "" || sourceSlot < 0 || sourceSlot >= bodyIR.localSlots.len ||
           PrimaryBodyIrSlotType(bodyIR, sourceSlot) != coreir.LocalAggregateTag ||
           (!sourceIsVarParam &&
            PrimaryLocalSlotSizeOf(bodyIR.localSlots[sourceSlot]) < sourceTotalSize):
            return false
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        return false
    var emitTargetSlot = targetSlot
    var storeToAggregateParam = false
    if PrimaryBodyIrSlotIsAggregateParam(bodyIR, targetSlot):
        if resultKind != coreir.LocalAggregateTag ||
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) != resultSize:
            return false
        emitTargetSlot = PrimaryBodyIrFindOrCreateSlotSized(
            bodyIR,
            slotNames,
            Fmt"{bodyIR.localSlots[targetSlot].name}#result_projection#{nodeIndex}",
            coreir.LocalAggregateTag,
            resultSize,
            resultAlign)
        if emitTargetSlot < 0:
            return false
        storeToAggregateParam = true
    else:
        if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[targetSlot]) ||
           PrimaryBodyIrSlotType(bodyIR, targetSlot) != resultKind ||
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) < resultSize:
            return false
    if lowering.typedIr.nodes2_opKinds[argNodeIndex] == texpr.TypedExprIrOpCallExpr:
        sourceSlot = PrimaryBodyIrEvalNode(bodyIR,
                                           slotNames,
                                           varI32ParamNames,
                                           lowering,

                                           typedFn,
                                           irFunction,
                                           argNodeIndex,
                                           callOrdinal)
    if sourceSlot < 0 || sourceSlot >= bodyIR.localSlots.len ||
       PrimaryBodyIrSlotType(bodyIR, sourceSlot) != coreir.LocalAggregateTag ||
       (!sourceIsVarParam &&
        PrimaryLocalSlotSizeOf(bodyIR.localSlots[sourceSlot]) < sourceTotalSize):
        return false
    if projectKind == coreir.BodyResultProjectValueStrTag:
        if !PrimaryBodyIrAppendResultValuePanicGuard(bodyIR,
                                                     slotNames,
                                                     sourceSlot,
                                                     errMsgOffset,
                                                     24,
                                                     callOrdinal):
            return false
    var projectOp: coreir.BodyOp
    projectOp.kind = coreir.BodyOpResultProjectTag
    projectOp.target = emitTargetSlot
    add(projectOp.operands, projectKind)
    add(projectOp.operands, sourceSlot)
    if projectKind == coreir.BodyResultProjectValueStrTag:
        add(projectOp.operands, projectOffset)
        add(projectOp.operands, resultSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, projectOp)
    if storeToAggregateParam:
        return PrimaryBodyIrAppendAggregateParamStoreIfNeeded(bodyIR,
                                                               targetSlot,
                                                               emitTargetSlot)
    return true

@borrows
fn PrimaryBodyIrNodeTreeContainsResultProjection(typedIr: texpr.TypedExprIr,
                                                  nodeIndex: int32,
                                                  expectedProjectKind: int32,
                                                  expectedSourceBinding: str,
                                                  expectedInnerType: str): bool =
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return false
    var projectKind: int32
    var argNodeIndex: int32
    var sourcePath = ""
    var innerType = ""
    var resultKind: int32
    var resultSize: int32
    var resultAlign: int32
    var projectOffset: int32
    var errMsgOffset: int32
    var sourceTotalSize: int32
    if PrimaryBodyIrResultProjectionNodeShape(typedIr,
                                               nodeIndex,
                                               projectKind,
                                               argNodeIndex,
                                               sourcePath,
                                               innerType,
                                               resultKind,
                                               resultSize,
                                               resultAlign,
                                               projectOffset,
                                               errMsgOffset,
                                               sourceTotalSize) &&
       projectKind == expectedProjectKind &&
       PrimaryBodyIrResultProjectionArgBindingName(typedIr, argNodeIndex) ==
           expectedSourceBinding &&
       texpr.TypedExprNormalizeTypeText(innerType) ==
           texpr.TypedExprNormalizeTypeText(expectedInnerType):
        return true
    if PrimaryBodyIrNodeTreeContainsResultProjection(
        typedIr,
        arenamod.ArenaArrayInt32Get(typedIr.arena,
                                     typedIr.nodes2_operand0NodeIndexs,
                                     nodeIndex),
        expectedProjectKind,
        expectedSourceBinding,
        expectedInnerType):
        return true
    if PrimaryBodyIrNodeTreeContainsResultProjection(
        typedIr,
        arenamod.ArenaArrayInt32Get(typedIr.arena,
                                     typedIr.nodes2_operand1NodeIndexs,
                                     nodeIndex),
        expectedProjectKind,
        expectedSourceBinding,
        expectedInnerType):
        return true
    return PrimaryBodyIrNodeTreeContainsResultProjection(
        typedIr,
        arenamod.ArenaArrayInt32Get(typedIr.arena,
                                     typedIr.nodes2_operand2NodeIndexs,
                                     nodeIndex),
        expectedProjectKind,
        expectedSourceBinding,
        expectedInnerType)

# F14b: Result.Value() ok-check panic guard, shared by both Value() projection
# producer sites (CallExpr node-eval arm below + the StmtResultIntrinsic
# statement-level arm). Mirrors result.cheng:80-83 source semantics
# (`if !r.ok: system.PanicErrorInfo(r.err)`, reduced to `system.Panic(r.err.msg)`
# since msg is the field PanicErrorInfo's nonempty path prints verbatim, and
# Panic(str) is the already-reachable, already-linked primitive — parser.cheng
# calls it directly, so no new reachability-pruning risk). KNOWN BOUNDARY (not
# silent — disclosed and covered by verify_f14b's f14b_adv_empty_msg case):
# when r.err.msg is the empty string, source-level PanicErrorInfo->panicErr
# (system.cheng) falls back to printing the literal "error" (its own internal
# ErrorMessage-empty check), whereas this guard's Panic(msg) prints an empty
# line instead. The safety property that matters — Err->Value() always exits
# nonzero, never silently returns a zero value — holds identically either
# way; only the exact fallback text differs for the (empty-message) corner
# case. Not replicated here because doing so would require synthesizing new
# str-literal-materialization BodyIR machinery (str isn't a BodyOpLoadConstTag
# shape) purely to chase cosmetic parity on a case no real caller relies on —
# judged not worth the added-machinery risk versus the disclosed, tested,
# safety-preserving alternative. Built entirely from already-existing,
# already-tested BodyIR primitives (IsOk scalar projection + Error-string
# aggregate projection + a normally-registered CallOp), so no new ABI/
# relocation code is introduced. The guard itself (BodyOpResultPanicGuardTag)
# is self-contained straight-line asm (local cbnz-skip around the call) — it
# needs no bodyIR.blocks/terms participation, which matters because this
# helper runs at expression node-eval depth where the enclosing statement's
# block/term bookkeeping is not reachable. On any precondition miss this
# returns false (poison-on-miss) — callers must treat that as a projection
# miss, never emit the value copy unguarded.
@borrows
fn PrimaryBodyIrAppendResultValuePanicGuard(bodyIR: var coreir.BodyIR,
                                             slotNames: var str[],
                                             srcSlot: int32,
                                             errMsgOffset: int32,
                                             errMsgByteCount: int32,
                                             callOrdinal: var int32): bool =
    if srcSlot < 0 || srcSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryBodyIrSlotType(bodyIR, srcSlot) != coreir.LocalAggregateTag:
        return false
    if errMsgOffset < 0 || errMsgByteCount <= 0:
        return false
    let guardTag = bodyIR.ops.len
    let condSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"#value_panic_ok#{guardTag}",
                                                 coreir.LocalI32Tag)
    let msgSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                slotNames,
                                                Fmt"#value_panic_msg#{guardTag}",
                                                coreir.LocalStrTag)
    if condSlot < 0 || msgSlot < 0:
        return false
    var okOp: coreir.BodyOp
    okOp.kind = coreir.BodyOpResultProjectTag
    okOp.target = condSlot
    add(okOp.operands, coreir.BodyResultProjectIsOkTag)
    add(okOp.operands, srcSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, okOp)
    var msgOp: coreir.BodyOp
    msgOp.kind = coreir.BodyOpResultProjectTag
    msgOp.target = msgSlot
    add(msgOp.operands, coreir.BodyResultProjectErrorStrTag)
    add(msgOp.operands, srcSlot)
    add(msgOp.operands, errMsgOffset)
    add(msgOp.operands, errMsgByteCount)
    let _ = coreir.BodyIRAppendOp(bodyIR, msgOp)
    var panicCall: coreir.CallOp
    panicCall.targetSymbol = "Panic"
    panicCall.resultSlot = -1
    panicCall.resultPassKind = coreir.BodyCallPassStackValueTag
    add(panicCall.argSlots, msgSlot)
    add(panicCall.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(bodyIR.callSequence, panicCall)
    let panicOrdinal = callOrdinal
    callOrdinal = callOrdinal + 1
    var guardOp: coreir.BodyOp
    guardOp.kind = coreir.BodyOpResultPanicGuardTag
    guardOp.target = -1
    add(guardOp.operands, condSlot)
    add(guardOp.operands, panicOrdinal)
    let _ = coreir.BodyIRAppendOp(bodyIR, guardOp)
    return true

# Value 投影发射核心（源槽+内型已知形）：给定已物化的 Result[T] 聚合源槽
# (rvSrcSlot) 与已解出的内型文本 (rvInner), 校验形状/目标槽并发射
# panic-guard+BodyOpResultProjectTag——是 PrimaryBodyIrAppendResultValueProjection
# 原 ParamRef/LocalRef 臂（源绑定为具名局部, 非嵌套调用）的纯函数抽取, 供该臂与
# bail=44 Value 内征族（AppendWholeCallExprToSlot 的 callHead=="Value" 分支,
# 该文本路径部分调用点无可用 node2 CallExpr 索引, 见 callExprNodeIndex<0 兜底）
# 共用同一份已验证投影/panic-guard 机器, 零新增偏移计算。
@borrows
fn PrimaryBodyIrAppendResultValueProjectionFromSlot(bodyIR: var coreir.BodyIR,
                                                      slotNames: var str[],
                                                      typedIr: texpr.TypedExprIr,
                                                      sourcePath: str,
                                                      traceFunctionName: str,
                                                      traceLineNumber: int32,
                                                      rvSrcSlot: int32,
                                                      rvInner: str,
                                                      targetSlot: int32,
                                                      callOrdinal: var int32): bool =
    if rvSrcSlot < 0 || rvSrcSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryBodyIrSlotType(bodyIR, rvSrcSlot) != coreir.LocalAggregateTag:
        return false
    var rvKind: int32
    var rvSize: int32
    var rvOffset: int32
    if !PrimaryBodyIrResultValueProjectShape(typedIr,
                                             sourcePath,
                                             rvInner,
                                             rvKind,
                                             rvSize,
                                             rvOffset):
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=result_project_skip stage=emit function={traceFunctionName} line={traceLineNumber} inner={rvInner}")
        return false
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[rvSrcSlot]) < rvOffset + rvSize:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=result_project_skip stage=emit reason=src_size function={traceFunctionName} line={traceLineNumber}")
        return false
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        return false
    var rvTargetSlot = targetSlot
    var rvStoreToAggregateParam = false
    if PrimaryBodyIrSlotIsAggregateParam(bodyIR, targetSlot):
        if rvKind != coreir.LocalAggregateTag ||
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) != rvSize:
            return false
        var rvAlign = bodyIR.localSlots[targetSlot].alignBytes
        if rvAlign <= 0:
            rvAlign = 8
        rvTargetSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                          slotNames,
                                                          Fmt"{bodyIR.localSlots[targetSlot].name}#result_value_project#{bodyIR.ops.len}",
                                                          coreir.LocalAggregateTag,
                                                          rvSize,
                                                          rvAlign)
        if rvTargetSlot < 0:
            return false
        rvStoreToAggregateParam = true
    else:
        if PrimaryBodyIrSlotType(bodyIR, targetSlot) != rvKind:
            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                os.WriteLine(os.GetStderr(), Fmt"phase=result_project_skip stage=emit reason=target_kind function={traceFunctionName} line={traceLineNumber} target_kind={PrimaryBodyIrSlotType(bodyIR, targetSlot)} value_kind={rvKind}")
            return false
        if rvKind == coreir.LocalAggregateTag &&
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) < rvSize:
            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                os.WriteLine(os.GetStderr(), Fmt"phase=result_project_skip stage=emit reason=target_size function={traceFunctionName} line={traceLineNumber} target_size={PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot])} need={rvSize}")
            return false
        if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[targetSlot]):
            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                os.WriteLine(os.GetStderr(), Fmt"phase=result_project_skip stage=emit reason=target_param function={traceFunctionName} line={traceLineNumber}")
            return false
    # F14b: Err->Value() must panic, never silently return a zero value
    # (result.cheng:80-83 source guard). Compute the same err.msg offset/size
    # Error() already projects from this Result[T], then emit the ok-check+
    # panic guard before the value copy below.
    var rvErrValueKind: int32
    var rvErrValueSize: int32
    var rvErrValueOffset: int32
    var rvErrCodeOffset: int32
    var rvErrMsgOffset: int32
    var rvErrTotalSize: int32
    if !PrimaryBodyIrResultConstructLayout(typedIr,
                                           sourcePath,
                                           rvInner,
                                           rvErrValueKind,
                                           rvErrValueSize,
                                           rvErrValueOffset,
                                           rvErrCodeOffset,
                                           rvErrMsgOffset,
                                           rvErrTotalSize):
        return false
    if !PrimaryBodyIrAppendResultValuePanicGuard(bodyIR,
                                                 slotNames,
                                                 rvSrcSlot,
                                                 rvErrMsgOffset,
                                                 24,
                                                 callOrdinal):
        return false
    var rvOp: coreir.BodyOp
    rvOp.kind = coreir.BodyOpResultProjectTag
    rvOp.target = rvTargetSlot
    add(rvOp.operands, coreir.BodyResultProjectValueStrTag)
    add(rvOp.operands, rvSrcSlot)
    add(rvOp.operands, rvOffset)
    add(rvOp.operands, rvSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, rvOp)
    if rvStoreToAggregateParam:
        if !PrimaryBodyIrAppendAggregateParamStoreIfNeeded(bodyIR,
                                                           targetSlot,
                                                           rvTargetSlot):
            return false
    return true

# Value 投影发射：全部可失败判定在发射之前（纯数据 op，无 call、无 ordinal、
# 无 debris）；任一门不过即 miss 落回文本路径，不留副作用。
@borrows
fn PrimaryBodyIrAppendResultValueProjection(bodyIR: var coreir.BodyIR,
                                             slotNames: var str[],
                                             varI32ParamNames: str[],
                                             lowering: var lower.LoweringPlanStub,
                                             typedFn: texpr.TypedExprIrFunction,
                                             irFunction: lower.PrimaryObjectIrFunction,
                                             nodeIndex: int32,
                                             targetSlot: int32,
                                             callOrdinal: var int32): bool =
    let rvArgNodeIndex = PrimaryBodyIrResultValueArgNodeIndex(lowering.typedIr, nodeIndex)
    if rvArgNodeIndex < 0:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
        return false
    let rvpSrcRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_sourcePathIds[nodeIndex])
    let rvpNtRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[nodeIndex])
    let rvpArgTRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[rvArgNodeIndex])
    if !IsOk(rvpSrcRes) || !IsOk(rvpNtRes) || !IsOk(rvpArgTRes):
        let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
        return false
    # call-arg 臂: 实参是调用而非绑定, 无命名源槽。全部可失败判定(投影形状/目标
    # 槽 kind/size/param)在 EvalNode 物化前先做, 通过后才 EvalNode 物化 Result[T]
    # 临时源槽并发射投影 op(poison-on-miss: 物化后仅剩恒成立的 src-size 复核)。
    # 入口语句已过 NodeEvalProbe 递归臂(镜像本臂), 调用一旦发射不落回文本路径。
    if lowering.typedIr.nodes2_opKinds[rvArgNodeIndex] == texpr.TypedExprIrOpCallExpr:
        let rvcInner = PrimaryBodyIrResultValueInnerTypeText(lowering.typedIr, nodeIndex, rvArgNodeIndex)
        var rvcKind: int32
        var rvcSize: int32
        var rvcOffset: int32
        if !PrimaryBodyIrResultValueProjectShape(lowering.typedIr,
                                                 Value(rvpSrcRes),
                                                 rvcInner,
                                                 rvcKind,
                                                 rvcSize,
                                                 rvcOffset):
            let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
            return false
        if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
            let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
            return false
        var rvcTargetSlot = targetSlot
        var rvcStoreToAggregateParam = false
        if PrimaryBodyIrSlotIsAggregateParam(bodyIR, targetSlot):
            if rvcKind != coreir.LocalAggregateTag ||
               PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) != rvcSize:
                let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
                return false
            var rvcAlign = bodyIR.localSlots[targetSlot].alignBytes
            if rvcAlign <= 0:
                rvcAlign = 8
            rvcTargetSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                               slotNames,
                                                               Fmt"{bodyIR.localSlots[targetSlot].name}#result_value_project#{bodyIR.ops.len}",
                                                               coreir.LocalAggregateTag,
                                                               rvcSize,
                                                               rvcAlign)
            if rvcTargetSlot < 0:
                let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
                return false
            rvcStoreToAggregateParam = true
        else:
            if PrimaryBodyIrSlotType(bodyIR, targetSlot) != rvcKind:
                let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
                return false
            if rvcKind == coreir.LocalAggregateTag &&
               PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) < rvcSize:
                let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
                return false
            if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[targetSlot]):
                let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
                return false
        let rvcSrcSlot = PrimaryBodyIrEvalNode(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering,

                                               share(typedFn),
                                               irFunction,
                                               rvArgNodeIndex,
                                               callOrdinal)
        if rvcSrcSlot < 0 ||
           rvcSrcSlot >= bodyIR.localSlots.len ||
           PrimaryBodyIrSlotType(bodyIR, rvcSrcSlot) != coreir.LocalAggregateTag ||
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[rvcSrcSlot]) < rvcOffset + rvcSize:
            return false
        # F14b: Err->Value() must panic, never silently return a zero value
        # (result.cheng:80-83 source guard). Compute the same err.msg
        # offset/size Error() already projects from this Result[T], then emit
        # the ok-check+panic guard before the value copy below.
        var rvcErrValueKind: int32
        var rvcErrValueSize: int32
        var rvcErrValueOffset: int32
        var rvcErrCodeOffset: int32
        var rvcErrMsgOffset: int32
        var rvcErrTotalSize: int32
        if !PrimaryBodyIrResultConstructLayout(lowering.typedIr,
                                               Value(rvpSrcRes),
                                               rvcInner,
                                               rvcErrValueKind,
                                               rvcErrValueSize,
                                               rvcErrValueOffset,
                                               rvcErrCodeOffset,
                                               rvcErrMsgOffset,
                                               rvcErrTotalSize):
            let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
            return false
        if !PrimaryBodyIrAppendResultValuePanicGuard(bodyIR,
                                                     slotNames,
                                                     rvcSrcSlot,
                                                     rvcErrMsgOffset,
                                                     24,
                                                     callOrdinal):
            let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
            return false
        var rvcOp: coreir.BodyOp
        rvcOp.kind = coreir.BodyOpResultProjectTag
        rvcOp.target = rvcTargetSlot
        add(rvcOp.operands, coreir.BodyResultProjectValueStrTag)
        add(rvcOp.operands, rvcSrcSlot)
        add(rvcOp.operands, rvcOffset)
        add(rvcOp.operands, rvcSize)
        let _ = coreir.BodyIRAppendOp(bodyIR, rvcOp)
        if rvcStoreToAggregateParam:
            if !PrimaryBodyIrAppendAggregateParamStoreIfNeeded(bodyIR,
                                                               targetSlot,
                                                               rvcTargetSlot):
                return false
        return true
    let rvArgName = PrimaryBodyIrResultValueArgName(lowering.typedIr, rvArgNodeIndex)
    if rvArgName == "":
        let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
        return false
    let rvSrcSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rvArgName)
    let rvInner = PrimaryBodyIrResultValueInnerTypeText(lowering.typedIr, nodeIndex, rvArgNodeIndex)
    if !PrimaryBodyIrAppendResultValueProjectionFromSlot(bodyIR,
                                                          slotNames,
                                                          lowering.typedIr,
                                                          Value(rvpSrcRes),
                                                          typedFn.functionName,
                                                          arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex),
                                                          rvSrcSlot,
                                                          rvInner,
                                                          targetSlot,
                                                          callOrdinal):
        let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
        return false
    return true

# ErrorInfoOf 投影发射：把源 Result 聚合里整块 err{code,msg} 子聚合（=ErrorInfo
# 布局）复制到 ErrorInfo 结果槽（纯数据 op，无 call、无 ordinal、无 debris）。
# 全部可失败判定在发射之前，任一门不过即 miss 落回文本路径，不留副作用。
@borrows
fn PrimaryBodyIrAppendResultErrInfoProjection(bodyIR: var coreir.BodyIR,
                                               slotNames: var str[],
                                               typedIr: texpr.TypedExprIr,
                                               typedFn: texpr.TypedExprIrFunction,
                                               nodeIndex: int32,
                                               targetSlot: int32): bool =
    let eiSrcSlot = PrimaryBodyIrResultErrInfoSourceSlot(bodyIR, slotNames, typedIr, nodeIndex)
    if eiSrcSlot < 0:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
        return false
    var eiBlockOffset: int32
    var eiBlockSize: int32
    if !PrimaryBodyIrResultErrInfoSourceBlock(typedIr, nodeIndex, eiBlockOffset, eiBlockSize):
        let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
        return false
    if eiBlockSize <= 0:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
        return false
    # (c)族②同款豁免(见 PrimaryBodyIrResultErrInfoSourceSlot 同名注释): var
    # 形参源物理槽 sizeBytes 不透明占位, 不能拿来假阴性拒绝已用源内型 T 精确
    # 解算过的 err 块偏移/宽。豁免口径=SrcSlotIsVarParam(by-value 形参不豁免)。
    let eipSrcIsVarParam = PrimaryBodyIrResultErrInfoSrcSlotIsVarParam(bodyIR.localSlots[eiSrcSlot], typedIr, nodeIndex)
    if !eipSrcIsVarParam &&
       PrimaryLocalSlotSizeOf(bodyIR.localSlots[eiSrcSlot]) < eiBlockOffset + eiBlockSize:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
        return false
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
        return false
    if PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalAggregateTag:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
        return false
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) < eiBlockSize:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
        return false
    if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[targetSlot]):
        let _ = PrimaryBodyIrNodeEvalMissAt("result_project")
        return false
    var eiOp: coreir.BodyOp
    eiOp.kind = coreir.BodyOpResultProjectTag
    eiOp.target = targetSlot
    add(eiOp.operands, coreir.BodyResultProjectErrInfoTag)
    add(eiOp.operands, eiSrcSlot)
    add(eiOp.operands, eiBlockOffset)
    add(eiOp.operands, eiBlockSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, eiOp)
    return true

# Result 构造内征：Ok[T](v)/Err[T](msg) 头识别。leaf=Ok→isErr=false、
# leaf=Err→isErr=true，其余非构造头返回 false。布局 = result.cheng 模板
# {ok@0, value@AlignedOffset(1,align(T)), err{code,msg}@对齐尾}，与
# PrimaryBodyIrTypeShapeFromText/Value 投影一致；errmsg 在 str-inner 形态
# 落 40（与 Error 投影静态常量吻合，round-trip 闭合）。
@borrows
fn PrimaryBodyIrResultConstructHead(callHead: str, isErrOut: var bool): bool =
    isErrOut = false
    # 构造头携带类型参数 `Ok[T]`/`Err[T]`；先按 `[` 切出名字部分再取 leaf，
    # 否则类型实参里的点（如 Err[layout.FixedBytes32]）会让限定符 leaf 误判。
    let bracketPos = parser.ParserFindText(callHead, "[")
    if bracketPos <= 0:
        return false
    let leaf = texpr.TypedExprQualifiedCallLeaf(strings.SliceBytes(callHead, 0, bracketPos))
    if leaf == "Ok":
        return true
    if leaf == "Err":
        isErrOut = true
        return true
    # ErrCode[T](code,msg) 是带显式 code 的 Err 变体（ok=0，err.code=code，
    # err.msg=msg）；构造头识别为 err 类，双参布局由发射器据头名分流。
    if leaf == "ErrCode":
        isErrOut = true
        return true
    return false

# ErrCode 构造头判定（Err 变体里携带 code 的双参形态）：用于把构造发射
# 从单参 Err（仅 msg，code=1）分流到 code+msg 双参布局。
@borrows
fn PrimaryBodyIrResultConstructIsErrCodeHead(callHead: str): bool =
    let bracketPos = parser.ParserFindText(callHead, "[")
    if bracketPos <= 0:
        return false
    return texpr.TypedExprQualifiedCallLeaf(strings.SliceBytes(callHead, 0, bracketPos)) == "ErrCode"

# inner T 来自调用头的显式类型实参 `Ok[T]`/`Err[T]`（node.resultType 是
# 构造器声明的泛型 Result[T]，T 未替换，不可用）。取首个 `[` 与配对 `]`
# 之间的文本。
@borrows
fn PrimaryBodyIrResultConstructInnerType(callHead: str): str =
    let openPos = parser.ParserFindText(callHead, "[")
    if openPos <= 0:
        return ""
    let closePos = texpr.TypedExprFindMatchingBracket(callHead, openPos)
    if closePos <= openPos || closePos + 1 != len(callHead):
        return ""
    return strutil.Strip(strings.SliceBytes(callHead, openPos + 1, closePos - openPos - 1))

@borrows
fn PrimaryBodyIrResultConstructLayout(typedIr: texpr.TypedExprIr,
                                       sourcePath: str,
                                       innerType: str,
                                       valueKindOut: var int32,
                                       valueSizeOut: var int32,
                                       valueOffsetOut: var int32,
                                       errCodeOffsetOut: var int32,
                                       errMsgOffsetOut: var int32,
                                       totalSizeOut: var int32): bool =
    valueKindOut = coreir.LocalInvalidTag
    valueSizeOut = 0
    valueOffsetOut = 0
    errCodeOffsetOut = 0
    errMsgOffsetOut = 0
    totalSizeOut = 0
    if innerType == "":
        return false
    var innerKind: int32
    var innerSize: int32
    var innerAlign: int32
    # 用户结构体内型（Ok[QpackIntegerDecoded] 等）的 TypeShapeFromText 走不到
    # 硬编码分支、registry 又未注册 → size 0 落 result_construct 缺口。TypedSlotShape
    # 在 TypeShapeFromText 失败时回退 SourceObjectLayoutAtDepth（按源文件结构体定义
    # 解析）补齐，与 let-绑定槽创建同款解析路径，使聚合内型 Ok/Err 构造布局成立。
    PrimaryBodyIrTypedSlotShape(typedIr,
                                sourcePath,
                                innerType,
                                innerKind,
                                innerSize,
                                innerAlign)
    if innerSize <= 0 || innerAlign <= 0:
        return false
    if innerKind != coreir.LocalI32Tag &&
       innerKind != coreir.LocalI64Tag &&
       innerKind != coreir.LocalStrTag &&
       innerKind != coreir.LocalPtrTag &&
       innerKind != coreir.LocalAggregateTag:
        return false
    let valueOffset = PrimaryBodyIrAlignedOffset(1, innerAlign)
    let errOffset = PrimaryBodyIrAlignedOffset(valueOffset + innerSize, 8)
    var resultAlign = innerAlign
    if resultAlign < 8:
        resultAlign = 8
    valueKindOut = innerKind
    valueSizeOut = innerSize
    valueOffsetOut = valueOffset
    errCodeOffsetOut = errOffset
    errMsgOffsetOut = errOffset + 8
    totalSizeOut = PrimaryBodyIrAlignedOffset(errOffset + 32, resultAlign)
    return true

@borrows
fn PrimaryBodyIrAppendResultConstruct(bodyIR: var coreir.BodyIR,
                                       slotNames: var str[],
                                       varI32ParamNames: str[],
                                       lowering: var lower.LoweringPlanStub,
                                       typedFn: texpr.TypedExprIrFunction,
                                       irFunction: lower.PrimaryObjectIrFunction,
                                       nodeIndex: int32,
                                       targetSlot: int32,
                                       isErr: bool,
                                       callOrdinal: var int32): bool =
    return PrimaryBodyIrAppendResultConstructWithInnerType(bodyIR,
                                                           slotNames,
                                                           varI32ParamNames,
                                                           lowering,

                                                           typedFn,
                                                           irFunction,
                                                           nodeIndex,
                                                           targetSlot,
                                                           isErr,
                                                           "",
                                                           callOrdinal)

# Ok[T](v)/Err[T](msg) 构造发射：识别头→按 result.cheng 模板布局把
# ok 标志、payload、err 写进 64B 聚合槽，无 Ok/Err 调用 ordinal（setMem
# 零初始化是合法运行期 helper，非构造调用）。任一门不过即 miss 落回。
# 所有可失败判定在零初始化前完成，零初始化后必须发射成功（已发 setMem
# 不可回落）。payload 经 EvalNode 求值（其内部 6101 调用守卫保证一次性）。
@borrows
fn PrimaryBodyIrAppendResultConstructWithInnerType(bodyIR: var coreir.BodyIR,
                                                   slotNames: var str[],
                                                   varI32ParamNames: str[],
                                                   lowering: var lower.LoweringPlanStub,
                                                   typedFn: texpr.TypedExprIrFunction,
                                                   irFunction: lower.PrimaryObjectIrFunction,
                                                   nodeIndex: int32,
                                                   targetSlot: int32,
                                                   isErr: bool,
                                                   innerTypeOverride: str,
                                                   callOrdinal: var int32): bool =
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalAggregateTag:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[targetSlot]):
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    let rcLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[nodeIndex])
    let rcSrcRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_sourcePathIds[nodeIndex])
    if !IsOk(rcLitRes) || !IsOk(rcSrcRes):
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    let rcLit = Value(rcLitRes)
    let rcSrc = Value(rcSrcRes)
    var innerType = strutil.Strip(innerTypeOverride)
    if innerType == "":
        innerType = PrimaryBodyIrResultConstructInnerType(rcLit)
    var valueKind: int32
    var valueSize: int32
    var valueOffset: int32
    var errCodeOffset: int32
    var errMsgOffset: int32
    var totalSize: int32
    if !PrimaryBodyIrResultConstructLayout(lowering.typedIr,
                                           rcSrc,
                                           innerType,
                                           valueKind,
                                           valueSize,
                                           valueOffset,
                                           errCodeOffset,
                                           errMsgOffset,
                                           totalSize):
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=result_construct_skip stage=emit reason=layout function={typedFn.functionName} line={arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex)} call_head={rcLit} inner={innerType}")
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) < totalSize:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=result_construct_skip stage=emit reason=target_size function={typedFn.functionName} line={arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex)} target_size={PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot])} need={totalSize}")
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    var payloadArgNodes: int32[]
    if !PrimaryBodyIrCollectArgLinkValueNodes(
        lowering.typedIr,
        arenamod.ArenaArrayInt32Get(lowering.typedIr.arena,
                                     lowering.typedIr.nodes2_operand0NodeIndexs,
                                     nodeIndex),
        payloadArgNodes):
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    # ErrCode[T](code,msg)：Err 变体，双参 code(int32)+msg(str)，ok=0，
    # 据 result.cheng 布局把 code 写 err.code、msg 写 err.msg（不写 value）。
    if PrimaryBodyIrResultConstructIsErrCodeHead(rcLit) || rcLit == "ErrCode":
        return PrimaryBodyIrAppendResultErrCodeConstruct(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         lowering,

                                                         typedFn,
                                                         irFunction,
                                                         nodeIndex,
                                                         targetSlot,
                                                         payloadArgNodes,
                                                         errCodeOffset,
                                                         errMsgOffset,
                                                         callOrdinal)
    if payloadArgNodes.len != 1:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    let payloadNodeIndex = payloadArgNodes[0]
    # bail=801 P1/P2 亚族 (emit 路径镜像, 与 FromArgLinks 同款): payload 为
    # ①跨模块限定 str 常量 (Ok[str](yamuxmod.YamuxCodec), 含 const 链) 或
    # ②inner 型值构造器字面量 (Ok[T](T(field: v, ...)))。探针对两形态均无形状
    # → 恒 miss。命中即预物化为 payload 槽绕过探针+求值; 解析不出走原路径
    # (poison 不变, 形态严等不重叠)。
    let rcNodeLine = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex)
    var payloadPreSlot: int32 = -1
    var payloadExpectsStr = isErr
    if !payloadExpectsStr && valueKind == coreir.LocalStrTag:
        payloadExpectsStr = true
    if payloadExpectsStr &&
       payloadNodeIndex >= 0 &&
       payloadNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
        # FieldGet 节点 literalText 只存字段叶名, 全限定路径在 surfaceText
        # (yamuxmod.YamuxCodec); surface 优先, 空则回落 literalText。
        var payloadConstText = ""
        let payloadSurfRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_surfaceTextIds[payloadNodeIndex])
        if IsOk(payloadSurfRes):
            payloadConstText = strutil.Strip(Value(payloadSurfRes))
        if payloadConstText == "":
            let payloadLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[payloadNodeIndex])
            if IsOk(payloadLitRes):
                payloadConstText = strutil.Strip(Value(payloadLitRes))
        if payloadConstText != "":
            let payloadConstLit = PrimaryBodyIrCanonicalConstStringLiteral(lowering.typedIr,
                                                                           rcSrc,
                                                                           payloadConstText)
            if payloadConstLit != "":
                let payloadConstSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                     slotNames,
                                                                     Fmt"#rc_const_str#{rcNodeLine}#{bodyIR.ops.len}",
                                                                     coreir.LocalStrTag)
                if payloadConstSlot >= 0 &&
                   PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                         slotNames,
                                                         payloadConstLit,
                                                         payloadConstSlot,
                                                         callOrdinal):
                    payloadPreSlot = payloadConstSlot
    if payloadPreSlot < 0 &&
       !isErr &&
       valueKind == coreir.LocalAggregateTag &&
       payloadNodeIndex >= 0 &&
       payloadNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
        # 命名字段聚合构造器占位节点的 literalText 只存构造头 (如
        # "MediaIngestReceipt"), 完整 "Type(field:v,...)" 文本在 surfaceText;
        # surface 优先, 空则回落 literalText (同函数内紧邻 P2 str 分支同款修法)。
        var payloadCtorText = ""
        let payloadCtorSurfRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_surfaceTextIds[payloadNodeIndex])
        if IsOk(payloadCtorSurfRes):
            payloadCtorText = strutil.Strip(Value(payloadCtorSurfRes))
        if payloadCtorText == "":
            let payloadCtorLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[payloadNodeIndex])
            if IsOk(payloadCtorLitRes):
                payloadCtorText = strutil.Strip(Value(payloadCtorLitRes))
        if payloadCtorText != "":
            let payloadCtorSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                     slotNames,
                                                                     lowering.typedIr,
                                                                     rcSrc,
                                                                     Fmt"#rc_ctor_payload#{rcNodeLine}#{bodyIR.ops.len}",
                                                                     innerType)
            if payloadCtorSlot >= 0 &&
               PrimaryBodyIrAppendAggregateConstructorToSlot(bodyIR,
                                                             slotNames,
                                                             varI32ParamNames,
                                                             lowering,

                                                             typedFn,
                                                             irFunction,
                                                             payloadCtorText,
                                                             payloadNodeIndex,
                                                             innerType,
                                                             rcSrc,
                                                             rcNodeLine,
                                                             payloadCtorSlot,
                                                             rcNodeLine * 31 + payloadNodeIndex,
                                                             callOrdinal):
                payloadPreSlot = payloadCtorSlot
    if payloadPreSlot < 0:
        if isErr:
            # Err[T](msg)：payload 必须是 str 写进 errmsg；errcode=1。
            let errProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,

                                                          share(typedFn),
                                                          irFunction,
                                                          payloadNodeIndex)
            if errProbeKind != coreir.LocalStrTag:
                let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
                return false
        else:
            # Ok[T](v)：payload 的形状必须与 inner T 一致（kind）。
            let okProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         lowering,

                                                         typedFn,
                                                         irFunction,
                                                         payloadNodeIndex)
            if okProbeKind != valueKind:
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=result_construct_skip stage=emit reason=payload_kind function={typedFn.functionName} line={arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex)} payload_kind={okProbeKind} value_kind={valueKind}")
                let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
                return false
    # 求值 payload（一旦含调用即发射，落点之后不可回落）。
    var payloadSlot = payloadPreSlot
    if payloadSlot < 0:
        payloadSlot = PrimaryBodyIrEvalNode(bodyIR,
                                            slotNames,
                                            varI32ParamNames,
                                            lowering,

                                            typedFn,
                                            irFunction,
                                            payloadNodeIndex,
                                            callOrdinal)
    if payloadSlot < 0 || payloadSlot >= bodyIR.localSlots.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    var payloadByteCount = valueSize
    var payloadWriteOffset = valueOffset
    if isErr:
        payloadByteCount = 24
        payloadWriteOffset = errMsgOffset
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[payloadSlot]) < payloadByteCount:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if !PrimaryBodyIrAppendZeroLocalSlot(bodyIR, slotNames, targetSlot, callOrdinal):
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    var okFlagValue = 1
    if isErr:
        okFlagValue = 0
    let okFlagSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#rc{arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex)}#{bodyIR.ops.len}#ok",
                                                     coreir.LocalI32Tag,
                                                     okFlagValue)
    if okFlagSlot < 0:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    var okStoreOp: coreir.BodyOp
    okStoreOp.kind = coreir.BodyOpFieldStoreTag
    okStoreOp.target = targetSlot
    add(okStoreOp.operands, targetSlot)
    add(okStoreOp.operands, okFlagSlot)
    add(okStoreOp.operands, coreir.ResultStrOkOffset)
    add(okStoreOp.operands, 4)
    let _ = coreir.BodyIRAppendOp(bodyIR, okStoreOp)
    if isErr:
        let errCodeSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#rc{arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex)}#{bodyIR.ops.len}#code",
                                                          coreir.LocalI32Tag,
                                                          1)
        if errCodeSlot < 0:
            let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
            return false
        var errCodeStoreOp: coreir.BodyOp
        errCodeStoreOp.kind = coreir.BodyOpFieldStoreTag
        errCodeStoreOp.target = targetSlot
        add(errCodeStoreOp.operands, targetSlot)
        add(errCodeStoreOp.operands, errCodeSlot)
        add(errCodeStoreOp.operands, errCodeOffset)
        add(errCodeStoreOp.operands, 4)
        let _ = coreir.BodyIRAppendOp(bodyIR, errCodeStoreOp)
    var payloadStoreOp: coreir.BodyOp
    payloadStoreOp.kind = coreir.BodyOpFieldStoreTag
    payloadStoreOp.target = targetSlot
    add(payloadStoreOp.operands, targetSlot)
    add(payloadStoreOp.operands, payloadSlot)
    add(payloadStoreOp.operands, payloadWriteOffset)
    add(payloadStoreOp.operands, payloadByteCount)
    let _ = coreir.BodyIRAppendOp(bodyIR, payloadStoreOp)
    return true

@borrows
fn PrimaryBodyIrAppendResultConstructFromArgLinks(bodyIR: var coreir.BodyIR,
                                                   slotNames: var str[],
                                                   varI32ParamNames: str[],
                                                   lowering: var lower.LoweringPlanStub,
                                                   typedFn: texpr.TypedExprIrFunction,
                                                   irFunction: lower.PrimaryObjectIrFunction,
                                                   sourcePath: str,
                                                   lineNumber: int32,
                                                   resultHead: str,
                                                   targetSlot: int32,
                                                   isErr: bool,
                                                   innerTypeRaw: str,
                                                   argLinkStart: int32,
                                                   argCount: int32,
                                                   callOrdinal: var int32): bool =
    let typedFnName = typedFn.functionName
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=rc_argl_entry_fail reason=target_slot_range function=",
                                                       strings.CloneStr(typedFnName),
                                                       " line=", strings.IntToStr(lineNumber),
                                                       " targetSlot=", strings.IntToStr(targetSlot)], ""))
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalAggregateTag:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=rc_argl_entry_fail reason=target_slot_type function=",
                                                       strings.CloneStr(typedFnName),
                                                       " line=", strings.IntToStr(lineNumber)], ""))
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[targetSlot]):
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=rc_argl_entry_fail reason=target_slot_is_param function=",
                                                       strings.CloneStr(typedFnName),
                                                       " line=", strings.IntToStr(lineNumber)], ""))
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    let innerType = strutil.Strip(innerTypeRaw)
    if innerType == "":
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=rc_argl_entry_fail reason=inner_type_empty function=",
                                                       strings.CloneStr(typedFnName),
                                                       " line=", strings.IntToStr(lineNumber)], ""))
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    var valueKind: int32
    var valueSize: int32
    var valueOffset: int32
    var errCodeOffset: int32
    var errMsgOffset: int32
    var totalSize: int32
    if !PrimaryBodyIrResultConstructLayout(lowering.typedIr,
                                           sourcePath,
                                           strings.CloneStr(innerType),
                                           valueKind,
                                           valueSize,
                                           valueOffset,
                                           errCodeOffset,
                                           errMsgOffset,
                                           totalSize):
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=result_construct_skip stage=stmt_arg reason=layout function={typedFnName} line={lineNumber} call_head={resultHead} inner={innerType}")
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) < totalSize:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=result_construct_skip stage=stmt_arg reason=target_size function={typedFnName} line={lineNumber} target_size={PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot])} need={totalSize}")
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    var payloadArgNodes: int32[]
    if !PrimaryBodyIrCollectArgLinkValueNodes(lowering.typedIr,
                                              argLinkStart,
                                              payloadArgNodes):
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=rc_argl_link_walk_fail function=",
                                                       strings.CloneStr(typedFnName),
                                                       " line=", strings.IntToStr(lineNumber),
                                                       " argLinkStart=", strings.IntToStr(argLinkStart)], ""))
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if payloadArgNodes.len != argCount:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=rc_argl_count_mismatch function=",
                                                       strings.CloneStr(typedFnName),
                                                       " line=", strings.IntToStr(lineNumber),
                                                       " builtCount=", strings.IntToStr(payloadArgNodes.len),
                                                       " argCount=", strings.IntToStr(argCount)], ""))
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if payloadArgNodes.len != 1:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=rc_argl_not_single function=",
                                                       strings.CloneStr(typedFnName),
                                                       " line=", strings.IntToStr(lineNumber),
                                                       " builtCount=", strings.IntToStr(payloadArgNodes.len)], ""))
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    let payloadNodeIndex = payloadArgNodes[0]
    # bail=801 P2 亚族: payload 是跨模块限定 str 常量 (Ok[str](yamuxmod.YamuxCodec))。
    # 节点探针对该形态无形状 (payload_kind=-1) → 恒 miss。仅当期望形状为 str
    # (Err payload 或 valueKind==str) 且 payload 字面文本经目标模块 const 块解析
    # 为纯字符串字面量时, 以字面量物化器建 str 槽绕过探针+求值; 解析不出走原
    # 路径 (poison 不变, 形态严等不重叠)。
    var payloadConstStrSlot: int32 = -1
    var payloadExpectsStr = isErr
    if !payloadExpectsStr && valueKind == coreir.LocalStrTag:
        payloadExpectsStr = true
    if payloadExpectsStr &&
       payloadNodeIndex >= 0 &&
       payloadNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
        # FieldGet 节点 literalText 只存字段叶名, 全限定路径在 surfaceText
        # (yamuxmod.YamuxCodec); surface 优先, 空则回落 literalText。
        var payloadConstText = ""
        let payloadSurfRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_surfaceTextIds[payloadNodeIndex])
        if IsOk(payloadSurfRes):
            payloadConstText = strutil.Strip(Value(payloadSurfRes))
        if payloadConstText == "":
            let payloadLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[payloadNodeIndex])
            if IsOk(payloadLitRes):
                payloadConstText = strutil.Strip(Value(payloadLitRes))
        if payloadConstText != "":
            let payloadConstLit = PrimaryBodyIrCanonicalConstStringLiteral(lowering.typedIr,
                                                                           sourcePath,
                                                                           payloadConstText)
            if payloadConstLit != "":
                let payloadConstSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                     slotNames,
                                                                     Fmt"#rc_const_str#{lineNumber}#{bodyIR.ops.len}",
                                                                     coreir.LocalStrTag)
                if payloadConstSlot >= 0 &&
                   PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                         slotNames,
                                                         payloadConstLit,
                                                         payloadConstSlot,
                                                         callOrdinal):
                    payloadConstStrSlot = payloadConstSlot
    # bail=801 P1 亚族: Ok payload 是 inner 型值构造器字面量
    # (Ok[T](T(field: v, ...)), HostDialTextOwned/quicPacketHeaderDecode 根)。
    # 节点探针对构造器整调用无形状 → 恒 miss。复用值聚合构造核心
    # AggregateConstructorToSlot: 头名=聚合类型/非可见函数/形状严等/字段全套门
    # 内置, 任一不过整体让位; 过门即物化进 inner 定形临时槽作 payload。
    if payloadConstStrSlot < 0 &&
       !isErr &&
       valueKind == coreir.LocalAggregateTag &&
       payloadNodeIndex >= 0 &&
       payloadNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
        # 命名字段聚合构造器占位节点的 literalText 只存构造头 (如
        # "MediaIngestReceipt"), 完整 "Type(field:v,...)" 文本在 surfaceText;
        # surface 优先, 空则回落 literalText (同函数内紧邻 P2 str 分支同款修法)。
        var payloadCtorText = ""
        let payloadCtorSurfRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_surfaceTextIds[payloadNodeIndex])
        if IsOk(payloadCtorSurfRes):
            payloadCtorText = strutil.Strip(Value(payloadCtorSurfRes))
        if payloadCtorText == "":
            let payloadCtorLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[payloadNodeIndex])
            if IsOk(payloadCtorLitRes):
                payloadCtorText = strutil.Strip(Value(payloadCtorLitRes))
        if payloadCtorText != "":
            let payloadCtorSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                     slotNames,
                                                                     lowering.typedIr,
                                                                     sourcePath,
                                                                     Fmt"#rc_ctor_payload#{lineNumber}#{bodyIR.ops.len}",
                                                                     innerType)
            if payloadCtorSlot >= 0 &&
               PrimaryBodyIrAppendAggregateConstructorToSlot(bodyIR,
                                                             slotNames,
                                                             varI32ParamNames,
                                                             lowering,

                                                             typedFn,
                                                             irFunction,
                                                             strings.CloneStr(payloadCtorText),
                                                             payloadNodeIndex,
                                                             strings.CloneStr(innerType),
                                                             sourcePath,
                                                             lineNumber,
                                                             payloadCtorSlot,
                                                             lineNumber * 31 + payloadNodeIndex,
                                                             callOrdinal):
                payloadConstStrSlot = payloadCtorSlot
            if payloadConstStrSlot < 0 && os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                let dbgFailIndex = primaryAggCtorLastFailIndex
                let dbgFailCode = primaryAggCtorLastFailCode
                os.WriteLine(os.GetStderr(), strutil.Join(["phase=rc_argl_ctor_payload_fail function=",
                                                           strings.CloneStr(typedFnName),
                                                           " line=", strings.IntToStr(lineNumber),
                                                           " payloadCtorText=", strings.CloneStr(payloadCtorText),
                                                           " innerType=", strings.CloneStr(innerType),
                                                           " failIndex=", strings.IntToStr(dbgFailIndex),
                                                           " failCode=", strings.IntToStr(dbgFailCode)], ""))
    if payloadConstStrSlot < 0:
        if isErr:
            let errProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,

                                                          share(typedFn),
                                                          irFunction,
                                                          payloadNodeIndex)
            if errProbeKind != coreir.LocalStrTag:
                let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
                return false
        else:
            let okProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         lowering,

                                                         typedFn,
                                                         irFunction,
                                                         payloadNodeIndex)
            if okProbeKind != valueKind:
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=result_construct_skip stage=stmt_arg reason=payload_kind function={typedFnName} line={lineNumber} payload_kind={okProbeKind} value_kind={valueKind}")
                let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
                return false
    var payloadSlot = payloadConstStrSlot
    if payloadSlot < 0:
        payloadSlot = PrimaryBodyIrEvalNode(bodyIR,
                                            slotNames,
                                            varI32ParamNames,
                                            lowering,

                                            typedFn,
                                            irFunction,
                                            payloadNodeIndex,
                                            callOrdinal)
    if payloadSlot < 0 || payloadSlot >= bodyIR.localSlots.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    var payloadByteCount = valueSize
    var payloadWriteOffset = valueOffset
    if isErr:
        payloadByteCount = 24
        payloadWriteOffset = errMsgOffset
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[payloadSlot]) < payloadByteCount:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if !PrimaryBodyIrAppendZeroLocalSlot(bodyIR, slotNames, targetSlot, callOrdinal):
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    var okFlagValue = 1
    if isErr:
        okFlagValue = 0
    let okFlagSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#rc{lineNumber}#{bodyIR.ops.len}#ok",
                                                     coreir.LocalI32Tag,
                                                     okFlagValue)
    if okFlagSlot < 0:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    var okStoreOp: coreir.BodyOp
    okStoreOp.kind = coreir.BodyOpFieldStoreTag
    okStoreOp.target = targetSlot
    add(okStoreOp.operands, targetSlot)
    add(okStoreOp.operands, okFlagSlot)
    add(okStoreOp.operands, coreir.ResultStrOkOffset)
    add(okStoreOp.operands, 4)
    let _ = coreir.BodyIRAppendOp(bodyIR, okStoreOp)
    if isErr:
        let errCodeSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"#rc{lineNumber}#{bodyIR.ops.len}#code",
                                                          coreir.LocalI32Tag,
                                                          1)
        if errCodeSlot < 0:
            let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
            return false
        var errCodeStoreOp: coreir.BodyOp
        errCodeStoreOp.kind = coreir.BodyOpFieldStoreTag
        errCodeStoreOp.target = targetSlot
        add(errCodeStoreOp.operands, targetSlot)
        add(errCodeStoreOp.operands, errCodeSlot)
        add(errCodeStoreOp.operands, errCodeOffset)
        add(errCodeStoreOp.operands, 4)
        let _ = coreir.BodyIRAppendOp(bodyIR, errCodeStoreOp)
    var payloadStoreOp: coreir.BodyOp
    payloadStoreOp.kind = coreir.BodyOpFieldStoreTag
    payloadStoreOp.target = targetSlot
    add(payloadStoreOp.operands, targetSlot)
    add(payloadStoreOp.operands, payloadSlot)
    add(payloadStoreOp.operands, payloadWriteOffset)
    add(payloadStoreOp.operands, payloadByteCount)
    let _ = coreir.BodyIRAppendOp(bodyIR, payloadStoreOp)
    return true

@borrows
fn PrimaryBodyIrAppendReturnResultConstructFromSameLine(bodyIR: var coreir.BodyIR,
                                                         slotNames: var str[],
                                                         varI32ParamNames: str[],
                                                         lowering: var lower.LoweringPlanStub,
                                                         typedFn: texpr.TypedExprIrFunction,
                                                         irFunction: lower.PrimaryObjectIrFunction,
                                                         stmtIndex: int32,
                                                         sameLineOrder: int32[],
                                                         sameLineLo: int32[],
                                                         sameLineHi: int32[],
                                                         currentBlockStart: var int32,
                                                         callOrdinal: var int32): bool =
    if stmtIndex < 0 || stmtIndex >= irFunction.statements.len:
        return false
    let stmt = irFunction.statements[stmtIndex]
    for scanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
        let scanIndex = sameLineOrder[scanP]
        if scanIndex < 0 || scanIndex >= irFunction.statements.len:
            continue
        let rcStmt = irFunction.statements[scanIndex]
        if rcStmt.kind != texpr.TypedExprIrStmtResultIntrinsic ||
           !rcStmt.returnRoot:
            continue
        let rcDetailIsConstructor =
            rcStmt.detailKind == parser.NormalizedExprDetailResultOk ||
            rcStmt.detailKind == parser.NormalizedExprDetailResultErr
        if !rcDetailIsConstructor:
            continue
        let rcHead = rcStmt.callCallee
        if !PrimaryBodyIrResultConstructorContract(lowering.typedIr,
                                                    typedFn,
                                                    irFunction,
                                                    rcStmt):
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         6101,
                                         int32(rcStmt.detailKind))
            PrimaryBodyIrNodeEvalOnlyOwn()
            return true
        var rcResultType = rcStmt.resultType
        if rcResultType == "":
            rcResultType = stmt.resultType
        if rcResultType == "":
            rcResultType = typedFn.returnType
        let rcInnerType = texpr.TypedExprResultSuccessType(rcResultType)
        if rcInnerType == "":
            continue
        var rcReturnKind: int32
        var rcReturnSize: int32
        var rcReturnAlign: int32
        PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                       rcStmt.sourcePath,
                                       rcResultType,
                                       rcReturnKind,
                                       rcReturnSize,
                                       rcReturnAlign)
        if rcReturnKind != coreir.LocalAggregateTag:
            continue
        let rcSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                        slotNames,
                                                        lowering.typedIr,
                                                        rcStmt.sourcePath,
                                                        Fmt"#return_result_construct#{stmt.lineNumber}",
                                                        rcResultType)
        if rcSlot < 0:
            continue
        let rcEmitMark = primaryBodyIrNodeEvalCallEmitCount
        let rcIsErr = rcHead == "Err"
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), strutil.Join(["phase=rc_sameline_pre_argl function=",
                                                       strings.CloneStr(typedFn.functionName),
                                                       " argStart=", strings.IntToStr(rcStmt.callArgNodeStart),
                                                       " argCount=", strings.IntToStr(rcStmt.callArgCount),
                                                       " rcSlot=", strings.IntToStr(rcSlot),
                                                       " innerType=", strings.CloneStr(rcInnerType)], ""))
        if PrimaryBodyIrAppendResultConstructFromArgLinks(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          strings.CloneStr(rcStmt.sourcePath),
                                                          stmt.lineNumber,
                                                          strings.CloneStr(rcHead),
                                                          rcSlot,
                                                          rcIsErr,
                                                          strings.CloneStr(rcInnerType),
                                                          rcStmt.callArgNodeStart,
                                                          rcStmt.callArgCount,
                                                          callOrdinal):
            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                          currentBlockStart,
                                          rcSlot,
                                          rcReturnKind,
                                          0,
                                          false)
            PrimaryBodyIrNodeEvalOnlyOwn()
            return true
        if primaryBodyIrNodeEvalCallEmitCount != rcEmitMark:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt.lineNumber,
                                         int32(stmt.kind),
                                         6101,
                                         0)
            return true
    return false

# ErrCode[T](code,msg) 构造发射：双参 Err 变体。ok=0，err.code=code(int32@
# errCodeOffset)，err.msg=msg(str 24B@errMsgOffset)，value 不写（零初始化）。
# 所有可失败判定（参数数、形状探针、payload 求值、槽宽）在零初始化前完成，
# 零初始化后必发射成功（已发 setMem/store 不可回落，let-it-crash）。
@borrows
fn PrimaryBodyIrAppendResultErrCodeConstruct(bodyIR: var coreir.BodyIR,
                                              slotNames: var str[],
                                              varI32ParamNames: str[],
                                              lowering: var lower.LoweringPlanStub,
                                              typedFn: texpr.TypedExprIrFunction,
                                              irFunction: lower.PrimaryObjectIrFunction,
                                              nodeIndex: int32,
                                              targetSlot: int32,
                                              payloadArgNodes: int32[],
                                              errCodeOffset: int32,
                                              errMsgOffset: int32,
                                              callOrdinal: var int32): bool =
    if payloadArgNodes.len != 2:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    let codeNodeIndex = payloadArgNodes[0]
    let msgNodeIndex = payloadArgNodes[1]
    # 形状探针：code 必须 i32、msg 必须 str（探针无副作用，全部门前完成）。
    let codeProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                   slotNames,
                                                   varI32ParamNames,
                                                   lowering,

                                                   share(typedFn),
                                                   irFunction,
                                                   codeNodeIndex)
    if codeProbeKind != coreir.LocalI32Tag:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    let msgProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering,

                                                  share(typedFn),
                                                  irFunction,
                                                  msgNodeIndex)
    if msgProbeKind != coreir.LocalStrTag:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    # 求值 code 与 msg（含调用即发射；落点后不可回落）。
    let codeSlot = PrimaryBodyIrEvalNode(bodyIR,
                                         slotNames,
                                         varI32ParamNames,
                                         lowering,

                                         share(typedFn),
                                         irFunction,
                                         codeNodeIndex,
                                         callOrdinal)
    if codeSlot < 0 || codeSlot >= bodyIR.localSlots.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    let msgSlot = PrimaryBodyIrEvalNode(bodyIR,
                                        slotNames,
                                        varI32ParamNames,
                                        lowering,

                                        typedFn,
                                        irFunction,
                                        msgNodeIndex,
                                        callOrdinal)
    if msgSlot < 0 || msgSlot >= bodyIR.localSlots.len:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[msgSlot]) < 24:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    if !PrimaryBodyIrAppendZeroLocalSlot(bodyIR, slotNames, targetSlot, callOrdinal):
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    # ok=0（Err 变体）。
    let okFlagSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"#ec{arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex)}#{bodyIR.ops.len}#ok",
                                                     coreir.LocalI32Tag,
                                                     0)
    if okFlagSlot < 0:
        let _ = PrimaryBodyIrNodeEvalMissAt("result_construct")
        return false
    var okStoreOp: coreir.BodyOp
    okStoreOp.kind = coreir.BodyOpFieldStoreTag
    okStoreOp.target = targetSlot
    add(okStoreOp.operands, targetSlot)
    add(okStoreOp.operands, okFlagSlot)
    add(okStoreOp.operands, coreir.ResultStrOkOffset)
    add(okStoreOp.operands, 4)
    let _ = coreir.BodyIRAppendOp(bodyIR, okStoreOp)
    # err.code = code（int32@errCodeOffset）。
    var codeStoreOp: coreir.BodyOp
    codeStoreOp.kind = coreir.BodyOpFieldStoreTag
    codeStoreOp.target = targetSlot
    add(codeStoreOp.operands, targetSlot)
    add(codeStoreOp.operands, codeSlot)
    add(codeStoreOp.operands, errCodeOffset)
    add(codeStoreOp.operands, 4)
    let _ = coreir.BodyIRAppendOp(bodyIR, codeStoreOp)
    # err.msg = msg（str 24B@errMsgOffset）。
    var msgStoreOp: coreir.BodyOp
    msgStoreOp.kind = coreir.BodyOpFieldStoreTag
    msgStoreOp.target = targetSlot
    add(msgStoreOp.operands, targetSlot)
    add(msgStoreOp.operands, msgSlot)
    add(msgStoreOp.operands, errMsgOffset)
    add(msgStoreOp.operands, 24)
    let _ = coreir.BodyIRAppendOp(bodyIR, msgStoreOp)
    return true

# 批次6b：节点子树是否含 CallExpr（节点按构建序无环，操作数恒指向更早节点）。
@borrows
fn PrimaryBodyIrNodeTreeHasCallExpr(typedIr: texpr.TypedExprIr,
                                     nodeIndex: int32): bool =
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return false
    let opKind = typedIr.nodes2_opKinds[nodeIndex]
    if opKind == texpr.TypedExprIrOpCallExpr:
        # 纯标量宽度 cast（int8/16/32/64/uint*(x)）无副作用、不消费 callOrdinal
        # （node-eval 仅发 BodyOpCopyLocal 位重解释），短路序无关：递归进其单实参而非
        # 按「含调用」一律 return true，使含此类 cast 的 LogAnd/LogOr 纯条件放行真走
        # node-eval。CastCallArgNodeIndex 仅对标量 cast 头 + 单 ArgLink 返回 >=0；真函数
        # 调用/多参/cstring 重解释返回 -1，仍 return true，不误放。
        let castInnerArg = PrimaryBodyIrCastCallArgNodeIndex(typedIr, nodeIndex)
        if castInnerArg >= 0:
            return PrimaryBodyIrNodeTreeHasCallExpr(typedIr, castInnerArg)
        return true
    if PrimaryBodyIrNodeTreeHasCallExpr(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex)):
        return true
    if PrimaryBodyIrNodeTreeHasCallExpr(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, nodeIndex)):
        return true
    return PrimaryBodyIrNodeTreeHasCallExpr(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand2NodeIndexs, nodeIndex))

# T78 短路契约根修：LogAnd/LogOr 的非短路位运算捷径只在两操作数都无副作用时
# 成立——HasCallExpr 只探真调用，漏了下标读（IndexGet）：`i < arr.len && arr[i]`
# 在空/短 seq 上两臂都无调用，被判"安全"进 eager 位与/位或快路径，未经过
# `i < arr.len` 的分支守卫就急切求 arr[i]，越界读栈/堆垃圾(SIGSEGV)。新增
# 谓词=HasCallExpr 或含 IndexGet，只替换 LogAnd/LogOr 的 eager-safety 门（探针
# 36071 起 + EvalNode 合并臂 38590 起 + decl bool 门 46798 起三处），不改其余
# ~12 处 HasCallExpr 调用点（三元 select 守卫/调用物化排序等不同语义，扩大会
# 误伤）。
@borrows
fn PrimaryBodyIrNodeTreeHasFaultingEagerSurface(typedIr: texpr.TypedExprIr,
                                                  nodeIndex: int32): bool =
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return false
    let opKind = typedIr.nodes2_opKinds[nodeIndex]
    if opKind == texpr.TypedExprIrOpIndexGet:
        return true
    if opKind == texpr.TypedExprIrOpCallExpr:
        let castInnerArg = PrimaryBodyIrCastCallArgNodeIndex(typedIr, nodeIndex)
        if castInnerArg >= 0:
            return PrimaryBodyIrNodeTreeHasFaultingEagerSurface(typedIr, castInnerArg)
        return true
    if PrimaryBodyIrNodeTreeHasFaultingEagerSurface(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, nodeIndex)):
        return true
    if PrimaryBodyIrNodeTreeHasFaultingEagerSurface(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, nodeIndex)):
        return true
    return PrimaryBodyIrNodeTreeHasFaultingEagerSurface(typedIr, arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand2NodeIndexs, nodeIndex))

# FindOrCreateTypedSlot 的形状预测镜像（不建槽）：TypeShapeFromText +
# 源布局回退 + 槽尺寸归一化，与求值器实际建槽的类标/容量一致。
@borrows
fn PrimaryBodyIrNodeEvalTypedSlotShape(typedIr: texpr.TypedExprIr,
                                        sourcePath: str,
                                        typeRaw: str,
                                        sizeBytesOut: var int32): int32 =
    var shapeKind: int32
    var shapeSize: int32
    var shapeAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr, sourcePath, typeRaw, shapeKind, shapeSize, shapeAlign)
    var shapeNeedsSourceLayout: bool
    if sourcePath != "":
        if shapeSize <= 0:
            shapeNeedsSourceLayout = true
        elif shapeAlign <= 0:
            shapeNeedsSourceLayout = true
    if shapeNeedsSourceLayout:
        var shapeSourceSize: int32
        var shapeSourceAlign: int32
        if PrimaryBodyIrCanonicalTypeLayout(typedIr,
                                                  sourcePath,
                                                  "",
                                                  typeRaw,
                                                  0,
                                                  shapeSourceSize,
                                                  shapeSourceAlign):
            shapeKind = coreir.LocalAggregateTag
            shapeSize = shapeSourceSize
    sizeBytesOut = PrimaryBodyIrNormalizeSlotSizeBytes(shapeKind, shapeSize)
    return shapeKind

# 判定声明类型是否经 owner-aware IR alias 链收敛为 fn-ptr。每一跳都使用
# `定义 source + alias name` 身份；歧义与环立即暴露，禁止一层展开或全局撞名回退。
@borrows
fn PrimaryBodyIrResolvedFnPtrDeclType(typedIr: texpr.TypedExprIr,
                                       sourcePath: str,
                                       declaredTypeRaw: str): str =
    var ownerSourcePath = parser.ParserNormalizePath(sourcePath)
    var declaredType = texpr.TypedExprNormalizeTypeText(
        texpr.TypedExprStripVarType(declaredTypeRaw))
    if ownerSourcePath == "" || declaredType == "":
        return ""
    if texpr.TypedExprTypeTextIsFnPtr(declaredType):
        return declaredType
    var visitedOwners: str[]
    var visitedNames: str[]
    while true:
        var aliasOwnerSourcePath = ""
        var aliasTarget = ""
        var aliasCycle = false
        let aliasState = texpr.TypedExprIrAliasTarget(typedIr,
                                                       ownerSourcePath,
                                                       declaredType,
                                                       visitedOwners,
                                                       visitedNames,
                                                       aliasOwnerSourcePath,
                                                       aliasTarget,
                                                       aliasCycle)
        if aliasCycle:
            panic(Fmt"primary: function pointer alias cycle source={ownerSourcePath} type={declaredType}")
        if aliasState == texpr.TypedExprBuildIndexAmbiguous:
            panic(Fmt"primary: function pointer alias ambiguous source={ownerSourcePath} type={declaredType}")
        if aliasState != texpr.TypedExprBuildIndexUnique:
            return ""
        ownerSourcePath = aliasOwnerSourcePath
        declaredType = aliasTarget
        if texpr.TypedExprTypeTextIsFnPtr(declaredType):
            return declaredType

# 批次6b：节点求值器的纯前置探针。镜像 PrimaryBodyIrEvalNode /
# PrimaryBodyIrAppendCallExprNodeToSlot 的全部可失败检查但不发射任何
# 操作，返回预测结果槽类标（-1=不可降）。含 CallExpr 的子树必须先过
# `&FunctionName` 取顶层函数符号地址：把函数符号当 8 字节数据指针物化。解析
# 函数索引后建 GlobalAddress 槽（名 __cheng_function_address#N），emit/reloc
# 阶段经 adrp+add（PAGE/PAGEOFF reloc against allSymbolNames[N]）取函数入口地
# 址。与既有「函数地址作 var 形参字段实参根」走链（11107）同款槽协议。返回 -1
# 表示函数名解析失败（无此顶层函数）。仅 AddrOf 求值/call-arg 两处调用。
@borrows
fn PrimaryBodyIrFuncRefAddressSlot(bodyIR: var coreir.BodyIR,
                                    slotNames: var str[],
                                    lowering: var lower.LoweringPlanStub,
                                    sourcePath: str,
                                    funcName: str): int32 =
    let funcRefIndex = PrimaryPlanResolveTargetIndex(lowering,
                                                     sourcePath,
                                                     funcName)
    if funcRefIndex < 0:
        return -1
    let funcRefSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                    slotNames,
                                                    PrimaryBodyIrFunctionAddressSlotName(funcRefIndex),
                                                    coreir.LocalPtrTag)
    if funcRefSlot < 0 || funcRefSlot >= bodyIR.localSlots.len:
        return -1
    PrimaryBodyIrNodeBoolChainJournalSlotBeforeWrite(bodyIR, funcRefSlot)
    bodyIR.localSlots[funcRefSlot].placeKind = coreir.BodyPlaceGlobalAddressTag
    return funcRefSlot

# 探针再求值——调用一旦发射就不可落回文本路径（会二次发射副作用）。
# `&place` 取址的 root 槽 + 总偏移解析。place 既可是字段路径（root.f.g，
# 复用 VarArgFieldPathInfo 的多级走链），也可是整 local/param。整标量根由
# PrimaryBodyIrMaterializeAddrOfPlaceSlot 发 BodyLoadLocalAddress，绝不把标量值
# 当地址；聚合/指针根与字段路径保留既有 base+offset 协议。
@borrows
fn PrimaryBodyIrAddrOfPlaceRootInfo(bodyIR: var coreir.BodyIR,
                                     slotNames: var str[],
                                     typedIr: texpr.TypedExprIr,
                                     placeNodeIndex: int32,
                                     rootSlotOut: var int32,
                                     totalOffsetOut: var int32): bool =
    rootSlotOut = -1
    totalOffsetOut = 0
    if placeNodeIndex < 0 || placeNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return false
    if typedIr.nodes2_opKinds[placeNodeIndex] == texpr.TypedExprIrOpParamRef ||
       typedIr.nodes2_opKinds[placeNodeIndex] == texpr.TypedExprIrOpLocalRef:
        let aopPnRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_paramNameIds[placeNodeIndex])
        let aopStRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_surfaceTextIds[placeNodeIndex])
        if !IsOk(aopPnRes) || !IsOk(aopStRes):
            return false
        var rootOnlyName = Value(aopPnRes)
        if rootOnlyName == "":
            rootOnlyName = strutil.Strip(Value(aopStRes))
        if rootOnlyName == "":
            return false
        let rootOnlySlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rootOnlyName)
        if rootOnlySlot < 0 || rootOnlySlot >= bodyIR.localSlots.len:
            return false
        if PrimaryBodyIrVarParamPointeeKind(bodyIR, rootOnlySlot) != coreir.LocalInvalidTag:
            return false
        let rootOnlyKind = PrimaryBodyIrSlotType(bodyIR, rootOnlySlot)
        if rootOnlyKind != coreir.LocalI32Tag &&
           rootOnlyKind != coreir.LocalI64Tag &&
           rootOnlyKind != coreir.LocalF64Tag &&
           rootOnlyKind != coreir.LocalAggregateTag &&
           rootOnlyKind != coreir.LocalPtrTag:
            return false
        rootSlotOut = rootOnlySlot
        totalOffsetOut = 0
        return true
    return PrimaryBodyIrVarArgFieldPathInfo(bodyIR,
                                            slotNames,
                                            typedIr,
                                            placeNodeIndex,
                                            rootSlotOut,
                                            totalOffsetOut)

@borrows
fn PrimaryBodyIrMaterializeAddrOfPlaceSlot(bodyIR: var coreir.BodyIR,
                                           slotNames: var str[],
                                           typedIr: texpr.TypedExprIr,
                                           placeNodeIndex: int32,
                                           rootSlot: int32,
                                           totalOffset: int32,
                                           targetName: str): int32 =
    if placeNodeIndex < 0 || placeNodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       rootSlot < 0 || rootSlot >= bodyIR.localSlots.len ||
       totalOffset < 0 || targetName == "":
        return -1
    let targetSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                   slotNames,
                                                   targetName,
                                                   coreir.LocalPtrTag)
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        return -1
    let placeOpKind = typedIr.nodes2_opKinds[placeNodeIndex]
    let rootKind = PrimaryBodyIrSlotType(bodyIR, rootSlot)
    if (placeOpKind == texpr.TypedExprIrOpParamRef ||
        placeOpKind == texpr.TypedExprIrOpLocalRef) &&
       totalOffset == 0 &&
       (rootKind == coreir.LocalI32Tag ||
        rootKind == coreir.LocalI64Tag ||
        rootKind == coreir.LocalF64Tag ||
        rootKind == coreir.LocalPtrTag):
        var localAddressOp: coreir.BodyOp
        localAddressOp.kind = coreir.BodyOpLoadLocalTag
        localAddressOp.target = targetSlot
        add(localAddressOp.operands, coreir.BodyLoadLocalAddressTag)
        add(localAddressOp.operands, rootSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, localAddressOp)
        return targetSlot
    let offsetSlot = PrimaryBodyIrLocalInitConstSlot(
        bodyIR,
        slotNames,
        targetName + "#off",
        coreir.LocalI64Tag,
        totalOffset)
    if offsetSlot < 0:
        return -1
    var addressOp: coreir.BodyOp
    addressOp.kind = coreir.BodyOpBinOpTag
    addressOp.target = targetSlot
    add(addressOp.operands, coreir.LocalI64Tag)
    add(addressOp.operands, int32(texpr.TypedExprIrOpI32Add))
    add(addressOp.operands, rootSlot)
    add(addressOp.operands, offsetSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, addressOp)
    return targetSlot

@borrows
fn PrimaryBodyIrVarArgFieldPathInfo(bodyIR: var coreir.BodyIR,
                                     slotNames: var str[],
                                     typedIr: texpr.TypedExprIr,
                                     argNodeIndex: int32,
                                     rootSlotOut: var int32,
                                     totalOffsetOut: var int32): bool =
    rootSlotOut = -1
    totalOffsetOut = 0
    if argNodeIndex < 0 || argNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return false
    if typedIr.nodes2_opKinds[argNodeIndex] != texpr.TypedExprIrOpFieldGet ||
       arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldOffsetBytes, argNodeIndex) < 0 ||
       arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldSizeBytes, argNodeIndex) <= 0:
        return false
    var totalOffset = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldOffsetBytes, argNodeIndex)
    var hopIndex = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, argNodeIndex)
    # Follow the actual operand graph to its root. The active node-index set is
    # proportional to this path and rejects cyclic/malformed TypedIR immediately.
    var visitedHopNodes: int32[]
    while hopIndex >= 0 && hopIndex < typedIr.nodes2_nodeIndexs.len &&
          typedIr.nodes2_opKinds[hopIndex] == texpr.TypedExprIrOpFieldGet:
        for visitedIndex in 0..<visitedHopNodes.len:
            if visitedHopNodes[visitedIndex] == hopIndex:
                return false
        add(visitedHopNodes, hopIndex)
        if arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldOffsetBytes, hopIndex) < 0 || arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldSizeBytes, hopIndex) <= 0:
            return false
        let vafSrcRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_sourcePathIds[hopIndex])
        let vafRtRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_resultTypeIds[hopIndex])
        if !IsOk(vafSrcRes) || !IsOk(vafRtRes):
            return false
        var hopKind: int32
        var hopSize: int32
        var hopAlign: int32
        PrimaryBodyIrTypeShapeFromText(typedIr,
                                       Value(vafSrcRes),
                                       Value(vafRtRes),
                                       hopKind,
                                       hopSize,
                                       hopAlign)
        if hopKind != coreir.LocalAggregateTag:
            return false
        if hopSize != arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldSizeBytes, hopIndex):
            return false
        totalOffset = totalOffset + arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldOffsetBytes, hopIndex)
        hopIndex = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, hopIndex)
    if hopIndex < 0 || hopIndex >= typedIr.nodes2_nodeIndexs.len:
        return false
    if typedIr.nodes2_opKinds[hopIndex] != texpr.TypedExprIrOpParamRef &&
       typedIr.nodes2_opKinds[hopIndex] != texpr.TypedExprIrOpLocalRef:
        return false
    let vafRootPnRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_paramNameIds[hopIndex])
    let vafRootStRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_surfaceTextIds[hopIndex])
    if !IsOk(vafRootPnRes) || !IsOk(vafRootStRes):
        return false
    var rootName = Value(vafRootPnRes)
    if rootName == "":
        rootName = strutil.Strip(Value(vafRootStRes))
    if rootName == "":
        return false
    let rootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rootName)
    if rootSlot < 0 || rootSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryBodyIrVarParamPointeeKind(bodyIR, rootSlot) != coreir.LocalInvalidTag:
        return false
    if PrimaryBodyIrSlotType(bodyIR, rootSlot) != coreir.LocalAggregateTag &&
       PrimaryBodyIrSlotType(bodyIR, rootSlot) != coreir.LocalPtrTag:
        return false
    rootSlotOut = rootSlot
    totalOffsetOut = totalOffset
    return true

@borrows
fn PrimaryBodyIrVarArgIndexInfo(bodyIR: var coreir.BodyIR,
                                 slotNames: var str[],
                                 typedIr: texpr.TypedExprIr,
                                 argNodeIndex: int32,
                                 rootSlotOut: var int32,
                                 headerOffsetOut: var int32,
                                 elemSizeOut: var int32,
                                 indexNodeOut: var int32): bool =
    rootSlotOut = -1
    headerOffsetOut = 0
    elemSizeOut = 0
    indexNodeOut = -1
    if argNodeIndex < 0 || argNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return false
    if typedIr.nodes2_opKinds[argNodeIndex] != texpr.TypedExprIrOpIndexGet:
        return false
    if arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_elemSizeBytes, argNodeIndex) <= 0:
        return false
    let baseNodeIndex = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, argNodeIndex)
    if baseNodeIndex < 0 || baseNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return false
    if arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, argNodeIndex) < 0 || arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, argNodeIndex) >= typedIr.nodes2_nodeIndexs.len:
        return false
    # (b) FieldGet 基：root.field[idx]——求 (rootSlot, fieldOffset) 头偏移。
    if typedIr.nodes2_opKinds[baseNodeIndex] == texpr.TypedExprIrOpFieldGet:
        var fieldBaseRootSlot: int32
        var fieldBaseOffset: int32
        if PrimaryBodyIrVarArgFieldPathInfo(bodyIR,
                                            slotNames,
                                            typedIr,
                                            baseNodeIndex,
                                            fieldBaseRootSlot,
                                            fieldBaseOffset):
            rootSlotOut = fieldBaseRootSlot
            headerOffsetOut = fieldBaseOffset
            elemSizeOut = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_elemSizeBytes, argNodeIndex)
            indexNodeOut = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, argNodeIndex)
            return true
        return false
    if typedIr.nodes2_opKinds[baseNodeIndex] != texpr.TypedExprIrOpParamRef &&
       typedIr.nodes2_opKinds[baseNodeIndex] != texpr.TypedExprIrOpLocalRef:
        return false
    let vaiRtRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_resultTypeIds[baseNodeIndex])
    let vaiPnRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_paramNameIds[baseNodeIndex])
    let vaiStRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_surfaceTextIds[baseNodeIndex])
    let vaiSrcRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_sourcePathIds[baseNodeIndex])
    if !IsOk(vaiRtRes) || !IsOk(vaiPnRes) || !IsOk(vaiStRes) || !IsOk(vaiSrcRes):
        return false
    # form59 residual: hoist Value(Result[str]) before StripVarType
    let vaiRt_f59: str = Value(vaiRtRes)
    let baseTypeText = texpr.TypedExprStripVarType(vaiRt_f59)
    if len(baseTypeText) < 2 ||
       strings.SliceBytes(baseTypeText, len(baseTypeText) - 2, 2) != "[]":
        return false
    var baseName = Value(vaiPnRes)
    if baseName == "":
        baseName = strutil.Strip(Value(vaiStRes))
    if baseName == "":
        return false
    let baseSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, baseName)
    if baseSlot < 0 || baseSlot >= bodyIR.localSlots.len:
        # (c) global seq：物化全局头地址槽。
        let globalSeqSlot = PrimaryBodyIrGlobalSeqAddressSlot(bodyIR,
                                                              slotNames,
                                                              typedIr,
                                                              Value(vaiSrcRes),
                                                              baseName)
        if globalSeqSlot < 0:
            return false
        rootSlotOut = globalSeqSlot
        headerOffsetOut = 0
        elemSizeOut = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_elemSizeBytes, argNodeIndex)
        indexNodeOut = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, argNodeIndex)
        return true
    if PrimaryBodyIrVarParamPointeeKind(bodyIR, baseSlot) != coreir.LocalInvalidTag:
        return false
    if PrimaryBodyIrSlotType(bodyIR, baseSlot) != coreir.LocalAggregateTag &&
       PrimaryBodyIrSlotType(bodyIR, baseSlot) != coreir.LocalPtrTag:
        return false
    rootSlotOut = baseSlot
    headerOffsetOut = 0
    elemSizeOut = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_elemSizeBytes, argNodeIndex)
    indexNodeOut = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand1NodeIndexs, argNodeIndex)
    return true

@borrows
fn PrimaryBodyIrIndexedLvalueIdentityExact(
        bodyIR: coreir.BodyIR,
        bindingProjection:
            var coreir.BodyIRLocalBindingValueDefinitionProjection,
        lowering: lower.LoweringPlanStub,
        typedFn: texpr.TypedExprIrFunction,
        statementRow: int32,
        lvalueNodeIndex: int32,
        rhsNodeIndex: int32,
        rootSlotOut: var int32,
        headerOffsetOut: var int32,
        elemKindOut: var int32,
        elemSizeOut: var int32,
        indexNodeOut: var int32,
        fixedArrayOut: var bool): bool =
    rootSlotOut = -1
    headerOffsetOut = 0
    elemKindOut = coreir.LocalInvalidTag
    elemSizeOut = 0
    indexNodeOut = -1
    fixedArrayOut = false
    let nodeCount = lowering.typedIr.nodes2_nodeIndexs.len
    let statementCount =
        lowering.typedIr.statements2_statementIndexs.len
    let definitionAuthorityCount =
        texpr.TypedExprValueDefinitionAuthorityCount(lowering.typedIr)
    if nodeCount <= 0 || statementCount <= 0 ||
       typedFn.valueDefinitionStart < 0 ||
       typedFn.valueDefinitionCount < 0 ||
       typedFn.valueDefinitionStart > definitionAuthorityCount ||
       typedFn.valueDefinitionCount >
           definitionAuthorityCount - typedFn.valueDefinitionStart ||
       typedFn.valueDefinitionStart !=
           bodyIR.localBindingValueDefinitionDomainStart ||
       typedFn.valueDefinitionCount !=
           bodyIR.localBindingValueDefinitionDomainCount ||
       lowering.typedIr.nodes2_operand0NodeIndexs.len != nodeCount ||
       lowering.typedIr.nodes2_operand1NodeIndexs.len != nodeCount ||
       lowering.typedIr.nodes2_exactTypeArenaIds.len != nodeCount ||
       lowering.typedIr.nodes2_elemSizeBytes.len != nodeCount ||
       lowering.typedIr.nodes2_ownerStatementIndexes.len != nodeCount ||
       lowering.typedIr.nodes2_bindingValueDefinitionRows.len != nodeCount ||
       lowering.typedIr.statements2_kinds.len != statementCount ||
       lowering.typedIr.statements2_rhsNodeIndexs.len != statementCount ||
       lowering.typedIr.statements2_assignLvalueNodeIndexs.len !=
           statementCount ||
       lowering.typedIr.statements2_assignIndexNodeIndexs.len !=
           statementCount ||
       lowering.typedIr.statements2_bindingTargetDefinitionRows.len !=
           statementCount ||
       !lowering.typedIr.nodeAuthorityTypeArenaBound ||
       !lowering.typedIr.valueDefinitionTypeArenaBound ||
       !layout.FixedBytes32Equal(
           lowering.typedIr.nodeAuthorityTypeArenaArtifactCid,
           lowering.typeArenaArtifactCid) ||
       !layout.FixedBytes32Equal(
           lowering.typedIr.valueDefinitionTypeArenaArtifactCid,
           lowering.typeArenaArtifactCid) ||
       !layout.FixedBytes32Equal(
           bodyIR.typeArenaArtifactCid,
           lowering.typeArenaArtifactCid):
        return false
    coreir.BodyIRLocalBindingValueDefinitionProjectionSync(
        bodyIR, bindingProjection)
    if typedFn.statementStart < 0 || typedFn.statementCount < 0 ||
       typedFn.statementStart > statementCount - typedFn.statementCount ||
       statementRow < typedFn.statementStart ||
       statementRow >= typedFn.statementStart + typedFn.statementCount ||
       typedFn.nodeStart < 0 || typedFn.nodeCount < 0 ||
       typedFn.nodeStart > nodeCount - typedFn.nodeCount ||
       statementRow < 0 || statementRow >= statementCount ||
       arenamod.ArenaArrayInt32Get(
           lowering.typedIr.arena,
           lowering.typedIr.statements2_statementIndexs,
           statementRow) != statementRow ||
       lowering.typedIr.statements2_kinds[statementRow] !=
           texpr.TypedExprIrStmtAssign ||
       arenamod.ArenaArrayInt32Get(
           lowering.typedIr.arena,
           lowering.typedIr.statements2_assignLvalueNodeIndexs,
           statementRow) != lvalueNodeIndex ||
       arenamod.ArenaArrayInt32Get(
           lowering.typedIr.arena,
           lowering.typedIr.statements2_rhsNodeIndexs,
           statementRow) != rhsNodeIndex:
        return false
    if lvalueNodeIndex < 0 ||
       lvalueNodeIndex < typedFn.nodeStart ||
       lvalueNodeIndex >= typedFn.nodeStart + typedFn.nodeCount ||
       rhsNodeIndex < typedFn.nodeStart ||
       rhsNodeIndex >= typedFn.nodeStart + typedFn.nodeCount ||
       lowering.typedIr.nodes2_opKinds[lvalueNodeIndex] !=
           texpr.TypedExprIrOpIndexGet ||
       arenamod.ArenaArrayInt32Get(
           lowering.typedIr.arena,
           lowering.typedIr.nodes2_ownerStatementIndexes,
           lvalueNodeIndex) != statementRow ||
       arenamod.ArenaArrayInt32Get(
           lowering.typedIr.arena,
           lowering.typedIr.nodes2_ownerStatementIndexes,
           rhsNodeIndex) != statementRow:
        return false
    let containerNodeIndex = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_operand0NodeIndexs,
        lvalueNodeIndex)
    let indexNodeIndex = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_operand1NodeIndexs,
        lvalueNodeIndex)
    let elemSize = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_elemSizeBytes,
        lvalueNodeIndex)
    if containerNodeIndex < typedFn.nodeStart ||
       containerNodeIndex >= lvalueNodeIndex ||
       indexNodeIndex < typedFn.nodeStart ||
       indexNodeIndex >= lvalueNodeIndex || elemSize <= 0 ||
       arenamod.ArenaArrayInt32Get(
           lowering.typedIr.arena,
           lowering.typedIr.nodes2_ownerStatementIndexes,
           containerNodeIndex) != statementRow ||
       arenamod.ArenaArrayInt32Get(
           lowering.typedIr.arena,
           lowering.typedIr.nodes2_ownerStatementIndexes,
           indexNodeIndex) != statementRow ||
       arenamod.ArenaArrayInt32Get(
           lowering.typedIr.arena,
           lowering.typedIr.statements2_assignIndexNodeIndexs,
           statementRow) != indexNodeIndex:
        return false
    let containerTypeId = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_exactTypeArenaIds,
        containerNodeIndex)
    let containerPhysicalTypeId =
        typechain.CanonicalTypeChainPhysicalTypeId(
            lowering, containerTypeId)
    let containerKind =
        lowering.typeArenaStructuralKinds[containerPhysicalTypeId]
    if containerKind !=
           Int32(typearena.TypedExprStructuralTypeSequence) &&
       containerKind !=
           Int32(typearena.TypedExprStructuralTypeFixedArray):
        return false
    let elemTypeId =
        typechain.CanonicalTypeChainSequenceElementTypeId(
            lowering, containerTypeId, true)
    let lvalueTypeId = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_exactTypeArenaIds,
        lvalueNodeIndex)
    let elemPhysicalTypeId =
        typechain.CanonicalTypeChainPhysicalTypeId(
            lowering, elemTypeId)
    if elemTypeId != lvalueTypeId ||
       elemSize != lowering.typeArenaSizeBytes[elemPhysicalTypeId] ||
       elemSize <= 0:
        return false
    let elemKind = typechain.CanonicalTypeChainLocalKind(
        lowering, elemTypeId)
    let indexTypeId = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_exactTypeArenaIds,
        indexNodeIndex)
    let indexPhysicalTypeId =
        typechain.CanonicalTypeChainPhysicalTypeId(
            lowering, indexTypeId)
    let indexScalarKind =
        lowering.typeArenaScalarKinds[indexPhysicalTypeId]
    if lowering.typeArenaStructuralKinds[indexPhysicalTypeId] !=
           Int32(typearena.TypedExprStructuralTypeScalar) ||
       (indexScalarKind !=
            Int32(typearena.TypedExprStructuralScalarInt) &&
        indexScalarKind !=
            Int32(typearena.TypedExprStructuralScalarUInt) &&
        indexScalarKind !=
            Int32(typearena.TypedExprStructuralScalarInt32) &&
        indexScalarKind !=
            Int32(typearena.TypedExprStructuralScalarUInt32) &&
        indexScalarKind !=
            Int32(typearena.TypedExprStructuralScalarInt64) &&
        indexScalarKind !=
            Int32(typearena.TypedExprStructuralScalarUInt64)) ||
       (typechain.CanonicalTypeChainLocalKind(
            lowering, indexTypeId) != coreir.LocalI32Tag &&
        typechain.CanonicalTypeChainLocalKind(
            lowering, indexTypeId) != coreir.LocalI64Tag):
        return false
    let rhsTypeId = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_exactTypeArenaIds,
        rhsNodeIndex)
    let rhsPhysicalTypeId =
        typechain.CanonicalTypeChainPhysicalTypeId(
            lowering, rhsTypeId)
    let rhsKind = typechain.CanonicalTypeChainLocalKind(
        lowering, rhsTypeId)
    let rhsScalarKind =
        lowering.typeArenaScalarKinds[rhsPhysicalTypeId]
    if rhsPhysicalTypeId != elemPhysicalTypeId &&
       !(elemKind == coreir.LocalI64Tag &&
         rhsKind == coreir.LocalI32Tag &&
         lowering.typeArenaStructuralKinds[rhsPhysicalTypeId] ==
             Int32(typearena.TypedExprStructuralTypeScalar) &&
         (rhsScalarKind ==
              Int32(typearena.TypedExprStructuralScalarInt) ||
          rhsScalarKind ==
              Int32(typearena.TypedExprStructuralScalarUInt) ||
          rhsScalarKind ==
              Int32(typearena.TypedExprStructuralScalarInt32) ||
          rhsScalarKind ==
              Int32(typearena.TypedExprStructuralScalarUInt32))):
        return false
    var headerOffset: int32
    var rootNodeIndex = containerNodeIndex
    var hopCount: int32
    while rootNodeIndex >= 0 &&
          rootNodeIndex < nodeCount &&
          lowering.typedIr.nodes2_opKinds[rootNodeIndex] ==
              texpr.TypedExprIrOpFieldGet:
        hopCount = hopCount + 1
        if hopCount > typedFn.nodeCount ||
           arenamod.ArenaArrayInt32Get(
               lowering.typedIr.arena,
               lowering.typedIr.nodes2_ownerStatementIndexes,
               rootNodeIndex) != statementRow:
            return false
        var ownerTypeId: int32
        var fieldTypeId: int32
        var fieldOffset: int32
        var fieldSize: int32
        var fieldAlign: int32
        typechain.CanonicalTypeChainFieldHop(
            lowering,
            rootNodeIndex,
            ownerTypeId,
            fieldTypeId,
            fieldOffset,
            fieldSize,
            fieldAlign)
        let parentNodeIndex = arenamod.ArenaArrayInt32Get(
            lowering.typedIr.arena,
            lowering.typedIr.nodes2_operand0NodeIndexs,
            rootNodeIndex)
        let parentTypeId = arenamod.ArenaArrayInt32Get(
            lowering.typedIr.arena,
            lowering.typedIr.nodes2_exactTypeArenaIds,
            parentNodeIndex)
        let fieldPhysicalTypeId =
            typechain.CanonicalTypeChainPhysicalTypeId(
                lowering, fieldTypeId)
        if ownerTypeId !=
               typechain.CanonicalTypeChainPhysicalTypeId(
                   lowering, parentTypeId) ||
           fieldTypeId != arenamod.ArenaArrayInt32Get(
               lowering.typedIr.arena,
               lowering.typedIr.nodes2_exactTypeArenaIds,
               rootNodeIndex) ||
           fieldSize != lowering.typeArenaSizeBytes[fieldPhysicalTypeId] ||
           headerOffset > 2147483647 - fieldOffset:
            return false
        headerOffset = headerOffset + fieldOffset
        if parentNodeIndex < 0 || parentNodeIndex >= rootNodeIndex:
            return false
        rootNodeIndex = parentNodeIndex
    if rootNodeIndex < 0 ||
       rootNodeIndex >= nodeCount ||
       (lowering.typedIr.nodes2_opKinds[rootNodeIndex] !=
            texpr.TypedExprIrOpLocalRef &&
        lowering.typedIr.nodes2_opKinds[rootNodeIndex] !=
            texpr.TypedExprIrOpParamRef) ||
       arenamod.ArenaArrayInt32Get(
           lowering.typedIr.arena,
           lowering.typedIr.nodes2_ownerStatementIndexes,
           rootNodeIndex) != statementRow:
        return false
    let bindingDefinitionRow =
        texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
            lowering.typedIr, rootNodeIndex)
    if bindingDefinitionRow < 0 ||
       bindingDefinitionRow >=
           texpr.TypedExprValueDefinitionAuthorityCount(
               lowering.typedIr) ||
       bindingDefinitionRow < typedFn.valueDefinitionStart ||
       bindingDefinitionRow >=
           typedFn.valueDefinitionStart + typedFn.valueDefinitionCount:
        return false
    let expectedOrigin =
        lowering.typedIr.nodes2_opKinds[rootNodeIndex] ==
                texpr.TypedExprIrOpParamRef ?
            texpr.TypedExprValueDefinitionOriginParameter :
            texpr.TypedExprValueDefinitionOriginBindingInitializer
    if texpr.TypedExprValueDefinitionOriginKindAt(
           lowering.typedIr, bindingDefinitionRow) != expectedOrigin:
        return false
    let rootTypeId = arenamod.ArenaArrayInt32Get(
        lowering.typedIr.arena,
        lowering.typedIr.nodes2_exactTypeArenaIds,
        rootNodeIndex)
    if texpr.TypedExprValueDefinitionExactTypeIdAt(
           lowering.typedIr, bindingDefinitionRow) != rootTypeId:
        return false
    let rootPhysicalTypeId =
        typechain.CanonicalTypeChainPhysicalTypeId(
            lowering, rootTypeId)
    let rootKind = typechain.CanonicalTypeChainLocalKind(
        lowering, rootTypeId)
    let rootSlot =
        coreir.BodyIRLocalSlotForBindingValueDefinitionRow(
            bodyIR, bindingProjection, bindingDefinitionRow)
    if rootSlot < 0 || rootSlot >= bodyIR.localSlots.len ||
       bodyIR.localSlots[rootSlot].typeArenaTypeId != rootTypeId ||
       bodyIR.localSlots[rootSlot].managedStorageKind !=
           (lowering.typedIr.nodes2_resultTypeManagedFlags[rootNodeIndex] ?
                coreir.BodyManagedStorageManagedTag :
                coreir.BodyManagedStorageUnmanagedTag) ||
       (PrimaryBodyIrSlotType(bodyIR, rootSlot) != rootKind &&
        !(PrimaryBodyIrSlotType(bodyIR, rootSlot) ==
              coreir.LocalPtrTag &&
          rootKind == coreir.LocalAggregateTag)) ||
       (PrimaryBodyIrSlotType(bodyIR, rootSlot) ==
            coreir.LocalAggregateTag &&
        PrimaryLocalSlotSizeOf(bodyIR.localSlots[rootSlot]) <
            lowering.typeArenaSizeBytes[rootPhysicalTypeId]):
        return false
    rootSlotOut = rootSlot
    headerOffsetOut = headerOffset
    elemKindOut = elemKind
    elemSizeOut = elemSize
    indexNodeOut = indexNodeIndex
    fixedArrayOut = containerKind ==
        Int32(typearena.TypedExprStructuralTypeFixedArray)
    return true

@borrows
fn PrimaryBodyIrVarArgIndexedFieldInfo(bodyIR: var coreir.BodyIR,
                                        slotNames: var str[],
                                        typedIr: texpr.TypedExprIr,
                                        argNodeIndex: int32,
                                        rootSlotOut: var int32,
                                        headerOffsetOut: var int32,
                                        elemSizeOut: var int32,
                                        indexNodeOut: var int32,
                                        fieldOffsetOut: var int32): bool =
    # `arr[i].field`（下标元素字段，var 聚合/seq 实参）：FieldGet 链的基是
    # IndexGet。真址 = buffer(arr) + i*elemSize + Σ内联字段偏移。仅每跳内联聚合
    # 才认（镜像 VarArgFieldPathInfo 的 hop 校验），经指针/ref 一跳即 miss
    # （poison-on-miss，不落穿弱路径读栈垃圾）。
    rootSlotOut = -1
    headerOffsetOut = 0
    elemSizeOut = 0
    indexNodeOut = -1
    fieldOffsetOut = 0
    if argNodeIndex < 0 || argNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        return false
    if typedIr.nodes2_opKinds[argNodeIndex] != texpr.TypedExprIrOpFieldGet ||
       arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldOffsetBytes, argNodeIndex) < 0 ||
       arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldSizeBytes, argNodeIndex) <= 0:
        return false
    var totalOffset = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldOffsetBytes, argNodeIndex)
    var hopIndex = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, argNodeIndex)
    # Same exact graph-walk invariant as VarArgFieldPathInfo: legal depth is
    # determined by the TypedIR path, while a repeated node fails closed.
    var visitedHopNodes: int32[]
    while hopIndex >= 0 && hopIndex < typedIr.nodes2_nodeIndexs.len &&
          typedIr.nodes2_opKinds[hopIndex] == texpr.TypedExprIrOpFieldGet:
        for visitedIndex in 0..<visitedHopNodes.len:
            if visitedHopNodes[visitedIndex] == hopIndex:
                return false
        add(visitedHopNodes, hopIndex)
        if arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldOffsetBytes, hopIndex) < 0 || arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldSizeBytes, hopIndex) <= 0:
            return false
        let vifSrcRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_sourcePathIds[hopIndex])
        let vifRtRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_resultTypeIds[hopIndex])
        if !IsOk(vifSrcRes) || !IsOk(vifRtRes):
            return false
        var hopKind: int32
        var hopSize: int32
        var hopAlign: int32
        PrimaryBodyIrTypeShapeFromText(typedIr,
                                       Value(vifSrcRes),
                                       Value(vifRtRes),
                                       hopKind,
                                       hopSize,
                                       hopAlign)
        if hopKind != coreir.LocalAggregateTag:
            return false
        if hopSize != arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldSizeBytes, hopIndex):
            return false
        totalOffset = totalOffset + arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_fieldOffsetBytes, hopIndex)
        hopIndex = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_operand0NodeIndexs, hopIndex)
    if hopIndex < 0 || hopIndex >= typedIr.nodes2_nodeIndexs.len:
        return false
    if typedIr.nodes2_opKinds[hopIndex] != texpr.TypedExprIrOpIndexGet:
        return false
    if !PrimaryBodyIrVarArgIndexInfo(bodyIR,
                                     slotNames,
                                     typedIr,
                                     hopIndex,
                                     rootSlotOut,
                                     headerOffsetOut,
                                     elemSizeOut,
                                     indexNodeOut):
        return false
    fieldOffsetOut = totalOffset
    return true

@borrows
fn PrimaryBodyIrNodeEvalProbe(bodyIR: var coreir.BodyIR,
                               slotNames: var str[],
                               varI32ParamNames: str[],
                               lowering: var lower.LoweringPlanStub,
                               typedFn: texpr.TypedExprIrFunction,
                               irFunction: lower.PrimaryObjectIrFunction,
                               nodeIndex: int32): int32 =
    if nodeIndex < 0 || nodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        return PrimaryBodyIrNodeEvalMissAt("bad_node_index")
    let npLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[nodeIndex])
    let npParamRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_paramNameIds[nodeIndex])
    let npRtRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[nodeIndex])
    let npSrcRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_sourcePathIds[nodeIndex])
    let npSurfRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_surfaceTextIds[nodeIndex])
    if !IsOk(npLitRes) || !IsOk(npParamRes) || !IsOk(npRtRes) || !IsOk(npSrcRes) || !IsOk(npSurfRes):
        return PrimaryBodyIrNodeEvalMissAt("intern_lookup")
    let npLit = Value(npLitRes)
    let npParam = Value(npParamRes)
    let npRt = Value(npRtRes)
    let npSrc = Value(npSrcRes)
    let npSurf = Value(npSurfRes)
    let opKind = lowering.typedIr.nodes2_opKinds[nodeIndex]
    let arithBinOpKind = PrimaryBodyIrNodeEvalArithBinOpResultKind(opKind)
    if arithBinOpKind != coreir.LocalInvalidTag:
        if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) < 0 || arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) >= lowering.typedIr.nodes2_nodeIndexs.len:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        if PrimaryBodyIrNodeEvalProbe(bodyIR,
                                      slotNames,
                                      varI32ParamNames,
                                      lowering,

                                      typedFn,
                                      irFunction,
                                      arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)) < 0:
            return -1
        if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex) < 0 || arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex) >= lowering.typedIr.nodes2_nodeIndexs.len:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        if PrimaryBodyIrNodeEvalProbe(bodyIR,
                                      slotNames,
                                      varI32ParamNames,
                                      lowering,

                                      typedFn,
                                      irFunction,
                                      arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex)) < 0:
            return -1
        if opKind == texpr.TypedExprIrOpI32Madd:
            if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand2NodeIndexs, nodeIndex) < 0 || arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand2NodeIndexs, nodeIndex) >= lowering.typedIr.nodes2_nodeIndexs.len:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            if PrimaryBodyIrNodeEvalProbe(bodyIR,
                                          slotNames,
                                          varI32ParamNames,
                                          lowering,

                                          typedFn,
                                          irFunction,
                                          arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand2NodeIndexs, nodeIndex)) < 0:
                return -1
        return arithBinOpKind
    if opKind == texpr.TypedExprIrOpI32Const:
        let probeConstVal = PrimaryBodyIrExtractIntFromText(npLit)
        if probeConstVal == 0 && !PrimaryBodyIrTextIsI32Zero(npLit):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        return coreir.LocalI32Tag
    if opKind == texpr.TypedExprIrOpI64Const:
        var probeConst64Val: int64
        if !PrimaryBodyIrExtractInt64FromText(npLit, probeConst64Val):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        return coreir.LocalI64Tag
    if opKind == texpr.TypedExprIrOpF64Const:
        if !PrimaryBodyIrTextIsF64Literal(npLit):
            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_f64_const_fail stage=probe function={typedFn.functionName} line={arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_lineNumbers, nodeIndex)} lit={npLit} surf={npSurf} rt={npRt}")
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        return coreir.LocalF64Tag
    if opKind == texpr.TypedExprIrOpBoolLit:
        return coreir.LocalI32Tag
    if opKind == texpr.TypedExprIrOpCharLit:
        if PrimaryBodyIrCharLiteralValue(npLit) < 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        return coreir.LocalI32Tag
    if opKind == texpr.TypedExprIrOpStrLit:
        if !PrimaryBodyIrTextIsStringLiteral(npLit):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        return coreir.LocalStrTag
    if opKind == texpr.TypedExprIrOpEmptySeqInit:
        return coreir.LocalAggregateTag
    if opKind == texpr.TypedExprIrOpSeqLiteral:
        let seqLitProbeElemSize = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena,
                                                              lowering.typedIr.nodes2_elemSizeBytes,
                                                              nodeIndex)
        var seqLitProbeExpectedKind: int32
        var seqLitProbeShapeSize: int32
        var seqLitProbeShapeAlign: int32
        PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                       npSrc,
                                       npLit,
                                       seqLitProbeExpectedKind,
                                       seqLitProbeShapeSize,
                                       seqLitProbeShapeAlign)
        let seqLitProbeI32 = seqLitProbeExpectedKind == coreir.LocalI32Tag &&
                             (seqLitProbeElemSize == 1 ||
                              seqLitProbeElemSize == 2 ||
                              seqLitProbeElemSize == 4)
        let seqLitProbeWide = (seqLitProbeExpectedKind == coreir.LocalI64Tag ||
                               seqLitProbeExpectedKind == coreir.LocalF64Tag) &&
                              seqLitProbeElemSize == 8
        let seqLitProbeStr = seqLitProbeExpectedKind == coreir.LocalStrTag &&
                             seqLitProbeElemSize == 24
        if seqLitProbeShapeSize <= 0 || seqLitProbeShapeAlign <= 0 ||
           (!seqLitProbeI32 && !seqLitProbeWide && !seqLitProbeStr):
            return PrimaryBodyIrNodeEvalMissAt("seq_literal_elem_shape")
        var seqLitProbeNodes: int32[]
        if !PrimaryBodyIrCollectArgLinkValueNodes(
            lowering.typedIr,
            arenamod.ArenaArrayInt32Get(lowering.typedIr.arena,
                                         lowering.typedIr.nodes2_operand0NodeIndexs,
                                         nodeIndex),
            seqLitProbeNodes):
            return PrimaryBodyIrNodeEvalMissAt("seq_literal_chain")
        for seqLitProbeIndex in 0..<seqLitProbeNodes.len:
            let seqLitProbeElemKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 lowering,

                                                                 typedFn,
                                                                 irFunction,
                                                                 seqLitProbeNodes[seqLitProbeIndex])
            if seqLitProbeElemKind < 0:
                return -1
            if seqLitProbeElemKind != seqLitProbeExpectedKind:
                return PrimaryBodyIrNodeEvalMissAt("seq_literal_elem_kind")
        if seqLitProbeNodes.len <= 0:
            return PrimaryBodyIrNodeEvalMissAt("seq_literal_empty")
        return coreir.LocalAggregateTag
    if opKind == texpr.TypedExprIrOpNilPtr:
        return coreir.LocalPtrTag
    if opKind == texpr.TypedExprIrOpAddrOf:
        # `&FunctionName` 取顶层函数符号地址：operand0 是 FuncRef 叶子，恒产
        # 8 字节函数入口指针（与 call-arg/EvalNode 同形）。
        if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) >= 0 &&
           arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) < lowering.typedIr.nodes2_nodeIndexs.len &&
           lowering.typedIr.nodes2_opKinds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)] == texpr.TypedExprIrOpFuncRef:
            return coreir.LocalPtrTag
        # `&place` 探针与结构化发射同门。标量根用 BodyLoadLocalAddress，
        # 聚合/指针根及字段路径用精确 base+offset；任一非法形直接拒绝。
        var probeAddrRootSlot: int32
        var probeAddrTotalOffset: int32
        if !PrimaryBodyIrAddrOfPlaceRootInfo(bodyIR,
                                             slotNames,
                                             lowering.typedIr,
                                             arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex),
                                             probeAddrRootSlot,
                                             probeAddrTotalOffset):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        return coreir.LocalPtrTag
    if opKind == texpr.TypedExprIrOpParamRef || opKind == texpr.TypedExprIrOpLocalRef:
        var probeRefName = npParam
        if probeRefName == "":
            probeRefName = strutil.Strip(npSurf)
        if probeRefName == "":
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let probeRefSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, probeRefName)
        if probeRefSlot < 0 || probeRefSlot >= bodyIR.localSlots.len:
            if opKind == texpr.TypedExprIrOpLocalRef:
                let probeGlobalType = PrimaryBodyIrTypedGlobalTypeExact(lowering.typedIr,
                                                                        npSrc,
                                                                        probeRefName)
                if probeGlobalType != "":
                    var probeGlobalKind: int32
                    var probeGlobalSize: int32
                    var probeGlobalAlign: int32
                    PrimaryBodyIrNodeTypeShape(lowering.typedIr,
                                               npSrc,
                                               probeGlobalType,
                                               probeGlobalKind,
                                               probeGlobalSize,
                                               probeGlobalAlign)
                    if probeGlobalKind == coreir.LocalI32Tag ||
                       probeGlobalKind == coreir.LocalI64Tag ||
                       probeGlobalKind == coreir.LocalPtrTag ||
                       probeGlobalKind == coreir.LocalStrTag ||
                       probeGlobalKind == coreir.LocalAggregateTag:
                        return probeGlobalKind
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        if PrimaryBodyIrNameInList(varI32ParamNames, probeRefName):
            return coreir.LocalI32Tag
        let probeRefPointee = PrimaryBodyIrVarParamPointeeKind(bodyIR, probeRefSlot)
        if probeRefPointee == coreir.LocalI64Tag:
            return coreir.LocalI64Tag
        if probeRefPointee == coreir.LocalI32Tag:
            return coreir.LocalI32Tag
        if probeRefPointee != coreir.LocalInvalidTag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        # var str 形参槽按源布局建成 Aggregate(24)+aux=Str（VarParamPointeeKind
        # 只认 Ptr 槽，故对其返回 Invalid）：槽存目的地址，值是其指向的 str。
        # EvalNode 对应分支经 FieldLoad 物化（与 var-str 赋值存路径同款协议），
        # 此处如实报 str 类型，避免 seq-literal/通用表达式因 str 元素探测失败而落
        # cold（bail_44）。
        if PrimaryBodyIrSlotType(bodyIR, probeRefSlot) == coreir.LocalAggregateTag &&
           bodyIR.localSlots[probeRefSlot].auxValue == coreir.LocalStrTag &&
           PrimaryBodyIrLocalIsParam(bodyIR.localSlots[probeRefSlot]):
            return coreir.LocalStrTag
        return PrimaryBodyIrSlotType(bodyIR, probeRefSlot)
    if opKind == texpr.TypedExprIrOpFieldGet:
        let probeFieldRootKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering,

                                                            typedFn,
                                                            irFunction,
                                                            arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex))
        if probeFieldRootKind < 0:
            return -1
        if probeFieldRootKind != coreir.LocalAggregateTag &&
           probeFieldRootKind != coreir.LocalPtrTag &&
           probeFieldRootKind != coreir.LocalStrTag:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_fieldOffsetBytes, nodeIndex) < 0 || arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_fieldSizeBytes, nodeIndex) <= 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        var probeFieldSize: int32
        let probeFieldKind = PrimaryBodyIrNodeEvalTypedSlotShape(lowering.typedIr,
                                                                 npSrc,
                                                                 texpr.TypedExprStripVarType(npRt),
                                                                 probeFieldSize)
        if probeFieldSize < arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_fieldSizeBytes, nodeIndex):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        return probeFieldKind
    if opKind == texpr.TypedExprIrOpIndexGet:
        if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) < 0 || arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex) >= lowering.typedIr.nodes2_nodeIndexs.len:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let probeIdxBaseRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)])
        if !IsOk(probeIdxBaseRes):
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        # form59 residual: hoist Value(Result[str]) before StripVarType
        let probeIdxBase_f59: str = Value(probeIdxBaseRes)
        let probeIdxBaseType = texpr.TypedExprStripVarType(probeIdxBase_f59)
        if probeIdxBaseType == "str":
            if PrimaryBodyIrNodeEvalProbe(bodyIR,
                                          slotNames,
                                          varI32ParamNames,
                                          lowering,

                                          typedFn,
                                          irFunction,
                                          arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)) != coreir.LocalStrTag:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            if PrimaryBodyIrNodeEvalProbe(bodyIR,
                                          slotNames,
                                          varI32ParamNames,
                                          lowering,

                                          typedFn,
                                          irFunction,
                                          arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex)) != coreir.LocalI32Tag:
                return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
            return coreir.LocalI32Tag
        if arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_elemSizeBytes, nodeIndex) <= 0:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let probeIdxIsDynamicSeq = PrimaryBodyIrTypeTextIsDynamicSeq(probeIdxBaseType)
        var probeIdxFixedArrayCtx: texpr.TypedExprSourceContext
        probeIdxFixedArrayCtx.sourcePath = typedFn.sourcePath
        let probeIdxIsFixedArray = texpr.TypedExprIrTypeTextIsFixedArray(probeIdxFixedArrayCtx, probeIdxBaseType)
        if !probeIdxIsDynamicSeq && !probeIdxIsFixedArray:
            return PrimaryBodyIrNodeEvalMissAt(texpr.TypedExprIrOpKindText(opKind))
        let probeIdxRootKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex))
        if probeIdxRootKind < 0:
            return -1
        if probeIdxRootKind != coreir.LocalAggregateTag &&
           probeIdxRootKind != coreir.LocalPtrTag:
