            var probeRcValueSize: int32
            var probeRcValueOffset: int32
            var probeRcErrCodeOffset: int32
            var probeRcErrMsgOffset: int32
            var probeRcTotalSize: int32
            if !PrimaryBodyIrResultConstructLayout(lowering.typedIr,
                                                   npSrc,
