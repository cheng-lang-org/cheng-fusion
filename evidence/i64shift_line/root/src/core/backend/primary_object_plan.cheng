            let probeLenArgKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                             slotNames,
                                                             varI32ParamNames,
                                                             lowering,

                                                             typedFn,
                                                             irFunction,
                                                             probeLenArgNode)
