                return PrimaryBodyIrNodeEvalMissAt("result_projection")
            return projectionResultKind
        if probeCallHead == "Value" || probeCallHead == "result.Value" ||
           probeCallHead == "IsOk" || probeCallHead == "result.IsOk" ||
           probeCallHead == "IsErr" || probeCallHead == "result.IsErr":
