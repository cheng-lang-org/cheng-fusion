        if probeCallHead == "Error" || probeCallHead == "result.Error":
            # Error 内征：纯 errmsg 投影（无 call、无 ordinal），单一聚合实参
            # 解析成功即降为 str；否则落回 call_special_head。
            # call-arg 臂：errmsg 偏移先解（镜像发射器），解不出即 miss；实参调用
            # 递归探针必产 Result[T] 聚合槽再投影 errmsg。
            let probeErrorArg = PrimaryBodyIrResultErrorArgNodeIndex(lowering.typedIr, nodeIndex)
            if probeErrorArg >= 0 && lowering.typedIr.nodes2_opKinds[probeErrorArg] == texpr.TypedExprIrOpCallExpr:
