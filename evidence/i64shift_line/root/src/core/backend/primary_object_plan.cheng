            add(loopBStk, forHdrBlk)
            add(loopCStk, pendingFalseTerm)
            add(loopFalseStartStk, loopFalsePool.len)
            add(loopBreakStartStk, pendingLoopBreakTerms.len)
            add(loopContinueStartStk, pendingLoopContinueTerms.len)
            add(loopSeqStk, constructSeq)
            constructSeq = constructSeq + 1
        elif stmt.kind == texpr.TypedExprIrStmtWhile:
            let whileStmtLineNumber = stmt.lineNumber
            let whileBodyEnd = PrimaryBodyIrBuildWhileLoopHeader(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 lowering,
                                                                 nextOpIndex,
                                                                 currentBlockStart,
                                                                 typedFn,
                                                                 irFunction,
                                                                 stmt,
                                                                 stmtIndex,
                                                                 stmtEnd,
                                                                 callOrdinal,
                                                                 pendingWhileHeaderBlock,
                                                                 pendingWhileCbrTerm,
                                                                 pendingWhileFalseTerms,
                                                                 callFeederEmittedIndexes)
            if pendingWhileCbrTerm >= 0:
                add(loopKindStk, 2)
                add(loopEndStk, whileBodyEnd)
                add(loopAStk, pendingWhileHeaderBlock)
                add(loopBStk, pendingWhileCbrTerm)
                add(loopCStk, whileStmtLineNumber)
                add(loopFalseStartStk, loopFalsePool.len)
                for wfi in 0..<pendingWhileFalseTerms.len:
                    add(loopFalsePool, pendingWhileFalseTerms[wfi])
                add(loopBreakStartStk, pendingLoopBreakTerms.len)
                add(loopContinueStartStk, pendingLoopContinueTerms.len)
                add(loopSeqStk, constructSeq)
                constructSeq = constructSeq + 1
            pendingWhileHeaderBlock = -1
            pendingWhileCbrTerm = -1
            pendingWhileFalseTerms = []
            # [bodyir-ownership-wall] 语句循环收尾探针（只读）：循环体最后一条语句之后、
            # `stmtIndex` 推进之前。与 `stmt_begin_{k+1}` 一起把"收尾写坏"与"下一条语句入场前写坏"
            # 分开。注意 `continue` 会跳过本探针（循环顶的 stmt_begin_k 不受影响，仍是主包夹）。
            primarySlotStageProbe(bodyIR, Fmt"stmt_end_{stmtIndex}", 57662)
    if PrimaryBodyIrNodeEvalOnlyActive():
        PrimaryBodyIrNodeEvalOnlyFlush(bodyIR)
    if bodyIR.debugProvenanceRequired:
        let _ = coreir.BodyIRDebugProvenanceSetSynthetic(
            bodyIR, coreir.BodyDebugSyntheticControlFlow)
    lower.LoweringBodyIrControlBindNewBlocks(
        bodyIR, controlCurrentScopeId)
    while loopKindStk.len > 0 ||
          ifEndStk.len > 0 ||
          controlDeferActive:
        var canCloseLoop2 = loopKindStk.len > 0
        var canCloseIf2 = ifEndStk.len > 0
        if controlDeferActive:
            if loopKindStk.len <= controlDeferLoopDepth:
                canCloseLoop2 = false
            if ifEndStk.len <= controlDeferIfDepth:
                canCloseIf2 = false
        if !canCloseLoop2 && !canCloseIf2:
            if !controlDeferActive:
                panic("primary body ir control: construct stack drift")
            PrimaryBodyIrControlFinishDeferAction(
                bodyIR,
                controlDeferSuiteScopeId,
                controlDeferSkipTermIndex,
                currentBlockStart)
            pendingFalseTerm =
                controlDeferSavedPendingFalseTerm
            pendingIfFalseBodyEnd =
                controlDeferSavedPendingIfFalseBodyEnd
            pendingCompoundFalseTerms = []
            for savedFalseTerm in
                    controlDeferSavedPendingCompoundFalseTerms:
                add(pendingCompoundFalseTerms, savedFalseTerm)
            controlDeferSavedPendingCompoundFalseTerms = []
            controlCurrentScopeId = controlDeferSavedScopeId
            controlDeferActive = false
            controlDeferOwnerStatementOrdinal = -1
            controlDeferSuiteScopeId = -1
            controlDeferSkipTermIndex = -1
            continue
        var closeIfTop2 = canCloseIf2
        if canCloseLoop2 && canCloseIf2 &&
           loopSeqStk[loopKindStk.len - 1] >
               ifSeqStk[ifEndStk.len - 1]:
            closeIfTop2 = false
        if closeIfTop2:
            PrimaryBodyIrCloseIfTop(bodyIR,
                                    currentBlockStart,
                                    ifEndStk,
                                    ifSeqStk,
                                    ifIndentStk,
                                    ifFalseStartStk,
                                    ifFalsePool,
                                    ifJoinStartStk,
                                    ifJoinBrPool)
            # See pre-statement cascade: once CloseIfTop binds the if's false
            # edge, the leftover continuation patch below must not re-target it.
            if pendingFalseTerm >= 0 &&
               pendingFalseTerm < bodyIR.terms.len &&
               bodyIR.terms[pendingFalseTerm].falseBlock >= 0:
                pendingFalseTerm = -1
                pendingCompoundFalseTerms = []
                pendingIfFalseBodyEnd = -1
        else:
            let closedLoopKind2 = PrimaryBodyIrCloseLoopTop(bodyIR,
                                                        slotNames,
                                                        nextOpIndex,
                                                        currentBlockStart,
                                                        loopKindStk,
                                                        loopEndStk,
                                                        loopAStk,
                                                        loopBStk,
                                                        loopCStk,
                                                        loopSeqStk,
                                                        loopFalseStartStk,
                                                        loopFalsePool,
                                                        loopBreakStartStk,
                                                        pendingLoopBreakTerms,
                                                        loopContinueStartStk,
                                                        pendingLoopContinueTerms,
                                                        controlLoopBackTermIndexes)
            if closedLoopKind2 == 1:
                pendingFalseTerm = -1
                pendingCompoundFalseTerms = []
    lower.LoweringBodyIrControlBindNewBlocks(
        bodyIR, controlCurrentScopeId)
    # leftover if-without-else whose then-body ran to the end of the statement
    # list with a closed then-block: point the false edge(s) at the upcoming
    # tail block. Open then-ops keep the previous merged-block behavior (a
    # forced close here would leave dangling edges past the function end).
    if pendingFalseTerm >= 0 && pendingIfFalseBodyEnd >= 0 &&
       bodyIR.ops.len == currentBlockStart:
        bodyIR.terms[pendingFalseTerm].falseBlock = bodyIR.blocks.len
        for pcti in 0..<pendingCompoundFalseTerms.len:
            if pendingCompoundFalseTerms[pcti] >= 0 &&
               pendingCompoundFalseTerms[pcti] < bodyIR.terms.len:
                bodyIR.terms[pendingCompoundFalseTerms[pcti]].falseBlock = bodyIR.blocks.len
        pendingCompoundFalseTerms = []
        pendingFalseTerm = -1
        pendingIfFalseBodyEnd = -1
    var primaryColdCond18: bool
    var primaryColdCond18Clause0: bool
    if bodyIR.blocks.len <= 0:
        if bodyIR.ops.len > currentBlockStart:
            primaryColdCond18Clause0 = true
        if strutil.Strip(typedFn.returnExpr) != "":
            primaryColdCond18Clause0 = true
    if primaryColdCond18Clause0:
        primaryColdCond18 = true
    if primaryColdCond18:
        var tailReturnText = strutil.Strip(typedFn.returnExpr)
        if PrimaryStartsWith(tailReturnText, "return "):
            tailReturnText = strutil.Strip(strings.SliceBytes(tailReturnText,
                                                              7,
                                                              len(tailReturnText) - 7))
        # T38C: 单行函数体糖三元 if-表达式尾返回(`fn f(v): T = if c: a else: b`,
        # 或已是 `?:` 形)——先尝试转 `?` 形, 命中就走真分支下降(见
        # PrimaryBodyIrAppendTailReturnTernaryValue 顶注), 不落到下面任何一条
        # 更弱的字面量/调用/标识符兜底分支。
        var tailTernaryText = strings.CloneStr(tailReturnText)
        if typedFn.returnType != "" && typedFn.returnType != "void" &&
           texpr.TypedExprFindTopLevelTextToken(tailTernaryText, "?") <= 0:
            let tailTernaryConverted = PrimaryBodyIrIfExprToTernaryText(tailTernaryText)
            if tailTernaryConverted != "":
                tailTernaryText = tailTernaryConverted
        if typedFn.returnType == "" || typedFn.returnType == "void":
            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                          currentBlockStart,
                                          -1,
                                          coreir.LocalInvalidTag,
                                          0,
                                          false)
        elif tailReturnText == "nil":
            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                          currentBlockStart,
                                          -1,
                                          coreir.LocalPtrTag,
                                          0,
                                          false)
        elif tailReturnText == "false":
            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                          currentBlockStart,
                                          -1,
                                          coreir.LocalI32Tag,
                                          0,
                                          true)
        elif tailReturnText == "true":
            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                          currentBlockStart,
                                          -1,
                                          coreir.LocalI32Tag,
                                          1,
                                          true)
        elif typedFn.returnType != "" && typedFn.returnType != "void" &&
             texpr.TypedExprFindTopLevelTextToken(tailTernaryText, "?") > 0:
            PrimaryBodyIrAppendTailReturnTernaryValue(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      lowering,

                                                      typedFn,
                                                      irFunction,
                                                      tailTernaryText,
                                                      callOrdinal,
                                                      currentBlockStart)
        else:
            let tailConstVal = PrimaryBodyIrExtractIntFromText(tailReturnText)
            if tailConstVal != 0 || PrimaryBodyIrTextIsI32Zero(tailReturnText):
                PrimaryBodyIrAppendReturnTerm(bodyIR,
                                              currentBlockStart,
                                              -1,
                                              coreir.LocalI32Tag,
                                              tailConstVal,
                                              true)
            elif PrimaryBodyIrTextHasCallSurface(tailReturnText):
                # Owned override copy: must not move let typedFn (still live below).
                var tailReturnFn = texpr.TypedExprIrFunction(
                    sourcePath: strings.CloneStr(typedFn.sourcePath),
                    functionName: strings.CloneStr(typedFn.functionName),
                    returnType: strings.CloneStr(typedFn.returnType),
                    resultExprClass: typedFn.resultExprClass,
                    returnExpr: strings.CloneStr(tailReturnText),
                    signatureLineNumber: typedFn.signatureLineNumber,
                    endLineNumber: typedFn.endLineNumber,
                    bodyLineNumber: typedFn.bodyLineNumber,
                    statementStart: typedFn.statementStart,
                    statementCount: typedFn.statementCount,
                    nodeStart: typedFn.nodeStart,
                    nodeCount: typedFn.nodeCount,
                    returnNodeIndex: typedFn.returnNodeIndex,
                    valueDefinitionStart: typedFn.valueDefinitionStart,
                    valueDefinitionCount: typedFn.valueDefinitionCount,
                )
                let tailReturnExprNode = PrimaryBodyIrFunctionTailExprNode(irFunction)
                if !PrimaryBodyIrAppendReturnCallCompareZero(bodyIR,
                                                             slotNames,
                                                             lowering,

                                                             tailReturnFn,
                                                             irFunction,
                                                             varI32ParamNames,
                                                             tailReturnText,
                                                             irFunction.bodyLineNumber,
                                                             tailReturnExprNode,
                                                             currentBlockStart,
                                                             callOrdinal):
                    let tailReturnCallNode = PrimaryBodyIrFunctionTailCallNode(lowering.typedIr,
                                                                               irFunction)
                    var tailReturnLowered = PrimaryBodyIrAppendReturnWholeCall(bodyIR,
                                                                               slotNames,
                                                                               lowering,

                                                                               tailReturnFn,
                                                                               irFunction,
                                                                               varI32ParamNames,
                                                                               tailReturnCallNode,
                                                                               currentBlockStart,
                                                                               callOrdinal)
                    if !tailReturnLowered:
                        tailReturnLowered = PrimaryBodyIrAppendReturnAggregateConstructor(bodyIR,
                                                                                         slotNames,
                                                                                         varI32ParamNames,
                                                                                         lowering,

                                                                                         tailReturnFn,
                                                                                         irFunction,
                                                                                         tailReturnText,
                                                                                         tailReturnExprNode,
                                                                                         currentBlockStart,
                                                                                         callOrdinal)
            else:
                var tailReturnTypeKind: int32
                var tailReturnTypeSizeBytes: int32
                var tailReturnTypeAlignBytes: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               typedFn.sourcePath,
                                               typedFn.returnType,
                                               tailReturnTypeKind,
                                               tailReturnTypeSizeBytes,
                                               tailReturnTypeAlignBytes)
                var tailReturnSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, tailReturnText)
                if tailReturnSlot < 0 && tailReturnText != "":
                    tailReturnSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                        slotNames,
                                                                        lowering.typedIr,
                                                                        typedFn.sourcePath,
                                                                        tailReturnText,
                                                                        typedFn.returnType)
                if tailReturnSlot >= 0:
                    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                  currentBlockStart,
                                                  tailReturnSlot,
                                                  tailReturnTypeKind,
                                                  0,
                                                  false)
    if bodyIR.debugProvenanceRequired:
        let _ = coreir.BodyIRDebugProvenanceSetSynthetic(
            bodyIR, coreir.BodyDebugSyntheticControlFlow)
    var voidTailNeedsReturn = false
    var nonVoidJoinLanding = false
    if PrimaryBodyIrReturnTypeIsVoid(typedFn.returnType):
        if bodyIR.ops.len > currentBlockStart:
            voidTailNeedsReturn = true
        elif bodyIR.terms.len <= 0:
            voidTailNeedsReturn = true
        elif bodyIR.terms[bodyIR.terms.len - 1].kind != coreir.BodyTermReturnTag:
            # Loop exits and if joins point one past the last block; give
            # them a real landing block.
            voidTailNeedsReturn = true
    elif bodyIR.ops.len > currentBlockStart:
        # Non-void-returning function whose last statement is a bare call to
        # a diverging helper (e.g. panic) with no explicit return. The tail
        # closing logic above only fires for functions declared void; check
        # the callee's own name here (not typedFn.returnType, which is the
        # caller's) so this branch stays unreachable for functions already
        # handled above.
        let lastOp = bodyIR.ops[bodyIR.ops.len - 1]
        if lastOp.kind == coreir.BodyOpCallTag && lastOp.operands.len > 0:
            let tailCallOrdinal = lastOp.operands[0]
            if tailCallOrdinal >= 0 && tailCallOrdinal < bodyIR.callSequence.len:
                if PrimaryCallTargetTailName(bodyIR.callSequence[tailCallOrdinal].targetSymbol) == "panic":
                    voidTailNeedsReturn = true
    elif bodyIR.terms.len > 0 &&
         bodyIR.terms[bodyIR.terms.len - 1].kind != coreir.BodyTermReturnTag:
        # Non-void twin of the void join-landing above. CloseIfTop / leftover
        # if-without-else patches false (and the then→join BR) to
        # bodyIR.blocks.len expecting a subsequent landing block. For void
        # that landing is the void return just above; for non-void it was
        # missing, so OOB false fallthrough executed the then-body
        # (false observationally equal to true) — w16 trailing-|| defect
        # (docs/s2-feed-core-build-wall-20260708.md:238,241).
        for joinTi in 0..<bodyIR.terms.len:
            let joinTerm = bodyIR.terms[joinTi]
            if joinTerm.kind != coreir.BodyTermCbrTag &&
               joinTerm.kind != coreir.BodyTermBrTag:
                continue
            if joinTerm.trueBlock == bodyIR.blocks.len ||
               joinTerm.falseBlock == bodyIR.blocks.len:
                nonVoidJoinLanding = true
                break
    if voidTailNeedsReturn:
        PrimaryBodyIrAppendReturnTerm(bodyIR,
                                      currentBlockStart,
                                      -1,
                                      coreir.LocalInvalidTag,
                                      0,
                                      false)
    elif nonVoidJoinLanding:
        let landingRetType = texpr.TypedExprNormalizeTypeText(typedFn.returnType)
        if landingRetType == "bool" ||
           landingRetType == "int32" ||
           landingRetType == "int" ||
           landingRetType == "char":
            # Success/fallthrough epilogue: return 0 / false. Matches the
            # truncated-check shape (`if a||b||c: return N` with no later
            # `return 0` — false path must not take then).
            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                          currentBlockStart,
                                          -1,
                                          coreir.LocalI32Tag,
                                          0,
                                          true)
        elif landingRetType == "int64":
            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                          currentBlockStart,
                                          -1,
                                          coreir.LocalI64Tag,
                                          0,
                                          false)
        else:
            # Aggregates / unknown: refuse silent zero; keep plan loud.
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         irFunction.signatureLineNumber,
                                         int32(texpr.TypedExprIrStmtUnsupported),
                                         94,
                                         bodyIR.blocks.len)
    if bodyIR.ops.len > currentBlockStart:
        if bodyIR.blocks.len <= 0:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         irFunction.signatureLineNumber,
                                         int32(texpr.TypedExprIrStmtUnsupported),
                                         91,
                                         bodyIR.ops.len)
            var missingTerm: coreir.BodyTerm
            missingTerm.kind = coreir.BodyTermInvalidTag
            missingTerm.resultSlot = -1
            # Invalid reads no guard slot: pin lhs/rhs to -1 so the phantom slot-0 default
            # never feeds the terminator poison nor the body-wide slot read counts (mirrors
            # the Return root fix).
            missingTerm.lhsSlot = -1
            missingTerm.rhsSlot = -1
            let missingTermIndex = coreir.BodyIRAppendTerm(bodyIR, missingTerm)
            let _ = coreir.BodyIRAppendBlock(bodyIR, 0, bodyIR.ops.len, missingTermIndex)
        else:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         irFunction.signatureLineNumber,
                                         int32(texpr.TypedExprIrStmtUnsupported),
                                         92,
                                         bodyIR.ops.len - currentBlockStart)
            let remainingOpCount = bodyIR.ops.len - currentBlockStart
            if remainingOpCount > 0:
                var remainTerm: coreir.BodyTerm
                remainTerm.kind = coreir.BodyTermInvalidTag
                remainTerm.resultSlot = -1
                # Invalid reads no guard slot: pin lhs/rhs to -1 (mirrors the Return root fix).
                remainTerm.lhsSlot = -1
                remainTerm.rhsSlot = -1
                let remainTermIndex = coreir.BodyIRAppendTerm(bodyIR, remainTerm)
                let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, remainingOpCount, remainTermIndex)
    for ti in 0..<bodyIR.terms.len:
        let t = bodyIR.terms[ti]
        if t.kind == coreir.BodyTermCbrTag:
            if t.trueBlock < 0:
                if t.falseBlock < 0:
                    bodyIR.terms[ti].trueBlock = ti + 1
                    if ti + 2 < bodyIR.terms.len:
                        bodyIR.terms[ti].falseBlock = ti + 2
                    else:
                        bodyIR.terms[ti].falseBlock = ti + 1
                    # Refuse false==true collapse from term-index fallback
                    # (trailing multi-|| if: last CBR's ti+1 is the then-block).
                    if bodyIR.terms[ti].falseBlock == bodyIR.terms[ti].trueBlock:
                        if bodyIR.blocks.len > 0 &&
                           bodyIR.blocks.len - 1 != bodyIR.terms[ti].trueBlock:
                            bodyIR.terms[ti].falseBlock = bodyIR.blocks.len - 1
                        else:
                            bodyIR.terms[ti].falseBlock = -1
                else:
                    bodyIR.terms[ti].trueBlock = ti + 1
            else:
                if t.falseBlock < 0:
                    var falseCand: int32
                    if ti + 2 < bodyIR.terms.len:
                        falseCand = ti + 2
                    elif ti + 1 < bodyIR.terms.len:
                        falseCand = ti + 1
                    else:
                        falseCand = ti
                    if falseCand == bodyIR.terms[ti].trueBlock:
                        if bodyIR.blocks.len > 0 &&
                           bodyIR.blocks.len - 1 != bodyIR.terms[ti].trueBlock:
                            falseCand = bodyIR.blocks.len - 1
                        else:
                            falseCand = -1
                    bodyIR.terms[ti].falseBlock = falseCand
    if bodyIR.blocks.len <= 0:
        if typedFn.returnType != "" && typedFn.returnType != "void":
            if !PrimaryBodyIrAppendReturnWholeCall(bodyIR,
                                                   slotNames,
                                                   lowering,

                                                   typedFn,
                                                   irFunction,
                                                   varI32ParamNames,
                                                   PrimaryBodyIrFunctionTailCallNode(lowering.typedIr,
                                                                                       irFunction),
                                                   currentBlockStart,
                                                   callOrdinal):
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             irFunction.signatureLineNumber,
                                             int32(texpr.TypedExprIrStmtUnsupported),
                                             93,
                                             0)
                var emptyMissingTerm: coreir.BodyTerm
                emptyMissingTerm.kind = coreir.BodyTermInvalidTag
                emptyMissingTerm.resultSlot = -1
                # Invalid reads no guard slot: pin lhs/rhs to -1 (mirrors the Return root fix).
                emptyMissingTerm.lhsSlot = -1
                emptyMissingTerm.rhsSlot = -1
                let emptyMissingTermIndex = coreir.BodyIRAppendTerm(bodyIR, emptyMissingTerm)
                let _ = coreir.BodyIRAppendBlock(bodyIR,
                                                 currentBlockStart,
                                                 bodyIR.ops.len - currentBlockStart,
                                                 emptyMissingTermIndex)
        else:
            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                          currentBlockStart,
                                          -1,
                                          coreir.LocalInvalidTag,
                                          0,
                                          false)
    lower.LoweringBodyIrControlBindNewBlocks(
        bodyIR, controlCurrentScopeId)
    # 合成运行时调用（fmt join/str concat 桥、puts、seq grow、alloc/zero、
    # f64↔i64 trunc、str release、ptr_plus/deref synth 等）不是用户 call 位：
    # 它们直接 append 进 callSequence，没有 canonical snapshot CallId 行，
    # 因此不经过 append 时点的 canonical 绑定（用户 call 位在 :26682 append
    # 后立刻 PrimaryBodyIrControlBindCanonicalCallTarget，canonical miss 即
    # panic，绝不会成为残余行）。守卫前把每个残余行按其精确
    # (targetSymbol, 传递形, TypeArena artifact) 身份绑定为 runtime
    # intrinsic —— 与 entry bridge 的 runtime call 绑定同一契约形态
    # （coreir.BodyIRControlFlowBindCallTarget），seal 时 canonicalize 并
    # 强制 same-row ⟺ same-cid。守卫本身零改动。
    PrimaryBodyIrControlBindResidualSyntheticCallTargetsInto(bodyIR, 0)
    if bodyIR.callTargetDomainKinds.len !=
           bodyIR.callSequence.len ||
       bodyIR.callTargetRows.len !=
           bodyIR.callSequence.len ||
       bodyIR.callTargetInterfaceCids.len !=
           bodyIR.callSequence.len:
        panic("primary body ir control: exact call target coverage missing")
    lower.LoweringBodyIrControlSeal(
        bodyIR,
        share(irFunction.deferScopeTransport),
        controlBreakTermIndexes,
        controlContinueTermIndexes,
        controlLoopBackTermIndexes)
    if os.GetEnv("CHENG_X64_DBG2") != "" && bodyIR.ops.len <= 0 && stmtEnd > 100:
        os.WriteLine(os.GetStderr(), Fmt"x64dbg2 EMPTY_BODYIR fn={typedFn.functionName} stmts={stmtEnd} ops={bodyIR.ops.len} blocks={bodyIR.blocks.len} terms={bodyIR.terms.len} slots={bodyIR.localSlots.len}")
    return bodyIR


@borrows
fn PrimaryCStringLiteralDataLabel(functionSymbol: str,
                                  callOrdinal: int32): str =
    return strutil.Join([
        strings.CloneStr(functionSymbol),
        "__cheng_cstring_",
        strings.IntToStr(callOrdinal)
    ], "")

@borrows
fn PrimaryReturnStrLiteralDataLabel(functionSymbol: str): str =
    return strutil.Join([
        strings.CloneStr(functionSymbol),
        "__cheng_return_str_literal"
    ], "")

@borrows
fn PrimaryStatementSequenceReturnMode(bodyKind: str): int32 =
    if PrimaryIsLetCallNoargReturnI32ConstBodyKind(bodyKind):
        return PrimaryStatementReturnModeI32Const()
    return PrimaryStatementReturnModeNone()

@borrows
fn PrimaryStatementSequenceI32Value(bodyKind: str): int32 =
    if PrimaryIsLetCallNoargReturnI32ConstBodyKind(bodyKind):
        let prefix = texpr.BodyKindLetCallNoargReturnI32ConstPrefix
        let raw = strings.SliceBytes(bodyKind, len(prefix), len(bodyKind) - len(prefix))
        return int32(strutil.ParseInt(raw))
    return 0

@borrows
fn PrimaryPlanBodyKind(bodyKind: str): str =
    if PrimaryStatementSequenceReturnMode(bodyKind) != PrimaryStatementReturnModeNone():
        return texpr.BodyKindStatementSequence
    if PrimaryStartsWith(bodyKind, "stmt_"):
        return texpr.BodyKindStatementSequence
    return bodyKind

fn PrimaryBodyKindCallIndirectVoidBridge(): str =
    return "runtime_call_indirect_void_bridge"

fn PrimaryBodyKindCallIndirectI32Bridge(): str =
    return "runtime_call_indirect_i32_bridge"

fn PrimaryBodyKindCallIndirectSretAgg1Bridge(): str =
    return "runtime_call_indirect_sret_agg1_bridge"

@borrows
fn PrimarySpecialExportBodyKindForFunction(lowering: var lower.LoweringPlanStub,
                                            functionIndex: int32): str =
    if functionIndex < 0 || functionIndex >= lowering.functionExportSymbolNames.len:
        return ""
    let exportName = lowering.functionExportSymbolNames[functionIndex]
    if exportName == "__cheng_call_indirect_void":
        return PrimaryBodyKindCallIndirectVoidBridge()
    if exportName == "__cheng_call_indirect_i32":
        return PrimaryBodyKindCallIndirectI32Bridge()
    if exportName == "__cheng_call_indirect_sret_agg1":
        return PrimaryBodyKindCallIndirectSretAgg1Bridge()
    return ""

fn PrimaryObjectPlanRegallocCallIndirectBridgeBodyIr(
        bodyKind: str,
        typeArenaArtifactCid: layout.FixedBytes32): coreir.BodyIR =
    var bodyIR = coreir.BodyIRNew()
    if !coreir.BodyIRBindTypeArenaArtifactCid(
           bodyIR, typeArenaArtifactCid):
        panic("primary regalloc bridge: TypeArena artifact CID missing")
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    if bodyKind == PrimaryBodyKindCallIndirectVoidBridge():
        PrimaryBodyIrLocalSlotNewSized(
            bodyIR, 0, "__bridge_fn", coreir.LocalPtrTag, 8, 8)
        PrimaryBodyIrMarkParamSlot(bodyIR, 0, 0)
        PrimaryBodyIrLocalSlotNewSized(
            bodyIR, 1, "__bridge_ctx", coreir.LocalPtrTag, 8, 8)
        PrimaryBodyIrMarkParamSlot(bodyIR, 1, 1)
        call.targetSymbol = "cheng_call_ptr_void_raw"
        call.resultSlot = -1
        call.resultPassKind = coreir.BodyCallPassStackValueTag
        add(call.argSlots, 0)
        add(call.argSlots, 1)
        add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
        add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 8)
        add(call.argAbiSizes, 8)
    elif bodyKind == PrimaryBodyKindCallIndirectI32Bridge():
        PrimaryBodyIrLocalSlotNewSized(
            bodyIR, 0, "__bridge_fn", coreir.LocalPtrTag, 8, 8)
        PrimaryBodyIrMarkParamSlot(bodyIR, 0, 0)
        PrimaryBodyIrLocalSlotNewSized(
            bodyIR, 1, "__bridge_ctx", coreir.LocalI64Tag, 8, 8)
        PrimaryBodyIrMarkParamSlot(bodyIR, 1, 1)
        PrimaryBodyIrLocalSlotNewSized(
            bodyIR, 2, "__bridge_arg0", coreir.LocalI32Tag, 4, 4)
        PrimaryBodyIrMarkParamSlot(bodyIR, 2, 2)
        PrimaryBodyIrLocalSlotNewSized(
            bodyIR, 3, "__bridge_arg1", coreir.LocalI32Tag, 4, 4)
        PrimaryBodyIrMarkParamSlot(bodyIR, 3, 3)
        PrimaryBodyIrLocalSlotNewSized(
            bodyIR, 4, "__bridge_result", coreir.LocalI32Tag, 4, 4)
        call.targetSymbol = "cheng_call_ptr_i32_raw"
        call.resultSlot = 4
        call.resultPassKind = coreir.BodyCallPassStackValueTag
        for argIndex in 0..<4:
            add(call.argSlots, argIndex)
            add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 8)
        add(call.argAbiSizes, 8)
        add(call.argAbiSizes, 4)
        add(call.argAbiSizes, 4)
    elif bodyKind == PrimaryBodyKindCallIndirectSretAgg1Bridge():
        PrimaryBodyIrLocalSlotNewSized(
            bodyIR, 0, "__bridge_fn", coreir.LocalPtrTag, 8, 8)
        PrimaryBodyIrMarkParamSlot(bodyIR, 0, 0)
        PrimaryBodyIrLocalSlotNewSized(
            bodyIR, 1, "__bridge_arg0", coreir.LocalPtrTag, 8, 8)
        PrimaryBodyIrMarkParamSlot(bodyIR, 1, 1)
        call.targetSymbol = "cheng_call_ptr_sret_agg1_raw"
        call.resultSlot = -1
        call.resultPassKind =
            coreir.BodyCallPassForwardEntrySretTag
        add(call.argSlots, 0)
        add(call.argSlots, 1)
        add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
        add(call.argPassKinds, coreir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 8)
        add(call.argAbiSizes, 8)
    else:
        return bodyIR
    let resultSlot = call.resultSlot
    add(bodyIR.callSequence, call)
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    op.target = resultSlot
    add(op.operands, 0)
    let _ = coreir.BodyIRAppendOp(bodyIR, op)
    var term: coreir.BodyTerm
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = resultSlot
    let termIndex = coreir.BodyIRAppendTerm(bodyIR, term)
    let _ = coreir.BodyIRAppendBlock(bodyIR, 0, 1, termIndex)
    bodyIR.entryIsCAbi = true
    PrimaryBodyIrReflowLocalStackOffsets(bodyIR)
    return bodyIR

@borrows
fn PrimaryBodyKindSupportedByX64Text(bodyKind: str): bool =
    # Special body kinds the x86_64 text emitter can emit directly; everything
    # else must lower through the generic BodyIR statement path.
    if bodyKind == texpr.BodyKindStatementSequence:
        return true
    if bodyKind == texpr.BodyKindReturnVoid:
        return true
    if bodyKind == texpr.BodyKindReturnF64MulArgs:
        return true
    if bodyKind == texpr.BodyKindReturnF64Arg0 ||
       bodyKind == texpr.BodyKindReturnF64FromI32Arg0 ||
       bodyKind == texpr.BodyKindReturnF64FromI64Arg0:
        return true
    if bodyKind == texpr.BodyKindReturnI64Arg0:
        return true
    if bodyKind == texpr.BodyKindReturnI64FromI32Arg0:
        return true
    if texpr.TypedExprIsReturnCallBodyKind(bodyKind):
        return true
    if bodyKind == texpr.BodyKindEntryBridge:
        return true
    if bodyKind == texpr.BodyKindRuntimeSetCmdLine ||
       bodyKind == texpr.BodyKindRuntimeParamCount ||
       bodyKind == texpr.BodyKindRuntimeParamStrCopyBridge:
        return true
    if bodyKind == texpr.BodyKindStrLenFastI32:
        return true
    return false

@borrows
fn PrimaryFunctionWordCountForBodyKind(bodyKind: str): int32 =
    if bodyKind == PrimaryBodyKindCallIndirectVoidBridge():
        return 3
    if bodyKind == PrimaryBodyKindCallIndirectI32Bridge():
        return 5
    if bodyKind == PrimaryBodyKindCallIndirectSretAgg1Bridge():
        return 3
    if bodyKind == texpr.BodyKindReturnVoid:
        return 1
    if texpr.TypedExprIsReturnCallBodyKind(bodyKind):
        return 2
    if PrimaryIsLetCallNoargReturnI32ConstBodyKind(bodyKind):
        return 0
    if bodyKind == texpr.BodyKindReturnI64Arg0:
        return 1
    if bodyKind == texpr.BodyKindReturnI64FromI32Arg0:
        return 2
    if bodyKind == texpr.BodyKindReturnBoolI32Arg0Range0To31:
        return 3
    if bodyKind == texpr.BodyKindReturnStrEmpty:
        return 4
    if bodyKind == texpr.BodyKindCstringToStrCopy:
        return 32
    if bodyKind == texpr.BodyKindIfArg0LeZeroReturnI32Const0ElseI32Const7:
        return 6
    if bodyKind == texpr.BodyKindReturnF64MulArgs:
        return 2
    if bodyKind == texpr.BodyKindReturnF64Arg0:
        return 1
    if bodyKind == texpr.BodyKindReturnF64FromI32Arg0 ||
       bodyKind == texpr.BodyKindReturnF64FromI64Arg0:
        return 2
    if bodyKind == texpr.BodyKindStrLenFastI32:
        return 8
    if bodyKind == texpr.BodyKindMainF64MulCheckExit:
        return 22
    if bodyKind == texpr.BodyKindRuntimeSetCmdLine:
        return 7
    if bodyKind == texpr.BodyKindRuntimeParamCount:
        return 6
    if bodyKind == texpr.BodyKindRuntimeParamStrCopyBridge:
        return 35
    return 0

@borrows
fn PrimaryObjectPlanAppendEntryBridgeRelocs(state: var PrimaryObjectPlanPhaseState,
                                             linkPlan: slplan.SystemLinkPlanStub,
                                             itemId: int32,
                                             wordOffset: int32) =
    add(state.relocSourceItemIds, itemId)
    add(state.relocWordOffsets, wordOffset + 3)
    add(state.relocTargetSymbols, PrimaryTargetSymbolName(linkPlan.targetTriple, "__cheng_setCmdLine"))
    add(state.relocCallOrdinal, 0)
    primaryObjectPlanAppendInvalidCallRelocIdentity(state)
    add(state.relocSourceItemIds, itemId)
    add(state.relocWordOffsets, wordOffset + 6)
    add(state.relocTargetSymbols, PrimaryTargetSymbolName(linkPlan.targetTriple, "cheng_native_register_line_map_from_argv0"))
    add(state.relocCallOrdinal, 1)
    primaryObjectPlanAppendInvalidCallRelocIdentity(state)
    add(state.relocSourceItemIds, itemId)
    add(state.relocWordOffsets, wordOffset + 8)
    add(state.relocTargetSymbols, share(state.entryFunctionSymbol))
    add(state.relocCallOrdinal, 2)
    primaryObjectPlanAppendInvalidCallRelocIdentity(state)
    add(state.relocSourceItemIds, itemId)
    add(state.relocWordOffsets, wordOffset + 12)
    add(state.relocTargetSymbols, PrimaryTargetSymbolName(linkPlan.targetTriple, "cheng_debug_profile_flush_from_argv0"))
    add(state.relocCallOrdinal, 3)
    primaryObjectPlanAppendInvalidCallRelocIdentity(state)

@borrows
fn PrimaryBodyIRLoadSlotToRegBiased(words: var int32[],
                                     offset: int32,
                                     bodyIR: coreir.BodyIR,
                                     slotIndex: int32,
                                     reg: int32,
                                     frameBytes: int32,
                                     paramSaveOffset: int32,
                                     paramSaveCount: int32,
                                     spBias: int32): int32 =
    if offset < 0 || offset >= words.len:
        return -1
    var stackOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                   slotIndex,
                                                   frameBytes,
                                                   paramSaveOffset,
                                                   paramSaveCount)
    if stackOffset < 0:
        return -1
    stackOffset = PrimaryBodyIrCheckedStackOffsetAdd(stackOffset, spBias)
    let slotType = PrimaryBodyIrSlotType(bodyIR, slotIndex)
    if slotType == coreir.LocalI32Tag:
        let slot = bodyIR.localSlots[slotIndex]
        if PrimaryDarwinPackedStackArgsActive() &&
           PrimaryBodyIrLocalIsParam(slot) &&
           PrimaryBodyIrParamIndex(slot) >= 8 &&
           PrimaryParamSlotAbiSize(slot) == 1:
            # packed bool stack param: only one byte is defined at the slot
            return PrimaryBodyIRLoadStackOffsetToReg(words, offset, reg, stackOffset, 1)
        return PrimaryBodyIRLoadStackOffsetToReg(words, offset, reg, stackOffset, 4)
    if slotType == coreir.LocalI64Tag ||
       slotType == coreir.LocalPtrTag ||
       slotType == coreir.LocalF64Tag:
        # f64 values travel as raw bits in X registers; the float ABI
        # boundary (d0 return) adds an fmov at the return fill
        return PrimaryBodyIRLoadStackOffsetToReg(words, offset, reg, stackOffset, 8)
    if slotType == coreir.LocalStrTag ||
       slotType == coreir.LocalAggregateTag:
        if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotIndex]):
            return PrimaryBodyIRLoadStackOffsetToReg(words, offset, reg, stackOffset, 8)
        return a64units.CodegenA64BodyFillStackAddressToReg(words, offset, reg, stackOffset)
    return -1

@borrows
fn PrimaryBodyIRLoadSlotToReg(words: var int32[],
                               offset: int32,
                               bodyIR: coreir.BodyIR,
                               slotIndex: int32,
                               reg: int32,
                               frameBytes: int32,
                               paramSaveOffset: int32,
                               paramSaveCount: int32): int32 =
    return PrimaryBodyIRLoadSlotToRegBiased(words,
                                            offset,
                                            bodyIR,
                                            slotIndex,
                                            reg,
                                            frameBytes,
                                            paramSaveOffset,
                                            paramSaveCount,
                                            0)

@borrows
fn PrimaryBodyIRStoreRegToSlot(words: var int32[],
                                offset: int32,
                                bodyIR: coreir.BodyIR,
                                slotIndex: int32,
                                reg: int32,
                                frameBytes: int32,
                                paramSaveOffset: int32,
                                paramSaveCount: int32): int32 =
    if offset < 0 || offset >= words.len:
        return -1
    let stackOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                   slotIndex,
                                                   frameBytes,
                                                   paramSaveOffset,
                                                   paramSaveCount)
    if stackOffset < 0:
        return -1
    let slotType = PrimaryBodyIrSlotType(bodyIR, slotIndex)
    if slotType == coreir.LocalI32Tag:
        let slot = bodyIR.localSlots[slotIndex]
        if PrimaryDarwinPackedStackArgsActive() &&
           PrimaryBodyIrLocalIsParam(slot) &&
           PrimaryBodyIrParamIndex(slot) >= 8 &&
           PrimaryParamSlotAbiSize(slot) == 1:
            # packed bool stack param: storing 4 bytes would clobber neighbors
            return PrimaryBodyIRStoreRegToStackOffset(words, offset, reg, a64units.CodegenA64X12, stackOffset, 1)
        return PrimaryBodyIRStoreRegToStackOffset(words, offset, reg, a64units.CodegenA64X12, stackOffset, 4)
    if slotType == coreir.LocalI64Tag ||
       slotType == coreir.LocalPtrTag ||
       slotType == coreir.LocalF64Tag:
        return PrimaryBodyIRStoreRegToStackOffset(words, offset, reg, a64units.CodegenA64X12, stackOffset, 8)
    return -1

@borrows
fn PrimaryBodyIRLoadStrValueAddressToReg(words: var int32[],
                                          offset: int32,
                                          bodyIR: coreir.BodyIR,
                                          slotIndex: int32,
                                          reg: int32,
                                          frameBytes: int32,
                                          paramSaveOffset: int32,
                                          paramSaveCount: int32): int32 =
    if offset < 0 || offset >= words.len:
        return -1
    if PrimaryBodyIrSlotType(bodyIR, slotIndex) != coreir.LocalStrTag:
        return -1
    let stackOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                   slotIndex,
                                                   frameBytes,
                                                   paramSaveOffset,
                                                   paramSaveCount)
    if stackOffset < 0:
        return -1
    if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotIndex]):
        # The param-save slot holds the incoming str-value address; load it with a
        # ceiling-aware 8-byte stack load. At large frames the param-save offset
        # overflows the LDR scaled-imm ceiling (32760), so a flat `ldr reg,[sp,#off]`
        # would be an invalid encoding AND only 1 word, while the size predictor
        # (PrimaryBodyIrLoadSlotWordCount → StackAccessWordCount(off,8)) correctly
        # counts the address-materialize words. Use PrimaryBodyIRLoadStackOffsetToReg
        # so emit == predictor at every offset (mirrors PrimaryBodyIRLoadSlotToReg).
        return PrimaryBodyIRLoadStackOffsetToReg(words, offset, reg, stackOffset, 8)
    return a64units.CodegenA64BodyFillStackAddressToReg(words, offset, reg, stackOffset)

# Words emitted by PrimaryBodyIRLoadStrValueAddressToReg for the same slot.
# A param str slot holds the str record address: the loader reads it with a
# ceiling-aware 8-byte [sp,#off] ldr (PrimaryBodyIRLoadStackOffsetToReg), so past
# the LDR scaled-imm ceiling (32760) the address is materialized first (extra add
# words) — exactly PrimaryBodyIrStackAccessWordCount(off,8). A local str slot has
# its address materialized (PrimaryBodyIRFillStackAddressToReg →
# PrimaryBodyIrStackAddressWordCount). The size predictor must use these exact
# counts so it equals the fill at every offset (a flat `1` desyncs large frames).
@borrows
fn PrimaryBodyIRLoadStrValueAddressWordCount(bodyIR: coreir.BodyIR,
                                              slotIndex: int32): int32 =
    if PrimaryBodyIrSlotType(bodyIR, slotIndex) != coreir.LocalStrTag:
        return 0
    let stackOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                   slotIndex,
                                                   PrimaryBodyIrFrameBytes(bodyIR),
                                                   PrimaryBodyIrParamSaveOffset(bodyIR),
                                                   PrimaryBodyIrParamSaveCount(bodyIR))
    if stackOffset < 0:
        return 0
    if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotIndex]):
        return PrimaryBodyIrStackAccessWordCount(stackOffset, 8)
    return PrimaryBodyIrStackAddressWordCount(stackOffset)

@borrows
fn PrimaryBodyIRStrEqLiteralWordCount(bodyIR: coreir.BodyIR,
                                       op: coreir.BodyOp): int32 =
    if op.operands.len < 2:
        return 0
    if op.target < 0 || op.target >= bodyIR.localSlots.len:
        return 0
    if bodyIR.localSlots[op.target].typeKind != coreir.LocalI32Tag:
        return 0
    let strSlot = op.operands[0]
    if strSlot < 0 ||
       strSlot >= bodyIR.localSlots.len ||
       bodyIR.localSlots[strSlot].typeKind != coreir.LocalStrTag:
        return 0
    let literalId = op.operands[1]
    if literalId < 0 || literalId >= bodyIR.cstringLiterals.len:
        return 0
    let literalLen = len(bodyIR.cstringLiterals[literalId].text)
    var literalLenMovWords = 1
    if literalLen > 65535:
        literalLenMovWords = 2
    let storeWords = PrimaryBodyIrStoreSlotWordCount(bodyIR, op.target)
    if storeWords <= 0:
        return 0
    # Compact exact loop, independent of literal length: ADRP+ADD literal data
    # [2], source ptr/len loads [2], exact int32 length materialization [1/2],
    # cmp+b.ne [2], byte loop [9], success/fail tail [3], then the same
    # ceiling-aware bool store used by fill. The source str-value address load is
    # also ceiling-aware. Thus predictor and filler share every variable width.
    return PrimaryBodyIRLoadStrValueAddressWordCount(bodyIR, strSlot) +
           literalLenMovWords + 18 + storeWords

@borrows
fn PrimaryBodyIRFillStrEqLiteralOp(words: var int32[],
                                    offset: int32,
                                    bodyIR: coreir.BodyIR,
                                    op: coreir.BodyOp,
                                    frameBytes: int32,
                                    paramSaveOffset: int32,
                                    paramSaveCount: int32): int32 =
    if op.operands.len < 2:
        return -1
    let literalId = op.operands[1]
    if literalId < 0 || literalId >= bodyIR.cstringLiterals.len:
        return -1
    let literalLen = len(bodyIR.cstringLiterals[literalId].text)
    let wordCount = PrimaryBodyIRStrEqLiteralWordCount(bodyIR, op)
    var primaryColdCond20: bool
    if wordCount <= 0:
        primaryColdCond20 = true
    if offset < 0:
        primaryColdCond20 = true
    if offset + wordCount > words.len:
        primaryColdCond20 = true
    if primaryColdCond20:
        return -1
    # The first word is the literal-data ADRP, so relocation identity is exactly
    # (opIndex, 0). Branches target the tail/store by structural word indices;
    # neither branch distance nor emitted code size grows with literal length.
    let strEqLitStoreWords = PrimaryBodyIrStoreSlotWordCount(bodyIR, op.target)
    if strEqLitStoreWords <= 0:
        return -1
    let storeIndex = offset + wordCount - strEqLitStoreWords
    let failIndex = storeIndex - 1
    let successIndex = storeIndex - 3
    var pos = offset
    if pos + 1 >= words.len:
        return -1
    words[pos] = a64units.CodegenA64EncAdrp(a64units.CodegenA64X12)
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncAddImm(true, a64units.CodegenA64X12, a64units.CodegenA64X12, 0))
    pos = pos + 1
    pos = PrimaryBodyIRLoadStrValueAddressToReg(words,
                                                    pos,
                                                    bodyIR,
                                                    op.operands[0],
                                                    a64units.CodegenA64X10,
                                                    frameBytes,
                                                    paramSaveOffset,
                                                    paramSaveCount)
    if pos < 0 || pos + 3 >= words.len:
        return -1
    words[pos] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X9, a64units.CodegenA64X10, int64(0)))
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncLdrImm(false, a64units.CodegenA64X11, a64units.CodegenA64X10, int64(8)))
    pos = pos + 1
    words[pos] = a64units.CodegenA64EncMovz(false, a64units.CodegenA64X13, literalLen & 65535, 0)
    pos = pos + 1
    if literalLen > 65535:
        if pos >= words.len:
            return -1
        words[pos] = a64units.CodegenA64EncMovk(false,
                                    a64units.CodegenA64X13,
                                    (literalLen >> 16) & 65535,
                                    1)
        pos = pos + 1
    if pos + 1 >= words.len:
        return -1
    words[pos] = a64units.CodegenA64EncCmpReg(false, a64units.CodegenA64X11, a64units.CodegenA64X13)
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncBCond(int64(failIndex - pos), a64units.CodegenA64CondNE))
    pos = pos + 1
    let loopHead = pos
    words[pos] = Value(a64units.CodegenA64EncCbz(false, a64units.CodegenA64X11, int64(successIndex - pos)))
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncLdrbImm(a64units.CodegenA64X14, a64units.CodegenA64X9, 0))
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncLdrbImm(a64units.CodegenA64X15, a64units.CodegenA64X12, 0))
    pos = pos + 1
    words[pos] = a64units.CodegenA64EncCmpReg(false, a64units.CodegenA64X14, a64units.CodegenA64X15)
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncBCond(int64(failIndex - pos), a64units.CodegenA64CondNE))
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncAddImm(true, a64units.CodegenA64X9, a64units.CodegenA64X9, 1))
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncAddImm(true, a64units.CodegenA64X12, a64units.CodegenA64X12, 1))
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncSubImm(false, a64units.CodegenA64X11, a64units.CodegenA64X11, 1))
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncBImm(int64(loopHead - pos)))
    pos = pos + 1
    if pos != successIndex:
        return -1
    words[pos] = a64units.CodegenA64EncMovz(false, a64units.CodegenA64X11, 1, 0)
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncBImm(int64(storeIndex - pos)))
    pos = pos + 1
    words[pos] = a64units.CodegenA64EncMovz(false, a64units.CodegenA64X11, 0, 0)
    pos = pos + 1
    return PrimaryBodyIRStoreRegToSlot(words,
                                       pos,
                                       bodyIR,
                                       op.target,
                                       a64units.CodegenA64X11,
                                       frameBytes,
                                       paramSaveOffset,
                                       paramSaveCount)

@borrows
fn PrimaryBodyIRStrEqWordCount(bodyIR: coreir.BodyIR,
                                op: coreir.BodyOp): int32 =
    if op.operands.len < 2:
        return 0
    if op.target < 0 || op.target >= bodyIR.localSlots.len:
        return 0
    if bodyIR.localSlots[op.target].typeKind != coreir.LocalI32Tag:
        return 0
    let lhsSlot = op.operands[0]
    if lhsSlot < 0 ||
       lhsSlot >= bodyIR.localSlots.len ||
       bodyIR.localSlots[lhsSlot].typeKind != coreir.LocalStrTag:
        return 0
    let rhsSlot = op.operands[1]
    if rhsSlot < 0 ||
       rhsSlot >= bodyIR.localSlots.len ||
       bodyIR.localSlots[rhsSlot].typeKind != coreir.LocalStrTag:
        return 0
    let lhsWords = PrimaryBodyIrLoadSlotWordCount(bodyIR, lhsSlot)
    let rhsWords = PrimaryBodyIrLoadSlotWordCount(bodyIR, rhsSlot)
    if lhsWords <= 0 || rhsWords <= 0:
        return 0
    # Fill shape (PrimaryBodyIRFillStrEqOp): lhs/rhs value-address loads + fixed
    # middle (2 ldr + 2 ldr + cmp + b.ne [6], byte loop [9], movz/b/movz [3] = 18)
    # + bool store via PrimaryBodyIRStoreRegToSlot. That store is CEILING-AWARE:
    # past the 4-byte STR scaled-imm ceiling (16380) it materializes the slot
    # address first (extra add words), so it is NOT a fixed 1. The old flat `+19`
    # (= 18 + 1) under-counted exactly those large-frame targets and desynced the
    # two passes (fill_predicted_mismatch / buffer_size_desync — 2c68eca68 同族).
    # Small frames: storeWords == 1, so 18 + 1 == 19 and the fixed point holds.
    let storeWords = PrimaryBodyIrStoreSlotWordCount(bodyIR, op.target)
    if storeWords <= 0:
        return 0
    return lhsWords + rhsWords + 18 + storeWords

@borrows
fn PrimaryBodyIRFillStrEqOp(words: var int32[],
                             offset: int32,
                             bodyIR: coreir.BodyIR,
                             op: coreir.BodyOp,
                             frameBytes: int32,
                             paramSaveOffset: int32,
                             paramSaveCount: int32): int32 =
    let wordCount = PrimaryBodyIRStrEqWordCount(bodyIR, op)
    var primaryColdCond43: bool
    if wordCount <= 0:
        primaryColdCond43 = true
    if offset < 0:
        primaryColdCond43 = true
    if offset + wordCount > words.len:
        primaryColdCond43 = true
    if primaryColdCond43:
        return -1
    # The trailing bool store is ceiling-aware (StoreRegToSlot may materialize the
    # slot address first, storeWords > 1 past the 4-byte scaled-imm ceiling). All
    # three branch anchors must target the store-sequence START / the movz words
    # BEFORE it — the old `-1/-2/-4` hardcoded a 1-word store and, past the
    # ceiling, jumped INTO the address-materialization adds (silent miscompile).
    # Small frames: storeWords == 1 reproduces -1/-2/-4 word-for-word.
    let strEqStoreWords = PrimaryBodyIrStoreSlotWordCount(bodyIR, op.target)
    if strEqStoreWords <= 0:
        return -1
    let storeIndex = offset + wordCount - strEqStoreWords
    let failIndex = storeIndex - 1
    let successIndex = storeIndex - 3
    var pos = PrimaryBodyIRLoadStrValueAddressToReg(words,
                                                    offset,
                                                    bodyIR,
                                                    op.operands[0],
                                                    a64units.CodegenA64X10,
                                                    frameBytes,
                                                    paramSaveOffset,
                                                    paramSaveCount)
    if pos < 0:
        return -1
    words[pos] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X9, a64units.CodegenA64X10, int64(0)))
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncLdrImm(false, a64units.CodegenA64X11, a64units.CodegenA64X10, int64(8)))
    pos = pos + 1
    pos = PrimaryBodyIRLoadStrValueAddressToReg(words,
                                                pos,
                                                bodyIR,
                                                op.operands[1],
                                                a64units.CodegenA64X10,
                                                frameBytes,
                                                paramSaveOffset,
                                                paramSaveCount)
    if pos < 0:
        return -1
    words[pos] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X10, int64(0)))
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncLdrImm(false, a64units.CodegenA64X13, a64units.CodegenA64X10, int64(8)))
    pos = pos + 1
    words[pos] = a64units.CodegenA64EncCmpReg(false, a64units.CodegenA64X11, a64units.CodegenA64X13)
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncBCond(int64(failIndex - pos), a64units.CodegenA64CondNE))
    pos = pos + 1
    let loopHead = pos
    words[pos] = Value(a64units.CodegenA64EncCbz(false, a64units.CodegenA64X11, int64(successIndex - pos)))
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncLdrbImm(a64units.CodegenA64X14, a64units.CodegenA64X9, 0))
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncLdrbImm(a64units.CodegenA64X15, a64units.CodegenA64X12, 0))
    pos = pos + 1
    words[pos] = a64units.CodegenA64EncCmpReg(false, a64units.CodegenA64X14, a64units.CodegenA64X15)
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncBCond(int64(failIndex - pos), a64units.CodegenA64CondNE))
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncAddImm(true, a64units.CodegenA64X9, a64units.CodegenA64X9, 1))
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncAddImm(true, a64units.CodegenA64X12, a64units.CodegenA64X12, 1))
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncSubImm(false, a64units.CodegenA64X11, a64units.CodegenA64X11, 1))
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncBImm(int64(loopHead - pos)))
    pos = pos + 1
    if pos != successIndex:
        return -1
    words[pos] = a64units.CodegenA64EncMovz(false, a64units.CodegenA64X11, 1, 0)
    pos = pos + 1
    words[pos] = Value(a64units.CodegenA64EncBImm(int64(storeIndex - pos)))
    pos = pos + 1
    words[pos] = a64units.CodegenA64EncMovz(false, a64units.CodegenA64X11, 0, 0)
    pos = pos + 1
    return PrimaryBodyIRStoreRegToSlot(words,
                                       pos,
                                       bodyIR,
                                       op.target,
                                       a64units.CodegenA64X11,
                                       frameBytes,
                                       paramSaveOffset,
                                       paramSaveCount)

@borrows
fn PrimaryLoadConstMovWordCount(op: coreir.BodyOp): int32 =
    if op.operands.len >= 5:
        var movCount = 1
        for chunkIndex in 2..<5:
            if op.operands[chunkIndex] != 0:
                movCount = movCount + 1
        return movCount
    let constValue = op.operands[1]
    if constValue >= 0 && constValue <= 65535:
        return 1
    if constValue < 0 && constValue >= -65536:
        return 1
    return 2

@borrows
fn PrimaryBodyIRCopySlot(words: var int32[],
                          offset: int32,
                          bodyIR: coreir.BodyIR,
                          sourceSlotIndex: int32,
                          targetSlotIndex: int32,
                          frameBytes: int32,
                          paramSaveOffset: int32,
                          paramSaveCount: int32): int32 =
    if sourceSlotIndex < 0 || sourceSlotIndex >= bodyIR.localSlots.len ||
       targetSlotIndex < 0 || targetSlotIndex >= bodyIR.localSlots.len:
        return -1
    let sourceOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                    sourceSlotIndex,
                                                    frameBytes,
                                                    paramSaveOffset,
                                                    paramSaveCount)
    let targetOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                    targetSlotIndex,
                                                    frameBytes,
                                                    paramSaveOffset,
                                                    paramSaveCount)
    if sourceOffset < 0 || targetOffset < 0:
        return -1
    let sourceType = PrimaryBodyIrSlotType(bodyIR, sourceSlotIndex)
    let targetType = PrimaryBodyIrSlotType(bodyIR, targetSlotIndex)
    let targetPointeeKind = PrimaryBodyIrVarParamPointeeKind(bodyIR, targetSlotIndex)
    if targetPointeeKind == coreir.LocalI32Tag:
        if sourceType != coreir.LocalI32Tag:
            return -1
        var pos = PrimaryBodyIRLoadStackOffsetToReg(words,
                                                    offset,
                                                    a64units.CodegenA64X9,
                                                    sourceOffset,
                                                    4)
        if pos < 0:
            return -1
        pos = PrimaryBodyIRLoadStackOffsetToReg(words,
                                                pos,
                                                a64units.CodegenA64X10,
                                                targetOffset,
                                                8)
        if pos < 0 || pos >= words.len:
            return -1
        words[pos] = Value(a64units.CodegenA64EncStrImm(false,
                                            a64units.CodegenA64X9,
                                            a64units.CodegenA64X10,
                                            int64(0)))
        return pos + 1
    if targetPointeeKind == coreir.LocalI64Tag:
        if sourceType != coreir.LocalI32Tag &&
           sourceType != coreir.LocalI64Tag &&
           sourceType != coreir.LocalPtrTag:
            return -1
        var pos = offset
        if sourceType == coreir.LocalI32Tag:
            pos = PrimaryBodyIRLoadStackOffsetSignedI32ToReg(words,
                                                             pos,
                                                             a64units.CodegenA64X9,
                                                             sourceOffset)
        else:
            pos = PrimaryBodyIRLoadStackOffsetToReg(words,
                                                    pos,
                                                    a64units.CodegenA64X9,
                                                    sourceOffset,
                                                    8)
        if pos < 0:
            return -1
        pos = PrimaryBodyIRLoadStackOffsetToReg(words,
                                                pos,
                                                a64units.CodegenA64X10,
                                                targetOffset,
                                                8)
        if pos < 0 || pos >= words.len:
            return -1
        words[pos] = Value(a64units.CodegenA64EncStrImm(true,
                                            a64units.CodegenA64X9,
                                            a64units.CodegenA64X10,
                                            int64(0)))
        return pos + 1
    if sourceType == coreir.LocalI32Tag && targetType == coreir.LocalI64Tag:
        var pos = PrimaryBodyIRLoadStackOffsetSignedI32ToReg(words,
                                                             offset,
                                                             a64units.CodegenA64X9,
                                                             sourceOffset)
        if pos < 0:
            return -1
        return PrimaryBodyIRStoreRegToStackOffset(words,
                                                  pos,
                                                  a64units.CodegenA64X9,
                                                  a64units.CodegenA64X12,
                                                  targetOffset,
                                                  8)
    let slotSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlotIndex])
    if slotSize == 4:
        var pos = PrimaryBodyIRLoadStackOffsetToReg(words,
                                                    offset,
                                                    a64units.CodegenA64X9,
                                                    sourceOffset,
                                                    4)
        if pos < 0:
            return -1
        return PrimaryBodyIRStoreRegToStackOffset(words,
                                                  pos,
                                                  a64units.CodegenA64X9,
                                                  a64units.CodegenA64X12,
                                                  targetOffset,
                                                  4)
    if slotSize == 1:
        var pos = PrimaryBodyIRLoadStackOffsetToReg(words,
                                                    offset,
                                                    a64units.CodegenA64X9,
                                                    sourceOffset,
                                                    1)
        if pos < 0:
            return -1
        return PrimaryBodyIRStoreRegToStackOffset(words,
                                                  pos,
                                                  a64units.CodegenA64X9,
                                                  a64units.CodegenA64X12,
                                                  targetOffset,
                                                  1)
    if slotSize == 2:
        var pos = PrimaryBodyIRLoadStackOffsetToReg(words,
                                                    offset,
                                                    a64units.CodegenA64X9,
                                                    sourceOffset,
                                                    2)
        if pos < 0:
            return -1
        return PrimaryBodyIRStoreRegToStackOffset(words,
                                                  pos,
                                                  a64units.CodegenA64X9,
                                                  a64units.CodegenA64X12,
                                                  targetOffset,
                                                  2)
    if slotSize <= 0:
        return -1
    # 按值/ var 聚合形参（str@24 / FixedBytes32@32 / Vec3@12）的槽 home 存的是
    # 【记录指针】(入参 by-pointer)，不是内联结构体值。
    # - 源是形参：必须先把 home 指针取到 X10，再从 [X10+i*stride] 读（否则读成
    #   「指针 + 相邻槽垃圾」）。
    # - 目标是形参（var FixedBytes32 等）：必须先把 home 指针取到 X11，再写
    #   [X11+i*stride]。若直接按 sp+home 写 slotSize 字节，会把 8 字节 param-save
    #   槽撑爆并盖掉 sret/越过 frame（pure dry CompilerWorldSourceBundleCidSingleSourceInto
    #   写 FixedBytes32 到 sp+0x1f0..0x20f → PC=0）。
    # 本地聚合槽存内联值走下面既有 %8/%4 直拷臂，不误伤 local→local。
    let sourceIsParamAgg = (sourceType == coreir.LocalStrTag ||
                            sourceType == coreir.LocalAggregateTag) &&
                           PrimaryBodyIrLocalIsParam(bodyIR.localSlots[sourceSlotIndex])
    let targetIsParamAgg = (targetType == coreir.LocalStrTag ||
                            targetType == coreir.LocalAggregateTag) &&
                           PrimaryBodyIrLocalIsParam(bodyIR.localSlots[targetSlotIndex])
    if sourceIsParamAgg || targetIsParamAgg:
        var paramStride = 0
        var paramChunks = 0
        if targetIsParamAgg:
            # dest is by-pointer: only value size alignment matters
            if slotSize % 8 == 0:
                paramStride = 8
                paramChunks = slotSize / 8
            elif slotSize % 4 == 0:
                paramStride = 4
                paramChunks = slotSize / 4
            else:
                return -1
        elif slotSize % 8 == 0 && targetOffset % 8 == 0:
            paramStride = 8
            paramChunks = slotSize / 8
        elif slotSize % 4 == 0 && targetOffset % 4 == 0:
            paramStride = 4
            paramChunks = slotSize / 4
        else:
            return -1
        var paramPos = offset
        if sourceIsParamAgg:
            paramPos = PrimaryBodyIRLoadStackOffsetToReg(words,
                                                         paramPos,
                                                         a64units.CodegenA64X10,
                                                         sourceOffset,
                                                         8)
            if paramPos < 0:
                return -1
        if targetIsParamAgg:
            paramPos = PrimaryBodyIRLoadStackOffsetToReg(words,
                                                         paramPos,
                                                         a64units.CodegenA64X11,
                                                         targetOffset,
                                                         8)
            if paramPos < 0:
                return -1
        var paramIs64 = false
        if paramStride == 8:
            paramIs64 = true
        for paramCopyIndex in 0..<paramChunks:
            if paramPos < 0 || paramPos >= words.len:
                return -1
            if sourceIsParamAgg:
                words[paramPos] = Value(a64units.CodegenA64EncLdrImm(paramIs64,
                                                         a64units.CodegenA64X9,
                                                         a64units.CodegenA64X10,
                                                         int64(paramCopyIndex * paramStride)))
                paramPos = paramPos + 1
            else:
                paramPos = PrimaryBodyIRLoadStackOffsetToReg(words,
                                                             paramPos,
                                                             a64units.CodegenA64X9,
                                                             sourceOffset + paramCopyIndex * paramStride,
                                                             paramStride)
                if paramPos < 0:
                    return -1
            if targetIsParamAgg:
                if paramPos >= words.len:
                    return -1
                words[paramPos] = Value(a64units.CodegenA64EncStrImm(paramIs64,
                                                         a64units.CodegenA64X9,
                                                         a64units.CodegenA64X11,
                                                         int64(paramCopyIndex * paramStride)))
                paramPos = paramPos + 1
            else:
                paramPos = PrimaryBodyIRStoreRegToStackOffset(words,
                                                              paramPos,
                                                              a64units.CodegenA64X9,
                                                              a64units.CodegenA64X12,
                                                              targetOffset + paramCopyIndex * paramStride,
                                                              paramStride)
                if paramPos < 0:
                    return -1
        return paramPos
    # 8-byte chunk copy when the size and both endpoints are 8-aligned; this is
    # the original path for word-multiple aggregates (str@24, 16/8/24-byte
    # structs). A nested struct whose total size is a multiple of 4 but not 8
    # (e.g. {int32 id, Inner{int32,int32}} = 12 bytes) is just as honest a
    # whole-value copy — fall to a 4-byte chunk copy so the trailing word is
    # carried too. Same alignment discipline as the FieldLoad copier (34155).
    if slotSize % 8 == 0 && sourceOffset % 8 == 0 && targetOffset % 8 == 0:
        var pos = offset
        for copyIndex in 0..<(slotSize / 8):
            pos = PrimaryBodyIRLoadStackOffsetToReg(words,
                                                    pos,
                                                    a64units.CodegenA64X9,
                                                    sourceOffset + copyIndex * 8,
                                                    8)
            if pos < 0:
                return -1
            pos = PrimaryBodyIRStoreRegToStackOffset(words,
                                                     pos,
                                                     a64units.CodegenA64X9,
                                                     a64units.CodegenA64X12,
                                                     targetOffset + copyIndex * 8,
                                                     8)
            if pos < 0:
                return -1
        return pos
    if slotSize % 4 == 0 && sourceOffset % 4 == 0 && targetOffset % 4 == 0:
        var pos = offset
        for copyIndex in 0..<(slotSize / 4):
            pos = PrimaryBodyIRLoadStackOffsetToReg(words,
                                                    pos,
                                                    a64units.CodegenA64X9,
                                                    sourceOffset + copyIndex * 4,
                                                    4)
            if pos < 0:
                return -1
            pos = PrimaryBodyIRStoreRegToStackOffset(words,
                                                     pos,
                                                     a64units.CodegenA64X9,
                                                     a64units.CodegenA64X12,
                                                     targetOffset + copyIndex * 4,
                                                     4)
            if pos < 0:
                return -1
        return pos
    return -1

fn PrimaryBodyIRLoadStackOffsetToReg(words: var int32[],
                                      offset: int32,
                                      reg: int32,
                                      stackOffset: int32,
                                      byteCount: int32): int32 =
    if offset < 0 || offset >= words.len:
        return -1
    if stackOffset < 0:
        return -1
    var baseReg = a64units.CodegenA64SP
    var accessOffset = stackOffset
    var pos = offset
    if !PrimaryBodyIrStackAccessImmFits(stackOffset, byteCount):
        pos = a64units.CodegenA64BodyFillStackAddressToReg(words, pos, reg, stackOffset)
        if pos < 0 || pos >= words.len:
            return -1
        baseReg = reg
        accessOffset = 0
    if byteCount == 1:
        words[pos] = Value(a64units.CodegenA64EncLdrbImm(reg, baseReg, accessOffset))
        return pos + 1
    if byteCount == 2:
        words[pos] = Value(a64units.CodegenA64EncLdrhImm(reg, baseReg, accessOffset))
        return pos + 1
    if byteCount == 4:
        words[pos] = Value(a64units.CodegenA64EncLdrImm(false, reg, baseReg, int64(accessOffset)))
        return pos + 1
    if byteCount == 8:
        words[pos] = Value(a64units.CodegenA64EncLdrImm(true, reg, baseReg, int64(accessOffset)))
        return pos + 1
    return -1

fn PrimaryBodyIRLoadStackOffsetSignedI32ToReg(words: var int32[],
                                               offset: int32,
                                               reg: int32,
                                               stackOffset: int32): int32 =
    if offset < 0 || offset >= words.len:
        return -1
    if stackOffset < 0:
        return -1
    var baseReg = a64units.CodegenA64SP
    var accessOffset = stackOffset
    var pos = offset
    if !PrimaryBodyIrStackAccessImmFits(stackOffset, 4):
        pos = a64units.CodegenA64BodyFillStackAddressToReg(words, pos, reg, stackOffset)
        if pos < 0 || pos >= words.len:
            return -1
        baseReg = reg
        accessOffset = 0
    words[pos] = Value(a64units.CodegenA64EncLdrswImm(reg, baseReg, int64(accessOffset)))
    return pos + 1

fn PrimaryBodyIRStoreRegToStackOffset(words: var int32[],
                                       offset: int32,
                                       reg: int32,
                                       addressReg: int32,
                                       stackOffset: int32,
                                       byteCount: int32): int32 =
    if offset < 0 || offset >= words.len:
        return -1
    if stackOffset < 0:
        return -1
    var baseReg = a64units.CodegenA64SP
    var accessOffset = stackOffset
    var pos = offset
    if !PrimaryBodyIrStackAccessImmFits(stackOffset, byteCount):
        pos = a64units.CodegenA64BodyFillStackAddressToReg(words, pos, addressReg, stackOffset)
        if pos < 0 || pos >= words.len:
            return -1
        baseReg = addressReg
        accessOffset = 0
    if byteCount == 1:
        words[pos] = Value(a64units.CodegenA64EncStrbImm(reg, baseReg, accessOffset))
        return pos + 1
    if byteCount == 2:
        words[pos] = Value(a64units.CodegenA64EncStrhImm(reg, baseReg, accessOffset))
        return pos + 1
    if byteCount == 4:
        words[pos] = Value(a64units.CodegenA64EncStrImm(false, reg, baseReg, int64(accessOffset)))
        return pos + 1
    if byteCount == 8:
        words[pos] = Value(a64units.CodegenA64EncStrImm(true, reg, baseReg, int64(accessOffset)))
        return pos + 1
    return -1

# Phase 2.5+ : true iff filling this call arg emits a data-reloc-anchoring ADRP as its FIRST word
# (cstring literal address arg, or global-address arg). Matches the EXACT predictor conditions in
# PrimaryBodyIrAppendCallCStringArgRelocs so the recorded real ADRP position and the predicted
# absolute it derives are 1:1. No other arg pass kind emits an ADRP at its first word.
@borrows
fn PrimaryCallArgEmitsDataReloc(bodyIR: coreir.BodyIR, argSlot: int32, passKind: int32): bool =
    if coreir.CallArgSlotIsCString(argSlot):
        let literalId = coreir.CallArgSlotCStringId(argSlot)
        return literalId >= 0 && literalId < bodyIR.cstringLiterals.len
    if passKind == coreir.BodyCallPassGlobalAddressTag:
        return argSlot >= 0 &&
               argSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[argSlot].placeKind == coreir.BodyPlaceGlobalAddressTag
    return false

@borrows
fn PrimaryBodyIRFillCallArgToReg(words: var int32[],
                                  offset: int32,
                                  bodyIR: coreir.BodyIR,
                                  argSlot: int32,
                                  passKind: int32,
                                  reg: int32,
                                  frameBytes: int32,
                                  paramSaveOffset: int32,
                                  paramSaveCount: int32,
                                  spBias: int32,
                                  regArgCrossesCAbi: bool,
                                  fpTargetReg: int32): int32 =
    if offset < 0 || offset >= words.len:
        return -1
    if passKind == coreir.BodyCallPassGlobalAddressTag:
        if argSlot < 0 ||
           argSlot >= bodyIR.localSlots.len ||
           bodyIR.localSlots[argSlot].placeKind != coreir.BodyPlaceGlobalAddressTag:
            return -1
        return a64units.CodegenA64BodyFillGlobalDataAddress(words, offset, reg)
    if coreir.CallArgSlotIsConst(argSlot):
        words[offset] = a64units.CodegenA64EncMovz(false, reg, coreir.CallArgSlotConstI32Value(argSlot), 0)
        return offset + 1
    if coreir.CallArgSlotIsCString(argSlot):
        if offset + 1 >= words.len:
            return -1
        words[offset] = a64units.CodegenA64EncAdrp(reg)
        words[offset + 1] = Value(a64units.CodegenA64EncAddImm(true, reg, reg, 0))
        return offset + 2
    if coreir.CallArgSlotIsAddress(argSlot):
        let slotId = coreir.CallArgSlotAddressId(argSlot)
        # form60: hoist .len before three-way conj with [slotId]
        let localSlotsLen_f60: int32 = bodyIR.localSlots.len
        if slotId >= 0 && slotId < localSlotsLen_f60 &&
           PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotId]) &&
           (bodyIR.localSlots[slotId].typeKind == coreir.LocalStrTag ||
            bodyIR.localSlots[slotId].typeKind == coreir.LocalAggregateTag):
            # str/aggregate 形参槽存的是入参值地址: 「值的地址」= 槽内容本身,
            # 不是槽的栈址。否则二次传参会把 param-save 槽当成 str/聚合记录。
            return PrimaryBodyIRLoadSlotToRegBiased(words,
                                                    offset,
                                                    bodyIR,
                                                    slotId,
                                                    reg,
                                                    frameBytes,
                                                    paramSaveOffset,
                                                    paramSaveCount,
                                                    spBias)
        let slotOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                       slotId,
                                                       frameBytes,
                                                       paramSaveOffset,
                                                       paramSaveCount)
        if slotOffset < 0:
            return -1
        return a64units.CodegenA64BodyFillStackAddressToReg(
            words,
            offset,
            reg,
            PrimaryBodyIrCheckedStackOffsetAdd(slotOffset, spBias))
    let loadedPos = PrimaryBodyIRLoadSlotToRegBiased(words,
                                                      offset,
                                                      bodyIR,
                                                      argSlot,
                                                      reg,
                                                      frameBytes,
                                                      paramSaveOffset,
                                                      paramSaveCount,
                                                      spBias)
    if loadedPos < 0:
        return -1
    # #73 current: AAPCS64 passes f64 args in D registers; a real C-ABI target
    # (@importc/provider) needs the raw bits moved from X{reg} onto D{fpTargetReg}
    # after the load. FMOV Dd,Xn does not clobber the source Xn, so Cheng-internal
    # readers that still expect the raw bits in X{reg} (see PrimaryBodyIRFillPrologue)
    # are unaffected -- this is gated strictly to calls that cross the real ABI.
    # Current NSRN fix: the D-register target is the FP-class register-arg ordinal
    # (NSRN, counted separately from the GP-class NGRN ordinal by the caller),
    # NOT `reg` (which stays the raw-bits X scratch — always safe, see caller).
    if regArgCrossesCAbi &&
       argSlot >= 0 && argSlot < bodyIR.localSlots.len &&
       bodyIR.localSlots[argSlot].typeKind == coreir.LocalF64Tag:
        if loadedPos >= words.len:
            return -1
        words[loadedPos] = a64units.CodegenA64EncFmovDx(fpTargetReg, reg)
        return loadedPos + 1
    return loadedPos

@borrows
fn PrimaryBodyIRFillCallOp(words: var int32[],
                            offset: int32,
                            bodyIR: coreir.BodyIR,
                            op: coreir.BodyOp,
                            opIndex: int32,
                            frameBytes: int32,
                            paramSaveOffset: int32,
                            paramSaveCount: int32): int32 =
    if op.operands.len <= 0:
        return -1
    # Step B-data (call-internal data reloc emit-first): subIndex counts the cstring-arg / sret-global
    # ADRPs this call op emits, in arg-walk order, mirroring AppendCallCStringArgRelocs exactly so the
    # (opIndex, subIndex) key is identical on both passes.
    var dataRelocSubIndex: int32
    let callOrdinal = op.operands[0]
    if callOrdinal < 0 || callOrdinal >= bodyIR.callSequence.len:
        return -1
    let call = bodyIR.callSequence[callOrdinal]
    var pos = offset
    # Step B-data (emit-first): record each call-internal cstring-arg / sret-global data reloc ADRP
    # at its REAL serial-fill position, keyed by (functionBase, opIndex, subIndex). The recording is
    # gated on the active Darwin-arm64 backpatch path (primaryBackpatchActive); outside it the
    # recorder is a no-op anyway. No predicted cursor is computed — the size predictor is deleted and
    # `pos` (the real cursor) is the only source. (predecessor: a layoutCallWordStart-derived
    # predCursor whose numeric value was never recorded — only its >=0 path gate mattered.)
    let stackArgBytes = PrimaryCallOpStackArgBytes(call)
    if stackArgBytes > 0:
        pos = a64units.CodegenA64BodyFillStackAdjustExact(words,
                                                pos,
                                                stackArgBytes,
                                                true)
        if pos < 0:
            return -1
    let registerArgCount = PrimaryCallOpRegisterArgCount(call)
    # Current NGRN/NSRN: a real C-ABI call (targetIsImportc) allocates register-arg
    # targets from two INDEPENDENT AAPCS64 counters -- GP class (int/ptr/str
    # base, x{NGRN}) and FP class (f64, d{NSRN}) -- not by raw positional
    # argIndex. Cheng-internal calls (targetIsImportc==false) keep the
    # existing positional convention byte-for-byte (ngrn/nsrn unused there).
    var ngrn: int32
    var nsrn: int32
    for argIndex in 0..<registerArgCount:
        let argPassKind = PrimaryCallOpArgPassKind(call, argIndex)
        let argSlot = call.argSlots[argIndex]
        # Step B-data (emit-first): the cstring-arg / global-address ADRP is this arg's FIRST emitted
        # word, so `pos` (the real serial fill cursor) IS its real ADRP position. Record it keyed by
        # the structural identity (current function base, opIndex, subIndex) — subIndex advances per
        # emitted reloc in arg-walk order, mirroring AppendCallCStringArgRelocs.
        if primaryBackpatchActive && PrimaryCallArgEmitsDataReloc(bodyIR, argSlot, argPassKind):
            PrimaryBackpatchRecordDataRelocEmitFirst(opIndex, dataRelocSubIndex, pos)
            dataRelocSubIndex = dataRelocSubIndex + 1
        let argIsF64CAbi = call.targetIsImportc &&
                            argSlot >= 0 && argSlot < bodyIR.localSlots.len &&
                            bodyIR.localSlots[argSlot].typeKind == coreir.LocalF64Tag
        # fillReg: the X-register the raw bits are loaded into. FP-class args
        # keep using X{argIndex} as a scratch (never a live GP target -- proof:
        # argIndex always exceeds every earlier-assigned NGRN, and this arg's
        # own X-load is fully consumed by the very next fmov before any later
        # arg is filled), then fmov moves the value to D{nsrn}. GP-class args
        # under a real C-ABI call load DIRECTLY into their real target X{ngrn}.
        var fillReg: int32 = argIndex
        var fpTargetReg: int32
        if call.targetIsImportc:
            if argIsF64CAbi:
                fillReg = argIndex
                fpTargetReg = nsrn
                nsrn = nsrn + 1
            else:
                fillReg = ngrn
                ngrn = ngrn + 1
        pos = PrimaryBodyIRFillCallArgToReg(words,
                                            pos,
                                            bodyIR,
                                            argSlot,
                                            argPassKind,
                                            fillReg,
                                            frameBytes,
                                            paramSaveOffset,
                                            paramSaveCount,
                                            stackArgBytes,
                                            call.targetIsImportc,
                                            fpTargetReg)
        if pos < 0:
            return -1
    let stackArgCount = PrimaryCallOpStackArgCount(call)
    for stackArgIndex in 0..<stackArgCount:
        let argIndex = stackArgIndex + 8
        let stackArgPassKind = PrimaryCallOpArgPassKind(call, argIndex)
        let stackArgSlot = call.argSlots[argIndex]
        if primaryBackpatchActive && PrimaryCallArgEmitsDataReloc(bodyIR, stackArgSlot, stackArgPassKind):
            PrimaryBackpatchRecordDataRelocEmitFirst(opIndex, dataRelocSubIndex, pos)
            dataRelocSubIndex = dataRelocSubIndex + 1
        pos = PrimaryBodyIRFillCallArgToReg(words,
                                            pos,
                                            bodyIR,
                                            stackArgSlot,
                                            stackArgPassKind,
                                            16,
                                            frameBytes,
                                            paramSaveOffset,
                                            paramSaveCount,
                                            stackArgBytes,
                                            false,
                                            0)
        let stackArgOffset = PrimaryCallOpStackArgOffset(call, stackArgIndex)
        let stackArgSize = PrimaryCallOpStackArgSize(call, stackArgIndex)
        pos = PrimaryBodyIRStoreRegToStackOffset(words,
                                                 pos,
                                                 16,
                                                 a64units.CodegenA64X12,
                                                 stackArgOffset,
                                                 stackArgSize)
        if pos < 0:
            return -1
    if PrimaryBodyIRCallHasIndirectResult(bodyIR, call):
        if PrimaryBodyIRCallIndirectResultIsGlobal(bodyIR, call):
            # sret destination is a GLOBAL aggregate (`gAgg = make(...)`): point x8
            # at the global's storage (adrp+add, PAGE/PAGEOFF reloc), not a stack
            # slot. The x8 adrp is at `pos` (its first word). Step B-data emit-first: record it keyed
            # by (function base, opIndex, subIndex) — subIndex is the next value after all arg relocs,
            # mirroring AppendCallCStringArgRelocs which appends the sret-global last.
            if primaryBackpatchActive:
                PrimaryBackpatchRecordDataRelocEmitFirst(opIndex, dataRelocSubIndex, pos)
                dataRelocSubIndex = dataRelocSubIndex + 1
            pos = a64units.CodegenA64BodyFillGlobalDataAddress(words, pos, a64units.CodegenA64X8)
            if pos < 0:
                return -1
        else:
            let resultOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                            call.resultSlot,
                                                            frameBytes,
                                                            paramSaveOffset,
                                                            paramSaveCount)
            if resultOffset < 0:
                return -1
            pos = a64units.CodegenA64BodyFillStackAddressToReg(
                words,
                pos,
                a64units.CodegenA64X8,
                PrimaryBodyIrCheckedStackOffsetAdd(resultOffset, stackArgBytes))
            if pos < 0:
                return -1
    let inlineAtomicKind = PrimaryCallOpInlineAtomicFetchAddKind(call)
    let inlinePtrSlotKind = PrimaryCallOpInlinePtrSlotKind(call)
    let inlineAesBlockKind = PrimaryCallOpInlineAesBlockKind(call)
    let inlineSha256BlockKind = PrimaryCallOpInlineSha256BlockKind(call)
    let inlineF64TruncKind = PrimaryCallOpInlineF64TruncKind(call)
    let inlineF64FromIntKind = PrimaryCallOpInlineF64FromIntKind(call, bodyIR)
    if inlineAtomicKind > 0:
        pos = a64units.CodegenA64BodyFillInlineAtomicFetchAdd(words, pos, inlineAtomicKind)
        if pos < 0:
            return -1
    elif inlinePtrSlotKind > 0:
        pos = a64units.CodegenA64BodyFillInlinePtrSlot(words, pos, inlinePtrSlotKind)
        if pos < 0:
            return -1
    elif inlineAesBlockKind > 0:
        pos = a64units.CodegenA64BodyFillInlineAesBlock(words, pos, inlineAesBlockKind)
        if pos < 0:
            return -1
    elif inlineSha256BlockKind > 0:
        pos = a64units.CodegenA64BodyFillInlineSha256Block(words, pos, inlineSha256BlockKind)
        if pos < 0:
            return -1
    elif inlineF64TruncKind > 0:
        pos = a64units.CodegenA64BodyFillInlineF64Trunc(words, pos, inlineF64TruncKind)
        if pos < 0:
            return -1
    elif inlineF64FromIntKind > 0:
        pos = a64units.CodegenA64BodyFillInlineF64FromInt(words, pos, inlineF64FromIntKind, call.inlineF64FromIntUnsigned)
        if pos < 0:
            return -1
    else:
        if pos >= words.len:
            return -1
        # Step B (call-BL reloc emit-first): `pos` is the real BL placeholder fill position. Record
        # it keyed by the structural identity (current function base, callOrdinal); FillAndCheck
        # looks it up to write the call reloc word offset directly from the emit. No predictor / no
        # desync compare — the real position IS the offset.
        PrimaryBackpatchRecordCallBlReloc(callOrdinal, pos)
        words[pos] = a64units.CodegenA64EncBlPlaceholder()
        pos = pos + 1
        if PrimaryBodyIRCallResultIsF64Scalar(bodyIR, call):
            # #76: a real `bl` returning f64 lands the value in the physical D0
            # register -- an AAPCS64 base rule that applies uniformly to both
            # @importc C calls and Cheng-internal calls (mirrors the RETURN-side
            # `fmov d0,x0` emitted just before every f64-returning function's own
            # `ret`, see the "extra fmov d0, x0 at the return fill" comment on
            # PrimaryBodyIRTermSizeRaw). Convert the raw bits back into X0 so the
            # shared post-call store below (which reads A64X0 unconditionally,
            # like every other call kind) picks up the real value instead of
            # whatever was previously in X0.
            if pos >= words.len:
                return -1
            words[pos] = a64units.CodegenA64EncFmovXd(a64units.CodegenA64X0, 0)
            pos = pos + 1
    if stackArgBytes > 0:
        pos = a64units.CodegenA64BodyFillStackAdjustExact(words,
                                                pos,
                                                stackArgBytes,
                                                false)
        if pos < 0:
            return -1
    if PrimaryBodyIRCallStoresScalarResult(bodyIR, call):
        pos = PrimaryBodyIRStoreRegToSlot(words,
                                          pos,
                                          bodyIR,
                                          call.resultSlot,
                                          a64units.CodegenA64X0,
                                          frameBytes,
                                          paramSaveOffset,
                                          paramSaveCount)
        if pos < 0:
            return -1
    return pos

@borrows
fn PrimaryBodyIRFillBinOp(words: var int32[],
                           offset: int32,
                           bodyIR: coreir.BodyIR,
                           op: coreir.BodyOp,
                           opIndex: int32,
                           frameBytes: int32,
                           paramSaveOffset: int32,
                           paramSaveCount: int32): int32 =
    if op.operands.len < 4:
        return -1
    let opType = op.operands[0]
    if opType != coreir.LocalI32Tag &&
       opType != coreir.LocalI64Tag &&
       opType != coreir.LocalF64Tag:
        return -1
    var opIs64: bool
    if opType == coreir.LocalI64Tag:
        opIs64 = true
    # Stage-0 peephole: when layoutLhsElide[opIndex] is set, the lhs is already resident in
    # X9 (the previous op stored its result to this same full-width I64 slot), so skip the
    # reload. This MUST mirror the size predictor's matching subtraction (both read the same
    # layoutLhsElide flag) or the two-pass word counts desync and the bootstrap breaks.
    var pos = offset
    # form60: hoist .len before three-way conj with [opIndex]
    let lhsElideLen: int32 = bodyIR.layoutLhsElide.len
    let lhsElided = opIndex >= 0 && opIndex < lhsElideLen && bodyIR.layoutLhsElide[opIndex]
    if !lhsElided:
        pos = PrimaryBodyIRLoadSlotToReg(words, offset, bodyIR, op.operands[2], a64units.CodegenA64X9, frameBytes, paramSaveOffset, paramSaveCount)
        if pos < 0:
            return -1
    pos = PrimaryBodyIRLoadSlotToReg(words, pos, bodyIR, op.operands[3], a64units.CodegenA64X10, frameBytes, paramSaveOffset, paramSaveCount)
    if pos < 0 || pos >= words.len:
        return -1
    let opKind = op.operands[1]
    if opType == coreir.LocalF64Tag:
        if pos + 3 >= words.len:
            return -1
        words[pos] = a64units.CodegenA64EncFmovDx(a64units.CodegenA64X9, a64units.CodegenA64X9)
        words[pos + 1] = a64units.CodegenA64EncFmovDx(a64units.CodegenA64X10, a64units.CodegenA64X10)
        if opKind == int32(texpr.TypedExprIrOpF64Add):
            words[pos + 2] = a64units.CodegenA64EncFaddD(a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        elif opKind == int32(texpr.TypedExprIrOpF64Sub):
            words[pos + 2] = a64units.CodegenA64EncFsubD(a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        elif opKind == int32(texpr.TypedExprIrOpF64Mul):
            words[pos + 2] = a64units.CodegenA64EncFmulD(a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        elif opKind == int32(texpr.TypedExprIrOpF64Div):
            words[pos + 2] = a64units.CodegenA64EncFdivD(a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        else:
            return -1
        words[pos + 3] = a64units.CodegenA64EncFmovXd(a64units.CodegenA64X9, a64units.CodegenA64X9)
        pos = pos + 4
    elif opKind == int32(texpr.TypedExprIrOpI32Add):
        words[pos] = a64units.CodegenA64EncAddReg(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI32Sub):
        words[pos] = a64units.CodegenA64EncSubReg(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI32BitAnd):
        words[pos] = a64units.CodegenA64EncAndReg(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI32BitOr):
        words[pos] = a64units.CodegenA64EncOrrReg(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI32BitXor):
        words[pos] = a64units.CodegenA64EncEorReg(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI32Mul):
        words[pos] = a64units.CodegenA64EncMul(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI32Asr):
        words[pos] = a64units.CodegenA64EncAsrv(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI32Lsr):
        words[pos] = a64units.CodegenA64EncLsrv(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI32Lsl):
        words[pos] = a64units.CodegenA64EncLslv(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI32Sdiv):
        words[pos] = a64units.CodegenA64EncSdiv(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI32Udiv):
        words[pos] = a64units.CodegenA64EncUdiv(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI32Madd):
        if op.operands.len < 5:
            return -1
        pos = PrimaryBodyIRLoadSlotToReg(words, pos, bodyIR, op.operands[4], 11, frameBytes, paramSaveOffset, paramSaveCount)
        if pos < 0 || pos >= words.len:
            return -1
        words[pos] = a64units.CodegenA64EncMadd(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10, 11)
        pos = pos + 1
    # i64 BinOp opKinds: the node-eval BinOp handler (PrimaryBodyIrEvalNode) emits
    # these for i64 arithmetic (e.g. x509ToEpoch `days*86400`, `seq>>shift`). The
    # a64 encoders already take opIs64 (set true when opType=I64), so each i64
    # case mirrors its i32 counterpart — only the matched opKind differs. Without
    # these the filler fell to `else: return -1` → 0x0 instruction word → census
    # zero-op (caught, not silent), blocking obj-emit at the first i64 BinOp.
    elif opKind == int32(texpr.TypedExprIrOpI64Add):
        words[pos] = a64units.CodegenA64EncAddReg(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI64Sub):
        words[pos] = a64units.CodegenA64EncSubReg(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI64BitAnd):
        words[pos] = a64units.CodegenA64EncAndReg(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI64BitOr):
        words[pos] = a64units.CodegenA64EncOrrReg(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI64BitXor):
        words[pos] = a64units.CodegenA64EncEorReg(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI64Mul):
        words[pos] = a64units.CodegenA64EncMul(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI64Asr):
        words[pos] = a64units.CodegenA64EncAsrv(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI64Lsr):
        words[pos] = a64units.CodegenA64EncLsrv(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI64Lsl):
        words[pos] = a64units.CodegenA64EncLslv(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI64Sdiv):
        words[pos] = a64units.CodegenA64EncSdiv(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    elif opKind == int32(texpr.TypedExprIrOpI64Udiv):
        words[pos] = a64units.CodegenA64EncUdiv(opIs64, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
        pos = pos + 1
    else:
        return -1
    # Stage-1 peephole: when layoutStoreElide[opIndex] is set, op.target is a single-use temp
    # whose only reader (the next op's lhs) consumes the result straight from X9, so the store
    # to memory is dead. Skip it — and this MUST mirror the size predictor's matching
    # subtraction (both read the same layoutStoreElide flag) or the two-pass counts desync.
    # form60: hoist .len before three-way conj with [opIndex]
    let storeElideLen: int32 = bodyIR.layoutStoreElide.len
    let storeElided = opIndex >= 0 && opIndex < storeElideLen && bodyIR.layoutStoreElide[opIndex]
    if storeElided:
        return pos
    return PrimaryBodyIRStoreRegToSlot(words, pos, bodyIR, op.target, a64units.CodegenA64X9, frameBytes, paramSaveOffset, paramSaveCount)

@borrows
fn PrimaryBodyIRFillIndexedAddressPartsToReg(words: var int32[],
                                              offset: int32,
                                              bodyIR: coreir.BodyIR,
                                              baseSlot: int32,
                                              indexSlot: int32,
                                              elemSize: int32,
                                              dynamicSequence: bool,
                                              addressReg: int32,
                                              indexReg: int32,
                                              tempReg0: int32,
                                              tempReg1: int32,
                                              frameBytes: int32,
                                              paramSaveOffset: int32,
                                              paramSaveCount: int32): int32 =
    if baseSlot < 0 || baseSlot >= bodyIR.localSlots.len:
        return -1
    var pos = offset
    if bodyIR.localSlots[baseSlot].placeKind ==
       coreir.BodyPlaceGlobalAddressTag:
        pos = a64units.CodegenA64BodyFillGlobalDataAddress(
            words, pos, addressReg)
    else:
        pos = PrimaryBodyIRLoadSlotToReg(words,
                                         pos,
                                         bodyIR,
                                         baseSlot,
                                         addressReg,
                                         frameBytes,
                                         paramSaveOffset,
                                         paramSaveCount)
    if pos < 0:
        return -1
    if dynamicSequence:
        if pos >= words.len:
            return -1
        words[pos] = Value(a64units.CodegenA64EncLdrImm(true, addressReg, addressReg, int64(8)))
        pos = pos + 1
    pos = PrimaryBodyIRLoadSlotToReg(words,
                                     pos,
                                     bodyIR,
                                     indexSlot,
                                     indexReg,
                                     frameBytes,
                                     paramSaveOffset,
                                     paramSaveCount)
    if pos < 0 || pos >= words.len:
        return -1
    if elemSize == 1:
        words[pos] = a64units.CodegenA64EncAddReg(true, addressReg, addressReg, indexReg)
        return pos + 1
    if elemSize == 4 || elemSize == 8 || elemSize == 16:
        var shift: int32
        if elemSize == 4:
            shift = 2
        elif elemSize == 8:
            shift = 3
        else:
            shift = 4
        if pos + 2 >= words.len:
            return -1
        words[pos] = a64units.CodegenA64EncMovz(false, tempReg0, shift, 0)
        words[pos + 1] = a64units.CodegenA64EncLslv(false, indexReg, indexReg, tempReg0)
        words[pos + 2] = a64units.CodegenA64EncAddReg(true, addressReg, addressReg, indexReg)
        return pos + 3
    if elemSize == 24:
        if pos + 5 >= words.len:
            return -1
        words[pos] = a64units.CodegenA64EncMovz(false, tempReg0, 4, 0)
        words[pos + 1] = a64units.CodegenA64EncLslv(false, tempReg0, indexReg, tempReg0)
        words[pos + 2] = a64units.CodegenA64EncMovz(false, tempReg1, 3, 0)
        words[pos + 3] = a64units.CodegenA64EncLslv(false, indexReg, indexReg, tempReg1)
        words[pos + 4] = a64units.CodegenA64EncAddReg(true, indexReg, indexReg, tempReg0)
        words[pos + 5] = a64units.CodegenA64EncAddReg(true, addressReg, addressReg, indexReg)
        return pos + 6
    # General positive int32 stride. Materialize every significant 16-bit chunk;
    # MOVZ's imm16 limit is an instruction detail, not a layout limit.
    if elemSize > 0:
        if pos + 1 >= words.len:
            return -1
        words[pos] = a64units.CodegenA64EncMovz(false, tempReg0, elemSize & 65535, 0)
        pos = pos + 1
        if elemSize > 65535:
            if pos + 1 >= words.len:
                return -1
            words[pos] = a64units.CodegenA64EncMovk(false,
                                        tempReg0,
                                        (elemSize >> 16) & 65535,
                                        1)
            pos = pos + 1
        words[pos] = a64units.CodegenA64EncMadd(true, addressReg, indexReg, tempReg0, addressReg)
        return pos + 1
    return -1

@borrows
fn PrimaryBodyIRFillIndexedAggregateAddressToReg(words: var int32[],
                                                  offset: int32,
                                                  bodyIR: coreir.BodyIR,
                                                  op: coreir.BodyOp,
                                                  addressReg: int32,
                                                  indexReg: int32,
                                                  tempReg0: int32,
                                                  tempReg1: int32,
                                                  frameBytes: int32,
                                                  paramSaveOffset: int32,
                                                  paramSaveCount: int32): int32 =
    if op.operands.len < 4:
        return -1
    return PrimaryBodyIRFillIndexedAddressPartsToReg(
        words,
        offset,
        bodyIR,
        op.operands[0],
        op.operands[2],
        op.operands[3],
        op.operands.len >= 5 && op.operands[4] == 1,
        addressReg,
        indexReg,
        tempReg0,
        tempReg1,
        frameBytes,
        paramSaveOffset,
        paramSaveCount)

@borrows
fn PrimaryBodyIRFillCmpOp(words: var int32[],
                           offset: int32,
                           bodyIR: coreir.BodyIR,
                           op: coreir.BodyOp,
                           opIndex: int32,
                           frameBytes: int32,
                           paramSaveOffset: int32,
                           paramSaveCount: int32): int32 =
    if op.operands.len < 3:
        return -1
    var pos = offset
    pos = PrimaryBodyIRLoadSlotToReg(words, pos, bodyIR, op.operands[1], a64units.CodegenA64X9, frameBytes, paramSaveOffset, paramSaveCount)
    if pos < 0:
        return -1
    pos = PrimaryBodyIRLoadSlotToReg(words, pos, bodyIR, op.operands[2], a64units.CodegenA64X10, frameBytes, paramSaveOffset, paramSaveCount)
    if pos < 0:
        return -1
    var cmpIs64: bool
    let cmpLhsType = PrimaryBodyIrSlotType(bodyIR, op.operands[1])
    let cmpRhsType = PrimaryBodyIrSlotType(bodyIR, op.operands[2])
    let cmpIsF64 = cmpLhsType == coreir.LocalF64Tag || cmpRhsType == coreir.LocalF64Tag
    if cmpIsF64:
        if cmpLhsType != coreir.LocalF64Tag || cmpRhsType != coreir.LocalF64Tag:
            return -1
        if pos + 4 >= words.len:
            return -1
        words[pos] = a64units.CodegenA64EncFmovDx(a64units.CodegenA64X9, a64units.CodegenA64X9)
        words[pos + 1] = a64units.CodegenA64EncFmovDx(a64units.CodegenA64X10, a64units.CodegenA64X10)
        words[pos + 2] = a64units.CodegenA64EncFcmpD(a64units.CodegenA64X9, a64units.CodegenA64X10)
        # form60: hoist .len before three-way conj
        let layoutCmpFuseLen_f60: int32 = bodyIR.layoutCmpFuse.len
        if opIndex >= 0 && opIndex < layoutCmpFuseLen_f60 && bodyIR.layoutCmpFuse[opIndex] >= 0:
            return pos + 3
        words[pos + 3] = Value(a64units.CodegenA64EncCset(a64units.CodegenA64X9, a64units.CodegenA64BodyCondTrueCode(op.operands[0])))
        return PrimaryBodyIRStoreRegToSlot(words,
                                           pos + 4,
                                           bodyIR,
                                           op.target,
                                           a64units.CodegenA64X9,
                                           frameBytes,
                                           paramSaveOffset,
                                           paramSaveCount)
    if pos + 2 >= words.len:
        return -1
    if cmpLhsType == coreir.LocalI64Tag:
        cmpIs64 = true
    elif cmpLhsType == coreir.LocalPtrTag:
        cmpIs64 = true
    elif cmpRhsType == coreir.LocalI64Tag:
        cmpIs64 = true
    elif cmpRhsType == coreir.LocalPtrTag:
        cmpIs64 = true
    words[pos] = a64units.CodegenA64EncCmpReg(cmpIs64, a64units.CodegenA64X9, a64units.CodegenA64X10)
    # Stage10 Cmp->Cbr fusion: when fused, the cmp's flags are consumed directly by the block's
    # terminating Cbr (the next thing emitted after the block ops — nothing clobbers NZCV between).
    # Drop the cset materialization + the bool store entirely; the fused Cbr filler emits the
    # `b.<cond>` reading these flags. Gated by the same layout flag the size case reads (returns 3).
    # form60: hoist .len before three-way conj
    let layoutCmpFuseLen_f60: int32 = bodyIR.layoutCmpFuse.len
    if opIndex >= 0 && opIndex < layoutCmpFuseLen_f60 && bodyIR.layoutCmpFuse[opIndex] >= 0:
        return pos + 1
    words[pos + 1] = Value(a64units.CodegenA64EncCset(a64units.CodegenA64X9, a64units.CodegenA64BodyCondTrueCode(op.operands[0])))
    return PrimaryBodyIRStoreRegToSlot(words,
                                       pos + 2,
                                       bodyIR,
                                       op.target,
                                       a64units.CodegenA64X9,
                                       frameBytes,
                                       paramSaveOffset,
                                       paramSaveCount)

# Word count of PrimaryBodyIRFillStackAddressToReg for the same offset; the
# size pass and the fill pass must agree instruction-for-instruction.
fn PrimaryBodyIrStackAddressWordCount(stackOffsetRaw: int32): int32 =
    if stackOffsetRaw < 0:
        return 0
    if stackOffsetRaw <= 4095:
        return 1
    var wordsCount: int32 = 1
    var remain = stackOffsetRaw - 4095
    while remain > 4095:
        wordsCount = wordsCount + 1
        remain = remain - 4095
    return wordsCount + 1

fn PrimaryBodyIrStackAccessImmFits(stackOffset: int32,
                                    byteCount: int32): bool =
    if stackOffset < 0:
        return false
    if byteCount == 1:
        return stackOffset <= 4095
    if byteCount == 2:
        if stackOffset % 2 != 0:
            return false
        return stackOffset <= 8190
    if byteCount == 4:
        if stackOffset % 4 != 0:
            return false
        return stackOffset <= 16380
    if byteCount == 8:
        if stackOffset % 8 != 0:
            return false
        return stackOffset <= 32760
    return false

fn PrimaryBodyIrStackAccessWordCount(stackOffset: int32,
                                      byteCount: int32): int32 =
    if stackOffset < 0:
        return 0
    if PrimaryBodyIrStackAccessImmFits(stackOffset, byteCount):
        return 1
    let addressWords = PrimaryBodyIrStackAddressWordCount(stackOffset)
    if addressWords <= 0:
        return 0
    return addressWords + 1

# Direct [sp, #imm] field access only encodes within the scaled-imm ranges
# (16380 bytes for 4-byte, 4095 for byte copies); beyond a conservative
# threshold the field address must be materialized into a register first.
fn PrimaryBodyIrFieldAccessNeedsAddressReg(accessOffset: int32, byteCount: int32): bool =
    if accessOffset < 0:
        return false
    return accessOffset + byteCount > 16000

# CopyMemory hard-fails past byte-imm range; the side that exceeds it gets
# its address materialized so byte copies run at offset 0.
fn PrimaryBodyIrCopySideNeedsAddressReg(sideOffset: int32, byteCount: int32): bool =
    if sideOffset < 0:
        return false
    return sideOffset + byteCount > 4000

fn PrimaryBodyIRCopyMemoryWordCount(byteCount: int32): int32 =
    if byteCount <= 0:
        return 0
    if byteCount <= 4096:
        return byteCount * 2
    # Mirrors PrimaryBodyIRFillCopyMemory's slow chunked path (byteCount past
    # the single-window LDRB/STRB imm12 ceiling at offset 0): the byte-loop
    # word count is unchanged (byteCount*2 LDRB+STRB words total regardless
    # of how many windows it's split across), plus one ADD-immediate fold
    # per side at every window boundary. Each fold advances by exactly 4095
    # bytes, so PrimaryBodyIrStackAddressWordCount(4095) == 1 word per side
    # per boundary — ceil(byteCount/4095) windows means
    # ceil(byteCount/4095)-1 boundaries.
    let numChunks = (byteCount + 4094) / 4095
    return byteCount * 2 + (numChunks - 1) * 2

fn PrimaryBodyIRCopyMemoryWordCountForOffsets(sourceOffset: int32,
                                               targetOffset: int32,
                                               byteCount: int32): int32 =
    if byteCount <= 0:
        return 0
    if sourceOffset < 0:
        return 0
    if targetOffset < 0:
        return 0
    var wordCount = PrimaryBodyIRCopyMemoryWordCount(byteCount)
    if wordCount <= 0:
        return 0
    if PrimaryBodyIrCopySideNeedsAddressReg(sourceOffset, byteCount):
        let sourceAddressWords = PrimaryBodyIrStackAddressWordCount(sourceOffset)
        if sourceAddressWords <= 0:
            return 0
        wordCount = wordCount + sourceAddressWords
    if PrimaryBodyIrCopySideNeedsAddressReg(targetOffset, byteCount):
        let targetAddressWords = PrimaryBodyIrStackAddressWordCount(targetOffset)
        if targetAddressWords <= 0:
            return 0
        wordCount = wordCount + targetAddressWords
    return wordCount

# T56 根修: 形参聚合/str 源槽在 by-ref ABI 下持"调用方拷贝的地址"而非内联
# 数据本身（AppendVarAggregateStore 已用同一事实处理写侧, 见 form47 家族
# 同类注记 line 31316）。ResultProject 系列（IsErr/IsOk/Value/Error/
# ErrInfo）从形参聚合/str 读投影时必须先解引用取真实结构体基址——否则把
# paramSave 槽偏移直接当内联栈数据读, 读到的是"保存的指针值本身"（几乎
# 恒非零）, IsErr(param) 恒假。
@borrows
fn PrimaryBodyIrSlotIsIndirectAggregateParam(bodyIR: coreir.BodyIR,
                                               slotIndex: int32): bool =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return false
    let slot = bodyIR.localSlots[slotIndex]
    if !PrimaryBodyIrLocalIsParam(slot):
        return false
    return slot.typeKind == coreir.LocalAggregateTag || slot.typeKind == coreir.LocalStrTag

@borrows
fn PrimaryBodyIRResultProjectCopyWordCount(bodyIR: coreir.BodyIR,
                                            op: coreir.BodyOp): int32 =
    if op.operands.len < 2:
        return 0
    var validProjectKind = false
    if op.operands[0] == coreir.BodyResultProjectValueStrTag:
        validProjectKind = true
    if op.operands[0] == coreir.BodyResultProjectErrorStrTag:
        validProjectKind = true
    if op.operands[0] == coreir.BodyResultProjectErrInfoTag:
        validProjectKind = true
    if !validProjectKind:
        return 0
    let frameBytes = PrimaryBodyIrFrameBytes(bodyIR)
    let paramSaveOffset = PrimaryBodyIrParamSaveOffset(bodyIR)
    let paramSaveCount = PrimaryBodyIrParamSaveCount(bodyIR)
    let sourceOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                     op.operands[1],
                                                     frameBytes,
                                                     paramSaveOffset,
                                                     paramSaveCount)
    let targetOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                     op.target,
                                                     frameBytes,
                                                     paramSaveOffset,
                                                     paramSaveCount)
    if sourceOffset < 0:
        return 0
    if targetOffset < 0:
        return 0
    var fieldOffset = coreir.ResultStrValueOffset
    var byteCount = 24
    if op.operands[0] == coreir.BodyResultProjectErrorStrTag:
        fieldOffset = coreir.ResultStrErrMsgOffset
    if op.operands.len >= 4:
        fieldOffset = op.operands[2]
        byteCount = op.operands[3]
    if fieldOffset < 0:
        return 0
    if PrimaryBodyIrSlotIsIndirectAggregateParam(bodyIR, op.operands[1]):
        # 源是 by-ref 形参：先花 1 条(罕见情形多条)ldr 把保存的指针解引用进
        # 寄存器, 随后字段访问相对该寄存器(基址已在寄存器里, 有效偏移只是
        # fieldOffset 本身, 不再叠加 sourceOffset)。
        let derefWords = PrimaryBodyIrStackAccessWordCount(sourceOffset, 8)
        if derefWords <= 0:
            return 0
        let copyWords = PrimaryBodyIRCopyMemoryWordCountForOffsets(fieldOffset,
                                                                    targetOffset,
                                                                    byteCount)
        if copyWords <= 0:
            return 0
        return derefWords + copyWords
    return PrimaryBodyIRCopyMemoryWordCountForOffsets(sourceOffset + fieldOffset,
                                                      targetOffset,
                                                      byteCount)

@borrows
fn PrimaryBodyIRResultProjectIsErrWordCount(bodyIR: coreir.BodyIR,
                                             op: coreir.BodyOp): int32 =
    if op.operands.len < 2:
        return 0
    let frameBytes = PrimaryBodyIrFrameBytes(bodyIR)
    let paramSaveOffset = PrimaryBodyIrParamSaveOffset(bodyIR)
    let paramSaveCount = PrimaryBodyIrParamSaveCount(bodyIR)
    let sourceOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                     op.operands[1],
                                                     frameBytes,
                                                     paramSaveOffset,
                                                     paramSaveCount)
    let targetOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                     op.target,
                                                     frameBytes,
                                                     paramSaveOffset,
                                                     paramSaveCount)
    if sourceOffset < 0:
        return 0
    if targetOffset < 0:
        return 0
    var wordCount: int32 = 6
    if PrimaryBodyIrSlotIsIndirectAggregateParam(bodyIR, op.operands[1]):
        # 源是 by-ref 形参：先解引用取真实结构体基址(1 条 ldr, 罕见大帧需
        # 多条), ok 标志位读取改相对该寄存器(偏移即 ResultStrOkOffset 本身)。
        let derefWords = PrimaryBodyIrStackAccessWordCount(sourceOffset, 8)
        if derefWords <= 0:
            return 0
        wordCount = wordCount + derefWords
    else:
        let sourceAccessOffset = sourceOffset + coreir.ResultStrOkOffset
        if PrimaryBodyIrFieldAccessNeedsAddressReg(sourceAccessOffset, 4):
            let sourceAddressWords = PrimaryBodyIrStackAddressWordCount(sourceAccessOffset)
            if sourceAddressWords <= 0:
                return 0
            wordCount = wordCount + sourceAddressWords
    if PrimaryBodyIrFieldAccessNeedsAddressReg(targetOffset, 4):
        let targetAddressWords = PrimaryBodyIrStackAddressWordCount(targetOffset)
        if targetAddressWords <= 0:
            return 0
        wordCount = wordCount + targetAddressWords
    return wordCount

@borrows
fn PrimaryBodyIRCopySlotWordCount(bodyIR: coreir.BodyIR,
                                   sourceSlotIndex: int32,
                                   targetSlotIndex: int32): int32 =
    if sourceSlotIndex < 0:
        return 0
    if targetSlotIndex < 0:
        return 0
    if sourceSlotIndex >= bodyIR.localSlots.len:
        return 0
    if targetSlotIndex >= bodyIR.localSlots.len:
        return 0
    let frameBytes = PrimaryBodyIrFrameBytes(bodyIR)
    let paramSaveOffset = PrimaryBodyIrParamSaveOffset(bodyIR)
    let paramSaveCount = PrimaryBodyIrParamSaveCount(bodyIR)
    let sourceOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                    sourceSlotIndex,
                                                    frameBytes,
                                                    paramSaveOffset,
                                                    paramSaveCount)
    let targetOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                    targetSlotIndex,
                                                    frameBytes,
                                                    paramSaveOffset,
                                                    paramSaveCount)
    if sourceOffset < 0:
        return 0
    if targetOffset < 0:
        return 0
    let sourceType = PrimaryBodyIrSlotType(bodyIR, sourceSlotIndex)
    let targetType = PrimaryBodyIrSlotType(bodyIR, targetSlotIndex)
    let targetPointeeKind = PrimaryBodyIrVarParamPointeeKind(bodyIR, targetSlotIndex)
    if targetPointeeKind == coreir.LocalI32Tag:
        if sourceType == coreir.LocalI32Tag:
            return PrimaryBodyIrStackAccessWordCount(sourceOffset, 4) +
                   PrimaryBodyIrStackAccessWordCount(targetOffset, 8) +
                   1
        return 0
    if targetPointeeKind == coreir.LocalI64Tag:
        if sourceType == coreir.LocalI32Tag:
            return PrimaryBodyIrStackAccessWordCount(sourceOffset, 4) +
                   PrimaryBodyIrStackAccessWordCount(targetOffset, 8) +
                   1
        if sourceType == coreir.LocalI64Tag:
            return PrimaryBodyIrStackAccessWordCount(sourceOffset, 8) +
                   PrimaryBodyIrStackAccessWordCount(targetOffset, 8) +
                   1
        if sourceType == coreir.LocalPtrTag:
            return PrimaryBodyIrStackAccessWordCount(sourceOffset, 8) +
                   PrimaryBodyIrStackAccessWordCount(targetOffset, 8) +
                   1
        return 0
    if sourceType == coreir.LocalI32Tag && targetType == coreir.LocalI64Tag:
        return PrimaryBodyIrStackAccessWordCount(sourceOffset, 4) +
               PrimaryBodyIrStackAccessWordCount(targetOffset, 8)
    let slotSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlotIndex])
    if slotSize <= 0:
        return 0
    if slotSize == 4:
        return PrimaryBodyIrStackAccessWordCount(sourceOffset, 4) +
               PrimaryBodyIrStackAccessWordCount(targetOffset, 4)
    if slotSize == 1:
        return PrimaryBodyIrStackAccessWordCount(sourceOffset, 1) +
               PrimaryBodyIrStackAccessWordCount(targetOffset, 1)
    if slotSize == 2:
        return PrimaryBodyIrStackAccessWordCount(sourceOffset, 2) +
               PrimaryBodyIrStackAccessWordCount(targetOffset, 2)
    # 与发射器锁步：聚合形参源/目标整拷先物化 home 指针（各 StackAccessWordCount(*,8)），
    # 每 chunk 发 1 字直读/写 [base+i*stride]；非形参侧仍走 StackAccessWordCount(sp+off)。
    let sourceIsParamAgg = (sourceType == coreir.LocalStrTag ||
                            sourceType == coreir.LocalAggregateTag) &&
                           PrimaryBodyIrLocalIsParam(bodyIR.localSlots[sourceSlotIndex])
    let targetIsParamAgg = (targetType == coreir.LocalStrTag ||
                            targetType == coreir.LocalAggregateTag) &&
                           PrimaryBodyIrLocalIsParam(bodyIR.localSlots[targetSlotIndex])
    if sourceIsParamAgg || targetIsParamAgg:
        var paramStride = 0
        var paramChunks = 0
        if targetIsParamAgg:
            if slotSize % 8 == 0:
                paramStride = 8
                paramChunks = slotSize / 8
            elif slotSize % 4 == 0:
                paramStride = 4
                paramChunks = slotSize / 4
            else:
                return 0
        elif slotSize % 8 == 0 && targetOffset % 8 == 0:
            paramStride = 8
            paramChunks = slotSize / 8
        elif slotSize % 4 == 0 && targetOffset % 4 == 0:
            paramStride = 4
            paramChunks = slotSize / 4
        else:
            return 0
        var paramWordCount: int32
        if sourceIsParamAgg:
            paramWordCount = paramWordCount + PrimaryBodyIrStackAccessWordCount(sourceOffset, 8)
        if targetIsParamAgg:
            paramWordCount = paramWordCount + PrimaryBodyIrStackAccessWordCount(targetOffset, 8)
        for paramCopyIndex in 0..<paramChunks:
            if sourceIsParamAgg:
                paramWordCount = paramWordCount + 1
            else:
                paramWordCount = paramWordCount +
                                 PrimaryBodyIrStackAccessWordCount(sourceOffset + paramCopyIndex * paramStride, paramStride)
            if targetIsParamAgg:
                paramWordCount = paramWordCount + 1
            else:
                paramWordCount = paramWordCount +
                                 PrimaryBodyIrStackAccessWordCount(targetOffset + paramCopyIndex * paramStride, paramStride)
        return paramWordCount
    if slotSize % 8 == 0 && sourceOffset % 8 == 0 && targetOffset % 8 == 0:
        var wordCount: int32
        for copyIndex in 0..<(slotSize / 8):
            wordCount = wordCount +
                        PrimaryBodyIrStackAccessWordCount(sourceOffset + copyIndex * 8, 8)
            wordCount = wordCount +
                        PrimaryBodyIrStackAccessWordCount(targetOffset + copyIndex * 8, 8)
        return wordCount
    if slotSize % 4 == 0 && sourceOffset % 4 == 0 && targetOffset % 4 == 0:
        var wordCount: int32
        for copyIndex in 0..<(slotSize / 4):
            wordCount = wordCount +
                        PrimaryBodyIrStackAccessWordCount(sourceOffset + copyIndex * 4, 4)
            wordCount = wordCount +
                        PrimaryBodyIrStackAccessWordCount(targetOffset + copyIndex * 4, 4)
        return wordCount
    return 0

@borrows
fn PrimaryBodyIRFillResultProjectOp(words: var int32[],
                                     offset: int32,
                                     bodyIR: coreir.BodyIR,
                                     op: coreir.BodyOp,
                                     frameBytes: int32,
                                     paramSaveOffset: int32,
                                     paramSaveCount: int32): int32 =
    if op.operands.len < 2:
        return -1
    let sourceOffset = PrimaryBodyIrLocalStackOffset(bodyIR, op.operands[1], frameBytes, paramSaveOffset, paramSaveCount)
    let targetOffset = PrimaryBodyIrLocalStackOffset(bodyIR, op.target, frameBytes, paramSaveOffset, paramSaveCount)
    if sourceOffset < 0 || targetOffset < 0:
        return -1
    let srcIsIndirectParam = PrimaryBodyIrSlotIsIndirectAggregateParam(bodyIR, op.operands[1])
    if op.operands[0] == coreir.BodyResultProjectIsErrTag:
        var pos = offset
        var isErrSourceReg = a64units.CodegenA64SP
        var isErrSourceOffset = sourceOffset + coreir.ResultStrOkOffset
        if srcIsIndirectParam:
            # 源是 by-ref 形参（聚合/str, ABI 持调用方拷贝的地址）：sourceOffset
            # 处存的是"指针值"本身，不是内联结构体数据——先解引用取真实基址，
            # 再按 ResultStrOkOffset 读 ok 标志位；否则直接读 [sp,sourceOffset]
            # 得到的是保存的指针低 32 位（几乎恒非零），IsErr 恒假。
            pos = PrimaryBodyIRLoadStackOffsetToReg(words, pos, a64units.CodegenA64X12, sourceOffset, 8)
            if pos < 0:
                return -1
            isErrSourceReg = a64units.CodegenA64X12
            isErrSourceOffset = coreir.ResultStrOkOffset
        elif PrimaryBodyIrFieldAccessNeedsAddressReg(isErrSourceOffset, 4):
            pos = a64units.CodegenA64BodyFillStackAddressToReg(words,
                                                     pos,
                                                     a64units.CodegenA64X12,
                                                     isErrSourceOffset)
            if pos < 0:
                return -1
            isErrSourceReg = a64units.CodegenA64X12
            isErrSourceOffset = 0
        var isErrTargetReg = a64units.CodegenA64SP
        var isErrTargetOffset = targetOffset
        if PrimaryBodyIrFieldAccessNeedsAddressReg(isErrTargetOffset, 4):
            pos = a64units.CodegenA64BodyFillStackAddressToReg(words,
                                                     pos,
                                                     a64units.CodegenA64X13,
                                                     isErrTargetOffset)
            if pos < 0:
                return -1
            isErrTargetReg = a64units.CodegenA64X13
            isErrTargetOffset = 0
        if pos + 5 >= words.len:
            return -1
        words[pos] = Value(a64units.CodegenA64EncLdrImm(false,
                                            a64units.CodegenA64X9,
                                            isErrSourceReg,
                                            int64(isErrSourceOffset)))
        words[pos + 1] = Value(a64units.CodegenA64EncCmpImm(false, a64units.CodegenA64X9, 0))
        words[pos + 2] = a64units.CodegenA64EncMovz(false, a64units.CodegenA64X9, 0, 0)
        words[pos + 3] = Value(a64units.CodegenA64EncBCond(int64(2), a64units.CodegenA64CondNE))
        words[pos + 4] = a64units.CodegenA64EncMovz(false, a64units.CodegenA64X9, 1, 0)
        words[pos + 5] = Value(a64units.CodegenA64EncStrImm(false,
                                                a64units.CodegenA64X9,
                                                isErrTargetReg,
                                                int64(isErrTargetOffset)))
        return pos + 6
    if op.operands[0] == coreir.BodyResultProjectIsOkTag:
        # IsOk = ok-flag 直读（IsErr 的逻辑非）：ok!=0→1，ok==0→0。指令序列
        # 与 IsErr 同构，仅两枚 movz 初值互换（先 1 后 0）。字数复用 IsErr。
        var pos = offset
        var isOkSourceReg = a64units.CodegenA64SP
        var isOkSourceOffset = sourceOffset + coreir.ResultStrOkOffset
        if srcIsIndirectParam:
            pos = PrimaryBodyIRLoadStackOffsetToReg(words, pos, a64units.CodegenA64X12, sourceOffset, 8)
            if pos < 0:
                return -1
            isOkSourceReg = a64units.CodegenA64X12
            isOkSourceOffset = coreir.ResultStrOkOffset
        elif PrimaryBodyIrFieldAccessNeedsAddressReg(isOkSourceOffset, 4):
            pos = a64units.CodegenA64BodyFillStackAddressToReg(words,
                                                     pos,
                                                     a64units.CodegenA64X12,
                                                     isOkSourceOffset)
            if pos < 0:
                return -1
            isOkSourceReg = a64units.CodegenA64X12
            isOkSourceOffset = 0
        var isOkTargetReg = a64units.CodegenA64SP
        var isOkTargetOffset = targetOffset
        if PrimaryBodyIrFieldAccessNeedsAddressReg(isOkTargetOffset, 4):
            pos = a64units.CodegenA64BodyFillStackAddressToReg(words,
                                                     pos,
                                                     a64units.CodegenA64X13,
                                                     isOkTargetOffset)
            if pos < 0:
                return -1
            isOkTargetReg = a64units.CodegenA64X13
            isOkTargetOffset = 0
        if pos + 5 >= words.len:
            return -1
        words[pos] = Value(a64units.CodegenA64EncLdrImm(false,
                                            a64units.CodegenA64X9,
                                            isOkSourceReg,
                                            int64(isOkSourceOffset)))
        words[pos + 1] = Value(a64units.CodegenA64EncCmpImm(false, a64units.CodegenA64X9, 0))
        words[pos + 2] = a64units.CodegenA64EncMovz(false, a64units.CodegenA64X9, 1, 0)
        words[pos + 3] = Value(a64units.CodegenA64EncBCond(int64(2), a64units.CodegenA64CondNE))
        words[pos + 4] = a64units.CodegenA64EncMovz(false, a64units.CodegenA64X9, 0, 0)
        words[pos + 5] = Value(a64units.CodegenA64EncStrImm(false,
                                                a64units.CodegenA64X9,
                                                isOkTargetReg,
                                                int64(isOkTargetOffset)))
        return pos + 6
    if op.operands[0] != coreir.BodyResultProjectErrorStrTag &&
       op.operands[0] != coreir.BodyResultProjectValueStrTag &&
       op.operands[0] != coreir.BodyResultProjectErrInfoTag:
        return -1
    # 2-operand Value/Error/ErrInfo 无生产者（全部 4-operand 携带布局）：
    # 毒化，不回落 str 固定布局常量（防静默 miscompile）。
    if op.operands.len < 4:
        return -1
    let fieldOffset = op.operands[2]
    let byteCount = op.operands[3]
    if fieldOffset < 0:
        return -1
    var pos = offset
    var copySourceReg = a64units.CodegenA64SP
    var copySourceOffset = sourceOffset + fieldOffset
    if srcIsIndirectParam:
        pos = PrimaryBodyIRLoadStackOffsetToReg(words, pos, a64units.CodegenA64X9, sourceOffset, 8)
        if pos < 0:
            return -1
        copySourceReg = a64units.CodegenA64X9
        copySourceOffset = fieldOffset
    elif PrimaryBodyIrCopySideNeedsAddressReg(copySourceOffset, byteCount):
        pos = a64units.CodegenA64BodyFillStackAddressToReg(words,
                                                 pos,
                                                 a64units.CodegenA64X9,
                                                 copySourceOffset)
        if pos < 0:
            return -1
        copySourceReg = a64units.CodegenA64X9
        copySourceOffset = 0
    var copyTargetReg = a64units.CodegenA64SP
    var copyTargetOffset = targetOffset
    if PrimaryBodyIrCopySideNeedsAddressReg(copyTargetOffset, byteCount):
        pos = a64units.CodegenA64BodyFillStackAddressToReg(words,
                                                 pos,
                                                 a64units.CodegenA64X12,
                                                 copyTargetOffset)
        if pos < 0:
            return -1
        copyTargetReg = a64units.CodegenA64X12
        copyTargetOffset = 0
    return a64units.CodegenA64BodyFillCopyMemory(words,
                                       pos,
                                       copySourceReg,
                                       copySourceOffset,
                                       copyTargetReg,
                                       copyTargetOffset,
                                       byteCount)

# F14b prefix: optional cond-slot address materialize + `ldr` + `cbnz`.
# Shared by OpSizeAtRaw / reloc BL cursor / FillResultPanicGuardOp so the three
# never disagree. At small frames FieldAccessNeedsAddressReg is false → exactly
# 2 words (old hardcoded shape). Past ~16000 the fill materializes the cond
# slot into X12 first — a flat `2` under-counts by StackAddressWordCount(condOff)
# and desyncs E-P by that amount (FAIL_TRACE +12/+14 on giant frames).
@borrows
fn PrimaryBodyIRResultPanicGuardPrefixWordCount(bodyIR: coreir.BodyIR,
                                                 condSlotIndex: int32): int32 =
    if condSlotIndex < 0 || condSlotIndex >= bodyIR.localSlots.len:
        return 0
    let condOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                   condSlotIndex,
                                                   PrimaryBodyIrFrameBytes(bodyIR),
                                                   PrimaryBodyIrParamSaveOffset(bodyIR),
                                                   PrimaryBodyIrParamSaveCount(bodyIR))
    if condOffset < 0:
        return 0
    # 1 ldr + 1 cbnz; optional address materialize mirrors fill.
    var words: int32 = 2
    if PrimaryBodyIrFieldAccessNeedsAddressReg(condOffset, 4):
        let addrWords = PrimaryBodyIrStackAddressWordCount(condOffset)
        if addrWords <= 0:
            return 0
        words = words + addrWords
    return words

# F14b: Result.Value() ok-check panic guard, direct-word-encoding twin of
# PrimaryObjectEmitCfgResultPanicGuardAsm (the "Cfg"/asm-text emitter). Both
# exist because this backend has two parallel arm64 lowering surfaces for
# different body-kind classifications (this one for "statement_sequence"
# small-function bodies, the Cfg/asm-text one for block/term bodies) — a
# function's body_kind picks exactly one, never both, so there is no dual-
# semantics risk, only dual-coverage. Same self-contained shape: ldr (cond
# slot) + cbnz (skip forward over the embedded call, word-exact via
# PrimaryBodyIRCallWordCount reused verbatim by both this fill and its sibling
# size predictor) + the call itself via PrimaryBodyIRFillCallOp (unmodified,
# same ABI marshaling every other call in this path uses). No new encoding
# primitives — A64EncLdrImm/A64EncCbnz are the same encoders IsErr/IsOk
# already use just above.
@borrows
fn PrimaryBodyIRFillResultPanicGuardOp(words: var int32[],
                                        offset: int32,
                                        bodyIR: coreir.BodyIR,
                                        op: coreir.BodyOp,
                                        oi: int32,
                                        frameBytes: int32,
                                        paramSaveOffset: int32,
                                        paramSaveCount: int32): int32 =
    if op.operands.len != 2:
        return -1
    let condSlotIndex = op.operands[0]
    let panicCallOrdinal = op.operands[1]
    let condOffset = PrimaryBodyIrLocalStackOffset(bodyIR, condSlotIndex, frameBytes, paramSaveOffset, paramSaveCount)
    if condOffset < 0:
        return -1
    var pos = offset
    var condSourceReg = a64units.CodegenA64SP
    var condSourceOffset = condOffset
    if PrimaryBodyIrFieldAccessNeedsAddressReg(condSourceOffset, 4):
        pos = a64units.CodegenA64BodyFillStackAddressToReg(words, pos, a64units.CodegenA64X12, condSourceOffset)
        if pos < 0:
            return -1
        condSourceReg = a64units.CodegenA64X12
        condSourceOffset = 0
    if pos + 1 >= words.len:
        return -1
    words[pos] = Value(a64units.CodegenA64EncLdrImm(false,
                                        a64units.CodegenA64X9,
                                        condSourceReg,
                                        int64(condSourceOffset)))
    let cbnzPos = pos + 1
    var panicGuardCallOp: coreir.BodyOp
    panicGuardCallOp.kind = coreir.BodyOpCallTag
    add(panicGuardCallOp.operands, panicCallOrdinal)
    let callWordCount = PrimaryBodyIRCallWordCount(bodyIR, panicGuardCallOp)
    if callWordCount <= 0:
        return -1
    if cbnzPos >= words.len:
        return -1
    words[cbnzPos] = Value(a64units.CodegenA64EncCbnz(false, a64units.CodegenA64X9, int64(1 + callWordCount)))
    let callFillEndPos = PrimaryBodyIRFillCallOp(words,
                                                 cbnzPos + 1,
                                                 bodyIR,
                                                 panicGuardCallOp,
                                                 oi,
                                                 frameBytes,
                                                 paramSaveOffset,
                                                 paramSaveCount)
    if callFillEndPos != cbnzPos + 1 + callWordCount:
        return -1
    # Prefix (addr?+ldr+cbnz) must equal PrimaryBodyIRResultPanicGuardPrefixWordCount.
    let prefixWords = PrimaryBodyIRResultPanicGuardPrefixWordCount(bodyIR, condSlotIndex)
    if prefixWords <= 0 || cbnzPos + 1 - offset != prefixWords:
        return -1
    return callFillEndPos

@borrows
fn PrimaryBodyIRGlobalOpIs64(bodyIR: coreir.BodyIR,
                              op: coreir.BodyOp): bool =
    if op.operands.len < 1:
        return false
    if op.operands[0] < 0:
        return false
    if op.operands[0] >= bodyIR.localSlots.len:
        return false
    let typeKind = bodyIR.localSlots[op.operands[0]].typeKind
    if typeKind == coreir.LocalI64Tag:
        return true
    if typeKind == coreir.LocalPtrTag:
        return true
    return false

@borrows
fn PrimaryBodyIRFillGlobalLoadOp(words: var int32[],
                                  offset: int32,
                                  bodyIR: coreir.BodyIR,
                                  op: coreir.BodyOp,
                                  frameBytes: int32,
                                  paramSaveOffset: int32,
                                  paramSaveCount: int32): int32 =
    if op.operands.len < 1 ||
       op.target < 0 ||
       op.target >= bodyIR.localSlots.len:
        return -1
    let globalSlot = op.operands[0]
    if globalSlot < 0 ||
       globalSlot >= bodyIR.localSlots.len:
        return -1
    if op.operands.len >= 2 &&
       op.operands[1] == 1:
        if bodyIR.localSlots[op.target].typeKind != coreir.LocalPtrTag:
            return -1
        let addrPos = a64units.CodegenA64BodyFillGlobalDataAddress(words, offset, 16)
        if addrPos < 0:
            return -1
        return PrimaryBodyIRStoreRegToSlot(words,
                                           addrPos,
                                           bodyIR,
                                           op.target,
                                           16,
                                           frameBytes,
                                           paramSaveOffset,
                                           paramSaveCount)
    if bodyIR.localSlots[globalSlot].typeKind != bodyIR.localSlots[op.target].typeKind:
        return -1
    if bodyIR.localSlots[globalSlot].typeKind == coreir.LocalStrTag:
        let byteCount = PrimaryLocalSlotSizeOf(bodyIR.localSlots[globalSlot])
        var copyPos = a64units.CodegenA64BodyFillGlobalDataAddress(words, offset, 16)
        copyPos = PrimaryBodyIRLoadStrValueAddressToReg(words,
                                                        copyPos,
                                                        bodyIR,
                                                        op.target,
                                                        a64units.CodegenA64X10,
                                                        frameBytes,
                                                        paramSaveOffset,
                                                        paramSaveCount)
        if copyPos < 0:
            return -1
        return a64units.CodegenA64BodyFillCopyMemory(words,
                                           copyPos,
                                           16,
                                           0,
                                           a64units.CodegenA64X10,
                                           0,
                                           byteCount)
    var pos = a64units.CodegenA64BodyFillGlobalDataAddress(words, offset, 16)
    if pos < 0 || pos >= words.len:
        return -1
    words[pos] = Value(a64units.CodegenA64EncLdrImm(PrimaryBodyIRGlobalOpIs64(bodyIR, op),
                                        a64units.CodegenA64X9,
                                        16,
                                        int64(0)))
    return PrimaryBodyIRStoreRegToSlot(words,
                                       pos + 1,
                                       bodyIR,
                                       op.target,
                                       a64units.CodegenA64X9,
                                       frameBytes,
                                       paramSaveOffset,
                                       paramSaveCount)

@borrows
fn PrimaryBodyIRFillGlobalStoreOp(words: var int32[],
                                   offset: int32,
                                   bodyIR: coreir.BodyIR,
                                   op: coreir.BodyOp,
                                   frameBytes: int32,
                                   paramSaveOffset: int32,
                                   paramSaveCount: int32): int32 =
    if op.operands.len < 1 ||
       op.target < 0 ||
       op.target >= bodyIR.localSlots.len:
        return -1
    let globalSlot = op.operands[0]
    if globalSlot < 0 ||
       globalSlot >= bodyIR.localSlots.len ||
       bodyIR.localSlots[globalSlot].typeKind != bodyIR.localSlots[op.target].typeKind:
        return -1
    if bodyIR.localSlots[globalSlot].typeKind == coreir.LocalStrTag:
        let byteCount = PrimaryLocalSlotSizeOf(bodyIR.localSlots[globalSlot])
        var copyPos = a64units.CodegenA64BodyFillGlobalDataAddress(words, offset, 16)
        copyPos = PrimaryBodyIRLoadStrValueAddressToReg(words,
                                                        copyPos,
                                                        bodyIR,
                                                        op.target,
                                                        a64units.CodegenA64X10,
                                                        frameBytes,
                                                        paramSaveOffset,
                                                        paramSaveCount)
        if copyPos < 0:
            return -1
        return a64units.CodegenA64BodyFillCopyMemory(words,
                                           copyPos,
                                           a64units.CodegenA64X10,
                                           0,
                                           16,
                                           0,
                                           byteCount)
    if bodyIR.localSlots[globalSlot].typeKind == coreir.LocalAggregateTag:
        # Whole-aggregate global store (`gAgg = box.paths`): the source is the
        # materialized value slot (its own bytes for a local, or the incoming
        # pointer for a param). Address the global data label (adrp+add into X16)
        # and the value bytes (X10), then memcpy the exact aggregate width — the
        # scalar Str-imm store below would only move 8 bytes and drop the header.
        let aggByteCount = PrimaryLocalSlotSizeOf(bodyIR.localSlots[globalSlot])
        if aggByteCount <= 0 ||
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[op.target]) != aggByteCount:
            return -1
        var aggCopyPos = a64units.CodegenA64BodyFillGlobalDataAddress(words, offset, 16)
        if aggCopyPos < 0:
            return -1
        let aggSourceOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                            op.target,
                                                            frameBytes,
                                                            paramSaveOffset,
                                                            paramSaveCount)
        if aggSourceOffset < 0:
            return -1
        if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[op.target]):
            if aggCopyPos >= words.len:
                return -1
            words[aggCopyPos] = Value(a64units.CodegenA64EncLdrImm(true,
                                                       a64units.CodegenA64X10,
                                                       a64units.CodegenA64SP,
                                                       int64(aggSourceOffset)))
            aggCopyPos = aggCopyPos + 1
        else:
            aggCopyPos = a64units.CodegenA64BodyFillStackAddressToReg(words,
                                                            aggCopyPos,
                                                            a64units.CodegenA64X10,
                                                            aggSourceOffset)
            if aggCopyPos < 0:
                return -1
        return a64units.CodegenA64BodyFillCopyMemory(words,
                                           aggCopyPos,
                                           a64units.CodegenA64X10,
                                           0,
                                           16,
                                           0,
                                           aggByteCount)
    var pos = a64units.CodegenA64BodyFillGlobalDataAddress(words, offset, 16)
    pos = PrimaryBodyIRLoadSlotToReg(words,
                                     pos,
                                     bodyIR,
                                     op.target,
                                     a64units.CodegenA64X9,
                                     frameBytes,
                                     paramSaveOffset,
                                     paramSaveCount)
    if pos < 0 || pos >= words.len:
        return -1
    words[pos] = Value(a64units.CodegenA64EncStrImm(PrimaryBodyIRGlobalOpIs64(bodyIR, op),
                                        a64units.CodegenA64X9,
                                        16,
                                        int64(0)))
    return pos + 1

@borrows
fn PrimaryBodyIRFillBlockOp(words: var int32[],
                             offset: int32,
                             bodyIR: coreir.BodyIR,
                             bi: int32,
                             oi: int32): int32 =
    let _ = bi
    if offset < 0 || offset >= words.len || oi < 0 || oi >= bodyIR.ops.len:
        return -1
    let frameBytes = PrimaryBodyIrFrameBytes(bodyIR)
    let paramSaveOffset = PrimaryBodyIrParamSaveOffset(bodyIR)
    let paramSaveCount = PrimaryBodyIrParamSaveCount(bodyIR)
    let op = bodyIR.ops[oi]
    # Step B-data (data reloc emit-first): for a covered bare cstring / global load-store op the
    # anchoring ADRP is this op's FIRST emitted word, so `offset` (the real serial fill cursor) IS the
    # real ADRP position. Record it keyed by the structural identity (function base, opIndex, subIndex)
    # — a single-reloc op, so subIndex is 0. No predictor / no desync compare: the real position IS the
    # offset. FillAndCheck joins (realFunctionBase, oi, 0) to write the data reloc word offset directly.
    if primaryBackpatchActive && PrimaryBodyIrOpHasDataReloc(bodyIR, oi):
        PrimaryBackpatchRecordDataRelocEmitFirst(oi, 0, offset)
    if op.kind == coreir.BodyOpCallTag:
        return PrimaryBodyIRFillCallOp(words, offset, bodyIR, op, oi, frameBytes, paramSaveOffset, paramSaveCount)
    if op.kind == coreir.BodyOpLoadConstTag:
        if op.operands.len < 2 || offset + 1 >= words.len:
            return -1
        let constType = op.operands[0]
        if constType != coreir.LocalI32Tag &&
           constType != coreir.LocalI64Tag &&
           constType != coreir.LocalF64Tag &&
           constType != coreir.LocalPtrTag:
            return -1
        let constIs64 = constType != coreir.LocalI32Tag
        var constPos = offset
        if op.operands.len >= 5:
            # 64-bit literal as four 16-bit chunks (movz + movk per nonzero chunk)
            words[constPos] = a64units.CodegenA64EncMovz(true, a64units.CodegenA64X9, op.operands[1] & 65535, 0)
            constPos = constPos + 1
            for chunkIndex in 2..<5:
                if op.operands[chunkIndex] != 0:
                    if constPos >= words.len:
                        return -1
                    words[constPos] = a64units.CodegenA64EncMovk(true,
                                                     a64units.CodegenA64X9,
                                                     op.operands[chunkIndex] & 65535,
                                                     chunkIndex - 1)
                    constPos = constPos + 1
            return PrimaryBodyIRStoreRegToSlot(words, constPos, bodyIR, op.target, a64units.CodegenA64X9, frameBytes, paramSaveOffset, paramSaveCount)
        let constValue = op.operands[1]
        if constValue >= 0 && constValue <= 65535:
            words[constPos] = a64units.CodegenA64EncMovz(constIs64, a64units.CodegenA64X9, constValue, 0)
            constPos = constPos + 1
        elif constValue < 0 && constValue >= -65536:
            words[constPos] = a64units.CodegenA64EncMovn(constIs64,
                                             a64units.CodegenA64X9,
                                             (0 - constValue - 1) & 65535,
                                             0)
            constPos = constPos + 1
        else:
            if constPos + 2 >= words.len:
                return -1
            if constValue < 0:
                words[constPos] = a64units.CodegenA64EncMovn(constIs64,
                                                 a64units.CodegenA64X9,
                                                 (0 - constValue - 1) & 65535,
                                                 0)
            else:
                words[constPos] = a64units.CodegenA64EncMovz(constIs64, a64units.CodegenA64X9, constValue & 65535, 0)
            words[constPos + 1] = a64units.CodegenA64EncMovk(constIs64,
                                                 a64units.CodegenA64X9,
                                                 (constValue >> 16) & 65535,
                                                 1)
            constPos = constPos + 2
        return PrimaryBodyIRStoreRegToSlot(words, constPos, bodyIR, op.target, a64units.CodegenA64X9, frameBytes, paramSaveOffset, paramSaveCount)
    if op.kind == coreir.BodyOpCopyLocalTag ||
       op.kind == coreir.BodyOpStoreLocalTag:
        if op.operands.len < 1:
            return -1
        let copySrcElideLen: int32 = bodyIR.layoutCopySrcElide.len
        # Stage-1 peephole: plain I64->I64 copy whose source is already X9-resident (the
        # preceding store-elided BinOp left it there). Skip the source `ldr x9,[src]` and store
        # X9 straight to the target. The gate (PrimaryBodyIrCopySrcElidableAt) guarantees both
        # slots are plain I64, so the emission is exactly the store half of a normal copy.
        # MUST mirror the size predictor's matching subtraction or the two passes desync.
        var copyPos: int32
        if oi >= 0 && oi < copySrcElideLen && bodyIR.layoutCopySrcElide[oi]:
            copyPos = PrimaryBodyIRStoreRegToSlot(words, offset, bodyIR, op.target, a64units.CodegenA64X9, frameBytes, paramSaveOffset, paramSaveCount)
        else:
            copyPos = PrimaryBodyIRCopySlot(words, offset, bodyIR, op.operands[0], op.target, frameBytes, paramSaveOffset, paramSaveCount)
        return copyPos
    if op.kind == coreir.BodyOpBinOpTag:
        return PrimaryBodyIRFillBinOp(words, offset, bodyIR, op, oi, frameBytes, paramSaveOffset, paramSaveCount)
    if op.kind == coreir.BodyOpCmpTag:
        return PrimaryBodyIRFillCmpOp(words, offset, bodyIR, op, oi, frameBytes, paramSaveOffset, paramSaveCount)
    if op.kind == coreir.BodyOpResultProjectTag:
        return PrimaryBodyIRFillResultProjectOp(words, offset, bodyIR, op, frameBytes, paramSaveOffset, paramSaveCount)
    if op.kind == coreir.BodyOpResultPanicGuardTag:
        return PrimaryBodyIRFillResultPanicGuardOp(words, offset, bodyIR, op, oi, frameBytes, paramSaveOffset, paramSaveCount)
    if op.kind == coreir.BodyOpStrEqLiteralTag:
        return PrimaryBodyIRFillStrEqLiteralOp(words, offset, bodyIR, op, frameBytes, paramSaveOffset, paramSaveCount)
    if op.kind == coreir.BodyOpStrEqTag:
        return PrimaryBodyIRFillStrEqOp(words, offset, bodyIR, op, frameBytes, paramSaveOffset, paramSaveCount)
    if op.kind == coreir.BodyOpGlobalLoadTag:
        return PrimaryBodyIRFillGlobalLoadOp(words, offset, bodyIR, op, frameBytes, paramSaveOffset, paramSaveCount)
    if op.kind == coreir.BodyOpGlobalStoreTag:
        return PrimaryBodyIRFillGlobalStoreOp(words, offset, bodyIR, op, frameBytes, paramSaveOffset, paramSaveCount)
    if op.kind == coreir.BodyOpFieldLoadTag:
        if op.operands.len < 4:
            return -1
        let baseSlot = op.operands[0]
        let valueSlot = op.operands[1]
        let byteOffset = op.operands[2]
        let byteCount = op.operands[3]
        var primaryColdCond23: bool
        if op.target != valueSlot:
            primaryColdCond23 = true
        if baseSlot < 0:
            primaryColdCond23 = true
        if baseSlot >= bodyIR.localSlots.len:
            primaryColdCond23 = true
        if valueSlot < 0:
            primaryColdCond23 = true
        if valueSlot >= bodyIR.localSlots.len:
            primaryColdCond23 = true
        if byteOffset < 0:
            primaryColdCond23 = true
        if byteCount <= 0:
            primaryColdCond23 = true
        if PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < byteCount:
            primaryColdCond23 = true
        if primaryColdCond23:
            return -1
        var pos = offset
        var sourceReg = a64units.CodegenA64SP
        var sourceOffset = byteOffset
        if bodyIR.localSlots[baseSlot].placeKind ==
           coreir.BodyPlaceGlobalAddressTag:
            let baseSize = PrimaryLocalSlotSizeOf(
                bodyIR.localSlots[baseSlot])
            if baseSize > 0 && byteOffset > baseSize - byteCount:
                return -1
            pos = a64units.CodegenA64BodyFillGlobalDataAddress(
                words, pos, a64units.CodegenA64X9)
            if pos < 0:
                return -1
            sourceReg = a64units.CodegenA64X9
            if PrimaryBodyIrFieldAccessNeedsAddressReg(
                   sourceOffset, byteCount) ||
               PrimaryBodyIrCopySideNeedsAddressReg(
                   sourceOffset, byteCount):
                pos = a64units.CodegenA64BodyFillRegAddImmToReg(
                    words, pos, sourceReg, sourceReg, sourceOffset)
                if pos < 0:
                    return -1
                sourceOffset = 0
        elif bodyIR.localSlots[baseSlot].typeKind == coreir.LocalStrTag:
            pos = PrimaryBodyIRLoadStrValueAddressToReg(words,
                                                        pos,
                                                        bodyIR,
                                                        baseSlot,
                                                        a64units.CodegenA64X9,
                                                        frameBytes,
                                                        paramSaveOffset,
                                                        paramSaveCount)
            if pos < 0:
                return -1
            sourceReg = a64units.CodegenA64X9
        elif bodyIR.localSlots[baseSlot].typeKind == coreir.LocalPtrTag ||
             (bodyIR.localSlots[baseSlot].typeKind == coreir.LocalAggregateTag &&
              PrimaryBodyIrLocalIsParam(bodyIR.localSlots[baseSlot])):
            # aggregate params hold the struct address in the saved register
            # slot: load the pointer, then address fields through it
            pos = PrimaryBodyIRLoadSlotToReg(words,
                                             pos,
                                             bodyIR,
                                             baseSlot,
                                             a64units.CodegenA64X9,
                                             frameBytes,
                                             paramSaveOffset,
                                             paramSaveCount)
            if pos < 0:
                return -1
            sourceReg = a64units.CodegenA64X9
        else:
            let baseOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                           baseSlot,
                                                           frameBytes,
                                                           paramSaveOffset,
                                                           paramSaveCount)
            let baseSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[baseSlot])
            if baseOffset < 0:
                return -1
            if baseSize > 0 && byteOffset > baseSize - byteCount:
                return -1
            sourceOffset = baseOffset + byteOffset
            if PrimaryBodyIrFieldAccessNeedsAddressReg(sourceOffset, byteCount):
                pos = a64units.CodegenA64BodyFillStackAddressToReg(words,
                                                         pos,
                                                         a64units.CodegenA64X9,
                                                         sourceOffset)
                if pos < 0:
                    return -1
                sourceReg = a64units.CodegenA64X9
                sourceOffset = 0
        # Ptr/aggregate-param/str base addresses live in a register (X9), not
        # SP: the byte-imm ceiling guard above only fires for the SP-direct
        # branch, so a register-based field access with a large raw
        # byteOffset previously reached the byteCount%8/%4 or CopyMemory
        # encoders unmaterialized and A64EncLdrbImm/A64EncStrImm returned Err
        # (imm12 range exceeded) whose zero-value word triggered a zero-scan
        # primary_fill_failed bail. Fold the offset into the register here,
        # before any width-specific encoder runs, mirroring the SP path.
        if sourceReg != a64units.CodegenA64SP &&
           PrimaryBodyIrCopySideNeedsAddressReg(sourceOffset, byteCount):
            pos = a64units.CodegenA64BodyFillRegAddImmToReg(words,
                                                  pos,
                                                  sourceReg,
                                                  sourceReg,
                                                  sourceOffset)
            if pos < 0:
                return -1
            sourceOffset = 0
        var targetOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                         valueSlot,
                                                         frameBytes,
                                                         paramSaveOffset,
                                                         paramSaveCount)
        if targetOffset < 0:
            return -1
        # Mirror the source-side ceiling guard for the STR target: at large
        # frames targetOffset overflows the scaled-imm STR ceiling (32760 for
        # 8-byte / 16380 for 4-byte). A64EncStrImm then returns Err whose
        # zero-value gets written as a 0x00000000 instruction word. Materialize
        # the target address into a free register and store at offset 0 just like
        # the source side. X13 is used (not X11): X9=source addr, X10=copy value,
        # X12=slow-path target fill, and PrimaryBodyIRFillCopyMemory clobbers X11
        # internally — so a targetReg flowing into the CopyMemory fallback must
        # avoid X11.
        var targetReg = a64units.CodegenA64SP
        if PrimaryBodyIrFieldAccessNeedsAddressReg(targetOffset, byteCount):
            pos = a64units.CodegenA64BodyFillStackAddressToReg(words,
                                                     pos,
                                                     a64units.CodegenA64X13,
                                                     targetOffset)
            if pos < 0:
                return -1
            targetReg = a64units.CodegenA64X13
            targetOffset = 0
        if byteCount % 8 == 0 &&
           sourceOffset % 8 == 0 &&
           targetOffset % 8 == 0:
            if byteCount <= 32760:
                for copyIndex in 0..<(byteCount / 8):
                    if pos + 1 >= words.len:
                        return -1
                    words[pos] = Value(a64units.CodegenA64EncLdrImm(true,
                                                        a64units.CodegenA64X10,
                                                        sourceReg,
                                                        int64(sourceOffset + copyIndex * 8)))
                    words[pos + 1] = Value(a64units.CodegenA64EncStrImm(true,
                                                            a64units.CodegenA64X10,
                                                            targetReg,
                                                            int64(targetOffset + copyIndex * 8)))
                    pos = pos + 2
                return pos
            # Slow path: byteCount alone exceeds the LDR/STR X (64-bit, scaled by
            # 8) imm12 ceiling (4095*8 = 32760) even at offset 0 -- e.g. a large
            # fixed-size aggregate field (streams: YamuxStreamState[256]) read
            # wholesale in one FieldLoad (var-param entry copy-in materializing
            # the caller's field into a local value slot). sourceOffset/
            # targetOffset are already forced to 0 in a non-SP register above
            # whenever byteCount alone exceeds the shared 16000/4000-byte
            # address-materialization thresholds
            # (PrimaryBodyIrFieldAccessNeedsAddressReg /
            # PrimaryBodyIrCopySideNeedsAddressReg), which always fires once
            # byteCount > 32760 -- so this branch is only ever reached with
            # sourceOffset==0, targetOffset==0, and non-SP base registers. Copy
            # in fixed 32760-byte (4095-element) windows, re-folding both bases
            # forward by exactly one window (PrimaryBodyIRFillRegAddImmToReg,
            # itself internally chunked at 4095 bytes per ADD) between windows
            # so every LDR/STR stays inside its own imm12 window regardless of
            # total byteCount. If that invariant is ever violated, fail loudly
            # instead of corrupting the base register or silently truncating
            # the copy.
            if sourceOffset != 0 || targetOffset != 0 ||
               sourceReg == a64units.CodegenA64SP || targetReg == a64units.CodegenA64SP:
                return -1
            var remaining8 = byteCount
            while remaining8 > 0:
                var chunk8 = remaining8
                if chunk8 > 32760:
                    chunk8 = 32760
                for copyIndex in 0..<(chunk8 / 8):
                    if pos + 1 >= words.len:
                        return -1
                    words[pos] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X10, sourceReg, int64(copyIndex * 8)))
                    words[pos + 1] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X10, targetReg, int64(copyIndex * 8)))
                    pos = pos + 2
                remaining8 = remaining8 - chunk8
                if remaining8 > 0:
                    pos = a64units.CodegenA64BodyFillRegAddImmToReg(words, pos, sourceReg, sourceReg, chunk8)
                    if pos < 0:
                        return -1
                    pos = a64units.CodegenA64BodyFillRegAddImmToReg(words, pos, targetReg, targetReg, chunk8)
                    if pos < 0:
                        return -1
            return pos
        if byteCount % 4 == 0 &&
           sourceOffset % 4 == 0 &&
           targetOffset % 4 == 0:
            for copyIndex in 0..<(byteCount / 4):
                if pos + 1 >= words.len:
                    return -1
                words[pos] = Value(a64units.CodegenA64EncLdrImm(false,
                                                    a64units.CodegenA64X10,
                                                    sourceReg,
                                                    int64(sourceOffset + copyIndex * 4)))
                words[pos + 1] = Value(a64units.CodegenA64EncStrImm(false,
                                                        a64units.CodegenA64X10,
                                                        targetReg,
                                                        int64(targetOffset + copyIndex * 4)))
                pos = pos + 2
            return pos
        var copyLoadSourceReg = sourceReg
        var copyLoadSourceOffset = sourceOffset
        if copyLoadSourceReg == a64units.CodegenA64SP &&
           PrimaryBodyIrCopySideNeedsAddressReg(copyLoadSourceOffset, byteCount):
            pos = a64units.CodegenA64BodyFillStackAddressToReg(words,
                                                     pos,
                                                     a64units.CodegenA64X9,
                                                     copyLoadSourceOffset)
            if pos < 0:
                return -1
            copyLoadSourceReg = a64units.CodegenA64X9
            copyLoadSourceOffset = 0
        var copyLoadTargetReg = targetReg
        var copyLoadTargetOffset = targetOffset
        if copyLoadTargetReg == a64units.CodegenA64SP &&
           PrimaryBodyIrCopySideNeedsAddressReg(copyLoadTargetOffset, byteCount):
            pos = a64units.CodegenA64BodyFillStackAddressToReg(words,
                                                     pos,
                                                     a64units.CodegenA64X12,
                                                     copyLoadTargetOffset)
            if pos < 0:
                return -1
            copyLoadTargetReg = a64units.CodegenA64X12
            copyLoadTargetOffset = 0
        if byteCount == 1:
            # bool/uint8 field load: zero-extend into the full 4-byte value
            # slot. A 1-byte store would leave the slot's upper bytes dirty
            # and the 4-byte condition load would read stack garbage.
            # Same 2-word footprint as the byte-copy path.
            if pos + 1 >= words.len:
                return -1
            words[pos] = Value(a64units.CodegenA64EncLdrbImm(a64units.CodegenA64X10,
                                                 copyLoadSourceReg,
                                                 copyLoadSourceOffset))
            words[pos + 1] = Value(a64units.CodegenA64EncStrImm(false,
                                                    a64units.CodegenA64X10,
                                                    copyLoadTargetReg,
                                                    int64(copyLoadTargetOffset)))
            return pos + 2
        return a64units.CodegenA64BodyFillCopyMemory(words,
                                           pos,
                                           copyLoadSourceReg,
                                           copyLoadSourceOffset,
                                           copyLoadTargetReg,
                                           copyLoadTargetOffset,
                                           byteCount)
    if op.kind == coreir.BodyOpFieldStoreTag:
        if op.operands.len < 4:
            return -1
        let baseSlot = op.operands[0]
        let valueSlot = op.operands[1]
        let byteOffset = op.operands[2]
        let byteCount = op.operands[3]
        var primaryColdCond24: bool
        if op.target != baseSlot:
            primaryColdCond24 = true
        if baseSlot < 0:
            primaryColdCond24 = true
        if baseSlot >= bodyIR.localSlots.len:
            primaryColdCond24 = true
        if valueSlot < 0:
            primaryColdCond24 = true
        if valueSlot >= bodyIR.localSlots.len:
            primaryColdCond24 = true
        if byteOffset < 0:
            primaryColdCond24 = true
        if byteCount <= 0:
            primaryColdCond24 = true
        if PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < byteCount:
            primaryColdCond24 = true
        if primaryColdCond24:
            return -1
        var pos = offset
        var targetReg = a64units.CodegenA64SP
        var targetOffset = byteOffset
        let targetIsGlobal =
            bodyIR.localSlots[baseSlot].placeKind ==
                coreir.BodyPlaceGlobalAddressTag
        if targetIsGlobal:
            let baseSize = PrimaryLocalSlotSizeOf(
                bodyIR.localSlots[baseSlot])
            if baseSize > 0 && byteOffset > baseSize - byteCount:
                return -1
            pos = a64units.CodegenA64BodyFillGlobalDataAddress(
                words, pos, a64units.CodegenA64X9)
            if pos < 0:
                return -1
            targetReg = a64units.CodegenA64X9
            if PrimaryBodyIrFieldAccessNeedsAddressReg(
                   targetOffset, byteCount) ||
               PrimaryBodyIrCopySideNeedsAddressReg(
                   targetOffset, byteCount):
                pos = a64units.CodegenA64BodyFillRegAddImmToReg(
                    words, pos, targetReg, targetReg, targetOffset)
                if pos < 0:
                    return -1
                targetOffset = 0
        var sourceOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                         valueSlot,
                                                         frameBytes,
                                                         paramSaveOffset,
                                                         paramSaveCount)
        if sourceOffset < 0:
            pos = PrimaryBodyIRLoadSlotToReg(words,
                                             pos,
                                             bodyIR,
                                             valueSlot,
                                             a64units.CodegenA64X10,
                                             frameBytes,
                                             paramSaveOffset,
                                             paramSaveCount)
            if pos < 0 || pos >= words.len:
                return -1
            words[pos] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X10, a64units.CodegenA64SP, int64(0)))
            return pos + 1
        # Mirror the target-side ceiling guard for the LDR source: at large frames
        # sourceOffset overflows the scaled-imm LDR ceiling (32760 for 8-byte /
        # 16380 for 4-byte). A64EncLdrImm then returns Err whose zero-value gets
        # written as a 0x00000000 word. Materialize the source address into a free
        # register (X13: X9=target addr, X10=copy value, X12=slow-path source fill,
        # X11=PrimaryBodyIRFillCopyMemory scratch) and load at offset 0.
        var sourceReg = a64units.CodegenA64SP
        if PrimaryBodyIrFieldAccessNeedsAddressReg(sourceOffset, byteCount):
            pos = a64units.CodegenA64BodyFillStackAddressToReg(words,
                                                     pos,
                                                     a64units.CodegenA64X13,
                                                     sourceOffset)
            if pos < 0:
                return -1
            sourceReg = a64units.CodegenA64X13
            sourceOffset = 0
        if !targetIsGlobal &&
           (bodyIR.localSlots[baseSlot].typeKind == coreir.LocalPtrTag ||
           ((bodyIR.localSlots[baseSlot].typeKind == coreir.LocalStrTag ||
             bodyIR.localSlots[baseSlot].typeKind == coreir.LocalAggregateTag) &&
            PrimaryBodyIrLocalIsParam(bodyIR.localSlots[baseSlot]))):
            # str/aggregate params hold the value address in the saved register
            # slot: load the pointer, then address fields through it
            pos = PrimaryBodyIRLoadSlotToReg(words,
                                             pos,
                                             bodyIR,
                                             baseSlot,
                                             a64units.CodegenA64X9,
                                             frameBytes,
                                             paramSaveOffset,
                                             paramSaveCount)
            if pos < 0:
                return -1
            targetReg = a64units.CodegenA64X9
        elif !targetIsGlobal:
            let baseOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                           baseSlot,
                                                           frameBytes,
                                                           paramSaveOffset,
                                                           paramSaveCount)
            let baseSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[baseSlot])
            if baseOffset < 0:
                return -1
            if baseSize > 0 && byteOffset > baseSize - byteCount:
                return -1
            targetOffset = baseOffset + byteOffset
            if PrimaryBodyIrFieldAccessNeedsAddressReg(targetOffset, byteCount):
                pos = a64units.CodegenA64BodyFillStackAddressToReg(words,
                                                         pos,
                                                         a64units.CodegenA64X9,
                                                         targetOffset)
                if pos < 0:
                    return -1
                targetReg = a64units.CodegenA64X9
                targetOffset = 0
        # Mirror of the FieldLoad fold above: the Ptr/str/aggregate-param
        # base branch just above leaves targetOffset as the raw byteOffset in
        # a register (X9), unmaterialized. Fold it here before any
        # width-specific encoder runs.
        if targetReg != a64units.CodegenA64SP &&
           PrimaryBodyIrCopySideNeedsAddressReg(targetOffset, byteCount):
            pos = a64units.CodegenA64BodyFillRegAddImmToReg(words,
                                                  pos,
                                                  targetReg,
                                                  targetReg,
                                                  targetOffset)
            if pos < 0:
                return -1
            targetOffset = 0
        if byteCount % 8 == 0 &&
           sourceOffset % 8 == 0 &&
           targetOffset % 8 == 0:
            if byteCount <= 32760:
                for copyIndex in 0..<(byteCount / 8):
                    if pos + 1 >= words.len:
                        return -1
                    words[pos] = Value(a64units.CodegenA64EncLdrImm(true,
                                                        a64units.CodegenA64X10,
                                                        sourceReg,
                                                        int64(sourceOffset + copyIndex * 8)))
                    words[pos + 1] = Value(a64units.CodegenA64EncStrImm(true,
                                                            a64units.CodegenA64X10,
                                                            targetReg,
                                                            int64(targetOffset + copyIndex * 8)))
                    pos = pos + 2
                return pos
            # Slow path: byteCount alone exceeds the LDR/STR X (64-bit, scaled by
            # 8) imm12 ceiling (4095*8 = 32760) even at offset 0 -- e.g. a large
            # fixed-size aggregate field (streams: YamuxStreamState[256]) stored
            # wholesale in one FieldStore. sourceOffset/targetOffset are already
            # forced to 0 in a non-SP register above whenever byteCount alone
            # exceeds the shared 16000/4000-byte address-materialization
            # thresholds (PrimaryBodyIrFieldAccessNeedsAddressReg /
            # PrimaryBodyIrCopySideNeedsAddressReg), which always fires once
            # byteCount > 32760 -- so this branch is only ever reached with
            # sourceOffset==0, targetOffset==0, and non-SP base registers. Copy
            # in fixed 32760-byte (4095-element) windows, re-folding both bases
            # forward by exactly one window (PrimaryBodyIRFillRegAddImmToReg,
            # itself internally chunked at 4095 bytes per ADD) between windows
            # so every LDR/STR stays inside its own imm12 window regardless of
            # total byteCount. If that invariant is ever violated, fail loudly
            # instead of corrupting the base register or silently truncating
            # the copy.
            if sourceOffset != 0 || targetOffset != 0 ||
               sourceReg == a64units.CodegenA64SP || targetReg == a64units.CodegenA64SP:
                return -1
            var remaining8 = byteCount
            while remaining8 > 0:
                var chunk8 = remaining8
                if chunk8 > 32760:
                    chunk8 = 32760
                for copyIndex in 0..<(chunk8 / 8):
                    if pos + 1 >= words.len:
                        return -1
                    words[pos] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X10, sourceReg, int64(copyIndex * 8)))
                    words[pos + 1] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X10, targetReg, int64(copyIndex * 8)))
                    pos = pos + 2
                remaining8 = remaining8 - chunk8
                if remaining8 > 0:
                    pos = a64units.CodegenA64BodyFillRegAddImmToReg(words, pos, sourceReg, sourceReg, chunk8)
                    if pos < 0:
                        return -1
                    pos = a64units.CodegenA64BodyFillRegAddImmToReg(words, pos, targetReg, targetReg, chunk8)
                    if pos < 0:
                        return -1
            return pos
        if byteCount % 4 == 0 &&
           sourceOffset % 4 == 0 &&
           targetOffset % 4 == 0:
            for copyIndex in 0..<(byteCount / 4):
                if pos + 1 >= words.len:
                    return -1
                words[pos] = Value(a64units.CodegenA64EncLdrImm(false,
                                                    a64units.CodegenA64X10,
                                                    sourceReg,
                                                    int64(sourceOffset + copyIndex * 4)))
                words[pos + 1] = Value(a64units.CodegenA64EncStrImm(false,
                                                        a64units.CodegenA64X10,
                                                        targetReg,
                                                        int64(targetOffset + copyIndex * 4)))
                pos = pos + 2
            return pos
        var copyStoreSourceReg = sourceReg
        var copyStoreSourceOffset = sourceOffset
        if copyStoreSourceReg == a64units.CodegenA64SP &&
           PrimaryBodyIrCopySideNeedsAddressReg(copyStoreSourceOffset, byteCount):
            pos = a64units.CodegenA64BodyFillStackAddressToReg(words,
                                                     pos,
                                                     a64units.CodegenA64X12,
                                                     copyStoreSourceOffset)
            if pos < 0:
                return -1
            copyStoreSourceReg = a64units.CodegenA64X12
            copyStoreSourceOffset = 0
        var copyStoreTargetReg = targetReg
        var copyStoreTargetOffset = targetOffset
        if copyStoreTargetReg == a64units.CodegenA64SP &&
           PrimaryBodyIrCopySideNeedsAddressReg(copyStoreTargetOffset, byteCount):
            pos = a64units.CodegenA64BodyFillStackAddressToReg(words,
                                                     pos,
                                                     a64units.CodegenA64X9,
                                                     copyStoreTargetOffset)
            if pos < 0:
                return -1
            copyStoreTargetReg = a64units.CodegenA64X9
            copyStoreTargetOffset = 0
        return a64units.CodegenA64BodyFillCopyMemory(words,
                                           pos,
                                           copyStoreSourceReg,
                                           copyStoreSourceOffset,
                                           copyStoreTargetReg,
                                           copyStoreTargetOffset,
                                           byteCount)
    if op.kind == coreir.BodyOpIndexedLoadTag:
        if op.operands.len < 2:
            return -1
        if op.operands.len >= 4 &&
           op.operands[0] >= 0 &&
           op.operands[0] < bodyIR.localSlots.len &&
           (bodyIR.localSlots[op.operands[0]].typeKind == coreir.LocalAggregateTag ||
            (bodyIR.localSlots[op.operands[0]].typeKind == coreir.LocalPtrTag &&
             op.operands.len >= 5 && op.operands[4] == 1)):
            let elemSize = op.operands[3]
            var pos = PrimaryBodyIRFillIndexedAggregateAddressToReg(words,
                                                                    offset,
                                                                    bodyIR,
                                                                    op,
                                                                    a64units.CodegenA64X9,
                                                                    a64units.CodegenA64X10,
                                                                    a64units.CodegenA64X11,
                                                                    a64units.CodegenA64X12,
                                                                    frameBytes,
                                                                    paramSaveOffset,
                                                                    paramSaveCount)
            if pos < 0:
                return -1
            if elemSize == 1:
                if pos >= words.len:
                    return -1
                words[pos] = Value(a64units.CodegenA64EncLdrbImm(a64units.CodegenA64X10, a64units.CodegenA64X9, 0))
                return PrimaryBodyIRStoreRegToSlot(words, pos + 1, bodyIR, op.operands[1], a64units.CodegenA64X10, frameBytes, paramSaveOffset, paramSaveCount)
            if elemSize == 4:
                if pos >= words.len:
                    return -1
                words[pos] = Value(a64units.CodegenA64EncLdrImm(false, a64units.CodegenA64X10, a64units.CodegenA64X9, int64(0)))
                return PrimaryBodyIRStoreRegToSlot(words, pos + 1, bodyIR, op.operands[1], a64units.CodegenA64X10, frameBytes, paramSaveOffset, paramSaveCount)
            if elemSize == 8:
                if pos >= words.len:
                    return -1
                words[pos] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X10, a64units.CodegenA64X9, int64(0)))
                return PrimaryBodyIRStoreRegToSlot(words, pos + 1, bodyIR, op.operands[1], a64units.CodegenA64X10, frameBytes, paramSaveOffset, paramSaveCount)
            if elemSize == 16:
                if op.operands[1] < 0 ||
                   op.operands[1] >= bodyIR.localSlots.len ||
                   bodyIR.localSlots[op.operands[1]].typeKind != coreir.LocalAggregateTag:
                    return -1
                pos = PrimaryBodyIRLoadSlotToReg(words, pos, bodyIR, op.operands[1], a64units.CodegenA64X11, frameBytes, paramSaveOffset, paramSaveCount)
                if pos < 0 || pos + 3 >= words.len:
                    return -1
                words[pos] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X9, int64(0)))
                words[pos + 1] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X11, int64(0)))
                words[pos + 2] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X9, int64(8)))
                words[pos + 3] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X11, int64(8)))
                return pos + 4
            if elemSize == 24:
                if op.operands[1] < 0 ||
                   op.operands[1] >= bodyIR.localSlots.len ||
                   bodyIR.localSlots[op.operands[1]].typeKind != coreir.LocalStrTag:
                    return -1
                pos = PrimaryBodyIRLoadSlotToReg(words, pos, bodyIR, op.operands[1], a64units.CodegenA64X11, frameBytes, paramSaveOffset, paramSaveCount)
                if pos < 0 || pos + 5 >= words.len:
                    return -1
                words[pos] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X9, int64(0)))
                words[pos + 1] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X11, int64(0)))
                words[pos + 2] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X9, int64(8)))
                words[pos + 3] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X11, int64(8)))
                words[pos + 4] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X9, int64(16)))
                words[pos + 5] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X11, int64(16)))
                return pos + 6
            # General aggregate element load (`xs[i]` reads N-byte struct element
            # by value): the source element address is in X9; copy the bytes 8 at
            # a time into the value slot's materialized address in X11. Covers any
            # struct element whose size is a multiple of 8 (e.g. anon-tuple 64B).
            # Mirrors the IndexedStore general aggregate emit branch below.
            let loadAggValueType = PrimaryBodyIrSlotType(bodyIR, op.operands[1])
            if loadAggValueType == coreir.LocalAggregateTag && elemSize > 0 && (elemSize % 8) == 0:
                if op.operands[1] < 0 || op.operands[1] >= bodyIR.localSlots.len:
                    return -1
                pos = PrimaryBodyIRLoadSlotToReg(words, pos, bodyIR, op.operands[1], a64units.CodegenA64X11, frameBytes, paramSaveOffset, paramSaveCount)
                if pos < 0:
                    return -1
                let loadAggChunks = elemSize / 8
                if pos + (loadAggChunks * 2) - 1 >= words.len:
                    return -1
                for loadAggChunk in 0..<loadAggChunks:
                    let loadAggByteOff = int64(loadAggChunk * 8)
                    words[pos] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X9, loadAggByteOff))
                    words[pos + 1] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X11, loadAggByteOff))
                    pos = pos + 2
                return pos
            return -1
        var pos = offset
        if op.operands[0] >= 0 &&
           op.operands[0] < bodyIR.localSlots.len &&
           bodyIR.localSlots[op.operands[0]].placeKind ==
               coreir.BodyPlaceGlobalAddressTag:
            pos = a64units.CodegenA64BodyFillGlobalDataAddress(
                words, pos, a64units.CodegenA64X9)
        else:
            pos = PrimaryBodyIRLoadSlotToReg(
                words, pos, bodyIR, op.operands[0], a64units.CodegenA64X9,
                frameBytes, paramSaveOffset, paramSaveCount)
        if pos < 0 || pos + 1 >= words.len:
            return -1
        let resultType = PrimaryBodyIrSlotType(bodyIR, op.operands[1])
        var is64: bool
        if resultType == coreir.LocalI64Tag:
            is64 = true
        elif resultType == coreir.LocalPtrTag:
            is64 = true
        elif resultType == coreir.LocalStrTag:
            is64 = true
        elif resultType == coreir.LocalAggregateTag:
            is64 = true
        words[pos] = Value(a64units.CodegenA64EncLdrImm(is64, a64units.CodegenA64X10, a64units.CodegenA64X9, int64(0)))
        return PrimaryBodyIRStoreRegToSlot(words, pos + 1, bodyIR, op.operands[1], a64units.CodegenA64X10, frameBytes, paramSaveOffset, paramSaveCount)
    if op.kind == coreir.BodyOpIndexedStoreTag:
        if op.operands.len < 2:
            return -1
        if op.operands.len >= 4 &&
           op.operands[0] >= 0 &&
           op.operands[0] < bodyIR.localSlots.len &&
           (bodyIR.localSlots[op.operands[0]].typeKind == coreir.LocalAggregateTag ||
            (bodyIR.localSlots[op.operands[0]].typeKind == coreir.LocalPtrTag &&
             op.operands.len >= 5 && op.operands[4] == 1)):
            let elemSize = op.operands[3]
            var pos = PrimaryBodyIRFillIndexedAggregateAddressToReg(words,
                                                                    offset,
                                                                    bodyIR,
                                                                    op,
                                                                    a64units.CodegenA64X9,
                                                                    a64units.CodegenA64X10,
                                                                    a64units.CodegenA64X12,
                                                                    a64units.CodegenA64X13,
                                                                    frameBytes,
                                                                    paramSaveOffset,
                                                                    paramSaveCount)
            if pos < 0:
                return -1
            if elemSize == 1:
                pos = PrimaryBodyIRLoadSlotToReg(words, pos, bodyIR, op.operands[1], a64units.CodegenA64X11, frameBytes, paramSaveOffset, paramSaveCount)
                if pos < 0 || pos >= words.len:
                    return -1
                words[pos] = Value(a64units.CodegenA64EncStrbImm(a64units.CodegenA64X11, a64units.CodegenA64X9, 0))
                return pos + 1
            if elemSize == 4:
                pos = PrimaryBodyIRLoadSlotToReg(words, pos, bodyIR, op.operands[1], a64units.CodegenA64X11, frameBytes, paramSaveOffset, paramSaveCount)
                if pos < 0 || pos >= words.len:
                    return -1
                words[pos] = Value(a64units.CodegenA64EncStrImm(false, a64units.CodegenA64X11, a64units.CodegenA64X9, int64(0)))
                return pos + 1
            if elemSize == 8:
                pos = PrimaryBodyIRLoadSlotToReg(words, pos, bodyIR, op.operands[1], a64units.CodegenA64X11, frameBytes, paramSaveOffset, paramSaveCount)
                if pos < 0 || pos >= words.len:
                    return -1
                words[pos] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X11, a64units.CodegenA64X9, int64(0)))
                return pos + 1
            if elemSize == 16:
                let valueType = PrimaryBodyIrSlotType(bodyIR, op.operands[1])
                if valueType != coreir.LocalAggregateTag:
                    return -1
                pos = PrimaryBodyIRLoadSlotToReg(words, pos, bodyIR, op.operands[1], a64units.CodegenA64X11, frameBytes, paramSaveOffset, paramSaveCount)
                if pos < 0 || pos + 3 >= words.len:
                    return -1
                words[pos] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X11, int64(0)))
                words[pos + 1] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X9, int64(0)))
                words[pos + 2] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X11, int64(8)))
                words[pos + 3] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X9, int64(8)))
                return pos + 4
            if elemSize == 24:
                let valueType = PrimaryBodyIrSlotType(bodyIR, op.operands[1])
                pos = PrimaryBodyIRLoadSlotToReg(words, pos, bodyIR, op.operands[1], a64units.CodegenA64X11, frameBytes, paramSaveOffset, paramSaveCount)
                if valueType == coreir.LocalPtrTag:
                    if pos < 0 || pos + 2 >= words.len:
                        return -1
                    words[pos] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X11, a64units.CodegenA64X9, int64(0)))
                    words[pos + 1] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X11, a64units.CodegenA64X9, int64(8)))
                    words[pos + 2] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X11, a64units.CodegenA64X9, int64(16)))
                    return pos + 3
                if valueType == coreir.LocalStrTag || valueType == coreir.LocalAggregateTag:
                    # Str and 24B-aggregate values (e.g. a 3-field POD struct)
                    # share the identical blind 3x8-byte chunk copy — the
                    # value slot's materialized address in X11 is copied to
                    # the element address in X9 regardless of which of the
                    # two the slot type tag says it is.
                    if pos < 0 || pos + 5 >= words.len:
                        return -1
                    words[pos] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X11, int64(0)))
                    words[pos + 1] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X9, int64(0)))
                    words[pos + 2] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X11, int64(8)))
                    words[pos + 3] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X9, int64(8)))
                    words[pos + 4] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X11, int64(16)))
                    words[pos + 5] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X9, int64(16)))
                    return pos + 6
                return -1
            # General aggregate element store (`xs.field[i] = aggValue`): the
            # destination address is in X9; copy the value bytes 8 at a time from
            # the value slot's materialized address in X11. Covers any struct
            # element whose size is a multiple of 8 (e.g. BodyTerm = 48B).
            let valueType = PrimaryBodyIrSlotType(bodyIR, op.operands[1])
            if valueType == coreir.LocalAggregateTag && elemSize > 0 && (elemSize % 8) == 0:
                pos = PrimaryBodyIRLoadSlotToReg(words, pos, bodyIR, op.operands[1], a64units.CodegenA64X11, frameBytes, paramSaveOffset, paramSaveCount)
                if pos < 0:
                    return -1
                let aggChunks = elemSize / 8
                if pos + (aggChunks * 2) - 1 >= words.len:
                    return -1
                for aggChunk in 0..<aggChunks:
                    let aggByteOff = int64(aggChunk * 8)
                    words[pos] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X11, aggByteOff))
                    words[pos + 1] = Value(a64units.CodegenA64EncStrImm(true, a64units.CodegenA64X12, a64units.CodegenA64X9, aggByteOff))
                    pos = pos + 2
                return pos
            return -1
        var pos = offset
        if op.operands[0] >= 0 &&
           op.operands[0] < bodyIR.localSlots.len &&
           bodyIR.localSlots[op.operands[0]].placeKind ==
               coreir.BodyPlaceGlobalAddressTag:
            pos = a64units.CodegenA64BodyFillGlobalDataAddress(
                words, pos, a64units.CodegenA64X9)
        else:
            pos = PrimaryBodyIRLoadSlotToReg(
                words, pos, bodyIR, op.operands[0], a64units.CodegenA64X9,
                frameBytes, paramSaveOffset, paramSaveCount)
        pos = PrimaryBodyIRLoadSlotToReg(words, pos, bodyIR, op.operands[1], a64units.CodegenA64X10, frameBytes, paramSaveOffset, paramSaveCount)
        if pos < 0 || pos >= words.len:
            return -1
        if op.operands.len >= 3 &&
           op.operands[2] == coreir.BodyStoreLocalPtrDerefU8Tag:
            words[pos] = Value(a64units.CodegenA64EncStrbImm(a64units.CodegenA64X10, a64units.CodegenA64X9, 0))
            return pos + 1
        let valueType = PrimaryBodyIrSlotType(bodyIR, op.operands[1])
        var is64: bool
        if valueType == coreir.LocalI64Tag:
            is64 = true
        elif valueType == coreir.LocalPtrTag:
            is64 = true
        words[pos] = Value(a64units.CodegenA64EncStrImm(is64, a64units.CodegenA64X10, a64units.CodegenA64X9, int64(0)))
        return pos + 1
    if op.kind == coreir.BodyOpLoadLocalTag:
        if op.operands.len == 4 &&
           op.operands[0] ==
               coreir.BodyLoadLocalFieldAddressTag:
            let rootSlot = op.operands[1]
            let fieldOffset = op.operands[2]
            let fieldWidth = op.operands[3]
            if rootSlot < 0 || rootSlot >= bodyIR.localSlots.len ||
               fieldOffset < 0 || fieldWidth <= 0 ||
               op.target < 0 || op.target >= bodyIR.localSlots.len ||
               bodyIR.localSlots[op.target].typeKind !=
                   coreir.LocalPtrTag ||
               bodyIR.localSlots[op.target].placeKind !=
                   coreir.BodyPlaceBorrowAddressTag:
                return -1
            var fieldAddressPos = offset
            if bodyIR.localSlots[rootSlot].placeKind ==
                   coreir.BodyPlaceGlobalAddressTag:
                fieldAddressPos = a64units.CodegenA64BodyFillGlobalDataAddress(
                    words, fieldAddressPos, a64units.CodegenA64X9)
            elif bodyIR.localSlots[rootSlot].typeKind ==
                     coreir.LocalPtrTag ||
                 PrimaryBodyIrSlotIsIndirectAggregateParam(
                     bodyIR, rootSlot):
                fieldAddressPos = PrimaryBodyIRLoadSlotToReg(
                    words, fieldAddressPos, bodyIR, rootSlot,
                    a64units.CodegenA64X9, frameBytes, paramSaveOffset,
                    paramSaveCount)
            else:
                let rootOffset = PrimaryBodyIrLocalStackOffset(
                    bodyIR, rootSlot, frameBytes,
                    paramSaveOffset, paramSaveCount)
                if rootOffset < 0 ||
                   fieldOffset >
                       PrimaryLocalSlotSizeOf(
                           bodyIR.localSlots[rootSlot]) - fieldWidth:
                    return -1
                fieldAddressPos = a64units.CodegenA64BodyFillStackAddressToReg(
                    words, fieldAddressPos, a64units.CodegenA64X9, rootOffset)
            if fieldAddressPos < 0:
                return -1
            fieldAddressPos = a64units.CodegenA64BodyFillRegAddImmToReg(
                words, fieldAddressPos, a64units.CodegenA64X9,
                a64units.CodegenA64X9, fieldOffset)
            if fieldAddressPos < 0:
                return -1
            return PrimaryBodyIRStoreRegToSlot(
                words, fieldAddressPos, bodyIR, op.target,
                a64units.CodegenA64X9, frameBytes, paramSaveOffset,
                paramSaveCount)
        if op.operands.len == 5 &&
           op.operands[0] ==
               coreir.BodyLoadLocalIndexedAddressTag:
            if op.operands[1] < 0 ||
               op.operands[1] >= bodyIR.localSlots.len ||
               op.operands[2] < 0 ||
               op.operands[2] >= bodyIR.localSlots.len ||
               op.operands[3] <= 0 ||
               (op.operands[4] != 0 && op.operands[4] != 1) ||
               op.target < 0 || op.target >= bodyIR.localSlots.len ||
               bodyIR.localSlots[op.target].typeKind !=
                   coreir.LocalPtrTag ||
               bodyIR.localSlots[op.target].placeKind !=
                   coreir.BodyPlaceBorrowAddressTag:
                return -1
            let addressPos =
                PrimaryBodyIRFillIndexedAddressPartsToReg(
                    words,
                    offset,
                    bodyIR,
                    op.operands[1],
                    op.operands[2],
                    op.operands[3],
                    op.operands[4] == 1,
                    a64units.CodegenA64X9,
                    a64units.CodegenA64X10,
                    a64units.CodegenA64X11,
                    a64units.CodegenA64X12,
                    frameBytes,
                    paramSaveOffset,
                    paramSaveCount)
            if addressPos < 0:
                return -1
            return PrimaryBodyIRStoreRegToSlot(
                words, addressPos, bodyIR, op.target, a64units.CodegenA64X9,
                frameBytes, paramSaveOffset, paramSaveCount)
        if op.operands.len >= 3 &&
           op.operands[0] == coreir.BodyLoadLocalStrIndexU8Tag:
            if op.operands[1] < 0 || op.operands[1] >= bodyIR.localSlots.len ||
               op.operands[2] < 0 || op.operands[2] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return -1
            var pos = PrimaryBodyIRLoadStrValueAddressToReg(words,
                                                            offset,
                                                            bodyIR,
                                                            op.operands[1],
                                                            a64units.CodegenA64X9,
                                                            frameBytes,
                                                            paramSaveOffset,
                                                            paramSaveCount)
            pos = PrimaryBodyIRLoadSlotToReg(words,
                                             pos,
                                             bodyIR,
                                             op.operands[2],
                                             a64units.CodegenA64X10,
                                             frameBytes,
                                             paramSaveOffset,
                                             paramSaveCount)
            if pos < 0 || pos + 3 >= words.len:
                return -1
            words[pos] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X9, a64units.CodegenA64X9, int64(0)))
            pos = pos + 1
            words[pos] = a64units.CodegenA64EncAddReg(true, a64units.CodegenA64X9, a64units.CodegenA64X9, a64units.CodegenA64X10)
            pos = pos + 1
            words[pos] = Value(a64units.CodegenA64EncLdrbImm(a64units.CodegenA64X10, a64units.CodegenA64X9, 0))
            pos = pos + 1
            return PrimaryBodyIRStoreRegToSlot(words, pos, bodyIR, op.target, a64units.CodegenA64X10, frameBytes, paramSaveOffset, paramSaveCount)
        if op.operands.len >= 3 &&
           (op.operands[0] == coreir.BodyLoadLocalPtrDerefI32Tag ||
            op.operands[0] == coreir.BodyLoadLocalPtrDerefU8Tag ||
            op.operands[0] == coreir.BodyLoadLocalPtrDerefU64Tag):
            if op.operands[1] < 0 || op.operands[1] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return -1
            var pos = PrimaryBodyIRLoadSlotToReg(words, offset, bodyIR, op.operands[1], a64units.CodegenA64X9, frameBytes, paramSaveOffset, paramSaveCount)
            if pos < 0 || pos >= words.len:
                return -1
            if op.operands[0] == coreir.BodyLoadLocalPtrDerefU8Tag:
                words[pos] = Value(a64units.CodegenA64EncLdrbImm(a64units.CodegenA64X10, a64units.CodegenA64X9, 0))
            elif op.operands[0] == coreir.BodyLoadLocalPtrDerefU64Tag:
                words[pos] = Value(a64units.CodegenA64EncLdrImm(true, a64units.CodegenA64X10, a64units.CodegenA64X9, int64(0)))
            else:
                words[pos] = Value(a64units.CodegenA64EncLdrImm(false, a64units.CodegenA64X10, a64units.CodegenA64X9, int64(0)))
            return PrimaryBodyIRStoreRegToSlot(words, pos + 1, bodyIR, op.target, a64units.CodegenA64X10, frameBytes, paramSaveOffset, paramSaveCount)
        if op.operands.len >= 2 &&
           op.operands[0] == coreir.BodyLoadLocalAddressTag:
            # wave-36: LEA of local stack slot → ptr (mirrors x86_64 BodyLoadLocalAddressTag).
            # Must precede the general CopySlot arm: tag value 4 is not a slot index.
            if op.operands[1] < 0 || op.operands[1] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len ||
               bodyIR.localSlots[op.target].typeKind != coreir.LocalPtrTag:
                return -1
            let leaStackOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                               op.operands[1],
                                                               frameBytes,
                                                               paramSaveOffset,
                                                               paramSaveCount)
            if leaStackOffset < 0:
                return -1
            var leaPos = a64units.CodegenA64BodyFillStackAddressToReg(words, offset, a64units.CodegenA64X9, leaStackOffset)
            if leaPos < 0:
                return -1
            return PrimaryBodyIRStoreRegToSlot(words, leaPos, bodyIR, op.target, a64units.CodegenA64X9, frameBytes, paramSaveOffset, paramSaveCount)
        if op.operands.len >= 2 &&
           op.operands[0] == coreir.BodyLoadLocalCStringTag:
            # cstring literal address -> ptr slot: ADRP + ADD (page/pageoff reloc
            # registered in the cstring reloc pass) into x16, then store to slot.
            if op.operands[1] < 0 || op.operands[1] >= bodyIR.cstringLiterals.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len ||
               bodyIR.localSlots[op.target].typeKind != coreir.LocalPtrTag:
                return -1
            let cstrAddrPos = a64units.CodegenA64BodyFillGlobalDataAddress(words, offset, 16)
            if cstrAddrPos < 0:
                return -1
            return PrimaryBodyIRStoreRegToSlot(words, cstrAddrPos, bodyIR, op.target, 16, frameBytes, paramSaveOffset, paramSaveCount)
        if op.operands.len >= 1:
            if op.operands[0] < 0 || op.operands[0] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return -1
            return PrimaryBodyIRCopySlot(words, offset, bodyIR, op.operands[0], op.target, frameBytes, paramSaveOffset, paramSaveCount)
        return -1
    if op.kind == coreir.BodyOpBranchTag:
        if op.operands.len < 3:
            return -1
        let guardSlot = op.operands[1]
        if guardSlot < 0 || guardSlot >= bodyIR.localSlots.len:
            return -1
        var pos = PrimaryBodyIRLoadSlotToReg(words, offset, bodyIR, guardSlot, a64units.CodegenA64X9, frameBytes, paramSaveOffset, paramSaveCount)
        if pos < 0:
            return -1
        let subKind = op.operands[0]
        if subKind == coreir.BodyBranchIfLocalNilReturnI32ConstTag:
            let returnValue = op.operands[2]
            let restoreCount = PrimaryBodyIrFrameRestoreWordCount(bodyIR)
            if pos + 2 >= words.len:
                return -1
            words[pos] = Value(a64units.CodegenA64EncCbnz(false, a64units.CodegenA64X9, int64(2 + restoreCount)))
            words[pos + 1] = a64units.CodegenA64EncMovz(false, 0, returnValue & 65535, 0)
            return a64units.CodegenA64BodyFillFrameRestore(words, pos + 2, frameBytes, bodyIR)
        if subKind == coreir.BodyBranchIfLocalLeZeroReturnI32ConstTag:
            let returnValue = op.operands[2]
            let restoreCount = PrimaryBodyIrFrameRestoreWordCount(bodyIR)
            if pos + 3 >= words.len:
                return -1
            words[pos] = Value(a64units.CodegenA64EncCmpImm(false, a64units.CodegenA64X9, 0))
            words[pos + 1] = Value(a64units.CodegenA64EncBCond(int64(2 + restoreCount), a64units.CodegenA64CondGT))
            words[pos + 2] = a64units.CodegenA64EncMovz(false, 0, returnValue & 65535, 0)
            return a64units.CodegenA64BodyFillFrameRestore(words, pos + 3, frameBytes, bodyIR)
        if subKind == coreir.BodyBranchIfLocalLeZeroReturnCallNoargTag:
            let restoreCount = PrimaryBodyIrFrameRestoreWordCount(bodyIR)
            if pos + 3 >= words.len:
                return -1
            words[pos] = Value(a64units.CodegenA64EncCmpImm(false, a64units.CodegenA64X9, 0))
            words[pos + 1] = Value(a64units.CodegenA64EncBCond(int64(2 + restoreCount), a64units.CodegenA64CondGT))
            words[pos + 2] = a64units.CodegenA64EncBlPlaceholder()
            return a64units.CodegenA64BodyFillFrameRestore(words, pos + 3, frameBytes, bodyIR)
        if subKind == coreir.BodyBranchIfLocalLeZeroCallArg0ReturnI32ConstTag:
            if op.operands.len < 4 || pos + 7 >= words.len:
                return -1
            let arg0Slot = op.operands[2]
            let returnValue = op.operands[3]
            if arg0Slot < 0 || arg0Slot >= bodyIR.localSlots.len:
                return -1
            let restoreCount = PrimaryBodyIrFrameRestoreWordCount(bodyIR)
            let argLoadWords = PrimaryBodyIrLoadSlotWordCount(bodyIR, arg0Slot)
            if argLoadWords <= 0:
                return -1
            words[pos] = Value(a64units.CodegenA64EncCmpImm(false, a64units.CodegenA64X9, 0))
            words[pos + 1] = Value(a64units.CodegenA64EncBCond(int64(argLoadWords + restoreCount + 3), a64units.CodegenA64CondGT))
            var skipLoad = PrimaryBodyIRLoadSlotToReg(words, pos + 2, bodyIR, arg0Slot, a64units.CodegenA64X0, frameBytes, paramSaveOffset, paramSaveCount)
            words[skipLoad] = a64units.CodegenA64EncBlPlaceholder()
            words[skipLoad + 1] = a64units.CodegenA64EncMovz(false, 0, returnValue & 65535, 0)
            return a64units.CodegenA64BodyFillFrameRestore(words, skipLoad + 2, frameBytes, bodyIR)
        return -1
    if op.kind == coreir.BodyOpReturnTag:
        words[offset] = a64units.CodegenA64EncNop()
        return offset + 1
    return -1

@borrows
fn PrimaryBodyIRFillBlockOps(words: var int32[], offset: int32, bodyIR: coreir.BodyIR, bi: int32, oi: int32, endOi: int32): int32 =
    if offset < 0:
        return -1
    if oi >= endOi:
        return offset
    let nextOffset = PrimaryBodyIRFillBlockOp(words, offset, bodyIR, bi, oi)
    if nextOffset < 0:
        return -1
    return PrimaryBodyIRFillBlockOps(words, nextOffset, bodyIR, bi, oi + 1, endOi)

# Block word offsets as one prefix-sum pass; per-query PrimaryBodyIRBlockStart
# walks are quadratic in block count and dominated emit prep for big bodies.
@borrows
fn PrimaryBodyIRBlockStartsTable(bodyIR: coreir.BodyIR): int32[] =
    var blockStarts: int32[]
    var blockStartPos = PrimaryBodyIrPrologueWordCount(bodyIR)
    for tableBi in 0..<bodyIR.blocks.len:
        add(blockStarts, blockStartPos)
        blockStartPos = blockStartPos + PrimaryBodyIRBlockSize(bodyIR, tableBi)
    return blockStarts

# Phase 2 branch emission. Inside the serial Darwin arm64 back-patch fill, source the target from
# the real (already filled) block start; if the target block is not yet filled (forward edge), write
# a delta-0 placeholder (encoding non-zero so the zero-scan is unaffected) and record a fixup resolved
# after all blocks are filled. Outside that path (chunked / task-local / x64), fall back to the
# predictor-derived absolute target word (functionBase + blockStarts[tb]) — the retired behaviour.
fn PrimaryBackpatchEmitCondBranch(words: var int32[], wordPos: int32, targetBlock: int32, condCode: int32, fallbackTargetWord: int32) =
    if !primaryBackpatchActive:
        words[wordPos] = Value(a64units.CodegenA64EncBCond(int64(fallbackTargetWord - wordPos), condCode))
        return
    # form60: hoist .len before three-way conj with [targetBlock]
    let realBlockStartLen_f60: int32 = primaryBackpatchRealBlockStart.len
    if targetBlock >= 0 && targetBlock < realBlockStartLen_f60 && primaryBackpatchRealBlockStart[targetBlock] >= 0:
        let target = primaryBackpatchRealBlockStart[targetBlock]
        words[wordPos] = Value(a64units.CodegenA64EncBCond(int64(target - wordPos), condCode))
        return
    # An out-of-[0,blockCount) target block (e.g. a last-block Cbr whose edge is
    # `lastBlock + 1` == blocks.len, the fall-through-to-exit sentinel) can never
    # be recorded in realBlockStart, so a fixup for it never resolves. The caller
    # already computed the correct fall-through absolute word in fallbackTargetWord
    # (functionBase + termStart + termSize); emit it directly, exactly like the
    # non-backpatch path, rather than queuing an unresolvable fixup.
    if targetBlock < 0 || targetBlock >= primaryBackpatchRealBlockStart.len:
        words[wordPos] = Value(a64units.CodegenA64EncBCond(int64(fallbackTargetWord - wordPos), condCode))
        return
    words[wordPos] = Value(a64units.CodegenA64EncBCond(int64(0), condCode))
    add(primaryBackpatchFixupWordPos, wordPos)
    add(primaryBackpatchFixupTargetBlock, targetBlock)
    add(primaryBackpatchFixupIsCond, true)
    add(primaryBackpatchFixupCondCode, condCode)

fn PrimaryBackpatchEmitUncondBranch(words: var int32[], wordPos: int32, targetBlock: int32, fallbackTargetWord: int32) =
    if !primaryBackpatchActive:
        words[wordPos] = Value(a64units.CodegenA64EncBImm(int64(fallbackTargetWord - wordPos)))
        return
    # form60: hoist .len before three-way conj with [targetBlock]
    let realBlockStartLen_f60: int32 = primaryBackpatchRealBlockStart.len
    if targetBlock >= 0 && targetBlock < realBlockStartLen_f60 && primaryBackpatchRealBlockStart[targetBlock] >= 0:
        let target = primaryBackpatchRealBlockStart[targetBlock]
        words[wordPos] = Value(a64units.CodegenA64EncBImm(int64(target - wordPos)))
        return
    # Out-of-[0,blockCount) target (fall-through-to-exit sentinel): emit the
    # caller's precomputed fall-through word directly instead of an unresolvable
    # fixup (mirrors the cond-branch path and the non-backpatch fallback).
    if targetBlock < 0 || targetBlock >= primaryBackpatchRealBlockStart.len:
        words[wordPos] = Value(a64units.CodegenA64EncBImm(int64(fallbackTargetWord - wordPos)))
        return
    words[wordPos] = Value(a64units.CodegenA64EncBImm(int64(0)))
    add(primaryBackpatchFixupWordPos, wordPos)
    add(primaryBackpatchFixupTargetBlock, targetBlock)
    add(primaryBackpatchFixupIsCond, false)
    add(primaryBackpatchFixupCondCode, 0)

@borrows
fn PrimaryBodyIRFillBlockTerm(words: var int32[], offset: int32, bodyIR: coreir.BodyIR, bi: int32, blockStarts: int32[]): int32 =
    if offset < 0 || offset >= words.len:
        return -1
    let frameBytes = PrimaryBodyIrFrameBytes(bodyIR)
    let paramSaveOffset = PrimaryBodyIrParamSaveOffset(bodyIR)
    let paramSaveCount = PrimaryBodyIrParamSaveCount(bodyIR)
    let block = bodyIR.blocks[bi]
    let termIndex = block.termIndex
    if termIndex < 0:
        return -1
    if termIndex >= bodyIR.terms.len:
        return -1
    let term = bodyIR.terms[termIndex]
    if term.kind == coreir.BodyTermCbrTag:
        let termSize = PrimaryBodyIRTermSize(bodyIR, termIndex)
        var primaryColdCond25: bool
        if termSize <= 0:
            primaryColdCond25 = true
        if offset + termSize - 1 >= words.len:
            primaryColdCond25 = true
        if primaryColdCond25:
            if PrimaryObjectPlanTraceActive():
                PrimaryObjectPlanTrace(Fmt"phase=cbr_fill_fail reason=size term_index={termIndex} term_size={termSize} cond_kind={term.conditionKind} lhs_slot={term.lhsSlot} rhs_slot={term.rhsSlot} true_block={term.trueBlock} false_block={term.falseBlock}")
            return -1
        if bi >= blockStarts.len:
            return -1
        let blockStart = blockStarts[bi]
        let termStart = blockStart + PrimaryBodyIROpRangeSize(bodyIR, block.opStart, block.opStart + block.opCount)
        let functionBase = offset - termStart
        var trueWord = functionBase + termStart + termSize
        if term.trueBlock >= 0 && term.trueBlock < blockStarts.len:
            trueWord = functionBase + blockStarts[term.trueBlock]
        var falseWord = functionBase + termStart + termSize
        if term.falseBlock >= 0 && term.falseBlock < blockStarts.len:
            falseWord = functionBase + blockStarts[term.falseBlock]
        # Stage10 Cmp->Cbr fusion: the block's last op is a Cmp that already set NZCV and was emitted
        # WITHOUT cset/store (its fused filler returned right after the cmp). Skip the bool ldr +
        # cmp#0 entirely and branch straight from the live compare flags: `b.<cond> trueWord; b
        # falseWord`. Polarity: LocalNonZero takes the true edge when the bool != 0 (comparison TRUE),
        # so the stored cond code (PrimaryBodyCondA64TrueCode of the Cmp's tag) is the true-branch
        # condition. Size is exactly 2, matching the fused Cbr size case (4 - 2).
        # form60: hoist .len before three-way conj
        let layoutCbrFuseLen_f60: int32 = bodyIR.layoutCbrFuse.len
        if termIndex >= 0 && termIndex < layoutCbrFuseLen_f60 && bodyIR.layoutCbrFuse[termIndex] >= 0:
            if offset + 1 >= words.len:
                return -1
            let fuseCondCode = bodyIR.layoutCbrFuse[termIndex]
            PrimaryBackpatchEmitCondBranch(words, offset, term.trueBlock, fuseCondCode, trueWord)
            PrimaryBackpatchEmitUncondBranch(words, offset + 1, term.falseBlock, falseWord)
            return offset + 2
        var lhsSlot = term.lhsSlot
        if lhsSlot < 0:
            lhsSlot = term.resultSlot
        var pos = PrimaryBodyIRLoadSlotToReg(words,
                                             offset,
                                             bodyIR,
                                             lhsSlot,
                                             a64units.CodegenA64X9,
                                             frameBytes,
                                             paramSaveOffset,
                                             paramSaveCount)
        if pos < 0 || pos >= words.len:
            if PrimaryObjectPlanTraceActive():
                PrimaryObjectPlanTrace(Fmt"phase=cbr_fill_fail reason=lhs_load term_index={termIndex} cond_kind={term.conditionKind} lhs_slot={lhsSlot} rhs_slot={term.rhsSlot} true_block={term.trueBlock} false_block={term.falseBlock}")
            return -1
        var lhsIs64: bool
        let lhsSlotType = PrimaryBodyIrSlotType(bodyIR, lhsSlot)
        if lhsSlotType == coreir.LocalI64Tag:
            lhsIs64 = true
        elif lhsSlotType == coreir.LocalPtrTag:
            lhsIs64 = true
        if term.conditionKind == coreir.BodyCondLocalNonZeroTag:
            words[pos] = Value(a64units.CodegenA64EncCmpImm(lhsIs64, a64units.CodegenA64X9, 0))
            PrimaryBackpatchEmitCondBranch(words, pos + 1, term.trueBlock, a64units.CodegenA64CondNE, trueWord)
            PrimaryBackpatchEmitUncondBranch(words, pos + 2, term.falseBlock, falseWord)
            return pos + 3
        if term.conditionKind == coreir.BodyCondLocalZeroTag:
            words[pos] = Value(a64units.CodegenA64EncCmpImm(lhsIs64, a64units.CodegenA64X9, 0))
            PrimaryBackpatchEmitCondBranch(words, pos + 1, term.trueBlock, a64units.CodegenA64CondEQ, trueWord)
            PrimaryBackpatchEmitUncondBranch(words, pos + 2, term.falseBlock, falseWord)
            return pos + 3
        if PrimaryBodyCondIsF64(term.conditionKind):
            if lhsSlotType != coreir.LocalF64Tag || term.rhsSlot < 0:
                return -1
            let condCode = a64units.CodegenA64BodyCondTrueCode(term.conditionKind)
            pos = PrimaryBodyIRLoadSlotToReg(words,
                                             pos,
                                             bodyIR,
                                             term.rhsSlot,
                                             a64units.CodegenA64X10,
                                             frameBytes,
                                             paramSaveOffset,
                                             paramSaveCount)
            if pos < 0 || pos + 4 >= words.len:
                return -1
            let rhsSlotType = PrimaryBodyIrSlotType(bodyIR, term.rhsSlot)
            if rhsSlotType != coreir.LocalF64Tag:
                return -1
            words[pos] = a64units.CodegenA64EncFmovDx(a64units.CodegenA64X9, a64units.CodegenA64X9)
            words[pos + 1] = a64units.CodegenA64EncFmovDx(a64units.CodegenA64X10, a64units.CodegenA64X10)
            words[pos + 2] = a64units.CodegenA64EncFcmpD(a64units.CodegenA64X9, a64units.CodegenA64X10)
            PrimaryBackpatchEmitCondBranch(words, pos + 3, term.trueBlock, condCode, trueWord)
            PrimaryBackpatchEmitUncondBranch(words, pos + 4, term.falseBlock, falseWord)
            return pos + 5
        if term.conditionKind >= coreir.BodyCondI32EqTag:
            if term.conditionKind <= coreir.BodyCondU64GeTag:
                let condCode = a64units.CodegenA64BodyCondTrueCode(term.conditionKind)
                if term.rhsSlot >= 0:
                    pos = PrimaryBodyIRLoadSlotToReg(words,
                                                     pos,
                                                     bodyIR,
                                                     term.rhsSlot,
                                                     a64units.CodegenA64X10,
                                                     frameBytes,
                                                     paramSaveOffset,
                                                     paramSaveCount)
                    if pos < 0 || pos + 2 >= words.len:
                        return -1
                    var cmpIs64 = lhsIs64
                    let rhsSlotType = PrimaryBodyIrSlotType(bodyIR, term.rhsSlot)
                    if rhsSlotType == coreir.LocalI64Tag:
                        cmpIs64 = true
                    elif rhsSlotType == coreir.LocalPtrTag:
                        cmpIs64 = true
                    words[pos] = a64units.CodegenA64EncCmpReg(cmpIs64, a64units.CodegenA64X9, a64units.CodegenA64X10)
                else:
                    var rhsConst = 0
                    if term.operands.len > 0:
                        rhsConst = term.operands[0]
                    if pos + 2 >= words.len:
                        return -1
                    words[pos] = Value(a64units.CodegenA64EncCmpImm(lhsIs64, a64units.CodegenA64X9, rhsConst))
                PrimaryBackpatchEmitCondBranch(words, pos + 1, term.trueBlock, condCode, trueWord)
                PrimaryBackpatchEmitUncondBranch(words, pos + 2, term.falseBlock, falseWord)
                return pos + 3
        return -1
    if term.kind == coreir.BodyTermBrTag:
        if bi >= blockStarts.len:
            return -1
        let blockStart = blockStarts[bi]
        let termStart = blockStart + PrimaryBodyIROpRangeSize(bodyIR, block.opStart, block.opStart + block.opCount)
        let functionBase = offset - termStart
        var targetWord = functionBase + termStart + 1
        if term.trueBlock >= 0 && term.trueBlock < blockStarts.len:
            targetWord = functionBase + blockStarts[term.trueBlock]
        PrimaryBackpatchEmitUncondBranch(words, offset, term.trueBlock, targetWord)
        return offset + 1
    if term.kind == coreir.BodyTermReturnTag:
        return PrimaryBodyIRFillBlockTermReturn(words,
                                                offset,
                                                term,
                                                bodyIR,
                                                frameBytes,
                                                paramSaveOffset,
                                                paramSaveCount)
    return -1

@borrows
fn PrimaryBodyIRFillBlockTermReturn(words: var int32[],
                                     offset: int32,
                                     term: coreir.BodyTerm,
                                     bodyIR: coreir.BodyIR,
                                     frameBytes: int32,
                                     paramSaveOffset: int32,
                                     paramSaveCount: int32): int32 =
    if offset < 0 || offset >= words.len:
        return -1
    if term.resultSlot >= 0 && term.resultSlot < bodyIR.localSlots.len:
        let resultType = bodyIR.localSlots[term.resultSlot].typeKind
        if resultType == coreir.LocalStrTag ||
           resultType == coreir.LocalAggregateTag:
            let sourceOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                             term.resultSlot,
                                                             frameBytes,
                                                             paramSaveOffset,
                                                             paramSaveCount)
            let returnBufferOffset = PrimaryBodyIrReturnBufferSaveOffset(bodyIR)
            let restoreCount = PrimaryBodyIrFrameRestoreWordCount(bodyIR)
            # sret 拷贝按结果槽精确字节数发射：8 对齐用 64 位字（str=24B→3，
            # Result[str]=64B→8），否则用 32 位字（Row 12B→3）。严禁向上取整到
            # 8 字节字——会向 sret 目的多写覆盖调用方紧邻槽（add(seq, helper())
            # 覆盖 seq 头指针 → 段错误）。
            let returnCopyBytes = PrimaryLocalSlotSizeOf(bodyIR.localSlots[term.resultSlot])
            let returnCopyPairs = PrimaryReturnSretCopyPairCount(returnCopyBytes)
            let returnCopyIs64 = PrimaryReturnSretCopyIs64(returnCopyBytes)
            var returnCopyStride = 4
            if returnCopyIs64:
                returnCopyStride = 8
            # 按值聚合形参在槽里存的是指针（入参 by-pointer），返回时必须先把指针
            # 取到基址寄存器再逐字拷贝；本地聚合槽存的是内联结构体，直接按 sp 偏移拷。
            let aggregateParam = PrimaryBodyIrLocalIsParam(bodyIR.localSlots[term.resultSlot])
            # returnBufferOffset (X8 sret ptr) + aggregate sourceOffset (X10) + 非聚合 per-pair
            # sourceOffset 在大 frame (>32760 for 8B) 溢出 A64EncLdrImm scaled-imm 上限：
            # encoder 返 Err -> Value() 强转 0 -> 0x0 word -> zero-scan 抓 -> not-ready。
            # 走 PrimaryBodyIRLoadStackOffsetToReg（guard+物化，peer-arm 同款 pattern）；
            # 非聚合循环 sourceOffset 不 fit 时物化源基址到 X10 一次，循环用 X10+小偏移。
            var nonAggOverflow = false
            if !aggregateParam && returnCopyPairs > 0 &&
               !PrimaryBodyIrStackAccessImmFits(sourceOffset + (returnCopyPairs - 1) * returnCopyStride,
                                                returnCopyStride):
                nonAggOverflow = true
            var nonAggMaterializeWords = 0
            if nonAggOverflow:
                nonAggMaterializeWords = PrimaryBodyIrStackAddressWordCount(sourceOffset)
            let retBufWords = PrimaryBodyIrStackAccessWordCount(returnBufferOffset, 8)
            var retBaseWords = 0
            if aggregateParam:
                retBaseWords = PrimaryBodyIrStackAccessWordCount(sourceOffset, 8)
            if returnCopyPairs <= 0 || sourceOffset < 0 || returnBufferOffset < 0 ||
               offset + retBufWords + retBaseWords + nonAggMaterializeWords + returnCopyPairs * 2 + restoreCount > words.len:
                return -1
            var pos = PrimaryBodyIRLoadStackOffsetToReg(words, offset, a64units.CodegenA64X8, returnBufferOffset, 8)
            if pos < 0:
                return -1
            if aggregateParam:
                pos = PrimaryBodyIRLoadStackOffsetToReg(words, pos, a64units.CodegenA64X10, sourceOffset, 8)
                if pos < 0:
                    return -1
            if nonAggOverflow:
                pos = a64units.CodegenA64BodyFillStackAddressToReg(words, pos, a64units.CodegenA64X10, sourceOffset)
                if pos < 0:
                    return -1
            for copyIndex in 0..<returnCopyPairs:
                if aggregateParam || nonAggOverflow:
                    words[pos] = Value(a64units.CodegenA64EncLdrImm(returnCopyIs64,
                                                        a64units.CodegenA64X9,
                                                        a64units.CodegenA64X10,
                                                        int64(copyIndex * returnCopyStride)))
                else:
                    words[pos] = Value(a64units.CodegenA64EncLdrImm(returnCopyIs64,
                                                        a64units.CodegenA64X9,
                                                        a64units.CodegenA64SP,
                                                        int64(sourceOffset + copyIndex * returnCopyStride)))
                words[pos + 1] = Value(a64units.CodegenA64EncStrImm(returnCopyIs64,
                                                        a64units.CodegenA64X9,
                                                        a64units.CodegenA64X8,
                                                        int64(copyIndex * returnCopyStride)))
                pos = pos + 2
            return a64units.CodegenA64BodyFillFrameRestore(words, pos, frameBytes, bodyIR)
        var loadPos = PrimaryBodyIRLoadSlotToReg(words,
                                                  offset,
                                                  bodyIR,
                                                  term.resultSlot,
                                                  a64units.CodegenA64X0,
                                                  frameBytes,
                                                  paramSaveOffset,
                                                  paramSaveCount)
        if loadPos < 0:
            return -1
        if bodyIR.localSlots[term.resultSlot].typeKind == coreir.LocalF64Tag:
            # float return ABI: move the raw bits into d0
            if loadPos >= words.len:
                return -1
            words[loadPos] = a64units.CodegenA64EncFmovDx(0, 0)
            loadPos = loadPos + 1
        return a64units.CodegenA64BodyFillFrameRestore(words, loadPos, frameBytes, bodyIR)
    if term.resultSlot < 0 &&
       term.operands.len >= 1 &&
       term.operands[0] == coreir.LocalInvalidTag:
        return a64units.CodegenA64BodyFillFrameRestore(words, offset, frameBytes, bodyIR)
    if offset + 3 >= words.len:
        return -1
    var hasOperands: bool
    if term.operands.len >= 1:
        hasOperands = true
    if hasOperands:
        if term.operands[0] == PrimaryStatementReturnModeI32Const():
            if term.operands.len >= 2:
                # i32 常量 return 须按全 32 位物化: 原单发一条 16 位 movz, 把
                # |const|>65535 的返回值静默截成低 16 位 (`return -2147483648`
                # 变 0, repro_minclamp rc=64 真根; 语义 = int32 有符号低 32 位
                # 原样)。单指令形(movz/movn)保持 1 字, 其余 movz/movn+movk@16
                # 2 字 —— 与 BodyOpLoadConstTag 同值域 fill 公式逐字一致,
                # 与 PrimaryBodyIRTermSizeRaw 的 2 字计数联动。
                let retConstValue = term.operands[1]
                if retConstValue >= 0 && retConstValue <= 65535:
                    words[offset] = a64units.CodegenA64EncMovz(false, 0, retConstValue, 0)
                    return a64units.CodegenA64BodyFillFrameRestore(words, offset + 1, frameBytes, bodyIR)
                if retConstValue < 0 && retConstValue >= -65536:
                    words[offset] = a64units.CodegenA64EncMovn(false, 0, (0 - retConstValue - 1) & 65535, 0)
                    return a64units.CodegenA64BodyFillFrameRestore(words, offset + 1, frameBytes, bodyIR)
                if retConstValue < 0:
                    words[offset] = a64units.CodegenA64EncMovn(false, 0, (0 - retConstValue - 1) & 65535, 0)
                else:
                    words[offset] = a64units.CodegenA64EncMovz(false, 0, retConstValue & 65535, 0)
                words[offset + 1] = a64units.CodegenA64EncMovk(false, 0, (retConstValue >> 16) & 65535, 1)
                return a64units.CodegenA64BodyFillFrameRestore(words, offset + 2, frameBytes, bodyIR)
            else:
                words[offset] = a64units.CodegenA64EncMovz(false, 0, 0, 0)
        else:
            var returnTypedSlot: bool
            if term.resultSlot >= 0:
                if term.operands[0] == coreir.LocalI32Tag:
                    returnTypedSlot = true
                elif term.operands[0] == coreir.LocalI64Tag:
                    returnTypedSlot = true
                elif term.operands[0] == coreir.LocalPtrTag:
                    returnTypedSlot = true
            if returnTypedSlot:
                let nextOffset = PrimaryBodyIRLoadSlotToReg(words,
                                                            offset,
                                                            bodyIR,
                                                            term.resultSlot,
                                                            a64units.CodegenA64X0,
                                                            frameBytes,
                                                            paramSaveOffset,
                                                            paramSaveCount)
                if nextOffset != offset + 1:
                    return -1
            else:
                var returnNullPtr: bool
                if term.operands[0] == coreir.LocalPtrTag:
                    if term.resultSlot < 0:
                        returnNullPtr = true
                if returnNullPtr:
                    words[offset] = a64units.CodegenA64EncMovz(true, 0, 0, 0)
                else:
                    words[offset] = a64units.CodegenA64EncMovz(false, 0, 0, 0)
    else:
        words[offset] = a64units.CodegenA64EncMovz(false, 0, 0, 0)
    return a64units.CodegenA64BodyFillFrameRestore(words, offset + 1, frameBytes, bodyIR)

@borrows
fn PrimaryBodyIRFillBlock(words: var int32[], offset: int32, bodyIR: coreir.BodyIR, bi: int32, blockStarts: int32[]): int32 =
    let block = bodyIR.blocks[bi]
    let afterOps = PrimaryBodyIRFillBlockOps(words, offset, bodyIR, bi, block.opStart, block.opStart + block.opCount)
    if afterOps < 0:
        return -1
    let afterTerm = PrimaryBodyIRFillBlockTerm(words, afterOps, bodyIR, bi, blockStarts)
    if afterTerm < 0:
        return -1
    return afterTerm

@borrows
fn PrimaryBodyIRFillBlocks(words: var int32[], offset: int32, bodyIR: coreir.BodyIR, bi: int32, endBi: int32): int32 =
    let blockStarts = PrimaryBodyIRBlockStartsTable(bodyIR)
    var fillOffset = offset
    var fillBi = bi
    while fillBi < endBi:
        if fillOffset < 0:
            return -1
        # Phase 0: block-start A/B net. fillOffset is the real absolute start of block fillBi.
        # functionBase (true) was frozen in FillWords; the predicted blockStarts[fillBi] must
        # reconstruct it exactly (functionBase == fillOffset - blockStarts[fillBi]). Any drift
        # means the size predictor desynced from the real fill -> loud fail. Record the real
        # absolute start for Phase 2 branch targeting.
        if primaryBackpatchActive && fillBi >= 0 && fillBi < blockStarts.len:
            let predictedStart = blockStarts[fillBi]
            let reconBase = fillOffset - predictedStart
            if reconBase != primaryBackpatchFunctionBase:
                os.WriteLine(os.GetStderr(), strutil.Join(["phase=blockstart_desync block=",
                                                           strings.IntToStr(fillBi),
                                                           " fill_offset=",
                                                           strings.IntToStr(fillOffset),
                                                           " predicted_start=",
                                                           strings.IntToStr(predictedStart),
                                                           " recon_base=",
                                                           strings.IntToStr(reconBase),
                                                           " function_base=",
                                                           strings.IntToStr(primaryBackpatchFunctionBase)],
                                                          ""))
                return -1
            if fillBi < primaryBackpatchRealBlockStart.len:
                primaryBackpatchRealBlockStart[fillBi] = fillOffset
        fillOffset = PrimaryBodyIRFillBlock(words, fillOffset, bodyIR, fillBi, blockStarts)
        if fillOffset < 0:
            return -1
        fillBi = fillBi + 1
    # Phase 2: forward-branch fixup pass. All blocks now filled; resolve any branch whose
    # target block was not yet filled when its terminator was emitted (delta-0 placeholder).
    if primaryBackpatchActive:
        for fi in 0..<primaryBackpatchFixupWordPos.len:
            let wordPos = primaryBackpatchFixupWordPos[fi]
            let tb = primaryBackpatchFixupTargetBlock[fi]
            let isCond = primaryBackpatchFixupIsCond[fi]
            let condCode = primaryBackpatchFixupCondCode[fi]
            if wordPos < 0 || wordPos >= words.len:
                os.WriteLine(os.GetStderr(), "phase=branch_fixup_oob")
                return -1
            if tb < 0 || tb >= primaryBackpatchRealBlockStart.len || primaryBackpatchRealBlockStart[tb] < 0:
                os.WriteLine(os.GetStderr(), "phase=branch_fixup_unresolved")
                return -1
            let target = primaryBackpatchRealBlockStart[tb]
            let delta = int64(target - wordPos)
            if isCond:
                words[wordPos] = Value(a64units.CodegenA64EncBCond(delta, condCode))
            else:
                words[wordPos] = Value(a64units.CodegenA64EncBImm(delta))
    return fillOffset

@borrows
fn PrimaryBodyIRFillPrologue(words: var int32[],
                              wordOffset: int32,
                              bodyIR: coreir.BodyIR): int32 =
    let prologueCount = PrimaryBodyIrPrologueWordCount(bodyIR)
    let frameBytes = PrimaryBodyIrFrameBytes(bodyIR)
    let paramSaveOffset = PrimaryBodyIrParamSaveOffset(bodyIR)
    let paramSaveCount = PrimaryBodyIrParamSaveCount(bodyIR)
    let returnBufferOffset = PrimaryBodyIrReturnBufferSaveOffset(bodyIR)
    let endOffset = wordOffset + prologueCount
    var primaryColdCond26: bool
    if wordOffset < 0:
        primaryColdCond26 = true
    if prologueCount <= 0:
        primaryColdCond26 = true
    if frameBytes <= 0:
        primaryColdCond26 = true
    if returnBufferOffset < 0:
        primaryColdCond26 = true
    if endOffset > words.len:
        primaryColdCond26 = true
    if primaryColdCond26:
        return -1
    var prologuePos = wordOffset
    var remain = frameBytes
    while remain > 4095:
        if prologuePos >= endOffset:
            return -1
        words[prologuePos] = Value(a64units.CodegenA64EncSubImm(true, a64units.CodegenA64SP, a64units.CodegenA64SP, 4095))
        prologuePos = prologuePos + 1
        remain = remain - 4095
    if prologuePos >= endOffset:
        return -1
    words[prologuePos] = Value(a64units.CodegenA64EncSubImm(true, a64units.CodegenA64SP, a64units.CodegenA64SP, remain))
    prologuePos = prologuePos + 1
    if prologuePos >= endOffset:
        return -1
    words[prologuePos] = Value(a64units.CodegenA64EncStp64(a64units.CodegenA64FP, a64units.CodegenA64LR, a64units.CodegenA64SP, int64(0)))
    prologuePos = prologuePos + 1
    if prologuePos >= endOffset:
        return -1
    words[prologuePos] = Value(a64units.CodegenA64EncAddImm(true, a64units.CodegenA64FP, a64units.CodegenA64SP, 0))
    prologuePos = prologuePos + 1
    # The fixed prologue stores (param saves + sret pointer) use the STR scaled
    # unsigned-immediate form, which only reaches 32760 bytes. A giant frame
    # pushes those slots past that, so when the return-buffer slot overflows we
    # materialize the param-save base into the intra-procedure scratch X16 once
    # (SP + paramSaveOffset) and store relative to it; the per-slot deltas
    # (paramIndex*8 and the sret delta paramSaveCount*8) stay tiny and encode.
    var saveBaseReg = a64units.CodegenA64SP
    var saveBaseDelta = paramSaveOffset
    if !PrimaryBodyIrStackAccessImmFits(returnBufferOffset, 8):
        prologuePos = a64units.CodegenA64BodyFillStackAddressToReg(words, prologuePos, a64units.CodegenA64X16, paramSaveOffset)
        if prologuePos < 0 || prologuePos > endOffset:
            return -1
        saveBaseReg = a64units.CodegenA64X16
        saveBaseDelta = 0
    var paramIndex: int32
    while paramIndex < paramSaveCount:
        if prologuePos >= endOffset:
            return -1
        words[prologuePos] = a64units.CodegenA64EncStrImmValue(true,
                                                   paramIndex,
                                                   saveBaseReg,
                                                   saveBaseDelta + paramIndex * 8)
        prologuePos = prologuePos + 1
        paramIndex = paramIndex + 1
    if prologuePos >= endOffset:
        return -1
    words[prologuePos] = a64units.CodegenA64EncStrImmValue(true, a64units.CodegenA64X8, saveBaseReg, saveBaseDelta + paramSaveCount * 8)
    prologuePos = prologuePos + 1
    if prologuePos != endOffset:
        return -1
    return prologuePos

@borrows
fn PrimaryBodyIRFillWords(words: var int32[], wordOffset: int32, wordCount: int32, bodyIR: coreir.BodyIR): int32 =
    let prologueCount = PrimaryBodyIrPrologueWordCount(bodyIR)
    let frameBytes = PrimaryBodyIrFrameBytes(bodyIR)
    let paramSaveOffset = PrimaryBodyIrParamSaveOffset(bodyIR)
    let paramSaveCount = PrimaryBodyIrParamSaveCount(bodyIR)
    var primaryColdCond27: bool
    if wordOffset < 0:
        primaryColdCond27 = true
    if wordCount < prologueCount:
        primaryColdCond27 = true
    if wordOffset + wordCount > words.len:
        primaryColdCond27 = true
    if frameBytes <= 0:
        primaryColdCond27 = true
    if primaryColdCond27:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), strutil.Join(["fill_words_fail wordOffset=", strings.IntToStr(wordOffset),
                                                       " wordCount=", strings.IntToStr(wordCount),
                                                       " prologueCount=", strings.IntToStr(prologueCount),
                                                       " frameBytes=", strings.IntToStr(frameBytes),
                                                       " words_len=", strings.IntToStr(words.len),
                                                       " blocks=", strings.IntToStr(bodyIR.blocks.len),
                                                       " ops=", strings.IntToStr(bodyIR.ops.len)],
                                                      ""))
        return -1
    if primaryBackpatchActive:
        PrimaryBackpatchResetForFunction(wordOffset, bodyIR.blocks.len)
    let afterPrologue = PrimaryBodyIRFillPrologue(words, wordOffset, bodyIR)
    if afterPrologue < 0:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), strutil.Join(["fill_prologue_fail wordOffset=", strings.IntToStr(wordOffset),
                                                       " prologueCount=", strings.IntToStr(prologueCount),
                                                       " frameBytes=", strings.IntToStr(frameBytes),
                                                       " paramSaveCount=", strings.IntToStr(paramSaveCount)],
                                                      ""))
        return -1
    let afterBlocks = PrimaryBodyIRFillBlocks(words, afterPrologue, bodyIR, 0, bodyIR.blocks.len)
    if afterBlocks < 0:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), strutil.Join(["fill_blocks_fail afterPrologue=", strings.IntToStr(afterPrologue),
                                                       " blocks=", strings.IntToStr(bodyIR.blocks.len),
                                                       " ops=", strings.IntToStr(bodyIR.ops.len),
                                                       " terms=", strings.IntToStr(bodyIR.terms.len)],
                                                      ""))
        return -1
    return afterBlocks - wordOffset

@borrows
fn PrimaryBodyIrPayloadItemCount(bodyIR: coreir.BodyIR): int32 =
    var count: int32
    count = count + bodyIR.ops.len
    count = count + bodyIR.callSequence.len
    count = count + bodyIR.localSlots.len
    count = count + bodyIR.blocks.len
    count = count + bodyIR.terms.len
    count = count + bodyIR.cstringLiterals.len
    return count

fn PrimaryBodyIrSeqPayloadItemCount(functionBodyIRs: var coreir.BodyIR[]): int32 =
    var count: int32
    for i in 0..<functionBodyIRs.len:
        count = count + PrimaryBodyIrPayloadItemCount(functionBodyIRs[i])
    return count

fn PrimaryBodyIrSeqRetainedFunctionCount(functionBodyIRs: var coreir.BodyIR[]): int32 =
    var count: int32
    for i in 0..<functionBodyIRs.len:
        if PrimaryBodyIrPayloadItemCount(functionBodyIRs[i]) > 0:
            count = count + 1
    return count

@borrows
fn PrimaryObjectPlanFillCheckSnapshot(label: str,
                                      functionBodyIRs: var coreir.BodyIR[],
                                      instructionWordCount: int32,
                                      relocCount: int32,
                                      dataLabelCount: int32): int64 =
    let rssBytes = os.ProcessRssBytes()
    PrimaryObjectPlanProgress(strutil.Join(["snapshot=",
                                            share(label),
                                            " rss_bytes=",
                                            strings.Int64ToStr(rssBytes),
                                            " body_ir_function_count=",
                                            strings.IntToStr(PrimaryBodyIrSeqRetainedFunctionCount(functionBodyIRs)),
                                            " body_ir_payload_item_count=",
                                            strings.IntToStr(PrimaryBodyIrSeqPayloadItemCount(functionBodyIRs)),
                                            " instruction_word_count=",
                                            strings.IntToStr(instructionWordCount),
                                            " reloc_count=",
                                            strings.IntToStr(relocCount),
                                            " data_label_count=",
                                            strings.IntToStr(dataLabelCount)],
                                           ""))
    return rssBytes

fn PrimaryBodyIRMoveInto(out: var coreir.BodyIR,
                         bodyIR: var coreir.BodyIR) =
    if bodylifecycle.BodyIrPayloadHasPhysicalStorage(out):
        panic("primary body ir move: destination owns physical payload")
    out = coreir.BodyIRNew()
    out.ops = bodyIR.ops
    out.callSequence = bodyIR.callSequence
    out.localSlots = bodyIR.localSlots
    out.entryDefinitionOwnershipSealed =
        bodyIR.entryDefinitionOwnershipSealed
    out.entryDefinitionOwnershipKinds =
        bodyIR.entryDefinitionOwnershipKinds
    out.entryDefinitionSemanticRows =
        bodyIR.entryDefinitionSemanticRows
    out.localBindingValueDefinitionDomainStart =
        bodyIR.localBindingValueDefinitionDomainStart
    out.localBindingValueDefinitionDomainCount =
        bodyIR.localBindingValueDefinitionDomainCount
    out.localBindingValueDefinitionRows =
        bodyIR.localBindingValueDefinitionRows
    out.entryParameterSlotIds = bodyIR.entryParameterSlotIds
    out.typeArenaArtifactCid = bodyIR.typeArenaArtifactCid
    out.typeFactTypeIds = bodyIR.typeFactTypeIds
    out.typeFactStructuralKinds = bodyIR.typeFactStructuralKinds
    out.typeFactScalarKinds = bodyIR.typeFactScalarKinds
    out.typeFactChildTypeIds = bodyIR.typeFactChildTypeIds
    out.typeFactFixedLengths = bodyIR.typeFactFixedLengths
    out.typeFactSizeBytes = bodyIR.typeFactSizeBytes
    out.typeFactAlignBytes = bodyIR.typeFactAlignBytes
    out.slotNameIndex = bodyIR.slotNameIndex
    out.blocks = bodyIR.blocks
    out.terms = bodyIR.terms
    out.cstringLiterals = bodyIR.cstringLiterals
    # The sealed data-relocation identity is part of the body's transport
    # contract: dropping it leaves cstring rows without an owner CID and the
    # next Backend2BodyIrEncode canonical check hard-fails. Move it with the
    # rest of the payload.
    out.dataRelocationIdentitySealed = bodyIR.dataRelocationIdentitySealed
    out.localAddressTargetDomainKinds = bodyIR.localAddressTargetDomainKinds
    out.localAddressTargetRows = bodyIR.localAddressTargetRows
    out.localAddressTargetCids = bodyIR.localAddressTargetCids
    out.cstringTargetRows = bodyIR.cstringTargetRows
    out.cstringOwnerFunctionFragmentCids =
        bodyIR.cstringOwnerFunctionFragmentCids
    out.controlFlowSealed = bodyIR.controlFlowSealed
    out.controlFunctionRow = bodyIR.controlFunctionRow
    out.controlScopeParentIds = bodyIR.controlScopeParentIds
    out.blockScopeIds = bodyIR.blockScopeIds
    out.termSuccessorStarts = bodyIR.termSuccessorStarts
    out.termSuccessorCounts = bodyIR.termSuccessorCounts
    out.successorBlockIds = bodyIR.successorBlockIds
    out.successorEdgeKinds = bodyIR.successorEdgeKinds
    out.callTargetDomainKinds = bodyIR.callTargetDomainKinds
    out.callTargetRows = bodyIR.callTargetRows
    out.callTargetInterfaceCids = bodyIR.callTargetInterfaceCids
    out.deferDeclarationScopeIds = bodyIR.deferDeclarationScopeIds
    out.deferSuiteScopeIds = bodyIR.deferSuiteScopeIds
    out.deferLexicalOrdinals = bodyIR.deferLexicalOrdinals
    out.deferFunctionRows = bodyIR.deferFunctionRows
    out.deferStatementRows = bodyIR.deferStatementRows
    out.deferActionCids = bodyIR.deferActionCids
    out.deferActivationSiteBlockIds = bodyIR.deferActivationSiteBlockIds
    out.deferActivationSiteAfterOpOrdinals =
        bodyIR.deferActivationSiteAfterOpOrdinals
    out.deferActivationSiteStarts = bodyIR.deferActivationSiteStarts
    out.deferActivationSiteCounts = bodyIR.deferActivationSiteCounts
    out.deferActivationRows = bodyIR.deferActivationRows
    out.cleanupSourceProjectionCid = bodyIR.cleanupSourceProjectionCid
    coreir.BodyIRCleanupIntentSidecarMoveInto(
        out.cleanupIntent, bodyIR.cleanupIntent)
    coreir.BodyIRCleanupScheduleSidecarMoveInto(
        out.cleanupSchedule, bodyIR.cleanupSchedule)
    coreir.BodyIRDeferReplaySidecarMoveInto(
        out.deferReplay, bodyIR.deferReplay)
    coreir.BodyIRManualConsumeSidecarMoveInto(
        out.manualConsume, bodyIR.manualConsume)
    coreir.BodyIRManagedLvalueReplaceSidecarMoveInto(
        out.managedLvalueReplace, bodyIR.managedLvalueReplace)
    coreir.BodyIRExternFfiHandleCapabilitySidecarMoveInto(
        out.externFfiHandleCapabilities,
        bodyIR.externFfiHandleCapabilities)
    out.debugProvenanceRequired = bodyIR.debugProvenanceRequired
    out.debugProvenanceComplete = bodyIR.debugProvenanceComplete
    out.debugFunctionId = bodyIR.debugFunctionId
    out.debugOpIdsByOpIndex = bodyIR.debugOpIdsByOpIndex
    out.debugSyntheticKindsByOpIndex =
        bodyIR.debugSyntheticKindsByOpIndex
    out.debugOpIdsByTermIndex = bodyIR.debugOpIdsByTermIndex
    out.debugSyntheticKindsByTermIndex =
        bodyIR.debugSyntheticKindsByTermIndex
    out.debugCurrentOpId = bodyIR.debugCurrentOpId
    out.debugCurrentSyntheticKind = bodyIR.debugCurrentSyntheticKind
    out.entryIsCAbi = bodyIR.entryIsCAbi
    out.frameMetricsReady = bodyIR.frameMetricsReady
    out.frameStackByteCount = bodyIR.frameStackByteCount
    out.frameParamSaveCount = bodyIR.frameParamSaveCount
    out.frameParamSaveOffset = bodyIR.frameParamSaveOffset
    out.frameReturnBufferSaveOffset = bodyIR.frameReturnBufferSaveOffset
    out.frameBytes = bodyIR.frameBytes
    out.framePrologueWordCount = bodyIR.framePrologueWordCount
    out.frameRestoreWordCount = bodyIR.frameRestoreWordCount
    out.layoutLhsElide = bodyIR.layoutLhsElide
    out.layoutStoreElide = bodyIR.layoutStoreElide
    out.layoutCopySrcElide = bodyIR.layoutCopySrcElide
    out.layoutCmpFuse = bodyIR.layoutCmpFuse
    out.layoutCbrFuse = bodyIR.layoutCbrFuse
    out.x64StackLayoutReady = bodyIR.x64StackLayoutReady
    out.x64SlotReadCnt = bodyIR.x64SlotReadCnt
    out.x64BlockStartReady = bodyIR.x64BlockStartReady
    out.x64BlockByteStart = bodyIR.x64BlockByteStart
    out.exactDef = bodyIR.exactDef
    bodyIR = coreir.BodyIRNew()

fn PrimaryBodyIRMoveFromTable(out: var coreir.BodyIR,
                               bodyIRs: var coreir.BodyIR[],
                               bodyIRIndex: int32) =
    assert(bodyIRIndex >= 0 && bodyIRIndex < bodyIRs.len,
           " primary body ir move: invalid table index")
    out = PrimaryBodyIRTakeFromTable(bodyIRs, bodyIRIndex)

fn PrimaryBodyIRTakeFromTable(
        bodyIRs: var coreir.BodyIR[],
        bodyIRIndex: int32): coreir.BodyIR =
    assert(bodyIRIndex >= 0 && bodyIRIndex < bodyIRs.len,
           " primary body ir move: invalid table index")
    var taken: coreir.BodyIR
    taken = bodyIRs[bodyIRIndex]
    bodyIRs[bodyIRIndex] = coreir.BodyIRNew()
    return taken

@borrows
fn PrimaryBodyIrWordCount(bodyIR: coreir.BodyIR): int32 =
    return PrimaryBodyIrGeneralCfgWordCount(bodyIR)

@borrows
fn PrimaryBodyIrIsEmissionSupported(bodyIR: coreir.BodyIR): bool =
    if bodyIR.ops.len > 0:
        return true
    if bodyIR.terms.len > 0:
        return true
    return false

@borrows
fn PrimaryBodyIrIsCallCfgReturnInt32(bodyIR: coreir.BodyIR): int32 =
    if bodyIR.callSequence.len <= 0:
        return 0
    if bodyIR.ops.len <= 0:
        return 0
    let lastIndex = bodyIR.ops.len - 1
    if bodyIR.ops[lastIndex].kind != coreir.BodyOpReturnTag:
        return 0
    return PrimaryBodyIrWordCount(bodyIR)

@borrows
fn PrimaryBodyIrCallCfgReturnInt32WordCount(bodyIR: coreir.BodyIR): int32 =
    return PrimaryBodyIrIsCallCfgReturnInt32(bodyIR)

@borrows
fn PrimaryBodyIrRequiresCallSequence(bodyIR: coreir.BodyIR): bool =
    if bodyIR.callSequence.len > 0:
        return true
    return false

@borrows
fn PrimaryBodyIrProjectOpSupported(bodyIR: coreir.BodyIR,
                                     op: coreir.BodyOp): bool =
    let _ = bodyIR
    if op.kind != coreir.BodyOpResultProjectTag:
        return false
    if op.operands.len < 1:
        return false
    # Value/Error/ErrInfo 投影必须携带布局 operand（[2]=偏移、[3]=字节数，
    # 生产者全部 4-operand 发射）；2-operand 旧形无生产者，缺布局即不支持
    # （诚实红），杜绝消费端回落 str 固定布局的静默 miscompile。
    if op.operands[0] == coreir.BodyResultProjectValueStrTag ||
       op.operands[0] == coreir.BodyResultProjectErrorStrTag ||
       op.operands[0] == coreir.BodyResultProjectErrInfoTag:
        if op.operands.len < 4:
            return false
    return true

@borrows
fn PrimaryBodyIrIsCallSequenceReturnSupported(bodyIR: coreir.BodyIR): bool =
    return PrimaryBodyIrIsCallSequenceReturnInt32(bodyIR)

@borrows
fn PrimaryBodyIrIsCallSequenceReturnI32Const(bodyIR: coreir.BodyIR): bool =
    if !PrimaryBodyIrIsCallSequenceReturnInt32(bodyIR):
        return false
    let lastIndex = bodyIR.ops.len - 1
    let lastOp = bodyIR.ops[lastIndex]
    if lastOp.operands.len < 2:
        return false
    if lastOp.operands[0] != PrimaryStatementReturnModeI32Const():
        return false
    return true

@borrows
fn PrimaryBodyIrIsCallSequenceGuardReturnInt32(bodyIR: coreir.BodyIR): bool =
    if !PrimaryBodyIrIsCallSequenceReturnInt32(bodyIR):
        return false
    if bodyIR.ops.len < 2:
        return false
    if bodyIR.ops[0].kind != coreir.BodyOpCallTag:
        return false
    return true

@borrows
fn PrimaryBodyIrLoadConstOpSupported(bodyIR: coreir.BodyIR,
                                       op: coreir.BodyOp): bool =
    let _ = bodyIR
    if op.kind != coreir.BodyOpLoadConstTag:
        return false
    if op.operands.len < 2:
        return false
    if op.operands[0] != coreir.LocalI32Tag:
        return false
    return true

@borrows
fn PrimaryBodyIrLocalCopyOpSupported(bodyIR: coreir.BodyIR,
                                       op: coreir.BodyOp): bool =
    let _ = bodyIR
    if op.kind != coreir.BodyOpCopyLocalTag:
        return false
    if op.operands.len < 1:
        return false
    return true

@borrows
fn PrimaryBodyIrRelocWordOffset(bodyIR: coreir.BodyIR,
                                  itemId: int32,
                                  callOrdinal: int32): int32 =
    let _ = itemId
    if callOrdinal < 0:
        return -1
    var seenCall: int32
    # accumulate the word position across blocks in one pass; recomputing
    # PrimaryBodyIRBlockStart per block is quadratic in block count
    var wordPos = PrimaryBodyIrPrologueWordCount(bodyIR)
    for bi in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[bi]
        if block.opStart < 0 || block.opCount < 0:
            return -1
        let opEnd = block.opStart + block.opCount
        if opEnd > bodyIR.ops.len:
            return -1
        for oi in block.opStart..<opEnd:
            let op = bodyIR.ops[oi]
            if op.kind == coreir.BodyOpCallTag:
                if seenCall == callOrdinal:
                    let call = bodyIR.callSequence[callOrdinal]
                    if PrimaryCallOpInlineAtomicFetchAddKind(call) > 0:
                        return -1
                    if PrimaryCallOpInlinePtrSlotKind(call) > 0:
                        return -1
                    if PrimaryCallOpInlineAesBlockKind(call) > 0:
                        return -1
                    if PrimaryCallOpInlineSha256BlockKind(call) > 0:
                        return -1
                    return wordPos + PrimaryBodyIRCallBlRelOffset(bodyIR, op)
                seenCall = seenCall + 1
            elif op.kind == coreir.BodyOpResultPanicGuardTag && op.operands.len == 2:
                # F14b: the panic guard embeds one call (op.operands[1]'s
                # ordinal) past its prefix (addr?+ldr+cbnz). Prefix width is
                # ResultPanicGuardPrefixWordCount (not a flat 2) so large-frame
                # cond materialize lands the BL where fill emits it.
                if seenCall == callOrdinal:
                    let panicCall = bodyIR.callSequence[callOrdinal]
                    if PrimaryCallOpInlineAtomicFetchAddKind(panicCall) > 0:
                        return -1
                    if PrimaryCallOpInlinePtrSlotKind(panicCall) > 0:
                        return -1
                    if PrimaryCallOpInlineAesBlockKind(panicCall) > 0:
                        return -1
                    if PrimaryCallOpInlineSha256BlockKind(panicCall) > 0:
                        return -1
                    let panicPrefixWords = PrimaryBodyIRResultPanicGuardPrefixWordCount(bodyIR, op.operands[0])
                    if panicPrefixWords <= 0:
                        return -1
                    var panicGuardRelocCallOp: coreir.BodyOp
                    panicGuardRelocCallOp.kind = coreir.BodyOpCallTag
                    add(panicGuardRelocCallOp.operands, callOrdinal)
                    return wordPos + panicPrefixWords + PrimaryBodyIRCallBlRelOffset(bodyIR, panicGuardRelocCallOp)
                seenCall = seenCall + 1
            wordPos = wordPos + PrimaryBodyIROpSizeAt(bodyIR, oi)
        wordPos = wordPos + PrimaryBodyIRTermSize(bodyIR, block.termIndex)
    return -1

@borrows
fn PrimaryBodyIrGeneralCfgRelocWordOffset(bodyIR: coreir.BodyIR,
                                            itemId: int32,
                                            callOrdinal: int32): int32 =
    return PrimaryBodyIrRelocWordOffset(bodyIR, itemId, callOrdinal)

@borrows
fn PrimaryBodyIrAppendCStringDataLabels(bodyIR: var coreir.BodyIR,
                                         functionSymbol: str,
                                         dataLabels: var str[],
                                         dataPayloadTexts: var str[],
                                         dataPayloadRawBytes: var int32[],
                                         dataPayloadRawByteCounts: var int32[]) =
    for literalIndex in 0..<bodyIR.cstringLiterals.len:
        add(dataLabels, PrimaryCStringLiteralDataLabel(functionSymbol, literalIndex))
        add(dataPayloadTexts, "-")
        let text = bodyIR.cstringLiterals[literalIndex].text
        var rawStart = dataPayloadRawBytes.len
        var byteCount: int32
        for ci in 0..<len(text):
            add(dataPayloadRawBytes, int32(text[ci]))
            byteCount = byteCount + 1
        add(dataPayloadRawBytes, 0)
        byteCount = byteCount + 1
        add(dataPayloadRawByteCounts, byteCount)

@borrows
fn PrimaryObjectDataLabelIndex(dataLabels: str[],
                                label: str): int32 =
    for i in 0..<dataLabels.len:
        if dataLabels[i] == label:
            return i
    return -1

@borrows
fn PrimaryGlobalDataLabel(targetTriple: str,
                           globalSlotName: str): str =
    return PrimaryTargetSymbolName(targetTriple,
                                   Fmt"cheng_global_{PrimarySanitizeSymbolPart(globalSlotName)}")

# Recover the global init payload for a global-address slot. A scalar i32 global
# with an explicit positive integer literal initializer (`var gv: int32 = 42`)
# must materialize that value into its __data slot; without this the slot is
# zero-filled and every read of the un-written global returns 0. The slot name is
# `{sourcePath}::{name}`, matching PrimaryBodyIrTypedGlobalSlotNameExact, so we
# look the init text up directly against the typed IR's global table.
@borrows
fn PrimaryBodyIrGlobalSlotZeroPayload(slot: coreir.LocalSlot): str =
    if slot.sizeBytes > 0:
        return Fmt"zero:{slot.sizeBytes}"
    return "zero:8"

# F07b: I64/uint64 同文件裸名 global-address 槽镜像。node-eval 侧把裸名撞回
# module-scope global 注册表(const 与 var 共用同一 globalNames/globalInitValues,
# 不分 const/var), 生成 BodyPlaceGlobalAddressTag 槽读 `__DATA` 数据——这与
# ScalarValueSlotForTextImpl 里 587c56e1a/F07 的 I64 常量文本查找臂(source-const
# cache)是两条独立路径, 前者先接管(RUN=1 静默读零的真根因不在文本臂, 而在
# 这条共享的 data-payload 生成器素来只认 I32/4 字节, 宽类型一律落零填充)。按
# I32 分支同构补齐 I64/8 字节: 复用本文件已有的 PrimaryBodyIrExtractInt64FromText
# (支持十进制/十六进制/负号/基础类型 cast 包裹, 比 texpr 侧 I32 专用解析器更宽),
# 值 0 与解析失败都退化到既有的 zero payload(字节结果相同, 非功能差异)。
@borrows
fn PrimaryBodyIrGlobalDataPayloadText(typedIr: texpr.TypedExprIr,
                                       slot: coreir.LocalSlot): str =
    if slot.typeKind == coreir.LocalI64Tag && slot.sizeBytes == 8:
        var sepPos64: int32 = -1
        for i in 0..<len(slot.name):
            if i + 1 < len(slot.name) && slot.name[i] == ':' && slot.name[i + 1] == ':':
                sepPos64 = i
        if sepPos64 < 0:
            return PrimaryBodyIrGlobalSlotZeroPayload(slot)
        let sourcePath64 = strings.SliceBytes(slot.name, 0, sepPos64)
        let globalName64 = strings.SliceBytes(slot.name, sepPos64 + 2, len(slot.name) - sepPos64 - 2)
        let initText64 = texpr.TypedExprIrLookupGlobalInitValue(typedIr, sourcePath64, globalName64)
        var value64: int64
        if !PrimaryBodyIrExtractInt64FromText(initText64, value64):
            return PrimaryBodyIrGlobalSlotZeroPayload(slot)
        if value64 == int64(0):
            return PrimaryBodyIrGlobalSlotZeroPayload(slot)
        return Fmt"hex:{payloadcodec.BackendDataPayloadU64LeHex(value64)}"
    if slot.typeKind != coreir.LocalI32Tag || slot.sizeBytes != 4:
        return PrimaryBodyIrGlobalSlotZeroPayload(slot)
    # Split slot.name `{sourcePath}::{name}` at its LAST `::`.
    var sepPos: int32 = -1
    for i in 0..<len(slot.name):
        if i + 1 < len(slot.name) && slot.name[i] == ':' && slot.name[i + 1] == ':':
            sepPos = i
    if sepPos < 0:
        return PrimaryBodyIrGlobalSlotZeroPayload(slot)
    let sourcePath = strings.SliceBytes(slot.name, 0, sepPos)
    let globalName = strings.SliceBytes(slot.name, sepPos + 2, len(slot.name) - sepPos - 2)
    let initText = texpr.TypedExprIrLookupGlobalInitValue(typedIr, sourcePath, globalName)
    if !texpr.TypedExprIrIsI32ConstLiteral(initText):
        return PrimaryBodyIrGlobalSlotZeroPayload(slot)
    let value = texpr.TypedExprIrParseI32Const(initText)
    if value == 0:
        return PrimaryBodyIrGlobalSlotZeroPayload(slot)
    return Fmt"hex:{payloadcodec.BackendDataPayloadU32LeHex(value)}"

@borrows
fn PrimaryBodyIrAppendGlobalDataLabels(bodyIR: var coreir.BodyIR,
                                        typedIr: texpr.TypedExprIr,
                                        targetTriple: str,
                                        dataLabels: var str[],
                                        dataPayloadTexts: var str[],
                                        dataPayloadRawByteCounts: var int32[]) =
    for slotIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[slotIndex]
        if slot.placeKind != coreir.BodyPlaceGlobalAddressTag:
            continue
        if PrimaryBodyIrFunctionAddressSlotIndex(slot.name) >= 0:
            continue
        let label = PrimaryGlobalDataLabel(targetTriple, slot.name)
        if PrimaryObjectDataLabelIndex(dataLabels, label) >= 0:
            continue
        add(dataLabels, label)
        add(dataPayloadRawByteCounts, 0)
        add(dataPayloadTexts, PrimaryBodyIrGlobalDataPayloadText(typedIr, slot))

# Phase 2.5+ negative test: consumed (shipped) word offset for a call-cstring-arg reloc. With the
# perturb flag set (and the cstring-arg class selected) returns predicted+1 so the consumed reloc
# desyncs from the real ADRP while the predicted key (the FillAndCheck rewrite key) stays true. ON
# the real fill record restores the correct offset; OFF the corrupt offset ships. Returns predicted
# unchanged in every steady build.
fn PrimaryCallCStringArgConsumedOffset(predicted: int32): int32 =
    if primaryCallDataRelocPerturb && !primaryCallDataRelocSretGlobalClassOnly:
        return predicted + 1
    return predicted

fn PrimaryCallSretGlobalConsumedOffset(predicted: int32): int32 =
    if primaryCallDataRelocPerturb && !primaryCallDataRelocCStringArgClassOnly:
        return predicted + 1
    return predicted

# Step B-data (data reloc emit-first): append the STRUCTURAL key (oi, subIndex) of a data reloc in
# lockstep with the predictedKeys/targetSymbols arrays so all stay parallel. On the emit-first path
# (arm64 Darwin EmitObj) FillAndCheck joins this key against the serial-fill record table; off it
# (x64 / wasm / arm64 debug zero-scan) the key is -1 and the predictor offset (predictedKeys) is kept.
fn PrimaryDataRelocKeyAppend(emitFirst: bool,
                             oi: int32,
                             sub: int32,
                             opIndexOut: var int32[],
                             subIndexOut: var int32[]) =
    if emitFirst:
        add(opIndexOut, oi)
        add(subIndexOut, sub)
    else:
        add(opIndexOut, -1)
        add(subIndexOut, -1)

@borrows
fn PrimaryBodyIrAppendCallCStringArgRelocs(bodyIR: coreir.BodyIR,
                                            call: coreir.CallOp,
                                            itemId: int32,
                                            targetTriple: str,
                                            functionSymbol: str,
                                            allSymbolNames: str[],
                                            callWordStart: int32,
                                            emitFirst: bool,
                                            opIndex: int32,
                                            sourceItemIds: var int32[],
                                            wordOffsets: var int32[],
                                            predictedKeys: var int32[],
                                            opIndexOut: var int32[],
                                            subIndexOut: var int32[],
                                            targetSymbols: var str[]) =
    var pos = callWordStart
    # Step B-data: subIndex counts the emitted cstring-arg / sret-global relocs in arg-walk order,
    # mirroring the fill's FillCallOp counter exactly so the (opIndex, subIndex) key is identical.
    var subIndex: int32
    if PrimaryCallOpStackArgBytes(call) > 0:
        pos = pos + PrimaryBodyIrStackAdjustWordCount(
            PrimaryCallOpStackArgBytes(call))
    let registerArgCount = PrimaryCallOpRegisterArgCount(call)
    for argIndex in 0..<registerArgCount:
        let argSlot = call.argSlots[argIndex]
        let passKind = PrimaryCallOpArgPassKind(call, argIndex)
        if coreir.CallArgSlotIsCString(argSlot):
            let literalId = coreir.CallArgSlotCStringId(argSlot)
            if literalId >= 0 && literalId < bodyIR.cstringLiterals.len:
                add(sourceItemIds, itemId)
                add(wordOffsets, PrimaryCallCStringArgConsumedOffset(pos))
                add(predictedKeys, pos)
                PrimaryDataRelocKeyAppend(emitFirst, opIndex, subIndex, opIndexOut, subIndexOut)
                subIndex = subIndex + 1
                add(targetSymbols, PrimaryCStringLiteralDataLabel(functionSymbol, literalId))
        elif passKind == coreir.BodyCallPassGlobalAddressTag:
            if argSlot >= 0 &&
               argSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[argSlot].placeKind == coreir.BodyPlaceGlobalAddressTag:
                var targetSymbol = PrimaryGlobalDataLabel(targetTriple, bodyIR.localSlots[argSlot].name)
                let functionIndex = PrimaryBodyIrFunctionAddressSlotIndex(bodyIR.localSlots[argSlot].name)
                if functionIndex >= 0 && functionIndex < allSymbolNames.len:
                    targetSymbol = allSymbolNames[functionIndex]
                add(sourceItemIds, itemId)
                add(wordOffsets, PrimaryCallCStringArgConsumedOffset(pos))
                add(predictedKeys, pos)
                PrimaryDataRelocKeyAppend(emitFirst, opIndex, subIndex, opIndexOut, subIndexOut)
                subIndex = subIndex + 1
                add(targetSymbols, targetSymbol)
        let argWords = PrimaryBodyIrCallArgWordCount(bodyIR,
                                                     argSlot,
                                                     passKind,
                                                     PrimaryCallOpStackArgBytes(call),
                                                     call.targetIsImportc)
        if argWords <= 0:
            return
        pos = pos + argWords
    let stackArgCount = PrimaryCallOpStackArgCount(call)
    for stackArgIndex in 0..<stackArgCount:
        let argIndex = stackArgIndex + 8
        let argSlot = call.argSlots[argIndex]
        let passKind = PrimaryCallOpArgPassKind(call, argIndex)
        if coreir.CallArgSlotIsCString(argSlot):
            let literalId = coreir.CallArgSlotCStringId(argSlot)
            if literalId >= 0 && literalId < bodyIR.cstringLiterals.len:
                add(sourceItemIds, itemId)
                add(wordOffsets, PrimaryCallCStringArgConsumedOffset(pos))
                add(predictedKeys, pos)
                PrimaryDataRelocKeyAppend(emitFirst, opIndex, subIndex, opIndexOut, subIndexOut)
                subIndex = subIndex + 1
                add(targetSymbols, PrimaryCStringLiteralDataLabel(functionSymbol, literalId))
        elif passKind == coreir.BodyCallPassGlobalAddressTag:
            if argSlot >= 0 &&
               argSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[argSlot].placeKind == coreir.BodyPlaceGlobalAddressTag:
                var targetSymbol = PrimaryGlobalDataLabel(targetTriple, bodyIR.localSlots[argSlot].name)
                let functionIndex = PrimaryBodyIrFunctionAddressSlotIndex(bodyIR.localSlots[argSlot].name)
                if functionIndex >= 0 && functionIndex < allSymbolNames.len:
                    targetSymbol = allSymbolNames[functionIndex]
                add(sourceItemIds, itemId)
                add(wordOffsets, PrimaryCallCStringArgConsumedOffset(pos))
                add(predictedKeys, pos)
                PrimaryDataRelocKeyAppend(emitFirst, opIndex, subIndex, opIndexOut, subIndexOut)
                subIndex = subIndex + 1
                add(targetSymbols, targetSymbol)
        let argWords = PrimaryBodyIrCallArgWordCount(bodyIR,
                                                     argSlot,
                                                     passKind,
                                                     PrimaryCallOpStackArgBytes(call),
                                                     false)
        if argWords <= 0:
            return
        let stackStoreWords = PrimaryBodyIrStackAccessWordCount(
            PrimaryCallOpStackArgOffset(call, stackArgIndex),
            PrimaryCallOpStackArgSize(call, stackArgIndex))
        if stackStoreWords <= 0:
            return
        pos = pos + argWords + stackStoreWords
    # After all register/stack args, `pos` is the indirect-result x8 setup. When
    # the sret destination is a GLOBAL aggregate (`gAgg = make(...)`), the x8
    # adrp+add needs a PAGE/PAGEOFF reloc against the global label, recorded at
    # the adrp word (the arm64 writer emits page21+pageoff12 from this offset).
    if PrimaryBodyIRCallIndirectResultIsGlobal(bodyIR, call):
        add(sourceItemIds, itemId)
        add(wordOffsets, PrimaryCallSretGlobalConsumedOffset(pos))
        add(predictedKeys, pos)
        PrimaryDataRelocKeyAppend(emitFirst, opIndex, subIndex, opIndexOut, subIndexOut)
        subIndex = subIndex + 1
        add(targetSymbols, PrimaryGlobalDataLabel(targetTriple, bodyIR.localSlots[call.resultSlot].name))

@borrows
fn PrimaryBodyIrAppendCallCStringArgRelocsX64(bodyIR: coreir.BodyIR,
                                               call: coreir.CallOp,
                                               itemId: int32,
                                               targetTriple: str,
                                               functionSymbol: str,
                                               allSymbolNames: str[],
                                               callWordStart: int32,
                                               sourceItemIds: var int32[],
                                               wordOffsets: var int32[],
                                               predictedKeys: var int32[],
                                               opIndexOut: var int32[],
                                               subIndexOut: var int32[],
                                               targetSymbols: var str[]) =
    # x64 keeps the predictor: every data reloc key is -1 (no emit-first join).
    # segment-b: callWordStart and pos are BYTE offsets; each reg arg is 8B, each
    # stack arg 16B (load+store), the sub-rsp marker 8B, and the lea-rip rel32 sits
    # 4B into its 8B group.
    var pos = callWordStart
    if x64units.CodegenX64BodyCallStackArgBytes(bodyIR, call) > 0:
        pos = pos + 8
    let registerArgCount = x64units.CodegenX64BodyCallRegArgCount(bodyIR, call)
    for argIndex in 0..<registerArgCount:
        let argSlot = call.argSlots[argIndex]
        let passKind = PrimaryCallOpArgPassKind(call, argIndex)
        if coreir.CallArgSlotIsCString(argSlot):
            let literalId = coreir.CallArgSlotCStringId(argSlot)
            if literalId >= 0 && literalId < bodyIR.cstringLiterals.len:
                add(sourceItemIds, itemId)
                add(wordOffsets, pos + 4)
                add(predictedKeys, pos + 4)
                add(opIndexOut, -1)
                add(subIndexOut, -1)
                add(targetSymbols, PrimaryCStringLiteralDataLabel(functionSymbol, literalId))
        elif passKind == coreir.BodyCallPassGlobalAddressTag:
            if argSlot >= 0 &&
               argSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[argSlot].placeKind == coreir.BodyPlaceGlobalAddressTag:
                var targetSymbol = PrimaryGlobalDataLabel(targetTriple, bodyIR.localSlots[argSlot].name)
                let functionIndex = PrimaryBodyIrFunctionAddressSlotIndex(bodyIR.localSlots[argSlot].name)
                if functionIndex >= 0 && functionIndex < allSymbolNames.len:
                    targetSymbol = allSymbolNames[functionIndex]
                add(sourceItemIds, itemId)
                add(wordOffsets, pos + 4)
                add(predictedKeys, pos + 4)
                add(opIndexOut, -1)
                add(subIndexOut, -1)
                add(targetSymbols, targetSymbol)
        if x64units.CodegenX64BodyCallArgWordCount(bodyIR, argSlot, passKind) <= 0:
            return
        pos = pos + 8
    let stackArgCount = x64units.CodegenX64BodyCallStackArgCount(bodyIR, call)
    for stackArgIndex in 0..<stackArgCount:
        let argIndex = registerArgCount + stackArgIndex
        let argSlot = call.argSlots[argIndex]
        let passKind = PrimaryCallOpArgPassKind(call, argIndex)
        if coreir.CallArgSlotIsCString(argSlot):
            let literalId = coreir.CallArgSlotCStringId(argSlot)
            if literalId >= 0 && literalId < bodyIR.cstringLiterals.len:
                add(sourceItemIds, itemId)
                add(wordOffsets, pos + 4)
                add(predictedKeys, pos + 4)
                add(opIndexOut, -1)
                add(subIndexOut, -1)
                add(targetSymbols, PrimaryCStringLiteralDataLabel(functionSymbol, literalId))
        elif passKind == coreir.BodyCallPassGlobalAddressTag:
            if argSlot >= 0 &&
               argSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[argSlot].placeKind == coreir.BodyPlaceGlobalAddressTag:
                var targetSymbol = PrimaryGlobalDataLabel(targetTriple, bodyIR.localSlots[argSlot].name)
                let functionIndex = PrimaryBodyIrFunctionAddressSlotIndex(bodyIR.localSlots[argSlot].name)
                if functionIndex >= 0 && functionIndex < allSymbolNames.len:
                    targetSymbol = allSymbolNames[functionIndex]
                add(sourceItemIds, itemId)
                add(wordOffsets, pos + 4)
                add(predictedKeys, pos + 4)
                add(opIndexOut, -1)
                add(subIndexOut, -1)
                add(targetSymbols, targetSymbol)
        if x64units.CodegenX64BodyCallArgWordCount(bodyIR, argSlot, passKind) <= 0:
            return
        pos = pos + 16

@borrows
fn PrimaryBodyIrAppendCStringArgRelocs(bodyIR: var coreir.BodyIR,
                                        itemId: int32,
                                        functionWordOffset: int32,
                                        targetTriple: str,
                                        functionSymbol: str,
                                        allSymbolNames: var str[],
                                        emitFirst: bool,
                                        sourceItemIds: var int32[],
                                        wordOffsets: var int32[],
                                        predictedKeys: var int32[],
                                        opIndexOut: var int32[],
                                        subIndexOut: var int32[],
                                        targetSymbols: var str[]) =
    let isX64 =
        contract.CodegenBodyEmitUnit(targetTriple) == contract.CodegenUnitX64
    # Phase 2.5 negative test (source escape hatch): perturb the COVERED bare-cstring-load data
    # reloc word offset by +1 so the consumed value desyncs from the real ADRP position, while
    # leaving predictedKeys (the FillAndCheck rewrite key) untouched. With the emit-first rewrite
    # ON the real fill record restores the correct offset (object links/runs); OFF the corrupt
    # offset ships a mis-targeted ADRP page reloc (runtime breaks). primaryDataRelocPerturb is
    # false in every steady build (flipped only for the manual A/B negative test; env gates cannot
    # be used because os.GetEnv returns empty inside the selfhost compiler binary).
    let perturbCStringReloc = primaryDataRelocPerturb
    # accumulate the word position across blocks in one pass; recomputing
    # the per-block start is quadratic in block count
    # segment-b: x86 accumulates a BYTE cursor (function byte base = word offset ×4,
    # then byte-granular prologue/op/term sizes). arm64 stays word-granular.
    var wordPos = functionWordOffset
    if isX64:
        wordPos = functionWordOffset * 4 + x64units.CodegenX64BodyPrologueByteCount(bodyIR)
    else:
        wordPos = wordPos + PrimaryBodyIrPrologueWordCount(bodyIR)
    for bi in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[bi]
        let opEnd = block.opStart + block.opCount
        if block.opStart < 0 || opEnd > bodyIR.ops.len:
            return
        for oi in block.opStart..<opEnd:
            let op = bodyIR.ops[oi]
            if op.kind == coreir.BodyOpLoadLocalTag &&
               op.operands.len >= 2 &&
               op.operands[0] == coreir.BodyLoadLocalCStringTag:
                let loadLiteralId = op.operands[1]
                if loadLiteralId >= 0 && loadLiteralId < bodyIR.cstringLiterals.len:
                    add(sourceItemIds, itemId)
                    if isX64:
                        # x86_64: RIP-relative LEA group, reloc on the 2nd word.
                        add(wordOffsets, wordPos + 4)
                        add(predictedKeys, wordPos + 4)
                    else:
                        # arm64: ADRP is the op's first word; the writer emits
                        # the page21+pageoff12 pair from this single offset.
                        var cstrConsumed = wordPos
                        if perturbCStringReloc:
                            cstrConsumed = wordPos + 1
                        add(wordOffsets, cstrConsumed)
                        add(predictedKeys, wordPos)
                    # Step B-data: bare cstring load is a single-reloc op anchored at op `oi`,
                    # so the structural key is (oi, 0) — matching FillBlockOp's record.
                    PrimaryDataRelocKeyAppend(emitFirst, oi, 0, opIndexOut, subIndexOut)
                    add(targetSymbols, PrimaryCStringLiteralDataLabel(functionSymbol, loadLiteralId))
            if op.kind == coreir.BodyOpStrEqLiteralTag &&
               op.operands.len >= 2:
                let compareLiteralId = op.operands[1]
                if compareLiteralId >= 0 && compareLiteralId < bodyIR.cstringLiterals.len:
                    add(sourceItemIds, itemId)
                    if isX64:
                        # LEA-RIP group: rel32 field begins four bytes into op.
                        add(wordOffsets, wordPos + 4)
                        add(predictedKeys, wordPos + 4)
                    else:
                        # ARM64 compact loop starts with ADRP+ADD.
                        add(wordOffsets, wordPos)
                        add(predictedKeys, wordPos)
                    PrimaryDataRelocKeyAppend(emitFirst, oi, 0, opIndexOut, subIndexOut)
                    add(targetSymbols, PrimaryCStringLiteralDataLabel(functionSymbol, compareLiteralId))
            if op.kind == coreir.BodyOpCallTag && op.operands.len > 0:
                let callOrdinal = op.operands[0]
                if callOrdinal >= 0 && callOrdinal < bodyIR.callSequence.len:
                    if isX64:
                        PrimaryBodyIrAppendCallCStringArgRelocsX64(bodyIR,
                                                                   bodyIR.callSequence[callOrdinal],
                                                                   itemId,
                                                                   targetTriple,
                                                                   functionSymbol,
                                                                   allSymbolNames,
                                                                   wordPos,
                                                                   sourceItemIds,
                                                                   wordOffsets,
                                                                   predictedKeys,
                                                                   opIndexOut,
                                                                   subIndexOut,
                                                                   targetSymbols)
                    else:
                        # Step B-data: the call op's data relocs are keyed by (oi, subIndex) where
                        # `oi` is THIS call op index — matching FillCallOp, which now receives oi.
                        PrimaryBodyIrAppendCallCStringArgRelocs(bodyIR,
                                                                bodyIR.callSequence[callOrdinal],
                                                                itemId,
                                                                targetTriple,
                                                                functionSymbol,
                                                                allSymbolNames,
                                                                wordPos,
                                                                emitFirst,
                                                                oi,
                                                                sourceItemIds,
                                                                wordOffsets,
                                                                predictedKeys,
                                                                opIndexOut,
                                                                subIndexOut,
                                                                targetSymbols)
            var opSize: int32
            if isX64:
                opSize = x64units.CodegenX64BodyOpSizeAt(bodyIR, oi)
            else:
                opSize = PrimaryBodyIROpSizeAt(bodyIR, oi)
            if opSize <= 0:
                return
            wordPos = wordPos + opSize
        if isX64:
            wordPos = wordPos + x64units.CodegenX64BodyTermSize(bodyIR, block.termIndex)
        else:
            wordPos = wordPos + PrimaryBodyIRTermSize(bodyIR, block.termIndex)

@borrows
fn PrimaryBodyIrAppendGlobalOpRelocs(bodyIR: var coreir.BodyIR,
                                      itemId: int32,
                                      functionWordOffset: int32,
                                      targetTriple: str,
                                      allSymbolNames: var str[],
                                      emitFirst: bool,
                                      sourceItemIds: var int32[],
                                      wordOffsets: var int32[],
                                      predictedKeys: var int32[],
                                      opIndexOut: var int32[],
                                      subIndexOut: var int32[],
                                      targetSymbols: var str[]) =
    let isX64 =
        contract.CodegenBodyEmitUnit(targetTriple) == contract.CodegenUnitX64
    # Phase 2.5 negative test (source escape hatch): perturb the COVERED global-address data
    # reloc word offset by +1 (see PrimaryBodyIrAppendCStringArgRelocs). predictedKeys stays true.
    # Driven by the module-level primaryDataRelocPerturb flag (false in every steady build; flipped
    # only for the manual A/B negative test) because os.GetEnv returns empty inside the selfhost
    # compiler binary, so an env gate cannot reach this code.
    let perturbGlobalReloc = primaryDataRelocPerturb
    # accumulate the word position across blocks in one pass; recomputing
    # the per-block start is quadratic in block count
    # segment-b: x86 accumulates a BYTE cursor (function byte base = word offset ×4,
    # then byte-granular prologue/op/term sizes). arm64 stays word-granular.
    var wordPos = functionWordOffset
    if isX64:
        wordPos = functionWordOffset * 4 + x64units.CodegenX64BodyPrologueByteCount(bodyIR)
    else:
        wordPos = wordPos + PrimaryBodyIrPrologueWordCount(bodyIR)
    for bi in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[bi]
        let opEnd = block.opStart + block.opCount
        if block.opStart < 0 || opEnd > bodyIR.ops.len:
            return
        for oi in block.opStart..<opEnd:
            let op = bodyIR.ops[oi]
            var opUsesGlobalAddress: bool
            if op.operands.len > 0:
                if op.kind == coreir.BodyOpGlobalLoadTag:
                    opUsesGlobalAddress = true
                elif op.kind == coreir.BodyOpGlobalStoreTag:
                    opUsesGlobalAddress = true
                elif !isX64 &&
                     (op.kind == coreir.BodyOpFieldLoadTag ||
                      op.kind == coreir.BodyOpFieldStoreTag ||
                      op.kind == coreir.BodyOpIndexedLoadTag ||
                      op.kind == coreir.BodyOpIndexedStoreTag):
                    opUsesGlobalAddress = true
                elif !isX64 &&
                     op.kind == coreir.BodyOpLoadLocalTag &&
                     ((op.operands.len == 5 &&
                       op.operands[0] ==
                           coreir.BodyLoadLocalIndexedAddressTag) ||
                      (op.operands.len == 4 &&
                       op.operands[0] ==
                           coreir.BodyLoadLocalFieldAddressTag)):
                    opUsesGlobalAddress = true
            if opUsesGlobalAddress:
                var argSlot = op.operands[0]
                if op.kind == coreir.BodyOpLoadLocalTag &&
                   ((op.operands.len == 5 &&
                     op.operands[0] ==
                         coreir.BodyLoadLocalIndexedAddressTag) ||
                    (op.operands.len == 4 &&
                     op.operands[0] ==
                         coreir.BodyLoadLocalFieldAddressTag)):
                    argSlot = op.operands[1]
                if argSlot >= 0 &&
                   argSlot < bodyIR.localSlots.len &&
                   bodyIR.localSlots[argSlot].placeKind == coreir.BodyPlaceGlobalAddressTag:
                    var targetSymbol = PrimaryGlobalDataLabel(targetTriple, bodyIR.localSlots[argSlot].name)
                    let functionIndex = PrimaryBodyIrFunctionAddressSlotIndex(bodyIR.localSlots[argSlot].name)
                    if functionIndex >= 0 && functionIndex < allSymbolNames.len:
                        targetSymbol = allSymbolNames[functionIndex]
                    add(sourceItemIds, itemId)
                    if isX64:
                        add(wordOffsets, wordPos + 4)
                        add(predictedKeys, wordPos + 4)
                    else:
                        var globalConsumed = wordPos
                        if perturbGlobalReloc:
                            globalConsumed = wordPos + 1
                        add(wordOffsets, globalConsumed)
                        add(predictedKeys, wordPos)
                    # Step B-data: each global-address op has one reloc anchored at op `oi`,
                    # so the structural key is (oi, 0) — matching FillBlockOp's record.
                    PrimaryDataRelocKeyAppend(emitFirst, oi, 0, opIndexOut, subIndexOut)
                    add(targetSymbols, targetSymbol)
            var opSize: int32
            if isX64:
                opSize = x64units.CodegenX64BodyOpSizeAt(bodyIR, oi)
            else:
                opSize = PrimaryBodyIROpSizeAt(bodyIR, oi)
            if opSize <= 0:
                return
            wordPos = wordPos + opSize
        if isX64:
            wordPos = wordPos + x64units.CodegenX64BodyTermSize(bodyIR, block.termIndex)
        else:
            wordPos = wordPos + PrimaryBodyIRTermSize(bodyIR, block.termIndex)

fn PrimaryBodyCondIsF64(condTag: int32): bool =
    return condTag >= coreir.BodyCondF64EqTag && condTag <= coreir.BodyCondF64GeTag

fn PrimaryA64CondBranchWord(fromWord: int32, toWord: int32, condCode: int32): int32 =
    let offset = toWord - fromWord
    return 0x54000000 + (offset << 5) + condCode

@borrows
fn PrimaryBodyIRBlockStart(bodyIR: coreir.BodyIR, blockIndex: int32): int32 =
    let prologueSize = PrimaryBodyIrPrologueWordCount(bodyIR)
    let blockStart = prologueSize
    let bi = 0
    return PrimaryBodyIRBlockStartHelper(bodyIR, blockIndex, bi, blockStart)

@borrows
fn PrimaryBodyIRBlockStartHelper(bodyIR: coreir.BodyIR, targetIndex: int32, bi: int32, pos: int32): int32 =
    if bi >= targetIndex || bi >= bodyIR.blocks.len:
        return pos
    let blockSize = PrimaryBodyIRBlockSize(bodyIR, bi)
    return PrimaryBodyIRBlockStartHelper(bodyIR, targetIndex, bi + 1, pos + blockSize)

@borrows
fn PrimaryBodyIRBlockSize(bodyIR: coreir.BodyIR, blockIndex: int32): int32 =
    if blockIndex < 0 || blockIndex >= bodyIR.blocks.len:
        return 0
    let block = bodyIR.blocks[blockIndex]
    let opStart = block.opStart
    let opEnd = block.opStart + block.opCount
    let opSize = PrimaryBodyIROpRangeSize(bodyIR, opStart, opEnd)
    let termIndex = block.termIndex
    let termSize = PrimaryBodyIRTermSize(bodyIR, termIndex)
    return opSize + termSize

@borrows
fn PrimaryBodyIROpRangeSize(bodyIR: coreir.BodyIR, opStart: int32, opEnd: int32): int32 =
    if opStart >= opEnd || opStart >= bodyIR.ops.len:
        return 0
    if opStart < 0:
        return 0
    let firstSize = PrimaryBodyIROpSizeAt(bodyIR, opStart)
    return firstSize + PrimaryBodyIROpRangeSize(bodyIR, opStart + 1, opEnd)

@borrows
fn PrimaryBodyIRCallHasIndirectResult(bodyIR: coreir.BodyIR,
                                       call: coreir.CallOp): bool =
    if call.resultSlot < 0 || call.resultSlot >= bodyIR.localSlots.len:
        return false
    let resultType = bodyIR.localSlots[call.resultSlot].typeKind
    if resultType == coreir.LocalStrTag:
        return true
    if resultType == coreir.LocalAggregateTag:
        return true
    return false

@borrows
fn PrimaryBodyIRCallIndirectResultIsGlobal(bodyIR: coreir.BodyIR,
                                            call: coreir.CallOp): bool =
    # An sret (str/aggregate) result whose destination slot is a GLOBAL-address
    # place: x8 must point at the global symbol (adrp+add) rather than a stack
    # slot. A function-address slot is never an sret data destination.
    if call.resultSlot < 0 || call.resultSlot >= bodyIR.localSlots.len:
        return false
    let resultType = bodyIR.localSlots[call.resultSlot].typeKind
    if resultType != coreir.LocalStrTag && resultType != coreir.LocalAggregateTag:
        return false
    if bodyIR.localSlots[call.resultSlot].placeKind != coreir.BodyPlaceGlobalAddressTag:
        return false
    if PrimaryBodyIrFunctionAddressSlotIndex(bodyIR.localSlots[call.resultSlot].name) >= 0:
        return false
    return true

@borrows
fn PrimaryBodyIRCallStoresScalarResult(bodyIR: coreir.BodyIR,
                                        call: coreir.CallOp): bool =
    if call.resultSlot < 0 || call.resultSlot >= bodyIR.localSlots.len:
        return false
    let resultType = bodyIR.localSlots[call.resultSlot].typeKind
    if resultType == coreir.LocalI32Tag:
        return true
    if resultType == coreir.LocalI64Tag:
        return true
    if resultType == coreir.LocalPtrTag:
        return true
    if resultType == coreir.LocalF64Tag:
        # #76 root fix: an f64 CALL result is exactly as much a scalar as an
        # I64/Ptr one (single result slot, no sret) -- this predicate returning
        # false unconditionally silently skipped the post-call store, so the
        # result slot kept whatever garbage was already on the stack. See
        # PrimaryBodyIRCallResultIsF64Scalar for the sibling gate that adds the
        # `fmov x0,d0` boundary conversion this store depends on.
        return true
    return false

# #76: is `call`'s result slot f64-typed? Shared gate between the fill's
# `fmov x0,d0` (converts the physical D0 the CALL instruction just produced
# into the raw-bits-in-X0 convention every other call kind already leaves
# behind for PrimaryBodyIRStoreRegToSlot) and the word-count predictor that
# must mirror it exactly.
@borrows
fn PrimaryBodyIRCallResultIsF64Scalar(bodyIR: coreir.BodyIR,
                                       call: coreir.CallOp): bool =
    if call.resultSlot < 0 || call.resultSlot >= bodyIR.localSlots.len:
        return false
    return bodyIR.localSlots[call.resultSlot].typeKind == coreir.LocalF64Tag

@borrows
fn PrimaryBodyIRCallBlRelOffset(bodyIR: coreir.BodyIR,
                                 op: coreir.BodyOp): int32 =
    var primaryColdCond30: bool
    if op.kind != coreir.BodyOpCallTag:
        primaryColdCond30 = true
    if op.operands.len <= 0:
        primaryColdCond30 = true
    if primaryColdCond30:
        return -1
    let callOrdinal = op.operands[0]
    if callOrdinal < 0 || callOrdinal >= bodyIR.callSequence.len:
        return -1
    let call = bodyIR.callSequence[callOrdinal]
    var offset: int32
    if PrimaryCallOpStackArgBytes(call) > 0:
        offset = offset + PrimaryBodyIrStackAdjustWordCount(
            PrimaryCallOpStackArgBytes(call))
    let registerArgCount = PrimaryCallOpRegisterArgCount(call)
    for argIndex in 0..<registerArgCount:
        let argWords = PrimaryBodyIrCallArgWordCount(bodyIR,
                                                     call.argSlots[argIndex],
                                                     PrimaryCallOpArgPassKind(call, argIndex),
                                                     PrimaryCallOpStackArgBytes(call),
                                                     call.targetIsImportc)
        if argWords <= 0:
            return -1
        offset = offset + argWords
    let stackArgCount = PrimaryCallOpStackArgCount(call)
    for stackArgIndex in 0..<stackArgCount:
        let argIndex = stackArgIndex + 8
        let argWords = PrimaryBodyIrCallArgWordCount(bodyIR,
                                                     call.argSlots[argIndex],
                                                     PrimaryCallOpArgPassKind(call, argIndex),
                                                     PrimaryCallOpStackArgBytes(call),
                                                     false)
        if argWords <= 0:
            return -1
        let stackStoreWords = PrimaryBodyIrStackAccessWordCount(
            PrimaryCallOpStackArgOffset(call, stackArgIndex),
            PrimaryCallOpStackArgSize(call, stackArgIndex))
        if stackStoreWords <= 0:
            return -1
        offset = offset + argWords + stackStoreWords
    if PrimaryBodyIRCallHasIndirectResult(bodyIR, call):
        if PrimaryBodyIRCallIndirectResultIsGlobal(bodyIR, call):
            # global sret destination: adrp + add = exactly 2 words.
            offset = offset + 2
        else:
            let resultOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                            call.resultSlot,
                                                            PrimaryBodyIrFrameBytes(bodyIR),
                                                            PrimaryBodyIrParamSaveOffset(bodyIR),
                                                            PrimaryBodyIrParamSaveCount(bodyIR))
            if resultOffset < 0:
                return -1
            let resultAddressWords = PrimaryBodyIrStackAddressWordCount(
                PrimaryBodyIrCheckedStackOffsetAdd(resultOffset,
                                                   PrimaryCallOpStackArgBytes(call)))
            if resultAddressWords <= 0:
                return -1
            offset = offset + resultAddressWords
    return offset

@borrows
fn PrimaryBodyIRCallWordCount(bodyIR: coreir.BodyIR,
                               op: coreir.BodyOp): int32 =
    let blOffset = PrimaryBodyIRCallBlRelOffset(bodyIR, op)
    if blOffset < 0:
        return 0
    let call = bodyIR.callSequence[op.operands[0]]
    let inlineAtomicKind = PrimaryCallOpInlineAtomicFetchAddKind(call)
    let inlinePtrSlotKind = PrimaryCallOpInlinePtrSlotKind(call)
    let inlineAesBlockKind = PrimaryCallOpInlineAesBlockKind(call)
    let inlineSha256BlockKind = PrimaryCallOpInlineSha256BlockKind(call)
    let inlineF64FromIntKind = PrimaryCallOpInlineF64FromIntKind(call, bodyIR)
    var callWordCount = 1
    if inlineAtomicKind > 0:
        callWordCount = PrimaryInlineAtomicFetchAddInstructionWordCount(inlineAtomicKind)
    elif inlinePtrSlotKind > 0:
        callWordCount = PrimaryInlinePtrSlotInstructionWordCount(inlinePtrSlotKind)
    elif inlineAesBlockKind > 0:
        callWordCount = PrimaryInlineAesBlockInstructionWordCount(inlineAesBlockKind)
    elif inlineSha256BlockKind > 0:
        callWordCount = PrimaryInlineSha256BlockInstructionWordCount(inlineSha256BlockKind)
    elif inlineF64FromIntKind > 0:
        # Current: the only inline kind here whose word count (2) differs from the
        # default 1 a plain `bl` predicts -- PrimaryInlineF64TruncKind (#68)
        # stays exactly 1 so it never needed this branch; this one must.
        callWordCount = PrimaryInlineF64FromIntInstructionWordCount(inlineF64FromIntKind)
    if callWordCount <= 0:
        return 0
    var count = blOffset + callWordCount
    if PrimaryCallOpStackArgBytes(call) > 0:
        count = count + PrimaryBodyIrStackAdjustWordCount(
            PrimaryCallOpStackArgBytes(call))
    if inlineAtomicKind <= 0 && inlinePtrSlotKind <= 0 && inlineAesBlockKind <= 0 &&
       inlineSha256BlockKind <= 0 && inlineF64FromIntKind <= 0 &&
       PrimaryBodyIRCallResultIsF64Scalar(bodyIR, call):
        # #76: mirror the fill's extra `fmov x0,d0` word emitted for a real
        # (non-inline) call whose result is f64 -- see PrimaryBodyIRFillCallOp.
        count = count + 1
    if PrimaryBodyIRCallStoresScalarResult(bodyIR, call):
        # The scalar result (X0) is stored home via PrimaryBodyIRStoreRegToSlot,
        # whose word count is ceiling-aware: at large frames the result slot
        # overflows the STR scaled-imm ceiling and the fill materializes the slot
        # address first. Mirror that exact store width instead of a hardcoded +1.
        count = count + PrimaryBodyIrStoreSlotWordCount(bodyIR, call.resultSlot)
    return count

@borrows
fn PrimaryBodyIROpSizeAtRaw(bodyIR: coreir.BodyIR,
                             opIndex: int32): int32 =
    if opIndex < 0 || opIndex >= bodyIR.ops.len:
        return 0
    let op = bodyIR.ops[opIndex]
    if op.kind == coreir.BodyOpInvalidTag:
        return 0
    if op.kind == coreir.BodyOpCallTag:
        return PrimaryBodyIRCallWordCount(bodyIR, op)
    if op.kind == coreir.BodyOpReturnTag:
        return 1
    if op.kind == coreir.BodyOpLoadConstTag:
        if op.operands.len >= 2:
            if op.operands[0] == coreir.LocalI32Tag ||
               op.operands[0] == coreir.LocalI64Tag ||
               op.operands[0] == coreir.LocalF64Tag ||
               op.operands[0] == coreir.LocalPtrTag:
                # The mov sequence loads the literal into X9, then stores it home via
                # PrimaryBodyIRStoreRegToSlot. That store is CEILING-AWARE: at large
                # frames the target slot overflows the STR
                # scaled-imm ceiling and the fill first materializes the slot address
                # (PrimaryBodyIRFillStackAddressToReg → several add words) before the
                # str. PrimaryBodyIrStoreSlotWordCount mirrors that exact width-8 store
                # at every offset; a hardcoded `+1` under-counts past 32760 and desyncs
                # the two passes (block-start drift → buffer_size_desync).
                return PrimaryLoadConstMovWordCount(op) +
                       PrimaryBodyIrStoreSlotWordCount(bodyIR, op.target)
        return 0
    if op.kind == coreir.BodyOpCopyLocalTag ||
       op.kind == coreir.BodyOpStoreLocalTag:
        if op.operands.len < 1 || op.target < 0 || op.target >= bodyIR.localSlots.len ||
           op.operands[0] < 0 || op.operands[0] >= bodyIR.localSlots.len:
            return 0
        let wcCopySrcElideLen: int32 = bodyIR.layoutCopySrcElide.len
        let copyWords = PrimaryBodyIRCopySlotWordCount(bodyIR, op.operands[0], op.target)
        if opIndex >= 0 && opIndex < wcCopySrcElideLen && bodyIR.layoutCopySrcElide[opIndex]:
            # Stage-1 peephole: plain I64->I64 copy whose source is already X9-resident; the
            # source `ldr x9,[src]` is dropped in the filler. Mirror that by subtracting the
            # source load word count so the two passes agree. (CopySrcElide is gated to plain
            # I64->I64 in PrimaryBodyIrCopySrcElidableAt, so the load is exactly an 8-byte ldr.)
            let copySrcOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                             op.operands[0],
                                                             PrimaryBodyIrFrameBytes(bodyIR),
                                                             PrimaryBodyIrParamSaveOffset(bodyIR),
                                                             PrimaryBodyIrParamSaveCount(bodyIR))
            if copySrcOffset < 0:
                return 0
            return copyWords - PrimaryBodyIrStackAccessWordCount(copySrcOffset, 8)
        return copyWords
    if op.kind == coreir.BodyOpResultProjectTag:
        if op.operands.len < 2:
            return 0
        if op.operands[0] == coreir.BodyResultProjectIsErrTag ||
           op.operands[0] == coreir.BodyResultProjectIsOkTag:
            return PrimaryBodyIRResultProjectIsErrWordCount(bodyIR, op)
        if op.operands[0] == coreir.BodyResultProjectValueStrTag ||
           op.operands[0] == coreir.BodyResultProjectErrorStrTag ||
           op.operands[0] == coreir.BodyResultProjectErrInfoTag:
            return PrimaryBodyIRResultProjectCopyWordCount(bodyIR, op)
        return 0
    if op.kind == coreir.BodyOpResultPanicGuardTag:
        # F14b: prefix (optional cond-slot materialize + ldr + cbnz) + the
        # embedded call's own word count. Prefix is NOT a flat 2: at large
        # frames FillResultPanicGuardOp materializes the cond slot first
        # (FieldAccessNeedsAddressReg). Mirror via ResultPanicGuardPrefixWordCount
        # (same helper as reloc BL cursor). No skip-label word (labels cost nothing).
        if op.operands.len != 2:
            return 0
        let panicPrefixWords = PrimaryBodyIRResultPanicGuardPrefixWordCount(bodyIR, op.operands[0])
        if panicPrefixWords <= 0:
            return 0
        var panicGuardCallOp: coreir.BodyOp
        panicGuardCallOp.kind = coreir.BodyOpCallTag
        add(panicGuardCallOp.operands, op.operands[1])
        let panicGuardCallWords = PrimaryBodyIRCallWordCount(bodyIR, panicGuardCallOp)
        if panicGuardCallWords <= 0:
            return 0
        return panicPrefixWords + panicGuardCallWords
    if op.kind == coreir.BodyOpBinOpTag:
        if op.operands.len < 4:
            return 0
        # operand loads mirror the fill: scalar slots are 1 word, aggregate
        # slots materialize their stack address (1-2 words)
        let binLhsWords = PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[2])
        let binRhsWords = PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[3])
        let binStoreWords = PrimaryBodyIrStoreSlotWordCount(bodyIR, op.target)
        if binLhsWords <= 0 || binRhsWords <= 0 || binStoreWords <= 0:
            return 0
        if op.operands[1] == int32(texpr.TypedExprIrOpI32Madd):
            if op.operands.len < 5:
                return 0
            let binAccWords = PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[4])
            if binAccWords <= 0:
                return 0
            return binLhsWords + binRhsWords + binAccWords + 1 + binStoreWords
        var binLhsAccum = binLhsWords
        # form60: hoist .len before three-way conj with [opIndex]
        let binLhsElideLen: int32 = bodyIR.layoutLhsElide.len
        let binStoreElideLen: int32 = bodyIR.layoutStoreElide.len
        if opIndex >= 0 && opIndex < binLhsElideLen && bodyIR.layoutLhsElide[opIndex]:
            # Stage-0 peephole: lhs already resident in X9 from the prior op's store to the
            # same slot; its reload is elided in the filler, so drop its load words here to
            # keep the size predictor and filler in lockstep.
            binLhsAccum = 0
        var binStoreAccum = binStoreWords
        let binStoreElided = opIndex >= 0 && opIndex < binStoreElideLen && bodyIR.layoutStoreElide[opIndex]
        if binStoreElided:
            # Stage-1 peephole: target is a single-use temp consumed straight from X9 by the
            # next op, so its store to memory is dead and dropped in the filler — mirror that
            # here so the two-pass word counts stay in lockstep.
            binStoreAccum = 0
        var binCoreWords: int32 = 1
        if op.operands[0] == coreir.LocalF64Tag:
            # F64 BinOp fill emits fmov(lhs bits) + fmov(rhs bits) + fop + fmov(result bits).
            binCoreWords = 4
        return binLhsAccum + binRhsWords + binCoreWords + binStoreAccum
    if op.kind == coreir.BodyOpCmpTag:
        if op.operands.len < 3:
            return 0
        # The fill (PrimaryBodyIRFillCmpOp) loads each operand via
        # PrimaryBodyIRLoadSlotToReg and stores the bool result via
        # PrimaryBodyIRStoreRegToSlot. At large frames those slot offsets
        # overflow the LDR/STR scaled-immediate ceiling and the fill first
        # materializes the slot address into a register (several add words),
        # so the per-side count is NOT a fixed 1. Mirror each side exactly:
        #  - lhs/rhs: PrimaryBodyIrLoadSlotWordCount (== LoadSlotToReg words).
        #  - cmp: 1 word.
        #  - fused (Cmp->Cbr): no cset/store, the Cbr consumes the flags.
        #  - unfused: cset (1) + PrimaryBodyIrStoreSlotWordCount(target)
        #    (== StoreRegToSlot words). A hardcoded 5/3 under-counts past the
        #    immediate ceiling and desyncs the two passes (block-start drift).
        let cmpSizeLhsType = PrimaryBodyIrSlotType(bodyIR, op.operands[1])
        let cmpSizeRhsType = PrimaryBodyIrSlotType(bodyIR, op.operands[2])
        var cmpCoreWords: int32 = 1
        if cmpSizeLhsType == coreir.LocalF64Tag || cmpSizeRhsType == coreir.LocalF64Tag:
            if cmpSizeLhsType != coreir.LocalF64Tag || cmpSizeRhsType != coreir.LocalF64Tag:
                return 0
            cmpCoreWords = 3
        var cmpWords: int32 = cmpCoreWords
        cmpWords = cmpWords + PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[1])
        cmpWords = cmpWords + PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[2])
        # form60: hoist .len before three-way conj
        let layoutCmpFuseLen_f60: int32 = bodyIR.layoutCmpFuse.len
        if opIndex >= 0 && opIndex < layoutCmpFuseLen_f60 && bodyIR.layoutCmpFuse[opIndex] >= 0:
            return cmpWords
        return cmpWords + 1 + PrimaryBodyIrStoreSlotWordCount(bodyIR, op.target)
    if op.kind == coreir.BodyOpStrEqLiteralTag:
        return PrimaryBodyIRStrEqLiteralWordCount(bodyIR, op)
    if op.kind == coreir.BodyOpGlobalLoadTag ||
       op.kind == coreir.BodyOpGlobalStoreTag:
        if op.operands.len < 1 ||
           op.operands[0] < 0 ||
           op.operands[0] >= bodyIR.localSlots.len:
            return 0
        if op.target < 0 || op.target >= bodyIR.localSlots.len:
            return 0
        if op.kind == coreir.BodyOpGlobalLoadTag &&
           op.operands.len >= 2 &&
           op.operands[1] == 1:
            if bodyIR.localSlots[op.target].typeKind != coreir.LocalPtrTag:
                return 0
            return 2 + PrimaryBodyIrStoreSlotWordCount(bodyIR, op.target)
        let globalType = bodyIR.localSlots[op.operands[0]].typeKind
        if globalType != coreir.LocalI32Tag &&
           globalType != coreir.LocalI64Tag &&
           globalType != coreir.LocalPtrTag &&
           globalType != coreir.LocalStrTag &&
           globalType != coreir.LocalAggregateTag:
            return 0
        if bodyIR.localSlots[op.target].typeKind != globalType:
            return 0
        # str and aggregate global stores share one fill shape: adrp+add (2) +
        # value-address load (LoadSlotWordCount) + per-byte memcpy. Keep both
        # global-store store ops on this exact formula so layout == emission.
        if globalType == coreir.LocalStrTag ||
           globalType == coreir.LocalAggregateTag:
            let byteCount = PrimaryLocalSlotSizeOf(bodyIR.localSlots[op.operands[0]])
            if byteCount <= 0:
                return 0
            if globalType == coreir.LocalAggregateTag &&
               PrimaryLocalSlotSizeOf(bodyIR.localSlots[op.target]) != byteCount:
                return 0
            return 2 +
                   PrimaryBodyIrLoadSlotWordCount(bodyIR, op.target) +
                   PrimaryBodyIRCopyMemoryWordCount(byteCount)
        # Scalar (i32/i64/ptr) global load/store. Both fills materialize the global
        # data address (adrp+add = 2) plus one ldr/str against the global (1). The
        # OTHER side touches the LOCAL slot and is CEILING-AWARE: GlobalStore reads the
        # value via PrimaryBodyIRLoadSlotToReg, GlobalLoad writes it via
        # PrimaryBodyIRStoreRegToSlot — at large frames (the value/dest slot, e.g. a
        # register param saved past the STR/LDR scaled-imm ceiling) those first
        # materialize the slot address into a register (extra add words). A hardcoded 4
        # under-counts past 32760 and desyncs the two passes (buffer_size_desync).
        # Mirror each fill's ceiling-aware side exactly (== the proven LoadConst/BinOp
        # mirror pairs). For small frames the slot access is 1 word, so this equals the
        # old 4 and the driver fixed point is unchanged; only large-frame functions
        # (which the old path mispredicted) change.
        if op.kind == coreir.BodyOpGlobalStoreTag:
            return 3 + PrimaryBodyIrLoadSlotWordCount(bodyIR, op.target)
        return 3 + PrimaryBodyIrStoreSlotWordCount(bodyIR, op.target)
    if op.kind == coreir.BodyOpIndexedLoadTag ||
       op.kind == coreir.BodyOpIndexedStoreTag:
        if op.operands.len < 2:
            return 0
        if op.operands.len >= 4 &&
           op.operands[0] >= 0 &&
           op.operands[0] < bodyIR.localSlots.len &&
           (bodyIR.localSlots[op.operands[0]].typeKind == coreir.LocalAggregateTag ||
            (bodyIR.localSlots[op.operands[0]].typeKind == coreir.LocalPtrTag &&
             op.operands.len >= 5 && op.operands[4] == 1)):
            let elemSize = op.operands[3]
            let scaleWords = PrimaryBodyIrIndexedScaleWordCount(elemSize)
            if scaleWords <= 0:
                return 0
            var baseWords = PrimaryBodyIrLoadSlotWordCount(
                bodyIR, op.operands[0])
            if bodyIR.localSlots[op.operands[0]].placeKind ==
               coreir.BodyPlaceGlobalAddressTag:
                baseWords = 2
            if op.operands.len >= 5 && op.operands[4] == 1:
                baseWords = baseWords + 1
            let indexWords = PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[2])
            if op.kind == coreir.BodyOpIndexedLoadTag:
                if elemSize == 16:
                    let valueType = PrimaryBodyIrSlotType(bodyIR, op.operands[1])
                    if valueType == coreir.LocalAggregateTag:
                        return baseWords + indexWords + scaleWords + PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[1]) + 4
                    return 0
                if elemSize == 24:
                    return baseWords + indexWords + scaleWords + PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[1]) + 6
                # General aggregate element load (`xs[i]` reads N-byte struct by
                # value): addr materialization + (elemSize/8) * 2 ldr/str chunk
                # loop. Mirrors the IndexedStore general aggregate sizer below and
                # the emit branch in PrimaryBodyIRFillBlockOp. Covers any struct
                # element whose size is a multiple of 8 (e.g. anon-tuple 64B); the
                # 16/24 fast paths stay specialized above.
                if PrimaryBodyIrSlotType(bodyIR, op.operands[1]) == coreir.LocalAggregateTag:
                    if elemSize > 0 && (elemSize % 8) == 0:
                        return baseWords + indexWords + scaleWords + PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[1]) + (elemSize / 8) * 2
                    return 0
                return baseWords + indexWords + scaleWords + 1 + PrimaryBodyIrStoreSlotWordCount(bodyIR, op.operands[1])
            if elemSize == 16:
                let valueType = PrimaryBodyIrSlotType(bodyIR, op.operands[1])
                if valueType == coreir.LocalAggregateTag:
                    return baseWords + indexWords + scaleWords + PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[1]) + 4
                return 0
            if elemSize == 24:
                let valueType = PrimaryBodyIrSlotType(bodyIR, op.operands[1])
                if valueType == coreir.LocalPtrTag:
                    return baseWords + indexWords + scaleWords + PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[1]) + 3
                if valueType == coreir.LocalStrTag || valueType == coreir.LocalAggregateTag:
                    return baseWords + indexWords + scaleWords + PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[1]) + 6
                return 0
            # General aggregate element store: addr-load + 2 words (LDR+STR) per
            # 8-byte chunk; mirrors the emit branch above.
            let storeValueType = PrimaryBodyIrSlotType(bodyIR, op.operands[1])
            if storeValueType == coreir.LocalAggregateTag && (elemSize % 8) == 0:
                return baseWords + indexWords + scaleWords + PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[1]) + (elemSize / 8) * 2
            return baseWords + indexWords + scaleWords + PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[1]) + 1
        # Scalar (non-aggregate) ptr/index access fallback. The base address and
        # the value/result slots are loaded/stored via the ceiling-aware
        # PrimaryBodyIRLoadSlotToReg / PrimaryBodyIRStoreRegToSlot, so at large
        # frames a slot past the scaled-imm ceiling materializes its address
        # first (several add words). The old flat `return 3` (load1+ldr1+store1)
        # under-counts those, desyncing the two passes.
        if op.operands[0] < 0 || op.operands[0] >= bodyIR.localSlots.len ||
           op.operands[1] < 0 || op.operands[1] >= bodyIR.localSlots.len:
            return 0
        var indexedBaseWords = PrimaryBodyIrLoadSlotWordCount(
            bodyIR, op.operands[0])
        if bodyIR.localSlots[op.operands[0]].placeKind ==
           coreir.BodyPlaceGlobalAddressTag:
            indexedBaseWords = 2
        if op.kind == coreir.BodyOpIndexedLoadTag:
            # emit: LoadSlotToReg(op0 base) + 1 ldr + StoreRegToSlot(op1 result)
            return indexedBaseWords +
                   1 +
                   PrimaryBodyIrStoreSlotWordCount(bodyIR, op.operands[1])
        # IndexedStore: LoadSlotToReg(op0 base) + LoadSlotToReg(op1 value) + 1 str
        return indexedBaseWords +
               PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[1]) +
               1
    if op.kind == coreir.BodyOpFieldLoadTag ||
       op.kind == coreir.BodyOpFieldStoreTag:
        if op.operands.len < 3:
            return 0
        let baseSlot = op.operands[0]
        let valueSlot = op.operands[1]
        let byteOffset = op.operands[2]
        var byteCount = 0
        if op.operands.len >= 4:
            byteCount = op.operands[3]
        if baseSlot < 0 || baseSlot >= bodyIR.localSlots.len ||
           valueSlot < 0 || valueSlot >= bodyIR.localSlots.len ||
           byteOffset < 0:
            return 0
        if byteCount <= 0:
            byteCount = 8
        let slotSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot])
        if slotSize > 0 && slotSize < byteCount:
            return 0
        if op.kind == coreir.BodyOpFieldLoadTag && op.target != valueSlot:
            return 0
        if op.kind == coreir.BodyOpFieldStoreTag && op.target != baseSlot:
            return 0
        let frameBytes = PrimaryBodyIrFrameBytes(bodyIR)
        let paramSaveOffset = PrimaryBodyIrParamSaveOffset(bodyIR)
        let paramSaveCount = PrimaryBodyIrParamSaveCount(bodyIR)
        var accessOffset = byteOffset
        var count: int32
        var baseDirectSp = false
        if bodyIR.localSlots[baseSlot].placeKind ==
           coreir.BodyPlaceGlobalAddressTag:
            let baseSize = PrimaryLocalSlotSizeOf(
                bodyIR.localSlots[baseSlot])
            if baseSize > 0 && byteOffset > baseSize - byteCount:
                return 0
            count = 2
            if PrimaryBodyIrFieldAccessNeedsAddressReg(
                   accessOffset, byteCount) ||
               PrimaryBodyIrCopySideNeedsAddressReg(
                   accessOffset, byteCount):
                count = count +
                        PrimaryBodyIrStackAddressWordCount(accessOffset)
                accessOffset = 0
        elif op.kind == coreir.BodyOpFieldLoadTag &&
           bodyIR.localSlots[baseSlot].typeKind == coreir.LocalStrTag:
            count = count + PrimaryBodyIrLoadSlotWordCount(bodyIR, baseSlot)
        elif bodyIR.localSlots[baseSlot].typeKind == coreir.LocalPtrTag ||
             (bodyIR.localSlots[baseSlot].typeKind == coreir.LocalAggregateTag &&
              PrimaryBodyIrLocalIsParam(bodyIR.localSlots[baseSlot])):
            # The filler loads the base pointer via PrimaryBodyIRLoadSlotToReg
            # (Ptr/Aggregate-param → LoadStackOffsetToReg width 8). At large
            # frames the param-save slot overflows the 8-byte STR/LDR scaled-imm
            # ceiling (32760) and the fill first materializes the slot address
            # into a register (PrimaryBodyIRFillStackAddressToReg → several add
            # words) before the ldr. PrimaryBodyIrLoadSlotWordCount mirrors that
            # exact width-8 stack access, so it equals the fill's emitted words
            # at every offset; a hardcoded `+1` under-counts past 32760 and
            # desyncs the two passes (block-start drift → plan not ready).
            count = count + PrimaryBodyIrLoadSlotWordCount(bodyIR, baseSlot)
        elif (bodyIR.localSlots[baseSlot].typeKind == coreir.LocalStrTag ||
              bodyIR.localSlots[baseSlot].typeKind == coreir.LocalAggregateTag) &&
             PrimaryBodyIrLocalIsParam(bodyIR.localSlots[baseSlot]):
            # aggregate/str param slot holds the incoming address: indirect.
            count = count + 1
        else:
            let baseOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                           baseSlot,
                                                           frameBytes,
                                                           paramSaveOffset,
                                                           paramSaveCount)
            if baseOffset < 0:
                accessOffset = byteOffset
                count = count + 1
            else:
                let baseSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[baseSlot])
                if baseSize > 0 && byteOffset > baseSize - byteCount:
                    return 0
                accessOffset = baseOffset + byteOffset
                baseDirectSp = true
                # mirrors the fill: big base offsets are materialized into a
                # register, after which the field is accessed at offset 0
                if PrimaryBodyIrFieldAccessNeedsAddressReg(accessOffset, byteCount):
                    count = count + PrimaryBodyIrStackAddressWordCount(accessOffset)
                    accessOffset = 0
                    baseDirectSp = false
        # Mirror of the fill's register-base fold: the Ptr/aggregate-param/str
        # base branches above address the field through a register, not SP
        # (baseDirectSp stays false), so the baseDirectSp-gated byte-imm
        # ceiling guard above never fires for them. Count the same fold words
        # the fill now emits before dispatching on byteCount below.
        if !baseDirectSp &&
           PrimaryBodyIrCopySideNeedsAddressReg(accessOffset, byteCount):
            count = count + PrimaryBodyIrStackAddressWordCount(accessOffset)
            accessOffset = 0
        var valueOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                        valueSlot,
                                                        frameBytes,
                                                        paramSaveOffset,
                                                        paramSaveCount)
        if valueOffset < 0:
            return count + PrimaryBodyIRCopyMemoryWordCount(byteCount)
        # The value-slot side gets the same scaled-imm ceiling guard as the
        # base/field side: FieldLoad materializes its STR target, FieldStore its
        # LDR source — both keyed on valueOffset via FieldAccessNeedsAddressReg,
        # into a register (X13) so the access runs at offset 0. Past the ceiling
        # the raw encoder returns Err whose zero-value is written as a 0x0 word,
        # so both passes must add the address-materialization words here.
        var valueInReg = false
        if (op.kind == coreir.BodyOpFieldLoadTag ||
            op.kind == coreir.BodyOpFieldStoreTag) &&
           PrimaryBodyIrFieldAccessNeedsAddressReg(valueOffset, byteCount):
            count = count + PrimaryBodyIrStackAddressWordCount(valueOffset)
            valueOffset = 0
            valueInReg = true
        if byteCount % 8 == 0 &&
           accessOffset % 8 == 0 &&
           valueOffset % 8 == 0:
            if byteCount > 32760:
                # Mirrors PrimaryBodyIRFillFieldLoad/PrimaryBodyIRFillFieldStore's
                # windowed slow path (both fills are windowed identically, so
                # this extra math applies to both FieldLoadTag and
                # FieldStoreTag): the byte-loop word count is unchanged
                # (byteCount/8*2 LDR+STR words total regardless of how many
                # 32760-byte windows it's split across), plus one
                # PrimaryBodyIRFillRegAddImmToReg fold per side at every window
                # boundary. Each fold advances by exactly 32760 bytes, which
                # itself chunks into exactly 8 ADD-immediate words (32760 ==
                # 8*4095, no remainder) — mirrored inline here as a literal
                # rather than through the ambiguous/duplicated
                # PrimaryBodyIrStackAddressWordCount helper name.
                let numChunks8 = (byteCount + 32759) / 32760
                let foldWordsPerSide8: int32 = 8
                return count + (byteCount / 8) * 2 + (numChunks8 - 1) * foldWordsPerSide8 * 2
            return count + (byteCount / 8) * 2
        if byteCount % 4 == 0 &&
           accessOffset % 4 == 0 &&
           valueOffset % 4 == 0:
            return count + (byteCount / 4) * 2
        # mirrors the fill's CopyMemory fallback: each side past the byte-imm
        # range gets its address materialized first
        if baseDirectSp &&
           PrimaryBodyIrCopySideNeedsAddressReg(accessOffset, byteCount):
            count = count + PrimaryBodyIrStackAddressWordCount(accessOffset)
        if !valueInReg &&
           PrimaryBodyIrCopySideNeedsAddressReg(valueOffset, byteCount):
            count = count + PrimaryBodyIrStackAddressWordCount(valueOffset)
        return count + PrimaryBodyIRCopyMemoryWordCount(byteCount)
    if op.kind == coreir.BodyOpLoadLocalTag:
        if op.operands.len == 4 &&
           op.operands[0] ==
               coreir.BodyLoadLocalFieldAddressTag:
            let rootSlot = op.operands[1]
            let fieldOffset = op.operands[2]
            let fieldWidth = op.operands[3]
            if rootSlot < 0 || rootSlot >= bodyIR.localSlots.len ||
               fieldOffset < 0 || fieldWidth <= 0 ||
               op.target < 0 || op.target >= bodyIR.localSlots.len ||
               bodyIR.localSlots[op.target].typeKind !=
                   coreir.LocalPtrTag ||
               bodyIR.localSlots[op.target].placeKind !=
                   coreir.BodyPlaceBorrowAddressTag:
                return 0
            var rootWords: int32
            if bodyIR.localSlots[rootSlot].placeKind ==
                   coreir.BodyPlaceGlobalAddressTag:
                rootWords = 2
            elif bodyIR.localSlots[rootSlot].typeKind ==
                     coreir.LocalPtrTag ||
                 PrimaryBodyIrSlotIsIndirectAggregateParam(
                     bodyIR, rootSlot):
                rootWords = PrimaryBodyIrLoadSlotWordCount(
                    bodyIR, rootSlot)
            else:
                let rootOffset = PrimaryBodyIrLocalStackOffset(
                    bodyIR, rootSlot,
                    PrimaryBodyIrFrameBytes(bodyIR),
                    PrimaryBodyIrParamSaveOffset(bodyIR),
                    PrimaryBodyIrParamSaveCount(bodyIR))
                if rootOffset < 0 ||
                   fieldOffset >
                       PrimaryLocalSlotSizeOf(
                           bodyIR.localSlots[rootSlot]) - fieldWidth:
                    return 0
                rootWords =
                    PrimaryBodyIrStackAddressWordCount(rootOffset)
            return rootWords +
                   PrimaryBodyIrStackAddressWordCount(fieldOffset) +
                   PrimaryBodyIrStoreSlotWordCount(bodyIR, op.target)
        if op.operands.len == 5 &&
           op.operands[0] ==
               coreir.BodyLoadLocalIndexedAddressTag:
            if op.operands[1] < 0 ||
               op.operands[1] >= bodyIR.localSlots.len ||
               op.operands[2] < 0 ||
               op.operands[2] >= bodyIR.localSlots.len ||
               op.operands[3] <= 0 ||
               (op.operands[4] != 0 && op.operands[4] != 1) ||
               op.target < 0 || op.target >= bodyIR.localSlots.len ||
               bodyIR.localSlots[op.target].typeKind !=
                   coreir.LocalPtrTag ||
               bodyIR.localSlots[op.target].placeKind !=
                   coreir.BodyPlaceBorrowAddressTag:
                return 0
            let scaleWords =
                PrimaryBodyIrIndexedScaleWordCount(op.operands[3])
            if scaleWords <= 0:
                return 0
            var baseWords = PrimaryBodyIrLoadSlotWordCount(
                bodyIR, op.operands[1])
            if bodyIR.localSlots[op.operands[1]].placeKind ==
                   coreir.BodyPlaceGlobalAddressTag:
                baseWords = 2
            if op.operands[4] == 1:
                baseWords = baseWords + 1
            return baseWords +
                   PrimaryBodyIrLoadSlotWordCount(
                       bodyIR, op.operands[2]) +
                   scaleWords +
                   PrimaryBodyIrStoreSlotWordCount(bodyIR, op.target)
        if op.operands.len >= 3 &&
           op.operands[0] == coreir.BodyLoadLocalStrIndexU8Tag:
            if op.operands[1] < 0 || op.operands[1] >= bodyIR.localSlots.len ||
               op.operands[2] < 0 || op.operands[2] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return 0
            # emit: LoadStrValueAddressToReg(op1 str) + LoadSlotToReg(op2 index)
            #       + 3 fixed words (ldr/add/ldrb) + StoreRegToSlot(target).
            # Mirror the str load with its exact word-count helper and the target
            # store with the ceiling-aware store count (the old `+4` hardcoded the
            # store as 1 word and under-counted a target slot past the ceiling).
            let sourceWords = PrimaryBodyIRLoadStrValueAddressWordCount(bodyIR, op.operands[1])
            let indexWords = PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[2])
            return sourceWords + indexWords + 3 +
                   PrimaryBodyIrStoreSlotWordCount(bodyIR, op.target)
        if op.operands.len >= 3 &&
           (op.operands[0] == coreir.BodyLoadLocalPtrDerefI32Tag ||
            op.operands[0] == coreir.BodyLoadLocalPtrDerefU8Tag ||
            op.operands[0] == coreir.BodyLoadLocalPtrDerefU64Tag):
            if op.operands.len < 2 ||
               op.operands[1] < 0 || op.operands[1] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return 0
            # emit: LoadSlotToReg(op1 ptr) + 1 ldr/ldrb + StoreRegToSlot(target).
            # Both slot accesses are ceiling-aware (large frames materialize the
            # slot address first), so mirror them instead of a flat `return 3`.
            return PrimaryBodyIrLoadSlotWordCount(bodyIR, op.operands[1]) +
                   1 +
                   PrimaryBodyIrStoreSlotWordCount(bodyIR, op.target)
        if op.operands.len >= 2 &&
           op.operands[0] == coreir.BodyLoadLocalAddressTag:
            # LEA: FillStackAddressToReg(source) + StoreRegToSlot(target ptr).
            if op.operands[1] < 0 || op.operands[1] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len ||
               bodyIR.localSlots[op.target].typeKind != coreir.LocalPtrTag:
                return 0
            let leaFrameBytes = PrimaryBodyIrFrameBytes(bodyIR)
            let leaParamSaveOffset = PrimaryBodyIrParamSaveOffset(bodyIR)
            let leaParamSaveCount = PrimaryBodyIrParamSaveCount(bodyIR)
            let leaStackOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                               op.operands[1],
                                                               leaFrameBytes,
                                                               leaParamSaveOffset,
                                                               leaParamSaveCount)
            if leaStackOffset < 0:
                return 0
            return PrimaryBodyIrStackAddressWordCount(leaStackOffset) +
                   PrimaryBodyIrStoreSlotWordCount(bodyIR, op.target)
        if op.operands.len >= 2 &&
           op.operands[0] == coreir.BodyLoadLocalCStringTag:
            # cstring literal address -> ptr slot: ADRP + ADD (2 words) then
            # store the address to the target slot (mirrors the GlobalLoad
            # data-address arm64 shape; reloc registered in the cstring pass).
            if op.operands[1] < 0 || op.operands[1] >= bodyIR.cstringLiterals.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len ||
               bodyIR.localSlots[op.target].typeKind != coreir.LocalPtrTag:
                return 0
            return 2 + PrimaryBodyIrStoreSlotWordCount(bodyIR, op.target)
        if op.operands.len >= 1:
            if op.operands[0] < 0 || op.operands[0] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return 0
            # General LoadLocal lowers to PrimaryBodyIRCopySlot (source slot -> target
            # slot). PrimaryBodyIRCopySlotWordCount is the offset-aware mirror of that
            # emit: every per-chunk ldr/str is ceiling-aware, so at large frames a
            # chunk whose stack offset overflows the scaled-imm ceiling materializes
            # its address first (extra add words). The old flat `(slotSize/8)*2`
            # ignored that and under-counted past the ceiling, desyncing the passes.
            return PrimaryBodyIRCopySlotWordCount(bodyIR, op.operands[0], op.target)
        return 0
    if op.kind == coreir.BodyOpBranchTag:
        if op.operands.len >= 3:
            let subKind = op.operands[0]
            let guardSlot = op.operands[1]
            if guardSlot < 0 || guardSlot >= bodyIR.localSlots.len:
                return 0
            let guardWords = PrimaryBodyIrLoadSlotWordCount(bodyIR, guardSlot)
            if guardWords <= 0:
                return 0
            let restoreCount = PrimaryBodyIrFrameRestoreWordCount(bodyIR)
            if subKind == coreir.BodyBranchIfLocalNilReturnI32ConstTag:
                return guardWords + 2 + restoreCount
            if subKind == coreir.BodyBranchIfLocalLeZeroReturnI32ConstTag ||
               subKind == coreir.BodyBranchIfLocalLeZeroReturnCallNoargTag:
                return guardWords + 3 + restoreCount
            if subKind == coreir.BodyBranchIfLocalLeZeroCallArg0ReturnI32ConstTag:
                if op.operands.len < 4:
                    return 0
                let arg0Slot = op.operands[2]
                if arg0Slot < 0 || arg0Slot >= bodyIR.localSlots.len:
                    return 0
                let argWords = PrimaryBodyIrLoadSlotWordCount(bodyIR, arg0Slot)
                if argWords <= 0:
                    return 0
                return guardWords + argWords + 4 + restoreCount
        return 0
    if op.kind == coreir.BodyOpStrEqTag:
        return PrimaryBodyIRStrEqWordCount(bodyIR, op)
    return 0

@borrows
fn PrimaryBodyIROpSize(op: coreir.BodyOp): int32 =
    if op.kind == coreir.BodyOpCallTag:
        return 5
    if op.kind == coreir.BodyOpReturnTag:
        return 1
    return 1

@borrows
fn PrimaryBodyIROpSizeAt(bodyIR: coreir.BodyIR,
                          opIndex: int32): int32 =
    return PrimaryBodyIROpSizeAtRaw(bodyIR, opIndex)

@borrows
fn PrimaryBodyIRTermSizeRaw(bodyIR: coreir.BodyIR, termIndex: int32): int32 =
    if termIndex < 0 || termIndex >= bodyIR.terms.len:
        return 0
    let kind = bodyIR.terms[termIndex].kind
    if kind == coreir.BodyTermCbrTag:
        let term = bodyIR.terms[termIndex]
        # Stage10 Cmp->Cbr fusion: a fused LocalNonZero Cbr drops the bool ldr + cmp#0; only the
        # `b.<cond>; b` pair remains (4 - 2 = 2). Mirrors PrimaryBodyIRFillBlockTerm's fused branch.
        # form60: hoist .len before three-way conj
        let layoutCbrFuseLen_f60: int32 = bodyIR.layoutCbrFuse.len
        if termIndex >= 0 && termIndex < layoutCbrFuseLen_f60 && bodyIR.layoutCbrFuse[termIndex] >= 0:
            return 2
        # The fill loads the condition operand(s) via PrimaryBodyIRLoadSlotToReg
        # then emits cmp + b.cond + b (3 words). At large frames the operand
        # slots overflow the LDR scaled-immediate ceiling and each load
        # materializes the slot address first, so the per-side count is NOT a
        # fixed 1. Mirror each load with PrimaryBodyIrLoadSlotWordCount (== the
        # fill's emitted words); a hardcoded 4/5 under-counts past the ceiling
        # and desyncs the block start (drift -> plan not ready).
        var cbrLhsSlot = term.lhsSlot
        if cbrLhsSlot < 0:
            cbrLhsSlot = term.resultSlot
        if PrimaryBodyCondIsF64(term.conditionKind):
            if term.rhsSlot < 0:
                return 0
            return PrimaryBodyIrLoadSlotWordCount(bodyIR, cbrLhsSlot) +
                   PrimaryBodyIrLoadSlotWordCount(bodyIR, term.rhsSlot) +
                   5
        var cbrWords = PrimaryBodyIrLoadSlotWordCount(bodyIR, cbrLhsSlot) + 3
        if term.rhsSlot >= 0:
            cbrWords = cbrWords + PrimaryBodyIrLoadSlotWordCount(bodyIR, term.rhsSlot)
        return cbrWords
    if kind == coreir.BodyTermBrTag:
        return 1
    if kind == coreir.BodyTermReturnTag:
        let term = bodyIR.terms[termIndex]
        let restoreCount = PrimaryBodyIrFrameRestoreWordCount(bodyIR)
        if term.resultSlot < 0 &&
           term.operands.len >= 1 &&
           term.operands[0] == coreir.LocalInvalidTag:
            return restoreCount
        if term.resultSlot >= 0 && term.resultSlot < bodyIR.localSlots.len:
            let resultType = bodyIR.localSlots[term.resultSlot].typeKind
            if resultType == coreir.LocalStrTag ||
               resultType == coreir.LocalAggregateTag:
                # ldr X8 + 拷贝对数×2（与 FillBlockTermReturn 同算法：精确字节数，
                # 8 对齐用 64 位字，否则 32 位字；无 3 字下限）。
                let retTermCopyPairs = PrimaryReturnSretCopyPairCount(PrimaryLocalSlotSizeOf(bodyIR.localSlots[term.resultSlot]))
                # 与 FillBlockTermReturn 同算法：returnBufferOffset(X8) + aggregate sourceOffset(X10)
                # + 非聚合 sourceOffset 走 PrimaryBodyIrStackAccessWordCount（大 frame >32760 时物化
                # 地址，flat 1 会与 fill desync block start）。aggregateParam X10 基址与非聚合物化
                # 源基址互斥（aggregate vs 非聚合）。
                let retSlot = term.resultSlot
                let aggParam = PrimaryBodyIrLocalIsParam(bodyIR.localSlots[retSlot])
                let retSourceOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                                     retSlot,
                                                                     PrimaryBodyIrFrameBytes(bodyIR),
                                                                     PrimaryBodyIrParamSaveOffset(bodyIR),
                                                                     PrimaryBodyIrParamSaveCount(bodyIR))
                let retReturnBufferOffset = PrimaryBodyIrReturnBufferSaveOffset(bodyIR)
                let retCopyBytes = PrimaryLocalSlotSizeOf(bodyIR.localSlots[retSlot])
                var retCopyStride = 4
                if PrimaryReturnSretCopyIs64(retCopyBytes):
                    retCopyStride = 8
                let retBufWords = PrimaryBodyIrStackAccessWordCount(retReturnBufferOffset, 8)
                var retBaseWords = 0
                if aggParam:
                    retBaseWords = PrimaryBodyIrStackAccessWordCount(retSourceOffset, 8)
                var nonAggMatWords = 0
                if !aggParam && retTermCopyPairs > 0 &&
                   !PrimaryBodyIrStackAccessImmFits(retSourceOffset + (retTermCopyPairs - 1) * retCopyStride,
                                                    retCopyStride):
                    nonAggMatWords = PrimaryBodyIrStackAddressWordCount(retSourceOffset)
                return retBufWords + retBaseWords + nonAggMatWords + retTermCopyPairs * 2 + restoreCount
            let loadWords = PrimaryBodyIrLoadSlotWordCount(bodyIR, term.resultSlot)
            if loadWords <= 0:
                return 0
            if resultType == coreir.LocalF64Tag:
                # extra fmov d0, x0 at the return fill
                return loadWords + 1 + restoreCount
            return loadWords + restoreCount
        # I32Const return 的常量物化字数与 FillBlockTermReturn 同公式:
        # 单指令形(movz 0..65535 / movn -65536..-1) 1 字; 其余全 32 位
        # (movz/movn + movk@16) 2 字。原恒 1 字与 2 字 fill desync。
        if term.resultSlot < 0 &&
           term.operands.len >= 2 &&
           term.operands[0] == PrimaryStatementReturnModeI32Const():
            let retConstSizeValue = term.operands[1]
            if retConstSizeValue > 65535 ||
               retConstSizeValue < 0 - 65536:
                return 2 + restoreCount
        return 1 + restoreCount
    return 0

@borrows
fn PrimaryBodyIRTermSize(bodyIR: coreir.BodyIR, termIndex: int32): int32 =
    return PrimaryBodyIRTermSizeRaw(bodyIR, termIndex)

# Phase 2.5 (data reloc emit-first): does op[opIndex] anchor a data relocation whose ADRP
# is the op's FIRST emitted word (so its real word position == the op's real fill offset)?
# The covered kinds are (a) a cstring-literal address load (LoadLocal + CStringTag),
# (b) StrEqLiteral's compact literal-address loop, and (c) a global load/store whose slot
# resolves to a global-address place. These match the
# exact predictor conditions in PrimaryBodyIrAppendCStringArgRelocs (the bare-cstring and
# StrEqLiteral cases)
# and PrimaryBodyIrAppendGlobalOpRelocs, so the per-op layout offset recorded here is the
# same predicted absolute the predictor appends to dataRelocWordOffsets. Returns false for
# call-cstring-arg and sret-global relocs (those ADRPs are NOT at the op's first word and are
# left on the predictor path — reported in remaining).
@borrows
fn PrimaryBodyIrOpHasDataReloc(bodyIR: coreir.BodyIR, opIndex: int32): bool =
    if opIndex < 0 || opIndex >= bodyIR.ops.len:
        return false
    let op = bodyIR.ops[opIndex]
    if op.kind == coreir.BodyOpLoadLocalTag &&
       op.operands.len >= 2 &&
       op.operands[0] == coreir.BodyLoadLocalCStringTag:
        let loadLiteralId = op.operands[1]
        if loadLiteralId >= 0 && loadLiteralId < bodyIR.cstringLiterals.len:
            return true
        return false
    if op.kind == coreir.BodyOpStrEqLiteralTag && op.operands.len >= 2:
        let compareLiteralId = op.operands[1]
        return compareLiteralId >= 0 && compareLiteralId < bodyIR.cstringLiterals.len
    if op.kind == coreir.BodyOpLoadLocalTag &&
       ((op.operands.len == 5 &&
         op.operands[0] == coreir.BodyLoadLocalIndexedAddressTag) ||
        (op.operands.len == 4 &&
         op.operands[0] == coreir.BodyLoadLocalFieldAddressTag)):
        let rootSlot = op.operands[1]
        return rootSlot >= 0 &&
               rootSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[rootSlot].placeKind ==
                   coreir.BodyPlaceGlobalAddressTag
    if op.operands.len > 0 &&
       (op.kind == coreir.BodyOpGlobalLoadTag ||
        op.kind == coreir.BodyOpGlobalStoreTag):
        let argSlot = op.operands[0]
        if argSlot >= 0 &&
           argSlot < bodyIR.localSlots.len &&
           bodyIR.localSlots[argSlot].placeKind == coreir.BodyPlaceGlobalAddressTag:
            return true
    return false

# Stage-0 register peephole decision (single source of truth, read by BOTH the size
# predictor PrimaryBodyIROpSizeAtRaw and the filler PrimaryBodyIRFillBinOp so the two
# passes can never disagree on word counts). True iff op[opIndex] is a scalar-I64 BinOp
# (non-Madd) whose lhs operand slot equals the target slot of the immediately preceding
# op[opIndex-1], which is itself a BinOp — a producer that leaves its result in X9 and
# stores it to that slot. The producer's store and this consumer's lhs load address the
# SAME full-width I64 slot with X9 untouched between them, so X9 already holds exactly
# what the lhs load would produce; that load is redundant and safely elided. Guards:
#  - opIndex > blockOpStart: never elide at a block entry (a branch target whose
#    predecessor need not have left the value in X9).
#  - I64 slot only: full-width str/ldr, no truncation/extension, so the elision is exact.
@borrows
fn PrimaryBodyIrLhsReloadElidableAt(bodyIR: coreir.BodyIR, blockOpStart: int32, opIndex: int32): bool =
    if opIndex <= blockOpStart:
        return false
    if opIndex <= 0 || opIndex >= bodyIR.ops.len:
        return false
    let op = bodyIR.ops[opIndex]
    if op.kind != coreir.BodyOpBinOpTag || op.operands.len < 4:
        return false
    if op.operands[1] == int32(texpr.TypedExprIrOpI32Madd):
        return false
    let lhsSlot = op.operands[2]
    if lhsSlot < 0 || lhsSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryBodyIrSlotType(bodyIR, lhsSlot) != coreir.LocalI64Tag:
        return false
    let prev = bodyIR.ops[opIndex - 1]
    if prev.kind != coreir.BodyOpBinOpTag || prev.operands.len < 4:
        return false
    if prev.target != lhsSlot:
        return false
    return true

# Stage-1 store-elide support: body-wide per-slot READ count. Mirrors the optimizer's
# precise use model (BodyIrMarkOpUses positions) for op kinds whose operand layout is
# known, and conservatively counts EVERY valid-slot operand for op kinds it does not
# model — over-counting can only DISABLE an elision (never enable an unsafe one), so a
# missed read can never cause a dropped-but-live store. Terminator reads
# (lhsSlot/rhsSlot/resultSlot/operands) are likewise counted conservatively. Call args
# are read via the call sequence. Writes (op.target) are never counted as reads.
fn PrimaryBodyIrCountSlotRead(counts: var int32[], slot: int32) =
    if slot >= 0 && slot < counts.len:
        counts[slot] = counts[slot] + 1

@borrows
fn PrimaryBodyIrBuildSlotReadCounts(bodyIR: coreir.BodyIR): int32[] =
    var counts: int32[]
    for _ in 0..<bodyIR.localSlots.len:
        add(counts, 0)
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        if op.kind == coreir.BodyOpInvalidTag:
            continue
        if op.kind == coreir.BodyOpReturnTag:
            PrimaryBodyIrCountSlotRead(counts, op.target)
            continue
        if op.kind == coreir.BodyOpBranchTag:
            if op.operands.len >= 2:
                PrimaryBodyIrCountSlotRead(counts, op.operands[1])
            continue
        if op.kind == coreir.BodyOpCallTag:
            if op.operands.len > 0:
                let ordinal = op.operands[0]
                if ordinal >= 0 && ordinal < bodyIR.callSequence.len:
                    let callOp = bodyIR.callSequence[ordinal]
                    for ai in 0..<callOp.argSlots.len:
                        PrimaryBodyIrCountSlotRead(counts, callOp.argSlots[ai])
            continue
        if op.kind == coreir.BodyOpLoadLocalTag:
            if op.operands.len >= 3 &&
               (op.operands[0] == coreir.BodyLoadLocalPtrDerefI32Tag ||
                op.operands[0] == coreir.BodyLoadLocalPtrDerefU8Tag):
                PrimaryBodyIrCountSlotRead(counts, op.operands[1])
            elif op.operands.len >= 1:
                PrimaryBodyIrCountSlotRead(counts, op.operands[0])
            continue
        if op.kind == coreir.BodyOpStoreLocalTag ||
           op.kind == coreir.BodyOpCopyLocalTag:
            if op.operands.len >= 1:
                PrimaryBodyIrCountSlotRead(counts, op.operands[0])
            continue
        if op.kind == coreir.BodyOpBinOpTag:
            for bi in 2..<op.operands.len:
                PrimaryBodyIrCountSlotRead(counts, op.operands[bi])
            continue
        if op.kind == coreir.BodyOpCmpTag:
            for ci in 1..<op.operands.len:
                PrimaryBodyIrCountSlotRead(counts, op.operands[ci])
            continue
        # Unmodeled op kind: conservatively treat every valid-slot operand as a read.
        for ui in 0..<op.operands.len:
            PrimaryBodyIrCountSlotRead(counts, op.operands[ui])
    # Terminator reads (conservative): any term slot field / operand that is a valid slot.
    for termIndex in 0..<bodyIR.terms.len:
        let term = bodyIR.terms[termIndex]
        PrimaryBodyIrCountSlotRead(counts, term.lhsSlot)
        PrimaryBodyIrCountSlotRead(counts, term.rhsSlot)
        PrimaryBodyIrCountSlotRead(counts, term.resultSlot)
        for ti in 0..<term.operands.len:
            PrimaryBodyIrCountSlotRead(counts, term.operands[ti])
    return counts

# Stage-1 copy-source-elide decision: true iff op[opIndex] is a plain I64->I64
# CopyLocal/StoreLocal whose source is a single-use temp produced by op[opIndex-1] (a
# scalar-I64 BinOp, non-Madd) — so the value is already in X9 and the copy's source reload
# is redundant. The producer's store is separately dropped (store-elide); here we drop the
# consumer's load. Restricted to plain I64->I64 (no var-param pointee, no width change) so
# the copy is exactly `ldr x9,[src]; str x9,[dst]` and dropping the load is exact. Same
# block required (opIndex-1 must be in the same block as the X9-resident producer).
@borrows
fn PrimaryBodyIrCopySrcElidableAt(bodyIR: coreir.BodyIR,
                                   blockOpStart: int32,
                                   opIndex: int32,
                                   slotReadCounts: int32[]): bool =
    if opIndex <= blockOpStart:
        return false
    if opIndex <= 0 || opIndex >= bodyIR.ops.len:
        return false
    let op = bodyIR.ops[opIndex]
    if op.kind != coreir.BodyOpCopyLocalTag && op.kind != coreir.BodyOpStoreLocalTag:
        return false
    if op.operands.len < 1:
        return false
    let sourceSlot = op.operands[0]
    let targetSlot = op.target
    if sourceSlot < 0 || sourceSlot >= bodyIR.localSlots.len:
        return false
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        return false
    # plain I64->I64 only: exact `ldr x9,[src]; str x9,[dst]`, no pointee/width games
    if PrimaryBodyIrSlotType(bodyIR, sourceSlot) != coreir.LocalI64Tag:
        return false
    if PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalI64Tag:
        return false
    if PrimaryBodyIrVarParamPointeeKind(bodyIR, targetSlot) != coreir.LocalInvalidTag:
        return false
    # The copy filler chooses its load/store shape from slot size + offset alignment. Only the
    # 8-byte single-word path (slotSize==8, both offsets 8-aligned) emits exactly one source
    # `ldr x9,[src]`; any other path (e.g. 4-byte chunked) would make the size subtraction
    # wrong. Require that exact path so the dropped-load word count is unambiguous.
    if PrimaryLocalSlotSizeOf(bodyIR.localSlots[targetSlot]) != 8:
        return false
    let copyElideFrameBytes = PrimaryBodyIrFrameBytes(bodyIR)
    let copyElideParamSaveOffset = PrimaryBodyIrParamSaveOffset(bodyIR)
    let copyElideParamSaveCount = PrimaryBodyIrParamSaveCount(bodyIR)
    let copyElideSrcOffset = PrimaryBodyIrLocalStackOffset(bodyIR, sourceSlot, copyElideFrameBytes, copyElideParamSaveOffset, copyElideParamSaveCount)
    let copyElideTgtOffset = PrimaryBodyIrLocalStackOffset(bodyIR, targetSlot, copyElideFrameBytes, copyElideParamSaveOffset, copyElideParamSaveCount)
    if copyElideSrcOffset < 0 || copyElideTgtOffset < 0:
        return false
    if copyElideSrcOffset % 8 != 0 || copyElideTgtOffset % 8 != 0:
        return false
    # source is single-use and produced by the immediately preceding X9-resident BinOp
    if sourceSlot >= slotReadCounts.len || slotReadCounts[sourceSlot] != 1:
        return false
    let prev = bodyIR.ops[opIndex - 1]
    if prev.kind != coreir.BodyOpBinOpTag || prev.operands.len < 4:
        return false
    if prev.operands[1] == int32(texpr.TypedExprIrOpI32Madd):
        return false
    if prev.target != sourceSlot:
        return false
    return true

# Stage-1 store-elide decision (single source of truth, read by BOTH the size predictor
# and the filler). True iff op[opIndex] is a scalar-I64 BinOp (non-Madd) whose target is a
# single-use temp whose ONLY reader is op[opIndex+1], consuming the value straight out of X9
# via EITHER an lhs-elided BinOp (layoutLhsElide[opIndex+1]) OR a source-elided plain I64
# CopyLocal/StoreLocal (layoutCopySrcElide[opIndex+1]). Then op[opIndex]'s store writes a
# value nobody loads from memory ⇒ the store is dead and dropped. Requires opIndex+1 inside
# the same block. Both consumer flags are finalized before this is evaluated.
@borrows
fn PrimaryBodyIrStoreElidableAt(bodyIR: coreir.BodyIR,
                                 blockOpEnd: int32,
                                 opIndex: int32,
                                 slotReadCounts: int32[]): bool =
    if opIndex < 0 || opIndex + 1 >= bodyIR.ops.len:
        return false
    if opIndex + 1 >= blockOpEnd:
        return false
    let op = bodyIR.ops[opIndex]
    if op.kind != coreir.BodyOpBinOpTag || op.operands.len < 4:
        return false
    if op.operands[1] == int32(texpr.TypedExprIrOpI32Madd):
        return false
    let targetSlot = op.target
    if targetSlot < 0 || targetSlot >= bodyIR.localSlots.len:
        return false
    if PrimaryBodyIrSlotType(bodyIR, targetSlot) != coreir.LocalI64Tag:
        return false
    # single use: the target slot is read exactly once in the entire body
    if targetSlot >= slotReadCounts.len || slotReadCounts[targetSlot] != 1:
        return false
    let next = bodyIR.ops[opIndex + 1]
    # consumer (a): next op's lhs, consumed from X9 (lhs-elided BinOp)
    if opIndex + 1 < bodyIR.layoutLhsElide.len && bodyIR.layoutLhsElide[opIndex + 1]:
        if next.kind == coreir.BodyOpBinOpTag && next.operands.len >= 4 &&
           next.operands[2] == targetSlot:
            return true
    # consumer (b): next op's source, consumed from X9 (src-elided plain I64 copy)
    if opIndex + 1 < bodyIR.layoutCopySrcElide.len && bodyIR.layoutCopySrcElide[opIndex + 1]:
        if (next.kind == coreir.BodyOpCopyLocalTag || next.kind == coreir.BodyOpStoreLocalTag) &&
           next.operands.len >= 1 && next.operands[0] == targetSlot:
            return true
    return false

# Stage10 precise body-wide per-slot READ count. Same model as PrimaryBodyIrBuildSlotReadCounts
# EXCEPT LoadConst is modeled explicitly as zero genuine slot reads: its operands are a type tag
# (operands[0]) + literal value words (operands[1..]), NEVER slots, so the conservative counter's
# "unmodeled => count every operand" branch falsely attributes reads to whatever slot index the
# literal value collides with (e.g. a `LoadConst 10` falsely bumps slot 10). That false read makes
# a single-use bool look multi-use and silently disables fusion. Every OTHER op kind stays
# conservative (count all operands) — over-counting can only DISABLE fusion, never enable an unsafe
# one, so the single safe precision needed for fusion to fire is exactly the LoadConst case.
@borrows
fn PrimaryBodyIrBuildSlotPreciseReadCounts(bodyIR: coreir.BodyIR): int32[] =
    var counts: int32[]
    for _ in 0..<bodyIR.localSlots.len:
        add(counts, 0)
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        if op.kind == coreir.BodyOpInvalidTag:
            continue
        if op.kind == coreir.BodyOpLoadConstTag:
            # operands = [typeTag, literal-value-words...]; no slot reads.
            continue
        if op.kind == coreir.BodyOpReturnTag:
            PrimaryBodyIrCountSlotRead(counts, op.target)
            continue
        if op.kind == coreir.BodyOpBranchTag:
            if op.operands.len >= 2:
                PrimaryBodyIrCountSlotRead(counts, op.operands[1])
            continue
        if op.kind == coreir.BodyOpCallTag:
            if op.operands.len > 0:
                let ordinal = op.operands[0]
                if ordinal >= 0 && ordinal < bodyIR.callSequence.len:
                    let callOp = bodyIR.callSequence[ordinal]
                    for ai in 0..<callOp.argSlots.len:
                        PrimaryBodyIrCountSlotRead(counts, callOp.argSlots[ai])
            continue
        if op.kind == coreir.BodyOpLoadLocalTag:
            if op.operands.len >= 3 &&
               (op.operands[0] == coreir.BodyLoadLocalPtrDerefI32Tag ||
                op.operands[0] == coreir.BodyLoadLocalPtrDerefU8Tag):
                PrimaryBodyIrCountSlotRead(counts, op.operands[1])
            elif op.operands.len >= 1:
                PrimaryBodyIrCountSlotRead(counts, op.operands[0])
            continue
        if op.kind == coreir.BodyOpStoreLocalTag ||
           op.kind == coreir.BodyOpCopyLocalTag:
            if op.operands.len >= 1:
                PrimaryBodyIrCountSlotRead(counts, op.operands[0])
            continue
        if op.kind == coreir.BodyOpBinOpTag:
            for binReadI in 2..<op.operands.len:
                PrimaryBodyIrCountSlotRead(counts, op.operands[binReadI])
            continue
        if op.kind == coreir.BodyOpCmpTag:
            for cmpReadI in 1..<op.operands.len:
                PrimaryBodyIrCountSlotRead(counts, op.operands[cmpReadI])
            continue
        # Unmodeled op kind: stay conservative (over-count can only disable fusion).
        for unmodeledReadI in 0..<op.operands.len:
            PrimaryBodyIrCountSlotRead(counts, op.operands[unmodeledReadI])
    for termIndex in 0..<bodyIR.terms.len:
        let term = bodyIR.terms[termIndex]
        PrimaryBodyIrCountSlotRead(counts, term.lhsSlot)
        PrimaryBodyIrCountSlotRead(counts, term.rhsSlot)
        PrimaryBodyIrCountSlotRead(counts, term.resultSlot)
        for termOpI in 0..<term.operands.len:
            PrimaryBodyIrCountSlotRead(counts, term.operands[termOpI])
    return counts

# Stage10 Cmp->Cbr fuse decision for block `bi`: returns the arm64 true cond code to fuse with,
# or -1 if the block's terminating Cbr cannot fuse with its block's last op. Provably-safe gates:
#  (1) the block's terminator is a Cbr with conditionKind == LocalNonZero and rhsSlot < 0 (it
#      tests a single materialized bool slot for non-zero — i.e. branch-on-true);
#  (2) the block has at least one op and its LAST op is a BodyOpCmp (adjacency => NZCV still live
#      between the cmp and the branch; nothing the filler emits between a Cmp and the term sets
#      flags: BlockExitCarryLoad fires only for the pre-header, whose term is an unconditional Br,
#      never a fused Cbr);
#  (3) that Cmp's operands[0] is a directly-branchable scalar compare tag;
#  (4) the Cbr's lhsSlot == the Cmp's target (the bool the Cbr tests is the one the Cmp produces);
#  (5) the bool slot is PRECISELY single-use: read exactly once across the whole body — that one
#      read being this Cbr's lhsSlot. If anything else reads it, the cset+store must stay.
# The returned cond code is a64units.CodegenA64BodyCondTrueCode(condTag): exhaustive + correct per
# cmp-kind x signedness (eq/ne, signed lt/le/gt/ge, unsigned lo/ls/hi/hs). Polarity: LocalNonZero
# branches-to-trueBlock when the bool != 0 (the comparison is TRUE), so the fused filler emits
# `b.<truecode> trueBlock; b falseBlock` — exactly correct.
@borrows
fn PrimaryBodyIrCmpFuseCondForBlock(bodyIR: coreir.BodyIR,
                                     bi: int32,
                                     preciseReadCounts: int32[]): int32 =
    if bi < 0 || bi >= bodyIR.blocks.len:
        return -1
    let block = bodyIR.blocks[bi]
    if block.opCount <= 0:
        return -1
    let termIndex = block.termIndex
    if termIndex < 0 || termIndex >= bodyIR.terms.len:
        return -1
    let term = bodyIR.terms[termIndex]
    if term.kind != coreir.BodyTermCbrTag:
        return -1
    if term.conditionKind != coreir.BodyCondLocalNonZeroTag:
        return -1
    if term.rhsSlot >= 0:
        return -1
    let lastOpIndex = block.opStart + block.opCount - 1
    if lastOpIndex < 0 || lastOpIndex >= bodyIR.ops.len:
        return -1
    let lastOp = bodyIR.ops[lastOpIndex]
    if lastOp.kind != coreir.BodyOpCmpTag:
        return -1
    if lastOp.operands.len < 3:
        return -1
    let condTag = lastOp.operands[0]
    let condBranchable = (condTag >= coreir.BodyCondI32EqTag && condTag <= coreir.BodyCondU64GeTag) ||
                         PrimaryBodyCondIsF64(condTag)
    if !condBranchable:
        return -1
    let boolSlot = lastOp.target
    if boolSlot < 0 || boolSlot >= bodyIR.localSlots.len:
        return -1
    if term.lhsSlot != boolSlot:
        return -1
    # precise single-use: exactly one genuine read in the whole body (this Cbr's lhsSlot).
    if boolSlot >= preciseReadCounts.len || preciseReadCounts[boolSlot] != 1:
        return -1
    return a64units.CodegenA64BodyCondTrueCode(condTag)

# arm64 peephole prepare (single-pass收口). The arm64 EmitObj size predictor (layout op/term/block/
# call-reloc/data-reloc/wordCount cursor) has been deleted: production arm64 layout/branch/reloc/
# buffer sizing are sourced emit-first from the real serial fill, and every metricsReady fast-path
# now recomputes on demand via the *Raw functions. layoutMetricsReady stays false forever, so no
# second (predicted) source of truth exists and a two-pass desync is structurally impossible.
# This function survives ONLY to freeze the peephole decision bitmaps (lhsElide / storeElide /
# copySrcElide / cmpFuse / cbrFuse) that BOTH the *Raw size cases AND the fillers read identically.
fn PrimaryBodyIrPrepareA64LayoutMetricsInPlace(bodyIR: var coreir.BodyIR) =
    # Step 3 P3 wire: env-gated escape arena route + plan via ghost fn
    # calls. Default off (CHENG_ESCAPE_ARENA_ROUTE=1 to enable). ghost
    # tested cc + ci_gate 双绿 (commits 3a365f815 / 05d0b54f7);
    # this wire only reaches a real call site for stage3 verification —
    # no slot allocator mutation yet (P3 真 wire 留 cross-session §12.2).
    let _arenaRouteGate = os.GetEnv("CHENG_ESCAPE_ARENA_ROUTE")
    if _arenaRouteGate == "1":
        let _route = ear.EscapeArenaRouteAnalyze(bodyIR)
        let _plan = earplan.EscapeArenaPlanBuild(_route)
        # Plan output is currently observed only; real allocator routing
        # mutation留 cross-session §12.2 protocol. The wire ensures
        # stage3 binary really invokes the routing pipeline when env=1.
        let _unused = _plan.arenaCount + _plan.heapCount
        if _unused < 0:
            _unused = 0
    # Step 5 (备) P3 wire: env-gated alias + LICM/GVN-on-memory analysis
    # + plan via ghost fn calls. Default off (CHENG_ALIAS_LICM_GVN=1
    # to enable). Algorithms ghost-tested (commits 7c1932d3f + a347cf374).
    # Real hoist/elimination 留 cross-session §12.2 protocol (P5 备用阶段,
    # 仅 Step 1-4 累乘 underdeliver 时才上)。
    let _aliasGate = os.GetEnv("CHENG_ALIAS_LICM_GVN")
    if _aliasGate == "1":
        let _aliasResult = alg.AliasLicmGvnAnalyze(bodyIR)
        let _aliasPlan = algplan.AliasLicmGvnPlanBuild(_aliasResult)
        let _aliasUnused = _aliasPlan.hoistCount + _aliasPlan.elimCount
        if _aliasUnused < 0:
            _aliasUnused = 0
    PrimaryBodyIrPrepareFrameMetricsInPlace(bodyIR)
    bodyIR.layoutLhsElide = []
    bodyIR.layoutStoreElide = []
    bodyIR.layoutCopySrcElide = []
    bodyIR.layoutCmpFuse = []
    bodyIR.layoutCbrFuse = []
    for _ in 0..<bodyIR.ops.len:
        add(bodyIR.layoutLhsElide, false)
        add(bodyIR.layoutStoreElide, false)
        add(bodyIR.layoutCopySrcElide, false)
        add(bodyIR.layoutCmpFuse, -1)
    for _ in 0..<bodyIR.terms.len:
        add(bodyIR.layoutCbrFuse, -1)
    let frameBytes = PrimaryBodyIrFrameBytes(bodyIR)
    if frameBytes <= 0:
        return
    if bodyIR.blocks.len <= 0:
        return
    # Stage-0 peephole: precompute lhs-reload elidability per op WITH block context
    # (block.opStart is needed to forbid eliding at a block entry / branch target).
    # Computed ONCE here, BEFORE the word-count loop below, so PrimaryBodyIROpSizeAtRaw
    # reads the same per-op flag the filler later reads — keeping the two passes in lockstep.
    for elideBi in 0..<bodyIR.blocks.len:
        let elideBlock = bodyIR.blocks[elideBi]
        if elideBlock.opStart >= 0 && elideBlock.opCount >= 0 &&
           elideBlock.opStart + elideBlock.opCount <= bodyIR.ops.len:
            let elideOpEnd = elideBlock.opStart + elideBlock.opCount
            for elideOi in elideBlock.opStart..<elideOpEnd:
                if PrimaryBodyIrLhsReloadElidableAt(bodyIR, elideBlock.opStart, elideOi):
                    bodyIR.layoutLhsElide[elideOi] = true
    # Stage-1 peephole: precompute copy-source-elide THEN store-elide per op. The body-wide
    # single-use count and layoutLhsElide (above) are finalized first; copy-src-elide is
    # computed before store-elide because store-elide reads layoutCopySrcElide[i+1] to decide
    # whether a producer's store is dead. All decisions are frozen on BodyIR and read
    # identically by the size predictor and the filler.
    let storeElideReadCounts = PrimaryBodyIrBuildSlotReadCounts(bodyIR)
    for copyBi in 0..<bodyIR.blocks.len:
        let copyBlock = bodyIR.blocks[copyBi]
        if copyBlock.opStart >= 0 && copyBlock.opCount >= 0 &&
           copyBlock.opStart + copyBlock.opCount <= bodyIR.ops.len:
            let copyOpEnd = copyBlock.opStart + copyBlock.opCount
            for copyOi in copyBlock.opStart..<copyOpEnd:
                if PrimaryBodyIrCopySrcElidableAt(bodyIR, copyBlock.opStart, copyOi, storeElideReadCounts):
                    bodyIR.layoutCopySrcElide[copyOi] = true
    for storeBi in 0..<bodyIR.blocks.len:
        let storeBlock = bodyIR.blocks[storeBi]
        if storeBlock.opStart >= 0 && storeBlock.opCount >= 0 &&
           storeBlock.opStart + storeBlock.opCount <= bodyIR.ops.len:
            let storeOpEnd = storeBlock.opStart + storeBlock.opCount
            for storeOi in storeBlock.opStart..<storeOpEnd:
                if PrimaryBodyIrStoreElidableAt(bodyIR, storeOpEnd, storeOi, storeElideReadCounts):
                    bodyIR.layoutStoreElide[storeOi] = true
    # Stage10 Cmp->Cbr fusion decision: computed ONCE here (BEFORE the op/term size loops), using a
    # PRECISE read counter so a single-use bool is recognised (the conservative storeElideReadCounts
    # over-counts via LoadConst literal collisions and would never fire). For each block whose last
    # op is a Cmp consumed only by the block's LocalNonZero Cbr terminator, freeze the arm64 cond
    # code into layoutCmpFuse[lastOp] AND layoutCbrFuse[term]; both size cases + both fillers + the
    # block-start prefix-sum read these identically => strict two-pass symmetry.
    let cmpFuseReadCounts = PrimaryBodyIrBuildSlotPreciseReadCounts(bodyIR)
    for fuseBi in 0..<bodyIR.blocks.len:
        let fuseCond = PrimaryBodyIrCmpFuseCondForBlock(bodyIR, fuseBi, cmpFuseReadCounts)
        if fuseCond >= 0:
            let fuseBlock = bodyIR.blocks[fuseBi]
            let fuseLastOp = fuseBlock.opStart + fuseBlock.opCount - 1
            let fuseTerm = fuseBlock.termIndex
            if fuseLastOp >= 0 && fuseLastOp < bodyIR.layoutCmpFuse.len &&
               fuseTerm >= 0 && fuseTerm < bodyIR.layoutCbrFuse.len:
                bodyIR.layoutCmpFuse[fuseLastOp] = fuseCond
                bodyIR.layoutCbrFuse[fuseTerm] = fuseCond

@borrows
fn PrimaryBodyIrPrepareTargetMetricsInPlace(targetTriple: str,
                                             bodyIR: var coreir.BodyIR) =
    # B6d：三臂显式单元派发（契约 CodegenBodyEmitUnit 表键），废除原
    # else=arm64 默认兜底臂——缺 triple/单元显式失败，不留隐式默认。
    let metricsUnit = contract.CodegenBodyEmitUnit(targetTriple)
    if metricsUnit == contract.CodegenUnitWasm32:
        return
    if metricsUnit == contract.CodegenUnitX64:
        PrimaryBodyIrPrepareFrameMetricsInPlace(bodyIR)
        if !x64units.CodegenX64BodyPrepareStackLayout(bodyIR):
            panic("primary object: x64 stack layout preparation failed")
        return
    if metricsUnit == contract.CodegenUnitA64:
        PrimaryBodyIrPrepareA64LayoutMetricsInPlace(bodyIR)
        return
    # Step4 两臂收口（2026-08-29，案 A 报文收敛最小案）：同 PrimaryBodyIrWordCount
    # ForTarget 臂，未命中先经组合准入包装取件（Ok 证件入 store），再按 D1 铁律
    # fail-closed 同抛 contract.CodegenPluginMissingError。
    var missingUnits: str[]
    var composeArtifact: rawbytes.Bytes
    let _ = pickup.CodegenCompositionAcquireArtifactForTriple(
        targetTriple, composeArtifact)
    panic(contract.CodegenPluginMissingError(targetTriple, missingUnits))

@borrows
fn PrimaryBodyIREmitWord(bodyIR: coreir.BodyIR, wordOffset: int32): int32 =
    if wordOffset < 0 || wordOffset >= PrimaryBodyIrWordCount(bodyIR):
        return a64units.CodegenA64EncRet()
    let prologueCount = PrimaryBodyIrPrologueWordCount(bodyIR)
    if wordOffset < prologueCount:
        return a64units.CodegenA64BodyEmitPrologueWord(wordOffset)
    return PrimaryBodyIREmitBlockWord(bodyIR, wordOffset - prologueCount, 0)

@borrows
fn PrimaryBodyIREmitBlockWord(bodyIR: coreir.BodyIR, relOffset: int32, blockIndex: int32): int32 =
    if blockIndex >= bodyIR.blocks.len:
        return a64units.CodegenA64EncRet()
    let blockSize = PrimaryBodyIRBlockSize(bodyIR, blockIndex)
    if relOffset < blockSize:
        let block = bodyIR.blocks[blockIndex]
        let opEnd = block.opStart + block.opCount
        let opSize = PrimaryBodyIROpRangeSize(bodyIR, block.opStart, opEnd)
        if relOffset < opSize:
            return PrimaryBodyIREmitOpWord(bodyIR, relOffset, block.opStart, opEnd)
        let termRelOffset = relOffset - opSize
        let termIndex = block.termIndex
        if termIndex >= 0 && termIndex < bodyIR.terms.len:
            return a64units.CodegenA64BodyEmitTermWord(bodyIR.terms[termIndex], termRelOffset)
        return a64units.CodegenA64EncRet()
    return PrimaryBodyIREmitBlockWord(bodyIR, relOffset - blockSize, blockIndex + 1)

@borrows
fn PrimaryBodyIREmitOpWord(bodyIR: coreir.BodyIR, relOffset: int32, opStart: int32, opEnd: int32): int32 =
    if opStart >= opEnd || opStart >= bodyIR.ops.len:
        return a64units.CodegenA64EncRet()
    let op = bodyIR.ops[opStart]
    let opSize = PrimaryBodyIROpSize(op)
    if relOffset < opSize:
        return PrimaryBodyIREmitOpInstruction(op, relOffset)
    return PrimaryBodyIREmitOpWord(bodyIR, relOffset - opSize, opStart + 1, opEnd)

@borrows
fn PrimaryBodyIREmitOpInstruction(op: coreir.BodyOp, relOffset: int32): int32 =
    if op.kind == coreir.BodyOpCallTag:
        if relOffset == 0:
            return a64units.CodegenA64EncMovz(false, 0, 0, 0)
        if relOffset == 1:
            return a64units.CodegenA64EncMovz(false, 0, 0, 0)
        if relOffset == 2:
            return a64units.CodegenA64EncMovz(false, 0, 0, 0)
        if relOffset == 3:
            return a64units.CodegenA64EncBlPlaceholder()
        return 0
    if op.kind == coreir.BodyOpReturnTag:
        if relOffset == 0:
            if op.operands.len >= 1 && op.operands[0] == PrimaryStatementReturnModeI32Const():
                if op.operands.len >= 2:
                    return a64units.CodegenA64EncMovz(false, 0, op.operands[1] & 65535, 0)
            return a64units.CodegenA64EncMovz(false, 0, 0, 0)
        return a64units.CodegenA64EncRet()
    if op.kind == coreir.BodyOpLoadConstTag:
        if op.operands.len >= 2 && op.operands[0] == coreir.LocalI32Tag:
            return a64units.CodegenA64EncMovz(false, 0, op.operands[1] & 65535, 0)
        return a64units.CodegenA64EncMovz(false, 0, 0, 0)
    return a64units.CodegenA64EncRet()

@borrows
fn PrimaryObjectPlanEmitBodyIRAt(bodyIR: coreir.BodyIR,
                                   words: var int32[],
                                   wordOffset: int32,
                                   emitted: var int32) =
    let totalWords = PrimaryBodyIrWordCount(bodyIR)
    emitted = PrimaryBodyIRFillWords(words, wordOffset, totalWords, bodyIR)

@borrows
fn PrimaryBodyIREmitBodyIRWords(bodyIR: coreir.BodyIR, words: var int32[], wordOffset: int32, wi: int32, totalWords: int32) =
    if wi >= totalWords:
        return
    let word = PrimaryBodyIREmitWord(bodyIR, wi)
    words[wordOffset + wi] = word
    PrimaryBodyIREmitBodyIRWords(bodyIR, words, wordOffset, wi + 1, totalWords)

@borrows
fn PrimaryBodyIrStatementReturnMode(bodyIR: coreir.BodyIR): int32 =
    if bodyIR.ops.len <= 0:
        return PrimaryStatementReturnModeNone()
    let lastOp = bodyIR.ops[bodyIR.ops.len - 1]
    if lastOp.kind != coreir.BodyOpReturnTag:
        return PrimaryStatementReturnModeNone()
    if lastOp.operands.len <= 0:
        return PrimaryStatementReturnModeNone()
    return lastOp.operands[0]

@borrows
fn PrimaryBodyIrStackByteCountRaw(bodyIR: coreir.BodyIR): int32 =
    var maxSlot: int32
    for i in 0..<bodyIR.localSlots.len:
        if PrimaryBodyIrLocalIsParam(bodyIR.localSlots[i]):
            continue
        let slotEnd = bodyIR.localSlots[i].stackOffset + PrimaryBodyIrLocalFrameFootprint(bodyIR.localSlots[i])
        if slotEnd > maxSlot:
            maxSlot = slotEnd
    if maxSlot < 32:
        maxSlot = 32
    return ((maxSlot + 15) / 16) * 16

@borrows
fn PrimaryBodyIrParamSaveCountRaw(bodyIR: coreir.BodyIR): int32 =
    var count: int32
    for i in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[i]
        if !PrimaryBodyIrLocalIsParam(slot):
            continue
        let paramSlot = PrimaryBodyIrParamIndex(slot)
        if paramSlot >= 0 && paramSlot < 8 && paramSlot + 1 > count:
            count = paramSlot + 1
    return count

@borrows
fn PrimaryAlignStackBytes(bytes: int32, align: int32): int32 =
    if bytes < 0 || align <= 0:
        panic("primary object: invalid stack alignment input")
    if bytes > 2147483647 - (align - 1):
        panic("primary object: stack alignment overflow")
    return ((bytes + align - 1) / align) * align

fn PrimaryBodyIrPrepareFrameMetricsInPlace(bodyIR: var coreir.BodyIR) =
    if bodyIR.frameMetricsReady:
        return
    let stackByteCount = PrimaryBodyIrStackByteCountRaw(bodyIR)
    let paramSaveCount = PrimaryBodyIrParamSaveCountRaw(bodyIR)
    let paramSaveOffset = stackByteCount
    let returnBufferSaveOffset = stackByteCount + paramSaveCount * 8
    let frameBytes =
        PrimaryAlignStackBytes(stackByteCount + paramSaveCount * 8 + 8, 16)
    bodyIR.frameStackByteCount = stackByteCount
    bodyIR.frameParamSaveCount = paramSaveCount
    bodyIR.frameParamSaveOffset = paramSaveOffset
    bodyIR.frameReturnBufferSaveOffset = returnBufferSaveOffset
    bodyIR.frameBytes = frameBytes
    var saveBaseWords: int32
    if !PrimaryBodyIrStackAccessImmFits(returnBufferSaveOffset, 8):
        saveBaseWords = PrimaryBodyIrStackAddressWordCount(paramSaveOffset)
    bodyIR.framePrologueWordCount =
        PrimaryBodyIrStackAdjustWordCount(frameBytes) +
        3 + paramSaveCount + saveBaseWords
    bodyIR.frameRestoreWordCount =
        PrimaryBodyIrStackAdjustWordCount(frameBytes) + 2
    bodyIR.frameMetricsReady = true

@borrows
fn PrimaryBodyIrStackByteCount(bodyIR: coreir.BodyIR): int32 =
    if bodyIR.frameMetricsReady:
        return bodyIR.frameStackByteCount
    return PrimaryBodyIrStackByteCountRaw(bodyIR)

@borrows
fn PrimaryBodyIrParamSaveCount(bodyIR: coreir.BodyIR): int32 =
    if bodyIR.frameMetricsReady:
        return bodyIR.frameParamSaveCount
    return PrimaryBodyIrParamSaveCountRaw(bodyIR)

@borrows
fn PrimaryBodyIrParamSaveOffset(bodyIR: coreir.BodyIR): int32 =
    if bodyIR.frameMetricsReady:
        return bodyIR.frameParamSaveOffset
    return PrimaryBodyIrStackByteCount(bodyIR)

@borrows
fn PrimaryBodyIrReturnBufferSaveOffset(bodyIR: coreir.BodyIR): int32 =
    if bodyIR.frameMetricsReady:
        return bodyIR.frameReturnBufferSaveOffset
    return PrimaryBodyIrStackByteCount(bodyIR) + PrimaryBodyIrParamSaveCount(bodyIR) * 8

@borrows
fn PrimaryBodyIrFrameBytes(bodyIR: coreir.BodyIR): int32 =
    if bodyIR.frameMetricsReady:
        return bodyIR.frameBytes
    let localBytes = PrimaryBodyIrStackByteCount(bodyIR)
    let paramBytes = PrimaryBodyIrParamSaveCount(bodyIR) * 8
    return PrimaryAlignStackBytes(localBytes + paramBytes + 8, 16)

@borrows
fn PrimaryObjectMissingReasons(linkPlan: slplan.SystemLinkPlanStub,
                                 lowering: var lower.LoweringPlanStub,
                                 itemIds: int32[],
                                 instructionWords: int32[],
                                 bodySemanticsMissing: bool,
                                 streamedBuildAborted: bool): str[] =
    var missing: str[]
    if linkPlan.missingReasons.len > 0:
        add(missing, "system_link_plan_not_ready_for_primary_object")
    if lowering.missingReasons.len > 0:
        add(missing, "lowering_plan_not_ready_for_primary_object")
    if itemIds.len <= 0:
        add(missing, "primary_object_items_missing")
    if instructionWords.len <= 0:
        add(missing, "primary_object_machine_words_missing")
    if streamedBuildAborted:
        add(missing, "primary_object_decl_order_stream_failed")
    if bodySemanticsMissing:
        add(missing, "primary_object_body_semantics_missing")
    var primaryColdCond33: bool
    var primaryColdCond33Clause0: bool
    if linkPlan.emitKind == creq.EmitExe:
        if len(linkPlan.entrySymbol) <= 0:
            primaryColdCond33Clause0 = true
    if primaryColdCond33Clause0:
        primaryColdCond33 = true
    if primaryColdCond33:
        add(missing, "primary_object_entry_symbol_missing")
    return missing

# Blocker enumeration (gated on CHENG_BLOCKER_ENUM=1): one read-only pass over every
# function's call targets, mirroring the reachability skip+resolve classification, to collect
# EVERY unresolvable call target (not just the first the build aborts on) plus a resolved/total
# progress metric. Read-only — uses the pure name/symbol resolver, never the source-path
# rewriting variant. Surfaced via plan.missingReasons (the driver already prints
# primary_object_missing_reasons), so no driver change is needed. Skip classes (builtin /
# importc / Ok-Err / numeric cast / aggregate constructor / pointer reinterpret) are pseudo
# call targets that are not real calls, so they are excluded from both numerator and
# denominator — the remaining unresolved set is exactly the real functions dropped from the
# symbol set.
fn PrimaryObjectPlanEnumerateBlockers(lowering: var lower.LoweringPlanStub): str[] =
    var out: str[]
    # File sentinel (not env): the driver spawns codegen in a child process whose env is an
    # explicit allow-list (CHENG_BLOCKER_ENUM is not forwarded), but the filesystem is shared,
    # so a sentinel file is visible across the spawn boundary. Zero cost (single stat) when off.
    if !os.FileExists("/tmp/cheng_blocker_enum_on"):
        return out
    var totalReal: int32
    var resolved: int32
    var seen: str[]
    for irIndex in 0..<lowering.primaryObjectIr.functions.len:
        let irFunction = lowering.primaryObjectIr.functions[irIndex]
        if irFunction.callTargets.len <= 0:
            continue
        if irFunction.callTargetSourcePaths.len != irFunction.callTargets.len ||
           irFunction.callTargetSignatureLineNumbers.len !=
               irFunction.callTargets.len ||
           irFunction.callTargetImportcFlags.len != irFunction.callTargets.len:
            continue
        for ord in 0..<irFunction.callTargets.len:
            if ord < irFunction.callTargetImportcFlags.len &&
               irFunction.callTargetImportcFlags[ord]:
                continue
            let t = irFunction.callTargets[ord]
            if len(t) <= 0:
                continue
            if PrimaryObjectCallTargetIsBuiltin(t):
                continue
            let tail = PrimaryCallTargetTailName(t)
            if tail == "Ok" || tail == "Err":
                continue
            if PrimaryObjectCallTargetIsPureCast(t):
                continue
            if PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr, irFunction.sourcePath, t):
                continue
            if PrimaryBodyIrCallHeadIsSeqAliasConstructor(lowering.typedIr, irFunction.sourcePath, t):
                continue
            if PrimaryBodyIrPtrReinterpretCastHead(t):
                continue
            if PrimaryBodyIrPtrAliasReinterpretCastHead(lowering.typedIr, irFunction.sourcePath, t):
                continue
            let targetSourcePath =
                PrimaryObjectCallTargetSourcePath(irFunction, ord)
            if texpr.TypedExprIrLookupImportcTargetSymbol(lowering.typedIr,
                                                          targetSourcePath,
                                                          t) != "":
                continue
            totalReal = totalReal + 1
            let idx = PrimaryPlanResolveTargetIndexArgAwareExactSource(
                lowering, targetSourcePath, t, irIndex, ord)
            if idx >= 0:
                resolved = resolved + 1
            elif !PrimaryBodyIrNameInList(seen, t):
                add(seen, share(t))
                add(out, Fmt"blocker_target={t} caller={irFunction.functionName} src={irFunction.sourcePath}")
    var pct: int32
    if totalReal > 0:
        pct = resolved * 100 / totalReal
    var summary: str[]
    add(summary, Fmt"blocker_enum_total_call_targets={totalReal}")
    add(summary, Fmt"blocker_enum_resolved={resolved}")
    add(summary, Fmt"blocker_enum_unresolved_unique={seen.len}")
    add(summary, Fmt"blocker_enum_resolved_pct={pct}")
    for summaryIndex in 0..<out.len:
        add(summary, strings.CloneStr(out[summaryIndex]))
    # Direct stderr emit too (second surfacing channel, independent of the driver report path).
    for emitIndex in 0..<summary.len:
        os.WriteLine(os.GetStderr(), summary[emitIndex])
    return summary

@borrows
fn PrimaryObjectTypedIrFieldCount(typedIr: texpr.TypedExprIr,
                                   ownerType: str,
                                   fieldName: str): int32 =
    var count: int32
    for i in 0..<typedIr.typeFieldOwnerTypes.len:
        if i >= typedIr.typeFieldNames.len:
            continue
        if typedIr.typeFieldOwnerTypes[i] == ownerType &&
           typedIr.typeFieldNames[i] == fieldName:
            count = count + 1
    return count

@borrows
fn PrimaryObjectTypedIrTypeDefAliasCount(typedIr: texpr.TypedExprIr,
                                          aliasName: str,
                                          targetType: str): int32 =
    var count: int32
    for i in 0..<typedIr.typeDefAliasNames.len:
        if i >= typedIr.typeDefAliasTargetTypes.len:
            continue
        if typedIr.typeDefAliasNames[i] == aliasName &&
           typedIr.typeDefAliasTargetTypes[i] == targetType:
            count = count + 1
    return count

@borrows
fn PrimaryObjectTypedIrFieldMetric(typedIr: texpr.TypedExprIr,
                                    ownerType: str,
                                    fieldName: str,
                                    metric: str): int32 =
    for i in 0..<typedIr.typeFieldOwnerTypes.len:
        if i >= typedIr.typeFieldNames.len:
            continue
        if typedIr.typeFieldOwnerTypes[i] != ownerType:
            continue
        if typedIr.typeFieldNames[i] != fieldName:
            continue
        if metric == "type" && i < typedIr.typeFieldTypes.len:
            return 1
        if metric == "offset" && i < typedIr.typeFieldOffsetBytes.len:
            return typedIr.typeFieldOffsetBytes[i]
        if metric == "size" && i < typedIr.typeFieldSizeBytes.len:
            return typedIr.typeFieldSizeBytes[i]
        if metric == "align" && i < typedIr.typeFieldAlignBytes.len:
            return typedIr.typeFieldAlignBytes[i]
        return -1
    return -1

@borrows
fn PrimaryObjectTypedIrFieldTypeText(typedIr: texpr.TypedExprIr,
                                      ownerType: str,
                                      fieldName: str): str =
    for i in 0..<typedIr.typeFieldOwnerTypes.len:
        if i >= typedIr.typeFieldNames.len:
            continue
        if typedIr.typeFieldOwnerTypes[i] != ownerType:
            continue
        if typedIr.typeFieldNames[i] != fieldName:
            continue
        if i < typedIr.typeFieldTypes.len:
            return strings.CloneStr(typedIr.typeFieldTypes[i])
        return ""
    return ""

@borrows
fn PrimaryObjectMissingLineNumber(lowering: var lower.LoweringPlanStub,
                                   irIndex: int32): int32 =
    if irIndex < 0 || irIndex >= lowering.primaryObjectIr.functions.len:
        return 0
    let irFunction = lowering.primaryObjectIr.functions[irIndex]
    if irFunction.bodyKind == texpr.BodyKindUnsupported &&
       irFunction.statements.len > 0:
        return irFunction.statements[0].lineNumber
    return irFunction.bodyLineNumber

@borrows
fn PrimaryObjectCallTargetSourcePath(irFunction: lower.PrimaryObjectIrFunction,
                                     callOrdinal: int32): str =
    if callOrdinal >= 0 && callOrdinal < irFunction.callTargetSourcePaths.len:
        let callTargetSourcePath = irFunction.callTargetSourcePaths[callOrdinal]
        if len(callTargetSourcePath) > 0:
            return strings.CloneStr(callTargetSourcePath)
    return ""

@borrows
fn PrimaryObjectPlanEnsureResolveIndex(lowering: var lower.LoweringPlanStub) =
    # functionSymbolTexts / functionNames are immutable across one planning run,
    # so build the tail-name bucket indices once and reuse for every call site.
    if primaryPlanResolveBuiltCount == lowering.functionSymbolTexts.len &&
       primaryPlanResolveBuiltCount == lowering.functionNames.len &&
       primaryPlanResolveSymbolTailBucketHeads.len > 0:
        return
    primaryPlanResolveSymbolTailBucketHeads = []
    primaryPlanResolveSymbolTailEntryTails = []
    primaryPlanResolveSymbolTailEntryFnIndexes = []
    primaryPlanResolveSymbolTailEntryNext = []
    primaryPlanResolveNameTailBucketHeads = []
    primaryPlanResolveNameTailEntryTails = []
    primaryPlanResolveNameTailEntryFnIndexes = []
    primaryPlanResolveNameTailEntryNext = []
    for bucketIndex in 0..<16384:
        add(primaryPlanResolveSymbolTailBucketHeads, -1)
        add(primaryPlanResolveNameTailBucketHeads, -1)
    for i in 0..<lowering.functionSymbolTexts.len:
        let tail = PrimaryCallTargetTailName(lowering.functionSymbolTexts[i])
        let bucket = PrimaryObjectIrFunctionIndexHash(tail,
                                                      primaryPlanResolveSymbolTailBucketHeads.len)
        if bucket >= 0:
            let entryIndex = primaryPlanResolveSymbolTailEntryFnIndexes.len
            add(primaryPlanResolveSymbolTailEntryTails, strings.CloneStr(tail))
            add(primaryPlanResolveSymbolTailEntryFnIndexes, i)
            add(primaryPlanResolveSymbolTailEntryNext,
                primaryPlanResolveSymbolTailBucketHeads[bucket])
            primaryPlanResolveSymbolTailBucketHeads[bucket] = entryIndex
    for i in 0..<lowering.functionNames.len:
        let tail = PrimaryCallTargetTailName(lowering.functionNames[i])
        let bucket = PrimaryObjectIrFunctionIndexHash(tail,
                                                      primaryPlanResolveNameTailBucketHeads.len)
        if bucket >= 0:
            let entryIndex = primaryPlanResolveNameTailEntryFnIndexes.len
            add(primaryPlanResolveNameTailEntryTails, strings.CloneStr(tail))
            add(primaryPlanResolveNameTailEntryFnIndexes, i)
            add(primaryPlanResolveNameTailEntryNext,
                primaryPlanResolveNameTailBucketHeads[bucket])
            primaryPlanResolveNameTailBucketHeads[bucket] = entryIndex
    primaryPlanResolveBuiltCount = lowering.functionSymbolTexts.len

# TailName/TargetIndex 索引化原语与复合 (spec docs/beat-c.md §5.B.2)
# 复用 PrimaryObjectPlanEnsureResolveIndex 建的 tail 桶链 (primaryPlanResolveSymbolTail*/NameTail*),
# 替代 PrimaryFunctionTargetIndex* 线性族的逐候选 O(nfns) 扫描。语义逐位等价, 差分契约测试
# src/tests/target_index_semantic_contract_smoke.cheng 钉死。useNames=false 走 symbol 链,
# true 走 name 链。链序 LIFO (i 降序): SameSourceMin 全链 min 归约 = 线性升序首命中;
# AnyUnique 计数语义 (0→-1 / 1→that / ≥2→-1) 序无关, 无越界守卫复刻 pass2 不对称。
# 零接线: 仅新增函数, 不改生产调用点 (Step B 接线, Step C 删 resolver 死支)。

@borrows
fn PrimaryPlanResolveExactSourceUnique(lowering: var lower.LoweringPlanStub,
                                       useNames: bool,
                                       targetTail: str,
                                       targetSourcePath: str): int32 =
    PrimaryObjectPlanEnsureResolveIndex(lowering)
    var result: int32 = -1
    if useNames:
        let bucket = PrimaryObjectIrFunctionIndexHash(targetTail,
                                                      primaryPlanResolveNameTailBucketHeads.len)
        if bucket < 0:
            return -1
        var entry = primaryPlanResolveNameTailBucketHeads[bucket]
        while entry >= 0:
            if primaryPlanResolveNameTailEntryTails[entry] == targetTail:
                let i = primaryPlanResolveNameTailEntryFnIndexes[entry]
                if i < lowering.functionSourcePaths.len &&
                   PrimaryPathNormalizedEquals(lowering.functionSourcePaths[i], targetSourcePath):
                    if result >= 0 && result != i:
                        return -1
                    result = i
            entry = primaryPlanResolveNameTailEntryNext[entry]
    else:
        let bucket = PrimaryObjectIrFunctionIndexHash(targetTail,
                                                      primaryPlanResolveSymbolTailBucketHeads.len)
        if bucket < 0:
            return -1
        var entry = primaryPlanResolveSymbolTailBucketHeads[bucket]
        while entry >= 0:
            if primaryPlanResolveSymbolTailEntryTails[entry] == targetTail:
                let i = primaryPlanResolveSymbolTailEntryFnIndexes[entry]
                if i < lowering.functionSourcePaths.len &&
                   PrimaryPathNormalizedEquals(lowering.functionSourcePaths[i], targetSourcePath):
                    if result >= 0 && result != i:
                        return -1
                    result = i
            entry = primaryPlanResolveSymbolTailEntryNext[entry]
    return result

# 索引化复合 (spec §2 契约表, 逐位复刻线性 PrimaryFunctionTargetIndex* 族)

@borrows
fn PrimaryPlanResolveTargetIndex(lowering: var lower.LoweringPlanStub,
                                 targetSourcePath: str,
                                 targetText: str): int32 =
    if targetSourcePath == "" || targetText == "":
        return -1
    let targetTail = PrimaryCallTargetTailName(targetText)
    return PrimaryPlanResolveExactSourceUnique(lowering,
                                               false,
                                               targetTail,
                                               targetSourcePath)

@borrows
fn PrimaryPlanResolveNameTargetIndex(lowering: var lower.LoweringPlanStub,
                                     targetSourcePath: str,
                                     targetText: str): int32 =
    let targetTail = PrimaryCallTargetTailName(targetText)
    return PrimaryPlanResolveExactSourceUnique(lowering,
                                               true,
                                               targetTail,
                                               targetSourcePath)

@borrows
fn PrimaryPlanResolveTargetIndexWithNames(lowering: var lower.LoweringPlanStub,
                                          targetSourcePath: str,
                                          targetText: str): int32 =
    let s = PrimaryPlanResolveTargetIndex(lowering, targetSourcePath, targetText)
    if s >= 0 &&
       s < lowering.functionSourcePaths.len &&
       PrimaryPathNormalizedEquals(lowering.functionSourcePaths[s], targetSourcePath):
        return s
    return PrimaryPlanResolveNameTargetIndex(lowering, targetSourcePath, targetText)

# F02 (resolve-miss 收口): emit/reloc 路径专用出口 —
# exact-owner lookup 找不到目标时, 唯一允许的后果是编译期
# RecordError(missing_call_target), 不可关闭, 不设 env 开关, 不按符号名豁免。
# requireReachable 反映调用方所处的两个不同阶段 (不是白名单, 是结构性阶段区分):
#   - reachability 定点迭代阶段 (R1/R2) 传 false: 解出的 index 本身就是"新发现
#     可达"的证据, 此时要求它已经 reachable 是倒因为果。
#   - reloc/birc 阶段 (X1/X2, reachable 集合已定点封闭) 必须传 true: 否则会把
#     已被剪枝、从未发射的死符号当成功放行, 产出指向不存在函数体的悬空
#     reloc —— 比空 reloc 更隐蔽的错误, 历史 bl-self (BL imm26=0 自跳) 正是
#     "跳过 reachable 校验就判定 resolve 成功" 与 "resolve miss 就空 reloc"
#     两类问题的共同根。
# 元数 (arity) 唯一候选收窄: PrimaryObjectPlanUniqueCallCandidateIndex 的类型比对
# 依赖 TypedExprIrCallArgTypesText 对调用点实参表达式的类型推断——对形如
# `rawbytes.BytesBuilderNew(rawbytes.BytesLen(bodyBytes) + 64)` 这种"嵌套调用
# 参与算术"的复合实参, 该推断有既存缺陷(实测取到内层调用自身参数
# `bodyBytes: rawbytes.Bytes` 的类型而非整个复合表达式的 int32 结果类型), 致
# 类型比对对本应元数唯一存活的候选误判失配。元数(实参个数)提取
# (PrimaryObjectPlanCallArgCountAt, 纯语法逗号计数) 不受这个类型推断缺陷影响,
# 足以单独判定候选唯一性: 两个重载若形参个数不同, 调用点实参个数已经排他,
# 不需要类型信息。只在 candidateIndexes 用元数过滤后剩恰好一个时才采用,
# 否则(0 个或 2+ 个存活)返 -1、行为不变——不放宽任何真正需要类型消歧的场景。
@borrows
fn PrimaryPlanResolveUniqueCandidateByArgCount(lowering: var lower.LoweringPlanStub,
                                                candidateIndexes: int32[],
                                                irIndex: int32,
                                                callOrdinal: int32): int32 =
    if candidateIndexes.len <= 0:
        return -1
    if candidateIndexes.len == 1:
        return candidateIndexes[0]
    let actualArgCount = PrimaryObjectPlanCallArgCountAt(lowering, irIndex, callOrdinal)
    if actualArgCount < 0:
        return -1
    var matchIndex: int32
    matchIndex = -1
    var matchCount: int32
    for k in 0..<candidateIndexes.len:
        let candidateIndex = candidateIndexes[k]
        if candidateIndex < 0 || candidateIndex >= lowering.primaryObjectIr.functions.len:
            continue
        if lowering.primaryObjectIr.functions[candidateIndex].paramTypes.len != actualArgCount:
            continue
        matchCount = matchCount + 1
        if matchCount == 1:
            matchIndex = candidateIndex
    if matchCount == 1:
        return matchIndex
    return -1

@borrows
fn PrimaryPlanResolveTargetIndexArgAwareExactSource(
        lowering: var lower.LoweringPlanStub,
        targetSourcePath: str,
        targetText: str,
        irIndex: int32,
        callOrdinal: int32): int32 =
    if targetSourcePath == "" || targetText == "":
        return -1
    PrimaryObjectPlanEnsureResolveIndex(lowering)
    let targetTail = PrimaryCallTargetTailName(targetText)
    let symbolBucket = PrimaryObjectIrFunctionIndexHash(
        targetTail, primaryPlanResolveSymbolTailBucketHeads.len)
    var symbolCandidates: int32[]
    if symbolBucket >= 0:
        var entry = primaryPlanResolveSymbolTailBucketHeads[symbolBucket]
        while entry >= 0:
            if primaryPlanResolveSymbolTailEntryTails[entry] == targetTail:
                let candidateIndex =
                    primaryPlanResolveSymbolTailEntryFnIndexes[entry]
                if candidateIndex >= 0 &&
                   candidateIndex < lowering.functionSourcePaths.len &&
                   PrimaryPathNormalizedEquals(
                       lowering.functionSourcePaths[candidateIndex],
                       targetSourcePath):
                    add(symbolCandidates, candidateIndex)
            entry = primaryPlanResolveSymbolTailEntryNext[entry]
    let symbolHit = PrimaryObjectPlanUniqueCallCandidateIndex(
        lowering, symbolCandidates, irIndex, callOrdinal)
    if symbolHit >= 0:
        return symbolHit
    let symbolArityHit = PrimaryPlanResolveUniqueCandidateByArgCount(
        lowering, symbolCandidates, irIndex, callOrdinal)
    if symbolArityHit >= 0:
        return symbolArityHit
    let nameBucket = PrimaryObjectIrFunctionIndexHash(
        targetTail, primaryPlanResolveNameTailBucketHeads.len)
    var nameCandidates: int32[]
    if nameBucket >= 0:
        var nameEntry = primaryPlanResolveNameTailBucketHeads[nameBucket]
        while nameEntry >= 0:
            if primaryPlanResolveNameTailEntryTails[nameEntry] == targetTail:
                let candidateIndex =
                    primaryPlanResolveNameTailEntryFnIndexes[nameEntry]
                if candidateIndex >= 0 &&
                   candidateIndex < lowering.functionSourcePaths.len &&
                   PrimaryPathNormalizedEquals(
                       lowering.functionSourcePaths[candidateIndex],
                       targetSourcePath):
                    add(nameCandidates, candidateIndex)
            nameEntry = primaryPlanResolveNameTailEntryNext[nameEntry]
    let nameHit = PrimaryObjectPlanUniqueCallCandidateIndex(
        lowering, nameCandidates, irIndex, callOrdinal)
    if nameHit >= 0:
        return nameHit
    return PrimaryPlanResolveUniqueCandidateByArgCount(
        lowering, nameCandidates, irIndex, callOrdinal)

@borrows
fn PrimaryPlanResolveTargetIndexOrTrap(state: var PrimaryObjectPlanPhaseState,
                                       lowering: var lower.LoweringPlanStub,
                                       functionIndex: int32,
                                       irIndex: int32,
                                       sourcePath: str,
                                       targetText: str,
                                       callOrdinal: int32,
                                       requireReachable: bool): int32 =
    var idx = PrimaryPlanResolveTargetIndexWithNames(lowering,
                                                     sourcePath,
                                                     targetText)
    if idx < 0:
        idx = PrimaryPlanResolveTargetIndexArgAwareExactSource(lowering,
                                                               sourcePath,
                                                               targetText,
                                                               irIndex,
                                                               callOrdinal)
    var resolved = idx >= 0
    if resolved && requireReachable:
        resolved = idx < state.reachable.len && state.reachable[idx]
    if resolved:
        return idx
    state.bodySemanticsMissing = true
    PrimaryObjectPlanRecordError(state, lowering.functionNames[functionIndex],
                                 PrimaryObjectPlanFunctionSourcePathAt(lowering, functionIndex),
                                 "missing_call_target", targetText,
                                 PrimaryObjectMissingLineNumber(lowering, irIndex))
    if len(state.error.functionName) <= 0:
        PrimaryObjectPlanSetErrorFunctionIdentity(state.error, lowering, functionIndex)
        state.error.bodyKind = "missing_call_target"
        state.error.typedIrKind = ""
        state.error.lineNumber = PrimaryObjectMissingLineNumber(lowering, irIndex)
        state.error.callTargetOrdinal = callOrdinal
        state.error.callTarget = share(targetText)
        state.error.callTargetSourcePath = share(sourcePath)
        PrimaryObjectPlanFillMissingCallTargetDiagnostic(state.error, lowering, functionIndex, strings.CloneStr(targetText))
    return -1

# gapB overload-dispatch 类型过滤根修 (first-decl-wins 零类型感知定谳; 拍板见
# docs/beat-c.md §3 第四节#2)。下方三个 helper
# 让 PrimaryObjectPlanResolveCallTargetIndex 的每一同名候选集合按调用点实参类型
# 收窄, 唯一存活候选才采用; 过滤后仍 0 或 2+ 存活 = 该 tier 判不可解 (返回 -1,
# 交由下一 tier / 最终 missing_call_target 编译期硬失败, 绝不臆猜)。实参类型来源
# = lowering.primaryObjectIr.functions[irIndex].callArgTypesTexts[callOrdinal]
# (与 callTargets 同 ordinal 平行数组, LoweringAppendPrimaryObjectIrCallTarget 等
# 收集点用 TypedExprIrCallArgTypesText 产出的逗号联结实参类型文本写入; 未知位留
# 空串, 不当反证——只在明确类型不符时排除候选, 信息不足绝不过滤, 不臆造)。
@borrows
fn PrimaryObjectPlanCallArgCountAt(lowering: var lower.LoweringPlanStub,
                                    irIndex: int32,
                                    callOrdinal: int32): int32 =
    if irIndex < 0 || irIndex >= lowering.primaryObjectIr.functions.len:
        return -1
    let irFunction = lowering.primaryObjectIr.functions[irIndex]
    if callOrdinal < 0 || callOrdinal >= irFunction.callArgCounts.len:
        return -1
    return irFunction.callArgCounts[callOrdinal]

@borrows
fn PrimaryObjectPlanCallArgTypePartsAt(lowering: var lower.LoweringPlanStub,
                                        irIndex: int32,
                                        callOrdinal: int32): str[] =
    var parts: str[]
    if irIndex < 0 || irIndex >= lowering.primaryObjectIr.functions.len:
        return parts
    let irFunction = lowering.primaryObjectIr.functions[irIndex]
    if callOrdinal < 0 || callOrdinal >= irFunction.callArgTypesTexts.len:
        return parts
    let text = irFunction.callArgTypesTexts[callOrdinal]
    if text == "":
        return parts
    return strutil.Split(text, ',')

@borrows
fn PrimaryObjectPlanCallOrdinalIsSeqAddIntrinsic(lowering: var lower.LoweringPlanStub,
                                                   irIndex: int32,
                                                   callOrdinal: int32,
                                                   targetText: str): bool =
    if irIndex < 0 || irIndex >= lowering.primaryObjectIr.functions.len:
        return false
    let irFunction = lowering.primaryObjectIr.functions[irIndex]
    if callOrdinal < 0 || callOrdinal >= irFunction.callTargetSourcePaths.len:
        return false
    let targetTail = PrimaryCallTargetTailName(targetText)
    if targetTail != "add" && targetTail != "Add":
        return false
    if PrimaryObjectPlanCallArgCountAt(lowering, irIndex, callOrdinal) != 2:
        return false
    return strings.HasSuffix(irFunction.callTargetSourcePaths[callOrdinal],
                             "std/seqs.cheng")

# 类型别名归一只走 sealed TypedIR 的精确所有者边。visited identity 是
# (definition source, alias name)，因此跨模块同名不混淆，歧义/成环直接失败。
@borrows
fn PrimaryObjectPlanResolveTypeAliasLeaf(lowering: var lower.LoweringPlanStub,
                                          sourcePath: str,
                                          typeTextIn: str): str =
    if sourcePath == "" || typeTextIn == "":
        return typeTextIn
    var ownerSourcePath = sourcePath
    var typeText = texpr.TypedExprStripVarType(typeTextIn)
    var visitedOwners: str[]
    var visitedNames: str[]
    while true:
        var targetOwnerSourcePath: str
        var targetType: str
        var cycle: bool
        let state = texpr.TypedExprIrAliasTarget(lowering.typedIr,
                                                 ownerSourcePath,
                                                 typeText,
                                                 visitedOwners,
                                                 visitedNames,
                                                 targetOwnerSourcePath,
                                                 targetType,
                                                 cycle)
        if cycle:
            panic(Fmt"primary object: cyclic type alias source={ownerSourcePath} type={typeText}")
        if state == texpr.TypedExprBuildIndexAmbiguous:
            panic(Fmt"primary object: ambiguous type alias source={ownerSourcePath} type={typeText}")
        if state != texpr.TypedExprBuildIndexUnique:
            return typeText
        let nextType = texpr.TypedExprStripVarType(targetType)
        if targetOwnerSourcePath == "" || nextType == "":
            panic(Fmt"primary object: incomplete type alias payload source={ownerSourcePath} type={typeText}")
        ownerSourcePath = targetOwnerSourcePath
        typeText = nextType

# actualArgCount<0 (无法定位调用点, 理论不可达的防御分支) 时不排除——保持原有
# "信息不足不过滤" 语义; 否则先按元数 (candidateParamTypes.len 权威, 恒可靠)
# 排除, 再逐位比对已知类型文本 (跳过未知/空槽位)。callerSourcePath 用来在调用点
# 一侧解裸别名叶名, 候选一侧用候选自身声明所在源文件解 (两侧各自的别名作用域)。
@borrows
fn PrimaryObjectPlanCallCandidateMatchesArgTypes(lowering: var lower.LoweringPlanStub,
                                                   candidateIndex: int32,
                                                   actualArgCount: int32,
                                                   argTypeParts: str[],
                                                   callerSourcePath: str): bool =
    if candidateIndex < 0 || candidateIndex >= lowering.primaryObjectIr.functions.len:
        return false
    if actualArgCount < 0:
        return true
    let candidateParamTypes = lowering.primaryObjectIr.functions[candidateIndex].paramTypes
    if candidateParamTypes.len != actualArgCount:
        return false
    let candidateSourcePath = lowering.primaryObjectIr.functions[candidateIndex].sourcePath
    var upto = argTypeParts.len
    if candidateParamTypes.len < upto:
        upto = candidateParamTypes.len
    # gapB Bug2 根修: 候选形参类型文本若原样携带未具体化的类型形参 (裸 `T`/`T[]`/
    # `T[]*`/`set[T]` 等, PrimaryTypeTextHasGenericPlaceholder 判定), 字面/别名解析
    # 后仍恒不等——此时退到 TypedExprUnifyGenericParamType 结构化绑定 (数组/指针
    # 包装层数、括号容器名必须逐层结构相符, 占位符在同一候选的多次出现必须绑定
    # 同一具体类型), 绑定失败视同不等候选出局——不引入任何"松弛匹配", 只是把
    # "比较前先用调用点实参具体化模板"这一步显式做出来。非泛型候选零行为变化。
    var genericBoundNames: str[]
    var genericBoundTypes: str[]
    for i in 0..<upto:
        let argType = chengpath.PathTrim(argTypeParts[i])
        if argType == "":
            continue
        let argTypeStripped = texpr.TypedExprStripVarType(argType)
        let candidateTypeStripped = texpr.TypedExprStripVarType(candidateParamTypes[i])
        if argTypeStripped == candidateTypeStripped:
            continue
        let argTypeResolved = PrimaryObjectPlanResolveTypeAliasLeaf(lowering, callerSourcePath, argTypeStripped)
        let candidateTypeResolved = PrimaryObjectPlanResolveTypeAliasLeaf(lowering, candidateSourcePath, candidateTypeStripped)
        if argTypeResolved == candidateTypeResolved:
            continue
        if !PrimaryTypeTextHasGenericPlaceholder(candidateTypeResolved):
            return false
        let candidateGenericNames = PrimaryBodyIrTypeBracketArgs(lowering.primaryObjectIr.functions[candidateIndex].functionName)
        if !texpr.TypedExprUnifyGenericParamType(candidateTypeResolved, argTypeResolved, candidateGenericNames, genericBoundNames, genericBoundTypes):
            return false
    return true

# candidateIndexes.len<=1 直接透传 (无重载/免过滤开销, 单候选历史行为不变); >=2
# (真重载/撞尾名) 时按调用点实参类型收窄, 唯一存活返回其下标, 否则 -1。
@borrows
fn PrimaryObjectPlanUniqueCallCandidateIndex(lowering: var lower.LoweringPlanStub,
                                              candidateIndexes: int32[],
                                              irIndex: int32,
                                              callOrdinal: int32): int32 =
    if candidateIndexes.len <= 0:
        return -1
    if candidateIndexes.len == 1:
        return candidateIndexes[0]
    let actualArgCount = PrimaryObjectPlanCallArgCountAt(lowering, irIndex, callOrdinal)
    let argTypeParts = PrimaryObjectPlanCallArgTypePartsAt(lowering, irIndex, callOrdinal)
    var callerSourcePath = ""
    if irIndex >= 0 && irIndex < lowering.primaryObjectIr.functions.len:
        callerSourcePath = strings.CloneStr(
            lowering.primaryObjectIr.functions[irIndex].sourcePath)
    # gapB Bug2 混场守门: 具体 (非泛型模板) 候选与泛型模板候选分两个优先级独立计数
    # ——手写具体重载 (如 seqs.Add 的 str[] 专用存储布局) 只要唯一存活就必须挡住
    # 泛型模板参选, 不可让两者被同时判"匹配"造成假二义 (泛型模板结构化绑定后, 对
    # 手写具体重载覆盖到的实参类型天然也会绑定成功, 若不分级会导致这类早已工作
    # 的具体重载调用点回归)。只有具体候选 0 存活时才退到泛型模板集合——此时泛型
    # 模板是该 tail 名下唯一语义正确的候选, 结构化绑定后唯一存活才采用。
    var concreteMatchIndex: int32
    concreteMatchIndex = -1
    var concreteMatchCount: int32
    var genericMatchIndex: int32
    genericMatchIndex = -1
    var genericMatchCount: int32
    for k in 0..<candidateIndexes.len:
        let candidateIndex = candidateIndexes[k]
        if !PrimaryObjectPlanCallCandidateMatchesArgTypes(lowering, candidateIndex, actualArgCount, argTypeParts, callerSourcePath):
            continue
        if PrimaryObjectPlanFunctionIsGenericTemplate(lowering, candidateIndex):
            genericMatchCount = genericMatchCount + 1
            if genericMatchCount == 1:
                genericMatchIndex = candidateIndex
        else:
            concreteMatchCount = concreteMatchCount + 1
            if concreteMatchCount == 1:
                concreteMatchIndex = candidateIndex
    if concreteMatchCount == 1:
        return concreteMatchIndex
    if concreteMatchCount > 1:
        return -1
    if genericMatchCount == 1:
        return genericMatchIndex
    return -1

@borrows
fn PrimaryPlanLoweringRowForTypedFunctionIndex(
        lowering: var lower.LoweringPlanStub,
        typedFunctionIndex: int32): int32 =
    if typedFunctionIndex < 0:
        return -1
    for i in 0..<lowering.functionTypedIrIndexes.len:
        if lowering.functionTypedIrIndexes[i] == typedFunctionIndex:
            return i
    return -1

fn PrimaryPlanSymbolRowForTypedFunctionIndex(
        state: var PrimaryObjectPlanPhaseState,
        typedFunctionIndex: int32): int32 =
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >=
           state.allSymbolFunctionRowsByTypedFunctionIndex.len:
        return -1
    return state.allSymbolFunctionRowsByTypedFunctionIndex[
        typedFunctionIndex]

@borrows
fn PrimaryPlanCallTailUndecorated(targetText: str): str =
    let tail = PrimaryCallTargetTailName(targetText)
    if tail.len > 1 && tail[0] == '_':
        return strings.CloneStr(
            strings.SliceBytes(tail, 1, tail.len - 1))
    return tail

@borrows
fn PrimaryPlanUniqueFunctionTailRow(
        lowering: var lower.LoweringPlanStub,
        callText: str): int32 =
    let wantTail = PrimaryPlanCallTailUndecorated(callText)
    if wantTail.len <= 0:
        return -1
    var uniqueRow: int32
    uniqueRow = -1
    var uniqueHits: int32
    for functionRow in 0..<lowering.functionNames.len:
        if PrimaryPlanCallTailUndecorated(
               lowering.functionNames[functionRow]) != wantTail:
            continue
        uniqueHits = uniqueHits + 1
        uniqueRow = functionRow
    if uniqueHits == 1:
        return uniqueRow
    return -1

@borrows
fn PrimaryPlanUniqueReachableTailRow(
        state: var PrimaryObjectPlanPhaseState,
        lowering: var lower.LoweringPlanStub,
        callText: str): int32 =
    let wantTail = PrimaryPlanCallTailUndecorated(callText)
    if wantTail.len <= 0:
        return -1
    var uniqueRow: int32
    uniqueRow = -1
    var uniqueHits: int32
    for functionRow in 0..<lowering.functionNames.len:
        if functionRow >= state.reachable.len ||
           !state.reachable[functionRow]:
            continue
        if PrimaryPlanCallTailUndecorated(
               lowering.functionNames[functionRow]) != wantTail:
            continue
        uniqueHits = uniqueHits + 1
        uniqueRow = functionRow
    if uniqueHits == 1:
        return uniqueRow
    return -1

fn PrimaryPlanSymbolRowFromTempBodyIrCall(
        state: var PrimaryObjectPlanPhaseState,
        functionIndex: int32,
        callOrdinal: int32): int32 =
    if functionIndex < 0 ||
       functionIndex >= state.tempBodyIRs.len ||
       callOrdinal < 0:
        return -1
    let domainCount =
        state.tempBodyIRs[functionIndex].callTargetDomainKinds.len
    let rowCount = state.tempBodyIRs[functionIndex].callTargetRows.len
    if callOrdinal >= domainCount || callOrdinal >= rowCount:
        return -1
    if state.tempBodyIRs[functionIndex].callTargetDomainKinds[callOrdinal] !=
           coreir.BodyCallTargetDomainFunctionTag:
        return -1
    return PrimaryPlanSymbolRowForTypedFunctionIndex(
        state,
        state.tempBodyIRs[functionIndex].callTargetRows[callOrdinal])

@borrows
fn PrimaryObjectPlanResolveCallTargetIndex(lowering: var lower.LoweringPlanStub,
                                            irIndex: int32,
                                            callOrdinal: int32,
                                            currentFunctionSourcePath: str,
                                            resolvedSourcePath: str,
                                            targetText: str): int32 =
    # Exact TypedExpr identity is already sealed onto the IR call row
    # (callTargetTypedFunctionIndexes). Use that int32 row, not name+path.
    if irIndex >= 0 &&
       irIndex < lowering.primaryObjectIr.functions.len:
        let fnIr = lowering.primaryObjectIr.functions[irIndex]
        if callOrdinal >= 0 &&
           callOrdinal < fnIr.callTargetTypedFunctionIndexes.len:
            let typedRow = PrimaryPlanLoweringRowForTypedFunctionIndex(
                lowering,
                fnIr.callTargetTypedFunctionIndexes[callOrdinal])
            if typedRow >= 0:
                return typedRow
    # `resolvedSourcePath` is sealed TypedExpr provenance, not a hint. Resolve
    # overloads only inside that declaration owner; a missing owner is a hard
    # miss and must not be reconstructed from caller scope or global uniqueness.
    # by-value (not var): forwarded read-only into ArgAwareExactSource; keeps
    # whole-function @borrows compatible with caller field/local borrows.
    return PrimaryPlanResolveTargetIndexArgAwareExactSource(lowering,
                                                            resolvedSourcePath,
                                                            targetText,
                                                            irIndex,
                                                            callOrdinal)

@borrows
fn PrimaryObjectPlanCaptureBodyIrOpDetail(detail: var PrimaryObjectErrorBodyIrDetail,
                                           bodyIR: coreir.BodyIR,
                                           opIndex: int32) =
    if opIndex < 0 || opIndex >= bodyIR.ops.len:
        return
    let op = bodyIR.ops[opIndex]
    detail.firstZeroOpIndex = opIndex
    detail.firstZeroOpKind = op.kind
    detail.firstZeroOpTarget = op.target
    # InvalidOp(kind=0) does NOT encode slots: target=lineNumber,
    # operand0=statementKind, operand1=detail0, operand2=detail1.
    # Interpreting any of these as localSlots indices yields ghost slot
    # names (#fmt_parts / #nev...) — so for InvalidOp record the raw
    # Invalid-marker semantics and skip every slot-decode block below.
    if op.kind == coreir.BodyOpInvalidTag:
        if op.operands.len > 0:
            detail.firstZeroOpOperand0 = op.operands[0]
        if op.operands.len > 1:
            detail.firstZeroOpOperand1 = op.operands[1]
        if op.operands.len > 2:
            detail.firstZeroOpOperand2 = op.operands[2]
        if op.operands.len > 3:
            detail.firstZeroOpOperand3 = op.operands[3]
        var invStmtKind = -1
        var invDetail0 = -1
        var invDetail1 = -1
        if op.operands.len > 0:
            invStmtKind = op.operands[0]
        if op.operands.len > 1:
            invDetail0 = op.operands[1]
        if op.operands.len > 2:
            invDetail1 = op.operands[2]
        detail.firstZeroSlotDiag = Fmt"invalid_op:line={op.target}:statement_kind={invStmtKind}:detail0={invDetail0}:detail1={invDetail1}"
        return
    if op.target >= 0 && op.target < bodyIR.localSlots.len:
        let targetSlot = bodyIR.localSlots[op.target]
        detail.firstZeroTargetSlotName = targetSlot.name
        detail.firstZeroTargetSlotType = targetSlot.typeKind
        detail.firstZeroTargetSlotSize = PrimaryLocalSlotSizeOf(targetSlot)
        detail.firstZeroTargetSlotOffset = targetSlot.stackOffset
    if op.operands.len > 0:
        detail.firstZeroOpOperand0 = op.operands[0]
    if op.operands.len > 1:
        detail.firstZeroOpOperand1 = op.operands[1]
    if op.operands.len > 2:
        detail.firstZeroOpOperand2 = op.operands[2]
    if op.operands.len > 3:
        detail.firstZeroOpOperand3 = op.operands[3]
    if op.kind == coreir.BodyOpCallTag && op.operands.len > 0:
        let callOrdinal = op.operands[0]
        if callOrdinal >= 0 && callOrdinal < bodyIR.callSequence.len:
            let call = bodyIR.callSequence[callOrdinal]
            detail.firstZeroCallTarget = call.targetSymbol
            var badArgIndex = -1
            var badArgSlot = -1
            var badArgPassKind = -1
            var badArgWords = 0
            for argIndex in 0..<call.argSlots.len:
                let argSlot = call.argSlots[argIndex]
                let passKind = PrimaryCallOpArgPassKind(call, argIndex)
                let diagIsCAbiRegArg = call.targetIsImportc && argIndex < PrimaryCallOpRegisterArgCount(call)
                let argWords = PrimaryBodyIrCallArgWordCount(bodyIR,
                                                             argSlot,
                                                             passKind,
                                                             PrimaryCallOpStackArgBytes(call),
                                                             diagIsCAbiRegArg)
                if argWords <= 0 && badArgIndex < 0:
                    badArgIndex = argIndex
                    badArgSlot = argSlot
                    badArgPassKind = passKind
                    badArgWords = argWords
            var resultOffset = -1
            if call.resultSlot >= 0 && call.resultSlot < bodyIR.localSlots.len:
                resultOffset = PrimaryBodyIrLocalStackOffset(bodyIR,
                                                             call.resultSlot,
                                                             PrimaryBodyIrFrameBytes(bodyIR),
                                                             PrimaryBodyIrParamSaveOffset(bodyIR),
                                                             PrimaryBodyIrParamSaveCount(bodyIR))
            detail.firstZeroCallDiag = Fmt"ordinal={callOrdinal}:argc={call.argSlots.len}:result={call.resultSlot}:result_offset={resultOffset}:stack_arg_bytes={PrimaryCallOpStackArgBytes(call)}:bl_rel={PrimaryBodyIRCallBlRelOffset(bodyIR, op)}:bad_arg={badArgIndex}:bad_slot={badArgSlot}:bad_pass={badArgPassKind}:bad_words={badArgWords}"
    if op.operands.len > 0:
        let baseSlot = op.operands[0]
        if baseSlot >= 0 && baseSlot < bodyIR.localSlots.len:
            let slot = bodyIR.localSlots[baseSlot]
            detail.firstZeroBaseSlotName = slot.name
            detail.firstZeroBaseSlotType = slot.typeKind
            detail.firstZeroBaseSlotSize = PrimaryLocalSlotSizeOf(slot)
            detail.firstZeroBaseSlotOffset = slot.stackOffset
    if op.operands.len > 1:
        let valueSlot = op.operands[1]
        if valueSlot >= 0 && valueSlot < bodyIR.localSlots.len:
            let slot = bodyIR.localSlots[valueSlot]
            detail.firstZeroValueSlotName = slot.name
            detail.firstZeroValueSlotType = slot.typeKind
            detail.firstZeroValueSlotSize = PrimaryLocalSlotSizeOf(slot)
            detail.firstZeroValueSlotOffset = slot.stackOffset
    detail.firstZeroSlotDiag = Fmt"target={detail.firstZeroTargetSlotName}:target_type={detail.firstZeroTargetSlotType}:target_size={detail.firstZeroTargetSlotSize}:target_offset={detail.firstZeroTargetSlotOffset}:base={detail.firstZeroBaseSlotName}:base_type={detail.firstZeroBaseSlotType}:base_size={detail.firstZeroBaseSlotSize}:base_offset={detail.firstZeroBaseSlotOffset}:value={detail.firstZeroValueSlotName}:value_type={detail.firstZeroValueSlotType}:value_size={detail.firstZeroValueSlotSize}:value_offset={detail.firstZeroValueSlotOffset}"

@borrows
fn PrimaryObjectPlanCaptureBodyIrWordDetail(detail: var PrimaryObjectErrorBodyIrDetail,
                                             bodyIR: coreir.BodyIR,
                                             relWordOffset: int32) =
    detail.firstZeroBlockIndex = -1
    detail.firstZeroWordInnerOffset = -1
    if relWordOffset < 0:
        return
    let prologueCount = PrimaryBodyIrPrologueWordCount(bodyIR)
    if relWordOffset < prologueCount:
        detail.firstZeroOpIndex = -2
        detail.firstZeroOpKind = -2
        detail.firstZeroWordInnerOffset = relWordOffset
        return
    var cursor = prologueCount
    for bi in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[bi]
        var opStart = block.opStart
        if opStart < 0:
            opStart = 0
        var opEnd = block.opStart + block.opCount
        if opEnd > bodyIR.ops.len:
            opEnd = bodyIR.ops.len
        for oi in opStart..<opEnd:
            let opSize = PrimaryBodyIROpSizeAt(bodyIR, oi)
            if opSize <= 0:
                continue
            if relWordOffset >= cursor && relWordOffset < cursor + opSize:
                detail.firstZeroBlockIndex = bi
                detail.firstZeroWordInnerOffset = relWordOffset - cursor
                PrimaryObjectPlanCaptureBodyIrOpDetail(detail, bodyIR, oi)
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    var dumpStart = oi - 3
                    if dumpStart < 0:
                        dumpStart = 0
                    var dumpEnd = oi + 4
                    if dumpEnd > bodyIR.ops.len:
                        dumpEnd = bodyIR.ops.len
                    for di in dumpStart..<dumpEnd:
                        let dOp = bodyIR.ops[di]
                        var dTargetName = ""
                        if dOp.target >= 0 && dOp.target < bodyIR.localSlots.len:
                            dTargetName = bodyIR.localSlots[dOp.target].name
                        var dOperandsText = ""
                        for di2 in 0..<dOp.operands.len:
                            dOperandsText = Fmt"{dOperandsText},{strings.IntToStr(dOp.operands[di2])}"
                        os.WriteLine(os.GetStderr(),
                                     Fmt"phase=body_ir_zero_ctx op={di} kind={dOp.kind} target={dOp.target} target_name={dTargetName} operands={dOperandsText} is_zero_op={di == oi}")
                return
            cursor = cursor + opSize
        let termSize = PrimaryBodyIRTermSize(bodyIR, block.termIndex)
        if termSize > 0:
            if relWordOffset >= cursor && relWordOffset < cursor + termSize:
                detail.firstZeroBlockIndex = bi
                detail.firstZeroTermIndex = block.termIndex
                detail.firstZeroWordInnerOffset = relWordOffset - cursor
                if block.termIndex >= 0 && block.termIndex < bodyIR.terms.len:
                    detail.firstZeroTermKind = bodyIR.terms[block.termIndex].kind
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        let zeroTerm = bodyIR.terms[block.termIndex]
                        os.WriteLine(os.GetStderr(),
                                     Fmt"phase=body_ir_zero_term term_index={block.termIndex} kind={zeroTerm.kind} cond_kind={zeroTerm.conditionKind} lhs_slot={zeroTerm.lhsSlot} rhs_slot={zeroTerm.rhsSlot} result_slot={zeroTerm.resultSlot} true_block={zeroTerm.trueBlock} false_block={zeroTerm.falseBlock} inner_offset={relWordOffset - cursor} term_size={termSize}")
                        var zeroLhsSlot = zeroTerm.lhsSlot
                        if zeroLhsSlot < 0 || zeroTerm.kind == coreir.BodyTermReturnTag:
                            zeroLhsSlot = zeroTerm.resultSlot
                        if zeroLhsSlot >= 0 && zeroLhsSlot < bodyIR.localSlots.len:
                            let zeroSlot = bodyIR.localSlots[zeroLhsSlot]
                            os.WriteLine(os.GetStderr(),
                                         Fmt"phase=body_ir_zero_term_slot slot={zeroLhsSlot} name={zeroSlot.name} type_kind={zeroSlot.typeKind} stack_offset={zeroSlot.stackOffset} place_kind={zeroSlot.placeKind} is_param={PrimaryBodyIrLocalIsParam(zeroSlot)} frame_bytes={PrimaryBodyIrFrameBytes(bodyIR)}")
                return
            cursor = cursor + termSize
    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
        # zero word not located inside any op/term range: a size-0 op has
        # desynced the cursor — dump the whole op list for diagnosis
        os.WriteLine(os.GetStderr(),
                     Fmt"phase=body_ir_zero_unlocated rel_word={relWordOffset} cursor_end={cursor} ops={bodyIR.ops.len} terms={bodyIR.terms.len} blocks={bodyIR.blocks.len}")
        for di in 0..<bodyIR.ops.len:
            let dOp = bodyIR.ops[di]
            var dTargetName = ""
            if dOp.target >= 0 && dOp.target < bodyIR.localSlots.len:
                dTargetName = bodyIR.localSlots[dOp.target].name
            os.WriteLine(os.GetStderr(),
                         Fmt"phase=body_ir_zero_all_ops op={di} kind={dOp.kind} size={PrimaryBodyIROpSizeAt(bodyIR, di)} target={dOp.target} target_name={dTargetName} operand_count={dOp.operands.len}")

@borrows
fn PrimaryObjectPlanCaptureBodyIrDetails(detail: var PrimaryObjectErrorBodyIrDetail,
                                          bodyIR: coreir.BodyIR) =
    detail.opCount = bodyIR.ops.len
    detail.termCount = bodyIR.terms.len
    detail.blockCount = bodyIR.blocks.len
    detail.callCount = bodyIR.callSequence.len
    detail.slotCount = bodyIR.localSlots.len
    detail.frameBytes = PrimaryBodyIrFrameBytes(bodyIR)
    detail.prologueWordCount = PrimaryBodyIrPrologueWordCount(bodyIR)
    detail.paramSaveCount = PrimaryBodyIrParamSaveCount(bodyIR)
    detail.paramSaveOffset = PrimaryBodyIrParamSaveOffset(bodyIR)
    detail.returnBufferSaveOffset = PrimaryBodyIrReturnBufferSaveOffset(bodyIR)
    # Diagnostic-only encode: must never panic. Large frames materialize the
    # save base into a register at emission time, so the direct STR form does
    # not apply here — record 0 when the offset overflows the immediate.
    if PrimaryBodyIrStackAccessImmFits(detail.returnBufferSaveOffset, 8):
        detail.returnBufferStoreWord = a64units.CodegenA64EncStrImmValue(true,
                                                             a64units.CodegenA64X8,
                                                             a64units.CodegenA64SP,
                                                             detail.returnBufferSaveOffset)
    else:
        detail.returnBufferStoreWord = 0
    detail.firstZeroOpIndex = -1
    detail.firstZeroTermIndex = -1
    detail.firstZeroBlockIndex = -1
    detail.firstZeroWordInnerOffset = -1
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        if op.kind != coreir.BodyOpInvalidTag &&
           PrimaryBodyIROpSizeAt(bodyIR, opIndex) > 0:
            continue
        PrimaryObjectPlanCaptureBodyIrOpDetail(detail, bodyIR, opIndex)
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(),
                         strutil.Join(["phase=body_ir_zero_op op_index=",
                                       strings.IntToStr(opIndex),
                                       " kind=",
                                       strings.IntToStr(detail.firstZeroOpKind),
                                       " target=",
                                       strings.IntToStr(detail.firstZeroOpTarget),
                                       " operand0=",
                                       strings.IntToStr(detail.firstZeroOpOperand0),
                                       " operand1=",
                                       strings.IntToStr(detail.firstZeroOpOperand1),
                                       " operand2=",
                                       strings.IntToStr(detail.firstZeroOpOperand2),
                                       " operand3=",
                                       strings.IntToStr(detail.firstZeroOpOperand3)], ""))
        break
    for termIndex in 0..<bodyIR.terms.len:
        if PrimaryBodyIRTermSize(bodyIR, termIndex) > 0:
            continue
        let term = bodyIR.terms[termIndex]
        detail.firstZeroTermIndex = termIndex
        detail.firstZeroTermKind = term.kind
        break
    if bodyIR.terms.len > 0:
        let term = bodyIR.terms[bodyIR.terms.len - 1]
        detail.lastTermKind = term.kind
        detail.lastTermResultSlot = term.resultSlot
        if term.operands.len > 0:
            detail.lastTermOperand0 = term.operands[0]
        if term.resultSlot >= 0 && term.resultSlot < bodyIR.localSlots.len:
            detail.lastTermResultType = bodyIR.localSlots[term.resultSlot].typeKind
    if bodyIR.callSequence.len > 0:
        let call = bodyIR.callSequence[bodyIR.callSequence.len - 1]
        detail.lastCallTarget = call.targetSymbol
        detail.lastCallResultSlot = call.resultSlot
        if call.resultSlot >= 0 && call.resultSlot < bodyIR.localSlots.len:
            detail.lastCallResultType = bodyIR.localSlots[call.resultSlot].typeKind

@borrows
fn PrimaryPathSuffixMatch(left: str,
                            right: str): bool =
    if PrimaryPathNormalizedEquals(left, right):
        return true
    var li = left.len - 1
    var ri = right.len - 1
    while li >= 0 && ri >= 0:
        if left[li] != right[ri]:
            break
        li = li - 1
        ri = ri - 1
    if ri < 0:
        if li < 0 || left[li] == '/' || left[li] == '\\':
            return true
    if li < 0:
        if ri < 0 || right[ri] == '/' || right[ri] == '\\':
            return true
    return false

fn PrimaryTypedIrFunctionIndex(ir: var texpr.TypedExprIr,
                                sourcePath: str,
                                functionName: str): int32 =
    let tailName = PrimaryFunctionTailName(functionName)
    let typedFunctionCount = ir.functions2_functionNameIds.len
    for i in 0..<typedFunctionCount:
        let srcRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.functions2_sourcePathIds[i])
        if !IsOk(srcRes):
            continue
        if !PrimaryPathNormalizedEquals(Value(srcRes), sourcePath):
            continue
        let fnNameRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.functions2_functionNameIds[i])
        if !IsOk(fnNameRes):
            continue
        let fnName = Value(fnNameRes)
        if fnName == functionName || fnName == tailName:
            return i
    for i in 0..<typedFunctionCount:
        let srcRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.functions2_sourcePathIds[i])
        if !IsOk(srcRes):
            continue
        if !PrimaryPathSuffixMatch(Value(srcRes), sourcePath):
            continue
        let fnNameRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.functions2_functionNameIds[i])
        if !IsOk(fnNameRes):
            continue
        let fnName = Value(fnNameRes)
        if fnName == functionName || fnName == tailName:
            return i
    var foundIndex: int32
    foundIndex = -1
    for i in 0..<typedFunctionCount:
        let fnNameRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.functions2_functionNameIds[i])
        if !IsOk(fnNameRes):
            continue
        let fnName = Value(fnNameRes)
        if fnName == functionName || fnName == tailName:
            if foundIndex >= 0:
                return -1
            foundIndex = i
    return foundIndex

fn PrimaryObjectMissingTypedIrKind(lowering: var lower.LoweringPlanStub,
                                    irIndex: int32): str =
    if irIndex < 0 || irIndex >= lowering.primaryObjectIr.functions.len:
        return ""
    let irFunction = lowering.primaryObjectIr.functions[irIndex]
    if irFunction.bodyKind != texpr.BodyKindUnsupported:
        return ""
    for stmtIndex in 0..<irFunction.statements.len:
        let stmt = irFunction.statements[stmtIndex]
        if stmt.kind == texpr.TypedExprIrStmtLetCall:
            return "stmt_let_call"
        if stmt.kind == texpr.TypedExprIrStmtIfCall:
            return "stmt_if_call"
        if stmt.kind == texpr.TypedExprIrStmtCall:
            return "stmt_call"
        if stmt.kind == texpr.TypedExprIrStmtAssign:
            return "stmt_assign"
    return ""

@borrows
fn PrimaryBodyIrEGraphSnapshotText(bodyIR: coreir.BodyIR): str =
    var rows: str[]
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        let count = op.operands.len
        var op0: int32
        var op1: int32
        var op2: int32
        var op3: int32
        var op4: int32
        var op5: int32
        var op6: int32
        var op7: int32
        if count >= 1:
            op0 = op.operands[0]
        if count >= 2:
            op1 = op.operands[1]
        if count >= 3:
            op2 = op.operands[2]
        if count >= 4:
            op3 = op.operands[3]
        if count >= 5:
            op4 = op.operands[4]
        if count >= 6:
            op5 = op.operands[5]
        if count >= 7:
            op6 = op.operands[6]
        if count >= 8:
            op7 = op.operands[7]
        add(rows, Fmt"{op.kind},{op.target},{count},{op0},{op1},{op2},{op3},{op4},{op5},{op6},{op7};")
    return strutil.Join(rows, "")

@borrows
fn PrimaryBodyIrHasEGraphCandidate(bodyIR: coreir.BodyIR): bool =
    if bodyIR.blocks.len > 0 || bodyIR.terms.len > 0:
        return false
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        if op.kind == coreir.BodyOpBinOpTag:
            if op.operands.len >= 4 && op.operands[0] == coreir.LocalI32Tag:
                let kind = op.operands[1]
                if kind == int32(texpr.TypedExprIrOpI32Add) ||
                   kind == int32(texpr.TypedExprIrOpI32Sub) ||
                   kind == int32(texpr.TypedExprIrOpI32Mul):
                    return true
        elif op.kind == coreir.BodyOpCmpTag:
            if op.operands.len >= 3:
                let cond = op.operands[0]
                if cond >= coreir.BodyCondI32EqTag && cond <= coreir.BodyCondI32GeTag:
                    return true
    return false

@borrows
fn PrimaryBodyIrHasNoAliasSurface(bodyIR: coreir.BodyIR): bool =
    if bodyIR.localSlots.len > 0:
        return true
    if bodyIR.callSequence.len > 0:
        return true
    if bodyIR.blocks.len > 0:
        return true
    if bodyIR.terms.len > 0:
        return true
    return false

@borrows
fn PrimaryBodyIrHotPathCapturePhaseArena(bodyIR: coreir.BodyIR,
                                          report: var PrimaryBodyIrHotPathReport) =
    if os.GetEnv("CHENG_PRIMARY_BODYIR_PHASE_ARENA_REPORT") != "1":
        return
    var arena = coreir.BodyIRPhaseArenaNew()
    let flat = coreir.BodyIRPhaseArenaBuildFlatSoA(arena, bodyIR)
    report.phaseArenaResetCount = report.phaseArenaResetCount + arena.resetCount
    report.phaseArenaReserveCount = report.phaseArenaReserveCount + arena.reserveCount
    if arena.capacityBytes > report.phaseArenaCapacityBytes:
        report.phaseArenaCapacityBytes = arena.capacityBytes
    if arena.usedBytes > report.phaseArenaUsedBytes:
        report.phaseArenaUsedBytes = arena.usedBytes
    if arena.peakBytes > report.phaseArenaPeakBytes:
        report.phaseArenaPeakBytes = arena.peakBytes
    report.phaseArenaSpillCount = report.phaseArenaSpillCount + arena.spillCount
    let _ = flat

fn PrimaryBodyIrHotPathApply(bodyIR: var coreir.BodyIR): PrimaryBodyIrHotPathReport =
    var report: PrimaryBodyIrHotPathReport
    var eGraphResult: egraph.EGraphPassResult
    if PrimaryBodyIrHasEGraphCandidate(bodyIR):
        let eGraphSnapshotText = PrimaryBodyIrEGraphSnapshotText(bodyIR)
        eGraphResult = egraph.BodyIrEgraphPassWithSnapshotTextResult(bodyIR,
                                                                     eGraphSnapshotText)
    else:
        eGraphResult.skipped = true
        eGraphResult.blockedReason = "no_egraph_candidate_ops"
    report.eGraphApplied = eGraphResult.applied
    report.eGraphSkipped = eGraphResult.skipped
    report.eGraphHardFail = eGraphResult.hardFail
    report.eGraphBlockCount = eGraphResult.blockCount
    report.eGraphCandidateBlockCount = eGraphResult.candidateBlockCount
    report.eGraphChangedBlockCount = eGraphResult.changedBlockCount
    report.eGraphSkippedBlockCount = eGraphResult.skippedBlockCount
    report.eGraphUnsafeOpCount = eGraphResult.unsafeOpCount
    report.eGraphClassCount = eGraphResult.egraphClasses
    report.eGraphRoundCount = eGraphResult.rewriteRounds
    report.eGraphRuleHitCount = eGraphResult.ruleHits
    report.eGraphExtractedCount = eGraphResult.extracted
    report.eGraphOpDelta = eGraphResult.opDelta
    report.eGraphMs = eGraphResult.egraphMs
    report.eGraphReason = eGraphResult.blockedReason
    if bodyIR.blocks.len > 0 || bodyIR.terms.len > 0:
        PrimaryBodyIRMoveInto(report.bodyIR, bodyIR)
        report.noAliasDodSoAContractOk = true
        PrimaryBodyIrHotPathCapturePhaseArena(report.bodyIR, report)
        return report
    if !PrimaryBodyIrHasNoAliasSurface(bodyIR):
        PrimaryBodyIRMoveInto(report.bodyIR, bodyIR)
        report.noAliasDodSoAContractOk = true
        PrimaryBodyIrHotPathCapturePhaseArena(report.bodyIR, report)
        return report
    var finalizeBodyIR: coreir.BodyIR
    PrimaryBodyIRMoveInto(finalizeBodyIR, bodyIR)
    let noAliasReport = noalias.BodyIrNoAliasFinalize(finalizeBodyIR)
    report.bodyIR = noAliasReport.bodyIR
    report.noAliasApplied = noAliasReport.applied
    report.noAliasLocalCount = noAliasReport.localCount
    report.noAliasForwardRewriteCount = noAliasReport.forwardRewriteCount
    report.noAliasDodSoAContractOk = noAliasReport.dodSoAContractOk
    PrimaryBodyIrHotPathCapturePhaseArena(report.bodyIR, report)
    return report

@borrows
fn PrimaryObjectPlanCloneI32Array(values: int32[]): int32[] =
    var out: int32[]
    for i in 0..<values.len:
        add(out, values[i])
    return out

@borrows
fn PrimaryObjectPlanCloneBoolArray(values: bool[]): bool[] =
    var out: bool[]
    for i in 0..<values.len:
        add(out, values[i])
    return out

@borrows
fn PrimaryObjectPlanCloneStrArray(values: str[]): str[] =
    var out: str[]
    for i in 0..<values.len:
        add(out, strings.CloneStr(values[i]))
    return out

@borrows
# C5 lazy 写回铁律: `lowering.primaryObjectIr.functions[irIndex] = row` 这种
# 三组件嵌套路径写在冷编码器下静默丢失 (元素级写与元素级 var 实参同样丢, 实测
# 夹具证实; 经 var 参数拆成两级的写正常)。所以对 primaryObjectIr 行的一切持久
# 化必须经本 helper (ir 作为 var 参数, 内部两组件写)。丢写正是 lazy 骨架重建
# "重载坍缩" 假 missing_call_target 的直接根因: 重建行 callTargets 永远空 →
# reachability 走 body-IR callSequence 的 by-name 正向扫描 (取首个重载行) 而
# BuildItems 的 ResolveCallTargetIndex 走桶索引 (头插逆序, 取末个重载行) → 两
# 解析器对同名重载取不同行 → 标记的行 ≠ 需要的行 → missing_call_target。
fn PrimaryObjectIrStorePlanFunction(ir: var lower.PrimaryObjectIr,
                                     index: int32,
                                     row: lower.PrimaryObjectIrFunction) =
    if index < 0 || index >= ir.functions.len:
        return
    ir.functions[index] = row

# object_all_lazy: Begin 快照只含骨架 paramNames/paramTypes。BuildOneFunctionInto
# 在 Begin 之后长出 statements/callTargets/defer/ownership。FillAndCheck 重放本
# 释放时 reachability 与 BuildItems 已结束,必须按账本丢掉这些后长列,否则
# AfterPrimary Record 会把它们算进 released,或 statements=[] 不走账本少记
# Begin 里的 buffer。paramNames/paramTypes 留在骨架上,由 terminal shape release 收。
fn PrimaryObjectPlanReleaseLazyFunctionStatements(ir: var lower.PrimaryObjectIr,
                                                   index: int32) =
    lower.LoweringPrimaryObjectIrReleaseLazyConsumedFunctionPayload(ir, index)

@borrows
fn PrimaryBodyIrApplyEntryAbiProvenance(bodyIR: var coreir.BodyIR,
                                         functionExportedFlags: int32[],
                                         functionIndex: int32): bool =
    if functionIndex < 0 || functionIndex >= functionExportedFlags.len:
        return false
    bodyIR.entryIsCAbi = functionExportedFlags[functionIndex] != 0
    return true

var primaryExactDefContractCacheReady: bool
var primaryExactDefContractCache: exactdef.ExactProgramContract

# [wall103] data relocation identity 生产臂 owner cid 的 typed 指纹对等物
# （funcLowerCid 6-tuple 第 3 元入参）。backend2 侧对等物
# backend2SkipLowerTypedFingerprint 为 backend2_pipeline 私有，且
# backend2_pipeline import 本模块（pobj），反向 import 成环不可达——按
# w99 移交同一契约自定：typed 级（源自 PrimaryObjectIr typed statement
# 切片，非 BodyIR 内容，绑定后无自指循环）、含体（逐 statement 语义列）、
# 决定性（纯文本/int LE append + sha256，复用本文件既有
# primaryObjectSymbolIdentityAppend{U32,Text} 配方）、版本敏感（函数名/
# 签名/调用边/结果类型任一变化即变）。字节配方绝不二次实现 funcLowerCid
# 的 6-tuple append——owner cid 本体只经 b2cid.Backend2FuncLowerCidFixed32
# 唯一出口产出。
@borrows
fn PrimaryBodyIrOwnerTypedFingerprint(
        lowering: var lower.LoweringPlanStub,
        irFunction: var lower.PrimaryObjectIrFunction,
        typedFnIndex: int32,
        entryIsCAbi: bool): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(1024)
    primaryObjectSymbolIdentityAppendText(
        buf, "cheng.primary.funclower.owner_typedfp.v1")
    primaryObjectSymbolIdentityAppendU32(buf, int32(entryIsCAbi))
    primaryObjectSymbolIdentityAppendText(buf, irFunction.functionName)
    primaryObjectSymbolIdentityAppendText(buf, irFunction.bodyKind)
    primaryObjectSymbolIdentityAppendText(buf, irFunction.sourcePath)
    primaryObjectSymbolIdentityAppendU32(buf, irFunction.paramTypes.len)
    for ownerParamIndex in 0..<irFunction.paramTypes.len:
        primaryObjectSymbolIdentityAppendText(
            buf, irFunction.paramTypes[ownerParamIndex])
    primaryObjectSymbolIdentityAppendU32(buf, irFunction.paramNames.len)
    for ownerParamIndex in 0..<irFunction.paramNames.len:
        primaryObjectSymbolIdentityAppendText(
            buf, irFunction.paramNames[ownerParamIndex])
    if typedFnIndex >= 0 &&
           typedFnIndex < lowering.typedIr.functions2_returnTypeIds.len:
        let ownerRtRes: Result[str] = langintern.LookupIntern(
            lowering.typedIr.internPool,
            lowering.typedIr.functions2_returnTypeIds[typedFnIndex])
        if IsOk(ownerRtRes):
            primaryObjectSymbolIdentityAppendText(buf, Value(ownerRtRes))
    primaryObjectSymbolIdentityAppendU32(buf, irFunction.statements.len)
    for ownerStmtIndex in 0..<irFunction.statements.len:
        primaryObjectSymbolIdentityAppendU32(
            buf, irFunction.statements[ownerStmtIndex].statementIndex)
        primaryObjectSymbolIdentityAppendU32(
            buf,
            Int32(irFunction.statements[ownerStmtIndex].kind))
        primaryObjectSymbolIdentityAppendText(
            buf, irFunction.statements[ownerStmtIndex].bindingName)
        primaryObjectSymbolIdentityAppendText(
            buf, irFunction.statements[ownerStmtIndex].resultType)
        primaryObjectSymbolIdentityAppendText(
            buf, irFunction.statements[ownerStmtIndex].surfaceText)
        primaryObjectSymbolIdentityAppendText(
            buf, irFunction.statements[ownerStmtIndex].callCallee)
        primaryObjectSymbolIdentityAppendText(
            buf, irFunction.statements[ownerStmtIndex].callTarget)
    let ownerDigest = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return ownerDigest

# [bodyir-ownership-wall] 元素写回读（判别读数，只读）：整行 LocalSlot 元素写之后回读身份。
# 覆盖范围 = 本文件**窗口内**（T1 `primarySlotIdentityTripwire(bodyIR,"post_build")`，基线 `:66214`）
# 之前的全部 typed 写点：W1 `:4411` retype / W2 `:5658` FindOrCreate 更新 / W3 `:5710` Sized 更新 /
# W4 `:5899` retire 改名 / W5 `:44754` 日志回滚恢复。窗口外各点（`PrimaryBodyIRMoveInto` `:62303`
# 与 `body_ir_noalias.cheng:312/:460-466`、`bodyIR = hotPathReport.bodyIR` `:66331`、池化 `:70342`）
# **已被 T1 的时序排除**（它们全部在 T1 之后才执行）——勿再重走该排查路径。
# 健康编译恒不触发（id==index 是槽表不变量）；panic 只在已经坏掉时执行，不写任何 body 字段。
@borrows
fn primarySlotElementWriteBackCheck(bodyIR: coreir.BodyIR,
                                    slotIndex: int32,
                                    site: str,
                                    siteLine: int32) =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        panic(Fmt"primary slot element write index invalid site={site} site_line={siteLine} index={slotIndex} len={bodyIR.localSlots.len} cap={bodyIR.localSlots.cap}")
    if bodyIR.localSlots[slotIndex].id != slotIndex:
        panic(Fmt"primary slot element write lost site={site} site_line={siteLine} index={slotIndex} id={bodyIR.localSlots[slotIndex].id} tk={Int32(bodyIR.localSlots[slotIndex].typeKind)} name={bodyIR.localSlots[slotIndex].name} len={bodyIR.localSlots.len} cap={bodyIR.localSlots.cap}")

# [bodyir-ownership-wall] 阶段探针（判别读数，只读）：在语句 3 求值路径各阶段入口扫全表身份，
# 输出**该阶段结束时全部坏行的完整列表**（bad=计数[i:id@tk,name]×≤8）+ len/cap + 阶段名 + 基线行号。
# 与 stmt_begin_k（循环顶，语句级包夹）配合：首个命中的探针即"坏点在其之前"的那个阶段。
# 预登记判读（owner 认可，原文照录，不许事后解释）：
#   1) S1 `field_assign_enter` 首个命中 ⇒ 坏点在语句 3 的 RHS 求值**之前** ⇒ 转"语句 2 收尾→语句 3 入场"，
#      **不回语句 3 内部**；
#   2) S2/S3 `scalar_text*`、S4 `cond_field`、S5 `eval_node`、S6/S7 `find_or_create*` 首个命中 ⇒
#      按"上一个干净探针"包夹点名写者；进入干净而其后的第一个探针坏 ⇒ 直接查该函数内部（元素写/更新分支）；
#   3) 语句 3 内所有探针都干净、而 `stmt_begin_4` 仍报坏 ⇒ 写点在**语句循环收尾**（`stmt_end_k` 与
#      `stmt_begin_{k+1}` 之间），立刻转那里，**不许回到语句 3**；
#   4) 坏行列表形态：`[4][10]` 同时出现 ⇒ 一条指令一次扫过两处；先 `[4]` 后 `[4][10]` ⇒ 两处先后中招。
# 覆盖的"按字节区间写"候选：③ `setMem(CallArgSlotAddress(targetSlot),0,size)`（本文件 :17897-17938）、
#   ④ 聚合 FieldStore 宽拷贝、⑤ 堆分配复用清零（wall69 族）；①扩容尾部清零 ②realloc 搬迁已由 R4a 实测排除。
# 健康编译恒不触发（id==index 是槽表不变量）；panic 只在已坏时执行，不写任何 body 字段。
@borrows
fn primarySlotStageTrailPush(stage: str) =
    if !primarySlotStageTrailInitialized:
        primarySlotStageTrail = ""
        primarySlotStageTrailInitialized = true
    if len(primarySlotStageTrail) < 768:
        primarySlotStageTrail = Fmt"{primarySlotStageTrail}>{stage}"

@borrows
fn primarySlotStageProbe(bodyIR: coreir.BodyIR,
                         stage: str,
                         stageLine: int32) =
    if !primarySlotStageTrailInitialized:
        primarySlotStageTrail = ""
        primarySlotStageTrailInitialized = true
    let primaryStageTrailBefore = primarySlotStageTrail
    primarySlotStageTrailPush(Fmt"{stage}@{stageLine}/ops{bodyIR.ops.len}")
    var primaryStageBadCount: int32
    var primaryStageBadList = ""
    for primaryStageIndex in 0..<bodyIR.localSlots.len:
        if bodyIR.localSlots[primaryStageIndex].id != primaryStageIndex:
            primaryStageBadCount = primaryStageBadCount + 1
            if primaryStageBadCount <= 8:
                primaryStageBadList = Fmt"{primaryStageBadList} [{primaryStageIndex}:id={bodyIR.localSlots[primaryStageIndex].id},tk={Int32(bodyIR.localSlots[primaryStageIndex].typeKind)},name={bodyIR.localSlots[primaryStageIndex].name}]"
    if primaryStageBadCount > 0:
        panic(Fmt"primary slot stage corruption stage={stage} stage_line={stageLine} bad={primaryStageBadCount}{primaryStageBadList} len={bodyIR.localSlots.len} cap={bodyIR.localSlots.cap} trail={primaryStageTrailBefore}")

# [bodyir-ownership-wall] 槽身份行程探针（判别读数，只读）：扫 localSlots 找 id != index
# 的行（整行全零即此形），命中即 hard-fail 并报 stage/index/id/tk/name/len/cap。
# 健康 body 恒不触发；用于把"行何时被清零"按管线阶段二分（build 内 vs build 后）。
@borrows
fn primarySlotIdentityTripwire(bodyIR: coreir.BodyIR,
                               stage: str) =
    if !primarySlotStageTrailInitialized:
        primarySlotStageTrail = ""
        primarySlotStageTrailInitialized = true
    let primaryTripwireTrailBefore = primarySlotStageTrail
    primarySlotStageTrailPush(Fmt"{stage}/ops{bodyIR.ops.len}")
    var primaryTripwireBadCount: int32
    var primaryTripwireBadList = ""
    for primaryTripwireIndex in 0..<bodyIR.localSlots.len:
        if bodyIR.localSlots[primaryTripwireIndex].id != primaryTripwireIndex:
            primaryTripwireBadCount = primaryTripwireBadCount + 1
            if primaryTripwireBadCount <= 8:
                primaryTripwireBadList = Fmt"{primaryTripwireBadList} [{primaryTripwireIndex}:id={bodyIR.localSlots[primaryTripwireIndex].id},tk={Int32(bodyIR.localSlots[primaryTripwireIndex].typeKind)},name={bodyIR.localSlots[primaryTripwireIndex].name}]"
    if primaryTripwireBadCount > 0:
        panic(Fmt"primary slot identity lost stage={stage} bad={primaryTripwireBadCount}{primaryTripwireBadList} len={bodyIR.localSlots.len} cap={bodyIR.localSlots.cap} trail={primaryTripwireTrailBefore}")

@borrows
fn PrimaryBuildBodyIrForFunction(state: var PrimaryObjectPlanPhaseState,
                                   lowering: var lower.LoweringPlanStub,
                                   i: int32,
                                   targetTriple: str) =
    if i < 0 || i >= state.irIndexes.len:
        return
    let irIndex = state.irIndexes[i]
    if irIndex < 0 || irIndex >= lowering.primaryObjectIr.functions.len:
        return
    var activeIrFunction = lowering.primaryObjectIr.functions[irIndex]
    if PrimaryObjectPlanPrimaryIrFunctionNeedsLazyMaterialization(activeIrFunction):
        var sourceTexts: texpr.TypedExprSourceText[]
        var rebuilt: lower.PrimaryObjectIrFunction
        lower.LoweringBuildOneFunctionInto(lowering,
                                           sourceTexts,
                                           i,
                                           texpr.BodyKindLetCallReturnI32ConstPrefixLen,
                                           rebuilt)
        if len(rebuilt.functionName) > 0:
            lower.LoweringCopyPrimaryObjectIrFunctionInto(rebuilt, activeIrFunction)
    let traceEnabled = PrimaryObjectPlanTraceActive()
    if traceEnabled:
        PrimaryObjectPlanTrace(Fmt"primary_body_ir_enter index={i} ir_index={irIndex} name={activeIrFunction.functionName}")
    var buildBodyIR: bool
    if activeIrFunction.bodyKind == texpr.BodyKindUnsupported:
        buildBodyIR = true
    elif activeIrFunction.bodyKind == texpr.BodyKindStatementSequence:
        buildBodyIR = true
    elif state.wordCounts[i] <= 0:
        buildBodyIR = true
    if !buildBodyIR:
        buildBodyIR = PrimaryStatementSequenceReturnMode(activeIrFunction.bodyKind) != PrimaryStatementReturnModeNone()
    if traceEnabled:
        PrimaryObjectPlanTrace(Fmt"primary_body_ir_after_decision index={i} build={buildBodyIR}")
    if buildBodyIR:
        let typedFnIndex = activeIrFunction.typedFunctionIndex
        var typedFnHasVoidReturn: bool
        if typedFnIndex >= 0 && typedFnIndex < lowering.typedIr.functions2_functionNameIds.len:
            let bbfRtRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.functions2_returnTypeIds[typedFnIndex])
            if IsOk(bbfRtRes):
                typedFnHasVoidReturn = PrimaryBodyIrReturnTypeIsVoid(Value(bbfRtRes))
        var hasBodyIrInput: bool
        if activeIrFunction.statements.len > 0:
            hasBodyIrInput = true
        elif activeIrFunction.bodyKind == texpr.BodyKindUnsupported:
            hasBodyIrInput = true
        elif activeIrFunction.bodyKind == texpr.BodyKindStatementSequence:
            hasBodyIrInput = true
        elif typedFnHasVoidReturn:
            hasBodyIrInput = true
        if hasBodyIrInput:
            if typedFnIndex >= 0 && typedFnIndex < lowering.typedIr.functions2_functionNameIds.len:
                if traceEnabled:
                    PrimaryObjectPlanTrace(Fmt"primary_body_ir_before_build index={i} typed_index={typedFnIndex}")
                var irFunctionForBodyIR = activeIrFunction
                var seqAddCandidateCount: int32
                var seqAddTypedContractCount: int32
                var structuredSeqAddConsumeCount: int32
                var seqAddNodeProbeHitCount: int32
                var seqAddTypeMismatchCount: int32
                var seqAddLegacyTextConsumeCount: int32
                var seqAddNodeEvalGapCount: int32
                var structuredResultIntrinsicConsumeCount: int32
                var bodyIR = PrimaryBuildBodyIrFromTypedStatements(lowering,
                                                                   typedFnIndex,
                                                                   irFunctionForBodyIR,
                                                                   seqAddCandidateCount,
                                                                   seqAddTypedContractCount,
                                                                   structuredSeqAddConsumeCount,
                                                                   seqAddNodeProbeHitCount,
                                                                   seqAddTypeMismatchCount,
                                                                   seqAddLegacyTextConsumeCount,
                                                                   seqAddNodeEvalGapCount,
                                                                   structuredResultIntrinsicConsumeCount)
                primarySlotIdentityTripwire(bodyIR, "post_build")
                if !PrimaryBodyIrApplyEntryAbiProvenance(bodyIR,
                                                         lowering.functionExportedFlags,
                                                         i):
                    panic("primary body ir entry ABI provenance missing")
                state.seqAddCandidateCountPerIndex[i] = seqAddCandidateCount
                state.seqAddTypedContractCountPerIndex[i] = seqAddTypedContractCount
                state.structuredSeqAddConsumeCountPerIndex[i] = structuredSeqAddConsumeCount
                state.seqAddNodeProbeHitCountPerIndex[i] = seqAddNodeProbeHitCount
                state.seqAddTypeMismatchCountPerIndex[i] = seqAddTypeMismatchCount
                state.seqAddLegacyTextConsumeCountPerIndex[i] = seqAddLegacyTextConsumeCount
                state.seqAddNodeEvalGapCountPerIndex[i] = seqAddNodeEvalGapCount
                state.structuredResultIntrinsicConsumeCountPerIndex[i] = structuredResultIntrinsicConsumeCount
                # Do not StorePlanFunction a shallow copy of the IR row here.
                # `functions[index] = copy` unique-frees dest seqs (Begin
                # paramNames/paramTypes) then reinstalls the copy's dangling
                # fat pointers, dropping shapeBuf 2→0 and leaving lifecycle
                # 2 buffers/192B unrecorded. Call-target extras stay on the
                # local irFunctionForBodyIR that PatchCallTargetSymbols reads.
                # Final layout pass: scalars first, wide slots last, so the
                # single-instruction scaled-imm slot accesses stay in range
                # even when big aggregates inflate the frame (slots created
                # after the last incremental reflow would otherwise trail
                # the aggregates at large offsets).
                PrimaryBodyIrReflowLocalStackOffsets(bodyIR)
                if PrimaryObjectPlanLowerRssEnabled():
                    os.WriteLine(os.GetStderr(), Fmt"lower_rss_step step=from_typed index={i} rss={os.ProcessRssBytes()}")
                if traceEnabled:
                    PrimaryObjectPlanTrace(Fmt"primary_body_ir_after_build index={i} ops={bodyIR.ops.len}")
                    PrimaryBodyIrTraceCallSequence("primary_body_ir_calls_after_build",
                                                   irFunctionForBodyIR.functionName,
                                                   bodyIR)
                PrimaryBodyIrPatchCallTargetSymbols(bodyIR,
                                                    irFunctionForBodyIR.callTargets,
                                                    irFunctionForBodyIR.callImportcSymbols)
                if traceEnabled:
                    PrimaryObjectPlanTrace(Fmt"primary_body_ir_after_patch index={i}")
                    PrimaryBodyIrTraceCallSequence("primary_body_ir_calls_after_patch",
                                                   irFunctionForBodyIR.functionName,
                                                   bodyIR)
                # Stream reachability discovery only needs callSequence + localSlots
                # (MarkBodyIrAddressSlots / ExpandIrCallTargets). Full ORC/hotpath/
                # scope-exit run again in BuildItems — skipping them
                # here removes a full second expensive pass over every reachable fn
                # without changing emit-path semantics (discovery tempBodyIRs are
                # cleared before BuildItems; bodyIrLowered is reset too).
                if state.streamReachabilityDiscovery:
                    if traceEnabled:
                        PrimaryObjectPlanTrace(Fmt"primary_body_ir_discovery_light index={i} ops={bodyIR.ops.len} calls={bodyIR.callSequence.len}")
                    if bodyIR.blocks.len > 0 && bodyIR.terms.len > 0:
                        state.tempBodyIRs[i] = bodyIR
                        state.bodyIrLowered[i] = true
                    return
                let orcElidedCount = PrimaryBodyIrElideOrcRetainReleasePairs(bodyIR,
                                                                             state.bodyIROrcDiagObserverPresent)
                if traceEnabled:
                    PrimaryObjectPlanTrace(Fmt"primary_body_ir_after_orc index={i} elided={orcElidedCount}")
                    PrimaryBodyIrTraceCallSequence("primary_body_ir_calls_after_orc",
                                                   irFunctionForBodyIR.functionName,
                                                   bodyIR)
                # F17 slice1: worker-local per-index staging (Cheng 后端并行 lowering
                # 准备) — 不再直接就地累加到 state 标量, 而是各自写入本 i 的槽位;
                # 整个 lowering 循环跑完后由 PrimaryObjectPlanReduceBodyIrPerIndexMetrics
                # 按原始 i 升序统一归约回 state 标量(串行路径与旧就地累加逐字节等价)。
                state.bodyIROrcRetainReleasePairElidedCountPerIndex[i] = state.bodyIROrcRetainReleasePairElidedCountPerIndex[i] + orcElidedCount
                if PrimaryObjectPlanLowerRssEnabled():
                    os.WriteLine(os.GetStderr(), Fmt"lower_rss_step step=after_orc index={i} rss={os.ProcessRssBytes()}")
                let hotPathReport = PrimaryBodyIrHotPathApply(bodyIR)
                if PrimaryObjectPlanLowerRssEnabled():
                    os.WriteLine(os.GetStderr(), Fmt"lower_rss_step step=after_hotpath index={i} rss={os.ProcessRssBytes()}")
                if traceEnabled:
                    PrimaryBodyIrTraceCallSequence("primary_body_ir_calls_after_hotpath",
                                                   irFunctionForBodyIR.functionName,
                                                   hotPathReport.bodyIR)
                state.bodyIRNoAliasFunctionCountPerIndex[i] = state.bodyIRNoAliasFunctionCountPerIndex[i] + 1
                if hotPathReport.noAliasApplied:
                    state.bodyIRNoAliasAppliedFunctionCountPerIndex[i] = state.bodyIRNoAliasAppliedFunctionCountPerIndex[i] + 1
                state.bodyIRNoAliasLocalCountPerIndex[i] = state.bodyIRNoAliasLocalCountPerIndex[i] + hotPathReport.noAliasLocalCount
                state.bodyIRNoAliasForwardRewriteCountPerIndex[i] = state.bodyIRNoAliasForwardRewriteCountPerIndex[i] + hotPathReport.noAliasForwardRewriteCount
                if !hotPathReport.noAliasDodSoAContractOk:
                    state.bodyIRNoAliasDodSoAContractOkPerIndex[i] = false
                state.bodyIRPhaseArenaResetCountPerIndex[i] = state.bodyIRPhaseArenaResetCountPerIndex[i] + hotPathReport.phaseArenaResetCount
                state.bodyIRPhaseArenaReserveCountPerIndex[i] = state.bodyIRPhaseArenaReserveCountPerIndex[i] + hotPathReport.phaseArenaReserveCount
                if hotPathReport.phaseArenaCapacityBytes > state.bodyIRPhaseArenaCapacityBytesPerIndex[i]:
                    state.bodyIRPhaseArenaCapacityBytesPerIndex[i] = hotPathReport.phaseArenaCapacityBytes
                if hotPathReport.phaseArenaUsedBytes > state.bodyIRPhaseArenaUsedBytesPerIndex[i]:
                    state.bodyIRPhaseArenaUsedBytesPerIndex[i] = hotPathReport.phaseArenaUsedBytes
                if hotPathReport.phaseArenaPeakBytes > state.bodyIRPhaseArenaPeakBytesPerIndex[i]:
                    state.bodyIRPhaseArenaPeakBytesPerIndex[i] = hotPathReport.phaseArenaPeakBytes
                state.bodyIRPhaseArenaSpillCountPerIndex[i] = state.bodyIRPhaseArenaSpillCountPerIndex[i] + hotPathReport.phaseArenaSpillCount
                state.bodyIREGraphFunctionCountPerIndex[i] = state.bodyIREGraphFunctionCountPerIndex[i] + 1
                if hotPathReport.eGraphApplied:
                    state.bodyIREGraphAppliedFunctionCountPerIndex[i] = state.bodyIREGraphAppliedFunctionCountPerIndex[i] + 1
                if hotPathReport.eGraphSkipped:
                    state.bodyIREGraphSkippedFunctionCountPerIndex[i] = state.bodyIREGraphSkippedFunctionCountPerIndex[i] + 1
                if hotPathReport.eGraphHardFail:
                    state.bodyIREGraphHardFailFunctionCountPerIndex[i] = state.bodyIREGraphHardFailFunctionCountPerIndex[i] + 1
                state.bodyIREGraphBlockCountPerIndex[i] = state.bodyIREGraphBlockCountPerIndex[i] + hotPathReport.eGraphBlockCount
                state.bodyIREGraphCandidateBlockCountPerIndex[i] = state.bodyIREGraphCandidateBlockCountPerIndex[i] + hotPathReport.eGraphCandidateBlockCount
                state.bodyIREGraphChangedBlockCountPerIndex[i] = state.bodyIREGraphChangedBlockCountPerIndex[i] + hotPathReport.eGraphChangedBlockCount
                state.bodyIREGraphSkippedBlockCountPerIndex[i] = state.bodyIREGraphSkippedBlockCountPerIndex[i] + hotPathReport.eGraphSkippedBlockCount
                state.bodyIREGraphUnsafeOpCountPerIndex[i] = state.bodyIREGraphUnsafeOpCountPerIndex[i] + hotPathReport.eGraphUnsafeOpCount
                state.bodyIREGraphClassCountPerIndex[i] = state.bodyIREGraphClassCountPerIndex[i] + hotPathReport.eGraphClassCount
                state.bodyIREGraphRoundCountPerIndex[i] = state.bodyIREGraphRoundCountPerIndex[i] + hotPathReport.eGraphRoundCount
                state.bodyIREGraphRuleHitCountPerIndex[i] = state.bodyIREGraphRuleHitCountPerIndex[i] + hotPathReport.eGraphRuleHitCount
                state.bodyIREGraphExtractedCountPerIndex[i] = state.bodyIREGraphExtractedCountPerIndex[i] + hotPathReport.eGraphExtractedCount
                state.bodyIREGraphOpDeltaPerIndex[i] = state.bodyIREGraphOpDeltaPerIndex[i] + hotPathReport.eGraphOpDelta
                state.bodyIREGraphMsPerIndex[i] = state.bodyIREGraphMsPerIndex[i] + hotPathReport.eGraphMs
                var primaryColdCond34: bool
                var primaryColdCond34Clause0: bool
                if len(state.bodyIREGraphReasonPerIndex[i]) <= 0:
                    if len(hotPathReport.eGraphReason) > 0:
                        primaryColdCond34Clause0 = true
                if primaryColdCond34Clause0:
                    primaryColdCond34 = true
                if primaryColdCond34:
                    state.bodyIREGraphReasonPerIndex[i] = share(hotPathReport.eGraphReason)
                bodyIR = hotPathReport.bodyIR
                primarySlotIdentityTripwire(bodyIR, "post_hotpath")
                if traceEnabled:
                    PrimaryObjectPlanTrace(Fmt"primary_body_ir_after_hotpath index={i}")
                lower.LoweringBodyIrProjectManualConsumeEffects(
                    bodyIR,
                    lowering,
                    irFunctionForBodyIR.ownershipTransport,
                    typedFnIndex)
                lower.LoweringBodyIrProjectExternFfiHandleCapabilities(
                    bodyIR,
                    lowering,
                    typedFnIndex)
                # One canonical Ownership/Init/Drop projection materializes
                # ordinary BodyIR cleanup ops.  The former primary-only
                # last-use/LocalSlot.ownership heuristic is not on this path.
                # ExactDef (批 2): 规范推导 → canonical cleanup 物化 →
                # 同步扩列 → freeze 验证。derive 在 ApplyOwned 前
                # (transport/typeArena 窗在作用域, cleanup 物化行尚未
                # 产生); freeze 验证在物化后 (consume 戳为终态)。
                var exactDefWindow: exactdef.BodyIrExactDefTypeArenaWindow
                exactDefWindow.artifactCid =
                    lowering.typeArenaArtifactCid
                exactDefWindow.structuralKinds =
                    lowering.typeArenaStructuralKinds
                exactDefWindow.scalarKinds =
                    lowering.typeArenaScalarKinds
                exactDefWindow.childTypeIds =
                    lowering.typeArenaChildTypeIds
                exactDefWindow.layoutChildStarts =
                    lowering.typeArenaLayoutChildStarts
                exactDefWindow.layoutChildCounts =
                    lowering.typeArenaLayoutChildCounts
                exactDefWindow.layoutChildTypeIds =
                    lowering.typeArenaLayoutChildTypeIds
                exactDefWindow.layoutChildOffsets =
                    lowering.typeArenaLayoutChildOffsets
                exactDefWindow.layoutChildWidths =
                    lowering.typeArenaLayoutChildWidths
                exactDefWindow.fixedLengths =
                    lowering.typeArenaFixedLengths
                exactDefWindow.sizeBytes =
                    lowering.typeArenaSizeBytes
                exactDefWindow.alignBytes =
                    lowering.typeArenaAlignBytes
                if !exactdefderive.BodyIrExactDefDerive(
                       bodyIR,
                       irFunctionForBodyIR.ownershipTransport.
                           sourceValueDefinitionStart,
                       irFunctionForBodyIR.ownershipTransport.
                           definitionRows,
                       irFunctionForBodyIR.ownershipTransport.originKinds,
                       irFunctionForBodyIR.ownershipTransport.exactTypeIds,
                       exactDefWindow):
                    panic("primary exact def derive rejected")
                # wall60: cleanupSourceProjectionCid 绑定前移到 ApplyOwned
                # 之前。消费点 CleanupPlanMaterialize →
                # cleanupCfgBuildAndSealIntent 在 apply 内部读
                # BodyIRCleanupSourceControlCid（要求 projection 非零），
                # post-apply 绑定恒晚于消费 = wall57 proj=0 结构性死点。
                # 绑定谓词 = apply 侧
                # ownershipBodyIrCleanupDefinitionCount>0 的同口径存在性
                # 判定（OwnMove + 未消费 + 非 manual-consume 的
                # value-def）＝将有非空 cleanup sidecar，保 codec 不变式
                # 「projection present iff sidecar non-empty」：谓词假 ⇒
                # ApplyOwned zero-cleanup fast-return，三侧车保持
                # canonical-empty，投影保持 CID-zero。
                var primaryCleanupWillMaterialize = false
                for cleanupDefOpIndex in 0..<bodyIR.ops.len:
                    let cleanupDefOp = bodyIR.ops[cleanupDefOpIndex]
                    if cleanupDefOp.valueDefOwnership !=
                           coreir.OwnMove ||
                       cleanupDefOp.valueDefConsumeOpIndexPlusOne != 0:
                        continue
                    var manualConsumeBound = false
                    for manualConsumeRow in
                            0..<bodyIR.manualConsume.sourceDefinitionRows.len:
                        if bodyIR.manualConsume.sourceDefinitionDomains[
                               manualConsumeRow] ==
                               coreir.BodyDefinitionDomainBodyOpTag &&
                           bodyIR.manualConsume.sourceDefinitionRows[
                               manualConsumeRow] == cleanupDefOpIndex:
                            manualConsumeBound = true
                            break
                    if manualConsumeBound:
                        continue
                    primaryCleanupWillMaterialize = true
                    break
                if primaryCleanupWillMaterialize:
                    primaryBodyIrBindCleanupSourceProjection(
                        bodyIR,
                        lowering,
                        typedFnIndex)
                primarySlotIdentityTripwire(bodyIR, "pre_applyowned")
                let ownershipCleanup =
                    ownershipproduction.OwnershipBodyIrProductionApplyOwned(
                        bodyIR)
                if !exactdeffreeze.ExactDefFreezeSidecarSyncAppended(
                       bodyIR):
                    panic("primary exact def sidecar sync failed")
                # ExactDef 批 5 挂接: 组合验证器入口 (批 2 相位 → 批 4
                # merge 校验 → 批 5 var-out/调用权威/seal root 相位 →
                # 批 3 identity schema 主审, C 判词序)。程序契约生产
                # seal 接线 (规格 §4.5): 契约表程序级一次推导+seal 按值
                # 送达, callee 行窗经键车道逐 callSequence 行投影。
                # 程序契约生产 seal 接线 (规格 §4.5): 契约表程序级一
                # 次推导+seal 按值送达 (模块级缓存, 首个函数体验证前
                # 完成); callee 行窗经键车道逐 callSequence 行投影
                # (inline, 本模块零新增函数 — 死点纪律)。
                if !primaryExactDefContractCacheReady:
                    var resultExprClasses: int32[]
                    var formalCounts: int32[]
                    var returnExactTypeIds: int32[]
                    var globalTypeIds: int32[]
                    var retStarts: int32[]
                    var retCounts: int32[]
                    var retRootDomains: int32[]
                    var retRootRows: int32[]
                    var retRootTypeIds: int32[]
                    var retFormalTypeIds: int32[]
                    var formalRootsReadOnly: bool[]
                    var expectRootKinds: int32[]
                    var expectFormalIndexs: int32[]
                    var expectFormalMasks: int32[]
                    var expectGlobalRows: int32[]
                    var expectReadOnlyProofs: int32[]
                    ccsg.CompilerCsgExactDefContractWindowsBuildInto(
                        lowering.typedIr,
                        resultExprClasses, formalCounts,
                        returnExactTypeIds, globalTypeIds,
                        retStarts, retCounts, retRootDomains,
                        retRootRows, retRootTypeIds, retFormalTypeIds,
                        formalRootsReadOnly, expectRootKinds,
                        expectFormalIndexs, expectFormalMasks,
                        expectGlobalRows, expectReadOnlyProofs)
                    exactdefcallauthority.ExactDefCallAuthorityProgramContractDerive(
                        primaryExactDefContractCache, "freeze",
                        lowering.typedIr.functions2_functionNameIds.len,
                        resultExprClasses, formalCounts,
                        returnExactTypeIds, globalTypeIds,
                        retStarts, retCounts, retRootDomains,
                        retRootRows, retRootTypeIds, retFormalTypeIds,
                        formalRootsReadOnly, expectRootKinds,
                        expectFormalIndexs, expectFormalMasks,
                        expectGlobalRows, expectReadOnlyProofs)
                    primaryExactDefContractCacheReady = true
                var exactDefCalleeRows: int32[]
                if bodyIR.callSequence.len > 0:
                    let declarationOwner =
                        texpr.TypedExprIrCallDeclarationBuildIndex(
                            lowering.typedIr)
                    if declarationOwner == nil || declarationOwner.released ||
                       !declarationOwner.callDeclarationSealed:
                        panic("primary exact def contract: call declaration index unavailable")
                    for callRow in 0..<bodyIR.callSequence.len:
                        let node =
                            bodyIR.callSequence[callRow].semanticCallExprNodeIndex
                        var calleeRow: int32 = -1
                        if node >= 0 &&
                           node < lowering.typedIr.nodes2_nodeIndexs.len:
                            let declarationIndex =
                                arenamod.ArenaArrayInt32Get(
                                    lowering.typedIr.arena,
                                    lowering.typedIr.nodes2_callDeclarationIndexes,
                                    node)
                            if declarationIndex >= 0:
                                if declarationIndex >=
                                       declarationOwner.callDeclarationProducerFunctionRows.len:
                                    panic("primary exact def contract: call declaration row invalid")
                                calleeRow =
                                    declarationOwner.callDeclarationProducerFunctionRows[
                                        declarationIndex]
                        add(exactDefCalleeRows, calleeRow)
                if !exactdefcallauthority.ExactDefCallAuthorityValidateInto(
                       bodyIR,
                       exactdeffreeze.ExactDefFreezeProductionLimits(),
                       primaryExactDefContractCache,
                       exactDefCalleeRows):
                    # [wall84] 判词富化（wall40/45/47/73/74/80/82 同款，
                    # 原文本作前缀 grep 仍命中；仅 reject 路径，绿路零影
                    # 响）：组合验证器拒臂不携带失败站点坐标，此处把被验
                    # 函数的 op 全语义列 + 槽表 + entry 参数槽注册 + entry
                    # 冻结所有权权威整体入判词，区分参数借视臂子查死因
                    # （entry 所有权形态 / 形参根注册 / 借视形 / TypeId
                    # 互证）。
                    var wall84Dump = Fmt" fn={typedFnIndex} ops={bodyIR.ops.len} slots={bodyIR.localSlots.len} sealed={bodyIR.entryDefinitionOwnershipSealed} entry_params={bodyIR.entryParameterSlotIds.len}"
                    for wall84Ordinal in 0..<bodyIR.entryParameterSlotIds.len:
                        wall84Dump = Fmt"{wall84Dump} p{wall84Ordinal}={bodyIR.entryParameterSlotIds[wall84Ordinal]}"
                    for wall84KindSlot in 0..<bodyIR.entryDefinitionOwnershipKinds.len:
                        wall84Dump = Fmt"{wall84Dump} eo{wall84KindSlot}={bodyIR.entryDefinitionOwnershipKinds[wall84KindSlot]}"
                    for wall84Op in 0..<bodyIR.ops.len:
                        let wall84OpData = bodyIR.ops[wall84Op]
                        wall84Dump = Fmt"{wall84Dump} o{wall84Op}:k={Int32(wall84OpData.kind)}:t={wall84OpData.target}:vds={wall84OpData.valueDefSlot}:vdo={Int32(wall84OpData.valueDefOwnership)}:bod={Int32(wall84OpData.valueDefBorrowOwnerDefinitionDomain)}:bor={wall84OpData.valueDefBorrowOwnerDefinitionRow}:oid={bodyIR.exactDef.opOriginIds[wall84Op]}:opk={Int32(bodyIR.exactDef.opPlaceKinds[wall84Op])}"
                        for wall84Operand in 0..<wall84OpData.operands.len:
                            wall84Dump = Fmt"{wall84Dump}:a{wall84Operand}={wall84OpData.operands[wall84Operand]}"
                    for wall84TableSlot in 0..<bodyIR.localSlots.len:
                        let wall84SlotData = bodyIR.localSlots[wall84TableSlot]
                        wall84Dump = Fmt"{wall84Dump} s{wall84TableSlot}:tk={Int32(wall84SlotData.typeKind)}:pk={Int32(wall84SlotData.placeKind)}:mg={Int32(wall84SlotData.managedStorageKind)}:tid={wall84SlotData.typeArenaTypeId}:sz={wall84SlotData.sizeBytes}:off={wall84SlotData.stackOffset}:epk={Int32(bodyIR.exactDef.slotPlaceKinds[wall84TableSlot])}:esk={Int32(bodyIR.exactDef.slotStorageKinds[wall84TableSlot])}"
                    panic(Fmt"primary exact def freeze validate rejected{wall84Dump}")
                if ownershipCleanup.applied &&
                   !ownershipCleanup.plannerReleased:
                    panic("primary canonical cleanup planner release failed")
                # wall60: projection 绑定已前移到 ApplyOwned 之前（消费点
                # cleanupCfgBuildAndSealIntent 在 apply 内部）。此处保留
                # codec 不变式「projection present iff sidecar non-empty」
                # 的双向复核：绑定谓词误判（如 zero-action 早退臂）在此
                # 定点硬崩，绝不静默漏检。
                let primaryCleanupSidecarsEmpty =
                    coreir.BodyIRCleanupIntentSidecarIsCanonicalEmpty(
                        bodyIR.cleanupIntent) &&
                    coreir.BodyIRCleanupScheduleSidecarIsCanonicalEmpty(
                        bodyIR.cleanupSchedule) &&
                    coreir.BodyIRDeferReplaySidecarIsCanonicalEmpty(
                        bodyIR.deferReplay)
                let primaryCleanupProjectionPresent =
                    coreir.BodyIRTypeArenaArtifactCidValid(
                        bodyIR.cleanupSourceProjectionCid)
                if primaryCleanupSidecarsEmpty:
                    if primaryCleanupProjectionPresent:
                        panic("primary cleanup projection sidecar invariant drift")
                else:
                    if !primaryCleanupProjectionPresent:
                        panic("primary cleanup projection sidecar invariant drift")
                var scopeExitReleaseCount: int32
                if ownershipCleanup.applied:
                    scopeExitReleaseCount =
                        ownershipCleanup.ownedDefinitionCount
                if traceEnabled:
                    PrimaryObjectPlanTrace(Fmt"primary_body_ir_after_canonical_cleanup index={i} function={irFunctionForBodyIR.functionName} released={scopeExitReleaseCount} actions={ownershipCleanup.ownershipActionCount} ops={bodyIR.ops.len} slots={bodyIR.localSlots.len} blocks={bodyIR.blocks.len}")
                state.bodyIRScopeExitReleaseCountPerIndex[i] = state.bodyIRScopeExitReleaseCountPerIndex[i] + scopeExitReleaseCount
                if bodyIR.blocks.len > 0 && bodyIR.terms.len > 0:
                    # [wall103] data relocation identity 生产臂（w99 参照臂
                    # backend2BuildFragmentForFunction 同构；守卫判据零改动）。
                    # codec 铁律「含 cstring 字面量/全局地址槽的 body 必须
                    # bind+seal 后才可编码」（守卫自 8/24 落树即然，全管线
                    # 零生产臂 = wall99 定性病根）。本点 = BodyIR 终态且即
                    # 将存入 tempBodyIRs[i]（worker 帧在下游
                    # Backend2BodyIrEncode），ApplyOwned/cleanup 物化的全部
                    # 后继 slot 追加与 wall60 双向复核均已完成。存储门控内
                    # 执行：只有会编码的 body 受编码契约约束，结构不完整
                    # 不编码的 discovery/census 路径零扰动。
                    # ① GlobalAddress 槽必须已精确绑靶，未绑 = 带全坐标硬
                    # 崩（fail-closed 不猜靶；typedIr global 行+靶 CID 靶
                    # 表为同域后续臂）。
                    var wall103UnresolvedGlobalSlot: int32 = -1
                    for wall103SlotIndex in 0..<bodyIR.localSlots.len:
                        if bodyIR.localSlots[wall103SlotIndex].placeKind !=
                               coreir.BodyPlaceGlobalAddressTag:
                            continue
                        var wall103SlotBound = false
                        if bodyIR.localAddressTargetDomainKinds.len ==
                               bodyIR.localSlots.len:
                            let wall103DomainKind =
                                bodyIR.localAddressTargetDomainKinds[
                                    wall103SlotIndex]
                            let wall103TargetRow =
                                bodyIR.localAddressTargetRows[
                                    wall103SlotIndex]
                            wall103SlotBound =
                                (wall103DomainKind ==
                                     coreir.BodyDataRelocTargetDomainTypedGlobalTag ||
                                 wall103DomainKind ==
                                     coreir.BodyDataRelocTargetDomainFunctionTag) &&
                                wall103TargetRow >= 0 &&
                                !layout.FixedBytes32Equal(
                                    bodyIR.localAddressTargetCids[
                                        wall103SlotIndex],
                                    layout.FixedBytes32())
                        if !wall103SlotBound &&
                               wall103UnresolvedGlobalSlot < 0:
                            wall103UnresolvedGlobalSlot = wall103SlotIndex
                    if wall103UnresolvedGlobalSlot >= 0:
                        panic(Fmt"primary data relocation identity: unresolved global address slot fn={irFunctionForBodyIR.functionName} slot={wall103UnresolvedGlobalSlot} slot_name={bodyIR.localSlots[wall103UnresolvedGlobalSlot].name} slots={bodyIR.localSlots.len}")
                    # ②③ seal 仅在确有可证靶（cstring 字面量）时执行：逐
                    # 字面量绑 owner cid（函数版本身份：b2cid 6-tuple 单一
                    # 配方唯一出口 Backend2FuncLowerCidFixed32；typed 指纹
                    # 为 pobj 域对等物 PrimaryBodyIrOwnerTypedFingerprint，
                    # bodyIR 内容无关故无自指循环），无靶 body 保持契约第
                    # 一形态 unsealed-empty（守卫 unsealed 臂明示合法），
                    # 编码字节与既有绿面零漂移。
                    if bodyIR.cstringLiterals.len > 0:
                        var wall103OwnerImportcSymbols: str[]
                        for wall103ImportcIndex in
                                0..<irFunctionForBodyIR.callImportcSymbols.len:
                            if irFunctionForBodyIR.callImportcSymbols[
                                   wall103ImportcIndex] != "":
                                add(wall103OwnerImportcSymbols,
                                    share(irFunctionForBodyIR.
                                        callImportcSymbols[
                                        wall103ImportcIndex]))
                        var wall103OwnerAbiViews: b2t.CalleeAbiView[]
                        let wall103OwnerCid =
                            b2cid.Backend2FuncLowerCidFixed32(
                                b2t.Backend2SemanticEpoch(),
                                targetTriple,
                                PrimaryBodyIrOwnerTypedFingerprint(
                                    lowering,
                                    irFunctionForBodyIR,
                                    typedFnIndex,
                                    lowering.functionExportedFlags[i] != 0),
                                b2cid.Backend2SourcePathHash(
                                    lowering.workspaceRoot,
                                    lowering.packageRoot,
                                    irFunctionForBodyIR.sourcePath),
                                irFunctionForBodyIR.callTargets,
                                wall103OwnerImportcSymbols,
                                wall103OwnerAbiViews)
                        for wall103LiteralRow in
                                0..<bodyIR.cstringLiterals.len:
                            coreir.BodyIRBindCStringTarget(
                                bodyIR,
                                wall103LiteralRow,
                                wall103OwnerCid)
                        coreir.BodyIRSealDataRelocationIdentity(bodyIR)
                    state.tempBodyIRs[i] = bodyIR
                    # C5 流水化 Step2: lazy 全骨架模式下 BodyIR 完全成功
                    # (blocks/terms 完整) 即释放 plan 常驻 statements。结构不完整
                    # 不释放 — census/fail-trace 错误行仍读 statements 原样。
                    # 共享 ir 行 (同名重载 AtLine 坍缩) 用消费者计数护栏: 只有
                    # 最后一个成功消费者才真释放, 否则后建的共享行读空 statements
                    # → 假 wcz。return-mode bodyKind 会重复进本块 (cond36 每轮
                    # 重建), 递减限首次成功构建 — 直接读 bodyIrLowered[i] 翻转前
                    # 值 (flag 写下移到本块尾), 不为此引入新局部。
                    # F17 slice2: no longer decrement/release the shared
                    # lazyIrConsumerCounts[irIndex] counter in place here — just
                    # record that index i is this irIndex's real (first-build)
                    # consumer. PrimaryObjectPlanReplayLazyIrReleases replays the
                    # decrement + release-on-zero in original ascending-i order
                    # after the whole lowering loop has joined.
                    if lowering.primaryObjectIrBuildMode == "object_all_lazy" &&
                       !state.streamReachabilityDiscovery &&
                       i < state.bodyIrLowered.len && !state.bodyIrLowered[i] &&
                       irIndex < state.lazyIrConsumerCounts.len &&
                       i < state.lazyIrReleaseCandidatePerIndex.len:
                        state.lazyIrReleaseCandidatePerIndex[i] = true
                    if i < state.bodyIrLowered.len:
                        state.bodyIrLowered[i] = true

fn PrimaryObjectPlanImplicitObjectEntryRoot(linkPlan: var slplan.SystemLinkPlanStub,
                                             lowering: var lower.LoweringPlanStub,
                                             index: int32): bool =
    if linkPlan.emitKind != creq.EmitObj:
        return false
    if index < 0 ||
       index >= lowering.functionNames.len ||
       index >= lowering.functionEntryFlags.len ||
       index >= lowering.functionTypedIrIndexes.len:
        return false
    return lowering.functionEntryFlags[index] != 0 &&
           lowering.functionTypedIrIndexes[index] ==
               lowering.sourceEntryTypedFunctionIndex

fn PrimaryObjectPlanMaterializeFunctionSymbol(
        linkPlan: var slplan.SystemLinkPlanStub,
        lowering: var lower.LoweringPlanStub,
        functionIndex: int32,
        symbolRole: var int32): str =
    let projection = lower.LoweringProjectFunctionSymbolExact(
        lowering, linkPlan, functionIndex)
    symbolRole = projection.role
    return projection.decoratedUtf8

# Scan a declared type text for an unsubstituted generic type parameter (a bare
# placeholder like `T`, possibly wrapped in `var`/`ref`/array/bracket syntax,
# e.g. `Result[T]`, `var Result[T]`, `T[]`). Reuses the established placeholder
# convention (TypedExprTypeIsGenericPlaceholder: single uppercase letter / refX).
# Tokenizes on the bracket/comma/array/whitespace boundaries so each component is
# checked independently — `Result[T]` -> {`Result`,`T`} -> `T` is a placeholder.
@borrows
fn PrimaryTypeTextHasGenericPlaceholder(typeRaw: str): bool =
    let typeText = texpr.TypedExprNormalizeTypeText(typeRaw)
    if typeText == "":
        return false
    var tokenStart: int32 = -1
    var i: int32
    while i <= len(typeText):
        var isBoundary = true
        if i < len(typeText):
            let ch = typeText[i]
            if (ch >= 'A' && ch <= 'Z') ||
               (ch >= 'a' && ch <= 'z') ||
               (ch >= '0' && ch <= '9') ||
               ch == '_' || ch == '.':
                isBoundary = false
        if isBoundary:
            if tokenStart >= 0:
                let token = chengpath.TextSlice(typeText, tokenStart, i - tokenStart)
                if texpr.TypedExprTypeIsGenericPlaceholder(token):
                    return true
                tokenStart = -1
        else:
            if tokenStart < 0:
                tokenStart = i
        i = i + 1
    return false

# A function is an uninstantiated generic template when its return type or any of
# its declared param types still carries a generic placeholder (sizeof(T) is
# unknown, so it cannot be lowered to machine code). Such a template has no
# meaningful standalone object-code body: every concrete call site is intrinsified
# inline (Ok[T]/Err[T] construct, Value/Error/IsErr/ErrorInfoOf projections), so
# no real call edge references the template symbol. It must NOT be seeded as an
# emit root nor lowered — otherwise its unloweable body poisons bodySemanticsMissing
# and forces the whole compilation unit to the cold backend (the wcz cliff).
fn PrimaryObjectPlanFunctionIsGenericTemplate(lowering: var lower.LoweringPlanStub,
                                              irIndex: int32): bool =
    if irIndex < 0 || irIndex >= lowering.primaryObjectIr.functions.len:
        return false
    let irFunction = lowering.primaryObjectIr.functions[irIndex]
    let typedFnIndex = irFunction.typedFunctionIndex
    if typedFnIndex >= 0 && typedFnIndex < lowering.typedIr.functions2_functionNameIds.len:
        let figtRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.functions2_returnTypeIds[typedFnIndex])
        if IsOk(figtRes) && PrimaryTypeTextHasGenericPlaceholder(Value(figtRes)):
            return true
    for paramI in 0..<irFunction.paramTypes.len:
        if PrimaryTypeTextHasGenericPlaceholder(irFunction.paramTypes[paramI]):
            return true
    return false

fn PrimaryObjectPlanLoweringMaterializedRoot(lowering: var lower.LoweringPlanStub,
                                             index: int32): bool =
    if lowering.primaryObjectIrReachableFirst == 0:
        return false
    if index < 0 || index >= lowering.primaryObjectIr.functions.len:
        return false
    let irFunction = lowering.primaryObjectIr.functions[index]
    if irFunction.typedFunctionIndex >= 0:
        return true
    if len(irFunction.bodyKind) > 0:
        return true
    if irFunction.statements.len > 0:
        return true
    if irFunction.callTargets.len > 0:
        return true
    if irFunction.bodyIR.ops.len > 0 || irFunction.bodyIR.terms.len > 0:
        return true
    return false

@borrows
fn PrimaryObjectPlanPrimaryIrFunctionNeedsLazyMaterialization(irFunction: lower.PrimaryObjectIrFunction): bool =
    if irFunction.statements.len > 0:
        return false
    if irFunction.callTargets.len > 0:
        return false
    if irFunction.bodyIR.ops.len > 0 || irFunction.bodyIR.terms.len > 0:
        return false
    if irFunction.typedFunctionIndex < 0:
        if irFunction.signatureLineNumber <= 0 && len(irFunction.bodyKind) <= 0:
            return true
        return false
    if len(irFunction.bodyKind) <= 0:
        return true
    if irFunction.bodyKind == texpr.BodyKindUnsupported:
        return true
    if irFunction.bodyKind == texpr.BodyKindStatementSequence:
        return true
    if texpr.TypedExprIsReturnCallBodyKind(irFunction.bodyKind):
        return true
    if PrimaryStatementSequenceReturnMode(irFunction.bodyKind) != PrimaryStatementReturnModeNone():
        return true
    # Production regalloc lowers every source-backed fixed body through its
    # typed statements.  Lazy rows therefore need their real statements and
    # call metadata even when an older fixed machine template exists.
    return true

@borrows
fn PrimaryObjectPlanRegallocBodyKindRequiresTruthfulBodyIr(
        state: var PrimaryObjectPlanPhaseState,
        targetTriple: str,
        bodyKind: str,
        functionStatementCount: int32): bool =
    if functionStatementCount <= 0:
        # 折叠成语(StrLenFast/习语模板): typed IR 直接把整函数收进单个叶子
        # 节点,零语句可建 BodyIR — 叶子模板填充就是唯一真实发射,
        # 不能按 truthful-BodyIR 强制 (否则零语句函数得到空体判 missing)。
        return false
    if !regart.RegallocProductionTargetUsesCanonicalRegalloc(targetTriple) ||
       (!state.streamedEmitFirst && !primaryBackpatchActive) ||
       PrimaryFunctionWordCountForBodyKind(bodyKind) <= 0:
        return false
    return true

@borrows
fn PrimaryObjectPlanMaterializeReachablePrimaryIr(state: var PrimaryObjectPlanPhaseState,
                                                   lowering: var lower.LoweringPlanStub,
                                                   functionIndex: int32,
                                                   irIndex: int32,
                                                   targetTriple: str,
                                                   emitKind: creq.CompilerEmit) =
    if functionIndex < 0 || functionIndex >= lowering.functionNames.len:
        return
    if irIndex < 0 || irIndex >= lowering.primaryObjectIr.functions.len:
        return
    if !PrimaryObjectPlanPrimaryIrFunctionNeedsLazyMaterialization(lowering.primaryObjectIr.functions[irIndex]):
        return
    var sourceTexts: texpr.TypedExprSourceText[]
    var rebuilt: lower.PrimaryObjectIrFunction
    lower.LoweringBuildOneFunctionInto(lowering,
                                       sourceTexts,
                                       functionIndex,
                                       texpr.BodyKindLetCallReturnI32ConstPrefixLen,
                                       rebuilt)
    if len(rebuilt.functionName) <= 0:
        return
    let signatureLineNumber = rebuilt.signatureLineNumber
    let bodyLineNumber = rebuilt.bodyLineNumber
    if lowering.primaryObjectIrBuildMode == "object_all_lazy":
        os.WriteLine(os.GetStderr(),
                     Fmt"lazy_store ir={irIndex} name={rebuilt.functionName} paramCap={rebuilt.paramNames.cap} typeCap={rebuilt.paramTypes.cap} stmtCap={rebuilt.statements.cap} shapeBuf={lower.LoweringPrimaryObjectIrFunctionShapeAllocatorPhysicalBufferCount(rebuilt)} ledgerLive={rebuilt.functionShapeAllocatorLedger.liveAllocationCount}")
        PrimaryObjectIrStorePlanFunction(lowering.primaryObjectIr, irIndex, rebuilt)
    else:
        # 同一 C5 lazy 写回铁律: CopyInto 第二形参是 var out, 元素级数组下标
        # 直接作 var 实参在冷编码器下与三组件嵌套写同样静默丢失 (原 if 分支
        # 已用 StorePlanFunction 收紧, 此 else/eager 分支镜像同一两组件路径)。
        var eagerSyncRow = lowering.primaryObjectIr.functions[irIndex]
        lower.LoweringCopyPrimaryObjectIrFunctionInto(rebuilt, eagerSyncRow)
        PrimaryObjectIrStorePlanFunction(lowering.primaryObjectIr, irIndex, eagerSyncRow)
    if functionIndex < lowering.functionSignatureLineNumbers.len:
        lowering.functionSignatureLineNumbers[functionIndex] = signatureLineNumber
    if functionIndex < lowering.functionBodyLineNumbers.len:
        lowering.functionBodyLineNumbers[functionIndex] = bodyLineNumber
    # LinkPhase is the unique InternPool lookup/materialization point. Lazy
    # body rebuilding may update code shape, but it must never reconstruct or
    # overwrite symbol identity from mutable text after that seal.
    if functionIndex >= state.allSymbolNames.len ||
       functionIndex >= state.allSymbolRoles.len ||
       len(state.allSymbolNames[functionIndex]) <= 0:
        panic("primary object: lazy rebuild lost materialized symbol identity")

@borrows
fn PrimaryObjectPlanExportRootMatches(linkPlan: var slplan.SystemLinkPlanStub,
                                      lowering: var lower.LoweringPlanStub,
                                      index: int32,
                                      root: str): bool =
    if linkPlan.emitKind != creq.EmitObj:
        return false
    if index < 0 || index >= lowering.functionNames.len:
        return false
    let rootText = chengpath.PathTrim(root)
    let rootTail = PrimaryFunctionTailName(rootText)
    let functionName = chengpath.PathTrim(lowering.functionNames[index])
    let functionTail = PrimaryFunctionTailName(functionName)
    if functionName == rootText || functionTail == rootText || functionTail == rootTail:
        return true
    if index < lowering.functionSymbolTexts.len:
        let symbolText = chengpath.PathTrim(lowering.functionSymbolTexts[index])
        let symbolTail = PrimaryFunctionTailName(symbolText)
        if symbolText == rootText || symbolTail == rootText || symbolTail == rootTail:
            return true
    if index < lowering.functionExportSymbolNames.len:
        let exportText = chengpath.PathTrim(lowering.functionExportSymbolNames[index])
        let exportTail = PrimaryFunctionTailName(exportText)
        if exportText == rootText || exportTail == rootText || exportTail == rootTail:
            return true
    return false

fn PrimaryObjectPlanInitPhase(state: var PrimaryObjectPlanPhaseState,
                               linkPlan: var slplan.SystemLinkPlanStub,
                               lowering: var lower.LoweringPlanStub) =
    state.allSymbolNames = []
    state.allSymbolFunctionRowsByTypedFunctionIndex =
        PrimaryIntSeqInit(
            lowering.typedIr.functions2_functionNameIds.len, -1)
    state.allSymbolRoles = []
    state.itemIds = []
    state.symbolNames = []
    state.symbolTypedFunctionIndexes = []
    state.symbolNameIds = []
    state.symbolRoles = []
    state.symbolInterfaceCids = []
    if !lower.LoweringFunctionNameIdentityStrictValid(lowering):
        panic("primary object: lowering function name identity invalid")
    state.symbolNameInternPoolDomainCid =
        layout.FixedBytes32Copy(
            lowering.functionNameInternPoolDomainCid)
    state.symbolLoweringIdentityReceiptCid =
        layout.FixedBytes32Copy(
            lowering.functionNameIdentityReceiptCid)
    state.encoderSourceRow = -1
    state.encoderRuntimeAuthorityCid = layout.FixedBytes32()
    if len(contract.CodegenUnitEncoderAuthorityPath(linkPlan.targetTriple)) > 0:
        var encoderAuthorityRes =
            encauthority.CompilerToolchainEncoderRuntimeAuthorityImportCurrent()
        # Driver-context default correction (2026-08-29 runtime walls): the
        # process vector cannot name a receipted binary inside combined
        # kernel/plugin drivers (ambient argv is not propagated into the
        # fixture-compile context).  Anchor on the workspace's official
        # published compiler authority; the full import validation chain and
        # every rejection are unchanged, so a workspace with a missing or
        # drifted authority still fails closed here.
        if IsErr(encoderAuthorityRes):
            # Spec migration: a managed field read yields a borrow view, so the
            # let local is borrowed; a borrowed actual cannot bind a non-var
            # non-@borrows formal (default move).  Clone into an owned value.
            let workspaceRootForAuthority: str = strings.CloneStr(
                linkPlan.packageRoot)
            encoderAuthorityRes =
                encauthority.CompilerToolchainEncoderRuntimeAuthorityImportForWorkspace(
                    workspaceRootForAuthority)
        if IsErr(encoderAuthorityRes):
            panic(Fmt"primary object: encoder runtime authority import failed{Error(encoderAuthorityRes)}")
        let encoderAuthority = Value(encoderAuthorityRes)
        if encoderAuthority.canonicalRow < 0 ||
           layout.FixedBytes32Equal(
               encoderAuthority.runtimeAuthorityCid,
               layout.FixedBytes32()):
            panic("primary object: encoder runtime authority invalid")
        state.encoderSourceRow = encoderAuthority.canonicalRow
        state.encoderRuntimeAuthorityCid =
            layout.FixedBytes32Copy(
                encoderAuthority.runtimeAuthorityCid)
    state.functionWordOffsets = []
    state.functionWordCounts = []
    state.functionBodyKinds = []
    state.functionInstructionBodyKinds = []
    state.functionStatementReturnModes = []
    state.functionStatementReturnI32Values = []
    state.functionStatementCallCounts = []
    state.functionIrIndexes = []
    state.functionBodyIRs = []
    state.relocSourceItemIds = []
    state.relocWordOffsets = []
    state.relocTargetSymbols = []
    state.relocTargetDomainKinds = []
    state.relocTargetRows = []
    state.relocTargetInterfaceCids = []
    state.relocCallOrdinal = []
    state.dataLabels = []
    state.dataPayloadTexts = []
    state.dataRelocSourceItemIds = []
    state.dataRelocWordOffsets = []
    state.dataRelocPredictedKey = []
    state.dataRelocOpIndex = []
    state.dataRelocSubIndex = []
    state.dataRelocTargetSymbols = []
    state.dataPayloadRawBytes = []
    state.dataPayloadRawByteCounts = []
    state.irIndexes = PrimaryIntSeqInit(lowering.functionNames.len, -1)
    state.wordCounts = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.reachable = PrimaryBoolSeqInit(lowering.functionNames.len, false)
    state.bodyIrLowered = PrimaryBoolSeqInit(lowering.functionNames.len, false)
    state.lazyIrReleaseCandidatePerIndex = PrimaryBoolSeqInit(lowering.functionNames.len, false)
    state.frontier = []
    state.tempBodyIRs = []
    for _ in 0..<lowering.functionNames.len:
        add(state.tempBodyIRs, coreir.BodyIRNew())
    state.exportedFunctionCount = 0
    state.entryFunctionCount = 0
    state.bodyIROrcRetainReleasePairElidedCount = 0
    state.bodyIRScopeExitReleaseCount = 0
    state.bodyIROrcDiagObserverPresent = PrimaryLoweringHasOrcDiagObserver(lowering)
    state.bodyIRNoAliasFunctionCount = 0
    state.bodyIRNoAliasAppliedFunctionCount = 0
    state.bodyIRNoAliasLocalCount = 0
    state.bodyIRNoAliasForwardRewriteCount = 0
    state.bodyIRNoAliasDodSoAAllOk = true
    state.bodyIRPhaseArenaResetCount = 0
    state.bodyIRPhaseArenaReserveCount = 0
    state.bodyIRPhaseArenaCapacityBytes = int64(0)
    state.bodyIRPhaseArenaUsedBytes = int64(0)
    state.bodyIRPhaseArenaPeakBytes = int64(0)
    state.bodyIRPhaseArenaSpillCount = 0
    state.bodyIREGraphFunctionCount = 0
    state.bodyIREGraphAppliedFunctionCount = 0
    state.bodyIREGraphSkippedFunctionCount = 0
    state.bodyIREGraphHardFailFunctionCount = 0
    state.bodyIREGraphBlockCount = 0
    state.bodyIREGraphCandidateBlockCount = 0
    state.bodyIREGraphChangedBlockCount = 0
    state.bodyIREGraphSkippedBlockCount = 0
    state.bodyIREGraphUnsafeOpCount = 0
    state.bodyIREGraphClassCount = 0
    state.bodyIREGraphRoundCount = 0
    state.bodyIREGraphRuleHitCount = 0
    state.bodyIREGraphExtractedCount = 0
    state.bodyIREGraphOpDelta = 0
    state.bodyIREGraphMs = 0
    state.bodyIREGraphReason = ""
    state.bodyIROrcRetainReleasePairElidedCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.seqAddCandidateCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.seqAddTypedContractCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.structuredSeqAddConsumeCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.seqAddNodeProbeHitCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.seqAddTypeMismatchCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.seqAddLegacyTextConsumeCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.seqAddNodeEvalGapCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.structuredResultIntrinsicConsumeCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIRNoAliasFunctionCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIRNoAliasAppliedFunctionCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIRNoAliasLocalCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIRNoAliasForwardRewriteCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIRNoAliasDodSoAContractOkPerIndex = PrimaryBoolSeqInit(lowering.functionNames.len, true)
    state.bodyIRPhaseArenaResetCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIRPhaseArenaReserveCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIRPhaseArenaCapacityBytesPerIndex = PrimaryInt64SeqInit(lowering.functionNames.len, int64(0))
    state.bodyIRPhaseArenaUsedBytesPerIndex = PrimaryInt64SeqInit(lowering.functionNames.len, int64(0))
    state.bodyIRPhaseArenaPeakBytesPerIndex = PrimaryInt64SeqInit(lowering.functionNames.len, int64(0))
    state.bodyIRPhaseArenaSpillCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphFunctionCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphAppliedFunctionCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphSkippedFunctionCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphHardFailFunctionCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphBlockCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphCandidateBlockCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphChangedBlockCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphSkippedBlockCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphUnsafeOpCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphClassCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphRoundCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphRuleHitCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphExtractedCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphOpDeltaPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphMsPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.bodyIREGraphReasonPerIndex = PrimaryStrSeqInit(lowering.functionNames.len, "")
    state.bodyIRScopeExitReleaseCountPerIndex = PrimaryIntSeqInit(lowering.functionNames.len, 0)
    state.streamReachabilityDiscovery = false
    state.streamedEmitFirst = false
    state.streamedBuildAborted = false
    state.streamedBuildAbortReason = ""
    state.fillCheckSkippedForBuildAbort = false
    state.streamedFillFailedIndex = -1
    state.streamedBackpatchFailureKind = ""
    state.streamedBackpatchCallOrdinal = -1
    state.streamedBackpatchDataOpIndex = -1
    state.streamedBackpatchDataSubIndex = -1
    state.wordFillSchedule = "serial"
    state.wordFillRequestedJobCount = 1
    state.wordFillWorkerCount = 1
    state.wordFillCompletedWorkerCount = 1
    state.wordFillTaskCount = 0
    state.wordFillMergeOrder = "decl_ordinal"
    if linkPlan.emitKind == creq.EmitObj && linkPlan.exportRootSymbols.len > 0:
        state.exportedFunctionCount = linkPlan.exportRootSymbols.len
    elif linkPlan.emitKind == creq.EmitObj:
        for i in 0..<lowering.functionExportedFlags.len:
            if lowering.functionExportedFlags[i] != 0:
                state.exportedFunctionCount = state.exportedFunctionCount + 1
        for i in 0..<lowering.functionEntryFlags.len:
            if lowering.functionEntryFlags[i] != 0:
                state.entryFunctionCount = state.entryFunctionCount + 1
        if state.exportedFunctionCount <= 0 && state.entryFunctionCount <= 0:
            for i in 0..<lowering.functionNames.len:
                if PrimaryObjectPlanImplicitObjectEntryRoot(linkPlan, lowering, i):
                    state.entryFunctionCount = 1
                    break
    state.emitObjectRootsAllFunctions = false
    if linkPlan.emitKind == creq.EmitObj:
        if state.exportedFunctionCount <= 0 && state.entryFunctionCount <= 0:
            state.emitObjectRootsAllFunctions = true
    state.totalWordCount = 0
    state.entryFunctionSymbol = ""
    state.bodySemanticsMissing = false
    state.error.functionName = ""
    state.error.functionSourcePath = ""
    state.error.bodyKind = ""
    state.error.typedIrKind = ""
    state.error.lineNumber = 0
    state.error.callTargetOrdinal = -1
    state.error.callTarget = ""
    state.error.callTargetSourcePath = ""
    state.error.statementTrace = ""
    state.error.paramTrace = ""
    state.error.rhsBailReason = texpr.RhsBailNone
    state.error.callTargetResolutionKind = texpr.CallTargetUnresolved
    state.needsRuntimeCommandData = false

# F14b: does this program reference the Result.Value() intrinsic anywhere?
# Value() never builds a real generic-instantiation call edge to
# Result[T].Value (typed_expr synthesizes a dedicated CallExpr node with
# literalText="Value" instead — see typed_expr.cheng:12254 comment), so the
# ordinary reachable-function walk below never discovers Value[T]'s own
# `system.PanicErrorInfo(r.err)` source line and never marks Panic reachable.
# The BodyIR-level panic guard
# (PrimaryBodyIrAppendResultValuePanicGuard/BodyOpResultPanicGuardTag)
# synthesizes a real call to Panic(msg) purely at the backend, invisible to
# this same walk, so without this scan Panic would only resolve by accident
# (whenever some unrelated call elsewhere in the program already reaches it —
# true for this compiler's own 21万行 closure, false for a small standalone
# program). Scan once and force Panic onto the reachability frontier whenever
# the intrinsic is used, so the guard's call target is always resolvable.
@borrows
fn PrimaryObjectPlanProgramUsesValueIntrinsic(typedIr: texpr.TypedExprIr): bool =
    for nodeIndex in 0..<typedIr.nodes2_opKinds.len:
        if typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
            continue
        let litRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_literalTextIds[nodeIndex])
        if IsOk(litRes) && Value(litRes) == "Value":
            return true
    return false

fn PrimaryObjectPlanLinkPhase(state: var PrimaryObjectPlanPhaseState,
                               linkPlan: var slplan.SystemLinkPlanStub,
                               lowering: var lower.LoweringPlanStub) =
    var primaryColdCond35: bool
    var primaryColdCond35Clause0: bool
    if lowering.primaryObjectIr.functions.len <= 0:
        if lowering.primaryObjectIrFunctions.len > 0:
            primaryColdCond35Clause0 = true
    if primaryColdCond35Clause0:
        primaryColdCond35 = true
    if primaryColdCond35:
        lowering.primaryObjectIr.functions = lowering.primaryObjectIrFunctions
    for i in 0..<lowering.functionNames.len:
        if i >= lowering.functionTypedIrIndexes.len:
            panic("primary object: typed function symbol row missing")
        let typedFunctionIndex =
            lowering.functionTypedIrIndexes[i]
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >=
               state.allSymbolFunctionRowsByTypedFunctionIndex.len ||
           state.allSymbolFunctionRowsByTypedFunctionIndex[
               typedFunctionIndex] != -1:
            panic("primary object: typed function symbol identity invalid")
        state.allSymbolFunctionRowsByTypedFunctionIndex[
            typedFunctionIndex] = i
        let sourcePath = lowering.functionSourcePaths[i]
        var requestedSignatureLineNumber: int32
        if i >= 0 && i < lowering.functionSignatureLineNumbers.len:
            requestedSignatureLineNumber = lowering.functionSignatureLineNumbers[i]
        let irIndex = PrimaryObjectIrFunctionIndexAtLine(lowering.primaryObjectIr,
                                                         sourcePath,
                                                         lowering.functionNames[i],
                                                         requestedSignatureLineNumber)
        if irIndex >= 0:
            state.irIndexes[i] = irIndex
        var symbolRole: int32
        let materializedSymbol =
            PrimaryObjectPlanMaterializeFunctionSymbol(
                linkPlan,
                lowering,
                i,
                symbolRole)
        let implicitObjectEntryRoot = PrimaryObjectPlanImplicitObjectEntryRoot(linkPlan, lowering, i)
        add(state.allSymbolNames, materializedSymbol)
        add(state.allSymbolRoles, symbolRole)
        if i < lowering.functionEntryFlags.len && lowering.functionEntryFlags[i] != 0:
            state.entryFunctionSymbol = state.allSymbolNames[state.allSymbolNames.len - 1]
        elif implicitObjectEntryRoot:
            state.entryFunctionSymbol = state.allSymbolNames[state.allSymbolNames.len - 1]
        var emitObjectRootExported: bool
        var emitObjectRootImplicitEntry: bool
        var emitObjectRootRequested: bool
        let emitLoweringMaterializedRoot = PrimaryObjectPlanLoweringMaterializedRoot(lowering, i)
        if linkPlan.emitKind == creq.EmitObj:
            if linkPlan.exportRootSymbols.len > 0:
                for rootIndex in 0..<linkPlan.exportRootSymbols.len:
                    if PrimaryObjectPlanExportRootMatches(linkPlan,
                                                          lowering,
                                                          i,
                                                          linkPlan.exportRootSymbols[rootIndex]):
                        emitObjectRootRequested = true
            if i < lowering.functionExportedFlags.len:
                if lowering.functionExportedFlags[i] != 0:
                    emitObjectRootExported = true
            if state.exportedFunctionCount <= 0 &&
               state.entryFunctionCount > 0 &&
               implicitObjectEntryRoot:
                emitObjectRootImplicitEntry = true
        # An uninstantiated generic template (sizeof(T) unknown) has no standalone
        # object-code body. Never seed it as an emit root: every concrete call site
        # is intrinsified inline, so no real call edge references the template
        # symbol. Seeding it (via emitObjectRootsAllFunctions etc.) would lower its
        # unloweable body, zero the word count and poison bodySemanticsMissing —
        # forcing the whole unit to the cold backend (the wcz cliff). If a genuine
        # call edge ever reaches it, the reachability pass still marks it and the
        # cold path catches the (then legitimately required) linkage need.
        let irIndexForRoot = state.irIndexes[i]
        let isGenericTemplateRoot = PrimaryObjectPlanFunctionIsGenericTemplate(lowering, irIndexForRoot)
        if !isGenericTemplateRoot &&
           (state.emitObjectRootsAllFunctions ||
            emitObjectRootRequested ||
            emitObjectRootExported ||
            emitObjectRootImplicitEntry ||
            emitLoweringMaterializedRoot ||
            (i < lowering.functionEntryFlags.len && lowering.functionEntryFlags[i] != 0)):
            state.reachable[i] = true
            add(state.frontier, i)
    # F14b: force Panic reachable whenever Value() intrinsic is used anywhere
    # in the program — see PrimaryObjectPlanProgramUsesValueIntrinsic comment.
    if PrimaryObjectPlanProgramUsesValueIntrinsic(lowering.typedIr):
        for panicRootIndex in 0..<lowering.functionNames.len:
            if lowering.functionNames[panicRootIndex] == "Panic" &&
               !state.reachable[panicRootIndex]:
                state.reachable[panicRootIndex] = true
                add(state.frontier, panicRootIndex)
    # C5 Step2 消费者计数 (object_all_lazy 独占): irIndexes 在本相后不再变,
    # 一次 O(n) 统计每个 ir 行被多少 plan 行引用 (同名重载 AtLine 坍缩共享行时
    # >1)。Step2 释放以此护栏, 最后一个成功消费者才清 statements。
    if lowering.primaryObjectIrBuildMode == "object_all_lazy":
        state.lazyIrConsumerCounts = PrimaryIntSeqInit(lowering.primaryObjectIr.functions.len, 0)
        for consumerIndex in 0..<state.irIndexes.len:
            let consumedIrIndex = state.irIndexes[consumerIndex]
            if consumedIrIndex >= 0 && consumedIrIndex < state.lazyIrConsumerCounts.len:
                state.lazyIrConsumerCounts[consumedIrIndex] = state.lazyIrConsumerCounts[consumedIrIndex] + 1

@borrows
fn PrimaryObjectPlanEnsureFunctionLowered(state: var PrimaryObjectPlanPhaseState,
                                           lowering: var lower.LoweringPlanStub,
                                           i: int32,
                                           targetTriple: str,
                                           emitKind: creq.CompilerEmit) =
    if i < 0 || i >= lowering.functionNames.len:
        return
    if i >= state.irIndexes.len || i >= state.wordCounts.len:
        return
    let irIndex = state.irIndexes[i]
    if irIndex < 0:
        return
    if i < state.bodyIrLowered.len && state.bodyIrLowered[i]:
        if !PrimaryObjectPlanBodyIrReady(state, i):
            panic("primary lowered BodyIR semantic shape missing")
        return
    if state.wordCounts[i] > 0:
        var existingBodyKind = lowering.primaryObjectIr.functions[irIndex].bodyKind
        let existingSpecialBodyKind = PrimarySpecialExportBodyKindForFunction(lowering, i)
        if existingSpecialBodyKind != "":
            existingBodyKind = existingSpecialBodyKind
        if PrimaryObjectPlanRegallocBodyKindRequiresTruthfulBodyIr(
               state, targetTriple, existingBodyKind,
               lowering.primaryObjectIr.functions[irIndex].statements.len):
            state.wordCounts[i] = 0
        elif existingBodyKind == texpr.BodyKindStatementSequence:
            # Already-lowered memo: if a real body was fully built on a prior pass
            # (LoweringPhase → BuildItemsPhase re-entry), keep the existing wordCounts
            # and tempBodyIRs instead of zeroing and re-lowering the whole body.
            # bodyIrLowered is set true only after PrimaryBuildBodyIrForFunction
            # produced ops/terms > 0, so a first-reachable not-yet-lowered function
            # (flag still false) still falls through to the full lowering path below.
            if i < state.bodyIrLowered.len && state.bodyIrLowered[i]:
                return
            state.wordCounts[i] = 0
        else:
            let fixedWordCount = PrimaryFunctionWordCountForBodyKind(existingBodyKind)
            if fixedWordCount > 0 &&
               PrimaryStatementSequenceReturnMode(existingBodyKind) == PrimaryStatementReturnModeNone():
                state.wordCounts[i] = fixedWordCount
                if i < state.tempBodyIRs.len:
                    var releaseBodyIR = state.tempBodyIRs[i]
                    state.tempBodyIRs[i] = coreir.BodyIRNew()
                    PrimaryObjectPlanReleaseLoweredBodyIr(
                        state,
                        releaseBodyIR,
                        irIndex,
                        bodylifecycle.BodyIrFunctionOutcomeEarlyReturn)
            return
    PrimaryObjectPlanMaterializeReachablePrimaryIr(state,
                                                   lowering,
                                                   i,
                                                   irIndex,
                                                   targetTriple,
                                                    emitKind)
    if PrimaryObjectPlanTraceActive():
        PrimaryObjectPlanTrace(Fmt"primary_object_plan_lowering_index={i}")
    # Stream reachability discovery only needs callTargets on the IR row
    # (PrimaryObjectPlanExpandIrCallTargets). Full bodyIR is rebuilt in
    # BuildItems and was previously double-built then discarded here — pure
    # wall cost on pobj (~half of stream path). When materialize left no
    # callTargets, fall through to bodyIR so callSequence-based expand still
    # works (fn-address slots / empty-row edge cases).
    # EmitObj only: emit:exe pure bake hit missing bail=810 (callSequence drift /
    # incomplete edges) when discovery skipped bodyIR — keep full discovery for
    # exe/link entry-root expansion.
    if state.streamReachabilityDiscovery && emitKind == creq.EmitObj:
        if irIndex >= 0 &&
           irIndex < lowering.primaryObjectIr.functions.len &&
           lowering.primaryObjectIr.functions[irIndex].callTargets.len > 0:
            if PrimaryObjectPlanTraceActive():
                PrimaryObjectPlanTrace(Fmt"primary_object_plan_discovery_skip_body_ir index={i} calls={lowering.primaryObjectIr.functions[irIndex].callTargets.len}")
            return
    var bodyKind = lowering.primaryObjectIr.functions[irIndex].bodyKind
    if i == 0:
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"primary_object_plan_lowering_after_body_kind ir_index={irIndex} body_kind={bodyKind}")
    let specialBodyKind = PrimarySpecialExportBodyKindForFunction(lowering, i)
    if specialBodyKind != "":
        bodyKind = specialBodyKind
        if PrimaryObjectPlanRegallocBodyKindRequiresTruthfulBodyIr(
               state, targetTriple, bodyKind,
               lowering.primaryObjectIr.functions[irIndex].statements.len):
            if i >= state.tempBodyIRs.len || i >= state.bodyIrLowered.len:
                panic("primary regalloc bridge BodyIR slot missing")
            var bridgeBodyIR =
                PrimaryObjectPlanRegallocCallIndirectBridgeBodyIr(
                    bodyKind, lowering.typeArenaArtifactCid)
            let bridgeDod = coreir.BodyIRDodSoAContractCheck(bridgeBodyIR)
            if !bridgeDod.ok:
                panic("primary regalloc bridge BodyIR DOD/SoA contract failed")
            let bridgeAccess = bodyaccess.BodyIrAccessDecode(bridgeBodyIR)
            if !bridgeAccess.valid:
                panic("primary regalloc bridge BodyIR access contract failed")
            if !alloc.RegallocSinglePassBodyIrCanonicalIngressValid(bridgeBodyIR):
                panic("primary regalloc bridge BodyIR canonical ingress failed")
            var releaseBodyIR = state.tempBodyIRs[i]
            state.tempBodyIRs[i] = coreir.BodyIRNew()
            PrimaryObjectPlanReleaseLoweredBodyIr(
                state,
                releaseBodyIR,
                irIndex,
                bodylifecycle.BodyIrFunctionOutcomeEarlyReturn)
            PrimaryBodyIRMoveInto(state.tempBodyIRs[i], bridgeBodyIR)
            state.bodyIrLowered[i] = true
            return
    if contract.CodegenBodyEmitUnit(targetTriple) == contract.CodegenUnitX64 &&
       !PrimaryBodyKindSupportedByX64Text(bodyKind):
        # Demote unsupported special templates to the generic BodyIR path.
        bodyKind = texpr.BodyKindStatementSequence
    if i == 0:
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"primary_object_plan_lowering_after_special body_kind={bodyKind}")
    state.wordCounts[i] = PrimaryFunctionWordCountForBodyKind(bodyKind)
    if bodyKind == texpr.BodyKindStatementSequence ||
       PrimaryObjectPlanRegallocBodyKindRequiresTruthfulBodyIr(
           state, targetTriple, bodyKind,
           lowering.primaryObjectIr.functions[irIndex].statements.len):
        state.wordCounts[i] = 0
    if i == 0:
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"primary_object_plan_lowering_after_word_count word_count={state.wordCounts[i]}")
    if state.wordCounts[i] > 0 && i < state.tempBodyIRs.len:
        var releaseBodyIR = state.tempBodyIRs[i]
        state.tempBodyIRs[i] = coreir.BodyIRNew()
        PrimaryObjectPlanReleaseLoweredBodyIr(
            state,
            releaseBodyIR,
            irIndex,
            bodylifecycle.BodyIrFunctionOutcomeEarlyReturn)
    var primaryColdCond36: bool
    if state.wordCounts[i] <= 0 &&
       !PrimaryObjectPlanBodyIrReady(state, i):
        primaryColdCond36 = true
    if PrimaryStatementSequenceReturnMode(bodyKind) != PrimaryStatementReturnModeNone():
        primaryColdCond36 = true
    if primaryColdCond36:
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"primary_object_plan_lowering_before_body_ir index={i} body_kind={bodyKind} word_count={state.wordCounts[i]}")
        if PrimaryObjectPlanLowerRssEnabled():
            os.WriteLine(os.GetStderr(), Fmt"lower_rss_before index={i} name={lowering.functionNames[i]} rss={os.ProcessRssBytes()}")
        PrimaryBuildBodyIrForFunction(state, lowering, i, targetTriple)
        if PrimaryObjectPlanLowerRssEnabled():
            os.WriteLine(os.GetStderr(), Fmt"lower_rss_after index={i} name={lowering.functionNames[i]} rss={os.ProcessRssBytes()}")
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"primary_object_plan_lowering_after_body_ir index={i}")
    if state.wordCounts[i] <= 0 &&
       !PrimaryObjectPlanBodyIrReady(state, i):
        var bodyIrOps: int32
        var bodyIrTerms: int32
        var bodyIrCalls: int32
        if i < state.tempBodyIRs.len:
            bodyIrOps = state.tempBodyIRs[i].ops.len
            bodyIrTerms = state.tempBodyIRs[i].terms.len
            bodyIrCalls = state.tempBodyIRs[i].callSequence.len
        if PrimaryObjectPlanDebugEnabled():
            PrimaryObjectPlanDebugLine(Fmt"lowered_zero index={i} name={lowering.functionNames[i]} ir_index={irIndex} body_kind={bodyKind} original_body_kind={lowering.primaryObjectIr.functions[irIndex].bodyKind} typed_index={lowering.primaryObjectIr.functions[irIndex].typedFunctionIndex} stmts={lowering.primaryObjectIr.functions[irIndex].statements.len} calls={lowering.primaryObjectIr.functions[irIndex].callTargets.len} body_ir_ops={bodyIrOps} body_ir_terms={bodyIrTerms} body_ir_calls={bodyIrCalls}")
            if contract.CodegenBodyEmitUnit(targetTriple) == contract.CodegenUnitX64 &&
               i < state.tempBodyIRs.len:
                for zeroOpScan in 0..<state.tempBodyIRs[i].ops.len:
                    if x64units.CodegenX64BodyOpSizeAt(state.tempBodyIRs[i], zeroOpScan) <= 0:
                        let zeroOp = state.tempBodyIRs[i].ops[zeroOpScan]
                        var zeroOpOperandsText = ""
                        for zeroOpOperandIndex in 0..<zeroOp.operands.len:
                            zeroOpOperandsText = Fmt"{zeroOpOperandsText} {strings.IntToStr(zeroOp.operands[zeroOpOperandIndex])}"
                        var zeroOpTargetType: int32 = -1
                        var zeroOpTargetName = ""
                        if zeroOp.target >= 0 && zeroOp.target < state.tempBodyIRs[i].localSlots.len:
                            zeroOpTargetType = state.tempBodyIRs[i].localSlots[zeroOp.target].typeKind
                            zeroOpTargetName = state.tempBodyIRs[i].localSlots[zeroOp.target].name
                        var zeroOpSrcType: int32 = -1
                        var zeroOpSrcName = ""
                        if zeroOp.operands.len > 0 &&
                           zeroOp.operands[0] >= 0 &&
                           zeroOp.operands[0] < state.tempBodyIRs[i].localSlots.len:
                            zeroOpSrcType = state.tempBodyIRs[i].localSlots[zeroOp.operands[0]].typeKind
                            zeroOpSrcName = state.tempBodyIRs[i].localSlots[zeroOp.operands[0]].name
                        PrimaryObjectPlanDebugLine(Fmt"lowered_zero_op name={lowering.functionNames[i]} op_index={zeroOpScan} kind={zeroOp.kind} target={zeroOp.target} target_type={zeroOpTargetType} target_name={zeroOpTargetName} operands=[{zeroOpOperandsText}] op0_type={zeroOpSrcType} op0_name={zeroOpSrcName}")
                        break

# ---- #75(c) LoweringPhase fork+COW pool (BACKEND_JOBS>1, stream 已关) ----
# 模型同 backend2 slice-11：fork 不 exec，子进程 COW 私有写 tempBodyIRs，
# BodyIR 经 b2fc 管道回传；父按槽位收集后 jobs=1 路径消费同一 tempBodyIRs。
const
    primaryLowerPoolFrameMagic: int32 = 0x4c523150          # "P1RL"
    primaryLowerPoolSentinelMagic: int32 = 0x4c523145       # "E1RL"
    primaryLowerPoolFailureReceiptMagic: int32 = 0x46523150 # "P1RF"
    primaryLowerPoolFailureReceiptIntCount: int32 = 44
    primaryLowerPoolFailureReceiptStringCount: int32 = 16
    primaryLowerPoolMaxPayloadBytes: int32 = 67108864
    PrimaryLowerPoolBodyStatusNoBodyIr: int32 = 0
    PrimaryLowerPoolBodyStatusLowered: int32 = 1
    PrimaryLowerPoolBodyStatusSemanticsMissing: int32 = 2

@borrows
fn PrimaryLowerPoolScheduleContract(indexes: int32[],
                                    functionCount: int32,
                                    workerCount: int32): bool =
    if functionCount < 0 || indexes.len <= 0 || workerCount <= 0 ||
       workerCount > indexes.len:
        return false
    var seen: bool[]
    for i in 0..<functionCount:
        add(seen, false)
    for position in 0..<indexes.len:
        let slotIndex = indexes[position]
        if slotIndex < 0 || slotIndex >= functionCount || seen[slotIndex]:
            return false
        seen[slotIndex] = true
    return true

fn PrimaryLowerPoolExpectedFrameCount(indexCount: int32,
                                      workerCount: int32,
                                      workerIndex: int32,
                                      frameCountOut: var int32): bool =
    if indexCount < 0 || workerCount <= 0 || workerIndex < 0 ||
       workerIndex >= workerCount:
        return false
    frameCountOut = 0
    if workerIndex >= indexCount:
        return true
    frameCountOut = 1 + (indexCount - 1 - workerIndex) / workerCount
    return true

@borrows
fn PrimaryLowerPoolFrameIdentityContract(indexes: int32[],
                                         workerCount: int32,
                                         workerIndex: int32,
                                         frameOrdinal: int32,
                                         slotIndex: int32): bool =
    var expectedFrameCount: int32
    if !PrimaryLowerPoolExpectedFrameCount(indexes.len,
                                           workerCount,
                                           workerIndex,
                                           expectedFrameCount) ||
       frameOrdinal < 0 || frameOrdinal >= expectedFrameCount:
        return false
    let position = workerIndex + frameOrdinal * workerCount
    return position >= 0 && position < indexes.len && indexes[position] == slotIndex

fn PrimaryLowerPoolSentinelIdentityContract(indexCount: int32,
                                            workerCount: int32,
                                            workerIndex: int32,
                                            observedFrameCount: int32,
                                            sentinelFrameCount: int32): bool =
    var expectedFrameCount: int32
    return PrimaryLowerPoolExpectedFrameCount(indexCount,
                                              workerCount,
                                              workerIndex,
                                              expectedFrameCount) &&
           observedFrameCount == expectedFrameCount &&
           sentinelFrameCount == expectedFrameCount

fn PrimaryObjectPlanReceiptCounterAddChecked(current: int32,
                                             value: int32,
                                             totalOut: var int32): bool =
    if current < 0 || value < 0 || value > 0x7fffffff - current:
        return false
    totalOut = current + value
    return true

fn PrimarySeqAddReceiptCountersValid(seqAddCandidateCount: int32,
                                     seqAddTypedContractCount: int32,
                                     structuredSeqAddConsumeCount: int32,
                                     seqAddNodeProbeHitCount: int32,
                                     seqAddTypeMismatchCount: int32,
                                     seqAddLegacyTextConsumeCount: int32,
                                     seqAddNodeEvalGapCount: int32,
                                     structuredResultIntrinsicConsumeCount: int32): bool =
    if seqAddCandidateCount < 0 || seqAddTypedContractCount < 0 ||
       structuredSeqAddConsumeCount < 0 || seqAddNodeProbeHitCount < 0 ||
       seqAddTypeMismatchCount < 0 || seqAddLegacyTextConsumeCount != 0 ||
       seqAddNodeEvalGapCount < 0 || structuredResultIntrinsicConsumeCount < 0:
        return false
    if seqAddTypedContractCount > seqAddCandidateCount ||
       structuredSeqAddConsumeCount > seqAddTypedContractCount ||
       seqAddNodeProbeHitCount > seqAddTypedContractCount ||
       structuredSeqAddConsumeCount > seqAddNodeProbeHitCount ||
       seqAddTypeMismatchCount > seqAddTypedContractCount -
           structuredSeqAddConsumeCount ||
       seqAddNodeEvalGapCount > seqAddCandidateCount -
           seqAddTypedContractCount:
        return false
    return true

@borrows
fn PrimarySeqAddReceiptHasNoActualConsumption(
    structuredSeqAddConsumeCount: int32,
    seqAddLegacyTextConsumeCount: int32,
    structuredResultIntrinsicConsumeCount: int32
): bool =
    return structuredSeqAddConsumeCount == 0 &&
           seqAddLegacyTextConsumeCount == 0 &&
           structuredResultIntrinsicConsumeCount == 0

fn primaryLowerPoolWriteExact(
        fd: int32,
        bytes: var rawbytes.Bytes,
        count: int32) =
    if count < 0 || count > rawbytes.BytesLen(bytes):
        panic("primary_lower_pool_pipe_write_range_invalid")
    var off: int32
    while off < count:
        let n = hpool.HostPoolWriteBytes(fd, bytes, off, count - off)
        if n <= 0:
            panic("primary_lower_pool_pipe_write_failed")
        off = off + int32(n)

fn primaryLowerPoolReadExact(
        fd: int32,
        bytes: var rawbytes.Bytes,
        count: int32): bool =
    if count < 0 || count > rawbytes.BytesLen(bytes):
        panic("primary_lower_pool_pipe_read_range_invalid")
    var off: int32
    while off < count:
        let n = hpool.HostPoolReadBytes(fd, bytes, off, count - off)
        if n <= 0:
            return false
        off = off + int32(n)
    return true

fn primaryLowerPoolDiscardExact(fd: int32, count: int32): bool =
    if count < 0 || count > primaryLowerPoolMaxPayloadBytes:
        return false
    var scratch = rawbytes.BytesAlloc(4096)
    if scratch.data == nil:
        rawbytes.BytesFree(scratch)
        return false
    var remaining = count
    var ok = true
    while remaining > 0:
        var chunk = remaining
        if chunk > scratch.len:
            chunk = scratch.len
        if !primaryLowerPoolReadExact(fd, scratch, chunk):
            ok = false
            break
        remaining = remaining - chunk
    rawbytes.BytesFree(scratch)
    return ok

@borrows
fn primaryLowerPoolAbortStartedWorkers(pids: int32[], readFds: int32[]): bool =
    var ok = pids.len == readFds.len
    for i in 0..<readFds.len:
        if hpool.HostPoolClose(readFds[i]) != 0:
            ok = false
    # A worker can fail before its first pipe write. Closing the read end only
    # wakes writers; terminate every started worker before the blocking reap.
    for i in 0..<pids.len:
        let _signal = hpool.HostPoolSignal(int64(pids[i]), 9)
    for i in 0..<pids.len:
        var status: int32
        if hpool.HostPoolWaitpid(pids[i], status, 0) != pids[i]:
            ok = false
    return ok

@borrows
fn primaryLowerPoolPayloadReadU32(payload: rawbytes.Bytes,
                                  cursor: var int32,
                                  ok: var bool): int32 =
    if !ok || cursor < 0 || cursor > payload.len || payload.len - cursor < 4:
        ok = false
        return 0
    return b2fc.Backend2CodecReadU32(payload, cursor)

fn primaryLowerPoolPayloadExpectU32(payload: rawbytes.Bytes,
                                    cursor: var int32,
                                    expected: int32,
                                    ok: var bool) =
    if primaryLowerPoolPayloadReadU32(payload, cursor, ok) != expected:
        ok = false

@borrows
fn primaryLowerPoolPayloadSkipStr(payload: rawbytes.Bytes,
                                  cursor: var int32,
                                  ok: var bool) =
    let n = primaryLowerPoolPayloadReadU32(payload, cursor, ok)
    if !ok || n < 0 || cursor < 0 || cursor > payload.len ||
       n > payload.len - cursor:
        ok = false
        return
    cursor = cursor + n

fn primaryLowerPoolPayloadSkipI32Seq(payload: rawbytes.Bytes,
                                     cursor: var int32,
                                     ok: var bool) =
    let count = primaryLowerPoolPayloadReadU32(payload, cursor, ok)
    if !ok || count < 0 || cursor < 0 || cursor > payload.len ||
       count > (payload.len - cursor) / 4:
        ok = false
        return
    cursor = cursor + count * 4

fn primaryLowerPoolPayloadSkipFixed32Seq(payload: rawbytes.Bytes,
                                         cursor: var int32,
                                         ok: var bool) =
    let count = primaryLowerPoolPayloadReadU32(payload, cursor, ok)
    if !ok || count < 0 || cursor < 0 || cursor > payload.len ||
       count > (payload.len - cursor) / 32:
        ok = false
        return
    cursor = cursor + count * 32

fn primaryLowerPoolPayloadSkipI32SeqExactCount(
        payload: rawbytes.Bytes,
        cursor: var int32,
        expectedCount: int32,
        ok: var bool) =
    let count =
        primaryLowerPoolPayloadReadCount(payload, cursor, 4, ok)
    if !ok || count != expectedCount:
        ok = false
        return
    cursor = cursor + count * 4

fn primaryLowerPoolPayloadSkipFixed32SeqExactCount(
        payload: rawbytes.Bytes,
        cursor: var int32,
        expectedCount: int32,
        ok: var bool) =
    let count =
        primaryLowerPoolPayloadReadCount(payload, cursor, 32, ok)
    if !ok || count != expectedCount:
        ok = false
        return
    cursor = cursor + count * 32

fn primaryLowerPoolPayloadReadFixed32NonZero(
        payload: rawbytes.Bytes,
        cursor: var int32,
        ok: var bool): bool =
    if !ok || cursor < 0 || cursor > payload.len ||
       payload.len - cursor < 32:
        ok = false
        return false
    var nonZero = false
    for byteIndex in 0..<32:
        if rawbytes.BytesGet(payload, cursor + byteIndex) != 0:
            nonZero = true
    cursor = cursor + 32
    return nonZero

fn primaryLowerPoolPayloadReadCount(payload: rawbytes.Bytes,
                                    cursor: var int32,
                                    minBytesPerItem: int32,
                                    ok: var bool): int32 =
    let count = primaryLowerPoolPayloadReadU32(payload, cursor, ok)
    if !ok || count < 0 || minBytesPerItem <= 0 ||
       cursor < 0 || cursor > payload.len ||
       count > (payload.len - cursor) / minBytesPerItem:
        ok = false
        return 0
    return count

fn primaryLowerPoolPayloadReadI32SeqExactCount(
        payload: rawbytes.Bytes,
        cursor: var int32,
        expectedCount: int32,
        values: var int32[],
        ok: var bool) =
    if values.len != 0:
        ok = false
        return
    let count =
        primaryLowerPoolPayloadReadCount(payload, cursor, 4, ok)
    if !ok || count != expectedCount:
        ok = false
        return
    for row in 0..<count:
        add(values,
            primaryLowerPoolPayloadReadU32(payload, cursor, ok))
        if !ok:
            return

fn primaryLowerPoolPayloadReadI32Seq(
        payload: rawbytes.Bytes,
        cursor: var int32,
        values: var int32[],
        ok: var bool): int32 =
    if values.len != 0:
        ok = false
        return 0
    let count =
        primaryLowerPoolPayloadReadCount(payload, cursor, 4, ok)
    if !ok:
        return 0
    for row in 0..<count:
        add(values,
            primaryLowerPoolPayloadReadU32(payload, cursor, ok))
        if !ok:
            return 0
    return count

fn primaryLowerPoolPayloadReadFixed32SeqExactCount(
        payload: rawbytes.Bytes,
        cursor: var int32,
        expectedCount: int32,
        requireNonZero: bool,
        ok: var bool) =
    let count =
        primaryLowerPoolPayloadReadCount(payload, cursor, 32, ok)
    if !ok || count != expectedCount:
        ok = false
        return
    for row in 0..<count:
        let nonZero = primaryLowerPoolPayloadReadFixed32NonZero(
            payload, cursor, ok)
        if !ok || (requireNonZero && !nonZero):
            ok = false
            return

fn primaryLowerPoolCanonicalCsr(starts: var int32[],
                                counts: var int32[],
                                valueCount: int32,
                                requirePositive: bool): bool =
    if valueCount < 0 || starts.len != counts.len:
        return false
    var cursor: int32
    for row in 0..<starts.len:
        if starts[row] != cursor || counts[row] < 0 ||
           (requirePositive && counts[row] <= 0) ||
           counts[row] > valueCount - cursor:
            return false
        cursor = cursor + counts[row]
    return cursor == valueCount

fn primaryLowerPoolRangesCoverTail(starts: var int32[],
                                    counts: var int32[],
                                    originalCount: int32,
                                    finalCount: int32,
                                    requirePositive: bool): bool =
    if originalCount < 0 || finalCount < originalCount ||
       starts.len != counts.len:
        return false
    var cursor = originalCount
    for row in 0..<starts.len:
        let start = starts[row]
        let count = counts[row]
        if count < 0 || count > finalCount - cursor ||
           (requirePositive && count <= 0):
            return false
        if count == 0:
            # canonical bodyIRCleanupRangeValid(..., allowEmpty) only bounds an
            # empty range by the row domain; it does not require the empty row to
            # sit at the current coverage frontier.
            if start < originalCount || start > finalCount:
                return false
        else:
            if start != cursor:
                return false
            cursor = cursor + count
    return cursor == finalCount

fn primaryLowerPoolNonEmptyRangesValid(starts: var int32[],
                                       counts: var int32[],
                                       originalCount: int32,
                                       finalCount: int32): bool =
    # canonical bodyIRCleanupRangeValid(..., allowEmpty=false) applied row by row,
    # plus canonical's ordering / non-overlap clause.  Global coverage is checked
    # separately by the two anchor-aware helpers below.
    if originalCount < 0 || finalCount < originalCount ||
       starts.len != counts.len:
        return false
    for row in 0..<starts.len:
        let count = counts[row]
        if count <= 0 || count > finalCount ||
           starts[row] < originalCount ||
           starts[row] > finalCount - count:
            return false
        if row > 0:
            if starts[row] < starts[row - 1] + counts[row - 1]:
                return false
    return true

fn primaryLowerPoolBlockCoverageValid(starts: var int32[],
                                      counts: var int32[],
                                      originalCount: int32,
                                      finalCount: int32,
                                      ownerSources: var int32[],
                                      ownerContinuations: var int32[]): bool =
    # canonical bodyIRCleanupScheduleCoverageValid, block clause: a tail block is
    # either owned by exactly one unit and is not an owner anchor, or owned by no
    # unit and is one (source / final continuation of some owner row).
    if originalCount < 0 || finalCount < originalCount ||
       starts.len != counts.len ||
       ownerSources.len != ownerContinuations.len:
        return false
    for blockRow in originalCount..<finalCount:
        var unitOwnerCount: int32
        var anchor = false
        for row in 0..<starts.len:
            if blockRow >= starts[row] &&
               blockRow < starts[row] + counts[row]:
                unitOwnerCount = unitOwnerCount + 1
        for ownerRow in 0..<ownerSources.len:
            if ownerSources[ownerRow] == blockRow ||
               ownerContinuations[ownerRow] == blockRow:
                anchor = true
        if unitOwnerCount > 1 ||
           (unitOwnerCount == 1 && anchor) ||
           (unitOwnerCount == 0 && !anchor):
            return false
    return true

fn primaryLowerPoolTermCoverageValid(starts: var int32[],
                                     counts: var int32[],
                                     originalCount: int32,
                                     finalCount: int32,
                                     ownerSourceTermRows: var int32[],
                                     ownerSources: var int32[],
                                     ownerContinuations: var int32[],
                                     blockTermIndexes: var int32[]): bool =
    # canonical bodyIRCleanupScheduleCoverageValid, term clause: the anchor test
    # also looks at the term index of the owner's source and continuation blocks.
    if originalCount < 0 || finalCount < originalCount ||
       starts.len != counts.len ||
       ownerSourceTermRows.len != ownerSources.len ||
       ownerSources.len != ownerContinuations.len:
        return false
    for termRow in originalCount..<finalCount:
        var unitOwnerCount: int32
        var anchor = false
        for row in 0..<starts.len:
            if termRow >= starts[row] &&
               termRow < starts[row] + counts[row]:
                unitOwnerCount = unitOwnerCount + 1
        for ownerRow in 0..<ownerSourceTermRows.len:
            if ownerSourceTermRows[ownerRow] == termRow:
                anchor = true
            let sourceBlockId = ownerSources[ownerRow]
            if sourceBlockId >= 0 && sourceBlockId < blockTermIndexes.len:
                if blockTermIndexes[sourceBlockId] == termRow:
                    anchor = true
            let continuationBlockId = ownerContinuations[ownerRow]
            if continuationBlockId >= 0 &&
               continuationBlockId < blockTermIndexes.len:
                if blockTermIndexes[continuationBlockId] == termRow:
                    anchor = true
        if unitOwnerCount > 1 ||
           (unitOwnerCount == 1 && anchor) ||
           (unitOwnerCount == 0 && !anchor):
            return false
    return true

fn primaryLowerPoolCleanupOwnerUnitCsrValid(
        exitStarts: var int32[],
        exitCounts: var int32[],
        siteStarts: var int32[],
        siteCounts: var int32[],
        unitCount: int32): bool =
    if unitCount <= 0 || exitStarts.len != exitCounts.len ||
       siteStarts.len != siteCounts.len:
        return false
    var cursor: int32
    for row in 0..<exitStarts.len:
        if exitStarts[row] != cursor || exitCounts[row] <= 0 ||
           exitCounts[row] > unitCount - cursor:
            return false
        cursor = cursor + exitCounts[row]
    for row in 0..<siteStarts.len:
        if siteStarts[row] != cursor || siteCounts[row] <= 0 ||
           siteCounts[row] > unitCount - cursor:
            return false
        cursor = cursor + siteCounts[row]
    return cursor == unitCount

fn primaryLowerPoolCleanupScheduleEffectsValid(
        unitSemanticStarts: var int32[],
        unitSemanticCounts: var int32[],
        opStarts: var int32[],
        opCounts: var int32[],
        callStarts: var int32[],
        callCounts: var int32[],
        termStarts: var int32[],
        termCounts: var int32[],
        unitEffectStarts: var int32[],
        unitEffectCounts: var int32[],
        effectSemanticRows: var int32[],
        effectPhysicalDomains: var int32[],
        effectPhysicalRows: var int32[],
        effectRoles: var int32[]): bool =
    let unitCount = unitSemanticStarts.len
    let effectCount = effectSemanticRows.len
    if unitCount <= 0 || unitSemanticCounts.len != unitCount ||
       opStarts.len != unitCount || opCounts.len != unitCount ||
       callStarts.len != unitCount || callCounts.len != unitCount ||
       termStarts.len != unitCount || termCounts.len != unitCount ||
       effectPhysicalDomains.len != effectCount ||
       effectPhysicalRows.len != effectCount ||
       effectRoles.len != effectCount ||
       !primaryLowerPoolCanonicalCsr(
           unitEffectStarts, unitEffectCounts, effectCount, true):
        return false
    for unitRow in 0..<unitCount:
        let semanticStart = unitSemanticStarts[unitRow]
        let semanticCount = unitSemanticCounts[unitRow]
        if semanticStart < 0 || semanticCount <= 0 ||
           semanticStart > 2147483647 - semanticCount:
            return false
        let effectStart = unitEffectStarts[unitRow]
        let effectUnitCount = unitEffectCounts[unitRow]
        for offset in 0..<effectUnitCount:
            let effectRow = effectStart + offset
            let semanticRow = effectSemanticRows[effectRow]
            let physicalDomain = effectPhysicalDomains[effectRow]
            let physicalRow = effectPhysicalRows[effectRow]
            let role = effectRoles[effectRow]
            if semanticRow < semanticStart ||
               semanticRow - semanticStart >= semanticCount ||
               role < coreir.BodyCleanupEffectRoleDefinitionTag ||
               role > coreir.BodyCleanupEffectRolePredicateTag:
                return false
            if physicalDomain ==
                   coreir.BodyCleanupEffectDomainBodyOpTag:
                if physicalRow < opStarts[unitRow] ||
                   physicalRow - opStarts[unitRow] >= opCounts[unitRow]:
                    return false
            elif physicalDomain ==
                     coreir.BodyCleanupEffectDomainCallOpTag:
                if physicalRow < callStarts[unitRow] ||
                   physicalRow - callStarts[unitRow] >=
                       callCounts[unitRow]:
                    return false
            elif physicalDomain ==
                     coreir.BodyCleanupEffectDomainBodyTermTag:
                if physicalRow < termStarts[unitRow] ||
                   physicalRow - termStarts[unitRow] >=
                       termCounts[unitRow]:
                    return false
            else:
                return false
    return true

fn PrimaryLowerPoolBodyIrPayloadPrevalidate(payload: rawbytes.Bytes): bool =
    if payload.len <= 0 || payload.len > primaryLowerPoolMaxPayloadBytes:
        return false
    var cursor: int32
    var ok = true
    primaryLowerPoolPayloadExpectU32(
        payload, cursor, b2fc.Backend2BodyIrCodecMagic(), ok)
    primaryLowerPoolPayloadExpectU32(
        payload, cursor, b2fc.Backend2BodyIrCodecFieldCount(), ok)
    primaryLowerPoolPayloadExpectU32(payload, cursor, 1, ok)
    let opCount = primaryLowerPoolPayloadReadCount(payload, cursor, 64, ok)
    var prevalidateOpKinds: int32[]
    var prevalidateOpCallOrdinals: int32[]
    for i in 0..<opCount:
        let kind = primaryLowerPoolPayloadReadU32(payload, cursor, ok)
        let _target = primaryLowerPoolPayloadReadU32(payload, cursor, ok)
        let _valueDefSlot = primaryLowerPoolPayloadReadU32(payload, cursor, ok)
