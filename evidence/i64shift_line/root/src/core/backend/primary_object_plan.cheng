                                                 717,
                                                 indexedElemSize)
                    return true
                var indexedFieldStoreOp: coreir.BodyOp
                indexedFieldStoreOp.kind = coreir.BodyOpIndexedStoreTag
                indexedFieldStoreOp.target = indexedSeqSlot
                add(indexedFieldStoreOp.operands, indexedSeqSlot)
                add(indexedFieldStoreOp.operands, indexedValueSlot)
                add(indexedFieldStoreOp.operands, indexedSlot)
                add(indexedFieldStoreOp.operands, indexedElemSize)
                if indexedFieldIsDynamicSeq:
                    add(indexedFieldStoreOp.operands, 1)
                let _ = coreir.BodyIRAppendOp(bodyIR, indexedFieldStoreOp)
                if !indexedFieldIsDynamicSeq:
                    var indexedFieldWritebackOp: coreir.BodyOp
                    indexedFieldWritebackOp.kind = coreir.BodyOpFieldStoreTag
                    indexedFieldWritebackOp.target = baseSlot
                    add(indexedFieldWritebackOp.operands, baseSlot)
                    add(indexedFieldWritebackOp.operands, indexedSeqSlot)
                    add(indexedFieldWritebackOp.operands, indexedFieldOffsetBytes)
                    add(indexedFieldWritebackOp.operands, indexedFieldSizeBytes)
                    let _ = coreir.BodyIRAppendOp(bodyIR, indexedFieldWritebackOp)
                return true
            if PrimaryStartsWith(texpr.TypedExprNormalizeTypeText(indexedFieldType), "uint8["):
                # Fixed uint8[N] array field byte store: root.field[idx] = v.
                let fixedU8BaseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                                             slotNames,
                                                                             lowering.typedIr,
                                                                             stmt_sourcePath,
                                                                             stmt_assignRootName,
                                                                             assignRootType)
                var fixedU8IdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                         slotNames,
                                                                         varI32ParamNames,
                                                                         lowering.typedIr,
                                                                         stmt_sourcePath,
                                                                         indexedFieldIndexText,
                                                                         coreir.LocalI32Tag, callOrdinal)
                if fixedU8IdxSlot >= 0 && indexedFieldOffsetBytes > 0:
                    let fixedU8OffSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                         slotNames,
                                                                         Fmt"#fixed_u8_off#{bodyIR.ops.len}",
                                                                         coreir.LocalI32Tag,
                                                                         indexedFieldOffsetBytes)
                    let fixedU8AdjSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                       slotNames,
                                                                       Fmt"#fixed_u8_adj#{bodyIR.ops.len}",
                                                                       coreir.LocalI32Tag)
                    if fixedU8OffSlot < 0 || fixedU8AdjSlot < 0:
                        fixedU8IdxSlot = -1
                    else:
                        var fixedU8AddOp: coreir.BodyOp
                        fixedU8AddOp.kind = coreir.BodyOpBinOpTag
                        fixedU8AddOp.target = fixedU8AdjSlot
                        add(fixedU8AddOp.operands, coreir.LocalI32Tag)
                        add(fixedU8AddOp.operands, int32(texpr.TypedExprIrOpI32Add))
                        add(fixedU8AddOp.operands, fixedU8IdxSlot)
                        add(fixedU8AddOp.operands, fixedU8OffSlot)
                        let _ = coreir.BodyIRAppendOp(bodyIR, fixedU8AddOp)
                        fixedU8IdxSlot = fixedU8AdjSlot
                var fixedU8ValueText = strings.CloneStr(rhsText)
                let fixedU8Inner = PrimaryBodyIrTypeCastInnerForTarget(rhsText, "uint8")
                if fixedU8Inner != "":
                    fixedU8ValueText = strutil.Strip(fixedU8Inner)
                let fixedU8ValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering.typedIr,
                                                                           stmt_sourcePath,
                                                                           fixedU8ValueText,
                                                                           coreir.LocalI32Tag, callOrdinal)
                if fixedU8BaseSlot < 0 || fixedU8IdxSlot < 0 || fixedU8ValueSlot < 0:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt_lineNumber,
                                                 int32(stmt_kind),
                                                 717,
                                                 1)
                    return true
                var fixedU8StoreOp: coreir.BodyOp
                fixedU8StoreOp.kind = coreir.BodyOpIndexedStoreTag
                fixedU8StoreOp.target = fixedU8BaseSlot
                add(fixedU8StoreOp.operands, fixedU8BaseSlot)
                add(fixedU8StoreOp.operands, fixedU8ValueSlot)
                add(fixedU8StoreOp.operands, fixedU8IdxSlot)
                add(fixedU8StoreOp.operands, 1)
                let _ = coreir.BodyIRAppendOp(bodyIR, fixedU8StoreOp)
                return true
        # A typed short-circuit field RHS owns both value materialization and
        # the final store. Run it before every text/call/value resolver so no
        # eager or partial alternative can precede the ownership boundary.
        if stmt_rhsNodeIndex >= 0 &&
           stmt_rhsNodeIndex < lowering.typedIr.nodes2_opKinds.len &&
           PrimaryBodyIrTypeKindFromText(assignFieldType) == coreir.LocalI32Tag &&
           PrimaryBodyIrNodeIsShortCircuitChainRoot(lowering.typedIr, stmt_rhsNodeIndex):
            var assignBoolChainSlot: int32
            let assignBoolChainOutcome = PrimaryBodyIrAppendNodeBoolConditionChain(bodyIR,
                                                                                   slotNames,
                                                                                   varI32ParamNames,
                                                                                   lowering,

                                                                                   typedFn,
                                                                                   irFunction,
                                                                                   stmt_rhsNodeIndex,
                                                                                   callOrdinal,
                                                                                   currentBlockStart,
                                                                                   assignBoolChainSlot)
            if assignBoolChainOutcome == PrimaryBodyIrNodeBoolChainClaimedFailed:
                PrimaryBodyIrNodeEvalOnlyOwn()
                return true
            if assignBoolChainOutcome != PrimaryBodyIrNodeBoolChainSuccess:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt_lineNumber,
                                             int32(stmt_kind),
                                             6101,
                                             0)
                PrimaryBodyIrNodeEvalOnlyOwn()
                return true
            if assignBoolChainOutcome == PrimaryBodyIrNodeBoolChainSuccess:
                if assignBoolChainSlot < 0 ||
                   assignBoolChainSlot >= bodyIR.localSlots.len ||
                   PrimaryLocalSlotSizeOf(bodyIR.localSlots[assignBoolChainSlot]) < byteCount:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt_lineNumber,
                                                 int32(stmt_kind),
                                                 713,
                                                 0)
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    return true
                var assignBoolStoreOp: coreir.BodyOp
                assignBoolStoreOp.kind = coreir.BodyOpFieldStoreTag
                assignBoolStoreOp.target = baseSlot
                add(assignBoolStoreOp.operands, baseSlot)
                add(assignBoolStoreOp.operands, assignBoolChainSlot)
                add(assignBoolStoreOp.operands, assignFieldOffsetBytes)
                add(assignBoolStoreOp.operands, byteCount)
                let _ = coreir.BodyIRAppendOp(bodyIR, assignBoolStoreOp)
                PrimaryBodyIrNodeEvalOnlyOwn()
                return true
        var valueSlot: int32
        valueSlot = -1
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"assign_field_value_begin function={typedFnName} line={stmt_lineNumber} byte_count={byteCount}")
        if stmt_callTarget != "":
            let callResultType = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
            valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                           slotNames,
                                                           lowering.typedIr,
                                                           PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                           rhsText,
                                                           callResultType)
            if valueSlot < 0 ||
               PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < byteCount:
                return false
            let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                              slotNames,
                                              lowering,

                                              typedFn,
                                              irFunction,
                                              stmt,
                                              valueSlot,
                                              varI32ParamNames,
                                              callOrdinal,
                                              currentBlockStart)
        elif stmt_assignValueFieldName != "":
            let valueBaseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                                       slotNames,
                                                                       lowering.typedIr,
                                                                       stmt_sourcePath,
                                                                       stmt_assignValueRootName,
                                                                       stmt_assignValueRootType)
            let valueByteCount = stmt_assignValueFieldSizeBytes
            if valueBaseSlot < 0:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt_lineNumber,
                                             int32(stmt_kind),
                                             714,
                                             0)
                return true
            if valueByteCount <= 0:
                valueByteCount = byteCount
            if valueByteCount != byteCount:
                return false
            valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                           slotNames,
                                                           lowering.typedIr,
                                                           stmt_sourcePath,
                                                           Fmt"{stmt_assignValueRootName}.{stmt_assignValueFieldName}#field_value",
                                                           stmt_assignValueFieldType)
            if PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < valueByteCount:
                return false
            var loadOp: coreir.BodyOp
            loadOp.kind = coreir.BodyOpFieldLoadTag
            loadOp.target = valueSlot
            add(loadOp.operands, valueBaseSlot)
            add(loadOp.operands, valueSlot)
            add(loadOp.operands, stmt_assignValueFieldOffsetBytes)
            add(loadOp.operands, valueByteCount)
            let _ = coreir.BodyIRAppendOp(bodyIR, loadOp)
        else:
            var byteCountFitsI32: bool
            if byteCount > 0:
                if byteCount <= 4:
                    byteCountFitsI32 = true
            if byteCountFitsI32:
                valueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       lowering.typedIr,
                                                                       share(typedFn),
                                                                       irFunction,
                                                                       stmt_sourcePath,
                                                                       stmt_lineNumber,
                                                                       rhsText,
                                                                       coreir.LocalI32Tag)
        if valueSlot < 0:
            var byteCountFitsPtr: bool
            if byteCount == 8:
                if assignFieldType == "ptr":
                    byteCountFitsPtr = true
                elif assignFieldType == "cstring":
                    byteCountFitsPtr = true
                elif PrimaryBodyIrTypeKindFromText(assignFieldType) == coreir.LocalPtrTag:
                    byteCountFitsPtr = true
            if byteCountFitsPtr:
                valueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       lowering.typedIr,
                                                                       share(typedFn),
                                                                       irFunction,
                                                                       stmt_sourcePath,
                                                                       stmt_lineNumber,
                                                                       rhsText,
                                                                       coreir.LocalPtrTag)
        elif byteCount == 8:
            valueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering.typedIr,
                                                                   share(typedFn),
                                                                   irFunction,
                                                                   stmt_sourcePath,
                                                                   stmt_lineNumber,
                                                                   rhsText,
                                                                   coreir.LocalI64Tag)
        else:
            if rhsText == "[]" || rhsText == "{}":
                valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"{stmt_assignFieldName}_zero",
                                                           coreir.LocalAggregateTag)
            else:
                valueSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
        let rhsBindingType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                             typedFn,
                                                             irFunction,
                                                             stmt_lineNumber,
                                                             rhsText)
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"assign_field_binding_done function={typedFnName} line={stmt_lineNumber} rhs_type={rhsBindingType} value_slot={valueSlot}")
        if rhsBindingType != "" &&
           !PrimaryBodyIrTextHasCallSurface(rhsText) &&
           !PrimaryBodyIrTextHasFieldOrIndex(rhsText) &&
           !strutil.Contains(rhsText, "->") &&
           (len(rhsText) <= 0 || (rhsText[0] != '*' && rhsText[0] != '&')):
            # Binding-typed override only for plain local/param names; for
            # deref/field/call expressions a find-or-create here would alias
            # an uninitialized slot over the resolved value.
            let typedValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                    slotNames,
                                                                    lowering.typedIr,
                                                                    stmt_sourcePath,
                                                                    rhsText,
                                                                    rhsBindingType)
            if typedValueSlot >= 0:
                valueSlot = typedValueSlot
        PrimaryObjectPlanGuardTick()
        if PrimaryObjectPlanProgressEnabled():
            PrimaryObjectPlanProgress(Fmt"assign_field_value_done function={typedFnName} line={stmt_lineNumber} value_slot={valueSlot}")
        # field = <ZeroArgCtor()> where stmt_callTarget is unset (e.g. namespaced
        # ctor `obj.field = parser.NormalizedExprLayer()`): the resolved-call
        # branch above is skipped (it keys on stmt_callTarget), so AppendCallOp's
        # ctor_call_zeroinit path is unreachable. Decode the call head from the
        # RHS text and, for a genuine zero-arg aggregate constructor, zero-init a
        # typed temp slot (mirrors AppendCallOp lines ~17446). The empty-args gate
        # is load-bearing: a named-field ctor `Type(field: v)` also has empty
        # positional args and must NOT be zeroed.
        if valueSlot < 0 &&
           PrimaryBodyIrTextHasCallSurface(rhsText) &&
           assignFieldType != "" &&
           assignFieldType != "unknown":
            let ctorOpenPos = texpr.TypedExprFindWholeCallOpenParen(rhsText)
            if ctorOpenPos > 0:
                let ctorClosePos = texpr.TypedExprFindMatchingParen(rhsText, ctorOpenPos)
                if ctorClosePos > ctorOpenPos && ctorClosePos + 1 == len(rhsText):
                    let ctorHead = strutil.Strip(strings.SliceBytes(rhsText, 0, ctorOpenPos))
                    let ctorArgsInner = strutil.Strip(strings.SliceBytes(rhsText,
                                                                         ctorOpenPos + 1,
                                                                         ctorClosePos - ctorOpenPos - 1))
                    if ctorHead != "" &&
                       ctorArgsInner == "" &&
                       PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr, stmt_sourcePath, ctorHead):
                        let ctorCallSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                              slotNames,
                                                                              lowering.typedIr,
                                                                              stmt_sourcePath,
                                                                              Fmt"{stmt_assignFieldName}_rhs_ctor#{bodyIR.ops.len}",
                                                                              ctorHead)
                        if ctorCallSlot >= 0 &&
                           PrimaryBodyIrAppendZeroLocalSlot(bodyIR, slotNames, ctorCallSlot, callOrdinal):
                            valueSlot = ctorCallSlot
        if valueSlot < 0 && PrimaryBodyIrTextIsStrSlice(rhsText):
            valueSlot = PrimaryBodyIrLowerStrSliceToSlot(bodyIR, slotNames, varI32ParamNames, lowering.typedIr, typedFn, irFunction, stmt_sourcePath, stmt_lineNumber, rhsText, stmt_assignFieldName, callOrdinal)
        if valueSlot < 0:
            let selfFieldArithName = Fmt"{stmt_assignRootName}.{stmt_assignFieldName}"
            let selfFieldArithTypeKind = PrimaryBodyIrTypeKindFromText(assignFieldType)
            valueSlot = PrimaryBodyIrLowerSelfFieldArithRhsToSlot(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering.typedIr,
                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt_sourcePath,
                                                                  stmt_lineNumber,
                                                                  rhsText,
                                                                  baseSlot,
                                                                  assignFieldOffsetBytes,
                                                                  byteCount,
                                                                  selfFieldArithName,
                                                                  selfFieldArithTypeKind)

        # 字段赋值 RHS 为复杂表达式(二元式如 `gArr[idx].field + d`、含索引全局元素字段读)
        # 时,plain/Context 标量解析器解不出 → 落 bail_712。短路根已在进入这些
        # 通用路径前由 typed CBR 链接管，避免通用 EvalNode 半发射后再重试。
        if valueSlot < 0 && stmt_rhsNodeIndex >= 0:
            primaryBodyIrNodeEvalMissOp = ""
            var rhsAssignExpectedKind: int32
            var rhsAssignExpectedSize: int32
            var rhsAssignExpectedAlign: int32
            PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                           stmt_sourcePath,
                                           assignFieldType,
                                           rhsAssignExpectedKind,
                                           rhsAssignExpectedSize,
                                           rhsAssignExpectedAlign)
            let rhsAssignKindSupported = rhsAssignExpectedKind == coreir.LocalI32Tag ||
                                         rhsAssignExpectedKind == coreir.LocalI64Tag ||
                                         rhsAssignExpectedKind == coreir.LocalF64Tag ||
                                         rhsAssignExpectedKind == coreir.LocalPtrTag
            if rhsAssignKindSupported &&
               rhsAssignExpectedSize > 0 &&
               rhsAssignExpectedAlign > 0:
                var rhsAssignReceipt: PrimaryBodyIrNodeBoolChainTransactionReceipt
                let rhsAssignOutcome = PrimaryBodyIrEvalNodeToExpectedSlotTransactional(
                    bodyIR,
                    slotNames,
                    varI32ParamNames,
                    lowering,

                    typedFn,
                    irFunction,
                    stmt_rhsNodeIndex,
                    rhsAssignExpectedKind,
                    byteCount,
                    false,
                    callOrdinal,
                    currentBlockStart,
                    valueSlot,
                    rhsAssignReceipt)
                if rhsAssignOutcome == PrimaryBodyIrNodeBoolChainClaimedFailed:
                    return true

        # wave14-fam712-rootB: field assign RHS = bare MODULE-GLOBAL aggregate
        # variable name (e.g. `state.localKeySharePriv = msquicTls13ServerLocal
        # KeySharePrivCache`, both `Bytes`). The byteCount classifier above only
        # covers scalar widths (<=4 / ==8) — an aggregate-width RHS falls through
        # with valueSlot<0, landing on the 712 exit below. Reuse
        # PrimaryBodyIrGlobalSeqAddressSlot (the shared address-of-aggregate-
        # global primitive already used for indexed global reads elsewhere in
        # this file) to get the global's address, then FieldLoadTag-copy exactly
        # byteCount bytes from offset 0 into a fresh field-typed value slot —
        # mirrors the `stmt_assignValueFieldName != ""` sibling branch above
        # verbatim, just sourced from a global address instead of another
        # field's base. G1 strict-match: only fires when the field is
        # aggregate-shaped AND the global's own shape kind/size equal the
        # field's exactly; any mismatch (scalar field, non-aggregate global,
        # size mismatch, missing global registration) falls straight through to
        # the 712 exit below — poison-on-miss, no silent fallback.
        #
        # w13 曾拒绝本分支单独出补丁：GlobalSeqAddressSlot 物化出的全局地址读值
        # 正确，但当时全局聚合"写入"侧另有一个独立的、更早存在的静默 miscompile
        # （AppendI32Assign 的 assign_copy_local 快路径对全局 LHS 建幽灵栈局部槽，
        # 真全局数据标号从未被写——与本分支毫无关系，本分支只读不写）。该写入侧
        # 缺陷已在本文件另一处根修（PrimaryBodyIrFindOrCreateTypedSlot 幽灵槽
        # 前置 assignCopyLocalLhsIsGlobal 门禁），6 个 w13 repro 夹具 + 新增
        # pairwhole 夹具运行时值断言全绿后，本分支的读地址逻辑本身（经 diag8/9/10
        # 对照组验证过 GlobalSeqAddressSlot+FieldLoadTag 语义正确）可以安全接回。
        if valueSlot < 0 &&
           !PrimaryBodyIrTextHasCallSurface(rhsText) &&
           !PrimaryBodyIrTextHasFieldOrIndex(rhsText) &&
           !strutil.Contains(rhsText, "->") &&
           (len(rhsText) <= 0 || (rhsText[0] != '*' && rhsText[0] != '&')) &&
           PrimaryBodyIrTypeKindFromText(assignFieldType) == coreir.LocalAggregateTag:
            let fam712bGlobalType = PrimaryBodyIrTypedGlobalType(lowering.typedIr, stmt_sourcePath, rhsText)
            if fam712bGlobalType != "":
                var fam712bGlobalKind: int32
                var fam712bGlobalSize: int32
                var fam712bGlobalAlign: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               stmt_sourcePath,
                                               fam712bGlobalType,
                                               fam712bGlobalKind,
                                               fam712bGlobalSize,
                                               fam712bGlobalAlign)
                if fam712bGlobalKind == coreir.LocalAggregateTag && fam712bGlobalSize == byteCount:
                    let fam712bGlobalAddrSlot = PrimaryBodyIrGlobalSeqAddressSlot(bodyIR,
                                                                                  slotNames,
                                                                                  lowering.typedIr,
                                                                                  stmt_sourcePath,
                                                                                  rhsText)
                    if fam712bGlobalAddrSlot >= 0:
                        let fam712bGlobalValueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                                        slotNames,
                                                                                        lowering.typedIr,
                                                                                        stmt_sourcePath,
                                                                                        Fmt"{rhsText}#global_agg_value#{stmt_lineNumber}",
                                                                                        assignFieldType)
                        if fam712bGlobalValueSlot >= 0 &&
                           PrimaryLocalSlotSizeOf(bodyIR.localSlots[fam712bGlobalValueSlot]) >= byteCount:
                            var fam712bGlobalLoadOp: coreir.BodyOp
                            fam712bGlobalLoadOp.kind = coreir.BodyOpFieldLoadTag
                            fam712bGlobalLoadOp.target = fam712bGlobalValueSlot
                            add(fam712bGlobalLoadOp.operands, fam712bGlobalAddrSlot)
                            add(fam712bGlobalLoadOp.operands, fam712bGlobalValueSlot)
                            add(fam712bGlobalLoadOp.operands, 0)
                            add(fam712bGlobalLoadOp.operands, byteCount)
                            let _ = coreir.BodyIRAppendOp(bodyIR, fam712bGlobalLoadOp)
                            valueSlot = fam712bGlobalValueSlot

        if valueSlot < 0:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt_lineNumber,
                                         int32(stmt_kind),
                                         712,
                                         0)
            return true
        if rhsText != "[]" && rhsText != "{}" &&
           PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < byteCount:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         stmt_lineNumber,
                                         int32(stmt_kind),
                                         713,
                                         PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]))
            return true
        var storeOp: coreir.BodyOp
        storeOp.kind = coreir.BodyOpFieldStoreTag
        storeOp.target = baseSlot
        add(storeOp.operands, baseSlot)
        add(storeOp.operands, valueSlot)
        add(storeOp.operands, assignFieldOffsetBytes)
        add(storeOp.operands, byteCount)
        let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
        return true
    if PrimaryBodyIrTextHasFieldOrIndex(lhsName):
        var indexRoot = ""
        var indexText = ""
        if PrimaryBodyIrIndexExprParts(lhsName, indexRoot, indexText):
            let rootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, indexRoot)
            if rootSlot < 0 && PrimaryBodyIrTextHasDot(indexRoot):
                # Fixed uint8[N] array field byte store via dotted root:
                # root.field[idx] = v.
                let dotFieldRootName = texpr.TypedExprAssignLhsRootName(indexRoot)
                let dotFieldPath = texpr.TypedExprAssignFieldPath(indexRoot)
                var dotRootType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt_lineNumber,
                                                                  dotFieldRootName)
                var dotFieldType = ""
                var dotFieldOffsetBytes: int32
                var dotFieldSizeBytes: int32
                var dotFieldAlignBytes: int32
                if dotFieldRootName != "" &&
                   dotFieldPath != "" &&
                   dotRootType != "" &&
                   PrimaryBodyIrLookupSingleFieldMeta(lowering.typedIr,
                                                      stmt_sourcePath,
                                                      dotRootType,
                                                      dotFieldPath,
                                                      dotFieldType,
                                                      dotFieldOffsetBytes,
                                                      dotFieldSizeBytes,
                                                      dotFieldAlignBytes) &&
                   PrimaryStartsWith(texpr.TypedExprNormalizeTypeText(dotFieldType), "uint8["):
                    let dotBaseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                                             slotNames,
                                                                             lowering.typedIr,
                                                                             stmt_sourcePath,
                                                                             dotFieldRootName,
                                                                             dotRootType)
                    var dotIdxSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                         slotNames,
                                                                         varI32ParamNames,
                                                                         lowering.typedIr,
                                                                         stmt_sourcePath,
                                                                         indexText,
                                                                         coreir.LocalI32Tag, callOrdinal)
                    if dotIdxSlot >= 0 && dotFieldOffsetBytes > 0:
                        let dotOffSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                                         slotNames,
                                                                         Fmt"#dot_u8_off#{bodyIR.ops.len}",
                                                                         coreir.LocalI32Tag,
                                                                         dotFieldOffsetBytes)
                        let dotAdjSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                       slotNames,
                                                                       Fmt"#dot_u8_adj#{bodyIR.ops.len}",
                                                                       coreir.LocalI32Tag)
                        if dotOffSlot < 0 || dotAdjSlot < 0:
                            dotIdxSlot = -1
                        else:
                            var dotAddOp: coreir.BodyOp
                            dotAddOp.kind = coreir.BodyOpBinOpTag
                            dotAddOp.target = dotAdjSlot
                            add(dotAddOp.operands, coreir.LocalI32Tag)
                            add(dotAddOp.operands, int32(texpr.TypedExprIrOpI32Add))
                            add(dotAddOp.operands, dotIdxSlot)
                            add(dotAddOp.operands, dotOffSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, dotAddOp)
                            dotIdxSlot = dotAdjSlot
                    var dotValueText = strings.CloneStr(rhsText)
                    let dotU8Inner = PrimaryBodyIrTypeCastInnerForTarget(rhsText, "uint8")
                    if dotU8Inner != "":
                        dotValueText = strutil.Strip(dotU8Inner)
                    let dotValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering.typedIr,
                                                                           stmt_sourcePath,
                                                                           dotValueText,
                                                                           coreir.LocalI32Tag, callOrdinal)
                    if dotBaseSlot >= 0 && dotIdxSlot >= 0 && dotValueSlot >= 0:
                        var dotStoreOp: coreir.BodyOp
                        dotStoreOp.kind = coreir.BodyOpIndexedStoreTag
                        dotStoreOp.target = dotBaseSlot
                        add(dotStoreOp.operands, dotBaseSlot)
                        add(dotStoreOp.operands, dotValueSlot)
                        add(dotStoreOp.operands, dotIdxSlot)
                        add(dotStoreOp.operands, 1)
                        let _ = coreir.BodyIRAppendOp(bodyIR, dotStoreOp)
                        return true
            if rootSlot < 0 || rootSlot >= bodyIR.localSlots.len:
                return false
            var elemKind = coreir.LocalI32Tag
            var elemSize = 4
            var indexedStoreIsSeq: bool
            var seqElemKind: int32
            var seqElemSize: int32
            var indexedRootType = texpr.TypedExprStripVarType(stmt_assignRootType)
            if PrimaryBodyIrSeqElementShapeFromText(lowering.typedIr,
                                                    stmt_sourcePath,
                                                    indexedRootType,
                                                    seqElemKind,
                                                    seqElemSize):
                elemKind = seqElemKind
                elemSize = seqElemSize
                indexedStoreIsSeq = PrimaryBodyIrTypeTextIsDynamicSeq(indexedRootType)
            # var seq params hold the header address in a ptr slot; the seq
            # deref flag makes the fill resolve the data pointer for both
            # aggregate locals and ptr params.
            if bodyIR.localSlots[rootSlot].typeKind != coreir.LocalAggregateTag &&
               !(bodyIR.localSlots[rootSlot].typeKind == coreir.LocalPtrTag && indexedStoreIsSeq):
                return false
            let indexSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering.typedIr,
                                                                stmt_sourcePath,
                                                                indexText,
                                                                coreir.LocalI32Tag, callOrdinal)
            var valueText = strings.CloneStr(rhsText)
            if elemSize == 1:
                let u8Inner = PrimaryBodyIrTypeCastInnerForTarget(rhsText, "uint8")
                if u8Inner != "":
                    valueText = u8Inner
            var valueKind = elemKind
            if elemSize == 1:
                valueKind = coreir.LocalI32Tag
            let indexedElemTypeText = PrimaryBodyIrIndexedElementTypeText(indexedRootType)
            var valueSlot: int32 = -1
            # bail=706 (R-C): `raw[int(i)] = uint8(call(...) & 255)` — value 含
            # 调用+尾算术, whole-call 臂只认整调用文本必 miss → return false →
            # bail_706;callTarget 臂又会把语句首个 call(可能是索引里的 cast)误当
            # 值调用。node-primary: 先 NodeEvalProbe 零发射预检 rhs 节点可解且槽
            # 形严等 valueKind, 命中再 EvalNode 物化(cast/binop/CallExpr/str-index
            # 全形, 调用经节点位 ordinal 与 call-sequence 对齐)。miss 不动, 落回
            # 既有文本臂链(行为不变)。
            if stmt_rhsNodeIndex >= 0 &&
               stmt_rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               (valueKind == coreir.LocalI32Tag ||
                valueKind == coreir.LocalI64Tag ||
                valueKind == coreir.LocalPtrTag):
                let idxStoreProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering,

                                                                   share(typedFn),
                                                                   irFunction,
                                                                   stmt_rhsNodeIndex)
                if idxStoreProbeKind == valueKind:
                    let idxStoreEmitMark = primaryBodyIrNodeEvalCallEmitCount
                    let idxStoreNodeSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 lowering,

                                                                 share(typedFn),
                                                                 irFunction,
                                                                 stmt_rhsNodeIndex,
                                                                 callOrdinal)
                    if idxStoreNodeSlot >= 0 &&
                       idxStoreNodeSlot < bodyIR.localSlots.len &&
                       PrimaryBodyIrSlotType(bodyIR, idxStoreNodeSlot) == valueKind:
                        valueSlot = idxStoreNodeSlot
                    elif primaryBodyIrNodeEvalCallEmitCount != idxStoreEmitMark:
                        # 调用已发射后失败: 落文本臂会重复发调用(call-sequence
                        # drift)。poison(镜像 6101 样板), 绝不静默落穿。
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt_lineNumber,
                                                     int32(stmt_kind),
                                                     7061,
                                                     0)
                        return true
            if valueSlot < 0 && elemKind == coreir.LocalStrTag && rhsText == "nil":
                valueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering.typedIr,
                                                                stmt_sourcePath,
                                                                "nil",
                                                                coreir.LocalPtrTag, callOrdinal)
            elif valueSlot < 0 && stmt_callTarget != "" && indexedElemTypeText != "":
                var indexedCallResultType = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
                if indexedCallResultType == "" || indexedCallResultType == "unknown":
                    indexedCallResultType = indexedElemTypeText
                valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                               slotNames,
                                                               lowering.typedIr,
                                                               PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                               Fmt"{valueText}#indexed_call_value#{stmt_lineNumber}",
                                                               indexedCallResultType)
                if valueSlot >= 0 &&
                   PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) >= elemSize:
                    let _indexedCallSlot = PrimaryBodyIrAppendCallOp(bodyIR,
                                                                     slotNames,
                                                                     lowering,

                                                                     typedFn,
                                                                     irFunction,
                                                                     stmt,
                                                                     valueSlot,
                                                                     varI32ParamNames,
                                                                     callOrdinal,
                                                                     currentBlockStart)
                else:
                    valueSlot = -1
            elif valueSlot < 0 && PrimaryBodyIrTextIsBareWholeCall(valueText) && indexedElemTypeText != "":
                if stmt_rhsNodeIndex < 0 ||
                   stmt_rhsNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
                   lowering.typedIr.nodes2_opKinds[stmt_rhsNodeIndex] !=
                       texpr.TypedExprIrOpCallExpr:
                    let panicMsg = Fmt"primary: indexed store whole call lacks canonical CallExpr row statement={stmt_statementIndex} node={stmt_rhsNodeIndex}"
                    panic(panicMsg)
                valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                               slotNames,
                                                               lowering.typedIr,
                                                               stmt_sourcePath,
                                                               Fmt"{valueText}#indexed_whole_call_value#{stmt_lineNumber}",
                                                               indexedElemTypeText)
                if valueSlot < 0 ||
                   PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]) < elemSize ||
                   !PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                           slotNames,
                                                           lowering,

                                                           typedFn,
                                                           irFunction,
                                                           varI32ParamNames,
                                                           valueText,
                                                           valueSlot,
                                                           stmt_lineNumber,
                                                           stmt_rhsNodeIndex,
                                                           callOrdinal):
                    valueSlot = -1
            elif valueSlot < 0:
                # Context variant (not the bare one): the stored value may itself
                # contain multi-dimensional fixed-array reads, e.g.
                # `grid[i][j] = grid[a][b] + grid[c][d]`. Only the context path
                # row-major-flattens those `[i][j]` operands (it has the function
                # binding scope to resolve the dimension strides); the bare path
                # would degrade each multi-bracket operand to a phantom slot.
                valueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       lowering.typedIr,
                                                                       share(typedFn),
                                                                       irFunction,
                                                                       stmt_sourcePath,
                                                                       stmt_lineNumber,
                                                                       valueText,
                                                                       valueKind)
            if indexSlot < 0 || valueSlot < 0:
                return false
            var indexedStoreOp: coreir.BodyOp
            indexedStoreOp.kind = coreir.BodyOpIndexedStoreTag
            indexedStoreOp.target = rootSlot
            add(indexedStoreOp.operands, rootSlot)
            add(indexedStoreOp.operands, valueSlot)
            add(indexedStoreOp.operands, indexSlot)
            add(indexedStoreOp.operands, elemSize)
            if indexedStoreIsSeq:
                add(indexedStoreOp.operands, 1)
            let _ = coreir.BodyIRAppendOp(bodyIR, indexedStoreOp)
            return true
        var dotPos: int32
        dotPos = -1
        for ci in 0..<len(lhsName):
            if lhsName[ci] == '.':
                dotPos = ci
        if dotPos < 0:
            return false
        let rootName = strutil.Strip(strings.SliceBytes(lhsName, 0, dotPos))
        var baseSlot = PrimaryBodyIrFindOrCreateFieldBaseSlot(bodyIR,
                                                              slotNames,
                                                              lowering.typedIr,
                                                              stmt_sourcePath,
                                                              rootName,
                                                              stmt_assignRootType)
        if baseSlot < 0:
            return false
        var valueSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
        if valueSlot < 0:
            valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                           slotNames,
                                                           lowering.typedIr,
                                                           stmt_sourcePath,
                                                           rhsText,
                                                           stmt_resultType)
        if valueSlot < 0:
            return false
        var storeOp: coreir.BodyOp
        storeOp.kind = coreir.BodyOpFieldStoreTag
        storeOp.target = baseSlot
        add(storeOp.operands, baseSlot)
        add(storeOp.operands, valueSlot)
        add(storeOp.operands, 0)
        add(storeOp.operands, 8)
        let _ = coreir.BodyIRAppendOp(bodyIR, storeOp)
        return true
    var lhsSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, lhsName)
    if lhsSlot < 0 &&
       stmt_resultType != "" &&
       stmt_resultType != "unknown" &&
       stmt_assignFieldName == "" &&
       !PrimaryBodyIrTextHasFieldOrIndex(lhsName):
        lhsSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                     slotNames,
                                                     lowering.typedIr,
                                                     stmt_sourcePath,
                                                     lhsName,
                                                     stmt_resultType)
    if lhsSlot < 0:
        PrimaryObjectPlanTrace(strutil.Join(["phase=assign_lhs_slot_missing function=",
                                             strings.CloneStr(typedFnName),
                                             " line=",
                                             strings.IntToStr(stmt_lineNumber),
                                             " lhs=",
                                             strings.CloneStr(lhsName),
                                             " rhs=",
                                             rhsText], ""))
        return false
    if stmt_assignFieldName == "" &&
       !PrimaryBodyIrTextHasFieldOrIndex(lhsName) &&
       !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[lhsSlot]):
        var assignLhsType = strings.CloneStr(stmt_resultType)
        if assignLhsType == "" || assignLhsType == "unknown" || assignLhsType == "call_expr":
            assignLhsType = PrimaryBodyIrNodeResultTypeText(lowering.typedIr, stmt_rhsNodeIndex)
        let _ = PrimaryBodyIrRetypeLocalScalarSlotForType(bodyIR,
                                                          lowering.typedIr,
                                                          stmt_sourcePath,
                                                          lhsSlot,
                                                          assignLhsType)
    if PrimaryBodyIrSlotType(bodyIR, lhsSlot) == coreir.LocalI32Tag &&
       (PrimaryBodyIrConditionHasAnd(rhsText) ||
        PrimaryBodyIrConditionHasOr(rhsText)):
        var boolConditionBlockStart: int32
        boolConditionBlockStart = currentBlockStart
        let boolConditionAssigned = PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                                          slotNames,
                                                                          lowering,

                                                                          typedFn,
                                                                          irFunction,
                                                                          stmt_sourcePath,
                                                                          stmt_lineNumber,
                                                                          rhsText,
                                                                          lhsSlot,
                                                                          callOrdinal,
                                                                          boolConditionBlockStart)
        currentBlockStart = boolConditionBlockStart
        return boolConditionAssigned
    let lhsIsVarI32 = PrimaryBodyIrNameInList(varI32ParamNames, lhsName)
    var lhsVarPointeeKind = PrimaryBodyIrVarParamPointeeKind(bodyIR, lhsSlot)
    if lhsVarPointeeKind == coreir.LocalInvalidTag &&
       PrimaryBodyIrSlotType(bodyIR, lhsSlot) == coreir.LocalPtrTag:
        let lhsBindingTypeForVar = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                   typedFn,
                                                                   irFunction,
                                                                   stmt_lineNumber,
                                                                   lhsName)
        lhsVarPointeeKind = PrimaryBodyIrVarPointeeTypeKindFromText(lowering.typedIr, stmt_sourcePath, lhsBindingTypeForVar)
    if stmt_callTarget == "" &&
       PrimaryBodyIrTextIsBareWholeCall(rhsText):
        if stmt_rhsNodeIndex < 0 ||
           stmt_rhsNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len ||
           lowering.typedIr.nodes2_opKinds[stmt_rhsNodeIndex] !=
               texpr.TypedExprIrOpCallExpr:
            let panicMsg = Fmt"primary: assignment whole call lacks canonical CallExpr row statement={stmt_statementIndex} node={stmt_rhsNodeIndex}"
            panic(panicMsg)
        let lhsSlotType = PrimaryBodyIrSlotType(bodyIR, lhsSlot)
        let lhsIsAggregateParamSlot = PrimaryBodyIrSlotIsAggregateParam(bodyIR, lhsSlot)
        if lhsSlotType == coreir.LocalStrTag ||
           lhsSlotType == coreir.LocalAggregateTag:
            if !lhsIsAggregateParamSlot &&
               PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                       slotNames,
                                                       lowering,

                                                       typedFn,
                                                       irFunction,
                                                       varI32ParamNames,
                                                       rhsText,
                                                       lhsSlot,
                                                       stmt_lineNumber,
                                                       stmt_rhsNodeIndex,
                                                       callOrdinal):
                return true
            var wholeCallResultType = strings.CloneStr(stmt_resultType)
            if wholeCallResultType == "" || wholeCallResultType == "unknown":
                wholeCallResultType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                      typedFn,
                                                                      irFunction,
                                                                      stmt_lineNumber,
                                                                      lhsName)
            if wholeCallResultType == "" || wholeCallResultType == "unknown":
                if lhsSlotType == coreir.LocalStrTag:
                    wholeCallResultType = "str"
            if wholeCallResultType != "" && wholeCallResultType != "unknown":
                let wholeCallResultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                             slotNames,
                                                                             lowering.typedIr,
                                                                             stmt_sourcePath,
                                                                             Fmt"{lhsName}#whole_call_result#{stmt_lineNumber}",
                                                                             wholeCallResultType)
                if wholeCallResultSlot >= 0 &&
                   PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                          slotNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          varI32ParamNames,
                                                          rhsText,
                                                          wholeCallResultSlot,
                                                          stmt_lineNumber,
                                                          stmt_rhsNodeIndex,
                                                          callOrdinal):
                    if lhsIsAggregateParamSlot:
                        if !PrimaryBodyIrAppendAggregateParamStoreIfNeeded(bodyIR,
                                                                           lhsSlot,
                                                                           wholeCallResultSlot):
                            return false
                    else:
                        var wholeCallCopyOp: coreir.BodyOp
                        wholeCallCopyOp.kind = coreir.BodyOpCopyLocalTag
                        wholeCallCopyOp.target = lhsSlot
                        add(wholeCallCopyOp.operands, wholeCallResultSlot)
                        let _ = coreir.BodyIRAppendOp(bodyIR, wholeCallCopyOp)
                    return true
        elif PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                    slotNames,
                                                    lowering,

                                                    typedFn,
                                                    irFunction,
                                                    varI32ParamNames,
                                                    rhsText,
                                                    lhsSlot,
                                                    stmt_lineNumber,
                                                    stmt_rhsNodeIndex,
                                                    callOrdinal):
            return true
    if lhsVarPointeeKind == coreir.LocalI64Tag && stmt_callTarget == "":
        let valueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering.typedIr,
                                                            stmt_sourcePath,
                                                            rhsText,
                                                            coreir.LocalI64Tag, callOrdinal)
        if valueSlot < 0:
            return false
        PrimaryBodyIrAppendVarI64Store(bodyIR, lhsSlot, valueSlot)
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"phase=assign_store_var_i64 lhs={lhsName} address_slot={lhsSlot} value_slot={valueSlot}")
        return true
    if lhsVarPointeeKind == coreir.LocalStrTag && stmt_callTarget == "":
        var valueSlot: int32
        valueSlot = -1
        if PrimaryBodyIrTextIsStringLiteral(rhsText):
            valueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       Fmt"{lhsName}#var_str_value#{stmt_lineNumber}",
                                                       coreir.LocalStrTag)
            if valueSlot < 0 ||
               !PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                      slotNames,
                                                      rhsText,
                                                      valueSlot,
                                                      callOrdinal):
                return false
        else:
            valueSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
            if valueSlot < 0:
                valueSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                               slotNames,
                                                               lowering.typedIr,
                                                               stmt_sourcePath,
                                                               rhsText,
                                                               "str")
        if valueSlot < 0 ||
           PrimaryBodyIrSlotType(bodyIR, valueSlot) != coreir.LocalStrTag:
            return false
        PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                             lhsSlot,
                                             valueSlot,
                                             PrimaryLocalSlotSizeOf(bodyIR.localSlots[valueSlot]))
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"phase=assign_store_var_str lhs={lhsName} address_slot={lhsSlot} value_slot={valueSlot}")
        return true
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_M function={typedFnName} line={stmt_lineNumber}")
    if stmt_callTarget != "":
        var resultSlot = lhsSlot
        var copyCallResultToLhs = false
        let resultTypeText = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
        if lhsIsVarI32:
            resultSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                       slotNames,
                                                       PrimaryBodyIrVarI32ValueSlotName(lhsName),
                                                       coreir.LocalI32Tag)
        elif lhsVarPointeeKind == coreir.LocalStrTag:
            var tempResultType = resultTypeText
            if tempResultType == "" || tempResultType == "unknown":
                tempResultType = stmt_resultType
            if tempResultType == "" || tempResultType == "unknown":
                return false
            resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                            slotNames,
                                                            lowering.typedIr,
                                                            PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                            Fmt"{lhsName}#var_str_call_result#{stmt_lineNumber}",
                                                            tempResultType)
            if resultSlot < 0 ||
               PrimaryBodyIrSlotType(bodyIR, resultSlot) != coreir.LocalStrTag:
                return false
        elif PrimaryBodyIrSlotType(bodyIR, lhsSlot) == coreir.LocalStrTag ||
             PrimaryBodyIrSlotType(bodyIR, lhsSlot) == coreir.LocalAggregateTag:
            var tempResultType = resultTypeText
            if tempResultType == "" || tempResultType == "unknown":
                tempResultType = stmt_resultType
            if tempResultType == "" || tempResultType == "unknown":
                return false
            resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                            slotNames,
                                                            lowering.typedIr,
                                                            PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                            Fmt"{lhsName}#call_result#{stmt_lineNumber}",
                                                            tempResultType)
            if resultSlot < 0:
                return false
            copyCallResultToLhs = true
        elif resultTypeText != "":
            var resultTypeKind: int32
            var resultSizeBytes: int32
            var resultAlignBytes: int32
            PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                           PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                           resultTypeText,
                                           resultTypeKind,
                                           resultSizeBytes,
                                           resultAlignBytes)
            if resultTypeKind != PrimaryBodyIrSlotType(bodyIR, lhsSlot):
                return false
        let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                          slotNames,
                                          lowering,

                                          typedFn,
                                          irFunction,
                                          stmt,
                                          resultSlot,
                                          varI32ParamNames,
                                          callOrdinal,
                                          currentBlockStart)
        if lhsIsVarI32:
            PrimaryBodyIrAppendVarI32Store(bodyIR, lhsSlot, resultSlot)
        elif lhsVarPointeeKind == coreir.LocalStrTag:
            PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                                 lhsSlot,
                                                 resultSlot,
                                                 PrimaryLocalSlotSizeOf(bodyIR.localSlots[resultSlot]))
        elif copyCallResultToLhs:
            if PrimaryBodyIrSlotIsAggregateParam(bodyIR, lhsSlot):
                if !PrimaryBodyIrAppendAggregateParamStoreIfNeeded(bodyIR,
                                                                   lhsSlot,
                                                                   resultSlot):
                    return false
            else:
                var copyOp: coreir.BodyOp
                copyOp.kind = coreir.BodyOpCopyLocalTag
                copyOp.target = lhsSlot
                add(copyOp.operands, resultSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, copyOp)
        return true
    if os.GetEnv("CHENG_X64_DBG4") != "" && PrimaryBodyIrTextIsStringLiteral(rhsText):
        var dbg4StrPointee: int32 = lhsVarPointeeKind
        var dbg4StrIsVar: int32
        if lhsIsVarI32:
            dbg4StrIsVar = 1
        os.WriteLine(os.GetStderr(), Fmt"x64dbg4 str_lit_assign lhs=[{lhsName}] slot_type={PrimaryBodyIrSlotType(bodyIR, lhsSlot)} pointee={dbg4StrPointee} is_var_i32={dbg4StrIsVar}")
    if !lhsIsVarI32 &&
       lhsVarPointeeKind != coreir.LocalStrTag &&
       PrimaryBodyIrSlotType(bodyIR, lhsSlot) == coreir.LocalStrTag &&
       PrimaryBodyIrTextIsStringLiteral(rhsText):
        return PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                     slotNames,
                                                     rhsText,
                                                     lhsSlot,
                                                     callOrdinal)
    if !lhsIsVarI32 &&
       PrimaryBodyIrSlotType(bodyIR, lhsSlot) == coreir.LocalAggregateTag &&
       bodyIR.localSlots[lhsSlot].auxValue == coreir.LocalStrTag &&
       PrimaryBodyIrLocalIsParam(bodyIR.localSlots[lhsSlot]) &&
       PrimaryBodyIrTextIsStringLiteral(rhsText) &&
       stmt_callTarget == "":
        # var str param assign: build the literal into a temp str value and
        # copy it through the param address.
        let varStrLitSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                          slotNames,
                                                          Fmt"{lhsName}#var_str_lit#{stmt_lineNumber}",
                                                          coreir.LocalStrTag)
        if varStrLitSlot >= 0 &&
           PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                 slotNames,
                                                 rhsText,
                                                 varStrLitSlot,
                                                 callOrdinal):
            PrimaryBodyIrAppendVarAggregateStore(bodyIR,
                                                 lhsSlot,
                                                 varStrLitSlot,
                                                 24)
            return true
    if !lhsIsVarI32 &&
       PrimaryBodyIrSlotType(bodyIR, lhsSlot) == coreir.LocalPtrTag &&
       PrimaryBodyIrVarParamPointeeKind(bodyIR, lhsSlot) == coreir.LocalInvalidTag &&
       PrimaryBodyIrTextIsStringLiteral(rhsText) &&
       stmt_callTarget == "":
        # cstring literal assign: lhs = "..." with a pointer-typed lhs takes the
        # address of the NUL-terminated literal in the function's literal pool.
        let cstrLiteralId = coreir.BodyIRAppendCStringLiteral(bodyIR,
                                                              PrimaryBodyIrStringLiteralPayload(rhsText),
                                                              "")
        if cstrLiteralId >= 0:
            var cstrOp: coreir.BodyOp
            cstrOp.kind = coreir.BodyOpLoadLocalTag
            cstrOp.target = lhsSlot
            add(cstrOp.operands, coreir.BodyLoadLocalCStringTag)
            add(cstrOp.operands, cstrLiteralId)
            let _ = coreir.BodyIRAppendOp(bodyIR, cstrOp)
            return true
    if !lhsIsVarI32 && PrimaryBodyIrSlotType(bodyIR, lhsSlot) != coreir.LocalI32Tag:
        let nonI32LhsKind = PrimaryBodyIrSlotType(bodyIR, lhsSlot)
        if nonI32LhsKind == coreir.LocalF64Tag &&
           stmt_assignValueOpKind == texpr.TypedExprIrOpLocalBoolEnumTernary:
            if PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          stmt_sourcePath,
                                                          stmt_lineNumber,
                                                          stmt_rhsNodeIndex,
                                                          rhsText,
                                                          lhsSlot,
                                                          coreir.LocalF64Tag,
                                                          callOrdinal,
                                                          currentBlockStart):
                return true
        var scalarValueSlot: int32 = -1
        if nonI32LhsKind == coreir.LocalF64Tag:
            scalarValueSlot = PrimaryBodyIrCallBinOpTernaryAwareSlot(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,

                                                                     typedFn,
                                                                     irFunction,
                                                                     stmt_sourcePath,
                                                                     stmt_lineNumber,
                                                                     stmt_rhsNodeIndex,
                                                                     rhsText,
                                                                     nonI32LhsKind,
                                                                     callOrdinal,
                                                                     currentBlockStart)
        else:
            scalarValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering.typedIr,
                                                                  stmt_sourcePath,
                                                                  rhsText,
                                                                  nonI32LhsKind,
                                                                  callOrdinal)
        if scalarValueSlot >= 0:
            if scalarValueSlot != lhsSlot:
                var scalarCopyOp: coreir.BodyOp
                scalarCopyOp.kind = coreir.BodyOpCopyLocalTag
                scalarCopyOp.target = lhsSlot
                add(scalarCopyOp.operands, scalarValueSlot)
                let _ = coreir.BodyIRAppendOp(bodyIR, scalarCopyOp)
            return true
        let rhsSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, rhsText)
        if rhsSlot >= 0:
            var copyOp: coreir.BodyOp
            copyOp.kind = coreir.BodyOpCopyLocalTag
            copyOp.target = lhsSlot
            add(copyOp.operands, rhsSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, copyOp)
            return true
        if PrimaryObjectPlanTraceActive():
            PrimaryObjectPlanTrace(Fmt"phase=assign_non_i32_value_missing function={typedFnName} line={stmt_lineNumber} lhs={lhsName} lhs_slot={lhsSlot} lhs_slot_type={PrimaryBodyIrSlotType(bodyIR, lhsSlot)} rhs={rhsText}")
        return false
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_N function={typedFnName} line={stmt_lineNumber}")
    var targetSlot = lhsSlot
    if lhsIsVarI32:
        targetSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                  slotNames,
                                                  PrimaryBodyIrVarI32ValueSlotName(lhsName),
                                                  coreir.LocalI32Tag)
    if stmt_assignValueOpKind == texpr.TypedExprIrOpLocalBoolEnumTernary:
        let ternTypeKind = PrimaryBodyIrSlotType(bodyIR, targetSlot)
        # 真分支下降：仅执行被选中臂（含调用臂时根除急切求值 miscompile）。
        if PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      lowering,

                                                      typedFn,
                                                      irFunction,
                                                      stmt_sourcePath,
                                                      stmt_lineNumber,
                                                      stmt_rhsNodeIndex,
                                                      rhsText,
                                                      targetSlot,
                                                      ternTypeKind,
                                                      callOrdinal,
                                                      currentBlockStart):
            if lhsIsVarI32:
                PrimaryBodyIrAppendVarI32Store(bodyIR, lhsSlot, targetSlot)
            return true
        # call-free 常量臂：急切快路径（与 ScalarValueSlotForTextImpl 11325 一致）。
        let ternTrueText = strutil.Strip(stmt_assignValueRhsText)
        let ternFalseText = strutil.Strip(stmt_conditionRhsText)
        if PrimaryBodyIrTextHasRealCallSurface(ternTrueText) ||
           PrimaryBodyIrTextHasRealCallSurface(ternFalseText):
            return false
        let ternarySlot = PrimaryBodyIrTernaryValueSlotForStmt(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering.typedIr,
                                                              stmt,
                                                              ternTypeKind)
        if ternarySlot < 0:
            return false
        if ternarySlot != targetSlot:
            var ternaryCopyOp: coreir.BodyOp
            ternaryCopyOp.kind = coreir.BodyOpCopyLocalTag
            ternaryCopyOp.target = targetSlot
            add(ternaryCopyOp.operands, ternarySlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, ternaryCopyOp)
        if lhsIsVarI32:
            PrimaryBodyIrAppendVarI32Store(bodyIR, lhsSlot, targetSlot)
        return true
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_O function={typedFnName} line={stmt_lineNumber}")
    if stmt_assignValueOpKind == texpr.TypedExprIrOpI32Add ||
       stmt_assignValueOpKind == texpr.TypedExprIrOpI32Sub ||
       stmt_assignValueOpKind == texpr.TypedExprIrOpI32Mul ||
       stmt_assignValueOpKind == texpr.TypedExprIrOpI32Sdiv ||
       stmt_assignValueOpKind == texpr.TypedExprIrOpI32Asr ||
       stmt_assignValueOpKind == texpr.TypedExprIrOpI32BitAnd ||
       stmt_assignValueOpKind == texpr.TypedExprIrOpI32BitOr ||
       stmt_assignValueOpKind == texpr.TypedExprIrOpI32BitXor:
        if stmt_assignValueLhsText == "" || stmt_assignValueRhsText == "":
            if PrimaryObjectPlanTraceActive():
                PrimaryObjectPlanTrace(Fmt"phase=assign_typed_bin_text_missing function={typedFnName} line={stmt_lineNumber} lhs_text={stmt_assignValueLhsText} rhs_text={stmt_assignValueRhsText}")
            return false
        let lhsValueSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering,

                                                                   typedFn,
                                                                   irFunction,
                                                                   stmt_sourcePath,
                                                                   stmt_lineNumber,
                                                                   stmt_assignValueLhsText,
                                                                   PrimaryBodyIrSlotType(bodyIR, targetSlot),
                                                                   callOrdinal)
        let rhsValueSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering,

                                                                   typedFn,
                                                                   irFunction,
                                                                   stmt_sourcePath,
                                                                   stmt_lineNumber,
                                                                   stmt_assignValueRhsText,
                                                                   PrimaryBodyIrSlotType(bodyIR, targetSlot),
                                                                   callOrdinal)
        if lhsValueSlot < 0 || rhsValueSlot < 0:
            if os.GetEnv("CHENG_X64_DBG3") != "":
                os.WriteLine(os.GetStderr(), Fmt"x64dbg3 typed_bin_missing line={stmt_lineNumber} vlhs=[{stmt_assignValueLhsText}] slot_l={lhsValueSlot} vrhs=[{stmt_assignValueRhsText}] slot_r={rhsValueSlot}")
            PrimaryObjectPlanTrace(strutil.Join(["phase=assign_typed_bin_slot_missing function=",
                                                 strings.CloneStr(typedFnName),
                                                 " line=",
                                                 strings.IntToStr(stmt_lineNumber),
                                                 " lhs=",
                                                 strings.CloneStr(stmt_assignValueLhsText),
                                                 " lhs_slot=",
                                                 strings.IntToStr(lhsValueSlot),
                                                 " rhs=",
                                                 strings.CloneStr(stmt_assignValueRhsText),
                                                 " rhs_slot=",
                                                 strings.IntToStr(rhsValueSlot)], ""))
            return false
        var typedBinOp: coreir.BodyOp
        typedBinOp.kind = coreir.BodyOpBinOpTag
        typedBinOp.target = targetSlot
        add(typedBinOp.operands, PrimaryBodyIrSlotType(bodyIR, targetSlot))
        add(typedBinOp.operands, int32(stmt_assignValueOpKind))
        add(typedBinOp.operands, lhsValueSlot)
        add(typedBinOp.operands, rhsValueSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, typedBinOp)
        if lhsIsVarI32:
            PrimaryBodyIrAppendVarI32Store(bodyIR, lhsSlot, targetSlot)
        return true
    if PrimaryObjectPlanProgressEnabled():
        PrimaryObjectPlanProgress(Fmt"assign_mark_P function={typedFnName} line={stmt_lineNumber}")
    let directScalarSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering,

                                                                   typedFn,
                                                                   irFunction,
                                                                   stmt_sourcePath,
                                                                   stmt_lineNumber,
                                                                   rhsText,
                                                                   PrimaryBodyIrSlotType(bodyIR, targetSlot),
                                                                   callOrdinal)
    if directScalarSlot >= 0:
        if directScalarSlot != targetSlot:
            var directCopyOp: coreir.BodyOp
            directCopyOp.kind = coreir.BodyOpCopyLocalTag
            directCopyOp.target = targetSlot
            add(directCopyOp.operands, directScalarSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, directCopyOp)
        if lhsIsVarI32:
            PrimaryBodyIrAppendVarI32Store(bodyIR, lhsSlot, targetSlot)
        return true
    if stmt_rhsNodeIndex >= 0:
        let rhsNodeTargetKind = PrimaryBodyIrSlotType(bodyIR, targetSlot)
        let rhsNodeProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,

                                                          share(typedFn),
                                                          irFunction,
                                                          stmt_rhsNodeIndex)
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            var rhsNodeOpText = ""
            var rhsNodeResultType = ""
            if stmt_rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                rhsNodeOpText = texpr.TypedExprIrOpKindText(lowering.typedIr.nodes2_opKinds[stmt_rhsNodeIndex])
                let rhsNodeRtRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool,
                                                                         lowering.typedIr.nodes2_resultTypeIds[stmt_rhsNodeIndex])
                if IsOk(rhsNodeRtRes):
                    rhsNodeResultType = Value(rhsNodeRtRes)
            os.WriteLine(os.GetStderr(), Fmt"phase=assign_node_probe function={typedFnName} line={stmt_lineNumber} lhs={lhsName} rhs={rhsText} node={stmt_rhsNodeIndex} op={rhsNodeOpText} result_type={rhsNodeResultType} target_slot={targetSlot} target_kind={rhsNodeTargetKind} probe_kind={rhsNodeProbeKind} miss={primaryBodyIrNodeEvalMissOp}")
        if rhsNodeProbeKind == rhsNodeTargetKind:
            let rhsNodeSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                    slotNames,
                                                    varI32ParamNames,
                                                    lowering,

                                                    share(typedFn),
                                                    irFunction,
                                                    stmt_rhsNodeIndex,
                                                    callOrdinal)
            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                var rhsNodeSlotKind: int32
                if rhsNodeSlot >= 0 && rhsNodeSlot < bodyIR.localSlots.len:
                    rhsNodeSlotKind = PrimaryBodyIrSlotType(bodyIR, rhsNodeSlot)
                os.WriteLine(os.GetStderr(), Fmt"phase=assign_node_eval function={typedFnName} line={stmt_lineNumber} node={stmt_rhsNodeIndex} slot={rhsNodeSlot} slot_kind={rhsNodeSlotKind} target_kind={rhsNodeTargetKind} miss={primaryBodyIrNodeEvalMissOp}")
            if rhsNodeSlot >= 0 &&
               rhsNodeSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, rhsNodeSlot) == rhsNodeTargetKind:
                if rhsNodeSlot != targetSlot:
                    var rhsNodeCopyOp: coreir.BodyOp
                    rhsNodeCopyOp.kind = coreir.BodyOpCopyLocalTag
                    rhsNodeCopyOp.target = targetSlot
                    add(rhsNodeCopyOp.operands, rhsNodeSlot)
                    let _ = coreir.BodyIRAppendOp(bodyIR, rhsNodeCopyOp)
                if lhsIsVarI32:
                    PrimaryBodyIrAppendVarI32Store(bodyIR, lhsSlot, targetSlot)
                return true
    # 顶层二元算术 RHS（var - call() - call() 这类多调用链）：前端对 3+ 操作数
    # 链不填 assignValueLhs/RhsText(:32331 binop 分支够不到)，整个 RHS 也不是
    # 单一 call surface(:32388 directScalar 够不到)。此处按 + 优先于 - 优先于 *
    # 取【最后一个】顶层算子切分(左结合：与 CallScalarValueSlotForTextImpl 的
    # FindTopLevelBinOpTokenLast 语义一致,a-b-c 切成 (a-b)-c 而非 a-(b-c))，
    # 两侧经 CallScalarValueSlotForText 物化(单调用侧复用既有 AppendCallOp 范式，
    # 多调用侧 helper 内递归)，发对应 BinOp；切不动或侧槽缺失则落回下方标量兜底
    # （不静默 miscompile）。
    let addPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(rhsText, 43)
    let subPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(rhsText, 45)
    let mulPos = PrimaryBodyIrFindTopLevelBinOpTokenLast(rhsText, 42)
    var binOpPos: int32 = -1
    var binOpKind: int32
    if addPos > 0:
        binOpPos = addPos
        binOpKind = int32(texpr.TypedExprIrOpI32Add)
    elif subPos > 0:
        binOpPos = subPos
        binOpKind = int32(texpr.TypedExprIrOpI32Sub)
    elif mulPos > 0:
        binOpPos = mulPos
        binOpKind = int32(texpr.TypedExprIrOpI32Mul)
    if binOpPos > 0 && binOpKind != 0:
        let rhsLhs = strutil.Strip(strings.SliceBytes(rhsText, 0, binOpPos))
        let rhsRhs = strutil.Strip(strings.SliceBytes(rhsText,
                                                     binOpPos + 1,
                                                     len(rhsText) - binOpPos - 1))
        let lhsValueSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering,

                                                                   typedFn,
                                                                   irFunction,
                                                                   stmt_sourcePath,
                                                                   stmt_lineNumber,
                                                                   rhsLhs,
                                                                   coreir.LocalI32Tag,
                                                                   callOrdinal)
        let rhsValueSlot = PrimaryBodyIrCallScalarValueSlotForText(bodyIR,
                                                                   slotNames,
                                                                   varI32ParamNames,
                                                                   lowering,

                                                                   typedFn,
                                                                   irFunction,
                                                                   stmt_sourcePath,
                                                                   stmt_lineNumber,
                                                                   rhsRhs,
                                                                   coreir.LocalI32Tag,
                                                                   callOrdinal)
        if lhsValueSlot < 0 || rhsValueSlot < 0:
            # 文本 binop 切分侧槽缺失:侧子表达式本身含 binop+call(如 `a - f() - g()`
            # 切末位算子后左侧仍是 `a - f()`,CallScalarValueSlotForText 不认此形)。
            # 对整棵 RHS 节点走 EvalNode 物化进临时槽再 CopyLocal 到 targetSlot——
            # 镜像 call-arg 的 Fmt/field 路径(17999/18043)把 EvalNode 当纯物化器用,
            # 无 census claim、无 NodeEvalOnlyOwn。文本 binop 路径两侧槽缺失时不发
            # 射任何 op,故无 double-emit。poison-on-miss 仍落下方 return false。
            if stmt_rhsNodeIndex >= 0:
                let binFallbackSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering,

                                                            share(typedFn),
                                                            irFunction,
                                                            stmt_rhsNodeIndex,
                                                            callOrdinal)
                if binFallbackSlot >= 0 &&
                   binFallbackSlot < bodyIR.localSlots.len &&
                   PrimaryBodyIrSlotType(bodyIR, binFallbackSlot) == PrimaryBodyIrSlotType(bodyIR, targetSlot):
                    # G1 严等门:挡 i64→i32 / aggregate→i32 静默截断(对抗审计 current)
                    if binFallbackSlot != targetSlot:
                        var binFallbackCopyOp: coreir.BodyOp
                        binFallbackCopyOp.kind = coreir.BodyOpCopyLocalTag
                        binFallbackCopyOp.target = targetSlot
                        add(binFallbackCopyOp.operands, binFallbackSlot)
                        let _ = coreir.BodyIRAppendOp(bodyIR, binFallbackCopyOp)
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_binop_fallback function={typedFnName} line={stmt_lineNumber}")
                    return true
            PrimaryObjectPlanTrace(strutil.Join(["phase=assign_add_slot_missing function=",
                                                 strings.CloneStr(typedFnName),
                                                 " line=",
                                                 strings.IntToStr(stmt_lineNumber),
                                                 " lhs=",
                                                 strings.CloneStr(lhsName),
                                                 " left=",
                                                 strings.CloneStr(rhsLhs),
                                                 " left_slot=",
                                                 strings.IntToStr(lhsValueSlot),
                                                 " right=",
                                                 strings.CloneStr(rhsRhs),
                                                 " right_slot=",
                                                 strings.IntToStr(rhsValueSlot)], ""))
            return false
        var op: coreir.BodyOp
        op.kind = coreir.BodyOpBinOpTag
        op.target = targetSlot
        add(op.operands, coreir.LocalI32Tag)
        add(op.operands, binOpKind)
        add(op.operands, lhsValueSlot)
        add(op.operands, rhsValueSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, op)
    else:
        let valueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering.typedIr,
                                                            stmt_sourcePath,
                                                            rhsText,
                                                            PrimaryBodyIrSlotType(bodyIR, targetSlot), callOrdinal)
        if valueSlot < 0:
            PrimaryObjectPlanTrace(strutil.Join(["phase=assign_value_slot_missing function=",
                                                 strings.CloneStr(typedFnName),
                                                 " line=",
                                                 strings.IntToStr(stmt_lineNumber),
                                                 " lhs=",
                                                 strings.CloneStr(lhsName),
                                                 " rhs=",
                                                 rhsText], ""))
            return false
        if valueSlot != targetSlot:
            var copyOp: coreir.BodyOp
            copyOp.kind = coreir.BodyOpCopyLocalTag
            copyOp.target = targetSlot
            add(copyOp.operands, valueSlot)
            let _ = coreir.BodyIRAppendOp(bodyIR, copyOp)
    if lhsIsVarI32:
        PrimaryBodyIrAppendVarI32Store(bodyIR, lhsSlot, targetSlot)
    return true

@borrows
fn PrimaryBodyIrStructuredBodyEnd(statements: var lower.PrimaryObjectIrStatement[],
                                   stmtIndex: int32,
                                   stmtEndRaw: int32): int32 =
    var stmtEnd = stmtEndRaw
    if stmtEnd > statements.len:
        stmtEnd = statements.len
    if stmtIndex < 0 || stmtIndex >= stmtEnd:
        return stmtEnd
    let stmt = statements[stmtIndex]
    var bodyEnd = stmtEnd
    for si in stmtIndex + 1..<stmtEnd:
        let scanStmt = statements[si]
        var primaryColdCond15: bool
        var primaryColdCond15Clause0: bool
        if scanStmt.lineIndent > 0:
            if scanStmt.lineIndent <= stmt.lineIndent:
                primaryColdCond15Clause0 = true
        if primaryColdCond15Clause0:
            primaryColdCond15 = true
        if stmt.lineNumber > 0 && scanStmt.lineNumber == stmt.lineNumber:
            # Twin statements emitted for the same header line (If + IfCall)
            # are part of the construct head, not the end of its body.
            primaryColdCond15 = false
        if primaryColdCond15:
            bodyEnd = si
            break
    return bodyEnd

# Body extent of an if statement. Unlike the generic structured scan this
# skips the same-line IfCall pseudo statement that a call condition surfaces
# as (it belongs to the if header, not the then-body).
@borrows
fn PrimaryBodyIrIfBodyEnd(statements: var lower.PrimaryObjectIrStatement[],
                           stmtIndex: int32,
                           stmtEndRaw: int32): int32 =
    var stmtEnd = stmtEndRaw
    if stmtEnd > statements.len:
        stmtEnd = statements.len
    if stmtIndex < 0 || stmtIndex >= stmtEnd:
        return stmtEnd
    let stmt = statements[stmtIndex]
    var bodyEnd = stmtEnd
    for si in stmtIndex + 1..<stmtEnd:
        let scanStmt = statements[si]
        if scanStmt.kind == texpr.TypedExprIrStmtIfCall:
            continue
        if scanStmt.lineNumber == stmt.lineNumber:
            continue
        var pastBody: bool
        if scanStmt.lineIndent > 0:
            if scanStmt.lineIndent <= stmt.lineIndent:
                pastBody = true
        if pastBody:
            bodyEnd = si
            break
    return bodyEnd

# 头语句条件经节点求值器降级后，同行 Call 孪生语句（其完整调用文本含
# 于条件文本）即为已消费的 feeder：登记进 callFeederEmittedIndexes，
# 防止裸调用入口在循环体/then 体内二次发射（调用必须恰好执行一次）。
@borrows
fn PrimaryBodyIrConsumeHeaderConditionCallFeeders(statements: var lower.PrimaryObjectIrStatement[],
                                                   stmtIndex: int32,
                                                   stmtEndRaw: int32,
                                                   conditionText: str,
                                                   callFeederEmittedIndexes: var int32[]) =
    if conditionText == "":
        return
    var stmtEnd = stmtEndRaw
    if stmtEnd > statements.len:
        stmtEnd = statements.len
    if stmtIndex < 0 || stmtIndex >= stmtEnd:
        return
    let headerStmt = statements[stmtIndex]
    for feederIndex in 0..<stmtEnd:
        if feederIndex == stmtIndex:
            continue
        let feederStmt = statements[feederIndex]
        if feederStmt.lineNumber != headerStmt.lineNumber:
            continue
        if feederStmt.kind != texpr.TypedExprIrStmtCall:
            continue
        let feederFullText = PrimaryBodyIrCallFullText(feederStmt)
        if feederFullText == "":
            continue
        if !strutil.Contains(conditionText, feederFullText):
            continue
        if PrimaryBodyIrIntInList(callFeederEmittedIndexes, feederIndex):
            continue
        add(callFeederEmittedIndexes, feederIndex)

@borrows
fn PrimaryBodyIrBuildForRangeLoop(bodyIR: var coreir.BodyIR,
                                    slotNames: var str[],
                                    varI32ParamNames: str[],
                                    lowering: var lower.LoweringPlanStub,
                                    typedFn: texpr.TypedExprIrFunction,
                                    irFunction: var lower.PrimaryObjectIrFunction,
                                    nextOpIndex: var int32,
                                    currentBlockStart: var int32,
                                    stmt: lower.PrimaryObjectIrStatement,
                                    stmtIndex: int32,
                                    stmtEnd: int32,
                                    pendingFalseTerm: var int32,
                                    callOrdinal: var int32,
                                    callFeederEmittedIndexes: var int32[]): int32 =
    let headerText = strutil.Strip(stmt.surfaceText)
    let forBodyEnd = PrimaryBodyIrStructuredBodyEnd(irFunction.statements, stmtIndex, stmtEnd)
    var inPos = -1
    var endCheckN = len(headerText) - 3
    for ci in 0..<endCheckN:
        if headerText[ci] == ' ' && headerText[ci + 1] == 'i' && headerText[ci + 2] == 'n' && headerText[ci + 3] == ' ':
            inPos = ci
            break
    var rangeText = strings.CloneStr(headerText)
    if inPos > 0:
        var afterIn = inPos + 4
        var rangeLen = len(headerText) - afterIn
        rangeText = strings.SliceBytes(headerText, afterIn, rangeLen)
        var rLen = len(rangeText)
        if rLen > 0:
            var lastCh = rangeText[rLen - 1]
            if lastCh == ':':
                rangeText = strings.SliceBytes(rangeText, 0, rLen - 1)
        rangeText = strutil.Strip(rangeText)
    var rangeStart: int32
    var rangeEnd = strings.CloneStr(rangeText)
    var exclPos = -1
    var exclHasLe = false
    var exclCheckN = len(rangeText) - 2
    for ci in 0..<exclCheckN:
        if rangeText[ci] == '.' && rangeText[ci + 1] == '.' && rangeText[ci + 2] == '<':
            exclPos = ci
            break
    if exclPos > 0:
        var startText = strings.SliceBytes(rangeText, 0, exclPos)
        var stripped = strutil.Strip(startText)
        rangeStart = PrimaryBodyIrExtractIntFromText(stripped)
        var afterExcl = exclPos + 3
        if exclPos + 3 < len(rangeText) && rangeText[exclPos + 3] == '=':
            exclHasLe = true
            afterExcl = exclPos + 4
        var endLen = len(rangeText) - afterExcl
        rangeEnd = strings.SliceBytes(rangeText, afterExcl, endLen)
        rangeEnd = strutil.Strip(rangeEnd)
    if PrimaryBodyIrBuildForSeqLoop(bodyIR,
                                    slotNames,
                                    varI32ParamNames,
                                    lowering.typedIr,
                                    typedFn,
                                    irFunction,
                                    nextOpIndex,
                                    currentBlockStart,
                                    stmt,
                                    rangeText,
                                    pendingFalseTerm,
                                    callOrdinal):
        return forBodyEnd
    let idxSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, stmt.bindingName, coreir.LocalI32Tag)
    # for-range 节点路径：止界为前端已建节点（rhsNodeIndex），起界须为
    # 整型字面量（与文本路径同 LoadConst 初始化）。止界探针→求值，求值
    # op 全落 preheader（恰好执行一次），header 仅单 Cbr（..< 用 Lt，..
    # 用 Le）。探针失败落回文本路径；求值在调用已发射后失败禁止落回
    #（6101 毒标）。
    if stmt.rhsNodeIndex >= 0 && idxSlot >= 0 && stmt.bindingName != "":
        var forRangeInclusive = false
        var forStartText = ""
        let forRangeCallInner = PrimaryBodyIrWholeCallInnerForHead(rangeText, "range")
        if forRangeCallInner != "":
            let forRangeArgs = texpr.TypedExprSplitTopLevelCsv(forRangeCallInner)
            if forRangeArgs.len == 1:
                forStartText = "0"
            elif forRangeArgs.len == 2:
                forStartText = strutil.Strip(forRangeArgs[0])
        elif exclPos > 0:
            forStartText = strutil.Strip(strings.SliceBytes(rangeText, 0, exclPos))
            if exclHasLe:
                forRangeInclusive = true
        else:
            var forDotPos = -1
            var forDotCheckN = len(rangeText) - 1
            for ci in 0..<forDotCheckN:
                if rangeText[ci] == '.' && rangeText[ci + 1] == '.':
                    forDotPos = ci
                    break
            if forDotPos > 0:
                forRangeInclusive = true
                forStartText = strutil.Strip(strings.SliceBytes(rangeText, 0, forDotPos))
        var forStartConst = 0
        var forStartOk = false
        var forStartNeedsSlot = false
        if forStartText != "":
            forStartConst = PrimaryBodyIrExtractIntFromText(forStartText)
            if forStartConst != 0 || PrimaryBodyIrTextIsI32Zero(forStartText):
                forStartOk = true
            elif !PrimaryBodyIrTextHasCallSurface(forStartText):
                forStartNeedsSlot = true
                forStartOk = true
            elif stmt.forStartNodeIndex >= 0:
                forStartNeedsSlot = true
                forStartOk = true
        var forEndProbeKind = -1
        if forStartOk:
            forEndProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         lowering,

                                                         typedFn,
                                                         irFunction,
                                                         stmt.rhsNodeIndex)
        var forStartSlot: int32
        forStartSlot = -1
        if (forEndProbeKind == coreir.LocalI32Tag || forEndProbeKind == coreir.LocalI64Tag) && forStartNeedsSlot:
            # 阶段1 迁移：for-range 起界从文本派发 PrimaryBodyIrScalarValueSlotForText
            # 改为节点求值器 PrimaryBodyIrEvalNode。前端两处（typed_expr 17033/19768）
            # 必以 expected int32 为 range 起界建 forStartNodeIndex；纯 ref/算术起界
            # EvalNode 与文本同槽（25117 直接返回形参/局部槽）。探针放行 i32（起界
            # 节点恒以 int32 建），求值在调用已发射后失败禁止落回（6101 毒标）。
            if stmt.forStartNodeIndex >= 0 &&
               PrimaryBodyIrNodeEvalProbe(bodyIR,
                                          slotNames,
                                          varI32ParamNames,
                                          lowering,

                                          typedFn,
                                          irFunction,
                                          stmt.forStartNodeIndex) == coreir.LocalI32Tag:
                let forStartEmitMark = primaryBodyIrNodeEvalCallEmitCount
                forStartSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                     slotNames,
                                                     varI32ParamNames,
                                                     lowering,

                                                     typedFn,
                                                     irFunction,
                                                     stmt.forStartNodeIndex,
                                                     callOrdinal)
                if forStartSlot < 0 &&
                   primaryBodyIrNodeEvalCallEmitCount != forStartEmitMark:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 0)
                    pendingFalseTerm = -1
                    return forBodyEnd
            if forStartSlot < 0:
                forEndProbeKind = -1
                let _ = PrimaryBodyIrNodeEvalMissAt("for_start_shape")
        # task#18 for-range-i64-bound: 上界是 uint64(maxSize/n)时 probe 出 LocalI64Tag,原门禁
        # 只收 i32 → node_path_skip 落文本。idx 仍 i32、cbr BodyCondI32Lt 读低 32 位(与文本对
        # uint64 上界同款,buffer 尺寸 < INT32_MAX 实际正确),故接 i64 上界走同一发射路径。
        if forEndProbeKind == coreir.LocalI32Tag || forEndProbeKind == coreir.LocalI64Tag:
            let forNodeEmitMark = primaryBodyIrNodeEvalCallEmitCount
            let forBoundSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                     slotNames,
                                                     varI32ParamNames,
                                                     lowering,

                                                     typedFn,
                                                     irFunction,
                                                     stmt.rhsNodeIndex,
                                                     callOrdinal)
            if forBoundSlot < 0:
                if primaryBodyIrNodeEvalCallEmitCount != forNodeEmitMark:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 0)
                    pendingFalseTerm = -1
                    return forBodyEnd
            else:
                if forStartSlot >= 0:
                    if !PrimaryBodyIrNodeEvalStore(bodyIR,
                                                   slotNames,
                                                   idxSlot,
                                                   forStartSlot):
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     6101,
                                                     0)
                        pendingFalseTerm = -1
                        return forBodyEnd
                else:
                    var forIdxInitOp: coreir.BodyOp
                    forIdxInitOp.kind = coreir.BodyOpLoadConstTag
                    forIdxInitOp.target = idxSlot
                    add(forIdxInitOp.operands, coreir.LocalI32Tag)
                    add(forIdxInitOp.operands, forStartConst)
                    let _ = coreir.BodyIRAppendOp(bodyIR, forIdxInitOp)
                nextOpIndex = nextOpIndex + 1
                var forNodePreBr: coreir.BodyTerm
                forNodePreBr.kind = coreir.BodyTermBrTag
                forNodePreBr.conditionKind = coreir.BodyCondInvalidTag
                forNodePreBr.lhsSlot = -1
                forNodePreBr.rhsSlot = -1
                forNodePreBr.resultSlot = -1
                forNodePreBr.trueBlock = bodyIR.blocks.len + 1
                forNodePreBr.falseBlock = -1
                let forNodePreBrIdx = coreir.BodyIRAppendTerm(bodyIR, forNodePreBr)
                let forNodePreCount = bodyIR.ops.len - currentBlockStart
                let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, forNodePreCount, forNodePreBrIdx)
                currentBlockStart = bodyIR.ops.len
                var forNodeCbr: coreir.BodyTerm
                forNodeCbr.kind = coreir.BodyTermCbrTag
                forNodeCbr.conditionKind = coreir.BodyCondI32LtTag
                if forRangeInclusive:
                    forNodeCbr.conditionKind = coreir.BodyCondI32LeTag
                forNodeCbr.lhsSlot = idxSlot
                forNodeCbr.rhsSlot = forBoundSlot
                forNodeCbr.resultSlot = -1
                forNodeCbr.trueBlock = -1
                forNodeCbr.falseBlock = -1
                let forNodeCbrIdx = coreir.BodyIRAppendTerm(bodyIR, forNodeCbr)
                let forNodeHdrCount = bodyIR.ops.len - currentBlockStart
                let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, forNodeHdrCount, forNodeCbrIdx)
                currentBlockStart = bodyIR.ops.len
                pendingFalseTerm = forNodeCbrIdx
                PrimaryBodyIrNodeEvalOnlyOwn()
                PrimaryBodyIrConsumeHeaderConditionCallFeeders(irFunction.statements,
                                                               stmtIndex,
                                                               stmtEnd,
                                                               rangeText,
                                                               callFeederEmittedIndexes)
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=for_range function={typedFn.functionName} line={stmt.lineNumber}")
                return forBodyEnd
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            var forNodeMissOpText = primaryBodyIrNodeEvalMissOp
            if forNodeMissOpText == "":
                forNodeMissOpText = "for_header_shape"
            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={forNodeMissOpText} entry=for function={typedFn.functionName} line={stmt.lineNumber}")
    var initOp: coreir.BodyOp
    initOp.kind = coreir.BodyOpLoadConstTag
    initOp.target = idxSlot
    add(initOp.operands, coreir.LocalI32Tag)
    add(initOp.operands, rangeStart)
    let _ = coreir.BodyIRAppendOp(bodyIR, initOp)
    nextOpIndex = nextOpIndex + 1
    # 循环边界先经标量解析：全局变量需 GlobalLoad 物化。
    # seq.len / len(seq) 走 ScalarValueSlotForText 的 seq 臂或 SeqLenValueSlot；
    # 禁止裸 FindOrCreateSlot 造永不写入的孤儿槽（pure 实测 bound 读成 8 而
    # lines.len==4 → OOB PathTrim SEGV）。
    var boundSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                        slotNames,
                                                        varI32ParamNames,
                                                        lowering.typedIr,
                                                        stmt.sourcePath,
                                                        rangeEnd,
                                                        coreir.LocalI32Tag,
                                                        callOrdinal)
    if boundSlot < 0:
        boundSlot = PrimaryBodyIrSeqLenValueSlot(bodyIR,
                                                 slotNames,
                                                 lowering.typedIr,
                                                 typedFn,
                                                 irFunction,
                                                 stmt.sourcePath,
                                                 stmt.lineNumber,
                                                 rangeEnd)
    if boundSlot < 0:
        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                     stmt.lineNumber,
                                     int32(stmt.kind),
                                     6102,
                                     0)
        pendingFalseTerm = -1
        return forBodyEnd
    # preheader: 初始化只执行一次，回边只回到纯检查的 header 块
    var preBrTerm: coreir.BodyTerm
    preBrTerm.kind = coreir.BodyTermBrTag
    preBrTerm.conditionKind = coreir.BodyCondInvalidTag
    preBrTerm.lhsSlot = -1
    preBrTerm.rhsSlot = -1
    preBrTerm.resultSlot = -1
    preBrTerm.trueBlock = bodyIR.blocks.len + 1
    preBrTerm.falseBlock = -1
    let preBrIdx = coreir.BodyIRAppendTerm(bodyIR, preBrTerm)
    let preBlockCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, preBlockCount, preBrIdx)
    currentBlockStart = bodyIR.ops.len
    var cbrTerm: coreir.BodyTerm
    cbrTerm.kind = coreir.BodyTermCbrTag
    cbrTerm.conditionKind = coreir.BodyCondI32LtTag
    if exclHasLe:
        cbrTerm.conditionKind = coreir.BodyCondI32LeTag
    cbrTerm.lhsSlot = idxSlot
    cbrTerm.rhsSlot = boundSlot
    cbrTerm.resultSlot = -1
    cbrTerm.trueBlock = -1
    cbrTerm.falseBlock = -1
    let cbrIdx = coreir.BodyIRAppendTerm(bodyIR, cbrTerm)
    let blockCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, blockCount, cbrIdx)
    currentBlockStart = bodyIR.ops.len
    pendingFalseTerm = cbrIdx
    return forBodyEnd

@borrows
fn PrimaryBodyIrBuildWhileLoopHeader(bodyIR: var coreir.BodyIR,
                                      slotNames: var str[],
                                      varI32ParamNames: str[],
                                      lowering: var lower.LoweringPlanStub,
                                      nextOpIndex: var int32,
                                      currentBlockStart: var int32,
                                      typedFn: texpr.TypedExprIrFunction,
                                      irFunction: var lower.PrimaryObjectIrFunction,
                                      stmt: lower.PrimaryObjectIrStatement,
                                      stmtIndex: int32,
                                      stmtEnd: int32,
                                      callOrdinal: var int32,
                                      pendingWhileHeaderBlock: var int32,
                                      pendingWhileCbrTerm: var int32,
                                      pendingWhileFalseTerms: var int32[],
                                      callFeederEmittedIndexes: var int32[]): int32 =
    let whileBodyEnd = PrimaryBodyIrStructuredBodyEnd(irFunction.statements, stmtIndex, stmtEnd)
    let condText = PrimaryBodyIrConditionText(stmt.surfaceText)
    # preheader: 把循环前的 op 关进独立块，header 只含条件求值，回边才安全
    var whilePreBr: coreir.BodyTerm
    whilePreBr.kind = coreir.BodyTermBrTag
    whilePreBr.conditionKind = coreir.BodyCondInvalidTag
    whilePreBr.lhsSlot = -1
    whilePreBr.rhsSlot = -1
    whilePreBr.resultSlot = -1
    whilePreBr.trueBlock = bodyIR.blocks.len + 1
    whilePreBr.falseBlock = -1
    let whilePreBrIdx = coreir.BodyIRAppendTerm(bodyIR, whilePreBr)
    let whilePreCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, whilePreCount, whilePreBrIdx)
    currentBlockStart = bodyIR.ops.len
    if condText == "true":
        let trueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                     slotNames,
                                                     Fmt"while_true#{stmt.lineNumber}",
                                                     coreir.LocalI32Tag)
        var trueOp: coreir.BodyOp
        trueOp.kind = coreir.BodyOpLoadConstTag
        trueOp.target = trueSlot
        add(trueOp.operands, coreir.LocalI32Tag)
        add(trueOp.operands, 1)
        let _ = coreir.BodyIRAppendOp(bodyIR, trueOp)
        nextOpIndex = nextOpIndex + 1
        var cbrTermTrue: coreir.BodyTerm
        cbrTermTrue.kind = coreir.BodyTermCbrTag
        cbrTermTrue.conditionKind = coreir.BodyCondLocalNonZeroTag
        cbrTermTrue.lhsSlot = trueSlot
        cbrTermTrue.rhsSlot = -1
        cbrTermTrue.resultSlot = -1
        cbrTermTrue.trueBlock = -1
        cbrTermTrue.falseBlock = -1
        let cbrTermTrueIndex = coreir.BodyIRAppendTerm(bodyIR, cbrTermTrue)
        let cbrTrueBlockOpCount = bodyIR.ops.len - currentBlockStart
        pendingWhileHeaderBlock = coreir.BodyIRAppendBlock(bodyIR,
                                                           currentBlockStart,
                                                           cbrTrueBlockOpCount,
                                                           cbrTermTrueIndex)
        pendingWhileCbrTerm = cbrTermTrueIndex
        currentBlockStart = bodyIR.ops.len
        PrimaryBodyIrNodeEvalOnlyOwn()
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=while_true function={typedFn.functionName} line={stmt.lineNumber}")
        return whileBodyEnd
    # 批次6e：条件已节点化且探针可降（i32/bool）时经节点求值器产出条件
    # 槽，header 单块单 Cbr（nonzero），回边/出口补丁走既有 CloseWhileLoop
    # 管线。探针失败落回文本路径；求值在调用已发射后失败禁止落回。
    if stmt.rhsNodeIndex >= 0:
        primaryBodyIrNodeEvalMissOp = ""
        let whileNodeProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering,

                                                            typedFn,
                                                            irFunction,
                                                            stmt.rhsNodeIndex)
        if whileNodeProbeKind == coreir.LocalI32Tag:
            let whileNodeEmitMark = primaryBodyIrNodeEvalCallEmitCount
            let whileNodeCondSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          stmt.rhsNodeIndex,
                                                          callOrdinal)
            if whileNodeCondSlot >= 0:
                pendingWhileFalseTerms = []
                var whileNodeCbrTerm: coreir.BodyTerm
                whileNodeCbrTerm.kind = coreir.BodyTermCbrTag
                whileNodeCbrTerm.conditionKind = coreir.BodyCondLocalNonZeroTag
                whileNodeCbrTerm.lhsSlot = whileNodeCondSlot
                whileNodeCbrTerm.rhsSlot = -1
                whileNodeCbrTerm.resultSlot = -1
                whileNodeCbrTerm.trueBlock = -1
                whileNodeCbrTerm.falseBlock = -1
                let whileNodeTermIndex = coreir.BodyIRAppendTerm(bodyIR, whileNodeCbrTerm)
                let whileNodeBlockOpCount = bodyIR.ops.len - currentBlockStart
                pendingWhileHeaderBlock = coreir.BodyIRAppendBlock(bodyIR,
                                                                   currentBlockStart,
                                                                   whileNodeBlockOpCount,
                                                                   whileNodeTermIndex)
                pendingWhileCbrTerm = whileNodeTermIndex
                currentBlockStart = bodyIR.ops.len
                PrimaryBodyIrNodeEvalOnlyOwn()
                PrimaryBodyIrConsumeHeaderConditionCallFeeders(irFunction.statements,
                                                               stmtIndex,
                                                               stmtEnd,
                                                               condText,
                                                               callFeederEmittedIndexes)
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=while_cond function={typedFn.functionName} line={stmt.lineNumber}")
                return whileBodyEnd
            if primaryBodyIrNodeEvalCallEmitCount != whileNodeEmitMark:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             6101,
                                             0)
                pendingWhileHeaderBlock = -1
                pendingWhileCbrTerm = -1
                return whileBodyEnd
        let whileNodeRootOp = lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex]
        if whileNodeRootOp == texpr.TypedExprIrOpLogAnd ||
           whileNodeRootOp == texpr.TypedExprIrOpLogOr:
            if PrimaryBodyIrNodeCondChainProbe(bodyIR,
                                               slotNames,
                                               varI32ParamNames,
                                               lowering,

                                               typedFn,
                                               irFunction,
                                               stmt.rhsNodeIndex):
                let whileChainCount = PrimaryBodyIrNodeCondCbrBlockCount(lowering.typedIr, stmt.rhsNodeIndex)
                if whileChainCount > 1:
                    let whileChainEmitMark = primaryBodyIrNodeEvalCallEmitCount
                    let whileChainBlocksMark = bodyIR.blocks.len
                    pendingWhileFalseTerms = []
                    pendingWhileHeaderBlock = bodyIR.blocks.len
                    let whileChainSuccessBlock = bodyIR.blocks.len + whileChainCount
                    if PrimaryBodyIrNodeEmitCondCbrChain(bodyIR,
                                                         slotNames,
                                                         varI32ParamNames,
                                                         lowering,

                                                         typedFn,
                                                         irFunction,
                                                         stmt.rhsNodeIndex,
                                                         whileChainSuccessBlock,
                                                         -1,
                                                         callOrdinal,
                                                         currentBlockStart,
                                                         pendingWhileFalseTerms):
                        if pendingWhileFalseTerms.len > 0:
                            pendingWhileCbrTerm = pendingWhileFalseTerms[pendingWhileFalseTerms.len - 1]
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        PrimaryBodyIrConsumeHeaderConditionCallFeeders(irFunction.statements,
                                                                       stmtIndex,
                                                                       stmtEnd,
                                                                       condText,
                                                                       callFeederEmittedIndexes)
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=while_cond_chain function={typedFn.functionName} line={stmt.lineNumber}")
                        return whileBodyEnd
                    if primaryBodyIrNodeEvalCallEmitCount != whileChainEmitMark ||
                       bodyIR.blocks.len != whileChainBlocksMark:
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     6101,
                                                     0)
                        pendingWhileHeaderBlock = -1
                        pendingWhileCbrTerm = -1
                        return whileBodyEnd
                    pendingWhileHeaderBlock = -1
                    pendingWhileFalseTerms = []
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            var whileNodeMissOpText = primaryBodyIrNodeEvalMissOp
            if whileNodeMissOpText == "":
                whileNodeMissOpText = "cond_shape"
            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={whileNodeMissOpText} entry=while_cond function={typedFn.functionName} line={stmt.lineNumber}")
    pendingWhileFalseTerms = []
    let conditionBlockCount = PrimaryBodyIrConditionCbrBlockCount(condText)
    if conditionBlockCount > 0:
        pendingWhileHeaderBlock = bodyIR.blocks.len
        let successBlock = bodyIR.blocks.len + conditionBlockCount
        if PrimaryBodyIrEmitConditionCbrChain(bodyIR,
                                             slotNames,
                                             lowering,

                                             typedFn,
                                             irFunction,
                                             stmt.sourcePath,
                                             stmt.lineNumber,
                                             condText,
                                             successBlock,
                                             -1,
                                             callOrdinal,
                                             nextOpIndex,
                                             currentBlockStart,
                                             pendingWhileFalseTerms):
            if pendingWhileFalseTerms.len > 0:
                pendingWhileCbrTerm = pendingWhileFalseTerms[pendingWhileFalseTerms.len - 1]
            return whileBodyEnd
    var lhsSlot: int32
    var rhsSlot: int32
    var cmpTag: int32
    if !PrimaryBodyIrEmitConditionOps(bodyIR,
                                      slotNames,
                                      lowering,

                                      typedFn,
                                      irFunction,
                                      stmt.sourcePath,
                                      stmt.lineNumber,
                                      stmt.rhsNodeIndex,
                                      condText,
                                      lhsSlot,
                                      rhsSlot,
                                      cmpTag,
                                      callOrdinal,
                                      nextOpIndex):
        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                     stmt.lineNumber,
                                     int32(stmt.kind),
                                     81,
                                     0)
        pendingWhileHeaderBlock = -1
        pendingWhileCbrTerm = -1
        return whileBodyEnd
    var cbrTerm: coreir.BodyTerm
    cbrTerm.kind = coreir.BodyTermCbrTag
    cbrTerm.conditionKind = cmpTag
    cbrTerm.lhsSlot = lhsSlot
    cbrTerm.rhsSlot = rhsSlot
    cbrTerm.resultSlot = -1
    cbrTerm.trueBlock = -1
    cbrTerm.falseBlock = -1
    let cbrTermIndex = coreir.BodyIRAppendTerm(bodyIR, cbrTerm)
    let cbrBlockOpCount = bodyIR.ops.len - currentBlockStart
    pendingWhileHeaderBlock = coreir.BodyIRAppendBlock(bodyIR,
                                                       currentBlockStart,
                                                       cbrBlockOpCount,
                                                       cbrTermIndex)
    pendingWhileCbrTerm = cbrTermIndex
    currentBlockStart = bodyIR.ops.len
    return whileBodyEnd

fn PrimaryBodyIrCloseWhileLoop(bodyIR: var coreir.BodyIR,
                                currentBlockStart: var int32,
                                pendingWhileHeaderBlock: int32,
                                pendingWhileCbrTerm: int32,
                                pendingWhileFalseTerms: var int32[]): bool =
    if pendingWhileHeaderBlock < 0 ||
       pendingWhileHeaderBlock >= bodyIR.blocks.len ||
       pendingWhileCbrTerm < 0 ||
       pendingWhileCbrTerm >= bodyIR.terms.len:
        return false
    var brTerm: coreir.BodyTerm
    brTerm.kind = coreir.BodyTermBrTag
    brTerm.trueBlock = pendingWhileHeaderBlock
    brTerm.falseBlock = -1
    brTerm.conditionKind = coreir.BodyCondInvalidTag
    brTerm.lhsSlot = -1
    brTerm.rhsSlot = -1
    brTerm.resultSlot = -1
    let brTermIndex = coreir.BodyIRAppendTerm(bodyIR, brTerm)
    let backBlockCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, backBlockCount, brTermIndex)
    currentBlockStart = bodyIR.ops.len
    if bodyIR.terms[pendingWhileCbrTerm].trueBlock < 0:
        PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, pendingWhileCbrTerm)
        bodyIR.terms[pendingWhileCbrTerm].trueBlock = pendingWhileHeaderBlock + 1
    if bodyIR.terms[pendingWhileCbrTerm].falseBlock < 0:
        PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, pendingWhileCbrTerm)
        bodyIR.terms[pendingWhileCbrTerm].falseBlock = bodyIR.blocks.len
    for ti in 0..<pendingWhileFalseTerms.len:
        let falseTermIndex = pendingWhileFalseTerms[ti]
        if falseTermIndex >= 0 && falseTermIndex < bodyIR.terms.len:
            if bodyIR.terms[falseTermIndex].falseBlock < 0:
                PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, falseTermIndex)
                bodyIR.terms[falseTermIndex].falseBlock = bodyIR.blocks.len
    return true

fn PrimaryBodyIrCloseIfTop(bodyIR: var coreir.BodyIR,
                            currentBlockStart: var int32,
                            ifEndStk: var int32[],
                            ifSeqStk: var int32[],
                            ifIndentStk: var int32[],
                            ifFalseStartStk: var int32[],
                            ifFalsePool: var int32[],
                            ifJoinStartStk: var int32[],
                            ifJoinBrPool: var int32[]) =
    let top = ifEndStk.len - 1
    if top < 0:
        return
    var joinBr: coreir.BodyTerm
    joinBr.kind = coreir.BodyTermBrTag
    joinBr.conditionKind = coreir.BodyCondInvalidTag
    joinBr.lhsSlot = -1
    joinBr.rhsSlot = -1
    joinBr.resultSlot = -1
    joinBr.trueBlock = bodyIR.blocks.len + 1
    joinBr.falseBlock = -1
    let joinBrIdx = coreir.BodyIRAppendTerm(bodyIR, joinBr)
    let tailCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, tailCount, joinBrIdx)
    currentBlockStart = bodyIR.ops.len
    let joinBlock = bodyIR.blocks.len
    for fi in ifFalseStartStk[top]..<ifFalsePool.len:
        if ifFalsePool[fi] >= 0 &&
           ifFalsePool[fi] < bodyIR.terms.len &&
           bodyIR.terms[ifFalsePool[fi]].falseBlock < 0:
            PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, ifFalsePool[fi])
            bodyIR.terms[ifFalsePool[fi]].falseBlock = joinBlock
    for ji in ifJoinStartStk[top]..<ifJoinBrPool.len:
        if ifJoinBrPool[ji] >= 0 &&
           ifJoinBrPool[ji] < bodyIR.terms.len &&
           bodyIR.terms[ifJoinBrPool[ji]].trueBlock < 0:
            PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, ifJoinBrPool[ji])
            bodyIR.terms[ifJoinBrPool[ji]].trueBlock = joinBlock
    setLen(ifFalsePool, ifFalseStartStk[top])
    setLen(ifJoinBrPool, ifJoinStartStk[top])
    setLen(ifEndStk, top)
    setLen(ifSeqStk, top)
    setLen(ifIndentStk, top)
    setLen(ifFalseStartStk, top)
    setLen(ifJoinStartStk, top)

@borrows
fn PrimaryBodyIrBuildForSeqLoop(bodyIR: var coreir.BodyIR,
                                 slotNames: var str[],
                                 varI32ParamNames: str[],
                                 typedIr: texpr.TypedExprIr,
                                 typedFn: texpr.TypedExprIrFunction,
                                 irFunction: lower.PrimaryObjectIrFunction,
                                 nextOpIndex: var int32,
                                 currentBlockStart: var int32,
                                 stmt: lower.PrimaryObjectIrStatement,
                                 rangeText: str,
                                 pendingFalseTerm: var int32,
                                 callOrdinal: var int32): bool =
    if stmt.bindingName == "" || rangeText == "":
        return false
    var seqSourcePath = stmt.sourcePath
    if seqSourcePath == "":
        seqSourcePath = typedFn.sourcePath
    var seqRootSlot: int32
    var seqHeaderOffset: int32
    var seqTypeText = ""
    if !PrimaryBodyIrSeqRefForText(bodyIR,
                                   slotNames,
                                   typedIr,
                                   typedFn,
                                   irFunction,
                                   seqSourcePath,
                                   stmt.lineNumber,
                                   rangeText,
                                   seqRootSlot,
                                   seqHeaderOffset,
                                   seqTypeText):
        return false
    let seqElemType = strutil.Strip(strings.SliceBytes(seqTypeText,
                                                       0,
                                                       len(seqTypeText) - 2))
    var seqElemKind: int32
    var seqElemSize: int32
    var seqElemAlign: int32
    PrimaryBodyIrTypeShapeFromText(typedIr,
                                   seqSourcePath,
                                   seqElemType,
                                   seqElemKind,
                                   seqElemSize,
                                   seqElemAlign)
    if seqElemSize <= 0 &&
       len(seqElemType) >= 2 &&
       strings.SliceBytes(seqElemType, len(seqElemType) - 2, 2) == "[]":
        seqElemKind = coreir.LocalAggregateTag
        seqElemSize = 16
        seqElemAlign = 8
    if seqElemKind == coreir.LocalInvalidTag || seqElemSize <= 0:
        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
            os.WriteLine(os.GetStderr(), Fmt"phase=for_seq_elem_shape_fail function={typedFn.functionName} line={stmt.lineNumber} elem_type={seqElemType} source={seqSourcePath} layout_count={typedIr.typeLayoutNames.len}")
            for layoutIndex in 0..<typedIr.typeLayoutNames.len:
                if layoutIndex >= 32:
                    break
                var layoutSource = ""
                var layoutSize: int32
                var layoutAlign: int32
                var layoutFields: int32
                if layoutIndex < typedIr.typeLayoutSourcePaths.len:
                    layoutSource = typedIr.typeLayoutSourcePaths[layoutIndex]
                if layoutIndex < typedIr.typeLayoutSizeBytes.len:
                    layoutSize = typedIr.typeLayoutSizeBytes[layoutIndex]
                if layoutIndex < typedIr.typeLayoutAlignBytes.len:
                    layoutAlign = typedIr.typeLayoutAlignBytes[layoutIndex]
                if layoutIndex < typedIr.typeLayoutFieldCounts.len:
                    layoutFields = typedIr.typeLayoutFieldCounts[layoutIndex]
                os.WriteLine(os.GetStderr(), Fmt"phase=for_seq_layout_row index={layoutIndex} name={typedIr.typeLayoutNames[layoutIndex]} source={layoutSource} size={layoutSize} align={layoutAlign} fields={layoutFields}")
        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                     stmt.lineNumber,
                                     int32(stmt.kind),
                                     721,
                                     0)
        pendingFalseTerm = -1
        return true
    if seqElemAlign <= 0:
        seqElemAlign = 8
    let idxSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                slotNames,
                                                Fmt"#for_seq_idx#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                coreir.LocalI32Tag)
    if idxSlot < 0:
        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                     stmt.lineNumber,
                                     int32(stmt.kind),
                                     722,
                                     0)
        pendingFalseTerm = -1
        return true
    let elemSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                      slotNames,
                                                      typedIr,
                                                      seqSourcePath,
                                                      stmt.bindingName,
                                                      seqElemType)
    if elemSlot < 0 ||
       elemSlot >= bodyIR.localSlots.len ||
       PrimaryLocalSlotSizeOf(bodyIR.localSlots[elemSlot]) < seqElemSize:
        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                     stmt.lineNumber,
                                     int32(stmt.kind),
                                     723,
                                     seqElemSize)
        pendingFalseTerm = -1
        return true
    var lenSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                slotNames,
                                                Fmt"#for_seq_len#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                coreir.LocalI32Tag)
    if lenSlot < 0:
        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                     stmt.lineNumber,
                                     int32(stmt.kind),
                                     724,
                                     0)
        pendingFalseTerm = -1
        return true
    var lenLoadOp: coreir.BodyOp
    lenLoadOp.kind = coreir.BodyOpFieldLoadTag
    lenLoadOp.target = lenSlot
    add(lenLoadOp.operands, seqRootSlot)
    add(lenLoadOp.operands, lenSlot)
    add(lenLoadOp.operands, seqHeaderOffset)
    add(lenLoadOp.operands, 4)
    let _ = coreir.BodyIRAppendOp(bodyIR, lenLoadOp)
    var idxInitOp: coreir.BodyOp
    idxInitOp.kind = coreir.BodyOpLoadConstTag
    idxInitOp.target = idxSlot
    add(idxInitOp.operands, coreir.LocalI32Tag)
    add(idxInitOp.operands, 0)
    let _ = coreir.BodyIRAppendOp(bodyIR, idxInitOp)
    nextOpIndex = nextOpIndex + 1
    var seqPreBr: coreir.BodyTerm
    seqPreBr.kind = coreir.BodyTermBrTag
    seqPreBr.conditionKind = coreir.BodyCondInvalidTag
    seqPreBr.lhsSlot = -1
    seqPreBr.rhsSlot = -1
    seqPreBr.resultSlot = -1
    seqPreBr.trueBlock = bodyIR.blocks.len + 1
    seqPreBr.falseBlock = -1
    let seqPreBrIdx = coreir.BodyIRAppendTerm(bodyIR, seqPreBr)
    let seqPreCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, seqPreCount, seqPreBrIdx)
    currentBlockStart = bodyIR.ops.len
    var seqCbr: coreir.BodyTerm
    seqCbr.kind = coreir.BodyTermCbrTag
    seqCbr.conditionKind = coreir.BodyCondI32LtTag
    seqCbr.lhsSlot = idxSlot
    seqCbr.rhsSlot = lenSlot
    seqCbr.resultSlot = -1
    seqCbr.trueBlock = -1
    seqCbr.falseBlock = -1
    let seqCbrIdx = coreir.BodyIRAppendTerm(bodyIR, seqCbr)
    let seqHdrCount = bodyIR.ops.len - currentBlockStart
    let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, seqHdrCount, seqCbrIdx)
    currentBlockStart = bodyIR.ops.len
    pendingFalseTerm = seqCbrIdx
    let bufSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                slotNames,
                                                Fmt"#for_seq_buf#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                coreir.LocalPtrTag)
    let eszSlot = PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                  slotNames,
                                                  Fmt"#for_seq_esz#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                  coreir.LocalI64Tag,
                                                  seqElemSize)
    let addrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"#for_seq_addr#{stmt.lineNumber}#{bodyIR.ops.len}",
                                                 coreir.LocalPtrTag)
    if bufSlot < 0 || eszSlot < 0 || addrSlot < 0:
        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                     stmt.lineNumber,
                                     int32(stmt.kind),
                                     725,
                                     0)
        pendingFalseTerm = -1
        return true
    var bufLoadOp: coreir.BodyOp
    bufLoadOp.kind = coreir.BodyOpFieldLoadTag
    bufLoadOp.target = bufSlot
    add(bufLoadOp.operands, seqRootSlot)
    add(bufLoadOp.operands, bufSlot)
    add(bufLoadOp.operands, seqHeaderOffset + 8)
    add(bufLoadOp.operands, 8)
    let _ = coreir.BodyIRAppendOp(bodyIR, bufLoadOp)
    var addrOp: coreir.BodyOp
    addrOp.kind = coreir.BodyOpBinOpTag
    addrOp.target = addrSlot
    add(addrOp.operands, coreir.LocalI64Tag)
    add(addrOp.operands, int32(texpr.TypedExprIrOpI32Madd))
    add(addrOp.operands, idxSlot)
    add(addrOp.operands, eszSlot)
    add(addrOp.operands, bufSlot)
    let _ = coreir.BodyIRAppendOp(bodyIR, addrOp)
    var elemLoadOp: coreir.BodyOp
    elemLoadOp.kind = coreir.BodyOpFieldLoadTag
    elemLoadOp.target = elemSlot
    add(elemLoadOp.operands, addrSlot)
    add(elemLoadOp.operands, elemSlot)
    add(elemLoadOp.operands, 0)
    add(elemLoadOp.operands, seqElemSize)
    let _ = coreir.BodyIRAppendOp(bodyIR, elemLoadOp)
    PrimaryBodyIrNodeEvalOnlyOwn()
    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=for_seq function={typedFn.functionName} line={stmt.lineNumber} elem_type={seqElemType}")
    return true

fn PrimaryBodyIrCloseLoopTop(bodyIR: var coreir.BodyIR,
                              slotNames: var str[],
                              nextOpIndex: var int32,
                              currentBlockStart: var int32,
                              loopKindStk: var int32[],
                              loopEndStk: var int32[],
                              loopAStk: var int32[],
                              loopBStk: var int32[],
                              loopCStk: var int32[],
                              loopSeqStk: var int32[],
                              loopFalseStartStk: var int32[],
                              loopFalsePool: var int32[],
                              loopBreakStartStk: var int32[],
                              loopBreakPool: var int32[],
                              loopContinueStartStk: var int32[],
                              loopContinuePool: var int32[],
                              loopBackTermIndexes: var int32[]): int32 =
    let top = loopKindStk.len - 1
    if top < 0:
        return 0
    let kind = loopKindStk[top]
    let breakStart = loopBreakStartStk[top]
    let continueStart = loopContinueStartStk[top]
    let falseStart = loopFalseStartStk[top]
    if kind == 1:
        let idxSlot = loopAStk[top]
        let hdrBlk = loopBStk[top]
        let cbrTerm = loopCStk[top]
        # The loop latch (increment + back-branch) must be its OWN block so that
        # `continue` lands ONLY on the increment, not on the trailing body
        # statements that precede it. Previously the trailing body ops and the
        # increment shared one block, so `continue` (targeting that block) re-ran
        # the trailing statements (`for i: if c: continue; hits=hits+1` counted
        # the skipped iterations). Close the trailing body block first with a Br
        # into the fresh latch block.
        var bodyToLatchTerm: coreir.BodyTerm
        bodyToLatchTerm.kind = coreir.BodyTermBrTag
        bodyToLatchTerm.trueBlock = bodyIR.blocks.len + 1
        bodyToLatchTerm.falseBlock = -1
        bodyToLatchTerm.conditionKind = coreir.BodyCondInvalidTag
        bodyToLatchTerm.lhsSlot = -1
        bodyToLatchTerm.rhsSlot = -1
        bodyToLatchTerm.resultSlot = -1
        let bodyToLatchIdx = coreir.BodyIRAppendTerm(bodyIR, bodyToLatchTerm)
        let bodyTrailingCount = bodyIR.ops.len - currentBlockStart
        let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, bodyTrailingCount, bodyToLatchIdx)
        currentBlockStart = bodyIR.ops.len
        let continueBlock = bodyIR.blocks.len
        var oneSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR, slotNames, "_for_one", coreir.LocalI32Tag)
        var oneInit: coreir.BodyOp
        oneInit.kind = coreir.BodyOpLoadConstTag
        oneInit.target = oneSlot
        add(oneInit.operands, coreir.LocalI32Tag)
        add(oneInit.operands, 1)
        let _ = coreir.BodyIRAppendOp(bodyIR, oneInit)
        nextOpIndex = nextOpIndex + 1
        var incOp: coreir.BodyOp
        incOp.kind = coreir.BodyOpBinOpTag
        incOp.target = idxSlot
        add(incOp.operands, coreir.LocalI32Tag)
        add(incOp.operands, int32(texpr.TypedExprIrOpI32Add))
        add(incOp.operands, idxSlot)
        add(incOp.operands, oneSlot)
        let _ = coreir.BodyIRAppendOp(bodyIR, incOp)
        nextOpIndex = nextOpIndex + 1
        var brTerm: coreir.BodyTerm
        brTerm.kind = coreir.BodyTermBrTag
        brTerm.trueBlock = hdrBlk
        brTerm.falseBlock = -1
        brTerm.conditionKind = coreir.BodyCondInvalidTag
        brTerm.lhsSlot = -1
        brTerm.rhsSlot = -1
        brTerm.resultSlot = -1
        let brIdx = coreir.BodyIRAppendTerm(bodyIR, brTerm)
        add(loopBackTermIndexes, brIdx)
        let backCount = bodyIR.ops.len - currentBlockStart
        let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, backCount, brIdx)
        currentBlockStart = bodyIR.ops.len
        if cbrTerm >= 0 && cbrTerm < bodyIR.terms.len:
            PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, cbrTerm)
            bodyIR.terms[cbrTerm].falseBlock = bodyIR.blocks.len
        let exitBlock = bodyIR.blocks.len
        for bti in breakStart..<loopBreakPool.len:
            if loopBreakPool[bti] >= 0 && loopBreakPool[bti] < bodyIR.terms.len:
                PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, loopBreakPool[bti])
                bodyIR.terms[loopBreakPool[bti]].trueBlock = exitBlock
        for cti in continueStart..<loopContinuePool.len:
            if loopContinuePool[cti] >= 0 && loopContinuePool[cti] < bodyIR.terms.len:
                PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, loopContinuePool[cti])
                bodyIR.terms[loopContinuePool[cti]].trueBlock = continueBlock
    else:
        let headerBlock = loopAStk[top]
        let whileCbrTerm = loopBStk[top]
        let lineNumber = loopCStk[top]
        var whileFalseSlice: int32[]
        for fi in falseStart..<loopFalsePool.len:
            add(whileFalseSlice, loopFalsePool[fi])
        let closedWhile = PrimaryBodyIrCloseWhileLoop(bodyIR,
                                                      currentBlockStart,
                                                      headerBlock,
                                                      whileCbrTerm,
                                                      whileFalseSlice)
        if !closedWhile:
            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                         lineNumber,
                                         int32(texpr.TypedExprIrStmtWhile),
                                         82,
                                         0)
        else:
            add(loopBackTermIndexes, bodyIR.terms.len - 1)
            let whileExitBlock = bodyIR.blocks.len
            for bti in breakStart..<loopBreakPool.len:
                if loopBreakPool[bti] >= 0 && loopBreakPool[bti] < bodyIR.terms.len:
                    PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, loopBreakPool[bti])
                    bodyIR.terms[loopBreakPool[bti]].trueBlock = whileExitBlock
            for cti in continueStart..<loopContinuePool.len:
                if loopContinuePool[cti] >= 0 && loopContinuePool[cti] < bodyIR.terms.len:
                    PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, loopContinuePool[cti])
                    bodyIR.terms[loopContinuePool[cti]].trueBlock = headerBlock
    setLen(loopBreakPool, breakStart)
    setLen(loopContinuePool, continueStart)
    setLen(loopFalsePool, falseStart)
    setLen(loopKindStk, top)
    setLen(loopEndStk, top)
    setLen(loopAStk, top)
    setLen(loopBStk, top)
    setLen(loopCStk, top)
    # loopSeqStk 必须与其余循环并行栈同步弹出: 漏弹导致栈长错位, 函数内先
    # 关闭过一个循环后 loopSeqStk[loopKindStk.len-1] 读到陈旧 seq, "if 与
    # loop 同点闭合谁先关"判反 → if 假分支绑进循环 latch 块 → 落穿读错位
    # 栈槽当地址 (形态⑫, isolate13 SIGBUS 指令级实证)。
    setLen(loopSeqStk, top)
    setLen(loopFalseStartStk, top)
    setLen(loopBreakStartStk, top)
    setLen(loopContinueStartStk, top)
    return kind

# Same-line statement index (CSR layout). The body-IR builder runs ~21
# per-statement scans of the form `for X in 0..<stmtEnd: if
# statements[X].lineNumber != stmt.lineNumber: continue` — each O(N), so the
# whole loop is O(N²) per function (the second NODE_EVAL_ONLY census O(n²)
# hotspot). Build, once per function in O(N log N), an order array sorting
# statement indices by (lineNumber, originalIndex) plus, for every statement,
# the [lo,hi) range into that order array covering its line group. A same-line
# scan then iterates `for p in lineLo[i]..<lineHi[i]: let X = lineOrder[p]`,
# visiting exactly the same indices in the same ascending order — identical IR.
@borrows
fn PrimaryBodyIrSameLineOrderLess(statements: var lower.PrimaryObjectIrStatement[],
                                  a: int32,
                                  b: int32): bool =
    let la = statements[a].lineNumber
    let lb = statements[b].lineNumber
    if la != lb:
        return la < lb
    return a < b

fn PrimaryBodyIrSameLineOrderMergePass(statements: var lower.PrimaryObjectIrStatement[],
                                       src: var int32[],
                                       dst: var int32[],
                                       width: int32) =
    let count = src.len
    var leftStart: int32
    while leftStart < count:
        if leftStart % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let midRaw = leftStart + width
        var mid = count
        if midRaw < count:
            mid = midRaw
        let rightEndRaw = leftStart + width * 2
        var rightEnd = count
        if rightEndRaw < count:
            rightEnd = rightEndRaw
        var left = leftStart
        var right = mid
        for outIndex in leftStart..<rightEnd:
            if outIndex % 4096 == 0:
                os.ProcessResourceGuardCheck()
            if left < mid &&
               (right >= rightEnd ||
                !PrimaryBodyIrSameLineOrderLess(statements, src[right], src[left])):
                dst[outIndex] = src[left]
                left = left + 1
            else:
                dst[outIndex] = src[right]
                right = right + 1
        leftStart = leftStart + width * 2

# Builds lineOrder (statement indices sorted by line) plus lineLo/lineHi
# (length stmtEnd) giving each statement the [lo,hi) range in lineOrder that
# covers all statements sharing its lineNumber. lineLo/lineHi are indexed by
# the ORIGINAL statement index (not the sorted position) so callers key them
# with stmtIndex directly.
fn PrimaryBodyIrBuildSameLineIndex(statements: var lower.PrimaryObjectIrStatement[],
                                   lineOrder: var int32[],
                                   lineLo: var int32[],
                                   lineHi: var int32[]) =
    let count = statements.len
    lineOrder = []
    lineLo = []
    lineHi = []
    for i in 0..<count:
        add(lineOrder, i)
        add(lineLo, 0)
        add(lineHi, 0)
    if count <= 1:
        if count == 1:
            lineLo[0] = 0
            lineHi[0] = 1
        return
    var scratch: int32[]
    for i in 0..<count:
        add(scratch, lineOrder[i])
    var width: int32 = 1
    var readScratch = false
    while width < count:
        if readScratch:
            PrimaryBodyIrSameLineOrderMergePass(statements, scratch, lineOrder, width)
        else:
            PrimaryBodyIrSameLineOrderMergePass(statements, lineOrder, scratch, width)
        readScratch = !readScratch
        if width > count / 2:
            width = count
        else:
            width = width * 2
    if readScratch:
        for i in 0..<count:
            lineOrder[i] = scratch[i]
    # Walk the sorted order assigning each contiguous same-line run its
    # [lo,hi) range, keyed back to the original statement index.
    var runStart: int32
    while runStart < count:
        var runEnd = runStart + 1
        let runLine = statements[lineOrder[runStart]].lineNumber
        while runEnd < count && statements[lineOrder[runEnd]].lineNumber == runLine:
            runEnd = runEnd + 1
        for p in runStart..<runEnd:
            lineLo[lineOrder[p]] = runStart
            lineHi[lineOrder[p]] = runEnd
        runStart = runEnd

# 同行语句排序二级键：控制流头返回 0（靠前），体/其他返回 1。
# 用于源行稳定排序时确保 `if/elif/...` 头排在其同行体（return/assign）之前。
@borrows
fn PrimaryBodyIrStmtHeaderSortPriority(kind: texpr.TypedExprIrStatementKind): int32 =
    if kind == texpr.TypedExprIrStmtIf ||
       kind == texpr.TypedExprIrStmtElif ||
       kind == texpr.TypedExprIrStmtElse ||
       kind == texpr.TypedExprIrStmtIfCall ||
       kind == texpr.TypedExprIrStmtMatch ||
       kind == texpr.TypedExprIrStmtCase ||
       kind == texpr.TypedExprIrStmtFor ||
       kind == texpr.TypedExprIrStmtWhile:
        return 0
    return 1

# T38C: 单行函数体糖(有返回类型)的三元 if-表达式尾返回——
# `fn f(v): T = if c: a else: b`——从未走到 LocalDecl / 显式 return 语句的
# 消费点(那两处 T25C/T38B 已接好 PrimaryBodyIrAppendScalarTernaryBlockValue /
# PrimaryBodyIrAppendStrTernaryDeclValue 真分支下降), 只到
# PrimaryBuildBodyIrFromTypedStatements 尾部"函数体只有隐式返回表达式、无
# 显式语句"这条兜底路径——那里原先把整段三元文本当成一个待查找的标识符名,
# 找不到就 FindOrCreateTypedSlot 静默造一个从未写过值的新槽, 读出栈上残留
# 垃圾(既有 miscompile, 非本次引入)。复用同一对真分支下降函数, 不发明新
# 判定标准: 与 LocalDecl / 显式 str return 消费点完全同款(按返回类型
# str/标量分派), 只是槽名换成尾返回专用前缀。返回 true 表示已产出 return
# term; 调用方(elif 分支)按表达式语句忽略返回值——分派失败时不产生任何
# term/op, 让原有的尾部诚实 InvalidOp(bail=93) 兜底接手, 绝不落穿到更弱的
# 标识符兜底造垃圾槽。
@borrows
fn PrimaryBodyIrAppendTailReturnTernaryValue(bodyIR: var coreir.BodyIR,
                                              slotNames: var str[],
                                              varI32ParamNames: str[],
                                              lowering: var lower.LoweringPlanStub,
                                              typedFn: texpr.TypedExprIrFunction,
                                              irFunction: lower.PrimaryObjectIrFunction,
                                              ternaryTextRaw: str,
                                              callOrdinal: var int32,
                                              currentBlockStart: var int32): bool =
    var tailTernTypeKind: int32
    var tailTernTypeSizeBytes: int32
    var tailTernTypeAlignBytes: int32
    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                   typedFn.sourcePath,
                                   typedFn.returnType,
                                   tailTernTypeKind,
                                   tailTernTypeSizeBytes,
                                   tailTernTypeAlignBytes)
    if tailTernTypeKind == coreir.LocalStrTag:
        let tailTernSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                         slotNames,
                                                         Fmt"#ret_tail_str_tern#{typedFn.bodyLineNumber}",
                                                         coreir.LocalStrTag)
        if tailTernSlot < 0:
            return false
        var tailTernStmt: lower.PrimaryObjectIrStatement
        tailTernStmt.sourcePath = typedFn.sourcePath
        tailTernStmt.functionName = typedFn.functionName
        tailTernStmt.lineNumber = typedFn.bodyLineNumber
        tailTernStmt.kind = texpr.TypedExprIrStmtUnsupported
        if !PrimaryBodyIrAppendStrTernaryDeclValue(bodyIR,
                                                   slotNames,
                                                   varI32ParamNames,
                                                   lowering,

                                                   typedFn,
                                                   irFunction,
                                                   tailTernStmt,
                                                   typedFn.returnNodeIndex,
                                                   ternaryTextRaw,
                                                   tailTernSlot,
                                                   callOrdinal,
                                                   currentBlockStart):
            return false
        PrimaryBodyIrAppendReturnTerm(bodyIR,
                                      currentBlockStart,
                                      tailTernSlot,
                                      coreir.LocalStrTag,
                                      0,
                                      false)
        return true
    if tailTernTypeKind != coreir.LocalI32Tag &&
       tailTernTypeKind != coreir.LocalI64Tag &&
       tailTernTypeKind != coreir.LocalF64Tag &&
       tailTernTypeKind != coreir.LocalPtrTag:
        return false
    let tailTernSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                          slotNames,
                                                          lowering.typedIr,
                                                          typedFn.sourcePath,
                                                          Fmt"#ret_tail_scalar_tern#{typedFn.bodyLineNumber}",
                                                          typedFn.returnType)
    if tailTernSlot < 0:
        return false
    var tailTernBlockStart = currentBlockStart
    if !PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                   slotNames,
                                                   varI32ParamNames,
                                                   lowering,

                                                   typedFn,
                                                   irFunction,
                                                   typedFn.sourcePath,
                                                   typedFn.bodyLineNumber,
                                                   typedFn.returnNodeIndex,
                                                   ternaryTextRaw,
                                                   tailTernSlot,
                                                   tailTernTypeKind,
                                                   callOrdinal,
                                                   tailTernBlockStart):
        return false
    currentBlockStart = tailTernBlockStart
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  tailTernSlot,
                                  tailTernTypeKind,
                                  0,
                                  false)
    return true

# W2 槽绑定根修配套: `cond ? a : "lit"` 等 ptr 三元臂的字符串字面量物化。
# 与 let-decl 的 `var p: ptr = "..."` (本文件 23175 附近) 同一 LoadLocal+CString
# 形。三元臂文本为裸字面量时 PtrExpressionSlot/CondCmpOperandSlot 均解不出,
# 缺本臂则下方选择门静默跳过、目标槽成孤儿 (cheng_panic_cstring_and_exit_export
# 的 safeText 实案: stderr 写入参被绑到全函数零写点的槽)。
fn PrimaryBodyIrCStringLiteralPtrSlot(bodyIR: var coreir.BodyIR,
                                      slotNames: var str[],
                                      textRaw: str): int32 =
    let text = strutil.Strip(textRaw)
    if !PrimaryBodyIrTextIsStringLiteral(text):
        return -1
    let cstrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 Fmt"{text}#cstr_ptr#{bodyIR.ops.len}",
                                                 coreir.LocalPtrTag)
    if cstrSlot < 0:
        return -1
    let literalId = coreir.BodyIRAppendCStringLiteral(bodyIR,
                                                      PrimaryBodyIrStringLiteralPayload(text),
                                                      "")
    if literalId < 0:
        return -1
    var cstrOp: coreir.BodyOp
    cstrOp.kind = coreir.BodyOpLoadLocalTag
    cstrOp.target = cstrSlot
    add(cstrOp.operands, coreir.BodyLoadLocalCStringTag)
    add(cstrOp.operands, literalId)
    let _ = coreir.BodyIRAppendOp(bodyIR, cstrOp)
    return cstrSlot

@borrows
fn PrimaryBodyIrBeginPublishedDebugProvenance(
        bodyIR: var coreir.BodyIR,
        lowering: var lower.LoweringPlanStub,
        typedFunctionIndex: int32) =
    if !lowering.semanticDebugBound:
        return
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >=
           lowering.semanticDebugFunctionIdsByTypedFunctionIndex.len:
        let _ = coreir.BodyIRDebugProvenanceBegin(bodyIR, -1)
        return
    let _ = coreir.BodyIRDebugProvenanceBegin(
        bodyIR,
        lowering.semanticDebugFunctionIdsByTypedFunctionIndex[
            typedFunctionIndex])

@borrows
fn PrimaryBodyIrBindPublishedStatementDebugProvenance(
        bodyIR: var coreir.BodyIR,
        lowering: var lower.LoweringPlanStub,
        stmt: lower.PrimaryObjectIrStatement) =
    if !bodyIR.debugProvenanceRequired:
        return
    var typedNodeIndex = stmt.rhsNodeIndex
    if typedNodeIndex < 0:
        typedNodeIndex = stmt.forStartNodeIndex
    if typedNodeIndex < 0:
        typedNodeIndex = stmt.assignIndexNodeIndex
    if typedNodeIndex < 0:
        let _ = coreir.BodyIRDebugProvenanceSetSynthetic(
            bodyIR, coreir.BodyDebugSyntheticControlFlow)
        return
    if typedNodeIndex >=
           lowering.semanticDebugOpIdsByTypedIrNodeIndex.len ||
       lowering.semanticDebugOpIdsByTypedIrNodeIndex[
           typedNodeIndex] < 0:
        coreir.BodyIRDebugProvenanceMarkIncomplete(bodyIR)
        return
    let _ = coreir.BodyIRDebugProvenanceSetExact(
        bodyIR,
        lowering.semanticDebugOpIdsByTypedIrNodeIndex[typedNodeIndex])

@borrows
fn PrimaryBodyIrControlScopeDescendsFrom(
        transport: lower.LoweringDeferScopeTransportSoA,
        scopeId: int32,
        ancestorScopeId: int32): bool =
    if scopeId < 0 ||
       scopeId >= transport.scopeParentIds.len ||
       ancestorScopeId < 0 ||
       ancestorScopeId >= transport.scopeParentIds.len:
        return false
    var currentScopeId = scopeId
    var remaining = transport.scopeParentIds.len + 1
    while currentScopeId >= 0 && remaining > 0:
        if currentScopeId == ancestorScopeId:
            return true
        if currentScopeId >= transport.scopeParentIds.len:
            return false
        currentScopeId = transport.scopeParentIds[currentScopeId]
        remaining = remaining - 1
    return false

@borrows
fn PrimaryBodyIrControlValidateDeferActionStatement(
        transport: lower.LoweringDeferScopeTransportSoA,
        stmt: lower.PrimaryObjectIrStatement,
        ownerStatementOrdinal: int32,
        suiteScopeId: int32) =
    if stmt.deferOwnerStatementOrdinal != ownerStatementOrdinal ||
       !PrimaryBodyIrControlScopeDescendsFrom(
           transport, stmt.lexicalScopeId, suiteScopeId):
        panic("primary body ir control: defer action ownership drift")
    if stmt.kind == texpr.TypedExprIrStmtDefer ||
       stmt.kind == texpr.TypedExprIrStmtReturn ||
       stmt.kind == texpr.TypedExprIrStmtBreak ||
       stmt.kind == texpr.TypedExprIrStmtContinue:
        panic("primary body ir control: forbidden defer action exit")

@borrows
fn PrimaryBodyIrControlBindCanonicalCallTarget(
        bodyIR: var coreir.BodyIR,
        lowering: var lower.LoweringPlanStub,
        callId: int32,
        typedIrNodeIndex: int32) =
    if bodyIR.controlFunctionRow < 0:
        return
    # BindCallTarget 的逐 callId 推进契约要求三列与本 call 之前的全部
    # callSequence 行精确对齐。合成运行时调用（setMem/str 桥/puts 等）
    # append 时不绑，若它们出现在本 call 之前，当前 canonical 绑定会被
    # 三列长度落后卡死 —— 先把本 call 之前的残余 synth 行追平（排除
    # 尾部 1 行 = 正在绑定的当前行），再走 canonical 绑定。
    PrimaryBodyIrControlBindResidualSyntheticCallTargetsInto(
        bodyIR, 1)
    lower.LoweringBodyIrBindCanonicalCallIdentity(
        bodyIR, lowering, callId, typedIrNodeIndex)

# 合成运行时调用的接口身份 = (targetSymbol, importc 位, 结果/实参传递形)
# 在该函数 TypeArena artifact 域内的精确哈希。同一形状的调用共享一个
# canonical runtime-intrinsic row；不同符号或不同传递形绝不合并
# （seal 的 same-row ⟺ same-cid 对账由此按构造成立）。不把 resultSlot/
# argSlots 等槽位编进身份：槽位是本次编译的布局产物，不是调用接口。
# argAbiSizes 同样不进：pending-empty（len==0）是合成桥的既有合法态
# （emit 期 PrimaryCallOpArgAbiSize 对缺列默认 8，cleanup_cfg 对账允许
# 0 或全列），ABI 宽度是派生事实而非调用接口。
@borrows
fn PrimaryBodyIrSyntheticRuntimeCallInterfaceCid(
        typeArenaArtifactCid: layout.FixedBytes32,
        call: coreir.CallOp): layout.FixedBytes32 =
    if !coreir.BodyIRTypeArenaArtifactCidValid(typeArenaArtifactCid) ||
       len(call.targetSymbol) <= 0 ||
       call.semanticCallExprNodeIndex != -1 ||
       call.argSlots.len != call.argPassKinds.len:
        panic("primary body ir control: synthetic call identity invalid")
    var buf = layout.ByteBufInit(256)
    primaryObjectSymbolIdentityAppendText(
        buf, "cheng.primary.synthetic_runtime_call.interface.v1")
    layout.ByteBufAppendFixed32(buf, typeArenaArtifactCid)
    primaryObjectSymbolIdentityAppendText(buf, call.targetSymbol)
    primaryObjectSymbolIdentityAppendU32(
        buf, call.targetIsImportc ? 1 : 0)
    primaryObjectSymbolIdentityAppendU32(buf, call.resultPassKind)
    primaryObjectSymbolIdentityAppendU32(buf, call.argSlots.len)
    for argIndex in 0..<call.argSlots.len:
        primaryObjectSymbolIdentityAppendU32(
            buf, call.argPassKinds[argIndex])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    if layout.FixedBytes32Equal(out, layout.FixedBytes32()):
        panic("primary body ir control: zero synthetic call cid")
    return out

# 残余扫尾：把「append 进 callSequence 但未经 canonical 绑定」的合成
# 运行时调用逐行绑定为 runtime intrinsic，至多推进到
# callSequence.len - reservedTailRows（canonical 绑定路径传 1，把正在
# 绑定的当前行留给 canonical 权威；守卫前收口传 0，覆盖全部残余）。
# 精确性论证：
# 1. canonical 用户 call 位在 append 后由
#    PrimaryBodyIrControlBindCanonicalCallTarget 绑定（panic-on-miss），
#    且绑定会写 semanticCallExprNodeIndex >= 0；合成调用该字段恒为声明
#    默认 -1（coreir.CallOp 字段默认）。两族行按构造互斥，本循环绝不
#    劫持用户 call 位的绑定责任。
# 2. BindCallTarget 自身要求 callId 恰等于三列当前长度并逐行推进，残余
#    循环从三列长度起步，无法跳行/重复。
# 3. 每行仍强制非空 targetSymbol —— 无目标的合成行按 poison-on-miss
#    既有语义在各自 append 点已拒绝，此处兜底 fail-closed。
fn PrimaryBodyIrControlBindResidualSyntheticCallTargetsInto(
        bodyIR: var coreir.BodyIR,
        reservedTailRows: int32) =
    if bodyIR.controlFlowSealed || bodyIR.controlFunctionRow < 0 ||
       reservedTailRows < 0:
        panic("primary body ir control: synthetic bind state invalid")
    while bodyIR.callTargetDomainKinds.len <
          bodyIR.callSequence.len - reservedTailRows:
        let callId = bodyIR.callTargetDomainKinds.len
        coreir.BodyIRControlFlowBindCallTarget(
            bodyIR,
            callId,
            coreir.BodyCallTargetDomainRuntimeIntrinsicTag,
            0,
            PrimaryBodyIrSyntheticRuntimeCallInterfaceCid(
                bodyIR.typeArenaArtifactCid,
                bodyIR.callSequence[callId]))

@borrows
fn PrimaryBodyIrControlBeginDeferAction(
        bodyIR: var coreir.BodyIR,
        transport: lower.LoweringDeferScopeTransportSoA,
        stmt: lower.PrimaryObjectIrStatement,
        currentBlockStart: var int32,
        skipTermIndexOut: var int32) =
    if stmt.kind != texpr.TypedExprIrStmtDefer ||
       stmt.statementIndex < 0 ||
       stmt.lexicalScopeId < 0 ||
       stmt.suiteScopeId < 0 ||
       stmt.statementOrdinal < 0 ||
       stmt.lexicalOrdinal < 0 ||
       stmt.deferOwnerStatementOrdinal >= 0 ||
       stmt.suiteScopeId >= transport.scopeParentIds.len ||
       transport.scopeParentIds[stmt.suiteScopeId] !=
           stmt.lexicalScopeId:
        panic("primary body ir control: invalid defer declaration")
    var skipTerm: coreir.BodyTerm
    skipTerm.kind = coreir.BodyTermBrTag
    skipTerm.trueBlock = -1
    skipTerm.falseBlock = -1
    skipTerm.conditionKind = coreir.BodyCondInvalidTag
    skipTerm.lhsSlot = -1
    skipTerm.rhsSlot = -1
    skipTerm.resultSlot = -1
    skipTermIndexOut = coreir.BodyIRAppendTerm(bodyIR, skipTerm)
    let declarationBlockId = coreir.BodyIRAppendBlock(
        bodyIR,
        currentBlockStart,
        bodyIR.ops.len - currentBlockStart,
        skipTermIndexOut)
    currentBlockStart = bodyIR.ops.len
    lower.LoweringBodyIrControlBindNewBlocks(
        bodyIR, stmt.lexicalScopeId)
    let _ = lower.LoweringBodyIrControlBindDeferAction(
        bodyIR,
        transport,
        stmt.statementIndex,
        declarationBlockId,
        bodyIR.blocks[declarationBlockId].opCount)

@borrows
fn PrimaryBodyIrControlFinishDeferAction(
        bodyIR: var coreir.BodyIR,
        suiteScopeId: int32,
        skipTermIndex: int32,
        currentBlockStart: var int32) =
    if suiteScopeId < 0 ||
       suiteScopeId >= bodyIR.controlScopeParentIds.len ||
       skipTermIndex < 0 ||
       skipTermIndex >= bodyIR.terms.len ||
       bodyIR.terms[skipTermIndex].kind != coreir.BodyTermBrTag ||
       bodyIR.terms[skipTermIndex].trueBlock >= 0:
        panic("primary body ir control: invalid defer action state")
    lower.LoweringBodyIrControlBindNewBlocks(bodyIR, suiteScopeId)
    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                  currentBlockStart,
                                  -1,
                                  coreir.LocalInvalidTag,
                                  0,
                                  false)
    lower.LoweringBodyIrControlBindNewBlocks(bodyIR, suiteScopeId)
    bodyIR.terms[skipTermIndex].trueBlock = bodyIR.blocks.len

fn PrimaryBuildBodyIrFromTypedStatements(
    lowering: var lower.LoweringPlanStub,
    typedFnIndex: int32,
    irFunction: var lower.PrimaryObjectIrFunction,
    seqAddCandidateCountOut: var int32,
    seqAddTypedContractCountOut: var int32,
    structuredSeqAddConsumeCountOut: var int32,
    seqAddNodeProbeHitCountOut: var int32,
    seqAddTypeMismatchCountOut: var int32,
    seqAddLegacyTextConsumeCountOut: var int32,
    seqAddNodeEvalGapCountOut: var int32,
    structuredResultIntrinsicConsumeCountOut: var int32
): coreir.BodyIR =
    seqAddCandidateCountOut = 0
    seqAddTypedContractCountOut = 0
    structuredSeqAddConsumeCountOut = 0
    seqAddNodeProbeHitCountOut = 0
    seqAddTypeMismatchCountOut = 0
    seqAddLegacyTextConsumeCountOut = 0
    seqAddNodeEvalGapCountOut = 0
    structuredResultIntrinsicConsumeCountOut = 0
    let traceEnabled = PrimaryObjectPlanTraceActive()
    if traceEnabled:
        PrimaryObjectPlanTrace(Fmt"primary_body_ir_from_typed_enter typed_index={typedFnIndex}")
    # combo C: 从 SoA/id 构造 typedFn (不再读 AoS functions[] 数组), 89 处用法不变
    let typedFn = texpr.TypedExprIrFunction(
        sourcePath: Value(langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.functions2_sourcePathIds[typedFnIndex])),
        functionName: Value(langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.functions2_functionNameIds[typedFnIndex])),
        returnType: Value(langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.functions2_returnTypeIds[typedFnIndex])),
        resultExprClass: lowering.typedIr.functions2_resultExprClasses[typedFnIndex],
        returnExpr: Value(langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.functions2_returnExprIds[typedFnIndex])),
        signatureLineNumber: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_signatureLineNumbers, typedFnIndex),
        endLineNumber: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_endLineNumbers, typedFnIndex),
        bodyLineNumber: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_bodyLineNumbers, typedFnIndex),
        statementStart: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_statementStarts, typedFnIndex),
        statementCount: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_statementCounts, typedFnIndex),
        nodeStart: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_nodeStarts, typedFnIndex),
        nodeCount: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_nodeCounts, typedFnIndex),
        returnNodeIndex: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_returnNodeIndexs, typedFnIndex),
        valueDefinitionStart: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_valueDefinitionStarts, typedFnIndex),
        valueDefinitionCount: arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.functions2_valueDefinitionCounts, typedFnIndex),
    )
    if traceEnabled:
        PrimaryObjectPlanTrace(Fmt"primary_body_ir_from_typed_after_typed_fn name={typedFn.functionName}")
    var nodeEvalPhantom = false
    if PrimaryBodyIrNodeEvalOnlyActive():
        if PrimaryObjectCallTargetIsBuiltin(typedFn.functionName) ||
           PrimaryTypeTextHasGenericPlaceholder(typedFn.returnType):
            nodeEvalPhantom = true
        for nodeEvalParamI in 0..<irFunction.paramTypes.len:
            if PrimaryTypeTextHasGenericPlaceholder(irFunction.paramTypes[nodeEvalParamI]):
                nodeEvalPhantom = true
    PrimaryBodyIrNodeEvalOnlyEnterFunction(typedFn.sourcePath, typedFn.functionName, nodeEvalPhantom)
    if os.GetEnv("CHENG_X64_DBG2") != "":
        os.WriteLine(os.GetStderr(), Fmt"x64dbg2 enter fn={typedFn.functionName} stmts={irFunction.statements.len} return_expr={typedFn.returnExpr} return_type={typedFn.returnType} body_line={typedFn.bodyLineNumber} ir_body_kind={irFunction.bodyKind}")
    # typed_expr 层把 LocalDecl 分组提前，带副作用初始化器的语句会越过
    # 先行语句（let raw = c_malloc(total) 先于 cheng_runtime_lock() 物化）。
    # 按源行号稳定排序恢复源序；同行/合成语句（line<=0）维持相对顺序。
    var stmtSortI = 1
    while stmtSortI < irFunction.statements.len:
        let stmtSortPick = irFunction.statements[stmtSortI]
        if stmtSortPick.lineNumber > 0:
            var stmtSortJ = stmtSortI - 1
            # 同行语句：控制流头（if/elif/else/ifcall/match/case/for/while）
            # 必须排在其体（return/assign/localdecl/...）之前。typed_expr 层
            # 把 match 臂重排为体先于头，稳定排序按行恢复后仍保留该逆序，
            # 导致 `A => return 1` 的 return 先于 `if k == A` 无条件执行。
            # 用头/体二级键破除同行逆序。
            let pickLine = stmtSortPick.lineNumber
            let pickPri = PrimaryBodyIrStmtHeaderSortPriority(stmtSortPick.kind)
            while stmtSortJ >= 0 &&
                  (irFunction.statements[stmtSortJ].lineNumber > pickLine ||
                   (irFunction.statements[stmtSortJ].lineNumber == pickLine &&
                    PrimaryBodyIrStmtHeaderSortPriority(irFunction.statements[stmtSortJ].kind) > pickPri)):
                irFunction.statements[stmtSortJ + 1] = irFunction.statements[stmtSortJ]
                stmtSortJ = stmtSortJ - 1
            irFunction.statements[stmtSortJ + 1] = stmtSortPick
        stmtSortI = stmtSortI + 1
    var stmtEnd = irFunction.statements.len
    if traceEnabled:
        PrimaryObjectPlanTrace(Fmt"primary_body_ir_from_typed_after_stmt_end count={stmtEnd}")
    var bodyIR = coreir.BodyIRNew()
    if !coreir.BodyIRBindTypeArenaArtifactCid(
           bodyIR, lowering.typeArenaArtifactCid):
        panic("primary body ir: canonical TypeArena artifact CID missing")
    coreir.BodyIRBindLocalBindingValueDefinitionDomain(
        bodyIR,
        typedFn.valueDefinitionStart,
        typedFn.valueDefinitionCount)
    var localBindingProjection =
        coreir.BodyIRLocalBindingValueDefinitionProjectionNew(bodyIR)
    var deferScopeTransport = irFunction.deferScopeTransport
    lower.LoweringBodyIrControlBegin(
        bodyIR, deferScopeTransport, typedFnIndex)
    irFunction.deferScopeTransport = deferScopeTransport
    PrimaryBodyIrBeginPublishedDebugProvenance(
        bodyIR, lowering, typedFnIndex)
    if traceEnabled:
        PrimaryObjectPlanTrace("primary_body_ir_from_typed_after_body_new")
    var slotNames: str[]
    slotNames = []
    var callOrdinal: int32
    var nextOpIndex: int32
    var currentBlockStart: int32
    var pendingFalseTerm: int32
    var pendingIfFalseBodyEnd: int32
    var skipStatementUntilIndex: int32
    var completedReturnLineNumber: int32
    var pendingWhileHeaderBlock: int32
    var pendingWhileCbrTerm: int32
    var pendingWhileFalseTerms: int32[]
    var loopKindStk: int32[]
    var loopEndStk: int32[]
    var loopAStk: int32[]
    var loopBStk: int32[]
    var loopCStk: int32[]
    var loopFalseStartStk: int32[]
    var loopFalsePool: int32[]
    var loopBreakStartStk: int32[]
    var loopContinueStartStk: int32[]
    var loopSeqStk: int32[]
    var ifEndStk: int32[]
    var ifSeqStk: int32[]
    var ifIndentStk: int32[]
    var ifFalseStartStk: int32[]
    var ifFalsePool: int32[]
    var ifJoinStartStk: int32[]
    var ifJoinBrPool: int32[]
    var constructSeq: int32
    var pendingCompoundFalseTerms: int32[]
    var pendingLoopBreakTerms: int32[]
    var pendingLoopContinueTerms: int32[]
    var controlBreakTermIndexes: int32[]
    var controlContinueTermIndexes: int32[]
    var controlLoopBackTermIndexes: int32[]
    var controlCurrentScopeId: int32
    var controlDeferActive: bool
    var controlDeferOwnerStatementOrdinal: int32
    var controlDeferSuiteScopeId: int32
    var controlDeferSkipTermIndex: int32
    var controlDeferLoopDepth: int32
    var controlDeferIfDepth: int32
    var controlDeferSavedScopeId: int32
    var controlDeferSavedPendingFalseTerm: int32
    var controlDeferSavedPendingIfFalseBodyEnd: int32
    var controlDeferSavedPendingCompoundFalseTerms: int32[]
    var initializedLocalDeclLines: int32[]
    var initializedLocalDeclNames: str[]
    pendingFalseTerm = -1
    pendingIfFalseBodyEnd = -1
    pendingCompoundFalseTerms = []
    pendingLoopBreakTerms = []
    pendingLoopContinueTerms = []
    controlBreakTermIndexes = []
    controlContinueTermIndexes = []
    controlLoopBackTermIndexes = []
    controlCurrentScopeId = 0
    controlDeferOwnerStatementOrdinal = -1
    controlDeferSuiteScopeId = -1
    controlDeferSkipTermIndex = -1
    controlDeferSavedPendingFalseTerm = -1
    controlDeferSavedPendingIfFalseBodyEnd = -1
    skipStatementUntilIndex = -1
    completedReturnLineNumber = -1
    pendingWhileHeaderBlock = -1
    pendingWhileCbrTerm = -1
    pendingWhileFalseTerms = []
    initializedLocalDeclLines = []
    initializedLocalDeclNames = []
    if traceEnabled:
        PrimaryObjectPlanTrace("primary_body_ir_from_typed_before_seed_params")
    PrimaryBodyIrSeedParamSlots(
        bodyIR,
        localBindingProjection,
        slotNames,
        lowering.typedIr,
        typedFn,
        irFunction)
    if traceEnabled:
        PrimaryObjectPlanTrace("primary_body_ir_from_typed_after_seed_params")
    let varI32ParamNames = PrimaryBodyIrCollectVarI32ParamNamesFromIrFunction(irFunction)
    if traceEnabled:
        PrimaryObjectPlanTrace(Fmt"primary_body_ir_from_typed_after_var_i32 count={varI32ParamNames.len}")
    var callFeederEmittedIndexes: int32[]
    var sameLineOrder: int32[]
    var sameLineLo: int32[]
    var sameLineHi: int32[]
    PrimaryBodyIrBuildSameLineIndex(irFunction.statements, sameLineOrder, sameLineLo, sameLineHi)
    for stmtIndex in 0..<stmtEnd:
        # [bodyir-ownership-wall] 语句级行程探针（只读，回退读数）：循环**顶部**每轮必执行
        # （不受 continue 影响）⇒ 首个命中 stage=stmt_begin_k 表示清零发生在处理语句 k−1 期间。
        primarySlotIdentityTripwire(bodyIR, Fmt"stmt_begin_{stmtIndex}")
        if bodyIR.debugProvenanceRequired:
            let _ = coreir.BodyIRDebugProvenanceSetSynthetic(
                bodyIR, coreir.BodyDebugSyntheticControlFlow)
        if traceEnabled:
            PrimaryObjectPlanTrace(Fmt"primary_body_ir_stmt_index={stmtIndex} stmt_end={stmtEnd}")
        lower.LoweringBodyIrControlBindNewBlocks(
            bodyIR, controlCurrentScopeId)
        let nextDeferOwnerStatementOrdinal =
            irFunction.statements[stmtIndex].deferOwnerStatementOrdinal
        var controlDeferEnding =
            controlDeferActive &&
            nextDeferOwnerStatementOrdinal !=
                controlDeferOwnerStatementOrdinal
        while true:
            var loopDue = false
            if controlDeferEnding:
                loopDue =
                    loopKindStk.len > controlDeferLoopDepth
            elif loopKindStk.len > 0 &&
                 stmtIndex >= loopEndStk[loopKindStk.len - 1]:
                loopDue = true
            var ifDue = false
            if controlDeferEnding:
                ifDue = ifEndStk.len > controlDeferIfDepth
            elif ifEndStk.len > 0 &&
                 stmtIndex >= ifEndStk[ifEndStk.len - 1]:
                ifDue = true
                let dueKind = irFunction.statements[stmtIndex].kind
                if (dueKind == texpr.TypedExprIrStmtElif || dueKind == texpr.TypedExprIrStmtElse) &&
                   irFunction.statements[stmtIndex].lineIndent == ifIndentStk[ifEndStk.len - 1]:
                    ifDue = false
            if !loopDue && !ifDue:
                if controlDeferEnding:
                    PrimaryBodyIrControlFinishDeferAction(
                        bodyIR,
                        controlDeferSuiteScopeId,
                        controlDeferSkipTermIndex,
                        currentBlockStart)
                    pendingFalseTerm =
                        controlDeferSavedPendingFalseTerm
                    pendingIfFalseBodyEnd =
                        controlDeferSavedPendingIfFalseBodyEnd
                    pendingCompoundFalseTerms = []
                    for savedFalseTerm in
                            controlDeferSavedPendingCompoundFalseTerms:
                        add(pendingCompoundFalseTerms, savedFalseTerm)
                    controlDeferSavedPendingCompoundFalseTerms = []
                    controlCurrentScopeId =
                        controlDeferSavedScopeId
                    controlDeferActive = false
                    controlDeferOwnerStatementOrdinal = -1
                    controlDeferSuiteScopeId = -1
                    controlDeferSkipTermIndex = -1
                    controlDeferEnding = false
                    continue
                break
            var closeIfTop = ifDue
            if loopDue && ifDue && loopSeqStk[loopKindStk.len - 1] > ifSeqStk[ifEndStk.len - 1]:
                closeIfTop = false
            if closeIfTop:
                PrimaryBodyIrCloseIfTop(bodyIR,
                                        currentBlockStart,
                                        ifEndStk,
                                        ifSeqStk,
                                        ifIndentStk,
                                        ifFalseStartStk,
                                        ifFalsePool,
                                        ifJoinStartStk,
                                        ifJoinBrPool)
                # CloseIfTop has bound the just-closed if's false edge(s) to its
                # join block. The if-without-else continuation patch below
                # (pendingFalseTerm / line ~25746) must NOT re-target an
                # already-bound false edge — doing so re-points an if-with-break
                # body's false edge from the loop latch to the loop EXIT, losing
                # an iteration. Clear the now-stale pending-if state once the
                # term it tracks has been bound, mirroring the for-loop reset.
                if pendingFalseTerm >= 0 &&
                   pendingFalseTerm < bodyIR.terms.len &&
                   bodyIR.terms[pendingFalseTerm].falseBlock >= 0:
                    pendingFalseTerm = -1
                    pendingCompoundFalseTerms = []
                    pendingIfFalseBodyEnd = -1
            else:
                let closedLoopKind = PrimaryBodyIrCloseLoopTop(bodyIR,
                                                           slotNames,
                                                           nextOpIndex,
                                                           currentBlockStart,
                                                           loopKindStk,
                                                           loopEndStk,
                                                           loopAStk,
                                                           loopBStk,
                                                           loopCStk,
                                                           loopSeqStk,
                                                           loopFalseStartStk,
                                                           loopFalsePool,
                                                           loopBreakStartStk,
                                                           pendingLoopBreakTerms,
                                                           loopContinueStartStk,
                                                           pendingLoopContinueTerms,
                                                           controlLoopBackTermIndexes)
                if closedLoopKind == 1:
                    pendingFalseTerm = -1
                    pendingCompoundFalseTerms = []
        lower.LoweringBodyIrControlBindNewBlocks(
            bodyIR, controlCurrentScopeId)
        if stmtIndex <= skipStatementUntilIndex:
            continue
        let stmt = irFunction.statements[stmtIndex]
        let exactStatementScopeId =
            lower.LoweringBodyIrControlStatementScope(
                irFunction.deferScopeTransport,
                stmt.statementIndex)
        if exactStatementScopeId != stmt.lexicalScopeId:
            panic("primary body ir control: statement scope identity drift")
        if controlDeferActive:
            PrimaryBodyIrControlValidateDeferActionStatement(
                irFunction.deferScopeTransport,
                stmt,
                controlDeferOwnerStatementOrdinal,
                controlDeferSuiteScopeId)
        elif stmt.deferOwnerStatementOrdinal >= 0:
            panic("primary body ir control: orphan defer action statement")
        if exactStatementScopeId != controlCurrentScopeId &&
           bodyIR.ops.len > currentBlockStart:
            var scopeTransitionTerm: coreir.BodyTerm
            scopeTransitionTerm.kind = coreir.BodyTermBrTag
            scopeTransitionTerm.trueBlock = bodyIR.blocks.len + 1
            scopeTransitionTerm.falseBlock = -1
            scopeTransitionTerm.conditionKind =
                coreir.BodyCondInvalidTag
            scopeTransitionTerm.lhsSlot = -1
            scopeTransitionTerm.rhsSlot = -1
            scopeTransitionTerm.resultSlot = -1
            let scopeTransitionTermIndex =
                coreir.BodyIRAppendTerm(bodyIR, scopeTransitionTerm)
            let _ = coreir.BodyIRAppendBlock(
                bodyIR,
                currentBlockStart,
                bodyIR.ops.len - currentBlockStart,
                scopeTransitionTermIndex)
            currentBlockStart = bodyIR.ops.len
            lower.LoweringBodyIrControlBindNewBlocks(
                bodyIR, controlCurrentScopeId)
        controlCurrentScopeId = exactStatementScopeId
        PrimaryBodyIrBindPublishedStatementDebugProvenance(
            bodyIR, lowering, stmt)
        if PrimaryBodyIrNodeEvalOnlyActive():
            PrimaryBodyIrNodeEvalOnlyFlush(bodyIR)
            PrimaryBodyIrNodeEvalOnlyBegin(typedFn.functionName, stmt)
        if os.GetEnv("CHENG_X64_DBG2") != "":
            os.WriteLine(os.GetStderr(), Fmt"x64dbg2 fn={typedFn.functionName} idx={stmtIndex} kind={int32(stmt.kind)} indent={stmt.lineIndent} line={stmt.lineNumber} binding={stmt.bindingName} target={stmt.callTarget} surface={stmt.surfaceText}")
        if traceEnabled:
            PrimaryObjectPlanTrace(Fmt"primary_body_ir_stmt_loaded index={stmtIndex} line={stmt.lineNumber} kind={int32(stmt.kind)}")
        # if-without-else: the first statement past the then-body starts the
        # continuation block. Patch the pending CBR false edge(s) to it here;
        # elif/else statements keep their dedicated handlers below. Without
        # this, the false edge stayed -1 and the late term-index fallback
        # collapsed it into the then-block (if-with-return always took then).
        if pendingFalseTerm >= 0 && pendingIfFalseBodyEnd >= 0 &&
           stmtIndex >= pendingIfFalseBodyEnd &&
           stmt.kind != texpr.TypedExprIrStmtIfCall &&
           stmt.kind != texpr.TypedExprIrStmtElif &&
           stmt.kind != texpr.TypedExprIrStmtElse:
            if bodyIR.ops.len > currentBlockStart:
                # then-body left its block open: terminate it with a branch
                # to the continuation so the false edge can skip the then ops.
                var ifJoinBr: coreir.BodyTerm
                ifJoinBr.kind = coreir.BodyTermBrTag
                ifJoinBr.trueBlock = bodyIR.blocks.len + 1
                ifJoinBr.falseBlock = -1
                ifJoinBr.conditionKind = coreir.BodyCondInvalidTag
                ifJoinBr.lhsSlot = -1
                ifJoinBr.rhsSlot = -1
                ifJoinBr.resultSlot = -1
                let ifJoinBrIdx = coreir.BodyIRAppendTerm(bodyIR, ifJoinBr)
                let ifJoinOpCount = bodyIR.ops.len - currentBlockStart
                let _ = coreir.BodyIRAppendBlock(bodyIR, currentBlockStart, ifJoinOpCount, ifJoinBrIdx)
                currentBlockStart = bodyIR.ops.len
            PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, pendingFalseTerm)
            bodyIR.terms[pendingFalseTerm].falseBlock = bodyIR.blocks.len
            for pcti in 0..<pendingCompoundFalseTerms.len:
                if pendingCompoundFalseTerms[pcti] >= 0 &&
                   pendingCompoundFalseTerms[pcti] < bodyIR.terms.len:
                    PrimaryBodyIrNodeBoolChainJournalTermBeforeWrite(bodyIR, pendingCompoundFalseTerms[pcti])
                    bodyIR.terms[pendingCompoundFalseTerms[pcti]].falseBlock = bodyIR.blocks.len
            pendingCompoundFalseTerms = []
            pendingFalseTerm = -1
            pendingIfFalseBodyEnd = -1
        if PrimaryObjectPlanTraceActive() || PrimaryObjectPlanProgressEnabled() || traceEnabled:
            if PrimaryObjectPlanTraceActive():
                PrimaryObjectPlanTrace(Fmt"phase=statement function={typedFn.functionName} stmt_index={stmtIndex} line={stmt.lineNumber} kind={PrimaryObjectStatementKindCodeText(int32(stmt.kind))} binding={stmt.bindingName} surface={stmt.surfaceText}")
            PrimaryObjectPlanGuardTick()
            if PrimaryObjectPlanProgressEnabled():
                PrimaryObjectPlanProgress(Fmt"statement_begin function={typedFn.functionName} stmt_index={stmtIndex} line={stmt.lineNumber} kind={PrimaryObjectStatementKindCodeText(int32(stmt.kind))} surface={stmt.surfaceText}")
        if stmt.kind == texpr.TypedExprIrStmtDefer:
            if controlDeferActive:
                panic("primary body ir control: nested defer action")
            controlDeferLoopDepth = loopKindStk.len
            controlDeferIfDepth = ifEndStk.len
            controlDeferSavedScopeId = controlCurrentScopeId
            controlDeferSavedPendingFalseTerm = pendingFalseTerm
            controlDeferSavedPendingIfFalseBodyEnd =
                pendingIfFalseBodyEnd
            controlDeferSavedPendingCompoundFalseTerms = []
            for savedPendingFalseTerm in pendingCompoundFalseTerms:
                add(controlDeferSavedPendingCompoundFalseTerms,
                    savedPendingFalseTerm)
            pendingFalseTerm = -1
            pendingIfFalseBodyEnd = -1
            pendingCompoundFalseTerms = []
            PrimaryBodyIrControlBeginDeferAction(
                bodyIR,
                irFunction.deferScopeTransport,
                stmt,
                currentBlockStart,
                controlDeferSkipTermIndex)
            controlDeferActive = true
            controlDeferOwnerStatementOrdinal =
                stmt.statementOrdinal
            controlDeferSuiteScopeId = stmt.suiteScopeId
            PrimaryBodyIrNodeEvalOnlyOwn()
        elif stmt.kind == texpr.TypedExprIrStmtBreak ||
             stmt.kind == texpr.TypedExprIrStmtContinue:
            if loopKindStk.len <= 0:
                panic("primary body ir control: loop exit outside loop")
            var loopExitTerm: coreir.BodyTerm
            loopExitTerm.kind = coreir.BodyTermBrTag
            loopExitTerm.trueBlock = -1
            loopExitTerm.falseBlock = -1
            loopExitTerm.conditionKind = coreir.BodyCondInvalidTag
            loopExitTerm.lhsSlot = -1
            loopExitTerm.rhsSlot = -1
            loopExitTerm.resultSlot = -1
            let loopExitTermIndex =
                coreir.BodyIRAppendTerm(bodyIR, loopExitTerm)
            let _ = coreir.BodyIRAppendBlock(
                bodyIR,
                currentBlockStart,
                bodyIR.ops.len - currentBlockStart,
                loopExitTermIndex)
            currentBlockStart = bodyIR.ops.len
            if stmt.kind == texpr.TypedExprIrStmtBreak:
                add(pendingLoopBreakTerms, loopExitTermIndex)
                add(controlBreakTermIndexes, loopExitTermIndex)
            else:
                add(pendingLoopContinueTerms, loopExitTermIndex)
                add(controlContinueTermIndexes, loopExitTermIndex)
            PrimaryBodyIrNodeEvalOnlyOwn()
        elif stmt.kind == texpr.TypedExprIrStmtUnsupported:
            # Comment-only lines (`// ...`) reach body-IR as Unsupported statements
            # that emit no IR; skip them as no-ops (mirrors break/continue skip).
            let commentTrimmed = strutil.Strip(stmt.surfaceText)
            if len(commentTrimmed) >= 2 &&
               commentTrimmed[0] == '/' &&
               commentTrimmed[1] == '/':
                PrimaryBodyIrNodeEvalOnlyOwn()
                continue
            # `block <label>:` is a pure label declaration: the marker line
            # emits no IR itself (its only IR effect lives in `break <label>`
            # statements, lowered via the loop-body break path). Treat the
            # marker as a no-op scope boundary so the wrapped body lowers.
            if len(commentTrimmed) > 7 &&
               commentTrimmed[0] == 'b' &&
               commentTrimmed[1] == 'l' &&
               commentTrimmed[2] == 'o' &&
               commentTrimmed[3] == 'c' &&
               commentTrimmed[4] == 'k' &&
               commentTrimmed[5] == ' ' &&
               commentTrimmed[len(commentTrimmed) - 1] == ':':
                PrimaryBodyIrNodeEvalOnlyOwn()
                continue
            if traceEnabled:
                PrimaryObjectPlanTrace(Fmt"primary_body_ir_unsupported_enter stmt_index={stmtIndex} surface_len={stmt.surfaceText.len}")
            if stmt.surfaceText == "cmdline.CaptureCmdLine(argc, argv)":
                # The runtime entry bridge already captures argc/argv before invoking main.
                PrimaryBodyIrNodeEvalOnlyOwn()
                continue
            else:
                if traceEnabled:
                    PrimaryObjectPlanTrace("primary_body_ir_unsupported_general")
                let unsupportedConsumedByAssignTarget = PrimaryBodyIrHasSameLineAssignForCallTarget(irFunction.statements,
                                                                                                     stmt.lineNumber,
                                                                                                     stmt.callTarget,
                                                                                                     stmt.callArgsText)
                let unsupportedConsumedByAssignExpr = PrimaryBodyIrHasSameLineAssignForCallExpr(irFunction.statements,
                                                                                                 stmt.lineNumber,
                                                                                                 stmt.surfaceText)
                if unsupportedConsumedByAssignTarget:
                    continue
                if unsupportedConsumedByAssignExpr:
                    continue
                let unsupportedWholeCallAppended = PrimaryBodyIrAppendWholeCallStatement(bodyIR,
                                                                                        slotNames,
                                                                                        lowering,

                                                                                        typedFn,
                                                                                        irFunction,
                                                                                        varI32ParamNames,
                                                                                        stmt.surfaceText,
                                                                                        stmt.lineNumber,
                                                                                        callOrdinal)
                if unsupportedWholeCallAppended:
                    nextOpIndex = nextOpIndex + 1
                    continue
                if PrimaryBodyIrAppendUnsupportedEchoFmtCall(bodyIR,
                                                             slotNames,
                                                             stmt.surfaceText,
                                                             stmt.lineNumber,
                                                             callOrdinal):
                    nextOpIndex = nextOpIndex + 1
                    continue
                var unsupportedWholeCallProbeCode: int32
                let unsupportedSurfaceHasCall = PrimaryBodyIrTextHasCallSurface(stmt.surfaceText)
                if unsupportedSurfaceHasCall:
                    unsupportedWholeCallProbeCode = PrimaryBodyIrWholeCallStatementProbeCode(lowering,

                                                                                            typedFn,
                                                                                            irFunction,
                                                                                            stmt.surfaceText)
                let unsupportedEqPos = texpr.TypedExprFindTopLevelTextToken(stmt.surfaceText, "=")
                if traceEnabled:
                    PrimaryObjectPlanTrace(Fmt"primary_body_ir_unsupported_after_eq_pos pos={unsupportedEqPos}")
                if unsupportedEqPos > 0:
                    let unsupportedLhsRaw = strutil.Strip(strings.SliceBytes(stmt.surfaceText,
                                                                             0,
                                                                             unsupportedEqPos))
                    let unsupportedLhs = PrimaryBodyIrCanonicalAssignLhsName(unsupportedLhsRaw)
                    let unsupportedRhs = strutil.Strip(strings.SliceBytes(stmt.surfaceText,
                                                                          unsupportedEqPos + 1,
                                                                          len(stmt.surfaceText) - unsupportedEqPos - 1))
                    if traceEnabled:
                        PrimaryObjectPlanTrace(Fmt"primary_body_ir_unsupported_assign lhs={unsupportedLhs} rhs_len={unsupportedRhs.len}")
                    if PrimaryBodyIrUInt64PtrDerefPointerText(unsupportedLhs) != "":
                        if PrimaryBodyIrAppendUInt64PtrDerefStore(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering.typedIr,
                                                                  stmt.sourcePath,
                                                                  unsupportedLhs,
                                                                  unsupportedRhs,
                                                                  callOrdinal):
                            nextOpIndex = nextOpIndex + 1
                            continue
                    if len(unsupportedLhs) > 1 && unsupportedLhs[0] == '*':
                        var unsupportedDerefInner = strutil.Strip(strings.SliceBytes(unsupportedLhs, 1, len(unsupportedLhs) - 1))
                        unsupportedDerefInner = PrimaryBodyIrStripOuterParens(unsupportedDerefInner)
                        let unsupportedDerefPtrSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                                                     slotNames,
                                                                                     varI32ParamNames,
                                                                                     lowering.typedIr,
                                                                                     stmt.sourcePath,
                                                                                     unsupportedDerefInner,
                                                                                     callOrdinal)
                        if unsupportedDerefPtrSlot >= 0:
                            var unsupportedDerefValueSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, unsupportedRhs)
                            if unsupportedDerefValueSlot < 0:
                                unsupportedDerefValueSlot = PrimaryBodyIrU64ValueSlotForText(bodyIR,
                                                                                             slotNames,
                                                                                             varI32ParamNames,
                                                                                             lowering.typedIr,
                                                                                             stmt.sourcePath,
                                                                                             unsupportedRhs,
                                                                                             callOrdinal)
                            if unsupportedDerefValueSlot >= 0 &&
                               PrimaryBodyIrSlotType(bodyIR, unsupportedDerefValueSlot) != coreir.LocalI32Tag:
                                var unsupportedDerefStoreOp: coreir.BodyOp
                                unsupportedDerefStoreOp.kind = coreir.BodyOpIndexedStoreTag
                                unsupportedDerefStoreOp.target = unsupportedDerefPtrSlot
                                add(unsupportedDerefStoreOp.operands, unsupportedDerefPtrSlot)
                                add(unsupportedDerefStoreOp.operands, unsupportedDerefValueSlot)
                                let _ = coreir.BodyIRAppendOp(bodyIR, unsupportedDerefStoreOp)
                                nextOpIndex = nextOpIndex + 1
                                continue
                    var unsupportedLhsType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                            typedFn,
                                                                            irFunction,
                                                                            stmt.lineNumber,
                                                                            unsupportedLhs)
                    if traceEnabled:
                        PrimaryObjectPlanTrace(Fmt"primary_body_ir_unsupported_after_lhs_type len={unsupportedLhsType.len}")
                    var unsupportedRhsIsStringValue: bool
                    if PrimaryBodyIrTextIsStringLiteral(unsupportedRhs):
                        unsupportedRhsIsStringValue = true
                    elif PrimaryBodyIrFmtLiteralPayload(unsupportedRhs) != "":
                        unsupportedRhsIsStringValue = true
                    if unsupportedLhsType == "" &&
                       unsupportedRhsIsStringValue:
                        unsupportedLhsType = "str"
                    var unsupportedSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                            slotNames,
                                                                            lowering.typedIr,
                                                                            stmt.sourcePath,
                                                                            unsupportedLhs,
                                                                            unsupportedLhsType)
                    var unsupportedFieldAssigned = false
                    if texpr.TypedExprTextIsSimpleFieldPath(unsupportedRhs):
                        var unsupportedFieldFailure0: int32
                        var unsupportedFieldFailure1: int32
                        let unsupportedFieldSlot = PrimaryBodyIrMaterializeFieldArgSlot(bodyIR,
                                                                                       slotNames,
                                                                                       lowering.typedIr,
                                                                                       typedFn,
                                                                                       irFunction,
                                                                                       stmt.sourcePath,
                                                                                       stmt.lineNumber,
                                                                                       unsupportedRhs,
                                                                                       unsupportedFieldFailure0,
                                                                                       unsupportedFieldFailure1)
                        if unsupportedFieldSlot >= 0 &&
                           unsupportedFieldSlot < bodyIR.localSlots.len:
                            let unsupportedFieldTypeKind = PrimaryBodyIrSlotType(bodyIR, unsupportedFieldSlot)
                            let unsupportedFieldSize = PrimaryLocalSlotSizeOf(bodyIR.localSlots[unsupportedFieldSlot])
                            let unsupportedFieldAlign = bodyIR.localSlots[unsupportedFieldSlot].alignBytes
                            if unsupportedSlot < 0 ||
                               unsupportedSlot >= bodyIR.localSlots.len ||
                               PrimaryBodyIrSlotType(bodyIR, unsupportedSlot) != unsupportedFieldTypeKind ||
                               PrimaryLocalSlotSizeOf(bodyIR.localSlots[unsupportedSlot]) < unsupportedFieldSize:
                                unsupportedSlot = PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                                                    slotNames,
                                                                                    unsupportedLhs,
                                                                                    unsupportedFieldTypeKind,
                                                                                    unsupportedFieldSize,
                                                                                    unsupportedFieldAlign)
                            if unsupportedSlot >= 0 &&
                               unsupportedSlot < bodyIR.localSlots.len &&
                               PrimaryBodyIrSlotType(bodyIR, unsupportedSlot) == unsupportedFieldTypeKind &&
                               PrimaryLocalSlotSizeOf(bodyIR.localSlots[unsupportedSlot]) >= unsupportedFieldSize:
                                if unsupportedSlot != unsupportedFieldSlot:
                                    var unsupportedFieldCopyOp: coreir.BodyOp
                                    unsupportedFieldCopyOp.kind = coreir.BodyOpCopyLocalTag
                                    unsupportedFieldCopyOp.target = unsupportedSlot
                                    add(unsupportedFieldCopyOp.operands, unsupportedFieldSlot)
                                    let _ = coreir.BodyIRAppendOp(bodyIR, unsupportedFieldCopyOp)
                                unsupportedFieldAssigned = true
                    if unsupportedFieldAssigned:
                        nextOpIndex = nextOpIndex + 1
                        continue
                    var unsupportedStringAssigned = false
                    if unsupportedSlot >= 0 &&
                       PrimaryBodyIrSlotType(bodyIR, unsupportedSlot) == coreir.LocalStrTag:
                        if PrimaryBodyIrTextIsStringLiteral(unsupportedRhs):
                            unsupportedStringAssigned = PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                                                              slotNames,
                                                                                              unsupportedRhs,
                                                                                              unsupportedSlot,
                                                                                              callOrdinal)
                    if unsupportedStringAssigned:
                        nextOpIndex = nextOpIndex + 1
                        continue
                    if unsupportedSlot >= 0 &&
                       unsupportedSlot < bodyIR.localSlots.len &&
                       PrimaryBodyIrSlotType(bodyIR, unsupportedSlot) == coreir.LocalF64Tag &&
                       texpr.TypedExprFindTopLevelTextToken(unsupportedRhs, "?") > 0:
                        var unsupportedF64TernBlockStart = currentBlockStart
                        if PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      lowering,

                                                                      typedFn,
                                                                      irFunction,
                                                                      stmt.sourcePath,
                                                                      stmt.lineNumber,
                                                                      stmt.rhsNodeIndex,
                                                                      unsupportedRhs,
                                                                      unsupportedSlot,
                                                                      coreir.LocalF64Tag,
                                                                      callOrdinal,
                                                                      unsupportedF64TernBlockStart):
                            currentBlockStart = unsupportedF64TernBlockStart
                            nextOpIndex = nextOpIndex + 1
                            continue
                let unsupportedBareIdent = strutil.Strip(stmt.surfaceText)
                let unsupportedBareIsIdent = unsupportedBareIdent != "" &&
                                             parser.ParserIdentPrefix(unsupportedBareIdent) == unsupportedBareIdent
                let unsupportedBareIsFieldPath = texpr.TypedExprTextIsSimpleFieldPath(unsupportedBareIdent)
                if !unsupportedSurfaceHasCall &&
                   unsupportedEqPos <= 0 &&
                   (unsupportedBareIsIdent || unsupportedBareIsFieldPath):
                    # Bare identifier / simple member-path expression statement
                    # (parameter/local discard, "touch unused" idiom) evaluates a
                    # known binding with no effect: own the node-eval gap and skip.
                    let unsupportedBareRoot = parser.ParserIdentPrefix(unsupportedBareIdent)
                    if PrimaryBodyIrFindArgSlot(bodyIR, slotNames, unsupportedBareRoot) >= 0 ||
                       PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       stmt.lineNumber,
                                                       unsupportedBareRoot) != "":
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        continue
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             64,
                                             unsupportedWholeCallProbeCode)
                nextOpIndex = nextOpIndex + 1
        elif stmt.kind == texpr.TypedExprIrStmtLocalDecl:
            var localDeclType = stmt.resultType
            let localDeclRhs = strutil.Strip(stmt.surfaceText)
            let localDeclOpenPos = texpr.TypedExprFindWholeCallOpenParen(localDeclRhs)
            if localDeclOpenPos > 0:
                let localDeclClosePos = texpr.TypedExprFindMatchingParen(localDeclRhs,
                                                                         localDeclOpenPos)
                if localDeclClosePos > localDeclOpenPos &&
                   localDeclClosePos + 1 == len(localDeclRhs):
                    let localDeclCallHead = strutil.Strip(strings.SliceBytes(localDeclRhs,
                                                                             0,
                                                                             localDeclOpenPos))
                    let localDeclCallArgsText = strutil.Strip(strings.SliceBytes(localDeclRhs,
                                                                                localDeclOpenPos + 1,
                                                                                localDeclClosePos - localDeclOpenPos - 1))
                    let localDeclCallArgCount = PrimaryBodyIrCallArgNames(localDeclCallArgsText).len
                    var localDeclCallType = ""
                    let _localDeclCallOrdinal = PrimaryBodyIrResolvedOrRegisteredWholeCallOrdinal(irFunction,
                                                                                                  lowering.typedIr,
                                                                                                  stmt.sourcePath,
                                                                                                  localDeclCallHead,
                                                                                                  localDeclCallArgCount,
                                                                                                  localDeclCallType)
                    var shouldResolveQualifiedLocalDeclCall: bool
                    if texpr.TypedExprQualifiedTypeDot(localDeclCallHead) > 0:
                        if localDeclCallType == "":
                            shouldResolveQualifiedLocalDeclCall = true
                        elif localDeclCallType == "unknown":
                            shouldResolveQualifiedLocalDeclCall = true
                        elif localDeclCallType == "void":
                            shouldResolveQualifiedLocalDeclCall = true
                    if shouldResolveQualifiedLocalDeclCall:
                        let localDeclDotPos = texpr.TypedExprQualifiedTypeDot(localDeclCallHead)
                        let localDeclQualifier = strutil.Strip(strings.SliceBytes(localDeclCallHead,
                                                                                 0,
                                                                                 localDeclDotPos))
                        let localDeclLeaf = strutil.Strip(strings.SliceBytes(localDeclCallHead,
                                                                             localDeclDotPos + 1,
                                                                             len(localDeclCallHead) - localDeclDotPos - 1))
                        let localDeclImportedSource = PrimaryBodyIrCanonicalImportTargetSourcePath(lowering.typedIr,
                                                                                                   stmt.sourcePath,
                                                                                                   localDeclQualifier)
                        if localDeclImportedSource != "" && localDeclLeaf != "":
                            let localDeclImportedIndex = PrimaryBodyIrTargetFunctionIndex(lowering.typedIr,
                                                                                          localDeclImportedSource,
                                                                                          localDeclLeaf)
                            if localDeclImportedIndex >= 0 &&
                               localDeclImportedIndex < lowering.typedIr.functions2_functionNameIds.len:
                                let ldRetRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.functions2_returnTypeIds[localDeclImportedIndex])
                                if IsOk(ldRetRes):
                                    localDeclCallType = Value(ldRetRes)
                    # 裸泛型类型参数（单大写字母，如 `Value[T](r): T` 的 T）不是
                    # 具体类型：用它覆盖已解析具体标量 localDeclType（int32）会把槽
                    # 误建成 ptr（首字母大写→PtrTag），与标量投影宽度不符而 miscompile。
                    var localDeclCallTypeIsBareGeneric: bool
                    if len(localDeclCallType) == 1 &&
                       localDeclCallType[0] >= 'A' &&
                       localDeclCallType[0] <= 'Z':
                        localDeclCallTypeIsBareGeneric = true
                    if localDeclCallType != "" &&
                       localDeclCallType != "unknown" &&
                       localDeclCallType != "void" &&
                       !localDeclCallTypeIsBareGeneric &&
                       PrimaryObjectMetadataTextStable(localDeclCallType):
                        localDeclType = localDeclCallType
            var shouldInferLocalDeclCallType: bool
            if PrimaryBodyIrTextHasCallSurface(localDeclRhs):
                if localDeclType == "":
                    shouldInferLocalDeclCallType = true
                elif localDeclType == "unknown":
                    shouldInferLocalDeclCallType = true
            if shouldInferLocalDeclCallType:
                var localDeclBinPos: int32 = -1
                var localDeclBinOpLen: int32
                localDeclBinOpLen = 1
                let localDeclAddPos = texpr.TypedExprFindTopLevelTextToken(localDeclRhs, "+")
                let localDeclSubPos = texpr.TypedExprFindTopLevelTextToken(localDeclRhs, "-")
                let localDeclMulPos = texpr.TypedExprFindTopLevelTextToken(localDeclRhs, "*")
                let localDeclDivPos = texpr.TypedExprFindTopLevelTextToken(localDeclRhs, "/")
                let localDeclShrPos = texpr.TypedExprFindTopLevelTextToken(localDeclRhs, ">>")
                if localDeclAddPos > 0:
                    localDeclBinPos = localDeclAddPos
                elif localDeclSubPos > 0:
                    localDeclBinPos = localDeclSubPos
                elif localDeclMulPos > 0:
                    localDeclBinPos = localDeclMulPos
                elif localDeclDivPos > 0:
                    localDeclBinPos = localDeclDivPos
                elif localDeclShrPos > 0:
                    localDeclBinPos = localDeclShrPos
                    localDeclBinOpLen = 2
                if localDeclBinPos > 0 && localDeclBinPos + localDeclBinOpLen < len(localDeclRhs):
                    let localDeclLhsText = strutil.Strip(strings.SliceBytes(localDeclRhs,
                                                                            0,
                                                                            localDeclBinPos))
                    let localDeclRhsText = strutil.Strip(strings.SliceBytes(localDeclRhs,
                                                                            localDeclBinPos + localDeclBinOpLen,
                                                                            len(localDeclRhs) - localDeclBinPos - localDeclBinOpLen))
                    var localDeclCallOperandType = ""
                    if PrimaryBodyIrTextHasCallSurface(localDeclLhsText):
                        let localDeclLhsOpen = texpr.TypedExprFindWholeCallOpenParen(localDeclLhsText)
                        let localDeclLhsClose = texpr.TypedExprFindMatchingParen(localDeclLhsText,
                                                                                 localDeclLhsOpen)
                        var localDeclLhsHead = strings.CloneStr(localDeclLhsText)
                        var localDeclLhsArgs = ""
                        if localDeclLhsOpen > 0 && localDeclLhsClose > localDeclLhsOpen:
                            localDeclLhsHead = strutil.Strip(strings.SliceBytes(localDeclLhsText,
                                                                                 0,
                                                                                 localDeclLhsOpen))
                            localDeclLhsArgs = strutil.Strip(strings.SliceBytes(localDeclLhsText,
                                                                                 localDeclLhsOpen + 1,
                                                                                 localDeclLhsClose - localDeclLhsOpen - 1))
                        let _localDeclLhsCallOrdinal = PrimaryBodyIrResolvedOrRegisteredWholeCallOrdinal(irFunction,
                                                                                                        lowering.typedIr,
                                                                                                        stmt.sourcePath,
                                                                                                        localDeclLhsHead,
                                                                                                        PrimaryBodyIrCallArgNames(localDeclLhsArgs).len,
                                                                                                        localDeclCallOperandType)
                    elif PrimaryBodyIrTextHasCallSurface(localDeclRhsText):
                        let localDeclRhsOpen = texpr.TypedExprFindWholeCallOpenParen(localDeclRhsText)
                        let localDeclRhsClose = texpr.TypedExprFindMatchingParen(localDeclRhsText,
                                                                                 localDeclRhsOpen)
                        var localDeclRhsHead = strings.CloneStr(localDeclRhsText)
                        var localDeclRhsArgs = ""
                        if localDeclRhsOpen > 0 && localDeclRhsClose > localDeclRhsOpen:
                            localDeclRhsHead = strutil.Strip(strings.SliceBytes(localDeclRhsText,
                                                                                 0,
                                                                                 localDeclRhsOpen))
                            localDeclRhsArgs = strutil.Strip(strings.SliceBytes(localDeclRhsText,
                                                                                 localDeclRhsOpen + 1,
                                                                                 localDeclRhsClose - localDeclRhsOpen - 1))
                        let _localDeclRhsCallOrdinal = PrimaryBodyIrResolvedOrRegisteredWholeCallOrdinal(irFunction,
                                                                                                        lowering.typedIr,
                                                                                                        stmt.sourcePath,
                                                                                                        localDeclRhsHead,
                                                                                                        PrimaryBodyIrCallArgNames(localDeclRhsArgs).len,
                                                                                                        localDeclCallOperandType)
                    if localDeclCallOperandType == "int32" ||
                       localDeclCallOperandType == "uint32" ||
                       localDeclCallOperandType == "bool":
                        localDeclType = "int32"
                    elif localDeclCallOperandType == "int64" ||
                         localDeclCallOperandType == "uint64":
                        localDeclType = "int64"
            # Deref let twin (let x = [int32(]*(UInt8Ptr(call(...)))[)]) must type
            # the binding slot by its scalar declared type, never by the
            # pointer-producing call.
            var localDeclDerefExpr = share(localDeclRhs)
            var localDeclDerefCastInner = PrimaryBodyIrTypeCastInnerForTarget(localDeclDerefExpr, "int32")
            if localDeclDerefCastInner == "":
                localDeclDerefCastInner = PrimaryBodyIrTypeCastInnerForTarget(localDeclDerefExpr, "uint8")
            if localDeclDerefCastInner != "":
                localDeclDerefExpr = strutil.Strip(localDeclDerefCastInner)
            if PrimaryBodyIrUInt8PtrDerefPointerText(localDeclDerefExpr) != "" ||
               PrimaryBodyIrI32PtrDerefPointerText(localDeclDerefExpr) != "":
                # 裸 `*name` 宽形（无外层 int32/uint8 cast + 非 `*(` 包裹 + 声明形为
                # ptr/i64 8字节机器字）保留声明类型让 i64 槽承接 8 字节 deref；此前无
                # 条件强改 int32 → 4字节 `ldr w`，64 位指针/整数被截成 32 位（与 return
                # 位同族的隐性截断）。cast 形（`*(UInt8Ptr/Int32Ptr(...))`）与 i32-pointee
                # 裸形仍归一 int32。
                var localDeclDerefWide = false
                if localDeclDerefCastInner == "" &&
                   len(localDeclDerefExpr) > 1 &&
                   localDeclDerefExpr[1] != '(' &&
                   PrimaryBodyIrI32PtrDerefPointerText(localDeclDerefExpr) != "":
                    # ① 标注形 `let b: int64 = *slot`：声明型即宽。
                    var localDeclDerefWideKind: int32
                    var localDeclDerefWideSize: int32
                    var localDeclDerefWideAlign: int32
                    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                   stmt.sourcePath,
                                                   localDeclType,
                                                   localDeclDerefWideKind,
                                                   localDeclDerefWideSize,
                                                   localDeclDerefWideAlign)
                    if localDeclDerefWideKind == coreir.LocalPtrTag ||
                       localDeclDerefWideKind == coreir.LocalI64Tag:
                        localDeclDerefWide = true
                    # ② 隐式 `let b = *slot`：前端常把绑定推成 i32，声明型不可信。
                    # 权威序: 已物化指针槽 aux pointee → BindingType 文本 pointee。
                    if !localDeclDerefWide:
                        let barePtrName = PrimaryBodyIrI32PtrDerefPointerText(localDeclDerefExpr)
                        let barePtrSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, barePtrName)
                        if barePtrSlot >= 0 && barePtrSlot < bodyIR.localSlots.len:
                            let barePtrPointeeKind = PrimaryBodyIrVarParamPointeeKind(bodyIR,
                                                                                     barePtrSlot)
                            if barePtrPointeeKind == coreir.LocalI64Tag ||
                               barePtrPointeeKind == coreir.LocalPtrTag:
                                localDeclType = "int64"
                                localDeclDerefWide = true
                        if !localDeclDerefWide:
                            var barePtrType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                              typedFn,
                                                                              irFunction,
                                                                              stmt.lineNumber,
                                                                              barePtrName)
                            if barePtrType == "":
                                barePtrType = texpr.TypedExprIrLookupLocalBindingTypeAnyLine(lowering.typedIr,
                                                                                             typedFn.sourcePath,
                                                                                             typedFn.functionName,
                                                                                             barePtrName)
                            let barePointee = PrimaryBodyIrPointeeTypeTextForSource(lowering.typedIr,
                                                                                   stmt.sourcePath,
                                                                                   barePtrType)
                            if barePointee != "":
                                var barePointeeKind: int32
                                var barePointeeSize: int32
                                var barePointeeAlign: int32
                                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                               stmt.sourcePath,
                                                               barePointee,
                                                               barePointeeKind,
                                                               barePointeeSize,
                                                               barePointeeAlign)
                                if barePointeeKind == coreir.LocalPtrTag ||
                                   barePointeeKind == coreir.LocalI64Tag:
                                    localDeclType = barePointee
                                    localDeclDerefWide = true
                if !localDeclDerefWide &&
                   PrimaryBodyIrTypeKindFromText(localDeclType) != coreir.LocalI32Tag:
                    localDeclType = "int32"
            # `var x = ir.functions[i].callTargets[0]`（纯 str 字段/索引深链 RHS）：
            # 前端类型推断会在中途停在 `ir.functions[i]`，把 x 的 resultType 误推成
            # 元素结构体类型 `PrimaryObjectIrFunction`（漏掉 `.callTargets[0]` 尾段）。
            # 这是稳定但错误的类型：下面 FindOrCreateTypedSlot 据此把 x 槽建成
            # Aggregate；str 值 node-eval 存储因槽形不符 store_shape miss，槽未初始化、
            # 行落 0 字 invalid op，后续 Fmt 拼接读 x 又拿到 Aggregate 片段 →
            # fmt_piece miss，整函数 wcz（G5 受害 sequenceText 等）。
            # RHS 节点求值探针逐级走真实字段/索引链，对纯路径（无调用面）是权威
            # 定型：探针返回 str 而声明类型不成 str 形时，以探针 str 纠正槽定型，
            # 根治前端深链推断漏尾。
            if !PrimaryBodyIrTextHasCallSurface(localDeclRhs) &&
               PrimaryBodyIrTextHasFieldOrIndex(localDeclRhs) &&
               stmt.rhsNodeIndex >= 0 &&
               stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               PrimaryBodyIrTypeKindFromText(localDeclType) != coreir.LocalStrTag:
                var localDeclDeclaredKind: int32
                var localDeclDeclaredSize: int32
                var localDeclDeclaredAlign: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               stmt.sourcePath,
                                               localDeclType,
                                               localDeclDeclaredKind,
                                               localDeclDeclaredSize,
                                               localDeclDeclaredAlign)
                if localDeclDeclaredKind != coreir.LocalStrTag:
                    primaryBodyIrNodeEvalMissOp = ""
                    if PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering,

                                                  share(typedFn),
                                                  irFunction,
                                                  stmt.rhsNodeIndex) == coreir.LocalStrTag:
                        localDeclType = "str"
            # FIX 8: str-slice decl type detection. Front-end RhsIndexType types
            # any str[...] as char (single-byte index view); a range slice yields
            # str. char + slice syntax uniquely identifies a mis-typed str slice;
            # force str so the slot is sized 16B and the population block fires.
            if localDeclType == "char" &&
               PrimaryBodyIrTextIsStrSlice(localDeclRhs):
                localDeclType = "str"
            if os.GetEnv("CHENG_X64_DBG4") != "":
                os.WriteLine(os.GetStderr(), Fmt"x64dbg4 local_decl binding={stmt.bindingName} line={stmt.lineNumber} result_type=[{stmt.resultType}] decl_type=[{localDeclType}]")
            PrimaryBodyIrRetireIncompatibleAggregateRebind(bodyIR,
                                                           slotNames,
                                                           lowering.typedIr,
                                                           stmt.sourcePath,
                                                           stmt.bindingName,
                                                           localDeclType)
            let localSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                               slotNames,
                                                               lowering.typedIr,
                                                               stmt.sourcePath,
                                                               stmt.bindingName,
                                                               localDeclType)
            # 裸 `var x: T`（无初值声明）按生产契约语句 rhs 恒为 no_node 哨兵
            # -1（typed_expr TypedExprIrAddLocalDeclStatement：nil-able 家族零值
            # 定义走 w24 detached 模板行、刻意不挂 rhs；后端对应 bare-default
            # 零值发射 ptr 槽 LoadConst 0 / 聚合槽 setMem）。无生产者声明即无
            # 生产者证明可求，不进 producer proof 绑定；rhs 非 -1 时绑定与守卫
            # 原样执行（越界/证明缺失仍 panic，零弱化）。
            if stmt.rhsNodeIndex != -1:
                PrimaryBodyIrBindLocalSlotFromTypedProducerExact(
                    bodyIR,
                    localBindingProjection,
                    lowering.typedIr,
                    localSlot,
                    stmt.rhsNodeIndex)
            # defect-B R-B2(Let-it-crash 总闸): 限定具名类型(mod.Type)必指向
            # 一个具体声明类型;形状解析 size<=0 意味着解析链失败,此时
            # TypeKindFromText 大写叶启发已把槽误建 8B Ptr,裸声明零值写会随即
            # 把空指针落槽(运行期 SIGSEGV,defectB_aggr_addr 三体位实证)。
            # 诚实拒替:poison 升级编译期 bail,不产出静默错码。
            # 成功解析(聚合/别名标量/枚举/ref)恒 size>0,不受本门影响;
            # 无限定名(可能是模板形参叶)保持既有行为,不在本门范围。
            if texpr.TypedExprQualifiedTypeDot(localDeclType) > 0:
                var declGateKind: int32
                var declGateSize: int32
                var declGateAlign: int32
                PrimaryBodyIrTypedSlotShape(lowering.typedIr,
                                            stmt.sourcePath,
                                            localDeclType,
                                            declGateKind,
                                            declGateSize,
                                            declGateAlign)
                if declGateSize <= 0:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6105,
                                                 0)
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    continue
            if PrimaryBodyIrHasSameLineLetCallBinding(irFunction.statements,
                                                      stmt.lineNumber,
                                                      stmt.bindingName):
                PrimaryBodyIrNodeEvalOnlyOwn()
                continue
            if PrimaryBodyIrHasSameLineResultIntrinsicBinding(irFunction.statements,
                                                              stmt.lineNumber,
                                                              stmt.bindingName):
                PrimaryBodyIrNodeEvalOnlyOwn()
                continue
            # 批次2c：rhs 已节点化的本地声明先走节点求值器（绑定新槽），
            # 失败落回既有初始化路径（迁移窗口双轨）。
            var localInitialized = false
            let localDeclSeqElemType = PrimaryBodyIrIndexedElementTypeText(localDeclType)
            let localDeclSeqLiteralText = strutil.Strip(parser.ParserStripLineComment(localDeclRhs))
            let localDeclRequiresTypedScalarSeqLiteral =
                PrimaryBodyIrTypeTextIsDynamicSeq(localDeclType) &&
                localDeclSeqElemType != "" &&
                localDeclSeqElemType != "void" &&
                texpr.TypedExprTypeIsScalar(localDeclSeqElemType) &&
                len(localDeclSeqLiteralText) > 2 &&
                localDeclSeqLiteralText[0] == '[' &&
                texpr.TypedExprFindMatchingBracket(localDeclSeqLiteralText, 0) == len(localDeclSeqLiteralText) - 1
            # `let r = a && b` / `let r = a || b`: materializing a short-circuit
            if !localInitialized &&
               localSlot >= 0 &&
               localSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, localSlot) == coreir.LocalStrTag &&
               PrimaryBodyIrTextIsStrSlice(localDeclRhs):
                let declSliceTempSlot = PrimaryBodyIrLowerStrSliceToSlot(bodyIR, slotNames, varI32ParamNames, lowering.typedIr, typedFn, irFunction, stmt.sourcePath, stmt.lineNumber, localDeclRhs, stmt.bindingName, callOrdinal)
                if declSliceTempSlot >= 0:
                    if declSliceTempSlot != localSlot:
                        var declSliceCopyOp: coreir.BodyOp
                        declSliceCopyOp.kind = coreir.BodyOpCopyLocalTag
                        declSliceCopyOp.target = localSlot
                        add(declSliceCopyOp.operands, declSliceTempSlot)
                        let _ = coreir.BodyIRAppendOp(bodyIR, declSliceCopyOp)
                    localInitialized = true

            # boolean into a local MUST preserve short-circuit semantics (the RHS
            # of `&&` skipped when the LHS is false, and vice-versa for `||`).
            # The eager node-eval / scalar paths below evaluate BOTH operands and
            # bitwise-combine them, running a side-effecting RHS even when it
            # should be skipped (the `false && bump(true)` miscompile). Route
            # bool-slot && / || initializers through the same CBR-chain assigner
            # the plain-assign path uses (AppendI32Assign:25095) before any eager
            # path can fire.
            # Only the call-bearing short-circuit decl must take the text CBR
            # assigner: when a `&&`/`||` operand contains a CallExpr the short-
            # circuit skip is observable (the eager bitwise node path would run
            # a side-effecting RHS even when LHS is false — lessons #37 dangling
            # reloc坑). Call-free `&&`/`||` are side-effect-equivalent to bitwise
            # AND/OR, so they fall through to the node-eval LogAnd path (24003,
            # itself guarded to miss on CallExpr operands) + NodeEvalOnlyOwn.
            let declInitShortCircuitText = strutil.Strip(stmt.surfaceText)
            # T78: 门从"只探真调用"扩到 HasFaultingEagerSurface(调用或下标读)——
            # call-free 但含下标的 `&&`/`||`(如 `i < arr.len && arr[i]`)此前判定
            # "无副作用可安全 eager 位运算", 实际下标读本身可越界故障, 必须同样
            # 走这条 CBR 链真短路赋值器, 不落到下面的 eager node-eval LogAnd 臂。
            # T78 current: gate 必须在剥括号后的文本上探 &&/||——`((a && arr[i]))` 的
            # 顶层 `&&` 被两层括号盖住, 裸文本 HasAnd/HasOr 探不到, 门永假, 走到
            # 下面 eager 的 node-eval LogAnd 臂前该臂已被 T78 的 eager-surface 门
            # 挡下 miss, 两条路都不通, decl 目标槽从未写入, 读到邻位残留值
            # ——静默错值(比修前更隐蔽)。剥括号只影响本门判定, 不改
            # declInitShortCircuitText 本身(AppendBoolConditionAssign 内部的
            # ConditionCbrBlockCount/EmitConditionCbrChain 已各自剥括号到位)。
            let declInitShortCircuitGateText = PrimaryBodyIrStripOuterParens(declInitShortCircuitText)
            if localSlot >= 0 &&
               localSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, localSlot) == coreir.LocalI32Tag &&
               declInitShortCircuitText != "" &&
               (PrimaryBodyIrConditionHasAnd(declInitShortCircuitGateText) ||
                PrimaryBodyIrConditionHasOr(declInitShortCircuitGateText)) &&
               stmt.rhsNodeIndex >= 0 &&
               PrimaryBodyIrNodeTreeHasFaultingEagerSurface(lowering.typedIr, stmt.rhsNodeIndex):
                var declBoolBlockStart: int32
                declBoolBlockStart = currentBlockStart
                if PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                          slotNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          stmt.sourcePath,
                                                          stmt.lineNumber,
                                                          declInitShortCircuitText,
                                                          localSlot,
                                                          callOrdinal,
                                                          declBoolBlockStart):
                    currentBlockStart = declBoolBlockStart
                    localInitialized = true
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=local_decl_bool_condition_assign function={typedFn.functionName} line={stmt.lineNumber}")
                else:
                    # T78 current poison-on-miss: this gate already confirmed a
                    # real `&&`/`||` decl-init with a faulting eager surface
                    # (call/下标) — the eager node-eval LogAnd/Or arm is known
                    # to MISS on it too (same eager-surface gate). If the real
                    # CBR-chain assigner ALSO fails to encode the condition,
                    # there is no remaining safe lowering: silently leaving
                    # localInitialized false lets the decl's slot fall through
                    # to whatever unrelated catch-all runs next and read
                    # uninitialized/adjacent residue. Force an honest
                    # whole-function bail instead.
                    PrimaryBodyIrAppendInvalidOp(bodyIR, stmt.lineNumber, int32(stmt.kind), 9703, 0)
            # `var x = TypeName()` 零实参类型构造器（含限定 `mod.TypeName()`）：
            # 默认零初始化整聚合槽。镜像 assign 路径的 assign_zero_ctor
            # （31510-31529）：`AssignZeroConstructorMatches` 已校验 RHS 是零参
            # 复合 `Type()`、目标聚合、尺寸一致、且头名非函数（构造器不是函数）。
            # 前端为限定构造器建了 CallExpr 节点（ordinal 必失败落 call_ordinal
            # gap），此处在 CallExpr 发射器之前拦截，纯 setMem 清零（与 assign
            # 路径同款语义，无新增 op、无 ordinal）。
            if !localInitialized &&
               localSlot >= 0 &&
               localSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, localSlot) == coreir.LocalAggregateTag &&
               PrimaryBodyIrAssignZeroConstructorMatches(bodyIR,
                                                         lowering.typedIr,
                                                         irFunction,
                                                         stmt.sourcePath,
                                                         stmt.surfaceText,
                                                         localSlot):
                if PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                    slotNames,
                                                    localSlot,
                                                    callOrdinal):
                    localInitialized = true
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=local_decl_zero_ctor function={typedFn.functionName} line={stmt.lineNumber}")
            if !localInitialized &&
               stmt.rhsNodeIndex >= 0 &&
               localSlot >= 0 &&
               localSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrVarParamPointeeKind(bodyIR, localSlot) == coreir.LocalInvalidTag:
                let declNodeKind = PrimaryBodyIrSlotType(bodyIR, localSlot)
                # 批次5：本地声明 RHS 整为 CallExpr 节点时走 CallExpr 发射器
                #（标量/str 槽）；命中即已初始化，miss 落回既有初始化路径。
                var declRhsLit = ""
                if stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                    let declRhsLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[stmt.rhsNodeIndex])
                    if IsOk(declRhsLitRes):
                        declRhsLit = Value(declRhsLitRes)
                if !localInitialized &&
                   stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                   lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpCallExpr &&
                   PrimaryBodyIrCastCallTargetKind(declRhsLit) == coreir.LocalInvalidTag &&
                   (declNodeKind == coreir.LocalI32Tag ||
                    declNodeKind == coreir.LocalI64Tag ||
                    declNodeKind == coreir.LocalF64Tag ||
                    declNodeKind == coreir.LocalStrTag ||
                    declNodeKind == coreir.LocalPtrTag ||
                    declNodeKind == coreir.LocalAggregateTag):
                    primaryBodyIrNodeEvalMissOp = ""
                    let declCallEmitMark = primaryBodyIrNodeEvalCallEmitCount
                    var declCallExprDone = false
                    # 批次6b：嵌套调用实参一旦发射不可落回文本路径，
                    # 发射前必须先过纯探针。
                    if PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                  slotNames,
                                                  varI32ParamNames,
                                                  lowering,

                                                  share(typedFn),
                                                  irFunction,
                                                  stmt.rhsNodeIndex) >= 0:
                        declCallExprDone = PrimaryBodyIrAppendCallExprNodeToSlot(bodyIR,
                                                                                 slotNames,
                                                                                 lowering,

                                                                                 typedFn,
                                                                                 irFunction,
                                                                                 varI32ParamNames,
                                                                                 stmt.rhsNodeIndex,
                                                                                 localSlot,
                                                                                 stmt.lineNumber,
                                                                                 callOrdinal)
                    if declCallExprDone:
                        localInitialized = true
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit function={typedFn.functionName} line={stmt.lineNumber}")
                    elif primaryBodyIrNodeEvalCallEmitCount != declCallEmitMark:
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     6101,
                                                     0)
                        localInitialized = true
                    elif os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        var declCallExprMissOpText = primaryBodyIrNodeEvalMissOp
                        if declCallExprMissOpText == "":
                            declCallExprMissOpText = "call_expr"
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={declCallExprMissOpText} function={typedFn.functionName} line={stmt.lineNumber}")
                if !localInitialized &&
                   declNodeKind == coreir.LocalF64Tag &&
                   texpr.TypedExprFindTopLevelTextToken(strutil.Strip(stmt.surfaceText), "?") > 0:
                    var declF64TernBlockStart = currentBlockStart
                    if PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,

                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt.sourcePath,
                                                                  stmt.lineNumber,
                                                                  stmt.rhsNodeIndex,
                                                                  strutil.Strip(stmt.surfaceText),
                                                                  localSlot,
                                                                  coreir.LocalF64Tag,
                                                                  callOrdinal,
                                                                  declF64TernBlockStart):
                        currentBlockStart = declF64TernBlockStart
                        localInitialized = true
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=local_decl_f64_ternary function={typedFn.functionName} line={stmt.lineNumber}")
                # BACKFILL-2/T25C (f24 33f086d, 缺口②): `let x = if cond: a else: b`
                # (and `cond ? a : b`) with a PLAIN call in a/b (int32/int64, no
                # Result[T] involved) never reached
                # PrimaryBodyIrAppendScalarTernaryBlockValue before this: the
                # call above only fed it declNodeKind==F64 text already in `?`
                # form. i32/i64 fell through to the generic EvalNode path a few
                # lines down, which misses on a Call-valued
                # TypedExprIrOpLocalBoolEnumTernary node and left the value
                # fabrication to the front-end's leftmost-column statement
                # split — which always executes/binds whichever call is
                # textually first unconditionally, and never actually
                # branches. PrimaryBodyIrAppendScalarTernaryBlockValue already
                # supports i32/i64 (and f64/ptr) with a real cbr — only the
                # selected arm's call executes — exactly mirroring the str
                # ternary path above. Convert the if/else text form to `?`
                # form first (same conversion the str path uses) so both
                # ternary syntaxes share this one real-branch lowering.
                # SCOPE NOTE: this dispatch is single-level only — a chained/
                # nested ternary arm (itself another `if...else:`) is NOT
                # converted here (that would be f24's ArmValue "附带" item,
                # deliberately not ported; see the guard above in
                # TypedExprIrAppendStatementsForScopeWithFactsAndExprLayer for
                # why). PrimaryBodyIrIfExprToTernaryText only converts the
                # outer if/else; a nested arm's raw "if ... else: ..." text
                # has no top-level `?`, so PrimaryBodyIrAppendScalarTernaryArmValue
                # falls through to its pre-existing (unmodified) handling for
                # that arm exactly as it did before this patch.
                if !localInitialized &&
                   (declNodeKind == coreir.LocalI32Tag ||
                    declNodeKind == coreir.LocalI64Tag):
                    var declScalarTernText = strutil.Strip(stmt.surfaceText)
                    if texpr.TypedExprFindTopLevelTextToken(declScalarTernText, "?") <= 0:
                        declScalarTernText = PrimaryBodyIrIfExprToTernaryText(declScalarTernText)
                    if declScalarTernText != "" &&
                       texpr.TypedExprFindTopLevelTextToken(declScalarTernText, "?") > 0:
                        var declScalarTernBlockStart = currentBlockStart
                        if PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      lowering,

                                                                      typedFn,
                                                                      irFunction,
                                                                      stmt.sourcePath,
                                                                      stmt.lineNumber,
                                                                      stmt.rhsNodeIndex,
                                                                      declScalarTernText,
                                                                      localSlot,
                                                                      declNodeKind,
                                                                      callOrdinal,
                                                                      declScalarTernBlockStart):
                            currentBlockStart = declScalarTernBlockStart
                            localInitialized = true
                            PrimaryBodyIrNodeEvalOnlyOwn()
                            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=local_decl_scalar_ternary function={typedFn.functionName} line={stmt.lineNumber}")
                if !localInitialized &&
                   (declNodeKind == coreir.LocalI32Tag ||
                    declNodeKind == coreir.LocalI64Tag ||
                    declNodeKind == coreir.LocalF64Tag ||
                    declNodeKind == coreir.LocalStrTag ||
                    declNodeKind == coreir.LocalPtrTag ||
                    declNodeKind == coreir.LocalAggregateTag):
                    primaryBodyIrNodeEvalMissOp = ""
                    # 批次6b：子树含调用时先过纯探针并预检存储形态。
                    # 聚合 RHS（seq[i]/字段路径/本地聚合）始终先过探针——
                    # EvalNode 会精确按元素/字段宽物化，探针确认形状为聚合
                    # 才继续，避免发出部分聚合搬运后落回文本路径。
                    var declNodeReady = true
                    if declNodeKind == coreir.LocalAggregateTag ||
                       declNodeKind == coreir.LocalPtrTag ||
                       PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, stmt.rhsNodeIndex):
                        let declNodeProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering,

                                                                           share(typedFn),
                                                                           irFunction,
                                                                           stmt.rhsNodeIndex)
                        if declNodeProbeKind < 0:
                            declNodeReady = false
                        elif declNodeKind == coreir.LocalStrTag:
                            declNodeReady = declNodeProbeKind == coreir.LocalStrTag
                        elif declNodeKind == coreir.LocalI32Tag:
                            declNodeReady = declNodeProbeKind == coreir.LocalI32Tag
                        elif declNodeKind == coreir.LocalI64Tag:
                            declNodeReady = declNodeProbeKind == coreir.LocalI32Tag ||
                                            declNodeProbeKind == coreir.LocalI64Tag
                        elif declNodeKind == coreir.LocalF64Tag:
                            declNodeReady = declNodeProbeKind == coreir.LocalF64Tag
                        elif declNodeKind == coreir.LocalPtrTag:
                            declNodeReady = declNodeProbeKind == coreir.LocalPtrTag
                        elif declNodeKind == coreir.LocalAggregateTag:
                            declNodeReady = declNodeProbeKind == coreir.LocalAggregateTag
                        else:
                            declNodeReady = false
                    let declNodeEmitMark = primaryBodyIrNodeEvalCallEmitCount
                    var declNodeValueSlot: int32 = -1
                    if declNodeReady:
                        declNodeValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,

                                                                  share(typedFn),
                                                                  irFunction,
                                                                  stmt.rhsNodeIndex,
                                                                  callOrdinal)
                    if declNodeValueSlot >= 0 && stmt.bindingName == "_":
                        # `let _ = RHS` 丢弃绑定：RHS 已求值（含调用副作用），值
                        # 被丢弃——聚合/by-ref 结果无需存进 `_` 槽（存储仅做形状
                        # 校验，丢弃语义下纯属多余且会因形不符误 miss）。镜像
                        # assign 路径 25708 `_` 丢弃语义：求值即认领，不发 store。
                        localInitialized = true
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=local_decl_discard function={typedFn.functionName} line={stmt.lineNumber}")
                    elif declNodeValueSlot >= 0 &&
                       PrimaryBodyIrNodeEvalStore(bodyIR, slotNames, localSlot, declNodeValueSlot):
                        localInitialized = true
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit function={typedFn.functionName} line={stmt.lineNumber}")
                    elif primaryBodyIrNodeEvalCallEmitCount != declNodeEmitMark:
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     6101,
                                                     0)
                        localInitialized = true
                    elif os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        var declNodeMissOpText = primaryBodyIrNodeEvalMissOp
                        if declNodeMissOpText == "":
                            declNodeMissOpText = "store_shape"
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={declNodeMissOpText} function={typedFn.functionName} line={stmt.lineNumber}")
            # str 三元 decl `let s = if cond: "a" else: "b"`(及 `cond ? a : b` 形)
            # 是 cbr 真分支的规范下降(与 let_call 孪生 str 三元路径 30816 同款);经
            # AppendStrTernaryDeclValue 消费后显式 Own,使节点求值口径认领该语句,
            # 而非由下游 AppendLocalDeclInitializer 文本路径(不 Own)留作 gap。
            if !localInitialized &&
               localSlot >= 0 &&
               localSlot < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, localSlot) == coreir.LocalStrTag:
                let declStrTernRhs = strutil.Strip(parser.ParserStripLineComment(stmt.surfaceText))
                var declStrTernText = PrimaryBodyIrStripOuterParens(declStrTernRhs)
                if texpr.TypedExprFindTopLevelTextToken(declStrTernText, "?") <= 0:
                    declStrTernText = PrimaryBodyIrIfExprToTernaryText(declStrTernText)
                if declStrTernText != "" &&
                   texpr.TypedExprFindTopLevelTextToken(declStrTernText, "?") > 0 &&
                   PrimaryBodyIrAppendStrTernaryDeclValue(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          stmt,
                                                          stmt.rhsNodeIndex,
                                                          declStrTernText,
                                                          localSlot,
                                                          callOrdinal,
                                                          currentBlockStart):
                    localInitialized = true
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=local_decl_str_ternary function={typedFn.functionName} line={stmt.lineNumber}")
            # 非空标量动态序列字面量只允许 TypedIR SeqLiteral 路径发射。
            # 节点缺失表示元素 unknown/异质或类型未被前端证明；节点存在但求值
            # 失败也不得落回文本解析器，否则会重新猜元素类型并静默写错宽度。
            if !localInitialized && localDeclRequiresTypedScalarSeqLiteral:
                let localDeclSeqNodeValid = stmt.rhsNodeIndex >= 0 &&
                                            stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                                            lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpSeqLiteral
                if !localDeclSeqNodeValid:
                    let _ = PrimaryBodyIrNodeEvalMissAt("seq_literal_typed_node")
                elif primaryBodyIrNodeEvalMissOp == "":
                    let _ = PrimaryBodyIrNodeEvalMissAt("seq_literal_typed_emit")
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             6103,
                                             0)
                localInitialized = true
            if !localInitialized:
                localInitialized = PrimaryBodyIrAppendLocalDeclInitializer(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering,

                                                                           typedFn,
                                                                           irFunction,
                                                                           stmt,
                                                                           localSlot,
                                                                           callOrdinal,
                                                                           currentBlockStart)
            if !localInitialized && PrimaryBodyIrTypeTextIsSeqStr(stmt.resultType):
                localInitialized = PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                                    slotNames,
                                                                    localSlot,
                                                                    callOrdinal)
            var localDeclBareDefaultInitialized = false
            if !localInitialized &&
               strutil.Strip(stmt.surfaceText) == "" &&
               localSlot >= 0 &&
               localSlot < bodyIR.localSlots.len:
                # 裸 `var x: T` 声明的零值语义：标量槽必须 LoadConst 0，
                # 否则读到栈上垃圾（debug_cstrlen 的 var n 即此缺陷）。
                let bareDeclSlotKind = PrimaryBodyIrSlotType(bodyIR, localSlot)
                if bareDeclSlotKind == coreir.LocalI32Tag ||
                   bareDeclSlotKind == coreir.LocalI64Tag ||
                   bareDeclSlotKind == coreir.LocalPtrTag ||
                   bareDeclSlotKind == coreir.LocalF64Tag:
                    # f64 zero travels as raw bits through the i64 const path
                    var bareDeclZeroKind = bareDeclSlotKind
                    if bareDeclZeroKind == coreir.LocalF64Tag:
                        bareDeclZeroKind = coreir.LocalI64Tag
                    var bareDeclZeroOp: coreir.BodyOp
                    bareDeclZeroOp.kind = coreir.BodyOpLoadConstTag
                    bareDeclZeroOp.target = localSlot
                    add(bareDeclZeroOp.operands, bareDeclZeroKind)
                    add(bareDeclZeroOp.operands, 0)
                    let _ = coreir.BodyIRAppendOp(bodyIR, bareDeclZeroOp)
                    localInitialized = true
                    localDeclBareDefaultInitialized = true
                elif bareDeclSlotKind == coreir.LocalAggregateTag ||
                     bareDeclSlotKind == coreir.LocalStrTag:
                    localInitialized = PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                                        slotNames,
                                                                        localSlot,
                                                                        callOrdinal)
                    if localInitialized:
                        localDeclBareDefaultInitialized = true
            if !localInitialized &&
               strutil.Strip(stmt.surfaceText) != "" &&
               localSlot >= 0 &&
               localSlot < bodyIR.localSlots.len:
                # 初始化器主路径失败时复用统一表达式机器（ptr cast/sizeof/二元/三元），
                # 静默跳过会留下未初始化槽（cheng_malloc_export 的 total 曾因此读垃圾）。
                let declInitRhs = strutil.Strip(stmt.surfaceText)
                let declInitKind = PrimaryBodyIrSlotType(bodyIR, localSlot)
                var declInitVarI32Names: str[]
                declInitVarI32Names = []
                var declInitFallbackSlot: int32 = -1
                if declInitKind == coreir.LocalPtrTag:
                    # A1 真物化: `let/var p: ptr = &local` / `= ptr(&local)` decl-init 取址局部。
                    # 复用 assignment/call-arg 取址机器 (BodyLoadLocalAddress) 把源栈槽地址
                    # LEA 进 p 槽; 否则落 PtrExpressionSlot 文本兜底会丢 `&` 求值致 p 读未写槽。
                    let declAddrName = PrimaryBodyIrPtrAddressArgName(declInitRhs)
                    if declAddrName != "":
                        let declAddrSourceSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, declAddrName)
                        if declAddrSourceSlot >= 0 &&
                           declAddrSourceSlot < bodyIR.localSlots.len &&
                           bodyIR.localSlots[declAddrSourceSlot].placeKind == coreir.BodyPlaceStackValueTag:
                            var declAddrOp: coreir.BodyOp
                            declAddrOp.kind = coreir.BodyOpLoadLocalTag
                            declAddrOp.target = localSlot
                            add(declAddrOp.operands, coreir.BodyLoadLocalAddressTag)
                            add(declAddrOp.operands, declAddrSourceSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, declAddrOp)
                            localInitialized = true
                        if !localInitialized &&
                           declAddrSourceSlot >= 0 &&
                           parser.ParserIdentPrefix(declAddrName) == declAddrName:
                            # poison-on-miss: 已知普通局部但非 stack-value 槽位，无法 LEA 物化;
                            # 落 PtrExpressionSlot 文本兜底会丢 `&` 读值建死槽 = 静默 miscompile。
                            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                         stmt.lineNumber,
                                                         int32(stmt.kind),
                                                         8548,
                                                         2)
                            localInitialized = true
                    if !localInitialized:
                        declInitFallbackSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                                              slotNames,
                                                                              declInitVarI32Names,
                                                                              lowering.typedIr,
                                                                              stmt.sourcePath,
                                                                              declInitRhs,
                                                                              callOrdinal)
                elif declInitKind == coreir.LocalI64Tag:
                    declInitFallbackSlot = PrimaryBodyIrU64ValueSlotForText(bodyIR,
                                                                            slotNames,
                                                                            declInitVarI32Names,
                                                                            lowering.typedIr,
                                                                            stmt.sourcePath,
                                                                            declInitRhs,
                                                                            callOrdinal)
                    if declInitFallbackSlot < 0:
                        declInitFallbackSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                                   slotNames,
                                                                                   declInitVarI32Names,
                                                                                   lowering.typedIr,
                                                                                   stmt.sourcePath,
                                                                                   declInitRhs,
                                                                                   coreir.LocalI64Tag,
                                                                                   callOrdinal)
                elif declInitKind == coreir.LocalI32Tag:
                    declInitFallbackSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                               slotNames,
                                                                               declInitVarI32Names,
                                                                               lowering.typedIr,
                                                                               stmt.sourcePath,
                                                                               declInitRhs,
                                                                               coreir.LocalI32Tag,
                                                                               callOrdinal)
                if declInitFallbackSlot < 0 &&
                   declInitKind != coreir.LocalF64Tag:
                    # 三元初始化器：cond 经 CmpTag 产 0/1，再用 cond*(t-f)+f 选择。
                    let declTernQ = texpr.TypedExprFindTopLevelTextToken(declInitRhs, "?")
                    if declTernQ > 0:
                        let declTernTail = strings.SliceBytes(declInitRhs,
                                                              declTernQ + 1,
                                                              len(declInitRhs) - declTernQ - 1)
                        let declTernColon = texpr.TypedExprFindTopLevelTextToken(declTernTail, ":")
                        if declTernColon > 0:
                            let declTernCond = strutil.Strip(strings.SliceBytes(declInitRhs, 0, declTernQ))
                            let declTernTrue = strutil.Strip(strings.SliceBytes(declTernTail, 0, declTernColon))
                            let declTernFalse = strutil.Strip(strings.SliceBytes(declTernTail,
                                                                                 declTernColon + 1,
                                                                                 len(declTernTail) - declTernColon - 1))
                            var declTernArithKind = declInitKind
                            if declInitKind == coreir.LocalPtrTag:
                                declTernArithKind = coreir.LocalI64Tag
                            var declTernCondSlot: int32 = -1
                            if declTernCond != "" && declTernTrue != "" && declTernFalse != "":
                                declTernCondSlot = PrimaryBodyIrCondValue01Slot(bodyIR,
                                                                                slotNames,
                                                                                lowering,

                                                                                typedFn,
                                                                                irFunction,
                                                                                stmt.sourcePath,
                                                                                stmt.lineNumber,
                                                                                declTernCond,
                                                                                Fmt"{stmt.bindingName}#tern_cond#{stmt.lineNumber}",
                                                                                callOrdinal)
                                # T78: CondValue01Slot bails(-1) on a ternary
                                # `cond` whose `&&`/`||` operand has a faulting
                                # eager surface. The arithmetic select below only
                                # needs a valid 0/1 slot, so a real CBR-chain
                                # assign is a drop-in replacement for cond.
                                # AppendBoolConditionAssign strips outer parens
                                # and validates the shape itself
                                # (ConditionCbrBlockCount<=0 => false); a
                                # HasAnd/HasOr pre-check on the still-paren-
                                # wrapped `declTernCond` (e.g. `(a && b)`, one
                                # level of parens retained by the `?`/`:` split
                                # above) misses `&&` nested one level deep and
                                # would silently skip this fallback, leaving
                                # declTernCondSlot at -1 and the whole ternary
                                # block unentered — the decl's target slot is
                                # then never written and a later unrelated
                                # catch-all hands back an orphan slot (T78
                                # real repro: silent wrong-value, not a bail).
                                if declTernCondSlot < 0:
                                    let declTernCbrScratchSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                               slotNames,
                                                                                               Fmt"{stmt.bindingName}#tern_cond_cbr#{stmt.lineNumber}",
                                                                                               coreir.LocalI32Tag)
                                    if declTernCbrScratchSlot >= 0:
                                        var declTernCbrBlockStart = currentBlockStart
                                        if PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                                                  slotNames,
                                                                                  lowering,

                                                                                  typedFn,
                                                                                  irFunction,
                                                                                  stmt.sourcePath,
                                                                                  stmt.lineNumber,
                                                                                  declTernCond,
                                                                                  declTernCbrScratchSlot,
                                                                                  callOrdinal,
                                                                                  declTernCbrBlockStart):
                                            currentBlockStart = declTernCbrBlockStart
                                            declTernCondSlot = declTernCbrScratchSlot
                                # T78 current poison-on-miss: a confirmed `&&`/`||`
                                # ternary cond (checked on paren-stripped text)
                                # that STILL has no valid slot after both the
                                # direct CondValue01Slot try and the CBR-chain
                                # fallback must not silently leave
                                # declTernCondSlot at -1 — the `if
                                # declTernCondSlot >= 0:` gate below would then
                                # quietly skip the whole ternary block and the
                                # decl's target slot is never written (silent
                                # orphan-slot wrong value — the exact T78 real
                                # repro this mirror closes). Force an honest
                                # whole-function bail instead.
                                if declTernCondSlot < 0 &&
                                   (PrimaryBodyIrConditionHasAnd(PrimaryBodyIrStripOuterParens(declTernCond)) ||
                                    PrimaryBodyIrConditionHasOr(PrimaryBodyIrStripOuterParens(declTernCond))):
                                    PrimaryBodyIrAppendInvalidOp(bodyIR, stmt.lineNumber, int32(stmt.kind), 9702, 0)
                            if declTernCondSlot >= 0:
                                var declTernValueSlot: int32 = -1
                                var declTernFalseSlot: int32 = -1
                                if declTernCondSlot >= 0:
                                    if declInitKind == coreir.LocalPtrTag:
                                        declTernValueSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                                                           slotNames,
                                                                                           declInitVarI32Names,
                                                                                           lowering.typedIr,
                                                                                           stmt.sourcePath,
                                                                                           declTernTrue,
                                                                                           callOrdinal)
                                        if declTernValueSlot < 0:
                                            declTernValueSlot = PrimaryBodyIrCondCmpOperandSlot(bodyIR,
                                                                                                slotNames,
                                                                                                lowering.typedIr,
                                                                                                stmt.sourcePath,
                                                                                                declTernTrue,
                                                                                                Fmt"{stmt.bindingName}#tern_t#{stmt.lineNumber}",
                                                                                                callOrdinal)
                                        declTernFalseSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                                                           slotNames,
                                                                                           declInitVarI32Names,
                                                                                           lowering.typedIr,
                                                                                           stmt.sourcePath,
                                                                                           declTernFalse,
                                                                                           callOrdinal)
                                        if declTernFalseSlot < 0:
                                            declTernFalseSlot = PrimaryBodyIrCondCmpOperandSlot(bodyIR,
                                                                                                slotNames,
                                                                                                lowering.typedIr,
                                                                                                stmt.sourcePath,
                                                                                                declTernFalse,
                                                                                                Fmt"{stmt.bindingName}#tern_f#{stmt.lineNumber}",
                                                                                                callOrdinal)
                                        if declTernValueSlot < 0:
                                            declTernValueSlot = PrimaryBodyIrCStringLiteralPtrSlot(bodyIR,
                                                                                                   slotNames,
                                                                                                   declTernTrue)
                                        if declTernFalseSlot < 0:
                                            declTernFalseSlot = PrimaryBodyIrCStringLiteralPtrSlot(bodyIR,
                                                                                                   slotNames,
                                                                                                   declTernFalse)
                                    else:
                                        declTernValueSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                                                slotNames,
                                                                                                declInitVarI32Names,
                                                                                                lowering.typedIr,
                                                                                                stmt.sourcePath,
                                                                                                declTernTrue,
                                                                                                declTernArithKind,
                                                                                                callOrdinal)
                                        declTernFalseSlot = PrimaryBodyIrScalarValueSlotForText(bodyIR,
                                                                                                slotNames,
                                                                                                declInitVarI32Names,
                                                                                                lowering.typedIr,
                                                                                                stmt.sourcePath,
                                                                                                declTernFalse,
                                                                                                declTernArithKind,
                                                                                                callOrdinal)
                                if declTernCondSlot >= 0 && declTernValueSlot >= 0 && declTernFalseSlot >= 0:
                                    let declTernDelta = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                      slotNames,
                                                                                      Fmt"{stmt.bindingName}#tern_delta#{stmt.lineNumber}",
                                                                                      declTernArithKind)
                                    let declTernScaled = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                       slotNames,
                                                                                       Fmt"{stmt.bindingName}#tern_scaled#{stmt.lineNumber}",
                                                                                       declTernArithKind)
                                    if declTernDelta >= 0 && declTernScaled >= 0:
                                        var declTernSubOp: coreir.BodyOp
                                        declTernSubOp.kind = coreir.BodyOpBinOpTag
                                        declTernSubOp.target = declTernDelta
                                        add(declTernSubOp.operands, declTernArithKind)
                                        add(declTernSubOp.operands, int32(texpr.TypedExprIrOpI32Sub))
                                        add(declTernSubOp.operands, declTernValueSlot)
                                        add(declTernSubOp.operands, declTernFalseSlot)
                                        let _ = coreir.BodyIRAppendOp(bodyIR, declTernSubOp)
                                        var declTernMulOp: coreir.BodyOp
                                        declTernMulOp.kind = coreir.BodyOpBinOpTag
                                        declTernMulOp.target = declTernScaled
                                        add(declTernMulOp.operands, declTernArithKind)
                                        add(declTernMulOp.operands, int32(texpr.TypedExprIrOpI32Mul))
                                        add(declTernMulOp.operands, declTernDelta)
                                        add(declTernMulOp.operands, declTernCondSlot)
                                        let _ = coreir.BodyIRAppendOp(bodyIR, declTernMulOp)
                                        if declInitKind == coreir.LocalPtrTag:
                                            let declTernSum = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                                            slotNames,
                                                                                            Fmt"{stmt.bindingName}#tern_sum#{stmt.lineNumber}",
                                                                                            coreir.LocalI64Tag)
                                            if declTernSum >= 0:
                                                var declTernAddOp: coreir.BodyOp
                                                declTernAddOp.kind = coreir.BodyOpBinOpTag
                                                declTernAddOp.target = declTernSum
                                                add(declTernAddOp.operands, coreir.LocalI64Tag)
                                                add(declTernAddOp.operands, int32(texpr.TypedExprIrOpI32Add))
                                                add(declTernAddOp.operands, declTernScaled)
                                                add(declTernAddOp.operands, declTernFalseSlot)
                                                let _ = coreir.BodyIRAppendOp(bodyIR, declTernAddOp)
                                                var declTernPtrCopyOp: coreir.BodyOp
                                                declTernPtrCopyOp.kind = coreir.BodyOpCopyLocalTag
                                                declTernPtrCopyOp.target = localSlot
                                                add(declTernPtrCopyOp.operands, declTernSum)
                                                let _ = coreir.BodyIRAppendOp(bodyIR, declTernPtrCopyOp)
                                                localInitialized = true
                                        else:
                                            var declTernAddOp: coreir.BodyOp
                                            declTernAddOp.kind = coreir.BodyOpBinOpTag
                                            declTernAddOp.target = localSlot
                                            add(declTernAddOp.operands, declTernArithKind)
                                            add(declTernAddOp.operands, int32(texpr.TypedExprIrOpI32Add))
                                            add(declTernAddOp.operands, declTernScaled)
                                            add(declTernAddOp.operands, declTernFalseSlot)
                                            let _ = coreir.BodyIRAppendOp(bodyIR, declTernAddOp)
                                            localInitialized = true
                                else:
                                    # W2 poison-on-miss (镜像上方 9702 cond 臂): 三元值臂物化
                                    # 失败不得静默跳过 —— 目标槽会成孤儿被后续读出栈垃圾
                                    # (cheng_panic_cstring_and_exit_export 的 safeText 实案)。
                                    PrimaryBodyIrAppendInvalidOp(bodyIR, stmt.lineNumber, int32(stmt.kind), 9703, 0)
                if declInitFallbackSlot >= 0 &&
                   declInitFallbackSlot < bodyIR.localSlots.len &&
                   PrimaryBodyIrSlotType(bodyIR, declInitFallbackSlot) == declInitKind:
                    if declInitFallbackSlot == localSlot:
                        localInitialized = true
                    else:
                        var declInitCopyOp: coreir.BodyOp
                        declInitCopyOp.kind = coreir.BodyOpCopyLocalTag
                        declInitCopyOp.target = localSlot
                        add(declInitCopyOp.operands, declInitFallbackSlot)
                        let _ = coreir.BodyIRAppendOp(bodyIR, declInitCopyOp)
                        localInitialized = true
                # wave-36 A1 materialize-else poison: 上游 LEA 臂 (declAddrName
                # 分支) 与全部 fallback 均未物化的 ptr 取址 decl-init，诚实 bail
                # (addr_of_local_ptr_decl)，禁止静默留未写槽。
                if !localInitialized &&
                   declInitKind == coreir.LocalPtrTag &&
                   PrimaryBodyIrPtrAddressArgName(declInitRhs) != "":
                    let _ = PrimaryBodyIrNodeEvalMissAt("addr_of_local_ptr_decl")
                # wave9-const poison-on-miss 铁律: 纯裸标识符 RHS(无点/无调用面/
                # 无运算符——同 MkA/QPlain 形)经局部/参数/同文件 const/跨模块无
                # 限定 const(本 wave 新增)/枚举/全局/三元/加法机器全部路径仍未
                # 命中(含跨模块撞名——LookupUnqualifiedImportedConst* 对 >=2 声明
                # 者故意返回未命中以维持 poison), 绝不留未写槽读栈垃圾——诚实 bail
                # (poison_scalar_ident_decl)。形态严格限定为纯标识符, 与上方所有
                # 已命中分支(literal/ternary/call/field/addr-of 等)严格不重叠。
                if !localInitialized &&
                   (declInitKind == coreir.LocalI32Tag ||
                    declInitKind == coreir.LocalI64Tag ||
                    declInitKind == coreir.LocalStrTag) &&
                   declInitRhs != "" &&
                   parser.ParserIdentPrefix(declInitRhs) == declInitRhs:
                    PrimaryBodyIrAppendInvalidOp(bodyIR, stmt.lineNumber, int32(stmt.kind), 9601, 0)
                    localInitialized = true
                # #85 根修: f64 decl-init 字面量物化失败(小数点后 >18 位精度
                # 溢出, AppendF64ConstOperands 失败)此前无 catch-all——上方
                # ptr/i32/i64/str 分支都不覆盖 LocalF64Tag，node-eval(45930 一带)
                # 与本函数上面的全部 fallback 都已尝试过仍未命中时，localSlot
                # 建好后从未 store，读栈垃圾静默 miscompile (rc=0 clean，#76d/#85
                # 定谳，f64_pi20_cmp.cheng 反汇编实证)。诚实 bail，不许静默留
                # 未写槽。形态限定为字面量(PrimaryBodyIrTextIsF64Literal)，与
                # 上方所有已命中分支严格不重叠。
                if !localInitialized &&
                   declInitKind == coreir.LocalF64Tag &&
                   PrimaryBodyIrTextIsF64Literal(declInitRhs):
                    PrimaryBodyIrAppendInvalidOp(bodyIR, stmt.lineNumber, int32(stmt.kind), 8551, 0)
                    localInitialized = true
            if localInitialized:
                if localDeclBareDefaultInitialized:
                    PrimaryBodyIrNodeEvalOnlyOwn()
                add(initializedLocalDeclLines, stmt.lineNumber)
                add(initializedLocalDeclNames, share(stmt.bindingName))
        elif stmt.kind == texpr.TypedExprIrStmtResultIntrinsic:
            let resultIntrinsicName = stmt.callCallee
            let resultIntrinsicIsProjection = resultIntrinsicName == "Value" ||
                resultIntrinsicName == "Error" ||
                resultIntrinsicName == "ErrorInfoOf" ||
                resultIntrinsicName == "IsOk" ||
                resultIntrinsicName == "IsErr"
            let resultIntrinsicIsConstructor = resultIntrinsicName == "Ok" ||
                resultIntrinsicName == "Err"
            if resultIntrinsicIsConstructor:
                if !PrimaryBodyIrResultConstructorContract(lowering.typedIr,
                                                            typedFn,
                                                            irFunction,
                                                            stmt):
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 61,
                                                 int32(stmt.detailKind))
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    nextOpIndex = nextOpIndex + 1
                    continue
                var resultConstructorDriverIndex: int32 = -1
                for resultDriverP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let resultDriverIndex = sameLineOrder[resultDriverP]
                    if resultDriverIndex == stmtIndex:
                        continue
                    let resultDriverStmt = irFunction.statements[resultDriverIndex]
                    if resultDriverStmt.kind == texpr.TypedExprIrStmtReturn ||
                       resultDriverStmt.kind == texpr.TypedExprIrStmtIf ||
                       resultDriverStmt.kind == texpr.TypedExprIrStmtElif ||
                       resultDriverStmt.kind == texpr.TypedExprIrStmtWhile ||
                       resultDriverStmt.kind == texpr.TypedExprIrStmtLocalDecl ||
                       resultDriverStmt.kind == texpr.TypedExprIrStmtLetCall ||
                       resultDriverStmt.kind == texpr.TypedExprIrStmtAssign ||
                       resultDriverStmt.kind == texpr.TypedExprIrStmtCall:
                        resultConstructorDriverIndex = resultDriverIndex
                        break
                if resultConstructorDriverIndex >= 0:
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    nextOpIndex = nextOpIndex + 1
                    continue
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             61,
                                             int32(stmt.detailKind))
                PrimaryBodyIrNodeEvalOnlyOwn()
                nextOpIndex = nextOpIndex + 1
                continue
            if !resultIntrinsicIsProjection:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             61,
                                             int32(stmt.detailKind))
                PrimaryBodyIrNodeEvalOnlyOwn()
                nextOpIndex = nextOpIndex + 1
                continue
            var resultSourceNodeIndex: int32
            var resultSourceBinding = ""
            var resultSourceType = ""
            var resultSourceInner = ""
            var resultContractProjectKind = coreir.BodyResultProjectInvalidTag
            let resultProjectionContractOk = PrimaryBodyIrDispatchResultIntrinsicConsumer(
                lowering.typedIr,
                typedFn,
                irFunction,
                stmt,
                resultSourceNodeIndex,
                resultSourceBinding,
                resultSourceType,
                resultSourceInner,
                resultContractProjectKind)
            if !resultProjectionContractOk:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             61,
                                             int32(parser.ParserResultIntrinsicDetailKind(resultIntrinsicName)))
                PrimaryBodyIrNodeEvalOnlyOwn()
                nextOpIndex = nextOpIndex + 1
                continue
            # A bindingless ResultIntrinsic is a typed fact for its enclosing
            # statement. When that statement's node tree owns the exact same
            # projection, only the node consumer emits it.
            var resultProjectionOwnedByNodeDriver = false
            if stmt.bindingName == "":
                for resultDriverP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let resultDriverIndex = sameLineOrder[resultDriverP]
                    if resultDriverIndex == stmtIndex:
                        continue
                    let resultDriverStmt = irFunction.statements[resultDriverIndex]
                    let resultDriverOwnsNode =
                        resultDriverStmt.kind == texpr.TypedExprIrStmtReturn ||
                        resultDriverStmt.kind == texpr.TypedExprIrStmtIf ||
                        resultDriverStmt.kind == texpr.TypedExprIrStmtElif ||
                        resultDriverStmt.kind == texpr.TypedExprIrStmtWhile ||
                        resultDriverStmt.kind == texpr.TypedExprIrStmtLocalDecl ||
                        resultDriverStmt.kind == texpr.TypedExprIrStmtLetCall ||
                        resultDriverStmt.kind == texpr.TypedExprIrStmtAssign ||
                        resultDriverStmt.kind == texpr.TypedExprIrStmtCall
                    if resultDriverOwnsNode &&
                       PrimaryBodyIrNodeTreeContainsResultProjection(
                           lowering.typedIr,
                           resultDriverStmt.rhsNodeIndex,
                           resultContractProjectKind,
                           share(resultSourceBinding),
                           share(resultSourceInner)):
                        resultProjectionOwnedByNodeDriver = true
                        break
            if resultProjectionOwnedByNodeDriver:
                PrimaryBodyIrCommitResultIntrinsicActualConsume(
                    structuredResultIntrinsicConsumeCountOut)
                PrimaryBodyIrNodeEvalOnlyOwn()
                nextOpIndex = nextOpIndex + 1
                continue
            var sourceSlot: int32 = -1
            sourceSlot = PrimaryBodyIrFindArgSlot(bodyIR,
                                                   slotNames,
                                                   resultSourceBinding)
            if sourceSlot < 0:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             61,
                                             int32(parser.ParserResultIntrinsicDetailKind(resultIntrinsicName)))
                PrimaryBodyIrNodeEvalOnlyOwn()
                nextOpIndex = nextOpIndex + 1
                continue
            var targetSlot: int32 = -1
            if stmt.bindingName != "":
                targetSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                slotNames,
                                                                lowering.typedIr,
                                                                stmt.sourcePath,
                                                                stmt.bindingName,
                                                                stmt.resultType)
            var projectKind = resultContractProjectKind
            var projectOffset: int32
            var projectByteCount: int32
            # F14b: Err->Value() must panic, never silently return a zero
            # value (result.cheng:80-83 source guard). valueErrMsgLayoutOk
            # gates the guard emission right before the value-copy op below;
            # a miss here poisons the whole statement (same as any other
            # ResultIntrinsic precondition miss) rather than falling through
            # unguarded.
            var valueErrMsgOffset: int32
            var valueErrMsgLayoutOk = false
            if resultIntrinsicName == "Value":
                var valueTypeKind: int32
                var valueSizeBytes: int32
                var valueAlignBytes: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               stmt.sourcePath,
                                               stmt.resultType,
                                               valueTypeKind,
                                               valueSizeBytes,
                                               valueAlignBytes)
                projectOffset = PrimaryBodyIrAlignedOffset(1, valueAlignBytes)
                projectByteCount = valueSizeBytes
                var valueErrValueKind: int32
                var valueErrValueSize: int32
                var valueErrValueOffset: int32
                var valueErrCodeOffset: int32
                var valueErrTotalSize: int32
                valueErrMsgLayoutOk = PrimaryBodyIrResultConstructLayout(lowering.typedIr,
                                                                          stmt.sourcePath,
                                                                          share(resultSourceInner),
                                                                          valueErrValueKind,
                                                                          valueErrValueSize,
                                                                          valueErrValueOffset,
                                                                          valueErrCodeOffset,
                                                                          valueErrMsgOffset,
                                                                          valueErrTotalSize)
            elif resultIntrinsicName == "Error":
                # errmsg 偏移随源 Result 内型解算（标量内型落 < 40）；源内型
                # 取首实参绑定类型→Result[T] 解 T→构造布局算偏移。解不出即
                # 保持 InvalidTag（projectByteCount=0）触发同行驱动孪生降级。
                var errTextValueKind: int32
                var errTextValueSize: int32
                var errTextValueOffset: int32
                var errTextErrCodeOffset: int32
                var errTextErrMsgOffset: int32
                var errTextTotalSize: int32
                if PrimaryBodyIrResultConstructLayout(lowering.typedIr,
                                                       stmt.sourcePath,
                                                       share(resultSourceInner),
                                                       errTextValueKind,
                                                       errTextValueSize,
                                                       errTextValueOffset,
                                                       errTextErrCodeOffset,
                                                       errTextErrMsgOffset,
                                                       errTextTotalSize):
                    projectOffset = errTextErrMsgOffset
                    projectByteCount = 24
            elif resultIntrinsicName == "ErrorInfoOf":
                # ErrorInfoOf[T](r) 内征：把源 Result 聚合里的整块 err{code,msg}
                # 子聚合（32B = ErrorInfo 布局）投影到 ErrorInfo 结果槽。err 块
                # 偏移随源内型 T 解算（与 Error 投影同源：取首实参 Result[T] 解
                # T→构造布局算 errCodeOffset）。解不出即保持 InvalidTag 触发同行
                # 驱动孪生降级。
                var errInfoValueKind: int32
                var errInfoValueSize: int32
                var errInfoValueOffset: int32
                var errInfoErrCodeOffset: int32
                var errInfoErrMsgOffset: int32
                var errInfoTotalSize: int32
                if PrimaryBodyIrResultConstructLayout(lowering.typedIr,
                                                       stmt.sourcePath,
                                                       share(resultSourceInner),
                                                       errInfoValueKind,
                                                       errInfoValueSize,
                                                       errInfoValueOffset,
                                                       errInfoErrCodeOffset,
                                                       errInfoErrMsgOffset,
                                                       errInfoTotalSize):
                    projectOffset = errInfoErrCodeOffset
                    projectByteCount = errInfoTotalSize - errInfoErrCodeOffset
            var resultProjectionLayoutOk = projectKind != coreir.BodyResultProjectInvalidTag
            if projectKind != coreir.BodyResultProjectIsErrTag &&
               projectKind != coreir.BodyResultProjectIsOkTag &&
               projectByteCount <= 0:
                resultProjectionLayoutOk = false
            if projectKind == coreir.BodyResultProjectValueStrTag &&
               !valueErrMsgLayoutOk:
                resultProjectionLayoutOk = false
            if !resultProjectionLayoutOk:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             61,
                                             int32(parser.ParserResultIntrinsicDetailKind(resultIntrinsicName)))
                PrimaryBodyIrNodeEvalOnlyOwn()
                nextOpIndex = nextOpIndex + 1
                continue
            if targetSlot < 0 &&
               (projectKind == coreir.BodyResultProjectIsErrTag ||
                projectKind == coreir.BodyResultProjectIsOkTag):
                targetSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                           slotNames,
                                                           Fmt"#result_intrinsic_bool_{stmt.lineNumber}_{stmtIndex}",
                                                           coreir.LocalI32Tag)
            # `return IsOk(r)`/`return IsErr(r)` 的孪生 result_intrinsic:同行 return 驱动
            # 已通过 AppendReturnBoolCondition→EmitConditionOps 的 IsOk 分支物化该布尔投影并
            # 终结块(completedReturnLineNumber==stmt.lineNumber 仅 return 成功路径置位),孪生
            # 此处再发 ResultProject 必落在 return 终结符之后=不可达 dead op → 未归块 bail_92。
            # 跳过孪生(镜像下方 sameLine-driver skip 的 Own+continue)。三重门控防误跳独立
            # let 的投影:① 仅 IsOk/IsErr(布尔投影,return 自物化;Value/Error 不自物化不跳);
            # ② 同行 return 已成功;③ 无 let 绑定(stmt.bindingName==""),独立 let b=IsOk(r2)
            # 的孪生带绑定不跳、正常发射供 let 用。
            if PrimaryBodyIrCommitCompletedReturnResultIntrinsic(
                completedReturnLineNumber,
                stmt.lineNumber,
                stmt.bindingName,
                projectKind,
                structuredResultIntrinsicConsumeCountOut):
                PrimaryBodyIrNodeEvalOnlyOwn()
                nextOpIndex = nextOpIndex + 1
                continue
            # targetSlot < 0 for bindingless Result projections (e.g. assert(Value(r)))
            # where the intrinsic has no let-binding. If source+projectKind+projectByteCount
            # are all valid, create a temp slot and emit ResultProject directly.
            if targetSlot < 0:
                targetSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                 slotNames,
                                                                 lowering.typedIr,
                                                                 stmt.sourcePath,
                                                                 Fmt"#result_intrinsic_temp_{stmt.lineNumber}_{stmtIndex}",
                                                                 stmt.resultType)
            if targetSlot < 0:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             61,
                                             int32(parser.ParserResultIntrinsicDetailKind(resultIntrinsicName)))
                PrimaryBodyIrNodeEvalOnlyOwn()
                nextOpIndex = nextOpIndex + 1
                continue
            # F14b: Err->Value() must panic, never silently return a zero value.
            if projectKind == coreir.BodyResultProjectValueStrTag:
                if !PrimaryBodyIrAppendResultValuePanicGuard(bodyIR,
                                                             slotNames,
                                                             sourceSlot,
                                                             valueErrMsgOffset,
                                                             24,
                                                             callOrdinal):
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 61,
                                                 projectKind)
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    nextOpIndex = nextOpIndex + 1
                    continue
            if !PrimaryBodyIrDispatchResultIntrinsicStatementOp(
                bodyIR,
                slotNames,
                lowering.typedIr,
                typedFn,
                irFunction,
                stmt,
                targetSlot,
                projectOffset,
                projectByteCount,
                structuredResultIntrinsicConsumeCountOut
            ):
                nextOpIndex = nextOpIndex + 1
                continue
            nextOpIndex = nextOpIndex + 1
        elif stmt.kind == texpr.TypedExprIrStmtLetCall:
            if traceEnabled:
                PrimaryObjectPlanTrace(Fmt"phase=let_call_enter function={typedFn.functionName} line={stmt.lineNumber} binding={stmt.bindingName} target={stmt.callTarget} callee={stmt.callCallee} result={stmt.resultType} surface={stmt.surfaceText}")
            if PrimaryBodyIrHasPreviousDuplicateWholeLetCall(irFunction.statements, stmtIndex):
                PrimaryBodyIrNodeEvalOnlyOwn()
                nextOpIndex = nextOpIndex + 1
                continue
            var letCallLineHasReturn = false
            for lineStmtIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                let lineStmtIndex = sameLineOrder[lineStmtIndexP]
                let lineStmt = irFunction.statements[lineStmtIndex]
                if lineStmt.kind == texpr.TypedExprIrStmtReturn:
                    letCallLineHasReturn = true
                    break
            if letCallLineHasReturn:
                nextOpIndex = nextOpIndex + 1
                continue
            var slotId: int32 = -1
            # Deref let twin (let x: uint8 = *(UInt8Ptr(call(...)))): the LocalDecl
            # twin carries the deref surface; this LetCall must emit the call into
            # a ptr temp and deref into the declared-type binding slot.
            var letCallDerefWidth: int32
            if len(stmt.bindingName) > 0:
                for letCallDerefScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let letCallDerefScan = sameLineOrder[letCallDerefScanP]
                    let letCallDerefStmt = irFunction.statements[letCallDerefScan]
                    if letCallDerefStmt.kind == texpr.TypedExprIrStmtLocalDecl &&
                       letCallDerefStmt.bindingName == stmt.bindingName:
                        var letCallDerefSurface = strutil.Strip(letCallDerefStmt.surfaceText)
                        var letCallDerefCastInner = PrimaryBodyIrTypeCastInnerForTarget(letCallDerefSurface, "int32")
                        if letCallDerefCastInner == "":
                            letCallDerefCastInner = PrimaryBodyIrTypeCastInnerForTarget(letCallDerefSurface, "uint8")
                        if letCallDerefCastInner != "":
                            letCallDerefSurface = strutil.Strip(letCallDerefCastInner)
                        if PrimaryBodyIrUInt8PtrDerefPointerText(letCallDerefSurface) != "":
                            letCallDerefWidth = 1
                        elif PrimaryBodyIrI32PtrDerefPointerText(letCallDerefSurface) != "":
                            letCallDerefWidth = 4
                        break
            if len(stmt.bindingName) > 0:
                var resultTypeText = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
                var letCallF64FromIntMismatch = false
                if letCallDerefWidth > 0:
                    var letCallDerefBindingType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                                  typedFn,
                                                                                  irFunction,
                                                                                  stmt.lineNumber,
                                                                                  stmt.bindingName)
                    if letCallDerefBindingType == "" ||
                       PrimaryBodyIrTypeKindFromText(letCallDerefBindingType) != coreir.LocalI32Tag:
                        letCallDerefBindingType = "int32"
                    resultTypeText = letCallDerefBindingType
                if resultTypeText != "str":
                    for conditionStmtIndex in 0..<stmtEnd:
                        let conditionStmt = irFunction.statements[conditionStmtIndex]
                        if conditionStmt.lineNumber <= stmt.lineNumber:
                            continue
                        if conditionStmt.kind != texpr.TypedExprIrStmtIf &&
                           conditionStmt.kind != texpr.TypedExprIrStmtElif:
                            continue
                        if conditionStmt.conditionKind != texpr.TypedExprIrCondStrEqLiteral &&
                           conditionStmt.conditionKind != texpr.TypedExprIrCondStrNeLiteral:
                            continue
                        if conditionStmt.conditionLhsText == stmt.bindingName:
                            resultTypeText = "str"
                            break
                if resultTypeText != "str":
                    # Cast-wrapped let-call (let x = int32(f())): the LetCall twin
                    # loses the cast head, so the binding slot must use the declared
                    # binding type; the call result store narrows by slot width.
                    let declaredBindingType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                              typedFn,
                                                                              irFunction,
                                                                              stmt.lineNumber,
                                                                              stmt.bindingName)
                    if declaredBindingType != "" && declaredBindingType != resultTypeText:
                        let declaredBindingKind = PrimaryBodyIrTypeKindFromText(declaredBindingType)
                        let callResultKind = PrimaryBodyIrTypeKindFromText(resultTypeText)
                        var declaredBindingCtorHead = stmt.callTarget
                        if declaredBindingCtorHead == "":
                            declaredBindingCtorHead = stmt.callCallee
                        let declaredBindingIsCtor = PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr,
                                                                                                 stmt.sourcePath,
                                                                                                 declaredBindingCtorHead)
                        if declaredBindingKind == coreir.LocalAggregateTag &&
                           (callResultKind != coreir.LocalAggregateTag || declaredBindingIsCtor):
                            resultTypeText = declaredBindingType
                        elif (declaredBindingKind == coreir.LocalI32Tag ||
                              declaredBindingKind == coreir.LocalI64Tag) &&
                           (callResultKind == coreir.LocalI32Tag ||
                            callResultKind == coreir.LocalI64Tag) &&
                           declaredBindingKind != callResultKind:
                            resultTypeText = declaredBindingType
                    # #95 wave5 新发现(与豁免门/SCVTF 缺陷同源, 不同子系统,
                    # 实测发现): `let f: float64 = float64(realCall())`——"整调用
                    # 实参是嵌套真实调用"的形态在 typed_expr 前端被拆成
                    # let_call(target=真实callee)+local_decl(surface=
                    # "float64(...)") 双语句, 且两条语句同 lineNumber——上面的
                    # declaredBindingType 查找(PrimaryBodyIrBindingTypeForName)
                    # 严格要求候选声明行号 < 查询行号, 同行声明必然查不到
                    # (declaredBindingType=="" 恒真), 上面的 if 分支对本形态从不
                    # 命中。但 LetCall 语句自身的 stmt.resultType 字段(见
                    # let_call_enter trace 的 result= 字段)已经原样携带外层声明
                    # 类型文本, 不依赖跨行查找。既有 I32<->I64 narrow 分支假设
                    # "仅重定形槽, 调用结果存储天然按宽度截断安全"对纯整型成立,
                    # 但对 int->float64 不成立: 需要真 SCVTF/UCVTF 转换指令,
                    # 不是单纯改存储宽度——裸重定形只会把整型返回值原始位当
                    # float64 位重解读(与 wave4 finding1 同一错误类别, 实测 cc
                    # 真链接+真运行值确认: getN() 返回 5 被读成一个微小的
                    # subnormal float64, 非 5.0)。此处无法安全接通真转换(需要
                    # 下游 call-result-store fill 机制配合按 SCVTF/UCVTF 内联
                    # 发射, 超出本轮 provenance/signedness 授权范围), 诚实
                    # poison 而非静默留槽为 int32(今天的真实缺陷)或改定形成
                    # float64 却不转换(同样错误, 只是搬家)。
                    let letCallStmtResultKind = PrimaryBodyIrTypeKindFromText(stmt.resultType)
                    let letCallCalleeResultKind = PrimaryBodyIrTypeKindFromText(resultTypeText)
                    if letCallStmtResultKind == coreir.LocalF64Tag &&
                       (letCallCalleeResultKind == coreir.LocalI32Tag ||
                        letCallCalleeResultKind == coreir.LocalI64Tag):
                        letCallF64FromIntMismatch = true
                if letCallF64FromIntMismatch:
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=let_call_f64_from_int_mismatch_poison function={typedFn.functionName} line={stmt.lineNumber} binding={stmt.bindingName}")
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 818,
                                                 0)
                    nextOpIndex = nextOpIndex + 1
                    continue
                slotId = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                            slotNames,
                                                            lowering.typedIr,
                                                            PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                            stmt.bindingName,
                                                            resultTypeText)
                # Postfix chain over a whole call (`let n = f(...).len` / `.field` /
                # `[i]`): the LetCall classifier sized the slot from the leading call's
                # aggregate/str return type, but the binding is the scalar the postfix
                # reduces to (str[].len -> int32). The binding-type lookup also infers
                # the aggregate (it sees the call), so the scalar can only be recovered
                # from the node-tree twin's root result type. When a same-line decl/
                # assign twin carries a FieldGet/IndexGet-over-call tree whose result is
                # a concrete scalar, retype the binding slot to that scalar so the i32/
                # i64 store-shape readiness check passes (FindOrCreateSlotSized converts
                # the existing aggregate slot in place). No effect on plain aggregate
                # let-calls — they have no scalar-rooted twin.
                if slotId >= 0 && slotId < bodyIR.localSlots.len:
                    var letCallSlotRetypeTreeIndex: int32 = -1
                    for letCallSlotScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                        let letCallSlotScan = sameLineOrder[letCallSlotScanP]
                        let letCallSlotStmt = irFunction.statements[letCallSlotScan]
                        if (letCallSlotStmt.kind == texpr.TypedExprIrStmtLocalDecl ||
                            letCallSlotStmt.kind == texpr.TypedExprIrStmtAssign) &&
                           letCallSlotStmt.bindingName == stmt.bindingName &&
                           letCallSlotStmt.rhsNodeIndex >= 0 &&
                           letCallSlotStmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                           lowering.typedIr.nodes2_opKinds[letCallSlotStmt.rhsNodeIndex] != texpr.TypedExprIrOpCallExpr &&
                           PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, letCallSlotStmt.rhsNodeIndex):
                            letCallSlotRetypeTreeIndex = letCallSlotStmt.rhsNodeIndex
                            break
                    if letCallSlotRetypeTreeIndex >= 0:
                        let lcsrtRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_resultTypeIds[letCallSlotRetypeTreeIndex])
                        # form59 residual: hoist Value(Result[str]) before StripVarType
                        let lcsrt_f59: str = Value(lcsrtRes)
                        let letCallSlotNodeType = texpr.TypedExprStripVarType(lcsrt_f59)
                        let letCallSlotNodeKind = PrimaryBodyIrTypeKindFromText(letCallSlotNodeType)
                        let letCallSlotCurrentKind = PrimaryBodyIrSlotType(bodyIR, slotId)
                        if (letCallSlotNodeKind == coreir.LocalI32Tag ||
                            letCallSlotNodeKind == coreir.LocalI64Tag ||
                            letCallSlotNodeKind == coreir.LocalF64Tag ||
                            letCallSlotNodeKind == coreir.LocalStrTag) &&
                           letCallSlotCurrentKind != letCallSlotNodeKind:
                            slotId = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                        slotNames,
                                                                        lowering.typedIr,
                                                                        PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                                        stmt.bindingName,
                                                                        letCallSlotNodeType)
                if traceEnabled:
                    PrimaryObjectPlanTrace(Fmt"phase=let_call_slot function={typedFn.functionName} line={stmt.lineNumber} binding={stmt.bindingName} result={resultTypeText} slot={slotId}")
            # 批次6b：letcall 行的面是"调用+尾部表达式"（var x = F(a) + 1）
            # 时文本路径只降调用、尾部静默丢弃。same-line 孪生 decl/assign
            # 行（已让位）携带完整 rhs 节点树（根非纯 CallExpr 且含调用）
            # 且探针可降时，整树经节点路径降入绑定槽并消费本行。
            var letCallNodeTreeIndex: int32 = -1
            var letCallTwinSurfaceText = ""
            if slotId >= 0 &&
               slotId < bodyIR.localSlots.len &&
               len(stmt.bindingName) > 0 &&
               !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotId]) &&
               PrimaryBodyIrVarParamPointeeKind(bodyIR, slotId) == coreir.LocalInvalidTag:
                for letCallNodeScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let letCallNodeScan = sameLineOrder[letCallNodeScanP]
                    let letCallNodeStmt = irFunction.statements[letCallNodeScan]
                    if (letCallNodeStmt.kind == texpr.TypedExprIrStmtLocalDecl ||
                        letCallNodeStmt.kind == texpr.TypedExprIrStmtAssign) &&
                       letCallNodeStmt.bindingName == stmt.bindingName &&
                       letCallNodeStmt.rhsNodeIndex >= 0 &&
                       letCallNodeStmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                       lowering.typedIr.nodes2_opKinds[letCallNodeStmt.rhsNodeIndex] != texpr.TypedExprIrOpCallExpr &&
                       PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, letCallNodeStmt.rhsNodeIndex):
                        letCallNodeTreeIndex = letCallNodeStmt.rhsNodeIndex
                        letCallTwinSurfaceText = strutil.Strip(letCallNodeStmt.surfaceText)
                        break
            # `let r = a && f()` / `let r = a || f()` with a call in the RHS: the
            # twin decl carries the whole short-circuit tree (root is log_and /
            # log_or, not a CallExpr). Node-eval of that tree runs the call operand
            # eagerly and bitwise-combines (the `false && bump(true)` miscompile —
            # bump ran even though `false &&` short-circuits). Materialize the bool
            # via the CBR-chain assigner so the call operand only runs in the block
            # that the short-circuit actually reaches. Mirrors the plain-assign gate
            # (AppendI32Assign:25095) and consumes the line on success.
            if letCallNodeTreeIndex >= 0 &&
               letCallTwinSurfaceText != "" &&
               PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI32Tag &&
               (PrimaryBodyIrConditionHasAnd(letCallTwinSurfaceText) ||
                PrimaryBodyIrConditionHasOr(letCallTwinSurfaceText)):
                var letCallBoolBlockStart: int32
                letCallBoolBlockStart = currentBlockStart
                if PrimaryBodyIrAppendBoolConditionAssign(bodyIR,
                                                          slotNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          stmt.sourcePath,
                                                          stmt.lineNumber,
                                                          letCallTwinSurfaceText,
                                                          slotId,
                                                          callOrdinal,
                                                          letCallBoolBlockStart):
                    currentBlockStart = letCallBoolBlockStart
                    nextOpIndex = nextOpIndex + 1
                    continue
            if letCallNodeTreeIndex >= 0:
                primaryBodyIrNodeEvalMissOp = ""
                let letCallSlotKind = PrimaryBodyIrSlotType(bodyIR, slotId)
                var letCallNodeReady = false
                let letCallProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,

                                                                  share(typedFn),
                                                                  irFunction,
                                                                  letCallNodeTreeIndex)
                if letCallProbeKind >= 0:
                    if letCallSlotKind == coreir.LocalStrTag:
                        letCallNodeReady = letCallProbeKind == coreir.LocalStrTag
                    elif letCallSlotKind == coreir.LocalI32Tag:
                        letCallNodeReady = letCallProbeKind == coreir.LocalI32Tag
                    elif letCallSlotKind == coreir.LocalI64Tag:
                        letCallNodeReady = letCallProbeKind == coreir.LocalI32Tag ||
                                           letCallProbeKind == coreir.LocalI64Tag
                    elif letCallSlotKind == coreir.LocalF64Tag:
                        letCallNodeReady = letCallProbeKind == coreir.LocalF64Tag
                let letCallEmitMark = primaryBodyIrNodeEvalCallEmitCount
                var letCallNodeStored = false
                if letCallNodeReady:
                    let letCallNodeValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,

                                                                     share(typedFn),
                                                                     irFunction,
                                                                     letCallNodeTreeIndex,
                                                                     callOrdinal)
                    if letCallNodeValueSlot >= 0:
                        letCallNodeStored = PrimaryBodyIrNodeEvalStore(bodyIR,
                                                                       slotNames,
                                                                       slotId,
                                                                       letCallNodeValueSlot)
                if letCallNodeStored:
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit function={typedFn.functionName} line={stmt.lineNumber}")
                    nextOpIndex = nextOpIndex + 1
                    continue
                if primaryBodyIrNodeEvalCallEmitCount != letCallEmitMark:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 0)
                    nextOpIndex = nextOpIndex + 1
                    continue
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    var letCallMissOpText = primaryBodyIrNodeEvalMissOp
                    if letCallMissOpText == "":
                        letCallMissOpText = "letcall_tail_shape"
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={letCallMissOpText} function={typedFn.functionName} line={stmt.lineNumber}")
            var letCallRootCastIndex: int32 = -1
            if slotId >= 0 &&
               slotId < bodyIR.localSlots.len &&
               len(stmt.bindingName) > 0 &&
               !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotId]) &&
               PrimaryBodyIrVarParamPointeeKind(bodyIR, slotId) == coreir.LocalInvalidTag:
                var letCallRootRhsLit = ""
                if stmt.rhsNodeIndex >= 0 && stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                    let lcrLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[stmt.rhsNodeIndex])
                    if IsOk(lcrLitRes):
                        letCallRootRhsLit = Value(lcrLitRes)
                if stmt.rhsNodeIndex >= 0 &&
                   stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                   PrimaryBodyIrCastCallTargetKind(letCallRootRhsLit) != coreir.LocalInvalidTag &&
                   PrimaryBodyIrCastCallArgNodeIndex(lowering.typedIr, stmt.rhsNodeIndex) >= 0:
                    letCallRootCastIndex = stmt.rhsNodeIndex
                if letCallRootCastIndex < 0:
                    for letCallCastScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                        let letCallCastScan = sameLineOrder[letCallCastScanP]
                        let letCallCastStmt = irFunction.statements[letCallCastScan]
                        var castRhsLit = ""
                        if letCallCastStmt.rhsNodeIndex >= 0 && letCallCastStmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                            let castRhsLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[letCallCastStmt.rhsNodeIndex])
                            if IsOk(castRhsLitRes):
                                castRhsLit = Value(castRhsLitRes)
                        if (letCallCastStmt.kind == texpr.TypedExprIrStmtLocalDecl ||
                            letCallCastStmt.kind == texpr.TypedExprIrStmtAssign) &&
                           letCallCastStmt.bindingName == stmt.bindingName &&
                           letCallCastStmt.rhsNodeIndex >= 0 &&
                           letCallCastStmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                           PrimaryBodyIrCastCallTargetKind(castRhsLit) != coreir.LocalInvalidTag &&
                           PrimaryBodyIrCastCallArgNodeIndex(lowering.typedIr, letCallCastStmt.rhsNodeIndex) >= 0:
                            letCallRootCastIndex = letCallCastStmt.rhsNodeIndex
                            break
            if letCallRootCastIndex >= 0:
                primaryBodyIrNodeEvalMissOp = ""
                let letCallCastSlotKind = PrimaryBodyIrSlotType(bodyIR, slotId)
                let letCallCastProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      lowering,

                                                                      share(typedFn),
                                                                      irFunction,
                                                                      letCallRootCastIndex)
                var letCallCastReady = false
                if letCallCastProbeKind == coreir.LocalI32Tag:
                    letCallCastReady = letCallCastSlotKind == coreir.LocalI32Tag
                elif letCallCastProbeKind == coreir.LocalI64Tag:
                    letCallCastReady = letCallCastSlotKind == coreir.LocalI32Tag ||
                                       letCallCastSlotKind == coreir.LocalI64Tag
                elif letCallCastProbeKind == coreir.LocalF64Tag:
                    letCallCastReady = letCallCastSlotKind == coreir.LocalF64Tag
                let letCallCastEmitMark = primaryBodyIrNodeEvalCallEmitCount
                var letCallCastStored = false
                if letCallCastReady:
                    let letCallCastValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,

                                                                     share(typedFn),
                                                                     irFunction,
                                                                     letCallRootCastIndex,
                                                                     callOrdinal)
                    if letCallCastValueSlot >= 0:
                        let letCallCastValueKind = PrimaryBodyIrSlotType(bodyIR, letCallCastValueSlot)
                        if letCallCastSlotKind == coreir.LocalI32Tag &&
                           letCallCastValueKind == coreir.LocalI64Tag:
                            # cast 产 i64 值、绑定槽是 i32(readiness 31291 已放行此收窄:
                            # `let x = int64(intrinsic-i32-call)` 的值本 fits i32 无损)。
                            # NodeEvalStore 无标量收窄分支会落 store_shape_l1_v6,故此处
                            # 直接 CopyLocal 存低 32 位(与文本路径 i64→i32 绑定同款)。
                            var letCallCastCopyOp: coreir.BodyOp
                            letCallCastCopyOp.kind = coreir.BodyOpCopyLocalTag
                            letCallCastCopyOp.target = slotId
                            add(letCallCastCopyOp.operands, letCallCastValueSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, letCallCastCopyOp)
                            letCallCastStored = true
                        else:
                            letCallCastStored = PrimaryBodyIrNodeEvalStore(bodyIR,
                                                                           slotNames,
                                                                           slotId,
                                                                           letCallCastValueSlot)
                if letCallCastStored:
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    nextOpIndex = nextOpIndex + 1
                    continue
                if primaryBodyIrNodeEvalCallEmitCount != letCallCastEmitMark:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 0)
                    nextOpIndex = nextOpIndex + 1
                    continue
            let targetStr = stmt.callTarget
            if PrimaryObjectCallTargetIsPureCast(targetStr):
                if slotId >= 0 && stmt.callArgCount == 1:
                    let castResultType = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
                    let castTypeKind = PrimaryBodyIrTypeKindFromText(castResultType)
                    var castValueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                                  slotNames,
                                                                                  varI32ParamNames,
                                                                                  lowering.typedIr,
                                                                                  share(typedFn),
                                                                                  irFunction,
                                                                                  stmt.sourcePath,
                                                                                  stmt.lineNumber,
                                                                                  stmt.callArgsText,
                                                                                  castTypeKind)
                    if castValueSlot < 0 && castTypeKind == coreir.LocalI32Tag:
                        castValueSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                                   slotNames,
                                                                                   varI32ParamNames,
                                                                                   lowering.typedIr,
                                                                                   share(typedFn),
                                                                                   irFunction,
                                                                                   stmt.sourcePath,
                                                                                   stmt.lineNumber,
                                                                                   stmt.callArgsText,
                                                                                   coreir.LocalI64Tag)
                    if castValueSlot >= 0:
                        if castValueSlot != slotId:
                            var castCopyOp: coreir.BodyOp
                            castCopyOp.kind = coreir.BodyOpCopyLocalTag
                            castCopyOp.target = slotId
                            add(castCopyOp.operands, castValueSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, castCopyOp)
                        nextOpIndex = nextOpIndex + 1
                        continue
                continue
            if slotId >= 0 &&
               slotId < bodyIR.localSlots.len &&
               PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalAggregateTag &&
               !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotId]) &&
               PrimaryBodyIrVarParamPointeeKind(bodyIR, slotId) == coreir.LocalInvalidTag:
                var letCallCtorHead = targetStr
                if letCallCtorHead == "":
                    letCallCtorHead = stmt.callCallee
                if PrimaryBodyIrCallHeadIsAggregateConstructor(lowering.typedIr, stmt.sourcePath, letCallCtorHead):
                    var letCallCtorType = PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                                          typedFn,
                                                                          irFunction,
                                                                          stmt.lineNumber,
                                                                          stmt.bindingName)
                    if letCallCtorType == "":
                        letCallCtorType = letCallCtorHead
                    if PrimaryBodyIrAppendAggregateConstructorToSlot(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,

                                                                     typedFn,
                                                                     irFunction,
                                                                     PrimaryBodyIrCallFullText(stmt),
                                                                     stmt.rhsNodeIndex,
                                                                     letCallCtorType,
                                                                     stmt.sourcePath,
                                                                     stmt.lineNumber,
                                                                     slotId,
                                                                     stmt.lineNumber,
                                                                     callOrdinal):
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=let_call_agg_ctor function={typedFn.functionName} line={stmt.lineNumber}")
                        nextOpIndex = nextOpIndex + 1
                        continue
            # 标量三元 `let x = cond ? a : f()`(i32/i64)：let_call 孪生把 callTarget
            # 当成被选中臂的调用，真正的三元体在同行 local_decl/assign 孪生上
            # (assignValueOpKind=LocalBoolEnumTernary，surfaceText 完整三元)。找到孪生
            # 即用其完整 surface 路由到真分支下降——只执行被选中臂，根除"急切两臂求值"
            # miscompile(未被选中臂的调用不再无条件执行、不冲掉 cond 槽)。
            if slotId >= 0 &&
               len(stmt.bindingName) > 0 &&
               (PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI32Tag ||
                PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI64Tag ||
                PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalF64Tag):
                var letCallScalarTernText = ""
                var letCallScalarTernNodeIndex: int32 = -1
                for letCallScalarTernScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let letCallScalarTernScan = sameLineOrder[letCallScalarTernScanP]
                    let letCallScalarTernTwin = irFunction.statements[letCallScalarTernScan]
                    if letCallScalarTernTwin.bindingName == stmt.bindingName &&
                       letCallScalarTernTwin.assignValueOpKind == texpr.TypedExprIrOpLocalBoolEnumTernary &&
                       texpr.TypedExprFindTopLevelTextToken(strutil.Strip(letCallScalarTernTwin.surfaceText), "?") > 0 &&
                       PrimaryBodyIrTextHasRealCallSurface(strutil.Strip(letCallScalarTernTwin.surfaceText)):
                        letCallScalarTernText = strutil.Strip(letCallScalarTernTwin.surfaceText)
                        letCallScalarTernNodeIndex = letCallScalarTernTwin.rhsNodeIndex
                        break
                if letCallScalarTernText != "" &&
                   PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering,

                                                              typedFn,
                                                              irFunction,
                                                              stmt.sourcePath,
                                                              stmt.lineNumber,
                                                              letCallScalarTernNodeIndex,
                                                              letCallScalarTernText,
                                                              slotId,
                                                              PrimaryBodyIrSlotType(bodyIR, slotId),
                                                              callOrdinal,
                                                              currentBlockStart):
                    nextOpIndex = nextOpIndex + 1
                    continue
            # str 三元 `let x = Len(s) > 0 ? a : b`：let_call 孪生把 callTarget 当成 Len，
            # 而真正的三元体在同行 local_decl 孪生上（assignValueOpKind=LocalBoolEnumTernary，
            # surfaceText 是完整三元，arms 在 assignValue*/conditionRhsText）。slotId 此时已
            # 按绑定真实类型 str 建好；找到该孪生即用其完整 surface 路由到 str 三元 select
            # 处理器（条件 Len(s)>0 由 EmitConditionOps 正常下降），而不是当成 Len 取长度。
            if slotId >= 0 &&
               len(stmt.bindingName) > 0 &&
               PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalStrTag:
                var letCallStrTernText = ""
                var letCallStrTernNodeIndex: int32 = -1
                for letCallStrTernScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let letCallStrTernScan = sameLineOrder[letCallStrTernScanP]
                    let letCallStrTernTwin = irFunction.statements[letCallStrTernScan]
                    if letCallStrTernTwin.bindingName == stmt.bindingName &&
                       letCallStrTernTwin.assignValueOpKind == texpr.TypedExprIrOpLocalBoolEnumTernary &&
                       texpr.TypedExprFindTopLevelTextToken(strutil.Strip(letCallStrTernTwin.surfaceText), "?") > 0:
                        letCallStrTernText = strutil.Strip(letCallStrTernTwin.surfaceText)
                        letCallStrTernNodeIndex =
                            letCallStrTernTwin.rhsNodeIndex
                        break
                if letCallStrTernText != "" &&
                   PrimaryBodyIrAppendStrTernaryDeclValue(bodyIR,
                                                          slotNames,
                                                          varI32ParamNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          stmt,
                                                          letCallStrTernNodeIndex,
                                                          letCallStrTernText,
                                                          slotId,
                                                          callOrdinal,
                                                          currentBlockStart):
                    nextOpIndex = nextOpIndex + 1
                    continue
            if slotId >= 0 &&
               stmt.callArgCount == 1 &&
               PrimaryBodyIrCallTargetIsLen(stmt.callCallee,
                                            stmt.callTarget,
                                            stmt.surfaceText):
                if !PrimaryBodyIrAppendStrLenArgValue(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      lowering.typedIr,
                                                      typedFn,
                                                      irFunction,
                                                      stmt.sourcePath,
                                                      stmt.lineNumber,
                                                      stmt.callArgsText,
                                                      slotId):
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 622,
                                                 0)
                else:
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=let_call_strlen function={typedFn.functionName} line={stmt.lineNumber}")
                nextOpIndex = nextOpIndex + 1
                continue
            if stmt.callCallee == "StrDataPtr" ||
               stmt.callCallee == "RawmemAsVoid" ||
               stmt.callTarget == "StrDataPtr" ||
               stmt.callTarget == "RawmemAsVoid" ||
               PrimaryCallTargetTailName(stmt.callTarget) == "StrDataPtr" ||
               PrimaryCallTargetTailName(stmt.callTarget) == "RawmemAsVoid" ||
               stmt.surfaceText == "StrDataPtr" ||
               stmt.surfaceText == "RawmemAsVoid":
                var strDataArgText = stmt.callArgsText
                var strDataIndexRoot = ""
                var strDataIndexText = ""
                if PrimaryBodyIrIndexExprParts(stmt.callArgsText,
                                               strDataIndexRoot,
                                               strDataIndexText):
                    let strDataRootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, strDataIndexRoot)
                    if strDataRootSlot >= 0 &&
                       strDataRootSlot < bodyIR.localSlots.len &&
                       bodyIR.localSlots[strDataRootSlot].typeKind == coreir.LocalAggregateTag:
                        let strDataIndexSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                                         slotNames,
                                                                                         varI32ParamNames,
                                                                                         lowering.typedIr,
                                                                                         share(typedFn),
                                                                                         irFunction,
                                                                                         stmt.sourcePath,
                                                                                         stmt.lineNumber,
                                                                                         strDataIndexText,
                                                                                         coreir.LocalI32Tag)
                        let strDataValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                             slotNames,
                                                                             stmt.callArgsText,
                                                                             coreir.LocalStrTag)
                        if strDataIndexSlot >= 0 && strDataValueSlot >= 0:
                            var strDataLoadOp: coreir.BodyOp
                            strDataLoadOp.kind = coreir.BodyOpIndexedLoadTag
                            strDataLoadOp.target = strDataValueSlot
                            add(strDataLoadOp.operands, strDataRootSlot)
                            add(strDataLoadOp.operands, strDataValueSlot)
                            add(strDataLoadOp.operands, strDataIndexSlot)
                            add(strDataLoadOp.operands, 24)
                            add(strDataLoadOp.operands, 1)
                            let _ = coreir.BodyIRAppendOp(bodyIR, strDataLoadOp)
                            strDataArgText = stmt.callArgsText
                var strDataPtrOk = false
                if stmt.callCallee == "RawmemAsVoid" ||
                   stmt.callTarget == "RawmemAsVoid" ||
                   PrimaryCallTargetTailName(stmt.callTarget) == "RawmemAsVoid" ||
                   stmt.surfaceText == "RawmemAsVoid":
                    strDataPtrOk = PrimaryBodyIrAppendRawmemAsVoidValue(bodyIR,
                                                                        slotNames,
                                                                        strDataArgText,
                                                                        slotId)
                else:
                    strDataPtrOk = PrimaryBodyIrAppendStrDataPtrValue(bodyIR,
                                                                      slotNames,
                                                                      strDataArgText,
                                                                      slotId)
                if !strDataPtrOk:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 621,
                                                 0)
                else:
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=let_call_strdataptr function={typedFn.functionName} line={stmt.lineNumber}")
                nextOpIndex = nextOpIndex + 1
                continue
            if letCallDerefWidth > 0 &&
               slotId >= 0 &&
               len(targetStr) > 0 &&
               !PrimaryObjectCallTargetIsPureCast(targetStr):
                let letCallDerefPtrSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                        slotNames,
                                                                        Fmt"{stmt.bindingName}#deref_ptr#{stmt.lineNumber}",
                                                                        coreir.LocalPtrTag)
                if letCallDerefPtrSlot >= 0:
                    let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                      slotNames,
                                                      lowering,

                                                      typedFn,
                                                      irFunction,
                                                      stmt,
                                                      letCallDerefPtrSlot,
                                                      varI32ParamNames,
                                                      callOrdinal,
                                                      currentBlockStart)
                    var letCallDerefOp: coreir.BodyOp
                    letCallDerefOp.kind = coreir.BodyOpLoadLocalTag
                    letCallDerefOp.target = slotId
                    if letCallDerefWidth == 1:
                        add(letCallDerefOp.operands, coreir.BodyLoadLocalPtrDerefU8Tag)
                    else:
                        add(letCallDerefOp.operands, coreir.BodyLoadLocalPtrDerefI32Tag)
                    add(letCallDerefOp.operands, letCallDerefPtrSlot)
                    add(letCallDerefOp.operands, letCallDerefWidth)
                    let _ = coreir.BodyIRAppendOp(bodyIR, letCallDerefOp)
                    nextOpIndex = nextOpIndex + 1
                    continue
            if len(targetStr) > 0 &&
               !PrimaryObjectCallTargetIsPureCast(targetStr) &&
               slotId >= 0 &&
               slotId < bodyIR.localSlots.len &&
               stmt.rhsNodeIndex >= 0 &&
               stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
               lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpCallExpr &&
               !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[slotId]) &&
               PrimaryBodyIrVarParamPointeeKind(bodyIR, slotId) == coreir.LocalInvalidTag:
                primaryBodyIrNodeEvalMissOp = ""
                let letCallExprSlotKind = PrimaryBodyIrSlotType(bodyIR, slotId)
                let letCallExprProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      lowering,

                                                                      share(typedFn),
                                                                      irFunction,
                                                                      stmt.rhsNodeIndex)
                var letCallExprReady = false
                if letCallExprProbeKind >= 0:
                    if letCallExprSlotKind == coreir.LocalStrTag:
                        letCallExprReady = letCallExprProbeKind == coreir.LocalStrTag
                    elif letCallExprSlotKind == coreir.LocalI32Tag:
                        # 探针对跨模块标量返回 call 保守把结果定成 I64(probeKind=6,
                        # 对真返 i32 的 bytesLen/elfAlign 亦然);而绑定槽 kind(来自
                        # 绑定类型推断)是权威类型——`let x = BytesLen(buf)` 的 x 实为
                        # i32。AppendCallExprNodeToSlot 按槽 kind 存(i32 槽存结果寄存器
                        # 低 32 位=正确收窄,与文本路径 i64→i32 绑定同款)。故 I32 槽
                        # 接受 I64 探针,镜像下方 I64 槽接受 I32 widening 的对称放行,
                        # 否则 `let textSize = BytesLen(...)` 整条落 letcall_call_shape。
                        letCallExprReady = letCallExprProbeKind == coreir.LocalI32Tag ||
                                           letCallExprProbeKind == coreir.LocalI64Tag
                    elif letCallExprSlotKind == coreir.LocalI64Tag:
                        letCallExprReady = letCallExprProbeKind == coreir.LocalI32Tag ||
                                           letCallExprProbeKind == coreir.LocalI64Tag
                    elif letCallExprSlotKind == coreir.LocalF64Tag:
                        letCallExprReady = letCallExprProbeKind == coreir.LocalF64Tag
                    elif letCallExprSlotKind == coreir.LocalPtrTag:
                        letCallExprReady = letCallExprProbeKind == coreir.LocalPtrTag ||
                                           letCallExprProbeKind == coreir.LocalI64Tag
                    elif letCallExprSlotKind == coreir.LocalAggregateTag:
                        letCallExprReady = letCallExprProbeKind == coreir.LocalAggregateTag
                let letCallExprEmitMark = primaryBodyIrNodeEvalCallEmitCount
                var letCallExprDone = false
                if letCallExprReady:
                    letCallExprDone = PrimaryBodyIrAppendCallExprNodeToSlot(bodyIR,
                                                                            slotNames,
                                                                            lowering,

                                                                            typedFn,
                                                                            irFunction,
                                                                            varI32ParamNames,
                                                                            stmt.rhsNodeIndex,
                                                                            slotId,
                                                                            stmt.lineNumber,
                                                                            callOrdinal)
                if letCallExprDone:
                    nextOpIndex = nextOpIndex + 1
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=let_call function={typedFn.functionName} line={stmt.lineNumber}")
                    continue
                if primaryBodyIrNodeEvalCallEmitCount != letCallExprEmitMark:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 0)
                    nextOpIndex = nextOpIndex + 1
                    continue
                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                    var letCallExprMissOpText = primaryBodyIrNodeEvalMissOp
                    if letCallExprMissOpText == "":
                        letCallExprMissOpText = "letcall_call_shape"
                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={letCallExprMissOpText} entry=let_call function={typedFn.functionName} line={stmt.lineNumber}")
            # let_call 把 callTarget 设成内联算术表达式里的"第一个调用"(如
            # `let r = (c?f():g()) + (c?f():g())` 的 callTarget=f)，下面的
            # AppendCallOp 兜底只发首个调用、静默丢掉其余操作数与 `+`(广谱
            # miscompile)。同行 local_decl/assign 孪生携带**完整 surface**且
            # callTarget 为空；当该完整面根为顶层二元算术(非整调用)且含真调用
            # 时，经真分支臂值求值器(独立栈槽承载跨调用活值)整体降入 slotId，
            # 根除"内联三元-调用相加只返回左操作数"。
            if slotId >= 0 &&
               len(stmt.bindingName) > 0 &&
               (PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI32Tag ||
                PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI64Tag ||
                PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalF64Tag):
                var letCallBinSurface = ""
                var letCallBinNodeIndex: int32 = -1
                for letCallBinScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let letCallBinScan = sameLineOrder[letCallBinScanP]
                    let letCallBinTwin = irFunction.statements[letCallBinScan]
                    if letCallBinTwin.bindingName != stmt.bindingName:
                        continue
                    if letCallBinTwin.kind != texpr.TypedExprIrStmtLocalDecl &&
                       letCallBinTwin.kind != texpr.TypedExprIrStmtAssign:
                        continue
                    let letCallBinText = strutil.Strip(letCallBinTwin.surfaceText)
                    if letCallBinText == "":
                        continue
                    if !PrimaryBodyIrTextHasRealCallSurface(letCallBinText):
                        continue
                    if texpr.TypedExprFindTopLevelTextToken(letCallBinText, "?") > 0:
                        continue
                    let letCallBinStripped = PrimaryBodyIrStripOuterParens(letCallBinText)
                    if texpr.TypedExprFindTopLevelBitwiseTextToken(letCallBinStripped, "|") <= 0 &&
                       texpr.TypedExprFindTopLevelBitwiseTextToken(letCallBinStripped, "^") <= 0 &&
                       texpr.TypedExprFindTopLevelBitwiseTextToken(letCallBinStripped, "&") <= 0 &&
                       PrimaryBodyIrFindTopLevelBinOpTokenLast(letCallBinStripped, '+') <= 0 &&
                       PrimaryBodyIrFindTopLevelBinOpTokenLast(letCallBinStripped, '-') <= 0 &&
                       PrimaryBodyIrFindTopLevelBinOpTokenLast(letCallBinStripped, '*') <= 0 &&
                       PrimaryBodyIrFindTopLevelBinOpTokenLast(letCallBinStripped, '/') <= 0 &&
                       PrimaryBodyIrFindTopLevelBinOpTokenLast(letCallBinStripped, '%') <= 0:
                        continue
                    letCallBinSurface = letCallBinStripped
                    letCallBinNodeIndex = letCallBinTwin.rhsNodeIndex
                    break
                if letCallBinSurface != "" &&
                   PrimaryBodyIrAppendScalarTernaryArmValue(bodyIR,
                                                            slotNames,
                                                            varI32ParamNames,
                                                            lowering,

                                                            typedFn,
                                                            irFunction,
                                                            stmt.sourcePath,
                                                            stmt.lineNumber,
                                                            letCallBinNodeIndex,
                                                            letCallBinSurface,
                                                            slotId,
                                                            PrimaryBodyIrSlotType(bodyIR, slotId),
                                                            callOrdinal,
                                                            currentBlockStart):
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=let_call_bin_arith function={typedFn.functionName} line={stmt.lineNumber}")
                    nextOpIndex = nextOpIndex + 1
                    continue
            # `let r = f((cond ? call() : call()), ...)`：let_call 的 callTarget 取成
            # 三元臂里的内层调用，AppendCallOp 兜底只发首个内层调用、丢掉整个三元实
            # 参（外层调用首实参槽未写=栈垃圾，nested_ternary_call_arg）。同行孪生
            # decl/assign 携带完整外层调用面：把含真调用臂的三元实参以 CBR 块三元
            # （仅跑被选中臂）物化进临时槽、按名替换，再整调用下降入 slotId。
            if slotId >= 0 &&
               len(stmt.bindingName) > 0 &&
               (PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI32Tag ||
                PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalI64Tag ||
                PrimaryBodyIrSlotType(bodyIR, slotId) == coreir.LocalF64Tag):
                var letCallTernArgSurface = ""
                var letCallTernArgNodeIndex: int32 = -1
                for letCallTernScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let letCallTernScan = sameLineOrder[letCallTernScanP]
                    let letCallTernTwin = irFunction.statements[letCallTernScan]
                    if letCallTernTwin.bindingName != stmt.bindingName:
                        continue
                    if letCallTernTwin.kind != texpr.TypedExprIrStmtLocalDecl &&
                       letCallTernTwin.kind != texpr.TypedExprIrStmtAssign:
                        continue
                    let letCallTernText = strutil.Strip(letCallTernTwin.surfaceText)
                    if letCallTernText == "":
                        continue
                    if texpr.TypedExprFindTopLevelTextToken(letCallTernText, "?") > 0:
                        continue
                    letCallTernArgSurface = letCallTernText
                    letCallTernArgNodeIndex =
                        letCallTernTwin.rhsNodeIndex
                    break
                if letCallTernArgSurface != "":
                    var letCallTernArgChanged = false
                    let letCallTernArgRewritten = PrimaryBodyIrHoistCallArmedTernaryArgs(bodyIR,
                                                                                         slotNames,
                                                                                         varI32ParamNames,
                                                                                         lowering,

                                                                                         typedFn,
                                                                                         irFunction,
                                                                                         stmt.sourcePath,
                                                                                         stmt.lineNumber,
                                                                                         letCallTernArgNodeIndex,
                                                                                         letCallTernArgSurface,
                                                                                         callOrdinal,
                                                                                         currentBlockStart,
                                                                                         letCallTernArgChanged)
                    if letCallTernArgChanged &&
                       PrimaryBodyIrAppendWholeCallExprToSlot(bodyIR,
                                                              slotNames,
                                                              lowering,

                                                              typedFn,
                                                              irFunction,
                                                              varI32ParamNames,
                                                              letCallTernArgRewritten,
                                                              slotId,
                                                              stmt.lineNumber,
                                                              letCallTernArgNodeIndex,
                                                              callOrdinal):
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=let_call_tern_arg function={typedFn.functionName} line={stmt.lineNumber}")
                        nextOpIndex = nextOpIndex + 1
                        continue
            if len(targetStr) > 0 &&
               stmt.callArgCount == 0 &&
               slotId >= 0 &&
               PrimaryBodyIrAssignZeroConstructorMatches(bodyIR,
                                                         lowering.typedIr,
                                                         irFunction,
                                                         stmt.sourcePath,
                                                         PrimaryBodyIrCallFullText(stmt),
                                                         slotId) &&
               PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                slotNames,
                                                slotId,
                                                callOrdinal):
                nextOpIndex = nextOpIndex + 1
                continue
            if len(targetStr) > 0:
                if PrimaryObjectCallTargetIsPureCast(targetStr):
                    continue
                let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                  slotNames,
                                                  lowering,

                                                  typedFn,
                                                  irFunction,
                                                  stmt,
                                                  slotId,
                                                  varI32ParamNames,
                                                  callOrdinal,
                                                  currentBlockStart)
                nextOpIndex = nextOpIndex + 1
            else:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             62,
                                             0)
                nextOpIndex = nextOpIndex + 1
        elif stmt.kind == texpr.TypedExprIrStmtCall:
            if PrimaryBodyIrIntInList(callFeederEmittedIndexes, stmtIndex):
                PrimaryBodyIrNodeEvalOnlyOwn()
                continue
            if PrimaryBodyIrHasPreviousDuplicateWholeCall(irFunction.statements, stmtIndex):
                PrimaryBodyIrNodeEvalOnlyOwn()
                nextOpIndex = nextOpIndex + 1
                continue
            if stmt.callKind == texpr.TypedExprCallBuiltin &&
               (stmt.callCallee == "add" || stmt.callCallee == "Add"):
                var seqAddTypedContract: bool
                var seqAddNodeProbeHit: bool
                var seqAddTypeMismatch: bool
                let seqAddOutcome = PrimaryBodyIrAppendSeqGeneralAddBuiltin(bodyIR,
                                                                             slotNames,
                                                                             lowering,

                                                                             typedFn,
                                                                             irFunction,
                                                                             varI32ParamNames,
                                                                             stmt,
                                                                             callOrdinal,
                                                                             seqAddTypedContract,
                                                                             seqAddNodeProbeHit,
                                                                             seqAddTypeMismatch)
                let seqAddOwned = seqAddOutcome != PrimaryBodyIrSeqAddOutcomeNotOwned
                PrimaryBodyIrRecordSeqAddReceipt(PrimaryBodyIrNodeEvalOnlyActive(),
                                                 seqAddOutcome,
                                                 seqAddTypedContract,
                                                 seqAddNodeProbeHit,
                                                 seqAddTypeMismatch,
                                                 seqAddCandidateCountOut,
                                                 seqAddTypedContractCountOut,
                                                 structuredSeqAddConsumeCountOut,
                                                 seqAddNodeProbeHitCountOut,
                                                 seqAddTypeMismatchCountOut,
                                                 seqAddLegacyTextConsumeCountOut,
                                                 seqAddNodeEvalGapCountOut)
                if seqAddOwned:
                    PrimaryBodyIrNodeEvalOnlyOwn()
                if !seqAddOwned:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 631,
                                                 0)
                if seqAddNodeProbeHit:
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=seq_add function={typedFn.functionName} line={stmt.lineNumber}")
                elif !seqAddOwned:
                    let _ = PrimaryBodyIrNodeEvalMissAt("seq_add_emit")
                nextOpIndex = nextOpIndex + 1
                continue
            # seqs.Add(seq, val): the qualified std/seqs.cheng `Add` overload
            # resolves as a plain call (callKind != Builtin, callee/tail == "Add"),
            # unlike the lowercase `add` builtin. The cold path inlines the
            # seq-append builtin at the call site (stage3 output carries no
            # std_seqs symbol); mirror that here so the emit does not reference a
            # non-existent _std_seqs__Add symbol. Anchored on callTargetSourcePath
            # == std/seqs.cheng so a user-defined Add in another module is NOT
            # captured. The structured contract owns both successful lowering and
            # hard failure; only NotOwned may fall through to the generic call.
            if (stmt.callCallee == "Add" ||
                PrimaryCallTargetTailName(stmt.callTarget) == "Add") &&
               stmt.callArgCount == 2 &&
               strings.HasSuffix(stmt.callTargetSourcePath, "std/seqs.cheng"):
                var seqsAddTypedContract: bool
                var seqsAddNodeProbeHit: bool
                var seqsAddTypeMismatch: bool
                let seqsAddOutcome = PrimaryBodyIrAppendSeqGeneralAddBuiltin(bodyIR,
                                                                              slotNames,
                                                                              lowering,

                                                                              typedFn,
                                                                              irFunction,
                                                                              varI32ParamNames,
                                                                              stmt,
                                                                              callOrdinal,
                                                                              seqsAddTypedContract,
                                                                              seqsAddNodeProbeHit,
                                                                              seqsAddTypeMismatch)
                let seqsAddOwned = seqsAddOutcome != PrimaryBodyIrSeqAddOutcomeNotOwned
                PrimaryBodyIrRecordSeqAddReceipt(PrimaryBodyIrNodeEvalOnlyActive(),
                                                 seqsAddOutcome,
                                                 seqsAddTypedContract,
                                                 seqsAddNodeProbeHit,
                                                 seqsAddTypeMismatch,
                                                 seqAddCandidateCountOut,
                                                 seqAddTypedContractCountOut,
                                                 structuredSeqAddConsumeCountOut,
                                                 seqAddNodeProbeHitCountOut,
                                                 seqAddTypeMismatchCountOut,
                                                 seqAddLegacyTextConsumeCountOut,
                                                 seqAddNodeEvalGapCountOut)
                if seqsAddOwned:
                    PrimaryBodyIrNodeEvalOnlyOwn()
                if seqsAddOwned:
                    if seqsAddNodeProbeHit:
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=seq_add function={typedFn.functionName} line={stmt.lineNumber}")
                    nextOpIndex = nextOpIndex + 1
                    continue
            # setLen(seq, n): a seq-resize builtin. Like add, it can reach the
            # dispatch either tagged TypedExprCallBuiltin or — when it resolved
            # against the std/seqs.cheng setLen overload — as a plain call whose
            # callee/target tail is "setLen"; both forms lower to the same bridge.
            # The seq lowering is attempted inside the guard so a non-seq target
            # named setLen falls through to the generic call path (mirrors add).
            if (stmt.callCallee == "setLen" ||
                stmt.callCallee == "SetLen" ||
                PrimaryCallTargetTailName(stmt.callTarget) == "setLen" ||
                PrimaryCallTargetTailName(stmt.callTarget) == "SetLen") &&
               stmt.callArgCount == 2 &&
               PrimaryBodyIrAppendSeqSetLenBuiltin(bodyIR,
                                                   slotNames,
                                                   lowering,

                                                   typedFn,
                                                   irFunction,
                                                   varI32ParamNames,
                                                   stmt,
                                                   callOrdinal):
                if PrimaryBodyIrSeqSetLenNodeProbe(lowering.typedIr, stmt.rhsNodeIndex):
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=seq_setlen function={typedFn.functionName} line={stmt.lineNumber}")
                nextOpIndex = nextOpIndex + 1
                continue
            # reserve(seq, cap): a seq capacity-grow builtin. Mirrors the setLen
            # arm exactly — it can reach the dispatch tagged TypedExprCallBuiltin or,
            # when it resolved against the std/seqs.cheng reserve overload, as a plain
            # call whose callee/target tail is "reserve"/"Reserve". The seq lowering is
            # attempted inside the guard so a non-seq target named reserve falls
            # through to the generic call path (mirrors add/setLen). Without this arm
            # Reserve fell to the generic path and named the never-emitted generic
            # template, yielding an empty reloc target.
            if (stmt.callCallee == "reserve" ||
                stmt.callCallee == "Reserve" ||
                PrimaryCallTargetTailName(stmt.callTarget) == "reserve" ||
                PrimaryCallTargetTailName(stmt.callTarget) == "Reserve") &&
               stmt.callArgCount == 2 &&
               PrimaryBodyIrAppendSeqReserveBuiltin(bodyIR,
                                                    slotNames,
                                                    lowering,

                                                    typedFn,
                                                    irFunction,
                                                    varI32ParamNames,
                                                    stmt,
                                                    callOrdinal):
                if PrimaryBodyIrSeqReserveNodeProbe(lowering.typedIr, stmt.rhsNodeIndex):
                    if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                        os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=seq_reserve function={typedFn.functionName} line={stmt.lineNumber}")
                nextOpIndex = nextOpIndex + 1
                continue
            # wall113: 裸 builtin echo 语句臂。echo/Echo 是 parser builtin
            # (ParserCallNameIsBuiltinCallee)，typed_expr 结构解析器对其早退，
            # 语句/节点两列 callTarget 均为 ""（无声明身份可绑）。此前这类
            # 语句坠入下方 len(targetStr)>0 门的 else poison bail=63
            # （cold_nested 夹具 if-then 块内 `echo("...")` 首爆 op6）。
            # 对齐 Unsupported 整调用臂（:51962）的既有 echo→puts 自足发射器：
            # 单个字符串字面量/纯文本 Fmt 实参发单 puts call；其余形态
            # （非字面量/含 {expr} 插值/非单实参）helper return false，
            # 落穿下方原 else poison 判词逐字节不变（fail-closed 零弱化）。
            if len(stmt.callTarget) == 0 &&
               (stmt.callCallee == "echo" || stmt.callCallee == "Echo"):
                if PrimaryBodyIrAppendUnsupportedEchoFmtCall(bodyIR,
                                                             slotNames,
                                                             PrimaryBodyIrCallFullText(stmt),
                                                             stmt.lineNumber,
                                                             callOrdinal):
                    nextOpIndex = nextOpIndex + 1
                    continue
            let targetStr = stmt.callTarget
            if len(targetStr) > 0:
                if PrimaryObjectCallTargetIsPureCast(targetStr):
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    continue
                if stmt.returnRoot:
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    continue
                var callLineHasReturn = false
                for lineStmtIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let lineStmtIndex = sameLineOrder[lineStmtIndexP]
                    let lineStmt = irFunction.statements[lineStmtIndex]
                    if lineStmt.kind == texpr.TypedExprIrStmtReturn:
                        callLineHasReturn = true
                        break
                if callLineHasReturn:
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    continue
                var resultSlot: int32
                resultSlot = -1
                let fullCallText = PrimaryBodyIrCallFullText(stmt)
                var feedsSameLineAssign = false
                for assignStmtIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let assignStmtIndex = sameLineOrder[assignStmtIndexP]
                    let assignStmt = irFunction.statements[assignStmtIndex]
                    if assignStmt.kind != texpr.TypedExprIrStmtAssign:
                        continue
                    if assignStmt.callTarget == stmt.callTarget &&
                       assignStmt.callTargetImportc == stmt.callTargetImportc &&
                       PrimaryPathNormalizedEquals(assignStmt.callTargetSourcePath,
                                                   stmt.callTargetSourcePath) &&
                       assignStmt.callArgCount == stmt.callArgCount &&
                       assignStmt.callArgsText == stmt.callArgsText:
                        feedsSameLineAssign = true
                        break
                    if strutil.Contains(assignStmt.surfaceText, fullCallText):
                        feedsSameLineAssign = true
                        break
                    # Pointer-deref store `*(... call(...)) = value`: the feeding
                    # call lives in the assign LHS (bindingName), not the RHS
                    # (surfaceText). The assign's own deref-store path re-emits the
                    # pointer call; this bare call must yield or it double-emits.
                    if fullCallText != "" &&
                       strutil.Contains(assignStmt.bindingName, fullCallText):
                        feedsSameLineAssign = true
                        break
                    if assignStmt.callTarget == stmt.callTarget &&
                       stmt.surfaceText != "" &&
                       strutil.Contains(assignStmt.surfaceText, stmt.surfaceText):
                        feedsSameLineAssign = true
                        break
                    if assignStmt.callTarget == stmt.callTarget &&
                       stmt.callTarget != "" &&
                       strutil.Contains(assignStmt.surfaceText, stmt.callTarget):
                        feedsSameLineAssign = true
                        break
                if feedsSameLineAssign:
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    continue
                # 同行 let 绑定（其 RHS 表达式文本含本调用完整文本）：该裸
                # 调用是 LocalDecl 二元/布尔表达式树的 feeder，由 LocalDecl
                # 文本路径整树降级时一次性发射。节点路径登记其为已消费并
                # 标 Own（纯 census 归属，不改 codegen），不得二次发射。
                var feedsSameLineLocalDecl = false
                for localDeclStmtIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let localDeclStmtIndex = sameLineOrder[localDeclStmtIndexP]
                    let localDeclConsumerStmt = irFunction.statements[localDeclStmtIndex]
                    if localDeclConsumerStmt.kind != texpr.TypedExprIrStmtLocalDecl:
                        continue
                    if fullCallText != "" &&
                       strutil.Contains(localDeclConsumerStmt.surfaceText, fullCallText):
                        feedsSameLineLocalDecl = true
                        break
                if feedsSameLineLocalDecl:
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    continue
                var feedsSameLineCall = false
                var feedsSameLineCallConsumerIndex = -1
                for lineStmtIndex2P in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let lineStmtIndex2 = sameLineOrder[lineStmtIndex2P]
                    let lineStmt2 = irFunction.statements[lineStmtIndex2]
                    if lineStmtIndex2 == stmtIndex:
                        continue
                    if lineStmt2.kind != texpr.TypedExprIrStmtCall &&
                       lineStmt2.kind != texpr.TypedExprIrStmtLetCall:
                        continue
                    if strutil.Contains(lineStmt2.callArgsText, fullCallText):
                        feedsSameLineCall = true
                        feedsSameLineCallConsumerIndex = lineStmtIndex2
                        break
                if feedsSameLineCall:
                    if PrimaryObjectCallTargetIsBuiltin(stmt.callTarget):
                        # Builtin feeders (Len/StrDataPtr/...) inline at the
                        # consumer's arg resolution; a real call op would
                        # have no reloc target.
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        continue
                    if feedsSameLineCallConsumerIndex < stmtIndex:
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        continue
                    let callResultType = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, stmt)
                    resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                    slotNames,
                                                                    lowering.typedIr,
                                                                    PrimaryBodyIrCallResultLayoutSourcePath(stmt),
                                                                    fullCallText,
                                                                    callResultType)
                # 批次6e：独立裸调用（结果丢弃且本行无其他调用语句——嵌套
                # 实参调用由节点树整体求值，孪生 feeder 行存在时让位文本
                # 路径以保调用单发）已节点化且裸调用探针可降时，经节点
                # CallExpr 发射器降（resultSlot=-1 丢弃协议）。
                if resultSlot < 0 &&
                   stmt.rhsNodeIndex >= 0 &&
                   stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                   lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpCallExpr:
                    var bareCallHasSiblingCall = false
                    var bareCallCoveredFeederIndexes: int32[]
                    bareCallCoveredFeederIndexes = []
                    for bareCallScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                        let bareCallScan = sameLineOrder[bareCallScanP]
                        if bareCallScan == stmtIndex:
                            continue
                        let bareCallScanStmt = irFunction.statements[bareCallScan]
                        if bareCallScanStmt.kind == texpr.TypedExprIrStmtCall ||
                           bareCallScanStmt.kind == texpr.TypedExprIrStmtLetCall:
                            var bareCallSiblingCovered = false
                            if bareCallScanStmt.kind == texpr.TypedExprIrStmtCall &&
                               !PrimaryBodyIrIntInList(callFeederEmittedIndexes, bareCallScan):
                                let bareCallSiblingFullText = PrimaryBodyIrCallFullText(bareCallScanStmt)
                                if bareCallSiblingFullText != "" &&
                                   strutil.Contains(stmt.callArgsText, bareCallSiblingFullText):
                                    bareCallSiblingCovered = true
                            if bareCallSiblingCovered:
                                add(bareCallCoveredFeederIndexes, bareCallScan)
                            else:
                                bareCallHasSiblingCall = true
                                break
                    if !bareCallHasSiblingCall:
                        primaryBodyIrNodeEvalMissOp = ""
                        let bareCallEmitMark = primaryBodyIrNodeEvalCallEmitCount
                        var bareCallDone = false
                        if PrimaryBodyIrBareCallNodeEvalProbe(bodyIR,
                                                              slotNames,
                                                              varI32ParamNames,
                                                              lowering,

                                                              typedFn,
                                                              irFunction,
                                                              stmt.rhsNodeIndex):
                            bareCallDone = PrimaryBodyIrAppendCallExprNodeToSlot(bodyIR,
                                                                                 slotNames,
                                                                                 lowering,

                                                                                 typedFn,
                                                                                 irFunction,
                                                                                 varI32ParamNames,
                                                                                 stmt.rhsNodeIndex,
                                                                                 -1,
                                                                                 stmt.lineNumber,
                                                                                 callOrdinal)
                        if bareCallDone:
                            for bareCallCoveredIndex in 0..<bareCallCoveredFeederIndexes.len:
                                if !PrimaryBodyIrIntInList(callFeederEmittedIndexes, bareCallCoveredFeederIndexes[bareCallCoveredIndex]):
                                    add(callFeederEmittedIndexes, bareCallCoveredFeederIndexes[bareCallCoveredIndex])
                            nextOpIndex = nextOpIndex + 1
                            PrimaryBodyIrNodeEvalOnlyOwn()
                            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=bare_call function={typedFn.functionName} line={stmt.lineNumber}")
                            continue
                        if primaryBodyIrNodeEvalCallEmitCount != bareCallEmitMark:
                            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                         stmt.lineNumber,
                                                         int32(stmt.kind),
                                                         6101,
                                                         0)
                            nextOpIndex = nextOpIndex + 1
                            continue
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            var bareCallMissOpText = primaryBodyIrNodeEvalMissOp
                            if bareCallMissOpText == "":
                                bareCallMissOpText = "bare_call_shape"
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={bareCallMissOpText} entry=bare_call function={typedFn.functionName} line={stmt.lineNumber}")
                # Same-line feeder calls must land before the consumer:
                # the consumer's args reference their result slots.
                for feederIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let feederIndex = sameLineOrder[feederIndexP]
                    if PrimaryBodyIrIntInList(callFeederEmittedIndexes, feederIndex):
                        continue
                    if feederIndex == stmtIndex:
                        continue
                    let feederStmt = irFunction.statements[feederIndex]
                    if feederStmt.kind != texpr.TypedExprIrStmtCall:
                        continue
                    if len(feederStmt.callTarget) <= 0:
                        continue
                    if PrimaryObjectCallTargetIsPureCast(feederStmt.callTarget):
                        continue
                    if PrimaryObjectCallTargetIsBuiltin(feederStmt.callTarget):
                        # Builtin feeders (Len/StrDataPtr/...) inline at the
                        # consumer's arg resolution; a real call here would
                        # have no reloc target.
                        continue
                    let feederFullText = PrimaryBodyIrCallFullText(feederStmt)
                    if feederFullText == "":
                        continue
                    if !strutil.Contains(stmt.callArgsText, feederFullText):
                        continue
                    let feederResultType = PrimaryBodyIrResolvedCallResultType(lowering.typedIr, feederStmt)
                    let feederResultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                              slotNames,
                                                                              lowering.typedIr,
                                                                              PrimaryBodyIrCallResultLayoutSourcePath(feederStmt),
                                                                              feederFullText,
                                                                              feederResultType)
                    let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                      slotNames,
                                                      lowering,

                                                      typedFn,
                                                      irFunction,
                                                      feederStmt,
                                                      feederResultSlot,
                                                      varI32ParamNames,
                                                      callOrdinal,
                                                      currentBlockStart)
                    nextOpIndex = nextOpIndex + 1
                    add(callFeederEmittedIndexes, feederIndex)
                let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                  slotNames,
                                                  lowering,

                                                  typedFn,
                                                  irFunction,
                                                  stmt,
                                                  resultSlot,
                                                  varI32ParamNames,
                                                  callOrdinal,
                                                  currentBlockStart)
                # 到达此点即已由节点路径的 PrimaryBodyIrAppendCallOp 为该裸调用发射
                # 真 call op 并存入 resultSlot(同行 feeder 被同行 consumer 按同名槽
                # 引用,不二次发射)。登记节点路径已消费本语句(纯 census 归属,不改
                # codegen),否则 flush 误报 node_path_skip。镜像 feedsSameLineAssign/
                # LocalDecl 的 Own。
                nextOpIndex = nextOpIndex + 1
            else:
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             63,
                                             0)
                nextOpIndex = nextOpIndex + 1
        elif stmt.kind == texpr.TypedExprIrStmtAssign:
            PrimaryObjectPlanGuardTick()
            if PrimaryObjectPlanProgressEnabled():
                PrimaryObjectPlanProgress(Fmt"assign_branch_begin function={typedFn.functionName} stmt_index={stmtIndex} line={stmt.lineNumber} field={stmt.assignFieldName}")
            var duplicateInitializedLocalDecl = false
            if stmt.assignFieldName == "":
                for initializedIndex in 0..<initializedLocalDeclNames.len:
                    if initializedIndex >= initializedLocalDeclLines.len:
                        continue
                    if initializedLocalDeclLines[initializedIndex] == stmt.lineNumber &&
                       initializedLocalDeclNames[initializedIndex] == stmt.bindingName:
                        duplicateInitializedLocalDecl = true
                        break
            PrimaryObjectPlanGuardTick()
            if PrimaryObjectPlanProgressEnabled():
                PrimaryObjectPlanProgress(Fmt"assign_duplicate_check_done function={typedFn.functionName} stmt_index={stmtIndex} duplicate={duplicateInitializedLocalDecl}")
            if duplicateInitializedLocalDecl:
                nextOpIndex = nextOpIndex + 1
                continue
            var assignLineHasReturn = false
            for checkIdxP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                let checkIdx = sameLineOrder[checkIdxP]
                let checkStmt = irFunction.statements[checkIdx]
                if checkStmt.kind == texpr.TypedExprIrStmtReturn:
                    assignLineHasReturn = true
                    break
            if assignLineHasReturn:
                nextOpIndex = nextOpIndex + 1
                continue
            PrimaryObjectPlanGuardTick()
            if PrimaryObjectPlanProgressEnabled():
                PrimaryObjectPlanProgress(Fmt"assign_append_begin function={typedFn.functionName} stmt_index={stmtIndex}")
            # Pointer-deref store LHS (`*(UInt8Ptr(...)) = v` / `*ptr = v`): never
            # mint a local slot named after the deref text. Doing so makes the
            # later FindSlotIndex in AppendI32Assign resolve a phantom local and
            # node-eval the value into it, silently dropping the store-through-
            # pointer. Skip straight to AppendI32Assign's deref-store path.
            var assignLhsIsPtrDeref = false
            if PrimaryBodyIrUInt8PtrDerefPointerText(stmt.bindingName) != "":
                assignLhsIsPtrDeref = true
            elif len(stmt.bindingName) > 1 && stmt.bindingName[0] == '*':
                assignLhsIsPtrDeref = true
            # Indexed / field LHS (`grid[0] = row`, `x.f = agg`): the aggregate
            # fast-copy below mints a phantom local named after the WHOLE LHS text
            # (`grid[0]`) and copies the RHS into it — which silently drops the
            # real element/field store (the seq-of-seq `grid[i] = row` element
            # never lands in grid.buffer). Only plain-local aggregate copies
            # (`x = y`) may take the fast path; an indexed/field destination must
            # fall through to AppendI32Assign's IndexedStore/FieldStore lowering.
            var assignLhsHasFieldOrIndex = PrimaryBodyIrTextHasFieldOrIndex(stmt.bindingName)
            if stmt.assignFieldName == "" && stmt.bindingName != "" &&
               !assignLhsIsPtrDeref && !assignLhsHasFieldOrIndex:
                let rhsExistingSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames,
                                                               strutil.Strip(stmt.surfaceText))
                # wave14-712b-globalwrite: LHS 是模块全局 (str/聚合, 如
                # `globalPrivCache = b` / `gPair = local`) 时绝不能走这条快路径——
                # PrimaryBodyIrFindOrCreateTypedSlot 按裸绑定名建/找的是一个新的
                # 栈局部槽 (无 placeKind=GlobalAddress 标记), 随后的 CopyLocal 只把
                # 值写进这个函数退出即销毁的幽灵栈槽, 真正的全局数据标号从未被
                # 写入 (BSS 保持零)——后续任何函数读该全局都读到静默的全零/丢失
                # 值 (len 丢失即此症状之一, 但缺陷本身与 Bytes 类型名无关, 对任意
                # str/聚合全局整体赋值同样成立)。镜像下方 43439 附近 str-only 分支
                # 已有的 stringAssignLhsIsGlobal 判定, 在快路径入口一并挡下, 让语句
                # 落到本函数末尾 PrimaryBodyIrAppendI32Assign 里已验证正确的
                # lhsGlobalType 全局写路径 (assign_global_aggregate/scalar)。
                var assignCopyLocalLhsIsGlobal = false
                if PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                   typedFn,
                                                   irFunction,
                                                   stmt.lineNumber,
                                                   stmt.bindingName) == "":
                    if stmt.assignRootGlobalFlag ||
                       PrimaryBodyIrTypedGlobalType(lowering.typedIr, stmt.sourcePath, stmt.bindingName) != "" ||
                       PrimaryBodyIrTypedGlobalTypeExact(lowering.typedIr, stmt.sourcePath, stmt.bindingName) != "":
                        assignCopyLocalLhsIsGlobal = true
                if rhsExistingSlot >= 0 && !assignCopyLocalLhsIsGlobal &&
                   (PrimaryBodyIrSlotType(bodyIR, rhsExistingSlot) == coreir.LocalStrTag ||
                    PrimaryBodyIrSlotType(bodyIR, rhsExistingSlot) == coreir.LocalAggregateTag):
                    var copyTypeText = stmt.resultType
                    if copyTypeText == "" || copyTypeText == "unknown" ||
                       !PrimaryObjectMetadataTextStable(copyTypeText):
                        if PrimaryBodyIrSlotType(bodyIR, rhsExistingSlot) == coreir.LocalStrTag:
                            copyTypeText = "str"
                    let copyAssignSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                            slotNames,
                                                                            lowering.typedIr,
                                                                            stmt.sourcePath,
                                                                            stmt.bindingName,
                                                                            copyTypeText)
                    if copyAssignSlot >= 0 &&
                       PrimaryBodyIrSlotType(bodyIR, copyAssignSlot) == PrimaryBodyIrSlotType(bodyIR, rhsExistingSlot):
                        if copyAssignSlot != rhsExistingSlot:
                            var directCopyOp: coreir.BodyOp
                            directCopyOp.kind = coreir.BodyOpCopyLocalTag
                            directCopyOp.target = copyAssignSlot
                            add(directCopyOp.operands, rhsExistingSlot)
                            let _ = coreir.BodyIRAppendOp(bodyIR, directCopyOp)
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_copy_local function={typedFn.functionName} line={stmt.lineNumber}")
                        nextOpIndex = nextOpIndex + 1
                        continue
                var stringAssignSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, stmt.bindingName)
                if stringAssignSlot < 0:
                    # Only create the lhs staging slot for local bindings and
                    # params. A global lhs must not get a same-named local
                    # slot: later rhs reads of the global would resolve to the
                    # uninitialized staging slot instead of a global load.
                    var stringAssignLhsIsGlobal = false
                    if PrimaryBodyIrBindingTypeForName(lowering.typedIr,
                                                       typedFn,
                                                       irFunction,
                                                       stmt.lineNumber,
                                                       stmt.bindingName) == "":
                        if stmt.assignRootGlobalFlag ||
                           PrimaryBodyIrTypedGlobalType(lowering.typedIr, stmt.sourcePath, stmt.bindingName) != "" ||
                           PrimaryBodyIrTypedGlobalTypeExact(lowering.typedIr, stmt.sourcePath, stmt.bindingName) != "":
                            stringAssignLhsIsGlobal = true
                    if !stringAssignLhsIsGlobal:
                        stringAssignSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                              slotNames,
                                                                              lowering.typedIr,
                                                                              stmt.sourcePath,
                                                                              stmt.bindingName,
                                                                              stmt.resultType)
                if stringAssignSlot >= 0 &&
                   PrimaryBodyIrSlotType(bodyIR, stringAssignSlot) == coreir.LocalStrTag:
                    var stringAssigned = false
                    if stmt.rhsNodeIndex >= 0 &&
                       stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                       !PrimaryBodyIrNodeTreeHasCallExpr(lowering.typedIr, stmt.rhsNodeIndex):
                        primaryBodyIrNodeEvalMissOp = ""
                        if PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                      slotNames,
                                                      varI32ParamNames,
                                                      lowering,

                                                      share(typedFn),
                                                      irFunction,
                                                      stmt.rhsNodeIndex) == coreir.LocalStrTag:
                            let stringAssignNodeValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                                  slotNames,
                                                                                  varI32ParamNames,
                                                                                  lowering,

                                                                                  share(typedFn),
                                                                                  irFunction,
                                                                                  stmt.rhsNodeIndex,
                                                                                  callOrdinal)
                            if stringAssignNodeValueSlot >= 0 &&
                               PrimaryBodyIrNodeEvalStore(bodyIR,
                                                          slotNames,
                                                          stringAssignSlot,
                                                          stringAssignNodeValueSlot):
                                stringAssigned = true
                                PrimaryBodyIrNodeEvalOnlyOwn()
                                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_str function={typedFn.functionName} line={stmt.lineNumber}")
                    if !stringAssigned && PrimaryBodyIrTextIsStringLiteral(stmt.surfaceText):
                        stringAssigned = PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                                               slotNames,
                                                                               stmt.surfaceText,
                                                                               stringAssignSlot,
                                                                               callOrdinal)
                    elif !stringAssigned && PrimaryBodyIrTextIsStrSlice(stmt.surfaceText):
                        let sliceTempSlot = PrimaryBodyIrLowerStrSliceToSlot(bodyIR, slotNames, varI32ParamNames, lowering.typedIr, typedFn, irFunction, stmt.sourcePath, stmt.lineNumber, stmt.surfaceText, stmt.bindingName, callOrdinal)
                        if sliceTempSlot >= 0:
                            if sliceTempSlot != stringAssignSlot:
                                var sliceCopyOp: coreir.BodyOp
                                sliceCopyOp.kind = coreir.BodyOpCopyLocalTag
                                sliceCopyOp.target = stringAssignSlot
                                add(sliceCopyOp.operands, sliceTempSlot)
                                let _ = coreir.BodyIRAppendOp(bodyIR, sliceCopyOp)
                            stringAssigned = true

                    elif !stringAssigned:
                        let rhsStringSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames,
                                                                     strutil.Strip(stmt.surfaceText))
                        if rhsStringSlot >= 0 &&
                           PrimaryBodyIrSlotType(bodyIR, rhsStringSlot) == coreir.LocalStrTag:
                            if rhsStringSlot != stringAssignSlot:
                                var stringCopyOp: coreir.BodyOp
                                stringCopyOp.kind = coreir.BodyOpCopyLocalTag
                                stringCopyOp.target = stringAssignSlot
                                add(stringCopyOp.operands, rhsStringSlot)
                                let _ = coreir.BodyIRAppendOp(bodyIR, stringCopyOp)
                            stringAssigned = true
                    if stringAssigned:
                        nextOpIndex = nextOpIndex + 1
                        continue
                let aggregateAssignSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, stmt.bindingName)
                # `gAgg = TypeName()` zero-constructor assign to a module GLOBAL:
                # the global has no local slot, so materialize its own slot
                # (aggregate-typed, exact size, placeKind=GlobalAddress). The
                # zero-init writer (PrimaryBodyIrAppendZeroLocalSlot) already
                # passes a GlobalAddress slot to setMem via adrp+add, so the
                # global data label — not a frame copy — is zeroed. Restricted to
                # the zero-constructor form (rhs `TypeName()`); the sret-call and
                # aggregate-copy global stores keep their honest gaps because the
                # whole-aggregate sret/copy writers below address the destination
                # stack-relatively (x8/CopyLocal), which would miss the global.
                var globalZeroCtorDestSlot = -1
                if aggregateAssignSlot < 0 &&
                   stmt.assignFieldName == "" &&
                   !PrimaryBodyIrTextHasFieldOrIndex(stmt.bindingName) &&
                   PrimaryBodyIrFindArgSlot(bodyIR, slotNames, stmt.bindingName) < 0:
                    let globalAggDestSlot = PrimaryBodyIrGlobalAggregateDestSlot(bodyIR,
                                                                                 slotNames,
                                                                                 lowering.typedIr,
                                                                                 stmt.sourcePath,
                                                                                 stmt.bindingName)
                    if globalAggDestSlot >= 0 &&
                       PrimaryBodyIrSlotType(bodyIR, globalAggDestSlot) == coreir.LocalAggregateTag &&
                       PrimaryBodyIrAssignZeroConstructorMatches(bodyIR,
                                                                 lowering.typedIr,
                                                                 irFunction,
                                                                 stmt.sourcePath,
                                                                 stmt.surfaceText,
                                                                 globalAggDestSlot):
                        globalZeroCtorDestSlot = globalAggDestSlot
                if globalZeroCtorDestSlot >= 0:
                    if PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                        slotNames,
                                                        globalZeroCtorDestSlot,
                                                        callOrdinal):
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_zero_ctor_global function={typedFn.functionName} line={stmt.lineNumber}")
                        nextOpIndex = nextOpIndex + 1
                        continue
                if aggregateAssignSlot >= 0 &&
                   PrimaryBodyIrSlotType(bodyIR, aggregateAssignSlot) == coreir.LocalAggregateTag:
                    # `lhs = TypeName()` 零实参类型构造器：默认零初始化整聚合槽
                    #（含 var 形参，AppendZeroLocalSlot 经形参地址清零）。文本路径，
                    # 因 `Type()` 构造器 RHS 在前端不建节点（rhsNodeIndex==-1）。
                    if PrimaryBodyIrAssignZeroConstructorMatches(bodyIR,
                                                                 lowering.typedIr,
                                                                 irFunction,
                                                                 stmt.sourcePath,
                                                                 stmt.surfaceText,
                                                                 aggregateAssignSlot):
                        if PrimaryBodyIrAppendZeroLocalSlot(bodyIR,
                                                            slotNames,
                                                            aggregateAssignSlot,
                                                            callOrdinal):
                            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_zero_ctor function={typedFn.functionName} line={stmt.lineNumber}")
                            nextOpIndex = nextOpIndex + 1
                            continue
                    # `lhs = Ctor()/aggregateCall()` 进 LHS 本地聚合槽（非形参）：
                    # 经 CallExpr 节点发射器物化（含 Ok/Err Result 构造、sret 聚合返回）。
                    elif !PrimaryBodyIrLocalIsParam(bodyIR.localSlots[aggregateAssignSlot]) &&
                         stmt.rhsNodeIndex >= 0 &&
                         stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                         lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] == texpr.TypedExprIrOpCallExpr:
                        primaryBodyIrNodeEvalMissOp = ""
                        let aggregateAssignProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                                  slotNames,
                                                                                  varI32ParamNames,
                                                                                  lowering,

                                                                                  share(typedFn),
                                                                                  irFunction,
                                                                                  stmt.rhsNodeIndex)
                        if aggregateAssignProbeKind == coreir.LocalAggregateTag:
                            let aggregateAssignEmitMark = primaryBodyIrNodeEvalCallEmitCount
                            if PrimaryBodyIrAppendCallExprNodeToSlot(bodyIR,
                                                                     slotNames,
                                                                     lowering,

                                                                     typedFn,
                                                                     irFunction,
                                                                     varI32ParamNames,
                                                                     stmt.rhsNodeIndex,
                                                                     aggregateAssignSlot,
                                                                     stmt.lineNumber,
                                                                     callOrdinal):
                                PrimaryBodyIrNodeEvalOnlyOwn()
                                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_ctor function={typedFn.functionName} line={stmt.lineNumber}")
                                nextOpIndex = nextOpIndex + 1
                                continue
                            if primaryBodyIrNodeEvalCallEmitCount != aggregateAssignEmitMark:
                                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                             stmt.lineNumber,
                                                             int32(stmt.kind),
                                                             6101,
                                                             0)
                                nextOpIndex = nextOpIndex + 1
                                continue
                    # `lhs = seq[i]/字段路径/本地聚合` 聚合整体拷贝（非调用 RHS）：
                    # EvalNode 按元素/字段宽精确物化源聚合，NodeEvalStore 按精确
                    # 宽搬进 LHS 槽（本地拷贝；var 形参经地址 FieldStore）。
                    elif stmt.rhsNodeIndex >= 0 &&
                         stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len &&
                         lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex] != texpr.TypedExprIrOpCallExpr:
                        primaryBodyIrNodeEvalMissOp = ""
                        let aggregateCopyProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                                slotNames,
                                                                                varI32ParamNames,
                                                                                lowering,

                                                                                share(typedFn),
                                                                                irFunction,
                                                                                stmt.rhsNodeIndex)
                        if aggregateCopyProbeKind == coreir.LocalAggregateTag:
                            let aggregateCopyEmitMark = primaryBodyIrNodeEvalCallEmitCount
                            let aggregateCopyValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                               slotNames,
                                                                               varI32ParamNames,
                                                                               lowering,

                                                                               share(typedFn),
                                                                               irFunction,
                                                                               stmt.rhsNodeIndex,
                                                                               callOrdinal)
                            if aggregateCopyValueSlot >= 0 &&
                               PrimaryBodyIrNodeEvalStore(bodyIR,
                                                          slotNames,
                                                          aggregateAssignSlot,
                                                          aggregateCopyValueSlot):
                                PrimaryBodyIrNodeEvalOnlyOwn()
                                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=assign_agg_copy function={typedFn.functionName} line={stmt.lineNumber}")
                                nextOpIndex = nextOpIndex + 1
                                continue
                            if primaryBodyIrNodeEvalCallEmitCount != aggregateCopyEmitMark:
                                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                             stmt.lineNumber,
                                                             int32(stmt.kind),
                                                             6101,
                                                             0)
                                nextOpIndex = nextOpIndex + 1
                                continue
            if PrimaryBodyIrLowerJsonNestedBracketAssign(bodyIR,
                                                          slotNames,
                                                          lowering,

                                                          typedFn,
                                                          irFunction,
                                                          varI32ParamNames,
                                                          stmt,
                                                          stmt.lineNumber,
                                                          callOrdinal):
                nextOpIndex = nextOpIndex + 1
                continue
            if PrimaryBodyIrLowerJsonBracketAssign(bodyIR,
                                                    slotNames,
                                                    lowering,

                                                    typedFn,
                                                    irFunction,
                                                    varI32ParamNames,
                                                    stmt,
                                                    stmt.lineNumber,
                                                    callOrdinal):
                nextOpIndex = nextOpIndex + 1
                continue
            let assignI32Lowered = PrimaryBodyIrAppendI32Assign(bodyIR,
                                                                localBindingProjection,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering,

                                                                typedFn,
                                                                irFunction,
                                                                stmt,
                                                                callOrdinal,
                                                                currentBlockStart)
            if !assignI32Lowered:
                var assignDetail = 0
                if PrimaryBodyIrUInt8PtrDerefPointerText(stmt.bindingName) != "":
                    assignDetail = 701
                elif stmt.bindingName == "":
                    assignDetail = 703
                elif stmt.surfaceText == "":
                    assignDetail = 704
                # bail=0 STEP 1 诊断细化 (阶段 8 工作流):零行为变化,把 14 条 bail=0
                # 拆成 705..709 子族, 解锁下一轮按子族定向 spot-fix。所有 branch
                # 只设 assignDetail, 不改 codegen 输出。
                elif stmt.assignFieldName != "":
                    assignDetail = 705
                elif PrimaryBodyIrTextHasFieldOrIndex(stmt.bindingName):
                    assignDetail = 706
                elif PrimaryBodyIrTextHasCallSurface(stmt.surfaceText):
                    assignDetail = 707
                elif stmt.rhsNodeIndex >= 0:
                    assignDetail = 708
                else:
                    assignDetail = 709
                let assignAddPos = texpr.TypedExprFindTopLevelTextToken(stmt.surfaceText, "+")
                var assignCallRhsText = "0"
                let assignLhsSlot = PrimaryBodyIrFindSlotIndex(bodyIR, slotNames, stmt.bindingName)
                let assignRhsSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, strutil.Strip(stmt.surfaceText))
                var assignLhsSlotType: int32
                var assignRhsSlotType: int32
                if assignLhsSlot >= 0:
                    assignLhsSlotType = PrimaryBodyIrSlotType(bodyIR, assignLhsSlot)
                if assignRhsSlot >= 0:
                    assignRhsSlotType = PrimaryBodyIrSlotType(bodyIR, assignRhsSlot)
                PrimaryObjectPlanTrace(strutil.Join(["phase=assign_fail function=",
                                                     strings.CloneStr(typedFn.functionName),
                                                     " line=",
                                                     strings.IntToStr(stmt.lineNumber),
                                                     " detail=",
                                                     strings.IntToStr(assignDetail),
                                                     " lhs=",
                                                     strings.CloneStr(stmt.bindingName),
                                                     " rhs=",
                                                     strings.CloneStr(stmt.surfaceText),
                                                     " add_pos=",
                                                     strings.IntToStr(assignAddPos),
                                                     " call_rhs=",
                                                     share(assignCallRhsText),
                                                     " lhs_slot=",
                                                     strings.IntToStr(assignLhsSlot),
                                                     " lhs_slot_type=",
                                                     strings.IntToStr(assignLhsSlotType),
                                                     " rhs_slot=",
                                                     strings.IntToStr(assignRhsSlot),
                                                     " rhs_slot_type=",
                                                     strings.IntToStr(assignRhsSlotType)], ""))
                if os.GetEnv("CHENG_X64_DBG3") != "":
                    var dbg3FieldOrIndex: int32
                    if PrimaryBodyIrTextHasFieldOrIndex(stmt.bindingName):
                        dbg3FieldOrIndex = 1
                    var dbg3IdxRoot = ""
                    var dbg3IdxText = ""
                    var dbg3IdxParts: int32
                    if PrimaryBodyIrIndexExprParts(PrimaryBodyIrCanonicalAssignLhsName(stmt.bindingName), dbg3IdxRoot, dbg3IdxText):
                        dbg3IdxParts = 1
                    let dbg3RootSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames, dbg3IdxRoot)
                    var dbg3FieldLen: int32 = stmt.assignFieldName.len
                    var dbg3RootLen: int32 = stmt.assignRootName.len
                    os.WriteLine(os.GetStderr(), Fmt"x64dbg3 assign_fail line={stmt.lineNumber} fn={typedFn.functionName} op={int32(stmt.assignValueOpKind)} lhs=[{stmt.bindingName}] rhs=[{stmt.surfaceText}] vlhs=[{stmt.assignValueLhsText}] vrhs=[{stmt.assignValueRhsText}] lhs_slot={assignLhsSlot} lhs_slot_type={assignLhsSlotType} foi={dbg3FieldOrIndex} idx_parts={dbg3IdxParts} idx_root=[{dbg3IdxRoot}] root_slot={dbg3RootSlot} field_len={dbg3FieldLen} aroot_len={dbg3RootLen} call_target=[{stmt.callTarget}]")
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             assignDetail,
                                             0)
            nextOpIndex = nextOpIndex + 1
        elif stmt.kind == texpr.TypedExprIrStmtReturn:
            if stmt.lineNumber == completedReturnLineNumber:
                continue
            var handledReturnCall = false
            let returnText = stmt.surfaceText
            var valText = ""
            if len(returnText) > 0:
                if PrimaryStartsWith(returnText, "return "):
                    valText = strings.SliceBytes(returnText, 7, len(returnText) - 7)
                else:
                    valText = returnText
                valText = strutil.Strip(valText)
            # #76c: `return new(T)`(shape07)直返——return 路径从无专用 "new" realizer,
            # 唯一命中的是通用值兜底(LocalInitValueSlot), 它不认 "new(...)" 字面量但
            # 支持"返回一个已存在的同类型局部变量"。提前把 valText 里的整段 "new(T)"
            # hoist 成一个已分配好的 ptr 局部, 用其名字替换; "new(Sym)" 不匹配下面任何
            # deref/三元/字面量特判分支, 提前替换对它们零影响, 只有最终通用兜底会真正
            # 消费这个名字。
            let returnHoistName = PrimaryBodyIrHoistNewCallToPtrSlotName(bodyIR,
                                                                         slotNames,
                                                                         lowering.typedIr,
                                                                         stmt.sourcePath,
                                                                         stmt.lineNumber,
                                                                         valText,
                                                                         callOrdinal)
            if returnHoistName != "":
                valText = returnHoistName
            var returnDerefText = strings.CloneStr(valText)
            let returnDerefCastInner = PrimaryBodyIrTypeCastInnerForTarget(valText, "int32")
            if returnDerefCastInner != "":
                returnDerefText = strutil.Strip(returnDerefCastInner)
            # 裸 `*name` 返回按函数返回形分派宽度：ptr/i64 形让路给下方通用
            # 8 字节 deref 臂；此前无条件走 4 字节 I32 臂，64 位指针/整数被
            # 截成 32 位（gen2 驱动 argv 指针高位丢失 SIGSEGV 根因）。显式
            # int32(...) 壳与 Int32Ptr/UInt8Ptr cast 形保持原语义不动。
            var returnDerefWide = false
            if returnDerefCastInner == "" &&
               len(returnDerefText) > 1 &&
               returnDerefText[1] != '(' &&
               PrimaryBodyIrI32PtrDerefPointerText(returnDerefText) != "":
                var rdwKind: int32
                var rdwSize: int32
                var rdwAlign: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               stmt.sourcePath,
                                               typedFn.returnType,
                                               rdwKind,
                                               rdwSize,
                                               rdwAlign)
                if rdwKind == coreir.LocalPtrTag || rdwKind == coreir.LocalI64Tag:
                    returnDerefWide = true
            if !returnDerefWide &&
               (PrimaryBodyIrUInt8PtrDerefPointerText(returnDerefText) != "" ||
                PrimaryBodyIrI32PtrDerefPointerText(returnDerefText) != ""):
                let returnDerefSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                    slotNames,
                                                                    Fmt"#return_deref#{bodyIR.ops.len}",
                                                                    coreir.LocalI32Tag)
                var returnDerefOk = false
                if returnDerefSlot >= 0:
                    if PrimaryBodyIrUInt8PtrDerefPointerText(returnDerefText) != "":
                        returnDerefOk = PrimaryBodyIrAppendUInt8PtrDerefLoad(bodyIR,
                                                                             slotNames,
                                                                             varI32ParamNames,
                                                                             lowering.typedIr,
                                                                             stmt.sourcePath,
                                                                             returnDerefText,
                                                                             returnDerefSlot,
                                                                             callOrdinal)
                    else:
                        returnDerefOk = PrimaryBodyIrAppendI32PtrDerefLoad(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering.typedIr,
                                                                           stmt.sourcePath,
                                                                           returnDerefText,
                                                                           returnDerefSlot,
                                                                           callOrdinal)
                if returnDerefOk:
                    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                  currentBlockStart,
                                                  returnDerefSlot,
                                                  coreir.LocalI32Tag,
                                                  0,
                                                  false)
                    completedReturnLineNumber = stmt.lineNumber
                    continue
                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                             stmt.lineNumber,
                                             int32(stmt.kind),
                                             803,
                                             0)
                nextOpIndex = nextOpIndex + 1
                continue
            # 通用指针解引用返回：return *(call()/name)，返回类型为指针形态时
            # 发 64 位 deref load；此前该形态静默丢解引用（slot_get 返回地址而非值）。
            var returnPtrDerefInner = ""
            if len(returnDerefText) > 3 && returnDerefText[0] == '*' &&
               returnDerefText[1] == '(' &&
               returnDerefText[len(returnDerefText) - 1] == ')':
                let rpdClose = texpr.TypedExprFindMatchingParen(returnDerefText, 1)
                if rpdClose == len(returnDerefText) - 1:
                    returnPtrDerefInner = strutil.Strip(strings.SliceBytes(returnDerefText, 2, len(returnDerefText) - 3))
            if returnPtrDerefInner == "" && returnDerefWide:
                # 裸 `*name` 宽返回形（上方 I32 臂已让路）直取指针文本
                returnPtrDerefInner = PrimaryBodyIrI32PtrDerefPointerText(returnDerefText)
            if returnPtrDerefInner != "" &&
               PrimaryBodyIrWholeCallInnerForHeadSuffix(returnPtrDerefInner, "UInt64Ptr") == "":
                var rpdRetKind: int32
                var rpdRetSize: int32
                var rpdRetAlign: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               stmt.sourcePath,
                                               typedFn.returnType,
                                               rpdRetKind,
                                               rpdRetSize,
                                               rpdRetAlign)
                # ptr 与 i64 同为 8 字节机器字：return *(ptrExpr)（返回 ptr）和
                # return uint64(*(ptrExpr))（int32-cast 头剥离后返回 uint64/int64）
                # 都是同一条 8 字节 deref-load，返回 term 用各自返回形态的 kind。
                if rpdRetKind == coreir.LocalPtrTag || rpdRetKind == coreir.LocalI64Tag:
                    let rpdPtrSlot = PrimaryBodyIrPtrExpressionSlot(bodyIR,
                                                                    slotNames,
                                                                    varI32ParamNames,
                                                                    lowering.typedIr,
                                                                    stmt.sourcePath,
                                                                    returnPtrDerefInner,
                                                                    callOrdinal)
                    if rpdPtrSlot >= 0:
                        let rpdValueSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                         slotNames,
                                                                         Fmt"#return_deref#{bodyIR.ops.len}",
                                                                         rpdRetKind)
                        if rpdValueSlot >= 0:
                            var rpdOp: coreir.BodyOp
                            rpdOp.kind = coreir.BodyOpLoadLocalTag
                            rpdOp.target = rpdValueSlot
                            add(rpdOp.operands, coreir.BodyLoadLocalPtrDerefU64Tag)
                            add(rpdOp.operands, rpdPtrSlot)
                            add(rpdOp.operands, 8)
                            let _ = coreir.BodyIRAppendOp(bodyIR, rpdOp)
                            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                          currentBlockStart,
                                                          rpdValueSlot,
                                                          rpdRetKind,
                                                          0,
                                                          false)
                            completedReturnLineNumber = stmt.lineNumber
                            continue
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 804,
                                                 0)
                    nextOpIndex = nextOpIndex + 1
                    continue
            if len(returnText) > 0:
                # 批次6e：返回表达式已节点化且探针类标与函数返回形一致
                # （i32→i64 允许加宽）时经节点求值器产出值槽，直接接既有
                # 返回 term 管线。探针失败落回文本路径；求值在调用已发射
                # 后失败禁止落回。
                if stmt.rhsNodeIndex >= 0 && stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                    var returnNodeTypeKind: int32
                    var returnNodeTypeSize: int32
                    var returnNodeTypeAlign: int32
                    # 返回类型形状由 TypeShapeFromText 统一求（限定标量 typedef 如
                    # langintern.InternId → int32 已在 TypeShapeFromTextImpl 的限定
                    # leaf 回退里解析）。此前在这里按限定 leaf 预归一会把 seq/array
                    # 返回类型 langintern.InternId[] 的 [] 一并剥掉（leaf="InternId"
                    # →"int32"），误把聚合 seq 当标量 → 探针 Aggregate 与期望 I32 不
                    # 符整段 miss。去掉预归一,seq/标量都交给 TypeShapeFromText。
                    let returnNodeShapeType = typedFn.returnType
                    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                   typedFn.sourcePath,
                                                   returnNodeShapeType,
                                                   returnNodeTypeKind,
                                                   returnNodeTypeSize,
                                                   returnNodeTypeAlign)
                    if returnNodeTypeKind == coreir.LocalI32Tag ||
                       returnNodeTypeKind == coreir.LocalI64Tag ||
                       returnNodeTypeKind == coreir.LocalF64Tag ||
                       returnNodeTypeKind == coreir.LocalPtrTag ||
                       returnNodeTypeKind == coreir.LocalStrTag ||
                       returnNodeTypeKind == coreir.LocalAggregateTag:
                        primaryBodyIrNodeEvalMissOp = ""
                        let returnNodeProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                             slotNames,
                                                                             varI32ParamNames,
                                                                             lowering,

                                                                             share(typedFn),
                                                                             irFunction,
                                                                             stmt.rhsNodeIndex)
                        var returnNodeReady = false
                        if returnNodeProbeKind == returnNodeTypeKind:
                            returnNodeReady = true
                        elif returnNodeTypeKind == coreir.LocalI64Tag &&
                             returnNodeProbeKind == coreir.LocalI32Tag:
                            returnNodeReady = true
                        let returnNodeEmitMark = primaryBodyIrNodeEvalCallEmitCount
                        var returnNodeDone = false
                        # 值位短路 log-chain：return 的 LogOr/LogAnd 根含 CallExpr 时
                        # 标准探针/求值器 bail（非短路位运算会破坏短路语义）。当返回
                        # 形为 i32（bool）且整链可下降时，用短路 CBR 链发射 0/1 bool
                        # 结果槽，再接既有返回 term，避免落回文本路径。
                        if returnNodeTypeKind == coreir.LocalI32Tag &&
                           PrimaryBodyIrNodeIsShortCircuitChainRoot(lowering.typedIr,
                                                                    stmt.rhsNodeIndex):
                            var returnBoolChainSlot: int32
                            let returnBoolChainOutcome = PrimaryBodyIrAppendNodeBoolConditionChain(bodyIR,
                                                                                                  slotNames,
                                                                                                  varI32ParamNames,
                                                                                                  lowering,

                                                                                                  typedFn,
                                                                                                  irFunction,
                                                                                                  stmt.rhsNodeIndex,
                                                                                                  callOrdinal,
                                                                                                  currentBlockStart,
                                                                                                  returnBoolChainSlot)
                            if returnBoolChainOutcome == PrimaryBodyIrNodeBoolChainSuccess:
                                PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                              currentBlockStart,
                                                              returnBoolChainSlot,
                                                              returnNodeTypeKind,
                                                              0,
                                                              false)
                                returnNodeDone = true
                            elif returnBoolChainOutcome == PrimaryBodyIrNodeBoolChainClaimedFailed:
                                nextOpIndex = nextOpIndex + 1
                                completedReturnLineNumber = stmt.lineNumber
                                PrimaryBodyIrNodeEvalOnlyOwn()
                                continue
                            else:
                                PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                             stmt.lineNumber,
                                                             int32(stmt.kind),
                                                             6101,
                                                             0)
                                nextOpIndex = nextOpIndex + 1
                                completedReturnLineNumber = stmt.lineNumber
                                PrimaryBodyIrNodeEvalOnlyOwn()
                                continue
                        if !returnNodeDone &&
                           returnNodeReady:
                            var returnNodeValueSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                                            slotNames,
                                                                            varI32ParamNames,
                                                                            lowering,

                                                                            share(typedFn),
                                                                            irFunction,
                                                                            stmt.rhsNodeIndex,
                                                                            callOrdinal)
                            if returnNodeValueSlot >= 0 &&
                               returnNodeTypeKind == coreir.LocalI64Tag &&
                               PrimaryBodyIrSlotType(bodyIR, returnNodeValueSlot) == coreir.LocalI32Tag:
                                returnNodeValueSlot = PrimaryBodyIrNodeEvalWidenToI64(bodyIR,
                                                                                      slotNames,
                                                                                      returnNodeValueSlot,
                                                                                      stmt.rhsNodeIndex,
                                                                                      3)
                            if returnNodeValueSlot >= 0:
                                PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                              currentBlockStart,
                                                              returnNodeValueSlot,
                                                              returnNodeTypeKind,
                                                              0,
                                                              false)
                                returnNodeDone = true
                        if returnNodeDone:
                            completedReturnLineNumber = stmt.lineNumber
                            PrimaryBodyIrNodeEvalOnlyOwn()
                            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=return function={typedFn.functionName} line={stmt.lineNumber}")
                            continue
                        if primaryBodyIrNodeEvalCallEmitCount != returnNodeEmitMark:
                            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                         stmt.lineNumber,
                                                         int32(stmt.kind),
                                                         6101,
                                                         0)
                            nextOpIndex = nextOpIndex + 1
                            completedReturnLineNumber = stmt.lineNumber
                            continue
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            var returnNodeMissOpText = primaryBodyIrNodeEvalMissOp
                            if returnNodeMissOpText == "":
                                returnNodeMissOpText = "return_shape"
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_miss op={returnNodeMissOpText} entry=return function={typedFn.functionName} line={stmt.lineNumber}")
                # 801 解封：`return cond ? s : "-"`（str 三元返回）。节点求值器对
                # str 三元诚实 miss（表达式层无分块上下文），此处在语句层（有
                # currentBlockStart）复用 decl 侧同款 cbr 三元下降
                # AppendStrTernaryDeclValue（真分支、仅选中臂求值、str 值按 24B
                # 整头写入目标槽——与 local_decl_str_ternary 路径值/宽语义完全同
                # 源），产值槽后接既有返回 term。嵌套 else 臂（classify 形
                # `a ? x : (b ? y : z)`）由该 helper 递归覆盖。不支持的臂形态由
                # helper 发 InvalidOp 毒标（805/806/807/809，与 decl 侧同契约），
                # 绝不落穿更弱文本路径。
                var retStrTernTypeKind: int32
                var retStrTernTypeSize: int32
                var retStrTernTypeAlign: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               typedFn.sourcePath,
                                               typedFn.returnType,
                                               retStrTernTypeKind,
                                               retStrTernTypeSize,
                                               retStrTernTypeAlign)
                if retStrTernTypeKind == coreir.LocalStrTag:
                    let retStrTernRhs = strutil.Strip(parser.ParserStripLineComment(valText))
                    var retStrTernText = PrimaryBodyIrStripOuterParens(retStrTernRhs)
                    if texpr.TypedExprFindTopLevelTextToken(retStrTernText, "?") <= 0:
                        retStrTernText = PrimaryBodyIrIfExprToTernaryText(retStrTernText)
                    if retStrTernText != "" &&
                       texpr.TypedExprFindTopLevelTextToken(retStrTernText, "?") > 0:
                        let retStrTernSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                           slotNames,
                                                                           Fmt"#ret_str_tern#{stmt.lineNumber}",
                                                                           coreir.LocalStrTag)
                        if retStrTernSlot >= 0 &&
                           PrimaryBodyIrAppendStrTernaryDeclValue(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,

                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt,
                                                                  stmt.rhsNodeIndex,
                                                                  retStrTernText,
                                                                  retStrTernSlot,
                                                                  callOrdinal,
                                                                  currentBlockStart):
                            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                          currentBlockStart,
                                                          retStrTernSlot,
                                                          coreir.LocalStrTag,
                                                          0,
                                                          false)
                            completedReturnLineNumber = stmt.lineNumber
                            if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=return_str_ternary function={typedFn.functionName} line={stmt.lineNumber}")
                            continue
                var returnRcNodeClaimsConstructor = false
                var returnRcIsErr = false
                var returnRcInnerType = ""
                var returnRcUseStmtArgs = false
                var returnRcArgStart = -1
                var returnRcArgCount = 0
                var returnRcSourcePath = strings.CloneStr(typedFn.sourcePath)
                var returnRcHead = ""
                var returnRcResultType = strings.CloneStr(typedFn.returnType)
                var returnRcContractRejected = false
                if stmt.rhsNodeIndex >= 0 && stmt.rhsNodeIndex < lowering.typedIr.nodes2_nodeIndexs.len:
                    let returnRcStmtLitRes: Result[str] = langintern.LookupIntern(lowering.typedIr.internPool, lowering.typedIr.nodes2_literalTextIds[stmt.rhsNodeIndex])
                    if IsOk(returnRcStmtLitRes) &&
                       PrimaryBodyIrResultConstructHead(Value(returnRcStmtLitRes), returnRcIsErr):
                        returnRcNodeClaimsConstructor = true
                for returnRcScanP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let returnRcScan = sameLineOrder[returnRcScanP]
                    let returnRcStmt = irFunction.statements[returnRcScan]
                    if returnRcStmt.kind != texpr.TypedExprIrStmtResultIntrinsic ||
                       !returnRcStmt.returnRoot:
                        continue
                    let returnRcDetailIsConstructor =
                        returnRcStmt.detailKind == parser.NormalizedExprDetailResultOk ||
                        returnRcStmt.detailKind == parser.NormalizedExprDetailResultErr
                    if !returnRcDetailIsConstructor:
                        continue
                    if !PrimaryBodyIrResultConstructorContract(lowering.typedIr,
                                                                typedFn,
                                                                irFunction,
                                                                returnRcStmt):
                        returnRcContractRejected = true
                        break
                    let returnRcLit = returnRcStmt.callCallee
                    var returnRcLineInner = texpr.TypedExprResultSuccessType(returnRcStmt.resultType)
                    if returnRcLineInner == "":
                        returnRcLineInner = texpr.TypedExprResultSuccessType(typedFn.returnType)
                    if returnRcLineInner != "":
                        returnRcIsErr = returnRcLit == "Err"
                        returnRcInnerType = strings.CloneStr(returnRcLineInner)
                        returnRcUseStmtArgs = true
                        returnRcArgStart = returnRcStmt.callArgNodeStart
                        returnRcArgCount = returnRcStmt.callArgCount
                        returnRcSourcePath = strings.CloneStr(returnRcStmt.sourcePath)
                        returnRcHead = strings.CloneStr(returnRcLit)
                        returnRcResultType = strings.CloneStr(returnRcStmt.resultType)
                        if returnRcResultType == "":
                            returnRcResultType = strings.CloneStr(typedFn.returnType)
                        break
                if returnRcNodeClaimsConstructor && !returnRcUseStmtArgs:
                    returnRcContractRejected = true
                if returnRcContractRejected:
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 0)
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    continue
                if returnRcUseStmtArgs:
                    var returnRcTypeKind: int32
                    var returnRcTypeSizeBytes: int32
                    var returnRcTypeAlignBytes: int32
                    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                   typedFn.sourcePath,
                                                   returnRcResultType,
                                                   returnRcTypeKind,
                                                   returnRcTypeSizeBytes,
                                                   returnRcTypeAlignBytes)
                    if returnRcTypeKind != coreir.LocalAggregateTag:
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     6101,
                                                     returnRcTypeKind)
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        continue
                    let returnRcSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                          slotNames,
                                                                          lowering.typedIr,
                                                                          typedFn.sourcePath,
                                                                          Fmt"#return_result_construct#{stmt.lineNumber}",
                                                                          returnRcResultType)
                    if returnRcSlot < 0:
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     6101,
                                                     0)
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        continue
                    let returnRcEmitMark = primaryBodyIrNodeEvalCallEmitCount
                    if PrimaryBodyIrAppendResultConstructFromArgLinks(bodyIR,
                                                                       slotNames,
                                                                       varI32ParamNames,
                                                                       lowering,

                                                                       typedFn,
                                                                       irFunction,
                                                                       returnRcSourcePath,
                                                                       stmt.lineNumber,
                                                                       returnRcHead,
                                                                       returnRcSlot,
                                                                       returnRcIsErr,
                                                                       returnRcInnerType,
                                                                       returnRcArgStart,
                                                                       returnRcArgCount,
                                                                       callOrdinal):
                        PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                      currentBlockStart,
                                                      returnRcSlot,
                                                      returnRcTypeKind,
                                                      0,
                                                      false)
                        completedReturnLineNumber = stmt.lineNumber
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        continue
                    var returnRcFailureDetail: int32
                    if primaryBodyIrNodeEvalCallEmitCount != returnRcEmitMark:
                        returnRcFailureDetail = 1
                    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                 stmt.lineNumber,
                                                 int32(stmt.kind),
                                                 6101,
                                                 returnRcFailureDetail)
                    PrimaryBodyIrNodeEvalOnlyOwn()
                    continue
            var returnRootStmtIndex: int32
            returnRootStmtIndex = -1
            for lookaheadIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                let lookaheadIndex = sameLineOrder[lookaheadIndexP]
                let lookaheadStmt = irFunction.statements[lookaheadIndex]
                if lookaheadStmt.kind != texpr.TypedExprIrStmtCall &&
                   lookaheadStmt.kind != texpr.TypedExprIrStmtLetCall:
                    continue
                if len(lookaheadStmt.callTarget) <= 0:
                    continue
                var lookaheadName = lookaheadStmt.bindingName
                if len(lookaheadName) <= 0:
                    lookaheadName = PrimaryBodyIrCallFullText(lookaheadStmt)
                if len(valText) > 0 && lookaheadName == valText:
                    returnRootStmtIndex = lookaheadIndex
                    break
                if returnRootStmtIndex < 0 && lookaheadStmt.returnRoot:
                    # Only treat the call as the return root when the whole
                    # return expression is a single call; wrapped expressions
                    # (derefs, arithmetic) must lower the full expression.
                    let rootWholeOpen = texpr.TypedExprFindWholeCallOpenParen(valText)
                    if rootWholeOpen > 0 &&
                       texpr.TypedExprFindMatchingParen(valText, rootWholeOpen) == len(valText) - 1:
                        returnRootStmtIndex = lookaheadIndex
            if returnRootStmtIndex >= 0:
                let rootStmt = irFunction.statements[returnRootStmtIndex]
                for callStmtIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let callStmtIndex = sameLineOrder[callStmtIndexP]
                    let callStmt = irFunction.statements[callStmtIndex]
                    if callStmtIndex == returnRootStmtIndex:
                        continue
                    if callStmt.kind != texpr.TypedExprIrStmtCall &&
                       callStmt.kind != texpr.TypedExprIrStmtLetCall:
                        continue
                    var primaryColdCond17: bool
                    var primaryColdCond17Clause0: bool
                    if len(callStmt.callTarget) <= 0:
                        if len(callStmt.surfaceText) <= 0:
                            primaryColdCond17Clause0 = true
                    if primaryColdCond17Clause0:
                        primaryColdCond17 = true
                    if primaryColdCond17:
                        continue
                    var dependencyName = callStmt.bindingName
                    if len(dependencyName) <= 0:
                        dependencyName = PrimaryBodyIrCallFullText(callStmt)
                    let resultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                        slotNames,
                                                                        lowering.typedIr,
                                                                        callStmt.sourcePath,
                                                                        dependencyName,
                                                                        callStmt.resultType)
                    let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                      slotNames,
                                                      lowering,

                                                      typedFn,
                                                      irFunction,
                                                      callStmt,
                                                      resultSlot,
                                                      varI32ParamNames,
                                                      callOrdinal,
                                                      currentBlockStart)
                    nextOpIndex = nextOpIndex + 1
                for assignDepIndexP in sameLineLo[stmtIndex]..<sameLineHi[stmtIndex]:
                    let assignDepIndex = sameLineOrder[assignDepIndexP]
                    let assignDepStmt = irFunction.statements[assignDepIndex]
                    if assignDepStmt.kind != texpr.TypedExprIrStmtAssign:
                        continue
                    if assignDepStmt.assignValueOpKind == texpr.TypedExprIrOpUnsupported:
                        continue
                    var assignDepName = assignDepStmt.bindingName
                    if len(assignDepName) <= 0:
                        assignDepName = assignDepStmt.surfaceText
                    if len(assignDepName) <= 0:
                        continue
                    let lhsSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames,
                                                           assignDepStmt.assignValueLhsText)
                    if lhsSlot < 0:
                        continue
                    let rhsSlot = PrimaryBodyIrFindArgSlot(bodyIR, slotNames,
                                                           assignDepStmt.assignValueRhsText)
                    if rhsSlot < 0:
                        PrimaryBodyIrAppendInvalidOp(
                            bodyIR,
                            assignDepStmt.lineNumber,
                            int32(assignDepStmt.kind),
                            62,
                            0)
                        continue
                    var opTypeKind = bodyIR.localSlots[lhsSlot].typeKind
                    let rhsTypeKind = bodyIR.localSlots[rhsSlot].typeKind
                    if opTypeKind != rhsTypeKind:
                        if opTypeKind == coreir.LocalI32Tag && rhsTypeKind == coreir.LocalI64Tag:
                            opTypeKind = coreir.LocalI64Tag
                        elif opTypeKind == coreir.LocalI64Tag && rhsTypeKind == coreir.LocalI32Tag:
                            opTypeKind = coreir.LocalI64Tag
                    let assignResultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                              slotNames,
                                                                              lowering.typedIr,
                                                                              assignDepStmt.sourcePath,
                                                                              assignDepName,
                                                                              assignDepStmt.resultType)
                    var binOp: coreir.BodyOp
                    binOp.kind = coreir.BodyOpBinOpTag
                    binOp.target = assignResultSlot
                    add(binOp.operands, opTypeKind)
                    add(binOp.operands, int32(assignDepStmt.assignValueOpKind))
                    add(binOp.operands, lhsSlot)
                    add(binOp.operands, rhsSlot)
                    let _ = coreir.BodyIRAppendOp(bodyIR, binOp)
                    nextOpIndex = nextOpIndex + 1
                var rootResultTypeKind: int32
                var rootResultTypeSizeBytes: int32
                var rootResultTypeAlignBytes: int32
                PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                               rootStmt.sourcePath,
                                               rootStmt.resultType,
                                               rootResultTypeKind,
                                               rootResultTypeSizeBytes,
                                               rootResultTypeAlignBytes)
                var rootResultName = rootStmt.bindingName
                if len(rootResultName) <= 0:
                    rootResultName = PrimaryBodyIrCallFullText(rootStmt)
                let rootResultSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                        slotNames,
                                                                        lowering.typedIr,
                                                                        rootStmt.sourcePath,
                                                                        rootResultName,
                                                                        rootStmt.resultType)
                let _ = PrimaryBodyIrAppendCallOp(bodyIR,
                                                  slotNames,
                                                  lowering,

                                                  typedFn,
                                                  irFunction,
                                                  rootStmt,
                                                  rootResultSlot,
                                                  varI32ParamNames,
                                                  callOrdinal,
                                                  currentBlockStart)
                PrimaryBodyIrAppendReturnTerm(bodyIR,
                                              currentBlockStart,
                                              rootResultSlot,
                                              rootResultTypeKind,
                                              0,
                                              false)
                nextOpIndex = nextOpIndex + 1
                completedReturnLineNumber = stmt.lineNumber
                handledReturnCall = true
            if handledReturnCall:
                continue
            if len(returnText) <= 0:
                # Bare `return` in a void function: surface text is empty.
                PrimaryBodyIrAppendReturnTerm(bodyIR,
                                              currentBlockStart,
                                              -1,
                                              coreir.LocalInvalidTag,
                                              0,
                                              false)
                PrimaryBodyIrNodeEvalOnlyOwn()
                continue
            if len(returnText) > 0:
                if PrimaryBodyIrTextHasCallSurface(valText):
                    # Owned override copy: must not move let typedFn (loop-live).
                    var statementReturnFn = texpr.TypedExprIrFunction(
                        sourcePath: strings.CloneStr(typedFn.sourcePath),
                        functionName: strings.CloneStr(typedFn.functionName),
                        returnType: strings.CloneStr(typedFn.returnType),
                        resultExprClass: typedFn.resultExprClass,
                        returnExpr: strings.CloneStr(valText),
                        signatureLineNumber: typedFn.signatureLineNumber,
                        endLineNumber: typedFn.endLineNumber,
                        bodyLineNumber: stmt.lineNumber,
                        statementStart: typedFn.statementStart,
                        statementCount: typedFn.statementCount,
                        nodeStart: typedFn.nodeStart,
                        nodeCount: typedFn.nodeCount,
                        returnNodeIndex: typedFn.returnNodeIndex,
                        valueDefinitionStart: typedFn.valueDefinitionStart,
                        valueDefinitionCount: typedFn.valueDefinitionCount,
                    )
                    if PrimaryBodyIrAppendReturnCallCompareZero(bodyIR,
                                                                slotNames,
                                                                lowering,

                                                                statementReturnFn,
                                                                irFunction,
                                                                varI32ParamNames,
                                                                valText,
                                                                stmt.lineNumber,
                                                                stmt.rhsNodeIndex,
                                                                currentBlockStart,
                                                                callOrdinal):
                        nextOpIndex = nextOpIndex + 1
                        completedReturnLineNumber = stmt.lineNumber
                        continue
                    if PrimaryBodyIrAppendReturnWholeCall(bodyIR,
                                                          slotNames,
                                                          lowering,

                                                          statementReturnFn,
                                                          irFunction,
                                                          varI32ParamNames,
                                                          stmt.rhsNodeIndex,
                                                          currentBlockStart,
                                                          callOrdinal):
                        nextOpIndex = nextOpIndex + 1
                        completedReturnLineNumber = stmt.lineNumber
                        continue
                    if PrimaryBodyIrAppendReturnResultConstructFromSameLine(bodyIR,
                                                                            slotNames,
                                                                            varI32ParamNames,
                                                                            lowering,

                                                                            typedFn,
                                                                            irFunction,
                                                                            stmtIndex,
                                                                            sameLineOrder,
                                                                            sameLineLo,
                                                                            sameLineHi,
                                                                            currentBlockStart,
                                                                            callOrdinal):
                        nextOpIndex = nextOpIndex + 1
                        completedReturnLineNumber = stmt.lineNumber
                        continue
                    if PrimaryBodyIrAppendReturnFieldArrayIndexedElemValue(bodyIR,
                                                                           slotNames,
                                                                           varI32ParamNames,
                                                                           lowering,

                                                                           statementReturnFn,
                                                                           irFunction,
                                                                           valText,
                                                                           stmt.rhsNodeIndex,
                                                                           currentBlockStart,
                                                                           callOrdinal):
                        nextOpIndex = nextOpIndex + 1
                        completedReturnLineNumber = stmt.lineNumber
                        continue
                    if PrimaryBodyIrAppendReturnAggregateConstructor(bodyIR,
                                                                     slotNames,
                                                                     varI32ParamNames,
                                                                     lowering,

                                                                     statementReturnFn,
                                                                     irFunction,
                                                                     valText,
                                                                     stmt.rhsNodeIndex,
                                                                     currentBlockStart,
                                                                     callOrdinal):
                        nextOpIndex = nextOpIndex + 1
                        completedReturnLineNumber = stmt.lineNumber
                        continue
                # 批 6 return 沉口: 返回位定长数组 bracket 字面量物化臂
                # (`return [e0, ...]`, 现落 801 bail; 无 call surface 的
                # bracket 文本在上方各臂之外, 此处先于常量回退认领)。
                if PrimaryBodyIrAppendReturnFixedArrayBracket(
                       bodyIR,
                       slotNames,
                       varI32ParamNames,
                       lowering,
                       typedFn,
                       irFunction,
                       valText,
                       stmt.rhsNodeIndex,
                       currentBlockStart,
                       callOrdinal):
                    nextOpIndex = nextOpIndex + 1
                    completedReturnLineNumber = stmt.lineNumber
                    continue
                let constVal = PrimaryBodyIrExtractIntFromText(valText)
                # The i32-const return terminator carries only a 32-bit value and
                # is materialized via a 16-bit movz; a wide literal (i64 return,
                # value outside int32 range) must NOT collapse into it or the
                # upper 16-bit groups (the movz+movk chain) are dropped. Detect
                # the full 64-bit value and route wide ones to the type-aware
                # slot path (real i64 LoadConst, 4-chunk materialize) below.
                var returnConstVal64: int64
                var returnConstFitsI32 = true
                if PrimaryBodyIrExtractInt64FromText(valText, returnConstVal64):
                    if returnConstVal64 > int64(2147483647) ||
                       returnConstVal64 < int64(0) - int64(2147483648):
                        returnConstFitsI32 = false
                if valText == "" || valText == "return":
                    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                  currentBlockStart,
                                                  -1,
                                                  coreir.LocalInvalidTag,
                                                  0,
                                                  false)
                elif valText == "nil":
                    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                  currentBlockStart,
                                                  -1,
                                                  coreir.LocalPtrTag,
                                                  0,
                                                  false)
                elif valText == "false":
                    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                  currentBlockStart,
                                                  -1,
                                                  coreir.LocalI32Tag,
                                                  0,
                                                  true)
                elif valText == "true":
                    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                  currentBlockStart,
                                                  -1,
                                                  coreir.LocalI32Tag,
                                                  1,
                                                  true)
                elif returnConstFitsI32 &&
                     (constVal != 0 || PrimaryBodyIrTextIsI32Zero(valText)):
                    PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                  currentBlockStart,
                                                  -1,
                                                  coreir.LocalI32Tag,
                                                  constVal,
                                                  true)
                else:
                    var returnTypeKind: int32
                    var returnTypeSizeBytes: int32
                    var returnTypeAlignBytes: int32
                    PrimaryBodyIrTypeShapeFromText(lowering.typedIr,
                                                   typedFn.sourcePath,
                                                   typedFn.returnType,
                                                   returnTypeKind,
                                                   returnTypeSizeBytes,
                                                   returnTypeAlignBytes)
                    if PrimaryObjectPlanTraceActive():
                        PrimaryObjectPlanTrace(Fmt"phase=return_shape function={typedFn.functionName} return_type={typedFn.returnType} type_kind={returnTypeKind} ir_enum_count={lowering.typedIr.enumValueTypes.len} val={valText}")
                    let initReturnSlot = PrimaryBodyIrLocalInitValueSlot(bodyIR,
                                                                         slotNames,
                                                                         varI32ParamNames,
                                                                         lowering.typedIr,
                                                                         typedFn.sourcePath,
                                                                         typedFn.returnType,
                                                                         returnTypeKind,
                                                                         valText, callOrdinal)
                    if initReturnSlot >= 0:
                        PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                      currentBlockStart,
                                                      initReturnSlot,
                                                      returnTypeKind,
                                                      0,
                                                      false)
                    elif (returnTypeKind == coreir.LocalI32Tag ||
                          returnTypeKind == coreir.LocalI64Tag ||
                          returnTypeKind == coreir.LocalF64Tag) &&
                         texpr.TypedExprFindTopLevelTextToken(valText, "?") > 0:
                        # return cond ? a : b：eager 无分支路径(initReturnSlot)只能处理
                        # cond 是纯 i32 值的三元；cond 是比较式(a > b)或臂含真调用时
                        # 它返回 -1 落到此处。这些一律走真分支 cbr 下降——
                        # PrimaryBodyIrEmitConditionOps 正确产 cmp+csel/cbr，只执行被
                        # 选中臂，根除"return 读未初始化槽"与"急切两臂求值"两类 miscompile。
                        let retTernSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                        slotNames,
                                                                        Fmt"#return_ternary#{stmt.lineNumber}",
                                                                        returnTypeKind)
                        if retTernSlot >= 0 &&
                           PrimaryBodyIrAppendScalarTernaryBlockValue(bodyIR,
                                                                      slotNames,
                                                                      varI32ParamNames,
                                                                      lowering,

                                                                      typedFn,
                                                                      irFunction,
                                                                      stmt.sourcePath,
                                                                      stmt.lineNumber,
                                                                      stmt.rhsNodeIndex,
                                                                      valText,
                                                                      retTernSlot,
                                                                      returnTypeKind,
                                                                      callOrdinal,
                                                                      currentBlockStart):
                            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                          currentBlockStart,
                                                          retTernSlot,
                                                          returnTypeKind,
                                                          0,
                                                          false)
                            completedReturnLineNumber = stmt.lineNumber
                        else:
                            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                         stmt.lineNumber,
                                                         int32(stmt.kind),
                                                         817,
                                                         0)
                            nextOpIndex = nextOpIndex + 1
                    elif returnTypeKind == coreir.LocalStrTag &&
                         PrimaryBodyIrTextIsStringLiteral(valText):
                        let litRetSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                       slotNames,
                                                                       Fmt"#return#str_literal#{bodyIR.cstringLiterals.len}",
                                                                       coreir.LocalStrTag)
                        if litRetSlot < 0 ||
                           !PrimaryBodyIrAppendStringLiteralValue(bodyIR,
                                                                  slotNames,
                                                                  valText,
                                                                  litRetSlot,
                                                                  callOrdinal):
                            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                         stmt.lineNumber,
                                                         int32(stmt.kind),
                                                         802,
                                                         0)
                            nextOpIndex = nextOpIndex + 1
                        else:
                            nextOpIndex = nextOpIndex + 1
                            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                          currentBlockStart,
                                                          litRetSlot,
                                                          returnTypeKind,
                                                          0,
                                                          false)
                            completedReturnLineNumber = stmt.lineNumber
                    elif returnTypeKind == coreir.LocalStrTag &&
                         texpr.TypedExprFindTopLevelTextToken(PrimaryBodyIrStripOuterParens(valText), "?") > 0:
                        # return cond ? a : b(str 臂)：与 str-ternary decl(:16739)同款 cbr
                        # 真分支下降,只执行被选中臂,写 targetSlot 后 return 该槽。一并关三洞:
                        # ①Len-cond(现 bail=801)②标量-cond 泄漏(旧 else 建未初始化槽 miscompile)
                        # ③无 paren `flag ? "a" : "b"`(不进 TextHasCallSurface,旧 else 同样建空槽)。
                        # helper 遇不支持臂形态时内部 poison(805)并返 true;返 false 则本层 poison 801。
                        let retStrTernText = PrimaryBodyIrStripOuterParens(valText)
                        let retStrTernSlot = PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                                           slotNames,
                                                                           Fmt"#return_str_ternary#{stmt.lineNumber}",
                                                                           coreir.LocalStrTag)
                        if retStrTernSlot >= 0 &&
                           PrimaryBodyIrAppendStrTernaryDeclValue(bodyIR,
                                                                  slotNames,
                                                                  varI32ParamNames,
                                                                  lowering,

                                                                  typedFn,
                                                                  irFunction,
                                                                  stmt,
                                                                  stmt.rhsNodeIndex,
                                                                  retStrTernText,
                                                                  retStrTernSlot,
                                                                  callOrdinal,
                                                                  currentBlockStart):
                            PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                          currentBlockStart,
                                                          retStrTernSlot,
                                                          returnTypeKind,
                                                          0,
                                                          false)
                            completedReturnLineNumber = stmt.lineNumber
                        else:
                            PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                         stmt.lineNumber,
                                                         int32(stmt.kind),
                                                         801,
                                                         0)
                            nextOpIndex = nextOpIndex + 1
                    elif PrimaryBodyIrAppendReturnScalarContext(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering.typedIr,
                                                                typedFn,
                                                                irFunction,
                                                                stmt.sourcePath,
                                                                stmt.lineNumber,
                                                                valText,
                                                                returnTypeKind,
                                                                currentBlockStart):
                        completedReturnLineNumber = stmt.lineNumber
                    elif PrimaryBodyIrAppendReturnBoolCondition(bodyIR,
                                                                slotNames,
                                                                lowering,

                                                                typedFn,
                                                                irFunction,
                                                                stmt.sourcePath,
                                                                stmt.lineNumber,
                                                                valText,
                                                                currentBlockStart,
                                                                callOrdinal,
                                                                nextOpIndex):
                        completedReturnLineNumber = stmt.lineNumber
                        continue
                    elif PrimaryBodyIrTextHasCallSurface(valText):
                        if PrimaryBodyIrAppendReturnResultConstructFromSameLine(bodyIR,
                                                                                slotNames,
                                                                                varI32ParamNames,
                                                                                lowering,

                                                                                typedFn,
                                                                                irFunction,
                                                                                stmtIndex,
                                                                                sameLineOrder,
                                                                                sameLineLo,
                                                                                sameLineHi,
                                                                                currentBlockStart,
                                                                                callOrdinal):
                            nextOpIndex = nextOpIndex + 1
                            completedReturnLineNumber = stmt.lineNumber
                            continue
                        # bail=801 STEP 1 scaffold: encode (failIndex<<8)|failCode into detail1.
                        # STEP 1 only sets reset values at function entry; STEP 2 will populate
                        # primaryAggCtorLastFailIndex/Code at the 20 return-false sites.
                        # Until STEP 2 lands, detail1 reads (-1<<8)|0 = -256 (sentinel = scaffold active).
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     801,
                                                     (primaryAggCtorLastFailIndex << 8) | primaryAggCtorLastFailCode)
                        nextOpIndex = nextOpIndex + 1
                        continue
                    else:
                        # Resolve through the context-aware scalar resolver
                        # first (ptr->field reads etc. emit their loads
                        # there); a bare find-or-create would hand the
                        # return term an uninitialized slot.
                        var valSlot: int32 = -1
                        if returnTypeKind == coreir.LocalI32Tag ||
                           returnTypeKind == coreir.LocalI64Tag ||
                           returnTypeKind == coreir.LocalF64Tag ||
                           returnTypeKind == coreir.LocalPtrTag:
                            valSlot = PrimaryBodyIrContextScalarValueSlotForText(bodyIR,
                                                                                 slotNames,
                                                                                 varI32ParamNames,
                                                                                 lowering.typedIr,
                                                                                 share(typedFn),
                                                                                 irFunction,
                                                                                 stmt.sourcePath,
                                                                                 stmt.lineNumber,
                                                                                 valText,
                                                                                 returnTypeKind)
                        if valSlot < 0:
                            valSlot = PrimaryBodyIrFindOrCreateTypedSlot(bodyIR,
                                                                         slotNames,
                                                                         lowering.typedIr,
                                                                         typedFn.sourcePath,
                                                                         valText,
                                                                         typedFn.returnType)
                        PrimaryBodyIrAppendReturnTerm(bodyIR,
                                                      currentBlockStart,
                                                      valSlot,
                                                      returnTypeKind,
                                                      0,
                                                      false)
        elif stmt.kind == texpr.TypedExprIrStmtIf:
            PrimaryObjectPlanGuardTick()
            if PrimaryObjectPlanProgressEnabled():
                PrimaryObjectPlanProgress(Fmt"if_branch_begin function={typedFn.functionName} line={stmt.lineNumber} surface_len={stmt.surfaceText.len}")
            # 批次6e：条件已节点化且探针可降（i32/bool）时经节点求值器
            # 产出条件槽，分支结构复用文本路径同款单 Cbr（nonzero）管线。
            # 探针失败落回文本路径；求值在调用已发射后失败禁止落回。
            if stmt.rhsNodeIndex >= 0:
                primaryBodyIrNodeEvalMissOp = ""
                let ifNodeProbeKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 lowering,

                                                                 share(typedFn),
                                                                 irFunction,
                                                                 stmt.rhsNodeIndex)
                if ifNodeProbeKind == coreir.LocalI32Tag:
                    let ifNodeEmitMark = primaryBodyIrNodeEvalCallEmitCount
                    let ifNodeSuccessBlock = bodyIR.blocks.len + 1
                    let ifNodeCondSlot = PrimaryBodyIrEvalNode(bodyIR,
                                                               slotNames,
                                                               varI32ParamNames,
                                                               lowering,

                                                               share(typedFn),
                                                               irFunction,
                                                               stmt.rhsNodeIndex,
                                                               callOrdinal)
                    if ifNodeCondSlot >= 0:
                        var ifNodeCbrTerm: coreir.BodyTerm
                        ifNodeCbrTerm.kind = coreir.BodyTermCbrTag
                        ifNodeCbrTerm.conditionKind = coreir.BodyCondLocalNonZeroTag
                        ifNodeCbrTerm.lhsSlot = ifNodeCondSlot
                        ifNodeCbrTerm.rhsSlot = -1
                        ifNodeCbrTerm.trueBlock = ifNodeSuccessBlock
                        ifNodeCbrTerm.falseBlock = -1
                        ifNodeCbrTerm.resultSlot = -1
                        let ifNodeTermIndex = coreir.BodyIRAppendTerm(bodyIR, ifNodeCbrTerm)
                        let ifNodeBlockOpCount = bodyIR.ops.len - currentBlockStart
                        let _ = coreir.BodyIRAppendBlock(bodyIR,
                                                         currentBlockStart,
                                                         ifNodeBlockOpCount,
                                                         ifNodeTermIndex)
                        currentBlockStart = bodyIR.ops.len
                        pendingCompoundFalseTerms = []
                        add(pendingCompoundFalseTerms, ifNodeTermIndex)
                        pendingFalseTerm = ifNodeTermIndex
                        pendingIfFalseBodyEnd = PrimaryBodyIrIfBodyEnd(irFunction.statements,
                                                                               stmtIndex,
                                                                               stmtEnd)
                        add(ifEndStk, PrimaryBodyIrStructuredBodyEnd(irFunction.statements, stmtIndex, stmtEnd))
                        add(ifSeqStk, constructSeq)
                        constructSeq = constructSeq + 1
                        add(ifIndentStk, stmt.lineIndent)
                        add(ifFalseStartStk, ifFalsePool.len)
                        add(ifFalsePool, ifNodeTermIndex)
                        add(ifJoinStartStk, ifJoinBrPool.len)
                        PrimaryBodyIrNodeEvalOnlyOwn()
                        PrimaryBodyIrConsumeHeaderConditionCallFeeders(irFunction.statements,
                                                                       stmtIndex,
                                                                       stmtEnd,
                                                                       PrimaryBodyIrConditionText(stmt.surfaceText),
                                                                       callFeederEmittedIndexes)
                        if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                            os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=if_cond function={typedFn.functionName} line={stmt.lineNumber}")
                        continue
                    if primaryBodyIrNodeEvalCallEmitCount != ifNodeEmitMark:
                        PrimaryBodyIrAppendInvalidOp(bodyIR,
                                                     stmt.lineNumber,
                                                     int32(stmt.kind),
                                                     6101,
                                                     0)
                        continue
                let ifNodeRootOp = lowering.typedIr.nodes2_opKinds[stmt.rhsNodeIndex]
                if ifNodeRootOp == texpr.TypedExprIrOpLogAnd ||
                   ifNodeRootOp == texpr.TypedExprIrOpLogOr ||
                   ifNodeRootOp == texpr.TypedExprIrOpLogNot:
                    if PrimaryBodyIrNodeCondChainProbe(bodyIR,
                                                       slotNames,
                                                       varI32ParamNames,
                                                       lowering,

                                                       typedFn,
                                                       irFunction,
                                                       stmt.rhsNodeIndex):
                        let ifChainCount = PrimaryBodyIrNodeCondCbrBlockCount(lowering.typedIr, stmt.rhsNodeIndex)
                        if ifChainCount > 1:
                            let ifChainEmitMark = primaryBodyIrNodeEvalCallEmitCount
                            let ifChainBlocksMark = bodyIR.blocks.len
                            let ifChainSuccessBlock = bodyIR.blocks.len + ifChainCount
                            pendingCompoundFalseTerms = []
                            if PrimaryBodyIrNodeEmitCondCbrChain(bodyIR,
                                                                 slotNames,
                                                                 varI32ParamNames,
                                                                 lowering,

                                                                 typedFn,
                                                                 irFunction,
                                                                 stmt.rhsNodeIndex,
                                                                 ifChainSuccessBlock,
                                                                 -1,
                                                                 callOrdinal,
                                                                 currentBlockStart,
                                                                 pendingCompoundFalseTerms):
                                if pendingCompoundFalseTerms.len > 0:
                                    pendingFalseTerm = pendingCompoundFalseTerms[pendingCompoundFalseTerms.len - 1]
                                pendingIfFalseBodyEnd = PrimaryBodyIrIfBodyEnd(irFunction.statements,
                                                                               stmtIndex,
                                                                               stmtEnd)
                                add(ifEndStk, PrimaryBodyIrStructuredBodyEnd(irFunction.statements, stmtIndex, stmtEnd))
                                add(ifSeqStk, constructSeq)
                                constructSeq = constructSeq + 1
                                add(ifIndentStk, stmt.lineIndent)
                                add(ifFalseStartStk, ifFalsePool.len)
                                for ifci in 0..<pendingCompoundFalseTerms.len:
                                    add(ifFalsePool, pendingCompoundFalseTerms[ifci])
                                add(ifJoinStartStk, ifJoinBrPool.len)
                                PrimaryBodyIrNodeEvalOnlyOwn()
                                PrimaryBodyIrConsumeHeaderConditionCallFeeders(irFunction.statements,
                                                                               stmtIndex,
                                                                               stmtEnd,
                                                                               PrimaryBodyIrConditionText(stmt.surfaceText),
                                                                               callFeederEmittedIndexes)
                                if os.GetEnv("CHENG_PRIMARY_OBJECT_FAIL_TRACE") == "1":
                                    os.WriteLine(os.GetStderr(), Fmt"phase=node_eval_hit op=if_cond_chain function={typedFn.functionName} line={stmt.lineNumber}")
