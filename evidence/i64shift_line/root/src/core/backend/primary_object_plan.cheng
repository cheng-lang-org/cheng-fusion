                return coreir.LocalAggregateTag
            if probeRcArgNodes.len != 1:
                return PrimaryBodyIrNodeEvalMissAt("result_construct")
            let probeRcPayloadKind = PrimaryBodyIrNodeEvalProbe(bodyIR,
                                                                slotNames,
                                                                varI32ParamNames,
                                                                lowering,

                                                                typedFn,
                                                                irFunction,
                                                                probeRcArgNodes[0])
