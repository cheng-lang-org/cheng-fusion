    PrimaryObjectPlanAppendLine(out, "op_delta", strings.IntToStr(plan.bodyIREGraphOpDelta))
    PrimaryObjectPlanAppendLine(out, "egraph_ms", strings.IntToStr(plan.bodyIREGraphMs))
    return out

fn PrimaryObjectPlanReport(plan: var PrimaryObjectPlan): str =
    var symbolText = "-"
    if plan.symbolNames.len > 0:
        symbolText = strutil.Join(plan.symbolNames, ",")
    var bodyKindText = "-"
    if plan.functionBodyKinds.len > 0:
        bodyKindText = strutil.Join(plan.functionBodyKinds, ",")
    var statementReturnModeText = "-"
    if plan.functionStatementReturnModes.len > 0:
        statementReturnModeText = PrimaryObjectPlanIntListText(plan.functionStatementReturnModes)
    var statementCallCountText = "-"
    if plan.functionStatementCallCounts.len > 0:
        statementCallCountText = PrimaryObjectPlanIntListText(plan.functionStatementCallCounts)
    var functionIrIndexText = "-"
    if plan.functionIrIndexes.len > 0:
        functionIrIndexText = PrimaryObjectPlanIntListText(plan.functionIrIndexes)
    var wordOffsetText = "-"
    if plan.functionWordOffsets.len > 0:
        wordOffsetText = PrimaryObjectPlanIntListText(plan.functionWordOffsets)
    var wordCountText = "-"
    if plan.functionWordCounts.len > 0:
        wordCountText = PrimaryObjectPlanIntListText(plan.functionWordCounts)
    var firstMissingFunction = "-"
    if len(plan.error.functionName) > 0:
        firstMissingFunction = plan.error.functionName
    var firstMissingBodyKind = "-"
    if len(plan.error.bodyKind) > 0:
        firstMissingBodyKind = plan.error.bodyKind
    var firstMissingTypedIrKind = "-"
    if len(plan.error.typedIrKind) > 0:
        firstMissingTypedIrKind = plan.error.typedIrKind
    var out = ""
    PrimaryObjectPlanAppendLine(out, "primary_object_format", plan.objectFormat)
    PrimaryObjectPlanAppendLine(out, "primary_object_actual_pipeline_stage", plan.actualPipelineStage)
    PrimaryObjectPlanAppendLine(out, "primary_object_actual_backend_kind", plan.actualBackendKind)
    PrimaryObjectPlanAppendLine(
        out, "primary_object_debug_section_plan_consumed",
        if plan.debugSectionPlanConsumed: "1" else: "0")
    PrimaryObjectPlanAppendLine(
        out, "primary_object_semantic_debug_binding_receipt_cid",
        layout.FixedBytes32Hex(
            plan.semanticDebugBindingReceipt.receiptCid))
    PrimaryObjectPlanAppendLine(
        out, "primary_object_debug_section_plan_receipt_cid",
        layout.FixedBytes32Hex(plan.debugSectionPlanReceipt.receiptCid))
    PrimaryObjectPlanAppendLine(out, "primary_object_actual_node_eval_only_active", if plan.actualNodeEvalOnlyActive: "1" else: "0")
    PrimaryObjectPlanAppendLine(out, "primary_object_seq_add_candidate_count", strings.IntToStr(plan.seqAddCandidateCount))
    PrimaryObjectPlanAppendLine(out, "primary_object_seq_add_typed_contract_count", strings.IntToStr(plan.seqAddTypedContractCount))
    PrimaryObjectPlanAppendLine(out, "primary_object_structured_seq_add_consume_count", strings.IntToStr(plan.structuredSeqAddConsumeCount))
    PrimaryObjectPlanAppendLine(out, "primary_object_seq_add_node_probe_hit_count", strings.IntToStr(plan.seqAddNodeProbeHitCount))
    PrimaryObjectPlanAppendLine(out, "primary_object_seq_add_type_mismatch_count", strings.IntToStr(plan.seqAddTypeMismatchCount))
    PrimaryObjectPlanAppendLine(out, "primary_object_seq_add_legacy_text_consume_count", strings.IntToStr(plan.seqAddLegacyTextConsumeCount))
    PrimaryObjectPlanAppendLine(out, "primary_object_seq_add_node_eval_gap_count", strings.IntToStr(plan.seqAddNodeEvalGapCount))
    PrimaryObjectPlanAppendLine(out, "primary_object_structured_result_intrinsic_consume_count", strings.IntToStr(plan.structuredResultIntrinsicConsumeCount))
    PrimaryObjectPlanAppendLine(out, "primary_object_item_count", strings.IntToStr(plan.itemIds.len))
    PrimaryObjectPlanAppendLine(out, "primary_object_reachable_function_count", strings.IntToStr(plan.reachableFunctionCount))
    PrimaryObjectPlanAppendLine(out, "primary_object_symbols", symbolText)
    PrimaryObjectPlanAppendLine(
        out,
        "primary_object_symbol_name_intern_pool_domain_cid",
        layout.FixedBytes32Hex(
            plan.symbolNameInternPoolDomainCid))
    PrimaryObjectPlanAppendLine(
        out,
        "primary_object_symbol_lowering_identity_receipt_cid",
        layout.FixedBytes32Hex(
            plan.symbolLoweringIdentityReceiptCid))
    PrimaryObjectPlanAppendLine(
