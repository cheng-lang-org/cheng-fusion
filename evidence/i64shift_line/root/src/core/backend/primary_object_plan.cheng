var primaryBodyIrGlobalNameIndexFingerprint: int32
# Current-function shift-signedness context. The base scalar slot builder
# (PrimaryBodyIrScalarValueSlotForText) lacks typedFn/irFunction and so could
# only detect an unsigned *cast* LHS for `>>` — a bare unsigned param/local
# (`fn lsr(a: uint32, n: uint32) = a >> n`) fell through to the signed `asr`
# default. The per-function lowering entry publishes the function identity +
# param name/type lists here so the base shift block can resolve the LHS type
# (params + locals) and pick lsr vs asr correctly without threading context
# through 80+ call sites.
var primaryBodyIrCurrentShiftCtxValid: bool
var primaryBodyIrCurrentShiftCtxSourcePath: str
var primaryBodyIrCurrentShiftCtxFunctionName: str
var primaryBodyIrCurrentShiftCtxEndLine: int32
var primaryBodyIrCurrentShiftCtxParamNames: str[]
var primaryBodyIrCurrentShiftCtxParamTypes: str[]
var primaryBodyIrFunctionLookupSourcePaths: str[]
var primaryBodyIrFunctionSourceIndexes: int32[]
var primaryBodyIrFunctionTailNames: str[]
# Tail-name chained hash index over typedIr.functions: every match in
# PrimaryBodyIrTargetFunctionIndex requires the candidate's tail name to equal
# the lookup tail name, so bucketing by tail name lets each lookup iterate only
# the matching bucket (O(bucket)) instead of scanning all functions (O(nfns)).
var primaryBodyIrFunctionTailBucketHeads: int32[]
var primaryBodyIrFunctionTailEntryTails: str[]
var primaryBodyIrFunctionTailEntryFnIndexes: int32[]
var primaryBodyIrFunctionTailEntryNext: int32[]
var primaryObjectIrFunctionIndexBucketHeads: int32[]
var primaryObjectIrFunctionIndexEntryNames: str[]
var primaryObjectIrFunctionIndexEntryFunctionIndexes: int32[]
var primaryObjectIrFunctionIndexEntryNext: int32[]
var primaryObjectIrFunctionIndexBuiltCount: int32
var primaryObjectIrFunctionIndexFingerprint: int32
# 审计#3 根治：global name→index 哈希（R18 PrimaryObjectIrFunctionIndex 同范式）。
# typedIr.globalNames 在 body-IR 下降期静态只读，Prepare 一次后只读 → 并行安全。
# Call-target resolver tail-name hash index over lowering.functionSymbolTexts /
# lowering.functionNames. PrimaryFunctionTargetIndex* matchers only match a
# candidate when its exact text equals targetText OR its tail name equals
# targetTail (= PrimaryCallTargetTailName(targetText)), so bucketing both
# arrays by tail name lets each lookup walk only its bucket (O(bucket)) instead
# of all functions (O(nfns)). functionSymbolTexts/functionNames are immutable
# during planning, so the index is built once per planning run. Built on demand
# and reset by PrimaryBodyIrResetLookupCaches.
var primaryPlanResolveSymbolTailBucketHeads: int32[]
var primaryPlanResolveSymbolTailEntryTails: str[]
var primaryPlanResolveSymbolTailEntryFnIndexes: int32[]
var primaryPlanResolveSymbolTailEntryNext: int32[]
var primaryPlanResolveNameTailBucketHeads: int32[]
var primaryPlanResolveNameTailEntryTails: str[]
var primaryPlanResolveNameTailEntryFnIndexes: int32[]
var primaryPlanResolveNameTailEntryNext: int32[]
var primaryPlanResolveBuiltCount: int32
# Darwin AArch64 packs stack arguments by natural size/alignment instead of
# AAPCS64 8-byte slots. Set once per plan build from the link target triple
# before any (possibly parallel) word-count/fill phase runs.
var primaryDarwinPackedStackArgs: bool

@borrows
fn PrimaryObjectPlanSetPackedStackArgsForTriple(targetTriple: str) =
    primaryDarwinPackedStackArgs = contract.CodegenUnitPacksStackArgs(targetTriple)

@borrows
fn PrimaryDarwinPackedStackArgsActive(): bool =
    return primaryDarwinPackedStackArgs

# S7 sentinel-2 Indexed routing (Ptr base + raw index + SIB fold) is only understood
# by the x86_64 body emitter arm-1; every other backend must keep the retired
# precomputed-address / madd+deref paths. Set once per plan build, same lifecycle
# as primaryDarwinPackedStackArgs above.
var primaryX64SibRouteActive: bool

@borrows
fn PrimaryObjectPlanSetSibRouteForTriple(targetTriple: str) =
    primaryX64SibRouteActive = contract.CodegenUnitUsesSibRoute(targetTriple)

fn PrimaryObjectPlanTraceInit() =
    if primaryObjectPlanTraceInitialized:
        return
    primaryObjectPlanTraceInitialized = true
    primaryObjectPlanTracePath = strutil.Strip(os.GetEnv("CHENG_PRIMARY_OBJECT_TRACE"))
    primaryObjectPlanTraceFilter = strutil.Strip(os.GetEnv("CHENG_PRIMARY_OBJECT_TRACE_FILTER"))

@borrows
fn PrimaryObjectPlanTrace(line: str) =
    PrimaryObjectPlanTraceInit()
    if len(primaryObjectPlanTracePath) <= 0:
        return
    if len(primaryObjectPlanTraceFilter) > 0 && !strutil.Contains(line, primaryObjectPlanTraceFilter):
        return
    var openRes = os.OpenAppendResult(primaryObjectPlanTracePath)
    if !result.IsOk(openRes):
        panic("primary_object_trace_open_failed")
    let handle = result.Value(openRes)
    var bytes = rawbytes.BytesFromString(Fmt"{line}\n")
    var writeRes = os.WriteAllBytesResult(handle, bytes)
    if !result.IsOk(writeRes):
        panic("primary_object_trace_write_failed")
    var closeRes = os.CloseFileResult(handle)
    if !result.IsOk(closeRes):
        panic("primary_object_trace_close_failed")

@borrows
fn PrimaryObjectPlanTraceActive(): bool =
    PrimaryObjectPlanTraceInit()
    return len(primaryObjectPlanTracePath) > 0

var primaryObjectPlanProgressInitialized: bool
var primaryObjectPlanProgressEnabledFlag: bool

@borrows
fn PrimaryObjectPlanProgressEnabled(): bool =
    if !primaryObjectPlanProgressInitialized:
        primaryObjectPlanProgressInitialized = true
        let primaryProgress = strutil.Strip(os.GetEnv("CHENG_PRIMARY_OBJECT_PROGRESS"))
        let globalProgress = strutil.Strip(os.GetEnv("CHENG_PROGRESS"))
        primaryObjectPlanProgressEnabledFlag = false
        if primaryProgress != "":
            primaryObjectPlanProgressEnabledFlag = true
        elif globalProgress == "primary_object_detail":
            primaryObjectPlanProgressEnabledFlag = true
    return primaryObjectPlanProgressEnabledFlag

fn PrimaryObjectPlanGuardTick() =
    os.ProcessResourceGuardCheck()

@borrows
fn PrimaryObjectPlanProgress(label: str) =
    os.ProcessResourceGuardCheck()
    if !PrimaryObjectPlanProgressEnabled():
        return
    os.WriteLine(os.GetStderr(), Fmt"compile_progress phase=primary_object_plan detail={label}")

var primaryObjectPlanDebugInitialized: bool
var primaryObjectPlanDebugEnabledFlag: bool

@borrows
fn PrimaryObjectPlanDebugEnabled(): bool =
    if !primaryObjectPlanDebugInitialized:
        primaryObjectPlanDebugInitialized = true
        primaryObjectPlanDebugEnabledFlag = cmdline.ParamStr(2) == "--debug-system-link-exec"
    return primaryObjectPlanDebugEnabledFlag

var primaryObjectPlanLowerRssInitialized: bool
var primaryObjectPlanLowerRssEnabledFlag: bool

# CHENG_PRIMARY_LOWER_RSS is probed inside the per-function lowering loop;
# per-call os.GetEnv allocates ~32B per probe, so cache it once per process.
fn PrimaryObjectPlanLowerRssEnabled(): bool =
    if !primaryObjectPlanLowerRssInitialized:
        primaryObjectPlanLowerRssInitialized = true
        primaryObjectPlanLowerRssEnabledFlag = os.GetEnv("CHENG_PRIMARY_LOWER_RSS") != ""
    return primaryObjectPlanLowerRssEnabledFlag

@borrows
fn PrimaryObjectPlanDebugLine(line: str) =
    if !PrimaryObjectPlanDebugEnabled():
        return
    os.WriteLine(os.GetStderr(), Fmt"debug_primary_object_plan={line}")
    if PrimaryObjectPlanLowerRssEnabled():
        os.WriteLine(os.GetStderr(), Fmt"debug_phase_rss line={line} rss={os.ProcessRssBytes()}")

@borrows
fn PrimaryObjectMetadataTextStable(text: str): bool =
    return metadataauthority.MetadataTextStable(text)

fn PrimaryObjectStatementKindCodeText(kind: int32): str =
    if kind == int32(texpr.TypedExprIrStmtLocalDecl):
        return "local_decl"
    if kind == int32(texpr.TypedExprIrStmtLetCall):
        return "let_call"
    if kind == int32(texpr.TypedExprIrStmtIfCall):
        return "if_call"
    if kind == int32(texpr.TypedExprIrStmtCall):
        return "call"
    if kind == int32(texpr.TypedExprIrStmtResultIntrinsic):
        return "result_intrinsic"
    if kind == int32(texpr.TypedExprIrStmtReturn):
        return "return"
    if kind == int32(texpr.TypedExprIrStmtAssign):
        return "assign"
    if kind == int32(texpr.TypedExprIrStmtIf):
        return "if"
    if kind == int32(texpr.TypedExprIrStmtElif):
        return "elif"
    if kind == int32(texpr.TypedExprIrStmtElse):
        return "else"
    if kind == int32(texpr.TypedExprIrStmtFor):
        return "for"
    if kind == int32(texpr.TypedExprIrStmtMatch):
        return "match"
    if kind == int32(texpr.TypedExprIrStmtCase):
        return "case"
    if kind == int32(texpr.TypedExprIrStmtWhile):
        return "while"
    return "unsupported"

@borrows
fn PrimaryBodyIrNodeEvalOnlyActive(): bool =
    if !primaryBodyIrNodeEvalOnlyInitialized:
        primaryBodyIrNodeEvalOnlyInitialized = true
        primaryBodyIrNodeEvalOnlyFlag = os.GetEnv("CHENG_NODE_EVAL_ONLY") == "1"
        primaryBodyIrNodeEvalOnlyCensusedFunctions = []
    return primaryBodyIrNodeEvalOnlyFlag

@borrows
fn PrimaryBodyIrNodeEvalOnlyOwn() =
    primaryBodyIrNodeEvalOnlyOwned = true

@borrows
fn PrimaryBodyIrNodeEvalOnlyWiredKind(kind: int32): bool =
    return kind == int32(texpr.TypedExprIrStmtAssign) ||
           kind == int32(texpr.TypedExprIrStmtLocalDecl) ||
           kind == int32(texpr.TypedExprIrStmtLetCall) ||
           kind == int32(texpr.TypedExprIrStmtCall) ||
           kind == int32(texpr.TypedExprIrStmtReturn) ||
           kind == int32(texpr.TypedExprIrStmtIf) ||
           kind == int32(texpr.TypedExprIrStmtElif) ||
           kind == int32(texpr.TypedExprIrStmtWhile) ||
           kind == int32(texpr.TypedExprIrStmtIfCall) ||
           kind == int32(texpr.TypedExprIrStmtFor) ||
           kind == int32(texpr.TypedExprIrStmtResultIntrinsic)

@borrows
fn PrimaryBodyIrNodeEvalOnlyEntryText(kind: int32): str =
    if kind == int32(texpr.TypedExprIrStmtIf):
        return "if_cond"
    if kind == int32(texpr.TypedExprIrStmtElif):
        return "elif_cond"
    if kind == int32(texpr.TypedExprIrStmtWhile):
        return "while_cond"
    if kind == int32(texpr.TypedExprIrStmtCall):
        return "bare_call"
    return PrimaryObjectStatementKindCodeText(kind)

@borrows
fn PrimaryBodyIrNodeEvalOnlyCensusedIndex(fnKey: str): int32 =
    for i in 0..<primaryBodyIrNodeEvalOnlyCensusedFunctions.len:
        if primaryBodyIrNodeEvalOnlyCensusedFunctions[i] != fnKey:
            continue
        return i
    return -1

@borrows
fn PrimaryBodyIrNodeEvalOnlyEnterFunction(sourcePath: str,
                                           functionName: str,
                                           phantom: bool) =
    if !PrimaryBodyIrNodeEvalOnlyActive():
        return
    primaryBodyIrNodeEvalOnlyPending = false
    primaryBodyIrNodeEvalOnlyOwned = false
    # Uninstantiated generic templates (setLen/reserve/new/Value/delete/freeSeqPtr,
    # signature carries a [T] placeholder) and inlined backend builtins
    # (elemSize/add/clear...) are NEVER emitted as standalone object code: the
    # emit-root gate (PrimaryObjectPlanFunctionIsGenericTemplate, line ~39024) already
    # excludes them and `nm artifacts/backend_driver/cheng` shows zero defined symbols
    # for them in the production self-host binary (they lower inline at each call
    # site). They reach this census only because an entry-less library --emit:obj
    # build blanket-seeds every function as an emit root (emitObjectRootsAllFunctions).
    # Censusing their node-eval coverage is a census/production scope mismatch, so
    # suppress them — this mirrors the exact emission scope the real backend uses; it
    # does not hide any function the production build actually emits.
    if phantom:
        primaryBodyIrNodeEvalOnlySuppress = true
        return
    let fnKey = strutil.Join([strings.CloneStr(sourcePath),
                              "#",
                              strings.CloneStr(functionName)], "")
    if PrimaryBodyIrNodeEvalOnlyCensusedIndex(fnKey) >= 0:
        primaryBodyIrNodeEvalOnlySuppress = true
        return
    add(primaryBodyIrNodeEvalOnlyCensusedFunctions, fnKey)
    primaryBodyIrNodeEvalOnlySuppress = false

@borrows
fn PrimaryBodyIrNodeEvalOnlyBegin(functionName: str,
                                   stmt: lower.PrimaryObjectIrStatement) =
    primaryBodyIrNodeEvalOnlyPending = true
    primaryBodyIrNodeEvalOnlyOwned = false
    primaryBodyIrNodeEvalOnlyKind = int32(stmt.kind)
    primaryBodyIrNodeEvalOnlyNodeIndex = stmt.rhsNodeIndex
    primaryBodyIrNodeEvalOnlyFunction = strings.CloneStr(functionName)
    primaryBodyIrNodeEvalOnlySource = strings.CloneStr(stmt.sourcePath)
    primaryBodyIrNodeEvalOnlyLine = stmt.lineNumber
    primaryBodyIrNodeEvalOnlyStmt = strings.CloneStr(stmt.surfaceText)
    primaryBodyIrNodeEvalOnlySurfaceKind = int32(stmt.callSurfaceKind)
    primaryBodyIrNodeEvalMissOp = ""

@borrows
fn PrimaryBodyIrNodeEvalOnlyFlush(bodyIR: var coreir.BodyIR) =
    if !primaryBodyIrNodeEvalOnlyPending:
        return
    primaryBodyIrNodeEvalOnlyPending = false
    if primaryBodyIrNodeEvalOnlyOwned:
        return
    let gapKind = primaryBodyIrNodeEvalOnlyKind
    if gapKind == int32(texpr.TypedExprIrStmtElse):
        return
    let gapEntry = strings.CloneStr(PrimaryBodyIrNodeEvalOnlyEntryText(gapKind))
    let gapNodeIndex = primaryBodyIrNodeEvalOnlyNodeIndex
    let gapFunction = strings.CloneStr(primaryBodyIrNodeEvalOnlyFunction)
    let gapSource = strings.CloneStr(primaryBodyIrNodeEvalOnlySource)
    let gapLine = primaryBodyIrNodeEvalOnlyLine
    var gapReason = strings.CloneStr(primaryBodyIrNodeEvalMissOp)
    if gapReason == "":
        if !PrimaryBodyIrNodeEvalOnlyWiredKind(gapKind):
            gapReason = strutil.Join(["unwired_kind_", strings.IntToStr(gapKind)], "")
        elif gapNodeIndex < 0:
            gapReason = strings.CloneStr("no_node")
        else:
            gapReason = strings.CloneStr("node_path_skip")
    var gapStmt = strings.CloneStr(primaryBodyIrNodeEvalOnlyStmt)
    if gapStmt == "":
        gapStmt = strings.CloneStr(gapEntry)
    let gapSurfaceKind = primaryBodyIrNodeEvalOnlySurfaceKind
    if !primaryBodyIrNodeEvalOnlySuppress:
        os.WriteLine(os.GetStderr(), strutil.Join(["phase=node_eval_only_gap entry=",
                                                   gapEntry,
                                                   " reason=",
                                                   gapReason,
                                                   " function=",
                                                   gapFunction,
                                                   " source=",
                                                   gapSource,
                                                   " line=",
                                                   strings.IntToStr(gapLine),
                                                   " stmt=",
                                                   gapStmt,
                                                   " surface_kind=",
                                                   strings.IntToStr(gapSurfaceKind)], ""))
    PrimaryBodyIrAppendInvalidOp(bodyIR,
                                 gapLine,
                                 gapKind,
                                 6102,
                                 0)

type
    PrimaryBodyIrSeqEnumIdentityStatus = enum PrimaryBodyIrSeqEnumNotEnum, PrimaryBodyIrSeqEnumResolved
    PrimaryBodyIrSeqEnumArgClass = enum PrimaryBodyIrSeqEnumArgNonEnum, PrimaryBodyIrSeqEnumArgSame, PrimaryBodyIrSeqEnumArgMismatch, PrimaryBodyIrSeqEnumArgStructure
    PrimaryBodyIrNodeBoolChainOutcome = enum PrimaryBodyIrNodeBoolChainNotApplicable, PrimaryBodyIrNodeBoolChainSuccess, PrimaryBodyIrNodeBoolChainClaimedFailed
    PrimaryBodyIrNodeBoolChainCheckpoint =
        opCount: int32
        callOpCount: int32
        slotCount: int32
        blockCount: int32
        termCount: int32
        cstringCount: int32
        slotNameCount: int32
        callOrdinal: int32
        currentBlockStart: int32
        nodeEvalCallEmitCount: int32
        nodeEvalMissOp: str
        irCallArgCountCount: int32
        irCallTargetCount: int32
        irCallTargetSourcePathCount: int32
        irCallTargetSignatureLineNumberCount: int32
        irCallTargetImportcFlagCount: int32
        irCallImportcSymbolCount: int32
    PrimaryBodyIrNodeBoolChainTransactionReceipt =
        cacheEntryContractProved: bool
        preRollbackOpDelta: int32
        preRollbackCallDelta: int32
        preRollbackSlotDelta: int32
        preRollbackBlockDelta: int32
        preRollbackTermDelta: int32
        preRollbackCStringDelta: int32
        preRollbackSlotNameDelta: int32
        preRollbackIrCallRowDelta: int32
        prefixSlotMutationCount: int32
        prefixSlotNameMutationCount: int32
        prefixOpMutationCount: int32
        prefixCallMutationCount: int32
        prefixTermMutationCount: int32
        prefixIrCallRowMutationCount: int32
        commitCount: int32
        rollbackCount: int32
        poisonCount: int32
    # Bool-chain emission journals actual prefix rewrites and keeps new
    # name-index rows in an overlay until commit, so rollback cost is
    # O(transaction delta), not O(function size).
    PrimaryBodyIrNodeBoolChainMutationJournal =
        active: bool
        opPrefixCount: int32
        callPrefixCount: int32
        slotPrefixCount: int32
        termPrefixCount: int32
        slotNamePrefixCount: int32
        irCallRowPrefixCount: int32
        slotMutationIndexes: int32[]
        slotMutationOldValues: coreir.LocalSlot[]
        slotNameMutationIndexes: int32[]
        slotNameMutationOldValues: str[]
        opMutationIndexes: int32[]
        opMutationOldValues: coreir.BodyOp[]
        callMutationIndexes: int32[]
        callMutationOldValues: coreir.CallOp[]
        termMutationIndexes: int32[]
        termMutationOldValues: coreir.BodyTerm[]
        newSlotNames: str[]
        newSlotIndexes: int32[]
        irCallRowMutationOrdinals: int32[]
        irCallArgCountOldValues: int32[]
        irCallTargetOldValues: str[]
        irCallTargetSourcePathOldValues: str[]
        irCallTargetSignatureLineNumberOldValues: int32[]
        irCallTargetImportcFlagOldValues: bool[]
        irCallImportcSymbolOldValues: str[]
    # Receipt counters consume this sealed lowering result. There is no alternate
    # text outcome: an unowned shape remains a gap and every owned failure is a
    # structured hard-fail.
