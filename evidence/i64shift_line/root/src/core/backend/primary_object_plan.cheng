const
    PrimaryObjectSymbolRoleTypedName: int32 =
        lower.LoweringFunctionSymbolRoleTypedName
    PrimaryObjectSymbolRoleExplicitExport: int32 =
        lower.LoweringFunctionSymbolRoleExplicitExport
    PrimaryObjectSymbolRoleSourceEntry: int32 =
        lower.LoweringFunctionSymbolRoleSourceEntry
    PrimaryObjectSymbolRoleSyntheticEntryBridge: int32 = 4
    # Entry-bridge runtime call contract roles. Values mirror the link-time
    # runtime provider contract
    # (provider_export_identity_receipt.cheng ProviderExportContractRole*);
    # primary_object_plan.cheng does not import that module, so the exact
    # values are restated here next to their only primary-backend consumer.
    PrimaryEntryBridgeRuntimeCallRoleSetCmdLine: int32 = 1
    PrimaryEntryBridgeRuntimeCallRoleRegisterLineMap: int32 = 2
    PrimaryEntryBridgeRuntimeCallRoleProfileFlush: int32 = 3

fn primaryBodyIrCleanupSourceProjectionCid(
        lowering: var lower.LoweringPlanStub,
        typedFunctionIndex: int32): layout.FixedBytes32 =
    let zeroCid = layout.FixedBytes32()
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >=
           lowering.snapshotFunctionIdsByTypedFunctionIndex.len ||
       typedFunctionIndex >=
           lowering.snapshotFunctionFragmentCidsByTypedFunctionIndex.len ||
       layout.FixedBytes32Equal(
           lowering.canonicalSnapshotProjectionAuthorityCid, zeroCid) ||
       layout.FixedBytes32Equal(
           lowering.semanticSnapshotCargoCid, zeroCid):
        panic("primary body ir cleanup source authority missing")
    var interfaceCid: layout.FixedBytes32
    if !lower.LoweringPlanFunctionInterfaceCidAt(
           lowering, typedFunctionIndex, interfaceCid):
        panic("primary body ir cleanup function interface authority missing")
    let functionId =
        lowering.snapshotFunctionIdsByTypedFunctionIndex[
            typedFunctionIndex]
    let fragmentCid =
        lowering.snapshotFunctionFragmentCidsByTypedFunctionIndex[
            typedFunctionIndex]
    var authorityHandle =
        lowering.compilerSnapshotLoweringAuthority.core
    let factsRootCid =
        layout.FixedBytes32Copy(lowering.semanticSnapshotFactsRootCid)
    let loweringAuthorityCid =
        layout.FixedBytes32Copy(
            lowering.semanticSnapshotLoweringAuthorityCid)
    let fragmentCidCopy = layout.FixedBytes32Copy(fragmentCid)
    let interfaceCidCopy = layout.FixedBytes32Copy(interfaceCid)
    return cleanupauthority.CsgCoreBodyIrCleanupSourceProjectionCid(
        authorityHandle,
        factsRootCid,
        functionId,
        typedFunctionIndex,
        fragmentCidCopy,
        interfaceCidCopy,
        loweringAuthorityCid)

fn primaryBodyIrBindCleanupSourceProjection(
        bodyIR: var coreir.BodyIR,
        lowering: var lower.LoweringPlanStub,
        typedFunctionIndex: int32) =
    if bodyIR.controlFunctionRow != typedFunctionIndex:
        panic("primary body ir cleanup function identity mismatch")
    let projectionCid =
        primaryBodyIrCleanupSourceProjectionCid(
            lowering, typedFunctionIndex)
    coreir.BodyIRBindCleanupSourceProjectionCid(
        bodyIR, projectionCid)

