            if lowering.typedIr.nodes2_opKinds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)] == texpr.TypedExprIrOpNilPtr:
                probeNilValueNode = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex)
            elif lowering.typedIr.nodes2_opKinds[arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand1NodeIndexs, nodeIndex)] == texpr.TypedExprIrOpNilPtr:
                probeNilValueNode = arenamod.ArenaArrayInt32Get(lowering.typedIr.arena, lowering.typedIr.nodes2_operand0NodeIndexs, nodeIndex)
