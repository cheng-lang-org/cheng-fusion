# codegen_regalloc_adapter_units.cheng —— regalloc 单元直调聚合门面（B8 表键侧）
#
# 承接 Step1 闭合：kernel 文件 regalloc_production_emitter 原直接 import
# regalloc_{aarch64,x86_64,riscv}_adapter 三个 arch 单元，构成
# direct_violations=3（kernel→arch）。按 codegen_writer_units（B2）与
# codegen_linker_units（B7）同一形态收编：本模块按 unitId switch 直调各
# 单元入口——零间接调用，字节路径与原 kernel 直调逐字节相同。
#
# 未命中语义：调用方 regallocProductionPlanAndRecipesInto 在派发前已用
# triple→unitId 硬枚举（缺 triple 由 RegallocProductionEmitTargetUnsupported
# 提前 return false），故本门面收到的 unitId 必中一臂；仍保留显式未命中臂
# 返回 valid=false / errorDetail=-1 的 reject 形（同 riscv adapter 的
# RvIsaXlenOk 拒收形，errorDetail 取调用方既有的 -1 不支持码），不设兜底
# 默认臂、不静默假绿。
#
# 参数风格：与四个 adapter 入口逐参数同形（var 形参原样透传）；本门面标
# @borrows（同 codegen_writer_units 门面口径，透传不消费）。
#
# 归属：shared-format。三 adapter 本体分别归 aarch64 / x86_64 / riscv64
# 插件桶；内核只经本门面消费，零 arch import。
import std/strings
import cheng/core/ir/core_types as coreir
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/std/bytes_layout as layout
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/regalloc_aarch64_adapter as a64adapter
import cheng/core/backend/regalloc_x86_64_adapter as x8664adapter
import cheng/core/backend/regalloc_riscv_adapter as riscvadapter

@borrows
fn CodegenRegallocAdapterUnitPrepareFunctionRecipes(
        unitId: int32,
        bodyIR: var coreir.BodyIR,
        plan: var alloc.RegallocSinglePassValuePlan,
        symbolName: str,
        encoderSourceRow: int32,
        encoderSourceCid: layout.FixedBytes32,
        slotDataSymbols: var str[],
        cstringDataSymbols: var str[]): contract.RegallocA64FunctionRecipes =
    if unitId == contract.CodegenUnitA64:
        return a64adapter.RegallocA64CodegenUnitPrepareFunctionRecipes(
            bodyIR, plan, strings.CloneStr(symbolName), encoderSourceRow,
            encoderSourceCid, slotDataSymbols, cstringDataSymbols)
    if unitId == contract.CodegenUnitX64:
        return x8664adapter.RegallocX64CodegenUnitPrepareFunctionRecipes(
            bodyIR, plan, strings.CloneStr(symbolName), encoderSourceRow,
            encoderSourceCid, slotDataSymbols, cstringDataSymbols)
    if unitId == contract.CodegenUnitRv64:
        return riscvadapter.RegallocRiscvCodegenUnitPrepareFunctionRecipes64(
            bodyIR, plan, strings.CloneStr(symbolName), encoderSourceRow,
            encoderSourceCid, slotDataSymbols, cstringDataSymbols)
    if unitId == contract.CodegenUnitRv32:
        return riscvadapter.RegallocRiscvCodegenUnitPrepareFunctionRecipes32(
            bodyIR, plan, strings.CloneStr(symbolName), encoderSourceRow,
            encoderSourceCid, slotDataSymbols, cstringDataSymbols)
    var rejected: contract.RegallocA64FunctionRecipes
    rejected.valid = false
    rejected.errorDetail = -1
    return rejected
