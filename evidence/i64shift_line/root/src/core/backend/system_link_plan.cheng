@borrows
fn SystemLinkPlanTextLess(left: str, right: str): bool =
    let sharedLen = left.len < right.len ? left.len : right.len
    for charIndex in 0..<sharedLen:
        if left[charIndex] < right[charIndex]:
            return true
        if left[charIndex] > right[charIndex]:
            return false
    return left.len < right.len

@borrows
fn SystemLinkPlanModuleOwnedByPackage(modulePath: str,
                                       packageId: str): bool =
    # parser.cheng 派生对包 cheng 有 std/ runtime/ 特殊命名空间分支（不带
    # cheng/ 前缀），ownership 谓词必须与派生一致，否则所有 std/runtime
    # 模块在 portable source binding 处 fail-fast（实测 os/times 全中）。
    if packageId == "cheng":
        if strings.HasPrefix(modulePath, "std/") ||
           strings.HasPrefix(modulePath, "runtime/"):
            return true
    if modulePath.len <= packageId.len ||
       modulePath[packageId.len] != '/':
        return false
    for index in 0..<packageId.len:
        if modulePath[index] != packageId[index]:
            return false
    return true

# Exact within-root test over the same anchor root set used by
# ParserSourcePathToModulePathExactWithExternalPackageRootsInto
# (packageRoot, workspaceRoot, external package roots).  Both inputs must
# already be canonical lexical absolute paths.
@borrows
fn SystemLinkPlanSourcePathUnderRoot(path: str, root: str): bool =
    if root == "" || !parser.ParserSourceIdentityPathAbsolute(path):
        return false
    if root == "/":
        return true
    if path.len <= root.len:
        return false
    if chengpath.TextSlice(path, 0, root.len) != root:
        return false
    return path[root.len] == '/'

@borrows
fn SystemLinkPlanSourcePathWithinRoots(path: str,
                                       workspaceRoot: str,
                                       packageRoot: str,
                                       externalPackageRoots: parser.ParserExternalPackageRoot[]): bool =
    if SystemLinkPlanSourcePathUnderRoot(path, packageRoot) ||
       SystemLinkPlanSourcePathUnderRoot(path, workspaceRoot):
        return true
    for rootIndex in 0..<externalPackageRoots.len:
        if SystemLinkPlanSourcePathUnderRoot(
                path,
                externalPackageRoots[rootIndex].packageRoot):
            return true
    return false

# Per-row exact identity: in-root rows derive their exact module path;
# root-out rows have no module anchor and their canonical absolute source
# file path is the exact identity.  The two domains never collide because
# module paths are never absolute.
@borrows
fn SystemLinkPlanSourceRowIdentityInto(
        workspaceRoot: str,
        packageRoot: str,
        packageId: str,
        externalPackageRoots: parser.ParserExternalPackageRoot[],
        sourcePath: str,
        out: var str): bool =
    out = ""
    if SystemLinkPlanSourcePathWithinRoots(sourcePath,
                                           workspaceRoot,
                                           packageRoot,
                                           externalPackageRoots):
        return parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
            workspaceRoot,
            packageRoot,
            packageId,
            externalPackageRoots,
            sourcePath,
            out)
    out = sourcePath
    return true

# Parser-collected edges name a root-out owner by its file stem (the parser
# has no module identity for it).  Map that stem to the unique root-out
# closure row and return its row index; duplicate stems hard-fail so the
# upgrade never guesses.
@borrows
fn SystemLinkPlanRootOutOwnerRowIndex(sourceClosurePaths: str[],
                                      ownerModulePaths: str[],
                                      ownerStem: str): int32 =
    if ownerStem == "":
        return -1
    var matchIndex = -1
    for sourceIndex in 0..<sourceClosurePaths.len:
        if !parser.ParserSourceIdentityPathAbsolute(
                ownerModulePaths[sourceIndex]):
            continue
        if parser.ParserFileStem(sourceClosurePaths[sourceIndex]) !=
           ownerStem:
            continue
        if matchIndex >= 0:
            return -1
        matchIndex = sourceIndex
    return matchIndex

@borrows
fn SystemLinkPlanExternalRootLess(
        left: parser.ParserExternalPackageRoot,
        right: parser.ParserExternalPackageRoot): bool =
    if left.canonicalPackageId != right.canonicalPackageId:
        return SystemLinkPlanTextLess(left.canonicalPackageId,
                                      right.canonicalPackageId)
    if left.packageRoot != right.packageRoot:
        return SystemLinkPlanTextLess(left.packageRoot, right.packageRoot)
    if left.channel != right.channel:
        return SystemLinkPlanTextLess(left.channel, right.channel)
    return SystemLinkPlanTextLess(left.packageId, right.packageId)

@borrows
fn SystemLinkPlanExternalRootEqual(
        left: parser.ParserExternalPackageRoot,
        right: parser.ParserExternalPackageRoot): bool =
    if left.packageId != right.packageId ||
       left.canonicalPackageId != right.canonicalPackageId ||
       left.packageRoot != right.packageRoot ||
       left.channel != right.channel ||
       left.verifiedSnapshotRequired != right.verifiedSnapshotRequired ||
       left.verifiedSourcePaths.len != right.verifiedSourcePaths.len ||
       left.verifiedSourceTexts.len != right.verifiedSourceTexts.len:
        return false
    for sourceIndex in 0..<left.verifiedSourcePaths.len:
        if left.verifiedSourcePaths[sourceIndex] !=
               right.verifiedSourcePaths[sourceIndex] ||
           left.verifiedSourceTexts[sourceIndex] !=
               right.verifiedSourceTexts[sourceIndex]:
            return false
    return true

@borrows
fn systemLinkPlanExternalRootOwnedLessAt(
        packageId: str,
        canonicalPackageId: str,
        packageRoot: str,
        channel: str,
        right: parser.ParserExternalPackageRoot[],
        rightIndex: int32): bool =
    if canonicalPackageId != right[rightIndex].canonicalPackageId:
        return SystemLinkPlanTextLess(canonicalPackageId,
                                      right[rightIndex].canonicalPackageId)
    if packageRoot != right[rightIndex].packageRoot:
        return SystemLinkPlanTextLess(packageRoot, right[rightIndex].packageRoot)
    if channel != right[rightIndex].channel:
        return SystemLinkPlanTextLess(channel, right[rightIndex].channel)
    return SystemLinkPlanTextLess(packageId, right[rightIndex].packageId)

@borrows
fn systemLinkPlanExternalRootEqualAt(
        left: parser.ParserExternalPackageRoot[],
        leftIndex: int32,
        right: parser.ParserExternalPackageRoot[],
        rightIndex: int32): bool =
    if left[leftIndex].packageId != right[rightIndex].packageId ||
       left[leftIndex].canonicalPackageId !=
           right[rightIndex].canonicalPackageId ||
       left[leftIndex].packageRoot != right[rightIndex].packageRoot ||
       left[leftIndex].channel != right[rightIndex].channel ||
       left[leftIndex].verifiedSnapshotRequired !=
           right[rightIndex].verifiedSnapshotRequired ||
       left[leftIndex].verifiedSourcePaths.len !=
           right[rightIndex].verifiedSourcePaths.len ||
       left[leftIndex].verifiedSourceTexts.len !=
           right[rightIndex].verifiedSourceTexts.len:
        return false
    return systemLinkPlanExternalRootEqualTextsRec(left, leftIndex, right,
                                                   rightIndex, 0)

@borrows
fn systemLinkPlanExternalRootEqualTextsRec(
        left: parser.ParserExternalPackageRoot[],
        leftIndex: int32,
        right: parser.ParserExternalPackageRoot[],
        rightIndex: int32,
        sourceIndex: int32): bool =
    if sourceIndex >= left[leftIndex].verifiedSourcePaths.len:
        return true
    if left[leftIndex].verifiedSourcePaths[sourceIndex] !=
           right[rightIndex].verifiedSourcePaths[sourceIndex] ||
       left[leftIndex].verifiedSourceTexts[sourceIndex] !=
           right[rightIndex].verifiedSourceTexts[sourceIndex]:
        return false
    return systemLinkPlanExternalRootEqualTextsRec(left, leftIndex, right,
                                                   rightIndex, sourceIndex + 1)

@borrows
fn systemLinkPlanCloneStrColRec(src: str[], dest: var str[], i: int32) =
    if i >= src.len:
        return
    add(dest, strings.CloneStr(src[i]))
    systemLinkPlanCloneStrColRec(src, dest, i + 1)

@borrows
fn systemLinkPlanAppendExternalRootFrom(
        dest: var parser.ParserExternalPackageRoot[],
        src: parser.ParserExternalPackageRoot[],
        srcIndex: int32) =
    var item: parser.ParserExternalPackageRoot
    var clonedPaths: str[]
    var clonedTexts: str[]
    item.packageId = strings.CloneStr(src[srcIndex].packageId)
    item.canonicalPackageId = strings.CloneStr(src[srcIndex].canonicalPackageId)
    item.packageRoot = strings.CloneStr(src[srcIndex].packageRoot)
    item.channel = strings.CloneStr(src[srcIndex].channel)
    item.verifiedSnapshotRequired = src[srcIndex].verifiedSnapshotRequired
    systemLinkPlanCloneRootStrColRec(src, srcIndex, false,
                                     clonedPaths, 0)
    systemLinkPlanCloneRootStrColRec(src, srcIndex, true,
                                     clonedTexts, 0)
    item.verifiedSourcePaths = clonedPaths
    item.verifiedSourceTexts = clonedTexts
    add(dest, item)

@borrows
fn systemLinkPlanAppendExternalRootOwned(
        dest: var parser.ParserExternalPackageRoot[],
        packageId: str,
        canonicalPackageId: str,
        packageRoot: str,
        channel: str,
        verified: bool,
        srcRows: parser.ParserExternalPackageRoot[],
        srcIndex: int32) =
    var item: parser.ParserExternalPackageRoot
    item.packageId = strings.CloneStr(packageId)
    item.canonicalPackageId = strings.CloneStr(canonicalPackageId)
    item.packageRoot = strings.CloneStr(packageRoot)
    item.channel = strings.CloneStr(channel)
    item.verifiedSnapshotRequired = verified
    if srcIndex >= 0:
        systemLinkPlanCloneRootStrColRec(srcRows, srcIndex, false,
                                         item.verifiedSourcePaths, 0)
        systemLinkPlanCloneRootStrColRec(srcRows, srcIndex, true,
                                         item.verifiedSourceTexts, 0)
    add(dest, item)

@borrows
fn systemLinkPlanCloneRootStrColRec(
        src: parser.ParserExternalPackageRoot[],
        srcIndex: int32,
        texts: bool,
        dest: var str[],
        i: int32) =
    var n: int32
    if texts:
        n = src[srcIndex].verifiedSourceTexts.len
    else:
        n = src[srcIndex].verifiedSourcePaths.len
    if i >= n:
        return
    if texts:
        add(dest, strings.CloneStr(src[srcIndex].verifiedSourceTexts[i]))
    else:
        add(dest, strings.CloneStr(src[srcIndex].verifiedSourcePaths[i]))
    systemLinkPlanCloneRootStrColRec(src, srcIndex, texts, dest, i + 1)

@borrows
fn systemLinkPlanInsertExternalRootCopyRec(
        oldRows: parser.ParserExternalPackageRoot[],
        packageId: str,
        canonicalPackageId: str,
        packageRoot: str,
        channel: str,
        verified: bool,
        srcRows: parser.ParserExternalPackageRoot[],
        srcIndex: int32,
        outRows: var parser.ParserExternalPackageRoot[],
        i: int32,
        inserted: bool) =
    if i >= oldRows.len:
        if !inserted:
            systemLinkPlanAppendExternalRootOwned(
                outRows, packageId, canonicalPackageId, packageRoot, channel,
                verified, srcRows, srcIndex)
        return
    if !inserted &&
       systemLinkPlanExternalRootOwnedLessAt(packageId, canonicalPackageId,
                                             packageRoot, channel, oldRows, i):
        systemLinkPlanAppendExternalRootOwned(
            outRows, packageId, canonicalPackageId, packageRoot, channel,
            verified, srcRows, srcIndex)
        inserted = true
    systemLinkPlanAppendExternalRootFrom(outRows, oldRows, i)
    systemLinkPlanInsertExternalRootCopyRec(
        oldRows, packageId, canonicalPackageId, packageRoot, channel,
        verified, srcRows, srcIndex, outRows, i + 1, inserted)

@borrows
fn systemLinkPlanUniqueExternalRootsRec(
        canonical: parser.ParserExternalPackageRoot[],
        unique: var parser.ParserExternalPackageRoot[],
        i: int32) =
    if i >= canonical.len:
        return
    if unique.len > 0 &&
       systemLinkPlanExternalRootEqualAt(unique, unique.len - 1, canonical, i):
        systemLinkPlanUniqueExternalRootsRec(canonical, unique, i + 1)
        return
    systemLinkPlanAppendExternalRootFrom(unique, canonical, i)
    systemLinkPlanUniqueExternalRootsRec(canonical, unique, i + 1)

@borrows
fn systemLinkPlanCanonicalExternalPackageRootsRec(
        roots: parser.ParserExternalPackageRoot[],
        canonical: var parser.ParserExternalPackageRoot[],
        rootIndex: int32,
        err: var str): bool =
    if rootIndex >= roots.len:
        err = ""
        return true
    let importPrefix = parser.ParserManifestNormalizePackageId(
        roots[rootIndex].packageId)
    let canonicalPackageId = parser.ParserManifestNormalizePackageId(
        roots[rootIndex].canonicalPackageId)
    var packageRoot: str
    if importPrefix == "" || canonicalPackageId == "" ||
       !parser.ParserSourceIdentityLexicalPathInto(
           roots[rootIndex].packageRoot,
           packageRoot) ||
       !parser.ParserSourceIdentityPathAbsolute(packageRoot):
        err = Fmt" system link plan: external package root certificate invalid index={rootIndex}"
        return false
    let channel = chengpath.PathTrim(strings.CloneStr(roots[rootIndex].channel))
    var verified = roots[rootIndex].verifiedSnapshotRequired
    if verified:
        if channel != "" ||
           !parser.ParserExternalPackageRootSnapshotValidate(roots[rootIndex]):
            err = Fmt" system link plan: verified external source snapshot invalid index={rootIndex}"
            return false
    var nextRows: parser.ParserExternalPackageRoot[]
    systemLinkPlanInsertExternalRootCopyRec(
        canonical, importPrefix, canonicalPackageId, packageRoot, channel,
        verified, roots, rootIndex, nextRows, 0, false)
    canonical = nextRows
    return systemLinkPlanCanonicalExternalPackageRootsRec(
        roots, canonical, rootIndex + 1, err)

@borrows
fn SystemLinkPlanCanonicalExternalPackageRootsInto(
        roots: parser.ParserExternalPackageRoot[],
        out: var parser.ParserExternalPackageRoot[],
        err: var str): bool =
    var canonical: parser.ParserExternalPackageRoot[]
    if !systemLinkPlanCanonicalExternalPackageRootsRec(roots, canonical, 0, err):
        return false
    var unique: parser.ParserExternalPackageRoot[]
    systemLinkPlanUniqueExternalRootsRec(canonical, unique, 0)
    out = unique
    err = ""
    return true

@borrows
fn SystemLinkPlanTextIndex(items: str[], value: str): int32 =
    for itemIndex in 0..<items.len:
        if items[itemIndex] == value:
            return itemIndex
    return -1

@borrows
fn SystemLinkPlanImportEdgeEqual(left: parser.ImportEdge,
                                  right: parser.ImportEdge): bool =
    return left.ownerModulePath == right.ownerModulePath &&
           left.targetModulePath == right.targetModulePath &&
           left.targetSourcePath == right.targetSourcePath &&
           left.targetSourcePathLen == right.targetSourcePathLen &&
           left.targetSourcePathFirstCode == right.targetSourcePathFirstCode &&
           left.targetSourcePathLastCode == right.targetSourcePathLastCode &&
           left.targetSourcePathDotCount == right.targetSourcePathDotCount &&
           left.targetSourcePathHash == right.targetSourcePathHash &&
           left.targetProfileIndex == right.targetProfileIndex &&
           left.importAlias == right.importAlias &&
           left.qualifier == right.qualifier &&
           left.allowsUnqualifiedCall == right.allowsUnqualifiedCall &&
           left.resolved == right.resolved

@borrows
fn SystemLinkPlanCanonicalImportEdgesInto(
        sourceClosurePaths: str[],
        ownerModulePaths: str[],
        importEdges: parser.ImportEdge[],
        expectedUnresolvedImportCount: int32,
        out: var parser.ImportEdge[],
        err: var str): bool =
    if sourceClosurePaths.len != ownerModulePaths.len ||
       expectedUnresolvedImportCount < 0:
        err = " system link plan: import graph identity columns invalid"
        return false
    var canonical: parser.ImportEdge[]
    var actualUnresolvedImportCount: int32
    for edgeIndex in 0..<importEdges.len:
        var edge = share(importEdges[edgeIndex])
        var ownerRowIndex = SystemLinkPlanTextIndex(ownerModulePaths,
                                                    edge.ownerModulePath)
        if ownerRowIndex < 0:
            ownerRowIndex = SystemLinkPlanRootOutOwnerRowIndex(
                sourceClosurePaths,
                ownerModulePaths,
                edge.ownerModulePath)
        if ownerRowIndex < 0:
            err = Fmt" system link plan: import edge owner outside exact closure index={edgeIndex} owner={edge.ownerModulePath}"
            return false
        edge.ownerModulePath = strings.CloneStr(
            ownerModulePaths[ownerRowIndex])
        var canonicalTargetSourcePath: str
        if edge.targetSourcePath != "":
            var lexicalTargetSourcePath: str
            if !parser.ParserSourceIdentityLexicalPathInto(
                    edge.targetSourcePath,
                    lexicalTargetSourcePath) ||
               !parser.ParserSourceIdentityPathAbsolute(
                   lexicalTargetSourcePath):
                err = Fmt" system link plan: import edge target source invalid index={edgeIndex}"
                return false
            canonicalTargetSourcePath = strings.CloneStr(
                lexicalTargetSourcePath)
        if edge.resolved:
            let targetSourceIndex = SystemLinkPlanTextIndex(
                sourceClosurePaths,
                canonicalTargetSourcePath)
            if targetSourceIndex < 0 ||
               targetSourceIndex >= ownerModulePaths.len:
                err = Fmt" system link plan: resolved import target outside exact closure index={edgeIndex} source={canonicalTargetSourcePath}"
                return false
            edge.targetSourcePath = strings.CloneStr(
                sourceClosurePaths[targetSourceIndex])
            edge.targetModulePath = strings.CloneStr(
                ownerModulePaths[targetSourceIndex])
        else:
            actualUnresolvedImportCount = actualUnresolvedImportCount + 1
            if edge.targetSourcePath != "":
                edge.targetSourcePath = strings.CloneStr(
                    canonicalTargetSourcePath)
            edge.targetModulePath = strings.CloneStr(
                edge.targetModulePath)
            if edge.targetModulePath == "":
                err = Fmt" system link plan: unresolved import target module missing index={edgeIndex}"
                return false
        edge.targetSourcePathLen = edge.targetSourcePath.len
        if edge.targetSourcePath == "":
            edge.targetSourcePathFirstCode = 0
            edge.targetSourcePathLastCode = 0
            edge.targetSourcePathDotCount = 0
            edge.targetSourcePathHash = 0
        else:
            edge.targetSourcePathFirstCode = Int32(edge.targetSourcePath[0])
            edge.targetSourcePathLastCode =
                Int32(edge.targetSourcePath[edge.targetSourcePath.len - 1])
            edge.targetSourcePathDotCount =
                parser.ParserTextLookupDotCount(edge.targetSourcePath)
            edge.targetSourcePathHash =
                parser.ParserTextLookupContentHash(edge.targetSourcePath)
        edge.targetProfileIndex = -1
        edge.importAlias = chengpath.PathTrim(
            strings.CloneStr(edge.importAlias))
        let aliasText = parser.ParserIdentPrefix(edge.importAlias)
        if aliasText != "":
            edge.qualifier = strings.CloneStr(aliasText)
        else:
            let sourceStem = parser.ParserFileStem(edge.targetSourcePath)
            if sourceStem != "":
                edge.qualifier = strings.CloneStr(sourceStem)
            else:
                edge.qualifier = strings.CloneStr(
                    parser.ParserLastPathPiece(edge.targetModulePath))
        edge.allowsUnqualifiedCall = edge.importAlias == ""
        add(canonical, share(edge))
    if actualUnresolvedImportCount != expectedUnresolvedImportCount:
        err = Fmt" system link plan: unresolved import count mismatch expected={expectedUnresolvedImportCount} actual={actualUnresolvedImportCount}"
        return false
    out = canonical
    err = ""
    return true

@borrows
fn SystemLinkPlanRebuildImportEdgesFromTextsInto(
        workspaceRoot: str,
        packageRoot: str,
        packageId: str,
        externalPackageRoots: parser.ParserExternalPackageRoot[],
        sourceClosurePaths: str[],
        ownerModulePaths: str[],
        sourceTexts: str[],
        entrySourceIndex: int32,
        out: var parser.ImportEdge[],
        outUnresolvedImportCount: var int32,
        err: var str): bool =
    if sourceClosurePaths.len <= 0 ||
       sourceClosurePaths.len != ownerModulePaths.len ||
       sourceClosurePaths.len != sourceTexts.len ||
       entrySourceIndex < 0 ||
       entrySourceIndex >= sourceClosurePaths.len:
        err = " system link plan: exact import graph source columns mismatch"
        return false
    var parsedEdges: parser.ImportEdge[]
    for sourceIndex in 0..<sourceClosurePaths.len:
        var sourceImportSpecs: parser.ParserImportSpec[]
        if !parser.ParserReadImportSpecs(
                ownerModulePaths[sourceIndex],
                sourceTexts[sourceIndex],
                sourceImportSpecs,
                err):
            return false
        for edgeIndex in 0..<sourceImportSpecs.len:
            let importSpec = sourceImportSpecs[edgeIndex]
            var edge: parser.ImportEdge
            var canonicalTargetModulePath: str
            var canonicalTargetSourcePath: str
            if !parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
                    workspaceRoot,
                    packageRoot,
                    packageId,
                    externalPackageRoots,
                    importSpec.targetModulePath,
                    canonicalTargetModulePath,
                    canonicalTargetSourcePath):
                err = Fmt" system link plan: import target exact identity unavailable owner={ownerModulePaths[sourceIndex]} target={importSpec.targetModulePath}"
                return false
            let ownedTargetModulePath = strings.CloneStr(
                canonicalTargetModulePath)
            let ownedTargetSourcePath = strings.CloneStr(
                canonicalTargetSourcePath)
            let targetSourceIndex = SystemLinkPlanTextIndex(
                sourceClosurePaths,
                ownedTargetSourcePath)
            let targetResolved = targetSourceIndex >= 0
            if targetResolved &&
               ownerModulePaths[targetSourceIndex] != ownedTargetModulePath:
                err = Fmt" system link plan: import target owner disagrees with exact closure target={ownedTargetModulePath} source={ownedTargetSourcePath} owner={ownerModulePaths[targetSourceIndex]}"
                return false
            edge.ownerProducerSourceIndex = sourceIndex
            edge.importDeclarationSourceLocalRow =
                importSpec.importDeclarationSourceLocalRow
            edge.importItemSourceLocalRow =
                importSpec.importItemSourceLocalRow
            edge.ownerModulePath = strings.CloneStr(
                ownerModulePaths[sourceIndex])
            edge.targetModulePath = ownedTargetModulePath
            edge.targetSourcePath = ownedTargetSourcePath
            edge.importAlias = strings.CloneStr(importSpec.importAlias)
            edge.resolved = targetResolved
            parser.ParserAddUniqueImportEdge(parsedEdges,
                                             edge)
    var unresolvedImportCount: int32
    for edgeIndex in 0..<parsedEdges.len:
        if !parsedEdges[edgeIndex].resolved:
            unresolvedImportCount = unresolvedImportCount + 1
    var canonicalEdges: parser.ImportEdge[]
    if !SystemLinkPlanCanonicalImportEdgesInto(
            sourceClosurePaths,
            ownerModulePaths,
            parsedEdges,
            unresolvedImportCount,
            canonicalEdges,
            err):
        return false
    var reachable: bool[]
    for sourceIndex in 0..<sourceClosurePaths.len:
        add(reachable, false)
    var sourceQueue: int32[]
    reachable[entrySourceIndex] = true
    add(sourceQueue, entrySourceIndex)
    for queueIndex in 0..<sourceClosurePaths.len:
        if queueIndex >= sourceQueue.len:
            break
        let sourceIndex = sourceQueue[queueIndex]
        let ownerModulePath = ownerModulePaths[sourceIndex]
        for edgeIndex in 0..<canonicalEdges.len:
            let edge = canonicalEdges[edgeIndex]
            if edge.ownerModulePath != ownerModulePath || !edge.resolved:
                continue
            let targetSourceIndex = SystemLinkPlanTextIndex(
                sourceClosurePaths,
                edge.targetSourcePath)
            if targetSourceIndex < 0:
                err = Fmt" system link plan: reachable import target outside exact closure edge={edgeIndex}"
                return false
            if !reachable[targetSourceIndex]:
                reachable[targetSourceIndex] = true
                add(sourceQueue, targetSourceIndex)
    if sourceQueue.len != sourceClosurePaths.len:
        for sourceIndex in 0..<sourceClosurePaths.len:
            if !reachable[sourceIndex]:
                err = Fmt" system link plan: source closure contains unreachable row index={sourceIndex} source={sourceClosurePaths[sourceIndex]}"
                return false
    out = canonicalEdges
    outUnresolvedImportCount = unresolvedImportCount
    err = ""
    return true

fn SystemLinkPlanBindingAppendU32BE(buf: var layout.ByteBuf, value: int64) =
    layout.ByteBufAppendByte(buf, Int32((value >> 24) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 16) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 8) & 255))
    layout.ByteBufAppendByte(buf, Int32(value & 255))

@borrows
fn SystemLinkPlanBindingAppendText(buf: var layout.ByteBuf, value: str) =
    SystemLinkPlanBindingAppendU32BE(buf, value.len)
    for i in 0..<value.len:
        layout.ByteBufAppendByte(buf, value[i])

fn SystemLinkPlanBindingAppendU32Field(buf: var layout.ByteBuf,
                                       value: int64) =
    SystemLinkPlanBindingAppendU32BE(buf, 4)
    SystemLinkPlanBindingAppendU32BE(buf, value)

@borrows
fn SystemLinkPlanBindingAppendFixed32Field(
        buf: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    SystemLinkPlanBindingAppendU32BE(buf, 32)
    for byteIndex in 0..<32:
        layout.ByteBufAppendByte(
            buf, int32(value.data[byteIndex]))

@borrows
fn SystemLinkPlanBindingAppendTexts(buf: var layout.ByteBuf, values: str[]) =
    SystemLinkPlanBindingAppendU32Field(buf, values.len)
    for valueIndex in 0..<values.len:
        SystemLinkPlanBindingAppendText(buf, values[valueIndex])

fn systemLinkPlanBindingAppendI64Field(
        buf: var layout.ByteBuf,
        value: int64) =
    SystemLinkPlanBindingAppendU32BE(buf, 8)
    SystemLinkPlanBindingAppendU32BE(buf, value >> 32)
    SystemLinkPlanBindingAppendU32BE(buf, value)

fn systemLinkPlanRecordSequenceStorage(
        capacity: int32,
        elementBytes: int32,
        bufferCount: var int32,
        retainedBytes: var int64) =
    if capacity < 0 || elementBytes <= 0:
        panic("system link plan: invalid owned sequence storage shape")
    if capacity > 0:
        bufferCount = bufferCount + 1
        retainedBytes =
            retainedBytes +
            int64(capacity) * int64(elementBytes)

fn systemLinkPlanRecordStringArrayStorage(
        values: var str[],
        bufferCount: var int32,
        retainedBytes: var int64) =
    systemLinkPlanRecordSequenceStorage(
        values.cap, sizeof(str), bufferCount, retainedBytes)
    for valueIndex in 0..<values.len:
        retainedBytes =
            retainedBytes + int64(values[valueIndex].len)

fn systemLinkPlanSourceBundlePayloadStorage(
        owner: var SystemLinkPlanSourceBundleOwner,
        bufferCount: var int32,
        retainedBytes: var int64) =
    systemLinkPlanRecordSequenceStorage(
        owner.externalPackageRoots.cap,
        sizeof(parser.ParserExternalPackageRoot),
        bufferCount,
        retainedBytes)
    for rootIndex in 0..<owner.externalPackageRoots.len:
        retainedBytes =
            retainedBytes +
            int64(owner.externalPackageRoots[rootIndex].packageId.len) +
            int64(owner.externalPackageRoots[
                rootIndex].canonicalPackageId.len) +
            int64(owner.externalPackageRoots[rootIndex].packageRoot.len) +
            int64(owner.externalPackageRoots[rootIndex].channel.len)
        systemLinkPlanRecordStringArrayStorage(
            owner.externalPackageRoots[rootIndex].verifiedSourcePaths,
            bufferCount,
            retainedBytes)
        systemLinkPlanRecordStringArrayStorage(
            owner.externalPackageRoots[rootIndex].verifiedSourceTexts,
            bufferCount,
            retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        owner.sourceBundleIdentityPaths,
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        owner.sourceClosurePaths,
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        owner.ownerModulePaths,
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        owner.importEdges.cap,
        sizeof(parser.ImportEdge),
        bufferCount,
        retainedBytes)
    for edgeIndex in 0..<owner.importEdges.len:
        retainedBytes =
            retainedBytes +
            int64(owner.importEdges[edgeIndex].ownerModulePath.len) +
            int64(owner.importEdges[edgeIndex].targetModulePath.len) +
            int64(owner.importEdges[edgeIndex].targetSourcePath.len) +
            int64(owner.importEdges[edgeIndex].importAlias.len) +
            int64(owner.importEdges[edgeIndex].qualifier.len)

fn SystemLinkPlanSourceBundleOwnerRetainedBufferCount(
        owner: var SystemLinkPlanSourceBundleOwner): int32 =
    var bufferCount: int32
    var retainedBytes: int64
    systemLinkPlanSourceBundlePayloadStorage(
        owner, bufferCount, retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        owner.sourceRowIndexes.cap,
        sizeof(int32),
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        owner.moduleRowIndexes.cap,
        sizeof(int32),
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        owner.externalRootRowIndexes.cap,
        sizeof(int32),
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        owner.importEdgeRowIndexes.cap,
        sizeof(int32),
        bufferCount,
        retainedBytes)
    return bufferCount

fn SystemLinkPlanSourceBundleOwnerRetainedBytes(
        owner: var SystemLinkPlanSourceBundleOwner): int64 =
    var bufferCount: int32
    var retainedBytes: int64
    systemLinkPlanSourceBundlePayloadStorage(
        owner, bufferCount, retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        owner.sourceRowIndexes.cap,
        sizeof(int32),
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        owner.moduleRowIndexes.cap,
        sizeof(int32),
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        owner.externalRootRowIndexes.cap,
        sizeof(int32),
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        owner.importEdgeRowIndexes.cap,
        sizeof(int32),
        bufferCount,
        retainedBytes)
    return retainedBytes

fn systemLinkPlanSourceBundleOwnerPayloadRetainedBytes(
        owner: var SystemLinkPlanSourceBundleOwner): int64 =
    var bufferCount: int32
    var retainedBytes: int64
    systemLinkPlanSourceBundlePayloadStorage(
        owner, bufferCount, retainedBytes)
    return retainedBytes

fn systemLinkPlanSourceBundleOwnerPayloadRetainedBufferCount(
        owner: var SystemLinkPlanSourceBundleOwner): int32 =
    var bufferCount: int32
    var retainedBytes: int64
    systemLinkPlanSourceBundlePayloadStorage(
        owner, bufferCount, retainedBytes)
    return bufferCount

fn systemLinkPlanSourceBundleOwnerLedgerRetainedBytes(
        owner: var SystemLinkPlanSourceBundleOwner): int64 =
    return int64(owner.ledger.categoryNames.cap) * int64(sizeof(str)) +
           int64(owner.ledger.ownerNames.cap) * int64(sizeof(str)) +
           int64(owner.ledger.ownerClosed.cap) * int64(sizeof(bool)) +
           int64(owner.ledger.objects.cap) *
               int64(sizeof(lifetime.LifetimeLedgerObject)) +
           int64(owner.ledger.borrows.cap) *
               int64(sizeof(lifetime.LifetimeLedgerBorrow)) +
           int64(owner.ledger.categoryMetrics.cap) *
               int64(sizeof(lifetime.LifetimeLedgerMetrics))

fn systemLinkPlanSourceBundleAppendRowExact(
        rows: var int32[],
        expectedCount: int32,
        reservedCapacity: int32,
        rowIndex: int32) =
    if expectedCount <= 0 ||
       rowIndex != rows.len ||
       rowIndex >= expectedCount ||
       rows.cap != reservedCapacity ||
       rows.buffer == nil:
        panic("system link plan: source bundle row append state invalid")
    let capacityBefore = rows.cap
    add(rows, rowIndex)
    if rows.cap != capacityBefore:
        panic("system link plan: source bundle row append grew storage")

fn systemLinkPlanSourceBundleOwnerToken(
        owner: var SystemLinkPlanSourceBundleOwner): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(384)
    SystemLinkPlanBindingAppendText(
        buf, "cheng.system_link.source_bundle.owner")
    SystemLinkPlanBindingAppendFixed32Field(
        buf, owner.sourceBundleCid)
    SystemLinkPlanBindingAppendFixed32Field(
        buf, owner.sourceBundleEntrySourceCid)
    SystemLinkPlanBindingAppendFixed32Field(
        buf, owner.sourceBundleImportGraphCid)
    SystemLinkPlanBindingAppendFixed32Field(
        buf, owner.sourceBundleBindingSeal)
    SystemLinkPlanBindingAppendU32Field(
        buf, owner.sourceBundleEntrySourceIndex)
    SystemLinkPlanBindingAppendU32Field(
        buf, owner.sourceRowIndexes.len)
    SystemLinkPlanBindingAppendU32Field(
        buf, owner.moduleRowIndexes.len)
    SystemLinkPlanBindingAppendU32Field(
        buf, owner.externalRootRowIndexes.len)
    SystemLinkPlanBindingAppendU32Field(
        buf, owner.importEdgeRowIndexes.len)
    SystemLinkPlanBindingAppendU32Field(
        buf, owner.unresolvedImportCount)
    SystemLinkPlanBindingAppendU32Field(
        buf, SystemLinkPlanSourceBundleOwnerRetainedBufferCount(owner))
    systemLinkPlanBindingAppendI64Field(
        buf, SystemLinkPlanSourceBundleOwnerRetainedBytes(owner))
    let token = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn systemLinkPlanSourceBundleOwnerEmpty(
        owner: var SystemLinkPlanSourceBundleOwner): bool =
    return !owner.moved &&
           !owner.borrowedForLowering &&
           !owner.borrowReturned &&
           !owner.loweringBorrowActive &&
           !owner.loweringBorrowerClosed &&
           !owner.receiptReady &&
           !owner.receiptConsumed &&
           owner.externalPackageRoots.len == 0 &&
           owner.externalPackageRoots.cap == 0 &&
           owner.sourceBundleIdentityPaths.len == 0 &&
           owner.sourceBundleIdentityPaths.cap == 0 &&
           owner.sourceClosurePaths.len == 0 &&
           owner.sourceClosurePaths.cap == 0 &&
           owner.ownerModulePaths.len == 0 &&
           owner.ownerModulePaths.cap == 0 &&
           owner.importEdges.len == 0 &&
           owner.importEdges.cap == 0 &&
           owner.sourceRowIndexes.len == 0 &&
           owner.sourceRowIndexes.cap == 0 &&
           owner.moduleRowIndexes.len == 0 &&
           owner.moduleRowIndexes.cap == 0 &&
           owner.externalRootRowIndexes.len == 0 &&
           owner.externalRootRowIndexes.cap == 0 &&
           owner.importEdgeRowIndexes.len == 0 &&
           owner.importEdgeRowIndexes.cap == 0 &&
           layout.FixedBytes32Equal(
               owner.ownerToken, layout.FixedBytes32())

fn SystemLinkPlanSourceBundleOwnerMoved(
        owner: var SystemLinkPlanSourceBundleOwner): bool =
    return owner.moved

fn SystemLinkPlanSourceBundleOwnerMoveFromPlanInto(
        plan: var SystemLinkPlanStub,
        owner: var SystemLinkPlanSourceBundleOwner,
        err: var str): bool =
    err = ""
    if !systemLinkPlanSourceBundleOwnerEmpty(owner):
        err = " system link plan: source bundle destination is not empty"
        return false
    if !SystemLinkPlanSourceBundleBindingStructuralValidInto(plan, err):
        return false
    let sourceCount = plan.sourceClosurePaths.len
    let rootCount = plan.externalPackageRoots.len
    let edgeCount = plan.importEdges.len
    let payloadBufferCount =
        SystemLinkPlanCompilerInputRetainedBufferCount(plan)
    let compilerInputRetainedBytes =
        SystemLinkPlanCompilerInputRetainedBytes(plan)
    var residualBufferCount: int32
    var residualBytes =
        int64(plan.managedDependencyReceipt.channel.len)
    systemLinkPlanRecordSequenceStorage(
        plan.managedDependencyReceipt.entries.cap,
        sizeof(SystemLinkPlanManagedDependencyReceiptEntry),
        residualBufferCount,
        residualBytes)
    for dependencyIndex in 0..<plan.managedDependencyReceipt.entries.len:
        residualBytes =
            residualBytes +
            int64(plan.managedDependencyReceipt.entries[
                dependencyIndex].canonicalPackageId.len)
    residualBufferCount =
        residualBufferCount +
        parser.NormalizedExprLayerPhysicalBufferCount(plan.exprLayer)
    residualBytes =
        residualBytes +
        parser.NormalizedExprLayerRetainedBytes(plan.exprLayer)
    systemLinkPlanRecordStringArrayStorage(
        plan.runtimeTargets,
        residualBufferCount,
        residualBytes)
    let sourcePayloadBufferCount =
        payloadBufferCount - residualBufferCount
    let sourcePayloadBytes =
        compilerInputRetainedBytes - residualBytes
    if sourceCount <= 0 ||
       sourcePayloadBufferCount <= 0 ||
       sourcePayloadBytes <= int64(0):
        err = " system link plan: source bundle payload is empty"
        return false

    lifetime.LifetimeLedgerInit(owner.ledger)
    let objectCount =
        3 + (rootCount > 0 ? 1 : 0) +
        (edgeCount > 0 ? 1 : 0)
    lifetime.LifetimeLedgerReserveExact(
        owner.ledger, 5, 3, objectCount, objectCount)
    owner.payloadCategoryId =
        lifetime.LifetimeLedgerRegisterCategory(
            owner.ledger, "system_link_source_bundle_payload")
    owner.sourceRowCategoryId =
        lifetime.LifetimeLedgerRegisterCategory(
            owner.ledger, "system_link_source_row_indexes")
    owner.moduleRowCategoryId =
        lifetime.LifetimeLedgerRegisterCategory(
            owner.ledger, "system_link_module_row_indexes")
    owner.externalRootRowCategoryId =
        lifetime.LifetimeLedgerRegisterCategory(
            owner.ledger, "system_link_external_root_row_indexes")
    owner.importEdgeRowCategoryId =
        lifetime.LifetimeLedgerRegisterCategory(
            owner.ledger, "system_link_import_edge_row_indexes")
    owner.linkPlanOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            owner.ledger, "system_link_plan")
    owner.sourceBundleOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            owner.ledger, "system_link_source_bundle_owner")
    owner.loweringBorrowerOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            owner.ledger, "lowering_source_bundle_borrower")

    seqs.reserve(owner.sourceRowIndexes, sourceCount)
    if owner.sourceRowIndexes.cap < sourceCount ||
       owner.sourceRowIndexes.buffer == nil:
        panic("system link plan: source row reserve failed")
    owner.sourceRowReservedCapacity = owner.sourceRowIndexes.cap
    for sourceIndex in 0..<sourceCount:
        systemLinkPlanSourceBundleAppendRowExact(
            owner.sourceRowIndexes,
            sourceCount,
            owner.sourceRowReservedCapacity,
            sourceIndex)
    seqs.reserve(owner.moduleRowIndexes, sourceCount)
    if owner.moduleRowIndexes.cap < sourceCount ||
       owner.moduleRowIndexes.buffer == nil:
        panic("system link plan: module row reserve failed")
    owner.moduleRowReservedCapacity = owner.moduleRowIndexes.cap
    for moduleIndex in 0..<sourceCount:
        systemLinkPlanSourceBundleAppendRowExact(
            owner.moduleRowIndexes,
            sourceCount,
            owner.moduleRowReservedCapacity,
            moduleIndex)
    if rootCount > 0:
        seqs.reserve(owner.externalRootRowIndexes, rootCount)
        if owner.externalRootRowIndexes.cap < rootCount ||
           owner.externalRootRowIndexes.buffer == nil:
            panic("system link plan: external root row reserve failed")
        owner.externalRootRowReservedCapacity =
            owner.externalRootRowIndexes.cap
        for rootIndex in 0..<rootCount:
            systemLinkPlanSourceBundleAppendRowExact(
                owner.externalRootRowIndexes,
                rootCount,
                owner.externalRootRowReservedCapacity,
                rootIndex)
    if edgeCount > 0:
        seqs.reserve(owner.importEdgeRowIndexes, edgeCount)
        if owner.importEdgeRowIndexes.cap < edgeCount ||
           owner.importEdgeRowIndexes.buffer == nil:
            panic("system link plan: import edge row reserve failed")
        owner.importEdgeRowReservedCapacity =
            owner.importEdgeRowIndexes.cap
        for edgeIndex in 0..<edgeCount:
            systemLinkPlanSourceBundleAppendRowExact(
                owner.importEdgeRowIndexes,
                edgeCount,
                owner.importEdgeRowReservedCapacity,
                edgeIndex)

    owner.payloadObjectId =
        lifetime.LifetimeLedgerReserveObject(
            owner.ledger,
            owner.payloadCategoryId,
            sourcePayloadBytes)
    lifetime.LifetimeLedgerOwn(
        owner.ledger,
        owner.payloadObjectId,
        owner.linkPlanOwnerId)
    owner.sourceRowObjectId =
        lifetime.LifetimeLedgerReserveObject(
            owner.ledger,
            owner.sourceRowCategoryId,
            int64(owner.sourceRowReservedCapacity) *
                int64(sizeof(int32)))
    lifetime.LifetimeLedgerOwn(
        owner.ledger,
        owner.sourceRowObjectId,
        owner.sourceBundleOwnerId)
    owner.moduleRowObjectId =
        lifetime.LifetimeLedgerReserveObject(
            owner.ledger,
            owner.moduleRowCategoryId,
            int64(owner.moduleRowReservedCapacity) *
                int64(sizeof(int32)))
    lifetime.LifetimeLedgerOwn(
        owner.ledger,
        owner.moduleRowObjectId,
        owner.sourceBundleOwnerId)
    if rootCount > 0:
        owner.externalRootRowObjectId =
            lifetime.LifetimeLedgerReserveObject(
                owner.ledger,
                owner.externalRootRowCategoryId,
                int64(owner.externalRootRowReservedCapacity) *
                    int64(sizeof(int32)))
        lifetime.LifetimeLedgerOwn(
            owner.ledger,
            owner.externalRootRowObjectId,
            owner.sourceBundleOwnerId)
    if edgeCount > 0:
        owner.importEdgeRowObjectId =
            lifetime.LifetimeLedgerReserveObject(
                owner.ledger,
                owner.importEdgeRowCategoryId,
                int64(owner.importEdgeRowReservedCapacity) *
                    int64(sizeof(int32)))
        lifetime.LifetimeLedgerOwn(
            owner.ledger,
            owner.importEdgeRowObjectId,
            owner.sourceBundleOwnerId)

    owner.sourceBundleCid =
        layout.FixedBytes32Copy(plan.sourceBundleCidValue)
    owner.sourceBundleEntrySourceCid =
        layout.FixedBytes32Copy(plan.sourceBundleEntrySourceCid)
    owner.sourceBundleImportGraphCid =
        layout.FixedBytes32Copy(plan.sourceBundleImportGraphCid)
    owner.sourceBundleBindingSeal =
        layout.FixedBytes32Copy(plan.sourceBundleBindingSeal)
    owner.sourceBundleEntrySourceIndex =
        plan.sourceBundleEntrySourceIndex
    owner.importEdgeCount = plan.importEdgeCount
    owner.unresolvedImportCount = plan.unresolvedImportCount
    owner.buildSourceUnitCount = plan.buildSourceUnitCount
    owner.externalPackageRoots = plan.externalPackageRoots
    plan.externalPackageRoots = []
    owner.sourceBundleIdentityPaths = plan.sourceBundleIdentityPaths
    plan.sourceBundleIdentityPaths = []
    owner.sourceClosurePaths = plan.sourceClosurePaths
    plan.sourceClosurePaths = []
    owner.ownerModulePaths = plan.ownerModulePaths
    plan.ownerModulePaths = []
    owner.importEdges = plan.importEdges
    plan.importEdges = []
    plan.sourceBundleBindingSeal = layout.FixedBytes32()
    plan.sourceBundleEntrySourceIndex = -1
    lifetime.LifetimeLedgerMove(
        owner.ledger,
        owner.payloadObjectId,
        owner.linkPlanOwnerId,
        owner.sourceBundleOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        owner.ledger, owner.linkPlanOwnerId)
    owner.moved = true
    if systemLinkPlanSourceBundleOwnerPayloadRetainedBufferCount(owner) !=
           sourcePayloadBufferCount ||
       systemLinkPlanSourceBundleOwnerPayloadRetainedBytes(owner) !=
           sourcePayloadBytes:
        panic("system link plan: source bundle zero-copy move drift")
    owner.ownerToken =
        systemLinkPlanSourceBundleOwnerToken(owner)
    if layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()):
        panic("system link plan: source bundle owner token is zero")
    return true

fn SystemLinkPlanSourceBundleOwnerValidateForLoweringInto(
        plan: var SystemLinkPlanStub,
        owner: var SystemLinkPlanSourceBundleOwner,
        err: var str): bool =
    err = ""
    if !owner.moved ||
       owner.receiptReady ||
       owner.receiptConsumed ||
       owner.loweringBorrowActive ||
       owner.loweringBorrowerClosed ||
       owner.borrowReturned:
        err = " lowering source bundle: owner state invalid"
        return false
    if layout.FixedBytes32Equal(
           owner.sourceBundleCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           owner.sourceBundleBindingSeal, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           owner.sourceBundleCid, plan.sourceBundleCidValue) ||
       !layout.FixedBytes32Equal(
           owner.sourceBundleEntrySourceCid,
           plan.sourceBundleEntrySourceCid) ||
       !layout.FixedBytes32Equal(
           owner.sourceBundleImportGraphCid,
           plan.sourceBundleImportGraphCid):
        err = " lowering source bundle: CID identity mismatch"
        return false
    if owner.sourceClosurePaths.len <= 0 ||
       owner.sourceBundleIdentityPaths.len !=
           owner.sourceClosurePaths.len ||
       owner.ownerModulePaths.len != owner.sourceClosurePaths.len ||
       owner.sourceRowIndexes.len != owner.sourceClosurePaths.len ||
       owner.moduleRowIndexes.len != owner.ownerModulePaths.len ||
       owner.externalRootRowIndexes.len !=
           owner.externalPackageRoots.len ||
       owner.buildSourceUnitCount != owner.sourceClosurePaths.len ||
       owner.importEdgeCount != owner.importEdges.len ||
       owner.importEdgeRowIndexes.len != owner.importEdges.len ||
       owner.unresolvedImportCount < 0:
        err = " lowering source bundle: canonical column shape mismatch"
        return false
    if owner.sourceBundleEntrySourceIndex < 0 ||
       owner.sourceBundleEntrySourceIndex >=
           owner.sourceRowIndexes.len ||
       owner.sourceRowIndexes[
           owner.sourceBundleEntrySourceIndex] !=
           owner.sourceBundleEntrySourceIndex ||
       plan.entryPath != owner.sourceClosurePaths[
           owner.sourceBundleEntrySourceIndex] ||
       plan.buildEntryPath != owner.sourceClosurePaths[
           owner.sourceBundleEntrySourceIndex] ||
       plan.moduleStem != owner.ownerModulePaths[
           owner.sourceBundleEntrySourceIndex]:
        err = " lowering source bundle: entry source row invalid"
        return false
    for sourceOrdinal in 0..<owner.sourceRowIndexes.len:
        let sourceRow = owner.sourceRowIndexes[sourceOrdinal]
        if sourceRow != sourceOrdinal ||
           sourceRow < 0 ||
           sourceRow >= owner.sourceClosurePaths.len:
            err = Fmt" lowering source bundle: source row invalid ordinal={sourceOrdinal} row={sourceRow}"
            return false
        let moduleRow = owner.moduleRowIndexes[sourceOrdinal]
        if moduleRow != sourceOrdinal ||
           moduleRow < 0 ||
           moduleRow >= owner.ownerModulePaths.len:
            err = Fmt" lowering source bundle: module row invalid ordinal={sourceOrdinal} row={moduleRow}"
            return false
    for rootOrdinal in 0..<owner.externalRootRowIndexes.len:
        let rootRow = owner.externalRootRowIndexes[rootOrdinal]
        if rootRow != rootOrdinal ||
           rootRow < 0 ||
           rootRow >= owner.externalPackageRoots.len:
            err = Fmt" lowering source bundle: external root row invalid ordinal={rootOrdinal} row={rootRow}"
            return false
    for edgeOrdinal in 0..<owner.importEdgeRowIndexes.len:
        let edgeRow = owner.importEdgeRowIndexes[edgeOrdinal]
        if edgeRow != edgeOrdinal ||
           edgeRow < 0 ||
           edgeRow >= owner.importEdges.len:
            err = Fmt" lowering source bundle: import edge row invalid ordinal={edgeOrdinal} row={edgeRow}"
            return false
    let expectedSeal =
        SystemLinkPlanComputeSourceBundleBindingSeal(
            plan.packageId,
            plan.workspaceRoot,
            plan.packageRoot,
            owner.externalPackageRoots,
            owner.sourceBundleEntrySourceIndex,
            owner.sourceBundleCid,
            owner.sourceBundleEntrySourceCid,
            owner.sourceBundleImportGraphCid,
            owner.sourceBundleIdentityPaths,
            owner.sourceClosurePaths,
            owner.ownerModulePaths,
            owner.importEdges,
            owner.unresolvedImportCount)
    if !layout.FixedBytes32Equal(
           expectedSeal, owner.sourceBundleBindingSeal) ||
       !layout.FixedBytes32Equal(
           systemLinkPlanSourceBundleOwnerToken(owner),
           owner.ownerToken):
        err = " lowering source bundle: seal or owner token mismatch"
        return false
    return true

fn SystemLinkPlanSourceBundleOwnerBorrowForLoweringInto(
        plan: var SystemLinkPlanStub,
        owner: var SystemLinkPlanSourceBundleOwner,
        err: var str): bool =
    if !SystemLinkPlanSourceBundleOwnerValidateForLoweringInto(
           plan, owner, err):
        return false
    owner.payloadBorrowId =
        lifetime.LifetimeLedgerBorrow(
            owner.ledger,
            owner.payloadObjectId,
            owner.loweringBorrowerOwnerId)
    owner.sourceRowBorrowId =
        lifetime.LifetimeLedgerBorrow(
            owner.ledger,
            owner.sourceRowObjectId,
            owner.loweringBorrowerOwnerId)
    owner.moduleRowBorrowId =
        lifetime.LifetimeLedgerBorrow(
            owner.ledger,
            owner.moduleRowObjectId,
            owner.loweringBorrowerOwnerId)
    if owner.externalRootRowObjectId > 0:
        owner.externalRootRowBorrowId =
            lifetime.LifetimeLedgerBorrow(
                owner.ledger,
                owner.externalRootRowObjectId,
                owner.loweringBorrowerOwnerId)
    if owner.importEdgeRowObjectId > 0:
        owner.importEdgeRowBorrowId =
            lifetime.LifetimeLedgerBorrow(
                owner.ledger,
                owner.importEdgeRowObjectId,
                owner.loweringBorrowerOwnerId)
    owner.borrowedForLowering = true
    owner.loweringBorrowActive = true
    return true

fn SystemLinkPlanSourceBundleOwnerReturnFromLowering(
        owner: var SystemLinkPlanSourceBundleOwner) =
    if !owner.moved ||
       !owner.borrowedForLowering ||
       !owner.loweringBorrowActive ||
       owner.borrowReturned ||
       owner.loweringBorrowerClosed:
        panic("lowering source bundle: invalid borrow return state")
    lifetime.LifetimeLedgerReturnBorrow(
        owner.ledger,
        owner.payloadObjectId,
        owner.payloadBorrowId,
        owner.loweringBorrowerOwnerId)
    lifetime.LifetimeLedgerReturnBorrow(
        owner.ledger,
        owner.sourceRowObjectId,
        owner.sourceRowBorrowId,
        owner.loweringBorrowerOwnerId)
    lifetime.LifetimeLedgerReturnBorrow(
        owner.ledger,
        owner.moduleRowObjectId,
        owner.moduleRowBorrowId,
        owner.loweringBorrowerOwnerId)
    if owner.externalRootRowObjectId > 0:
        lifetime.LifetimeLedgerReturnBorrow(
            owner.ledger,
            owner.externalRootRowObjectId,
            owner.externalRootRowBorrowId,
            owner.loweringBorrowerOwnerId)
    if owner.importEdgeRowObjectId > 0:
        lifetime.LifetimeLedgerReturnBorrow(
            owner.ledger,
            owner.importEdgeRowObjectId,
            owner.importEdgeRowBorrowId,
            owner.loweringBorrowerOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        owner.ledger, owner.loweringBorrowerOwnerId)
    owner.loweringBorrowActive = false
    owner.borrowReturned = true
    owner.loweringBorrowerClosed = true

fn SystemLinkPlanSourceBundleOwnerSourceRowAtBorrowed(
        owner: var SystemLinkPlanSourceBundleOwner,
        ordinal: int32): int32 =
    if !owner.loweringBorrowActive ||
       ordinal < 0 ||
       ordinal >= owner.sourceRowIndexes.len ||
       lifetime.LifetimeLedgerRead(
           owner.ledger,
           owner.sourceRowObjectId,
           owner.loweringBorrowerOwnerId) !=
           owner.sourceRowCategoryId:
        panic("lowering source bundle: source row read without exact borrow")
    return owner.sourceRowIndexes[ordinal]

fn SystemLinkPlanSourceBundleOwnerImportEdgeRowAtBorrowed(
        owner: var SystemLinkPlanSourceBundleOwner,
        ordinal: int32): int32 =
    if !owner.loweringBorrowActive ||
       ordinal < 0 ||
       ordinal >= owner.importEdgeRowIndexes.len ||
       owner.importEdgeRowObjectId <= 0 ||
       lifetime.LifetimeLedgerRead(
           owner.ledger,
           owner.importEdgeRowObjectId,
           owner.loweringBorrowerOwnerId) !=
           owner.importEdgeRowCategoryId:
        panic("lowering source bundle: import row read without exact borrow")
    return owner.importEdgeRowIndexes[ordinal]

fn SystemLinkPlanSourceBundleOwnerModuleRowAtBorrowed(
        owner: var SystemLinkPlanSourceBundleOwner,
        ordinal: int32): int32 =
    if !owner.loweringBorrowActive ||
       ordinal < 0 ||
       ordinal >= owner.moduleRowIndexes.len ||
       lifetime.LifetimeLedgerRead(
           owner.ledger,
           owner.moduleRowObjectId,
           owner.loweringBorrowerOwnerId) !=
           owner.moduleRowCategoryId:
        panic("lowering source bundle: module row read without exact borrow")
    return owner.moduleRowIndexes[ordinal]

fn SystemLinkPlanSourceBundleOwnerExternalRootRowAtBorrowed(
        owner: var SystemLinkPlanSourceBundleOwner,
        ordinal: int32): int32 =
    if !owner.loweringBorrowActive ||
       ordinal < 0 ||
       ordinal >= owner.externalRootRowIndexes.len ||
       owner.externalRootRowObjectId <= 0 ||
       lifetime.LifetimeLedgerRead(
           owner.ledger,
           owner.externalRootRowObjectId,
           owner.loweringBorrowerOwnerId) !=
           owner.externalRootRowCategoryId:
        panic("lowering source bundle: external root row read without exact borrow")
    return owner.externalRootRowIndexes[ordinal]

fn SystemLinkPlanSourceBundleOwnerPayloadReadBorrowed(
        owner: var SystemLinkPlanSourceBundleOwner) =
    if !owner.loweringBorrowActive ||
       lifetime.LifetimeLedgerRead(
           owner.ledger,
           owner.payloadObjectId,
           owner.loweringBorrowerOwnerId) !=
           owner.payloadCategoryId:
        panic("lowering source bundle: payload read without exact borrow")

@borrows
fn SystemLinkPlanSourceBundleReleaseReceiptClosed(
        receipt: SystemLinkPlanSourceBundleReleaseReceipt): bool =
    let objectCount =
        int64(3 +
              (receipt.externalRootRowCount > 0 ? 1 : 0) +
              (receipt.importEdgeRowCount > 0 ? 1 : 0))
    return !layout.FixedBytes32Equal(
               receipt.ownerToken, layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               receipt.sourceBundleCid, layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               receipt.sourceBundleBindingSeal,
               layout.FixedBytes32()) &&
           receipt.sourceRowCount > 0 &&
           receipt.moduleRowCount == receipt.sourceRowCount &&
           receipt.externalRootRowCount >= 0 &&
           receipt.importEdgeRowCount >= 0 &&
           receipt.retainedBufferCount > 0 &&
           receipt.retainedBytes > int64(0) &&
           receipt.physicalFreeCount ==
               receipt.retainedBufferCount &&
           receipt.physicalFreedBytes == receipt.retainedBytes &&
           receipt.allocated == objectCount &&
           receipt.released == objectCount &&
           receipt.live == int64(0) &&
           receipt.allocatedBytes == receipt.retainedBytes &&
           receipt.releasedBytes == receipt.retainedBytes &&
           receipt.liveBytes == int64(0) &&
           receipt.ownerTransferCount == int64(1) &&
           receipt.borrowedForLowering ==
               receipt.borrowReturned &&
           receipt.retained ==
               (receipt.borrowedForLowering ? objectCount : int64(0)) &&
           receipt.borrowReturnCount == receipt.retained &&
           receipt.ledgerStorageReleasedSequenceCount == 6 &&
           receipt.ledgerStorageReleasedBufferCount > 0 &&
           receipt.ledgerStorageReleasedBytes > int64(0) &&
           receipt.ledgerStorageReleased &&
           receipt.storageReleased

@borrows
fn systemLinkPlanReleaseRootStrColRec(
        owner: var SystemLinkPlanSourceBundleOwner,
        rootIndex: int32,
        texts: bool,
        i: int32) =
    var n: int32
    if texts:
        n = owner.externalPackageRoots[rootIndex].verifiedSourceTexts.len
    else:
        n = owner.externalPackageRoots[rootIndex].verifiedSourcePaths.len
    if i >= n:
        if texts:
            owner.externalPackageRoots[rootIndex].verifiedSourceTexts = []
        else:
            owner.externalPackageRoots[rootIndex].verifiedSourcePaths = []
        return
    if texts:
        owner.externalPackageRoots[rootIndex].verifiedSourceTexts[i] = ""
    else:
        owner.externalPackageRoots[rootIndex].verifiedSourcePaths[i] = ""
    systemLinkPlanReleaseRootStrColRec(owner, rootIndex, texts, i + 1)

@borrows
fn systemLinkPlanReleaseExternalRootsRec(
        owner: var SystemLinkPlanSourceBundleOwner,
        rootIndex: int32) =
    if rootIndex >= owner.externalPackageRoots.len:
        return
    owner.externalPackageRoots[rootIndex].packageId = ""
    owner.externalPackageRoots[rootIndex].canonicalPackageId = ""
    owner.externalPackageRoots[rootIndex].packageRoot = ""
    owner.externalPackageRoots[rootIndex].channel = ""
    systemLinkPlanReleaseRootStrColRec(owner, rootIndex, false, 0)
    systemLinkPlanReleaseRootStrColRec(owner, rootIndex, true, 0)
    systemLinkPlanReleaseExternalRootsRec(owner, rootIndex + 1)

@borrows
fn systemLinkPlanClearImportEdgesRec(
        owner: var SystemLinkPlanSourceBundleOwner,
        edgeIndex: int32) =
    if edgeIndex >= owner.importEdges.len:
        return
    owner.importEdges[edgeIndex].ownerModulePath = ""
    owner.importEdges[edgeIndex].targetModulePath = ""
    owner.importEdges[edgeIndex].targetSourcePath = ""
    owner.importEdges[edgeIndex].importAlias = ""
    owner.importEdges[edgeIndex].qualifier = ""
    systemLinkPlanClearImportEdgesRec(owner, edgeIndex + 1)

fn SystemLinkPlanSourceBundleOwnerReleaseWithReceipt(
        owner: var SystemLinkPlanSourceBundleOwner,
        receipt: var SystemLinkPlanSourceBundleReleaseReceipt) =
    if !owner.moved ||
       owner.receiptReady ||
       owner.receiptConsumed ||
       owner.loweringBorrowActive ||
       (owner.borrowedForLowering && !owner.borrowReturned):
        panic("system link plan: source bundle release state invalid")
    let retainedBufferCount =
        SystemLinkPlanSourceBundleOwnerRetainedBufferCount(owner)
    let retainedBytes =
        SystemLinkPlanSourceBundleOwnerRetainedBytes(owner)
    let ledgerRetainedBytes =
        systemLinkPlanSourceBundleOwnerLedgerRetainedBytes(owner)
    let ownerToken = layout.FixedBytes32Copy(owner.ownerToken)
    let sourceBundleCid =
        layout.FixedBytes32Copy(owner.sourceBundleCid)
    let sourceBundleBindingSeal =
        layout.FixedBytes32Copy(owner.sourceBundleBindingSeal)
    let sourceRowCount = owner.sourceRowIndexes.len
    let moduleRowCount = owner.moduleRowIndexes.len
    let externalRootRowCount = owner.externalRootRowIndexes.len
    let importEdgeRowCount = owner.importEdgeRowIndexes.len

    systemLinkPlanReleaseExternalRootsRec(owner, 0)
    seqs.chengSeqFreeTyped(owner.externalPackageRoots)
    owner.externalPackageRoots = []
    seqs.freeSeqStrRelease(owner.sourceBundleIdentityPaths)
    owner.sourceBundleIdentityPaths = []
    seqs.freeSeqStrRelease(owner.sourceClosurePaths)
    owner.sourceClosurePaths = []
    seqs.freeSeqStrRelease(owner.ownerModulePaths)
    owner.ownerModulePaths = []
    systemLinkPlanClearImportEdgesRec(owner, 0)
    seqs.chengSeqFreeTyped(owner.importEdges)
    owner.importEdges = []
    seqs.freeSeq(owner.sourceRowIndexes)
    owner.sourceRowIndexes = []
    seqs.freeSeq(owner.moduleRowIndexes)
    owner.moduleRowIndexes = []
    seqs.freeSeq(owner.externalRootRowIndexes)
    owner.externalRootRowIndexes = []
    seqs.freeSeq(owner.importEdgeRowIndexes)
    owner.importEdgeRowIndexes = []

    lifetime.LifetimeLedgerRelease(
        owner.ledger,
        owner.payloadObjectId,
        owner.sourceBundleOwnerId)
    lifetime.LifetimeLedgerRelease(
        owner.ledger,
        owner.sourceRowObjectId,
        owner.sourceBundleOwnerId)
    lifetime.LifetimeLedgerRelease(
        owner.ledger,
        owner.moduleRowObjectId,
        owner.sourceBundleOwnerId)
    if owner.externalRootRowObjectId > 0:
        lifetime.LifetimeLedgerRelease(
            owner.ledger,
            owner.externalRootRowObjectId,
            owner.sourceBundleOwnerId)
    if owner.importEdgeRowObjectId > 0:
        lifetime.LifetimeLedgerRelease(
            owner.ledger,
            owner.importEdgeRowObjectId,
            owner.sourceBundleOwnerId)
    if !owner.loweringBorrowerClosed:
        lifetime.LifetimeLedgerAssertOwnerClosed(
            owner.ledger, owner.loweringBorrowerOwnerId)
        owner.loweringBorrowerClosed = true
    lifetime.LifetimeLedgerAssertOwnerClosed(
        owner.ledger, owner.sourceBundleOwnerId)
    lifetime.LifetimeLedgerAssertClosed(owner.ledger)
    var metrics: lifetime.LifetimeLedgerMetrics
    lifetime.LifetimeLedgerReadTotalMetrics(
        owner.ledger, metrics)
    let ledgerStorageRelease =
        lifetime.LifetimeLedgerReleaseStorage(owner.ledger)
    if ledgerStorageRelease.releasedSequenceCapacityBytes !=
           ledgerRetainedBytes:
        panic("system link plan: source bundle ledger free byte mismatch")

    owner.sourceBundleCid = layout.FixedBytes32()
    owner.sourceBundleEntrySourceCid = layout.FixedBytes32()
    owner.sourceBundleImportGraphCid = layout.FixedBytes32()
    owner.sourceBundleBindingSeal = layout.FixedBytes32()
    owner.sourceBundleEntrySourceIndex = -1
    owner.ownerToken = layout.FixedBytes32()
    receipt.ownerToken = ownerToken
    receipt.sourceBundleCid = sourceBundleCid
    receipt.sourceBundleBindingSeal = sourceBundleBindingSeal
    receipt.sourceRowCount = sourceRowCount
    receipt.moduleRowCount = moduleRowCount
    receipt.externalRootRowCount = externalRootRowCount
    receipt.importEdgeRowCount = importEdgeRowCount
    receipt.retainedBufferCount = retainedBufferCount
    receipt.retainedBytes = retainedBytes
    receipt.physicalFreeCount = retainedBufferCount
    receipt.physicalFreedBytes = retainedBytes
    receipt.allocated = metrics.allocated
    receipt.released = metrics.released
    receipt.live = metrics.live
    receipt.allocatedBytes = metrics.allocatedBytes
    receipt.releasedBytes = metrics.releasedBytes
    receipt.liveBytes = metrics.liveBytes
    receipt.ownerTransferCount = metrics.ownerTransferCount
    receipt.retained = metrics.retained
    receipt.borrowReturnCount = metrics.borrowReturnCount
    receipt.ledgerStorageReleasedSequenceCount =
        ledgerStorageRelease.releasedSequenceCount
    receipt.ledgerStorageReleasedBufferCount =
        ledgerStorageRelease.releasedSequenceBufferCount
    receipt.ledgerStorageReleasedBytes =
        ledgerStorageRelease.releasedSequenceCapacityBytes
    receipt.ledgerStorageReleased =
        ledgerStorageRelease.storageReleased
    receipt.borrowedForLowering = owner.borrowedForLowering
    receipt.borrowReturned = owner.borrowReturned
    receipt.storageReleased =
        SystemLinkPlanSourceBundleOwnerRetainedBufferCount(owner) == 0 &&
        SystemLinkPlanSourceBundleOwnerRetainedBytes(owner) == int64(0) &&
        lifetime.LifetimeLedgerStorageReleased(owner.ledger)
    if !SystemLinkPlanSourceBundleReleaseReceiptClosed(receipt):
        panic("system link plan: source bundle terminal receipt invalid")
    owner.receipt = receipt
    owner.receiptReady = true

@borrows
fn SystemLinkPlanSourceBundleReleaseReceiptConsumeStrict(
        owner: var SystemLinkPlanSourceBundleOwner,
        receipt: SystemLinkPlanSourceBundleReleaseReceipt): bool =
    if !owner.receiptReady ||
       owner.receiptConsumed ||
       !SystemLinkPlanSourceBundleReleaseReceiptClosed(receipt) ||
       !layout.FixedBytes32Equal(
           receipt.ownerToken, owner.receipt.ownerToken) ||
       !layout.FixedBytes32Equal(
           receipt.sourceBundleCid, owner.receipt.sourceBundleCid) ||
       !layout.FixedBytes32Equal(
           receipt.sourceBundleBindingSeal,
           owner.receipt.sourceBundleBindingSeal) ||
       receipt.sourceRowCount != owner.receipt.sourceRowCount ||
       receipt.moduleRowCount != owner.receipt.moduleRowCount ||
       receipt.externalRootRowCount !=
           owner.receipt.externalRootRowCount ||
       receipt.importEdgeRowCount !=
           owner.receipt.importEdgeRowCount ||
       receipt.retainedBufferCount !=
           owner.receipt.retainedBufferCount ||
       receipt.retainedBytes != owner.receipt.retainedBytes ||
       receipt.physicalFreeCount != owner.receipt.physicalFreeCount ||
       receipt.physicalFreedBytes !=
           owner.receipt.physicalFreedBytes ||
       receipt.allocated != owner.receipt.allocated ||
       receipt.released != owner.receipt.released ||
       receipt.live != owner.receipt.live ||
       receipt.allocatedBytes != owner.receipt.allocatedBytes ||
       receipt.releasedBytes != owner.receipt.releasedBytes ||
       receipt.liveBytes != owner.receipt.liveBytes ||
       receipt.ownerTransferCount !=
           owner.receipt.ownerTransferCount ||
       receipt.retained != owner.receipt.retained ||
       receipt.borrowReturnCount != owner.receipt.borrowReturnCount ||
       receipt.ledgerStorageReleasedSequenceCount !=
           owner.receipt.ledgerStorageReleasedSequenceCount ||
       receipt.ledgerStorageReleasedBufferCount !=
           owner.receipt.ledgerStorageReleasedBufferCount ||
       receipt.ledgerStorageReleasedBytes !=
           owner.receipt.ledgerStorageReleasedBytes ||
       receipt.ledgerStorageReleased !=
           owner.receipt.ledgerStorageReleased ||
       receipt.borrowedForLowering !=
           owner.receipt.borrowedForLowering ||
       receipt.borrowReturned != owner.receipt.borrowReturned ||
       receipt.storageReleased != owner.receipt.storageReleased:
        return false
    owner.receiptConsumed = true
    return true

fn SystemLinkPlanCompilerInputRetainedBufferCount(
        plan: var SystemLinkPlanStub): int32 =
    var bufferCount: int32
    var retainedBytes: int64
    systemLinkPlanRecordSequenceStorage(
        plan.externalPackageRoots.cap,
        sizeof(parser.ParserExternalPackageRoot),
        bufferCount,
        retainedBytes)
    for rootIndex in 0..<plan.externalPackageRoots.len:
        systemLinkPlanRecordStringArrayStorage(
            plan.externalPackageRoots[rootIndex].verifiedSourcePaths,
            bufferCount,
            retainedBytes)
        systemLinkPlanRecordStringArrayStorage(
            plan.externalPackageRoots[rootIndex].verifiedSourceTexts,
            bufferCount,
            retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        plan.managedDependencyReceipt.entries.cap,
        sizeof(SystemLinkPlanManagedDependencyReceiptEntry),
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.sourceBundleIdentityPaths,
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.sourceClosurePaths,
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.ownerModulePaths,
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        plan.importEdges.cap,
        sizeof(parser.ImportEdge),
        bufferCount,
        retainedBytes)
    bufferCount =
        bufferCount +
        parser.NormalizedExprLayerPhysicalBufferCount(plan.exprLayer)
    systemLinkPlanRecordStringArrayStorage(
        plan.runtimeTargets,
        bufferCount,
        retainedBytes)
    return bufferCount

fn SystemLinkPlanCompilerInputRetainedBytes(
        plan: var SystemLinkPlanStub): int64 =
    var bufferCount: int32
    var retainedBytes =
        int64(plan.managedDependencyReceipt.channel.len)
    systemLinkPlanRecordSequenceStorage(
        plan.externalPackageRoots.cap,
        sizeof(parser.ParserExternalPackageRoot),
        bufferCount,
        retainedBytes)
    for rootIndex in 0..<plan.externalPackageRoots.len:
        retainedBytes =
            retainedBytes +
            int64(plan.externalPackageRoots[rootIndex].packageId.len) +
            int64(plan.externalPackageRoots[rootIndex].canonicalPackageId.len) +
            int64(plan.externalPackageRoots[rootIndex].packageRoot.len) +
            int64(plan.externalPackageRoots[rootIndex].channel.len)
        systemLinkPlanRecordStringArrayStorage(
            plan.externalPackageRoots[rootIndex].verifiedSourcePaths,
            bufferCount,
            retainedBytes)
        systemLinkPlanRecordStringArrayStorage(
            plan.externalPackageRoots[rootIndex].verifiedSourceTexts,
            bufferCount,
            retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        plan.managedDependencyReceipt.entries.cap,
        sizeof(SystemLinkPlanManagedDependencyReceiptEntry),
        bufferCount,
        retainedBytes)
    for entryIndex in 0..<plan.managedDependencyReceipt.entries.len:
        retainedBytes =
            retainedBytes +
            int64(plan.managedDependencyReceipt.entries[
                entryIndex].canonicalPackageId.len)
    systemLinkPlanRecordStringArrayStorage(
        plan.sourceBundleIdentityPaths,
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.sourceClosurePaths,
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.ownerModulePaths,
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        plan.importEdges.cap,
        sizeof(parser.ImportEdge),
        bufferCount,
        retainedBytes)
    for edgeIndex in 0..<plan.importEdges.len:
        retainedBytes =
            retainedBytes +
            int64(plan.importEdges[edgeIndex].ownerModulePath.len) +
            int64(plan.importEdges[edgeIndex].targetModulePath.len) +
            int64(plan.importEdges[edgeIndex].targetSourcePath.len) +
            int64(plan.importEdges[edgeIndex].importAlias.len) +
            int64(plan.importEdges[edgeIndex].qualifier.len)
    retainedBytes =
        retainedBytes +
        parser.NormalizedExprLayerRetainedBytes(plan.exprLayer)
    systemLinkPlanRecordStringArrayStorage(
        plan.runtimeTargets,
        bufferCount,
        retainedBytes)
    return retainedBytes

fn SystemLinkPlanCompilerInputStorageReleased(
        plan: var SystemLinkPlanStub): bool =
    return plan.externalPackageRoots.cap == 0 &&
           plan.managedDependencyReceipt.channel == "" &&
           plan.managedDependencyReceipt.entries.cap == 0 &&
           plan.sourceBundleIdentityPaths.cap == 0 &&
           plan.sourceClosurePaths.cap == 0 &&
           plan.ownerModulePaths.cap == 0 &&
           plan.importEdges.cap == 0 &&
           parser.NormalizedExprLayerPhysicalBufferCount(
               plan.exprLayer) == 0 &&
           parser.NormalizedExprLayerRetainedBytes(
               plan.exprLayer) == int64(0) &&
           plan.runtimeTargets.cap == 0 &&
           layout.FixedBytes32Equal(
               plan.sourceBundleBindingSeal,
               layout.FixedBytes32()) &&
           plan.sourceBundleEntrySourceIndex == -1

fn systemLinkPlanCompilerInputReleaseOwnerToken(
        plan: var SystemLinkPlanStub,
        sourceBundleMoved: bool,
        sourceBundleOwnerToken: layout.FixedBytes32,
        releasedBufferCount: int32,
        releasedBytes: int64): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(1024)
    SystemLinkPlanBindingAppendText(
        buf, "cheng.compiler.system_link_compiler_input.owner_release")
    SystemLinkPlanBindingAppendU32Field(
        buf,
        sourceBundleMoved ?
            SystemLinkPlanCompilerResidualOwnedStorageColumnCount :
            SystemLinkPlanCompilerInputOwnedStorageColumnCount)
    SystemLinkPlanBindingAppendU32Field(
        buf, sourceBundleMoved ? 1 : 0)
    SystemLinkPlanBindingAppendFixed32Field(
        buf, sourceBundleOwnerToken)
    SystemLinkPlanBindingAppendU32Field(buf, releasedBufferCount)
    systemLinkPlanBindingAppendI64Field(buf, releasedBytes)
    SystemLinkPlanBindingAppendFixed32Field(
        buf, plan.sourceBundleCidValue)
    SystemLinkPlanBindingAppendFixed32Field(
        buf, plan.sourceBundleEntrySourceCid)
    SystemLinkPlanBindingAppendFixed32Field(
        buf, plan.sourceBundleImportGraphCid)
    SystemLinkPlanBindingAppendFixed32Field(
        buf, plan.sourceBundleBindingSeal)
    SystemLinkPlanBindingAppendFixed32Field(
        buf, plan.managedDependencyReceipt.receiptCid)
    SystemLinkPlanBindingAppendU32Field(
        buf, plan.externalPackageRoots.len)
    SystemLinkPlanBindingAppendU32Field(
        buf, plan.sourceBundleIdentityPaths.len)
    SystemLinkPlanBindingAppendU32Field(
        buf, plan.sourceClosurePaths.len)
    SystemLinkPlanBindingAppendU32Field(
        buf, plan.ownerModulePaths.len)
    SystemLinkPlanBindingAppendU32Field(
        buf, plan.importEdges.len)
    SystemLinkPlanBindingAppendU32Field(
        buf, plan.runtimeTargets.len)
    SystemLinkPlanBindingAppendU32Field(
        buf, plan.exprLayer.exprs.len)
    let ownerToken =
        hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return ownerToken

@borrows
fn systemLinkPlanReleasePlanRootStrColRec(
        plan: var SystemLinkPlanStub,
        rootIndex: int32,
        texts: bool,
        i: int32) =
    var n: int32
    if texts:
        n = plan.externalPackageRoots[rootIndex].verifiedSourceTexts.len
    else:
        n = plan.externalPackageRoots[rootIndex].verifiedSourcePaths.len
    if i >= n:
        if texts:
            plan.externalPackageRoots[rootIndex].verifiedSourceTexts = []
        else:
            plan.externalPackageRoots[rootIndex].verifiedSourcePaths = []
        return
    if texts:
        plan.externalPackageRoots[rootIndex].verifiedSourceTexts[i] = ""
    else:
        plan.externalPackageRoots[rootIndex].verifiedSourcePaths[i] = ""
    systemLinkPlanReleasePlanRootStrColRec(plan, rootIndex, texts, i + 1)

@borrows
fn systemLinkPlanReleasePlanExternalRootsRec(
        plan: var SystemLinkPlanStub,
        rootIndex: int32) =
    if rootIndex >= plan.externalPackageRoots.len:
        return
    plan.externalPackageRoots[rootIndex].packageId = ""
    plan.externalPackageRoots[rootIndex].canonicalPackageId = ""
    plan.externalPackageRoots[rootIndex].packageRoot = ""
    plan.externalPackageRoots[rootIndex].channel = ""
    systemLinkPlanReleasePlanRootStrColRec(plan, rootIndex, false, 0)
    systemLinkPlanReleasePlanRootStrColRec(plan, rootIndex, true, 0)
    systemLinkPlanReleasePlanExternalRootsRec(plan, rootIndex + 1)

@borrows
fn systemLinkPlanClearManagedDependencyEntriesRec(
        plan: var SystemLinkPlanStub,
        entryIndex: int32) =
    if entryIndex >= plan.managedDependencyReceipt.entries.len:
        return
    plan.managedDependencyReceipt.entries[entryIndex].canonicalPackageId = ""
    systemLinkPlanClearManagedDependencyEntriesRec(plan, entryIndex + 1)

@borrows
fn systemLinkPlanClearPlanImportEdgesRec(
        plan: var SystemLinkPlanStub,
        edgeIndex: int32) =
    if edgeIndex >= plan.importEdges.len:
        return
    plan.importEdges[edgeIndex].ownerModulePath = ""
    plan.importEdges[edgeIndex].targetModulePath = ""
    plan.importEdges[edgeIndex].targetSourcePath = ""
    plan.importEdges[edgeIndex].importAlias = ""
    plan.importEdges[edgeIndex].qualifier = ""
    systemLinkPlanClearPlanImportEdgesRec(plan, edgeIndex + 1)

fn systemLinkPlanCompilerInputReleaseWithReceiptMode(
        plan: var SystemLinkPlanStub,
        sourceBundleMoved: bool,
        sourceBundleOwnerToken: layout.FixedBytes32,
        receipt: var SystemLinkPlanCompilerInputReleaseReceipt) =
    if plan.compilerInputReleaseReceipt.storageReleased ||
       plan.compilerInputReleaseReceiptConsumed:
        panic("system link plan: duplicate compiler input release")
    let releasedBufferCount =
        SystemLinkPlanCompilerInputRetainedBufferCount(plan)
    let releasedBytes =
        SystemLinkPlanCompilerInputRetainedBytes(plan)
    let ownerToken =
        systemLinkPlanCompilerInputReleaseOwnerToken(
            plan,
            sourceBundleMoved,
            sourceBundleOwnerToken,
            releasedBufferCount,
            releasedBytes)
    if layout.FixedBytes32Equal(ownerToken, layout.FixedBytes32()) ||
       releasedBufferCount < 0 ||
       releasedBytes < int64(0):
        panic("system link plan: invalid compiler input release preimage")
    systemLinkPlanReleasePlanExternalRootsRec(plan, 0)
    seqs.chengSeqFreeTyped(plan.externalPackageRoots)
    plan.externalPackageRoots = []
    SystemLinkPlanManagedDependencyReceiptReleaseOwned(
        plan.managedDependencyReceipt)
    plan.managedDependencyReceipt = SystemLinkPlanManagedDependencyReceipt()
    seqs.freeSeqStrRelease(plan.sourceBundleIdentityPaths)
    plan.sourceBundleIdentityPaths = []
    seqs.freeSeqStrRelease(plan.sourceClosurePaths)
    plan.sourceClosurePaths = []
    seqs.freeSeqStrRelease(plan.ownerModulePaths)
    plan.ownerModulePaths = []
    systemLinkPlanClearPlanImportEdgesRec(plan, 0)
    seqs.chengSeqFreeTyped(plan.importEdges)
    plan.importEdges = []
    var exprLayerReceipt: parser.NormalizedExprLayerTerminalReleaseReceipt
    parser.NormalizedExprLayerTerminalReleaseWithReceipt(
        plan.exprLayer, exprLayerReceipt)
    plan.exprLayer = parser.NormalizedExprLayer()
    seqs.freeSeqStrRelease(plan.runtimeTargets)
    plan.runtimeTargets = []
    plan.sourceBundleBindingSeal = layout.FixedBytes32()
    plan.sourceBundleEntrySourceIndex = -1
    receipt.ownerToken = ownerToken
    receipt.sourceBundleOwnerToken =
        layout.FixedBytes32Copy(sourceBundleOwnerToken)
    receipt.sourceBundleMoved = sourceBundleMoved
    receipt.releasedOwnedStorageColumnCount =
        sourceBundleMoved ?
            SystemLinkPlanCompilerResidualOwnedStorageColumnCount :
            SystemLinkPlanCompilerInputOwnedStorageColumnCount
    receipt.releasedBufferCount = releasedBufferCount
    receipt.releasedBytes = releasedBytes
    receipt.storageReleased =
        SystemLinkPlanCompilerInputStorageReleased(plan)
    plan.compilerInputReleaseReceipt = receipt
    if !receipt.storageReleased ||
       SystemLinkPlanCompilerInputRetainedBufferCount(plan) != 0 ||
       SystemLinkPlanCompilerInputRetainedBytes(plan) != int64(0) ||
       exprLayerReceipt.releasedBufferCount > releasedBufferCount ||
       exprLayerReceipt.releasedBytes > releasedBytes:
        panic("system link plan: compiler input release incomplete")

fn SystemLinkPlanCompilerInputReleaseWithReceipt(
        plan: var SystemLinkPlanStub,
        receipt: var SystemLinkPlanCompilerInputReleaseReceipt) =
    systemLinkPlanCompilerInputReleaseWithReceiptMode(
        plan,
        false,
        layout.FixedBytes32(),
        receipt)

fn SystemLinkPlanCompilerResidualReleaseAfterSourceBundleMoveWithReceipt(
        plan: var SystemLinkPlanStub,
        sourceBundleOwner: var SystemLinkPlanSourceBundleOwner,
        receipt: var SystemLinkPlanCompilerInputReleaseReceipt) =
    if !sourceBundleOwner.moved ||
       layout.FixedBytes32Equal(
           sourceBundleOwner.ownerToken, layout.FixedBytes32()) ||
       plan.externalPackageRoots.len != 0 ||
       plan.externalPackageRoots.cap != 0 ||
       plan.sourceBundleIdentityPaths.len != 0 ||
       plan.sourceBundleIdentityPaths.cap != 0 ||
       plan.sourceClosurePaths.len != 0 ||
       plan.sourceClosurePaths.cap != 0 ||
       plan.ownerModulePaths.len != 0 ||
       plan.ownerModulePaths.cap != 0 ||
       plan.importEdges.len != 0 ||
       plan.importEdges.cap != 0 ||
       !layout.FixedBytes32Equal(
           plan.sourceBundleBindingSeal, layout.FixedBytes32()) ||
       plan.sourceBundleEntrySourceIndex != -1:
        panic("system link plan: residual release before source bundle move")
    systemLinkPlanCompilerInputReleaseWithReceiptMode(
        plan,
        true,
        sourceBundleOwner.ownerToken,
        receipt)

@borrows
fn SystemLinkPlanCompilerInputReleaseReceiptConsumeStrictInto(
        plan: var SystemLinkPlanStub,
        receipt: SystemLinkPlanCompilerInputReleaseReceipt,
        err: var str): bool =
    return systemLinkPlanCompilerInputReleaseReceiptConsumeStrictCore(
        plan,
        receipt.sourceBundleMoved,
        receipt.sourceBundleOwnerToken,
        receipt.storageReleased,
        receipt.releasedOwnedStorageColumnCount,
        receipt.releasedBufferCount,
        receipt.releasedBytes,
        receipt.ownerToken,
        err)

@borrows
fn SystemLinkPlanCompilerInputReleaseReceiptConsumeStrictPlanInto(
        plan: var SystemLinkPlanStub,
        err: var str): bool =
    return systemLinkPlanCompilerInputReleaseReceiptConsumeStrictCore(
        plan,
        plan.compilerInputReleaseReceipt.sourceBundleMoved,
        plan.compilerInputReleaseReceipt.sourceBundleOwnerToken,
        plan.compilerInputReleaseReceipt.storageReleased,
        plan.compilerInputReleaseReceipt.releasedOwnedStorageColumnCount,
        plan.compilerInputReleaseReceipt.releasedBufferCount,
        plan.compilerInputReleaseReceipt.releasedBytes,
        plan.compilerInputReleaseReceipt.ownerToken,
        err)

@borrows
fn systemLinkPlanCompilerInputReleaseReceiptConsumeStrictCore(
        plan: var SystemLinkPlanStub,
        sourceBundleMoved: bool,
        sourceBundleOwnerToken: layout.FixedBytes32,
        storageReleased: bool,
        releasedOwnedStorageColumnCount: int32,
        releasedBufferCount: int32,
        releasedBytes: int64,
        ownerToken: layout.FixedBytes32,
        err: var str): bool =
    err = ""
    let expectedOwnedStorageColumnCount =
        sourceBundleMoved ?
            SystemLinkPlanCompilerResidualOwnedStorageColumnCount :
            SystemLinkPlanCompilerInputOwnedStorageColumnCount
    if plan.compilerInputReleaseReceiptConsumed ||
       !storageReleased ||
       !plan.compilerInputReleaseReceipt.storageReleased ||
       sourceBundleMoved !=
           plan.compilerInputReleaseReceipt.sourceBundleMoved ||
       !layout.FixedBytes32Equal(
           sourceBundleOwnerToken,
           plan.compilerInputReleaseReceipt.sourceBundleOwnerToken) ||
       (sourceBundleMoved &&
        layout.FixedBytes32Equal(
            sourceBundleOwnerToken,
            layout.FixedBytes32())) ||
       (!sourceBundleMoved &&
        !layout.FixedBytes32Equal(
            sourceBundleOwnerToken,
            layout.FixedBytes32())) ||
       releasedOwnedStorageColumnCount !=
           expectedOwnedStorageColumnCount ||
       releasedOwnedStorageColumnCount !=
           plan.compilerInputReleaseReceipt.releasedOwnedStorageColumnCount ||
       releasedBufferCount !=
           plan.compilerInputReleaseReceipt.releasedBufferCount ||
       releasedBytes !=
           plan.compilerInputReleaseReceipt.releasedBytes ||
       !layout.FixedBytes32Equal(
           ownerToken,
           plan.compilerInputReleaseReceipt.ownerToken) ||
       !SystemLinkPlanCompilerInputStorageReleased(plan) ||
       SystemLinkPlanCompilerInputRetainedBufferCount(plan) != 0 ||
       SystemLinkPlanCompilerInputRetainedBytes(plan) != int64(0):
        err = "system link plan: compiler input release receipt mismatch"
        return false
    plan.compilerInputReleaseReceiptConsumed = true
    return true

fn SystemLinkPlanRetainedBufferCount(
        plan: var SystemLinkPlanStub): int32 =
    var bufferCount: int32
    var retainedBytes: int64
    systemLinkPlanRecordStringArrayStorage(
        plan.exportRootSymbols, bufferCount, retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        plan.externalPackageRoots.cap,
        sizeof(parser.ParserExternalPackageRoot),
        bufferCount,
        retainedBytes)
    for rootIndex in 0..<plan.externalPackageRoots.len:
        systemLinkPlanRecordStringArrayStorage(
            plan.externalPackageRoots[
                rootIndex].verifiedSourcePaths,
            bufferCount,
            retainedBytes)
        systemLinkPlanRecordStringArrayStorage(
            plan.externalPackageRoots[
                rootIndex].verifiedSourceTexts,
            bufferCount,
            retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        plan.managedDependencyReceipt.entries.cap,
        sizeof(SystemLinkPlanManagedDependencyReceiptEntry),
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.sourceBundleIdentityPaths,
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.sourceClosurePaths,
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.ownerModulePaths,
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        plan.importEdges.cap,
        sizeof(parser.ImportEdge),
        bufferCount,
        retainedBytes)
    bufferCount =
        bufferCount +
        parser.NormalizedExprLayerPhysicalBufferCount(
            plan.exprLayer)
    systemLinkPlanRecordStringArrayStorage(
        plan.runtimeTargets, bufferCount, retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.providerModules, bufferCount, retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.providerObjectPaths, bufferCount, retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.missingReasons, bufferCount, retainedBytes)
    return bufferCount

fn SystemLinkPlanRetainedBytes(
        plan: var SystemLinkPlanStub): int64 =
    var bufferCount: int32
    var retainedBytes =
        int64(plan.entryPath.len) +
        int64(plan.outputPath.len) +
        int64(plan.targetTriple.len) +
        int64(plan.symbolVisibility.len) +
        int64(plan.browserBridgeObjectPath.len) +
        int64(plan.packageRoot.len) +
        int64(plan.managedDependencyReceipt.channel.len) +
        int64(plan.workspaceRoot.len) +
        int64(plan.packageId.len) +
        int64(plan.moduleStem.len) +
        int64(plan.sourceBundleCid.err.msg.len) +
        int64(plan.runtimeProviderBundle.len) +
        int64(plan.entrySymbol.len) +
        int64(plan.parserSyntaxTag.len) +
        int64(plan.buildEntryPath.len) +
        int64(plan.linkMode.len) +
        int64(plan.pipelineStage.len)
    systemLinkPlanRecordStringArrayStorage(
        plan.exportRootSymbols, bufferCount, retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        plan.externalPackageRoots.cap,
        sizeof(parser.ParserExternalPackageRoot),
        bufferCount,
        retainedBytes)
    for rootIndex in 0..<plan.externalPackageRoots.len:
        retainedBytes =
            retainedBytes +
            int64(
                plan.externalPackageRoots[
                    rootIndex].packageId.len) +
            int64(
                plan.externalPackageRoots[
                    rootIndex].canonicalPackageId.len) +
            int64(
                plan.externalPackageRoots[
                    rootIndex].packageRoot.len) +
            int64(
                plan.externalPackageRoots[
                    rootIndex].channel.len)
        systemLinkPlanRecordStringArrayStorage(
            plan.externalPackageRoots[
                rootIndex].verifiedSourcePaths,
            bufferCount,
            retainedBytes)
        systemLinkPlanRecordStringArrayStorage(
            plan.externalPackageRoots[
                rootIndex].verifiedSourceTexts,
            bufferCount,
            retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        plan.managedDependencyReceipt.entries.cap,
        sizeof(SystemLinkPlanManagedDependencyReceiptEntry),
        bufferCount,
        retainedBytes)
    for entryIndex in 0..<
            plan.managedDependencyReceipt.entries.len:
        retainedBytes =
            retainedBytes +
            int64(
                plan.managedDependencyReceipt.entries[
                    entryIndex].canonicalPackageId.len)
    systemLinkPlanRecordStringArrayStorage(
        plan.sourceBundleIdentityPaths,
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.sourceClosurePaths,
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.ownerModulePaths,
        bufferCount,
        retainedBytes)
    systemLinkPlanRecordSequenceStorage(
        plan.importEdges.cap,
        sizeof(parser.ImportEdge),
        bufferCount,
        retainedBytes)
    for edgeIndex in 0..<plan.importEdges.len:
        retainedBytes =
            retainedBytes +
            int64(plan.importEdges[edgeIndex].ownerModulePath.len) +
            int64(plan.importEdges[edgeIndex].targetModulePath.len) +
            int64(plan.importEdges[edgeIndex].targetSourcePath.len) +
            int64(plan.importEdges[edgeIndex].importAlias.len) +
            int64(plan.importEdges[edgeIndex].qualifier.len)
    retainedBytes =
        retainedBytes +
        parser.NormalizedExprLayerRetainedBytes(plan.exprLayer)
    systemLinkPlanRecordStringArrayStorage(
        plan.runtimeTargets, bufferCount, retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.providerModules, bufferCount, retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.providerObjectPaths, bufferCount, retainedBytes)
    systemLinkPlanRecordStringArrayStorage(
        plan.missingReasons, bufferCount, retainedBytes)
    return retainedBytes

fn systemLinkPlanReleaseOwnerToken(
        plan: var SystemLinkPlanStub,
        releasedOwnedStorageColumnCount: int32,
        releasedBufferCount: int32,
        releasedBytes: int64): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(1024)
    SystemLinkPlanBindingAppendText(
        buf, "cheng.compiler.system_link_plan.owner_release")
    SystemLinkPlanBindingAppendU32Field(
        buf, releasedOwnedStorageColumnCount)
    SystemLinkPlanBindingAppendU32Field(
        buf, releasedBufferCount)
    systemLinkPlanBindingAppendI64Field(
        buf, releasedBytes)
    SystemLinkPlanBindingAppendText(buf, plan.entryPath)
    SystemLinkPlanBindingAppendText(buf, plan.outputPath)
    SystemLinkPlanBindingAppendText(buf, plan.targetTriple)
    SystemLinkPlanBindingAppendText(
        buf, plan.symbolVisibility)
    SystemLinkPlanBindingAppendText(
        buf, plan.browserBridgeObjectPath)
    SystemLinkPlanBindingAppendText(buf, plan.packageRoot)
    SystemLinkPlanBindingAppendText(buf, plan.workspaceRoot)
    SystemLinkPlanBindingAppendText(buf, plan.packageId)
    SystemLinkPlanBindingAppendText(buf, plan.moduleStem)
    SystemLinkPlanBindingAppendText(
        buf, plan.sourceBundleCid.err.msg)
    SystemLinkPlanBindingAppendText(
        buf, plan.runtimeProviderBundle)
    SystemLinkPlanBindingAppendText(buf, plan.entrySymbol)
    SystemLinkPlanBindingAppendText(
        buf, plan.parserSyntaxTag)
    SystemLinkPlanBindingAppendText(
        buf, plan.buildEntryPath)
    SystemLinkPlanBindingAppendText(buf, plan.linkMode)
    SystemLinkPlanBindingAppendText(
        buf, plan.pipelineStage)
    SystemLinkPlanBindingAppendFixed32Field(
        buf, plan.sourceBundleCidValue)
    SystemLinkPlanBindingAppendFixed32Field(
        buf, plan.sourceBundleBindingSeal)
    SystemLinkPlanBindingAppendFixed32Field(
        buf, plan.sourceBundleEntrySourceCid)
    SystemLinkPlanBindingAppendFixed32Field(
        buf, plan.sourceBundleImportGraphCid)
    SystemLinkPlanBindingAppendTexts(
        buf, plan.exportRootSymbols)
    SystemLinkPlanBindingAppendTexts(
        buf, plan.sourceBundleIdentityPaths)
    SystemLinkPlanBindingAppendTexts(
        buf, plan.sourceClosurePaths)
    SystemLinkPlanBindingAppendTexts(
        buf, plan.ownerModulePaths)
    SystemLinkPlanBindingAppendTexts(
        buf, plan.runtimeTargets)
    SystemLinkPlanBindingAppendTexts(
        buf, plan.providerModules)
    SystemLinkPlanBindingAppendTexts(
        buf, plan.providerObjectPaths)
    SystemLinkPlanBindingAppendTexts(
        buf, plan.missingReasons)
    SystemLinkPlanBindingAppendU32Field(
        buf, plan.externalPackageRoots.len)
    for rootIndex in 0..<plan.externalPackageRoots.len:
        SystemLinkPlanBindingAppendText(
            buf,
            plan.externalPackageRoots[rootIndex].packageId)
        SystemLinkPlanBindingAppendText(
            buf,
            plan.externalPackageRoots[
                rootIndex].canonicalPackageId)
        SystemLinkPlanBindingAppendText(
            buf,
            plan.externalPackageRoots[rootIndex].packageRoot)
        SystemLinkPlanBindingAppendText(
            buf,
            plan.externalPackageRoots[rootIndex].channel)
        SystemLinkPlanBindingAppendTexts(
            buf,
            plan.externalPackageRoots[
                rootIndex].verifiedSourcePaths)
        SystemLinkPlanBindingAppendTexts(
            buf,
            plan.externalPackageRoots[
                rootIndex].verifiedSourceTexts)
    SystemLinkPlanBindingAppendText(
        buf, plan.managedDependencyReceipt.channel)
    SystemLinkPlanBindingAppendFixed32Field(
        buf, plan.managedDependencyReceipt.receiptCid)
    SystemLinkPlanBindingAppendU32Field(
        buf, plan.managedDependencyReceipt.entries.len)
    for entryIndex in 0..<
            plan.managedDependencyReceipt.entries.len:
        SystemLinkPlanBindingAppendText(
            buf,
            plan.managedDependencyReceipt.entries[
                entryIndex].canonicalPackageId)
        SystemLinkPlanBindingAppendFixed32Field(
            buf,
            plan.managedDependencyReceipt.entries[
                entryIndex].snapshotCid)
        SystemLinkPlanBindingAppendFixed32Field(
            buf,
            plan.managedDependencyReceipt.entries[
                entryIndex].syntaxSurfaceCid)
        SystemLinkPlanBindingAppendFixed32Field(
            buf,
            plan.managedDependencyReceipt.entries[
                entryIndex].migrationProofCid)
        SystemLinkPlanBindingAppendFixed32Field(
            buf,
            plan.managedDependencyReceipt.entries[
                entryIndex].priorManagedMirrorBundleCid)
    SystemLinkPlanBindingAppendU32Field(
        buf, plan.importEdges.len)
    for edgeIndex in 0..<plan.importEdges.len:
        SystemLinkPlanBindingAppendText(
            buf, plan.importEdges[edgeIndex].ownerModulePath)
        SystemLinkPlanBindingAppendText(
            buf, plan.importEdges[edgeIndex].targetModulePath)
        SystemLinkPlanBindingAppendText(
            buf, plan.importEdges[edgeIndex].targetSourcePath)
        SystemLinkPlanBindingAppendText(
            buf, plan.importEdges[edgeIndex].importAlias)
        SystemLinkPlanBindingAppendText(
            buf, plan.importEdges[edgeIndex].qualifier)
    let token = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn SystemLinkPlanStorageReleased(
        plan: var SystemLinkPlanStub): bool =
    return plan.entryPath.len == 0 &&
           plan.outputPath.len == 0 &&
           plan.targetTriple.len == 0 &&
           plan.symbolVisibility.len == 0 &&
           plan.browserBridgeObjectPath.len == 0 &&
           plan.exportRootSymbols.len == 0 &&
           plan.exportRootSymbols.cap == 0 &&
           plan.packageRoot.len == 0 &&
           plan.externalPackageRoots.len == 0 &&
           plan.externalPackageRoots.cap == 0 &&
           plan.managedDependencyReceipt.channel.len == 0 &&
           plan.managedDependencyReceipt.entries.len == 0 &&
           plan.managedDependencyReceipt.entries.cap == 0 &&
           plan.workspaceRoot.len == 0 &&
           plan.packageId.len == 0 &&
           plan.moduleStem.len == 0 &&
           plan.sourceBundleCid.err.msg.len == 0 &&
           plan.sourceBundleIdentityPaths.len == 0 &&
           plan.sourceBundleIdentityPaths.cap == 0 &&
           plan.sourceClosurePaths.len == 0 &&
           plan.sourceClosurePaths.cap == 0 &&
           plan.ownerModulePaths.len == 0 &&
           plan.ownerModulePaths.cap == 0 &&
           plan.importEdges.len == 0 &&
           plan.importEdges.cap == 0 &&
           parser.NormalizedExprLayerStorageReleased(
               plan.exprLayer) &&
           plan.runtimeTargets.len == 0 &&
           plan.runtimeTargets.cap == 0 &&
           plan.providerModules.len == 0 &&
           plan.providerModules.cap == 0 &&
           plan.providerObjectPaths.len == 0 &&
           plan.providerObjectPaths.cap == 0 &&
           plan.runtimeProviderBundle.len == 0 &&
           plan.entrySymbol.len == 0 &&
           plan.missingReasons.len == 0 &&
           plan.missingReasons.cap == 0 &&
           plan.parserSyntaxTag.len == 0 &&
           plan.buildEntryPath.len == 0 &&
           plan.linkMode.len == 0 &&
           plan.pipelineStage.len == 0

fn SystemLinkPlanReleaseWithReceipt(
        plan: var SystemLinkPlanStub,
        receipt: var SystemLinkPlanReleaseReceipt) =
    if plan.terminalStorageReleased ||
       plan.terminalReleaseReceiptConsumed ||
       !layout.FixedBytes32Equal(
           plan.terminalReleaseOwnerToken,
           layout.FixedBytes32()) ||
       plan.terminalReleasedOwnedStorageColumnCount != 0 ||
       plan.terminalReleasedBufferCount != 0 ||
       plan.terminalReleasedBytes != int64(0):
        panic("system link plan: duplicate or corrupt terminal release")
    var releasedOwnedStorageColumnCount =
        SystemLinkPlanOwnedStorageColumnCount
    if plan.compilerInputReleaseReceipt.storageReleased:
        if !plan.compilerInputReleaseReceiptConsumed:
            var compilerInputErr: str
            if !SystemLinkPlanCompilerInputReleaseReceiptConsumeStrictPlanInto(
                   plan,
                   compilerInputErr):
                panic(compilerInputErr)
        releasedOwnedStorageColumnCount =
            SystemLinkPlanRuntimeResidualOwnedStorageColumnCount
    let releasedBufferCount =
        SystemLinkPlanRetainedBufferCount(plan)
    let releasedBytes =
        SystemLinkPlanRetainedBytes(plan)
    let ownerToken =
        systemLinkPlanReleaseOwnerToken(
            plan,
            releasedOwnedStorageColumnCount,
            releasedBufferCount,
            releasedBytes)
    if layout.FixedBytes32Equal(
           ownerToken, layout.FixedBytes32()) ||
       releasedBufferCount < 0 ||
       releasedBytes < int64(0):
        panic("system link plan: invalid terminal release preimage")
    plan.entryPath = ""
    plan.outputPath = ""
    plan.targetTriple = ""
    plan.symbolVisibility = ""
    plan.browserBridgeObjectPath = ""
    seqs.freeSeqStrRelease(plan.exportRootSymbols)
    plan.exportRootSymbols = []
    plan.packageRoot = ""
    systemLinkPlanReleasePlanExternalRootsRec(plan, 0)
    seqs.chengSeqFreeTyped(plan.externalPackageRoots)
    plan.externalPackageRoots = []
    plan.managedDependencyReceipt.channel = ""
    systemLinkPlanClearManagedDependencyEntriesRec(plan, 0)
    seqs.chengSeqFreeTyped(plan.managedDependencyReceipt.entries)
    plan.managedDependencyReceipt.entries = []
    plan.workspaceRoot = ""
    plan.packageId = ""
    plan.moduleStem = ""
    plan.sourceBundleCid.err.msg = ""
    seqs.freeSeqStrRelease(plan.sourceBundleIdentityPaths)
    plan.sourceBundleIdentityPaths = []
    seqs.freeSeqStrRelease(plan.sourceClosurePaths)
    plan.sourceClosurePaths = []
    seqs.freeSeqStrRelease(plan.ownerModulePaths)
    plan.ownerModulePaths = []
    systemLinkPlanClearPlanImportEdgesRec(plan, 0)
    seqs.chengSeqFreeTyped(plan.importEdges)
    plan.importEdges = []
    var exprLayerReceipt: parser.NormalizedExprLayerTerminalReleaseReceipt
    parser.NormalizedExprLayerTerminalReleaseWithReceipt(
        plan.exprLayer, exprLayerReceipt)
    plan.exprLayer = parser.NormalizedExprLayer()
    seqs.freeSeqStrRelease(plan.runtimeTargets)
    plan.runtimeTargets = []
    seqs.freeSeqStrRelease(plan.providerModules)
    plan.providerModules = []
    seqs.freeSeqStrRelease(plan.providerObjectPaths)
    plan.providerObjectPaths = []
    plan.runtimeProviderBundle = ""
    plan.entrySymbol = ""
    seqs.freeSeqStrRelease(plan.missingReasons)
    plan.missingReasons = []
    plan.parserSyntaxTag = ""
    plan.buildEntryPath = ""
    plan.linkMode = ""
    plan.pipelineStage = ""
    plan.terminalReleaseOwnerToken = ownerToken
    plan.terminalReleasedOwnedStorageColumnCount =
        releasedOwnedStorageColumnCount
    plan.terminalReleasedBufferCount =
        releasedBufferCount
    plan.terminalReleasedBytes = releasedBytes
    plan.terminalStorageReleased =
        SystemLinkPlanStorageReleased(plan)
    receipt.ownerToken = ownerToken
    receipt.releasedOwnedStorageColumnCount =
        releasedOwnedStorageColumnCount
    receipt.releasedBufferCount = releasedBufferCount
    receipt.releasedBytes = releasedBytes
    receipt.storageReleased =
        plan.terminalStorageReleased
    if !receipt.storageReleased ||
       SystemLinkPlanRetainedBufferCount(plan) != 0 ||
       SystemLinkPlanRetainedBytes(plan) != int64(0) ||
       exprLayerReceipt.releasedBufferCount >
           releasedBufferCount ||
       exprLayerReceipt.releasedBytes >
           releasedBytes:
        panic("system link plan: terminal storage release incomplete")

fn SystemLinkPlanReleaseReceiptConsumeStrictInto(
        plan: var SystemLinkPlanStub,
        receipt: var SystemLinkPlanReleaseReceipt,
        err: var str): bool =
    err = ""
    if !plan.terminalStorageReleased ||
       plan.terminalReleaseReceiptConsumed ||
       !receipt.storageReleased ||
       (receipt.releasedOwnedStorageColumnCount !=
            SystemLinkPlanOwnedStorageColumnCount &&
        receipt.releasedOwnedStorageColumnCount !=
            SystemLinkPlanRuntimeResidualOwnedStorageColumnCount) ||
       receipt.releasedOwnedStorageColumnCount !=
           plan.terminalReleasedOwnedStorageColumnCount ||
       receipt.releasedBufferCount !=
           plan.terminalReleasedBufferCount ||
       receipt.releasedBytes !=
           plan.terminalReleasedBytes ||
       !layout.FixedBytes32Equal(
           receipt.ownerToken,
           plan.terminalReleaseOwnerToken) ||
       !SystemLinkPlanStorageReleased(plan) ||
       SystemLinkPlanRetainedBufferCount(plan) != 0 ||
       SystemLinkPlanRetainedBytes(plan) != int64(0):
        err = "system link plan: terminal release receipt mismatch"
        return false
    plan.terminalReleaseReceiptConsumed = true
    return true

fn systemLinkPlanManagedDependencyEntriesCapacity(
        entries: var SystemLinkPlanManagedDependencyReceiptEntry[]): int32 =
    return entries.cap

fn SystemLinkPlanManagedDependencyReceiptRetainedBufferCount(
        receipt: var SystemLinkPlanManagedDependencyReceipt): int32 =
    if systemLinkPlanManagedDependencyEntriesCapacity(
           receipt.entries) > 0:
        return 1
    return 0

fn SystemLinkPlanManagedDependencyReceiptRetainedBytes(
        receipt: var SystemLinkPlanManagedDependencyReceipt): int64 =
    var retainedBytes =
        int64(receipt.channel.len) +
        int64(systemLinkPlanManagedDependencyEntriesCapacity(
            receipt.entries)) *
            int64(sizeof(SystemLinkPlanManagedDependencyReceiptEntry))
    for entryIndex in 0..<receipt.entries.len:
        retainedBytes =
            retainedBytes +
            int64(receipt.entries[entryIndex].canonicalPackageId.len)
    return retainedBytes

fn SystemLinkPlanManagedDependencyReceiptStorageReleased(
        receipt: var SystemLinkPlanManagedDependencyReceipt): bool =
    return receipt.channel == "" &&
           systemLinkPlanManagedDependencyEntriesCapacity(
               receipt.entries) == 0

@borrows
fn systemLinkPlanClearManagedDependencyReceiptEntriesRec(
        receipt: var SystemLinkPlanManagedDependencyReceipt,
        entryIndex: int32) =
    if entryIndex >= receipt.entries.len:
        return
    receipt.entries[entryIndex].canonicalPackageId = ""
    systemLinkPlanClearManagedDependencyReceiptEntriesRec(receipt, entryIndex + 1)

fn SystemLinkPlanManagedDependencyReceiptReleaseOwned(
        receipt: var SystemLinkPlanManagedDependencyReceipt) =
    receipt.channel = ""
    systemLinkPlanClearManagedDependencyReceiptEntriesRec(receipt, 0)
    seqs.chengSeqFreeTyped(receipt.entries)
    receipt.entries = []

@borrows
fn SystemLinkPlanManagedDependencyReceiptCid(
        receipt: SystemLinkPlanManagedDependencyReceipt): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(384)
    SystemLinkPlanBindingAppendText(
        buf,
        "cheng.compiler.managed_dependency_receipt")
    SystemLinkPlanBindingAppendText(buf, receipt.channel)
    SystemLinkPlanBindingAppendU32Field(buf, receipt.dependencyCount)
    for entryIndex in 0..<receipt.entries.len:
        let entry = receipt.entries[entryIndex]
        SystemLinkPlanBindingAppendText(buf, entry.canonicalPackageId)
        SystemLinkPlanBindingAppendFixed32Field(buf, entry.snapshotCid)
        SystemLinkPlanBindingAppendFixed32Field(buf, entry.syntaxSurfaceCid)
        SystemLinkPlanBindingAppendFixed32Field(buf, entry.migrationProofCid)
        SystemLinkPlanBindingAppendFixed32Field(
            buf,
            entry.priorManagedMirrorBundleCid)
    let cid = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return cid

@borrows
fn SystemLinkPlanManagedDependencyReceiptPresent(
        receipt: SystemLinkPlanManagedDependencyReceipt): bool =
    return receipt.channel != "" || receipt.dependencyCount != 0 ||
           receipt.entries.len != 0 ||
           !layout.FixedBytes32Equal(receipt.receiptCid,
                                     layout.FixedBytes32())

@borrows
fn SystemLinkPlanManagedDependencyReceiptVerifyInto(
        receipt: SystemLinkPlanManagedDependencyReceipt,
        err: var str): bool =
    let channelRes = cworld.CompilerWorldNormalizeChannel(receipt.channel)
    if IsErr(channelRes) || Value(channelRes) != receipt.channel ||
       receipt.dependencyCount <= 0 ||
       receipt.dependencyCount != receipt.entries.len:
        err = " system link plan: managed dependency receipt shape invalid"
        return false
    let zeroCid = layout.FixedBytes32()
    for entryIndex in 0..<receipt.entries.len:
        let entry = receipt.entries[entryIndex]
        let canonicalPackageId = parser.ParserManifestNormalizePackageId(
            entry.canonicalPackageId)
        if canonicalPackageId == "" ||
           canonicalPackageId != entry.canonicalPackageId ||
           !parser.ParserSourceIdentityModuleTextValid(
               entry.canonicalPackageId) ||
           layout.FixedBytes32Equal(entry.snapshotCid, zeroCid) ||
           layout.FixedBytes32Equal(entry.syntaxSurfaceCid, zeroCid) ||
           layout.FixedBytes32Equal(entry.migrationProofCid, zeroCid) ||
           layout.FixedBytes32Equal(entry.priorManagedMirrorBundleCid,
                                    zeroCid):
            err = Fmt" system link plan: managed dependency receipt entry invalid index={entryIndex}"
            return false
        if entryIndex > 0 &&
           !SystemLinkPlanTextLess(
               receipt.entries[entryIndex - 1].canonicalPackageId,
               entry.canonicalPackageId):
            err = Fmt" system link plan: managed dependency receipt order invalid index={entryIndex}"
            return false
    let expectedCid = SystemLinkPlanManagedDependencyReceiptCid(receipt)
    if !layout.FixedBytes32Equal(expectedCid, receipt.receiptCid):
        err = " system link plan: managed dependency receipt cid mismatch"
        return false
    err = ""
    return true

@borrows
fn SystemLinkPlanManagedDependencyReceiptFromLockInto(
        lock: cworld.CompilerLockSnapshot,
        out: var SystemLinkPlanManagedDependencyReceipt,
        err: var str): bool =
    out = SystemLinkPlanManagedDependencyReceipt()
    if !cworld.CompilerLockSnapshotStrictValidateInto(lock, err):
        return false
    let channelRes = cworld.CompilerWorldNormalizeChannel(lock.channel)
    if lock.entryCount != lock.entries.len || IsErr(channelRes) ||
       Value(channelRes) != lock.channel:
        err = " system link plan: managed dependency lock identity invalid"
        return false
    var ordered: SystemLinkPlanManagedDependencyReceiptEntry[]
    let zeroCid = layout.FixedBytes32()
    for manifestIndex in 0..<lock.entries.len:
        let manifestEntry = lock.entries[manifestIndex]
        if layout.FixedBytes32Equal(manifestEntry.managedMirrorBundleCid,
                                    zeroCid):
            continue
        var entry: SystemLinkPlanManagedDependencyReceiptEntry
        entry.canonicalPackageId =
            strings.CloneStr(manifestEntry.packageId)
        entry.snapshotCid = manifestEntry.snapshotCid
        entry.syntaxSurfaceCid = manifestEntry.syntaxSurfaceCid
        entry.migrationProofCid = manifestEntry.migrationProofCid
        entry.priorManagedMirrorBundleCid =
            manifestEntry.managedMirrorBundleCid
        var insertAt = ordered.len
        while insertAt > 0 &&
              SystemLinkPlanTextLess(
                  entry.canonicalPackageId,
                  ordered[insertAt - 1].canonicalPackageId):
            insertAt = insertAt - 1
        add(ordered, SystemLinkPlanManagedDependencyReceiptEntry())
        var cursor = ordered.len - 1
        while cursor > insertAt:
            ordered[cursor] = ordered[cursor - 1]
            cursor = cursor - 1
        ordered[insertAt] = entry
    let receiptCidMissing = layout.FixedBytes32Equal(
        lock.managedDependencyReceiptCid,
        zeroCid)
    if ordered.len <= 0:
        if !receiptCidMissing:
            err = " system link plan: managed dependency receipt cid has no compact entries"
            return false
        err = ""
        return true
    if receiptCidMissing:
        err = " system link plan: managed dependency compact entries have no receipt cid"
        return false
    var next: SystemLinkPlanManagedDependencyReceipt
    next.channel = strings.CloneStr(lock.channel)
    next.dependencyCount = ordered.len
    next.entries = ordered
    next.receiptCid = SystemLinkPlanManagedDependencyReceiptCid(next)
    if !layout.FixedBytes32Equal(next.receiptCid,
                                 lock.managedDependencyReceiptCid):
        err = " system link plan: managed dependency lock receipt cid mismatch"
        return false
    if !SystemLinkPlanManagedDependencyReceiptVerifyInto(next, err):
        return false
    out = next
    err = ""
    return true

@borrows
fn SystemLinkPlanBindManagedDependencyReceiptFromLockInto(
        plan: var SystemLinkPlanStub,
        lock: cworld.CompilerLockSnapshot,
        err: var str): bool =
    var receipt: SystemLinkPlanManagedDependencyReceipt
    if !SystemLinkPlanManagedDependencyReceiptFromLockInto(lock,
                                                             receipt,
                                                             err):
        return false
    plan.managedDependencyReceipt = receipt
    err = ""
    return true

@borrows
fn SystemLinkPlanPortableTargetModulePathInto(
        rawTargetModulePath: str,
        modulePaths: str[],
        outTargetModulePath: var str): bool =
    outTargetModulePath = ""
    if !parser.ParserSourceIdentityModuleTextValid(rawTargetModulePath):
        return false
    var exactIndex: int32 = -1
    for moduleIndex in 0..<modulePaths.len:
        let modulePath = modulePaths[moduleIndex]
        if modulePath == rawTargetModulePath:
            if exactIndex >= 0:
                return false
            exactIndex = moduleIndex
    if exactIndex >= 0:
        outTargetModulePath = parser.ParserOwnedText(
            modulePaths[exactIndex])
        return true

    # The language has one explicit compatibility spelling:
    # `cheng/<pkg>/<path>` normalizes to canonical `<pkg>/<path>`.  A unique
    # suffix match is not an identity proof and must never select a module.
    if rawTargetModulePath.len <= 6 ||
       chengpath.TextSlice(rawTargetModulePath, 0, 6) != "cheng/":
        return false
    let compatibilityTarget = chengpath.TextSlice(
        rawTargetModulePath,
        6,
        rawTargetModulePath.len - 6)
    if !parser.ParserSourceIdentityModuleTextValid(compatibilityTarget):
        return false
    var compatibilityIndex: int32 = -1
    for moduleIndex in 0..<modulePaths.len:
        if modulePaths[moduleIndex] != compatibilityTarget:
            continue
        if compatibilityIndex >= 0:
            return false
        compatibilityIndex = moduleIndex
    if compatibilityIndex < 0:
        return false
    outTargetModulePath = parser.ParserOwnedText(
        modulePaths[compatibilityIndex])
    return true

@borrows
fn SystemLinkPlanPortableImportEdgesFromTextsInto(
        modulePaths: str[],
        sourceTexts: str[],
        outEdges: var parser.ImportEdge[],
        err: var str): bool =
    if modulePaths.len <= 0 || modulePaths.len != sourceTexts.len:
        err = " system link plan: portable source columns mismatch"
        return false
    var rebuilt: parser.ImportEdge[]
    for sourceIndex in 0..<modulePaths.len:
        var importSpecs: parser.ParserImportSpec[]
        if !parser.ParserReadImportSpecs(modulePaths[sourceIndex],
                                         sourceTexts[sourceIndex],
                                         importSpecs,
                                         err):
            return false
        for importIndex in 0..<importSpecs.len:
            let importSpec = importSpecs[importIndex]
            var canonicalTargetModulePath: str
            if !SystemLinkPlanPortableTargetModulePathInto(
                    importSpec.targetModulePath,
                    modulePaths,
                    canonicalTargetModulePath):
                err = Fmt" system link plan: portable import target missing owner={modulePaths[sourceIndex]} target={importSpec.targetModulePath}"
                return false
            var edge: parser.ImportEdge
            edge.ownerModulePath = parser.ParserOwnedText(
                modulePaths[sourceIndex])
            edge.targetModulePath = strings.CloneStr(
                canonicalTargetModulePath)
            edge.targetSourcePath = ""
            edge.targetProfileIndex = -1
            edge.importAlias = chengpath.PathTrim(
                parser.ParserOwnedText(importSpec.importAlias))
            let aliasText = parser.ParserIdentPrefix(edge.importAlias)
            if aliasText != "":
                edge.qualifier = aliasText
            else:
                edge.qualifier = parser.ParserLastPathPiece(
                    edge.targetModulePath)
            edge.allowsUnqualifiedCall = edge.importAlias == ""
            edge.resolved = true
            add(rebuilt, edge)
    outEdges = rebuilt
    err = ""
    return true

@borrows
fn SystemLinkPlanPortableSourceBindingSeal(
        binding: SystemLinkPlanPortableSourceBinding): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(256)
    SystemLinkPlanBindingAppendText(
        buf,
        "cheng.system_link.source_bundle_binding.portable")
    SystemLinkPlanBindingAppendText(buf, binding.packageId)
    SystemLinkPlanBindingAppendText(buf, binding.entryModulePath)
    SystemLinkPlanBindingAppendU32Field(buf, binding.sourceCount)
    SystemLinkPlanBindingAppendU32Field(buf, binding.importEdgeCount)
    SystemLinkPlanBindingAppendFixed32Field(buf, binding.sourceBundleCid)
    SystemLinkPlanBindingAppendFixed32Field(buf, binding.entrySourceCid)
    SystemLinkPlanBindingAppendFixed32Field(buf, binding.importGraphCid)
    let seal = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return seal

# Source-path identity bundle cid: the root-out counterpart of
# CompilerWorldSourceBundleCidFromIdentityTextsInto.  Each identity row is
# independently either a canonical absolute source file path (root-out) or a
# valid module text (in-root); the two identity domains can never collide
# because module paths are never absolute.  Domain-separated by its own tag.
@borrows
fn SystemLinkPlanSourcePathBundleCidInto(packageId: str,
                                         identityPaths: str[],
                                         sourceTexts: str[],
                                         outCid: var layout.FixedBytes32): bool =
    if identityPaths.len <= 0 || identityPaths.len != sourceTexts.len:
        return false
    for sourceIndex in 0..<identityPaths.len:
        var canonicalIdentityPath: str
        var identityPathValid = parser.ParserSourceIdentityModuleTextValid(
            identityPaths[sourceIndex])
        if !identityPathValid:
            identityPathValid =
                parser.ParserSourceIdentityPathAbsolute(
                    identityPaths[sourceIndex]) &&
                parser.ParserSourceIdentityLexicalPathInto(
                    identityPaths[sourceIndex],
                    canonicalIdentityPath) &&
                canonicalIdentityPath == identityPaths[sourceIndex]
        if !identityPathValid:
            return false
    var pathOrder: int32[]
    cworld.CompilerWorldPathOrderInto(identityPaths, pathOrder)
    for sourceIndex in 0..<pathOrder.len:
        if identityPaths[pathOrder[sourceIndex]] == "":
            return false
    for sourceIndex in 1..<pathOrder.len:
        if identityPaths[pathOrder[sourceIndex]] ==
           identityPaths[pathOrder[sourceIndex - 1]]:
            return false
    var buf: layout.ByteBuf = layout.ByteBufInit(256)
    SystemLinkPlanBindingAppendText(
        buf,
        "cheng.compiler.source_bundle.source_path")
    SystemLinkPlanBindingAppendText(buf, packageId)
    SystemLinkPlanBindingAppendU32Field(buf, pathOrder.len)
    for orderIndex in 0..<pathOrder.len:
        let sourceIndex = pathOrder[orderIndex]
        SystemLinkPlanBindingAppendText(buf, identityPaths[sourceIndex])
        SystemLinkPlanBindingAppendU32Field(buf, sourceTexts[sourceIndex].len)
        let sourceRawBytesCid =
            cworld.CompilerWorldSourceRawBytesCidBorrowed(
                sourceTexts[sourceIndex])
        SystemLinkPlanBindingAppendFixed32Field(
            buf, sourceRawBytesCid)
    outCid = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return true

@borrows
fn SystemLinkPlanPortableSourceBindingFromRebuiltImportEdgesInto(
        packageId: str,
        entryModulePath: str,
        modulePaths: str[],
        sourceTexts: str[],
        rebuiltImportEdges: parser.ImportEdge[],
        outBinding: var SystemLinkPlanPortableSourceBinding,
        err: var str): bool =
    let canonicalPackageId = parser.ParserManifestNormalizePackageId(
        packageId)
    let entryIsSourcePath = parser.ParserSourceIdentityPathAbsolute(
        entryModulePath)
    if canonicalPackageId == "" || canonicalPackageId != packageId ||
       !parser.ParserSourceIdentityModuleTextValid(packageId) ||
       modulePaths.len <= 0 || modulePaths.len != sourceTexts.len:
        err = " system link plan: portable source identity columns invalid"
        return false
    if !entryIsSourcePath:
        if !parser.ParserSourceIdentityModuleTextValid(entryModulePath) ||
           !SystemLinkPlanModuleOwnedByPackage(entryModulePath, packageId):
            err = " system link plan: portable source identity columns invalid"
            return false
    var entrySourceIndex = -1
    for sourceIndex in 0..<modulePaths.len:
        var canonicalSourceIdentity: str
        var sourceIdentityValid = parser.ParserSourceIdentityModuleTextValid(
            modulePaths[sourceIndex])
        if !sourceIdentityValid:
            sourceIdentityValid =
                parser.ParserSourceIdentityPathAbsolute(
                    modulePaths[sourceIndex]) &&
                parser.ParserSourceIdentityLexicalPathInto(
                    modulePaths[sourceIndex],
                    canonicalSourceIdentity) &&
                canonicalSourceIdentity == modulePaths[sourceIndex]
        if !sourceIdentityValid:
            err = Fmt" system link plan: portable source identity invalid index={sourceIndex}"
            return false
        for priorIndex in 0..<sourceIndex:
            if modulePaths[priorIndex] == modulePaths[sourceIndex]:
                err = Fmt" system link plan: portable module identity duplicated index={sourceIndex}"
                return false
        if modulePaths[sourceIndex] == entryModulePath:
            entrySourceIndex = sourceIndex
    if entrySourceIndex < 0:
        err = " system link plan: portable entry module missing"
        return false
    SystemLinkPlanProgressMemoryStage("after_portable_identity_rows")
    var rebuiltImportGraphCid: layout.FixedBytes32
    if !cworld.CompilerWorldPortableImportGraphCidInto(
            packageId,
            rebuiltImportEdges,
            0,
            rebuiltImportGraphCid,
            err):
        return false
    SystemLinkPlanProgressMemoryStage("after_portable_import_graph_cid")
    var hasSourcePathIdentity = false
    for sourceIndex in 0..<modulePaths.len:
        if parser.ParserSourceIdentityPathAbsolute(modulePaths[sourceIndex]):
            hasSourcePathIdentity = true
            break
    var sourceBundleCid: layout.FixedBytes32
    if hasSourcePathIdentity:
        if !SystemLinkPlanSourcePathBundleCidInto(packageId,
                                                  modulePaths,
                                                  sourceTexts,
                                                  sourceBundleCid):
            err = " system link plan: portable source bundle cid unavailable"
            return false
    else:
        if !cworld.CompilerWorldSourceBundleCidFromIdentityTextsBorrowedInto(
                packageId,
                modulePaths,
                sourceTexts,
                sourceBundleCid):
            err = " system link plan: portable source bundle cid unavailable"
            return false
    SystemLinkPlanProgressMemoryStage("after_portable_source_bundle_cid")
    let entrySourceCid = cworld.CompilerWorldSourceRawBytesCidBorrowed(
        sourceTexts[entrySourceIndex])
    SystemLinkPlanProgressMemoryStage("after_portable_entry_source_cid")
    var next: SystemLinkPlanPortableSourceBinding
    next.packageId = parser.ParserOwnedText(packageId)
    next.entryModulePath = parser.ParserOwnedText(entryModulePath)
    next.sourceCount = modulePaths.len
    next.importEdgeCount = rebuiltImportEdges.len
    next.sourceBundleCid = sourceBundleCid
    next.entrySourceCid = entrySourceCid
    next.importGraphCid = rebuiltImportGraphCid
    next.bindingSeal = SystemLinkPlanPortableSourceBindingSeal(next)
    SystemLinkPlanProgressMemoryStage("after_portable_binding_seal")
    outBinding = next
    err = ""
    return true

@borrows
fn SystemLinkPlanPortableSourceBindingFromTextsInto(
        packageId: str,
        entryModulePath: str,
        modulePaths: str[],
        sourceTexts: str[],
        importEdges: parser.ImportEdge[],
        outBinding: var SystemLinkPlanPortableSourceBinding,
        err: var str): bool =
    var rebuiltImportEdges: parser.ImportEdge[]
    if !SystemLinkPlanPortableImportEdgesFromTextsInto(modulePaths,
                                                        sourceTexts,
                                                        rebuiltImportEdges,
                                                        err):
        return false
    var suppliedImportGraphCid: layout.FixedBytes32
    if !cworld.CompilerWorldPortableImportGraphCidInto(
            packageId,
            importEdges,
            0,
            suppliedImportGraphCid,
            err):
        return false
    var rebuiltImportGraphCid: layout.FixedBytes32
    if !cworld.CompilerWorldPortableImportGraphCidInto(
            packageId,
            rebuiltImportEdges,
            0,
            rebuiltImportGraphCid,
            err):
        return false
    if importEdges.len != rebuiltImportEdges.len ||
       !layout.FixedBytes32Equal(suppliedImportGraphCid,
                                 rebuiltImportGraphCid):
        err = " system link plan: portable import graph differs from exact source texts"
        return false
    return SystemLinkPlanPortableSourceBindingFromRebuiltImportEdgesInto(
        packageId,
        entryModulePath,
        modulePaths,
        sourceTexts,
        rebuiltImportEdges,
        outBinding,
        err)

@borrows
fn SystemLinkPlanPortableSourceBindingValidateTextsInto(
        binding: SystemLinkPlanPortableSourceBinding,
        modulePaths: str[],
        sourceTexts: str[],
        importEdges: parser.ImportEdge[],
        err: var str): bool =
    if binding.sourceCount != modulePaths.len ||
       binding.importEdgeCount != importEdges.len ||
       layout.FixedBytes32Equal(binding.bindingSeal,
                                layout.FixedBytes32()):
        err = " system link plan: portable binding shape invalid"
        return false
    var expected: SystemLinkPlanPortableSourceBinding
    if !SystemLinkPlanPortableSourceBindingFromTextsInto(
            binding.packageId,
            binding.entryModulePath,
            modulePaths,
            sourceTexts,
            importEdges,
            expected,
            err):
        return false
    if expected.packageId != binding.packageId ||
       expected.entryModulePath != binding.entryModulePath ||
       expected.sourceCount != binding.sourceCount ||
       expected.importEdgeCount != binding.importEdgeCount ||
       !layout.FixedBytes32Equal(expected.sourceBundleCid,
                                 binding.sourceBundleCid) ||
       !layout.FixedBytes32Equal(expected.entrySourceCid,
                                 binding.entrySourceCid) ||
       !layout.FixedBytes32Equal(expected.importGraphCid,
                                 binding.importGraphCid) ||
       !layout.FixedBytes32Equal(expected.bindingSeal,
                                 binding.bindingSeal):
        err = " system link plan: portable binding exact text mismatch"
        return false
    err = ""
    return true

# CompilerCSG has already rebuilt these exact import rows from the same
# immutable source texts and compares every row with the sealed plan.  Reuse
# that proof to recompute the portable receipt without parsing all imports a
# second time in the same phase.
@borrows
fn SystemLinkPlanPortableSourceBindingValidateRebuiltTextsInto(
        binding: SystemLinkPlanPortableSourceBinding,
        modulePaths: var str[],
        sourceTexts: var str[],
        rebuiltImportEdges: var parser.ImportEdge[],
        err: var str): bool =
    if binding.sourceCount != modulePaths.len ||
       binding.importEdgeCount != rebuiltImportEdges.len ||
       layout.FixedBytes32Equal(binding.bindingSeal,
                                layout.FixedBytes32()):
        err = " system link plan: portable rebuilt binding shape invalid"
        return false
    var expected: SystemLinkPlanPortableSourceBinding
    if !SystemLinkPlanPortableSourceBindingFromRebuiltImportEdgesInto(
            binding.packageId,
            binding.entryModulePath,
            modulePaths,
            sourceTexts,
            rebuiltImportEdges,
            expected,
            err):
        return false
    if expected.packageId != binding.packageId ||
       expected.entryModulePath != binding.entryModulePath ||
       expected.sourceCount != binding.sourceCount ||
       expected.importEdgeCount != binding.importEdgeCount ||
       !layout.FixedBytes32Equal(expected.sourceBundleCid,
                                 binding.sourceBundleCid) ||
       !layout.FixedBytes32Equal(expected.entrySourceCid,
                                 binding.entrySourceCid) ||
       !layout.FixedBytes32Equal(expected.importGraphCid,
                                 binding.importGraphCid) ||
       !layout.FixedBytes32Equal(expected.bindingSeal,
                                 binding.bindingSeal):
        err = " system link plan: portable rebuilt binding exact text mismatch"
        return false
    err = ""
    return true

# Build the CompilerCSG planning shell from one immutable in-memory workspace
# snapshot.  Every source byte is supplied by the caller; this path never
# reads source files.  Paths and module identities are still cross-checked by
# the canonical compiler identity functions, and imports are parsed by the
# compiler parser from the same supplied bytes.
@borrows
fn SystemLinkPlanBuildImmutableSourceOverlayInto(
        workspaceRoot: str,
        packageRoot: str,
        packageId: str,
        targetTriple: str,
        entrySourcePath: str,
        sourcePaths: str[],
        modulePaths: str[],
        sourceTexts: str[],
        out: var SystemLinkPlanStub,
        err: var str): bool =
    out = SystemLinkPlanStub()
    let canonicalPackageId = parser.ParserManifestNormalizePackageId(
        packageId)
    var canonicalWorkspaceRoot: str
    var canonicalPackageRoot: str
    var canonicalEntryPath: str
    if canonicalPackageId == "" || canonicalPackageId != packageId ||
       targetTriple == "" || sourcePaths.len <= 0 ||
       sourcePaths.len != modulePaths.len ||
       sourcePaths.len != sourceTexts.len ||
       !parser.ParserSourceIdentityLexicalPathInto(
           workspaceRoot, canonicalWorkspaceRoot) ||
       canonicalWorkspaceRoot != workspaceRoot ||
       !parser.ParserSourceIdentityLexicalPathInto(
           packageRoot, canonicalPackageRoot) ||
       canonicalPackageRoot != packageRoot ||
       !parser.ParserSourceIdentityLexicalPathInto(
           entrySourcePath, canonicalEntryPath) ||
       canonicalEntryPath != entrySourcePath:
        err = " system link plan: immutable overlay identity invalid"
        return false
    var canonicalSourcePaths: str[]
    for sourceIndex in 0..<sourcePaths.len:
        var canonicalSourcePath: str
        if !parser.ParserSourceIdentityLexicalPathInto(
                sourcePaths[sourceIndex], canonicalSourcePath) ||
           canonicalSourcePath != sourcePaths[sourceIndex]:
            err = Fmt" system link plan: immutable overlay source path invalid index={sourceIndex}"
            return false
        for earlier in 0..<sourceIndex:
            if canonicalSourcePaths[earlier] == canonicalSourcePath:
                err = Fmt" system link plan: immutable overlay source path duplicated index={sourceIndex}"
                return false
        add(canonicalSourcePaths, canonicalSourcePath)
    var noExternalPackageRoots: parser.ParserExternalPackageRoot[]
    var expectedModulePaths: str[]
    if !cworld.CompilerWorldSourceBundleIdentityPathsWithExternalPackageRootsInto(
            canonicalWorkspaceRoot,
            canonicalPackageRoot,
            canonicalPackageId,
            noExternalPackageRoots,
            canonicalSourcePaths,
            expectedModulePaths) ||
       expectedModulePaths.len != modulePaths.len:
        err = " system link plan: immutable overlay module identity unavailable"
        return false
    var entrySourceIndex: int32 = -1
    for sourceIndex in 0..<modulePaths.len:
        if expectedModulePaths[sourceIndex] != modulePaths[sourceIndex]:
            err = Fmt" system link plan: immutable overlay module identity split index={sourceIndex}"
            return false
        if canonicalSourcePaths[sourceIndex] == canonicalEntryPath:
            if entrySourceIndex >= 0:
                err = " system link plan: immutable overlay entry duplicated"
                return false
            entrySourceIndex = sourceIndex
    if entrySourceIndex < 0:
        err = " system link plan: immutable overlay entry missing"
        return false
    var importEdges: parser.ImportEdge[]
    var unresolvedImportCount: int32
    if !SystemLinkPlanRebuildImportEdgesFromTextsInto(
            canonicalWorkspaceRoot,
            canonicalPackageRoot,
            canonicalPackageId,
            noExternalPackageRoots,
            canonicalSourcePaths,
            expectedModulePaths,
            sourceTexts,
            entrySourceIndex,
            importEdges,
            unresolvedImportCount,
            err) ||
       unresolvedImportCount != 0:
        if err == "":
            err = " system link plan: immutable overlay import is unresolved"
        return false
    var portableBinding: SystemLinkPlanPortableSourceBinding
    if !SystemLinkPlanPortableSourceBindingFromRebuiltImportEdgesInto(
            canonicalPackageId,
            expectedModulePaths[entrySourceIndex],
            expectedModulePaths,
            sourceTexts,
            importEdges,
            portableBinding,
            err):
        return false
    var plan: SystemLinkPlanStub
    plan.entryPath = canonicalEntryPath
    plan.targetTriple = targetTriple
    plan.emitKind = creq.EmitObj
    plan.symbolVisibility = "default"
    plan.packageRoot = canonicalPackageRoot
    plan.workspaceRoot = canonicalWorkspaceRoot
    plan.packageId = strings.CloneStr(canonicalPackageId)
    plan.moduleStem = strings.CloneStr(
        expectedModulePaths[entrySourceIndex])
    plan.moduleKind = SystemOrdinaryProgram
    plan.sourceBundleCid = Ok[layout.FixedBytes32](
        portableBinding.sourceBundleCid)
    plan.sourceBundleCidValue = portableBinding.sourceBundleCid
    plan.sourceBundleEntrySourceIndex = entrySourceIndex
    plan.sourceBundleBindingSeal = portableBinding.bindingSeal
    plan.sourceBundleEntrySourceCid = portableBinding.entrySourceCid
    plan.sourceBundleImportGraphCid = portableBinding.importGraphCid
    plan.sourceBundleIdentityPaths = expectedModulePaths
    plan.sourceClosurePaths = canonicalSourcePaths
    plan.ownerModulePaths = expectedModulePaths
    plan.importEdges = importEdges
    plan.importEdgeCount = plan.importEdges.len
    plan.unresolvedImportCount = 0
    plan.buildEntryPath = canonicalEntryPath
    plan.buildSourceUnitCount = plan.sourceClosurePaths.len
    plan.linkMode = "semantic_snapshot"
    plan.pipelineStage = "lsp_immutable_source_overlay"
    plan.parserSyntaxTag = "cheng_normalized_source"
    plan.jobCount = 1
    out = plan
    err = ""
    return true

@borrows
fn SystemLinkPlanComputeSourceBundleBindingSeal(
        packageId: str,
        workspaceRoot: str,
        packageRoot: str,
        externalPackageRoots: parser.ParserExternalPackageRoot[],
        entrySourceIndex: int32,
        sourceBundleCid: layout.FixedBytes32,
        entrySourceCid: layout.FixedBytes32,
        importGraphCid: layout.FixedBytes32,
        identityPaths: str[],
        sourceClosurePaths: str[],
        ownerModulePaths: str[],
        importEdges: parser.ImportEdge[],
        unresolvedImportCount: int32): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(512)
    SystemLinkPlanBindingAppendText(buf, "cheng.system_link.source_bundle_binding.physical")
    SystemLinkPlanBindingAppendText(buf, packageId)
    SystemLinkPlanBindingAppendText(buf, workspaceRoot)
    SystemLinkPlanBindingAppendText(buf, packageRoot)
    SystemLinkPlanBindingAppendU32Field(buf, externalPackageRoots.len)
    for rootIndex in 0..<externalPackageRoots.len:
        SystemLinkPlanBindingAppendText(buf, externalPackageRoots[rootIndex].packageId)
        SystemLinkPlanBindingAppendText(buf,
                                        externalPackageRoots[rootIndex].canonicalPackageId)
        SystemLinkPlanBindingAppendText(buf, externalPackageRoots[rootIndex].packageRoot)
        SystemLinkPlanBindingAppendText(buf, externalPackageRoots[rootIndex].channel)
    SystemLinkPlanBindingAppendU32Field(buf, entrySourceIndex)
    SystemLinkPlanBindingAppendFixed32Field(buf, sourceBundleCid)
    SystemLinkPlanBindingAppendFixed32Field(buf, entrySourceCid)
    SystemLinkPlanBindingAppendFixed32Field(buf, importGraphCid)
    SystemLinkPlanBindingAppendTexts(buf, identityPaths)
    SystemLinkPlanBindingAppendTexts(buf, sourceClosurePaths)
    SystemLinkPlanBindingAppendTexts(buf, ownerModulePaths)
    SystemLinkPlanBindingAppendU32Field(buf, importEdges.len)
    for edgeIndex in 0..<importEdges.len:
        let edge = importEdges[edgeIndex]
        SystemLinkPlanBindingAppendText(buf, edge.ownerModulePath)
        SystemLinkPlanBindingAppendText(buf, edge.targetModulePath)
        SystemLinkPlanBindingAppendText(buf, edge.targetSourcePath)
        SystemLinkPlanBindingAppendU32Field(buf, edge.targetSourcePathLen)
        SystemLinkPlanBindingAppendU32Field(buf, edge.targetSourcePathFirstCode)
        SystemLinkPlanBindingAppendU32Field(buf, edge.targetSourcePathLastCode)
        SystemLinkPlanBindingAppendU32Field(buf, edge.targetSourcePathDotCount)
        SystemLinkPlanBindingAppendU32Field(buf, edge.targetSourcePathHash)
        SystemLinkPlanBindingAppendU32Field(buf, edge.targetProfileIndex)
        SystemLinkPlanBindingAppendText(buf, edge.importAlias)
        SystemLinkPlanBindingAppendText(buf, edge.qualifier)
        SystemLinkPlanBindingAppendU32Field(
            buf,
            edge.allowsUnqualifiedCall ? 1 : 0)
        SystemLinkPlanBindingAppendU32Field(buf, edge.resolved ? 1 : 0)
    SystemLinkPlanBindingAppendU32Field(buf, unresolvedImportCount)
    let seal = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return seal

fn SystemLinkPlanSourceBundleBindingPhysicalReport(
        plan: var SystemLinkPlanStub): str =
    var out = ""
    SystemLinkPlanAppendLine(
        out,
        "source_bundle_binding_physical_domain",
        "cheng.system_link.source_bundle_binding.physical")
    SystemLinkPlanAppendLine(
        out,
        "source_bundle_binding_physical_workspace_root_fshex",
        SystemLinkPlanReportTextHex(plan.workspaceRoot))
    SystemLinkPlanAppendLine(
        out,
        "source_bundle_binding_physical_package_root_fshex",
        SystemLinkPlanReportTextHex(plan.packageRoot))
    SystemLinkPlanAppendLine(
        out,
        "source_bundle_binding_physical_external_root_count",
        IntToStr(plan.externalPackageRoots.len))
    for rootIndex in 0..<plan.externalPackageRoots.len:
        let rootPrefix =
            Fmt"source_bundle_binding_physical_external_root.{rootIndex}"
        SystemLinkPlanAppendLine(
            out,
            Fmt"{rootPrefix}.package_id",
            plan.externalPackageRoots[rootIndex].packageId)
        SystemLinkPlanAppendLine(
            out,
            Fmt"{rootPrefix}.canonical_package_id",
            plan.externalPackageRoots[rootIndex].canonicalPackageId)
        SystemLinkPlanAppendLine(
            out,
            Fmt"{rootPrefix}.package_root_fshex",
            SystemLinkPlanReportTextHex(
                plan.externalPackageRoots[rootIndex].packageRoot))
        SystemLinkPlanAppendLine(
            out,
            Fmt"{rootPrefix}.channel",
            plan.externalPackageRoots[rootIndex].channel)
    SystemLinkPlanAppendLine(
        out,
        "source_bundle_binding_physical_identity_path_count",
        IntToStr(plan.sourceBundleIdentityPaths.len))
    for identityIndex in 0..<plan.sourceBundleIdentityPaths.len:
        SystemLinkPlanAppendLine(
            out,
            Fmt"source_bundle_binding_physical_identity_path.{identityIndex}",
            plan.sourceBundleIdentityPaths[identityIndex])
    SystemLinkPlanAppendLine(
        out,
        "source_bundle_binding_physical_source_closure_path_count",
        IntToStr(plan.sourceClosurePaths.len))
    for sourceIndex in 0..<plan.sourceClosurePaths.len:
        SystemLinkPlanAppendLine(
            out,
            Fmt"source_bundle_binding_physical_source_closure_path.{sourceIndex}_fshex",
            SystemLinkPlanReportTextHex(plan.sourceClosurePaths[sourceIndex]))
    SystemLinkPlanAppendLine(
        out,
        "source_bundle_binding_physical_owner_module_path_count",
        IntToStr(plan.ownerModulePaths.len))
    for ownerIndex in 0..<plan.ownerModulePaths.len:
        SystemLinkPlanAppendLine(
            out,
            Fmt"source_bundle_binding_physical_owner_module_path.{ownerIndex}",
            plan.ownerModulePaths[ownerIndex])
    SystemLinkPlanAppendLine(
        out,
        "source_bundle_binding_physical_import_edge_count",
        IntToStr(plan.importEdges.len))
    for edgeIndex in 0..<plan.importEdges.len:
        let edgePrefix =
            Fmt"source_bundle_binding_physical_import_edge.{edgeIndex}"
        SystemLinkPlanAppendLine(
            out,
            Fmt"{edgePrefix}.owner_module_path",
            plan.importEdges[edgeIndex].ownerModulePath)
        SystemLinkPlanAppendLine(
            out,
            Fmt"{edgePrefix}.target_module_path",
            plan.importEdges[edgeIndex].targetModulePath)
        SystemLinkPlanAppendLine(
            out,
            Fmt"{edgePrefix}.target_source_path_fshex",
            SystemLinkPlanReportTextHex(
                plan.importEdges[edgeIndex].targetSourcePath))
        SystemLinkPlanAppendLine(
            out,
            Fmt"{edgePrefix}.target_source_path_len",
            IntToStr(plan.importEdges[edgeIndex].targetSourcePathLen))
        SystemLinkPlanAppendLine(
            out,
            Fmt"{edgePrefix}.target_source_path_first_code",
            IntToStr(plan.importEdges[edgeIndex].targetSourcePathFirstCode))
        SystemLinkPlanAppendLine(
            out,
            Fmt"{edgePrefix}.target_source_path_last_code",
            IntToStr(plan.importEdges[edgeIndex].targetSourcePathLastCode))
        SystemLinkPlanAppendLine(
            out,
            Fmt"{edgePrefix}.target_source_path_dot_count",
            IntToStr(plan.importEdges[edgeIndex].targetSourcePathDotCount))
        SystemLinkPlanAppendLine(
            out,
            Fmt"{edgePrefix}.target_source_path_hash",
            IntToStr(plan.importEdges[edgeIndex].targetSourcePathHash))
        SystemLinkPlanAppendLine(
            out,
            Fmt"{edgePrefix}.target_profile_index",
            IntToStr(plan.importEdges[edgeIndex].targetProfileIndex))
        SystemLinkPlanAppendLine(
            out,
            Fmt"{edgePrefix}.import_alias",
            plan.importEdges[edgeIndex].importAlias)
        SystemLinkPlanAppendLine(
            out,
            Fmt"{edgePrefix}.qualifier",
            plan.importEdges[edgeIndex].qualifier)
        var allowsUnqualifiedCallText = "0"
        if plan.importEdges[edgeIndex].allowsUnqualifiedCall:
            allowsUnqualifiedCallText = "1"
        SystemLinkPlanAppendLine(
            out,
            Fmt"{edgePrefix}.allows_unqualified_call",
            allowsUnqualifiedCallText)
        var resolvedText = "0"
        if plan.importEdges[edgeIndex].resolved:
            resolvedText = "1"
        SystemLinkPlanAppendLine(
            out,
            Fmt"{edgePrefix}.resolved",
            resolvedText)
    return out

fn SystemLinkPlanSourceBundleBindingStructuralColumnsValidInto(
        plan: var SystemLinkPlanStub,
        outExpectedSeal: var layout.FixedBytes32,
        err: var str): bool =
    if !plan.sourceBundleCid.ok:
        err = " system link plan: source bundle cid result is error"
        return false
    if !layout.FixedBytes32Equal(Value(plan.sourceBundleCid),
                                 plan.sourceBundleCidValue):
        err = " system link plan: source bundle cid result/scalar mismatch"
        return false
    var canonicalWorkspaceRoot: str
    var canonicalPackageRoot: str
    let canonicalPackageId = parser.ParserManifestNormalizePackageId(
        plan.packageId)
    if canonicalPackageId == "" || canonicalPackageId != plan.packageId ||
       !parser.ParserSourceIdentityLexicalPathInto(plan.workspaceRoot,
                                                   canonicalWorkspaceRoot) ||
       !parser.ParserSourceIdentityLexicalPathInto(plan.packageRoot,
                                                   canonicalPackageRoot) ||
       canonicalWorkspaceRoot != plan.workspaceRoot ||
       canonicalPackageRoot != plan.packageRoot ||
       !parser.ParserSourceIdentityPathAbsolute(canonicalWorkspaceRoot) ||
       !parser.ParserSourceIdentityPathAbsolute(canonicalPackageRoot):
        err = " system link plan: source bundle root identity incomplete"
        return false
    var canonicalExternalPackageRoots: parser.ParserExternalPackageRoot[]
    if !SystemLinkPlanCanonicalExternalPackageRootsInto(
            plan.externalPackageRoots,
            canonicalExternalPackageRoots,
            err) ||
       canonicalExternalPackageRoots.len != plan.externalPackageRoots.len:
        if err == "":
            err = " system link plan: external package root certificates are not canonical"
        return false
    for rootIndex in 0..<canonicalExternalPackageRoots.len:
        if !SystemLinkPlanExternalRootEqual(
                canonicalExternalPackageRoots[rootIndex],
                plan.externalPackageRoots[rootIndex]):
            err = Fmt" system link plan: external package root certificate order mismatch index={rootIndex}"
            return false
    if plan.sourceClosurePaths.len <= 0 ||
       plan.sourceBundleIdentityPaths.len != plan.sourceClosurePaths.len ||
       plan.ownerModulePaths.len != plan.sourceClosurePaths.len:
        err = Fmt" system link plan: source bundle identity column mismatch closure={plan.sourceClosurePaths.len} identity={plan.sourceBundleIdentityPaths.len} owner={plan.ownerModulePaths.len}"
        return false
    if plan.importEdgeCount != plan.importEdges.len ||
       plan.buildSourceUnitCount != plan.sourceClosurePaths.len:
        err = Fmt" system link plan: source bundle graph count mismatch imports={plan.importEdgeCount}/{plan.importEdges.len} sources={plan.buildSourceUnitCount}/{plan.sourceClosurePaths.len}"
        return false
    let entrySourceIndex = plan.sourceBundleEntrySourceIndex
    if entrySourceIndex < 0 ||
       entrySourceIndex >= plan.sourceClosurePaths.len ||
       plan.entryPath != plan.sourceClosurePaths[entrySourceIndex] ||
       plan.buildEntryPath != plan.sourceClosurePaths[entrySourceIndex] ||
       plan.moduleStem != plan.ownerModulePaths[entrySourceIndex]:
        err = Fmt" system link plan: sealed entry identity mismatch index={entrySourceIndex}"
        return false
    for sourceIndex in 0..<plan.sourceClosurePaths.len:
        let sourceFilePathRaw = chengpath.PathAbsolute(
            plan.packageRoot,
            plan.sourceClosurePaths[sourceIndex])
        var sourceFilePath: str
        if !parser.ParserSourceIdentityLexicalPathInto(sourceFilePathRaw,
                                                        sourceFilePath) ||
           sourceFilePath != plan.sourceClosurePaths[sourceIndex]:
            err = Fmt" system link plan: source bundle closure path invalid index={sourceIndex}"
            return false
        var rowIdentity: str
        if !SystemLinkPlanSourceRowIdentityInto(
                plan.workspaceRoot,
                plan.packageRoot,
                plan.packageId,
                plan.externalPackageRoots,
                sourceFilePath,
                rowIdentity):
            err = Fmt" system link plan: exact owner module derivation failed index={sourceIndex}"
            return false
        if plan.sourceBundleIdentityPaths[sourceIndex] == "" ||
           plan.ownerModulePaths[sourceIndex] == "":
            err = Fmt" system link plan: source bundle identity row incomplete index={sourceIndex}"
            return false
        if plan.sourceBundleIdentityPaths[sourceIndex] !=
           plan.ownerModulePaths[sourceIndex]:
            err = Fmt" system link plan: module identity/owner row mismatch index={sourceIndex}"
            return false
        if plan.ownerModulePaths[sourceIndex] !=
           rowIdentity:
            err = Fmt" system link plan: exact owner/closure row mismatch index={sourceIndex}"
            return false
    var canonicalImportEdges: parser.ImportEdge[]
    if !SystemLinkPlanCanonicalImportEdgesInto(
            plan.sourceClosurePaths,
            plan.ownerModulePaths,
            plan.importEdges,
            plan.unresolvedImportCount,
            canonicalImportEdges,
            err) ||
       canonicalImportEdges.len != plan.importEdges.len:
        return false
    for edgeIndex in 0..<canonicalImportEdges.len:
        if !SystemLinkPlanImportEdgeEqual(canonicalImportEdges[edgeIndex],
                                          plan.importEdges[edgeIndex]):
            err = Fmt" system link plan: import edge is not exact canonical graph row index={edgeIndex}"
            return false
    if plan.unresolvedImportCount != 0:
        err = " system link plan: portable binding contains unresolved import"
        return false
    outExpectedSeal = SystemLinkPlanComputeSourceBundleBindingSeal(
        plan.packageId,
        plan.workspaceRoot,
        plan.packageRoot,
        plan.externalPackageRoots,
        plan.sourceBundleEntrySourceIndex,
        plan.sourceBundleCidValue,
        plan.sourceBundleEntrySourceCid,
        plan.sourceBundleImportGraphCid,
        plan.sourceBundleIdentityPaths,
        plan.sourceClosurePaths,
        plan.ownerModulePaths,
        canonicalImportEdges,
        plan.unresolvedImportCount)
    err = ""
    return true

fn SystemLinkPlanSourceBundleBindingColumnsValidInto(
        plan: var SystemLinkPlanStub,
        outExpectedSeal: var layout.FixedBytes32,
        err: var str): bool =
    if SystemLinkPlanProductionPathReadRetired():
        err = "HARD_RED:system_link_plan_production_source_rows_must_come_from_held_bundle"
        return false
    if !SystemLinkPlanSourceBundleBindingStructuralColumnsValidInto(
            plan,
            outExpectedSeal,
            err):
        return false
    var sourceTexts: str[]
    for sourceIndex in 0..<plan.sourceClosurePaths.len:
        var sourceText: str
        if !parser.ParserSourceTextWithExternalPackageRootsInto(
                plan.sourceClosurePaths[sourceIndex],
                plan.externalPackageRoots,
                sourceText,
                err):
            err = Fmt" system link plan: sealed source snapshot missing index={sourceIndex}: {err}"
            return false
        add(sourceTexts, strings.CloneStr(sourceText))
    let entrySourceIndex = plan.sourceBundleEntrySourceIndex
    var portableBinding: SystemLinkPlanPortableSourceBinding
    portableBinding.packageId = plan.packageId
    portableBinding.entryModulePath = plan.ownerModulePaths[entrySourceIndex]
    portableBinding.sourceCount = plan.ownerModulePaths.len
    portableBinding.importEdgeCount = plan.importEdges.len
    portableBinding.sourceBundleCid = plan.sourceBundleCidValue
    portableBinding.entrySourceCid = plan.sourceBundleEntrySourceCid
    portableBinding.importGraphCid = plan.sourceBundleImportGraphCid
    portableBinding.bindingSeal =
        SystemLinkPlanPortableSourceBindingSeal(portableBinding)
    if !SystemLinkPlanPortableSourceBindingValidateTextsInto(
            portableBinding,
            plan.ownerModulePaths,
            sourceTexts,
            plan.importEdges,
            err):
        return false
    err = ""
    return true

fn SystemLinkPlanSealSourceBundleBinding(plan: var SystemLinkPlanStub,
                                          err: var str): bool =
    var expectedSeal: layout.FixedBytes32
    if !SystemLinkPlanSourceBundleBindingColumnsValidInto(plan,
                                                          expectedSeal,
                                                          err):
        return false
    plan.sourceBundleBindingSeal = expectedSeal
    err = ""
    return true

fn SystemLinkPlanSourceBundleBindingValidInto(plan: var SystemLinkPlanStub,
                                               err: var str): bool =
    var expectedSeal: layout.FixedBytes32
    if !SystemLinkPlanSourceBundleBindingColumnsValidInto(plan,
                                                          expectedSeal,
                                                          err):
        return false
    if !layout.FixedBytes32Equal(expectedSeal, plan.sourceBundleBindingSeal):
        err = " system link plan: source bundle binding seal mismatch"
        return false
    err = ""
    return true

# Receipt capture validates the canonical columns and their cryptographic seal
# without reopening source files.  The binding producer has already validated
# those bytes, while CompilerCSG independently rereads them and matches the
# portable source CIDs before consuming the plan.
fn SystemLinkPlanSourceBundleBindingStructuralValidInto(
        plan: var SystemLinkPlanStub,
        err: var str): bool =
    var expectedSeal: layout.FixedBytes32
    if !SystemLinkPlanSourceBundleBindingStructuralColumnsValidInto(
            plan,
            expectedSeal,
            err):
        return false
    if !layout.FixedBytes32Equal(expectedSeal, plan.sourceBundleBindingSeal):
        err = " system link plan: source bundle binding seal mismatch"
        return false
    err = ""
    return true

fn SystemLinkPlanSourceBundleBindingValid(plan: var SystemLinkPlanStub): bool =
    var err: str
    return SystemLinkPlanSourceBundleBindingValidInto(plan, err)

@borrows
fn SystemLinkPlanBuildSourceBundleBindingFromFilesInto(
        packageId: str,
        workspaceRoot: str,
        packageRoot: str,
        externalPackageRoots: parser.ParserExternalPackageRoot[],
        sourcePaths: str[],
        entrySourcePathRaw: str,
        importEdges: parser.ImportEdge[],
        unresolvedImportCount: int32,
        outExternalPackageRoots: var parser.ParserExternalPackageRoot[],
        outSourceClosurePaths: var str[],
        outIdentityPaths: var str[],
        outOwnerModulePaths: var str[],
        outImportEdges: var parser.ImportEdge[],
        outEntrySourceIndex: var int32,
        outCid: var layout.FixedBytes32,
        outEntrySourceCid: var layout.FixedBytes32,
        outImportGraphCid: var layout.FixedBytes32,
        outBindingSeal: var layout.FixedBytes32,
        err: var str): bool =
    if SystemLinkPlanProductionPathReadRetired():
        err = "HARD_RED:system_link_plan_production_source_rows_must_come_from_held_bundle"
        return false
    if sourcePaths.len <= 0:
        err = " system link plan: source bundle closure empty"
        return false
    var canonicalWorkspaceRoot: str
    var canonicalPackageRoot: str
    let canonicalPackageId = parser.ParserManifestNormalizePackageId(packageId)
    if canonicalPackageId == "" || canonicalPackageId != packageId ||
       !parser.ParserSourceIdentityLexicalPathInto(workspaceRoot,
                                                   canonicalWorkspaceRoot) ||
       !parser.ParserSourceIdentityLexicalPathInto(packageRoot,
                                                   canonicalPackageRoot) ||
       canonicalWorkspaceRoot != workspaceRoot ||
       canonicalPackageRoot != packageRoot:
        err = " system link plan: source bundle package roots are not canonical"
        return false
    var canonicalExternalPackageRoots: parser.ParserExternalPackageRoot[]
    if !SystemLinkPlanCanonicalExternalPackageRootsInto(
            externalPackageRoots,
            canonicalExternalPackageRoots,
            err):
        return false
    var sourceFilePaths: str[]
    var sourceTexts: str[]
    for sourceIndex in 0..<sourcePaths.len:
        let sourceFilePathRaw = chengpath.PathAbsolute(
            packageRoot,
            sourcePaths[sourceIndex])
        var sourceFilePath: str
        if !parser.ParserSourceIdentityLexicalPathInto(sourceFilePathRaw,
                                                        sourceFilePath):
            err = Fmt" system link plan: source bundle file path unavailable index={sourceIndex}"
            return false
        var sourceText: str
        if !parser.ParserSourceTextWithExternalPackageRootsInto(
                sourceFilePath,
                canonicalExternalPackageRoots,
                sourceText,
                err):
            err = Fmt" system link plan: source bundle snapshot missing index={sourceIndex} source={sourceFilePath}: {err}"
            return false
        add(sourceFilePaths, strings.CloneStr(sourceFilePath))
        add(sourceTexts, strings.CloneStr(sourceText))
    var identityPaths: str[]
    var ownerModulePaths: str[]
    for sourceIndex in 0..<sourceFilePaths.len:
        var rowIdentity: str
        if !SystemLinkPlanSourceRowIdentityInto(
                workspaceRoot,
                packageRoot,
                packageId,
                canonicalExternalPackageRoots,
                sourceFilePaths[sourceIndex],
                rowIdentity):
            err = Fmt" system link plan: source bundle module identity unavailable index={sourceIndex}"
            return false
        add(identityPaths, strings.CloneStr(rowIdentity))
        add(ownerModulePaths, strings.CloneStr(rowIdentity))
    var canonicalEntrySourcePath: str
    if !parser.ParserSourceIdentityLexicalPathInto(
            chengpath.PathAbsolute(packageRoot, entrySourcePathRaw),
            canonicalEntrySourcePath):
        err = " system link plan: source bundle entry path invalid"
        return false
    let entrySourceIndex = SystemLinkPlanTextIndex(sourceFilePaths,
                                                   canonicalEntrySourcePath)
    if entrySourceIndex < 0:
        err = Fmt" system link plan: source bundle entry outside closure source={canonicalEntrySourcePath}"
        return false
    var canonicalImportEdges: parser.ImportEdge[]
    if !SystemLinkPlanCanonicalImportEdgesInto(
            sourceFilePaths,
            ownerModulePaths,
            importEdges,
            unresolvedImportCount,
            canonicalImportEdges,
            err):
        return false
    var rebuiltImportEdges: parser.ImportEdge[]
    var rebuiltUnresolvedImportCount: int32
    if !SystemLinkPlanRebuildImportEdgesFromTextsInto(
            workspaceRoot,
            packageRoot,
            packageId,
            canonicalExternalPackageRoots,
            sourceFilePaths,
            ownerModulePaths,
            sourceTexts,
            entrySourceIndex,
            rebuiltImportEdges,
            rebuiltUnresolvedImportCount,
            err):
        return false
    if rebuiltUnresolvedImportCount != unresolvedImportCount ||
       rebuiltImportEdges.len != canonicalImportEdges.len:
        err = Fmt" system link plan: import graph differs from exact source snapshot edges={canonicalImportEdges.len}/{rebuiltImportEdges.len} unresolved={unresolvedImportCount}/{rebuiltUnresolvedImportCount}"
        return false
    for edgeIndex in 0..<rebuiltImportEdges.len:
        if !SystemLinkPlanImportEdgeEqual(rebuiltImportEdges[edgeIndex],
                                          canonicalImportEdges[edgeIndex]):
            err = Fmt" system link plan: import graph source provenance mismatch index={edgeIndex}"
            return false
    var portableBinding: SystemLinkPlanPortableSourceBinding
    if !SystemLinkPlanPortableSourceBindingFromRebuiltImportEdgesInto(
            packageId,
            ownerModulePaths[entrySourceIndex],
            identityPaths,
            sourceTexts,
            rebuiltImportEdges,
            portableBinding,
            err):
        return false
    let sourceBundleCid = portableBinding.sourceBundleCid
    let entrySourceCid = portableBinding.entrySourceCid
    let importGraphCid = portableBinding.importGraphCid
    outBindingSeal = SystemLinkPlanComputeSourceBundleBindingSeal(
        packageId,
        workspaceRoot,
        packageRoot,
        canonicalExternalPackageRoots,
        entrySourceIndex,
        sourceBundleCid,
        entrySourceCid,
        importGraphCid,
        identityPaths,
        sourceFilePaths,
        ownerModulePaths,
        rebuiltImportEdges,
        rebuiltUnresolvedImportCount)
    outExternalPackageRoots = canonicalExternalPackageRoots
    outSourceClosurePaths = sourceFilePaths
    outIdentityPaths = identityPaths
    outOwnerModulePaths = ownerModulePaths
    outImportEdges = rebuiltImportEdges
    outEntrySourceIndex = entrySourceIndex
    outCid = sourceBundleCid
    outEntrySourceCid = entrySourceCid
    outImportGraphCid = importGraphCid
    err = ""
    return true

@borrows
fn SystemLinkPlanBindSourceClosureIdentityFromFiles(
        plan: var SystemLinkPlanStub,
        sourcePaths: str[],
        err: var str): bool =
    var identityPaths: str[]
    var ownerModulePaths: str[]
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    var sourceClosurePaths: str[]
    var importEdges: parser.ImportEdge[]
    var entrySourceIndex: int32
    var sourceBundleCid: layout.FixedBytes32
    var entrySourceCid: layout.FixedBytes32
    var importGraphCid: layout.FixedBytes32
    var sourceBundleBindingSeal: layout.FixedBytes32
    if !SystemLinkPlanBuildSourceBundleBindingFromFilesInto(
            plan.packageId,
            plan.workspaceRoot,
            plan.packageRoot,
            plan.externalPackageRoots,
            sourcePaths,
            plan.entryPath,
            plan.importEdges,
            plan.unresolvedImportCount,
            externalPackageRoots,
            sourceClosurePaths,
            identityPaths,
            ownerModulePaths,
            importEdges,
            entrySourceIndex,
            sourceBundleCid,
            entrySourceCid,
            importGraphCid,
            sourceBundleBindingSeal,
            err):
        return false
    plan.sourceBundleCid = Ok[layout.FixedBytes32](sourceBundleCid)
    plan.sourceBundleCidValue = sourceBundleCid
    plan.sourceBundleEntrySourceIndex = entrySourceIndex
    plan.sourceBundleEntrySourceCid = entrySourceCid
    plan.sourceBundleImportGraphCid = importGraphCid
    plan.sourceBundleBindingSeal = sourceBundleBindingSeal
    plan.externalPackageRoots = externalPackageRoots
    plan.sourceBundleIdentityPaths = identityPaths
    plan.sourceClosurePaths = sourceClosurePaths
    plan.ownerModulePaths = ownerModulePaths
    plan.importEdges = importEdges
    plan.importEdgeCount = plan.importEdges.len
    plan.entryPath = strings.CloneStr(
        plan.sourceClosurePaths[entrySourceIndex])
    plan.buildEntryPath = strings.CloneStr(plan.entryPath)
    plan.moduleStem = strings.CloneStr(
        plan.ownerModulePaths[entrySourceIndex])
    plan.buildSourceUnitCount = sourcePaths.len
    err = ""
    return true

@borrows
fn SystemLinkPlanOwnedPathAt(paths: var str[], index: int32): str =
    return strings.CloneStr(paths[index])

@borrows
fn SystemLinkPlanCloneImportEdgeAt(
        edges: parser.ImportEdge[],
        index: int32): parser.ImportEdge =
    var edge: parser.ImportEdge
    edge.ownerProducerSourceIndex = edges[index].ownerProducerSourceIndex
    edge.importDeclarationSourceLocalRow =
        edges[index].importDeclarationSourceLocalRow
    edge.importItemSourceLocalRow = edges[index].importItemSourceLocalRow
    edge.importDeclarationRow = edges[index].importDeclarationRow
    edge.importItemRow = edges[index].importItemRow
    edge.ownerModulePath = strings.CloneStr(edges[index].ownerModulePath)
    edge.targetModulePath = strings.CloneStr(edges[index].targetModulePath)
    edge.targetSourcePath = strings.CloneStr(edges[index].targetSourcePath)
    edge.targetSourcePathLen = edges[index].targetSourcePathLen
    edge.targetSourcePathFirstCode = edges[index].targetSourcePathFirstCode
    edge.targetSourcePathLastCode = edges[index].targetSourcePathLastCode
    edge.targetSourcePathDotCount = edges[index].targetSourcePathDotCount
    edge.targetSourcePathHash = edges[index].targetSourcePathHash
    edge.targetProfileIndex = edges[index].targetProfileIndex
    edge.importAlias = strings.CloneStr(edges[index].importAlias)
    edge.qualifier = strings.CloneStr(edges[index].qualifier)
    edge.allowsUnqualifiedCall = edges[index].allowsUnqualifiedCall
    edge.resolved = edges[index].resolved
    return edge

fn SystemLinkPlanBindSourceClosureGraphFromFiles(
        plan: var SystemLinkPlanStub,
        externalPackageRoots: parser.ParserExternalPackageRoot[],
        sourcePaths: str[],
        importEdges: parser.ImportEdge[],
        importEdgeCount: int32,
        unresolvedImportCount: int32,
        err: var str): bool =
    if importEdgeCount != importEdges.len:
        err = Fmt" system link plan: import edge count mismatch declared={importEdgeCount} actual={importEdges.len}"
        return false
    if unresolvedImportCount < 0:
        err = Fmt" system link plan: unresolved import count invalid count={unresolvedImportCount}"
        return false
    var identityPaths: str[]
    var ownerModulePaths: str[]
    var canonicalExternalPackageRoots: parser.ParserExternalPackageRoot[]
    var sourceClosurePaths: str[]
    var canonicalImportEdges: parser.ImportEdge[]
    var entrySourceIndex: int32
    var sourceBundleCid: layout.FixedBytes32
    var entrySourceCid: layout.FixedBytes32
    var importGraphCid: layout.FixedBytes32
    var sourceBundleBindingSeal: layout.FixedBytes32
    if !SystemLinkPlanBuildSourceBundleBindingFromFilesInto(
            plan.packageId,
            plan.workspaceRoot,
            plan.packageRoot,
            externalPackageRoots,
            sourcePaths,
            plan.entryPath,
            importEdges,
            unresolvedImportCount,
            canonicalExternalPackageRoots,
            sourceClosurePaths,
            identityPaths,
            ownerModulePaths,
            canonicalImportEdges,
            entrySourceIndex,
            sourceBundleCid,
            entrySourceCid,
            importGraphCid,
            sourceBundleBindingSeal,
            err):
        return false
    plan.externalPackageRoots = canonicalExternalPackageRoots
    plan.importEdges = canonicalImportEdges
    plan.importEdgeCount = plan.importEdges.len
    plan.unresolvedImportCount = unresolvedImportCount
    plan.sourceBundleCid = Ok[layout.FixedBytes32](sourceBundleCid)
    plan.sourceBundleCidValue = sourceBundleCid
    plan.sourceBundleEntrySourceIndex = entrySourceIndex
    plan.sourceBundleEntrySourceCid = entrySourceCid
    plan.sourceBundleImportGraphCid = importGraphCid
    plan.sourceBundleBindingSeal = sourceBundleBindingSeal
    if entrySourceIndex < 0 ||
       entrySourceIndex >= sourceClosurePaths.len ||
       entrySourceIndex >= ownerModulePaths.len:
        err = " system link plan: source bundle entry index"
        return false
    let ownedEntryPath = SystemLinkPlanOwnedPathAt(
        sourceClosurePaths, entrySourceIndex)
    let ownedBuildEntryPath = SystemLinkPlanOwnedPathAt(
        sourceClosurePaths, entrySourceIndex)
    let ownedModuleStem = SystemLinkPlanOwnedPathAt(
        ownerModulePaths, entrySourceIndex)
    plan.sourceBundleIdentityPaths = identityPaths
    plan.sourceClosurePaths = sourceClosurePaths
    plan.ownerModulePaths = ownerModulePaths
    plan.buildSourceUnitCount = sourcePaths.len
    plan.entryPath = ownedEntryPath
    plan.buildEntryPath = ownedBuildEntryPath
    plan.moduleStem = ownedModuleStem
    err = ""
    return true

@borrows
@borrow_result
fn SystemLinkPlanMissingReasonsField(plan: SystemLinkPlanStub): str[] =
    return plan.missingReasons

@borrows
@borrow_result
fn SystemLinkPlanParserSyntaxTag(plan: SystemLinkPlanStub): str =
    return plan.parserSyntaxTag

@borrows
fn SystemLinkPlanParserSourceKind(plan: SystemLinkPlanStub): int32 =
    return plan.parserSourceKind

@borrows
@borrow_result
fn SystemLinkPlanBuildEntryPath(plan: SystemLinkPlanStub): str =
    return plan.buildEntryPath

@borrows
fn SystemLinkPlanBuildSourceUnitCount(plan: SystemLinkPlanStub): int32 =
    return plan.buildSourceUnitCount

@borrows
@borrow_result
fn SystemLinkPlanLinkMode(plan: SystemLinkPlanStub): str =
    return plan.linkMode

@borrows
@borrow_result
fn SystemLinkPlanPipelineStage(plan: SystemLinkPlanStub): str =
    return plan.pipelineStage

@borrows
fn SystemLinkPlanJobCount(plan: SystemLinkPlanStub): int32 =
    if plan.jobCount <= 0:
        return 1
    return plan.jobCount

@borrows
fn SystemLinkPlanMissingReasons(parsed: parser.ParsedSourceStub,
                                  emitKind: creq.CompilerEmit,
                                  targetTriple: str,
                                  runtimeTargetCount: int32,
                                  providerModuleCount: int32,
                                  entrySymbol: str): str[] =
    var out: str[]
    if parsed.orderedClosureSourcePaths.len <= 0:
        add(out, "source_closure_missing")
    elif parsed.unresolvedImportCount > 0:
        add(out, "source_closure_unresolved_imports")
    elif !parsed.hasCompilerTopLevel:
        add(out, "compiler_top_level_missing")
    elif emitKind == creq.EmitExe && Len(entrySymbol) <= 0:
        add(out, "program_entry_symbol_missing")
    return out

fn SystemLinkPlanCodexAppServerProviderModules(): str[] =
    var out: str[]
    add(out, "codex/runtime/darwin_os_provider")
    add(out, "codex/runtime/encoding_provider")
    add(out, "codex/runtime/process_provider")
    add(out, "codex/runtime/sqlite_provider")
    add(out, "codex/runtime/http_provider")
    add(out, "codex/runtime/socket_provider")
    add(out, "codex/runtime/model_provider")
    return out

@borrows
fn SystemLinkPlanImportedProviderModule(modulePathRaw: str): str =
    var modulePath = strings.CloneStr(modulePathRaw)
    if strutil.StartsWith(modulePath, "cheng/"):
        modulePath = strings.DropPrefix(modulePath, "cheng/")
    if strutil.StartsWith(modulePath, "codex/runtime/"):
        return modulePath
    return ""

@borrows
fn SystemLinkPlanStringsClone(items: str[]): str[] =
    var out: str[]
    for i in 0..<items.len:
        add(out, strings.CloneStr(items[i]))
    return out

@borrows
fn SystemLinkPlanAbsoluteProviderObjectPaths(rootDir: str,
                                              paths: str[]): str[] =
    var out: str[]
    for i in 0..<paths.len:
        let path = paths[i]
        if Len(path) > 0:
            add(out, strings.CloneStr(path))
    return out

@borrows
fn SystemLinkPlanCollectExactSourceClosure(
        parsed: var parser.ParsedSourceStub,
        externalPackageRoots: parser.ParserExternalPackageRoot[],
        entrySourcePathRaw: str,
        err: var str): bool =
    if SystemLinkPlanProductionPathReadRetired():
        err = "HARD_RED:system_link_plan_production_closure_must_come_from_held_bundle"
        return false
    var canonicalExternalPackageRoots: parser.ParserExternalPackageRoot[]
    if !SystemLinkPlanCanonicalExternalPackageRootsInto(
            externalPackageRoots,
            canonicalExternalPackageRoots,
            err):
        return false
    let entrySourcePathAbsolute = chengpath.PathAbsolute(
        parsed.packageRoot,
        entrySourcePathRaw)
    var entrySourcePath: str
    if !parser.ParserSourceIdentityLexicalPathInto(entrySourcePathAbsolute,
                                                    entrySourcePath):
        err = "system link plan: entry source identity path invalid"
        return false
    var seen: str[]
    var orderedSourcePaths: str[]
    var importEdges: parser.ImportEdge[]
    var unresolvedImportCount: int32
    if !parser.ParserCollectClosureWithExternalPackageRoots(
            parsed.workspaceRoot,
            parsed.packageRoot,
            canonicalExternalPackageRoots,
            entrySourcePath,
            seen,
            orderedSourcePaths,
            importEdges,
            unresolvedImportCount,
            err):
        return false
    var canonicalOrderedSourcePaths: str[]
    for sourceIndex in 0..<orderedSourcePaths.len:
        var canonicalSourcePath: str
        if !parser.ParserSourceIdentityLexicalPathInto(
                orderedSourcePaths[sourceIndex],
                canonicalSourcePath):
            err = Fmt"system link plan: closure source path invalid index={sourceIndex}"
            return false
        add(canonicalOrderedSourcePaths, strings.CloneStr(canonicalSourcePath))
    var ownerModulePaths: str[]
    for sourceIndex in 0..<canonicalOrderedSourcePaths.len:
        var rowIdentity: str
        if !SystemLinkPlanSourceRowIdentityInto(
                parsed.workspaceRoot,
                parsed.packageRoot,
                parsed.packageId,
                canonicalExternalPackageRoots,
                canonicalOrderedSourcePaths[sourceIndex],
                rowIdentity):
            err = Fmt"system link plan: closure exact module identity unavailable index={sourceIndex} row={canonicalOrderedSourcePaths[sourceIndex]} packageId={parsed.packageId} workspaceRoot={parsed.workspaceRoot} packageRoot={parsed.packageRoot} externalRoots={canonicalExternalPackageRoots.len}"
            return false
        add(ownerModulePaths, strings.CloneStr(rowIdentity))
    var canonicalImportEdges: parser.ImportEdge[]
    if !SystemLinkPlanCanonicalImportEdgesInto(
            canonicalOrderedSourcePaths,
            ownerModulePaths,
            importEdges,
            unresolvedImportCount,
            canonicalImportEdges,
            err):
        return false
    if ownerModulePaths.len > 0:
        parsed.moduleStem = strings.CloneStr(ownerModulePaths[0])
    parsed.orderedClosureSourcePaths = canonicalOrderedSourcePaths
    parsed.ownerModulePaths = ownerModulePaths
    parsed.importEdges = canonicalImportEdges
    parsed.unresolvedImportCount = unresolvedImportCount
    err = ""
    return true

@borrows
fn BuildSystemLinkPlanStubWithRequestFieldsAndExternalPackageRoots(rootDir: str,
                                                                    fields: var SystemLinkPlanRequestFields,
                                                                    externalPackageRoots: parser.ParserExternalPackageRoot[],
                                                                    plan: var SystemLinkPlanStub,
                                                                    err: var str): bool =
    # 域 E 阶段一:生产上下文(held-exec child)且无 live CLAIMED lease 时,
    # 旧路径 plan build 五入口(本函数为共同根)一律拒签;生产唯一入口待
    # BuildSystemLinkPlanStubFromHeldBundleInto(依赖域 A bundle decode view)。
    if SystemLinkPlanProductionPathReadRetired():
        err = "HARD_RED:system_link_plan_production_build_requires_claimed_lease"
        return false
    SystemLinkPlanDebugStage("fields_enter")
    SystemLinkPlanTraceStage("enter")
    # let (not var): @borrows/var-field projection cannot seed a unique var-field root.
    let requestSourcePath = fields.sourcePathRaw
    SystemLinkPlanDebugStage("fields_after_source_assign")
    SystemLinkPlanTraceStage("after_source_path_assign")
    SystemLinkPlanDebugStage("fields_after_source_empty_check")
    SystemLinkPlanTraceStage("after_source_path")
    var parsed: parser.ParsedSourceStub
    SystemLinkPlanDebugStage("fields_after_parsed_var")
    SystemLinkPlanTraceStage("before_parse")
    if externalPackageRoots.len <= 0:
        SystemLinkPlanDebugStage("fields_local_parse_enter")
        if cmdline.ParamStr(3) == "--plan-build-probe:parse":
            SystemLinkPlanDebugStage("fields_parse_probe_before_single_source_cid")
            let probePackageId = parser.ParserManifestNormalizePackageId(
                parser.ParserManifestValue(
                    parser.ParserPackageManifestText(fields.packageRoot),
                    "package_id"))
            var probeModulePath: str
            var noExternalPackageRoots: parser.ParserExternalPackageRoot[]
            cworld.CompilerWorldSourceBundleModulePathInto(
                fields.packageRoot,
                fields.packageRoot,
                probePackageId,
                noExternalPackageRoots,
                requestSourcePath,
                probeModulePath)
            var probeCid: layout.FixedBytes32
            if probePackageId == "" || probeModulePath == "" ||
               !cworld.CompilerWorldSourceBundleCidSingleModuleSourceInto(
                   probePackageId,
                   probeModulePath,
                   requestSourcePath,
                   probeCid):
                SystemLinkPlanDebugStage("fields_parse_probe_single_source_cid_error")
                return false
            SystemLinkPlanDebugStage("fields_parse_probe_after_single_source_cid")
            return true
        let mainPresent = true
        SystemLinkPlanDebugStage("fields_local_parse_after_main")
        var ordered: str[]
        add(ordered, strings.CloneStr(requestSourcePath))
        SystemLinkPlanDebugStage("fields_local_parse_after_ordered")
        let packageId = parser.ParserManifestNormalizePackageId(
            parser.ParserManifestValue(
                parser.ParserPackageManifestText(fields.packageRoot),
                "package_id"))
        if packageId == "" ||
           !parser.ParserSourceIdentityModuleTextValid(packageId):
            err = Fmt"system link plan: package identity unavailable root={fields.packageRoot}"
            return false
        var ownerModulePaths: str[]
        var entryModulePath: str
        cworld.CompilerWorldSourceBundleModulePathInto(
            fields.packageRoot,
            fields.packageRoot,
            packageId,
            externalPackageRoots,
            requestSourcePath,
            entryModulePath)
        if entryModulePath == "":
            err = Fmt"system link plan: entry module identity unavailable source={requestSourcePath}"
            return false
        add(ownerModulePaths, share(entryModulePath))
        var importEdges: parser.ImportEdge[]
        SystemLinkPlanDebugStage("fields_local_parse_after_empty_arrays")
        var exprLayer = parser.NormalizedExprLayer()
        SystemLinkPlanDebugStage("fields_local_parse_after_expr_layer")
        parsed.workspaceRoot = fields.packageRoot
        SystemLinkPlanDebugStage("fields_local_parse_after_workspace")
        parsed.packageRoot = fields.packageRoot
        parsed.packageId = packageId
        parsed.entrySourcePath = strings.CloneStr(requestSourcePath)
        parsed.sourcePath = strings.CloneStr(requestSourcePath)
        parsed.moduleStem = strings.CloneStr(entryModulePath)
        parsed.syntaxTag = "cheng_normalized_source"
        parsed.sourceKind = parser.ParsedOrdinarySource
        parsed.ownerModulePaths = ownerModulePaths
        parsed.importEdges = importEdges
        parsed.orderedClosureSourcePaths = ordered
        parsed.normalizedExprLayer = exprLayer
        parsed.hasCompilerTopLevel = mainPresent
        parsed.mainFunctionPresent = mainPresent
        parsed.unresolvedImportCount = 0
        err = ""
    else:
        if !parser.ParseOrdinarySourceHeaderStubWithExternalPackageRoots(fields.packageRoot,
                                                                         requestSourcePath,
                                                                         externalPackageRoots,
                                                                         parsed,
                                                                         err):
            return false
    if !SystemLinkPlanCollectExactSourceClosure(parsed,
                                                externalPackageRoots,
                                                requestSourcePath,
                                                err):
        return false
    SystemLinkPlanDebugStage("fields_after_parse")
    SystemLinkPlanTraceStage("after_parse")
    let toolingTrack = false
    SystemLinkPlanDebugStage("fields_after_tooling_track")
    let moduleKind = toolingTrack ? SystemCompilerControlPlane : SystemOrdinaryProgram
    SystemLinkPlanDebugStage("fields_after_module_kind_value")
    SystemLinkPlanTraceStage("after_module_kind")
    var runtimeTargetCount: int32
    SystemLinkPlanDebugStage("fields_after_runtime_target_count")
    var providerModuleCount: int32
    SystemLinkPlanDebugStage("fields_after_provider_module_count")
    var needsRuntime = fields.emitKind == creq.EmitExe
    SystemLinkPlanDebugStage("fields_after_needs_runtime")
    if needsRuntime:
        runtimeTargetCount = 1
        providerModuleCount = 6
    SystemLinkPlanDebugStage("fields_after_runtime_module_counts")
    SystemLinkPlanTraceStage("after_runtime_modules")
    SystemLinkPlanDebugStage("fields_before_provider_import_loop")
    if parsed.importEdges.len > 0:
        if parsed.ownerModulePaths.len != parsed.orderedClosureSourcePaths.len:
            err = "system link plan: exact owner module column unavailable"
            return false
        for i in 0..<parsed.orderedClosureSourcePaths.len:
            if i == 0:
                SystemLinkPlanDebugStage("fields_provider_import_loop_enter")
            SystemLinkPlanTraceStage(Fmt"provider_source_loop_index={i}")
            let targetModule = parsed.ownerModulePaths[i]
            SystemLinkPlanTraceStage("provider_source_module_loaded")
            if len(targetModule) <= 0:
                err = Fmt"system link plan: exact owner module empty index={i}"
                return false
            let importedProviderModule = SystemLinkPlanImportedProviderModule(targetModule)
            SystemLinkPlanTraceStage("provider_source_module_checked")
            if len(importedProviderModule) <= 0:
                continue
            if importedProviderModule != parsed.moduleStem:
                providerModuleCount = providerModuleCount + 1
    SystemLinkPlanDebugStage("fields_after_provider_import_loop")
    SystemLinkPlanTraceStage("after_provider_import_loop")
    SystemLinkPlanDebugStage("fields_before_entry_symbol")
    var entrySymbol = ""
    if fields.emitKind == creq.EmitExe:
        if parsed.mainFunctionPresent:
            entrySymbol = "main"
    SystemLinkPlanDebugStage("fields_after_entry_symbol")
    var missing: str[]
    SystemLinkPlanDebugStage("fields_after_missing_var")
    runtimeTargetCount
    providerModuleCount
    if parsed.orderedClosureSourcePaths.len <= 0:
        add(missing, "source_closure_missing")
    elif parsed.unresolvedImportCount > 0:
        add(missing, "source_closure_unresolved_imports")
    elif !parsed.hasCompilerTopLevel:
        add(missing, "compiler_top_level_missing")
    elif fields.emitKind == creq.EmitExe && Len(entrySymbol) <= 0:
        add(missing, "program_entry_symbol_missing")
    SystemLinkPlanDebugStage("fields_after_missing_reasons")
    let linkMode = "system_link"
    let buildSourceUnitCount = parsed.orderedClosureSourcePaths.len
    let parsedWorkspaceRoot = parsed.workspaceRoot
    SystemLinkPlanDebugStage("fields_before_source_bundle")
    SystemLinkPlanTraceStage("before_source_bundle")
    var sourceBundleCidValue: layout.FixedBytes32
    var sourceBundleClosurePaths: str[]
    var sourceBundleExternalPackageRoots: parser.ParserExternalPackageRoot[]
    var sourceBundleIdentityPaths: str[]
    var sourceBundleOwnerModulePaths: str[]
    var sourceBundleImportEdges: parser.ImportEdge[]
    var sourceBundleEntrySourceIndex: int32
    var sourceBundleEntrySourceCid: layout.FixedBytes32
    var sourceBundleImportGraphCid: layout.FixedBytes32
    var sourceBundleBindingSeal: layout.FixedBytes32
    let sourceBundleOk = SystemLinkPlanBuildSourceBundleBindingFromFilesInto(
        parsed.packageId,
        parsed.workspaceRoot,
        parsed.packageRoot,
        externalPackageRoots,
        parsed.orderedClosureSourcePaths,
        requestSourcePath,
        parsed.importEdges,
        parsed.unresolvedImportCount,
        sourceBundleExternalPackageRoots,
        sourceBundleClosurePaths,
        sourceBundleIdentityPaths,
        sourceBundleOwnerModulePaths,
        sourceBundleImportEdges,
        sourceBundleEntrySourceIndex,
        sourceBundleCidValue,
        sourceBundleEntrySourceCid,
        sourceBundleImportGraphCid,
        sourceBundleBindingSeal,
        err)
    SystemLinkPlanDebugStage("fields_after_source_bundle")
    SystemLinkPlanTraceStage("after_source_bundle")
    if !sourceBundleOk:
        SystemLinkPlanDebugStage("fields_source_bundle_error")
        if err == "":
            err = " compiler world: source bundle cid unavailable"
        return false
    let sourceBundleCid = Ok[layout.FixedBytes32](sourceBundleCidValue)
    SystemLinkPlanTraceStage("before_assign_plan")
    plan.entryPath = strings.CloneStr(
        sourceBundleClosurePaths[sourceBundleEntrySourceIndex])
    plan.outputPath = fields.outputPath
    plan.targetTriple = fields.targetTriple
    plan.emitKind = fields.emitKind
    plan.symbolVisibility = fields.symbolVisibility
    plan.browserBridgeObjectPath = fields.browserBridgeObjectPath
    plan.exportRootSymbols = []
    plan.packageRoot = parsed.packageRoot
    plan.externalPackageRoots = sourceBundleExternalPackageRoots
    plan.workspaceRoot = parsed.workspaceRoot
    plan.packageId = strings.CloneStr(parsed.packageId)
    plan.moduleStem = strings.CloneStr(
        sourceBundleOwnerModulePaths[sourceBundleEntrySourceIndex])
    plan.moduleKind = moduleKind
    plan.sourceBundleCid = sourceBundleCid
    plan.sourceBundleCidValue = sourceBundleCidValue
    plan.sourceBundleEntrySourceIndex = sourceBundleEntrySourceIndex
    plan.sourceBundleEntrySourceCid = sourceBundleEntrySourceCid
    plan.sourceBundleImportGraphCid = sourceBundleImportGraphCid
    plan.sourceBundleBindingSeal = sourceBundleBindingSeal
    plan.sourceBundleIdentityPaths = sourceBundleIdentityPaths
    plan.sourceClosurePaths = sourceBundleClosurePaths
    plan.ownerModulePaths = sourceBundleOwnerModulePaths
    plan.importEdgeCount = sourceBundleImportEdges.len
    plan.importEdges = sourceBundleImportEdges
    plan.unresolvedImportCount = parsed.unresolvedImportCount
    parser.NormalizedExprLayerMoveInto(plan.exprLayer,
                                       parsed.normalizedExprLayer)
    plan.exprLayerCloneCount = 0
    plan.exprLayerMoveCount = 1
    assert(parsed.normalizedExprLayer.exprs.len == 0 &&
           parsed.normalizedExprLayer.exprNext.len == 0 &&
           parsed.normalizedExprLayer.exprLookup.slots.len == 0 &&
           parsed.normalizedExprLayer.exprLookup.buckets.len == 0,
           "system link plan: parsed expression layer remained owned after move")
    plan.hasCompilerTopLevel = parsed.hasCompilerTopLevel
    plan.mainFunctionPresent = parsed.mainFunctionPresent
    plan.providerModules = []
    plan.runtimeTargets = []
    if needsRuntime:
        let runtimeTarget = tmat.TargetIsWasm(fields.targetTriple) ? "runtime/compiler.program_wasm_entry" : (toolingTrack ? "runtime/compiler.tooling_argv_entry" : "runtime/compiler.program_argv_entry")
        add(plan.runtimeTargets, strings.CloneStr(runtimeTarget))
        add(plan.providerModules, "runtime/compiler_runtime")
        add(plan.providerModules, "runtime/core_runtime")
        add(plan.providerModules, "runtime/debug_runtime")
        add(plan.providerModules, "runtime/program_support")
        add(plan.providerModules, "runtime/program_support_get_env_bridge")
        add(plan.providerModules, "runtime/program_support_host_runtime")
    if parsed.importEdges.len > 0:
        if parsed.ownerModulePaths.len != parsed.orderedClosureSourcePaths.len:
            err = "system link plan: provider owner module column unavailable"
            return false
        for providerSourceIndex in 0..<parsed.orderedClosureSourcePaths.len:
            let providerModuleSource = parsed.ownerModulePaths[providerSourceIndex]
            if providerModuleSource == "":
                err = Fmt"system link plan: provider owner module empty index={providerSourceIndex}"
                return false
            let importedProviderModule = SystemLinkPlanImportedProviderModule(providerModuleSource)
            if len(importedProviderModule) <= 0:
                continue
            if importedProviderModule == parsed.moduleStem:
                continue
            var providerSeen = false
            for providerSeenIndex in 0..<plan.providerModules.len:
                if plan.providerModules[providerSeenIndex] == importedProviderModule:
                    providerSeen = true
                    break
            if !providerSeen:
                add(plan.providerModules, strings.CloneStr(importedProviderModule))
    for providerTraceIndex in 0..<plan.providerModules.len:
        SystemLinkPlanTraceStage(Fmt"provider_module_final index={providerTraceIndex} value={plan.providerModules[providerTraceIndex]}")
    plan.entrySymbol = entrySymbol
    plan.missingReasons = missing
    plan.parserSyntaxTag = parsed.syntaxTag
    plan.parserSourceKind = Int32(parsed.sourceKind)
    plan.buildEntryPath = plan.entryPath
    plan.buildSourceUnitCount = buildSourceUnitCount
    plan.linkMode = linkMode
    plan.pipelineStage = "parser_to_system_link_plan"
    SystemLinkPlanTraceStage("done")
    err = ""
    return true

@borrows
fn BuildSystemLinkPlanStubWithFieldsAndExternalPackageRoots(rootDir: str,
                                                              requestPackageRoot: str,
                                                              requestSourcePathRaw: str,
                                                              requestOutputPath: str,
                                                              requestTargetTriple: str,
                                                              requestEmitKind: creq.CompilerEmit,
                                                              requestSymbolVisibility: str,
                                                              requestBrowserBridgeObjectPath: str,
                                                              externalPackageRoots: parser.ParserExternalPackageRoot[],
                                                              plan: var SystemLinkPlanStub,
                                                              err: var str): bool =
    var fields: SystemLinkPlanRequestFields
    fields.packageRoot = requestPackageRoot
    fields.sourcePathRaw = requestSourcePathRaw
    fields.outputPath = requestOutputPath
    fields.targetTriple = requestTargetTriple
    fields.emitKind = requestEmitKind
    fields.symbolVisibility = requestSymbolVisibility
    fields.browserBridgeObjectPath = requestBrowserBridgeObjectPath
    return BuildSystemLinkPlanStubWithRequestFieldsAndExternalPackageRoots(rootDir,
                                                                          fields,
                                                                          externalPackageRoots,
                                                                          plan,
                                                                          err)

@borrows
fn BuildSystemLinkPlanStubWithFields(rootDir: str,
                                       requestPackageRoot: str,
                                       requestSourcePathRaw: str,
                                       requestOutputPath: str,
                                       requestTargetTriple: str,
                                       requestEmitKind: creq.CompilerEmit,
                                       requestSymbolVisibility: str,
                                       requestBrowserBridgeObjectPath: str,
                                       plan: var SystemLinkPlanStub,
                                       err: var str): bool =
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    return BuildSystemLinkPlanStubWithFieldsAndExternalPackageRoots(rootDir,
                                                                    requestPackageRoot,
                                                                    requestSourcePathRaw,
                                                                    requestOutputPath,
                                                                    requestTargetTriple,
                                                                    requestEmitKind,
                                                                    requestSymbolVisibility,
                                                                    requestBrowserBridgeObjectPath,
                                                                    externalPackageRoots,
                                                                    plan,
                                                                    err)

@borrows
fn BuildSystemLinkPlanStubWithExternalPackageRoots(rootDir: str,
                                                     req: creq.CompilerRequest,
                                                     externalPackageRoots: parser.ParserExternalPackageRoot[],
                                                     plan: var SystemLinkPlanStub,
                                                     err: var str): bool =
    SystemLinkPlanDebugStage("external_enter")
    let reqRootDir = creq.CompilerRequestRootDir(req)
    SystemLinkPlanDebugStage("external_after_req_root")
    let reqSourcePath = creq.CompilerRequestSourcePath(req)
    SystemLinkPlanDebugStage("external_after_req_source")
    let reqOutputPath = creq.CompilerRequestOutputPath(req)
    SystemLinkPlanDebugStage("external_after_req_output")
    let reqTargetTriple = creq.CompilerRequestTargetTriple(req)
    SystemLinkPlanDebugStage("external_after_req_target")
    let reqEmitKind = creq.CompilerRequestEmitKind(req)
    SystemLinkPlanDebugStage("external_after_req_emit")
    let reqSymbolVisibility = creq.CompilerRequestSymbolVisibility(req)
    SystemLinkPlanDebugStage("external_after_req_visibility")
    let reqBrowserBridgeObjectPath = creq.CompilerRequestBrowserBridgeObjectPath(req)
    SystemLinkPlanDebugStage("external_after_req_browser_bridge")
    var fields: SystemLinkPlanRequestFields
    fields.packageRoot = strings.CloneStr(reqRootDir)
    fields.sourcePathRaw = strings.CloneStr(reqSourcePath)
    fields.outputPath = strings.CloneStr(reqOutputPath)
    fields.targetTriple = strings.CloneStr(reqTargetTriple)
    fields.emitKind = reqEmitKind
    fields.symbolVisibility = strings.CloneStr(reqSymbolVisibility)
    fields.browserBridgeObjectPath = strings.CloneStr(reqBrowserBridgeObjectPath)
    SystemLinkPlanDebugStage("external_after_fields_pack")
    let providerObjects = SystemLinkPlanAbsoluteProviderObjectPaths(
        rootDir,
        creq.CompilerRequestProviderObjectPaths(req))
    let runtimeProviderBundle = strings.CloneStr(
        creq.CompilerRequestRuntimeProviderBundle(req))
    if providerObjects.len > 0 && Len(runtimeProviderBundle) > 0:
        err = " system link plan: --provider-objects and --runtime-provider-bundle cannot be combined"
        return false
    if Len(runtimeProviderBundle) > 0 &&
       runtimeProviderBundle != "codex-app-server":
        err = Fmt" system link plan: unsupported --runtime-provider-bundle: {runtimeProviderBundle}"
        return false
    var candidate: SystemLinkPlanStub
    let ok = BuildSystemLinkPlanStubWithRequestFieldsAndExternalPackageRoots(rootDir,
                                                                             fields,
                                                                             externalPackageRoots,
                                                                             candidate,
                                                                             err)
    SystemLinkPlanDebugStage("external_after_fields_call")
    if !ok:
        return false
    SystemLinkPlanDebugStage("external_ok_begin")
    if cmdline.ParamStr(3) == "--plan-build-probe:parse":
        SystemLinkPlanDebugStage("external_parse_probe_ok_return")
        plan = candidate
        return true
    candidate.exportRootSymbols = SystemLinkPlanStringsClone(
        creq.CompilerRequestExportRootSymbols(req))
    if os.GetEnv("CHENG_EXP_DBG") != "":
        os.WriteLine(os.GetStderr(), Fmt"expdbg planroots len={strings.IntToStr(candidate.exportRootSymbols.len)}")
    SystemLinkPlanDebugStage("external_after_export_roots")
    candidate.jobCount = creq.CompilerRequestJobCount(req)
    SystemLinkPlanDebugStage("external_after_job_count")
    if providerObjects.len > 0:
        candidate.providerModules = []
    elif runtimeProviderBundle == "codex-app-server":
        candidate.providerModules = SystemLinkPlanCodexAppServerProviderModules()
    candidate.providerObjectPaths = providerObjects
    candidate.runtimeProviderBundle = runtimeProviderBundle
    plan = candidate
    SystemLinkPlanDebugStage("external_return")
    return true

@borrows
fn BuildSystemLinkPlanStub(rootDir: str,
                             req: creq.CompilerRequest,
                             plan: var SystemLinkPlanStub,
                             err: var str): bool =
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    return BuildSystemLinkPlanStubWithExternalPackageRoots(rootDir,
                                                             req,
                                                             externalPackageRoots,
                                                             plan,
                                                             err)

@borrows
fn SystemLinkPlanStubReport(plan: SystemLinkPlanStub): str =
    var out = ""
    let entryPathBorrowed = SystemLinkPlanEntryPath(plan)
    let entryPath = strings.CloneStr(entryPathBorrowed)
    let outputPathBorrowed = SystemLinkPlanOutputPath(plan)
    let outputPath = strings.CloneStr(outputPathBorrowed)
    let targetTripleBorrowed = SystemLinkPlanTargetTriple(plan)
    let targetTriple = strings.CloneStr(targetTripleBorrowed)
    let emitKind = SystemLinkPlanEmitKind(plan)
    let emitTextBorrowed = creq.CompilerEmitText(emitKind)
    let emitText = strings.CloneStr(emitTextBorrowed)
    let symbolVisibilityBorrowed = SystemLinkPlanSymbolVisibility(plan)
    let symbolVisibility = strings.CloneStr(symbolVisibilityBorrowed)
    let browserBridgeObjectPathBorrowed = SystemLinkPlanBrowserBridgeObjectPath(plan)
    let browserBridgeObjectPath = SystemLinkPlanNonEmptyOrDash(
        strings.CloneStr(browserBridgeObjectPathBorrowed))
    let workspaceRootBorrowed = SystemLinkPlanWorkspaceRoot(plan)
    let workspaceRoot = strings.CloneStr(workspaceRootBorrowed)
    let packageRootBorrowed = SystemLinkPlanPackageRoot(plan)
    let packageRoot = strings.CloneStr(packageRootBorrowed)
    let packageIdBorrowed = SystemLinkPlanPackageId(plan)
    let packageId = strings.CloneStr(packageIdBorrowed)
    let moduleStemBorrowed = SystemLinkPlanModuleStem(plan)
    let moduleStem = strings.CloneStr(moduleStemBorrowed)
    let moduleKind = SystemLinkPlanModuleKind(plan)
    let moduleKindTextBorrowed = SystemModuleKindText(moduleKind)
    let moduleKindText = strings.CloneStr(moduleKindTextBorrowed)
    let sourceClosurePaths = SystemLinkPlanSourceClosurePaths(plan)
    let sourceClosureCount = IntToStr(sourceClosurePaths.len)
    let sourceBundleIdentityPaths = SystemLinkPlanSourceBundleIdentityPaths(plan)
    let sourceBundleIdentityCount = IntToStr(sourceBundleIdentityPaths.len)
    let ownerModulePaths = SystemLinkPlanOwnerModulePaths(plan)
    let importEdgeCount = IntToStr(SystemLinkPlanImportEdgeCount(plan))
    let unresolvedImportCount = IntToStr(SystemLinkPlanUnresolvedImportCount(plan))
    let exprLayer = SystemLinkPlanExprLayer(plan)
    let hasCompilerTopLevel = SystemLinkPlanBoolDigit(
        SystemLinkPlanHasCompilerTopLevel(plan))
    let mainFunctionPresent = SystemLinkPlanBoolDigit(
        SystemLinkPlanMainFunctionPresent(plan))
    let runtimeTargets = SystemLinkPlanRuntimeTargets(plan)
    let runtimeTargetList = SystemLinkPlanListText(runtimeTargets)
    let providerModules = SystemLinkPlanProviderModules(plan)
    let providerModuleList = SystemLinkPlanListText(providerModules)
    let providerObjectPaths = SystemLinkPlanProviderObjectPaths(plan)
    let providerObjectPathList = SystemLinkPlanListText(providerObjectPaths)
    let runtimeProviderBundleBorrowed = SystemLinkPlanRuntimeProviderBundle(plan)
    let runtimeProviderBundle = SystemLinkPlanNonEmptyOrDash(
        strings.CloneStr(runtimeProviderBundleBorrowed))
    let exportRoots = SystemLinkPlanExportRootSymbols(plan)
    let exportRootList = SystemLinkPlanListText(exportRoots)
    let entrySymbolBorrowed = SystemLinkPlanEntrySymbol(plan)
    let entrySymbol = SystemLinkPlanNonEmptyOrDash(
        strings.CloneStr(entrySymbolBorrowed))
    let missingField = SystemLinkPlanMissingReasonsField(plan)
    let missingReasons = SystemLinkPlanListText(missingField)
    let parserSyntaxBorrowed = SystemLinkPlanParserSyntaxTag(plan)
    let parserSyntax = strings.CloneStr(parserSyntaxBorrowed)
    let parserSourceKind = SystemLinkPlanParserSourceKind(plan)
    let parserSourceKindTextBorrowed = SystemLinkPlanParserSourceKindText(parserSourceKind)
    let parserSourceKindText = strings.CloneStr(parserSourceKindTextBorrowed)
    let buildEntryBorrowed = SystemLinkPlanBuildEntryPath(plan)
    let buildEntry = strings.CloneStr(buildEntryBorrowed)
    let buildSourceUnitCount = IntToStr(SystemLinkPlanBuildSourceUnitCount(plan))
    let linkModeBorrowed = SystemLinkPlanLinkMode(plan)
    let linkMode = strings.CloneStr(linkModeBorrowed)
    let pipelineStageBorrowed = SystemLinkPlanPipelineStage(plan)
    let pipelineStage = strings.CloneStr(pipelineStageBorrowed)
    let jobCount = IntToStr(SystemLinkPlanJobCount(plan))
    SystemLinkPlanAppendLine(out, "entry", entryPath)
    SystemLinkPlanAppendLine(out, "output", outputPath)
    SystemLinkPlanAppendLine(out, "target", targetTriple)
    SystemLinkPlanAppendLine(out, "emit", emitText)
    SystemLinkPlanAppendLine(out, "symbol_visibility", symbolVisibility)
    SystemLinkPlanAppendLine(out, "browser_bridge_object", browserBridgeObjectPath)
    SystemLinkPlanAppendLine(out, "workspace_root", workspaceRoot)
    SystemLinkPlanAppendLine(out, "package_root", packageRoot)
    SystemLinkPlanAppendLine(out, "package_id", packageId)
    SystemLinkPlanAppendLine(out, "module_stem", moduleStem)
    SystemLinkPlanAppendLine(out, "module_kind", moduleKindText)
    SystemLinkPlanAppendLine(out, "source_closure_count", sourceClosureCount)
    for sourceIndex in 0..<sourceClosurePaths.len:
        let ownedSourceClosurePath = strings.CloneStr(
            sourceClosurePaths[sourceIndex])
        SystemLinkPlanAppendLine(
            out,
            Fmt"source_closure_path.{sourceIndex}",
            ownedSourceClosurePath)
    SystemLinkPlanAppendLine(out,
                             "source_bundle_cid",
                             layout.FixedBytes32Hex(plan.sourceBundleCidValue))
    SystemLinkPlanAppendLine(out,
                             "source_bundle_binding_seal",
                             layout.FixedBytes32Hex(plan.sourceBundleBindingSeal))
    SystemLinkPlanAppendLine(
        out,
        "source_bundle_entry_source_cid",
        layout.FixedBytes32Hex(plan.sourceBundleEntrySourceCid))
    SystemLinkPlanAppendLine(
        out,
        "source_bundle_import_graph_cid",
        layout.FixedBytes32Hex(plan.sourceBundleImportGraphCid))
    SystemLinkPlanAppendLine(out,
                             "source_bundle_identity_count",
                             sourceBundleIdentityCount)
    for identityIndex in 0..<sourceBundleIdentityPaths.len:
        let ownedIdentityPath = strings.CloneStr(
            sourceBundleIdentityPaths[identityIndex])
        SystemLinkPlanAppendLine(
            out,
            Fmt"source_bundle_identity_path.{identityIndex}",
            ownedIdentityPath)
    SystemLinkPlanAppendLine(out,
                             "owner_module_count",
                             IntToStr(ownerModulePaths.len))
    for ownerIndex in 0..<ownerModulePaths.len:
        let ownedOwnerModule = strings.CloneStr(
            ownerModulePaths[ownerIndex])
        SystemLinkPlanAppendLine(out,
                                 Fmt"owner_module.{ownerIndex}",
                                 ownedOwnerModule)
    SystemLinkPlanAppendLine(out, "import_edge_count", importEdgeCount)
    SystemLinkPlanAppendLine(out, "unresolved_import_count", unresolvedImportCount)
    SystemLinkPlanAppendLine(out, "expr_surface_source_count", IntToStr(exprLayer.sourceCount))
    SystemLinkPlanAppendLine(out, "expr_surface_clone_count", IntToStr(plan.exprLayerCloneCount))
    SystemLinkPlanAppendLine(out, "expr_surface_move_count", IntToStr(plan.exprLayerMoveCount))
    SystemLinkPlanAppendLine(out, "expr_surface_transfer_kind", "move")
    SystemLinkPlanAppendLine(out, "expr_surface_expr_count", IntToStr(parser.NormalizedExprLayerExprCount(exprLayer)))
    SystemLinkPlanAppendLine(out, "expr_surface_if_count", IntToStr(parser.NormalizedExprLayerIfCount(exprLayer)))
    SystemLinkPlanAppendLine(out, "expr_surface_range_count", IntToStr(parser.NormalizedExprLayerRangeCount(exprLayer)))
    SystemLinkPlanAppendLine(out, "expr_surface_comprehension_count", IntToStr(parser.NormalizedExprLayerComprehensionCount(exprLayer)))
    SystemLinkPlanAppendLine(out, "expr_surface_fmt_count", IntToStr(parser.NormalizedExprLayerStrFormatCount(exprLayer)))
    SystemLinkPlanAppendLine(out, "expr_surface_result_intrinsic_count", IntToStr(parser.NormalizedExprLayerResultIntrinsicCount(exprLayer)))
    SystemLinkPlanAppendLine(out, "expr_surface_try_count", IntToStr(parser.NormalizedExprLayerTryCount(exprLayer)))
    SystemLinkPlanAppendLine(out, "expr_surface_default_init_count", IntToStr(parser.NormalizedExprLayerDefaultInitCount(exprLayer)))
    SystemLinkPlanAppendLine(out, "expr_surface_constructor_count", IntToStr(parser.NormalizedExprLayerConstructorCount(exprLayer)))
    SystemLinkPlanAppendLine(out, "expr_surface_return_count", IntToStr(parser.NormalizedExprLayerReturnCount(exprLayer)))
    SystemLinkPlanAppendLine(out, "expr_surface_assign_count", IntToStr(parser.NormalizedExprLayerAssignCount(exprLayer)))
    SystemLinkPlanAppendLine(out, "expr_surface_if_stmt_count", IntToStr(parser.NormalizedExprLayerIfStmtCount(exprLayer)))
    SystemLinkPlanAppendLine(out, "expr_surface_elif_stmt_count", IntToStr(parser.NormalizedExprLayerElifStmtCount(exprLayer)))
    SystemLinkPlanAppendLine(out, "expr_surface_else_stmt_count", IntToStr(parser.NormalizedExprLayerElseStmtCount(exprLayer)))
    SystemLinkPlanAppendLine(out, "expr_surface_for_stmt_count", IntToStr(parser.NormalizedExprLayerForStmtCount(exprLayer)))
    SystemLinkPlanAppendLine(out, "expr_surface_question_residual_count", IntToStr(exprLayer.questionResidualCount))
    SystemLinkPlanAppendLine(out, "has_compiler_top_level", hasCompilerTopLevel)
    SystemLinkPlanAppendLine(out, "main_function_present", mainFunctionPresent)
    SystemLinkPlanAppendLine(out, "runtime_targets", runtimeTargetList)
    SystemLinkPlanAppendLine(out, "provider_modules", providerModuleList)
    SystemLinkPlanAppendLine(out, "provider_object_overrides", providerObjectPathList)
    SystemLinkPlanAppendLine(out, "runtime_provider_bundle", runtimeProviderBundle)
    SystemLinkPlanAppendLine(out, "runtime_provider_bundle_auto", "0")
    SystemLinkPlanAppendLine(out, "runtime_provider_bundle_object_count", IntToStr(providerModules.len))
    SystemLinkPlanAppendLine(out, "export_roots", exportRootList)
    SystemLinkPlanAppendLine(out, "entry_symbol", entrySymbol)
    SystemLinkPlanAppendLine(out, "missing_reasons", missingReasons)
    SystemLinkPlanAppendLine(out, "parser_syntax", parserSyntax)
    SystemLinkPlanAppendLine(out, "parser_source_kind", parserSourceKindText)
    SystemLinkPlanAppendLine(out, "build_entry", buildEntry)
    SystemLinkPlanAppendLine(out, "build_source_unit_count", buildSourceUnitCount)
    SystemLinkPlanAppendLine(out, "link_mode", linkMode)
    SystemLinkPlanAppendLine(out, "pipeline_stage", pipelineStage)
    SystemLinkPlanAppendLine(out, "job_count", jobCount)
    return out
fn SystemLinkPlanParserSourceKindText(kind: int32): str =
    if kind == Int32(parser.ParsedOrdinarySource):
        return parser.ParsedSourceKindText(parser.ParsedOrdinarySource)
    return "unknown"
