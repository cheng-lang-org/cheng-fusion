fn SystemModuleKindText(kind: SystemModuleKind): str =
    if kind == SystemCompilerControlPlane:
        return "compiler_control_plane"
    return "ordinary_program"

@borrows
fn SystemLinkPlanListText(items: str[]): str =
    if items.len <= 0:
        return "-"
    var out = ""
    for i in 0..<items.len:
        if Len(out) > 0:
            out = Fmt"{out},"
        out = Fmt"{out}{items[i]}"
    return out

@borrows
fn SystemLinkPlanAppendLine(out: var str, key: str, value: str) =
    if Len(out) > 0:
        out = Fmt"{out}\n"
    out = Fmt"{out}{key}={value}"

fn SystemLinkPlanNonEmptyOrDash(value: str): str =
    if Len(value) <= 0:
        return "-"
    return value

fn SystemLinkPlanBoolDigit(value: bool): str =
    if value:
        return "1"
    return "0"

# CSG 生产链 capability 原子切换(域 E,阶段一)。held-exec child 是唯一生产
# 命令上下文;其中 plan 必须只消费 held bundle 的 source rows,严禁按路径
# 重读源码。bundle 通道(域 A decode view/域 B 递送)尚未接通,因此生产上下文
# 中且无 live CLAIMED lease 时,任何对旧路径读取函数的到达一律 HARD_RED;
# 非生产开发命令(无 child admission)行为不变。阶段二由 held 变体物理替换。
fn SystemLinkPlanProductionPathReadRetired(): bool =
    if !system.RuntimeHeldExecChildAdmissionActive():
        return false
    return merkle_store.ProductionAdmittedClaimAuthorityStateCurrent() !=
           merkle_store.ProductionAdmittedClaimStateClaimed

@borrows
fn SystemLinkPlanReportTextHex(value: str): str =
    var raw = rawbytes.BytesAlloc(len(value))
    if rawbytes.BytesLen(raw) != len(value):
        rawbytes.BytesFree(raw)
        panic("system_link_plan_report_text_hex_alloc_failed")
    for i in 0..<len(value):
        rawbytes.BytesSet(raw, i, int32(value[i]) & 255)
    let out = rawbytes.BytesToHex(raw)
    rawbytes.BytesFree(raw)
    return out

@borrows
fn SystemLinkPlanExecutionPayloadRetainedItemCount(
        plan: SystemLinkPlanStub): int32 =
    return plan.exprLayer.exprs.len +
           plan.exprLayer.exprNext.len +
           plan.exportRootSymbols.len +
           plan.externalPackageRoots.len +
           plan.sourceBundleIdentityPaths.len +
           plan.sourceClosurePaths.len +
           plan.ownerModulePaths.len +
           plan.importEdges.len +
           plan.runtimeTargets.len +
           plan.providerModules.len +
           plan.providerObjectPaths.len +
           plan.missingReasons.len +
           plan.runtimeProviderBundle.len

