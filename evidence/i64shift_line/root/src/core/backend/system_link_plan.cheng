    SystemLinkPlanCompilerInputOwnedStorageColumnCount: int32 = 8
    SystemLinkPlanCompilerResidualOwnedStorageColumnCount: int32 = 3

@borrows
fn SystemLinkPlanTraceStage(stage: str) =
    let tracePath = strutil.Strip(os.GetEnv("CHENG_SYSTEM_LINK_PLAN_TRACE"))
    if len(tracePath) > 0:
        # 域 E 阶段一钉死:trace 是仅调试路径,生产上下文(held-exec child)
        # 禁止任何 trace 文件读写。
        if SystemLinkPlanProductionPathReadRetired():
            panic("HARD_RED:system_link_plan_production_trace_disabled")
        var previous = ""
        if os.FileExists(tracePath):
            previous = chengpath.ReadTextFile("", tracePath)
        if len(previous) > 0 && previous[len(previous) - 1] != '\n':
            previous = Fmt"{previous}\n"
        let _ = chengpath.WriteTextFile("", tracePath, Fmt"{previous}{stage}\n")

@borrows
fn SystemLinkPlanDebugStage(stage: str) =
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_plan={stage}")

@borrows
fn SystemLinkPlanProgressMemoryStage(stage: str) =
    if os.GetEnv("CHENG_PROGRESS") != "1":
        return
    os.WriteLine(os.Get_stderr(),
                 Fmt"system_link_plan_stage={stage} rss_bytes={os.ProcessRssBytes()}")

