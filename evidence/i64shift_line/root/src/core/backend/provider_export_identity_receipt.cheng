import std/rawbytes
import std/seqs
import std/crypto/hash256
import cheng/std/bytes_layout as layout
import cheng/core/runtime/arena as arenamod

const
    ProviderExportIdentityReceiptMagic = 0x50454952
    ProviderExportIdentityReceiptSchemaVersion = 1
    ProviderExportIdentityReceiptOwnedStorageColumnCount = 6
    ProviderExportContractRoleSetCmdLine = 1
    ProviderExportContractRoleRegisterLineMap = 2
    ProviderExportContractRoleProfileFlush = 3
    ProviderExportContractRoleMax = 3
    providerExportIdentityReceiptHeaderBytes = 20
    providerExportIdentityReceiptProviderWireBytes = 104
    providerExportIdentityReceiptExportWireBytes = 96
    providerExportIdentityReceiptTrailerBytes = 32

type
    ProviderExportIdentityReceipt =
        schemaVersion: int32
        sealed: bool
        arena: arenamod.Arena

        # Provider rows. sourceArtifactCid is the immutable provider-child
        # CompilerCSG artifact coordinate root: every producer source,
        # declaration, and node row below is interpreted only inside that
        # exact artifact. Export ranges form one exact contiguous CSR.
        providerExportStarts: arenamod.ArenaArrayInt32
        providerExportCounts: arenamod.ArenaArrayInt32
        providerSourceArtifactCids: layout.FixedBytes32[]
        providerCompileReceiptCids: layout.FixedBytes32[]
        providerObjectBytesCids: layout.FixedBytes32[]

        # Export rows. Identity is numeric; UTF-8 is payload only.
        exportProviderRows: arenamod.ArenaArrayInt32
        exportTypedFunctionRows: arenamod.ArenaArrayInt32
        exportProducerSourceRows: arenamod.ArenaArrayInt32
        exportProducerDeclarationRows: arenamod.ArenaArrayInt32
        exportProducerNodeRows: arenamod.ArenaArrayInt32
        exportContractRoleKinds: arenamod.ArenaArrayInt32
        exportUtf8Starts: arenamod.ArenaArrayInt32
        exportUtf8Counts: arenamod.ArenaArrayInt32
        exportUtf8Bytes: arenamod.ArenaArrayU8
        exportProducerFactCids: layout.FixedBytes32[]
        exportInterfaceCids: layout.FixedBytes32[]

        receiptCid: layout.FixedBytes32

        terminalReleaseOwnerToken: layout.FixedBytes32
        terminalReleasedOwnedStorageColumnCount: int32
        terminalReleasedBufferCount: int32
        terminalReleasedBytes: int64
        terminalStorageReleased: bool
        terminalReleaseReceiptConsumed: bool

    ProviderExportIdentityReleaseReceipt =
        ownerToken: layout.FixedBytes32
        releasedOwnedStorageColumnCount: int32
        releasedBufferCount: int32
        releasedBytes: int64
        storageReleased: bool

@borrows
fn providerExportIdentityReceiptCidZero(value: layout.FixedBytes32): bool =
    return layout.FixedBytes32Equal(value, layout.FixedBytes32())

fn providerExportIdentityReceiptAppendU32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn providerExportIdentityReceiptAppendU64(
        buf: var layout.ByteBuf,
        value: int64) =
    layout.ByteBufAppendByte(buf, int32((value >> 56) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 48) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 40) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 32) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 24) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 16) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 8) & int64(255)))
    layout.ByteBufAppendByte(buf, int32(value & int64(255)))

@borrows
fn providerExportIdentityReceiptUtf8Valid(text: str): bool =
    if text.len <= 0:
        return false
    var cursor: int32
    while cursor < text.len:
        let b0 = int32(text[cursor]) & 255
        if b0 == 0:
            return false
        if b0 <= 127:
            cursor = cursor + 1
        elif b0 >= 194 && b0 <= 223:
            if cursor + 1 >= text.len:
                return false
            let b1 = int32(text[cursor + 1]) & 255
            if b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 2
        elif b0 >= 224 && b0 <= 239:
            if cursor + 2 >= text.len:
                return false
            let b1 = int32(text[cursor + 1]) & 255
            let b2 = int32(text[cursor + 2]) & 255
            if b2 < 128 || b2 > 191:
                return false
            if b0 == 224:
                if b1 < 160 || b1 > 191:
                    return false
            elif b0 == 237:
                if b1 < 128 || b1 > 159:
                    return false
            elif b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 3
        elif b0 >= 240 && b0 <= 244:
            if cursor + 3 >= text.len:
                return false
            let b1 = int32(text[cursor + 1]) & 255
            let b2 = int32(text[cursor + 2]) & 255
            let b3 = int32(text[cursor + 3]) & 255
            if b2 < 128 || b2 > 191 || b3 < 128 || b3 > 191:
                return false
            if b0 == 240:
                if b1 < 144 || b1 > 191:
                    return false
            elif b0 == 244:
                if b1 < 128 || b1 > 143:
                    return false
            elif b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 4
        else:
            return false
    return true

@borrows
fn providerExportIdentityReceiptUtf8RangeValid(
        receipt: ProviderExportIdentityReceipt,
        start: int32,
        count: int32): bool =
    if count <= 0 || start < 0 ||
       start > arenamod.ArenaArrayU8Len(
           receipt.arena, receipt.exportUtf8Bytes) - count:
        return false
    var cursor: int32
    while cursor < count:
        let b0 = arenamod.ArenaArrayU8Get(
            receipt.arena, receipt.exportUtf8Bytes, start + cursor)
        if b0 == 0:
            return false
        if b0 <= 127:
            cursor = cursor + 1
        elif b0 >= 194 && b0 <= 223:
            if cursor + 1 >= count:
                return false
            let b1 = arenamod.ArenaArrayU8Get(
                receipt.arena, receipt.exportUtf8Bytes, start + cursor + 1)
            if b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 2
        elif b0 >= 224 && b0 <= 239:
            if cursor + 2 >= count:
                return false
            let b1 = arenamod.ArenaArrayU8Get(
                receipt.arena, receipt.exportUtf8Bytes, start + cursor + 1)
            let b2 = arenamod.ArenaArrayU8Get(
                receipt.arena, receipt.exportUtf8Bytes, start + cursor + 2)
            if b2 < 128 || b2 > 191:
                return false
            if b0 == 224:
                if b1 < 160 || b1 > 191:
                    return false
            elif b0 == 237:
                if b1 < 128 || b1 > 159:
                    return false
            elif b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 3
        elif b0 >= 240 && b0 <= 244:
            if cursor + 3 >= count:
                return false
            let b1 = arenamod.ArenaArrayU8Get(
                receipt.arena, receipt.exportUtf8Bytes, start + cursor + 1)
            let b2 = arenamod.ArenaArrayU8Get(
                receipt.arena, receipt.exportUtf8Bytes, start + cursor + 2)
            let b3 = arenamod.ArenaArrayU8Get(
                receipt.arena, receipt.exportUtf8Bytes, start + cursor + 3)
            if b2 < 128 || b2 > 191 || b3 < 128 || b3 > 191:
                return false
            if b0 == 240:
                if b1 < 144 || b1 > 191:
                    return false
            elif b0 == 244:
                if b1 < 128 || b1 > 143:
                    return false
            elif b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 4
        else:
            return false
    return true

fn providerExportIdentityReceiptU8Add(
        receipt: var ProviderExportIdentityReceipt,
        value: int32) =
    var grow: bool
    if receipt.exportUtf8Bytes.capacity == 0:
        grow = true
    if receipt.exportUtf8Bytes.len >= receipt.exportUtf8Bytes.capacity:
        grow = true
    if grow:
        var nextCapacity: int32 = 32
        if receipt.exportUtf8Bytes.capacity > 0:
            if receipt.exportUtf8Bytes.capacity > 1073741823:
                panic(" provider export identity receipt: utf8 capacity overflow")
            nextCapacity = receipt.exportUtf8Bytes.capacity * 2
        let nextBytes = arenamod.ArenaAllocBytesAligned(
            receipt.arena, nextCapacity, 1)
        if receipt.exportUtf8Bytes.len > 0:
            var oldBytes: arenamod.ArenaBytes
            oldBytes.offset = receipt.exportUtf8Bytes.offset
            oldBytes.len = receipt.exportUtf8Bytes.len
            oldBytes.alignmentBytes = 1
            oldBytes.generation = receipt.exportUtf8Bytes.generation
            for index in 0..<receipt.exportUtf8Bytes.len:
                arenamod.ArenaSetByte(
                    receipt.arena, nextBytes, index,
                    arenamod.ArenaGetByte(receipt.arena, oldBytes, index))
        receipt.exportUtf8Bytes.offset = nextBytes.offset
        receipt.exportUtf8Bytes.capacity = nextCapacity
        receipt.exportUtf8Bytes.generation = nextBytes.generation
    arenamod.ArenaArrayU8AddReserved(
        receipt.arena, receipt.exportUtf8Bytes, value)

fn ProviderExportIdentityReceiptInit(
        initialArenaCapacity: int32): ProviderExportIdentityReceipt =
    var out: ProviderExportIdentityReceipt
    var capacity = initialArenaCapacity
    if capacity < 256:
        capacity = 256
    out.schemaVersion = ProviderExportIdentityReceiptSchemaVersion
    out.arena = arenamod.ArenaInit(capacity)
    out.providerExportStarts = arenamod.ArenaArrayInt32Init()
    out.providerExportCounts = arenamod.ArenaArrayInt32Init()
    out.exportProviderRows = arenamod.ArenaArrayInt32Init()
    out.exportTypedFunctionRows = arenamod.ArenaArrayInt32Init()
    out.exportProducerSourceRows = arenamod.ArenaArrayInt32Init()
    out.exportProducerDeclarationRows = arenamod.ArenaArrayInt32Init()
    out.exportProducerNodeRows = arenamod.ArenaArrayInt32Init()
    out.exportContractRoleKinds = arenamod.ArenaArrayInt32Init()
    out.exportUtf8Starts = arenamod.ArenaArrayInt32Init()
    out.exportUtf8Counts = arenamod.ArenaArrayInt32Init()
    out.exportUtf8Bytes = arenamod.ArenaArrayU8Init()
    return out

@borrows
fn ProviderExportIdentityReceiptProviderCount(
        receipt: ProviderExportIdentityReceipt): int32 =
    return receipt.providerSourceArtifactCids.len

@borrows
fn ProviderExportIdentityReceiptExportCount(
        receipt: ProviderExportIdentityReceipt): int32 =
    return receipt.exportProducerFactCids.len

fn ProviderExportIdentityReceiptAppendProvider(
        receipt: var ProviderExportIdentityReceipt,
        sourceArtifactCid: layout.FixedBytes32,
        compileReceiptCid: layout.FixedBytes32,
        objectBytesCid: layout.FixedBytes32): int32 =
    if receipt.sealed || receipt.terminalStorageReleased ||
       receipt.schemaVersion != ProviderExportIdentityReceiptSchemaVersion ||
       providerExportIdentityReceiptCidZero(sourceArtifactCid) ||
       providerExportIdentityReceiptCidZero(compileReceiptCid) ||
       providerExportIdentityReceiptCidZero(objectBytesCid):
        return -1
    let row = receipt.providerSourceArtifactCids.len
    add(receipt.providerSourceArtifactCids, sourceArtifactCid)
    add(receipt.providerCompileReceiptCids, compileReceiptCid)
    add(receipt.providerObjectBytesCids, objectBytesCid)
    arenamod.ArenaArrayInt32Add(
        receipt.arena, receipt.providerExportStarts,
        receipt.exportProducerFactCids.len)
    arenamod.ArenaArrayInt32Add(
        receipt.arena, receipt.providerExportCounts, 0)
    return row

@borrows
fn providerExportIdentityReceiptRoleDuplicate(
        receipt: ProviderExportIdentityReceipt,
        providerRow: int32,
        contractRoleKind: int32): bool =
    let start = arenamod.ArenaArrayInt32Get(
        receipt.arena, receipt.providerExportStarts, providerRow)
    let count = arenamod.ArenaArrayInt32Get(
        receipt.arena, receipt.providerExportCounts, providerRow)
    for offset in 0..<count:
        if arenamod.ArenaArrayInt32Get(
               receipt.arena, receipt.exportContractRoleKinds,
               start + offset) == contractRoleKind:
            return true
    return false

fn ProviderExportIdentityReceiptAppendExport(
        receipt: var ProviderExportIdentityReceipt,
        providerRow: int32,
        typedFunctionRow: int32,
        producerSourceRow: int32,
        producerDeclarationRow: int32,
        producerNodeRow: int32,
        producerFactCid: layout.FixedBytes32,
        interfaceCid: layout.FixedBytes32,
        contractRoleKind: int32,
        utf8Payload: str): int32 =
    let providerCount = receipt.providerSourceArtifactCids.len
    if receipt.sealed || receipt.terminalStorageReleased ||
       receipt.schemaVersion != ProviderExportIdentityReceiptSchemaVersion ||
       providerRow < 0 || providerRow >= providerCount ||
       providerRow != providerCount - 1 || typedFunctionRow < 0 ||
       producerSourceRow < 0 || producerDeclarationRow < 0 ||
       producerNodeRow < 0 || contractRoleKind <= 0 ||
       contractRoleKind > ProviderExportContractRoleMax ||
       providerExportIdentityReceiptCidZero(producerFactCid) ||
       providerExportIdentityReceiptCidZero(interfaceCid) ||
       !providerExportIdentityReceiptUtf8Valid(utf8Payload):
        return -1
    let exportCount = receipt.exportProducerFactCids.len
    let providerStart = arenamod.ArenaArrayInt32Get(
        receipt.arena, receipt.providerExportStarts, providerRow)
    let providerRows = arenamod.ArenaArrayInt32Get(
        receipt.arena, receipt.providerExportCounts, providerRow)
    if providerStart + providerRows != exportCount ||
       providerExportIdentityReceiptRoleDuplicate(
           receipt, providerRow, contractRoleKind):
        return -1

    let utf8Start = receipt.exportUtf8Bytes.len
    for index in 0..<utf8Payload.len:
        providerExportIdentityReceiptU8Add(
            receipt, int32(utf8Payload[index]) & 255)
    arenamod.ArenaArrayInt32Add(
        receipt.arena, receipt.exportProviderRows, providerRow)
    arenamod.ArenaArrayInt32Add(
        receipt.arena, receipt.exportTypedFunctionRows, typedFunctionRow)
    arenamod.ArenaArrayInt32Add(
        receipt.arena, receipt.exportProducerSourceRows, producerSourceRow)
    arenamod.ArenaArrayInt32Add(
        receipt.arena, receipt.exportProducerDeclarationRows,
        producerDeclarationRow)
    arenamod.ArenaArrayInt32Add(
        receipt.arena, receipt.exportProducerNodeRows, producerNodeRow)
    arenamod.ArenaArrayInt32Add(
        receipt.arena, receipt.exportContractRoleKinds, contractRoleKind)
    arenamod.ArenaArrayInt32Add(
        receipt.arena, receipt.exportUtf8Starts, utf8Start)
    arenamod.ArenaArrayInt32Add(
        receipt.arena, receipt.exportUtf8Counts, utf8Payload.len)
    add(receipt.exportProducerFactCids, producerFactCid)
    add(receipt.exportInterfaceCids, interfaceCid)
    arenamod.ArenaArrayInt32Set(
        receipt.arena, receipt.providerExportCounts, providerRow,
        providerRows + 1)
    return exportCount

@borrows
fn providerExportIdentityReceiptShapeValid(
        receipt: ProviderExportIdentityReceipt,
        err: var str): bool =
    if receipt.schemaVersion != ProviderExportIdentityReceiptSchemaVersion:
        err = " provider export identity receipt: schema version invalid"
        return false
    if receipt.arena.capacityBytes <= 0 || receipt.arena.usedBytes < 0 ||
       receipt.arena.usedBytes > receipt.arena.capacityBytes ||
       receipt.arena.generation <= 0:
        err = " provider export identity receipt: arena owner invalid"
        return false
    let providerCount = receipt.providerSourceArtifactCids.len
    let exportCount = receipt.exportProducerFactCids.len
    if providerCount <= 0 || exportCount <= 0:
        err = " provider export identity receipt: empty authority"
        return false
    if receipt.providerCompileReceiptCids.len != providerCount ||
       receipt.providerObjectBytesCids.len != providerCount ||
       receipt.providerExportStarts.len != providerCount ||
       receipt.providerExportCounts.len != providerCount:
        err = " provider export identity receipt: provider shape invalid"
        return false
    if receipt.exportInterfaceCids.len != exportCount ||
       receipt.exportProviderRows.len != exportCount ||
       receipt.exportTypedFunctionRows.len != exportCount ||
       receipt.exportProducerSourceRows.len != exportCount ||
       receipt.exportProducerDeclarationRows.len != exportCount ||
       receipt.exportProducerNodeRows.len != exportCount ||
       receipt.exportContractRoleKinds.len != exportCount ||
       receipt.exportUtf8Starts.len != exportCount ||
       receipt.exportUtf8Counts.len != exportCount:
        err = " provider export identity receipt: export shape invalid"
        return false
    err = ""
    return true

@borrows
fn providerExportIdentityReceiptAuthorityValid(
        receipt: ProviderExportIdentityReceipt,
        err: var str): bool =
    let providerCount = receipt.providerSourceArtifactCids.len
    let exportCount = receipt.exportProducerFactCids.len
    var expectedExportStart: int32
    for providerRow in 0..<providerCount:
        if providerExportIdentityReceiptCidZero(
               receipt.providerSourceArtifactCids[providerRow]) ||
           providerExportIdentityReceiptCidZero(
               receipt.providerCompileReceiptCids[providerRow]) ||
           providerExportIdentityReceiptCidZero(
               receipt.providerObjectBytesCids[providerRow]):
            err = " provider export identity receipt: zero provider cid"
            return false
        let start = arenamod.ArenaArrayInt32Get(
            receipt.arena, receipt.providerExportStarts, providerRow)
        let count = arenamod.ArenaArrayInt32Get(
            receipt.arena, receipt.providerExportCounts, providerRow)
        if start != expectedExportStart || count <= 0 ||
           count > ProviderExportContractRoleMax ||
           start > exportCount - count:
            err = " provider export identity receipt: provider csr invalid"
            return false
        for leftOffset in 0..<count:
            let exportRow = start + leftOffset
            if arenamod.ArenaArrayInt32Get(
                   receipt.arena, receipt.exportProviderRows,
                   exportRow) != providerRow:
                err = " provider export identity receipt: cross-provider export"
                return false
            let role = arenamod.ArenaArrayInt32Get(
                receipt.arena, receipt.exportContractRoleKinds, exportRow)
            if role <= 0 || role > ProviderExportContractRoleMax:
                err = " provider export identity receipt: contract role invalid"
                return false
            for rightOffset in leftOffset + 1..<count:
                if arenamod.ArenaArrayInt32Get(
                       receipt.arena, receipt.exportContractRoleKinds,
                       start + rightOffset) == role:
                    err = " provider export identity receipt: duplicate provider role"
                    return false
        expectedExportStart = expectedExportStart + count
    if expectedExportStart != exportCount:
        err = " provider export identity receipt: provider csr incomplete"
        return false

    var expectedUtf8Start: int32
    for exportRow in 0..<exportCount:
        if arenamod.ArenaArrayInt32Get(
               receipt.arena, receipt.exportTypedFunctionRows,
               exportRow) < 0 ||
           arenamod.ArenaArrayInt32Get(
               receipt.arena, receipt.exportProducerSourceRows,
               exportRow) < 0 ||
           arenamod.ArenaArrayInt32Get(
               receipt.arena, receipt.exportProducerDeclarationRows,
               exportRow) < 0 ||
           arenamod.ArenaArrayInt32Get(
               receipt.arena, receipt.exportProducerNodeRows,
               exportRow) < 0:
            err = " provider export identity receipt: producer row invalid"
            return false
        if providerExportIdentityReceiptCidZero(
               receipt.exportProducerFactCids[exportRow]) ||
           providerExportIdentityReceiptCidZero(
               receipt.exportInterfaceCids[exportRow]):
            err = " provider export identity receipt: zero export cid"
            return false
        let utf8Start = arenamod.ArenaArrayInt32Get(
            receipt.arena, receipt.exportUtf8Starts, exportRow)
        let utf8Count = arenamod.ArenaArrayInt32Get(
            receipt.arena, receipt.exportUtf8Counts, exportRow)
        if utf8Start != expectedUtf8Start ||
           !providerExportIdentityReceiptUtf8RangeValid(
               receipt, utf8Start, utf8Count):
            err = " provider export identity receipt: utf8 csr invalid"
            return false
        expectedUtf8Start = expectedUtf8Start + utf8Count
    if expectedUtf8Start != receipt.exportUtf8Bytes.len:
        err = " provider export identity receipt: utf8 csr incomplete"
        return false
    err = ""
    return true

@borrows
fn providerExportIdentityReceiptAppendBody(
        receipt: ProviderExportIdentityReceipt,
        buf: var layout.ByteBuf) =
    let providerCount = receipt.providerSourceArtifactCids.len
    let exportCount = receipt.exportProducerFactCids.len
    providerExportIdentityReceiptAppendU32(
        buf, ProviderExportIdentityReceiptMagic)
    providerExportIdentityReceiptAppendU32(buf, receipt.schemaVersion)
    providerExportIdentityReceiptAppendU32(buf, providerCount)
    providerExportIdentityReceiptAppendU32(buf, exportCount)
    providerExportIdentityReceiptAppendU32(
        buf, receipt.exportUtf8Bytes.len)
    for providerRow in 0..<providerCount:
        layout.ByteBufAppendFixed32(
            buf, receipt.providerSourceArtifactCids[providerRow])
        layout.ByteBufAppendFixed32(
            buf, receipt.providerCompileReceiptCids[providerRow])
        layout.ByteBufAppendFixed32(
            buf, receipt.providerObjectBytesCids[providerRow])
        providerExportIdentityReceiptAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                receipt.arena, receipt.providerExportStarts, providerRow))
        providerExportIdentityReceiptAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                receipt.arena, receipt.providerExportCounts, providerRow))
    for exportRow in 0..<exportCount:
        providerExportIdentityReceiptAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                receipt.arena, receipt.exportProviderRows, exportRow))
        providerExportIdentityReceiptAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                receipt.arena, receipt.exportTypedFunctionRows, exportRow))
        providerExportIdentityReceiptAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                receipt.arena, receipt.exportProducerSourceRows, exportRow))
        providerExportIdentityReceiptAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                receipt.arena, receipt.exportProducerDeclarationRows,
                exportRow))
        providerExportIdentityReceiptAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                receipt.arena, receipt.exportProducerNodeRows, exportRow))
        layout.ByteBufAppendFixed32(
            buf, receipt.exportProducerFactCids[exportRow])
        layout.ByteBufAppendFixed32(
            buf, receipt.exportInterfaceCids[exportRow])
        providerExportIdentityReceiptAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                receipt.arena, receipt.exportContractRoleKinds, exportRow))
        providerExportIdentityReceiptAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                receipt.arena, receipt.exportUtf8Starts, exportRow))
        providerExportIdentityReceiptAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                receipt.arena, receipt.exportUtf8Counts, exportRow))
    for byteIndex in 0..<receipt.exportUtf8Bytes.len:
        layout.ByteBufAppendByte(
            buf, arenamod.ArenaArrayU8Get(
                receipt.arena, receipt.exportUtf8Bytes, byteIndex))

@borrows
fn ProviderExportIdentityReceiptComputeCid(
        receipt: ProviderExportIdentityReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(512)
    providerExportIdentityReceiptAppendBody(receipt, buf)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn ProviderExportIdentityReceiptSealInto(
        receipt: var ProviderExportIdentityReceipt,
        err: var str): bool =
    if receipt.sealed || receipt.terminalStorageReleased:
        err = " provider export identity receipt: seal state invalid"
        return false
    if !providerExportIdentityReceiptShapeValid(receipt, err) ||
       !providerExportIdentityReceiptAuthorityValid(receipt, err):
        return false
    receipt.receiptCid = ProviderExportIdentityReceiptComputeCid(receipt)
    if providerExportIdentityReceiptCidZero(receipt.receiptCid):
        err = " provider export identity receipt: computed zero cid"
        return false
    receipt.sealed = true
    err = ""
    return true

@borrows
fn ProviderExportIdentityReceiptStrictValidateInto(
        receipt: ProviderExportIdentityReceipt,
        err: var str): bool =
    if !receipt.sealed || receipt.terminalStorageReleased:
        err = " provider export identity receipt: unsealed or released"
        return false
    if !providerExportIdentityReceiptShapeValid(receipt, err) ||
       !providerExportIdentityReceiptAuthorityValid(receipt, err):
        return false
    if providerExportIdentityReceiptCidZero(receipt.receiptCid) ||
       !layout.FixedBytes32Equal(
           receipt.receiptCid,
           ProviderExportIdentityReceiptComputeCid(receipt)):
        err = " provider export identity receipt: receipt cid mismatch"
        return false
    err = ""
    return true

@borrows
fn ProviderExportIdentityReceiptEncodeStrictInto(
        receipt: ProviderExportIdentityReceipt,
        out: var rawbytes.Bytes,
        err: var str): bool =
    if rawbytes.BytesLen(out) != 0:
        err = " provider export identity receipt: encode output not empty"
        return false
    if !ProviderExportIdentityReceiptStrictValidateInto(receipt, err):
        return false
    var buf = layout.ByteBufInit(512)
    providerExportIdentityReceiptAppendBody(receipt, buf)
    layout.ByteBufAppendFixed32(buf, receipt.receiptCid)
    out = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    err = ""
    return true

@borrows
fn providerExportIdentityReceiptReadU32(
        data: rawbytes.Bytes,
        cursor: var int32,
        out: var int32): bool =
    if cursor < 0 || cursor > rawbytes.BytesLen(data) - 4:
        return false
    out = (rawbytes.BytesGet(data, cursor) << 24) |
          (rawbytes.BytesGet(data, cursor + 1) << 16) |
          (rawbytes.BytesGet(data, cursor + 2) << 8) |
          rawbytes.BytesGet(data, cursor + 3)
    cursor = cursor + 4
    return out >= 0

@borrows
fn providerExportIdentityReceiptReadCid(
        data: rawbytes.Bytes,
        cursor: var int32,
        out: var layout.FixedBytes32): bool =
    if cursor < 0 || cursor > rawbytes.BytesLen(data) - 32:
        return false
    for index in 0..<32:
        out.data[index] = uint8(rawbytes.BytesGet(data, cursor + index))
    cursor = cursor + 32
    return true

fn ProviderExportIdentityReceiptMoveInto(
        out: var ProviderExportIdentityReceipt,
        source: var ProviderExportIdentityReceipt,
        err: var str): bool =
    let sourceVersion = source.schemaVersion
    var marker = ProviderExportIdentityReceiptSchemaVersion
    if out.schemaVersion == marker:
        marker = 0
    source.schemaVersion = marker
    let descriptorsAlias = out.schemaVersion == marker
    source.schemaVersion = sourceVersion
    if descriptorsAlias:
        err = " provider export identity receipt: self move"
        return false
    if !ProviderExportIdentityReceiptStorageReleased(out):
        err = " provider export identity receipt: move output owns storage"
        return false
    if !ProviderExportIdentityReceiptStrictValidateInto(source, err):
        return false
    out = source
    source = ProviderExportIdentityReceipt()
    if !ProviderExportIdentityReceiptStorageReleased(source):
        panic(" provider export identity receipt: move source retained storage")
    err = ""
    return true

fn ProviderExportIdentityReceiptDecodeStrictInto(
        data: rawbytes.Bytes,
        out: var ProviderExportIdentityReceipt,
        err: var str): bool =
    if rawbytes.BytesLen(data) <
       providerExportIdentityReceiptHeaderBytes +
       providerExportIdentityReceiptTrailerBytes:
        err = " provider export identity receipt: binary truncated"
        return false
    var cursor: int32
    var magic: int32
    var version: int32
    var providerCount: int32
    var exportCount: int32
    var utf8ByteCount: int32
    if !providerExportIdentityReceiptReadU32(data, cursor, magic) ||
       !providerExportIdentityReceiptReadU32(data, cursor, version) ||
       !providerExportIdentityReceiptReadU32(data, cursor, providerCount) ||
       !providerExportIdentityReceiptReadU32(data, cursor, exportCount) ||
       !providerExportIdentityReceiptReadU32(data, cursor, utf8ByteCount):
        err = " provider export identity receipt: binary header invalid"
        return false
    if magic != ProviderExportIdentityReceiptMagic ||
       version != ProviderExportIdentityReceiptSchemaVersion:
        err = " provider export identity receipt: magic/version invalid"
        return false
    if providerCount <= 0 || exportCount <= 0 || utf8ByteCount <= 0:
        err = " provider export identity receipt: binary count invalid"
        return false
    let exactBytes = int64(providerExportIdentityReceiptHeaderBytes) +
        int64(providerCount) *
            int64(providerExportIdentityReceiptProviderWireBytes) +
        int64(exportCount) *
            int64(providerExportIdentityReceiptExportWireBytes) +
        int64(utf8ByteCount) +
        int64(providerExportIdentityReceiptTrailerBytes)
    if exactBytes != int64(rawbytes.BytesLen(data)):
        err = " provider export identity receipt: binary size invalid"
        return false

    var next = ProviderExportIdentityReceiptInit(512)
    for providerRow in 0..<providerCount:
        var sourceCid: layout.FixedBytes32
        var compileCid: layout.FixedBytes32
        var objectCid: layout.FixedBytes32
        var exportStart: int32
        var providerExports: int32
        if !providerExportIdentityReceiptReadCid(data, cursor, sourceCid) ||
           !providerExportIdentityReceiptReadCid(data, cursor, compileCid) ||
           !providerExportIdentityReceiptReadCid(data, cursor, objectCid) ||
           !providerExportIdentityReceiptReadU32(data, cursor, exportStart) ||
           !providerExportIdentityReceiptReadU32(
               data, cursor, providerExports):
            ProviderExportIdentityReceiptRelease(next)
            err = " provider export identity receipt: provider row truncated"
            return false
        add(next.providerSourceArtifactCids, sourceCid)
        add(next.providerCompileReceiptCids, compileCid)
        add(next.providerObjectBytesCids, objectCid)
        arenamod.ArenaArrayInt32Add(
            next.arena, next.providerExportStarts, exportStart)
        arenamod.ArenaArrayInt32Add(
            next.arena, next.providerExportCounts, providerExports)
    for exportRow in 0..<exportCount:
        var providerRow: int32
        var typedFunctionRow: int32
        var producerSourceRow: int32
        var producerDeclarationRow: int32
        var producerNodeRow: int32
        var factCid: layout.FixedBytes32
        var interfaceCid: layout.FixedBytes32
        var roleKind: int32
        var utf8Start: int32
        var utf8Count: int32
        if !providerExportIdentityReceiptReadU32(
               data, cursor, providerRow) ||
           !providerExportIdentityReceiptReadU32(
               data, cursor, typedFunctionRow) ||
           !providerExportIdentityReceiptReadU32(
               data, cursor, producerSourceRow) ||
           !providerExportIdentityReceiptReadU32(
               data, cursor, producerDeclarationRow) ||
           !providerExportIdentityReceiptReadU32(
               data, cursor, producerNodeRow) ||
           !providerExportIdentityReceiptReadCid(data, cursor, factCid) ||
           !providerExportIdentityReceiptReadCid(
               data, cursor, interfaceCid) ||
           !providerExportIdentityReceiptReadU32(
               data, cursor, roleKind) ||
           !providerExportIdentityReceiptReadU32(
               data, cursor, utf8Start) ||
           !providerExportIdentityReceiptReadU32(
               data, cursor, utf8Count):
            ProviderExportIdentityReceiptRelease(next)
            err = " provider export identity receipt: export row truncated"
            return false
        arenamod.ArenaArrayInt32Add(
            next.arena, next.exportProviderRows, providerRow)
        arenamod.ArenaArrayInt32Add(
            next.arena, next.exportTypedFunctionRows, typedFunctionRow)
        arenamod.ArenaArrayInt32Add(
            next.arena, next.exportProducerSourceRows, producerSourceRow)
        arenamod.ArenaArrayInt32Add(
            next.arena, next.exportProducerDeclarationRows,
            producerDeclarationRow)
        arenamod.ArenaArrayInt32Add(
            next.arena, next.exportProducerNodeRows, producerNodeRow)
        arenamod.ArenaArrayInt32Add(
            next.arena, next.exportContractRoleKinds, roleKind)
        arenamod.ArenaArrayInt32Add(
            next.arena, next.exportUtf8Starts, utf8Start)
        arenamod.ArenaArrayInt32Add(
            next.arena, next.exportUtf8Counts, utf8Count)
        add(next.exportProducerFactCids, factCid)
        add(next.exportInterfaceCids, interfaceCid)
    if !arenamod.ArenaArrayU8ReserveEmpty(
           next.arena, next.exportUtf8Bytes, utf8ByteCount):
        ProviderExportIdentityReceiptRelease(next)
        err = " provider export identity receipt: utf8 reserve failed"
        return false
    for byteIndex in 0..<utf8ByteCount:
        arenamod.ArenaArrayU8AddReserved(
            next.arena, next.exportUtf8Bytes,
            rawbytes.BytesGet(data, cursor + byteIndex))
    cursor = cursor + utf8ByteCount
    if !providerExportIdentityReceiptReadCid(
           data, cursor, next.receiptCid) ||
       cursor != rawbytes.BytesLen(data):
        ProviderExportIdentityReceiptRelease(next)
        err = " provider export identity receipt: binary trailer invalid"
        return false
    next.sealed = true
    if !ProviderExportIdentityReceiptMoveInto(out, next, err):
        ProviderExportIdentityReceiptRelease(next)
        return false
    return true

@borrows
fn ProviderExportIdentityReceiptRetainedBufferCount(
        receipt: ProviderExportIdentityReceipt): int32 =
    var count: int32
    if receipt.arena.capacityBytes > 0:
        count = count + 1
    if receipt.providerSourceArtifactCids.cap > 0:
        count = count + 1
    if receipt.providerCompileReceiptCids.cap > 0:
        count = count + 1
    if receipt.providerObjectBytesCids.cap > 0:
        count = count + 1
    if receipt.exportProducerFactCids.cap > 0:
        count = count + 1
    if receipt.exportInterfaceCids.cap > 0:
        count = count + 1
    return count

@borrows
fn ProviderExportIdentityReceiptRetainedBytes(
        receipt: ProviderExportIdentityReceipt): int64 =
    return int64(receipt.arena.capacityBytes) +
        int64(receipt.providerSourceArtifactCids.cap) * int64(32) +
        int64(receipt.providerCompileReceiptCids.cap) * int64(32) +
        int64(receipt.providerObjectBytesCids.cap) * int64(32) +
        int64(receipt.exportProducerFactCids.cap) * int64(32) +
        int64(receipt.exportInterfaceCids.cap) * int64(32)

@borrows
fn providerExportIdentityReceiptReleaseOwnerToken(
        receipt: ProviderExportIdentityReceipt,
        retainedBufferCount: int32,
        retainedBytes: int64): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(64)
    providerExportIdentityReceiptAppendU32(
        buf, ProviderExportIdentityReceiptMagic)
    providerExportIdentityReceiptAppendU32(
        buf, ProviderExportIdentityReceiptSchemaVersion)
    layout.ByteBufAppendFixed32(buf, receipt.receiptCid)
    providerExportIdentityReceiptAppendU32(buf, retainedBufferCount)
    providerExportIdentityReceiptAppendU64(buf, retainedBytes)
    let token = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

@borrows
fn ProviderExportIdentityReceiptStorageReleased(
        receipt: ProviderExportIdentityReceipt): bool =
    return receipt.arena.capacityBytes == 0 &&
           receipt.arena.usedBytes == 0 &&
           receipt.providerExportStarts.capacity == 0 &&
           receipt.providerExportCounts.capacity == 0 &&
           receipt.exportProviderRows.capacity == 0 &&
           receipt.exportTypedFunctionRows.capacity == 0 &&
           receipt.exportProducerSourceRows.capacity == 0 &&
           receipt.exportProducerDeclarationRows.capacity == 0 &&
           receipt.exportProducerNodeRows.capacity == 0 &&
           receipt.exportContractRoleKinds.capacity == 0 &&
           receipt.exportUtf8Starts.capacity == 0 &&
           receipt.exportUtf8Counts.capacity == 0 &&
           receipt.exportUtf8Bytes.capacity == 0 &&
           receipt.providerSourceArtifactCids.cap == 0 &&
           receipt.providerCompileReceiptCids.cap == 0 &&
           receipt.providerObjectBytesCids.cap == 0 &&
           receipt.exportProducerFactCids.cap == 0 &&
           receipt.exportInterfaceCids.cap == 0

fn providerExportIdentityReceiptResetArenaColumns(
        receipt: var ProviderExportIdentityReceipt) =
    receipt.providerExportStarts = arenamod.ArenaArrayInt32Init()
    receipt.providerExportCounts = arenamod.ArenaArrayInt32Init()
    receipt.exportProviderRows = arenamod.ArenaArrayInt32Init()
    receipt.exportTypedFunctionRows = arenamod.ArenaArrayInt32Init()
    receipt.exportProducerSourceRows = arenamod.ArenaArrayInt32Init()
    receipt.exportProducerDeclarationRows = arenamod.ArenaArrayInt32Init()
    receipt.exportProducerNodeRows = arenamod.ArenaArrayInt32Init()
    receipt.exportContractRoleKinds = arenamod.ArenaArrayInt32Init()
    receipt.exportUtf8Starts = arenamod.ArenaArrayInt32Init()
    receipt.exportUtf8Counts = arenamod.ArenaArrayInt32Init()
    receipt.exportUtf8Bytes = arenamod.ArenaArrayU8Init()

fn ProviderExportIdentityReceiptReleaseWithReceipt(
        receipt: var ProviderExportIdentityReceipt,
        released: var ProviderExportIdentityReleaseReceipt): bool =
    if receipt.schemaVersion !=
           ProviderExportIdentityReceiptSchemaVersion ||
       receipt.terminalStorageReleased ||
       receipt.terminalReleaseReceiptConsumed ||
       !providerExportIdentityReceiptCidZero(
           receipt.terminalReleaseOwnerToken) ||
       receipt.terminalReleasedOwnedStorageColumnCount != 0 ||
       receipt.terminalReleasedBufferCount != 0 ||
       receipt.terminalReleasedBytes != int64(0):
        return false
    let retainedBufferCount =
        ProviderExportIdentityReceiptRetainedBufferCount(receipt)
    let retainedBytes = ProviderExportIdentityReceiptRetainedBytes(receipt)
    let ownerToken = providerExportIdentityReceiptReleaseOwnerToken(
        receipt, retainedBufferCount, retainedBytes)
    if providerExportIdentityReceiptCidZero(ownerToken):
        return false

    arenamod.ArenaRelease(receipt.arena)
    seqs.freeSeq(receipt.providerSourceArtifactCids)
    seqs.freeSeq(receipt.providerCompileReceiptCids)
    seqs.freeSeq(receipt.providerObjectBytesCids)
    seqs.freeSeq(receipt.exportProducerFactCids)
    seqs.freeSeq(receipt.exportInterfaceCids)
    providerExportIdentityReceiptResetArenaColumns(receipt)
    receipt.schemaVersion = 0
    receipt.sealed = false
    receipt.receiptCid = layout.FixedBytes32()

    receipt.terminalReleaseOwnerToken = ownerToken
    receipt.terminalReleasedOwnedStorageColumnCount =
        ProviderExportIdentityReceiptOwnedStorageColumnCount
    receipt.terminalReleasedBufferCount = retainedBufferCount
    receipt.terminalReleasedBytes = retainedBytes
    receipt.terminalStorageReleased =
        ProviderExportIdentityReceiptStorageReleased(receipt)
    receipt.terminalReleaseReceiptConsumed = false

    released.ownerToken = ownerToken
    released.releasedOwnedStorageColumnCount =
        ProviderExportIdentityReceiptOwnedStorageColumnCount
    released.releasedBufferCount = retainedBufferCount
    released.releasedBytes = retainedBytes
    released.storageReleased = receipt.terminalStorageReleased
    return released.storageReleased

fn ProviderExportIdentityReceiptConsumeReleaseReceipt(
        receipt: var ProviderExportIdentityReceipt,
        released: ProviderExportIdentityReleaseReceipt): bool =
    if !receipt.terminalStorageReleased ||
       receipt.terminalReleaseReceiptConsumed ||
       !released.storageReleased ||
       providerExportIdentityReceiptCidZero(released.ownerToken) ||
       !layout.FixedBytes32Equal(
           released.ownerToken, receipt.terminalReleaseOwnerToken) ||
       released.releasedOwnedStorageColumnCount !=
           receipt.terminalReleasedOwnedStorageColumnCount ||
       released.releasedBufferCount !=
           receipt.terminalReleasedBufferCount ||
       released.releasedBytes != receipt.terminalReleasedBytes:
        return false
    receipt.terminalReleaseReceiptConsumed = true
    return true

fn ProviderExportIdentityReceiptRelease(
        receipt: var ProviderExportIdentityReceipt) =
    var released: ProviderExportIdentityReleaseReceipt
    if !ProviderExportIdentityReceiptReleaseWithReceipt(receipt, released) ||
       !ProviderExportIdentityReceiptConsumeReleaseReceipt(
           receipt, released):
        panic(" provider export identity receipt: cleanup release incomplete")
