import std/rawbytes
import std/strings
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/backend/debug_facts as debug
import cheng/core/backend/macho_object_writer as macho
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/backend/debug_emission_plan_evidence as planevidence
import cheng/core/backend/debug_relocatable_object_evidence as objectevidence
import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_access as bodyaccess

const
    DebugEmissionMachOTextSectionIndex = 1

type
    DebugEmissionRow =
        debugOpId: int32 = -1
        debugSyntheticKind: int32
        typedNodeId: int32 = -1
        typedIrNodeIndex: int32 = -1
        originParserNodeId: int32 = -1
        typedSyntheticOriginKind: int32
        typedSpanAuthorityKind: int32
        functionId: int32
        functionDeclId: int32
        functionSymbolId: int32
        functionDeclKeyCid: layout.FixedBytes32
        functionSymbolCid: layout.FixedBytes32
        sourceId: int32 = -1
        spanId: int32 = -1
        siteKind: int32
        siteIndex: int32 = -1
        machineOwnerKind: int32
        machineOwnerOrdinal: int32 = -1
        actionConsumerOrdinal: int32 = -1
        sectionIndex: int32
        textSectionRelativeByteStart: int32
        objectFileByteStart: int32
        byteLength: int32
        bytesCid: layout.FixedBytes32

    DebugEmissionReceipt =
        valid: bool
        sourceVersion: int64
        packageId: str
        semanticSnapshotCid: layout.FixedBytes32
        worldHeadCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        csgRootCid: layout.FixedBytes32
        debugProjectionCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        declarationIdentityCid: layout.FixedBytes32
        objectCid: layout.FixedBytes32
        debugMapCid: layout.FixedBytes32
        functionId: int32 = -1
        functionDeclId: int32 = -1
        functionSymbolId: int32 = -1
        functionDeclKeyCid: layout.FixedBytes32
        functionSymbolCid: layout.FixedBytes32
        symbolName: str
        textSectionFileOffset: int32
        objectByteLength: int32
        symbolTextByteStart: int32
        symbolByteLength: int32
        bodyIrSha256: str
        debugProvenanceSha256: str
        regallocReceiptSha256: str
        machineFragmentRootSha256: str
        debugMachineFragmentRootSha256: str
        rows: DebugEmissionRow[]

    # Whole-object receipt consumed by the production emit-obj path.  It is
    # derived after final object bytes exist and covers every debug-bound
    # function emitted by either canonical backend.
    DebugObjectEmissionFunctionRow =
        functionId: int32
        functionDeclId: int32
        functionSymbolId: int32
        functionDeclKeyCid: layout.FixedBytes32
        functionSymbolCid: layout.FixedBytes32
        objectSymbolTableIndex: int32 = -1
        objectSectionIndex: int32 = -1
        objectFileByteStart: int32 = -1
        symbolByteStart: int32
        symbolByteLength: int32
        symbolBytesCid: layout.FixedBytes32
        bodyIrSha256: str
        frozenPlanSha256: str
        regallocPlanSha256: str
        emissionLedgerSha256: str
        actionSemanticRootSha256: str
        actionBindingRootSha256: str
        machineFragmentRootSha256: str
        abiIngressRootSha256: str
        debugMachineFragmentRootSha256: str
        rowStart: int32
        rowCount: int32

    DebugObjectEmissionReceipt =
        valid: bool
        backendKind: str
        sourceVersion: int64
        packageId: str
        bindingReceiptCid: layout.FixedBytes32
        semanticSnapshotCid: layout.FixedBytes32
        worldHeadCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        csgRootCid: layout.FixedBytes32
        validationReceiptCid: layout.FixedBytes32
        debugProjectionCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        declarationIdentityCid: layout.FixedBytes32
        objectCid: layout.FixedBytes32
        objectFormatKind: int32
        objectMachineKind: int32
        objectStructureCid: layout.FixedBytes32
        textSectionIndex: int32 = -1
        textSectionFileOffset: int32
        textSectionByteLength: int32
        symbolTableFileOffset: int32 = -1
        symbolCount: int32
        relocationTableFileOffset: int32 = -1
        relocationCount: int32
        objectByteLength: int32
        functions: DebugObjectEmissionFunctionRow[]
        rows: DebugEmissionRow[]
        debugMapCid: layout.FixedBytes32

fn debugEmissionAppendI32(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn debugEmissionAppendI64(buf: var layout.ByteBuf, value: int64) =
    let raw = UInt64(value)
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(56)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32(raw & UInt64(255)))

@borrows
fn debugEmissionAppendText(buf: var layout.ByteBuf, value: str) =
    debugEmissionAppendI32(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

fn debugEmissionAppendCid(buf: var layout.ByteBuf,
                          value: layout.FixedBytes32) =
    layout.ByteBufAppendFixed32(buf, value)

@borrows
fn debugEmissionMapCid(receipt: DebugEmissionReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(512 + receipt.rows.len * 128)
    debugEmissionAppendText(buf, "cheng.debug_emission.snapshot_object_receipt")
    debugEmissionAppendI64(buf, receipt.sourceVersion)
    debugEmissionAppendText(buf, receipt.packageId)
    debugEmissionAppendCid(buf, receipt.semanticSnapshotCid)
    debugEmissionAppendCid(buf, receipt.worldHeadCid)
    debugEmissionAppendCid(buf, receipt.compilerCid)
    debugEmissionAppendCid(buf, receipt.sourceBundleCid)
    debugEmissionAppendCid(buf, receipt.csgRootCid)
    debugEmissionAppendCid(buf, receipt.debugProjectionCid)
    debugEmissionAppendCid(buf, receipt.declarationTableCid)
    debugEmissionAppendCid(buf, receipt.declarationIdentityCid)
    debugEmissionAppendCid(buf, receipt.objectCid)
    debugEmissionAppendI32(buf, receipt.functionId)
    debugEmissionAppendI32(buf, receipt.functionDeclId)
    debugEmissionAppendI32(buf, receipt.functionSymbolId)
    debugEmissionAppendCid(buf, receipt.functionDeclKeyCid)
    debugEmissionAppendCid(buf, receipt.functionSymbolCid)
    debugEmissionAppendText(buf, receipt.symbolName)
    debugEmissionAppendI32(buf, receipt.textSectionFileOffset)
    debugEmissionAppendI32(buf, receipt.objectByteLength)
    debugEmissionAppendI32(buf, receipt.symbolTextByteStart)
    debugEmissionAppendI32(buf, receipt.symbolByteLength)
    debugEmissionAppendText(buf, receipt.bodyIrSha256)
    debugEmissionAppendText(buf, receipt.debugProvenanceSha256)
    debugEmissionAppendText(buf, receipt.regallocReceiptSha256)
    debugEmissionAppendText(buf, receipt.machineFragmentRootSha256)
    debugEmissionAppendText(buf, receipt.debugMachineFragmentRootSha256)
    debugEmissionAppendI32(buf, receipt.rows.len)
    for index in 0..<receipt.rows.len:
        let row = receipt.rows[index]
        debugEmissionAppendI32(buf, row.debugOpId)
        debugEmissionAppendI32(buf, row.debugSyntheticKind)
        debugEmissionAppendI32(buf, row.typedNodeId)
        debugEmissionAppendI32(buf, row.typedIrNodeIndex)
        debugEmissionAppendI32(buf, row.originParserNodeId)
        debugEmissionAppendI32(buf, row.typedSyntheticOriginKind)
        debugEmissionAppendI32(buf, row.typedSpanAuthorityKind)
        debugEmissionAppendI32(buf, row.functionId)
        debugEmissionAppendI32(buf, row.functionDeclId)
        debugEmissionAppendI32(buf, row.functionSymbolId)
        debugEmissionAppendCid(buf, row.functionDeclKeyCid)
        debugEmissionAppendCid(buf, row.functionSymbolCid)
        debugEmissionAppendI32(buf, row.sourceId)
        debugEmissionAppendI32(buf, row.spanId)
        debugEmissionAppendI32(buf, row.siteKind)
        debugEmissionAppendI32(buf, row.siteIndex)
        debugEmissionAppendI32(buf, row.machineOwnerKind)
        debugEmissionAppendI32(buf, row.machineOwnerOrdinal)
        debugEmissionAppendI32(buf, row.actionConsumerOrdinal)
        debugEmissionAppendI32(buf, row.sectionIndex)
        debugEmissionAppendI32(buf, row.textSectionRelativeByteStart)
        debugEmissionAppendI32(buf, row.objectFileByteStart)
        debugEmissionAppendI32(buf, row.byteLength)
        debugEmissionAppendCid(buf, row.bytesCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn debugEmissionMachineFragmentRoot(
        emission: var emitter.RegallocProductionFunctionEmission): str =
    return emitter.RegallocProductionDebugMachineFragmentRootSha256(
        emission)

fn debugEmissionRegallocReceiptMatches(
        emission: var emitter.RegallocProductionFunctionEmission): bool =
    var plan = emission.plan
    var rebuilt: alloc.RegallocValueEmissionReceipt
    if !alloc.RegallocSinglePassValuePlanReceipt(plan, rebuilt):
        return false
    if !rebuilt.valid || !emission.receipt.valid ||
       rebuilt.symbolName != emission.receipt.symbolName ||
       rebuilt.symbolByteStart != emission.receipt.symbolByteStart ||
       rebuilt.symbolByteLength != emission.receipt.symbolByteLength ||
       rebuilt.symbolBytesSha256 != emission.receipt.symbolBytesSha256 ||
       rebuilt.actionCount != emission.receipt.actionCount ||
       rebuilt.debugProvenanceSha256 !=
           emission.receipt.debugProvenanceSha256 ||
       rebuilt.frozenSemanticSha256 !=
           emission.receipt.frozenSemanticSha256 ||
       rebuilt.actionSemanticRootSha256 !=
           emission.receipt.actionSemanticRootSha256 ||
       rebuilt.actionBindingRootSha256 !=
           emission.receipt.actionBindingRootSha256 ||
       rebuilt.machineFragmentCount !=
           emission.receipt.machineFragmentCount ||
       rebuilt.machineFragmentRootSha256 !=
           emission.receipt.machineFragmentRootSha256 ||
       rebuilt.abiIngressCount != emission.receipt.abiIngressCount ||
       rebuilt.abiIngressRootSha256 !=
           emission.receipt.abiIngressRootSha256 ||
       rebuilt.receiptSha256 != emission.receipt.receiptSha256 ||
       rebuilt.actionEmissions.len !=
           emission.receipt.actionEmissions.len:
        return false
    for index in 0..<rebuilt.actionEmissions.len:
        let left = rebuilt.actionEmissions[index]
        let right = emission.receipt.actionEmissions[index]
        if left.consumerOrdinal != right.consumerOrdinal ||
           left.actionKind != right.actionKind ||
           left.actionPosition != right.actionPosition ||
           left.symbolByteStart != right.symbolByteStart ||
           left.symbolByteLength != right.symbolByteLength ||
           left.emittedByteStart != right.emittedByteStart ||
           left.emittedByteLength != right.emittedByteLength ||
           left.emittedBytesSha256 != right.emittedBytesSha256 ||
           left.bindingKind != right.bindingKind ||
           left.ownerPlanSha256 != right.ownerPlanSha256 ||
           left.emissionOwnerSha256 != right.emissionOwnerSha256 ||
           left.actionSemanticSha256 != right.actionSemanticSha256 ||
           left.bindingSha256 != right.bindingSha256:
            return false
    return true

@borrows
fn debugEmissionOperationFact(
        facts: debug.DebugFactBundle,
        debugOpId: int32,
        rowOut: var debug.DebugOperationFact): bool =
    if debugOpId < 0 || debugOpId >= facts.debugOpCount:
        return false
    let factIndex = facts.functionCount + debugOpId
    if factIndex < 0 || factIndex >= facts.facts.len ||
       facts.facts[factIndex].kind != debug.DebugFactKindOperation:
        return false
    rowOut = facts.facts[factIndex].operationFact
    return rowOut.debugOpId == debugOpId

@borrows
fn debugEmissionReadU32LE(bytes: rawbytes.Bytes,
                          offset: int32): int32 =
    if offset < 0 || offset > rawbytes.BytesLen(bytes) - 4:
        return -1
    return rawbytes.BytesGet(bytes, offset) |
           (rawbytes.BytesGet(bytes, offset + 1) << 8) |
           (rawbytes.BytesGet(bytes, offset + 2) << 16) |
           (rawbytes.BytesGet(bytes, offset + 3) << 24)

@borrows
fn debugEmissionAsciiAt(bytes: rawbytes.Bytes,
                        offset: int32,
                        text: str): bool =
    if offset < 0 || offset > rawbytes.BytesLen(bytes) - text.len:
        return false
    for index in 0..<text.len:
        if rawbytes.BytesGet(bytes, offset + index) !=
           (Int32(text[index]) & 255):
            return false
    return true

@borrows
fn debugEmissionMachOTextSectionOffset(
        objectBytes: rawbytes.Bytes): int32 =
    # Relocatable arm64 Mach-O: header, one LC_SEGMENT_64, then first section.
    if rawbytes.BytesLen(objectBytes) < 208 ||
       debugEmissionReadU32LE(objectBytes, 0) != -17958193 ||
       debugEmissionReadU32LE(objectBytes, 12) != 1 ||
       debugEmissionReadU32LE(objectBytes, 32) != int32(0x19) ||
       debugEmissionReadU32LE(objectBytes, 96) <= 0 ||
       !debugEmissionAsciiAt(objectBytes, 104, "__text") ||
       !debugEmissionAsciiAt(objectBytes, 120, "__TEXT"):
        return -1
    return debugEmissionReadU32LE(objectBytes, 152)

@borrows
fn debugEmissionMachOTextSectionByteLength(
        objectBytes: rawbytes.Bytes): int32 =
    if debugEmissionMachOTextSectionOffset(objectBytes) < 0 ||
       debugEmissionReadU32LE(objectBytes, 148) != 0:
        return -1
    return debugEmissionReadU32LE(objectBytes, 144)

fn debugEmissionFragmentMatchesBodyAndRecipe(
        bodyIR: var coreir.BodyIR,
        emission: var emitter.RegallocProductionFunctionEmission,
        fragmentIndex: int32): bool =
    if fragmentIndex < 0 ||
       fragmentIndex >= emission.debugFragmentOpIds.len ||
       fragmentIndex >= emission.recipes.machineFragments.len:
        return false
    let machine = emission.recipes.machineFragments[fragmentIndex]
    if emission.debugFragmentSiteKinds[fragmentIndex] !=
           machine.siteKind ||
       emission.debugFragmentSiteIndexes[fragmentIndex] !=
           machine.siteIndex ||
       emission.debugFragmentMachineOwnerKinds[fragmentIndex] !=
           machine.ownerKind ||
       emission.debugFragmentMachineOwnerOrdinals[fragmentIndex] !=
           machine.ownerOrdinal ||
       emission.debugFragmentActionConsumerOrdinals[fragmentIndex] !=
           machine.actionConsumerOrdinal ||
       machine.wordStart < 0 || machine.wordCount <= 0 ||
       machine.wordStart >
           emission.recipes.functionWords.len - machine.wordCount ||
       emission.debugFragmentTextByteStarts[fragmentIndex] !=
           emission.receipt.symbolByteStart + machine.wordStart * 4 ||
       emission.debugFragmentByteLengths[fragmentIndex] !=
           machine.wordCount * 4:
        return false
    var bodyDebugOpId: int32 = -1
    var bodySyntheticKind: int32
    if machine.siteKind == bodyaccess.BodyIrAccessSiteOp:
        if !coreir.BodyIRDebugOpProvenanceAt(
               bodyIR, machine.siteIndex,
               bodyDebugOpId, bodySyntheticKind):
            return false
    elif machine.siteKind == bodyaccess.BodyIrAccessSiteTerm:
        if !coreir.BodyIRDebugTermProvenanceAt(
               bodyIR, machine.siteIndex,
               bodyDebugOpId, bodySyntheticKind):
            return false
    elif machine.siteKind == bodyaccess.BodyIrAccessSiteEntry:
        bodySyntheticKind = coreir.BodyDebugSyntheticAbi
    else:
        return false
    return emission.debugFragmentOpIds[fragmentIndex] ==
               bodyDebugOpId &&
           emission.debugFragmentSyntheticKinds[fragmentIndex] ==
               bodySyntheticKind

@borrows
fn debugEmissionReceiptBuildExact(
        facts: debug.DebugFactBundle,
        bodyIR: var coreir.BodyIR,
        emission: var emitter.RegallocProductionFunctionEmission,
        writer: macho.MachOObjectWriterResult,
        objectBytes: rawbytes.Bytes,
        out: var DebugEmissionReceipt,
        err: var str): bool =
    out = DebugEmissionReceipt()
    err = ""
    if !debug.DebugFactBundleStrictValidateInto(facts, err):
        return false
    let functionId = emission.debugFunctionId
    let debugProvenanceSha256 =
        alloc.RegallocSinglePassDebugProvenanceSha256(bodyIR)
    if functionId < 0 || functionId >= facts.functionCount ||
       !bodyIR.debugProvenanceRequired ||
       bodyIR.debugFunctionId != functionId ||
       debugProvenanceSha256 !=
           emission.plan.debugProvenanceSha256 ||
       debugProvenanceSha256 !=
           emission.receipt.debugProvenanceSha256 ||
       emission.bodyIrSha256 != emission.plan.bodyIrIngressSha256 ||
       !emitter.RegallocProductionEmissionPublishedPayloadExact(
           emission) ||
       !emission.debugProvenanceBound ||
       emission.debugFragmentOpIds.len <= 0 ||
       !debugEmissionRegallocReceiptMatches(emission):
        err = " debug emission: invalid semantic or regalloc input"
        return false
    let functionFact = facts.facts[functionId]
    if functionFact.kind != debug.DebugFactKindFunction ||
       functionFact.functionFact.functionId != functionId:
        err = " debug emission: FunctionId/DeclId/SymbolId projection mismatch"
        return false
    let objectCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(objectBytes))
    let textSectionFileOffset =
        debugEmissionMachOTextSectionOffset(objectBytes)
    let textSectionByteLength =
        debugEmissionMachOTextSectionByteLength(objectBytes)
    if writer.bytesWritten != rawbytes.BytesLen(objectBytes) ||
       textSectionFileOffset <= 0 ||
       textSectionByteLength < 0 ||
       emission.receipt.symbolByteStart < 0 ||
       emission.receipt.symbolByteLength <= 0 ||
       emission.receipt.symbolByteStart >
           textSectionByteLength - emission.receipt.symbolByteLength ||
       debugEmissionMachineFragmentRoot(emission) !=
           emission.debugMachineFragmentRootSha256:
        err = " debug emission: object or fragment receipt mismatch"
        return false
    out.sourceVersion = facts.sourceVersion
    out.packageId = facts.packageId
    out.semanticSnapshotCid = facts.semanticSnapshotCid
    out.worldHeadCid = facts.worldHeadCid
    out.compilerCid = facts.compilerCid
    out.sourceBundleCid = facts.sourceBundleCid
    out.csgRootCid = facts.csgRootCid
    out.debugProjectionCid = facts.projectionCid
    out.declarationTableCid = facts.declarationTableCid
    out.declarationIdentityCid = facts.declarationIdentityCid
    out.objectCid = objectCid
    out.functionId = functionId
    out.functionDeclId = functionFact.functionFact.declId
    out.functionSymbolId = functionFact.functionFact.symbolId
    out.functionDeclKeyCid = functionFact.functionFact.declKeyCid
    out.functionSymbolCid = functionFact.functionFact.symbolCid
    out.symbolName = emission.receipt.symbolName
    out.textSectionFileOffset = textSectionFileOffset
    out.objectByteLength = rawbytes.BytesLen(objectBytes)
    out.symbolTextByteStart = emission.receipt.symbolByteStart
    out.symbolByteLength = emission.receipt.symbolByteLength
    out.bodyIrSha256 = emission.bodyIrSha256
    out.debugProvenanceSha256 = debugProvenanceSha256
    out.regallocReceiptSha256 = emission.receipt.receiptSha256
    out.machineFragmentRootSha256 =
        emission.receipt.machineFragmentRootSha256
    out.debugMachineFragmentRootSha256 =
        emission.debugMachineFragmentRootSha256
    for index in 0..<emission.debugFragmentOpIds.len:
        if !debugEmissionFragmentMatchesBodyAndRecipe(
               bodyIR, emission, index) ||
           emission.debugFragmentByteLengths[index] <= 0 ||
           emission.debugFragmentTextByteStarts[index] < 0 ||
           textSectionFileOffset >
               2147483647 -
                   emission.debugFragmentTextByteStarts[index]:
            err = " debug emission: invalid fragment range"
            return false
        var row: DebugEmissionRow
        row.debugOpId = emission.debugFragmentOpIds[index]
        row.debugSyntheticKind =
            emission.debugFragmentSyntheticKinds[index]
        row.functionId = functionId
        row.functionDeclId = out.functionDeclId
        row.functionSymbolId = out.functionSymbolId
        row.functionDeclKeyCid = out.functionDeclKeyCid
        row.functionSymbolCid = out.functionSymbolCid
        row.siteKind = emission.debugFragmentSiteKinds[index]
        row.siteIndex = emission.debugFragmentSiteIndexes[index]
        row.machineOwnerKind =
            emission.debugFragmentMachineOwnerKinds[index]
        row.machineOwnerOrdinal =
            emission.debugFragmentMachineOwnerOrdinals[index]
        row.actionConsumerOrdinal =
            emission.debugFragmentActionConsumerOrdinals[index]
        row.sectionIndex = DebugEmissionMachOTextSectionIndex
        row.textSectionRelativeByteStart =
            emission.debugFragmentTextByteStarts[index]
        row.objectFileByteStart = textSectionFileOffset +
                                  row.textSectionRelativeByteStart
        row.byteLength = emission.debugFragmentByteLengths[index]
        if row.textSectionRelativeByteStart <
               emission.receipt.symbolByteStart ||
           row.textSectionRelativeByteStart >
               emission.receipt.symbolByteStart +
               emission.receipt.symbolByteLength - row.byteLength ||
           row.objectFileByteStart < 0 ||
           row.objectFileByteStart >
               rawbytes.BytesLen(objectBytes) - row.byteLength:
            err = " debug emission: object range outside emitted bytes"
            return false
        let slice = rawbytes.BytesSliceView(
            objectBytes, row.objectFileByteStart, row.byteLength)
        row.bytesCid = hash256.Sha256Fixed(
            layout.ByteSpanFromBytes(slice))
        if layout.FixedBytes32Hex(row.bytesCid) !=
               emission.debugFragmentBytesSha256s[index]:
            err = " debug emission: fragment bytes mismatch"
            return false
        if row.debugOpId >= 0:
            var operation: debug.DebugOperationFact
            if !debugEmissionOperationFact(facts, row.debugOpId, operation) ||
               operation.functionId != functionId ||
               operation.functionDeclId != row.functionDeclId ||
               operation.functionSymbolId != row.functionSymbolId ||
               !layout.FixedBytes32Equal(
                   operation.functionDeclKeyCid,
                   row.functionDeclKeyCid) ||
               !layout.FixedBytes32Equal(
                   operation.functionSymbolCid,
                   row.functionSymbolCid):
                err = " debug emission: DebugOpId/function declaration join mismatch"
                return false
            row.typedNodeId = operation.typedNodeId
            row.typedIrNodeIndex = operation.typedIrNodeIndex
            row.originParserNodeId = operation.originParserNodeId
            row.typedSyntheticOriginKind =
                operation.syntheticOriginKind
            row.typedSpanAuthorityKind = operation.spanAuthorityKind
            row.sourceId = operation.sourceId
            row.spanId = operation.spanId
        elif row.debugSyntheticKind < coreir.BodyDebugSyntheticCleanup ||
             row.debugSyntheticKind > coreir.BodyDebugSyntheticRuntime:
            err = " debug emission: unproved synthetic fragment"
            return false
        add(out.rows, row)
    out.debugMapCid = debugEmissionMapCid(out)
    out.valid = true
    return true

fn DebugEmissionReceiptBuildInto(
        facts: debug.DebugFactBundle,
        bodyIR: var coreir.BodyIR,
        emission: var emitter.RegallocProductionFunctionEmission,
        writer: macho.MachOObjectWriterResult,
        objectBytes: rawbytes.Bytes,
        out: var DebugEmissionReceipt,
        err: var str): bool =
    return debugEmissionReceiptBuildExact(
        facts, bodyIR, emission, writer, objectBytes, out, err)

@borrows
fn debugEmissionRowsEqual(left: DebugEmissionRow[],
                          right: DebugEmissionRow[]): bool =
    if left.len != right.len:
        return false
    for index in 0..<left.len:
        if left[index].debugOpId != right[index].debugOpId ||
           left[index].debugSyntheticKind != right[index].debugSyntheticKind ||
           left[index].typedNodeId != right[index].typedNodeId ||
           left[index].typedIrNodeIndex != right[index].typedIrNodeIndex ||
           left[index].originParserNodeId != right[index].originParserNodeId ||
           left[index].typedSyntheticOriginKind !=
               right[index].typedSyntheticOriginKind ||
           left[index].typedSpanAuthorityKind !=
               right[index].typedSpanAuthorityKind ||
           left[index].functionId != right[index].functionId ||
           left[index].functionDeclId != right[index].functionDeclId ||
           left[index].functionSymbolId != right[index].functionSymbolId ||
           !layout.FixedBytes32Equal(
               left[index].functionDeclKeyCid,
               right[index].functionDeclKeyCid) ||
           !layout.FixedBytes32Equal(
               left[index].functionSymbolCid,
               right[index].functionSymbolCid) ||
           left[index].sourceId != right[index].sourceId ||
           left[index].spanId != right[index].spanId ||
           left[index].siteKind != right[index].siteKind ||
           left[index].siteIndex != right[index].siteIndex ||
           left[index].machineOwnerKind != right[index].machineOwnerKind ||
           left[index].machineOwnerOrdinal != right[index].machineOwnerOrdinal ||
           left[index].actionConsumerOrdinal !=
               right[index].actionConsumerOrdinal ||
           left[index].sectionIndex != right[index].sectionIndex ||
           left[index].textSectionRelativeByteStart !=
               right[index].textSectionRelativeByteStart ||
           left[index].objectFileByteStart !=
               right[index].objectFileByteStart ||
           left[index].byteLength != right[index].byteLength ||
           !layout.FixedBytes32Equal(left[index].bytesCid,
                                     right[index].bytesCid):
            return false
    return true

fn DebugEmissionReceiptStrictValidateAgainstObjectInto(
        receipt: DebugEmissionReceipt,
        facts: debug.DebugFactBundle,
        bodyIR: var coreir.BodyIR,
        emission: var emitter.RegallocProductionFunctionEmission,
        writer: macho.MachOObjectWriterResult,
        objectBytes: rawbytes.Bytes,
        err: var str): bool =
    var rebuilt: DebugEmissionReceipt
    if !debugEmissionReceiptBuildExact(
           facts, bodyIR, emission, writer,
           objectBytes, rebuilt, err):
        return false
    if !receipt.valid || receipt.sourceVersion != rebuilt.sourceVersion ||
       receipt.packageId != rebuilt.packageId ||
       receipt.functionId != rebuilt.functionId ||
       receipt.functionDeclId != rebuilt.functionDeclId ||
       receipt.functionSymbolId != rebuilt.functionSymbolId ||
       receipt.symbolName != rebuilt.symbolName ||
       receipt.textSectionFileOffset != rebuilt.textSectionFileOffset ||
       receipt.objectByteLength != rebuilt.objectByteLength ||
       receipt.symbolTextByteStart != rebuilt.symbolTextByteStart ||
       receipt.symbolByteLength != rebuilt.symbolByteLength ||
       receipt.bodyIrSha256 != rebuilt.bodyIrSha256 ||
       receipt.debugProvenanceSha256 !=
           rebuilt.debugProvenanceSha256 ||
       receipt.regallocReceiptSha256 != rebuilt.regallocReceiptSha256 ||
       receipt.machineFragmentRootSha256 !=
           rebuilt.machineFragmentRootSha256 ||
       receipt.debugMachineFragmentRootSha256 !=
           rebuilt.debugMachineFragmentRootSha256 ||
       !layout.FixedBytes32Equal(receipt.semanticSnapshotCid,
                                 rebuilt.semanticSnapshotCid) ||
       !layout.FixedBytes32Equal(receipt.worldHeadCid,
                                 rebuilt.worldHeadCid) ||
       !layout.FixedBytes32Equal(receipt.compilerCid,
                                 rebuilt.compilerCid) ||
       !layout.FixedBytes32Equal(receipt.sourceBundleCid,
                                 rebuilt.sourceBundleCid) ||
       !layout.FixedBytes32Equal(receipt.csgRootCid,
                                 rebuilt.csgRootCid) ||
       !layout.FixedBytes32Equal(receipt.debugProjectionCid,
                                 rebuilt.debugProjectionCid) ||
       !layout.FixedBytes32Equal(receipt.declarationTableCid,
                                 rebuilt.declarationTableCid) ||
       !layout.FixedBytes32Equal(receipt.declarationIdentityCid,
                                 rebuilt.declarationIdentityCid) ||
       !layout.FixedBytes32Equal(receipt.functionDeclKeyCid,
                                 rebuilt.functionDeclKeyCid) ||
       !layout.FixedBytes32Equal(receipt.functionSymbolCid,
                                 rebuilt.functionSymbolCid) ||
       !layout.FixedBytes32Equal(receipt.objectCid, rebuilt.objectCid) ||
       !layout.FixedBytes32Equal(receipt.debugMapCid,
                                 rebuilt.debugMapCid) ||
       !debugEmissionRowsEqual(receipt.rows, rebuilt.rows):
        err = " debug emission: published receipt mismatch"
        return false
    err = ""
    return true

@borrows
fn debugObjectEmissionSha256Valid(value: str): bool =
    if value.len != 64:
        return false
    for index in 0..<value.len:
        let ch = value[index]
        if !((ch >= '0' && ch <= '9') ||
             (ch >= 'a' && ch <= 'f')):
            return false
    return true

@borrows
fn debugObjectEmissionPlanShapeValid(
        plan: planevidence.DebugEmissionPlanEvidence): bool =
    let count = plan.symbolNames.len
    let debugCount = plan.fragmentDebugOpIds.len
    return count > 0 &&
           plan.backendKind != "" &&
           plan.functionWordOffsets.len == count &&
           plan.functionWordCounts.len == count &&
           plan.frozenSnapshotPayloads.len == count &&
           plan.emissionLedgerPayloads.len == count &&
           plan.bodyIrSha256s.len == count &&
           plan.symbolByteStarts.len == count &&
           plan.symbolByteLengths.len == count &&
           plan.symbolBytesSha256s.len == count &&
           plan.planSha256s.len == count &&
           plan.actionSemanticRootSha256s.len == count &&
           plan.actionBindingRootSha256s.len == count &&
           plan.machineFragmentRootSha256s.len == count &&
           plan.abiIngressRootSha256s.len == count &&
           plan.debugProvenanceBound.len == count &&
           plan.debugFunctionIds.len == count &&
           plan.debugProvenanceSha256s.len == count &&
           plan.debugMachineFragmentRootSha256s.len == count &&
           plan.debugFragmentStarts.len == count &&
           plan.debugFragmentCounts.len == count &&
           plan.fragmentFunctionIndexes.len == debugCount &&
           plan.fragmentSyntheticKinds.len == debugCount &&
           plan.fragmentSiteKinds.len == debugCount &&
           plan.fragmentSiteIndexes.len == debugCount &&
           plan.fragmentMachineOwnerKinds.len == debugCount &&
           plan.fragmentMachineOwnerOrdinals.len == debugCount &&
           plan.fragmentActionConsumerOrdinals.len == debugCount &&
           plan.fragmentTextByteStarts.len == debugCount &&
           plan.fragmentByteLengths.len == debugCount &&
           plan.fragmentBytesSha256s.len == debugCount

@borrows
fn debugObjectEmissionMapCid(
        receipt: DebugObjectEmissionReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(
        768 + receipt.functions.len * 512 + receipt.rows.len * 128)
    debugEmissionAppendText(
        buf, "cheng.debug_emission.semantic_snapshot_object")
    debugEmissionAppendText(buf, receipt.backendKind)
    debugEmissionAppendI64(buf, receipt.sourceVersion)
    debugEmissionAppendText(buf, receipt.packageId)
    debugEmissionAppendCid(buf, receipt.bindingReceiptCid)
    debugEmissionAppendCid(buf, receipt.semanticSnapshotCid)
    debugEmissionAppendCid(buf, receipt.worldHeadCid)
    debugEmissionAppendCid(buf, receipt.compilerCid)
    debugEmissionAppendCid(buf, receipt.sourceBundleCid)
    debugEmissionAppendCid(buf, receipt.csgRootCid)
    debugEmissionAppendCid(buf, receipt.validationReceiptCid)
    debugEmissionAppendCid(buf, receipt.debugProjectionCid)
    debugEmissionAppendCid(buf, receipt.declarationTableCid)
    debugEmissionAppendCid(buf, receipt.declarationIdentityCid)
    debugEmissionAppendCid(buf, receipt.objectCid)
    debugEmissionAppendI32(buf, receipt.objectFormatKind)
    debugEmissionAppendI32(buf, receipt.objectMachineKind)
    debugEmissionAppendCid(buf, receipt.objectStructureCid)
    debugEmissionAppendI32(buf, receipt.textSectionIndex)
    debugEmissionAppendI32(buf, receipt.textSectionFileOffset)
    debugEmissionAppendI32(buf, receipt.textSectionByteLength)
    debugEmissionAppendI32(buf, receipt.symbolTableFileOffset)
    debugEmissionAppendI32(buf, receipt.symbolCount)
    debugEmissionAppendI32(buf, receipt.relocationTableFileOffset)
    debugEmissionAppendI32(buf, receipt.relocationCount)
    debugEmissionAppendI32(buf, receipt.objectByteLength)
    debugEmissionAppendI32(buf, receipt.functions.len)
    for index in 0..<receipt.functions.len:
        let row = receipt.functions[index]
        debugEmissionAppendI32(buf, row.functionId)
        debugEmissionAppendI32(buf, row.functionDeclId)
        debugEmissionAppendI32(buf, row.functionSymbolId)
        debugEmissionAppendCid(buf, row.functionDeclKeyCid)
        debugEmissionAppendCid(buf, row.functionSymbolCid)
        debugEmissionAppendI32(buf, row.objectSymbolTableIndex)
        debugEmissionAppendI32(buf, row.objectSectionIndex)
        debugEmissionAppendI32(buf, row.objectFileByteStart)
        debugEmissionAppendI32(buf, row.symbolByteStart)
        debugEmissionAppendI32(buf, row.symbolByteLength)
        debugEmissionAppendCid(buf, row.symbolBytesCid)
        debugEmissionAppendText(buf, row.bodyIrSha256)
        debugEmissionAppendText(buf, row.frozenPlanSha256)
        debugEmissionAppendText(buf, row.regallocPlanSha256)
        debugEmissionAppendText(buf, row.emissionLedgerSha256)
        debugEmissionAppendText(buf, row.actionSemanticRootSha256)
        debugEmissionAppendText(buf, row.actionBindingRootSha256)
        debugEmissionAppendText(buf, row.machineFragmentRootSha256)
        debugEmissionAppendText(buf, row.abiIngressRootSha256)
        debugEmissionAppendText(buf, row.debugMachineFragmentRootSha256)
        debugEmissionAppendI32(buf, row.rowStart)
        debugEmissionAppendI32(buf, row.rowCount)
    debugEmissionAppendI32(buf, receipt.rows.len)
    for index in 0..<receipt.rows.len:
        let row = receipt.rows[index]
        debugEmissionAppendI32(buf, row.debugOpId)
        debugEmissionAppendI32(buf, row.debugSyntheticKind)
        debugEmissionAppendI32(buf, row.typedNodeId)
        debugEmissionAppendI32(buf, row.typedIrNodeIndex)
        debugEmissionAppendI32(buf, row.originParserNodeId)
        debugEmissionAppendI32(buf, row.typedSyntheticOriginKind)
        debugEmissionAppendI32(buf, row.typedSpanAuthorityKind)
        debugEmissionAppendI32(buf, row.functionId)
        debugEmissionAppendI32(buf, row.functionDeclId)
        debugEmissionAppendI32(buf, row.functionSymbolId)
        debugEmissionAppendCid(buf, row.functionDeclKeyCid)
        debugEmissionAppendCid(buf, row.functionSymbolCid)
        debugEmissionAppendI32(buf, row.sourceId)
        debugEmissionAppendI32(buf, row.spanId)
        debugEmissionAppendI32(buf, row.siteKind)
        debugEmissionAppendI32(buf, row.siteIndex)
        debugEmissionAppendI32(buf, row.machineOwnerKind)
        debugEmissionAppendI32(buf, row.machineOwnerOrdinal)
        debugEmissionAppendI32(buf, row.actionConsumerOrdinal)
        debugEmissionAppendI32(buf, row.sectionIndex)
        debugEmissionAppendI32(buf, row.textSectionRelativeByteStart)
        debugEmissionAppendI32(buf, row.objectFileByteStart)
        debugEmissionAppendI32(buf, row.byteLength)
        debugEmissionAppendCid(buf, row.bytesCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn DebugObjectEmissionReceiptBuildInto(
        facts: debug.DebugFactBundle,
        plan: planevidence.DebugEmissionPlanEvidence,
        writerObjectCid: layout.FixedBytes32,
        writerTextSectionFileOffset: int32,
        objectBytes: rawbytes.Bytes,
        out: var DebugObjectEmissionReceipt,
        err: var str): bool =
    out = DebugObjectEmissionReceipt()
    err = ""
    if !debug.DebugFactBundleStrictValidateInto(facts, err) ||
       !debugObjectEmissionPlanShapeValid(plan):
        if err == "":
            err = " debug emission object: invalid facts or plan shape"
        return false
    if plan.backendKind != "primary" &&
       plan.backendKind != "backend2":
        err = " debug emission object: unsupported backend identity"
        return false
    let objectCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(objectBytes))
    var parsedObject: objectevidence.DebugRelocatableObjectEvidence
    if !objectevidence.DebugRelocatableObjectEvidenceBuildInto(
           objectBytes, plan.symbolNames, plan.symbolByteStarts,
           plan.symbolByteLengths, parsedObject, err) ||
       !objectevidence.DebugRelocatableObjectEvidenceStrictValidateInto(
           parsedObject, objectBytes, plan.symbolNames,
           plan.symbolByteStarts, plan.symbolByteLengths, err):
        return false
    let textSectionFileOffset = parsedObject.textSectionFileOffset
    let textSectionByteLength = parsedObject.textSectionByteLength
    if rawbytes.BytesLen(objectBytes) <= 0 ||
       textSectionFileOffset <= 0 || textSectionByteLength <= 0 ||
       writerTextSectionFileOffset != textSectionFileOffset ||
       !layout.FixedBytes32Equal(writerObjectCid, objectCid) ||
       !layout.FixedBytes32Equal(parsedObject.objectCid, objectCid):
        err = " debug emission object: writer/object identity mismatch"
        return false
    out.backendKind = plan.backendKind
    out.sourceVersion = facts.sourceVersion
    out.packageId = facts.packageId
    out.bindingReceiptCid = facts.bindingReceiptCid
    out.semanticSnapshotCid = facts.semanticSnapshotCid
    out.worldHeadCid = facts.worldHeadCid
    out.compilerCid = facts.compilerCid
    out.sourceBundleCid = facts.sourceBundleCid
    out.csgRootCid = facts.csgRootCid
    out.validationReceiptCid = facts.validationReceiptCid
    out.debugProjectionCid = facts.projectionCid
    out.declarationTableCid = facts.declarationTableCid
    out.declarationIdentityCid = facts.declarationIdentityCid
    out.objectCid = objectCid
    out.objectFormatKind = parsedObject.formatKind
    out.objectMachineKind = parsedObject.machineKind
    out.objectStructureCid = parsedObject.evidenceCid
    out.textSectionIndex = parsedObject.textSectionIndex
    out.textSectionFileOffset = textSectionFileOffset
    out.textSectionByteLength = textSectionByteLength
    out.symbolTableFileOffset = parsedObject.symbolTableFileOffset
    out.symbolCount = parsedObject.symbolCount
    out.relocationTableFileOffset =
        parsedObject.relocationTableFileOffset
    out.relocationCount = parsedObject.relocationCount
    out.objectByteLength = rawbytes.BytesLen(objectBytes)
    var seenFunctionIds: bool[]
    setLen(seenFunctionIds, facts.functionCount)
    var expectedDebugStart: int32
    for functionIndex in 0..<plan.symbolNames.len:
        let functionId = plan.debugFunctionIds[functionIndex]
        let rowStart = plan.debugFragmentStarts[functionIndex]
        let rowCount = plan.debugFragmentCounts[functionIndex]
        if !plan.debugProvenanceBound[functionIndex] ||
           functionId < 0 || functionId >= facts.functionCount ||
           seenFunctionIds[functionId] || rowCount <= 0 ||
           rowStart != expectedDebugStart ||
           rowStart > plan.fragmentDebugOpIds.len - rowCount ||
           planevidence.DebugEmissionPlanEvidenceDebugMachineFragmentRootSha256(
               plan, functionIndex) !=
               plan.debugMachineFragmentRootSha256s[functionIndex]:
            err = " debug emission object: incomplete function DebugFact coverage"
            return false
        let functionFact = facts.facts[functionId]
        if functionFact.kind != debug.DebugFactKindFunction ||
           functionFact.functionFact.functionId != functionId:
            err = " debug emission object: FunctionId projection mismatch"
            return false
        seenFunctionIds[functionId] = true
        let symbolByteStart = plan.symbolByteStarts[functionIndex]
        let symbolByteLength = plan.symbolByteLengths[functionIndex]
        let parsedFunction = parsedObject.functions[functionIndex]
        if symbolByteStart != plan.functionWordOffsets[functionIndex] * 4 ||
           symbolByteLength != plan.functionWordCounts[functionIndex] * 4 ||
           symbolByteStart < 0 || symbolByteLength <= 0 ||
           symbolByteStart > textSectionByteLength - symbolByteLength ||
           parsedFunction.sectionIndex != parsedObject.textSectionIndex ||
           parsedFunction.sectionRelativeByteStart != symbolByteStart ||
           parsedFunction.objectFileByteStart !=
               textSectionFileOffset + symbolByteStart ||
           parsedFunction.byteLength != symbolByteLength:
            err = " debug emission object: function object range mismatch"
            return false
        let symbolBytes = rawbytes.BytesSliceView(
            objectBytes, textSectionFileOffset + symbolByteStart,
            symbolByteLength)
        let symbolBytesCid = hash256.Sha256Fixed(
            layout.ByteSpanFromBytes(symbolBytes))
        if layout.FixedBytes32Hex(symbolBytesCid) !=
               plan.symbolBytesSha256s[functionIndex] ||
           !layout.FixedBytes32Equal(
               symbolBytesCid, parsedFunction.bytesCid):
            err = " debug emission object: function bytes mismatch"
            return false
        var functionRow: DebugObjectEmissionFunctionRow
        functionRow.functionId = functionId
        functionRow.functionDeclId =
            functionFact.functionFact.declId
        functionRow.functionSymbolId =
            functionFact.functionFact.symbolId
        functionRow.functionDeclKeyCid =
            functionFact.functionFact.declKeyCid
        functionRow.functionSymbolCid =
            functionFact.functionFact.symbolCid
        functionRow.objectSymbolTableIndex =
            parsedFunction.symbolTableIndex
        functionRow.objectSectionIndex = parsedFunction.sectionIndex
        functionRow.objectFileByteStart =
            parsedFunction.objectFileByteStart
        functionRow.symbolByteStart = symbolByteStart
        functionRow.symbolByteLength = symbolByteLength
        functionRow.symbolBytesCid = symbolBytesCid
        functionRow.bodyIrSha256 =
            plan.bodyIrSha256s[functionIndex]
        functionRow.frozenPlanSha256 = strings.Sha256(
            plan.frozenSnapshotPayloads[functionIndex])
        functionRow.regallocPlanSha256 =
            plan.planSha256s[functionIndex]
        functionRow.emissionLedgerSha256 = strings.Sha256(
            plan.emissionLedgerPayloads[functionIndex])
        functionRow.actionSemanticRootSha256 =
            plan.actionSemanticRootSha256s[functionIndex]
        functionRow.actionBindingRootSha256 =
            plan.actionBindingRootSha256s[functionIndex]
        functionRow.machineFragmentRootSha256 =
            plan.machineFragmentRootSha256s[functionIndex]
        functionRow.abiIngressRootSha256 =
            plan.abiIngressRootSha256s[functionIndex]
        functionRow.debugMachineFragmentRootSha256 =
            plan.debugMachineFragmentRootSha256s[functionIndex]
        functionRow.rowStart = out.rows.len
        functionRow.rowCount = rowCount
        if !debugObjectEmissionSha256Valid(functionRow.bodyIrSha256) ||
           !debugObjectEmissionSha256Valid(functionRow.frozenPlanSha256) ||
           !debugObjectEmissionSha256Valid(
               functionRow.regallocPlanSha256) ||
           !debugObjectEmissionSha256Valid(
               functionRow.emissionLedgerSha256) ||
           !debugObjectEmissionSha256Valid(
               functionRow.actionSemanticRootSha256) ||
           !debugObjectEmissionSha256Valid(
               functionRow.actionBindingRootSha256) ||
           !debugObjectEmissionSha256Valid(
               functionRow.machineFragmentRootSha256) ||
           !debugObjectEmissionSha256Valid(
               functionRow.abiIngressRootSha256) ||
           !debugObjectEmissionSha256Valid(
               functionRow.debugMachineFragmentRootSha256):
            err = " debug emission object: invalid function evidence hash"
            return false
        for offset in 0..<rowCount:
            let fragmentIndex = rowStart + offset
            if plan.fragmentFunctionIndexes[fragmentIndex] !=
                   functionIndex:
                err = " debug emission object: fragment owner mismatch"
                return false
            let byteStart =
                plan.fragmentTextByteStarts[fragmentIndex]
            let byteLength =
                plan.fragmentByteLengths[fragmentIndex]
            if byteLength <= 0 || byteStart < symbolByteStart ||
               byteStart > symbolByteStart + symbolByteLength - byteLength ||
               byteStart > textSectionByteLength - byteLength:
                err = " debug emission object: fragment range mismatch"
                return false
            var row: DebugEmissionRow
            row.debugOpId =
                plan.fragmentDebugOpIds[fragmentIndex]
            row.debugSyntheticKind =
                plan.fragmentSyntheticKinds[fragmentIndex]
            row.functionId = functionId
            row.functionDeclId = functionRow.functionDeclId
            row.functionSymbolId = functionRow.functionSymbolId
            row.functionDeclKeyCid = functionRow.functionDeclKeyCid
            row.functionSymbolCid = functionRow.functionSymbolCid
            row.siteKind =
                plan.fragmentSiteKinds[fragmentIndex]
            row.siteIndex =
                plan.fragmentSiteIndexes[fragmentIndex]
            row.machineOwnerKind =
                plan.fragmentMachineOwnerKinds[fragmentIndex]
            row.machineOwnerOrdinal =
                plan.fragmentMachineOwnerOrdinals[fragmentIndex]
            row.actionConsumerOrdinal =
                plan.fragmentActionConsumerOrdinals[fragmentIndex]
            row.sectionIndex = parsedObject.textSectionIndex
            row.textSectionRelativeByteStart = byteStart
            row.objectFileByteStart = textSectionFileOffset + byteStart
            row.byteLength = byteLength
            let fragmentBytes = rawbytes.BytesSliceView(
                objectBytes, row.objectFileByteStart, byteLength)
            row.bytesCid = hash256.Sha256Fixed(
                layout.ByteSpanFromBytes(fragmentBytes))
            if layout.FixedBytes32Hex(row.bytesCid) !=
                   plan.fragmentBytesSha256s[fragmentIndex]:
                err = " debug emission object: fragment bytes mismatch"
                return false
            if row.debugOpId >= 0:
                if row.debugSyntheticKind !=
                       coreir.BodyDebugSyntheticNone:
                    err = " debug emission object: exact DebugOp marked synthetic"
                    return false
                var operation: debug.DebugOperationFact
                if !debugEmissionOperationFact(
                       facts, row.debugOpId, operation) ||
                   operation.functionId != functionId ||
                   operation.functionDeclId != row.functionDeclId ||
                   operation.functionSymbolId != row.functionSymbolId ||
                   !layout.FixedBytes32Equal(
                       operation.functionDeclKeyCid,
                       row.functionDeclKeyCid) ||
                   !layout.FixedBytes32Equal(
                       operation.functionSymbolCid,
                       row.functionSymbolCid):
                    err = " debug emission object: DebugOpId/function declaration join mismatch"
                    return false
                row.typedNodeId = operation.typedNodeId
                row.typedIrNodeIndex = operation.typedIrNodeIndex
                row.originParserNodeId = operation.originParserNodeId
                row.typedSyntheticOriginKind =
                    operation.syntheticOriginKind
                row.typedSpanAuthorityKind = operation.spanAuthorityKind
                row.sourceId = operation.sourceId
                row.spanId = operation.spanId
            elif row.debugSyntheticKind <
                     coreir.BodyDebugSyntheticCleanup ||
                 row.debugSyntheticKind >
                     coreir.BodyDebugSyntheticRuntime:
                err = " debug emission object: invalid synthetic proof kind"
                return false
            add(out.rows, row)
        add(out.functions, functionRow)
        expectedDebugStart = rowStart + rowCount
    if expectedDebugStart != plan.fragmentDebugOpIds.len ||
       out.functions.len != plan.symbolNames.len ||
       out.rows.len <= 0:
        err = " debug emission object: fragment coverage incomplete"
        return false
    out.debugMapCid = debugObjectEmissionMapCid(out)
    out.valid = true
    return true

@borrows
fn debugObjectEmissionFunctionsEqual(
        left: DebugObjectEmissionFunctionRow[],
        right: DebugObjectEmissionFunctionRow[]): bool =
    if left.len != right.len:
        return false
    for index in 0..<left.len:
        let a = left[index]
        let b = right[index]
        if a.functionId != b.functionId ||
           a.functionDeclId != b.functionDeclId ||
           a.functionSymbolId != b.functionSymbolId ||
           !layout.FixedBytes32Equal(
               a.functionDeclKeyCid, b.functionDeclKeyCid) ||
           !layout.FixedBytes32Equal(
               a.functionSymbolCid, b.functionSymbolCid) ||
           a.objectSymbolTableIndex != b.objectSymbolTableIndex ||
           a.objectSectionIndex != b.objectSectionIndex ||
           a.objectFileByteStart != b.objectFileByteStart ||
           a.symbolByteStart != b.symbolByteStart ||
           a.symbolByteLength != b.symbolByteLength ||
           !layout.FixedBytes32Equal(
               a.symbolBytesCid, b.symbolBytesCid) ||
           a.bodyIrSha256 != b.bodyIrSha256 ||
           a.frozenPlanSha256 != b.frozenPlanSha256 ||
           a.regallocPlanSha256 != b.regallocPlanSha256 ||
           a.emissionLedgerSha256 != b.emissionLedgerSha256 ||
           a.actionSemanticRootSha256 != b.actionSemanticRootSha256 ||
           a.actionBindingRootSha256 != b.actionBindingRootSha256 ||
           a.machineFragmentRootSha256 != b.machineFragmentRootSha256 ||
           a.abiIngressRootSha256 != b.abiIngressRootSha256 ||
           a.debugMachineFragmentRootSha256 !=
               b.debugMachineFragmentRootSha256 ||
           a.rowStart != b.rowStart || a.rowCount != b.rowCount:
            return false
    return true

@borrows
fn DebugObjectEmissionReceiptStrictValidateInto(
        receipt: DebugObjectEmissionReceipt,
        facts: debug.DebugFactBundle,
        plan: planevidence.DebugEmissionPlanEvidence,
        writerObjectCid: layout.FixedBytes32,
        writerTextSectionFileOffset: int32,
        objectBytes: rawbytes.Bytes,
        err: var str): bool =
    var rebuilt: DebugObjectEmissionReceipt
    if !DebugObjectEmissionReceiptBuildInto(
           facts, plan, writerObjectCid, writerTextSectionFileOffset,
           objectBytes, rebuilt, err):
        return false
    if !receipt.valid || receipt.backendKind != rebuilt.backendKind ||
       receipt.sourceVersion != rebuilt.sourceVersion ||
       receipt.packageId != rebuilt.packageId ||
       receipt.objectFormatKind != rebuilt.objectFormatKind ||
       receipt.objectMachineKind != rebuilt.objectMachineKind ||
       receipt.textSectionIndex != rebuilt.textSectionIndex ||
       receipt.textSectionFileOffset != rebuilt.textSectionFileOffset ||
       receipt.textSectionByteLength != rebuilt.textSectionByteLength ||
       receipt.symbolTableFileOffset != rebuilt.symbolTableFileOffset ||
       receipt.symbolCount != rebuilt.symbolCount ||
       receipt.relocationTableFileOffset !=
           rebuilt.relocationTableFileOffset ||
       receipt.relocationCount != rebuilt.relocationCount ||
       receipt.objectByteLength != rebuilt.objectByteLength ||
       !layout.FixedBytes32Equal(
           receipt.bindingReceiptCid, rebuilt.bindingReceiptCid) ||
       !layout.FixedBytes32Equal(
           receipt.semanticSnapshotCid, rebuilt.semanticSnapshotCid) ||
       !layout.FixedBytes32Equal(
           receipt.worldHeadCid, rebuilt.worldHeadCid) ||
       !layout.FixedBytes32Equal(receipt.compilerCid, rebuilt.compilerCid) ||
       !layout.FixedBytes32Equal(
           receipt.sourceBundleCid, rebuilt.sourceBundleCid) ||
       !layout.FixedBytes32Equal(receipt.csgRootCid, rebuilt.csgRootCid) ||
       !layout.FixedBytes32Equal(
           receipt.validationReceiptCid, rebuilt.validationReceiptCid) ||
       !layout.FixedBytes32Equal(
           receipt.debugProjectionCid, rebuilt.debugProjectionCid) ||
       !layout.FixedBytes32Equal(
           receipt.declarationTableCid, rebuilt.declarationTableCid) ||
       !layout.FixedBytes32Equal(
           receipt.declarationIdentityCid,
           rebuilt.declarationIdentityCid) ||
       !layout.FixedBytes32Equal(receipt.objectCid, rebuilt.objectCid) ||
       !layout.FixedBytes32Equal(
           receipt.objectStructureCid, rebuilt.objectStructureCid) ||
       !layout.FixedBytes32Equal(
           receipt.debugMapCid, rebuilt.debugMapCid) ||
       !debugObjectEmissionFunctionsEqual(
           receipt.functions, rebuilt.functions) ||
       !debugEmissionRowsEqual(receipt.rows, rebuilt.rows):
        err = " debug emission object: published receipt mismatch"
        return false
    err = ""
    return true

fn DebugObjectEmissionReceiptReportText(
        receipt: DebugObjectEmissionReceipt): str =
    var out = ""
    if !receipt.valid:
        return out
    out = strutil.Join([
        "debug_emission_receipt_status=bound\n",
        "debug_emission_backend_kind=", strings.CloneStr(receipt.backendKind), "\n",
        "debug_emission_source_version=",
        strings.Int64ToStr(receipt.sourceVersion), "\n",
        "debug_emission_semantic_snapshot_cid=",
        layout.FixedBytes32Hex(receipt.semanticSnapshotCid), "\n",
        "debug_emission_csg_root_cid=",
        layout.FixedBytes32Hex(receipt.csgRootCid), "\n",
        "debug_emission_projection_cid=",
        layout.FixedBytes32Hex(receipt.debugProjectionCid), "\n",
        "debug_emission_declaration_table_cid=",
        layout.FixedBytes32Hex(receipt.declarationTableCid), "\n",
        "debug_emission_declaration_identity_cid=",
        layout.FixedBytes32Hex(receipt.declarationIdentityCid), "\n",
        "debug_emission_object_cid=",
        layout.FixedBytes32Hex(receipt.objectCid), "\n",
        "debug_emission_object_format_kind=",
        strings.IntToStr(receipt.objectFormatKind), "\n",
        "debug_emission_object_machine_kind=",
        strings.IntToStr(receipt.objectMachineKind), "\n",
        "debug_emission_object_structure_cid=",
        layout.FixedBytes32Hex(receipt.objectStructureCid), "\n",
        "debug_emission_text_section_index=",
        strings.IntToStr(receipt.textSectionIndex), "\n",
        "debug_emission_symbol_count=",
        strings.IntToStr(receipt.symbolCount), "\n",
        "debug_emission_relocation_count=",
        strings.IntToStr(receipt.relocationCount), "\n",
        "debug_emission_map_cid=",
        layout.FixedBytes32Hex(receipt.debugMapCid), "\n",
        "debug_emission_function_count=",
        strings.IntToStr(receipt.functions.len), "\n",
        "debug_emission_row_count=",
        strings.IntToStr(receipt.rows.len), "\n"
    ], "")
    for index in 0..<receipt.functions.len:
        let row = receipt.functions[index]
        out = strutil.Join([
            out, "debug_emission_function.", strings.IntToStr(index), "=",
            strings.IntToStr(row.functionId), ";",
            strings.IntToStr(row.functionDeclId), ";",
            strings.IntToStr(row.functionSymbolId), ";",
            layout.FixedBytes32Hex(row.functionDeclKeyCid), ";",
            layout.FixedBytes32Hex(row.functionSymbolCid), ";",
            strings.IntToStr(row.objectSymbolTableIndex), ";",
            strings.IntToStr(row.objectSectionIndex), ";",
            strings.IntToStr(row.objectFileByteStart), ";",
            strings.IntToStr(row.symbolByteStart), ";",
            strings.IntToStr(row.symbolByteLength), ";",
            layout.FixedBytes32Hex(row.symbolBytesCid), ";",
            strings.CloneStr(row.bodyIrSha256), ";", strings.CloneStr(row.frozenPlanSha256), ";",
            strings.CloneStr(row.regallocPlanSha256), ";",
            strings.CloneStr(row.emissionLedgerSha256), ";",
            strings.CloneStr(row.debugMachineFragmentRootSha256), ";",
            strings.IntToStr(row.rowStart), ";",
            strings.IntToStr(row.rowCount), "\n"
        ], "")
    for index in 0..<receipt.rows.len:
        let row = receipt.rows[index]
        out = strutil.Join([
            out, "debug_emission_row.", strings.IntToStr(index), "=",
            strings.IntToStr(row.functionId), ";",
            strings.IntToStr(row.functionDeclId), ";",
            strings.IntToStr(row.functionSymbolId), ";",
            layout.FixedBytes32Hex(row.functionDeclKeyCid), ";",
            layout.FixedBytes32Hex(row.functionSymbolCid), ";",
            strings.IntToStr(row.debugOpId), ";",
            strings.IntToStr(row.typedNodeId), ";",
            strings.IntToStr(row.typedIrNodeIndex), ";",
            strings.IntToStr(row.originParserNodeId), ";",
            strings.IntToStr(row.sourceId), ";",
            strings.IntToStr(row.spanId), ";",
            strings.IntToStr(row.sectionIndex), ";",
            strings.IntToStr(row.objectFileByteStart), ";",
            strings.IntToStr(row.byteLength), ";",
            layout.FixedBytes32Hex(row.bytesCid), "\n"
        ], "")
    return out
