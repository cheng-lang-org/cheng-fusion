import std/strutils as strutil
import std/system
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/compiler_snapshot_schema as snapshot_schema
import cheng/core/tooling/semantic_snapshot as snapshot_core
import std/strings

// SemanticFact -- immutable type-resolved projection of canonical CSG.
// Includes:
//   - type resolution
//   - import resolution (follow edges to resolved targets)
//   - exact call target resolution

type
    SemanticFactKind = enum
        SemanticFactKindNone
        SemanticFactKindResolvedType
        SemanticFactKindResolvedImport
        SemanticFactKindCallGraph
        SemanticFactKindDiagnostic
        SemanticFactKindLayout
        SemanticFactKindLayoutField

    ResolvedTypeFact =
        typedNodeId: int32
        typedIrNodeIndex: int32
        functionId: int32
        functionSymbolId: int32
        functionDeclId: int32
        typeId: int32
        spanId: int32
        opKind: int32
        ownershipKind: int32
        documentCid: layout.FixedBytes32
        functionSymbolCid: layout.FixedBytes32
        functionDeclKeyCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        typeCid: layout.FixedBytes32
        sourcePath: str
        lineNumber: int32
        column: int32
        endLine: int32
        endColumn: int32
        exprId: str
        resolvedTypeName: str
        resolvedTypeKind: int32
        resolvedTypeSize: int32
        resolvedTypeAlign: int32
        abiClass: int32
        valueKind: int32
        placeKind: int32
        loweringMode: int32
        returnKind: int32

    ResolvedImportFact =
        dependencyId: int32
        sourceId: int32
        targetSourceId: int32
        spanId: int32
        documentCid: layout.FixedBytes32
        dependencyKind: int32
        observedInterfaceCid: layout.FixedBytes32
        ownerModulePath: str
        targetModulePath: str
        resolvedModulePath: str
        resolved: bool
        errorMessage: str
        startLine: int32
        startColumn: int32
        endLine: int32
        endColumn: int32

    CallGraphEdgeFact =
        callId: int32
        referenceId: int32
        callerFunctionId: int32
        callerSymbolId: int32
        calleeSymbolId: int32
        callerDeclId: int32
        calleeDeclId: int32
        resultTypeId: int32
        resultOwnershipKind: int32
        referenceKind: int32
        callerSymbolCid: layout.FixedBytes32
        calleeSymbolCid: layout.FixedBytes32
        callerDeclKeyCid: layout.FixedBytes32
        calleeDeclKeyCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        callDocumentCid: layout.FixedBytes32
        callerFnName: str
        callerModulePath: str
        calleeFnName: str
        calleeModulePath: str
        callSitePath: str
        callSiteLine: int32
        callSiteColumn: int32
        callSiteEndLine: int32
        callSiteEndColumn: int32
        callKind: int32

    SemanticDiagnosticFact =
        diagnosticId: int32
        sourceId: int32
        spanId: int32
        documentCid: layout.FixedBytes32
        sourcePath: str
        lineNumber: int32
        column: int32
        producerKind: int32
        severity: int32
        code: str
        message: str

    SemanticLayoutFact =
        layoutId: int32
        typeId: int32
        declSymbolId: int32
        declId: int32
        declarationPresent: bool
        layoutCid: layout.FixedBytes32
        typeCid: layout.FixedBytes32
        declSymbolCid: layout.FixedBytes32
        declKeyCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        typeName: str
        sizeBytes: int32
        alignBytes: int32
        fieldStart: int32
        fieldCount: int32

    SemanticLayoutFieldFact =
        layoutFieldId: int32
        layoutId: int32
        fieldSymbolId: int32
        fieldDeclId: int32
        typeId: int32
        fieldSymbolCid: layout.FixedBytes32
        fieldDeclKeyCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        typeCid: layout.FixedBytes32
        offsetBytes: int32
        sizeBytes: int32
        alignBytes: int32

    SemanticFact =
        kind: SemanticFactKind

        resolvedTypeFact: ResolvedTypeFact
        resolvedImportFact: ResolvedImportFact
        callGraphEdgeFact: CallGraphEdgeFact
        semanticDiagnosticFact: SemanticDiagnosticFact
        layoutFact: SemanticLayoutFact
        layoutFieldFact: SemanticLayoutFieldFact

    SemanticFactBundle =
        sourceVersion: int64
        packageId: str
        predecessorReceiptCid: layout.FixedBytes32
        bindingReceiptCid: layout.FixedBytes32
        semanticSnapshotCid: layout.FixedBytes32
        worldHeadCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        csgRootCid: layout.FixedBytes32
        validationReceiptCid: layout.FixedBytes32
        projectionCid: layout.FixedBytes32
        factCount: int32
        facts: SemanticFact[]

// ---- Constants ----
const
    SemanticAbiScalar: int32 = 0
    SemanticAbiComposite: int32 = 1
    SemanticAbiPointerLike: int32 = 2
    SemanticAbiPolymorphic: int32 = 3

    SemanticValueScalar: int32 = 0
    SemanticValueComposite: int32 = 1
    SemanticValuePointerLike: int32 = 2

    SemanticPlaceLocal: int32 = 0
    SemanticPlaceGlobal: int32 = 1
    SemanticPlaceField: int32 = 2
    SemanticPlaceTemporary: int32 = 3
    SemanticPlaceCallResult: int32 = 4

    SemanticLowerReg: int32 = 0
    SemanticLowerLocalAddress: int32 = 1
    SemanticLowerSret: int32 = 2
    SemanticLowerImportBuffer: int32 = 3
    SemanticLowerDeferred: int32 = 4

    SemanticReturnReg: int32 = 0
    SemanticReturnCompositeLocal: int32 = 1
    SemanticReturnSret: int32 = 2
    SemanticReturnImportBuffer: int32 = 3

    SemanticCallKindLocal: int32 = 0
    SemanticCallKindExternal: int32 = 1
    SemanticCallKindImportc: int32 = 2
    SemanticCallKindMember: int32 = 3

    SemanticSeverityError: int32 = 0
    SemanticSeverityWarning: int32 = 1
    SemanticSeverityInfo: int32 = 2

// ---- Helpers ----

fn SemanticFactNew(kind: SemanticFactKind): SemanticFact =
    var out: SemanticFact
    out.kind = kind
    return out

@borrows
fn semanticFactSnapshotProjectionCid(
        predecessorReceiptCid: layout.FixedBytes32,
        binding: snapshot_core.LocalSourceVersionBinding,
        validation: snapshot_core.SemanticSnapshotValidationReceipt):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(320)
    let domain = "cheng.semantic_fact.snapshot_projection"
    for index in 0..<domain.len:
        layout.ByteBufAppendByte(buf, Int32(domain[index]) & 255)
    layout.ByteBufAppendFixed32(buf, predecessorReceiptCid)
    layout.ByteBufAppendFixed32(buf, binding.bindingReceiptCid)
    layout.ByteBufAppendFixed32(buf, binding.semanticSnapshotCid)
    layout.ByteBufAppendFixed32(buf, binding.worldHeadCid)
    layout.ByteBufAppendFixed32(buf, binding.compilerCid)
    layout.ByteBufAppendFixed32(buf, binding.sourceBundleCid)
    layout.ByteBufAppendFixed32(buf, binding.csgRootCid)
    layout.ByteBufAppendFixed32(buf, validation.validationReceiptCid)
    let rawVersion = UInt64(binding.sourceVersion)
    layout.ByteBufAppendByte(
        buf, Int32((rawVersion >> UInt64(56)) & UInt64(255)))
    layout.ByteBufAppendByte(
        buf, Int32((rawVersion >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(
        buf, Int32((rawVersion >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(
        buf, Int32((rawVersion >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(
        buf, Int32((rawVersion >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(
        buf, Int32((rawVersion >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(
        buf, Int32((rawVersion >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32(rawVersion & UInt64(255)))
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn semanticFactSnapshotSourcePath(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        sourceId: int32): str =
    return system.SystemToStringStr(
        snapshot.texts[snapshot.sources.modulePathTextIds[sourceId]])

@borrows
fn SemanticFactsFromSemanticSnapshotInto(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        identity: snapshot_core.PortableSemanticSnapshotIdentity,
        binding: snapshot_core.LocalSourceVersionBinding,
        validation: snapshot_core.SemanticSnapshotValidationReceipt,
        predecessorReceiptCid: layout.FixedBytes32,
        packageId: str,
        out: var SemanticFactBundle,
        err: var str): bool =
    err = ""
    if packageId == "" ||
       !snapshot_schema.CsgCompilerSnapshotTablesStrictValidateInto(
           snapshot, err) ||
       !snapshot_core.SemanticSnapshotValidationReceiptStrictValidateInto(
           validation, binding, identity, err) ||
       !layout.FixedBytes32Equal(snapshot.predecessorReceiptCid,
                                 predecessorReceiptCid):
        if err == "":
            err = " semantic facts: invalid admitted semantic snapshot"
        return false
    var bundle: SemanticFactBundle
    bundle.sourceVersion = binding.sourceVersion
    bundle.packageId = system.SystemToStringStr(packageId)
    bundle.predecessorReceiptCid =
        layout.FixedBytes32Copy(predecessorReceiptCid)
    bundle.bindingReceiptCid =
        layout.FixedBytes32Copy(binding.bindingReceiptCid)
    bundle.semanticSnapshotCid =
        layout.FixedBytes32Copy(identity.semanticSnapshotCid)
    bundle.worldHeadCid = layout.FixedBytes32Copy(identity.worldHeadCid)
    bundle.compilerCid = layout.FixedBytes32Copy(identity.compilerCid)
    bundle.sourceBundleCid =
        layout.FixedBytes32Copy(identity.sourceBundleCid)
    bundle.csgRootCid = layout.FixedBytes32Copy(identity.csgRootCid)
    bundle.validationReceiptCid =
        layout.FixedBytes32Copy(validation.validationReceiptCid)

    var typeSizes: int32[]
    var typeAligns: int32[]
    for typeId in 0..<snapshot.types.typeCids.len:
        add(typeSizes, 0)
        add(typeAligns, 0)
    for layoutId in 0..<snapshot.layouts.typeIds.len:
        let typeId = snapshot.layouts.typeIds[layoutId]
        typeSizes[typeId] = snapshot.layouts.sizeBytes[layoutId]
        typeAligns[typeId] = snapshot.layouts.alignBytes[layoutId]

    for row in 0..<snapshot.typedNodes.functionIds.len:
        let spanId = snapshot.typedNodes.spanIds[row]
        let sourceId = snapshot.spans.sourceIds[spanId]
        let functionId = snapshot.typedNodes.functionIds[row]
        let functionSymbolId = snapshot.functions.symbolIds[functionId]
        let typeId = snapshot.typedNodes.typeIds[row]
        var fact = SemanticFactNew(SemanticFactKindResolvedType)
        var resolved: ResolvedTypeFact
        resolved.typedNodeId = row
        resolved.typedIrNodeIndex =
            snapshot.typedNodes.typedIrNodeIndexes[row]
        resolved.functionId = functionId
        resolved.functionSymbolId = functionSymbolId
        resolved.functionDeclId = snapshot.symbols.declIds[functionSymbolId]
        resolved.typeId = typeId
        resolved.spanId = spanId
        resolved.opKind = snapshot.typedNodes.opKinds[row]
        resolved.ownershipKind = snapshot.typedNodes.ownershipKinds[row]
        resolved.documentCid =
            layout.FixedBytes32Copy(
                snapshot.sources.documentCids[sourceId])
        resolved.functionSymbolCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.symbolCids[functionSymbolId])
        resolved.functionDeclKeyCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.declKeyCids[functionSymbolId])
        resolved.declarationTableCid =
            layout.FixedBytes32Copy(snapshot.declarations.tableCid)
        resolved.sourcePath = semanticFactSnapshotSourcePath(snapshot,
                                                              sourceId)
        resolved.lineNumber = snapshot.spans.startLines[spanId]
        resolved.column = snapshot.spans.startColumns[spanId]
        resolved.endLine = snapshot.spans.endLines[spanId]
        resolved.endColumn = snapshot.spans.endColumns[spanId]
        if typeId >= 0:
            resolved.typeCid =
                layout.FixedBytes32Copy(snapshot.types.typeCids[typeId])
            let typeTextId = snapshot.types.canonicalTextIds[typeId]
            resolved.resolvedTypeName =
                system.SystemToStringStr(snapshot.texts[typeTextId])
            resolved.resolvedTypeKind = snapshot.types.typeKinds[typeId]
            resolved.resolvedTypeSize = typeSizes[typeId]
            resolved.resolvedTypeAlign = typeAligns[typeId]
        fact.resolvedTypeFact = resolved
        add(bundle.facts, fact)

    for row in 0..<snapshot.dependencies.sourceIds.len:
        let sourceId = snapshot.dependencies.sourceIds[row]
        let targetId = snapshot.dependencies.targetSourceIds[row]
        let spanId = snapshot.dependencies.spanIds[row]
        var fact = SemanticFactNew(SemanticFactKindResolvedImport)
        var resolved: ResolvedImportFact
        resolved.dependencyId = row
        resolved.sourceId = sourceId
        resolved.targetSourceId = targetId
        resolved.spanId = spanId
        resolved.documentCid =
            layout.FixedBytes32Copy(
                snapshot.sources.documentCids[sourceId])
        resolved.dependencyKind = snapshot.dependencies.dependencyKinds[row]
        resolved.observedInterfaceCid =
            layout.FixedBytes32Copy(
                snapshot.dependencies.observedInterfaceCids[row])
        resolved.ownerModulePath = semanticFactSnapshotSourcePath(snapshot,
                                                                   sourceId)
        resolved.targetModulePath = semanticFactSnapshotSourcePath(snapshot,
                                                                    targetId)
        resolved.resolvedModulePath =
            semanticFactSnapshotSourcePath(snapshot, targetId)
        resolved.resolved = true
        resolved.startLine = snapshot.spans.startLines[spanId]
        resolved.startColumn = snapshot.spans.startColumns[spanId]
        resolved.endLine = snapshot.spans.endLines[spanId]
        resolved.endColumn = snapshot.spans.endColumns[spanId]
        fact.resolvedImportFact = resolved
        add(bundle.facts, fact)

    for row in 0..<snapshot.calls.callReferenceIds.len:
        let referenceId = snapshot.calls.callReferenceIds[row]
        let spanId = snapshot.references.spanIds[referenceId]
        let sourceId = snapshot.references.sourceIds[referenceId]
        let callerFunctionId = snapshot.calls.callerFunctionIds[row]
        let callerSymbolId = snapshot.functions.symbolIds[callerFunctionId]
        let calleeSymbolId = snapshot.calls.calleeSymbolIds[row]
        var fact = SemanticFactNew(SemanticFactKindCallGraph)
        var call: CallGraphEdgeFact
        call.callId = row
        call.referenceId = referenceId
        call.callerFunctionId = callerFunctionId
        call.callerSymbolId = callerSymbolId
        call.calleeSymbolId = calleeSymbolId
        call.callerDeclId = snapshot.symbols.declIds[callerSymbolId]
        call.calleeDeclId = snapshot.symbols.declIds[calleeSymbolId]
        call.resultTypeId = snapshot.calls.resultTypeIds[row]
        call.resultOwnershipKind =
            snapshot.calls.resultOwnershipKinds[row]
        call.referenceKind = snapshot.references.referenceKinds[referenceId]
        call.callerSymbolCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.symbolCids[callerSymbolId])
        call.calleeSymbolCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.symbolCids[calleeSymbolId])
        call.callerDeclKeyCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.declKeyCids[callerSymbolId])
        call.calleeDeclKeyCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.declKeyCids[calleeSymbolId])
        call.declarationTableCid =
            layout.FixedBytes32Copy(snapshot.declarations.tableCid)
        call.callDocumentCid =
            layout.FixedBytes32Copy(
                snapshot.sources.documentCids[sourceId])
        let callerNameTextId = snapshot.symbols.nameTextIds[callerSymbolId]
        call.callerFnName =
            system.SystemToStringStr(snapshot.texts[callerNameTextId])
        call.callerModulePath = semanticFactSnapshotSourcePath(
            snapshot, snapshot.symbols.sourceIds[callerSymbolId])
        let calleeNameTextId = snapshot.symbols.nameTextIds[calleeSymbolId]
        call.calleeFnName =
            system.SystemToStringStr(snapshot.texts[calleeNameTextId])
        call.calleeModulePath = semanticFactSnapshotSourcePath(
            snapshot, snapshot.symbols.sourceIds[calleeSymbolId])
        call.callSitePath = semanticFactSnapshotSourcePath(snapshot, sourceId)
        call.callSiteLine = snapshot.spans.startLines[spanId]
        call.callSiteColumn = snapshot.spans.startColumns[spanId]
        call.callSiteEndLine = snapshot.spans.endLines[spanId]
        call.callSiteEndColumn = snapshot.spans.endColumns[spanId]
        call.callKind = call.referenceKind
        fact.callGraphEdgeFact = call
        add(bundle.facts, fact)

    for row in 0..<snapshot.layouts.layoutCids.len:
        let typeId = snapshot.layouts.typeIds[row]
        var fact = SemanticFactNew(SemanticFactKindLayout)
        var semanticLayout: SemanticLayoutFact
        semanticLayout.layoutId = row
        semanticLayout.typeId = typeId
        semanticLayout.declSymbolId = snapshot.types.declSymbolIds[typeId]
        semanticLayout.declId = -1
        semanticLayout.layoutCid =
            layout.FixedBytes32Copy(snapshot.layouts.layoutCids[row])
        semanticLayout.typeCid =
            layout.FixedBytes32Copy(snapshot.types.typeCids[typeId])
        semanticLayout.declarationTableCid =
            layout.FixedBytes32Copy(snapshot.declarations.tableCid)
        if semanticLayout.declSymbolId >= 0:
            semanticLayout.declarationPresent = true
            semanticLayout.declId = snapshot.symbols.declIds[semanticLayout.declSymbolId]
            semanticLayout.declSymbolCid =
                layout.FixedBytes32Copy(
                    snapshot.symbols.symbolCids[
                        semanticLayout.declSymbolId])
            semanticLayout.declKeyCid =
                layout.FixedBytes32Copy(
                    snapshot.symbols.declKeyCids[
                        semanticLayout.declSymbolId])
        let typeNameTextId = snapshot.types.canonicalTextIds[typeId]
        semanticLayout.typeName =
            system.SystemToStringStr(snapshot.texts[typeNameTextId])
        semanticLayout.sizeBytes = snapshot.layouts.sizeBytes[row]
        semanticLayout.alignBytes = snapshot.layouts.alignBytes[row]
        semanticLayout.fieldStart = snapshot.layouts.fieldStarts[row]
        semanticLayout.fieldCount = snapshot.layouts.fieldCounts[row]
        fact.layoutFact = semanticLayout
        add(bundle.facts, fact)
    for row in 0..<snapshot.layoutFields.layoutIds.len:
        let symbolId = snapshot.layoutFields.fieldSymbolIds[row]
        let typeId = snapshot.layoutFields.typeIds[row]
        var fact = SemanticFactNew(SemanticFactKindLayoutField)
        var field: SemanticLayoutFieldFact
        field.layoutFieldId = row
        field.layoutId = snapshot.layoutFields.layoutIds[row]
        field.fieldSymbolId = symbolId
        field.fieldDeclId = snapshot.symbols.declIds[symbolId]
        field.typeId = typeId
        field.fieldSymbolCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.symbolCids[symbolId])
        field.fieldDeclKeyCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.declKeyCids[symbolId])
        field.declarationTableCid =
            layout.FixedBytes32Copy(snapshot.declarations.tableCid)
        field.typeCid =
            layout.FixedBytes32Copy(snapshot.types.typeCids[typeId])
        field.offsetBytes = snapshot.layoutFields.offsetBytes[row]
        field.sizeBytes = snapshot.layoutFields.sizeBytes[row]
        field.alignBytes = snapshot.layoutFields.alignBytes[row]
        fact.layoutFieldFact = field
        add(bundle.facts, fact)

    for row in 0..<snapshot.diagnostics.sourceIds.len:
        let sourceId = snapshot.diagnostics.sourceIds[row]
        let spanId = snapshot.diagnostics.spanIds[row]
        var fact = SemanticFactNew(SemanticFactKindDiagnostic)
        var diagnostic: SemanticDiagnosticFact
        diagnostic.diagnosticId = row
        diagnostic.sourceId = sourceId
        diagnostic.spanId = spanId
        diagnostic.documentCid =
            layout.FixedBytes32Copy(
                snapshot.sources.documentCids[sourceId])
        diagnostic.sourcePath = semanticFactSnapshotSourcePath(snapshot,
                                                                 sourceId)
        diagnostic.lineNumber = snapshot.spans.startLines[spanId]
        diagnostic.column = snapshot.spans.startColumns[spanId]
        diagnostic.producerKind = snapshot.diagnostics.producerKinds[row]
        diagnostic.severity = snapshot.diagnostics.severities[row]
        let codeTextId = snapshot.diagnostics.codeTextIds[row]
        let messageTextId = snapshot.diagnostics.messageTextIds[row]
        diagnostic.code =
            system.SystemToStringStr(snapshot.texts[codeTextId])
        diagnostic.message =
            system.SystemToStringStr(snapshot.texts[messageTextId])
        fact.semanticDiagnosticFact = diagnostic
        add(bundle.facts, fact)

    bundle.factCount = bundle.facts.len
    bundle.projectionCid = semanticFactSnapshotProjectionCid(
        predecessorReceiptCid, binding, validation)
    out = bundle
    err = ""
    return true

fn semanticFactsReportText(bundle: SemanticFactBundle): str =
    var out = strutil.Join(["semantic_fact_count=", IntToStr(bundle.factCount), "\n"], "")
    var typeCount: int32
    var importCount: int32
    var callGraphCount: int32
    var diagCount: int32
    for i in 0..<bundle.facts.len:
        let kind = bundle.facts[i].kind
        if kind == SemanticFactKindResolvedType:
            typeCount = typeCount + 1
        elif kind == SemanticFactKindResolvedImport:
            importCount = importCount + 1
        elif kind == SemanticFactKindCallGraph:
            callGraphCount = callGraphCount + 1
        elif kind == SemanticFactKindDiagnostic:
            diagCount = diagCount + 1
    out = strutil.Join([out, "resolved_type_fact_count=", IntToStr(typeCount), "\n"], "")
    out = strutil.Join([out, "resolved_import_fact_count=", IntToStr(importCount), "\n"], "")
    out = strutil.Join([out, "call_graph_edge_count=", IntToStr(callGraphCount), "\n"], "")
    out = strutil.Join([out, "semantic_diagnostic_count=", IntToStr(diagCount), "\n"], "")
    return out

fn semanticFactsBundleAppendText(bundle: SemanticFactBundle, text: var str) =
    text = strutil.Join([strings.CloneStr(text), semanticFactsReportText(bundle)], "")
