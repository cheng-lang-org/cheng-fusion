import std/seqs
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

const ObjectPlanOwnedStorageColumnCount: int32 = 20

type
    ObjectPlanReleaseReceipt =
        ownerToken: layout.FixedBytes32
        releasedOwnedStorageColumnCount: int32
        releasedBufferCount: int32
        releasedBytes: int64
        storageReleased: bool

    ObjectPlanStub =
        workspaceRoot: str
        packageRoot: str
        packageId: str
        entryPath: str
        outputPath: str
        targetTriple: str
        primaryObjectPath: str
        browserBridgeObjectPath: str
        linuxNolibcSupportEnabled: bool
        linuxNolibcRuntimeSourcePath: str
        linuxNolibcRuntimeObjectPath: str
        linuxNolibcStartupSourcePath: str
        linuxNolibcStartupObjectPath: str
        providerModules: str[]
        providerSourcePaths: str[]
        providerObjectPaths: str[]
        linkInputPaths: str[]
        loweredFunctionSymbols: str[]
        entrySymbol: str
        missingReasons: str[]
        pipelineStage: str
        terminalReleaseOwnerToken: layout.FixedBytes32
        terminalReleasedOwnedStorageColumnCount: int32
        terminalReleasedBufferCount: int32
        terminalReleasedBytes: int64
        terminalStorageReleased: bool
        terminalReleaseReceiptConsumed: bool

fn objectPlanAppendU32BE(buf: var layout.ByteBuf, value: int64) =
    layout.ByteBufAppendByte(buf, Int32((value >> 24) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 16) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 8) & 255))
    layout.ByteBufAppendByte(buf, Int32(value & 255))

@borrows
fn objectPlanAppendText(buf: var layout.ByteBuf, value: str) =
    objectPlanAppendU32BE(buf, value.len)
    for textIndex in 0..<value.len:
        layout.ByteBufAppendByte(buf, value[textIndex])

fn objectPlanAppendU32Field(
        buf: var layout.ByteBuf,
        value: int64) =
    objectPlanAppendU32BE(buf, 4)
    objectPlanAppendU32BE(buf, value)

fn objectPlanAppendI64Field(
        buf: var layout.ByteBuf,
        value: int64) =
    objectPlanAppendU32BE(buf, 8)
    objectPlanAppendU32BE(buf, value >> 32)
    objectPlanAppendU32BE(buf, value)

@borrows
fn objectPlanAppendTexts(
        buf: var layout.ByteBuf,
        values: str[]) =
    objectPlanAppendU32Field(buf, values.len)
    for valueIndex in 0..<values.len:
        objectPlanAppendText(buf, values[valueIndex])

fn objectPlanRecordStringArrayStorage(
        values: var str[],
        bufferCount: var int32,
        retainedBytes: var int64) =
    if values.cap < 0:
        panic("object plan: invalid owned sequence capacity")
    if values.cap > 0:
        bufferCount = bufferCount + 1
        retainedBytes =
            retainedBytes +
            int64(values.cap) * int64(sizeof(str))
    for valueIndex in 0..<values.len:
        retainedBytes =
            retainedBytes + int64(values[valueIndex].len)

fn ObjectPlanRetainedBufferCount(
        plan: var ObjectPlanStub): int32 =
    var bufferCount: int32
    var retainedBytes: int64
    objectPlanRecordStringArrayStorage(
        plan.providerModules, bufferCount, retainedBytes)
    objectPlanRecordStringArrayStorage(
        plan.providerSourcePaths, bufferCount, retainedBytes)
    objectPlanRecordStringArrayStorage(
        plan.providerObjectPaths, bufferCount, retainedBytes)
    objectPlanRecordStringArrayStorage(
        plan.linkInputPaths, bufferCount, retainedBytes)
    objectPlanRecordStringArrayStorage(
        plan.loweredFunctionSymbols, bufferCount, retainedBytes)
    objectPlanRecordStringArrayStorage(
        plan.missingReasons, bufferCount, retainedBytes)
    return bufferCount

fn ObjectPlanRetainedBytes(
        plan: var ObjectPlanStub): int64 =
    var bufferCount: int32
    var retainedBytes =
        int64(plan.workspaceRoot.len) +
        int64(plan.packageRoot.len) +
        int64(plan.packageId.len) +
        int64(plan.entryPath.len) +
        int64(plan.outputPath.len) +
        int64(plan.targetTriple.len) +
        int64(plan.primaryObjectPath.len) +
        int64(plan.browserBridgeObjectPath.len) +
        int64(plan.linuxNolibcRuntimeSourcePath.len) +
        int64(plan.linuxNolibcRuntimeObjectPath.len) +
        int64(plan.linuxNolibcStartupSourcePath.len) +
        int64(plan.linuxNolibcStartupObjectPath.len) +
        int64(plan.entrySymbol.len) +
        int64(plan.pipelineStage.len)
    objectPlanRecordStringArrayStorage(
        plan.providerModules, bufferCount, retainedBytes)
    objectPlanRecordStringArrayStorage(
        plan.providerSourcePaths, bufferCount, retainedBytes)
    objectPlanRecordStringArrayStorage(
        plan.providerObjectPaths, bufferCount, retainedBytes)
    objectPlanRecordStringArrayStorage(
        plan.linkInputPaths, bufferCount, retainedBytes)
    objectPlanRecordStringArrayStorage(
        plan.loweredFunctionSymbols, bufferCount, retainedBytes)
    objectPlanRecordStringArrayStorage(
        plan.missingReasons, bufferCount, retainedBytes)
    return retainedBytes

fn objectPlanReleaseOwnerToken(
        plan: var ObjectPlanStub,
        releasedBufferCount: int32,
        releasedBytes: int64): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(512)
    objectPlanAppendText(
        buf, "cheng.compiler.object_plan.owner_release")
    objectPlanAppendU32Field(
        buf, ObjectPlanOwnedStorageColumnCount)
    objectPlanAppendU32Field(buf, releasedBufferCount)
    objectPlanAppendI64Field(buf, releasedBytes)
    objectPlanAppendText(buf, plan.workspaceRoot)
    objectPlanAppendText(buf, plan.packageRoot)
    objectPlanAppendText(buf, plan.packageId)
    objectPlanAppendText(buf, plan.entryPath)
    objectPlanAppendText(buf, plan.outputPath)
    objectPlanAppendText(buf, plan.targetTriple)
    objectPlanAppendText(buf, plan.primaryObjectPath)
    objectPlanAppendText(buf, plan.browserBridgeObjectPath)
    objectPlanAppendU32Field(
        buf, plan.linuxNolibcSupportEnabled ? 1 : 0)
    objectPlanAppendText(
        buf, plan.linuxNolibcRuntimeSourcePath)
    objectPlanAppendText(
        buf, plan.linuxNolibcRuntimeObjectPath)
    objectPlanAppendText(
        buf, plan.linuxNolibcStartupSourcePath)
    objectPlanAppendText(
        buf, plan.linuxNolibcStartupObjectPath)
    objectPlanAppendTexts(buf, plan.providerModules)
    objectPlanAppendTexts(buf, plan.providerSourcePaths)
    objectPlanAppendTexts(buf, plan.providerObjectPaths)
    objectPlanAppendTexts(buf, plan.linkInputPaths)
    objectPlanAppendTexts(buf, plan.loweredFunctionSymbols)
    objectPlanAppendText(buf, plan.entrySymbol)
    objectPlanAppendTexts(buf, plan.missingReasons)
    objectPlanAppendText(buf, plan.pipelineStage)
    let token = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn ObjectPlanStorageReleased(
        plan: var ObjectPlanStub): bool =
    return plan.workspaceRoot.len == 0 &&
           plan.packageRoot.len == 0 &&
           plan.packageId.len == 0 &&
           plan.entryPath.len == 0 &&
           plan.outputPath.len == 0 &&
           plan.targetTriple.len == 0 &&
           plan.primaryObjectPath.len == 0 &&
           plan.browserBridgeObjectPath.len == 0 &&
           plan.linuxNolibcRuntimeSourcePath.len == 0 &&
           plan.linuxNolibcRuntimeObjectPath.len == 0 &&
           plan.linuxNolibcStartupSourcePath.len == 0 &&
           plan.linuxNolibcStartupObjectPath.len == 0 &&
           plan.providerModules.len == 0 &&
           plan.providerModules.cap == 0 &&
           plan.providerSourcePaths.len == 0 &&
           plan.providerSourcePaths.cap == 0 &&
           plan.providerObjectPaths.len == 0 &&
           plan.providerObjectPaths.cap == 0 &&
           plan.linkInputPaths.len == 0 &&
           plan.linkInputPaths.cap == 0 &&
           plan.loweredFunctionSymbols.len == 0 &&
           plan.loweredFunctionSymbols.cap == 0 &&
           plan.entrySymbol.len == 0 &&
           plan.missingReasons.len == 0 &&
           plan.missingReasons.cap == 0 &&
           plan.pipelineStage.len == 0

fn ObjectPlanReleaseWithReceipt(
        plan: var ObjectPlanStub,
        receipt: var ObjectPlanReleaseReceipt) =
    if plan.terminalStorageReleased ||
       plan.terminalReleaseReceiptConsumed ||
       !layout.FixedBytes32Equal(
           plan.terminalReleaseOwnerToken,
           layout.FixedBytes32()) ||
       plan.terminalReleasedOwnedStorageColumnCount != 0 ||
       plan.terminalReleasedBufferCount != 0 ||
       plan.terminalReleasedBytes != int64(0):
        panic("object plan: duplicate or corrupt terminal release")
    let releasedBufferCount =
        ObjectPlanRetainedBufferCount(plan)
    let releasedBytes = ObjectPlanRetainedBytes(plan)
    let ownerToken =
        objectPlanReleaseOwnerToken(
            plan, releasedBufferCount, releasedBytes)
    if layout.FixedBytes32Equal(
           ownerToken, layout.FixedBytes32()) ||
       releasedBufferCount < 0 ||
       releasedBytes < int64(0):
        panic("object plan: invalid terminal release preimage")
    plan.workspaceRoot = ""
    plan.packageRoot = ""
    plan.packageId = ""
    plan.entryPath = ""
    plan.outputPath = ""
    plan.targetTriple = ""
    plan.primaryObjectPath = ""
    plan.browserBridgeObjectPath = ""
    plan.linuxNolibcRuntimeSourcePath = ""
    plan.linuxNolibcRuntimeObjectPath = ""
    plan.linuxNolibcStartupSourcePath = ""
    plan.linuxNolibcStartupObjectPath = ""
    seqs.freeSeqStrRelease(plan.providerModules)
    seqs.freeSeqStrRelease(plan.providerSourcePaths)
    seqs.freeSeqStrRelease(plan.providerObjectPaths)
    seqs.freeSeqStrRelease(plan.linkInputPaths)
    seqs.freeSeqStrRelease(plan.loweredFunctionSymbols)
    plan.entrySymbol = ""
    seqs.freeSeqStrRelease(plan.missingReasons)
    plan.pipelineStage = ""
    plan.terminalReleaseOwnerToken = ownerToken
    plan.terminalReleasedOwnedStorageColumnCount =
        ObjectPlanOwnedStorageColumnCount
    plan.terminalReleasedBufferCount = releasedBufferCount
    plan.terminalReleasedBytes = releasedBytes
    plan.terminalStorageReleased =
        ObjectPlanStorageReleased(plan)
    receipt.ownerToken = ownerToken
    receipt.releasedOwnedStorageColumnCount =
        ObjectPlanOwnedStorageColumnCount
    receipt.releasedBufferCount = releasedBufferCount
    receipt.releasedBytes = releasedBytes
    receipt.storageReleased = plan.terminalStorageReleased
    if !receipt.storageReleased ||
       ObjectPlanRetainedBufferCount(plan) != 0 ||
       ObjectPlanRetainedBytes(plan) != int64(0):
        panic("object plan: terminal storage release incomplete")

fn ObjectPlanReleaseReceiptConsumeStrictInto(
        plan: var ObjectPlanStub,
        receipt: var ObjectPlanReleaseReceipt,
        err: var str): bool =
    err = ""
    if !plan.terminalStorageReleased ||
       plan.terminalReleaseReceiptConsumed ||
       !receipt.storageReleased ||
       receipt.releasedOwnedStorageColumnCount !=
           ObjectPlanOwnedStorageColumnCount ||
       receipt.releasedOwnedStorageColumnCount !=
           plan.terminalReleasedOwnedStorageColumnCount ||
       receipt.releasedBufferCount !=
           plan.terminalReleasedBufferCount ||
       receipt.releasedBytes !=
           plan.terminalReleasedBytes ||
       !layout.FixedBytes32Equal(
           receipt.ownerToken,
           plan.terminalReleaseOwnerToken) ||
       !ObjectPlanStorageReleased(plan) ||
       ObjectPlanRetainedBufferCount(plan) != 0 ||
       ObjectPlanRetainedBytes(plan) != int64(0):
        err = "object plan: terminal release receipt mismatch"
        return false
    plan.terminalReleaseReceiptConsumed = true
    return true
