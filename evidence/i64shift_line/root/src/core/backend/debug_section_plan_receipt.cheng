import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import std/strings
import std/system
import cheng/core/backend/debug_facts as debug
import cheng/core/backend/debug_emission_plan_evidence as evidence
import cheng/core/ir/core_types as coreir
import cheng/core/backend/semantic_snapshot_debug_binding_receipt as bindingreceipt

type
    DebugSectionPlanFunctionRow =
        functionIndex: int32
        functionId: int32
        functionDeclId: int32
        functionSymbolId: int32
        functionSymbolName: str
        sourceId: int32
        documentCid: layout.FixedBytes32
        functionDeclKeyCid: layout.FixedBytes32
        functionSymbolCid: layout.FixedBytes32
        bodyStartLine: int32
        bodyStartColumn: int32
        bodyEndLine: int32
        bodyEndColumn: int32
        symbolByteStart: int32
        symbolByteLength: int32
        plannedSymbolBytesSha256: str
        bodyIrSha256: str
        frozenPlanSha256: str
        regallocPlanSha256: str
        emissionLedgerSha256: str
        actionSemanticRootSha256: str
        actionBindingRootSha256: str
        machineFragmentRootSha256: str
        abiIngressRootSha256: str
        debugProvenanceSha256: str
        debugMachineFragmentRootSha256: str
        rowStart: int32
        rowCount: int32

    DebugSectionPlanRow =
        functionIndex: int32
        functionId: int32
        functionDeclId: int32
        functionSymbolId: int32
        functionDeclKeyCid: layout.FixedBytes32
        functionSymbolCid: layout.FixedBytes32
        debugOpId: int32 = -1
        debugSyntheticKind: int32
        typedNodeId: int32 = -1
        typedIrNodeIndex: int32 = -1
        originParserNodeId: int32 = -1
        typedSyntheticOriginKind: int32
        typedSpanAuthorityKind: int32
        sourceId: int32 = -1
        spanId: int32 = -1
        documentCid: layout.FixedBytes32
        startLine: int32
        startColumn: int32
        endLine: int32
        endColumn: int32
        siteKind: int32
        siteIndex: int32 = -1
        machineOwnerKind: int32
        machineOwnerOrdinal: int32 = -1
        actionConsumerOrdinal: int32 = -1
        textSectionRelativeByteStart: int32
        byteLength: int32
        plannedBytesSha256: str

    # Pre-object authority for .debug_line/.debug_info construction. It binds
    # semantic declaration identity to canonical regalloc fragment ranges but
    # deliberately has no object CID/file offset; those belong only to the
    # post-write DebugObjectEmissionReceipt.
    DebugSectionPlanReceipt =
        valid: bool
        backendKind: str
        sourceVersion: int64
        packageId: str
        debugBindingReceiptCid: layout.FixedBytes32
        bindingReceiptCid: layout.FixedBytes32
        semanticSnapshotCid: layout.FixedBytes32
        worldHeadCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        csgRootCid: layout.FixedBytes32
        validationReceiptCid: layout.FixedBytes32
        debugProjectionCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        declarationIdentityCid: layout.FixedBytes32
        # Canonical source identity projection. Each sourceId appears exactly
        # once in ascending order; function/operation rows retain only the
        # int32 identity and exact document CID.
        sourceIds: int32[]
        sourceModulePaths: str[]
        sourceDocumentCids: layout.FixedBytes32[]
        # Exact semantic names aligned one-to-one with functions. Link symbols
        # remain in DebugSectionPlanFunctionRow and are a distinct identity.
        functionNames: str[]
        functions: DebugSectionPlanFunctionRow[]
        rows: DebugSectionPlanRow[]
        receiptCid: layout.FixedBytes32

fn debugSectionPlanAppendI32(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn debugSectionPlanAppendI64(buf: var layout.ByteBuf, value: int64) =
    let raw = UInt64(value)
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(56)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32(raw & UInt64(255)))

@borrows
fn debugSectionPlanAppendText(buf: var layout.ByteBuf, value: str) =
    debugSectionPlanAppendI32(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

@borrows
fn debugSectionPlanAppendCid(buf: var layout.ByteBuf,
                             value: layout.FixedBytes32) =
    layout.ByteBufAppendFixed32(buf, value)

@borrows
fn debugSectionPlanSha256Valid(value: str): bool =
    if value.len != 64:
        return false
    for index in 0..<value.len:
        let ch = value[index]
        if !((ch >= '0' && ch <= '9') ||
             (ch >= 'a' && ch <= 'f')):
            return false
    return true

@borrows
fn debugSectionPlanEvidenceShapeValid(
        plan: evidence.DebugEmissionPlanEvidence): bool =
    let functionCount = plan.symbolNames.len
    let rowCount = plan.fragmentDebugOpIds.len
    return functionCount > 0 && plan.backendKind != "" &&
           plan.functionWordOffsets.len == functionCount &&
           plan.functionWordCounts.len == functionCount &&
           plan.frozenSnapshotPayloads.len == functionCount &&
           plan.emissionLedgerPayloads.len == functionCount &&
           plan.bodyIrSha256s.len == functionCount &&
           plan.symbolByteStarts.len == functionCount &&
           plan.symbolByteLengths.len == functionCount &&
           plan.symbolBytesSha256s.len == functionCount &&
           plan.planSha256s.len == functionCount &&
           plan.actionSemanticRootSha256s.len == functionCount &&
           plan.actionBindingRootSha256s.len == functionCount &&
           plan.machineFragmentRootSha256s.len == functionCount &&
           plan.abiIngressRootSha256s.len == functionCount &&
           plan.debugProvenanceBound.len == functionCount &&
           plan.debugFunctionIds.len == functionCount &&
           plan.debugProvenanceSha256s.len == functionCount &&
           plan.debugMachineFragmentRootSha256s.len == functionCount &&
           plan.debugFragmentStarts.len == functionCount &&
           plan.debugFragmentCounts.len == functionCount &&
           plan.fragmentFunctionIndexes.len == rowCount &&
           plan.fragmentSyntheticKinds.len == rowCount &&
           plan.fragmentSiteKinds.len == rowCount &&
           plan.fragmentSiteIndexes.len == rowCount &&
           plan.fragmentMachineOwnerKinds.len == rowCount &&
           plan.fragmentMachineOwnerOrdinals.len == rowCount &&
           plan.fragmentActionConsumerOrdinals.len == rowCount &&
           plan.fragmentTextByteStarts.len == rowCount &&
           plan.fragmentByteLengths.len == rowCount &&
           plan.fragmentBytesSha256s.len == rowCount

@borrows
fn debugSectionPlanReceiptCid(
        receipt: DebugSectionPlanReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(
        768 + receipt.sourceIds.len * 96 +
            receipt.functions.len * 416 + receipt.rows.len * 192)
    debugSectionPlanAppendText(buf, "cheng.debug_section_plan_receipt")
    debugSectionPlanAppendText(buf, receipt.backendKind)
    debugSectionPlanAppendI64(buf, receipt.sourceVersion)
    debugSectionPlanAppendText(buf, receipt.packageId)
    debugSectionPlanAppendCid(buf, receipt.debugBindingReceiptCid)
    debugSectionPlanAppendCid(buf, receipt.bindingReceiptCid)
    debugSectionPlanAppendCid(buf, receipt.semanticSnapshotCid)
    debugSectionPlanAppendCid(buf, receipt.worldHeadCid)
    debugSectionPlanAppendCid(buf, receipt.compilerCid)
    debugSectionPlanAppendCid(buf, receipt.sourceBundleCid)
    debugSectionPlanAppendCid(buf, receipt.csgRootCid)
    debugSectionPlanAppendCid(buf, receipt.validationReceiptCid)
    debugSectionPlanAppendCid(buf, receipt.debugProjectionCid)
    debugSectionPlanAppendCid(buf, receipt.declarationTableCid)
    debugSectionPlanAppendCid(buf, receipt.declarationIdentityCid)
    debugSectionPlanAppendI32(buf, receipt.sourceIds.len)
    for index in 0..<receipt.sourceIds.len:
        debugSectionPlanAppendI32(buf, receipt.sourceIds[index])
        debugSectionPlanAppendText(buf, receipt.sourceModulePaths[index])
        debugSectionPlanAppendCid(buf, receipt.sourceDocumentCids[index])
    debugSectionPlanAppendI32(buf, receipt.functions.len)
    for index in 0..<receipt.functions.len:
        let row = receipt.functions[index]
        debugSectionPlanAppendText(buf, receipt.functionNames[index])
        debugSectionPlanAppendI32(buf, row.functionIndex)
        debugSectionPlanAppendI32(buf, row.functionId)
        debugSectionPlanAppendI32(buf, row.functionDeclId)
        debugSectionPlanAppendI32(buf, row.functionSymbolId)
        debugSectionPlanAppendText(buf, row.functionSymbolName)
        debugSectionPlanAppendI32(buf, row.sourceId)
        debugSectionPlanAppendCid(buf, row.documentCid)
        debugSectionPlanAppendCid(buf, row.functionDeclKeyCid)
        debugSectionPlanAppendCid(buf, row.functionSymbolCid)
        debugSectionPlanAppendI32(buf, row.bodyStartLine)
        debugSectionPlanAppendI32(buf, row.bodyStartColumn)
        debugSectionPlanAppendI32(buf, row.bodyEndLine)
        debugSectionPlanAppendI32(buf, row.bodyEndColumn)
        debugSectionPlanAppendI32(buf, row.symbolByteStart)
        debugSectionPlanAppendI32(buf, row.symbolByteLength)
        debugSectionPlanAppendText(buf, row.plannedSymbolBytesSha256)
        debugSectionPlanAppendText(buf, row.bodyIrSha256)
        debugSectionPlanAppendText(buf, row.frozenPlanSha256)
        debugSectionPlanAppendText(buf, row.regallocPlanSha256)
        debugSectionPlanAppendText(buf, row.emissionLedgerSha256)
        debugSectionPlanAppendText(buf, row.actionSemanticRootSha256)
        debugSectionPlanAppendText(buf, row.actionBindingRootSha256)
        debugSectionPlanAppendText(buf, row.machineFragmentRootSha256)
        debugSectionPlanAppendText(buf, row.abiIngressRootSha256)
        debugSectionPlanAppendText(buf, row.debugProvenanceSha256)
        debugSectionPlanAppendText(buf, row.debugMachineFragmentRootSha256)
        debugSectionPlanAppendI32(buf, row.rowStart)
        debugSectionPlanAppendI32(buf, row.rowCount)
    debugSectionPlanAppendI32(buf, receipt.rows.len)
    for index in 0..<receipt.rows.len:
        let row = receipt.rows[index]
        debugSectionPlanAppendI32(buf, row.functionIndex)
        debugSectionPlanAppendI32(buf, row.functionId)
        debugSectionPlanAppendI32(buf, row.functionDeclId)
        debugSectionPlanAppendI32(buf, row.functionSymbolId)
        debugSectionPlanAppendCid(buf, row.functionDeclKeyCid)
        debugSectionPlanAppendCid(buf, row.functionSymbolCid)
        debugSectionPlanAppendI32(buf, row.debugOpId)
        debugSectionPlanAppendI32(buf, row.debugSyntheticKind)
        debugSectionPlanAppendI32(buf, row.typedNodeId)
        debugSectionPlanAppendI32(buf, row.typedIrNodeIndex)
        debugSectionPlanAppendI32(buf, row.originParserNodeId)
        debugSectionPlanAppendI32(buf, row.typedSyntheticOriginKind)
        debugSectionPlanAppendI32(buf, row.typedSpanAuthorityKind)
        debugSectionPlanAppendI32(buf, row.sourceId)
        debugSectionPlanAppendI32(buf, row.spanId)
        debugSectionPlanAppendCid(buf, row.documentCid)
        debugSectionPlanAppendI32(buf, row.startLine)
        debugSectionPlanAppendI32(buf, row.startColumn)
        debugSectionPlanAppendI32(buf, row.endLine)
        debugSectionPlanAppendI32(buf, row.endColumn)
        debugSectionPlanAppendI32(buf, row.siteKind)
        debugSectionPlanAppendI32(buf, row.siteIndex)
        debugSectionPlanAppendI32(buf, row.machineOwnerKind)
        debugSectionPlanAppendI32(buf, row.machineOwnerOrdinal)
        debugSectionPlanAppendI32(buf, row.actionConsumerOrdinal)
        debugSectionPlanAppendI32(buf, row.textSectionRelativeByteStart)
        debugSectionPlanAppendI32(buf, row.byteLength)
        debugSectionPlanAppendText(buf, row.plannedBytesSha256)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn debugSectionPlanOperationFactInto(
        facts: debug.DebugFactBundle,
        debugOpId: int32,
        out: var debug.DebugOperationFact): bool =
    out = debug.DebugOperationFact()
    if debugOpId < 0 || debugOpId >= facts.debugOpCount:
        return false
    let factIndex = facts.functionCount + debugOpId
    if factIndex < 0 || factIndex >= facts.facts.len:
        return false
    let fact = facts.facts[factIndex]
    if fact.kind != debug.DebugFactKindOperation:
        return false
    let operation = fact.operationFact
    if operation.debugOpId != debugOpId:
        return false
    var owned: debug.DebugOperationFact
    owned.debugOpId = operation.debugOpId
    owned.typedNodeId = operation.typedNodeId
    owned.typedIrNodeIndex = operation.typedIrNodeIndex
    owned.originParserNodeId = operation.originParserNodeId
    owned.syntheticOriginKind = operation.syntheticOriginKind
    owned.spanAuthorityKind = operation.spanAuthorityKind
    owned.functionId = operation.functionId
    owned.functionDeclId = operation.functionDeclId
    owned.functionSymbolId = operation.functionSymbolId
    owned.symbolDeclId = operation.symbolDeclId
    owned.symbolId = operation.symbolId
    owned.sourceId = operation.sourceId
    owned.spanId = operation.spanId
    owned.opKind = operation.opKind
    owned.typedOpKind = operation.typedOpKind
    owned.typeId = operation.typeId
    owned.ownershipKind = operation.ownershipKind
    owned.documentCid = layout.FixedBytes32Copy(operation.documentCid)
    owned.functionDeclKeyCid =
        layout.FixedBytes32Copy(operation.functionDeclKeyCid)
    owned.functionSymbolCid =
        layout.FixedBytes32Copy(operation.functionSymbolCid)
    owned.symbolDeclKeyCid =
        layout.FixedBytes32Copy(operation.symbolDeclKeyCid)
    owned.symbolCid = layout.FixedBytes32Copy(operation.symbolCid)
    owned.modulePath = system.SystemToStringStr(operation.modulePath)
    owned.startByte = operation.startByte
    owned.endByte = operation.endByte
    owned.startLine = operation.startLine
    owned.startColumn = operation.startColumn
    owned.endLine = operation.endLine
    owned.endColumn = operation.endColumn
    out = owned
    return true

@borrows
fn debugSectionPlanObserveSourceInto(
        sourceId: int32,
        modulePath: str,
        documentCid: layout.FixedBytes32,
        sourceSeen: var bool[],
        sourceModulePaths: var str[],
        sourceDocumentCids: var layout.FixedBytes32[],
        err: var str): bool =
    if sourceId < 0 || sourceId >= sourceSeen.len ||
       sourceSeen.len != sourceModulePaths.len ||
       sourceSeen.len != sourceDocumentCids.len ||
       modulePath == "" ||
       layout.FixedBytes32Equal(documentCid, layout.FixedBytes32()):
        err = " debug section plan: invalid source identity"
        return false
    if !sourceSeen[sourceId]:
        sourceSeen[sourceId] = true
        sourceModulePaths[sourceId] =
            system.SystemToStringStr(modulePath)
        sourceDocumentCids[sourceId] =
            layout.FixedBytes32Copy(documentCid)
        return true
    if sourceModulePaths[sourceId] != modulePath ||
       !layout.FixedBytes32Equal(
           sourceDocumentCids[sourceId], documentCid):
        err = " debug section plan: split source identity"
        return false
    return true

@borrows
fn debugSectionPlanBuildExactInto(
        debugBinding: bindingreceipt.SemanticSnapshotDebugBindingReceipt,
        facts: debug.DebugFactBundle,
        plan: evidence.DebugEmissionPlanEvidence,
        out: var DebugSectionPlanReceipt,
        err: var str): bool =
    out = DebugSectionPlanReceipt()
    err = ""
    if !bindingreceipt.SemanticSnapshotDebugBindingReceiptValidateFactsInto(
           debugBinding, facts, err):
        return false
    if !debugSectionPlanEvidenceShapeValid(plan) ||
       (plan.backendKind != "primary" && plan.backendKind != "backend2"):
        err = " debug section plan: invalid production evidence shape"
        return false
    out.backendKind = system.SystemToStringStr(plan.backendKind)
    out.sourceVersion = facts.sourceVersion
    out.packageId = system.SystemToStringStr(facts.packageId)
    out.debugBindingReceiptCid =
        layout.FixedBytes32Copy(debugBinding.receiptCid)
    out.bindingReceiptCid =
        layout.FixedBytes32Copy(facts.bindingReceiptCid)
    out.semanticSnapshotCid =
        layout.FixedBytes32Copy(facts.semanticSnapshotCid)
    out.worldHeadCid = layout.FixedBytes32Copy(facts.worldHeadCid)
    out.compilerCid = layout.FixedBytes32Copy(facts.compilerCid)
    out.sourceBundleCid =
        layout.FixedBytes32Copy(facts.sourceBundleCid)
    out.csgRootCid = layout.FixedBytes32Copy(facts.csgRootCid)
    out.validationReceiptCid =
        layout.FixedBytes32Copy(facts.validationReceiptCid)
    out.debugProjectionCid =
        layout.FixedBytes32Copy(facts.projectionCid)
    out.declarationTableCid =
        layout.FixedBytes32Copy(facts.declarationTableCid)
    out.declarationIdentityCid =
        layout.FixedBytes32Copy(facts.declarationIdentityCid)
    var sourceSeen: bool[]
    var sourceModulePaths: str[]
    var sourceDocumentCids: layout.FixedBytes32[]
    setLen(sourceSeen, facts.sourceCount)
    setLen(sourceModulePaths, facts.sourceCount)
    setLen(sourceDocumentCids, facts.sourceCount)
    var seenFunctionIds: bool[]
    setLen(seenFunctionIds, facts.functionCount)
    var expectedRowStart: int32
    var hasPreviousFunctionRange = false
    var previousFunctionEnd: int32
    for functionIndex in 0..<plan.symbolNames.len:
        let functionId = plan.debugFunctionIds[functionIndex]
        let rowStart = plan.debugFragmentStarts[functionIndex]
        let rowCount = plan.debugFragmentCounts[functionIndex]
        if !plan.debugProvenanceBound[functionIndex]:
            if functionId != -1 || rowStart != expectedRowStart ||
               rowCount != 0 ||
               plan.debugMachineFragmentRootSha256s[functionIndex] != "":
                err = " debug section plan: unbound function carries debug rows"
                return false
            continue
        if functionId < 0 || functionId >= facts.functionCount ||
           seenFunctionIds[functionId] || rowCount <= 0 ||
           rowStart != expectedRowStart ||
           rowStart > plan.fragmentDebugOpIds.len - rowCount ||
           functionId >= facts.facts.len:
            err = " debug section plan: invalid function identity or row range"
            return false
        let functionFactRow = facts.facts[functionId]
        if functionFactRow.kind != debug.DebugFactKindFunction:
            err = " debug section plan: invalid FunctionId row"
            return false
        let functionFact = functionFactRow.functionFact
        if functionFact.functionId != functionId:
            err = " debug section plan: invalid FunctionId row"
            return false
        if !debugSectionPlanObserveSourceInto(
               functionFact.sourceId,
               functionFact.modulePath,
               functionFact.documentCid,
               sourceSeen,
               sourceModulePaths,
               sourceDocumentCids,
               err):
            return false
        if plan.functionWordOffsets[functionIndex] < 0 ||
           plan.functionWordOffsets[functionIndex] > 536870911 ||
           plan.functionWordCounts[functionIndex] <= 0 ||
           plan.functionWordCounts[functionIndex] > 536870911 ||
           plan.symbolByteStarts[functionIndex] !=
               plan.functionWordOffsets[functionIndex] * 4 ||
           plan.symbolByteLengths[functionIndex] !=
               plan.functionWordCounts[functionIndex] * 4 ||
           plan.symbolByteStarts[functionIndex] >
               2147483647 - plan.symbolByteLengths[functionIndex] ||
           (hasPreviousFunctionRange &&
            plan.symbolByteStarts[functionIndex] < previousFunctionEnd) ||
           !debugSectionPlanSha256Valid(
               plan.bodyIrSha256s[functionIndex]) ||
           !debugSectionPlanSha256Valid(
               plan.planSha256s[functionIndex]) ||
           !debugSectionPlanSha256Valid(
               plan.symbolBytesSha256s[functionIndex]) ||
           !debugSectionPlanSha256Valid(strings.Sha256(
               plan.frozenSnapshotPayloads[functionIndex])) ||
           !debugSectionPlanSha256Valid(strings.Sha256(
               plan.emissionLedgerPayloads[functionIndex])) ||
           !debugSectionPlanSha256Valid(
               plan.actionSemanticRootSha256s[functionIndex]) ||
           !debugSectionPlanSha256Valid(
               plan.actionBindingRootSha256s[functionIndex]) ||
           !debugSectionPlanSha256Valid(
               plan.machineFragmentRootSha256s[functionIndex]) ||
           !debugSectionPlanSha256Valid(
               plan.abiIngressRootSha256s[functionIndex]) ||
           !debugSectionPlanSha256Valid(
               plan.debugProvenanceSha256s[functionIndex]) ||
           !debugSectionPlanSha256Valid(
               plan.debugMachineFragmentRootSha256s[functionIndex]) ||
           evidence.DebugEmissionPlanEvidenceDebugMachineFragmentRootSha256(
               plan, functionIndex) !=
               plan.debugMachineFragmentRootSha256s[functionIndex]:
            err = " debug section plan: function plan evidence mismatch"
            return false
        var functionRow: DebugSectionPlanFunctionRow
        functionRow.functionIndex = functionIndex
        functionRow.functionId = functionId
        functionRow.functionDeclId = functionFact.declId
        functionRow.functionSymbolId = functionFact.symbolId
        functionRow.functionSymbolName =
            system.SystemToStringStr(plan.symbolNames[functionIndex])
        functionRow.sourceId = functionFact.sourceId
        functionRow.documentCid =
            layout.FixedBytes32Copy(functionFact.documentCid)
        functionRow.functionDeclKeyCid =
            layout.FixedBytes32Copy(functionFact.declKeyCid)
        functionRow.functionSymbolCid =
            layout.FixedBytes32Copy(functionFact.symbolCid)
        functionRow.bodyStartLine = functionFact.bodyStartLine
        functionRow.bodyStartColumn = functionFact.bodyStartColumn
        functionRow.bodyEndLine = functionFact.bodyEndLine
        functionRow.bodyEndColumn = functionFact.bodyEndColumn
        functionRow.symbolByteStart = plan.symbolByteStarts[functionIndex]
        functionRow.symbolByteLength = plan.symbolByteLengths[functionIndex]
        functionRow.plannedSymbolBytesSha256 =
            system.SystemToStringStr(
                plan.symbolBytesSha256s[functionIndex])
        functionRow.bodyIrSha256 =
            system.SystemToStringStr(plan.bodyIrSha256s[functionIndex])
        functionRow.frozenPlanSha256 = strings.Sha256(
            plan.frozenSnapshotPayloads[functionIndex])
        functionRow.regallocPlanSha256 =
            system.SystemToStringStr(plan.planSha256s[functionIndex])
        functionRow.emissionLedgerSha256 = strings.Sha256(
            plan.emissionLedgerPayloads[functionIndex])
        functionRow.actionSemanticRootSha256 =
            system.SystemToStringStr(
                plan.actionSemanticRootSha256s[functionIndex])
        functionRow.actionBindingRootSha256 =
            system.SystemToStringStr(
                plan.actionBindingRootSha256s[functionIndex])
        functionRow.machineFragmentRootSha256 =
            system.SystemToStringStr(
                plan.machineFragmentRootSha256s[functionIndex])
        functionRow.abiIngressRootSha256 =
            system.SystemToStringStr(
                plan.abiIngressRootSha256s[functionIndex])
        functionRow.debugProvenanceSha256 =
            system.SystemToStringStr(
                plan.debugProvenanceSha256s[functionIndex])
        functionRow.debugMachineFragmentRootSha256 =
            system.SystemToStringStr(
                plan.debugMachineFragmentRootSha256s[functionIndex])
        functionRow.rowStart = out.rows.len
        functionRow.rowCount = rowCount
        var previousFragmentEnd = functionRow.symbolByteStart
        for rowOffset in 0..<rowCount:
            let rowIndex = rowStart + rowOffset
            if plan.fragmentFunctionIndexes[rowIndex] != functionIndex ||
               plan.fragmentByteLengths[rowIndex] <= 0 ||
               plan.fragmentTextByteStarts[rowIndex] <
                   functionRow.symbolByteStart ||
               plan.fragmentTextByteStarts[rowIndex] < previousFragmentEnd ||
               plan.fragmentTextByteStarts[rowIndex] >
                   2147483647 - plan.fragmentByteLengths[rowIndex] ||
               plan.fragmentTextByteStarts[rowIndex] >
                   functionRow.symbolByteStart +
                       functionRow.symbolByteLength -
                       plan.fragmentByteLengths[rowIndex] ||
               !debugSectionPlanSha256Valid(
                   plan.fragmentBytesSha256s[rowIndex]):
                err = " debug section plan: fragment PC range mismatch"
                return false
            var row: DebugSectionPlanRow
            row.functionIndex = functionIndex
            row.functionId = functionId
            row.functionDeclId = functionFact.declId
            row.functionSymbolId = functionFact.symbolId
            row.functionDeclKeyCid =
                layout.FixedBytes32Copy(functionFact.declKeyCid)
            row.functionSymbolCid =
                layout.FixedBytes32Copy(functionFact.symbolCid)
            row.debugOpId = plan.fragmentDebugOpIds[rowIndex]
            row.debugSyntheticKind = plan.fragmentSyntheticKinds[rowIndex]
            row.typedNodeId = -1
            row.typedIrNodeIndex = -1
            row.originParserNodeId = -1
            row.sourceId = -1
            row.spanId = -1
            row.siteIndex = -1
            row.machineOwnerOrdinal = -1
            row.actionConsumerOrdinal = -1
            row.siteKind = plan.fragmentSiteKinds[rowIndex]
            row.siteIndex = plan.fragmentSiteIndexes[rowIndex]
            row.machineOwnerKind =
                plan.fragmentMachineOwnerKinds[rowIndex]
            row.machineOwnerOrdinal =
                plan.fragmentMachineOwnerOrdinals[rowIndex]
            row.actionConsumerOrdinal =
                plan.fragmentActionConsumerOrdinals[rowIndex]
            row.textSectionRelativeByteStart =
                plan.fragmentTextByteStarts[rowIndex]
            row.byteLength = plan.fragmentByteLengths[rowIndex]
            row.plannedBytesSha256 =
                system.SystemToStringStr(
                    plan.fragmentBytesSha256s[rowIndex])
            if row.debugOpId >= 0:
                var operation: debug.DebugOperationFact
                if !debugSectionPlanOperationFactInto(
                       facts, row.debugOpId, operation) ||
                   operation.functionId != functionId ||
                   operation.functionDeclId != row.functionDeclId ||
                   operation.functionSymbolId != row.functionSymbolId ||
                   !layout.FixedBytes32Equal(
                       operation.functionDeclKeyCid,
                       row.functionDeclKeyCid) ||
                   !layout.FixedBytes32Equal(
                       operation.functionSymbolCid,
                       row.functionSymbolCid):
                    err = " debug section plan: DebugOp declaration join mismatch"
                    return false
                row.typedNodeId = operation.typedNodeId
                row.typedIrNodeIndex = operation.typedIrNodeIndex
                row.originParserNodeId = operation.originParserNodeId
                row.typedSyntheticOriginKind = operation.syntheticOriginKind
                row.typedSpanAuthorityKind = operation.spanAuthorityKind
                row.sourceId = operation.sourceId
                row.spanId = operation.spanId
                row.documentCid =
                    layout.FixedBytes32Copy(operation.documentCid)
                row.startLine = operation.startLine
                row.startColumn = operation.startColumn
                row.endLine = operation.endLine
                row.endColumn = operation.endColumn
                if !debugSectionPlanObserveSourceInto(
                       operation.sourceId,
                       operation.modulePath,
                       operation.documentCid,
                       sourceSeen,
                       sourceModulePaths,
                       sourceDocumentCids,
                       err):
                    return false
            elif row.debugSyntheticKind < coreir.BodyDebugSyntheticCleanup ||
                 row.debugSyntheticKind > coreir.BodyDebugSyntheticRuntime:
                err = " debug section plan: unproved synthetic fragment"
                return false
            add(out.rows, share(row))
            previousFragmentEnd =
                row.textSectionRelativeByteStart + row.byteLength
        add(out.functionNames,
            system.SystemToStringStr(functionFact.functionName))
        add(out.functions, share(functionRow))
        seenFunctionIds[functionId] = true
        expectedRowStart = rowStart + rowCount
        previousFunctionEnd =
            functionRow.symbolByteStart + functionRow.symbolByteLength
        hasPreviousFunctionRange = true
    if out.functions.len != facts.functionCount ||
       out.functionNames.len != out.functions.len ||
       expectedRowStart != plan.fragmentDebugOpIds.len:
        err = " debug section plan: incomplete DebugFact coverage"
        return false
    for sourceId in 0..<facts.sourceCount:
        if sourceSeen[sourceId]:
            add(out.sourceIds, sourceId)
            add(out.sourceModulePaths, share(sourceModulePaths[sourceId]))
            add(out.sourceDocumentCids, sourceDocumentCids[sourceId])
    if out.sourceIds.len <= 0:
        err = " debug section plan: empty source identity projection"
        return false
    out.receiptCid = debugSectionPlanReceiptCid(out)
    out.valid = true
    return true

@borrows
fn DebugSectionPlanReceiptBuildInto(
        debugBinding: bindingreceipt.SemanticSnapshotDebugBindingReceipt,
        facts: debug.DebugFactBundle,
        plan: evidence.DebugEmissionPlanEvidence,
        out: var DebugSectionPlanReceipt,
        err: var str): bool =
    return debugSectionPlanBuildExactInto(
        debugBinding, facts, plan, out, err)

@borrows
fn debugSectionPlanFunctionRowsEqual(
        left: DebugSectionPlanFunctionRow[],
        right: DebugSectionPlanFunctionRow[]): bool =
    if left.len != right.len:
        return false
    for index in 0..<left.len:
        if left[index].functionIndex != right[index].functionIndex ||
           left[index].functionId != right[index].functionId ||
           left[index].functionDeclId != right[index].functionDeclId ||
           left[index].functionSymbolId != right[index].functionSymbolId ||
           left[index].functionSymbolName !=
               right[index].functionSymbolName ||
           left[index].sourceId != right[index].sourceId ||
           !layout.FixedBytes32Equal(left[index].documentCid,
                                     right[index].documentCid) ||
           !layout.FixedBytes32Equal(
               left[index].functionDeclKeyCid,
               right[index].functionDeclKeyCid) ||
           !layout.FixedBytes32Equal(
               left[index].functionSymbolCid,
               right[index].functionSymbolCid) ||
           left[index].bodyStartLine != right[index].bodyStartLine ||
           left[index].bodyStartColumn != right[index].bodyStartColumn ||
           left[index].bodyEndLine != right[index].bodyEndLine ||
           left[index].bodyEndColumn != right[index].bodyEndColumn ||
           left[index].symbolByteStart != right[index].symbolByteStart ||
           left[index].symbolByteLength != right[index].symbolByteLength ||
           left[index].plannedSymbolBytesSha256 !=
               right[index].plannedSymbolBytesSha256 ||
           left[index].bodyIrSha256 != right[index].bodyIrSha256 ||
           left[index].frozenPlanSha256 != right[index].frozenPlanSha256 ||
           left[index].regallocPlanSha256 !=
               right[index].regallocPlanSha256 ||
           left[index].emissionLedgerSha256 !=
               right[index].emissionLedgerSha256 ||
           left[index].actionSemanticRootSha256 !=
               right[index].actionSemanticRootSha256 ||
           left[index].actionBindingRootSha256 !=
               right[index].actionBindingRootSha256 ||
           left[index].machineFragmentRootSha256 !=
               right[index].machineFragmentRootSha256 ||
           left[index].abiIngressRootSha256 !=
               right[index].abiIngressRootSha256 ||
           left[index].debugProvenanceSha256 !=
               right[index].debugProvenanceSha256 ||
           left[index].debugMachineFragmentRootSha256 !=
               right[index].debugMachineFragmentRootSha256 ||
           left[index].rowStart != right[index].rowStart ||
           left[index].rowCount != right[index].rowCount:
            return false
    return true

@borrows
fn debugSectionPlanRowsEqual(left: DebugSectionPlanRow[],
                             right: DebugSectionPlanRow[]): bool =
    if left.len != right.len:
        return false
    for index in 0..<left.len:
        if left[index].functionIndex != right[index].functionIndex ||
           left[index].functionId != right[index].functionId ||
           left[index].functionDeclId != right[index].functionDeclId ||
           left[index].functionSymbolId != right[index].functionSymbolId ||
           !layout.FixedBytes32Equal(
               left[index].functionDeclKeyCid,
               right[index].functionDeclKeyCid) ||
           !layout.FixedBytes32Equal(
               left[index].functionSymbolCid,
               right[index].functionSymbolCid) ||
           left[index].debugOpId != right[index].debugOpId ||
           left[index].debugSyntheticKind !=
               right[index].debugSyntheticKind ||
           left[index].typedNodeId != right[index].typedNodeId ||
           left[index].typedIrNodeIndex != right[index].typedIrNodeIndex ||
           left[index].originParserNodeId !=
               right[index].originParserNodeId ||
           left[index].typedSyntheticOriginKind !=
               right[index].typedSyntheticOriginKind ||
           left[index].typedSpanAuthorityKind !=
               right[index].typedSpanAuthorityKind ||
           left[index].sourceId != right[index].sourceId ||
           left[index].spanId != right[index].spanId ||
           !layout.FixedBytes32Equal(left[index].documentCid,
                                     right[index].documentCid) ||
           left[index].startLine != right[index].startLine ||
           left[index].startColumn != right[index].startColumn ||
           left[index].endLine != right[index].endLine ||
           left[index].endColumn != right[index].endColumn ||
           left[index].siteKind != right[index].siteKind ||
           left[index].siteIndex != right[index].siteIndex ||
           left[index].machineOwnerKind != right[index].machineOwnerKind ||
           left[index].machineOwnerOrdinal !=
               right[index].machineOwnerOrdinal ||
           left[index].actionConsumerOrdinal !=
               right[index].actionConsumerOrdinal ||
           left[index].textSectionRelativeByteStart !=
               right[index].textSectionRelativeByteStart ||
           left[index].byteLength != right[index].byteLength ||
           left[index].plannedBytesSha256 !=
               right[index].plannedBytesSha256:
            return false
    return true

@borrows
fn debugSectionPlanSourceTablesEqual(
        left: DebugSectionPlanReceipt,
        right: DebugSectionPlanReceipt): bool =
    if left.sourceIds.len != right.sourceIds.len ||
       left.sourceModulePaths.len != right.sourceModulePaths.len ||
       left.sourceDocumentCids.len != right.sourceDocumentCids.len:
        return false
    for index in 0..<left.sourceIds.len:
        if left.sourceIds[index] != right.sourceIds[index] ||
           left.sourceModulePaths[index] != right.sourceModulePaths[index] ||
           !layout.FixedBytes32Equal(
               left.sourceDocumentCids[index],
               right.sourceDocumentCids[index]):
            return false
    return true

@borrows
fn debugSectionPlanFunctionNamesEqual(left: str[],
                                      right: str[]): bool =
    if left.len != right.len:
        return false
    for index in 0..<left.len:
        if left[index] != right[index]:
            return false
    return true

@borrows
fn DebugSectionPlanReceiptStrictValidateInto(
        receipt: DebugSectionPlanReceipt,
        debugBinding: bindingreceipt.SemanticSnapshotDebugBindingReceipt,
        facts: debug.DebugFactBundle,
        plan: evidence.DebugEmissionPlanEvidence,
        err: var str): bool =
    var rebuilt: DebugSectionPlanReceipt
    if !debugSectionPlanBuildExactInto(
           debugBinding, facts, plan, rebuilt, err):
        return false
    if !receipt.valid || receipt.backendKind != rebuilt.backendKind ||
       receipt.sourceVersion != rebuilt.sourceVersion ||
       receipt.packageId != rebuilt.packageId ||
       !layout.FixedBytes32Equal(
           receipt.debugBindingReceiptCid,
           rebuilt.debugBindingReceiptCid) ||
       !layout.FixedBytes32Equal(
           receipt.bindingReceiptCid, rebuilt.bindingReceiptCid) ||
       !layout.FixedBytes32Equal(
           receipt.semanticSnapshotCid, rebuilt.semanticSnapshotCid) ||
       !layout.FixedBytes32Equal(receipt.worldHeadCid,
                                 rebuilt.worldHeadCid) ||
       !layout.FixedBytes32Equal(receipt.compilerCid,
                                 rebuilt.compilerCid) ||
       !layout.FixedBytes32Equal(receipt.sourceBundleCid,
                                 rebuilt.sourceBundleCid) ||
       !layout.FixedBytes32Equal(receipt.csgRootCid,
                                 rebuilt.csgRootCid) ||
       !layout.FixedBytes32Equal(receipt.validationReceiptCid,
                                 rebuilt.validationReceiptCid) ||
       !layout.FixedBytes32Equal(receipt.debugProjectionCid,
                                 rebuilt.debugProjectionCid) ||
       !layout.FixedBytes32Equal(receipt.declarationTableCid,
                                 rebuilt.declarationTableCid) ||
       !layout.FixedBytes32Equal(receipt.declarationIdentityCid,
                                 rebuilt.declarationIdentityCid) ||
       !debugSectionPlanSourceTablesEqual(receipt, rebuilt) ||
       !debugSectionPlanFunctionNamesEqual(
           receipt.functionNames, rebuilt.functionNames) ||
       !layout.FixedBytes32Equal(receipt.receiptCid,
                                 rebuilt.receiptCid) ||
       !debugSectionPlanFunctionRowsEqual(
           receipt.functions, rebuilt.functions) ||
       !debugSectionPlanRowsEqual(receipt.rows, rebuilt.rows):
        err = " debug section plan: published receipt mismatch"
        return false
    err = ""
    return true

# Last immutable boundary before object writing. This does not replace the
# facts/evidence replay above; it prevents a copied plan from mutating the
# already-consumed receipt between production planning and the writer.
@borrows
fn DebugSectionPlanReceiptSelfValidateInto(
        receipt: DebugSectionPlanReceipt,
        err: var str): bool =
    err = ""
    let emptyCid = layout.FixedBytes32()
    if !receipt.valid ||
       (receipt.backendKind != "primary" &&
        receipt.backendKind != "backend2") ||
       receipt.sourceVersion <= 0 || receipt.packageId == "" ||
       receipt.functions.len <= 0 || receipt.rows.len <= 0 ||
       receipt.sourceIds.len <= 0 ||
       receipt.sourceIds.len != receipt.sourceModulePaths.len ||
       receipt.sourceIds.len != receipt.sourceDocumentCids.len ||
       receipt.functionNames.len != receipt.functions.len ||
       layout.FixedBytes32Equal(receipt.debugBindingReceiptCid, emptyCid) ||
       layout.FixedBytes32Equal(receipt.bindingReceiptCid, emptyCid) ||
       layout.FixedBytes32Equal(receipt.semanticSnapshotCid, emptyCid) ||
       layout.FixedBytes32Equal(receipt.worldHeadCid, emptyCid) ||
       layout.FixedBytes32Equal(receipt.compilerCid, emptyCid) ||
       layout.FixedBytes32Equal(receipt.sourceBundleCid, emptyCid) ||
       layout.FixedBytes32Equal(receipt.csgRootCid, emptyCid) ||
       layout.FixedBytes32Equal(receipt.validationReceiptCid, emptyCid) ||
       layout.FixedBytes32Equal(receipt.debugProjectionCid, emptyCid) ||
       layout.FixedBytes32Equal(receipt.declarationTableCid, emptyCid) ||
       layout.FixedBytes32Equal(receipt.declarationIdentityCid, emptyCid) ||
       !layout.FixedBytes32Equal(receipt.receiptCid,
                                 debugSectionPlanReceiptCid(receipt)):
        err = " debug section plan: invalid published receipt identity"
        return false
    var previousSourceId: int32 = -1
    for sourceIndex in 0..<receipt.sourceIds.len:
        if receipt.sourceIds[sourceIndex] <= previousSourceId ||
           receipt.sourceModulePaths[sourceIndex] == "" ||
           layout.FixedBytes32Equal(
               receipt.sourceDocumentCids[sourceIndex], emptyCid):
            err = " debug section plan: invalid published source table"
            return false
        previousSourceId = receipt.sourceIds[sourceIndex]
    var expectedRowStart: int32
    var previousFunctionIndex: int32 = -1
    var previousFunctionEnd: int32
    for functionRowIndex in 0..<receipt.functions.len:
        let functionRow = receipt.functions[functionRowIndex]
        if functionRow.functionIndex <= previousFunctionIndex ||
           functionRow.functionId < 0 || functionRow.functionDeclId < 0 ||
           functionRow.functionSymbolId < 0 ||
           functionRow.functionSymbolName == "" ||
           receipt.functionNames[functionRowIndex] == "" ||
           functionRow.sourceId < 0 ||
           layout.FixedBytes32Equal(functionRow.documentCid, emptyCid) ||
           layout.FixedBytes32Equal(functionRow.functionDeclKeyCid, emptyCid) ||
           layout.FixedBytes32Equal(functionRow.functionSymbolCid, emptyCid) ||
           functionRow.bodyStartLine < 0 ||
           functionRow.bodyStartColumn < 0 ||
           functionRow.bodyEndLine < functionRow.bodyStartLine ||
           functionRow.bodyEndColumn < 0 ||
           functionRow.symbolByteStart < 0 ||
           functionRow.symbolByteLength <= 0 ||
           functionRow.symbolByteStart >
               2147483647 - functionRow.symbolByteLength ||
           functionRow.symbolByteStart < previousFunctionEnd ||
           functionRow.rowStart != expectedRowStart ||
           functionRow.rowCount <= 0 ||
           functionRow.rowStart > receipt.rows.len - functionRow.rowCount ||
           !debugSectionPlanSha256Valid(
               functionRow.plannedSymbolBytesSha256) ||
           !debugSectionPlanSha256Valid(functionRow.bodyIrSha256) ||
           !debugSectionPlanSha256Valid(functionRow.frozenPlanSha256) ||
           !debugSectionPlanSha256Valid(functionRow.regallocPlanSha256) ||
           !debugSectionPlanSha256Valid(functionRow.emissionLedgerSha256) ||
           !debugSectionPlanSha256Valid(
               functionRow.actionSemanticRootSha256) ||
           !debugSectionPlanSha256Valid(
               functionRow.actionBindingRootSha256) ||
           !debugSectionPlanSha256Valid(
               functionRow.machineFragmentRootSha256) ||
           !debugSectionPlanSha256Valid(functionRow.abiIngressRootSha256) ||
           !debugSectionPlanSha256Valid(
               functionRow.debugProvenanceSha256) ||
           !debugSectionPlanSha256Valid(
               functionRow.debugMachineFragmentRootSha256):
            err = " debug section plan: invalid published function row"
            return false
        var functionSourceIndex: int32 = -1
        for sourceIndex in 0..<receipt.sourceIds.len:
            if receipt.sourceIds[sourceIndex] == functionRow.sourceId:
                functionSourceIndex = sourceIndex
                break
        if functionSourceIndex < 0 ||
           !layout.FixedBytes32Equal(
               receipt.sourceDocumentCids[functionSourceIndex],
               functionRow.documentCid):
            err = " debug section plan: function source identity missing"
            return false
        var previousFragmentEnd = functionRow.symbolByteStart
        for rowOffset in 0..<functionRow.rowCount:
            let row = receipt.rows[functionRow.rowStart + rowOffset]
            if row.functionIndex != functionRow.functionIndex ||
               row.functionId != functionRow.functionId ||
               row.functionDeclId != functionRow.functionDeclId ||
               row.functionSymbolId != functionRow.functionSymbolId ||
               !layout.FixedBytes32Equal(
                   row.functionDeclKeyCid, functionRow.functionDeclKeyCid) ||
               !layout.FixedBytes32Equal(
                   row.functionSymbolCid, functionRow.functionSymbolCid) ||
               row.textSectionRelativeByteStart < previousFragmentEnd ||
               row.byteLength <= 0 ||
               row.textSectionRelativeByteStart >
                   functionRow.symbolByteStart +
                       functionRow.symbolByteLength - row.byteLength ||
               !debugSectionPlanSha256Valid(row.plannedBytesSha256):
                err = " debug section plan: invalid published fragment row"
                return false
            if row.debugOpId >= 0:
                if row.debugSyntheticKind != 0 || row.typedNodeId < 0 ||
                   row.typedIrNodeIndex < 0 || row.sourceId < 0 ||
                   row.spanId < 0 ||
                   layout.FixedBytes32Equal(row.documentCid, emptyCid) ||
                   row.startLine < 0 || row.startColumn < 0 ||
                   row.endLine < row.startLine || row.endColumn < 0:
                    err = " debug section plan: invalid published source row"
                    return false
                var rowSourceIndex: int32 = -1
                for sourceIndex in 0..<receipt.sourceIds.len:
                    if receipt.sourceIds[sourceIndex] == row.sourceId:
                        rowSourceIndex = sourceIndex
                        break
                if rowSourceIndex < 0 ||
                   !layout.FixedBytes32Equal(
                       receipt.sourceDocumentCids[rowSourceIndex],
                       row.documentCid):
                    err = " debug section plan: operation source identity missing"
                    return false
            elif row.debugSyntheticKind < coreir.BodyDebugSyntheticCleanup ||
                 row.debugSyntheticKind > coreir.BodyDebugSyntheticRuntime ||
                 row.sourceId != -1 || row.spanId != -1:
                err = " debug section plan: invalid published synthetic row"
                return false
            previousFragmentEnd =
                row.textSectionRelativeByteStart + row.byteLength
        expectedRowStart = functionRow.rowStart + functionRow.rowCount
        previousFunctionEnd =
            functionRow.symbolByteStart + functionRow.symbolByteLength
        previousFunctionIndex = functionRow.functionIndex
    if expectedRowStart != receipt.rows.len:
        err = " debug section plan: incomplete published row coverage"
        return false
    return true
