import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/backend/object_buffer as obuf
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/debug_section_plan_receipt as receiptmod

const
    DirectObjectDebugSectionLine = 1
    DirectObjectDebugSectionInfo = 2

type
    DirectObjectDebugRelocation =
        sectionKind: int32
        sectionByteOffset: int32
        targetSymbolIndex: int32
        targetSymbolName: str
        targetTextByteStart: int32
        targetAddend: int32

    # Format-neutral payload consumed by object writers. ELF/COFF receive this
    # exact shape too; until their concrete section writers exist they must
    # reject a non-empty value instead of dropping it.
    DirectObjectDebugSections =
        valid: bool
        sourceReceiptCid: layout.FixedBytes32
        debugLine: rawbytes.Bytes
        debugInfo: rawbytes.Bytes
        debugAbbrev: rawbytes.Bytes
        relocations: DirectObjectDebugRelocation[]

fn DirectObjectDebugSectionsRelease(
        sections: var DirectObjectDebugSections) =
    rawbytes.BytesFree(sections.debugLine)
    rawbytes.BytesFree(sections.debugInfo)
    rawbytes.BytesFree(sections.debugAbbrev)
    sections = DirectObjectDebugSections()

fn directObjectDebugWriteUleb(out: var obuf.ObjectBuffer,
                              value: int32) =
    var remaining = value
    for _ in 0..<5:
        var next = remaining & 127
        remaining = remaining >> 7
        if remaining != 0:
            next = next | 128
        obuf.ObjectBufferWriteU8(out, next)
        if remaining == 0:
            return

fn directObjectDebugWriteSleb(out: var obuf.ObjectBuffer,
                              value: int32) =
    var remaining = value
    for _ in 0..<5:
        var next = remaining & 127
        let signSet = (next & 64) != 0
        remaining = remaining >> 7
        let done = (remaining == 0 && !signSet) ||
                   (remaining == -1 && signSet)
        if !done:
            next = next | 128
        obuf.ObjectBufferWriteU8(out, next)
        if done:
            return

@borrows
fn directObjectDebugWriteCString(out: var obuf.ObjectBuffer,
                                 value: str) =
    for index in 0..<value.len:
        obuf.ObjectBufferWriteU8(out, int32(value[index]) & 255)
    obuf.ObjectBufferWriteU8(out, 0)

@borrows
fn directObjectDebugBytesEqual(left: rawbytes.Bytes,
                               right: rawbytes.Bytes): bool =
    if rawbytes.BytesLen(left) != rawbytes.BytesLen(right):
        return false
    for index in 0..<rawbytes.BytesLen(left):
        if rawbytes.BytesGet(left, index) != rawbytes.BytesGet(right, index):
            return false
    return true

@borrows
fn directObjectDebugSourceFileIndex(sourceIds: int32[],
                                    sourceId: int32): int32 =
    for index in 0..<sourceIds.len:
        if sourceIds[index] == sourceId:
            return index + 1
    return -1

@borrows
fn directObjectDebugAddAddressRelocation(
        sectionKind: int32,
        sectionByteOffset: int32,
        functionRow: receiptmod.DebugSectionPlanFunctionRow,
        targetAddend: int32,
        symbols: var osym.ObjectSymbolTable,
        out: var DirectObjectDebugSections,
        err: var str): bool =
    let symbolIndex = osym.ObjectSymbolsFind(
        symbols, functionRow.functionSymbolName)
    if symbolIndex < 0:
        err = " direct object debug sections: exact function symbol missing"
        return false
    let symbol = osym.ObjectSymbolsAt(symbols, symbolIndex)
    if symbol.undefined || symbol.sectionIndex != 0 ||
       symbol.offset != int64(functionRow.symbolByteStart) ||
       symbol.size != int64(functionRow.symbolByteLength) ||
       targetAddend < 0 || targetAddend > functionRow.symbolByteLength:
        err = " direct object debug sections: function symbol range mismatch"
        return false
    let ownedSymbolName = strings.CloneStr(functionRow.functionSymbolName)
    add(out.relocations,
        DirectObjectDebugRelocation(
            sectionKind: sectionKind,
            sectionByteOffset: sectionByteOffset,
            targetSymbolIndex: symbolIndex,
            targetSymbolName: ownedSymbolName,
            targetTextByteStart: functionRow.symbolByteStart + targetAddend,
            targetAddend: targetAddend))
    return true

@borrows
fn directObjectDebugWriteSetAddress(
        program: var obuf.ObjectBuffer,
        sectionKind: int32,
        functionRow: receiptmod.DebugSectionPlanFunctionRow,
        targetAddend: int32,
        symbols: var osym.ObjectSymbolTable,
        out: var DirectObjectDebugSections,
        err: var str): bool =
    obuf.ObjectBufferWriteU8(program, 0)
    directObjectDebugWriteUleb(program, 9)
    obuf.ObjectBufferWriteU8(program, 2)
    let addressOffset = obuf.ObjectBufferOffset(program)
    obuf.ObjectBufferWriteU64LE(program, uint64(targetAddend))
    return directObjectDebugAddAddressRelocation(
        sectionKind, addressOffset, functionRow, targetAddend,
        symbols, out, err)

fn directObjectDebugBuildAbbrev(): rawbytes.Bytes =
    var out = obuf.ObjectBufferInit(96)
    directObjectDebugWriteUleb(out, 1)
    directObjectDebugWriteUleb(out, 0x11)
    obuf.ObjectBufferWriteU8(out, 1)
    directObjectDebugWriteUleb(out, 0x25)
    directObjectDebugWriteUleb(out, 0x08)
    directObjectDebugWriteUleb(out, 0x13)
    directObjectDebugWriteUleb(out, 0x05)
    directObjectDebugWriteUleb(out, 0x03)
    directObjectDebugWriteUleb(out, 0x08)
    directObjectDebugWriteUleb(out, 0x10)
    directObjectDebugWriteUleb(out, 0x17)
    directObjectDebugWriteUleb(out, 0)
    directObjectDebugWriteUleb(out, 0)

    directObjectDebugWriteUleb(out, 2)
    directObjectDebugWriteUleb(out, 0x2e)
    obuf.ObjectBufferWriteU8(out, 0)
    directObjectDebugWriteUleb(out, 0x03)
    directObjectDebugWriteUleb(out, 0x08)
    directObjectDebugWriteUleb(out, 0x3a)
    directObjectDebugWriteUleb(out, 0x06)
    directObjectDebugWriteUleb(out, 0x3b)
    directObjectDebugWriteUleb(out, 0x06)
    directObjectDebugWriteUleb(out, 0x39)
    directObjectDebugWriteUleb(out, 0x06)
    directObjectDebugWriteUleb(out, 0x11)
    directObjectDebugWriteUleb(out, 0x01)
    directObjectDebugWriteUleb(out, 0x12)
    directObjectDebugWriteUleb(out, 0x06)
    directObjectDebugWriteUleb(out, 0)
    directObjectDebugWriteUleb(out, 0)
    directObjectDebugWriteUleb(out, 0)
    return obuf.ObjectBufferTakeBytes(out)

@borrows
fn directObjectDebugBuildLineInto(
        receipt: receiptmod.DebugSectionPlanReceipt,
        sourceIds: int32[],
        sourcePaths: str[],
        symbols: var osym.ObjectSymbolTable,
        out: var DirectObjectDebugSections,
        err: var str): bool =
    var header = obuf.ObjectBufferInit(256)
    defer:
        obuf.ObjectBufferRelease(header)
    obuf.ObjectBufferWriteU8(header, 1)
    obuf.ObjectBufferWriteU8(header, 1)
    obuf.ObjectBufferWriteU8(header, 1)
    obuf.ObjectBufferWriteU8(header, 0 - 5)
    obuf.ObjectBufferWriteU8(header, 14)
    obuf.ObjectBufferWriteU8(header, 13)
    let standardLengths = [0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1]
    for index in 0..<standardLengths.len:
        obuf.ObjectBufferWriteU8(header, standardLengths[index])
    obuf.ObjectBufferWriteU8(header, 0)
    for sourceId in 0..<sourcePaths.len:
        directObjectDebugWriteCString(header, sourcePaths[sourceId])
        directObjectDebugWriteUleb(header, 0)
        directObjectDebugWriteUleb(header, 0)
        directObjectDebugWriteUleb(header, 0)
    obuf.ObjectBufferWriteU8(header, 0)

    var program = obuf.ObjectBufferInit(receipt.rows.len * 32 + 128)
    defer:
        obuf.ObjectBufferRelease(program)
    for functionRowIndex in 0..<receipt.functions.len:
        let functionRow = receipt.functions[functionRowIndex]
        if !directObjectDebugWriteSetAddress(
               program, DirectObjectDebugSectionLine, functionRow, 0,
               symbols, out, err):
            return false
        let functionFileIndex = directObjectDebugSourceFileIndex(
            sourceIds, functionRow.sourceId)
        if functionFileIndex <= 0:
            err = " direct object debug sections: function source missing"
            return false
        obuf.ObjectBufferWriteU8(program, 4)
        directObjectDebugWriteUleb(program, functionFileIndex)
        let functionLine = functionRow.bodyStartLine + 1
        if functionLine != 1:
            obuf.ObjectBufferWriteU8(program, 3)
            directObjectDebugWriteSleb(program, functionLine - 1)
        obuf.ObjectBufferWriteU8(program, 5)
        directObjectDebugWriteUleb(program, functionRow.bodyStartColumn + 1)
        obuf.ObjectBufferWriteU8(program, 1)
        var currentLine = functionLine
        var currentSourceId = functionRow.sourceId
        for rowOffset in 0..<functionRow.rowCount:
            let row = receipt.rows[functionRow.rowStart + rowOffset]
            if row.debugOpId < 0:
                continue
            let addend = row.textSectionRelativeByteStart -
                         functionRow.symbolByteStart
            if !directObjectDebugWriteSetAddress(
                   program, DirectObjectDebugSectionLine, functionRow,
                   addend, symbols, out, err):
                return false
            if row.sourceId != currentSourceId:
                let rowFileIndex = directObjectDebugSourceFileIndex(
                    sourceIds, row.sourceId)
                if rowFileIndex <= 0:
                    err = " direct object debug sections: operation source missing"
                    return false
                obuf.ObjectBufferWriteU8(program, 4)
                directObjectDebugWriteUleb(program, rowFileIndex)
                currentSourceId = row.sourceId
            let rowLine = row.startLine + 1
            if rowLine != currentLine:
                obuf.ObjectBufferWriteU8(program, 3)
                directObjectDebugWriteSleb(program, rowLine - currentLine)
                currentLine = rowLine
            obuf.ObjectBufferWriteU8(program, 5)
            directObjectDebugWriteUleb(program, row.startColumn + 1)
            obuf.ObjectBufferWriteU8(program, 1)
        if !directObjectDebugWriteSetAddress(
               program, DirectObjectDebugSectionLine, functionRow,
               functionRow.symbolByteLength, symbols, out, err):
            return false
        obuf.ObjectBufferWriteU8(program, 0)
        directObjectDebugWriteUleb(program, 1)
        obuf.ObjectBufferWriteU8(program, 1)

    let linePrefixBytes = 10 + obuf.ObjectBufferLen(header)
    for index in 0..<out.relocations.len:
        if out.relocations[index].sectionKind == DirectObjectDebugSectionLine:
            out.relocations[index].sectionByteOffset =
                out.relocations[index].sectionByteOffset + linePrefixBytes
    var line = obuf.ObjectBufferInit(
        linePrefixBytes + obuf.ObjectBufferLen(program) + 16)
    defer:
        obuf.ObjectBufferRelease(line)
    let unitLength = 2 + 4 + obuf.ObjectBufferLen(header) +
                     obuf.ObjectBufferLen(program)
    obuf.ObjectBufferWriteU32LE(line, uint64(unitLength))
    obuf.ObjectBufferWriteU16LE(line, uint64(4))
    obuf.ObjectBufferWriteU32LE(
        line, uint64(obuf.ObjectBufferLen(header)))
    obuf.ObjectBufferWriteBuffer(line, header)
    obuf.ObjectBufferWriteBuffer(line, program)
    out.debugLine = obuf.ObjectBufferTakeBytes(line)
    return rawbytes.BytesLen(out.debugLine) == unitLength + 4

@borrows
fn directObjectDebugBuildInfoInto(
        receipt: receiptmod.DebugSectionPlanReceipt,
        sourceIds: int32[],
        symbols: var osym.ObjectSymbolTable,
        out: var DirectObjectDebugSections,
        err: var str): bool =
    var body = obuf.ObjectBufferInit(receipt.functions.len * 96 + 128)
    defer:
        obuf.ObjectBufferRelease(body)
    obuf.ObjectBufferWriteU16LE(body, uint64(4))
    obuf.ObjectBufferWriteU32LE(body, uint64(0))
    obuf.ObjectBufferWriteU8(body, 8)
    directObjectDebugWriteUleb(body, 1)
    directObjectDebugWriteCString(body, "cheng")
    obuf.ObjectBufferWriteU16LE(body, uint64(0x8000))
    directObjectDebugWriteCString(body, receipt.packageId)
    obuf.ObjectBufferWriteU32LE(body, uint64(0))
    let firstInfoRelocation = out.relocations.len
    for functionRowIndex in 0..<receipt.functions.len:
        let functionRow = receipt.functions[functionRowIndex]
        let functionFileIndex = directObjectDebugSourceFileIndex(
            sourceIds, functionRow.sourceId)
        if functionFileIndex <= 0:
            err = " direct object debug sections: info source missing"
            return false
        directObjectDebugWriteUleb(body, 2)
        directObjectDebugWriteCString(
            body, receipt.functionNames[functionRowIndex])
        obuf.ObjectBufferWriteU32LE(body, uint64(functionFileIndex))
        obuf.ObjectBufferWriteU32LE(
            body, uint64(functionRow.bodyStartLine + 1))
        obuf.ObjectBufferWriteU32LE(
            body, uint64(functionRow.bodyStartColumn + 1))
        let addressOffset = obuf.ObjectBufferOffset(body)
        obuf.ObjectBufferWriteU64LE(body, uint64(0))
        if !directObjectDebugAddAddressRelocation(
               DirectObjectDebugSectionInfo, addressOffset,
               functionRow, 0, symbols, out, err):
            return false
        obuf.ObjectBufferWriteU32LE(
            body, uint64(functionRow.symbolByteLength))
    directObjectDebugWriteUleb(body, 0)
    for index in firstInfoRelocation..<out.relocations.len:
        out.relocations[index].sectionByteOffset =
            out.relocations[index].sectionByteOffset + 4
    var info = obuf.ObjectBufferInit(obuf.ObjectBufferLen(body) + 4)
    defer:
        obuf.ObjectBufferRelease(info)
    obuf.ObjectBufferWriteU32LE(info, uint64(obuf.ObjectBufferLen(body)))
    obuf.ObjectBufferWriteBuffer(info, body)
    out.debugInfo = obuf.ObjectBufferTakeBytes(info)
    return rawbytes.BytesLen(out.debugInfo) == obuf.ObjectBufferLen(body) + 4

@borrows
fn DirectObjectDebugSectionsBuildInto(
        receipt: receiptmod.DebugSectionPlanReceipt,
        symbols: var osym.ObjectSymbolTable,
        out: var DirectObjectDebugSections,
        err: var str): bool =
    DirectObjectDebugSectionsRelease(out)
    var completed = false
    defer:
        if !completed:
            DirectObjectDebugSectionsRelease(out)
    err = ""
    if !receiptmod.DebugSectionPlanReceiptSelfValidateInto(receipt, err):
        return false
    out.sourceReceiptCid = receipt.receiptCid
    out.debugAbbrev = directObjectDebugBuildAbbrev()
    if rawbytes.BytesLen(out.debugAbbrev) <= 0 ||
       !directObjectDebugBuildLineInto(
           receipt, receipt.sourceIds, receipt.sourceModulePaths,
           symbols, out, err) ||
       !directObjectDebugBuildInfoInto(
           receipt, receipt.sourceIds, symbols, out, err):
        if err == "":
            err = " direct object debug sections: DWARF construction failed"
        return false
    out.valid = true
    completed = true
    return true

@borrows
fn DirectObjectDebugSectionsStrictValidateInto(
        receipt: receiptmod.DebugSectionPlanReceipt,
        symbols: var osym.ObjectSymbolTable,
        sections: DirectObjectDebugSections,
        err: var str): bool =
    var rebuilt: DirectObjectDebugSections
    defer:
        DirectObjectDebugSectionsRelease(rebuilt)
    if !DirectObjectDebugSectionsBuildInto(
           receipt, symbols, rebuilt, err):
        return false
    if !sections.valid ||
       !layout.FixedBytes32Equal(
           sections.sourceReceiptCid, rebuilt.sourceReceiptCid) ||
       !directObjectDebugBytesEqual(
           sections.debugLine, rebuilt.debugLine) ||
       !directObjectDebugBytesEqual(
           sections.debugInfo, rebuilt.debugInfo) ||
       !directObjectDebugBytesEqual(
           sections.debugAbbrev, rebuilt.debugAbbrev) ||
       sections.relocations.len != rebuilt.relocations.len:
        err = " direct object debug sections: immutable payload mismatch"
        return false
    for index in 0..<sections.relocations.len:
        let left = sections.relocations[index]
        let right = rebuilt.relocations[index]
        if left.sectionKind != right.sectionKind ||
           left.sectionByteOffset != right.sectionByteOffset ||
           left.targetSymbolIndex != right.targetSymbolIndex ||
           left.targetSymbolName != right.targetSymbolName ||
           left.targetTextByteStart != right.targetTextByteStart ||
           left.targetAddend != right.targetAddend:
            err = " direct object debug sections: immutable relocation mismatch"
            return false
    err = ""
    return true
