# codegen_a64_body_units.cheng —— B6 aarch64 body 单元直调门面
#
# 形态裁定（B2/B3/B4 先例：kernel-b2-20260825 PROBES_B2、kernel-b4-20260825
# B4_REPORT.md §1/§5）：
#   - 供 primary_object_plan 清 aarch64_encode 直接 import 的两条消费面：
#     (a) 编码器原语重导出（const 引用重导出 + fn 一行直调转发）：内核
#         Fill 主族留驻（迁移闭包含 165 共享中立符号，物理迁出不可行，
#         见 codegen_a64_fill_units.cheng 头注），其对 aarch64_encode 的
#         60 符号（16 const + 44 fn）消费经本门面直调转发——零间接调用、零托管过槽，字节
#         路径与原 kernel 直调逐字节相同（B2 门面注释先例原话）；
#     (b) 搬出簇槽位：codegen_a64_fill_units（aarch64 单元）迁入函数的
#         内核调用点按 CodegenA64Body* 槽一行直调转发（B4 CodegenX64Body*
#         同型；X64BodyFillWords 同族接缝）。
#   - 不设 unitKey 参数（B3 §2 单供给族同裁定）：调用侧既有 target gate
#     即派发键；本族仅 aarch64 单元供给。
#   - CodegenA64Body* 命名对齐蓝图 3.4 预留位（A64BodyFillWords/
#     A64BodyIrWordCount/A64BodyPrepareLayoutMetrics 留 B6 后续批接缝）。
#
# 归属：shared-format（跨单元安装聚合门面；先例=codegen_writer_units B2 /
# codegen_encoder_event_units B3 / codegen_x64_body_units B4）。
import std/result
import cheng/core/ir/core_types as coreir
import cheng/core/backend/aarch64_encode as a64
import cheng/core/backend/codegen_a64_fill_units as a64fill


const
    CodegenA64CondEQ = a64.A64CondEQ
    CodegenA64CondGT = a64.A64CondGT
    CodegenA64CondNE = a64.A64CondNE
    CodegenA64FP = a64.A64FP
    CodegenA64LR = a64.A64LR
    CodegenA64SP = a64.A64SP
    CodegenA64X0 = a64.A64X0
    CodegenA64X10 = a64.A64X10
    CodegenA64X11 = a64.A64X11
    CodegenA64X12 = a64.A64X12
    CodegenA64X13 = a64.A64X13
    CodegenA64X14 = a64.A64X14
    CodegenA64X15 = a64.A64X15
    CodegenA64X16 = a64.A64X16
    CodegenA64X8 = a64.A64X8
    CodegenA64X9 = a64.A64X9

fn CodegenA64EncAddImm(is64: bool, rd: int32, rn: int32, imm12: int32): Result[int32] =
    return a64.A64EncAddImm(is64, rd, rn, imm12)

fn CodegenA64EncAddReg(is64: bool, rd: int32, rn: int32, rm: int32): int32 =
    return a64.A64EncAddReg(is64, rd, rn, rm)

fn CodegenA64EncAdrp(rd: int32): int32 =
