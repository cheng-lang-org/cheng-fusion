@borrows
fn CodegenA64BodyFillInlineF64Trunc(words: var int32[],
                                    offset: int32,
                                    inlineKind: int32): int32 =
    return a64fill.PrimaryBodyIRFillInlineF64Trunc(words, offset, inlineKind)

@borrows
fn CodegenA64BodyFillInlineF64FromInt(words: var int32[],
                                      offset: int32,
                                      inlineKind: int32,
                                      unsignedSrc: bool): int32 =
    return a64fill.PrimaryBodyIRFillInlineF64FromInt(words, offset, inlineKind, unsignedSrc)

fn CodegenA64BodyFillStackAddressToReg(words: var int32[],
                                       offset: int32,
                                       reg: int32,
                                       stackOffsetRaw: int32): int32 =
    return a64fill.PrimaryBodyIRFillStackAddressToReg(words, offset, reg, stackOffsetRaw)

