@borrows
fn CodegenA64BodyFillFrameRestore(words: var int32[], offset: int32, frameBytes: int32, bodyIR: coreir.BodyIR): int32 =
    return a64fill.PrimaryBodyIRFillFrameRestore(words, offset, frameBytes, bodyIR)

fn CodegenA64BodyCondA64TrueCode(condTag: int32): int32 =
    return a64fill.PrimaryBodyCondA64TrueCode(condTag)

fn CodegenA64BodyEmitPrologueWord(index: int32): int32 =
