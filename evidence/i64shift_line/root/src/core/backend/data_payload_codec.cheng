import std/strings
import std/strformat

fn BackendDataPayloadHexDigit(value: int32): str =
    if value < 10:
        return strings.CharToStr(char(int32('0') + value))
    return strings.CharToStr(char(int32('A') + value - 10))

fn BackendDataPayloadByteHex(value: int32): str =
    let byteValue = value & 255
    return Fmt"{BackendDataPayloadHexDigit((byteValue >> 4) & 15)}{BackendDataPayloadHexDigit(byteValue & 15)}"

fn BackendDataPayloadU32LeHex(value: int32): str =
    let raw = uint32(value)
    return Fmt"{BackendDataPayloadByteHex(int32(raw & uint32(255)))}{BackendDataPayloadByteHex(int32((raw >> uint32(8)) & uint32(255)))}{BackendDataPayloadByteHex(int32((raw >> uint32(16)) & uint32(255)))}{BackendDataPayloadByteHex(int32((raw >> uint32(24)) & uint32(255)))}"

fn BackendDataPayloadU64LeHex(value: int64): str =
    let raw = uint64(value)
    var out = ""
    for i in 0..<8:
        let shiftAmount = uint64(i * 8)
        let byteValue = int32((raw >> shiftAmount) & uint64(255))
        out = Fmt"{out}{BackendDataPayloadByteHex(byteValue)}"
    return out
