import std/result
import std/rawbytes
import std/rawmem_support

type
    ObjectBuffer =
        storage: Bytes
        len: int32
        cap: int32

fn ObjectBufferInit(cap0: int32): ObjectBuffer =
    var cap = cap0
    if cap < 64:
        cap = 64
    var out: ObjectBuffer
    let storage = rawbytes.BytesAlloc(cap)
    if storage.data == nil || storage.len != cap:
        panic("object_buffer_init_alloc_failed")
    out.storage.data = storage.data
    out.storage.len = storage.len
    out.cap = cap
    return out

@borrows
fn ObjectBufferLen(buf: ObjectBuffer): int32 =
    return buf.len

@borrows
fn ObjectBufferCap(buf: ObjectBuffer): int32 =
    return buf.cap

@borrows
fn ObjectBufferOffset(buf: ObjectBuffer): int32 =
    return buf.len

fn ObjectBufferEnsure(buf: var ObjectBuffer, extra: int32) =
    if extra < 0 || buf.len < 0 || buf.cap < 0 ||
       buf.len > buf.cap || buf.storage.len != buf.cap ||
       (buf.cap > 0 && buf.storage.data == nil) ||
       (buf.cap == 0 && buf.storage.data != nil):
        panic("object_buffer_state_invalid")
    if extra == 0:
        return
    if buf.len > 2147483647 - extra:
        panic("object_buffer_size_overflow")
    let need = buf.len + extra
    if need <= buf.cap:
        return
    var nextCap = buf.cap
    if nextCap < 64:
        nextCap = 64
    for _ in 0..<32:
        if nextCap >= need:
            break
        if nextCap > 1073741823:
            nextCap = need
            break
        nextCap = nextCap * 2
    if nextCap < need:
        nextCap = need
    var nextStorage = rawbytes.BytesAlloc(nextCap)
    if nextStorage.data == nil || nextStorage.len != nextCap:
        rawbytes.BytesFree(nextStorage)
        panic("object_buffer_grow_alloc_failed")
    if buf.len > 0:
        rawmem_support.RawmemCopy(nextStorage.data, buf.storage.data, buf.len)
    var previousStorage: Bytes
    previousStorage.data = buf.storage.data
    previousStorage.len = buf.storage.len
    buf.storage.data = nextStorage.data
    buf.storage.len = nextStorage.len
    nextStorage.data = nil
    nextStorage.len = 0
    buf.cap = nextCap
    rawbytes.BytesFree(previousStorage)

fn ObjectBufferRelease(buf: var ObjectBuffer) =
    var storage: Bytes
    storage.data = buf.storage.data
    storage.len = buf.storage.len
    buf.storage.data = nil
    buf.storage.len = 0
    rawbytes.BytesFree(storage)
    buf.len = 0
    buf.cap = 0

fn ObjectBufferTakeBytes(buf: var ObjectBuffer): Bytes =
    if buf.len < 0 || buf.cap < 0 || buf.len > buf.cap ||
       buf.storage.len != buf.cap ||
       (buf.cap > 0 && buf.storage.data == nil) ||
       (buf.cap == 0 && buf.storage.data != nil):
        panic("object_buffer_take_state_invalid")
    if buf.len <= 0:
        ObjectBufferRelease(buf)
        return rawbytes.EmptyBytes()
    let data = buf.storage.data
    let usedLen = buf.len
    buf.storage.data = nil
    buf.storage.len = 0
    buf.len = 0
    buf.cap = 0
    var out: Bytes
    out.data = data
    out.len = usedLen
    return out

fn ObjectBufferWriteU8(buf: var ObjectBuffer, value: int32) =
    ObjectBufferEnsure(buf, 1)
    BytesSet(buf.storage, buf.len, value & 255)
    buf.len = buf.len + 1

fn ObjectBufferWriteU16LE(buf: var ObjectBuffer, value: uint64) =
    ObjectBufferEnsure(buf, 2)
    BytesSet(buf.storage, buf.len, Int32(value & UInt64(255)))
    BytesSet(buf.storage, buf.len + 1, Int32((value >> UInt64(8)) & UInt64(255)))
    buf.len = buf.len + 2

fn ObjectBufferWriteU32LE(buf: var ObjectBuffer, value: uint64) =
    ObjectBufferEnsure(buf, 4)
    for i in 0..<4:
        let shift = UInt64(i * 8)
        BytesSet(buf.storage, buf.len + i, Int32((value >> shift) & UInt64(255)))
    buf.len = buf.len + 4

fn ObjectBufferWriteU64LE(buf: var ObjectBuffer, value: uint64) =
    ObjectBufferEnsure(buf, 8)
    for i in 0..<8:
        let shift = UInt64(i * 8)
        BytesSet(buf.storage, buf.len + i, Int32((value >> shift) & UInt64(255)))
    buf.len = buf.len + 8

@borrows
fn ObjectBufferWriteBytes(buf: var ObjectBuffer, data: Bytes) =
    let n = BytesLen(data)
    if n <= 0:
        return
    ObjectBufferEnsure(buf, n)
    rawmem_support.RawmemCopy(rawmem_support.RawmemPtrAdd(buf.storage.data, buf.len), data.data, n)
    buf.len = buf.len + n

@borrows
fn ObjectBufferWriteBuffer(buf: var ObjectBuffer,
                           source: ObjectBuffer) =
    if source.len < 0 || source.cap < 0 || source.len > source.cap ||
       source.storage.len != source.cap ||
       (source.cap > 0 && source.storage.data == nil) ||
       (source.cap == 0 && source.storage.data != nil):
        panic("object_buffer_source_state_invalid")
    if source.len <= 0:
        return
    if source.storage.data == buf.storage.data:
        panic("object_buffer_source_alias_invalid")
    ObjectBufferEnsure(buf, source.len)
    rawmem_support.RawmemCopy(
        rawmem_support.RawmemPtrAdd(buf.storage.data, buf.len),
        source.storage.data,
        source.len)
    buf.len = buf.len + source.len

fn ObjectBufferWriteZeros(buf: var ObjectBuffer, count: int32) =
    if count <= 0:
        return
    ObjectBufferEnsure(buf, count)
    for i in 0..<count:
        BytesSet(buf.storage, buf.len + i, 0)
    buf.len = buf.len + count

fn ObjectBufferAlign(buf: var ObjectBuffer, align: int32, fill: int32) =
    if align <= 1:
        return
    let mask = align - 1
    let aligned = (buf.len + mask) & (0 - align)
    let pad = aligned - buf.len
    if pad <= 0:
        return
    ObjectBufferEnsure(buf, pad)
    for i in 0..<pad:
        BytesSet(buf.storage, buf.len + i, fill & 255)
    buf.len = buf.len + pad

fn ObjectBufferPatchU32LE(buf: var ObjectBuffer, offset: int32, value: uint64): Result[bool] =
    if offset < 0 || offset + 4 > buf.len:
        return Err[bool](" object buffer: patch u32 out of range")
    for i in 0..<4:
        let shift = UInt64(i * 8)
        BytesSet(buf.storage, offset + i, Int32((value >> shift) & UInt64(255)))
    return Ok[bool](true)

fn ObjectBufferPatchU64LE(buf: var ObjectBuffer, offset: int32, value: uint64): Result[bool] =
    if offset < 0 || offset + 8 > buf.len:
        return Err[bool](" object buffer: patch u64 out of range")
    for i in 0..<8:
        let shift = UInt64(i * 8)
        BytesSet(buf.storage, offset + i, Int32((value >> shift) & UInt64(255)))
    return Ok[bool](true)

@borrows
fn ObjectBufferToBytes(buf: ObjectBuffer): Bytes =
    if buf.len <= 0:
        return EmptyBytes()
    if buf.storage.data == nil:
        return EmptyBytes()
    let out = rawbytes.BytesAlloc(buf.len)
    if out.data == nil:
        return EmptyBytes()
    rawmem_support.RawmemCopy(out.data, buf.storage.data, buf.len)
    return out

fn ObjectBufferToBytesInto(buf: var ObjectBuffer,
                           out: var Bytes) =
    if buf.len <= 0:
        out.data = nil
        out.len = 0
        return
    if buf.storage.data == nil:
        out.data = nil
        out.len = 0
        return
    let storage = rawbytes.BytesAlloc(buf.len)
    if storage.data == nil:
        out.data = nil
        out.len = 0
        return
    rawmem_support.RawmemCopy(storage.data, buf.storage.data, buf.len)
    out.data = storage.data
    out.len = storage.len
