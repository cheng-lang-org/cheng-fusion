# Shared linker helpers for Darwin/Linux self-linkers.
# Keep this module small and dependency-free so stage0/stage1 can reuse it.
import std/os
import std/rawbytes
import std/strformat

fn linkerCoreAlignUp(value: uint64, align: uint64): uint64 =
    if align <= 1:
        return value
    let rem: uint64 = value % align
    if rem == 0:
        return value
    return value + (align - rem)

@borrows
fn linkerCoreStrContains(hay: str, needle: str): bool =
    let n: int32 = len(hay)
    let m: int32 = len(needle)
    if m == 0:
        return true
    if n < m:
        return false
    for i in 0..n - m:
        var matched = true
        for j in 0..<m:
            if !(hay[i + j] == needle[j]):
                matched = false
                break
        if matched:
            return true
    return false

@borrows
fn linkerCoreTargetIsAndroid(target: str): bool =
    if len(target) == 0:
        return false
    return linkerCoreStrContains(target, "android")

@borrows
fn linkerCoreTargetIsLinux(target: str): bool =
    if len(target) == 0:
        return false
    if linkerCoreTargetIsAndroid(target):
        return false
    return linkerCoreStrContains(target, "linux")

@borrows
fn linkerCoreTargetIsDarwin(target: str): bool =
    if len(target) == 0:
        return false
    return linkerCoreStrContains(target, "darwin") || linkerCoreStrContains(target, "apple")

@borrows
fn linkerCoreBuildTmpOutputPath(outputPath: str): str =
    if len(outputPath) == 0:
        return ""
    return Fmt"{outputPath}.tmp"

@borrows
fn linkerCorePathExists(path: str): bool =
    if len(path) == 0:
        return false
    return os.FileExists(path)

@borrows
fn linkerCoreWriteFileAtomic(outputPath: str, data: uint8[]): bool =
    if len(outputPath) == 0:
        return false
    let tmpPath: str = linkerCoreBuildTmpOutputPath(outputPath)
    if len(tmpPath) == 0:
        return false
    # ATOM-08 output transaction: write tmp then rename to publish final artifact.
    if linkerCorePathExists(tmpPath):
        os.RemoveFile(tmpPath)
    os.WriteFileBytes(tmpPath, data)
    if !linkerCorePathExists(tmpPath):
        return false
    if os.RenameFile(tmpPath, outputPath):
        return true
    # Windows rename may fail when destination exists; fallback remove+rename.
    if linkerCorePathExists(outputPath):
        os.RemoveFile(outputPath)
        if os.RenameFile(tmpPath, outputPath):
            return true
    os.RemoveFile(tmpPath)
    return false

@borrows
fn LinkerCoreWriteRawBytesAtomic(outputPath: str, data: var rawbytes.Bytes): bool =
    if len(outputPath) == 0:
        return false
    let tmpPath: str = linkerCoreBuildTmpOutputPath(outputPath)
    if len(tmpPath) == 0:
        return false
    if linkerCorePathExists(tmpPath):
        os.RemoveFile(tmpPath)
    let writeRes = os.WriteFileBytesResult(tmpPath, data)
    if !writeRes.ok:
        os.RemoveFile(tmpPath)
        return false
    if !linkerCorePathExists(tmpPath):
        return false
    if os.RenameFile(tmpPath, outputPath):
        return true
    if linkerCorePathExists(outputPath):
        os.RemoveFile(outputPath)
        if os.RenameFile(tmpPath, outputPath):
            return true
    os.RemoveFile(tmpPath)
    return false
