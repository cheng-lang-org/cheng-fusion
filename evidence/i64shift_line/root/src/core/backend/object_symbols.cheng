import std/strings

type
    ObjectSymbol =
        name: str
        sectionIndex: int32 = -1
        offset: int64
        size: int64
        global: bool
        undefined: bool

    ObjectSymbolTable =
        items: ObjectSymbol[]
        # Exact byte trie derived from items. Symbol identity remains the
        # ObjectSymbol row; trie nodes only accelerate exact UTF-8 lookup.
        trieFirstChildRows: int32[]
        trieNextSiblingRows: int32[]
        trieByteValues: int32[]
        trieSymbolRows: int32[]

fn ObjectSymbolsInit(): ObjectSymbolTable =
    var out: ObjectSymbolTable
    add(out.trieFirstChildRows, -1)
    add(out.trieNextSiblingRows, -1)
    add(out.trieByteValues, -1)
    add(out.trieSymbolRows, -1)
    return out

fn ObjectSymbolsReset(table: var ObjectSymbolTable) =
    table.items = []
    table.trieFirstChildRows = []
    table.trieNextSiblingRows = []
    table.trieByteValues = []
    table.trieSymbolRows = []
    add(table.trieFirstChildRows, -1)
    add(table.trieNextSiblingRows, -1)
    add(table.trieByteValues, -1)
    add(table.trieSymbolRows, -1)

@borrows
fn ObjectSymbolUtf8Valid(text: str): bool =
    var cursor: int32
    while cursor < text.len:
        let b0 = int32(text[cursor]) & 255
        if b0 == 0:
            return false
        if b0 <= 127:
            cursor = cursor + 1
        elif b0 >= 194 && b0 <= 223:
            if cursor + 1 >= text.len:
                return false
            let b1 = int32(text[cursor + 1]) & 255
            if b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 2
        elif b0 >= 224 && b0 <= 239:
            if cursor + 2 >= text.len:
                return false
            let b1 = int32(text[cursor + 1]) & 255
            let b2 = int32(text[cursor + 2]) & 255
            if b2 < 128 || b2 > 191:
                return false
            if b0 == 224:
                if b1 < 160 || b1 > 191:
                    return false
            elif b0 == 237:
                if b1 < 128 || b1 > 159:
                    return false
            elif b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 3
        elif b0 >= 240 && b0 <= 244:
            if cursor + 3 >= text.len:
                return false
            let b1 = int32(text[cursor + 1]) & 255
            let b2 = int32(text[cursor + 2]) & 255
            let b3 = int32(text[cursor + 3]) & 255
            if b2 < 128 || b2 > 191 || b3 < 128 || b3 > 191:
                return false
            if b0 == 240:
                if b1 < 144 || b1 > 191:
                    return false
            elif b0 == 244:
                if b1 < 128 || b1 > 143:
                    return false
            elif b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 4
        else:
            return false
    return true

@borrows
fn objectSymbolsTrieShapeValid(table: ObjectSymbolTable): bool =
    let nodeCount = table.trieFirstChildRows.len
    return nodeCount > 0 &&
        table.trieNextSiblingRows.len == nodeCount &&
        table.trieByteValues.len == nodeCount &&
        table.trieSymbolRows.len == nodeCount &&
        table.trieNextSiblingRows[0] == -1 &&
        table.trieByteValues[0] == -1

@borrows
fn objectSymbolsTrieChildRow(
        table: ObjectSymbolTable,
        parentRow: int32,
        byteValue: int32): int32 =
    if !objectSymbolsTrieShapeValid(table) ||
       parentRow < 0 || parentRow >= table.trieFirstChildRows.len ||
       byteValue < 0 || byteValue > 255:
        panic("object symbols: exact trie query shape invalid")
    var childRow = table.trieFirstChildRows[parentRow]
    var matchedRow: int32 = -1
    var siblingCount: int32
    while childRow >= 0:
        if childRow >= table.trieFirstChildRows.len ||
           siblingCount >= 256:
            panic("object symbols: exact trie sibling shape invalid")
        if table.trieByteValues[childRow] == byteValue:
            if matchedRow >= 0:
                panic("object symbols: duplicate exact trie byte edge")
            matchedRow = childRow
        childRow = table.trieNextSiblingRows[childRow]
        siblingCount = siblingCount + 1
    return matchedRow

fn objectSymbolsTrieAppendChild(
        table: var ObjectSymbolTable,
        parentRow: int32,
        byteValue: int32): int32 =
    if !objectSymbolsTrieShapeValid(table) ||
       parentRow < 0 || parentRow >= table.trieFirstChildRows.len ||
       byteValue < 0 || byteValue > 255 ||
       objectSymbolsTrieChildRow(table, parentRow, byteValue) >= 0:
        panic("object symbols: exact trie append invalid")
    let nodeRow = table.trieFirstChildRows.len
    add(table.trieFirstChildRows, -1)
    add(table.trieNextSiblingRows, table.trieFirstChildRows[parentRow])
    add(table.trieByteValues, byteValue)
    add(table.trieSymbolRows, -1)
    table.trieFirstChildRows[parentRow] = nodeRow
    return nodeRow

fn objectSymbolsTrieBindSymbolRow(
        table: var ObjectSymbolTable,
        symbolRow: int32) =
    if symbolRow < 0 || symbolRow >= table.items.len ||
       !objectSymbolsTrieShapeValid(table):
        panic("object symbols: exact trie bind shape invalid")
    let name = table.items[symbolRow].name
    if name.len <= 0:
        panic("object symbols: exact trie empty symbol")
    var nodeRow: int32
    for byteIndex in 0..<name.len:
        let byteValue = int32(name[byteIndex]) & 255
        var childRow = objectSymbolsTrieChildRow(
            table, nodeRow, byteValue)
        if childRow < 0:
            childRow = objectSymbolsTrieAppendChild(
                table, nodeRow, byteValue)
        nodeRow = childRow
    if table.trieSymbolRows[nodeRow] >= 0:
        panic("object symbols: duplicate exact trie terminal")
    table.trieSymbolRows[nodeRow] = symbolRow

@borrows
fn ObjectSymbolsCount(table: ObjectSymbolTable): int32 =
    return table.items.len

@borrow_result
@borrows
fn ObjectSymbolsNameAt(table: ObjectSymbolTable,
                       index: int32): str =
    return table.items[index].name

@borrows
fn ObjectSymbolsAt(table: ObjectSymbolTable,
                   index: int32): ObjectSymbol =
    let current = table.items[index]
    return ObjectSymbol(name: strings.CloneStr(current.name),
                        sectionIndex: current.sectionIndex,
                        offset: current.offset,
                        size: current.size,
                        global: current.global,
                        undefined: current.undefined)

@borrows
fn ObjectSymbolsFind(table: ObjectSymbolTable, name: str): int32 =
    if name.len <= 0:
        return -1
    if table.items.len == 0 && table.trieFirstChildRows.len == 0:
        return -1
    if !objectSymbolsTrieShapeValid(table):
        panic("object symbols: exact trie missing")
    var nodeRow: int32
    for byteIndex in 0..<name.len:
        nodeRow = objectSymbolsTrieChildRow(
            table, nodeRow, int32(name[byteIndex]) & 255)
        if nodeRow < 0:
            return -1
    let symbolRow = table.trieSymbolRows[nodeRow]
    if symbolRow < 0:
        return -1
    if symbolRow >= table.items.len ||
       table.items[symbolRow].name != name:
        panic("object symbols: exact trie terminal drift")
    return symbolRow

@borrows
fn ObjectSymbolsExactIndexValid(table: ObjectSymbolTable): bool =
    if table.items.len == 0:
        return table.trieFirstChildRows.len == 0 ||
            objectSymbolsTrieShapeValid(table)
    if !objectSymbolsTrieShapeValid(table):
        return false
    for symbolRow in 0..<table.items.len:
        if ObjectSymbolsFind(table, table.items[symbolRow].name) !=
               symbolRow:
            return false
    return true

fn ObjectSymbolsAddDefined(table: var ObjectSymbolTable,
                            name: str,
                            sectionIndex: int32,
                            offset: int64,
                            size: int64,
                            global: bool): int32 =
    if name.len <= 0 || !ObjectSymbolUtf8Valid(name) || sectionIndex < 0 ||
       offset < int64(0) || size < int64(0):
        return -1
    let existing = ObjectSymbolsFind(table, name)
    if existing >= 0:
        let current = table.items[existing]
        if !current.undefined &&
           current.sectionIndex == sectionIndex &&
           current.offset == offset &&
           current.size == size &&
           current.global == global:
            return existing
        return -1
    add(table.items, ObjectSymbol(name: name,
                                  sectionIndex: sectionIndex,
                                  offset: offset,
                                  size: size,
                                  global: global,
                                  undefined: false))
    let symbolRow = table.items.len - 1
    objectSymbolsTrieBindSymbolRow(table, symbolRow)
    return symbolRow

fn ObjectSymbolsAddUndefined(table: var ObjectSymbolTable,
                              name: str,
                              global: bool): int32 =
    if name.len <= 0 || !ObjectSymbolUtf8Valid(name) || !global:
        return -1
    let existing = ObjectSymbolsFind(table, name)
    if existing >= 0:
        let current = table.items[existing]
        if current.undefined && current.global &&
           current.sectionIndex == -1 &&
           current.offset == int64(0) &&
           current.size == int64(0):
            return existing
        return -1
    add(table.items, ObjectSymbol(name: name,
                                  sectionIndex: -1,
                                  global: global,
                                  undefined: true))
    let symbolRow = table.items.len - 1
    objectSymbolsTrieBindSymbolRow(table, symbolRow)
    return symbolRow

@borrows
fn ObjectSymbolsHas(table: ObjectSymbolTable, name: str): bool =
    return ObjectSymbolsFind(table, name) >= 0
