import std/result
import std/rawbytes
import std/strformat
import std/strings
import cheng/core/tooling/path as chengpath
import cheng/core/backend/object_buffer as obuf
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/object_relocs as orel

const
    IMAGE_FILE_MACHINE_ARM64 = uint64(0xAA64)
    IMAGE_FILE_MACHINE_X86_64 = uint64(0x8664)

    IMAGE_SYM_CLASS_EXTERNAL = uint64(2)
    IMAGE_SYM_CLASS_STATIC = uint64(3)

    IMAGE_SYM_TYPE_FUNCTION = uint64(0x20)

    IMAGE_SCN_CNT_CODE = uint64(0x00000020)
    IMAGE_SCN_CNT_INITIALIZED_DATA = uint64(0x00000040)
    IMAGE_SCN_CNT_UNINITIALIZED_DATA = uint64(0x00000080)
    IMAGE_SCN_MEM_EXECUTE = uint64(0x20000000)
    IMAGE_SCN_MEM_READ = uint64(0x40000000)
    IMAGE_SCN_MEM_WRITE = uint64(0x80000000)

    IMAGE_SCN_ALIGN_1BYTES = uint64(0x00100000)
    IMAGE_SCN_ALIGN_2BYTES = uint64(0x00200000)
    IMAGE_SCN_ALIGN_4BYTES = uint64(0x00300000)
    IMAGE_SCN_ALIGN_8BYTES = uint64(0x00400000)
    IMAGE_SCN_ALIGN_16BYTES = uint64(0x00500000)

    IMAGE_REL_ARM64_ABSOLUTE = uint64(0)
    IMAGE_REL_ARM64_ADDR32 = uint64(1)
    IMAGE_REL_ARM64_ADDR64 = uint64(2)
    IMAGE_REL_ARM64_BRANCH26 = uint64(3)
    IMAGE_REL_ARM64_PAGEBASE_REL21 = uint64(4)
    IMAGE_REL_ARM64_PAGEOFFSET_12A = uint64(6)
    IMAGE_REL_AMD64_ADDR64 = uint64(1)
    IMAGE_REL_AMD64_ADDR32 = uint64(2)
    IMAGE_REL_AMD64_REL32 = uint64(4)

    COFF_HDR_SIZE = 20
    COFF_SECTION_HDR_SIZE = 40
    COFF_SYM_SIZE = 18
    COFF_RELOC_SIZE = 10

type
    CoffWriterResult =
        objectPath: str
        bytesWritten: int32
        symbolCount: int32
        relocCount: int32

fn coffAlign(value: int32, align: int32): int32 =
    if align <= 1:
        return value
    let mask = align - 1
    return (value + mask) & (0 - align)

fn coffSectionAlignFlag(pow2: int32): uint64 =
    if pow2 <= 0:
        return IMAGE_SCN_ALIGN_1BYTES
    if pow2 == 1:
        return IMAGE_SCN_ALIGN_2BYTES
    if pow2 == 2:
        return IMAGE_SCN_ALIGN_4BYTES
    if pow2 == 3:
        return IMAGE_SCN_ALIGN_8BYTES
    return IMAGE_SCN_ALIGN_16BYTES

@borrows
fn coffWriteCString(buf: var obuf.ObjectBuffer, text: str) =
    for i in 0..<len(text):
        obuf.ObjectBufferWriteU8(buf, int32(text[i]) & 255)
    obuf.ObjectBufferWriteU8(buf, 0)

@borrows
fn coffWriteFixedStr8(buf: var obuf.ObjectBuffer, text: str) =
    for i in 0..<8:
        if i < len(text):
            obuf.ObjectBufferWriteU8(buf, int32(text[i]) & 255)
        else:
            obuf.ObjectBufferWriteU8(buf, 0)

fn coffWriteI32LE(buf: var obuf.ObjectBuffer,
                  value: int32) =
    obuf.ObjectBufferWriteU8(buf, value & 255)
    obuf.ObjectBufferWriteU8(buf, (value >> 8) & 255)
    obuf.ObjectBufferWriteU8(buf, (value >> 16) & 255)
    obuf.ObjectBufferWriteU8(buf, (value >> 24) & 255)

fn coffWriteI16LE(buf: var obuf.ObjectBuffer,
                  value: int32) =
    obuf.ObjectBufferWriteU8(buf, value & 255)
    obuf.ObjectBufferWriteU8(buf, (value >> 8) & 255)

@borrows
fn coffMachineForTarget(targetTriple: str): uint64 =
    if targetTriple == "x86_64-pc-windows-msvc":
        return IMAGE_FILE_MACHINE_X86_64
    return IMAGE_FILE_MACHINE_ARM64

@borrows
fn coffRelocTypeForTarget(kind: orel.ObjectRelocKind,
                          targetTriple: str): Result[uint64] =
    if targetTriple == "x86_64-pc-windows-msvc":
        if kind == orel.ObjectRelocAbs64:
            return Ok[uint64](IMAGE_REL_AMD64_ADDR64)
        if kind == orel.ObjectRelocAbs32:
            return Ok[uint64](IMAGE_REL_AMD64_ADDR32)
        if kind == orel.ObjectRelocBranch26:
            return Ok[uint64](IMAGE_REL_AMD64_REL32)
        return Err[uint64](" coff object writer: unsupported x86_64 relocation kind")
    if kind == orel.ObjectRelocAbs64:
        return Ok[uint64](IMAGE_REL_ARM64_ADDR64)
    if kind == orel.ObjectRelocAbs32:
        return Ok[uint64](IMAGE_REL_ARM64_ADDR32)
    if kind == orel.ObjectRelocBranch26:
        return Ok[uint64](IMAGE_REL_ARM64_BRANCH26)
    if kind == orel.ObjectRelocPage21:
        return Ok[uint64](IMAGE_REL_ARM64_PAGEBASE_REL21)
    if kind == orel.ObjectRelocPageOff12:
        return Ok[uint64](IMAGE_REL_ARM64_PAGEOFFSET_12A)
    return Err[uint64](" coff object writer: unsupported relocation kind")

fn coffRelocType(kind: orel.ObjectRelocKind): int32 =
    if kind == orel.ObjectRelocAbs64:
        return 1
    if kind == orel.ObjectRelocAbs32:
        return 2
    if kind == orel.ObjectRelocBranch26:
        return 4
    if kind == orel.ObjectRelocPage21:
        return -1
    if kind == orel.ObjectRelocPageOff12:
        return -1
    return -1

@borrows
fn coffWriteSym(buf: var obuf.ObjectBuffer,
                name: str,
                nameOff: int32,
                value: int32,
                sectionIndex: int32,
                storageClass: int32,
                auxCount: int32) =
    if len(name) <= 8:
        coffWriteFixedStr8(buf, name)
    else:
        obuf.ObjectBufferWriteU8(buf, 0)
        obuf.ObjectBufferWriteU8(buf, 0)
        obuf.ObjectBufferWriteU8(buf, 0)
        obuf.ObjectBufferWriteU8(buf, 0)
        obuf.ObjectBufferWriteU8(buf, nameOff & 255)
        obuf.ObjectBufferWriteU8(buf, (nameOff >> 8) & 255)
        obuf.ObjectBufferWriteU8(buf, (nameOff >> 16) & 255)
        obuf.ObjectBufferWriteU8(buf, (nameOff >> 24) & 255)
    obuf.ObjectBufferWriteU8(buf, value & 255)
    obuf.ObjectBufferWriteU8(buf, (value >> 8) & 255)
    obuf.ObjectBufferWriteU8(buf, (value >> 16) & 255)
    obuf.ObjectBufferWriteU8(buf, (value >> 24) & 255)
    var sect = int32(0)
    if sectionIndex >= 0:
        sect = sectionIndex + 1
    obuf.ObjectBufferWriteU8(buf, sect & 255)
    obuf.ObjectBufferWriteU8(buf, (sect >> 8) & 255)
    obuf.ObjectBufferWriteU8(buf, 0)
    obuf.ObjectBufferWriteU8(buf, 0)
    obuf.ObjectBufferWriteU8(buf, storageClass)
    obuf.ObjectBufferWriteU8(buf, auxCount)

fn coffWriteReloc(buf: var obuf.ObjectBuffer,
                  offset: int64,
                  symbolIndex: int32,
                  rtype: int32) =
    let off32 = int32(offset)
    obuf.ObjectBufferWriteU8(buf, off32 & 255)
    obuf.ObjectBufferWriteU8(buf, (off32 >> 8) & 255)
    obuf.ObjectBufferWriteU8(buf, (off32 >> 16) & 255)
    obuf.ObjectBufferWriteU8(buf, (off32 >> 24) & 255)
    obuf.ObjectBufferWriteU8(buf, symbolIndex & 255)
    obuf.ObjectBufferWriteU8(buf, (symbolIndex >> 8) & 255)
    obuf.ObjectBufferWriteU8(buf, (symbolIndex >> 16) & 255)
    obuf.ObjectBufferWriteU8(buf, (symbolIndex >> 24) & 255)
    obuf.ObjectBufferWriteU8(buf, rtype & 255)
    obuf.ObjectBufferWriteU8(buf, (rtype >> 8) & 255)

fn coffPatchStringTableSize(buf: var obuf.ObjectBuffer,
                            size: int32) =
    if buf.len < 4:
        return
    BytesSet(buf.storage, 0, size & 255)
    BytesSet(buf.storage, 1, (size >> 8) & 255)
    BytesSet(buf.storage, 2, (size >> 16) & 255)
    BytesSet(buf.storage, 3, (size >> 24) & 255)

@borrows
fn coffBytesHexText(data: rawbytes.Bytes): str =
    return rawbytes.BytesToHex(data)

@borrows
fn coffWriteHexSidecar(rootDir: str,
                       outputPath: str,
                       data: rawbytes.Bytes): bool =
    let hex = coffBytesHexText(data)
    if len(hex) <= 0 && rawbytes.BytesLen(data) > 0:
        return false
    return chengpath.WriteTextFileHostBridge(rootDir, Fmt"{outputPath}.hex", hex)

@borrows
fn CoffTextObjectBytes(text: rawbytes.Bytes,
                        symbols: osym.ObjectSymbolTable,
                        relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes] =
    var emptyData = rawbytes.EmptyBytes()
    return coffBuild(text, emptyData, symbols, relocs)

@borrows
fn CoffTextDataObjectBytes(text: rawbytes.Bytes,
                            data: rawbytes.Bytes,
                            symbols: osym.ObjectSymbolTable,
                            relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes] =
    return coffBuild(text, data, symbols, relocs)

@borrows
fn coffBuild(text: rawbytes.Bytes,
             data: rawbytes.Bytes,
             symbols: osym.ObjectSymbolTable,
             relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes] =
    let relocCount = orel.ObjectRelocsCount(relocs)
    let symbolCount = osym.ObjectSymbolsCount(symbols)
    if symbolCount <= 0:
        return Err[rawbytes.Bytes](" coff object writer: missing symbols")

    let textSize = int64(rawbytes.BytesLen(text))
    let dataSize = int64(rawbytes.BytesLen(data))
    let hasData = dataSize > int64(0)

    var nsects = int32(1)
    if hasData:
        nsects = nsects + 1

    # Build string table
    var strtab = obuf.ObjectBufferInit(256)
    defer:
        obuf.ObjectBufferRelease(strtab)
    obuf.ObjectBufferWriteU32LE(strtab, uint64(4))
    var symNameOffs: int32[]
    for i in 0..<symbolCount:
        let name = osym.ObjectSymbolsAt(symbols, i)
        let nameText = name.name
        if len(nameText) <= 8:
            add(symNameOffs, int32(0))
        else:
            add(symNameOffs, obuf.ObjectBufferOffset(strtab))
            coffWriteCString(strtab, nameText)
    let strtabSize = obuf.ObjectBufferLen(strtab)
    coffPatchStringTableSize(strtab, strtabSize)

    let symtabSize = symbolCount * COFF_SYM_SIZE
    let relocTableSize = relocCount * COFF_RELOC_SIZE
    let textOff = COFF_HDR_SIZE + nsects * COFF_SECTION_HDR_SIZE
    let dataOff = coffAlign(int32(textOff) + int32(textSize), int32(8))
    let relocOff = coffAlign(dataOff + int32(dataSize), int32(8))
    let symOff = relocOff + relocTableSize
    let strOff = symOff + symtabSize

    var out = obuf.ObjectBufferInit(strOff + strtabSize + 64)
    defer:
        obuf.ObjectBufferRelease(out)

    # COFF Header
    obuf.ObjectBufferWriteU16LE(out, uint64(34404))
    obuf.ObjectBufferWriteU16LE(out, uint64(nsects))
    obuf.ObjectBufferWriteU32LE(out, uint64(0))
    obuf.ObjectBufferWriteU32LE(out, uint64(symOff))
    obuf.ObjectBufferWriteU32LE(out, uint64(symbolCount))
    obuf.ObjectBufferWriteU16LE(out, uint64(0))
    obuf.ObjectBufferWriteU16LE(out, uint64(0))

    # .text Section Header
    coffWriteFixedStr8(out, ".text")
    obuf.ObjectBufferWriteU32LE(out, uint64(0))
    obuf.ObjectBufferWriteU32LE(out, uint64(0))
    obuf.ObjectBufferWriteU32LE(out, uint64(textSize))
    obuf.ObjectBufferWriteU32LE(out, uint64(textOff))
    obuf.ObjectBufferWriteU32LE(out, uint64(relocOff))
    obuf.ObjectBufferWriteU32LE(out, uint64(0))
    obuf.ObjectBufferWriteU16LE(out, uint64(relocCount))
    obuf.ObjectBufferWriteU16LE(out, uint64(0))
    obuf.ObjectBufferWriteU8(out, 32)
    obuf.ObjectBufferWriteU8(out, 0)
    obuf.ObjectBufferWriteU8(out, 48)
    obuf.ObjectBufferWriteU8(out, 96)

    # .data Section Header (optional)
    if hasData:
        coffWriteFixedStr8(out, ".data")
        obuf.ObjectBufferWriteU32LE(out, uint64(0))
        obuf.ObjectBufferWriteU32LE(out, uint64(0))
        obuf.ObjectBufferWriteU32LE(out, uint64(dataSize))
        obuf.ObjectBufferWriteU32LE(out, uint64(dataOff))
        obuf.ObjectBufferWriteU32LE(out, uint64(0))
        obuf.ObjectBufferWriteU32LE(out, uint64(0))
        obuf.ObjectBufferWriteU16LE(out, uint64(0))
        obuf.ObjectBufferWriteU16LE(out, uint64(0))
        obuf.ObjectBufferWriteU8(out, 64)
        obuf.ObjectBufferWriteU8(out, 0)
        obuf.ObjectBufferWriteU8(out, 64)
        obuf.ObjectBufferWriteU8(out, 192)

    # .text data
    obuf.ObjectBufferWriteBytes(out, text)

    # .data (optional)
    if hasData:
        obuf.ObjectBufferAlign(out, int32(8), 0)
        obuf.ObjectBufferWriteBytes(out, data)

    # Relocations
    obuf.ObjectBufferAlign(out, int32(8), 0)
    for i in 0..<relocCount:
        let reloc = orel.ObjectRelocsAt(relocs, i)
        let relocType = coffRelocType(reloc.kind)
        if relocType < 0:
            return Err[rawbytes.Bytes](" coff object writer: unsupported relocation kind")
        coffWriteReloc(out, reloc.offset, reloc.symbolIndex, relocType)

    # Symbol table (no alignment: symOff = relocOff + relocTableSize)
    for i in 0..<symbolCount:
        let sym = osym.ObjectSymbolsAt(symbols, i)
        var storageClass: int32 = 3
        if sym.global:
            storageClass = 2
        var sectIndex = int32(-1)
        if !sym.undefined:
            if sym.sectionIndex == 0:
                sectIndex = int32(0)
            elif hasData && sym.sectionIndex == 1:
                sectIndex = int32(1)
        var nameOff = symNameOffs[i]
        let symName = sym.name
        if nameOff == 0 && len(symName) > 8:
            nameOff = int32(0)
        coffWriteSym(out, symName, nameOff, int32(sym.offset), sectIndex, storageClass, int32(0))

    # String table
    obuf.ObjectBufferWriteBuffer(out, strtab)

    return Ok[rawbytes.Bytes](obuf.ObjectBufferTakeBytes(out))

fn coffBuildInto(text: var rawbytes.Bytes,
                 data: var rawbytes.Bytes,
                 symbols: var osym.ObjectSymbolTable,
                 relocs: var orel.ObjectRelocTable,
                 outBytes: var rawbytes.Bytes,
                 outErr: var str): bool =
    outErr = ""
    let relocCount = orel.ObjectRelocsCount(relocs)
    let symbolCount = osym.ObjectSymbolsCount(symbols)
    if symbolCount <= 0:
        outErr = " coff object writer: missing symbols"
        return false

    let textSize = int64(rawbytes.BytesLen(text))
    let dataSize = int64(rawbytes.BytesLen(data))
    let hasData = dataSize > int64(0)

    var nsects = int32(1)
    if hasData:
        nsects = nsects + 1

    var strtab = obuf.ObjectBufferInit(256)
    defer:
        obuf.ObjectBufferRelease(strtab)
    obuf.ObjectBufferWriteU32LE(strtab, uint64(4))
    var symNameOffs: int32[]
    for i in 0..<symbolCount:
        let name = osym.ObjectSymbolsAt(symbols, i)
        let nameText = name.name
        if len(nameText) <= 8:
            add(symNameOffs, int32(0))
        else:
            add(symNameOffs, obuf.ObjectBufferOffset(strtab))
            coffWriteCString(strtab, nameText)
    let strtabSize = obuf.ObjectBufferLen(strtab)
    coffPatchStringTableSize(strtab, strtabSize)

    let symtabSize = symbolCount * COFF_SYM_SIZE
    let relocTableSize = relocCount * COFF_RELOC_SIZE
    let textOff = COFF_HDR_SIZE + nsects * COFF_SECTION_HDR_SIZE
    let dataOff = coffAlign(int32(textOff) + int32(textSize), int32(8))
    let relocOff = coffAlign(dataOff + int32(dataSize), int32(8))
    let symOff = relocOff + relocTableSize
    let strOff = symOff + symtabSize

    var out = obuf.ObjectBufferInit(strOff + strtabSize + 64)
    defer:
        obuf.ObjectBufferRelease(out)

    obuf.ObjectBufferWriteU16LE(out, uint64(34404))
    obuf.ObjectBufferWriteU16LE(out, uint64(nsects))
    obuf.ObjectBufferWriteU32LE(out, uint64(0))
    obuf.ObjectBufferWriteU32LE(out, uint64(symOff))
    obuf.ObjectBufferWriteU32LE(out, uint64(symbolCount))
    obuf.ObjectBufferWriteU16LE(out, uint64(0))
    obuf.ObjectBufferWriteU16LE(out, uint64(0))

    coffWriteFixedStr8(out, ".text")
    obuf.ObjectBufferWriteU32LE(out, uint64(0))
    obuf.ObjectBufferWriteU32LE(out, uint64(0))
    obuf.ObjectBufferWriteU32LE(out, uint64(textSize))
    obuf.ObjectBufferWriteU32LE(out, uint64(textOff))
    obuf.ObjectBufferWriteU32LE(out, uint64(relocOff))
    obuf.ObjectBufferWriteU32LE(out, uint64(0))
    obuf.ObjectBufferWriteU16LE(out, uint64(relocCount))
    obuf.ObjectBufferWriteU16LE(out, uint64(0))
    obuf.ObjectBufferWriteU8(out, 32)
    obuf.ObjectBufferWriteU8(out, 0)
    obuf.ObjectBufferWriteU8(out, 48)
    obuf.ObjectBufferWriteU8(out, 96)

    if hasData:
        coffWriteFixedStr8(out, ".data")
        obuf.ObjectBufferWriteU32LE(out, uint64(0))
        obuf.ObjectBufferWriteU32LE(out, uint64(0))
        obuf.ObjectBufferWriteU32LE(out, uint64(dataSize))
        obuf.ObjectBufferWriteU32LE(out, uint64(dataOff))
        obuf.ObjectBufferWriteU32LE(out, uint64(0))
        obuf.ObjectBufferWriteU32LE(out, uint64(0))
        obuf.ObjectBufferWriteU16LE(out, uint64(0))
        obuf.ObjectBufferWriteU16LE(out, uint64(0))
        obuf.ObjectBufferWriteU8(out, 64)
        obuf.ObjectBufferWriteU8(out, 0)
        obuf.ObjectBufferWriteU8(out, 64)
        obuf.ObjectBufferWriteU8(out, 192)

    obuf.ObjectBufferWriteBytes(out, text)

    if hasData:
        obuf.ObjectBufferAlign(out, int32(8), 0)
        obuf.ObjectBufferWriteBytes(out, data)

    obuf.ObjectBufferAlign(out, int32(8), 0)
    for i in 0..<relocCount:
        let reloc = orel.ObjectRelocsAt(relocs, i)
        let relocType = coffRelocType(reloc.kind)
        if relocType < 0:
            outErr = " coff object writer: unsupported relocation kind"
            return false
        let relocOffset = int32(reloc.offset)
        var relocPos = out.len
        BytesSet(out.storage, relocPos, relocOffset & 255)
        relocPos = relocPos + 1
        BytesSet(out.storage, relocPos, (relocOffset >> 8) & 255)
        relocPos = relocPos + 1
        BytesSet(out.storage, relocPos, (relocOffset >> 16) & 255)
        relocPos = relocPos + 1
        BytesSet(out.storage, relocPos, (relocOffset >> 24) & 255)
        relocPos = relocPos + 1
        BytesSet(out.storage, relocPos, reloc.symbolIndex & 255)
        relocPos = relocPos + 1
        BytesSet(out.storage, relocPos, (reloc.symbolIndex >> 8) & 255)
        relocPos = relocPos + 1
        BytesSet(out.storage, relocPos, (reloc.symbolIndex >> 16) & 255)
        relocPos = relocPos + 1
        BytesSet(out.storage, relocPos, (reloc.symbolIndex >> 24) & 255)
        relocPos = relocPos + 1
        BytesSet(out.storage, relocPos, relocType & 255)
        relocPos = relocPos + 1
        BytesSet(out.storage, relocPos, (relocType >> 8) & 255)
        relocPos = relocPos + 1
        out.len = relocPos

    # No alignment here: symOff was computed as relocOff + relocTableSize.
    for i in 0..<symbolCount:
        let sym = osym.ObjectSymbolsAt(symbols, i)
        var storageClass: int32 = 3
        if sym.global:
            storageClass = 2
        var sectIndex = int32(-1)
        if !sym.undefined:
            if sym.sectionIndex == 0:
                sectIndex = int32(0)
            elif hasData && sym.sectionIndex == 1:
                sectIndex = int32(1)
        var nameOff = symNameOffs[i]
        let symName = sym.name
        if nameOff == 0 && len(symName) > 8:
            nameOff = int32(0)
        var symPos = out.len
        if len(symName) <= 8:
            for ni in 0..<8:
                if ni < len(symName):
                    let nameCh = symName[ni]
                    BytesSet(out.storage, symPos, int32(nameCh) & 255)
                else:
                    BytesSet(out.storage, symPos, 0)
                symPos = symPos + 1
        else:
            BytesSet(out.storage, symPos, 0)
            symPos = symPos + 1
            BytesSet(out.storage, symPos, 0)
            symPos = symPos + 1
            BytesSet(out.storage, symPos, 0)
            symPos = symPos + 1
            BytesSet(out.storage, symPos, 0)
            symPos = symPos + 1
            BytesSet(out.storage, symPos, nameOff & 255)
            symPos = symPos + 1
            BytesSet(out.storage, symPos, (nameOff >> 8) & 255)
            symPos = symPos + 1
            BytesSet(out.storage, symPos, (nameOff >> 16) & 255)
            symPos = symPos + 1
            BytesSet(out.storage, symPos, (nameOff >> 24) & 255)
            symPos = symPos + 1
        let symbolValue = int32(sym.offset)
        BytesSet(out.storage, symPos, symbolValue & 255)
        symPos = symPos + 1
        BytesSet(out.storage, symPos, (symbolValue >> 8) & 255)
        symPos = symPos + 1
        BytesSet(out.storage, symPos, (symbolValue >> 16) & 255)
        symPos = symPos + 1
        BytesSet(out.storage, symPos, (symbolValue >> 24) & 255)
        symPos = symPos + 1
        var symbolSection = int32(0)
        if sectIndex >= 0:
            symbolSection = sectIndex + 1
        BytesSet(out.storage, symPos, symbolSection & 255)
        symPos = symPos + 1
        BytesSet(out.storage, symPos, (symbolSection >> 8) & 255)
        symPos = symPos + 1
        BytesSet(out.storage, symPos, 0)
        symPos = symPos + 1
        BytesSet(out.storage, symPos, 0)
        symPos = symPos + 1
        BytesSet(out.storage, symPos, storageClass)
        symPos = symPos + 1
        BytesSet(out.storage, symPos, 0)
        symPos = symPos + 1
        out.len = symPos

    obuf.ObjectBufferAlign(out, int32(1), 0)
    obuf.ObjectBufferWriteBuffer(out, strtab)

    outBytes = obuf.ObjectBufferTakeBytes(out)
    return true

fn coffWriteResult(rootDir: str,
                   outputPath: str,
                   text: var rawbytes.Bytes,
                   data: var rawbytes.Bytes,
                   symbols: var osym.ObjectSymbolTable,
                   relocs: var orel.ObjectRelocTable): Result[CoffWriterResult] =
    var bytes: rawbytes.Bytes
    var buildErr: str
    if !coffBuildInto(text, data, symbols, relocs, bytes, buildErr):
        return Err[CoffWriterResult](buildErr)
    defer:
        rawbytes.BytesFree(bytes)
    let payload = rawbytes.BytesToString(bytes)
    let writeRoot = strings.CloneStr(rootDir)
    let writePath = strings.CloneStr(outputPath)
    if !chengpath.WriteTextFileHostBridge(writeRoot, writePath, payload):
        return Err[CoffWriterResult](Fmt" coff object writer: failed to write object: {outputPath}")
    let hexRoot = strings.CloneStr(rootDir)
    let hexPath = strings.CloneStr(outputPath)
    if !coffWriteHexSidecar(hexRoot, hexPath, bytes):
        return Err[CoffWriterResult](Fmt" coff object writer: failed to write object hex sidecar: {outputPath}.hex")
    var out: CoffWriterResult
    out.objectPath = strings.CloneStr(outputPath)
    out.bytesWritten = bytes.len
    out.symbolCount = symbols.items.len
    out.relocCount = relocs.items.len
    return Ok[CoffWriterResult](out)

fn CoffTextObjectWrite(rootDir: str,
                        outputPath: str,
                        text: var rawbytes.Bytes,
                        symbols: var osym.ObjectSymbolTable,
                        relocs: var orel.ObjectRelocTable): Result[CoffWriterResult] =
    var emptyData = rawbytes.EmptyBytes()
    return coffWriteResult(rootDir, outputPath, text, emptyData, symbols, relocs)

fn CoffTextObjectWriteForTarget(rootDir: str,
                                outputPath: str,
                                targetTriple: str,
                                text: var rawbytes.Bytes,
                                symbols: var osym.ObjectSymbolTable,
                                relocs: var orel.ObjectRelocTable): Result[CoffWriterResult] =
    targetTriple
    var emptyData = rawbytes.EmptyBytes()
    return coffWriteResult(rootDir, outputPath, text, emptyData, symbols, relocs)

fn CoffTextDataObjectWrite(rootDir: str,
                            outputPath: str,
                            text: var rawbytes.Bytes,
                            data: var rawbytes.Bytes,
                            symbols: var osym.ObjectSymbolTable,
                            relocs: var orel.ObjectRelocTable): Result[CoffWriterResult] =
    return coffWriteResult(rootDir, outputPath, text, data, symbols, relocs)

fn CoffTextDataObjectWritePathInto(rootDir: str,
                                   outputPath: str,
                                   text: var rawbytes.Bytes,
                                   data: var rawbytes.Bytes,
                                   symbols: var osym.ObjectSymbolTable,
                                   relocs: var orel.ObjectRelocTable,
                                   outObjectPath: var str,
                                   outErr: var str): bool =
    outObjectPath = ""
    outErr = ""
    var bytes: rawbytes.Bytes
    if !coffBuildInto(text, data, symbols, relocs, bytes, outErr):
        return false
    defer:
        rawbytes.BytesFree(bytes)
    let hostPath = chengpath.PathHostFilePath(outputPath)
    var openErr: str
    let handle = chengpath.PathFileHandleOpenWriteTruncateBridge(hostPath, openErr)
    if handle == uint64(0):
        outErr = Fmt" coff object writer: failed to open object: {outputPath}: {openErr}"
        return false
    var writeErr: str
    let writeRc = chengpath.PathWriteHandleBytes(handle, bytes, writeErr)
    var closeErr: str
    let closeRc = chengpath.PathFileHandleCloseBridge(handle, closeErr)
    if writeRc == 0 || closeRc == 0:
        outErr = Fmt" coff object writer: failed to write object: {outputPath}: {writeErr}{closeErr}"
        return false
    if !coffWriteHexSidecar(rootDir, outputPath, bytes):
        outErr = Fmt" coff object writer: failed to write object hex sidecar: {outputPath}.hex"
        return false
    outObjectPath = outputPath
    return true

fn CoffTextDataObjectWriteForTarget(rootDir: str,
                                    outputPath: str,
                                    targetTriple: str,
                                    text: var rawbytes.Bytes,
                                    data: var rawbytes.Bytes,
                                    symbols: var osym.ObjectSymbolTable,
                                    relocs: var orel.ObjectRelocTable): Result[CoffWriterResult] =
    targetTriple
    return coffWriteResult(rootDir, outputPath, text, data, symbols, relocs)
