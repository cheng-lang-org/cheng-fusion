# ---------------------------------------------------------------------------
# 要素 4：regalloc adapter
# ---------------------------------------------------------------------------
# 生产分配器唯一出口：canonical allocator（regalloc_single_pass，内核中立）
# 冻结 plan 后，各 arch adapter 把 plan 变成冻结机器字 recipe。逐字摘录
# （aarch64 条目行号均在 regalloc_aarch64_adapter.cheng）：
#   [现存·aarch64] fn RegallocA64PrepareFunctionActionRecipes(
#         bodyIR: var coreir.BodyIR,
#         plan: var alloc.RegallocSinglePassValuePlan): RegallocA64FunctionRecipes  (:4499)
#   [现存·aarch64] fn RegallocA64PrepareFunctionActionRecipesWithDataSymbolProjection(
#         bodyIR: var coreir.BodyIR,
#         plan: var alloc.RegallocSinglePassValuePlan,
#         slotDataSymbols: var str[],
#         cstringDataSymbols: var str[]): RegallocA64FunctionRecipes  (:4490)
#   [现存·aarch64] fn RegallocA64PrepareFunctionActionRecipesWithDataProjection(
#         bodyIR: var coreir.BodyIR,
#         plan: var alloc.RegallocSinglePassValuePlan,
#         slotDataSymbols: var str[],
#         cstringDataSymbols: var str[],
#         projectionRequired: bool): RegallocA64FunctionRecipes  (:4051)
#   [现存·aarch64] @borrows fn RegallocA64ActionRecipeWordCount(recipe: RegallocA64ActionRecipe): int32  (:4508)
#   [现存·aarch64] @borrows fn RegallocA64ActionRecipeFill(recipe: RegallocA64ActionRecipe, words: var int32[], offset: int32): int32  (:4515)
#   [现存·aarch64] @borrows fn RegallocA64SiteRecipeWordCount(recipe: RegallocA64SiteRecipe): int32  (:4527)
#   [现存·aarch64] @borrows fn RegallocA64SiteRecipeFill(recipe: RegallocA64SiteRecipe, words: var int32[], offset: int32): int32  (:4534)
#   [现存·aarch64] @borrows fn RegallocA64FunctionRecipeWordCount(recipe: RegallocA64FunctionRecipes): int32  (:4546)
#   [现存·aarch64] @borrows fn RegallocA64FunctionRecipeFill(recipe: RegallocA64FunctionRecipes, words: var int32[], offset: int32): int32  (:4553)
#   [现存·aarch64] fn RegallocA64WordsSpMemoryCallEffectMask(words: var int32[]): int32  (:4564)
#
#   [现存·x86_64] fn RegallocX64PrepareFunctionActionRecipes(
#         bodyIR: var coreir.BodyIR,
#         plan: var alloc.RegallocSinglePassValuePlan): carrier.RegallocA64FunctionRecipes
#   （regalloc_x86_64_adapter.cheng:2077）
#   [现存·riscv64] fn RegallocRiscvPrepareFunctionActionRecipes(
#         bodyIR: var coreir.BodyIR,
#         plan: var alloc.RegallocSinglePassValuePlan,
#         xlen: int32): carrier.RegallocA64FunctionRecipes
#   （regalloc_riscv_adapter.cheng:2365）
#   [现存·riscv64] fn RegallocRiscvPrepareFunctionActionRecipesWithEncoderAuthority(
#         bodyIR: var coreir.BodyIR,
#         plan: var alloc.RegallocSinglePassValuePlan,
#         xlen: int32, encoderSourceRow: int32,
#         encoderSourceCid: layout.FixedBytes32): carrier.RegallocA64FunctionRecipes
#   （regalloc_riscv_adapter.cheng:2372）
#   [现存·riscv64] fn RegallocRiscvCfgEdgeCsrBuild(bodyIR: var coreir.BodyIR,
#         plan: var alloc.RegallocSinglePassValuePlan,
#         blockEmissionOrder: var int32[]): RegallocRiscvCfgEdgeCsr
#   （regalloc_riscv_adapter.cheng:1342）
#   [现存·riscv64] fn RegallocRiscvCfgEdgeCsrExact(bodyIR: var coreir.BodyIR,
#         plan: var alloc.RegallocSinglePassValuePlan, blockEmissionOrder: var int32[],
#         value: var RegallocRiscvCfgEdgeCsr): bool
#   （regalloc_riscv_adapter.cheng:1446）
#   [现存·riscv64] fn RegallocRiscvActionCsrExact(bodyIR: var coreir.BodyIR,
#         plan: var alloc.RegallocSinglePassValuePlan): bool
#   （regalloc_riscv_adapter.cheng:1589）
#
# B0（2026-08-25）已落地：regalloc 生产 carrier 自 regalloc_aarch64_adapter.cheng
# :12-:182 原样迁入（布局迁移，零语义变化）：类型命名保留 RegallocA64* 历史
# 前缀（x86_64/riscv 单元共用同一中立 carrier，迁移不改名）；int32 索引身份与
# DOD 布局不变。x86_64/riscv adapter 的 `carrier` 别名改指本模块；aarch64
# adapter 内部引用改经 `contract.` 前缀。禁复制第二份定义。

# R4 adapter boundary.  A recipe is frozen machine data: sizing and filling
# only read `words`; neither pass re-decodes BodyIR or re-runs allocation.
const
    RegallocA64RecipeErrorNone = 0
    RegallocA64RecipeErrorPlan = 1
    RegallocA64RecipeErrorBody = 2
    RegallocA64RecipeErrorFrame = 3
    RegallocA64RecipeErrorAction = 4
    RegallocA64RecipeErrorProducer = 5
    RegallocA64RecipeErrorEncoding = 6

    RegallocA64RelocCall26 = 1
    RegallocA64RelocPage21 = 2
    RegallocA64RelocPageOff12 = 3
    RegallocMachineRelocPcRel32 = 4
    # Canonical RISC-V direct-call relocation. The referenced word is the
    # AUIPC ra placeholder and the following word is JALR ra,ra,0.
    RegallocMachineRelocRiscvCall = 5

    RegallocA64EffectSpLoad = 1
    RegallocA64EffectSpStore = 2
    RegallocA64EffectCall = 4
    RegallocA64EffectX16 = 8
    RegallocA64EffectX17 = 16

    RegallocA64SiteOwnerNone = 0
    RegallocA64SiteOwnerOp = 1
    RegallocA64SiteOwnerTerm = 2

    RegallocA64FragmentOwnerAction = 1
    RegallocA64FragmentOwnerOp = 2
    RegallocA64FragmentOwnerTerm = 3
    RegallocA64FragmentOwnerEdge = 4
    RegallocA64FragmentOwnerAbiIngress = 5
    RegallocA64FragmentOwnerEdgeTrampoline = 6
    RegallocA64FragmentOwnerFramePrologue = 7
    RegallocA64FragmentOwnerFrameEpilogue = 8

type
    # B3（2026-08-25）自 regalloc_production_encoder_events.cheng 原样迁入
    # （布局迁移，零语义变化，禁复制第二份定义）：encoder 事件 carrier 两类型
    # 是 B0 迁入的生产 carrier（RegallocA64FunctionRecipes 末两字段）的
    # 类型面收口——事件模块整体翻转为 riscv64 单元归属后，内核文件不得再
    # import 该模块，类型定义随 carrier 落本契约；事件重放/校验面经
    # codegen_encoder_event_units.cheng（shared-format 门面）直调。
    RegallocProductionEncoderEventBuilder =
        encoderXlen: int32
        wordRows: int32[]
        kinds: int32[]
        operandCounts: int32[]
        operand0s: int64[]
        operand1s: int64[]
        operand2s: int64[]
        operand3s: int64[]
        encodedWords: int32[]
        reservedRowCount: int32
        retainedBytes: int64
        arenaGeneration: int32

    RegallocProductionEncoderEventTable =
        encoderSourceRow: int32 = -1
        encoderSourceCid: layout.FixedBytes32
        encoderXlen: int32
        kinds: int32[]
        operandCounts: int32[]
        operand0s: int64[]
        operand1s: int64[]
        operand2s: int64[]
        operand3s: int64[]
        encodedWords: int32[]
        orderedRoot: layout.FixedBytes32
        reservedRowCount: int32
        retainedBytes: int64

    RegallocA64ActionReloc =
        kind: int32
        wordIndex: int32
        byteOffset: int32 = -1
        callOrdinal: int32 = -1
        opIndex: int32 = -1
        subIndex: int32 = -1
        # Semantic identity is frozen independently from the linker spelling.
        # Non-call relocations keep the -1/-1/zero sentinel tuple.
        targetDomain: int32 = -1
        targetRow: int32 = -1
        targetInterfaceCid: layout.FixedBytes32
        targetSymbol: str

    RegallocA64ActionRecipe =
        valid: bool
        errorCode: int32
        errorDetail: int32 = -1
        consumerOrdinal: int32 = -1
        actionKind: int32
        bindingKind: int32
        producerOpKind: int32
        ownsBodyOp: bool
        ownsCall: bool
        producerWritesMemoryOnly: bool
        effectMask: int32
        encoderEventStart: int32 = -1
        encoderEventCount: int32
        writtenRegs: int32[]
        words: int32[]
        relocs: RegallocA64ActionReloc[]

    RegallocA64SiteRecipe =
        valid: bool
        errorCode: int32
        errorDetail: int32 = -1
        siteKind: int32
        siteIndex: int32 = -1
        blockIndex: int32 = -1
        irKind: int32
        reachable: bool
        ownedByAction: bool
        machineOwnerKind: int32
        effectMask: int32
        writtenRegs: int32[]
        words: int32[]
        relocs: RegallocA64ActionReloc[]
        branchWordIndices: int32[]
        branchTargetBlocks: int32[]
        branchConditionCodes: int32[]

    RegallocA64MachineFragment =
        ownerKind: int32
        ownerOrdinal: int32 = -1
        actionConsumerOrdinal: int32 = -1
        siteKind: int32
        siteIndex: int32 = -1
        blockIndex: int32 = -1
        edgeIndex: int32 = -1
        ingressIndex: int32 = -1
        sourceBlock: int32 = -1
        targetBlock: int32 = -1
        requiresEdgeSplit: bool
        valueId: int32 = -1
        irKind: int32
        wordStart: int32
        wordCount: int32
        encoderEventStart: int32 = -1
        encoderEventCount: int32
        effectMask: int32
        writtenRegs: int32[]
        allocatorClobberFactIndices: int32[]
        relocs: RegallocA64ActionReloc[]
        branchWordIndices: int32[]
        branchTargetBlocks: int32[]
        branchTargetWordStarts: int32[]
        branchByteOffsets: int32[]
        branchTargetByteOffsets: int32[]
        trampolineWordStart: int32 = -1
        trampolineTargetBlock: int32 = -1
        trampolineTargetWordStart: int32 = -1

    RegallocA64FunctionRecipes =
        valid: bool
        errorCode: int32
        errorDetail: int32 = -1
        machineXlen: int32
        frameBytes: int32
        outgoingStackBytes: int32
        calleeRegionEnd: int32
        ingressRegionStart: int32
        ingressRegionSize: int32
        bodyRegionStart: int32
        paramSaveOffset: int32
        paramSaveCount: int32
        returnBufferSaveOffset: int32
        hasSretReturn: bool
        parameterValueIds: int32[]
        parameterWidths: int32[]
        parameterHomeOffsets: int32[]
        localStackOffsets: int32[]
        calleeSavedRegs: int32[]
        calleeSavedOffsets: int32[]
        prologueWords: int32[]
        epilogueWords: int32[]
        abiIngressRegs: int32[]
        abiIngressOffsets: int32[]
        abiIngressParamOrdinals: int32[]
        abiIngressValueIds: int32[]
        abiIngressWidths: int32[]
        abiIngressWordIndices: int32[]
        abiIngressWordCounts: int32[]
        machineFragments: RegallocA64MachineFragment[]
        bodyOpKindMask: int64
        recipes: RegallocA64ActionRecipe[]
        opRecipes: RegallocA64SiteRecipe[]
        termRecipes: RegallocA64SiteRecipe[]
        blockEmissionOrder: int32[]
        reachableBlockCount: int32
        blockWordStarts: int32[]
        opWordStarts: int32[]
        opWordCounts: int32[]
        termWordStarts: int32[]
        termWordCounts: int32[]
        edgeSplitWordStarts: int32[]
        actionWordStarts: int32[]
        actionWordCounts: int32[]
        functionWords: int32[]
        functionRelocs: RegallocA64ActionReloc[]
        encoderEventBuilder: RegallocProductionEncoderEventBuilder
        encoderEvents: RegallocProductionEncoderEventTable

# ---------------------------------------------------------------------------
# 要素 5：对象 writer 入口
# ---------------------------------------------------------------------------
# 输入统一为内核对象模型（rawbytes.Bytes + osym.ObjectSymbolTable +
# orel.ObjectRelocTable）。逐字摘录：
#   [现存·x86_64 ELF]  fn ElfX64TextObjectBytes(text: var rawbytes.Bytes, symbols: var osym.ObjectSymbolTable, relocs: var orel.ObjectRelocTable): Result[rawbytes.Bytes]
#                      （elf_x86_64_writer.cheng:105）
#   [现存·x86_64 ELF]  fn ElfX64TextDataObjectBytes(text: var rawbytes.Bytes, data: var rawbytes.Bytes, symbols: var osym.ObjectSymbolTable, relocs: var orel.ObjectRelocTable): Result[rawbytes.Bytes]
#                      （:111）
#   [现存·x86_64 ELF]  fn ElfX64TextObjectWrite(rootDir: str, outputPath: str, text: var rawbytes.Bytes, symbols: var osym.ObjectSymbolTable, relocs: var orel.ObjectRelocTable): Result[ElfX64WriterResult]
#                      （:354）
#   [现存·x86_64 ELF]  fn ElfX64TextDataObjectWrite(rootDir: str, outputPath: str, text: var rawbytes.Bytes, data: var rawbytes.Bytes, symbols: var osym.ObjectSymbolTable, relocs: var orel.ObjectRelocTable): Result[ElfX64WriterResult]
#                      （:362）
#   [现存·x86_64 COFF] fn CoffX64TextObjectBytes(text: rawbytes.Bytes, symbols: osym.ObjectSymbolTable, relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes]
#                      （coff_x86_64_writer.cheng:101）
#   [现存·x86_64 COFF] fn CoffX64TextDataObjectBytes(text: rawbytes.Bytes, data: rawbytes.Bytes, symbols: osym.ObjectSymbolTable, relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes]
#                      （:107）
#   [现存·x86_64 COFF] fn CoffX64TextObjectWrite(rootDir: str, outputPath: str, text: rawbytes.Bytes, symbols: osym.ObjectSymbolTable, relocs: orel.ObjectRelocTable): Result[CoffX64WriterResult]
#                      （:247）
#   [现存·x86_64 COFF] fn CoffX64TextDataObjectWrite(rootDir: str, outputPath: str, text: rawbytes.Bytes, data: rawbytes.Bytes, symbols: osym.ObjectSymbolTable, relocs: orel.ObjectRelocTable): Result[CoffX64WriterResult]
#                      （:255）
#   [现存·riscv64 ELF] fn ElfRv64TextObjectBytes(text: rawbytes.Bytes, symbols: osym.ObjectSymbolTable, relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes]
#                      （elf_riscv64_writer.cheng:129）
#   [现存·riscv64 ELF] fn ElfRv64TextDataObjectBytes(text: rawbytes.Bytes, data: rawbytes.Bytes, symbols: osym.ObjectSymbolTable, relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes]
#                      （:136）
#   [现存·riscv64 ELF] fn ElfRv64TextObjectWrite(rootDir: str, outputPath: str, text: rawbytes.Bytes, symbols: osym.ObjectSymbolTable, relocs: orel.ObjectRelocTable): Result[ElfRv64WriterResult]
#                      （:398）
#   [现存·riscv64 ELF] fn ElfRv64TextDataObjectWrite(rootDir: str, outputPath: str, text: rawbytes.Bytes, data: rawbytes.Bytes, symbols: osym.ObjectSymbolTable, relocs: orel.ObjectRelocTable): Result[ElfRv64WriterResult]
#                      （:407）
#   [现存·riscv64 链接] fn ElfRv64LinkExe(objPaths: str[], outputPath: str, target: str): Result[bool]
#                      （elf_riscv64_linker.cheng:1018）
#
# TODO(step1-wiring): 待接线 —— writer 参数传递风格不统一：ELF x64 全部 var
# 传参，COFF x64 与 ELF riscv64 为值传 + @borrows。接线时冻结单一契约形（倾向
# 值传 + @borrows，与 ORC 所有权证明一致）；改动属布局迁移，发射字节不得漂移
# （exec_diff 全集验证归 Step 1 verify）。
#
# TODO(step1-wiring): 待接线 —— aarch64 无独立对象 writer 文件：darwin-arm64
# 走内核 macho_object_writer，ELF/COFF arm64 由 elf_object_linker /
# coff_object_linker 内嵌 aarch64 编码（共享格式 × 架构二次切分点，计划风险
# #2/#4 同源）。aarch64 单元的 writer 入口签名待 Step 0 裁定后回填。


# ---------------------------------------------------------------------------
# B1（2026-08-25）：单元派发注册表（蓝图 3.0 unitId / 3.2 adapter 派发落地）
# ---------------------------------------------------------------------------
# 查表协议：内核（regalloc_production_emitter）只按 unitId 经本表调用各单元
# 的 recipe 准备入口与期望字回调；单元 impl 由各 arch adapter 的 Register
# 函数显式注册（编译期组合；Cheng 无模块 init 语义——组合根必须在首次派发
# 前完成注册）。缺注册或缺 triple 一律显式失败，无 else=arm64 默认臂
#（蓝图红线）。var 形参绑定按现语言语义：字段投影实际参仅 copy-in 无写回，
# 与 emitter 现产 aarch64 臂的实参形态保持一致（projection 两列仍以字段投影
# 传入，bodyIR/plan 以 var 局部贯穿 copy-in/copy-out）。

const
    CodegenUnitInvalid = 0
    CodegenUnitA64 = 1
    CodegenUnitX64 = 2
    CodegenUnitRv64 = 3
    CodegenUnitRv32 = 4
    CodegenUnitWasm32 = 5

type
    CodegenCallPairWords =
        auipcOk: bool
        auipcWord: uint32
        jalrOk: bool
        jalrWord: uint32

var codegenUnitA64PrepareImpl: fn(bodyIR: var coreir.BodyIR, plan: var alloc.RegallocSinglePassValuePlan, symbolName: str, encoderSourceRow: int32, encoderSourceCid: layout.FixedBytes32, slotDataSymbols: var str[], cstringDataSymbols: var str[]): RegallocA64FunctionRecipes
var codegenUnitX64PrepareImpl: fn(bodyIR: var coreir.BodyIR, plan: var alloc.RegallocSinglePassValuePlan, symbolName: str, encoderSourceRow: int32, encoderSourceCid: layout.FixedBytes32, slotDataSymbols: var str[], cstringDataSymbols: var str[]): RegallocA64FunctionRecipes
var codegenUnitRv64PrepareImpl: fn(bodyIR: var coreir.BodyIR, plan: var alloc.RegallocSinglePassValuePlan, symbolName: str, encoderSourceRow: int32, encoderSourceCid: layout.FixedBytes32, slotDataSymbols: var str[], cstringDataSymbols: var str[]): RegallocA64FunctionRecipes
var codegenUnitRv32PrepareImpl: fn(bodyIR: var coreir.BodyIR, plan: var alloc.RegallocSinglePassValuePlan, symbolName: str, encoderSourceRow: int32, encoderSourceCid: layout.FixedBytes32, slotDataSymbols: var str[], cstringDataSymbols: var str[]): RegallocA64FunctionRecipes
# 期望字是 (xlen, rd, imm) 的纯函数：注册时由 riscv 单元经 rvenc 直调算出
# 冻结为数据槽（蓝图 3.2 期望字回调；间接调用不承载 var 写回，故以数据注册
# 而非回调函数实现，取值语义等价）。
var codegenUnitRv64CallPairWords: CodegenCallPairWords
var codegenUnitRv32CallPairWords: CodegenCallPairWords

# A composition root activates exactly one immutable process-local descriptor
# before compiler command dispatch.  The descriptor is data-only (unit id), so
# the kernel never stores an arch function pointer or guesses support from a
# target string.  State 0 is the legacy/full driver entry, state 1 is the
# kernel-only composition, and state 2 is a single-plugin composition.
var codegenCompositionState: int32
var codegenCompositionUnitId: int32

fn CodegenCompositionActivateKernelOnly(): bool =
    if codegenCompositionState != 0 ||
       codegenCompositionUnitId != CodegenUnitInvalid:
        return false
    codegenCompositionState = 1
    return true

fn CodegenCompositionActivateUnit(unitId: int32): bool =
    if codegenCompositionState != 0 ||
       codegenCompositionUnitId != CodegenUnitInvalid:
        return false
    if unitId != CodegenUnitA64 &&
       unitId != CodegenUnitX64 &&
       unitId != CodegenUnitRv64:
        return false
    codegenCompositionState = 2
    codegenCompositionUnitId = unitId
    return true

fn CodegenCompositionActive(): bool =
    return codegenCompositionState == 1 ||
           codegenCompositionState == 2

fn CodegenCompositionSingleUnitId(): int32 =
    if codegenCompositionState != 2:
        return CodegenUnitInvalid
    return codegenCompositionUnitId

fn CodegenCompositionKindText(): str =
    if codegenCompositionState == 1 &&
       codegenCompositionUnitId == CodegenUnitInvalid:
        return "kernel-only"
    if codegenCompositionState == 2 &&
       codegenCompositionUnitId != CodegenUnitInvalid:
        return "plugin"
    return "legacy"

fn CodegenCompositionUnitCanonicalTriple(): str =
    if codegenCompositionState != 2:
        return ""
    if codegenCompositionUnitId == CodegenUnitA64:
        return "arm64-apple-darwin"
    if codegenCompositionUnitId == CodegenUnitX64:
        return "x86_64-unknown-linux-gnu"
    if codegenCompositionUnitId == CodegenUnitRv64:
        return "riscv64-unknown-linux-gnu"
    return ""

@borrows
fn CodegenCompositionTargetAdmitted(targetTriple: str): bool =
    if codegenCompositionState != 2:
        return false
    return CodegenUnitCoversTriple(
        codegenCompositionUnitId,
        strings.CloneStr(targetTriple))

@borrows
fn CodegenCompositionMissingError(targetTriple: str): str =
    var installedUnits: str[]
    if codegenCompositionState == 2:
        if codegenCompositionUnitId == CodegenUnitA64:
            add(installedUnits, "aarch64")
        elif codegenCompositionUnitId == CodegenUnitX64:
            add(installedUnits, "x86_64")
        elif codegenCompositionUnitId == CodegenUnitRv64:
            add(installedUnits, "riscv64")
    return CodegenPluginMissingError(
        strings.CloneStr(targetTriple),
        installedUnits)

fn CodegenUnitRegisterPrepareRecipes(
        unitId: int32,
        impl: fn(bodyIR: var coreir.BodyIR, plan: var alloc.RegallocSinglePassValuePlan, symbolName: str, encoderSourceRow: int32, encoderSourceCid: layout.FixedBytes32, slotDataSymbols: var str[], cstringDataSymbols: var str[]): RegallocA64FunctionRecipes): bool =
    if unitId == CodegenUnitA64:
        codegenUnitA64PrepareImpl = impl
        return true
    if unitId == CodegenUnitX64:
        codegenUnitX64PrepareImpl = impl
        return true
    if unitId == CodegenUnitRv64:
        codegenUnitRv64PrepareImpl = impl
        return true
    if unitId == CodegenUnitRv32:
        codegenUnitRv32PrepareImpl = impl
        return true
    return false

fn CodegenUnitRegisterCallPairExpectedWords(
        unitId: int32,
        words: CodegenCallPairWords): bool =
    if unitId == CodegenUnitRv64:
        codegenUnitRv64CallPairWords = words
        return true
    if unitId == CodegenUnitRv32:
        codegenUnitRv32CallPairWords = words
        return true
    return false

fn CodegenUnitPrepareRecipesRegistered(unitId: int32): bool =
    if unitId == CodegenUnitA64:
        return codegenUnitA64PrepareImpl != nil
    if unitId == CodegenUnitX64:
        return codegenUnitX64PrepareImpl != nil
    if unitId == CodegenUnitRv64:
        return codegenUnitRv64PrepareImpl != nil
    if unitId == CodegenUnitRv32:
        return codegenUnitRv32PrepareImpl != nil
    return false

fn CodegenUnitUsesDataSymbolProjection(unitId: int32): bool =
    return unitId == CodegenUnitA64

fn CodegenUnitRequiresPlanIngressPostCheck(unitId: int32): bool =
    return unitId == CodegenUnitA64 || unitId == CodegenUnitX64

fn CodegenUnitPrepareFunctionRecipes(
        unitId: int32,
        bodyIR: var coreir.BodyIR,
        plan: var alloc.RegallocSinglePassValuePlan,
        symbolName: str,
        encoderSourceRow: int32,
        encoderSourceCid: layout.FixedBytes32,
        slotDataSymbols: var str[],
        cstringDataSymbols: var str[]): RegallocA64FunctionRecipes =
    var unavailable: RegallocA64FunctionRecipes
    if unitId == CodegenUnitA64:
        if codegenUnitA64PrepareImpl == nil:
            return unavailable
        return codegenUnitA64PrepareImpl(
            bodyIR, plan, symbolName, encoderSourceRow, encoderSourceCid,
            slotDataSymbols, cstringDataSymbols)
    if unitId == CodegenUnitX64:
        if codegenUnitX64PrepareImpl == nil:
            return unavailable
        return codegenUnitX64PrepareImpl(
            bodyIR, plan, symbolName, encoderSourceRow, encoderSourceCid,
            slotDataSymbols, cstringDataSymbols)
    if unitId == CodegenUnitRv64:
        if codegenUnitRv64PrepareImpl == nil:
            return unavailable
        return codegenUnitRv64PrepareImpl(
            bodyIR, plan, symbolName, encoderSourceRow, encoderSourceCid,
            slotDataSymbols, cstringDataSymbols)
    if unitId == CodegenUnitRv32:
        if codegenUnitRv32PrepareImpl == nil:
            return unavailable
        return codegenUnitRv32PrepareImpl(
            bodyIR, plan, symbolName, encoderSourceRow, encoderSourceCid,
            slotDataSymbols, cstringDataSymbols)
    return unavailable

fn CodegenUnitCallPairExpectedWords(
        unitId: int32,
        xlen: int32): CodegenCallPairWords =
    var out: CodegenCallPairWords
    if unitId == CodegenUnitRv64 && xlen == 64:
        out = codegenUnitRv64CallPairWords
    elif unitId == CodegenUnitRv32 && xlen == 32:
        out = codegenUnitRv32CallPairWords
    return out

# ---------------------------------------------------------------------------
# B2（2026-08-25）：writer/linker 单元表键（蓝图 3.1 落地形态裁定）
# ---------------------------------------------------------------------------
# 形态裁定：fn 值槽（B1 prepare 先例）对 writer 族不可用——frozen stage3
# 实测（kernel-b2-20260825/evidence/language_probes/PROBES_B2.md）托管对象
# 过 fn 槽间接调用在返回/释放期全线崩（var Bytes 实参 SIGSEGV；值传 Bytes
# 退出 foreign pointer；Result[bool]/str[]/含裸 str 复合退出 registry_miss）。
# 依 B1 报告 §5 预案「维持直调表键到模块入口」：本契约只承载 unitKey 常量、
# 统一结果记录与 (format,triple)→unitKey 解析（纯逻辑零托管过槽）；入口
# 聚合门面在 codegen_writer_units.cheng（shared-format 归属）按 unitKey
# switch 直调各 writer/linker——零间接调用，字节路径与原直调逐字节相同；
# 缺组合=Invalid 键或聚合 default 臂双路径显式失败。triple 分类权威仍在
# 内核 target_matrix（要素 1 规则），本解析只做 triple→单元归属映射。

const
    # riscv32 非 esp32s31 目标的 Integer writer 变体（elf_riscv32_writer
    # 双入口：Esp32S31 flags vs Integer flags），与 CodegenUnitRv32 并列。
    CodegenWriterUnitRv32Integer = 6

type
    # writer 结果统一记录（蓝图 3.1；direct_object_emit :374-:380 四字段
    # 实证，bytesWritten 按三 writer 现形 int32——蓝图草案 int64 与现存
    # 不符，以 [现存] 为准）。objectPath 语义=outputPath 回显（三 writer
    # 实现一致）。该记录仅经直调（聚合门面内）构造/消费，不经 fn 槽间接
    # 返回（含裸 str 顶层字段的间接返回 PROBES_B2 实证崩）。
    CodegenObjectWriterResult =
        objectPath: str
        bytesWritten: int32
        symbolCount: int32
        relocCount: int32

@borrows
fn CodegenElfTextDataWriterUnit(targetTriple: str): int32 =
    # (format=elf, triple) → TextData 族 writer unitKey。命中面与原五处
    # (format,triple) if-elif 树的 arch 专属臂一一对应（direct_object_emit
    # WriteObjectForFormat :365/:405/:419/:434、WriteObjectPathForFormatInto
    # :519/:547/:555/:564、native_object_emission_plan :388/:397/:405/:413）；
    # aarch64 ELF/macho/coff 等共享格式臂不在本表（kernel→shared-format
    # 合法直调保留在调用方）。未命中返回 Invalid，调用方走共享 writer 或
    # 显式失败，无 else 兜底（蓝图红线）。
    if targetTriple == "x86_64-unknown-linux-gnu":
        return CodegenUnitX64
    if tmat.TargetIsLinuxRv64(targetTriple):
        return CodegenUnitRv64
    if tmat.TargetIsRv64Bare(targetTriple):
        return CodegenUnitRv64
    if tmat.TargetIsEsp32S31(targetTriple):
        return CodegenUnitRv32
    if tmat.TargetIsRv32(targetTriple):
        return CodegenWriterUnitRv32Integer
    return CodegenUnitInvalid
# ---------------------------------------------------------------------------
# B6（2026-08-25）：body 发射单元表键（蓝图 3.4 / B6d 显式验收项）
# ---------------------------------------------------------------------------
# (targetTriple) → body 布局/尺寸/word-count 供给单元。命中面与原
# primary_object_plan 两处分派树（PrimaryBodyIrWordCountForTarget /
# PrimaryBodyIrPrepareTargetMetricsInPlace 的 wasm32/x86_64 臂 + 原默认臂）
# 一一对应；蓝图红线废除「else=arm64 默认臂」——arm64 家族 triple 逐类
# 显式登记（darwin/linux/android/ohos/windows），未命中返回 Invalid，
# 调用方必须显式失败，无隐式 arm64 默认。
@borrows
fn CodegenBodyEmitUnit(targetTriple: str): int32 =
    if targetTriple == "wasm32-unknown-unknown":
        return CodegenUnitWasm32
    if targetTriple == "x86_64-unknown-linux-gnu":
        return CodegenUnitX64
    if tmat.TargetIsDarwinA64(targetTriple):
        return CodegenUnitA64
    if tmat.TargetIsLinuxA64(targetTriple):
        return CodegenUnitA64
    if tmat.TargetIsAndroidA64(targetTriple):
        return CodegenUnitA64
    if tmat.TargetIsOhosA64(targetTriple):
        return CodegenUnitA64
    if tmat.TargetIsWindowsA64(targetTriple):
        return CodegenUnitA64
    return CodegenUnitInvalid

# ---------------------------------------------------------------------------
# B5+B7（2026-08-25）：簇 D 策略位表 + reloc 谓词 + 链接器单元键
# （蓝图 3.3 策略位表 / 2.3 链接器同槽位收编落地）
# ---------------------------------------------------------------------------
# 形态对齐 B2/B6 已落地风格：triple 键查表（蓝图 3.3 草案 unitId 形按
# 「正式签名以接线冻结版为准」裁定改 triple 形）；triple 分类权威仍在
# target_matrix（要素 1 规则），本表只做 triple→策略位/供给映射，未命中
# 一律 false/""/显式 panic，无 else=arm64 兜底（蓝图红线）。各条目命中面
# 与原硬分叉 gate 值恒等（纯查表化，零语义变化）：
#   CodegenUnitPacksStackArgs             ← pop PrimaryObjectPlanSetPackedStackArgsForTriple
#                                           三 triple if（darwin/ios 族=TargetIsDarwinA64）
#   CodegenUnitUsesSibRoute               ← pop PrimaryObjectPlanSetSibRouteForTriple（仅 x86_64）
#   CodegenUnitDecoratesLeadingUnderscore ← pop PrimaryTargetSymbolName 与 lowering_plan
#                                           loweringFunctionSymbolTargetDecorateOwned 两处同构
#   CodegenUnitRelocKindIsCall            ← pop/emitter/artifacts 四处逐字重复的三常量
#                                           isCall 内联判定（carrier 常量 B0 已在本契约，单元中立）
#   CodegenUnitEncoderAuthorityPath       ← pop riscv encoder authority gate（非空 ⟺
#                                           TargetIsRiscvCodegen）与 lowering_plan 硬编码
#                                           riscv64_encode 路径常量
#   CodegenUnitConstraintSet              ← regalloc_single_pass
#                                           RegallocTargetConstraintsForProductionTarget 的
#                                           triple 全集 if 表原样迁入（构造函数族留中立
#                                           allocator，本表经 alloc.* 直调；panic 判词原文保留）
# CodegenLinkerUnitA64Coff：writer/linker 单元表键第 7 号（蓝图 2.3
# 「coff_pe_builtin 分支调 coff_object_linker.CoffLinkExeA64 契约表同槽位
# 收编」落地）；表值经 codegen_linker_units 门面直调 PE/COFF aarch64 内建链接器。

const
    CodegenLinkerUnitA64Coff = 7

@borrows
fn CodegenUnitPacksStackArgs(targetTriple: str): bool =
    return tmat.TargetIsDarwinA64(targetTriple)

@borrows
fn CodegenUnitUsesSibRoute(targetTriple: str): bool =
    return targetTriple == "x86_64-unknown-linux-gnu"

@borrows
fn CodegenUnitDecoratesLeadingUnderscore(targetTriple: str): bool =
    return tmat.TargetIsDarwinA64(targetTriple)

fn CodegenUnitRelocKindIsCall(kind: int32): bool =
    return kind == RegallocA64RelocCall26 ||
           kind == RegallocMachineRelocPcRel32 ||
           kind == RegallocMachineRelocRiscvCall

@borrows
fn CodegenUnitEncoderAuthorityPath(targetTriple: str): str =
    if tmat.TargetIsRiscvCodegen(targetTriple):
        return "src/core/backend/riscv64_encode.cheng"
    return ""

@borrows
fn CodegenUnitConstraintSet(
        targetTriple: str): alloc.RegallocTargetConstraints =
    if targetTriple == "arm64-apple-darwin" ||
       targetTriple == "aarch64-unknown-linux-gnu":
        return alloc.RegallocTargetConstraintsA64ForTarget(targetTriple)
    if targetTriple == "x86_64-unknown-linux-gnu":
        return alloc.RegallocTargetConstraintsX64Linux()
    if targetTriple == "riscv64-unknown-linux-gnu" ||
       targetTriple == "riscv64-unknown-none-elf":
        return alloc.RegallocTargetConstraintsRv64()
    if targetTriple == "riscv32-unknown-linux-gnu" ||
       targetTriple == "riscv32-unknown-none-elf" ||
       targetTriple == "riscv32-esp32s31-none-elf" ||
       targetTriple == "esp32s31":
        return alloc.RegallocTargetConstraintsRv32()
    panic("canonical regalloc production target unsupported")

# ---------------------------------------------------------------------------
# S4-D（2026-08-25）：组合准入接线 —— 单元覆盖谓词 + 缺件规范报文
# （要素 1 原 TODO(step1-wiring) 落位；docs/cheng-csg-pickup-design.md §6 S4-D）
# ---------------------------------------------------------------------------
# CodegenUnitCoversTriple：单元 × triple 覆盖谓词。命中面 = B6 body 发射表
#（wasm32 / x86_64 / aarch64 五族直查 CodegenBodyEmitUnit）+ riscv 两族
# recipe 路径（B1/B2 表同款 triple 分类——B6 表按 B6 裁定本就不含 riscv，
# 机器字经要素 4 action recipe 路径产出）；triple 分类权威仍在
# target_matrix（要素 1 规则），未命中一律 false，无 else 默认臂。
# CodegenPluginMissingError：缺件规范报文构造函数。基形
# codegen_plugin_missing=<triple> 与 tools/build_kernel_driver.sh 脚本级
# 门禁报文逐字一致（exit 9 同款，逐字对拍门禁在
# tools/backend2_plugin_cache_gate.sh missing-msg-contract 腿）；
# installedUnits 非空时追加 installed=[a,b]，与 S4-B
# CsgPluginPickupMissingError 非空形态同字节（取件客户端非空清单直接
# 委托本函数；空清单两侧形态差异见 S4-D 交付报告）。
# kernel-only 驱动遇未装 triple 的规范报文由本函数供给：编译器侧调用点
# = 契约查表未命中的显式报错臂（direct_object_emit 三处 ELF writer 未命中
# 臂 S4-D 已收口；primary_object_plan 两处 body 发射未命中 panic 臂属并行
# 编辑禁区，行号清单交编排层收口，见 S4-D 报告）。报文路径自身不得依赖
# 已装单元注册状态，installedUnits 仅作展示成分原样拼接。

fn CodegenUnitCoversTriple(unitId: int32, targetTriple: str): bool =
    # stage3 方言: 值传 str 每次过参即消费, 多处查表须逐次 CloneStr
    if unitId == CodegenUnitInvalid:
        return false
    if CodegenBodyEmitUnit(strings.CloneStr(targetTriple)) == unitId:
        return true
    if unitId == CodegenUnitRv64:
        return tmat.TargetIsLinuxRv64(strings.CloneStr(targetTriple)) ||
               tmat.TargetIsRv64Bare(strings.CloneStr(targetTriple))
    if unitId == CodegenUnitRv32:
        return tmat.TargetIsEsp32S31(strings.CloneStr(targetTriple)) ||
               tmat.TargetIsRv32(strings.CloneStr(targetTriple))
    return false

@borrows
fn CodegenPluginMissingError(targetTriple: str, installedUnits: str[]): str =
    var msg = "codegen_plugin_missing=" + targetTriple
    if installedUnits.len > 0:
        msg = msg + " installed=["
        for i in 0..<installedUnits.len:
            if i > 0:
                msg = msg + ","
            msg = msg + installedUnits[i]
        msg = msg + "]"
    return msg

# ---------------------------------------------------------------------------
# Step1 插件契约路由（2026-09-10 archtok）：shared-format 门面去 arch 直
# import 所需的单元 impl 槽。形态冻结依据：light probe 实证「托管复合过 fn
# 槽仅 by-value 形在 release 期 registry_miss；var 形参/by-value 返回均正确」，
# 故所有托管参数一律 var（调用方传可变左值），标量参数保持原形。impl 由
# plugin composition root 在任何派发前显式注册；未注册一律显式失败，无
# else 默认臂。
# ---------------------------------------------------------------------------

