import cheng/core/backend/object_relocs as orel
import cheng/core/backend/target_matrix as tmat

const CodegenContractVersion = 1

# ---------------------------------------------------------------------------
# 要素 1：triple / ABI 表
# ---------------------------------------------------------------------------
# triple 分类权威在内核中立层 target_matrix.cheng，插件单元不得重定义 triple
# 判定，只供给本单元的 ABI admission。以下条目留在内核：
#   [现存·内核侧] fn TargetIsDarwinA64(targetTriple: str): bool       (target_matrix.cheng:2)
#   [现存·内核侧] fn TargetIsLinuxX64(targetTriple: str): bool        (target_matrix.cheng:28)
#   [现存·内核侧] fn TargetIsLinuxA64(targetTriple: str): bool      (target_matrix.cheng:32)
#   [现存·内核侧] fn TargetIsLinuxRv64(targetTriple: str): bool      (target_matrix.cheng:52)
#   [现存·内核侧] fn TargetPrimaryObjectFormat(targetTriple: str): str  (target_matrix.cheng:184)
#   [现存·内核侧] fn TargetLinkerFlavor(targetTriple: str): str         (target_matrix.cheng:220)
#
# 各单元 ABI admission（命名风格暂不一致，接线时冻结为契约名或保留原名，
# 二选一须在接线 commit 中显式记录）：
#   [现存·x86_64]  fn X64BodyEntryAbiSupported(bodyIR: coreir.BodyIR): bool
#                  (x86_64_body_emit.cheng:1470)
#   [现存·aarch64] fn RegallocA64EntryAbiSupported(bodyIR: var coreir.BodyIR): bool
#                  (regalloc_aarch64_adapter.cheng:2376)
#   [现存·riscv64] fn RvIsaXlenOk(xlen: int32): bool                    (riscv64_encode.cheng:314)
#   [现存·riscv64] fn RvIsaEsp32S31Xlen(): int32                        (riscv64_encode.cheng:321)
#   [现存·riscv64] fn RvIsaEsp32S31ElfFlags(): uint32                   (riscv64_encode.cheng:324)
#
# [已接线·S4-D 2026-08-25] 单元覆盖查询与缺件报错面已落位（签名与计划约定
# 逐字一致，实现见文末 S4-D 节）：
#   fn CodegenUnitCoversTriple(unitId: int32, targetTriple: str): bool
#   fn CodegenPluginMissingError(targetTriple: str, installedUnits: str[]): str
# 报文基形 codegen_plugin_missing=<triple> 与 tools/build_kernel_driver.sh
# 脚本级门禁报文逐字一致（exit 9 同款）。组合准入调用点收口状态：pop
# （primary_object_plan）两处 body 发射未命中臂已于 2026-08-29 经
# csg_plugin_pickup.CodegenCompositionAcquireArtifactForTriple 接线（案 A，
# 见 cheng-patches/step4-final-20260829/CLOSEOUT-MANUAL.md §3）；direct_object
# _emit 三处未命中臂只与本报文同形、未走该包装（S4-D 交付报告原表述已订正）。

