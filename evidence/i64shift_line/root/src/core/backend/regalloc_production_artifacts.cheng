        "virtual_entry_action_counts", plan.virtualEntryActionCounts))
    add(out, regallocProductionFieldI64(
        "used_callee_mask", plan.usedCalleeMask))
    return out

@borrows
fn regallocProductionTextIsLineSafe(value: str): bool =
    if len(value) == 0:
        return false
    for index in 0..<len(value):
        if value[index] == '\n' || value[index] == '\r':
            return false
    return true

@borrows
fn regallocProductionSymbolValid(value: str): bool =
    if len(value) == 0:
        return false
    let first = value[0]
    if !((first >= 'A' && first <= 'Z') ||
         (first >= 'a' && first <= 'z') || first == '_'):
        return false
    for index in 1..<len(value):
        let ch = value[index]
        if !((ch >= 'A' && ch <= 'Z') ||
             (ch >= 'a' && ch <= 'z') ||
             (ch >= '0' && ch <= '9') || ch == '_'):
            return false
    return true

@borrows
fn regallocProductionShaValid(value: str): bool =
    if len(value) != 64:
        return false
    for index in 0..<len(value):
        let ch = value[index]
        if !((ch >= '0' && ch <= '9') ||
             (ch >= 'a' && ch <= 'f')):
            return false
    return true

@borrows
fn regallocProductionFieldsValid(
        fields: var regallocProductionField[],
        expectedCount: int32): bool =
    if fields.len != expectedCount:
        return false
    var names = hashsets.HashSetStrInit(expectedCount * 2)
    for index in 0..<fields.len:
        let name = fields[index].name
        if fields[index].kind < RegallocProductionFieldKindI32 ||
           fields[index].kind > RegallocProductionFieldKindText ||
           !regallocProductionTextIsLineSafe(name) ||
           hashsets.HashSetStrHas(names, name):
            return false
        hashsets.HashSetStrAdd(names, strings.CloneStr(name))
    return true

@borrows
fn regallocProductionFieldsNames(
        fields: var regallocProductionField[]): str[] =
    var out: str[]
    for index in 0..<fields.len:
        add(out, strings.CloneStr(fields[index].name))
    return out

@borrows
fn regallocProductionActionSchemaValid(): bool =
    for fieldIndex in 0..<RegallocProductionActionFieldCount:
        let name = regallocProductionActionFieldName(fieldIndex)
        if !regallocProductionTextIsLineSafe(name):
            return false
        for priorIndex in 0..<fieldIndex:
            if name == regallocProductionActionFieldName(priorIndex):
                return false
    return len(regallocProductionActionFieldName(
        RegallocProductionActionFieldCount)) == 0

fn RegallocProductionArtifactActionFieldNames(): str[] =
    var out: str[]
    for fieldIndex in 0..<RegallocProductionActionFieldCount:
        add(out, regallocProductionActionFieldName(fieldIndex))
    return out

fn RegallocProductionArtifactConstraintFieldNames(): str[] =
    var constraints: alloc.RegallocTargetConstraints
    var fields = regallocProductionConstraintFields(constraints)
    return regallocProductionFieldsNames(fields)

fn RegallocProductionArtifactPlanFieldNames(): str[] =
    var plan: alloc.RegallocSinglePassValuePlan
    var fields = regallocProductionPlanFields(plan)
    return regallocProductionFieldsNames(fields)

fn RegallocProductionArtifactActionFieldCount(): int32 =
    return RegallocProductionActionFieldCount

fn RegallocProductionArtifactConstraintFieldCount(): int32 =
    return RegallocProductionConstraintFieldCount

fn RegallocProductionArtifactPlanFieldCount(): int32 =
    return RegallocProductionPlanFieldCount

@borrows
fn regallocProductionBuilderAppendText(
        builder: var rawbytes.BytesBuilder,
        text: str) =
    let textBytes = rawbytes.BytesFromString(text)
    rawbytes.BytesBuilderAppend(builder, textBytes)

@borrows
fn regallocProductionBuilderAppendUnsigned(
        builder: var rawbytes.BytesBuilder,
        value: uint64) =
    if value == uint64(0):
        rawbytes.BytesBuilderAppendByte(builder, Int32('0'))
        return
    var digits: int32[20]
    var count: int32
    var remaining = value
    while remaining > uint64(0):
        digits[count] = int32(remaining % uint64(10))
        count = count + 1
        remaining = remaining / uint64(10)
    for digitIndex in 0..<count:
        rawbytes.BytesBuilderAppendByte(
            builder,
            Int32('0') + digits[count - 1 - digitIndex])

@borrows
fn regallocProductionBuilderAppendI64(
        builder: var rawbytes.BytesBuilder,
        value: int64) =
    var magnitude: uint64
    if value < int64(0):
        rawbytes.BytesBuilderAppendByte(builder, Int32('-'))
        magnitude = uint64(0 - (value + int64(1))) + uint64(1)
    else:
        magnitude = uint64(value)
    regallocProductionBuilderAppendUnsigned(builder, magnitude)

@borrows
fn regallocProductionBuilderAppendI32(
        builder: var rawbytes.BytesBuilder,
        value: int32) =
    regallocProductionBuilderAppendI64(builder, int64(value))

@borrows
fn regallocProductionBuilderAppendNativeI32(
        builder: var rawbytes.BytesBuilder,
        value: int32) =
    regallocProductionBuilderAppendI32(builder, value)
    rawbytes.BytesBuilderAppendByte(builder, Int32(';'))

@borrows
fn regallocProductionBuilderAppendNativeBool(
        builder: var rawbytes.BytesBuilder,
        value: bool) =
    if value:
        rawbytes.BytesBuilderAppendByte(builder, Int32('1'))
    else:
        rawbytes.BytesBuilderAppendByte(builder, Int32('0'))
    rawbytes.BytesBuilderAppendByte(builder, Int32(';'))

@borrows
fn regallocProductionBuilderAppendNativeText(
        builder: var rawbytes.BytesBuilder,
        value: str) =
    regallocProductionBuilderAppendI32(builder, len(value))
    rawbytes.BytesBuilderAppendByte(builder, Int32(':'))
    regallocProductionBuilderAppendText(builder, value)
    rawbytes.BytesBuilderAppendByte(builder, Int32(';'))

@borrows
fn regallocProductionBuilderAppendI32ArrayValue(
        builder: var rawbytes.BytesBuilder,
        values: int32[]) =
    for index in 0..<values.len:
        if index > 0:
            rawbytes.BytesBuilderAppendByte(builder, Int32(','))
        regallocProductionBuilderAppendI32(builder, values[index])

@borrows
fn regallocProductionBuilderAppendBoolArrayValue(
        builder: var rawbytes.BytesBuilder,
        values: bool[]) =
    for index in 0..<values.len:
        if index > 0:
            rawbytes.BytesBuilderAppendByte(builder, Int32(','))
        if values[index]:
            rawbytes.BytesBuilderAppendByte(builder, Int32('1'))
        else:
            rawbytes.BytesBuilderAppendByte(builder, Int32('0'))

@borrows
fn regallocProductionBuilderAppendFieldValue(
        builder: var rawbytes.BytesBuilder,
        field: var regallocProductionField) =
    if field.kind == RegallocProductionFieldKindI32:
        regallocProductionBuilderAppendI32(builder, field.i32Value)
    elif field.kind == RegallocProductionFieldKindI64:
        regallocProductionBuilderAppendI64(builder, field.i64Value)
    elif field.kind == RegallocProductionFieldKindI32Array:
        regallocProductionBuilderAppendI32ArrayValue(
            builder, field.i32Values)
    elif field.kind == RegallocProductionFieldKindBoolArray:
        regallocProductionBuilderAppendBoolArrayValue(
            builder, field.boolValues)
    elif field.kind == RegallocProductionFieldKindText:
        regallocProductionBuilderAppendText(builder, field.textValue)

@borrows
fn regallocProductionBuilderAppendFieldNative(
        builder: var rawbytes.BytesBuilder,
        field: var regallocProductionField) =
    if field.kind == RegallocProductionFieldKindI32:
        regallocProductionBuilderAppendI32(builder, field.i32Value)
        rawbytes.BytesBuilderAppendByte(builder, Int32(';'))
    elif field.kind == RegallocProductionFieldKindI64:
        regallocProductionBuilderAppendI64(builder, field.i64Value)
        rawbytes.BytesBuilderAppendByte(builder, Int32(';'))
    elif field.kind == RegallocProductionFieldKindI32Array:
        regallocProductionBuilderAppendI32(
            builder, field.i32Values.len)
        rawbytes.BytesBuilderAppendByte(builder, Int32(';'))
        for index in 0..<field.i32Values.len:
            regallocProductionBuilderAppendI32(
                builder, field.i32Values[index])
            rawbytes.BytesBuilderAppendByte(builder, Int32(';'))
    elif field.kind == RegallocProductionFieldKindBoolArray:
        regallocProductionBuilderAppendI32(
            builder, field.boolValues.len)
        rawbytes.BytesBuilderAppendByte(builder, Int32(';'))
        for index in 0..<field.boolValues.len:
            if field.boolValues[index]:
                rawbytes.BytesBuilderAppendByte(builder, Int32('1'))
            else:
                rawbytes.BytesBuilderAppendByte(builder, Int32('0'))
            rawbytes.BytesBuilderAppendByte(builder, Int32(';'))
    elif field.kind == RegallocProductionFieldKindText:
        regallocProductionBuilderAppendI32(
            builder, len(field.textValue))
        rawbytes.BytesBuilderAppendByte(builder, Int32(':'))
        regallocProductionBuilderAppendText(builder, field.textValue)
        rawbytes.BytesBuilderAppendByte(builder, Int32(';'))

@borrows
fn regallocProductionBuilderAppendFieldsNative(
        builder: var rawbytes.BytesBuilder,
        fields: var regallocProductionField[]) =
    for fieldIndex in 0..<fields.len:
        regallocProductionBuilderAppendFieldNative(
            builder, fields[fieldIndex])

@borrows
fn regallocProductionBuilderAppendSlice(
        builder: var rawbytes.BytesBuilder,
        text: str,
        start: int32,
        count: int32) =
    if count <= 0:
        return
    let textBytes = rawbytes.BytesFromString(text)
    let sliceBytes = rawbytes.BytesSliceView(textBytes, start, count)
    rawbytes.BytesBuilderAppend(builder, sliceBytes)

@borrows
fn regallocProductionAppendLine(
        builder: var rawbytes.BytesBuilder,
        key: str,
        value: str) =
    regallocProductionBuilderAppendText(builder, key)
    rawbytes.BytesBuilderAppendByte(builder, Int32('='))
    regallocProductionBuilderAppendText(builder, value)
    rawbytes.BytesBuilderAppendByte(builder, Int32('\n'))

@borrows
fn regallocProductionAppendI32Line(
        builder: var rawbytes.BytesBuilder,
        key: str,
        value: int32) =
    regallocProductionBuilderAppendText(builder, key)
    rawbytes.BytesBuilderAppendByte(builder, Int32('='))
    regallocProductionBuilderAppendI32(builder, value)
    rawbytes.BytesBuilderAppendByte(builder, Int32('\n'))

@borrows
fn regallocProductionAppendI64Line(
        builder: var rawbytes.BytesBuilder,
        key: str,
        value: int64) =
    regallocProductionAppendLine(
        builder, key, strings.Int64ToStr(value))

@borrows
fn regallocProductionActionFieldsVisit(
        payloadBuilder: var rawbytes.BytesBuilder,
        semanticBuilder: var rawbytes.BytesBuilder,
        prefix: str,
        action: var alloc.RegallocValueAction,
        writePayload: bool,
        writeSemantic: bool): bool =
    for fieldIndex in 0..<RegallocProductionActionFieldCount:
        let name = regallocProductionActionFieldName(fieldIndex)
        if len(name) == 0:
            return false
        let value = regallocProductionActionFieldValue(action, fieldIndex)
        if writePayload:
            regallocProductionBuilderAppendText(payloadBuilder, prefix)
            regallocProductionBuilderAppendText(payloadBuilder, name)
            rawbytes.BytesBuilderAppendByte(payloadBuilder, Int32('='))
            regallocProductionBuilderAppendI32(payloadBuilder, value)
            rawbytes.BytesBuilderAppendByte(payloadBuilder, Int32('\n'))
        if writeSemantic:
            regallocProductionBuilderAppendNativeI32(
                semanticBuilder, value)
    return true

@borrows
fn regallocProductionActionAppendFields(
        payloadBuilder: var rawbytes.BytesBuilder,
        prefix: str,
        action: var alloc.RegallocValueAction): bool =
    var semanticBuilder: rawbytes.BytesBuilder
    return regallocProductionActionFieldsVisit(
        payloadBuilder, semanticBuilder, prefix, action, true, false)

@borrows
fn regallocProductionActionSemanticSha256WithPayload(
        payloadBuilder: var rawbytes.BytesBuilder,
        prefix: str,
        action: var alloc.RegallocValueAction,
        writePayload: bool): str =
    var semanticBuilder = rawbytes.BytesBuilderNew(256)
    regallocProductionBuilderAppendText(
        semanticBuilder, "regalloc-action;")
    if !regallocProductionActionFieldsVisit(
           payloadBuilder, semanticBuilder, prefix, action,
           writePayload, true):
        rawbytes.BytesBuilderFree(semanticBuilder)
        return ""
    regallocProductionBuilderAppendNativeI32(
        semanticBuilder, action.fragmentOrdinal)
    regallocProductionBuilderAppendNativeBool(
        semanticBuilder, action.effectSpLoad)
    regallocProductionBuilderAppendNativeBool(
        semanticBuilder, action.effectSpStore)
    regallocProductionBuilderAppendNativeBool(
        semanticBuilder, action.effectCall)
    regallocProductionBuilderAppendNativeBool(
        semanticBuilder, action.effectX16)
    regallocProductionBuilderAppendNativeBool(
        semanticBuilder, action.effectX17)
    return regallocProductionBuilderSha256(semanticBuilder)

@borrows
fn regallocProductionActionSemanticSha256(
        action: var alloc.RegallocValueAction): str =
    var payloadBuilder: rawbytes.BytesBuilder
    return regallocProductionActionSemanticSha256WithPayload(
        payloadBuilder, "", action, false)

@borrows
fn regallocProductionAppendBoolLine(
        builder: var rawbytes.BytesBuilder,
        key: str,
        value: bool) =
    regallocProductionBuilderAppendText(builder, key)
    rawbytes.BytesBuilderAppendByte(builder, Int32('='))
    if value:
        rawbytes.BytesBuilderAppendByte(builder, Int32('1'))
    else:
        rawbytes.BytesBuilderAppendByte(builder, Int32('0'))
    rawbytes.BytesBuilderAppendByte(builder, Int32('\n'))

@borrows
fn regallocProductionAppendI32ArrayLine(
        builder: var rawbytes.BytesBuilder,
        key: str,
        values: int32[]) =
    regallocProductionBuilderAppendText(builder, key)
    rawbytes.BytesBuilderAppendByte(builder, Int32('='))
    regallocProductionBuilderAppendI32ArrayValue(builder, values)
    rawbytes.BytesBuilderAppendByte(builder, Int32('\n'))

@borrows
fn regallocProductionAppendFields(
        builder: var rawbytes.BytesBuilder,
        prefix: str,
    fields: var regallocProductionField[]) =
    for fieldIndex in 0..<fields.len:
        regallocProductionBuilderAppendText(builder, prefix)
        regallocProductionBuilderAppendText(
            builder, fields[fieldIndex].name)
        rawbytes.BytesBuilderAppendByte(builder, Int32('='))
        regallocProductionBuilderAppendFieldValue(
            builder, fields[fieldIndex])
        rawbytes.BytesBuilderAppendByte(builder, Int32('\n'))

@borrows
fn regallocProductionBuilderToString(
        builder: var rawbytes.BytesBuilder): str =
    var payloadBytes = rawbytes.BytesBuilderFinish(builder)
    let payload = rawbytes.BytesToString(payloadBytes)
    rawbytes.BytesFree(payloadBytes)
    return payload

@borrows
fn regallocProductionSha256Bytes(bytes: rawbytes.Bytes): str =
    var digest = sha256.Sha256Digest(bytes)
    let digestHex = rawbytes.BytesToHex(digest)
    rawbytes.BytesFree(digest)
    return digestHex

@borrows
fn regallocProductionBuilderSha256(
        builder: var rawbytes.BytesBuilder): str =
    var bytes = rawbytes.BytesBuilderFinish(builder)
    let digestHex = regallocProductionSha256Bytes(bytes)
    rawbytes.BytesFree(bytes)
    return digestHex

@borrows
fn regallocProductionFinish(
        lines: var rawbytes.BytesBuilder,
                             hashKey: str,
                             symbols: var str[],
                             roots: var str[]): RegallocProductionArtifact =
    var bodyBytes = rawbytes.BytesBuilderFinish(lines)
    let payloadSha256 = regallocProductionSha256Bytes(bodyBytes)
    lines = rawbytes.BytesBuilderNew(
        rawbytes.BytesLen(bodyBytes) + len(hashKey) +
        len(payloadSha256) + 2)
    rawbytes.BytesBuilderAppend(lines, bodyBytes)
    rawbytes.BytesFree(bodyBytes)
    regallocProductionAppendLine(lines, hashKey, payloadSha256)
    var out: RegallocProductionArtifact
    out.valid = true
    out.payload = regallocProductionBuilderToString(lines)
    out.payloadSha256 = payloadSha256
    for index in 0..<symbols.len:
        add(out.functionSymbols, strings.CloneStr(symbols[index]))
    for index in 0..<roots.len:
        add(out.functionRootSha256s, strings.CloneStr(roots[index]))
    return out

@borrows
fn regallocProductionI32ArraysEqual(left: var int32[],
                                    right: var int32[]): bool =
    if left.len != right.len:
        return false
    for index in 0..<left.len:
        if left[index] != right[index]:
            return false
    return true

@borrows
fn regallocProductionA64ConstraintsValid(
        constraints: var alloc.RegallocTargetConstraints): bool =
    var universe: int32[]
    for reg in 0..<31:
        add(universe, reg)
    var caller: int32[]
    for reg in 9..<16:
        add(caller, reg)
    var callee: int32[]
    for reg in 19..<23:
        add(callee, reg)
    var reserved: int32[]
    for reg in 0..<9:
        add(reserved, reg)
    add(reserved, 16)
    add(reserved, 17)
    add(reserved, 18)
    add(reserved, 29)
    add(reserved, 30)
    var clobber: int32[]
    for reg in 0..<19:
        add(clobber, reg)
    add(clobber, 30)
    var args: int32[]
    for reg in 0..<8:
        add(args, reg)
    var kinds: int32[]
    add(kinds, 1)
    add(kinds, 4)
    add(kinds, 6)
    return regallocProductionI32ArraysEqual(
               constraints.registerUniverse, universe) &&
           regallocProductionI32ArraysEqual(
               constraints.allocatableCallerRegs, caller) &&
           regallocProductionI32ArraysEqual(
               constraints.allocatableCalleeRegs, callee) &&
           regallocProductionI32ArraysEqual(
               constraints.reservedRegs, reserved) &&
           regallocProductionI32ArraysEqual(
               constraints.callClobberRegs, clobber) &&
           regallocProductionI32ArraysEqual(
               constraints.fixedArgRegs, args) &&
           constraints.fixedResultReg == 0 &&
           constraints.fixedSretReg == 8 &&
           !constraints.sretShiftsFixedArgs &&
           constraints.fixedReturnReg == 0 &&
           constraints.parallelCopyScratchReg == 16 &&
           constraints.stackArgSlotBytes == 8 &&
           constraints.stackAlignmentBytes == 16 &&
           regallocProductionI32ArraysEqual(
               constraints.gprTypeKinds, kinds)

@borrows
fn regallocProductionX64LinuxConstraintsValid(
        constraints: var alloc.RegallocTargetConstraints): bool =
    var universe: int32[]
    for reg in 0..<16:
        add(universe, reg)
    var caller: int32[]
    add(caller, 10)
    var callee: int32[]
    add(callee, 3)
    for reg in 12..<16:
        add(callee, reg)
    var reserved: int32[]
    for reg in 0..<10:
        if reg != 3:
            add(reserved, reg)
    add(reserved, 11)
    var clobber: int32[]
    add(clobber, 0)
    add(clobber, 1)
    add(clobber, 2)
    add(clobber, 6)
    add(clobber, 7)
    add(clobber, 8)
    add(clobber, 9)
    add(clobber, 10)
    add(clobber, 11)
    var args: int32[]
    add(args, 7)
    add(args, 6)
    add(args, 2)
    add(args, 1)
    add(args, 8)
    add(args, 9)
    var kinds: int32[]
    add(kinds, 1)
    add(kinds, 4)
    add(kinds, 6)
    return regallocProductionI32ArraysEqual(
               constraints.registerUniverse, universe) &&
           regallocProductionI32ArraysEqual(
               constraints.allocatableCallerRegs, caller) &&
           regallocProductionI32ArraysEqual(
               constraints.allocatableCalleeRegs, callee) &&
           regallocProductionI32ArraysEqual(
               constraints.reservedRegs, reserved) &&
           regallocProductionI32ArraysEqual(
               constraints.callClobberRegs, clobber) &&
           regallocProductionI32ArraysEqual(
               constraints.fixedArgRegs, args) &&
           constraints.fixedResultReg == 0 &&
           constraints.fixedSretReg == 7 &&
           constraints.sretShiftsFixedArgs &&
           constraints.fixedReturnReg == 0 &&
           constraints.parallelCopyScratchReg == 11 &&
           !constraints.packedStackArgs &&
           constraints.stackArgSlotBytes == 8 &&
           constraints.stackAlignmentBytes == 16 &&
           regallocProductionI32ArraysEqual(
               constraints.gprTypeKinds, kinds)

fn regallocProductionRiscvConstraintsValid(
        constraints: var alloc.RegallocTargetConstraints): bool =
    var universe: int32[]
    for reg in 0..<32:
        add(universe, reg)
    var caller: int32[]
    add(caller, 6)
    add(caller, 7)
    add(caller, 28)
    add(caller, 29)
    add(caller, 30)
    add(caller, 31)
    var callee: int32[]
    add(callee, 8)
    add(callee, 9)
    add(callee, 18)
    add(callee, 19)
    var reserved: int32[]
    add(reserved, 0)
    add(reserved, 1)
    add(reserved, 2)
    add(reserved, 3)
    add(reserved, 4)
    add(reserved, 5)
    for argReg in 10..<18:
        add(reserved, argReg)
    var clobber: int32[]
    add(clobber, 1)
    add(clobber, 5)
    add(clobber, 6)
    add(clobber, 7)
    for argReg in 10..<18:
        add(clobber, argReg)
    add(clobber, 28)
    add(clobber, 29)
    add(clobber, 30)
    add(clobber, 31)
    var args: int32[]
    for argReg in 10..<18:
        add(args, argReg)
    var kinds64: int32[]
    add(kinds64, coreir.LocalI32Tag)
    add(kinds64, coreir.LocalPtrTag)
    add(kinds64, coreir.LocalI64Tag)
    var kinds32: int32[]
    add(kinds32, coreir.LocalI32Tag)
    add(kinds32, coreir.LocalPtrTag)
    return regallocProductionI32ArraysEqual(
               constraints.registerUniverse, universe) &&
           regallocProductionI32ArraysEqual(
               constraints.allocatableCallerRegs, caller) &&
           regallocProductionI32ArraysEqual(
               constraints.allocatableCalleeRegs, callee) &&
           regallocProductionI32ArraysEqual(
               constraints.reservedRegs, reserved) &&
           regallocProductionI32ArraysEqual(
               constraints.callClobberRegs, clobber) &&
           regallocProductionI32ArraysEqual(
               constraints.fixedArgRegs, args) &&
           constraints.fixedResultReg == 10 &&
           constraints.fixedSretReg == 10 &&
           constraints.sretShiftsFixedArgs &&
           constraints.fixedReturnReg == 10 &&
           constraints.parallelCopyScratchReg == 5 &&
           !constraints.packedStackArgs &&
           constraints.stackArgSlotBytes == 8 &&
           constraints.stackAlignmentBytes == 16 &&
           (regallocProductionI32ArraysEqual(
                constraints.gprTypeKinds, kinds64) ||
            regallocProductionI32ArraysEqual(
                constraints.gprTypeKinds, kinds32))

@borrows
fn regallocProductionConstraintsValid(
        constraints: var alloc.RegallocTargetConstraints): bool =
    return regallocProductionA64ConstraintsValid(constraints) ||
           regallocProductionX64LinuxConstraintsValid(constraints) ||
           regallocProductionRiscvConstraintsValid(constraints)

@borrows
fn regallocProductionActionKind(
        action: alloc.RegallocValueAction): str =
    let kind = action.kind
    if kind == alloc.RegallocValueActionEntryReload:
        if action.sourceLocation == alloc.RegallocValueLocationRegister:
            return "register_assignment"
        return "reload"
    if kind == alloc.RegallocValueActionReloadOperand ||
       kind == alloc.RegallocValueActionRestoreTemporary ||
       kind == alloc.RegallocValueActionReloadCall:
        return "reload"
    if kind == alloc.RegallocValueActionSpillTemporary ||
       kind == alloc.RegallocValueActionStoreDef ||
       kind == alloc.RegallocValueActionStoreFixedResult ||
       kind == alloc.RegallocValueActionSpillCall:
        return "spill"
    if kind == alloc.RegallocValueActionBindDef ||
       kind == alloc.RegallocValueActionBindFixedResult:
        return "register_assignment"
    if kind == alloc.RegallocValueActionStoreHome:
        return "stack_home_store"
    if kind == alloc.RegallocValueActionMoveFixed ||
       kind == alloc.RegallocValueActionAddressFixed:
        return "fixed_result_move"
    if kind == alloc.RegallocValueActionLoadFixed:
        if action.sourceLocation == alloc.RegallocValueLocationStack:
            return "reload"
        return "fixed_result_move"
    if kind == alloc.RegallocValueActionEdgeParallelCopy:
        if action.requiresEdgeSplit:
            return "critical_edge_copy"
        return "edge_parallel_copy"
    if kind == alloc.RegallocValueActionBindSretResult:
        return "sret_result_binding"
    if kind == alloc.RegallocValueActionStoreSretReturn:
        return "sret_return_store"
    if kind == alloc.RegallocValueActionStoreStackArg:
        return "outgoing_stack_arg_store"
    if kind == alloc.RegallocValueActionParallelScratchSave:
        return "parallel_copy_scratch_save"
    if kind == alloc.RegallocValueActionParallelScratchRestore:
        return "parallel_copy_scratch_restore"
    if kind == alloc.RegallocValueActionCallClobber:
        return "call_clobber"
    if kind == alloc.RegallocValueActionValueClassification:
        return "value_classification"
    if kind == alloc.RegallocValueActionLivenessInterval:
        return "liveness_interval"
    if kind == alloc.RegallocValueActionSretExclusion:
        return "sret_exclusion"
    if kind == alloc.RegallocValueActionAddressEscapeHome:
        return "address_escape_home"
    if kind == alloc.RegallocValueActionCalleeSavedSelection:
        return "callee_saved_selection"
    if kind == alloc.RegallocValueActionDeadValue:
        return "dead_value"
    if kind == alloc.RegallocValueActionCoalescedCopy:
        return "coalesced_copy"
    if kind == alloc.RegallocValueActionSretForward:
        return "sret_forward"
    if kind == alloc.RegallocValueActionBindCallWriteHome:
        return "call_write_home_binding"
    return ""

@borrows
fn RegallocProductionArtifactActionLedgerKind(
        action: alloc.RegallocValueAction): str =
    return regallocProductionActionKind(action)

@borrows
fn regallocProductionActionRootSha256(
        plan: var alloc.RegallocSinglePassValuePlan): str =
    var builder = rawbytes.BytesBuilderNew(256)
    regallocProductionBuilderAppendNativeText(
        builder, "regalloc-action-semantic-root")
    regallocProductionBuilderAppendNativeI32(
        builder, plan.actions.len)
    for actionIndex in 0..<plan.actions.len:
        let actionSha = regallocProductionActionSemanticSha256(
            plan.actions[actionIndex])
        if !regallocProductionShaValid(actionSha):
            rawbytes.BytesBuilderFree(builder)
            return ""
        regallocProductionBuilderAppendNativeText(builder, actionSha)
    return regallocProductionBuilderSha256(builder)

@borrows
fn regallocProductionConstraintsSha256(
        constraints: var alloc.RegallocTargetConstraints): str =
    var fields = regallocProductionConstraintFields(constraints)
    if !regallocProductionFieldsValid(
           fields, RegallocProductionConstraintFieldCount):
        return ""
    var builder = rawbytes.BytesBuilderNew(256)
    regallocProductionBuilderAppendText(
        builder, "regalloc-constraints;")
    regallocProductionBuilderAppendFieldsNative(builder, fields)
    return regallocProductionBuilderSha256(builder)

@borrows
fn regallocProductionPlanSha256(
        plan: var alloc.RegallocSinglePassValuePlan,
        actionRootSha256: str): str =
    var fields = regallocProductionPlanFields(plan)
    if !regallocProductionFieldsValid(
           fields, RegallocProductionPlanFieldCount) ||
       !regallocProductionShaValid(actionRootSha256):
        return ""
    let constraintsSha256 =
        regallocProductionConstraintsSha256(plan.constraints)
    if !regallocProductionShaValid(constraintsSha256):
        return ""
    var builder = rawbytes.BytesBuilderNew(1024)
    regallocProductionBuilderAppendText(builder, "regalloc-plan;")
    regallocProductionBuilderAppendNativeText(
        builder, constraintsSha256)
    regallocProductionBuilderAppendFieldsNative(builder, fields)
    regallocProductionBuilderAppendNativeText(
        builder, actionRootSha256)
    return regallocProductionBuilderSha256(builder)

@borrows
fn regallocProductionWordsSha256(words: var int32[],
                                 wordStart: int32,
                                 wordCount: int32): str =
    if wordStart < 0 || wordCount < 0 ||
       wordStart > words.len - wordCount ||
       wordCount > 536870911:
        return ""
    if wordCount == 0:
        return alloc.RegallocValueEmptySha256
    var bytes = rawbytes.BytesAlloc(wordCount * 4)
    if rawbytes.BytesLen(bytes) != wordCount * 4:
        rawbytes.BytesFree(bytes)
        return ""
    for wordIndex in 0..<wordCount:
        let word = uint32(words[wordStart + wordIndex])
        let byteStart = wordIndex * 4
        rawbytes.BytesSet(bytes, byteStart,
                          int32(word & uint32(255)))
        rawbytes.BytesSet(bytes, byteStart + 1,
                          int32((word >> uint32(8)) & uint32(255)))
        rawbytes.BytesSet(bytes, byteStart + 2,
                          int32((word >> uint32(16)) & uint32(255)))
        rawbytes.BytesSet(bytes, byteStart + 3,
                          int32((word >> uint32(24)) & uint32(255)))
    let payloadSha256 = regallocProductionSha256Bytes(bytes)
    rawbytes.BytesFree(bytes)
    return payloadSha256

@borrows
fn regallocProductionFragmentOwnerKind(ownerKind: int32): str =
    if ownerKind == contract.RegallocA64FragmentOwnerAction:
        return "action"
    if ownerKind == contract.RegallocA64FragmentOwnerOp:
        return "op"
    if ownerKind == contract.RegallocA64FragmentOwnerTerm:
        return "term"
    if ownerKind == contract.RegallocA64FragmentOwnerEdge:
        return "edge"
    if ownerKind == contract.RegallocA64FragmentOwnerAbiIngress:
        return "abi_ingress"
    if ownerKind == contract.RegallocA64FragmentOwnerEdgeTrampoline:
        return "edge_trampoline"
    if ownerKind == contract.RegallocA64FragmentOwnerFramePrologue:
        return "frame_prologue"
    if ownerKind == contract.RegallocA64FragmentOwnerFrameEpilogue:
        return "frame_epilogue"
    return ""

@borrows
fn regallocProductionRegIsAllocatable(
        plan: var alloc.RegallocSinglePassValuePlan,
        reg: int32): bool =
    for index in 0..<plan.constraints.allocatableCallerRegs.len:
        if plan.constraints.allocatableCallerRegs[index] == reg:
            return true
    for index in 0..<plan.constraints.allocatableCalleeRegs.len:
        if plan.constraints.allocatableCalleeRegs[index] == reg:
            return true
    return false

@borrows
fn regallocProductionFragmentWrittenRegs(
        plan: var alloc.RegallocSinglePassValuePlan,
        fragment: contract.RegallocA64MachineFragment): int32[] =
    var out: int32[]
    for sourceIndex in 0..<fragment.writtenRegs.len:
        let reg = fragment.writtenRegs[sourceIndex]
        if !regallocProductionRegIsAllocatable(plan, reg):
            continue
        var seen: bool
        for index in 0..<out.len:
            if out[index] == reg:
                seen = true
                break
        if !seen:
            add(out, reg)
    for left in 0..<out.len:
        var best = left
        for right in (left + 1)..<out.len:
            if out[right] < out[best]:
                best = right
        if best != left:
            let value = out[left]
            out[left] = out[best]
            out[best] = value
    return out

@borrows
fn regallocProductionWordOffsets(words: var int32[]): int32[] =
    var out: int32[]
    for index in 0..<words.len:
        if words[index] < 0 || words[index] > 536870911:
            return []
        add(out, words[index] * 4)
    return out

@borrows
fn regallocProductionRelocationIdentityValid(
        reloc: contract.RegallocA64ActionReloc): bool =
    let isCall = contract.CodegenUnitRelocKindIsCall(reloc.kind)
    if isCall:
        return reloc.callOrdinal >= 0 &&
               reloc.targetDomain >= 0 && reloc.targetRow >= 0 &&
               coreir.BodyIRTypeArenaArtifactCidValid(
                   reloc.targetInterfaceCid)
    return reloc.targetDomain == -1 && reloc.targetRow == -1 &&
           layout.FixedBytes32Equal(
               reloc.targetInterfaceCid, layout.FixedBytes32())

@borrows
fn regallocProductionRelocationSha256(
        reloc: contract.RegallocA64ActionReloc,
        fragment: contract.RegallocA64MachineFragment): str =
    let fragmentByteStart = fragment.wordStart * 4
    let fragmentByteLength = fragment.wordCount * 4
    if fragment.wordStart < 0 || fragment.wordCount <= 0 ||
       reloc.wordIndex < fragment.wordStart ||
       reloc.wordIndex >= fragment.wordStart + fragment.wordCount ||
       reloc.byteOffset < fragmentByteStart ||
       reloc.byteOffset > fragmentByteStart + fragmentByteLength - 4 ||
       reloc.opIndex < 0 ||
       !regallocProductionRelocationIdentityValid(reloc) ||
       !regallocProductionTextIsLineSafe(reloc.targetSymbol):
        return ""
    if reloc.kind == contract.RegallocMachineRelocPcRel32:
        if reloc.wordIndex != reloc.byteOffset / 4 ||
           reloc.callOrdinal < 0 || reloc.subIndex >= 0:
            return ""
    elif reloc.kind == contract.RegallocA64RelocCall26:
        if reloc.byteOffset != reloc.wordIndex * 4 ||
           reloc.callOrdinal < 0 || reloc.subIndex >= 0:
            return ""
    elif reloc.kind == contract.RegallocMachineRelocRiscvCall:
        if reloc.byteOffset != reloc.wordIndex * 4 ||
           reloc.wordIndex >= fragment.wordStart + fragment.wordCount - 1 ||
           reloc.callOrdinal < 0 || reloc.subIndex >= 0:
            return ""
    elif reloc.kind == contract.RegallocA64RelocPage21 ||
         reloc.kind == contract.RegallocA64RelocPageOff12:
        if reloc.byteOffset != reloc.wordIndex * 4 ||
           reloc.callOrdinal >= 0 || reloc.subIndex < 0:
            return ""
    else:
        return ""
    var builder = rawbytes.BytesBuilderNew(192)
    regallocProductionBuilderAppendNativeText(
        builder, "regalloc-machine-relocation")
    regallocProductionBuilderAppendNativeI32(builder, reloc.kind)
    regallocProductionBuilderAppendNativeI32(builder, reloc.wordIndex)
    regallocProductionBuilderAppendNativeI32(builder, reloc.byteOffset)
    regallocProductionBuilderAppendNativeI32(builder, reloc.callOrdinal)
    regallocProductionBuilderAppendNativeI32(builder, reloc.opIndex)
    regallocProductionBuilderAppendNativeI32(builder, reloc.subIndex)
    regallocProductionBuilderAppendNativeI32(builder, reloc.targetDomain)
    regallocProductionBuilderAppendNativeI32(builder, reloc.targetRow)
    for cidByteIndex in 0..<layout.FixedBytes32Size:
        rawbytes.BytesBuilderAppendByte(
            builder, int32(reloc.targetInterfaceCid.data[cidByteIndex]))
    regallocProductionBuilderAppendNativeText(
        builder, reloc.targetSymbol)
    return regallocProductionBuilderSha256(builder)

@borrows
fn regallocProductionFragmentRelocationRoot(
        fragment: contract.RegallocA64MachineFragment): str =
    var hashes: str[]
    for relocIndex in 0..<fragment.relocs.len:
        let relocSha256 = regallocProductionRelocationSha256(
            fragment.relocs[relocIndex], fragment)
        if !regallocProductionShaValid(relocSha256):
            return ""
        add(hashes, relocSha256)
    var builder = rawbytes.BytesBuilderNew(256)
    regallocProductionBuilderAppendNativeText(
        builder, "regalloc-machine-relocation-root")
    regallocProductionBuilderAppendNativeI32(builder, hashes.len)
    for hashIndex in 0..<hashes.len:
        regallocProductionBuilderAppendNativeText(
            builder, hashes[hashIndex])
    return regallocProductionBuilderSha256(builder)

@borrows
fn regallocProductionPackedMachineByte(
        words: var int32[],
        byteOffset: int32): int32 =
    if byteOffset < 0 || byteOffset >= words.len * 4:
        return -1
    let word = uint32(words[byteOffset / 4])
    let shift = uint32((byteOffset % 4) * 8)
    return int32((word >> shift) & uint32(255))

@borrows
fn regallocProductionPackedRel32Target(
        words: var int32[],
        immediateByteOffset: int32): int32 =
    if immediateByteOffset < 0 ||
       immediateByteOffset > words.len * 4 - 4:
        return -1
    let encoded =
        uint32(regallocProductionPackedMachineByte(
            words, immediateByteOffset)) |
        (uint32(regallocProductionPackedMachineByte(
            words, immediateByteOffset + 1)) << uint32(8)) |
        (uint32(regallocProductionPackedMachineByte(
            words, immediateByteOffset + 2)) << uint32(16)) |
        (uint32(regallocProductionPackedMachineByte(
            words, immediateByteOffset + 3)) << uint32(24))
    let target = int64(immediateByteOffset) + int64(4) +
                 int64(int32(encoded))
    if target < 0 || target > int64(2147483647):
        return -1
    return int32(target)

@borrows
fn regallocProductionFragmentBranchesValid(
        plan: var alloc.RegallocSinglePassValuePlan,
        recipes: var contract.RegallocA64FunctionRecipes,
        fragment: contract.RegallocA64MachineFragment): bool =
    let branchCount = fragment.branchWordIndices.len
    if fragment.branchTargetBlocks.len != branchCount ||
       fragment.branchTargetWordStarts.len != branchCount:
        return false
    let x8664 =
        regallocProductionX64LinuxConstraintsValid(plan.constraints)
    if !x8664:
        return fragment.branchByteOffsets.len == 0 &&
               fragment.branchTargetByteOffsets.len == 0
    if fragment.branchByteOffsets.len != branchCount ||
       fragment.branchTargetByteOffsets.len != branchCount:
        return false
    var expectedCount: int32
    if fragment.ownerKind ==
           contract.RegallocA64FragmentOwnerTerm:
        if fragment.irKind == coreir.BodyTermBrTag:
            expectedCount = 1
        elif fragment.irKind == coreir.BodyTermCbrTag:
            expectedCount = 2
        elif fragment.irKind != coreir.BodyTermReturnTag:
            return false
    elif fragment.ownerKind ==
             contract.RegallocA64FragmentOwnerEdgeTrampoline:
        expectedCount = 1
    if branchCount != expectedCount:
        return false
    let fragmentByteStart = fragment.wordStart * 4
    let fragmentByteEnd =
        (fragment.wordStart + fragment.wordCount) * 4
    for branchIndex in 0..<branchCount:
        let branchByte = fragment.branchByteOffsets[branchIndex]
        let targetByte =
            fragment.branchTargetByteOffsets[branchIndex]
        if branchByte < fragmentByteStart ||
           branchByte >= fragmentByteEnd ||
           targetByte < 0 ||
           targetByte >= recipes.functionWords.len * 4 ||
           fragment.branchWordIndices[branchIndex] !=
               branchByte / 4 ||
           fragment.branchTargetWordStarts[branchIndex] !=
               targetByte / 4:
            return false
        var immediateByte = branchByte + 1
        let opcode =
            regallocProductionPackedMachineByte(
                recipes.functionWords, branchByte)
        if opcode == 0x0F:
            let conditionOpcode =
                regallocProductionPackedMachineByte(
                    recipes.functionWords, branchByte + 1)
            if conditionOpcode < 0x80 ||
               conditionOpcode > 0x8F:
                return false
            immediateByte = branchByte + 2
        elif opcode != 0xE9:
            return false
        if immediateByte > fragmentByteEnd - 4 ||
           regallocProductionPackedRel32Target(
               recipes.functionWords, immediateByte) != targetByte:
            return false
    return true

@borrows
fn regallocProductionFragmentFields(
        plan: var alloc.RegallocSinglePassValuePlan,
        recipes: var contract.RegallocA64FunctionRecipes,
        fragmentIndex: int32): regallocProductionField[] =
    var out: regallocProductionField[]
    if fragmentIndex < 0 ||
       fragmentIndex >= recipes.machineFragments.len:
        return out
    let fragment = recipes.machineFragments[fragmentIndex]
    if !regallocProductionFragmentBranchesValid(
           plan, recipes, fragment):
        return out
    var expectedRiscvAuipc: int32
    var expectedRiscvAuipcValid: bool
    var expectedRiscvJalr: int32
    var expectedRiscvJalrValid: bool
    if recipes.machineXlen == 32 || recipes.machineXlen == 64:
        # B1（2026-08-25）：期望字改经契约单元回调（蓝图 3.2），消除与
        # emitter RelocsValid 的第二次 rvenc 直调复制。
        var riscvUnitId: int32 = contract.CodegenUnitRv64
        if recipes.machineXlen == 32:
            riscvUnitId = contract.CodegenUnitRv32
        let expectedPair = contract.CodegenUnitCallPairExpectedWords(
            riscvUnitId, recipes.machineXlen)
        if expectedPair.auipcOk:
            expectedRiscvAuipc =
                int32(int64(expectedPair.auipcWord))
            expectedRiscvAuipcValid = true
        if expectedPair.jalrOk:
            expectedRiscvJalr =
                int32(int64(expectedPair.jalrWord))
            expectedRiscvJalrValid = true
    for relocIndex in 0..<fragment.relocs.len:
        let reloc = fragment.relocs[relocIndex]
        if reloc.kind != contract.RegallocMachineRelocRiscvCall:
            continue
        if !expectedRiscvAuipcValid || !expectedRiscvJalrValid ||
           reloc.wordIndex < fragment.wordStart ||
           reloc.wordIndex >=
               fragment.wordStart + fragment.wordCount - 1 ||
           reloc.wordIndex >= recipes.functionWords.len - 1 ||
           recipes.functionWords[reloc.wordIndex] !=
               expectedRiscvAuipc ||
           recipes.functionWords[reloc.wordIndex + 1] !=
               expectedRiscvJalr:
            return out
    if recipes.encoderEvents.kinds.len > 0:
        if fragment.encoderEventStart != fragment.wordStart ||
           fragment.encoderEventCount != fragment.wordCount ||
           fragment.encoderEventStart < 0 ||
           fragment.encoderEventStart >
               recipes.encoderEvents.kinds.len -
                   fragment.encoderEventCount:
            return out
    elif fragment.encoderEventStart != -1 ||
         fragment.encoderEventCount != 0:
        return out
    let ownerKind = regallocProductionFragmentOwnerKind(
        fragment.ownerKind)
    var opIndex: int32 = -1
    var termIndex: int32 = -1
    if fragment.siteKind == 1:
        opIndex = fragment.siteIndex
    elif fragment.siteKind == 2:
        termIndex = fragment.siteIndex
    let machineSha256 = regallocProductionWordsSha256(
        recipes.functionWords, fragment.wordStart, fragment.wordCount)
    var writtenRegs = regallocProductionFragmentWrittenRegs(
        plan, fragment)
    var branchOffsets: int32[]
    var branchTargets: int32[]
    if fragment.branchByteOffsets.len > 0:
        for branchIndex in 0..<fragment.branchByteOffsets.len:
            add(branchOffsets,
                fragment.branchByteOffsets[branchIndex])
            add(branchTargets,
                fragment.branchTargetByteOffsets[branchIndex])
    else:
        for branchIndex in 0..<fragment.branchWordIndices.len:
            add(branchOffsets,
                fragment.branchWordIndices[branchIndex] * 4)
            add(branchTargets,
                fragment.branchTargetWordStarts[branchIndex] * 4)
    let relocationRootSha256 =
        regallocProductionFragmentRelocationRoot(fragment)
    var trampolineOffset: int32 = -1
    var targetOffset: int32 = -1
    if fragment.trampolineWordStart >= 0:
        trampolineOffset = fragment.trampolineWordStart * 4
    if fragment.trampolineTargetWordStart >= 0:
        targetOffset = fragment.trampolineTargetWordStart * 4
    add(out, regallocProductionFieldText("owner_kind", ownerKind))
    add(out, regallocProductionFieldI32(
        "action_ordinal", fragment.actionConsumerOrdinal))
    add(out, regallocProductionFieldI32(
        "block_index", fragment.blockIndex))
    add(out, regallocProductionFieldI32("op_index", opIndex))
    add(out, regallocProductionFieldI32("term_index", termIndex))
    add(out, regallocProductionFieldI32(
        "edge_index", fragment.edgeIndex))
    add(out, regallocProductionFieldI32(
        "source_block", fragment.sourceBlock))
    add(out, regallocProductionFieldI32(
        "target_block", fragment.targetBlock))
    add(out, regallocProductionFieldBool(
        "requires_edge_split", fragment.requiresEdgeSplit))
    add(out, regallocProductionFieldI32(
        "ingress_ordinal", fragment.ingressIndex))
    add(out, regallocProductionFieldI32("value_id", fragment.valueId))
    add(out, regallocProductionFieldI32(
        "machine_offset", fragment.wordStart * 4))
    add(out, regallocProductionFieldI32(
        "machine_size", fragment.wordCount * 4))
    add(out, regallocProductionFieldText(
        "machine_sha256", machineSha256))
    add(out, regallocProductionFieldBool(
        "effect_sp_load",
        (fragment.effectMask & contract.RegallocA64EffectSpLoad) != 0))
    add(out, regallocProductionFieldBool(
        "effect_sp_store",
        (fragment.effectMask & contract.RegallocA64EffectSpStore) != 0))
    add(out, regallocProductionFieldBool(
        "effect_call",
        (fragment.effectMask & contract.RegallocA64EffectCall) != 0))
    add(out, regallocProductionFieldBool(
        "effect_x16",
        (fragment.effectMask & contract.RegallocA64EffectX16) != 0))
    add(out, regallocProductionFieldBool(
        "effect_x17",
        (fragment.effectMask & contract.RegallocA64EffectX17) != 0))
    add(out, regallocProductionFieldI32Array(
        "effect_written_regs", writtenRegs))
    add(out, regallocProductionFieldI32Array(
        "allocator_clobber_fact_indices",
        fragment.allocatorClobberFactIndices))
    add(out, regallocProductionFieldI32(
        "relocation_count", fragment.relocs.len))
    add(out, regallocProductionFieldText(
        "relocation_root_sha256", relocationRootSha256))
    add(out, regallocProductionFieldI32Array(
        "branch_offsets", branchOffsets))
    add(out, regallocProductionFieldI32Array(
        "branch_target_offsets", branchTargets))
    add(out, regallocProductionFieldI32(
        "trampoline_offset", trampolineOffset))
    add(out, regallocProductionFieldI32(
        "target_offset", targetOffset))
    add(out, regallocProductionFieldI32(
        "machine_xlen", recipes.machineXlen))
    add(out, regallocProductionFieldI32(
        "encoder_event_start", fragment.encoderEventStart))
    add(out, regallocProductionFieldI32(
        "encoder_event_count", fragment.encoderEventCount))
    return out

@borrows
fn regallocProductionFragmentSha256(
        fields: var regallocProductionField[]): str =
    if !regallocProductionFieldsValid(fields, 30) ||
       fields[0].textValue == "" ||
       fields[21].i32Value < 0 ||
       !regallocProductionShaValid(fields[22].textValue) ||
       (fields[27].i32Value != 0 &&
        fields[27].i32Value != 32 && fields[27].i32Value != 64) ||
       fields[29].i32Value < 0 ||
       ((fields[29].i32Value == 0 && fields[28].i32Value != -1) ||
        (fields[29].i32Value > 0 && fields[28].i32Value < 0)):
        return ""
    var builder = rawbytes.BytesBuilderNew(256)
    regallocProductionBuilderAppendNativeText(
        builder, "regalloc-machine-fragment")
    regallocProductionBuilderAppendFieldsNative(builder, fields)
    return regallocProductionBuilderSha256(builder)

@borrows
fn regallocProductionHashRoot(domain: str,
                               hashes: var str[]): str =
    var builder = rawbytes.BytesBuilderNew(256)
    regallocProductionBuilderAppendNativeText(builder, domain)
    regallocProductionBuilderAppendNativeI32(builder, hashes.len)
    for index in 0..<hashes.len:
        if !regallocProductionShaValid(hashes[index]):
            rawbytes.BytesBuilderFree(builder)
            return ""
        regallocProductionBuilderAppendNativeText(
            builder, hashes[index])
    return regallocProductionBuilderSha256(builder)

@borrows
fn regallocProductionIngressFields(
        recipes: var contract.RegallocA64FunctionRecipes,
        ingressIndex: int32): regallocProductionField[] =
    var out: regallocProductionField[]
    if ingressIndex < 0 ||
       ingressIndex >= recipes.abiIngressRegs.len ||
       ingressIndex >= recipes.abiIngressOffsets.len ||
       ingressIndex >= recipes.abiIngressParamOrdinals.len ||
       ingressIndex >= recipes.abiIngressValueIds.len ||
       ingressIndex >= recipes.abiIngressWidths.len ||
       ingressIndex >= recipes.abiIngressWordIndices.len ||
       ingressIndex >= recipes.abiIngressWordCounts.len:
        return out
    if recipes.abiIngressParamOrdinals[ingressIndex] < 0:
        add(out, regallocProductionFieldText(
            "role", "sret_pointer"))
    elif recipes.abiIngressOffsets[ingressIndex] < 0:
        add(out, regallocProductionFieldText(
            "role", "parameter_register"))
    else:
        add(out, regallocProductionFieldText(
            "role", "parameter_home"))
    let wordStart = recipes.abiIngressWordIndices[ingressIndex]
    let wordCount = recipes.abiIngressWordCounts[ingressIndex]
    let machineSha256 = regallocProductionWordsSha256(
        recipes.functionWords, wordStart, wordCount)
    add(out, regallocProductionFieldI32(
        "param_ordinal",
        recipes.abiIngressParamOrdinals[ingressIndex]))
    add(out, regallocProductionFieldI32(
        "value_id", recipes.abiIngressValueIds[ingressIndex]))
    add(out, regallocProductionFieldI32(
        "reg", recipes.abiIngressRegs[ingressIndex]))
    add(out, regallocProductionFieldI32(
        "width", recipes.abiIngressWidths[ingressIndex]))
    add(out, regallocProductionFieldI32(
        "sp_offset", recipes.abiIngressOffsets[ingressIndex]))
    add(out, regallocProductionFieldI32(
        "machine_offset", wordStart * 4))
    add(out, regallocProductionFieldI32(
        "machine_size", wordCount * 4))
    add(out, regallocProductionFieldText(
        "machine_sha256", machineSha256))
    return out

@borrows
fn regallocProductionIngressSha256(
        fields: var regallocProductionField[]): str =
    if !regallocProductionFieldsValid(fields, 9):
        return ""
    var builder = rawbytes.BytesBuilderNew(256)
    regallocProductionBuilderAppendNativeText(
        builder, "regalloc-abi-ingress")
    regallocProductionBuilderAppendFieldsNative(builder, fields)
    return regallocProductionBuilderSha256(builder)

@borrows
fn regallocProductionRelocPayloadEqual(
        left: contract.RegallocA64ActionReloc,
        right: contract.RegallocA64ActionReloc): bool =
    return left.kind == right.kind &&
           left.callOrdinal == right.callOrdinal &&
           left.opIndex == right.opIndex &&
           left.subIndex == right.subIndex &&
           left.targetDomain == right.targetDomain &&
           left.targetRow == right.targetRow &&
           layout.FixedBytes32Equal(
               left.targetInterfaceCid, right.targetInterfaceCid) &&
           left.targetSymbol == right.targetSymbol

@borrows
fn regallocProductionFragmentRelocMatchesFunction(
        recipes: var contract.RegallocA64FunctionRecipes,
        fragmentIndex: int32,
        fragmentRelocIndex: int32,
        functionRelocIndex: int32): bool =
    return recipes.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].kind ==
               recipes.functionRelocs[functionRelocIndex].kind &&
           recipes.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].callOrdinal ==
               recipes.functionRelocs[functionRelocIndex].callOrdinal &&
           recipes.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].opIndex ==
               recipes.functionRelocs[functionRelocIndex].opIndex &&
           recipes.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].subIndex ==
               recipes.functionRelocs[functionRelocIndex].subIndex &&
           recipes.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].targetDomain ==
               recipes.functionRelocs[functionRelocIndex].targetDomain &&
           recipes.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].targetRow ==
               recipes.functionRelocs[functionRelocIndex].targetRow &&
           layout.FixedBytes32Equal(
               recipes.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].targetInterfaceCid,
               recipes.functionRelocs[functionRelocIndex].targetInterfaceCid) &&
           recipes.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].targetSymbol ==
               recipes.functionRelocs[functionRelocIndex].targetSymbol &&
           recipes.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].wordIndex ==
               recipes.functionRelocs[functionRelocIndex].wordIndex &&
           recipes.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].byteOffset ==
               recipes.functionRelocs[functionRelocIndex].byteOffset

@borrows
fn regallocProductionRecipeRelocMatchesFunction(
        recipes: var contract.RegallocA64FunctionRecipes,
        recipeIndex: int32,
        recipeRelocIndex: int32,
        functionRelocIndex: int32,
        actionWordStart: int32): bool =
    let absoluteWordIndex = actionWordStart +
        recipes.recipes[recipeIndex].relocs[recipeRelocIndex].wordIndex
    return recipes.recipes[recipeIndex].relocs[recipeRelocIndex].kind ==
               recipes.functionRelocs[functionRelocIndex].kind &&
           recipes.recipes[recipeIndex].relocs[recipeRelocIndex].callOrdinal ==
               recipes.functionRelocs[functionRelocIndex].callOrdinal &&
           recipes.recipes[recipeIndex].relocs[recipeRelocIndex].opIndex ==
               recipes.functionRelocs[functionRelocIndex].opIndex &&
           recipes.recipes[recipeIndex].relocs[recipeRelocIndex].subIndex ==
               recipes.functionRelocs[functionRelocIndex].subIndex &&
           recipes.recipes[recipeIndex].relocs[recipeRelocIndex].targetDomain ==
               recipes.functionRelocs[functionRelocIndex].targetDomain &&
           recipes.recipes[recipeIndex].relocs[recipeRelocIndex].targetRow ==
               recipes.functionRelocs[functionRelocIndex].targetRow &&
           layout.FixedBytes32Equal(
               recipes.recipes[recipeIndex].relocs[recipeRelocIndex].targetInterfaceCid,
               recipes.functionRelocs[functionRelocIndex].targetInterfaceCid) &&
           recipes.recipes[recipeIndex].relocs[recipeRelocIndex].targetSymbol ==
               recipes.functionRelocs[functionRelocIndex].targetSymbol &&
           recipes.functionRelocs[functionRelocIndex].wordIndex ==
               absoluteWordIndex &&
           recipes.functionRelocs[functionRelocIndex].byteOffset ==
               actionWordStart * 4 +
               recipes.recipes[recipeIndex].relocs[recipeRelocIndex].byteOffset

@borrows
fn regallocProductionFrozenRelocsAligned(
        recipes: var contract.RegallocA64FunctionRecipes): bool =
    var functionRelocIndex: int32
    for fragmentIndex in 0..<recipes.machineFragments.len:
        for fragmentRelocIndex in
                0..<recipes.machineFragments[fragmentIndex].relocs.len:
            if functionRelocIndex >= recipes.functionRelocs.len:
                return false
            if !regallocProductionFragmentRelocMatchesFunction(
                   recipes, fragmentIndex, fragmentRelocIndex,
                   functionRelocIndex):
                return false
            functionRelocIndex = functionRelocIndex + 1
    if functionRelocIndex != recipes.functionRelocs.len ||
       (recipes.recipes.len != 0 &&
        recipes.recipes.len != recipes.actionWordStarts.len):
        return false
    var functionRelocRowsByWord: int32[]
    setLen(functionRelocRowsByWord, recipes.functionWords.len)
    for wordIndex in 0..<functionRelocRowsByWord.len:
        functionRelocRowsByWord[wordIndex] = -1
    for relocIndex in 0..<recipes.functionRelocs.len:
        let wordIndex = recipes.functionRelocs[relocIndex].wordIndex
        if wordIndex < 0 || wordIndex >= functionRelocRowsByWord.len ||
           functionRelocRowsByWord[wordIndex] >= 0:
            return false
        functionRelocRowsByWord[wordIndex] = relocIndex
    for actionIndex in 0..<recipes.recipes.len:
        let actionWordStart = recipes.actionWordStarts[actionIndex]
        if actionWordStart < 0:
            return false
        for recipeRelocIndex in
                0..<recipes.recipes[actionIndex].relocs.len:
            let absoluteWordIndex = actionWordStart +
                recipes.recipes[actionIndex].relocs[recipeRelocIndex].wordIndex
            if absoluteWordIndex < 0 ||
               absoluteWordIndex >= functionRelocRowsByWord.len:
                return false
            let functionRow =
                functionRelocRowsByWord[absoluteWordIndex]
            if functionRow < 0:
                return false
            if !regallocProductionRecipeRelocMatchesFunction(
                   recipes, actionIndex, recipeRelocIndex,
                   functionRow, actionWordStart):
                return false
    return true

@borrows
fn RegallocProductionMachineRecipeProofBuild(
        plan: var alloc.RegallocSinglePassValuePlan,
        recipes: var contract.RegallocA64FunctionRecipes): RegallocProductionMachineRecipeProof =
    var out: RegallocProductionMachineRecipeProof
    # Diagnostic stage codes (1041..1048) on failure paths only: each gate
    # writes plan.errorDetail before returning so the entry-bridge emission
    # verdict can carry the exact rejected proof stage. Zero effect on
    # success paths and on the accept/reject decision itself.
    if !recipes.valid || recipes.functionWords.len <= 0 ||
       recipes.machineFragments.len <= 0:
        plan.errorDetail = 1041
        out.errorCode = RegallocProductionArtifactStateInvalid
        return out
    if !encev.CodegenEncoderEventTableStrictValidate(
            recipes.encoderEvents) &&
       !encev.CodegenEncoderEventTableCanonicalEmpty(
            recipes.encoderEvents):
        plan.errorDetail = 1042
        out.errorCode = RegallocProductionArtifactStateInvalid
        return out
    if !regallocProductionFrozenRelocsAligned(recipes):
        plan.errorDetail = 1043
        out.errorCode = RegallocProductionArtifactStateInvalid
        return out
    var lastEnd: int32
    for fragmentIndex in 0..<recipes.machineFragments.len:
        let wordStart = recipes.machineFragments[fragmentIndex].wordStart
        let wordCount = recipes.machineFragments[fragmentIndex].wordCount
        if wordStart < lastEnd || wordCount <= 0 ||
           wordStart > recipes.functionWords.len - wordCount:
            plan.errorDetail = 1044000 + fragmentIndex
            out.errorCode = RegallocProductionArtifactStateInvalid
            return out
        var fields = regallocProductionFragmentFields(
            plan, recipes, fragmentIndex)
        let sha256 = regallocProductionFragmentSha256(fields)
        if !regallocProductionShaValid(sha256):
            plan.errorDetail = 1045000 + fragmentIndex
            out.errorCode = RegallocProductionArtifactSemanticDrift
            return out
        add(out.fragmentSha256s, sha256)
        lastEnd = wordStart + wordCount
    out.fragmentRootSha256 = regallocProductionHashRoot(
        "regalloc-machine-fragment-root",
        out.fragmentSha256s)
    for ingressIndex in 0..<recipes.abiIngressRegs.len:
        var fields = regallocProductionIngressFields(
            recipes, ingressIndex)
        let sha256 = regallocProductionIngressSha256(fields)
        if !regallocProductionShaValid(sha256):
            plan.errorDetail = 1046000 + ingressIndex
            out.errorCode = RegallocProductionArtifactSemanticDrift
            return out
        add(out.ingressSha256s, sha256)
    out.ingressRootSha256 = regallocProductionHashRoot(
        "regalloc-abi-ingress-root", out.ingressSha256s)
    if !regallocProductionShaValid(out.fragmentRootSha256):
        plan.errorDetail = 1047
        out.errorCode = RegallocProductionArtifactSemanticDrift
        return out
    if !regallocProductionShaValid(out.ingressRootSha256):
        plan.errorDetail = 1048
        out.errorCode = RegallocProductionArtifactSemanticDrift
        return out
    out.valid = true
    return out

@borrows
fn RegallocProductionBindMachineRecipe(
        plan: var alloc.RegallocSinglePassValuePlan,
        recipes: var contract.RegallocA64FunctionRecipes): bool =
    # Diagnostic stage codes (101..106) on failure paths only: same accept/
    # reject decision as before (short-circuit order preserved), each gate
    # now records plan.errorDetail so the entry-bridge emission verdict can
    # carry the exact rejected bind stage. Zero effect on success paths.
    let encoderEventCount = recipes.encoderEvents.kinds.len
    if encoderEventCount > 0:
        if !encev.CodegenEncoderEventTableStrictValidate(
               recipes.encoderEvents):
            plan.errorDetail = 101
            return false
        if !alloc.RegallocSinglePassValuePlanPrebindRiscvEncoderReceipt(
               plan, encoderEventCount,
               layout.FixedBytes32Hex(
                   recipes.encoderEvents.orderedRoot)):
            plan.errorDetail = 102
            return false
    elif !encev.CodegenEncoderEventTableCanonicalEmpty(
             recipes.encoderEvents):
        plan.errorDetail = 103
        return false
    let proof = RegallocProductionMachineRecipeProofBuild(plan, recipes)
    if !proof.valid:
        if plan.errorDetail <= 0:
            plan.errorDetail = 104
        return false
    var fragmentOrdinals: int32[]
    var effectSpLoad: bool[]
    var effectSpStore: bool[]
    var effectCall: bool[]
    var effectX16: bool[]
    var effectX17: bool[]
    for actionIndex in 0..<plan.actions.len:
        add(fragmentOrdinals, -1)
        add(effectSpLoad, false)
        add(effectSpStore, false)
        add(effectCall, false)
        add(effectX16, false)
        add(effectX17, false)
    for fragmentIndex in 0..<recipes.machineFragments.len:
        let actionIndex =
            recipes.machineFragments[fragmentIndex].actionConsumerOrdinal
        if actionIndex < 0:
            continue
        let ownerKind = recipes.machineFragments[fragmentIndex].ownerKind
        let effectMask = recipes.machineFragments[fragmentIndex].effectMask
        if actionIndex >= plan.actions.len ||
           fragmentOrdinals[actionIndex] >= 0 ||
           (ownerKind != contract.RegallocA64FragmentOwnerAction &&
            ownerKind != contract.RegallocA64FragmentOwnerEdge &&
            ownerKind != contract.RegallocA64FragmentOwnerAbiIngress):
            plan.errorDetail = 105 + (ownerKind % 10)
            return false
        fragmentOrdinals[actionIndex] = fragmentIndex
        effectSpLoad[actionIndex] =
            (effectMask & contract.RegallocA64EffectSpLoad) != 0
        effectSpStore[actionIndex] =
            (effectMask & contract.RegallocA64EffectSpStore) != 0
        effectCall[actionIndex] =
            (effectMask & contract.RegallocA64EffectCall) != 0
        effectX16[actionIndex] =
            (effectMask & contract.RegallocA64EffectX16) != 0
        effectX17[actionIndex] =
            (effectMask & contract.RegallocA64EffectX17) != 0
    if !alloc.RegallocSinglePassValuePlanBindMachineRecipe(
            plan, recipes.machineFragments.len,
            proof.fragmentRootSha256,
            recipes.abiIngressRegs.len,
            proof.ingressRootSha256,
            fragmentOrdinals, effectSpLoad, effectSpStore,
            effectCall, effectX16, effectX17):
        if plan.errorDetail <= 0:
            plan.errorDetail = 106
        return false
    return true

@borrows
fn regallocProductionFrozenPlanValid(
        plan: var alloc.RegallocSinglePassValuePlan,
        recipes: var contract.RegallocA64FunctionRecipes): int32 =
    if !plan.valid || !plan.frozen || plan.finalized ||
       plan.emissionSymbolBound || plan.emissionSymbolSealed ||
       plan.nextIssueOrdinal != 0 || plan.nextAckOrdinal != 0 ||
       plan.actionEmissions.len != 0 || !plan.productionRecipeBound:
        return RegallocProductionArtifactStateInvalid
    if plan.actionIssued.len != plan.actions.len:
        return RegallocProductionArtifactStateInvalid
    if !regallocProductionActionSchemaValid():
        return RegallocProductionArtifactFieldDrift
    for actionIndex in 0..<plan.actions.len:
        if plan.actionIssued[actionIndex] ||
           plan.actions[actionIndex].acknowledged ||
           plan.actions[actionIndex].consumerOrdinal != actionIndex:
            return RegallocProductionArtifactStateInvalid
        if len(regallocProductionActionKind(plan.actions[actionIndex])) == 0:
            return RegallocProductionArtifactUnknownActionKind
    var constraintFields = regallocProductionConstraintFields(
        plan.constraints)
    var planFields = regallocProductionPlanFields(plan)
    if !regallocProductionFieldsValid(
           constraintFields, RegallocProductionConstraintFieldCount) ||
       !regallocProductionFieldsValid(
           planFields, RegallocProductionPlanFieldCount):
        return RegallocProductionArtifactFieldDrift
    if !alloc.RegallocSinglePassValuePlanValidate(plan) ||
       !regallocProductionConstraintsValid(plan.constraints):
        return RegallocProductionArtifactStateInvalid
    let actionRoot = regallocProductionActionRootSha256(plan)
    let planSha = regallocProductionPlanSha256(plan, actionRoot)
    if actionRoot != plan.actionSemanticRootSha256 ||
       planSha != plan.frozenSemanticSha256:
        return RegallocProductionArtifactSemanticDrift
    let proof = RegallocProductionMachineRecipeProofBuild(plan, recipes)
    if !proof.valid ||
       proof.fragmentRootSha256 != plan.machineFragmentRootSha256 ||
       proof.ingressRootSha256 != plan.abiIngressRootSha256 ||
       recipes.machineFragments.len != plan.machineFragmentCount ||
       recipes.abiIngressRegs.len != plan.abiIngressCount:
        return RegallocProductionArtifactSemanticDrift
    let encoderEventCount = recipes.encoderEvents.kinds.len
    if encoderEventCount > 0:
        if !encev.CodegenEncoderEventTableStrictValidate(
               recipes.encoderEvents) ||
           plan.riscvEncoderEventCount != encoderEventCount ||
           plan.riscvEncoderEventRootSha256 !=
               layout.FixedBytes32Hex(
                   recipes.encoderEvents.orderedRoot):
            return RegallocProductionArtifactSemanticDrift
    elif plan.riscvEncoderEventCount != 0 ||
         len(plan.riscvEncoderEventRootSha256) != 0 ||
         !encev.CodegenEncoderEventTableCanonicalEmpty(
             recipes.encoderEvents):
        return RegallocProductionArtifactSemanticDrift
    return RegallocProductionArtifactOk

fn RegallocProductionFrozenPlanSnapshotSerialize(
        metadata: RegallocProductionSnapshotMetadata,
        functions: var RegallocProductionSnapshotFunction[]): RegallocProductionArtifact =
    if !regallocProductionShaValid(metadata.fixtureSourceSha256) ||
       !regallocProductionShaValid(metadata.sourceManifestSha256) ||
       !regallocProductionShaValid(metadata.driverSha256) ||
       !RegallocProductionTargetUsesCanonicalRegalloc(metadata.target) ||
       functions.len <= 0:
        return regallocProductionFailure(
            RegallocProductionArtifactMetadataInvalid)
    var symbols: str[]
    var roots: str[]
    var consumptionIndex =
        RegallocProductionFunctionIndexInit(functions.len)
    for functionIndex in 0..<functions.len:
        let symbol = functions[functionIndex].symbol
        if !regallocProductionSymbolValid(symbol) ||
           !RegallocProductionFunctionIdentityValid(
               functions[functionIndex].functionIrIndex,
               functions[functionIndex].functionKind) ||
           !regallocProductionShaValid(
               functions[functionIndex].bodyIrSha256) ||
           !regallocProductionTargetPlanMatches(
               metadata.target, functions[functionIndex].plan) ||
           !regallocProductionTargetRecipeMatches(
               metadata.target, functions[functionIndex].recipes) ||
           functions[functionIndex].recipeOrigin !=
                RegallocProductionRecipeOriginBodyIrAdapter:
            return regallocProductionFailure(
                RegallocProductionArtifactMetadataInvalid)
        let appendCode = RegallocProductionFunctionIndexAppend(
            consumptionIndex,
            functions[functionIndex].functionIrIndex,
            functions[functionIndex].functionKind,
            symbol)
        if appendCode ==
               RegallocProductionFunctionIndexAppendDuplicateSymbol:
            return regallocProductionFailure(
                RegallocProductionArtifactDuplicateSymbol)
        if appendCode != RegallocProductionFunctionIndexAppendOk:
            return regallocProductionFailure(
                RegallocProductionArtifactBindingMismatch)
        let stateCode = regallocProductionFrozenPlanValid(
            functions[functionIndex].plan,
            functions[functionIndex].recipes)
        if stateCode != RegallocProductionArtifactOk:
            return regallocProductionFailure(stateCode)
        add(symbols, strings.CloneStr(symbol))
        add(roots, strings.CloneStr(
            functions[functionIndex].plan.frozenSemanticSha256))
    var lines = rawbytes.BytesBuilderNew(4096)
    regallocProductionAppendLine(
        lines, "schema", RegallocProductionFrozenSnapshotSchema)
    regallocProductionAppendLine(
        lines, "phase", RegallocProductionFrozenSnapshotPhase)
    regallocProductionAppendLine(
        lines, "fixture_source_sha256", metadata.fixtureSourceSha256)
    regallocProductionAppendLine(
        lines, "source_manifest_sha256", metadata.sourceManifestSha256)
    regallocProductionAppendLine(
        lines, "driver_sha256", metadata.driverSha256)
    regallocProductionAppendLine(lines, "target", metadata.target)
    regallocProductionAppendI32Line(
        lines, "function_count", functions.len)
    for functionIndex in 0..<functions.len:
        let symbol = functions[functionIndex].symbol
        let functionPrefix = strutil.Join([
            "function.", strings.IntToStr(functionIndex), "."
        ], "")
        regallocProductionAppendLine(
            lines, strutil.Join([share(functionPrefix), "symbol"], ""), symbol)
        regallocProductionAppendI32Line(
            lines,
            strutil.Join([share(functionPrefix), "function_ir_index"], ""),
            functions[functionIndex].functionIrIndex)
        regallocProductionAppendI32Line(
            lines,
            strutil.Join([share(functionPrefix), "function_kind"], ""),
            functions[functionIndex].functionKind)
        regallocProductionAppendLine(
            lines,
            strutil.Join([share(functionPrefix), "body_ir_sha256"], ""),
            functions[functionIndex].bodyIrSha256)
        regallocProductionAppendLine(
            lines,
            strutil.Join([share(functionPrefix), "recipe_origin"], ""),
            functions[functionIndex].recipeOrigin)
        regallocProductionAppendLine(
            lines, strutil.Join([share(functionPrefix), "frozen"], ""), "1")
        regallocProductionAppendLine(
            lines, strutil.Join([share(functionPrefix), "finalized"], ""), "0")
        regallocProductionAppendLine(
            lines,
            strutil.Join([share(functionPrefix), "emission_symbol_bound"], ""),
            "0")
        regallocProductionAppendLine(
            lines,
            strutil.Join([share(functionPrefix), "next_issue_ordinal"], ""),
            "0")
        regallocProductionAppendLine(
            lines,
            strutil.Join([share(functionPrefix), "next_ack_ordinal"], ""),
            "0")
        regallocProductionAppendLine(
            lines,
            strutil.Join([share(functionPrefix), "action_emission_count"], ""),
            "0")
        var constraintFields = regallocProductionConstraintFields(
            functions[functionIndex].plan.constraints)
        regallocProductionAppendFields(
            lines, strutil.Join([share(functionPrefix), "constraint."], ""),
            constraintFields)
        var planFields = regallocProductionPlanFields(
            functions[functionIndex].plan)
        regallocProductionAppendFields(
            lines, strutil.Join([share(functionPrefix), "plan."], ""),
            planFields)
        var blockOffsets = regallocProductionWordOffsets(
            functions[functionIndex].recipes.blockWordStarts)
        regallocProductionAppendI32ArrayLine(
            lines,
            strutil.Join([share(functionPrefix),
                          "recipe.parameter_value_ids"], ""),
            functions[functionIndex].recipes.parameterValueIds)
        regallocProductionAppendI32ArrayLine(
            lines,
            strutil.Join([share(functionPrefix),
                          "recipe.parameter_widths"], ""),
            functions[functionIndex].recipes.parameterWidths)
        regallocProductionAppendI32ArrayLine(
            lines,
            strutil.Join([share(functionPrefix),
                          "recipe.parameter_home_offsets"], ""),
            functions[functionIndex].recipes.parameterHomeOffsets)
        regallocProductionAppendBoolLine(
            lines,
            strutil.Join([share(functionPrefix),
                          "recipe.returns_via_sret"], ""),
            functions[functionIndex].recipes.hasSretReturn)
        regallocProductionAppendI32Line(
            lines,
            strutil.Join([share(functionPrefix),
                          "recipe.frame_size_bytes"], ""),
            functions[functionIndex].recipes.frameBytes)
        regallocProductionAppendI32Line(
            lines,
            strutil.Join([share(functionPrefix),
                          "recipe.callee_region_end"], ""),
            functions[functionIndex].recipes.calleeRegionEnd)
        regallocProductionAppendI32Line(
            lines,
            strutil.Join([share(functionPrefix),
                          "recipe.ingress_region_start"], ""),
            functions[functionIndex].recipes.ingressRegionStart)
        regallocProductionAppendI32Line(
            lines,
            strutil.Join([share(functionPrefix),
                          "recipe.ingress_region_size"], ""),
            functions[functionIndex].recipes.ingressRegionSize)
        regallocProductionAppendI32Line(
            lines,
            strutil.Join([share(functionPrefix),
                          "recipe.body_region_start"], ""),
            functions[functionIndex].recipes.bodyRegionStart)
        regallocProductionAppendI32ArrayLine(
            lines,
            strutil.Join([share(functionPrefix),
                          "recipe.block_offsets"], ""),
            blockOffsets)
        let actionCount = functions[functionIndex].plan.actions.len
        regallocProductionAppendI32Line(
            lines, strutil.Join([share(functionPrefix), "action_count"], ""),
            actionCount)
        for actionIndex in 0..<actionCount:
            let actionPrefix = strutil.Join([
                share(functionPrefix), "action.", strings.IntToStr(actionIndex), "."
            ], "")
            let ledgerKind = regallocProductionActionKind(
                functions[functionIndex].plan.actions[actionIndex])
            regallocProductionAppendLine(
                lines, strutil.Join([share(actionPrefix), "ledger_kind"], ""),
                ledgerKind)
            regallocProductionAppendLine(
                lines, strutil.Join([share(actionPrefix), "acknowledged"], ""),
                "0")
            if !regallocProductionActionAppendFields(
                   lines, actionPrefix,
                   functions[functionIndex].plan.actions[actionIndex]):
                rawbytes.BytesBuilderFree(lines)
                return regallocProductionFailure(
                    RegallocProductionArtifactFieldDrift)
            regallocProductionAppendI32Line(
                lines,
                strutil.Join([share(actionPrefix), "fragment_ordinal"], ""),
                functions[functionIndex].plan.actions[
                    actionIndex].fragmentOrdinal)
            regallocProductionAppendBoolLine(
                lines, strutil.Join([share(actionPrefix),
                                     "effect_sp_load"], ""),
                functions[functionIndex].plan.actions[
                    actionIndex].effectSpLoad)
            regallocProductionAppendBoolLine(
                lines, strutil.Join([share(actionPrefix),
                                     "effect_sp_store"], ""),
                functions[functionIndex].plan.actions[
                    actionIndex].effectSpStore)
            regallocProductionAppendBoolLine(
                lines, strutil.Join([share(actionPrefix),
                                     "effect_call"], ""),
                functions[functionIndex].plan.actions[
                    actionIndex].effectCall)
            regallocProductionAppendBoolLine(
                lines, strutil.Join([share(actionPrefix),
                                     "effect_x16"], ""),
                functions[functionIndex].plan.actions[
                    actionIndex].effectX16)
            regallocProductionAppendBoolLine(
                lines, strutil.Join([share(actionPrefix),
                                     "effect_x17"], ""),
                functions[functionIndex].plan.actions[
                    actionIndex].effectX17)
        let fragmentCount =
            functions[functionIndex].recipes.machineFragments.len
        regallocProductionAppendI32Line(
            lines, strutil.Join([share(functionPrefix), "fragment_count"], ""),
            fragmentCount)
        regallocProductionAppendLine(
            lines,
            strutil.Join([share(functionPrefix),
                          "fragment_root_sha256"], ""),
            functions[functionIndex].plan.machineFragmentRootSha256)
        let encoderEventCount =
            functions[functionIndex].recipes.encoderEvents.kinds.len
        regallocProductionAppendI32Line(
            lines,
            strutil.Join([share(functionPrefix),
                          "riscv_encoder_event_count"], ""),
            encoderEventCount)
        if encoderEventCount > 0:
            let encoderEvents =
                functions[functionIndex].recipes.encoderEvents
            regallocProductionAppendI32Line(
                lines,
                strutil.Join([share(functionPrefix),
                              "riscv_encoder_source_row"], ""),
                encoderEvents.encoderSourceRow)
            regallocProductionAppendLine(
                lines,
                strutil.Join([share(functionPrefix),
                              "riscv_encoder_source_cid"], ""),
                layout.FixedBytes32Hex(encoderEvents.encoderSourceCid))
            regallocProductionAppendI32Line(
                lines,
                strutil.Join([share(functionPrefix),
                              "riscv_encoder_xlen"], ""),
                encoderEvents.encoderXlen)
            regallocProductionAppendI32Line(
                lines,
                strutil.Join([share(functionPrefix),
                              "riscv_encoder_reserved_row_count"], ""),
                encoderEvents.reservedRowCount)
            regallocProductionAppendI64Line(
                lines,
                strutil.Join([share(functionPrefix),
                              "riscv_encoder_retained_bytes"], ""),
                encoderEvents.retainedBytes)
            regallocProductionAppendLine(
                lines,
                strutil.Join([share(functionPrefix),
                              "riscv_encoder_event_root_sha256"], ""),
                layout.FixedBytes32Hex(encoderEvents.orderedRoot))
            for encoderEventRow in 0..<encoderEventCount:
                let eventPrefix = strutil.Join([
                    share(functionPrefix), "riscv_encoder_event.",
                    strings.IntToStr(encoderEventRow), "."
                ], "")
                regallocProductionAppendI32Line(
                    lines, strutil.Join([share(eventPrefix), "kind"], ""),
                    encoderEvents.kinds[encoderEventRow])
                regallocProductionAppendI32Line(
                    lines,
                    strutil.Join([share(eventPrefix), "operand_count"], ""),
                    encoderEvents.operandCounts[encoderEventRow])
                regallocProductionAppendI64Line(
                    lines, strutil.Join([share(eventPrefix), "operand0"], ""),
                    encoderEvents.operand0s[encoderEventRow])
                regallocProductionAppendI64Line(
                    lines, strutil.Join([share(eventPrefix), "operand1"], ""),
                    encoderEvents.operand1s[encoderEventRow])
                regallocProductionAppendI64Line(
                    lines, strutil.Join([share(eventPrefix), "operand2"], ""),
                    encoderEvents.operand2s[encoderEventRow])
                regallocProductionAppendI64Line(
                    lines, strutil.Join([share(eventPrefix), "operand3"], ""),
                    encoderEvents.operand3s[encoderEventRow])
                regallocProductionAppendI32Line(
                    lines,
                    strutil.Join([share(eventPrefix), "encoded_word"], ""),
                    encoderEvents.encodedWords[encoderEventRow])
        for fragmentIndex in 0..<fragmentCount:
            let fragmentPrefix = strutil.Join([
                share(functionPrefix), "fragment.",
                strings.IntToStr(fragmentIndex), "."
            ], "")
            var fragmentFields = regallocProductionFragmentFields(
                functions[functionIndex].plan,
                functions[functionIndex].recipes,
                fragmentIndex)
            regallocProductionAppendFields(
                lines, fragmentPrefix, fragmentFields)
            regallocProductionAppendLine(
                lines,
                strutil.Join([share(fragmentPrefix),
                              "fragment_sha256"], ""),
                regallocProductionFragmentSha256(fragmentFields))
        let ingressCount =
            functions[functionIndex].recipes.abiIngressRegs.len
        regallocProductionAppendI32Line(
            lines,
            strutil.Join([share(functionPrefix), "abi_ingress_count"], ""),
            ingressCount)
        regallocProductionAppendLine(
            lines,
            strutil.Join([share(functionPrefix),
                          "abi_ingress_root_sha256"], ""),
            functions[functionIndex].plan.abiIngressRootSha256)
        for ingressIndex in 0..<ingressCount:
            let ingressPrefix = strutil.Join([
                share(functionPrefix), "abi_ingress.",
                strings.IntToStr(ingressIndex), "."
            ], "")
            var ingressFields = regallocProductionIngressFields(
                functions[functionIndex].recipes, ingressIndex)
            regallocProductionAppendFields(
                lines, ingressPrefix, ingressFields)
            regallocProductionAppendLine(
                lines,
                strutil.Join([share(ingressPrefix), "entry_sha256"], ""),
                regallocProductionIngressSha256(ingressFields))
    return regallocProductionFinish(
        lines, "snapshot_payload_sha256", symbols, roots)

fn RegallocProductionFrozenPlanSnapshotMatches(
        metadata: RegallocProductionSnapshotMetadata,
        functions: var RegallocProductionSnapshotFunction[],
        payload: str): bool =
    let rebuilt = RegallocProductionFrozenPlanSnapshotSerialize(
        metadata, functions)
    return rebuilt.valid && rebuilt.payload == payload

@borrows
fn regallocProductionEmissionEqual(
        left: alloc.RegallocValueActionEmission,
        right: alloc.RegallocValueActionEmission): bool =
    return left.consumerOrdinal == right.consumerOrdinal &&
           left.actionKind == right.actionKind &&
           left.actionPosition == right.actionPosition &&
           left.symbolByteStart == right.symbolByteStart &&
           left.symbolByteLength == right.symbolByteLength &&
           left.emittedByteStart == right.emittedByteStart &&
           left.emittedByteLength == right.emittedByteLength &&
           left.emittedBytesSha256 == right.emittedBytesSha256 &&
           left.bindingKind == right.bindingKind &&
           left.ownerPlanSha256 == right.ownerPlanSha256 &&
           left.emissionOwnerSha256 == right.emissionOwnerSha256 &&
           left.actionSemanticSha256 == right.actionSemanticSha256 &&
           left.bindingSha256 == right.bindingSha256

@borrows
fn regallocProductionReceiptEqual(
        left: var alloc.RegallocValueEmissionReceipt,
        right: var alloc.RegallocValueEmissionReceipt): bool =
    if left.valid != right.valid ||
       left.symbolName != right.symbolName ||
       left.symbolByteStart != right.symbolByteStart ||
       left.symbolByteLength != right.symbolByteLength ||
       left.symbolBytesSha256 != right.symbolBytesSha256 ||
       left.actionCount != right.actionCount ||
       left.debugProvenanceSha256 != right.debugProvenanceSha256 ||
       left.frozenSemanticSha256 != right.frozenSemanticSha256 ||
       left.actionSemanticRootSha256 !=
           right.actionSemanticRootSha256 ||
       left.actionBindingRootSha256 != right.actionBindingRootSha256 ||
       left.machineFragmentCount != right.machineFragmentCount ||
       left.machineFragmentRootSha256 !=
           right.machineFragmentRootSha256 ||
       left.riscvEncoderEventCount != right.riscvEncoderEventCount ||
       left.riscvEncoderEventRootSha256 !=
           right.riscvEncoderEventRootSha256 ||
       left.abiIngressCount != right.abiIngressCount ||
       left.abiIngressRootSha256 != right.abiIngressRootSha256 ||
       left.receiptSha256 != right.receiptSha256 ||
       left.actionEmissions.len != right.actionEmissions.len:
        return false
    for index in 0..<left.actionEmissions.len:
        if !regallocProductionEmissionEqual(
               left.actionEmissions[index], right.actionEmissions[index]):
            return false
    return true

@borrows
fn regallocProductionFinalPlanValid(
        plan: var alloc.RegallocSinglePassValuePlan,
        recipes: var contract.RegallocA64FunctionRecipes,
        receipt: var alloc.RegallocValueEmissionReceipt): int32 =
    var rebuilt: alloc.RegallocValueEmissionReceipt
    if !plan.valid || !plan.frozen || !plan.finalized ||
       !plan.emissionSymbolBound || !plan.emissionSymbolSealed ||
       !plan.productionRecipeBound ||
       plan.nextIssueOrdinal != plan.actions.len ||
       plan.nextAckOrdinal != plan.actions.len ||
       plan.actionEmissions.len != plan.actions.len:
        return RegallocProductionArtifactStateInvalid
    if !regallocProductionActionSchemaValid():
        return RegallocProductionArtifactFieldDrift
    for actionIndex in 0..<plan.actions.len:
        if len(regallocProductionActionKind(
               plan.actions[actionIndex])) == 0:
            return RegallocProductionArtifactUnknownActionKind
    if !alloc.RegallocSinglePassValuePlanValidate(plan) ||
       !alloc.RegallocSinglePassValuePlanReceipt(plan, rebuilt):
        return RegallocProductionArtifactStateInvalid
    if !regallocProductionReceiptEqual(rebuilt, receipt):
        plan.errorDetail = 7101
        return RegallocProductionArtifactReceiptMismatch
    let proof = RegallocProductionMachineRecipeProofBuild(plan, recipes)
    if !proof.valid:
        if plan.errorDetail <= 0:
            plan.errorDetail = 7102
        return RegallocProductionArtifactReceiptMismatch
    if proof.fragmentRootSha256 != receipt.machineFragmentRootSha256:
        plan.errorDetail = 7103
        return RegallocProductionArtifactReceiptMismatch
    if proof.ingressRootSha256 != receipt.abiIngressRootSha256:
        plan.errorDetail = 7104
        return RegallocProductionArtifactReceiptMismatch
    if receipt.machineFragmentCount != recipes.machineFragments.len:
        plan.errorDetail = 7105
        return RegallocProductionArtifactReceiptMismatch
    if receipt.riscvEncoderEventCount != recipes.encoderEvents.kinds.len:
        plan.errorDetail = 7106
        return RegallocProductionArtifactReceiptMismatch
    if receipt.abiIngressCount != recipes.abiIngressRegs.len:
        plan.errorDetail = 7107
        return RegallocProductionArtifactReceiptMismatch
    if recipes.encoderEvents.kinds.len > 0:
        if receipt.riscvEncoderEventRootSha256 !=
               layout.FixedBytes32Hex(
                   recipes.encoderEvents.orderedRoot):
            plan.errorDetail = 7108
            return RegallocProductionArtifactReceiptMismatch
    elif len(receipt.riscvEncoderEventRootSha256) != 0:
        plan.errorDetail = 7109
        return RegallocProductionArtifactReceiptMismatch
    if !regallocProductionSymbolValid(receipt.symbolName) ||
       !regallocProductionShaValid(receipt.symbolBytesSha256) ||
       !regallocProductionShaValid(receipt.frozenSemanticSha256) ||
       !regallocProductionShaValid(
           receipt.actionSemanticRootSha256) ||
       receipt.actionCount != plan.actions.len:
        plan.errorDetail = 7110
        return RegallocProductionArtifactReceiptMismatch
    if !regallocProductionConstraintsValid(plan.constraints):
        return RegallocProductionArtifactStateInvalid
    let actionRoot = regallocProductionActionRootSha256(plan)
    let planSha = regallocProductionPlanSha256(plan, actionRoot)
    if actionRoot != receipt.actionSemanticRootSha256 ||
       actionRoot != plan.actionSemanticRootSha256 ||
       planSha != receipt.frozenSemanticSha256 ||
       planSha != plan.frozenSemanticSha256:
        return RegallocProductionArtifactSemanticDrift
    for actionIndex in 0..<plan.actions.len:
        if !plan.actions[actionIndex].acknowledged ||
           plan.actions[actionIndex].consumerOrdinal != actionIndex:
            return RegallocProductionArtifactStateInvalid
        let ledgerKind = regallocProductionActionKind(
            plan.actions[actionIndex])
        if len(ledgerKind) == 0:
            return RegallocProductionArtifactUnknownActionKind
        let bindingKind = alloc.RegallocSinglePassValueActionBindingKind(
            plan.actions[actionIndex].kind)
        if receipt.actionEmissions[actionIndex].consumerOrdinal !=
               actionIndex ||
           receipt.actionEmissions[actionIndex].actionKind !=
               plan.actions[actionIndex].kind ||
           receipt.actionEmissions[actionIndex].actionPosition !=
               plan.actions[actionIndex].position ||
           receipt.actionEmissions[actionIndex].bindingKind !=
               bindingKind ||
           receipt.actionEmissions[actionIndex].ownerPlanSha256 !=
               planSha ||
           receipt.actionEmissions[actionIndex].actionSemanticSha256 !=
               regallocProductionActionSemanticSha256(
                   plan.actions[actionIndex]):
            return RegallocProductionArtifactBindingMismatch
        if bindingKind == alloc.RegallocValueBindingStructural:
            if receipt.actionEmissions[actionIndex].emittedByteStart !=
                   0 ||
               receipt.actionEmissions[actionIndex].emittedByteLength !=
                   0 ||
               receipt.actionEmissions[actionIndex].emittedBytesSha256 !=
                   alloc.RegallocValueEmptySha256 ||
               plan.actions[actionIndex].fragmentOrdinal != -1 ||
               plan.actions[actionIndex].effectSpLoad ||
               plan.actions[actionIndex].effectSpStore ||
               plan.actions[actionIndex].effectCall ||
               plan.actions[actionIndex].effectX16 ||
               plan.actions[actionIndex].effectX17:
                return RegallocProductionArtifactBindingMismatch
        elif bindingKind == alloc.RegallocValueBindingMachine:
            let fragmentOrdinal =
                plan.actions[actionIndex].fragmentOrdinal
            let emittedStart =
                receipt.actionEmissions[actionIndex].emittedByteStart
            let emittedLength =
                receipt.actionEmissions[actionIndex].emittedByteLength
            if emittedLength <= 0 ||
               emittedStart < receipt.symbolByteStart ||
               emittedStart + emittedLength >
                   receipt.symbolByteStart + receipt.symbolByteLength ||
               emittedStart % 4 != 0 ||
               emittedLength % 4 != 0 ||
               !regallocProductionShaValid(
                   receipt.actionEmissions[actionIndex].emittedBytesSha256) ||
               fragmentOrdinal < 0 ||
               fragmentOrdinal >= recipes.machineFragments.len:
                return RegallocProductionArtifactBindingMismatch
            let fragWordStart =
                recipes.machineFragments[fragmentOrdinal].wordStart
            let fragWordCount =
                recipes.machineFragments[fragmentOrdinal].wordCount
            if recipes.machineFragments[fragmentOrdinal].actionConsumerOrdinal !=
                   actionIndex ||
               emittedStart != receipt.symbolByteStart + fragWordStart * 4 ||
               emittedLength != fragWordCount * 4 ||
               receipt.actionEmissions[actionIndex].emittedBytesSha256 !=
                   regallocProductionWordsSha256(
                       recipes.functionWords, fragWordStart, fragWordCount):
                return RegallocProductionArtifactBindingMismatch
        else:
            return RegallocProductionArtifactUnknownActionKind
    return RegallocProductionArtifactOk

@borrows
fn regallocProductionLedgerBindingSha256(
        kind: str,
        semanticSha256: str,
        ackKind: str,
        bindingKind: str,
        ownerPlanSha256: str,
        machineOffset: int32,
        machineSize: int32,
        machineSha256: str,
        fragmentOrdinal: int32,
        effectSpLoad: bool,
        effectSpStore: bool,
        effectCall: bool,
        effectX16: bool,
        effectX17: bool): str =
    var lines = rawbytes.BytesBuilderNew(512)
    regallocProductionAppendLine(lines, "kind", kind)
    regallocProductionAppendLine(
        lines, "semantic_sha256", semanticSha256)
    regallocProductionAppendLine(lines, "ack_kind", ackKind)
    regallocProductionAppendLine(lines, "binding_kind", bindingKind)
    regallocProductionAppendLine(
        lines, "owner_plan_sha256", ownerPlanSha256)
    regallocProductionAppendLine(
        lines, "machine_offset", strings.IntToStr(machineOffset))
    regallocProductionAppendLine(
        lines, "machine_size", strings.IntToStr(machineSize))
    regallocProductionAppendLine(
        lines, "machine_sha256", machineSha256)
    regallocProductionAppendLine(
        lines, "fragment_ordinal",
        strings.IntToStr(fragmentOrdinal))
    regallocProductionAppendLine(
        lines, "effect_sp_load",
        regallocProductionBoolText(effectSpLoad))
    regallocProductionAppendLine(
        lines, "effect_sp_store",
        regallocProductionBoolText(effectSpStore))
    regallocProductionAppendLine(
        lines, "effect_call",
        regallocProductionBoolText(effectCall))
    regallocProductionAppendLine(
        lines, "effect_x16",
        regallocProductionBoolText(effectX16))
    regallocProductionAppendLine(
        lines, "effect_x17",
        regallocProductionBoolText(effectX17))
    return regallocProductionBuilderSha256(lines)

fn RegallocProductionActionEmissionLedgerSerialize(
        metadata: RegallocProductionLedgerMetadata,
        functions: var RegallocProductionLedgerFunction[]): RegallocProductionArtifact =
    if !regallocProductionShaValid(metadata.fixtureSourceSha256) ||
       !regallocProductionShaValid(metadata.outputObjectSha256) ||
       !RegallocProductionTargetUsesCanonicalRegalloc(metadata.target) ||
       functions.len <= 0:
        return regallocProductionFailure(
            RegallocProductionArtifactMetadataInvalid)
    var symbols: str[]
    var seenSymbols = hashsets.HashSetStrInit(functions.len * 2)
    for functionIndex in 0..<functions.len:
        if !regallocProductionTargetPlanMatches(
               metadata.target, functions[functionIndex].plan) ||
           !regallocProductionTargetRecipeMatches(
               metadata.target, functions[functionIndex].recipes):
            return regallocProductionFailure(
                RegallocProductionArtifactBindingMismatch)
        let stateCode = regallocProductionFinalPlanValid(
            functions[functionIndex].plan,
            functions[functionIndex].recipes,
            functions[functionIndex].receipt)
        if stateCode != RegallocProductionArtifactOk:
            return regallocProductionFailure(stateCode)
        let symbol = functions[functionIndex].receipt.symbolName
        if hashsets.HashSetStrHas(seenSymbols, symbol):
            return regallocProductionFailure(
                RegallocProductionArtifactDuplicateSymbol)
        hashsets.HashSetStrAdd(seenSymbols, strings.CloneStr(symbol))
        add(symbols, strings.CloneStr(symbol))
    var lines = rawbytes.BytesBuilderNew(4096)
    regallocProductionAppendLine(
        lines, "schema", RegallocProductionEmissionLedgerSchema)
    regallocProductionAppendLine(
        lines, "fixture_source_sha256", metadata.fixtureSourceSha256)
    regallocProductionAppendLine(
        lines, "output_object_sha256", metadata.outputObjectSha256)
    regallocProductionAppendLine(lines, "target", metadata.target)
    regallocProductionAppendLine(
        lines, "function_count", strings.IntToStr(functions.len))
    var roots: str[]
    for functionIndex in 0..<functions.len:
        let symbol = functions[functionIndex].receipt.symbolName
        let functionPrefix = strutil.Join([
            "function.", strings.IntToStr(functionIndex), "."
        ], "")
        regallocProductionAppendLine(
            lines, strutil.Join([share(functionPrefix), "symbol"], ""), symbol)
        let actionCount = functions[functionIndex].plan.actions.len
        regallocProductionAppendI32Line(
            lines, strutil.Join([share(functionPrefix), "action_count"], ""),
            actionCount)
        var bindingLines = rawbytes.BytesBuilderNew(256)
        let fragmentCount =
            functions[functionIndex].recipes.machineFragments.len
        let ingressCount =
            functions[functionIndex].recipes.abiIngressRegs.len
        regallocProductionAppendI32Line(
            lines, strutil.Join([share(functionPrefix), "fragment_count"], ""),
            fragmentCount)
        regallocProductionAppendI32Line(
            lines,
            strutil.Join([share(functionPrefix), "abi_ingress_count"], ""),
            ingressCount)
        let encoderEventCount =
            functions[functionIndex].receipt.riscvEncoderEventCount
        regallocProductionAppendI32Line(
            lines,
            strutil.Join([share(functionPrefix),
                          "riscv_encoder_event_count"], ""),
            encoderEventCount)
        regallocProductionAppendLine(
            lines,
            strutil.Join([share(functionPrefix),
                          "riscv_encoder_event_root_sha256"], ""),
            functions[functionIndex].receipt.riscvEncoderEventRootSha256)
        if encoderEventCount > 0:
            let encoderEvents =
                functions[functionIndex].recipes.encoderEvents
            regallocProductionAppendI32Line(
                lines,
                strutil.Join([share(functionPrefix),
                              "riscv_encoder_source_row"], ""),
                encoderEvents.encoderSourceRow)
            regallocProductionAppendLine(
                lines,
                strutil.Join([share(functionPrefix),
                              "riscv_encoder_source_cid"], ""),
                layout.FixedBytes32Hex(encoderEvents.encoderSourceCid))
            regallocProductionAppendI32Line(
                lines,
                strutil.Join([share(functionPrefix),
                              "riscv_encoder_xlen"], ""),
                encoderEvents.encoderXlen)
            regallocProductionAppendI32Line(
                lines,
                strutil.Join([share(functionPrefix),
                              "riscv_encoder_reserved_row_count"], ""),
                encoderEvents.reservedRowCount)
            regallocProductionAppendI64Line(
                lines,
                strutil.Join([share(functionPrefix),
                              "riscv_encoder_retained_bytes"], ""),
                encoderEvents.retainedBytes)
        for actionIndex in 0..<actionCount:
            var action = functions[functionIndex].plan.actions[actionIndex]
            let emission =
                functions[functionIndex].receipt.actionEmissions[actionIndex]
            let actionPrefix = strutil.Join([
                share(functionPrefix), "action.",
                strings.IntToStr(actionIndex), "."
            ], "")
            let kind = regallocProductionActionKind(action)
            regallocProductionAppendLine(
                lines, strutil.Join([share(actionPrefix), "kind"], ""), kind)
            let semanticSha256 =
                regallocProductionActionSemanticSha256WithPayload(
                    lines, actionPrefix, action, true)
            if !regallocProductionShaValid(semanticSha256):
                rawbytes.BytesBuilderFree(lines)
                rawbytes.BytesBuilderFree(bindingLines)
                return regallocProductionFailure(
                    RegallocProductionArtifactSemanticDrift)
            regallocProductionAppendI32Line(
                lines,
                strutil.Join([share(actionPrefix), "fragment_ordinal"], ""),
                action.fragmentOrdinal)
            regallocProductionAppendBoolLine(
                lines,
                strutil.Join([share(actionPrefix), "effect_sp_load"], ""),
                action.effectSpLoad)
            regallocProductionAppendBoolLine(
                lines,
                strutil.Join([share(actionPrefix), "effect_sp_store"], ""),
                action.effectSpStore)
            regallocProductionAppendBoolLine(
                lines,
                strutil.Join([share(actionPrefix), "effect_call"], ""),
                action.effectCall)
            regallocProductionAppendBoolLine(
                lines,
                strutil.Join([share(actionPrefix), "effect_x16"], ""),
                action.effectX16)
            regallocProductionAppendBoolLine(
                lines,
                strutil.Join([share(actionPrefix), "effect_x17"], ""),
                action.effectX17)
            regallocProductionAppendLine(
                lines,
                strutil.Join([share(actionPrefix), "semantic_sha256"], ""),
                semanticSha256)
            let numericBindingKind =
                alloc.RegallocSinglePassValueActionBindingKind(action.kind)
            var ackKind: str
            var bindingKind: str
            var machineOffset: int32
            if numericBindingKind == alloc.RegallocValueBindingMachine:
                ackKind = "machine_emitted"
                bindingKind = "machine"
                machineOffset = emission.emittedByteStart -
                                functions[functionIndex].receipt.symbolByteStart
            else:
                ackKind = "structural_validated"
                bindingKind = "structural"
            let machineSize = emission.emittedByteLength
            let machineSha256 = emission.emittedBytesSha256
            let ownerPlanSha256 =
                functions[functionIndex].plan.frozenSemanticSha256
            let bindingSha256 = regallocProductionLedgerBindingSha256(
                kind, semanticSha256, ackKind, bindingKind,
                ownerPlanSha256, machineOffset, machineSize,
                machineSha256, action.fragmentOrdinal,
                action.effectSpLoad, action.effectSpStore,
                action.effectCall, action.effectX16,
                action.effectX17)
            regallocProductionAppendLine(
                lines, strutil.Join([share(actionPrefix), "ack_kind"], ""),
                ackKind)
            regallocProductionAppendLine(
                lines, strutil.Join([share(actionPrefix), "binding_kind"], ""),
                bindingKind)
            regallocProductionAppendLine(
                lines,
                strutil.Join([share(actionPrefix), "owner_plan_sha256"], ""),
                ownerPlanSha256)
            regallocProductionAppendI32Line(
                lines, strutil.Join([share(actionPrefix), "machine_offset"], ""),
                machineOffset)
            regallocProductionAppendI32Line(
                lines, strutil.Join([share(actionPrefix), "machine_size"], ""),
                machineSize)
            regallocProductionAppendLine(
                lines, strutil.Join([share(actionPrefix), "machine_sha256"], ""),
                machineSha256)
            regallocProductionAppendLine(
                lines, strutil.Join([share(actionPrefix), "binding_sha256"], ""),
                bindingSha256)
            regallocProductionBuilderAppendText(bindingLines, "action.")
            regallocProductionBuilderAppendI32(bindingLines, actionIndex)
            regallocProductionBuilderAppendText(
                bindingLines, ".binding_sha256=")
            regallocProductionBuilderAppendText(
                bindingLines, bindingSha256)
            rawbytes.BytesBuilderAppendByte(bindingLines, Int32('\n'))
        for fragmentIndex in 0..<fragmentCount:
            let fragmentPrefix = strutil.Join([
                share(functionPrefix), "fragment.",
                strings.IntToStr(fragmentIndex), "."
            ], "")
            var fragmentFields = regallocProductionFragmentFields(
                functions[functionIndex].plan,
                functions[functionIndex].recipes,
                fragmentIndex)
            regallocProductionAppendFields(
                lines, fragmentPrefix, fragmentFields)
            regallocProductionAppendLine(
                lines,
                strutil.Join([share(fragmentPrefix),
                              "fragment_sha256"], ""),
                regallocProductionFragmentSha256(fragmentFields))
        for ingressIndex in 0..<ingressCount:
            let ingressPrefix = strutil.Join([
                share(functionPrefix), "abi_ingress.",
                strings.IntToStr(ingressIndex), "."
            ], "")
            var ingressFields = regallocProductionIngressFields(
                functions[functionIndex].recipes, ingressIndex)
            regallocProductionAppendFields(
                lines, ingressPrefix, ingressFields)
            regallocProductionAppendLine(
                lines,
                strutil.Join([share(ingressPrefix), "entry_sha256"], ""),
                regallocProductionIngressSha256(ingressFields))
        var bindingBytes = rawbytes.BytesBuilderFinish(bindingLines)
        let rootSha256 = regallocProductionSha256Bytes(bindingBytes)
        rawbytes.BytesFree(bindingBytes)
        regallocProductionAppendLine(
            lines, strutil.Join([share(functionPrefix), "root_sha256"], ""),
            rootSha256)
        regallocProductionAppendLine(
            lines,
            strutil.Join([share(functionPrefix),
                          "fragment_root_sha256"], ""),
            functions[functionIndex].receipt.machineFragmentRootSha256)
        regallocProductionAppendLine(
            lines,
            strutil.Join([share(functionPrefix),
                          "abi_ingress_root_sha256"], ""),
            functions[functionIndex].receipt.abiIngressRootSha256)
        add(roots, rootSha256)
    return regallocProductionFinish(
        lines, "ledger_payload_sha256", symbols, roots)

fn RegallocProductionActionEmissionLedgerMatches(
        metadata: RegallocProductionLedgerMetadata,
        functions: var RegallocProductionLedgerFunction[],
        payload: str): bool =
    let rebuilt = RegallocProductionActionEmissionLedgerSerialize(
        metadata, functions)
    return rebuilt.valid && rebuilt.payload == payload

@borrows
fn regallocProductionRangeStartsWith(
        text: str,
        start: int32,
        count: int32,
        prefix: str): bool =
    if start < 0 || count < len(prefix) || start > len(text) - count:
        return false
    for index in 0..<len(prefix):
        if text[start + index] != prefix[index]:
            return false
    return true

@borrows
fn regallocProductionRangeEquals(
        text: str,
        start: int32,
        count: int32,
        expected: str): bool =
    return count == len(expected) &&
           regallocProductionRangeStartsWith(
               text, start, count, expected)

@borrows
fn regallocProductionLineHasKey(
        text: str,
        start: int32,
        count: int32,
        key: str): bool =
    return count >= len(key) + 1 &&
           regallocProductionRangeStartsWith(text, start, count, key) &&
           text[start + len(key)] == '='

@borrows
fn regallocProductionLineKeyValueEquals(
        text: str,
        start: int32,
        count: int32,
        key: str,
        value: str): bool =
    return count == len(key) + len(value) + 1 &&
           regallocProductionLineHasKey(text, start, count, key) &&
           regallocProductionRangeEquals(
               text, start + len(key) + 1, len(value), value)

@borrows
fn regallocProductionSingleFunctionRows(
        payload: str,
        schema: str,
        hashKey: str,
        expectedTarget: str,
        functionIndex: int32,
        rows: var rawbytes.BytesBuilder,
        symbol: var str,
        functionIrIndexText: var str,
        functionKindText: var str): bool =
    symbol = ""
    functionIrIndexText = ""
    functionKindText = ""
    let payloadLen = len(payload)
    if payloadLen <= 0:
        return false
    var sawFunctionCount: bool
    var sawHash: bool
    var sawSymbol: bool
    var sawFunctionIrIndex: bool
    var sawFunctionKind: bool
    var sawTarget: bool
    var observed: str
    var rowCount: int32
    var hashLineIndex: int32 = -1
    var hashLineStart: int32 = -1
    var lineIndex: int32
    var lineStart: int32
    var done: bool
    var valid: bool = true
    while !done:
        var lineEnd: int32 = payloadLen
        for scanIndex in lineStart..<payloadLen:
            if payload[scanIndex] == '\n':
                lineEnd = scanIndex
                break
        let lineLen = lineEnd - lineStart
        let hasNewline = lineEnd < payloadLen
        if lineIndex == 0 &&
           !regallocProductionLineKeyValueEquals(
               payload, lineStart, lineLen, "schema", schema):
            valid = false
        if valid && lineLen > 0:
            if regallocProductionLineHasKey(
                   payload, lineStart, lineLen, hashKey):
                if sawHash:
                    valid = false
                else:
                    observed = strings.SliceBytes(
                        payload,
                        lineStart + len(hashKey) + 1,
                        lineLen - len(hashKey) - 1)
                    if !regallocProductionShaValid(observed):
                        valid = false
                    else:
                        sawHash = true
                        hashLineIndex = lineIndex
                        hashLineStart = lineStart
            elif sawHash:
                valid = false
            else:
                if regallocProductionLineHasKey(
                       payload, lineStart, lineLen, "target"):
                    if sawTarget ||
                       !regallocProductionLineKeyValueEquals(
                           payload, lineStart, lineLen,
                           "target", expectedTarget):
                        valid = false
                    else:
                        sawTarget = true
                if regallocProductionLineKeyValueEquals(
                       payload, lineStart, lineLen,
                       "function_count", "1"):
                    sawFunctionCount = true
                if regallocProductionRangeStartsWith(
                       payload, lineStart, lineLen, "function.0."):
                    let rowStart = lineStart + 11
                    let rowLen = lineLen - 11
                    if regallocProductionRangeStartsWith(
                           payload, rowStart, rowLen, "symbol="):
                        if sawSymbol:
                            valid = false
                        sawSymbol = true
                        symbol = strings.SliceBytes(
                            payload, rowStart + 7, rowLen - 7)
                    elif regallocProductionRangeStartsWith(
                           payload, rowStart, rowLen,
                           "function_ir_index="):
                        if sawFunctionIrIndex:
                            valid = false
                        sawFunctionIrIndex = true
                        functionIrIndexText = strings.SliceBytes(
                            payload, rowStart + 18, rowLen - 18)
                    elif regallocProductionRangeStartsWith(
                           payload, rowStart, rowLen, "function_kind="):
                        if sawFunctionKind:
                            valid = false
                        sawFunctionKind = true
                        functionKindText = strings.SliceBytes(
                            payload, rowStart + 14, rowLen - 14)
                    regallocProductionBuilderAppendText(rows, "function.")
                    regallocProductionBuilderAppendText(
                        rows, strings.IntToStr(functionIndex))
                    rawbytes.BytesBuilderAppendByte(rows, Int32('.'))
                    regallocProductionBuilderAppendSlice(
                        rows, payload, rowStart, rowLen)
                    rawbytes.BytesBuilderAppendByte(rows, Int32('\n'))
                    rowCount = rowCount + 1
                elif regallocProductionRangeStartsWith(
                       payload, lineStart, lineLen, "function."):
                    valid = false
        elif valid && (!sawHash || hasNewline):
            valid = false
        lineIndex = lineIndex + 1
        if !hasNewline:
            done = true
        else:
            lineStart = lineEnd + 1
    if !valid || lineIndex < 4 || !sawFunctionCount || !sawTarget ||
       !sawHash ||
       hashLineIndex + 2 < lineIndex || rowCount <= 0:
        return false
    let payloadBytes = rawbytes.BytesFromString(payload)
    let bodyBytes = rawbytes.BytesSliceView(
        payloadBytes, 0, hashLineStart)
    let expected = regallocProductionSha256Bytes(bodyBytes)
    return expected == observed

fn RegallocProductionFrozenPlanSnapshotMerge(
        metadata: RegallocProductionSnapshotMetadata,
        singleFunctionPayloads: var str[]): RegallocProductionArtifact =
    if !regallocProductionShaValid(metadata.fixtureSourceSha256) ||
       !regallocProductionShaValid(metadata.sourceManifestSha256) ||
       !regallocProductionShaValid(metadata.driverSha256) ||
       !RegallocProductionTargetUsesCanonicalRegalloc(metadata.target) ||
       singleFunctionPayloads.len <= 0:
        return regallocProductionFailure(
            RegallocProductionArtifactMetadataInvalid)
    var lines = rawbytes.BytesBuilderNew(4096)
    regallocProductionAppendLine(
        lines, "schema", RegallocProductionFrozenSnapshotSchema)
    regallocProductionAppendLine(
        lines, "phase", RegallocProductionFrozenSnapshotPhase)
    regallocProductionAppendLine(
        lines, "fixture_source_sha256", metadata.fixtureSourceSha256)
    regallocProductionAppendLine(
        lines, "source_manifest_sha256", metadata.sourceManifestSha256)
    regallocProductionAppendLine(
        lines, "driver_sha256", metadata.driverSha256)
    regallocProductionAppendLine(lines, "target", metadata.target)
    regallocProductionAppendLine(
        lines, "function_count",
        strings.IntToStr(singleFunctionPayloads.len))
    var symbols: str[]
    var roots: str[]
    var consumptionIndex =
        RegallocProductionFunctionIndexInit(
            singleFunctionPayloads.len)
    for functionIndex in 0..<singleFunctionPayloads.len:
        var symbol: str
        var functionIrIndexText: str
        var functionKindText: str
        if !regallocProductionSingleFunctionRows(
               singleFunctionPayloads[functionIndex],
               RegallocProductionFrozenSnapshotSchema,
               "snapshot_payload_sha256", metadata.target,
               functionIndex,
               lines, symbol, functionIrIndexText, functionKindText):
            rawbytes.BytesBuilderFree(lines)
            return regallocProductionFailure(
                RegallocProductionArtifactStateInvalid)
        let normalIdentity =
            functionKindText ==
                strings.IntToStr(RegallocProductionFunctionKindNormal) &&
            len(functionIrIndexText) > 0 &&
            functionIrIndexText[0] != '-' &&
            strings.IntToStr(strutil.ParseInt(functionIrIndexText)) ==
                functionIrIndexText
        let entryIdentity =
            functionKindText ==
                strings.IntToStr(
                    RegallocProductionFunctionKindEntryBridge) &&
            functionIrIndexText == "-1"
        if !normalIdentity && !entryIdentity:
            rawbytes.BytesBuilderFree(lines)
            return regallocProductionFailure(
                RegallocProductionArtifactBindingMismatch)
        if !regallocProductionSymbolValid(symbol):
            rawbytes.BytesBuilderFree(lines)
            return regallocProductionFailure(
                RegallocProductionArtifactMetadataInvalid)
        var functionIrIndex: int32 = -1
        var functionKind: int32 =
            RegallocProductionFunctionKindEntryBridge
        if normalIdentity:
            functionIrIndex = strutil.ParseInt(functionIrIndexText)
            functionKind = RegallocProductionFunctionKindNormal
        let appendCode = RegallocProductionFunctionIndexAppend(
            consumptionIndex, functionIrIndex, functionKind, symbol)
        if appendCode ==
               RegallocProductionFunctionIndexAppendDuplicateSymbol:
            rawbytes.BytesBuilderFree(lines)
            return regallocProductionFailure(
                RegallocProductionArtifactDuplicateSymbol)
        if appendCode != RegallocProductionFunctionIndexAppendOk:
            rawbytes.BytesBuilderFree(lines)
            return regallocProductionFailure(
                RegallocProductionArtifactBindingMismatch)
        add(symbols, symbol)
    return regallocProductionFinish(
        lines, "snapshot_payload_sha256", symbols, roots)

fn RegallocProductionActionEmissionLedgerMerge(
        metadata: RegallocProductionLedgerMetadata,
        singleFunctionPayloads: var str[]): RegallocProductionArtifact =
    if !regallocProductionShaValid(metadata.fixtureSourceSha256) ||
       !regallocProductionShaValid(metadata.outputObjectSha256) ||
       !RegallocProductionTargetUsesCanonicalRegalloc(metadata.target) ||
       singleFunctionPayloads.len <= 0:
        return regallocProductionFailure(
            RegallocProductionArtifactMetadataInvalid)
    var lines = rawbytes.BytesBuilderNew(4096)
    regallocProductionAppendLine(
        lines, "schema", RegallocProductionEmissionLedgerSchema)
    regallocProductionAppendLine(
        lines, "fixture_source_sha256", metadata.fixtureSourceSha256)
    regallocProductionAppendLine(
        lines, "output_object_sha256", metadata.outputObjectSha256)
    regallocProductionAppendLine(lines, "target", metadata.target)
    regallocProductionAppendLine(
        lines, "function_count",
        strings.IntToStr(singleFunctionPayloads.len))
    var symbols: str[]
    var roots: str[]
    var seenSymbols = hashsets.HashSetStrInit(
        singleFunctionPayloads.len * 2)
    for functionIndex in 0..<singleFunctionPayloads.len:
        var symbol: str
        var functionIrIndexText: str
        var functionKindText: str
        if !regallocProductionSingleFunctionRows(
               singleFunctionPayloads[functionIndex],
               RegallocProductionEmissionLedgerSchema,
               "ledger_payload_sha256", metadata.target,
               functionIndex,
               lines, symbol, functionIrIndexText, functionKindText):
            rawbytes.BytesBuilderFree(lines)
            return regallocProductionFailure(
                RegallocProductionArtifactStateInvalid)
        if !regallocProductionSymbolValid(symbol) ||
           hashsets.HashSetStrHas(seenSymbols, symbol):
            rawbytes.BytesBuilderFree(lines)
            return regallocProductionFailure(
                RegallocProductionArtifactDuplicateSymbol)
        hashsets.HashSetStrAdd(seenSymbols, strings.CloneStr(symbol))
        add(symbols, symbol)
    return regallocProductionFinish(
        lines, "ledger_payload_sha256", symbols, roots)
