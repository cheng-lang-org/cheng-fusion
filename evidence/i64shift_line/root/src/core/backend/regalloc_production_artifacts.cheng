import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/codegen_encoder_event_units as encev
import cheng/core/ir/core_types as coreir
import cheng/std/bytes_layout as layout
import std/crypto/sha256
import std/hashsets
import std/rawbytes
import std/strings
import std/strutils as strutil

const
    RegallocProductionArtifactOk = 0
    RegallocProductionArtifactMetadataInvalid = 1
    RegallocProductionArtifactStateInvalid = 2
    RegallocProductionArtifactDuplicateSymbol = 3
    RegallocProductionArtifactFieldDrift = 4
    RegallocProductionArtifactSemanticDrift = 5
    RegallocProductionArtifactUnknownActionKind = 6
    RegallocProductionArtifactReceiptMismatch = 7
    RegallocProductionArtifactBindingMismatch = 8

    RegallocProductionFunctionKindNormal = 1
    RegallocProductionFunctionKindEntryBridge = 2
    RegallocProductionFunctionIndexAppendOk = 0
    RegallocProductionFunctionIndexAppendInvalid = 1
    RegallocProductionFunctionIndexAppendDuplicateSymbol = 2
    RegallocProductionFunctionIndexAppendDuplicateIdentity = 3

    RegallocProductionActionFieldCount = 40
    RegallocProductionConstraintFieldCount = 15
    RegallocProductionPlanFieldCount = 58

    RegallocProductionFieldKindI32 = 1
    RegallocProductionFieldKindI64 = 2
    RegallocProductionFieldKindI32Array = 3
    RegallocProductionFieldKindBoolArray = 4
    RegallocProductionFieldKindText = 5

    RegallocProductionTargetA64Darwin = "arm64-apple-darwin"
    RegallocProductionTargetA64Linux = "aarch64-unknown-linux-gnu"
    RegallocProductionTargetX64Linux = "x86_64-unknown-linux-gnu"
    RegallocProductionTargetRv64Linux = "riscv64-unknown-linux-gnu"
    RegallocProductionTargetRv64Bare = "riscv64-unknown-none-elf"
    RegallocProductionTargetRv32Linux = "riscv32-unknown-linux-gnu"
    RegallocProductionTargetRv32Bare = "riscv32-unknown-none-elf"
    RegallocProductionTargetEsp32S31 = "riscv32-esp32s31-none-elf"
    RegallocProductionTargetEsp32S31Alias = "esp32s31"
    RegallocProductionFrozenSnapshotSchema = "regalloc_frozen_plan_snapshot"
    RegallocProductionFrozenSnapshotPhase = "allocator_and_machine_recipe_freeze_before_fill"
    RegallocProductionEmissionLedgerSchema = "regalloc_action_emission_ledger"

    RegallocProductionRecipeOriginBodyIrAdapter = "body_ir_adapter"

@borrows
fn RegallocProductionTargetIsA64(target: str): bool =
    return target == RegallocProductionTargetA64Darwin ||
           target == RegallocProductionTargetA64Linux

@borrows
fn RegallocProductionTargetIsRv32(target: str): bool =
    return target == RegallocProductionTargetRv32Linux ||
           target == RegallocProductionTargetRv32Bare ||
           target == RegallocProductionTargetEsp32S31 ||
           target == RegallocProductionTargetEsp32S31Alias

@borrows
fn RegallocProductionTargetIsRiscv(target: str): bool =
    return target == RegallocProductionTargetRv64Linux ||
           target == RegallocProductionTargetRv64Bare ||
           RegallocProductionTargetIsRv32(target)

@borrows
fn RegallocProductionTargetUsesCanonicalRegalloc(target: str): bool =
    return RegallocProductionTargetIsA64(target) ||
           target == RegallocProductionTargetX64Linux ||
           RegallocProductionTargetIsRiscv(target)

@borrows
fn regallocProductionTargetPlanMatches(
        target: str,
        plan: var alloc.RegallocSinglePassValuePlan): bool =
    if target == RegallocProductionTargetA64Darwin:
        return plan.constraints.packedStackArgs
    if target == RegallocProductionTargetA64Linux:
        return !plan.constraints.packedStackArgs
    if target == RegallocProductionTargetX64Linux:
        return !plan.constraints.packedStackArgs &&
               plan.constraints.fixedSretReg == 7 &&
               plan.constraints.parallelCopyScratchReg == 11
    return RegallocProductionTargetIsRiscv(target) &&
           !plan.constraints.packedStackArgs &&
           plan.constraints.fixedSretReg == 10 &&
           plan.constraints.parallelCopyScratchReg == 5

@borrows
fn regallocProductionTargetRecipeMatches(
        target: str,
        recipes: var contract.RegallocA64FunctionRecipes): bool =
    if RegallocProductionTargetIsRv32(target):
        return recipes.machineXlen == 32 &&
               encev.CodegenEncoderEventTableStrictValidate(
                   recipes.encoderEvents)
    if RegallocProductionTargetIsRiscv(target):
        return recipes.machineXlen == 64 &&
               encev.CodegenEncoderEventTableStrictValidate(
                   recipes.encoderEvents)
    return (recipes.machineXlen == 0 || recipes.machineXlen == 64) &&
           encev.CodegenEncoderEventTableCanonicalEmpty(
               recipes.encoderEvents)

type
    RegallocProductionArtifact =
        valid: bool
        errorCode: int32
        payload: str
        payloadSha256: str
        functionSymbols: str[]
        functionRootSha256s: str[]

    RegallocProductionSnapshotMetadata =
        fixtureSourceSha256: str
        sourceManifestSha256: str
        driverSha256: str
        target: str

    RegallocProductionSnapshotFunction =
        symbol: str
        functionIrIndex: int32
        functionKind: int32
        bodyIrSha256: str
        recipeOrigin: str
        plan: alloc.RegallocSinglePassValuePlan
        recipes: contract.RegallocA64FunctionRecipes

    RegallocProductionFunctionIndex =
        normalFunctionIrIndexes: int32[]
        normalFunctionIrIndexOccupied: bool[]
        normalFunctionCount: int32
        entryBridgeSeen: bool
        symbols: hashsets.HashSetStr

    RegallocProductionLedgerMetadata =
        fixtureSourceSha256: str
        outputObjectSha256: str
        target: str

    RegallocProductionLedgerFunction =
        plan: alloc.RegallocSinglePassValuePlan
        recipes: contract.RegallocA64FunctionRecipes
        receipt: alloc.RegallocValueEmissionReceipt

    RegallocProductionMachineRecipeProof =
        valid: bool
        errorCode: int32
        fragmentRootSha256: str
        ingressRootSha256: str
        fragmentSha256s: str[]
        ingressSha256s: str[]

    regallocProductionField =
        name: str
        kind: int32
        i32Value: int32
        i64Value: int64
        i32Values: int32[]
        boolValues: bool[]
        textValue: str

fn regallocProductionFailure(code: int32): RegallocProductionArtifact =
    var out: RegallocProductionArtifact
    out.errorCode = code
    return out

fn RegallocProductionFunctionIdentityValid(
        functionIrIndex: int32,
        functionKind: int32): bool =
    return (functionKind == RegallocProductionFunctionKindNormal &&
            functionIrIndex >= 0) ||
           (functionKind == RegallocProductionFunctionKindEntryBridge &&
            functionIrIndex == -1)

fn RegallocProductionFunctionIndexInit(
        expectedFunctionCount: int32): RegallocProductionFunctionIndex =
    if expectedFunctionCount < 0 || expectedFunctionCount > 268435455:
        panic("regalloc production function index capacity invalid")
    var capacity: int32 = 8
    let required = Int64(expectedFunctionCount) * 2 + 1
    while Int64(capacity) < required:
        capacity = capacity * 2
    var out: RegallocProductionFunctionIndex
    setLen(out.normalFunctionIrIndexes, capacity)
    setLen(out.normalFunctionIrIndexOccupied, capacity)
    out.symbols = hashsets.HashSetStrInit(capacity)
    return out

fn regallocProductionFunctionIndexStart(
        index: var RegallocProductionFunctionIndex,
        functionIrIndex: int32): int32 =
    let capacity = index.normalFunctionIrIndexes.len
    if capacity <= 0 ||
       index.normalFunctionIrIndexOccupied.len != capacity ||
       functionIrIndex < 0:
        return -1
    let mixed =
        (Int64(functionIrIndex) * Int64(1103515245) + Int64(12345)) %
        Int64(capacity)
    return int32(mixed)

@borrows
fn RegallocProductionFunctionIndexCheck(
        index: var RegallocProductionFunctionIndex,
        functionIrIndex: int32,
        functionKind: int32,
        symbol: str): int32 =
    if !RegallocProductionFunctionIdentityValid(
           functionIrIndex, functionKind) ||
       len(symbol) <= 0 ||
       index.normalFunctionIrIndexes.len <= 0 ||
       index.normalFunctionIrIndexOccupied.len !=
           index.normalFunctionIrIndexes.len:
        return RegallocProductionFunctionIndexAppendInvalid
    if hashsets.HashSetStrHas(index.symbols, symbol):
        return RegallocProductionFunctionIndexAppendDuplicateSymbol
    if functionKind == RegallocProductionFunctionKindEntryBridge:
        if index.entryBridgeSeen:
            return RegallocProductionFunctionIndexAppendDuplicateIdentity
        return RegallocProductionFunctionIndexAppendOk
    var slot = regallocProductionFunctionIndexStart(
        index, functionIrIndex)
    for probe in 0..<index.normalFunctionIrIndexes.len:
        if !index.normalFunctionIrIndexOccupied[slot]:
            return RegallocProductionFunctionIndexAppendOk
        if index.normalFunctionIrIndexes[slot] == functionIrIndex:
            return RegallocProductionFunctionIndexAppendDuplicateIdentity
        slot = slot + 1
        if slot >= index.normalFunctionIrIndexes.len:
            slot = 0
    return RegallocProductionFunctionIndexAppendInvalid

@borrows
fn RegallocProductionFunctionIndexAppend(
        index: var RegallocProductionFunctionIndex,
        functionIrIndex: int32,
        functionKind: int32,
        symbol: str): int32 =
    let check = RegallocProductionFunctionIndexCheck(
        index, functionIrIndex, functionKind, symbol)
    if check != RegallocProductionFunctionIndexAppendOk:
        return check
    hashsets.HashSetStrAdd(index.symbols, share(symbol))
    if functionKind == RegallocProductionFunctionKindEntryBridge:
        index.entryBridgeSeen = true
        return RegallocProductionFunctionIndexAppendOk
    var slot = regallocProductionFunctionIndexStart(
        index, functionIrIndex)
    for probe in 0..<index.normalFunctionIrIndexes.len:
        if !index.normalFunctionIrIndexOccupied[slot]:
            index.normalFunctionIrIndexOccupied[slot] = true
            index.normalFunctionIrIndexes[slot] = functionIrIndex
            index.normalFunctionCount = index.normalFunctionCount + 1
            return RegallocProductionFunctionIndexAppendOk
        slot = slot + 1
        if slot >= index.normalFunctionIrIndexes.len:
            slot = 0
    return RegallocProductionFunctionIndexAppendInvalid

fn regallocProductionBoolText(value: bool): str =
    if value:
        return "1"
    return "0"

@borrows
fn regallocProductionCloneI32Array(values: int32[]): int32[] =
    var out: int32[]
    for index in 0..<values.len:
        add(out, values[index])
    return out

@borrows
fn regallocProductionCloneBoolArray(values: bool[]): bool[] =
    var out: bool[]
    for index in 0..<values.len:
        add(out, values[index])
    return out

@borrows
fn regallocProductionFieldI32(name: str,
                              value: int32): regallocProductionField =
    var out: regallocProductionField
    out.name = strings.CloneStr(name)
    out.kind = RegallocProductionFieldKindI32
    out.i32Value = value
    return out

@borrows
fn regallocProductionFieldI64(name: str,
                              value: int64): regallocProductionField =
    var out: regallocProductionField
    out.name = strings.CloneStr(name)
    out.kind = RegallocProductionFieldKindI64
    out.i64Value = value
    return out

@borrows
fn regallocProductionFieldBool(name: str,
                               value: bool): regallocProductionField =
    var intValue: int32
    if value:
        intValue = 1
    return regallocProductionFieldI32(name, intValue)

@borrows
fn regallocProductionFieldI32Array(
        name: str,
        values: int32[]): regallocProductionField =
    var out: regallocProductionField
    out.name = strings.CloneStr(name)
    out.kind = RegallocProductionFieldKindI32Array
    out.i32Values = regallocProductionCloneI32Array(values)
    return out

@borrows
fn regallocProductionFieldBoolArray(
        name: str,
        values: bool[]): regallocProductionField =
    var out: regallocProductionField
    out.name = strings.CloneStr(name)
    out.kind = RegallocProductionFieldKindBoolArray
    out.boolValues = regallocProductionCloneBoolArray(values)
    return out

@borrows
fn regallocProductionFieldText(name: str,
                                value: str): regallocProductionField =
    var out: regallocProductionField
    out.name = strings.CloneStr(name)
    out.kind = RegallocProductionFieldKindText
    out.textValue = strings.CloneStr(value)
    return out

fn regallocProductionActionFieldName(index: int32): str =
    if index == 0: return "consumer_ordinal"
    if index == 1: return "action_kind"
    if index == 2: return "placement"
    if index == 3: return "position"
    if index == 4: return "block_index"
    if index == 5: return "op_index"
    if index == 6: return "term_index"
    if index == 7: return "fact_index"
    if index == 8: return "value_id"
    if index == 9: return "other_value_id"
    if index == 10: return "source_location"
    if index == 11: return "target_location"
    if index == 12: return "source_reg"
    if index == 13: return "target_reg"
    if index == 14: return "source_stack_slot"
    if index == 15: return "target_stack_slot"
    if index == 16: return "scratch_reg"
    if index == 17: return "target_memory_home"
    if index == 18: return "source_block"
    if index == 19: return "target_block"
    if index == 20: return "edge_index"
    if index == 21: return "requires_edge_split"
    if index == 22: return "parallel_group"
    if index == 23: return "parallel_ordinal"
    if index == 24: return "related_action_ordinal"
    if index == 25: return "fixed_kind"
    if index == 26: return "fixed_ordinal"
    if index == 27: return "pass_kind"
    if index == 28: return "encoded_value"
    if index == 29: return "call_ordinal"
    if index == 30: return "abi_size_bytes"
    if index == 31: return "abi_size_explicit"
    if index == 32: return "outgoing_stack_arg_index"
    if index == 33: return "outgoing_stack_byte_offset"
    if index == 34: return "outgoing_stack_byte_width"
    if index == 35: return "outgoing_stack_frame_bytes"
    if index == 36: return "semantic_kind"
    if index == 37: return "semantic_start"
    if index == 38: return "semantic_end"
    if index == 39: return "semantic_register"
    return ""

fn regallocProductionActionFieldValue(
        action: var alloc.RegallocValueAction,
        index: int32): int32 =
    if index == 0: return action.consumerOrdinal
    if index == 1: return action.kind
    if index == 2: return action.placement
    if index == 3: return action.position
    if index == 4: return action.blockIndex
    if index == 5: return action.opIndex
    if index == 6: return action.termIndex
    if index == 7: return action.factIndex
    if index == 8: return action.valueId
    if index == 9: return action.otherValueId
    if index == 10: return action.sourceLocation
    if index == 11: return action.targetLocation
    if index == 12: return action.sourceReg
    if index == 13: return action.targetReg
    if index == 14: return action.sourceStackSlot
    if index == 15: return action.targetStackSlot
    if index == 16: return action.scratchReg
    if index == 17:
        if action.targetMemoryHome: return 1
        return 0
    if index == 18: return action.sourceBlock
    if index == 19: return action.targetBlock
    if index == 20: return action.edgeIndex
    if index == 21:
        if action.requiresEdgeSplit: return 1
        return 0
    if index == 22: return action.parallelGroup
    if index == 23: return action.parallelOrdinal
    if index == 24: return action.relatedActionOrdinal
    if index == 25: return action.fixedKind
    if index == 26: return action.fixedOrdinal
    if index == 27: return action.passKind
    if index == 28: return action.encodedValue
    if index == 29: return action.callOrdinal
    if index == 30: return action.abiSizeBytes
    if index == 31:
        if action.abiSizeExplicit: return 1
        return 0
    if index == 32: return action.outgoingStackArgIndex
    if index == 33: return action.outgoingStackByteOffset
    if index == 34: return action.outgoingStackByteWidth
    if index == 35: return action.outgoingStackFrameBytes
    if index == 36: return action.semanticKind
    if index == 37: return action.semanticStart
    if index == 38: return action.semanticEnd
    if index == 39: return action.semanticRegister
    return 0

fn regallocProductionConstraintFields(
        constraints: var alloc.RegallocTargetConstraints): regallocProductionField[] =
    var out: regallocProductionField[]
    add(out, regallocProductionFieldI32Array(
        "register_universe", constraints.registerUniverse))
    add(out, regallocProductionFieldI32Array(
        "allocatable_caller_regs", constraints.allocatableCallerRegs))
    add(out, regallocProductionFieldI32Array(
        "allocatable_callee_regs", constraints.allocatableCalleeRegs))
    add(out, regallocProductionFieldI32Array(
        "reserved_regs", constraints.reservedRegs))
    add(out, regallocProductionFieldI32Array(
        "call_clobber_regs", constraints.callClobberRegs))
    add(out, regallocProductionFieldI32Array(
        "fixed_arg_regs", constraints.fixedArgRegs))
    add(out, regallocProductionFieldI32(
        "fixed_result_reg", constraints.fixedResultReg))
    add(out, regallocProductionFieldI32(
        "fixed_sret_reg", constraints.fixedSretReg))
    add(out, regallocProductionFieldBool(
        "sret_shifts_fixed_args",
        constraints.sretShiftsFixedArgs))
    add(out, regallocProductionFieldI32(
        "fixed_return_reg", constraints.fixedReturnReg))
    add(out, regallocProductionFieldI32(
        "parallel_copy_scratch_reg", constraints.parallelCopyScratchReg))
    add(out, regallocProductionFieldBool(
        "packed_stack_args", constraints.packedStackArgs))
    add(out, regallocProductionFieldI32(
        "stack_arg_slot_bytes", constraints.stackArgSlotBytes))
    add(out, regallocProductionFieldI32(
        "stack_alignment_bytes", constraints.stackAlignmentBytes))
    add(out, regallocProductionFieldI32Array(
        "gpr_type_kinds", constraints.gprTypeKinds))
    return out

fn regallocProductionPlanFields(
        plan: var alloc.RegallocSinglePassValuePlan): regallocProductionField[] =
    var out: regallocProductionField[]
    add(out, regallocProductionFieldText(
        "debug_provenance_sha256", plan.debugProvenanceSha256))
    add(out, regallocProductionFieldI32(
        "stack_slot_count", plan.stackSlotCount))
    add(out, regallocProductionFieldI32("call_count", plan.callCount))
    add(out, regallocProductionFieldI32Array(
        "call_arg_counts", plan.callArgCounts))
    add(out, regallocProductionFieldBoolArray(
        "call_reachable", plan.callReachable))
    add(out, regallocProductionFieldI32(
        "position_count", plan.positionCount))
    add(out, regallocProductionFieldI32Array(
        "block_entry_positions", plan.blockEntryPositions))
    add(out, regallocProductionFieldI32Array(
        "block_exit_positions", plan.blockExitPositions))
    add(out, regallocProductionFieldI32Array(
        "body_op_kinds", plan.bodyOpKinds))
