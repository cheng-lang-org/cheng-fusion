        "value_use_fact_indices", plan.valueUseFactIndices))
    add(out, regallocProductionFieldI32Array(
        "value_use_kinds", plan.valueUseKinds))
    add(out, regallocProductionFieldI32Array(
        "value_use_source_blocks", plan.valueUseSourceBlocks))
    add(out, regallocProductionFieldI32Array(
        "value_use_target_blocks", plan.valueUseTargetBlocks))
    add(out, regallocProductionFieldI32Array(
        "call_positions", plan.callPositions))
    add(out, regallocProductionFieldI32Array(
        "allocation_order", plan.allocationOrder))
    add(out, regallocProductionFieldI32Array(
        "reg_interval_offsets", plan.regIntervalOffsets))
    add(out, regallocProductionFieldI32Array(
        "reg_interval_values", plan.regIntervalValues))
    add(out, regallocProductionFieldI32Array(
        "operand_reg_by_fact", plan.operandRegByFact))
    add(out, regallocProductionFieldI32Array(
        "access_fact_registers", plan.accessFactRegisters))
    add(out, regallocProductionFieldBoolArray(
        "access_fact_is_allocator_clobber",
        plan.accessFactIsAllocatorClobber))
    add(out, regallocProductionFieldI32Array(
        "access_fact_block_indices", plan.accessFactBlockIndices))
    add(out, regallocProductionFieldI32Array(
        "access_fact_op_indices", plan.accessFactOpIndices))
    add(out, regallocProductionFieldI32Array(
        "access_fact_term_indices", plan.accessFactTermIndices))
    add(out, regallocProductionFieldI32Array(
        "access_fact_edge_indices", plan.accessFactEdgeIndices))
    add(out, regallocProductionFieldI32Array(
        "op_action_starts", plan.opActionStarts))
    add(out, regallocProductionFieldI32Array(
        "op_action_counts", plan.opActionCounts))
    add(out, regallocProductionFieldI32Array(
        "term_action_starts", plan.termActionStarts))
    add(out, regallocProductionFieldI32Array(
        "term_action_counts", plan.termActionCounts))
    add(out, regallocProductionFieldI32Array(
        "block_entry_action_starts", plan.blockEntryActionStarts))
    add(out, regallocProductionFieldI32Array(
        "block_entry_action_counts", plan.blockEntryActionCounts))
    add(out, regallocProductionFieldI32(
        "function_entry_action_start", plan.functionEntryActionStart))
    add(out, regallocProductionFieldI32(
        "function_entry_action_count", plan.functionEntryActionCount))
    add(out, regallocProductionFieldI32Array(
        "block_exit_action_starts", plan.blockExitActionStarts))
    add(out, regallocProductionFieldI32Array(
        "block_exit_action_counts", plan.blockExitActionCounts))
    add(out, regallocProductionFieldI32Array(
        "edge_source_blocks", plan.edgeSourceBlocks))
    add(out, regallocProductionFieldI32Array(
        "edge_target_blocks", plan.edgeTargetBlocks))
    add(out, regallocProductionFieldI32Array(
        "edge_action_starts", plan.edgeActionStarts))
    add(out, regallocProductionFieldI32Array(
        "edge_action_counts", plan.edgeActionCounts))
    add(out, regallocProductionFieldI32Array(
        "virtual_entry_action_starts", plan.virtualEntryActionStarts))
