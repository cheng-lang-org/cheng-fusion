    add(out, regallocProductionFieldI32Array(
        "value_type_kinds", plan.valueTypeKinds))
    add(out, regallocProductionFieldI32Array(
        "value_classes", plan.valueClasses))
    add(out, regallocProductionFieldBoolArray(
        "value_memory_homes", plan.valueMemoryHomes))
    add(out, regallocProductionFieldI32Array(
        "value_assigned_regs", plan.valueAssignedRegs))
    add(out, regallocProductionFieldI32Array(
        "value_use_offsets", plan.valueUseOffsets))
