import std/rawbytes
import cheng/core/backend/direct_object_debug_sections as debugsections
import cheng/core/backend/object_symbols as osym

type
    MachODebugSectionEvidence =
        valid: bool
        lineSectionIndex: int32 = -1
        lineFileOffset: int32 = -1
        lineByteLength: int32
        lineRelocationFileOffset: int32 = -1
        lineRelocationCount: int32
        infoSectionIndex: int32 = -1
        infoFileOffset: int32 = -1
        infoByteLength: int32
        infoRelocationFileOffset: int32 = -1
        infoRelocationCount: int32
        abbrevSectionIndex: int32 = -1
        abbrevFileOffset: int32 = -1
        abbrevByteLength: int32

fn machoDebugRangeWithin(offset: int32,
                         byteLength: int32,
                         total: int32): bool =
    return offset >= 0 && byteLength >= 0 &&
           offset <= total - byteLength

@borrows
fn machoDebugReadU32(bytes: rawbytes.Bytes,
                     offset: int32): int32 =
    if !machoDebugRangeWithin(offset, 4, rawbytes.BytesLen(bytes)):
        return -1
    let value = int64(rawbytes.BytesGet(bytes, offset)) +
                int64(rawbytes.BytesGet(bytes, offset + 1)) * int64(256) +
                int64(rawbytes.BytesGet(bytes, offset + 2)) * int64(65536) +
                int64(rawbytes.BytesGet(bytes, offset + 3)) * int64(16777216)
    if value < int64(0) || value > int64(2147483647):
        return -1
    return int32(value)

@borrows
fn machoDebugReadU64(bytes: rawbytes.Bytes,
                     offset: int32): int64 =
    if !machoDebugRangeWithin(offset, 8, rawbytes.BytesLen(bytes)):
        return int64(-1)
    var value: uint64
    for index in 0..<8:
        value = value |
            (uint64(rawbytes.BytesGet(bytes, offset + index) & 255) <<
             uint64(index * 8))
    if value > uint64(9223372036854775807):
        return int64(-1)
    return int64(value)

@borrows
fn machoDebugNameEquals(bytes: rawbytes.Bytes,
                        offset: int32,
                        expected: str): bool =
    if expected.len <= 0 || expected.len > 16 ||
       !machoDebugRangeWithin(offset, 16, rawbytes.BytesLen(bytes)):
        return false
    for index in 0..<expected.len:
        if rawbytes.BytesGet(bytes, offset + index) !=
           (int32(expected[index]) & 255):
            return false
    for index in expected.len..<16:
        if rawbytes.BytesGet(bytes, offset + index) != 0:
            return false
    return true

@borrows
fn machoDebugPayloadEqual(objectBytes: rawbytes.Bytes,
                          fileOffset: int32,
                          expected: rawbytes.Bytes): bool =
    if !machoDebugRangeWithin(
           fileOffset, rawbytes.BytesLen(expected),
           rawbytes.BytesLen(objectBytes)):
        return false
    for index in 0..<rawbytes.BytesLen(expected):
        if rawbytes.BytesGet(objectBytes, fileOffset + index) !=
           rawbytes.BytesGet(expected, index):
            return false
    return true

@borrows
fn machoDebugCStringEquals(bytes: rawbytes.Bytes,
                           tableOffset: int32,
                           tableLength: int32,
                           stringOffset: int32,
                           expected: str): bool =
    if expected.len <= 0 || stringOffset <= 0 ||
       stringOffset > tableLength - expected.len - 1 ||
       !machoDebugRangeWithin(
           tableOffset, tableLength, rawbytes.BytesLen(bytes)):
        return false
    for index in 0..<expected.len:
        if rawbytes.BytesGet(
               bytes, tableOffset + stringOffset + index) !=
           (int32(expected[index]) & 255):
            return false
    return rawbytes.BytesGet(
               bytes, tableOffset + stringOffset + expected.len) == 0

@borrows
fn machoDebugRelocationExpectedAt(
        expected: debugsections.DirectObjectDebugSections,
        sectionKind: int32,
        ordinal: int32,
        out: var debugsections.DirectObjectDebugRelocation): bool =
    var observed: int32
    for index in 0..<expected.relocations.len:
        if expected.relocations[index].sectionKind != sectionKind:
            continue
        if observed == ordinal:
            out = expected.relocations[index]
            return true
        observed = observed + 1
    return false

@borrows
fn machoDebugValidateRelocationTableInto(
        objectBytes: rawbytes.Bytes,
        sectionKind: int32,
        sectionFileOffset: int32,
        sectionByteLength: int32,
        relocationFileOffset: int32,
        relocationCount: int32,
        expected: debugsections.DirectObjectDebugSections,
        symbols: osym.ObjectSymbolTable,
        err: var str): bool =
    if relocationCount <= 0 || relocationFileOffset <= 0 ||
       !machoDebugRangeWithin(
           relocationFileOffset, relocationCount * 8,
           rawbytes.BytesLen(objectBytes)):
        err = " Mach-O debug evidence: missing relocation table"
        return false
    for ordinal in 0..<relocationCount:
        var expectedReloc: debugsections.DirectObjectDebugRelocation
        if !machoDebugRelocationExpectedAt(
               expected, sectionKind, ordinal, expectedReloc):
            err = " Mach-O debug evidence: unexpected relocation count"
            return false
        let rowOffset = relocationFileOffset + ordinal * 8
        let sectionByteOffset = machoDebugReadU32(objectBytes, rowOffset)
        let word = machoDebugReadU32(objectBytes, rowOffset + 4)
        if word < 0 || sectionByteOffset != expectedReloc.sectionByteOffset ||
           sectionByteOffset > sectionByteLength - 8:
            err = " Mach-O debug evidence: relocation offset mismatch"
            return false
        let symbolIndex = word & 0x00ffffff
        let pcRelative = (word >> 24) & 1
        let byteLengthCode = (word >> 25) & 3
        let isExternal = (word >> 27) & 1
        let relocationType = (word >> 28) & 15
        if symbolIndex != expectedReloc.targetSymbolIndex ||
           symbolIndex < 0 || symbolIndex >= osym.ObjectSymbolsCount(symbols) ||
           pcRelative != 0 || byteLengthCode != 3 ||
           isExternal != 1 || relocationType != 0:
            err = " Mach-O debug evidence: relocation encoding mismatch"
            return false
        let target = osym.ObjectSymbolsAt(symbols, symbolIndex)
        if target.name != expectedReloc.targetSymbolName ||
           target.undefined || target.sectionIndex != 0 ||
           target.offset + int64(expectedReloc.targetAddend) !=
               int64(expectedReloc.targetTextByteStart) ||
           machoDebugReadU64(
               objectBytes,
               sectionFileOffset + sectionByteOffset) !=
               int64(expectedReloc.targetAddend):
            err = " Mach-O debug evidence: relocated PC provenance mismatch"
            return false
    var extra: debugsections.DirectObjectDebugRelocation
    if machoDebugRelocationExpectedAt(
           expected, sectionKind, relocationCount, extra):
        err = " Mach-O debug evidence: truncated relocation table"
        return false
    return true

@borrows
fn MachODebugSectionEvidenceBuildInto(
        objectBytes: rawbytes.Bytes,
        expected: debugsections.DirectObjectDebugSections,
        symbols: osym.ObjectSymbolTable,
        out: var MachODebugSectionEvidence,
        err: var str): bool =
    out = MachODebugSectionEvidence()
    out.lineSectionIndex = -1
    out.lineFileOffset = -1
    out.lineRelocationFileOffset = -1
    out.infoSectionIndex = -1
    out.infoFileOffset = -1
    out.infoRelocationFileOffset = -1
    out.abbrevSectionIndex = -1
    out.abbrevFileOffset = -1
    err = ""
    if !expected.valid || rawbytes.BytesLen(objectBytes) < 32 ||
       rawbytes.BytesGet(objectBytes, 0) != 0xcf ||
       rawbytes.BytesGet(objectBytes, 1) != 0xfa ||
       rawbytes.BytesGet(objectBytes, 2) != 0xed ||
       rawbytes.BytesGet(objectBytes, 3) != 0xfe ||
       machoDebugReadU32(objectBytes, 4) != 0x0100000c ||
       machoDebugReadU32(objectBytes, 8) != 0 ||
       machoDebugReadU32(objectBytes, 12) != 1 ||
       machoDebugReadU32(objectBytes, 16) != 2 ||
       machoDebugReadU32(objectBytes, 24) != 0 ||
       machoDebugReadU32(objectBytes, 28) != 0:
        err = " Mach-O debug evidence: invalid object command shape"
        return false
    let commandBytes = machoDebugReadU32(objectBytes, 20)
    let segmentOffset = 32
    if commandBytes <= 0 ||
       !machoDebugRangeWithin(32, commandBytes,
                              rawbytes.BytesLen(objectBytes)) ||
       machoDebugReadU32(objectBytes, segmentOffset) != 25:
        err = " Mach-O debug evidence: missing segment command"
        return false
    let segmentSize = machoDebugReadU32(objectBytes, segmentOffset + 4)
    let sectionCount = machoDebugReadU32(objectBytes, segmentOffset + 64)
    let segmentFileOffset = machoDebugReadU64(
        objectBytes, segmentOffset + 40)
    if sectionCount < 4 || sectionCount > 5 ||
       segmentSize != 72 + sectionCount * 80 ||
       segmentFileOffset < 0:
        err = " Mach-O debug evidence: invalid segment section table"
        return false
    for sectionIndex in 0..<sectionCount:
        let sectionOffset = segmentOffset + 72 + sectionIndex * 80
        let sectionAddr = machoDebugReadU64(objectBytes, sectionOffset + 32)
        let sectionSize = machoDebugReadU64(objectBytes, sectionOffset + 40)
        let fileOffset = machoDebugReadU32(objectBytes, sectionOffset + 48)
        let relocationOffset = machoDebugReadU32(
            objectBytes, sectionOffset + 56)
        let relocationCount = machoDebugReadU32(
            objectBytes, sectionOffset + 60)
        if sectionAddr < 0 || sectionSize <= 0 || fileOffset < 0 ||
           relocationOffset < 0 || relocationCount < 0 ||
           int64(fileOffset) != segmentFileOffset + sectionAddr ||
           !machoDebugRangeWithin(
               fileOffset, int32(sectionSize),
               rawbytes.BytesLen(objectBytes)):
            err = " Mach-O debug evidence: malformed section range"
            return false
        if machoDebugNameEquals(
               objectBytes, sectionOffset, "__debug_line"):
            if out.lineSectionIndex >= 0 ||
               !machoDebugNameEquals(
                   objectBytes, sectionOffset + 16, "__DWARF"):
                err = " Mach-O debug evidence: invalid debug_line identity"
                return false
            out.lineSectionIndex = sectionIndex + 1
            out.lineFileOffset = fileOffset
            out.lineByteLength = int32(sectionSize)
            out.lineRelocationFileOffset = relocationOffset
            out.lineRelocationCount = relocationCount
        elif machoDebugNameEquals(
                 objectBytes, sectionOffset, "__debug_info"):
            if out.infoSectionIndex >= 0 ||
               !machoDebugNameEquals(
                   objectBytes, sectionOffset + 16, "__DWARF"):
                err = " Mach-O debug evidence: invalid debug_info identity"
                return false
            out.infoSectionIndex = sectionIndex + 1
            out.infoFileOffset = fileOffset
            out.infoByteLength = int32(sectionSize)
            out.infoRelocationFileOffset = relocationOffset
            out.infoRelocationCount = relocationCount
        elif machoDebugNameEquals(
                 objectBytes, sectionOffset, "__debug_abbrev"):
            if out.abbrevSectionIndex >= 0 ||
               !machoDebugNameEquals(
                   objectBytes, sectionOffset + 16, "__DWARF") ||
               relocationOffset != 0 || relocationCount != 0:
                err = " Mach-O debug evidence: invalid debug_abbrev identity"
                return false
            out.abbrevSectionIndex = sectionIndex + 1
            out.abbrevFileOffset = fileOffset
            out.abbrevByteLength = int32(sectionSize)
    if out.lineSectionIndex < 0 || out.infoSectionIndex < 0 ||
       out.abbrevSectionIndex < 0 ||
       out.lineByteLength != rawbytes.BytesLen(expected.debugLine) ||
       out.infoByteLength != rawbytes.BytesLen(expected.debugInfo) ||
       out.abbrevByteLength != rawbytes.BytesLen(expected.debugAbbrev) ||
       !machoDebugPayloadEqual(
           objectBytes, out.lineFileOffset, expected.debugLine) ||
       !machoDebugPayloadEqual(
           objectBytes, out.infoFileOffset, expected.debugInfo) ||
       !machoDebugPayloadEqual(
           objectBytes, out.abbrevFileOffset, expected.debugAbbrev):
        err = " Mach-O debug evidence: section payload mismatch"
        return false

    let symtabOffset = 32 + segmentSize
    if machoDebugReadU32(objectBytes, symtabOffset) != 2 ||
       machoDebugReadU32(objectBytes, symtabOffset + 4) != 24:
        err = " Mach-O debug evidence: missing symbol table"
        return false
    let symbolTableOffset = machoDebugReadU32(
        objectBytes, symtabOffset + 8)
    let symbolCount = machoDebugReadU32(objectBytes, symtabOffset + 12)
    let stringTableOffset = machoDebugReadU32(
        objectBytes, symtabOffset + 16)
    let stringTableLength = machoDebugReadU32(
        objectBytes, symtabOffset + 20)
    if symbolCount != osym.ObjectSymbolsCount(symbols) ||
       symbolTableOffset < 0 || stringTableOffset < 0 ||
       stringTableLength <= 1 ||
       symbolTableOffset + symbolCount * 16 != stringTableOffset ||
       stringTableOffset + stringTableLength != rawbytes.BytesLen(objectBytes):
        err = " Mach-O debug evidence: symbol table range mismatch"
        return false
    for symbolIndex in 0..<symbolCount:
        let expectedSymbol = osym.ObjectSymbolsAt(symbols, symbolIndex)
        let rowOffset = symbolTableOffset + symbolIndex * 16
        let nameOffset = machoDebugReadU32(objectBytes, rowOffset)
        let symbolType = rawbytes.BytesGet(objectBytes, rowOffset + 4)
        let sectionIndex = rawbytes.BytesGet(objectBytes, rowOffset + 5)
        let value = machoDebugReadU64(objectBytes, rowOffset + 8)
        if !machoDebugCStringEquals(
               objectBytes, stringTableOffset, stringTableLength,
               nameOffset, expectedSymbol.name):
            err = " Mach-O debug evidence: relocation target symbol mismatch"
            return false
        if expectedSymbol.undefined:
            if (symbolType != 0 && symbolType != 1) ||
               sectionIndex != 0 || value != 0:
                err = " Mach-O debug evidence: malformed undefined symbol"
                return false
        elif (symbolType != 14 && symbolType != 15) ||
             expectedSymbol.sectionIndex < 0 ||
             sectionIndex != expectedSymbol.sectionIndex + 1 ||
             value != expectedSymbol.offset:
            err = " Mach-O debug evidence: malformed defined symbol"
            return false
    if !machoDebugValidateRelocationTableInto(
           objectBytes, debugsections.DirectObjectDebugSectionLine,
           out.lineFileOffset, out.lineByteLength,
           out.lineRelocationFileOffset, out.lineRelocationCount,
           expected, symbols, err) ||
       !machoDebugValidateRelocationTableInto(
           objectBytes, debugsections.DirectObjectDebugSectionInfo,
           out.infoFileOffset, out.infoByteLength,
           out.infoRelocationFileOffset, out.infoRelocationCount,
           expected, symbols, err):
        return false
    out.valid = true
    return true
