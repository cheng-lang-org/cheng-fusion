# codegen_rv_isa_units.cheng —— riscv ISA xlen 纯函数直调门面（R2-C6）
#
# 承接 backend2 领地收编：backend2_assemble.cheng 原裸 import
# riscv64_encode（仅消费 RvIsaEsp32S31Xlen / RvIsaXlenOk 两个纯函数），
# 构成 kernel 闭包外的无门面裸直连（归属表 Step1 门对 backend2 盲区，
# 作战图 r2_closure_ops_map.md C6）。按 codegen_darwin_provider_units
# （B9）同一形态收编：本模块持 arch import，backend2 只经本门面消费。
#
# 形态：同名单行转发（backend2_assemble 以 `as rvenc` 别名本模块，调用点
# 零改动），零间接调用，语义与原直调逐字节相同；无派发表（单 arch 载体），
# 未命中臂不适用。
#
# 归属：shared-format。riscv64_encode 本体归 riscv64 插件桶。
import cheng/core/backend/riscv64_encode as rvenc

fn RvIsaXlenOk(xlen: int32): bool =
    return rvenc.RvIsaXlenOk(xlen)

fn RvIsaEsp32S31Xlen(): int32 =
    return rvenc.RvIsaEsp32S31Xlen()
