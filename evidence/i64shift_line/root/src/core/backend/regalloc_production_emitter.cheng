import cheng/core/ir/core_types as coreir
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/codegen_regalloc_adapter_units as radapter
import cheng/core/backend/regalloc_production_artifacts as artifacts
import cheng/core/ir/body_ir_access as bodyaccess
import cheng/core/ir/body_ir_cfg as cfg
import cheng/core/analysis/cleanup_cfg as cleanup
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import std/rawbytes
import std/seqs
import std/system
import std/os
import std/strings
import std/strutils as strutil

const
    RegallocProductionEmitOk = 0
    RegallocProductionEmitPlanInvalid = 1
    RegallocProductionEmitRecipeInvalid = 2
    RegallocProductionEmitSymbolInvalid = 3
    RegallocProductionEmitActionMissing = 4
    RegallocProductionEmitActionAmbiguous = 5
    RegallocProductionEmitActionAckFailed = 6
    RegallocProductionEmitFinalizeFailed = 7
    RegallocProductionEmitRelocInvalid = 8
    RegallocProductionEmitCallTargetInvalid = 9
    RegallocProductionEmitDataTargetInvalid = 10
    RegallocProductionEmitSnapshotInvalid = 11
    RegallocProductionEmitTargetUnsupported = 12

type
    RegallocProductionDataSymbolProjection =
        slotDataSymbols: str[]
        cstringDataSymbols: str[]
        sourceLocalSlotLenBefore: int32
        sourceLocalSlotCapBefore: int32
        sourceCStringLenBefore: int32
        sourceCStringCapBefore: int32
        sourceBodyIrIngressCidBefore: layout.FixedBytes32
        retainedBufferCount: int32
        retainedColumnCapacityBytes: int64
        retainedManagedStringValueCount: int32
        retainedManagedStringBytes: int64

    RegallocProductionDataSymbolProjectionReceipt =
        sourceLocalSlotLenBefore: int32
        sourceLocalSlotCapBefore: int32
        sourceCStringLenBefore: int32
        sourceCStringCapBefore: int32
        sourceLocalSlotLenAfter: int32
        sourceLocalSlotCapAfter: int32
        sourceCStringLenAfter: int32
        sourceCStringCapAfter: int32
        sourceBodyIrIngressCidBefore: layout.FixedBytes32
        sourceBodyIrIngressCidAfter: layout.FixedBytes32
        slotProjectionRows: int32
        slotProjectionCapacity: int32
        cstringProjectionRows: int32
        cstringProjectionCapacity: int32
        retainedBufferCount: int32
        releasedBufferCount: int32
        retainedColumnCapacityBytes: int64
        releasedColumnCapacityBytes: int64
        retainedManagedStringValueCount: int32
        releasedManagedStringValueCount: int32
        retainedManagedStringBytes: int64
        releasedManagedStringBytes: int64
        physicalFreeCount: int64
        orcReleaseCount: int64
        orcSlotColumnReleaseCount: int64
        orcCStringColumnReleaseCount: int64
        retainedManagedStringDueReleaseCount: int32
        dataSymbolRowEvidence: str
        storageReleased: bool
        valid: bool

    RegallocProductionFunctionEmission =
        valid: bool
        errorCode: int32
        errorDetail: int32 = -1
        bodyIrSha256: str
        targetTriple: str
        recipeOrigin: str
        publishedWordStart: int32
        publishedWordCount: int32
        publishedRelocStart: int32
        publishedRelocCount: int32
        frozenSnapshotPayload: str
        frozenSnapshotPayloadSha256: str
        plan: alloc.RegallocSinglePassValuePlan
        recipes: contract.RegallocA64FunctionRecipes
        receipt: alloc.RegallocValueEmissionReceipt
        debugProvenanceBound: bool
        debugFunctionId: int32 = -1
        debugMachineFragmentRootSha256: str
        debugFragmentOpIds: int32[]
        debugFragmentSyntheticKinds: int32[]
        debugFragmentSiteKinds: int32[]
        debugFragmentSiteIndexes: int32[]
        debugFragmentMachineOwnerKinds: int32[]
        debugFragmentMachineOwnerOrdinals: int32[]
        debugFragmentActionConsumerOrdinals: int32[]
        debugFragmentTextByteStarts: int32[]
        debugFragmentByteLengths: int32[]
        debugFragmentBytesSha256s: str[]
        deferFunctionRows: int32[]
        deferStatementRows: int32[]
        deferActionCids: layout.FixedBytes32[]
        deferFragmentCids: layout.FixedBytes32[]
        encoderSourceRow: int32 = -1
        encoderSourceCid: layout.FixedBytes32
        dataSymbolProjectionReceipt:
            RegallocProductionDataSymbolProjectionReceipt

@borrows
fn regallocProductionEmitFail(
        out: var RegallocProductionFunctionEmission,
        code: int32,
        detail: int32) =
    out.valid = false
    out.errorCode = code
    out.errorDetail = detail

@borrows
fn RegallocProductionEmissionPublishedPayloadExact(
        out: var RegallocProductionFunctionEmission): bool =
    return out.valid &&
           out.publishedWordStart == 0 &&
           out.publishedWordCount > 0 &&
           out.publishedWordCount == out.recipes.functionWords.len &&
           out.publishedRelocStart == 0 &&
           out.publishedRelocCount == out.recipes.functionRelocs.len

@borrows
fn regallocProductionDeferAppendI32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)

@borrows
fn regallocProductionDeferAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    regallocProductionDeferAppendI32(buf, len(value))
    for index in 0..<len(value):
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

@borrows
fn regallocProductionDeferFragmentCid(
        bodyIR: var coreir.BodyIR,
        out: var RegallocProductionFunctionEmission,
        deferId: int32): layout.FixedBytes32 =
    if deferId < 0 || deferId >= bodyIR.deferActionCids.len ||
       deferId >= bodyIR.deferFunctionRows.len ||
       deferId >= bodyIR.deferStatementRows.len:
        return layout.FixedBytes32()
    var fragmentCount: int32
    for fragmentIndex in 0..<out.recipes.machineFragments.len:
        let fragment = out.recipes.machineFragments[fragmentIndex]
        if coreir.BodyIRControlFlowBlockInDeferAction(
               bodyIR, deferId, fragment.blockIndex):
            fragmentCount = fragmentCount + 1
    if fragmentCount <= 0:
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(1024)
    regallocProductionDeferAppendText(
        buf, "cheng.regalloc.defer_fragment.cid.current")
    regallocProductionDeferAppendText(buf, out.targetTriple)
    if !out.receipt.valid ||
       len(out.receipt.actionSemanticRootSha256) != 64 ||
       len(out.receipt.actionBindingRootSha256) != 64 ||
       len(out.receipt.machineFragmentRootSha256) != 64:
        layout.ByteBufFree(buf)
        return layout.FixedBytes32()
    regallocProductionDeferAppendText(
        buf, out.receipt.actionSemanticRootSha256)
    regallocProductionDeferAppendText(
        buf, out.receipt.actionBindingRootSha256)
    regallocProductionDeferAppendText(
        buf, out.receipt.machineFragmentRootSha256)
    regallocProductionDeferAppendI32(
        buf, bodyIR.deferFunctionRows[deferId])
    regallocProductionDeferAppendI32(
        buf, bodyIR.deferStatementRows[deferId])
    layout.ByteBufAppendFixed32(
        buf, bodyIR.deferActionCids[deferId])
    regallocProductionDeferAppendI32(buf, fragmentCount)
    for fragmentIndex in 0..<out.recipes.machineFragments.len:
        let fragment = out.recipes.machineFragments[fragmentIndex]
        if !coreir.BodyIRControlFlowBlockInDeferAction(
               bodyIR, deferId, fragment.blockIndex):
            continue
        if fragment.wordStart < 0 || fragment.wordCount <= 0 ||
           fragment.wordStart >
               out.recipes.functionWords.len - fragment.wordCount:
            layout.ByteBufFree(buf)
            return layout.FixedBytes32()
        regallocProductionDeferAppendI32(buf, fragmentIndex)
        regallocProductionDeferAppendI32(buf, fragment.ownerKind)
        regallocProductionDeferAppendI32(buf, fragment.ownerOrdinal)
        regallocProductionDeferAppendI32(
            buf, fragment.actionConsumerOrdinal)
        regallocProductionDeferAppendI32(buf, fragment.siteKind)
        regallocProductionDeferAppendI32(buf, fragment.siteIndex)
        regallocProductionDeferAppendI32(buf, fragment.blockIndex)
        regallocProductionDeferAppendI32(buf, fragment.edgeIndex)
        regallocProductionDeferAppendI32(buf, fragment.ingressIndex)
        regallocProductionDeferAppendI32(buf, fragment.sourceBlock)
        regallocProductionDeferAppendI32(buf, fragment.targetBlock)
        regallocProductionDeferAppendI32(
            buf, if fragment.requiresEdgeSplit: 1 else: 0)
        regallocProductionDeferAppendI32(buf, fragment.valueId)
        regallocProductionDeferAppendI32(buf, fragment.irKind)
        regallocProductionDeferAppendI32(buf, fragment.wordStart)
        regallocProductionDeferAppendI32(buf, fragment.wordCount)
        regallocProductionDeferAppendI32(buf, fragment.effectMask)
        for wordIndex in fragment.wordStart..<
                (fragment.wordStart + fragment.wordCount):
            regallocProductionDeferAppendI32(
                buf, out.recipes.functionWords[wordIndex])
        regallocProductionDeferAppendI32(
            buf, fragment.writtenRegs.len)
        for index in 0..<fragment.writtenRegs.len:
            regallocProductionDeferAppendI32(
                buf, fragment.writtenRegs[index])
        regallocProductionDeferAppendI32(
            buf, fragment.allocatorClobberFactIndices.len)
        for index in 0..<fragment.allocatorClobberFactIndices.len:
            regallocProductionDeferAppendI32(
                buf, fragment.allocatorClobberFactIndices[index])
        regallocProductionDeferAppendI32(buf, fragment.relocs.len)
        for relocIndex in 0..<fragment.relocs.len:
            let reloc = fragment.relocs[relocIndex]
            regallocProductionDeferAppendI32(buf, reloc.kind)
            regallocProductionDeferAppendI32(buf, reloc.wordIndex)
            regallocProductionDeferAppendI32(buf, reloc.byteOffset)
            regallocProductionDeferAppendI32(buf, reloc.callOrdinal)
            regallocProductionDeferAppendI32(buf, reloc.opIndex)
            regallocProductionDeferAppendI32(buf, reloc.subIndex)
            regallocProductionDeferAppendI32(buf, reloc.targetDomain)
            regallocProductionDeferAppendI32(buf, reloc.targetRow)
            layout.ByteBufAppendFixed32(
                buf, reloc.targetInterfaceCid)
            regallocProductionDeferAppendText(
                buf, reloc.targetSymbol)
    let result = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return result

@borrows
fn regallocProductionBuildDeferEmissionReceipts(
        bodyIR: var coreir.BodyIR,
        out: var RegallocProductionFunctionEmission): bool =
    if !bodyIR.controlFlowSealed:
        return bodyIR.deferActionCids.len == 0
    if !coreir.BodyIRControlFlowShapeValid(bodyIR):
        return false
    for deferId in 0..<bodyIR.deferActionCids.len:
        let actionCid =
            coreir.BodyIRControlFlowDeferActionCid(bodyIR, deferId)
        if !layout.FixedBytes32Equal(
               actionCid, bodyIR.deferActionCids[deferId]):
            return false
        let fragmentCid =
            regallocProductionDeferFragmentCid(
                bodyIR, out, deferId)
        if layout.FixedBytes32Equal(
               fragmentCid, layout.FixedBytes32()):
            return false
        for priorDeferId in 0..<deferId:
            if layout.FixedBytes32Equal(
                   out.deferActionCids[priorDeferId], actionCid):
                return false
        add(out.deferFunctionRows,
            bodyIR.deferFunctionRows[deferId])
        add(out.deferStatementRows,
            bodyIR.deferStatementRows[deferId])
        add(out.deferActionCids, actionCid)
        add(out.deferFragmentCids, fragmentCid)
    return out.deferFunctionRows.len ==
               bodyIR.deferActionCids.len &&
           out.deferStatementRows.len ==
               bodyIR.deferActionCids.len &&
           out.deferActionCids.len ==
               bodyIR.deferActionCids.len &&
           out.deferFragmentCids.len ==
               bodyIR.deferActionCids.len

@borrows
fn regallocProductionWordsSha256(words: var int32[],
                                 wordStart: int32,
                                 wordCount: int32): str =
    if wordStart < 0 || wordCount < 0 ||
       wordStart > words.len - wordCount ||
       wordCount > 536870911:
        return ""
    if wordCount == 0:
        return alloc.RegallocValueEmptySha256
    var bytes = rawbytes.BytesAlloc(wordCount * 4)
    if rawbytes.BytesLen(bytes) != wordCount * 4:
        rawbytes.BytesFree(bytes)
        return ""
    for wordIndex in 0..<wordCount:
        let word = uint32(words[wordStart + wordIndex])
        let byteStart = wordIndex * 4
        rawbytes.BytesSet(bytes, byteStart,
                          int32(word & uint32(255)))
        rawbytes.BytesSet(bytes, byteStart + 1,
                          int32((word >> uint32(8)) & uint32(255)))
        rawbytes.BytesSet(bytes, byteStart + 2,
                          int32((word >> uint32(16)) & uint32(255)))
        rawbytes.BytesSet(bytes, byteStart + 3,
                          int32((word >> uint32(24)) & uint32(255)))
    let payload = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    return strings.Sha256(payload)

@borrows
fn regallocProductionPackedByte(
        words: var int32[],
        byteOffset: int32): int32 =
    if byteOffset < 0 ||
       byteOffset >= words.len * 4:
        return -1
    let word = uint32(words[byteOffset / 4])
    let shift = uint32((byteOffset % 4) * 8)
    return int32((word >> shift) & uint32(255))

@borrows
fn regallocProductionDebugAppendInt32(
        parts: var str[],
        value: int32) =
    let encoded = strings.IntToStr(value)
    add(parts, encoded)

@borrows
fn RegallocProductionDebugMachineFragmentRootSha256(
        emission: var RegallocProductionFunctionEmission): str =
    let count = emission.debugFragmentOpIds.len
    if !emission.debugProvenanceBound || emission.debugFunctionId < 0 ||
       len(emission.receipt.symbolName) <= 0 ||
       len(emission.bodyIrSha256) != 64 ||
       len(emission.receipt.debugProvenanceSha256) != 64 ||
       len(emission.receipt.machineFragmentRootSha256) != 64 ||
       count <= 0 ||
       emission.debugFragmentSyntheticKinds.len != count ||
       emission.debugFragmentSiteKinds.len != count ||
       emission.debugFragmentSiteIndexes.len != count ||
       emission.debugFragmentMachineOwnerKinds.len != count ||
       emission.debugFragmentMachineOwnerOrdinals.len != count ||
       emission.debugFragmentActionConsumerOrdinals.len != count ||
       emission.debugFragmentTextByteStarts.len != count ||
       emission.debugFragmentByteLengths.len != count ||
       emission.debugFragmentBytesSha256s.len != count:
        return ""
    var parts: str[]
    add(parts, "cheng.regalloc.debug_machine_fragments\n")
    add(parts, strings.CloneStr(emission.receipt.symbolName))
    add(parts, "\n")
    regallocProductionDebugAppendInt32(
        parts, emission.debugFunctionId)
    add(parts, "\n")
    add(parts, strings.CloneStr(emission.bodyIrSha256))
    add(parts, "\n")
    add(parts, strings.CloneStr(emission.receipt.debugProvenanceSha256))
    add(parts, "\n")
    add(parts, strings.CloneStr(emission.receipt.machineFragmentRootSha256))
    add(parts, "\n")
    regallocProductionDebugAppendInt32(parts, count)
    add(parts, "\n")
    for index in 0..<count:
        regallocProductionDebugAppendInt32(
            parts, emission.debugFragmentOpIds[index])
        add(parts, ";")
        regallocProductionDebugAppendInt32(
            parts, emission.debugFragmentSyntheticKinds[index])
        add(parts, ";")
        regallocProductionDebugAppendInt32(
            parts, emission.debugFragmentSiteKinds[index])
        add(parts, ";")
        regallocProductionDebugAppendInt32(
            parts, emission.debugFragmentSiteIndexes[index])
        add(parts, ";")
        regallocProductionDebugAppendInt32(
            parts, emission.debugFragmentMachineOwnerKinds[index])
        add(parts, ";")
        regallocProductionDebugAppendInt32(
            parts, emission.debugFragmentMachineOwnerOrdinals[index])
        add(parts, ";")
        regallocProductionDebugAppendInt32(
            parts,
            emission.debugFragmentActionConsumerOrdinals[index])
        add(parts, ";")
        regallocProductionDebugAppendInt32(
            parts, emission.debugFragmentTextByteStarts[index])
        add(parts, ";")
        regallocProductionDebugAppendInt32(
            parts, emission.debugFragmentByteLengths[index])
        add(parts, ";")
        add(parts, strings.CloneStr(emission.debugFragmentBytesSha256s[index]))
        add(parts, "\n")
    let payload = strutil.Join(parts, "")
    return strings.Sha256(payload)

@borrows
fn regallocProductionBuildDebugMachineFragments(
        bodyIR: var coreir.BodyIR,
        out: var RegallocProductionFunctionEmission): bool =
    if !bodyIR.debugProvenanceRequired:
        return true
    if !coreir.BodyIRDebugProvenanceShapeValid(bodyIR) ||
       bodyIR.debugFunctionId < 0 || !out.receipt.valid ||
       out.plan.debugProvenanceSha256 !=
           out.receipt.debugProvenanceSha256 ||
       out.plan.debugProvenanceSha256 !=
           alloc.RegallocSinglePassDebugProvenanceSha256(bodyIR):
        return false
    out.debugProvenanceBound = true
    out.debugFunctionId = bodyIR.debugFunctionId
    for fragmentIndex in 0..<out.recipes.machineFragments.len:
        let fragment = out.recipes.machineFragments[fragmentIndex]
        if fragment.wordStart < 0 || fragment.wordCount <= 0 ||
           fragment.wordStart >
               out.recipes.functionWords.len - fragment.wordCount:
            return false
        var debugOpId: int32 = -1
        var syntheticKind = coreir.BodyDebugSyntheticAbi
        if fragment.siteKind == bodyaccess.BodyIrAccessSiteOp:
            if !coreir.BodyIRDebugOpProvenanceAt(
                   bodyIR, fragment.siteIndex,
                   debugOpId, syntheticKind):
                return false
        elif fragment.siteKind == bodyaccess.BodyIrAccessSiteTerm:
            if !coreir.BodyIRDebugTermProvenanceAt(
                   bodyIR, fragment.siteIndex,
                   debugOpId, syntheticKind):
                return false
        elif fragment.siteKind != bodyaccess.BodyIrAccessSiteEntry:
            return false
        let byteLength = fragment.wordCount * 4
        if fragment.wordStart > 536870911 ||
           out.receipt.symbolByteStart >
               2147483647 - fragment.wordStart * 4:
            return false
        let textByteStart = out.receipt.symbolByteStart +
                            fragment.wordStart * 4
        let bytesSha256 = regallocProductionWordsSha256(
            out.recipes.functionWords,
            fragment.wordStart, fragment.wordCount)
        if len(bytesSha256) != 64 ||
           (debugOpId >= 0 &&
            syntheticKind != coreir.BodyDebugSyntheticNone) ||
           (debugOpId < 0 &&
            !coreir.BodyIRDebugSyntheticKindValid(syntheticKind)):
            return false
        add(out.debugFragmentOpIds, debugOpId)
        add(out.debugFragmentSyntheticKinds, syntheticKind)
        add(out.debugFragmentSiteKinds, fragment.siteKind)
        add(out.debugFragmentSiteIndexes, fragment.siteIndex)
        add(out.debugFragmentMachineOwnerKinds, fragment.ownerKind)
        add(out.debugFragmentMachineOwnerOrdinals,
            fragment.ownerOrdinal)
        add(out.debugFragmentActionConsumerOrdinals,
            fragment.actionConsumerOrdinal)
        add(out.debugFragmentTextByteStarts, textByteStart)
        add(out.debugFragmentByteLengths, byteLength)
        add(out.debugFragmentBytesSha256s, bytesSha256)
    out.debugMachineFragmentRootSha256 =
        RegallocProductionDebugMachineFragmentRootSha256(out)
    return len(out.debugMachineFragmentRootSha256) == 64

@borrows
fn regallocProductionActionFragmentIndexBuild(
        recipes: var contract.RegallocA64FunctionRecipes,
        actionCount: int32,
        fragmentIndexes: var int32[]): bool =
    setLen(fragmentIndexes, 0)
    for _ in 0..<actionCount:
        add(fragmentIndexes, -1)
    for index in 0..<recipes.machineFragments.len:
        if recipes.machineFragments[index].ownerKind ==
               contract.RegallocA64FragmentOwnerAbiIngress &&
           recipes.machineFragments[index].actionConsumerOrdinal < 0:
            continue
        if recipes.machineFragments[index].ownerKind !=
               contract.RegallocA64FragmentOwnerAction &&
           recipes.machineFragments[index].ownerKind !=
               contract.RegallocA64FragmentOwnerEdge &&
           recipes.machineFragments[index].ownerKind !=
               contract.RegallocA64FragmentOwnerAbiIngress:
            continue
        let consumerOrdinal =
            recipes.machineFragments[index].actionConsumerOrdinal
        if consumerOrdinal < 0 || consumerOrdinal >= actionCount ||
           fragmentIndexes[consumerOrdinal] >= 0:
            return false
        fragmentIndexes[consumerOrdinal] = index
    return true

@borrows
fn regallocProductionRelocIdentityMatches(
        reloc: contract.RegallocA64ActionReloc,
        bodyIR: var coreir.BodyIR,
        resolvedCallTargetSymbols: var str[]): bool =
    let isCall = contract.CodegenUnitRelocKindIsCall(reloc.kind)
    if !isCall:
        return reloc.targetDomain == -1 && reloc.targetRow == -1 &&
               layout.FixedBytes32Equal(
                   reloc.targetInterfaceCid, layout.FixedBytes32())
    let ordinal = reloc.callOrdinal
    if ordinal < 0 || ordinal >= bodyIR.callSequence.len ||
       ordinal >= bodyIR.callTargetDomainKinds.len ||
       ordinal >= bodyIR.callTargetRows.len ||
       ordinal >= bodyIR.callTargetInterfaceCids.len ||
       ordinal >= resolvedCallTargetSymbols.len:
        return false
    return reloc.targetDomain ==
               bodyIR.callTargetDomainKinds[ordinal] &&
           reloc.targetRow == bodyIR.callTargetRows[ordinal] &&
           layout.FixedBytes32Equal(
               reloc.targetInterfaceCid,
               bodyIR.callTargetInterfaceCids[ordinal]) &&
           reloc.targetSymbol == resolvedCallTargetSymbols[ordinal]

@borrows
fn regallocProductionRelocsValid(
        targetTriple: str,
        bodyIR: var coreir.BodyIR,
        resolvedCallTargetSymbols: var str[],
        recipes: var contract.RegallocA64FunctionRecipes): bool =
    if recipes.machineXlen != 32 && recipes.machineXlen != 64:
        return false
    var relocIndex: int32
    while relocIndex < recipes.functionRelocs.len:
        let reloc = recipes.functionRelocs[relocIndex]
        if reloc.wordIndex < 0 ||
           reloc.wordIndex >= recipes.functionWords.len ||
           reloc.byteOffset < 0 ||
           reloc.byteOffset > recipes.functionWords.len * 4 - 4 ||
           reloc.opIndex < 0 ||
           len(reloc.targetSymbol) <= 0 ||
           !regallocProductionRelocIdentityMatches(
               reloc, bodyIR, resolvedCallTargetSymbols):
            return false
        if reloc.kind == contract.RegallocA64RelocCall26:
            if !artifacts.RegallocProductionTargetIsA64(
                   targetTriple) ||
               reloc.byteOffset != reloc.wordIndex * 4 ||
               reloc.callOrdinal < 0 || reloc.subIndex >= 0:
                return false
            relocIndex = relocIndex + 1
            continue
        if reloc.kind == contract.RegallocMachineRelocRiscvCall:
            var riscvXlen: int32 = 64
            var riscvUnitId: int32 = contract.CodegenUnitRv64
            if artifacts.RegallocProductionTargetIsRv32(targetTriple):
                riscvXlen = 32
                riscvUnitId = contract.CodegenUnitRv32
            let expectedPair = contract.CodegenUnitCallPairExpectedWords(
                riscvUnitId, riscvXlen)
            if !artifacts.RegallocProductionTargetIsRiscv(
                   targetTriple) ||
               recipes.machineXlen != riscvXlen ||
               !expectedPair.auipcOk ||
               !expectedPair.jalrOk ||
               reloc.byteOffset != reloc.wordIndex * 4 ||
               reloc.wordIndex >= recipes.functionWords.len - 1 ||
               reloc.callOrdinal < 0 || reloc.subIndex >= 0 ||
               recipes.functionWords[reloc.wordIndex] !=
                   int32(int64(expectedPair.auipcWord)) ||
               recipes.functionWords[reloc.wordIndex + 1] !=
                   int32(int64(expectedPair.jalrWord)):
                return false
            relocIndex = relocIndex + 1
            continue
        if reloc.kind == contract.RegallocMachineRelocPcRel32:
            if targetTriple !=
                   artifacts.RegallocProductionTargetX64Linux ||
               reloc.wordIndex != reloc.byteOffset / 4 ||
               reloc.byteOffset <= 0 ||
               reloc.callOrdinal < 0 || reloc.subIndex >= 0 ||
               regallocProductionPackedByte(
                   recipes.functionWords,
                   reloc.byteOffset - 1) != 0xE8:
                return false
            for immediateByte in 0..<4:
                if regallocProductionPackedByte(
                       recipes.functionWords,
                       reloc.byteOffset + immediateByte) != 0:
                    return false
            relocIndex = relocIndex + 1
            continue
        if reloc.kind != contract.RegallocA64RelocPage21 ||
           reloc.byteOffset != reloc.wordIndex * 4 ||
           reloc.callOrdinal >= 0 || reloc.subIndex < 0 ||
           relocIndex + 1 >= recipes.functionRelocs.len:
            return false
        let pageOff = recipes.functionRelocs[relocIndex + 1]
        if pageOff.kind != contract.RegallocA64RelocPageOff12 ||
           pageOff.wordIndex != reloc.wordIndex + 1 ||
           pageOff.byteOffset != reloc.byteOffset + 4 ||
           pageOff.callOrdinal >= 0 ||
           pageOff.opIndex != reloc.opIndex ||
           pageOff.subIndex != reloc.subIndex ||
           pageOff.targetSymbol != reloc.targetSymbol:
            return false
        relocIndex = relocIndex + 2
    return true

@borrows
fn RegallocProductionEmissionRelocsMatchBodyIr(
        targetTriple: str,
        bodyIR: var coreir.BodyIR,
        resolvedCallTargetSymbols: var str[],
        recipes: var contract.RegallocA64FunctionRecipes): bool =
    return regallocProductionRelocsValid(
        targetTriple, bodyIR, resolvedCallTargetSymbols, recipes)

@borrows
fn regallocProductionBindResolvedCallRelocs(
        recipes: var contract.RegallocA64FunctionRecipes,
        resolvedCallTargetSymbols: var str[]): bool =
    for relocIndex in 0..<recipes.functionRelocs.len:
        if recipes.functionRelocs[relocIndex].kind !=
               contract.RegallocA64RelocCall26 &&
           recipes.functionRelocs[relocIndex].kind !=
               contract.RegallocMachineRelocPcRel32 &&
           recipes.functionRelocs[relocIndex].kind !=
               contract.RegallocMachineRelocRiscvCall:
            continue
        let callOrdinal = recipes.functionRelocs[relocIndex].callOrdinal
        if callOrdinal < 0 ||
           callOrdinal >= resolvedCallTargetSymbols.len ||
           len(resolvedCallTargetSymbols[callOrdinal]) <= 0:
            return false
        recipes.functionRelocs[relocIndex].targetSymbol =
            strings.CloneStr(resolvedCallTargetSymbols[callOrdinal])
    for recipeIndex in 0..<recipes.recipes.len:
        for relocIndex in 0..<recipes.recipes[recipeIndex].relocs.len:
            if recipes.recipes[recipeIndex].relocs[relocIndex].kind !=
                   contract.RegallocA64RelocCall26 &&
               recipes.recipes[recipeIndex].relocs[relocIndex].kind !=
                   contract.RegallocMachineRelocPcRel32 &&
               recipes.recipes[recipeIndex].relocs[relocIndex].kind !=
                   contract.RegallocMachineRelocRiscvCall:
                continue
            let callOrdinal =
                recipes.recipes[recipeIndex].relocs[relocIndex].callOrdinal
            if callOrdinal < 0 ||
               callOrdinal >= resolvedCallTargetSymbols.len ||
               len(resolvedCallTargetSymbols[callOrdinal]) <= 0:
                return false
            recipes.recipes[recipeIndex].relocs[relocIndex].targetSymbol =
                strings.CloneStr(resolvedCallTargetSymbols[callOrdinal])
    for fragmentIndex in 0..<recipes.machineFragments.len:
        for relocIndex in 0..<recipes.machineFragments[fragmentIndex].relocs.len:
            if recipes.machineFragments[fragmentIndex].relocs[relocIndex].kind !=
                   contract.RegallocA64RelocCall26 &&
               recipes.machineFragments[fragmentIndex].relocs[relocIndex].kind !=
                   contract.RegallocMachineRelocPcRel32 &&
               recipes.machineFragments[fragmentIndex].relocs[relocIndex].kind !=
                   contract.RegallocMachineRelocRiscvCall:
                continue
            let callOrdinal =
                recipes.machineFragments[fragmentIndex].relocs[relocIndex].callOrdinal
            if callOrdinal < 0 ||
               callOrdinal >= resolvedCallTargetSymbols.len ||
               len(resolvedCallTargetSymbols[callOrdinal]) <= 0:
                return false
            recipes.machineFragments[fragmentIndex].relocs[relocIndex].targetSymbol =
                strings.CloneStr(resolvedCallTargetSymbols[callOrdinal])
    return true

@borrows
fn regallocProductionBuildDataSymbolProjection(
        bodyIR: var coreir.BodyIR,
        symbolName: str,
        resolvedDataTargetSymbols: var str[],
        sourceBodyIrSha256: str,
        projection: var RegallocProductionDataSymbolProjection): bool =
    if len(sourceBodyIrSha256) != 64 || len(symbolName) <= 0 ||
       (resolvedDataTargetSymbols.len != 0 &&
        resolvedDataTargetSymbols.len != bodyIR.localSlots.len):
        return false
    for slotIndex in 0..<bodyIR.localSlots.len:
        let globalSlot =
            bodyIR.localSlots[slotIndex].placeKind ==
                coreir.BodyPlaceGlobalAddressTag
        if globalSlot &&
           (resolvedDataTargetSymbols.len != bodyIR.localSlots.len ||
            len(resolvedDataTargetSymbols[slotIndex]) <= 0):
            return false
        if !globalSlot &&
           resolvedDataTargetSymbols.len == bodyIR.localSlots.len &&
           len(resolvedDataTargetSymbols[slotIndex]) > 0:
            return false
    for literalIndex in 0..<bodyIR.cstringLiterals.len:
        if bodyIR.cstringLiterals[literalIndex].id != literalIndex:
            return false

    projection.sourceLocalSlotLenBefore = bodyIR.localSlots.len
    projection.sourceLocalSlotCapBefore = bodyIR.localSlots.cap
    projection.sourceCStringLenBefore = bodyIR.cstringLiterals.len
    projection.sourceCStringCapBefore = bodyIR.cstringLiterals.cap
    let sourceBodyIrCid =
        layout.FixedBytes32FromHex(sourceBodyIrSha256)
    if !IsOk(sourceBodyIrCid):
        return false
    projection.sourceBodyIrIngressCidBefore =
        layout.FixedBytes32Copy(Value(sourceBodyIrCid))

    # These are the only mutable symbol carriers required by AArch64 data
    # relocations. Reserve both SoA columns once; the BodyIR remains borrowed.
    if bodyIR.localSlots.len > 0:
        seqs.reserve(projection.slotDataSymbols, bodyIR.localSlots.len)
    if bodyIR.cstringLiterals.len > 0:
        seqs.reserve(
            projection.cstringDataSymbols,
            bodyIR.cstringLiterals.len)
    for slotIndex in 0..<bodyIR.localSlots.len:
        if bodyIR.localSlots[slotIndex].placeKind ==
           coreir.BodyPlaceGlobalAddressTag:
            let target = resolvedDataTargetSymbols[slotIndex]
            add(projection.slotDataSymbols, strings.CloneStr(target))
            projection.retainedManagedStringValueCount =
                projection.retainedManagedStringValueCount + 1
            projection.retainedManagedStringBytes =
                projection.retainedManagedStringBytes + int64(len(target))
        else:
            add(projection.slotDataSymbols, "")
    for literalIndex in 0..<bodyIR.cstringLiterals.len:
        let literal = bodyIR.cstringLiterals[literalIndex]
        var projectedSymbol: str
        if len(literal.dataLabel) > 0:
            projectedSymbol = strings.CloneStr(literal.dataLabel)
        else:
            projectedSymbol =
                Fmt"{symbolName}__cheng_cstring_{strings.IntToStr(literalIndex)}"
        projection.retainedManagedStringValueCount =
            projection.retainedManagedStringValueCount + 1
        projection.retainedManagedStringBytes =
            projection.retainedManagedStringBytes +
                int64(len(projectedSymbol))
        add(projection.cstringDataSymbols, projectedSymbol)
    if projection.slotDataSymbols.len != bodyIR.localSlots.len ||
       projection.slotDataSymbols.cap < projection.slotDataSymbols.len ||
       projection.cstringDataSymbols.len != bodyIR.cstringLiterals.len ||
       projection.cstringDataSymbols.cap <
           projection.cstringDataSymbols.len:
        seqs.freeSeqStrRelease(projection.slotDataSymbols)
        seqs.freeSeqStrRelease(projection.cstringDataSymbols)
        return false
    if projection.slotDataSymbols.cap > 0:
        projection.retainedBufferCount =
            projection.retainedBufferCount + 1
        projection.retainedColumnCapacityBytes =
            projection.retainedColumnCapacityBytes +
            int64(projection.slotDataSymbols.cap) * int64(sizeof(str))
    if projection.cstringDataSymbols.cap > 0:
        projection.retainedBufferCount =
            projection.retainedBufferCount + 1
        projection.retainedColumnCapacityBytes =
            projection.retainedColumnCapacityBytes +
            int64(projection.cstringDataSymbols.cap) * int64(sizeof(str))
    return true

fn regallocProductionReleaseDataSymbolProjection(
        projection: var RegallocProductionDataSymbolProjection,
        sourceLocalSlotLenAfter: int32,
        sourceLocalSlotCapAfter: int32,
        sourceCStringLenAfter: int32,
        sourceCStringCapAfter: int32,
        sourceBodyIrIngressCidAfter: layout.FixedBytes32,
        sourceBodyIrIngressCidAfterValid: bool,
        receipt: var RegallocProductionDataSymbolProjectionReceipt) =
    receipt.sourceLocalSlotLenBefore =
        projection.sourceLocalSlotLenBefore
    receipt.sourceLocalSlotCapBefore =
        projection.sourceLocalSlotCapBefore
    receipt.sourceCStringLenBefore = projection.sourceCStringLenBefore
    receipt.sourceCStringCapBefore = projection.sourceCStringCapBefore
    receipt.sourceBodyIrIngressCidBefore =
        layout.FixedBytes32Copy(
            projection.sourceBodyIrIngressCidBefore)
    receipt.slotProjectionRows = projection.slotDataSymbols.len
    receipt.slotProjectionCapacity = projection.slotDataSymbols.cap
    receipt.cstringProjectionRows = projection.cstringDataSymbols.len
    receipt.cstringProjectionCapacity = projection.cstringDataSymbols.cap
    receipt.retainedBufferCount = projection.retainedBufferCount
    receipt.retainedColumnCapacityBytes =
        projection.retainedColumnCapacityBytes
    receipt.retainedManagedStringValueCount =
        projection.retainedManagedStringValueCount
    receipt.retainedManagedStringBytes =
        projection.retainedManagedStringBytes

    receipt.releasedBufferCount = projection.retainedBufferCount
    receipt.releasedColumnCapacityBytes =
        projection.retainedColumnCapacityBytes
    receipt.releasedManagedStringValueCount =
        projection.retainedManagedStringValueCount
    receipt.releasedManagedStringBytes =
        projection.retainedManagedStringBytes
    # [wall104b] ORC accounting alignment: charge the release window with the
    # same units the window can actually release. A symbol row dispatches a
    # COUNTED heap release event only while it still owns a registry-live
    # payload here (memRefCount > 0); payloads outside the ORC registry
    # (kernel-driver linked string constructors among them) release as a
    # silent runtime no-op and can never produce a counted event, and rows
    # handed over to the adapter arrive empty. The floor therefore counts
    # registry-live due rows captured immediately before the window plus the
    # seq buffer releases (one per non-nil column buffer, unconditional in
    # every non-crashing run); the buffer finalize leg stays under
    # physicalFreeCount. Row destruction itself stays proven by
    # storageReleased. Per-row evidence for the reject diagnostic is captured
    # before the first release call.
    var slotDueRows: int32
    var cstringDueRows: int32
    var rowEvidence = ""
    if projection.retainedManagedStringValueCount > 0:
        rowEvidence = "rows"
        for rowIndex in 0..<projection.slotDataSymbols.len:
            let row = projection.slotDataSymbols[rowIndex]
            let rowLen = system.StrLenFast(row)
            let rowData = system.StrDataPtr(row)
            var rowRc: int32
            if rowData != nil:
                rowRc = system.memRefCount(rowData)
            var rowReleased: int32
            if rowData == nil:
                rowReleased = 1
            if rowLen > 0 && rowRc > 0:
                slotDueRows = slotDueRows + 1
            rowEvidence =
                Fmt"{rowEvidence}|s{rowIndex}:{rowLen}:{rowReleased}:{rowRc}"
        for literalIndex in 0..<projection.cstringDataSymbols.len:
            let row = projection.cstringDataSymbols[literalIndex]
            let rowLen = system.StrLenFast(row)
            let rowData = system.StrDataPtr(row)
            var rowRc: int32
            if rowData != nil:
                rowRc = system.memRefCount(rowData)
            var rowReleased: int32
            if rowData == nil:
                rowReleased = 1
            if rowLen > 0 && rowRc > 0:
                cstringDueRows = cstringDueRows + 1
            rowEvidence =
                Fmt"{rowEvidence}|c{literalIndex}:{rowLen}:{rowReleased}:{rowRc}"
    receipt.retainedManagedStringDueReleaseCount = slotDueRows + cstringDueRows
    receipt.dataSymbolRowEvidence = rowEvidence
    let physicalFreeCountBefore = system.memFreeCount()
    let orcSlotColumnBefore = system.memReleaseCount()
    seqs.freeSeqStrRelease(projection.slotDataSymbols)
    receipt.orcSlotColumnReleaseCount =
        system.memReleaseCount() - orcSlotColumnBefore
    let orcCStringColumnBefore = system.memReleaseCount()
    seqs.freeSeqStrRelease(projection.cstringDataSymbols)
    receipt.orcCStringColumnReleaseCount =
        system.memReleaseCount() - orcCStringColumnBefore
    receipt.orcReleaseCount =
        receipt.orcSlotColumnReleaseCount +
        receipt.orcCStringColumnReleaseCount
    receipt.physicalFreeCount =
        system.memFreeCount() - physicalFreeCountBefore
    receipt.storageReleased =
        projection.slotDataSymbols.len == 0 &&
        projection.slotDataSymbols.cap == 0 &&
        projection.cstringDataSymbols.len == 0 &&
        projection.cstringDataSymbols.cap == 0

    receipt.sourceLocalSlotLenAfter = sourceLocalSlotLenAfter
    receipt.sourceLocalSlotCapAfter = sourceLocalSlotCapAfter
    receipt.sourceCStringLenAfter = sourceCStringLenAfter
    receipt.sourceCStringCapAfter = sourceCStringCapAfter
    receipt.sourceBodyIrIngressCidAfter =
        layout.FixedBytes32Copy(sourceBodyIrIngressCidAfter)
    receipt.valid =
        receipt.storageReleased &&
        receipt.slotProjectionRows == receipt.sourceLocalSlotLenBefore &&
        receipt.slotProjectionCapacity >= receipt.slotProjectionRows &&
        receipt.cstringProjectionRows == receipt.sourceCStringLenBefore &&
        receipt.cstringProjectionCapacity >= receipt.cstringProjectionRows &&
        receipt.sourceLocalSlotLenBefore ==
            receipt.sourceLocalSlotLenAfter &&
        receipt.sourceLocalSlotCapBefore ==
            receipt.sourceLocalSlotCapAfter &&
        receipt.sourceCStringLenBefore == receipt.sourceCStringLenAfter &&
        receipt.sourceCStringCapBefore == receipt.sourceCStringCapAfter &&
        sourceBodyIrIngressCidAfterValid &&
        layout.FixedBytes32Equal(
            receipt.sourceBodyIrIngressCidBefore,
            receipt.sourceBodyIrIngressCidAfter) &&
        receipt.retainedBufferCount == receipt.releasedBufferCount &&
        receipt.retainedColumnCapacityBytes ==
            receipt.releasedColumnCapacityBytes &&
        receipt.retainedManagedStringValueCount ==
            receipt.releasedManagedStringValueCount &&
        receipt.retainedManagedStringBytes ==
            receipt.releasedManagedStringBytes &&
        receipt.physicalFreeCount >=
            int64(receipt.retainedBufferCount) &&
        receipt.orcReleaseCount >=
            int64(receipt.retainedManagedStringDueReleaseCount) +
                int64(receipt.retainedBufferCount)

@borrows
fn regallocProductionPlanAndRecipesInto(
        targetTriple: str,
        bodyIR: var coreir.BodyIR,
        symbolName: str,
        resolvedDataTargetSymbols: var str[],
        out: var RegallocProductionFunctionEmission): bool =
    var constraints =
        contract.CodegenUnitConstraintSet(targetTriple)
    out.plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        bodyIR, constraints)
    out.bodyIrSha256 = out.plan.bodyIrIngressSha256
    if len(out.bodyIrSha256) != 64 || !out.plan.valid ||
       !alloc.RegallocSinglePassValuePlanValidate(out.plan) ||
       !alloc.RegallocSinglePassValuePlanMatchesBodyIrIngress(
           bodyIR, out.plan):
        var failGate = "unknown"
        if len(out.bodyIrSha256) != 64:
            failGate = "sha_len"
        elif !out.plan.valid:
            failGate = "plan_valid"
        elif !alloc.RegallocSinglePassValuePlanValidate(out.plan):
            failGate = "validate"
        else:
            failGate = "matches"
        # [wall126b] 判词富化（reject 路径专用，绿路径零成本）：plan 失败时
        # 只能看到 plan.errorCode/errorDetail 两列，CFG 层的
        # errorBlock/errorSlot/errorDetail 与块/term 布局全列不可见，
        # 无法定位分区缺陷块。此处在 reject 路径只读重算 canonical facts，
        # 把失败子检查与全块表/全 term 表一次带入判词。
        if failGate == "plan_valid":
            var diagAccess = bodyaccess.BodyIrAccessDecode(bodyIR)
            var diagAnalysis = cfg.BodyIrCfgAnalyze(bodyIR, diagAccess)
            var diagBlockDump = ""
            for diagBlockIndex in 0..<bodyIR.blocks.len:
                let diagBlock = bodyIR.blocks[diagBlockIndex]
                diagBlockDump = Fmt"{diagBlockDump}|b{diagBlockIndex}:id={diagBlock.id}:os={diagBlock.opStart}:oc={diagBlock.opCount}:t={diagBlock.termIndex}"
            var diagTermDump = ""
            for diagTermIndex in 0..<bodyIR.terms.len:
                let diagTerm = bodyIR.terms[diagTermIndex]
                diagTermDump = Fmt"{diagTermDump}|t{diagTermIndex}:k={diagTerm.kind}:tb={diagTerm.trueBlock}:fb={diagTerm.falseBlock}"
            os.WriteLine(
                os.GetStderr(),
                Fmt"phase=regalloc_plan_cfg_diag code={diagAnalysis.errorCode} block={diagAnalysis.errorBlock} slot={diagAnalysis.errorSlot} detail={diagAnalysis.errorDetail} ops={bodyIR.ops.len} blocks={bodyIR.blocks.len} terms={bodyIR.terms.len} bd={diagBlockDump} td={diagTermDump}")
        os.WriteLine(
            os.GetStderr(),
            Fmt"phase=regalloc_plan_invalid gate={failGate} sha_len={len(out.bodyIrSha256)} valid={out.plan.valid} frozen={out.plan.frozen} calls={bodyIR.callSequence.len} detail={out.plan.errorDetail}")
        regallocProductionEmitFail(
            out, RegallocProductionEmitPlanInvalid,
            out.plan.errorDetail)
        return false
    # B1（2026-08-25）：triple → codegen unit 查表派发（蓝图 3.0/3.2）。
    # 显式枚举四族生产 triple，缺 triple / 缺单元注册一律显式失败；
    # 不保留 else=arm64 默认臂（蓝图红线）。
    var unitId: int32 = contract.CodegenUnitInvalid
    if targetTriple == artifacts.RegallocProductionTargetX64Linux:
        unitId = contract.CodegenUnitX64
    elif artifacts.RegallocProductionTargetIsRv32(targetTriple):
        unitId = contract.CodegenUnitRv32
    elif artifacts.RegallocProductionTargetIsRiscv(targetTriple):
        unitId = contract.CodegenUnitRv64
    elif artifacts.RegallocProductionTargetIsA64(targetTriple):
        unitId = contract.CodegenUnitA64
    else:
        regallocProductionEmitFail(
            out, RegallocProductionEmitTargetUnsupported, -1)
        return false
    if !contract.CodegenUnitPrepareRecipesRegistered(unitId):
        regallocProductionEmitFail(
            out, RegallocProductionEmitTargetUnsupported, unitId)
        return false
    var dataSymbolProjection: RegallocProductionDataSymbolProjection
    if contract.CodegenUnitUsesDataSymbolProjection(unitId) &&
       !regallocProductionBuildDataSymbolProjection(
           bodyIR, symbolName, resolvedDataTargetSymbols,
           out.plan.bodyIrIngressSha256,
           dataSymbolProjection):
        regallocProductionEmitFail(
            out, RegallocProductionEmitDataTargetInvalid,
            resolvedDataTargetSymbols.len)
        return false
    # symbolName is a borrowed view (this fn is @borrows) but the
    # adapter prepare entries carry a plain str formal the surface
    # cannot annotate; materialize one owned copy at the boundary
    # (same pattern as parser.cheng CloneStr for non-var formals).
    let symbolNameOwned = strings.CloneStr(symbolName)
    # B2 同形（codegen_writer_units 门面裁定）：frozen stage3 下托管对象过 fn
    # 值槽间接调用在返回/释放期 registry_miss（实锤：本分发旧走契约 fn 槽返回
    # RegallocA64FunctionRecipes 时 ORC abort）。按 unitId 直调 adapter
    # 模块入口，零间接调用；上方 triple 枚举与注册硬门不变，unitId 必中一臂。
    # 值传 str 过参即消费（stage3 方言），门面内按臂各持一份 CloneStr。
    # B8（2026-08-29）：四臂直调经 shared-format 门面 codegen_regalloc_adapter_units
    # 收编（同 B2/B7 门面形态，零间接调用），本文件零 arch import。
    out.recipes = radapter.CodegenRegallocAdapterUnitPrepareFunctionRecipes(
        unitId, bodyIR, out.plan, strings.CloneStr(symbolNameOwned),
        out.encoderSourceRow, out.encoderSourceCid,
        dataSymbolProjection.slotDataSymbols,
        dataSymbolProjection.cstringDataSymbols)
    if contract.CodegenUnitUsesDataSymbolProjection(unitId):
        let sourceBodyIrSha256After =
            alloc.RegallocSinglePassBodyIrIngressSha256(bodyIR)
        let sourceBodyIrCidAfter =
            layout.FixedBytes32FromHex(sourceBodyIrSha256After)
        var sourceBodyIrIngressCidAfter: layout.FixedBytes32
        if IsOk(sourceBodyIrCidAfter):
            sourceBodyIrIngressCidAfter =
                layout.FixedBytes32Copy(Value(sourceBodyIrCidAfter))
        regallocProductionReleaseDataSymbolProjection(
            dataSymbolProjection,
            bodyIR.localSlots.len,
            bodyIR.localSlots.cap,
            bodyIR.cstringLiterals.len,
            bodyIR.cstringLiterals.cap,
            sourceBodyIrIngressCidAfter,
            IsOk(sourceBodyIrCidAfter),
            out.dataSymbolProjectionReceipt)
        if !out.dataSymbolProjectionReceipt.valid:
            # [wall104b] Reject-path accounting evidence (green paths stay
            # silent): due rows vs dispatched release events, split per
            # column, plus the per-row capture taken before the window.
            os.WriteLine(
                os.GetStderr(),
                Fmt"phase=regalloc_dsp_receipt_invalid rows={out.dataSymbolProjectionReceipt.slotProjectionRows} crows={out.dataSymbolProjectionReceipt.cstringProjectionRows} rbuf={out.dataSymbolProjectionReceipt.retainedBufferCount} rmvc={out.dataSymbolProjectionReceipt.retainedManagedStringValueCount} due={out.dataSymbolProjectionReceipt.retainedManagedStringDueReleaseCount} orc={out.dataSymbolProjectionReceipt.orcReleaseCount} orc_slot={out.dataSymbolProjectionReceipt.orcSlotColumnReleaseCount} orc_cstr={out.dataSymbolProjectionReceipt.orcCStringColumnReleaseCount} free={out.dataSymbolProjectionReceipt.physicalFreeCount} storage={out.dataSymbolProjectionReceipt.storageReleased} rows_slot={out.dataSymbolProjectionReceipt.slotProjectionRows} evidence={out.dataSymbolProjectionReceipt.dataSymbolRowEvidence}")
            regallocProductionEmitFail(
                out, RegallocProductionEmitDataTargetInvalid,
                out.dataSymbolProjectionReceipt.slotProjectionRows)
            return false
    if !out.recipes.valid || out.recipes.functionWords.len <= 0 ||
       out.recipes.functionWords.len > 536870911 ||
       (contract.CodegenUnitRequiresPlanIngressPostCheck(unitId) &&
        !alloc.RegallocSinglePassValuePlanMatchesBodyIrIngress(
            bodyIR, out.plan)):
        regallocProductionEmitFail(
            out, RegallocProductionEmitRecipeInvalid,
            out.recipes.errorDetail)
        return false
    return true

@borrows
fn RegallocProductionEmitFunction(
        targetTriple: str,
        bodyIR: var coreir.BodyIR,
        symbolName: str,
        symbolByteStart: int32,
        resolvedCallTargetSymbols: var str[],
        resolvedDataTargetSymbols: var str[],
        functionIrIndex: int32,
        functionKind: int32): RegallocProductionFunctionEmission =
    return RegallocProductionEmitFunctionWithEncoderAuthority(
        targetTriple, bodyIR, symbolName, symbolByteStart,
        resolvedCallTargetSymbols, resolvedDataTargetSymbols,
        functionIrIndex, functionKind, -1, layout.FixedBytes32())

@borrows
fn RegallocProductionEmitFunctionWithEncoderAuthority(
        targetTriple: str,
        bodyIR: var coreir.BodyIR,
        symbolName: str,
        symbolByteStart: int32,
        resolvedCallTargetSymbols: var str[],
        resolvedDataTargetSymbols: var str[],
        functionIrIndex: int32,
        functionKind: int32,
        encoderSourceRow: int32,
        encoderSourceCid: layout.FixedBytes32):
        RegallocProductionFunctionEmission =
    var out: RegallocProductionFunctionEmission
    # Cross-module default field initializers do not materialize reliably.
    # State the invalid identity sentinels in the canonical constructor path.
    out.errorDetail = -1
    out.debugFunctionId = -1
    out.encoderSourceRow = encoderSourceRow
    out.encoderSourceCid = layout.FixedBytes32Copy(encoderSourceCid)
    out.recipeOrigin =
        artifacts.RegallocProductionRecipeOriginBodyIrAdapter
    if !artifacts.RegallocProductionTargetUsesCanonicalRegalloc(
           targetTriple):
        out.targetTriple = strings.CloneStr(targetTriple)
        regallocProductionEmitFail(
            out, RegallocProductionEmitTargetUnsupported, -1)
        return out
    var snapshotTarget: str
    if targetTriple ==
       artifacts.RegallocProductionTargetA64Darwin:
        snapshotTarget =
            artifacts.RegallocProductionTargetA64Darwin
    elif targetTriple ==
         artifacts.RegallocProductionTargetA64Linux:
        snapshotTarget =
            artifacts.RegallocProductionTargetA64Linux
    elif targetTriple ==
         artifacts.RegallocProductionTargetX64Linux:
        snapshotTarget =
            artifacts.RegallocProductionTargetX64Linux
    elif artifacts.RegallocProductionTargetIsRiscv(targetTriple):
        snapshotTarget = strings.CloneStr(targetTriple)
    else:
        out.targetTriple = strings.CloneStr(targetTriple)
        regallocProductionEmitFail(
            out, RegallocProductionEmitTargetUnsupported, -1)
        return out
    out.targetTriple = strings.CloneStr(targetTriple)
    if !artifacts.RegallocProductionFunctionIdentityValid(
           functionIrIndex, functionKind) ||
       len(symbolName) <= 0 || symbolByteStart < 0 ||
       symbolByteStart % 4 != 0:
        regallocProductionEmitFail(
            out, RegallocProductionEmitSymbolInvalid, symbolByteStart)
        return out
    if !alloc.RegallocSinglePassBodyIrCanonicalIngressValid(bodyIR):
        regallocProductionEmitFail(
            out, RegallocProductionEmitPlanInvalid,
            bodyIR.blocks.len)
        return out
    cleanup.CleanupBodyIrManagedAuthorityFinalStrictValidate(bodyIR)
    if !regallocProductionPlanAndRecipesInto(
           out.targetTriple, bodyIR, symbolName,
           resolvedDataTargetSymbols, out):
        return out
    if resolvedCallTargetSymbols.len != bodyIR.callSequence.len ||
       !regallocProductionBindResolvedCallRelocs(
           out.recipes, resolvedCallTargetSymbols):
        regallocProductionEmitFail(
            out, RegallocProductionEmitCallTargetInvalid,
            resolvedCallTargetSymbols.len)
        return out
    if !regallocProductionRelocsValid(
           out.targetTriple, bodyIR,
           resolvedCallTargetSymbols, out.recipes):
        regallocProductionEmitFail(
            out, RegallocProductionEmitRelocInvalid, 0)
        return out
    if !artifacts.RegallocProductionBindMachineRecipe(
           out.plan, out.recipes):
        regallocProductionEmitFail(
            out, RegallocProductionEmitRecipeInvalid,
            out.plan.errorDetail)
        return out
    var snapshotMetadata: artifacts.RegallocProductionSnapshotMetadata
    snapshotMetadata.fixtureSourceSha256 = alloc.RegallocValueEmptySha256
    snapshotMetadata.sourceManifestSha256 = alloc.RegallocValueEmptySha256
    snapshotMetadata.driverSha256 = alloc.RegallocValueEmptySha256
    snapshotMetadata.target = snapshotTarget
    var snapshotFunction: artifacts.RegallocProductionSnapshotFunction
    snapshotFunction.symbol = strings.CloneStr(symbolName)
    snapshotFunction.functionIrIndex = functionIrIndex
    snapshotFunction.functionKind = functionKind
    snapshotFunction.bodyIrSha256 = out.plan.bodyIrIngressSha256
    snapshotFunction.recipeOrigin = out.recipeOrigin
    snapshotFunction.plan = out.plan
    snapshotFunction.recipes = out.recipes
    var snapshotFunctions: artifacts.RegallocProductionSnapshotFunction[]
    add(snapshotFunctions, snapshotFunction)
    let snapshotArtifact =
        artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
            snapshotMetadata, snapshotFunctions)
    if !snapshotArtifact.valid ||
       len(snapshotArtifact.payload) <= 0 ||
       len(snapshotArtifact.payloadSha256) != 64:
        regallocProductionEmitFail(
            out, RegallocProductionEmitSnapshotInvalid,
            snapshotArtifact.errorCode)
        return out
    var emissionSymbol = snapshotFunctions[0].symbol
    out.frozenSnapshotPayload = snapshotArtifact.payload
    out.frozenSnapshotPayloadSha256 = snapshotArtifact.payloadSha256
    var actionFragmentIndexes: int32[]
    if !regallocProductionActionFragmentIndexBuild(
           out.recipes, out.plan.actions.len,
           actionFragmentIndexes):
        regallocProductionEmitFail(
            out, RegallocProductionEmitActionAmbiguous, -1)
        return out
    let symbolByteLength = out.recipes.functionWords.len * 4
    if symbolByteStart > 2147483647 - symbolByteLength:
        regallocProductionEmitFail(
            out, RegallocProductionEmitSymbolInvalid,
            symbolByteStart)
        return out
    if !alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           out.plan, emissionSymbol,
           symbolByteStart, symbolByteLength):
        regallocProductionEmitFail(
            out, RegallocProductionEmitSymbolInvalid,
            out.plan.errorDetail)
        return out
    for actionIndex in 0..<out.plan.actions.len:
        var ticket: alloc.RegallocValueActionTicket
        var action: alloc.RegallocValueAction
        if !alloc.RegallocSinglePassValuePlanActionAt(
               out.plan, actionIndex, action, ticket):
            regallocProductionEmitFail(
                out, RegallocProductionEmitActionMissing, actionIndex)
            return out
        let bindingKind = alloc.RegallocSinglePassValueActionBindingKind(
            action.kind)
        var machineByteStart: int32
        var machineByteLength: int32
        var machineSha256 = alloc.RegallocValueEmptySha256
        if bindingKind == alloc.RegallocValueBindingMachine:
            if action.consumerOrdinal < 0 ||
               action.consumerOrdinal >= actionFragmentIndexes.len ||
               actionFragmentIndexes[action.consumerOrdinal] < 0:
                regallocProductionEmitFail(
                    out, RegallocProductionEmitActionAmbiguous,
                    actionIndex)
                return out
            let fragmentIndex =
                actionFragmentIndexes[action.consumerOrdinal]
            let fragment = out.recipes.machineFragments[fragmentIndex]
            if fragment.wordStart < 0 || fragment.wordCount <= 0 ||
               fragment.wordStart >
                   out.recipes.functionWords.len - fragment.wordCount:
                regallocProductionEmitFail(
                    out, RegallocProductionEmitActionMissing,
                    actionIndex)
                return out
            machineByteStart = symbolByteStart + fragment.wordStart * 4
            machineByteLength = fragment.wordCount * 4
            machineSha256 = regallocProductionWordsSha256(
                out.recipes.functionWords,
                fragment.wordStart,
                fragment.wordCount)
            if len(machineSha256) != 64:
                regallocProductionEmitFail(
                    out, RegallocProductionEmitActionAckFailed,
                    actionIndex)
                return out
        elif bindingKind != alloc.RegallocValueBindingStructural:
            regallocProductionEmitFail(
                out, RegallocProductionEmitActionMissing, actionIndex)
            return out
        if !alloc.RegallocSinglePassValuePlanAck(
               out.plan, ticket, machineByteStart,
               machineByteLength, machineSha256):
            regallocProductionEmitFail(
                out, RegallocProductionEmitActionAckFailed,
                actionIndex)
            return out
    let symbolSha256 = regallocProductionWordsSha256(
        out.recipes.functionWords, 0, out.recipes.functionWords.len)
    if len(symbolSha256) != 64 ||
       !alloc.RegallocSinglePassValuePlanSealEmissionSymbol(
           out.plan, symbolSha256) ||
       !alloc.RegallocSinglePassValuePlanFinalize(out.plan) ||
       !alloc.RegallocSinglePassValuePlanReceipt(out.plan, out.receipt):
        regallocProductionEmitFail(
            out, RegallocProductionEmitFinalizeFailed,
            out.plan.errorDetail)
        return out
    if !regallocProductionBuildDebugMachineFragments(bodyIR, out):
        regallocProductionEmitFail(
            out, RegallocProductionEmitFinalizeFailed,
            out.recipes.machineFragments.len)
        return out
    if !regallocProductionBuildDeferEmissionReceipts(
           bodyIR, out):
        regallocProductionEmitFail(
            out, RegallocProductionEmitFinalizeFailed,
            bodyIR.deferActionCids.len)
        return out
    # The frozen recipe owns both payload columns. The emission publishes only
    # immutable int32 ranges, so there is one physical owner and one release.
    out.publishedWordStart = 0
    out.publishedWordCount = out.recipes.functionWords.len
    out.publishedRelocStart = 0
    out.publishedRelocCount = out.recipes.functionRelocs.len
    out.valid = true
    if !RegallocProductionEmissionPublishedPayloadExact(out):
        regallocProductionEmitFail(
            out, RegallocProductionEmitFinalizeFailed,
            out.publishedWordCount)
    return out
