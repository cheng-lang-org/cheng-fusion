# codegen_linker_units.cheng —— linker 单元直调聚合门面（B7 表键侧）
#
# 蓝图 2.3「coff_pe_builtin 分支调 coff_object_linker.CoffLinkExeA64 契约表
# 同槽位收编」落地：unitKey 常量 CodegenLinkerUnitA64Coff 在 codegen_contract
# （kernel，B5+B7 节）；本模块按 unitKey switch 直调 PE/COFF aarch64 内建链接器
# ——零间接调用，字节路径与原 kernel 直调逐字节相同；缺组合=显式 Err（文案带
# unitKey），无 else 兜底。
#
# 独立成文件而不并入 codegen_writer_units 的原因：closure 间接边不增铁律——
# codegen_writer_units 被 native_object_emission_plan 消费，后者基线不可达
# aarch64_encode；若 coff_object_linker 挂进 codegen_writer_units 的 import
# 面，native_object_emission_plan 将新增一条可达 arch 间接边。本模块仅被
# native_link_exec 消费（其基线已可达 aarch64_encode），挂接零新增间接边。
#
# 归属：shared-format（先例=codegen_writer_units B2）。riscv64 自链接臂仍留
# codegen_writer_units.LinkExeBuiltin（B2 既有接线，本批不动）。
import std/result
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/coff_object_linker

fn CodegenLinkerUnitLinkExeBuiltin(
        unitKey: int32,
        objPaths: str[],
        outputPath: str,
        target: str): Result[bool] =
    # coff_pe_builtin 自链接入口（native_link_exec 原 coff_object_linker
    # .CoffLinkExeA64 直调，B7 收编）。
    if unitKey == contract.CodegenLinkerUnitA64Coff:
        return coff_object_linker.CoffLinkExeA64(objPaths, outputPath, target)
    return Err[bool](Fmt" codegen linker unit unavailable: unitKey={unitKey}")
