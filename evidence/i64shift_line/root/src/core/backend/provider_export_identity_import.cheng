import std/seqs
import std/crypto/hash256
import cheng/std/bytes_layout as layout
import cheng/core/runtime/arena as arenamod
import cheng/core/backend/provider_export_identity_receipt as peir

const
    ProviderExportIdentityActualSetMagic = 0x50454153
    ProviderExportIdentityActualSetSchemaVersion = 1
    ProviderExportIdentityImportMagic = 0x50454949
    ProviderExportIdentityImportSchemaVersion = 1
    ProviderExportIdentityImportOwnedStorageColumnCount = 6

type
    ProviderExportIdentityActualSet =
        schemaVersion: int32
        sealed: bool
        arena: arenamod.Arena
        providerRows: arenamod.ArenaArrayInt32
        sourceArtifactCids: layout.FixedBytes32[]
        compileReceiptCids: layout.FixedBytes32[]
        objectBytesCids: layout.FixedBytes32[]
        actualSetCid: layout.FixedBytes32

    ProviderExportIdentityImportReceipt =
        schemaVersion: int32
        sealed: bool
        arena: arenamod.Arena
        sourceProviderReceiptCid: layout.FixedBytes32
        sourceActualSetCid: layout.FixedBytes32
        sourceExportCount: int32

        # Canonical provider rows are in the source receipt row domain.
        providerRows: arenamod.ArenaArrayInt32
        providerExportStarts: arenamod.ArenaArrayInt32
        providerExportCounts: arenamod.ArenaArrayInt32
        providerSourceArtifactCids: layout.FixedBytes32[]
        providerCompileReceiptCids: layout.FixedBytes32[]
        providerObjectBytesCids: layout.FixedBytes32[]

        # Exactly one row for each finite bridge role, ordered by role kind.
        roleKinds: arenamod.ArenaArrayInt32
        roleProviderRows: arenamod.ArenaArrayInt32
        roleExportRows: arenamod.ArenaArrayInt32
        roleTypedFunctionRows: arenamod.ArenaArrayInt32
        roleProducerSourceRows: arenamod.ArenaArrayInt32
        roleProducerDeclarationRows: arenamod.ArenaArrayInt32
        roleProducerNodeRows: arenamod.ArenaArrayInt32
        roleProducerFactCids: layout.FixedBytes32[]
        roleInterfaceCids: layout.FixedBytes32[]

        receiptCid: layout.FixedBytes32

        terminalReleaseOwnerToken: layout.FixedBytes32
        terminalReleasedOwnedStorageColumnCount: int32
        terminalReleasedBufferCount: int32
        terminalReleasedBytes: int64
        terminalStorageReleased: bool
        terminalReleaseReceiptConsumed: bool

    ProviderExportIdentityImportReleaseReceipt =
        ownerToken: layout.FixedBytes32
        releasedOwnedStorageColumnCount: int32
        releasedBufferCount: int32
        releasedBytes: int64
        storageReleased: bool

@borrows
fn providerExportIdentityImportCidZero(
        value: layout.FixedBytes32): bool =
    return layout.FixedBytes32Equal(value, layout.FixedBytes32())

fn providerExportIdentityImportAppendU32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn providerExportIdentityImportAppendU64(
        buf: var layout.ByteBuf,
        value: int64) =
    layout.ByteBufAppendByte(buf, int32((value >> 56) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 48) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 40) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 32) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 24) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 16) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 8) & int64(255)))
    layout.ByteBufAppendByte(buf, int32(value & int64(255)))

fn ProviderExportIdentityActualSetInit(
        initialArenaCapacity: int32): ProviderExportIdentityActualSet =
    var out: ProviderExportIdentityActualSet
    var capacity = initialArenaCapacity
    if capacity < 128:
        capacity = 128
    out.schemaVersion = ProviderExportIdentityActualSetSchemaVersion
    out.arena = arenamod.ArenaInit(capacity)
    out.providerRows = arenamod.ArenaArrayInt32Init()
    return out

fn ProviderExportIdentityActualSetAppend(
        actuals: var ProviderExportIdentityActualSet,
        providerRow: int32,
        sourceArtifactCid: layout.FixedBytes32,
        compileReceiptCid: layout.FixedBytes32,
        objectBytesCid: layout.FixedBytes32): int32 =
    if actuals.sealed ||
       actuals.schemaVersion != ProviderExportIdentityActualSetSchemaVersion ||
       providerRow < 0 ||
       providerExportIdentityImportCidZero(sourceArtifactCid) ||
       providerExportIdentityImportCidZero(compileReceiptCid) ||
       providerExportIdentityImportCidZero(objectBytesCid):
        return -1
    let row = actuals.sourceArtifactCids.len
    arenamod.ArenaArrayInt32Add(
        actuals.arena, actuals.providerRows, providerRow)
    add(actuals.sourceArtifactCids, sourceArtifactCid)
    add(actuals.compileReceiptCids, compileReceiptCid)
    add(actuals.objectBytesCids, objectBytesCid)
    return row

@borrows
fn providerExportIdentityActualSetShapeValid(
        actuals: ProviderExportIdentityActualSet,
        err: var str): bool =
    let count = actuals.sourceArtifactCids.len
    if actuals.schemaVersion != ProviderExportIdentityActualSetSchemaVersion:
        err = " provider export identity import: actual schema invalid"
        return false
    if actuals.arena.capacityBytes <= 0 || actuals.arena.generation <= 0 ||
       actuals.providerRows.len != count || count <= 0 ||
       actuals.compileReceiptCids.len != count ||
       actuals.objectBytesCids.len != count:
        err = " provider export identity import: actual shape invalid"
        return false
    for row in 0..<count:
        if arenamod.ArenaArrayInt32Get(
               actuals.arena, actuals.providerRows, row) < 0 ||
           providerExportIdentityImportCidZero(
               actuals.sourceArtifactCids[row]) ||
           providerExportIdentityImportCidZero(
               actuals.compileReceiptCids[row]) ||
           providerExportIdentityImportCidZero(
               actuals.objectBytesCids[row]):
            err = " provider export identity import: actual row invalid"
            return false
    err = ""
    return true

@borrows
fn providerExportIdentityActualSetAppendBody(
        actuals: ProviderExportIdentityActualSet,
        buf: var layout.ByteBuf) =
    providerExportIdentityImportAppendU32(
        buf, ProviderExportIdentityActualSetMagic)
    providerExportIdentityImportAppendU32(buf, actuals.schemaVersion)
    providerExportIdentityImportAppendU32(
        buf, actuals.sourceArtifactCids.len)
    for row in 0..<actuals.sourceArtifactCids.len:
        providerExportIdentityImportAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                actuals.arena, actuals.providerRows, row))
        layout.ByteBufAppendFixed32(buf, actuals.sourceArtifactCids[row])
        layout.ByteBufAppendFixed32(buf, actuals.compileReceiptCids[row])
        layout.ByteBufAppendFixed32(buf, actuals.objectBytesCids[row])

@borrows
fn ProviderExportIdentityActualSetComputeCid(
        actuals: ProviderExportIdentityActualSet): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    providerExportIdentityActualSetAppendBody(actuals, buf)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn ProviderExportIdentityActualSetSealInto(
        actuals: var ProviderExportIdentityActualSet,
        err: var str): bool =
    if actuals.sealed ||
       !providerExportIdentityActualSetShapeValid(actuals, err):
        if actuals.sealed:
            err = " provider export identity import: actual seal state invalid"
        return false
    actuals.actualSetCid = ProviderExportIdentityActualSetComputeCid(actuals)
    if providerExportIdentityImportCidZero(actuals.actualSetCid):
        err = " provider export identity import: actual cid invalid"
        return false
    actuals.sealed = true
    err = ""
    return true

@borrows
fn ProviderExportIdentityActualSetStrictValidateInto(
        actuals: ProviderExportIdentityActualSet,
        err: var str): bool =
    if !actuals.sealed ||
       !providerExportIdentityActualSetShapeValid(actuals, err):
        if !actuals.sealed:
            err = " provider export identity import: actual set unsealed"
        return false
    if providerExportIdentityImportCidZero(actuals.actualSetCid) ||
       !layout.FixedBytes32Equal(
           actuals.actualSetCid,
           ProviderExportIdentityActualSetComputeCid(actuals)):
        err = " provider export identity import: actual set cid mismatch"
        return false
    err = ""
    return true

fn ProviderExportIdentityActualSetRelease(
        actuals: var ProviderExportIdentityActualSet) =
    arenamod.ArenaRelease(actuals.arena)
    seqs.freeSeq(actuals.sourceArtifactCids)
    seqs.freeSeq(actuals.compileReceiptCids)
    seqs.freeSeq(actuals.objectBytesCids)
    actuals.providerRows = arenamod.ArenaArrayInt32Init()
    actuals.schemaVersion = 0
    actuals.sealed = false
    actuals.actualSetCid = layout.FixedBytes32()

fn providerExportIdentityImportInit(
        initialArenaCapacity: int32): ProviderExportIdentityImportReceipt =
    var out: ProviderExportIdentityImportReceipt
    var capacity = initialArenaCapacity
    if capacity < 256:
        capacity = 256
    out.schemaVersion = ProviderExportIdentityImportSchemaVersion
    out.arena = arenamod.ArenaInit(capacity)
    out.providerRows = arenamod.ArenaArrayInt32Init()
    out.providerExportStarts = arenamod.ArenaArrayInt32Init()
    out.providerExportCounts = arenamod.ArenaArrayInt32Init()
    out.roleKinds = arenamod.ArenaArrayInt32Init()
    out.roleProviderRows = arenamod.ArenaArrayInt32Init()
    out.roleExportRows = arenamod.ArenaArrayInt32Init()
    out.roleTypedFunctionRows = arenamod.ArenaArrayInt32Init()
    out.roleProducerSourceRows = arenamod.ArenaArrayInt32Init()
    out.roleProducerDeclarationRows = arenamod.ArenaArrayInt32Init()
    out.roleProducerNodeRows = arenamod.ArenaArrayInt32Init()
    return out

@borrows
fn providerExportIdentityImportAppendBody(
        imported: ProviderExportIdentityImportReceipt,
        buf: var layout.ByteBuf) =
    providerExportIdentityImportAppendU32(buf, ProviderExportIdentityImportMagic)
    providerExportIdentityImportAppendU32(buf, imported.schemaVersion)
    layout.ByteBufAppendFixed32(buf, imported.sourceProviderReceiptCid)
    layout.ByteBufAppendFixed32(buf, imported.sourceActualSetCid)
    providerExportIdentityImportAppendU32(buf, imported.sourceExportCount)
    let providerCount = imported.providerSourceArtifactCids.len
    let roleCount = imported.roleProducerFactCids.len
    providerExportIdentityImportAppendU32(buf, providerCount)
    providerExportIdentityImportAppendU32(buf, roleCount)
    for providerRow in 0..<providerCount:
        providerExportIdentityImportAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                imported.arena, imported.providerRows, providerRow))
        providerExportIdentityImportAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                imported.arena, imported.providerExportStarts, providerRow))
        providerExportIdentityImportAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                imported.arena, imported.providerExportCounts, providerRow))
        layout.ByteBufAppendFixed32(
            buf, imported.providerSourceArtifactCids[providerRow])
        layout.ByteBufAppendFixed32(
            buf, imported.providerCompileReceiptCids[providerRow])
        layout.ByteBufAppendFixed32(
            buf, imported.providerObjectBytesCids[providerRow])
    for roleRow in 0..<roleCount:
        providerExportIdentityImportAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                imported.arena, imported.roleKinds, roleRow))
        providerExportIdentityImportAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                imported.arena, imported.roleProviderRows, roleRow))
        providerExportIdentityImportAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                imported.arena, imported.roleExportRows, roleRow))
        providerExportIdentityImportAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                imported.arena, imported.roleTypedFunctionRows, roleRow))
        providerExportIdentityImportAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                imported.arena, imported.roleProducerSourceRows, roleRow))
        providerExportIdentityImportAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                imported.arena, imported.roleProducerDeclarationRows,
                roleRow))
        providerExportIdentityImportAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                imported.arena, imported.roleProducerNodeRows, roleRow))
        layout.ByteBufAppendFixed32(buf, imported.roleProducerFactCids[roleRow])
        layout.ByteBufAppendFixed32(buf, imported.roleInterfaceCids[roleRow])

@borrows
fn ProviderExportIdentityImportComputeCid(
        imported: ProviderExportIdentityImportReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    providerExportIdentityImportAppendBody(imported, buf)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn providerExportIdentityImportShapeValid(
        imported: ProviderExportIdentityImportReceipt,
        err: var str): bool =
    let providerCount = imported.providerSourceArtifactCids.len
    let roleCount = imported.roleProducerFactCids.len
    if imported.schemaVersion != ProviderExportIdentityImportSchemaVersion:
        err = " provider export identity import: schema invalid"
        return false
    if imported.arena.capacityBytes <= 0 || imported.arena.generation <= 0 ||
       providerCount <= 0 || imported.providerRows.len != providerCount ||
       imported.providerExportStarts.len != providerCount ||
       imported.providerExportCounts.len != providerCount ||
       imported.providerCompileReceiptCids.len != providerCount ||
       imported.providerObjectBytesCids.len != providerCount:
        err = " provider export identity import: provider shape invalid"
        return false
    if roleCount != peir.ProviderExportContractRoleMax ||
       imported.roleInterfaceCids.len != roleCount ||
       imported.roleKinds.len != roleCount ||
       imported.roleProviderRows.len != roleCount ||
       imported.roleExportRows.len != roleCount ||
       imported.roleTypedFunctionRows.len != roleCount ||
       imported.roleProducerSourceRows.len != roleCount ||
       imported.roleProducerDeclarationRows.len != roleCount ||
       imported.roleProducerNodeRows.len != roleCount:
        err = " provider export identity import: role shape invalid"
        return false
    err = ""
    return true

@borrows
fn providerExportIdentityImportAuthorityValid(
        imported: ProviderExportIdentityImportReceipt,
        err: var str): bool =
    if providerExportIdentityImportCidZero(
       imported.sourceProviderReceiptCid) ||
       providerExportIdentityImportCidZero(imported.sourceActualSetCid) ||
       imported.sourceExportCount != peir.ProviderExportContractRoleMax:
        err = " provider export identity import: source cid invalid"
        return false
    let providerCount = imported.providerSourceArtifactCids.len
    var expectedExportStart: int32
    for providerRow in 0..<providerCount:
        let exportStart = arenamod.ArenaArrayInt32Get(
            imported.arena, imported.providerExportStarts, providerRow)
        let exportCount = arenamod.ArenaArrayInt32Get(
            imported.arena, imported.providerExportCounts, providerRow)
        if arenamod.ArenaArrayInt32Get(
               imported.arena, imported.providerRows,
               providerRow) != providerRow ||
           exportStart != expectedExportStart || exportCount <= 0 ||
           exportStart > imported.sourceExportCount - exportCount ||
           providerExportIdentityImportCidZero(
               imported.providerSourceArtifactCids[providerRow]) ||
           providerExportIdentityImportCidZero(
               imported.providerCompileReceiptCids[providerRow]) ||
           providerExportIdentityImportCidZero(
               imported.providerObjectBytesCids[providerRow]):
            err = " provider export identity import: provider row invalid"
            return false
        expectedExportStart = expectedExportStart + exportCount
    if expectedExportStart != imported.sourceExportCount:
        err = " provider export identity import: provider csr incomplete"
        return false
    for roleRow in 0..<peir.ProviderExportContractRoleMax:
        let roleKind = arenamod.ArenaArrayInt32Get(
            imported.arena, imported.roleKinds, roleRow)
        let providerRow = arenamod.ArenaArrayInt32Get(
            imported.arena, imported.roleProviderRows, roleRow)
        let exportRow = arenamod.ArenaArrayInt32Get(
            imported.arena, imported.roleExportRows, roleRow)
        if roleKind != roleRow + 1 || providerRow < 0 ||
           providerRow >= providerCount || exportRow < 0 ||
           exportRow >= imported.sourceExportCount ||
           arenamod.ArenaArrayInt32Get(
               imported.arena, imported.roleTypedFunctionRows, roleRow) < 0 ||
           arenamod.ArenaArrayInt32Get(
               imported.arena, imported.roleProducerSourceRows, roleRow) < 0 ||
           arenamod.ArenaArrayInt32Get(
               imported.arena, imported.roleProducerDeclarationRows,
               roleRow) < 0 ||
           arenamod.ArenaArrayInt32Get(
               imported.arena, imported.roleProducerNodeRows, roleRow) < 0:
            err = " provider export identity import: role row invalid"
            return false
        let providerStart = arenamod.ArenaArrayInt32Get(
            imported.arena, imported.providerExportStarts, providerRow)
        let providerExports = arenamod.ArenaArrayInt32Get(
            imported.arena, imported.providerExportCounts, providerRow)
        if exportRow < providerStart ||
           exportRow >= providerStart + providerExports:
            err = " provider export identity import: role provider join invalid"
            return false
        for priorRoleRow in 0..<roleRow:
            if arenamod.ArenaArrayInt32Get(
                   imported.arena, imported.roleExportRows,
                   priorRoleRow) == exportRow:
                err = " provider export identity import: duplicate export row"
                return false
        if providerExportIdentityImportCidZero(
               imported.roleProducerFactCids[roleRow]) ||
           providerExportIdentityImportCidZero(
               imported.roleInterfaceCids[roleRow]):
            err = " provider export identity import: role cid invalid"
            return false
    err = ""
    return true

@borrows
fn ProviderExportIdentityImportStrictValidateInto(
        imported: ProviderExportIdentityImportReceipt,
        err: var str): bool =
    if !imported.sealed || imported.terminalStorageReleased:
        err = " provider export identity import: unsealed or released"
        return false
    if !providerExportIdentityImportShapeValid(imported, err) ||
       !providerExportIdentityImportAuthorityValid(imported, err):
        return false
    if providerExportIdentityImportCidZero(imported.receiptCid) ||
       !layout.FixedBytes32Equal(
           imported.receiptCid,
           ProviderExportIdentityImportComputeCid(imported)):
        err = " provider export identity import: receipt cid mismatch"
        return false
    err = ""
    return true

@borrows
fn ProviderExportIdentityImportRoleExportRow(
        imported: ProviderExportIdentityImportReceipt,
        roleKind: int32): int32 =
    if !imported.sealed || imported.terminalStorageReleased ||
       roleKind <= 0 || roleKind > peir.ProviderExportContractRoleMax:
        return -1
    var err: str
    if !ProviderExportIdentityImportStrictValidateInto(imported, err):
        return -1
    return arenamod.ArenaArrayInt32Get(
        imported.arena, imported.roleExportRows, roleKind - 1)

fn providerExportIdentityImportReleaseStorage(
        imported: var ProviderExportIdentityImportReceipt) =
    arenamod.ArenaRelease(imported.arena)
    seqs.freeSeq(imported.providerSourceArtifactCids)
    seqs.freeSeq(imported.providerCompileReceiptCids)
    seqs.freeSeq(imported.providerObjectBytesCids)
    seqs.freeSeq(imported.roleProducerFactCids)
    seqs.freeSeq(imported.roleInterfaceCids)
    imported.providerRows = arenamod.ArenaArrayInt32Init()
    imported.providerExportStarts = arenamod.ArenaArrayInt32Init()
    imported.providerExportCounts = arenamod.ArenaArrayInt32Init()
    imported.roleKinds = arenamod.ArenaArrayInt32Init()
    imported.roleProviderRows = arenamod.ArenaArrayInt32Init()
    imported.roleExportRows = arenamod.ArenaArrayInt32Init()
    imported.roleTypedFunctionRows = arenamod.ArenaArrayInt32Init()
    imported.roleProducerSourceRows = arenamod.ArenaArrayInt32Init()
    imported.roleProducerDeclarationRows = arenamod.ArenaArrayInt32Init()
    imported.roleProducerNodeRows = arenamod.ArenaArrayInt32Init()

@borrows
fn ProviderExportIdentityImportStorageReleased(
        imported: ProviderExportIdentityImportReceipt): bool =
    return imported.arena.capacityBytes == 0 &&
           imported.providerRows.capacity == 0 &&
           imported.providerExportStarts.capacity == 0 &&
           imported.providerExportCounts.capacity == 0 &&
           imported.roleKinds.capacity == 0 &&
           imported.roleProviderRows.capacity == 0 &&
           imported.roleExportRows.capacity == 0 &&
           imported.roleTypedFunctionRows.capacity == 0 &&
           imported.roleProducerSourceRows.capacity == 0 &&
           imported.roleProducerDeclarationRows.capacity == 0 &&
           imported.roleProducerNodeRows.capacity == 0 &&
           imported.providerSourceArtifactCids.cap == 0 &&
           imported.providerCompileReceiptCids.cap == 0 &&
           imported.providerObjectBytesCids.cap == 0 &&
           imported.roleProducerFactCids.cap == 0 &&
           imported.roleInterfaceCids.cap == 0

@borrows
fn providerExportIdentityImportDestinationPristine(
        imported: ProviderExportIdentityImportReceipt): bool =
    return ProviderExportIdentityImportStorageReleased(imported) &&
           imported.schemaVersion == 0 && !imported.sealed &&
           !imported.terminalStorageReleased &&
           !imported.terminalReleaseReceiptConsumed &&
           providerExportIdentityImportCidZero(imported.receiptCid) &&
           providerExportIdentityImportCidZero(
               imported.sourceProviderReceiptCid) &&
           providerExportIdentityImportCidZero(imported.sourceActualSetCid) &&
           providerExportIdentityImportCidZero(
               imported.terminalReleaseOwnerToken) &&
           imported.terminalReleasedOwnedStorageColumnCount == 0 &&
           imported.terminalReleasedBufferCount == 0 &&
           imported.terminalReleasedBytes == int64(0)

fn ProviderExportIdentityImportMoveInto(
        out: var ProviderExportIdentityImportReceipt,
        source: var ProviderExportIdentityImportReceipt,
        err: var str): bool =
    let sourceVersion = source.schemaVersion
    var marker = ProviderExportIdentityImportSchemaVersion
    if out.schemaVersion == marker:
        marker = 0
    source.schemaVersion = marker
    let descriptorsAlias = out.schemaVersion == marker
    source.schemaVersion = sourceVersion
    if descriptorsAlias:
        err = " provider export identity import: self move"
        return false
    if !providerExportIdentityImportDestinationPristine(out):
        err = " provider export identity import: move output owns storage"
        return false
    if !ProviderExportIdentityImportStrictValidateInto(source, err):
        return false
    out = source
    source = ProviderExportIdentityImportReceipt()
    if !ProviderExportIdentityImportStorageReleased(source):
        panic(" provider export identity import: move source retained storage")
    err = ""
    return true

@borrows
fn ProviderExportIdentityImportBuildInto(
        source: peir.ProviderExportIdentityReceipt,
        actuals: ProviderExportIdentityActualSet,
        out: var ProviderExportIdentityImportReceipt,
        err: var str): bool =
    if !providerExportIdentityImportDestinationPristine(out):
        err = " provider export identity import: output owns storage"
        return false
    if !peir.ProviderExportIdentityReceiptStrictValidateInto(source, err):
        return false
    if !ProviderExportIdentityActualSetStrictValidateInto(actuals, err):
        return false

    let providerCount = source.providerSourceArtifactCids.len
    let actualCount = actuals.sourceArtifactCids.len
    if actualCount != providerCount:
        err = " provider export identity import: missing provider"
        return false
    if providerCount > 67108847:
        err = " provider export identity import: provider count overflow"
        return false

    var joinArena = arenamod.ArenaInit(providerCount * 8 + 128)
    var actualByProvider = arenamod.ArenaArrayInt32Init()
    for providerRow in 0..<providerCount:
        arenamod.ArenaArrayInt32Add(joinArena, actualByProvider, -1)
    for actualRow in 0..<actualCount:
        let providerRow = arenamod.ArenaArrayInt32Get(
            actuals.arena, actuals.providerRows, actualRow)
        if providerRow < 0 || providerRow >= providerCount:
            arenamod.ArenaRelease(joinArena)
            err = " provider export identity import: actual provider row invalid"
            return false
        if arenamod.ArenaArrayInt32Get(
               joinArena, actualByProvider, providerRow) >= 0:
            arenamod.ArenaRelease(joinArena)
            err = " provider export identity import: duplicate provider"
            return false
        arenamod.ArenaArrayInt32Set(
            joinArena, actualByProvider, providerRow, actualRow)

    var next = providerExportIdentityImportInit(providerCount * 32 + 512)
    next.sourceProviderReceiptCid = source.receiptCid
    next.sourceActualSetCid = actuals.actualSetCid
    next.sourceExportCount = source.exportProducerFactCids.len
    for providerRow in 0..<providerCount:
        let actualRow = arenamod.ArenaArrayInt32Get(
            joinArena, actualByProvider, providerRow)
        if actualRow < 0:
            arenamod.ArenaRelease(joinArena)
            providerExportIdentityImportReleaseStorage(next)
            err = " provider export identity import: missing provider"
            return false
        if !layout.FixedBytes32Equal(
               source.providerSourceArtifactCids[providerRow],
               actuals.sourceArtifactCids[actualRow]):
            arenamod.ArenaRelease(joinArena)
            providerExportIdentityImportReleaseStorage(next)
            err = " provider export identity import: artifact cid mismatch"
            return false
        if !layout.FixedBytes32Equal(
               source.providerCompileReceiptCids[providerRow],
               actuals.compileReceiptCids[actualRow]):
            arenamod.ArenaRelease(joinArena)
            providerExportIdentityImportReleaseStorage(next)
            err = " provider export identity import: compile cid mismatch"
            return false
        if !layout.FixedBytes32Equal(
               source.providerObjectBytesCids[providerRow],
               actuals.objectBytesCids[actualRow]):
            arenamod.ArenaRelease(joinArena)
            providerExportIdentityImportReleaseStorage(next)
            err = " provider export identity import: object cid mismatch"
            return false
        arenamod.ArenaArrayInt32Add(next.arena, next.providerRows, providerRow)
        arenamod.ArenaArrayInt32Add(
            next.arena, next.providerExportStarts,
            arenamod.ArenaArrayInt32Get(
                source.arena, source.providerExportStarts, providerRow))
        arenamod.ArenaArrayInt32Add(
            next.arena, next.providerExportCounts,
            arenamod.ArenaArrayInt32Get(
                source.arena, source.providerExportCounts, providerRow))
        add(next.providerSourceArtifactCids,
            actuals.sourceArtifactCids[actualRow])
        add(next.providerCompileReceiptCids,
            actuals.compileReceiptCids[actualRow])
        add(next.providerObjectBytesCids,
            actuals.objectBytesCids[actualRow])
    arenamod.ArenaRelease(joinArena)

    var roleExportRows: int32[3] = [-1, -1, -1]
    let exportCount = source.exportProducerFactCids.len
    for exportRow in 0..<exportCount:
        let roleKind = arenamod.ArenaArrayInt32Get(
            source.arena, source.exportContractRoleKinds, exportRow)
        if roleKind <= 0 || roleKind > peir.ProviderExportContractRoleMax:
            providerExportIdentityImportReleaseStorage(next)
            err = " provider export identity import: contract role invalid"
            return false
        if roleExportRows[roleKind - 1] >= 0:
            providerExportIdentityImportReleaseStorage(next)
            err = " provider export identity import: duplicate contract role"
            return false
        roleExportRows[roleKind - 1] = exportRow

    for roleRow in 0..<peir.ProviderExportContractRoleMax:
        let exportRow = roleExportRows[roleRow]
        if exportRow < 0:
            providerExportIdentityImportReleaseStorage(next)
            err = " provider export identity import: missing contract role"
            return false
        let providerRow = arenamod.ArenaArrayInt32Get(
            source.arena, source.exportProviderRows, exportRow)
        arenamod.ArenaArrayInt32Add(next.arena, next.roleKinds, roleRow + 1)
        arenamod.ArenaArrayInt32Add(
            next.arena, next.roleProviderRows, providerRow)
        arenamod.ArenaArrayInt32Add(
            next.arena, next.roleExportRows, exportRow)
        arenamod.ArenaArrayInt32Add(
            next.arena, next.roleTypedFunctionRows,
            arenamod.ArenaArrayInt32Get(
                source.arena, source.exportTypedFunctionRows, exportRow))
        arenamod.ArenaArrayInt32Add(
            next.arena, next.roleProducerSourceRows,
            arenamod.ArenaArrayInt32Get(
                source.arena, source.exportProducerSourceRows, exportRow))
        arenamod.ArenaArrayInt32Add(
            next.arena, next.roleProducerDeclarationRows,
            arenamod.ArenaArrayInt32Get(
                source.arena, source.exportProducerDeclarationRows,
                exportRow))
        arenamod.ArenaArrayInt32Add(
            next.arena, next.roleProducerNodeRows,
            arenamod.ArenaArrayInt32Get(
                source.arena, source.exportProducerNodeRows, exportRow))
        add(next.roleProducerFactCids, source.exportProducerFactCids[exportRow])
        add(next.roleInterfaceCids, source.exportInterfaceCids[exportRow])

    if !providerExportIdentityImportShapeValid(next, err) ||
       !providerExportIdentityImportAuthorityValid(next, err):
        providerExportIdentityImportReleaseStorage(next)
        return false
    next.receiptCid = ProviderExportIdentityImportComputeCid(next)
    if providerExportIdentityImportCidZero(next.receiptCid):
        providerExportIdentityImportReleaseStorage(next)
        err = " provider export identity import: computed cid invalid"
        return false
    next.sealed = true
    if !ProviderExportIdentityImportMoveInto(out, next, err):
        providerExportIdentityImportReleaseStorage(next)
        return false
    return true

@borrows
fn ProviderExportIdentityImportRetainedBufferCount(
        imported: ProviderExportIdentityImportReceipt): int32 =
    var count: int32
    if imported.arena.capacityBytes > 0:
        count = count + 1
    if imported.providerSourceArtifactCids.cap > 0:
        count = count + 1
    if imported.providerCompileReceiptCids.cap > 0:
        count = count + 1
    if imported.providerObjectBytesCids.cap > 0:
        count = count + 1
    if imported.roleProducerFactCids.cap > 0:
        count = count + 1
    if imported.roleInterfaceCids.cap > 0:
        count = count + 1
    return count

@borrows
fn ProviderExportIdentityImportRetainedBytes(
        imported: ProviderExportIdentityImportReceipt): int64 =
    return int64(imported.arena.capacityBytes) +
        int64(imported.providerSourceArtifactCids.cap) * int64(32) +
        int64(imported.providerCompileReceiptCids.cap) * int64(32) +
        int64(imported.providerObjectBytesCids.cap) * int64(32) +
        int64(imported.roleProducerFactCids.cap) * int64(32) +
        int64(imported.roleInterfaceCids.cap) * int64(32)

@borrows
fn providerExportIdentityImportReleaseOwnerToken(
        imported: ProviderExportIdentityImportReceipt,
        retainedBufferCount: int32,
        retainedBytes: int64): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(96)
    providerExportIdentityImportAppendU32(buf, ProviderExportIdentityImportMagic)
    providerExportIdentityImportAppendU32(
        buf, ProviderExportIdentityImportSchemaVersion)
    layout.ByteBufAppendFixed32(buf, imported.receiptCid)
    providerExportIdentityImportAppendU32(buf, retainedBufferCount)
    providerExportIdentityImportAppendU64(buf, retainedBytes)
    let token = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn ProviderExportIdentityImportReleaseWithReceipt(
        imported: var ProviderExportIdentityImportReceipt,
        released: var ProviderExportIdentityImportReleaseReceipt): bool =
    if imported.schemaVersion != ProviderExportIdentityImportSchemaVersion ||
       imported.terminalStorageReleased ||
       imported.terminalReleaseReceiptConsumed ||
       !providerExportIdentityImportCidZero(
           imported.terminalReleaseOwnerToken) ||
       imported.terminalReleasedOwnedStorageColumnCount != 0 ||
       imported.terminalReleasedBufferCount != 0 ||
       imported.terminalReleasedBytes != int64(0):
        return false
    let retainedBufferCount =
        ProviderExportIdentityImportRetainedBufferCount(imported)
    let retainedBytes = ProviderExportIdentityImportRetainedBytes(imported)
    let ownerToken = providerExportIdentityImportReleaseOwnerToken(
        imported, retainedBufferCount, retainedBytes)
    if providerExportIdentityImportCidZero(ownerToken):
        return false
    providerExportIdentityImportReleaseStorage(imported)
    imported.schemaVersion = 0
    imported.sealed = false
    imported.receiptCid = layout.FixedBytes32()
    imported.sourceProviderReceiptCid = layout.FixedBytes32()
    imported.sourceActualSetCid = layout.FixedBytes32()
    imported.sourceExportCount = 0
    imported.terminalReleaseOwnerToken = ownerToken
    imported.terminalReleasedOwnedStorageColumnCount =
        ProviderExportIdentityImportOwnedStorageColumnCount
    imported.terminalReleasedBufferCount = retainedBufferCount
    imported.terminalReleasedBytes = retainedBytes
    imported.terminalStorageReleased =
        ProviderExportIdentityImportStorageReleased(imported)
    imported.terminalReleaseReceiptConsumed = false
    released.ownerToken = ownerToken
    released.releasedOwnedStorageColumnCount =
        ProviderExportIdentityImportOwnedStorageColumnCount
    released.releasedBufferCount = retainedBufferCount
    released.releasedBytes = retainedBytes
    released.storageReleased = imported.terminalStorageReleased
    return released.storageReleased

fn ProviderExportIdentityImportConsumeReleaseReceipt(
        imported: var ProviderExportIdentityImportReceipt,
        released: ProviderExportIdentityImportReleaseReceipt): bool =
    if !imported.terminalStorageReleased ||
       imported.terminalReleaseReceiptConsumed ||
       !released.storageReleased ||
       providerExportIdentityImportCidZero(released.ownerToken) ||
       !layout.FixedBytes32Equal(
           released.ownerToken, imported.terminalReleaseOwnerToken) ||
       released.releasedOwnedStorageColumnCount !=
           imported.terminalReleasedOwnedStorageColumnCount ||
       released.releasedBufferCount !=
           imported.terminalReleasedBufferCount ||
       released.releasedBytes != imported.terminalReleasedBytes:
        return false
    imported.terminalReleaseReceiptConsumed = true
    return true

fn ProviderExportIdentityImportRelease(
        imported: var ProviderExportIdentityImportReceipt) =
    var released: ProviderExportIdentityImportReleaseReceipt
    if !ProviderExportIdentityImportReleaseWithReceipt(imported, released) ||
       !ProviderExportIdentityImportConsumeReleaseReceipt(
           imported, released):
        panic(" provider export identity import: cleanup release incomplete")
