import std/strutils as strutil
import std/system
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/compiler_snapshot_schema as snapshot_schema
import cheng/core/csg_core/compiler_snapshot_cargo as snapshot_cargo
import cheng/core/tooling/semantic_snapshot as snapshot_core

# Debug facts are a deterministic semantic projection. They deliberately do
# not contain instruction addresses, stack slots, registers, frame sizes, or
# link names: those exist only after an emitter receipt is joined to verified
# object bytes. This module never derives physical locations from source text.

type
    DebugFactKind = enum
        DebugFactKindNone
        DebugFactKindFunction
        DebugFactKindOperation
        DebugFactKindSymbol
        DebugFactKindLayout
        DebugFactKindLayoutField

    DebugFunctionFact =
        functionId: int32
        typedFunctionIndex: int32
        declId: int32
        symbolId: int32
        sourceId: int32
        declarationSpanId: int32
        bodySpanId: int32
        documentCid: layout.FixedBytes32
        declKeyCid: layout.FixedBytes32
        symbolCid: layout.FixedBytes32
        interfaceCid: layout.FixedBytes32
        fragmentCid: layout.FixedBytes32
        modulePath: str
        functionName: str
        qualifiedName: str
        bodyStartByte: int32
        bodyEndByte: int32
        bodyStartLine: int32
        bodyStartColumn: int32
        bodyEndLine: int32
        bodyEndColumn: int32
        threadBoundary: bool

    DebugOperationFact =
        debugOpId: int32
        typedNodeId: int32
        typedIrNodeIndex: int32
        originParserNodeId: int32 = -1
        syntheticOriginKind: int32
        spanAuthorityKind: int32
        functionId: int32
        functionDeclId: int32
        functionSymbolId: int32
        symbolDeclId: int32 = -1
        symbolId: int32
        sourceId: int32
        spanId: int32
        opKind: int32
        typedOpKind: int32
        typeId: int32
        ownershipKind: int32
        documentCid: layout.FixedBytes32
        functionDeclKeyCid: layout.FixedBytes32
        functionSymbolCid: layout.FixedBytes32
        symbolDeclKeyCid: layout.FixedBytes32
        symbolCid: layout.FixedBytes32
        modulePath: str
        startByte: int32
        endByte: int32
        startLine: int32
        startColumn: int32
        endLine: int32
        endColumn: int32

    DebugSymbolFact =
        symbolId: int32
        declId: int32
        sourceId: int32
        declarationSpanId: int32
        symbolKind: int32
        typeId: int32
        ownerSymbolId: int32
        functionId: int32
        documentCid: layout.FixedBytes32
        declKeyCid: layout.FixedBytes32
        symbolCid: layout.FixedBytes32
        interfaceCid: layout.FixedBytes32
        modulePath: str
        name: str
        qualifiedName: str
        startByte: int32
        endByte: int32
        startLine: int32
        startColumn: int32
        endLine: int32
        endColumn: int32
        exported: bool

    DebugLayoutFact =
        layoutId: int32
        typeId: int32
        layoutCid: layout.FixedBytes32
        typeCid: layout.FixedBytes32
        canonicalTypeName: str
        typeKind: int32
        sizeBytes: int32
        alignBytes: int32
        fieldStart: int32
        fieldCount: int32
        managed: bool

    DebugLayoutFieldFact =
        layoutFieldId: int32
        layoutId: int32
        fieldSymbolId: int32
        fieldDeclId: int32
        typeId: int32
        fieldDeclKeyCid: layout.FixedBytes32
        fieldSymbolCid: layout.FixedBytes32
        typeCid: layout.FixedBytes32
        offsetBytes: int32
        sizeBytes: int32
        alignBytes: int32

    DebugFact =
        kind: DebugFactKind
        functionFact: DebugFunctionFact
        operationFact: DebugOperationFact
        symbolFact: DebugSymbolFact
        layoutFact: DebugLayoutFact
        layoutFieldFact: DebugLayoutFieldFact

    DebugFactBundle =
        sourceVersion: int64
        packageId: str
        predecessorReceiptCid: layout.FixedBytes32
        bindingReceiptCid: layout.FixedBytes32
        semanticSnapshotCid: layout.FixedBytes32
        worldHeadCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        csgRootCid: layout.FixedBytes32
        validationReceiptCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        declarationIdentityCid: layout.FixedBytes32
        projectionCid: layout.FixedBytes32
        sourceCount: int32
        spanCount: int32
        typeCount: int32
        declarationCount: int32
        symbolCount: int32
        functionCount: int32
        typedNodeCount: int32
        debugOpCount: int32
        layoutCount: int32
        layoutFieldCount: int32
        factCount: int32
        facts: DebugFact[]

fn debugAppendU32(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn debugAppendI32(buf: var layout.ByteBuf, value: int32) =
    debugAppendU32(buf, value)

fn debugAppendI64(buf: var layout.ByteBuf, value: int64) =
    let raw = UInt64(value)
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(56)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32(raw & UInt64(255)))

fn debugAppendBool(buf: var layout.ByteBuf, value: bool) =
    if value:
        layout.ByteBufAppendByte(buf, 1)
    else:
        layout.ByteBufAppendByte(buf, 0)

@borrows
fn debugAppendText(buf: var layout.ByteBuf, value: str) =
    debugAppendU32(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

@borrows
fn debugAppendCid(buf: var layout.ByteBuf, value: layout.FixedBytes32) =
    layout.ByteBufAppendFixed32(buf, value)

@borrows
fn debugCidObserved(value: layout.FixedBytes32): bool =
    if layout.FixedBytes32Equal(value, layout.FixedBytes32()):
        return false
    var empty = layout.ByteBufInit(0)
    let emptyCid = hash256.Sha256Fixed(layout.ByteBufView(empty))
    layout.ByteBufFree(empty)
    return !layout.FixedBytes32Equal(value, emptyCid)

fn debugAppendSpan(buf: var layout.ByteBuf,
                   startByte: int32, endByte: int32,
                   startLine: int32, startColumn: int32,
                   endLine: int32, endColumn: int32) =
    debugAppendI32(buf, startByte)
    debugAppendI32(buf, endByte)
    debugAppendI32(buf, startLine)
    debugAppendI32(buf, startColumn)
    debugAppendI32(buf, endLine)
    debugAppendI32(buf, endColumn)

@borrows
fn debugAppendFact(buf: var layout.ByteBuf, fact: DebugFact) =
    debugAppendI32(buf, Int32(fact.kind))
    if fact.kind == DebugFactKindFunction:
        let row = fact.functionFact
        debugAppendI32(buf, row.functionId)
        debugAppendI32(buf, row.typedFunctionIndex)
        debugAppendI32(buf, row.declId)
        debugAppendI32(buf, row.symbolId)
        debugAppendI32(buf, row.sourceId)
        debugAppendI32(buf, row.declarationSpanId)
        debugAppendI32(buf, row.bodySpanId)
        debugAppendCid(buf, row.documentCid)
        debugAppendCid(buf, row.declKeyCid)
        debugAppendCid(buf, row.symbolCid)
        debugAppendCid(buf, row.interfaceCid)
        debugAppendCid(buf, row.fragmentCid)
        debugAppendText(buf, row.modulePath)
        debugAppendText(buf, row.functionName)
        debugAppendText(buf, row.qualifiedName)
        debugAppendSpan(buf, row.bodyStartByte, row.bodyEndByte,
                        row.bodyStartLine, row.bodyStartColumn,
                        row.bodyEndLine, row.bodyEndColumn)
        debugAppendBool(buf, row.threadBoundary)
    elif fact.kind == DebugFactKindOperation:
        let row = fact.operationFact
        debugAppendI32(buf, row.debugOpId)
        debugAppendI32(buf, row.typedNodeId)
        debugAppendI32(buf, row.typedIrNodeIndex)
        debugAppendI32(buf, row.originParserNodeId)
        debugAppendI32(buf, row.syntheticOriginKind)
        debugAppendI32(buf, row.spanAuthorityKind)
        debugAppendI32(buf, row.functionId)
        debugAppendI32(buf, row.functionDeclId)
        debugAppendI32(buf, row.functionSymbolId)
        debugAppendI32(buf, row.symbolDeclId)
        debugAppendI32(buf, row.symbolId)
        debugAppendI32(buf, row.sourceId)
        debugAppendI32(buf, row.spanId)
        debugAppendI32(buf, row.opKind)
        debugAppendI32(buf, row.typedOpKind)
        debugAppendI32(buf, row.typeId)
        debugAppendI32(buf, row.ownershipKind)
        debugAppendCid(buf, row.documentCid)
        debugAppendCid(buf, row.functionDeclKeyCid)
        debugAppendCid(buf, row.functionSymbolCid)
        debugAppendCid(buf, row.symbolDeclKeyCid)
        debugAppendCid(buf, row.symbolCid)
        debugAppendText(buf, row.modulePath)
        debugAppendSpan(buf, row.startByte, row.endByte,
                        row.startLine, row.startColumn,
                        row.endLine, row.endColumn)
    elif fact.kind == DebugFactKindSymbol:
        let row = fact.symbolFact
        debugAppendI32(buf, row.symbolId)
        debugAppendI32(buf, row.declId)
        debugAppendI32(buf, row.sourceId)
        debugAppendI32(buf, row.declarationSpanId)
        debugAppendI32(buf, row.symbolKind)
        debugAppendI32(buf, row.typeId)
        debugAppendI32(buf, row.ownerSymbolId)
        debugAppendI32(buf, row.functionId)
        debugAppendCid(buf, row.documentCid)
        debugAppendCid(buf, row.declKeyCid)
        debugAppendCid(buf, row.symbolCid)
        debugAppendCid(buf, row.interfaceCid)
        debugAppendText(buf, row.modulePath)
        debugAppendText(buf, row.name)
        debugAppendText(buf, row.qualifiedName)
        debugAppendSpan(buf, row.startByte, row.endByte,
                        row.startLine, row.startColumn,
                        row.endLine, row.endColumn)
        debugAppendBool(buf, row.exported)
    elif fact.kind == DebugFactKindLayout:
        let row = fact.layoutFact
        debugAppendI32(buf, row.layoutId)
        debugAppendI32(buf, row.typeId)
        debugAppendCid(buf, row.layoutCid)
        debugAppendCid(buf, row.typeCid)
        debugAppendText(buf, row.canonicalTypeName)
        debugAppendI32(buf, row.typeKind)
        debugAppendI32(buf, row.sizeBytes)
        debugAppendI32(buf, row.alignBytes)
        debugAppendI32(buf, row.fieldStart)
        debugAppendI32(buf, row.fieldCount)
        debugAppendBool(buf, row.managed)
    elif fact.kind == DebugFactKindLayoutField:
        let row = fact.layoutFieldFact
        debugAppendI32(buf, row.layoutFieldId)
        debugAppendI32(buf, row.layoutId)
        debugAppendI32(buf, row.fieldSymbolId)
        debugAppendI32(buf, row.fieldDeclId)
        debugAppendI32(buf, row.typeId)
        debugAppendCid(buf, row.fieldDeclKeyCid)
        debugAppendCid(buf, row.fieldSymbolCid)
        debugAppendCid(buf, row.typeCid)
        debugAppendI32(buf, row.offsetBytes)
        debugAppendI32(buf, row.sizeBytes)
        debugAppendI32(buf, row.alignBytes)

@borrows
fn debugProjectionCid(bundle: DebugFactBundle): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(512 + bundle.facts.len * 128)
    debugAppendText(buf, "cheng.debug_fact.snapshot_projection")
    debugAppendI64(buf, bundle.sourceVersion)
    debugAppendText(buf, bundle.packageId)
    debugAppendCid(buf, bundle.predecessorReceiptCid)
    debugAppendCid(buf, bundle.bindingReceiptCid)
    debugAppendCid(buf, bundle.semanticSnapshotCid)
    debugAppendCid(buf, bundle.worldHeadCid)
    debugAppendCid(buf, bundle.compilerCid)
    debugAppendCid(buf, bundle.sourceBundleCid)
    debugAppendCid(buf, bundle.csgRootCid)
    debugAppendCid(buf, bundle.validationReceiptCid)
    debugAppendCid(buf, bundle.declarationTableCid)
    debugAppendCid(buf, bundle.declarationIdentityCid)
    debugAppendI32(buf, bundle.sourceCount)
    debugAppendI32(buf, bundle.spanCount)
    debugAppendI32(buf, bundle.typeCount)
    debugAppendI32(buf, bundle.declarationCount)
    debugAppendI32(buf, bundle.symbolCount)
    debugAppendI32(buf, bundle.functionCount)
    debugAppendI32(buf, bundle.typedNodeCount)
    debugAppendI32(buf, bundle.debugOpCount)
    debugAppendI32(buf, bundle.layoutCount)
    debugAppendI32(buf, bundle.layoutFieldCount)
    debugAppendI32(buf, bundle.facts.len)
    for index in 0..<bundle.facts.len:
        debugAppendFact(buf, bundle.facts[index])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn debugDeclarationIdentityCid(
        bundle: DebugFactBundle): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(
        128 + bundle.functionCount * 144 +
        bundle.debugOpCount * 176 + bundle.symbolCount * 112 +
        bundle.layoutFieldCount * 80)
    debugAppendText(buf, "cheng.debug_fact.declaration_identity")
    debugAppendCid(buf, bundle.declarationTableCid)
    debugAppendI32(buf, bundle.declarationCount)
    debugAppendI32(buf, bundle.functionCount)
    for functionId in 0..<bundle.functionCount:
        let row = bundle.facts[functionId].functionFact
        debugAppendI32(buf, row.functionId)
        debugAppendI32(buf, row.declId)
        debugAppendI32(buf, row.symbolId)
        debugAppendCid(buf, row.declKeyCid)
        debugAppendCid(buf, row.symbolCid)
    debugAppendI32(buf, bundle.debugOpCount)
    for debugOpId in 0..<bundle.debugOpCount:
        let row = bundle.facts[
            bundle.functionCount + debugOpId].operationFact
        debugAppendI32(buf, row.debugOpId)
        debugAppendI32(buf, row.functionId)
        debugAppendI32(buf, row.functionDeclId)
        debugAppendI32(buf, row.functionSymbolId)
        debugAppendI32(buf, row.symbolDeclId)
        debugAppendI32(buf, row.symbolId)
        debugAppendCid(buf, row.functionDeclKeyCid)
        debugAppendCid(buf, row.functionSymbolCid)
        debugAppendCid(buf, row.symbolDeclKeyCid)
        debugAppendCid(buf, row.symbolCid)
    debugAppendI32(buf, bundle.symbolCount)
    let symbolStart = bundle.functionCount + bundle.debugOpCount
    for symbolId in 0..<bundle.symbolCount:
        let row = bundle.facts[symbolStart + symbolId].symbolFact
        debugAppendI32(buf, row.symbolId)
        debugAppendI32(buf, row.declId)
        debugAppendCid(buf, row.declKeyCid)
        debugAppendCid(buf, row.symbolCid)
    debugAppendI32(buf, bundle.layoutFieldCount)
    let layoutFieldStart = symbolStart + bundle.symbolCount +
                           bundle.layoutCount
    for fieldId in 0..<bundle.layoutFieldCount:
        let row = bundle.facts[layoutFieldStart + fieldId].layoutFieldFact
        debugAppendI32(buf, row.layoutFieldId)
        debugAppendI32(buf, row.fieldSymbolId)
        debugAppendI32(buf, row.fieldDeclId)
        debugAppendCid(buf, row.fieldDeclKeyCid)
        debugAppendCid(buf, row.fieldSymbolCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn DebugFactBundleDeclarationIdentityCid(
        bundle: DebugFactBundle): layout.FixedBytes32 =
    return debugDeclarationIdentityCid(bundle)

@borrows
fn DebugFactBundleProjectionCid(
        bundle: DebugFactBundle): layout.FixedBytes32 =
    return debugProjectionCid(bundle)

@borrows
fn debugModulePath(snapshot: snapshot_schema.CsgCompilerSnapshotTables,
                   sourceId: int32): str =
    return system.SystemToStringStr(
        snapshot.texts[snapshot.sources.modulePathTextIds[sourceId]])

fn debugSpanValid(startByte: int32, endByte: int32,
                  startLine: int32, startColumn: int32,
                  endLine: int32, endColumn: int32): bool =
    return startByte >= 0 && endByte >= startByte &&
           startLine >= 0 && startColumn >= 0 && endLine >= startLine &&
           endColumn >= 0 &&
           (endLine != startLine || endColumn >= startColumn)

@borrows
fn debugFactShapeValid(fact: DebugFact): bool =
    if fact.kind == DebugFactKindFunction:
        let row = fact.functionFact
        return row.functionId >= 0 && row.typedFunctionIndex >= 0 &&
               row.declId >= 0 && row.symbolId >= 0 &&
               row.sourceId >= 0 && row.declarationSpanId >= 0 &&
               row.bodySpanId >= 0 && row.modulePath != "" &&
               row.functionName != "" && row.qualifiedName != "" &&
               debugCidObserved(row.documentCid) &&
               debugCidObserved(row.declKeyCid) &&
               debugCidObserved(row.symbolCid) &&
               debugCidObserved(row.interfaceCid) &&
               debugCidObserved(row.fragmentCid) &&
               debugSpanValid(row.bodyStartByte, row.bodyEndByte,
                              row.bodyStartLine, row.bodyStartColumn,
                              row.bodyEndLine, row.bodyEndColumn)
    if fact.kind == DebugFactKindOperation:
        let row = fact.operationFact
        return row.debugOpId >= 0 && row.typedNodeId >= 0 &&
               row.typedIrNodeIndex >= 0 &&
               ((row.originParserNodeId >= 0 &&
                 row.syntheticOriginKind == 0 &&
                 row.spanAuthorityKind == 1 && row.spanId >= 0) ||
                (row.originParserNodeId == -1 &&
                 row.syntheticOriginKind > 0 &&
                 row.syntheticOriginKind <= 5 &&
                 row.spanAuthorityKind == 2 && row.spanId == -1)) &&
               row.functionId >= 0 && row.functionDeclId >= 0 &&
               row.functionSymbolId >= 0 && row.symbolDeclId >= -1 &&
               row.symbolId >= -1 && row.sourceId >= 0 &&
               row.opKind > 0 && row.typedOpKind > 0 && row.typeId >= -1 &&
               row.ownershipKind > 0 && row.modulePath != "" &&
               debugCidObserved(row.documentCid) &&
               debugCidObserved(row.functionDeclKeyCid) &&
               debugCidObserved(row.functionSymbolCid) &&
               ((row.symbolId < 0 && row.symbolDeclId == -1 &&
                 layout.FixedBytes32Equal(
                     row.symbolDeclKeyCid, layout.FixedBytes32()) &&
                 layout.FixedBytes32Equal(
                     row.symbolCid, layout.FixedBytes32())) ||
                (row.symbolId >= 0 && row.symbolDeclId >= 0 &&
                 debugCidObserved(row.symbolDeclKeyCid) &&
                 debugCidObserved(row.symbolCid))) &&
               ((row.spanAuthorityKind == 1 &&
                 debugSpanValid(row.startByte, row.endByte,
                                row.startLine, row.startColumn,
                                row.endLine, row.endColumn)) ||
                (row.spanAuthorityKind == 2 &&
                 row.startByte == -1 && row.endByte == -1 &&
                 row.startLine == -1 && row.startColumn == -1 &&
                 row.endLine == -1 && row.endColumn == -1))
    if fact.kind == DebugFactKindSymbol:
        let row = fact.symbolFact
        return row.symbolId >= 0 && row.declId >= 0 && row.sourceId >= 0 &&
               row.symbolKind > 0 &&
               row.typeId >= -1 && row.ownerSymbolId >= -1 &&
               row.functionId >= -1 && row.modulePath != "" &&
               row.name != "" && row.qualifiedName != "" &&
               debugCidObserved(row.documentCid) &&
               debugCidObserved(row.declKeyCid) &&
               debugCidObserved(row.symbolCid) &&
               debugCidObserved(row.interfaceCid) &&
               ((row.symbolKind ==
                     snapshot_schema.CsgCompilerSymbolModule &&
                 row.typeId == -1 && row.ownerSymbolId == -1 &&
                 row.functionId == -1 &&
                 ((row.declarationSpanId == -1 &&
                   row.startByte == 0 && row.endByte == 0 &&
                   row.startLine == 0 && row.startColumn == 0 &&
                   row.endLine == 0 && row.endColumn == 0) ||
                  (row.declarationSpanId >= 0 &&
                   debugSpanValid(row.startByte, row.endByte,
                                  row.startLine, row.startColumn,
                                  row.endLine, row.endColumn)))) ||
                (row.symbolKind !=
                     snapshot_schema.CsgCompilerSymbolModule &&
                 row.declarationSpanId >= 0 && row.typeId >= 0 &&
                 debugSpanValid(row.startByte, row.endByte,
                                row.startLine, row.startColumn,
                                row.endLine, row.endColumn)))
    if fact.kind == DebugFactKindLayout:
        let row = fact.layoutFact
        return row.layoutId >= 0 && row.typeId >= 0 &&
               row.canonicalTypeName != "" && row.typeKind > 0 &&
               row.sizeBytes >= 0 && row.alignBytes > 0 &&
               row.fieldStart >= 0 && row.fieldCount >= 0 &&
               debugCidObserved(row.layoutCid) && debugCidObserved(row.typeCid)
    if fact.kind == DebugFactKindLayoutField:
        let row = fact.layoutFieldFact
        return row.layoutFieldId >= 0 && row.layoutId >= 0 &&
               row.fieldSymbolId >= 0 && row.fieldDeclId >= 0 &&
               row.typeId >= 0 &&
               row.offsetBytes >= 0 && row.sizeBytes >= 0 &&
               row.alignBytes > 0 &&
               debugCidObserved(row.fieldDeclKeyCid) &&
               debugCidObserved(row.fieldSymbolCid) &&
               debugCidObserved(row.typeCid)
    return false

@borrows
fn DebugFactBundleStrictValidateInto(bundle: DebugFactBundle,
                                     err: var str): bool =
    err = ""
    if bundle.sourceVersion <= 0 || bundle.packageId == "" ||
       bundle.sourceCount <= 0 || bundle.spanCount <= 0 ||
       bundle.typeCount <= 0 || bundle.declarationCount <= 0 ||
       bundle.symbolCount <= 0 ||
       bundle.functionCount < 0 || bundle.typedNodeCount < 0 ||
       bundle.debugOpCount < 0 || bundle.layoutCount < 0 ||
       bundle.layoutFieldCount < 0 ||
       bundle.factCount != bundle.facts.len ||
       bundle.factCount != bundle.functionCount + bundle.debugOpCount +
           bundle.symbolCount + bundle.layoutCount + bundle.layoutFieldCount ||
       !debugCidObserved(bundle.predecessorReceiptCid) ||
       !debugCidObserved(bundle.bindingReceiptCid) ||
       !debugCidObserved(bundle.semanticSnapshotCid) ||
       !debugCidObserved(bundle.worldHeadCid) ||
       !debugCidObserved(bundle.compilerCid) ||
       !debugCidObserved(bundle.sourceBundleCid) ||
       !debugCidObserved(bundle.csgRootCid) ||
       !debugCidObserved(bundle.validationReceiptCid) ||
       !debugCidObserved(bundle.declarationTableCid) ||
       !debugCidObserved(bundle.declarationIdentityCid) ||
       !debugCidObserved(bundle.projectionCid):
        err = " debug facts: invalid bundle shape"
        return false
    var cursor: int32
    for functionId in 0..<bundle.functionCount:
        if bundle.facts[cursor].kind != DebugFactKindFunction ||
           bundle.facts[cursor].functionFact.functionId != functionId:
            err = " debug facts: non-canonical function rows"
            return false
        cursor = cursor + 1
    for debugOpId in 0..<bundle.debugOpCount:
        if bundle.facts[cursor].kind != DebugFactKindOperation ||
           bundle.facts[cursor].operationFact.debugOpId != debugOpId:
            err = " debug facts: non-canonical operation rows"
            return false
        cursor = cursor + 1
    for symbolId in 0..<bundle.symbolCount:
        if bundle.facts[cursor].kind != DebugFactKindSymbol ||
           bundle.facts[cursor].symbolFact.symbolId != symbolId:
            err = " debug facts: non-canonical symbol rows"
            return false
        cursor = cursor + 1
    for layoutId in 0..<bundle.layoutCount:
        if bundle.facts[cursor].kind != DebugFactKindLayout ||
           bundle.facts[cursor].layoutFact.layoutId != layoutId:
            err = " debug facts: non-canonical layout rows"
            return false
        cursor = cursor + 1
    for fieldId in 0..<bundle.layoutFieldCount:
        if bundle.facts[cursor].kind != DebugFactKindLayoutField ||
           bundle.facts[cursor].layoutFieldFact.layoutFieldId != fieldId:
            err = " debug facts: non-canonical layout field rows"
            return false
        cursor = cursor + 1
    if cursor != bundle.facts.len:
        err = " debug facts: row coverage mismatch"
        return false
    for index in 0..<bundle.facts.len:
        if !debugFactShapeValid(bundle.facts[index]):
            err = " debug facts: invalid fact row"
            return false
        let kind = bundle.facts[index].kind
        if kind == DebugFactKindFunction:
            let row = bundle.facts[index].functionFact
            if row.symbolId >= bundle.symbolCount ||
               row.declId >= bundle.declarationCount ||
               row.sourceId >= bundle.sourceCount ||
               row.declarationSpanId >= bundle.spanCount ||
               row.bodySpanId >= bundle.spanCount:
                err = " debug facts: function identity out of range"
                return false
        elif kind == DebugFactKindOperation:
            let row = bundle.facts[index].operationFact
            if row.typedNodeId >= bundle.typedNodeCount ||
               row.functionId >= bundle.functionCount ||
               row.functionDeclId >= bundle.declarationCount ||
               row.functionSymbolId >= bundle.symbolCount ||
               row.symbolDeclId >= bundle.declarationCount ||
               row.symbolId >= bundle.symbolCount ||
               row.sourceId >= bundle.sourceCount || row.spanId >= bundle.spanCount ||
               row.typeId >= bundle.typeCount:
                err = " debug facts: operation identity out of range"
                return false
        elif kind == DebugFactKindSymbol:
            let row = bundle.facts[index].symbolFact
            if row.sourceId >= bundle.sourceCount ||
               row.declId >= bundle.declarationCount ||
               row.declarationSpanId >= bundle.spanCount ||
               row.typeId >= bundle.typeCount ||
               row.ownerSymbolId >= bundle.symbolCount ||
               row.functionId >= bundle.functionCount:
                err = " debug facts: symbol identity out of range"
                return false
        elif kind == DebugFactKindLayout:
            let row = bundle.facts[index].layoutFact
            if row.typeId >= bundle.typeCount ||
               row.fieldStart > bundle.layoutFieldCount ||
               row.fieldCount > bundle.layoutFieldCount - row.fieldStart:
                err = " debug facts: layout identity out of range"
                return false
        else:
            let row = bundle.facts[index].layoutFieldFact
            if row.layoutId >= bundle.layoutCount ||
               row.fieldSymbolId >= bundle.symbolCount ||
               row.fieldDeclId >= bundle.declarationCount ||
               row.typeId >= bundle.typeCount:
                err = " debug facts: layout field identity out of range"
                return false
    let symbolStart = bundle.functionCount + bundle.debugOpCount
    for functionId in 0..<bundle.functionCount:
        let functionRow = bundle.facts[functionId].functionFact
        let symbolRow = bundle.facts[
            symbolStart + functionRow.symbolId].symbolFact
        if symbolRow.symbolId != functionRow.symbolId ||
           symbolRow.functionId != functionId ||
           symbolRow.declId != functionRow.declId ||
           !layout.FixedBytes32Equal(
               symbolRow.declKeyCid, functionRow.declKeyCid) ||
           !layout.FixedBytes32Equal(
               symbolRow.symbolCid, functionRow.symbolCid):
            err = " debug facts: FunctionId/DeclId/SymbolId join mismatch"
            return false
    for debugOpId in 0..<bundle.debugOpCount:
        let operation = bundle.facts[
            bundle.functionCount + debugOpId].operationFact
        let functionRow = bundle.facts[
            operation.functionId].functionFact
        if operation.functionDeclId != functionRow.declId ||
           operation.functionSymbolId != functionRow.symbolId ||
           !layout.FixedBytes32Equal(
               operation.functionDeclKeyCid, functionRow.declKeyCid) ||
           !layout.FixedBytes32Equal(
               operation.functionSymbolCid, functionRow.symbolCid):
            err = " debug facts: DebugOp function identity join mismatch"
            return false
        if operation.symbolId >= 0:
            let symbolRow = bundle.facts[
                symbolStart + operation.symbolId].symbolFact
            if operation.symbolDeclId != symbolRow.declId ||
               !layout.FixedBytes32Equal(
                   operation.symbolDeclKeyCid, symbolRow.declKeyCid) ||
               !layout.FixedBytes32Equal(
                   operation.symbolCid, symbolRow.symbolCid):
                err = " debug facts: DebugOp symbol identity join mismatch"
                return false
    let layoutFieldStart = symbolStart + bundle.symbolCount +
                           bundle.layoutCount
    for fieldId in 0..<bundle.layoutFieldCount:
        let field = bundle.facts[
            layoutFieldStart + fieldId].layoutFieldFact
        let symbolRow = bundle.facts[
            symbolStart + field.fieldSymbolId].symbolFact
        if field.fieldDeclId != symbolRow.declId ||
           !layout.FixedBytes32Equal(
               field.fieldDeclKeyCid, symbolRow.declKeyCid) ||
           !layout.FixedBytes32Equal(
               field.fieldSymbolCid, symbolRow.symbolCid):
            err = " debug facts: layout field declaration join mismatch"
            return false
    let expectedDeclarationIdentity =
        debugDeclarationIdentityCid(bundle)
    if !layout.FixedBytes32Equal(
           expectedDeclarationIdentity, bundle.declarationIdentityCid):
        err = " debug facts: declaration identity receipt mismatch"
        return false
    let expected = debugProjectionCid(bundle)
    if !layout.FixedBytes32Equal(expected, bundle.projectionCid):
        err = " debug facts: projection receipt mismatch"
        return false
    return true

@borrows
fn DebugFactBundleExactFunctionInto(
        bundle: DebugFactBundle,
        functionId: int32,
        out: var DebugFunctionFact,
        err: var str): bool =
    out = DebugFunctionFact()
    if !DebugFactBundleStrictValidateInto(bundle, err):
        return false
    if functionId < 0 || functionId >= bundle.functionCount ||
       functionId >= bundle.facts.len:
        err = " debug facts: exact FunctionId not found"
        return false
    let fact = bundle.facts[functionId]
    if fact.kind != DebugFactKindFunction ||
       fact.functionFact.functionId != functionId:
        err = " debug facts: exact FunctionId row mismatch"
        return false
    out = fact.functionFact
    err = ""
    return true

@borrows
fn DebugFactBundleExactOperationInto(
        bundle: DebugFactBundle,
        debugOpId: int32,
        out: var DebugOperationFact,
        err: var str): bool =
    out = DebugOperationFact()
    if !DebugFactBundleStrictValidateInto(bundle, err):
        return false
    if debugOpId < 0 || debugOpId >= bundle.debugOpCount:
        err = " debug facts: exact DebugOpId not found"
        return false
    let factIndex = bundle.functionCount + debugOpId
    if factIndex < 0 || factIndex >= bundle.facts.len:
        err = " debug facts: exact DebugOpId row not found"
        return false
    let fact = bundle.facts[factIndex]
    if fact.kind != DebugFactKindOperation ||
       fact.operationFact.debugOpId != debugOpId:
        err = " debug facts: exact DebugOpId row mismatch"
        return false
    out = fact.operationFact
    err = ""
    return true

@borrows
fn DebugFactBundleExactSymbolInto(
        bundle: DebugFactBundle,
        symbolId: int32,
        out: var DebugSymbolFact,
        err: var str): bool =
    out = DebugSymbolFact()
    if !DebugFactBundleStrictValidateInto(bundle, err):
        return false
    if symbolId < 0 || symbolId >= bundle.symbolCount:
        err = " debug facts: exact SymbolId not found"
        return false
    let factIndex = bundle.functionCount + bundle.debugOpCount + symbolId
    if factIndex < 0 || factIndex >= bundle.facts.len:
        err = " debug facts: exact SymbolId row not found"
        return false
    let fact = bundle.facts[factIndex]
    if fact.kind != DebugFactKindSymbol ||
       fact.symbolFact.symbolId != symbolId:
        err = " debug facts: exact SymbolId row mismatch"
        return false
    out = fact.symbolFact
    err = ""
    return true

@borrows
fn DebugFunctionFactFromSemanticSnapshotInto(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        functionId: int32,
        out: var DebugFunctionFact,
        err: var str): bool =
    out = DebugFunctionFact()
    if functionId < 0 ||
       functionId >= snapshot.functions.symbolIds.len:
        err = " debug facts: exact FunctionId not found"
        return false
    let symbolId = snapshot.functions.symbolIds[functionId]
    if symbolId < 0 || symbolId >= snapshot.symbols.symbolCids.len:
        err = " debug facts: FunctionId symbol identity is invalid"
        return false
    let sourceId = snapshot.symbols.sourceIds[symbolId]
    let declarationSpanId =
        snapshot.symbols.declarationSpanIds[symbolId]
    let bodySpanId = snapshot.functions.bodySpanIds[functionId]
    if sourceId < 0 ||
       sourceId >= snapshot.sources.documentCids.len ||
       declarationSpanId < 0 ||
       declarationSpanId >= snapshot.spans.sourceIds.len ||
       bodySpanId < 0 || bodySpanId >= snapshot.spans.sourceIds.len:
        err = " debug facts: FunctionId source/span identity is invalid"
        return false
    var row: DebugFunctionFact
    row.functionId = functionId
    row.typedFunctionIndex =
        snapshot.functions.typedFunctionIndexes[functionId]
    row.declId = snapshot.symbols.declIds[symbolId]
    row.symbolId = symbolId
    row.sourceId = sourceId
    row.declarationSpanId = declarationSpanId
    row.bodySpanId = bodySpanId
    row.documentCid =
        layout.FixedBytes32Copy(snapshot.sources.documentCids[sourceId])
    row.declKeyCid =
        layout.FixedBytes32Copy(snapshot.symbols.declKeyCids[symbolId])
    row.symbolCid =
        layout.FixedBytes32Copy(snapshot.symbols.symbolCids[symbolId])
    row.interfaceCid =
        layout.FixedBytes32Copy(
            snapshot.functions.interfaceCids[functionId])
    row.fragmentCid =
        layout.FixedBytes32Copy(
            snapshot.functions.fragmentCids[functionId])
    row.modulePath = debugModulePath(snapshot, sourceId)
    row.functionName =
        system.SystemToStringStr(
            snapshot.texts[
                snapshot.symbols.nameTextIds[symbolId]])
    row.qualifiedName =
        system.SystemToStringStr(
            snapshot.texts[
                snapshot.symbols.qualifiedNameTextIds[symbolId]])
    row.bodyStartByte = snapshot.spans.startBytes[bodySpanId]
    row.bodyEndByte = snapshot.spans.endBytes[bodySpanId]
    row.bodyStartLine = snapshot.spans.startLines[bodySpanId]
    row.bodyStartColumn = snapshot.spans.startColumns[bodySpanId]
    row.bodyEndLine = snapshot.spans.endLines[bodySpanId]
    row.bodyEndColumn = snapshot.spans.endColumns[bodySpanId]
    row.threadBoundary =
        snapshot_schema.CsgCompilerFunctionAnnotationHas(
            snapshot.functions.annotationFlags[functionId],
            snapshot_schema.CsgCompilerFunctionAnnotationThreadBoundary)
    var fact: DebugFact
    fact.kind = DebugFactKindFunction
    fact.functionFact = share(row)
    if !debugFactShapeValid(fact):
        err = " debug facts: exact FunctionId projection is invalid"
        return false
    out = row
    err = ""
    return true

@borrows
fn DebugOperationFactFromSemanticSnapshotInto(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        debugOpId: int32,
        out: var DebugOperationFact,
        err: var str): bool =
    out = DebugOperationFact()
    if debugOpId < 0 ||
       debugOpId >= snapshot.debugOps.typedNodeIds.len:
        err = " debug facts: exact DebugOpId not found"
        return false
    let typedNodeId = snapshot.debugOps.typedNodeIds[debugOpId]
    let functionId = snapshot.debugOps.functionIds[debugOpId]
    let spanId = snapshot.debugOps.spanIds[debugOpId]
    let symbolId = snapshot.debugOps.symbolIds[debugOpId]
    if typedNodeId < 0 ||
       typedNodeId >= snapshot.typedNodes.functionIds.len ||
       functionId < 0 ||
       functionId >= snapshot.functions.symbolIds.len:
        err = " debug facts: DebugOpId node/function identity is invalid"
        return false
    let functionSymbolId = snapshot.functions.symbolIds[functionId]
    if functionSymbolId < 0 ||
       functionSymbolId >= snapshot.symbols.symbolCids.len:
        err = " debug facts: DebugOpId function symbol is invalid"
        return false
    let sourceId = snapshot.symbols.sourceIds[functionSymbolId]
    if sourceId < 0 || sourceId >= snapshot.sources.documentCids.len:
        err = " debug facts: DebugOpId source identity is invalid"
        return false
    var row: DebugOperationFact
    row.debugOpId = debugOpId
    row.typedNodeId = typedNodeId
    row.typedIrNodeIndex =
        snapshot.typedNodes.typedIrNodeIndexes[typedNodeId]
    row.originParserNodeId =
        snapshot.typedNodes.originParserNodeIds[typedNodeId]
    row.syntheticOriginKind =
        snapshot.typedNodes.syntheticOriginKinds[typedNodeId]
    row.spanAuthorityKind =
        snapshot.typedNodes.spanAuthorityKinds[typedNodeId]
    row.functionId = functionId
    row.functionDeclId =
        snapshot.symbols.declIds[functionSymbolId]
    row.functionSymbolId = functionSymbolId
    if symbolId >= 0:
        if symbolId >= snapshot.symbols.symbolCids.len:
            err = " debug facts: DebugOpId symbol identity is invalid"
            return false
        row.symbolDeclId = snapshot.symbols.declIds[symbolId]
    row.symbolId = symbolId
    row.sourceId = sourceId
    row.spanId = spanId
    row.opKind = snapshot.debugOps.opKinds[debugOpId]
    row.typedOpKind = snapshot.typedNodes.opKinds[typedNodeId]
    row.typeId = snapshot.typedNodes.typeIds[typedNodeId]
    row.ownershipKind =
        snapshot.typedNodes.ownershipKinds[typedNodeId]
    row.documentCid =
        layout.FixedBytes32Copy(snapshot.sources.documentCids[sourceId])
    row.functionDeclKeyCid =
        layout.FixedBytes32Copy(
            snapshot.symbols.declKeyCids[functionSymbolId])
    row.functionSymbolCid =
        layout.FixedBytes32Copy(
            snapshot.symbols.symbolCids[functionSymbolId])
    if symbolId >= 0:
        row.symbolDeclKeyCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.declKeyCids[symbolId])
        row.symbolCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.symbolCids[symbolId])
    row.modulePath = debugModulePath(snapshot, sourceId)
    if spanId >= 0:
        if spanId >= snapshot.spans.sourceIds.len:
            err = " debug facts: DebugOpId span identity is invalid"
            return false
        row.startByte = snapshot.spans.startBytes[spanId]
        row.endByte = snapshot.spans.endBytes[spanId]
        row.startLine = snapshot.spans.startLines[spanId]
        row.startColumn = snapshot.spans.startColumns[spanId]
        row.endLine = snapshot.spans.endLines[spanId]
        row.endColumn = snapshot.spans.endColumns[spanId]
    else:
        row.startByte = -1
        row.endByte = -1
        row.startLine = -1
        row.startColumn = -1
        row.endLine = -1
        row.endColumn = -1
    var fact: DebugFact
    fact.kind = DebugFactKindOperation
    fact.operationFact = share(row)
    if !debugFactShapeValid(fact):
        err = " debug facts: exact DebugOpId projection is invalid"
        return false
    out = row
    err = ""
    return true

@borrows
fn DebugFactsFromSemanticSnapshotInto(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        identity: snapshot_core.PortableSemanticSnapshotIdentity,
        binding: snapshot_core.LocalSourceVersionBinding,
        validation: snapshot_core.SemanticSnapshotValidationReceipt,
        predecessorReceiptCid: layout.FixedBytes32,
        packageId: str,
        out: var DebugFactBundle,
        err: var str): bool =
    err = ""
    if packageId == "" ||
       !snapshot_schema.CsgCompilerSnapshotTablesStrictValidateInto(
           snapshot, err) ||
       !snapshot_core.SemanticSnapshotValidationReceiptStrictValidateInto(
           validation, binding, identity, err) ||
       !layout.FixedBytes32Equal(snapshot.predecessorReceiptCid,
                                 predecessorReceiptCid):
        if err == "":
            err = " debug facts: invalid admitted semantic snapshot"
        return false

    var canonical = snapshot_cargo.CsgCompilerSnapshotCargoBuild(snapshot)
    if !canonical.ok ||
       !layout.FixedBytes32Equal(canonical.factsRootCid,
                                 identity.csgRootCid):
        err = " debug facts: canonical CSG root mismatch"
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(canonical)
        return false
    snapshot_cargo.CsgCompilerSnapshotCargoRelease(canonical)

    var bundle: DebugFactBundle
    bundle.sourceVersion = binding.sourceVersion
    bundle.packageId = system.SystemToStringStr(packageId)
    bundle.predecessorReceiptCid =
        layout.FixedBytes32Copy(predecessorReceiptCid)
    bundle.bindingReceiptCid =
        layout.FixedBytes32Copy(binding.bindingReceiptCid)
    bundle.semanticSnapshotCid =
        layout.FixedBytes32Copy(identity.semanticSnapshotCid)
    bundle.worldHeadCid = layout.FixedBytes32Copy(identity.worldHeadCid)
    bundle.compilerCid = layout.FixedBytes32Copy(identity.compilerCid)
    bundle.sourceBundleCid =
        layout.FixedBytes32Copy(identity.sourceBundleCid)
    bundle.csgRootCid = layout.FixedBytes32Copy(identity.csgRootCid)
    bundle.validationReceiptCid =
        layout.FixedBytes32Copy(validation.validationReceiptCid)
    bundle.declarationTableCid =
        layout.FixedBytes32Copy(snapshot.declarations.tableCid)
    bundle.sourceCount = snapshot.sources.documentCids.len
    bundle.spanCount = snapshot.spans.sourceIds.len
    bundle.typeCount = snapshot.types.typeCids.len
    bundle.declarationCount = snapshot.declarations.declIds.len
    bundle.symbolCount = snapshot.symbols.symbolCids.len
    bundle.functionCount = snapshot.functions.symbolIds.len
    bundle.typedNodeCount = snapshot.typedNodes.functionIds.len
    bundle.debugOpCount = snapshot.debugOps.typedNodeIds.len
    bundle.layoutCount = snapshot.layouts.layoutCids.len
    bundle.layoutFieldCount = snapshot.layoutFields.layoutIds.len

    for functionId in 0..<snapshot.functions.symbolIds.len:
        var fact: DebugFact
        fact.kind = DebugFactKindFunction
        if !DebugFunctionFactFromSemanticSnapshotInto(
                snapshot, functionId, fact.functionFact, err):
            return false
        add(bundle.facts, fact)

    for debugOpId in 0..<snapshot.debugOps.typedNodeIds.len:
        var fact: DebugFact
        fact.kind = DebugFactKindOperation
        if !DebugOperationFactFromSemanticSnapshotInto(
                snapshot, debugOpId, fact.operationFact, err):
            return false
        add(bundle.facts, fact)

    for symbolId in 0..<snapshot.symbols.symbolCids.len:
        let sourceId = snapshot.symbols.sourceIds[symbolId]
        let spanId = snapshot.symbols.declarationSpanIds[symbolId]
        var fact: DebugFact
        fact.kind = DebugFactKindSymbol
        var row: DebugSymbolFact
        row.symbolId = symbolId
        row.declId = snapshot.symbols.declIds[symbolId]
        row.sourceId = sourceId
        row.declarationSpanId = spanId
        row.symbolKind = snapshot.symbols.symbolKinds[symbolId]
        row.typeId = snapshot.symbols.typeIds[symbolId]
        row.ownerSymbolId = snapshot.symbols.ownerSymbolIds[symbolId]
        row.functionId = snapshot.symbols.functionIds[symbolId]
        row.documentCid =
            layout.FixedBytes32Copy(
                snapshot.sources.documentCids[sourceId])
        row.declKeyCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.declKeyCids[symbolId])
        row.symbolCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.symbolCids[symbolId])
        row.interfaceCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.interfaceCids[symbolId])
        row.modulePath = debugModulePath(snapshot, sourceId)
        row.name =
            system.SystemToStringStr(
                snapshot.texts[
                    snapshot.symbols.nameTextIds[symbolId]])
        row.qualifiedName =
            system.SystemToStringStr(
                snapshot.texts[
                    snapshot.symbols.qualifiedNameTextIds[symbolId]])
        if spanId < 0:
            if row.symbolKind != snapshot_schema.CsgCompilerSymbolModule ||
               snapshot.symbols.nameSpanIds[symbolId] != -1 ||
               snapshot.symbols.nameTokenIds[symbolId] != -1:
                panic("debug_fact_coordinate_less_non_module_symbol")
            # The implicit Module is a real declaration identity without a
            # source token.  Debug navigation anchors it at the exact
            # document start while retaining declarationSpanId=-1.
            row.startByte = 0
            row.endByte = 0
            row.startLine = 0
            row.startColumn = 0
            row.endLine = 0
            row.endColumn = 0
        else:
            row.startByte = snapshot.spans.startBytes[spanId]
            row.endByte = snapshot.spans.endBytes[spanId]
            row.startLine = snapshot.spans.startLines[spanId]
            row.startColumn = snapshot.spans.startColumns[spanId]
            row.endLine = snapshot.spans.endLines[spanId]
            row.endColumn = snapshot.spans.endColumns[spanId]
        row.exported = snapshot.symbols.exportedFlags[symbolId]
        fact.symbolFact = row
        add(bundle.facts, fact)

    for layoutId in 0..<snapshot.layouts.layoutCids.len:
        let typeId = snapshot.layouts.typeIds[layoutId]
        var fact: DebugFact
        fact.kind = DebugFactKindLayout
        var row: DebugLayoutFact
        row.layoutId = layoutId
        row.typeId = typeId
        row.layoutCid =
            layout.FixedBytes32Copy(
                snapshot.layouts.layoutCids[layoutId])
        row.typeCid =
            layout.FixedBytes32Copy(snapshot.types.typeCids[typeId])
        row.canonicalTypeName =
            system.SystemToStringStr(
                snapshot.texts[
                    snapshot.types.canonicalTextIds[typeId]])
        row.typeKind = snapshot.types.typeKinds[typeId]
        row.sizeBytes = snapshot.layouts.sizeBytes[layoutId]
        row.alignBytes = snapshot.layouts.alignBytes[layoutId]
        row.fieldStart = snapshot.layouts.fieldStarts[layoutId]
        row.fieldCount = snapshot.layouts.fieldCounts[layoutId]
        row.managed = snapshot.types.managedFlags[typeId]
        fact.layoutFact = row
        add(bundle.facts, fact)

    for fieldId in 0..<snapshot.layoutFields.layoutIds.len:
        let symbolId = snapshot.layoutFields.fieldSymbolIds[fieldId]
        let typeId = snapshot.layoutFields.typeIds[fieldId]
        var fact: DebugFact
        fact.kind = DebugFactKindLayoutField
        var row: DebugLayoutFieldFact
        row.layoutFieldId = fieldId
        row.layoutId = snapshot.layoutFields.layoutIds[fieldId]
        row.fieldSymbolId = symbolId
        row.fieldDeclId = snapshot.symbols.declIds[symbolId]
        row.typeId = typeId
        row.fieldDeclKeyCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.declKeyCids[symbolId])
        row.fieldSymbolCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.symbolCids[symbolId])
        row.typeCid =
            layout.FixedBytes32Copy(snapshot.types.typeCids[typeId])
        row.offsetBytes = snapshot.layoutFields.offsetBytes[fieldId]
        row.sizeBytes = snapshot.layoutFields.sizeBytes[fieldId]
        row.alignBytes = snapshot.layoutFields.alignBytes[fieldId]
        fact.layoutFieldFact = row
        add(bundle.facts, fact)

    bundle.factCount = bundle.facts.len
    bundle.declarationIdentityCid = debugDeclarationIdentityCid(bundle)
    bundle.projectionCid = debugProjectionCid(bundle)
    if !DebugFactBundleStrictValidateInto(bundle, err):
        return false
    out = bundle
    err = ""
    return true

fn DebugFactsReportText(bundle: DebugFactBundle): str =
    var functionCount: int32
    var operationCount: int32
    var symbolCount: int32
    var layoutCount: int32
    var fieldCount: int32
    for index in 0..<bundle.facts.len:
        let kind = bundle.facts[index].kind
        if kind == DebugFactKindFunction:
            functionCount = functionCount + 1
        elif kind == DebugFactKindOperation:
            operationCount = operationCount + 1
        elif kind == DebugFactKindSymbol:
            symbolCount = symbolCount + 1
        elif kind == DebugFactKindLayout:
            layoutCount = layoutCount + 1
        elif kind == DebugFactKindLayoutField:
            fieldCount = fieldCount + 1
    return strutil.Join([
        "debug_source_version=", Int64ToStr(bundle.sourceVersion), "\n",
        "debug_fact_count=", IntToStr(bundle.factCount), "\n",
        "debug_function_count=", IntToStr(functionCount), "\n",
        "debug_operation_count=", IntToStr(operationCount), "\n",
        "debug_symbol_count=", IntToStr(symbolCount), "\n",
        "debug_layout_count=", IntToStr(layoutCount), "\n",
        "debug_layout_field_count=", IntToStr(fieldCount), "\n",
        "debug_declaration_table_cid=",
        layout.FixedBytes32Hex(bundle.declarationTableCid), "\n",
        "debug_declaration_identity_cid=",
        layout.FixedBytes32Hex(bundle.declarationIdentityCid), "\n",
        "debug_projection_cid=", layout.FixedBytes32Hex(bundle.projectionCid),
        "\n"], "")
