import std/seqs
import std/strings
import cheng/core/tooling/compiler_request as creq
import cheng/core/backend/object_plan as oplan
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/target_matrix as tmat
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

const NativeLinkPlanOwnedStorageColumnCount: int32 = 13

type
    NativeOutputKind = enum
        NativeOutputArtifact
        NativeOutputExecutable

    NativeLinkPlanReleaseReceipt =
        ownerToken: layout.FixedBytes32
        releasedOwnedStorageColumnCount: int32
        releasedBufferCount: int32
        releasedBytes: int64
        storageReleased: bool

    NativeLinkPlanStub =
        targetTriple: str
        emitKind: creq.CompilerEmit
        outputPath: str
        objectFormat: str
        linkerProgram: str
        linkerFlavor: str
        outputKind: NativeOutputKind
        entrySymbol: str
        primaryObjectPath: str
        browserBridgeObjectPath: str
        programObjectPaths: str[]
        providerObjectPaths: str[]
        linkInputPaths: str[]
        missingReasons: str[]
        pipelineStage: str
        terminalReleaseOwnerToken: layout.FixedBytes32
        terminalReleasedOwnedStorageColumnCount: int32
        terminalReleasedBufferCount: int32
        terminalReleasedBytes: int64
        terminalStorageReleased: bool
        terminalReleaseReceiptConsumed: bool

@borrows
fn nativeLinkPlanCloneTextSequence(values: str[]): str[] =
    var out: str[]
    for index in 0..<values.len:
        add(out, share(values[index]))
    return out

@borrows
fn NativeLinkPlanClone(plan: NativeLinkPlanStub): NativeLinkPlanStub =
    var out: NativeLinkPlanStub
    out.targetTriple = share(plan.targetTriple)
    out.emitKind = plan.emitKind
    out.outputPath = share(plan.outputPath)
    out.objectFormat = share(plan.objectFormat)
    out.linkerProgram = share(plan.linkerProgram)
    out.linkerFlavor = share(plan.linkerFlavor)
    out.outputKind = plan.outputKind
    out.entrySymbol = share(plan.entrySymbol)
    out.primaryObjectPath = share(plan.primaryObjectPath)
    out.browserBridgeObjectPath = share(plan.browserBridgeObjectPath)
    out.programObjectPaths =
        nativeLinkPlanCloneTextSequence(plan.programObjectPaths)
    out.providerObjectPaths =
        nativeLinkPlanCloneTextSequence(plan.providerObjectPaths)
    out.linkInputPaths =
        nativeLinkPlanCloneTextSequence(plan.linkInputPaths)
    out.missingReasons =
        nativeLinkPlanCloneTextSequence(plan.missingReasons)
    out.pipelineStage = share(plan.pipelineStage)
    out.terminalReleaseOwnerToken = plan.terminalReleaseOwnerToken
    out.terminalReleasedOwnedStorageColumnCount =
        plan.terminalReleasedOwnedStorageColumnCount
    out.terminalReleasedBufferCount = plan.terminalReleasedBufferCount
    out.terminalReleasedBytes = plan.terminalReleasedBytes
    out.terminalStorageReleased = plan.terminalStorageReleased
    out.terminalReleaseReceiptConsumed =
        plan.terminalReleaseReceiptConsumed
    return out

fn nativeLinkPlanAppendU32BE(
        buf: var layout.ByteBuf,
        value: int64) =
    layout.ByteBufAppendByte(buf, Int32((value >> 24) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 16) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 8) & 255))
    layout.ByteBufAppendByte(buf, Int32(value & 255))

@borrows
fn nativeLinkPlanAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    nativeLinkPlanAppendU32BE(buf, value.len)
    for textIndex in 0..<value.len:
        layout.ByteBufAppendByte(buf, value[textIndex])

fn nativeLinkPlanAppendU32Field(
        buf: var layout.ByteBuf,
        value: int64) =
    nativeLinkPlanAppendU32BE(buf, 4)
    nativeLinkPlanAppendU32BE(buf, value)

fn nativeLinkPlanAppendI64Field(
        buf: var layout.ByteBuf,
        value: int64) =
    nativeLinkPlanAppendU32BE(buf, 8)
    nativeLinkPlanAppendU32BE(buf, value >> 32)
    nativeLinkPlanAppendU32BE(buf, value)

@borrows
fn nativeLinkPlanAppendTexts(
        buf: var layout.ByteBuf,
        values: str[]) =
    nativeLinkPlanAppendU32Field(buf, values.len)
    for valueIndex in 0..<values.len:
        nativeLinkPlanAppendText(buf, values[valueIndex])

fn nativeLinkPlanRecordStringArrayStorage(
        values: var str[],
        bufferCount: var int32,
        retainedBytes: var int64) =
    if values.cap < 0:
        panic("native link plan: invalid owned sequence capacity")
    if values.cap > 0:
        bufferCount = bufferCount + 1
        retainedBytes =
            retainedBytes +
            int64(values.cap) * int64(sizeof(str))
    for valueIndex in 0..<values.len:
        retainedBytes =
            retainedBytes + int64(values[valueIndex].len)

fn nativeLinkPlanRecordPlanSequenceStorage(
        plan: var NativeLinkPlanStub,
        bufferCount: var int32,
        retainedBytes: var int64) =
    var programObjectPaths = share(plan.programObjectPaths)
    plan.programObjectPaths = []
    nativeLinkPlanRecordStringArrayStorage(
        programObjectPaths, bufferCount, retainedBytes)
    plan.programObjectPaths = programObjectPaths
    programObjectPaths = []
    var providerObjectPaths = share(plan.providerObjectPaths)
    plan.providerObjectPaths = []
    nativeLinkPlanRecordStringArrayStorage(
        providerObjectPaths, bufferCount, retainedBytes)
    plan.providerObjectPaths = providerObjectPaths
    providerObjectPaths = []
    var linkInputPaths = share(plan.linkInputPaths)
    plan.linkInputPaths = []
    nativeLinkPlanRecordStringArrayStorage(
        linkInputPaths, bufferCount, retainedBytes)
    plan.linkInputPaths = linkInputPaths
    linkInputPaths = []
    var missingReasons = share(plan.missingReasons)
    plan.missingReasons = []
    nativeLinkPlanRecordStringArrayStorage(
        missingReasons, bufferCount, retainedBytes)
    plan.missingReasons = missingReasons
    missingReasons = []

fn NativeLinkPlanRetainedBufferCount(
        plan: var NativeLinkPlanStub): int32 =
    var bufferCount: int32
    var retainedBytes: int64
    nativeLinkPlanRecordPlanSequenceStorage(
        plan, bufferCount, retainedBytes)
    return bufferCount

fn NativeLinkPlanRetainedBytes(
        plan: var NativeLinkPlanStub): int64 =
    var bufferCount: int32
    var retainedBytes =
        int64(plan.targetTriple.len) +
        int64(plan.outputPath.len) +
        int64(plan.objectFormat.len) +
        int64(plan.linkerProgram.len) +
        int64(plan.linkerFlavor.len) +
        int64(plan.entrySymbol.len) +
        int64(plan.primaryObjectPath.len) +
        int64(plan.browserBridgeObjectPath.len) +
        int64(plan.pipelineStage.len)
    nativeLinkPlanRecordPlanSequenceStorage(
        plan, bufferCount, retainedBytes)
    return retainedBytes

fn nativeLinkPlanReleaseOwnerToken(
        plan: var NativeLinkPlanStub,
        releasedBufferCount: int32,
        releasedBytes: int64): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(384)
    nativeLinkPlanAppendText(
        buf, "cheng.compiler.native_link_plan.owner_release")
    nativeLinkPlanAppendU32Field(
        buf, NativeLinkPlanOwnedStorageColumnCount)
    nativeLinkPlanAppendU32Field(buf, releasedBufferCount)
    nativeLinkPlanAppendI64Field(buf, releasedBytes)
    nativeLinkPlanAppendText(buf, plan.targetTriple)
    nativeLinkPlanAppendU32Field(buf, Int32(plan.emitKind))
    nativeLinkPlanAppendText(buf, plan.outputPath)
    nativeLinkPlanAppendText(buf, plan.objectFormat)
    nativeLinkPlanAppendText(buf, plan.linkerProgram)
    nativeLinkPlanAppendText(buf, plan.linkerFlavor)
    nativeLinkPlanAppendU32Field(buf, Int32(plan.outputKind))
    nativeLinkPlanAppendText(buf, plan.entrySymbol)
    nativeLinkPlanAppendText(buf, plan.primaryObjectPath)
    nativeLinkPlanAppendText(buf, plan.browserBridgeObjectPath)
    nativeLinkPlanAppendTexts(buf, plan.programObjectPaths)
    nativeLinkPlanAppendTexts(buf, plan.providerObjectPaths)
    nativeLinkPlanAppendTexts(buf, plan.linkInputPaths)
    nativeLinkPlanAppendTexts(buf, plan.missingReasons)
    nativeLinkPlanAppendText(buf, plan.pipelineStage)
    let token = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn NativeLinkPlanStorageReleased(
        plan: var NativeLinkPlanStub): bool =
    return plan.targetTriple.len == 0 &&
           plan.outputPath.len == 0 &&
           plan.objectFormat.len == 0 &&
           plan.linkerProgram.len == 0 &&
           plan.linkerFlavor.len == 0 &&
           plan.entrySymbol.len == 0 &&
           plan.primaryObjectPath.len == 0 &&
           plan.browserBridgeObjectPath.len == 0 &&
           plan.programObjectPaths.len == 0 &&
           plan.programObjectPaths.cap == 0 &&
           plan.providerObjectPaths.len == 0 &&
           plan.providerObjectPaths.cap == 0 &&
           plan.linkInputPaths.len == 0 &&
           plan.linkInputPaths.cap == 0 &&
           plan.missingReasons.len == 0 &&
           plan.missingReasons.cap == 0 &&
           plan.pipelineStage.len == 0

fn NativeLinkPlanReleaseWithReceipt(
        plan: var NativeLinkPlanStub,
        receipt: var NativeLinkPlanReleaseReceipt) =
    if plan.terminalStorageReleased ||
       plan.terminalReleaseReceiptConsumed ||
       !layout.FixedBytes32Equal(
           plan.terminalReleaseOwnerToken,
           layout.FixedBytes32()) ||
       plan.terminalReleasedOwnedStorageColumnCount != 0 ||
       plan.terminalReleasedBufferCount != 0 ||
       plan.terminalReleasedBytes != int64(0):
        panic("native link plan: duplicate or corrupt terminal release")
    let releasedBufferCount =
        NativeLinkPlanRetainedBufferCount(plan)
    let releasedBytes = NativeLinkPlanRetainedBytes(plan)
    let ownerToken =
        nativeLinkPlanReleaseOwnerToken(
            plan, releasedBufferCount, releasedBytes)
    if layout.FixedBytes32Equal(
           ownerToken, layout.FixedBytes32()) ||
       releasedBufferCount < 0 ||
       releasedBytes < int64(0):
        panic("native link plan: invalid terminal release preimage")
    plan.targetTriple = ""
    plan.outputPath = ""
    plan.objectFormat = ""
    plan.linkerProgram = ""
    plan.linkerFlavor = ""
    plan.entrySymbol = ""
    plan.primaryObjectPath = ""
    plan.browserBridgeObjectPath = ""
    var programObjectPaths = plan.programObjectPaths
    plan.programObjectPaths = []
    seqs.freeSeqStrRelease(programObjectPaths)
    var providerObjectPaths = plan.providerObjectPaths
    plan.providerObjectPaths = []
    seqs.freeSeqStrRelease(providerObjectPaths)
    var linkInputPaths = plan.linkInputPaths
    plan.linkInputPaths = []
    seqs.freeSeqStrRelease(linkInputPaths)
    var missingReasons = plan.missingReasons
    plan.missingReasons = []
    seqs.freeSeqStrRelease(missingReasons)
    plan.pipelineStage = ""
    plan.terminalReleaseOwnerToken = ownerToken
    plan.terminalReleasedOwnedStorageColumnCount =
        NativeLinkPlanOwnedStorageColumnCount
    plan.terminalReleasedBufferCount = releasedBufferCount
    plan.terminalReleasedBytes = releasedBytes
    plan.terminalStorageReleased =
        NativeLinkPlanStorageReleased(plan)
    receipt.ownerToken = ownerToken
    receipt.releasedOwnedStorageColumnCount =
        NativeLinkPlanOwnedStorageColumnCount
    receipt.releasedBufferCount = releasedBufferCount
    receipt.releasedBytes = releasedBytes
    receipt.storageReleased = plan.terminalStorageReleased
    if !receipt.storageReleased ||
       NativeLinkPlanRetainedBufferCount(plan) != 0 ||
       NativeLinkPlanRetainedBytes(plan) != int64(0):
        panic("native link plan: terminal storage release incomplete")

fn NativeLinkPlanReleaseReceiptConsumeStrictInto(
        plan: var NativeLinkPlanStub,
        receipt: var NativeLinkPlanReleaseReceipt,
        err: var str): bool =
    err = ""
    if !plan.terminalStorageReleased ||
       plan.terminalReleaseReceiptConsumed ||
       !receipt.storageReleased ||
       receipt.releasedOwnedStorageColumnCount !=
           NativeLinkPlanOwnedStorageColumnCount ||
       receipt.releasedOwnedStorageColumnCount !=
           plan.terminalReleasedOwnedStorageColumnCount ||
       receipt.releasedBufferCount !=
           plan.terminalReleasedBufferCount ||
       receipt.releasedBytes !=
           plan.terminalReleasedBytes ||
       !layout.FixedBytes32Equal(
           receipt.ownerToken,
           plan.terminalReleaseOwnerToken) ||
       !NativeLinkPlanStorageReleased(plan) ||
       NativeLinkPlanRetainedBufferCount(plan) != 0 ||
       NativeLinkPlanRetainedBytes(plan) != int64(0):
        err = "native link plan: terminal release receipt mismatch"
        return false
    plan.terminalReleaseReceiptConsumed = true
    return true

@borrows
fn BuildNativeLinkPlan(linkPlan: slplan.SystemLinkPlanStub,
                        objectPlan: oplan.ObjectPlanStub): NativeLinkPlanStub =
    var out: NativeLinkPlanStub
    var missing: str[]
    let objectFormat = tmat.TargetPrimaryObjectFormat(linkPlan.targetTriple)
    let linkerFlavor = tmat.TargetLinkerFlavor(linkPlan.targetTriple)
    let linkerProgram = tmat.TargetLinkerProgram(linkPlan.targetTriple)
    var outputKind = NativeOutputArtifact
    var programObjectPaths: str[]
    var providerObjectPaths: str[]
    var linkInputPaths: str[]
    if linkPlan.emitKind == creq.EmitExe:
        outputKind = NativeOutputExecutable
    if linkPlan.missingReasons.len > 0:
        add(missing, "system_link_plan_not_ready_for_native_link")
    if objectPlan.missingReasons.len > 0:
        add(missing, "object_plan_not_ready_for_native_link")
    if objectPlan.linkInputPaths.len <= 0:
        add(missing, "native_link_inputs_missing")
    if len(linkPlan.outputPath) <= 0:
        add(missing, "native_link_output_missing")
    if linkPlan.emitKind == creq.EmitExe && len(linkPlan.entrySymbol) <= 0:
        add(missing, "native_link_entry_symbol_missing")
    if objectFormat == "unknown":
        add(missing, "native_link_object_format_unknown")
    if objectFormat == "wasm":
        add(missing, "native_link_not_applicable_for_wasm")
    if len(linkerProgram) <= 0:
        add(missing, "native_linker_program_missing")
    if len(linkerFlavor) <= 0:
        add(missing, "native_linker_flavor_missing")
    if tmat.TargetRequiresNativeProviderModules(linkPlan.targetTriple) &&
       linkPlan.providerModules.len > 0 &&
       objectPlan.providerObjectPaths.len <= 0:
        add(missing, "native_link_provider_modules_missing")
    if len(objectPlan.primaryObjectPath) > 0:
        add(programObjectPaths, strings.CloneStr(objectPlan.primaryObjectPath))
    if len(objectPlan.browserBridgeObjectPath) > 0:
        add(programObjectPaths, strings.CloneStr(objectPlan.browserBridgeObjectPath))
    for providerIndex in 0..<objectPlan.providerObjectPaths.len:
        add(providerObjectPaths,
            strings.CloneStr(objectPlan.providerObjectPaths[providerIndex]))
    for inputIndex in 0..<objectPlan.linkInputPaths.len:
        add(linkInputPaths, strings.CloneStr(objectPlan.linkInputPaths[inputIndex]))
    out.targetTriple = strings.CloneStr(linkPlan.targetTriple)
    out.emitKind = linkPlan.emitKind
    out.outputPath = strings.CloneStr(linkPlan.outputPath)
    out.objectFormat = objectFormat
    out.linkerProgram = linkerProgram
    out.linkerFlavor = linkerFlavor
    out.outputKind = outputKind
    out.entrySymbol = strings.CloneStr(linkPlan.entrySymbol)
    out.primaryObjectPath = strings.CloneStr(objectPlan.primaryObjectPath)
    out.browserBridgeObjectPath =
        strings.CloneStr(objectPlan.browserBridgeObjectPath)
    out.programObjectPaths = programObjectPaths
    out.providerObjectPaths = providerObjectPaths
    out.linkInputPaths = linkInputPaths
    out.missingReasons = missing
    out.pipelineStage = "object_plan_to_native_link_plan"
    return out
