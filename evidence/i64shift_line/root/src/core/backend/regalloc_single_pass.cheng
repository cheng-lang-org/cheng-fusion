                                      constraints.allocatableCalleeRegs)
    regallocValueHashAppendInt32Array(parts, constraints.reservedRegs)
    regallocValueHashAppendInt32Array(parts, constraints.callClobberRegs)
    regallocValueHashAppendInt32Array(parts, constraints.fixedArgRegs)
    regallocValueHashAppendInt32(parts, constraints.fixedResultReg)
    regallocValueHashAppendInt32(parts, constraints.fixedSretReg)
    regallocValueHashAppendBool(
        parts, constraints.sretShiftsFixedArgs)
    regallocValueHashAppendInt32(parts, constraints.fixedReturnReg)
    regallocValueHashAppendInt32(parts,
                                 constraints.parallelCopyScratchReg)
    regallocValueHashAppendBool(parts, constraints.packedStackArgs)
    regallocValueHashAppendInt32(parts, constraints.stackArgSlotBytes)
    regallocValueHashAppendInt32(parts, constraints.stackAlignmentBytes)
    regallocValueHashAppendInt32Array(parts, constraints.gprTypeKinds)
    return strings.Sha256(strutil.Join(parts, ""))

