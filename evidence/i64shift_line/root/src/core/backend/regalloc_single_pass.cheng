    regallocValueHashAppendInt32(parts, action.semanticEnd)
    regallocValueHashAppendInt32(parts, action.semanticRegister)
    regallocValueHashAppendInt32(parts, action.fragmentOrdinal)
    regallocValueHashAppendBool(parts, action.effectSpLoad)
    regallocValueHashAppendBool(parts, action.effectSpStore)
    regallocValueHashAppendBool(parts, action.effectCall)
    regallocValueHashAppendBool(parts, action.effectX16)
    regallocValueHashAppendBool(parts, action.effectX17)
    return strings.Sha256(strutil.Join(parts, ""))

@borrows
fn regallocValueStringRoot(label: str, values: var str[]): str =
    var parts: str[]
    regallocValueHashAppendText(parts, label)
    regallocValueHashAppendInt32(parts, values.len)
    for i in 0..<values.len:
        regallocValueHashAppendText(parts, values[i])
    return strings.Sha256(strutil.Join(parts, ""))

@borrows
fn regallocValueActionSemanticRoot(
        plan: var RegallocSinglePassValuePlan): str =
    var hashes: str[]
    for actionIndex in 0..<plan.actions.len:
        add(hashes,
            regallocValueActionSemanticHash(plan.actions[actionIndex]))
    return regallocValueStringRoot(
        "regalloc-action-semantic-root", hashes)

@borrows
fn regallocValueBindingRootInitial(): str =
    return strings.Sha256("regalloc-action-binding-root;")

@borrows
fn regallocValueBindingRootExtend(previousRootSha256: str,
                                  ordinal: int32,
                                  bindingSha256: str): str =
    var parts: str[]
    add(parts, "regalloc-action-binding-node;")
    regallocValueHashAppendText(parts, previousRootSha256)
    regallocValueHashAppendInt32(parts, ordinal)
    regallocValueHashAppendText(parts, bindingSha256)
    return strings.Sha256(strutil.Join(parts, ""))

@borrows
fn regallocValueActionBindingRoot(
        plan: var RegallocSinglePassValuePlan): str =
    var root = regallocValueBindingRootInitial()
    for emissionIndex in 0..<plan.actionEmissions.len:
        root = regallocValueBindingRootExtend(
            root, emissionIndex,
            plan.actionEmissions[emissionIndex].bindingSha256)
    return root

