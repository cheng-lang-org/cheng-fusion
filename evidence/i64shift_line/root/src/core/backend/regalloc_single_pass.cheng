    regallocValueHashAppendBool(parts, action.requiresEdgeSplit)
    regallocValueHashAppendInt32(parts, action.parallelGroup)
    regallocValueHashAppendInt32(parts, action.parallelOrdinal)
    regallocValueHashAppendInt32(parts, action.relatedActionOrdinal)
    regallocValueHashAppendInt32(parts, action.fixedKind)
    regallocValueHashAppendInt32(parts, action.fixedOrdinal)
    regallocValueHashAppendInt32(parts, action.passKind)
    regallocValueHashAppendInt32(parts, action.encodedValue)
    regallocValueHashAppendInt32(parts, action.callOrdinal)
    regallocValueHashAppendInt32(parts, action.abiSizeBytes)
    regallocValueHashAppendBool(parts, action.abiSizeExplicit)
    regallocValueHashAppendInt32(parts, action.outgoingStackArgIndex)
    regallocValueHashAppendInt32(parts, action.outgoingStackByteOffset)
    regallocValueHashAppendInt32(parts, action.outgoingStackByteWidth)
    regallocValueHashAppendInt32(parts, action.outgoingStackFrameBytes)
