import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_access as bodyaccess
import cheng/core/ir/body_ir_cfg as cfg
import cheng/core/backend2/backend2_frag_codec as b2fc
import std/rawbytes
import std/strings
import std/strutils as strutil

# Deterministic register-allocation plans.  The value-plan API at the end of
# this module is the authoritative CFG-aware contract.  The linear-slot state
# machine below is retained only for compatibility with its isolated fixture.
#
# Legacy deterministic single-pass register-allocation state machine.
#
# This legacy state machine is intentionally not wired into the production
# emitter.  It was the first cut of the replacement for the old chain:
#
#   IR construction: append Def/Use/Call facts once, in source order.  Each Use
#   is linked to the next Use of the same SSA slot as later facts arrive.
#   Emit: consume those sealed facts once, in increasing op order.
#
# Exact future use is therefore an explicit input fact, never guessed by an
# online "last seen" value.  A CFG producer must add block live-in/live-out and
# edge reconciliation facts before this state machine can be wired to a
# multi-block production emitter.  SealLinear rejects blockCount > 1 or any CFG
# edge, so missing CFG facts are a machine-checked hard error in this cut.
# Every op has one legal phase order:
# BeginOp -> Read(pin operands) -> Call/Define -> EndOp(release final uses).
# A call result is defined only after Call has applied its clobber actions.
# Production admission must additionally hard-fail unless the future producer
# proves all of these facts: only eligible scalar GPR values enter the state;
# one canonical decoder emits every BodyOp/term/call-arg use, def and clobber;
# address-passed values are flushed before escape; CFG edges carry explicit
# live-in/live-out reconciliation.  This linear contract does not infer them.
# Validation status: this compatibility API remains isolated; the CFG/value API
# below consumes the complete BodyIR access and CFG analyses directly.
#
# Memory is O(slots + uses + calls + physical registers).  The allocator itself
# is O(slots + registers) live state and keeps only the current op's bounded
# action list.  Register choice is deterministic: lowest free register first;
# when full, keep the values with the nearest exact next use.  Equal next-use
# keeps the existing owner, avoiding allocation churn.

const
    RegallocSinglePassUndefinedDef = -2
    RegallocSinglePassInputDef = -1
    RegallocSinglePassNoIndex = -1
    RegallocSinglePassReadError = -2

    RegallocSinglePassLocationDead = 0
    RegallocSinglePassLocationStack = 1
    RegallocSinglePassLocationRegister = 2

    RegallocSinglePassActionBindDef = 1
    RegallocSinglePassActionReload = 2
    RegallocSinglePassActionSpill = 3
    RegallocSinglePassActionDrop = 4
    RegallocSinglePassActionStoreDef = 5

    RegallocSinglePassPlacementBeforeOp = 1
    RegallocSinglePassPlacementResultAfterOp = 2

    RegallocSinglePassFactsModeLinearTrace = 1

    RegallocSinglePassPhaseIdle = 0
    RegallocSinglePassPhaseReads = 1
    RegallocSinglePassPhaseCallDone = 2
    RegallocSinglePassPhaseDefined = 3

    RegallocSinglePassIntColumnValueLocation = 1
    RegallocSinglePassIntColumnValueAssignedReg = 2
    RegallocSinglePassIntColumnValueNextUseEvent = 3
    RegallocSinglePassIntColumnValueNextUseOp = 4
    RegallocSinglePassIntColumnCallerOwner = 5
    RegallocSinglePassIntColumnCalleeOwner = 6

    RegallocSinglePassBoolColumnValueDefined = 1
    RegallocSinglePassBoolColumnValueStackValid = 2
    RegallocSinglePassBoolColumnCalleeEverUsed = 3
    RegallocSinglePassBoolColumnValuePinnedCurrentOp = 4

type
    RegallocSinglePassUseEvent =
        opIndex: int32
        slotIndex: int32
        nextUseEventIndex: int32 = -1

    RegallocSinglePassFacts =
        slotCount: int32
        defOpBySlot: int32[]
        firstUseEventBySlot: int32[]
        lastUseEventBySlot: int32[]
        useEvents: RegallocSinglePassUseEvent[]
        callOpIndices: int32[]
        lastRecordedOpIndex: int32 = -1
        mode: int32
        sealed: bool
        valid: bool

    RegallocSinglePassAction =
        kind: int32
        placement: int32
        opIndex: int32
        slotIndex: int32
        sourceReg: int32 = -1
        targetReg: int32 = -1

    RegallocSinglePassState =
        # SoA is deliberate: stable O(slots) storage and no nested AoS row writes.
        valueDefined: bool[]
        valueLocationKinds: int32[]
        valueAssignedRegs: int32[]
        valueNextUseEventIndices: int32[]
        valueNextUseOpIndices: int32[]
        valueStackValid: bool[]
        valuePinnedCurrentOp: bool[]
        pinnedSlots: int32[]
        callerRegs: int32[]
        callerOwners: int32[]
        calleeRegs: int32[]
        calleeOwners: int32[]
        calleeEverUsed: bool[]
        pendingActions: RegallocSinglePassAction[]
        currentOpIndex: int32 = -1
        currentOpIsCall: bool
        currentOpPhase: int32
        nextUseEventCursor: int32
        currentOpUseEndCursor: int32
        nextCallCursor: int32
        spillCount: int32
        reloadCount: int32
        bindCount: int32
        dropCount: int32
        storeDefCount: int32
        valid: bool

fn RegallocSinglePassFactsInit(slotCount: int32,
                               facts: var RegallocSinglePassFacts): bool =
    if slotCount < 0:
        return false
    facts.slotCount = slotCount
    facts.defOpBySlot = []
    facts.firstUseEventBySlot = []
    facts.lastUseEventBySlot = []
    facts.useEvents = []
    facts.callOpIndices = []
    facts.lastRecordedOpIndex = -1
    facts.mode = RegallocSinglePassFactsModeLinearTrace
    facts.sealed = false
    facts.valid = true
    for _ in 0..<slotCount:
        add(facts.defOpBySlot, RegallocSinglePassUndefinedDef)
        add(facts.firstUseEventBySlot, RegallocSinglePassNoIndex)
        add(facts.lastUseEventBySlot, RegallocSinglePassNoIndex)
    return true

fn RegallocSinglePassRecordInput(facts: var RegallocSinglePassFacts,
                                  slotIndex: int32): bool =
    if !facts.valid || facts.sealed || facts.lastRecordedOpIndex >= 0:
        return false
    if slotIndex < 0 || slotIndex >= facts.slotCount:
        return false
    if facts.defOpBySlot[slotIndex] != RegallocSinglePassUndefinedDef:
        return false
    facts.defOpBySlot[slotIndex] = RegallocSinglePassInputDef
    return true

fn RegallocSinglePassRecordDef(facts: var RegallocSinglePassFacts,
                                slotIndex: int32,
                                opIndex: int32): bool =
    if !facts.valid || facts.sealed || opIndex < 0:
        return false
    if slotIndex < 0 || slotIndex >= facts.slotCount:
        return false
    if opIndex < facts.lastRecordedOpIndex:
        return false
    if facts.defOpBySlot[slotIndex] != RegallocSinglePassUndefinedDef:
        return false
    facts.defOpBySlot[slotIndex] = opIndex
    facts.lastRecordedOpIndex = opIndex
    return true

fn RegallocSinglePassRecordUse(facts: var RegallocSinglePassFacts,
                                slotIndex: int32,
                                opIndex: int32): bool =
    if !facts.valid || facts.sealed || opIndex < 0:
        return false
    if slotIndex < 0 || slotIndex >= facts.slotCount:
        return false
    if opIndex < facts.lastRecordedOpIndex:
        return false
    let defOp = facts.defOpBySlot[slotIndex]
    if defOp == RegallocSinglePassUndefinedDef || defOp >= opIndex:
        return false
    let eventIndex = facts.useEvents.len
    var event: RegallocSinglePassUseEvent
    event.opIndex = opIndex
    event.slotIndex = slotIndex
    event.nextUseEventIndex = RegallocSinglePassNoIndex
    let priorIndex = facts.lastUseEventBySlot[slotIndex]
    if priorIndex >= 0:
        var prior = facts.useEvents[priorIndex]
        prior.nextUseEventIndex = eventIndex
        facts.useEvents[priorIndex] = prior
    else:
        facts.firstUseEventBySlot[slotIndex] = eventIndex
    add(facts.useEvents, event)
    facts.lastUseEventBySlot[slotIndex] = eventIndex
    facts.lastRecordedOpIndex = opIndex
    return true

fn RegallocSinglePassRecordCall(facts: var RegallocSinglePassFacts,
                                 opIndex: int32): bool =
    if !facts.valid || facts.sealed || opIndex < 0:
        return false
    if opIndex < facts.lastRecordedOpIndex:
        return false
    if facts.callOpIndices.len > 0:
        if facts.callOpIndices[facts.callOpIndices.len - 1] >= opIndex:
            return false
    add(facts.callOpIndices, opIndex)
    facts.lastRecordedOpIndex = opIndex
    return true

fn RegallocSinglePassFactsSealLinear(facts: var RegallocSinglePassFacts,
                                     blockCount: int32,
                                     edgeCount: int32): bool =
    if !facts.valid || facts.sealed:
        return false
    if facts.mode != RegallocSinglePassFactsModeLinearTrace:
        return false
    if blockCount < 0 || blockCount > 1 || edgeCount != 0:
        return false
    if facts.lastRecordedOpIndex >= 0 && blockCount != 1:
        return false
    facts.sealed = true
    return true

fn regallocSinglePassUseOp(facts: var RegallocSinglePassFacts,
                            eventIndex: int32): int32 =
    if eventIndex < 0 || eventIndex >= facts.useEvents.len:
        return RegallocSinglePassNoIndex
    return facts.useEvents[eventIndex].opIndex

@borrows
fn regallocSinglePassPoolsValid(callerRegs: int32[],
                                 calleeRegs: int32[]): bool =
    for i in 0..<callerRegs.len:
        if callerRegs[i] < 0:
            return false
        if i > 0 && callerRegs[i - 1] >= callerRegs[i]:
            return false
        for j in 0..<calleeRegs.len:
            if callerRegs[i] == calleeRegs[j]:
                return false
    for i in 0..<calleeRegs.len:
        if calleeRegs[i] < 0:
            return false
        if i > 0 && calleeRegs[i - 1] >= calleeRegs[i]:
            return false
    return true

fn RegallocSinglePassStateInit(facts: var RegallocSinglePassFacts,
                               callerRegs: int32[],
                               calleeRegs: int32[],
                               state: var RegallocSinglePassState): bool =
    if !facts.valid || !facts.sealed ||
       facts.mode != RegallocSinglePassFactsModeLinearTrace:
        return false
    if !regallocSinglePassPoolsValid(callerRegs, calleeRegs):
        return false
    state.valueDefined = []
    state.valueLocationKinds = []
    state.valueAssignedRegs = []
    state.valueNextUseEventIndices = []
    state.valueNextUseOpIndices = []
    state.valueStackValid = []
    state.valuePinnedCurrentOp = []
    state.pinnedSlots = []
    state.callerRegs = callerRegs
    state.calleeRegs = calleeRegs
    state.callerOwners = []
    state.calleeOwners = []
    state.calleeEverUsed = []
    state.pendingActions = []
    state.currentOpIndex = -1
    state.currentOpIsCall = false
    state.currentOpPhase = RegallocSinglePassPhaseIdle
    state.nextUseEventCursor = 0
    state.currentOpUseEndCursor = 0
    state.nextCallCursor = 0
    state.spillCount = 0
    state.reloadCount = 0
    state.bindCount = 0
    state.dropCount = 0
    state.storeDefCount = 0
    state.valid = true
    for _ in 0..<facts.slotCount:
        add(state.valueDefined, false)
        add(state.valueLocationKinds, RegallocSinglePassLocationDead)
        add(state.valueAssignedRegs, RegallocSinglePassNoIndex)
        add(state.valueNextUseEventIndices, RegallocSinglePassNoIndex)
        add(state.valueNextUseOpIndices, RegallocSinglePassNoIndex)
        add(state.valueStackValid, false)
        add(state.valuePinnedCurrentOp, false)
    for _ in 0..<callerRegs.len:
        add(state.callerOwners, RegallocSinglePassNoIndex)
    for _ in 0..<calleeRegs.len:
        add(state.calleeOwners, RegallocSinglePassNoIndex)
        add(state.calleeEverUsed, false)
    return true

# Centralized SoA writes. The index is already proved by the caller; an invalid
# index crashes at the array write instead of silently continuing. An unknown
# column poisons the state.
fn regallocSinglePassStateSetInt32(state: var RegallocSinglePassState,
                                   column: int32,
                                   index: int32,
                                   value: int32) =
    if column == RegallocSinglePassIntColumnValueLocation:
        state.valueLocationKinds[index] = value
        return
    if column == RegallocSinglePassIntColumnValueAssignedReg:
        state.valueAssignedRegs[index] = value
        return
    if column == RegallocSinglePassIntColumnValueNextUseEvent:
        state.valueNextUseEventIndices[index] = value
        return
    if column == RegallocSinglePassIntColumnValueNextUseOp:
        state.valueNextUseOpIndices[index] = value
        return
    if column == RegallocSinglePassIntColumnCallerOwner:
        state.callerOwners[index] = value
        return
    if column == RegallocSinglePassIntColumnCalleeOwner:
        state.calleeOwners[index] = value
        return
    state.valid = false

fn regallocSinglePassStateSetBool(state: var RegallocSinglePassState,
                                  column: int32,
                                  index: int32,
                                  value: bool) =
    if column == RegallocSinglePassBoolColumnValueDefined:
        state.valueDefined[index] = value
        return
    if column == RegallocSinglePassBoolColumnValueStackValid:
        state.valueStackValid[index] = value
        return
    if column == RegallocSinglePassBoolColumnCalleeEverUsed:
        state.calleeEverUsed[index] = value
        return
    if column == RegallocSinglePassBoolColumnValuePinnedCurrentOp:
        state.valuePinnedCurrentOp[index] = value
        return
    state.valid = false

fn regallocSinglePassAddAction(state: var RegallocSinglePassState,
                                kind: int32,
                                placement: int32,
                                slotIndex: int32,
                                sourceReg: int32,
                                targetReg: int32) =
    var action: RegallocSinglePassAction
    action.kind = kind
    action.placement = placement
    action.opIndex = state.currentOpIndex
    action.slotIndex = slotIndex
    action.sourceReg = sourceReg
    action.targetReg = targetReg
    add(state.pendingActions, action)
    if kind == RegallocSinglePassActionBindDef:
        state.bindCount = state.bindCount + 1
    elif kind == RegallocSinglePassActionReload:
        state.reloadCount = state.reloadCount + 1
    elif kind == RegallocSinglePassActionSpill:
        state.spillCount = state.spillCount + 1
    elif kind == RegallocSinglePassActionDrop:
        state.dropCount = state.dropCount + 1
    elif kind == RegallocSinglePassActionStoreDef:
        state.storeDefCount = state.storeDefCount + 1

fn regallocSinglePassReleaseOwner(state: var RegallocSinglePassState,
                                   slotIndex: int32,
                                   reg: int32): bool =
    for i in 0..<state.callerRegs.len:
        if state.callerRegs[i] == reg && state.callerOwners[i] == slotIndex:
            regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnCallerOwner,
                                   i,
                                       RegallocSinglePassNoIndex)
            return true
    for i in 0..<state.calleeRegs.len:
        if state.calleeRegs[i] == reg && state.calleeOwners[i] == slotIndex:
            regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnCalleeOwner,
                                   i,
                                       RegallocSinglePassNoIndex)
            return true
    return false

fn regallocSinglePassPinCurrentOp(state: var RegallocSinglePassState,
                                  slotIndex: int32): bool =
    if state.valuePinnedCurrentOp[slotIndex]:
        return true
    regallocSinglePassStateSetBool(state,
                                  RegallocSinglePassBoolColumnValuePinnedCurrentOp,
                                  slotIndex,
                                  true)
    add(state.pinnedSlots, slotIndex)
    return state.valid

fn regallocSinglePassEvict(state: var RegallocSinglePassState,
                            slotIndex: int32): bool =
    if state.valuePinnedCurrentOp[slotIndex]:
        state.valid = false
        return false
    let reg = state.valueAssignedRegs[slotIndex]
    if reg < 0 || !regallocSinglePassReleaseOwner(state, slotIndex, reg):
        state.valid = false
        return false
    if state.valueStackValid[slotIndex]:
        regallocSinglePassAddAction(state,
                                    RegallocSinglePassActionDrop,
                                    RegallocSinglePassPlacementBeforeOp,
                                    slotIndex,
                                    reg,
                                    RegallocSinglePassNoIndex)
    else:
        regallocSinglePassAddAction(state,
                                    RegallocSinglePassActionSpill,
                                    RegallocSinglePassPlacementBeforeOp,
                                    slotIndex,
                                    reg,
                                    RegallocSinglePassNoIndex)
    regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueLocation,
                                   slotIndex,
                               RegallocSinglePassLocationStack)
    regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueAssignedReg,
                                   slotIndex,
                               RegallocSinglePassNoIndex)
    regallocSinglePassStateSetBool(state,
                                  RegallocSinglePassBoolColumnValueStackValid,
                                  slotIndex, true)
    return true

fn regallocSinglePassBindBand(state: var RegallocSinglePassState,
                              slotIndex: int32,
                              incomingPriorityUseOpIndex: int32,
                              useCalleeBand: bool): int32 =
    var freeIndex: int32 = -1
    var victimIndex: int32 = -1
    var victimNextUse: int32 = -1
    var victimReg: int32 = -1
    if useCalleeBand:
        for i in 0..<state.calleeRegs.len:
            let owner = state.calleeOwners[i]
            if owner < 0:
                if freeIndex < 0:
                    freeIndex = i
                continue
            if state.valuePinnedCurrentOp[owner]:
                continue
            let ownerNextUse = state.valueNextUseOpIndices[owner]
            if ownerNextUse > victimNextUse ||
               (ownerNextUse == victimNextUse && state.calleeRegs[i] > victimReg):
                victimIndex = i
                victimNextUse = ownerNextUse
                victimReg = state.calleeRegs[i]
        if freeIndex >= 0:
            regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnCalleeOwner,
                                   freeIndex, slotIndex)
            regallocSinglePassStateSetBool(state,
                                  RegallocSinglePassBoolColumnCalleeEverUsed,
                                  freeIndex, true)
            return state.calleeRegs[freeIndex]
        if victimIndex < 0 || incomingPriorityUseOpIndex >= victimNextUse:
            return RegallocSinglePassNoIndex
        let victimSlot = state.calleeOwners[victimIndex]
        if !regallocSinglePassEvict(state, victimSlot):
            return RegallocSinglePassNoIndex
        regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnCalleeOwner,
                                   victimIndex, slotIndex)
        regallocSinglePassStateSetBool(state,
                                  RegallocSinglePassBoolColumnCalleeEverUsed,
                                  victimIndex, true)
        return state.calleeRegs[victimIndex]
    for i in 0..<state.callerRegs.len:
        let owner = state.callerOwners[i]
        if owner < 0:
            if freeIndex < 0:
                freeIndex = i
            continue
        if state.valuePinnedCurrentOp[owner]:
            continue
        let ownerNextUse = state.valueNextUseOpIndices[owner]
        if ownerNextUse > victimNextUse ||
           (ownerNextUse == victimNextUse && state.callerRegs[i] > victimReg):
            victimIndex = i
            victimNextUse = ownerNextUse
            victimReg = state.callerRegs[i]
    if freeIndex >= 0:
        regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnCallerOwner,
                                   freeIndex, slotIndex)
        return state.callerRegs[freeIndex]
    if victimIndex < 0 || incomingPriorityUseOpIndex >= victimNextUse:
        return RegallocSinglePassNoIndex
    let victimSlot = state.callerOwners[victimIndex]
    if !regallocSinglePassEvict(state, victimSlot):
        return RegallocSinglePassNoIndex
    regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnCallerOwner,
                                   victimIndex, slotIndex)
    return state.callerRegs[victimIndex]

fn regallocSinglePassCrossesNextCall(state: var RegallocSinglePassState,
                                     facts: var RegallocSinglePassFacts,
                                     nextUseOpIndex: int32): bool =
    if nextUseOpIndex < 0 || state.nextCallCursor >= facts.callOpIndices.len:
        return false
    return facts.callOpIndices[state.nextCallCursor] < nextUseOpIndex

fn regallocSinglePassBind(state: var RegallocSinglePassState,
                          facts: var RegallocSinglePassFacts,
                          slotIndex: int32,
                          incomingPriorityUseOpIndex: int32): int32 =
    let nextUse = state.valueNextUseOpIndices[slotIndex]
    let crossesCall = nextUse >= 0 &&
                      regallocSinglePassCrossesNextCall(state, facts, nextUse)
    if crossesCall:
        let calleeReg = regallocSinglePassBindBand(state,
                                                   slotIndex,
                                                   incomingPriorityUseOpIndex,
                                                   true)
        if calleeReg >= 0:
            return calleeReg
    let callerReg = regallocSinglePassBindBand(state,
                                               slotIndex,
                                               incomingPriorityUseOpIndex,
                                               false)
    if callerReg >= 0:
        return callerReg
    if !crossesCall:
        return regallocSinglePassBindBand(state,
                                          slotIndex,
                                          incomingPriorityUseOpIndex,
                                          true)
    return RegallocSinglePassNoIndex

fn RegallocSinglePassSeedInput(state: var RegallocSinglePassState,
                               facts: var RegallocSinglePassFacts,
                               slotIndex: int32): bool =
    if !state.valid || state.currentOpIndex >= 0:
        return false
    if slotIndex < 0 || slotIndex >= state.valueDefined.len:
        return false
    if facts.defOpBySlot[slotIndex] != RegallocSinglePassInputDef:
        return false
    if state.valueDefined[slotIndex]:
        return false
    regallocSinglePassStateSetBool(state,
                                  RegallocSinglePassBoolColumnValueDefined,
                                  slotIndex, true)
    regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueLocation,
                                   slotIndex,
                               RegallocSinglePassLocationStack)
    regallocSinglePassStateSetBool(state,
                                  RegallocSinglePassBoolColumnValueStackValid,
                                  slotIndex, true)
    regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueNextUseEvent,
                                   slotIndex,
                               facts.firstUseEventBySlot[slotIndex])
    regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueNextUseOp,
                                   slotIndex,
                               regallocSinglePassUseOp(facts,
                                               state.valueNextUseEventIndices[slotIndex]))
    if state.valueNextUseOpIndices[slotIndex] < 0:
        regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueLocation,
                                   slotIndex,
                                   RegallocSinglePassLocationDead)
        regallocSinglePassStateSetBool(state,
                                  RegallocSinglePassBoolColumnValueStackValid,
                                  slotIndex,
                                  false)
    return true

fn RegallocSinglePassBeginOp(state: var RegallocSinglePassState,
                             facts: var RegallocSinglePassFacts,
                             opIndex: int32): bool =
    if !state.valid || state.pendingActions.len != 0 ||
       state.currentOpPhase != RegallocSinglePassPhaseIdle ||
       state.pinnedSlots.len != 0:
        return false
    if opIndex < 0 || opIndex <= state.currentOpIndex:
        return false
    if state.nextCallCursor < facts.callOpIndices.len &&
       facts.callOpIndices[state.nextCallCursor] < opIndex:
        return false
    if state.nextUseEventCursor < facts.useEvents.len &&
       facts.useEvents[state.nextUseEventCursor].opIndex < opIndex:
        return false
    var useEndCursor = state.nextUseEventCursor
    for i in state.nextUseEventCursor..<facts.useEvents.len:
        if facts.useEvents[i].opIndex != opIndex:
            break
        useEndCursor = i + 1
    state.currentOpIndex = opIndex
    state.currentOpIsCall = state.nextCallCursor < facts.callOpIndices.len &&
                            facts.callOpIndices[state.nextCallCursor] == opIndex
    state.currentOpPhase = RegallocSinglePassPhaseReads
    state.currentOpUseEndCursor = useEndCursor
    return true

fn RegallocSinglePassClearActions(state: var RegallocSinglePassState) =
    # Consumer acknowledgement only: every action must already have been
    # consumed in ActionAt ordinal order. This is never a discard operation.
    state.pendingActions = []

fn RegallocSinglePassDefine(state: var RegallocSinglePassState,
                            facts: var RegallocSinglePassFacts,
                            slotIndex: int32): bool =
    if !state.valid || state.currentOpIndex < 0:
        return false
    if state.nextUseEventCursor != state.currentOpUseEndCursor:
        return false
    if state.currentOpIsCall:
        if state.currentOpPhase != RegallocSinglePassPhaseCallDone:
            return false
    elif state.currentOpPhase != RegallocSinglePassPhaseReads:
        return false
    if slotIndex < 0 || slotIndex >= state.valueDefined.len:
        return false
    if facts.defOpBySlot[slotIndex] != state.currentOpIndex:
        return false
    if state.valueDefined[slotIndex]:
        return false
    regallocSinglePassStateSetBool(state,
                                  RegallocSinglePassBoolColumnValueDefined,
                                  slotIndex, true)
    regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueLocation,
                                   slotIndex,
                               RegallocSinglePassLocationStack)
    regallocSinglePassStateSetBool(state,
                                  RegallocSinglePassBoolColumnValueStackValid,
                                  slotIndex, false)
    regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueNextUseEvent,
                                   slotIndex,
                               facts.firstUseEventBySlot[slotIndex])
    regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueNextUseOp,
                                   slotIndex,
                               regallocSinglePassUseOp(facts,
                                               state.valueNextUseEventIndices[slotIndex]))
    if state.valueNextUseOpIndices[slotIndex] < 0:
        regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueLocation,
                                   slotIndex,
                                   RegallocSinglePassLocationDead)
        state.currentOpPhase = RegallocSinglePassPhaseDefined
        return true
    let reg = regallocSinglePassBind(state,
                                     facts,
                                     slotIndex,
                                     state.valueNextUseOpIndices[slotIndex])
    if reg >= 0:
        regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueLocation,
                                   slotIndex,
                                   RegallocSinglePassLocationRegister)
        regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueAssignedReg,
                                   slotIndex, reg)
        regallocSinglePassStateSetBool(state,
                                  RegallocSinglePassBoolColumnValueStackValid,
                                  slotIndex, false)
        regallocSinglePassAddAction(state,
                                    RegallocSinglePassActionBindDef,
                                    RegallocSinglePassPlacementResultAfterOp,
                                    slotIndex,
                                    RegallocSinglePassNoIndex,
                                    reg)
    else:
        regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueLocation,
                                   slotIndex,
                                   RegallocSinglePassLocationStack)
        regallocSinglePassAddAction(state,
                                    RegallocSinglePassActionStoreDef,
                                    RegallocSinglePassPlacementResultAfterOp,
                                    slotIndex,
                                    RegallocSinglePassNoIndex,
                                    RegallocSinglePassNoIndex)
        regallocSinglePassStateSetBool(state,
                                  RegallocSinglePassBoolColumnValueStackValid,
                                  slotIndex, true)
    state.currentOpPhase = RegallocSinglePassPhaseDefined
    return state.valid

fn RegallocSinglePassRead(state: var RegallocSinglePassState,
                          facts: var RegallocSinglePassFacts,
                          slotIndex: int32): int32 =
    if !state.valid || state.currentOpIndex < 0 ||
       state.currentOpPhase != RegallocSinglePassPhaseReads:
        return RegallocSinglePassReadError
    if slotIndex < 0 || slotIndex >= state.valueDefined.len:
        return RegallocSinglePassReadError
    if !state.valueDefined[slotIndex] ||
       state.valueNextUseEventIndices[slotIndex] < 0:
        return RegallocSinglePassReadError
    if state.nextUseEventCursor >= state.currentOpUseEndCursor ||
       state.valueNextUseEventIndices[slotIndex] != state.nextUseEventCursor:
        return RegallocSinglePassReadError
    let event = facts.useEvents[state.valueNextUseEventIndices[slotIndex]]
    if event.slotIndex != slotIndex || event.opIndex != state.currentOpIndex:
        return RegallocSinglePassReadError
    let priorLocation = state.valueLocationKinds[slotIndex]
    var priorReg: int32
    priorReg = RegallocSinglePassNoIndex
    if priorLocation == RegallocSinglePassLocationRegister:
        priorReg = state.valueAssignedRegs[slotIndex]
        if priorReg < 0:
            state.valid = false
            return RegallocSinglePassReadError
    elif priorLocation == RegallocSinglePassLocationStack:
        if !state.valueStackValid[slotIndex]:
            state.valid = false
            return RegallocSinglePassReadError
    else:
        state.valid = false
        return RegallocSinglePassReadError
    regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueNextUseEvent,
                                   slotIndex,
                               event.nextUseEventIndex)
    regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueNextUseOp,
                                   slotIndex,
                               regallocSinglePassUseOp(facts,
                                                        event.nextUseEventIndex))
    var readReg: int32
    readReg = priorReg
    if priorLocation == RegallocSinglePassLocationStack:
        let reg = regallocSinglePassBind(state,
                                         facts,
                                         slotIndex,
                                         state.currentOpIndex)
        if reg < 0:
            state.valid = false
            return RegallocSinglePassReadError
        regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueLocation,
                                   slotIndex,
                                   RegallocSinglePassLocationRegister)
        regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueAssignedReg,
                                   slotIndex, reg)
        regallocSinglePassAddAction(state,
                                    RegallocSinglePassActionReload,
                                    RegallocSinglePassPlacementBeforeOp,
                                    slotIndex,
                                    RegallocSinglePassNoIndex,
                                    reg)
        readReg = reg
    if !regallocSinglePassPinCurrentOp(state, slotIndex):
        return RegallocSinglePassReadError
    state.nextUseEventCursor = state.nextUseEventCursor + 1
    return readReg

fn RegallocSinglePassCall(state: var RegallocSinglePassState,
                          facts: var RegallocSinglePassFacts): bool =
    if !state.valid || state.currentOpIndex < 0 ||
       !state.currentOpIsCall ||
       state.currentOpPhase != RegallocSinglePassPhaseReads:
        return false
    if state.nextUseEventCursor != state.currentOpUseEndCursor:
        return false
    if state.nextCallCursor < 0 || state.nextCallCursor >= facts.callOpIndices.len:
        return false
    if facts.callOpIndices[state.nextCallCursor] != state.currentOpIndex:
        return false
    for i in 0..<state.callerRegs.len:
        let slotIndex = state.callerOwners[i]
        if slotIndex < 0:
            continue
        let nextUseOpIndex = state.valueNextUseOpIndices[slotIndex]
        if nextUseOpIndex == state.currentOpIndex:
            state.valid = false
            return false
        if nextUseOpIndex < 0:
            if !state.valuePinnedCurrentOp[slotIndex]:
                state.valid = false
                return false
            continue
        if state.valueStackValid[slotIndex]:
            regallocSinglePassAddAction(state,
                                        RegallocSinglePassActionDrop,
                                        RegallocSinglePassPlacementBeforeOp,
                                        slotIndex,
                                        state.callerRegs[i],
                                        RegallocSinglePassNoIndex)
        else:
            regallocSinglePassAddAction(state,
                                        RegallocSinglePassActionSpill,
                                        RegallocSinglePassPlacementBeforeOp,
                                        slotIndex,
                                        state.callerRegs[i],
                                        RegallocSinglePassNoIndex)
        regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueLocation,
                                   slotIndex,
                                   RegallocSinglePassLocationStack)
        regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueAssignedReg,
                                   slotIndex,
                                   RegallocSinglePassNoIndex)
        regallocSinglePassStateSetBool(state,
                                  RegallocSinglePassBoolColumnValueStackValid,
                                  slotIndex, true)
        regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnCallerOwner,
                                   i,
                                   RegallocSinglePassNoIndex)
    state.nextCallCursor = state.nextCallCursor + 1
    state.currentOpPhase = RegallocSinglePassPhaseCallDone
    return true

fn RegallocSinglePassEndOp(state: var RegallocSinglePassState): bool =
    if !state.valid || state.currentOpIndex < 0 ||
       state.currentOpPhase == RegallocSinglePassPhaseIdle ||
       state.pendingActions.len != 0:
        return false
    if state.nextUseEventCursor != state.currentOpUseEndCursor:
        state.valid = false
        return false
    if state.currentOpIsCall:
        if state.currentOpPhase != RegallocSinglePassPhaseCallDone &&
           state.currentOpPhase != RegallocSinglePassPhaseDefined:
            return false
    elif state.currentOpPhase != RegallocSinglePassPhaseReads &&
         state.currentOpPhase != RegallocSinglePassPhaseDefined:
        return false
    for i in 0..<state.pinnedSlots.len:
        let slotIndex = state.pinnedSlots[i]
        if !state.valuePinnedCurrentOp[slotIndex]:
            state.valid = false
            return false
        if state.valueNextUseOpIndices[slotIndex] < 0:
            let location = state.valueLocationKinds[slotIndex]
            if location == RegallocSinglePassLocationRegister:
                if !regallocSinglePassReleaseOwner(state,
                                                   slotIndex,
                                                   state.valueAssignedRegs[slotIndex]):
                    state.valid = false
                    return false
            elif location != RegallocSinglePassLocationStack:
                state.valid = false
                return false
            regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueLocation,
                                   slotIndex,
                                   RegallocSinglePassLocationDead)
            regallocSinglePassStateSetInt32(state,
                                   RegallocSinglePassIntColumnValueAssignedReg,
                                   slotIndex,
                                   RegallocSinglePassNoIndex)
            regallocSinglePassStateSetBool(state,
                                  RegallocSinglePassBoolColumnValueStackValid,
                                  slotIndex,
                                  false)
        regallocSinglePassStateSetBool(state,
                                  RegallocSinglePassBoolColumnValuePinnedCurrentOp,
                                  slotIndex,
                                  false)
    state.pinnedSlots = []
    state.currentOpIsCall = false
    state.currentOpPhase = RegallocSinglePassPhaseIdle
    return state.valid

fn RegallocSinglePassFinish(state: var RegallocSinglePassState,
                            facts: var RegallocSinglePassFacts): bool =
    if !state.valid || state.pendingActions.len != 0 ||
       state.currentOpPhase != RegallocSinglePassPhaseIdle ||
       state.pinnedSlots.len != 0 || state.currentOpIsCall:
        return false
    if state.nextCallCursor != facts.callOpIndices.len:
        return false
    if state.nextUseEventCursor != facts.useEvents.len:
        return false
    for i in 0..<state.valueDefined.len:
        let hasDefinition = facts.defOpBySlot[i] != RegallocSinglePassUndefinedDef
        if hasDefinition != state.valueDefined[i]:
            return false
        if hasDefinition && state.valueNextUseEventIndices[i] >= 0:
            return false
        if state.valuePinnedCurrentOp[i]:
            return false
        if hasDefinition &&
           (state.valueLocationKinds[i] != RegallocSinglePassLocationDead ||
            state.valueAssignedRegs[i] != RegallocSinglePassNoIndex ||
            state.valueStackValid[i]):
            return false
    for i in 0..<state.callerOwners.len:
        if state.callerOwners[i] >= 0:
            return false
    for i in 0..<state.calleeOwners.len:
        if state.calleeOwners[i] >= 0:
            return false
    return true

fn RegallocSinglePassValueReg(state: var RegallocSinglePassState,
                              slotIndex: int32): int32 =
    if slotIndex < 0 || slotIndex >= state.valueDefined.len:
        return RegallocSinglePassNoIndex
    if state.valueLocationKinds[slotIndex] != RegallocSinglePassLocationRegister:
        return RegallocSinglePassNoIndex
    return state.valueAssignedRegs[slotIndex]

fn RegallocSinglePassActionCount(state: var RegallocSinglePassState): int32 =
    return state.pendingActions.len

fn RegallocSinglePassActionAt(state: var RegallocSinglePassState,
                              actionIndex: int32,
                              action: var RegallocSinglePassAction): bool =
    if actionIndex < 0 || actionIndex >= state.pendingActions.len:
        return false
    action = state.pendingActions[actionIndex]
    return true

fn RegallocSinglePassCalleeEverUsed(state: var RegallocSinglePassState,
                                    reg: int32): bool =
    for i in 0..<state.calleeRegs.len:
        if state.calleeRegs[i] == reg:
            return state.calleeEverUsed[i]
    return false

# CFG/value allocator -------------------------------------------------------
#
# Reachable blocks are numbered once in RPO position order.  Merge inputs are
# real uses at predecessor exit (plus the virtual function-entry edge), so a
# loop-carried/self merge has one forward interval ending at its backedge use.
# Uses are stored as value CSR, never as a dense value-by-position matrix.
# Build cost is O(F + E + U + A + P*63 + V*R), R <= 63; memory is linear in
# values, uses, CFG edges, positions and frozen actions.  No phase scans V*V.

const
    RegallocValuePlanErrorNone = 0
    RegallocValuePlanErrorAccess = 1
    RegallocValuePlanErrorCfg = 2
    RegallocValuePlanErrorConstraintDuplicate = 3
    RegallocValuePlanErrorUnknownRegister = 4
    RegallocValuePlanErrorConstraintOverlap = 5
    RegallocValuePlanErrorConstraintShape = 6
    RegallocValuePlanErrorFixedMissing = 7
    RegallocValuePlanErrorFactShape = 8
    RegallocValuePlanErrorOperandPressure = 9
    RegallocValuePlanErrorAckOrder = 10
    RegallocValuePlanErrorUnacknowledged = 11
    RegallocValuePlanErrorFixedConflict = 12
    RegallocValuePlanErrorIntervalShape = 13
    RegallocValuePlanErrorActionShape = 14
    RegallocValuePlanErrorCalleeMask = 15
    RegallocValuePlanErrorParallelCopy = 16
    RegallocValuePlanErrorActionNotIssued = 17
    RegallocValuePlanErrorEmissionShape = 18
    RegallocValuePlanErrorSemanticRoot = 19
    RegallocValuePlanErrorBodyIrIngress = 20

    RegallocValueClassDead = 0
    RegallocValueClassGpr = 1
    RegallocValueClassStack = 2
    RegallocValueClassAddressHome = 3

    RegallocValueLocationNone = 0
    RegallocValueLocationStack = 1
    RegallocValueLocationRegister = 2
    RegallocValueLocationAddress = 3
    RegallocValueLocationConstant = 4

    RegallocValueUseFact = 1
    RegallocValueUseMergeEdge = 2

    RegallocValueActionEntryReload = 101
    RegallocValueActionReloadOperand = 102
    RegallocValueActionSpillTemporary = 103
    RegallocValueActionRestoreTemporary = 104
    RegallocValueActionBindDef = 105
    RegallocValueActionStoreDef = 106
    RegallocValueActionStoreHome = 107
    RegallocValueActionMoveFixed = 108
    RegallocValueActionLoadFixed = 109
    RegallocValueActionAddressFixed = 110
    RegallocValueActionBindFixedResult = 111
    RegallocValueActionStoreFixedResult = 112
    RegallocValueActionSpillCall = 113
    RegallocValueActionReloadCall = 114
    RegallocValueActionEdgeParallelCopy = 115
    RegallocValueActionBindSretResult = 116
    RegallocValueActionStoreSretReturn = 117
    RegallocValueActionStoreStackArg = 118
    RegallocValueActionParallelScratchSave = 119
    RegallocValueActionParallelScratchRestore = 120
    RegallocValueActionCallClobber = 121
    RegallocValueActionValueClassification = 122
    RegallocValueActionLivenessInterval = 123
    RegallocValueActionSretExclusion = 124
    RegallocValueActionAddressEscapeHome = 125
    RegallocValueActionCalleeSavedSelection = 126
    RegallocValueActionDeadValue = 127
    RegallocValueActionCoalescedCopy = 128
    RegallocValueActionSretForward = 129
    RegallocValueActionBindCallWriteHome = 130

    RegallocValueBindingMachine = 1
    RegallocValueBindingStructural = 2

    RegallocValueEmptySha256 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

    RegallocValuePlacementBeforeOp = 1
    RegallocValuePlacementAfterOp = 2
    RegallocValuePlacementBeforeTerm = 3
    RegallocValuePlacementAfterTerm = 4
    RegallocValuePlacementBlockEntry = 5
    RegallocValuePlacementBlockExit = 6
    RegallocValuePlacementEdge = 7
    RegallocValuePlacementFunctionEntry = 8

type
    RegallocTargetConstraints =
        registerUniverse: int32[]
        allocatableCallerRegs: int32[]
        allocatableCalleeRegs: int32[]
        reservedRegs: int32[]
        callClobberRegs: int32[]
        fixedArgRegs: int32[]
        fixedResultReg: int32 = -1
        fixedSretReg: int32 = -1
        sretShiftsFixedArgs: bool
        fixedReturnReg: int32 = -1
        parallelCopyScratchReg: int32 = -1
        packedStackArgs: bool
        stackArgSlotBytes: int32 = 8
        stackAlignmentBytes: int32 = 16
        gprTypeKinds: int32[]

    RegallocValueAction =
        consumerOrdinal: int32
        acknowledged: bool
        kind: int32
        placement: int32
        position: int32
        blockIndex: int32 = -1
        opIndex: int32 = -1
        termIndex: int32 = -1
        factIndex: int32 = -1
        valueId: int32 = -1
        otherValueId: int32 = -1
        sourceLocation: int32
        targetLocation: int32
        sourceReg: int32 = -1
        targetReg: int32 = -1
        sourceStackSlot: int32 = -1
        targetStackSlot: int32 = -1
        scratchReg: int32 = -1
        targetMemoryHome: bool
        sourceBlock: int32 = -1
        targetBlock: int32 = -1
        edgeIndex: int32 = -1
        requiresEdgeSplit: bool
        parallelGroup: int32 = -1
        parallelOrdinal: int32 = -1
        relatedActionOrdinal: int32 = -1
        fixedKind: int32
        fixedOrdinal: int32 = -1
        passKind: int32 = -1
        encodedValue: int32
        callOrdinal: int32 = -1
        abiSizeBytes: int32
        abiSizeExplicit: bool
        outgoingStackArgIndex: int32 = -1
        outgoingStackByteOffset: int32 = -1
        outgoingStackByteWidth: int32
        outgoingStackFrameBytes: int32
        semanticKind: int32
        semanticStart: int32 = -1
        semanticEnd: int32 = -1
        semanticRegister: int32 = -1
        fragmentOrdinal: int32 = -1
        effectSpLoad: bool
        effectSpStore: bool
        effectCall: bool
        effectX16: bool
        effectX17: bool

    RegallocValueActionTicket =
        valid: bool
        consumerOrdinal: int32 = -1
        actionSnapshot: RegallocValueAction
        kind: int32
        placement: int32
        position: int32
        factIndex: int32 = -1
        valueId: int32 = -1
        fixedOrdinal: int32 = -1
        ownerPlanSha256: str
        emissionOwnerSha256: str
        actionSemanticSha256: str

    RegallocValueActionEmission =
        consumerOrdinal: int32 = -1
        actionKind: int32
        actionPosition: int32
        symbolByteStart: int32
        symbolByteLength: int32
        emittedByteStart: int32
        emittedByteLength: int32
        emittedBytesSha256: str
        bindingKind: int32
        ownerPlanSha256: str
        emissionOwnerSha256: str
        actionSemanticSha256: str
        bindingSha256: str

    RegallocValueEmissionReceipt =
        valid: bool
        symbolName: str
        symbolByteStart: int32
        symbolByteLength: int32
        symbolBytesSha256: str
        actionCount: int32
        debugProvenanceSha256: str
        frozenSemanticSha256: str
        actionSemanticRootSha256: str
        actionBindingRootSha256: str
        machineFragmentCount: int32
        machineFragmentRootSha256: str
        riscvEncoderEventCount: int32
        riscvEncoderEventRootSha256: str
        abiIngressCount: int32
        abiIngressRootSha256: str
        receiptSha256: str
        actionEmissions: RegallocValueActionEmission[]

    RegallocValueEdgeCopy =
        edgeIndex: int32 = -1
        sourceBlock: int32 = -1
        targetBlock: int32
        sourceValue: int32
        targetValue: int32
        slotIndex: int32
        virtualEntry: bool

    RegallocParallelCopyExpansion =
        valid: bool
        errorCode: int32
        errorDetail: int32
        actions: RegallocValueAction[]

    RegallocSinglePassValuePlan =
        valid: bool
        errorCode: int32
        errorDetail: int32
        bodyIrIngressSha256: str
        debugProvenanceSha256: str
        frozen: bool
        finalized: bool
        emissionSymbolBound: bool
        emissionSymbolSealed: bool
        emissionSymbolName: str
        emissionSymbolByteStart: int32
        emissionSymbolByteLength: int32
        emissionSymbolBytesSha256: str
        frozenSemanticSha256: str
        actionSemanticRootSha256: str
        emissionOwnerSha256: str
        actionBindingRootSha256: str
        productionRecipeBound: bool
        machineFragmentCount: int32
        machineFragmentRootSha256: str
        riscvEncoderEventCount: int32
        riscvEncoderEventRootSha256: str
        riscvEncoderReceiptPrebound: bool
        abiIngressCount: int32
        abiIngressRootSha256: str
        sealedReceiptSha256: str
        lastMachineEmissionEnd: int32
        nextIssueOrdinal: int32
        nextAckOrdinal: int32
        actionIssued: bool[]
        actionEmissions: RegallocValueActionEmission[]
        constraints: RegallocTargetConstraints
        stackSlotCount: int32
        callCount: int32
        callArgCounts: int32[]
        callReachable: bool[]
        positionCount: int32
        blockEntryPositions: int32[]
        blockExitPositions: int32[]
        bodyOpKinds: int32[]
        bodyOpOperandCounts: int32[]
        opBeforePositions: int32[]
        opAfterPositions: int32[]
        termBeforePositions: int32[]
        termAfterPositions: int32[]
        valueDefPositions: int32[]
        valueDefFactIndices: int32[]
        valueDefBlocks: int32[]
        valueDefIsEntry: bool[]
        valueEndPositions: int32[]
        valueSlotIndices: int32[]
        valueTypeKinds: int32[]
        valueClasses: int32[]
        valueMemoryHomes: bool[]
        valueAssignedRegs: int32[]
        valueUseOffsets: int32[]
        valueUsePositions: int32[]
        valueUseFactIndices: int32[]
        valueUseKinds: int32[]
        valueUseSourceBlocks: int32[]
        valueUseTargetBlocks: int32[]
        callPositions: int32[]
        allocationOrder: int32[]
        regIntervalOffsets: int32[]
        regIntervalValues: int32[]
        operandRegByFact: int32[]
        accessFactRegisters: int32[]
        accessFactIsAllocatorClobber: bool[]
        accessFactBlockIndices: int32[]
        accessFactOpIndices: int32[]
        accessFactTermIndices: int32[]
        accessFactEdgeIndices: int32[]
        opActionStarts: int32[]
        opActionCounts: int32[]
        termActionStarts: int32[]
        termActionCounts: int32[]
        blockEntryActionStarts: int32[]
        blockEntryActionCounts: int32[]
        functionEntryActionStart: int32 = -1
        functionEntryActionCount: int32
        blockExitActionStarts: int32[]
        blockExitActionCounts: int32[]
        edgeSourceBlocks: int32[]
        edgeTargetBlocks: int32[]
        edgeActionStarts: int32[]
        edgeActionCounts: int32[]
        virtualEntryActionStarts: int32[]
        virtualEntryActionCounts: int32[]
        actions: RegallocValueAction[]
        usedCalleeMask: int64

fn RegallocTargetConstraintsInit(): RegallocTargetConstraints =
    var out: RegallocTargetConstraints
    out.fixedResultReg = -1
    out.fixedSretReg = -1
    out.fixedReturnReg = -1
    out.parallelCopyScratchReg = -1
    out.stackArgSlotBytes = 8
    out.stackAlignmentBytes = 16
    return out

fn regallocTargetConstraintsA64(
        packedStackArgs: bool): RegallocTargetConstraints =
    var out = RegallocTargetConstraintsInit()
    for reg in 0..<31:
        add(out.registerUniverse, reg)
    for reg in 9..<16:
        add(out.allocatableCallerRegs, reg)
    # Production prologue/return paths currently prove the contiguous
    # callee-saved band x19..x22. Widen only when R4 consumes usedCalleeMask.
    for reg in 19..<23:
        add(out.allocatableCalleeRegs, reg)
    for reg in 0..<9:
        add(out.reservedRegs, reg)
    add(out.reservedRegs, 16)
    add(out.reservedRegs, 17)
    add(out.reservedRegs, 18)
    add(out.reservedRegs, 29)
    add(out.reservedRegs, 30)
    for reg in 0..<19:
        add(out.callClobberRegs, reg)
    add(out.callClobberRegs, 30)
    for reg in 0..<8:
        add(out.fixedArgRegs, reg)
    out.fixedResultReg = 0
    out.fixedSretReg = 8
    out.fixedReturnReg = 0
    out.parallelCopyScratchReg = 16
    out.packedStackArgs = packedStackArgs
    add(out.gprTypeKinds, coreir.LocalI32Tag)
    add(out.gprTypeKinds, coreir.LocalPtrTag)
    add(out.gprTypeKinds, coreir.LocalI64Tag)
    return out

fn RegallocTargetConstraintsA64Darwin(): RegallocTargetConstraints =
    return regallocTargetConstraintsA64(true)

fn RegallocTargetConstraintsA64Linux(): RegallocTargetConstraints =
    return regallocTargetConstraintsA64(false)

@borrows
fn RegallocTargetConstraintsA64ForTarget(
        targetTriple: str): RegallocTargetConstraints =
    if targetTriple == "arm64-apple-darwin":
        return RegallocTargetConstraintsA64Darwin()
    if targetTriple != "aarch64-unknown-linux-gnu":
        panic("canonical AArch64 regalloc target unsupported")
    return RegallocTargetConstraintsA64Linux()

fn RegallocTargetConstraintsX64Linux(): RegallocTargetConstraints =
    var out = RegallocTargetConstraintsInit()
    for reg in 0..<16:
        add(out.registerUniverse, reg)
    add(out.allocatableCallerRegs, 10)
    add(out.allocatableCalleeRegs, 3)
    for reg in 12..<16:
        add(out.allocatableCalleeRegs, reg)
    add(out.reservedRegs, 0)
    add(out.reservedRegs, 1)
    add(out.reservedRegs, 2)
    add(out.reservedRegs, 4)
    add(out.reservedRegs, 5)
    add(out.reservedRegs, 6)
    add(out.reservedRegs, 7)
    add(out.reservedRegs, 8)
    add(out.reservedRegs, 9)
    add(out.reservedRegs, 11)
    add(out.callClobberRegs, 0)
    add(out.callClobberRegs, 1)
    add(out.callClobberRegs, 2)
    add(out.callClobberRegs, 6)
    add(out.callClobberRegs, 7)
    add(out.callClobberRegs, 8)
    add(out.callClobberRegs, 9)
    add(out.callClobberRegs, 10)
    add(out.callClobberRegs, 11)
    add(out.fixedArgRegs, 7)
    add(out.fixedArgRegs, 6)
    add(out.fixedArgRegs, 2)
    add(out.fixedArgRegs, 1)
    add(out.fixedArgRegs, 8)
    add(out.fixedArgRegs, 9)
    out.fixedResultReg = 0
    # SysV carries the hidden result address in RDI. Sharing fixedArgRegs[0]
    # is an explicit conditional-ABI proof: sret calls/functions shift every
    # explicit argument by one register and therefore expose only five
    # register arguments.
    out.fixedSretReg = 7
    out.sretShiftsFixedArgs = true
    out.fixedReturnReg = 0
    # SysV r11 is caller-clobbered, reserved from allocation and unused by the
    # fixed argument/result ABI. The canonical x86_64 machine recipe consumes
    # this exact proof for parallel-copy cycle expansion.
    out.parallelCopyScratchReg = 11
    out.packedStackArgs = false
    add(out.gprTypeKinds, coreir.LocalI32Tag)
    add(out.gprTypeKinds, coreir.LocalPtrTag)
    add(out.gprTypeKinds, coreir.LocalI64Tag)
    return out

@borrows
fn RegallocTargetConstraintsSretShiftsFixedArgs(
        constraints: var RegallocTargetConstraints): bool =
    return constraints.sretShiftsFixedArgs

fn RegallocTargetConstraintsRiscv(xlen: int32): RegallocTargetConstraints =
    var out = RegallocTargetConstraintsInit()
    for reg in 0..<32:
        add(out.registerUniverse, reg)
    add(out.allocatableCallerRegs, 6)
    add(out.allocatableCallerRegs, 7)
    add(out.allocatableCallerRegs, 28)
    add(out.allocatableCallerRegs, 29)
    add(out.allocatableCallerRegs, 30)
    add(out.allocatableCallerRegs, 31)
    add(out.allocatableCalleeRegs, 8)
    add(out.allocatableCalleeRegs, 9)
    add(out.allocatableCalleeRegs, 18)
    add(out.allocatableCalleeRegs, 19)
    add(out.reservedRegs, 0)
    add(out.reservedRegs, 1)
    add(out.reservedRegs, 2)
    add(out.reservedRegs, 3)
    add(out.reservedRegs, 4)
    add(out.reservedRegs, 5)
    for argReg in 10..<18:
        add(out.reservedRegs, argReg)
    add(out.callClobberRegs, 1)
    add(out.callClobberRegs, 5)
    add(out.callClobberRegs, 6)
    add(out.callClobberRegs, 7)
    for argReg in 10..<18:
        add(out.callClobberRegs, argReg)
    add(out.callClobberRegs, 28)
    add(out.callClobberRegs, 29)
    add(out.callClobberRegs, 30)
    add(out.callClobberRegs, 31)
    for argReg in 10..<18:
        add(out.fixedArgRegs, argReg)
    out.fixedResultReg = 10
    out.fixedSretReg = 10
    out.sretShiftsFixedArgs = true
    out.fixedReturnReg = 10
    out.parallelCopyScratchReg = 5
    out.packedStackArgs = false
    add(out.gprTypeKinds, coreir.LocalI32Tag)
    add(out.gprTypeKinds, coreir.LocalPtrTag)
    if xlen == 64:
        add(out.gprTypeKinds, coreir.LocalI64Tag)
    return out

fn RegallocTargetConstraintsRv64(): RegallocTargetConstraints =
    return RegallocTargetConstraintsRiscv(64)

fn RegallocTargetConstraintsRv32(): RegallocTargetConstraints =
    return RegallocTargetConstraintsRiscv(32)

# triple 全集 if 表（原 RegallocTargetConstraintsForProductionTarget）B7
#（2026-08-25）原样迁 codegen_contract.CodegenUnitConstraintSet（契约要素 1
# 策略位表，布局迁移零语义变化，禁复制第二份定义）；上方 per-target 构造
# 函数族留本模块，由契约经 alloc.* 直调。

fn regallocValueIntSeq(count: int32, value: int32): int32[] =
    var out: int32[]
    for _ in 0..<count:
        add(out, value)
    return out

fn regallocValueBoolSeq(count: int32, value: bool): bool[] =
    var out: bool[]
    for _ in 0..<count:
        add(out, value)
    return out

fn regallocValueFail(plan: var RegallocSinglePassValuePlan,
                     code: int32,
                     detail: int32) =
    if plan.valid:
        plan.errorCode = code
        plan.errorDetail = detail
    plan.valid = false
    plan.frozen = false

@borrows
fn regallocValueContains(values: int32[], value: int32): bool =
    for i in 0..<values.len:
        if values[i] == value:
            return true
    return false

@borrows
fn regallocValueCloneI32Seq(values: int32[]): int32[] =
    var out: int32[]
    for i in 0..<values.len:
        add(out, values[i])
    return out

fn regallocValueGprWidth(typeKind: int32): int32 =
    if typeKind == coreir.LocalI32Tag:
        return 4
    if typeKind == coreir.LocalI64Tag ||
       typeKind == coreir.LocalPtrTag:
        return 8
    return 0

fn regallocValueCopyRepresentationNoop(sourceType: int32,
                                        targetType: int32): bool =
    if sourceType == targetType:
        return regallocValueGprWidth(sourceType) > 0
    return (sourceType == coreir.LocalPtrTag &&
            targetType == coreir.LocalI64Tag) ||
           (sourceType == coreir.LocalI64Tag &&
            targetType == coreir.LocalPtrTag)

@borrows
fn regallocValueKnownRegister(constraints: RegallocTargetConstraints, reg: int32): bool =
    return reg >= 0 && regallocValueContains(constraints.registerUniverse, reg)

fn regallocValueValidateSet(plan: var RegallocSinglePassValuePlan,
                            values: var int32[]): bool =
    var seen = regallocValueBoolSeq(63, false)
    for i in 0..<values.len:
        if values[i] < 0 || values[i] > 62:
            regallocValueFail(plan,
                             RegallocValuePlanErrorUnknownRegister,
                             values[i])
            return false
        if seen[values[i]]:
            regallocValueFail(plan,
                             RegallocValuePlanErrorConstraintDuplicate,
                             values[i])
            return false
        seen[values[i]] = true
    var sorted: int32[]
    for reg in 0..<63:
        if seen[reg]:
            add(sorted, reg)
    values = sorted
    return true

fn regallocValueValidateKnownSet(plan: var RegallocSinglePassValuePlan,
                                 values: var int32[]): bool =
    if !regallocValueValidateSet(plan, values):
        return false
    for i in 0..<values.len:
        if !regallocValueKnownRegister(plan.constraints, values[i]):
            regallocValueFail(plan,
                             RegallocValuePlanErrorUnknownRegister,
                             values[i])
            return false
    return true

fn regallocValueValidateFixedReg(plan: var RegallocSinglePassValuePlan,
                                 reg: int32,
                                 callRegister: bool): bool =
    if reg < 0:
        return true
    if !regallocValueKnownRegister(plan.constraints, reg):
        regallocValueFail(plan,
                         RegallocValuePlanErrorUnknownRegister,
                         reg)
        return false
    if callRegister &&
       !regallocValueContains(plan.constraints.callClobberRegs, reg) &&
       !regallocValueContains(plan.constraints.reservedRegs, reg):
        regallocValueFail(plan,
                         RegallocValuePlanErrorConstraintShape,
                         reg)
        return false
    return true

fn regallocValueValidateFixedNotAllocatable(
        plan: var RegallocSinglePassValuePlan,
        reg: int32): bool =
    if reg < 0:
        return true
    if regallocValueContains(plan.constraints.allocatableCallerRegs, reg) ||
       regallocValueContains(plan.constraints.allocatableCalleeRegs, reg):
        regallocValueFail(plan,
                         RegallocValuePlanErrorFixedConflict,
                         reg)
        return false
    return true

fn regallocValueValidateParallelScratchConstraint(
        plan: var RegallocSinglePassValuePlan): bool =
    let scratch = plan.constraints.parallelCopyScratchReg
    if scratch < 0:
        return true
    if !regallocValueKnownRegister(plan.constraints, scratch):
        regallocValueFail(plan,
                         RegallocValuePlanErrorUnknownRegister,
                         scratch)
        return false
    if !regallocValueContains(plan.constraints.reservedRegs, scratch) ||
       !regallocValueContains(plan.constraints.callClobberRegs, scratch) ||
       regallocValueContains(plan.constraints.allocatableCallerRegs,
                             scratch) ||
       regallocValueContains(plan.constraints.allocatableCalleeRegs,
                             scratch):
        regallocValueFail(plan,
                         RegallocValuePlanErrorConstraintOverlap,
                         scratch)
        return false
    for i in 0..<plan.constraints.fixedArgRegs.len:
        if plan.constraints.fixedArgRegs[i] == scratch:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFixedConflict,
                             scratch)
            return false
    if plan.constraints.fixedResultReg == scratch ||
       plan.constraints.fixedSretReg == scratch ||
       plan.constraints.fixedReturnReg == scratch:
        regallocValueFail(plan,
                         RegallocValuePlanErrorFixedConflict,
                         scratch)
        return false
    return true

fn regallocValueCanonicalizeConstraints(
        plan: var RegallocSinglePassValuePlan,
        raw: var RegallocTargetConstraints): bool =
    plan.constraints = raw
    var registerUniverse = regallocValueCloneI32Seq(
        plan.constraints.registerUniverse)
    plan.constraints.registerUniverse = []
    if !regallocValueValidateSet(plan, registerUniverse):
        plan.constraints.registerUniverse = registerUniverse
        return false
    plan.constraints.registerUniverse = registerUniverse
    if plan.constraints.registerUniverse.len <= 0:
        regallocValueFail(plan,
                         RegallocValuePlanErrorConstraintShape,
                         0)
        return false
    var allocatableCallerRegs = regallocValueCloneI32Seq(
        plan.constraints.allocatableCallerRegs)
    plan.constraints.allocatableCallerRegs = []
    var allocatableCalleeRegs = regallocValueCloneI32Seq(
        plan.constraints.allocatableCalleeRegs)
    plan.constraints.allocatableCalleeRegs = []
    var reservedRegs = regallocValueCloneI32Seq(
        plan.constraints.reservedRegs)
    plan.constraints.reservedRegs = []
    var callClobberRegs = regallocValueCloneI32Seq(
        plan.constraints.callClobberRegs)
    plan.constraints.callClobberRegs = []
    if !regallocValueValidateKnownSet(plan, allocatableCallerRegs) ||
       !regallocValueValidateKnownSet(plan, allocatableCalleeRegs) ||
       !regallocValueValidateKnownSet(plan, reservedRegs) ||
       !regallocValueValidateKnownSet(plan, callClobberRegs):
        plan.constraints.allocatableCallerRegs = allocatableCallerRegs
        plan.constraints.allocatableCalleeRegs = allocatableCalleeRegs
        plan.constraints.reservedRegs = reservedRegs
        plan.constraints.callClobberRegs = callClobberRegs
        return false
    plan.constraints.allocatableCallerRegs = allocatableCallerRegs
    plan.constraints.allocatableCalleeRegs = allocatableCalleeRegs
    plan.constraints.reservedRegs = reservedRegs
    plan.constraints.callClobberRegs = callClobberRegs
    for i in 0..<plan.constraints.allocatableCallerRegs.len:
        let reg = plan.constraints.allocatableCallerRegs[i]
        if regallocValueContains(plan.constraints.allocatableCalleeRegs, reg) ||
           regallocValueContains(plan.constraints.reservedRegs, reg) ||
           !regallocValueContains(plan.constraints.callClobberRegs, reg):
            regallocValueFail(plan,
                             RegallocValuePlanErrorConstraintOverlap,
                             reg)
            return false
    for i in 0..<plan.constraints.allocatableCalleeRegs.len:
        let reg = plan.constraints.allocatableCalleeRegs[i]
        if regallocValueContains(plan.constraints.reservedRegs, reg) ||
           regallocValueContains(plan.constraints.callClobberRegs, reg):
            regallocValueFail(plan,
                             RegallocValuePlanErrorConstraintOverlap,
                             reg)
            return false
    var fixedArgSeen = regallocValueBoolSeq(63, false)
    for i in 0..<plan.constraints.fixedArgRegs.len:
        let reg = plan.constraints.fixedArgRegs[i]
        if reg < 0:
            regallocValueFail(plan,
                             RegallocValuePlanErrorUnknownRegister,
                             reg)
            return false
        if !regallocValueValidateFixedReg(
                plan, reg, true) ||
           !regallocValueValidateFixedNotAllocatable(plan, reg):
            return false
        if fixedArgSeen[reg]:
            regallocValueFail(
                plan, RegallocValuePlanErrorConstraintDuplicate, reg)
            return false
        fixedArgSeen[reg] = true
    if !regallocValueValidateFixedReg(
            plan, plan.constraints.fixedResultReg, true) ||
       !regallocValueValidateFixedReg(
            plan, plan.constraints.fixedSretReg, true) ||
       !regallocValueValidateFixedReg(
            plan, plan.constraints.fixedReturnReg, true) ||
       !regallocValueValidateFixedNotAllocatable(
            plan, plan.constraints.fixedResultReg) ||
       !regallocValueValidateFixedNotAllocatable(
            plan, plan.constraints.fixedSretReg) ||
       !regallocValueValidateFixedNotAllocatable(
            plan, plan.constraints.fixedReturnReg):
        return false
    var sharedSretArgCount: int32
    if plan.constraints.fixedSretReg >= 0:
        for i in 0..<plan.constraints.fixedArgRegs.len:
            if plan.constraints.fixedArgRegs[i] ==
               plan.constraints.fixedSretReg:
                if i != 0:
                    regallocValueFail(
                        plan, RegallocValuePlanErrorFixedConflict,
                        plan.constraints.fixedSretReg)
                    return false
                sharedSretArgCount =
                    sharedSretArgCount + 1
    if (RegallocTargetConstraintsSretShiftsFixedArgs(
            plan.constraints) &&
        sharedSretArgCount != 1) ||
       (!RegallocTargetConstraintsSretShiftsFixedArgs(
            plan.constraints) &&
        sharedSretArgCount != 0):
        regallocValueFail(
            plan, RegallocValuePlanErrorFixedConflict,
            plan.constraints.fixedSretReg)
        return false
    if !regallocValueValidateParallelScratchConstraint(plan):
        return false
    if plan.constraints.stackArgSlotBytes != 8 ||
       plan.constraints.stackAlignmentBytes != 16:
        regallocValueFail(plan,
                         RegallocValuePlanErrorConstraintShape,
                         plan.constraints.stackArgSlotBytes)
        return false
    var gprKindSeen = regallocValueBoolSeq(7, false)
    for i in 0..<plan.constraints.gprTypeKinds.len:
        let kind = plan.constraints.gprTypeKinds[i]
        if kind != coreir.LocalI32Tag &&
           kind != coreir.LocalPtrTag &&
           kind != coreir.LocalI64Tag:
            regallocValueFail(plan,
                             RegallocValuePlanErrorConstraintShape,
                             kind)
            return false
        if gprKindSeen[kind]:
            regallocValueFail(plan,
                             RegallocValuePlanErrorConstraintDuplicate,
                             kind)
            return false
        gprKindSeen[kind] = true
    plan.constraints.gprTypeKinds = []
    for kind in 0..<7:
        if gprKindSeen[kind]:
            add(plan.constraints.gprTypeKinds, kind)
    return true

@borrows
fn regallocValueInitPositions(bodyIR: var coreir.BodyIR,
                              analysis: var cfg.BodyIrCfgAnalysis,
                              plan: var RegallocSinglePassValuePlan) =
    plan.blockEntryPositions = regallocValueIntSeq(bodyIR.blocks.len, -1)
    plan.blockExitPositions = regallocValueIntSeq(bodyIR.blocks.len, -1)
    plan.bodyOpKinds = []
    plan.bodyOpOperandCounts = []
    for opIndex in 0..<bodyIR.ops.len:
        add(plan.bodyOpKinds, bodyIR.ops[opIndex].kind)
        add(plan.bodyOpOperandCounts, bodyIR.ops[opIndex].operands.len)
    plan.opBeforePositions = regallocValueIntSeq(bodyIR.ops.len, -1)
    plan.opAfterPositions = regallocValueIntSeq(bodyIR.ops.len, -1)
    plan.termBeforePositions = regallocValueIntSeq(bodyIR.terms.len, -1)
    plan.termAfterPositions = regallocValueIntSeq(bodyIR.terms.len, -1)
    var position: int32
    for rpoIndex in 0..<analysis.reversePostorder.len:
        let blockIndex = analysis.reversePostorder[rpoIndex]
        plan.blockEntryPositions[blockIndex] = position
        position = position + 1
        let block = bodyIR.blocks[blockIndex]
        for opIndex in block.opStart..<(block.opStart + block.opCount):
            plan.opBeforePositions[opIndex] = position
            position = position + 1
            plan.opAfterPositions[opIndex] = position
            position = position + 1
        plan.termBeforePositions[block.termIndex] = position
        position = position + 1
        plan.termAfterPositions[block.termIndex] = position
        position = position + 1
        plan.blockExitPositions[blockIndex] = position
        position = position + 1
    plan.positionCount = position

fn regallocValueInitCallReachability(
        accessTable: var bodyaccess.BodyIrAccessTable,
        plan: var RegallocSinglePassValuePlan) =
    plan.callReachable = regallocValueBoolSeq(plan.callCount, false)
    for callOrdinal in 0..<plan.callCount:
        let factStart = accessTable.callFactStarts[callOrdinal]
        let factCount = accessTable.callFactCounts[callOrdinal]
        if factStart < 0 || factCount <= 0 ||
           factStart > accessTable.facts.len - factCount:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             callOrdinal)
            return
        var sawClobber: bool
        for factIndex in factStart..<(factStart + factCount):
            let fact = accessTable.facts[factIndex]
            if fact.kind == bodyaccess.BodyIrAccessFactClobber &&
               fact.clobberKind == bodyaccess.BodyIrAccessClobberCallAbi:
                if sawClobber || fact.callOrdinal != callOrdinal:
                    regallocValueFail(plan,
                                     RegallocValuePlanErrorFactShape,
                                     factIndex)
                    return
                sawClobber = true
                plan.callReachable[callOrdinal] =
                    regallocValueFactPosition(fact, plan, false) >= 0
        if !sawClobber:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             callOrdinal)
            return

fn regallocValueFactPosition(fact: bodyaccess.BodyIrAccessFact,
                             plan: var RegallocSinglePassValuePlan,
                             afterDefinition: bool): int32 =
    if fact.siteKind == bodyaccess.BodyIrAccessSiteEntry:
        if plan.blockEntryPositions.len <= 0:
            return -1
        return plan.blockEntryPositions[0]
    if fact.siteKind == bodyaccess.BodyIrAccessSiteOp:
        if fact.siteIndex < 0 ||
           fact.siteIndex >= plan.opBeforePositions.len:
            return -1
        if afterDefinition:
            return plan.opAfterPositions[fact.siteIndex]
        return plan.opBeforePositions[fact.siteIndex]
    if fact.siteKind == bodyaccess.BodyIrAccessSiteTerm:
        if fact.siteIndex < 0 ||
           fact.siteIndex >= plan.termBeforePositions.len:
            return -1
        if afterDefinition:
            return plan.termAfterPositions[fact.siteIndex]
        return plan.termBeforePositions[fact.siteIndex]
    return -1

type
    RegallocValueRawUses =
        valueIds: int32[]
        positions: int32[]
        factIndices: int32[]
        kinds: int32[]
        sourceBlocks: int32[]
        targetBlocks: int32[]

fn regallocValueAppendRawUse(raw: var RegallocValueRawUses,
                             valueId: int32,
                             position: int32,
                             factIndex: int32,
                             kind: int32,
                             sourceBlock: int32,
                             targetBlock: int32) =
    add(raw.valueIds, valueId)
    add(raw.positions, position)
    add(raw.factIndices, factIndex)
    add(raw.kinds, kind)
    add(raw.sourceBlocks, sourceBlock)
    add(raw.targetBlocks, targetBlock)

fn regallocValueFixedRegForFact(
        accessTable: var bodyaccess.BodyIrAccessTable,
        plan: var RegallocSinglePassValuePlan,
        fact: bodyaccess.BodyIrAccessFact): int32 =
    if fact.fixedKind == bodyaccess.BodyIrAccessFixedCallArg:
        var registerOrdinal = fact.fixedOrdinal
        if RegallocTargetConstraintsSretShiftsFixedArgs(
               plan.constraints) &&
           fact.callOrdinal >= 0 &&
           fact.callOrdinal <
               accessTable.callResultPassKinds.len &&
           (accessTable.callResultPassKinds[
                fact.callOrdinal] ==
                coreir.BodyCallPassSretResultTag ||
            accessTable.callResultPassKinds[
                fact.callOrdinal] ==
                coreir.BodyCallPassForwardEntrySretTag):
            registerOrdinal = registerOrdinal + 1
        if registerOrdinal < 0 ||
           registerOrdinal >=
               plan.constraints.fixedArgRegs.len:
            return -1
        return plan.constraints.fixedArgRegs[registerOrdinal]
    if fact.fixedKind == bodyaccess.BodyIrAccessFixedCallResult:
        return plan.constraints.fixedResultReg
    if fact.fixedKind == bodyaccess.BodyIrAccessFixedSretResult:
        return plan.constraints.fixedSretReg
    if fact.fixedKind == bodyaccess.BodyIrAccessFixedSretForward:
        return plan.constraints.fixedSretReg
    if fact.fixedKind == bodyaccess.BodyIrAccessFixedReturnValue:
        if fact.typeKind == coreir.LocalStrTag ||
           fact.typeKind == coreir.LocalAggregateTag:
            return plan.constraints.fixedSretReg
        return plan.constraints.fixedReturnReg
    return -1

fn regallocValueValidateFixedFacts(
        accessTable: var bodyaccess.BodyIrAccessTable,
        plan: var RegallocSinglePassValuePlan): bool =
    for factIndex in 0..<accessTable.facts.len:
        let fact = accessTable.facts[factIndex]
        let position = regallocValueFactPosition(fact, plan, false)
        if position < 0 || fact.fixedKind == bodyaccess.BodyIrAccessFixedNone ||
           fact.fixedKind == bodyaccess.BodyIrAccessFixedGlobal ||
           fact.fixedKind == bodyaccess.BodyIrAccessFixedCallWriteHome:
            continue
        if fact.fixedKind == bodyaccess.BodyIrAccessFixedCallArg:
            if fact.fixedOrdinal < 0:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorFactShape,
                                 factIndex)
                return false
            if regallocValueFixedRegForFact(
                   accessTable, plan, fact) < 0:
                continue
        if regallocValueFixedRegForFact(
               accessTable, plan, fact) < 0:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFixedMissing,
                             factIndex)
            return false
    return true

fn regallocValueInitEdges(analysis: var cfg.BodyIrCfgAnalysis,
                          plan: var RegallocSinglePassValuePlan): int32[] =
    plan.edgeSourceBlocks = regallocValueIntSeq(analysis.edgeCount, -1)
    plan.edgeTargetBlocks = regallocValueIntSeq(analysis.edgeCount, -1)
    plan.edgeActionStarts = regallocValueIntSeq(analysis.edgeCount, -1)
    plan.edgeActionCounts = regallocValueIntSeq(analysis.edgeCount, 0)
    var incomingCounts = regallocValueIntSeq(analysis.blockCount, 0)
    var edgeIndex: int32
    for sourceBlock in 0..<analysis.blockCount:
        for successorIndex in analysis.succOffsets[sourceBlock]..<analysis.succOffsets[sourceBlock + 1]:
            let targetBlock = analysis.succBlocks[successorIndex]
            if edgeIndex >= analysis.edgeCount:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorFactShape,
                                 edgeIndex)
                return []
            plan.edgeSourceBlocks[edgeIndex] = sourceBlock
            plan.edgeTargetBlocks[edgeIndex] = targetBlock
            incomingCounts[targetBlock] = incomingCounts[targetBlock] + 1
            edgeIndex = edgeIndex + 1
    if edgeIndex != analysis.edgeCount:
        regallocValueFail(plan,
                         RegallocValuePlanErrorFactShape,
                         edgeIndex)
        return []
    var incomingOffsets: int32[]
    add(incomingOffsets, 0)
    for blockIndex in 0..<analysis.blockCount:
        add(incomingOffsets,
            incomingOffsets[blockIndex] + incomingCounts[blockIndex])
    var cursors = regallocValueIntSeq(analysis.blockCount, 0)
    for blockIndex in 0..<analysis.blockCount:
        cursors[blockIndex] = incomingOffsets[blockIndex]
    var predEdgeIndices = regallocValueIntSeq(analysis.edgeCount, -1)
    for currentEdge in 0..<analysis.edgeCount:
        let target = plan.edgeTargetBlocks[currentEdge]
        let cursor = cursors[target]
        predEdgeIndices[cursor] = currentEdge
        cursors[target] = cursor + 1
    for blockIndex in 0..<analysis.blockCount:
        if incomingOffsets[blockIndex] != analysis.predOffsets[blockIndex] ||
           incomingOffsets[blockIndex + 1] !=
               analysis.predOffsets[blockIndex + 1]:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             blockIndex)
            return []
        for predIndex in incomingOffsets[blockIndex]..<incomingOffsets[blockIndex + 1]:
            let indexedEdge = predEdgeIndices[predIndex]
            if indexedEdge < 0 ||
               plan.edgeSourceBlocks[indexedEdge] !=
                   analysis.predBlocks[predIndex]:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorFactShape,
                                 predIndex)
                return []
    return predEdgeIndices

@borrows
fn regallocValueInitMetadata(
        bodyIR: var coreir.BodyIR,
        accessTable: var bodyaccess.BodyIrAccessTable,
        analysis: var cfg.BodyIrCfgAnalysis,
        plan: var RegallocSinglePassValuePlan) =
    let valueCount = analysis.valueCount
    plan.valueDefPositions = regallocValueIntSeq(valueCount, -1)
    plan.valueDefFactIndices = regallocValueIntSeq(valueCount, -1)
    plan.valueDefBlocks = regallocValueIntSeq(valueCount, -1)
    plan.valueDefIsEntry = regallocValueBoolSeq(valueCount, false)
    plan.valueEndPositions = regallocValueIntSeq(valueCount, -1)
    plan.valueSlotIndices = regallocValueIntSeq(valueCount, -1)
    plan.valueTypeKinds = regallocValueIntSeq(valueCount,
                                              coreir.LocalInvalidTag)
    plan.valueClasses = regallocValueIntSeq(valueCount,
                                            RegallocValueClassDead)
    plan.valueMemoryHomes = regallocValueBoolSeq(valueCount, false)
    plan.valueAssignedRegs = regallocValueIntSeq(valueCount, -1)
    plan.operandRegByFact = regallocValueIntSeq(accessTable.facts.len, -1)
    var slotHomes = regallocValueBoolSeq(bodyIR.localSlots.len, false)
    for slotIndex in 0..<bodyIR.localSlots.len:
        if bodyIR.localSlots[slotIndex].placeKind !=
               coreir.BodyPlaceStackValueTag ||
           !bodyIR.localSlots[slotIndex].noAlias:
            slotHomes[slotIndex] = true
    for factIndex in 0..<accessTable.facts.len:
        let fact = accessTable.facts[factIndex]
        if fact.kind != bodyaccess.BodyIrAccessFactAddress:
            continue
        if !bodyaccess.BodyIrAccessAddressFactIsValid(bodyIR, fact) ||
           fact.addressOwnerSlot < 0 ||
           fact.addressOwnerSlot >= slotHomes.len:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             factIndex)
            return
        if fact.slotIndex >= 0 && fact.slotIndex < slotHomes.len:
            slotHomes[fact.slotIndex] = true
        slotHomes[fact.addressOwnerSlot] = true
    for factIndex in 0..<accessTable.facts.len:
        let fact = accessTable.facts[factIndex]
        if fact.kind == bodyaccess.BodyIrAccessFactDef &&
           fact.fixedKind == bodyaccess.BodyIrAccessFixedSretResult &&
           regallocValueFactPosition(fact, plan, false) >= 0 &&
           fact.slotIndex >= 0 && fact.slotIndex < slotHomes.len:
            slotHomes[fact.slotIndex] = true
    for valueId in 0..<valueCount:
        let slotIndex = analysis.valueSlotIndices[valueId]
        let typeKind = analysis.valueTypeKinds[valueId]
        plan.valueSlotIndices[valueId] = slotIndex
        plan.valueTypeKinds[valueId] = typeKind
        var valueClass = RegallocValueClassStack
        if regallocValueContains(plan.constraints.gprTypeKinds, typeKind):
            valueClass = RegallocValueClassGpr
        if slotIndex >= 0 && slotIndex < slotHomes.len && slotHomes[slotIndex]:
            plan.valueMemoryHomes[valueId] = true
            if valueClass == RegallocValueClassGpr:
                valueClass = RegallocValueClassAddressHome
        plan.valueClasses[valueId] = valueClass
    for factIndex in 0..<accessTable.facts.len:
        let fact = accessTable.facts[factIndex]
        if fact.kind != bodyaccess.BodyIrAccessFactDef:
            continue
        let position = regallocValueFactPosition(fact, plan, true)
        if position < 0:
            continue
        if fact.valueId < 0 || fact.valueId >= valueCount:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             factIndex)
            return
        if plan.valueSlotIndices[fact.valueId] != fact.slotIndex ||
           plan.valueTypeKinds[fact.valueId] != fact.typeKind:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             factIndex)
            return
        plan.valueDefPositions[fact.valueId] = position
        plan.valueDefFactIndices[fact.valueId] = factIndex
        plan.valueDefIsEntry[fact.valueId] =
            fact.siteKind == bodyaccess.BodyIrAccessSiteEntry
        if fact.siteKind == bodyaccess.BodyIrAccessSiteEntry:
            plan.valueDefBlocks[fact.valueId] = 0
        elif factIndex < analysis.factOwnerBlocks.len:
            plan.valueDefBlocks[fact.valueId] =
                analysis.factOwnerBlocks[factIndex]
    for blockIndex in 0..<analysis.blockCount:
        if !analysis.reachable[blockIndex]:
            continue
        for slotIndex in 0..<analysis.slotCount:
            let flatIndex = blockIndex * analysis.slotCount + slotIndex
            let mergeValue = analysis.mergeValueByBlockSlot[flatIndex]
            if mergeValue >= 0:
                if mergeValue >= valueCount:
                    regallocValueFail(plan,
                                     RegallocValuePlanErrorFactShape,
                                     mergeValue)
                    return
                plan.valueDefPositions[mergeValue] =
                    plan.blockEntryPositions[blockIndex]
                plan.valueDefBlocks[mergeValue] = blockIndex
    for valueId in 0..<valueCount:
        if plan.valueDefPositions[valueId] < 0:
            plan.valueClasses[valueId] = RegallocValueClassDead
        elif plan.valueDefBlocks[valueId] < 0 ||
             plan.valueDefBlocks[valueId] >= analysis.blockCount ||
             !analysis.reachable[plan.valueDefBlocks[valueId]]:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             valueId)
            return

fn regallocValueCollectFacts(
        accessTable: var bodyaccess.BodyIrAccessTable,
        analysis: var cfg.BodyIrCfgAnalysis,
        plan: var RegallocSinglePassValuePlan,
        raw: var RegallocValueRawUses) =
    for factIndex in 0..<accessTable.facts.len:
        let fact = accessTable.facts[factIndex]
        let position = regallocValueFactPosition(fact, plan, false)
        if position < 0:
            continue
        if fact.kind == bodyaccess.BodyIrAccessFactUse:
            let valueId = analysis.reachingValueByFact[factIndex]
            if valueId < 0 || valueId >= analysis.valueCount:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorFactShape,
                                 factIndex)
                return
            if plan.valueSlotIndices[valueId] != fact.slotIndex ||
               plan.valueTypeKinds[valueId] != fact.typeKind:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorFactShape,
                                 factIndex)
                return
            var ownerBlock: int32 = -1
            if factIndex < analysis.factOwnerBlocks.len:
                ownerBlock = analysis.factOwnerBlocks[factIndex]
            regallocValueAppendRawUse(raw, valueId, position, factIndex,
                                     RegallocValueUseFact,
                                     ownerBlock, ownerBlock)
        elif fact.kind == bodyaccess.BodyIrAccessFactClobber &&
             fact.clobberKind == bodyaccess.BodyIrAccessClobberCallAbi:
            add(plan.callPositions, position)
    var callAtPosition = regallocValueBoolSeq(plan.positionCount, false)
    for callIndex in 0..<plan.callPositions.len:
        let position = plan.callPositions[callIndex]
        if position < 0 || position >= plan.positionCount ||
           callAtPosition[position]:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             callIndex)
            return
        callAtPosition[position] = true
    plan.callPositions = []
    for position in 0..<plan.positionCount:
        if callAtPosition[position]:
            add(plan.callPositions, position)

@borrows
fn regallocValueCollectMergeEdges(
        analysis: var cfg.BodyIrCfgAnalysis,
        predEdgeIndices: var int32[],
        plan: var RegallocSinglePassValuePlan,
        raw: var RegallocValueRawUses,
        edgeCopies: var RegallocValueEdgeCopy[]) =
    for blockIndex in 0..<analysis.blockCount:
        if !analysis.reachable[blockIndex]:
            continue
        for slotIndex in 0..<analysis.slotCount:
            let flatIndex = blockIndex * analysis.slotCount + slotIndex
            let targetValue = analysis.mergeValueByBlockSlot[flatIndex]
            if targetValue < 0:
                continue
            let mergeStart = analysis.mergeInputStarts[flatIndex]
            let mergeCount = analysis.mergeInputCounts[flatIndex]
            if mergeStart < 0 || mergeCount <= 0 ||
               mergeStart > analysis.mergeInputValues.len - mergeCount ||
               mergeStart >
                   analysis.mergeInputPredecessors.len - mergeCount ||
               targetValue >= plan.valueSlotIndices.len ||
               plan.valueSlotIndices[targetValue] != slotIndex:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorFactShape,
                                 flatIndex)
                return
            var inputOrdinal: int32
            if blockIndex == 0:
                let sourceValue = analysis.mergeInputValues[mergeStart]
                if sourceValue < 0 ||
                   sourceValue >= plan.valueSlotIndices.len ||
                   plan.valueSlotIndices[sourceValue] != slotIndex:
                    regallocValueFail(plan,
                                     RegallocValuePlanErrorFactShape,
                                     mergeStart)
                    return
                if analysis.mergeInputPredecessors[mergeStart] != -1:
                    regallocValueFail(plan,
                                     RegallocValuePlanErrorFactShape,
                                     mergeStart)
                    return
                regallocValueAppendRawUse(
                    raw, sourceValue, plan.blockEntryPositions[blockIndex], -1,
                    RegallocValueUseMergeEdge, -1, blockIndex)
                var copy: RegallocValueEdgeCopy
                copy.edgeIndex = -1
                copy.sourceBlock = -1
                copy.targetBlock = blockIndex
                copy.sourceValue = sourceValue
                copy.targetValue = targetValue
                copy.slotIndex = slotIndex
                copy.virtualEntry = true
                add(edgeCopies, copy)
                inputOrdinal = 1
            for predIndex in analysis.predOffsets[blockIndex]..<analysis.predOffsets[blockIndex + 1]:
                let predecessor = analysis.predBlocks[predIndex]
                if !analysis.reachable[predecessor]:
                    continue
                if inputOrdinal >= mergeCount:
                    regallocValueFail(plan,
                                     RegallocValuePlanErrorFactShape,
                                     predIndex)
                    return
                let inputIndex = mergeStart + inputOrdinal
                let sourceValue = analysis.mergeInputValues[inputIndex]
                if sourceValue < 0 ||
                   sourceValue >= plan.valueSlotIndices.len ||
                   plan.valueSlotIndices[sourceValue] != slotIndex:
                    regallocValueFail(plan,
                                     RegallocValuePlanErrorFactShape,
                                     inputIndex)
                    return
                if analysis.mergeInputPredecessors[inputIndex] != predecessor:
                    regallocValueFail(plan,
                                     RegallocValuePlanErrorFactShape,
                                     inputIndex)
                    return
                let edgeIndex = predEdgeIndices[predIndex]
                if edgeIndex < 0 || edgeIndex >= analysis.edgeCount:
                    regallocValueFail(plan,
                                     RegallocValuePlanErrorFactShape,
                                     edgeIndex)
                    return
                regallocValueAppendRawUse(
                    raw, sourceValue, plan.blockExitPositions[predecessor], -1,
                    RegallocValueUseMergeEdge, predecessor, blockIndex)
                var copy: RegallocValueEdgeCopy
                copy.edgeIndex = edgeIndex
                copy.sourceBlock = predecessor
                copy.targetBlock = blockIndex
                copy.sourceValue = sourceValue
                copy.targetValue = targetValue
                copy.slotIndex = slotIndex
                copy.virtualEntry = false
                add(edgeCopies, copy)
                inputOrdinal = inputOrdinal + 1
            if inputOrdinal != mergeCount:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorFactShape,
                                 flatIndex)
                return

fn regallocValueBuildUseCsr(plan: var RegallocSinglePassValuePlan,
                            raw: var RegallocValueRawUses) =
    let valueCount = plan.valueDefPositions.len
    var positionCounts = regallocValueIntSeq(plan.positionCount, 0)
    for rawIndex in 0..<raw.valueIds.len:
        let valueId = raw.valueIds[rawIndex]
        let position = raw.positions[rawIndex]
        if valueId < 0 || valueId >= valueCount ||
           position < 0 || position >= plan.positionCount:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             rawIndex)
            return
        positionCounts[position] = positionCounts[position] + 1
    var positionOffsets: int32[]
    add(positionOffsets, 0)
    for position in 0..<plan.positionCount:
        add(positionOffsets,
            positionOffsets[position] + positionCounts[position])
    var positionCursors = regallocValueIntSeq(plan.positionCount, 0)
    for position in 0..<plan.positionCount:
        positionCursors[position] = positionOffsets[position]
    var positionEvents = regallocValueIntSeq(raw.valueIds.len, -1)
    for rawIndex in 0..<raw.valueIds.len:
        let position = raw.positions[rawIndex]
        let cursor = positionCursors[position]
        positionEvents[cursor] = rawIndex
        positionCursors[position] = cursor + 1
    var valueCounts = regallocValueIntSeq(valueCount, 0)
    for rawIndex in 0..<raw.valueIds.len:
        let valueId = raw.valueIds[rawIndex]
        valueCounts[valueId] = valueCounts[valueId] + 1
    add(plan.valueUseOffsets, 0)
    for valueId in 0..<valueCount:
        add(plan.valueUseOffsets,
            plan.valueUseOffsets[valueId] + valueCounts[valueId])
    plan.valueUsePositions = regallocValueIntSeq(raw.valueIds.len, -1)
    plan.valueUseFactIndices = regallocValueIntSeq(raw.valueIds.len, -1)
    plan.valueUseKinds = regallocValueIntSeq(raw.valueIds.len, 0)
    plan.valueUseSourceBlocks = regallocValueIntSeq(raw.valueIds.len, -1)
    plan.valueUseTargetBlocks = regallocValueIntSeq(raw.valueIds.len, -1)
    var valueCursors = regallocValueIntSeq(valueCount, 0)
    for valueId in 0..<valueCount:
        valueCursors[valueId] = plan.valueUseOffsets[valueId]
    for position in 0..<plan.positionCount:
        for eventIndex in positionOffsets[position]..<positionOffsets[position + 1]:
            let rawIndex = positionEvents[eventIndex]
            let valueId = raw.valueIds[rawIndex]
            let cursor = valueCursors[valueId]
            plan.valueUsePositions[cursor] = position
            plan.valueUseFactIndices[cursor] = raw.factIndices[rawIndex]
            plan.valueUseKinds[cursor] = raw.kinds[rawIndex]
            plan.valueUseSourceBlocks[cursor] = raw.sourceBlocks[rawIndex]
            plan.valueUseTargetBlocks[cursor] = raw.targetBlocks[rawIndex]
            valueCursors[valueId] = cursor + 1
    for valueId in 0..<valueCount:
        let defPosition = plan.valueDefPositions[valueId]
        if defPosition < 0:
            if valueCounts[valueId] != 0:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorFactShape,
                                 valueId)
                return
            continue
        var endPosition = defPosition
        let endOffset = plan.valueUseOffsets[valueId + 1]
        if endOffset > plan.valueUseOffsets[valueId]:
            endPosition = plan.valueUsePositions[endOffset - 1]
        if endPosition < defPosition:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             valueId)
            return
        plan.valueEndPositions[valueId] = endPosition

fn regallocValueCrossesCall(plan: var RegallocSinglePassValuePlan,
                            startPosition: int32,
                            endPosition: int32): bool =
    var low: int32
    var high = plan.callPositions.len
    while low < high:
        let middle = low + (high - low) / 2
        if plan.callPositions[middle] < startPosition:
            low = middle + 1
        else:
            high = middle
    if low >= plan.callPositions.len:
        return false
    return plan.callPositions[low] < endPosition

fn regallocValueFirstFreeReg(pool: var int32[],
                             activeOwnerByReg: var int32[]): int32 =
    for i in 0..<pool.len:
        let reg = pool[i]
        if activeOwnerByReg[reg] < 0:
            return reg
    return -1

fn regallocValueAllocate(plan: var RegallocSinglePassValuePlan) =
    let valueCount = plan.valueDefPositions.len
    var startCounts = regallocValueIntSeq(plan.positionCount, 0)
    for valueId in 0..<valueCount:
        let startPosition = plan.valueDefPositions[valueId]
        let useCount = plan.valueUseOffsets[valueId + 1] -
                       plan.valueUseOffsets[valueId]
        let valueClass = plan.valueClasses[valueId]
        let registerClass = valueClass == RegallocValueClassGpr
        if startPosition >= 0 && useCount > 0 && registerClass:
            startCounts[startPosition] = startCounts[startPosition] + 1
    var startOffsets: int32[]
    add(startOffsets, 0)
    for position in 0..<plan.positionCount:
        add(startOffsets, startOffsets[position] + startCounts[position])
    var startCursors = regallocValueIntSeq(plan.positionCount, 0)
    for position in 0..<plan.positionCount:
        startCursors[position] = startOffsets[position]
    var startValues = regallocValueIntSeq(startOffsets[plan.positionCount], -1)
    for valueId in 0..<valueCount:
        let startPosition = plan.valueDefPositions[valueId]
        let useCount = plan.valueUseOffsets[valueId + 1] -
                       plan.valueUseOffsets[valueId]
        let valueClass = plan.valueClasses[valueId]
        let registerClass = valueClass == RegallocValueClassGpr
        if startPosition >= 0 && useCount > 0 && registerClass:
            let cursor = startCursors[startPosition]
            startValues[cursor] = valueId
            startCursors[startPosition] = cursor + 1
    var activeOwnerByReg = regallocValueIntSeq(63, -1)
    for position in 0..<plan.positionCount:
        for reg in 0..<63:
            let owner = activeOwnerByReg[reg]
            if owner >= 0 && plan.valueEndPositions[owner] < position:
                activeOwnerByReg[reg] = -1
        for startIndex in startOffsets[position]..<startOffsets[position + 1]:
            let valueId = startValues[startIndex]
            let crosses = regallocValueCrossesCall(
                plan, position, plan.valueEndPositions[valueId])
            var assignedReg: int32 = -1
            if crosses:
                assignedReg = regallocValueFirstFreeReg(
                    plan.constraints.allocatableCalleeRegs,
                    activeOwnerByReg)
                if assignedReg < 0:
                    assignedReg = regallocValueFirstFreeReg(
                        plan.constraints.allocatableCallerRegs,
                        activeOwnerByReg)
            else:
                assignedReg = regallocValueFirstFreeReg(
                    plan.constraints.allocatableCallerRegs,
                    activeOwnerByReg)
                if assignedReg < 0:
                    assignedReg = regallocValueFirstFreeReg(
                        plan.constraints.allocatableCalleeRegs,
                        activeOwnerByReg)
            if assignedReg >= 0:
                plan.valueAssignedRegs[valueId] = assignedReg
                activeOwnerByReg[assignedReg] = valueId
                add(plan.allocationOrder, valueId)
    var regCounts = regallocValueIntSeq(63, 0)
    for allocationIndex in 0..<plan.allocationOrder.len:
        let valueId = plan.allocationOrder[allocationIndex]
        let reg = plan.valueAssignedRegs[valueId]
        regCounts[reg] = regCounts[reg] + 1
    add(plan.regIntervalOffsets, 0)
    for reg in 0..<63:
        add(plan.regIntervalOffsets,
            plan.regIntervalOffsets[reg] + regCounts[reg])
    plan.regIntervalValues = regallocValueIntSeq(
        plan.allocationOrder.len, -1)
    var regCursors = regallocValueIntSeq(63, 0)
    for reg in 0..<63:
        regCursors[reg] = plan.regIntervalOffsets[reg]
    for allocationIndex in 0..<plan.allocationOrder.len:
        let valueId = plan.allocationOrder[allocationIndex]
        let reg = plan.valueAssignedRegs[valueId]
        let cursor = regCursors[reg]
        plan.regIntervalValues[cursor] = valueId
        regCursors[reg] = cursor + 1

fn regallocValueOwnerAt(plan: var RegallocSinglePassValuePlan,
                        reg: int32,
                        position: int32): int32 =
    if reg < 0 || reg >= 63 || plan.regIntervalOffsets.len != 64:
        return -1
    var low = plan.regIntervalOffsets[reg]
    var high = plan.regIntervalOffsets[reg + 1]
    while low < high:
        let middle = low + (high - low) / 2
        let valueId = plan.regIntervalValues[middle]
        if plan.valueDefPositions[valueId] <= position:
            low = middle + 1
        else:
            high = middle
    if low <= plan.regIntervalOffsets[reg]:
        return -1
    let candidate = plan.regIntervalValues[low - 1]
    if plan.valueDefPositions[candidate] <= position &&
       plan.valueEndPositions[candidate] >= position:
        return candidate
    return -1

fn regallocValueNextUseAfter(plan: var RegallocSinglePassValuePlan,
                             valueId: int32,
                             position: int32): int32 =
    if valueId < 0 || valueId + 1 >= plan.valueUseOffsets.len:
        return -1
    var low = plan.valueUseOffsets[valueId]
    var high = plan.valueUseOffsets[valueId + 1]
    while low < high:
        let middle = low + (high - low) / 2
        if plan.valueUsePositions[middle] <= position:
            low = middle + 1
        else:
            high = middle
    if low < plan.valueUseOffsets[valueId + 1]:
        return plan.valueUsePositions[low]
    return -1

fn regallocValueLocationFor(plan: var RegallocSinglePassValuePlan,
                            valueId: int32): int32 =
    if valueId < 0 || valueId >= plan.valueAssignedRegs.len:
        return RegallocValueLocationNone
    if plan.valueAssignedRegs[valueId] >= 0:
        return RegallocValueLocationRegister
    return RegallocValueLocationStack

@borrows
fn regallocValueAppendAction(
        plan: var RegallocSinglePassValuePlan,
        kind: int32,
        placement: int32,
        position: int32,
        blockIndex: int32,
        opIndex: int32,
        termIndex: int32,
        factIndex: int32,
        valueId: int32): int32 =
    var action: RegallocValueAction
    action.consumerOrdinal = plan.actions.len
    action.acknowledged = false
    action.kind = kind
    action.placement = placement
    action.position = position
    action.blockIndex = blockIndex
    action.opIndex = opIndex
    action.termIndex = termIndex
    action.factIndex = factIndex
    action.valueId = valueId
    action.otherValueId = -1
    action.sourceReg = -1
    action.targetReg = -1
    action.sourceStackSlot = -1
    action.targetStackSlot = -1
    action.scratchReg = -1
    action.sourceBlock = -1
    action.targetBlock = -1
    action.edgeIndex = -1
    action.parallelGroup = -1
    action.parallelOrdinal = -1
    action.relatedActionOrdinal = -1
    action.fixedOrdinal = -1
    action.passKind = -1
    action.callOrdinal = -1
    action.outgoingStackArgIndex = -1
    action.outgoingStackByteOffset = -1
    action.semanticStart = -1
    action.semanticEnd = -1
    action.semanticRegister = -1
    action.fragmentOrdinal = -1
    add(plan.actions, action)
    return plan.actions.len - 1

fn regallocValueBindActionAbi(
        plan: var RegallocSinglePassValuePlan,
        actionIndex: int32,
        fact: bodyaccess.BodyIrAccessFact) =
    plan.actions[actionIndex].callOrdinal = fact.callOrdinal
    plan.actions[actionIndex].abiSizeBytes = fact.abiSizeBytes
    plan.actions[actionIndex].abiSizeExplicit = fact.abiSizeExplicit
    plan.actions[actionIndex].outgoingStackArgIndex =
        fact.outgoingStackArgIndex
    plan.actions[actionIndex].outgoingStackByteOffset =
        fact.outgoingStackByteOffset
    plan.actions[actionIndex].outgoingStackByteWidth =
        fact.outgoingStackByteWidth
    plan.actions[actionIndex].outgoingStackFrameBytes =
        fact.outgoingStackFrameBytes

fn regallocValuePinSiteRegisters(
        accessTable: var bodyaccess.BodyIrAccessTable,
        analysis: var cfg.BodyIrCfgAnalysis,
        plan: var RegallocSinglePassValuePlan,
        factStart: int32,
        factCount: int32,
        pinnedRegs: var bool[]) =
    for factIndex in factStart..<(factStart + factCount):
        let fact = accessTable.facts[factIndex]
        if fact.kind == bodyaccess.BodyIrAccessFactUse:
            let valueId = analysis.reachingValueByFact[factIndex]
            if valueId >= 0 && valueId < plan.valueAssignedRegs.len:
                let reg = plan.valueAssignedRegs[valueId]
                if reg >= 0:
                    pinnedRegs[reg] = true
        if fact.fixedKind != bodyaccess.BodyIrAccessFixedNone &&
           fact.fixedKind != bodyaccess.BodyIrAccessFixedGlobal:
            let fixedReg = regallocValueFixedRegForFact(
                accessTable, plan, fact)
            if fixedReg >= 0:
                pinnedRegs[fixedReg] = true

fn regallocValueScratchCandidate(
        plan: var RegallocSinglePassValuePlan,
        position: int32,
        pinnedRegs: var bool[],
        currentValues: var int32[],
        displacedOwner: var int32): int32 =
    displacedOwner = -1
    for poolOrdinal in 0..<2:
        var poolLength =
            plan.constraints.allocatableCallerRegs.len
        if poolOrdinal == 1:
            poolLength =
                plan.constraints.allocatableCalleeRegs.len
        for i in 0..<poolLength:
            var reg: int32
            if poolOrdinal == 0:
                reg = plan.constraints.allocatableCallerRegs[i]
            else:
                reg = plan.constraints.allocatableCalleeRegs[i]
            if pinnedRegs[reg]:
                continue
            let owner = regallocValueOwnerAt(plan, reg, position)
            if owner < 0:
                return reg
            let slotIndex = plan.valueSlotIndices[owner]
            if slotIndex < 0 || slotIndex >= currentValues.len ||
               currentValues[slotIndex] != owner:
                return reg
    var bestReg: int32 = -1
    var bestOwner: int32 = -1
    var bestNext: int32 = -1
    for poolOrdinal in 0..<2:
        var poolLength =
            plan.constraints.allocatableCallerRegs.len
        if poolOrdinal == 1:
            poolLength =
                plan.constraints.allocatableCalleeRegs.len
        for i in 0..<poolLength:
            var reg: int32
            if poolOrdinal == 0:
                reg = plan.constraints.allocatableCallerRegs[i]
            else:
                reg = plan.constraints.allocatableCalleeRegs[i]
            if pinnedRegs[reg]:
                continue
            let owner = regallocValueOwnerAt(plan, reg, position)
            if owner < 0:
                continue
            var nextUse = regallocValueNextUseAfter(plan, owner, position)
            if nextUse < 0:
                nextUse = plan.positionCount + 1
            if bestReg < 0 || nextUse > bestNext ||
               (nextUse == bestNext && reg > bestReg):
                bestReg = reg
                bestOwner = owner
                bestNext = nextUse
    displacedOwner = bestOwner
    return bestReg

fn regallocValuePlanCallSaves(
        plan: var RegallocSinglePassValuePlan,
        blockIndex: int32,
        opIndex: int32,
        position: int32,
        currentValues: var int32[],
        savedValues: var int32[],
        savedRegs: var int32[],
        savedActionOrdinals: var int32[]) =
    for i in 0..<plan.constraints.callClobberRegs.len:
        let reg = plan.constraints.callClobberRegs[i]
        let owner = regallocValueOwnerAt(plan, reg, position)
        if owner < 0 || plan.valueEndPositions[owner] <= position:
            continue
        let slotIndex = plan.valueSlotIndices[owner]
        if slotIndex < 0 || slotIndex >= currentValues.len ||
           currentValues[slotIndex] != owner:
            continue
        let actionIndex = regallocValueAppendAction(
            plan, RegallocValueActionSpillCall,
            RegallocValuePlacementBeforeOp, position,
            blockIndex, opIndex, -1, -1, owner)
        plan.actions[actionIndex].sourceLocation =
            RegallocValueLocationRegister
        plan.actions[actionIndex].targetLocation = RegallocValueLocationStack
        plan.actions[actionIndex].sourceReg = reg
        add(savedValues, owner)
        add(savedRegs, reg)
        add(savedActionOrdinals, actionIndex)

fn regallocValuePlanFixedInput(
        accessTable: var bodyaccess.BodyIrAccessTable,
        analysis: var cfg.BodyIrCfgAnalysis,
        plan: var RegallocSinglePassValuePlan,
        factIndex: int32,
        blockIndex: int32,
        opIndex: int32,
        termIndex: int32,
        placement: int32,
        position: int32,
        parallelGroup: int32) =
    let fact = accessTable.facts[factIndex]
    let fixedReg = regallocValueFixedRegForFact(
        accessTable, plan, fact)
    # Every fixed-input fact that names a physical ABI register freezes its
    # binding here, before any early return, so the action proof and the
    # production receipt consume the same authority.  Stack call args keep
    # fixedReg=-1, the no-register sentinel the StoreStackArg proof requires.
    plan.operandRegByFact[factIndex] = fixedReg
    if fact.kind == bodyaccess.BodyIrAccessFactFixed &&
       fact.fixedKind == bodyaccess.BodyIrAccessFixedSretForward:
        let actionIndex = regallocValueAppendAction(
            plan, RegallocValueActionSretForward,
            placement, position, blockIndex, opIndex, termIndex,
            factIndex, -1)
        plan.actions[actionIndex].fixedKind = fact.fixedKind
        plan.actions[actionIndex].passKind = fact.passKind
        plan.actions[actionIndex].semanticKind =
            coreir.BodyOpCallTag
        plan.actions[actionIndex].semanticRegister = fixedReg
        regallocValueBindActionAbi(plan, actionIndex, fact)
        return
    let stackCallArg = fact.fixedKind == bodyaccess.BodyIrAccessFixedCallArg &&
                       fixedReg < 0
    if fact.kind == bodyaccess.BodyIrAccessFactAddress:
        var kind = RegallocValueActionAddressFixed
        if stackCallArg:
            kind = RegallocValueActionStoreStackArg
        let actionIndex = regallocValueAppendAction(
            plan, kind, placement, position,
            blockIndex, opIndex, termIndex, factIndex, -1)
        plan.actions[actionIndex].sourceLocation =
            RegallocValueLocationAddress
        if stackCallArg:
            plan.actions[actionIndex].targetLocation =
                RegallocValueLocationStack
        else:
            plan.actions[actionIndex].targetLocation =
                RegallocValueLocationRegister
            plan.actions[actionIndex].targetReg = fixedReg
        plan.actions[actionIndex].parallelGroup = parallelGroup
        plan.actions[actionIndex].parallelOrdinal = fact.fixedOrdinal
        plan.actions[actionIndex].fixedKind = fact.fixedKind
        plan.actions[actionIndex].fixedOrdinal = fact.fixedOrdinal
        plan.actions[actionIndex].passKind = fact.passKind
        plan.actions[actionIndex].encodedValue = fact.slotIndex
        regallocValueBindActionAbi(plan, actionIndex, fact)
        return
    if fact.kind == bodyaccess.BodyIrAccessFactFixed:
        var kind = RegallocValueActionLoadFixed
        if stackCallArg:
            kind = RegallocValueActionStoreStackArg
        let actionIndex = regallocValueAppendAction(
            plan, kind, placement, position,
            blockIndex, opIndex, termIndex, factIndex, -1)
        plan.actions[actionIndex].sourceLocation =
            RegallocValueLocationConstant
        if stackCallArg:
            plan.actions[actionIndex].targetLocation =
                RegallocValueLocationStack
        else:
            plan.actions[actionIndex].targetLocation =
                RegallocValueLocationRegister
            plan.actions[actionIndex].targetReg = fixedReg
        plan.actions[actionIndex].parallelGroup = parallelGroup
        plan.actions[actionIndex].parallelOrdinal = fact.fixedOrdinal
        plan.actions[actionIndex].fixedKind = fact.fixedKind
        plan.actions[actionIndex].fixedOrdinal = fact.fixedOrdinal
        plan.actions[actionIndex].passKind = fact.passKind
        plan.actions[actionIndex].encodedValue = fact.encodedValue
        regallocValueBindActionAbi(plan, actionIndex, fact)
        return
    if fact.kind != bodyaccess.BodyIrAccessFactUse:
        return
    let valueId = analysis.reachingValueByFact[factIndex]
    if fact.fixedKind == bodyaccess.BodyIrAccessFixedReturnValue &&
       (fact.typeKind == coreir.LocalStrTag ||
        fact.typeKind == coreir.LocalAggregateTag):
        let actionIndex = regallocValueAppendAction(
            plan, RegallocValueActionStoreSretReturn,
            placement, position, blockIndex, opIndex, termIndex,
            factIndex, valueId)
        plan.actions[actionIndex].sourceLocation =
            RegallocValueLocationStack
        plan.actions[actionIndex].targetLocation =
            RegallocValueLocationAddress
        plan.actions[actionIndex].targetReg = fixedReg
        plan.actions[actionIndex].targetMemoryHome = true
        plan.actions[actionIndex].parallelGroup = parallelGroup
        plan.actions[actionIndex].parallelOrdinal = fact.fixedOrdinal
        plan.actions[actionIndex].fixedKind = fact.fixedKind
        plan.actions[actionIndex].fixedOrdinal = fact.fixedOrdinal
        plan.actions[actionIndex].passKind = fact.passKind
        regallocValueBindActionAbi(plan, actionIndex, fact)
        return
    plan.operandRegByFact[factIndex] = fixedReg
    if fact.addressEscapes:
        return
    if stackCallArg:
        let actionIndex = regallocValueAppendAction(
            plan, RegallocValueActionStoreStackArg,
            placement, position, blockIndex, opIndex, termIndex,
            factIndex, valueId)
        plan.actions[actionIndex].sourceLocation =
            regallocValueLocationFor(plan, valueId)
        plan.actions[actionIndex].sourceReg =
            plan.valueAssignedRegs[valueId]
        plan.actions[actionIndex].targetLocation =
            RegallocValueLocationStack
        plan.actions[actionIndex].parallelGroup = parallelGroup
        plan.actions[actionIndex].parallelOrdinal = fact.fixedOrdinal
        plan.actions[actionIndex].fixedKind = fact.fixedKind
        plan.actions[actionIndex].fixedOrdinal = fact.fixedOrdinal
        plan.actions[actionIndex].passKind = fact.passKind
        regallocValueBindActionAbi(plan, actionIndex, fact)
        return
    var kind = RegallocValueActionLoadFixed
    let sourceReg = plan.valueAssignedRegs[valueId]
    if sourceReg >= 0:
        kind = RegallocValueActionMoveFixed
    let actionIndex = regallocValueAppendAction(
        plan, kind, placement, position,
        blockIndex, opIndex, termIndex, factIndex, valueId)
    plan.actions[actionIndex].sourceLocation =
        regallocValueLocationFor(plan, valueId)
    plan.actions[actionIndex].targetLocation =
        RegallocValueLocationRegister
    plan.actions[actionIndex].sourceReg = sourceReg
    plan.actions[actionIndex].targetReg = fixedReg
    plan.actions[actionIndex].parallelGroup = parallelGroup
    plan.actions[actionIndex].parallelOrdinal = fact.fixedOrdinal
    plan.actions[actionIndex].fixedKind = fact.fixedKind
    plan.actions[actionIndex].fixedOrdinal = fact.fixedOrdinal
    plan.actions[actionIndex].passKind = fact.passKind
    regallocValueBindActionAbi(plan, actionIndex, fact)

fn regallocValuePlanOrdinaryUse(
        analysis: var cfg.BodyIrCfgAnalysis,
        plan: var RegallocSinglePassValuePlan,
        factIndex: int32,
        blockIndex: int32,
        opIndex: int32,
        termIndex: int32,
        beforePlacement: int32,
        afterPlacement: int32,
        beforePosition: int32,
        afterPosition: int32,
        pinnedRegs: var bool[],
        currentValues: var int32[],
        displacedValues: var int32[],
        displacedRegs: var int32[],
        displacedActionOrdinals: var int32[]): bool =
    let valueId = analysis.reachingValueByFact[factIndex]
    let assignedReg = plan.valueAssignedRegs[valueId]
    if assignedReg >= 0:
        plan.operandRegByFact[factIndex] = assignedReg
        return true
    let valueClass = plan.valueClasses[valueId]
    if valueClass != RegallocValueClassGpr &&
       valueClass != RegallocValueClassAddressHome:
        return true
    var displacedOwner: int32
    let scratchReg = regallocValueScratchCandidate(
        plan, beforePosition, pinnedRegs, currentValues, displacedOwner)
    if scratchReg < 0:
        regallocValueFail(plan,
                         RegallocValuePlanErrorOperandPressure,
                         factIndex)
        return false
    if displacedOwner >= 0:
        let spillIndex = regallocValueAppendAction(
            plan, RegallocValueActionSpillTemporary,
            beforePlacement, beforePosition,
            blockIndex, opIndex, termIndex, factIndex, displacedOwner)
        plan.actions[spillIndex].sourceLocation =
            RegallocValueLocationRegister
        plan.actions[spillIndex].targetLocation = RegallocValueLocationStack
        plan.actions[spillIndex].sourceReg = scratchReg
        if plan.valueEndPositions[displacedOwner] > afterPosition:
            add(displacedValues, displacedOwner)
            add(displacedRegs, scratchReg)
            add(displacedActionOrdinals, spillIndex)
    let reloadIndex = regallocValueAppendAction(
        plan, RegallocValueActionReloadOperand,
        beforePlacement, beforePosition,
        blockIndex, opIndex, termIndex, factIndex, valueId)
    plan.actions[reloadIndex].sourceLocation = RegallocValueLocationStack
    plan.actions[reloadIndex].targetLocation =
        RegallocValueLocationRegister
    plan.actions[reloadIndex].targetReg = scratchReg
    plan.operandRegByFact[factIndex] = scratchReg
    pinnedRegs[scratchReg] = true
    return true

fn regallocValuePlanDefinition(
        accessTable: var bodyaccess.BodyIrAccessTable,
        analysis: var cfg.BodyIrCfgAnalysis,
        plan: var RegallocSinglePassValuePlan,
        factIndex: int32,
        blockIndex: int32,
        opIndex: int32,
        termIndex: int32,
        placement: int32,
        position: int32) =
    let fact = accessTable.facts[factIndex]
    let valueId = fact.valueId
    if valueId < 0 || valueId >= plan.valueAssignedRegs.len:
        regallocValueFail(plan,
                         RegallocValuePlanErrorFactShape,
                         factIndex)
        return
    let live = plan.valueUseOffsets[valueId + 1] >
               plan.valueUseOffsets[valueId]
    let home = plan.valueMemoryHomes[valueId]
    if !live && !home:
        return
    let assignedReg = plan.valueAssignedRegs[valueId]
    if fact.fixedKind == bodyaccess.BodyIrAccessFixedCallWriteHome:
        # 全覆盖写内征(setMem)的目的 def:调用本身完成 home 写入,与 sret
        # 结果同构 — 不要寄存器、不要 producer,结构性 bind 标记 home 已写。
        if assignedReg >= 0 || !home ||
           plan.valueClasses[valueId] != RegallocValueClassStack:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             factIndex)
            return
        let writeHomeIndex = regallocValueAppendAction(
            plan, RegallocValueActionBindCallWriteHome,
            placement, position, blockIndex, opIndex, termIndex,
            factIndex, valueId)
        plan.actions[writeHomeIndex].sourceLocation =
            RegallocValueLocationStack
        plan.actions[writeHomeIndex].targetLocation =
            RegallocValueLocationStack
        plan.actions[writeHomeIndex].targetMemoryHome = true
        plan.actions[writeHomeIndex].fixedKind = fact.fixedKind
        return
    let fixedResult = fact.fixedKind ==
                          bodyaccess.BodyIrAccessFixedCallResult ||
                        fact.fixedKind ==
                          bodyaccess.BodyIrAccessFixedSretResult
    if fixedResult:
        let fixedReg = regallocValueFixedRegForFact(
            accessTable, plan, fact)
        if fact.fixedKind == bodyaccess.BodyIrAccessFixedSretResult:
            if assignedReg >= 0 ||
               plan.valueClasses[valueId] != RegallocValueClassStack:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorFactShape,
                                 factIndex)
                return
            let sretIndex = regallocValueAppendAction(
                plan, RegallocValueActionBindSretResult,
                placement, position, blockIndex, opIndex, termIndex,
                factIndex, valueId)
            plan.actions[sretIndex].sourceLocation =
                RegallocValueLocationStack
            plan.actions[sretIndex].targetLocation =
                RegallocValueLocationStack
            plan.actions[sretIndex].targetMemoryHome = true
            plan.actions[sretIndex].fixedKind = fact.fixedKind
            plan.actions[sretIndex].sourceReg = fixedReg
            regallocValueBindActionAbi(
                plan, sretIndex, fact)
            return
        if assignedReg >= 0 && home:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             factIndex)
            return
        var kind = RegallocValueActionStoreFixedResult
        if assignedReg >= 0:
            kind = RegallocValueActionBindFixedResult
        let actionIndex = regallocValueAppendAction(
            plan, kind, placement, position,
            blockIndex, opIndex, termIndex, factIndex, valueId)
        plan.actions[actionIndex].sourceLocation =
            RegallocValueLocationRegister
        plan.actions[actionIndex].sourceReg = fixedReg
        plan.actions[actionIndex].fixedKind = fact.fixedKind
        if assignedReg >= 0:
            plan.actions[actionIndex].targetLocation =
                RegallocValueLocationRegister
            plan.actions[actionIndex].targetReg = assignedReg
        else:
            plan.actions[actionIndex].targetLocation =
                RegallocValueLocationStack
            plan.actions[actionIndex].targetMemoryHome = home
        return
    if assignedReg >= 0:
        if home:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             factIndex)
            return
        var coalescedSourceValue: int32 = -1
        var coalescedReloadOrdinal: int32 = -1
        if opIndex >= 0 && opIndex < plan.bodyOpKinds.len &&
           opIndex < plan.bodyOpOperandCounts.len &&
           plan.bodyOpOperandCounts[opIndex] == 1 &&
           (plan.bodyOpKinds[opIndex] == coreir.BodyOpCopyLocalTag ||
            plan.bodyOpKinds[opIndex] == coreir.BodyOpStoreLocalTag ||
            plan.bodyOpKinds[opIndex] == coreir.BodyOpLoadLocalTag):
            var ordinaryUseCount: int32
            var definitionCount: int32
            var sourceUseFactIndex: int32 = -1
            if opIndex < accessTable.opFactStarts.len &&
               opIndex < accessTable.opFactCounts.len:
                let opFactStart = accessTable.opFactStarts[opIndex]
                let opFactCount = accessTable.opFactCounts[opIndex]
                if opFactStart >= 0 && opFactCount >= 0 &&
                   opFactStart <= accessTable.facts.len - opFactCount:
                    let opFactEnd = opFactStart + opFactCount
                    for opFactIndex in opFactStart..<opFactEnd:
                        let opFact = accessTable.facts[opFactIndex]
                        if opFact.kind == bodyaccess.BodyIrAccessFactUse &&
                           opFact.fixedKind ==
                               bodyaccess.BodyIrAccessFixedNone:
                            ordinaryUseCount = ordinaryUseCount + 1
                            sourceUseFactIndex = opFactIndex
                        elif opFact.kind == bodyaccess.BodyIrAccessFactDef:
                            definitionCount = definitionCount + 1
            if ordinaryUseCount == 1 && definitionCount == 1 &&
               sourceUseFactIndex >= 0 &&
               sourceUseFactIndex < analysis.reachingValueByFact.len &&
               sourceUseFactIndex < plan.operandRegByFact.len:
                coalescedSourceValue =
                    analysis.reachingValueByFact[sourceUseFactIndex]
                var sourceWidth: int32
                var targetWidth: int32
                if coalescedSourceValue >= 0 &&
                   coalescedSourceValue < plan.valueTypeKinds.len &&
                   valueId >= 0 && valueId < plan.valueTypeKinds.len:
                    sourceWidth = regallocValueGprWidth(
                        plan.valueTypeKinds[coalescedSourceValue])
                    targetWidth = regallocValueGprWidth(
                        plan.valueTypeKinds[valueId])
                if coalescedSourceValue < 0 ||
                   coalescedSourceValue >= plan.valueAssignedRegs.len ||
                   coalescedSourceValue >= plan.valueTypeKinds.len ||
                   coalescedSourceValue >= plan.valueClasses.len ||
                   valueId >= plan.valueTypeKinds.len ||
                   coalescedSourceValue == valueId ||
                   plan.operandRegByFact[sourceUseFactIndex] !=
                       assignedReg ||
                   sourceWidth <= 0 || targetWidth <= 0 ||
                   !regallocValueCopyRepresentationNoop(
                       plan.valueTypeKinds[coalescedSourceValue],
                       plan.valueTypeKinds[valueId]) ||
                   !regallocValueContains(
                       plan.constraints.gprTypeKinds,
                       plan.valueTypeKinds[coalescedSourceValue]) ||
                   !regallocValueContains(
                       plan.constraints.gprTypeKinds,
                       plan.valueTypeKinds[valueId]):
                    coalescedSourceValue = -1
                if coalescedSourceValue >= 0 &&
                   plan.valueAssignedRegs[coalescedSourceValue] !=
                       assignedReg:
                    if plan.valueAssignedRegs[coalescedSourceValue] >= 0 ||
                       plan.valueClasses[coalescedSourceValue] !=
                           RegallocValueClassAddressHome:
                        coalescedSourceValue = -1
                    else:
                        for actionIndex in 0..<plan.actions.len:
                            let origin = plan.actions[actionIndex]
                            if origin.kind !=
                                   RegallocValueActionReloadOperand ||
                               origin.factIndex != sourceUseFactIndex:
                                continue
                            if coalescedReloadOrdinal >= 0 ||
                               origin.valueId != coalescedSourceValue ||
                               origin.placement !=
                                   RegallocValuePlacementBeforeOp ||
                               origin.position !=
                                   plan.opBeforePositions[opIndex] ||
                               origin.blockIndex != blockIndex ||
                               origin.opIndex != opIndex ||
                               origin.termIndex != termIndex ||
                               origin.sourceLocation !=
                                   RegallocValueLocationStack ||
                               origin.targetLocation !=
                                   RegallocValueLocationRegister ||
                               origin.targetReg != assignedReg:
                                coalescedSourceValue = -1
                            else:
                                coalescedReloadOrdinal = actionIndex
                        if coalescedReloadOrdinal < 0:
                            coalescedSourceValue = -1
        if coalescedSourceValue >= 0:
            let coalescedIndex = regallocValueAppendAction(
                plan, RegallocValueActionCoalescedCopy,
                placement, position, blockIndex, opIndex, termIndex,
                factIndex, valueId)
            plan.actions[coalescedIndex].otherValueId =
                coalescedSourceValue
            plan.actions[coalescedIndex].sourceLocation =
                RegallocValueLocationRegister
            plan.actions[coalescedIndex].targetLocation =
                RegallocValueLocationRegister
            plan.actions[coalescedIndex].sourceReg = assignedReg
            plan.actions[coalescedIndex].targetReg = assignedReg
            plan.actions[coalescedIndex].relatedActionOrdinal =
                coalescedReloadOrdinal
            plan.actions[coalescedIndex].semanticKind =
                plan.bodyOpKinds[opIndex]
            plan.actions[coalescedIndex].semanticRegister = assignedReg
            return
        let bindIndex = regallocValueAppendAction(
            plan, RegallocValueActionBindDef, placement, position,
            blockIndex, opIndex, termIndex, factIndex, valueId)
        plan.actions[bindIndex].targetLocation =
            RegallocValueLocationRegister
        plan.actions[bindIndex].targetReg = assignedReg
    else:
        var kind = RegallocValueActionStoreDef
        if home:
            kind = RegallocValueActionStoreHome
        let storeIndex = regallocValueAppendAction(
            plan, kind, placement, position,
            blockIndex, opIndex, termIndex, factIndex, valueId)
        plan.actions[storeIndex].targetLocation = RegallocValueLocationStack
        plan.actions[storeIndex].targetMemoryHome = home

fn regallocValuePlanSite(
        accessTable: var bodyaccess.BodyIrAccessTable,
        analysis: var cfg.BodyIrCfgAnalysis,
        plan: var RegallocSinglePassValuePlan,
        factStart: int32,
        factCount: int32,
        blockIndex: int32,
        opIndex: int32,
        termIndex: int32,
        beforePosition: int32,
        afterPosition: int32,
        currentValues: var int32[],
        nextParallelGroup: var int32) =
    var beforePlacement = RegallocValuePlacementBeforeOp
    var afterPlacement = RegallocValuePlacementAfterOp
    if termIndex >= 0:
        beforePlacement = RegallocValuePlacementBeforeTerm
        afterPlacement = RegallocValuePlacementAfterTerm
    var isCall: bool
    var hasFixedInputs: bool
    for factIndex in factStart..<(factStart + factCount):
        let fact = accessTable.facts[factIndex]
        if fact.kind == bodyaccess.BodyIrAccessFactClobber &&
           fact.clobberKind == bodyaccess.BodyIrAccessClobberCallAbi:
            isCall = true
        if fact.kind != bodyaccess.BodyIrAccessFactDef &&
           fact.fixedKind != bodyaccess.BodyIrAccessFixedNone &&
           fact.fixedKind != bodyaccess.BodyIrAccessFixedGlobal:
            hasFixedInputs = true
    var pinnedRegs = regallocValueBoolSeq(63, false)
    regallocValuePinSiteRegisters(accessTable, analysis, plan,
                                  factStart, factCount, pinnedRegs)
    var savedValues: int32[]
    var savedRegs: int32[]
    var savedActionOrdinals: int32[]
    if isCall:
        regallocValuePlanCallSaves(plan, blockIndex, opIndex,
                                   beforePosition, currentValues,
                                   savedValues, savedRegs,
                                   savedActionOrdinals)
    var parallelGroup: int32 = -1
    if hasFixedInputs:
        parallelGroup = nextParallelGroup
        nextParallelGroup = nextParallelGroup + 1
    for factIndex in factStart..<(factStart + factCount):
        let fact = accessTable.facts[factIndex]
        if fact.kind == bodyaccess.BodyIrAccessFactDef &&
           fact.fixedKind == bodyaccess.BodyIrAccessFixedSretResult:
            let addressIndex = regallocValueAppendAction(
                plan, RegallocValueActionAddressFixed,
                beforePlacement, beforePosition,
                blockIndex, opIndex, termIndex, factIndex, fact.valueId)
            plan.actions[addressIndex].sourceLocation =
                RegallocValueLocationAddress
            plan.actions[addressIndex].targetLocation =
                RegallocValueLocationRegister
            plan.actions[addressIndex].targetReg =
                plan.constraints.fixedSretReg
            plan.actions[addressIndex].targetMemoryHome = true
            plan.actions[addressIndex].fixedKind = fact.fixedKind
            plan.actions[addressIndex].encodedValue = fact.slotIndex
            regallocValueBindActionAbi(
                plan, addressIndex, fact)
    for factIndex in factStart..<(factStart + factCount):
        let fact = accessTable.facts[factIndex]
        if fact.kind != bodyaccess.BodyIrAccessFactDef &&
           fact.fixedKind != bodyaccess.BodyIrAccessFixedNone &&
           fact.fixedKind != bodyaccess.BodyIrAccessFixedGlobal:
            regallocValuePlanFixedInput(
                accessTable, analysis, plan, factIndex,
                blockIndex, opIndex, termIndex,
                beforePlacement, beforePosition, parallelGroup)
    var displacedValues: int32[]
    var displacedRegs: int32[]
    var displacedActionOrdinals: int32[]
    for factIndex in factStart..<(factStart + factCount):
        let fact = accessTable.facts[factIndex]
        if fact.kind == bodyaccess.BodyIrAccessFactUse &&
           fact.fixedKind == bodyaccess.BodyIrAccessFixedNone:
            if !regallocValuePlanOrdinaryUse(
                    analysis, plan, factIndex,
                    blockIndex, opIndex, termIndex,
                    beforePlacement, afterPlacement,
                    beforePosition, afterPosition,
                    pinnedRegs, currentValues,
                    displacedValues, displacedRegs,
                    displacedActionOrdinals):
                return
    for factIndex in factStart..<(factStart + factCount):
        let fact = accessTable.facts[factIndex]
        if fact.kind == bodyaccess.BodyIrAccessFactClobber &&
           fact.clobberKind == bodyaccess.BodyIrAccessClobberCallAbi:
            let clobberIndex = regallocValueAppendAction(
                plan, RegallocValueActionCallClobber,
                beforePlacement, beforePosition,
                blockIndex, opIndex, termIndex, factIndex, -1)
            plan.actions[clobberIndex].callOrdinal = fact.callOrdinal
            plan.actions[clobberIndex].encodedValue = fact.clobberKind
    for factIndex in factStart..<(factStart + factCount):
        if accessTable.facts[factIndex].kind ==
           bodyaccess.BodyIrAccessFactDef:
            regallocValuePlanDefinition(
                accessTable, analysis, plan, factIndex,
                blockIndex, opIndex, termIndex,
                afterPlacement, afterPosition)
            if !plan.valid:
                return
    for factIndex in factStart..<(factStart + factCount):
        let fact = accessTable.facts[factIndex]
        if fact.kind == bodyaccess.BodyIrAccessFactDef:
            currentValues[fact.slotIndex] = fact.valueId
    for i in 0..<displacedValues.len:
        let valueId = displacedValues[i]
        let reg = displacedRegs[i]
        let slotIndex = plan.valueSlotIndices[valueId]
        if slotIndex < 0 || slotIndex >= currentValues.len ||
           currentValues[slotIndex] != valueId:
            continue
        let restoreIndex = regallocValueAppendAction(
            plan, RegallocValueActionRestoreTemporary,
            afterPlacement, afterPosition,
            blockIndex, opIndex, termIndex, -1, valueId)
        plan.actions[restoreIndex].sourceLocation =
            RegallocValueLocationStack
        plan.actions[restoreIndex].targetLocation =
            RegallocValueLocationRegister
        plan.actions[restoreIndex].targetReg = reg
        plan.actions[restoreIndex].relatedActionOrdinal =
            displacedActionOrdinals[i]
    if isCall:
        for i in 0..<savedValues.len:
            let valueId = savedValues[i]
            let slotIndex = plan.valueSlotIndices[valueId]
            if slotIndex < 0 || slotIndex >= currentValues.len ||
               currentValues[slotIndex] != valueId:
                continue
            let reloadIndex = regallocValueAppendAction(
                plan, RegallocValueActionReloadCall,
                RegallocValuePlacementAfterOp, afterPosition,
                blockIndex, opIndex, -1, -1, valueId)
            plan.actions[reloadIndex].sourceLocation =
                RegallocValueLocationStack
            plan.actions[reloadIndex].targetLocation =
                RegallocValueLocationRegister
            plan.actions[reloadIndex].targetReg = savedRegs[i]
            plan.actions[reloadIndex].relatedActionOrdinal =
                savedActionOrdinals[i]

fn regallocValueBodyReturnsSret(
        bodyIR: var coreir.BodyIR): bool =
    for callOrdinal in 0..<bodyIR.callSequence.len:
        if bodyIR.callSequence[callOrdinal].resultPassKind ==
               coreir.BodyCallPassForwardEntrySretTag:
            return true
    for termIndex in 0..<bodyIR.terms.len:
        let term = bodyIR.terms[termIndex]
        if term.kind != coreir.BodyTermReturnTag ||
           term.resultSlot < 0 ||
           term.resultSlot >= bodyIR.localSlots.len:
            continue
        let typeKind =
            bodyIR.localSlots[term.resultSlot].typeKind
        if typeKind == coreir.LocalAggregateTag ||
           typeKind == coreir.LocalStrTag:
            return true
    return false

@borrows
fn regallocValuePlanEntryDefinitions(
        bodyIR: var coreir.BodyIR,
        accessTable: var bodyaccess.BodyIrAccessTable,
        plan: var RegallocSinglePassValuePlan) =
    if plan.blockEntryPositions.len <= 0 ||
       plan.blockEntryPositions[0] < 0:
        return
    var fixedArgShift: int32
    if regallocValueBodyReturnsSret(bodyIR) &&
       RegallocTargetConstraintsSretShiftsFixedArgs(
           plan.constraints):
        fixedArgShift = 1
    let registerArgCount =
        plan.constraints.fixedArgRegs.len - fixedArgShift
    if registerArgCount < 0:
        regallocValueFail(
            plan, RegallocValuePlanErrorConstraintShape,
            registerArgCount)
        return
    for factIndex in 0..<accessTable.facts.len:
        let fact = accessTable.facts[factIndex]
        if fact.siteKind != bodyaccess.BodyIrAccessSiteEntry ||
           fact.kind != bodyaccess.BodyIrAccessFactDef:
            continue
        let valueId = fact.valueId
        if valueId < 0 || valueId >= plan.valueAssignedRegs.len:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             factIndex)
            return
        let reg = plan.valueAssignedRegs[valueId]
        if reg < 0:
            continue
        let slotIndex = plan.valueSlotIndices[valueId]
        if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len ||
           bodyIR.localSlots[slotIndex].stackOffset >= 0:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             factIndex)
            return
        let paramOrdinal =
            0 - 1 - bodyIR.localSlots[slotIndex].stackOffset
        if paramOrdinal < 0:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             factIndex)
            return
        let actionIndex = regallocValueAppendAction(
            plan, RegallocValueActionEntryReload,
            RegallocValuePlacementFunctionEntry,
            plan.blockEntryPositions[0], -1, -1, -1,
            factIndex, valueId)
        plan.actions[actionIndex].fixedOrdinal = paramOrdinal
        if paramOrdinal < registerArgCount:
            plan.actions[actionIndex].sourceLocation =
                RegallocValueLocationRegister
            plan.actions[actionIndex].sourceReg =
                plan.constraints.fixedArgRegs[
                    paramOrdinal + fixedArgShift]
            plan.actions[actionIndex].semanticRegister =
                plan.actions[actionIndex].sourceReg
        else:
            plan.actions[actionIndex].sourceLocation =
                RegallocValueLocationStack
        plan.actions[actionIndex].targetLocation =
            RegallocValueLocationRegister
        plan.actions[actionIndex].targetReg = reg

@borrows
fn regallocValuePlanLocalActions(
        bodyIR: var coreir.BodyIR,
        accessTable: var bodyaccess.BodyIrAccessTable,
        analysis: var cfg.BodyIrCfgAnalysis,
        plan: var RegallocSinglePassValuePlan,
        nextParallelGroup: var int32) =
    plan.opActionStarts = regallocValueIntSeq(bodyIR.ops.len, -1)
    plan.opActionCounts = regallocValueIntSeq(bodyIR.ops.len, 0)
    plan.termActionStarts = regallocValueIntSeq(bodyIR.terms.len, -1)
    plan.termActionCounts = regallocValueIntSeq(bodyIR.terms.len, 0)
    plan.blockEntryActionStarts = regallocValueIntSeq(bodyIR.blocks.len, -1)
    plan.blockEntryActionCounts = regallocValueIntSeq(bodyIR.blocks.len, 0)
    plan.blockExitActionStarts = regallocValueIntSeq(bodyIR.blocks.len, -1)
    plan.blockExitActionCounts = regallocValueIntSeq(bodyIR.blocks.len, 0)
    regallocValuePlanEntryDefinitions(bodyIR, accessTable, plan)
    if !plan.valid:
        return
    for rpoIndex in 0..<analysis.reversePostorder.len:
        let blockIndex = analysis.reversePostorder[rpoIndex]
        let block = bodyIR.blocks[blockIndex]
        var currentValues = regallocValueIntSeq(analysis.slotCount, -1)
        for slotIndex in 0..<analysis.slotCount:
            currentValues[slotIndex] = analysis.blockEntryVersions[blockIndex * analysis.slotCount + slotIndex]
        for opIndex in block.opStart..<(block.opStart + block.opCount):
            let actionStart = plan.actions.len
            regallocValuePlanSite(
                accessTable, analysis, plan,
                accessTable.opFactStarts[opIndex],
                accessTable.opFactCounts[opIndex],
                blockIndex, opIndex, -1,
                plan.opBeforePositions[opIndex],
                plan.opAfterPositions[opIndex],
                currentValues,
                nextParallelGroup)
            if !plan.valid:
                return
            if plan.actions.len > actionStart:
                plan.opActionStarts[opIndex] = actionStart
                plan.opActionCounts[opIndex] = plan.actions.len - actionStart
        let termIndex = block.termIndex
        let actionStart = plan.actions.len
        regallocValuePlanSite(
            accessTable, analysis, plan,
            accessTable.termFactStarts[termIndex],
            accessTable.termFactCounts[termIndex],
            blockIndex, -1, termIndex,
            plan.termBeforePositions[termIndex],
            plan.termAfterPositions[termIndex],
            currentValues,
            nextParallelGroup)
        if !plan.valid:
            return
        if plan.actions.len > actionStart:
            plan.termActionStarts[termIndex] = actionStart
            plan.termActionCounts[termIndex] = plan.actions.len - actionStart
        for slotIndex in 0..<analysis.slotCount:
            let expected = analysis.blockExitVersions[blockIndex * analysis.slotCount + slotIndex]
            if currentValues[slotIndex] != expected:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorFactShape,
                                 blockIndex * analysis.slotCount + slotIndex)
                return

@borrows
fn regallocValueAppendEdgeAction(
        analysis: var cfg.BodyIrCfgAnalysis,
        plan: var RegallocSinglePassValuePlan,
        copy: RegallocValueEdgeCopy,
        parallelGroup: int32,
        parallelOrdinal: int32,
        targetReachablePredCount: int32) =
    var placement = RegallocValuePlacementEdge
    var position: int32
    var blockIndex = copy.sourceBlock
    if copy.virtualEntry:
        placement = RegallocValuePlacementFunctionEntry
        position = plan.blockEntryPositions[copy.targetBlock]
        blockIndex = -1
    else:
        position = plan.blockExitPositions[copy.sourceBlock]
    let actionIndex = regallocValueAppendAction(
        plan, RegallocValueActionEdgeParallelCopy,
        placement, position, blockIndex, -1, -1, -1,
        copy.sourceValue)
    let sourceReg = plan.valueAssignedRegs[copy.sourceValue]
    let targetReg = plan.valueAssignedRegs[copy.targetValue]
    plan.actions[actionIndex].otherValueId = copy.targetValue
    plan.actions[actionIndex].sourceLocation =
        regallocValueLocationFor(plan, copy.sourceValue)
    plan.actions[actionIndex].targetLocation =
        regallocValueLocationFor(plan, copy.targetValue)
    plan.actions[actionIndex].sourceReg = sourceReg
    plan.actions[actionIndex].targetReg = targetReg
    if plan.actions[actionIndex].sourceLocation ==
       RegallocValueLocationStack:
        plan.actions[actionIndex].sourceStackSlot =
            plan.valueSlotIndices[copy.sourceValue]
    if plan.actions[actionIndex].targetLocation ==
       RegallocValueLocationStack:
        plan.actions[actionIndex].targetStackSlot =
            plan.valueSlotIndices[copy.targetValue]
    plan.actions[actionIndex].targetMemoryHome =
        plan.valueMemoryHomes[copy.targetValue]
    plan.actions[actionIndex].sourceBlock = copy.sourceBlock
    plan.actions[actionIndex].targetBlock = copy.targetBlock
    plan.actions[actionIndex].edgeIndex = copy.edgeIndex
    plan.actions[actionIndex].parallelGroup = parallelGroup
    plan.actions[actionIndex].parallelOrdinal = parallelOrdinal
    plan.actions[actionIndex].encodedValue = copy.slotIndex
    if !copy.virtualEntry:
        let successorCount = analysis.succOffsets[copy.sourceBlock + 1] -
                             analysis.succOffsets[copy.sourceBlock]
        plan.actions[actionIndex].requiresEdgeSplit =
            successorCount > 1 && targetReachablePredCount > 1

@borrows
fn regallocValueParallelCopyKind(kind: int32): bool =
    return kind == RegallocValueActionEdgeParallelCopy ||
           kind == RegallocValueActionParallelScratchSave ||
           kind == RegallocValueActionParallelScratchRestore

fn regallocValueParallelCopyPhysicalValid(
        plan: var RegallocSinglePassValuePlan,
        location: int32,
        reg: int32,
        stackSlot: int32): bool =
    if location == RegallocValueLocationRegister:
        return stackSlot < 0 && reg >= 0 &&
               regallocValueKnownRegister(plan.constraints, reg)
    if location == RegallocValueLocationStack:
        return reg < 0 && stackSlot >= 0 && stackSlot < 2147483647
    return false

fn regallocValueParallelCopyPhysicalEqual(
        leftLocation: int32,
        leftReg: int32,
        leftStackSlot: int32,
        rightLocation: int32,
        rightReg: int32,
        rightStackSlot: int32): bool =
    if leftLocation != rightLocation:
        return false
    if leftLocation == RegallocValueLocationRegister:
        return leftReg == rightReg
    if leftLocation == RegallocValueLocationStack:
        return leftStackSlot == rightStackSlot
    return false

@borrows
fn regallocValueParallelCopyRawShape(
        plan: var RegallocSinglePassValuePlan,
        action: RegallocValueAction,
        expectedGroup: int32,
        stackSlotCount: int32,
        detail: int32): bool =
    if action.kind != RegallocValueActionEdgeParallelCopy ||
       action.parallelGroup != expectedGroup ||
       action.parallelOrdinal < 0 ||
       action.relatedActionOrdinal >= 0 || action.scratchReg >= 0 ||
       (action.placement != RegallocValuePlacementEdge &&
        action.placement != RegallocValuePlacementBlockEntry &&
        action.placement != RegallocValuePlacementFunctionEntry) ||
       !regallocValueParallelCopyPhysicalValid(
           plan, action.sourceLocation,
           action.sourceReg, action.sourceStackSlot) ||
       !regallocValueParallelCopyPhysicalValid(
           plan, action.targetLocation,
           action.targetReg, action.targetStackSlot):
        regallocValueFail(plan,
                         RegallocValuePlanErrorParallelCopy,
                         detail)
        return false
    if (action.sourceLocation == RegallocValueLocationStack &&
        action.sourceStackSlot >= stackSlotCount) ||
       (action.targetLocation == RegallocValueLocationStack &&
        action.targetStackSlot >= stackSlotCount):
        regallocValueFail(plan,
                         RegallocValuePlanErrorParallelCopy,
                         detail)
        return false
    let scratch = plan.constraints.parallelCopyScratchReg
    if (action.sourceLocation == RegallocValueLocationRegister &&
        action.sourceReg == scratch) ||
       (action.targetLocation == RegallocValueLocationRegister &&
        action.targetReg == scratch):
        regallocValueFail(plan,
                         RegallocValuePlanErrorParallelCopy,
                         detail)
        return false
    if action.sourceLocation == RegallocValueLocationRegister &&
       !regallocValueContains(plan.constraints.allocatableCallerRegs,
                             action.sourceReg) &&
       !regallocValueContains(plan.constraints.allocatableCalleeRegs,
                             action.sourceReg):
        regallocValueFail(plan,
                         RegallocValuePlanErrorParallelCopy,
                         detail)
        return false
    if action.targetLocation == RegallocValueLocationRegister &&
       !regallocValueContains(plan.constraints.allocatableCallerRegs,
                             action.targetReg) &&
       !regallocValueContains(plan.constraints.allocatableCalleeRegs,
                             action.targetReg):
        regallocValueFail(plan,
                         RegallocValuePlanErrorParallelCopy,
                         detail)
        return false
    if action.sourceLocation == RegallocValueLocationStack &&
       action.targetLocation == RegallocValueLocationStack &&
       action.sourceStackSlot != action.targetStackSlot:
        regallocValueFail(plan,
                         RegallocValuePlanErrorParallelCopy,
                         detail)
        return false
    return true

@borrows
fn regallocValueParallelCopySourceKey(
        action: RegallocValueAction): int32 =
    if action.sourceLocation == RegallocValueLocationRegister:
        return action.sourceReg
    return 63 + action.sourceStackSlot

@borrows
fn regallocValueParallelCopyTargetKey(
        action: RegallocValueAction): int32 =
    if action.targetLocation == RegallocValueLocationRegister:
        return action.targetReg
    return 63 + action.targetStackSlot

@borrows
fn regallocValueParallelCopyTargetOwnerForSource(
        targetOwners: var int32[],
        action: RegallocValueAction): int32 =
    return targetOwners[regallocValueParallelCopySourceKey(action)]

@borrows
fn regallocValueParallelCopyDecrementSource(
        plan: var RegallocSinglePassValuePlan,
        sourceCounts: var int32[],
        action: RegallocValueAction,
        detail: int32): bool =
    let sourceKey = regallocValueParallelCopySourceKey(action)
    if sourceKey < 0 || sourceKey >= sourceCounts.len ||
       sourceCounts[sourceKey] <= 0:
        regallocValueFail(plan,
                         RegallocValuePlanErrorParallelCopy,
                         detail)
        return false
    sourceCounts[sourceKey] = sourceCounts[sourceKey] - 1
    return true

@borrows
fn regallocValueParallelCopyAppendResolved(
        plan: var RegallocSinglePassValuePlan,
        source: RegallocValueAction,
        parallelOrdinal: var int32): int32 =
    var action = source
    action.consumerOrdinal = plan.actions.len
    action.acknowledged = false
    action.parallelOrdinal = parallelOrdinal
    add(plan.actions, action)
    parallelOrdinal = parallelOrdinal + 1
    return plan.actions.len - 1

fn regallocValueResolveParallelCopyGroup(
        plan: var RegallocSinglePassValuePlan,
        groupStart: int32,
        groupCount: int32,
        stackSlotCount: int32): int32 =
    if groupStart < 0 || groupCount <= 0 ||
       stackSlotCount < 0 || stackSlotCount > 2147483584 ||
       groupCount > plan.actions.len - groupStart ||
       groupStart + groupCount != plan.actions.len:
        regallocValueFail(plan,
                         RegallocValuePlanErrorParallelCopy,
                         groupStart)
        return 0
    var pending: RegallocValueAction[]
    for actionIndex in groupStart..<(groupStart + groupCount):
        add(pending, plan.actions[actionIndex])
    setLen(plan.actions, groupStart)
    let expectedGroup = pending[0].parallelGroup
    let first = pending[0]
    var active = regallocValueBoolSeq(groupCount, false)
    for moveIndex in 0..<pending.len:
        let action = pending[moveIndex]
        if !regallocValueParallelCopyRawShape(
                plan, action, expectedGroup,
                stackSlotCount, moveIndex) ||
           action.parallelOrdinal != moveIndex ||
           action.placement != first.placement ||
           action.position != first.position ||
           action.sourceBlock != first.sourceBlock ||
           action.targetBlock != first.targetBlock ||
           action.edgeIndex != first.edgeIndex ||
           action.requiresEdgeSplit != first.requiresEdgeSplit:
            if plan.valid:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorParallelCopy,
                                 moveIndex)
            return 0
        if !regallocValueParallelCopyPhysicalEqual(
                action.sourceLocation, action.sourceReg,
                action.sourceStackSlot,
                action.targetLocation, action.targetReg,
                action.targetStackSlot):
            active[moveIndex] = true
    let locationCount = 63 + stackSlotCount
    var sourceCounts = regallocValueIntSeq(locationCount, 0)
    var targetOwners = regallocValueIntSeq(locationCount, -1)
    var remaining: int32
    for moveIndex in 0..<pending.len:
        if !active[moveIndex]:
            continue
        let action = pending[moveIndex]
        let targetKey = regallocValueParallelCopyTargetKey(action)
        let sourceKey = regallocValueParallelCopySourceKey(action)
        if targetKey < 0 || targetKey >= locationCount ||
           sourceKey < 0 || sourceKey >= locationCount ||
           targetOwners[targetKey] >= 0 ||
           sourceCounts[sourceKey] == 2147483647:
            regallocValueFail(plan,
                             RegallocValuePlanErrorParallelCopy,
                             moveIndex)
            return 0
        targetOwners[targetKey] = moveIndex
        sourceCounts[sourceKey] = sourceCounts[sourceKey] + 1
        remaining = remaining + 1
    var ready: int32[]
    for moveIndex in 0..<pending.len:
        let targetKey = regallocValueParallelCopyTargetKey(
            pending[moveIndex])
        if active[moveIndex] &&
           sourceCounts[targetKey] == 0:
            add(ready, moveIndex)
    var readyHead: int32
    var parallelOrdinal: int32
    var scratchLive: bool
    var scratchSaveAction: int32 = -1
    var cycleSearchStart: int32
    while remaining > 0:
        while readyHead < ready.len:
            let moveIndex = ready[readyHead]
            readyHead = readyHead + 1
            if !active[moveIndex]:
                continue
            let targetKey = regallocValueParallelCopyTargetKey(
                pending[moveIndex])
            if sourceCounts[targetKey] != 0:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorParallelCopy,
                                 moveIndex)
                return 0
            let action = pending[moveIndex]
            let _ = regallocValueParallelCopyAppendResolved(
                plan, action, parallelOrdinal)
            if action.kind ==
               RegallocValueActionParallelScratchRestore:
                if !scratchLive ||
                   action.relatedActionOrdinal != scratchSaveAction:
                    regallocValueFail(plan,
                                     RegallocValuePlanErrorParallelCopy,
                                     moveIndex)
                    return 0
                scratchLive = false
                scratchSaveAction = -1
            active[moveIndex] = false
            remaining = remaining - 1
            if !regallocValueParallelCopyDecrementSource(
                    plan, sourceCounts, action, moveIndex):
                return 0
            let sourceKey = regallocValueParallelCopySourceKey(action)
            if sourceCounts[sourceKey] == 0:
                let owner = regallocValueParallelCopyTargetOwnerForSource(
                    targetOwners, action)
                if owner >= 0 && active[owner]:
                    add(ready, owner)
        if remaining <= 0:
            break
        if scratchLive:
            regallocValueFail(plan,
                             RegallocValuePlanErrorParallelCopy,
                             remaining)
            return 0
        while cycleSearchStart < pending.len &&
              !active[cycleSearchStart]:
            cycleSearchStart = cycleSearchStart + 1
        var cycleMove: int32 = -1
        if cycleSearchStart < pending.len:
            cycleMove = cycleSearchStart
            cycleSearchStart = cycleSearchStart + 1
        let scratch = plan.constraints.parallelCopyScratchReg
        if cycleMove < 0 || scratch < 0 ||
           !regallocValueValidateParallelScratchConstraint(plan):
            if plan.valid:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorParallelCopy,
                                 cycleMove)
            return 0
        let cycleSourceKey = regallocValueParallelCopySourceKey(
            pending[cycleMove])
        let cycleSourceCount = sourceCounts[cycleSourceKey]
        if cycleSourceCount != 1 ||
           sourceCounts[scratch] != 0 || targetOwners[scratch] >= 0:
            regallocValueFail(plan,
                             RegallocValuePlanErrorParallelCopy,
                             cycleMove)
            return 0
        var save = pending[cycleMove]
        save.kind = RegallocValueActionParallelScratchSave
        save.targetLocation = RegallocValueLocationRegister
        save.targetReg = scratch
        save.targetStackSlot = -1
        save.scratchReg = scratch
        save.targetMemoryHome = false
        save.relatedActionOrdinal = -1
        scratchSaveAction = regallocValueParallelCopyAppendResolved(
            plan, save, parallelOrdinal)
        scratchLive = true
        let originalSource = pending[cycleMove]
        if !regallocValueParallelCopyDecrementSource(
                plan, sourceCounts, originalSource, cycleMove):
            return 0
        let owner = regallocValueParallelCopyTargetOwnerForSource(
            targetOwners, originalSource)
        if owner >= 0 && active[owner]:
            add(ready, owner)
        sourceCounts[scratch] = 1
        pending[cycleMove].kind =
            RegallocValueActionParallelScratchRestore
        pending[cycleMove].sourceLocation =
            RegallocValueLocationRegister
        pending[cycleMove].sourceReg = scratch
        pending[cycleMove].sourceStackSlot = -1
        pending[cycleMove].scratchReg = scratch
        pending[cycleMove].relatedActionOrdinal = scratchSaveAction
    if scratchLive:
        regallocValueFail(plan,
                         RegallocValuePlanErrorParallelCopy,
                         expectedGroup)
        return 0
    return plan.actions.len - groupStart

@borrows
fn regallocValuePlanEdgeActions(
        analysis: var cfg.BodyIrCfgAnalysis,
        plan: var RegallocSinglePassValuePlan,
        edgeCopies: var RegallocValueEdgeCopy[],
        nextParallelGroup: var int32) =
    var edgeCounts = regallocValueIntSeq(analysis.edgeCount, 0)
    var virtualCounts = regallocValueIntSeq(analysis.blockCount, 0)
    var reachablePredCounts = regallocValueIntSeq(analysis.blockCount, 0)
    for blockIndex in 0..<analysis.blockCount:
        for predIndex in analysis.predOffsets[blockIndex]..<analysis.predOffsets[blockIndex + 1]:
            if analysis.reachable[analysis.predBlocks[predIndex]]:
                reachablePredCounts[blockIndex] =
                    reachablePredCounts[blockIndex] + 1
    var realCount: int32
    for copyIndex in 0..<edgeCopies.len:
        let copy = edgeCopies[copyIndex]
        if copy.virtualEntry:
            virtualCounts[copy.targetBlock] =
                virtualCounts[copy.targetBlock] + 1
        else:
            if copy.edgeIndex < 0 || copy.edgeIndex >= analysis.edgeCount:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorFactShape,
                                 copyIndex)
                return
            edgeCounts[copy.edgeIndex] = edgeCounts[copy.edgeIndex] + 1
            realCount = realCount + 1
    var edgeOffsets: int32[]
    add(edgeOffsets, 0)
    for edgeIndex in 0..<analysis.edgeCount:
        add(edgeOffsets, edgeOffsets[edgeIndex] + edgeCounts[edgeIndex])
    var virtualOffsets: int32[]
    add(virtualOffsets, realCount)
    for blockIndex in 0..<analysis.blockCount:
        add(virtualOffsets,
            virtualOffsets[blockIndex] + virtualCounts[blockIndex])
    var copyOrder = regallocValueIntSeq(edgeCopies.len, -1)
    var edgeCursors = regallocValueIntSeq(analysis.edgeCount, 0)
    for edgeIndex in 0..<analysis.edgeCount:
        edgeCursors[edgeIndex] = edgeOffsets[edgeIndex]
    var virtualCursors = regallocValueIntSeq(analysis.blockCount, 0)
    for blockIndex in 0..<analysis.blockCount:
        virtualCursors[blockIndex] = virtualOffsets[blockIndex]
    for copyIndex in 0..<edgeCopies.len:
        let copy = edgeCopies[copyIndex]
        if copy.virtualEntry:
            let cursor = virtualCursors[copy.targetBlock]
            copyOrder[cursor] = copyIndex
            virtualCursors[copy.targetBlock] = cursor + 1
        else:
            let cursor = edgeCursors[copy.edgeIndex]
            copyOrder[cursor] = copyIndex
            edgeCursors[copy.edgeIndex] = cursor + 1
    for edgeIndex in 0..<analysis.edgeCount:
        let count = edgeCounts[edgeIndex]
        if count <= 0:
            continue
        plan.edgeActionStarts[edgeIndex] = plan.actions.len
        let groupStart = plan.actions.len
        let parallelGroup = nextParallelGroup
        nextParallelGroup = nextParallelGroup + 1
        var parallelOrdinal: int32
        for orderedIndex in edgeOffsets[edgeIndex]..<edgeOffsets[edgeIndex + 1]:
            let copyIndex = copyOrder[orderedIndex]
            regallocValueAppendEdgeAction(
                analysis, plan, edgeCopies[copyIndex],
                parallelGroup, parallelOrdinal,
                reachablePredCounts[edgeCopies[copyIndex].targetBlock])
            parallelOrdinal = parallelOrdinal + 1
        plan.edgeActionCounts[edgeIndex] =
            regallocValueResolveParallelCopyGroup(
                plan, groupStart, count, analysis.slotCount)
        if !plan.valid:
            return

    plan.virtualEntryActionStarts = regallocValueIntSeq(
        analysis.blockCount, -1)
    plan.virtualEntryActionCounts = regallocValueIntSeq(
        analysis.blockCount, 0)
    for blockIndex in 0..<analysis.blockCount:
        let count = virtualCounts[blockIndex]
        if count <= 0:
            continue
        plan.virtualEntryActionStarts[blockIndex] = plan.actions.len
        let groupStart = plan.actions.len
        let parallelGroup = nextParallelGroup
        nextParallelGroup = nextParallelGroup + 1
        var parallelOrdinal: int32
        for orderedIndex in virtualOffsets[blockIndex]..<virtualOffsets[blockIndex + 1]:
            let copyIndex = copyOrder[orderedIndex]
            regallocValueAppendEdgeAction(
                analysis, plan, edgeCopies[copyIndex],
                parallelGroup, parallelOrdinal,
                reachablePredCounts[edgeCopies[copyIndex].targetBlock])
            parallelOrdinal = parallelOrdinal + 1
        plan.virtualEntryActionCounts[blockIndex] =
            regallocValueResolveParallelCopyGroup(
                plan, groupStart, count, analysis.slotCount)
        if !plan.valid:
            return

fn regallocValueFreezeCalleeMask(
        plan: var RegallocSinglePassValuePlan) =
    var mask: int64
    for valueId in 0..<plan.valueAssignedRegs.len:
        let reg = plan.valueAssignedRegs[valueId]
        if reg >= 0 &&
           regallocValueContains(plan.constraints.allocatableCalleeRegs, reg):
            mask = mask | (int64(1) << reg)
    for actionIndex in 0..<plan.actions.len:
        let sourceReg = plan.actions[actionIndex].sourceReg
        let targetReg = plan.actions[actionIndex].targetReg
        if sourceReg >= 0 &&
           regallocValueContains(plan.constraints.allocatableCalleeRegs,
                                 sourceReg):
            mask = mask | (int64(1) << sourceReg)
        if targetReg >= 0 &&
           regallocValueContains(plan.constraints.allocatableCalleeRegs,
                                 targetReg):
            mask = mask | (int64(1) << targetReg)
    plan.usedCalleeMask = mask

@borrows
fn regallocValuePlanStructuralActions(
        plan: var RegallocSinglePassValuePlan) =
    for valueId in 0..<plan.valueClasses.len:
        let classificationIndex = regallocValueAppendAction(
            plan, RegallocValueActionValueClassification,
            RegallocValuePlacementFunctionEntry, 0,
            -1, -1, -1, plan.valueDefFactIndices[valueId], valueId)
        plan.actions[classificationIndex].semanticKind =
            plan.valueClasses[valueId]
        if plan.valueDefPositions[valueId] >= 0:
            let intervalIndex = regallocValueAppendAction(
                plan, RegallocValueActionLivenessInterval,
                RegallocValuePlacementFunctionEntry, 0,
                -1, -1, -1,
                plan.valueDefFactIndices[valueId], valueId)
            plan.actions[intervalIndex].semanticStart =
                plan.valueDefPositions[valueId]
            plan.actions[intervalIndex].semanticEnd =
                plan.valueEndPositions[valueId]
        if plan.valueMemoryHomes[valueId]:
            let homeIndex = regallocValueAppendAction(
                plan, RegallocValueActionAddressEscapeHome,
                RegallocValuePlacementFunctionEntry, 0,
                -1, -1, -1,
                plan.valueDefFactIndices[valueId], valueId)
            plan.actions[homeIndex].targetMemoryHome = true
        if plan.valueUseOffsets[valueId + 1] ==
               plan.valueUseOffsets[valueId] &&
           !plan.valueMemoryHomes[valueId]:
            let _ = regallocValueAppendAction(
                plan, RegallocValueActionDeadValue,
                RegallocValuePlacementFunctionEntry, 0,
                -1, -1, -1,
                plan.valueDefFactIndices[valueId], valueId)
    let machineActionCount = plan.actions.len
    for actionIndex in 0..<machineActionCount:
        let action = plan.actions[actionIndex]
        if action.kind != RegallocValueActionBindSretResult:
            continue
        let sretIndex = regallocValueAppendAction(
            plan, RegallocValueActionSretExclusion,
            RegallocValuePlacementFunctionEntry, 0,
            -1, -1, -1, action.factIndex, action.valueId)
        plan.actions[sretIndex].fixedKind =
            bodyaccess.BodyIrAccessFixedSretResult
        plan.actions[sretIndex].semanticRegister =
            plan.constraints.fixedSretReg
    for reg in 0..<63:
        if (plan.usedCalleeMask & (int64(1) << reg)) == 0:
            continue
        let calleeIndex = regallocValueAppendAction(
            plan, RegallocValueActionCalleeSavedSelection,
            RegallocValuePlacementFunctionEntry, 0,
            -1, -1, -1, -1, -1)
        plan.actions[calleeIndex].semanticRegister = reg

fn regallocValueRecordSlice(starts: var int32[],
                            counts: var int32[],
                            key: int32,
                            actionIndex: int32): bool =
    if key < 0 || key >= starts.len || counts.len != starts.len:
        return false
    if starts[key] < 0:
        starts[key] = actionIndex
    elif starts[key] + counts[key] != actionIndex:
        return false
    counts[key] = counts[key] + 1
    return true

@borrows
fn regallocValueFreezeActions(
        bodyIR: var coreir.BodyIR,
        analysis: var cfg.BodyIrCfgAnalysis,
        plan: var RegallocSinglePassValuePlan) =
    var positionCounts = regallocValueIntSeq(plan.positionCount, 0)
    for actionIndex in 0..<plan.actions.len:
        let position = plan.actions[actionIndex].position
        if position < 0 || position >= plan.positionCount:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             actionIndex)
            return
        positionCounts[position] = positionCounts[position] + 1
    var positionOffsets: int32[]
    add(positionOffsets, 0)
    for position in 0..<plan.positionCount:
        add(positionOffsets,
            positionOffsets[position] + positionCounts[position])
    var positionCursors = regallocValueIntSeq(plan.positionCount, 0)
    for position in 0..<plan.positionCount:
        positionCursors[position] = positionOffsets[position]
    var actionOrder = regallocValueIntSeq(plan.actions.len, -1)
    for actionIndex in 0..<plan.actions.len:
        let position = plan.actions[actionIndex].position
        let cursor = positionCursors[position]
        actionOrder[cursor] = actionIndex
        positionCursors[position] = cursor + 1
    var frozenActions: RegallocValueAction[]
    var frozenOrdinalBySource = regallocValueIntSeq(plan.actions.len, -1)
    var maxParallelGroup: int32 = -1
    for position in 0..<plan.positionCount:
        for orderIndex in positionOffsets[position]..<positionOffsets[position + 1]:
            let sourceIndex = actionOrder[orderIndex]
            var action = plan.actions[sourceIndex]
            action.consumerOrdinal = frozenActions.len
            action.acknowledged = false
            frozenOrdinalBySource[sourceIndex] = action.consumerOrdinal
            if action.parallelGroup > maxParallelGroup:
                maxParallelGroup = action.parallelGroup
            add(frozenActions, action)
    for actionIndex in 0..<frozenActions.len:
        let relatedSource = frozenActions[actionIndex].relatedActionOrdinal
        if relatedSource < 0:
            continue
        if relatedSource >= frozenOrdinalBySource.len ||
           frozenOrdinalBySource[relatedSource] < 0:
            regallocValueFail(plan,
                             RegallocValuePlanErrorActionShape,
                             actionIndex)
            return
        frozenActions[actionIndex].relatedActionOrdinal =
            frozenOrdinalBySource[relatedSource]
    var groupMap = regallocValueIntSeq(maxParallelGroup + 1, -1)
    var nextGroup: int32
    for actionIndex in 0..<frozenActions.len:
        let oldGroup = frozenActions[actionIndex].parallelGroup
        if oldGroup < 0:
            continue
        if groupMap[oldGroup] < 0:
            groupMap[oldGroup] = nextGroup
            nextGroup = nextGroup + 1
        frozenActions[actionIndex].parallelGroup = groupMap[oldGroup]
    var groupLastIndices = regallocValueIntSeq(nextGroup, -1)
    var groupNextOrdinals = regallocValueIntSeq(nextGroup, 0)
    for actionIndex in 0..<frozenActions.len:
        let group = frozenActions[actionIndex].parallelGroup
        if group < 0:
            continue
        if groupLastIndices[group] >= 0 &&
           groupLastIndices[group] != actionIndex - 1:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             actionIndex)
            return
        if frozenActions[actionIndex].parallelOrdinal !=
           groupNextOrdinals[group]:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             actionIndex)
            return
        groupLastIndices[group] = actionIndex
        groupNextOrdinals[group] = groupNextOrdinals[group] + 1
    plan.actions = frozenActions
    plan.opActionStarts = regallocValueIntSeq(bodyIR.ops.len, -1)
    plan.opActionCounts = regallocValueIntSeq(bodyIR.ops.len, 0)
    plan.termActionStarts = regallocValueIntSeq(bodyIR.terms.len, -1)
    plan.termActionCounts = regallocValueIntSeq(bodyIR.terms.len, 0)
    plan.blockEntryActionStarts = regallocValueIntSeq(bodyIR.blocks.len, -1)
    plan.blockEntryActionCounts = regallocValueIntSeq(bodyIR.blocks.len, 0)
    plan.blockExitActionStarts = regallocValueIntSeq(bodyIR.blocks.len, -1)
    plan.blockExitActionCounts = regallocValueIntSeq(bodyIR.blocks.len, 0)
    plan.edgeActionStarts = regallocValueIntSeq(analysis.edgeCount, -1)
    plan.edgeActionCounts = regallocValueIntSeq(analysis.edgeCount, 0)
    plan.virtualEntryActionStarts = regallocValueIntSeq(
        analysis.blockCount, -1)
    plan.virtualEntryActionCounts = regallocValueIntSeq(
        analysis.blockCount, 0)
    plan.functionEntryActionStart = -1
    plan.functionEntryActionCount = 0
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.opIndex >= 0 &&
           !regallocValueRecordSlice(plan.opActionStarts,
                                     plan.opActionCounts,
                                     action.opIndex,
                                     actionIndex):
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             actionIndex)
            return
        if action.termIndex >= 0 &&
           !regallocValueRecordSlice(plan.termActionStarts,
                                     plan.termActionCounts,
                                     action.termIndex,
                                     actionIndex):
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             actionIndex)
            return
        if action.placement == RegallocValuePlacementBlockEntry &&
           !regallocValueRecordSlice(plan.blockEntryActionStarts,
                                     plan.blockEntryActionCounts,
                                     action.blockIndex,
                                     actionIndex):
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             actionIndex)
            return
        if action.placement == RegallocValuePlacementFunctionEntry:
            if plan.functionEntryActionStart < 0:
                plan.functionEntryActionStart = actionIndex
            elif plan.functionEntryActionStart +
                 plan.functionEntryActionCount != actionIndex:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorFactShape,
                                 actionIndex)
                return
            plan.functionEntryActionCount =
                plan.functionEntryActionCount + 1
        if action.placement == RegallocValuePlacementBlockExit &&
           !regallocValueRecordSlice(plan.blockExitActionStarts,
                                     plan.blockExitActionCounts,
                                     action.blockIndex,
                                     actionIndex):
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             actionIndex)
            return
        if action.placement == RegallocValuePlacementEdge &&
           !regallocValueRecordSlice(plan.edgeActionStarts,
                                     plan.edgeActionCounts,
                                     action.edgeIndex,
                                     actionIndex):
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             actionIndex)
            return
        if regallocValueParallelCopyKind(action.kind) &&
           action.sourceBlock < 0 &&
           !regallocValueRecordSlice(plan.virtualEntryActionStarts,
                                     plan.virtualEntryActionCounts,
                                     action.targetBlock,
                                     actionIndex):
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             actionIndex)
            return

fn regallocValueIsAllocatable(plan: var RegallocSinglePassValuePlan,
                              reg: int32): bool =
    return regallocValueContains(plan.constraints.allocatableCallerRegs, reg) ||
           regallocValueContains(plan.constraints.allocatableCalleeRegs, reg)

fn regallocValueValidateIntervalProof(
        plan: var RegallocSinglePassValuePlan): bool =
    let valueCount = plan.valueDefPositions.len
    let useCount = plan.valueUsePositions.len
    if plan.stackSlotCount < 0 ||
       plan.valueDefFactIndices.len != valueCount ||
       plan.valueDefBlocks.len != valueCount ||
       plan.valueDefIsEntry.len != valueCount ||
       plan.valueEndPositions.len != valueCount ||
       plan.valueSlotIndices.len != valueCount ||
       plan.valueTypeKinds.len != valueCount ||
       plan.valueClasses.len != valueCount ||
       plan.valueMemoryHomes.len != valueCount ||
       plan.valueAssignedRegs.len != valueCount ||
       plan.valueUseOffsets.len != valueCount + 1 ||
       plan.valueUseFactIndices.len != useCount ||
       plan.valueUseKinds.len != useCount ||
       plan.valueUseSourceBlocks.len != useCount ||
       plan.valueUseTargetBlocks.len != useCount ||
       plan.regIntervalOffsets.len != 64 ||
       plan.regIntervalValues.len != plan.allocationOrder.len:
        regallocValueFail(plan,
                         RegallocValuePlanErrorIntervalShape,
                         valueCount)
        return false
    if plan.valueUseOffsets[0] != 0 ||
       plan.valueUseOffsets[valueCount] != useCount ||
       plan.regIntervalOffsets[0] != 0 ||
       plan.regIntervalOffsets[63] != plan.regIntervalValues.len:
        regallocValueFail(plan,
                         RegallocValuePlanErrorIntervalShape,
                         useCount)
        return false
    var assignedSeen = regallocValueBoolSeq(valueCount, false)
    for valueId in 0..<valueCount:
        let valueClass = plan.valueClasses[valueId]
        let memoryHome = plan.valueMemoryHomes[valueId]
        let assigned = plan.valueAssignedRegs[valueId]
        if valueClass == RegallocValueClassAddressHome &&
           (!memoryHome || assigned >= 0):
            regallocValueFail(plan,
                             RegallocValuePlanErrorIntervalShape,
                             valueId)
            return false
        if memoryHome && assigned >= 0:
            regallocValueFail(plan,
                             RegallocValuePlanErrorIntervalShape,
                             valueId)
            return false
        if memoryHome && valueClass != RegallocValueClassDead:
            var expectedClass = RegallocValueClassStack
            if regallocValueContains(plan.constraints.gprTypeKinds,
                                     plan.valueTypeKinds[valueId]):
                expectedClass = RegallocValueClassAddressHome
            if valueClass != expectedClass:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorIntervalShape,
                                 valueId)
                return false
        elif !memoryHome && valueClass == RegallocValueClassAddressHome:
            regallocValueFail(plan,
                             RegallocValuePlanErrorIntervalShape,
                             valueId)
            return false
        let useStart = plan.valueUseOffsets[valueId]
        let useEnd = plan.valueUseOffsets[valueId + 1]
        if useStart < 0 || useEnd < useStart || useEnd > useCount:
            regallocValueFail(plan,
                             RegallocValuePlanErrorIntervalShape,
                             valueId)
            return false
        let defPosition = plan.valueDefPositions[valueId]
        var expectedEnd = defPosition
        var previousUse: int32 = -1
        for useIndex in useStart..<useEnd:
            let position = plan.valueUsePositions[useIndex]
            if position < defPosition || position < previousUse ||
               position >= plan.positionCount:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorIntervalShape,
                                 useIndex)
                return false
            let useKind = plan.valueUseKinds[useIndex]
            if useKind != RegallocValueUseFact &&
               useKind != RegallocValueUseMergeEdge:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorIntervalShape,
                                 useIndex)
                return false
            if useKind == RegallocValueUseFact &&
               plan.valueUseFactIndices[useIndex] < 0:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorIntervalShape,
                                 useIndex)
                return false
            if useKind == RegallocValueUseMergeEdge &&
               plan.valueUseFactIndices[useIndex] >= 0:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorIntervalShape,
                                 useIndex)
                return false
            previousUse = position
            expectedEnd = position
        if defPosition < 0:
            if useStart != useEnd || plan.valueEndPositions[valueId] >= 0 ||
               plan.valueAssignedRegs[valueId] >= 0:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorIntervalShape,
                                 valueId)
                return false
            continue
        if expectedEnd < defPosition ||
           plan.valueEndPositions[valueId] != expectedEnd:
            regallocValueFail(plan,
                             RegallocValuePlanErrorIntervalShape,
                             valueId)
            return false
        let reg = plan.valueAssignedRegs[valueId]
        if reg >= 0:
            if useStart == useEnd || !regallocValueIsAllocatable(plan, reg) ||
               plan.valueClasses[valueId] != RegallocValueClassGpr:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorIntervalShape,
                                 valueId)
                return false
    for reg in 0..<63:
        let intervalStart = plan.regIntervalOffsets[reg]
        let intervalEnd = plan.regIntervalOffsets[reg + 1]
        if intervalStart < 0 || intervalEnd < intervalStart ||
           intervalEnd > plan.regIntervalValues.len:
            regallocValueFail(plan,
                             RegallocValuePlanErrorIntervalShape,
                             reg)
            return false
        var previousEnd: int32 = -1
        for intervalIndex in intervalStart..<intervalEnd:
            let valueId = plan.regIntervalValues[intervalIndex]
            if valueId < 0 || valueId >= valueCount ||
               assignedSeen[valueId] ||
               plan.valueAssignedRegs[valueId] != reg ||
               previousEnd >= plan.valueDefPositions[valueId]:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorIntervalShape,
                                 intervalIndex)
                return false
            assignedSeen[valueId] = true
            previousEnd = plan.valueEndPositions[valueId]
    var allocationSeen = regallocValueBoolSeq(valueCount, false)
    var previousStart: int32 = -1
    var previousValue: int32 = -1
    for allocationIndex in 0..<plan.allocationOrder.len:
        let valueId = plan.allocationOrder[allocationIndex]
        if valueId < 0 || valueId >= valueCount ||
           allocationSeen[valueId] || !assignedSeen[valueId]:
            regallocValueFail(plan,
                             RegallocValuePlanErrorIntervalShape,
                             allocationIndex)
            return false
        let start = plan.valueDefPositions[valueId]
        if start < previousStart ||
           (start == previousStart && valueId <= previousValue):
            regallocValueFail(plan,
                             RegallocValuePlanErrorIntervalShape,
                             allocationIndex)
            return false
        allocationSeen[valueId] = true
        previousStart = start
        previousValue = valueId
    for valueId in 0..<valueCount:
        if (plan.valueAssignedRegs[valueId] >= 0) != assignedSeen[valueId] ||
           assignedSeen[valueId] != allocationSeen[valueId]:
            regallocValueFail(plan,
                             RegallocValuePlanErrorIntervalShape,
                             valueId)
            return false
    var previousCall: int32 = -1
    for callIndex in 0..<plan.callPositions.len:
        let position = plan.callPositions[callIndex]
        if position <= previousCall || position < 0 ||
           position >= plan.positionCount:
            regallocValueFail(plan,
                             RegallocValuePlanErrorIntervalShape,
                             callIndex)
            return false
        previousCall = position
    return true

@borrows
fn regallocValueActionKindValid(kind: int32): bool =
    return kind >= RegallocValueActionEntryReload &&
           kind <= RegallocValueActionBindCallWriteHome

@borrows
fn RegallocSinglePassValueActionBindingKind(kind: int32): int32 =
    if kind == RegallocValueActionBindSretResult ||
       kind == RegallocValueActionBindCallWriteHome ||
       kind == RegallocValueActionValueClassification ||
       kind == RegallocValueActionLivenessInterval ||
       kind == RegallocValueActionSretExclusion ||
       kind == RegallocValueActionAddressEscapeHome ||
       kind == RegallocValueActionCalleeSavedSelection ||
       kind == RegallocValueActionDeadValue ||
       kind == RegallocValueActionCoalescedCopy ||
       kind == RegallocValueActionSretForward:
        return RegallocValueBindingStructural
    if regallocValueActionKindValid(kind):
        return RegallocValueBindingMachine
    return 0

@borrows
fn regallocValuePersistentRegisterAction(kind: int32): bool =
    return kind == RegallocValueActionEntryReload ||
           kind == RegallocValueActionBindDef ||
           kind == RegallocValueActionReloadCall ||
           kind == RegallocValueActionBindFixedResult

@borrows
fn regallocValueHomeDefWriteAction(kind: int32): bool =
    return kind == RegallocValueActionStoreDef ||
           kind == RegallocValueActionStoreHome ||
           kind == RegallocValueActionStoreFixedResult ||
           kind == RegallocValueActionBindSretResult ||
           kind == RegallocValueActionBindCallWriteHome

@borrows
fn regallocValueActionSemanticEqual(a: RegallocValueAction,
                                    b: RegallocValueAction): bool =
    return a.consumerOrdinal == b.consumerOrdinal &&
           a.kind == b.kind && a.placement == b.placement &&
           a.position == b.position && a.blockIndex == b.blockIndex &&
           a.opIndex == b.opIndex && a.termIndex == b.termIndex &&
           a.factIndex == b.factIndex && a.valueId == b.valueId &&
           a.otherValueId == b.otherValueId &&
           a.sourceLocation == b.sourceLocation &&
           a.targetLocation == b.targetLocation &&
           a.sourceReg == b.sourceReg && a.targetReg == b.targetReg &&
           a.sourceStackSlot == b.sourceStackSlot &&
           a.targetStackSlot == b.targetStackSlot &&
           a.scratchReg == b.scratchReg &&
           a.targetMemoryHome == b.targetMemoryHome &&
           a.sourceBlock == b.sourceBlock &&
           a.targetBlock == b.targetBlock &&
           a.edgeIndex == b.edgeIndex &&
           a.requiresEdgeSplit == b.requiresEdgeSplit &&
           a.parallelGroup == b.parallelGroup &&
           a.parallelOrdinal == b.parallelOrdinal &&
           a.relatedActionOrdinal == b.relatedActionOrdinal &&
           a.fixedKind == b.fixedKind &&
           a.fixedOrdinal == b.fixedOrdinal &&
           a.passKind == b.passKind &&
           a.encodedValue == b.encodedValue &&
           a.callOrdinal == b.callOrdinal &&
           a.abiSizeBytes == b.abiSizeBytes &&
           a.abiSizeExplicit == b.abiSizeExplicit &&
           a.outgoingStackArgIndex == b.outgoingStackArgIndex &&
           a.outgoingStackByteOffset == b.outgoingStackByteOffset &&
           a.outgoingStackByteWidth == b.outgoingStackByteWidth &&
           a.outgoingStackFrameBytes == b.outgoingStackFrameBytes &&
           a.semanticKind == b.semanticKind &&
           a.semanticStart == b.semanticStart &&
           a.semanticEnd == b.semanticEnd &&
           a.semanticRegister == b.semanticRegister &&
           a.fragmentOrdinal == b.fragmentOrdinal &&
           a.effectSpLoad == b.effectSpLoad &&
           a.effectSpStore == b.effectSpStore &&
           a.effectCall == b.effectCall &&
           a.effectX16 == b.effectX16 &&
           a.effectX17 == b.effectX17

@borrows
fn regallocValueSha256TextValid(value: str): bool =
    if len(value) != 64:
        return false
    for i in 0..<len(value):
        let c = value[i]
        if !((c >= '0' && c <= '9') ||
             (c >= 'a' && c <= 'f')):
            return false
    return true

@borrows
fn regallocValueCanonicalLocalLayoutValid(
        slot: coreir.LocalSlot): bool =
    # The allocator consumes the frozen BodyIR layout columns directly.
    # typeKind may classify a register bank, but it must never repair or
    # replace missing physical layout facts.
    #
    # Aggregate column contract: sizeBytes is the exact type size and
    # alignBytes is the stack-offset alignment (power of two).  The BodyIR
    # producer treats per-type alignment only as a lower bound and may raise
    # alignBytes (e.g. 12-byte/4-aligned aggregates carried at align 8) so
    # 8-byte scaled slot copies encode at 8-aligned frame offsets; the frame
    # allocator aligns each slot offset by alignBytes.  sizeBytes is therefore
    # NOT required to be a multiple of alignBytes — demanding that here would
    # reject exact, producer-frozen layout facts (v6 borrowed-view `var Col`
    # parameter: 12/8).  Scalars stay exact-match; aggregates must carry a
    # real size and a real power-of-two alignment or they are rejected.
    if slot.typeKind == coreir.LocalI32Tag:
        return slot.sizeBytes == 4 && slot.alignBytes == 4
    if slot.typeKind == coreir.LocalI64Tag ||
       slot.typeKind == coreir.LocalPtrTag ||
       slot.typeKind == coreir.LocalF64Tag:
        return slot.sizeBytes == 8 && slot.alignBytes == 8
    if slot.typeKind == coreir.LocalStrTag:
        return slot.sizeBytes == 24 && slot.alignBytes == 8
    if slot.typeKind != coreir.LocalAggregateTag ||
       slot.sizeBytes <= 0 ||
       (slot.alignBytes != 1 &&
        slot.alignBytes != 2 &&
        slot.alignBytes != 4 &&
        slot.alignBytes != 8):
        return false
    # size>0 and alignBytes in {1,2,4,8} hold here: exact, frozen layout.
    return true

fn regallocValueCanonicalLocalLayoutsValid(
        bodyIR: var coreir.BodyIR): bool =
    for slotIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[slotIndex]
        if slot.id != slotIndex ||
           !regallocValueCanonicalLocalLayoutValid(slot):
            return false
    return true

fn regallocValueCanonicalLegacyTargetMetricsEmpty(
        bodyIR: var coreir.BodyIR): bool =
    # Canonical regalloc owns every physical placement.  The exact empty
    # identity mirrors BodyIRClearFrameLayoutCache; any old target-specific
    # frame, peephole, residency, loop-carry, temp-reg, or x64 plan is a
    # second allocator authority and must be rejected at ingress.
    return !bodyIR.frameMetricsReady &&
           bodyIR.frameStackByteCount == 0 &&
           bodyIR.frameParamSaveCount == 0 &&
           bodyIR.frameParamSaveOffset == 0 &&
           bodyIR.frameReturnBufferSaveOffset == 0 &&
           bodyIR.frameBytes == 0 &&
           bodyIR.framePrologueWordCount == 0 &&
           bodyIR.frameRestoreWordCount == 0 &&
           bodyIR.layoutLhsElide.len == 0 &&
           bodyIR.layoutStoreElide.len == 0 &&
           bodyIR.layoutCopySrcElide.len == 0 &&
           bodyIR.layoutCmpFuse.len == 0 &&
           bodyIR.layoutCbrFuse.len == 0 &&
           !bodyIR.x64StackLayoutReady &&
           bodyIR.x64SlotReadCnt.len == 0 &&
           !bodyIR.x64BlockStartReady &&
           bodyIR.x64BlockByteStart.len == 0

fn RegallocSinglePassBodyIrCanonicalIngressConjunctsValid(
        bodyIR: var coreir.BodyIR,
        blocksValidOut: var bool,
        termsValidOut: var bool,
        layoutsValidOut: var bool,
        legacyValidOut: var bool,
        deferReplayValidOut: var bool,
        provenanceValidOut: var bool): bool =
    # Single authority for the six canonical ingress conjuncts.  The
    # production-emitter failure verdict consumes the per-conjunct live
    # values so a rejected shape names its exact rejected conjunct instead
    # of a bare aggregate; the conjunct expressions themselves are never
    # duplicated.
    blocksValidOut = bodyIR.blocks.len > 0
    termsValidOut = bodyIR.terms.len > 0
    layoutsValidOut = regallocValueCanonicalLocalLayoutsValid(bodyIR)
    legacyValidOut = regallocValueCanonicalLegacyTargetMetricsEmpty(bodyIR)
    deferReplayValidOut = coreir.BodyIRDeferReplaySidecarShapeValid(bodyIR)
    provenanceValidOut = coreir.BodyIRDebugProvenanceShapeValid(bodyIR)
    return blocksValidOut &&
           termsValidOut &&
           layoutsValidOut &&
           legacyValidOut &&
           deferReplayValidOut &&
           provenanceValidOut

fn RegallocSinglePassBodyIrCanonicalIngressValid(
        bodyIR: var coreir.BodyIR): bool =
    # The CFG analyzer requires a real entry block. Reject zero-value and
    # term-only placeholders before access decoding or CFG traversal. All
    # use/def/fixed/clobber/address-escape and CFG facts are decoded from this
    # exact BodyIR generation by BuildDecoded. Local layout is likewise a
    # frozen BodyIR fact: no scalar-width inference or aggregate default is
    # permitted after this boundary.
    var blocksValid = false
    var termsValid = false
    var layoutsValid = false
    var legacyValid = false
    var deferReplayValid = false
    var provenanceValid = false
    return RegallocSinglePassBodyIrCanonicalIngressConjunctsValid(
        bodyIR, blocksValid, termsValid, layoutsValid,
        legacyValid, deferReplayValid, provenanceValid)

@borrows
fn RegallocSinglePassBodyIrIngressSha256(
        bodyIR: var coreir.BodyIR): str =
    if !RegallocSinglePassBodyIrCanonicalIngressValid(bodyIR):
        return ""
    var encoded = b2fc.Backend2BodyIrEncode(bodyIR)
    if rawbytes.BytesLen(encoded) <= 0:
        rawbytes.BytesFree(encoded)
        return ""
    let payload = rawbytes.BytesToString(encoded)
    rawbytes.BytesFree(encoded)
    return strings.Sha256(payload)

@borrows
fn RegallocSinglePassDebugProvenanceSha256(
        bodyIR: var coreir.BodyIR): str =
    if !coreir.BodyIRDebugProvenanceShapeValid(bodyIR):
        return ""
    var parts: str[]
    add(parts, "cheng.regalloc.debug_provenance;")
    regallocValueHashAppendBool(
        parts, bodyIR.debugProvenanceRequired)
    var debugFunctionId: int32 = -1
    if bodyIR.debugProvenanceRequired:
        debugFunctionId = bodyIR.debugFunctionId
    regallocValueHashAppendInt32(parts, debugFunctionId)
    regallocValueHashAppendInt32Array(
        parts, bodyIR.debugOpIdsByOpIndex)
    regallocValueHashAppendInt32Array(
        parts, bodyIR.debugSyntheticKindsByOpIndex)
    regallocValueHashAppendInt32Array(
        parts, bodyIR.debugOpIdsByTermIndex)
    regallocValueHashAppendInt32Array(
        parts, bodyIR.debugSyntheticKindsByTermIndex)
    return strings.Sha256(strutil.Join(parts, ""))

@borrows
fn RegallocSinglePassValuePlanMatchesBodyIrIngress(
        bodyIR: var coreir.BodyIR,
        plan: var RegallocSinglePassValuePlan): bool =
    if !plan.valid || !plan.frozen ||
       !regallocValueSha256TextValid(plan.bodyIrIngressSha256) ||
       !regallocValueSha256TextValid(plan.debugProvenanceSha256):
        return false
    return RegallocSinglePassBodyIrIngressSha256(bodyIR) ==
               plan.bodyIrIngressSha256 &&
           RegallocSinglePassDebugProvenanceSha256(bodyIR) ==
               plan.debugProvenanceSha256

@borrows
fn regallocValueHashAppendInt32(parts: var str[], value: int32) =
    let encoded = strings.IntToStr(value)
    add(parts, encoded)
    add(parts, ";")

@borrows
fn regallocValueHashAppendInt64(parts: var str[], value: int64) =
    let encoded = strings.Int64ToStr(value)
    add(parts, encoded)
    add(parts, ";")

@borrows
fn regallocValueHashAppendBool(parts: var str[], value: bool) =
    if value:
        add(parts, "1;")
    else:
        add(parts, "0;")

@borrows
fn regallocValueHashAppendText(parts: var str[], value: str) =
    let encodedLength = strings.IntToStr(len(value))
    add(parts, encodedLength)
    add(parts, ":")
    add(parts, strings.CloneStr(value))
    add(parts, ";")

@borrows
fn regallocValueHashAppendInt32Array(parts: var str[],
                                     values: var int32[]) =
    regallocValueHashAppendInt32(parts, values.len)
    for i in 0..<values.len:
        regallocValueHashAppendInt32(parts, values[i])

@borrows
fn regallocValueHashAppendBoolArray(parts: var str[],
                                    values: var bool[]) =
    regallocValueHashAppendInt32(parts, values.len)
    for i in 0..<values.len:
        regallocValueHashAppendBool(parts, values[i])

@borrows
fn regallocValueAccessTableIngressSha256(
        table: var bodyaccess.BodyIrAccessTable): str =
    var parts: str[]
    add(parts, "cheng.regalloc.access_table_ingress;")
    regallocValueHashAppendInt32(parts, table.facts.len)
    for factIndex in 0..<table.facts.len:
        let fact = table.facts[factIndex]
        regallocValueHashAppendInt32(parts, fact.order)
        regallocValueHashAppendInt32(parts, fact.kind)
        regallocValueHashAppendInt32(parts, fact.siteKind)
        regallocValueHashAppendInt32(parts, fact.siteIndex)
        regallocValueHashAppendInt32(parts, fact.slotIndex)
        regallocValueHashAppendInt32(parts, fact.typeKind)
        regallocValueHashAppendInt32(parts, fact.operandIndex)
        regallocValueHashAppendInt32(parts, fact.valueId)
        regallocValueHashAppendInt32(parts, fact.defOrdinal)
        regallocValueHashAppendInt32(parts, fact.fixedKind)
        regallocValueHashAppendInt32(parts, fact.fixedOrdinal)
        regallocValueHashAppendInt32(parts, fact.clobberKind)
        regallocValueHashAppendInt32(parts, fact.memoryEffect)
        regallocValueHashAppendInt32(parts, fact.passKind)
        regallocValueHashAppendInt32(parts, fact.encodedValue)
        regallocValueHashAppendBool(parts, fact.addressEscapes)
        regallocValueHashAppendInt32(parts, fact.addressOwnerSlot)
        regallocValueHashAppendInt32(parts, fact.addressByteOffset)
        regallocValueHashAppendInt32(parts, fact.addressByteLength)
        regallocValueHashAppendInt32(parts, fact.callOrdinal)
        regallocValueHashAppendInt32(parts, fact.abiSizeBytes)
        regallocValueHashAppendBool(parts, fact.abiSizeExplicit)
        regallocValueHashAppendInt32(parts, fact.outgoingStackArgIndex)
        regallocValueHashAppendInt32(parts, fact.outgoingStackByteOffset)
        regallocValueHashAppendInt32(parts, fact.outgoingStackByteWidth)
        regallocValueHashAppendInt32(parts, fact.outgoingStackFrameBytes)
    regallocValueHashAppendInt32Array(parts, table.opFactStarts)
    regallocValueHashAppendInt32Array(parts, table.opFactCounts)
    regallocValueHashAppendInt32Array(parts, table.termFactStarts)
    regallocValueHashAppendInt32Array(parts, table.termFactCounts)
    regallocValueHashAppendInt32Array(parts, table.callFactStarts)
    regallocValueHashAppendInt32Array(parts, table.callFactCounts)
    regallocValueHashAppendInt32Array(parts, table.callUseCounts)
    regallocValueHashAppendInt32Array(
        parts, table.callResultPassKinds)
    regallocValueHashAppendInt32Array(parts, table.entryValueIdsBySlot)
    regallocValueHashAppendInt32Array(parts, table.defFactIndices)
    regallocValueHashAppendInt32Array(parts, table.useFactIndices)
    regallocValueHashAppendInt32Array(parts, table.valueSlotIndices)
    regallocValueHashAppendInt32Array(parts, table.valueTypeKinds)
    regallocValueHashAppendInt32(parts, table.nextValueId)
    regallocValueHashAppendBool(parts, table.valid)
    regallocValueHashAppendInt32(parts, table.errorCode)
    regallocValueHashAppendInt32(parts, table.errorSiteKind)
    regallocValueHashAppendInt32(parts, table.errorSiteIndex)
    regallocValueHashAppendInt32(parts, table.errorDetail)
    return strings.Sha256(strutil.Join(parts, ""))

