@borrows
fn regallocValueReceiptHash(
        plan: var RegallocSinglePassValuePlan): str =
    var parts: str[]
    add(parts, "regalloc-emission-receipt;")
    regallocValueHashAppendText(parts, plan.debugProvenanceSha256)
    regallocValueHashAppendText(parts, plan.frozenSemanticSha256)
    regallocValueHashAppendText(parts, plan.actionSemanticRootSha256)
    regallocValueHashAppendText(parts, plan.actionBindingRootSha256)
    regallocValueHashAppendText(parts, plan.emissionOwnerSha256)
    regallocValueHashAppendText(parts, plan.emissionSymbolName)
    regallocValueHashAppendInt32(parts, plan.emissionSymbolByteStart)
    regallocValueHashAppendInt32(parts, plan.emissionSymbolByteLength)
