fn regallocValueFreezeSemanticRoots(
        plan: var RegallocSinglePassValuePlan) =
    plan.actionSemanticRootSha256 =
        regallocValueActionSemanticRoot(plan)
    plan.frozenSemanticSha256 = regallocValuePlanSemanticHash(
        plan, plan.actionSemanticRootSha256)
    plan.actionBindingRootSha256 =
        regallocValueActionBindingRoot(plan)

@borrows
fn regallocValueValidateSemanticRoots(
        plan: var RegallocSinglePassValuePlan): bool =
    if !regallocValueSha256TextValid(plan.actionSemanticRootSha256) ||
       !regallocValueSha256TextValid(plan.frozenSemanticSha256) ||
       !regallocValueSha256TextValid(plan.actionBindingRootSha256):
        return false
    if plan.actionSemanticRootSha256 !=
           regallocValueActionSemanticRoot(plan) ||
       plan.frozenSemanticSha256 != regallocValuePlanSemanticHash(
           plan, plan.actionSemanticRootSha256):
        return false
    if plan.emissionSymbolBound:
        if plan.emissionOwnerSha256 != regallocValueEmissionOwnerHash(
               plan.frozenSemanticSha256,
               plan.emissionSymbolName,
               plan.emissionSymbolByteStart,
               plan.emissionSymbolByteLength):
            return false
    elif len(plan.emissionOwnerSha256) != 0:
        return false
    for emissionIndex in 0..<plan.actionEmissions.len:
        let emission = plan.actionEmissions[emissionIndex]
        let expected = regallocValueBindingHash(
            emission.emissionOwnerSha256,
            emission.actionSemanticSha256,
            emission.bindingKind,
            emission.emittedByteStart,
            emission.emittedByteLength,
            emission.emittedBytesSha256)
        if emission.ownerPlanSha256 != plan.frozenSemanticSha256 ||
           emission.emissionOwnerSha256 != plan.emissionOwnerSha256 ||
           emission.actionSemanticSha256 !=
               regallocValueActionSemanticHash(
                   plan.actions[emissionIndex]) ||
           emission.bindingSha256 != expected:
            return false
    if plan.actionBindingRootSha256 !=
       regallocValueActionBindingRoot(plan):
        return false
    if plan.emissionSymbolSealed:
        return plan.sealedReceiptSha256 ==
               regallocValueReceiptHash(plan)
    return len(plan.sealedReceiptSha256) == 0

fn regallocValueAbiSizeValid(sizeBytes: int32): bool =
    return sizeBytes == 1 || sizeBytes == 2 ||
           sizeBytes == 4 || sizeBytes == 8

fn regallocValueAlignBytes(value: int32, alignment: int32): int32 =
    if value < 0 || alignment <= 0:
        return -1
    let remainder = value % alignment
    if remainder == 0:
        return value
    let delta = alignment - remainder
    if value > 2147483647 - delta:
        return -1
    return value + delta

fn regallocValueValidateCallAbiActions(
        plan: var RegallocSinglePassValuePlan): bool =
    if plan.callCount < 0 || plan.callArgCounts.len != plan.callCount ||
       plan.callReachable.len != plan.callCount:
        return false
    var reachableCallCount: int32
    for callOrdinal in 0..<plan.callCount:
        if plan.callReachable[callOrdinal]:
            reachableCallCount = reachableCallCount + 1
    if plan.callPositions.len != reachableCallCount:
        return false
    var callClobberSeen = regallocValueBoolSeq(plan.callCount, false)
    var sretForwardSeen = regallocValueBoolSeq(plan.callCount, false)
    var sretAddressSeen = regallocValueBoolSeq(plan.callCount, false)
    var sretBindSeen = regallocValueBoolSeq(plan.callCount, false)
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.fixedKind == bodyaccess.BodyIrAccessFixedCallArg:
            if action.callOrdinal < 0 ||
               action.callOrdinal >= plan.callCount ||
               !plan.callReachable[action.callOrdinal] ||
               action.fixedOrdinal < 0 ||
               !regallocValueAbiSizeValid(action.abiSizeBytes):
                return false
        elif action.kind == RegallocValueActionAddressFixed &&
             action.fixedKind ==
                 bodyaccess.BodyIrAccessFixedSretResult:
            if action.callOrdinal < 0 ||
               action.callOrdinal >= plan.callCount ||
               !plan.callReachable[action.callOrdinal] ||
               sretAddressSeen[action.callOrdinal] ||
               action.abiSizeBytes != 0 ||
               action.abiSizeExplicit ||
               action.outgoingStackArgIndex >= 0 ||
               action.outgoingStackByteOffset >= 0 ||
               action.outgoingStackByteWidth != 0 ||
               action.outgoingStackFrameBytes != 0:
                return false
            sretAddressSeen[action.callOrdinal] = true
        elif action.kind == RegallocValueActionBindSretResult:
            if action.callOrdinal < 0 ||
               action.callOrdinal >= plan.callCount ||
               !plan.callReachable[action.callOrdinal] ||
               sretBindSeen[action.callOrdinal] ||
               action.fixedKind !=
                   bodyaccess.BodyIrAccessFixedSretResult ||
               action.abiSizeBytes != 0 ||
               action.abiSizeExplicit ||
               action.outgoingStackArgIndex >= 0 ||
               action.outgoingStackByteOffset >= 0 ||
               action.outgoingStackByteWidth != 0 ||
               action.outgoingStackFrameBytes != 0:
                return false
            sretBindSeen[action.callOrdinal] = true
        elif action.kind == RegallocValueActionSretForward:
            if action.callOrdinal < 0 ||
               action.callOrdinal >= plan.callCount ||
               !plan.callReachable[action.callOrdinal] ||
               sretForwardSeen[action.callOrdinal] ||
               action.fixedKind !=
                   bodyaccess.BodyIrAccessFixedSretForward ||
               action.passKind !=
                   coreir.BodyCallPassForwardEntrySretTag ||
               action.semanticRegister !=
                   plan.constraints.fixedSretReg ||
               action.abiSizeBytes != 0 || action.abiSizeExplicit ||
               action.outgoingStackArgIndex >= 0 ||
               action.outgoingStackByteOffset >= 0 ||
               action.outgoingStackByteWidth != 0 ||
               action.outgoingStackFrameBytes != 0:
                return false
            sretForwardSeen[action.callOrdinal] = true
        elif action.kind == RegallocValueActionCallClobber:
            if action.callOrdinal < 0 ||
               action.callOrdinal >= plan.callCount ||
               !plan.callReachable[action.callOrdinal] ||
               callClobberSeen[action.callOrdinal] ||
               action.abiSizeBytes != 0 || action.abiSizeExplicit ||
               action.outgoingStackArgIndex >= 0 ||
               action.outgoingStackByteOffset >= 0 ||
               action.outgoingStackByteWidth != 0 ||
               action.outgoingStackFrameBytes != 0:
                return false
            callClobberSeen[action.callOrdinal] = true
        elif action.callOrdinal >= 0 || action.abiSizeBytes != 0 ||
             action.abiSizeExplicit ||
             action.outgoingStackArgIndex >= 0 ||
             action.outgoingStackByteOffset >= 0 ||
             action.outgoingStackByteWidth != 0 ||
             action.outgoingStackFrameBytes != 0:
            return false
    for callOrdinal in 0..<plan.callCount:
        if callClobberSeen[callOrdinal] !=
               plan.callReachable[callOrdinal] ||
           plan.callArgCounts[callOrdinal] < 0 ||
           sretAddressSeen[callOrdinal] !=
               sretBindSeen[callOrdinal]:
            return false
    var nextArgOrdinal = regallocValueIntSeq(plan.callCount, 0)
    var nextStackArgIndex = regallocValueIntSeq(plan.callCount, 0)
    var nextStackByteOffset = regallocValueIntSeq(plan.callCount, 0)
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.fixedKind != bodyaccess.BodyIrAccessFixedCallArg:
            continue
        let callOrdinal = action.callOrdinal
        if action.fixedOrdinal != nextArgOrdinal[callOrdinal]:
            return false
        nextArgOrdinal[callOrdinal] = nextArgOrdinal[callOrdinal] + 1
        var registerArgCount =
            plan.constraints.fixedArgRegs.len
        if (sretAddressSeen[callOrdinal] ||
            sretForwardSeen[callOrdinal]) &&
           RegallocTargetConstraintsSretShiftsFixedArgs(
               plan.constraints):
            registerArgCount = registerArgCount - 1
        if registerArgCount < 0:
            return false
        if action.fixedOrdinal < registerArgCount:
            if action.outgoingStackArgIndex >= 0 ||
               action.outgoingStackByteOffset >= 0 ||
               action.outgoingStackByteWidth != 0:
                return false
            continue
        let expectedStackIndex =
            action.fixedOrdinal - registerArgCount
        if action.kind != RegallocValueActionStoreStackArg ||
           action.outgoingStackArgIndex != expectedStackIndex ||
           expectedStackIndex != nextStackArgIndex[callOrdinal]:
            return false
        var expectedOffset = expectedStackIndex *
                             plan.constraints.stackArgSlotBytes
        var expectedWidth = plan.constraints.stackArgSlotBytes
        if plan.constraints.packedStackArgs:
            expectedOffset = regallocValueAlignBytes(
                nextStackByteOffset[callOrdinal], action.abiSizeBytes)
            expectedWidth = action.abiSizeBytes
        if expectedOffset < 0 ||
           expectedOffset > 2147483647 - expectedWidth ||
           action.outgoingStackByteOffset != expectedOffset ||
           action.outgoingStackByteWidth != expectedWidth:
            return false
        nextStackArgIndex[callOrdinal] = expectedStackIndex + 1
        nextStackByteOffset[callOrdinal] = expectedOffset + expectedWidth
    var callFrameBytes = regallocValueIntSeq(plan.callCount, 0)
    for callOrdinal in 0..<plan.callCount:
        var expectedArgCount: int32
        if plan.callReachable[callOrdinal]:
            expectedArgCount = plan.callArgCounts[callOrdinal]
        if nextArgOrdinal[callOrdinal] != expectedArgCount:
            return false
        let frameBytes = regallocValueAlignBytes(
            nextStackByteOffset[callOrdinal],
            plan.constraints.stackAlignmentBytes)
        if frameBytes < 0:
            return false
        callFrameBytes[callOrdinal] = frameBytes
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.fixedKind == bodyaccess.BodyIrAccessFixedCallArg &&
           action.outgoingStackFrameBytes !=
               callFrameBytes[action.callOrdinal]:
            return false
    return true

@borrows
fn regallocValueActionBeforeSite(action: RegallocValueAction): bool =
    return (action.placement == RegallocValuePlacementBeforeOp &&
            action.opIndex >= 0 && action.termIndex < 0) ||
           (action.placement == RegallocValuePlacementBeforeTerm &&
            action.termIndex >= 0 && action.opIndex < 0)

@borrows
fn regallocValueActionAfterSite(action: RegallocValueAction): bool =
    return (action.placement == RegallocValuePlacementAfterOp &&
            action.opIndex >= 0 && action.termIndex < 0) ||
           (action.placement == RegallocValuePlacementAfterTerm &&
            action.termIndex >= 0 && action.opIndex < 0)

@borrows
fn regallocValueActionValueValid(plan: var RegallocSinglePassValuePlan,
                                 action: RegallocValueAction): bool =
    return action.valueId >= 0 &&
           action.valueId < plan.valueAssignedRegs.len

@borrows
fn regallocValueStructuralActionSiteValid(
        action: RegallocValueAction): bool =
    return action.placement == RegallocValuePlacementFunctionEntry &&
           action.position == 0 && action.blockIndex < 0 &&
           action.opIndex < 0 && action.termIndex < 0 &&
           action.sourceLocation == RegallocValueLocationNone &&
           action.targetLocation == RegallocValueLocationNone &&
           action.sourceReg < 0 && action.targetReg < 0 &&
           action.sourceStackSlot < 0 && action.targetStackSlot < 0 &&
           action.scratchReg < 0 && action.sourceBlock < 0 &&
           action.targetBlock < 0 && action.edgeIndex < 0 &&
           !action.requiresEdgeSplit && action.parallelGroup < 0 &&
           action.parallelOrdinal < 0 &&
           action.relatedActionOrdinal < 0 &&
           action.fixedOrdinal < 0 && action.passKind < 0 &&
           action.callOrdinal < 0 && action.abiSizeBytes == 0 &&
           !action.abiSizeExplicit &&
           action.outgoingStackArgIndex < 0 &&
           action.outgoingStackByteOffset < 0 &&
           action.outgoingStackByteWidth == 0 &&
           action.outgoingStackFrameBytes == 0

@borrows
fn regallocValueFixedInputActionReg(
        plan: var RegallocSinglePassValuePlan,
        action: RegallocValueAction): int32 =
    if action.fixedKind == bodyaccess.BodyIrAccessFixedCallArg:
        if action.factIndex < 0 ||
           action.factIndex >=
               plan.accessFactRegisters.len:
            return -1
        return plan.accessFactRegisters[action.factIndex]
    if action.fixedKind == bodyaccess.BodyIrAccessFixedReturnValue:
        return plan.constraints.fixedReturnReg
    return -1

@borrows
fn regallocValuePlanHasSretReturn(
        plan: var RegallocSinglePassValuePlan): bool =
    for actionIndex in 0..<plan.actions.len:
        if plan.actions[actionIndex].kind ==
               RegallocValueActionStoreSretReturn ||
           plan.actions[actionIndex].kind ==
               RegallocValueActionSretForward:
            return true
    return false

@borrows
fn regallocValueValidateActionRelation(
        plan: var RegallocSinglePassValuePlan,
        actionIndex: int32): bool =
    let action = plan.actions[actionIndex]
    let restoreTemporary = action.kind ==
                               RegallocValueActionRestoreTemporary
    let reloadCall = action.kind == RegallocValueActionReloadCall
    let scratchRestore = action.kind ==
                             RegallocValueActionParallelScratchRestore
    let coalescedCopy = action.kind ==
                            RegallocValueActionCoalescedCopy
    if !restoreTemporary && !reloadCall && !scratchRestore &&
       !coalescedCopy:
        return action.relatedActionOrdinal < 0
    let related = action.relatedActionOrdinal
    if coalescedCopy:
        if related < 0:
            return true
        if related >= actionIndex:
            return false
        let origin = plan.actions[related]
        return origin.consumerOrdinal == related &&
               origin.kind == RegallocValueActionReloadOperand &&
               origin.valueId == action.otherValueId &&
               origin.blockIndex == action.blockIndex &&
               origin.opIndex == action.opIndex &&
               origin.termIndex == action.termIndex &&
               origin.placement == RegallocValuePlacementBeforeOp &&
               origin.sourceLocation == RegallocValueLocationStack &&
               origin.targetLocation == RegallocValueLocationRegister &&
               origin.targetReg == action.sourceReg
    if related < 0 || related >= actionIndex:
        return false
    let origin = plan.actions[related]
    if origin.valueId != action.valueId ||
       origin.blockIndex != action.blockIndex ||
       origin.opIndex != action.opIndex ||
       origin.termIndex != action.termIndex:
        return false
    if restoreTemporary:
        return origin.kind == RegallocValueActionSpillTemporary &&
               origin.sourceReg == action.targetReg
    if reloadCall:
        return origin.kind == RegallocValueActionSpillCall &&
               origin.sourceReg == action.targetReg
    return origin.kind == RegallocValueActionParallelScratchSave &&
           origin.otherValueId == action.otherValueId &&
           origin.parallelGroup == action.parallelGroup &&
           origin.scratchReg == action.scratchReg &&
           origin.targetReg == action.sourceReg &&
           origin.placement == action.placement &&
           origin.position == action.position &&
           origin.sourceBlock == action.sourceBlock &&
           origin.targetBlock == action.targetBlock &&
           origin.edgeIndex == action.edgeIndex &&
           origin.requiresEdgeSplit == action.requiresEdgeSplit &&
           origin.encodedValue == action.encodedValue

@borrows
fn regallocValueCoalescedCopyProof(
        plan: var RegallocSinglePassValuePlan,
        action: RegallocValueAction): bool =
    let valueCount = plan.valueAssignedRegs.len
    var pureCopyOp: bool
    if action.opIndex >= 0 &&
       action.opIndex < plan.bodyOpKinds.len &&
       action.opIndex < plan.bodyOpOperandCounts.len:
        let opKind = plan.bodyOpKinds[action.opIndex]
        pureCopyOp = plan.bodyOpOperandCounts[action.opIndex] == 1 &&
                     (opKind == coreir.BodyOpCopyLocalTag ||
                      opKind == coreir.BodyOpStoreLocalTag ||
                      opKind == coreir.BodyOpLoadLocalTag)
    if action.opIndex < 0 ||
       action.opIndex >= plan.bodyOpKinds.len ||
       action.opIndex >= plan.bodyOpOperandCounts.len ||
       action.opIndex >= plan.opBeforePositions.len ||
       action.opIndex >= plan.opAfterPositions.len ||
       !pureCopyOp ||
       action.placement != RegallocValuePlacementAfterOp ||
       action.position != plan.opAfterPositions[action.opIndex] ||
       action.blockIndex < 0 ||
       action.blockIndex >= plan.blockEntryPositions.len ||
       action.termIndex != -1 ||
       action.factIndex < 0 ||
       action.factIndex >= plan.accessFactOpIndices.len ||
       action.factIndex >= plan.accessFactBlockIndices.len ||
       action.factIndex >= plan.accessFactTermIndices.len ||
       action.factIndex >= plan.accessFactEdgeIndices.len ||
       plan.accessFactBlockIndices[action.factIndex] !=
           action.blockIndex ||
       plan.accessFactOpIndices[action.factIndex] != action.opIndex ||
       plan.accessFactTermIndices[action.factIndex] != -1 ||
       plan.accessFactEdgeIndices[action.factIndex] != -1 ||
       action.valueId < 0 || action.valueId >= valueCount ||
       action.otherValueId < 0 ||
       action.otherValueId >= valueCount ||
       action.otherValueId == action.valueId ||
       action.valueId >= plan.valueDefPositions.len ||
       action.valueId >= plan.valueDefFactIndices.len ||
       action.valueId >= plan.valueDefBlocks.len ||
       action.valueId >= plan.valueDefIsEntry.len ||
       plan.valueDefPositions[action.valueId] !=
           plan.opAfterPositions[action.opIndex] ||
       plan.valueDefFactIndices[action.valueId] != action.factIndex ||
       plan.valueDefBlocks[action.valueId] != action.blockIndex ||
       plan.valueDefIsEntry[action.valueId] ||
       action.sourceLocation != RegallocValueLocationRegister ||
       action.targetLocation != RegallocValueLocationRegister ||
       action.sourceReg < 0 ||
       action.sourceReg != action.targetReg ||
       action.targetReg != plan.valueAssignedRegs[action.valueId] ||
       !regallocValueIsAllocatable(plan, action.sourceReg) ||
       action.sourceStackSlot != -1 ||
       action.targetStackSlot != -1 ||
       action.scratchReg != -1 || action.targetMemoryHome ||
       action.sourceBlock != -1 || action.targetBlock != -1 ||
       action.edgeIndex != -1 || action.requiresEdgeSplit ||
       action.parallelGroup != -1 ||
       action.parallelOrdinal != -1 ||
       action.fixedKind != bodyaccess.BodyIrAccessFixedNone ||
       action.fixedOrdinal != -1 || action.passKind != -1 ||
       action.encodedValue != 0 || action.callOrdinal != -1 ||
       action.abiSizeBytes != 0 || action.abiSizeExplicit ||
       action.outgoingStackArgIndex != -1 ||
       action.outgoingStackByteOffset != -1 ||
       action.outgoingStackByteWidth != 0 ||
       action.outgoingStackFrameBytes != 0 ||
       action.semanticKind != plan.bodyOpKinds[action.opIndex] ||
       action.semanticStart != -1 || action.semanticEnd != -1 ||
       action.semanticRegister != action.targetReg ||
       plan.valueTypeKinds.len != valueCount ||
       plan.valueClasses.len != valueCount ||
       plan.valueClasses[action.valueId] != RegallocValueClassGpr ||
       !regallocValueContains(
           plan.constraints.gprTypeKinds,
           plan.valueTypeKinds[action.otherValueId]) ||
       !regallocValueContains(
           plan.constraints.gprTypeKinds,
           plan.valueTypeKinds[action.valueId]):
        return false
    let sourceWidth = regallocValueGprWidth(
        plan.valueTypeKinds[action.otherValueId])
    let targetWidth = regallocValueGprWidth(
        plan.valueTypeKinds[action.valueId])
    if sourceWidth <= 0 || targetWidth <= 0 ||
       !regallocValueCopyRepresentationNoop(
           plan.valueTypeKinds[action.otherValueId],
           plan.valueTypeKinds[action.valueId]) ||
       plan.valueUseOffsets.len != valueCount + 1 ||
       plan.valueUseFactIndices.len != plan.valueUseKinds.len:
        return false
    var matchingDefCount: int32
    for candidateValue in 0..<valueCount:
        if candidateValue >= plan.valueDefFactIndices.len:
            return false
        let defFactIndex = plan.valueDefFactIndices[candidateValue]
        if defFactIndex >= 0 &&
           defFactIndex < plan.accessFactOpIndices.len &&
           plan.accessFactOpIndices[defFactIndex] == action.opIndex:
            matchingDefCount = matchingDefCount + 1
            if candidateValue != action.valueId:
                return false
    if matchingDefCount != 1:
        return false
    var matchingUseCount: int32
    var matchingUseValue: int32 = -1
    var matchingUseFact: int32 = -1
    for candidateValue in 0..<valueCount:
        let useStart = plan.valueUseOffsets[candidateValue]
        let useEnd = plan.valueUseOffsets[candidateValue + 1]
        if useStart < 0 || useEnd < useStart ||
           useEnd > plan.valueUseFactIndices.len:
            return false
        for useIndex in useStart..<useEnd:
            if plan.valueUseKinds[useIndex] != RegallocValueUseFact:
                continue
            let useFactIndex = plan.valueUseFactIndices[useIndex]
            if useFactIndex < 0 ||
               useFactIndex >= plan.accessFactOpIndices.len ||
               useFactIndex >= plan.accessFactBlockIndices.len:
                return false
            if plan.accessFactOpIndices[useFactIndex] == action.opIndex:
                if plan.accessFactBlockIndices[useFactIndex] !=
                       action.blockIndex ||
                   useIndex >= plan.valueUsePositions.len ||
                   plan.valueUsePositions[useIndex] !=
                       plan.opBeforePositions[action.opIndex]:
                    return false
                matchingUseCount = matchingUseCount + 1
                matchingUseValue = candidateValue
                matchingUseFact = useFactIndex
    if matchingUseCount != 1 ||
       matchingUseValue != action.otherValueId ||
       matchingUseFact < 0 ||
       matchingUseFact >= plan.operandRegByFact.len ||
       plan.operandRegByFact[matchingUseFact] != action.sourceReg:
        return false
    let sourceAssignedReg =
        plan.valueAssignedRegs[action.otherValueId]
    if sourceAssignedReg == action.sourceReg:
        return plan.valueClasses[action.otherValueId] ==
                   RegallocValueClassGpr &&
               action.relatedActionOrdinal == -1
    if sourceAssignedReg >= 0 ||
       plan.valueClasses[action.otherValueId] !=
           RegallocValueClassAddressHome ||
       action.relatedActionOrdinal < 0 ||
       action.relatedActionOrdinal >= action.consumerOrdinal ||
       action.relatedActionOrdinal >= plan.actions.len:
        return false
    let origin = plan.actions[action.relatedActionOrdinal]
    return origin.consumerOrdinal == action.relatedActionOrdinal &&
           origin.kind == RegallocValueActionReloadOperand &&
           origin.valueId == action.otherValueId &&
           origin.factIndex == matchingUseFact &&
           origin.placement == RegallocValuePlacementBeforeOp &&
           origin.position == plan.opBeforePositions[action.opIndex] &&
           origin.blockIndex == action.blockIndex &&
           origin.opIndex == action.opIndex &&
           origin.termIndex == action.termIndex &&
           origin.sourceLocation == RegallocValueLocationStack &&
           origin.targetLocation == RegallocValueLocationRegister &&
           origin.targetReg == action.sourceReg

fn regallocValueExpectedStackSlot(
        plan: var RegallocSinglePassValuePlan,
        valueId: int32,
        location: int32): int32 =
    if location != RegallocValueLocationStack:
        return -1
    if valueId < 0 || valueId >= plan.valueSlotIndices.len:
        return -2
    return plan.valueSlotIndices[valueId]

fn regallocValueValidateActionProof(
        plan: var RegallocSinglePassValuePlan): bool =
    if plan.nextIssueOrdinal < 0 ||
       plan.nextIssueOrdinal > plan.actions.len ||
       plan.nextAckOrdinal < 0 ||
       plan.nextAckOrdinal > plan.actions.len ||
       plan.nextAckOrdinal > plan.nextIssueOrdinal ||
       plan.nextIssueOrdinal - plan.nextAckOrdinal > 1 ||
       plan.actionIssued.len != plan.actions.len ||
       plan.actionEmissions.len != plan.nextAckOrdinal ||
       plan.functionEntryActionCount < 0 ||
       (plan.functionEntryActionCount == 0 &&
        plan.functionEntryActionStart >= 0) ||
       (plan.functionEntryActionCount > 0 &&
        plan.functionEntryActionStart < 0) ||
       (plan.emissionSymbolSealed && !plan.emissionSymbolBound) ||
       (plan.finalized && !plan.emissionSymbolSealed) ||
       (plan.finalized && plan.nextAckOrdinal != plan.actions.len) ||
       plan.bodyOpKinds.len != plan.opBeforePositions.len ||
       plan.bodyOpKinds.len != plan.opAfterPositions.len ||
       plan.bodyOpKinds.len != plan.bodyOpOperandCounts.len:
        regallocValueFail(plan,
                         RegallocValuePlanErrorActionShape,
                         plan.nextAckOrdinal)
        return false
    if !regallocValueValidateCallAbiActions(plan):
        regallocValueFail(plan,
                         RegallocValuePlanErrorActionShape,
                         plan.nextAckOrdinal)
        return false
    let functionReturnsSret =
        regallocValuePlanHasSretReturn(plan)
    var fixedArgShift: int32
    if functionReturnsSret &&
       RegallocTargetConstraintsSretShiftsFixedArgs(
           plan.constraints):
        fixedArgShift = 1
    let entryRegisterArgCount =
        plan.constraints.fixedArgRegs.len - fixedArgShift
    if entryRegisterArgCount < 0:
        regallocValueFail(
            plan, RegallocValuePlanErrorActionShape,
            entryRegisterArgCount)
        return false
    var previousPosition: int32 = -1
    var maxParallelGroup: int32 = -1
    var functionEntrySeen: int32
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.consumerOrdinal != actionIndex ||
           plan.actionIssued[actionIndex] !=
               (actionIndex < plan.nextIssueOrdinal) ||
           action.acknowledged != (actionIndex < plan.nextAckOrdinal) ||
           !regallocValueActionKindValid(action.kind) ||
           action.position < previousPosition || action.position < 0 ||
           action.position >= plan.positionCount ||
           !regallocValueValidateActionRelation(plan, actionIndex):
            regallocValueFail(plan,
                             RegallocValuePlanErrorActionShape,
                             actionIndex)
            return false
        if action.placement == RegallocValuePlacementFunctionEntry:
            if actionIndex != plan.functionEntryActionStart +
               functionEntrySeen:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
            functionEntrySeen = functionEntrySeen + 1
        if action.sourceReg >= 0 &&
           !regallocValueKnownRegister(plan.constraints, action.sourceReg):
            regallocValueFail(plan,
                             RegallocValuePlanErrorActionShape,
                             actionIndex)
            return false
        if action.targetReg >= 0 &&
           !regallocValueKnownRegister(plan.constraints, action.targetReg):
            regallocValueFail(plan,
                             RegallocValuePlanErrorActionShape,
                             actionIndex)
            return false
        if action.sourceLocation == RegallocValueLocationRegister &&
           action.sourceReg < 0:
            regallocValueFail(plan,
                             RegallocValuePlanErrorActionShape,
                             actionIndex)
            return false
        if action.targetLocation == RegallocValueLocationRegister &&
           action.targetReg < 0:
            regallocValueFail(plan,
                             RegallocValuePlanErrorActionShape,
                             actionIndex)
            return false
        if action.parallelGroup > maxParallelGroup:
            maxParallelGroup = action.parallelGroup
        previousPosition = action.position
    if functionEntrySeen != plan.functionEntryActionCount:
        regallocValueFail(plan,
                         RegallocValuePlanErrorActionShape,
                         functionEntrySeen)
        return false
    if plan.nextAckOrdinal > 0 && !plan.emissionSymbolBound:
        regallocValueFail(plan,
                         RegallocValuePlanErrorEmissionShape,
                         plan.nextAckOrdinal)
        return false
    if plan.emissionSymbolBound &&
       (len(plan.emissionSymbolName) <= 0 ||
        plan.emissionSymbolByteStart < 0 ||
        plan.emissionSymbolByteLength <= 0 ||
        plan.emissionSymbolByteStart >
            2147483647 - plan.emissionSymbolByteLength ||
        (plan.emissionSymbolSealed &&
         !regallocValueSha256TextValid(
             plan.emissionSymbolBytesSha256)) ||
        (!plan.emissionSymbolSealed &&
         len(plan.emissionSymbolBytesSha256) != 0)):
        regallocValueFail(plan,
                         RegallocValuePlanErrorEmissionShape,
                         plan.emissionSymbolByteStart)
        return false
    var previousMachineEmissionEnd = plan.emissionSymbolByteStart
    for emissionIndex in 0..<plan.actionEmissions.len:
        let emission = plan.actionEmissions[emissionIndex]
        let action = plan.actions[emissionIndex]
        let bindingKind =
            RegallocSinglePassValueActionBindingKind(action.kind)
        if emission.consumerOrdinal != emissionIndex ||
           emission.actionKind != action.kind ||
           emission.actionPosition != action.position ||
           emission.symbolByteStart != plan.emissionSymbolByteStart ||
           emission.symbolByteLength != plan.emissionSymbolByteLength ||
           emission.bindingKind != bindingKind ||
           emission.ownerPlanSha256 != plan.frozenSemanticSha256 ||
           emission.emissionOwnerSha256 !=
               plan.emissionOwnerSha256 ||
           emission.actionSemanticSha256 !=
               regallocValueActionSemanticHash(action) ||
           !regallocValueSha256TextValid(emission.bindingSha256):
            regallocValueFail(plan,
                             RegallocValuePlanErrorEmissionShape,
                             emissionIndex)
            return false
        if bindingKind == RegallocValueBindingStructural:
            if emission.emittedByteStart != 0 ||
               emission.emittedByteLength != 0 ||
               emission.emittedBytesSha256 !=
                   RegallocValueEmptySha256:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorEmissionShape,
                                 emissionIndex)
                return false
        elif bindingKind == RegallocValueBindingMachine:
            if emission.emittedByteStart <
                   plan.emissionSymbolByteStart ||
               emission.emittedByteStart <
                   previousMachineEmissionEnd ||
               emission.emittedByteStart % 4 != 0 ||
               emission.emittedByteLength <= 0 ||
               emission.emittedByteLength % 4 != 0 ||
               emission.emittedByteStart >
                   2147483647 - emission.emittedByteLength ||
               emission.emittedByteStart +
                   emission.emittedByteLength >
                   plan.emissionSymbolByteStart +
                   plan.emissionSymbolByteLength ||
               !regallocValueSha256TextValid(
                   emission.emittedBytesSha256):
                regallocValueFail(plan,
                                 RegallocValuePlanErrorEmissionShape,
                                 emissionIndex)
                return false
            previousMachineEmissionEnd = emission.emittedByteStart +
                                         emission.emittedByteLength
        else:
            regallocValueFail(plan,
                             RegallocValuePlanErrorEmissionShape,
                             emissionIndex)
            return false
    if plan.lastMachineEmissionEnd != previousMachineEmissionEnd:
        regallocValueFail(plan,
                         RegallocValuePlanErrorEmissionShape,
                         plan.lastMachineEmissionEnd)
        return false
    var groupLast = regallocValueIntSeq(maxParallelGroup + 1, -1)
    var groupNext = regallocValueIntSeq(maxParallelGroup + 1, 0)
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.parallelGroup < 0:
            if action.parallelOrdinal >= 0:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
            continue
        let group = action.parallelGroup
        if action.parallelOrdinal != groupNext[group] ||
           (groupLast[group] >= 0 && groupLast[group] != actionIndex - 1):
            regallocValueFail(plan,
                             RegallocValuePlanErrorActionShape,
                             actionIndex)
            return false
        groupLast[group] = actionIndex
        groupNext[group] = groupNext[group] + 1
    var classificationCounts = regallocValueIntSeq(
        plan.valueClasses.len, 0)
    var intervalCounts = regallocValueIntSeq(plan.valueClasses.len, 0)
    var addressHomeCounts = regallocValueIntSeq(
        plan.valueClasses.len, 0)
    var sretExclusionCounts = regallocValueIntSeq(
        plan.valueClasses.len, 0)
    var deadValueCounts = regallocValueIntSeq(plan.valueClasses.len, 0)
    var calleeSelectionSeen = regallocValueBoolSeq(63, false)
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        let valueValid = regallocValueActionValueValid(plan, action)
        if valueValid && plan.valueMemoryHomes[action.valueId] &&
           regallocValuePersistentRegisterAction(action.kind):
            regallocValueFail(plan,
                             RegallocValuePlanErrorActionShape,
                             actionIndex)
            return false
        if action.kind == RegallocValueActionEntryReload:
            if !valueValid ||
               action.placement != RegallocValuePlacementFunctionEntry ||
               action.blockIndex >= 0 ||
               action.targetLocation != RegallocValueLocationRegister ||
               action.targetReg != plan.valueAssignedRegs[action.valueId] ||
               action.fixedOrdinal < 0 ||
               (action.sourceLocation == RegallocValueLocationRegister &&
                (action.fixedOrdinal >= entryRegisterArgCount ||
                 action.sourceReg !=
                     plan.constraints.fixedArgRegs[
                         action.fixedOrdinal + fixedArgShift] ||
                 action.semanticRegister != action.sourceReg)) ||
               (action.sourceLocation == RegallocValueLocationStack &&
                (action.fixedOrdinal < entryRegisterArgCount ||
                 action.sourceReg >= 0 ||
                 action.semanticRegister >= 0)) ||
               (action.sourceLocation != RegallocValueLocationRegister &&
                action.sourceLocation != RegallocValueLocationStack):
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionReloadOperand:
            if !valueValid || !regallocValueActionBeforeSite(action) ||
               action.sourceLocation != RegallocValueLocationStack ||
               action.targetLocation != RegallocValueLocationRegister ||
               !regallocValueIsAllocatable(plan, action.targetReg) ||
               (plan.valueMemoryHomes[action.valueId] &&
                plan.valueClasses[action.valueId] !=
                    RegallocValueClassAddressHome):
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionSpillTemporary:
            if !valueValid || !regallocValueActionBeforeSite(action) ||
               action.sourceLocation != RegallocValueLocationRegister ||
               action.targetLocation != RegallocValueLocationStack ||
               action.sourceReg != plan.valueAssignedRegs[action.valueId]:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionRestoreTemporary:
            if !valueValid || !regallocValueActionAfterSite(action) ||
               action.sourceLocation != RegallocValueLocationStack ||
               action.targetLocation != RegallocValueLocationRegister ||
               action.targetReg != plan.valueAssignedRegs[action.valueId]:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionBindDef:
            if !valueValid || !regallocValueActionAfterSite(action) ||
               action.targetLocation != RegallocValueLocationRegister ||
               action.targetReg != plan.valueAssignedRegs[action.valueId]:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionCoalescedCopy:
            if !regallocValueCoalescedCopyProof(plan, action):
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionStoreDef:
            if !valueValid || !regallocValueActionAfterSite(action) ||
               action.targetLocation != RegallocValueLocationStack ||
               plan.valueAssignedRegs[action.valueId] >= 0 ||
               plan.valueMemoryHomes[action.valueId] ||
               action.targetMemoryHome:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionStoreHome:
            if !valueValid || !regallocValueActionAfterSite(action) ||
               action.sourceLocation != RegallocValueLocationNone ||
               action.targetLocation != RegallocValueLocationStack ||
               action.sourceReg >= 0 || action.sourceStackSlot >= 0 ||
               plan.valueAssignedRegs[action.valueId] >= 0 ||
               !plan.valueMemoryHomes[action.valueId] ||
               !action.targetMemoryHome:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionSpillCall:
            if !valueValid ||
               action.placement != RegallocValuePlacementBeforeOp ||
               action.opIndex < 0 ||
               action.sourceLocation != RegallocValueLocationRegister ||
               action.targetLocation != RegallocValueLocationStack ||
               action.sourceReg != plan.valueAssignedRegs[action.valueId] ||
               !regallocValueContains(plan.constraints.callClobberRegs,
                                      action.sourceReg) ||
               plan.valueEndPositions[action.valueId] <= action.position:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionReloadCall:
            if !valueValid ||
               action.placement != RegallocValuePlacementAfterOp ||
               action.opIndex < 0 ||
               action.sourceLocation != RegallocValueLocationStack ||
               action.targetLocation != RegallocValueLocationRegister ||
               action.targetReg != plan.valueAssignedRegs[action.valueId]:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionEdgeParallelCopy:
            if !valueValid || action.otherValueId < 0 ||
               action.otherValueId >= plan.valueAssignedRegs.len ||
               (action.placement != RegallocValuePlacementEdge &&
                action.placement != RegallocValuePlacementBlockEntry &&
                action.placement != RegallocValuePlacementFunctionEntry) ||
               action.sourceLocation !=
                   regallocValueLocationFor(plan, action.valueId) ||
               action.targetLocation !=
                   regallocValueLocationFor(plan, action.otherValueId) ||
               action.sourceReg !=
                   plan.valueAssignedRegs[action.valueId] ||
               action.targetReg !=
                   plan.valueAssignedRegs[action.otherValueId] ||
               action.sourceStackSlot !=
                   regallocValueExpectedStackSlot(
                       plan, action.valueId, action.sourceLocation) ||
               action.targetStackSlot !=
                   regallocValueExpectedStackSlot(
                       plan, action.otherValueId,
                       action.targetLocation) ||
               action.targetMemoryHome !=
                   plan.valueMemoryHomes[action.otherValueId] ||
               action.scratchReg >= 0 ||
               !regallocValueParallelCopyPhysicalValid(
                   plan, action.sourceLocation,
                   action.sourceReg, action.sourceStackSlot) ||
               !regallocValueParallelCopyPhysicalValid(
                   plan, action.targetLocation,
                   action.targetReg, action.targetStackSlot) ||
               regallocValueParallelCopyPhysicalEqual(
                   action.sourceLocation, action.sourceReg,
                   action.sourceStackSlot,
                   action.targetLocation, action.targetReg,
                   action.targetStackSlot) ||
               (action.sourceLocation == RegallocValueLocationStack &&
                action.targetLocation == RegallocValueLocationStack):
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionParallelScratchSave:
            if !valueValid || action.otherValueId < 0 ||
               action.otherValueId >= plan.valueAssignedRegs.len ||
               (action.placement != RegallocValuePlacementEdge &&
                action.placement != RegallocValuePlacementBlockEntry &&
                action.placement != RegallocValuePlacementFunctionEntry) ||
               action.scratchReg !=
                   plan.constraints.parallelCopyScratchReg ||
               action.targetLocation != RegallocValueLocationRegister ||
               action.targetReg != action.scratchReg ||
               action.targetStackSlot >= 0 ||
               action.targetMemoryHome ||
               action.sourceLocation !=
                   regallocValueLocationFor(plan, action.valueId) ||
               action.sourceReg !=
                   plan.valueAssignedRegs[action.valueId] ||
               action.sourceStackSlot !=
                   regallocValueExpectedStackSlot(
                       plan, action.valueId, action.sourceLocation) ||
               !regallocValueParallelCopyPhysicalValid(
                   plan, action.sourceLocation,
                   action.sourceReg, action.sourceStackSlot):
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionParallelScratchRestore:
            if !valueValid || action.otherValueId < 0 ||
               action.otherValueId >= plan.valueAssignedRegs.len ||
               (action.placement != RegallocValuePlacementEdge &&
                action.placement != RegallocValuePlacementBlockEntry &&
                action.placement != RegallocValuePlacementFunctionEntry) ||
               action.scratchReg !=
                   plan.constraints.parallelCopyScratchReg ||
               action.sourceLocation != RegallocValueLocationRegister ||
               action.sourceReg != action.scratchReg ||
               action.sourceStackSlot >= 0 ||
               action.targetLocation !=
                   regallocValueLocationFor(plan, action.otherValueId) ||
               action.targetReg !=
                   plan.valueAssignedRegs[action.otherValueId] ||
               action.targetStackSlot !=
                   regallocValueExpectedStackSlot(
                       plan, action.otherValueId,
                       action.targetLocation) ||
               action.targetMemoryHome !=
                   plan.valueMemoryHomes[action.otherValueId] ||
               !regallocValueParallelCopyPhysicalValid(
                   plan, action.targetLocation,
                   action.targetReg, action.targetStackSlot):
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionBindSretResult:
            if !valueValid || !regallocValueActionAfterSite(action) ||
               action.sourceLocation != RegallocValueLocationStack ||
               action.targetLocation != RegallocValueLocationStack ||
               action.sourceReg != plan.constraints.fixedSretReg ||
               action.fixedKind != bodyaccess.BodyIrAccessFixedSretResult ||
               !action.targetMemoryHome ||
               !plan.valueMemoryHomes[action.valueId]:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionBindCallWriteHome:
            if !valueValid || !regallocValueActionAfterSite(action) ||
               action.sourceLocation != RegallocValueLocationStack ||
               action.targetLocation != RegallocValueLocationStack ||
               action.sourceReg >= 0 ||
               action.fixedKind != bodyaccess.BodyIrAccessFixedCallWriteHome ||
               !action.targetMemoryHome ||
               !plan.valueMemoryHomes[action.valueId]:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionStoreSretReturn:
            if !valueValid || !regallocValueActionBeforeSite(action) ||
               action.sourceLocation != RegallocValueLocationStack ||
               action.targetLocation != RegallocValueLocationAddress ||
               action.targetReg != plan.constraints.fixedSretReg ||
               action.fixedKind != bodyaccess.BodyIrAccessFixedReturnValue:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionStoreStackArg:
            if !regallocValueActionBeforeSite(action) ||
               action.targetLocation != RegallocValueLocationStack ||
               action.fixedKind != bodyaccess.BodyIrAccessFixedCallArg ||
               regallocValueFixedInputActionReg(
                   plan, action) >= 0:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionMoveFixed:
            if !valueValid || !regallocValueActionBeforeSite(action) ||
               action.sourceLocation != RegallocValueLocationRegister ||
               action.targetLocation != RegallocValueLocationRegister ||
               action.sourceReg != plan.valueAssignedRegs[action.valueId] ||
               action.targetReg !=
                   regallocValueFixedInputActionReg(plan, action):
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionLoadFixed:
            if !regallocValueActionBeforeSite(action) ||
               (action.sourceLocation != RegallocValueLocationStack &&
                action.sourceLocation != RegallocValueLocationConstant) ||
               action.targetLocation != RegallocValueLocationRegister ||
               action.targetReg !=
                   regallocValueFixedInputActionReg(plan, action) ||
               (valueValid && plan.valueAssignedRegs[action.valueId] >= 0) ||
               (valueValid && plan.valueMemoryHomes[action.valueId] &&
                action.sourceLocation != RegallocValueLocationStack):
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionAddressFixed:
            var expectedReg = regallocValueFixedInputActionReg(plan, action)
            if action.fixedKind == bodyaccess.BodyIrAccessFixedSretResult:
                expectedReg = plan.constraints.fixedSretReg
            if !regallocValueActionBeforeSite(action) ||
               action.sourceLocation != RegallocValueLocationAddress ||
               action.targetLocation != RegallocValueLocationRegister ||
               action.targetReg != expectedReg:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionBindFixedResult:
            if !valueValid || !regallocValueActionAfterSite(action) ||
               action.sourceLocation != RegallocValueLocationRegister ||
               action.targetLocation != RegallocValueLocationRegister ||
               action.sourceReg != plan.constraints.fixedResultReg ||
               action.fixedKind != bodyaccess.BodyIrAccessFixedCallResult ||
               action.targetReg != plan.valueAssignedRegs[action.valueId]:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionStoreFixedResult:
            if !valueValid || !regallocValueActionAfterSite(action) ||
               action.sourceLocation != RegallocValueLocationRegister ||
               action.targetLocation != RegallocValueLocationStack ||
               action.sourceReg != plan.constraints.fixedResultReg ||
               action.fixedKind != bodyaccess.BodyIrAccessFixedCallResult ||
               plan.valueAssignedRegs[action.valueId] >= 0 ||
               action.targetMemoryHome !=
                   plan.valueMemoryHomes[action.valueId]:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionCallClobber:
            if !regallocValueActionBeforeSite(action) ||
               action.opIndex < 0 || action.termIndex >= 0 ||
               action.factIndex < 0 ||
               action.callOrdinal < 0 ||
               action.callOrdinal >= plan.callCount ||
               action.encodedValue !=
                   bodyaccess.BodyIrAccessClobberCallAbi ||
               action.valueId >= 0 || action.otherValueId >= 0 ||
               action.sourceLocation != RegallocValueLocationNone ||
               action.targetLocation != RegallocValueLocationNone ||
               action.fixedKind != bodyaccess.BodyIrAccessFixedNone:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionSretForward:
            if valueValid || action.valueId != -1 ||
               action.placement != RegallocValuePlacementBeforeOp ||
               action.opIndex < 0 ||
               action.opIndex >= plan.bodyOpKinds.len ||
               action.opIndex >= plan.opBeforePositions.len ||
               plan.bodyOpKinds[action.opIndex] !=
                   coreir.BodyOpCallTag ||
               action.position !=
                   plan.opBeforePositions[action.opIndex] ||
               action.blockIndex < 0 ||
               action.blockIndex >= plan.blockEntryPositions.len ||
               action.termIndex != -1 || action.factIndex < 0 ||
               action.factIndex >= plan.accessFactRegisters.len ||
               action.factIndex >=
                   plan.accessFactIsAllocatorClobber.len ||
               action.factIndex >= plan.accessFactBlockIndices.len ||
               action.factIndex >= plan.accessFactOpIndices.len ||
               action.factIndex >= plan.accessFactTermIndices.len ||
               action.factIndex >= plan.accessFactEdgeIndices.len ||
               plan.accessFactRegisters[action.factIndex] !=
                   plan.constraints.fixedSretReg ||
               plan.accessFactIsAllocatorClobber[action.factIndex] ||
               plan.accessFactBlockIndices[action.factIndex] !=
                   action.blockIndex ||
               plan.accessFactOpIndices[action.factIndex] !=
                   action.opIndex ||
               plan.accessFactTermIndices[action.factIndex] != -1 ||
               plan.accessFactEdgeIndices[action.factIndex] != -1 ||
               action.otherValueId != -1 ||
               action.sourceLocation != RegallocValueLocationNone ||
               action.targetLocation != RegallocValueLocationNone ||
               action.sourceReg != -1 || action.targetReg != -1 ||
               action.sourceStackSlot != -1 ||
               action.targetStackSlot != -1 || action.scratchReg != -1 ||
               action.targetMemoryHome || action.sourceBlock != -1 ||
               action.targetBlock != -1 || action.edgeIndex != -1 ||
               action.requiresEdgeSplit || action.parallelGroup != -1 ||
               action.parallelOrdinal != -1 ||
               action.relatedActionOrdinal != -1 ||
               action.fixedKind !=
                   bodyaccess.BodyIrAccessFixedSretForward ||
               action.fixedOrdinal != -1 ||
               action.passKind !=
                   coreir.BodyCallPassForwardEntrySretTag ||
               action.encodedValue != 0 ||
               action.callOrdinal < 0 ||
               action.callOrdinal >= plan.callCount ||
               action.abiSizeBytes != 0 || action.abiSizeExplicit ||
               action.outgoingStackArgIndex != -1 ||
               action.outgoingStackByteOffset != -1 ||
               action.outgoingStackByteWidth != 0 ||
               action.outgoingStackFrameBytes != 0 ||
               action.semanticKind != coreir.BodyOpCallTag ||
               action.semanticStart != -1 || action.semanticEnd != -1 ||
               action.semanticRegister !=
                   plan.constraints.fixedSretReg:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
        elif action.kind == RegallocValueActionValueClassification:
            if !valueValid ||
               !regallocValueStructuralActionSiteValid(action) ||
               action.fixedKind != bodyaccess.BodyIrAccessFixedNone ||
               action.semanticKind != plan.valueClasses[action.valueId] ||
               action.semanticStart >= 0 || action.semanticEnd >= 0 ||
               action.semanticRegister >= 0 || action.targetMemoryHome:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
            classificationCounts[action.valueId] =
                classificationCounts[action.valueId] + 1
        elif action.kind == RegallocValueActionLivenessInterval:
            if !valueValid ||
               !regallocValueStructuralActionSiteValid(action) ||
               action.fixedKind != bodyaccess.BodyIrAccessFixedNone ||
               plan.valueDefPositions[action.valueId] < 0 ||
               action.semanticStart !=
                   plan.valueDefPositions[action.valueId] ||
               action.semanticEnd !=
                   plan.valueEndPositions[action.valueId] ||
               action.semanticKind != 0 ||
               action.semanticRegister >= 0 || action.targetMemoryHome:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
            intervalCounts[action.valueId] =
                intervalCounts[action.valueId] + 1
        elif action.kind == RegallocValueActionSretExclusion:
            if !valueValid ||
               !regallocValueStructuralActionSiteValid(action) ||
               action.fixedKind != bodyaccess.BodyIrAccessFixedSretResult ||
               action.semanticRegister !=
                   plan.constraints.fixedSretReg ||
               action.semanticKind != 0 ||
               action.semanticStart >= 0 || action.semanticEnd >= 0 ||
               action.targetMemoryHome:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
            sretExclusionCounts[action.valueId] =
                sretExclusionCounts[action.valueId] + 1
        elif action.kind == RegallocValueActionAddressEscapeHome:
            if !valueValid ||
               !regallocValueStructuralActionSiteValid(action) ||
               action.fixedKind != bodyaccess.BodyIrAccessFixedNone ||
               !plan.valueMemoryHomes[action.valueId] ||
               !action.targetMemoryHome || action.semanticKind != 0 ||
               action.semanticStart >= 0 || action.semanticEnd >= 0 ||
               action.semanticRegister >= 0:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
            addressHomeCounts[action.valueId] =
                addressHomeCounts[action.valueId] + 1
        elif action.kind == RegallocValueActionCalleeSavedSelection:
            let reg = action.semanticRegister
            if valueValid ||
               !regallocValueStructuralActionSiteValid(action) ||
               action.factIndex >= 0 ||
               action.fixedKind != bodyaccess.BodyIrAccessFixedNone ||
               reg < 0 || reg >= 63 || calleeSelectionSeen[reg] ||
               !regallocValueContains(
                   plan.constraints.allocatableCalleeRegs, reg) ||
               (plan.usedCalleeMask & (int64(1) << reg)) == 0 ||
               action.semanticKind != 0 ||
               action.semanticStart >= 0 || action.semanticEnd >= 0 ||
               action.targetMemoryHome:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
            calleeSelectionSeen[reg] = true
        elif action.kind == RegallocValueActionDeadValue:
            if !valueValid ||
               !regallocValueStructuralActionSiteValid(action) ||
               action.fixedKind != bodyaccess.BodyIrAccessFixedNone ||
               plan.valueUseOffsets[action.valueId + 1] !=
                   plan.valueUseOffsets[action.valueId] ||
               plan.valueMemoryHomes[action.valueId] ||
               action.semanticKind != 0 ||
               action.semanticStart >= 0 || action.semanticEnd >= 0 ||
               action.semanticRegister >= 0 || action.targetMemoryHome:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorActionShape,
                                 actionIndex)
                return false
            deadValueCounts[action.valueId] =
                deadValueCounts[action.valueId] + 1
        else:
            regallocValueFail(plan,
                             RegallocValuePlanErrorActionShape,
                             actionIndex)
            return false
    var sretBindCounts = regallocValueIntSeq(plan.valueClasses.len, 0)
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.kind == RegallocValueActionBindSretResult:
            sretBindCounts[action.valueId] =
                sretBindCounts[action.valueId] + 1
    for valueId in 0..<plan.valueClasses.len:
        let expectedInterval =
            (plan.valueDefPositions[valueId] >= 0 ? 1 : 0)
        let expectedHome = (plan.valueMemoryHomes[valueId] ? 1 : 0)
        let expectedDead =
            (plan.valueUseOffsets[valueId + 1] ==
                 plan.valueUseOffsets[valueId] &&
             !plan.valueMemoryHomes[valueId] ? 1 : 0)
        if classificationCounts[valueId] != 1 ||
           intervalCounts[valueId] != expectedInterval ||
           addressHomeCounts[valueId] != expectedHome ||
           sretExclusionCounts[valueId] != sretBindCounts[valueId] ||
           deadValueCounts[valueId] != expectedDead:
            regallocValueFail(plan,
                             RegallocValuePlanErrorActionShape,
                             valueId)
            return false
    for reg in 0..<63:
        let expected =
            (plan.usedCalleeMask & (int64(1) << reg)) != 0
        if calleeSelectionSeen[reg] != expected:
            regallocValueFail(plan,
                             RegallocValuePlanErrorActionShape,
                             reg)
            return false
    var homeDefWriteCounts = regallocValueIntSeq(
        plan.valueDefPositions.len, 0)
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.valueId < 0 ||
           action.valueId >= plan.valueDefPositions.len ||
           !regallocValueHomeDefWriteAction(action.kind) ||
           !action.targetMemoryHome:
            continue
        if action.factIndex != plan.valueDefFactIndices[action.valueId]:
            regallocValueFail(plan,
                             RegallocValuePlanErrorActionShape,
                             actionIndex)
            return false
        homeDefWriteCounts[action.valueId] =
            homeDefWriteCounts[action.valueId] + 1
    for valueId in 0..<plan.valueDefPositions.len:
        if plan.valueMemoryHomes[valueId] &&
           plan.valueDefPositions[valueId] >= 0 &&
           plan.valueDefFactIndices[valueId] >= 0 &&
           !plan.valueDefIsEntry[valueId] &&
           homeDefWriteCounts[valueId] != 1:
            regallocValueFail(plan,
                             RegallocValuePlanErrorActionShape,
                             valueId)
            return false
    return true

@borrows
fn regallocValueParallelCopySourceOverwritten(
        registerWritten: var bool[],
        stackWritten: var bool[],
        action: RegallocValueAction): bool =
    if action.sourceLocation == RegallocValueLocationRegister:
        return registerWritten[action.sourceReg]
    return stackWritten[action.sourceStackSlot]

@borrows
fn regallocValueParallelCopyTargetOverwritten(
        registerWritten: var bool[],
        stackWritten: var bool[],
        action: RegallocValueAction): bool =
    if action.targetLocation == RegallocValueLocationRegister:
        return registerWritten[action.targetReg]
    return stackWritten[action.targetStackSlot]

@borrows
fn regallocValueParallelCopyMarkTarget(
        registerWritten: var bool[],
        stackWritten: var bool[],
        touchedRegisters: var int32[],
        touchedStackSlots: var int32[],
        action: RegallocValueAction) =
    if action.targetLocation == RegallocValueLocationRegister:
        registerWritten[action.targetReg] = true
        add(touchedRegisters, action.targetReg)
    else:
        stackWritten[action.targetStackSlot] = true
        add(touchedStackSlots, action.targetStackSlot)

fn regallocValueValidateParallelCopyExecution(
        plan: var RegallocSinglePassValuePlan): bool =
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if !regallocValueParallelCopyKind(action.kind):
            continue
        if (action.sourceLocation == RegallocValueLocationStack &&
            (action.sourceStackSlot < 0 ||
             action.sourceStackSlot >= plan.stackSlotCount)) ||
           (action.targetLocation == RegallocValueLocationStack &&
            (action.targetStackSlot < 0 ||
             action.targetStackSlot >= plan.stackSlotCount)):
            regallocValueFail(plan,
                             RegallocValuePlanErrorParallelCopy,
                             actionIndex)
            return false
    var registerWritten = regallocValueBoolSeq(63, false)
    var stackWritten = regallocValueBoolSeq(plan.stackSlotCount, false)
    var touchedRegisters: int32[]
    var touchedStackSlots: int32[]
    var actionIndex: int32
    while actionIndex < plan.actions.len:
        let first = plan.actions[actionIndex]
        if !regallocValueParallelCopyKind(first.kind):
            actionIndex = actionIndex + 1
            continue
        for i in 0..<touchedRegisters.len:
            registerWritten[touchedRegisters[i]] = false
        for i in 0..<touchedStackSlots.len:
            stackWritten[touchedStackSlots[i]] = false
        setLen(touchedRegisters, 0)
        setLen(touchedStackSlots, 0)
        let group = first.parallelGroup
        if group < 0 || first.parallelOrdinal != 0:
            regallocValueFail(plan,
                             RegallocValuePlanErrorParallelCopy,
                             actionIndex)
            return false
        var scratchLive: bool
        var scratchSaveAction: int32 = -1
        let placement = first.placement
        let position = first.position
        let sourceBlock = first.sourceBlock
        let targetBlock = first.targetBlock
        let edgeIndex = first.edgeIndex
        let requiresEdgeSplit = first.requiresEdgeSplit
        while actionIndex < plan.actions.len &&
              plan.actions[actionIndex].parallelGroup == group:
            let action = plan.actions[actionIndex]
            if !regallocValueParallelCopyKind(action.kind) ||
               action.placement != placement ||
               action.position != position ||
               action.sourceBlock != sourceBlock ||
               action.targetBlock != targetBlock ||
               action.edgeIndex != edgeIndex ||
               action.requiresEdgeSplit != requiresEdgeSplit:
                regallocValueFail(plan,
                                 RegallocValuePlanErrorParallelCopy,
                                 actionIndex)
                return false
            if action.kind == RegallocValueActionParallelScratchSave:
                if scratchLive ||
                   regallocValueParallelCopySourceOverwritten(
                       registerWritten, stackWritten, action):
                    regallocValueFail(plan,
                                     RegallocValuePlanErrorParallelCopy,
                                     actionIndex)
                    return false
                scratchLive = true
                scratchSaveAction = actionIndex
            elif action.kind ==
                 RegallocValueActionParallelScratchRestore:
                if !scratchLive ||
                   action.relatedActionOrdinal != scratchSaveAction ||
                   regallocValueParallelCopyTargetOverwritten(
                       registerWritten, stackWritten, action):
                    regallocValueFail(plan,
                                     RegallocValuePlanErrorParallelCopy,
                                     actionIndex)
                    return false
                regallocValueParallelCopyMarkTarget(
                    registerWritten, stackWritten,
                    touchedRegisters, touchedStackSlots, action)
                scratchLive = false
                scratchSaveAction = -1
            else:
                if scratchLive &&
                   action.sourceLocation ==
                       RegallocValueLocationRegister &&
                   action.sourceReg ==
                       plan.constraints.parallelCopyScratchReg:
                    regallocValueFail(plan,
                                     RegallocValuePlanErrorParallelCopy,
                                     actionIndex)
                    return false
                if regallocValueParallelCopySourceOverwritten(
                       registerWritten, stackWritten, action) ||
                   regallocValueParallelCopyTargetOverwritten(
                       registerWritten, stackWritten, action):
                    regallocValueFail(plan,
                                     RegallocValuePlanErrorParallelCopy,
                                     actionIndex)
                    return false
                regallocValueParallelCopyMarkTarget(
                    registerWritten, stackWritten,
                    touchedRegisters, touchedStackSlots, action)
            actionIndex = actionIndex + 1
        if scratchLive:
            regallocValueFail(plan,
                             RegallocValuePlanErrorParallelCopy,
                             group)
            return false
    return true

@borrows
fn RegallocParallelCopyExpand(
        rawConstraints: var RegallocTargetConstraints,
        rawActions: var RegallocValueAction[],
        stackSlotCount: int32): RegallocParallelCopyExpansion =
    var out: RegallocParallelCopyExpansion
    var plan: RegallocSinglePassValuePlan
    plan.valid = true
    plan.stackSlotCount = stackSlotCount
    var constraints = rawConstraints
    if stackSlotCount < 0:
        regallocValueFail(plan,
                         RegallocValuePlanErrorParallelCopy,
                         stackSlotCount)
    else:
        let _ = regallocValueCanonicalizeConstraints(plan, constraints)
    if !plan.valid:
        out.errorCode = plan.errorCode
        out.errorDetail = plan.errorDetail
        return out
    if rawActions.len <= 0:
        out.valid = true
        return out
    for actionIndex in 0..<rawActions.len:
        var action = rawActions[actionIndex]
        action.consumerOrdinal = actionIndex
        action.acknowledged = false
        add(plan.actions, action)
    let _ = regallocValueResolveParallelCopyGroup(
        plan, 0, rawActions.len, stackSlotCount)
    if plan.valid:
        if !regallocValueValidateParallelCopyExecution(plan):
            plan.valid = false
    out.valid = plan.valid
    out.errorCode = plan.errorCode
    out.errorDetail = plan.errorDetail
    if plan.valid:
        out.actions = plan.actions
    return out

fn regallocValueValidateCalleeMask(
        plan: var RegallocSinglePassValuePlan): bool =
    var expected: int64
    for valueId in 0..<plan.valueAssignedRegs.len:
        let reg = plan.valueAssignedRegs[valueId]
        if reg >= 0 &&
           regallocValueContains(plan.constraints.allocatableCalleeRegs, reg):
            expected = expected | (int64(1) << reg)
    for actionIndex in 0..<plan.actions.len:
        let sourceReg = plan.actions[actionIndex].sourceReg
        let targetReg = plan.actions[actionIndex].targetReg
        if sourceReg >= 0 &&
           regallocValueContains(plan.constraints.allocatableCalleeRegs,
                                 sourceReg):
            expected = expected | (int64(1) << sourceReg)
        if targetReg >= 0 &&
           regallocValueContains(plan.constraints.allocatableCalleeRegs,
                                 targetReg):
            expected = expected | (int64(1) << targetReg)
    if expected != plan.usedCalleeMask:
        regallocValueFail(plan,
                         RegallocValuePlanErrorCalleeMask,
                         int32(expected & int64(2147483647)))
        return false
    return true

fn regallocValueValidateProductionRecipeProof(
        plan: var RegallocSinglePassValuePlan): bool =
    let factCount = plan.operandRegByFact.len
    if plan.accessFactRegisters.len != factCount ||
       plan.accessFactIsAllocatorClobber.len != factCount ||
       plan.accessFactBlockIndices.len != factCount ||
       plan.accessFactOpIndices.len != factCount ||
       plan.accessFactTermIndices.len != factCount ||
       plan.accessFactEdgeIndices.len != factCount:
        regallocValueFail(plan, RegallocValuePlanErrorFactShape,
                         factCount)
        return false
    for factIndex in 0..<factCount:
        let blockIndex = plan.accessFactBlockIndices[factIndex]
        let opIndex = plan.accessFactOpIndices[factIndex]
        let termIndex = plan.accessFactTermIndices[factIndex]
        let edgeIndex = plan.accessFactEdgeIndices[factIndex]
        if plan.accessFactRegisters[factIndex] !=
               plan.operandRegByFact[factIndex] ||
           plan.accessFactIsAllocatorClobber[factIndex] ||
           blockIndex < -1 ||
           blockIndex >= plan.blockEntryPositions.len ||
           opIndex < -1 || opIndex >= plan.opBeforePositions.len ||
           termIndex < -1 ||
           termIndex >= plan.termBeforePositions.len ||
           edgeIndex != -1 || (opIndex >= 0 && termIndex >= 0):
            regallocValueFail(plan, RegallocValuePlanErrorFactShape,
                             factIndex)
            return false
    if plan.productionRecipeBound:
        if plan.machineFragmentCount <= 0 ||
           plan.riscvEncoderEventCount < 0 ||
           ((plan.riscvEncoderEventCount == 0 &&
             len(plan.riscvEncoderEventRootSha256) != 0) ||
            (plan.riscvEncoderEventCount > 0 &&
             !regallocValueSha256TextValid(
                 plan.riscvEncoderEventRootSha256))) ||
           plan.abiIngressCount < 0 ||
           plan.abiIngressCount > plan.machineFragmentCount ||
           !regallocValueSha256TextValid(
               plan.machineFragmentRootSha256) ||
           !regallocValueSha256TextValid(
               plan.abiIngressRootSha256):
            regallocValueFail(
                plan, RegallocValuePlanErrorSemanticRoot,
                plan.machineFragmentCount)
            return false
    elif plan.machineFragmentCount != 0 ||
         plan.abiIngressCount != 0 ||
         len(plan.machineFragmentRootSha256) != 0 ||
         len(plan.abiIngressRootSha256) != 0:
        regallocValueFail(plan, RegallocValuePlanErrorSemanticRoot, 0)
        return false
    if plan.riscvEncoderReceiptPrebound:
        if plan.riscvEncoderEventCount <= 0 ||
           !regallocValueSha256TextValid(
               plan.riscvEncoderEventRootSha256):
            regallocValueFail(plan, RegallocValuePlanErrorSemanticRoot, 0)
            return false
    elif plan.riscvEncoderEventCount != 0 ||
         len(plan.riscvEncoderEventRootSha256) != 0:
        regallocValueFail(plan, RegallocValuePlanErrorSemanticRoot, 0)
        return false
    var fragmentSeen = regallocValueBoolSeq(
        plan.machineFragmentCount, false)
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        let bindingKind = RegallocSinglePassValueActionBindingKind(
            action.kind)
        if !plan.productionRecipeBound ||
           bindingKind == RegallocValueBindingStructural:
            if action.fragmentOrdinal != -1 || action.effectSpLoad ||
               action.effectSpStore || action.effectCall ||
               action.effectX16 || action.effectX17:
                regallocValueFail(
                    plan, RegallocValuePlanErrorActionShape, actionIndex)
                return false
            continue
        if bindingKind != RegallocValueBindingMachine ||
           action.fragmentOrdinal < 0 ||
           action.fragmentOrdinal >= fragmentSeen.len ||
           fragmentSeen[action.fragmentOrdinal]:
            regallocValueFail(
                plan, RegallocValuePlanErrorActionShape, actionIndex)
            return false
        fragmentSeen[action.fragmentOrdinal] = true
    return true

@borrows
fn regallocValueValidateFrozenProof(
        plan: var RegallocSinglePassValuePlan): bool =
    if !regallocValueSha256TextValid(plan.bodyIrIngressSha256) ||
       !regallocValueSha256TextValid(plan.debugProvenanceSha256):
        regallocValueFail(plan,
                         RegallocValuePlanErrorBodyIrIngress,
                         0)
        return false
    if !regallocValueValidateParallelScratchConstraint(plan):
        return false
    if !regallocValueValidateIntervalProof(plan):
        return false
    if !regallocValueValidateActionProof(plan):
        return false
    if !regallocValueValidateParallelCopyExecution(plan):
        return false
    if !regallocValueValidateCalleeMask(plan):
        return false
    if !regallocValueValidateProductionRecipeProof(plan):
        return false
    if !regallocValueValidateSemanticRoots(plan):
        regallocValueFail(plan,
                         RegallocValuePlanErrorSemanticRoot,
                         plan.nextAckOrdinal)
        return false
    return true

fn regallocValueFreezeAccessFactProof(
        accessTable: var bodyaccess.BodyIrAccessTable,
        analysis: var cfg.BodyIrCfgAnalysis,
        plan: var RegallocSinglePassValuePlan): bool =
    let factCount = accessTable.facts.len
    if plan.operandRegByFact.len != factCount ||
       analysis.factOwnerBlocks.len != factCount:
        regallocValueFail(plan, RegallocValuePlanErrorFactShape,
                         factCount)
        return false
    plan.accessFactRegisters = []
    plan.accessFactIsAllocatorClobber = []
    plan.accessFactBlockIndices = []
    plan.accessFactOpIndices = []
    plan.accessFactTermIndices = []
    plan.accessFactEdgeIndices = []
    for factIndex in 0..<factCount:
        let fact = accessTable.facts[factIndex]
        var opIndex: int32 = -1
        var termIndex: int32 = -1
        if fact.siteKind == bodyaccess.BodyIrAccessSiteOp:
            if fact.siteIndex < 0 ||
               fact.siteIndex >= plan.opBeforePositions.len:
                regallocValueFail(
                    plan, RegallocValuePlanErrorFactShape, factIndex)
                return false
            opIndex = fact.siteIndex
        elif fact.siteKind == bodyaccess.BodyIrAccessSiteTerm:
            if fact.siteIndex < 0 ||
               fact.siteIndex >= plan.termBeforePositions.len:
                regallocValueFail(
                    plan, RegallocValuePlanErrorFactShape, factIndex)
                return false
            termIndex = fact.siteIndex
        elif fact.siteKind != bodyaccess.BodyIrAccessSiteEntry:
            regallocValueFail(
                plan, RegallocValuePlanErrorFactShape, factIndex)
            return false
        add(plan.accessFactRegisters,
            plan.operandRegByFact[factIndex])
        # Allocator-owned clobber authorization is explicit.  The current
        # allocator emits no synthetic register-clobber access facts; action
        # target registers remain authorized by their Action identity.
        add(plan.accessFactIsAllocatorClobber, false)
        add(plan.accessFactBlockIndices,
            analysis.factOwnerBlocks[factIndex])
        add(plan.accessFactOpIndices, opIndex)
        add(plan.accessFactTermIndices, termIndex)
        add(plan.accessFactEdgeIndices, -1)
    return true

fn regallocSinglePassValuePlanBuildFrozen(
        bodyIR: var coreir.BodyIR,
        accessTable: var bodyaccess.BodyIrAccessTable,
        analysis: var cfg.BodyIrCfgAnalysis,
        constraints: var RegallocTargetConstraints): RegallocSinglePassValuePlan =
    var plan: RegallocSinglePassValuePlan
    plan.valid = true
    plan.debugProvenanceSha256 =
        RegallocSinglePassDebugProvenanceSha256(bodyIR)
    if !regallocValueSha256TextValid(plan.debugProvenanceSha256):
        regallocValueFail(plan,
                         RegallocValuePlanErrorBodyIrIngress,
                         0)
        return plan
    plan.bodyIrIngressSha256 =
        RegallocSinglePassBodyIrIngressSha256(bodyIR)
    if !regallocValueSha256TextValid(plan.bodyIrIngressSha256):
        regallocValueFail(plan,
                         RegallocValuePlanErrorBodyIrIngress,
                         0)
        return plan
    plan.callCount = bodyIR.callSequence.len
    for callOrdinal in 0..<bodyIR.callSequence.len:
        add(plan.callArgCounts,
            bodyIR.callSequence[callOrdinal].argSlots.len)
    if !accessTable.valid:
        regallocValueFail(plan,
                         RegallocValuePlanErrorAccess,
                         accessTable.errorCode)
        return plan
    if !analysis.valid:
        regallocValueFail(plan,
                         RegallocValuePlanErrorCfg,
                         analysis.errorCode)
        return plan
    let flatCount = analysis.blockCount * analysis.slotCount
    plan.stackSlotCount = analysis.slotCount
    if analysis.blockCount != bodyIR.blocks.len ||
       analysis.slotCount != bodyIR.localSlots.len ||
       analysis.edgeCount != analysis.succBlocks.len ||
       analysis.edgeCount != analysis.predBlocks.len ||
       analysis.succOffsets.len != analysis.blockCount + 1 ||
       analysis.predOffsets.len != analysis.blockCount + 1 ||
       analysis.reachable.len != analysis.blockCount ||
       analysis.reversePostorder.len <= 0 ||
       analysis.blockEntryVersions.len != flatCount ||
       analysis.blockExitVersions.len != flatCount ||
       analysis.mergeValueByBlockSlot.len != flatCount ||
       analysis.mergeInputStarts.len != flatCount ||
       analysis.mergeInputCounts.len != flatCount ||
       analysis.mergeInputValues.len !=
           analysis.mergeInputPredecessors.len ||
       analysis.valueSlotIndices.len != analysis.valueCount ||
       analysis.valueTypeKinds.len != analysis.valueCount ||
       analysis.valueCount < accessTable.nextValueId ||
       analysis.reachingValueByFact.len != accessTable.facts.len ||
       analysis.factOwnerBlocks.len != accessTable.facts.len ||
       accessTable.valueSlotIndices.len != accessTable.nextValueId ||
       accessTable.valueTypeKinds.len != accessTable.nextValueId ||
       accessTable.opFactStarts.len != bodyIR.ops.len ||
       accessTable.opFactCounts.len != bodyIR.ops.len ||
       accessTable.termFactStarts.len != bodyIR.terms.len ||
       accessTable.termFactCounts.len != bodyIR.terms.len ||
       accessTable.callResultPassKinds.len !=
           bodyIR.callSequence.len:
        regallocValueFail(plan,
                         RegallocValuePlanErrorFactShape,
                         analysis.valueCount)
        return plan
    if analysis.succOffsets[0] != 0 ||
       analysis.predOffsets[0] != 0 ||
       analysis.succOffsets[analysis.blockCount] !=
           analysis.edgeCount ||
       analysis.predOffsets[analysis.blockCount] !=
           analysis.edgeCount:
        regallocValueFail(plan,
                         RegallocValuePlanErrorFactShape,
                         analysis.edgeCount)
        return plan
    for blockIndex in 0..<analysis.blockCount:
        if analysis.succOffsets[blockIndex] < 0 ||
           analysis.succOffsets[blockIndex + 1] <
               analysis.succOffsets[blockIndex] ||
           analysis.succOffsets[blockIndex + 1] >
               analysis.edgeCount ||
           analysis.predOffsets[blockIndex] < 0 ||
           analysis.predOffsets[blockIndex + 1] <
               analysis.predOffsets[blockIndex] ||
           analysis.predOffsets[blockIndex + 1] >
               analysis.edgeCount:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             blockIndex)
            return plan
    if !regallocValueCanonicalizeConstraints(plan, constraints):
        return plan
    if !bodyaccess.BodyIrAccessApplyCallAbiLayout(
            bodyIR, accessTable,
            plan.constraints.fixedArgRegs.len,
            RegallocTargetConstraintsSretShiftsFixedArgs(
                plan.constraints),
            plan.constraints.packedStackArgs,
            plan.constraints.stackArgSlotBytes,
            plan.constraints.stackAlignmentBytes):
        regallocValueFail(plan,
                         RegallocValuePlanErrorAccess,
                         accessTable.errorCode)
        return plan
    regallocValueInitPositions(bodyIR, analysis, plan)
    regallocValueInitCallReachability(accessTable, plan)
    if !plan.valid:
        return plan
    if !regallocValueValidateFixedFacts(accessTable, plan):
        return plan
    let predEdgeIndices = regallocValueInitEdges(analysis, plan)
    if !plan.valid:
        return plan
    regallocValueInitMetadata(bodyIR, accessTable, analysis, plan)
    if !plan.valid:
        return plan
    var raw: RegallocValueRawUses
    regallocValueCollectFacts(accessTable, analysis, plan, raw)
    if !plan.valid:
        return plan
    var edgeCopies: RegallocValueEdgeCopy[]
    var mutablePredEdgeIndices = predEdgeIndices
    regallocValueCollectMergeEdges(
        analysis, mutablePredEdgeIndices, plan, raw, edgeCopies)
    if !plan.valid:
        return plan
    regallocValueBuildUseCsr(plan, raw)
    if !plan.valid:
        return plan
    regallocValueAllocate(plan)
    if !plan.valid:
        return plan
    var nextParallelGroup: int32
    regallocValuePlanLocalActions(
        bodyIR, accessTable, analysis, plan, nextParallelGroup)
    if !plan.valid:
        return plan
    regallocValuePlanEdgeActions(
        analysis, plan, edgeCopies, nextParallelGroup)
    if !plan.valid:
        return plan
    regallocValueFreezeCalleeMask(plan)
    regallocValuePlanStructuralActions(plan)
    regallocValueFreezeActions(bodyIR, analysis, plan)
    if !plan.valid:
        return plan
    if !regallocValueFreezeAccessFactProof(
           accessTable, analysis, plan):
        return plan
    plan.actionIssued = regallocValueBoolSeq(plan.actions.len, false)
    plan.actionEmissions = []
    regallocValueFreezeSemanticRoots(plan)
    if !regallocValueValidateFrozenProof(plan):
        return plan
    for actionIndex in 0..<plan.actions.len:
        if plan.actions[actionIndex].consumerOrdinal != actionIndex ||
           plan.actions[actionIndex].acknowledged:
            regallocValueFail(plan,
                             RegallocValuePlanErrorFactShape,
                             actionIndex)
            return plan
    plan.frozen = true
    return plan

@borrows
fn RegallocSinglePassValuePlanBuild(
        bodyIR: var coreir.BodyIR,
        accessTable: var bodyaccess.BodyIrAccessTable,
        analysis: var cfg.BodyIrCfgAnalysis,
        constraints: var RegallocTargetConstraints): RegallocSinglePassValuePlan =
    # This public split-input boundary is used by proof/attack tests.  Never
    # accept an access table or CFG computed from another BodyIR generation:
    # identical row counts are not identity.  Rebuild both canonical fact
    # layers once, bind every column by a domain-separated SHA-256, then pass
    # the caller-owned rows to the frozen allocator.  The production decoded
    # entry below constructs and consumes its facts in one lexical state
    # machine and therefore does not pay this verification rebuild.
    if !RegallocSinglePassBodyIrCanonicalIngressValid(bodyIR):
        var failed: RegallocSinglePassValuePlan
        failed.valid = true
        regallocValueFail(failed,
                         RegallocValuePlanErrorBodyIrIngress,
                         bodyIR.blocks.len)
        return failed
    var canonicalAccess = bodyaccess.BodyIrAccessDecode(bodyIR)
    if !canonicalAccess.valid:
        var failed: RegallocSinglePassValuePlan
        failed.valid = true
        regallocValueFail(failed,
                         RegallocValuePlanErrorAccess,
                         canonicalAccess.errorCode)
        return failed
    var canonicalAnalysis = cfg.BodyIrCfgAnalyze(
        bodyIR, canonicalAccess)
    if !canonicalAnalysis.valid:
        var failed: RegallocSinglePassValuePlan
        failed.valid = true
        regallocValueFail(failed,
                         RegallocValuePlanErrorCfg,
                         canonicalAnalysis.errorCode)
        return failed
    let accessIngress = regallocValueAccessTableIngressSha256(
        accessTable)
    let canonicalAccessIngress =
        regallocValueAccessTableIngressSha256(canonicalAccess)
    let cfgIngress = regallocValueCfgIngressSha256(analysis)
    let canonicalCfgIngress =
        regallocValueCfgIngressSha256(canonicalAnalysis)
    if accessIngress != canonicalAccessIngress ||
       cfgIngress != canonicalCfgIngress:
        var failed: RegallocSinglePassValuePlan
        failed.valid = true
        regallocValueFail(failed,
                         RegallocValuePlanErrorFactShape,
                         -1)
        return failed
    return regallocSinglePassValuePlanBuildFrozen(
        bodyIR, accessTable, analysis, constraints)

@borrows
fn RegallocSinglePassValuePlanBuildDecoded(
        bodyIR: var coreir.BodyIR,
        constraints: var RegallocTargetConstraints): RegallocSinglePassValuePlan =
    if !RegallocSinglePassBodyIrCanonicalIngressValid(bodyIR):
        var failed: RegallocSinglePassValuePlan
        failed.valid = true
        regallocValueFail(failed,
                         RegallocValuePlanErrorBodyIrIngress,
                         bodyIR.blocks.len)
        return failed
    var accessTable = bodyaccess.BodyIrAccessDecode(bodyIR)
    var analysis = cfg.BodyIrCfgAnalyze(bodyIR, accessTable)
    return regallocSinglePassValuePlanBuildFrozen(
        bodyIR, accessTable, analysis, constraints)

fn RegallocSinglePassValuePlanActionCount(
        plan: var RegallocSinglePassValuePlan): int32 =
    if !plan.valid || !plan.frozen:
        return -1
    return plan.actions.len

fn RegallocSinglePassValuePlanValidate(
        plan: var RegallocSinglePassValuePlan): bool =
    if !plan.valid || !plan.frozen:
        return false
    return regallocValueValidateFrozenProof(plan)

@borrows
fn RegallocSinglePassValuePlanBindMachineRecipe(
        plan: var RegallocSinglePassValuePlan,
        machineFragmentCount: int32,
        machineFragmentRootSha256: str,
        abiIngressCount: int32,
        abiIngressRootSha256: str,
        fragmentOrdinals: var int32[],
        effectSpLoad: var bool[],
        effectSpStore: var bool[],
        effectCall: var bool[],
        effectX16: var bool[],
        effectX17: var bool[]): bool =
    let actionCount = plan.actions.len
    if !RegallocSinglePassValuePlanValidate(plan) ||
       plan.productionRecipeBound || plan.finalized ||
       plan.emissionSymbolBound || plan.emissionSymbolSealed ||
       plan.nextIssueOrdinal != 0 || plan.nextAckOrdinal != 0 ||
       plan.actionEmissions.len != 0 || machineFragmentCount <= 0 ||
       abiIngressCount < 0 || abiIngressCount > machineFragmentCount ||
       !regallocValueSha256TextValid(machineFragmentRootSha256) ||
       !regallocValueSha256TextValid(abiIngressRootSha256) ||
       fragmentOrdinals.len != actionCount ||
       effectSpLoad.len != actionCount ||
       effectSpStore.len != actionCount ||
       effectCall.len != actionCount ||
       effectX16.len != actionCount ||
       effectX17.len != actionCount:
        regallocValueFail(plan, RegallocValuePlanErrorSemanticRoot,
                         actionCount)
        return false
    var fragmentSeen = regallocValueBoolSeq(
        machineFragmentCount, false)
    for actionIndex in 0..<actionCount:
        let bindingKind = RegallocSinglePassValueActionBindingKind(
            plan.actions[actionIndex].kind)
        if bindingKind == RegallocValueBindingStructural:
            if fragmentOrdinals[actionIndex] != -1 ||
               effectSpLoad[actionIndex] ||
               effectSpStore[actionIndex] ||
               effectCall[actionIndex] || effectX16[actionIndex] ||
               effectX17[actionIndex]:
                regallocValueFail(
                    plan, RegallocValuePlanErrorActionShape, actionIndex)
                return false
            continue
        let fragmentOrdinal = fragmentOrdinals[actionIndex]
        if bindingKind != RegallocValueBindingMachine ||
           fragmentOrdinal < 0 ||
           fragmentOrdinal >= machineFragmentCount ||
           fragmentSeen[fragmentOrdinal]:
            regallocValueFail(
                plan, RegallocValuePlanErrorActionShape, actionIndex)
            return false
        fragmentSeen[fragmentOrdinal] = true
    for actionIndex in 0..<actionCount:
        plan.actions[actionIndex].fragmentOrdinal =
            fragmentOrdinals[actionIndex]
        plan.actions[actionIndex].effectSpLoad =
            effectSpLoad[actionIndex]
        plan.actions[actionIndex].effectSpStore =
            effectSpStore[actionIndex]
        plan.actions[actionIndex].effectCall = effectCall[actionIndex]
        plan.actions[actionIndex].effectX16 = effectX16[actionIndex]
        plan.actions[actionIndex].effectX17 = effectX17[actionIndex]
    plan.productionRecipeBound = true
    plan.machineFragmentCount = machineFragmentCount
    plan.machineFragmentRootSha256 =
        strings.CloneStr(machineFragmentRootSha256)
    plan.abiIngressCount = abiIngressCount
    plan.abiIngressRootSha256 =
        strings.CloneStr(abiIngressRootSha256)
    regallocValueFreezeSemanticRoots(plan)
    return regallocValueValidateFrozenProof(plan)

@borrows
fn RegallocSinglePassValuePlanPrebindRiscvEncoderReceipt(
        plan: var RegallocSinglePassValuePlan,
        eventCount: int32,
        eventRootSha256: str): bool =
    if !RegallocSinglePassValuePlanValidate(plan) ||
       plan.productionRecipeBound || plan.finalized ||
       plan.emissionSymbolBound || plan.emissionSymbolSealed ||
       plan.riscvEncoderEventCount != 0 ||
       len(plan.riscvEncoderEventRootSha256) != 0 ||
       plan.riscvEncoderReceiptPrebound ||
       eventCount <= 0 ||
       !regallocValueSha256TextValid(eventRootSha256):
        return false
    plan.riscvEncoderEventCount = eventCount
    plan.riscvEncoderEventRootSha256 =
        strings.CloneStr(eventRootSha256)
    plan.riscvEncoderReceiptPrebound = true
    return true

@borrows
fn RegallocSinglePassValuePlanBeginEmissionSymbol(
        plan: var RegallocSinglePassValuePlan,
        symbolName: str,
        symbolByteStart: int32,
        symbolByteLength: int32): bool =
    if !plan.valid || !plan.frozen || plan.finalized:
        return false
    if !regallocValueValidateSemanticRoots(plan):
        regallocValueFail(plan,
                         RegallocValuePlanErrorSemanticRoot,
                         plan.nextAckOrdinal)
        return false
    if plan.emissionSymbolBound || plan.nextIssueOrdinal != 0 ||
       plan.nextAckOrdinal != 0 || len(symbolName) <= 0 ||
       symbolByteStart < 0 || symbolByteLength <= 0 ||
       symbolByteStart % 4 != 0 ||
       symbolByteStart > 2147483647 - symbolByteLength:
        regallocValueFail(plan,
                         RegallocValuePlanErrorEmissionShape,
                         symbolByteStart)
        return false
    plan.emissionSymbolBound = true
    plan.emissionSymbolName = strings.CloneStr(symbolName)
    plan.emissionSymbolByteStart = symbolByteStart
    plan.emissionSymbolByteLength = symbolByteLength
    plan.emissionSymbolBytesSha256 = ""
    plan.emissionOwnerSha256 = regallocValueEmissionOwnerHash(
        plan.frozenSemanticSha256, plan.emissionSymbolName,
        symbolByteStart, symbolByteLength)
    plan.lastMachineEmissionEnd = symbolByteStart
    return true

@borrows
fn RegallocSinglePassValuePlanActionAt(
        plan: var RegallocSinglePassValuePlan,
        actionIndex: int32,
        action: var RegallocValueAction,
        ticket: var RegallocValueActionTicket): bool =
    if !plan.valid || !plan.frozen || plan.finalized ||
       plan.emissionSymbolSealed:
        return false
    if !plan.emissionSymbolBound ||
       actionIndex != plan.nextIssueOrdinal ||
       plan.nextIssueOrdinal != plan.nextAckOrdinal ||
       actionIndex < 0 || actionIndex >= plan.actions.len ||
       plan.actionIssued[actionIndex]:
        regallocValueFail(plan,
                         RegallocValuePlanErrorActionNotIssued,
                         actionIndex)
        return false
    action = plan.actions[actionIndex]
    ticket.valid = true
    ticket.consumerOrdinal = action.consumerOrdinal
    ticket.actionSnapshot = action
    ticket.kind = action.kind
    ticket.placement = action.placement
    ticket.position = action.position
    ticket.factIndex = action.factIndex
    ticket.valueId = action.valueId
    ticket.fixedOrdinal = action.fixedOrdinal
    ticket.ownerPlanSha256 = plan.frozenSemanticSha256
    ticket.emissionOwnerSha256 = plan.emissionOwnerSha256
    ticket.actionSemanticSha256 =
        regallocValueActionSemanticHash(action)
    plan.actionIssued[actionIndex] = true
    plan.nextIssueOrdinal = plan.nextIssueOrdinal + 1
    return true

@borrows
fn RegallocSinglePassValuePlanAck(
        plan: var RegallocSinglePassValuePlan,
        ticket: RegallocValueActionTicket,
        emittedByteStart: int32,
        emittedByteLength: int32,
        emittedBytesSha256: str): bool =
    let consumerOrdinal = ticket.consumerOrdinal
    if !plan.valid || !plan.frozen || plan.finalized ||
       plan.emissionSymbolSealed ||
       consumerOrdinal != plan.nextAckOrdinal ||
       consumerOrdinal < 0 || consumerOrdinal >= plan.actions.len ||
       plan.nextIssueOrdinal != plan.nextAckOrdinal + 1 ||
       !plan.actionIssued[consumerOrdinal] || !ticket.valid ||
       plan.actions[consumerOrdinal].acknowledged:
        regallocValueFail(plan,
                         RegallocValuePlanErrorAckOrder,
                         consumerOrdinal)
        return false
    let action = plan.actions[consumerOrdinal]
    if ticket.ownerPlanSha256 != plan.frozenSemanticSha256 ||
       ticket.emissionOwnerSha256 != plan.emissionOwnerSha256 ||
       ticket.actionSemanticSha256 !=
           regallocValueActionSemanticHash(action) ||
       ticket.kind != action.kind ||
       ticket.placement != action.placement ||
       ticket.position != action.position ||
       ticket.factIndex != action.factIndex ||
       ticket.valueId != action.valueId ||
       ticket.fixedOrdinal != action.fixedOrdinal ||
       !regallocValueActionSemanticEqual(ticket.actionSnapshot, action):
        regallocValueFail(plan,
                         RegallocValuePlanErrorActionNotIssued,
                         consumerOrdinal)
        return false
    let bindingKind =
        RegallocSinglePassValueActionBindingKind(action.kind)
    var bindingValid: bool
    if bindingKind == RegallocValueBindingStructural:
        bindingValid = emittedByteStart == 0 &&
                       emittedByteLength == 0 &&
                       emittedBytesSha256 == RegallocValueEmptySha256
    elif bindingKind == RegallocValueBindingMachine:
        bindingValid = emittedByteLength > 0 &&
                       emittedByteStart >= plan.emissionSymbolByteStart &&
                       emittedByteStart >= plan.lastMachineEmissionEnd &&
                       emittedByteStart % 4 == 0 &&
                       emittedByteLength % 4 == 0 &&
                       emittedByteStart <=
                           2147483647 - emittedByteLength &&
                       emittedByteStart + emittedByteLength <=
                           plan.emissionSymbolByteStart +
                           plan.emissionSymbolByteLength &&
                       regallocValueSha256TextValid(
                           emittedBytesSha256)
    if !plan.emissionSymbolBound || !bindingValid:
        regallocValueFail(plan,
                         RegallocValuePlanErrorEmissionShape,
                         consumerOrdinal)
        return false
    var emission: RegallocValueActionEmission
    emission.consumerOrdinal = consumerOrdinal
    emission.actionKind = action.kind
    emission.actionPosition = action.position
    emission.symbolByteStart = plan.emissionSymbolByteStart
    emission.symbolByteLength = plan.emissionSymbolByteLength
    emission.emittedByteStart = emittedByteStart
    emission.emittedByteLength = emittedByteLength
    emission.emittedBytesSha256 = strings.CloneStr(emittedBytesSha256)
    emission.bindingKind = bindingKind
    emission.ownerPlanSha256 = plan.frozenSemanticSha256
    emission.emissionOwnerSha256 = plan.emissionOwnerSha256
    emission.actionSemanticSha256 =
        regallocValueActionSemanticHash(action)
    emission.bindingSha256 =
        regallocValueActionEmissionBindingHash(emission)
    add(plan.actionEmissions, emission)
    plan.actionBindingRootSha256 = regallocValueBindingRootExtend(
        plan.actionBindingRootSha256,
        consumerOrdinal,
        plan.actionEmissions[consumerOrdinal].bindingSha256)
    if bindingKind == RegallocValueBindingMachine:
        plan.lastMachineEmissionEnd =
            emittedByteStart + emittedByteLength
    plan.actions[consumerOrdinal].acknowledged = true
    plan.nextAckOrdinal = plan.nextAckOrdinal + 1
    return true

@borrows
fn RegallocSinglePassValuePlanSealEmissionSymbol(
        plan: var RegallocSinglePassValuePlan,
        symbolBytesSha256: str): bool =
    if !plan.valid || !plan.frozen || plan.finalized ||
       !plan.emissionSymbolBound || plan.emissionSymbolSealed:
        return false
    if plan.nextIssueOrdinal != plan.actions.len ||
       plan.nextAckOrdinal != plan.actions.len ||
       plan.actionEmissions.len != plan.actions.len:
        regallocValueFail(plan,
                         RegallocValuePlanErrorUnacknowledged,
                         plan.nextAckOrdinal)
        return false
    if !regallocValueValidateFrozenProof(plan):
        return false
    if !regallocValueSha256TextValid(symbolBytesSha256):
        regallocValueFail(plan,
                         RegallocValuePlanErrorEmissionShape,
                         len(symbolBytesSha256))
        return false
    plan.emissionSymbolBytesSha256 =
        strings.CloneStr(symbolBytesSha256)
    plan.emissionSymbolSealed = true
    plan.sealedReceiptSha256 = regallocValueReceiptHash(plan)
    return true

@borrows
fn RegallocSinglePassValuePlanFinalize(
        plan: var RegallocSinglePassValuePlan): bool =
    if !plan.valid || !plan.frozen || plan.finalized:
        return false
    if !plan.emissionSymbolBound ||
       plan.nextIssueOrdinal != plan.actions.len ||
       plan.nextAckOrdinal != plan.actions.len ||
       plan.actionEmissions.len != plan.actions.len:
        regallocValueFail(plan,
                         RegallocValuePlanErrorUnacknowledged,
                         plan.nextAckOrdinal)
        return false
    for actionIndex in 0..<plan.actions.len:
        if !plan.actions[actionIndex].acknowledged:
            regallocValueFail(plan,
                             RegallocValuePlanErrorUnacknowledged,
                             actionIndex)
            return false
    if !plan.emissionSymbolSealed:
        regallocValueFail(plan,
                         RegallocValuePlanErrorEmissionShape,
                         plan.nextAckOrdinal)
        return false
    if !regallocValueValidateFrozenProof(plan):
        return false
    plan.finalized = true
    return true

fn RegallocSinglePassValuePlanReceipt(
        plan: var RegallocSinglePassValuePlan,
        receipt: var RegallocValueEmissionReceipt): bool =
    if !plan.valid || !plan.frozen || !plan.finalized ||
       !plan.emissionSymbolSealed ||
       !regallocValueValidateFrozenProof(plan):
        return false
    receipt.valid = true
    receipt.symbolName = strings.CloneStr(plan.emissionSymbolName)
    receipt.symbolByteStart = plan.emissionSymbolByteStart
    receipt.symbolByteLength = plan.emissionSymbolByteLength
    receipt.symbolBytesSha256 =
        strings.CloneStr(plan.emissionSymbolBytesSha256)
    receipt.actionCount = plan.actions.len
    receipt.debugProvenanceSha256 =
        strings.CloneStr(plan.debugProvenanceSha256)
    receipt.frozenSemanticSha256 =
        strings.CloneStr(plan.frozenSemanticSha256)
    receipt.actionSemanticRootSha256 =
        strings.CloneStr(plan.actionSemanticRootSha256)
    receipt.actionBindingRootSha256 =
        strings.CloneStr(plan.actionBindingRootSha256)
    receipt.machineFragmentCount = plan.machineFragmentCount
    receipt.machineFragmentRootSha256 =
        strings.CloneStr(plan.machineFragmentRootSha256)
    receipt.riscvEncoderEventCount = plan.riscvEncoderEventCount
    receipt.riscvEncoderEventRootSha256 =
        strings.CloneStr(plan.riscvEncoderEventRootSha256)
    receipt.abiIngressCount = plan.abiIngressCount
    receipt.abiIngressRootSha256 =
        strings.CloneStr(plan.abiIngressRootSha256)
    receipt.receiptSha256 = strings.CloneStr(plan.sealedReceiptSha256)
    receipt.actionEmissions = []
    for emissionIndex in 0..<plan.actionEmissions.len:
        add(receipt.actionEmissions, share(plan.actionEmissions[emissionIndex]))
    return true

@borrows
fn regallocValueIntArraysEqual(left: var int32[],
                               right: var int32[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn regallocValueBoolArraysEqual(left: var bool[],
                                right: var bool[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn regallocValueEmissionsEqual(
        left: var RegallocValueActionEmission[],
        right: var RegallocValueActionEmission[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        let a = left[i]
        let b = right[i]
        if a.consumerOrdinal != b.consumerOrdinal ||
           a.actionKind != b.actionKind ||
           a.actionPosition != b.actionPosition ||
           a.symbolByteStart != b.symbolByteStart ||
           a.symbolByteLength != b.symbolByteLength ||
           a.emittedByteStart != b.emittedByteStart ||
           a.emittedByteLength != b.emittedByteLength ||
           a.emittedBytesSha256 != b.emittedBytesSha256 ||
           a.bindingKind != b.bindingKind ||
           a.ownerPlanSha256 != b.ownerPlanSha256 ||
           a.emissionOwnerSha256 != b.emissionOwnerSha256 ||
           a.actionSemanticSha256 != b.actionSemanticSha256 ||
           a.bindingSha256 != b.bindingSha256:
            return false
    return true

@borrows
fn regallocValueConstraintsEqual(left: var RegallocTargetConstraints,
                                  right: var RegallocTargetConstraints): bool =
    return regallocValueIntArraysEqual(left.registerUniverse,
                                       right.registerUniverse) &&
           regallocValueIntArraysEqual(left.allocatableCallerRegs,
                                       right.allocatableCallerRegs) &&
           regallocValueIntArraysEqual(left.allocatableCalleeRegs,
                                       right.allocatableCalleeRegs) &&
           regallocValueIntArraysEqual(left.reservedRegs,
                                       right.reservedRegs) &&
           regallocValueIntArraysEqual(left.callClobberRegs,
                                       right.callClobberRegs) &&
           regallocValueIntArraysEqual(left.fixedArgRegs,
                                       right.fixedArgRegs) &&
           left.fixedResultReg == right.fixedResultReg &&
           left.fixedSretReg == right.fixedSretReg &&
           left.sretShiftsFixedArgs ==
               right.sretShiftsFixedArgs &&
           left.fixedReturnReg == right.fixedReturnReg &&
           left.parallelCopyScratchReg ==
               right.parallelCopyScratchReg &&
           left.packedStackArgs == right.packedStackArgs &&
           left.stackArgSlotBytes == right.stackArgSlotBytes &&
           left.stackAlignmentBytes == right.stackAlignmentBytes &&
           regallocValueIntArraysEqual(left.gprTypeKinds,
                                       right.gprTypeKinds)

@borrows
fn regallocValueActionsEqual(left: var RegallocValueAction[],
                             right: var RegallocValueAction[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        let a = left[i]
        let b = right[i]
        if a.acknowledged != b.acknowledged ||
           !regallocValueActionSemanticEqual(a, b):
            return false
    return true

fn RegallocParallelCopyExpansionEquivalent(
        left: var RegallocParallelCopyExpansion,
        right: var RegallocParallelCopyExpansion): bool =
    return left.valid == right.valid &&
           left.errorCode == right.errorCode &&
           left.errorDetail == right.errorDetail &&
           regallocValueActionsEqual(left.actions, right.actions)

fn RegallocSinglePassValuePlanEquivalent(
        left: var RegallocSinglePassValuePlan,
        right: var RegallocSinglePassValuePlan): bool =
    if !left.valid || !right.valid || !left.frozen || !right.frozen ||
       left.bodyIrIngressSha256 != right.bodyIrIngressSha256 ||
       left.debugProvenanceSha256 != right.debugProvenanceSha256 ||
       left.finalized != right.finalized ||
       left.emissionSymbolBound != right.emissionSymbolBound ||
       left.emissionSymbolSealed != right.emissionSymbolSealed ||
       left.emissionSymbolName != right.emissionSymbolName ||
       left.emissionSymbolByteStart != right.emissionSymbolByteStart ||
       left.emissionSymbolByteLength != right.emissionSymbolByteLength ||
       left.emissionSymbolBytesSha256 !=
           right.emissionSymbolBytesSha256 ||
       left.frozenSemanticSha256 != right.frozenSemanticSha256 ||
       left.actionSemanticRootSha256 !=
           right.actionSemanticRootSha256 ||
       left.emissionOwnerSha256 != right.emissionOwnerSha256 ||
       left.actionBindingRootSha256 !=
           right.actionBindingRootSha256 ||
       left.productionRecipeBound != right.productionRecipeBound ||
       left.machineFragmentCount != right.machineFragmentCount ||
       left.machineFragmentRootSha256 !=
           right.machineFragmentRootSha256 ||
       left.riscvEncoderEventCount != right.riscvEncoderEventCount ||
       left.riscvEncoderEventRootSha256 !=
           right.riscvEncoderEventRootSha256 ||
       left.riscvEncoderReceiptPrebound !=
           right.riscvEncoderReceiptPrebound ||
       left.abiIngressCount != right.abiIngressCount ||
       left.abiIngressRootSha256 != right.abiIngressRootSha256 ||
       left.sealedReceiptSha256 != right.sealedReceiptSha256 ||
       left.lastMachineEmissionEnd != right.lastMachineEmissionEnd ||
       left.nextIssueOrdinal != right.nextIssueOrdinal ||
       left.nextAckOrdinal != right.nextAckOrdinal ||
       left.stackSlotCount != right.stackSlotCount ||
       left.callCount != right.callCount ||
       left.positionCount != right.positionCount ||
       left.usedCalleeMask != right.usedCalleeMask ||
       !regallocValueConstraintsEqual(left.constraints, right.constraints):
        return false
    if !regallocValueIntArraysEqual(left.blockEntryPositions,
                                    right.blockEntryPositions) ||
       !regallocValueIntArraysEqual(left.callArgCounts,
                                    right.callArgCounts) ||
       !regallocValueBoolArraysEqual(left.callReachable,
                                     right.callReachable) ||
       !regallocValueIntArraysEqual(left.blockExitPositions,
                                    right.blockExitPositions) ||
       !regallocValueIntArraysEqual(left.bodyOpKinds,
                                    right.bodyOpKinds) ||
       !regallocValueIntArraysEqual(left.bodyOpOperandCounts,
                                    right.bodyOpOperandCounts) ||
       !regallocValueIntArraysEqual(left.opBeforePositions,
                                    right.opBeforePositions) ||
       !regallocValueIntArraysEqual(left.opAfterPositions,
                                    right.opAfterPositions) ||
       !regallocValueIntArraysEqual(left.termBeforePositions,
                                    right.termBeforePositions) ||
       !regallocValueIntArraysEqual(left.termAfterPositions,
                                    right.termAfterPositions) ||
       !regallocValueIntArraysEqual(left.valueDefPositions,
                                    right.valueDefPositions) ||
       !regallocValueIntArraysEqual(left.valueDefFactIndices,
                                    right.valueDefFactIndices) ||
       !regallocValueIntArraysEqual(left.valueDefBlocks,
                                    right.valueDefBlocks) ||
       !regallocValueBoolArraysEqual(left.valueDefIsEntry,
                                     right.valueDefIsEntry) ||
       !regallocValueIntArraysEqual(left.valueEndPositions,
                                    right.valueEndPositions) ||
       !regallocValueIntArraysEqual(left.valueClasses,
                                    right.valueClasses) ||
       !regallocValueIntArraysEqual(left.valueSlotIndices,
                                    right.valueSlotIndices) ||
       !regallocValueIntArraysEqual(left.valueTypeKinds,
                                    right.valueTypeKinds) ||
       !regallocValueBoolArraysEqual(left.valueMemoryHomes,
                                     right.valueMemoryHomes) ||
       !regallocValueIntArraysEqual(left.valueAssignedRegs,
                                    right.valueAssignedRegs) ||
       !regallocValueIntArraysEqual(left.valueUseOffsets,
                                    right.valueUseOffsets) ||
       !regallocValueIntArraysEqual(left.valueUsePositions,
                                    right.valueUsePositions) ||
       !regallocValueIntArraysEqual(left.valueUseFactIndices,
                                    right.valueUseFactIndices) ||
       !regallocValueIntArraysEqual(left.valueUseKinds,
                                    right.valueUseKinds) ||
       !regallocValueIntArraysEqual(left.valueUseSourceBlocks,
                                    right.valueUseSourceBlocks) ||
       !regallocValueIntArraysEqual(left.valueUseTargetBlocks,
                                    right.valueUseTargetBlocks) ||
       !regallocValueIntArraysEqual(left.callPositions,
                                    right.callPositions) ||
       !regallocValueIntArraysEqual(left.allocationOrder,
                                    right.allocationOrder) ||
       !regallocValueIntArraysEqual(left.regIntervalOffsets,
                                    right.regIntervalOffsets) ||
       !regallocValueIntArraysEqual(left.regIntervalValues,
                                    right.regIntervalValues) ||
       !regallocValueIntArraysEqual(left.operandRegByFact,
                                    right.operandRegByFact) ||
       !regallocValueIntArraysEqual(left.accessFactRegisters,
                                    right.accessFactRegisters) ||
       !regallocValueBoolArraysEqual(
           left.accessFactIsAllocatorClobber,
           right.accessFactIsAllocatorClobber) ||
       !regallocValueIntArraysEqual(left.accessFactBlockIndices,
                                    right.accessFactBlockIndices) ||
       !regallocValueIntArraysEqual(left.accessFactOpIndices,
                                    right.accessFactOpIndices) ||
       !regallocValueIntArraysEqual(left.accessFactTermIndices,
                                    right.accessFactTermIndices) ||
       !regallocValueIntArraysEqual(left.accessFactEdgeIndices,
                                    right.accessFactEdgeIndices) ||
       !regallocValueIntArraysEqual(left.opActionStarts,
                                    right.opActionStarts) ||
       !regallocValueIntArraysEqual(left.opActionCounts,
                                    right.opActionCounts) ||
       !regallocValueIntArraysEqual(left.termActionStarts,
                                    right.termActionStarts) ||
       !regallocValueIntArraysEqual(left.termActionCounts,
                                    right.termActionCounts) ||
       !regallocValueIntArraysEqual(left.blockEntryActionStarts,
                                    right.blockEntryActionStarts) ||
       !regallocValueIntArraysEqual(left.blockEntryActionCounts,
                                    right.blockEntryActionCounts) ||
       left.functionEntryActionStart !=
           right.functionEntryActionStart ||
       left.functionEntryActionCount !=
           right.functionEntryActionCount ||
       !regallocValueIntArraysEqual(left.blockExitActionStarts,
                                    right.blockExitActionStarts) ||
       !regallocValueIntArraysEqual(left.blockExitActionCounts,
                                    right.blockExitActionCounts) ||
       !regallocValueIntArraysEqual(left.edgeSourceBlocks,
                                    right.edgeSourceBlocks) ||
       !regallocValueIntArraysEqual(left.edgeTargetBlocks,
                                    right.edgeTargetBlocks) ||
       !regallocValueIntArraysEqual(left.edgeActionStarts,
                                    right.edgeActionStarts) ||
       !regallocValueIntArraysEqual(left.edgeActionCounts,
                                    right.edgeActionCounts) ||
       !regallocValueIntArraysEqual(left.virtualEntryActionStarts,
                                    right.virtualEntryActionStarts) ||
       !regallocValueIntArraysEqual(left.virtualEntryActionCounts,
                                    right.virtualEntryActionCounts) ||
       !regallocValueBoolArraysEqual(left.actionIssued,
                                     right.actionIssued) ||
       !regallocValueEmissionsEqual(left.actionEmissions,
                                    right.actionEmissions):
        return false
    return regallocValueActionsEqual(left.actions, right.actions)
