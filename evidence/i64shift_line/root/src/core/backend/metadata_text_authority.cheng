import std/system

fn MetadataTextCheckedAdvance(scannedBytes: int32): int32 =
    if scannedBytes < 0 || scannedBytes >= 2147483647:
        panic("metadata text: byte scan index overflow")
    return scannedBytes + 1

@borrows
fn MetadataTextStable(text: str): bool =
    let byteCount = text.len
    if byteCount < 0:
        panic("metadata text: invalid byte count")
    var scannedBytes: int32
    for byteIndex in 0..<byteCount:
        let value = text[byteIndex]
        if value < Char(32) || value > Char(126):
            return false
        scannedBytes = MetadataTextCheckedAdvance(scannedBytes)
    if scannedBytes != byteCount:
        panic("metadata text: incomplete byte scan")
    return true
