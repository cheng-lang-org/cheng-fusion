# csg_plugin_pickup — CSG 取件客户端层 (S4-B 缓存状态机 + S4-C 链对接): 唯一
# 持 IO 的取件入口。设计: docs/cheng-csg-pickup-design.md §2.2/§4/§6 S4-B +
# 设计卷 step4-fetch-design-20260827 DESIGN.md §2/§3/§5。纯值层 (CID 四元组 /
# receipt codec / VerifyGates) 在 backend2_plugin_cid.cheng (S4-A), 交易对象
# 纯值 codec 在 plugin_trade_record.cheng (S4-C); 本层只组合不重实现。
#
# S4-C 链对接 (设计 §2.3): 链载体 = CHENG_CSG_CHAIN_ROOT 内容寻址双文件条目
# (<cid>.csgtrade record 线格式 + <cid>.csgplugin artifact 字节, 分片同缓存,
# 双文件齐备才可领取); FetchRemote = 链查 → record 严格 decode → artifact 下
# 载 → T6 降格映射 (record→receipt, 二选一, 禁并存) → BindToReceipt 三方相
# 等硬闸 → 交 Acquire 过同一 VerifyGates/Store。发布半 (operation payload 上
# 链 + proofCid 回填) 落位 cheng-fusion 正式仓 (plan Step5)。
#
# S4-C 裁定记录 (设计 §7 待判清单): T2 allowNetwork 缺省 = 离线 (fail-closed;
# 仅显式 CHENG_CSG_PLUGIN_ALLOW_NETWORK=1 开网, 禁自动探测联网态, 老设计开放
# 问题 #3 裁决继承)。T6 = record→receipt 降格映射 (record 直携进 Store 会
# fork 存储路径, 破坏同构 receipt 无 origin 分叉, 禁并存)。T3 未裁定:
# verify-proof 未联, chain-origin 件不得进正式组合 — 正式构建恒走缺省离线,
# allowNetwork=1 仅限显式演练; verify-proof 必联仍是 S4-C done 条款。
# compilerHash 口径已冻结为 production held-exec 保持打开的编译器文件描述符
# 原始 SHA-256；缺 admission、坏 CID、零哈希一律拒绝，禁止路径/argv/env 猜测。
#
# 缓存布局 (§2.2 冻结, 分片规则镜像 csge_ir_cache):
#   <root>/<pickupCid[:2]>/<pickupCid>.csgplugin         — artifact 字节
#   <root>/<pickupCid[:2]>/<pickupCid>.csgplugin.receipt — receipt 线格式 (§3)
# root = env CHENG_CSG_PLUGIN_CACHE_ROOT (空 = 未配置; 开放问题 #2 默认值未
# 裁定, 本批只认显式配置/显式实参)。工程范式四条硬约束镜像 csge_ir_cache
# 头注: ① env-gate 根目录 ② miss 返回 Err 绝不 fallback ③ hit 二次校验
# 防污染 ④ 空 key 拒收 panic。
#
# 准入组合 (任务书冻结): 写件先过门再落盘 — Store 内部先
# PluginPickupVerifyGates (bind → 字节门 → provenance, 任一失败 panic),
# 绝不带病写缓存; 落盘即可信, 但读件仍逐次过门 — LoadCached 命中后同一
# VerifyGates 全量重跑 (缓存提供可用性, 不提供信任, §4), 另加查询键 ==
# receipt 自指 cid 的二次校验 (镜像 compile_skip_cache contentCid 纪律),
# 不符 panic csg_pickup_cache_key_mismatch。原子落盘 tmp+rename, 镜像
# csge_ir_cache put 配方; receipt 后于 artifact 落盘, 半截条目 (单文件)
# 在 LoadCached 视为 miss, 永不可信。
#
# Err/panic 边界 (§4 不变量): Err 仅表示"确认无件" — root 未配置 / 缓存
# miss / 远端未接线；已存在条目的读取、schema、CID、字节或 provenance 损坏
# 都是缓存污染，直接
# panic, 绝不用 Err 吞校验失败。Acquire 把 LoadCached 的任何 Err 都当"无
# 可用件": allowNetwork=false → FAIL_CLOSED, Err 报文 =
# CsgPluginPickupMissingError = codegen_plugin_missing=<triple>
# installed=[<triple>@<cid>,...]; allowNetwork=true → FetchRemote (S4-C 已
# 接线: not_published 终端事实 / fetch_failed 传输失败) → FAIL_CLOSED 并区
# 分 csg_pickup_fetch_failed (§4 ③)。
# miss 不产生任何 fallback 写。
#
# 已装清单 (InstalledUnits): 列举缓存内合法条目供 fail-closed 报文使用。
# 合法性为非 panic 判定 (报文路径自身不得 panic): 双文件齐备 ∧ Decode Ok ∧
# 文件名 cid == receipt 自指 cid ∧ bind 重算一致 ∧ 字节门 (count+sha256) ∧
# provenance 结构不变量, 任一不合格不列入 (被篡改条目由 Acquire 直查时经
# VerifyGates 硬拒, 清单只反映"可用件"); 字典序排序保证报文确定性。
#
# 参数形态 (stage3 方言铁律, 同 S4-A 头注): 只读 str / rawbytes.Bytes /
# str[] 一律 @borrows 值传不用 var; var 仅留给 artifact 出参与 receipt
# 结构体 (与纯值层 VerifyGates 同形)。设计 §2.2 草案中 Store 的
# artifact: var 按此落为 @borrows 值传 (只读语义), 与 S4-A 对
# ReceiptMake/VerifyGates 的同款裁定一致, 偏差已在交付报告记录。

import std/os
import std/result
import std/strings
import std/rawbytes
import std/system
import cheng/std/bytes_layout as layout
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/target_matrix as tmat
import cheng/core/backend2/backend2_cid as b2cid
import cheng/core/backend2/backend2_plugin_cid as pcid
import cheng/core/csg_core/plugin_trade_record as trade

# ---- §2.2 根目录 (env-gate; 空 = 未配置, 走 fail-closed 判定) ----

fn CsgPluginPickupRoot(): str =
    return os.GetEnv("CHENG_CSG_PLUGIN_CACHE_ROOT")

fn CsgPluginPickupCacheEnabled(): bool =
    return os.GetEnv("CHENG_CSG_PLUGIN_CACHE_ROOT") != ""

# ---- S4-C 链对接 env 面 (全部显式, 禁自动探测联网态/仓库布局) ----

const
    csgPickupChainRootEnv: str = "CHENG_CSG_CHAIN_ROOT"
    csgPickupAllowNetworkEnv: str = "CHENG_CSG_PLUGIN_ALLOW_NETWORK"
    csgPickupManifestEnv: str = "CHENG_CSG_PLUGIN_MANIFEST"
    csgPickupChainRecordExt: str = ".csgtrade"
    csgPickupClosureDomainTag: str = "cheng.backend2.plugin.sourceclosure"
    csgPickupManifestCanonicalKey: str = "plugin_canonical_triple"
    csgPickupManifestSourceSuffix: str = "_source"

# T2 裁定 (设计 §7): allowNetwork 来自显式 env, 缺省离线 = fail-closed。
fn CsgPluginPickupAllowNetwork(): bool =
    return os.GetEnv(csgPickupAllowNetworkEnv) == "1"

# ---- §2.2 缓存路径: <root>/<cid[:2]>/<cid>.csgplugin + 同名 .receipt ----
# S4-C 链条目同分片配方: <chainRoot>/<cid[:2]>/<cid>.csgtrade (+ .csgplugin)

@borrows
fn csgPluginPickupShardedPath(rootDir: str, pickupCidHex: str, ext: str): str =
    if rootDir == "":
        panic("csg_pickup_cache_path_empty_root")
    if pickupCidHex == "":
        panic("csg_pickup_cache_path_empty_cid")
    if len(pickupCidHex) < 2:
        panic("csg_pickup_cache_path_bad_cid")
    let shard = strings.CloneStrRange(pickupCidHex, 0, 2)
    let dir = rootDir + "/" + shard
    return dir + "/" + pickupCidHex + ext

@borrows
fn CsgPluginPickupCachePath(rootDir: str, pickupCidHex: str): str =
    return csgPluginPickupShardedPath(rootDir, pickupCidHex, ".csgplugin")

@borrows
fn CsgPluginPickupReceiptPath(rootDir: str, pickupCidHex: str): str =
    return CsgPluginPickupCachePath(rootDir, pickupCidHex) + ".receipt"

@borrows
fn CsgPluginPickupChainRecordPath(chainRoot: str, queryCidHex: str): str =
    return csgPluginPickupShardedPath(chainRoot, queryCidHex, csgPickupChainRecordExt)

@borrows
fn CsgPluginPickupChainArtifactPath(chainRoot: str, queryCidHex: str): str =
    return csgPluginPickupShardedPath(chainRoot, queryCidHex, ".csgplugin")

# ---- 原子落盘原语 (tmp+rename, 镜像 csge_ir_cache put 配方) ----

@borrows
fn csgPluginPickupWriteAtomic(finalPath: str, data: rawbytes.Bytes): Result[bool] =
    let tmpPath = finalPath + ".tmp"
    if os.FileExists(tmpPath):
        os.RemoveFile(tmpPath)
    var writeRes = os.WriteFileBytesResult(tmpPath, data)
    if IsErr(writeRes):
        os.RemoveFile(tmpPath)
        return Err[bool]("csg_pickup_cache_store_tmp_write_failed path=" + finalPath)
    if !os.FileExists(tmpPath):
        return Err[bool]("csg_pickup_cache_store_tmp_missing path=" + finalPath)
    if os.RenameFile(tmpPath, finalPath):
        return Ok[bool](true)
    # rename 失败但目标已在 = 内容寻址下并发写同件, 视为成功 (csge 同款)
    if os.FileExists(finalPath):
        os.RemoveFile(tmpPath)
        return Ok[bool](true)
    os.RemoveFile(tmpPath)
    return Err[bool]("csg_pickup_cache_store_rename_failed path=" + finalPath)

# ---- §2.2 LoadCached: miss=Err 绝不 fallback; hit=Decode+键二次校验+全门 ----

@borrows
fn CsgPluginPickupLoadCached(
        rootDir: str, queryCidHex: str,
        artifact: var rawbytes.Bytes): Result[pcid.PluginPickupReceipt] =
    if queryCidHex == "":
        panic("csg_pickup_cache_load_empty_cid")
    if rootDir == "":
        return Err[pcid.PluginPickupReceipt]("csg_pickup_cache_root_unconfigured")
    let artifactPath = CsgPluginPickupCachePath(rootDir, queryCidHex)
    let receiptPath = artifactPath + ".receipt"
    if !os.FileExists(artifactPath) || !os.FileExists(receiptPath):
        return Err[pcid.PluginPickupReceipt]("csg_pickup_cache_miss cid=" + queryCidHex)
    var receiptRead = os.ReadFileBytesResult(receiptPath)
    if IsErr(receiptRead):
        return Err[pcid.PluginPickupReceipt]("csg_pickup_cache_read_failed cid=" + queryCidHex)
    var receiptBytes = Value(receiptRead)
    var dec = pcid.PluginPickupReceiptDecode(receiptBytes)
    rawbytes.BytesFree(receiptBytes)
    if IsErr(dec):
        panic(Fmt"csg_pickup_cache_entry_corrupt cid={queryCidHex} reason={Error(dec)}")
    var receipt = Value(dec)
    # 命中后二次校验 (门③): 查询键必须等于 receipt 自指 cid, 防分片目录被
    # 外部污染时静默张冠李戴; 这是污染信号不是 miss, 硬崩不 Err。
    if receipt.pickupCidHex != queryCidHex:
        panic(Fmt"csg_pickup_cache_key_mismatch cid={queryCidHex} receiptCid={receipt.pickupCidHex}")
    var artifactRead = os.ReadFileBytesResult(artifactPath)
    if IsErr(artifactRead):
        return Err[pcid.PluginPickupReceipt]("csg_pickup_cache_read_failed cid=" + queryCidHex)
    var artifactBytes = Value(artifactRead)
    # 缓存命中不免除任何门 (§4): bind → 字节门 → provenance, 任一失败 panic。
    pcid.PluginPickupVerifyGates(artifactBytes, receipt)
    artifact = artifactBytes
    return Ok[pcid.PluginPickupReceipt](receipt)

# ---- §2.3/§2.4 FetchRemote: S4-C 链对接 (签名与 Err 语义保持 S4-B 冻结形) ----
# Err 仅两类 (§2.4): csg_pickup_not_published (链查无此 cid, 终端事实) /
# csg_pickup_fetch_failed reason=<transport 细节>。一切校验失败 panic
# (record 损坏 = csg_pickup_trade_record_corrupt; 互证不等 =
# csg_pickup_trade_receipt_bind_mismatch), 绝不伪装成 fetch Err。

@borrows
fn CsgPluginPickupFetchRemote(
        queryCidHex: str,
        artifact: var rawbytes.Bytes): Result[pcid.PluginPickupReceipt] =
    let chainRoot = os.GetEnv(csgPickupChainRootEnv)
    if chainRoot == "":
        return Err[pcid.PluginPickupReceipt](
            "csg_pickup_fetch_failed cid=" + queryCidHex +
            " reason=csg_pickup_fetch_chain_root_unconfigured")
    let recordPath = CsgPluginPickupChainRecordPath(chainRoot, queryCidHex)
    let artifactPath = CsgPluginPickupChainArtifactPath(chainRoot, queryCidHex)
    if !os.FileExists(recordPath) || !os.FileExists(artifactPath):
        # 链查无此 cid: 确认无件的终端事实, 非降级信号
        return Err[pcid.PluginPickupReceipt](
            "csg_pickup_not_published cid=" + queryCidHex)
    var recordRead = os.ReadFileBytesResult(recordPath)
    if IsErr(recordRead):
        return Err[pcid.PluginPickupReceipt](
            "csg_pickup_fetch_failed cid=" + queryCidHex +
            " reason=csg_pickup_fetch_chain_record_read_failed")
    var recordBytes = Value(recordRead)
    var dec = trade.ChengPluginTradeRecordDecode(recordBytes)
    rawbytes.BytesFree(recordBytes)
    if IsErr(dec):
        # 链上对象结构性损坏 = 校验失败, 不伪装成 fetch Err (§2.4)
        panic(Fmt"csg_pickup_trade_record_corrupt cid={queryCidHex} reason={Error(dec)}")
    var record = Value(dec)
    var artifactRead = os.ReadFileBytesResult(artifactPath)
    if IsErr(artifactRead):
        return Err[pcid.PluginPickupReceipt](
            "csg_pickup_fetch_failed cid=" + queryCidHex +
            " reason=csg_pickup_fetch_chain_artifact_read_failed")
    var chainArtifact = Value(artifactRead)
    # T6 降格映射: record→chain-origin receipt + 三方相等硬闸; 全门在
    # Acquire ⑤ VerifyGates/Store 同一份, 此处不重复跑门
    var receipt = trade.ChengPluginTradeRecordDemoteToReceipt(record, chainArtifact)
    artifact = chainArtifact
    return Ok[pcid.PluginPickupReceipt](receipt)

# ---- §2.2 Store: 先过门再落盘 (VerifyGates 任一失败 panic, 绝不带病写) ----

@borrows
fn CsgPluginPickupStore(
        rootDir: str, receipt: var pcid.PluginPickupReceipt,
        artifact: rawbytes.Bytes): Result[bool] =
    if rootDir == "":
        return Err[bool]("csg_pickup_cache_root_unconfigured")
    pcid.PluginPickupVerifyGates(artifact, receipt)
    let artifactPath = CsgPluginPickupCachePath(rootDir, receipt.pickupCidHex)
    let shard = strings.CloneStrRange(receipt.pickupCidHex, 0, 2)
    os.MkdirAll(rootDir + "/" + shard, 493)
    var artRes = csgPluginPickupWriteAtomic(artifactPath, artifact)
    if IsErr(artRes):
        return Err[bool](Error(artRes))
    var enc = pcid.PluginPickupReceiptEncode(receipt)
    var recRes = csgPluginPickupWriteAtomic(artifactPath + ".receipt", enc)
    rawbytes.BytesFree(enc)
    if IsErr(recRes):
        # 回滚 artifact: 条目必须双文件齐备才命中, 显式清理不留孤儿
        os.RemoveFile(artifactPath)
        return Err[bool](Error(recRes))
    return Ok[bool](true)

# ---- 已装清单: 非 panic 合法性判定 (报文路径自身不得 panic) ----

@borrows
fn csgPluginPickupEntryLabel(rootDir: str, cid: str): Result[str] =
    let artifactPath = CsgPluginPickupCachePath(rootDir, cid)
    let receiptPath = artifactPath + ".receipt"
    if !os.FileExists(artifactPath) || !os.FileExists(receiptPath):
        return Err[str]("incomplete")
    var receiptRead = os.ReadFileBytesResult(receiptPath)
    if IsErr(receiptRead):
        return Err[str]("unreadable")
    var receiptBytes = Value(receiptRead)
    var dec = pcid.PluginPickupReceiptDecode(receiptBytes)
    rawbytes.BytesFree(receiptBytes)
    if IsErr(dec):
        return Err[str]("corrupt")
    var receipt = Value(dec)
    if receipt.pickupCidHex != cid:
        return Err[str]("key_mismatch")
    let recomputed = pcid.Backend2ComputePluginPickupCid(
        receipt.sourceClosureHash, receipt.compilerHash,
        receipt.targetTriple, receipt.contractVersion)
    if recomputed != cid:
        return Err[str]("bind_mismatch")
    var artifactRead = os.ReadFileBytesResult(artifactPath)
    if IsErr(artifactRead):
        return Err[str]("unreadable")
    var artifactBytes = Value(artifactRead)
    if rawbytes.BytesLen(artifactBytes) != receipt.artifactByteCount:
        rawbytes.BytesFree(artifactBytes)
        return Err[str]("byte_count")
    let actualSha = pcid.Backend2ContentSha256OfBytes(artifactBytes)
    rawbytes.BytesFree(artifactBytes)
    if !layout.FixedBytes32Equal(actualSha, receipt.artifactSha256):
        return Err[str]("byte_gate")
    if receipt.origin == pcid.PluginPickupOriginLocal:
        if receipt.provenanceSignerId != "local":
            return Err[str]("provenance")
        if !layout.FixedBytes32Equal(receipt.provenanceProofCid, receipt.artifactSha256):
            return Err[str]("provenance")
    elif receipt.origin == pcid.PluginPickupOriginChain:
        if len(receipt.provenanceSignerId) == 0:
            return Err[str]("provenance")
        if b2cid.Backend2CidFixed32IsZero(receipt.provenanceProofCid):
            return Err[str]("provenance")
    else:
        return Err[str]("provenance")
    return Ok[str](receipt.targetTriple + "@" + cid)

@borrows
fn CsgPluginPickupInstalledUnits(rootDir: str): str[] =
    var out: str[]
    if rootDir == "" || !os.DirExists(rootDir):
        return out
    let shards = os.ListDir(rootDir)
    for i in 0..<shards.len:
        let shardDir = rootDir + "/" + shards[i]
        if !os.DirExists(shardDir):
            continue
        let files = os.ListDir(shardDir)
        for j in 0..<files.len:
            if !strings.HasSuffix(files[j], ".csgplugin"):
                continue
            let cid = strings.CloneStrRange(
                files[j], 0, len(files[j]) - len(".csgplugin"))
            if len(cid) != 64:
                continue
            var labelRes = csgPluginPickupEntryLabel(rootDir, cid)
            if IsErr(labelRes):
                continue
            let label = Value(labelRes)
            add(out, label)
    return b2cid.Backend2SortStrings(out)

# ---- §2.2 MissingError: codegen_plugin_missing 规范报文 (S4-D 与契约对齐) ----
# 契约 CodegenPluginMissingError 已落位 (codegen_contract.cheng S4-D 节, 原
# TODO(step1-wiring) 签名): 非空清单本层直接委托契约构造函数, 两侧同函数
# 同字节; 空清单本层保留 S4-B 冻结的显式 installed=[] 形态 (契约空清单只
# 给基形 codegen_plugin_missing=<triple>, 与脚本级门禁逐字一致; 空清单两
# 侧形态差异留档 S4-D 交付报告)。

@borrows
fn CsgPluginPickupMissingError(targetTriple: str, installedUnits: str[]): str =
    if installedUnits.len == 0:
        return "codegen_plugin_missing=" + targetTriple + " installed=[]"
    return contract.CodegenPluginMissingError(targetTriple, installedUnits)

# ---- §2.2/§4 Acquire: 状态机唯一入口; Err 仅表示"确认无件" ----

@borrows
fn CsgPluginPickupAcquire(
        rootDir: str, allowNetwork: bool,
        sourceClosureHash: layout.FixedBytes32,
        compilerHash: layout.FixedBytes32,
        targetTriple: str,
        contractVersion: int32,
        artifact: var rawbytes.Bytes): Result[pcid.PluginPickupReceipt] =
    # ① 构造期守卫 (§1): 空 triple / version<1 → panic
    let queryCid = pcid.Backend2ComputePluginPickupCid(
        sourceClosureHash, compilerHash, targetTriple, contractVersion)
    # ② CacheProbe: hit 已经全门 (LoadCached 内 VerifyGates), 不免除任何门
    var loadRes = CsgPluginPickupLoadCached(rootDir, queryCid, artifact)
    if !IsErr(loadRes):
        return loadRes
    # ③ 远端取件 (S4-C 未接线必 Err): 网络失败是终端错误非降级信号
    if allowNetwork:
        var fetchRes = CsgPluginPickupFetchRemote(queryCid, artifact)
        if !IsErr(fetchRes):
            var receipt = Value(fetchRes)
            pcid.PluginPickupVerifyGates(artifact, receipt)
            var storeRes = CsgPluginPickupStore(rootDir, receipt, artifact)
            if IsErr(storeRes):
                return Err[pcid.PluginPickupReceipt](Error(storeRes))
            return Ok[pcid.PluginPickupReceipt](receipt)
        let installedOnline = CsgPluginPickupInstalledUnits(rootDir)
        let detail = "csg_pickup_fetch_failed cid=" + queryCid +
            " reason=" + Error(fetchRes)
        let reportOnline = CsgPluginPickupMissingError(targetTriple, installedOnline)
        return Err[pcid.PluginPickupReceipt](detail + " " + reportOnline)
    # ④ FAIL_CLOSED: 报文含已装清单; 无任何带病降级, 无 fallback 写
    let installed = CsgPluginPickupInstalledUnits(rootDir)
    return Err[pcid.PluginPickupReceipt](
        CsgPluginPickupMissingError(targetTriple, installed))

# ---- §5.1 sourceClosureHash 单一派生器 (发布方与组合根共用, 禁两份实现) ----
# 配方冻结: 域标签 cheng.backend2.plugin.sourceclosure + 字典序源集 (b2cid
# append 族 Texts = U32LE count + 逐项) → sha256。manifest 只声明事实 (triple
# + 源集), 不钉 CID 字面量; 组合根每次现场重派生, 禁读上次指纹缓存 (R2)。

@borrows
fn CsgPluginPickupDeriveSourceClosureHash(sourceUnits: str[]): layout.FixedBytes32 =
    if sourceUnits.len == 0:
        panic("csg_pickup_closure_empty_source_set")
    var sorted = b2cid.Backend2SortStrings(sourceUnits)
    var buf: layout.ByteBuf = layout.ByteBufInit(1024)
    b2cid.Backend2CidAppendText(buf, csgPickupClosureDomainTag)
    b2cid.Backend2CidAppendTexts(buf, sorted)
    return b2cid.Backend2CidBufSha256(buf)

# 组合根现场派生: 读 manifest (plugin_canonical_triple 权威互证 + *_source
# 源集收集) → 闭包哈希。manifest 路径 = 显式 env (CHENG_CSG_PLUGIN_MANIFEST),
# 禁自动探测仓库布局。
@borrows
fn CsgPluginPickupClosureHashForTriple(targetTriple: str): Result[layout.FixedBytes32] =
    if targetTriple == "":
        return Err[layout.FixedBytes32]("csg_pickup_compose_empty_target_triple")
    let manifestPath = os.GetEnv(csgPickupManifestEnv)
    if manifestPath == "":
        return Err[layout.FixedBytes32](
            "csg_pickup_manifest_unconfigured triple=" + targetTriple)
    if !os.FileExists(manifestPath):
        return Err[layout.FixedBytes32](
            "csg_pickup_manifest_missing path=" + manifestPath)
    var readRes = os.ReadFileBytesResult(manifestPath)
    if IsErr(readRes):
        return Err[layout.FixedBytes32](
            "csg_pickup_manifest_read_failed path=" + manifestPath)
    var manifestBytes = Value(readRes)
    let text = rawbytes.BytesToString(manifestBytes)
    rawbytes.BytesFree(manifestBytes)
    var canonical = ""
    var units: str[]
    let total = len(text)
    var lineStart = 0
    while lineStart < total:
        var lineEnd = lineStart
        while lineEnd < total && text[lineEnd] != '\n':
            lineEnd = lineEnd + 1
        # 剥 '#' 行内注释
        var contentEnd = lineEnd
        var hashFound = false
        var k = lineStart
        while k < lineEnd && !hashFound:
            if text[k] == '#':
                contentEnd = k
                hashFound = true
            k = k + 1
        # 两端去空白
        var head = lineStart
        while head < contentEnd && (text[head] == ' ' || text[head] == '\t' || text[head] == '\r'):
            head = head + 1
        var tail = contentEnd
        while tail > head && (text[tail - 1] == ' ' || text[tail - 1] == '\t' || text[tail - 1] == '\r'):
            tail = tail - 1
        if tail > head:
            let line = strings.CloneStrRange(text, head, tail - head)
            # 首个 '=' 切 key/value; 两侧 key/value 各自去空白 (gate python 同款)
            var eq = -1
            for i in 0..<len(line):
                if line[i] == '=' && eq < 0:
                    eq = i
            if eq < 0:
                return Err[layout.FixedBytes32](
                    "csg_pickup_manifest_bad_line path=" + manifestPath)
            var ks = 0
            while ks < eq && (line[ks] == ' ' || line[ks] == '\t'):
                ks = ks + 1
            var ke = eq
            while ke > ks && (line[ke - 1] == ' ' || line[ke - 1] == '\t'):
                ke = ke - 1
            var vs = eq + 1
            while vs < len(line) && (line[vs] == ' ' || line[vs] == '\t'):
                vs = vs + 1
            var ve = len(line)
            while ve > vs && (line[ve - 1] == ' ' || line[ve - 1] == '\t'):
                ve = ve - 1
            if ke <= ks || ve <= vs:
                return Err[layout.FixedBytes32](
                    "csg_pickup_manifest_bad_line path=" + manifestPath)
            let key = strings.CloneStrRange(line, ks, ke - ks)
            let value = strings.CloneStrRange(line, vs, ve - vs)
            if key == csgPickupManifestCanonicalKey:
                canonical = value
            elif strings.HasSuffix(key, csgPickupManifestSourceSuffix):
                add(units, value)
        lineStart = lineEnd + 1
    if canonical == "":
        return Err[layout.FixedBytes32](
            "csg_pickup_manifest_canonical_missing path=" + manifestPath)
    if canonical != targetTriple:
        return Err[layout.FixedBytes32](
            "csg_pickup_manifest_triple_mismatch manifest=" + canonical +
            " query=" + targetTriple)
    if units.len == 0:
        return Err[layout.FixedBytes32](
            "csg_pickup_manifest_no_source_units path=" + manifestPath)
    return Ok[layout.FixedBytes32](CsgPluginPickupDeriveSourceClosureHash(units))

# ---- §3.2 本地构建腿: 与链上取件同构 receipt (10 字段集, 无 origin 分叉) ----
# artifact 由调用方经 D1 源编译组合产出 (零 dlopen); 本函数做 ② closure 派生
# (与链上发布方共享同一实现) → ③ 同构 receipt (Make 内强制 signer="local" ∧
# proofCid=artifactSha256 自证) → ④ Store (先过门再落盘) — VerifyGates 与链
# 件完全同一份 (⑤)。验收: 两路 receipt 仅 origin/signer/proofCid 三字段允许
# 不同, 组合产物字节相等 (设计 §3.2)。

@borrows
fn CsgPluginPickupLocalBuildCompose(
        rootDir: str, compilerHash: layout.FixedBytes32, targetTriple: str,
        artifact: rawbytes.Bytes): Result[pcid.PluginPickupReceipt] =
    if rootDir == "":
        return Err[pcid.PluginPickupReceipt]("csg_pickup_cache_root_unconfigured")
    var closureRes = CsgPluginPickupClosureHashForTriple(targetTriple)
    if IsErr(closureRes):
        return Err[pcid.PluginPickupReceipt](Error(closureRes))
    let closure = Value(closureRes)
    var receipt = pcid.PluginPickupReceiptMake(
        pcid.PluginPickupOriginLocal,
        closure, compilerHash,
        targetTriple, contract.CodegenContractVersion,
        artifact, "local", layout.FixedBytes32())
    var storeRes = CsgPluginPickupStore(rootDir, receipt, artifact)
    if IsErr(storeRes):
        return Err[pcid.PluginPickupReceipt](Error(storeRes))
    return Ok[pcid.PluginPickupReceipt](receipt)

# 编译器身份只来自 production held-exec 已导入并持续保持的 executable fd。
# RuntimeHeldExecChildExecutableCid 的 bridge 在无 admission 时返回空串；此处再
# 检查 admission、canonical sha256 文本及非零值，避免任何 caller-controlled
# 路径或环境变量成为 compilerHash 权威。
fn CsgPluginPickupCurrentCompilerHash(): Result[layout.FixedBytes32] =
    if !system.RuntimeHeldExecChildAdmissionActive():
        return Err[layout.FixedBytes32](
            "csg_pickup_compiler_identity_admission_missing")
    let executableCid = system.RuntimeHeldExecChildExecutableCid()
    if len(executableCid) != 71 ||
       !strings.HasPrefix(executableCid, "sha256:"):
        return Err[layout.FixedBytes32](
            "csg_pickup_compiler_identity_invalid")
    let compilerHex = strings.CloneStrRange(executableCid, 7, 64)
    var parsed = layout.FixedBytes32FromHex(compilerHex)
    if IsErr(parsed):
        return Err[layout.FixedBytes32](
            "csg_pickup_compiler_identity_invalid")
    let compilerHash = Value(parsed)
    if b2cid.Backend2CidFixed32IsZero(compilerHash) ||
       layout.FixedBytes32Hex(compilerHash) != compilerHex:
        return Err[layout.FixedBytes32](
            "csg_pickup_compiler_identity_invalid")
    return Ok[layout.FixedBytes32](compilerHash)

# ---- §1.3 S4-D 组合准入包装: 消费点唯一定理下的组合入口 ----
# 仓库内插件对象获取只允许经 CsgPluginPickupAcquire 一个入口。
# 收口实况订正（2026-08-29 实测）：direct_object_emit 三处未命中臂**未**经本
# 包装——其只直调 contract.CodegenPluginMissingError，全文件零 pickup 引用
# （grep 证），本头注原「已由 S4-D 收口」表述名实不符，此处如实更正为「报文
# 形一致、未走本包装」。
# primary_object_plan 两处 body 发射未命中 panic 臂：已接线 2026-08-29（案 A
# 报文收敛最小案，见 cheng-patches/step4-final-20260829/CLOSEOUT-MANUAL.md §3）
# ——未命中先经本包装取件（Ok 即件过字节门入 store），再按 D1 编译期组合铁律
# 抛 contract.CodegenPluginMissingError；案 B（取件后续发）待下游插件分派面
# 就绪，禁第三案。
@borrows
fn CodegenCompositionAcquireArtifactForTriple(
        targetTriple: str,
        artifact: var rawbytes.Bytes): Result[pcid.PluginPickupReceipt] =
    # ① tmat 权威校验 triple 非空合法 (禁本层自造 triple 表)
    if targetTriple == "":
        return Err[pcid.PluginPickupReceipt]("csg_pickup_compose_empty_target_triple")
    if tmat.TargetPrimaryObjectFormat(strings.CloneStr(targetTriple)) == "unknown":
        return Err[pcid.PluginPickupReceipt](
            "csg_pickup_compose_unknown_target_triple triple=" + targetTriple)
    # ② sourceClosureHash ← 组合根按 manifest 源集现场派生 (§5.1)
    var closureRes = CsgPluginPickupClosureHashForTriple(strings.CloneStr(targetTriple))
    if IsErr(closureRes):
        return Err[pcid.PluginPickupReceipt](Error(closureRes))
    let closure = Value(closureRes)
    # ③ compilerHash ← production held-exec 的 retained executable fd 原始 SHA-256
    var compilerHashRes = CsgPluginPickupCurrentCompilerHash()
    if IsErr(compilerHashRes):
        return Err[pcid.PluginPickupReceipt](Error(compilerHashRes))
    let compilerHash = Value(compilerHashRes)
    # ④ contractVersion ← contract.CodegenContractVersion (import 引用, 禁硬编码)
    # ⑤ Acquire → 任一 Err 上抛 fail-closed 报文, 无 fallback
    return CsgPluginPickupAcquire(
        CsgPluginPickupRoot(), CsgPluginPickupAllowNetwork(),
        closure, compilerHash,
        strings.CloneStr(targetTriple), contract.CodegenContractVersion, artifact)
