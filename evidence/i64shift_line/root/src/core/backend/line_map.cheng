import std/result
import std/os
import std/rawbytes
import std/strings
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/backend/debug_facts as debug
import cheng/core/backend/debug_emission_receipt as receipt
import cheng/core/backend/debug_emission_plan_evidence as planevidence
import cheng/core/backend/semantic_snapshot_debug_binding_receipt as bindingreceipt
import cheng/core/ir/core_types as coreir
import cheng/core/tooling/path as chengpath

const
    LineMapPcNotFoundNone = 0
    LineMapPcNotFoundWrongSection = 1
    LineMapPcNotFoundOutsideText = 2
    LineMapPcNotFoundGap = 3
    LineMapPcNotFoundMissingDebugOp = 4

type
    LineMapPcQuery =
        objectSectionIndex: int32 = -1
        loadedTextSectionAddress: int64
        crashPc: int64
        objectFileByteOffset: int32 = -1
        expectedFunctionId: int32 = -1
        expectedObjectSymbolTableIndex: int32 = -1

    LineMapPcLookup =
        found: bool
        notFoundKind: int32
        backendKind: str
        sourceVersion: int64
        bindingReceiptCid: layout.FixedBytes32
        semanticSnapshotCid: layout.FixedBytes32
        csgRootCid: layout.FixedBytes32
        objectCid: layout.FixedBytes32
        objectStructureCid: layout.FixedBytes32
        relocationTableFileOffset: int32 = -1
        relocationCount: int32
        objectSectionIndex: int32 = -1
        loadedTextSectionAddress: int64
        crashPc: int64
        textSectionRelativeByteOffset: int32 = -1
        objectFileByteOffset: int32 = -1
        functionId: int32 = -1
        functionSymbolId: int32 = -1
        functionDeclId: int32 = -1
        functionDeclKeyCid: layout.FixedBytes32
        functionSymbolCid: layout.FixedBytes32
        objectSymbolTableIndex: int32 = -1
        debugOpId: int32 = -1
        fragmentByteStart: int32 = -1
        fragmentByteLength: int32
        fragmentBytesCid: layout.FixedBytes32
        typedNodeId: int32 = -1
        typedIrNodeIndex: int32 = -1
        referencedSymbolId: int32 = -1
        referencedDeclId: int32 = -1
        referencedDeclKeyCid: layout.FixedBytes32
        referencedSymbolCid: layout.FixedBytes32
        sourceId: int32 = -1
        spanId: int32 = -1
        documentCid: layout.FixedBytes32
        modulePath: str
        startLine: int32 = -1
        startColumn: int32 = -1
        endLine: int32 = -1
        endColumn: int32 = -1

@borrows
fn LineMapPathForOutput(outputPath: str): str =
    if len(outputPath) <= 0:
        return ""
    return strutil.Join([share(outputPath), ".map"], "")

fn lineMapCidEqual(left: layout.FixedBytes32,
                   right: layout.FixedBytes32): bool =
    return layout.FixedBytes32Equal(left, right)

fn lineMapCidObserved(value: layout.FixedBytes32): bool =
    return !lineMapCidEqual(value, layout.FixedBytes32())

@borrows
fn lineMapAppendField(line: var str, key: str, value: str) =
    line = strutil.Join([strings.CloneStr(line), "\t", share(key), "=", share(value)], "")

@borrows
fn lineMapAppendHeader(out: var str, key: str, value: str) =
    out = strutil.Join([strings.CloneStr(out), share(key), "=", share(value), "\n"], "")

@borrows
fn lineMapAppendCidHeader(out: var str,
                          key: str,
                          value: layout.FixedBytes32) =
    lineMapAppendHeader(out, key, layout.FixedBytes32Hex(value))

@borrows
fn lineMapAppendCidField(line: var str,
                         key: str,
                         value: layout.FixedBytes32) =
    lineMapAppendField(line, key, layout.FixedBytes32Hex(value))

@borrows
fn lineMapReceiptIdentityValidInto(
        objectReceipt: receipt.DebugObjectEmissionReceipt,
        facts: debug.DebugFactBundle,
        err: var str): bool =
    if !objectReceipt.valid:
        err = " line map: unvalidated debug object receipt"
        return false
    if !debug.DebugFactBundleStrictValidateInto(facts, err):
        return false
    if objectReceipt.sourceVersion != facts.sourceVersion ||
       objectReceipt.packageId != facts.packageId ||
       !lineMapCidEqual(
           objectReceipt.bindingReceiptCid, facts.bindingReceiptCid) ||
       !lineMapCidEqual(
           objectReceipt.semanticSnapshotCid, facts.semanticSnapshotCid) ||
       !lineMapCidEqual(objectReceipt.worldHeadCid, facts.worldHeadCid) ||
       !lineMapCidEqual(objectReceipt.compilerCid, facts.compilerCid) ||
       !lineMapCidEqual(
           objectReceipt.sourceBundleCid, facts.sourceBundleCid) ||
       !lineMapCidEqual(objectReceipt.csgRootCid, facts.csgRootCid) ||
       !lineMapCidEqual(
           objectReceipt.validationReceiptCid,
           facts.validationReceiptCid) ||
       !lineMapCidEqual(
           objectReceipt.debugProjectionCid, facts.projectionCid) ||
       !lineMapCidEqual(
           objectReceipt.declarationTableCid,
           facts.declarationTableCid) ||
       !lineMapCidEqual(
           objectReceipt.declarationIdentityCid,
           facts.declarationIdentityCid):
        err = " line map: DebugFacts/object receipt identity mismatch"
        return false
    if !lineMapCidObserved(objectReceipt.objectCid) ||
       !lineMapCidObserved(objectReceipt.objectStructureCid) ||
       !lineMapCidObserved(objectReceipt.debugMapCid) ||
       objectReceipt.textSectionIndex < 0 ||
       objectReceipt.textSectionFileOffset <= 0 ||
       objectReceipt.textSectionByteLength <= 0 ||
       objectReceipt.objectByteLength <= 0 ||
       objectReceipt.textSectionFileOffset >
           objectReceipt.objectByteLength -
               objectReceipt.textSectionByteLength ||
       objectReceipt.functions.len <= 0 ||
       objectReceipt.rows.len <= 0:
        err = " line map: invalid object receipt range identity"
        return false
    return true

@borrows
fn lineMapFunctionFactInto(
        facts: debug.DebugFactBundle,
        functionId: int32,
        out: var debug.DebugFunctionFact,
        err: var str): bool =
    out = debug.DebugFunctionFact()
    if functionId < 0 || functionId >= facts.functionCount ||
       functionId >= facts.facts.len:
        err = " line map: FunctionId out of range"
        return false
    let fact = facts.facts[functionId]
    if fact.kind != debug.DebugFactKindFunction ||
       fact.functionFact.functionId != functionId:
        err = " line map: non-canonical FunctionId row"
        return false
    out = fact.functionFact
    return true

@borrows
fn lineMapOperationFactInto(
        facts: debug.DebugFactBundle,
        debugOpId: int32,
        out: var debug.DebugOperationFact,
        err: var str): bool =
    out = debug.DebugOperationFact()
    if debugOpId < 0 || debugOpId >= facts.debugOpCount:
        err = " line map: DebugOpId out of range"
        return false
    let factIndex = facts.functionCount + debugOpId
    if factIndex < 0 || factIndex >= facts.facts.len:
        err = " line map: DebugOpId row out of range"
        return false
    let fact = facts.facts[factIndex]
    if fact.kind != debug.DebugFactKindOperation ||
       fact.operationFact.debugOpId != debugOpId:
        err = " line map: non-canonical DebugOpId row"
        return false
    out = fact.operationFact
    return true

@borrows
fn lineMapFunctionIdentityValid(
        row: receipt.DebugObjectEmissionFunctionRow,
        fact: debug.DebugFunctionFact): bool =
    return row.functionId == fact.functionId &&
           row.functionDeclId == fact.declId &&
           row.functionSymbolId == fact.symbolId &&
           lineMapCidEqual(row.functionDeclKeyCid, fact.declKeyCid) &&
           lineMapCidEqual(row.functionSymbolCid, fact.symbolCid)

@borrows
fn lineMapFunctionRangeValid(
        objectReceipt: receipt.DebugObjectEmissionReceipt,
        row: receipt.DebugObjectEmissionFunctionRow): bool =
    if row.objectSectionIndex != objectReceipt.textSectionIndex ||
       row.symbolByteStart < 0 || row.symbolByteLength <= 0 ||
       row.symbolByteStart >
           objectReceipt.textSectionByteLength - row.symbolByteLength ||
       row.objectFileByteStart !=
           objectReceipt.textSectionFileOffset + row.symbolByteStart ||
       row.objectFileByteStart < 0 ||
       row.objectFileByteStart >
           objectReceipt.objectByteLength - row.symbolByteLength ||
       !lineMapCidObserved(row.symbolBytesCid):
        return false
    return true

@borrows
fn lineMapEmissionRowRangeValid(
        objectReceipt: receipt.DebugObjectEmissionReceipt,
        functionRow: receipt.DebugObjectEmissionFunctionRow,
        row: receipt.DebugEmissionRow): bool =
    if row.sectionIndex != objectReceipt.textSectionIndex ||
       row.byteLength <= 0 ||
       row.textSectionRelativeByteStart < functionRow.symbolByteStart ||
       row.textSectionRelativeByteStart >
           functionRow.symbolByteStart + functionRow.symbolByteLength -
               row.byteLength ||
       row.textSectionRelativeByteStart >
           objectReceipt.textSectionByteLength - row.byteLength ||
       row.objectFileByteStart !=
           objectReceipt.textSectionFileOffset +
               row.textSectionRelativeByteStart ||
       row.objectFileByteStart < functionRow.objectFileByteStart ||
       row.objectFileByteStart >
           functionRow.objectFileByteStart + functionRow.symbolByteLength -
               row.byteLength ||
       row.objectFileByteStart >
           objectReceipt.objectByteLength - row.byteLength ||
       !lineMapCidObserved(row.bytesCid):
        return false
    return true

@borrows
fn lineMapEmissionRowIdentityValid(
        row: receipt.DebugEmissionRow,
        functionRow: receipt.DebugObjectEmissionFunctionRow): bool =
    return row.functionId == functionRow.functionId &&
           row.functionDeclId == functionRow.functionDeclId &&
           row.functionSymbolId == functionRow.functionSymbolId &&
           lineMapCidEqual(
               row.functionDeclKeyCid,
               functionRow.functionDeclKeyCid) &&
           lineMapCidEqual(
               row.functionSymbolCid,
               functionRow.functionSymbolCid)

@borrows
fn lineMapExactOperationIdentityValid(
        row: receipt.DebugEmissionRow,
        operation: debug.DebugOperationFact): bool =
    return row.debugSyntheticKind == coreir.BodyDebugSyntheticNone &&
           row.functionId == operation.functionId &&
           row.functionDeclId == operation.functionDeclId &&
           row.functionSymbolId == operation.functionSymbolId &&
           lineMapCidEqual(
               row.functionDeclKeyCid,
               operation.functionDeclKeyCid) &&
           lineMapCidEqual(
               row.functionSymbolCid,
               operation.functionSymbolCid) &&
           row.typedNodeId == operation.typedNodeId &&
           row.typedIrNodeIndex == operation.typedIrNodeIndex &&
           row.originParserNodeId == operation.originParserNodeId &&
           row.typedSyntheticOriginKind ==
               operation.syntheticOriginKind &&
           row.typedSpanAuthorityKind == operation.spanAuthorityKind &&
           row.sourceId == operation.sourceId &&
           row.spanId == operation.spanId

@borrows
fn lineMapSyntheticOperationIdentityValid(
        row: receipt.DebugEmissionRow): bool =
    return row.debugOpId < 0 &&
           row.debugSyntheticKind >= coreir.BodyDebugSyntheticCleanup &&
           row.debugSyntheticKind <= coreir.BodyDebugSyntheticRuntime

@borrows
fn lineMapExactRangeTopologyValidInto(
        objectReceipt: receipt.DebugObjectEmissionReceipt,
        err: var str): bool =
    var rowCursor: int32
    var previousFunctionEnd: int32 = -1
    for functionIndex in 0..<objectReceipt.functions.len:
        let functionRow = objectReceipt.functions[functionIndex]
        if functionRow.rowStart != rowCursor ||
           functionRow.rowCount <= 0 ||
           functionRow.rowStart < 0 ||
           functionRow.rowStart >
               objectReceipt.rows.len - functionRow.rowCount ||
           functionRow.symbolByteStart < 0 ||
           functionRow.symbolByteLength <= 0 ||
           (previousFunctionEnd >= 0 &&
            functionRow.symbolByteStart < previousFunctionEnd):
            err = " line map: overlapping or non-canonical function ranges"
            return false
        let functionEnd =
            functionRow.symbolByteStart + functionRow.symbolByteLength
        var previousFragmentEnd = functionRow.symbolByteStart
        for rowOffset in 0..<functionRow.rowCount:
            let row = objectReceipt.rows[
                functionRow.rowStart + rowOffset]
            if row.functionId != functionRow.functionId ||
               row.textSectionRelativeByteStart < previousFragmentEnd ||
               row.byteLength <= 0 ||
               row.textSectionRelativeByteStart >
                   functionEnd - row.byteLength:
                err = " line map: overlapping or cross-function fragment ranges"
                return false
            previousFragmentEnd =
                row.textSectionRelativeByteStart + row.byteLength
        rowCursor = functionRow.rowStart + functionRow.rowCount
        previousFunctionEnd = functionEnd
    if rowCursor != objectReceipt.rows.len:
        err = " line map: incomplete fragment range coverage"
        return false
    err = ""
    return true

@borrows
fn lineMapPcLookupIdentityInto(
        facts: debug.DebugFactBundle,
        functionRow: receipt.DebugObjectEmissionFunctionRow,
        emissionRow: receipt.DebugEmissionRow,
        out: var LineMapPcLookup,
        err: var str): bool =
    var functionFact: debug.DebugFunctionFact
    if !debug.DebugFactBundleExactFunctionInto(
           facts, functionRow.functionId, functionFact, err) ||
       !lineMapFunctionIdentityValid(functionRow, functionFact):
        if err == "":
            err = " line map pc: FunctionId/SymbolId/DeclId join mismatch"
        return false
    var functionSymbol: debug.DebugSymbolFact
    if !debug.DebugFactBundleExactSymbolInto(
           facts, functionRow.functionSymbolId, functionSymbol, err) ||
       functionSymbol.declId != functionRow.functionDeclId ||
       !lineMapCidEqual(
           functionSymbol.declKeyCid,
           functionRow.functionDeclKeyCid) ||
       !lineMapCidEqual(
           functionSymbol.symbolCid,
           functionRow.functionSymbolCid):
        if err == "":
            err = " line map pc: function SymbolId/DeclId/DeclKeyCid mismatch"
        return false
    var operation: debug.DebugOperationFact
    if !debug.DebugFactBundleExactOperationInto(
           facts, emissionRow.debugOpId, operation, err) ||
       !lineMapExactOperationIdentityValid(emissionRow, operation):
        if err == "":
            err = " line map pc: DebugOp exact identity mismatch"
        return false
    out.found = true
    out.notFoundKind = LineMapPcNotFoundNone
    out.functionId = functionRow.functionId
    out.functionSymbolId = functionRow.functionSymbolId
    out.functionDeclId = functionRow.functionDeclId
    out.functionDeclKeyCid = functionRow.functionDeclKeyCid
    out.functionSymbolCid = functionRow.functionSymbolCid
    out.objectSymbolTableIndex = functionRow.objectSymbolTableIndex
    out.debugOpId = emissionRow.debugOpId
    out.fragmentByteStart = emissionRow.textSectionRelativeByteStart
    out.fragmentByteLength = emissionRow.byteLength
    out.fragmentBytesCid = emissionRow.bytesCid
    out.typedNodeId = operation.typedNodeId
    out.typedIrNodeIndex = operation.typedIrNodeIndex
    out.sourceId = operation.sourceId
    out.spanId = operation.spanId
    out.documentCid = operation.documentCid
    out.modulePath = operation.modulePath
    out.startLine = operation.startLine
    out.startColumn = operation.startColumn
    out.endLine = operation.endLine
    out.endColumn = operation.endColumn
    if operation.symbolId >= 0:
        var referencedSymbol: debug.DebugSymbolFact
        if !debug.DebugFactBundleExactSymbolInto(
               facts, operation.symbolId, referencedSymbol, err) ||
           operation.symbolDeclId != referencedSymbol.declId ||
           !lineMapCidEqual(
               operation.symbolDeclKeyCid,
               referencedSymbol.declKeyCid) ||
           !lineMapCidEqual(
               operation.symbolCid, referencedSymbol.symbolCid):
            if err == "":
                err = " line map pc: operation SymbolId/DeclId/DeclKeyCid mismatch"
            return false
        out.referencedSymbolId = operation.symbolId
        out.referencedDeclId = operation.symbolDeclId
        out.referencedDeclKeyCid = operation.symbolDeclKeyCid
        out.referencedSymbolCid = operation.symbolCid
    err = ""
    return true

@borrows
fn LineMapPcLookupFromValidatedDebugReceiptInto(
        binding: bindingreceipt.SemanticSnapshotDebugBindingReceipt,
        objectReceipt: receipt.DebugObjectEmissionReceipt,
        facts: debug.DebugFactBundle,
        plan: planevidence.DebugEmissionPlanEvidence,
        writerObjectCid: layout.FixedBytes32,
        writerTextSectionFileOffset: int32,
        objectBytes: rawbytes.Bytes,
        query: LineMapPcQuery,
        out: var LineMapPcLookup,
        err: var str): bool =
    out = LineMapPcLookup()
    err = ""
    var objectIdentity: bindingreceipt.SemanticSnapshotDebugObjectIdentity
    objectIdentity.sourceVersion = objectReceipt.sourceVersion
    objectIdentity.packageId = objectReceipt.packageId
    objectIdentity.bindingReceiptCid = objectReceipt.bindingReceiptCid
    objectIdentity.semanticSnapshotCid =
        objectReceipt.semanticSnapshotCid
    objectIdentity.worldHeadCid = objectReceipt.worldHeadCid
    objectIdentity.compilerCid = objectReceipt.compilerCid
    objectIdentity.sourceBundleCid = objectReceipt.sourceBundleCid
    objectIdentity.csgRootCid = objectReceipt.csgRootCid
    objectIdentity.validationReceiptCid =
        objectReceipt.validationReceiptCid
    objectIdentity.debugProjectionCid =
        objectReceipt.debugProjectionCid
    objectIdentity.declarationTableCid =
        objectReceipt.declarationTableCid
    objectIdentity.declarationIdentityCid =
        objectReceipt.declarationIdentityCid
    if !bindingreceipt.SemanticSnapshotDebugBindingReceiptValidateObjectIdentityInto(
           binding, facts, objectIdentity, err) ||
       !receipt.DebugObjectEmissionReceiptStrictValidateInto(
           objectReceipt, facts, plan, writerObjectCid,
           writerTextSectionFileOffset, objectBytes, err) ||
       !lineMapReceiptIdentityValidInto(objectReceipt, facts, err) ||
       !lineMapExactRangeTopologyValidInto(objectReceipt, err):
        return false
    out.backendKind = objectReceipt.backendKind
    out.sourceVersion = binding.sourceVersion
    out.bindingReceiptCid = binding.bindingReceiptCid
    out.semanticSnapshotCid = binding.semanticSnapshotCid
    out.csgRootCid = binding.csgRootCid
    out.objectCid = objectReceipt.objectCid
    out.objectStructureCid = objectReceipt.objectStructureCid
    out.relocationTableFileOffset =
        objectReceipt.relocationTableFileOffset
    out.relocationCount = objectReceipt.relocationCount
    out.objectSectionIndex = query.objectSectionIndex
    out.loadedTextSectionAddress = query.loadedTextSectionAddress
    out.crashPc = query.crashPc
    out.objectFileByteOffset = query.objectFileByteOffset
    if query.objectSectionIndex != objectReceipt.textSectionIndex:
        out.notFoundKind = LineMapPcNotFoundWrongSection
        return true
    if query.loadedTextSectionAddress < int64(0) ||
       query.crashPc < query.loadedTextSectionAddress:
        out.notFoundKind = LineMapPcNotFoundOutsideText
        return true
    let relative64 =
        query.crashPc - query.loadedTextSectionAddress
    if relative64 < int64(0) ||
       relative64 >= int64(objectReceipt.textSectionByteLength):
        out.notFoundKind = LineMapPcNotFoundOutsideText
        return true
    let relative = int32(relative64)
    out.textSectionRelativeByteOffset = relative
    if query.objectFileByteOffset !=
           objectReceipt.textSectionFileOffset + relative:
        err = " line map pc: crash PC/object offset mismatch"
        return false
    var functionIndex: int32 = -1
    for index in 0..<objectReceipt.functions.len:
        let functionRow = objectReceipt.functions[index]
        if relative >= functionRow.symbolByteStart &&
           relative <
               functionRow.symbolByteStart + functionRow.symbolByteLength:
            functionIndex = index
    if functionIndex < 0:
        out.notFoundKind = LineMapPcNotFoundGap
        return true
    let functionRow = objectReceipt.functions[functionIndex]
    if (query.expectedFunctionId >= 0 &&
        query.expectedFunctionId != functionRow.functionId) ||
       (query.expectedObjectSymbolTableIndex >= 0 &&
        query.expectedObjectSymbolTableIndex !=
            functionRow.objectSymbolTableIndex):
        err = " line map pc: cross-function object identity mismatch"
        return false
    var emissionIndex: int32 = -1
    for rowOffset in 0..<functionRow.rowCount:
        let index = functionRow.rowStart + rowOffset
        let row = objectReceipt.rows[index]
        if relative >= row.textSectionRelativeByteStart &&
           relative <
               row.textSectionRelativeByteStart + row.byteLength:
            emissionIndex = index
    if emissionIndex < 0:
        out.notFoundKind = LineMapPcNotFoundGap
        return true
    let emissionRow = objectReceipt.rows[emissionIndex]
    if emissionRow.debugOpId < 0:
        out.notFoundKind = LineMapPcNotFoundMissingDebugOp
        return true
    return lineMapPcLookupIdentityInto(
        facts, functionRow, emissionRow, out, err)

@borrows
fn lineMapAppendFunctionEntry(
        out: var str,
        row: receipt.DebugObjectEmissionFunctionRow,
        fact: debug.DebugFunctionFact) =
    var line = "entry"
    lineMapAppendField(line, "function_id", strings.IntToStr(row.functionId))
    lineMapAppendField(
        line, "function_symbol_id", strings.IntToStr(row.functionSymbolId))
    lineMapAppendField(
        line, "function_decl_id", strings.IntToStr(row.functionDeclId))
    lineMapAppendCidField(
        line, "function_decl_key_cid", row.functionDeclKeyCid)
    lineMapAppendCidField(
        line, "function_symbol_cid", row.functionSymbolCid)
    lineMapAppendField(
        line, "object_section_index",
        strings.IntToStr(row.objectSectionIndex))
    lineMapAppendField(line, "pc_start", strings.IntToStr(row.symbolByteStart))
    lineMapAppendField(
        line, "pc_end_exclusive",
        strings.IntToStr(row.symbolByteStart + row.symbolByteLength))
    lineMapAppendField(
        line, "object_file_byte_start",
        strings.IntToStr(row.objectFileByteStart))
    lineMapAppendField(
        line, "object_file_byte_end_exclusive",
        strings.IntToStr(row.objectFileByteStart + row.symbolByteLength))
    lineMapAppendCidField(line, "symbol_bytes_cid", row.symbolBytesCid)
    lineMapAppendField(line, "source_id", strings.IntToStr(fact.sourceId))
    lineMapAppendCidField(line, "document_cid", fact.documentCid)
    lineMapAppendField(
        line, "declaration_span_id",
        strings.IntToStr(fact.declarationSpanId))
    lineMapAppendField(
        line, "body_span_id", strings.IntToStr(fact.bodySpanId))
    lineMapAppendField(
        line, "body_start_line", strings.IntToStr(fact.bodyStartLine))
    lineMapAppendField(
        line, "body_start_column", strings.IntToStr(fact.bodyStartColumn))
    lineMapAppendField(
        line, "body_end_line", strings.IntToStr(fact.bodyEndLine))
    lineMapAppendField(
        line, "body_end_column", strings.IntToStr(fact.bodyEndColumn))
    lineMapAppendField(line, "function_name", fact.functionName)
    lineMapAppendField(line, "module_path", fact.modulePath)
    out = strutil.Join([strings.CloneStr(out), line, "\n"], "")

@borrows
fn lineMapAppendOperationEntry(
        out: var str,
        row: receipt.DebugEmissionRow,
        operation: debug.DebugOperationFact) =
    var line = "location"
    lineMapAppendField(line, "debug_op_id", strings.IntToStr(row.debugOpId))
    lineMapAppendField(line, "function_id", strings.IntToStr(row.functionId))
    lineMapAppendField(
        line, "function_symbol_id", strings.IntToStr(row.functionSymbolId))
    lineMapAppendField(
        line, "function_decl_id", strings.IntToStr(row.functionDeclId))
    lineMapAppendCidField(
        line, "function_decl_key_cid", row.functionDeclKeyCid)
    lineMapAppendCidField(
        line, "function_symbol_cid", row.functionSymbolCid)
    lineMapAppendField(line, "pc_start",
                       strings.IntToStr(row.textSectionRelativeByteStart))
    lineMapAppendField(
        line, "pc_end_exclusive",
        strings.IntToStr(
            row.textSectionRelativeByteStart + row.byteLength))
    lineMapAppendField(
        line, "object_file_byte_start",
        strings.IntToStr(row.objectFileByteStart))
    lineMapAppendField(
        line, "object_file_byte_end_exclusive",
        strings.IntToStr(row.objectFileByteStart + row.byteLength))
    lineMapAppendCidField(line, "bytes_cid", row.bytesCid)
    lineMapAppendField(
        line, "typed_node_id", strings.IntToStr(row.typedNodeId))
    lineMapAppendField(
        line, "typed_ir_node_index",
        strings.IntToStr(row.typedIrNodeIndex))
    lineMapAppendField(
        line, "source_id", strings.IntToStr(operation.sourceId))
    lineMapAppendField(line, "span_id", strings.IntToStr(operation.spanId))
    lineMapAppendCidField(line, "document_cid", operation.documentCid)
    lineMapAppendField(
        line, "start_line", strings.IntToStr(operation.startLine))
    lineMapAppendField(
        line, "start_column", strings.IntToStr(operation.startColumn))
    lineMapAppendField(
        line, "end_line", strings.IntToStr(operation.endLine))
    lineMapAppendField(
        line, "end_column", strings.IntToStr(operation.endColumn))
    lineMapAppendField(line, "module_path", operation.modulePath)
    out = strutil.Join([strings.CloneStr(out), line, "\n"], "")

@borrows
fn lineMapAppendSyntheticEntry(
        out: var str,
        row: receipt.DebugEmissionRow) =
    var line = "synthetic"
    lineMapAppendField(
        line, "synthetic_kind", strings.IntToStr(row.debugSyntheticKind))
    lineMapAppendField(line, "function_id", strings.IntToStr(row.functionId))
    lineMapAppendField(
        line, "function_symbol_id", strings.IntToStr(row.functionSymbolId))
    lineMapAppendField(
        line, "function_decl_id", strings.IntToStr(row.functionDeclId))
    lineMapAppendCidField(
        line, "function_decl_key_cid", row.functionDeclKeyCid)
    lineMapAppendCidField(
        line, "function_symbol_cid", row.functionSymbolCid)
    lineMapAppendField(line, "pc_start",
                       strings.IntToStr(row.textSectionRelativeByteStart))
    lineMapAppendField(
        line, "pc_end_exclusive",
        strings.IntToStr(
            row.textSectionRelativeByteStart + row.byteLength))
    lineMapAppendField(
        line, "object_file_byte_start",
        strings.IntToStr(row.objectFileByteStart))
    lineMapAppendField(
        line, "object_file_byte_end_exclusive",
        strings.IntToStr(row.objectFileByteStart + row.byteLength))
    lineMapAppendCidField(line, "bytes_cid", row.bytesCid)
    out = strutil.Join([strings.CloneStr(out), line, "\n"], "")

@borrows
fn LineMapTextFromValidatedDebugReceiptInto(
        objectReceipt: receipt.DebugObjectEmissionReceipt,
        facts: debug.DebugFactBundle,
        plan: planevidence.DebugEmissionPlanEvidence,
        writerObjectCid: layout.FixedBytes32,
        writerTextSectionFileOffset: int32,
        objectBytes: rawbytes.Bytes,
        out: var str,
        err: var str): bool =
    out = ""
    err = ""
    if !receipt.DebugObjectEmissionReceiptStrictValidateInto(
           objectReceipt, facts, plan, writerObjectCid,
           writerTextSectionFileOffset, objectBytes, err):
        return false
    if !lineMapReceiptIdentityValidInto(objectReceipt, facts, err):
        return false
    if !lineMapExactRangeTopologyValidInto(objectReceipt, err):
        return false
    var built = "cheng_line_map\n"
    lineMapAppendHeader(
        built, "source_version",
        strings.Int64ToStr(objectReceipt.sourceVersion))
    lineMapAppendCidHeader(
        built, "semantic_snapshot_cid",
        objectReceipt.semanticSnapshotCid)
    lineMapAppendCidHeader(
        built, "binding_receipt_cid",
        objectReceipt.bindingReceiptCid)
    lineMapAppendCidHeader(
        built, "world_head_cid", objectReceipt.worldHeadCid)
    lineMapAppendCidHeader(
        built, "compiler_cid", objectReceipt.compilerCid)
    lineMapAppendCidHeader(
        built, "source_bundle_cid", objectReceipt.sourceBundleCid)
    lineMapAppendCidHeader(
        built, "csg_root_cid", objectReceipt.csgRootCid)
    lineMapAppendCidHeader(
        built, "validation_receipt_cid",
        objectReceipt.validationReceiptCid)
    lineMapAppendCidHeader(
        built, "debug_projection_cid",
        objectReceipt.debugProjectionCid)
    lineMapAppendCidHeader(
        built, "declaration_table_cid",
        objectReceipt.declarationTableCid)
    lineMapAppendCidHeader(
        built, "declaration_identity_cid",
        objectReceipt.declarationIdentityCid)
    lineMapAppendCidHeader(built, "object_cid", objectReceipt.objectCid)
    lineMapAppendCidHeader(
        built, "object_structure_cid",
        objectReceipt.objectStructureCid)
    lineMapAppendCidHeader(
        built, "debug_map_cid", objectReceipt.debugMapCid)
    lineMapAppendHeader(
        built, "text_section_index",
        strings.IntToStr(objectReceipt.textSectionIndex))
    lineMapAppendHeader(
        built, "text_section_file_offset",
        strings.IntToStr(objectReceipt.textSectionFileOffset))
    lineMapAppendHeader(
        built, "text_section_byte_length",
        strings.IntToStr(objectReceipt.textSectionByteLength))
    lineMapAppendHeader(
        built, "entry_count",
        strings.IntToStr(objectReceipt.functions.len))
    lineMapAppendHeader(
        built, "location_count",
        strings.IntToStr(objectReceipt.rows.len))
    var seenFunctionIds: bool[]
    setLen(seenFunctionIds, facts.functionCount)
    var rowCursor: int32
    for functionIndex in 0..<objectReceipt.functions.len:
        let functionRow = objectReceipt.functions[functionIndex]
        var functionFact: debug.DebugFunctionFact
        if !lineMapFunctionFactInto(
               facts, functionRow.functionId, functionFact, err) ||
           seenFunctionIds[functionRow.functionId] ||
           !lineMapFunctionIdentityValid(functionRow, functionFact):
            if err == "":
                err = " line map: FunctionId/SymbolId/DeclId join mismatch"
            return false
        if !lineMapFunctionRangeValid(objectReceipt, functionRow) ||
           functionRow.rowStart != rowCursor ||
           functionRow.rowCount <= 0 ||
           functionRow.rowStart < 0 ||
           functionRow.rowStart >
               objectReceipt.rows.len - functionRow.rowCount:
            err = " line map: invalid function object/row range"
            return false
        seenFunctionIds[functionRow.functionId] = true
        lineMapAppendFunctionEntry(built, functionRow, functionFact)
        for rowOffset in 0..<functionRow.rowCount:
            let emissionRow =
                objectReceipt.rows[functionRow.rowStart + rowOffset]
            if !lineMapEmissionRowIdentityValid(
                   emissionRow, functionRow) ||
               !lineMapEmissionRowRangeValid(
                   objectReceipt, functionRow, emissionRow):
                err = " line map: DebugOp function/object range mismatch"
                return false
            if emissionRow.debugOpId >= 0:
                var operation: debug.DebugOperationFact
                if !lineMapOperationFactInto(
                       facts, emissionRow.debugOpId, operation, err) ||
                   !lineMapExactOperationIdentityValid(
                       emissionRow, operation):
                    if err == "":
                        err = " line map: DebugOpId exact identity mismatch"
                    return false
                lineMapAppendOperationEntry(built, emissionRow, operation)
            else:
                if !lineMapSyntheticOperationIdentityValid(emissionRow):
                    err = " line map: invalid synthetic debug identity"
                    return false
                lineMapAppendSyntheticEntry(built, emissionRow)
        rowCursor = functionRow.rowStart + functionRow.rowCount
    if rowCursor != objectReceipt.rows.len:
        err = " line map: debug row coverage mismatch"
        return false
    out = built
    return true

@borrows
fn lineMapHeaderHasLowerHexCid(line: str, prefix: str): bool =
    if !strutil.StartsWith(line, prefix) || line.len != prefix.len + 64:
        return false
    for index in prefix.len..<line.len:
        let ch = line[index]
        if !((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f')):
            return false
    return true

@borrows
fn lineMapHeaderHasCanonicalDecimal(line: str,
                                    prefix: str,
                                    allowZero: bool): bool =
    if !strutil.StartsWith(line, prefix) || line.len <= prefix.len:
        return false
    if line[prefix.len] == '0':
        return allowZero && line.len == prefix.len + 1
    for index in prefix.len..<line.len:
        if line[index] < '0' || line[index] > '9':
            return false
    return true

@borrows
fn LineMapTextHasRequiredDebugFields(text: str): bool =
    let lines = strutil.Split(text, '\n')
    if lines.len <= 0 || lines[0] != "cheng_line_map":
        return false
    var hasEntry = false
    var hasLocation = false
    var sourceVersionCount: int32
    var semanticSnapshotCidCount: int32
    var bindingReceiptCidCount: int32
    var worldHeadCidCount: int32
    var compilerCidCount: int32
    var sourceBundleCidCount: int32
    var csgRootCidCount: int32
    var validationReceiptCidCount: int32
    var debugProjectionCidCount: int32
    var declarationTableCidCount: int32
    var declarationIdentityCidCount: int32
    var objectCidCount: int32
    var objectStructureCidCount: int32
    var debugMapCidCount: int32
    var textSectionIndexCount: int32
    var textSectionFileOffsetCount: int32
    var textSectionByteLengthCount: int32
    var entryCountCount: int32
    var locationCountCount: int32
    for index in 0..<lines.len:
        if strutil.StartsWith(lines[index], "source_version="):
            sourceVersionCount = sourceVersionCount + 1
            if !lineMapHeaderHasCanonicalDecimal(
                   lines[index], "source_version=", false):
                return false
        if strutil.StartsWith(lines[index], "semantic_snapshot_cid="):
            semanticSnapshotCidCount = semanticSnapshotCidCount + 1
            if !lineMapHeaderHasLowerHexCid(
                   lines[index], "semantic_snapshot_cid="):
                return false
        if strutil.StartsWith(lines[index], "binding_receipt_cid="):
            bindingReceiptCidCount = bindingReceiptCidCount + 1
            if !lineMapHeaderHasLowerHexCid(
                   lines[index], "binding_receipt_cid="):
                return false
        if strutil.StartsWith(lines[index], "world_head_cid="):
            worldHeadCidCount = worldHeadCidCount + 1
            if !lineMapHeaderHasLowerHexCid(lines[index], "world_head_cid="):
                return false
        if strutil.StartsWith(lines[index], "compiler_cid="):
            compilerCidCount = compilerCidCount + 1
            if !lineMapHeaderHasLowerHexCid(lines[index], "compiler_cid="):
                return false
        if strutil.StartsWith(lines[index], "source_bundle_cid="):
            sourceBundleCidCount = sourceBundleCidCount + 1
            if !lineMapHeaderHasLowerHexCid(
                   lines[index], "source_bundle_cid="):
                return false
        if strutil.StartsWith(lines[index], "csg_root_cid="):
            csgRootCidCount = csgRootCidCount + 1
            if !lineMapHeaderHasLowerHexCid(lines[index], "csg_root_cid="):
                return false
        if strutil.StartsWith(lines[index], "validation_receipt_cid="):
            validationReceiptCidCount = validationReceiptCidCount + 1
            if !lineMapHeaderHasLowerHexCid(
                   lines[index], "validation_receipt_cid="):
                return false
        if strutil.StartsWith(lines[index], "debug_projection_cid="):
            debugProjectionCidCount = debugProjectionCidCount + 1
            if !lineMapHeaderHasLowerHexCid(
                   lines[index], "debug_projection_cid="):
                return false
        if strutil.StartsWith(lines[index], "declaration_table_cid="):
            declarationTableCidCount = declarationTableCidCount + 1
            if !lineMapHeaderHasLowerHexCid(
                   lines[index], "declaration_table_cid="):
                return false
        if strutil.StartsWith(lines[index], "declaration_identity_cid="):
            declarationIdentityCidCount = declarationIdentityCidCount + 1
            if !lineMapHeaderHasLowerHexCid(
                   lines[index], "declaration_identity_cid="):
                return false
        if strutil.StartsWith(lines[index], "object_cid="):
            objectCidCount = objectCidCount + 1
            if !lineMapHeaderHasLowerHexCid(lines[index], "object_cid="):
                return false
        if strutil.StartsWith(lines[index], "object_structure_cid="):
            objectStructureCidCount = objectStructureCidCount + 1
            if !lineMapHeaderHasLowerHexCid(
                   lines[index], "object_structure_cid="):
                return false
        if strutil.StartsWith(lines[index], "debug_map_cid="):
            debugMapCidCount = debugMapCidCount + 1
            if !lineMapHeaderHasLowerHexCid(lines[index], "debug_map_cid="):
                return false
        if strutil.StartsWith(lines[index], "text_section_index="):
            textSectionIndexCount = textSectionIndexCount + 1
            if !lineMapHeaderHasCanonicalDecimal(
                   lines[index], "text_section_index=", true):
                return false
        if strutil.StartsWith(lines[index], "text_section_file_offset="):
            textSectionFileOffsetCount = textSectionFileOffsetCount + 1
            if !lineMapHeaderHasCanonicalDecimal(
                   lines[index], "text_section_file_offset=", false):
                return false
        if strutil.StartsWith(lines[index], "text_section_byte_length="):
            textSectionByteLengthCount = textSectionByteLengthCount + 1
            if !lineMapHeaderHasCanonicalDecimal(
                   lines[index], "text_section_byte_length=", false):
                return false
        if strutil.StartsWith(lines[index], "entry_count="):
            entryCountCount = entryCountCount + 1
            if !lineMapHeaderHasCanonicalDecimal(
                   lines[index], "entry_count=", false):
                return false
        if strutil.StartsWith(lines[index], "location_count="):
            locationCountCount = locationCountCount + 1
            if !lineMapHeaderHasCanonicalDecimal(
                   lines[index], "location_count=", false):
                return false
        if strutil.StartsWith(lines[index], "entry\t"):
            hasEntry = true
            if !strutil.Contains(lines[index], "\tfunction_id=") ||
               !strutil.Contains(lines[index], "\tfunction_symbol_id=") ||
               !strutil.Contains(lines[index], "\tfunction_decl_id=") ||
               !strutil.Contains(
                   lines[index], "\tfunction_decl_key_cid=") ||
               !strutil.Contains(lines[index], "\tpc_start=") ||
               !strutil.Contains(
                   lines[index], "\tobject_file_byte_start="):
                return false
        if strutil.StartsWith(lines[index], "location\t") ||
           strutil.StartsWith(lines[index], "synthetic\t"):
            hasLocation = true
            if !strutil.Contains(lines[index], "\tfunction_id=") ||
               !strutil.Contains(lines[index], "\tpc_start=") ||
               !strutil.Contains(
                   lines[index], "\tobject_file_byte_start="):
                return false
            if strutil.StartsWith(lines[index], "location\t") &&
               !strutil.Contains(lines[index], "\tdebug_op_id="):
                return false
    return sourceVersionCount == 1 && semanticSnapshotCidCount == 1 &&
           bindingReceiptCidCount == 1 && worldHeadCidCount == 1 &&
           compilerCidCount == 1 && sourceBundleCidCount == 1 &&
           csgRootCidCount == 1 && validationReceiptCidCount == 1 &&
           debugProjectionCidCount == 1 && declarationTableCidCount == 1 &&
           declarationIdentityCidCount == 1 && objectCidCount == 1 &&
           objectStructureCidCount == 1 && debugMapCidCount == 1 &&
           textSectionIndexCount == 1 &&
           textSectionFileOffsetCount == 1 &&
           textSectionByteLengthCount == 1 && entryCountCount == 1 &&
           locationCountCount == 1 &&
           hasEntry && hasLocation

@borrows
fn lineMapAtomicAbort(handle: os.AtomicTree, message: str): Result[str] =
    let abortRes = os.AtomicTreeAbort(handle)
    if IsErr(abortRes):
        let ownedMsg = strings.CloneStr(message)
        let abortErr = strings.CloneStr(Error(abortRes))
        return Err[str](strutil.Join([
            ownedMsg, "; staging abort failed: ", abortErr
        ], ""))
    return Err[str](strings.CloneStr(message))

@borrows
fn WriteExecutableLineMapFromValidatedDebugReceipt(
        rootDir: str,
        outputPath: str,
        objectReceipt: receipt.DebugObjectEmissionReceipt,
        facts: debug.DebugFactBundle,
        plan: planevidence.DebugEmissionPlanEvidence,
        writerObjectCid: layout.FixedBytes32,
        writerTextSectionFileOffset: int32,
        objectBytes: rawbytes.Bytes): Result[str] =
    if len(outputPath) <= 0:
        return Err[str](" compiler: missing line-map output path")
    let path = strings.CloneStr(outputPath) + ".map"
    var text: str
    var err: str
    if !LineMapTextFromValidatedDebugReceiptInto(
           objectReceipt, facts, plan, writerObjectCid,
           writerTextSectionFileOffset, objectBytes, text, err):
        return Err[str](strings.CloneStr(err))
    let ownedRoot = strings.CloneStr(rootDir)
    let ownedPath = strings.CloneStr(path)
    let absPath = chengpath.PathAbsolute(ownedRoot, ownedPath)
    let hostPath = chengpath.PathHostFilePath(absPath)
    let parentPath = chengpath.PathParentDir(hostPath)
    let finalName = chengpath.PathBaseName(hostPath)
    let generation = layout.FixedBytes32Hex(writerObjectCid)
    let ownedFinal = strings.CloneStr(finalName)
    let ownedGen = strings.CloneStr(generation)
    let stagingName = strutil.Join([
        ".", ownedFinal, ".txn-", ownedGen
    ], "")
    let beginRes = os.AtomicTreeBegin(parentPath, stagingName, finalName)
    if IsErr(beginRes):
        return Err[str](strutil.Join([
            " compiler: failed to begin line-map transaction: ",
            strings.CloneStr(path), ": ", strings.CloneStr(Error(beginRes))
        ], ""))
    let handle = Value(beginRes)
    var textBytes = rawbytes.BytesAlloc(text.len)
    if textBytes.data == nil || rawbytes.BytesLen(textBytes) != text.len:
        rawbytes.BytesFree(textBytes)
        return lineMapAtomicAbort(
            handle, " compiler: failed to allocate line-map bytes")
    for index in 0..<text.len:
        rawbytes.BytesSet(textBytes, index, Int32(text[index]) & 255)
    let writeRes = os.AtomicTreeWriteExclusiveSync(
        handle, "payload", textBytes)
    rawbytes.BytesFree(textBytes)
    if IsErr(writeRes):
        return lineMapAtomicAbort(
            handle, strutil.Join([
                " compiler: failed to sync staged line-map: ",
                strings.CloneStr(path), ": ", strings.CloneStr(Error(writeRes))
            ], ""))
    let stagedPath = chengpath.PathJoin(
        chengpath.PathJoin(parentPath, stagingName), "payload")
    if !os.RenameFile(stagedPath, hostPath):
        return lineMapAtomicAbort(
            handle, strutil.Join([
                " compiler: failed to atomically publish line-map: ",
                strings.CloneStr(path)
            ], ""))
    # Rename is the commit point. Abort invalidates the transaction handle; the
    # tracked payload has moved, so remove the now-empty staging root directly.
    # Any post-commit cleanup failure is terminal rather than a recoverable Err.
    let _ = os.AtomicTreeAbort(handle)
    let stagingPath = chengpath.PathJoin(parentPath, stagingName)
    os.RemoveDir(stagingPath)
    if os.DirExists(stagingPath):
        panic("line map: committed transaction staging cleanup failed")
    return Ok[str](strings.CloneStr(path))
