# codegen_writer_units.cheng —— writer/linker 单元直调聚合门面（B2 表键侧）
# 归属：shared-format（跨 x86_64/riscv64/riscv32 单元的安装聚合门面，先例=
# coff_object_linker 的链接期 arch 钩子；kernel 经本模块按 unitKey 直调
# 各 writer/linker 入口）。
#
# 形态（kernel-b2-20260825 PROBES_B2.md 裁定）：fn 值槽对 writer 族不可用
# （frozen stage3 下托管对象过 fn 槽在返回/释放期全线崩），故本模块以
# unitKey switch 直调各单元入口——零间接调用，字节路径与原 kernel 直调
# 逐字节相同。缺组合=default 臂显式失败（Err 文案带 unitKey），无 else
# 兜底。unitKey 常量与 (format,triple) 解析在 codegen_contract（kernel）；
# triple 分类权威在 target_matrix。
#
# 参数风格：统一值传 + @borrows（契约 TODO 220-223 裁定方向）。调用方
# 现产实参形态全覆盖：doe 的 var 形参 / noep 的 var 字段投影 / 值参
# （TextOnly）→ 本模块 @borrows 值参；本模块直调 elf_x86_64_writer 的
# var 形参入口时为值实参→var 形参（direct_object_emit TextOnly :224
# 现产同形）。
import std/result
import std/rawbytes
import std/strings
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/elf_x86_64_writer
import cheng/core/backend/elf_riscv64_writer
import cheng/core/backend/elf_riscv32_writer
import cheng/core/backend/elf_riscv64_linker
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/object_relocs as orel

@borrows
fn CodegenWriterUnitTextDataObjectBytes(
        unitKey: int32,
        text: rawbytes.Bytes,
        data: rawbytes.Bytes,
        symbols: osym.ObjectSymbolTable,
        relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes] =
    # 结果透传（零转换）：Err 文案与各 writer 原文逐字节同源。
    if unitKey == contract.CodegenUnitX64:
        return elf_x86_64_writer.ElfX64TextDataObjectBytes(text, data, symbols, relocs)
    if unitKey == contract.CodegenUnitRv64:
        return elf_riscv64_writer.ElfRv64TextDataObjectBytes(text, data, symbols, relocs)
    if unitKey == contract.CodegenUnitRv32:
        return elf_riscv32_writer.ElfRv32TextDataObjectBytes(text, data, symbols, relocs)
    if unitKey == contract.CodegenWriterUnitRv32Integer:
        return elf_riscv32_writer.ElfRv32IntegerTextDataObjectBytes(text, data, symbols, relocs)
    return Err[rawbytes.Bytes](Fmt" codegen writer unit unavailable: unitKey={unitKey}")

@borrows
fn CodegenWriterUnitTextObjectWrite(
        unitKey: int32,
        rootDir: str,
        outputPath: str,
        text: rawbytes.Bytes,
        symbols: osym.ObjectSymbolTable,
        relocs: orel.ObjectRelocTable): Result[contract.CodegenObjectWriterResult] =
    # TextOnly 族：现行树 arch 专属臂仅 x86_64（direct_object_emit
    # WriteObjectTextOnly :224），其余 elf 目标由调用方走共享 writer 或
    # 显式失败，本入口不设兜底臂。
    if unitKey == contract.CodegenUnitX64:
        let elfRes = elf_x86_64_writer.ElfX64TextObjectWrite(rootDir, outputPath, text, symbols, relocs)
        if !elfRes.ok:
            return Err[contract.CodegenObjectWriterResult](strings.CloneStr(elfRes.err.msg))
        var out: contract.CodegenObjectWriterResult
        out.objectPath = strings.CloneStr(elfRes.value.objectPath)
        out.bytesWritten = elfRes.value.bytesWritten
        out.symbolCount = elfRes.value.symbolCount
        out.relocCount = elfRes.value.relocCount
        return Ok[contract.CodegenObjectWriterResult](out)
    return Err[contract.CodegenObjectWriterResult](Fmt" codegen writer unit unavailable: unitKey={unitKey}")

@borrows
fn CodegenWriterUnitTextDataObjectWrite(
        unitKey: int32,
        rootDir: str,
        outputPath: str,
        text: rawbytes.Bytes,
        data: rawbytes.Bytes,
        symbols: osym.ObjectSymbolTable,
        relocs: orel.ObjectRelocTable): Result[contract.CodegenObjectWriterResult] =
    if unitKey == contract.CodegenUnitX64:
        let elfRes = elf_x86_64_writer.ElfX64TextDataObjectWrite(rootDir, outputPath, text, data, symbols, relocs)
        if !elfRes.ok:
            return Err[contract.CodegenObjectWriterResult](strings.CloneStr(elfRes.err.msg))
        var out: contract.CodegenObjectWriterResult
        out.objectPath = strings.CloneStr(elfRes.value.objectPath)
        out.bytesWritten = elfRes.value.bytesWritten
        out.symbolCount = elfRes.value.symbolCount
        out.relocCount = elfRes.value.relocCount
        return Ok[contract.CodegenObjectWriterResult](out)
    if unitKey == contract.CodegenUnitRv64:
        let elfRes = elf_riscv64_writer.ElfRv64TextDataObjectWrite(rootDir, outputPath, text, data, symbols, relocs)
        if !elfRes.ok:
            return Err[contract.CodegenObjectWriterResult](strings.CloneStr(elfRes.err.msg))
        var out: contract.CodegenObjectWriterResult
        out.objectPath = strings.CloneStr(elfRes.value.objectPath)
        out.bytesWritten = elfRes.value.bytesWritten
        out.symbolCount = elfRes.value.symbolCount
        out.relocCount = elfRes.value.relocCount
        return Ok[contract.CodegenObjectWriterResult](out)
    if unitKey == contract.CodegenUnitRv32:
        let elfRes = elf_riscv32_writer.ElfRv32TextDataObjectWrite(rootDir, outputPath, text, data, symbols, relocs)
        if !elfRes.ok:
            return Err[contract.CodegenObjectWriterResult](strings.CloneStr(elfRes.err.msg))
        var out: contract.CodegenObjectWriterResult
        out.objectPath = strings.CloneStr(elfRes.value.objectPath)
        out.bytesWritten = elfRes.value.bytesWritten
        out.symbolCount = elfRes.value.symbolCount
        out.relocCount = elfRes.value.relocCount
        return Ok[contract.CodegenObjectWriterResult](out)
    if unitKey == contract.CodegenWriterUnitRv32Integer:
        let elfRes = elf_riscv32_writer.ElfRv32IntegerTextDataObjectWrite(rootDir, outputPath, text, data, symbols, relocs)
        if !elfRes.ok:
            return Err[contract.CodegenObjectWriterResult](strings.CloneStr(elfRes.err.msg))
        var out: contract.CodegenObjectWriterResult
        out.objectPath = strings.CloneStr(elfRes.value.objectPath)
        out.bytesWritten = elfRes.value.bytesWritten
        out.symbolCount = elfRes.value.symbolCount
        out.relocCount = elfRes.value.relocCount
        return Ok[contract.CodegenObjectWriterResult](out)
    return Err[contract.CodegenObjectWriterResult](Fmt" codegen writer unit unavailable: unitKey={unitKey}")

fn CodegenWriterUnitLinkExeBuiltin(
        unitKey: int32,
        objPaths: str[],
        outputPath: str,
        target: str): Result[bool] =
    # elf_riscv64_builtin 自链接入口（native_link_exec :371 原直调）。
    # macho/elf_x86_64/elf_aarch64/coff_pe 自链接臂为共享格式/链接器
    # （kernel→shared 合法），保留在调用方不经本表；其中 coff_pe_builtin 臂
    # B7（2026-08-25）按蓝图 2.3 同槽位收编至 codegen_linker_units（独立
    # 门面：本模块被 native_object_emission_plan 消费，若直接 import
    # coff_object_linker 会把 aarch64_encode 拖入其可达闭包，closure 间接
    # 边铁律不增）。
    if unitKey == contract.CodegenUnitRv64:
        return elf_riscv64_linker.ElfRv64LinkExe(objPaths, outputPath, target)
    return Err[bool](Fmt" codegen linker unit unavailable: unitKey={unitKey}")
