import std/result
import std/strings
import std/strformat
import std/rawbytes
import cheng/core/tooling/path as chengpath
import cheng/core/backend/aarch64_encode as a64
import cheng/core/backend/macho_object_writer as macho
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/object_relocs as orel

# Darwin syscall/atomic shim provider object: the pure-Cheng replacement for
# the cc-compiled host_runtime C shim the cold pipeline links. The dispatch
# entry's emit-darwin-syscall-provider subcommand and the system-link-exec
# runtime's provider materialization both produce the object through
# DarwinSyscallProviderWriteObject, so the emitted symbol set has exactly one
# owner and never duplicates the Cheng provider exports (af_inet bridges,
# call_indirect entries) that the legacy stage3 emitter used to carry.

fn darwinSyscallProviderA64Clrex(): int32 =
    return int32(uint32(0xD5033F5F))

fn darwinSyscallProviderA64LdarW(rt: int32, rn: int32): int32 =
    return int32(uint32(0x88DFFC00) | (uint32(rn) << uint32(5)) | uint32(rt))

fn darwinSyscallProviderA64StlrW(rt: int32, rn: int32): int32 =
    return int32(uint32(0x889FFC00) | (uint32(rn) << uint32(5)) | uint32(rt))

fn darwinSyscallProviderAppendA64Word(words: var int32[],
                                      word: int32) =
    add(words, word)

fn darwinSyscallProviderAppendA64ResultWord(words: var int32[],
                                            wordRes: Result[int32]): bool =
    if !wordRes.ok:
        return false
    add(words, wordRes.value)
    return true

fn darwinSyscallProviderA64PatchBCond(words: var int32[],
                                      fromWord: int32,
                                      toWord: int32,
                                      cond: int32): bool =
    if fromWord < 0 || fromWord >= words.len:
        return false
    let wordRes = a64.A64EncBCond(int64(toWord - fromWord), cond)
    if !wordRes.ok:
        return false
    words[fromWord] = wordRes.value
    return true

fn darwinSyscallProviderA64PatchCbnz(words: var int32[],
                                     fromWord: int32,
                                     toWord: int32,
                                     reg: int32): bool =
    if fromWord < 0 || fromWord >= words.len:
        return false
    let wordRes = a64.A64EncCbnz(false, reg, int64(toWord - fromWord))
    if !wordRes.ok:
        return false
    words[fromWord] = wordRes.value
    return true

fn darwinSyscallProviderA64PatchCbz(words: var int32[],
                                    fromWord: int32,
                                    toWord: int32,
                                    reg: int32,
                                    is64: bool): bool =
    if fromWord < 0 || fromWord >= words.len:
        return false
    let wordRes = a64.A64EncCbz(is64, reg, int64(toWord - fromWord))
    if !wordRes.ok:
        return false
    words[fromWord] = wordRes.value
    return true

fn DarwinSyscallProviderEmitSyscallStub(words: var int32[],
                                        syscallNo: int32) =
    add(words, a64.A64EncMovz(true, a64.A64X16, syscallNo, 0))
    add(words, a64.A64EncSvc(0x80))
    add(words, a64.A64EncRet())

fn DarwinSyscallProviderEmitCallIndirectVoid(words: var int32[]): bool =
    if !darwinSyscallProviderAppendA64ResultWord(words, a64.A64EncSubImm(true, a64.A64SP, a64.A64SP, 16)):
        return false
    if !darwinSyscallProviderAppendA64ResultWord(words, a64.A64EncStrImm(true, a64.A64LR, a64.A64SP, int64(0))):
        return false
    add(words, a64.A64EncOrrReg(true, a64.A64X9, a64.A64ZR, a64.A64X0))
    add(words, a64.A64EncOrrReg(true, a64.A64X0, a64.A64ZR, a64.A64X1))
    add(words, a64.A64EncBlr(a64.A64X9))
    if !darwinSyscallProviderAppendA64ResultWord(words, a64.A64EncLdrImm(true, a64.A64LR, a64.A64SP, int64(0))):
        return false
    if !darwinSyscallProviderAppendA64ResultWord(words, a64.A64EncAddImm(true, a64.A64SP, a64.A64SP, 16)):
        return false
    add(words, a64.A64EncRet())
    return true

fn DarwinSyscallProviderEmitCallIndirectI32(words: var int32[]): bool =
    if !darwinSyscallProviderAppendA64ResultWord(words, a64.A64EncSubImm(true, a64.A64SP, a64.A64SP, 16)):
        return false
    if !darwinSyscallProviderAppendA64ResultWord(words, a64.A64EncStrImm(true, a64.A64LR, a64.A64SP, int64(0))):
        return false
    add(words, a64.A64EncOrrReg(true, a64.A64X9, a64.A64ZR, a64.A64X0))
    add(words, a64.A64EncOrrReg(true, a64.A64X0, a64.A64ZR, a64.A64X1))
    add(words, a64.A64EncOrrReg(true, a64.A64X1, a64.A64ZR, a64.A64X2))
    add(words, a64.A64EncOrrReg(true, a64.A64X2, a64.A64ZR, a64.A64X3))
    add(words, a64.A64EncBlr(a64.A64X9))
    if !darwinSyscallProviderAppendA64ResultWord(words, a64.A64EncLdrImm(true, a64.A64LR, a64.A64SP, int64(0))):
        return false
    if !darwinSyscallProviderAppendA64ResultWord(words, a64.A64EncAddImm(true, a64.A64SP, a64.A64SP, 16)):
        return false
    add(words, a64.A64EncRet())
    return true

fn DarwinSyscallProviderEmitAtomicCasI32(words: var int32[]): bool =
    let loopWord = words.len
    add(words, a64.A64EncLdaxrW(a64.A64X4, a64.A64X0))
    add(words, a64.A64EncCmpReg(false, a64.A64X4, a64.A64X1))
    let failBranch = words.len
    add(words, a64.A64EncNop())
    add(words, a64.A64EncStlxrW(a64.A64X5, a64.A64X2, a64.A64X0))
    let retryBranch = words.len
    add(words, a64.A64EncNop())
    add(words, a64.A64EncMovz(false, a64.A64X0, 1, 0))
    add(words, a64.A64EncRet())
    let failWord = words.len
    if !darwinSyscallProviderA64PatchBCond(words, failBranch, failWord, a64.A64CondNE):
        return false
    if !darwinSyscallProviderA64PatchCbnz(words, retryBranch, loopWord, a64.A64X5):
        return false
    add(words, darwinSyscallProviderA64Clrex())
    add(words, a64.A64EncMovz(false, a64.A64X0, 0, 0))
    add(words, a64.A64EncRet())
    return true

fn DarwinSyscallProviderEmitAtomicStoreI32(words: var int32[]) =
    add(words, darwinSyscallProviderA64StlrW(a64.A64X1, a64.A64X0))
    add(words, a64.A64EncRet())

fn DarwinSyscallProviderEmitAtomicLoadI32(words: var int32[]) =
    add(words, darwinSyscallProviderA64LdarW(a64.A64X0, a64.A64X0))
    add(words, a64.A64EncRet())

fn DarwinSyscallProviderEmitAtomicAddI32(words: var int32[]): bool =
    let loopWord = words.len
    add(words, a64.A64EncLdaxrW(a64.A64X4, a64.A64X0))
    add(words, a64.A64EncAddReg(false, a64.A64X5, a64.A64X4, a64.A64X1))
    add(words, a64.A64EncStlxrW(a64.A64X6, a64.A64X5, a64.A64X0))
    let retryBranch = words.len
    add(words, a64.A64EncNop())
    add(words, a64.A64EncOrrReg(false, a64.A64X0, a64.A64ZR, a64.A64X4))
    add(words, a64.A64EncRet())
    return darwinSyscallProviderA64PatchCbnz(words, retryBranch, loopWord, a64.A64X6)

fn darwinSyscallProviderErrorSymbolIndex(symbols: var osym.ObjectSymbolTable): int32 =
    let existing = osym.ObjectSymbolsFind(symbols, "___error")
    if existing >= 0:
        return existing
    return osym.ObjectSymbolsAddUndefined(symbols, "___error", true)

# Shared syscall result tail for the C-provider ABI contract (mirrors the
# cc-compiled host_runtime C shim): on entry x0 holds the raw svc result with
# XNU's carry-set error convention. Carry clear returns x0; carry set stores
# x0 into *___error() and returns -1.
fn DarwinSyscallProviderEmitErrnoTail(
        words: var int32[],
        symbols: var osym.ObjectSymbolTable,
        relocs: var orel.ObjectRelocTable): bool =
    let okBranch = words.len
    add(words, a64.A64EncNop())
    add(words, a64.A64EncOrrReg(true, a64.A64X9, a64.A64ZR, a64.A64X0))
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncSubImm(true, a64.A64SP, a64.A64SP, 32)):
        return false
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncStrImm(true, a64.A64LR, a64.A64SP, int64(0))):
        return false
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncStrImm(true, a64.A64X9, a64.A64SP, int64(8))):
        return false
    let errorIndex = darwinSyscallProviderErrorSymbolIndex(symbols)
    if errorIndex < 0:
        return false
    let callWord = words.len
    add(words, a64.A64EncBlPlaceholder())
    let _ = orel.ObjectRelocsAdd(
        relocs, 0, int64(callWord * 4), errorIndex,
        orel.ObjectRelocBranch26, 0, true)
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncLdrImm(true, a64.A64X9, a64.A64SP, int64(8))):
        return false
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncStrImm(false, a64.A64X9, a64.A64X0, int64(0))):
        return false
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncLdrImm(true, a64.A64LR, a64.A64SP, int64(0))):
        return false
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncAddImm(true, a64.A64SP, a64.A64SP, 32)):
        return false
    add(words, a64.A64EncMovn(false, a64.A64X0, 0, 0))
    add(words, a64.A64EncRet())
    let okWord = words.len
    if !darwinSyscallProviderA64PatchBCond(
           words, okBranch, okWord, a64.A64CondCC):
        return false
    add(words, a64.A64EncRet())
    return true

# EINVAL prologue shared by the fixed-arity shims (mirrors the C shim's
# `errno = EINVAL; return -1` guard).
fn DarwinSyscallProviderEmitEinvalReturn(
        words: var int32[],
        symbols: var osym.ObjectSymbolTable,
        relocs: var orel.ObjectRelocTable): bool =
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncSubImm(true, a64.A64SP, a64.A64SP, 16)):
        return false
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncStrImm(true, a64.A64LR, a64.A64SP, int64(0))):
        return false
    let errorIndex = darwinSyscallProviderErrorSymbolIndex(symbols)
    if errorIndex < 0:
        return false
    let callWord = words.len
    add(words, a64.A64EncBlPlaceholder())
    let _ = orel.ObjectRelocsAdd(
        relocs, 0, int64(callWord * 4), errorIndex,
        orel.ObjectRelocBranch26, 0, true)
    add(words, a64.A64EncMovz(false, a64.A64X9, 22, 0))
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncStrImm(false, a64.A64X9, a64.A64X0, int64(0))):
        return false
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncLdrImm(true, a64.A64LR, a64.A64SP, int64(0))):
        return false
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncAddImm(true, a64.A64SP, a64.A64SP, 16)):
        return false
    add(words, a64.A64EncMovn(false, a64.A64X0, 0, 0))
    add(words, a64.A64EncRet())
    return true

# cheng_host_openat_fixed(dir_fd, path, flags, mode): nil path -> EINVAL,
# else SYS_openat(463). Mirrors the cc C shim semantically.
fn DarwinSyscallProviderEmitOpenatFixed(
        words: var int32[],
        symbols: var osym.ObjectSymbolTable,
        relocs: var orel.ObjectRelocTable): bool =
    let nilBranch = words.len
    add(words, a64.A64EncNop())
    add(words, a64.A64EncMovz(true, a64.A64X16, 463, 0))
    add(words, a64.A64EncSvc(0x80))
    if !DarwinSyscallProviderEmitErrnoTail(words, symbols, relocs):
        return false
    let einvalWord = words.len
    if !darwinSyscallProviderA64PatchCbz(
           words, nilBranch, einvalWord, a64.A64X1, true):
        return false
    return DarwinSyscallProviderEmitEinvalReturn(words, symbols, relocs)

# cheng_host_getdents_fixed(fd, buf, cap): fd<0 || !buf || cap<=0 -> EINVAL,
# else getdirentries64(fd, buf, cap, &base) with base in a scratch slot,
# SYS_getdirentries64(344).
fn DarwinSyscallProviderEmitGetdentsFixed(
        words: var int32[],
        symbols: var osym.ObjectSymbolTable,
        relocs: var orel.ObjectRelocTable): bool =
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncCmpImm(false, a64.A64X0, 0)):
        return false
    let fdBranch = words.len
    add(words, a64.A64EncNop())
    let bufBranch = words.len
    add(words, a64.A64EncNop())
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncCmpImm(false, a64.A64X2, 0)):
        return false
    let capBranch = words.len
    add(words, a64.A64EncNop())
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncSubImm(true, a64.A64SP, a64.A64SP, 32)):
        return false
    add(words, a64.A64EncOrrReg(true, a64.A64X3, a64.A64ZR, a64.A64SP))
    add(words, a64.A64EncMovz(true, a64.A64X16, 344, 0))
    add(words, a64.A64EncSvc(0x80))
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncAddImm(true, a64.A64SP, a64.A64SP, 32)):
        return false
    if !DarwinSyscallProviderEmitErrnoTail(words, symbols, relocs):
        return false
    let einvalWord = words.len
    if !darwinSyscallProviderA64PatchBCond(
           words, fdBranch, einvalWord, a64.A64CondMI):
        return false
    if !darwinSyscallProviderA64PatchCbz(
           words, bufBranch, einvalWord, a64.A64X1, true):
        return false
    if !darwinSyscallProviderA64PatchBCond(
           words, capBranch, einvalWord, a64.A64CondLE):
        return false
    return DarwinSyscallProviderEmitEinvalReturn(words, symbols, relocs)

# cheng_host_renameat_noreplace_fixed(parent_fd, old_name, new_name):
# parent_fd<0 || !old || !new -> EINVAL, else
# renameatx_np(parent_fd, old, parent_fd, new, RENAME_EXCL=2),
# SYS_renameatx_np(488).
fn DarwinSyscallProviderEmitRenameatFixed(
        words: var int32[],
        symbols: var osym.ObjectSymbolTable,
        relocs: var orel.ObjectRelocTable): bool =
    if !darwinSyscallProviderAppendA64ResultWord(
           words, a64.A64EncCmpImm(false, a64.A64X0, 0)):
        return false
    let fdBranch = words.len
    add(words, a64.A64EncNop())
    let oldBranch = words.len
    add(words, a64.A64EncNop())
    let newBranch = words.len
    add(words, a64.A64EncNop())
    add(words, a64.A64EncOrrReg(true, a64.A64X3, a64.A64ZR, a64.A64X2))
    add(words, a64.A64EncOrrReg(true, a64.A64X2, a64.A64ZR, a64.A64X0))
    add(words, a64.A64EncMovz(true, a64.A64X4, 2, 0))
    add(words, a64.A64EncMovz(true, a64.A64X16, 488, 0))
    add(words, a64.A64EncSvc(0x80))
    if !DarwinSyscallProviderEmitErrnoTail(words, symbols, relocs):
        return false
    let einvalWord = words.len
    if !darwinSyscallProviderA64PatchBCond(
           words, fdBranch, einvalWord, a64.A64CondMI):
        return false
    if !darwinSyscallProviderA64PatchCbz(
           words, oldBranch, einvalWord, a64.A64X1, true):
        return false
    if !darwinSyscallProviderA64PatchCbz(
           words, newBranch, einvalWord, a64.A64X2, true):
        return false
    return DarwinSyscallProviderEmitEinvalReturn(words, symbols, relocs)

fn darwinSyscallProviderAddSymbol(symbols: var osym.ObjectSymbolTable,
                                  name: str,
                                  startWord: int32,
                                  endWord: int32) =
    let _idx = osym.ObjectSymbolsAddDefined(symbols,
                                            name,
                                            0,
                                            int64(startWord * 4),
                                            int64((endWord - startWord) * 4),
                                            true)

fn DarwinSyscallProviderEmitFunction(words: var int32[],
                                     symbols: var osym.ObjectSymbolTable,
                                     relocs: var orel.ObjectRelocTable,
                                     name: str,
                                     kind: int32): bool =
    let startWord = words.len
    if kind == 1:
        DarwinSyscallProviderEmitSyscallStub(words, 20)
    elif kind == 2:
        add(words, a64.A64EncMovz(true, a64.A64X2, 0, 0))
        DarwinSyscallProviderEmitSyscallStub(words, 116)
    elif kind == 3:
        DarwinSyscallProviderEmitSyscallStub(words, 10)
    elif kind == 4:
        DarwinSyscallProviderEmitSyscallStub(words, 37)
    elif kind == 5:
        if !DarwinSyscallProviderEmitCallIndirectVoid(words):
            return false
    elif kind == 6:
        if !DarwinSyscallProviderEmitCallIndirectI32(words):
            return false
    elif kind == 7:
        if !DarwinSyscallProviderEmitAtomicCasI32(words):
            return false
    elif kind == 8:
        DarwinSyscallProviderEmitAtomicStoreI32(words)
    elif kind == 9:
        DarwinSyscallProviderEmitAtomicLoadI32(words)
    elif kind == 10:
        if !DarwinSyscallProviderEmitAtomicAddI32(words):
            return false
    elif kind == 11:
        add(words, a64.A64EncFcvtzsWd(a64.A64X0, 0))
        add(words, a64.A64EncRet())
    elif kind == 12:
        add(words, a64.A64EncFcvtzsXd(a64.A64X0, 0))
        add(words, a64.A64EncRet())
    elif kind == 13:
        if !DarwinSyscallProviderEmitOpenatFixed(
               words, symbols, relocs):
            return false
    elif kind == 14:
        if !DarwinSyscallProviderEmitGetdentsFixed(
               words, symbols, relocs):
            return false
    elif kind == 15:
        if !DarwinSyscallProviderEmitRenameatFixed(
               words, symbols, relocs):
            return false
    else:
        return false
    darwinSyscallProviderAddSymbol(symbols, name, startWord, words.len)
    return true

fn darwinSyscallProviderWordsToBytes(words: int32[]): Bytes =
    var out = rawbytes.BytesAlloc(words.len * 4)
    for i in 0..<words.len:
        let raw = uint64(uint32(words[i]))
        let off = i * 4
        rawbytes.BytesSet(out, off, int32(raw & uint64(255)))
        rawbytes.BytesSet(out, off + 1, int32((raw >> uint64(8)) & uint64(255)))
        rawbytes.BytesSet(out, off + 2, int32((raw >> uint64(16)) & uint64(255)))
        rawbytes.BytesSet(out, off + 3, int32((raw >> uint64(24)) & uint64(255)))
    return out

@borrows
fn DarwinSyscallProviderWriteObject(rootDir: str,
                                    outPath: str): Result[bool] =
    if len(outPath) <= 0:
        return Err[bool]("backend driver direct: emit-darwin-syscall-provider missing --out")
    let parent = chengpath.PathParentDir(chengpath.PathAbsolute(rootDir, outPath))
    if len(parent) > 0 && !chengpath.MkdirP(rootDir, parent):
        return Err[bool](Fmt"backend driver direct: failed to create provider object parent: {outPath}")
    var words: int32[]
    var symbols = osym.ObjectSymbolsInit()
    var relocs = orel.ObjectRelocsInit()
    if !DarwinSyscallProviderEmitFunction(words, symbols, relocs, "_cheng_getpid", 1):
        return Err[bool]("backend driver direct: failed to emit _cheng_getpid")
    if !DarwinSyscallProviderEmitFunction(words, symbols, relocs, "_cheng_gettimeofday", 2):
        return Err[bool]("backend driver direct: failed to emit _cheng_gettimeofday")
    if !DarwinSyscallProviderEmitFunction(words, symbols, relocs, "_cheng_unlink", 3):
        return Err[bool]("backend driver direct: failed to emit _cheng_unlink")
    if !DarwinSyscallProviderEmitFunction(words, symbols, relocs, "_kill", 4):
        return Err[bool]("backend driver direct: failed to emit _kill")
    if !DarwinSyscallProviderEmitFunction(words, symbols, relocs, "___cheng_runtime_atomic_cas_i32", 7):
        return Err[bool]("backend driver direct: failed to emit ___cheng_runtime_atomic_cas_i32")
    if !DarwinSyscallProviderEmitFunction(words, symbols, relocs, "___cheng_runtime_atomic_store_i32", 8):
        return Err[bool]("backend driver direct: failed to emit ___cheng_runtime_atomic_store_i32")
    if !DarwinSyscallProviderEmitFunction(words, symbols, relocs, "___cheng_runtime_atomic_load_i32", 9):
        return Err[bool]("backend driver direct: failed to emit ___cheng_runtime_atomic_load_i32")
    if !DarwinSyscallProviderEmitFunction(words, symbols, relocs, "___cheng_runtime_atomic_add_i32", 10):
        return Err[bool]("backend driver direct: failed to emit ___cheng_runtime_atomic_add_i32")
    if !DarwinSyscallProviderEmitFunction(words, symbols, relocs, "_cheng_f64_to_i32", 11):
        return Err[bool]("backend driver direct: failed to emit _cheng_f64_to_i32")
    if !DarwinSyscallProviderEmitFunction(words, symbols, relocs, "_cheng_f64_to_i64", 12):
        return Err[bool]("backend driver direct: failed to emit _cheng_f64_to_i64")
    if !DarwinSyscallProviderEmitFunction(words, symbols, relocs, "_cheng_host_openat_fixed", 13):
        return Err[bool]("backend driver direct: failed to emit _cheng_host_openat_fixed")
    if !DarwinSyscallProviderEmitFunction(words, symbols, relocs, "_cheng_host_getdents_fixed", 14):
        return Err[bool]("backend driver direct: failed to emit _cheng_host_getdents_fixed")
    if !DarwinSyscallProviderEmitFunction(words, symbols, relocs, "_cheng_host_renameat_noreplace_fixed", 15):
        return Err[bool]("backend driver direct: failed to emit _cheng_host_renameat_noreplace_fixed")
    var text = darwinSyscallProviderWordsToBytes(words)
    let ownedRoot = strings.CloneStr(rootDir)
    let ownedOut = strings.CloneStr(outPath)
    let writeRes = macho.MachOTextObjectWrite(ownedRoot, ownedOut, text, symbols, relocs)
    if !writeRes.ok:
        return Err[bool]("backend driver direct: MachOTextObjectWrite failed")
    if !chengpath.FileExistsNonEmpty(rootDir, outPath):
        return Err[bool](Fmt"backend driver direct: emitted provider object missing: {outPath}")
    return Ok[bool](true)
