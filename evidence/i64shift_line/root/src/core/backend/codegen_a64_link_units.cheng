# codegen_a64_link_units.cheng —— 链接期 aarch64 编码原语直调门面（B7）
#
# 形态裁定（B2/B6 门面先例）：coff_object_linker / elf_object_linker 的链接期
# arch 钩子（蓝图 2.3 格式层暗道：_start 桩与导入桩的 BL 占位 / ADRP+LDR 字面
# 字）原直 import aarch64_encode；B7（2026-08-25）改经本门面一行直调转发——
# 零间接调用、零托管过槽，发射字节与原直调逐字节相同。与
# codegen_a64_body_units 分工：本族仅链接器所需的 3 个纯编码原语，刻意不
# import codegen_a64_fill_units（aarch64 单元），避免把 arch 单元拖入链接器
# 可达闭包（closure 间接边不增）。
#
# 归属：shared-format（先例=codegen_writer_units B2 / codegen_a64_body_units B6）。
import std/result
import cheng/core/backend/aarch64_encode as a64

fn CodegenA64LinkEncBlPlaceholder(): int32 =
    return a64.A64EncBlPlaceholder()

fn CodegenA64LinkEncAdrp(rd: int32): int32 =
    return a64.A64EncAdrp(rd)

fn CodegenA64LinkEncLdrImm(is64: bool, rt: int32, rn: int32, offsetBytes: int64): Result[int32] =
    return a64.A64EncLdrImm(is64, rt, rn, offsetBytes)
