import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/debug_emission_plan_evidence as evidence
import cheng/core/backend/debug_section_plan_receipt as planreceipt
import cheng/core/backend/semantic_snapshot_debug_binding_receipt as bindingreceipt

type
    DebugSectionPlanConsumption =
        valid: bool
        bindingReceipt: bindingreceipt.SemanticSnapshotDebugBindingReceipt
        sectionPlanReceipt: planreceipt.DebugSectionPlanReceipt

@borrows
fn DebugSectionPlanConsumptionBuildInto(
        lowering: lower.LoweringPlanStub,
        plan: evidence.DebugEmissionPlanEvidence,
        out: var DebugSectionPlanConsumption,
        err: var str): bool =
    out = DebugSectionPlanConsumption()
    err = ""
    if !lower.LoweringPlanPublishedDebugBindingReceiptStrictValidateInto(
           lowering, err):
        return false
    var receipt: planreceipt.DebugSectionPlanReceipt
    if !planreceipt.DebugSectionPlanReceiptBuildInto(
           lowering.semanticDebugBinding, lowering.semanticDebugFacts,
           plan, receipt, err) ||
       !planreceipt.DebugSectionPlanReceiptStrictValidateInto(
           receipt, lowering.semanticDebugBinding,
           lowering.semanticDebugFacts, plan, err):
        return false
    out.bindingReceipt = lowering.semanticDebugBinding
    out.sectionPlanReceipt = receipt
    out.valid = true
    return true

@borrows
fn DebugSectionPlanConsumptionStrictValidateInto(
        consumption: DebugSectionPlanConsumption,
        lowering: lower.LoweringPlanStub,
        plan: evidence.DebugEmissionPlanEvidence,
        err: var str): bool =
    var rebuilt: DebugSectionPlanConsumption
    if !DebugSectionPlanConsumptionBuildInto(
           lowering, plan, rebuilt, err):
        return false
    if !consumption.valid ||
       !bindingreceipt.SemanticSnapshotDebugBindingReceiptEqual(
           consumption.bindingReceipt, rebuilt.bindingReceipt) ||
       !planreceipt.DebugSectionPlanReceiptStrictValidateInto(
           consumption.sectionPlanReceipt, rebuilt.bindingReceipt,
           lowering.semanticDebugFacts, plan, err):
        if err == "":
            err = "debug section plan consumer: immutable receipt mismatch"
        return false
    return true
