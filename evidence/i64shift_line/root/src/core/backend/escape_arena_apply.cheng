# Step 3 P3 — arena routing apply executor (ghost-with-dead-wire).
#
# Status: SCAFFOLD / GHOST-WITH-DEAD-WIRE (lesson e4550c1b5 applied).
# Env gate CHENG_ESCAPE_ARENA_APPLY=1 default off.
#
# Design source: docs/beat-c.md §1.4.3 Step 3 P3.
#
# Companion to:
#   - escape_arena_route.cheng  (P1 escape classification)
#   - escape_arena_plan.cheng   (P2 per-slot arena id decision)
#
# Purpose: drive the per-slot routing decision into the BodyIR. Today the
# executor is a DRY-RUN simulator — it walks plan.entries, validates the
# slotIndex against bodyIR.localSlots, and accumulates mutatedSlots /
# arenaSlots / heapSlots counts. NO actual BodyIR field write happens
# in P3; the var BodyIR signature is reserved so the real apply step
# (P4 cross-session) can plug the slot allocator routing without touching
# call sites or lowering_plan dead-wire.
#
# Algorithm (dry-run simulation):
#   1. For each entry in plan.entries:
#      a. Reject entry whose slotIndex is out of range (counts as skipped).
#      b. mutatedSlots++  (count of slots a real apply WOULD touch).
#      c. If arenaId == ArenaIdHeap → heapSlots++.
#         Else                       → arenaSlots++.
#   2. Aggregate skipped count for diagnostics.
#
# Real apply (P4): replace the dry-run body with the actual slot allocator
# routing call (BodyIR.localSlots[i].arenaId = entry.arenaId or equivalent
# allocator hook). Codegen output may shift; bootstrap fp drift expected.
#
# Wiring plan (P4+):
#   1. lowering_plan dead-wire (this file) is already in place via
#      BuildLoweringPlanStubFromCompilerCsg.
#   2. PrimaryBodyIrPrepareA64LayoutMetricsInPlace gains env-gated call
#      to EscapeArenaApplyExecute(plan, bodyIR) after EscapeArenaPlanBuild.
#   3. The slot allocator (TBD module) reads the routing decision when
#      lowering generates the slot backing store.

import cheng/core/ir/core_types as coreir
import cheng/core/ir/escape_arena_plan as earplan
import std/os
import std/strings

const
    ArenaIdHeap = -1

type
    ArenaApplyResult =
        mutatedSlots: int32
        arenaSlots: int32
        heapSlots: int32
        skippedSlots: int32

fn EscapeArenaApplyExecute(plan: earplan.EscapeArenaPlan,
                            bodyIR: var coreir.BodyIR): ArenaApplyResult =
    var result: ArenaApplyResult
    result.mutatedSlots = 0
    result.arenaSlots = 0
    result.heapSlots = 0
    result.skippedSlots = 0

    let slotCap = bodyIR.localSlots.len
    for i in 0..<plan.entries.len:
        let entry = plan.entries[i]
        if entry.slotIndex < 0 || entry.slotIndex >= slotCap:
            result.skippedSlots = result.skippedSlots + 1
            continue
        # P3 dry-run: count what a real apply WOULD touch. No BodyIR
        # field write yet (var signature reserved for P4 real apply).
        result.mutatedSlots = result.mutatedSlots + 1
        if entry.arenaId == ArenaIdHeap:
            result.heapSlots = result.heapSlots + 1
        else:
            result.arenaSlots = result.arenaSlots + 1

    let _gate = os.GetEnv("CHENG_ESCAPE_ARENA_APPLY")
    if _gate == "1":
        var _line: str = "[escape-arena-apply] mutated="
        _line = _line + strings.IntToStr(result.mutatedSlots)
        _line = _line + " arena="
        _line = _line + strings.IntToStr(result.arenaSlots)
        _line = _line + " heap="
        _line = _line + strings.IntToStr(result.heapSlots)
        _line = _line + " skipped="
        _line = _line + strings.IntToStr(result.skippedSlots)
        os.WriteLine(os.GetStderr(), _line)

    return result

fn EscapeArenaApplyResultMutatedCount(result: ArenaApplyResult): int32 =
    return result.mutatedSlots

fn EscapeArenaApplyResultArenaCount(result: ArenaApplyResult): int32 =
    return result.arenaSlots

fn EscapeArenaApplyResultHeapCount(result: ArenaApplyResult): int32 =
    return result.heapSlots
