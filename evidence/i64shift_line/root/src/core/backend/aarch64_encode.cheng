import std/result
import std/system

const
    A64X0 = 0
    A64X1 = 1
    A64X2 = 2
    A64X3 = 3
    A64X4 = 4
    A64X5 = 5
    A64X6 = 6
    A64X7 = 7
    A64X8 = 8
    A64X9 = 9
    A64X10 = 10
    A64X11 = 11
    A64X12 = 12
    A64X13 = 13
    A64X14 = 14
    A64X15 = 15
    A64X16 = 16
    A64X17 = 17
    A64X19 = 19
    A64X20 = 20
    A64X21 = 21
    A64X22 = 22
    A64X23 = 23
    A64X24 = 24
    A64X25 = 25
    A64X26 = 26
    A64X27 = 27
    A64X28 = 28
    A64FP = 29
    A64LR = 30
    A64SP = 31
    A64ZR = 31
    A64CondEQ = 0
    A64CondNE = 1
    A64CondCS = 2
    A64CondHS = 2
    A64CondCC = 3
    A64CondLO = 3
    A64CondMI = 4
    A64CondPL = 5
    A64CondVS = 6
    A64CondVC = 7
    A64CondHI = 8
    A64CondLS = 9
    A64CondGE = 10
    A64CondLT = 11
    A64CondGT = 12
    A64CondLE = 13
    A64CondAL = 14
    A64CondNV = 15

fn a64AllOnes64(): uint64 =
    return uint64(0xffffffffffffffff)

fn a64RegOk(reg: int32): bool =
    return reg >= 0 && reg <= 31

fn a64Require(cond: bool, msg: str) =
    if !cond:
        panic(msg)

fn a64RequireReg(reg: int32) =
    let ok = a64RegOk(reg)
    a64Require(ok, " aarch64 encode: register out of range")

fn a64U32ToI32(raw: uint32): int32 =
    return int32(raw)

fn a64RegField(reg: int32, shift: int32): uint32 =
    a64RequireReg(reg)
    return uint32(reg) << uint32(shift)

fn a64ImmField(value: int32, mask: int32, shift: int32): uint32 =
    return uint32(value & mask) << uint32(shift)

fn a64RegFieldI32(reg: int32, shift: int32): int32 =
    a64RequireReg(reg)
    return reg << shift

fn a64ImmFieldI32(value: int32, mask: int32, shift: int32): int32 =
    return (value & mask) << shift

fn a64Make1(base: uint32, rd: int32): int32 =
    return a64U32ToI32(base | a64RegField(rd, 0))

fn a64Make2(base: uint32, rn: int32, rd: int32): int32 =
    return a64U32ToI32(base |
                   a64RegField(rn, 5) |
                   a64RegField(rd, 0))

fn a64Make3(base: uint32, rm: int32, rn: int32, rd: int32): int32 =
    return a64U32ToI32(base |
                   a64RegField(rm, 16) |
                   a64RegField(rn, 5) |
                   a64RegField(rd, 0))

fn a64RequireHw(is64: bool, hw: int32) =
    if is64:
        let lowOk = hw >= 0
        let highOk = hw <= 3
        let ok = lowOk && highOk
        a64Require(ok, " aarch64 encode: mov hw out of range")
    else:
        let lowOk = hw >= 0
        let highOk = hw <= 1
        let ok = lowOk && highOk
        a64Require(ok, " aarch64 encode: mov hw out of range")

fn a64RequireImm16(imm16: int32) =
    let lowOk = imm16 >= 0
    let highOk = imm16 <= 65535
    let ok = lowOk && highOk
    a64Require(ok, " aarch64 encode: imm16 out of range")

fn a64RequireImm12(imm12: int32) =
    let lowOk = imm12 >= 0
    let highOk = imm12 <= 4095
    let ok = lowOk && highOk
    a64Require(ok, " aarch64 encode: imm12 out of range")

fn a64CondOk(cond: int32): bool =
    return cond >= 0 && cond <= 15

fn a64CondInvert(cond: int32): int32 =
    return cond ^ 1

fn A64EncRet(): int32 =
    return a64U32ToI32(uint32(0xD65F03C0))

fn A64EncNop(): int32 =
    return a64U32ToI32(uint32(0xD503201F))

fn A64EncBlPlaceholder(): int32 =
    return a64U32ToI32(uint32(0x94000000))

fn A64EncBPlaceholder(): int32 =
    return a64U32ToI32(uint32(0x14000000))

fn A64EncBlr(rn: int32): int32 =
    return a64U32ToI32(uint32(0xD63F0000) | a64RegField(rn, 5))

fn A64EncBr(rn: int32): int32 =
    return a64U32ToI32(uint32(0xD61F0000) | a64RegField(rn, 5))

fn A64EncBImm(deltaWords: int64): Result[int32] =
    if deltaWords < -33554432 || deltaWords > 33554431:
        return Err[int32](" aarch64 encode: b offset out of range")
    let imm26: uint32 = uint32(uint64(deltaWords) & uint64(0x03ffffff))
    return Ok[int32](a64U32ToI32(uint32(0x14000000) | imm26))

fn A64EncBCond(deltaWords: int64, cond: int32): Result[int32] =
    if !a64CondOk(cond):
        return Err[int32](" aarch64 encode: condition out of range")
    if deltaWords < -262144 || deltaWords > 262143:
        return Err[int32](" aarch64 encode: b.cond offset out of range")
    let imm19: uint32 = uint32(uint64(deltaWords) & uint64(0x7ffff))
    return Ok[int32](a64U32ToI32(uint32(0x54000000) |
                             (imm19 << uint32(5)) |
                             uint32(cond)))

fn A64EncCbz(is64: bool, rt: int32, deltaWords: int64): Result[int32] =
    if !a64RegOk(rt):
        return Err[int32](" aarch64 encode: cbz register out of range")
    if deltaWords < -262144 || deltaWords > 262143:
        return Err[int32](" aarch64 encode: cbz offset out of range")
    let base: uint32 = is64 ? uint32(0xB4000000) : uint32(0x34000000)
    let imm19: uint32 = uint32(uint64(deltaWords) & uint64(0x7ffff))
    return Ok[int32](a64U32ToI32(base |
                             (imm19 << uint32(5)) |
                             a64RegField(rt, 0)))

fn A64EncCbnz(is64: bool, rt: int32, deltaWords: int64): Result[int32] =
    if !a64RegOk(rt):
        return Err[int32](" aarch64 encode: cbnz register out of range")
    if deltaWords < -262144 || deltaWords > 262143:
        return Err[int32](" aarch64 encode: cbnz offset out of range")
    let base: uint32 = is64 ? uint32(0xB5000000) : uint32(0x35000000)
    let imm19: uint32 = uint32(uint64(deltaWords) & uint64(0x7ffff))
    return Ok[int32](a64U32ToI32(base |
                             (imm19 << uint32(5)) |
                             a64RegField(rt, 0)))

fn A64EncMovz(is64: bool, rd: int32, imm16: int32, hw: int32): int32 =
    a64RequireReg(rd)
    a64RequireImm16(imm16)
    a64RequireHw(is64, hw)
    if !is64:
        return 1384120320 |
               a64ImmFieldI32(hw, 3, 21) |
               a64ImmFieldI32(imm16, 0xffff, 5) |
               a64RegFieldI32(rd, 0)
    let base: uint32 = uint32(0xD2800000)
    return a64U32ToI32(base |
                   a64ImmField(hw, 3, 21) |
                   a64ImmField(imm16, 0xffff, 5) |
                   a64RegField(rd, 0))

fn A64EncMovn(is64: bool, rd: int32, imm16: int32, hw: int32): int32 =
    a64RequireReg(rd)
    a64RequireImm16(imm16)
    a64RequireHw(is64, hw)
    let base: uint32 = is64 ? uint32(0x92800000) : uint32(0x12800000)
    return a64U32ToI32(base |
                   a64ImmField(hw, 3, 21) |
                   a64ImmField(imm16, 0xffff, 5) |
                   a64RegField(rd, 0))

fn A64EncMovk(is64: bool, rd: int32, imm16: int32, hw: int32): int32 =
    a64RequireReg(rd)
    a64RequireImm16(imm16)
    a64RequireHw(is64, hw)
    let base: uint32 = is64 ? uint32(0xF2800000) : uint32(0x72800000)
    return a64U32ToI32(base |
                   a64ImmField(hw, 3, 21) |
                   a64ImmField(imm16, 0xffff, 5) |
                   a64RegField(rd, 0))

fn A64MovImmWordCount(is64: bool, imm: int64): int32 =
    var count: int32 = 1
    let limit: int32 = is64 ? 4 : 2
    let v: uint64 = uint64(imm)
    for hw in 1..<limit:
        let part: uint64 = (v >> uint64(hw * 16)) & uint64(0xffff)
        if part != uint64(0):
            count = count + 1
    return count

fn A64EncAddImm(is64: bool, rd: int32, rn: int32, imm12: int32): Result[int32] =
    if !a64RegOk(rd) || !a64RegOk(rn):
        return Err[int32](" aarch64 encode: register out of range")
    if imm12 < 0 || imm12 > 4095:
        return Err[int32](" aarch64 encode: add imm12 out of range")
    let base: uint32 = is64 ? uint32(0x91000000) : uint32(0x11000000)
    return Ok[int32](a64U32ToI32(base |
                             a64ImmField(imm12, 0xfff, 10) |
                             a64RegField(rn, 5) |
                             a64RegField(rd, 0)))

fn A64EncSubImm(is64: bool, rd: int32, rn: int32, imm12: int32): Result[int32] =
    if !a64RegOk(rd) || !a64RegOk(rn):
        return Err[int32](" aarch64 encode: register out of range")
    if imm12 < 0 || imm12 > 4095:
        return Err[int32](" aarch64 encode: sub imm12 out of range")
    let base: uint32 = is64 ? uint32(0xD1000000) : uint32(0x51000000)
    return Ok[int32](a64U32ToI32(base |
                             a64ImmField(imm12, 0xfff, 10) |
                             a64RegField(rn, 5) |
                             a64RegField(rd, 0)))

fn A64EncAddReg(is64: bool, rd: int32, rn: int32, rm: int32): int32 =
    let base: uint32 = is64 ? uint32(0x8B000000) : uint32(0x0B000000)
    return a64Make3(base, rm, rn, rd)

fn A64EncSubReg(is64: bool, rd: int32, rn: int32, rm: int32): int32 =
    let base: uint32 = is64 ? uint32(0xCB000000) : uint32(0x4B000000)
    return a64Make3(base, rm, rn, rd)

fn A64EncAndReg(is64: bool, rd: int32, rn: int32, rm: int32): int32 =
    let base: uint32 = is64 ? uint32(0x8A000000) : uint32(0x0A000000)
    return a64Make3(base, rm, rn, rd)

fn A64EncOrrReg(is64: bool, rd: int32, rn: int32, rm: int32): int32 =
    let base: uint32 = is64 ? uint32(0xAA000000) : uint32(0x2A000000)
    return a64Make3(base, rm, rn, rd)

fn A64EncMul(is64: bool, rd: int32, rn: int32, rm: int32): int32 =
    let base: uint32 = is64 ? uint32(0x9B007C00) : uint32(0x1B007C00)
    return a64Make3(base, rm, rn, rd)

fn A64EncMadd(is64: bool, rd: int32, rn: int32, rm: int32, ra: int32): int32 =
    let base: uint32 = is64 ? uint32(0x9B000000) : uint32(0x1B000000)
    return a64U32ToI32(base |
                   a64RegField(rm, 16) |
                   a64RegField(ra, 10) |
                   a64RegField(rn, 5) |
                   a64RegField(rd, 0))

fn A64EncMsub(is64: bool, rd: int32, rn: int32, rm: int32, ra: int32): int32 =
    let base: uint32 = is64 ? uint32(0x9B008000) : uint32(0x1B008000)
    return a64U32ToI32(base |
                   a64RegField(rm, 16) |
                   a64RegField(ra, 10) |
                   a64RegField(rn, 5) |
                   a64RegField(rd, 0))

fn A64EncAsrv(is64: bool, rd: int32, rn: int32, rm: int32): int32 =
    let base: uint32 = is64 ? uint32(0x9AC02800) : uint32(0x1AC02800)
    return a64Make3(base, rm, rn, rd)

fn A64EncCmpReg(is64: bool, rn: int32, rm: int32): int32 =
    let base: uint32 = is64 ? uint32(0xEB00001F) : uint32(0x6B00001F)
    return a64U32ToI32(base |
                   a64RegField(rm, 16) |
                   a64RegField(rn, 5))

fn A64EncCmpImm(is64: bool, rn: int32, imm12: int32): Result[int32] =
    if !a64RegOk(rn):
        return Err[int32](" aarch64 encode: cmp imm register out of range")
    if imm12 < 0 || imm12 > 4095:
        return Err[int32](" aarch64 encode: cmp imm12 out of range")
    let base: uint32 = is64 ? uint32(0xF100001F) : uint32(0x7100001F)
    return Ok[int32](a64U32ToI32(base |
                             a64ImmField(imm12, 0xfff, 10) |
                             a64RegField(rn, 5)))

fn A64EncCsel(is64: bool, rd: int32, rn: int32, rm: int32, cond: int32): Result[int32] =
    if !a64RegOk(rd) || !a64RegOk(rn) || !a64RegOk(rm):
        return Err[int32](" aarch64 encode: csel register out of range")
    if !a64CondOk(cond):
        return Err[int32](" aarch64 encode: csel condition out of range")
    let base: uint32 = is64 ? uint32(0x9A800000) : uint32(0x1A800000)
    return Ok[int32](a64U32ToI32(base |
                             a64RegField(rm, 16) |
                             a64ImmField(cond, 0xf, 12) |
                             a64RegField(rn, 5) |
                             a64RegField(rd, 0)))

fn A64EncFmovDx(rd: int32, rn: int32): int32 =
    return a64Make2(uint32(0x9E670000), rn, rd)

fn A64EncFmovXd(rd: int32, rn: int32): int32 =
    return a64Make2(uint32(0x9E660000), rn, rd)

fn A64EncFcmpD(rn: int32, rm: int32): int32 =
    return a64U32ToI32(uint32(0x1E602000) |
                   a64RegField(rm, 16) |
                   a64RegField(rn, 5))

fn A64EncFaddD(rd: int32, rn: int32, rm: int32): int32 =
    return a64Make3(uint32(0x1E602800), rm, rn, rd)

fn A64EncFsubD(rd: int32, rn: int32, rm: int32): int32 =
    return a64Make3(uint32(0x1E603800), rm, rn, rd)

fn A64EncFmulD(rd: int32, rn: int32, rm: int32): int32 =
    return a64Make3(uint32(0x1E600800), rm, rn, rd)

fn A64EncFdivD(rd: int32, rn: int32, rm: int32): int32 =
    return a64Make3(uint32(0x1E601800), rm, rn, rd)

fn A64EncFnegD(rd: int32, rn: int32): int32 =
    return a64Make2(uint32(0x1E614000), rn, rd)

# --- ARMv8 AES + 128-bit SIMD load/store (Path C: hardware AES-128 block encrypt) ---
# Byte-verified vs `clang -c -target arm64-apple-darwin` + `otool -t`:
#   aese.16b v0,v1=4e284820 ; aesmc.16b v0,v0=4e286800 ; eor.16b v0,v0,v1=6e211c00
#   ldr q0,[x0]=3dc00000 ; str q0,[x0]=3d800000 ; ldr q1,[x1,#16]=3dc00421
# AES/EOR reg args are V-reg indices; for LDR/STR Q rt is the Q-reg index, rn the GP base.
fn A64EncAese(vd: int32, vn: int32): int32 =
    return a64Make2(uint32(0x4E284800), vn, vd)

fn A64EncAesmc(vd: int32, vn: int32): int32 =
    return a64Make2(uint32(0x4E286800), vn, vd)

fn A64EncEorV16b(vd: int32, vn: int32, vm: int32): int32 =
    return a64Make3(uint32(0x6E201C00), vm, vn, vd)

# LDR Qt, [Xn, #imm] : imm a multiple of 16, 0..65520.
fn A64EncLdrQ(rt: int32, rn: int32, imm: int32): int32 =
    a64Require(imm >= 0, " aarch64 encode: ldr q imm out of range")
    a64Require(imm <= 65520, " aarch64 encode: ldr q imm out of range")
    let ldrQImmLow = imm & 15
    a64Require(ldrQImmLow == 0, " aarch64 encode: ldr q imm not 16-aligned")
    return a64U32ToI32(uint32(0x3DC00000) |
                   (uint32(imm / 16) << uint32(10)) |
                   a64RegField(rn, 5) |
                   a64RegField(rt, 0))

fn A64EncStrQ(rt: int32, rn: int32, imm: int32): int32 =
    a64Require(imm >= 0, " aarch64 encode: str q imm out of range")
    a64Require(imm <= 65520, " aarch64 encode: str q imm out of range")
    let strQImmLow = imm & 15
    a64Require(strQImmLow == 0, " aarch64 encode: str q imm not 16-aligned")
    return a64U32ToI32(uint32(0x3D800000) |
                   (uint32(imm / 16) << uint32(10)) |
                   a64RegField(rn, 5) |
                   a64RegField(rt, 0))

# --- ARMv8 SHA-256 crypto extension + supporting AdvSIMD ops (Path C follow-on: hardware
# SHA-256 block compress). Byte-verified vs `clang -c -target arm64-apple-darwin` + `otool -t`
# across 3 register combos each (q0/q1/v2, q3/q4/v5, q10/q11/v12):
#   sha256h q0,q1,v2.4s=5e024020 ; sha256h2 q0,q1,v2.4s=5e025020 ; sha256su1 v0.4s,v1.4s,v2.4s=5e026020
#   sha256su0 v0.4s,v1.4s=5e282820 ; rev32 v0.16b,v1.16b=6e200820 ; add v0.4s,v1.4s,v2.4s=4ea28420
#   mov v0.16b,v1.16b=4ea11c20 (alias ORR Vd.16b,Vn.16b,Vn.16b, Vm field mirrors Vn)
# Full single/multi-block compression kernel built from exactly these 7 ops (plus the existing
# A64EncLdrQ/A64EncStrQ) reproduces FIPS 180-4 "abc"/empty/2-block vectors byte-for-byte on
# native ARMv8+SHA2 hardware (Apple M4 Pro, hw.optional.arm.FEAT_SHA256=1) — confirms EXT is
# NOT required: SHA256SU0/SU1 do the 1-lane cross-register shift internally (Vn wraps into Vm).
fn A64EncSha256H(vd: int32, vn: int32, vm: int32): int32 =
    return a64Make3(uint32(0x5E004000), vm, vn, vd)

fn A64EncSha256H2(vd: int32, vn: int32, vm: int32): int32 =
    return a64Make3(uint32(0x5E005000), vm, vn, vd)

fn A64EncSha256Su0(vd: int32, vn: int32): int32 =
    return a64Make2(uint32(0x5E282800), vn, vd)

fn A64EncSha256Su1(vd: int32, vn: int32, vm: int32): int32 =
    return a64Make3(uint32(0x5E006000), vm, vn, vd)

fn A64EncRev32V16b(vd: int32, vn: int32): int32 =
    return a64Make2(uint32(0x6E200800), vn, vd)

fn A64EncAddV4s(vd: int32, vn: int32, vm: int32): int32 =
    # base corrected 0x4EA28400 -> 0x4EA08400: the old base had stray bit17 (Vm's bit1) baked in,
    # which the single verified vd=0/vn=1/vm=2 combo could not catch (vm=2's bit1 is already 1, so
    # the OR was a no-op there). Cross-checked against clang -target arm64-apple-darwin + otool -t
    # for "add v20.4s, v4.4s, v16.4s" (vm=16, bit1=0) = 4eb08494, and independently re-derived from
    # the AdvSIMD three-same (integer) ADD encoding (Q=1,U=0,size=10,opcode=10000): both give
    # 0x4EA08400. The buggy base corrupted every `add.4s` call whose vm has bit1=0 (e.g. vm=16),
    # discovered via the SHA-256 kernel's k256 register (v16) producing wrong digests end-to-end.
    return a64Make3(uint32(0x4EA08400), vm, vn, vd)

fn A64EncMovV16b(vd: int32, vn: int32): int32 =
    return a64Make3(uint32(0x4EA01C00), vn, vn, vd)

fn A64EncScvtfDx(rd: int32, rn: int32): int32 =
    return a64Make2(uint32(0x9E620000), rn, rd)

fn A64EncScvtfDw(rd: int32, rn: int32): int32 =
    return a64Make2(uint32(0x1E620000), rn, rd)

# UCVTF Dd,Xn / Dd,Wn: unsigned-integer counterpart of SCVTF above (opcode
# field 011 vs SCVTF's 010, same "conversion between floating-point and
# integer" encoding family). #95 wave5: SCVTF on a uint32/uint64 value with
# the high bit set silently produces a negative float64 -- bases verified by
# assembling "ucvtf d0, w0"/"ucvtf d0, x0" with the host arm64 `as` and
# reading the real encoded words back via `otool -t` (0x1e630000/0x9e630000),
# not hand-derived from the manual alone.
fn A64EncUcvtfDx(rd: int32, rn: int32): int32 =
    return a64Make2(uint32(0x9E630000), rn, rd)

fn A64EncUcvtfDw(rd: int32, rn: int32): int32 =
    return a64Make2(uint32(0x1E630000), rn, rd)

# FCVTZS Wd,Dn / Xd,Dn: round-toward-zero float64 -> fixed-width signed int.
# Bases byte-verified in bootstrap/cheng_cold.c (a64_fcvtzs_wd/inline I64_FROM_F64
# 0x9E780000 literal), used by the cold backend's native F64->int BodyOps. #68:
# the warm backend has no such BodyOp — pure casts synthesize a CallOp to
# cheng_f64_to_i32/i64 instead — so these encoders back the inline recognizer
# that replaces that CallOp's `bl` with the real instruction (arg already sits
# in d0 per the #73 AAPCS64 fmov fix; result lands in w0/x0 exactly as a `bl`
# would have left it).
fn A64EncFcvtzsWd(rd: int32, rn: int32): int32 =
    return a64Make2(uint32(0x1E780000), rn, rd)

fn A64EncFcvtzsXd(rd: int32, rn: int32): int32 =
    return a64Make2(uint32(0x9E780000), rn, rd)

fn A64EncSvc(imm16: int32): int32 =
    return a64U32ToI32(uint32(0xD4000001) |
                   a64ImmField(imm16, 0xffff, 5))

fn A64EncLdaxrW(rt: int32, rn: int32): int32 =
    return a64U32ToI32(uint32(0x885FFC00) |
                   a64RegField(rn, 5) |
                   a64RegField(rt, 0))

fn A64EncStlxrW(rs: int32, rt: int32, rn: int32): int32 =
    return a64U32ToI32(uint32(0x8800FC00) |
                   a64RegField(rs, 16) |
                   a64RegField(rn, 5) |
                   a64RegField(rt, 0))

fn A64EncLdaddalW(rs: int32, rt: int32, rn: int32): int32 =
    return a64U32ToI32(uint32(0xB8E00000) |
                   a64RegField(rs, 16) |
                   a64RegField(rn, 5) |
                   a64RegField(rt, 0))

fn A64EncEorReg(is64: bool, rd: int32, rn: int32, rm: int32): int32 =
    let base: uint32 = is64 ? uint32(0xCA000000) : uint32(0x4A000000)
    return a64Make3(base, rm, rn, rd)

fn A64EncSdiv(is64: bool, rd: int32, rn: int32, rm: int32): int32 =
    let base: uint32 = is64 ? uint32(0x9AC00C00) : uint32(0x1AC00C00)
    return a64Make3(base, rm, rn, rd)

fn A64EncUdiv(is64: bool, rd: int32, rn: int32, rm: int32): int32 =
    let base: uint32 = is64 ? uint32(0x9AC00800) : uint32(0x1AC00800)
    return a64Make3(base, rm, rn, rd)

fn A64EncSxtw(rd: int32, rn: int32): int32 =
    return a64Make2(uint32(0x93407C00), rn, rd)

fn A64EncLslv(is64: bool, rd: int32, rn: int32, rm: int32): int32 =
    let base: uint32 = is64 ? uint32(0x9AC02000) : uint32(0x1AC02000)
    return a64Make3(base, rm, rn, rd)

fn A64EncLsrv(is64: bool, rd: int32, rn: int32, rm: int32): int32 =
    let base: uint32 = is64 ? uint32(0x9AC02400) : uint32(0x1AC02400)
    return a64Make3(base, rm, rn, rd)

fn A64EncStrbImm(rt: int32, rn: int32, offsetBytes: int32): Result[int32] =
    if offsetBytes < 0 || offsetBytes > 4095:
        return Err[int32](" aarch64 encode: strb offset out of range")
    return Ok[int32](a64U32ToI32(uint32(0x39000000) |
                             a64ImmField(offsetBytes, 0xfff, 10) |
                             a64RegField(rn, 5) |
                             a64RegField(rt, 0)))

fn A64EncLdrbImm(rt: int32, rn: int32, offsetBytes: int32): Result[int32] =
    if offsetBytes < 0 || offsetBytes > 4095:
        return Err[int32](" aarch64 encode: ldrb offset out of range")
    return Ok[int32](a64U32ToI32(uint32(0x39400000) |
                             a64ImmField(offsetBytes, 0xfff, 10) |
                             a64RegField(rn, 5) |
                             a64RegField(rt, 0)))

fn A64EncLdrsbImm(rt: int32, rn: int32, offsetBytes: int32): Result[int32] =
    if offsetBytes < 0 || offsetBytes > 4095:
        return Err[int32](" aarch64 encode: ldrsb offset out of range")
    return Ok[int32](a64U32ToI32(uint32(0x39C00000) |
                             a64ImmField(offsetBytes, 0xfff, 10) |
                             a64RegField(rn, 5) |
                             a64RegField(rt, 0)))

fn A64EncStrhImm(rt: int32, rn: int32, offsetBytes: int32): Result[int32] =
    if offsetBytes < 0 || offsetBytes % 2 != 0:
        return Err[int32](" aarch64 encode: strh offset not aligned")
    let imm12: int32 = offsetBytes / 2
    if imm12 < 0 || imm12 > 4095:
        return Err[int32](" aarch64 encode: strh offset out of range")
    return Ok[int32](a64U32ToI32(uint32(0x79000000) |
                             a64ImmField(imm12, 0xfff, 10) |
                             a64RegField(rn, 5) |
                             a64RegField(rt, 0)))

fn A64EncLdrhImm(rt: int32, rn: int32, offsetBytes: int32): Result[int32] =
    if offsetBytes < 0 || offsetBytes % 2 != 0:
        return Err[int32](" aarch64 encode: ldrh offset not aligned")
    let imm12: int32 = offsetBytes / 2
    if imm12 < 0 || imm12 > 4095:
        return Err[int32](" aarch64 encode: ldrh offset out of range")
    return Ok[int32](a64U32ToI32(uint32(0x79400000) |
                             a64ImmField(imm12, 0xfff, 10) |
                             a64RegField(rn, 5) |
                             a64RegField(rt, 0)))

fn A64EncLdrshImm(rt: int32, rn: int32, offsetBytes: int32): Result[int32] =
    if offsetBytes < 0 || offsetBytes % 2 != 0:
        return Err[int32](" aarch64 encode: ldrsh offset not aligned")
    let imm12: int32 = offsetBytes / 2
    if imm12 < 0 || imm12 > 4095:
        return Err[int32](" aarch64 encode: ldrsh offset out of range")
    return Ok[int32](a64U32ToI32(uint32(0x79C00000) |
                             a64ImmField(imm12, 0xfff, 10) |
                             a64RegField(rn, 5) |
                             a64RegField(rt, 0)))

fn A64EncStrImm(is64: bool, rt: int32, rn: int32, offsetBytes: int64): Result[int32] =
    if !a64RegOk(rt) || !a64RegOk(rn):
        return Err[int32](" aarch64 encode: register out of range")
    if offsetBytes < 0 || offsetBytes > int64(32760):
        return Err[int32](" aarch64 encode: str offset out of range")
    let scale: int32 = is64 ? 8 : 4
    let offsetI32: int32 = int32(offsetBytes)
    if offsetI32 % scale != 0:
        return Err[int32](" aarch64 encode: str offset not aligned")
    let imm12: int32 = offsetI32 / scale
    if imm12 < 0 || imm12 > 4095:
        return Err[int32](" aarch64 encode: str offset out of range")
    let base: uint32 = is64 ? uint32(0xF9000000) : uint32(0xB9000000)
    return Ok[int32](a64U32ToI32(base |
                             a64ImmField(imm12, 0xfff, 10) |
                             a64RegField(rn, 5) |
                             a64RegField(rt, 0)))

fn A64EncStrImmValue(is64: bool, rt: int32, rn: int32, offsetBytes: int32): int32 =
    a64RequireReg(rt)
    a64RequireReg(rn)
    let scale: int32 = is64 ? 8 : 4
    a64Require(offsetBytes >= 0, " aarch64 encode: str offset out of range")
    a64Require(offsetBytes % scale == 0, " aarch64 encode: str offset not aligned")
    let imm12: int32 = offsetBytes / scale
    let immLowOk = imm12 >= 0
    let immHighOk = imm12 <= 4095
    let immOk = immLowOk && immHighOk
    a64Require(immOk, " aarch64 encode: str offset out of range")
    let base: uint32 = is64 ? uint32(0xF9000000) : uint32(0xB9000000)
    return a64U32ToI32(base |
                   a64ImmField(imm12, 0xfff, 10) |
                   a64RegField(rn, 5) |
                   a64RegField(rt, 0))

fn A64EncLdrImm(is64: bool, rt: int32, rn: int32, offsetBytes: int64): Result[int32] =
    if !a64RegOk(rt) || !a64RegOk(rn):
        return Err[int32](" aarch64 encode: register out of range")
    if offsetBytes < 0 || offsetBytes > int64(32760):
        return Err[int32](" aarch64 encode: ldr offset out of range")
    let scale: int32 = is64 ? 8 : 4
    let offsetI32: int32 = int32(offsetBytes)
    if offsetI32 % scale != 0:
        return Err[int32](" aarch64 encode: ldr offset not aligned")
    let imm12: int32 = offsetI32 / scale
    if imm12 < 0 || imm12 > 4095:
        return Err[int32](" aarch64 encode: ldr offset out of range")
    let base: uint32 = is64 ? uint32(0xF9400000) : uint32(0xB9400000)
    return Ok[int32](a64U32ToI32(base |
                             a64ImmField(imm12, 0xfff, 10) |
                             a64RegField(rn, 5) |
                             a64RegField(rt, 0)))

fn A64EncLdrswImm(rt: int32, rn: int32, offsetBytes: int64): Result[int32] =
    if !a64RegOk(rt) || !a64RegOk(rn):
        return Err[int32](" aarch64 encode: ldrsw register out of range")
    if offsetBytes < 0 || offsetBytes > int64(16380):
        return Err[int32](" aarch64 encode: ldrsw offset out of range")
    let offsetI32: int32 = int32(offsetBytes)
    if offsetI32 % 4 != 0:
        return Err[int32](" aarch64 encode: ldrsw offset not aligned")
    let imm12: int32 = offsetI32 / 4
    if imm12 < 0 || imm12 > 4095:
        return Err[int32](" aarch64 encode: ldrsw offset out of range")
    return Ok[int32](a64U32ToI32(uint32(0xB9800000) |
                             a64ImmField(imm12, 0xfff, 10) |
                             a64RegField(rn, 5) |
                             a64RegField(rt, 0)))

fn A64EncAdrp(rd: int32): int32 =
    return a64Make1(uint32(0x90000000), rd)

fn a64EncPair64(base: uint32,
                 rt: int32,
                 rt2: int32,
                 rn: int32,
                 offsetBytes: int64,
                 label: str): Result[int32] =
    if !a64RegOk(rt) || !a64RegOk(rt2) || !a64RegOk(rn):
        return Err[int32](" aarch64 encode: register out of range")
    if offsetBytes < -512 || offsetBytes > 504:
        if label == "stp":
            return Err[int32](" aarch64 encode: stp offset out of range")
        return Err[int32](" aarch64 encode: ldp offset out of range")
    let offsetI32: int32 = int32(offsetBytes)
    if offsetI32 % 8 != 0:
        if label == "stp":
            return Err[int32](" aarch64 encode: stp offset out of range")
        return Err[int32](" aarch64 encode: ldp offset out of range")
    let imm7 = offsetI32 / 8
    return Ok[int32](a64U32ToI32(base |
                             a64ImmField(imm7, 0x7f, 15) |
                             a64RegField(rt2, 10) |
                             a64RegField(rn, 5) |
                             a64RegField(rt, 0)))

fn A64EncStp64PreIndex(rt: int32, rt2: int32, rn: int32, offsetBytes: int64): Result[int32] =
    return a64EncPair64(uint32(0xA9800000), rt, rt2, rn, offsetBytes, "stp")

fn A64EncLdp64PostIndex(rt: int32, rt2: int32, rn: int32, offsetBytes: int64): Result[int32] =
    return a64EncPair64(uint32(0xA8C00000), rt, rt2, rn, offsetBytes, "ldp")

fn A64EncStp64(rt: int32, rt2: int32, rn: int32, offsetBytes: int64): Result[int32] =
    return a64EncPair64(uint32(0xA9000000), rt, rt2, rn, offsetBytes, "stp")

fn A64EncLdp64(rt: int32, rt2: int32, rn: int32, offsetBytes: int64): Result[int32] =
    return a64EncPair64(uint32(0xA9400000), rt, rt2, rn, offsetBytes, "ldp")

fn a64MaskBits(width: int32): uint64 =
    if width >= 64:
        return a64AllOnes64()
    return (uint64(1) << uint64(width)) - uint64(1)

fn a64RorBits(value: uint64, rot: int32, width: int32): uint64 =
    let mask = a64MaskBits(width)
    let r = rot % width
    let v = value & mask
    if r == 0:
        return v
    return ((v >> uint64(r)) | (v << uint64(width - r))) & mask

fn a64ReplicateElement(element: uint64, width: int32): uint64 =
    var out: uint64
    let count = 64 / width
    for i in 0..<count:
        out = out | ((element & a64MaskBits(width)) << uint64(i * width))
    return out

fn a64LogicalImm64(imm: uint64,
                    nOut: var int32,
                    immrOut: var int32,
                    immsOut: var int32): bool =
    if imm == uint64(0) || imm == a64AllOnes64():
        return false
    for lenBits in 1..<7:
        let width = 1 << lenBits
        let nValue: int32 = width == 64 ? 1 : 0
        let immsPrefix = (0 - (1 << (lenBits + 1))) & 0x3f
        for ones in 1..<width:
            let baseElement = a64MaskBits(ones)
            let immsValue = immsPrefix | (ones - 1)
            for rot in 0..<width:
                let element = a64RorBits(baseElement, rot, width)
                if a64ReplicateElement(element, width) == imm:
                    nOut = nValue
                    immrOut = rot
                    immsOut = immsValue
                    return true
    return false

fn A64EncTstImm64(rn: int32, imm: uint64): Result[int32] =
    if !a64RegOk(rn):
        return Err[int32](" aarch64 encode: register out of range")
    var nValue: int32
    var immrValue: int32
    var immsValue: int32
    if !a64LogicalImm64(imm, nValue, immrValue, immsValue):
        return Err[int32](" aarch64 encode: logical immediate out of range")
    return Ok[int32](a64U32ToI32(uint32(0xF200001F) |
                             a64ImmField(nValue, 1, 22) |
                             a64ImmField(immrValue, 0x3f, 16) |
                             a64ImmField(immsValue, 0x3f, 10) |
                             a64RegField(rn, 5)))

fn A64EncCset(rd: int32, cond: int32): Result[int32] =
    if !a64RegOk(rd):
        return Err[int32](" aarch64 encode: register out of range")
    if cond < 0 || cond > 13:
        return Err[int32](" aarch64 encode: cset condition out of range")
    return Ok[int32](a64U32ToI32(uint32(0x1A800400) |
                             a64RegField(A64ZR, 16) |
                             a64ImmField(a64CondInvert(cond), 0xf, 12) |
                             a64RegField(A64ZR, 5) |
                             a64RegField(rd, 0)))
