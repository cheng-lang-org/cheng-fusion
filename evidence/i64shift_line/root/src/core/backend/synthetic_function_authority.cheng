import std/seqs
import std/crypto/hash256
import cheng/std/bytes_layout as layout
import cheng/core/runtime/arena as arenamod
import cheng/core/backend/provider_export_identity_receipt as peir
import cheng/core/backend/provider_export_identity_import as peii

const
    SyntheticFunctionAuthoritySchemaVersion = 1
    SyntheticFunctionAuthorityOwnedStorageColumnCount = 12
    SyntheticFunctionAuthorityCallCount = 4

    SyntheticFunctionCallRoleSetCmdLine = 1
    SyntheticFunctionCallRoleRegisterLineMap = 2
    SyntheticFunctionCallRoleSourceEntry = 3
    SyntheticFunctionCallRoleProfileFlush = 4
    SyntheticFunctionCallRoleMax = 4

    SyntheticFunctionCallTargetProviderExport = 1
    SyntheticFunctionCallTargetSourceEntry = 2

    syntheticFunctionAuthorityMagic = 0x53464155
    syntheticFunctionAuthorityFunctionMagic = 0x53464146

type
    SyntheticFunctionAuthority =
        schemaVersion: int32
        sealed: bool
        arena: arenamod.Arena

        # Synthetic functions are an append-only SoA. Their int32 row is the
        # local identity coordinate; the CID commits that row and all four
        # exact call targets.
        functionCallStarts: arenamod.ArenaArrayInt32
        functionCallCounts: arenamod.ArenaArrayInt32
        functionSourceEntryTypedRows: arenamod.ArenaArrayInt32
        functionSourceArtifactCids: layout.FixedBytes32[]
        functionSourceEntryInterfaceCids: layout.FixedBytes32[]
        functionTargetTripleCids: layout.FixedBytes32[]
        functionAbiProfileCids: layout.FixedBytes32[]
        functionProviderReceiptCids: layout.FixedBytes32[]
        functionProviderActualSetCids: layout.FixedBytes32[]
        functionProviderImportReceiptCids: layout.FixedBytes32[]
        functionCids: layout.FixedBytes32[]

        # Call rows are a CSR owned by synthetic function rows. Runtime calls
        # are authorized only by the parent-verified provider import projection;
        # child receipt, actual-set and import CIDs are all committed above.
        # UTF-8 payload never participates in authority.
        callOwnerFunctionRows: arenamod.ArenaArrayInt32
        callContractRoleKinds: arenamod.ArenaArrayInt32
        callTargetDomainKinds: arenamod.ArenaArrayInt32
        callProviderRows: arenamod.ArenaArrayInt32
        callProviderExportRows: arenamod.ArenaArrayInt32
        callTargetTypedFunctionRows: arenamod.ArenaArrayInt32
        callProducerSourceRows: arenamod.ArenaArrayInt32
        callProducerDeclarationRows: arenamod.ArenaArrayInt32
        callProducerNodeRows: arenamod.ArenaArrayInt32
        callTargetArtifactCids: layout.FixedBytes32[]
        callProducerFactCids: layout.FixedBytes32[]
        callInterfaceCids: layout.FixedBytes32[]

        authorityCid: layout.FixedBytes32

        terminalReleaseOwnerToken: layout.FixedBytes32
        terminalReleasedOwnedStorageColumnCount: int32
        terminalReleasedBufferCount: int32
        terminalReleasedBytes: int64
        terminalStorageReleased: bool
        terminalReleaseReceiptConsumed: bool

    SyntheticFunctionAuthorityReleaseReceipt =
        ownerToken: layout.FixedBytes32
        releasedOwnedStorageColumnCount: int32
        releasedBufferCount: int32
        releasedBytes: int64
        storageReleased: bool

@borrows
fn syntheticFunctionAuthorityCidZero(value: layout.FixedBytes32): bool =
    return layout.FixedBytes32Equal(value, layout.FixedBytes32())

fn syntheticFunctionAuthorityAppendU32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn syntheticFunctionAuthorityAppendU64(
        buf: var layout.ByteBuf,
        value: int64) =
    layout.ByteBufAppendByte(buf, int32((value >> 56) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 48) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 40) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 32) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 24) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 16) & int64(255)))
    layout.ByteBufAppendByte(buf, int32((value >> 8) & int64(255)))
    layout.ByteBufAppendByte(buf, int32(value & int64(255)))

fn SyntheticFunctionAuthorityInit(
        initialArenaCapacity: int32): SyntheticFunctionAuthority =
    var out: SyntheticFunctionAuthority
    var capacity = initialArenaCapacity
    if capacity < 256:
        capacity = 256
    out.schemaVersion = SyntheticFunctionAuthoritySchemaVersion
    out.arena = arenamod.ArenaInit(capacity)
    out.functionCallStarts = arenamod.ArenaArrayInt32Init()
    out.functionCallCounts = arenamod.ArenaArrayInt32Init()
    out.functionSourceEntryTypedRows = arenamod.ArenaArrayInt32Init()
    out.callOwnerFunctionRows = arenamod.ArenaArrayInt32Init()
    out.callContractRoleKinds = arenamod.ArenaArrayInt32Init()
    out.callTargetDomainKinds = arenamod.ArenaArrayInt32Init()
    out.callProviderRows = arenamod.ArenaArrayInt32Init()
    out.callProviderExportRows = arenamod.ArenaArrayInt32Init()
    out.callTargetTypedFunctionRows = arenamod.ArenaArrayInt32Init()
    out.callProducerSourceRows = arenamod.ArenaArrayInt32Init()
    out.callProducerDeclarationRows = arenamod.ArenaArrayInt32Init()
    out.callProducerNodeRows = arenamod.ArenaArrayInt32Init()
    return out

@borrows
fn SyntheticFunctionAuthorityFunctionCount(
        authority: SyntheticFunctionAuthority): int32 =
    return authority.functionCids.len

@borrows
fn SyntheticFunctionAuthorityCallRowCount(
        authority: SyntheticFunctionAuthority): int32 =
    return authority.callInterfaceCids.len

fn syntheticFunctionAuthorityAppendCall(
        authority: var SyntheticFunctionAuthority,
        functionRow: int32,
        callRole: int32,
        targetDomain: int32,
        providerRow: int32,
        providerExportRow: int32,
        targetTypedFunctionRow: int32,
        producerSourceRow: int32,
        producerDeclarationRow: int32,
        producerNodeRow: int32,
        targetArtifactCid: layout.FixedBytes32,
        producerFactCid: layout.FixedBytes32,
        interfaceCid: layout.FixedBytes32) =
    arenamod.ArenaArrayInt32Add(
        authority.arena, authority.callOwnerFunctionRows, functionRow)
    arenamod.ArenaArrayInt32Add(
        authority.arena, authority.callContractRoleKinds, callRole)
    arenamod.ArenaArrayInt32Add(
        authority.arena, authority.callTargetDomainKinds, targetDomain)
    arenamod.ArenaArrayInt32Add(
        authority.arena, authority.callProviderRows, providerRow)
    arenamod.ArenaArrayInt32Add(
        authority.arena, authority.callProviderExportRows,
        providerExportRow)
    arenamod.ArenaArrayInt32Add(
        authority.arena, authority.callTargetTypedFunctionRows,
        targetTypedFunctionRow)
    arenamod.ArenaArrayInt32Add(
        authority.arena, authority.callProducerSourceRows,
        producerSourceRow)
    arenamod.ArenaArrayInt32Add(
        authority.arena, authority.callProducerDeclarationRows,
        producerDeclarationRow)
    arenamod.ArenaArrayInt32Add(
        authority.arena, authority.callProducerNodeRows, producerNodeRow)
    add(authority.callTargetArtifactCids,
        layout.FixedBytes32Copy(targetArtifactCid))
    add(authority.callProducerFactCids,
        layout.FixedBytes32Copy(producerFactCid))
    add(authority.callInterfaceCids,
        layout.FixedBytes32Copy(interfaceCid))

@borrows
fn syntheticFunctionAuthorityAppendFunctionBody(
        authority: SyntheticFunctionAuthority,
        functionRow: int32,
        buf: var layout.ByteBuf) =
    syntheticFunctionAuthorityAppendU32(
        buf, syntheticFunctionAuthorityFunctionMagic)
    syntheticFunctionAuthorityAppendU32(buf, functionRow)
    layout.ByteBufAppendFixed32(
        buf, authority.functionSourceArtifactCids[functionRow])
    syntheticFunctionAuthorityAppendU32(
        buf, arenamod.ArenaArrayInt32Get(
            authority.arena,
            authority.functionSourceEntryTypedRows,
            functionRow))
    layout.ByteBufAppendFixed32(
        buf, authority.functionSourceEntryInterfaceCids[functionRow])
    layout.ByteBufAppendFixed32(
        buf, authority.functionTargetTripleCids[functionRow])
    layout.ByteBufAppendFixed32(
        buf, authority.functionAbiProfileCids[functionRow])
    layout.ByteBufAppendFixed32(
        buf, authority.functionProviderReceiptCids[functionRow])
    layout.ByteBufAppendFixed32(
        buf, authority.functionProviderActualSetCids[functionRow])
    layout.ByteBufAppendFixed32(
        buf, authority.functionProviderImportReceiptCids[functionRow])
    let start = arenamod.ArenaArrayInt32Get(
        authority.arena, authority.functionCallStarts, functionRow)
    let count = arenamod.ArenaArrayInt32Get(
        authority.arena, authority.functionCallCounts, functionRow)
    syntheticFunctionAuthorityAppendU32(buf, start)
    syntheticFunctionAuthorityAppendU32(buf, count)
    for offset in 0..<count:
        let callRow = start + offset
        syntheticFunctionAuthorityAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                authority.arena,
                authority.callContractRoleKinds,
                callRow))
        syntheticFunctionAuthorityAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                authority.arena,
                authority.callTargetDomainKinds,
                callRow))
        syntheticFunctionAuthorityAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                authority.arena, authority.callProviderRows, callRow))
        syntheticFunctionAuthorityAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                authority.arena,
                authority.callProviderExportRows,
                callRow))
        syntheticFunctionAuthorityAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                authority.arena,
                authority.callTargetTypedFunctionRows,
                callRow))
        syntheticFunctionAuthorityAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                authority.arena,
                authority.callProducerSourceRows,
                callRow))
        syntheticFunctionAuthorityAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                authority.arena,
                authority.callProducerDeclarationRows,
                callRow))
        syntheticFunctionAuthorityAppendU32(
            buf, arenamod.ArenaArrayInt32Get(
                authority.arena,
                authority.callProducerNodeRows,
                callRow))
        layout.ByteBufAppendFixed32(
            buf, authority.callTargetArtifactCids[callRow])
        layout.ByteBufAppendFixed32(
            buf, authority.callProducerFactCids[callRow])
        layout.ByteBufAppendFixed32(
            buf, authority.callInterfaceCids[callRow])

@borrows
fn syntheticFunctionAuthorityComputeFunctionCid(
        authority: SyntheticFunctionAuthority,
        functionRow: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(512)
    syntheticFunctionAuthorityAppendFunctionBody(
        authority, functionRow, buf)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn syntheticFunctionAuthorityExpectedCallRole(
        offset: int32): int32 =
    if offset == 0:
        return SyntheticFunctionCallRoleSetCmdLine
    if offset == 1:
        return SyntheticFunctionCallRoleRegisterLineMap
    if offset == 2:
        return SyntheticFunctionCallRoleSourceEntry
    if offset == 3:
        return SyntheticFunctionCallRoleProfileFlush
    return 0

@borrows
fn syntheticFunctionAuthorityProviderRoleForCallRole(
        callRole: int32): int32 =
    if callRole == SyntheticFunctionCallRoleSetCmdLine:
        return peir.ProviderExportContractRoleSetCmdLine
    if callRole == SyntheticFunctionCallRoleRegisterLineMap:
        return peir.ProviderExportContractRoleRegisterLineMap
    if callRole == SyntheticFunctionCallRoleProfileFlush:
        return peir.ProviderExportContractRoleProfileFlush
    return 0

@borrows
fn syntheticFunctionAuthorityAppendProviderCall(
        authority: var SyntheticFunctionAuthority,
        providerImport: peii.ProviderExportIdentityImportReceipt,
        functionRow: int32,
        callRole: int32,
        providerRole: int32) =
    let roleRow = providerRole - 1
    let providerRow = arenamod.ArenaArrayInt32Get(
        providerImport.arena,
        providerImport.roleProviderRows,
        roleRow)
    syntheticFunctionAuthorityAppendCall(
        authority, functionRow, callRole,
        SyntheticFunctionCallTargetProviderExport,
        providerRow,
        arenamod.ArenaArrayInt32Get(
            providerImport.arena,
            providerImport.roleExportRows,
            roleRow),
        arenamod.ArenaArrayInt32Get(
            providerImport.arena,
            providerImport.roleTypedFunctionRows,
            roleRow),
        arenamod.ArenaArrayInt32Get(
            providerImport.arena,
            providerImport.roleProducerSourceRows,
            roleRow),
        arenamod.ArenaArrayInt32Get(
            providerImport.arena,
            providerImport.roleProducerDeclarationRows,
            roleRow),
        arenamod.ArenaArrayInt32Get(
            providerImport.arena,
            providerImport.roleProducerNodeRows,
            roleRow),
        providerImport.providerSourceArtifactCids[providerRow],
        providerImport.roleProducerFactCids[roleRow],
        providerImport.roleInterfaceCids[roleRow])

@borrows
fn SyntheticFunctionAuthorityAppendEntryBridge(
        authority: var SyntheticFunctionAuthority,
        sourceArtifactCid: layout.FixedBytes32,
        sourceEntryTypedRow: int32,
        sourceEntryInterfaceCid: layout.FixedBytes32,
        targetTripleCid: layout.FixedBytes32,
        abiProfileCid: layout.FixedBytes32,
        providerImport: peii.ProviderExportIdentityImportReceipt,
        err: var str): int32 =
    if authority.sealed || authority.terminalStorageReleased ||
       authority.schemaVersion != SyntheticFunctionAuthoritySchemaVersion:
        err = " synthetic function authority: append state invalid"
        return -1
    if sourceEntryTypedRow < 0 ||
       syntheticFunctionAuthorityCidZero(sourceArtifactCid) ||
       syntheticFunctionAuthorityCidZero(sourceEntryInterfaceCid) ||
       syntheticFunctionAuthorityCidZero(targetTripleCid) ||
       syntheticFunctionAuthorityCidZero(abiProfileCid):
        err = " synthetic function authority: source or target identity invalid"
        return -1
    if !peii.ProviderExportIdentityImportStrictValidateInto(
           providerImport, err):
        return -1
    let exportCount = providerImport.sourceExportCount
    if exportCount != peir.ProviderExportContractRoleMax:
        err = " synthetic function authority: provider role set incomplete"
        return -1

    let functionRow = authority.functionSourceArtifactCids.len
    let callStart = authority.callInterfaceCids.len
    arenamod.ArenaArrayInt32Add(
        authority.arena, authority.functionCallStarts, callStart)
    arenamod.ArenaArrayInt32Add(
        authority.arena, authority.functionCallCounts,
        SyntheticFunctionAuthorityCallCount)
    arenamod.ArenaArrayInt32Add(
        authority.arena,
        authority.functionSourceEntryTypedRows,
        sourceEntryTypedRow)
    add(authority.functionSourceArtifactCids,
        layout.FixedBytes32Copy(sourceArtifactCid))
    add(authority.functionSourceEntryInterfaceCids,
        layout.FixedBytes32Copy(sourceEntryInterfaceCid))
    add(authority.functionTargetTripleCids,
        layout.FixedBytes32Copy(targetTripleCid))
    add(authority.functionAbiProfileCids,
        layout.FixedBytes32Copy(abiProfileCid))
    add(authority.functionProviderReceiptCids,
        layout.FixedBytes32Copy(providerImport.sourceProviderReceiptCid))
    add(authority.functionProviderActualSetCids,
        layout.FixedBytes32Copy(providerImport.sourceActualSetCid))
    add(authority.functionProviderImportReceiptCids,
        layout.FixedBytes32Copy(providerImport.receiptCid))

    let setCmdLineRole = peir.ProviderExportContractRoleSetCmdLine
    syntheticFunctionAuthorityAppendProviderCall(
        authority, providerImport, functionRow,
        SyntheticFunctionCallRoleSetCmdLine,
        setCmdLineRole)
    let lineMapRole = peir.ProviderExportContractRoleRegisterLineMap
    syntheticFunctionAuthorityAppendProviderCall(
        authority, providerImport, functionRow,
        SyntheticFunctionCallRoleRegisterLineMap,
        lineMapRole)
    syntheticFunctionAuthorityAppendCall(
        authority, functionRow,
        SyntheticFunctionCallRoleSourceEntry,
        SyntheticFunctionCallTargetSourceEntry,
        -1, -1, sourceEntryTypedRow, -1, -1, -1,
        sourceArtifactCid, layout.FixedBytes32(),
        sourceEntryInterfaceCid)
    let flushRole = peir.ProviderExportContractRoleProfileFlush
    syntheticFunctionAuthorityAppendProviderCall(
        authority, providerImport, functionRow,
        SyntheticFunctionCallRoleProfileFlush,
        flushRole)

    let functionCid = syntheticFunctionAuthorityComputeFunctionCid(
        authority, functionRow)
    if syntheticFunctionAuthorityCidZero(functionCid):
        panic(" synthetic function authority: computed zero function cid")
    add(authority.functionCids, functionCid)
    err = ""
    return functionRow

@borrows
fn syntheticFunctionAuthorityShapeValid(
        authority: SyntheticFunctionAuthority,
        err: var str): bool =
    if authority.schemaVersion != SyntheticFunctionAuthoritySchemaVersion:
        err = " synthetic function authority: schema version invalid"
        return false
    if authority.arena.capacityBytes <= 0 ||
       authority.arena.usedBytes < 0 ||
       authority.arena.usedBytes > authority.arena.capacityBytes ||
       authority.arena.generation <= 0:
        err = " synthetic function authority: arena owner invalid"
        return false
    let functionCount = authority.functionCids.len
    let callCount = authority.callInterfaceCids.len
    if functionCount <= 0 || functionCount > 536870911 ||
       callCount != functionCount * SyntheticFunctionAuthorityCallCount:
        err = " synthetic function authority: function/call count invalid"
        return false
    if authority.functionCallStarts.len != functionCount ||
       authority.functionCallCounts.len != functionCount ||
       authority.functionSourceEntryTypedRows.len != functionCount ||
       authority.functionSourceArtifactCids.len != functionCount ||
       authority.functionSourceEntryInterfaceCids.len != functionCount ||
       authority.functionTargetTripleCids.len != functionCount ||
       authority.functionAbiProfileCids.len != functionCount ||
       authority.functionProviderReceiptCids.len != functionCount ||
       authority.functionProviderActualSetCids.len != functionCount ||
       authority.functionProviderImportReceiptCids.len != functionCount:
        err = " synthetic function authority: function shape invalid"
        return false
    if authority.callOwnerFunctionRows.len != callCount ||
       authority.callContractRoleKinds.len != callCount ||
       authority.callTargetDomainKinds.len != callCount ||
       authority.callProviderRows.len != callCount ||
       authority.callProviderExportRows.len != callCount ||
       authority.callTargetTypedFunctionRows.len != callCount ||
       authority.callProducerSourceRows.len != callCount ||
       authority.callProducerDeclarationRows.len != callCount ||
       authority.callProducerNodeRows.len != callCount ||
       authority.callTargetArtifactCids.len != callCount ||
       authority.callProducerFactCids.len != callCount:
        err = " synthetic function authority: call shape invalid"
        return false
    err = ""
    return true

@borrows
fn syntheticFunctionAuthorityRowsValid(
        authority: SyntheticFunctionAuthority,
        err: var str): bool =
    let functionCount = authority.functionCids.len
    var expectedCallStart: int32
    for functionRow in 0..<functionCount:
        let callStart = arenamod.ArenaArrayInt32Get(
            authority.arena,
            authority.functionCallStarts,
            functionRow)
        let callCount = arenamod.ArenaArrayInt32Get(
            authority.arena,
            authority.functionCallCounts,
            functionRow)
        if callStart != expectedCallStart ||
           callCount != SyntheticFunctionAuthorityCallCount ||
           arenamod.ArenaArrayInt32Get(
               authority.arena,
               authority.functionSourceEntryTypedRows,
               functionRow) < 0 ||
           syntheticFunctionAuthorityCidZero(
               authority.functionSourceArtifactCids[functionRow]) ||
           syntheticFunctionAuthorityCidZero(
               authority.functionSourceEntryInterfaceCids[functionRow]) ||
           syntheticFunctionAuthorityCidZero(
               authority.functionTargetTripleCids[functionRow]) ||
           syntheticFunctionAuthorityCidZero(
               authority.functionAbiProfileCids[functionRow]) ||
           syntheticFunctionAuthorityCidZero(
               authority.functionProviderReceiptCids[functionRow]) ||
           syntheticFunctionAuthorityCidZero(
               authority.functionProviderActualSetCids[functionRow]) ||
           syntheticFunctionAuthorityCidZero(
               authority.functionProviderImportReceiptCids[functionRow]) ||
           syntheticFunctionAuthorityCidZero(
               authority.functionCids[functionRow]):
            err = " synthetic function authority: function identity invalid"
            return false

        for offset in 0..<callCount:
            let callRow = callStart + offset
            let role = arenamod.ArenaArrayInt32Get(
                authority.arena,
                authority.callContractRoleKinds,
                callRow)
            let domain = arenamod.ArenaArrayInt32Get(
                authority.arena,
                authority.callTargetDomainKinds,
                callRow)
            if arenamod.ArenaArrayInt32Get(
                   authority.arena,
                   authority.callOwnerFunctionRows,
                   callRow) != functionRow ||
               role != syntheticFunctionAuthorityExpectedCallRole(offset) ||
               role <= 0 || role > SyntheticFunctionCallRoleMax ||
               arenamod.ArenaArrayInt32Get(
                   authority.arena,
                   authority.callTargetTypedFunctionRows,
                   callRow) < 0 ||
               syntheticFunctionAuthorityCidZero(
                   authority.callTargetArtifactCids[callRow]) ||
               syntheticFunctionAuthorityCidZero(
                   authority.callInterfaceCids[callRow]):
                err = " synthetic function authority: call identity invalid"
                return false
            if role == SyntheticFunctionCallRoleSourceEntry:
                if domain != SyntheticFunctionCallTargetSourceEntry ||
                   arenamod.ArenaArrayInt32Get(
                       authority.arena,
                       authority.callProviderRows,
                       callRow) != -1 ||
                   arenamod.ArenaArrayInt32Get(
                       authority.arena,
                       authority.callProviderExportRows,
                       callRow) != -1 ||
                   arenamod.ArenaArrayInt32Get(
                       authority.arena,
                       authority.callProducerSourceRows,
                       callRow) != -1 ||
                   arenamod.ArenaArrayInt32Get(
                       authority.arena,
                       authority.callProducerDeclarationRows,
                       callRow) != -1 ||
                   arenamod.ArenaArrayInt32Get(
                       authority.arena,
                       authority.callProducerNodeRows,
                       callRow) != -1 ||
                   !syntheticFunctionAuthorityCidZero(
                       authority.callProducerFactCids[callRow]) ||
                   arenamod.ArenaArrayInt32Get(
                       authority.arena,
                       authority.callTargetTypedFunctionRows,
                       callRow) != arenamod.ArenaArrayInt32Get(
                           authority.arena,
                           authority.functionSourceEntryTypedRows,
                           functionRow) ||
                   !layout.FixedBytes32Equal(
                       authority.callTargetArtifactCids[callRow],
                       authority.functionSourceArtifactCids[functionRow]) ||
                   !layout.FixedBytes32Equal(
                       authority.callInterfaceCids[callRow],
                       authority.functionSourceEntryInterfaceCids[
                           functionRow]):
                    err = " synthetic function authority: source call mismatch"
                    return false
            else:
                let providerRole =
                    syntheticFunctionAuthorityProviderRoleForCallRole(role)
                if providerRole <= 0 ||
                   domain != SyntheticFunctionCallTargetProviderExport ||
                   arenamod.ArenaArrayInt32Get(
                       authority.arena,
                       authority.callProviderRows,
                       callRow) < 0 ||
                   arenamod.ArenaArrayInt32Get(
                       authority.arena,
                       authority.callProviderExportRows,
                       callRow) < 0 ||
                   arenamod.ArenaArrayInt32Get(
                       authority.arena,
                       authority.callProducerSourceRows,
                       callRow) < 0 ||
                   arenamod.ArenaArrayInt32Get(
                       authority.arena,
                       authority.callProducerDeclarationRows,
                       callRow) < 0 ||
                   arenamod.ArenaArrayInt32Get(
                       authority.arena,
                       authority.callProducerNodeRows,
                       callRow) < 0 ||
                   syntheticFunctionAuthorityCidZero(
                       authority.callProducerFactCids[callRow]):
                    err = " synthetic function authority: provider call mismatch"
                    return false
        let expectedFunctionCid =
            syntheticFunctionAuthorityComputeFunctionCid(
                authority, functionRow)
        if !layout.FixedBytes32Equal(
               authority.functionCids[functionRow],
               expectedFunctionCid):
            err = " synthetic function authority: function cid mismatch"
            return false
        expectedCallStart = expectedCallStart + callCount
    if expectedCallStart != authority.callInterfaceCids.len:
        err = " synthetic function authority: call csr incomplete"
        return false
    err = ""
    return true

@borrows
fn syntheticFunctionAuthorityComputeCid(
        authority: SyntheticFunctionAuthority): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(512)
    syntheticFunctionAuthorityAppendU32(
        buf, syntheticFunctionAuthorityMagic)
    syntheticFunctionAuthorityAppendU32(buf, authority.schemaVersion)
    syntheticFunctionAuthorityAppendU32(
        buf, authority.functionCids.len)
    syntheticFunctionAuthorityAppendU32(
        buf, authority.callInterfaceCids.len)
    for functionRow in 0..<authority.functionCids.len:
        layout.ByteBufAppendFixed32(
            buf, authority.functionCids[functionRow])
        syntheticFunctionAuthorityAppendFunctionBody(
            authority, functionRow, buf)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn SyntheticFunctionAuthoritySealInto(
        authority: var SyntheticFunctionAuthority,
        err: var str): bool =
    if authority.sealed || authority.terminalStorageReleased:
        err = " synthetic function authority: seal state invalid"
        return false
    if !syntheticFunctionAuthorityShapeValid(authority, err) ||
       !syntheticFunctionAuthorityRowsValid(authority, err):
        return false
    authority.authorityCid =
        syntheticFunctionAuthorityComputeCid(authority)
    if syntheticFunctionAuthorityCidZero(authority.authorityCid):
        err = " synthetic function authority: computed zero authority cid"
        return false
    authority.sealed = true
    err = ""
    return true

@borrows
fn SyntheticFunctionAuthorityStrictValidateInto(
        authority: SyntheticFunctionAuthority,
        err: var str): bool =
    if !authority.sealed || authority.terminalStorageReleased:
        err = " synthetic function authority: unsealed or released"
        return false
    if !syntheticFunctionAuthorityShapeValid(authority, err) ||
       !syntheticFunctionAuthorityRowsValid(authority, err):
        return false
    if syntheticFunctionAuthorityCidZero(authority.authorityCid) ||
       !layout.FixedBytes32Equal(
           authority.authorityCid,
           syntheticFunctionAuthorityComputeCid(authority)):
        err = " synthetic function authority: authority cid mismatch"
        return false
    err = ""
    return true

@borrows
fn SyntheticFunctionAuthorityStorageReleased(
        authority: SyntheticFunctionAuthority): bool =
    return authority.arena.capacityBytes == 0 &&
           authority.arena.usedBytes == 0 &&
           authority.functionCallStarts.capacity == 0 &&
           authority.functionCallCounts.capacity == 0 &&
           authority.functionSourceEntryTypedRows.capacity == 0 &&
           authority.callOwnerFunctionRows.capacity == 0 &&
           authority.callContractRoleKinds.capacity == 0 &&
           authority.callTargetDomainKinds.capacity == 0 &&
           authority.callProviderRows.capacity == 0 &&
           authority.callProviderExportRows.capacity == 0 &&
           authority.callTargetTypedFunctionRows.capacity == 0 &&
           authority.callProducerSourceRows.capacity == 0 &&
           authority.callProducerDeclarationRows.capacity == 0 &&
           authority.callProducerNodeRows.capacity == 0 &&
           authority.functionSourceArtifactCids.cap == 0 &&
           authority.functionSourceEntryInterfaceCids.cap == 0 &&
           authority.functionTargetTripleCids.cap == 0 &&
           authority.functionAbiProfileCids.cap == 0 &&
           authority.functionProviderReceiptCids.cap == 0 &&
           authority.functionProviderActualSetCids.cap == 0 &&
           authority.functionProviderImportReceiptCids.cap == 0 &&
           authority.functionCids.cap == 0 &&
           authority.callTargetArtifactCids.cap == 0 &&
           authority.callProducerFactCids.cap == 0 &&
           authority.callInterfaceCids.cap == 0

fn SyntheticFunctionAuthorityMoveInto(
        out: var SyntheticFunctionAuthority,
        source: var SyntheticFunctionAuthority,
        err: var str): bool =
    let sourceVersion = source.schemaVersion
    var marker = SyntheticFunctionAuthoritySchemaVersion
    if out.schemaVersion == marker:
        marker = 0
    source.schemaVersion = marker
    let descriptorsAlias = out.schemaVersion == marker
    source.schemaVersion = sourceVersion
    if descriptorsAlias:
        err = " synthetic function authority: self move"
        return false
    if !SyntheticFunctionAuthorityStorageReleased(out):
        err = " synthetic function authority: move output owns storage"
        return false
    if !SyntheticFunctionAuthorityStrictValidateInto(source, err):
        return false
    out = source
    source = SyntheticFunctionAuthority()
    if !SyntheticFunctionAuthorityStorageReleased(source):
        panic(" synthetic function authority: move source retained storage")
    err = ""
    return true

@borrows
fn SyntheticFunctionAuthorityRetainedBufferCount(
        authority: SyntheticFunctionAuthority): int32 =
    var count: int32
    if authority.arena.capacityBytes > 0: count = count + 1
    if authority.functionSourceArtifactCids.cap > 0: count = count + 1
    if authority.functionSourceEntryInterfaceCids.cap > 0: count = count + 1
    if authority.functionTargetTripleCids.cap > 0: count = count + 1
    if authority.functionAbiProfileCids.cap > 0: count = count + 1
    if authority.functionProviderReceiptCids.cap > 0: count = count + 1
    if authority.functionProviderActualSetCids.cap > 0: count = count + 1
    if authority.functionProviderImportReceiptCids.cap > 0: count = count + 1
    if authority.functionCids.cap > 0: count = count + 1
    if authority.callTargetArtifactCids.cap > 0: count = count + 1
    if authority.callProducerFactCids.cap > 0: count = count + 1
    if authority.callInterfaceCids.cap > 0: count = count + 1
    return count

@borrows
fn SyntheticFunctionAuthorityRetainedBytes(
        authority: SyntheticFunctionAuthority): int64 =
    return int64(authority.arena.capacityBytes) +
        int64(authority.functionSourceArtifactCids.cap) * int64(32) +
        int64(authority.functionSourceEntryInterfaceCids.cap) * int64(32) +
        int64(authority.functionTargetTripleCids.cap) * int64(32) +
        int64(authority.functionAbiProfileCids.cap) * int64(32) +
        int64(authority.functionProviderReceiptCids.cap) * int64(32) +
        int64(authority.functionProviderActualSetCids.cap) * int64(32) +
        int64(authority.functionProviderImportReceiptCids.cap) * int64(32) +
        int64(authority.functionCids.cap) * int64(32) +
        int64(authority.callTargetArtifactCids.cap) * int64(32) +
        int64(authority.callProducerFactCids.cap) * int64(32) +
        int64(authority.callInterfaceCids.cap) * int64(32)

@borrows
fn syntheticFunctionAuthorityReleaseOwnerToken(
        authority: SyntheticFunctionAuthority,
        retainedBufferCount: int32,
        retainedBytes: int64): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(96)
    syntheticFunctionAuthorityAppendU32(
        buf, syntheticFunctionAuthorityMagic)
    syntheticFunctionAuthorityAppendU32(
        buf, SyntheticFunctionAuthoritySchemaVersion)
    layout.ByteBufAppendFixed32(buf, authority.authorityCid)
    syntheticFunctionAuthorityAppendU32(buf, retainedBufferCount)
    syntheticFunctionAuthorityAppendU64(buf, retainedBytes)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn syntheticFunctionAuthorityResetArenaColumns(
        authority: var SyntheticFunctionAuthority) =
    authority.functionCallStarts = arenamod.ArenaArrayInt32Init()
    authority.functionCallCounts = arenamod.ArenaArrayInt32Init()
    authority.functionSourceEntryTypedRows = arenamod.ArenaArrayInt32Init()
    authority.callOwnerFunctionRows = arenamod.ArenaArrayInt32Init()
    authority.callContractRoleKinds = arenamod.ArenaArrayInt32Init()
    authority.callTargetDomainKinds = arenamod.ArenaArrayInt32Init()
    authority.callProviderRows = arenamod.ArenaArrayInt32Init()
    authority.callProviderExportRows = arenamod.ArenaArrayInt32Init()
    authority.callTargetTypedFunctionRows = arenamod.ArenaArrayInt32Init()
    authority.callProducerSourceRows = arenamod.ArenaArrayInt32Init()
    authority.callProducerDeclarationRows = arenamod.ArenaArrayInt32Init()
    authority.callProducerNodeRows = arenamod.ArenaArrayInt32Init()

fn SyntheticFunctionAuthorityReleaseWithReceipt(
        authority: var SyntheticFunctionAuthority,
        released: var SyntheticFunctionAuthorityReleaseReceipt): bool =
    if authority.schemaVersion != SyntheticFunctionAuthoritySchemaVersion ||
       authority.terminalStorageReleased ||
       authority.terminalReleaseReceiptConsumed ||
       !syntheticFunctionAuthorityCidZero(
           authority.terminalReleaseOwnerToken) ||
       authority.terminalReleasedOwnedStorageColumnCount != 0 ||
       authority.terminalReleasedBufferCount != 0 ||
       authority.terminalReleasedBytes != int64(0):
        return false
    let retainedBufferCount =
        SyntheticFunctionAuthorityRetainedBufferCount(authority)
    let retainedBytes = SyntheticFunctionAuthorityRetainedBytes(authority)
    let ownerToken = syntheticFunctionAuthorityReleaseOwnerToken(
        authority, retainedBufferCount, retainedBytes)
    if syntheticFunctionAuthorityCidZero(ownerToken):
        return false

    arenamod.ArenaRelease(authority.arena)
    seqs.freeSeq(authority.functionSourceArtifactCids)
    seqs.freeSeq(authority.functionSourceEntryInterfaceCids)
    seqs.freeSeq(authority.functionTargetTripleCids)
    seqs.freeSeq(authority.functionAbiProfileCids)
    seqs.freeSeq(authority.functionProviderReceiptCids)
    seqs.freeSeq(authority.functionProviderActualSetCids)
    seqs.freeSeq(authority.functionProviderImportReceiptCids)
    seqs.freeSeq(authority.functionCids)
    seqs.freeSeq(authority.callTargetArtifactCids)
    seqs.freeSeq(authority.callProducerFactCids)
    seqs.freeSeq(authority.callInterfaceCids)
    syntheticFunctionAuthorityResetArenaColumns(authority)
    authority.schemaVersion = 0
    authority.sealed = false
    authority.authorityCid = layout.FixedBytes32()

    authority.terminalReleaseOwnerToken = ownerToken
    authority.terminalReleasedOwnedStorageColumnCount =
        SyntheticFunctionAuthorityOwnedStorageColumnCount
    authority.terminalReleasedBufferCount = retainedBufferCount
    authority.terminalReleasedBytes = retainedBytes
    authority.terminalStorageReleased =
        SyntheticFunctionAuthorityStorageReleased(authority)
    authority.terminalReleaseReceiptConsumed = false

    released.ownerToken = ownerToken
    released.releasedOwnedStorageColumnCount =
        SyntheticFunctionAuthorityOwnedStorageColumnCount
    released.releasedBufferCount = retainedBufferCount
    released.releasedBytes = retainedBytes
    released.storageReleased = authority.terminalStorageReleased
    return released.storageReleased

fn SyntheticFunctionAuthorityConsumeReleaseReceipt(
        authority: var SyntheticFunctionAuthority,
        released: SyntheticFunctionAuthorityReleaseReceipt): bool =
    if !authority.terminalStorageReleased ||
       authority.terminalReleaseReceiptConsumed ||
       !released.storageReleased ||
       syntheticFunctionAuthorityCidZero(released.ownerToken) ||
       !layout.FixedBytes32Equal(
           released.ownerToken,
           authority.terminalReleaseOwnerToken) ||
       released.releasedOwnedStorageColumnCount !=
           authority.terminalReleasedOwnedStorageColumnCount ||
       released.releasedBufferCount !=
           authority.terminalReleasedBufferCount ||
       released.releasedBytes != authority.terminalReleasedBytes:
        return false
    authority.terminalReleaseReceiptConsumed = true
    return true

fn SyntheticFunctionAuthorityRelease(
        authority: var SyntheticFunctionAuthority) =
    var released: SyntheticFunctionAuthorityReleaseReceipt
    if !SyntheticFunctionAuthorityReleaseWithReceipt(
           authority, released) ||
       !SyntheticFunctionAuthorityConsumeReleaseReceipt(
           authority, released):
        panic(" synthetic function authority: cleanup release incomplete")
