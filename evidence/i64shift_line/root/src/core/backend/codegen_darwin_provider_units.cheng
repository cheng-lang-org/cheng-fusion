# codegen_darwin_provider_units.cheng —— Darwin 提供者对象单元直调门面（B9）
#
# 承接 Step0 覆盖缺口：darwin_syscall_provider.cheng 自入库起未进归属表
# （uncovered=1），且其 import aarch64_encode（Darwin 载体面只有 arm64），
# 若直接归 aarch64 会把 kernel 消费点 system_link_exec_runtime 打成
# kernel→arch 直违。按 codegen_writer_units（B2）/ codegen_linker_units
# （B7）/ codegen_regalloc_adapter_units（B8）同一形态收编：本模块持
# arch import，内核与 driver 只经本门面消费。
#
# 形态：单入口直调（Darwin 提供者对象当前只有 arm64 一种载体，无
# unitKey 派发表可收口），零间接调用，Err 文案与 provider 原文逐字节同源；
# 若后续出现非 arm64 Darwin 载体，在此按 unitKey 展开，调用面不变。
#
# 归属：shared-format。darwin_syscall_provider 本体归 aarch64 插件桶。
import std/result
import cheng/core/backend/darwin_syscall_provider as darwinsyscall

@borrows
fn CodegenDarwinProviderUnitWriteObject(rootDir: str,
                                        outPath: str): Result[bool] =
    return darwinsyscall.DarwinSyscallProviderWriteObject(rootDir, outPath)
