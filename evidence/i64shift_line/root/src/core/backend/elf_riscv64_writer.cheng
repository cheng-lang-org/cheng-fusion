import std/result
import std/rawbytes
import std/strings
import std/strformat
import cheng/core/tooling/path as chengpath
import cheng/core/backend/object_buffer as obuf
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/object_relocs as orel

const
    ELFCLASS64 = uint64(2)
    ELFDATA2LSB = uint64(1)
    EV_CURRENT = uint64(1)
    EM_RISCV = uint64(243)
    ET_REL = uint64(1)

    SHT_NULL = int32(0)
    SHT_PROGBITS = int32(1)
    SHT_SYMTAB = int32(2)
    SHT_STRTAB = int32(3)
    SHT_RELA = int32(4)
    SHT_NOBITS = int32(8)

    SHF_WRITE = int32(0x1)
    SHF_ALLOC = int32(0x2)
    SHF_EXECINSTR = int32(0x4)

    STB_LOCAL = uint64(0)
    STB_GLOBAL = uint64(1)
    STT_NOTYPE = uint64(0)
    STT_OBJECT = uint64(1)
    STT_FUNC = uint64(2)

    # RISC-V 64-bit relocation types
    R_RISCV_32 = uint64(1)
    R_RISCV_64 = uint64(2)
    R_RISCV_CALL = uint64(18)
    R_RISCV_PCREL_HI20 = uint64(23)
    R_RISCV_PCREL_LO12_I = uint64(24)

    ELF_HDR_SIZE = 64
    ELF_SHDR_SIZE = 64
    ELF_SYM_SIZE = 24
    ELF_RELA_SIZE = 24

type
    ElfRv64WriterResult =
        objectPath: str
        bytesWritten: int32
        symbolCount: int32
        relocCount: int32

fn elfAlign(value: int32, align: int32): int32 =
    if align <= 1:
        return value
    let mask = align - 1
    return (value + mask) & (0 - align)

@borrows
fn elfWriteCString(buf: var obuf.ObjectBuffer,
                   text: str) =
    var i: int32
    while i < len(text):
        obuf.ObjectBufferWriteU8(buf, int32(text[i]) & 255)
        i = i + 1
    obuf.ObjectBufferWriteU8(buf, 0)

fn elfWriteShdr(buf: var obuf.ObjectBuffer,
                nameOff: int32,
                shType: int32,
                flags: int32,
                shOffset: int64,
                shSize: int64,
                link: int32,
                info: int32,
                addralign: int64,
                entsize: int64) =
    obuf.ObjectBufferWriteU32LE(buf, uint64(nameOff))
    obuf.ObjectBufferWriteU32LE(buf, uint64(shType))
    obuf.ObjectBufferWriteU64LE(buf, uint64(flags))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(shOffset))
    obuf.ObjectBufferWriteU64LE(buf, uint64(shSize))
    obuf.ObjectBufferWriteU32LE(buf, uint64(link))
    obuf.ObjectBufferWriteU32LE(buf, uint64(info))
    obuf.ObjectBufferWriteU64LE(buf, uint64(addralign))
    obuf.ObjectBufferWriteU64LE(buf, uint64(entsize))

fn elfRv64RelocType(kind: orel.ObjectRelocKind): Result[int64] =
    # Generic absolute relocations remain absolute. Only the dedicated
    # RISC-V call kind may become R_RISCV_CALL; AArch64 Branch26 is rejected.
    if kind == orel.ObjectRelocAbs64:
        return Ok[int64](int64(R_RISCV_64))
    if kind == orel.ObjectRelocAbs32:
        return Ok[int64](int64(R_RISCV_32))
    if kind == orel.ObjectRelocRiscvCall:
        return Ok[int64](int64(R_RISCV_CALL))
    if kind == orel.ObjectRelocBranch26:
        return Err[int64](
            " elf riscv64 object writer: aarch64 branch26 is not a RISC-V call")
    if kind == orel.ObjectRelocPage21:
        return Ok[int64](int64(R_RISCV_PCREL_HI20))
    if kind == orel.ObjectRelocPageOff12:
        return Ok[int64](int64(R_RISCV_PCREL_LO12_I))
    return Err[int64](" elf riscv64 object writer: unsupported relocation kind")

fn elfWriteSym(buf: var obuf.ObjectBuffer,
               nameOff: int32,
               info: uint64,
               shndx: int32,
               value: int64,
               size: int64) =
    obuf.ObjectBufferWriteU32LE(buf, uint64(nameOff))
    obuf.ObjectBufferWriteU8(buf, int32(info & uint64(255)))
    obuf.ObjectBufferWriteU8(buf, int32((info >> 8) & uint64(255)))
    obuf.ObjectBufferWriteU16LE(buf, uint64(shndx))
    obuf.ObjectBufferWriteU64LE(buf, uint64(value))
    obuf.ObjectBufferWriteU64LE(buf, uint64(size))

fn elfWriteRela(buf: var obuf.ObjectBuffer,
                offset: int64,
                info: uint64,
                addend: int64) =
    obuf.ObjectBufferWriteU64LE(buf, uint64(offset))
    obuf.ObjectBufferWriteU64LE(buf, info)
    obuf.ObjectBufferWriteU64LE(buf, uint64(addend))

@borrows
fn ElfRv64TextObjectBytes(text: rawbytes.Bytes,
                               symbols: osym.ObjectSymbolTable,
                               relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes] =
    var emptyData = rawbytes.EmptyBytes()
    return elfRv64Build(text, emptyData, symbols, relocs)

@borrows
fn ElfRv64TextDataObjectBytes(text: rawbytes.Bytes,
                                   data: rawbytes.Bytes,
                                   symbols: osym.ObjectSymbolTable,
                                   relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes] =
    return elfRv64Build(text, data, symbols, relocs)

@borrows
fn elfRv64Build(text: rawbytes.Bytes,
                    data: rawbytes.Bytes,
                    symbols: osym.ObjectSymbolTable,
                    relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes] =
    let relocCount = orel.ObjectRelocsCount(relocs)
    let symbolCount = osym.ObjectSymbolsCount(symbols)
    if symbolCount <= 0:
        return Err[rawbytes.Bytes](" elf riscv64 object writer: missing symbols")

    let textSize = int64(rawbytes.BytesLen(text))
    let dataSize = int64(rawbytes.BytesLen(data))
    let hasData = dataSize > int64(0)

    # Section indices: 0=null, 1=.text, optional .data/.rela.text, then
    # .symtab, .strtab, .shstrtab last.
    var shnum = int32(5)
    let textShndx = int32(1)
    var dataShndx = int32(0)
    var relaShndx = int32(0)
    if hasData:
        dataShndx = int32(2)
        shnum = shnum + 1
    if relocCount > 0:
        relaShndx = shnum - 3
        shnum = shnum + 1
    let symtabShndx = shnum - 3
    let strtabShndx = shnum - 2

    # Build strtab (symbol names)
    var strtab = obuf.ObjectBufferInit(256)
    defer:
        obuf.ObjectBufferRelease(strtab)
    obuf.ObjectBufferWriteU8(strtab, 0)
    var symNameOffs: int32[]
    for i in 0..<symbolCount:
        add(symNameOffs, obuf.ObjectBufferOffset(strtab))
        elfWriteCString(strtab, osym.ObjectSymbolsNameAt(symbols, i))

    # ELF requires every STB_LOCAL row to precede the first global row.
    # Preserve ObjectSymbolTable identity with an explicit source-index to
    # ELF-index map so relocations never depend on the publication order.
    var symbolOrder: int32[]
    var symbolElfIndexes: int32[]
    for i in 0..<symbolCount:
        add(symbolElfIndexes, -1)
    for i in 0..<symbolCount:
        if !osym.ObjectSymbolsAt(symbols, i).global:
            add(symbolOrder, i)
    let localSymbolCount = symbolOrder.len
    for i in 0..<symbolCount:
        if osym.ObjectSymbolsAt(symbols, i).global:
            add(symbolOrder, i)
    if symbolOrder.len != symbolCount:
        return Err[rawbytes.Bytes](
            " elf riscv64 object writer: symbol order incomplete")
    for elfRow in 0..<symbolCount:
        symbolElfIndexes[symbolOrder[elfRow]] = elfRow + 1

    # Build shstrtab (section names)
    var shstrtab = obuf.ObjectBufferInit(128)
    defer:
        obuf.ObjectBufferRelease(shstrtab)
    obuf.ObjectBufferWriteU8(shstrtab, 0)
    var shNameOffs: int32[]
    add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
    obuf.ObjectBufferWriteU8(shstrtab, 0)
    add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
    elfWriteCString(shstrtab, ".text")
    if hasData:
        add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
        elfWriteCString(shstrtab, ".data")
    if relocCount > 0:
        add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
        elfWriteCString(shstrtab, ".rela.text")
    add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
    elfWriteCString(shstrtab, ".symtab")
    add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
    elfWriteCString(shstrtab, ".strtab")
    add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
    elfWriteCString(shstrtab, ".shstrtab")

    # Layout
    let textOff = int64(ELF_HDR_SIZE)
    let dataOff = elfAlign(int32(textOff + textSize), int32(8))
    let relaOff = elfAlign(int32(int64(dataOff) + dataSize), int32(8))
    let symOff = elfAlign(int32(relaOff) + relocCount * ELF_RELA_SIZE, int32(8))
    let strOff = int64(symOff) + int64(symbolCount + 1) * int64(ELF_SYM_SIZE)
    let shstrOff = strOff + int64(obuf.ObjectBufferLen(strtab))
    let shdrOff = elfAlign(int32(shstrOff) + obuf.ObjectBufferLen(shstrtab), int32(8))

    var out = obuf.ObjectBufferInit(int32(shdrOff) + shnum * ELF_SHDR_SIZE + 64)
    defer:
        obuf.ObjectBufferRelease(out)

    # ELF header
    obuf.ObjectBufferWriteU8(out, int32(0x7F))
    obuf.ObjectBufferWriteU8(out, int32(69))
    obuf.ObjectBufferWriteU8(out, int32(76))
    obuf.ObjectBufferWriteU8(out, int32(70))
    obuf.ObjectBufferWriteU8(out, int32(ELFCLASS64))
    obuf.ObjectBufferWriteU8(out, int32(ELFDATA2LSB))
    obuf.ObjectBufferWriteU8(out, int32(EV_CURRENT))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU16LE(out, ET_REL)
    obuf.ObjectBufferWriteU16LE(out, EM_RISCV)
    obuf.ObjectBufferWriteU32LE(out, EV_CURRENT)
    obuf.ObjectBufferWriteU64LE(out, uint64(0))
    obuf.ObjectBufferWriteU64LE(out, uint64(0))
    obuf.ObjectBufferWriteU64LE(out, uint64(shdrOff))
    obuf.ObjectBufferWriteU32LE(out, uint64(0))
    obuf.ObjectBufferWriteU16LE(out, uint64(ELF_HDR_SIZE))
    obuf.ObjectBufferWriteU16LE(out, uint64(0))
    obuf.ObjectBufferWriteU16LE(out, uint64(0))
    obuf.ObjectBufferWriteU16LE(out, uint64(ELF_SHDR_SIZE))
    obuf.ObjectBufferWriteU16LE(out, uint64(shnum))
    obuf.ObjectBufferWriteU16LE(out, uint64(shnum - 1))

    # .text
    obuf.ObjectBufferWriteBytes(out, text)

    # .data (optional)
    if hasData:
        obuf.ObjectBufferAlign(out, int32(8), 0)
        obuf.ObjectBufferWriteBytes(out, data)

    # .rela.text (optional)
    if relocCount > 0:
        obuf.ObjectBufferAlign(out, int32(8), 0)
        for i in 0..<relocCount:
            let reloc = orel.ObjectRelocsAt(relocs, i)
            if reloc.symbolIndex < 0 || reloc.symbolIndex >= symbolCount:
                return Err[rawbytes.Bytes](
                    " elf riscv64 object writer: relocation symbol missing")
            let typeRes = elfRv64RelocType(reloc.kind)
            if !typeRes.ok:
                return Err[rawbytes.Bytes](typeRes.err.msg)
            let rType = uint64(typeRes.value)
            let mappedSymbol = symbolElfIndexes[reloc.symbolIndex]
            if mappedSymbol <= 0:
                return Err[rawbytes.Bytes](
                    " elf riscv64 object writer: relocation symbol map missing")
            let rSym = uint64(mappedSymbol)
            let info = (rSym << 32) | rType
            elfWriteRela(out, reloc.offset, info, reloc.addend)

    # .symtab
    obuf.ObjectBufferAlign(out, int32(8), 0)
    elfWriteSym(out, int32(0), uint64(0), int32(0), int64(0), int64(0))
    for elfRow in 0..<symbolCount:
        let sourceIndex = symbolOrder[elfRow]
        let sym = osym.ObjectSymbolsAt(symbols, sourceIndex)
        var bind = STB_LOCAL
        var stType = STT_NOTYPE
        var shndx = int32(0)
        if sym.undefined:
            shndx = int32(0)
        else:
            stType = STT_FUNC
            if sym.sectionIndex == 0:
                shndx = textShndx
            elif hasData && sym.sectionIndex == 1:
                shndx = dataShndx
                stType = STT_OBJECT
            else:
                shndx = textShndx
        if sym.global:
            bind = STB_GLOBAL
        let info = (bind << 4) | stType
        elfWriteSym(
            out, symNameOffs[sourceIndex], info,
            shndx, sym.offset, sym.size)

    # .strtab
    obuf.ObjectBufferAlign(out, int32(1), 0)
    obuf.ObjectBufferWriteBuffer(out, strtab)

    # .shstrtab
    obuf.ObjectBufferAlign(out, int32(1), 0)
    obuf.ObjectBufferWriteBuffer(out, shstrtab)

    # Section headers (place last)
    obuf.ObjectBufferAlign(out, int32(8), 0)
    # SHT_NULL
    elfWriteShdr(out, shNameOffs[0], int32(SHT_NULL), int32(0),
                 int64(0), int64(0), int32(0), int32(0), int64(0), int64(0))
    # .text
    elfWriteShdr(out, shNameOffs[1], int32(SHT_PROGBITS), int32(SHF_ALLOC | SHF_EXECINSTR),
                 textOff, textSize, int32(0), int32(0), int64(4), int64(0))
    # .data (optional)
    var nextNameIdx = int32(2)
    if hasData:
        elfWriteShdr(out, shNameOffs[nextNameIdx], int32(SHT_PROGBITS), int32(SHF_ALLOC | SHF_WRITE),
                     int64(dataOff), dataSize, int32(0), int32(0), int64(8), int64(0))
        nextNameIdx = nextNameIdx + 1
    # .rela.text (optional)
    if relocCount > 0:
        elfWriteShdr(out, shNameOffs[nextNameIdx], int32(SHT_RELA), int32(0),
                     relaOff, int64(relocCount * ELF_RELA_SIZE),
                     int32(symtabShndx), textShndx, int64(8), int64(ELF_RELA_SIZE))
        nextNameIdx = nextNameIdx + 1
    # .symtab
    elfWriteShdr(out, shNameOffs[nextNameIdx], int32(SHT_SYMTAB), int32(0),
                 symOff, int64(symbolCount + 1) * int64(ELF_SYM_SIZE),
                 int32(strtabShndx), localSymbolCount + 1,
                 int64(8), int64(ELF_SYM_SIZE))
    nextNameIdx = nextNameIdx + 1
    # .strtab
    elfWriteShdr(out, shNameOffs[nextNameIdx], int32(SHT_STRTAB), int32(0),
                 strOff, int64(obuf.ObjectBufferLen(strtab)),
                 int32(0), int32(0), int64(1), int64(0))
    nextNameIdx = nextNameIdx + 1
    # .shstrtab
    elfWriteShdr(out, shNameOffs[nextNameIdx], int32(SHT_STRTAB), int32(0),
                 shstrOff, int64(obuf.ObjectBufferLen(shstrtab)),
                 int32(0), int32(0), int64(1), int64(0))

    return Ok[rawbytes.Bytes](obuf.ObjectBufferTakeBytes(out))

@borrows
fn elfRv64WriteResult(rootDir: str,
                          outputPath: str,
                          text: rawbytes.Bytes,
                          data: rawbytes.Bytes,
                          symbols: osym.ObjectSymbolTable,
                          relocs: orel.ObjectRelocTable): Result[ElfRv64WriterResult] =
    let dataSize = rawbytes.BytesLen(data)
    var bytesRes: Result[rawbytes.Bytes]
    if dataSize > 0:
        bytesRes = ElfRv64TextDataObjectBytes(text, data, symbols, relocs)
    else:
        bytesRes = ElfRv64TextObjectBytes(text, symbols, relocs)
    if !bytesRes.ok:
        return Err[ElfRv64WriterResult](bytesRes.err.msg)
    var bytes = bytesRes.value
    defer:
        rawbytes.BytesFree(bytes)
    let payload = rawbytes.BytesToString(bytes)
    if !chengpath.WriteTextFile(rootDir, outputPath, payload):
        return Err[ElfRv64WriterResult](Fmt" elf riscv64 object writer: failed to write object: {outputPath}")
    var out: ElfRv64WriterResult
    out.objectPath = outputPath
    out.bytesWritten = rawbytes.BytesLen(bytes)
    out.symbolCount = osym.ObjectSymbolsCount(symbols)
    out.relocCount = orel.ObjectRelocsCount(relocs)
    return Ok[ElfRv64WriterResult](out)

@borrows
fn ElfRv64TextObjectWrite(rootDir: str,
                               outputPath: str,
                               text: rawbytes.Bytes,
                               symbols: osym.ObjectSymbolTable,
                               relocs: orel.ObjectRelocTable): Result[ElfRv64WriterResult] =
    var emptyData = rawbytes.EmptyBytes()
    return elfRv64WriteResult(rootDir, outputPath, text, emptyData, symbols, relocs)

@borrows
fn ElfRv64TextDataObjectWrite(rootDir: str,
                                   outputPath: str,
                                   text: rawbytes.Bytes,
                                   data: rawbytes.Bytes,
                                   symbols: osym.ObjectSymbolTable,
                                   relocs: orel.ObjectRelocTable): Result[ElfRv64WriterResult] =
    return elfRv64WriteResult(rootDir, outputPath, text, data, symbols, relocs)
