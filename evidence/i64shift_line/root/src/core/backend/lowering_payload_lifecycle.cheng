import cheng/core/backend/lowering_plan as lower
import cheng/core/tooling/compiler_payload_lifecycle as compilerlife

fn LoweringPayloadLifecycleEndWithReleaseReceipt(
        lifecycle: var compilerlife.CompilerPayloadLifecycle,
        releaseReceipt: lower.LoweringPlanReleaseReceipt,
        outcome: int32,
        receipt: var compilerlife.CompilerPayloadLifecycleReceipt) =
    if !lifecycle.active ||
       releaseReceipt.lifecycleInitialBufferCount !=
           lifecycle.physicalBufferCount ||
       releaseReceipt.lifecycleInitialBytes !=
           lifecycle.byteCount ||
       releaseReceipt.lifecycleReleasedBufferCount !=
           lifecycle.physicalBufferCount ||
       releaseReceipt.lifecycleReleasedBytes !=
           lifecycle.byteCount ||
       !releaseReceipt.lifecycleClosed:
        panic("lowering payload lifecycle: release receipt mismatch")
    if !lifecycle.terminalPrepared:
        compilerlife.CompilerPayloadLifecyclePrepareTerminal(
            lifecycle)
    var physicalRelease: compilerlife.CompilerPayloadPhysicalReleaseReceipt
    physicalRelease.releasedBufferCount =
        releaseReceipt.lifecycleReleasedBufferCount
    physicalRelease.releasedBytes =
        releaseReceipt.lifecycleReleasedBytes
    physicalRelease.storageReleased =
        releaseReceipt.lifecycleClosed
    compilerlife.CompilerPayloadLifecycleEnd(
        lifecycle,
        outcome,
        physicalRelease,
        receipt)
