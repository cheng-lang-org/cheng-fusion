import std/strutils as strutil
import std/result
import std/os
import std/cmdline
import std/strings
import std/os_host_process as hostos
import cheng/core/tooling/host_ops as hostops
import cheng/core/tooling/path as chengpath
import cheng/core/backend/native_link_plan as nplan
import cheng/core/backend/macho_provider_linker
import cheng/core/backend/elf_object_linker

@borrows
fn NativeLinkExecIsSelfLinker(targetTriple: str, linkerFlavor: str): bool =
    if targetTriple == "x86_64-unknown-linux-gnu" &&
       linkerFlavor == "elf_x86_64_internal":
        return true
    let targetOk = targetTriple == "arm64-apple-darwin"
    let flavorOk = linkerFlavor == "macho_arm64_provider_internal"
    return targetOk && flavorOk

@borrows
fn NativeLinkExecError(rootDir: str,
                       label: str,
                       program: str,
                       logPath: str,
                       code: int32,
                       text: str): hostops.LoggedRun =
    let outputText = strutil.Join([share(text), "\n"], "")
    let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
    return hostops.LoggedRunZero(label, program, chengpath.PathAbsolute(rootDir, logPath), code, outputText)

@borrows
fn NativeLinkExecMachoRequest(plan: nplan.NativeLinkPlanStub): Result[macho_provider_linker.MachoProviderLinkRequest] =
    var programObjectPaths: str[]
    for pathIndex in 0..<plan.programObjectPaths.len:
        let programObjectPath = plan.programObjectPaths[pathIndex]
        add(programObjectPaths, share(programObjectPath))
    if programObjectPaths.len <= 0:
        if len(plan.primaryObjectPath) > 0:
            let primaryObjectPath = plan.primaryObjectPath
            add(programObjectPaths, share(primaryObjectPath))
        if len(plan.browserBridgeObjectPath) > 0:
            let browserBridgeObjectPath = plan.browserBridgeObjectPath
            add(programObjectPaths, share(browserBridgeObjectPath))
    if programObjectPaths.len <= 0:
        return Err[macho_provider_linker.MachoProviderLinkRequest](" native link exec darwin: Mach-O program object partition missing")
    let expectedInputCount = programObjectPaths.len + plan.providerObjectPaths.len
    if expectedInputCount != plan.linkInputPaths.len:
        return Err[macho_provider_linker.MachoProviderLinkRequest](" native link exec darwin: Mach-O structured input partition count mismatch")
    for i in 0..<programObjectPaths.len:
        if plan.linkInputPaths[i] != programObjectPaths[i]:
            return Err[macho_provider_linker.MachoProviderLinkRequest](" native link exec darwin: Mach-O program input order mismatch")
    for i in 0..<plan.providerObjectPaths.len:
        if plan.linkInputPaths[programObjectPaths.len + i] != plan.providerObjectPaths[i]:
            return Err[macho_provider_linker.MachoProviderLinkRequest](" native link exec darwin: Mach-O provider input order mismatch")
    var request: macho_provider_linker.MachoProviderLinkRequest
    request.programObjectPaths = programObjectPaths
    for pathIndex in 0..<plan.providerObjectPaths.len:
        let providerObjectPath = plan.providerObjectPaths[pathIndex]
        add(request.providerObjectPaths, share(providerObjectPath))
    let outputPath = plan.outputPath
    let targetTriple = plan.targetTriple
    request.outputPath = share(outputPath)
    request.targetTriple = share(targetTriple)
    return Ok[macho_provider_linker.MachoProviderLinkRequest](request)

@borrows
fn NativeLinkExecProviderReceiptText(receipt: macho_provider_linker.MachoProviderLinkReceipt): str =
    let contentSha256 = receipt.providerObjectContentSha256
    let bindingSchema = receipt.providerObjectBindingSchema
    let bindingStorage = receipt.providerObjectBindingStorage
    return strutil.Join([
        "provider_object_content_sha256=", share(contentSha256), "\n",
        "provider_object_binding_schema=", share(bindingSchema), "\n",
        "provider_object_binding_storage=", share(bindingStorage), "\n",
        "provider_object_binding_signed=1\n",
        "provider_object_binding_matches_read_bytes=1\n",
        "provider_object_binding_status=proved\n"
    ], "")

@borrows
fn NativeLinkExecSystemLinkerArgv(plan: nplan.NativeLinkPlanStub): str[] =
    var argv: str[]
    for i in 0..<plan.linkInputPaths.len:
        let inputPath = plan.linkInputPaths[i]
        add(argv, share(inputPath))
    add(argv, "-o")
    let outputPath = plan.outputPath
    add(argv, share(outputPath))
    if plan.targetTriple == "x86_64-pc-windows-msvc":
        add(argv, "-lws2_32")
        add(argv, "-lpsapi")
        add(argv, "-lbcrypt")
        add(argv, "-lncrypt")
        add(argv, "-ladvapi32")
    return argv

@borrows
fn NativeLinkExecRunLogged(rootDir: str,
                            label: str,
                            plan: nplan.NativeLinkPlanStub,
                            logPath: str): hostops.LoggedRun =
    let targetTriple = plan.targetTriple
    let linkerFlavor = plan.linkerFlavor
    let linkerProgram = plan.linkerProgram
    let outputPath = plan.outputPath
    let linkInputPaths = plan.linkInputPaths
    if !NativeLinkExecIsSelfLinker(targetTriple, linkerFlavor):
        if linkerFlavor == "system_linker":
            var argv: str[] = NativeLinkExecSystemLinkerArgv(plan)
            if targetTriple == "x86_64-pc-windows-msvc":
                let explicitCc = strutil.Strip(os.GetEnv("CHENG_WINDOWS_CC"))
                if len(explicitCc) > 0:
                    return hostops.RunFileLogged(rootDir,
                                                 label,
                                                 explicitCc,
                                                 argv,
                                                 [],
                                                 rootDir,
                                                 60,
                                                 logPath)
            return hostops.RunProgramLogged(rootDir,
                                            label,
                                            linkerProgram,
                                            argv,
                                            [],
                                            rootDir,
                                            60,
                                            logPath)
        return NativeLinkExecError(rootDir,
                                   label,
                                   linkerProgram,
                                   logPath,
                                   2,
                                   " native link exec darwin: unsupported non-Darwin or non-self-linker plan")
    if linkerFlavor == "elf_x86_64_internal":
        let elfLinkRes = elf_object_linker.ElfLinkExeX64(linkInputPaths,
                                                           outputPath,
                                                           targetTriple)
        if !elfLinkRes.ok:
            let errMsg = elfLinkRes.err.msg
            return NativeLinkExecError(rootDir,
                                       label,
                                       linkerProgram,
                                       logPath,
                                       1,
                                       errMsg)
        let elfOutputText = strutil.Join([
            share(outputPath), " OK\n",
            "native_linker_program=", share(linkerProgram), "\n",
            "native_linker_flavor=", share(linkerFlavor), "\n",
            "system_link_exec_scope=selfhost_direct\n",
            "linkerless_image=1\n",
            "provider_link_mode=internal\n",
            "unresolved_symbol_count=0\n",
            "first_unresolved_symbol=\n"
        ], "")
        let _elfLogged = chengpath.WriteTextFile(rootDir, logPath, elfOutputText)
        return hostops.LoggedRunZero(label,
                                     linkerProgram,
                                     chengpath.PathAbsolute(rootDir, logPath),
                                     0,
                                     elfOutputText)
    let requestRes = NativeLinkExecMachoRequest(plan)
    if !requestRes.ok:
        let errMsg = requestRes.err.msg
        return NativeLinkExecError(rootDir,
                                   label,
                                   linkerProgram,
                                   logPath,
                                   1,
                                   errMsg)
    let request = requestRes.value
    let linkRes = macho_provider_linker.MachoProviderLinkExeCertified(share(request))
    if !linkRes.ok:
        let errMsg = linkRes.err.msg
        return NativeLinkExecError(rootDir,
                                   label,
                                   linkerProgram,
                                   logPath,
                                   1,
                                   errMsg)
    let receipt = linkRes.value
    let outputText = strutil.Join([
        share(outputPath), " OK\n",
        "native_linker_program=", share(linkerProgram), "\n",
        "native_linker_flavor=", share(linkerFlavor), "\n",
        "system_link_exec_scope=selfhost_direct\n",
        "linkerless_image=1\n",
        "provider_link_mode=internal\n",
        NativeLinkExecProviderReceiptText(receipt),
        "unresolved_symbol_count=0\n",
        "first_unresolved_symbol=\n"
    ], "")
    let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
    return hostops.LoggedRunZero(label,
                                 linkerProgram,
                                 chengpath.PathAbsolute(rootDir, logPath),
                                 0,
                                 outputText)

@borrows
fn NativeLinkExecRunLoggedInto(rootDir: str,
                               label: str,
                               plan: var nplan.NativeLinkPlanStub,
                               logPath: str,
                               outExitCode: var int32,
                               outLogPath: var str,
                               outOutput: var str) =
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=native_exec_into_enter")
    outExitCode = 0
    outLogPath = chengpath.PathAbsolute(rootDir, logPath)
    outOutput = ""
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=native_exec_after_init")
    let targetTriple = plan.targetTriple
    let linkerFlavor = plan.linkerFlavor
    let linkerProgram = plan.linkerProgram
    let outputPath = plan.outputPath
    let linkInputPaths = plan.linkInputPaths
    if !NativeLinkExecIsSelfLinker(targetTriple, linkerFlavor):
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=native_exec_non_self flavor=" + plan.linkerFlavor)
        if linkerFlavor == "system_linker":
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), "debug_system_link_exec=native_exec_system_before_argv")
            var argv: str[] = NativeLinkExecSystemLinkerArgv(plan)
            if targetTriple == "x86_64-pc-windows-msvc":
                let explicitCc = strutil.Strip(os.GetEnv("CHENG_WINDOWS_CC"))
                if len(explicitCc) > 0:
                    let run = hostops.RunFileLogged(rootDir,
                                                    label,
                                                    explicitCc,
                                                    argv,
                                                    [],
                                                    rootDir,
                                                    60,
                                                    logPath)
                    outExitCode = run.exitCode
                    outLogPath = run.logPath
                    outOutput = run.output
                    return
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), "debug_system_link_exec=native_exec_system_before_run")
            var envOverrides: str[]
            hostos.OsHostProcessExecFileCaptureFillBorrow(linkerProgram,
                                                          argv,
                                                          envOverrides,
                                                          rootDir,
                                                          true,
                                                          60,
                                                          outOutput,
                                                          outExitCode)
            let _logged = chengpath.WriteTextFile(rootDir, logPath, outOutput)
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), "debug_system_link_exec=native_exec_system_after_run rc=" + strings.IntToStr(outExitCode))
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), "debug_system_link_exec=native_exec_system_after_output")
            return
        outExitCode = 2
        outOutput = " native link exec darwin: unsupported non-Darwin or non-self-linker plan\n"
        let _logged = chengpath.WriteTextFile(rootDir, logPath, outOutput)
        return
    if linkerFlavor == "elf_x86_64_internal":
        let elfLinkRes = elf_object_linker.ElfLinkExeX64(linkInputPaths,
                                                           outputPath,
                                                           targetTriple)
        if !elfLinkRes.ok:
            outExitCode = 1
            let errMsg = elfLinkRes.err.msg
            outOutput = strutil.Join([share(errMsg), "\n"], "")
            let _elfErrLogged = chengpath.WriteTextFile(rootDir, logPath, outOutput)
            return
        outExitCode = 0
        outOutput = strutil.Join([
            share(outputPath), " OK\n",
            "native_linker_program=", share(linkerProgram), "\n",
            "native_linker_flavor=", share(linkerFlavor), "\n",
            "system_link_exec_scope=selfhost_direct\n",
            "linkerless_image=1\n",
            "provider_link_mode=internal\n",
            "unresolved_symbol_count=0\n",
            "first_unresolved_symbol=\n"
        ], "")
        let _elfOkLogged = chengpath.WriteTextFile(rootDir, logPath, outOutput)
        return
    let requestRes = NativeLinkExecMachoRequest(plan)
    if !requestRes.ok:
        outExitCode = 1
        let errMsg = requestRes.err.msg
        outOutput = strutil.Join([share(errMsg), "\n"], "")
        let _requestLogged = chengpath.WriteTextFile(rootDir, logPath, outOutput)
        return
    let request = requestRes.value
    let linkRes = macho_provider_linker.MachoProviderLinkExeCertified(share(request))
    if !linkRes.ok:
        outExitCode = 1
        let errMsg = linkRes.err.msg
        outOutput = strutil.Join([share(errMsg), "\n"], "")
        let _logged = chengpath.WriteTextFile(rootDir, logPath, outOutput)
        return
    let receipt = linkRes.value
    outOutput = strutil.Join([
        share(outputPath), " OK\n",
        "native_linker_program=", share(linkerProgram), "\n",
        "native_linker_flavor=", share(linkerFlavor), "\n",
        "system_link_exec_scope=selfhost_direct\n",
        "linkerless_image=1\n",
        "provider_link_mode=internal\n",
        NativeLinkExecProviderReceiptText(receipt),
        "unresolved_symbol_count=0\n",
        "first_unresolved_symbol=\n"
    ], "")
    let _logged = chengpath.WriteTextFile(rootDir, logPath, outOutput)
