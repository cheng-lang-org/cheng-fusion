import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import std/system
import cheng/core/csg_core/compiler_snapshot_schema as snapshot_schema
import cheng/core/tooling/semantic_snapshot as snapshot_core

// CompilerFact -- unified canonical fact consumed by LSP, Debugger, World Resolver.
// All positions are 0-based line/column.
// Fact categories (from docs/cheng-lsp.md):
//   TokenFacts, ParseFacts, ImportGraphFacts, SymbolFacts,
//   TypeFacts, ExportSurfaceFacts, OwnershipFacts, ConcurrencyFacts, WorldFacts

type
    // FactKind -- discriminator for CompilerFact kind field
    FactKind = enum
        FactKindNone
        FactKindToken
        FactKindParseDiagnostic
        FactKindImportEdge
        FactKindSymbol
        FactKindTypeDef
        FactKindExportSurface
        FactKindOwnership
        FactKindConcurrency
        FactKindWorld
        FactKindFunctionSpan
        FactKindReference
        FactKindLexicalScope

    // TokenFact -- a single semantic token
    TokenFact =
        sourceId: int32
        spanId: int32
        canonicalKind: int32
        valueTextId: int32
        documentCid: layout.FixedBytes32
        sourcePath: str
        startLine: int32
        startColumn: int32
        endLine: int32
        endColumn: int32
        tokenKind: int32
        tokenText: str

    // ParseDiagnosticFact -- syntax or semantic diagnostic
    ParseDiagnosticFact =
        sourceId: int32
        spanId: int32
        producerKind: int32
        codeTextId: int32
        messageTextId: int32
        documentCid: layout.FixedBytes32
        sourcePath: str
        startLine: int32
        startColumn: int32
        endLine: int32
        endColumn: int32
        severity: int32
        code: int32
        codeText: str
        message: str

    // ImportEdgeFact -- a single import edge between modules
    ImportEdgeFact =
        sourceId: int32
        targetSourceId: int32
        spanId: int32
        documentCid: layout.FixedBytes32
        dependencyKind: int32
        observedInterfaceCid: layout.FixedBytes32
        ownerModulePath: str
        targetModulePath: str
        sourcePath: str
        startLine: int32
        startColumn: int32
        endLine: int32
        endColumn: int32
        resolved: bool
        cycleDetected: bool

    // SymbolFact -- a symbol definition or reference
    SymbolFact =
        sourceId: int32
        declarationSpanId: int32
        declId: int32
        typeId: int32
        ownerSymbolId: int32
        functionId: int32
        documentCid: layout.FixedBytes32
        symbolCid: layout.FixedBytes32
        declKeyCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        interfaceCid: layout.FixedBytes32
        name: str
        kind: int32
        modulePath: str
        sourcePath: str
        startLine: int32
        startColumn: int32
        endLine: int32
        endColumn: int32
        symbolId: int32
        isDefinition: bool
        typeText: str
        visibility: int32

    // TypeDefFact -- a type definition
    TypeDefFact =
        typeId: int32
        declSymbolId: int32
        declId: int32
        declarationPresent: bool
        typeCid: layout.FixedBytes32
        declSymbolCid: layout.FixedBytes32
        declKeyCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        managed: bool
        sendable: bool
        syncable: bool
        name: str
        modulePath: str
        sourcePath: str
        startLine: int32
        startColumn: int32
        kind: int32
        size: int32
        align: int32

    // ExportSurfaceFact -- visible symbols of a package
    ExportSurfaceFact =
        packageId: str
        sourcePath: str
        declarationTableCid: layout.FixedBytes32
        exportedSymbolCount: int32
        exportedSymbols: str[]
        exportedTargetNames: str[]
        exportedLayouts: int32[]
        exportedEffects: int32[]
        exportedCapabilities: int32[]
        exportedSymbolIds: int32[]
        exportedDeclIds: int32[]
        exportedDeclKeyCids: layout.FixedBytes32[]

    // OwnershipFact -- borrow/escape diagnostic
    OwnershipFact =
        typedNodeId: int32
        typedIrNodeIndex: int32
        functionId: int32
        functionSymbolId: int32
        functionDeclId: int32
        typeId: int32
        spanId: int32
        documentCid: layout.FixedBytes32
        functionSymbolCid: layout.FixedBytes32
        functionDeclKeyCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        sourcePath: str
        startLine: int32
        startColumn: int32
        endLine: int32
        endColumn: int32
        ownershipKind: int32
        message: str

    // ConcurrencyFact -- Send/Sync diagnostic
    ConcurrencyFact =
        typeId: int32
        functionId: int32
        symbolId: int32
        declId: int32
        declarationPresent: bool
        declKeyCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        verified: bool
        sourcePath: str
        startLine: int32
        startColumn: int32
        endLine: int32
        endColumn: int32
        concurrencyKind: int32
        message: str

    // WorldFact -- package/world snapshot identity
    WorldFact =
        worldHeadCid: str
        packageId: str
        sourceVersion: int64
        sourceBundleCid: str
        semanticSnapshotCidRaw: layout.FixedBytes32
        worldHeadCidRaw: layout.FixedBytes32
        compilerCidRaw: layout.FixedBytes32
        sourceBundleCidRaw: layout.FixedBytes32
        csgRootCidRaw: layout.FixedBytes32
        bindingReceiptCid: layout.FixedBytes32

    FunctionSpanFact =
        functionId: int32
        typedFunctionIndex: int32
        symbolId: int32
        declId: int32
        sourceId: int32
        declarationSpanId: int32
        bodySpanId: int32
        documentCid: layout.FixedBytes32
        declKeyCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        bodyContentCid: layout.FixedBytes32
        interfaceCid: layout.FixedBytes32
        readSetPreimageCid: layout.FixedBytes32
        name: str
        signatureStartLine: int32
        signatureStartColumn: int32
        bodyStartLine: int32
        bodyStartColumn: int32
        endLine: int32
        endColumn: int32

    ReferenceFact =
        rowId: int32
        sourceId: int32
        spanId: int32
        ownerFunctionId: int32
        ownerSymbolId: int32
        ownerDeclId: int32
        targetSymbolId: int32
        targetDeclId: int32
        referenceKind: int32
        bindingTypedNodeId: int32
        documentCid: layout.FixedBytes32
        ownerSymbolCid: layout.FixedBytes32
        targetSymbolCid: layout.FixedBytes32
        ownerDeclKeyCid: layout.FixedBytes32
        targetDeclKeyCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        targetName: str
        sourcePath: str
        startLine: int32
        startColumn: int32
        endLine: int32
        endColumn: int32

    LexicalScopeFact =
        scopeId: int32
        sourceId: int32
        spanId: int32
        parentScopeId: int32
        documentCid: layout.FixedBytes32
        startLine: int32
        startColumn: int32
        endLine: int32
        endColumn: int32
        visibleSymbolIds: int32[]
        visibleDeclIds: int32[]
        visibleDeclKeyCids: layout.FixedBytes32[]
        declarationTableCid: layout.FixedBytes32

    // CompilerFact -- unified fact record (kind discriminates which payload is active)
    CompilerFact =
        kind: FactKind
        sourceVersion: int64

        tokenFact: TokenFact
        parseDiagnosticFact: ParseDiagnosticFact
        importEdgeFact: ImportEdgeFact
        symbolFact: SymbolFact
        typeDefFact: TypeDefFact
        exportSurfaceFact: ExportSurfaceFact
        ownershipFact: OwnershipFact
        concurrencyFact: ConcurrencyFact
        worldFact: WorldFact
        functionSpanFact: FunctionSpanFact
        referenceFact: ReferenceFact
        lexicalScopeFact: LexicalScopeFact

    // CompilerFactBundle -- a complete fact set for one compilation
    CompilerFactBundle =
        sourceVersion: int64
        worldHeadCid: str
        packageId: str
        predecessorReceiptCid: layout.FixedBytes32
        bindingReceiptCid: layout.FixedBytes32
        semanticSnapshotCid: layout.FixedBytes32
        worldHeadCidRaw: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        csgRootCid: layout.FixedBytes32
        validationReceiptCid: layout.FixedBytes32
        projectionCid: layout.FixedBytes32
        facts: CompilerFact[]
        factCount: int32

// ---- Constants ----
const
    FactVisibilityPrivate: int32 = 1
    FactVisibilityExported: int32 = 2

    FactConcurrencySend: int32 = 0
    FactConcurrencySync: int32 = 1
    FactConcurrencyThreadBoundary: int32 = 2

@borrows
fn CompilerFactSnapshotProjectionCid(
        predecessorReceiptCid: layout.FixedBytes32,
        binding: snapshot_core.LocalSourceVersionBinding,
        validation: snapshot_core.SemanticSnapshotValidationReceipt):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(320)
    let domain = "cheng.compiler_fact.snapshot_projection"
    for index in 0..<domain.len:
        layout.ByteBufAppendByte(buf, Int32(domain[index]) & 255)
    layout.ByteBufAppendFixed32(buf, predecessorReceiptCid)
    layout.ByteBufAppendFixed32(buf, binding.bindingReceiptCid)
    layout.ByteBufAppendFixed32(buf, binding.semanticSnapshotCid)
    layout.ByteBufAppendFixed32(buf, binding.worldHeadCid)
    layout.ByteBufAppendFixed32(buf, binding.compilerCid)
    layout.ByteBufAppendFixed32(buf, binding.sourceBundleCid)
    layout.ByteBufAppendFixed32(buf, binding.csgRootCid)
    layout.ByteBufAppendFixed32(buf, validation.validationReceiptCid)
    let rawVersion = UInt64(binding.sourceVersion)
    layout.ByteBufAppendByte(
        buf, Int32((rawVersion >> UInt64(56)) & UInt64(255)))
    layout.ByteBufAppendByte(
        buf, Int32((rawVersion >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(
        buf, Int32((rawVersion >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(
        buf, Int32((rawVersion >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(
        buf, Int32((rawVersion >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(
        buf, Int32((rawVersion >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(
        buf, Int32((rawVersion >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32(rawVersion & UInt64(255)))
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn compilerFactSnapshotNew(kind: FactKind,
                           sourceVersion: int64): CompilerFact =
    var out: CompilerFact
    out.kind = kind
    out.sourceVersion = sourceVersion
    return out

@borrows
fn compilerFactSnapshotSourcePath(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        sourceId: int32): str =
    return system.SystemToStringStr(
        snapshot.texts[snapshot.sources.modulePathTextIds[sourceId]])

@borrows
fn compilerFactSnapshotFillToken(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        row: int32,
        sourceVersion: int64): CompilerFact =
    var fact = compilerFactSnapshotNew(FactKindToken, sourceVersion)
    let sourceId = snapshot.tokens.sourceIds[row]
    let spanId = snapshot.tokens.spanIds[row]
    var token: TokenFact
    token.sourceId = sourceId
    token.spanId = spanId
    token.canonicalKind = snapshot.tokens.kinds[row]
    token.valueTextId = snapshot.tokens.valueTextIds[row]
    token.documentCid =
        layout.FixedBytes32Copy(snapshot.sources.documentCids[sourceId])
    token.sourcePath = compilerFactSnapshotSourcePath(snapshot, sourceId)
    token.startLine = snapshot.spans.startLines[spanId]
    token.startColumn = snapshot.spans.startColumns[spanId]
    token.endLine = snapshot.spans.endLines[spanId]
    token.endColumn = snapshot.spans.endColumns[spanId]
    token.tokenKind = token.canonicalKind
    token.tokenText =
        system.SystemToStringStr(snapshot.texts[token.valueTextId])
    fact.tokenFact = token
    return fact

@borrows
fn CompilerFactSnapshotFillDiagnostic(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        row: int32,
        sourceVersion: int64): CompilerFact =
    var fact = compilerFactSnapshotNew(FactKindParseDiagnostic,
                                       sourceVersion)
    let sourceId = snapshot.diagnostics.sourceIds[row]
    let spanId = snapshot.diagnostics.spanIds[row]
    var diagnostic: ParseDiagnosticFact
    diagnostic.sourceId = sourceId
    diagnostic.spanId = spanId
    diagnostic.producerKind = snapshot.diagnostics.producerKinds[row]
    diagnostic.codeTextId = snapshot.diagnostics.codeTextIds[row]
    diagnostic.messageTextId = snapshot.diagnostics.messageTextIds[row]
    diagnostic.documentCid =
        layout.FixedBytes32Copy(snapshot.sources.documentCids[sourceId])
    diagnostic.sourcePath = compilerFactSnapshotSourcePath(snapshot,
                                                            sourceId)
    diagnostic.startLine = snapshot.spans.startLines[spanId]
    diagnostic.startColumn = snapshot.spans.startColumns[spanId]
    diagnostic.endLine = snapshot.spans.endLines[spanId]
    diagnostic.endColumn = snapshot.spans.endColumns[spanId]
    diagnostic.severity = snapshot.diagnostics.severities[row]
    diagnostic.code = diagnostic.codeTextId
    diagnostic.codeText =
        system.SystemToStringStr(snapshot.texts[diagnostic.codeTextId])
    diagnostic.message =
        system.SystemToStringStr(snapshot.texts[diagnostic.messageTextId])
    fact.parseDiagnosticFact = diagnostic
    return fact

@borrows
fn CompilerFactSnapshotFillLexicalScope(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        row: int32,
        sourceVersion: int64): CompilerFact =
    var fact = compilerFactSnapshotNew(
        FactKindLexicalScope, sourceVersion)
    let sourceId = snapshot.lexicalScopes.sourceIds[row]
    let spanId = snapshot.lexicalScopes.spanIds[row]
    var scope: LexicalScopeFact
    scope.scopeId = row
    scope.sourceId = sourceId
    scope.spanId = spanId
    scope.parentScopeId = snapshot.lexicalScopes.parentScopeIds[row]
    scope.documentCid =
        layout.FixedBytes32Copy(snapshot.sources.documentCids[sourceId])
    scope.startLine = snapshot.spans.startLines[spanId]
    scope.startColumn = snapshot.spans.startColumns[spanId]
    scope.endLine = snapshot.spans.endLines[spanId]
    scope.endColumn = snapshot.spans.endColumns[spanId]
    scope.declarationTableCid =
        layout.FixedBytes32Copy(snapshot.declarations.tableCid)
    let visibleStart = snapshot.lexicalScopes.visibleStarts[row]
    let visibleCount = snapshot.lexicalScopes.visibleCounts[row]
    for offset in 0..<visibleCount:
        let symbolId =
            snapshot.lexicalScopes.visibleSymbolIds[visibleStart + offset]
        add(scope.visibleSymbolIds, symbolId)
        add(scope.visibleDeclIds, snapshot.symbols.declIds[symbolId])
        add(scope.visibleDeclKeyCids,
            layout.FixedBytes32Copy(
                snapshot.symbols.declKeyCids[symbolId]))
    fact.lexicalScopeFact = scope
    return fact

# Exact O(1) SymbolId projection shared by the full CompilerFact bundle and
# pinned query consumers.  The admitted snapshot owns all row validation.
@borrows
fn CompilerFactSnapshotFillSymbol(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        row: int32,
        sourceVersion: int64): CompilerFact =
    var fact = compilerFactSnapshotNew(FactKindSymbol, sourceVersion)
    let sourceId = snapshot.symbols.sourceIds[row]
    let spanId = snapshot.symbols.declarationSpanIds[row]
    let typeId = snapshot.symbols.typeIds[row]
    var symbol: SymbolFact
    symbol.sourceId = sourceId
    symbol.declarationSpanId = spanId
    symbol.declId = snapshot.symbols.declIds[row]
    symbol.typeId = typeId
    symbol.ownerSymbolId = snapshot.symbols.ownerSymbolIds[row]
    symbol.functionId = snapshot.symbols.functionIds[row]
    symbol.documentCid =
        layout.FixedBytes32Copy(snapshot.sources.documentCids[sourceId])
    symbol.symbolCid =
        layout.FixedBytes32Copy(snapshot.symbols.symbolCids[row])
    symbol.declKeyCid =
        layout.FixedBytes32Copy(snapshot.symbols.declKeyCids[row])
    symbol.declarationTableCid =
        layout.FixedBytes32Copy(snapshot.declarations.tableCid)
    symbol.interfaceCid =
        layout.FixedBytes32Copy(snapshot.symbols.interfaceCids[row])
    symbol.name = system.SystemToStringStr(
        snapshot.texts[snapshot.symbols.nameTextIds[row]])
    symbol.modulePath = compilerFactSnapshotSourcePath(snapshot, sourceId)
    symbol.sourcePath =
        compilerFactSnapshotSourcePath(snapshot, sourceId)
    symbol.kind = snapshot.symbols.symbolKinds[row]
    if spanId < 0:
        if symbol.kind != snapshot_schema.CsgCompilerSymbolModule ||
           snapshot.symbols.nameSpanIds[row] != -1 ||
           snapshot.symbols.nameTokenIds[row] != -1:
            panic("compiler_fact_coordinate_less_non_module_symbol")
        # An implicit Module has no source declaration.  Its canonical
        # navigation anchor is the start of the exact source document.
        symbol.startLine = 0
        symbol.startColumn = 0
        symbol.endLine = 0
        symbol.endColumn = 0
    else:
        symbol.startLine = snapshot.spans.startLines[spanId]
        symbol.startColumn = snapshot.spans.startColumns[spanId]
        symbol.endLine = snapshot.spans.endLines[spanId]
        symbol.endColumn = snapshot.spans.endColumns[spanId]
    symbol.symbolId = row
    symbol.isDefinition = true
    if typeId >= 0:
        let typeTextId = snapshot.types.canonicalTextIds[typeId]
        symbol.typeText =
            system.SystemToStringStr(snapshot.texts[typeTextId])
    if snapshot.symbols.exportedFlags[row]:
        symbol.visibility = FactVisibilityExported
    else:
        symbol.visibility = FactVisibilityPrivate
    fact.symbolFact = symbol
    return fact

@borrows
fn CompilerFactSnapshotFillReference(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        row: int32,
        sourceVersion: int64): CompilerFact =
    var fact = compilerFactSnapshotNew(FactKindReference, sourceVersion)
    let sourceId = snapshot.references.sourceIds[row]
    let spanId = snapshot.references.spanIds[row]
    let target = snapshot.references.targetSymbolIds[row]
    var reference: ReferenceFact
    reference.rowId = row
    reference.sourceId = sourceId
    reference.spanId = spanId
    let ownerFunctionId = snapshot.references.ownerFunctionIds[row]
    let ownerSymbolId = snapshot.references.ownerSymbolIds[row]
    reference.ownerFunctionId = ownerFunctionId
    reference.ownerSymbolId = ownerSymbolId
    reference.ownerDeclId = snapshot.symbols.declIds[ownerSymbolId]
    reference.targetSymbolId = target
    reference.targetDeclId = snapshot.symbols.declIds[target]
    reference.referenceKind = snapshot.references.referenceKinds[row]
    reference.bindingTypedNodeId =
        snapshot.references.bindingTypedNodeIds[row]
    reference.documentCid =
        layout.FixedBytes32Copy(snapshot.sources.documentCids[sourceId])
    reference.ownerSymbolCid =
        layout.FixedBytes32Copy(
            snapshot.symbols.symbolCids[ownerSymbolId])
    reference.targetSymbolCid =
        layout.FixedBytes32Copy(snapshot.symbols.symbolCids[target])
    reference.ownerDeclKeyCid =
        layout.FixedBytes32Copy(
            snapshot.symbols.declKeyCids[ownerSymbolId])
    reference.targetDeclKeyCid =
        layout.FixedBytes32Copy(snapshot.symbols.declKeyCids[target])
    reference.declarationTableCid =
        layout.FixedBytes32Copy(snapshot.declarations.tableCid)
    let targetNameTextId = snapshot.symbols.nameTextIds[target]
    reference.targetName =
        system.SystemToStringStr(snapshot.texts[targetNameTextId])
    reference.sourcePath = compilerFactSnapshotSourcePath(snapshot, sourceId)
    reference.startLine = snapshot.spans.startLines[spanId]
    reference.startColumn = snapshot.spans.startColumns[spanId]
    reference.endLine = snapshot.spans.endLines[spanId]
    reference.endColumn = snapshot.spans.endColumns[spanId]
    fact.referenceFact = reference
    return fact

@borrows
fn compilerFactSnapshotFillOwnership(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        row: int32,
        sourceVersion: int64): CompilerFact =
    var fact = compilerFactSnapshotNew(FactKindOwnership, sourceVersion)
    let spanId = snapshot.typedNodes.spanIds[row]
    let sourceId = snapshot.spans.sourceIds[spanId]
    let functionId = snapshot.typedNodes.functionIds[row]
    let functionSymbolId = snapshot.functions.symbolIds[functionId]
    var ownership: OwnershipFact
    ownership.typedNodeId = row
    ownership.typedIrNodeIndex =
        snapshot.typedNodes.typedIrNodeIndexes[row]
    ownership.functionId = functionId
    ownership.functionSymbolId = functionSymbolId
    ownership.functionDeclId = snapshot.symbols.declIds[functionSymbolId]
    ownership.typeId = snapshot.typedNodes.typeIds[row]
    ownership.spanId = spanId
    ownership.documentCid =
        layout.FixedBytes32Copy(snapshot.sources.documentCids[sourceId])
    ownership.functionSymbolCid =
        layout.FixedBytes32Copy(
            snapshot.symbols.symbolCids[functionSymbolId])
    ownership.functionDeclKeyCid =
        layout.FixedBytes32Copy(
            snapshot.symbols.declKeyCids[functionSymbolId])
    ownership.declarationTableCid =
        layout.FixedBytes32Copy(snapshot.declarations.tableCid)
    ownership.sourcePath = compilerFactSnapshotSourcePath(snapshot, sourceId)
    ownership.startLine = snapshot.spans.startLines[spanId]
    ownership.startColumn = snapshot.spans.startColumns[spanId]
    ownership.endLine = snapshot.spans.endLines[spanId]
    ownership.endColumn = snapshot.spans.endColumns[spanId]
    ownership.ownershipKind = snapshot.typedNodes.ownershipKinds[row]
    fact.ownershipFact = ownership
    return fact

@borrows
fn compilerFactSnapshotFillFunctionSpan(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        row: int32,
        sourceVersion: int64): CompilerFact =
    var fact = compilerFactSnapshotNew(FactKindFunctionSpan, sourceVersion)
    let symbolId = snapshot.functions.symbolIds[row]
    let sourceId = snapshot.symbols.sourceIds[symbolId]
    let declarationSpanId = snapshot.symbols.declarationSpanIds[symbolId]
    let bodySpanId = snapshot.functions.bodySpanIds[row]
    var span: FunctionSpanFact
    span.functionId = row
    span.typedFunctionIndex = snapshot.functions.typedFunctionIndexes[row]
    span.symbolId = symbolId
    span.declId = snapshot.symbols.declIds[symbolId]
    span.sourceId = sourceId
    span.declarationSpanId = declarationSpanId
    span.bodySpanId = bodySpanId
    span.documentCid =
        layout.FixedBytes32Copy(snapshot.sources.documentCids[sourceId])
    span.declKeyCid =
        layout.FixedBytes32Copy(snapshot.symbols.declKeyCids[symbolId])
    span.declarationTableCid =
        layout.FixedBytes32Copy(snapshot.declarations.tableCid)
    span.bodyContentCid =
        layout.FixedBytes32Copy(snapshot.functions.bodyContentCids[row])
    span.interfaceCid =
        layout.FixedBytes32Copy(snapshot.functions.interfaceCids[row])
    span.readSetPreimageCid =
        layout.FixedBytes32Copy(snapshot.functions.readSetPreimageCids[row])
    span.name = system.SystemToStringStr(
        snapshot.texts[snapshot.symbols.nameTextIds[symbolId]])
    span.signatureStartLine = snapshot.spans.startLines[declarationSpanId]
    span.signatureStartColumn = snapshot.spans.startColumns[declarationSpanId]
    span.bodyStartLine = snapshot.spans.startLines[bodySpanId]
    span.bodyStartColumn = snapshot.spans.startColumns[bodySpanId]
    span.endLine = snapshot.spans.endLines[bodySpanId]
    span.endColumn = snapshot.spans.endColumns[bodySpanId]
    fact.functionSpanFact = span
    return fact

@borrows
fn compilerFactSnapshotFillTypeConcurrency(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        typeId: int32,
        concurrencyKind: int32,
        sourceVersion: int64): CompilerFact =
    var fact = compilerFactSnapshotNew(FactKindConcurrency, sourceVersion)
    var concurrency: ConcurrencyFact
    concurrency.typeId = typeId
    concurrency.functionId = -1
    concurrency.symbolId = snapshot.types.declSymbolIds[typeId]
    concurrency.declId = -1
    concurrency.declarationTableCid =
        layout.FixedBytes32Copy(snapshot.declarations.tableCid)
    concurrency.concurrencyKind = concurrencyKind
    if concurrencyKind == FactConcurrencySend:
        concurrency.verified = snapshot.types.sendFlags[typeId]
    elif concurrencyKind == FactConcurrencySync:
        concurrency.verified = snapshot.types.syncFlags[typeId]
    else:
        panic("compiler_fact_type_concurrency_kind_invalid")
    if concurrency.symbolId >= 0:
        concurrency.declarationPresent = true
        concurrency.declId =
            snapshot.symbols.declIds[concurrency.symbolId]
        concurrency.declKeyCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.declKeyCids[concurrency.symbolId])
    fact.concurrencyFact = concurrency
    return fact

@borrows
fn CompilerFactsFromSemanticSnapshotInto(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        identity: snapshot_core.PortableSemanticSnapshotIdentity,
        binding: snapshot_core.LocalSourceVersionBinding,
        validation: snapshot_core.SemanticSnapshotValidationReceipt,
        predecessorReceiptCid: layout.FixedBytes32,
        packageId: str,
        out: var CompilerFactBundle,
        err: var str): bool =
    err = ""
    if packageId == "" ||
       !snapshot_schema.CsgCompilerSnapshotTablesStrictValidateInto(
           snapshot, err) ||
       !snapshot_core.SemanticSnapshotValidationReceiptStrictValidateInto(
           validation, binding, identity, err) ||
       !layout.FixedBytes32Equal(snapshot.predecessorReceiptCid,
                                 predecessorReceiptCid):
        if err == "":
            err = " compiler facts: invalid admitted semantic snapshot"
        return false
    var bundle: CompilerFactBundle
    bundle.sourceVersion = binding.sourceVersion
    bundle.packageId = system.SystemToStringStr(packageId)
    bundle.predecessorReceiptCid =
        layout.FixedBytes32Copy(predecessorReceiptCid)
    bundle.bindingReceiptCid =
        layout.FixedBytes32Copy(binding.bindingReceiptCid)
    bundle.semanticSnapshotCid =
        layout.FixedBytes32Copy(identity.semanticSnapshotCid)
    bundle.worldHeadCidRaw =
        layout.FixedBytes32Copy(identity.worldHeadCid)
    bundle.compilerCid = layout.FixedBytes32Copy(identity.compilerCid)
    bundle.sourceBundleCid =
        layout.FixedBytes32Copy(identity.sourceBundleCid)
    bundle.csgRootCid = layout.FixedBytes32Copy(identity.csgRootCid)
    bundle.validationReceiptCid =
        layout.FixedBytes32Copy(validation.validationReceiptCid)

    for row in 0..<snapshot.tokens.sourceIds.len:
        add(bundle.facts, compilerFactSnapshotFillToken(
            snapshot, row, binding.sourceVersion))
    for row in 0..<snapshot.diagnostics.sourceIds.len:
        add(bundle.facts, CompilerFactSnapshotFillDiagnostic(
            snapshot, row, binding.sourceVersion))
    for row in 0..<snapshot.dependencies.sourceIds.len:
        var fact = compilerFactSnapshotNew(FactKindImportEdge,
                                           binding.sourceVersion)
        let sourceId = snapshot.dependencies.sourceIds[row]
        let targetSourceId = snapshot.dependencies.targetSourceIds[row]
        let spanId = snapshot.dependencies.spanIds[row]
        var edge: ImportEdgeFact
        edge.sourceId = sourceId
        edge.targetSourceId = targetSourceId
        edge.spanId = spanId
        edge.documentCid =
            layout.FixedBytes32Copy(
                snapshot.sources.documentCids[sourceId])
        edge.dependencyKind = snapshot.dependencies.dependencyKinds[row]
        edge.observedInterfaceCid =
            layout.FixedBytes32Copy(
                snapshot.dependencies.observedInterfaceCids[row])
        edge.ownerModulePath = compilerFactSnapshotSourcePath(snapshot,
                                                               sourceId)
        edge.targetModulePath = compilerFactSnapshotSourcePath(
            snapshot, targetSourceId)
        edge.sourcePath =
            compilerFactSnapshotSourcePath(snapshot, sourceId)
        edge.startLine = snapshot.spans.startLines[spanId]
        edge.startColumn = snapshot.spans.startColumns[spanId]
        edge.endLine = snapshot.spans.endLines[spanId]
        edge.endColumn = snapshot.spans.endColumns[spanId]
        edge.resolved = true
        fact.importEdgeFact = edge
        add(bundle.facts, fact)
    for row in 0..<snapshot.symbols.symbolCids.len:
        add(bundle.facts, CompilerFactSnapshotFillSymbol(
            snapshot, row, binding.sourceVersion))
    for row in 0..<snapshot.lexicalScopes.sourceIds.len:
        add(bundle.facts, CompilerFactSnapshotFillLexicalScope(
            snapshot, row, binding.sourceVersion))
    for row in 0..<snapshot.references.sourceIds.len:
        add(bundle.facts, CompilerFactSnapshotFillReference(
            snapshot, row, binding.sourceVersion))
    var layoutCursor: int32
    for row in 0..<snapshot.types.typeCids.len:
        while layoutCursor < snapshot.layouts.typeIds.len &&
              snapshot.layouts.typeIds[layoutCursor] < row:
            layoutCursor = layoutCursor + 1
        var fact = compilerFactSnapshotNew(FactKindTypeDef,
                                           binding.sourceVersion)
        var typeFact: TypeDefFact
        typeFact.typeId = row
        typeFact.declSymbolId = snapshot.types.declSymbolIds[row]
        typeFact.declId = -1
        typeFact.typeCid =
            layout.FixedBytes32Copy(snapshot.types.typeCids[row])
        typeFact.declarationTableCid =
            layout.FixedBytes32Copy(snapshot.declarations.tableCid)
        if typeFact.declSymbolId >= 0:
            typeFact.declarationPresent = true
            typeFact.declId = snapshot.symbols.declIds[typeFact.declSymbolId]
            typeFact.declSymbolCid =
                layout.FixedBytes32Copy(
                    snapshot.symbols.symbolCids[
                        typeFact.declSymbolId])
            typeFact.declKeyCid =
                layout.FixedBytes32Copy(
                    snapshot.symbols.declKeyCids[
                        typeFact.declSymbolId])
        typeFact.managed = snapshot.types.managedFlags[row]
        typeFact.sendable = snapshot.types.sendFlags[row]
        typeFact.syncable = snapshot.types.syncFlags[row]
        typeFact.name = system.SystemToStringStr(
            snapshot.texts[snapshot.types.canonicalTextIds[row]])
        typeFact.kind = snapshot.types.typeKinds[row]
        if layoutCursor < snapshot.layouts.typeIds.len &&
           snapshot.layouts.typeIds[layoutCursor] == row:
            typeFact.size = snapshot.layouts.sizeBytes[layoutCursor]
            typeFact.align = snapshot.layouts.alignBytes[layoutCursor]
        fact.typeDefFact = typeFact
        add(bundle.facts, fact)

        add(bundle.facts, compilerFactSnapshotFillTypeConcurrency(
            snapshot, row, FactConcurrencySend, binding.sourceVersion))
        add(bundle.facts, compilerFactSnapshotFillTypeConcurrency(
            snapshot, row, FactConcurrencySync, binding.sourceVersion))
    for row in 0..<snapshot.typedNodes.functionIds.len:
        add(bundle.facts, compilerFactSnapshotFillOwnership(
            snapshot, row, binding.sourceVersion))
    for row in 0..<snapshot.functions.symbolIds.len:
        add(bundle.facts, compilerFactSnapshotFillFunctionSpan(
            snapshot, row, binding.sourceVersion))
        if !snapshot_schema.CsgCompilerFunctionAnnotationHas(
               snapshot.functions.annotationFlags[row],
               snapshot_schema.CsgCompilerFunctionAnnotationThreadBoundary):
            continue
        let symbolId = snapshot.functions.symbolIds[row]
        let sourceId = snapshot.symbols.sourceIds[symbolId]
        let spanId = snapshot.symbols.declarationSpanIds[symbolId]
        var fact = compilerFactSnapshotNew(FactKindConcurrency,
                                           binding.sourceVersion)
        var concurrency: ConcurrencyFact
        concurrency.typeId = snapshot.symbols.typeIds[symbolId]
        concurrency.functionId = row
        concurrency.symbolId = symbolId
        concurrency.declId = snapshot.symbols.declIds[symbolId]
        concurrency.declarationPresent = true
        concurrency.declKeyCid =
            layout.FixedBytes32Copy(
                snapshot.symbols.declKeyCids[symbolId])
        concurrency.declarationTableCid =
            layout.FixedBytes32Copy(snapshot.declarations.tableCid)
        concurrency.verified = true
        concurrency.sourcePath = compilerFactSnapshotSourcePath(snapshot,
                                                                 sourceId)
        concurrency.startLine = snapshot.spans.startLines[spanId]
        concurrency.startColumn = snapshot.spans.startColumns[spanId]
        concurrency.endLine = snapshot.spans.endLines[spanId]
        concurrency.endColumn = snapshot.spans.endColumns[spanId]
        concurrency.concurrencyKind = FactConcurrencyThreadBoundary
        fact.concurrencyFact = concurrency
        add(bundle.facts, fact)

    var exportFact = compilerFactSnapshotNew(FactKindExportSurface,
                                             binding.sourceVersion)
    var surface: ExportSurfaceFact
    surface.packageId = system.SystemToStringStr(packageId)
    surface.declarationTableCid =
        layout.FixedBytes32Copy(snapshot.declarations.tableCid)
    for row in 0..<snapshot.symbols.symbolCids.len:
        if snapshot.symbols.exportedFlags[row]:
            add(surface.exportedSymbolIds, row)
            add(surface.exportedDeclIds, snapshot.symbols.declIds[row])
            add(surface.exportedDeclKeyCids,
                layout.FixedBytes32Copy(
                    snapshot.symbols.declKeyCids[row]))
            add(surface.exportedSymbols,
                system.SystemToStringStr(
                    snapshot.texts[
                        snapshot.symbols.nameTextIds[row]]))
            add(surface.exportedTargetNames,
                system.SystemToStringStr(
                    snapshot.texts[
                        snapshot.symbols.qualifiedNameTextIds[row]]))
    surface.exportedSymbolCount = surface.exportedSymbolIds.len
    exportFact.exportSurfaceFact = surface
    add(bundle.facts, exportFact)

    var worldFact = compilerFactSnapshotNew(FactKindWorld,
                                            binding.sourceVersion)
    var world: WorldFact
    world.packageId = system.SystemToStringStr(packageId)
    world.sourceVersion = binding.sourceVersion
    world.semanticSnapshotCidRaw =
        layout.FixedBytes32Copy(identity.semanticSnapshotCid)
    world.worldHeadCidRaw =
        layout.FixedBytes32Copy(identity.worldHeadCid)
    world.compilerCidRaw =
        layout.FixedBytes32Copy(identity.compilerCid)
    world.sourceBundleCidRaw =
        layout.FixedBytes32Copy(identity.sourceBundleCid)
    world.csgRootCidRaw =
        layout.FixedBytes32Copy(identity.csgRootCid)
    world.bindingReceiptCid =
        layout.FixedBytes32Copy(binding.bindingReceiptCid)
    worldFact.worldFact = world
    add(bundle.facts, worldFact)

    bundle.factCount = bundle.facts.len
    bundle.projectionCid = CompilerFactSnapshotProjectionCid(
        predecessorReceiptCid, binding, validation)
    out = bundle
    err = ""
    return true
