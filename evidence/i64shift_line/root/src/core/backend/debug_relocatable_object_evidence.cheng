import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

const
    DebugRelocatableObjectFormatMachO = 1
    DebugRelocatableObjectFormatElf = 2
    DebugRelocatableObjectFormatCoff = 3

    DebugRelocatableObjectMachineA64 = 1
    DebugRelocatableObjectMachineX86_64 = 2

type
    DebugRelocatableObjectFunctionEvidence =
        symbolTableIndex: int32 = -1
        sectionIndex: int32 = -1
        sectionRelativeByteStart: int32 = -1
        objectFileByteStart: int32 = -1
        byteLength: int32
        bytesCid: layout.FixedBytes32

    DebugRelocatableObjectEvidence =
        valid: bool
        formatKind: int32
        machineKind: int32
        textSectionIndex: int32 = -1
        textSectionFileOffset: int32 = -1
        textSectionByteLength: int32
        symbolTableFileOffset: int32 = -1
        symbolCount: int32
        relocationTableFileOffset: int32 = -1
        relocationCount: int32
        objectCid: layout.FixedBytes32
        functions: DebugRelocatableObjectFunctionEvidence[]
        evidenceCid: layout.FixedBytes32

fn debugObjectRangeWithin(start: int32,
                          byteLength: int32,
                          total: int32): bool =
    return start >= 0 && byteLength >= 0 && total >= 0 &&
           start <= total - byteLength

@borrows
fn debugObjectReadU16(bytes: rawbytes.Bytes,
                      offset: int32): int32 =
    if !debugObjectRangeWithin(offset, 2, rawbytes.BytesLen(bytes)):
        return -1
    return rawbytes.BytesGet(bytes, offset) +
           rawbytes.BytesGet(bytes, offset + 1) * 256

@borrows
fn debugObjectReadU32(bytes: rawbytes.Bytes,
                      offset: int32): int64 =
    if !debugObjectRangeWithin(offset, 4, rawbytes.BytesLen(bytes)):
        return int64(-1)
    return int64(rawbytes.BytesGet(bytes, offset)) +
           int64(rawbytes.BytesGet(bytes, offset + 1)) * int64(256) +
           int64(rawbytes.BytesGet(bytes, offset + 2)) * int64(65536) +
           int64(rawbytes.BytesGet(bytes, offset + 3)) * int64(16777216)

@borrows
fn debugObjectReadU32Bounded(bytes: rawbytes.Bytes,
                             offset: int32): int32 =
    let value = debugObjectReadU32(bytes, offset)
    if value < int64(0) || value > int64(2147483647):
        return -1
    return int32(value)

@borrows
fn debugObjectReadU64Bounded(bytes: rawbytes.Bytes,
                             offset: int32): int32 =
    if !debugObjectRangeWithin(offset, 8, rawbytes.BytesLen(bytes)):
        return -1
    for index in 4..<8:
        if rawbytes.BytesGet(bytes, offset + index) != 0:
            return -1
    return debugObjectReadU32Bounded(bytes, offset)

@borrows
fn debugObjectFixedNameEquals(bytes: rawbytes.Bytes,
                              offset: int32,
                              width: int32,
                              expected: str): bool =
    if expected.len <= 0 || expected.len > width ||
       !debugObjectRangeWithin(offset, width, rawbytes.BytesLen(bytes)):
        return false
    for index in 0..<expected.len:
        if rawbytes.BytesGet(bytes, offset + index) !=
           (int32(expected[index]) & 255):
            return false
    for index in expected.len..<width:
        if rawbytes.BytesGet(bytes, offset + index) != 0:
            return false
    return true

@borrows
fn debugObjectCStringValid(bytes: rawbytes.Bytes,
                           start: int32,
                           byteLength: int32,
                           relativeOffset: int32): bool =
    if !debugObjectRangeWithin(start, byteLength,
                               rawbytes.BytesLen(bytes)) ||
       relativeOffset < 0 || relativeOffset >= byteLength:
        return false
    for index in relativeOffset..<byteLength:
        if rawbytes.BytesGet(bytes, start + index) == 0:
            return true
    return false

@borrows
fn debugObjectCStringEquals(bytes: rawbytes.Bytes,
                            start: int32,
                            byteLength: int32,
                            relativeOffset: int32,
                            expected: str): bool =
    if expected.len <= 0 ||
       relativeOffset < 0 ||
       relativeOffset > byteLength - expected.len - 1 ||
       !debugObjectRangeWithin(start, byteLength,
                               rawbytes.BytesLen(bytes)):
        return false
    for index in 0..<expected.len:
        if rawbytes.BytesGet(bytes, start + relativeOffset + index) !=
           (int32(expected[index]) & 255):
            return false
    return rawbytes.BytesGet(
               bytes, start + relativeOffset + expected.len) == 0

@borrows
fn debugObjectExpectedShapeValid(objectBytes: rawbytes.Bytes,
                                 symbolNames: str[],
                                 symbolByteStarts: int32[],
                                 symbolByteLengths: int32[]): bool =
    if rawbytes.BytesLen(objectBytes) <= 0 || symbolNames.len <= 0 ||
       symbolByteStarts.len != symbolNames.len ||
       symbolByteLengths.len != symbolNames.len:
        return false
    for index in 0..<symbolNames.len:
        if symbolNames[index].len <= 0 || symbolByteStarts[index] < 0 ||
           symbolByteLengths[index] <= 0:
            return false
        for prior in 0..<index:
            if symbolNames[prior] == symbolNames[index]:
                return false
            let leftStart = symbolByteStarts[prior]
            let leftEnd = leftStart + symbolByteLengths[prior]
            let rightStart = symbolByteStarts[index]
            let rightEnd = rightStart + symbolByteLengths[index]
            if leftEnd < leftStart || rightEnd < rightStart ||
               (leftStart < rightEnd && rightStart < leftEnd):
                return false
    return true

fn debugObjectAppendI32(buf: var layout.ByteBuf,
                        value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

@borrows
fn debugObjectEvidenceCid(
        evidence: DebugRelocatableObjectEvidence): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(160 + evidence.functions.len * 64)
    let domain = "cheng.debug.relocatable_object_evidence"
    for index in 0..<domain.len:
        layout.ByteBufAppendByte(buf, int32(domain[index]) & 255)
    debugObjectAppendI32(buf, evidence.formatKind)
    debugObjectAppendI32(buf, evidence.machineKind)
    debugObjectAppendI32(buf, evidence.textSectionIndex)
    debugObjectAppendI32(buf, evidence.textSectionFileOffset)
    debugObjectAppendI32(buf, evidence.textSectionByteLength)
    debugObjectAppendI32(buf, evidence.symbolTableFileOffset)
    debugObjectAppendI32(buf, evidence.symbolCount)
    debugObjectAppendI32(buf, evidence.relocationTableFileOffset)
    debugObjectAppendI32(buf, evidence.relocationCount)
    layout.ByteBufAppendFixed32(buf, evidence.objectCid)
    debugObjectAppendI32(buf, evidence.functions.len)
    for index in 0..<evidence.functions.len:
        let row = evidence.functions[index]
        debugObjectAppendI32(buf, row.symbolTableIndex)
        debugObjectAppendI32(buf, row.sectionIndex)
        debugObjectAppendI32(buf, row.sectionRelativeByteStart)
        debugObjectAppendI32(buf, row.objectFileByteStart)
        debugObjectAppendI32(buf, row.byteLength)
        layout.ByteBufAppendFixed32(buf, row.bytesCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn debugObjectFinish(objectBytes: rawbytes.Bytes,
                     out: var DebugRelocatableObjectEvidence,
                     err: var str): bool =
    if out.formatKind < DebugRelocatableObjectFormatMachO ||
       out.formatKind > DebugRelocatableObjectFormatCoff ||
       out.machineKind < DebugRelocatableObjectMachineA64 ||
       out.machineKind > DebugRelocatableObjectMachineX86_64 ||
       out.textSectionIndex <= 0 || out.textSectionFileOffset < 0 ||
       out.textSectionByteLength <= 0 ||
       !debugObjectRangeWithin(out.textSectionFileOffset,
                               out.textSectionByteLength,
                               rawbytes.BytesLen(objectBytes)) ||
       out.symbolTableFileOffset < 0 || out.symbolCount <= 0 ||
       out.functions.len <= 0:
        err = " debug object evidence: incomplete parsed object"
        return false
    out.objectCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(objectBytes))
    out.evidenceCid = debugObjectEvidenceCid(out)
    out.valid = true
    err = ""
    return true

fn debugObjectMachORelocationTypeValid(relocType: int32,
                                       byteWidth: int32): bool =
    if relocType == 0:
        return byteWidth == 8
    return (relocType == 2 || relocType == 3 || relocType == 4) &&
           byteWidth == 4

@borrows
fn debugObjectBuildMachO(
        objectBytes: rawbytes.Bytes,
        symbolNames: str[],
        symbolByteStarts: int32[],
        symbolByteLengths: int32[],
        out: var DebugRelocatableObjectEvidence,
        err: var str): bool =
    let objectLength = rawbytes.BytesLen(objectBytes)
    if objectLength < 32 ||
       debugObjectReadU32(objectBytes, 0) != int64(4277009103) ||
       debugObjectReadU32(objectBytes, 4) != int64(16777228) ||
       debugObjectReadU32(objectBytes, 8) != int64(0) ||
       debugObjectReadU32(objectBytes, 12) != int64(1) ||
       debugObjectReadU32(objectBytes, 24) != int64(0) ||
       debugObjectReadU32(objectBytes, 28) != int64(0):
        err = " debug object evidence: invalid Mach-O relocatable header"
        return false
    let commandCount = debugObjectReadU32Bounded(objectBytes, 16)
    let commandBytes = debugObjectReadU32Bounded(objectBytes, 20)
    if commandCount != 2 || commandBytes <= 0 ||
       !debugObjectRangeWithin(32, commandBytes, objectLength):
        err = " debug object evidence: invalid Mach-O load commands"
        return false
    var commandOffset = int32(32)
    var sectionOrdinal: int32
    var textFound: int32
    var symbolTableFound: int32
    var segmentFound: int32
    var textRelocationOffset: int32 = -1
    var sectionFileOffsets: int32[]
    var sectionByteLengths: int32[]
    for commandIndex in 0..<commandCount:
        if !debugObjectRangeWithin(commandOffset, 8, objectLength):
            err = " debug object evidence: truncated Mach-O load command"
            return false
        let commandKind = debugObjectReadU32Bounded(
            objectBytes, commandOffset)
        let commandSize = debugObjectReadU32Bounded(
            objectBytes, commandOffset + 4)
        if commandSize < 8 ||
           !debugObjectRangeWithin(commandOffset, commandSize,
                                   32 + commandBytes):
            err = " debug object evidence: malformed Mach-O load command"
            return false
        if commandKind == 25:
            if segmentFound != 0:
                err = " debug object evidence: duplicate Mach-O segment"
                return false
            segmentFound = 1
            let sectionCount = debugObjectReadU32Bounded(
                objectBytes, commandOffset + 64)
            if sectionCount <= 0 ||
               commandSize != 72 + sectionCount * 80:
                err = " debug object evidence: malformed Mach-O segment"
                return false
            for sectionOffset in 0..<sectionCount:
                let section = commandOffset + 72 + sectionOffset * 80
                sectionOrdinal = sectionOrdinal + 1
                let sectionSize = debugObjectReadU64Bounded(
                    objectBytes, section + 40)
                let fileOffset = debugObjectReadU32Bounded(
                    objectBytes, section + 48)
                let relocationOffset = debugObjectReadU32Bounded(
                    objectBytes, section + 56)
                let relocationCount = debugObjectReadU32Bounded(
                    objectBytes, section + 60)
                if sectionSize <= 0 || fileOffset < 0 ||
                   relocationOffset < 0 || relocationCount < 0 ||
                   !debugObjectRangeWithin(fileOffset, sectionSize,
                                           objectLength):
                    err = " debug object evidence: malformed Mach-O section"
                    return false
                add(sectionFileOffsets, fileOffset)
                add(sectionByteLengths, sectionSize)
                if debugObjectFixedNameEquals(
                       objectBytes, section, 16, "__text"):
                    if !debugObjectFixedNameEquals(
                           objectBytes, section + 16, 16, "__TEXT") ||
                       textFound != 0 || sectionSize <= 0 ||
                       debugObjectReadU64Bounded(
                           objectBytes, section + 32) != 0 ||
                       debugObjectReadU32Bounded(
                           objectBytes, section + 52) != 2 ||
                       debugObjectReadU32(
                           objectBytes, section + 64) !=
                           int64(2147484672):
                        err = " debug object evidence: duplicate or invalid Mach-O text"
                        return false
                    textFound = 1
                    out.textSectionIndex = sectionOrdinal
                    out.textSectionFileOffset = fileOffset
                    out.textSectionByteLength = sectionSize
                    out.relocationTableFileOffset = relocationOffset
                    out.relocationCount = relocationCount
                    textRelocationOffset = relocationOffset
        elif commandKind == 2:
            if commandSize != 24 || symbolTableFound != 0:
                err = " debug object evidence: duplicate or invalid Mach-O symtab"
                return false
            symbolTableFound = 1
            out.symbolTableFileOffset = debugObjectReadU32Bounded(
                objectBytes, commandOffset + 8)
            out.symbolCount = debugObjectReadU32Bounded(
                objectBytes, commandOffset + 12)
            let stringTableOffset = debugObjectReadU32Bounded(
                objectBytes, commandOffset + 16)
            let stringTableLength = debugObjectReadU32Bounded(
                objectBytes, commandOffset + 20)
            if out.symbolTableFileOffset < 0 || out.symbolCount <= 0 ||
               stringTableOffset < 0 || stringTableLength <= 1 ||
               out.symbolTableFileOffset + out.symbolCount * 16 !=
                   stringTableOffset ||
               stringTableOffset + stringTableLength != objectLength ||
               rawbytes.BytesGet(objectBytes, stringTableOffset) != 0:
                err = " debug object evidence: malformed Mach-O symbol storage"
                return false
            var matched: bool[]
            setLen(matched, symbolNames.len)
            for symbolIndex in 0..<out.symbolCount:
                let symbolOffset = out.symbolTableFileOffset +
                                   symbolIndex * 16
                let nameOffset = debugObjectReadU32Bounded(
                    objectBytes, symbolOffset)
                let symbolType = rawbytes.BytesGet(
                    objectBytes, symbolOffset + 4)
                let sectionIndex = rawbytes.BytesGet(
                    objectBytes, symbolOffset + 5)
                let symbolValue = debugObjectReadU64Bounded(
                    objectBytes, symbolOffset + 8)
                if nameOffset <= 0 || nameOffset >= stringTableLength ||
                   !debugObjectCStringValid(
                       objectBytes, stringTableOffset,
                       stringTableLength, nameOffset) ||
                   symbolValue < 0 ||
                   !((symbolType == 0 || symbolType == 1) &&
                     sectionIndex == 0 ||
                     (symbolType == 14 || symbolType == 15) &&
                     sectionIndex > 0 && sectionIndex <= sectionOrdinal):
                    err = " debug object evidence: malformed Mach-O symbol"
                    return false
                for expectedIndex in 0..<symbolNames.len:
                    if debugObjectCStringEquals(
                           objectBytes, stringTableOffset,
                           stringTableLength, nameOffset,
                           symbolNames[expectedIndex]):
                        if matched[expectedIndex] ||
                           (symbolType != 14 && symbolType != 15) ||
                           sectionIndex != out.textSectionIndex ||
                           symbolValue !=
                               symbolByteStarts[expectedIndex] ||
                           !debugObjectRangeWithin(
                               symbolValue,
                               symbolByteLengths[expectedIndex],
                               out.textSectionByteLength):
                            err = " debug object evidence: duplicate, undefined, or misplaced Mach-O function"
                            return false
                        var row: DebugRelocatableObjectFunctionEvidence
                        row.symbolTableIndex = symbolIndex
                        row.sectionIndex = sectionIndex
                        row.sectionRelativeByteStart = symbolValue
                        row.objectFileByteStart =
                            out.textSectionFileOffset + symbolValue
                        row.byteLength = symbolByteLengths[expectedIndex]
                        let functionBytes = rawbytes.BytesSliceView(
                            objectBytes, row.objectFileByteStart,
                            row.byteLength)
                        row.bytesCid = hash256.Sha256Fixed(
                            layout.ByteSpanFromBytes(functionBytes))
                        while out.functions.len <= expectedIndex:
                            add(out.functions,
                                DebugRelocatableObjectFunctionEvidence())
                        out.functions[expectedIndex] = row
                        matched[expectedIndex] = true
            for expectedIndex in 0..<matched.len:
                if !matched[expectedIndex]:
                    err = " debug object evidence: missing Mach-O function symbol"
                    return false
        else:
            err = " debug object evidence: unknown Mach-O load command"
            return false
        commandOffset = commandOffset + commandSize
    if commandOffset != 32 + commandBytes || segmentFound != 1 ||
       textFound != 1 || symbolTableFound != 1:
        err = " debug object evidence: incomplete Mach-O structure"
        return false
    var sectionPayloadEnd = out.symbolTableFileOffset
    if out.relocationCount > 0:
        sectionPayloadEnd = textRelocationOffset
    for sectionIndex in 0..<sectionFileOffsets.len:
        if sectionFileOffsets[sectionIndex] < 32 + commandBytes ||
           !debugObjectRangeWithin(
               sectionFileOffsets[sectionIndex],
               sectionByteLengths[sectionIndex], sectionPayloadEnd):
            err = " debug object evidence: overlapping Mach-O metadata and section"
            return false
        for prior in 0..<sectionIndex:
            let leftStart = sectionFileOffsets[prior]
            let leftEnd = leftStart + sectionByteLengths[prior]
            let rightStart = sectionFileOffsets[sectionIndex]
            let rightEnd = rightStart + sectionByteLengths[sectionIndex]
            if leftStart < rightEnd && rightStart < leftEnd:
                err = " debug object evidence: overlapping Mach-O sections"
                return false
    if out.relocationCount == 0:
        if textRelocationOffset != 0:
            err = " debug object evidence: inconsistent empty Mach-O relocation table"
            return false
        out.relocationTableFileOffset = -1
    else:
        if textRelocationOffset <= 0 ||
           !debugObjectRangeWithin(
               textRelocationOffset, out.relocationCount * 8,
               out.symbolTableFileOffset):
            err = " debug object evidence: truncated Mach-O relocations"
            return false
        var relocationOffsets: int32[]
        for relocationIndex in 0..<out.relocationCount:
            let offset = textRelocationOffset + relocationIndex * 8
            let textOffset = debugObjectReadU32Bounded(
                objectBytes, offset)
            let word = debugObjectReadU32(objectBytes, offset + 4)
            if textOffset < 0 || word < int64(0):
                err = " debug object evidence: malformed Mach-O relocation"
                return false
            let symbolIndex = int32(word % int64(16777216))
            let pcRelative = int32(
                (word / int64(16777216)) % int64(2))
            let lengthCode = int32(
                (word / int64(33554432)) % int64(4))
            let external = int32(
                (word / int64(134217728)) % int64(2))
            let relocationType = int32(
                (word / int64(268435456)) % int64(16))
            var byteWidth = int32(0)
            if lengthCode == 2:
                byteWidth = 4
            elif lengthCode == 3:
                byteWidth = 8
            if symbolIndex < 0 || symbolIndex >= out.symbolCount ||
               external != 1 ||
               !debugObjectMachORelocationTypeValid(
                   relocationType, byteWidth) ||
               !debugObjectRangeWithin(textOffset, byteWidth,
                                       out.textSectionByteLength) ||
               ((relocationType == 0 || relocationType == 4) &&
                pcRelative != 0) ||
               ((relocationType == 2 || relocationType == 3) &&
                pcRelative != 1):
                err = " debug object evidence: inconsistent Mach-O relocation"
                return false
            for prior in 0..<relocationOffsets.len:
                if relocationOffsets[prior] == textOffset:
                    err = " debug object evidence: duplicate Mach-O relocation offset"
                    return false
            add(relocationOffsets, textOffset)
    out.formatKind = DebugRelocatableObjectFormatMachO
    out.machineKind = DebugRelocatableObjectMachineA64
    return debugObjectFinish(objectBytes, out, err)

fn debugObjectElfRelocationValid(machineKind: int32,
                                 relocationType: int32): bool =
    if machineKind == DebugRelocatableObjectMachineA64:
        return relocationType == 257 || relocationType == 258 ||
               relocationType == 275 || relocationType == 277 ||
               relocationType == 282 || relocationType == 283
    return relocationType == 1 || relocationType == 2 ||
           relocationType == 4 || relocationType == 10

fn debugObjectElfRelocationByteWidth(machineKind: int32,
                                     relocationType: int32): int32 =
    if machineKind == DebugRelocatableObjectMachineA64 &&
       relocationType == 257:
        return 8
    if machineKind == DebugRelocatableObjectMachineX86_64 &&
       relocationType == 1:
        return 8
    return 4

@borrows
fn debugObjectBuildElf(
        objectBytes: rawbytes.Bytes,
        symbolNames: str[],
        symbolByteStarts: int32[],
        symbolByteLengths: int32[],
        out: var DebugRelocatableObjectEvidence,
        err: var str): bool =
    let objectLength = rawbytes.BytesLen(objectBytes)
    if objectLength < 64 || rawbytes.BytesGet(objectBytes, 0) != 127 ||
       rawbytes.BytesGet(objectBytes, 1) != 69 ||
       rawbytes.BytesGet(objectBytes, 2) != 76 ||
       rawbytes.BytesGet(objectBytes, 3) != 70 ||
       rawbytes.BytesGet(objectBytes, 4) != 2 ||
       rawbytes.BytesGet(objectBytes, 5) != 1 ||
       rawbytes.BytesGet(objectBytes, 6) != 1 ||
       debugObjectReadU16(objectBytes, 16) != 1:
        err = " debug object evidence: invalid ELF relocatable header"
        return false
    for identIndex in 7..<16:
        if rawbytes.BytesGet(objectBytes, identIndex) != 0:
            err = " debug object evidence: non-canonical ELF identity padding"
            return false
    let machine = debugObjectReadU16(objectBytes, 18)
    if machine == 183:
        out.machineKind = DebugRelocatableObjectMachineA64
    elif machine == 62:
        out.machineKind = DebugRelocatableObjectMachineX86_64
    else:
        err = " debug object evidence: unsupported ELF machine"
        return false
    let sectionTableOffset = debugObjectReadU64Bounded(objectBytes, 40)
    let sectionHeaderSize = debugObjectReadU16(objectBytes, 58)
    let sectionCount = debugObjectReadU16(objectBytes, 60)
    let sectionNameIndex = debugObjectReadU16(objectBytes, 62)
    if debugObjectReadU32(objectBytes, 20) != int64(1) ||
       debugObjectReadU64Bounded(objectBytes, 24) != 0 ||
       debugObjectReadU64Bounded(objectBytes, 32) != 0 ||
       debugObjectReadU32(objectBytes, 48) != int64(0) ||
       debugObjectReadU16(objectBytes, 52) != 64 ||
       debugObjectReadU16(objectBytes, 54) != 0 ||
       debugObjectReadU16(objectBytes, 56) != 0 ||
       sectionTableOffset <= 0 || sectionHeaderSize != 64 ||
       sectionCount <= 1 || sectionNameIndex <= 0 ||
       sectionNameIndex >= sectionCount ||
       sectionTableOffset + sectionCount * 64 != objectLength:
        err = " debug object evidence: malformed ELF section table"
        return false
    var sectionTypes: int32[]
    var sectionFlags: int32[]
    var sectionOffsets: int32[]
    var sectionLengths: int32[]
    var sectionLinks: int32[]
    var sectionInfos: int32[]
    var sectionEntrySizes: int32[]
    var sectionNameOffsets: int32[]
    for sectionIndex in 0..<sectionCount:
        let offset = sectionTableOffset + sectionIndex * 64
        add(sectionNameOffsets,
            debugObjectReadU32Bounded(objectBytes, offset))
        add(sectionTypes,
            debugObjectReadU32Bounded(objectBytes, offset + 4))
        add(sectionFlags,
            debugObjectReadU64Bounded(objectBytes, offset + 8))
        let sectionFileOffset = debugObjectReadU64Bounded(
            objectBytes, offset + 24)
        let sectionByteLength = debugObjectReadU64Bounded(
            objectBytes, offset + 32)
        add(sectionOffsets, sectionFileOffset)
        add(sectionLengths, sectionByteLength)
        add(sectionLinks,
            debugObjectReadU32Bounded(objectBytes, offset + 40))
        add(sectionInfos,
            debugObjectReadU32Bounded(objectBytes, offset + 44))
        add(sectionEntrySizes,
            debugObjectReadU64Bounded(objectBytes, offset + 56))
        if sectionTypes[sectionIndex] < 0 ||
           sectionFlags[sectionIndex] < 0 ||
           sectionFileOffset < 0 || sectionByteLength < 0 ||
           sectionLinks[sectionIndex] < 0 ||
           sectionInfos[sectionIndex] < 0 ||
           sectionEntrySizes[sectionIndex] < 0 ||
           (sectionTypes[sectionIndex] != 8 &&
            !debugObjectRangeWithin(
                sectionFileOffset, sectionByteLength,
                sectionTableOffset)):
            err = " debug object evidence: malformed ELF section"
            return false
    if sectionTypes[0] != 0 || sectionFlags[0] != 0 ||
       sectionOffsets[0] != 0 ||
       sectionLengths[0] != 0:
        err = " debug object evidence: invalid ELF null section"
        return false
    for sectionIndex in 1..<sectionCount:
        if sectionTypes[sectionIndex] != 8 &&
           sectionLengths[sectionIndex] > 0:
            for prior in 1..<sectionIndex:
                if sectionTypes[prior] != 8 &&
                   sectionLengths[prior] > 0:
                    let leftStart = sectionOffsets[prior]
                    let leftEnd = leftStart + sectionLengths[prior]
                    let rightStart = sectionOffsets[sectionIndex]
                    let rightEnd = rightStart +
                                   sectionLengths[sectionIndex]
                    if leftStart < rightEnd && rightStart < leftEnd:
                        err = " debug object evidence: overlapping ELF sections"
                        return false
    let shstrOffset = sectionOffsets[sectionNameIndex]
    let shstrLength = sectionLengths[sectionNameIndex]
    if sectionTypes[sectionNameIndex] != 3 ||
       sectionFlags[sectionNameIndex] != 0 || shstrLength <= 1 ||
       rawbytes.BytesGet(objectBytes, shstrOffset) != 0:
        err = " debug object evidence: invalid ELF section-name table"
        return false
    var symtabIndex: int32 = -1
    var relocationIndex: int32 = -1
    for sectionIndex in 1..<sectionCount:
        if !debugObjectCStringValid(
               objectBytes, shstrOffset, shstrLength,
               sectionNameOffsets[sectionIndex]):
            err = " debug object evidence: invalid ELF section name"
            return false
        if debugObjectCStringEquals(
               objectBytes, shstrOffset, shstrLength,
               sectionNameOffsets[sectionIndex], ".text"):
            if out.textSectionIndex >= 0:
                err = " debug object evidence: duplicate ELF text"
                return false
            if sectionTypes[sectionIndex] != 1:
                err = " debug object evidence: ELF text has wrong section kind"
                return false
            if sectionFlags[sectionIndex] != 6:
                err = " debug object evidence: ELF text lacks exact executable flags"
                return false
            if sectionLengths[sectionIndex] <= 0:
                err = " debug object evidence: empty ELF text"
                return false
            out.textSectionIndex = sectionIndex
            out.textSectionFileOffset = sectionOffsets[sectionIndex]
            out.textSectionByteLength = sectionLengths[sectionIndex]
        elif sectionTypes[sectionIndex] == 2:
            if symtabIndex >= 0:
                err = " debug object evidence: duplicate ELF symbol table"
                return false
            symtabIndex = sectionIndex
        elif sectionTypes[sectionIndex] == 4:
            if relocationIndex >= 0:
                err = " debug object evidence: duplicate ELF relocation table"
                return false
            relocationIndex = sectionIndex
    if out.textSectionIndex <= 0 || symtabIndex <= 0:
        err = " debug object evidence: missing ELF text or symbol table"
        return false
    let stringTableIndex = sectionLinks[symtabIndex]
    if stringTableIndex <= 0 || stringTableIndex >= sectionCount ||
       sectionTypes[stringTableIndex] != 3 ||
       sectionFlags[stringTableIndex] != 0 ||
       sectionFlags[symtabIndex] != 0 ||
       sectionEntrySizes[symtabIndex] != 24 ||
       sectionLengths[symtabIndex] <= 0 ||
       sectionLengths[symtabIndex] % 24 != 0:
        err = " debug object evidence: inconsistent ELF symbol table"
        return false
    out.symbolTableFileOffset = sectionOffsets[symtabIndex]
    out.symbolCount = sectionLengths[symtabIndex] / 24
    let stringTableOffset = sectionOffsets[stringTableIndex]
    let stringTableLength = sectionLengths[stringTableIndex]
    if out.symbolCount <= 1 || stringTableLength <= 1 ||
       rawbytes.BytesGet(objectBytes, stringTableOffset) != 0:
        err = " debug object evidence: malformed ELF symbol strings"
        return false
    var matched: bool[]
    setLen(matched, symbolNames.len)
    let firstNonLocal = sectionInfos[symtabIndex]
    if firstNonLocal <= 0 || firstNonLocal > out.symbolCount:
        err = " debug object evidence: invalid ELF local symbol boundary"
        return false
    for symbolIndex in 0..<out.symbolCount:
        let symbolOffset = out.symbolTableFileOffset + symbolIndex * 24
        let nameOffset = debugObjectReadU32Bounded(
            objectBytes, symbolOffset)
        let info = rawbytes.BytesGet(objectBytes, symbolOffset + 4)
        let other = rawbytes.BytesGet(objectBytes, symbolOffset + 5)
        let symbolSection = debugObjectReadU16(
            objectBytes, symbolOffset + 6)
        let symbolValue = debugObjectReadU64Bounded(
            objectBytes, symbolOffset + 8)
        let symbolLength = debugObjectReadU64Bounded(
            objectBytes, symbolOffset + 16)
        let binding = (info / 16) % 16
        let symbolType = info % 16
        if nameOffset < 0 || nameOffset >= stringTableLength ||
           (symbolIndex > 0 && nameOffset == 0) ||
           !debugObjectCStringValid(
               objectBytes, stringTableOffset, stringTableLength,
               nameOffset) || other != 0 || symbolValue < 0 ||
           symbolLength < 0 ||
           (symbolSection != 0 && symbolSection >= sectionCount) ||
           (binding != 0 && binding != 1) ||
           (symbolType != 0 && symbolType != 1 && symbolType != 2) ||
           (symbolIndex < firstNonLocal && binding != 0) ||
           (symbolIndex >= firstNonLocal && binding == 0):
            err = " debug object evidence: malformed ELF symbol"
            return false
        if symbolIndex == 0 &&
           (nameOffset != 0 || info != 0 || symbolSection != 0 ||
            symbolValue != 0 || symbolLength != 0):
            err = " debug object evidence: non-null ELF null symbol"
            return false
        for expectedIndex in 0..<symbolNames.len:
            if debugObjectCStringEquals(
                   objectBytes, stringTableOffset,
                   stringTableLength, nameOffset,
                   symbolNames[expectedIndex]):
                if matched[expectedIndex] || symbolType != 2 ||
                   symbolSection != out.textSectionIndex ||
                   symbolValue != symbolByteStarts[expectedIndex] ||
                   symbolLength != symbolByteLengths[expectedIndex] ||
                   !debugObjectRangeWithin(
                       symbolValue, symbolLength,
                       out.textSectionByteLength):
                    err = " debug object evidence: duplicate, undefined, or misplaced ELF function"
                    return false
                var row: DebugRelocatableObjectFunctionEvidence
                row.symbolTableIndex = symbolIndex
                row.sectionIndex = symbolSection
                row.sectionRelativeByteStart = symbolValue
                row.objectFileByteStart =
                    out.textSectionFileOffset + symbolValue
                row.byteLength = symbolLength
                let functionBytes = rawbytes.BytesSliceView(
                    objectBytes, row.objectFileByteStart,
                    row.byteLength)
                row.bytesCid = hash256.Sha256Fixed(
                    layout.ByteSpanFromBytes(functionBytes))
                while out.functions.len <= expectedIndex:
                    add(out.functions,
                        DebugRelocatableObjectFunctionEvidence())
                out.functions[expectedIndex] = row
                matched[expectedIndex] = true
    for expectedIndex in 0..<matched.len:
        if !matched[expectedIndex]:
            err = " debug object evidence: missing ELF function symbol"
            return false
    if relocationIndex < 0:
        out.relocationTableFileOffset = -1
    else:
        if sectionLinks[relocationIndex] != symtabIndex ||
           sectionInfos[relocationIndex] != out.textSectionIndex ||
           sectionFlags[relocationIndex] != 0 ||
           sectionEntrySizes[relocationIndex] != 24 ||
           sectionLengths[relocationIndex] <= 0 ||
           sectionLengths[relocationIndex] % 24 != 0:
            err = " debug object evidence: inconsistent ELF relocation section"
            return false
        out.relocationTableFileOffset = sectionOffsets[relocationIndex]
        out.relocationCount = sectionLengths[relocationIndex] / 24
        var relocationOffsets: int32[]
        for relocationOffset in 0..<out.relocationCount:
            let entry = out.relocationTableFileOffset +
                        relocationOffset * 24
            let textOffset = debugObjectReadU64Bounded(
                objectBytes, entry)
            let infoLow = debugObjectReadU32Bounded(
                objectBytes, entry + 8)
            let symbolIndex = debugObjectReadU32Bounded(
                objectBytes, entry + 12)
            let byteWidth = debugObjectElfRelocationByteWidth(
                out.machineKind, infoLow)
            if textOffset < 0 || infoLow < 0 ||
               symbolIndex <= 0 || symbolIndex >= out.symbolCount ||
               !debugObjectElfRelocationValid(
                   out.machineKind, infoLow) ||
               !debugObjectRangeWithin(
                   textOffset, byteWidth,
                   out.textSectionByteLength):
                err = " debug object evidence: inconsistent ELF relocation"
                return false
            for prior in 0..<relocationOffsets.len:
                if relocationOffsets[prior] == textOffset:
                    err = " debug object evidence: duplicate ELF relocation offset"
                    return false
            add(relocationOffsets, textOffset)
    out.formatKind = DebugRelocatableObjectFormatElf
    return debugObjectFinish(objectBytes, out, err)

@borrows
fn debugObjectCoffSymbolNameEquals(
        objectBytes: rawbytes.Bytes,
        symbolOffset: int32,
        stringTableOffset: int32,
        stringTableLength: int32,
        expected: str): bool =
    let firstWord = debugObjectReadU32(objectBytes, symbolOffset)
    if firstWord == int64(0):
        let nameOffset = debugObjectReadU32Bounded(
            objectBytes, symbolOffset + 4)
        return debugObjectCStringEquals(
            objectBytes, stringTableOffset, stringTableLength,
            nameOffset, expected)
    return debugObjectFixedNameEquals(
        objectBytes, symbolOffset, 8, expected)

@borrows
fn debugObjectCoffSymbolNameValid(
        objectBytes: rawbytes.Bytes,
        symbolOffset: int32,
        stringTableOffset: int32,
        stringTableLength: int32): bool =
    let firstWord = debugObjectReadU32(objectBytes, symbolOffset)
    if firstWord == int64(0):
        let nameOffset = debugObjectReadU32Bounded(
            objectBytes, symbolOffset + 4)
        return nameOffset >= 4 && debugObjectCStringValid(
            objectBytes, stringTableOffset, stringTableLength,
            nameOffset)
    var terminated: bool
    for index in 0..<8:
        let byteValue = rawbytes.BytesGet(
            objectBytes, symbolOffset + index)
        if byteValue == 0:
            terminated = true
        elif terminated:
            return false
    return true

fn debugObjectCoffRelocationValid(machineKind: int32,
                                  relocationType: int32): bool =
    if machineKind == DebugRelocatableObjectMachineA64:
        return relocationType == 1 || relocationType == 2 ||
               relocationType == 3 || relocationType == 4 ||
               relocationType == 6
    return relocationType == 1 || relocationType == 2 ||
           relocationType == 4 || relocationType == 11

fn debugObjectCoffRelocationByteWidth(machineKind: int32,
                                      relocationType: int32): int32 =
    if machineKind == DebugRelocatableObjectMachineA64 &&
       relocationType == 2:
        return 8
    if machineKind == DebugRelocatableObjectMachineX86_64 &&
       relocationType == 1:
        return 8
    return 4

@borrows
fn debugObjectBuildCoff(
        objectBytes: rawbytes.Bytes,
        symbolNames: str[],
        symbolByteStarts: int32[],
        symbolByteLengths: int32[],
        out: var DebugRelocatableObjectEvidence,
        err: var str): bool =
    let objectLength = rawbytes.BytesLen(objectBytes)
    if objectLength < 60:
        err = " debug object evidence: truncated COFF header"
        return false
    let machine = debugObjectReadU16(objectBytes, 0)
    if machine == 43620:
        out.machineKind = DebugRelocatableObjectMachineA64
    elif machine == 34404:
        out.machineKind = DebugRelocatableObjectMachineX86_64
    else:
        err = " debug object evidence: unsupported COFF machine"
        return false
    let sectionCount = debugObjectReadU16(objectBytes, 2)
    out.symbolTableFileOffset = debugObjectReadU32Bounded(objectBytes, 8)
    out.symbolCount = debugObjectReadU32Bounded(objectBytes, 12)
    if sectionCount <= 0 || sectionCount > 2 ||
       debugObjectReadU32(objectBytes, 4) != int64(0) ||
       debugObjectReadU16(objectBytes, 16) != 0 ||
       debugObjectReadU16(objectBytes, 18) != 0 ||
       out.symbolTableFileOffset <= 0 || out.symbolCount <= 0 ||
       !debugObjectRangeWithin(20, sectionCount * 40, objectLength):
        err = " debug object evidence: malformed COFF header"
        return false
    var sectionRawOffsets: int32[]
    var sectionRawLengths: int32[]
    for sectionOffset in 0..<sectionCount:
        let section = 20 + sectionOffset * 40
        let rawLength = debugObjectReadU32Bounded(
            objectBytes, section + 16)
        let rawOffset = debugObjectReadU32Bounded(
            objectBytes, section + 20)
        let relocationOffset = debugObjectReadU32Bounded(
            objectBytes, section + 24)
        let relocationCount = debugObjectReadU16(
            objectBytes, section + 32)
        let characteristics = debugObjectReadU32(
            objectBytes, section + 36)
        if rawLength < 0 || rawOffset < 0 || relocationOffset < 0 ||
           relocationCount < 0 || characteristics < int64(0) ||
           !debugObjectRangeWithin(rawOffset, rawLength,
                                   objectLength):
            err = " debug object evidence: malformed COFF section"
            return false
        if rawLength > 0:
            if rawOffset < 20 + sectionCount * 40:
                err = " debug object evidence: COFF section overlaps headers"
                return false
            for prior in 0..<sectionRawOffsets.len:
                let leftStart = sectionRawOffsets[prior]
                let leftEnd = leftStart + sectionRawLengths[prior]
                let rightEnd = rawOffset + rawLength
                if leftStart < rightEnd && rawOffset < leftEnd:
                    err = " debug object evidence: overlapping COFF sections"
                    return false
            add(sectionRawOffsets, rawOffset)
            add(sectionRawLengths, rawLength)
        if debugObjectFixedNameEquals(
               objectBytes, section, 8, ".text"):
            if out.textSectionIndex >= 0 || rawLength <= 0 ||
               characteristics != int64(1613758496):
                err = " debug object evidence: duplicate or invalid COFF text"
                return false
            out.textSectionIndex = sectionOffset + 1
            out.textSectionFileOffset = rawOffset
            out.textSectionByteLength = rawLength
            out.relocationTableFileOffset = relocationOffset
            out.relocationCount = relocationCount
        elif !debugObjectFixedNameEquals(
                 objectBytes, section, 8, ".data"):
            err = " debug object evidence: unknown COFF section"
            return false
        elif relocationCount != 0 ||
             characteristics != int64(3225419840):
            err = " debug object evidence: unsupported COFF data relocation"
            return false
    if out.textSectionIndex <= 0 ||
       !debugObjectRangeWithin(
           out.symbolTableFileOffset, out.symbolCount * 18,
           objectLength):
        err = " debug object evidence: missing COFF text or symbols"
        return false
    for sectionIndex in 0..<sectionRawOffsets.len:
        if sectionRawOffsets[sectionIndex] +
               sectionRawLengths[sectionIndex] >
           out.relocationTableFileOffset:
            err = " debug object evidence: COFF section overlaps relocations"
            return false
    let stringTableOffset = out.symbolTableFileOffset +
                            out.symbolCount * 18
    let stringTableLength = debugObjectReadU32Bounded(
        objectBytes, stringTableOffset)
    if stringTableLength < 4 ||
       stringTableOffset + stringTableLength != objectLength:
        err = " debug object evidence: malformed COFF string table"
        return false
    var matched: bool[]
    setLen(matched, symbolNames.len)
    for symbolIndex in 0..<out.symbolCount:
        let symbolOffset = out.symbolTableFileOffset + symbolIndex * 18
        let symbolValue = debugObjectReadU32Bounded(
            objectBytes, symbolOffset + 8)
        let symbolSection = debugObjectReadU16(
            objectBytes, symbolOffset + 12)
        let symbolType = debugObjectReadU16(
            objectBytes, symbolOffset + 14)
        let storageClass = rawbytes.BytesGet(
            objectBytes, symbolOffset + 16)
        let auxiliaryCount = rawbytes.BytesGet(
            objectBytes, symbolOffset + 17)
        if !debugObjectCoffSymbolNameValid(
               objectBytes, symbolOffset,
               stringTableOffset, stringTableLength) ||
           symbolValue < 0 || symbolSection < 0 ||
           symbolSection > sectionCount || symbolType != 0 ||
           (storageClass != 2 && storageClass != 3) ||
           auxiliaryCount != 0:
            err = " debug object evidence: malformed COFF symbol"
            return false
        for expectedIndex in 0..<symbolNames.len:
            if debugObjectCoffSymbolNameEquals(
                   objectBytes, symbolOffset,
                   stringTableOffset, stringTableLength,
                   symbolNames[expectedIndex]):
                if matched[expectedIndex] ||
                   symbolSection != out.textSectionIndex ||
                   symbolValue != symbolByteStarts[expectedIndex] ||
                   !debugObjectRangeWithin(
                       symbolValue,
                       symbolByteLengths[expectedIndex],
                       out.textSectionByteLength):
                    err = " debug object evidence: duplicate, undefined, or misplaced COFF function"
                    return false
                var row: DebugRelocatableObjectFunctionEvidence
                row.symbolTableIndex = symbolIndex
                row.sectionIndex = symbolSection
                row.sectionRelativeByteStart = symbolValue
                row.objectFileByteStart =
                    out.textSectionFileOffset + symbolValue
                row.byteLength = symbolByteLengths[expectedIndex]
                let functionBytes = rawbytes.BytesSliceView(
                    objectBytes, row.objectFileByteStart,
                    row.byteLength)
                row.bytesCid = hash256.Sha256Fixed(
                    layout.ByteSpanFromBytes(functionBytes))
                while out.functions.len <= expectedIndex:
                    add(out.functions,
                        DebugRelocatableObjectFunctionEvidence())
                out.functions[expectedIndex] = row
                matched[expectedIndex] = true
    for expectedIndex in 0..<matched.len:
        if !matched[expectedIndex]:
            err = " debug object evidence: missing COFF function symbol"
            return false
    if out.relocationCount == 0:
        out.relocationTableFileOffset = -1
    else:
        if out.relocationTableFileOffset <= 0 ||
           out.relocationTableFileOffset + out.relocationCount * 10 !=
               out.symbolTableFileOffset:
            err = " debug object evidence: inconsistent COFF relocation table"
            return false
        var relocationOffsets: int32[]
        for relocationIndex in 0..<out.relocationCount:
            let relocation = out.relocationTableFileOffset +
                             relocationIndex * 10
            let textOffset = debugObjectReadU32Bounded(
                objectBytes, relocation)
            let symbolIndex = debugObjectReadU32Bounded(
                objectBytes, relocation + 4)
            let relocationType = debugObjectReadU16(
                objectBytes, relocation + 8)
            let byteWidth = debugObjectCoffRelocationByteWidth(
                out.machineKind, relocationType)
            if textOffset < 0 || symbolIndex < 0 ||
               symbolIndex >= out.symbolCount ||
               !debugObjectCoffRelocationValid(
                   out.machineKind, relocationType) ||
               !debugObjectRangeWithin(
                   textOffset, byteWidth,
                   out.textSectionByteLength):
                err = " debug object evidence: inconsistent COFF relocation"
                return false
            for prior in 0..<relocationOffsets.len:
                if relocationOffsets[prior] == textOffset:
                    err = " debug object evidence: duplicate COFF relocation offset"
                    return false
            add(relocationOffsets, textOffset)
    out.formatKind = DebugRelocatableObjectFormatCoff
    return debugObjectFinish(objectBytes, out, err)

@borrows
fn DebugRelocatableObjectEvidenceBuildInto(
        objectBytes: rawbytes.Bytes,
        symbolNames: str[],
        symbolByteStarts: int32[],
        symbolByteLengths: int32[],
        out: var DebugRelocatableObjectEvidence,
        err: var str): bool =
    out = DebugRelocatableObjectEvidence()
    out.textSectionIndex = -1
    out.textSectionFileOffset = -1
    out.symbolTableFileOffset = -1
    out.relocationTableFileOffset = -1
    err = ""
    if !debugObjectExpectedShapeValid(
           objectBytes, symbolNames,
           symbolByteStarts, symbolByteLengths):
        err = " debug object evidence: invalid expected function shape"
        return false
    if rawbytes.BytesLen(objectBytes) >= 4 &&
       debugObjectReadU32(objectBytes, 0) == int64(4277009103):
        return debugObjectBuildMachO(
            objectBytes, symbolNames, symbolByteStarts,
            symbolByteLengths, out, err)
    if rawbytes.BytesLen(objectBytes) >= 4 &&
       rawbytes.BytesGet(objectBytes, 0) == 127 &&
       rawbytes.BytesGet(objectBytes, 1) == 69 &&
       rawbytes.BytesGet(objectBytes, 2) == 76 &&
       rawbytes.BytesGet(objectBytes, 3) == 70:
        return debugObjectBuildElf(
            objectBytes, symbolNames, symbolByteStarts,
            symbolByteLengths, out, err)
    let machine = debugObjectReadU16(objectBytes, 0)
    if machine == 43620 || machine == 34404:
        return debugObjectBuildCoff(
            objectBytes, symbolNames, symbolByteStarts,
            symbolByteLengths, out, err)
    err = " debug object evidence: unknown relocatable object format"
    return false

@borrows
fn DebugRelocatableObjectEvidenceStrictValidateInto(
        evidence: DebugRelocatableObjectEvidence,
        objectBytes: rawbytes.Bytes,
        symbolNames: str[],
        symbolByteStarts: int32[],
        symbolByteLengths: int32[],
        err: var str): bool =
    var rebuilt: DebugRelocatableObjectEvidence
    if !DebugRelocatableObjectEvidenceBuildInto(
           objectBytes, symbolNames, symbolByteStarts,
           symbolByteLengths, rebuilt, err):
        return false
    if !evidence.valid || evidence.formatKind != rebuilt.formatKind ||
       evidence.machineKind != rebuilt.machineKind ||
       evidence.textSectionIndex != rebuilt.textSectionIndex ||
       evidence.textSectionFileOffset != rebuilt.textSectionFileOffset ||
       evidence.textSectionByteLength != rebuilt.textSectionByteLength ||
       evidence.symbolTableFileOffset != rebuilt.symbolTableFileOffset ||
       evidence.symbolCount != rebuilt.symbolCount ||
       evidence.relocationTableFileOffset !=
           rebuilt.relocationTableFileOffset ||
       evidence.relocationCount != rebuilt.relocationCount ||
       !layout.FixedBytes32Equal(evidence.objectCid, rebuilt.objectCid) ||
       !layout.FixedBytes32Equal(
           evidence.evidenceCid, rebuilt.evidenceCid) ||
       evidence.functions.len != rebuilt.functions.len:
        err = " debug object evidence: published object evidence mismatch"
        return false
    for index in 0..<evidence.functions.len:
        let left = evidence.functions[index]
        let right = rebuilt.functions[index]
        if left.symbolTableIndex != right.symbolTableIndex ||
           left.sectionIndex != right.sectionIndex ||
           left.sectionRelativeByteStart !=
               right.sectionRelativeByteStart ||
           left.objectFileByteStart != right.objectFileByteStart ||
           left.byteLength != right.byteLength ||
           !layout.FixedBytes32Equal(left.bytesCid, right.bytesCid):
            err = " debug object evidence: function evidence mismatch"
            return false
    err = ""
    return true
