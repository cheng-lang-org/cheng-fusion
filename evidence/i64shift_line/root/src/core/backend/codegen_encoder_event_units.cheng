# codegen_encoder_event_units.cheng —— B3 encoder 事件单元直调门面
#
# 形态裁定（B2 先例 kernel-b2-20260825/evidence/language_probes/PROBES_B2.md）：
# 托管复合（事件表 SoA int32[]/int64[] 列 + FixedBytes32 根）过 fn 值槽在
# frozen stage3 实测不可行，事件接口走「契约键解析 + 门面直调」：
#   - 契约（codegen_contract.cheng）承载事件 carrier 两类型
#     （RegallocProductionEncoderEvent{Builder,Table}，B0 生产 carrier 内嵌
#     字段的类型面收口），本门面与内核消费点零 arch import；
#   - 事件模块 regalloc_production_encoder_events.cheng 整体归 riscv64 单元
#     （蓝图 2.7：28/28 处 rv.* 重放面无中立内容混居），其 rv.* 引用在
#     单元内合法；
#   - 本门面按 unitKey 直调表键形态供内核消费点
#     （regalloc_production_artifacts）调用：零间接调用、零托管过槽，
#     字节路径与原 kernel 直调逐字节相同。
# 键面说明：事件表仅 riscv 单元供给（xlen 列即单元指纹）；调用侧既有语义
# 分支（target 族判别 / encoderEventCount>0 数据键）即派发键——消费点无
# (format,triple) 复制树可收口，故不设冗余 unitKey 参数（偏差记录见
# kernel-b3-20260825/B3_REPORT.md §2）。

import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/regalloc_production_encoder_events as encevents

@borrows
fn CodegenEncoderEventTableStrictValidate(
        table: var contract.RegallocProductionEncoderEventTable): bool =
    return encevents.RegallocProductionEncoderEventStrictValidate(table)

@borrows
fn CodegenEncoderEventTableCanonicalEmpty(
        table: var contract.RegallocProductionEncoderEventTable): bool =
    return encevents.RegallocProductionEncoderEventTableCanonicalEmpty(table)
