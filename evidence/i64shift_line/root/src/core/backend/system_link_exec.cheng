@borrows
fn SystemLinkExecAddDebugRuntimeRootIfNeeded(linkPlan: var slplan.SystemLinkPlanStub,
                                              primaryPlan: var pobj.PrimaryObjectPlan,
                                              out: var str[],
                                              rawSymbol: str) =
    if SystemLinkExecPrimaryRelocNeedsSymbol(linkPlan, primaryPlan, rawSymbol):
        SystemLinkExecAddUniqueText(out, rawSymbol)

@borrows
fn SystemLinkExecDebugRuntimeExportRoots(linkPlan: var slplan.SystemLinkPlanStub,
                                          primaryPlan: var pobj.PrimaryObjectPlan): str[] =
    var out: str[]
    # The exe entry bridge always calls the line-map registration and the
    # profile flush; those relocs are synthesized at object emit, after this
    # plan-level reloc scan, so account for them here.
    if linkPlan.emitKind == creq.EmitExe && len(primaryPlan.entryFunctionSymbol) > 0:
        SystemLinkExecAddUniqueText(out, "cheng_native_register_line_map_from_argv0")
        SystemLinkExecAddUniqueText(out, "cheng_debug_profile_flush_from_argv0")
    SystemLinkExecAddDebugRuntimeRootIfNeeded(linkPlan, primaryPlan, out, "cheng_native_register_line_map_from_argv0")
    SystemLinkExecAddDebugRuntimeRootIfNeeded(linkPlan, primaryPlan, out, "cheng_native_dump_backtrace_and_exit")
    SystemLinkExecAddDebugRuntimeRootIfNeeded(linkPlan, primaryPlan, out, "cheng_dump_backtrace_if_enabled")
    SystemLinkExecAddDebugRuntimeRootIfNeeded(linkPlan, primaryPlan, out, "cheng_force_segv")
    SystemLinkExecAddDebugRuntimeRootIfNeeded(linkPlan, primaryPlan, out, "cheng_crash_trace_enabled")
    SystemLinkExecAddDebugRuntimeRootIfNeeded(linkPlan, primaryPlan, out, "cheng_crash_trace_set_phase")
    SystemLinkExecAddDebugRuntimeRootIfNeeded(linkPlan, primaryPlan, out, "cheng_crash_trace_mark")
    SystemLinkExecAddDebugRuntimeRootIfNeeded(linkPlan, primaryPlan, out, "cheng_debug_profile_flush_from_argv0")
    return out

@borrows
fn SystemLinkExecProviderModuleActive(linkPlan: var slplan.SystemLinkPlanStub,
                                       primaryPlan: var pobj.PrimaryObjectPlan,
                                       providerModule: str): bool =
    if providerModule == "runtime/compiler_runtime":
        # The source entry is emitted under an internal symbol and the primary
        # owns only cheng_{program,tooling}_argv_entry. Native `main` is always
        # supplied by exactly one compiler-runtime provider so process-entry
        # runtime priming cannot be bypassed.
        return true
    if providerModule == "runtime/core_runtime":
        # Always active when the exe runtime set links: program_support,
        # host-runtime and debug provider sources reference core_runtime
        # bridges unconditionally; that demand is invisible to the primary
        # reloc scan. The evidence call is retained (dropping it breaks the
        # stage3 bake: template_row=27 TypeNode producer rejected) but its
        # result no longer gates activation.
        let roots = SystemLinkExecCoreRuntimeExportRoots(linkPlan, primaryPlan)
        return roots.len > 0 || true
    if providerModule == "runtime/debug_runtime":
        let roots = SystemLinkExecDebugRuntimeExportRoots(linkPlan, primaryPlan)
        return roots.len > 0
    return true

@borrows
fn SystemLinkExecLockCompilerProofCid(lock: cworld.CompilerLockSnapshot): layout.FixedBytes32 =
    for i in 0..<lock.entries.len:
        if lock.entries[i].packageId == "cheng/compiler":
            return lock.entries[i].migrationProofCid
    return layout.FixedBytes32()

@borrows
fn SystemLinkExecBuiltinPackage(packageId: str): bool =
    if packageId == "cheng/compiler":
        return true
    if packageId == "cheng/std":
        return true
    return packageId == "cheng/runtime"

@borrows
fn SystemLinkExecCloneLockSnapshot(
        lock: cworld.CompilerLockSnapshot): cworld.CompilerLockSnapshot =
    var out: cworld.CompilerLockSnapshot
    out.channel = strings.CloneStr(lock.channel)
    out.worldHeadCid = lock.worldHeadCid
    out.manifestRootCid = lock.manifestRootCid
    out.compilerPkgCid = lock.compilerPkgCid
    out.stdPkgCid = lock.stdPkgCid
    out.runtimePkgCid = lock.runtimePkgCid
    out.managedDependencyReceiptCid = lock.managedDependencyReceiptCid
    out.entryCount = lock.entryCount
    var entries: cworld.CompilerUniverseManifestEntry[]
    for i in 0..<lock.entries.len:
        var entry: cworld.CompilerUniverseManifestEntry
        entry.packageId = strings.CloneStr(lock.entries[i].packageId)
        entry.snapshotCid = lock.entries[i].snapshotCid
        entry.syntaxSurfaceCid = lock.entries[i].syntaxSurfaceCid
        entry.migrationProofCid = lock.entries[i].migrationProofCid
        entry.managedMirrorBundleCid = lock.entries[i].managedMirrorBundleCid
        add(entries, entry)
    out.entries = entries
    out.lockPath = strings.CloneStr(lock.lockPath)
    return out

@borrows
fn SystemLinkExecExtraManifestEntries(lock: cworld.CompilerLockSnapshot): cworld.CompilerUniverseManifestEntry[] =
    var out: cworld.CompilerUniverseManifestEntry[]
    for i in 0..<lock.entries.len:
        if lock.entries[i].packageId == "cheng/std" ||
           lock.entries[i].packageId == "cheng/runtime":
            continue
        var entry: cworld.CompilerUniverseManifestEntry
        entry.packageId = strings.CloneStr(lock.entries[i].packageId)
        entry.snapshotCid = lock.entries[i].snapshotCid
        entry.syntaxSurfaceCid = lock.entries[i].syntaxSurfaceCid
        entry.migrationProofCid = lock.entries[i].migrationProofCid
        entry.managedMirrorBundleCid = lock.entries[i].managedMirrorBundleCid
        add(out, entry)
    return out

@borrows
fn SystemLinkExecManagedMirrorRootVerifiedInto(
        rootDir: str,
        channel: str,
        entry: cworld.CompilerUniverseManifestEntry,
        outRoot: var parser.ParserExternalPackageRoot,
        outHandle: var os.AtomicTree,
        outErr: var str): bool =
    outRoot = parser.ParserExternalPackageRoot()
    outHandle = os.AtomicTree(0)
    let mirrorRoot = cworld.CompilerManagedMirrorRoot(
        rootDir,
        channel,
        entry.packageId,
        entry.managedMirrorBundleCid)
    let parentPath = chengpath.PathParentDir(mirrorRoot)
    let finalName = layout.FixedBytes32Hex(entry.managedMirrorBundleCid)
    let openRes = os.AtomicTreeOpenVerified(parentPath, finalName)
    if IsErr(openRes):
        outErr = strutil.Join([
            " system link exec: managed mirror root missing or unverified package=",
            strings.CloneStr(entry.packageId),
            " bundle_cid=",
            strings.CloneStr(finalName),
            ": ",
            Error(openRes)
        ], "")
        return false
    let handle = Value(openRes)
    var verifyErr = ""
    var committedTree: cworld.CompilerManagedMirrorCommit
    let committedTreeRes =
        cworld.CompilerManagedMirrorCommittedTreeVerifyInto(
            handle,
            entry.managedMirrorBundleCid,
            committedTree)
    if IsErr(committedTreeRes):
        verifyErr = Error(committedTreeRes)
    var bundleText = ""
    if verifyErr == "":
        let bundleRes = os.AtomicTreeReadStable(handle, "bundle.txt")
        if IsErr(bundleRes):
            verifyErr = Error(bundleRes)
        else:
            var bundleBytes = Value(bundleRes)
            bundleText = rawbytes.BytesToString(bundleBytes)
            rawbytes.BytesFree(bundleBytes)
    var mirrorBundle: cworld.CompilerManagedMirrorBundleWire
    if verifyErr == "":
        let bundleRes =
            cworld.CompilerManagedMirrorBundleWireFromReportText(
                bundleText,
                mirrorBundle)
        if IsErr(bundleRes):
            verifyErr = Error(bundleRes)
    if verifyErr == "" &&
       (mirrorBundle.channel != channel ||
        mirrorBundle.packageId != entry.packageId ||
        !layout.FixedBytes32Equal(
            mirrorBundle.migrationProofCid,
            entry.migrationProofCid) ||
        !layout.FixedBytes32Equal(
            mirrorBundle.bundleCid,
            entry.managedMirrorBundleCid)):
        verifyErr = " system link exec: managed mirror root identity mismatch"
    var sourcePaths: str[]
    var sourceTexts: str[]
    if verifyErr == "":
        var committedSourceCount: int32
        for fileIndex in 0..<committedTree.files.len:
            if chengpath.TextStartsWith(
                    committedTree.files[fileIndex].relativePath,
                    "src/"):
                committedSourceCount = committedSourceCount + 1
        if committedSourceCount != mirrorBundle.unitCount:
            verifyErr =
                " system link exec: managed mirror source manifest count mismatch"
    if verifyErr == "":
        for unitIndex in 0..<mirrorBundle.units.len:
            var relativePath: str
            let relativePathRes =
                cworld.CompilerManagedMirrorSourceRelativePath(
                    mirrorBundle.packageId,
                    mirrorBundle.units[unitIndex].modulePath,
                    relativePath)
            if IsErr(relativePathRes):
                verifyErr = Error(relativePathRes)
                break
            var committedFileIndex: int32 = -1
            for fileIndex in 0..<committedTree.files.len:
                if committedTree.files[fileIndex].relativePath !=
                       relativePath:
                    continue
                committedFileIndex = fileIndex
                break
            if committedFileIndex < 0:
                verifyErr = strutil.Join([
                    " system link exec: managed mirror source missing: ",
                    strings.CloneStr(relativePath)
                ], "")
                break
            let readRes = os.AtomicTreeReadStable(handle, relativePath)
            if IsErr(readRes):
                verifyErr = Error(readRes)
                break
            var sourceBytes = Value(readRes)
            let sourceCid =
                cworld.CompilerWorldSourceRawBytesCidFromBytes(sourceBytes)
            let sourceText = cworld.CompilerWorldOwnText(
                rawbytes.BytesToString(sourceBytes))
            let sourceLength = rawbytes.BytesLen(sourceBytes)
            rawbytes.BytesFree(sourceBytes)
            if sourceLength !=
                   committedTree.files[committedFileIndex].rawByteLength ||
               !layout.FixedBytes32Equal(
                    sourceCid,
                    committedTree.files[committedFileIndex].contentCid) ||
               sourceLength !=
                   mirrorBundle.units[unitIndex].migratedSourceRawByteLength ||
               !layout.FixedBytes32Equal(
                    sourceCid,
                    mirrorBundle.units[unitIndex].migratedSourceCid) ||
               sourceText !=
                   mirrorBundle.units[unitIndex].migratedSourceText:
                verifyErr = strutil.Join([
                    " system link exec: mirror source/manifest mismatch: ",
                    strings.CloneStr(relativePath)
                ], "")
                break
            let sourcePath = chengpath.PathJoin(mirrorRoot,
                                                 relativePath)
            var insertAt = sourcePaths.len
            while insertAt > 0 &&
                  SystemLinkExecSemanticTextLess(
                      sourcePath,
                      sourcePaths[insertAt - 1]):
                insertAt = insertAt - 1
            add(sourcePaths, strings.CloneStr(sourcePath))
            add(sourceTexts, strings.CloneStr(sourceText))
            var moveIndex = sourcePaths.len - 1
            while moveIndex > insertAt:
                sourcePaths[moveIndex] = sourcePaths[moveIndex - 1]
                sourceTexts[moveIndex] = sourceTexts[moveIndex - 1]
                moveIndex = moveIndex - 1
            sourcePaths[insertAt] = strings.CloneStr(sourcePath)
            sourceTexts[insertAt] = strings.CloneStr(sourceText)
    if verifyErr == "" && sourcePaths.len <= 0:
        verifyErr = " system link exec: verified mirror source snapshot empty"
    if verifyErr != "":
        let closeRes = os.AtomicTreeClose(handle)
        if IsErr(closeRes):
            verifyErr = strutil.Join([
                strings.CloneStr(verifyErr),
                "; verified mirror close failed: ",
                Error(closeRes)
            ], "")
        outErr = strutil.Join([
            strings.CloneStr(verifyErr),
            " package=",
            strings.CloneStr(entry.packageId),
            " bundle_cid=",
            strings.CloneStr(finalName)
        ], "")
        return false
    outRoot = parser.ParserExternalPackageRootCertifiedSnapshotNew(
        entry.packageId,
        entry.packageId,
        mirrorRoot,
        sourcePaths,
        sourceTexts)
    outHandle = handle
    outErr = ""
    return true

fn SystemLinkExecManagedMirrorHandlesCloseInto(
        handles: var os.AtomicTree[],
        outErr: var str): bool =
    var closeErr = ""
    for handleIndex in 0..<handles.len:
        let closeRes = os.AtomicTreeClose(handles[handleIndex])
        if IsErr(closeRes) && closeErr == "":
            closeErr = Error(closeRes)
    handles = []
    if closeErr != "":
        outErr = strutil.Join([
            " system link exec: verified mirror close failed: ",
            closeErr
        ], "")
        return false
    outErr = ""
    return true

@borrows
fn SystemLinkExecExternalPackageRootsInto(
        rootDir: str,
        lock: cworld.CompilerLockSnapshot,
        out: var parser.ParserExternalPackageRoot[],
        outHandles: var os.AtomicTree[],
        outErr: var str): bool =
    out = []
    outHandles = []
    var lockOwned = SystemLinkExecCloneLockSnapshot(lock)
    if !cworld.CompilerLockSnapshotStrictValidateInto(lockOwned, outErr):
        return false
    let zeroCid = layout.FixedBytes32()
    for i in 0..<lock.entries.len:
        let entry = lock.entries[i]
        if SystemLinkExecBuiltinPackage(entry.packageId):
            continue
        let proofMissing = layout.FixedBytes32Equal(
            entry.migrationProofCid,
            zeroCid)
        let mirrorMissing = layout.FixedBytes32Equal(
            entry.managedMirrorBundleCid,
            zeroCid)
        if proofMissing && mirrorMissing:
            continue
        if proofMissing != mirrorMissing:
            outErr = strutil.Join([
                " system link exec: managed mirror proof/bundle pair incomplete package=",
                strings.CloneStr(entry.packageId)
            ], "")
            var closeErr: str
            if !SystemLinkExecManagedMirrorHandlesCloseInto(
                    outHandles,
                    closeErr):
                outErr = strutil.Join([strings.CloneStr(outErr), "; ", closeErr], "")
            return false
        var mirrorRoot: parser.ParserExternalPackageRoot
        var mirrorHandle: os.AtomicTree
        if !SystemLinkExecManagedMirrorRootVerifiedInto(
                rootDir,
                lock.channel,
                entry,
                mirrorRoot,
                mirrorHandle,
                outErr):
            var closeErr: str
            if !SystemLinkExecManagedMirrorHandlesCloseInto(
                    outHandles,
                    closeErr):
                outErr = strutil.Join([strings.CloneStr(outErr), "; ", closeErr], "")
            return false
        add(out, mirrorRoot)
        add(outHandles, mirrorHandle)
    outErr = ""
    return true

@borrows
fn SystemLinkExecOptionalFlagPresent(value: str): bool =
    if value == "__cheng_missing_optional_flag__":
        return false
    if value == "":
        return false
    return true

@borrows
fn SystemLinkExecOptionalFlagValue(value: str): str =
    if value == "__cheng_missing_optional_flag__":
        return ""
    return strings.CloneStr(value)

@borrows
fn SystemLinkExecExactFunctionCoverageFromCompilerCsgInto(rootDir: str,
                                                           req: creq.CompilerRequest,
                                                           compilerCsg: var ccsg.CompilerCsg,
                                                           outCoverage: var SystemLinkExecExactFunctionCoverage,
                                                           outErr: var str): bool =
    outCoverage = SystemLinkExecExactFunctionCoverage()
    outCoverage.functionIndex = -1
    let selectorSourceRaw = creq.CompilerRequestExactFunctionSourcePath(req)
    let selectorNameRaw = creq.CompilerRequestExactFunctionName(req)
    let selectorDriverRaw = creq.CompilerRequestExactFunctionDriverPath(req)
    var selectorFieldCount: int32
    if len(selectorSourceRaw) > 0:
        selectorFieldCount = selectorFieldCount + 1
    if len(selectorNameRaw) > 0:
        selectorFieldCount = selectorFieldCount + 1
    if len(selectorDriverRaw) > 0:
        selectorFieldCount = selectorFieldCount + 1
    if selectorFieldCount <= 0:
        outErr = ""
        return true
    if selectorFieldCount != 3:
        outErr = "system link exec: incomplete exact-function selector"
        return false
    if len(req.reportPath) <= 0:
        outErr = "system link exec: exact-function selector requires --report-out"
        return false
    let entrySourcePath = creq.CompilerExactFunctionNormalizePath(rootDir,
                                                                  req.sourcePath)
    let targetSourcePath = creq.CompilerExactFunctionNormalizePath(rootDir,
                                                                   selectorSourceRaw)
    let driverPath = creq.CompilerExactFunctionNormalizePath(rootDir,
                                                              selectorDriverRaw)
    let functionName = creq.CompilerExactFunctionNormalizeName(selectorNameRaw)
    let targetTriple = creq.CompilerExactFunctionNormalizeName(req.targetTriple)
    let outputPath = creq.CompilerExactFunctionNormalizePath(rootDir,
                                                              req.outputPath)
    if len(entrySourcePath) <= 0 ||
       len(targetSourcePath) <= 0 ||
       len(driverPath) <= 0 ||
       len(functionName) <= 0 ||
       len(targetTriple) <= 0 ||
       targetTriple != req.targetTriple ||
       len(outputPath) <= 0:
        outErr = "system link exec: exact-function selector normalization failed"
        return false
    outCoverage.requested = true
    outCoverage.entrySourcePath = entrySourcePath
    outCoverage.targetSourcePath = targetSourcePath
    outCoverage.targetTriple = targetTriple
    outCoverage.driverPath = driverPath
    outCoverage.functionName = functionName
    outCoverage.outputKind = creq.CompilerEmitText(req.emitKind)
    outCoverage.outputPath = outputPath
    let typedIrFunctionCount = compilerCsg.typedIr.functions2_functionNameIds.len
    if compilerCsg.typedIr.functions2_sourcePathIds.len != typedIrFunctionCount ||
       compilerCsg.typedIr.functions2_signatureLineNumbers.len != typedIrFunctionCount ||
       compilerCsg.typedIr.functions2_statementCounts.len != typedIrFunctionCount ||
       compilerCsg.typedIr.functions2_nodeStarts.len != typedIrFunctionCount ||
       compilerCsg.typedIr.functions2_nodeCounts.len != typedIrFunctionCount:
        outErr = "system link exec: exact-function typed-ir function columns are inconsistent"
        return false
    var matchedFunctionIndex: int32 = -1
    for functionIndex in 0..<typedIrFunctionCount:
        let rowNameRes = langintern.LookupIntern(compilerCsg.typedIr.internPool,
                                                 compilerCsg.typedIr.functions2_functionNameIds[functionIndex])
        if IsErr(rowNameRes):
            outErr = "system link exec: exact-function function-name intern lookup failed"
            return false
        if creq.CompilerExactFunctionNormalizeName(Value(rowNameRes)) != functionName:
            continue
        let rowSourceRes = langintern.LookupIntern(compilerCsg.typedIr.internPool,
                                                   compilerCsg.typedIr.functions2_sourcePathIds[functionIndex])
        if IsErr(rowSourceRes):
            outErr = "system link exec: exact-function source-path intern lookup failed"
            return false
        let rowSourcePath = creq.CompilerExactFunctionNormalizePath(rootDir,
                                                                    Value(rowSourceRes))
        if rowSourcePath != targetSourcePath:
            continue
        outCoverage.functionMatchCount = outCoverage.functionMatchCount + 1
        matchedFunctionIndex = functionIndex
    if outCoverage.functionMatchCount != 1:
        outErr = Fmt"system link exec: exact-function selector must match exactly one row source={targetSourcePath} function={functionName} matches={outCoverage.functionMatchCount}"
        return false
    let totalNodeCount = compilerCsg.typedIr.nodes2_nodeIndexs.len
    if compilerCsg.typedIr.nodes2_sourcePathIds.len != totalNodeCount ||
       compilerCsg.typedIr.nodes2_functionNameIds.len != totalNodeCount:
        outErr = "system link exec: exact-function typed-ir node owner columns are inconsistent"
        return false
    let nodeStart = arenamod.ArenaArrayInt32Get(compilerCsg.typedIr.arena,
                                                compilerCsg.typedIr.functions2_nodeStarts,
                                                matchedFunctionIndex)
    let nodeCount = arenamod.ArenaArrayInt32Get(compilerCsg.typedIr.arena,
                                                compilerCsg.typedIr.functions2_nodeCounts,
                                                matchedFunctionIndex)
    if nodeStart < 0 || nodeCount < 0 ||
       nodeStart > totalNodeCount ||
       nodeCount > totalNodeCount - nodeStart:
        outErr = "system link exec: exact-function node span is out of bounds"
        return false
    let ownerFunctionNameId = compilerCsg.typedIr.functions2_functionNameIds[matchedFunctionIndex]
    let nodeEnd = nodeStart + nodeCount
    for nodeIndex in 0..<totalNodeCount:
        if compilerCsg.typedIr.nodes2_functionNameIds[nodeIndex] != ownerFunctionNameId:
            continue
        let nodeSourceRes = langintern.LookupIntern(compilerCsg.typedIr.internPool,
                                                    compilerCsg.typedIr.nodes2_sourcePathIds[nodeIndex])
        if IsErr(nodeSourceRes):
            outErr = "system link exec: exact-function node source-path intern lookup failed"
            return false
        let nodeSourcePath = creq.CompilerExactFunctionNormalizePath(rootDir,
                                                                     Value(nodeSourceRes))
        if nodeSourcePath != targetSourcePath:
            continue
        if nodeIndex >= nodeStart && nodeIndex < nodeEnd:
            outCoverage.spanOwnedCount = outCoverage.spanOwnedCount + 1
        else:
            outCoverage.outsideSpanOwnedCount = outCoverage.outsideSpanOwnedCount + 1
    if outCoverage.spanOwnedCount != nodeCount ||
       outCoverage.outsideSpanOwnedCount != 0:
        outErr = Fmt"system link exec: exact-function node ownership mismatch span={nodeCount} owned={outCoverage.spanOwnedCount} outside={outCoverage.outsideSpanOwnedCount}"
        return false
    outCoverage.functionIndex = matchedFunctionIndex
    outCoverage.signatureLine = arenamod.ArenaArrayInt32Get(compilerCsg.typedIr.arena,
                                                             compilerCsg.typedIr.functions2_signatureLineNumbers,
                                                             matchedFunctionIndex)
    outCoverage.statementCount = arenamod.ArenaArrayInt32Get(compilerCsg.typedIr.arena,
                                                              compilerCsg.typedIr.functions2_statementCounts,
                                                              matchedFunctionIndex)
    outCoverage.nodeStart = nodeStart
    outCoverage.nodeCount = nodeCount
    outCoverage.totalNodeCount = totalNodeCount
    outErr = ""
    return true

fn SystemLinkExecAbortPrimaryObjectPlanIfNeeded(
        plan: var pobj.PrimaryObjectPlan,
        needsRelease: var bool) =
    if !needsRelease:
        return
    var receipt: pobj.PrimaryObjectPlanReleaseReceipt
    pobj.PrimaryObjectPlanReleaseWithReceipt(plan, receipt)
    var releaseErr = ""
    if !pobj.PrimaryObjectPlanReleaseReceiptConsumeStrictInto(
           plan, receipt, releaseErr):
        panic(releaseErr)
    needsRelease = false

fn SystemLinkExecAbortLoweringPlanIfNeeded(
        plan: var lower.LoweringPlanStub,
        needsRelease: var bool,
        lifecycle: var compilerlife.CompilerPayloadLifecycle) =
    if !needsRelease:
        return
    var receipt: lower.LoweringPlanReleaseReceipt
    lower.LoweringPlanReleaseWithReceipt(plan, receipt)
    var releaseErr: str
    if !lower.LoweringPlanReleaseReceiptConsumeStrictInto(
           plan, receipt, releaseErr):
        panic(releaseErr)
    if lifecycle.active:
        var lifecycleReceipt: compilerlife.CompilerPayloadLifecycleReceipt
        lowerlife.LoweringPayloadLifecycleEndWithReleaseReceipt(
            lifecycle,
            receipt,
            compilerlife.CompilerPayloadOutcomeEarlyReturn,
            lifecycleReceipt)
    needsRelease = false

fn SystemLinkExecAbortCompilerCsgIfNeeded(
        compilerCsg: var ccsg.CompilerCsg,
        needsAbortRelease: var bool,
        productionLifetime: var csglife.CompilerCsgProductionLifetime,
        loweringPlan: var lower.LoweringPlanStub) =
    if needsAbortRelease:
        if productionLifetime.active:
            csglife.CompilerCsgProductionLifetimeEndUnmoved(
                compilerCsg,
                productionLifetime,
                compilerlife.CompilerPayloadOutcomeEarlyReturn)
        needsAbortRelease = false
    elif productionLifetime.active:
        if productionLifetime.lifecycle.movedToConsumer:
            csglife.CompilerCsgProductionLifetimeEndFromLowering(
                compilerCsg,
                loweringPlan,
                productionLifetime,
                compilerlife.CompilerPayloadOutcomeEarlyReturn)
        else:
            csglife.CompilerCsgProductionLifetimeEndUnmoved(
                compilerCsg,
                productionLifetime,
                compilerlife.CompilerPayloadOutcomeEarlyReturn)

fn SystemLinkExecExactFunctionCapturePrimaryInto(coverage: var SystemLinkExecExactFunctionCoverage,
                                                  primaryPlan: var pobj.PrimaryObjectPlan,
                                                  outErr: var str): bool =
    if !coverage.requested:
        outErr = ""
        return true
    coverage.primaryMatchCount = primaryPlan.exactFunctionPrimaryMatchCount
    coverage.bodyIrCapturedBeforeRelease = primaryPlan.exactFunctionBodyIrCapturedBeforeRelease
    coverage.bodyIrOpCount = primaryPlan.exactFunctionBodyIrOpCount
    coverage.bodyIrTermCount = primaryPlan.exactFunctionBodyIrTermCount
    coverage.bodyIrBlockCount = primaryPlan.exactFunctionBodyIrBlockCount
    coverage.bodyIrLocalSlotCount = primaryPlan.exactFunctionBodyIrLocalSlotCount
    if coverage.primaryMatchCount != 1:
        outErr = Fmt"system link exec: exact-function primary match must be unique typed_index={coverage.functionIndex} matches={coverage.primaryMatchCount}"
        return false
    if !coverage.bodyIrCapturedBeforeRelease:
        outErr = Fmt"system link exec: exact-function BodyIR was not captured before release typed_index={coverage.functionIndex}"
        return false
    outErr = ""
    return true

@borrows
fn SystemLinkExecManagedDependencyReceiptProjection(
        source: slplan.SystemLinkPlanManagedDependencyReceipt): slplan.SystemLinkPlanManagedDependencyReceipt =
    var out: slplan.SystemLinkPlanManagedDependencyReceipt
    out.channel = strings.CloneStr(source.channel)
    out.dependencyCount = source.dependencyCount
    for index in 0..<source.entries.len:
        var entry: slplan.SystemLinkPlanManagedDependencyReceiptEntry
        entry.canonicalPackageId = strings.CloneStr(
            source.entries[index].canonicalPackageId)
        entry.snapshotCid = source.entries[index].snapshotCid
        entry.syntaxSurfaceCid = source.entries[index].syntaxSurfaceCid
        entry.migrationProofCid = source.entries[index].migrationProofCid
        entry.priorManagedMirrorBundleCid =
            source.entries[index].priorManagedMirrorBundleCid
        add(out.entries, entry)
    out.receiptCid = source.receiptCid
    return out

@borrows
fn SystemLinkExecObserveIdentityText(
        text: str,
        out: var layout.FixedBytes32,
        err: var str): bool =
    let observedRes = execution.CompilerExecutionIdentityObservedRaw32(
        rawbytes.BytesFromString(text))
    if IsErr(observedRes):
        err = Error(observedRes)
        return false
    out = Value(observedRes)
    err = ""
    return true

@borrows
fn SystemLinkExecCompilerExecutionIdentityFromRequestInto(
        req: creq.CompilerRequest,
        sourceBundleCid: layout.FixedBytes32,
        sourceBundleReceipt: SystemLinkExecSourceBundleReceipt,
        out: var execution.CompilerExecutionIdentity,
        err: var str): bool =
    if !creq.CompilerRequestStrictValidateSealed(req):
        err = "system link exec: compiler request is not sealed"
        return false
    if !layout.FixedBytes32Equal(
           sourceBundleCid, sourceBundleReceipt.sourceBundleCid):
        err = "system link exec: compiler execution identity source bundle mismatch"
        return false
    var grammarRaw32: layout.FixedBytes32
    var driverRaw32: layout.FixedBytes32
    var toolchainRaw32: layout.FixedBytes32
    let ownedTarget = strings.CloneStr(req.targetTriple)
    let grammarText = Fmt"cheng.compiler.request.grammar\n{strings.CloneStr(ownedTarget)}\n{strings.CloneStr(req.symbolVisibility)}\n{strings.CloneStr(req.compileMode)}"
    if !SystemLinkExecObserveIdentityText(grammarText, grammarRaw32, err):
        return false
    let driverText = Fmt"cheng.compiler.request.driver\n{cmdline.ParamStr(0)}"
    if !SystemLinkExecObserveIdentityText(driverText, driverRaw32, err):
        return false
    let toolchainText = Fmt"cheng.compiler.request.toolchain\n{strings.CloneStr(ownedTarget)}\n{int32(req.emitKind)}\n{req.jobCount}"
    if !SystemLinkExecObserveIdentityText(toolchainText, toolchainRaw32, err):
        return false
    let caseId = layout.FixedBytes32Hex(req.backendRequestCid)
    let identityRes = execution.CompilerExecutionIdentityMake(
        caseId,
        layout.FixedBytes32Copy(sourceBundleCid),
        layout.FixedBytes32Copy(req.backendRequestActionCid),
        grammarRaw32,
        layout.FixedBytes32Copy(sourceBundleReceipt.importGraphCid),
        driverRaw32,
        toolchainRaw32,
        layout.FixedBytes32Copy(req.backendRequestCid),
        strings.CloneStr(ownedTarget))
    if IsErr(identityRes):
        err = Error(identityRes)
        return false
    out = Value(identityRes)
    err = ""
    return true

@borrows
fn BuildSystemLinkExecPlanWithWorldAndChannelInto(rootDir: str,
                                                  req: creq.CompilerRequest,
                                                  requestedWorldHead: str,
                                                  lockPath: str,
                                                  baselineSurfacePath: str,
                                                  channelRaw: str,
                                                  outPlan: var SystemLinkExecPlan,
                                                  outErr: var str): bool =
    if !creq.CompilerRequestStrictValidateSealed(req):
        outErr = "system link exec: compiler request is not sealed"
        return false
    var productionAdmissionReceipt: production_launcher.CsgCoreProductionSystemLinkExecAdmissionReceipt
    SystemLinkExecEnsureDefaultResourceGuard()
    # Compilation boundary (memory line w49): observe the process baseline
    # once, and drop every same-compilation merkle decode memo row from any
    # previous compilation.  Cross-compilation memo reuse is forbidden.
    SystemLinkExecProcessBaselineRssObserve()
    merkle_store_codec.CsgCoreMerkleStoreDecodeMemoResetForNewCompilation()
    # [phaseC-w5] Same compilation boundary for the merkle fact memo: fact
    # rows are single-compilation only, same discipline as the decode memo.
    merkle_dag.CsgCoreMerkleFactMemoResetForNewCompilation()
    var phaseProfile: SystemLinkExecPhaseProfile
    let totalStartNs: int64 = SystemLinkExecNowNs()
    let progressStdErrEnabled = false
    let progressPath = ""
    if len(progressPath) > 0 && !SystemLinkExecProgressAppendEnabled():
        let _ = chengpath.WriteTextFile(rootDir, progressPath, "")
        os.SetEnv("CHENG_PROGRESS_APPEND", "1")
    var progressText = ""
    SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "plan_build", "begin", int64(-1), int64(0))
    var probePresence = false
    if SystemLinkExecRawFlagBridgeEnabled():
        probePresence = SystemLinkExecReadFlagCodeRawLenBridge(9) > 0
    var effectiveLockPath = SystemLinkExecOptionalFlagValue(lockPath)
    var effectiveWorldHead = SystemLinkExecOptionalFlagValue(requestedWorldHead)
    var effectiveBaselineSurfacePath = SystemLinkExecOptionalFlagValue(baselineSurfacePath)
    var lockCheckEnabled = SystemLinkExecOptionalFlagPresent(lockPath)
    if probePresence:
        if SystemLinkExecRawFlagBridgeEnabled():
            lockCheckEnabled = SystemLinkExecReadFlagCodeRawLenBridge(14) > 0
    var worldHeadPinned = SystemLinkExecOptionalFlagPresent(requestedWorldHead)
    if probePresence:
        if SystemLinkExecRawFlagBridgeEnabled():
            worldHeadPinned = SystemLinkExecReadFlagCodeRawLenBridge(13) > 0
    if worldHeadPinned && !lockCheckEnabled:
        SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "plan_build", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
        outErr = " compiler world: pinned --world-head requires --lock"
        return false
    var lockSnapshot: cworld.CompilerLockSnapshot
    var csgToLoweringBefore: SystemLinkExecPhaseMemorySnapshot
    var csgToLoweringAfter: SystemLinkExecPhaseMemorySnapshot
    var phaseMemoryLedger: SystemLinkExecPhaseMemoryLedger
    var primaryPlanNeedsAbortRelease = false
    var sevenStageBackend2PlanNeedsRelease = false
    var lockVerified = false
    var compilerProofCid = layout.FixedBytes32()
    var managedDependencyReceiptCid = layout.FixedBytes32()
    var extraManifestEntries: cworld.CompilerUniverseManifestEntry[]
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    var externalPackageRootHandles: os.AtomicTree[]
    let lockStartNs: int64 = SystemLinkExecNowNs()
    SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "lock", "begin", int64(-1), lockStartNs - totalStartNs)
    if lockCheckEnabled:
        let lockRes = cworld.CompilerLockSnapshotRead(rootDir, effectiveLockPath)
        if !lockRes.ok:
            SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "lock", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
            outErr = lockRes.err.msg
            return false
        lockSnapshot = lockRes.value
        compilerProofCid = SystemLinkExecLockCompilerProofCid(lockSnapshot)
        managedDependencyReceiptCid =
            lockSnapshot.managedDependencyReceiptCid
        extraManifestEntries = SystemLinkExecExtraManifestEntries(lockSnapshot)
        var externalPackageRootsErr: str
        if !SystemLinkExecExternalPackageRootsInto(
                rootDir,
                lockSnapshot,
                externalPackageRoots,
                externalPackageRootHandles,
                externalPackageRootsErr):
            SystemLinkExecProgressEmit(rootDir,
                                       progressStdErrEnabled,
                                       progressPath,
                                       progressText,
                                       "lock",
                                       "error",
                                       int64(-1),
                                       SystemLinkExecNowNs() - totalStartNs)
            outErr = externalPackageRootsErr
            return false
    phaseProfile.lockNs = SystemLinkExecNowNs() - lockStartNs
    SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "lock", "done", phaseProfile.lockNs, SystemLinkExecNowNs() - totalStartNs)
    let systemLinkPlanStartNs: int64 = SystemLinkExecNowNs()
    SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "system_link_plan", "begin", int64(-1), systemLinkPlanStartNs - totalStartNs)
    var linkPlan: slplan.SystemLinkPlanStub
    var err = ""
    let linkPlanOk = slplan.BuildSystemLinkPlanStubWithExternalPackageRoots(rootDir,
                                                                             req,
                                                                             externalPackageRoots,
                                                                             linkPlan,
                                                                             err)
    var externalPackageRootCloseErr: str
    let externalPackageRootCloseOk =
        SystemLinkExecManagedMirrorHandlesCloseInto(
            externalPackageRootHandles,
            externalPackageRootCloseErr)
    if !externalPackageRootCloseOk:
        if err == "":
            err = externalPackageRootCloseErr
        else:
            err = strutil.Join([err, "; ", externalPackageRootCloseErr], "")
    if !linkPlanOk || !externalPackageRootCloseOk:
        SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "system_link_plan", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
        outErr = err
        return false
    if lockCheckEnabled &&
       !slplan.SystemLinkPlanBindManagedDependencyReceiptFromLockInto(
           linkPlan,
           SystemLinkExecCloneLockSnapshot(lockSnapshot),
           err):
        SystemLinkExecProgressEmit(rootDir,
                                   progressStdErrEnabled,
                                   progressPath,
                                   progressText,
                                   "system_link_plan",
                                   "error",
                                   int64(-1),
                                   SystemLinkExecNowNs() - totalStartNs)
        outErr = err
        return false
    let managedDependencyReceiptProjection =
        SystemLinkExecManagedDependencyReceiptProjection(
            linkPlan.managedDependencyReceipt)
    if slplan.SystemLinkPlanManagedDependencyReceiptPresent(
            managedDependencyReceiptProjection) &&
       !slplan.SystemLinkPlanManagedDependencyReceiptVerifyInto(
            managedDependencyReceiptProjection,
            err):
        outErr = err
        return false
    var payloadLifecycle =
        SystemLinkExecPayloadLifecycleFromLinkPlan(linkPlan)
    var linkPlanCompilerInputOwned = true
    phaseProfile.systemLinkPlanNs = SystemLinkExecNowNs() - systemLinkPlanStartNs
    SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "system_link_plan", "done", phaseProfile.systemLinkPlanNs, SystemLinkExecNowNs() - totalStartNs)
    let sourceBundleStartNs: int64 = SystemLinkExecNowNs()
    SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "source_bundle", "begin", int64(-1), sourceBundleStartNs - totalStartNs)
    var sourceBundleBindingErr: str
    if !slplan.SystemLinkPlanSourceBundleBindingStructuralValidInto(
            linkPlan,
            sourceBundleBindingErr):
        SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "source_bundle", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
        outErr = sourceBundleBindingErr
        SystemLinkExecReleaseSystemLinkCompilerInputOnAbort(
            linkPlan, linkPlanCompilerInputOwned)
        return false
    var portableSourceIdentityReceipt: ccsg.PortableSourceIdentityReceipt
    if !ccsg.PortableSourceIdentityReceiptMakeInto(
            linkPlan.sourceClosurePaths.len,
            linkPlan.importEdges.len,
            linkPlan.unresolvedImportCount,
            linkPlan.packageId,
            linkPlan.ownerModulePaths[linkPlan.sourceBundleEntrySourceIndex],
            linkPlan.sourceBundleCidValue,
            linkPlan.sourceBundleEntrySourceCid,
            linkPlan.sourceBundleImportGraphCid,
            portableSourceIdentityReceipt,
            sourceBundleBindingErr):
        SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "source_bundle", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
        outErr = sourceBundleBindingErr
        SystemLinkExecReleaseSystemLinkCompilerInputOnAbort(
            linkPlan, linkPlanCompilerInputOwned)
        return false
    var sourceBundleReceipt: SystemLinkExecSourceBundleReceipt
    if !SystemLinkExecSourceBundleReceiptCaptureInto(
            linkPlan,
            portableSourceIdentityReceipt,
            sourceBundleReceipt,
            sourceBundleBindingErr):
        SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "source_bundle", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
        outErr = sourceBundleBindingErr
        SystemLinkExecReleaseSystemLinkCompilerInputOnAbort(
            linkPlan, linkPlanCompilerInputOwned)
        return false
    if creq.CompilerRequestCompositionPresent(req):
        if !composition_manifest.CompositionManifestValidateBoundPlanInto(
               rootDir,
               req,
               linkPlan,
               sourceBundleBindingErr) ||
           req.compositionSourceClosureSha256 !=
               layout.FixedBytes32Hex(
                   sourceBundleReceipt.sourceBundleCid) ||
           layout.FixedBytes32Equal(
               sourceBundleReceipt.sourceIdentityReceiptCid,
               layout.FixedBytes32()):
            if sourceBundleBindingErr.len <= 0:
                sourceBundleBindingErr =
                    "HARD_RED:composition_manifest_source_receipt_identity_drift"
            SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "source_bundle", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
            outErr = sourceBundleBindingErr
            SystemLinkExecReleaseSystemLinkCompilerInputOnAbort(
                linkPlan, linkPlanCompilerInputOwned)
            return false
    var sourceBundleCid: layout.FixedBytes32
    sourceBundleCid = sourceBundleReceipt.sourceBundleCid
    phaseProfile.sourceBundleNs = SystemLinkExecNowNs() - sourceBundleStartNs
    SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "source_bundle", "done", phaseProfile.sourceBundleNs, SystemLinkExecNowNs() - totalStartNs)
    let compilerCsgStartNs: int64 = SystemLinkExecNowNs()
    SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "compiler_csg", "begin", int64(-1), compilerCsgStartNs - totalStartNs)
    var compilerCsg: ccsg.CompilerCsg
    var compilerCsgNeedsAbortRelease = false
    var loweringPlan: lower.LoweringPlanStub
    var loweringPlanNeedsAbortRelease = false
    var loweringPayloadLifecycle: compilerlife.CompilerPayloadLifecycle
    var compilerCsgProductionLifetime: csglife.CompilerCsgProductionLifetime
    var compilerCsgOwnerResourceTrace: compilerlife.CompilerPayloadOwnerResourceTrace
    var sourceBundleOwner: slplan.SystemLinkPlanSourceBundleOwner
    var sourceBundleOwnerNeedsRelease = false
    var compilerCsgErr = ""
    var compilerCsgSourceTextOverrides: ccsg.CompilerCsgSourceText[]
    compilerCsgSourceTextOverrides = []
    defer:
        if sourceBundleOwnerNeedsRelease:
            var sourceBundleAbortReceipt: slplan.SystemLinkPlanSourceBundleReleaseReceipt
            slplan.SystemLinkPlanSourceBundleOwnerReleaseWithReceipt(
                sourceBundleOwner,
                sourceBundleAbortReceipt)
            if !slplan.SystemLinkPlanSourceBundleReleaseReceiptConsumeStrict(
                   sourceBundleOwner,
                   sourceBundleAbortReceipt):
                panic("system link exec: source bundle abort receipt mismatch")
    if !ccsg.BuildCompilerCsgConsumePortableReceiptWithSourceBundleOwnerInto(
            compilerCsg,
            compilerCsgErr,
            linkPlan,
            sourceBundleOwner,
            portableSourceIdentityReceipt,
            "",
            "",
            compilerCsgSourceTextOverrides):
        SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "compiler_csg", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
        if len(compilerCsgErr) > 0:
            outErr = compilerCsgErr
            SystemLinkExecReleaseSystemLinkCompilerInputOnAbort(
                linkPlan, linkPlanCompilerInputOwned)
            return false
        outErr = "system link exec: compiler csg build failed"
        SystemLinkExecReleaseSystemLinkCompilerInputOnAbort(
            linkPlan, linkPlanCompilerInputOwned)
        return false
    sourceBundleOwnerNeedsRelease = true
    compilerCsgNeedsAbortRelease = true
    csglife.CompilerCsgProductionLifetimeBegin(
        compilerCsg,
        compilerCsgProductionLifetime)
    let compilerCsgOwnerResourceToken =
        ccsg.CompilerCsgOwnerResourceToken(compilerCsg)
    ccsg.CompilerCsgOwnerResourceTracePointReadOnly(
        compilerCsg,
        SystemLinkExecNowNs(),
        compilerCsgOwnerResourceToken,
        int64(
            compilerCsgProductionLifetime.lifecycle.physicalBufferCount),
        compilerCsgProductionLifetime.lifecycle.byteCount,
        int64(0),
        int64(0),
        false,
        false,
        compilerCsgOwnerResourceTrace.before)
    SystemLinkExecPayloadLifecycleMarkSystemLinkExprConsumed(payloadLifecycle,
                                                             linkPlan)
    linkPlanCompilerInputOwned = false
    var exactFunctionCoverage: SystemLinkExecExactFunctionCoverage
    var exactFunctionCoverageErr = ""
    if !SystemLinkExecExactFunctionCoverageFromCompilerCsgInto(rootDir,
                                                               req,
                                                               compilerCsg,
                                                               exactFunctionCoverage,
                                                               exactFunctionCoverageErr):
        SystemLinkExecProgressEmit(rootDir,
                                   progressStdErrEnabled,
                                   progressPath,
                                   progressText,
                                   "compiler_csg",
                                   "error",
                                   int64(-1),
                                   SystemLinkExecNowNs() - totalStartNs)
        outErr = exactFunctionCoverageErr
        SystemLinkExecAbortCompilerCsgIfNeeded(
            compilerCsg,
            compilerCsgNeedsAbortRelease,
            compilerCsgProductionLifetime,
            loweringPlan)
        return false
    let compilerCsgTypedIrFunctionCount = compilerCsg.typedIr.functions2_functionNameIds.len
    let compilerCsgTypedIrNodeCount = compilerCsg.typedIr.nodes2_nodeIndexs.len
    let compilerCsgTypedIrStatementCount = compilerCsg.typedIr.statements2_statementIndexs.len
    let compilerCsgTypedExprFactCount = compilerCsg.typedExprFacts.count
    let compilerCsgExprLayerExprCount = compilerCsg.exprLayer.exprs.len
    let compilerCsgRssBytes = os.ProcessRssBytes()
    let compilerCsgLogicalPayloadBytes = compilerCsg.logicalPayloadBytes
    let compilerCsgNodesLiveBytes = compilerCsg.nodesLiveBytes
    let compilerCsgEdgesLiveBytes = compilerCsg.edgesLiveBytes
    let compilerCsgExprLayerLiveBytes = compilerCsg.exprLayerLiveBytes
    let compilerCsgTypedFactsLiveBytes = compilerCsg.typedFactsLiveBytes
    let compilerCsgTypedIrLiveBytes = compilerCsg.typedIrLiveBytes
    let compilerCsgMetadataLiveBytes = compilerCsg.metadataLiveBytes
    let compilerCsgSourceTextLiveBytes = compilerCsg.sourceTextLiveBytes
    let compilerCsgTypedIrRoundCount = compilerCsg.typedIrRoundCount
    let compilerCsgTypedIrRebuildSourceCount = compilerCsg.typedIrRebuildSourceCount
    let compilerCsgTypedIrNewFunctionCount = compilerCsg.typedIrNewFunctionCount
    var compilerCsgRssGapBytes: int64 = int64(-1)
    if compilerCsgRssBytes >= int64(0):
        compilerCsgRssGapBytes =
            compilerCsgRssBytes - compilerCsgLogicalPayloadBytes
    var compilerCsgFirstFunctionSignatureLine: int32
    var compilerCsgFirstFunctionBodyLine: int32
    var compilerCsgFirstFunctionNodeCount: int32
    var compilerCsgFirstFunctionStatementCount: int32
    var compilerCsgFirstFunctionReturnNodeIndex: int32 = -1
    var compilerCsgFirstFunctionReturnTypeCode: int32
    var compilerCsgFirstFunctionReturnExprCode: int32
    var compilerCsgFirstFunctionReturnExprLen: int32
    var compilerCsgFirstFunctionReturnExprFirstByte: int32
    var compilerCsgFirstFunctionReturnExprLastByte: int32
    phaseProfile.compilerCsgNs = SystemLinkExecNowNs() - compilerCsgStartNs
    SystemLinkExecProgressEmit(rootDir,
                               progressStdErrEnabled,
                               progressPath,
                               progressText,
                               "compiler_csg",
                               "done",
                               phaseProfile.compilerCsgNs,
                               SystemLinkExecNowNs() - totalStartNs)
    var exportSurface: ccsg.CsgExportSurface
    ccsg.CompilerExportSurfaceFromCsgInto(compilerCsg, exportSurface)
    var baselineSurfaceChecked =
        SystemLinkExecOptionalFlagPresent(baselineSurfacePath)
    var baselineSurfaceCompatible = false
    let baselineStartNs: int64 = SystemLinkExecNowNs()
    if baselineSurfaceChecked:
        let baselinePath = chengpath.PathAbsolute(rootDir, effectiveBaselineSurfacePath)
        if !chengpath.PathFileExists(baselinePath):
            SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "baseline", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
            outErr = Fmt" compiler world: missing baseline surface path: {baselinePath}"
            SystemLinkExecAbortCompilerCsgIfNeeded(
                compilerCsg,
                compilerCsgNeedsAbortRelease,
                compilerCsgProductionLifetime,
                loweringPlan)
            return false
        let baselineText = chengpath.ReadTextFile("", baselinePath)
        var baselineSurface: ccsg.CsgExportSurface
        let baselineRes = ccsg.CompilerExportSurfaceFromReportText(baselineText, baselineSurface)
        if !baselineRes.ok:
            SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "baseline", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
            outErr = baselineRes.err.msg
            return false
        if !ccsg.CompilerExportSurfaceCompatible(baselineSurface, exportSurface):
            SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "baseline", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
            outErr = " compiler world: baseline export surface incompatible"
            return false
        baselineSurfaceCompatible = true
    phaseProfile.baselineNs = SystemLinkExecNowNs() - baselineStartNs
    exportSurface.exportedSymbols = []
    exportSurface.exportedTargetNames = []
    exportSurface.exportedLayouts = []
    exportSurface.exportedEffects = []
    exportSurface.exportedCapabilities = []
    var compilerExecution: execution.CompilerExecutionIdentity
    var compilerExecutionErr: str
    var compilerExecutionOk = false
    if ssr.SevenStageReceiptEnabled():
        compilerExecutionOk =
            ssr.SevenStageCompilerExecutionIdentityCurrent(
                compilerExecution, compilerExecutionErr)
    else:
        compilerExecutionOk =
            SystemLinkExecCompilerExecutionIdentityFromRequestInto(
                req,
                sourceBundleCid,
                sourceBundleReceipt,
                compilerExecution,
                compilerExecutionErr)
    if !compilerExecutionOk:
        outErr = compilerExecutionErr
        SystemLinkExecAbortCompilerCsgIfNeeded(
            compilerCsg,
            compilerCsgNeedsAbortRelease,
            compilerCsgProductionLifetime,
            loweringPlan)
        return false
    let worldStartNs: int64 = SystemLinkExecNowNs()
    SystemLinkExecProgressEmit(rootDir,
                               progressStdErrEnabled,
                               progressPath,
                               progressText,
                               "world",
                               "begin",
                               int64(-1),
                               worldStartNs - totalStartNs)
    var localUniverse: cworld.CompilerLocalUniverse
    var universeErr: str
    if !cworld.CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(
            localUniverse,
            universeErr,
            channelRaw,
            compilerExecution.sourceBundleRaw32,
            compilerCsg.canonicalGraphCid,
            exportSurface.surfaceCid,
            compilerProofCid,
            managedDependencyReceiptCid,
            extraManifestEntries):
        SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "world", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
        outErr = universeErr
        SystemLinkExecAbortCompilerCsgIfNeeded(
            compilerCsg,
            compilerCsgNeedsAbortRelease,
            compilerCsgProductionLifetime,
            loweringPlan)
        return false
    if worldHeadPinned:
        let pinRes = cworld.CompilerWorldHeadMatchesHex(
            localUniverse.worldHead,
            effectiveWorldHead)
        if !pinRes.ok:
            SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "world", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
            outErr = pinRes.err.msg
            return false
    if lockCheckEnabled:
        let verifyLockRes = cworld.CompilerWorldVerifyLock(localUniverse,
                                                           lockSnapshot)
        if !verifyLockRes.ok:
            SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "world", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
            outErr = verifyLockRes.err.msg
            SystemLinkExecAbortCompilerCsgIfNeeded(
                compilerCsg,
                compilerCsgNeedsAbortRelease,
                compilerCsgProductionLifetime,
                loweringPlan)
            return false
        lockVerified = true
    phaseProfile.worldNs = SystemLinkExecNowNs() - worldStartNs
    SystemLinkExecProgressEmit(rootDir,
                               progressStdErrEnabled,
                               progressPath,
                               progressText,
                               "world",
                               "done",
                               phaseProfile.worldNs,
                               SystemLinkExecNowNs() - totalStartNs)
    var semanticSnapshotTables: snapshot_schema.CsgCompilerSnapshotTables
    var semanticSnapshotLoweringAuthority: snapshot_bridge.CompilerSnapshotLoweringAuthority
    if !snapshot_bridge.CompilerSnapshotForLoweringBuildLatestInto(
           linkPlan,
           compilerCsg,
           localUniverse,
           compilerExecution,
           semanticSnapshotTables,
           semanticSnapshotLoweringAuthority,
           err):
        outErr = err
        SystemLinkExecAbortCompilerCsgIfNeeded(
            compilerCsg,
            compilerCsgNeedsAbortRelease,
            compilerCsgProductionLifetime,
            loweringPlan)
        return false
    let loweringStartNs: int64 = SystemLinkExecNowNs()
    var primaryPlan: pobj.PrimaryObjectPlan
    var sevenStageBackend2Plan: pobj.PrimaryObjectPlan
    defer:
        if sevenStageBackend2PlanNeedsRelease:
            var sevenStageBackend2AbortReceipt: pobj.PrimaryObjectPlanReleaseReceipt
            pobj.PrimaryObjectPlanReleaseWithReceipt(
                sevenStageBackend2Plan,
                sevenStageBackend2AbortReceipt)
            var sevenStageBackend2AbortReleaseErr = ""
            if !pobj.PrimaryObjectPlanReleaseReceiptConsumeStrictInto(
                   sevenStageBackend2Plan,
                   sevenStageBackend2AbortReceipt,
                   sevenStageBackend2AbortReleaseErr):
                panic(sevenStageBackend2AbortReleaseErr)
    csgToLoweringBefore =
        SystemLinkExecPhaseMemorySnapshotBorrowed(
            compilerCsg, loweringPlan, primaryPlan)
    csglife.CompilerCsgProductionLifetimeBorrowForLowering(
        compilerCsg,
        compilerCsgProductionLifetime)
    let loweringPlanOk =
        lower.BuildLoweringPlanStubFromCompilerCsgBorrowedWithSourceBundleOwner(
            linkPlan,
            localUniverse,
            compilerExecution,
            sourceBundleOwner,
            semanticSnapshotTables,
            semanticSnapshotLoweringAuthority,
            compilerCsg,
            loweringPlan,
            err)
    var sourceBundleReleaseReceipt: slplan.SystemLinkPlanSourceBundleReleaseReceipt
    slplan.SystemLinkPlanSourceBundleOwnerReleaseWithReceipt(
        sourceBundleOwner,
        sourceBundleReleaseReceipt)
    if !slplan.SystemLinkPlanSourceBundleReleaseReceiptConsumeStrict(
           sourceBundleOwner,
           sourceBundleReleaseReceipt):
        panic("system link exec: source bundle release receipt mismatch")
    sourceBundleOwnerNeedsRelease = false
    csglife.CompilerCsgProductionLifetimeReturnFromLowering(
        compilerCsgProductionLifetime)
    snapshot_bridge.CompilerSnapshotForLoweringRelease(
        semanticSnapshotTables)
    if !loweringPlanOk:
        # The lowering abort path owns the sole backend-input release.
        compilerCsgNeedsAbortRelease = false
        csglife.CompilerCsgProductionLifetimeEndFromLowering(
            compilerCsg,
            loweringPlan,
            compilerCsgProductionLifetime,
            compilerlife.CompilerPayloadOutcomeDiagnostic)
        SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "lowering_plan", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
        outErr = err
        SystemLinkExecAbortCompilerCsgIfNeeded(
            compilerCsg,
            compilerCsgNeedsAbortRelease,
            compilerCsgProductionLifetime,
            loweringPlan)
        return false
    # A successful lowering bind has already performed the same unique release.
    compilerCsgNeedsAbortRelease = false
    loweringPlanNeedsAbortRelease = true
    # lifecycle 释放账本两端同锚于本点（lowering bind 完成点）：外层
    # loweringPayloadLifecycle 与 plan 侧 release tracking 同步 Begin，
    # initial 相同；之后 PrePrimary / ReplayLazyIrReleases / AfterPrimary /
    # terminal 四处 LoweringPlanLifecycleReleaseTrackingRecord 链式记
    # 释放增量，终态 receipt.initial==released==lifecycle 账才成立。
    # （旧版把外层 Begin 放这里却不启 plan 侧 tracking，terminal lazy
    # begin 只能记到全零，receipt(0,0) 与本锚必 mismatch。）
    compilerlife.CompilerPayloadLifecycleBegin(
        loweringPayloadLifecycle,
        compilerlife.CompilerPayloadKindLowering,
        lower.LoweringPlanLifecycleTrackedRetainedBytes(
            loweringPlan),
        lower.LoweringPlanLifecycleTrackedPhysicalBufferCount(
            loweringPlan))
    lower.LoweringPlanLifecycleReleaseTrackingBegin(loweringPlan)
    csglife.CompilerCsgProductionLifetimeCommitLoweringMove(
        compilerCsg,
        compilerCsgProductionLifetime)
    SystemLinkExecPayloadLifecycleMarkCompilerCsgBackendReleased(payloadLifecycle,
                                                                  loweringPlan)
    phaseProfile.loweringPlanNs = SystemLinkExecNowNs() - loweringStartNs
    csgToLoweringAfter =
        SystemLinkExecPhaseMemorySnapshotBorrowed(
            compilerCsg, loweringPlan, primaryPlan)
    if csgToLoweringAfter.compilerCsgRetainedCapacityBytes > csgToLoweringBefore.compilerCsgRetainedCapacityBytes:
        panic("system link exec: CompilerCSG retained capacity increased across backend release")
    phaseMemoryLedger.csgToLoweringAndBackendRelease =
        SystemLinkExecPhaseMemoryDeltaBorrowed(csgToLoweringBefore,
                                               csgToLoweringAfter,
                                               compilerCsg,
                                               loweringPlan,
                                               primaryPlan)
    SystemLinkExecPhaseMemoryLedgerEmit(rootDir,
                                        progressStdErrEnabled,
                                        progressPath,
                                        "csg_to_lowering_and_backend_release",
                                        phaseMemoryLedger.csgToLoweringAndBackendRelease)
    var typedIrContractOk = true
    var typedIrContractDetailCode: int32
    var typedIrContractReason = ""
    var contractFnIndex: int32
    var contractFunctionCount: int32
    contractFunctionCount = loweringPlan.primaryObjectIr.functions.len
    while contractFnIndex < contractFunctionCount:
        let contractFn = loweringPlan.primaryObjectIr.functions[contractFnIndex]
        contractFnIndex = contractFnIndex + 1
        if len(contractFn.bodyKind) <= 0:
            continue
        let typedFnIndex = contractFn.typedFunctionIndex
        if typedFnIndex < 0:
            continue
        if typedFnIndex >= loweringPlan.typedIr.functions2_functionNameIds.len:
            typedIrContractOk = false
            typedIrContractDetailCode = 100
            typedIrContractReason = Fmt"typed_ir_contract function={contractFn.functionName} line={contractFn.signatureLineNumber} reason=function_index_out_of_range primary_index={contractFnIndex} typed_index={typedFnIndex} typed_function_count={loweringPlan.typedIr.functions2_functionNameIds.len}"
            break
        if !texpr.TypedExprBootstrapContractValidateFunction(loweringPlan.typedIr,
                                                             typedFnIndex,
                                                             typedIrContractDetailCode,
                                                             typedIrContractReason):
            typedIrContractOk = false
            break
    SystemLinkExecProgressEmit(rootDir,
                               progressStdErrEnabled,
                               progressPath,
                               progressText,
                               "lowering_plan",
                               "done",
                               phaseProfile.loweringPlanNs,
                               SystemLinkExecNowNs() - totalStartNs)
    var sevenStageSelectedBackend2Observation = false
    if ssr.SevenStageReceiptActive():
        if !typedIrContractOk:
            outErr = typedIrContractReason
            SystemLinkExecAbortLoweringPlanIfNeeded(
                loweringPlan,
                loweringPlanNeedsAbortRelease,
                loweringPayloadLifecycle)
            SystemLinkExecAbortCompilerCsgIfNeeded(
                compilerCsg,
                compilerCsgNeedsAbortRelease,
                compilerCsgProductionLifetime,
                loweringPlan)
            return false
        if exactFunctionCoverage.requested:
            outErr =
                " system link exec: seven-stage exact-function ingress is not canonical"
            SystemLinkExecAbortLoweringPlanIfNeeded(
                loweringPlan,
                loweringPlanNeedsAbortRelease,
                loweringPayloadLifecycle)
            return false
        if req.backendKind == creq.CompilerBackend2:
            sevenStageSelectedBackend2Observation = true
        elif req.backendKind == creq.CompilerBackendPrimary:
            # R2-C6（2026-09-06）：backend2 计划构建单元已外移出 kernel 组合
            #（本文件不再 import backend2_pipeline）。kernel-only 组合无
            # backend2 单元，七阶段独立观察臂 fail-closed 拒收，不设兜底臂；
            # 观察臂交付随 GEN2 二号组合回归。
            outErr =
                " system link exec: backend2 seven-stage observation unit is not in the kernel composition"
            SystemLinkExecAbortLoweringPlanIfNeeded(
                loweringPlan,
                loweringPlanNeedsAbortRelease,
                loweringPayloadLifecycle)
            SystemLinkExecAbortCompilerCsgIfNeeded(
                compilerCsg,
                compilerCsgNeedsAbortRelease,
                compilerCsgProductionLifetime,
                loweringPlan)
            return false
        else:
            outErr = " system link exec: unknown sealed backend kind"
            SystemLinkExecAbortLoweringPlanIfNeeded(
                loweringPlan,
                loweringPlanNeedsAbortRelease,
                loweringPayloadLifecycle)
            return false
    let loweringPreReleaseBefore = SystemLinkExecPhaseMemorySnapshotBorrowed(compilerCsg, loweringPlan, primaryPlan)
    SystemLinkExecPayloadLifecycleReleaseLoweringPrePrimary(payloadLifecycle,
                                                            loweringPlan)
    # [MEM-RELIEF] The pre-primary release drops typed-IR/lowering payloads that
    # primary never reads; return the ownerless pages before primary starts so
    # they are not counted against the guard's peak.  Bytes/receipts unchanged.
    let _loweringPreReleaseRelief = os.ProcessMemoryPressureRelief()
    let loweringPreReleaseAfter = SystemLinkExecPhaseMemorySnapshotBorrowed(compilerCsg, loweringPlan, primaryPlan)
    SystemLinkExecPhaseMemoryRequireStructuredNonIncrease("lowering_pre_release",
                                                           loweringPreReleaseBefore,
                                                           loweringPreReleaseAfter)
    phaseMemoryLedger.loweringPreRelease = SystemLinkExecPhaseMemoryDeltaBorrowed(loweringPreReleaseBefore,
                                                                                  loweringPreReleaseAfter,
                                                                                  compilerCsg,
                                                                                  loweringPlan,
                                                                                  primaryPlan)
    SystemLinkExecPhaseMemoryLedgerEmit(rootDir,
                                        progressStdErrEnabled,
                                        progressPath,
                                        "lowering_pre_release",
                                        phaseMemoryLedger.loweringPreRelease)
    let primaryObjectStartNs: int64 = SystemLinkExecNowNs()
    SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "primary_object_plan", "begin", int64(-1), primaryObjectStartNs - totalStartNs)
    let primaryBuildBefore = loweringPreReleaseAfter
    if req.backendKind != creq.CompilerBackendPrimary &&
       req.backendKind != creq.CompilerBackend2:
        outErr = " system link exec: unknown sealed backend kind"
        SystemLinkExecAbortLoweringPlanIfNeeded(
            loweringPlan,
            loweringPlanNeedsAbortRelease,
            loweringPayloadLifecycle)
        SystemLinkExecAbortCompilerCsgIfNeeded(
            compilerCsg,
            compilerCsgNeedsAbortRelease,
            compilerCsgProductionLifetime,
            loweringPlan)
        return false
    if req.backendKind == creq.CompilerBackend2 &&
       exactFunctionCoverage.requested:
        outErr =
            " system link exec: backend2 exact-function ingress is not implemented"
        SystemLinkExecAbortLoweringPlanIfNeeded(
            loweringPlan,
            loweringPlanNeedsAbortRelease,
            loweringPayloadLifecycle)
        return false
    csglife.CompilerCsgProductionLifetimeBorrowForObjectPlan(
        compilerCsgProductionLifetime)
    compilerlife.CompilerPayloadLifecycleBorrowForConsumer(
        loweringPayloadLifecycle)
    if req.backendKind == creq.CompilerBackend2:
        # R2-C6（2026-09-06）：kernel 组合不含 backend2 计划构建单元，
        # --backend backend2 在 kernel 侧 fail-closed 拒收（同 unknown-kind
        # 既有拒收形），不设兜底臂；单元交付归 GEN2 二号组合。
        outErr =
            " system link exec: backend2 plan build unit is not in the kernel composition"
        SystemLinkExecAbortLoweringPlanIfNeeded(
            loweringPlan,
            loweringPlanNeedsAbortRelease,
            loweringPayloadLifecycle)
        SystemLinkExecAbortCompilerCsgIfNeeded(
            compilerCsg,
            compilerCsgNeedsAbortRelease,
            compilerCsgProductionLifetime,
            loweringPlan)
        return false
    elif req.backendKind == creq.CompilerBackendPrimary:
        primaryPlanNeedsAbortRelease = true
        if exactFunctionCoverage.requested:
            pobj.BuildPrimaryObjectPlanWithExactFunctionInto(
                linkPlan,
                loweringPlan,
                exactFunctionCoverage.functionIndex,
                primaryPlan)
        else:
            pobj.BuildPrimaryObjectPlanInto(
                linkPlan, loweringPlan, primaryPlan)
    else:
        outErr = " system link exec: unknown sealed backend kind"
        SystemLinkExecAbortLoweringPlanIfNeeded(
            loweringPlan,
            loweringPlanNeedsAbortRelease,
            loweringPayloadLifecycle)
        SystemLinkExecAbortCompilerCsgIfNeeded(
            compilerCsg,
            compilerCsgNeedsAbortRelease,
            compilerCsgProductionLifetime,
            loweringPlan)
        return false
    csglife.CompilerCsgProductionLifetimeReturnFromObjectPlan(
        compilerCsgProductionLifetime)
    compilerlife.CompilerPayloadLifecycleReturnConsumerBorrow(
        loweringPayloadLifecycle)
    compilerlife.CompilerPayloadLifecycleMoveToConsumer(
        loweringPayloadLifecycle)
    if sevenStageSelectedBackend2Observation:
        if primaryPlan.missingReasons.len > 0 ||
           primaryPlan.itemIds.len <= 0 ||
           primaryPlan.instructionWords.len <= 0:
            outErr =
                " system link exec: selected backend2 seven-stage lane failed"
            SystemLinkExecAbortPrimaryObjectPlanIfNeeded(
                primaryPlan, primaryPlanNeedsAbortRelease)
            SystemLinkExecAbortLoweringPlanIfNeeded(
                loweringPlan,
                loweringPlanNeedsAbortRelease,
                loweringPayloadLifecycle)
            SystemLinkExecAbortCompilerCsgIfNeeded(
                compilerCsg,
                compilerCsgNeedsAbortRelease,
                compilerCsgProductionLifetime,
                loweringPlan)
            return false
        var selectedBackend2Object: direct.DirectObjectEmitResult
        var selectedBackend2ObjectErr = ""
        if !csgemit.PrimaryObjectCsgcEmitPlanObjectInto(
               rootDir,
               primaryPlan,
               selectedBackend2Object,
               selectedBackend2ObjectErr):
            outErr = selectedBackend2ObjectErr
            SystemLinkExecAbortPrimaryObjectPlanIfNeeded(
                primaryPlan, primaryPlanNeedsAbortRelease)
            SystemLinkExecAbortLoweringPlanIfNeeded(
                loweringPlan,
                loweringPlanNeedsAbortRelease,
                loweringPayloadLifecycle)
            SystemLinkExecAbortCompilerCsgIfNeeded(
                compilerCsg,
                compilerCsgNeedsAbortRelease,
                compilerCsgProductionLifetime,
                loweringPlan)
            return false
    let loweringPrimaryIrFunctionCountSnapshot = loweringPlan.primaryObjectIr.functions.len
    phaseProfile.primaryObjectPlanNs = SystemLinkExecNowNs() - primaryObjectStartNs
    let primaryBuildAfter = SystemLinkExecPhaseMemorySnapshotBorrowed(compilerCsg, loweringPlan, primaryPlan)
    phaseMemoryLedger.primaryBuild = SystemLinkExecPhaseMemoryDeltaBorrowed(primaryBuildBefore,
                                                                            primaryBuildAfter,
                                                                            compilerCsg,
                                                                            loweringPlan,
                                                                            primaryPlan)
    SystemLinkExecPhaseMemoryLedgerEmit(rootDir,
                                        progressStdErrEnabled,
                                        progressPath,
                                        "primary_build",
                                        phaseMemoryLedger.primaryBuild)
    let primaryReleaseBefore = primaryBuildAfter
    SystemLinkExecPayloadLifecycleReleaseLoweringAfterPrimary(payloadLifecycle,
                                                              loweringPlan)
    # [MEM-RELIEF] Return pages freed by the post-primary release immediately,
    # before the release snapshot/receipt chain re-touches them.  Bytes and
    # lifecycle receipts are unchanged.
    let _primaryReleaseRelief = os.ProcessMemoryPressureRelief()
    let primaryReleaseAfter = SystemLinkExecPhaseMemorySnapshotBorrowed(compilerCsg, loweringPlan, primaryPlan)
    SystemLinkExecPhaseMemoryRequireStructuredNonIncrease("primary_release",
                                                           primaryReleaseBefore,
                                                           primaryReleaseAfter)
    phaseMemoryLedger.primaryRelease = SystemLinkExecPhaseMemoryDeltaBorrowed(primaryReleaseBefore,
                                                                              primaryReleaseAfter,
                                                                              compilerCsg,
                                                                              loweringPlan,
                                                                              primaryPlan)
    SystemLinkExecPhaseMemoryLedgerEmit(rootDir,
                                        progressStdErrEnabled,
                                        progressPath,
                                        "primary_release",
                                        phaseMemoryLedger.primaryRelease)
    if !SystemLinkExecExactFunctionCapturePrimaryInto(exactFunctionCoverage,
                                                      primaryPlan,
                                                      exactFunctionCoverageErr):
        SystemLinkExecProgressEmit(rootDir,
                                   progressStdErrEnabled,
                                   progressPath,
                                   progressText,
                                   "primary_object_plan",
                                   "error",
                                   int64(-1),
                                   SystemLinkExecNowNs() - totalStartNs)
        outErr = exactFunctionCoverageErr
        SystemLinkExecAbortPrimaryObjectPlanIfNeeded(
            primaryPlan, primaryPlanNeedsAbortRelease)
        SystemLinkExecAbortLoweringPlanIfNeeded(
            loweringPlan,
            loweringPlanNeedsAbortRelease,
            loweringPayloadLifecycle)
        SystemLinkExecAbortCompilerCsgIfNeeded(
            compilerCsg,
            compilerCsgNeedsAbortRelease,
            compilerCsgProductionLifetime,
            loweringPlan)
        return false
    SystemLinkExecProgressEmit(rootDir,
                                 progressStdErrEnabled,
                                 progressPath,
                                 progressText,
                                 "primary_object_plan",
                                 "done",
                                 phaseProfile.primaryObjectPlanNs,
                                 SystemLinkExecNowNs() - totalStartNs)
    let providerSourcesStartNs: int64 = SystemLinkExecNowNs()
    SystemLinkExecProgressEmit(rootDir,
                                 progressStdErrEnabled,
                                 progressPath,
                                 progressText,
                                 "provider_sources",
                                 "begin",
                                 int64(-1),
                                 providerSourcesStartNs - totalStartNs)
    var providerSources: str[]
    var providerSourcesErr = ""
    var providerSourcesOk = true
    if linkPlan.providerObjectPaths.len <= 0:
        providerSourcesOk = ProviderSourcesForPlanInto(rootDir, linkPlan, providerSources, providerSourcesErr)
        if !providerSourcesOk:
            SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "provider_sources", "error", int64(-1), SystemLinkExecNowNs() - totalStartNs)
            outErr = providerSourcesErr
            SystemLinkExecAbortPrimaryObjectPlanIfNeeded(
                primaryPlan, primaryPlanNeedsAbortRelease)
            SystemLinkExecAbortLoweringPlanIfNeeded(
                loweringPlan,
                loweringPlanNeedsAbortRelease,
                loweringPayloadLifecycle)
            SystemLinkExecAbortCompilerCsgIfNeeded(
                compilerCsg,
                compilerCsgNeedsAbortRelease,
                compilerCsgProductionLifetime,
                loweringPlan)
            return false
    let providerSourcesEndNs: int64 = SystemLinkExecNowNs()
    phaseProfile.providerSourcesNs = providerSourcesEndNs - providerSourcesStartNs
    let providerSourcesProgressDoneNs: int64 = SystemLinkExecNowNs()
    SystemLinkExecProgressEmit(rootDir,
                                 progressStdErrEnabled,
                                 progressPath,
                                 progressText,
                                 "provider_sources",
                                 "done",
                                 phaseProfile.providerSourcesNs,
                                 providerSourcesProgressDoneNs - totalStartNs)
    var providerObjectPaths: str[]
    var linkInputs: str[]
    var objectMissing: str[]
    var providerSourcePaths: str[]
    var activeProviderModules: str[]
    providerObjectPaths = []
    linkInputs = []
    objectMissing = []
    providerSourcePaths = []
    activeProviderModules = []
    let primaryObjectPath = system.SystemToStringStr(primaryPlan.outputPath)
    let browserBridgeObjectPath = system.SystemToStringStr(SystemLinkExecBrowserBridgeObjectPathForLinkPlan(linkPlan))
    if len(primaryObjectPath) > 0:
        add(linkInputs, share(primaryObjectPath))
    if len(browserBridgeObjectPath) > 0:
        add(linkInputs, share(browserBridgeObjectPath))
    let providerObjectPathCount = linkPlan.providerObjectPaths.len
    var providerObjectPathIndex: int32
    while providerObjectPathIndex < providerObjectPathCount:
        let providerObjectPath = system.SystemToStringStr(linkPlan.providerObjectPaths[providerObjectPathIndex])
        add(providerObjectPaths, share(providerObjectPath))
        add(linkInputs, share(providerObjectPath))
        providerObjectPathIndex = providerObjectPathIndex + 1
    if linkPlan.providerObjectPaths.len <= 0:
        let providerModuleCount = linkPlan.providerModules.len
        var providerModuleIndex: int32
        while providerModuleIndex < providerModuleCount:
            let providerModule = system.SystemToStringStr(linkPlan.providerModules[providerModuleIndex])
            let providerSourceIndex = providerModuleIndex
            providerModuleIndex = providerModuleIndex + 1
            if len(providerModule) <= 0:
                continue
            if !SystemLinkExecProviderModuleActive(linkPlan, primaryPlan, providerModule):
                continue
            add(activeProviderModules, share(providerModule))
            if providerSourceIndex < providerSources.len:
                let providerSourcePath = chengpath.PathAbsolute(rootDir, providerSources[providerSourceIndex])
                add(providerSourcePaths, system.SystemToStringStr(providerSourcePath))
            else:
                add(objectMissing, "provider_source_paths_incomplete")
    var linuxNolibcSupportEnabled = false
    var linuxNolibcRuntimeSourcePath = ""
    var linuxNolibcRuntimeObjectPath = ""
    var linuxNolibcStartupSourcePath = ""
    var linuxNolibcStartupObjectPath = ""
    let targetTripleForNolibc = system.SystemToStringStr(linkPlan.targetTriple)
    if linkPlan.emitKind == creq.EmitExe &&
       (targetTripleForNolibc == "aarch64-unknown-linux-gnu" ||
        targetTripleForNolibc == "arm64-unknown-linux-gnu"):
        linuxNolibcSupportEnabled = true
        linuxNolibcRuntimeSourcePath = chengpath.PathAbsolute(rootDir, "src/std/system_helpers_backend_nolibc_linux_aarch64.cheng")
        linuxNolibcRuntimeObjectPath = Fmt"{linkPlan.outputPath}.runtime.system_helpers_backend_nolibc_linux_aarch64.o"
        linuxNolibcStartupSourcePath = chengpath.PathAbsolute(rootDir, "src/core/runtime/cheng_linux_nolibc_aarch64_entry.S")
        linuxNolibcStartupObjectPath = Fmt"{linkPlan.outputPath}.startup.cheng_linux_nolibc_aarch64_entry.o"
        add(linkInputs, share(linuxNolibcStartupObjectPath))
        add(linkInputs, share(linuxNolibcRuntimeObjectPath))
    if linkPlan.providerObjectPaths.len <= 0:
        let activeProviderModuleCount = activeProviderModules.len
        var activeProviderModuleIndex: int32
        while activeProviderModuleIndex < activeProviderModuleCount:
            let providerModule = activeProviderModules[activeProviderModuleIndex]
            var safe = ""
            for j in 0..<len(providerModule):
                let ch = providerModule[j]
                let digit = ch >= '0' && ch <= '9'
                let upper = ch >= 'A' && ch <= 'Z'
                let lower = ch >= 'a' && ch <= 'z'
                if digit || upper || lower:
                    safe = Fmt"{safe}{strings.SliceBytes(providerModule, j, 1)}"
                else:
                    safe = Fmt"{safe}_"
            let providerObjectPath = Fmt"system_link_exec_provider.{strings.IntToStr(activeProviderModuleIndex)}.o"
            add(providerObjectPaths, share(providerObjectPath))
            add(linkInputs, share(providerObjectPath))
            activeProviderModuleIndex = activeProviderModuleIndex + 1
    if linkPlan.missingReasons.len > 0:
        add(objectMissing, "system_link_plan_not_ready_for_object_plan")
    if loweringPlan.missingReasons.len > 0:
        add(objectMissing, "lowering_plan_not_ready_for_object_plan")
    if primaryPlan.missingReasons.len > 0:
        add(objectMissing, "primary_object_not_ready_for_object_plan")
    if len(primaryObjectPath) <= 0:
        add(objectMissing, "primary_object_path_missing")
    if loweringPlan.functionSymbolTexts.len <= 0:
        add(objectMissing, "primary_object_functions_missing")
    if linkPlan.providerObjectPaths.len <= 0 &&
       activeProviderModules.len > 0 &&
       providerObjectPaths.len != activeProviderModules.len:
        add(objectMissing, "provider_object_paths_incomplete")
    if linkPlan.providerObjectPaths.len <= 0 &&
       activeProviderModules.len > 0 &&
       providerSourcePaths.len != activeProviderModules.len:
        add(objectMissing, "provider_source_paths_incomplete")
    if linuxNolibcSupportEnabled:
        if len(linuxNolibcRuntimeSourcePath) <= 0 || !chengpath.PathFileExists(linuxNolibcRuntimeSourcePath):
            add(objectMissing, "linux_nolibc_runtime_source_missing")
        if len(linuxNolibcStartupSourcePath) <= 0 || !chengpath.PathFileExists(linuxNolibcStartupSourcePath):
            add(objectMissing, "linux_nolibc_startup_source_missing")
        if len(linuxNolibcRuntimeObjectPath) <= 0:
            add(objectMissing, "linux_nolibc_runtime_object_path_missing")
        if len(linuxNolibcStartupObjectPath) <= 0:
            add(objectMissing, "linux_nolibc_startup_object_path_missing")
    let objectPlanStartNs: int64 = SystemLinkExecNowNs()
    SystemLinkExecProgressEmit(rootDir,
                                 progressStdErrEnabled,
                                 progressPath,
                                 progressText,
                                 "object_plan",
                                 "begin",
                                 int64(-1),
                                 objectPlanStartNs - totalStartNs)
    var objectPlan: objplan.ObjectPlanStub
    objectPlan.workspaceRoot = linkPlan.workspaceRoot
    objectPlan.packageRoot = linkPlan.packageRoot
    objectPlan.packageId = linkPlan.packageId
    objectPlan.entryPath = linkPlan.entryPath
    objectPlan.outputPath = linkPlan.outputPath
    objectPlan.targetTriple = linkPlan.targetTriple
    objectPlan.primaryObjectPath = primaryObjectPath
    objectPlan.browserBridgeObjectPath = browserBridgeObjectPath
    objectPlan.linuxNolibcSupportEnabled = linuxNolibcSupportEnabled
    objectPlan.linuxNolibcRuntimeSourcePath = linuxNolibcRuntimeSourcePath
    objectPlan.linuxNolibcRuntimeObjectPath = linuxNolibcRuntimeObjectPath
    objectPlan.linuxNolibcStartupSourcePath = linuxNolibcStartupSourcePath
    objectPlan.linuxNolibcStartupObjectPath = linuxNolibcStartupObjectPath
    objectPlan.providerModules = share(activeProviderModules)
    objectPlan.providerSourcePaths = providerSourcePaths
    objectPlan.providerObjectPaths = providerObjectPaths
    objectPlan.linkInputPaths = linkInputs
    objectPlan.loweredFunctionSymbols = loweringPlan.functionSymbolTexts
    objectPlan.entrySymbol = linkPlan.entrySymbol
    objectPlan.missingReasons = objectMissing
    objectPlan.pipelineStage = "lowering_plan_to_object_plan"
    let objectPlanEndNs: int64 = SystemLinkExecNowNs()
    phaseProfile.objectPlanNs = objectPlanEndNs - objectPlanStartNs
    SystemLinkExecProgressEmit(rootDir,
                                 progressStdErrEnabled,
                                 progressPath,
                                 progressText,
                                 "object_plan",
                                 "done",
                                 phaseProfile.objectPlanNs,
                                 objectPlanEndNs - totalStartNs)
    let nativeLinkStartNs: int64 = SystemLinkExecNowNs()
    SystemLinkExecProgressEmit(rootDir,
                                 progressStdErrEnabled,
                                 progressPath,
                                 progressText,
                                 "native_link_plan",
                                 "begin",
                                 int64(-1),
                                 nativeLinkStartNs - totalStartNs)
    let nativePlan = nplan.BuildNativeLinkPlan(linkPlan, objectPlan)
    let nativeLinkEndNs: int64 = SystemLinkExecNowNs()
    phaseProfile.nativeLinkPlanNs = nativeLinkEndNs - nativeLinkStartNs
    SystemLinkExecProgressEmit(rootDir,
                                 progressStdErrEnabled,
                                 progressPath,
                                 progressText,
                                 "native_link_plan",
                                 "done",
                                 phaseProfile.nativeLinkPlanNs,
                                 nativeLinkEndNs - totalStartNs)
    let compileReceiptStartNs: int64 = SystemLinkExecNowNs()
    SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "compile_receipt", "begin", int64(-1), compileReceiptStartNs - totalStartNs)
    var orderedProviderModules: str[]
    var semanticReceiptErr: str
    if !SystemLinkExecCanonicalProviderSetInto(activeProviderModules,
                                               orderedProviderModules,
                                               semanticReceiptErr):
        outErr = semanticReceiptErr
        SystemLinkExecAbortPrimaryObjectPlanIfNeeded(
            primaryPlan, primaryPlanNeedsAbortRelease)
        SystemLinkExecAbortLoweringPlanIfNeeded(
            loweringPlan,
            loweringPlanNeedsAbortRelease,
            loweringPayloadLifecycle)
        SystemLinkExecAbortCompilerCsgIfNeeded(
            compilerCsg,
            compilerCsgNeedsAbortRelease,
            compilerCsgProductionLifetime,
            loweringPlan)
        return false
    let canonicalOutputDigest = SystemLinkExecCanonicalOutputDigest(
        linkPlan.emitKind,
        linkPlan.symbolVisibility,
        linkPlan.targetTriple,
        orderedProviderModules,
        compilerCsg.canonicalGraphCid)
    if compilerCsg.nodeCount != 0 || compilerCsg.nodes.len != 0 ||
       compilerCsg.edgeCount != 0 || compilerCsg.edges.len != 0:
        if !ccsg.CompilerCsgOwnTransitionReceiptStrictValidateInto(
               compilerCsg, semanticReceiptErr):
            outErr = semanticReceiptErr
            SystemLinkExecAbortPrimaryObjectPlanIfNeeded(
                primaryPlan, primaryPlanNeedsAbortRelease)
            SystemLinkExecAbortLoweringPlanIfNeeded(
                loweringPlan,
                loweringPlanNeedsAbortRelease,
                loweringPayloadLifecycle)
            SystemLinkExecAbortCompilerCsgIfNeeded(
                compilerCsg,
                compilerCsgNeedsAbortRelease,
                compilerCsgProductionLifetime,
                loweringPlan)
            return false
    elif layout.FixedBytes32Equal(
            compilerCsg.canonicalGraphCid, layout.FixedBytes32()) ||
         !layout.FixedBytes32Equal(
             compilerCsg.csgTransitionReceipt.canonicalCompilerCsgCid,
             compilerCsg.canonicalGraphCid) ||
         !layout.FixedBytes32Equal(
             compilerCsg.csgTransitionReceipt.sourceIdentityReceiptCid,
             compilerCsg.sourceIdentityReceipt.receiptCid):
        semanticReceiptErr =
            "system link exec: transition receipt CSG cid mismatch after backend release"
        outErr = semanticReceiptErr
        SystemLinkExecAbortPrimaryObjectPlanIfNeeded(
            primaryPlan, primaryPlanNeedsAbortRelease)
        SystemLinkExecAbortLoweringPlanIfNeeded(
            loweringPlan,
            loweringPlanNeedsAbortRelease,
            loweringPayloadLifecycle)
        SystemLinkExecAbortCompilerCsgIfNeeded(
            compilerCsg,
            compilerCsgNeedsAbortRelease,
            compilerCsgProductionLifetime,
            loweringPlan)
        return false
    var semanticReceipt: CompileSemanticReceipt
    if !SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
            compilerCsg.sourceIdentityReceipt,
            compilerCsg.canonicalGraphCid,
            canonicalOutputDigest,
            linkPlan.targetTriple,
            "stage3_local",
            orderedProviderModules,
            semanticReceipt,
            semanticReceiptErr):
        outErr = semanticReceiptErr
        SystemLinkExecAbortPrimaryObjectPlanIfNeeded(
            primaryPlan, primaryPlanNeedsAbortRelease)
        SystemLinkExecAbortLoweringPlanIfNeeded(
            loweringPlan,
            loweringPlanNeedsAbortRelease,
            loweringPayloadLifecycle)
        SystemLinkExecAbortCompilerCsgIfNeeded(
            compilerCsg,
            compilerCsgNeedsAbortRelease,
            compilerCsgProductionLifetime,
            loweringPlan)
        return false
    let sourceToCsgBindingSeal = SystemLinkExecSourceToCsgBindingSeal(
        compilerCsg.sourceIdentityReceipt.receiptCid,
        compilerCsg.canonicalGraphCid,
        semanticReceipt.receiptCid)
    var compileReceipt: ccsg.CompileReceipt
    phaseProfile.compileReceiptNs = SystemLinkExecNowNs() - compileReceiptStartNs
    phaseProfile.totalNs = SystemLinkExecNowNs() - totalStartNs
    SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "compile_receipt", "done", phaseProfile.compileReceiptNs, phaseProfile.totalNs)
    SystemLinkExecProgressEmit(rootDir, progressStdErrEnabled, progressPath, progressText, "plan_build", "done", phaseProfile.totalNs, phaseProfile.totalNs)
    var planReadyCode: int32
    planReadyCode = 1
    var planNotReadyCode: int32
    var planNotReadyDetailCode: int32
    var planNotReadyReason = ""
    if linkPlan.missingReasons.len > 0:
        planReadyCode = 0
        planNotReadyCode = 1
        planNotReadyReason = "system_link_plan_not_ready"
    if planReadyCode == 1:
        if loweringPlan.missingReasons.len > 0:
            planReadyCode = 0
            planNotReadyCode = 2
            planNotReadyReason = "lowering_plan_not_ready"
    if planReadyCode == 1:
        if !typedIrContractOk:
            planReadyCode = 0
            planNotReadyCode = 6
            planNotReadyDetailCode = typedIrContractDetailCode
            planNotReadyReason = typedIrContractReason
    if planReadyCode == 1:
        if primaryPlan.missingReasons.len > 0:
            planReadyCode = 0
            planNotReadyCode = 3
            if primaryPlan.itemIds.len <= 0:
                planNotReadyDetailCode = 31
            elif primaryPlan.instructionWords.len <= 0:
                planNotReadyDetailCode = 32
            else:
                planNotReadyDetailCode = 30
            planNotReadyReason = "primary_object_plan_not_ready"
    if planReadyCode == 1:
        if linkPlan.emitKind != creq.EmitObj:
            if objectPlan.missingReasons.len > 0:
                planReadyCode = 0
                planNotReadyCode = 4
                planNotReadyReason = "object_plan_not_ready"
    if planReadyCode == 1:
        if linkPlan.emitKind != creq.EmitObj:
            if nativePlan.missingReasons.len > 0:
                planReadyCode = 0
                planNotReadyCode = 5
                planNotReadyReason = "native_link_plan_not_ready"
    var productionCurrentHeadCid: str
    var productionManifestCid: str
    var productionCsgcObjectCid: str
    var productionFactsRootCid: str
    var productionProofCargoCid: str
    var productionTransactionReceiptCid: str
    var productionBindingErr: str
    if !snapshot_bridge.CompilerSnapshotLoweringAuthorityProductionBindingCidsInto(
           loweringPlan.compilerSnapshotLoweringAuthority,
           productionCurrentHeadCid,
           productionManifestCid,
           productionCsgcObjectCid,
           productionFactsRootCid,
           productionProofCargoCid,
           productionTransactionReceiptCid,
           productionBindingErr):
        outErr = productionBindingErr
        SystemLinkExecAbortPrimaryObjectPlanIfNeeded(
            primaryPlan, primaryPlanNeedsAbortRelease)
        SystemLinkExecAbortLoweringPlanIfNeeded(
            loweringPlan,
            loweringPlanNeedsAbortRelease,
            loweringPayloadLifecycle)
        SystemLinkExecAbortCompilerCsgIfNeeded(
            compilerCsg,
            compilerCsgNeedsAbortRelease,
            compilerCsgProductionLifetime,
            loweringPlan)
        return false
    let expectedProductionFactsRootCid =
        Fmt"sha256:{layout.FixedBytes32Hex(loweringPlan.semanticSnapshotFactsRootCid)}"
    if productionFactsRootCid != expectedProductionFactsRootCid:
        outErr = "system_link_exec_production_facts_root_unbound"
        SystemLinkExecAbortPrimaryObjectPlanIfNeeded(
            primaryPlan, primaryPlanNeedsAbortRelease)
        SystemLinkExecAbortLoweringPlanIfNeeded(
            loweringPlan,
            loweringPlanNeedsAbortRelease,
            loweringPayloadLifecycle)
        SystemLinkExecAbortCompilerCsgIfNeeded(
            compilerCsg,
            compilerCsgNeedsAbortRelease,
            compilerCsgProductionLifetime,
            loweringPlan)
        return false
    let productionCommandCid =
        Fmt"sha256:{layout.FixedBytes32Hex(req.backendRequestCid)}"
    let productionInputSetCid =
        Fmt"sha256:{layout.FixedBytes32Hex(sourceBundleReceipt.sourceIdentityReceiptCid)}"
    let productionOutputContractCid =
        Fmt"sha256:{layout.FixedBytes32Hex(semanticReceipt.canonicalOutputDigest)}"
    var planEvidenceHandle: systemLinkExecPlanEvidenceHandle
    if !systemLinkExecPlanEvidenceIssueInto(
           productionCommandCid,
           productionInputSetCid,
           productionOutputContractCid,
           productionCurrentHeadCid,
           productionManifestCid,
           productionCsgcObjectCid,
           productionFactsRootCid,
           productionProofCargoCid,
           productionTransactionReceiptCid,
           planEvidenceHandle,
           productionBindingErr) ||
       !systemLinkExecPlanEvidenceConsumeAndBindInto(
           planEvidenceHandle,
           productionAdmissionReceipt,
           productionBindingErr):
        outErr = productionBindingErr
        SystemLinkExecAbortPrimaryObjectPlanIfNeeded(
            primaryPlan, primaryPlanNeedsAbortRelease)
        SystemLinkExecAbortLoweringPlanIfNeeded(
            loweringPlan,
            loweringPlanNeedsAbortRelease,
            loweringPayloadLifecycle)
        SystemLinkExecAbortCompilerCsgIfNeeded(
            compilerCsg,
            compilerCsgNeedsAbortRelease,
            compilerCsgProductionLifetime,
            loweringPlan)
        return false
    var execPlan: SystemLinkExecPlan
    execPlan.readyCode = planReadyCode
    execPlan.notReadyCode = planNotReadyCode
    execPlan.notReadyDetailCode = planNotReadyDetailCode
    execPlan.compilerCsgTypedIrFunctionCount = compilerCsgTypedIrFunctionCount
    execPlan.compilerCsgTypedIrNodeCount = compilerCsgTypedIrNodeCount
    execPlan.compilerCsgTypedIrStatementCount = compilerCsgTypedIrStatementCount
    execPlan.compilerCsgTypedExprFactCount = compilerCsgTypedExprFactCount
    execPlan.compilerCsgExprLayerExprCount = compilerCsgExprLayerExprCount
    execPlan.compilerCsgRssBytes = compilerCsgRssBytes
    execPlan.compilerCsgLogicalPayloadBytes = compilerCsgLogicalPayloadBytes
    execPlan.compilerCsgNodesLiveBytes = compilerCsgNodesLiveBytes
    execPlan.compilerCsgEdgesLiveBytes = compilerCsgEdgesLiveBytes
    execPlan.compilerCsgExprLayerLiveBytes = compilerCsgExprLayerLiveBytes
    execPlan.compilerCsgTypedFactsLiveBytes = compilerCsgTypedFactsLiveBytes
    execPlan.compilerCsgTypedIrLiveBytes = compilerCsgTypedIrLiveBytes
    execPlan.compilerCsgMetadataLiveBytes = compilerCsgMetadataLiveBytes
    execPlan.compilerCsgSourceTextLiveBytes = compilerCsgSourceTextLiveBytes
    execPlan.compilerCsgRssGapBytes = compilerCsgRssGapBytes
    execPlan.compilerCsgTypedIrRoundCount = compilerCsgTypedIrRoundCount
    execPlan.compilerCsgTypedIrRebuildSourceCount = compilerCsgTypedIrRebuildSourceCount
    execPlan.compilerCsgTypedIrNewFunctionCount = compilerCsgTypedIrNewFunctionCount
    execPlan.compilerCsgFirstFunctionSignatureLine = compilerCsgFirstFunctionSignatureLine
    execPlan.compilerCsgFirstFunctionBodyLine = compilerCsgFirstFunctionBodyLine
    execPlan.compilerCsgFirstFunctionNodeCount = compilerCsgFirstFunctionNodeCount
    execPlan.compilerCsgFirstFunctionStatementCount = compilerCsgFirstFunctionStatementCount
    execPlan.compilerCsgFirstFunctionReturnNodeIndex = compilerCsgFirstFunctionReturnNodeIndex
    execPlan.compilerCsgFirstFunctionReturnTypeCode = compilerCsgFirstFunctionReturnTypeCode
    execPlan.compilerCsgFirstFunctionReturnExprCode = compilerCsgFirstFunctionReturnExprCode
    execPlan.compilerCsgFirstFunctionReturnExprLen = compilerCsgFirstFunctionReturnExprLen
    execPlan.compilerCsgFirstFunctionReturnExprFirstByte = compilerCsgFirstFunctionReturnExprFirstByte
    execPlan.compilerCsgFirstFunctionReturnExprLastByte = compilerCsgFirstFunctionReturnExprLastByte
    execPlan.loweringFunctionCount = loweringPlan.functionNames.len
    execPlan.loweringTypedIrFunctionCount = loweringPlan.typedIrFunctionCountSnapshot
    execPlan.loweringTypedIrNodeCount = loweringPlan.typedIrNodeCountSnapshot
    execPlan.loweringTypedIrStatementCount = loweringPlan.typedIrStatementCountSnapshot
    execPlan.loweringPrimaryIrBuildFunctionCount = loweringPlan.primaryObjectIrBuildFunctionCount
    execPlan.loweringPrimaryIrFunctionCount = loweringPrimaryIrFunctionCountSnapshot
    execPlan.loweringPrimaryIrSkippedFunctionCount = loweringPlan.primaryObjectIrSkippedFunctionCount
    execPlan.loweringPrimaryIrEntryTypedFunctionIndex = loweringPlan.primaryObjectIrEntryTypedFunctionIndex
    execPlan.loweringPrimaryIrEntryBodyKindCode = loweringPlan.primaryObjectIrEntryBodyKindCode
    execPlan.loweringPrimaryIrEntryStatementCount = loweringPlan.primaryObjectIrEntryStatementCount
    execPlan.loweringMissingCount = loweringPlan.missingReasons.len
    execPlan.loweringRequestedJobCount = lower.LoweringParallelLastRequestedJobCount()
    execPlan.loweringActiveWorkerCount = lower.LoweringParallelLastActiveWorkerCount()
    execPlan.loweringCompletedWorkerCount = lower.LoweringParallelLastCompletedWorkerCount()
    execPlan.loweringTaskCount = lower.LoweringParallelLastTaskCount()
    execPlan.primaryPlanItemCount = primaryPlan.itemIds.len
    execPlan.primaryPlanReachableFunctionCount = primaryPlan.reachableFunctionCount
    execPlan.primaryPlanInstructionWordCount = primaryPlan.instructionWords.len
    execPlan.primaryPlanMissingCount = primaryPlan.missingReasons.len
    if primaryPlan.error.bodyKind == "missing_primary_object_ir":
        execPlan.primaryPlanErrorBodyKindCode = 1
    elif primaryPlan.error.bodyKind == "missing_call_sequence":
        execPlan.primaryPlanErrorBodyKindCode = 2
    elif primaryPlan.error.bodyKind == "body_ir_call_sequence_drift":
        execPlan.primaryPlanErrorBodyKindCode = 3
    elif primaryPlan.error.bodyKind == "unsupported":
        execPlan.primaryPlanErrorBodyKindCode = 10
    elif primaryPlan.error.bodyKind == "return_zero_i32":
        execPlan.primaryPlanErrorBodyKindCode = 11
    elif primaryPlan.error.bodyKind == "statement_sequence":
        execPlan.primaryPlanErrorBodyKindCode = 12
    elif len(primaryPlan.error.bodyKind) > 0:
        execPlan.primaryPlanErrorBodyKindCode = 99
    execPlan.notReadyReason = planNotReadyReason
    execPlan.compilerEntrySource = linkPlan.buildEntryPath
    execPlan.sourceBundleCid = sourceBundleCid
    execPlan.sourceBundleReceipt = sourceBundleReceipt
    execPlan.systemLinkPlan = linkPlan
    execPlan.managedDependencyReceipt = managedDependencyReceiptProjection
    execPlan.compilerCsg = compilerCsg
    execPlan.exportSurface = exportSurface
    execPlan.localUniverse = localUniverse
    execPlan.semanticReceipt = semanticReceipt
    execPlan.sourceToCsgBindingSeal = sourceToCsgBindingSeal
    execPlan.compileReceipt = compileReceipt
    execPlan.worldHeadPinned = worldHeadPinned
    execPlan.lockCheckEnabled = lockCheckEnabled
    execPlan.lockVerified = lockVerified
    execPlan.baselineSurfaceChecked = baselineSurfaceChecked
    execPlan.baselineSurfaceCompatible = baselineSurfaceCompatible
    execPlan.lockPath = effectiveLockPath
    execPlan.baselineSurfacePath = effectiveBaselineSurfacePath
    execPlan.phaseProfile = phaseProfile
    execPlan.phaseMemoryLedger = phaseMemoryLedger
    execPlan.payloadLifecycle = payloadLifecycle
    csglife.CompilerCsgProductionLifetimeTransferInto(
        compilerCsgProductionLifetime,
        execPlan.compilerCsgProductionLifetime)
    execPlan.compilerCsgOwnerResourceTrace =
        compilerCsgOwnerResourceTrace
    execPlan.compilerCsgLifetimeReceiptReady = false
    compilerlife.CompilerPayloadLifecycleTransferInto(
        loweringPayloadLifecycle,
        execPlan.loweringPayloadLifecycle)
    execPlan.loweringLifetimeReceiptReady = false
    execPlan.exactFunctionCoverage = exactFunctionCoverage
    loweringPlanNeedsAbortRelease = false
    execPlan.loweringPlan = loweringPlan
    primaryPlanNeedsAbortRelease = false
    execPlan.primaryObjectPlan = primaryPlan
    execPlan.objectPlan = objectPlan
    execPlan.nativeLinkPlan = nativePlan
    execPlan.requestBackendKind = req.backendKind
    execPlan.requestedJobCount = req.jobCount
    execPlan.requestEmitKind = req.emitKind
    execPlan.requestProviderObjectPaths = req.providerObjectPaths
    execPlan.requestRuntimeProviderBundle = req.runtimeProviderBundle
    execPlan.backendRequestActionCid = req.backendRequestActionCid
    execPlan.backendRequestCid = req.backendRequestCid
    execPlan.compositionManifestSchema = strings.CloneStr(
        req.compositionManifestSchema)
    execPlan.compositionManifestSha256 = strings.CloneStr(
        req.compositionManifestSha256)
    execPlan.compositionKernelManifestSha256 = strings.CloneStr(
        req.compositionKernelManifestSha256)
    execPlan.compositionKind = strings.CloneStr(req.compositionKind)
    execPlan.compositionEntrySource = strings.CloneStr(
        req.compositionEntrySource)
    execPlan.compositionPluginCanonicalTriple = strings.CloneStr(
        req.compositionPluginCanonicalTriple)
    execPlan.compositionDeclaredSourceCount =
        req.compositionDeclaredSourcePaths.len
    execPlan.compositionDeclaredSourcesSha256 = strings.CloneStr(
        req.compositionDeclaredSourcesSha256)
    execPlan.compositionSourceClosureCount =
        req.compositionSourceClosureCount
    execPlan.compositionSourceClosureSha256 = strings.CloneStr(
        req.compositionSourceClosureSha256)
    if creq.CompilerRequestCompositionPresent(req):
        execPlan.compositionSourceIdentityReceiptCid =
            layout.FixedBytes32Copy(
                sourceBundleReceipt.sourceIdentityReceiptCid)
    execPlan.productionAdmissionReceipt = productionAdmissionReceipt
    SystemLinkExecPlanPrepareExecution(execPlan)
    outPlan = execPlan
    outErr = ""
    return true

@borrows
fn BuildSystemLinkExecPlanWithWorldAndChannel(rootDir: str,
                                                req: creq.CompilerRequest,
                                                requestedWorldHead: str,
                                                lockPath: str,
                                                baselineSurfacePath: str,
                                                channelRaw: str): Result[SystemLinkExecPlan] =
    var outPlan: SystemLinkExecPlan
    var outErr: str
    if !BuildSystemLinkExecPlanWithWorldAndChannelInto(rootDir,
                                                       req,
                                                       requestedWorldHead,
                                                       lockPath,
                                                       baselineSurfacePath,
                                                       channelRaw,
                                                       outPlan,
                                                       outErr):
        return Err[SystemLinkExecPlan](outErr)
    return Ok[SystemLinkExecPlan](outPlan)

@borrows
fn BuildSystemLinkExecPlanProbeStatusWithWorldAndChannel(rootDir: str,
                                                         req: creq.CompilerRequest,
                                                         requestedWorldHead: str,
                                                         lockPath: str,
                                                         baselineSurfacePath: str,
                                                         channelRaw: str,
                                                         outErr: var str): bool =
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    var linkPlan: slplan.SystemLinkPlanStub
    var err = ""
    let ok = slplan.BuildSystemLinkPlanStubWithExternalPackageRoots(rootDir,
                                                                    req,
                                                                    externalPackageRoots,
                                                                    linkPlan,
                                                                    err)
    if !ok:
        outErr = err
        return false
    return true

@borrows
fn BuildSystemLinkExecPlanFromRequestFieldsWithWorldAndChannel(rootDir: str,
                                                                 reqRootDir: str,
                                                                 sourcePath: str,
                                                                 outputPath: str,
                                                                 targetTriple: str,
                                                                 emitKind: creq.CompilerEmit,
                                                                 reportPath: str,
                                                                 symbolVisibility: str,
                                                                 requestedWorldHead: str,
                                                                 lockPath: str,
                                                                 baselineSurfacePath: str,
                                                                 channelRaw: str): Result[SystemLinkExecPlan] =
    var req: creq.CompilerRequest
    req.rootDir = reqRootDir
    req.sourcePath = sourcePath
    req.outputPath = outputPath
    req.targetTriple = targetTriple
    req.emitKind = emitKind
    req.reportPath = reportPath
    req.symbolVisibility = symbolVisibility
    req.browserBridgeObjectPath = ""
    req.compileMode = ""
    req.backendKind = creq.CompilerBackendPrimary
    req.jobCount = 1
    req.providerObjectPaths = []
    req.runtimeProviderBundle = ""
    creq.CompilerRequestSeal(req)
    return BuildSystemLinkExecPlanWithWorldAndChannel(rootDir, req, requestedWorldHead, lockPath, baselineSurfacePath, channelRaw)

@borrows
fn BuildSystemLinkExecPlanWithWorld(rootDir: str,
                                      req: creq.CompilerRequest,
                                      requestedWorldHead: str,
                                      lockPath: str,
                                      baselineSurfacePath: str): Result[SystemLinkExecPlan] =
    return BuildSystemLinkExecPlanWithWorldAndChannel(rootDir, req, requestedWorldHead, lockPath, baselineSurfacePath, cworld.CompilerWorldDefaultChannel())

@borrows
fn BuildSystemLinkExecPlan(rootDir: str,
                             req: creq.CompilerRequest): Result[SystemLinkExecPlan] =
    return BuildSystemLinkExecPlanWithWorld(rootDir, req, "", "", "")

@borrows
fn SystemLinkExecPlanReady(plan: var SystemLinkExecPlan): bool =
    var productionAdmissionErr: str
    return plan.readyCode == 1 &&
        SystemLinkExecPlanCidChainStrictValidateInto(
            plan, productionAdmissionErr)

@borrows
fn SystemLinkExecReportAppendLine(out: var str, key: str, value: str) =
    out = Fmt"{out}{key}={value}\n"

@borrows
fn SystemLinkExecOwnerResourceTracePointReportAppend(
        out: var str,
        prefix: str,
        point: compilerlife.CompilerPayloadOwnerResourceTracePoint) =
    var releasedText = "0"
    var storageReleasedText = "0"
    if point.released:
        releasedText = "1"
    if point.storageReleased:
        storageReleasedText = "1"
    SystemLinkExecReportAppendLine(
        out,
        Fmt"{prefix}_monotonic_timestamp_ns",
        strings.Int64ToStr(point.monotonicTimestampNs))
    SystemLinkExecReportAppendLine(
        out,
        Fmt"{prefix}_owner_token",
        layout.FixedBytes32Hex(point.ownerToken))
    SystemLinkExecReportAppendLine(
        out,
        Fmt"{prefix}_logical_bytes",
        strings.Int64ToStr(point.logicalBytes))
    SystemLinkExecReportAppendLine(
        out,
        Fmt"{prefix}_retained_bytes",
        strings.Int64ToStr(point.retainedBytes))
    SystemLinkExecReportAppendLine(
        out,
        Fmt"{prefix}_physical_buffer_count",
        strings.IntToStr(point.physicalBufferCount))
    SystemLinkExecReportAppendLine(
        out,
        Fmt"{prefix}_alloc_count",
        strings.Int64ToStr(point.allocCount))
    SystemLinkExecReportAppendLine(
        out,
        Fmt"{prefix}_allocated_bytes",
        strings.Int64ToStr(point.allocatedBytes))
    SystemLinkExecReportAppendLine(
        out,
        Fmt"{prefix}_release_count",
        strings.Int64ToStr(point.releaseCount))
    SystemLinkExecReportAppendLine(
        out,
        Fmt"{prefix}_released_bytes",
        strings.Int64ToStr(point.releasedBytes))
    SystemLinkExecReportAppendLine(
        out,
        Fmt"{prefix}_live_count",
        strings.Int64ToStr(point.liveCount))
    SystemLinkExecReportAppendLine(
        out,
        Fmt"{prefix}_released",
        releasedText)
    SystemLinkExecReportAppendLine(
        out,
        Fmt"{prefix}_storage_released",
        storageReleasedText)

@borrows
fn SystemLinkExecOwnerResourceTraceReportAppend(
        out: var str,
        prefix: str,
        trace: compilerlife.CompilerPayloadOwnerResourceTrace) =
    var completeText = "0"
    if trace.complete:
        completeText = "1"
    SystemLinkExecReportAppendLine(
        out,
        Fmt"{prefix}_schema",
        "cheng.compiler.owner_resource_trace")
    SystemLinkExecOwnerResourceTracePointReportAppend(
        out,
        Fmt"{prefix}_before",
        trace.before)
    SystemLinkExecOwnerResourceTracePointReportAppend(
        out,
        Fmt"{prefix}_after",
        trace.after)
    SystemLinkExecReportAppendLine(
        out,
        Fmt"{prefix}_complete",
        completeText)

@borrows
fn SystemLinkExecExactFunctionCoverageReportAppend(out: var str,
                                                    coverage: SystemLinkExecExactFunctionCoverage) =
    if !coverage.requested:
        return
    var capturedText = "0"
    if coverage.bodyIrCapturedBeforeRelease:
        capturedText = "1"
    SystemLinkExecReportAppendLine(out, "exact_function_codegen_schema", "exact_function_codegen")
    SystemLinkExecReportAppendLine(out, "exact_function_codegen_status", "captured")
    SystemLinkExecReportAppendLine(out, "exact_function_codegen_scope", "actual_codegen_exact_function")
    SystemLinkExecReportAppendLine(out, "exact_function_codegen_executes_codegen", "1")
    SystemLinkExecReportAppendLine(out, "exact_function_entry_source_path", coverage.entrySourcePath)
    SystemLinkExecReportAppendLine(out, "exact_function_target_source_path", coverage.targetSourcePath)
    SystemLinkExecReportAppendLine(out, "exact_function_target_triple", coverage.targetTriple)
    SystemLinkExecReportAppendLine(out, "exact_function_driver_path", coverage.driverPath)
    SystemLinkExecReportAppendLine(out, "exact_function_name", coverage.functionName)
    SystemLinkExecReportAppendLine(out, "exact_function_match_count", strings.IntToStr(coverage.functionMatchCount))
    SystemLinkExecReportAppendLine(out, "exact_function_index", strings.IntToStr(coverage.functionIndex))
    SystemLinkExecReportAppendLine(out, "exact_function_signature_line", strings.IntToStr(coverage.signatureLine))
    SystemLinkExecReportAppendLine(out, "exact_function_statement_count", strings.IntToStr(coverage.statementCount))
    SystemLinkExecReportAppendLine(out, "exact_function_node_start", strings.IntToStr(coverage.nodeStart))
    SystemLinkExecReportAppendLine(out, "exact_function_node_count", strings.IntToStr(coverage.nodeCount))
    SystemLinkExecReportAppendLine(out, "exact_function_span_owned_count", strings.IntToStr(coverage.spanOwnedCount))
    SystemLinkExecReportAppendLine(out, "exact_function_outside_span_owned_count", strings.IntToStr(coverage.outsideSpanOwnedCount))
    SystemLinkExecReportAppendLine(out, "exact_function_total_nodes2_count", strings.IntToStr(coverage.totalNodeCount))
    SystemLinkExecReportAppendLine(out, "exact_function_primary_match_count", strings.IntToStr(coverage.primaryMatchCount))
    SystemLinkExecReportAppendLine(out, "exact_function_body_ir_capture_before_release", capturedText)
    SystemLinkExecReportAppendLine(out, "exact_function_body_ir_op_count", strings.IntToStr(coverage.bodyIrOpCount))
    SystemLinkExecReportAppendLine(out, "exact_function_body_ir_term_count", strings.IntToStr(coverage.bodyIrTermCount))
    SystemLinkExecReportAppendLine(out, "exact_function_body_ir_block_count", strings.IntToStr(coverage.bodyIrBlockCount))
    SystemLinkExecReportAppendLine(out, "exact_function_body_ir_local_slot_count", strings.IntToStr(coverage.bodyIrLocalSlotCount))
    SystemLinkExecReportAppendLine(out, "exact_function_output_kind", coverage.outputKind)
    SystemLinkExecReportAppendLine(out, "exact_function_output_path", coverage.outputPath)

@borrows
fn SystemLinkExecPhaseMemoryReportAppendPhase(out: var str,
                                              phase: str,
                                              delta: SystemLinkExecPhaseMemoryDelta) =
    let rssBefore = delta.before.rssBytes
    let rssAfter = delta.after.rssBytes
    let structuredBefore = delta.before.structuredBytes
    let structuredAfter = delta.after.structuredBytes
    let gapBefore =
        SystemLinkExecPhaseMemoryDiagnosticRssMinusReportedBytes(rssBefore,
                                                                  structuredBefore)
    let gapAfter =
        SystemLinkExecPhaseMemoryDiagnosticRssMinusReportedBytes(rssAfter,
                                                                  structuredAfter)
    SystemLinkExecReportAppendLine(out, Fmt"phase_{phase}_rss_before_bytes", strings.Int64ToStr(rssBefore))
    SystemLinkExecReportAppendLine(out, Fmt"phase_{phase}_rss_after_bytes", strings.Int64ToStr(rssAfter))
    SystemLinkExecReportAppendLine(out, Fmt"phase_{phase}_rss_delta_bytes", strings.Int64ToStr(rssAfter - rssBefore))
    SystemLinkExecReportAppendLine(out, Fmt"phase_{phase}_structured_before_bytes", strings.Int64ToStr(structuredBefore))
    SystemLinkExecReportAppendLine(out, Fmt"phase_{phase}_structured_after_bytes", strings.Int64ToStr(structuredAfter))
    SystemLinkExecReportAppendLine(out, Fmt"phase_{phase}_structured_delta_bytes", strings.Int64ToStr(structuredAfter - structuredBefore))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_compiler_csg_logical_before_bytes",
                                   strings.Int64ToStr(delta.before.compilerCsgLogicalBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_compiler_csg_logical_after_bytes",
                                   strings.Int64ToStr(delta.after.compilerCsgLogicalBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_compiler_csg_retained_capacity_before_bytes",
                                   strings.Int64ToStr(delta.before.compilerCsgRetainedCapacityBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_compiler_csg_retained_capacity_after_bytes",
                                   strings.Int64ToStr(delta.after.compilerCsgRetainedCapacityBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_lowering_structured_before_bytes",
                                   strings.Int64ToStr(delta.before.loweringStructuredBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_lowering_structured_after_bytes",
                                   strings.Int64ToStr(delta.after.loweringStructuredBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_primary_structured_before_bytes",
                                   strings.Int64ToStr(delta.before.primaryStructuredBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_primary_structured_after_bytes",
                                   strings.Int64ToStr(delta.after.primaryStructuredBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_rss_minus_module_reported_diagnostic_before_bytes",
                                   strings.Int64ToStr(gapBefore))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_rss_minus_module_reported_diagnostic_after_bytes",
                                   strings.Int64ToStr(gapAfter))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_rss_minus_module_reported_diagnostic_delta_bytes",
                                   strings.Int64ToStr(gapAfter - gapBefore))
    # Phase memory owner breakdown (memory line w49 ④).  The allocator
    # SMALL-tier diagnostic is emitted as before/after/delta so it cannot be
    # mistaken for an exact semantic owner or for live bytes.
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_owner_process_runtime_baseline_bytes",
                                   strings.Int64ToStr(delta.after.ownerBreakdown.processRuntimeBaselineBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_owner_allocator_runtime_metadata_bytes",
                                   strings.Int64ToStr(delta.after.ownerBreakdown.allocatorRuntimeMetadataBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_owner_typed_fact_intern_payload_bytes",
                                   strings.Int64ToStr(delta.after.ownerBreakdown.typedFactInternPayloadBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_owner_allocator_small_tier_dirty_before_bytes",
                                   strings.Int64ToStr(delta.before.ownerBreakdown.allocatorSmallTierDirtyDiagnosticBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_owner_allocator_small_tier_dirty_after_bytes",
                                   strings.Int64ToStr(delta.after.ownerBreakdown.allocatorSmallTierDirtyDiagnosticBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_owner_allocator_small_tier_dirty_delta_bytes",
                                   strings.Int64ToStr(delta.after.ownerBreakdown.allocatorSmallTierDirtyDiagnosticBytes - delta.before.ownerBreakdown.allocatorSmallTierDirtyDiagnosticBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_owner_thread_stacks_bytes",
                                   strings.Int64ToStr(delta.after.ownerBreakdown.threadStacksBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_owner_device_allocations_bytes",
                                   strings.Int64ToStr(delta.after.ownerBreakdown.deviceAllocationsBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_owner_linker_allocations_bytes",
                                   strings.Int64ToStr(delta.after.ownerBreakdown.linkerAllocationsBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_owner_codegen_provider_allocations_bytes",
                                   strings.Int64ToStr(delta.after.ownerBreakdown.codegenProviderAllocationsBytes))
    SystemLinkExecReportAppendLine(out,
                                   Fmt"phase_{phase}_owner_method_map",
                                   "process_runtime_baseline=measured allocator_runtime_metadata=not_modeled_no_runtime_byte_counter typed_fact_intern_payload=module_reported allocator_small_tier_dirty=derived_rss_minus_audited_owners_diagnostic_not_live_bytes thread_stacks=model_1plus_workers_x64k device_allocations=zero_pipeline_fact linker_allocations=measured_elsewhere_phase_rss_delta codegen_provider_allocations=measured_elsewhere_phase_rss_delta")
    SystemLinkExecReportAppendLine(out, Fmt"phase_{phase}_top0_kind", delta.top0Kind)
    SystemLinkExecReportAppendLine(out, Fmt"phase_{phase}_top0_count", strings.IntToStr(delta.top0Count))
    SystemLinkExecReportAppendLine(out, Fmt"phase_{phase}_top0_bytes", strings.Int64ToStr(delta.top0Bytes))
    SystemLinkExecReportAppendLine(out, Fmt"phase_{phase}_top1_kind", delta.top1Kind)
    SystemLinkExecReportAppendLine(out, Fmt"phase_{phase}_top1_count", strings.IntToStr(delta.top1Count))
    SystemLinkExecReportAppendLine(out, Fmt"phase_{phase}_top1_bytes", strings.Int64ToStr(delta.top1Bytes))

@borrows
fn SystemLinkExecPhaseMemoryLedgerReportAppend(out: var str,
                                               ledger: SystemLinkExecPhaseMemoryLedger) =
    SystemLinkExecReportAppendLine(out, "phase_memory_ledger_schema", "phase_delta_ledger")
    SystemLinkExecReportAppendLine(out,
                                   "phase_memory_structured_measurement_scope",
                                   "module_reported_logical_or_retained_capacity")
    SystemLinkExecReportAppendLine(out, "phase_memory_structured_is_rss", "0")
    SystemLinkExecReportAppendLine(out,
                                   "phase_memory_structured_rss_gate_eligible",
                                   "0")
    SystemLinkExecPhaseMemoryReportAppendPhase(out,
                                               "csg_to_lowering_and_backend_release",
                                               ledger.csgToLoweringAndBackendRelease)
    SystemLinkExecPhaseMemoryReportAppendPhase(out, "lowering_pre_release", ledger.loweringPreRelease)
    SystemLinkExecPhaseMemoryReportAppendPhase(out, "primary_build", ledger.primaryBuild)
    SystemLinkExecPhaseMemoryReportAppendPhase(out, "primary_release", ledger.primaryRelease)
    SystemLinkExecPhaseMemoryReportAppendPhase(out, "report_payload_assembly", ledger.reportPayloadAssembly)
    # Same-compilation merkle decode memo statistics (memory line w49 ①):
    # rows/hits/misses describe exactly this compilation because the memo is
    # reset at plan-build entry.
    let memoStats = merkle_store_codec.CsgCoreMerkleStoreDecodeMemoStatsGet()
    SystemLinkExecReportAppendLine(out, "merkle_decode_memo_schema", "same_compilation_content_addressed_v1")
    SystemLinkExecReportAppendLine(out, "merkle_decode_memo_reset_count", strings.Int64ToStr(memoStats.resets))
    SystemLinkExecReportAppendLine(out, "merkle_decode_memo_head_rows", strings.Int64ToStr(memoStats.headRowCount))
    SystemLinkExecReportAppendLine(out, "merkle_decode_memo_head_hits", strings.Int64ToStr(memoStats.headHits))
    SystemLinkExecReportAppendLine(out, "merkle_decode_memo_head_misses", strings.Int64ToStr(memoStats.headMisses))
    SystemLinkExecReportAppendLine(out, "merkle_decode_memo_receipt_rows", strings.Int64ToStr(memoStats.receiptRowCount))
    SystemLinkExecReportAppendLine(out, "merkle_decode_memo_receipt_hits", strings.Int64ToStr(memoStats.receiptHits))
    SystemLinkExecReportAppendLine(out, "merkle_decode_memo_receipt_misses", strings.Int64ToStr(memoStats.receiptMisses))

@borrows
fn SystemLinkExecBrowserBridgeReport(plan: SystemLinkExecPlan): str =
    let bridgePlans = ccsg.CompilerBrowserAbiBridgePlansForLinkPlan(plan.systemLinkPlan)
    let bridgeArtifactPath = SystemLinkExecBrowserBridgeArtifactPath(plan)
    let bridgeSourcePath = SystemLinkExecBrowserBridgeSourcePath(plan)
    let bridgeObjectPath = SystemLinkExecBrowserBridgeObjectPath(plan)
    var bridgeArtifactPathText = "-"
    var bridgeSourcePathText = "-"
    var bridgeObjectPathText = "-"
    var bridgeObjectCount: int32
    if len(bridgeArtifactPath) > 0:
        bridgeArtifactPathText = bridgeArtifactPath
    if len(bridgeSourcePath) > 0:
        bridgeSourcePathText = bridgeSourcePath
    if len(bridgeObjectPath) > 0:
        bridgeObjectPathText = bridgeObjectPath
        bridgeObjectCount = 1
    var lines = ""
    for i in 0..<bridgePlans.len:
        lines = Fmt"{lines}browser_bridge_plan[{strings.IntToStr(i)}]={bridgePlans[i].emitLine}\n"
    var out = ""
    SystemLinkExecReportAppendLine(out, "browser_bridge_artifact_path", bridgeArtifactPathText)
    SystemLinkExecReportAppendLine(out, "browser_bridge_artifact_format", barule.BrowserAbiBridgePlanManifestFormat())
    SystemLinkExecReportAppendLine(out, "browser_bridge_artifact_count", strings.IntToStr(bridgePlans.len))
    SystemLinkExecReportAppendLine(out, "browser_bridge_artifact_unique_key_count", strings.IntToStr(barule.BrowserAbiBridgePlanUniqueKeyCount(bridgePlans)))
    SystemLinkExecReportAppendLine(out, "browser_bridge_source_path", bridgeSourcePathText)
    SystemLinkExecReportAppendLine(out, "browser_bridge_source_format", barule.BrowserAbiBridgeSourceFormat())
    SystemLinkExecReportAppendLine(out, "browser_bridge_source_count", strings.IntToStr(bridgePlans.len))
    SystemLinkExecReportAppendLine(out, "browser_bridge_object_path", bridgeObjectPathText)
    SystemLinkExecReportAppendLine(out, "browser_bridge_object_count", strings.IntToStr(bridgeObjectCount))
    SystemLinkExecReportAppendLine(out, "browser_bridge_plan_count", strings.IntToStr(bridgePlans.len))
    SystemLinkExecReportAppendLine(out, "browser_bridge_plan_unique_key_count", strings.IntToStr(barule.BrowserAbiBridgePlanUniqueKeyCount(bridgePlans)))
    out = Fmt"{out}{lines}"
    return out

fn SystemLinkExecPlanReportBorrowed(plan: var SystemLinkExecPlan): str =
    if plan.readyCode == 1:
        var sourceBundleReceiptErr: str
        if !SystemLinkExecPlanCidChainStrictValidateInto(
                plan,
                sourceBundleReceiptErr):
            panic(sourceBundleReceiptErr)
    var reportPayloadAssemblyBefore: SystemLinkExecPhaseMemorySnapshot
    var reportPayloadAssemblyAfter: SystemLinkExecPhaseMemorySnapshot
    # A not-ready plan has executed no phase, so its memory ledger is exactly
    # zero.  Skipping the retained-capacity refresh on the not-ready report
    # path avoids the large multi-megabyte accounting frames without changing
    # any authoritative number.
    if plan.readyCode == 1:
        reportPayloadAssemblyBefore = SystemLinkExecPhaseMemorySnapshotFromPlan(plan)
    var worldHeadPinned = "0"
    var lockCheckEnabled = "0"
    var lockVerified = "0"
    var baselineSurfaceChecked = "0"
    var baselineSurfaceCompatible = "0"
    var lockPath = "-"
    var baselineSurfacePath = "-"
    var primaryObjectPath = "-"
    var nativeOutputKind = "artifact"
    var nativePrimaryObject = "-"
    var browserBridgeObject = "-"
    var nativeEntrySymbol = "-"
    if plan.worldHeadPinned:
        worldHeadPinned = "1"
    if plan.lockCheckEnabled:
        lockCheckEnabled = "1"
    if plan.lockVerified:
        lockVerified = "1"
    if plan.baselineSurfaceChecked:
        baselineSurfaceChecked = "1"
    if plan.baselineSurfaceCompatible:
        baselineSurfaceCompatible = "1"
    if len(plan.lockPath) > 0:
        lockPath = plan.lockPath
    if len(plan.baselineSurfacePath) > 0:
        baselineSurfacePath = plan.baselineSurfacePath
    if len(plan.objectPlan.primaryObjectPath) > 0:
        primaryObjectPath = plan.objectPlan.primaryObjectPath
    if plan.nativeLinkPlan.outputKind == nplan.NativeOutputExecutable:
        nativeOutputKind = "executable"
    if len(plan.nativeLinkPlan.primaryObjectPath) > 0:
        nativePrimaryObject = plan.nativeLinkPlan.primaryObjectPath
    if len(plan.nativeLinkPlan.browserBridgeObjectPath) > 0:
        browserBridgeObject = plan.nativeLinkPlan.browserBridgeObjectPath
    if len(plan.nativeLinkPlan.entrySymbol) > 0:
        nativeEntrySymbol = plan.nativeLinkPlan.entrySymbol
    var linuxNolibcSupportEnabled = "0"
    var linuxNolibcRuntimeSource = "-"
    var linuxNolibcRuntimeObject = "-"
    var linuxNolibcStartupSource = "-"
    var linuxNolibcStartupObject = "-"
    if plan.objectPlan.linuxNolibcSupportEnabled:
        linuxNolibcSupportEnabled = "1"
    if len(plan.objectPlan.linuxNolibcRuntimeSourcePath) > 0:
        linuxNolibcRuntimeSource = plan.objectPlan.linuxNolibcRuntimeSourcePath
    if len(plan.objectPlan.linuxNolibcRuntimeObjectPath) > 0:
        linuxNolibcRuntimeObject = plan.objectPlan.linuxNolibcRuntimeObjectPath
    if len(plan.objectPlan.linuxNolibcStartupSourcePath) > 0:
        linuxNolibcStartupSource = plan.objectPlan.linuxNolibcStartupSourcePath
    if len(plan.objectPlan.linuxNolibcStartupObjectPath) > 0:
        linuxNolibcStartupObject = plan.objectPlan.linuxNolibcStartupObjectPath
    let browserBridgeReport = SystemLinkExecBrowserBridgeReport(plan)
    var out = ""
    SystemLinkExecReportAppendLine(out, "entry", plan.compilerEntrySource)
    SystemLinkExecReportAppendLine(
        out,
        "request_backend",
        creq.CompilerBackendKindText(plan.requestBackendKind))
    SystemLinkExecReportAppendLine(
        out,
        "request_backend_jobs",
        strings.IntToStr(plan.requestedJobCount))
    SystemLinkExecReportAppendLine(
        out,
        "request_emit",
        creq.CompilerEmitText(plan.requestEmitKind))
    SystemLinkExecReportAppendLine(
        out,
        "backend_request_action_cid",
        layout.FixedBytes32Hex(plan.backendRequestActionCid))
    SystemLinkExecReportAppendLine(
        out,
        "backend_request_cid",
        layout.FixedBytes32Hex(plan.backendRequestCid))
    if plan.compositionManifestSchema.len > 0:
        SystemLinkExecReportAppendLine(
            out,
            "composition_manifest_schema",
            plan.compositionManifestSchema)
        SystemLinkExecReportAppendLine(
            out,
            "composition_manifest_sha256",
            plan.compositionManifestSha256)
        let kernelManifestSha256 =
            plan.compositionKernelManifestSha256.len > 0 ?
                strings.CloneStr(
                    plan.compositionKernelManifestSha256) : "-"
        SystemLinkExecReportAppendLine(
            out,
            "composition_kernel_manifest_sha256",
            kernelManifestSha256)
        SystemLinkExecReportAppendLine(
            out,
            "composition_kind",
            plan.compositionKind)
        SystemLinkExecReportAppendLine(
            out,
            "composition_entry_source",
            plan.compositionEntrySource)
        let pluginTriple =
            plan.compositionPluginCanonicalTriple.len > 0 ?
                strings.CloneStr(
                    plan.compositionPluginCanonicalTriple) : "-"
        SystemLinkExecReportAppendLine(
            out,
            "composition_plugin_canonical_triple",
            pluginTriple)
        SystemLinkExecReportAppendLine(
            out,
            "composition_declared_source_count",
            strings.IntToStr(
                plan.compositionDeclaredSourceCount))
        SystemLinkExecReportAppendLine(
            out,
            "composition_declared_sources_sha256",
            plan.compositionDeclaredSourcesSha256)
        SystemLinkExecReportAppendLine(
            out,
            "composition_source_closure_count",
            strings.IntToStr(
                plan.compositionSourceClosureCount))
        SystemLinkExecReportAppendLine(
            out,
            "composition_source_closure_sha256",
            plan.compositionSourceClosureSha256)
        SystemLinkExecReportAppendLine(
            out,
            "composition_source_identity_receipt_cid",
            layout.FixedBytes32Hex(
                plan.compositionSourceIdentityReceiptCid))
    SystemLinkExecReportAppendLine(out, "plan_ready_code", strings.IntToStr(plan.readyCode))
    SystemLinkExecReportAppendLine(out, "plan_not_ready_code", strings.IntToStr(plan.notReadyCode))
    SystemLinkExecReportAppendLine(out, "plan_not_ready_reason", plan.notReadyReason)
    SystemLinkExecReportAppendLine(out,
                                   "source_bundle_cid",
                                   layout.FixedBytes32Hex(
                                       plan.sourceBundleReceipt.sourceBundleCid))
    SystemLinkExecReportAppendLine(out,
                                   "source_manifest_sha256",
                                   layout.FixedBytes32Hex(
                                       plan.sourceBundleReceipt.sourceBundleCid))
    SystemLinkExecReportAppendLine(out,
                                   "source_bundle_entry_source_index",
                                   strings.IntToStr(
                                       plan.sourceBundleReceipt.entrySourceIndex))
    SystemLinkExecReportAppendLine(out,
                                   "source_bundle_binding_seal",
                                   layout.FixedBytes32Hex(
                                       plan.sourceBundleReceipt.bindingSeal))
    SystemLinkExecReportAppendLine(out,
                                   "source_bundle_entry_identity_seal",
                                   layout.FixedBytes32Hex(
                                       plan.sourceBundleReceipt.entryIdentitySeal))
    SystemLinkExecReportAppendLine(out,
                                   "source_bundle_receipt_seal",
                                   layout.FixedBytes32Hex(
                                       plan.sourceBundleReceipt.receiptSeal))
    SystemLinkExecReportAppendLine(out,
                                   "source_bundle_closure_count",
                                   strings.IntToStr(
                                       plan.sourceBundleReceipt.sourceClosureCount))
    SystemLinkExecReportAppendLine(out,
                                   "source_bundle_identity_count",
                                   strings.IntToStr(
                                       plan.sourceBundleReceipt.sourceIdentityCount))
    SystemLinkExecReportAppendLine(out,
                                   "source_bundle_owner_count",
                                   strings.IntToStr(
                                       plan.sourceBundleReceipt.ownerModuleCount))
    SystemLinkExecReportAppendLine(out,
                                   "source_bundle_import_edge_count",
                                   strings.IntToStr(
                                       plan.sourceBundleReceipt.importEdgeCount))
    SystemLinkExecReportAppendLine(out,
                                   "source_bundle_unresolved_import_count",
                                   strings.IntToStr(
                                       plan.sourceBundleReceipt.unresolvedImportCount))
    SystemLinkExecReportAppendLine(out,
                                   "source_bundle_receipt_fixed_bytes",
                                   strings.Int64ToStr(
                                       SystemLinkExecSourceBundleReceiptFixedLiveBytes()))
    SystemLinkExecReportAppendLine(out,
                                   "source_bundle_receipt_managed_live_bytes",
                                   "0")
    SystemLinkExecReportAppendLine(out,
                                   "source_snapshot_count",
                                   strings.IntToStr(
                                       plan.sourceBundleReceipt.sourceClosureCount))
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_source_snapshot_count",
        strings.IntToStr(plan.sourceBundleReceipt.sourceClosureCount))
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_import_edge_count",
        strings.IntToStr(plan.sourceBundleReceipt.importEdgeCount))
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_unresolved_import_count",
        strings.IntToStr(plan.sourceBundleReceipt.unresolvedImportCount))
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_source_package_id_cid",
        layout.FixedBytes32Hex(
            plan.sourceBundleReceipt.sourcePackageIdCid))
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_entry_module_path_cid",
        layout.FixedBytes32Hex(
            plan.sourceBundleReceipt.entryModulePathCid))
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_import_graph_cid",
        layout.FixedBytes32Hex(plan.sourceBundleReceipt.importGraphCid))
    SystemLinkExecReportAppendLine(
        out,
        "entry_source_cid",
        layout.FixedBytes32Hex(plan.sourceBundleReceipt.entrySourceCid))
    SystemLinkExecReportAppendLine(out, "entry_mode", "unelaborated")
    SystemLinkExecReportAppendLine(out, "canonical_compiler_csg_cid", layout.FixedBytes32Hex(plan.compilerCsg.canonicalGraphCid))
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_cid",
        layout.FixedBytes32Hex(
            plan.sourceBundleReceipt.sourceIdentityReceiptCid))
    SystemLinkExecReportAppendLine(out, "semantic_receipt_cid", layout.FixedBytes32Hex(plan.semanticReceipt.receiptCid))
    SystemLinkExecReportAppendLine(out, "source_to_csg_binding_seal", layout.FixedBytes32Hex(plan.sourceToCsgBindingSeal))
    SystemLinkExecReportAppendLine(out, "semantic_canonical_output_digest", layout.FixedBytes32Hex(plan.semanticReceipt.canonicalOutputDigest))
    SystemLinkExecReportAppendLine(out, "compiler_csg_cid", layout.FixedBytes32Hex(plan.compilerCsg.graphCid))
    SystemLinkExecReportAppendLine(out, "compiler_csg_node_count", strings.IntToStr(plan.compilerCsg.nodeCount))
    SystemLinkExecReportAppendLine(out, "compiler_csg_edge_count", strings.IntToStr(plan.compilerCsg.edgeCount))
    SystemLinkExecReportAppendLine(out, "compiler_csg_typed_ir_function_count", strings.IntToStr(plan.compilerCsgTypedIrFunctionCount))
    SystemLinkExecReportAppendLine(out, "compiler_csg_typed_ir_node_count", strings.IntToStr(plan.compilerCsgTypedIrNodeCount))
    SystemLinkExecReportAppendLine(out, "compiler_csg_typed_ir_statement_count", strings.IntToStr(plan.compilerCsgTypedIrStatementCount))
    SystemLinkExecReportAppendLine(out, "compiler_csg_typed_expr_fact_count", strings.IntToStr(plan.compilerCsgTypedExprFactCount))
    SystemLinkExecReportAppendLine(out, "compiler_csg_expr_layer_expr_count", strings.IntToStr(plan.compilerCsgExprLayerExprCount))
    SystemLinkExecReportAppendLine(out, "compiler_csg_rss_bytes", strings.Int64ToStr(plan.compilerCsgRssBytes))
    SystemLinkExecReportAppendLine(
        out,
        "compiler_csg_logical_payload_bytes",
        strings.Int64ToStr(plan.compilerCsgLogicalPayloadBytes))
    SystemLinkExecReportAppendLine(out, "compiler_csg_nodes_live_bytes", strings.Int64ToStr(plan.compilerCsgNodesLiveBytes))
    SystemLinkExecReportAppendLine(out, "compiler_csg_edges_live_bytes", strings.Int64ToStr(plan.compilerCsgEdgesLiveBytes))
    SystemLinkExecReportAppendLine(out, "compiler_csg_expr_layer_live_bytes", strings.Int64ToStr(plan.compilerCsgExprLayerLiveBytes))
    SystemLinkExecReportAppendLine(out, "compiler_csg_typed_facts_live_bytes", strings.Int64ToStr(plan.compilerCsgTypedFactsLiveBytes))
    SystemLinkExecReportAppendLine(out, "compiler_csg_typed_ir_live_bytes", strings.Int64ToStr(plan.compilerCsgTypedIrLiveBytes))
    SystemLinkExecReportAppendLine(out, "compiler_csg_metadata_live_bytes", strings.Int64ToStr(plan.compilerCsgMetadataLiveBytes))
    SystemLinkExecReportAppendLine(out, "compiler_csg_source_text_live_bytes", strings.Int64ToStr(plan.compilerCsgSourceTextLiveBytes))
    SystemLinkExecReportAppendLine(out, "compiler_csg_rss_gap_bytes", strings.Int64ToStr(plan.compilerCsgRssGapBytes))
    SystemLinkExecReportAppendLine(out, "compiler_csg_typed_ir_round_count", strings.IntToStr(plan.compilerCsgTypedIrRoundCount))
    SystemLinkExecReportAppendLine(out, "compiler_csg_typed_ir_rebuild_source_count", strings.IntToStr(plan.compilerCsgTypedIrRebuildSourceCount))
    SystemLinkExecReportAppendLine(out, "compiler_csg_typed_ir_new_function_count", strings.IntToStr(plan.compilerCsgTypedIrNewFunctionCount))
    SystemLinkExecReportAppendLine(out, "compiler_csg_first_function_signature_line", strings.IntToStr(plan.compilerCsgFirstFunctionSignatureLine))
    SystemLinkExecReportAppendLine(out, "compiler_csg_first_function_body_line", strings.IntToStr(plan.compilerCsgFirstFunctionBodyLine))
    SystemLinkExecReportAppendLine(out, "compiler_csg_first_function_node_count", strings.IntToStr(plan.compilerCsgFirstFunctionNodeCount))
    SystemLinkExecReportAppendLine(out, "compiler_csg_first_function_statement_count", strings.IntToStr(plan.compilerCsgFirstFunctionStatementCount))
    SystemLinkExecReportAppendLine(out, "compiler_csg_first_function_return_node_index", strings.IntToStr(plan.compilerCsgFirstFunctionReturnNodeIndex))
    SystemLinkExecReportAppendLine(out, "compiler_csg_first_function_return_type_code", strings.IntToStr(plan.compilerCsgFirstFunctionReturnTypeCode))
    SystemLinkExecReportAppendLine(out, "compiler_csg_first_function_return_expr_code", strings.IntToStr(plan.compilerCsgFirstFunctionReturnExprCode))
    SystemLinkExecReportAppendLine(out, "compiler_csg_first_function_return_expr_len", strings.IntToStr(plan.compilerCsgFirstFunctionReturnExprLen))
    SystemLinkExecReportAppendLine(out, "compiler_csg_first_function_return_expr_first_byte", strings.IntToStr(plan.compilerCsgFirstFunctionReturnExprFirstByte))
    SystemLinkExecReportAppendLine(out, "compiler_csg_first_function_return_expr_last_byte", strings.IntToStr(plan.compilerCsgFirstFunctionReturnExprLastByte))
    SystemLinkExecReportAppendLine(out, "export_surface_cid", layout.FixedBytes32Hex(plan.exportSurface.surfaceCid))
    SystemLinkExecReportAppendLine(out, "export_surface_symbol_count", strings.IntToStr(plan.exportSurface.exportedSymbolCount))
    SystemLinkExecReportAppendLine(out, "world_head_cid", layout.FixedBytes32Hex(plan.localUniverse.worldHead.headCid))
    SystemLinkExecReportAppendLine(out, "compiler_pkg_cid", layout.FixedBytes32Hex(plan.localUniverse.compilerSnapshot.snapshotCid))
    SystemLinkExecReportAppendLine(out, "std_pkg_cid", layout.FixedBytes32Hex(plan.localUniverse.stdSnapshot.snapshotCid))
    SystemLinkExecReportAppendLine(out, "runtime_pkg_cid", layout.FixedBytes32Hex(plan.localUniverse.runtimeSnapshot.snapshotCid))
    SystemLinkExecReportAppendLine(out, "world_head_pinned", worldHeadPinned)
    SystemLinkExecReportAppendLine(out, "lock_check_enabled", lockCheckEnabled)
    SystemLinkExecReportAppendLine(out, "lock_verified", lockVerified)
    SystemLinkExecReportAppendLine(out, "lock_path", lockPath)
    SystemLinkExecReportAppendLine(out, "baseline_surface_checked", baselineSurfaceChecked)
    SystemLinkExecReportAppendLine(out, "baseline_surface_compatible", baselineSurfaceCompatible)
    SystemLinkExecReportAppendLine(out, "baseline_surface_path", baselineSurfacePath)
    SystemLinkExecReportAppendLine(out, "compile_receipt_cid", layout.FixedBytes32Hex(plan.compileReceipt.receiptCid))
    SystemLinkExecReportAppendLine(out, "compile_canonical_output_digest", layout.FixedBytes32Hex(plan.compileReceipt.canonicalOutputDigest))
    SystemLinkExecReportAppendLine(out, "compile_output_digest", layout.FixedBytes32Hex(plan.compileReceipt.outputDigest))
    SystemLinkExecReportAppendLine(out, "compile_bootstrap_stage", plan.compileReceipt.bootstrapStage)
    SystemLinkExecReportAppendLine(out,
                                   "output_file_size_bytes",
                                   strings.Int64ToStr(chengpath.PathFileSize(plan.systemLinkPlan.outputPath)))
    let retainedPayloadDiagnosticEstimateBytes =
        SystemLinkExecPlanRetainedPayloadDiagnosticEstimateBytes(plan)
    # Compatibility field remains diagnostic-only; no budget or RSS gate may
    # consume it as an authoritative byte count.
    SystemLinkExecReportAppendLine(out,
                                   "exec_retained_payload_approx_bytes",
                                   strings.Int64ToStr(retainedPayloadDiagnosticEstimateBytes))
    SystemLinkExecReportAppendLine(out,
                                   "exec_retained_payload_approx_bytes_scope",
                                   "diagnostic_non_authoritative_not_rss")
    SystemLinkExecReportAppendLine(out,
                                   "exec_retained_payload_approx_bytes_gate_eligible",
                                   "0")
    SystemLinkExecReportAppendLine(out,
                                   "exec_retained_payload_diagnostic_estimate_bytes",
                                   strings.Int64ToStr(retainedPayloadDiagnosticEstimateBytes))
    SystemLinkExecReportAppendLine(out,
                                   "exec_retained_payload_diagnostic_estimate_scope",
                                   "non_authoritative_item_estimate_not_rss")
    SystemLinkExecReportAppendLine(out,
                                   "exec_retained_payload_diagnostic_estimate_gate_eligible",
                                   "0")
    SystemLinkExecReportAppendLine(out,
                                   "payload_lifecycle_system_link_expr_clone_count",
                                   strings.IntToStr(plan.payloadLifecycle.systemLinkExprCloneCount))
    SystemLinkExecReportAppendLine(out,
                                   "payload_lifecycle_system_link_expr_move_count",
                                   strings.IntToStr(plan.payloadLifecycle.systemLinkExprMoveCount))
    SystemLinkExecReportAppendLine(out,
                                   "payload_lifecycle_system_link_expr_consume_count",
                                   strings.IntToStr(plan.payloadLifecycle.systemLinkExprConsumeCount))
    SystemLinkExecReportAppendLine(out,
                                   "payload_lifecycle_compiler_csg_backend_release_count",
                                   strings.IntToStr(plan.payloadLifecycle.compilerCsgBackendReleaseCount))
    SystemLinkExecReportAppendLine(out,
                                   "payload_lifecycle_lowering_pre_primary_release_count",
                                   strings.IntToStr(plan.payloadLifecycle.loweringPrePrimaryReleaseCount))
    SystemLinkExecReportAppendLine(out,
                                   "payload_lifecycle_lowering_after_primary_release_count",
                                   strings.IntToStr(plan.payloadLifecycle.loweringAfterPrimaryReleaseCount))
    SystemLinkExecReportAppendLine(out,
                                   "payload_lifecycle_lowering_terminal_release_count",
                                   strings.IntToStr(plan.payloadLifecycle.loweringTerminalReleaseCount))
    SystemLinkExecReportAppendLine(out, "exec_retained_object_plan_item_count", strings.IntToStr(SystemLinkExecObjectPlanRetainedItemCount(plan.objectPlan)))
    SystemLinkExecReportAppendLine(out, "exec_retained_native_plan_item_count", strings.IntToStr(SystemLinkExecNativePlanRetainedItemCount(plan.nativeLinkPlan)))
    SystemLinkExecReportAppendLine(out, "exec_phase_system_link_plan_ms", SystemLinkExecPhaseMsText(plan.phaseProfile.systemLinkPlanNs))
    SystemLinkExecReportAppendLine(out, "exec_phase_source_bundle_ms", SystemLinkExecPhaseMsText(plan.phaseProfile.sourceBundleNs))
    SystemLinkExecReportAppendLine(out, "exec_phase_compiler_csg_ms", SystemLinkExecPhaseMsText(plan.phaseProfile.compilerCsgNs))
    SystemLinkExecReportAppendLine(out, "exec_phase_world_ms", SystemLinkExecPhaseMsText(plan.phaseProfile.worldNs))
    SystemLinkExecReportAppendLine(out, "exec_phase_lock_ms", SystemLinkExecPhaseMsText(plan.phaseProfile.lockNs))
    SystemLinkExecReportAppendLine(out, "exec_phase_baseline_ms", SystemLinkExecPhaseMsText(plan.phaseProfile.baselineNs))
    SystemLinkExecReportAppendLine(out, "exec_phase_lowering_plan_ms", SystemLinkExecPhaseMsText(plan.phaseProfile.loweringPlanNs))
    SystemLinkExecReportAppendLine(out, "exec_phase_primary_object_plan_ms", SystemLinkExecPhaseMsText(plan.phaseProfile.primaryObjectPlanNs))
    SystemLinkExecReportAppendLine(out, "exec_phase_provider_sources_ms", SystemLinkExecPhaseMsText(plan.phaseProfile.providerSourcesNs))
    SystemLinkExecReportAppendLine(out, "exec_phase_object_plan_ms", SystemLinkExecPhaseMsText(plan.phaseProfile.objectPlanNs))
    SystemLinkExecReportAppendLine(out, "exec_phase_native_link_plan_ms", SystemLinkExecPhaseMsText(plan.phaseProfile.nativeLinkPlanNs))
    SystemLinkExecReportAppendLine(out, "exec_phase_compile_receipt_ms", SystemLinkExecPhaseMsText(plan.phaseProfile.compileReceiptNs))
    SystemLinkExecReportAppendLine(out, "exec_phase_total_ms", SystemLinkExecPhaseMsText(plan.phaseProfile.totalNs))
    # [wall150] 分配器 live 三数（memline2c §7 共同第一步）：进程生命周期累计
    # 计数，live=当前在册托管块数。判定口径：进程级只增计数器，非 RSS。
    SystemLinkExecReportAppendLine(out, "allocator_live_block_count", strings.Int64ToStr(SystemLinkExecMmLiveCountBridge()))
    SystemLinkExecReportAppendLine(out, "allocator_alloc_block_total", strings.Int64ToStr(SystemLinkExecMmAllocCountBridge()))
    SystemLinkExecReportAppendLine(out, "allocator_free_block_total", strings.Int64ToStr(SystemLinkExecMmFreeCountBridge()))
    let loweringRequestedJobs = plan.loweringRequestedJobCount
    let loweringActiveWorkers = plan.loweringActiveWorkerCount
    let loweringCompletedWorkers = plan.loweringCompletedWorkerCount
    let loweringTaskCount = plan.loweringTaskCount
    var loweringParallelStatus = "none"
    if loweringTaskCount > 0:
        if loweringActiveWorkers > 1 && loweringCompletedWorkers == loweringActiveWorkers:
            loweringParallelStatus = "active"
        elif loweringActiveWorkers == 1 && loweringCompletedWorkers == 1:
            loweringParallelStatus = "serial"
        else:
            loweringParallelStatus = "inactive"
    SystemLinkExecReportAppendLine(out, "lowering_parallel_status", loweringParallelStatus)
    SystemLinkExecReportAppendLine(out, "lowering_parallel_job_count", strings.IntToStr(loweringActiveWorkers))
    SystemLinkExecReportAppendLine(out, "lowering_parallel_requested_job_count", strings.IntToStr(loweringRequestedJobs))
    SystemLinkExecReportAppendLine(out, "lowering_parallel_active_workers", strings.IntToStr(loweringActiveWorkers))
    SystemLinkExecReportAppendLine(out, "lowering_parallel_completed_workers", strings.IntToStr(loweringCompletedWorkers))
    SystemLinkExecReportAppendLine(out, "lowering_parallel_task_count", strings.IntToStr(loweringTaskCount))
    SystemLinkExecReportAppendLine(out, "lowering_parallel_merge_order", "decl_ordinal")
    out = Fmt"{out}{slplan.SystemLinkPlanStubReport(plan.systemLinkPlan)}\n"
    out = Fmt"{out}{lower.LoweringPlanStubReport(plan.loweringPlan)}\n"
    SystemLinkExecOwnerResourceTraceReportAppend(
        out,
        "compiler_csg_owner_resource_trace",
        plan.compilerCsgOwnerResourceTrace)
    SystemLinkExecOwnerResourceTraceReportAppend(
        out,
        "lowering_owner_resource_trace",
        plan.loweringPlan.ownerResourceTrace)
    out = Fmt"{out}{pobj.PrimaryObjectPlanReport(plan.primaryObjectPlan)}\n"
    out = Fmt"{out}{browserBridgeReport}"
    SystemLinkExecReportAppendLine(out, "primary_object_path", primaryObjectPath)
    SystemLinkExecReportAppendLine(out, "provider_object_count", strings.IntToStr(plan.objectPlan.providerObjectPaths.len))
    SystemLinkExecReportAppendLine(out, "provider_source_paths", slplan.SystemLinkPlanListText(plan.objectPlan.providerSourcePaths))
    SystemLinkExecReportAppendLine(out, "provider_object_paths", slplan.SystemLinkPlanListText(plan.objectPlan.providerObjectPaths))
    SystemLinkExecReportAppendLine(out, "linux_nolibc_support_enabled", linuxNolibcSupportEnabled)
    SystemLinkExecReportAppendLine(out, "linux_nolibc_runtime_source", linuxNolibcRuntimeSource)
    SystemLinkExecReportAppendLine(out, "linux_nolibc_runtime_object", linuxNolibcRuntimeObject)
    SystemLinkExecReportAppendLine(out, "linux_nolibc_startup_source", linuxNolibcStartupSource)
    SystemLinkExecReportAppendLine(out, "linux_nolibc_startup_object", linuxNolibcStartupObject)
    SystemLinkExecReportAppendLine(out, "browser_bridge_object", browserBridgeObject)
    SystemLinkExecReportAppendLine(out, "object_link_input_count", strings.IntToStr(plan.objectPlan.linkInputPaths.len))
    SystemLinkExecReportAppendLine(out, "object_link_inputs", slplan.SystemLinkPlanListText(plan.objectPlan.linkInputPaths))
    SystemLinkExecReportAppendLine(out, "object_missing_reasons", slplan.SystemLinkPlanListText(plan.objectPlan.missingReasons))
    SystemLinkExecReportAppendLine(out, "object_pipeline_stage", plan.objectPlan.pipelineStage)
    SystemLinkExecReportAppendLine(out, "native_object_format", plan.nativeLinkPlan.objectFormat)
    SystemLinkExecReportAppendLine(out, "native_linker_program", plan.nativeLinkPlan.linkerProgram)
    SystemLinkExecReportAppendLine(out, "native_linker_flavor", plan.nativeLinkPlan.linkerFlavor)
    SystemLinkExecReportAppendLine(out, "native_output_kind", nativeOutputKind)
    SystemLinkExecReportAppendLine(out, "native_primary_object", nativePrimaryObject)
    SystemLinkExecReportAppendLine(out, "native_link_input_count", strings.IntToStr(plan.nativeLinkPlan.linkInputPaths.len))
    SystemLinkExecReportAppendLine(out, "native_link_inputs", slplan.SystemLinkPlanListText(plan.nativeLinkPlan.linkInputPaths))
    SystemLinkExecReportAppendLine(out, "native_link_entry_symbol", nativeEntrySymbol)
    SystemLinkExecReportAppendLine(out, "native_link_missing_reasons", slplan.SystemLinkPlanListText(plan.nativeLinkPlan.missingReasons))
    SystemLinkExecReportAppendLine(out, "native_link_pipeline_stage", plan.nativeLinkPlan.pipelineStage)
    SystemLinkExecReportAppendLine(out, "cold_system_link_exec", "0")
    SystemLinkExecReportAppendLine(out, "system_link_exec_scope", "selfhost_direct")
    out = Fmt"{out}exec_pipeline_stage=primary_object_plan_to_native_link_plan\n"
    if plan.readyCode == 1:
        reportPayloadAssemblyAfter = SystemLinkExecPhaseMemorySnapshotFromPlan(plan)
        plan.phaseMemoryLedger.reportPayloadAssembly = SystemLinkExecPhaseMemoryDeltaFromPlan(reportPayloadAssemblyBefore,
                                                                                              reportPayloadAssemblyAfter,
                                                                                              plan)
    SystemLinkExecPhaseMemoryLedgerReportAppend(out, plan.phaseMemoryLedger)
    return out

fn SystemLinkExecPlanReport(plan: var SystemLinkExecPlan): str =
    return SystemLinkExecPlanReportBorrowed(plan)
