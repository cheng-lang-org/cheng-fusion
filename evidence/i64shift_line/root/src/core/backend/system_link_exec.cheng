# Append-only private Arena/SoA. A row is initialized once, published with a
# release store, consumed once, and never reused. The only identity crossing
# helper boundaries is handleRow:int32.
var systemLinkExecPlanEvidenceStates: atomic.I32[]
var systemLinkExecPlanEvidenceCommandCids: str[]
var systemLinkExecPlanEvidenceInputSetCids: str[]
var systemLinkExecPlanEvidenceOutputContractCids: str[]
var systemLinkExecPlanEvidenceCurrentHeadCids: str[]
var systemLinkExecPlanEvidenceManifestCids: str[]
var systemLinkExecPlanEvidenceCsgcObjectCids: str[]
var systemLinkExecPlanEvidenceFactsRootCids: str[]
var systemLinkExecPlanEvidenceProofCids: str[]
var systemLinkExecPlanEvidenceAuthorityReceiptCids: str[]
var systemLinkExecPlanEvidenceCanonicalBytes: str[]
var systemLinkExecPlanEvidenceReceiptCids: str[]
var systemLinkExecPlanEvidenceRegistryInit: int32

fn systemLinkExecPlanEvidenceRegistryReady(): bool =
    return system.RuntimeAtomicLoadI32(
        systemLinkExecPlanEvidenceRegistryInit) == 2

# The production child calls this once after immutable request/bundle
# validation and before CompilerMainRun can start any workload worker.  Plan
# issue is therefore never responsible for lazy initialization and can only
# observe the fully published SoA.
fn SystemLinkExecPlanEvidenceInitializeBeforeWorkload(): bool =
    if system.RuntimeAtomicLoadI32(
           systemLinkExecPlanEvidenceRegistryInit) != 0 ||
       !system.RuntimeAtomicCompareExchangeI32(
           systemLinkExecPlanEvidenceRegistryInit, 0, 1):
        return false
    setLen(systemLinkExecPlanEvidenceStates,
        systemLinkExecPlanEvidenceRowCount)
    setLen(systemLinkExecPlanEvidenceCommandCids,
        systemLinkExecPlanEvidenceRowCount)
    setLen(systemLinkExecPlanEvidenceInputSetCids,
        systemLinkExecPlanEvidenceRowCount)
    setLen(systemLinkExecPlanEvidenceOutputContractCids,
        systemLinkExecPlanEvidenceRowCount)
    setLen(systemLinkExecPlanEvidenceCurrentHeadCids,
        systemLinkExecPlanEvidenceRowCount)
    setLen(systemLinkExecPlanEvidenceManifestCids,
        systemLinkExecPlanEvidenceRowCount)
    setLen(systemLinkExecPlanEvidenceCsgcObjectCids,
        systemLinkExecPlanEvidenceRowCount)
    setLen(systemLinkExecPlanEvidenceFactsRootCids,
        systemLinkExecPlanEvidenceRowCount)
    setLen(systemLinkExecPlanEvidenceProofCids,
        systemLinkExecPlanEvidenceRowCount)
    setLen(systemLinkExecPlanEvidenceAuthorityReceiptCids,
        systemLinkExecPlanEvidenceRowCount)
    setLen(systemLinkExecPlanEvidenceCanonicalBytes,
        systemLinkExecPlanEvidenceRowCount)
    setLen(systemLinkExecPlanEvidenceReceiptCids,
        systemLinkExecPlanEvidenceRowCount)
    var ok = true
    for row in 0..<systemLinkExecPlanEvidenceRowCount:
        systemLinkExecPlanEvidenceStates[row] = atomic.NewI32(
            systemLinkExecPlanEvidenceStateEmpty)
        systemLinkExecPlanEvidenceCommandCids[row] = ""
        systemLinkExecPlanEvidenceInputSetCids[row] = ""
        systemLinkExecPlanEvidenceOutputContractCids[row] = ""
        systemLinkExecPlanEvidenceCurrentHeadCids[row] = ""
        systemLinkExecPlanEvidenceManifestCids[row] = ""
        systemLinkExecPlanEvidenceCsgcObjectCids[row] = ""
        systemLinkExecPlanEvidenceFactsRootCids[row] = ""
        systemLinkExecPlanEvidenceProofCids[row] = ""
        systemLinkExecPlanEvidenceAuthorityReceiptCids[row] = ""
        systemLinkExecPlanEvidenceCanonicalBytes[row] = ""
        systemLinkExecPlanEvidenceReceiptCids[row] = ""
        if systemLinkExecPlanEvidenceStates[row] == nil:
            ok = false
    if !ok:
        system.RuntimeAtomicStoreI32(
            systemLinkExecPlanEvidenceRegistryInit, 0)
        return false
    system.RuntimeAtomicStoreI32(
        systemLinkExecPlanEvidenceRegistryInit, 2)
    return true

@borrows
fn systemLinkExecPlanEvidenceAppendText(
        out: var layout.ByteBuf,
        value: str) =
    for byteIndex in 0..<value.len:
        layout.ByteBufAppendByte(out, value[byteIndex])

@borrows
fn systemLinkExecPlanEvidenceEncodeInto(
        commandCid: str,
        inputSetCid: str,
        outputContractCid: str,
        currentHeadCid: str,
        manifestCid: str,
        csgcObjectCid: str,
        factsRootCid: str,
        proofCid: str,
        authorityReceiptCid: str,
        outBytes: var str,
        outReceiptCid: var str): bool =
    outBytes = ""
    outReceiptCid = ""
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(commandCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(inputSetCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           outputContractCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(currentHeadCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(manifestCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(csgcObjectCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(factsRootCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(proofCid) ||
       !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           authorityReceiptCid) ||
       commandCid == inputSetCid ||
       commandCid == outputContractCid ||
       inputSetCid == outputContractCid ||
       currentHeadCid == manifestCid ||
       currentHeadCid == csgcObjectCid ||
       manifestCid == csgcObjectCid ||
       factsRootCid == csgcObjectCid:
        return false
    var encoded = layout.ByteBufInit(
        systemLinkExecPlanEvidenceByteCount)
    systemLinkExecPlanEvidenceAppendText(
        encoded, systemLinkExecPlanEvidenceMagic)
    systemLinkExecPlanEvidenceAppendText(encoded, commandCid)
    systemLinkExecPlanEvidenceAppendText(encoded, inputSetCid)
    systemLinkExecPlanEvidenceAppendText(encoded, outputContractCid)
    systemLinkExecPlanEvidenceAppendText(encoded, currentHeadCid)
    systemLinkExecPlanEvidenceAppendText(encoded, manifestCid)
    systemLinkExecPlanEvidenceAppendText(encoded, csgcObjectCid)
    systemLinkExecPlanEvidenceAppendText(encoded, factsRootCid)
    systemLinkExecPlanEvidenceAppendText(encoded, proofCid)
    systemLinkExecPlanEvidenceAppendText(encoded, authorityReceiptCid)
    if encoded.len != systemLinkExecPlanEvidenceByteCount:
        layout.ByteBufFree(encoded)
        return false
    var bytes = layout.ByteBufToBytes(encoded)
    outBytes = rawbytes.BytesToString(bytes)
    outReceiptCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            systemLinkExecPlanEvidenceDomain, bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(encoded)
    return outBytes.len == systemLinkExecPlanEvidenceByteCount &&
        merkle_store_codec.CsgCoreMerkleStoreCidValid(outReceiptCid)

@borrows
fn systemLinkExecPlanEvidenceIssueInto(
        commandCid: str,
        inputSetCid: str,
        outputContractCid: str,
        currentHeadCid: str,
        manifestCid: str,
        csgcObjectCid: str,
        factsRootCid: str,
        proofCid: str,
        authorityReceiptCid: str,
        outHandle: var systemLinkExecPlanEvidenceHandle,
        err: var str): bool =
    outHandle = systemLinkExecPlanEvidenceHandle()
    var canonicalBytes: str
    var receiptCid: str
    if !systemLinkExecPlanEvidenceEncodeInto(
           commandCid, inputSetCid, outputContractCid, currentHeadCid,
           manifestCid, csgcObjectCid, factsRootCid, proofCid,
           authorityReceiptCid, canonicalBytes, receiptCid) ||
       !systemLinkExecPlanEvidenceRegistryReady():
        err = "system_link_exec_plan_evidence_invalid"
        return false
    var row: int32 = -1
    for scan in 0..<systemLinkExecPlanEvidenceRowCount:
        if row < 0 && atomic.CasI32(
               systemLinkExecPlanEvidenceStates[scan],
               systemLinkExecPlanEvidenceStateEmpty,
               systemLinkExecPlanEvidenceStateBuilding):
            row = scan
    if row < 0:
        err = "system_link_exec_plan_evidence_arena_exhausted"
        return false
    systemLinkExecPlanEvidenceCommandCids[row] =
        strings.CloneStr(commandCid)
    systemLinkExecPlanEvidenceInputSetCids[row] =
        strings.CloneStr(inputSetCid)
    systemLinkExecPlanEvidenceOutputContractCids[row] =
        strings.CloneStr(outputContractCid)
    systemLinkExecPlanEvidenceCurrentHeadCids[row] =
        strings.CloneStr(currentHeadCid)
    systemLinkExecPlanEvidenceManifestCids[row] =
        strings.CloneStr(manifestCid)
    systemLinkExecPlanEvidenceCsgcObjectCids[row] =
        strings.CloneStr(csgcObjectCid)
    systemLinkExecPlanEvidenceFactsRootCids[row] =
        strings.CloneStr(factsRootCid)
    systemLinkExecPlanEvidenceProofCids[row] =
        strings.CloneStr(proofCid)
    systemLinkExecPlanEvidenceAuthorityReceiptCids[row] =
        strings.CloneStr(authorityReceiptCid)
    systemLinkExecPlanEvidenceCanonicalBytes[row] =
        strings.CloneStr(canonicalBytes)
    systemLinkExecPlanEvidenceReceiptCids[row] =
        strings.CloneStr(receiptCid)
    atomic.StoreI32(
        systemLinkExecPlanEvidenceStates[row],
        systemLinkExecPlanEvidenceStateIssued)
    outHandle.handleRow = row
    err = ""
    return true

fn systemLinkExecPlanEvidenceConsumeAndBindInto(
        handle: var systemLinkExecPlanEvidenceHandle,
        out:
            var production_launcher.CsgCoreProductionSystemLinkExecAdmissionReceipt,
        err: var str): bool =
    out =
        production_launcher.CsgCoreProductionSystemLinkExecAdmissionReceipt()
    if handle.handleRow < 0 ||
       handle.handleRow >= systemLinkExecPlanEvidenceRowCount ||
       !systemLinkExecPlanEvidenceRegistryReady() ||
       !atomic.CasI32(
           systemLinkExecPlanEvidenceStates[handle.handleRow],
           systemLinkExecPlanEvidenceStateIssued,
           systemLinkExecPlanEvidenceStateConsuming):
        err = "system_link_exec_plan_evidence_single_consume"
        return false
    let row = handle.handleRow
    var rebuiltBytes: str
    var rebuiltReceiptCid: str
    if !systemLinkExecPlanEvidenceEncodeInto(
           systemLinkExecPlanEvidenceCommandCids[row],
           systemLinkExecPlanEvidenceInputSetCids[row],
           systemLinkExecPlanEvidenceOutputContractCids[row],
           systemLinkExecPlanEvidenceCurrentHeadCids[row],
           systemLinkExecPlanEvidenceManifestCids[row],
           systemLinkExecPlanEvidenceCsgcObjectCids[row],
           systemLinkExecPlanEvidenceFactsRootCids[row],
           systemLinkExecPlanEvidenceProofCids[row],
           systemLinkExecPlanEvidenceAuthorityReceiptCids[row],
           rebuiltBytes,
           rebuiltReceiptCid) ||
       rebuiltBytes != systemLinkExecPlanEvidenceCanonicalBytes[row] ||
       rebuiltReceiptCid != systemLinkExecPlanEvidenceReceiptCids[row]:
        atomic.StoreI32(
            systemLinkExecPlanEvidenceStates[row],
            systemLinkExecPlanEvidenceStateAborted)
        err = "system_link_exec_plan_evidence_drift"
        return false
    var runtimePlanReceiptCid: str
    if system.RuntimeHeldExecChildAdmissionActive():
        if !system.RuntimeHeldExecChildBindPlanReceiptInto(
               rebuiltBytes,
               rebuiltReceiptCid,
               runtimePlanReceiptCid,
               err):
            atomic.StoreI32(
                systemLinkExecPlanEvidenceStates[row],
                systemLinkExecPlanEvidenceStateAborted)
            return false
    else:
        runtimePlanReceiptCid = strings.CloneStr(rebuiltReceiptCid)
    out.schema = strings.CloneStr(
        production_launcher.CsgCoreProductionSystemLinkExecAdmissionSchema)
    out.commandCid = strings.CloneStr(
        systemLinkExecPlanEvidenceCommandCids[row])
    out.inputSetCid = strings.CloneStr(
        systemLinkExecPlanEvidenceInputSetCids[row])
    out.outputContractCid = strings.CloneStr(
        systemLinkExecPlanEvidenceOutputContractCids[row])
    out.currentHeadCid = strings.CloneStr(
        systemLinkExecPlanEvidenceCurrentHeadCids[row])
    out.manifestCid = strings.CloneStr(
        systemLinkExecPlanEvidenceManifestCids[row])
    out.csgcObjectCid = strings.CloneStr(
        systemLinkExecPlanEvidenceCsgcObjectCids[row])
    out.factsRoot = strings.CloneStr(
        systemLinkExecPlanEvidenceFactsRootCids[row])
    out.proofCid = strings.CloneStr(
        systemLinkExecPlanEvidenceProofCids[row])
    out.csgAuthorityReceiptCid = strings.CloneStr(
        systemLinkExecPlanEvidenceAuthorityReceiptCids[row])
    out.launcherAdmissionReceiptCid = strings.CloneStr(
        runtimePlanReceiptCid)
    out.complete = true
    if !production_launcher.CsgCoreProductionSystemLinkExecAdmissionSealInto(
           out, err):
        atomic.StoreI32(
            systemLinkExecPlanEvidenceStates[row],
            systemLinkExecPlanEvidenceStateAborted)
        return false
    atomic.StoreI32(
        systemLinkExecPlanEvidenceStates[row],
        systemLinkExecPlanEvidenceStateConsumed)
    handle = systemLinkExecPlanEvidenceHandle()
    err = ""
    return true

fn systemLinkExecPlanDebugSourcePath(
        plan: var SystemLinkExecPlan): str =
    if len(plan.systemLinkPlan.entryPath) > 0:
        return plan.systemLinkPlan.entryPath
    return plan.systemLinkPlan.buildEntryPath

fn systemLinkExecPlanPrimaryFunctionSymbolCount(
        plan: var SystemLinkExecPlan): int32 =
    var count = plan.primaryObjectPlan.symbolNames.len
    let bridgeSymbol =
        pobj.PrimaryRuntimeEntryBridgeSymbol(plan.systemLinkPlan)
    if len(bridgeSymbol) <= 0:
        return count
    for symbolIndex in 0..<plan.primaryObjectPlan.symbolNames.len:
        if plan.primaryObjectPlan.symbolNames[symbolIndex] ==
           bridgeSymbol:
            count = count - 1
    if count < 0:
        return 0
    return count

fn systemLinkExecPlanPrimaryUnsupportedCount(
        plan: var SystemLinkExecPlan): int32 =
    let materializedFunctionCount =
        systemLinkExecPlanPrimaryFunctionSymbolCount(plan)
    if plan.loweringPlan.functionNames.len <=
       materializedFunctionCount:
        return 0
    return plan.loweringPlan.functionNames.len -
           materializedFunctionCount

@borrows
fn systemLinkExecPlanDebugAppendLine(out: var str,
                                      key: str,
                                      value: str) =
    let ownedKey = strings.CloneStr(key)
    let ownedValue = strings.CloneStr(value)
    let suffix = strutil.Join([ownedKey, "=", ownedValue, "\n"], "")
    let prefix = strings.CloneStr(out)
    out = strings.ConcatStr(prefix, suffix)

fn SystemLinkExecPlanDebugReportText(
        plan: var SystemLinkExecPlan): str =
    var out = "cheng_debug_report\n"
    let sourcePath = systemLinkExecPlanDebugSourcePath(plan)
    systemLinkExecPlanDebugAppendLine(out, "entry", sourcePath)
    systemLinkExecPlanDebugAppendLine(
        out, "target", plan.systemLinkPlan.targetTriple)
    systemLinkExecPlanDebugAppendLine(out, "source_path", sourcePath)
    systemLinkExecPlanDebugAppendLine(
        out,
        "lowering_function_count",
        strings.IntToStr(plan.loweringPlan.functionSymbolTexts.len))
    systemLinkExecPlanDebugAppendLine(
        out,
        "lowering_symbols",
        slplan.SystemLinkPlanListText(
            plan.loweringPlan.functionSymbolTexts))
    systemLinkExecPlanDebugAppendLine(
        out,
        "primary_object_item_count",
        strings.IntToStr(plan.primaryObjectPlan.itemIds.len))
    systemLinkExecPlanDebugAppendLine(
        out,
        "primary_symbols",
        slplan.SystemLinkPlanListText(
            plan.primaryObjectPlan.symbolNames))
    systemLinkExecPlanDebugAppendLine(
        out,
        "primary_unsupported_count",
        strings.IntToStr(
            systemLinkExecPlanPrimaryUnsupportedCount(plan)))
    systemLinkExecPlanDebugAppendLine(
        out,
        "native_linker_program",
        tmat.TargetLinkerProgram(plan.systemLinkPlan.targetTriple))
    return out

fn SystemLinkExecPlanSymbolsReportText(
        plan: var SystemLinkExecPlan): str =
    var out = "cheng_symbols\n"
    let sourcePath = systemLinkExecPlanDebugSourcePath(plan)
    systemLinkExecPlanDebugAppendLine(out, "entry", sourcePath)
    systemLinkExecPlanDebugAppendLine(
        out, "target", plan.systemLinkPlan.targetTriple)
    systemLinkExecPlanDebugAppendLine(out, "source_path", sourcePath)
    systemLinkExecPlanDebugAppendLine(
        out,
        "lowering_symbol_count",
        strings.IntToStr(plan.loweringPlan.functionSymbolTexts.len))
    systemLinkExecPlanDebugAppendLine(
        out,
        "lowering_symbols",
        slplan.SystemLinkPlanListText(
            plan.loweringPlan.functionSymbolTexts))
    systemLinkExecPlanDebugAppendLine(
        out,
        "primary_symbol_count",
        strings.IntToStr(plan.primaryObjectPlan.symbolNames.len))
    systemLinkExecPlanDebugAppendLine(
        out,
        "primary_symbols",
        slplan.SystemLinkPlanListText(
            plan.primaryObjectPlan.symbolNames))
    systemLinkExecPlanDebugAppendLine(
        out,
        "primary_unsupported_count",
        strings.IntToStr(
            systemLinkExecPlanPrimaryUnsupportedCount(plan)))
    return out

fn SystemLinkExecPlanCompilerCsgReportText(
        plan: var SystemLinkExecPlan): str =
    var out: str
    let ownedPackageId = strings.CloneStr(plan.compilerCsg.packageId)
    out = strutil.Join(
        [out, "package_id=", ownedPackageId, "\n"], "")
    out = strutil.Join(
        [out,
         "source_bundle_cid=",
         layout.FixedBytes32Hex(plan.compilerCsg.sourceBundleCid),
         "\n"],
        "")
    out = strutil.Join(
        [out,
         "canonical_compiler_csg_cid=",
         layout.FixedBytes32Hex(plan.compilerCsg.canonicalGraphCid),
         "\n"],
        "")
    out = strutil.Join(
        [out,
         "graph_cid=",
         layout.FixedBytes32Hex(plan.compilerCsg.graphCid),
         "\n"],
        "")
    out = strutil.Join(
        [out,
         "node_count=",
         strings.IntToStr(plan.compilerCsg.nodeCount),
         "\n"],
        "")
    out = strutil.Join(
        [out,
         "edge_count=",
         strings.IntToStr(plan.compilerCsg.edgeCount)],
        "")
    return out

fn SystemLinkExecSourceBundleReceiptFixedLiveBytes(): int64 =
    return Int64(sizeof(SystemLinkExecSourceBundleReceipt))

fn SystemLinkExecSemanticAppendU32Field(buf: var layout.ByteBuf,
                                        value: int32) =
    SystemLinkExecSourceBundleReceiptAppendU32BE(buf, 4)
    SystemLinkExecSourceBundleReceiptAppendU32BE(buf, value)

@borrows
fn SystemLinkExecSemanticAppendFixed32Field(
        buf: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    SystemLinkExecSourceBundleReceiptAppendU32BE(buf, 32)
    for byteIndex in 0..<32:
        layout.ByteBufAppendByte(
            buf, int32(value.data[byteIndex]))

@borrows
fn SystemLinkExecSemanticTextValid(value: str): bool =
    if value == "" || strutil.Strip(value) != value:
        return false
    for index in 0..<value.len:
        let code = Int32(value[index])
        if code < 32 || code == 127:
            return false
    return true

@borrows
fn SystemLinkExecSemanticTextLess(left: str, right: str): bool =
    if left == right:
        return false
    let sharedLen = left.len < right.len ? left.len : right.len
    for index in 0..<sharedLen:
        if left[index] == right[index]:
            continue
        return left[index] < right[index]
    return left.len < right.len

@borrows
fn SystemLinkExecCanonicalProviderSetInto(providers: str[],
                                           out: var str[],
                                           err: var str): bool =
    var order: int32[]
    for providerIndex in 0..<providers.len:
        if !SystemLinkExecSemanticTextValid(providers[providerIndex]):
            err = Fmt"system link exec: semantic provider identity invalid index={providerIndex}"
            return false
        add(order, providerIndex)
    # Sort scalar int32 indices while `providers` stays immutable.  Managed
    # elements are copied once after the order is final, so the loop-carried
    # identity is a plain scalar sequence and never a live/consumed str merge.
    for orderIndex in 1..<order.len:
        var insertIndex = orderIndex
        while insertIndex > 0 &&
              SystemLinkExecSemanticTextLess(
                  providers[order[insertIndex]],
                  providers[order[insertIndex - 1]]):
            let tmp = order[insertIndex - 1]
            order[insertIndex - 1] = order[insertIndex]
            order[insertIndex] = tmp
            insertIndex = insertIndex - 1
    var ordered: str[]
    for orderIndex in 0..<order.len:
        add(ordered, strings.CloneStr(providers[order[orderIndex]]))
    for providerIndex in 1..<ordered.len:
        if ordered[providerIndex - 1] == ordered[providerIndex]:
            err = Fmt"system link exec: semantic provider identity duplicated index={providerIndex}"
            return false
    out = ordered
    err = ""
    return true

fn SystemLinkExecSemanticBufCid(
        buf: var layout.ByteBuf): layout.FixedBytes32 =
    let cid = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return cid

@borrows
fn SystemLinkExecSemanticTextCid(domain: str,
                                  value: str): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(domain.len + value.len + 16)
    SystemLinkExecSourceBundleReceiptAppendText(buf, domain)
    SystemLinkExecSourceBundleReceiptAppendText(buf, value)
    return SystemLinkExecSemanticBufCid(buf)

@borrows
fn SystemLinkExecOrderedProviderSetCidInto(
        providers: str[],
        outCid: var layout.FixedBytes32,
        err: var str): bool =
    var ordered: str[]
    if !SystemLinkExecCanonicalProviderSetInto(providers, ordered, err):
        return false
    var buf: layout.ByteBuf = layout.ByteBufInit(128 + ordered.len * 48)
    SystemLinkExecSourceBundleReceiptAppendText(
        buf,
        "cheng.system_link_exec.ordered_provider_set")
    SystemLinkExecSemanticAppendU32Field(buf, ordered.len)
    for providerIndex in 0..<ordered.len:
        SystemLinkExecSourceBundleReceiptAppendText(
            buf,
            ordered[providerIndex])
    outCid = SystemLinkExecSemanticBufCid(buf)
    err = ""
    return true

fn SystemLinkExecSourceToCsgBindingSeal(
        sourceIdentityReceiptCid: layout.FixedBytes32,
        canonicalCompilerCsgCid: layout.FixedBytes32,
        semanticReceiptCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(128)
    SystemLinkExecSourceBundleReceiptAppendText(
        buf,
        "cheng.system_link_exec.source_to_csg_binding")
    SystemLinkExecSemanticAppendFixed32Field(buf,
                                              sourceIdentityReceiptCid)
    SystemLinkExecSemanticAppendFixed32Field(buf,
                                              canonicalCompilerCsgCid)
    SystemLinkExecSemanticAppendFixed32Field(buf,
                                              semanticReceiptCid)
    return SystemLinkExecSemanticBufCid(buf)

@borrows
fn SystemLinkExecCanonicalOutputDigest(
        emitKind: creq.CompilerEmit,
        symbolVisibility: str,
        targetTriple: str,
        providers: str[],
        canonicalCompilerCsgCid: layout.FixedBytes32): layout.FixedBytes32 =
    let emitText = creq.CompilerEmitText(emitKind)
    if emitText == "unknown" ||
       !SystemLinkExecSemanticTextValid(symbolVisibility) ||
       !SystemLinkExecSemanticTextValid(targetTriple) ||
       layout.FixedBytes32Equal(canonicalCompilerCsgCid,
                                layout.FixedBytes32()):
        system.Panic(
            "system link exec: canonical output plan discriminator invalid")
    var orderedProviders: str[]
    var providerErr: str
    if !SystemLinkExecCanonicalProviderSetInto(providers,
                                                orderedProviders,
                                                providerErr):
        system.Panic(providerErr)
    var buf: layout.ByteBuf = layout.ByteBufInit(256)
    SystemLinkExecSourceBundleReceiptAppendText(
        buf,
        "cheng.system_link_exec.canonical_output_plan")
    SystemLinkExecSourceBundleReceiptAppendText(
        buf,
        emitText)
    SystemLinkExecSourceBundleReceiptAppendText(buf, symbolVisibility)
    SystemLinkExecSourceBundleReceiptAppendText(buf, targetTriple)
    SystemLinkExecSemanticAppendFixed32Field(buf,
                                              canonicalCompilerCsgCid)
    SystemLinkExecSemanticAppendU32Field(buf, orderedProviders.len)
    for providerIndex in 0..<orderedProviders.len:
        SystemLinkExecSourceBundleReceiptAppendText(
            buf,
            orderedProviders[providerIndex])
    return SystemLinkExecSemanticBufCid(buf)

@borrows
fn SystemLinkExecCompileSemanticReceiptCid(
        receipt: CompileSemanticReceipt): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(384)
    SystemLinkExecSourceBundleReceiptAppendText(
        buf,
        "cheng.system_link_exec.compile_semantic_receipt")
    SystemLinkExecSemanticAppendFixed32Field(
        buf,
        receipt.sourceIdentityReceiptCid)
    SystemLinkExecSemanticAppendFixed32Field(
        buf,
        receipt.canonicalCompilerCsgCid)
    SystemLinkExecSemanticAppendFixed32Field(
        buf,
        receipt.canonicalOutputDigest)
    SystemLinkExecSemanticAppendFixed32Field(buf, receipt.targetTripleCid)
    SystemLinkExecSemanticAppendFixed32Field(buf, receipt.bootstrapStageCid)
    SystemLinkExecSemanticAppendFixed32Field(
        buf,
        receipt.orderedProviderSetCid)
    return SystemLinkExecSemanticBufCid(buf)

@borrows
fn SystemLinkExecCompileSemanticReceiptSelfValidateInto(
        receipt: CompileSemanticReceipt,
        err: var str): bool =
    let zero = layout.FixedBytes32()
    if layout.FixedBytes32Equal(receipt.sourceIdentityReceiptCid, zero) ||
       layout.FixedBytes32Equal(receipt.canonicalCompilerCsgCid, zero) ||
       layout.FixedBytes32Equal(receipt.canonicalOutputDigest, zero) ||
       layout.FixedBytes32Equal(receipt.targetTripleCid, zero) ||
       layout.FixedBytes32Equal(receipt.bootstrapStageCid, zero) ||
       layout.FixedBytes32Equal(receipt.orderedProviderSetCid, zero) ||
       layout.FixedBytes32Equal(receipt.receiptCid, zero):
        err = "system link exec: semantic receipt contains zero identity cid"
        return false
    let expectedReceiptCid =
        SystemLinkExecCompileSemanticReceiptCid(receipt)
    if !layout.FixedBytes32Equal(receipt.receiptCid,
                                 expectedReceiptCid):
        err = "system link exec: semantic receipt cid mismatch"
        return false
    err = ""
    return true

@borrows
fn SystemLinkExecCompileSemanticReceiptReport(
        receipt: CompileSemanticReceipt): str =
    var err: str
    if !SystemLinkExecCompileSemanticReceiptSelfValidateInto(receipt,
                                                                err):
        system.Panic(err)
    var out = ""
    out = strutil.Join(
        [out,
         "source_identity_receipt_cid=",
         layout.FixedBytes32Hex(receipt.sourceIdentityReceiptCid),
         "\n"],
        "")
    out = strutil.Join(
        [out,
         "canonical_compiler_csg_cid=",
         layout.FixedBytes32Hex(receipt.canonicalCompilerCsgCid),
         "\n"],
        "")
    out = strutil.Join(
        [out,
         "canonical_output_digest=",
         layout.FixedBytes32Hex(receipt.canonicalOutputDigest),
         "\n"],
        "")
    out = strutil.Join(
        [out,
         "target_triple_cid=",
         layout.FixedBytes32Hex(receipt.targetTripleCid),
         "\n"],
        "")
    out = strutil.Join(
        [out,
         "bootstrap_stage_cid=",
         layout.FixedBytes32Hex(receipt.bootstrapStageCid),
         "\n"],
        "")
    out = strutil.Join(
        [out,
         "ordered_provider_set_cid=",
         layout.FixedBytes32Hex(receipt.orderedProviderSetCid),
         "\n"],
        "")
    out = strutil.Join(
        [out,
         "semantic_receipt_cid=",
         layout.FixedBytes32Hex(receipt.receiptCid)],
        "")
    return out

@borrows
fn SystemLinkExecCompileSemanticReceiptReportField(
        lines: str[],
        lineIndex: int32,
        key: str): Result[str] =
    if lineIndex < 0 || lineIndex >= lines.len:
        return Err[str](strutil.Join([
            "system link exec: semantic receipt missing field key=",
            strings.CloneStr(key)], ""))
    let prefix = strutil.Join([strings.CloneStr(key), "="], "")
    let line = lines[lineIndex]
    if line.len <= prefix.len ||
       strings.SliceBytes(line, 0, prefix.len) != prefix:
        return Err[str](strutil.Join([
            "system link exec: semantic receipt field order/name mismatch key=",
            strings.CloneStr(key)], ""))
    return Ok[str](strings.CloneStr(
        strings.SliceBytes(line,
                           prefix.len,
                           line.len - prefix.len)))

@borrows
fn SystemLinkExecCompileSemanticReceiptReportFixed32(
        lines: str[],
        lineIndex: int32,
        key: str): Result[layout.FixedBytes32] =
    let valueRes = SystemLinkExecCompileSemanticReceiptReportField(
        lines,
        lineIndex,
        key)
    if IsErr(valueRes):
        return Err[layout.FixedBytes32](Error(valueRes))
    let cidRes = layout.FixedBytes32FromHex(Value(valueRes))
    if IsErr(cidRes):
        return Err[layout.FixedBytes32](strutil.Join([
            "system link exec: semantic receipt invalid fixed32 key=",
            strings.CloneStr(key)], ""))
    return Ok[layout.FixedBytes32](Value(cidRes))

@borrows
fn SystemLinkExecCompileSemanticReceiptFromReportText(
        text: str,
        out: var CompileSemanticReceipt): Result[bool] =
    let lines = strutil.Split(text, '\n')
    if lines.len != 7:
        return Err[bool](
            "system link exec: semantic receipt report field count mismatch")
    let sourceRes = SystemLinkExecCompileSemanticReceiptReportFixed32(
        lines,
        0,
        "source_identity_receipt_cid")
    let csgRes = SystemLinkExecCompileSemanticReceiptReportFixed32(
        lines,
        1,
        "canonical_compiler_csg_cid")
    let outputRes = SystemLinkExecCompileSemanticReceiptReportFixed32(
        lines,
        2,
        "canonical_output_digest")
    let targetRes = SystemLinkExecCompileSemanticReceiptReportFixed32(
        lines,
        3,
        "target_triple_cid")
    let stageRes = SystemLinkExecCompileSemanticReceiptReportFixed32(
        lines,
        4,
        "bootstrap_stage_cid")
    let providersRes = SystemLinkExecCompileSemanticReceiptReportFixed32(
        lines,
        5,
        "ordered_provider_set_cid")
    let receiptRes = SystemLinkExecCompileSemanticReceiptReportFixed32(
        lines,
        6,
        "semantic_receipt_cid")
    if IsErr(sourceRes):
        return Err[bool](Error(sourceRes))
    if IsErr(csgRes):
        return Err[bool](Error(csgRes))
    if IsErr(outputRes):
        return Err[bool](Error(outputRes))
    if IsErr(targetRes):
        return Err[bool](Error(targetRes))
    if IsErr(stageRes):
        return Err[bool](Error(stageRes))
    if IsErr(providersRes):
        return Err[bool](Error(providersRes))
    if IsErr(receiptRes):
        return Err[bool](Error(receiptRes))
    var next: CompileSemanticReceipt
    next.sourceIdentityReceiptCid = Value(sourceRes)
    next.canonicalCompilerCsgCid = Value(csgRes)
    next.canonicalOutputDigest = Value(outputRes)
    next.targetTripleCid = Value(targetRes)
    next.bootstrapStageCid = Value(stageRes)
    next.orderedProviderSetCid = Value(providersRes)
    next.receiptCid = Value(receiptRes)
    var err: str
    if !SystemLinkExecCompileSemanticReceiptSelfValidateInto(next,
                                                                err):
        return Err[bool](err)
    if SystemLinkExecCompileSemanticReceiptReport(next) != text:
        return Err[bool](
            "system link exec: semantic receipt report is not exact canonical")
    out = next
    return Ok[bool](true)

@borrows
fn SystemLinkExecCompileSemanticReceiptStrictValidateInto(
        receipt: CompileSemanticReceipt,
        sourceReceipt: ccsg.PortableSourceIdentityReceipt,
        compilerCsg: ccsg.CompilerCsg,
        canonicalOutputDigest: layout.FixedBytes32,
        targetTriple: str,
        bootstrapStage: str,
        providers: str[],
        err: var str): bool =
    if !SystemLinkExecCompileSemanticReceiptSelfValidateInto(receipt,
                                                                err):
        return false
    if !ccsg.PortableSourceIdentityReceiptStrictValidateInto(sourceReceipt,
                                                              err):
        return false
    if compilerCsg.nodeCount != 0 || compilerCsg.nodes.len != 0 ||
       compilerCsg.edgeCount != 0 || compilerCsg.edges.len != 0:
        if !ccsg.CompilerCsgPortableArtifactStrictValidateInto(
               compilerCsg, sourceReceipt, err):
            return false
    elif layout.FixedBytes32Equal(
            compilerCsg.canonicalGraphCid, layout.FixedBytes32()):
        err = "system link exec: CompilerCSG graph missing after backend release"
        return false
    if !SystemLinkExecSemanticTextValid(targetTriple) ||
       !SystemLinkExecSemanticTextValid(bootstrapStage):
        err = "system link exec: semantic receipt target/stage invalid"
        return false
    let targetTripleCid = SystemLinkExecSemanticTextCid(
        "cheng.compiler.target_triple",
        targetTriple)
    let bootstrapStageCid = SystemLinkExecSemanticTextCid(
        "cheng.compiler.bootstrap_stage",
        bootstrapStage)
    var orderedProviderSetCid: layout.FixedBytes32
    if !SystemLinkExecOrderedProviderSetCidInto(providers,
                                                orderedProviderSetCid,
                                                err):
        return false
    let zero = layout.FixedBytes32()
    if layout.FixedBytes32Equal(canonicalOutputDigest, zero) ||
       !layout.FixedBytes32Equal(receipt.sourceIdentityReceiptCid,
                                 sourceReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(receipt.canonicalCompilerCsgCid,
                                 compilerCsg.canonicalGraphCid) ||
       !layout.FixedBytes32Equal(receipt.canonicalOutputDigest,
                                 canonicalOutputDigest) ||
       !layout.FixedBytes32Equal(receipt.targetTripleCid,
                                 targetTripleCid) ||
       !layout.FixedBytes32Equal(receipt.bootstrapStageCid,
                                 bootstrapStageCid) ||
       !layout.FixedBytes32Equal(receipt.orderedProviderSetCid,
                                 orderedProviderSetCid):
        err = "system link exec: semantic receipt predecessor/artifact binding mismatch"
        return false
    err = ""
    return true

@borrows
fn SystemLinkExecCompileSemanticReceiptMakeInto(
        sourceReceipt: ccsg.PortableSourceIdentityReceipt,
        compilerCsg: ccsg.CompilerCsg,
        canonicalOutputDigest: layout.FixedBytes32,
        targetTriple: str,
        bootstrapStage: str,
        providers: str[],
        outReceipt: var CompileSemanticReceipt,
        err: var str): bool =
    var orderedProviderSetCid: layout.FixedBytes32
    if !SystemLinkExecOrderedProviderSetCidInto(providers,
                                                orderedProviderSetCid,
                                                err):
        return false
    var next: CompileSemanticReceipt
    next.sourceIdentityReceiptCid = sourceReceipt.receiptCid
    next.canonicalCompilerCsgCid = compilerCsg.canonicalGraphCid
    next.canonicalOutputDigest = canonicalOutputDigest
    next.targetTripleCid = SystemLinkExecSemanticTextCid(
        "cheng.compiler.target_triple",
        targetTriple)
    next.bootstrapStageCid = SystemLinkExecSemanticTextCid(
        "cheng.compiler.bootstrap_stage",
        bootstrapStage)
    next.orderedProviderSetCid = orderedProviderSetCid
    next.receiptCid = SystemLinkExecCompileSemanticReceiptCid(next)
    if !SystemLinkExecCompileSemanticReceiptStrictValidateInto(
            next,
            sourceReceipt,
            compilerCsg,
            canonicalOutputDigest,
            targetTriple,
            bootstrapStage,
            providers,
            err):
        return false
    outReceipt = next
    err = ""
    return true

@borrows
fn SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
        sourceReceipt: ccsg.PortableSourceIdentityReceipt,
        canonicalCompilerCsgCid: layout.FixedBytes32,
        canonicalOutputDigest: layout.FixedBytes32,
        targetTriple: str,
        bootstrapStage: str,
        providers: str[],
        outReceipt: var CompileSemanticReceipt,
        err: var str): bool =
    if !ccsg.PortableSourceIdentityReceiptStrictValidateInto(sourceReceipt,
                                                              err) ||
       !SystemLinkExecSemanticTextValid(targetTriple) ||
       !SystemLinkExecSemanticTextValid(bootstrapStage) ||
       layout.FixedBytes32Equal(canonicalCompilerCsgCid,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(canonicalOutputDigest,
                                layout.FixedBytes32()):
        if err == "":
            err = "system link exec: compact semantic receipt predecessor invalid"
        return false
    var orderedProviderSetCid: layout.FixedBytes32
    if !SystemLinkExecOrderedProviderSetCidInto(providers,
                                                orderedProviderSetCid,
                                                err):
        return false
    var next: CompileSemanticReceipt
    next.sourceIdentityReceiptCid = sourceReceipt.receiptCid
    next.canonicalCompilerCsgCid = canonicalCompilerCsgCid
    next.canonicalOutputDigest = canonicalOutputDigest
    next.targetTripleCid = SystemLinkExecSemanticTextCid(
        "cheng.compiler.target_triple",
        targetTriple)
    next.bootstrapStageCid = SystemLinkExecSemanticTextCid(
        "cheng.compiler.bootstrap_stage",
        bootstrapStage)
    next.orderedProviderSetCid = orderedProviderSetCid
    next.receiptCid = SystemLinkExecCompileSemanticReceiptCid(next)
    if !SystemLinkExecCompileSemanticReceiptSelfValidateInto(next, err):
        return false
    outReceipt = next
    err = ""
    return true

fn SystemLinkExecSourceBundleReceiptAppendU32BE(buf: var layout.ByteBuf,
                                                value: int32) =
    layout.ByteBufAppendByte(buf, Int32((value >> 24) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 16) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 8) & 255))
    layout.ByteBufAppendByte(buf, Int32(value & 255))

@borrows
fn SystemLinkExecSourceBundleReceiptAppendText(buf: var layout.ByteBuf,
                                                text: str) =
    SystemLinkExecSourceBundleReceiptAppendU32BE(buf, text.len)
    for i in 0..<text.len:
        layout.ByteBufAppendByte(buf, text[i])

fn SystemLinkExecSourceBundleReceiptAppendU32Field(
        buf: var layout.ByteBuf,
        value: int32) =
    SystemLinkExecSourceBundleReceiptAppendU32BE(buf, 4)
    SystemLinkExecSourceBundleReceiptAppendU32BE(buf, value)

@borrows
fn SystemLinkExecSourceBundleReceiptAppendFixed32Field(
        buf: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    SystemLinkExecSourceBundleReceiptAppendU32BE(buf, 32)
    for byteIndex in 0..<32:
        layout.ByteBufAppendByte(
            buf, int32(value.data[byteIndex]))

@borrows
fn SystemLinkExecSourceBundleEntryIdentitySeal(
        packageId: str,
        modulePath: str,
        sourceBundleCid: layout.FixedBytes32,
        bindingSeal: layout.FixedBytes32): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(256)
    let domain = "cheng.system_link_exec.source_bundle_entry_identity"
    SystemLinkExecSourceBundleReceiptAppendText(buf, domain)
    SystemLinkExecSourceBundleReceiptAppendText(buf, packageId)
    SystemLinkExecSourceBundleReceiptAppendText(buf, modulePath)
    SystemLinkExecSourceBundleReceiptAppendFixed32Field(buf, sourceBundleCid)
    SystemLinkExecSourceBundleReceiptAppendFixed32Field(buf, bindingSeal)
    let seal = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return seal

@borrows
fn SystemLinkExecSourceBundleReceiptComputeSeal(
        receipt: SystemLinkExecSourceBundleReceipt): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(384)
    let domain = "cheng.system_link_exec.source_bundle_receipt"
    SystemLinkExecSourceBundleReceiptAppendText(buf, domain)
    SystemLinkExecSourceBundleReceiptAppendU32Field(
        buf,
        receipt.entrySourceIndex)
    SystemLinkExecSourceBundleReceiptAppendFixed32Field(
        buf,
        receipt.sourcePackageIdCid)
    SystemLinkExecSourceBundleReceiptAppendFixed32Field(
        buf,
        receipt.entryModulePathCid)
    SystemLinkExecSourceBundleReceiptAppendFixed32Field(
        buf,
        receipt.sourceBundleCid)
    SystemLinkExecSourceBundleReceiptAppendFixed32Field(
        buf,
        receipt.entrySourceCid)
    SystemLinkExecSourceBundleReceiptAppendFixed32Field(
        buf,
        receipt.importGraphCid)
    SystemLinkExecSourceBundleReceiptAppendFixed32Field(
        buf,
        receipt.sourceIdentityReceiptCid)
    SystemLinkExecSourceBundleReceiptAppendFixed32Field(
        buf,
        receipt.bindingSeal)
    SystemLinkExecSourceBundleReceiptAppendFixed32Field(
        buf,
        receipt.entryIdentitySeal)
    SystemLinkExecSourceBundleReceiptAppendU32Field(
        buf,
        receipt.sourceClosureCount)
    SystemLinkExecSourceBundleReceiptAppendU32Field(
        buf,
        receipt.sourceIdentityCount)
    SystemLinkExecSourceBundleReceiptAppendU32Field(
        buf,
        receipt.ownerModuleCount)
    SystemLinkExecSourceBundleReceiptAppendU32Field(
        buf,
        receipt.importEdgeCount)
    SystemLinkExecSourceBundleReceiptAppendU32Field(
        buf,
        receipt.unresolvedImportCount)
    let seal = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return seal

@borrows
fn SystemLinkExecSourceBundleReceiptValidInto(
        receipt: SystemLinkExecSourceBundleReceipt,
        err: var str): bool =
    err = ""
    if SystemLinkExecSourceBundleReceiptFixedLiveBytes() !=
       SystemLinkExecSourceBundleReceiptFixedBytes:
        err = "system link exec: source bundle receipt fixed ABI size mismatch"
        return false
    if receipt.sourceClosureCount <= 0 ||
       receipt.sourceIdentityCount != receipt.sourceClosureCount ||
       receipt.ownerModuleCount != receipt.sourceClosureCount:
        err = "system link exec: source bundle receipt column counts mismatch"
        return false
    if receipt.entrySourceIndex < 0 ||
       receipt.entrySourceIndex >= receipt.sourceClosureCount:
        err = "system link exec: source bundle receipt entry index invalid"
        return false
    if receipt.importEdgeCount < 0 ||
       receipt.unresolvedImportCount < 0 ||
       receipt.unresolvedImportCount > receipt.importEdgeCount:
        err = "system link exec: source bundle receipt import counts invalid"
        return false
    let zero = layout.FixedBytes32()
    if layout.FixedBytes32Equal(receipt.sourcePackageIdCid, zero) ||
       layout.FixedBytes32Equal(receipt.entryModulePathCid, zero) ||
       layout.FixedBytes32Equal(receipt.sourceBundleCid, zero) ||
       layout.FixedBytes32Equal(receipt.entrySourceCid, zero) ||
       layout.FixedBytes32Equal(receipt.importGraphCid, zero) ||
       layout.FixedBytes32Equal(receipt.sourceIdentityReceiptCid, zero) ||
       layout.FixedBytes32Equal(receipt.bindingSeal, zero) ||
       layout.FixedBytes32Equal(receipt.entryIdentitySeal, zero) ||
       layout.FixedBytes32Equal(receipt.receiptSeal, zero):
        err = "system link exec: source bundle receipt seal is missing"
        return false
    let expectedSeal = SystemLinkExecSourceBundleReceiptComputeSeal(receipt)
    if !layout.FixedBytes32Equal(receipt.receiptSeal, expectedSeal):
        err = "system link exec: source bundle receipt scalar seal mismatch"
        return false
    var portableReceipt: ccsg.PortableSourceIdentityReceipt
    portableReceipt.sourceSnapshotCount = receipt.sourceClosureCount
    portableReceipt.importEdgeCount = receipt.importEdgeCount
    portableReceipt.unresolvedImportCount = receipt.unresolvedImportCount
    portableReceipt.sourcePackageIdCid = receipt.sourcePackageIdCid
    portableReceipt.entryModulePathCid = receipt.entryModulePathCid
    portableReceipt.sourceBundleCid = receipt.sourceBundleCid
    portableReceipt.entrySourceCid = receipt.entrySourceCid
    portableReceipt.importGraphCid = receipt.importGraphCid
    portableReceipt.receiptCid = receipt.sourceIdentityReceiptCid
    if !ccsg.PortableSourceIdentityReceiptStrictValidateInto(
            portableReceipt,
            err):
        return false
    return true

fn SystemLinkExecSourceBundleReceiptCaptureInto(
        linkPlan: var slplan.SystemLinkPlanStub,
        sourceReceipt: var ccsg.PortableSourceIdentityReceipt,
        outReceipt: var SystemLinkExecSourceBundleReceipt,
        err: var str): bool =
    if !slplan.SystemLinkPlanSourceBundleBindingStructuralValidInto(
            linkPlan,
            err) ||
       !ccsg.PortableSourceIdentityReceiptStrictValidateInto(
            sourceReceipt,
            err):
        return false
    var receipt: SystemLinkExecSourceBundleReceipt
    receipt.entrySourceIndex = linkPlan.sourceBundleEntrySourceIndex
    receipt.sourceBundleCid = linkPlan.sourceBundleCidValue
    receipt.bindingSeal = linkPlan.sourceBundleBindingSeal
    let entrySourcePath =
        linkPlan.sourceClosurePaths[linkPlan.sourceBundleEntrySourceIndex]
    let entryModulePath =
        linkPlan.ownerModulePaths[linkPlan.sourceBundleEntrySourceIndex]
    let entryIdentityPath =
        linkPlan.sourceBundleIdentityPaths[linkPlan.sourceBundleEntrySourceIndex]
    if entrySourcePath == "" || entryIdentityPath == "" ||
       entryModulePath == "" || entrySourcePath != linkPlan.entryPath ||
       entrySourcePath != linkPlan.buildEntryPath ||
       entryModulePath != linkPlan.moduleStem ||
       entryIdentityPath != entryModulePath:
        err = "system link exec: source bundle receipt entry identity unavailable"
        return false
    receipt.entryIdentitySeal = SystemLinkExecSourceBundleEntryIdentitySeal(
        linkPlan.packageId,
        entryModulePath,
        receipt.sourceBundleCid,
        receipt.bindingSeal)
    receipt.sourcePackageIdCid = sourceReceipt.sourcePackageIdCid
    receipt.entryModulePathCid = sourceReceipt.entryModulePathCid
    receipt.sourceBundleCid = sourceReceipt.sourceBundleCid
    receipt.entrySourceCid = sourceReceipt.entrySourceCid
    receipt.importGraphCid = sourceReceipt.importGraphCid
    receipt.sourceIdentityReceiptCid = sourceReceipt.receiptCid
    receipt.sourceClosureCount = linkPlan.sourceClosurePaths.len
    receipt.sourceIdentityCount = linkPlan.sourceBundleIdentityPaths.len
    receipt.ownerModuleCount = linkPlan.ownerModulePaths.len
    receipt.importEdgeCount = linkPlan.importEdges.len
    receipt.unresolvedImportCount = linkPlan.unresolvedImportCount
    if receipt.sourceClosureCount != sourceReceipt.sourceSnapshotCount ||
       receipt.importEdgeCount != sourceReceipt.importEdgeCount ||
       receipt.unresolvedImportCount != sourceReceipt.unresolvedImportCount ||
       !layout.FixedBytes32Equal(
            receipt.sourcePackageIdCid,
            ccsg.CompilerCsgPortableSourcePackageIdCid(linkPlan.packageId)) ||
       !layout.FixedBytes32Equal(
            receipt.entryModulePathCid,
            ccsg.CompilerCsgPortableEntryModulePathCid(entryModulePath)) ||
       !layout.FixedBytes32Equal(receipt.sourceBundleCid,
                                 linkPlan.sourceBundleCidValue) ||
       !layout.FixedBytes32Equal(receipt.entrySourceCid,
                                 linkPlan.sourceBundleEntrySourceCid) ||
       !layout.FixedBytes32Equal(receipt.importGraphCid,
                                 linkPlan.sourceBundleImportGraphCid):
        err = "system link exec: portable source receipt disagrees with sealed source bundle"
        return false
    receipt.receiptSeal =
        SystemLinkExecSourceBundleReceiptComputeSeal(receipt)
    if !SystemLinkExecSourceBundleReceiptValidInto(receipt, err):
        return false
    outReceipt = receipt
    err = ""
    return true

@borrows
fn SystemLinkExecPlanEntryIdentityInto(plan: SystemLinkExecPlan,
                                        outEntryModulePath: var str,
                                        err: var str): bool =
    outEntryModulePath = ""
    err = ""
    let packageId = parser.ParserManifestNormalizePackageId(
        plan.systemLinkPlan.packageId)
    if packageId == "" || packageId != plan.systemLinkPlan.packageId:
        err = "system link exec: receipt package identity invalid"
        return false
    let entryModulePath =
        strings.CloneStr(plan.systemLinkPlan.moduleStem)
    if entryModulePath == "" ||
       !layout.FixedBytes32Equal(
            plan.sourceBundleReceipt.sourcePackageIdCid,
            ccsg.CompilerCsgPortableSourcePackageIdCid(packageId)) ||
       !layout.FixedBytes32Equal(
            plan.sourceBundleReceipt.entryModulePathCid,
            ccsg.CompilerCsgPortableEntryModulePathCid(entryModulePath)):
        err = "system link exec: receipt portable entry identity mismatch"
        return false
    let expectedEntrySeal = SystemLinkExecSourceBundleEntryIdentitySeal(
        packageId,
        entryModulePath,
        plan.sourceBundleReceipt.sourceBundleCid,
        plan.sourceBundleReceipt.bindingSeal)
    if !layout.FixedBytes32Equal(
            plan.sourceBundleReceipt.entryIdentitySeal,
            expectedEntrySeal):
        err = "system link exec: source bundle receipt entry identity mismatch"
        return false
    outEntryModulePath = entryModulePath
    return true

@borrows
fn SystemLinkExecPlanSourceBundleReceiptValidInto(
        plan: SystemLinkExecPlan,
        outEntryModulePath: var str,
        err: var str): bool =
    outEntryModulePath = ""
    if !SystemLinkExecSourceBundleReceiptValidInto(plan.sourceBundleReceipt,
                                                   err):
        return false
    if !layout.FixedBytes32Equal(plan.sourceBundleReceipt.sourceBundleCid,
                                 plan.sourceBundleCid):
        err = "system link exec: source bundle receipt/plan cid mismatch"
        return false
    var entryModulePath: str
    if !SystemLinkExecPlanEntryIdentityInto(plan, entryModulePath, err):
        return false
    outEntryModulePath = entryModulePath
    err = ""
    return true

fn SystemLinkExecPlanCidChainStrictValidateInto(
        plan: var SystemLinkExecPlan,
        err: var str): bool =
    if !production_launcher.CsgCoreProductionLauncherSystemLinkExecAdmissionStrictValidateInto(
           plan.productionAdmissionReceipt,
           err):
        return false
    if !plan.requestBindingSealed ||
       plan.requestedJobCount < 1 ||
       (plan.requestBackendKind != creq.CompilerBackendPrimary &&
        plan.requestBackendKind != creq.CompilerBackend2):
        err = "system link exec: backend request identity is not sealed"
        return false
    var backendActionAuthority: creq.CompilerRequest
    backendActionAuthority.backendKind = plan.requestBackendKind
    backendActionAuthority.jobCount = plan.requestedJobCount
    backendActionAuthority.emitKind = plan.requestEmitKind
    backendActionAuthority.providerObjectPaths =
        slplan.SystemLinkPlanStringsClone(plan.requestProviderObjectPaths)
    backendActionAuthority.runtimeProviderBundle =
        strings.CloneStr(plan.requestRuntimeProviderBundle)
    let expectedBackendActionCid =
        creq.CompilerRequestBackendActionCid(backendActionAuthority)
    if layout.FixedBytes32Equal(
           plan.backendRequestActionCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           plan.backendRequestCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           expectedBackendActionCid,
           plan.backendRequestActionCid):
        err = "system link exec: backend request CID binding mismatch"
        return false
    var entryModulePath: str
    if !SystemLinkExecPlanSourceBundleReceiptValidInto(plan,
                                                        entryModulePath,
                                                        err):
        return false
    if !ccsg.PortableSourceIdentityReceiptStrictValidateInto(
            plan.compilerCsg.sourceIdentityReceipt,
            err):
        return false
    if !layout.FixedBytes32Equal(
            plan.compilerCsg.sourceIdentityReceipt.sourcePackageIdCid,
            plan.sourceBundleReceipt.sourcePackageIdCid) ||
       !layout.FixedBytes32Equal(
            plan.compilerCsg.sourceIdentityReceipt.entryModulePathCid,
            plan.sourceBundleReceipt.entryModulePathCid) ||
       !layout.FixedBytes32Equal(
            plan.compilerCsg.sourceIdentityReceipt.sourceBundleCid,
            plan.sourceBundleReceipt.sourceBundleCid) ||
       !layout.FixedBytes32Equal(
            plan.compilerCsg.sourceIdentityReceipt.entrySourceCid,
            plan.sourceBundleReceipt.entrySourceCid) ||
       !layout.FixedBytes32Equal(
            plan.compilerCsg.sourceIdentityReceipt.importGraphCid,
            plan.sourceBundleReceipt.importGraphCid) ||
       !layout.FixedBytes32Equal(
            plan.compilerCsg.sourceIdentityReceipt.receiptCid,
            plan.sourceBundleReceipt.sourceIdentityReceiptCid) ||
       !layout.FixedBytes32Equal(
            plan.compilerCsg.sourceIdentityReceipt.entrySourceCid,
            plan.compilerCsg.entrySourceCid) ||
       plan.compilerCsg.sourceIdentityReceipt.sourceSnapshotCount !=
            plan.compilerCsg.sourceSnapshotCount ||
       plan.compilerCsg.sourceIdentityReceipt.sourceSnapshotCount !=
            plan.sourceBundleReceipt.sourceClosureCount ||
       plan.compilerCsg.sourceIdentityReceipt.sourceSnapshotCount !=
            plan.sourceBundleReceipt.sourceIdentityCount ||
       plan.compilerCsg.sourceIdentityReceipt.sourceSnapshotCount !=
            plan.sourceBundleReceipt.ownerModuleCount ||
       plan.compilerCsg.sourceIdentityReceipt.importEdgeCount !=
            plan.sourceBundleReceipt.importEdgeCount ||
       plan.compilerCsg.sourceIdentityReceipt.unresolvedImportCount !=
            plan.sourceBundleReceipt.unresolvedImportCount:
        err = "system link exec: portable source receipt local binding mismatch"
        return false
    if plan.compilerCsg.nodeCount != 0 ||
       plan.compilerCsg.nodes.len != 0 ||
       plan.compilerCsg.edgeCount != 0 ||
       plan.compilerCsg.edges.len != 0:
        if !ccsg.CompilerCsgOwnTransitionReceiptStrictValidateInto(
               plan.compilerCsg, err):
            return false
    elif layout.FixedBytes32Equal(
            plan.compilerCsg.canonicalGraphCid,
            layout.FixedBytes32()) ||
         !layout.FixedBytes32Equal(
             plan.compilerCsg.csgTransitionReceipt.canonicalCompilerCsgCid,
             plan.compilerCsg.canonicalGraphCid) ||
         !layout.FixedBytes32Equal(
             plan.compilerCsg.csgTransitionReceipt.sourceIdentityReceiptCid,
             plan.compilerCsg.sourceIdentityReceipt.receiptCid):
        err =
            "system link exec: transition receipt CSG cid mismatch after backend release"
        return false
    if plan.nativeLinkPlan.targetTriple == "" ||
       plan.nativeLinkPlan.targetTriple != plan.objectPlan.targetTriple ||
       plan.nativeLinkPlan.targetTriple != plan.systemLinkPlan.targetTriple:
        err = "system link exec: semantic target binding mismatch"
        return false
    var orderedProviders: str[]
    if !SystemLinkExecCanonicalProviderSetInto(
            plan.objectPlan.providerModules,
            orderedProviders,
            err):
        return false
    let canonicalOutputDigest = SystemLinkExecCanonicalOutputDigest(
        plan.systemLinkPlan.emitKind,
        plan.systemLinkPlan.symbolVisibility,
        plan.nativeLinkPlan.targetTriple,
        orderedProviders,
        plan.compilerCsg.canonicalGraphCid)
    if !SystemLinkExecCompileSemanticReceiptStrictValidateInto(
            plan.semanticReceipt,
            plan.compilerCsg.sourceIdentityReceipt,
            plan.compilerCsg,
            canonicalOutputDigest,
            plan.nativeLinkPlan.targetTriple,
            "stage3_local",
            orderedProviders,
            err):
        return false
    let expectedProductionCommandCid =
        Fmt"sha256:{layout.FixedBytes32Hex(plan.backendRequestCid)}"
    let expectedProductionInputSetCid =
        Fmt"sha256:{layout.FixedBytes32Hex(plan.sourceBundleReceipt.sourceIdentityReceiptCid)}"
    let expectedCompilerCsgInputSetCid =
        Fmt"sha256:{layout.FixedBytes32Hex(plan.compilerCsg.sourceIdentityReceipt.receiptCid)}"
    let expectedProductionOutputContractCid =
        Fmt"sha256:{layout.FixedBytes32Hex(plan.semanticReceipt.canonicalOutputDigest)}"
    let expectedProductionFactsRootCid =
        Fmt"sha256:{layout.FixedBytes32Hex(plan.loweringPlan.semanticSnapshotFactsRootCid)}"
    if plan.productionAdmissionReceipt.commandCid !=
           expectedProductionCommandCid:
        err = "system_link_exec_production_command_cid_unbound"
        return false
    if plan.productionAdmissionReceipt.inputSetCid !=
           expectedProductionInputSetCid ||
       plan.productionAdmissionReceipt.inputSetCid !=
           expectedCompilerCsgInputSetCid:
        err = "system_link_exec_production_input_set_cid_unbound"
        return false
    if plan.productionAdmissionReceipt.outputContractCid !=
           expectedProductionOutputContractCid:
        err = "system_link_exec_production_output_contract_cid_unbound"
        return false
    if plan.productionAdmissionReceipt.factsRoot !=
           expectedProductionFactsRootCid:
        err = "system_link_exec_production_facts_root_unbound"
        return false
    if !snapshot_bridge.CompilerSnapshotLoweringAuthorityProductionAdmissionMatchesInto(
           plan.loweringPlan.compilerSnapshotLoweringAuthority,
           plan.productionAdmissionReceipt.currentHeadCid,
           plan.productionAdmissionReceipt.manifestCid,
           plan.productionAdmissionReceipt.csgcObjectCid,
           plan.productionAdmissionReceipt.factsRoot,
           plan.productionAdmissionReceipt.proofCid,
           plan.productionAdmissionReceipt.csgAuthorityReceiptCid,
           err):
        return false
    let sourceToCsgBindingSeal = SystemLinkExecSourceToCsgBindingSeal(
        plan.compilerCsg.sourceIdentityReceipt.receiptCid,
        plan.compilerCsg.canonicalGraphCid,
        plan.semanticReceipt.receiptCid)
    if layout.FixedBytes32Equal(plan.sourceToCsgBindingSeal,
                                layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(plan.sourceToCsgBindingSeal,
                                 sourceToCsgBindingSeal):
        err = "system link exec: source-to-CSG plan binding seal mismatch"
        return false
    if !cworld.CompilerLocalUniverseStrictValidateInto(
            plan.localUniverse,
            err):
        return false
    let managedReceiptPresent =
        slplan.SystemLinkPlanManagedDependencyReceiptPresent(
            plan.managedDependencyReceipt)
    let manifestManagedReceiptMissing = layout.FixedBytes32Equal(
        plan.localUniverse.manifest.managedDependencyReceiptCid,
        layout.FixedBytes32())
    if managedReceiptPresent:
        if !slplan.SystemLinkPlanManagedDependencyReceiptVerifyInto(
                plan.managedDependencyReceipt,
                err):
            return false
        if manifestManagedReceiptMissing ||
           plan.managedDependencyReceipt.channel !=
                plan.localUniverse.manifest.channel ||
           !layout.FixedBytes32Equal(
                plan.managedDependencyReceipt.receiptCid,
                plan.localUniverse.manifest.managedDependencyReceiptCid):
            err = "system link exec: compact managed dependency receipt/manifest mismatch"
            return false
    elif !manifestManagedReceiptMissing:
        err = "system link exec: manifest retained managed dependency cid without compact receipt"
        return false
    err = ""
    return true

@borrows
fn SystemLinkExecPlanFinalCidChainStrictValidateInto(
        plan: var SystemLinkExecPlan,
        outputSha256: layout.FixedBytes32,
        err: var str): bool =
    if !SystemLinkExecPlanCidChainStrictValidateInto(plan, err):
        return false
    if !ccsg.CompileReceiptStrictValidateInto(plan.compileReceipt, err):
        return false
    var orderedProviders: str[]
    if !SystemLinkExecCanonicalProviderSetInto(
            plan.objectPlan.providerModules,
            orderedProviders,
            err):
        return false
    if !layout.FixedBytes32Equal(plan.compileReceipt.worldHeadCid,
                                 plan.localUniverse.worldHead.headCid) ||
       !layout.FixedBytes32Equal(
            plan.compileReceipt.sourceIdentityReceiptCid,
            plan.compilerCsg.sourceIdentityReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(plan.compileReceipt.semanticReceiptCid,
                                 plan.semanticReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(plan.compileReceipt.outputDigest,
                                 outputSha256) ||
       !layout.FixedBytes32Equal(
            plan.compileReceipt.canonicalOutputDigest,
            plan.semanticReceipt.canonicalOutputDigest) ||
       plan.compileReceipt.targetTriple != plan.nativeLinkPlan.targetTriple ||
       plan.compileReceipt.bootstrapStage != "stage3_local" ||
       plan.compileReceipt.runtimeProviderSet.len != orderedProviders.len:
        err = "system link exec: final compile receipt binding mismatch"
        return false
    for providerIndex in 0..<orderedProviders.len:
        if plan.compileReceipt.runtimeProviderSet[providerIndex] !=
           orderedProviders[providerIndex]:
            err = Fmt"system link exec: final provider binding mismatch index={providerIndex}"
            return false
    err = ""
    return true

fn SystemLinkExecPlanFinalizeCompileReceiptInto(
        plan: var SystemLinkExecPlan,
        outputSha256: layout.FixedBytes32,
        err: var str): bool =
    if !SystemLinkExecPlanCidChainStrictValidateInto(plan, err):
        return false
    if layout.FixedBytes32Equal(outputSha256, layout.FixedBytes32()):
        err = "system link exec: final output sha256 is zero"
        return false
    var orderedProviders: str[]
    if !SystemLinkExecCanonicalProviderSetInto(
            plan.objectPlan.providerModules,
            orderedProviders,
            err):
        return false
    var receipt: ccsg.CompileReceipt
    if !ccsg.CompileReceiptMakeInto(
            plan.localUniverse.worldHead.headCid,
            plan.compilerCsg.sourceIdentityReceipt.receiptCid,
            plan.semanticReceipt.receiptCid,
            plan.nativeLinkPlan.targetTriple,
            outputSha256,
            plan.semanticReceipt.canonicalOutputDigest,
            "stage3_local",
            orderedProviders,
            receipt,
            err):
        return false
    plan.compileReceipt = receipt
    if !SystemLinkExecPlanFinalCidChainStrictValidateInto(
            plan,
            outputSha256,
            err):
        plan.compileReceipt = ccsg.CompileReceipt()
        return false
    return true

@borrows
fn SystemLinkExecPathHasSegmentSuffix(path: str,
                                      suffix: str): bool =
    if len(suffix) <= 0 || len(path) < len(suffix):
        return false
    let start = len(path) - len(suffix)
    if strings.SliceBytes(path, start, len(suffix)) != suffix:
        return false
    if start == 0:
        return true
    let separator = path[start - 1]
    return separator == '/' || separator == '\\'

@borrows
fn SystemLinkExecLinuxPassBCurrentReceiptRequest(
        rootDir: str,
        plan: var SystemLinkExecPlan): bool =
    let noHandoff = os.GetEnv("CHENG_NO_BACKEND_DRIVER_HANDOFF")
    if len(noHandoff) <= 0 ||
       noHandoff == "0" ||
       noHandoff == "false":
        return false
    if plan.systemLinkPlan.targetTriple !=
           "x86_64-unknown-linux-gnu" ||
       plan.requestEmitKind != creq.EmitExe ||
       plan.systemLinkPlan.emitKind != creq.EmitExe ||
       plan.compileReceipt.runtimeProviderSet.len <= 0:
        return false
    let entryPath = chengpath.PathAbsolute(
        rootDir,
        plan.compilerEntrySource)
    if !SystemLinkExecPathHasSegmentSuffix(
            entryPath,
            "src/core/tooling/backend_driver_dispatch_min.cheng"):
        return false
    let outputPath = chengpath.PathAbsolute(
        rootDir,
        plan.systemLinkPlan.outputPath)
    return SystemLinkExecPathHasSegmentSuffix(
        outputPath,
        "artifacts/bootstrap/compiler_main.direct.next")

@borrows
fn SystemLinkExecLinuxPassBCurrentReceiptReportInto(
        out: var str,
        err: var str,
        rootDir: str,
        plan: var SystemLinkExecPlan,
        outputSha256: layout.FixedBytes32,
        backend2VersionManifestSha256: layout.FixedBytes32): bool =
    out = ""
    if !SystemLinkExecLinuxPassBCurrentReceiptRequest(rootDir, plan):
        err = "system link exec: Linux pass-B current receipt request mismatch"
        return false
    if !SystemLinkExecPlanFinalCidChainStrictValidateInto(
            plan,
            layout.FixedBytes32Copy(outputSha256),
            err):
        return false
    if layout.FixedBytes32Equal(
           backend2VersionManifestSha256,
           layout.FixedBytes32()):
        err = "system link exec: backend2 version manifest identity is zero"
        return false
    var entryModulePath: str
    if !SystemLinkExecPlanSourceBundleReceiptValidInto(
            plan,
            entryModulePath,
            err):
        return false
    let compilerOutputReceiptCid = ccsg.CompileOutputReceiptCid(
        plan.compileReceipt.receiptCid,
        outputSha256,
        backend2VersionManifestSha256,
        plan.compileReceipt.targetTriple)
    SystemLinkExecReportAppendLine(out, "system_link_exec", "1")
    SystemLinkExecReportAppendLine(out, "real_backend_codegen", "1")
    SystemLinkExecReportAppendLine(
        out,
        "target",
        plan.compileReceipt.targetTriple)
    SystemLinkExecReportAppendLine(
        out,
        "emit",
        creq.CompilerEmitText(plan.systemLinkPlan.emitKind))
    SystemLinkExecReportAppendLine(
        out,
        "output",
        plan.systemLinkPlan.outputPath)
    SystemLinkExecReportAppendLine(
        out,
        "output_sha256",
        layout.FixedBytes32Hex(outputSha256))
    SystemLinkExecReportAppendLine(
        out,
        "backend2_version_manifest_sha256",
        layout.FixedBytes32Hex(backend2VersionManifestSha256))
    SystemLinkExecReportAppendLine(
        out,
        "compiler_output_receipt_cid",
        layout.FixedBytes32Hex(compilerOutputReceiptCid))
    SystemLinkExecReportAppendLine(
        out,
        "source_bundle_receipt_source_bundle_cid",
        layout.FixedBytes32Hex(
            plan.sourceBundleReceipt.sourceBundleCid))
    SystemLinkExecReportAppendLine(
        out,
        "source_bundle_receipt_seal",
        layout.FixedBytes32Hex(
            plan.sourceBundleReceipt.receiptSeal))
    SystemLinkExecReportAppendLine(
        out,
        "source_bundle_entry_identity_seal",
        layout.FixedBytes32Hex(
            plan.sourceBundleReceipt.entryIdentitySeal))
    SystemLinkExecReportAppendLine(
        out,
        "source_bundle_binding_seal",
        layout.FixedBytes32Hex(
            plan.sourceBundleReceipt.bindingSeal))
    SystemLinkExecReportAppendLine(
        out,
        "source_bundle_entry_source_index",
        strings.IntToStr(
            plan.sourceBundleReceipt.entrySourceIndex))
    let sourceBundleBindingPhysicalReport =
        slplan.SystemLinkPlanSourceBundleBindingPhysicalReport(
            plan.systemLinkPlan)
    if len(sourceBundleBindingPhysicalReport) <= 0:
        err = "system link exec: source bundle binding physical report is empty"
        return false
    out = Fmt"{out}{sourceBundleBindingPhysicalReport}\n"
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_source_package_id",
        plan.systemLinkPlan.packageId)
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_entry_module_path",
        entryModulePath)
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_source_snapshot_count",
        strings.IntToStr(
            plan.sourceBundleReceipt.sourceClosureCount))
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_import_edge_count",
        strings.IntToStr(
            plan.sourceBundleReceipt.importEdgeCount))
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_unresolved_import_count",
        strings.IntToStr(
            plan.sourceBundleReceipt.unresolvedImportCount))
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_source_package_id_cid",
        layout.FixedBytes32Hex(
            plan.sourceBundleReceipt.sourcePackageIdCid))
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_entry_module_path_cid",
        layout.FixedBytes32Hex(
            plan.sourceBundleReceipt.entryModulePathCid))
    SystemLinkExecReportAppendLine(
        out,
        "source_bundle_cid",
        layout.FixedBytes32Hex(
            plan.sourceBundleReceipt.sourceBundleCid))
    SystemLinkExecReportAppendLine(
        out,
        "entry_source_cid",
        layout.FixedBytes32Hex(
            plan.sourceBundleReceipt.entrySourceCid))
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_import_graph_cid",
        layout.FixedBytes32Hex(
            plan.sourceBundleReceipt.importGraphCid))
    SystemLinkExecReportAppendLine(
        out,
        "source_identity_receipt_cid",
        layout.FixedBytes32Hex(
            plan.sourceBundleReceipt.sourceIdentityReceiptCid))
    SystemLinkExecReportAppendLine(
        out,
        "canonical_compiler_csg_cid",
        layout.FixedBytes32Hex(
            plan.compilerCsg.canonicalGraphCid))
    SystemLinkExecReportAppendLine(
        out,
        "semantic_receipt_cid",
        layout.FixedBytes32Hex(plan.semanticReceipt.receiptCid))
    SystemLinkExecReportAppendLine(
        out,
        "source_to_csg_binding_seal",
        layout.FixedBytes32Hex(plan.sourceToCsgBindingSeal))
    SystemLinkExecReportAppendLine(
        out,
        "compile_receipt_world_head_cid",
        layout.FixedBytes32Hex(plan.compileReceipt.worldHeadCid))
    SystemLinkExecReportAppendLine(
        out,
        "compile_receipt_source_identity_receipt_cid",
        layout.FixedBytes32Hex(
            plan.compileReceipt.sourceIdentityReceiptCid))
    SystemLinkExecReportAppendLine(
        out,
        "compile_receipt_semantic_receipt_cid",
        layout.FixedBytes32Hex(
            plan.compileReceipt.semanticReceiptCid))
    SystemLinkExecReportAppendLine(
        out,
        "compile_receipt_output_digest",
        layout.FixedBytes32Hex(plan.compileReceipt.outputDigest))
    SystemLinkExecReportAppendLine(
        out,
        "compile_receipt_canonical_output_digest",
        layout.FixedBytes32Hex(
            plan.compileReceipt.canonicalOutputDigest))
    SystemLinkExecReportAppendLine(
        out,
        "compile_receipt_target",
        plan.compileReceipt.targetTriple)
    SystemLinkExecReportAppendLine(
        out,
        "compile_receipt_bootstrap_stage",
        plan.compileReceipt.bootstrapStage)
    SystemLinkExecReportAppendLine(
        out,
        "compile_receipt_runtime_provider_count",
        strings.IntToStr(
            plan.compileReceipt.runtimeProviderSet.len))
    for providerIndex in 0..<plan.compileReceipt.runtimeProviderSet.len:
        SystemLinkExecReportAppendLine(
            out,
            Fmt"compile_receipt_runtime_provider.{providerIndex}",
            plan.compileReceipt.runtimeProviderSet[providerIndex])
    SystemLinkExecReportAppendLine(
        out,
        "compile_receipt_cid",
        layout.FixedBytes32Hex(plan.compileReceipt.receiptCid))
    SystemLinkExecReportAppendLine(
        out,
        "cold_system_link_exec",
        "0")
    SystemLinkExecReportAppendLine(
        out,
        "system_link_exec_scope",
        "selfhost_direct")
    SystemLinkExecReportAppendLine(
        out,
        "full_backend_codegen",
        "1")
    SystemLinkExecReportAppendLine(
        out,
        "pure_provenance_bootstrap_materialize",
        "pass_b")
    SystemLinkExecReportAppendLine(
        out,
        "pure_provenance_gate",
        "pass_b_self_proof")
    err = ""
    return true

fn SystemLinkExecPlanRebuildWorldAfterMigrationInto(
        plan: var SystemLinkExecPlan,
        compilerMigrationProofCid: layout.FixedBytes32,
        compilerManagedMirrorBundleCid: layout.FixedBytes32,
        err: var str): bool =
    if !SystemLinkExecPlanCidChainStrictValidateInto(plan, err):
        return false
    if layout.FixedBytes32Equal(compilerMigrationProofCid,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(compilerManagedMirrorBundleCid,
                                layout.FixedBytes32()):
        err = "system link exec: migration proof/mirror identity missing"
        return false
    var managedDependencyReceiptCid: layout.FixedBytes32
    if slplan.SystemLinkPlanManagedDependencyReceiptPresent(
            plan.managedDependencyReceipt):
        managedDependencyReceiptCid = plan.managedDependencyReceipt.receiptCid
    var extraManifestEntries: cworld.CompilerUniverseManifestEntry[]
    for entryIndex in 0..<plan.localUniverse.manifest.entries.len:
        let entry = plan.localUniverse.manifest.entries[entryIndex]
        if entry.packageId == "cheng/compiler" ||
           entry.packageId == "cheng/std" ||
           entry.packageId == "cheng/runtime":
            continue
        var cloned: cworld.CompilerUniverseManifestEntry
        cloned.packageId = strings.CloneStr(entry.packageId)
        cloned.snapshotCid = entry.snapshotCid
        cloned.syntaxSurfaceCid = entry.syntaxSurfaceCid
        cloned.migrationProofCid = entry.migrationProofCid
        cloned.managedMirrorBundleCid = entry.managedMirrorBundleCid
        add(extraManifestEntries, cloned)
    var compilerEntry: cworld.CompilerUniverseManifestEntry
    cworld.CompilerUniverseManifestEntryMakeInto(
        "cheng/compiler",
        plan.localUniverse.compilerSnapshot.snapshotCid,
        plan.localUniverse.compilerSnapshot.syntaxSurfaceCid,
        compilerMigrationProofCid,
        compilerManagedMirrorBundleCid,
        compilerEntry)
    add(extraManifestEntries, compilerEntry)
    var nextUniverse: cworld.CompilerLocalUniverse
    if !cworld.CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(
            nextUniverse,
            err,
            plan.localUniverse.worldHead.channel,
            plan.compilerCsg.sourceIdentityReceipt.sourceBundleCid,
            plan.compilerCsg.canonicalGraphCid,
            plan.exportSurface.surfaceCid,
            compilerMigrationProofCid,
            managedDependencyReceiptCid,
            extraManifestEntries):
        return false
    plan.localUniverse = cworld.CompilerWorldOwnLocalUniverse(nextUniverse)
    plan.compileReceipt = ccsg.CompileReceipt()
    plan.lockVerified = false
    if !SystemLinkExecPlanCidChainStrictValidateInto(plan, err):
        plan.localUniverse = cworld.CompilerLocalUniverse()
        return false
    err = ""
    return true

@borrows
fn SystemLinkExecPublicationSnapshotStrictValidateInto(
        snapshot: SystemLinkExecPublicationSnapshot,
        err: var str): bool =
    if snapshot.sourcePackageId == "" ||
       snapshot.targetTriple == "" ||
       snapshot.bootstrapStage != "stage3_local" ||
       snapshot.canonicalCsgText == "":
        err = "system link exec: publication snapshot shape invalid"
        return false
    if !ccsg.PortableSourceIdentityReceiptStrictValidateInto(
            snapshot.sourceIdentityReceipt,
            err) ||
       !SystemLinkExecCompileSemanticReceiptSelfValidateInto(
            snapshot.semanticReceipt,
            err) ||
       !cworld.CompilerLocalUniverseStrictValidateInto(
            snapshot.localUniverse,
            err):
        return false
    if !layout.FixedBytes32Equal(
            snapshot.sourceIdentityReceipt.sourcePackageIdCid,
            ccsg.CompilerCsgPortableSourcePackageIdCid(
                snapshot.sourcePackageId)):
        err = "system link exec: publication source package mismatch"
        return false
    var canonicalCsgCid: layout.FixedBytes32
    var csgErr: str
    if !ccsg.CompilerCsgCanonicalGraphCidFromReportTextInto(
            snapshot.canonicalCsgText,
            canonicalCsgCid,
            csgErr) ||
       !layout.FixedBytes32Equal(canonicalCsgCid,
                                 snapshot.canonicalCsgCid):
        err = "system link exec: publication canonical CSG mismatch"
        return false
    var providerSetCid: layout.FixedBytes32
    if !SystemLinkExecOrderedProviderSetCidInto(
            snapshot.runtimeProviderSet,
            providerSetCid,
            err):
        return false
    let targetTripleCid = SystemLinkExecSemanticTextCid(
        "cheng.compiler.target_triple",
        snapshot.targetTriple)
    let bootstrapStageCid = SystemLinkExecSemanticTextCid(
        "cheng.compiler.bootstrap_stage",
        snapshot.bootstrapStage)
    if !layout.FixedBytes32Equal(
            snapshot.semanticReceipt.sourceIdentityReceiptCid,
            snapshot.sourceIdentityReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(
            snapshot.semanticReceipt.canonicalCompilerCsgCid,
            snapshot.canonicalCsgCid) ||
       !layout.FixedBytes32Equal(snapshot.semanticReceipt.targetTripleCid,
                                 targetTripleCid) ||
       !layout.FixedBytes32Equal(snapshot.semanticReceipt.bootstrapStageCid,
                                 bootstrapStageCid) ||
       !layout.FixedBytes32Equal(
            snapshot.semanticReceipt.orderedProviderSetCid,
            providerSetCid) ||
       !layout.FixedBytes32Equal(
            snapshot.localUniverse.compilerSnapshot.sourceBundleCid,
            snapshot.sourceIdentityReceipt.sourceBundleCid) ||
       !layout.FixedBytes32Equal(
            snapshot.localUniverse.worldHead.csgRootCid,
            snapshot.canonicalCsgCid) ||
       !layout.FixedBytes32Equal(
            snapshot.localUniverse.compilerSnapshot.exportSurfaceCid,
            snapshot.exportSurface.surfaceCid):
        err = "system link exec: publication predecessor chain mismatch"
        return false
    err = ""
    return true

fn SystemLinkExecPublicationSnapshotMakeInto(
        plan: var SystemLinkExecPlan,
        out: var SystemLinkExecPublicationSnapshot,
        err: var str): bool =
    if !SystemLinkExecPlanCidChainStrictValidateInto(plan, err):
        return false
    var orderedProviders: str[]
    if !SystemLinkExecCanonicalProviderSetInto(
            plan.systemLinkPlan.providerModules,
            orderedProviders,
            err):
        return false
    var exactSurface: ccsg.CsgExportSurface
    let surfaceRes = ccsg.CompilerExportSurfaceFromReportText(
        ccsg.CompilerExportSurfaceReport(plan.exportSurface),
        exactSurface)
    if IsErr(surfaceRes):
        err = Error(surfaceRes)
        return false
    var next: SystemLinkExecPublicationSnapshot
    next.sourcePackageId = plan.systemLinkPlan.packageId
    next.targetTriple = plan.systemLinkPlan.targetTriple
    next.bootstrapStage = "stage3_local"
    next.runtimeProviderSet = orderedProviders
    next.canonicalCsgText =
        ccsg.CompilerCsgCanonicalSidecarReport(plan.compilerCsg)
    next.canonicalCsgCid = plan.compilerCsg.canonicalGraphCid
    next.sourceIdentityReceipt = plan.compilerCsg.sourceIdentityReceipt
    next.semanticReceipt = plan.semanticReceipt
    next.exportSurface = exactSurface
    next.localUniverse =
        cworld.CompilerWorldOwnLocalUniverse(plan.localUniverse)
    if !SystemLinkExecPublicationSnapshotStrictValidateInto(next, err):
        return false
    out = next
    err = ""
    return true

@borrows
fn SystemLinkExecPublicationSnapshotFinalizeReceiptInto(
        snapshot: SystemLinkExecPublicationSnapshot,
        outputSha256: layout.FixedBytes32,
        out: var ccsg.CompileReceipt,
        err: var str): bool =
    if !SystemLinkExecPublicationSnapshotStrictValidateInto(snapshot, err):
        return false
    if layout.FixedBytes32Equal(outputSha256, layout.FixedBytes32()):
        err = "system link exec: publication output sha256 is zero"
        return false
    return ccsg.CompileReceiptMakeInto(
        snapshot.localUniverse.worldHead.headCid,
        snapshot.sourceIdentityReceipt.receiptCid,
        snapshot.semanticReceipt.receiptCid,
        snapshot.targetTriple,
        outputSha256,
        snapshot.semanticReceipt.canonicalOutputDigest,
        snapshot.bootstrapStage,
        snapshot.runtimeProviderSet,
        out,
        err)

fn SystemLinkExecNowNs(): int64 =
    return SystemLinkExecMonoTimeNsBridge()

fn SystemLinkExecRawFlagBridgeEnabled(): bool =
    let raw = strutil.Strip(os.GetEnv("CHENG_PURE_RAW_FLAG_BRIDGE"))
    if len(raw) <= 0:
        return false
    if raw == "0" || raw == "false":
        return false
    return true

fn SystemLinkExecPayloadLifecycleFromLinkPlan(
        linkPlan: var slplan.SystemLinkPlanStub): SystemLinkExecPayloadLifecycle =
    var lifecycle: SystemLinkExecPayloadLifecycle
    lifecycle.systemLinkExprMoveCount = linkPlan.exprLayerMoveCount
    lifecycle.systemLinkExprCloneCount = linkPlan.exprLayerCloneCount
    if lifecycle.systemLinkExprMoveCount != 1 ||
       lifecycle.systemLinkExprCloneCount != 0:
        panic("system link exec: expression layer ownership transfer is not move-only")
    return lifecycle

@borrows
fn SystemLinkExecPayloadLifecycleCanTransition(
        lifecycle: SystemLinkExecPayloadLifecycle,
        transition: SystemLinkExecPayloadTransition,
        err: var str): bool =
    err = ""
    if transition == SystemLinkExecPayloadConsumeSystemLinkExpr:
        if lifecycle.systemLinkExprMoveCount != 1 ||
           lifecycle.systemLinkExprCloneCount != 0:
            err = "system link exec: expression payload consumption without move-only ownership"
            return false
        if lifecycle.systemLinkExprConsumeCount != 0:
            err = "system link exec: system-link expression payload consumed more than once"
            return false
        return true
    if transition == SystemLinkExecPayloadReleaseCompilerCsgBackend:
        if lifecycle.systemLinkExprConsumeCount != 1:
            err = "system link exec: CompilerCSG backend release before expression payload consumption"
            return false
        if lifecycle.compilerCsgBackendReleaseCount != 0:
            err = "system link exec: CompilerCSG backend payload released more than once"
            return false
        return true
    if transition == SystemLinkExecPayloadReleaseLoweringPrePrimary:
        if lifecycle.compilerCsgBackendReleaseCount != 1:
            err = "system link exec: lowering pre-primary release before CompilerCSG release"
            return false
        if lifecycle.loweringPrePrimaryReleaseCount != 0:
            err = "system link exec: lowering pre-primary payload released more than once"
            return false
        return true
    if transition == SystemLinkExecPayloadReleaseLoweringAfterPrimary:
        if lifecycle.loweringPrePrimaryReleaseCount != 1:
            err = "system link exec: lowering post-primary release before pre-primary release"
            return false
        if lifecycle.loweringAfterPrimaryReleaseCount != 0:
            err = "system link exec: lowering post-primary payload released more than once"
            return false
        return true
    if transition == SystemLinkExecPayloadReleaseRuntimeUnused:
        if lifecycle.loweringAfterPrimaryReleaseCount != 1:
            err = "system link exec: runtime-unused release before post-primary release"
            return false
        if lifecycle.runtimeUnusedReleaseCount != 0:
            err = "system link exec: runtime-unused payload released more than once"
            return false
        return true
    if transition == SystemLinkExecPayloadReleasePrimaryBodyIr:
        if lifecycle.loweringAfterPrimaryReleaseCount != 1:
            err = "system link exec: primary BodyIR release before post-primary release"
            return false
        if lifecycle.primaryBodyIrReleaseCount != 0:
            err = "system link exec: primary BodyIR payload released more than once"
            return false
        return true
    if transition == SystemLinkExecPayloadReleaseProvider:
        if lifecycle.loweringAfterPrimaryReleaseCount != 1:
            err = "system link exec: provider release before post-primary release"
            return false
        if lifecycle.providerPayloadReleaseCount != 0:
            err = "system link exec: provider payload released more than once"
            return false
        return true
    if transition == SystemLinkExecPayloadReleaseNative:
        if lifecycle.loweringAfterPrimaryReleaseCount != 1:
            err = "system link exec: native-link release before post-primary release"
            return false
        if lifecycle.nativePayloadReleaseCount != 0:
            err = "system link exec: native-link payload released more than once"
            return false
        return true
    if transition == SystemLinkExecPayloadReleaseLoweringTerminal:
        if lifecycle.loweringAfterPrimaryReleaseCount != 1:
            err = "system link exec: lowering terminal release before post-primary release"
            return false
        if lifecycle.runtimeUnusedReleaseCount != 1:
            err = "system link exec: lowering terminal release before runtime-unused release"
            return false
        if lifecycle.loweringTerminalReleaseCount != 0:
            err = "system link exec: lowering terminal payload released more than once"
            return false
        return true
    err = "system link exec: unknown payload lifecycle transition"
    return false

fn SystemLinkExecPayloadLifecycleTryTransition(
        lifecycle: var SystemLinkExecPayloadLifecycle,
        transition: SystemLinkExecPayloadTransition,
        err: var str): bool =
    if !SystemLinkExecPayloadLifecycleCanTransition(lifecycle, transition, err):
        return false
    if transition == SystemLinkExecPayloadConsumeSystemLinkExpr:
        lifecycle.systemLinkExprConsumeCount = 1
    elif transition == SystemLinkExecPayloadReleaseCompilerCsgBackend:
        lifecycle.compilerCsgBackendReleaseCount = 1
    elif transition == SystemLinkExecPayloadReleaseLoweringPrePrimary:
        lifecycle.loweringPrePrimaryReleaseCount = 1
    elif transition == SystemLinkExecPayloadReleaseLoweringAfterPrimary:
        lifecycle.loweringAfterPrimaryReleaseCount = 1
    elif transition == SystemLinkExecPayloadReleaseRuntimeUnused:
        lifecycle.runtimeUnusedReleaseCount = 1
    elif transition == SystemLinkExecPayloadReleasePrimaryBodyIr:
        lifecycle.primaryBodyIrReleaseCount = 1
    elif transition == SystemLinkExecPayloadReleaseProvider:
        lifecycle.providerPayloadReleaseCount = 1
    elif transition == SystemLinkExecPayloadReleaseNative:
        lifecycle.nativePayloadReleaseCount = 1
    elif transition == SystemLinkExecPayloadReleaseLoweringTerminal:
        lifecycle.loweringTerminalReleaseCount = 1
    else:
        err = "system link exec: unknown payload lifecycle transition"
        return false
    err = ""
    return true

@borrows
fn SystemLinkExecPayloadLifecycleRequireTransitionReady(
        lifecycle: SystemLinkExecPayloadLifecycle,
        transition: SystemLinkExecPayloadTransition) =
    var transitionErr: str
    if !SystemLinkExecPayloadLifecycleCanTransition(lifecycle,
                                                    transition,
                                                    transitionErr):
        panic(transitionErr)

fn SystemLinkExecPayloadLifecycleTransition(
        lifecycle: var SystemLinkExecPayloadLifecycle,
        transition: SystemLinkExecPayloadTransition) =
    var transitionErr: str
    if !SystemLinkExecPayloadLifecycleTryTransition(lifecycle,
                                                   transition,
                                                   transitionErr):
        panic(transitionErr)

fn SystemLinkExecPayloadLifecycleMarkSystemLinkExprConsumed(
        lifecycle: var SystemLinkExecPayloadLifecycle,
        linkPlan: var slplan.SystemLinkPlanStub) =
    SystemLinkExecPayloadLifecycleRequireTransitionReady(
        lifecycle,
        SystemLinkExecPayloadConsumeSystemLinkExpr)
    if linkPlan.exprLayer.exprs.len != 0 ||
       linkPlan.exprLayer.exprNext.len != 0 ||
       linkPlan.exprLayer.exprLookup.slots.len != 0 ||
       linkPlan.exprLayer.exprLookup.buckets.len != 0 ||
       !layout.FixedBytes32Equal(linkPlan.sourceBundleBindingSeal,
                                 layout.FixedBytes32()) ||
       linkPlan.sourceBundleEntrySourceIndex != -1 ||
       linkPlan.externalPackageRoots.len != 0 ||
       linkPlan.sourceBundleIdentityPaths.len != 0 ||
       linkPlan.sourceClosurePaths.len != 0 ||
       linkPlan.ownerModulePaths.len != 0 ||
       linkPlan.importEdges.len != 0 ||
       linkPlan.runtimeTargets.len != 0 ||
       slplan.SystemLinkPlanManagedDependencyReceiptPresent(
            linkPlan.managedDependencyReceipt):
        panic("system link exec: CompilerCSG commit retained borrowed system-link payload")
    SystemLinkExecPayloadLifecycleTransition(
        lifecycle,
        SystemLinkExecPayloadConsumeSystemLinkExpr)

fn SystemLinkExecReleaseSystemLinkCompilerInputOnAbort(
        linkPlan: var slplan.SystemLinkPlanStub,
        owned: var bool) =
    if !owned:
        panic("system link exec: system-link compiler input abort release without ownership")
    var releaseReceipt: slplan.SystemLinkPlanCompilerInputReleaseReceipt
    slplan.SystemLinkPlanCompilerInputReleaseWithReceipt(
        linkPlan, releaseReceipt)
    var releaseErr: str
    if !slplan.SystemLinkPlanCompilerInputReleaseReceiptConsumeStrictInto(
           linkPlan, releaseReceipt, releaseErr):
        panic(releaseErr)
    owned = false

fn SystemLinkExecPayloadLifecycleMarkCompilerCsgBackendReleased(
        lifecycle: var SystemLinkExecPayloadLifecycle,
        loweringPlan: var lower.LoweringPlanStub) =
    SystemLinkExecPayloadLifecycleRequireTransitionReady(
        lifecycle,
        SystemLinkExecPayloadReleaseCompilerCsgBackend)
    if !loweringPlan.compilerCsgBackendPayloadReleased:
        panic("system link exec: lowering completed without releasing CompilerCSG backend payload")
    SystemLinkExecPayloadLifecycleTransition(
        lifecycle,
        SystemLinkExecPayloadReleaseCompilerCsgBackend)

fn SystemLinkExecPayloadLifecycleReleaseLoweringPrePrimary(
        lifecycle: var SystemLinkExecPayloadLifecycle,
        loweringPlan: var lower.LoweringPlanStub) =
    SystemLinkExecPayloadLifecycleRequireTransitionReady(
        lifecycle,
        SystemLinkExecPayloadReleaseLoweringPrePrimary)
    lower.LoweringPlanReleasePrePrimaryObjectPayload(loweringPlan)
    SystemLinkExecPayloadLifecycleTransition(
        lifecycle,
        SystemLinkExecPayloadReleaseLoweringPrePrimary)

fn SystemLinkExecPayloadLifecycleReleaseLoweringAfterPrimary(
        lifecycle: var SystemLinkExecPayloadLifecycle,
        loweringPlan: var lower.LoweringPlanStub) =
    SystemLinkExecPayloadLifecycleRequireTransitionReady(
        lifecycle,
        SystemLinkExecPayloadReleaseLoweringAfterPrimary)
    var releasedBufferCount: int32
    var releasedBytes: int64
    lower.LoweringPlanReleaseAfterPrimaryObjectPlanWithReceipt(
        loweringPlan,
        releasedBufferCount,
        releasedBytes)
    SystemLinkExecPayloadLifecycleTransition(
        lifecycle,
        SystemLinkExecPayloadReleaseLoweringAfterPrimary)

fn SystemLinkExecPlanRequireCompilerCsgPayloadConsumed(
        plan: var SystemLinkExecPlan) =
    if plan.payloadLifecycle.systemLinkExprConsumeCount != 1 ||
       plan.payloadLifecycle.compilerCsgBackendReleaseCount != 1:
        panic("system link exec: terminal release before compiler payload consumption")
    if plan.systemLinkPlan.exprLayer.exprs.len != 0 ||
       plan.systemLinkPlan.exprLayer.exprNext.len != 0 ||
       !layout.FixedBytes32Equal(plan.systemLinkPlan.sourceBundleBindingSeal,
                                 layout.FixedBytes32()) ||
       plan.systemLinkPlan.sourceBundleEntrySourceIndex != -1 ||
       plan.systemLinkPlan.externalPackageRoots.len != 0 ||
       plan.systemLinkPlan.sourceBundleIdentityPaths.len != 0 ||
       plan.systemLinkPlan.sourceClosurePaths.len != 0 ||
       plan.systemLinkPlan.ownerModulePaths.len != 0 ||
       plan.systemLinkPlan.importEdges.len != 0 ||
       plan.systemLinkPlan.runtimeTargets.len != 0:
        panic("system link exec: execution found duplicate system-link owner")

fn systemLinkExecRuntimeMetadataAppendU32BE(
        buf: var layout.ByteBuf,
        value: int64) =
    layout.ByteBufAppendByte(buf, Int32((value >> 24) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 16) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 8) & 255))
    layout.ByteBufAppendByte(buf, Int32(value & 255))

@borrows
fn systemLinkExecRuntimeMetadataAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    systemLinkExecRuntimeMetadataAppendU32BE(buf, value.len)
    for textIndex in 0..<value.len:
        layout.ByteBufAppendByte(buf, value[textIndex])

fn systemLinkExecRuntimeMetadataAppendU32Field(
        buf: var layout.ByteBuf,
        value: int64) =
    systemLinkExecRuntimeMetadataAppendU32BE(buf, 4)
    systemLinkExecRuntimeMetadataAppendU32BE(buf, value)

fn systemLinkExecRuntimeMetadataAppendI64Field(
        buf: var layout.ByteBuf,
        value: int64) =
    systemLinkExecRuntimeMetadataAppendU32BE(buf, 8)
    systemLinkExecRuntimeMetadataAppendU32BE(buf, value >> 32)
    systemLinkExecRuntimeMetadataAppendU32BE(buf, value)

@borrows
fn systemLinkExecRuntimeMetadataAppendFixed32Field(
        buf: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    systemLinkExecRuntimeMetadataAppendU32BE(buf, 32)
    for byteIndex in 0..<32:
        layout.ByteBufAppendByte(
            buf, int32(value.data[byteIndex]))

@borrows
fn systemLinkExecFixed32CopyInto(
        out: var layout.FixedBytes32,
        value: layout.FixedBytes32) =
    for byteIndex in 0..<32:
        out.data[byteIndex] = value.data[byteIndex]

@borrows
fn systemLinkExecRuntimeMetadataAppendTexts(
        buf: var layout.ByteBuf,
        values: str[]) =
    systemLinkExecRuntimeMetadataAppendU32Field(buf, values.len)
    for valueIndex in 0..<values.len:
        systemLinkExecRuntimeMetadataAppendText(
            buf, values[valueIndex])

fn SystemLinkExecRuntimeMetadataRetainedBufferCount(
        plan: var SystemLinkExecPlan): int32 =
    return csglife.CompilerCsgProductionLifetimeControllerRetainedBufferCount(
            plan.compilerCsgProductionLifetime) +
        ccsg.CompilerCsgLifecycleTrackedPhysicalBufferCount(
            plan.compilerCsg) +
        ccsg.CompilerExportSurfaceRetainedBufferCount(
            plan.exportSurface) +
        cworld.CompilerLocalUniverseRetainedBufferCount(
            plan.localUniverse) +
        ccsg.CompileReceiptRetainedBufferCount(
            plan.compileReceipt) +
        slplan.SystemLinkPlanManagedDependencyReceiptRetainedBufferCount(
            plan.managedDependencyReceipt) +
        (plan.requestProviderObjectPaths.cap > 0 ? 1 : 0)

fn SystemLinkExecRuntimeMetadataRetainedBytes(
        plan: var SystemLinkExecPlan): int64 =
    var total =
        csglife.CompilerCsgProductionLifetimeControllerRetainedBytes(
            plan.compilerCsgProductionLifetime) +
        ccsg.CompilerCsgLifecycleRetainedBytes(plan.compilerCsg) +
        ccsg.CompilerExportSurfaceRetainedBytes(plan.exportSurface) +
        cworld.CompilerLocalUniverseRetainedBytes(plan.localUniverse) +
        ccsg.CompileReceiptRetainedBytes(plan.compileReceipt) +
        int64(plan.notReadyReason.len) +
        int64(plan.compilerEntrySource.len) +
        slplan.SystemLinkPlanManagedDependencyReceiptRetainedBytes(
            plan.managedDependencyReceipt) +
        int64(plan.lockPath.len) +
        int64(plan.baselineSurfacePath.len) +
        int64(plan.phaseMemoryLedger.csgToLoweringAndBackendRelease.top0Kind.len) +
        int64(plan.phaseMemoryLedger.csgToLoweringAndBackendRelease.top1Kind.len) +
        int64(plan.phaseMemoryLedger.loweringPreRelease.top0Kind.len) +
        int64(plan.phaseMemoryLedger.loweringPreRelease.top1Kind.len) +
        int64(plan.phaseMemoryLedger.primaryBuild.top0Kind.len) +
        int64(plan.phaseMemoryLedger.primaryBuild.top1Kind.len) +
        int64(plan.phaseMemoryLedger.primaryRelease.top0Kind.len) +
        int64(plan.phaseMemoryLedger.primaryRelease.top1Kind.len) +
        int64(plan.phaseMemoryLedger.loweringTerminalRelease.top0Kind.len) +
        int64(plan.phaseMemoryLedger.loweringTerminalRelease.top1Kind.len) +
        int64(plan.phaseMemoryLedger.reportPayloadAssembly.top0Kind.len) +
        int64(plan.phaseMemoryLedger.reportPayloadAssembly.top1Kind.len) +
        int64(plan.exactFunctionCoverage.entrySourcePath.len) +
        int64(plan.exactFunctionCoverage.targetSourcePath.len) +
        int64(plan.exactFunctionCoverage.targetTriple.len) +
        int64(plan.exactFunctionCoverage.driverPath.len) +
        int64(plan.exactFunctionCoverage.functionName.len) +
        int64(plan.exactFunctionCoverage.outputKind.len) +
        int64(plan.exactFunctionCoverage.outputPath.len) +
        int64(plan.requestProviderObjectPaths.cap) *
            int64(sizeof(str)) +
        int64(plan.requestRuntimeProviderBundle.len)
    for providerIndex in 0..<plan.requestProviderObjectPaths.len:
        total = total +
            int64(plan.requestProviderObjectPaths[providerIndex].len)
    return total

fn SystemLinkExecRuntimeMetadataStorageReleased(
        plan: var SystemLinkExecPlan): bool =
    return !plan.compilerCsgProductionLifetime.active &&
           plan.compilerCsgLifetimeReceiptReady &&
           csglife.CompilerCsgProductionLifetimeReceiptClosed(
               plan.compilerCsgLifetimeReceipt) &&
           ccsg.CompilerCsgLifecycleStorageReleased(plan.compilerCsg) &&
           ccsg.CompilerExportSurfaceStorageReleased(plan.exportSurface) &&
           cworld.CompilerLocalUniverseStorageReleased(plan.localUniverse) &&
           ccsg.CompileReceiptStorageReleased(plan.compileReceipt) &&
           plan.notReadyReason == "" &&
           plan.compilerEntrySource == "" &&
           slplan.SystemLinkPlanManagedDependencyReceiptStorageReleased(
               plan.managedDependencyReceipt) &&
           plan.lockPath == "" &&
           plan.baselineSurfacePath == "" &&
           plan.phaseMemoryLedger.csgToLoweringAndBackendRelease.top0Kind == "" &&
           plan.phaseMemoryLedger.csgToLoweringAndBackendRelease.top1Kind == "" &&
           plan.phaseMemoryLedger.loweringPreRelease.top0Kind == "" &&
           plan.phaseMemoryLedger.loweringPreRelease.top1Kind == "" &&
           plan.phaseMemoryLedger.primaryBuild.top0Kind == "" &&
           plan.phaseMemoryLedger.primaryBuild.top1Kind == "" &&
           plan.phaseMemoryLedger.primaryRelease.top0Kind == "" &&
           plan.phaseMemoryLedger.primaryRelease.top1Kind == "" &&
           plan.phaseMemoryLedger.loweringTerminalRelease.top0Kind == "" &&
           plan.phaseMemoryLedger.loweringTerminalRelease.top1Kind == "" &&
           plan.phaseMemoryLedger.reportPayloadAssembly.top0Kind == "" &&
           plan.phaseMemoryLedger.reportPayloadAssembly.top1Kind == "" &&
           plan.exactFunctionCoverage.entrySourcePath == "" &&
           plan.exactFunctionCoverage.targetSourcePath == "" &&
           plan.exactFunctionCoverage.targetTriple == "" &&
           plan.exactFunctionCoverage.driverPath == "" &&
           plan.exactFunctionCoverage.functionName == "" &&
           plan.exactFunctionCoverage.outputKind == "" &&
           plan.exactFunctionCoverage.outputPath == "" &&
           plan.requestProviderObjectPaths.len == 0 &&
           plan.requestProviderObjectPaths.cap == 0 &&
           plan.requestRuntimeProviderBundle == ""

fn systemLinkExecRuntimeMetadataReleaseOwnerToken(
        plan: var SystemLinkExecPlan,
        releasedBufferCount: int32,
        releasedBytes: int64): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(2048)
    systemLinkExecRuntimeMetadataAppendText(
        buf, "cheng.compiler.system_link_exec.runtime_metadata.owner_release")
    systemLinkExecRuntimeMetadataAppendU32Field(
        buf, SystemLinkExecRuntimeMetadataOwnedStorageColumnCount)
    systemLinkExecRuntimeMetadataAppendI64Field(
        buf, plan.allocationOwnerLedger.executionTokenId)
    systemLinkExecRuntimeMetadataAppendI64Field(
        buf,
        SystemLinkExecOwnerLedgerAllocationIdForKind(
            plan.allocationOwnerLedger,
            SystemLinkExecOwnerKindRuntimeMetadata))
    systemLinkExecRuntimeMetadataAppendU32Field(
        buf, releasedBufferCount)
    systemLinkExecRuntimeMetadataAppendI64Field(
        buf, releasedBytes)
    systemLinkExecRuntimeMetadataAppendFixed32Field(
        buf, plan.compilerCsg.sourceBundleCid)
    systemLinkExecRuntimeMetadataAppendFixed32Field(
        buf, plan.compilerCsg.canonicalGraphCid)
    systemLinkExecRuntimeMetadataAppendFixed32Field(
        buf, plan.compilerCsg.sourceIdentityReceipt.receiptCid)
    systemLinkExecRuntimeMetadataAppendFixed32Field(
        buf, plan.exportSurface.surfaceCid)
    systemLinkExecRuntimeMetadataAppendFixed32Field(
        buf, plan.localUniverse.worldHead.headCid)
    systemLinkExecRuntimeMetadataAppendFixed32Field(
        buf, plan.localUniverse.manifest.manifestCid)
    systemLinkExecRuntimeMetadataAppendFixed32Field(
        buf, plan.compileReceipt.receiptCid)
    systemLinkExecRuntimeMetadataAppendFixed32Field(
        buf, plan.managedDependencyReceipt.receiptCid)
    systemLinkExecRuntimeMetadataAppendU32Field(
        buf, int32(plan.requestBackendKind))
    systemLinkExecRuntimeMetadataAppendU32Field(
        buf, plan.requestedJobCount)
    systemLinkExecRuntimeMetadataAppendU32Field(
        buf, int32(plan.requestEmitKind))
    systemLinkExecRuntimeMetadataAppendFixed32Field(
        buf, plan.backendRequestActionCid)
    systemLinkExecRuntimeMetadataAppendFixed32Field(
        buf, plan.backendRequestCid)
    systemLinkExecRuntimeMetadataAppendU32Field(
        buf, plan.requestBindingSealed ? 1 : 0)
    systemLinkExecRuntimeMetadataAppendTexts(
        buf, plan.requestProviderObjectPaths)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.requestRuntimeProviderBundle)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.notReadyReason)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.compilerEntrySource)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.lockPath)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.baselineSurfacePath)
    systemLinkExecRuntimeMetadataAppendTexts(
        buf, plan.exportSurface.exportedSymbols)
    systemLinkExecRuntimeMetadataAppendTexts(
        buf, plan.exportSurface.exportedTargetNames)
    systemLinkExecRuntimeMetadataAppendTexts(
        buf, plan.compileReceipt.runtimeProviderSet)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.phaseMemoryLedger.csgToLoweringAndBackendRelease.top0Kind)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.phaseMemoryLedger.csgToLoweringAndBackendRelease.top1Kind)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.phaseMemoryLedger.loweringPreRelease.top0Kind)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.phaseMemoryLedger.loweringPreRelease.top1Kind)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.phaseMemoryLedger.primaryBuild.top0Kind)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.phaseMemoryLedger.primaryBuild.top1Kind)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.phaseMemoryLedger.primaryRelease.top0Kind)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.phaseMemoryLedger.primaryRelease.top1Kind)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.phaseMemoryLedger.loweringTerminalRelease.top0Kind)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.phaseMemoryLedger.loweringTerminalRelease.top1Kind)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.phaseMemoryLedger.reportPayloadAssembly.top0Kind)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.phaseMemoryLedger.reportPayloadAssembly.top1Kind)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.exactFunctionCoverage.entrySourcePath)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.exactFunctionCoverage.targetSourcePath)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.exactFunctionCoverage.targetTriple)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.exactFunctionCoverage.driverPath)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.exactFunctionCoverage.functionName)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.exactFunctionCoverage.outputKind)
    systemLinkExecRuntimeMetadataAppendText(
        buf, plan.exactFunctionCoverage.outputPath)
    let ownerToken = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return ownerToken

fn SystemLinkExecPlanCloseCompilerCsgProductionLifetime(
        plan: var SystemLinkExecPlan,
        outcome: int32) =
    if plan.compilerCsgLifetimeReceiptReady ||
       !plan.compilerCsgProductionLifetime.active:
        panic("system link exec: invalid CompilerCSG lifetime close")
    if plan.compilerCsgProductionLifetime.lifecycle.movedToConsumer:
        csglife.CompilerCsgProductionLifetimeEndFromLowering(
            plan.compilerCsg,
            plan.loweringPlan,
            plan.compilerCsgProductionLifetime,
            outcome)
    else:
        csglife.CompilerCsgProductionLifetimeEndUnmoved(
            plan.compilerCsg,
            plan.compilerCsgProductionLifetime,
            outcome)
    csglife.CompilerCsgProductionLifetimeReceiptInto(
        plan.compilerCsgProductionLifetime,
        plan.compilerCsgLifetimeReceipt)
    if !csglife.CompilerCsgProductionLifetimeReceiptClosed(
            plan.compilerCsgLifetimeReceipt):
        panic("system link exec: CompilerCSG lifetime receipt not closed")
    var compilerCsgOwnerResourceAfter: compilerlife.CompilerPayloadOwnerResourceTracePoint
    ccsg.CompilerCsgOwnerResourceTracePointReadOnly(
        plan.compilerCsg,
        SystemLinkExecNowNs(),
        plan.compilerCsgOwnerResourceTrace.before.ownerToken,
        int64(plan.compilerCsgLifetimeReceipt.physicalBufferCount),
        plan.compilerCsgLifetimeReceipt.allocatedBytes,
        plan.compilerCsgLifetimeReceipt.physicalFreeCount,
        plan.compilerCsgLifetimeReceipt.releasedBytes,
        true,
        plan.compilerCsgLifetimeReceipt.storageReleased,
        compilerCsgOwnerResourceAfter)
    compilerlife.CompilerPayloadOwnerResourceTraceCompleteInto(
        plan.compilerCsgOwnerResourceTrace.before,
        compilerCsgOwnerResourceAfter,
        plan.compilerCsgOwnerResourceTrace)
    if !compilerlife.CompilerPayloadOwnerResourceTraceClosed(
           plan.compilerCsgOwnerResourceTrace):
        panic("system link exec: CompilerCSG owner/resource trace not closed")
    plan.compilerCsgLifetimeReceiptReady = true

fn SystemLinkExecRuntimeMetadataReleaseWithReceipt(
        plan: var SystemLinkExecPlan,
        compilerCsgLifetimeOutcome: int32,
        receipt: var SystemLinkExecRuntimeMetadataReleaseReceipt) =
    if plan.runtimeMetadataStorageReleased ||
       plan.runtimeMetadataReleaseReceiptConsumed ||
       !layout.FixedBytes32Equal(
           plan.runtimeMetadataReleaseOwnerToken,
           layout.FixedBytes32()) ||
       plan.runtimeMetadataReleasedOwnedStorageColumnCount != 0 ||
       plan.runtimeMetadataReleasedBufferCount != 0 ||
       plan.runtimeMetadataReleasedBytes != int64(0):
        panic("system link exec: duplicate or corrupt runtime metadata release")
    if plan.allocationOwnerLedger.executionTokenId <= int64(0) ||
       SystemLinkExecOwnerLedgerAllocationIdForKind(
           plan.allocationOwnerLedger,
           SystemLinkExecOwnerKindRuntimeMetadata) <= int64(0):
        panic("system link exec: runtime metadata release missing exact owner identity")
    let releasedBufferCount =
        SystemLinkExecRuntimeMetadataRetainedBufferCount(plan)
    let releasedBytes =
        SystemLinkExecRuntimeMetadataRetainedBytes(plan)
    let ownerToken =
        systemLinkExecRuntimeMetadataReleaseOwnerToken(
            plan, releasedBufferCount, releasedBytes)
    if layout.FixedBytes32Equal(ownerToken, layout.FixedBytes32()) ||
       releasedBufferCount < 0 ||
       releasedBytes < int64(0):
        panic("system link exec: invalid runtime metadata release preimage")
    SystemLinkExecPlanCloseCompilerCsgProductionLifetime(
        plan,
        compilerCsgLifetimeOutcome)
    if !plan.compilerCsgLifetimeReceiptReady ||
       !csglife.CompilerCsgProductionLifetimeReceiptClosed(
           plan.compilerCsgLifetimeReceipt):
        panic("system link exec: CompilerCSG lifetime not terminal")
    let compilerCsgResidualReleasedBufferCount =
        plan.compilerCsgLifetimeReceipt.physicalBufferCount -
        lower.LoweringPlanCompilerCsgReleasedBufferCount(
            plan.loweringPlan)
    let compilerCsgResidualReleasedBytes =
        plan.compilerCsgLifetimeReceipt.releasedBytes -
        lower.LoweringPlanCompilerCsgReleasedBytes(
            plan.loweringPlan)
    if compilerCsgResidualReleasedBufferCount < 0 ||
       compilerCsgResidualReleasedBytes < int64(0) ||
       compilerCsgResidualReleasedBufferCount > releasedBufferCount ||
       compilerCsgResidualReleasedBytes > releasedBytes:
        panic("system link exec: CompilerCSG residual release receipt invalid")
    ccsg.CompilerExportSurfaceReleaseOwned(plan.exportSurface)
    cworld.CompilerLocalUniverseReleaseOwned(plan.localUniverse)
    ccsg.CompileReceiptReleaseOwned(plan.compileReceipt)
    plan.notReadyReason = ""
    plan.compilerEntrySource = ""
    slplan.SystemLinkPlanManagedDependencyReceiptReleaseOwned(
        plan.managedDependencyReceipt)
    plan.lockPath = ""
    plan.baselineSurfacePath = ""
    plan.phaseMemoryLedger.csgToLoweringAndBackendRelease.top0Kind = ""
    plan.phaseMemoryLedger.csgToLoweringAndBackendRelease.top1Kind = ""
    plan.phaseMemoryLedger.loweringPreRelease.top0Kind = ""
    plan.phaseMemoryLedger.loweringPreRelease.top1Kind = ""
    plan.phaseMemoryLedger.primaryBuild.top0Kind = ""
    plan.phaseMemoryLedger.primaryBuild.top1Kind = ""
    plan.phaseMemoryLedger.primaryRelease.top0Kind = ""
    plan.phaseMemoryLedger.primaryRelease.top1Kind = ""
    plan.phaseMemoryLedger.loweringTerminalRelease.top0Kind = ""
    plan.phaseMemoryLedger.loweringTerminalRelease.top1Kind = ""
    plan.phaseMemoryLedger.reportPayloadAssembly.top0Kind = ""
    plan.phaseMemoryLedger.reportPayloadAssembly.top1Kind = ""
    plan.exactFunctionCoverage.entrySourcePath = ""
    plan.exactFunctionCoverage.targetSourcePath = ""
    plan.exactFunctionCoverage.targetTriple = ""
    plan.exactFunctionCoverage.driverPath = ""
    plan.exactFunctionCoverage.functionName = ""
    plan.exactFunctionCoverage.outputKind = ""
    plan.exactFunctionCoverage.outputPath = ""
    var requestProviderObjectPaths = plan.requestProviderObjectPaths
    plan.requestProviderObjectPaths = []
    seqs.freeSeqStrRelease(requestProviderObjectPaths)
    plan.requestRuntimeProviderBundle = ""

    systemLinkExecFixed32CopyInto(
        plan.runtimeMetadataReleaseOwnerToken,
        ownerToken)
    plan.runtimeMetadataReleasedOwnedStorageColumnCount =
        SystemLinkExecRuntimeMetadataOwnedStorageColumnCount
    plan.runtimeMetadataReleasedBufferCount =
        releasedBufferCount
    plan.runtimeMetadataReleasedBytes = releasedBytes
    plan.runtimeMetadataStorageReleased =
        SystemLinkExecRuntimeMetadataStorageReleased(plan)
    systemLinkExecFixed32CopyInto(
        receipt.ownerToken,
        ownerToken)
    receipt.releasedOwnedStorageColumnCount =
        SystemLinkExecRuntimeMetadataOwnedStorageColumnCount
    receipt.releasedBufferCount = releasedBufferCount
    receipt.releasedBytes = releasedBytes
    receipt.storageReleased =
        plan.runtimeMetadataStorageReleased
    if !receipt.storageReleased ||
       SystemLinkExecRuntimeMetadataRetainedBufferCount(plan) != 0 ||
       SystemLinkExecRuntimeMetadataRetainedBytes(plan) != int64(0) ||
       compilerCsgResidualReleasedBufferCount > releasedBufferCount ||
       compilerCsgResidualReleasedBytes > releasedBytes:
        panic("system link exec: runtime metadata storage release incomplete")

fn SystemLinkExecRuntimeMetadataReleaseReceiptConsumeStrictInto(
        plan: var SystemLinkExecPlan,
        receipt: var SystemLinkExecRuntimeMetadataReleaseReceipt,
        err: var str): bool =
    err = ""
    if !plan.runtimeMetadataStorageReleased ||
       plan.runtimeMetadataReleaseReceiptConsumed ||
       !receipt.storageReleased ||
       receipt.releasedOwnedStorageColumnCount !=
           SystemLinkExecRuntimeMetadataOwnedStorageColumnCount ||
       receipt.releasedOwnedStorageColumnCount !=
           plan.runtimeMetadataReleasedOwnedStorageColumnCount ||
       receipt.releasedBufferCount !=
           plan.runtimeMetadataReleasedBufferCount ||
       receipt.releasedBytes !=
           plan.runtimeMetadataReleasedBytes ||
       !layout.FixedBytes32Equal(
           receipt.ownerToken,
           plan.runtimeMetadataReleaseOwnerToken) ||
       !SystemLinkExecRuntimeMetadataStorageReleased(plan) ||
       SystemLinkExecRuntimeMetadataRetainedBufferCount(plan) != 0 ||
       SystemLinkExecRuntimeMetadataRetainedBytes(plan) != int64(0):
        err = "system link exec: runtime metadata release receipt mismatch"
        return false
    plan.runtimeMetadataReleaseReceiptConsumed = true
    return true

fn SystemLinkExecPlanExecutionStateValue(plan: var SystemLinkExecPlan): int32 =
    if plan.executionState == nil:
        if plan.payloadFinalizeReceipt.terminalState ==
               SystemLinkExecExecutionCompleted ||
           plan.payloadFinalizeReceipt.terminalState ==
               SystemLinkExecExecutionAborted:
            return plan.payloadFinalizeReceipt.terminalState
        return SystemLinkExecExecutionUninitialized
    return atomic.LoadI32(plan.executionState)

fn systemLinkExecOwnerLedgerAppendI64(
        ledger: var SystemLinkExecAllocationOwnerLedger,
        highs: var arenamod.ArenaArrayInt32,
        lows: var arenamod.ArenaArrayInt32,
        value: int64) =
    # Keep highs/lows as distinct var locals so they do not overlap with
    # ledger.storage (or each other) as multiple var formals in one call.
    arenamod.ArenaArrayInt32AddReserved(
        ledger.storage, highs, int32(value >> 32))
    arenamod.ArenaArrayInt32AddReserved(
        ledger.storage, lows, int32(value))

@borrows
fn systemLinkExecOwnerLedgerI64At(
        ledger: var SystemLinkExecAllocationOwnerLedger,
        highs: arenamod.ArenaArrayInt32,
        lows: arenamod.ArenaArrayInt32,
        ownerRow: int32): int64 =
    let high = arenamod.ArenaArrayInt32Get(
        ledger.storage, highs, ownerRow)
    let low = arenamod.ArenaArrayInt32Get(
        ledger.storage, lows, ownerRow)
    return (int64(high) << 32) |
           (int64(low) & int64(4294967295))

fn systemLinkExecOwnerLedgerSetI64(
        ledger: var SystemLinkExecAllocationOwnerLedger,
        highs: arenamod.ArenaArrayInt32,
        lows: arenamod.ArenaArrayInt32,
        ownerRow: int32,
        value: int64) =
    arenamod.ArenaArrayInt32Set(
        ledger.storage, highs, ownerRow, int32(value >> 32))
    arenamod.ArenaArrayInt32Set(
        ledger.storage, lows, ownerRow, int32(value))

fn systemLinkExecOwnerLedgerAppendFixed32(
        storage: var arenamod.Arena,
        values: var arenamod.ArenaArrayU8,
        value: layout.FixedBytes32) =
    for byteIndex in 0..<32:
        arenamod.ArenaArrayU8AddReserved(
            storage, values, int32(value.data[byteIndex]))

@borrows
fn systemLinkExecOwnerLedgerFixed32At(
        ledger: var SystemLinkExecAllocationOwnerLedger,
        values: arenamod.ArenaArrayU8,
        ownerRow: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    let byteStart = ownerRow * 32
    for byteIndex in 0..<32:
        out.data[byteIndex] = uint8(
            arenamod.ArenaArrayU8Get(
                ledger.storage, values, byteStart + byteIndex))
    return out

fn systemLinkExecOwnerLedgerSetFixed32(
        ledger: var SystemLinkExecAllocationOwnerLedger,
        values: arenamod.ArenaArrayU8,
        ownerRow: int32,
        value: layout.FixedBytes32) =
    let byteStart = ownerRow * 32
    for byteIndex in 0..<32:
        arenamod.ArenaArrayU8Set(
            ledger.storage,
            values,
            byteStart + byteIndex,
            int32(value.data[byteIndex]))

fn SystemLinkExecOwnerLedgerInit(
        ledger: var SystemLinkExecAllocationOwnerLedger,
        executionTokenId: int64) =
    if executionTokenId <= int64(0):
        panic("system link exec: invalid owner ledger execution token")
    if ledger.executionTokenId != int64(0) ||
       ledger.storage.basePtr != nil ||
       ledger.ownerTableLifetime.active ||
       ledger.ownerTableLifetimeReceiptReady:
        panic("system link exec: owner ledger init requires empty state")
    ledger = SystemLinkExecAllocationOwnerLedger()
    ledger.executionTokenId = executionTokenId
    ledger.nextAllocationId = executionTokenId
    ledger.storage = arenamod.ArenaInitDefault(8192)
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           ledger.storage,
           ledger.ownerKinds,
           SystemLinkExecOwnerRowCapacity) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           ledger.storage,
           ledger.allocationIdHighs,
           SystemLinkExecOwnerRowCapacity) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           ledger.storage,
           ledger.allocationIdLows,
           SystemLinkExecOwnerRowCapacity) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           ledger.storage,
           ledger.requiredFlags,
           SystemLinkExecOwnerRowCapacity) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           ledger.storage,
           ledger.states,
           SystemLinkExecOwnerRowCapacity) ||
       !arenamod.ArenaArrayU8ReserveEmpty(
           ledger.storage,
           ledger.ownerTokenBytes,
           SystemLinkExecOwnerRowCapacity * 32) ||
       !arenamod.ArenaArrayU8ReserveEmpty(
           ledger.storage,
           ledger.receiptCidBytes,
           SystemLinkExecOwnerRowCapacity * 32) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           ledger.storage,
           ledger.releasedOwnedStorageColumnCounts,
           SystemLinkExecOwnerRowCapacity) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           ledger.storage,
           ledger.releasedBufferCounts,
           SystemLinkExecOwnerRowCapacity) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           ledger.storage,
           ledger.releasedBytesHighs,
           SystemLinkExecOwnerRowCapacity) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           ledger.storage,
           ledger.releasedBytesLows,
           SystemLinkExecOwnerRowCapacity) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           ledger.storage,
           ledger.receiptConsumedFlags,
           SystemLinkExecOwnerRowCapacity):
        panic("system link exec: owner ledger arena reserve failed")
    compilerlife.CompilerPayloadLifecycleBegin(
        ledger.ownerTableLifetime,
        compilerlife.CompilerPayloadKindSystemLinkOwnerLedger,
        int64(arenamod.ArenaCapacity(ledger.storage)),
        1)
    ledger.ownerTableLifetimeReceiptReady = false

fn SystemLinkExecOwnerLedgerMoveToRuntime(
        ledger: var SystemLinkExecAllocationOwnerLedger) =
    if !ledger.ownerTableLifetime.active ||
       ledger.ownerTableLifetimeReceiptReady ||
       ledger.ownerTableLifetime.movedToConsumer ||
       ledger.storage.basePtr == nil ||
       int64(arenamod.ArenaCapacity(ledger.storage)) !=
           ledger.ownerTableLifetime.byteCount:
        panic("system link exec: owner ledger lifetime move invalid")
    compilerlife.CompilerPayloadLifecycleBorrowForConsumer(
        ledger.ownerTableLifetime)
    compilerlife.CompilerPayloadLifecycleReturnConsumerBorrow(
        ledger.ownerTableLifetime)
    compilerlife.CompilerPayloadLifecycleMoveToConsumer(
        ledger.ownerTableLifetime)

fn SystemLinkExecOwnerLedgerAppend(
        ledger: var SystemLinkExecAllocationOwnerLedger,
        ownerKind: int32,
        required: bool): int32 =
    if !ledger.ownerTableLifetime.active ||
       ledger.ownerTableLifetimeReceiptReady ||
       ledger.ownerTableLifetime.movedToConsumer ||
       ledger.storage.basePtr == nil ||
       ledger.ownerRowCount >= SystemLinkExecOwnerRowCapacity:
        panic("system link exec: owner ledger append outside live capacity")
    for existingRow in 0..<ledger.ownerRowCount:
        if arenamod.ArenaArrayInt32Get(
               ledger.storage,
               ledger.ownerKinds,
               existingRow) == ownerKind:
            panic("system link exec: duplicate owner kind row")
    ledger.nextAllocationId = ledger.nextAllocationId + int64(1)
    if ledger.nextAllocationId <= ledger.executionTokenId:
        panic("system link exec: owner allocation id overflow")
    let ownerRow = ledger.ownerRowCount
    var ownerKinds = ledger.ownerKinds
    arenamod.ArenaArrayInt32AddReserved(
        ledger.storage, ownerKinds, ownerKind)
    ledger.ownerKinds = ownerKinds
    var allocationIdHighs = ledger.allocationIdHighs
    var allocationIdLows = ledger.allocationIdLows
    systemLinkExecOwnerLedgerAppendI64(
        ledger,
        allocationIdHighs,
        allocationIdLows,
        ledger.nextAllocationId)
    ledger.allocationIdHighs = allocationIdHighs
    ledger.allocationIdLows = allocationIdLows
    var requiredFlag: int32
    if required:
        requiredFlag = 1
        ledger.requiredOwnerCount =
            ledger.requiredOwnerCount + 1
    var requiredFlags = ledger.requiredFlags
    arenamod.ArenaArrayInt32AddReserved(
        ledger.storage, requiredFlags, requiredFlag)
    ledger.requiredFlags = requiredFlags
    var states = ledger.states
    arenamod.ArenaArrayInt32AddReserved(
        ledger.storage,
        states,
        SystemLinkExecOwnerStateAcquired)
    ledger.states = states
    var emptyOwnerToken: layout.FixedBytes32
    var ownerTokenBytes = ledger.ownerTokenBytes
    systemLinkExecOwnerLedgerAppendFixed32(
        ledger.storage,
        ownerTokenBytes,
        emptyOwnerToken)
    ledger.ownerTokenBytes = ownerTokenBytes
    var emptyReceiptCid: layout.FixedBytes32
    var receiptCidBytes = ledger.receiptCidBytes
    systemLinkExecOwnerLedgerAppendFixed32(
        ledger.storage,
        receiptCidBytes,
        emptyReceiptCid)
    ledger.receiptCidBytes = receiptCidBytes
    var releasedOwnedStorageColumnCounts =
        ledger.releasedOwnedStorageColumnCounts
    arenamod.ArenaArrayInt32AddReserved(
        ledger.storage,
        releasedOwnedStorageColumnCounts,
        0)
    ledger.releasedOwnedStorageColumnCounts =
        releasedOwnedStorageColumnCounts
    var releasedBufferCounts = ledger.releasedBufferCounts
    arenamod.ArenaArrayInt32AddReserved(
        ledger.storage, releasedBufferCounts, 0)
    ledger.releasedBufferCounts = releasedBufferCounts
    var releasedBytesHighs = ledger.releasedBytesHighs
    var releasedBytesLows = ledger.releasedBytesLows
    systemLinkExecOwnerLedgerAppendI64(
        ledger,
        releasedBytesHighs,
        releasedBytesLows,
        int64(0))
    ledger.releasedBytesHighs = releasedBytesHighs
    ledger.releasedBytesLows = releasedBytesLows
    var receiptConsumedFlags = ledger.receiptConsumedFlags
    arenamod.ArenaArrayInt32AddReserved(
        ledger.storage, receiptConsumedFlags, 0)
    ledger.receiptConsumedFlags = receiptConsumedFlags
    ledger.ownerRowCount = ledger.ownerRowCount + 1
    return ownerRow

fn SystemLinkExecOwnerLedgerRowForKind(
        ledger: var SystemLinkExecAllocationOwnerLedger,
        ownerKind: int32): int32 =
    var foundRow: int32 = -1
    for ownerRow in 0..<ledger.ownerRowCount:
        if arenamod.ArenaArrayInt32Get(
               ledger.storage,
               ledger.ownerKinds,
               ownerRow) == ownerKind:
            if foundRow >= 0:
                panic("system link exec: ambiguous owner kind row")
            foundRow = ownerRow
    return foundRow

fn SystemLinkExecOwnerLedgerAllocationIdForKind(
        ledger: var SystemLinkExecAllocationOwnerLedger,
        ownerKind: int32): int64 =
    let ownerRow =
        SystemLinkExecOwnerLedgerRowForKind(ledger, ownerKind)
    if ownerRow < 0:
        return int64(0)
    return systemLinkExecOwnerLedgerI64At(
        ledger,
        ledger.allocationIdHighs,
        ledger.allocationIdLows,
        ownerRow)

fn systemLinkExecOwnerTerminalReceiptCid(
        ledger: var SystemLinkExecAllocationOwnerLedger,
        ownerRow: int32,
        receipt: var SystemLinkExecOwnerTerminalReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    systemLinkExecRuntimeMetadataAppendText(
        buf, "cheng.compiler.system_link_exec.owner_terminal_receipt")
    systemLinkExecRuntimeMetadataAppendI64Field(
        buf, ledger.executionTokenId)
    systemLinkExecRuntimeMetadataAppendU32Field(buf, ownerRow)
    systemLinkExecRuntimeMetadataAppendU32Field(
        buf, receipt.ownerKind)
    systemLinkExecRuntimeMetadataAppendI64Field(
        buf,
        systemLinkExecOwnerLedgerI64At(
            ledger,
            ledger.allocationIdHighs,
            ledger.allocationIdLows,
            ownerRow))
    systemLinkExecRuntimeMetadataAppendFixed32Field(
        buf, receipt.ownerToken)
    systemLinkExecRuntimeMetadataAppendU32Field(
        buf, receipt.releasedOwnedStorageColumnCount)
    systemLinkExecRuntimeMetadataAppendU32Field(
        buf, receipt.releasedBufferCount)
    systemLinkExecRuntimeMetadataAppendI64Field(
        buf, receipt.releasedBytes)
    systemLinkExecRuntimeMetadataAppendU32Field(
        buf, receipt.terminalState)
    let cid = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return cid

fn SystemLinkExecOwnerLedgerRecordTerminalReceipt(
        ledger: var SystemLinkExecAllocationOwnerLedger,
        ownerRow: int32,
        receipt: var SystemLinkExecOwnerTerminalReceipt) =
    if !ledger.ownerTableLifetime.active ||
       ledger.ownerTableLifetimeReceiptReady ||
       ledger.storage.basePtr == nil ||
       (ledger.ownerTableLifetime.movedToConsumer &&
        ledger.ownerTableLifetime.currentOwnerId !=
            ledger.ownerTableLifetime.consumerOwnerId) ||
       (!ledger.ownerTableLifetime.movedToConsumer &&
        ledger.ownerTableLifetime.currentOwnerId !=
            ledger.ownerTableLifetime.producerOwnerId):
        panic("system link exec: terminal receipt outside ledger ownership")
    if ownerRow < 0 || ownerRow >= ledger.ownerRowCount:
        panic("system link exec: terminal receipt owner row out of range")
    let actualKind = arenamod.ArenaArrayInt32Get(
        ledger.storage, ledger.ownerKinds, ownerRow)
    let requiredFlag = arenamod.ArenaArrayInt32Get(
        ledger.storage, ledger.requiredFlags, ownerRow)
    let priorState = arenamod.ArenaArrayInt32Get(
        ledger.storage, ledger.states, ownerRow)
    let priorConsumed = arenamod.ArenaArrayInt32Get(
        ledger.storage, ledger.receiptConsumedFlags, ownerRow)
    if actualKind != receipt.ownerKind ||
       requiredFlag != 1 ||
       priorState != SystemLinkExecOwnerStateAcquired ||
       priorConsumed != 0 ||
       !receipt.terminalProved ||
       layout.FixedBytes32Equal(
           receipt.ownerToken, layout.FixedBytes32()) ||
       receipt.releasedOwnedStorageColumnCount < 0 ||
       receipt.releasedBufferCount < 0 ||
       receipt.releasedBytes < int64(0) ||
       (receipt.terminalState != SystemLinkExecOwnerStateReleased &&
        receipt.terminalState != SystemLinkExecOwnerStateTransferred):
        ledger.duplicateReceiptCount =
            ledger.duplicateReceiptCount + 1
        panic("system link exec: invalid or duplicate terminal owner receipt")
    let receiptCid =
        systemLinkExecOwnerTerminalReceiptCid(
            ledger, ownerRow, receipt)
    if layout.FixedBytes32Equal(receiptCid, layout.FixedBytes32()):
        panic("system link exec: terminal owner receipt cid is zero")
    arenamod.ArenaArrayInt32Set(
        ledger.storage,
        ledger.states,
        ownerRow,
        receipt.terminalState)
    systemLinkExecOwnerLedgerSetFixed32(
        ledger,
        ledger.ownerTokenBytes,
        ownerRow,
        receipt.ownerToken)
    systemLinkExecOwnerLedgerSetFixed32(
        ledger,
        ledger.receiptCidBytes,
        ownerRow,
        receiptCid)
    systemLinkExecFixed32CopyInto(
        receipt.receiptCid,
        receiptCid)
    arenamod.ArenaArrayInt32Set(
        ledger.storage,
        ledger.releasedOwnedStorageColumnCounts,
        ownerRow,
        receipt.releasedOwnedStorageColumnCount)
    arenamod.ArenaArrayInt32Set(
        ledger.storage,
        ledger.releasedBufferCounts,
        ownerRow,
        receipt.releasedBufferCount)
    systemLinkExecOwnerLedgerSetI64(
        ledger,
        ledger.releasedBytesHighs,
        ledger.releasedBytesLows,
        ownerRow,
        receipt.releasedBytes)
    arenamod.ArenaArrayInt32Set(
        ledger.storage,
        ledger.receiptConsumedFlags,
        ownerRow,
        1)
    ledger.terminalOwnerCount = ledger.terminalOwnerCount + 1
    if receipt.terminalState == SystemLinkExecOwnerStateReleased:
        ledger.releasedOwnerCount = ledger.releasedOwnerCount + 1
    else:
        ledger.transferredOwnerCount =
            ledger.transferredOwnerCount + 1
    ledger.receiptCount = ledger.receiptCount + 1
    ledger.releasedOwnedStorageColumnCount =
        ledger.releasedOwnedStorageColumnCount +
        receipt.releasedOwnedStorageColumnCount
    ledger.releasedBufferCount =
        ledger.releasedBufferCount + receipt.releasedBufferCount
    ledger.releasedBytes =
        ledger.releasedBytes + receipt.releasedBytes

@borrows
fn SystemLinkExecOwnerTerminalReceiptMake(
        ownerKind: int32,
        ownerToken: layout.FixedBytes32,
        releasedOwnedStorageColumnCount: int32,
        releasedBufferCount: int32,
        releasedBytes: int64,
        terminalState: int32): SystemLinkExecOwnerTerminalReceipt =
    var receipt: SystemLinkExecOwnerTerminalReceipt
    receipt.ownerKind = ownerKind
    var outToken = receipt.ownerToken
    systemLinkExecFixed32CopyInto(
        outToken,
        ownerToken)
    receipt.ownerToken = outToken
    receipt.releasedOwnedStorageColumnCount =
        releasedOwnedStorageColumnCount
    receipt.releasedBufferCount = releasedBufferCount
    receipt.releasedBytes = releasedBytes
    receipt.terminalState = terminalState
    receipt.terminalProved = true
    return receipt

fn SystemLinkExecPlanRecordOwnerReleaseReceipt(
        plan: var SystemLinkExecPlan,
        ownerKind: int32,
        ownerToken: var layout.FixedBytes32,
        releasedOwnedStorageColumnCount: int32,
        releasedBufferCount: int32,
        releasedBytes: int64) =
    if SystemLinkExecPlanExecutionStateValue(plan) !=
           SystemLinkExecExecutionRunning:
        panic("system link exec: owner release outside running transaction")
    let ownerRow =
        SystemLinkExecOwnerLedgerRowForKind(
            plan.allocationOwnerLedger, ownerKind)
    if ownerRow < 0:
        panic("system link exec: owner release row missing")
    var receipt = SystemLinkExecOwnerTerminalReceiptMake(
        ownerKind,
        ownerToken,
        releasedOwnedStorageColumnCount,
        releasedBufferCount,
        releasedBytes,
        SystemLinkExecOwnerStateReleased)
    SystemLinkExecOwnerLedgerRecordTerminalReceipt(
        plan.allocationOwnerLedger, ownerRow, receipt)
    if ownerKind == SystemLinkExecOwnerKindRuntimeMetadata:
        plan.payloadLifecycle.runtimeUnusedReleaseCount = 1
    elif ownerKind == SystemLinkExecOwnerKindPrimaryBodyIr:
        plan.payloadLifecycle.primaryBodyIrReleaseCount = 1
    elif ownerKind == SystemLinkExecOwnerKindProvider:
        plan.payloadLifecycle.providerPayloadReleaseCount = 1
    elif ownerKind == SystemLinkExecOwnerKindNative:
        plan.payloadLifecycle.nativePayloadReleaseCount = 1
    elif ownerKind == SystemLinkExecOwnerKindLowering:
        plan.payloadLifecycle.loweringTerminalReleaseCount = 1

fn systemLinkExecOwnerLedgerCid(
        ledger: var SystemLinkExecAllocationOwnerLedger): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(2048)
    systemLinkExecRuntimeMetadataAppendText(
        buf, "cheng.compiler.system_link_exec.owner_ledger")
    systemLinkExecRuntimeMetadataAppendI64Field(
        buf, ledger.executionTokenId)
    systemLinkExecRuntimeMetadataAppendU32Field(
        buf, ledger.ownerRowCount)
    for ownerRow in 0..<ledger.ownerRowCount:
        systemLinkExecRuntimeMetadataAppendU32Field(
            buf,
            arenamod.ArenaArrayInt32Get(
                ledger.storage, ledger.ownerKinds, ownerRow))
        systemLinkExecRuntimeMetadataAppendI64Field(
            buf,
            systemLinkExecOwnerLedgerI64At(
                ledger,
                ledger.allocationIdHighs,
                ledger.allocationIdLows,
                ownerRow))
        systemLinkExecRuntimeMetadataAppendU32Field(
            buf,
            arenamod.ArenaArrayInt32Get(
                ledger.storage, ledger.requiredFlags, ownerRow))
        systemLinkExecRuntimeMetadataAppendU32Field(
            buf,
            arenamod.ArenaArrayInt32Get(
                ledger.storage, ledger.states, ownerRow))
        let ownerToken = systemLinkExecOwnerLedgerFixed32At(
            ledger, ledger.ownerTokenBytes, ownerRow)
        systemLinkExecRuntimeMetadataAppendFixed32Field(
            buf, ownerToken)
        let receiptCid = systemLinkExecOwnerLedgerFixed32At(
            ledger, ledger.receiptCidBytes, ownerRow)
        systemLinkExecRuntimeMetadataAppendFixed32Field(
            buf, receiptCid)
        systemLinkExecRuntimeMetadataAppendU32Field(
            buf,
            arenamod.ArenaArrayInt32Get(
                ledger.storage,
                ledger.releasedOwnedStorageColumnCounts,
                ownerRow))
        systemLinkExecRuntimeMetadataAppendU32Field(
            buf,
            arenamod.ArenaArrayInt32Get(
                ledger.storage,
                ledger.releasedBufferCounts,
                ownerRow))
        systemLinkExecRuntimeMetadataAppendI64Field(
            buf,
            systemLinkExecOwnerLedgerI64At(
                ledger,
                ledger.releasedBytesHighs,
                ledger.releasedBytesLows,
                ownerRow))
    let cid = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return cid

fn SystemLinkExecOwnerLedgerStrictValidate(
        ledger: var SystemLinkExecAllocationOwnerLedger) =
    if !ledger.ownerTableLifetime.active ||
       ledger.ownerTableLifetimeReceiptReady ||
       !ledger.ownerTableLifetime.movedToConsumer ||
       ledger.storage.basePtr == nil:
        panic("system link exec: owner ledger validation outside runtime ownership")
    if ledger.ownerRowCount != SystemLinkExecRequiredOwnerCount ||
       ledger.requiredOwnerCount != SystemLinkExecRequiredOwnerCount ||
       ledger.terminalOwnerCount != ledger.requiredOwnerCount ||
       ledger.receiptCount != ledger.requiredOwnerCount ||
       ledger.duplicateReceiptCount != 0:
        panic("system link exec: terminal owner row coverage incomplete")
    var terminalCount: int32
    var releasedCount: int32
    var transferredCount: int32
    var columnCount: int32
    var bufferCount: int32
    var byteCount: int64
    for ownerRow in 0..<ledger.ownerRowCount:
        let state = arenamod.ArenaArrayInt32Get(
            ledger.storage, ledger.states, ownerRow)
        if arenamod.ArenaArrayInt32Get(
               ledger.storage,
               ledger.requiredFlags,
               ownerRow) != 1 ||
           arenamod.ArenaArrayInt32Get(
               ledger.storage,
               ledger.receiptConsumedFlags,
               ownerRow) != 1 ||
           (state != SystemLinkExecOwnerStateReleased &&
            state != SystemLinkExecOwnerStateTransferred) ||
           layout.FixedBytes32Equal(
               systemLinkExecOwnerLedgerFixed32At(
                   ledger, ledger.ownerTokenBytes, ownerRow),
               layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(
               systemLinkExecOwnerLedgerFixed32At(
                   ledger, ledger.receiptCidBytes, ownerRow),
               layout.FixedBytes32()):
            panic("system link exec: terminal owner row proof incomplete")
        terminalCount = terminalCount + 1
        if state == SystemLinkExecOwnerStateReleased:
            releasedCount = releasedCount + 1
        else:
            transferredCount = transferredCount + 1
        columnCount =
            columnCount +
            arenamod.ArenaArrayInt32Get(
                ledger.storage,
                ledger.releasedOwnedStorageColumnCounts,
                ownerRow)
        bufferCount =
            bufferCount +
            arenamod.ArenaArrayInt32Get(
                ledger.storage,
                ledger.releasedBufferCounts,
                ownerRow)
        byteCount =
            byteCount +
            systemLinkExecOwnerLedgerI64At(
                ledger,
                ledger.releasedBytesHighs,
                ledger.releasedBytesLows,
                ownerRow)
    if terminalCount != ledger.terminalOwnerCount ||
       releasedCount != ledger.releasedOwnerCount ||
       transferredCount != ledger.transferredOwnerCount ||
       columnCount != ledger.releasedOwnedStorageColumnCount ||
       bufferCount != ledger.releasedBufferCount ||
       byteCount != ledger.releasedBytes:
        panic("system link exec: terminal owner byte conservation failed")

fn SystemLinkExecOwnerLedgerReleaseStorage(
        ledger: var SystemLinkExecAllocationOwnerLedger,
        outcome: int32) =
    if ledger.storage.basePtr == nil:
        panic("system link exec: owner ledger storage already released")
    if !ledger.ownerTableLifetime.active ||
       ledger.ownerTableLifetimeReceiptReady ||
       ledger.ownerTableLifetime.terminalPrepared ||
       ledger.ownerTableLifetime.consumerBorrowActive ||
       ledger.ownerTableLifetime.terminalConsumerBorrowActive:
        panic("system link exec: owner ledger lifetime state invalid")
    if !compilerlife.CompilerPayloadOutcomeValid(outcome):
        panic("system link exec: owner ledger lifetime outcome invalid")
    ledger.ownerTableReleasedBytes =
        int64(arenamod.ArenaCapacity(ledger.storage))
    if ledger.ownerTableReleasedBytes !=
           ledger.ownerTableLifetime.byteCount:
        panic("system link exec: owner ledger arena capacity drift")
    let storageBase = ledger.storage.basePtr
    ledger.storage = arenamod.Arena()
    arenamod.ArenaFreeBase(storageBase)
    ledger.ownerKinds = arenamod.ArenaArrayInt32()
    ledger.allocationIdHighs = arenamod.ArenaArrayInt32()
    ledger.allocationIdLows = arenamod.ArenaArrayInt32()
    ledger.requiredFlags = arenamod.ArenaArrayInt32()
    ledger.states = arenamod.ArenaArrayInt32()
    ledger.ownerTokenBytes = arenamod.ArenaArrayU8()
    ledger.receiptCidBytes = arenamod.ArenaArrayU8()
    ledger.releasedOwnedStorageColumnCounts =
        arenamod.ArenaArrayInt32()
    ledger.releasedBufferCounts = arenamod.ArenaArrayInt32()
    ledger.releasedBytesHighs = arenamod.ArenaArrayInt32()
    ledger.releasedBytesLows = arenamod.ArenaArrayInt32()
    ledger.receiptConsumedFlags = arenamod.ArenaArrayInt32()
    ledger.ownerTableStorageReleased =
        ledger.storage.basePtr == nil &&
        ledger.storage.capacityBytes == 0
    var physicalRelease: compilerlife.CompilerPayloadPhysicalReleaseReceipt
    physicalRelease.releasedBufferCount = 1
    physicalRelease.releasedBytes =
        ledger.ownerTableReleasedBytes
    physicalRelease.storageReleased =
        ledger.ownerTableStorageReleased
    compilerlife.CompilerPayloadLifecyclePrepareTerminal(
        ledger.ownerTableLifetime)
    compilerlife.CompilerPayloadLifecycleEnd(
        ledger.ownerTableLifetime,
        outcome,
        physicalRelease,
        ledger.ownerTableLifetimeReceipt)
    ledger.ownerTableLifetimeReceiptReady =
        compilerlife.CompilerPayloadLifecycleReceiptClosed(
            ledger.ownerTableLifetimeReceipt)
    if !ledger.ownerTableLifetimeReceiptReady:
        panic("system link exec: owner ledger lifetime receipt incomplete")

@borrows
fn systemLinkExecOwnerLedgerInt32ColumnReleased(
        values: arenamod.ArenaArrayInt32): bool =
    return values.offset == 0 &&
           values.len == 0 &&
           values.capacity == 0 &&
           values.generation == 0

@borrows
fn systemLinkExecOwnerLedgerU8ColumnReleased(
        values: arenamod.ArenaArrayU8): bool =
    return values.offset == 0 &&
           values.len == 0 &&
           values.capacity == 0 &&
           values.generation == 0

fn SystemLinkExecOwnerLedgerStorageReleased(
        ledger: var SystemLinkExecAllocationOwnerLedger): bool =
    return ledger.ownerTableStorageReleased &&
           ledger.storage.basePtr == nil &&
           ledger.storage.capacityBytes == 0 &&
           systemLinkExecOwnerLedgerInt32ColumnReleased(
               ledger.ownerKinds) &&
           systemLinkExecOwnerLedgerInt32ColumnReleased(
               ledger.allocationIdHighs) &&
           systemLinkExecOwnerLedgerInt32ColumnReleased(
               ledger.allocationIdLows) &&
           systemLinkExecOwnerLedgerInt32ColumnReleased(
               ledger.requiredFlags) &&
           systemLinkExecOwnerLedgerInt32ColumnReleased(
               ledger.states) &&
           systemLinkExecOwnerLedgerU8ColumnReleased(
               ledger.ownerTokenBytes) &&
           systemLinkExecOwnerLedgerU8ColumnReleased(
               ledger.receiptCidBytes) &&
           systemLinkExecOwnerLedgerInt32ColumnReleased(
               ledger.releasedOwnedStorageColumnCounts) &&
           systemLinkExecOwnerLedgerInt32ColumnReleased(
               ledger.releasedBufferCounts) &&
           systemLinkExecOwnerLedgerInt32ColumnReleased(
               ledger.releasedBytesHighs) &&
           systemLinkExecOwnerLedgerInt32ColumnReleased(
               ledger.releasedBytesLows) &&
           systemLinkExecOwnerLedgerInt32ColumnReleased(
               ledger.receiptConsumedFlags) &&
           !ledger.ownerTableLifetime.active &&
           ledger.ownerTableLifetimeReceiptReady &&
           compilerlife.CompilerPayloadLifecycleReceiptClosed(
               ledger.ownerTableLifetimeReceipt) &&
           ledger.ownerTableLifetimeReceipt.allocated == int64(1) &&
           ledger.ownerTableLifetimeReceipt.released == int64(1) &&
           ledger.ownerTableLifetimeReceipt.live == int64(0) &&
           ledger.ownerTableLifetimeReceipt.retained == int64(1) &&
           ledger.ownerTableLifetimeReceipt.borrowReturnCount == int64(1) &&
           ledger.ownerTableLifetimeReceipt.ownerTransferCount == int64(1) &&
           ledger.ownerTableLifetimeReceipt.physicalBufferCount == 1 &&
           ledger.ownerTableLifetimeReceipt.physicalFreeCount == int64(1) &&
           ledger.ownerTableLifetimeReceipt.liveBytes == int64(0) &&
           ledger.ownerTableLifetimeReceipt.releasedBytes ==
               ledger.ownerTableReleasedBytes

fn SystemLinkExecPlanBeginExecution(plan: var SystemLinkExecPlan,
                                    err: var str): bool =
    err = ""
    if !SystemLinkExecPlanCidChainStrictValidateInto(
           plan, err):
        return false
    if plan.readyCode != 1:
        var firstPrimaryMissing = "-"
        if plan.primaryObjectPlan.missingReasons.len > 0:
            firstPrimaryMissing = plan.primaryObjectPlan.missingReasons[0]
        var firstLoweringMissing = "-"
        if plan.loweringPlan.missingReasons.len > 0:
            firstLoweringMissing = plan.loweringPlan.missingReasons[0]
        var abortReason = plan.primaryObjectPlan.streamedBuildAbortReason
        if abortReason == "":
            abortReason = "-"
        var errBodyKind = plan.primaryObjectPlan.error.bodyKind
        if errBodyKind == "":
            errBodyKind = "-"
        var errFn = plan.primaryObjectPlan.error.functionName
        if errFn == "":
            errFn = "-"
        err = Fmt"system link exec: cannot execute a plan that is not ready reason={plan.notReadyReason} code={plan.notReadyCode} detail={plan.notReadyDetailCode} primary_missing={plan.primaryPlanMissingCount} lowering_missing={plan.loweringMissingCount} lowering_fns={plan.loweringFunctionCount} reachable={plan.primaryPlanReachableFunctionCount} items={plan.primaryPlanItemCount} words={plan.primaryPlanInstructionWordCount} body_kind={errBodyKind} fn={errFn} abort={abortReason} primary0={firstPrimaryMissing} lowering0={firstLoweringMissing}"
        return false
    if plan.executionState == nil:
        if plan.payloadFinalizeReceipt.terminalState ==
               SystemLinkExecExecutionCompleted ||
           plan.payloadFinalizeReceipt.terminalState ==
               SystemLinkExecExecutionAborted:
            err = Fmt"system link exec: plan execution token is not reusable state={plan.payloadFinalizeReceipt.terminalState}"
            return false
        err = "system link exec: execution token is not initialized"
        return false
    if !atomic.CasI32(plan.executionState,
                      SystemLinkExecExecutionReady,
                      SystemLinkExecExecutionRunning):
        let state = atomic.LoadI32(plan.executionState)
        err = Fmt"system link exec: plan execution token is not reusable state={state}"
        return false
    SystemLinkExecOwnerLedgerMoveToRuntime(
        plan.allocationOwnerLedger)
    return true

fn SystemLinkExecPlanBeginDiscard(
        plan: var SystemLinkExecPlan): bool =
    if !plan.compilerCsgProductionLifetime.active ||
       plan.compilerCsgLifetimeReceiptReady:
        return false
    if plan.executionState == nil:
        panic("system link exec: active plan missing discard token")
    if atomic.CasI32(
           plan.executionState,
           SystemLinkExecExecutionReady,
           SystemLinkExecExecutionRunning):
        SystemLinkExecOwnerLedgerMoveToRuntime(
            plan.allocationOwnerLedger)
        return true
    let state = atomic.LoadI32(plan.executionState)
    if state == SystemLinkExecExecutionRunning:
        return false
    panic(Fmt"system link exec: active plan has invalid discard state={state}")

@borrows
fn SystemLinkExecPlanCompleteExecution(plan: var SystemLinkExecPlan,
                                       succeeded: bool,
                                       reason: str) =
    if !plan.allocationOwnerLedger.ownerTableLifetime.active ||
       !plan.allocationOwnerLedger.ownerTableLifetime.movedToConsumer:
        panic("system link exec: owner ledger was not moved to runtime")
    if plan.loweringPayloadLifecycle.active ||
       !plan.loweringLifetimeReceiptReady ||
       !compilerlife.CompilerPayloadLifecycleReceiptClosed(
           plan.loweringLifetimeReceipt):
        panic("system link exec: lowering lifetime receipt is not closed")
    if !compilerlife.CompilerPayloadOwnerResourceTraceClosed(
           plan.compilerCsgOwnerResourceTrace) ||
       !compilerlife.CompilerPayloadOwnerResourceTraceClosed(
           plan.loweringPlan.ownerResourceTrace):
        panic("system link exec: terminal owner/resource trace is not closed")
    SystemLinkExecOwnerLedgerStrictValidate(
        plan.allocationOwnerLedger)
    var terminalState = SystemLinkExecExecutionAborted
    if succeeded:
        terminalState = SystemLinkExecExecutionCompleted
    if !atomic.CasI32(plan.executionState,
                      SystemLinkExecExecutionRunning,
                      terminalState):
        panic("system link exec: execution token terminal transition failed")
    var receipt: SystemLinkExecPayloadFinalizeReceipt
    receipt.executionTokenId =
        plan.allocationOwnerLedger.executionTokenId
    receipt.terminalState = terminalState
    receipt.requiredOwnerCount =
        plan.allocationOwnerLedger.requiredOwnerCount
    receipt.terminalOwnerCount =
        plan.allocationOwnerLedger.terminalOwnerCount
    receipt.releasedOwnerCount =
        plan.allocationOwnerLedger.releasedOwnerCount
    receipt.transferredOwnerCount =
        plan.allocationOwnerLedger.transferredOwnerCount
    receipt.receiptCount =
        plan.allocationOwnerLedger.receiptCount
    receipt.duplicateReceiptCount =
        plan.allocationOwnerLedger.duplicateReceiptCount
    receipt.releasedOwnedStorageColumnCount =
        plan.allocationOwnerLedger.releasedOwnedStorageColumnCount
    receipt.releasedBufferCount =
        plan.allocationOwnerLedger.releasedBufferCount
    receipt.releasedBytes =
        plan.allocationOwnerLedger.releasedBytes
    receipt.retainedPayloadEstimateBeforeBytes =
        plan.allocationOwnerLedger.retainedPayloadEstimateBeforeBytes
    receipt.retainedPayloadEstimateAfterBytes =
        plan.allocationOwnerLedger.retainedPayloadEstimateAfterBytes
    plan.allocationOwnerLedger.ownerTableCid =
        systemLinkExecOwnerLedgerCid(plan.allocationOwnerLedger)
    receipt.ownerTableCid =
        plan.allocationOwnerLedger.ownerTableCid
    receipt.reasonCode = 2
    if succeeded:
        receipt.reasonCode = 1
    receipt.reasonCid = SystemLinkExecSemanticTextCid(
        "cheng.compiler.system_link_exec.terminal_reason",
        reason)
    receipt.completed = succeeded
    receipt.aborted = !succeeded
    var ownerTableLifetimeOutcome =
        compilerlife.CompilerPayloadOutcomeDiagnostic
    if succeeded:
        ownerTableLifetimeOutcome =
            compilerlife.CompilerPayloadOutcomeSuccess
    SystemLinkExecOwnerLedgerReleaseStorage(
        plan.allocationOwnerLedger,
        ownerTableLifetimeOutcome)
    receipt.ownerTableReleasedBytes =
        plan.allocationOwnerLedger.ownerTableReleasedBytes
    receipt.ownerTableStorageReleased =
        SystemLinkExecOwnerLedgerStorageReleased(
            plan.allocationOwnerLedger)
    receipt.ownerTableLifetimeReceipt =
        plan.allocationOwnerLedger.ownerTableLifetimeReceipt
    receipt.compilerCsgOwnerResourceTrace =
        plan.compilerCsgOwnerResourceTrace
    receipt.loweringOwnerResourceTrace =
        plan.loweringPlan.ownerResourceTrace
    plan.executionState = nil
    plan.payloadFinalizeReceipt = receipt

@borrows
fn SystemLinkExecObjectPlanRetainedItemCount(plan: objplan.ObjectPlanStub): int32 =
    return plan.providerModules.len +
           plan.providerSourcePaths.len +
           plan.providerObjectPaths.len +
           plan.linkInputPaths.len +
           plan.loweredFunctionSymbols.len +
           plan.missingReasons.len

@borrows
fn SystemLinkExecNativePlanRetainedItemCount(plan: nplan.NativeLinkPlanStub): int32 =
    return plan.linkInputPaths.len + plan.missingReasons.len

fn SystemLinkExecPlanRetainedPayloadDiagnosticEstimateBytes(
        plan: var SystemLinkExecPlan): int64 =
    let csgItems = plan.compilerCsg.nodes.len +
                   plan.compilerCsg.edges.len +
                   plan.compilerCsg.typedExprFacts.count +
                   plan.compilerCsg.typedIr.nodes2_nodeIndexs.len +
                   plan.compilerCsg.typedIr.statements2_statementIndexs.len
    let csgBytes = int64(csgItems) * int64(64)
    let loweringBytes = lower.LoweringPlanRetainedApproxBytes(plan.loweringPlan)
    let primaryBytes = pobj.PrimaryObjectPlanRetainedApproxBytes(plan.primaryObjectPlan)
    let objectBytes = int64(SystemLinkExecObjectPlanRetainedItemCount(plan.objectPlan)) * int64(32)
    let nativeBytes = int64(SystemLinkExecNativePlanRetainedItemCount(plan.nativeLinkPlan)) * int64(32)
    return csgBytes + loweringBytes + primaryBytes + objectBytes + nativeBytes

fn systemLinkExecCompilerCsgBackendReleaseOwnerToken(
        plan: var SystemLinkExecPlan,
        releasedBufferCount: int32,
        releasedBytes: int64): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(512)
    systemLinkExecRuntimeMetadataAppendText(
        buf, "cheng.compiler.compiler_csg_backend.owner_release")
    systemLinkExecRuntimeMetadataAppendFixed32Field(
        buf, plan.compilerCsg.sourceBundleCid)
    systemLinkExecRuntimeMetadataAppendFixed32Field(
        buf, plan.compilerCsg.canonicalGraphCid)
    systemLinkExecRuntimeMetadataAppendFixed32Field(
        buf, plan.compilerCsg.csgTransitionReceipt.receiptCid)
    systemLinkExecRuntimeMetadataAppendU32Field(
        buf, plan.loweringPlan.compilerCsgLifecycleInitialBufferCount)
    systemLinkExecRuntimeMetadataAppendI64Field(
        buf, plan.loweringPlan.compilerCsgLifecycleInitialBytes)
    systemLinkExecRuntimeMetadataAppendU32Field(
        buf, releasedBufferCount)
    systemLinkExecRuntimeMetadataAppendI64Field(
        buf, releasedBytes)
    let ownerToken =
        hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return ownerToken

fn SystemLinkExecPlanPrepareEarlyOwnerReceipts(
        plan: var SystemLinkExecPlan) =
    var compilerInputReceipt =
        plan.systemLinkPlan.compilerInputReleaseReceipt
    var ownerToken = compilerInputReceipt.ownerToken
    let compilerInputTerminalReceipt =
        SystemLinkExecOwnerTerminalReceiptMake(
            SystemLinkExecOwnerKindSystemLinkCompilerInput,
            ownerToken,
            compilerInputReceipt.releasedOwnedStorageColumnCount,
            compilerInputReceipt.releasedBufferCount,
            compilerInputReceipt.releasedBytes,
            SystemLinkExecOwnerStateReleased)
    var compilerInputErr: str
    if !plan.systemLinkPlan.compilerInputReleaseReceiptConsumed:
        if !slplan.SystemLinkPlanCompilerInputReleaseReceiptConsumeStrictInto(
               plan.systemLinkPlan,
               compilerInputReceipt,
               compilerInputErr):
            panic(compilerInputErr)
    elif !compilerInputReceipt.storageReleased ||
         compilerInputReceipt.releasedBufferCount < 0 ||
         compilerInputReceipt.releasedBytes < int64(0) ||
         layout.FixedBytes32Equal(
             compilerInputReceipt.ownerToken,
             layout.FixedBytes32()):
        panic("system link exec: compiler input release receipt incomplete")
    plan.systemLinkCompilerInputTerminalReceipt =
        compilerInputTerminalReceipt
    if !lower.LoweringPlanCompilerCsgReleaseReceiptComplete(
           plan.loweringPlan):
        panic("system link exec: CompilerCSG backend release receipt incomplete")
    let compilerCsgReleasedBufferCount =
        lower.LoweringPlanCompilerCsgReleasedBufferCount(
            plan.loweringPlan)
    let compilerCsgReleasedBytes =
        lower.LoweringPlanCompilerCsgReleasedBytes(
            plan.loweringPlan)
    let compilerCsgResidualBufferCount =
        ccsg.CompilerCsgLifecycleTrackedPhysicalBufferCount(
            plan.compilerCsg)
    let compilerCsgResidualBytes =
        ccsg.CompilerCsgLifecycleRetainedBytes(
            plan.compilerCsg)
    if compilerCsgReleasedBufferCount +
           compilerCsgResidualBufferCount !=
           plan.loweringPlan.compilerCsgLifecycleInitialBufferCount ||
       compilerCsgReleasedBytes + compilerCsgResidualBytes !=
           plan.loweringPlan.compilerCsgLifecycleInitialBytes:
        panic("system link exec: CompilerCSG backend/runtime byte partition mismatch")
    let compilerCsgOwnerToken =
        systemLinkExecCompilerCsgBackendReleaseOwnerToken(
            plan,
            compilerCsgReleasedBufferCount,
            compilerCsgReleasedBytes)
    plan.compilerCsgBackendTerminalReceipt =
        SystemLinkExecOwnerTerminalReceiptMake(
            SystemLinkExecOwnerKindCompilerCsgBackend,
            compilerCsgOwnerToken,
            4,
            compilerCsgReleasedBufferCount,
            compilerCsgReleasedBytes,
            SystemLinkExecOwnerStateReleased)

fn SystemLinkExecPlanPrepareExecution(plan: var SystemLinkExecPlan) =
    if plan.requestBindingSealed:
        panic("system link exec: request binding sealed twice")
    var actionAuthority: creq.CompilerRequest
    actionAuthority.backendKind = plan.requestBackendKind
    actionAuthority.jobCount = plan.requestedJobCount
    actionAuthority.emitKind = plan.requestEmitKind
    actionAuthority.providerObjectPaths =
        slplan.SystemLinkPlanStringsClone(plan.requestProviderObjectPaths)
    actionAuthority.runtimeProviderBundle =
        strings.CloneStr(plan.requestRuntimeProviderBundle)
    let expectedBackendActionCid =
        creq.CompilerRequestBackendActionCid(actionAuthority)
    if plan.requestedJobCount < 1 ||
       layout.FixedBytes32Equal(
           plan.backendRequestActionCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           plan.backendRequestCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           expectedBackendActionCid,
           plan.backendRequestActionCid):
        panic("system link exec: request binding authority mismatch")
    plan.requestBindingSealed = true
    SystemLinkExecPlanRequireCompilerCsgPayloadConsumed(plan)
    if !plan.compilerCsgProductionLifetime.active ||
       plan.compilerCsgLifetimeReceiptReady:
        panic("system link exec: CompilerCSG production lifetime missing")
    if !plan.loweringPayloadLifecycle.active ||
       !plan.loweringPayloadLifecycle.movedToConsumer ||
       plan.loweringLifetimeReceiptReady:
        panic("system link exec: lowering production lifetime missing")
    var sourceBundleReceiptErr: str
    if !SystemLinkExecPlanCidChainStrictValidateInto(
            plan,
            sourceBundleReceiptErr):
        panic(sourceBundleReceiptErr)
    if plan.payloadLifecycle.loweringPrePrimaryReleaseCount != 1 ||
       plan.payloadLifecycle.loweringAfterPrimaryReleaseCount != 1:
        panic("system link exec: execution prepared before lowering handoff completed")
    if plan.executionState != nil:
        panic("system link exec: execution token initialized more than once")
    SystemLinkExecPlanPrepareEarlyOwnerReceipts(plan)
    let executionTokenId = SystemLinkExecNowNs()
    if executionTokenId <= int64(0):
        panic("system link exec: invalid execution token id")
    var ledger: SystemLinkExecAllocationOwnerLedger
    SystemLinkExecOwnerLedgerInit(ledger, executionTokenId)
    let systemLinkCompilerInputRow = SystemLinkExecOwnerLedgerAppend(
        ledger, SystemLinkExecOwnerKindSystemLinkCompilerInput, true)
    let compilerCsgBackendRow = SystemLinkExecOwnerLedgerAppend(
        ledger, SystemLinkExecOwnerKindCompilerCsgBackend, true)
    let _ = SystemLinkExecOwnerLedgerAppend(
        ledger, SystemLinkExecOwnerKindLowering, true)
    let _ = SystemLinkExecOwnerLedgerAppend(
        ledger, SystemLinkExecOwnerKindRuntimeMetadata, true)
    let _ = SystemLinkExecOwnerLedgerAppend(
        ledger, SystemLinkExecOwnerKindPrimaryBodyIr, true)
    if plan.requestBackendKind == creq.CompilerBackend2:
        let _ = SystemLinkExecOwnerLedgerAppend(
            ledger, SystemLinkExecOwnerKindBackend2, true)
    else:
        let _ = SystemLinkExecOwnerLedgerAppend(
            ledger, SystemLinkExecOwnerKindPrimaryPlan, true)
    let _ = SystemLinkExecOwnerLedgerAppend(
        ledger, SystemLinkExecOwnerKindProvider, true)
    let _ = SystemLinkExecOwnerLedgerAppend(
        ledger, SystemLinkExecOwnerKindNative, true)
    let _ = SystemLinkExecOwnerLedgerAppend(
        ledger, SystemLinkExecOwnerKindSystemLinkPlan, true)
    if !plan.systemLinkCompilerInputTerminalReceipt.terminalProved ||
       !plan.compilerCsgBackendTerminalReceipt.terminalProved:
        panic("system link exec: early owner terminal receipt missing")
    SystemLinkExecOwnerLedgerRecordTerminalReceipt(
        ledger,
        systemLinkCompilerInputRow,
        plan.systemLinkCompilerInputTerminalReceipt)
    SystemLinkExecOwnerLedgerRecordTerminalReceipt(
        ledger,
        compilerCsgBackendRow,
        plan.compilerCsgBackendTerminalReceipt)
    ledger.retainedPayloadEstimateBeforeBytes =
        SystemLinkExecPlanRetainedPayloadDiagnosticEstimateBytes(plan)
    plan.allocationOwnerLedger = ledger
    plan.payloadFinalizeReceipt = SystemLinkExecPayloadFinalizeReceipt()
    plan.executionState = atomic.NewI32(SystemLinkExecExecutionReady)

fn SystemLinkExecCsgContributorCount(csg: var ccsg.CompilerCsg): int32 =
    return csg.nodes.len +
           csg.edges.len +
           csg.typedExprFacts.count +
           csg.typedIr.nodes2_nodeIndexs.len +
           csg.typedIr.statements2_statementIndexs.len +
           csg.typedIr.functions2_functionNameIds.len

# ---------------------------------------------------------------------------
# Phase memory owner breakdown (memory line w49 ④).
#
# The structured module ledger only covers the SoA/arena payload of the
# compilerCsg/lowering/primary modules; the diagnosis measured the residual
# (rss - structured) at 393x that number.  Each snapshot now carries a
# per-owner byte breakdown for the eight owners the theory model previously
# listed as one flat unmodeled line.  Every value carries an explicit method
# tag in the report:
#   measured            - os.ProcessRssBytes at plan-build entry, taken once
#   module_reported     - compilerCsg intern pool retained bytes (module ledger)
#   model               - declared constant model (thread stacks)
#   residual_diagnostic - rss minus all audited owners. vmmap identifies this
#                         physical remainder as allocator SMALL-tier dirty,
#                         but it does not distinguish live payload from pages
#                         retained by the allocator after free.
#   zero_pipeline_fact  - 0: this pipeline has no device allocations
#   measured_elsewhere  - linker/provider allocations are already emitted as
#                         measured phase RSS deltas by the runtime report
#                         (rss_after_native_link_bytes), not re-modeled here.
# ---------------------------------------------------------------------------
var systemLinkExecProcessBaselineRssBytes: int64 = -1

fn SystemLinkExecProcessBaselineRssObserve() =
    if systemLinkExecProcessBaselineRssBytes < 0:
        systemLinkExecProcessBaselineRssBytes = os.ProcessRssBytes()

@borrows
fn SystemLinkExecPhaseMemoryOwnerBreakdownFill(
        snapshot: var SystemLinkExecPhaseMemorySnapshot,
        activeWorkerCount: int32) =
    if systemLinkExecProcessBaselineRssBytes < 0:
        SystemLinkExecProcessBaselineRssObserve()
    snapshot.ownerBreakdown.processRuntimeBaselineBytes =
        systemLinkExecProcessBaselineRssBytes
    snapshot.ownerBreakdown.threadStacksBytes =
        int64(1 + activeWorkerCount) * int64(65536)
    snapshot.ownerBreakdown.deviceAllocationsBytes = int64(0)
    snapshot.ownerBreakdown.linkerAllocationsBytes = int64(0)
    snapshot.ownerBreakdown.codegenProviderAllocationsBytes = int64(0)
    snapshot.ownerBreakdown.allocatorRuntimeMetadataBytes = int64(0)
    snapshot.ownerBreakdown.typedFactInternPayloadBytes =
        snapshot.compilerCsgInternRetainedBytes
    var attributed =
        snapshot.structuredBytes +
        snapshot.ownerBreakdown.processRuntimeBaselineBytes +
        snapshot.ownerBreakdown.threadStacksBytes +
        snapshot.ownerBreakdown.typedFactInternPayloadBytes
    let allocatorSmallTierDirtyDiagnostic = snapshot.rssBytes - attributed
    if allocatorSmallTierDirtyDiagnostic > 0:
        snapshot.ownerBreakdown.allocatorSmallTierDirtyDiagnosticBytes =
            allocatorSmallTierDirtyDiagnostic
    else:
        snapshot.ownerBreakdown.allocatorSmallTierDirtyDiagnosticBytes =
            int64(0)

fn SystemLinkExecPhaseMemorySnapshotBorrowed(csg: var ccsg.CompilerCsg,
                                             loweringPlan: var lower.LoweringPlanStub,
                                             primaryPlan: var pobj.PrimaryObjectPlan): SystemLinkExecPhaseMemorySnapshot =
    var snapshot: SystemLinkExecPhaseMemorySnapshot
    snapshot.rssBytes = os.ProcessRssBytes()
    snapshot.compilerCsgLogicalBytes =
        ccsg.CompilerCsgLogicalPayloadBytes(csg)
    snapshot.compilerCsgRetainedCapacityBytes =
        ccsg.CompilerCsgRetainedCapacityBytes(csg)
    snapshot.compilerCsgInternRetainedBytes =
        ccsg.CompilerCsgInternPoolBytesMode(
            csg.typedExprFacts.internPool,
            true)
    snapshot.loweringStructuredBytes =
        lower.LoweringPlanStructuredLiveBytes(loweringPlan)
    snapshot.primaryStructuredBytes =
        pobj.PrimaryObjectPlanStructuredLiveBytes(primaryPlan)
    snapshot.structuredBytes = snapshot.compilerCsgRetainedCapacityBytes +
                               snapshot.loweringStructuredBytes +
                               snapshot.primaryStructuredBytes
    SystemLinkExecPhaseMemoryOwnerBreakdownFill(
        snapshot,
        lower.LoweringParallelLastActiveWorkerCount())
    return snapshot

fn SystemLinkExecPhaseMemorySnapshotFromPlan(plan: var SystemLinkExecPlan): SystemLinkExecPhaseMemorySnapshot =
    var snapshot: SystemLinkExecPhaseMemorySnapshot
    snapshot.rssBytes = os.ProcessRssBytes()
    snapshot.compilerCsgLogicalBytes =
        ccsg.CompilerCsgLogicalPayloadBytes(plan.compilerCsg)
    snapshot.compilerCsgRetainedCapacityBytes =
        ccsg.CompilerCsgRetainedCapacityBytes(plan.compilerCsg)
    snapshot.compilerCsgInternRetainedBytes =
        ccsg.CompilerCsgInternPoolBytesMode(
            plan.compilerCsg.typedExprFacts.internPool,
            true)
    snapshot.loweringStructuredBytes =
        lower.LoweringPlanStructuredLiveBytes(plan.loweringPlan)
    snapshot.primaryStructuredBytes =
        pobj.PrimaryObjectPlanStructuredLiveBytes(plan.primaryObjectPlan)
    snapshot.structuredBytes = snapshot.compilerCsgRetainedCapacityBytes +
                               snapshot.loweringStructuredBytes +
                               snapshot.primaryStructuredBytes
    SystemLinkExecPhaseMemoryOwnerBreakdownFill(
        snapshot,
        lower.LoweringParallelLastActiveWorkerCount())
    return snapshot

@borrows
fn SystemLinkExecPhaseMemoryConsiderContributor(kind: str,
                                                count: int32,
                                                bytes: int64,
                                                delta: var SystemLinkExecPhaseMemoryDelta) =
    if bytes <= int64(0):
        return
    if bytes > delta.top0Bytes:
        delta.top1Kind = delta.top0Kind
        delta.top1Count = delta.top0Count
        delta.top1Bytes = delta.top0Bytes
        delta.top0Kind = kind
        delta.top0Count = count
        delta.top0Bytes = bytes
    elif bytes > delta.top1Bytes:
        delta.top1Kind = kind
        delta.top1Count = count
        delta.top1Bytes = bytes

@borrows
fn SystemLinkExecPhaseMemoryDeltaBorrowed(before: SystemLinkExecPhaseMemorySnapshot,
                                          after: SystemLinkExecPhaseMemorySnapshot,
                                          csg: var ccsg.CompilerCsg,
                                          loweringPlan: var lower.LoweringPlanStub,
                                          primaryPlan: var pobj.PrimaryObjectPlan): SystemLinkExecPhaseMemoryDelta =
    var delta: SystemLinkExecPhaseMemoryDelta
    delta.before = before
    delta.after = after
    SystemLinkExecPhaseMemoryConsiderContributor("compiler_csg",
                                                 SystemLinkExecCsgContributorCount(csg),
                                                 ccsg.CompilerCsgRetainedCapacityBytes(csg),
                                                 delta)
    SystemLinkExecPhaseMemoryConsiderContributor("lowering_plan",
                                                 lower.LoweringPlanRetainedPayloadItemCount(loweringPlan),
                                                 lower.LoweringPlanStructuredLiveBytes(loweringPlan),
                                                 delta)
    SystemLinkExecPhaseMemoryConsiderContributor("primary_object_plan",
                                                 pobj.PrimaryObjectPlanRetainedCompactItemCount(primaryPlan) + pobj.PrimaryObjectPlanRetainedBodyIrPayloadItemCount(primaryPlan),
                                                 pobj.PrimaryObjectPlanStructuredLiveBytes(primaryPlan),
                                                 delta)
    return delta

@borrows
fn SystemLinkExecPhaseMemoryDeltaFromPlan(before: SystemLinkExecPhaseMemorySnapshot,
                                          after: SystemLinkExecPhaseMemorySnapshot,
                                          plan: var SystemLinkExecPlan): SystemLinkExecPhaseMemoryDelta =
    return SystemLinkExecPhaseMemoryDeltaBorrowed(before,
                                                  after,
                                                  plan.compilerCsg,
                                                  plan.loweringPlan,
                                                  plan.primaryObjectPlan)

@borrows
fn SystemLinkExecPhaseMemoryRequireStructuredNonIncrease(
        phase: str,
        before: SystemLinkExecPhaseMemorySnapshot,
        after: SystemLinkExecPhaseMemorySnapshot) =
    if after.structuredBytes > before.structuredBytes:
        panic(Fmt"system link exec: release phase increased structured bytes phase={phase} before={before.structuredBytes} after={after.structuredBytes}")

fn SystemLinkExecPhaseMemoryDiagnosticRssMinusReportedBytes(
        rssBytes: int64,
        structuredBytes: int64): int64 =
    if rssBytes < int64(0):
        return int64(-1)
    return rssBytes - structuredBytes

@borrows
fn SystemLinkExecPhaseMemoryLedgerLine(phase: str,
                                       delta: SystemLinkExecPhaseMemoryDelta): str =
    let rssBefore = delta.before.rssBytes
    let rssAfter = delta.after.rssBytes
    let structuredBefore = delta.before.structuredBytes
    let structuredAfter = delta.after.structuredBytes
    let gapBefore =
        SystemLinkExecPhaseMemoryDiagnosticRssMinusReportedBytes(rssBefore,
                                                                  structuredBefore)
    let gapAfter =
        SystemLinkExecPhaseMemoryDiagnosticRssMinusReportedBytes(rssAfter,
                                                                  structuredAfter)
    let rssDelta = rssAfter - rssBefore
    let structuredDelta = structuredAfter - structuredBefore
    let gapDelta = gapAfter - gapBefore
    return Fmt"phase_memory_ledger_schema=phase_delta_ledger phase={phase} phase_{phase}_rss_before_bytes={rssBefore} phase_{phase}_rss_after_bytes={rssAfter} phase_{phase}_rss_delta_bytes={rssDelta} phase_{phase}_structured_before_bytes={structuredBefore} phase_{phase}_structured_after_bytes={structuredAfter} phase_{phase}_structured_delta_bytes={structuredDelta} phase_{phase}_rss_minus_module_reported_diagnostic_before_bytes={gapBefore} phase_{phase}_rss_minus_module_reported_diagnostic_after_bytes={gapAfter} phase_{phase}_rss_minus_module_reported_diagnostic_delta_bytes={gapDelta} phase_{phase}_top0_kind={delta.top0Kind} phase_{phase}_top0_count={delta.top0Count} phase_{phase}_top0_bytes={delta.top0Bytes} phase_{phase}_top1_kind={delta.top1Kind} phase_{phase}_top1_count={delta.top1Count} phase_{phase}_top1_bytes={delta.top1Bytes}"

@borrows
fn SystemLinkExecPhaseMemoryLedgerEmit(rootDir: str,
                                       stderrEnabled: bool,
                                       progressPath: str,
                                       phase: str,
                                       delta: SystemLinkExecPhaseMemoryDelta) =
    if !stderrEnabled && len(progressPath) <= 0:
        return
    let line = SystemLinkExecPhaseMemoryLedgerLine(phase, delta)
    if stderrEnabled:
        os.WriteLine(os.Get_stderr(), line)
    if len(progressPath) > 0:
        let _ = chengpath.AppendTextFile(rootDir, progressPath, Fmt"{line}\n")

fn SystemLinkExecPhaseMsText(ns: int64): str =
    if ns <= 0:
        return "0"
    return int64ToStr(ns / 1000000)

fn SystemLinkExecProgressStdErrEnabled(): bool =
    let raw = strutil.Strip(os.GetEnv("CHENG_PROGRESS"))
    return len(raw) > 0 && raw != "0" && raw != "false"

fn SystemLinkExecProgressAppendEnabled(): bool =
    let raw = strutil.Strip(os.GetEnv("CHENG_PROGRESS_APPEND"))
    return len(raw) > 0 && raw != "0" && raw != "false"

fn SystemLinkExecDefaultMaxRssBytesText(): str =
    return "805306368"

fn SystemLinkExecEnsureDefaultResourceGuard() =
    if hostops.HostOpsLegacyResourceGuardEnvPresent([]):
        hostops.HostOpsExitProcess(2)
    let processRaw: str = strutil.Strip(os.GetEnv("CHENG_PROCESS_MAX_RSS_BYTES"))
    if len(processRaw) <= 0:
        os.SetEnv("CHENG_PROCESS_MAX_RSS_BYTES", SystemLinkExecDefaultMaxRssBytesText())

@borrows
fn SystemLinkExecProgressLine(phase: str,
                                status: str,
                                phaseNs: int64,
                                totalNs: int64): str =
    var out = Fmt"compile_progress phase={phase} status={status}"
    if phaseNs >= int64(0):
        out = Fmt"{out} phase_ms={SystemLinkExecPhaseMsText(phaseNs)}"
    if totalNs >= int64(0):
        out = Fmt"{out} total_ms={SystemLinkExecPhaseMsText(totalNs)}"
    return out

@borrows
fn SystemLinkExecProgressWriteGuardLine(rootDir: str,
                                          progressPath: str,
                                          progressText: str,
                                          line: str) =
    os.WriteLine(os.Get_stderr(), line)

@borrows
fn SystemLinkExecProgressResourceGuardCheck(rootDir: str,
                                              progressPath: str,
                                              progressText: str,
                                              guardPhase: str,
                                              guardStatus: str) =
    let maxRssBytes: int64 = hostops.HostOpsConfiguredMaxRssBytes([])
    if maxRssBytes == int64(0):
        return
    if maxRssBytes < int64(0):
        SystemLinkExecProgressWriteGuardLine(rootDir,
                                             progressPath,
                                             progressText,
                                             "compile_progress phase=resource_guard status=invalid_max_rss")
        hostops.HostOpsExitProcess(2)
    let rssBytes: int64 = hostops.HostOpsCurrentRssBytes()
    if rssBytes <= maxRssBytes:
        return
    if rssBytes <= int64(0):
        return
    let guardLine: str = strutil.Join([
        "compile_progress phase=resource_guard status=rss_limit_exceeded rss_bytes=",
        strings.Int64ToStr(rssBytes),
        " limit_bytes=",
        strings.Int64ToStr(maxRssBytes),
        " guard_phase=",
        strings.CloneStr(guardPhase),
        " guard_status=",
        strings.CloneStr(guardStatus)
    ], "")
    SystemLinkExecProgressWriteGuardLine(rootDir, progressPath, progressText, guardLine)
    hostops.HostOpsExitProcess(hostops.ProcessMemoryExceeded)

@borrows
fn SystemLinkExecProgressEmit(rootDir: str,
                                stderrEnabled: bool,
                                progressPath: str,
                                progressText: str,
                                phase: str,
                                status: str,
                                phaseNs: int64,
                                totalNs: int64) =
    SystemLinkExecProgressResourceGuardCheck(rootDir,
                                             progressPath,
                                             progressText,
                                             phase,
                                             status)
    if !stderrEnabled && len(progressPath) <= 0:
        return
    let line = SystemLinkExecProgressLine(phase, status, phaseNs, totalNs)
    if stderrEnabled:
        os.WriteLine(os.Get_stderr(), line)
    if len(progressPath) > 0:
        let _ = chengpath.AppendTextFile(rootDir, progressPath, Fmt"{line}\n")

@borrows
fn SystemLinkExecBrowserBridgeArtifactBasePath(outputPath: str): str =
    if len(outputPath) <= 0:
        return ""
    return Fmt"{outputPath}.browser_bridge_plan.txt"

@borrows
fn SystemLinkExecBrowserBridgeSourceBasePath(outputPath: str): str =
    if len(outputPath) <= 0:
        return ""
    return Fmt"{outputPath}.browser_bridge.generated.cheng"

@borrows
fn SystemLinkExecBrowserBridgeObjectBasePath(outputPath: str): str =
    if len(outputPath) <= 0:
        return ""
    return Fmt"{outputPath}.browser_bridge.generated.o"

fn SystemLinkExecBrowserBridgeObjectPathForLinkPlan(linkPlan: var slplan.SystemLinkPlanStub): str =
    if len(linkPlan.browserBridgeObjectPath) > 0:
        return linkPlan.browserBridgeObjectPath
    let bridgePlans = ccsg.CompilerBrowserAbiBridgePlansForLinkPlan(linkPlan)
    if bridgePlans.len <= 0:
        return ""
    return SystemLinkExecBrowserBridgeObjectBasePath(linkPlan.outputPath)

@borrows
fn SystemLinkExecBrowserBridgeArtifactPath(plan: SystemLinkExecPlan): str =
    let plans = ccsg.CompilerBrowserAbiBridgePlansForLinkPlan(plan.systemLinkPlan)
    if plans.len <= 0:
        return ""
    return SystemLinkExecBrowserBridgeArtifactBasePath(plan.systemLinkPlan.outputPath)

@borrows
fn SystemLinkExecBrowserBridgeArtifactText(plan: SystemLinkExecPlan): str =
    let plans = ccsg.CompilerBrowserAbiBridgePlansForLinkPlan(plan.systemLinkPlan)
    return barule.BrowserAbiBridgePlanManifestText(plans)

@borrows
fn SystemLinkExecBrowserBridgeSourcePath(plan: SystemLinkExecPlan): str =
    let plans = ccsg.CompilerBrowserAbiBridgePlansForLinkPlan(plan.systemLinkPlan)
    if plans.len <= 0:
        return ""
    return SystemLinkExecBrowserBridgeSourceBasePath(plan.systemLinkPlan.outputPath)

@borrows
fn SystemLinkExecBrowserBridgeObjectPath(plan: SystemLinkExecPlan): str =
    let plans = ccsg.CompilerBrowserAbiBridgePlansForLinkPlan(plan.systemLinkPlan)
    if plans.len <= 0:
        return ""
    return SystemLinkExecBrowserBridgeObjectBasePath(plan.systemLinkPlan.outputPath)

@borrows
fn SystemLinkExecBrowserBridgeSourceText(plan: SystemLinkExecPlan): str =
    let plans = ccsg.CompilerBrowserAbiBridgePlansForLinkPlan(plan.systemLinkPlan)
    return barule.BrowserAbiBridgeSourceText(plans)

@borrows
fn SystemLinkExecWriteBrowserBridgeArtifact(rootDir: str,
                                              plan: SystemLinkExecPlan): bool =
    let artifactBasePath = SystemLinkExecBrowserBridgeArtifactBasePath(plan.systemLinkPlan.outputPath)
    if len(artifactBasePath) <= 0:
        return true
    let artifactPath = SystemLinkExecBrowserBridgeArtifactPath(plan)
    if len(artifactPath) <= 0:
        if os.FileExists(artifactBasePath):
            let _ = os.RemoveFile(artifactBasePath)
        return true
    let artifactText = Fmt"{SystemLinkExecBrowserBridgeArtifactText(plan)}\n"
    return chengpath.WriteTextFile(rootDir, artifactPath, artifactText)

@borrows
fn SystemLinkExecWriteBrowserBridgeSource(rootDir: str,
                                            plan: SystemLinkExecPlan): bool =
    let sourceBasePath = SystemLinkExecBrowserBridgeSourceBasePath(plan.systemLinkPlan.outputPath)
    if len(sourceBasePath) <= 0:
        return true
    let sourcePath = SystemLinkExecBrowserBridgeSourcePath(plan)
    if len(sourcePath) <= 0:
        if os.FileExists(sourceBasePath):
            let _ = os.RemoveFile(sourceBasePath)
        return true
    let sourceText = Fmt"{SystemLinkExecBrowserBridgeSourceText(plan)}\n"
    return chengpath.WriteTextFile(rootDir, sourcePath, sourceText)

@borrows
fn ProviderSourcesForPlanInto(rootDir: str,
                              linkPlan: var slplan.SystemLinkPlanStub,
                              out: var str[],
                              err: var str): bool =
    for i in 0..<linkPlan.providerModules.len:
        let modulePath = linkPlan.providerModules[i]
        if len(modulePath) <= 0:
            add(out, "")
        elif modulePath == "runtime/core_runtime":
            var providerSource = ""
            providerSource = corun.CoreRuntimeProviderSourcePath(rootDir, linkPlan.targetTriple)
            add(out, system.SystemToStringStr(providerSource))
        elif modulePath == "runtime/debug_runtime":
            var providerSource = ""
            providerSource = debrun.DebugRuntimeProviderSourcePath(rootDir)
            add(out, system.SystemToStringStr(providerSource))
        elif modulePath == "runtime/compiler_runtime":
            var providerSource = ""
            if linkPlan.moduleKind == slplan.SystemCompilerControlPlane:
                providerSource = comprun.CompilerRuntimeProviderSourcePath(rootDir,
                                                                             comprun.CompilerRuntimeTrackTooling)
            else:
                providerSource = comprun.CompilerRuntimeProviderSourcePath(rootDir,
                                                                             comprun.CompilerRuntimeTrackProgram)
            add(out, system.SystemToStringStr(providerSource))
        elif modulePath == "runtime/program_support":
            var providerSource = ""
            providerSource = prun.ProgramSupportProviderSourcePath(rootDir)
            add(out, system.SystemToStringStr(providerSource))
        elif modulePath == "runtime/program_support_get_env_bridge":
            var providerSource = ""
            providerSource = prun.ProgramSupportGetEnvProviderSourcePath(rootDir)
            add(out, system.SystemToStringStr(providerSource))
        elif modulePath == "runtime/program_support_host_runtime":
            var providerSource = ""
            providerSource = prun.ProgramSupportHostProviderSourcePath(rootDir)
            add(out, system.SystemToStringStr(providerSource))
        elif strutil.StartsWith(modulePath, "codex/runtime/"):
            let providerName = strings.SliceBytes(modulePath, 14, modulePath.len - 14)
            if len(providerName) <= 0 ||
               strutil.Contains(providerName, ".."):
                err = Fmt" provider source: unsupported module {modulePath}"
                return false
            let providerSource = chengpath.PathAbsolute(rootDir,
                                                        Fmt"codex/src/core/runtime/{providerName}.cheng")
            if !os.FileExists(providerSource):
                err = Fmt" provider source: missing codex runtime module {modulePath}"
                return false
            add(out, system.SystemToStringStr(providerSource))
        elif strutil.StartsWith(modulePath, "std/"):
            let stdRel = strings.SliceBytes(modulePath, 4, modulePath.len - 4)
            if len(stdRel) <= 0 ||
               strutil.Contains(stdRel, ".."):
                err = Fmt" provider source: unsupported module {modulePath}"
                return false
            let providerSource = chengpath.PathAbsolute(rootDir,
                                                        Fmt"src/std/{stdRel}.cheng")
            if !os.FileExists(providerSource):
                err = Fmt" provider source: missing std module {modulePath}"
                return false
            add(out, system.SystemToStringStr(providerSource))
        else:
            err = Fmt" provider source: unsupported module {modulePath}"
            return false
    err = ""
    return true

@borrows
fn SystemLinkExecAddUniqueText(out: var str[], value: str) =
    if len(value) <= 0:
        return
    for i in 0..<out.len:
        if out[i] == value:
            return
    add(out, strings.CloneStr(value))

@borrows
fn SystemLinkExecPrimaryRelocNeedsSymbol(linkPlan: var slplan.SystemLinkPlanStub,
                                          primaryPlan: var pobj.PrimaryObjectPlan,
                                          rawSymbol: str): bool =
    let targetSymbol = pobj.PrimaryTargetSymbolName(linkPlan.targetTriple, rawSymbol)
    for i in 0..<primaryPlan.relocTargetSymbols.len:
        let symbol = primaryPlan.relocTargetSymbols[i]
        if symbol == rawSymbol:
            return true
        if symbol == targetSymbol:
            return true
    return false

@borrows
fn SystemLinkExecAddCoreRuntimeRootIfNeeded(linkPlan: var slplan.SystemLinkPlanStub,
                                             primaryPlan: var pobj.PrimaryObjectPlan,
                                             out: var str[],
                                             rawSymbol: str) =
    if SystemLinkExecPrimaryRelocNeedsSymbol(linkPlan, primaryPlan, rawSymbol):
        SystemLinkExecAddUniqueText(out, rawSymbol)

