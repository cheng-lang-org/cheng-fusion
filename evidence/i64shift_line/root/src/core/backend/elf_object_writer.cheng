import std/result
import std/rawbytes
import std/strformat
import std/strings
import cheng/core/tooling/path as chengpath
import cheng/core/backend/object_buffer as obuf
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/object_relocs as orel

const
    ELFCLASS64 = uint64(2)
    ELFDATA2LSB = uint64(1)
    EV_CURRENT = uint64(1)
    EM_AARCH64 = uint64(183)
    ET_REL = uint64(1)

    SHT_NULL = int32(0)
    SHT_PROGBITS = int32(1)
    SHT_SYMTAB = int32(2)
    SHT_STRTAB = int32(3)
    SHT_RELA = int32(4)
    SHT_NOBITS = int32(8)

    SHF_WRITE = int32(0x1)
    SHF_ALLOC = int32(0x2)
    SHF_EXECINSTR = int32(0x4)

    STB_LOCAL = uint64(0)
    STB_GLOBAL = uint64(1)
    STT_NOTYPE = uint64(0)
    STT_OBJECT = uint64(1)
    STT_FUNC = uint64(2)

    R_AARCH64_ABS64 = uint64(257)
    R_AARCH64_ABS32 = uint64(258)
    R_AARCH64_JUMP26 = uint64(282)
    R_AARCH64_CALL26 = uint64(283)
    R_AARCH64_ADR_PREL_PG_HI21 = uint64(275)
    R_AARCH64_ADD_ABS_LO12_NC = uint64(277)

    ELF_HDR_SIZE = 64
    ELF_SHDR_SIZE = 64
    ELF_SYM_SIZE = 24
    ELF_RELA_SIZE = 24

type
    ElfWriterResult =
        objectPath: str
        bytesWritten: int32
        symbolCount: int32
        relocCount: int32

fn elfAlign(value: int32, align: int32): int32 =
    if align <= 1:
        return value
    let mask = align - 1
    return (value + mask) & (0 - align)

@borrows
fn elfWriteCString(buf: var obuf.ObjectBuffer,
                   text: str) =
    for i in 0..<len(text):
        obuf.ObjectBufferWriteU8(buf, int32(text[i]) & 255)
    obuf.ObjectBufferWriteU8(buf, 0)

fn elfWriteShdr(buf: var obuf.ObjectBuffer,
                nameOff: int32,
                shType: int32,
                flags: int32,
                shOffset: int64,
                shSize: int64,
                link: int32,
                info: int32,
                addralign: int64,
                entsize: int64) =
    obuf.ObjectBufferWriteU32LE(buf, uint64(nameOff))
    obuf.ObjectBufferWriteU32LE(buf, uint64(shType))
    obuf.ObjectBufferWriteU64LE(buf, uint64(flags))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(shOffset))
    obuf.ObjectBufferWriteU64LE(buf, uint64(shSize))
    obuf.ObjectBufferWriteU32LE(buf, uint64(link))
    obuf.ObjectBufferWriteU32LE(buf, uint64(info))
    obuf.ObjectBufferWriteU64LE(buf, uint64(addralign))
    obuf.ObjectBufferWriteU64LE(buf, uint64(entsize))

fn elfWriteNullShdr(buf: var obuf.ObjectBuffer,
                    nameOff: int32) =
    obuf.ObjectBufferWriteU32LE(buf, uint64(nameOff))
    obuf.ObjectBufferWriteU32LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))
    obuf.ObjectBufferWriteU32LE(buf, uint64(0))
    obuf.ObjectBufferWriteU32LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))

fn elfWriteTextShdr(buf: var obuf.ObjectBuffer,
                    nameOff: int32,
                    shOffset: int64,
                    shSize: int64) =
    obuf.ObjectBufferWriteU32LE(buf, uint64(nameOff))
    obuf.ObjectBufferWriteU32LE(buf, uint64(1))
    obuf.ObjectBufferWriteU64LE(buf, uint64(6))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(shOffset))
    obuf.ObjectBufferWriteU64LE(buf, uint64(shSize))
    obuf.ObjectBufferWriteU32LE(buf, uint64(0))
    obuf.ObjectBufferWriteU32LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(4))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))

fn elfWriteDataShdr(buf: var obuf.ObjectBuffer,
                    nameOff: int32,
                    shOffset: int64,
                    shSize: int64) =
    obuf.ObjectBufferWriteU32LE(buf, uint64(nameOff))
    obuf.ObjectBufferWriteU32LE(buf, uint64(1))
    obuf.ObjectBufferWriteU64LE(buf, uint64(3))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(shOffset))
    obuf.ObjectBufferWriteU64LE(buf, uint64(shSize))
    obuf.ObjectBufferWriteU32LE(buf, uint64(0))
    obuf.ObjectBufferWriteU32LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(8))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))

fn elfWriteRelaTextShdr(buf: var obuf.ObjectBuffer,
                        nameOff: int32,
                        shOffset: int64,
                        shSize: int64,
                        symtabShndx: int32,
                        textShndx: int32) =
    obuf.ObjectBufferWriteU32LE(buf, uint64(nameOff))
    obuf.ObjectBufferWriteU32LE(buf, uint64(4))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(shOffset))
    obuf.ObjectBufferWriteU64LE(buf, uint64(shSize))
    obuf.ObjectBufferWriteU32LE(buf, uint64(symtabShndx))
    obuf.ObjectBufferWriteU32LE(buf, uint64(textShndx))
    obuf.ObjectBufferWriteU64LE(buf, uint64(8))
    obuf.ObjectBufferWriteU64LE(buf, uint64(ELF_RELA_SIZE))

fn elfWriteSymtabShdr(buf: var obuf.ObjectBuffer,
                      nameOff: int32,
                      shOffset: int64,
                      shSize: int64,
                      strtabShndx: int32,
                      localInfo: int32) =
    obuf.ObjectBufferWriteU32LE(buf, uint64(nameOff))
    obuf.ObjectBufferWriteU32LE(buf, uint64(2))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(shOffset))
    obuf.ObjectBufferWriteU64LE(buf, uint64(shSize))
    obuf.ObjectBufferWriteU32LE(buf, uint64(strtabShndx))
    obuf.ObjectBufferWriteU32LE(buf, uint64(localInfo))
    obuf.ObjectBufferWriteU64LE(buf, uint64(8))
    obuf.ObjectBufferWriteU64LE(buf, uint64(ELF_SYM_SIZE))

fn elfWriteStrtabShdr(buf: var obuf.ObjectBuffer,
                      nameOff: int32,
                      shOffset: int64,
                      shSize: int64) =
    obuf.ObjectBufferWriteU32LE(buf, uint64(nameOff))
    obuf.ObjectBufferWriteU32LE(buf, uint64(3))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(shOffset))
    obuf.ObjectBufferWriteU64LE(buf, uint64(shSize))
    obuf.ObjectBufferWriteU32LE(buf, uint64(0))
    obuf.ObjectBufferWriteU32LE(buf, uint64(0))
    obuf.ObjectBufferWriteU64LE(buf, uint64(1))
    obuf.ObjectBufferWriteU64LE(buf, uint64(0))

fn elfWriteSym(buf: var obuf.ObjectBuffer,
               nameOff: int32,
               info: uint64,
               shndx: int32,
               value: int64,
               size: int64) =
    obuf.ObjectBufferWriteU32LE(buf, uint64(nameOff))
    obuf.ObjectBufferWriteU8(buf, int32(info & uint64(255)))
    obuf.ObjectBufferWriteU8(buf, int32((info >> 8) & uint64(255)))
    obuf.ObjectBufferWriteU16LE(buf, uint64(shndx))
    obuf.ObjectBufferWriteU64LE(buf, uint64(value))
    obuf.ObjectBufferWriteU64LE(buf, uint64(size))

fn elfWriteSymWithInfoByte(buf: var obuf.ObjectBuffer,
                           nameOff: int32,
                           infoByte: int32,
                           shndx: int32,
                           value: int64,
                           size: int64) =
    obuf.ObjectBufferWriteU32LE(buf, uint64(nameOff))
    obuf.ObjectBufferWriteU8(buf, infoByte)
    obuf.ObjectBufferWriteU8(buf, int32(0))
    obuf.ObjectBufferWriteU16LE(buf, uint64(shndx))
    obuf.ObjectBufferWriteU64LE(buf, uint64(value))
    obuf.ObjectBufferWriteU64LE(buf, uint64(size))

fn elfWriteNullSym(buf: var obuf.ObjectBuffer) =
    elfWriteSymWithInfoByte(buf, int32(0), int32(0), int32(0), int64(0), int64(0))

fn elfWriteUndefinedSym(buf: var obuf.ObjectBuffer,
                        nameOff: int32) =
    elfWriteSymWithInfoByte(buf, nameOff, int32(0x10), int32(0), int64(0), int64(0))

fn elfWriteLocalFuncSym(buf: var obuf.ObjectBuffer,
                        nameOff: int32,
                        shndx: int32,
                        value: int64,
                        size: int64) =
    elfWriteSymWithInfoByte(buf, nameOff, int32(0x02), shndx, value, size)

fn elfWriteGlobalFuncSym(buf: var obuf.ObjectBuffer,
                         nameOff: int32,
                         shndx: int32,
                         value: int64,
                         size: int64) =
    elfWriteSymWithInfoByte(buf, nameOff, int32(0x12), shndx, value, size)

fn elfWriteLocalObjectSym(buf: var obuf.ObjectBuffer,
                          nameOff: int32,
                          shndx: int32,
                          value: int64,
                          size: int64) =
    elfWriteSymWithInfoByte(buf, nameOff, int32(0x01), shndx, value, size)

fn elfWriteGlobalObjectSym(buf: var obuf.ObjectBuffer,
                           nameOff: int32,
                           shndx: int32,
                           value: int64,
                           size: int64) =
    elfWriteSymWithInfoByte(buf, nameOff, int32(0x11), shndx, value, size)

fn elfWriteRela(buf: var obuf.ObjectBuffer,
                offset: int64,
                info: uint64,
                addend: int64) =
    obuf.ObjectBufferWriteU64LE(buf, uint64(offset))
    obuf.ObjectBufferWriteU64LE(buf, info)
    obuf.ObjectBufferWriteU64LE(buf, uint64(addend))

@borrows
fn ElfTextObjectBytes(text: rawbytes.Bytes,
                       symbols: osym.ObjectSymbolTable,
                       relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes] =
    var emptyData = rawbytes.EmptyBytes()
    return elfBuild(text, emptyData, symbols, relocs)

@borrows
fn ElfTextDataObjectBytes(text: rawbytes.Bytes,
                           data: rawbytes.Bytes,
                           symbols: osym.ObjectSymbolTable,
                           relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes] =
    return elfBuild(text, data, symbols, relocs)

@borrows
fn elfBuild(text: rawbytes.Bytes,
            data: rawbytes.Bytes,
            symbols: osym.ObjectSymbolTable,
            relocs: orel.ObjectRelocTable): Result[rawbytes.Bytes] =
    let relocCount = orel.ObjectRelocsCount(relocs)
    let symbolCount = osym.ObjectSymbolsCount(symbols)
    if symbolCount <= 0:
        return Err[rawbytes.Bytes](" elf object writer: missing symbols")

    let textSize = int64(text.len)
    let dataSize = int64(data.len)
    let hasData = dataSize > int64(0)

    let textShndx = int32(1)
    var dataShndx = int32(0)
    var relaShndx = int32(0)
    var nextShndx = int32(2)
    if hasData:
        dataShndx = nextShndx
        nextShndx = nextShndx + 1
    if relocCount > 0:
        relaShndx = nextShndx
        nextShndx = nextShndx + 1
    let symtabShndx = nextShndx
    nextShndx = nextShndx + 1
    let strtabShndx = nextShndx
    nextShndx = nextShndx + 1
    let shstrtabShndx = nextShndx
    nextShndx = nextShndx + 1
    let shnum = nextShndx

    var symOrder: int32[]
    for i in 0..<symbolCount:
        let sym = osym.ObjectSymbolsAt(symbols, i)
        if !sym.global:
            add(symOrder, i)
    let localSymbolCount = symOrder.len
    for i in 0..<symbolCount:
        let sym = osym.ObjectSymbolsAt(symbols, i)
        if sym.global:
            add(symOrder, i)
    var symNewIndex: int32[]
    for i in 0..<symbolCount:
        add(symNewIndex, 0)
    for k in 0..<symbolCount:
        symNewIndex[symOrder[k]] = k

    # Build strtab (symbol names)
    var strtab = obuf.ObjectBufferInit(256)
    defer:
        obuf.ObjectBufferRelease(strtab)
    obuf.ObjectBufferWriteU8(strtab, 0)
    var symNameOffs: int32[]
    for k in 0..<symbolCount:
        let orderIndex = symOrder[k]
        let sym = osym.ObjectSymbolsAt(symbols, orderIndex)
        let symName = sym.name
        add(symNameOffs, obuf.ObjectBufferOffset(strtab))
        elfWriteCString(strtab, symName)

    # Build shstrtab (section names)
    var shstrtab = obuf.ObjectBufferInit(128)
    defer:
        obuf.ObjectBufferRelease(shstrtab)
    obuf.ObjectBufferWriteU8(shstrtab, 0)
    var shNameOffs: int32[]
    add(shNameOffs, int32(0))
    add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
    elfWriteCString(shstrtab, ".text")
    if hasData:
        add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
        elfWriteCString(shstrtab, ".data")
    if relocCount > 0:
        add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
        elfWriteCString(shstrtab, ".rela.text")
    add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
    elfWriteCString(shstrtab, ".symtab")
    add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
    elfWriteCString(shstrtab, ".strtab")
    add(shNameOffs, obuf.ObjectBufferOffset(shstrtab))
    elfWriteCString(shstrtab, ".shstrtab")

    # Layout
    let textOff = int64(ELF_HDR_SIZE)
    let dataOff = elfAlign(int32(textOff + textSize), int32(8))
    let relaOff = elfAlign(int32(int64(dataOff) + dataSize), int32(8))
    let symOff = elfAlign(int32(relaOff) + relocCount * ELF_RELA_SIZE, int32(8))
    let strOff = int64(symOff) + int64(symbolCount + 1) * int64(ELF_SYM_SIZE)
    let shstrOff = strOff + int64(obuf.ObjectBufferLen(strtab))
    let shdrOff = elfAlign(int32(shstrOff) + obuf.ObjectBufferLen(shstrtab), int32(8))

    var out = obuf.ObjectBufferInit(int32(shdrOff) + shnum * ELF_SHDR_SIZE + 64)
    defer:
        obuf.ObjectBufferRelease(out)

    # ELF header
    obuf.ObjectBufferWriteU8(out, int32(0x7F))
    obuf.ObjectBufferWriteU8(out, int32(69))
    obuf.ObjectBufferWriteU8(out, int32(76))
    obuf.ObjectBufferWriteU8(out, int32(70))
    obuf.ObjectBufferWriteU8(out, 2)
    obuf.ObjectBufferWriteU8(out, 1)
    obuf.ObjectBufferWriteU8(out, 1)
    obuf.ObjectBufferWriteU8(out, int32(0))
    obuf.ObjectBufferWriteU64LE(out, uint64(0))
    obuf.ObjectBufferWriteU16LE(out, uint64(1))
    obuf.ObjectBufferWriteU16LE(out, uint64(183))
    obuf.ObjectBufferWriteU32LE(out, uint64(1))
    obuf.ObjectBufferWriteU64LE(out, uint64(0))
    obuf.ObjectBufferWriteU64LE(out, uint64(0))
    obuf.ObjectBufferWriteU64LE(out, uint64(shdrOff))
    obuf.ObjectBufferWriteU32LE(out, uint64(0))
    obuf.ObjectBufferWriteU16LE(out, uint64(ELF_HDR_SIZE))
    obuf.ObjectBufferWriteU16LE(out, uint64(0))
    obuf.ObjectBufferWriteU16LE(out, uint64(0))
    obuf.ObjectBufferWriteU16LE(out, uint64(ELF_SHDR_SIZE))
    obuf.ObjectBufferWriteU16LE(out, uint64(shnum))
    obuf.ObjectBufferWriteU16LE(out, uint64(shstrtabShndx))

    # .text
    obuf.ObjectBufferWriteBytes(out, text)

    # .data (optional)
    if hasData:
        obuf.ObjectBufferAlign(out, int32(8), 0)
        obuf.ObjectBufferWriteBytes(out, data)

    # .rela.text (optional)
    if relocCount > 0:
        obuf.ObjectBufferAlign(out, int32(8), 0)
        for i in 0..<relocCount:
            let reloc = orel.ObjectRelocsAt(relocs, i)
            if reloc.sectionIndex != 0:
                return Err[rawbytes.Bytes](" elf object writer: non-text relocations are not supported")
            # rType MUST use uint64(...) literals, not the R_AARCH64_* named
            # consts above: when the seed compiles this function via
            # build-backend-driver, same-module uint64 const reads in this
            # decl/assign position materialize as ZERO (s2q7 const family),
            # so every reloc was emitted as R_AARCH64_NONE and linked objects
            # were full of bl-to-self spins (v28 android wall 9). The named
            # consts stay above as documentation; the tripwire below turns
            # any regression of this family into a hard Err instead of a
            # silent broken object.
            var rType: uint64 = uint64(257)
            if int32(reloc.kind) == int32(orel.ObjectRelocAbs32):
                rType = uint64(258)
            elif int32(reloc.kind) == int32(orel.ObjectRelocBranch26):
                rType = uint64(283)
            elif int32(reloc.kind) == int32(orel.ObjectRelocJump26):
                rType = uint64(282)
            elif int32(reloc.kind) == int32(orel.ObjectRelocPage21):
                rType = uint64(275)
            elif int32(reloc.kind) == int32(orel.ObjectRelocPageOff12):
                rType = uint64(277)
            elif int32(reloc.kind) != int32(orel.ObjectRelocAbs64):
                return Err[rawbytes.Bytes](" elf object writer: unsupported relocation kind")
            if rType == uint64(0):
                return Err[rawbytes.Bytes](" elf object writer: reloc type lost (const-read miscompile tripwire)")
            if reloc.symbolIndex < 0 || reloc.symbolIndex >= symbolCount:
                return Err[rawbytes.Bytes](" elf object writer: reloc symbol index out of range")
            let rSym = uint64(symNewIndex[reloc.symbolIndex] + 1)
            let info = (rSym << 32) | rType
            elfWriteRela(out, reloc.offset, info, reloc.addend)

    # .symtab
    obuf.ObjectBufferAlign(out, int32(8), 0)
    elfWriteNullSym(out)
    let dataSymBase = int64(elfAlign(int32(textSize), int32(8)))
    for k in 0..<symbolCount:
        let sym = osym.ObjectSymbolsAt(symbols, symOrder[k])
        var shndx = int32(0)
        var value = sym.offset
        if sym.undefined:
            elfWriteUndefinedSym(out, symNameOffs[k])
        else:
            if sym.sectionIndex == 0:
                shndx = textShndx
                if sym.global:
                    elfWriteGlobalFuncSym(out, symNameOffs[k], shndx, value, sym.size)
                else:
                    elfWriteLocalFuncSym(out, symNameOffs[k], shndx, value, sym.size)
            elif hasData && sym.sectionIndex == 1:
                shndx = dataShndx
                if value < dataSymBase:
                    let symName = sym.name
                    return Err[rawbytes.Bytes](Fmt" elf object writer: data symbol below data base: {symName}")
                value = value - dataSymBase
                if sym.global:
                    elfWriteGlobalObjectSym(out, symNameOffs[k], shndx, value, sym.size)
                else:
                    elfWriteLocalObjectSym(out, symNameOffs[k], shndx, value, sym.size)
            else:
                shndx = textShndx
                if sym.global:
                    elfWriteGlobalFuncSym(out, symNameOffs[k], shndx, value, sym.size)
                else:
                    elfWriteLocalFuncSym(out, symNameOffs[k], shndx, value, sym.size)

    # .strtab
    obuf.ObjectBufferAlign(out, int32(1), 0)
    obuf.ObjectBufferWriteBuffer(out, strtab)

    # .shstrtab
    obuf.ObjectBufferAlign(out, int32(1), 0)
    obuf.ObjectBufferWriteBuffer(out, shstrtab)

    # Section headers (place last)
    obuf.ObjectBufferAlign(out, int32(8), 0)
    # SHT_NULL
    elfWriteNullShdr(out, shNameOffs[0])
    # .text
    elfWriteTextShdr(out, shNameOffs[1], textOff, textSize)
    # .data (optional)
    var nextNameIdx = int32(2)
    if hasData:
        elfWriteDataShdr(out, shNameOffs[nextNameIdx], int64(dataOff), dataSize)
        nextNameIdx = nextNameIdx + 1
    # .rela.text (optional)
    if relocCount > 0:
        elfWriteRelaTextShdr(out,
                             shNameOffs[nextNameIdx],
                             relaOff,
                             int64(relocCount * ELF_RELA_SIZE),
                             int32(symtabShndx),
                             textShndx)
        nextNameIdx = nextNameIdx + 1
    # .symtab
    elfWriteSymtabShdr(out,
                       shNameOffs[nextNameIdx],
                       symOff,
                       int64(symbolCount + 1) * int64(ELF_SYM_SIZE),
                       int32(strtabShndx),
                       localSymbolCount + 1)
    nextNameIdx = nextNameIdx + 1
    # .strtab
    elfWriteStrtabShdr(out,
                       shNameOffs[nextNameIdx],
                       strOff,
                       int64(obuf.ObjectBufferLen(strtab)))
    nextNameIdx = nextNameIdx + 1
    # .shstrtab
    elfWriteStrtabShdr(out,
                       shNameOffs[nextNameIdx],
                       shstrOff,
                       int64(obuf.ObjectBufferLen(shstrtab)))

    return Ok[rawbytes.Bytes](obuf.ObjectBufferTakeBytes(out))

@borrows
fn elfFinishWrite(rootDir: str,
                  outputPath: str,
                  bytesRes: var Result[rawbytes.Bytes],
                  symbols: osym.ObjectSymbolTable,
                  relocs: orel.ObjectRelocTable): Result[ElfWriterResult] =
    if !bytesRes.ok:
        return Err[ElfWriterResult](strings.CloneStr(bytesRes.err.msg))
    var bytes = rawbytes.BytesTake(bytesRes.value)
    defer:
        rawbytes.BytesFree(bytes)
    let payload = rawbytes.BytesToString(bytes)
    if !chengpath.WriteTextFile(rootDir, outputPath, payload):
        return Err[ElfWriterResult](Fmt" elf object writer: failed to write object: {outputPath}")
    var out: ElfWriterResult
    out.objectPath = strings.CloneStr(outputPath)
    out.bytesWritten = bytes.len
    out.symbolCount = osym.ObjectSymbolsCount(symbols)
    out.relocCount = orel.ObjectRelocsCount(relocs)
    return Ok[ElfWriterResult](out)

@borrows
fn elfWriteResult(rootDir: str,
                  outputPath: str,
                  text: rawbytes.Bytes,
                  data: rawbytes.Bytes,
                  symbols: osym.ObjectSymbolTable,
                  relocs: orel.ObjectRelocTable): Result[ElfWriterResult] =
    if data.len > 0:
        var bytesRes = elfBuild(text, data, symbols, relocs)
        return elfFinishWrite(rootDir, outputPath, bytesRes, symbols, relocs)
    var emptyData = rawbytes.EmptyBytes()
    var bytesRes = elfBuild(text, emptyData, symbols, relocs)
    return elfFinishWrite(rootDir, outputPath, bytesRes, symbols, relocs)

@borrows
fn ElfTextObjectWrite(rootDir: str,
                       outputPath: str,
                       text: rawbytes.Bytes,
                       symbols: osym.ObjectSymbolTable,
                       relocs: orel.ObjectRelocTable): Result[ElfWriterResult] =
    var emptyData = rawbytes.EmptyBytes()
    return elfWriteResult(rootDir, outputPath, text, emptyData, symbols, relocs)

@borrows
fn ElfTextDataObjectWrite(rootDir: str,
                           outputPath: str,
                           text: rawbytes.Bytes,
                           data: rawbytes.Bytes,
                           symbols: osym.ObjectSymbolTable,
                           relocs: orel.ObjectRelocTable): Result[ElfWriterResult] =
    return elfWriteResult(rootDir, outputPath, text, data, symbols, relocs)
