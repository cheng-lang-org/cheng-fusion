import std/result
import std/rawbytes
import std/strformat
import std/strings
import cheng/core/tooling/path as chengpath
import cheng/core/backend/object_buffer as obuf
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/object_relocs as orel
import cheng/core/backend/direct_object_debug_sections as debugsections
import cheng/core/backend/macho_debug_section_evidence as debugevidence

const
    MachOHeaderSize = 32
    MachOSegmentCommandSize = 72
    MachOSection64Size = 80
    MachOSymtabCommandSize = 24
    MachOEntryPointCommandSize = 24
    MachONlist64Size = 16
    MachOLoadCommandSegment64 = 0x19
    MachOLoadCommandSymtab = 0x2
    MachOLoadCommandMain = 0x80000028
    MachOFileTypeObject = 1
    MachOFileTypeExecute = 2
    MachOA64CpuType = 0x0100000c
    MachOVmBase = 0x100000000
    MachOPageSize = 0x4000
    MachORelocA64Unsigned = 0
    MachORelocA64Branch26 = 2
    MachORelocA64Page21 = 3
    MachORelocA64PageOff12 = 4

type
    MachOObjectWriterResult =
        objectPath: str
        bytesWritten: int32
        symbolCount: int32
        relocCount: int32

fn MachOAlign(value: int32, align: int32): int32 =
    if align <= 1:
        return value
    let mask = align - 1
    return (value + mask) & (0 - align)

fn MachOWriteHeader64(buf: var obuf.ObjectBuffer,
                       fileType: int32,
                       commandCount: int32,
                       commandBytes: int32,
                       flags: int32) =
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0xfeedfacf))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0x0100000c))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(fileType))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(commandCount))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(commandBytes))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(flags))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))

fn MachOWriteEntryPointCommand(buf: var obuf.ObjectBuffer,
                                entryFileOffset: int32) =
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0x80000028))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(24))
    obuf.ObjectBufferWriteU64LE(buf, UInt64(entryFileOffset))
    obuf.ObjectBufferWriteU64LE(buf, UInt64(0))

fn MachOWritePageZeroSegment(buf: var obuf.ObjectBuffer) =
    obuf.ObjectBufferWriteU32LE(buf, UInt64(25))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(72))
    MachOWritePaddedAscii(buf, "__PAGEZERO", 16)
    obuf.ObjectBufferWriteU64LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU64LE(buf, UInt64(0x100000000))
    obuf.ObjectBufferWriteU64LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU64LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))

@borrows
fn MachOWritePaddedAscii(buf: var obuf.ObjectBuffer,
                          text: str,
                          width: int32) =
    for i in 0..<width:
        if i < Len(text):
            obuf.ObjectBufferWriteU8(buf, Int32(text[i]) & 255)
        else:
            obuf.ObjectBufferWriteU8(buf, 0)

@borrows
fn MachOWriteCString(buf: var obuf.ObjectBuffer,
                      text: str) =
    for i in 0..<Len(text):
        obuf.ObjectBufferWriteU8(buf, Int32(text[i]) & 255)
    obuf.ObjectBufferWriteU8(buf, 0)

fn MachOWriteTextSectionCommand(buf: var obuf.ObjectBuffer,
                                 textOffset: int32,
                                 textSize: int32,
                                 relocOffset: int32,
                                 relocCount: int32) =
    MachOWritePaddedAscii(buf, "__text", 16)
    MachOWritePaddedAscii(buf, "__TEXT", 16)
    obuf.ObjectBufferWriteU64LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU64LE(buf, UInt64(textSize))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(textOffset))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(2))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(relocOffset))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(relocCount))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0x80000400))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))

fn MachOWriteDataSectionCommand(buf: var obuf.ObjectBuffer,
                                 dataAddr: int32,
                                 dataOffset: int32,
                                 dataSize: int32) =
    MachOWritePaddedAscii(buf, "__data", 16)
    MachOWritePaddedAscii(buf, "__DATA", 16)
    obuf.ObjectBufferWriteU64LE(buf, UInt64(dataAddr))
    obuf.ObjectBufferWriteU64LE(buf, UInt64(dataSize))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(dataOffset))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(3))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))

@borrows
fn MachOWriteDebugSectionCommand(buf: var obuf.ObjectBuffer,
                                 sectionName: str,
                                 sectionAddr: int32,
                                 sectionOffset: int32,
                                 sectionSize: int32,
                                 relocOffset: int32,
                                 relocCount: int32) =
    MachOWritePaddedAscii(buf, sectionName, 16)
    MachOWritePaddedAscii(buf, "__DWARF", 16)
    obuf.ObjectBufferWriteU64LE(buf, UInt64(sectionAddr))
    obuf.ObjectBufferWriteU64LE(buf, UInt64(sectionSize))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(sectionOffset))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(relocOffset))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(relocCount))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(0))

@borrows
fn MachOWriteNlist64(buf: var obuf.ObjectBuffer,
                      strIndex: int32,
                      symbol: osym.ObjectSymbol) =
    obuf.ObjectBufferWriteU32LE(buf, UInt64(strIndex))
    if symbol.undefined:
        var undefinedType = 0
        if symbol.global:
            undefinedType = 1
        obuf.ObjectBufferWriteU8(buf, undefinedType)
        obuf.ObjectBufferWriteU8(buf, 0)
        obuf.ObjectBufferWriteU16LE(buf, UInt64(0))
        obuf.ObjectBufferWriteU64LE(buf, UInt64(0))
        return
    var ntype = 14
    if symbol.global:
        ntype = 15
    obuf.ObjectBufferWriteU8(buf, ntype)
    obuf.ObjectBufferWriteU8(buf, symbol.sectionIndex + 1)
    obuf.ObjectBufferWriteU16LE(buf, UInt64(0))
    obuf.ObjectBufferWriteU64LE(buf, UInt64(symbol.offset))

fn MachORelocType(kind: orel.ObjectRelocKind): Result[int32] =
    if kind == orel.ObjectRelocAbs32 ||
       kind == orel.ObjectRelocAbs64:
        return Ok[int32](0)
    if kind == orel.ObjectRelocBranch26:
        return Ok[int32](2)
    if kind == orel.ObjectRelocPage21:
        return Ok[int32](3)
    if kind == orel.ObjectRelocPageOff12:
        return Ok[int32](4)
    return Err[int32](Fmt" macho object writer: unsupported relocation kind={int32(kind)}")

fn MachORelocTypeFromCode(kindCode: int32): Result[int32] =
    if kindCode == 0 || kindCode == 1:
        return Ok[int32](0)
    if kindCode == 2:
        return Ok[int32](2)
    if kindCode == 3:
        return Ok[int32](3)
    if kindCode == 4:
        return Ok[int32](4)
    return Err[int32](Fmt" macho object writer: unsupported relocation kind_code={kindCode}")

fn MachORelocLengthFromType(relocType: int32): Result[int32] =
    if relocType == 0:
        return Ok[int32](3)
    if relocType == 2 ||
       relocType == 3 ||
       relocType == 4:
        return Ok[int32](2)
    return Err[int32](Fmt" macho object writer: unsupported relocation type={relocType}")

@borrows
fn MachOWriteRelocation(buf: var obuf.ObjectBuffer,
                         reloc: orel.ObjectReloc,
                         symbolCount: int32): Result[bool] =
    if reloc.sectionIndex != 0:
        return Err[bool](" macho object writer: unsupported relocation section")
    if reloc.offset < Int64(0) || reloc.offset > Int64(2147483647):
        return Err[bool](" macho object writer: relocation offset out of range")
    if reloc.symbolIndex < 0 || reloc.symbolIndex >= symbolCount:
        return Err[bool](" macho object writer: relocation symbol out of range")
    if reloc.addend != Int64(0):
        return Err[bool](" macho object writer: relocation addend not supported")
    let kindCode = orel.ObjectRelocKindCode(reloc.kind)
    let typeRes = MachORelocTypeFromCode(kindCode)
    if !typeRes.ok:
        let relocKindI32 = int32(reloc.kind)
        let typeErrMsg = strings.CloneStr(typeRes.err.msg)
        return Err[bool](Fmt"{typeErrMsg} enum_kind={relocKindI32} offset={reloc.offset} symbol_index={reloc.symbolIndex}")
    let lengthRes = MachORelocLengthFromType(typeRes.value)
    if !lengthRes.ok:
        return Err[bool](strings.CloneStr(lengthRes.err.msg))
    var word = reloc.symbolIndex & 0x00ffffff
    if reloc.pcRelative:
        word = word | (1 << 24)
    word = word | ((lengthRes.value & 3) << 25)
    word = word | (1 << 27)
    word = word | ((typeRes.value & 15) << 28)
    obuf.ObjectBufferWriteU32LE(buf, UInt64(reloc.offset))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(word))
    return Ok[bool](true)

@borrows
fn MachOWriteDebugRelocation(
        buf: var obuf.ObjectBuffer,
        reloc: debugsections.DirectObjectDebugRelocation,
        expectedSectionKind: int32,
        sectionSize: int32,
        symbolCount: int32): Result[bool] =
    if reloc.sectionKind != expectedSectionKind ||
       reloc.sectionByteOffset < 0 ||
       reloc.sectionByteOffset > sectionSize - 8:
        return Err[bool](" macho object writer: debug relocation range mismatch")
    if reloc.targetSymbolIndex < 0 ||
       reloc.targetSymbolIndex >= symbolCount:
        return Err[bool](" macho object writer: debug relocation symbol out of range")
    var word = reloc.targetSymbolIndex & 0x00ffffff
    word = word | (3 << 25)
    word = word | (1 << 27)
    word = word | (MachORelocA64Unsigned << 28)
    obuf.ObjectBufferWriteU32LE(
        buf, UInt64(reloc.sectionByteOffset))
    obuf.ObjectBufferWriteU32LE(buf, UInt64(word))
    return Ok[bool](true)

@borrows
fn MachOTextObjectBytes(text: Bytes,
                         symbols: osym.ObjectSymbolTable,
                         relocs: orel.ObjectRelocTable): Result[Bytes] =
    let relocCount = relocs.items.len
    let symbolCount = symbols.items.len
    if symbolCount <= 0:
        return Err[Bytes](" macho object writer: missing symbols")
    let segmentSize = 72 + 80
    let loadCommandBytes = segmentSize + 24
    let textOffset = 32 + loadCommandBytes
    let textSize = BytesLen(text)
    var relocOffset = 0
    var symoff = MachOAlign(textOffset + textSize, 8)
    if relocCount > 0:
        relocOffset = MachOAlign(textOffset + textSize, 8)
        symoff = MachOAlign(relocOffset + relocCount * 8, 8)
    let stroff = symoff + symbolCount * 16
    var strtab = obuf.ObjectBufferInit(128)
    defer:
        obuf.ObjectBufferRelease(strtab)
    var strOffsets: int32[]
    obuf.ObjectBufferWriteU8(strtab, 0)
    for i in 0..<symbolCount:
        let symbol = osym.ObjectSymbolsAt(symbols, i)
        add(strOffsets, obuf.ObjectBufferOffset(strtab))
        let symbolName = symbol.name
        MachOWriteCString(strtab, symbolName)
    let strsize = obuf.ObjectBufferLen(strtab)

    var out = obuf.ObjectBufferInit(stroff + strsize + 64)
    defer:
        obuf.ObjectBufferRelease(out)
    obuf.ObjectBufferWriteU32LE(out, UInt64(0xfeedfacf))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0x0100000c))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(1))
    obuf.ObjectBufferWriteU32LE(out, UInt64(2))
    obuf.ObjectBufferWriteU32LE(out, UInt64(loadCommandBytes))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0x2000))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))

    let segmentCommand = UInt64(25)
    let segmentCommandSize = UInt64(segmentSize)
    obuf.ObjectBufferWriteU32LE(out, segmentCommand)
    obuf.ObjectBufferWriteU32LE(out, segmentCommandSize)
    MachOWritePaddedAscii(out, "", 16)
    obuf.ObjectBufferWriteU64LE(out, UInt64(0))
    obuf.ObjectBufferWriteU64LE(out, UInt64(textSize))
    obuf.ObjectBufferWriteU64LE(out, UInt64(textOffset))
    obuf.ObjectBufferWriteU64LE(out, UInt64(textSize))
    obuf.ObjectBufferWriteU32LE(out, UInt64(7))
    obuf.ObjectBufferWriteU32LE(out, UInt64(7))
    obuf.ObjectBufferWriteU32LE(out, UInt64(1))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    MachOWriteTextSectionCommand(out, textOffset, textSize, relocOffset, relocCount)

    let symtabCommand = UInt64(2)
    let symtabCommandSize = UInt64(24)
    obuf.ObjectBufferWriteU32LE(out, symtabCommand)
    obuf.ObjectBufferWriteU32LE(out, symtabCommandSize)
    obuf.ObjectBufferWriteU32LE(out, UInt64(symoff))
    obuf.ObjectBufferWriteU32LE(out, UInt64(symbolCount))
    obuf.ObjectBufferWriteU32LE(out, UInt64(stroff))
    obuf.ObjectBufferWriteU32LE(out, UInt64(strsize))

    obuf.ObjectBufferWriteBytes(out, text)
    obuf.ObjectBufferAlign(out, 8, 0)
    for i in 0..<relocCount:
        let reloc = orel.ObjectRelocsAt(relocs, i)
        let relocRes = MachOWriteRelocation(out, reloc, symbolCount)
        if !relocRes.ok:
            return Err[Bytes](strings.CloneStr(relocRes.err.msg))
    obuf.ObjectBufferAlign(out, 8, 0)
    for i in 0..<symbolCount:
        let strOffset = strOffsets[i]
        let symbol = osym.ObjectSymbolsAt(symbols, i)
        MachOWriteNlist64(out, strOffset, symbol)
    obuf.ObjectBufferWriteBuffer(out, strtab)
    return Ok[Bytes](obuf.ObjectBufferTakeBytes(out))

@borrows
fn MachOTextDataObjectBytes(text: Bytes,
                             data: Bytes,
                             symbols: osym.ObjectSymbolTable,
                             relocs: orel.ObjectRelocTable): Result[Bytes] =
    let dataSize = data.len
    if dataSize <= 0:
        return MachOTextObjectBytes(text, symbols, relocs)
    let relocCount = relocs.items.len
    let symbolCount = symbols.items.len
    if symbolCount <= 0:
        return Err[Bytes](" macho object writer: missing symbols")
    let segmentSize = 72 + 80 * 2
    let loadCommandBytes = segmentSize + 24
    let textOffset = 32 + loadCommandBytes
    let textSize = BytesLen(text)
    let dataAddr = MachOAlign(textSize, 8)
    let dataOffset = textOffset + dataAddr
    var relocOffset = 0
    var symoff = MachOAlign(dataOffset + dataSize, 8)
    if relocCount > 0:
        relocOffset = MachOAlign(dataOffset + dataSize, 8)
        symoff = MachOAlign(relocOffset + relocCount * 8, 8)
    let stroff = symoff + symbolCount * 16
    var strtab = obuf.ObjectBufferInit(128)
    defer:
        obuf.ObjectBufferRelease(strtab)
    var strOffsets: int32[]
    obuf.ObjectBufferWriteU8(strtab, 0)
    for i in 0..<symbolCount:
        let symbol = osym.ObjectSymbolsAt(symbols, i)
        add(strOffsets, obuf.ObjectBufferOffset(strtab))
        let symbolName = symbol.name
        MachOWriteCString(strtab, symbolName)
    let strsize = obuf.ObjectBufferLen(strtab)

    var out = obuf.ObjectBufferInit(stroff + strsize + 64)
    defer:
        obuf.ObjectBufferRelease(out)
    obuf.ObjectBufferWriteU32LE(out, UInt64(0xfeedfacf))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0x0100000c))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(1))
    obuf.ObjectBufferWriteU32LE(out, UInt64(2))
    obuf.ObjectBufferWriteU32LE(out, UInt64(loadCommandBytes))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0x2000))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))

    obuf.ObjectBufferWriteU32LE(out, UInt64(25))
    obuf.ObjectBufferWriteU32LE(out, UInt64(segmentSize))
    MachOWritePaddedAscii(out, "", 16)
    obuf.ObjectBufferWriteU64LE(out, UInt64(0))
    obuf.ObjectBufferWriteU64LE(out, UInt64(dataAddr + dataSize))
    obuf.ObjectBufferWriteU64LE(out, UInt64(textOffset))
    obuf.ObjectBufferWriteU64LE(out, UInt64(dataAddr + dataSize))
    obuf.ObjectBufferWriteU32LE(out, UInt64(7))
    obuf.ObjectBufferWriteU32LE(out, UInt64(7))
    obuf.ObjectBufferWriteU32LE(out, UInt64(2))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    MachOWriteTextSectionCommand(out, textOffset, textSize, relocOffset, relocCount)
    MachOWriteDataSectionCommand(out, dataAddr, dataOffset, dataSize)

    obuf.ObjectBufferWriteU32LE(out, UInt64(2))
    obuf.ObjectBufferWriteU32LE(out, UInt64(24))
    obuf.ObjectBufferWriteU32LE(out, UInt64(symoff))
    obuf.ObjectBufferWriteU32LE(out, UInt64(symbolCount))
    obuf.ObjectBufferWriteU32LE(out, UInt64(stroff))
    obuf.ObjectBufferWriteU32LE(out, UInt64(strsize))

    obuf.ObjectBufferWriteBytes(out, text)
    obuf.ObjectBufferAlign(out, 8, 0)
    obuf.ObjectBufferWriteBytes(out, data)
    obuf.ObjectBufferAlign(out, 8, 0)
    for i in 0..<relocCount:
        let reloc = orel.ObjectRelocsAt(relocs, i)
        let relocRes = MachOWriteRelocation(out, reloc, symbolCount)
        if !relocRes.ok:
            return Err[Bytes](strings.CloneStr(relocRes.err.msg))
    obuf.ObjectBufferAlign(out, 8, 0)
    for i in 0..<symbolCount:
        let strOffset = strOffsets[i]
        let symbol = osym.ObjectSymbolsAt(symbols, i)
        MachOWriteNlist64(out, strOffset, symbol)
    obuf.ObjectBufferWriteBuffer(out, strtab)
    return Ok[Bytes](obuf.ObjectBufferTakeBytes(out))

@borrows
fn MachOTextDataDebugObjectBytes(
        text: Bytes,
        data: Bytes,
        symbols: osym.ObjectSymbolTable,
        relocs: orel.ObjectRelocTable,
        debug: debugsections.DirectObjectDebugSections): Result[Bytes] =
    let debugLine = debug.debugLine
    let debugInfo = debug.debugInfo
    let debugAbbrev = debug.debugAbbrev
    if !debug.valid || BytesLen(debugLine) <= 0 ||
       BytesLen(debugInfo) <= 0 ||
       BytesLen(debugAbbrev) <= 0:
        return Err[Bytes](" macho object writer: invalid debug sections")
    let textSize = BytesLen(text)
    let dataSize = BytesLen(data)
    let hasData = dataSize > 0
    let textRelocCount = orel.ObjectRelocsCount(relocs)
    let symbolCount = osym.ObjectSymbolsCount(symbols)
    if textSize <= 0 || symbolCount <= 0:
        return Err[Bytes](" macho object writer: debug object missing text or symbols")
    var lineRelocCount: int32
    var infoRelocCount: int32
    for index in 0..<debug.relocations.len:
        let row = debug.relocations[index]
        if row.sectionKind == debugsections.DirectObjectDebugSectionLine:
            lineRelocCount = lineRelocCount + 1
        elif row.sectionKind == debugsections.DirectObjectDebugSectionInfo:
            infoRelocCount = infoRelocCount + 1
        else:
            return Err[Bytes](" macho object writer: unknown debug relocation section")
    if lineRelocCount <= 0 || infoRelocCount <= 0:
        return Err[Bytes](" macho object writer: missing debug relocations")
    var sectionCount = 4
    if hasData:
        sectionCount = 5
    let segmentSize = 72 + 80 * sectionCount
    let loadCommandBytes = segmentSize + 24
    let textOffset = 32 + loadCommandBytes
    var nextAddr = textSize
    if hasData:
        nextAddr = MachOAlign(nextAddr, 8)
    let dataAddr = nextAddr
    let dataOffset = textOffset + dataAddr
    if hasData:
        nextAddr = dataAddr + dataSize
    let lineAddr = nextAddr
    let lineOffset = textOffset + lineAddr
    nextAddr = lineAddr + BytesLen(debugLine)
    let infoAddr = nextAddr
    let infoOffset = textOffset + infoAddr
    nextAddr = infoAddr + BytesLen(debugInfo)
    let abbrevAddr = nextAddr
    let abbrevOffset = textOffset + abbrevAddr
    nextAddr = abbrevAddr + BytesLen(debugAbbrev)

    var textRelocOffset: int32
    var nextFileOffset = MachOAlign(textOffset + nextAddr, 8)
    if textRelocCount > 0:
        textRelocOffset = nextFileOffset
        nextFileOffset = nextFileOffset + textRelocCount * 8
    let lineRelocOffset = MachOAlign(nextFileOffset, 8)
    nextFileOffset = lineRelocOffset + lineRelocCount * 8
    let infoRelocOffset = MachOAlign(nextFileOffset, 8)
    nextFileOffset = infoRelocOffset + infoRelocCount * 8
    let symoff = MachOAlign(nextFileOffset, 8)
    let stroff = symoff + symbolCount * 16
    var strtab = obuf.ObjectBufferInit(128)
    defer:
        obuf.ObjectBufferRelease(strtab)
    var strOffsets: int32[]
    obuf.ObjectBufferWriteU8(strtab, 0)
    for index in 0..<symbolCount:
        let symbol = osym.ObjectSymbolsAt(symbols, index)
        add(strOffsets, obuf.ObjectBufferOffset(strtab))
        let symbolName = symbol.name
        MachOWriteCString(strtab, symbolName)
    let strsize = obuf.ObjectBufferLen(strtab)

    var out = obuf.ObjectBufferInit(stroff + strsize + 64)
    defer:
        obuf.ObjectBufferRelease(out)
    MachOWriteHeader64(out, MachOFileTypeObject, 2, loadCommandBytes, 0x2000)
    obuf.ObjectBufferWriteU32LE(out, UInt64(MachOLoadCommandSegment64))
    obuf.ObjectBufferWriteU32LE(out, UInt64(segmentSize))
    MachOWritePaddedAscii(out, "", 16)
    obuf.ObjectBufferWriteU64LE(out, UInt64(0))
    obuf.ObjectBufferWriteU64LE(out, UInt64(nextAddr))
    obuf.ObjectBufferWriteU64LE(out, UInt64(textOffset))
    obuf.ObjectBufferWriteU64LE(out, UInt64(nextAddr))
    obuf.ObjectBufferWriteU32LE(out, UInt64(7))
    obuf.ObjectBufferWriteU32LE(out, UInt64(7))
    obuf.ObjectBufferWriteU32LE(out, UInt64(sectionCount))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    MachOWriteTextSectionCommand(
        out, textOffset, textSize, textRelocOffset, textRelocCount)
    if hasData:
        MachOWriteDataSectionCommand(out, dataAddr, dataOffset, dataSize)
    MachOWriteDebugSectionCommand(
        out, "__debug_line", lineAddr, lineOffset,
        BytesLen(debugLine), lineRelocOffset, lineRelocCount)
    MachOWriteDebugSectionCommand(
        out, "__debug_info", infoAddr, infoOffset,
        BytesLen(debugInfo), infoRelocOffset, infoRelocCount)
    MachOWriteDebugSectionCommand(
        out, "__debug_abbrev", abbrevAddr, abbrevOffset,
        BytesLen(debugAbbrev), 0, 0)

    obuf.ObjectBufferWriteU32LE(out, UInt64(MachOLoadCommandSymtab))
    obuf.ObjectBufferWriteU32LE(out, UInt64(MachOSymtabCommandSize))
    obuf.ObjectBufferWriteU32LE(out, UInt64(symoff))
    obuf.ObjectBufferWriteU32LE(out, UInt64(symbolCount))
    obuf.ObjectBufferWriteU32LE(out, UInt64(stroff))
    obuf.ObjectBufferWriteU32LE(out, UInt64(strsize))

    obuf.ObjectBufferWriteBytes(out, text)
    if hasData:
        obuf.ObjectBufferAlign(out, 8, 0)
        obuf.ObjectBufferWriteBytes(out, data)
    obuf.ObjectBufferWriteBytes(out, debugLine)
    obuf.ObjectBufferWriteBytes(out, debugInfo)
    obuf.ObjectBufferWriteBytes(out, debugAbbrev)
    obuf.ObjectBufferAlign(out, 8, 0)
    for index in 0..<textRelocCount:
        let reloc = orel.ObjectRelocsAt(relocs, index)
        let relocRes = MachOWriteRelocation(out, reloc, symbolCount)
        if !relocRes.ok:
            return Err[Bytes](strings.CloneStr(relocRes.err.msg))
    obuf.ObjectBufferAlign(out, 8, 0)
    for index in 0..<debug.relocations.len:
        let reloc = debug.relocations[index]
        if reloc.sectionKind == debugsections.DirectObjectDebugSectionLine:
            let relocRes = MachOWriteDebugRelocation(
                out, reloc, debugsections.DirectObjectDebugSectionLine,
                BytesLen(debugLine), symbolCount)
            if !relocRes.ok:
                return Err[Bytes](strings.CloneStr(relocRes.err.msg))
    obuf.ObjectBufferAlign(out, 8, 0)
    for index in 0..<debug.relocations.len:
        let reloc = debug.relocations[index]
        if reloc.sectionKind == debugsections.DirectObjectDebugSectionInfo:
            let relocRes = MachOWriteDebugRelocation(
                out, reloc, debugsections.DirectObjectDebugSectionInfo,
                BytesLen(debugInfo), symbolCount)
            if !relocRes.ok:
                return Err[Bytes](strings.CloneStr(relocRes.err.msg))
    obuf.ObjectBufferAlign(out, 8, 0)
    for index in 0..<symbolCount:
        let strOffset = strOffsets[index]
        let symbol = osym.ObjectSymbolsAt(symbols, index)
        MachOWriteNlist64(out, strOffset, symbol)
    obuf.ObjectBufferWriteBuffer(out, strtab)
    return Ok[Bytes](obuf.ObjectBufferTakeBytes(out))

@borrows
fn MachOTextExecutableBytes(text: Bytes,
                             entryTextOffset: int32): Result[Bytes] =
    let textSize = BytesLen(text)
    if textSize <= 0:
        return Err[Bytes](" macho executable writer: missing text")
    if entryTextOffset < 0 || entryTextOffset >= textSize:
        return Err[Bytes](" macho executable writer: entry offset out of range")
    let pageZeroSize = 72
    let segmentSize = 72 + 80
    let loadCommandBytes = pageZeroSize + segmentSize + 24
    let textOffset = 32 + loadCommandBytes
    let fileSize = textOffset + textSize
    let vmSize = MachOAlign(fileSize, 0x4000)
    let entryFileOffset = textOffset + entryTextOffset
    var out = obuf.ObjectBufferInit(fileSize + 64)
    defer:
        obuf.ObjectBufferRelease(out)

    MachOWriteHeader64(out,
                       2,
                       3,
                       loadCommandBytes,
                       0x200001)

    MachOWritePageZeroSegment(out)

    obuf.ObjectBufferWriteU32LE(out, UInt64(25))
    obuf.ObjectBufferWriteU32LE(out, UInt64(segmentSize))
    MachOWritePaddedAscii(out, "__TEXT", 16)
    obuf.ObjectBufferWriteU64LE(out, UInt64(0x100000000))
    obuf.ObjectBufferWriteU64LE(out, UInt64(vmSize))
    obuf.ObjectBufferWriteU64LE(out, UInt64(0))
    obuf.ObjectBufferWriteU64LE(out, UInt64(fileSize))
    obuf.ObjectBufferWriteU32LE(out, UInt64(5))
    obuf.ObjectBufferWriteU32LE(out, UInt64(5))
    obuf.ObjectBufferWriteU32LE(out, UInt64(1))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))

    MachOWritePaddedAscii(out, "__text", 16)
    MachOWritePaddedAscii(out, "__TEXT", 16)
    obuf.ObjectBufferWriteU64LE(out, UInt64(0x100000000) + UInt64(textOffset))
    obuf.ObjectBufferWriteU64LE(out, UInt64(textSize))
    obuf.ObjectBufferWriteU32LE(out, UInt64(textOffset))
    obuf.ObjectBufferWriteU32LE(out, UInt64(2))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0x80000400))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))

    MachOWriteEntryPointCommand(out, entryFileOffset)
    obuf.ObjectBufferWriteBytes(out, text)
    return Ok[Bytes](obuf.ObjectBufferTakeBytes(out))

@borrows
fn MachOTextDataExecutableBytes(text: Bytes,
                                 data: Bytes,
                                 entryTextOffset: int32): Result[Bytes] =
    let dataSize = BytesLen(data)
    if dataSize <= 0:
        return MachOTextExecutableBytes(text, entryTextOffset)
    let textSize = BytesLen(text)
    if textSize <= 0:
        return Err[Bytes](" macho executable writer: missing text")
    if entryTextOffset < 0 || entryTextOffset >= textSize:
        return Err[Bytes](" macho executable writer: entry offset out of range")
    let pageZeroSize = 72
    let segmentSize = 72 + 80
    let loadCommandBytes = pageZeroSize + segmentSize * 2 + 24
    let textOffset = 32 + loadCommandBytes
    let dataFileOffset = MachOAlign(textOffset + textSize, 8)
    let textFileEnd = textOffset + textSize
    let textVmEnd = MachOAlign(textFileEnd, 0x4000)
    let dataVmEnd = MachOAlign(dataFileOffset + dataSize, 0x4000)
    let textVmSize = textVmEnd
    let dataVmAddr = UInt64(0x100000000) + UInt64(textVmEnd)
    var dataVmSize = dataVmEnd - textVmEnd
    if dataVmSize <= 0:
        dataVmSize = 0x4000
    let entryFileOffset = textOffset + entryTextOffset
    var out = obuf.ObjectBufferInit(dataFileOffset + dataSize + 64)
    defer:
        obuf.ObjectBufferRelease(out)
    MachOWriteHeader64(out,
                       2,
                       4,
                       loadCommandBytes,
                       0x200001)
    MachOWritePageZeroSegment(out)
    obuf.ObjectBufferWriteU32LE(out, UInt64(25))
    obuf.ObjectBufferWriteU32LE(out, UInt64(segmentSize))
    MachOWritePaddedAscii(out, "__TEXT", 16)
    obuf.ObjectBufferWriteU64LE(out, UInt64(0x100000000))
    obuf.ObjectBufferWriteU64LE(out, UInt64(textVmSize))
    obuf.ObjectBufferWriteU64LE(out, UInt64(0))
    obuf.ObjectBufferWriteU64LE(out, UInt64(textFileEnd))
    obuf.ObjectBufferWriteU32LE(out, UInt64(5))
    obuf.ObjectBufferWriteU32LE(out, UInt64(5))
    obuf.ObjectBufferWriteU32LE(out, UInt64(1))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    MachOWritePaddedAscii(out, "__text", 16)
    MachOWritePaddedAscii(out, "__TEXT", 16)
    obuf.ObjectBufferWriteU64LE(out, UInt64(0x100000000) + UInt64(textOffset))
    obuf.ObjectBufferWriteU64LE(out, UInt64(textSize))
    obuf.ObjectBufferWriteU32LE(out, UInt64(textOffset))
    obuf.ObjectBufferWriteU32LE(out, UInt64(2))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0x80000400))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(25))
    obuf.ObjectBufferWriteU32LE(out, UInt64(segmentSize))
    MachOWritePaddedAscii(out, "__DATA", 16)
    obuf.ObjectBufferWriteU64LE(out, dataVmAddr)
    obuf.ObjectBufferWriteU64LE(out, UInt64(dataVmSize))
    obuf.ObjectBufferWriteU64LE(out, UInt64(dataFileOffset))
    obuf.ObjectBufferWriteU64LE(out, UInt64(dataSize))
    obuf.ObjectBufferWriteU32LE(out, UInt64(3))
    obuf.ObjectBufferWriteU32LE(out, UInt64(3))
    obuf.ObjectBufferWriteU32LE(out, UInt64(1))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    MachOWritePaddedAscii(out, "__data", 16)
    MachOWritePaddedAscii(out, "__DATA", 16)
    obuf.ObjectBufferWriteU64LE(out, dataVmAddr)
    obuf.ObjectBufferWriteU64LE(out, UInt64(dataSize))
    obuf.ObjectBufferWriteU32LE(out, UInt64(dataFileOffset))
    obuf.ObjectBufferWriteU32LE(out, UInt64(3))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    obuf.ObjectBufferWriteU32LE(out, UInt64(0))
    MachOWriteEntryPointCommand(out, entryFileOffset)
    obuf.ObjectBufferWriteBytes(out, text)
    obuf.ObjectBufferAlign(out, 8, 0)
    obuf.ObjectBufferWriteBytes(out, data)
    return Ok[Bytes](obuf.ObjectBufferTakeBytes(out))

@borrows
fn MachOTextObjectWrite(rootDir: str,
                         outputPath: str,
                         text: var Bytes,
                         symbols: var osym.ObjectSymbolTable,
                         relocs: var orel.ObjectRelocTable): Result[MachOObjectWriterResult] =
    var bytesRes = MachOTextObjectBytes(text, symbols, relocs)
    if !bytesRes.ok:
        return Err[MachOObjectWriterResult](strings.CloneStr(bytesRes.err.msg))
    var bytes = rawbytes.BytesTake(bytesRes.value)
    defer:
        rawbytes.BytesFree(bytes)
    let payload = BytesToString(bytes)
    if !chengpath.WriteTextFile(rootDir, outputPath, payload):
        return Err[MachOObjectWriterResult](Fmt" macho object writer: failed to write object: {outputPath}")
    var out: MachOObjectWriterResult
    out.objectPath = strings.CloneStr(outputPath)
    out.bytesWritten = bytes.len
    out.symbolCount = symbols.items.len
    out.relocCount = relocs.items.len
    return Ok[MachOObjectWriterResult](out)

@borrows
fn MachOTextExecutableWrite(rootDir: str,
                             outputPath: str,
                             text: Bytes,
                             entryTextOffset: int32): Result[MachOObjectWriterResult] =
    var bytesRes = MachOTextExecutableBytes(text, entryTextOffset)
    if !bytesRes.ok:
        return Err[MachOObjectWriterResult](strings.CloneStr(bytesRes.err.msg))
    var bytes = rawbytes.BytesTake(bytesRes.value)
    defer:
        rawbytes.BytesFree(bytes)
    let payload = BytesToString(bytes)
    if !chengpath.WriteTextFile(rootDir, outputPath, payload):
        return Err[MachOObjectWriterResult](Fmt" macho executable writer: failed to write executable: {outputPath}")
    var out: MachOObjectWriterResult
    out.objectPath = strings.CloneStr(outputPath)
    out.bytesWritten = BytesLen(bytes)
    out.symbolCount = 0
    out.relocCount = 0
    return Ok[MachOObjectWriterResult](out)

@borrows
fn MachOTextDataExecutableWrite(rootDir: str,
                                 outputPath: str,
                                 text: Bytes,
                                 data: Bytes,
                                 entryTextOffset: int32): Result[MachOObjectWriterResult] =
    var bytesRes = MachOTextDataExecutableBytes(text, data, entryTextOffset)
    if !bytesRes.ok:
        return Err[MachOObjectWriterResult](strings.CloneStr(bytesRes.err.msg))
    var bytes = rawbytes.BytesTake(bytesRes.value)
    defer:
        rawbytes.BytesFree(bytes)
    let payload = BytesToString(bytes)
    if !chengpath.WriteTextFile(rootDir, outputPath, payload):
        return Err[MachOObjectWriterResult](Fmt" macho executable writer: failed to write executable: {outputPath}")
    var out: MachOObjectWriterResult
    out.objectPath = strings.CloneStr(outputPath)
    out.bytesWritten = BytesLen(bytes)
    out.symbolCount = 0
    out.relocCount = 0
    return Ok[MachOObjectWriterResult](out)

fn MachOTextDataObjectWrite(rootDir: str,
                             outputPath: str,
                             text: var Bytes,
                             data: var Bytes,
                             symbols: var osym.ObjectSymbolTable,
                             relocs: var orel.ObjectRelocTable): Result[MachOObjectWriterResult] =
    var bytesRes = MachOTextDataObjectBytes(text, data, symbols, relocs)
    if !bytesRes.ok:
        return Err[MachOObjectWriterResult](strings.CloneStr(bytesRes.err.msg))
    var bytes = rawbytes.BytesTake(bytesRes.value)
    defer:
        rawbytes.BytesFree(bytes)
    let payload = BytesToString(bytes)
    if !chengpath.WriteTextFile(rootDir, outputPath, payload):
        return Err[MachOObjectWriterResult](Fmt" macho object writer: failed to write object: {outputPath}")
    var out: MachOObjectWriterResult
    out.objectPath = strings.CloneStr(outputPath)
    out.bytesWritten = bytes.len
    out.symbolCount = symbols.items.len
    out.relocCount = relocs.items.len
    return Ok[MachOObjectWriterResult](out)

fn MachOTextDataDebugObjectWrite(
        rootDir: str,
        outputPath: str,
        text: var Bytes,
        data: var Bytes,
        symbols: var osym.ObjectSymbolTable,
        relocs: var orel.ObjectRelocTable,
        debug: var debugsections.DirectObjectDebugSections): Result[MachOObjectWriterResult] =
    var bytesRes = MachOTextDataDebugObjectBytes(
        text, data, symbols, relocs, debug)
    if !bytesRes.ok:
        return Err[MachOObjectWriterResult](strings.CloneStr(bytesRes.err.msg))
    var objectBytes = rawbytes.BytesTake(bytesRes.value)
    defer:
        rawbytes.BytesFree(objectBytes)
    var parsed: debugevidence.MachODebugSectionEvidence
    var parseErr: str
    if !debugevidence.MachODebugSectionEvidenceBuildInto(
           objectBytes, debug, symbols, parsed, parseErr):
        return Err[MachOObjectWriterResult](parseErr)
    let payload = BytesToString(objectBytes)
    if !chengpath.WriteTextFile(rootDir, outputPath, payload):
        return Err[MachOObjectWriterResult](
            Fmt" macho object writer: failed to write debug object: {outputPath}")
    var out: MachOObjectWriterResult
    out.objectPath = strings.CloneStr(outputPath)
    out.bytesWritten = objectBytes.len
    out.symbolCount = symbols.items.len
    out.relocCount = relocs.items.len + debug.relocations.len
    return Ok[MachOObjectWriterResult](out)
