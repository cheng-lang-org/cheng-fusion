const
    PrimaryObjectCsgcChunkBytes: int32 = 3072
    PrimaryObjectCsgcBase64Alphabet: str =
        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    PrimaryObjectCsgcSchemaFact: str =
        "{\"features\":[\"native_object_emission_plan_replay\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    PrimaryObjectCsgcManifestKind: str =
        "csg_dialect::native::object_emission_plan"
    PrimaryObjectCsgcSectionChunkKind: str =
        "csg_dialect::native::object_section_chunk"
    PrimaryObjectCsgcSymbolKind: str =
        "csg_dialect::native::object_symbol"
    PrimaryObjectCsgcRelocationKind: str =
        "csg_dialect::native::object_relocation"
    PrimaryObjectCsgcDebugRelocationKind: str =
        "csg_dialect::native::object_debug_relocation"
    PrimaryObjectCsgcManifestId: str =
        "native-object-emission-plan"

type
    PrimaryObjectCsgcManifest =
        actualBackendKind: str
        dataByteCount: int32
        dataChunkCount: int32
        dataSha256: str
        debugAbbrevByteCount: int32
        debugAbbrevChunkCount: int32
        debugAbbrevSha256: str
        debugInfoByteCount: int32
        debugInfoChunkCount: int32
        debugInfoSha256: str
        debugLineByteCount: int32
        debugLineChunkCount: int32
        debugLineSha256: str
        debugRelocationCount: int32
        debugSourceReceiptCid: str
        debugValid: bool
        entryFunctionSymbol: str
        entrySymbol: str
        objectFormat: str
        relocationCount: int32
        symbolCount: int32
        targetTriple: str
        textByteCount: int32
        textChunkCount: int32
        textSha256: str

    PrimaryObjectCsgcCargo =
        ok: bool
        bytes: rawbytes.Bytes
        proofBytes: rawbytes.Bytes
        factsRoot: str
        subgraphCid: str
        planRoot: str
        targetTriple: str
        objectFormat: str
        textByteCount: int32
        dataByteCount: int32
        symbolCount: int32
        relocationCount: int32
        factCount: int32
        error: str

    PrimaryObjectCsgcReplay =
        ok: bool
        objectBytes: rawbytes.Bytes
        factsRoot: str
        subgraphCid: str
        planRoot: str
        targetTriple: str
        objectFormat: str
        actualBackendKind: str
        entrySymbol: str
        entryFunctionSymbol: str
        objectSha256: str
        objectByteCount: int32
        symbolCount: int32
        relocationCount: int32
        factCount: int32
        error: str

fn primaryObjectCsgcCargoFail(
        error: str): PrimaryObjectCsgcCargo =
    var out: PrimaryObjectCsgcCargo
    out.error = error
    return out

fn primaryObjectCsgcReplayFail(
        error: str): PrimaryObjectCsgcReplay =
    var out: PrimaryObjectCsgcReplay
    out.error = error
    return out

fn primaryObjectCsgcBoolText(value: bool): str =
    if value:
        return "true"
    return "false"

fn primaryObjectCsgcChunkCount(byteCount: int32): int32 =
    if byteCount <= 0:
        return 0
    return ((byteCount - 1) / PrimaryObjectCsgcChunkBytes) + 1

@borrows
fn primaryObjectCsgcSha256(bytes: rawbytes.Bytes): str =
    return strings.ConcatStr(
        "sha256:",
        layout.FixedBytes32Hex(
            hash256.Sha256Fixed(
                layout.ByteSpanFromBytes(bytes))))

@borrows
fn primaryObjectCsgcLowerHexDigest(text: str): bool =
    if len(text) != 71 ||
       !strutil.StartsWith(text, "sha256:"):
        return false
    for index in 7..<len(text):
        let ch = text[index]
        if !((ch >= '0' && ch <= '9') ||
             (ch >= 'a' && ch <= 'f')):
            return false
    return true

fn primaryObjectCsgcBase64Value(ch: char): int32 =
    if ch >= 'A' && ch <= 'Z':
        return int32(ch) - int32('A')
    if ch >= 'a' && ch <= 'z':
        return int32(ch) - int32('a') + 26
    if ch >= '0' && ch <= '9':
        return int32(ch) - int32('0') + 52
    if ch == '+':
        return 62
    if ch == '/':
        return 63
    return -1

@borrows
fn primaryObjectCsgcBase64EncodeRange(
        bytes: rawbytes.Bytes,
        offset: int32,
        count: int32): str =
    if offset < 0 || count <= 0 ||
       offset > rawbytes.BytesLen(bytes) - count:
        return ""
    let encodedLength = ((count + 2) / 3) * 4
    var encoded = rawbytes.BytesAlloc(encodedLength)
    defer:
        rawbytes.BytesFree(encoded)
    if rawbytes.BytesLen(encoded) != encodedLength:
        return ""
    var inputIndex: int32
    var outputIndex: int32
    while inputIndex < count:
        let remaining = count - inputIndex
        let first =
            rawbytes.BytesGet(bytes, offset + inputIndex) & 255
        var second: int32
        var third: int32
        if remaining > 1:
            second =
                rawbytes.BytesGet(
                    bytes, offset + inputIndex + 1) & 255
        if remaining > 2:
            third =
                rawbytes.BytesGet(
                    bytes, offset + inputIndex + 2) & 255
        let packed = (first << 16) | (second << 8) | third
        rawbytes.BytesSet(
            encoded,
            outputIndex,
            int32(PrimaryObjectCsgcBase64Alphabet[
                (packed >> 18) & 63]))
        rawbytes.BytesSet(
            encoded,
            outputIndex + 1,
            int32(PrimaryObjectCsgcBase64Alphabet[
                (packed >> 12) & 63]))
        if remaining > 1:
            rawbytes.BytesSet(
                encoded,
                outputIndex + 2,
                int32(PrimaryObjectCsgcBase64Alphabet[
                    (packed >> 6) & 63]))
        else:
            rawbytes.BytesSet(encoded, outputIndex + 2, int32('='))
        if remaining > 2:
            rawbytes.BytesSet(
                encoded,
                outputIndex + 3,
                int32(PrimaryObjectCsgcBase64Alphabet[packed & 63]))
        else:
            rawbytes.BytesSet(encoded, outputIndex + 3, int32('='))
        inputIndex = inputIndex + 3
        outputIndex = outputIndex + 4
    return rawbytes.BytesToString(encoded)

@borrows
fn primaryObjectCsgcBase64DecodeInto(
        payload: str,
        out: var rawbytes.Bytes,
        offset: int32,
        expectedCount: int32): bool =
    if expectedCount <= 0 || offset < 0 ||
       offset > rawbytes.BytesLen(out) - expectedCount ||
       len(payload) != ((expectedCount + 2) / 3) * 4:
        return false
    var inputIndex: int32
    var outputIndex: int32
    while inputIndex < len(payload):
        let finalGroup = inputIndex + 4 == len(payload)
        let first = primaryObjectCsgcBase64Value(payload[inputIndex])
        let second = primaryObjectCsgcBase64Value(payload[inputIndex + 1])
        if first < 0 || second < 0:
            return false
        let thirdChar = payload[inputIndex + 2]
        let fourthChar = payload[inputIndex + 3]
        var third: int32
        var fourth: int32
        var produced = 3
        if thirdChar == '=':
            if !finalGroup || fourthChar != '=' ||
               (second & 15) != 0:
                return false
            produced = 1
        else:
            third = primaryObjectCsgcBase64Value(thirdChar)
            if third < 0:
                return false
            if fourthChar == '=':
                if !finalGroup || (third & 3) != 0:
                    return false
                produced = 2
            else:
                fourth = primaryObjectCsgcBase64Value(fourthChar)
                if fourth < 0:
                    return false
        if outputIndex > expectedCount - produced:
            return false
        let packed =
            (first << 18) | (second << 12) |
            (third << 6) | fourth
        rawbytes.BytesSet(
            out, offset + outputIndex, (packed >> 16) & 255)
        if produced > 1:
            rawbytes.BytesSet(
                out, offset + outputIndex + 1, (packed >> 8) & 255)
        if produced > 2:
            rawbytes.BytesSet(
                out, offset + outputIndex + 2, packed & 255)
        outputIndex = outputIndex + produced
        inputIndex = inputIndex + 4
    return outputIndex == expectedCount

@borrows
fn primaryObjectCsgcBase64ValidForByteCount(
        payload: str,
        expectedCount: int32): bool =
    if expectedCount <= 0 ||
       len(payload) != ((expectedCount + 2) / 3) * 4:
        return false
    var inputIndex: int32
    var outputCount: int32
    while inputIndex < len(payload):
        let finalGroup = inputIndex + 4 == len(payload)
        let first =
            primaryObjectCsgcBase64Value(payload[inputIndex])
        let second =
            primaryObjectCsgcBase64Value(payload[inputIndex + 1])
        if first < 0 || second < 0:
            return false
        let thirdChar = payload[inputIndex + 2]
        let fourthChar = payload[inputIndex + 3]
        var produced: int32 = 3
        if thirdChar == '=':
            if !finalGroup || fourthChar != '=' ||
               expectedCount % 3 != 1 ||
               (second & 15) != 0:
                return false
            produced = 1
        else:
            let third =
                primaryObjectCsgcBase64Value(thirdChar)
            if third < 0:
                return false
            if fourthChar == '=':
                if !finalGroup || expectedCount % 3 != 2 ||
                   (third & 3) != 0:
                    return false
                produced = 2
            elif primaryObjectCsgcBase64Value(fourthChar) < 0:
                return false
        if outputCount > expectedCount - produced:
            return false
        outputCount = outputCount + produced
        inputIndex = inputIndex + 4
    return outputCount == expectedCount

@borrows
fn primaryObjectCsgcManifestFact(
        manifest: var PrimaryObjectCsgcManifest): str =
    var debugSourceReceiptCid = "null"
    if manifest.debugValid:
        debugSourceReceiptCid =
            canonical.CsgCoreJsonQuote(
                manifest.debugSourceReceiptCid)
    return Fmt"{{\"actualBackendKind\":{canonical.CsgCoreJsonQuote(manifest.actualBackendKind)},\"complete\":true,\"dataByteCount\":{primaryObjectCsgcCanonicalJsonIntText(int64(manifest.dataByteCount))},\"dataChunkCount\":{primaryObjectCsgcCanonicalJsonIntText(int64(manifest.dataChunkCount))},\"dataSha256\":{canonical.CsgCoreJsonQuote(manifest.dataSha256)},\"debugAbbrevByteCount\":{primaryObjectCsgcCanonicalJsonIntText(int64(manifest.debugAbbrevByteCount))},\"debugAbbrevChunkCount\":{primaryObjectCsgcCanonicalJsonIntText(int64(manifest.debugAbbrevChunkCount))},\"debugAbbrevSha256\":{canonical.CsgCoreJsonQuote(manifest.debugAbbrevSha256)},\"debugInfoByteCount\":{primaryObjectCsgcCanonicalJsonIntText(int64(manifest.debugInfoByteCount))},\"debugInfoChunkCount\":{primaryObjectCsgcCanonicalJsonIntText(int64(manifest.debugInfoChunkCount))},\"debugInfoSha256\":{canonical.CsgCoreJsonQuote(manifest.debugInfoSha256)},\"debugLineByteCount\":{primaryObjectCsgcCanonicalJsonIntText(int64(manifest.debugLineByteCount))},\"debugLineChunkCount\":{primaryObjectCsgcCanonicalJsonIntText(int64(manifest.debugLineChunkCount))},\"debugLineSha256\":{canonical.CsgCoreJsonQuote(manifest.debugLineSha256)},\"debugRelocationCount\":{primaryObjectCsgcCanonicalJsonIntText(int64(manifest.debugRelocationCount))},\"debugSourceReceiptCid\":{debugSourceReceiptCid},\"debugValid\":{primaryObjectCsgcBoolText(manifest.debugValid)},\"entryFunctionSymbol\":{canonical.CsgCoreJsonQuote(manifest.entryFunctionSymbol)},\"entrySymbol\":{canonical.CsgCoreJsonQuote(manifest.entrySymbol)},\"id\":\"native-object-emission-plan\",\"kind\":\"csg_dialect::native::object_emission_plan\",\"objectFormat\":{canonical.CsgCoreJsonQuote(manifest.objectFormat)},\"relocationCount\":{primaryObjectCsgcCanonicalJsonIntText(int64(manifest.relocationCount))},\"symbolCount\":{primaryObjectCsgcCanonicalJsonIntText(int64(manifest.symbolCount))},\"targetTriple\":{canonical.CsgCoreJsonQuote(manifest.targetTriple)},\"textByteCount\":{primaryObjectCsgcCanonicalJsonIntText(int64(manifest.textByteCount))},\"textChunkCount\":{primaryObjectCsgcCanonicalJsonIntText(int64(manifest.textChunkCount))},\"textSha256\":{canonical.CsgCoreJsonQuote(manifest.textSha256)}}}"

@borrows
fn primaryObjectCsgcSectionChunkFactFields(
        section: str,
        ordinal: int32,
        offset: int32,
        byteCount: int32,
        payloadBase64: str): str =
    return Fmt"{{\"byteCount\":{primaryObjectCsgcCanonicalJsonIntText(int64(byteCount))},\"id\":{canonical.CsgCoreJsonQuote(Fmt\"native-object-section-{section}-{ordinal}\")},\"kind\":\"csg_dialect::native::object_section_chunk\",\"offset\":{primaryObjectCsgcCanonicalJsonIntText(int64(offset))},\"ordinal\":{primaryObjectCsgcCanonicalJsonIntText(int64(ordinal))},\"payloadBase64\":{canonical.CsgCoreJsonQuote(payloadBase64)},\"section\":{canonical.CsgCoreJsonQuote(section)}}}"

@borrows
fn primaryObjectCsgcAppendSectionFacts(
        lines: var str[],
        section: str,
        bytes: rawbytes.Bytes): bool =
    let chunkCount =
        primaryObjectCsgcChunkCount(rawbytes.BytesLen(bytes))
    for ordinal in 0..<chunkCount:
        let offset = ordinal * PrimaryObjectCsgcChunkBytes
        var count = rawbytes.BytesLen(bytes) - offset
        if count > PrimaryObjectCsgcChunkBytes:
            count = PrimaryObjectCsgcChunkBytes
        let payload =
            primaryObjectCsgcBase64EncodeRange(
                bytes, offset, count)
        if len(payload) <= 0:
            return false
        add(
            lines,
            primaryObjectCsgcSectionChunkFactFields(
                section, ordinal, offset, count, payload))
    return true

@borrows
fn primaryObjectCsgcSymbolFactFields(
        symbol: osym.ObjectSymbol,
        ordinal: int32): str =
    return Fmt"{{\"global\":{primaryObjectCsgcBoolText(symbol.global)},\"id\":\"native-object-symbol-{ordinal}\",\"kind\":\"csg_dialect::native::object_symbol\",\"name\":{canonical.CsgCoreJsonQuote(symbol.name)},\"offset\":{primaryObjectCsgcCanonicalJsonIntText(symbol.offset)},\"ordinal\":{primaryObjectCsgcCanonicalJsonIntText(int64(ordinal))},\"sectionIndex\":{primaryObjectCsgcCanonicalJsonIntText(int64(symbol.sectionIndex))},\"size\":{primaryObjectCsgcCanonicalJsonIntText(symbol.size)},\"undefined\":{primaryObjectCsgcBoolText(symbol.undefined)}}}"

@borrows
fn primaryObjectCsgcRelocationFactFields(
        reloc: orel.ObjectReloc,
        ordinal: int32): str =
    return Fmt"{{\"addend\":{primaryObjectCsgcCanonicalJsonIntText(reloc.addend)},\"id\":\"native-object-relocation-{ordinal}\",\"kind\":\"csg_dialect::native::object_relocation\",\"offset\":{primaryObjectCsgcCanonicalJsonIntText(reloc.offset)},\"ordinal\":{primaryObjectCsgcCanonicalJsonIntText(int64(ordinal))},\"pcRelative\":{primaryObjectCsgcBoolText(reloc.pcRelative)},\"relocationKind\":{primaryObjectCsgcCanonicalJsonIntText(int64(orel.ObjectRelocKindCode(reloc.kind)))},\"sectionIndex\":{primaryObjectCsgcCanonicalJsonIntText(int64(reloc.sectionIndex))},\"symbolIndex\":{primaryObjectCsgcCanonicalJsonIntText(int64(reloc.symbolIndex))}}}"

@borrows
fn primaryObjectCsgcDebugRelocationFactFields(
        reloc: debugsections.DirectObjectDebugRelocation,
        ordinal: int32): str =
    return Fmt"{{\"id\":\"native-object-debug-relocation-{ordinal}\",\"kind\":\"csg_dialect::native::object_debug_relocation\",\"ordinal\":{primaryObjectCsgcCanonicalJsonIntText(int64(ordinal))},\"sectionByteOffset\":{primaryObjectCsgcCanonicalJsonIntText(int64(reloc.sectionByteOffset))},\"sectionKind\":{primaryObjectCsgcCanonicalJsonIntText(int64(reloc.sectionKind))},\"targetAddend\":{primaryObjectCsgcCanonicalJsonIntText(int64(reloc.targetAddend))},\"targetSymbolIndex\":{primaryObjectCsgcCanonicalJsonIntText(int64(reloc.targetSymbolIndex))},\"targetSymbolName\":{canonical.CsgCoreJsonQuote(reloc.targetSymbolName)},\"targetTextByteStart\":{primaryObjectCsgcCanonicalJsonIntText(int64(reloc.targetTextByteStart))}}}"

fn primaryObjectCsgcCanonicalJsonIntText(value: int64): str =
    # JSON canonical integer form used by CsgCoreJsonCanonicalize (same
    # rule as csgCompilerCargoAppendCanonicalNat: 1000 -> 1e3 because the
    # scientific form is strictly shorter).  Raw numeric fact fields are
    # emitted in this form so the replay admission per-line canonicality
    # proof (CsgCoreMerkleBuildBoundFromLines) sees canonical input.
    let plain = Fmt"{value}"
    if value > -10 && value < 10:
        return plain
    var negative = false
    # t13: spec 迁移——默认 move 偷走 plain 的唯一所有权（use-after-move，T11 定谳），
    # share 产生共享 owning def：读语义不变，尾臂 return plain 不再踩已释放缓冲。
    var magnitude = share(plain)
    if value < 0:
        negative = true
        magnitude = strings.SliceBytes(plain, 1, len(plain) - 1)
    var trailing: int32
    while trailing < len(magnitude) && magnitude[len(magnitude) - 1 - trailing] == '0':
        trailing = trailing + 1
    let significant = len(magnitude) - trailing
    let exponent = len(magnitude) - 1
    var scientific = ""
    if negative:
        scientific = "-"
    scientific = strings.ConcatStr(
        scientific,
        strings.SliceBytes(magnitude, 0, 1))
    if significant > 1:
        scientific = strings.ConcatStr(scientific, ".")
        scientific = strings.ConcatStr(
            scientific,
            strings.SliceBytes(magnitude, 1, significant - 1))
    if exponent != 0:
        scientific = strings.ConcatStr(scientific, "e")
        scientific = strings.ConcatStr(
            scientific,
            strings.IntToStr(exponent))
    var scientificLength = len(scientific)
    if negative:
        scientificLength = scientificLength - 1
    if len(magnitude) > scientificLength:
        return scientific
    return plain

@borrows
fn primaryObjectCsgcJsonCanonicalInt64Text(
        line: str,
        field: str,
        out: var int64): bool =
    # Reader for raw numeric fact fields emitted in the JSON canonical
    # integer form (primaryObjectCsgcCanonicalJsonIntText).  Parses the
    # canonical number text exactly (digits [. zeros] [e exp]) without
    # going through float64; the caller's re-emit equality check binds
    # the accepted text to the canonical form.
    out = 0
    let found = jfield.CsgCoreJsonTopRawField(line, field)
    if !found.found || found.value.len == 0:
        return false
    let text = found.value
    var pos: int32
    var negative = false
    if text[pos] == '-':
        negative = true
        pos = pos + 1
    var magnitude: int64
    var seenDigit = false
    while pos < len(text) && text[pos] >= '0' && text[pos] <= '9':
        let digit = int64(int32(text[pos]) - int32('0'))
        if magnitude > (int64(9223372036854775807) - digit) / int64(10):
            return false
        magnitude = magnitude * int64(10) + digit
        seenDigit = true
        pos = pos + 1
    if !seenDigit:
        return false
    var shift: int32
    if pos < len(text) && text[pos] == '.':
        pos = pos + 1
        while pos < len(text) && text[pos] == '0':
            shift = shift - 1
            pos = pos + 1
        if pos < len(text) && text[pos] >= '0' && text[pos] <= '9':
            return false
    if pos < len(text) && (text[pos] == 'e' || text[pos] == 'E'):
        pos = pos + 1
        var expNegative = false
        if pos < len(text) && (text[pos] == '+' || text[pos] == '-'):
            expNegative = text[pos] == '-'
            pos = pos + 1
        var expValue: int32
        var seenExp = false
        while pos < len(text) && text[pos] >= '0' && text[pos] <= '9':
            if expValue > 100:
                return false
            expValue = expValue * 10 + (int32(text[pos]) - int32('0'))
            seenExp = true
            pos = pos + 1
        if !seenExp:
            return false
        if expNegative:
            shift = shift - expValue
        else:
            shift = shift + expValue
    if pos != len(text):
        return false
    while shift > 0:
        if magnitude > int64(9223372036854775807) / int64(10):
            return false
        magnitude = magnitude * int64(10)
        shift = shift - 1
    while shift < 0:
        if magnitude % int64(10) != 0:
            return false
        magnitude = magnitude / int64(10)
        shift = shift + 1
    if negative:
        magnitude = -magnitude
    out = magnitude
    return true

@borrows
fn primaryObjectCsgcJsonCanonicalInt32Text(
        line: str,
        field: str,
        out: var int32): bool =
    # int32-ranged wrapper over the canonical integer text reader.  Same
    # acceptance contract: the caller's re-emit equality check pins the
    # accepted text to the canonical integer form.
    var value: int64
    if !primaryObjectCsgcJsonCanonicalInt64Text(line, field, value):
        return false
    let minimum = int64(-2147483647) - int64(1)
    if value < minimum || value > int64(2147483647):
        return false
    out = int32(value)
    return true

@borrows
fn primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
        line: str,
        field: str,
        out: var int32): bool =
    if !primaryObjectCsgcJsonCanonicalInt32Text(line, field, out):
        return false
    return out >= 0

@borrows
fn primaryObjectCsgcFreezePlanInto(
        plan: var pobj.PrimaryObjectPlan,
        out: var nativeplan.NativeObjectEmissionPlan,
        outErr: var str): bool =
    nativeplan.NativeObjectEmissionPlanRelease(out)
    outErr = ""
    var validateErr: str
    if !direct.DirectObjectEmitValidatePlanObjectInto(
           plan, validateErr):
        outErr = validateErr
        return false
    var text = direct.DirectObjectEmitPlanText(plan)
    var data =
        direct.DirectObjectEmitPlanData(
            plan, plan.functionBodyKinds.len)
    var symbols: osym.ObjectSymbolTable
    direct.DirectObjectEmitPlanSymbolsInto(
        plan, plan.targetTriple, symbols)
    var relocs: orel.ObjectRelocTable
    direct.DirectObjectEmitPlanRelocsInto(
        plan, symbols, relocs)
    var debug: debugsections.DirectObjectDebugSections
    if !direct.DirectObjectEmitBuildDebugSectionsInto(
           plan, symbols, debug, outErr):
        rawbytes.BytesFree(text)
        rawbytes.BytesFree(data)
        return false
    var candidate: nativeplan.NativeObjectEmissionPlan
    candidate.targetTriple = strings.CloneStr(plan.targetTriple)
    candidate.objectFormat = strings.CloneStr(plan.objectFormat)
    candidate.actualBackendKind =
        strings.CloneStr(plan.actualBackendKind)
    if len(plan.entrySymbol) <= 0 &&
       len(plan.entryFunctionSymbol) > 0:
        plan.entrySymbol = strings.CloneStr(plan.entryFunctionSymbol)
    candidate.entrySymbol = strings.CloneStr(plan.entrySymbol)
    candidate.entryFunctionSymbol =
        strings.CloneStr(plan.entryFunctionSymbol)
    candidate.text = rawbytes.BytesTake(text)
    candidate.data = rawbytes.BytesTake(data)
    candidate.symbols = symbols
    candidate.relocs = relocs
    candidate.debug.valid = debug.valid
    candidate.debug.sourceReceiptCid = debug.sourceReceiptCid
    candidate.debug.debugLine = rawbytes.BytesTake(debug.debugLine)
    candidate.debug.debugInfo = rawbytes.BytesTake(debug.debugInfo)
    candidate.debug.debugAbbrev = rawbytes.BytesTake(debug.debugAbbrev)
    candidate.debug.relocations = debug.relocations
    if !nativeplan.NativeObjectEmissionPlanValidateInto(
           candidate, outErr):
        nativeplan.NativeObjectEmissionPlanRelease(candidate)
        return false
    out = candidate
    return true

@borrows
fn primaryObjectCsgcManifestFromPlan(
        plan: var nativeplan.NativeObjectEmissionPlan):
        PrimaryObjectCsgcManifest =
    var out: PrimaryObjectCsgcManifest
    out.actualBackendKind =
        strings.CloneStr(plan.actualBackendKind)
    out.dataByteCount = rawbytes.BytesLen(plan.data)
    out.dataChunkCount =
        primaryObjectCsgcChunkCount(out.dataByteCount)
    out.dataSha256 = primaryObjectCsgcSha256(plan.data)
    out.debugAbbrevByteCount =
        rawbytes.BytesLen(plan.debug.debugAbbrev)
    out.debugAbbrevChunkCount =
        primaryObjectCsgcChunkCount(
            out.debugAbbrevByteCount)
    out.debugAbbrevSha256 =
        primaryObjectCsgcSha256(plan.debug.debugAbbrev)
    out.debugInfoByteCount =
        rawbytes.BytesLen(plan.debug.debugInfo)
    out.debugInfoChunkCount =
        primaryObjectCsgcChunkCount(out.debugInfoByteCount)
    out.debugInfoSha256 =
        primaryObjectCsgcSha256(plan.debug.debugInfo)
    out.debugLineByteCount =
        rawbytes.BytesLen(plan.debug.debugLine)
    out.debugLineChunkCount =
        primaryObjectCsgcChunkCount(out.debugLineByteCount)
    out.debugLineSha256 =
        primaryObjectCsgcSha256(plan.debug.debugLine)
    out.debugRelocationCount =
        plan.debug.relocations.len
    if plan.debug.valid:
        out.debugSourceReceiptCid =
            strings.ConcatStr(
                "sha256:",
                layout.FixedBytes32Hex(
                    plan.debug.sourceReceiptCid))
    out.debugValid = plan.debug.valid
    out.entryFunctionSymbol =
        strings.CloneStr(plan.entryFunctionSymbol)
    out.entrySymbol = strings.CloneStr(plan.entrySymbol)
    out.objectFormat = strings.CloneStr(plan.objectFormat)
    out.relocationCount = plan.relocs.items.len
    out.symbolCount = plan.symbols.items.len
    out.targetTriple = strings.CloneStr(plan.targetTriple)
    out.textByteCount = rawbytes.BytesLen(plan.text)
    out.textChunkCount =
        primaryObjectCsgcChunkCount(out.textByteCount)
    out.textSha256 = primaryObjectCsgcSha256(plan.text)
    return out

@borrows
fn PrimaryObjectCsgcCargoBuild(
        plan: var pobj.PrimaryObjectPlan): PrimaryObjectCsgcCargo =
    var frozen: nativeplan.NativeObjectEmissionPlan
    defer:
        nativeplan.NativeObjectEmissionPlanRelease(frozen)
    var freezeErr: str
    if !primaryObjectCsgcFreezePlanInto(
           plan, frozen, freezeErr):
        return primaryObjectCsgcCargoFail(
            strings.ConcatStr(
                "primary object CSGC plan: ", freezeErr))
    var manifest =
        primaryObjectCsgcManifestFromPlan(frozen)
    var lines: str[]
    add(lines, PrimaryObjectCsgcSchemaFact)
    let manifestFact =
        primaryObjectCsgcManifestFact(manifest)
    add(lines, strings.CloneStr(manifestFact))
    if !primaryObjectCsgcAppendSectionFacts(
           lines, "text", frozen.text) ||
       !primaryObjectCsgcAppendSectionFacts(
           lines, "data", frozen.data) ||
       !primaryObjectCsgcAppendSectionFacts(
           lines, "debug_line", frozen.debug.debugLine) ||
       !primaryObjectCsgcAppendSectionFacts(
           lines, "debug_info", frozen.debug.debugInfo) ||
       !primaryObjectCsgcAppendSectionFacts(
           lines, "debug_abbrev", frozen.debug.debugAbbrev):
        return primaryObjectCsgcCargoFail(
            "primary object CSGC plan: section encode failed")
    for ordinal in 0..<frozen.symbols.items.len:
        add(
            lines,
            primaryObjectCsgcSymbolFactFields(
                frozen.symbols.items[ordinal], ordinal))
    for ordinal in 0..<frozen.relocs.items.len:
        add(
            lines,
            primaryObjectCsgcRelocationFactFields(
                frozen.relocs.items[ordinal], ordinal))
    for ordinal in 0..<frozen.debug.relocations.len:
        add(
            lines,
            primaryObjectCsgcDebugRelocationFactFields(
                frozen.debug.relocations[ordinal], ordinal))
    var planDag: merkle_dag.CsgCoreMerkleDag
    let admission =
        validator.CsgCoreProductionAdmitFactLinesWithDag(
            lines, planDag)
    if !admission.valid || !admission.complete ||
       !validator.CsgCoreProfilesEqual(
           admission.profiles,
           ["csg_core", "csg_dialect::native"]) ||
       admission.profileSetCid !=
           validator.CsgCoreProfileSetCid(
               admission.profiles) ||
       admission.factCount != lines.len ||
       !planDag.ok ||
       planDag.factsRoot != admission.factsRoot ||
       !primaryObjectCsgcLowerHexDigest(admission.factsRoot) ||
       !primaryObjectCsgcLowerHexDigest(planDag.subgraphCid):
        var reason =
            "primary object CSGC plan: admission failed"
        if admission.errors.len > 0:
            reason =
                strings.ConcatStr(
                    reason,
                    strings.ConcatStr(" ", admission.errors[0]))
        return primaryObjectCsgcCargoFail(reason)
    var manifestKeyErr: str
    let manifestKey =
        merkle_dag.CsgCoreMerkleFactKey(
            manifestFact, manifestKeyErr)
    if manifestKeyErr.len > 0:
        return primaryObjectCsgcCargoFail(
            strings.ConcatStr(
                "primary object CSGC plan: ",
                manifestKeyErr))
    let manifestProof =
        merkle_dag.CsgCoreMerkleProveKey(
            planDag, manifestKey)
    let manifestVerified =
        merkle_dag.CsgCoreMerkleVerifyFact(
            manifestProof,
            admission.factsRoot,
            manifestFact)
    if !manifestVerified.ok || !manifestVerified.exists ||
       manifestVerified.subgraphCid != planDag.subgraphCid:
        return primaryObjectCsgcCargoFail(
            "primary object CSGC plan: manifest proof invalid")
    var proofCargo =
        merkle_cargo.CsgCoreMerkleProofEncodeCsgc(
            manifestProof, admission.factsRoot)
    if !proofCargo.ok:
        return primaryObjectCsgcCargoFail(
            strings.ConcatStr(
                "primary object CSGC plan: ",
                proofCargo.error))
    var encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !encoded.ok || encoded.factCount != admission.factCount:
        rawbytes.BytesFree(proofCargo.bytes)
        if encoded.ok:
            rawbytes.BytesFree(encoded.bytes)
        return primaryObjectCsgcCargoFail(
            strings.ConcatStr(
                "primary object CSGC plan: ", encoded.error))
    var out: PrimaryObjectCsgcCargo
    out.ok = true
    out.bytes = encoded.bytes
    out.proofBytes = proofCargo.bytes
    out.factsRoot = strings.CloneStr(admission.factsRoot)
    out.subgraphCid = strings.CloneStr(planDag.subgraphCid)
    out.planRoot = strings.CloneStr(admission.factsRoot)
    out.targetTriple = strings.CloneStr(manifest.targetTriple)
    out.objectFormat = strings.CloneStr(manifest.objectFormat)
    out.textByteCount = manifest.textByteCount
    out.dataByteCount = manifest.dataByteCount
    out.symbolCount = manifest.symbolCount
    out.relocationCount =
        manifest.relocationCount +
        manifest.debugRelocationCount
    out.factCount = encoded.factCount
    return out

@borrows
fn primaryObjectCsgcJsonString(
        node: json.JsonNode,
        field: str,
        out: var str): bool =
    let value = json.JsonGetField(node, field)
    if value.kind != json.JString:
        return false
    out = strings.CloneStr(json.GetStr(value))
    return true

@borrows
fn primaryObjectCsgcJsonBool(
        node: json.JsonNode,
        field: str,
        out: var bool): bool =
    let value = json.JsonGetField(node, field)
    if value.kind != json.JBool:
        return false
    out = json.GetBool(value, false)
    return true

@borrows
fn primaryObjectCsgcJsonInt32(
        node: json.JsonNode,
        field: str,
        out: var int32): bool =
    let value = json.JsonGetField(node, field)
    if value.kind != json.JInt:
        return false
    let number = json.GetInt64(value, int64(0))
    let minimum = int64(-2147483647) - int64(1)
    if number < minimum || number > int64(2147483647):
        return false
    out = int32(number)
    return true

@borrows
fn primaryObjectCsgcJsonNonnegativeInt32(
        node: json.JsonNode,
        field: str,
        out: var int32): bool =
    if !primaryObjectCsgcJsonInt32(node, field, out):
        return false
    return out >= 0

@borrows
fn primaryObjectCsgcJsonInt64(
        node: json.JsonNode,
        field: str,
        out: var int64): bool =
    let value = json.JsonGetField(node, field)
    if value.kind != json.JInt:
        return false
    out = json.GetInt64(value, int64(0))
    return true

@borrows
fn primaryObjectCsgcFactKind(
        line: str,
        outKind: var str): bool =
    let parsed = json.ParseJsonSafe(line)
    if !parsed.success || parsed.value.kind != json.JObject:
        return false
    return primaryObjectCsgcJsonString(
        parsed.value, "kind", outKind)

@borrows
fn primaryObjectCsgcDecodeCid(
        text: str,
        out: var layout.FixedBytes32): bool =
    if !primaryObjectCsgcLowerHexDigest(text):
        return false
    let raw = strings.SliceBytes(text, 7, 64)
    let parsed = layout.FixedBytes32FromHex(raw)
    if !IsOk(parsed):
        return false
    out = Value(parsed)
    return layout.FixedBytes32Hex(out) == raw

@borrows
fn primaryObjectCsgcParseManifest(
        line: str,
        out: var PrimaryObjectCsgcManifest): bool =
    let parsed = json.ParseJsonSafe(line)
    if !parsed.success || parsed.value.kind != json.JObject:
        return false
    var id: str
    var kind: str
    var complete: bool
    if !primaryObjectCsgcJsonString(parsed.value, "id", id) ||
       id != PrimaryObjectCsgcManifestId ||
       !primaryObjectCsgcJsonString(parsed.value, "kind", kind) ||
       kind != PrimaryObjectCsgcManifestKind ||
       !primaryObjectCsgcJsonBool(
           parsed.value, "complete", complete) ||
       !complete ||
       !primaryObjectCsgcJsonString(
           parsed.value,
           "actualBackendKind",
           out.actualBackendKind) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line, "dataByteCount", out.dataByteCount) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line, "dataChunkCount", out.dataChunkCount) ||
       !primaryObjectCsgcJsonString(
           parsed.value, "dataSha256", out.dataSha256) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line,
           "debugAbbrevByteCount",
           out.debugAbbrevByteCount) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line,
           "debugAbbrevChunkCount",
           out.debugAbbrevChunkCount) ||
       !primaryObjectCsgcJsonString(
           parsed.value,
           "debugAbbrevSha256",
           out.debugAbbrevSha256) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line,
           "debugInfoByteCount",
           out.debugInfoByteCount) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line,
           "debugInfoChunkCount",
           out.debugInfoChunkCount) ||
       !primaryObjectCsgcJsonString(
           parsed.value,
           "debugInfoSha256",
           out.debugInfoSha256) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line,
           "debugLineByteCount",
           out.debugLineByteCount) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line,
           "debugLineChunkCount",
           out.debugLineChunkCount) ||
       !primaryObjectCsgcJsonString(
           parsed.value,
           "debugLineSha256",
           out.debugLineSha256) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line,
           "debugRelocationCount",
           out.debugRelocationCount) ||
       !primaryObjectCsgcJsonBool(
           parsed.value, "debugValid", out.debugValid) ||
       !primaryObjectCsgcJsonString(
           parsed.value,
           "entryFunctionSymbol",
           out.entryFunctionSymbol) ||
       !primaryObjectCsgcJsonString(
           parsed.value, "entrySymbol", out.entrySymbol) ||
       !primaryObjectCsgcJsonString(
           parsed.value, "objectFormat", out.objectFormat) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line,
           "relocationCount",
           out.relocationCount) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line, "symbolCount", out.symbolCount) ||
       !primaryObjectCsgcJsonString(
           parsed.value, "targetTriple", out.targetTriple) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line, "textByteCount", out.textByteCount) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line, "textChunkCount", out.textChunkCount) ||
       !primaryObjectCsgcJsonString(
           parsed.value, "textSha256", out.textSha256):
        return false
    let debugCidNode =
        json.JsonGetField(parsed.value, "debugSourceReceiptCid")
    if out.debugValid:
        if debugCidNode.kind != json.JString:
            return false
        out.debugSourceReceiptCid =
            strings.CloneStr(json.GetStr(debugCidNode))
        var parsedCid: layout.FixedBytes32
        if !primaryObjectCsgcDecodeCid(
               out.debugSourceReceiptCid, parsedCid):
            return false
    elif debugCidNode.kind != json.JNull:
        return false
    if out.textByteCount <= 0 || out.symbolCount <= 0 ||
       out.textChunkCount !=
           primaryObjectCsgcChunkCount(out.textByteCount) ||
       out.dataChunkCount !=
           primaryObjectCsgcChunkCount(out.dataByteCount) ||
       out.debugLineChunkCount !=
           primaryObjectCsgcChunkCount(out.debugLineByteCount) ||
       out.debugInfoChunkCount !=
           primaryObjectCsgcChunkCount(out.debugInfoByteCount) ||
       out.debugAbbrevChunkCount !=
           primaryObjectCsgcChunkCount(out.debugAbbrevByteCount) ||
       !primaryObjectCsgcLowerHexDigest(out.textSha256) ||
       !primaryObjectCsgcLowerHexDigest(out.dataSha256) ||
       !primaryObjectCsgcLowerHexDigest(out.debugLineSha256) ||
       !primaryObjectCsgcLowerHexDigest(out.debugInfoSha256) ||
       !primaryObjectCsgcLowerHexDigest(out.debugAbbrevSha256):
        return false
    if !out.debugValid &&
       (out.debugLineByteCount != 0 ||
        out.debugInfoByteCount != 0 ||
        out.debugAbbrevByteCount != 0 ||
        out.debugRelocationCount != 0):
        return false
    return line == primaryObjectCsgcManifestFact(out)

fn primaryObjectCsgcAllocBytes(
        byteCount: int32,
        out: var rawbytes.Bytes): bool =
    if byteCount < 0:
        return false
    if byteCount == 0:
        out = rawbytes.EmptyBytes()
        return true
    out = rawbytes.BytesAlloc(byteCount)
    return rawbytes.BytesLen(out) == byteCount

@borrows
fn primaryObjectCsgcParseSectionChunkFor(
        line: str,
        node: json.JsonNode,
        expectedSection: str,
        expectedByteCount: int32,
        expectedChunkCount: int32,
        seen: var bool[],
        outBytes: var rawbytes.Bytes): bool =
    var section: str
    var payloadBase64: str
    var byteCount: int32
    var offset: int32
    var ordinal: int32
    if !primaryObjectCsgcJsonString(
           node, "section", section) ||
       section != expectedSection ||
       !primaryObjectCsgcJsonString(
           node, "payloadBase64", payloadBase64) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line, "byteCount", byteCount) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line, "offset", offset) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line, "ordinal", ordinal) ||
       ordinal >= expectedChunkCount || seen[ordinal]:
        return false
    let expectedOffset = ordinal * PrimaryObjectCsgcChunkBytes
    var expectedCount = expectedByteCount - expectedOffset
    if expectedCount > PrimaryObjectCsgcChunkBytes:
        expectedCount = PrimaryObjectCsgcChunkBytes
    if offset != expectedOffset || byteCount != expectedCount ||
       line !=
           primaryObjectCsgcSectionChunkFactFields(
               section,
               ordinal,
               offset,
               byteCount,
               payloadBase64) ||
       !primaryObjectCsgcBase64DecodeInto(
           payloadBase64, outBytes, offset, byteCount):
        return false
    seen[ordinal] = true
    return true

@borrows
fn primaryObjectCsgcParseSectionChunk(
        line: str,
        manifest: var PrimaryObjectCsgcManifest,
        textSeen: var bool[],
        dataSeen: var bool[],
        debugLineSeen: var bool[],
        debugInfoSeen: var bool[],
        debugAbbrevSeen: var bool[],
        plan: var nativeplan.NativeObjectEmissionPlan): bool =
    let parsed = json.ParseJsonSafe(line)
    if !parsed.success || parsed.value.kind != json.JObject:
        return false
    var section: str
    if !primaryObjectCsgcJsonString(
           parsed.value, "section", section):
        return false
    if section == "text":
        return primaryObjectCsgcParseSectionChunkFor(
            line,
            parsed.value,
            section,
            manifest.textByteCount,
            manifest.textChunkCount,
            textSeen,
            plan.text)
    if section == "data":
        return primaryObjectCsgcParseSectionChunkFor(
            line,
            parsed.value,
            section,
            manifest.dataByteCount,
            manifest.dataChunkCount,
            dataSeen,
            plan.data)
    if section == "debug_line":
        return primaryObjectCsgcParseSectionChunkFor(
            line,
            parsed.value,
            section,
            manifest.debugLineByteCount,
            manifest.debugLineChunkCount,
            debugLineSeen,
            plan.debug.debugLine)
    if section == "debug_info":
        return primaryObjectCsgcParseSectionChunkFor(
            line,
            parsed.value,
            section,
            manifest.debugInfoByteCount,
            manifest.debugInfoChunkCount,
            debugInfoSeen,
            plan.debug.debugInfo)
    if section == "debug_abbrev":
        return primaryObjectCsgcParseSectionChunkFor(
            line,
            parsed.value,
            section,
            manifest.debugAbbrevByteCount,
            manifest.debugAbbrevChunkCount,
            debugAbbrevSeen,
            plan.debug.debugAbbrev)
    return false

@borrows
fn primaryObjectCsgcValidateSectionChunkFor(
        line: str,
        node: json.JsonNode,
        expectedSection: str,
        expectedByteCount: int32,
        expectedChunkCount: int32,
        seen: var bool[]): bool =
    var section: str
    var payloadBase64: str
    var byteCount: int32
    var offset: int32
    var ordinal: int32
    if !primaryObjectCsgcJsonString(
           node, "section", section) ||
       section != expectedSection ||
       !primaryObjectCsgcJsonString(
           node, "payloadBase64", payloadBase64) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line, "byteCount", byteCount) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line, "offset", offset) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line, "ordinal", ordinal) ||
       ordinal >= expectedChunkCount || seen[ordinal]:
        return false
    let expectedOffset = ordinal * PrimaryObjectCsgcChunkBytes
    var expectedCount = expectedByteCount - expectedOffset
    if expectedCount > PrimaryObjectCsgcChunkBytes:
        expectedCount = PrimaryObjectCsgcChunkBytes
    if offset != expectedOffset || byteCount != expectedCount ||
       line !=
           primaryObjectCsgcSectionChunkFactFields(
               section,
               ordinal,
               offset,
               byteCount,
               payloadBase64) ||
       !primaryObjectCsgcBase64ValidForByteCount(
           payloadBase64, byteCount):
        return false
    seen[ordinal] = true
    return true

@borrows
fn primaryObjectCsgcValidateSectionChunk(
        line: str,
        manifest: var PrimaryObjectCsgcManifest,
        textSeen: var bool[],
        dataSeen: var bool[],
        debugLineSeen: var bool[],
        debugInfoSeen: var bool[],
        debugAbbrevSeen: var bool[]): bool =
    let parsed = json.ParseJsonSafe(line)
    if !parsed.success || parsed.value.kind != json.JObject:
        return false
    var section: str
    if !primaryObjectCsgcJsonString(
           parsed.value, "section", section):
        return false
    if section == "text":
        return primaryObjectCsgcValidateSectionChunkFor(
            line, parsed.value, section,
            manifest.textByteCount,
            manifest.textChunkCount,
            textSeen)
    if section == "data":
        return primaryObjectCsgcValidateSectionChunkFor(
            line, parsed.value, section,
            manifest.dataByteCount,
            manifest.dataChunkCount,
            dataSeen)
    if section == "debug_line":
        return primaryObjectCsgcValidateSectionChunkFor(
            line, parsed.value, section,
            manifest.debugLineByteCount,
            manifest.debugLineChunkCount,
            debugLineSeen)
    if section == "debug_info":
        return primaryObjectCsgcValidateSectionChunkFor(
            line, parsed.value, section,
            manifest.debugInfoByteCount,
            manifest.debugInfoChunkCount,
            debugInfoSeen)
    if section == "debug_abbrev":
        return primaryObjectCsgcValidateSectionChunkFor(
            line, parsed.value, section,
            manifest.debugAbbrevByteCount,
            manifest.debugAbbrevChunkCount,
            debugAbbrevSeen)
    return false

@borrows
fn primaryObjectCsgcParseSymbol(
        line: str,
        expectedCount: int32,
        seen: var bool[],
        symbols: var osym.ObjectSymbolTable): bool =
    let parsed = json.ParseJsonSafe(line)
    if !parsed.success || parsed.value.kind != json.JObject:
        return false
    var symbol: osym.ObjectSymbol
    var ordinal: int32
    if !primaryObjectCsgcJsonBool(
           parsed.value, "global", symbol.global) ||
       !primaryObjectCsgcJsonString(
           parsed.value, "name", symbol.name) ||
       !primaryObjectCsgcJsonCanonicalInt64Text(
           line, "offset", symbol.offset) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line, "ordinal", ordinal) ||
       !primaryObjectCsgcJsonCanonicalInt32Text(
           line,
           "sectionIndex",
           symbol.sectionIndex) ||
       !primaryObjectCsgcJsonCanonicalInt64Text(
           line, "size", symbol.size) ||
       !primaryObjectCsgcJsonBool(
           parsed.value, "undefined", symbol.undefined) ||
       ordinal >= expectedCount || seen[ordinal] ||
       line !=
           primaryObjectCsgcSymbolFactFields(
               symbol, ordinal):
        return false
    symbols.items[ordinal] = symbol
    seen[ordinal] = true
    return true

fn primaryObjectCsgcRelocKindFromCode(
        code: int32,
        out: var orel.ObjectRelocKind): bool =
    if code == 0:
        out = orel.ObjectRelocAbs32
        return true
    if code == 1:
        out = orel.ObjectRelocAbs64
        return true
    if code == 2:
        out = orel.ObjectRelocBranch26
        return true
    if code == 3:
        out = orel.ObjectRelocPage21
        return true
    if code == 4:
        out = orel.ObjectRelocPageOff12
        return true
    if code == 5:
        out = orel.ObjectRelocPcRel32
        return true
    if code == 6:
        out = orel.ObjectRelocJump26
        return true
    if code == 7:
        out = orel.ObjectRelocRiscvCall
        return true
    return false

@borrows
fn primaryObjectCsgcDecodeRelocationCanonical(
        line: str,
        outReloc: var orel.ObjectReloc,
        outOrdinal: var int32): bool =
    let parsed = json.ParseJsonSafe(line)
    if !parsed.success || parsed.value.kind != json.JObject:
        return false
    outReloc = orel.ObjectReloc()
    outOrdinal = -1
    var addend: int64
    var offset: int64
    var pcRelative: bool
    var sectionIndex: int32
    var symbolIndex: int32
    var relocationKind: int32
    var kind: orel.ObjectRelocKind
    if !primaryObjectCsgcJsonCanonicalInt64Text(
           line, "addend", addend) ||
       !primaryObjectCsgcJsonCanonicalInt64Text(
           line, "offset", offset) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line, "ordinal", outOrdinal) ||
       !primaryObjectCsgcJsonBool(
           parsed.value, "pcRelative", pcRelative) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line,
           "relocationKind",
           relocationKind) ||
       !primaryObjectCsgcJsonCanonicalInt32Text(
           line,
           "sectionIndex",
           sectionIndex) ||
       !primaryObjectCsgcJsonCanonicalInt32Text(
           line,
           "symbolIndex",
           symbolIndex) ||
       !primaryObjectCsgcRelocKindFromCode(
           relocationKind, kind):
        return false
    let candidate =
        orel.ObjectReloc(
            sectionIndex: sectionIndex,
            offset: offset,
            symbolIndex: symbolIndex,
            kind: kind,
            addend: addend,
            pcRelative: pcRelative)
    if line !=
       primaryObjectCsgcRelocationFactFields(
           candidate, outOrdinal):
        return false
    outReloc = candidate
    return true

@borrows
fn primaryObjectCsgcParseRelocation(
        line: str,
        expectedCount: int32,
        seen: var bool[],
        relocs: var orel.ObjectRelocTable): bool =
    var reloc: orel.ObjectReloc
    var ordinal: int32
    if !primaryObjectCsgcDecodeRelocationCanonical(
           line, reloc, ordinal) ||
       ordinal >= expectedCount || seen[ordinal]:
        return false
    relocs.items[ordinal] = reloc
    seen[ordinal] = true
    return true

@borrows
fn PrimaryObjectCsgcRelocationFactCanonicalInto(
        reloc: orel.ObjectReloc,
        ordinal: int32,
        outLine: var str): bool =
    outLine = ""
    if ordinal < 0 || orel.ObjectRelocKindCode(reloc.kind) < 0:
        return false
    outLine =
        primaryObjectCsgcRelocationFactFields(
            reloc, ordinal)
    return len(outLine) > 0

@borrows
fn PrimaryObjectCsgcRelocationFactParseCanonicalInto(
        line: str,
        expectedOrdinal: int32,
        outReloc: var orel.ObjectReloc): bool =
    outReloc = orel.ObjectReloc()
    if expectedOrdinal < 0:
        return false
    var parsedOrdinal: int32
    if !primaryObjectCsgcDecodeRelocationCanonical(
           line, outReloc, parsedOrdinal) ||
       parsedOrdinal != expectedOrdinal:
        outReloc = orel.ObjectReloc()
        return false
    return true

@borrows
fn primaryObjectCsgcParseDebugRelocation(
        line: str,
        expectedCount: int32,
        seen: var bool[],
        relocs: var debugsections.DirectObjectDebugRelocation[]): bool =
    let parsed = json.ParseJsonSafe(line)
    if !parsed.success || parsed.value.kind != json.JObject:
        return false
    var reloc: debugsections.DirectObjectDebugRelocation
    var ordinal: int32
    if !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line, "ordinal", ordinal) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line,
           "sectionByteOffset",
           reloc.sectionByteOffset) ||
       !primaryObjectCsgcJsonCanonicalInt32Text(
           line, "sectionKind", reloc.sectionKind) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line, "targetAddend", reloc.targetAddend) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line,
           "targetSymbolIndex",
           reloc.targetSymbolIndex) ||
       !primaryObjectCsgcJsonString(
           parsed.value,
           "targetSymbolName",
           reloc.targetSymbolName) ||
       !primaryObjectCsgcJsonCanonicalNonnegativeInt32Text(
           line,
           "targetTextByteStart",
           reloc.targetTextByteStart) ||
       ordinal >= expectedCount || seen[ordinal] ||
       line !=
           primaryObjectCsgcDebugRelocationFactFields(
               reloc, ordinal):
        return false
    relocs[ordinal] = reloc
    seen[ordinal] = true
    return true

@borrows
fn primaryObjectCsgcAllSeen(values: var bool[]): bool =
    for index in 0..<values.len:
        if !values[index]:
            return false
    return true

@borrows
fn primaryObjectCsgcContentHashesValid(
        manifest: var PrimaryObjectCsgcManifest,
        plan: var nativeplan.NativeObjectEmissionPlan): bool =
    return primaryObjectCsgcSha256(plan.text) ==
            manifest.textSha256 &&
        primaryObjectCsgcSha256(plan.data) ==
            manifest.dataSha256 &&
        primaryObjectCsgcSha256(plan.debug.debugLine) ==
            manifest.debugLineSha256 &&
        primaryObjectCsgcSha256(plan.debug.debugInfo) ==
            manifest.debugInfoSha256 &&
        primaryObjectCsgcSha256(plan.debug.debugAbbrev) ==
            manifest.debugAbbrevSha256

@borrows
fn PrimaryObjectCsgcCargoReplay(
        bytes: rawbytes.Bytes,
        proofBytes: rawbytes.Bytes,
        expectedFactsRoot: str,
        expectedTargetTriple: str,
        expectedObjectFormat: str): PrimaryObjectCsgcReplay =
    if !primaryObjectCsgcLowerHexDigest(expectedFactsRoot):
        return primaryObjectCsgcReplayFail(
            "primary object CSGC replay: expected root invalid")
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return primaryObjectCsgcReplayFail(
            strings.ConcatStr(
                "primary object CSGC replay: ", decoded.error))
    let admission =
        validator.CsgCoreProductionAdmitFactLines(
            decoded.lines)
    if !admission.valid || !admission.complete ||
       !validator.CsgCoreProfilesEqual(
           admission.profiles,
           ["csg_core", "csg_dialect::native"]) ||
       admission.profileSetCid !=
           validator.CsgCoreProfileSetCid(
               admission.profiles) ||
       admission.factCount != decoded.factCount ||
       decoded.factCount != decoded.lines.len:
        return primaryObjectCsgcReplayFail(
            "primary object CSGC replay: admission failed")
    if admission.factsRoot != expectedFactsRoot:
        return primaryObjectCsgcReplayFail(
            "primary object CSGC replay: root mismatch")
    let proofCargo =
        merkle_cargo.CsgCoreMerkleProofDecodeCsgc(
            proofBytes, expectedFactsRoot)
    if !proofCargo.ok ||
       proofCargo.proof.queryKey !=
           "id:native-object-emission-plan" ||
       proofCargo.proof.factCount != decoded.factCount:
        return primaryObjectCsgcReplayFail(
            "primary object CSGC replay: manifest proof invalid")
    var manifest: PrimaryObjectCsgcManifest
    var manifestFact: str
    var manifestCount: int32
    var schemaCount: int32
    for lineIndex in 0..<decoded.lines.len:
        let line = decoded.lines[lineIndex]
        var kind: str
        if !primaryObjectCsgcFactKind(line, kind):
            return primaryObjectCsgcReplayFail(
                "primary object CSGC replay: fact kind invalid")
        if kind == "csg.core.schema":
            schemaCount = schemaCount + 1
            if line != PrimaryObjectCsgcSchemaFact:
                return primaryObjectCsgcReplayFail(
                    "primary object CSGC replay: schema drift")
        elif kind == PrimaryObjectCsgcManifestKind:
            manifestCount = manifestCount + 1
            if manifestCount != 1 ||
               !primaryObjectCsgcParseManifest(line, manifest):
                return primaryObjectCsgcReplayFail(
                    "primary object CSGC replay: manifest invalid")
            manifestFact = strings.CloneStr(line)
        elif kind != PrimaryObjectCsgcSectionChunkKind &&
             kind != PrimaryObjectCsgcSymbolKind &&
             kind != PrimaryObjectCsgcRelocationKind &&
             kind != PrimaryObjectCsgcDebugRelocationKind:
            return primaryObjectCsgcReplayFail(
                "primary object CSGC replay: unexpected fact")
    if schemaCount != 1 || manifestCount != 1 ||
       manifest.targetTriple != expectedTargetTriple ||
       manifest.objectFormat != expectedObjectFormat:
        return primaryObjectCsgcReplayFail(
            "primary object CSGC replay: manifest mismatch")
    let manifestVerified =
        merkle_dag.CsgCoreMerkleVerifyFact(
            proofCargo.proof,
            expectedFactsRoot,
            manifestFact)
    if !manifestVerified.ok || !manifestVerified.exists ||
       manifestVerified.factCount != decoded.factCount ||
       manifestVerified.subgraphCid !=
           proofCargo.proof.subgraphCid:
        return primaryObjectCsgcReplayFail(
            "primary object CSGC replay: manifest proof invalid")
    if manifest.textChunkCount > decoded.factCount ||
       manifest.dataChunkCount > decoded.factCount ||
       manifest.debugLineChunkCount > decoded.factCount ||
       manifest.debugInfoChunkCount > decoded.factCount ||
       manifest.debugAbbrevChunkCount > decoded.factCount ||
       manifest.symbolCount > decoded.factCount ||
       manifest.relocationCount > decoded.factCount ||
       manifest.debugRelocationCount > decoded.factCount:
        return primaryObjectCsgcReplayFail(
            "primary object CSGC replay: manifest count out of range")
    let expectedFactCount =
        int64(2) + int64(manifest.textChunkCount) +
        int64(manifest.dataChunkCount) +
        int64(manifest.debugLineChunkCount) +
        int64(manifest.debugInfoChunkCount) +
        int64(manifest.debugAbbrevChunkCount) +
        int64(manifest.symbolCount) +
        int64(manifest.relocationCount) +
        int64(manifest.debugRelocationCount)
    if int64(decoded.factCount) != expectedFactCount:
        return primaryObjectCsgcReplayFail(
            "primary object CSGC replay: fact count mismatch")
    var textEnvelopeSeen: bool[]
    var dataEnvelopeSeen: bool[]
    var debugLineEnvelopeSeen: bool[]
    var debugInfoEnvelopeSeen: bool[]
    var debugAbbrevEnvelopeSeen: bool[]
    setLen(textEnvelopeSeen, manifest.textChunkCount)
    setLen(dataEnvelopeSeen, manifest.dataChunkCount)
    setLen(
        debugLineEnvelopeSeen,
        manifest.debugLineChunkCount)
    setLen(
        debugInfoEnvelopeSeen,
        manifest.debugInfoChunkCount)
    setLen(
        debugAbbrevEnvelopeSeen,
        manifest.debugAbbrevChunkCount)
    for lineIndex in 0..<decoded.lines.len:
        let line = decoded.lines[lineIndex]
        var kind: str
        if !primaryObjectCsgcFactKind(line, kind):
            return primaryObjectCsgcReplayFail(
                "primary object CSGC replay: fact parse failed")
        if kind == PrimaryObjectCsgcSectionChunkKind &&
           !primaryObjectCsgcValidateSectionChunk(
               line,
               manifest,
               textEnvelopeSeen,
               dataEnvelopeSeen,
               debugLineEnvelopeSeen,
               debugInfoEnvelopeSeen,
               debugAbbrevEnvelopeSeen):
            return primaryObjectCsgcReplayFail(
                "primary object CSGC replay: section envelope invalid")
    if !primaryObjectCsgcAllSeen(textEnvelopeSeen) ||
       !primaryObjectCsgcAllSeen(dataEnvelopeSeen) ||
       !primaryObjectCsgcAllSeen(debugLineEnvelopeSeen) ||
       !primaryObjectCsgcAllSeen(debugInfoEnvelopeSeen) ||
       !primaryObjectCsgcAllSeen(debugAbbrevEnvelopeSeen):
        return primaryObjectCsgcReplayFail(
            "primary object CSGC replay: section envelope incomplete")
    var frozen: nativeplan.NativeObjectEmissionPlan
    defer:
        nativeplan.NativeObjectEmissionPlanRelease(frozen)
    frozen.targetTriple = strings.CloneStr(manifest.targetTriple)
    frozen.objectFormat = strings.CloneStr(manifest.objectFormat)
    frozen.actualBackendKind =
        strings.CloneStr(manifest.actualBackendKind)
    frozen.entrySymbol = strings.CloneStr(manifest.entrySymbol)
    frozen.entryFunctionSymbol =
        strings.CloneStr(manifest.entryFunctionSymbol)
    frozen.debug.valid = manifest.debugValid
    if manifest.debugValid:
        if !primaryObjectCsgcDecodeCid(
               manifest.debugSourceReceiptCid,
               frozen.debug.sourceReceiptCid):
            return primaryObjectCsgcReplayFail(
                "primary object CSGC replay: debug CID invalid")
    if !primaryObjectCsgcAllocBytes(
           manifest.textByteCount, frozen.text) ||
       !primaryObjectCsgcAllocBytes(
           manifest.dataByteCount, frozen.data) ||
       !primaryObjectCsgcAllocBytes(
           manifest.debugLineByteCount,
           frozen.debug.debugLine) ||
       !primaryObjectCsgcAllocBytes(
           manifest.debugInfoByteCount,
           frozen.debug.debugInfo) ||
       !primaryObjectCsgcAllocBytes(
           manifest.debugAbbrevByteCount,
           frozen.debug.debugAbbrev):
        return primaryObjectCsgcReplayFail(
            "primary object CSGC replay: allocation failed")
    setLen(frozen.symbols.items, manifest.symbolCount)
    setLen(frozen.relocs.items, manifest.relocationCount)
    setLen(
        frozen.debug.relocations,
        manifest.debugRelocationCount)
    var textSeen: bool[]
    var dataSeen: bool[]
    var debugLineSeen: bool[]
    var debugInfoSeen: bool[]
    var debugAbbrevSeen: bool[]
    var symbolSeen: bool[]
    var relocationSeen: bool[]
    var debugRelocationSeen: bool[]
    setLen(textSeen, manifest.textChunkCount)
    setLen(dataSeen, manifest.dataChunkCount)
    setLen(debugLineSeen, manifest.debugLineChunkCount)
    setLen(debugInfoSeen, manifest.debugInfoChunkCount)
    setLen(debugAbbrevSeen, manifest.debugAbbrevChunkCount)
    setLen(symbolSeen, manifest.symbolCount)
    setLen(relocationSeen, manifest.relocationCount)
    setLen(
        debugRelocationSeen,
        manifest.debugRelocationCount)
    for lineIndex in 0..<decoded.lines.len:
        let line = decoded.lines[lineIndex]
        var kind: str
        if !primaryObjectCsgcFactKind(line, kind):
            return primaryObjectCsgcReplayFail(
                "primary object CSGC replay: fact parse failed")
        if kind == PrimaryObjectCsgcSectionChunkKind:
            if !primaryObjectCsgcParseSectionChunk(
                   line,
                   manifest,
                   textSeen,
                   dataSeen,
                   debugLineSeen,
                   debugInfoSeen,
                   debugAbbrevSeen,
                   frozen):
                return primaryObjectCsgcReplayFail(
                    "primary object CSGC replay: section invalid")
        elif kind == PrimaryObjectCsgcSymbolKind:
            if !primaryObjectCsgcParseSymbol(
                   line,
                   manifest.symbolCount,
                   symbolSeen,
                   frozen.symbols):
                return primaryObjectCsgcReplayFail(
                    "primary object CSGC replay: symbol invalid")
        elif kind == PrimaryObjectCsgcRelocationKind:
            if !primaryObjectCsgcParseRelocation(
                   line,
                   manifest.relocationCount,
                   relocationSeen,
                   frozen.relocs):
                return primaryObjectCsgcReplayFail(
                    "primary object CSGC replay: relocation invalid")
        elif kind == PrimaryObjectCsgcDebugRelocationKind:
            if !primaryObjectCsgcParseDebugRelocation(
                   line,
                   manifest.debugRelocationCount,
                   debugRelocationSeen,
                   frozen.debug.relocations):
                return primaryObjectCsgcReplayFail(
                    "primary object CSGC replay: debug relocation invalid")
    if !primaryObjectCsgcAllSeen(textSeen) ||
       !primaryObjectCsgcAllSeen(dataSeen) ||
       !primaryObjectCsgcAllSeen(debugLineSeen) ||
       !primaryObjectCsgcAllSeen(debugInfoSeen) ||
       !primaryObjectCsgcAllSeen(debugAbbrevSeen) ||
       !primaryObjectCsgcAllSeen(symbolSeen) ||
       !primaryObjectCsgcAllSeen(relocationSeen) ||
       !primaryObjectCsgcAllSeen(debugRelocationSeen) ||
       !primaryObjectCsgcContentHashesValid(
           manifest, frozen):
        return primaryObjectCsgcReplayFail(
            "primary object CSGC replay: content closure invalid")
    var planErr: str
    if !nativeplan.NativeObjectEmissionPlanValidateInto(
           frozen, planErr):
        return primaryObjectCsgcReplayFail(
            strings.ConcatStr(
                "primary object CSGC replay: ", planErr))
    var emission: nativeplan.NativeObjectEmissionReceipt
    if !nativeplan.NativeObjectEmissionPlanEmitInto(
           frozen, emission):
        return primaryObjectCsgcReplayFail(
            strings.ConcatStr(
                "primary object CSGC replay: ", emission.error))
    var out: PrimaryObjectCsgcReplay
    out.ok = true
    out.objectBytes = emission.objectBytes
    emission.objectBytes = rawbytes.Bytes()
    out.factsRoot = strings.CloneStr(admission.factsRoot)
    out.subgraphCid =
        strings.CloneStr(manifestVerified.subgraphCid)
    out.planRoot = strings.CloneStr(admission.factsRoot)
    out.targetTriple = strings.CloneStr(manifest.targetTriple)
    out.objectFormat = strings.CloneStr(manifest.objectFormat)
    out.actualBackendKind =
        strings.CloneStr(manifest.actualBackendKind)
    out.entrySymbol = strings.CloneStr(manifest.entrySymbol)
    out.entryFunctionSymbol =
        strings.CloneStr(manifest.entryFunctionSymbol)
    out.objectSha256 = strings.CloneStr(emission.objectSha256)
    out.objectByteCount = emission.objectByteCount
    out.symbolCount = manifest.symbolCount
    out.relocationCount = emission.relocCount
    out.factCount = decoded.factCount
    nativeplan.NativeObjectEmissionReceiptRelease(emission)
    return out

fn PrimaryObjectCsgcCargoRelease(
        cargo: var PrimaryObjectCsgcCargo) =
    rawbytes.BytesFree(cargo.bytes)
    rawbytes.BytesFree(cargo.proofBytes)
    cargo = PrimaryObjectCsgcCargo()

fn PrimaryObjectCsgcReplayRelease(
        replay: var PrimaryObjectCsgcReplay) =
    rawbytes.BytesFree(replay.objectBytes)
    replay = PrimaryObjectCsgcReplay()
