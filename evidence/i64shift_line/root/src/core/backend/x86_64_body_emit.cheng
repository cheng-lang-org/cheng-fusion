import cheng/core/ir/core_types as coreir
import cheng/core/lang/typed_expr as texpr
import std/os
import std/strformat
import std/strings

# x86_64 BodyIR machine-code emitter (Linux SysV).
# Mirror of the aarch64 PrimaryBodyIRFill* family in primary_object_plan.cheng:
# stack machine over rsp-relative slots, analytic size model in 4-byte words.
# Every op/term is NOP-padded to a word boundary; call/lea rel32 fields are
# placed on their own word so the existing word-based reloc pipeline applies
# (object reloc byte offset = word * 4, rel32 store with addend -4).
# Frame: push rbp; mov rbp,rsp; sub rsp,frameBytes (16-aligned, rsp stays
# 16-aligned at calls). sret pointer = rdi (SysV), integer args shift by one.

const X64BodyRAX = 0
const X64BodyRCX = 1
const X64BodyRDX = 2
const X64BodyRSP = 4
const X64BodyRBP = 5
const X64BodyRSI = 6
const X64BodyRDI = 7
const X64BodyR8 = 8
const X64BodyR9 = 9
const X64BodyR10 = 10
const X64BodyR11 = 11
const X64BodyXMM0 = 0
const X64BodyXMM1 = 1

const X64BodyCcE = 4
const X64BodyCcNe = 5
const X64BodyCcL = 12
const X64BodyCcGe = 13
const X64BodyCcLe = 14
const X64BodyCcG = 15
# Unsigned ordering condition codes (setcc/jcc low nibble): b/ae/be/a.
const X64BodyCcB = 2
const X64BodyCcAe = 3
const X64BodyCcBe = 6
const X64BodyCcA = 7
const X64BodyCcP = 10
const X64BodyCcNp = 11

# One scalar slot memory access (a single load or store) is a uniform disp32-SIB
# encoding = 8 bytes (see x64bMemOp). Used to decompose the scalar op byte
# accounts into lhsLoad/rhsLoad/resultStore components (S0) and to size the
# lhs-reload elision (S1).
const X64BodySlotAccessBytes = 8

# segment-a: a 32-bit scalar slot access (mov r32,[rsp+disp] / mov [rsp+disp],r32)
# omits the empty REX prefix => 7 bytes; a 64-bit access keeps REX.W and byte/lea/
# pointer/str/aggregate accesses stay at 8. Mirrors x64bMemOp's REX decision for the
# (reg<8, base=rsp) scalar-slot case so the size model stays 1:1 with the filler.
@borrows
fn X64BodySlotAccessBytesForType(slotType: int32): int32 =
    if slotType == coreir.LocalI32Tag:
        return 7
    return X64BodySlotAccessBytes
@borrows
fn X64BodySlotAccessBytesForSlot(bodyIR: coreir.BodyIR, slotIndex: int32): int32 =
    return X64BodySlotAccessBytesForType(x64BodySlotType(bodyIR, slotIndex))

# segment-d1: disp8-aware slot access byte count. Mirrors x64bMemOpX's byte length for a
# scalar rsp-relative slot access (base=rsp, reg<8, spBias=0 so disp == the frame stackOffset).
# I32 (no REX): 4B disp8 / 7B disp32; 64-bit form (REX.W, used by I64/Ptr/F64 and the
# str/aggregate load64/lea): 5B disp8 / 8B disp32. Read ONLY by the size predictor for
# ops whose filler routes the access through the disp8-capable chokepoint
# (x64BodyLoadSlotToRegD8 / x64BodyStoreRegToSlotD8); ops on the disp32 path keep
# X64BodySlotAccessBytesForSlot.
@borrows
fn X64BodySlotAccessBytesForTypeDisp(slotType: int32, disp: int32): int32 =
    let short = x64bDispIsShort(disp)
    if slotType == coreir.LocalI32Tag:
        if short:
            return 4
        return 7
    if short:
        return 5
    return 8
@borrows
fn X64BodySlotAccessBytesForSlotDisp(bodyIR: coreir.BodyIR, slotIndex: int32): int32 =
    let disp = X64BodyLocalStackOffset(bodyIR, slotIndex, X64BodyParamSaveOffset(bodyIR))
    return X64BodySlotAccessBytesForTypeDisp(x64BodySlotType(bodyIR, slotIndex), disp)

fn X64BodyArgReg(index: int32): int32 =
    if index == 0:
        return X64BodyRDI
    if index == 1:
        return X64BodyRSI
    if index == 2:
        return X64BodyRDX
    if index == 3:
        return X64BodyRCX
    if index == 4:
        return X64BodyR8
    if index == 5:
        return X64BodyR9
    return -1

# ---------- byte writer over the int32 word array ----------

fn x64bPut8(words: var int32[], pos: int32, value: int32): int32 =
    if pos < 0:
        return -1
    let wi = pos / 4
    if wi >= words.len:
        return -1
    let shift = uint32((pos % 4) * 8)
    let cur = uint32(words[wi])
    words[wi] = int32(cur | (uint32(value & 255) << shift))
    return pos + 1

fn x64bPutU32(words: var int32[], posRaw: int32, value: int32): int32 =
    var pos = posRaw
    pos = x64bPut8(words, pos, value & 255)
    pos = x64bPut8(words, pos, (value >> 8) & 255)
    pos = x64bPut8(words, pos, (value >> 16) & 255)
    pos = x64bPut8(words, pos, (value >> 24) & 255)
    return pos

# One canonical multi-byte NOP of exact length n (1..9), Intel SDM recommended
# forms. Same byte count as an n-long 0x90 run but a single decoded instruction,
# so pad byte accounting (and the analytic size model) is unchanged.
fn x64bNopN(words: var int32[], posRaw: int32, n: int32): int32 =
    var pos = posRaw
    if n == 1:
        return x64bPut8(words, pos, 0x90)
    if n == 2:
        pos = x64bPut8(words, pos, 0x66)
        return x64bPut8(words, pos, 0x90)
    if n == 3:
        pos = x64bPut8(words, pos, 0x0F)
        pos = x64bPut8(words, pos, 0x1F)
        return x64bPut8(words, pos, 0x00)
    if n == 4:
        pos = x64bPut8(words, pos, 0x0F)
        pos = x64bPut8(words, pos, 0x1F)
        pos = x64bPut8(words, pos, 0x40)
        return x64bPut8(words, pos, 0x00)
    if n == 5:
        pos = x64bPut8(words, pos, 0x0F)
        pos = x64bPut8(words, pos, 0x1F)
        pos = x64bPut8(words, pos, 0x44)
        pos = x64bPut8(words, pos, 0x00)
        return x64bPut8(words, pos, 0x00)
    if n == 6:
        pos = x64bPut8(words, pos, 0x66)
        pos = x64bPut8(words, pos, 0x0F)
        pos = x64bPut8(words, pos, 0x1F)
        pos = x64bPut8(words, pos, 0x44)
        pos = x64bPut8(words, pos, 0x00)
        return x64bPut8(words, pos, 0x00)
    if n == 7:
        pos = x64bPut8(words, pos, 0x0F)
        pos = x64bPut8(words, pos, 0x1F)
        pos = x64bPut8(words, pos, 0x80)
        pos = x64bPut8(words, pos, 0x00)
        pos = x64bPut8(words, pos, 0x00)
        pos = x64bPut8(words, pos, 0x00)
        return x64bPut8(words, pos, 0x00)
    if n == 8:
        pos = x64bPut8(words, pos, 0x0F)
        pos = x64bPut8(words, pos, 0x1F)
        pos = x64bPut8(words, pos, 0x84)
        pos = x64bPut8(words, pos, 0x00)
        pos = x64bPut8(words, pos, 0x00)
        pos = x64bPut8(words, pos, 0x00)
        pos = x64bPut8(words, pos, 0x00)
        return x64bPut8(words, pos, 0x00)
    if n == 9:
        pos = x64bPut8(words, pos, 0x66)
        pos = x64bPut8(words, pos, 0x0F)
        pos = x64bPut8(words, pos, 0x1F)
        pos = x64bPut8(words, pos, 0x84)
        pos = x64bPut8(words, pos, 0x00)
        pos = x64bPut8(words, pos, 0x00)
        pos = x64bPut8(words, pos, 0x00)
        pos = x64bPut8(words, pos, 0x00)
        return x64bPut8(words, pos, 0x00)
    return -1

fn x64bPadTo(words: var int32[], posRaw: int32, target: int32): int32 =
    if posRaw < 0 || posRaw > target:
        return -1
    var pos = posRaw
    while pos < target:
        var chunk = target - pos
        if chunk > 9:
            chunk = 9
        pos = x64bNopN(words, pos, chunk)
        if pos < 0:
            return -1
    return pos

# ---------- instruction emitters (forced REX for uniform sizes) ----------

fn x64bRex(words: var int32[], pos: int32, w: bool, rBit: bool, bBit: bool): int32 =
    var v = 0x40
    if w:
        v = v | 8
    if rBit:
        v = v | 4
    if bBit:
        v = v | 1
    return x64bPut8(words, pos, v)

fn x64bModRM(mod: int32, reg: int32, rm: int32): int32 =
    return ((mod & 3) << 6) | ((reg & 7) << 3) | (rm & 7)

const X64BodyF64ReturnBridgeBytes = 5

# movq xmm, r64: 66 REX.W 0F 6E /r = 5 bytes for the scratch registers used here.
@borrows
fn x64bMovqXmmFromReg(words: var int32[], posRaw: int32,
                      xmmReg: int32, gprReg: int32): int32 =
    var pos = x64bPut8(words, posRaw, 0x66)
    pos = x64bRex(words, pos, true, xmmReg >= 8, gprReg >= 8)
    pos = x64bPut8(words, pos, 0x0F)
    pos = x64bPut8(words, pos, 0x6E)
    return x64bPut8(words, pos, x64bModRM(3, xmmReg, gprReg))

# movq xmm0, rax / movq rax, xmm0.  Every callee returns f64 through the
# platform XMM0 bank; Cheng-internal callers bridge the raw bits back to RAX
# before homing them in the stack-class BodyIR slot.
fn x64bMovqXmm0FromRax(words: var int32[], posRaw: int32): int32 =
    return x64bMovqXmmFromReg(words, posRaw, X64BodyXMM0, X64BodyRAX)

fn x64bMovqRaxFromXmm0(words: var int32[], posRaw: int32): int32 =
    var pos = x64bPut8(words, posRaw, 0x66)
    pos = x64bPut8(words, pos, 0x48)
    pos = x64bPut8(words, pos, 0x0F)
    pos = x64bPut8(words, pos, 0x7E)
    return x64bPut8(words, pos, 0xC0)

# canonical memory operand: [base + disp32] via SIB, any base register.
# segment-a: REX is emitted only when required — 64-bit width, or a reg/base in
# r8..r15. A 32-bit or byte access to rax..rdx via rsp needs NO REX (7 bytes);
# a 64-bit access keeps REX.W (8 bytes). Callers with reg>=8 / base>=8 still get
# their REX. Byte size derived by x64bMemOpBytes so the size model stays 1:1.
fn x64bMemOpNeedsRex(w: bool, reg: int32, base: int32): bool =
    return w || reg >= 8 || base >= 8
fn x64bMemOp(words: var int32[], posRaw: int32, opcode: int32, w: bool, reg: int32, base: int32, disp: int32): int32 =
    var pos = posRaw
    if x64bMemOpNeedsRex(w, reg, base):
        pos = x64bRex(words, pos, w, reg >= 8, base >= 8)
    pos = x64bPut8(words, pos, opcode)
    pos = x64bPut8(words, pos, x64bModRM(2, reg, 4))
    pos = x64bPut8(words, pos, 0x20 | (base & 7))
    return x64bPutU32(words, pos, disp)

# segment-d1: a stack/base displacement that fits a signed byte uses the mod=01 disp8
# SIB encoding (disp field 4B -> 1B). Slot displacements are non-negative frame offsets;
# the general signed test keeps the encoding correct for any future negative disp (the
# byte is the two's-complement low byte, sign-extended by the CPU). rsp base still needs
# the SIB byte, so disp8 saves exactly 3 bytes over disp32.
fn x64bDispIsShort(disp: int32): bool =
    return disp >= -128 && disp <= 127
# disp8-capable canonical memory operand. When allowD8 and the disp fits a signed byte,
# emit mod=01 + 1-byte disp; otherwise the mod=10 + disp32 form (byte-identical to
# x64bMemOp). REX decision is unchanged (x64bMemOpNeedsRex), so the width/reg/base state
# space is identical to segment-a — only the disp field width can shrink.
fn x64bMemOpX(words: var int32[], posRaw: int32, opcode: int32, w: bool, reg: int32, base: int32, disp: int32, allowD8: bool): int32 =
    var pos = posRaw
    if x64bMemOpNeedsRex(w, reg, base):
        pos = x64bRex(words, pos, w, reg >= 8, base >= 8)
    pos = x64bPut8(words, pos, opcode)
    if allowD8 && x64bDispIsShort(disp):
        pos = x64bPut8(words, pos, x64bModRM(1, reg, 4))
        pos = x64bPut8(words, pos, 0x20 | (base & 7))
        return x64bPut8(words, pos, disp & 255)
    pos = x64bPut8(words, pos, x64bModRM(2, reg, 4))
    pos = x64bPut8(words, pos, 0x20 | (base & 7))
    return x64bPutU32(words, pos, disp)
# Byte count of x64bMemOpX(..., allowD8): opcode + modrm + sib (3) + optional REX (1) +
# disp field (1 when allowD8 && short, else 4). The scalar-slot size predictor mirrors
# this as X64BodySlotAccessBytesForTypeDisp (base=rsp, reg<8) so sizing stays 1:1 with
# the disp8-capable filler.
fn x64bLoad32Auto(words: var int32[], pos: int32, reg: int32, base: int32, disp: int32): int32 =
    return x64bMemOpX(words, pos, 0x8B, false, reg, base, disp, true)
fn x64bLoad64Auto(words: var int32[], pos: int32, reg: int32, base: int32, disp: int32): int32 =
    return x64bMemOpX(words, pos, 0x8B, true, reg, base, disp, true)
fn x64bStore32Auto(words: var int32[], pos: int32, reg: int32, base: int32, disp: int32): int32 =
    return x64bMemOpX(words, pos, 0x89, false, reg, base, disp, true)
fn x64bStore64Auto(words: var int32[], pos: int32, reg: int32, base: int32, disp: int32): int32 =
    return x64bMemOpX(words, pos, 0x89, true, reg, base, disp, true)
# lea reg, [rsp+disp]: 8B (disp32) or 5B (disp8).
fn x64bLeaStackAuto(words: var int32[], pos: int32, reg: int32, disp: int32): int32 =
    return x64bMemOpX(words, pos, 0x8D, true, reg, X64BodyRSP, disp, true)

# segment-a: forced-REX memory operand (always 8 bytes). Used by ops with hardcoded
# internal byte offsets (StrEq/StrEqLiteral) that must keep the uniform 8-byte access.
fn x64bMemOpRex(words: var int32[], posRaw: int32, opcode: int32, w: bool, reg: int32, base: int32, disp: int32): int32 =
    var pos = x64bRex(words, posRaw, w, reg >= 8, base >= 8)
    pos = x64bPut8(words, pos, opcode)
    pos = x64bPut8(words, pos, x64bModRM(2, reg, 4))
    pos = x64bPut8(words, pos, 0x20 | (base & 7))
    return x64bPutU32(words, pos, disp)

fn x64bLoad32Rex(words: var int32[], pos: int32, reg: int32, base: int32, disp: int32): int32 =
    return x64bMemOpRex(words, pos, 0x8B, false, reg, base, disp)

fn x64bStore32Rex(words: var int32[], pos: int32, reg: int32, base: int32, disp: int32): int32 =
    return x64bMemOpRex(words, pos, 0x89, false, reg, base, disp)

fn x64bLoad32(words: var int32[], pos: int32, reg: int32, base: int32, disp: int32): int32 =
    return x64bMemOp(words, pos, 0x8B, false, reg, base, disp)

fn x64bLoad64(words: var int32[], pos: int32, reg: int32, base: int32, disp: int32): int32 =
    return x64bMemOp(words, pos, 0x8B, true, reg, base, disp)

fn x64bStore32(words: var int32[], pos: int32, reg: int32, base: int32, disp: int32): int32 =
    return x64bMemOp(words, pos, 0x89, false, reg, base, disp)

fn x64bStore64(words: var int32[], pos: int32, reg: int32, base: int32, disp: int32): int32 =
    return x64bMemOp(words, pos, 0x89, true, reg, base, disp)

# movzx reg32, byte [base+disp]: 9 bytes
fn x64bLoad8(words: var int32[], posRaw: int32, reg: int32, base: int32, disp: int32): int32 =
    var pos = x64bRex(words, posRaw, false, reg >= 8, base >= 8)
    pos = x64bPut8(words, pos, 0x0F)
    pos = x64bPut8(words, pos, 0xB6)
    pos = x64bPut8(words, pos, x64bModRM(2, reg, 4))
    pos = x64bPut8(words, pos, 0x20 | (base & 7))
    return x64bPutU32(words, pos, disp)

# mov byte [base+disp], reg8: 8 bytes
fn x64bStore8(words: var int32[], pos: int32, reg: int32, base: int32, disp: int32): int32 =
    return x64bMemOp(words, pos, 0x88, false, reg, base, disp)

# ---------- SIB indexed element operand: [base + index*(2^scaleLog)], disp=0 (S6) ----------
# One ModRM+SIB, mod=00 (no displacement). Correct only when base is not rbp/r13
# (mod=00 base=101 means "disp32, no base") and index is not rsp (index=100 means
# "no index"). Every S6 caller passes base=rax(0), index=rcx(1) so both hold. REX.X
# carries index>=8. scaleLog in 0..3 -> scale 1/2/4/8.
fn x64bRexX(words: var int32[], pos: int32, w: bool, rBit: bool, xBit: bool, bBit: bool): int32 =
    var v = 0x40
    if w:
        v = v | 8
    if rBit:
        v = v | 4
    if xBit:
        v = v | 2
    if bBit:
        v = v | 1
    return x64bPut8(words, pos, v)
fn x64bSibByte(scaleLog: int32, index: int32, base: int32): int32 =
    return ((scaleLog & 3) << 6) | ((index & 7) << 3) | (base & 7)
fn x64bMemOpSib(words: var int32[], posRaw: int32, opcode: int32, w: bool,
                reg: int32, base: int32, index: int32, scaleLog: int32): int32 =
    var pos = posRaw
    if w || reg >= 8 || base >= 8 || index >= 8:
        pos = x64bRexX(words, pos, w, reg >= 8, index >= 8, base >= 8)
    pos = x64bPut8(words, pos, opcode)
    pos = x64bPut8(words, pos, x64bModRM(0, reg, 4))
    return x64bPut8(words, pos, x64bSibByte(scaleLog, index, base))
# mov r32, [base+index*scale]: 3 bytes (no REX for reg/base/index<8; 4 under REX).
fn x64bLoad32Sib(words: var int32[], pos: int32, reg: int32, base: int32, index: int32, scaleLog: int32): int32 =
    return x64bMemOpSib(words, pos, 0x8B, false, reg, base, index, scaleLog)
# mov r64, [base+index*scale]: 4 bytes (REX.W).
fn x64bLoad64Sib(words: var int32[], pos: int32, reg: int32, base: int32, index: int32, scaleLog: int32): int32 =
    return x64bMemOpSib(words, pos, 0x8B, true, reg, base, index, scaleLog)
# movzx r32, byte [base+index*scale]: 5 bytes (forced REX, mirrors x64bLoad8).
fn x64bLoad8Sib(words: var int32[], posRaw: int32, reg: int32, base: int32, index: int32, scaleLog: int32): int32 =
    var pos = x64bRexX(words, posRaw, false, reg >= 8, index >= 8, base >= 8)
    pos = x64bPut8(words, pos, 0x0F)
    pos = x64bPut8(words, pos, 0xB6)
    pos = x64bPut8(words, pos, x64bModRM(0, reg, 4))
    return x64bPut8(words, pos, x64bSibByte(scaleLog, index, base))
# mov byte [base+index*scale], r8: 3 bytes.
fn x64bStore8Sib(words: var int32[], pos: int32, reg: int32, base: int32, index: int32, scaleLog: int32): int32 =
    return x64bMemOpSib(words, pos, 0x88, false, reg, base, index, scaleLog)
# mov [base+index*scale], r32: 3 bytes.
fn x64bStore32Sib(words: var int32[], pos: int32, reg: int32, base: int32, index: int32, scaleLog: int32): int32 =
    return x64bMemOpSib(words, pos, 0x89, false, reg, base, index, scaleLog)
# mov [base+index*scale], r64: 4 bytes (REX.W).
fn x64bStore64Sib(words: var int32[], pos: int32, reg: int32, base: int32, index: int32, scaleLog: int32): int32 =
    return x64bMemOpSib(words, pos, 0x89, true, reg, base, index, scaleLog)

# lea reg, [rsp+disp32]: 8 bytes
fn x64bLeaStack(words: var int32[], pos: int32, reg: int32, disp: int32): int32 =
    return x64bMemOp(words, pos, 0x8D, true, reg, X64BodyRSP, disp)

# NOP + lea reg, [rip+0]: 8 bytes, requires word-aligned entry (rel32 = word 2)
fn x64bLeaRipGroup(words: var int32[], posRaw: int32, reg: int32): int32 =
    if posRaw < 0:
        return -1
    var pos = x64bPut8(words, posRaw, 0x90)
    pos = x64bRex(words, pos, true, reg >= 8, false)
    pos = x64bPut8(words, pos, 0x8D)
    pos = x64bPut8(words, pos, x64bModRM(0, reg, 5))
    return x64bPutU32(words, pos, 0)

# mov reg, imm32 (sign-extended when w): 7 bytes
fn x64bMovImm32(words: var int32[], posRaw: int32, reg: int32, imm: int32, w: bool): int32 =
    var pos = x64bRex(words, posRaw, w, false, reg >= 8)
    pos = x64bPut8(words, pos, 0xC7)
    pos = x64bPut8(words, pos, x64bModRM(3, 0, reg))
    return x64bPutU32(words, pos, imm)

# movabs reg, imm64 assembled from four 16-bit little-endian chunks: 10 bytes
fn x64bMovImm64Chunks(words: var int32[], posRaw: int32, reg: int32,
                      c0: int32, c1: int32, c2: int32, c3: int32): int32 =
    var pos = x64bRex(words, posRaw, true, false, reg >= 8)
    pos = x64bPut8(words, pos, 0xB8 + (reg & 7))
    pos = x64bPut8(words, pos, c0 & 255)
    pos = x64bPut8(words, pos, (c0 >> 8) & 255)
    pos = x64bPut8(words, pos, c1 & 255)
    pos = x64bPut8(words, pos, (c1 >> 8) & 255)
    pos = x64bPut8(words, pos, c2 & 255)
    pos = x64bPut8(words, pos, (c2 >> 8) & 255)
    pos = x64bPut8(words, pos, c3 & 255)
    return x64bPut8(words, pos, (c3 >> 8) & 255)

# MR-form alu: opcode /r with reg=src rm=dst: 3 bytes
fn x64bAluRR(words: var int32[], posRaw: int32, opcode: int32, dst: int32, src: int32, w: bool): int32 =
    var pos = x64bRex(words, posRaw, w, src >= 8, dst >= 8)
    pos = x64bPut8(words, pos, opcode)
    return x64bPut8(words, pos, x64bModRM(3, src, dst))

fn x64bAddRR(words: var int32[], pos: int32, dst: int32, src: int32, w: bool): int32 =
    return x64bAluRR(words, pos, 0x01, dst, src, w)

fn x64bSubRR(words: var int32[], pos: int32, dst: int32, src: int32, w: bool): int32 =
    return x64bAluRR(words, pos, 0x29, dst, src, w)

fn x64bAndRR(words: var int32[], pos: int32, dst: int32, src: int32, w: bool): int32 =
    return x64bAluRR(words, pos, 0x21, dst, src, w)

fn x64bOrRR(words: var int32[], pos: int32, dst: int32, src: int32, w: bool): int32 =
    return x64bAluRR(words, pos, 0x09, dst, src, w)

fn x64bXorRR(words: var int32[], pos: int32, dst: int32, src: int32, w: bool): int32 =
    return x64bAluRR(words, pos, 0x31, dst, src, w)

fn x64bCmpRR(words: var int32[], pos: int32, lhs: int32, rhs: int32, w: bool): int32 =
    return x64bAluRR(words, pos, 0x39, lhs, rhs, w)

# ucomisd xmmLhs,xmmRhs: 66 0F 2E /r.  IEEE flag tuples are:
# unordered ZF/PF/CF=1/1/1, greater=0/0/0, less=0/0/1, equal=1/0/0.
fn x64bUcomisdRR(words: var int32[], posRaw: int32,
                 lhsXmm: int32, rhsXmm: int32): int32 =
    var pos = x64bPut8(words, posRaw, 0x66)
    if lhsXmm >= 8 || rhsXmm >= 8:
        pos = x64bRex(words, pos, false, lhsXmm >= 8, rhsXmm >= 8)
    pos = x64bPut8(words, pos, 0x0F)
    pos = x64bPut8(words, pos, 0x2E)
    return x64bPut8(words, pos, x64bModRM(3, lhsXmm, rhsXmm))

fn x64bTestRR(words: var int32[], pos: int32, lhs: int32, rhs: int32, w: bool): int32 =
    return x64bAluRR(words, pos, 0x85, lhs, rhs, w)

fn x64bMovRR(words: var int32[], pos: int32, dst: int32, src: int32, w: bool): int32 =
    return x64bAluRR(words, pos, 0x89, dst, src, w)

# imul dst, src: 4 bytes
fn x64bImulRR(words: var int32[], posRaw: int32, dst: int32, src: int32, w: bool): int32 =
    var pos = x64bRex(words, posRaw, w, dst >= 8, src >= 8)
    pos = x64bPut8(words, pos, 0x0F)
    pos = x64bPut8(words, pos, 0xAF)
    return x64bPut8(words, pos, x64bModRM(3, dst, src))

# imul dst, src, imm8: 4 bytes
fn x64bImulRRImm8(words: var int32[], posRaw: int32, dst: int32, src: int32, imm8: int32): int32 =
    var pos = x64bRex(words, posRaw, true, dst >= 8, src >= 8)
    pos = x64bPut8(words, pos, 0x6B)
    pos = x64bPut8(words, pos, x64bModRM(3, dst, src))
    return x64bPut8(words, pos, imm8 & 255)

# imul dst, src, imm32: 7 bytes
fn x64bImulRRImm32(words: var int32[], posRaw: int32, dst: int32, src: int32, imm32: int32): int32 =
    var pos = x64bRex(words, posRaw, true, dst >= 8, src >= 8)
    pos = x64bPut8(words, pos, 0x69)
    pos = x64bPut8(words, pos, x64bModRM(3, dst, src))
    return x64bPutU32(words, pos, imm32)

# shl/sar dst, cl: 3 bytes (subop 4 = shl, 7 = sar)
fn x64bShiftCl(words: var int32[], posRaw: int32, subop: int32, dst: int32, w: bool): int32 =
    var pos = x64bRex(words, posRaw, w, false, dst >= 8)
    pos = x64bPut8(words, pos, 0xD3)
    return x64bPut8(words, pos, x64bModRM(3, subop, dst))

# cdq/cqo: 2 bytes
fn x64bCdq(words: var int32[], posRaw: int32, w: bool): int32 =
    var pos = x64bRex(words, posRaw, w, false, false)
    return x64bPut8(words, pos, 0x99)

# idiv rm: 3 bytes
fn x64bIdiv(words: var int32[], posRaw: int32, rm: int32, w: bool): int32 =
    var pos = x64bRex(words, posRaw, w, false, rm >= 8)
    pos = x64bPut8(words, pos, 0xF7)
    return x64bPut8(words, pos, x64bModRM(3, 7, rm))

# div rm (unsigned): 3 bytes (ModRM subop 6)
fn x64bDiv(words: var int32[], posRaw: int32, rm: int32, w: bool): int32 =
    var pos = x64bRex(words, posRaw, w, false, rm >= 8)
    pos = x64bPut8(words, pos, 0xF7)
    return x64bPut8(words, pos, x64bModRM(3, 6, rm))

# movsxd reg64, dword [base+disp]: 8 bytes
fn x64bMovsxdMem(words: var int32[], pos: int32, reg: int32, base: int32, disp: int32): int32 =
    return x64bMemOp(words, pos, 0x63, true, reg, base, disp)

# setcc reg8: 4 bytes
fn x64bSetcc(words: var int32[], posRaw: int32, cc: int32, reg: int32): int32 =
    var pos = x64bRex(words, posRaw, false, false, reg >= 8)
    pos = x64bPut8(words, pos, 0x0F)
    pos = x64bPut8(words, pos, 0x90 + (cc & 15))
    return x64bPut8(words, pos, x64bModRM(3, 0, reg))

# Byte AND or OR on dst8 and src8: forced REX plus opcode plus ModRM is 3 bytes.
# Combining AL and CL
# before MOVZX avoids stale upper-register bits in the parity-aware F64 predicates.
fn x64bByteAluRR(words: var int32[], posRaw: int32, opcode: int32,
                 dst: int32, src: int32): int32 =
    var pos = x64bRex(words, posRaw, false, src >= 8, dst >= 8)
    pos = x64bPut8(words, pos, opcode)
    return x64bPut8(words, pos, x64bModRM(3, src, dst))

fn x64bAnd8RR(words: var int32[], pos: int32, dst: int32, src: int32): int32 =
    return x64bByteAluRR(words, pos, 0x20, dst, src)

fn x64bOr8RR(words: var int32[], pos: int32, dst: int32, src: int32): int32 =
    return x64bByteAluRR(words, pos, 0x08, dst, src)

# movzx reg32, reg8: 4 bytes
fn x64bMovzx8RR(words: var int32[], posRaw: int32, dst: int32, src: int32): int32 =
    var pos = x64bRex(words, posRaw, false, dst >= 8, src >= 8)
    pos = x64bPut8(words, pos, 0x0F)
    pos = x64bPut8(words, pos, 0xB6)
    return x64bPut8(words, pos, x64bModRM(3, dst, src))

# cmp reg, imm32: 7 bytes
fn x64bCmpImm32(words: var int32[], posRaw: int32, reg: int32, imm: int32, w: bool): int32 =
    var pos = x64bRex(words, posRaw, w, false, reg >= 8)
    pos = x64bPut8(words, pos, 0x81)
    pos = x64bPut8(words, pos, x64bModRM(3, 7, reg))
    return x64bPutU32(words, pos, imm)

# sub/add rsp, imm32: 7 bytes (subop 5 = sub, 0 = add)
fn x64bRspImm32(words: var int32[], posRaw: int32, subop: int32, imm: int32): int32 =
    var pos = x64bRex(words, posRaw, true, false, false)
    pos = x64bPut8(words, pos, 0x81)
    pos = x64bPut8(words, pos, x64bModRM(3, subop, X64BodyRSP))
    return x64bPutU32(words, pos, imm)

# jcc rel32: 6 bytes
fn x64bJccRel32(words: var int32[], posRaw: int32, cc: int32, rel: int32): int32 =
    var pos = x64bPut8(words, posRaw, 0x0F)
    pos = x64bPut8(words, pos, 0x80 + (cc & 15))
    return x64bPutU32(words, pos, rel)

# jmp rel32: 5 bytes
fn x64bJmpRel32(words: var int32[], posRaw: int32, rel: int32): int32 =
    var pos = x64bPut8(words, posRaw, 0xE9)
    return x64bPutU32(words, pos, rel)

# xor eax,eax; call rel32(0): 8 bytes, requires word-aligned entry (rel32 = word 2)
fn x64bCallGroup(words: var int32[], posRaw: int32): int32 =
    if posRaw < 0:
        return -1
    var pos = x64bPut8(words, posRaw, 0x40)
    pos = x64bPut8(words, pos, 0x31)
    pos = x64bPut8(words, pos, 0xC0)
    pos = x64bPut8(words, pos, 0xE8)
    return x64bPutU32(words, pos, 0)

# lock xadd [base+0], reg32: 10 bytes
fn x64bLockXadd32(words: var int32[], posRaw: int32, reg: int32, base: int32): int32 =
    var pos = x64bPut8(words, posRaw, 0xF0)
    pos = x64bRex(words, pos, false, reg >= 8, base >= 8)
    pos = x64bPut8(words, pos, 0x0F)
    pos = x64bPut8(words, pos, 0xC1)
    pos = x64bPut8(words, pos, x64bModRM(2, reg, 4))
    pos = x64bPut8(words, pos, 0x20 | (base & 7))
    return x64bPutU32(words, pos, 0)

# add rsp, frameBytes; pop rbp; ret: 9 bytes
fn x64bFillEpilogue(words: var int32[], posRaw: int32, frameBytes: int32): int32 =
    var pos = x64bRspImm32(words, posRaw, 0, frameBytes)
    pos = x64bPut8(words, pos, 0x5D)
    return x64bPut8(words, pos, 0xC3)

const X64BodyEpilogueBytes = 9

# ---------- frame model ----------

const X64BodyInt32Max = 2147483647
const X64BodyInt32Min = -2147483647 - 1

# Frame/layout arithmetic is int32 because every downstream displacement, byte
# cursor and word count is int32.  Reject before evaluating an overflowing add or
# multiply; wrapping here would let the size pass and fill pass disagree.
fn X64BodyCheckedAddNonNegative(lhs: int32, rhs: int32): int32 =
    if lhs < 0 || rhs < 0 || lhs > X64BodyInt32Max - rhs:
        return -1
    return lhs + rhs

fn X64BodyCheckedMulNonNegative(value: int32, factor: int32): int32 =
    if value < 0 || factor < 0:
        return -1
    if factor == 0:
        return 0
    if value > X64BodyInt32Max / factor:
        return -1
    return value * factor

fn X64BodyCheckedMul8(value: int32): int32 =
    if value < 0 || value > 268435455:
        return -1
    return value * 8

fn X64BodyCheckedMul2(value: int32): int32 =
    if value < 0 || value > 1073741823:
        return -1
    return value * 2

fn x64BodyCheckedMul16(value: int32): int32 =
    if value < 0 || value > 134217727:
        return -1
    return value * 16

fn x64BodyCheckedMul4(value: int32): int32 =
    if value < 0 || value > 536870911:
        return -1
    return value * 4

fn x64BodyCheckedMul14(value: int32): int32 =
    if value < 0 || value > 153391689:
        return -1
    return value * 14

@borrows
fn X64BodyCheckedAlign16(bytes: int32): int32 =
    if bytes < 0 || bytes > 2147483632:
        return -1
    return ((bytes + 15) / 16) * 16

@borrows
fn X64BodyCheckedCallArgBytes(callArgCount: int32): int32 =
    return X64BodyCheckedMul8(callArgCount)

@borrows
fn x64BodyLocalIsParam(slot: coreir.LocalSlot): bool =
    return slot.stackOffset < 0

@borrows
fn x64BodyParamIndex(slot: coreir.LocalSlot): int32 =
    if slot.stackOffset >= 0:
        return -1
    if slot.stackOffset == X64BodyInt32Min:
        return -1
    return -1 - slot.stackOffset

@borrows
fn x64BodySlotType(bodyIR: coreir.BodyIR, slotId: int32): int32 =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return coreir.LocalI32Tag
    return bodyIR.localSlots[slotId].typeKind

@borrows
fn x64BodySlotSizeOf(slot: coreir.LocalSlot): int32 =
    if slot.sizeBytes > 0:
        return slot.sizeBytes
    if slot.typeKind == coreir.LocalI32Tag:
        return 4
    if slot.typeKind == coreir.LocalF64Tag ||
       slot.typeKind == coreir.LocalI64Tag ||
       slot.typeKind == coreir.LocalPtrTag:
        return 8
    if slot.typeKind == coreir.LocalStrTag:
        return 24
    if slot.typeKind == coreir.LocalAggregateTag:
        return coreir.ResultStrSizeBytes
    return 0

@borrows
fn x64BodyAlign16(bytes: int32): int32 =
    return X64BodyCheckedAlign16(bytes)

@borrows
fn X64BodyStackByteCount(bodyIR: coreir.BodyIR): int32 =
    var maxSlot: int32
    for i in 0..<bodyIR.localSlots.len:
        if x64BodyLocalIsParam(bodyIR.localSlots[i]):
            continue
        let slot = bodyIR.localSlots[i]
        let slotSize = x64BodySlotSizeOf(slot)
        if slot.stackOffset < 0 || slotSize <= 0 ||
           slot.stackOffset > X64BodyInt32Max - slotSize:
            return -1
        let slotEnd = slot.stackOffset + slotSize
        if slotEnd > maxSlot:
            maxSlot = slotEnd
    if maxSlot < 32:
        maxSlot = 32
    return x64BodyAlign16(maxSlot)

@borrows
fn X64BodyParamCount(bodyIR: coreir.BodyIR): int32 =
    var count: int32
    for i in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[i]
        if !x64BodyLocalIsParam(slot):
            continue
        if slot.stackOffset == X64BodyInt32Min:
            return -1
        let paramSlot = x64BodyParamIndex(slot)
        if paramSlot < 0 || paramSlot == X64BodyInt32Max:
            return -1
        if paramSlot + 1 > count:
            count = paramSlot + 1
    return count

@borrows
fn X64BodyHasSret(bodyIR: coreir.BodyIR): bool =
    for ti in 0..<bodyIR.terms.len:
        let term = bodyIR.terms[ti]
        if term.kind != coreir.BodyTermReturnTag:
            continue
        if term.resultSlot < 0 || term.resultSlot >= bodyIR.localSlots.len:
            continue
        let resultType = bodyIR.localSlots[term.resultSlot].typeKind
        if resultType == coreir.LocalStrTag || resultType == coreir.LocalAggregateTag:
            return true
    return false

@borrows
fn X64BodyRegParamAvail(bodyIR: coreir.BodyIR): int32 =
    if X64BodyHasSret(bodyIR):
        return 5
    return 6

@borrows
fn X64BodyParamSaveOffset(bodyIR: coreir.BodyIR): int32 =
    return X64BodyStackByteCount(bodyIR)

@borrows
fn X64BodyReturnBufferSaveOffset(bodyIR: coreir.BodyIR): int32 =
    let localBytes = X64BodyStackByteCount(bodyIR)
    let paramBytes = X64BodyCheckedMul8(X64BodyParamCount(bodyIR))
    return X64BodyCheckedAddNonNegative(localBytes, paramBytes)

@borrows
fn X64BodyFrameBytes(bodyIR: coreir.BodyIR): int32 =
    let localBytes = X64BodyStackByteCount(bodyIR)
    let paramBytes = X64BodyCheckedMul8(X64BodyParamCount(bodyIR))
    let returnBufferEnd = X64BodyCheckedAddNonNegative(localBytes, paramBytes)
    let frameUnaligned = X64BodyCheckedAddNonNegative(returnBufferEnd, 8)
    return x64BodyAlign16(frameUnaligned)

@borrows
fn X64BodyLocalStackOffset(bodyIR: coreir.BodyIR, slotIndex: int32, paramSaveOffset: int32): int32 =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return -1
    let slot = bodyIR.localSlots[slotIndex]
    if !x64BodyLocalIsParam(slot):
        return slot.stackOffset
    let paramSlot = x64BodyParamIndex(slot)
    if paramSlot < 0:
        return -1
    let paramByteOffset = X64BodyCheckedMul8(paramSlot)
    return X64BodyCheckedAddNonNegative(paramSaveOffset, paramByteOffset)

# ---------- slot load/store (all 8 bytes / 2 words) ----------

@borrows
fn X64BodyLoadSlotWordCount(bodyIR: coreir.BodyIR, slotIndex: int32): int32 =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return 0
    let slotType = bodyIR.localSlots[slotIndex].typeKind
    if slotType == coreir.LocalI32Tag ||
       slotType == coreir.LocalI64Tag ||
       slotType == coreir.LocalPtrTag ||
       slotType == coreir.LocalF64Tag ||
       slotType == coreir.LocalStrTag ||
       slotType == coreir.LocalAggregateTag:
        return 2
    return 0

@borrows
fn X64BodyStoreSlotWordCount(bodyIR: coreir.BodyIR, slotIndex: int32): int32 =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return 0
    let slotType = bodyIR.localSlots[slotIndex].typeKind
    if slotType == coreir.LocalI32Tag ||
       slotType == coreir.LocalI64Tag ||
       slotType == coreir.LocalPtrTag ||
       slotType == coreir.LocalF64Tag:
        return 2
    return 0

@borrows
fn x64BodyLoadSlotToReg(words: var int32[],
                        pos: int32,
                        bodyIR: coreir.BodyIR,
                        slotIndex: int32,
                        reg: int32,
                        paramSaveOffset: int32,
                        spBias: int32): int32 =
    if pos < 0:
        return -1
    let stackOffset = X64BodyLocalStackOffset(bodyIR, slotIndex, paramSaveOffset)
    if stackOffset < 0:
        return -1
    let disp = X64BodyCheckedAddNonNegative(stackOffset, spBias)
    if disp < 0:
        return -1
    let slotType = x64BodySlotType(bodyIR, slotIndex)
    if slotType == coreir.LocalI32Tag:
        return x64bLoad32(words, pos, reg, X64BodyRSP, disp)
    if slotType == coreir.LocalI64Tag ||
       slotType == coreir.LocalPtrTag ||
       slotType == coreir.LocalF64Tag:
        return x64bLoad64(words, pos, reg, X64BodyRSP, disp)
    if slotType == coreir.LocalStrTag ||
       slotType == coreir.LocalAggregateTag:
        if x64BodyLocalIsParam(bodyIR.localSlots[slotIndex]):
            return x64bLoad64(words, pos, reg, X64BodyRSP, disp)
        return x64bLeaStack(words, pos, reg, disp)
    return -1

@borrows
fn x64BodyStoreRegToSlot(words: var int32[],
                         pos: int32,
                         bodyIR: coreir.BodyIR,
                         slotIndex: int32,
                         reg: int32,
                         paramSaveOffset: int32): int32 =
    if pos < 0:
        return -1
    let stackOffset = X64BodyLocalStackOffset(bodyIR, slotIndex, paramSaveOffset)
    if stackOffset < 0:
        return -1
    let slotType = x64BodySlotType(bodyIR, slotIndex)
    if slotType == coreir.LocalI32Tag:
        return x64bStore32(words, pos, reg, X64BodyRSP, stackOffset)
    if slotType == coreir.LocalI64Tag ||
       slotType == coreir.LocalPtrTag ||
       slotType == coreir.LocalF64Tag:
        return x64bStore64(words, pos, reg, X64BodyRSP, stackOffset)
    return -1

# segment-d1: disp8-capable scalar slot chokepoint. Byte-for-byte the same dispatch as
# x64BodyLoadSlotToReg (spBias fixed at 0 — every scalar filler passes 0) but routed
# through the *Auto emitters so a slot whose frame offset fits a signed byte narrows to
# the 5-byte disp8 form (I32: 4B). disp == the frame stackOffset, EXACTLY the value the
# size predictor feeds to X64BodySlotAccessBytesForSlotDisp, so size and fill stay 1:1.
# Only ops whose ENTIRE byte account is disp-aware call this (BinOp/Cmp via ResLoadD8/
# ResStoreD8); ops with hardcoded internal offsets keep the disp32 chokepoint.
@borrows
fn x64BodyLoadSlotToRegD8(words: var int32[],
                          pos: int32,
                          bodyIR: coreir.BodyIR,
                          slotIndex: int32,
                          reg: int32,
                          paramSaveOffset: int32): int32 =
    if pos < 0:
        return -1
    let stackOffset = X64BodyLocalStackOffset(bodyIR, slotIndex, paramSaveOffset)
    if stackOffset < 0:
        return -1
    let slotType = x64BodySlotType(bodyIR, slotIndex)
    if slotType == coreir.LocalI32Tag:
        return x64bLoad32Auto(words, pos, reg, X64BodyRSP, stackOffset)
    if slotType == coreir.LocalI64Tag ||
       slotType == coreir.LocalPtrTag ||
       slotType == coreir.LocalF64Tag:
        return x64bLoad64Auto(words, pos, reg, X64BodyRSP, stackOffset)
    if slotType == coreir.LocalStrTag ||
       slotType == coreir.LocalAggregateTag:
        if x64BodyLocalIsParam(bodyIR.localSlots[slotIndex]):
            return x64bLoad64Auto(words, pos, reg, X64BodyRSP, stackOffset)
        return x64bLeaStackAuto(words, pos, reg, stackOffset)
    return -1

@borrows
fn x64BodyStoreRegToSlotD8(words: var int32[],
                           pos: int32,
                           bodyIR: coreir.BodyIR,
                           slotIndex: int32,
                           reg: int32,
                           paramSaveOffset: int32): int32 =
    if pos < 0:
        return -1
    let stackOffset = X64BodyLocalStackOffset(bodyIR, slotIndex, paramSaveOffset)
    if stackOffset < 0:
        return -1
    let slotType = x64BodySlotType(bodyIR, slotIndex)
    if slotType == coreir.LocalI32Tag:
        return x64bStore32Auto(words, pos, reg, X64BodyRSP, stackOffset)
    if slotType == coreir.LocalI64Tag ||
       slotType == coreir.LocalPtrTag ||
       slotType == coreir.LocalF64Tag:
        return x64bStore64Auto(words, pos, reg, X64BodyRSP, stackOffset)
    return -1

# segment-a: forced-REX I32 slot store (8 bytes) for StrEq's fixed-offset layout.
@borrows
fn x64BodyStoreI32SlotRex(words: var int32[], pos: int32, bodyIR: coreir.BodyIR,
                          slotIndex: int32, reg: int32, paramSaveOffset: int32): int32 =
    let off = X64BodyLocalStackOffset(bodyIR, slotIndex, paramSaveOffset)
    if off < 0:
        return -1
    return x64bStore32Rex(words, pos, reg, X64BodyRSP, off)

@borrows
fn x64BodyLoadStrValueAddressToReg(words: var int32[],
                                   pos: int32,
                                   bodyIR: coreir.BodyIR,
                                   slotIndex: int32,
                                   reg: int32,
                                   paramSaveOffset: int32): int32 =
    if pos < 0:
        return -1
    if x64BodySlotType(bodyIR, slotIndex) != coreir.LocalStrTag:
        return -1
    let stackOffset = X64BodyLocalStackOffset(bodyIR, slotIndex, paramSaveOffset)
    if stackOffset < 0:
        return -1
    if x64BodyLocalIsParam(bodyIR.localSlots[slotIndex]):
        return x64bLoad64(words, pos, reg, X64BodyRSP, stackOffset)
    return x64bLeaStack(words, pos, reg, stackOffset)

# ---------- slot copy ----------

@borrows
fn X64BodyCopySlotByteCount(bodyIR: coreir.BodyIR, sourceSlotIndex: int32, targetSlotIndex: int32): int32 =
    if sourceSlotIndex < 0 || sourceSlotIndex >= bodyIR.localSlots.len ||
       targetSlotIndex < 0 || targetSlotIndex >= bodyIR.localSlots.len:
        return 0
    let sourceType = x64BodySlotType(bodyIR, sourceSlotIndex)
    let targetType = x64BodySlotType(bodyIR, targetSlotIndex)
    # Each scalar copy chunk is one load + one store = 2 slot accesses.
    if sourceType == coreir.LocalI32Tag && targetType == coreir.LocalI64Tag:
        return X64BodySlotAccessBytes * 2
    let slotSize = x64BodySlotSizeOf(bodyIR.localSlots[targetSlotIndex])
    if slotSize <= 0:
        return 0
    # A str/aggregate PARAM slot holds the incoming record POINTER (by-pointer
    # arg), not an inline value; copying it must deref the pointer. That adds one
    # 8-byte pointer load per param side. Mirror of arm64 PrimaryBodyIRCopySlot.
    let copySrcParamAgg = (sourceType == coreir.LocalStrTag ||
                           sourceType == coreir.LocalAggregateTag) &&
                          x64BodyLocalIsParam(bodyIR.localSlots[sourceSlotIndex])
    let copyTgtParamAgg = (targetType == coreir.LocalStrTag ||
                           targetType == coreir.LocalAggregateTag) &&
                          x64BodyLocalIsParam(bodyIR.localSlots[targetSlotIndex])
    if copySrcParamAgg || copyTgtParamAgg:
        let copyParamBytes = X64BodyCopyMemoryByteCount(slotSize)
        if copyParamBytes <= 0:
            return copyParamBytes
        var copyParamExtra = 0
        if copySrcParamAgg:
            copyParamExtra = X64BodyCheckedAddNonNegative(copyParamExtra,
                                                          X64BodySlotAccessBytes)
        if copyTgtParamAgg:
            copyParamExtra = X64BodyCheckedAddNonNegative(copyParamExtra,
                                                          X64BodySlotAccessBytes)
        return X64BodyCheckedAddNonNegative(copyParamExtra, copyParamBytes)
    if slotSize == 4:
        # segment-a: I32/load-inline-aggregate load32(7)+store32(7) = 14.
        return X64BodySlotAccessBytesForType(coreir.LocalI32Tag) * 2
    if slotSize % 8 == 0:
        return x64BodyCheckedMul16(slotSize / 8)
    if slotSize % 4 == 0:
        return x64BodyCheckedMul14(slotSize / 4)
    return x64BodyCheckedMul16(slotSize)

# segment-d12: shape of x64BodyFillCopySlot's LOCAL inline aggregate branches — the
# slotSize%8 / slotSize%4 loops that copy N chunks of load+store with base=rsp. This is
# reached ONLY when the copy is not movsxd (I32->I64), not the scalar-single shape (whose
# one load+store already narrows via the *Auto emitters + its own disp-aware size), and
# not a str/aggregate PARAM by-pointer copy (which derefs RCX/RDX, a non-rsp base with no
# SIB byte — different encoding, kept disp32). Each chunk's load disp = sourceOffset+i*stride
# and store disp = targetOffset+i*stride cross the signed-byte boundary independently, so
# the copy mixes disp8/disp32 block-by-block. Fills strideOut (8 or 4) and chunksOut and
# returns true for exactly this shape; read identically by the filler and the size predictor.
@borrows
fn x64BodyCopyLocalInlineShape(bodyIR: coreir.BodyIR,
                               sourceSlotIndex: int32,
                               targetSlotIndex: int32,
                               strideOut: var int32,
                               chunksOut: var int32): bool =
    strideOut = 0
    chunksOut = 0
    if sourceSlotIndex < 0 || sourceSlotIndex >= bodyIR.localSlots.len ||
       targetSlotIndex < 0 || targetSlotIndex >= bodyIR.localSlots.len:
        return false
    let sourceType = x64BodySlotType(bodyIR, sourceSlotIndex)
    let targetType = x64BodySlotType(bodyIR, targetSlotIndex)
    # movsxd (I32->I64) keeps its own x64bMovsxdMem path.
    if sourceType == coreir.LocalI32Tag && targetType == coreir.LocalI64Tag:
        return false
    let slotSize = x64BodySlotSizeOf(bodyIR.localSlots[targetSlotIndex])
    # size-4 is the slotSize==4 branch (scalar-single I32 or a size-4 aggregate), NOT the
    # multi-chunk %8/%4 loops; leave it on its existing path.
    if slotSize <= 4:
        return false
    # scalar-single (I64/Ptr -> I64/Ptr, size 8) keeps its own disp-aware size path.
    if (sourceType == coreir.LocalI64Tag || sourceType == coreir.LocalPtrTag) &&
       (targetType == coreir.LocalI64Tag || targetType == coreir.LocalPtrTag) &&
       slotSize == 8:
        return false
    # str/aggregate PARAM by-pointer copy derefs RCX/RDX (non-rsp base, no SIB).
    let copySrcParamAgg = (sourceType == coreir.LocalStrTag ||
                           sourceType == coreir.LocalAggregateTag) &&
                          x64BodyLocalIsParam(bodyIR.localSlots[sourceSlotIndex])
    let copyTgtParamAgg = (targetType == coreir.LocalStrTag ||
                           targetType == coreir.LocalAggregateTag) &&
                          x64BodyLocalIsParam(bodyIR.localSlots[targetSlotIndex])
    if copySrcParamAgg || copyTgtParamAgg:
        return false
    if slotSize % 8 == 0:
        strideOut = 8
        chunksOut = slotSize / 8
        return true
    if slotSize % 4 == 0:
        strideOut = 4
        chunksOut = slotSize / 4
        return true
    return false

# Closed-form byte count for one side of a local inline copy.  Only the first
# few non-negative rsp displacements can use disp8; every later chunk is disp32.
# This replaces an O(chunks) sizing loop and proves the final displacement and
# both products before evaluating them.
fn x64BodyInlineCopySideBytes(baseOffset: int32,
                              stride: int32,
                              chunks: int32,
                              shortBytes: int32,
                              longBytes: int32): int32 =
    if baseOffset < 0 || stride <= 0 || chunks <= 0 ||
       shortBytes <= 0 || longBytes <= 0:
        return -1
    let lastDelta = X64BodyCheckedMulNonNegative(chunks - 1, stride)
    if lastDelta < 0 ||
       X64BodyCheckedAddNonNegative(baseOffset, lastDelta) < 0:
        return -1
    var shortChunks = 0
    if baseOffset <= 127:
        shortChunks = (127 - baseOffset) / stride + 1
        if shortChunks > chunks:
            shortChunks = chunks
    let longChunks = chunks - shortChunks
    let shortTotal = X64BodyCheckedMulNonNegative(shortChunks, shortBytes)
    let longTotal = X64BodyCheckedMulNonNegative(longChunks, longBytes)
    return X64BodyCheckedAddNonNegative(shortTotal, longTotal)

# segment-d12: disp-aware byte count of the local inline aggregate copy. Each chunk is a
# load (64-bit stride: 5B disp8 / 8B disp32; 32-bit stride: 4B disp8 / 7B disp32) plus a
# store of the same width; the load and store disp are each computed on the chunk's own rsp
# offset, EXACTLY as the filler's *Auto emitters decide (x64bDispIsShort), so size == fill
# per chunk. Returns -1 when the copy is not this shape so callers keep CopySlotByteCount.
@borrows
fn X64BodyCopyLocalInlineBytesDisp(bodyIR: coreir.BodyIR,
                                   sourceSlotIndex: int32,
                                   targetSlotIndex: int32,
                                   paramSaveOffset: int32): int32 =
    var stride: int32
    var chunks: int32
    if !x64BodyCopyLocalInlineShape(bodyIR, sourceSlotIndex, targetSlotIndex, stride, chunks):
        return -1
    let sourceOffset = X64BodyLocalStackOffset(bodyIR, sourceSlotIndex, paramSaveOffset)
    let targetOffset = X64BodyLocalStackOffset(bodyIR, targetSlotIndex, paramSaveOffset)
    if sourceOffset < 0 || targetOffset < 0:
        return -1
    var accessType = coreir.LocalI64Tag
    if stride == 4:
        accessType = coreir.LocalI32Tag
    var shortBytes = 5
    var longBytes = 8
    if accessType == coreir.LocalI32Tag:
        shortBytes = 4
        longBytes = 7
    let sourceBytes = x64BodyInlineCopySideBytes(sourceOffset,
                                                 stride,
                                                 chunks,
                                                 shortBytes,
                                                 longBytes)
    let targetBytes = x64BodyInlineCopySideBytes(targetOffset,
                                                 stride,
                                                 chunks,
                                                 shortBytes,
                                                 longBytes)
    return X64BodyCheckedAddNonNegative(sourceBytes, targetBytes)

@borrows
fn x64BodyFillCopySlot(words: var int32[],
                       posRaw: int32,
                       bodyIR: coreir.BodyIR,
                       sourceSlotIndex: int32,
                       targetSlotIndex: int32,
                       paramSaveOffset: int32,
                       elideSrc: bool): int32 =
    if sourceSlotIndex < 0 || sourceSlotIndex >= bodyIR.localSlots.len ||
       targetSlotIndex < 0 || targetSlotIndex >= bodyIR.localSlots.len:
        return -1
    let sourceOffset = X64BodyLocalStackOffset(bodyIR, sourceSlotIndex, paramSaveOffset)
    let targetOffset = X64BodyLocalStackOffset(bodyIR, targetSlotIndex, paramSaveOffset)
    if sourceOffset < 0 || targetOffset < 0:
        return -1
    let sourceType = x64BodySlotType(bodyIR, sourceSlotIndex)
    let targetType = x64BodySlotType(bodyIR, targetSlotIndex)
    if sourceType == coreir.LocalI32Tag && targetType == coreir.LocalI64Tag:
        var pos = x64bMovsxdMem(words, posRaw, X64BodyRAX, X64BodyRSP, sourceOffset)
        return x64bStore64(words, pos, X64BodyRAX, X64BodyRSP, targetOffset)
    let slotSize = x64BodySlotSizeOf(bodyIR.localSlots[targetSlotIndex])
    let sourceSlotSize = x64BodySlotSizeOf(bodyIR.localSlots[sourceSlotIndex])
    # segment-d1: the scalar-single copy shapes (I32->I32 size-4, I64/Ptr size-8 single
    # chunk — exactly x64BodyCopyScalarSingle) route their one load+store through the
    # disp8-capable emitters; the size predictor's scalar-single fast path mirrors this.
    # A 4- or 8-byte AGGREGATE copy hits the same slotSize branch but is NOT scalar-single,
    # so it stays disp32 (its size is the symmetric CopySlotByteCount), avoiding a desync.
    let copyScalarSingle =
        (sourceType == coreir.LocalI32Tag && targetType == coreir.LocalI32Tag && slotSize == 4) ||
        ((sourceType == coreir.LocalI64Tag || sourceType == coreir.LocalPtrTag) &&
         (targetType == coreir.LocalI64Tag || targetType == coreir.LocalPtrTag) && slotSize == 8)
    # A 4-byte aggregate parameter still homes a POINTER.  Resolve the param
    # aggregate shape before the scalar-size fast path or this would copy the
    # pointer's low 32 bits instead of dereferencing it.
    let copySrcParamAgg = (sourceType == coreir.LocalStrTag ||
                           sourceType == coreir.LocalAggregateTag) &&
                          x64BodyLocalIsParam(bodyIR.localSlots[sourceSlotIndex])
    let copyTgtParamAgg = (targetType == coreir.LocalStrTag ||
                           targetType == coreir.LocalAggregateTag) &&
                          x64BodyLocalIsParam(bodyIR.localSlots[targetSlotIndex])
    if slotSize == 4 && !copySrcParamAgg && !copyTgtParamAgg:
        # S3 (class-1): when elideSrc, `src` already resident in RAX — skip `load32
        # RAX,[src]`; X64BodyCopySrcElidableAt only fires for this exact I32->I32 shape.
        var pos = posRaw
        if !elideSrc:
            if copyScalarSingle:
                pos = x64bLoad32Auto(words, pos, X64BodyRAX, X64BodyRSP, sourceOffset)
            else:
                pos = x64bLoad32(words, pos, X64BodyRAX, X64BodyRSP, sourceOffset)
        if copyScalarSingle:
            return x64bStore32Auto(words, pos, X64BodyRAX, X64BodyRSP, targetOffset)
        return x64bStore32(words, pos, X64BodyRAX, X64BodyRSP, targetOffset)
    if slotSize <= 0:
        return -1
    if sourceSlotSize < slotSize:
        return -1
    # str/aggregate PARAM slots home the incoming record POINTER; copying their
    # value must deref that pointer (RCX=source base, RDX=target base) instead of
    # reading/writing inline sp-relative. Local aggregate slots keep the inline
    # copy below. Mirror of arm64 PrimaryBodyIRCopySlot param branch.
    if copySrcParamAgg || copyTgtParamAgg:
        var copyParamStride = 0
        var copyParamChunks = 0
        if slotSize % 8 == 0:
            copyParamStride = 8
            copyParamChunks = slotSize / 8
        elif slotSize % 4 == 0:
            copyParamStride = 4
            copyParamChunks = slotSize / 4
        else:
            copyParamStride = 1
            copyParamChunks = slotSize
        var sourceCursor = sourceOffset
        var targetCursor = targetOffset
        if copySrcParamAgg:
            sourceCursor = 0
        if copyTgtParamAgg:
            targetCursor = 0
        if !X64BodyCopyMemoryRangeSupported(sourceCursor, slotSize) ||
           !X64BodyCopyMemoryRangeSupported(targetCursor, slotSize):
            return -1
        var pos = posRaw
        if copySrcParamAgg:
            pos = x64bLoad64(words, pos, X64BodyRCX, X64BodyRSP, sourceOffset)
        if copyTgtParamAgg:
            pos = x64bLoad64(words, pos, X64BodyRDX, X64BodyRSP, targetOffset)
        let copyParamIs64 = copyParamStride == 8
        for copyIndex in 0..<copyParamChunks:
            if copySrcParamAgg:
                if copyParamIs64:
                    pos = x64bLoad64(words, pos, X64BodyRAX, X64BodyRCX, sourceCursor)
                elif copyParamStride == 4:
                    pos = x64bLoad32(words, pos, X64BodyRAX, X64BodyRCX, sourceCursor)
                else:
                    pos = x64bLoad8(words, pos, X64BodyRAX, X64BodyRCX, sourceCursor)
            else:
                if copyParamIs64:
                    pos = x64bLoad64(words, pos, X64BodyRAX, X64BodyRSP, sourceCursor)
                elif copyParamStride == 4:
                    pos = x64bLoad32(words, pos, X64BodyRAX, X64BodyRSP, sourceCursor)
                else:
                    pos = x64bLoad8(words, pos, X64BodyRAX, X64BodyRSP, sourceCursor)
            if copyTgtParamAgg:
                if copyParamIs64:
                    pos = x64bStore64(words, pos, X64BodyRAX, X64BodyRDX, targetCursor)
                elif copyParamStride == 4:
                    pos = x64bStore32(words, pos, X64BodyRAX, X64BodyRDX, targetCursor)
                else:
                    pos = x64bStore8(words, pos, X64BodyRAX, X64BodyRDX, targetCursor)
            else:
                if copyParamIs64:
                    pos = x64bStore64(words, pos, X64BodyRAX, X64BodyRSP, targetCursor)
                elif copyParamStride == 4:
                    pos = x64bStore32(words, pos, X64BodyRAX, X64BodyRSP, targetCursor)
                else:
                    pos = x64bStore8(words, pos, X64BodyRAX, X64BodyRSP, targetCursor)
            if pos < 0:
                return -1
            if copyIndex + 1 < copyParamChunks:
                sourceCursor = X64BodyCheckedAddNonNegative(sourceCursor,
                                                            copyParamStride)
                targetCursor = X64BodyCheckedAddNonNegative(targetCursor,
                                                            copyParamStride)
                if sourceCursor < 0 || targetCursor < 0:
                    return -1
        return pos
    if slotSize % 8 == 0:
        if !x64BodyCopyDisplacementRangeSupported(sourceOffset, slotSize) ||
           !x64BodyCopyDisplacementRangeSupported(targetOffset, slotSize):
            return -1
        var pos = posRaw
        var sourceCursor = sourceOffset
        var targetCursor = targetOffset
        let copyChunks = slotSize / 8
        for copyIndex in 0..<copyChunks:
            # S3 (class-2): when elideSrc, `src` already resident in RAX — skip the
            # leading `load64 RAX,[src]`. X64BodyCopySrcElidableAt only fires for the
            # single-chunk (slotSize==8) I64/Ptr shape, so only copyIndex 0 is skipped.
            if !(elideSrc && copyIndex == 0):
                # segment-d1/d12: this %8 branch is a LOCAL (non-param, non-movsxd) copy —
                # scalar-single (size-8 I64/Ptr) and inline aggregate (size 8/16/24...) both
                # narrow each chunk to disp8 by its own rsp offset via the *Auto emitter
                # (byte-identical to x64bLoad64 when the offset exceeds a signed byte). The
                # size predictor mirrors this per chunk (X64BodyCopyLocalInlineBytesDisp for
                # the aggregate, the scalar-single disp path for size-8 I64/Ptr).
                pos = x64bLoad64Auto(words, pos, X64BodyRAX, X64BodyRSP, sourceCursor)
            pos = x64bStore64Auto(words, pos, X64BodyRAX, X64BodyRSP, targetCursor)
            if pos < 0:
                return -1
            if copyIndex + 1 < copyChunks:
                sourceCursor = X64BodyCheckedAddNonNegative(sourceCursor, 8)
                targetCursor = X64BodyCheckedAddNonNegative(targetCursor, 8)
                if sourceCursor < 0 || targetCursor < 0:
                    return -1
        return pos
    if slotSize % 4 == 0:
        if !x64BodyCopyDisplacementRangeSupported(sourceOffset, slotSize) ||
           !x64BodyCopyDisplacementRangeSupported(targetOffset, slotSize):
            return -1
        var pos = posRaw
        var sourceCursor = sourceOffset
        var targetCursor = targetOffset
        let copyChunks = slotSize / 4
        # segment-d12: LOCAL inline aggregate 4-byte chunks (size 12/20/28...) narrow to
        # disp8 by the chunk offset; the size predictor mirrors via X64BodyCopyLocalInlineBytesDisp.
        for copyIndex in 0..<copyChunks:
            pos = x64bLoad32Auto(words, pos, X64BodyRAX, X64BodyRSP, sourceCursor)
            pos = x64bStore32Auto(words, pos, X64BodyRAX, X64BodyRSP, targetCursor)
            if pos < 0:
                return -1
            if copyIndex + 1 < copyChunks:
                sourceCursor = X64BodyCheckedAddNonNegative(sourceCursor, 4)
                targetCursor = X64BodyCheckedAddNonNegative(targetCursor, 4)
                if sourceCursor < 0 || targetCursor < 0:
                    return -1
        return pos
    if !x64BodyCopyDisplacementRangeSupported(sourceOffset, slotSize) ||
       !x64BodyCopyDisplacementRangeSupported(targetOffset, slotSize):
        return -1
    var pos = posRaw
    var sourceCursor = sourceOffset
    var targetCursor = targetOffset
    for copyIndex in 0..<slotSize:
        pos = x64bLoad8(words, pos, X64BodyRAX, X64BodyRSP, sourceCursor)
        pos = x64bStore8(words, pos, X64BodyRAX, X64BodyRSP, targetCursor)
        if pos < 0:
            return -1
        if copyIndex + 1 < slotSize:
            sourceCursor = X64BodyCheckedAddNonNegative(sourceCursor, 1)
            targetCursor = X64BodyCheckedAddNonNegative(targetCursor, 1)
            if sourceCursor < 0 || targetCursor < 0:
                return -1
    return pos

# ---------- memory copy (transfer reg = rdx) ----------

# segment-a: 8-byte chunks load64+store64 = 16B; 4-byte chunks load32+store32 = 14B
# (no REX); byte chunks movzx8(9, keeps REX) + store8(7, no REX) = 16B.
fn X64BodyCopyMemoryByteCount(byteCount: int32): int32 =
    if byteCount <= 0:
        return 0
    if byteCount % 8 == 0:
        return x64BodyCheckedMul16(byteCount / 8)
    if byteCount % 4 == 0:
        return x64BodyCheckedMul14(byteCount / 4)
    return x64BodyCheckedMul16(byteCount)

# Every memory-copy displacement is int32.  Prove the largest displacement
# before entering the loop so no source/target offset addition can wrap midway.
fn x64BodyCopyDisplacementRangeSupported(offset: int32, byteCount: int32): bool =
    if offset < 0 || byteCount <= 0:
        return false
    var lastDelta = byteCount - 1
    if byteCount % 8 == 0:
        lastDelta = byteCount - 8
    elif byteCount % 4 == 0:
        lastDelta = byteCount - 4
    return X64BodyCheckedAddNonNegative(offset, lastDelta) >= 0

fn X64BodyCopyMemoryRangeSupported(offset: int32, byteCount: int32): bool =
    return X64BodyCopyMemoryByteCount(byteCount) > 0 &&
           x64BodyCopyDisplacementRangeSupported(offset, byteCount)

fn x64BodyFillCopyMemory(words: var int32[],
                         posRaw: int32,
                         sourceReg: int32,
                         sourceOffset: int32,
                         targetReg: int32,
                         targetOffset: int32,
                         byteCount: int32): int32 =
    if !X64BodyCopyMemoryRangeSupported(sourceOffset, byteCount) ||
       !X64BodyCopyMemoryRangeSupported(targetOffset, byteCount):
        return -1
    var pos = posRaw
    var sourceCursor = sourceOffset
    var targetCursor = targetOffset
    if byteCount % 8 == 0:
        for copyIndex in 0..<(byteCount / 8):
            pos = x64bLoad64(words, pos, X64BodyRDX, sourceReg, sourceCursor)
            pos = x64bStore64(words, pos, X64BodyRDX, targetReg, targetCursor)
            if pos < 0:
                return -1
            if copyIndex + 1 < byteCount / 8:
                sourceCursor = X64BodyCheckedAddNonNegative(sourceCursor, 8)
                targetCursor = X64BodyCheckedAddNonNegative(targetCursor, 8)
                if sourceCursor < 0 || targetCursor < 0:
                    return -1
        return pos
    if byteCount % 4 == 0:
        for copyIndex in 0..<(byteCount / 4):
            pos = x64bLoad32(words, pos, X64BodyRDX, sourceReg, sourceCursor)
            pos = x64bStore32(words, pos, X64BodyRDX, targetReg, targetCursor)
            if pos < 0:
                return -1
            if copyIndex + 1 < byteCount / 4:
                sourceCursor = X64BodyCheckedAddNonNegative(sourceCursor, 4)
                targetCursor = X64BodyCheckedAddNonNegative(targetCursor, 4)
                if sourceCursor < 0 || targetCursor < 0:
                    return -1
        return pos
    for copyIndex in 0..<byteCount:
        pos = x64bLoad8(words, pos, X64BodyRDX, sourceReg, sourceCursor)
        pos = x64bStore8(words, pos, X64BodyRDX, targetReg, targetCursor)
        if pos < 0:
            return -1
        if copyIndex + 1 < byteCount:
            sourceCursor = X64BodyCheckedAddNonNegative(sourceCursor, 1)
            targetCursor = X64BodyCheckedAddNonNegative(targetCursor, 1)
            if sourceCursor < 0 || targetCursor < 0:
                return -1
    return pos

# ---------- call model ----------

@borrows
fn x64BodyInlineAtomicKind(call: coreir.CallOp): int32 =
    var kind: int32
    if call.targetSymbol == "__cheng_runtime_atomic_add_i32" ||
       call.targetSymbol == "___cheng_runtime_atomic_add_i32":
        kind = 1
    elif call.targetSymbol == "cheng_atomic_fetch_add_i32" ||
         call.targetSymbol == "_cheng_atomic_fetch_add_i32":
        kind = 2
    if kind <= 0:
        return 0
    if call.argSlots.len != 2:
        return 0
    return kind

@borrows
fn x64BodyInlineAtomicWordCount(inlineKind: int32): int32 =
    if inlineKind == 1:
        return 4
    if inlineKind == 2:
        return 8
    return 0

# Indirect call intrinsics: cheng_call_ptr_i32_raw(fn, ctx, a, b) /
# cheng_call_ptr_void_raw(fn, ctx). Args are pre-loaded per SysV order; the
# inline group shifts them down one register and calls through R10.
@borrows
fn X64BodyIndirectCallKind(call: coreir.CallOp): int32 =
    if call.targetSymbol == "cheng_call_ptr_i32_raw" && call.argSlots.len == 4:
        return 1
    if call.targetSymbol == "cheng_call_ptr_void_raw" && call.argSlots.len == 2:
        return 2
    return 0

fn x64BodyIndirectCallWordCount(indirectKind: int32): int32 =
    if indirectKind == 1:
        return 4
    if indirectKind == 2:
        return 3
    return 0

fn x64BodyFillIndirectCall(words: var int32[], posRaw: int32, indirectKind: int32): int32 =
    if posRaw < 0:
        return -1
    if indirectKind == 1:
        var pos = x64bMovRR(words, posRaw, X64BodyR10, X64BodyRDI, true)
        pos = x64bMovRR(words, pos, X64BodyRDI, X64BodyRSI, true)
        pos = x64bMovRR(words, pos, X64BodyRSI, X64BodyRDX, true)
        pos = x64bMovRR(words, pos, X64BodyRDX, X64BodyRCX, true)
        pos = x64bPut8(words, pos, 0x41)
        pos = x64bPut8(words, pos, 0xFF)
        pos = x64bPut8(words, pos, 0xD2)
        return x64bPadTo(words, pos, posRaw + 16)
    if indirectKind == 2:
        var pos = x64bMovRR(words, posRaw, X64BodyR10, X64BodyRDI, true)
        pos = x64bMovRR(words, pos, X64BodyRDI, X64BodyRSI, true)
        pos = x64bPut8(words, pos, 0x41)
        pos = x64bPut8(words, pos, 0xFF)
        pos = x64bPut8(words, pos, 0xD2)
        return x64bPadTo(words, pos, posRaw + 12)
    return -1

@borrows
fn X64BodyCallHasIndirectResult(bodyIR: coreir.BodyIR, call: coreir.CallOp): bool =
    if call.resultSlot < 0 || call.resultSlot >= bodyIR.localSlots.len:
        return false
    let resultType = bodyIR.localSlots[call.resultSlot].typeKind
    if resultType == coreir.LocalStrTag:
        return true
    if resultType == coreir.LocalAggregateTag:
        return true
    return false

@borrows
fn X64BodyCallStoresScalarResult(bodyIR: coreir.BodyIR, call: coreir.CallOp): bool =
    if call.resultSlot < 0 || call.resultSlot >= bodyIR.localSlots.len:
        return false
    let resultType = bodyIR.localSlots[call.resultSlot].typeKind
    if resultType == coreir.LocalI32Tag:
        return true
    if resultType == coreir.LocalI64Tag:
        return true
    if resultType == coreir.LocalPtrTag:
        return true
    if resultType == coreir.LocalF64Tag:
        return true
    return false

@borrows
fn X64BodyCallResultIsF64(bodyIR: coreir.BodyIR, call: coreir.CallOp): bool =
    return call.resultSlot >= 0 &&
           call.resultSlot < bodyIR.localSlots.len &&
           bodyIR.localSlots[call.resultSlot].typeKind == coreir.LocalF64Tag

@borrows
fn X64BodyCallAbiSupported(bodyIR: coreir.BodyIR, call: coreir.CallOp): bool =
    if !call.targetIsImportc:
        return true
    # A real SysV C boundary requires an independent XMM argument bank.  XMM0
    # results are bridged above, but f64 arguments remain fail-closed until the
    # full positional SSE-bank planner is present.
    for argIndex in 0..<call.argSlots.len:
        let argSlot = call.argSlots[argIndex]
        if argSlot >= 0 && argSlot < bodyIR.localSlots.len &&
           bodyIR.localSlots[argSlot].typeKind == coreir.LocalF64Tag:
            return false
    return true

@borrows
fn X64BodyEntryAbiSupported(bodyIR: coreir.BodyIR): bool =
    if !bodyIR.entryIsCAbi:
        return true
    # Return f64 is bridged through XMM0.  Incoming f64 still needs the
    # independent SysV SSE parameter bank, which this entry prologue does not
    # yet model; reject that exact surface before producing bytes.
    for slotIndex in 0..<bodyIR.localSlots.len:
        if x64BodyLocalIsParam(bodyIR.localSlots[slotIndex]) &&
           bodyIR.localSlots[slotIndex].typeKind == coreir.LocalF64Tag:
            return false
    return true

@borrows
fn X64BodyCallRegArgCount(bodyIR: coreir.BodyIR, call: coreir.CallOp): int32 =
    var avail = 6
    if X64BodyCallHasIndirectResult(bodyIR, call):
        avail = 5
    if call.argSlots.len > avail:
        return avail
    return call.argSlots.len

@borrows
fn X64BodyCallStackArgCount(bodyIR: coreir.BodyIR, call: coreir.CallOp): int32 =
    return call.argSlots.len - X64BodyCallRegArgCount(bodyIR, call)

@borrows
fn X64BodyCallStackArgBytes(bodyIR: coreir.BodyIR, call: coreir.CallOp): int32 =
    let rawBytes = X64BodyCheckedCallArgBytes(X64BodyCallStackArgCount(bodyIR, call))
    return x64BodyAlign16(rawBytes)

@borrows
fn X64BodyValidateFrameLayout(bodyIR: coreir.BodyIR): bool =
    for slotIndex in 0..<bodyIR.localSlots.len:
        if x64BodySlotSizeOf(bodyIR.localSlots[slotIndex]) <= 0:
            return false
    let localBytes = X64BodyStackByteCount(bodyIR)
    let paramCount = X64BodyParamCount(bodyIR)
    let paramBytes = X64BodyCheckedMul8(paramCount)
    let returnBufferEnd = X64BodyCheckedAddNonNegative(localBytes, paramBytes)
    let frameUnaligned = X64BodyCheckedAddNonNegative(returnBufferEnd, 8)
    let frameBytes = X64BodyCheckedAlign16(frameUnaligned)
    if localBytes < 0 || paramCount < 0 || paramBytes < 0 ||
       returnBufferEnd < 0 || frameUnaligned < 0 || frameBytes <= 0:
        return false
    # The prologue has a larger per-stack-param encoding footprint than the
    # frame itself; validate it here so its size cannot wrap independently.
    if X64BodyPrologueByteCount(bodyIR) <= 0:
        return false
    let regParamAvail = X64BodyRegParamAvail(bodyIR)
    if paramCount > regParamAvail:
        let highestIncomingStackParam = paramCount - regParamAvail - 1
        let highestIncomingByte = X64BodyCheckedMul8(highestIncomingStackParam)
        let incomingStackBase = X64BodyCheckedAddNonNegative(frameBytes, 16)
        if highestIncomingByte < 0 || incomingStackBase < 0 ||
           X64BodyCheckedAddNonNegative(incomingStackBase,
                                        highestIncomingByte) < 0:
            return false
    for callIndex in 0..<bodyIR.callSequence.len:
        let call = bodyIR.callSequence[callIndex]
        if X64BodyCheckedCallArgBytes(call.argSlots.len) < 0:
            return false
        let stackArgBytes = X64BodyCallStackArgBytes(bodyIR, call)
        if stackArgBytes < 0 ||
           X64BodyCheckedAddNonNegative(frameBytes, stackArgBytes) < 0:
            return false
    return true

@borrows
fn X64BodyProductionAdmission(bodyIR: coreir.BodyIR): bool =
    if !X64BodyValidateFrameLayout(bodyIR) ||
       !X64BodyEntryAbiSupported(bodyIR):
        return false
    for callIndex in 0..<bodyIR.callSequence.len:
        if !X64BodyCallAbiSupported(bodyIR,
                                    bodyIR.callSequence[callIndex]):
            return false
    return true

@borrows
fn x64BodyCallArgPassKind(call: coreir.CallOp, argIndex: int32): int32 =
    if argIndex >= 0 && argIndex < call.argPassKinds.len:
        return call.argPassKinds[argIndex]
    return coreir.BodyCallPassStackValueTag

@borrows
fn X64BodyCallArgWordCount(bodyIR: coreir.BodyIR, argSlot: int32, passKind: int32): int32 =
    if passKind == coreir.BodyCallPassGlobalAddressTag:
        if argSlot < 0 ||
           argSlot >= bodyIR.localSlots.len ||
           bodyIR.localSlots[argSlot].placeKind != coreir.BodyPlaceGlobalAddressTag:
            return 0
        return 2
    if coreir.CallArgSlotIsConst(argSlot):
        return 2
    if coreir.CallArgSlotIsCString(argSlot):
        return 2
    if coreir.CallArgSlotIsAddress(argSlot):
        let slotId = coreir.CallArgSlotAddressId(argSlot)
        let slotOffset = X64BodyLocalStackOffset(bodyIR, slotId, X64BodyParamSaveOffset(bodyIR))
        if slotOffset < 0:
            return 0
        return 2
    return X64BodyLoadSlotWordCount(bodyIR, argSlot)

# word offset (within the op) of the call group start: sub-rsp + args + sret
@borrows
fn x64BodyCallGroupStartWords(bodyIR: coreir.BodyIR, call: coreir.CallOp): int32 =
    var count: int32
    if X64BodyCallStackArgBytes(bodyIR, call) > 0:
        count = X64BodyCheckedAddNonNegative(count, 2)
    let regArgCount = X64BodyCallRegArgCount(bodyIR, call)
    for argIndex in 0..<regArgCount:
        let argWords = X64BodyCallArgWordCount(bodyIR,
                                               call.argSlots[argIndex],
                                               x64BodyCallArgPassKind(call, argIndex))
        if argWords <= 0:
            return -1
        count = X64BodyCheckedAddNonNegative(count, 2)
        if count < 0:
            return -1
    let stackArgCount = X64BodyCallStackArgCount(bodyIR, call)
    for stackArgIndex in 0..<stackArgCount:
        let argIndex = regArgCount + stackArgIndex
        let argWords = X64BodyCallArgWordCount(bodyIR,
                                               call.argSlots[argIndex],
                                               x64BodyCallArgPassKind(call, argIndex))
        if argWords <= 0:
            return -1
        count = X64BodyCheckedAddNonNegative(count, 4)
        if count < 0:
            return -1
    if X64BodyCallHasIndirectResult(bodyIR, call):
        count = X64BodyCheckedAddNonNegative(count, 2)
    return count

# segment-b: BYTE offset (within the op) of the call rel32 placeholder. The call
# group is xor eax,eax(3) + call opcode(1) + rel32(4); rel32 sits at group byte 4.
# groupStart counts whole words, so its byte base = groupStart*4 and the rel32 =
# (groupStart+1)*4.
@borrows
fn X64BodyCallRelWordOffset(bodyIR: coreir.BodyIR, op: coreir.BodyOp): int32 =
    if op.kind != coreir.BodyOpCallTag || op.operands.len <= 0:
        return -1
    let callOrdinal = op.operands[0]
    if callOrdinal < 0 || callOrdinal >= bodyIR.callSequence.len:
        return -1
    let call = bodyIR.callSequence[callOrdinal]
    if x64BodyInlineAtomicKind(call) > 0:
        return -1
    if X64BodyIndirectCallKind(call) > 0:
        return -1
    let groupStart = x64BodyCallGroupStartWords(bodyIR, call)
    if groupStart < 0:
        return -1
    let relWord = X64BodyCheckedAddNonNegative(groupStart, 1)
    return x64BodyCheckedMul4(relWord)

@borrows
fn X64BodyCallWordCount(bodyIR: coreir.BodyIR, op: coreir.BodyOp): int32 =
    if op.operands.len <= 0:
        return 0
    let callOrdinal = op.operands[0]
    if callOrdinal < 0 || callOrdinal >= bodyIR.callSequence.len:
        return 0
    let call = bodyIR.callSequence[callOrdinal]
    let groupStart = x64BodyCallGroupStartWords(bodyIR, call)
    if groupStart < 0:
        return 0
    let inlineKind = x64BodyInlineAtomicKind(call)
    let indirectKind = X64BodyIndirectCallKind(call)
    var count = groupStart
    if inlineKind > 0:
        count = X64BodyCheckedAddNonNegative(count,
                                             x64BodyInlineAtomicWordCount(inlineKind))
    elif indirectKind > 0:
        count = X64BodyCheckedAddNonNegative(count,
                                             x64BodyIndirectCallWordCount(indirectKind))
    else:
        count = X64BodyCheckedAddNonNegative(count, 2)
    if X64BodyCallStackArgBytes(bodyIR, call) > 0:
        count = X64BodyCheckedAddNonNegative(count, 2)
    if X64BodyCallStoresScalarResult(bodyIR, call):
        var resultWords = 2
        if X64BodyCallResultIsF64(bodyIR, call):
            resultWords = 4
        count = X64BodyCheckedAddNonNegative(count, resultWords)
    return count

# fill one call argument into reg: always exactly 8 bytes, entry must be word-aligned
@borrows
fn x64BodyFillCallArgToReg(words: var int32[],
                           posRaw: int32,
                           bodyIR: coreir.BodyIR,
                           argSlot: int32,
                           passKind: int32,
                           reg: int32,
                           paramSaveOffset: int32,
                           spBias: int32): int32 =
    if posRaw < 0:
        return -1
    if passKind == coreir.BodyCallPassGlobalAddressTag:
        if argSlot < 0 ||
           argSlot >= bodyIR.localSlots.len ||
           bodyIR.localSlots[argSlot].placeKind != coreir.BodyPlaceGlobalAddressTag:
            return -1
        return x64bLeaRipGroup(words, posRaw, reg)
    if coreir.CallArgSlotIsConst(argSlot):
        let pos = x64bMovImm32(words, posRaw, reg, coreir.CallArgSlotConstI32Value(argSlot), false)
        return x64bPadTo(words, pos, posRaw + 8)
    if coreir.CallArgSlotIsCString(argSlot):
        return x64bLeaRipGroup(words, posRaw, reg)
    if coreir.CallArgSlotIsAddress(argSlot):
        let slotId = coreir.CallArgSlotAddressId(argSlot)
        let slotOffset = X64BodyLocalStackOffset(bodyIR, slotId, paramSaveOffset)
        if slotOffset < 0:
            return -1
        let biasedOffset = X64BodyCheckedAddNonNegative(slotOffset, spBias)
        if biasedOffset < 0:
            return -1
        return x64bLeaStack(words, posRaw, reg, biasedOffset)
    # segment-a: the call keeps its word-structured 8-byte arg slots (const args are
    # likewise padded to 8). An I32 slot arg loads REX-free (7B), so pad it back to 8
    # so the call byte count stays wordCount*4 and the reloc arg walk stays aligned.
    let argLoadPos = x64BodyLoadSlotToReg(words, posRaw, bodyIR, argSlot, reg, paramSaveOffset, spBias)
    return x64bPadTo(words, argLoadPos, posRaw + 8)

fn x64BodyFillInlineAtomic(words: var int32[], posRaw: int32, inlineKind: int32): int32 =
    if posRaw < 0:
        return -1
    if inlineKind == 1:
        var pos = x64bMovRR(words, posRaw, X64BodyRAX, X64BodyRSI, false)
        pos = x64bLockXadd32(words, pos, X64BodyRAX, X64BodyRDI)
        return x64bPadTo(words, pos, posRaw + 16)
    if inlineKind == 2:
        var pos = x64bTestRR(words, posRaw, X64BodyRDI, X64BodyRDI, true)
        pos = x64bJccRel32(words, pos, X64BodyCcE, 18)
        pos = x64bMovRR(words, pos, X64BodyRAX, X64BodyRSI, false)
        pos = x64bLockXadd32(words, pos, X64BodyRAX, X64BodyRDI)
        pos = x64bJmpRel32(words, pos, 3)
        pos = x64bXorRR(words, pos, X64BodyRAX, X64BodyRAX, false)
        return x64bPadTo(words, pos, posRaw + 32)
    return -1

@borrows
fn x64BodyFillCallOp(words: var int32[],
                     posRaw: int32,
                     bodyIR: coreir.BodyIR,
                     op: coreir.BodyOp,
                     paramSaveOffset: int32): int32 =
    if op.operands.len <= 0:
        return -1
    let callOrdinal = op.operands[0]
    if callOrdinal < 0 || callOrdinal >= bodyIR.callSequence.len:
        return -1
    let call = bodyIR.callSequence[callOrdinal]
    var pos = posRaw
    let stackArgBytes = X64BodyCallStackArgBytes(bodyIR, call)
    if stackArgBytes > 0:
        pos = x64bRspImm32(words, pos, 5, stackArgBytes)
        pos = x64bPadTo(words, pos, posRaw + 8)
    var shift: int32
    if X64BodyCallHasIndirectResult(bodyIR, call):
        shift = 1
    let regArgCount = X64BodyCallRegArgCount(bodyIR, call)
    for argIndex in 0..<regArgCount:
        pos = x64BodyFillCallArgToReg(words,
                                      pos,
                                      bodyIR,
                                      call.argSlots[argIndex],
                                      x64BodyCallArgPassKind(call, argIndex),
                                      X64BodyArgReg(argIndex + shift),
                                      paramSaveOffset,
                                      stackArgBytes)
        if pos < 0:
            return -1
    let stackArgCount = X64BodyCallStackArgCount(bodyIR, call)
    for stackArgIndex in 0..<stackArgCount:
        let argIndex = regArgCount + stackArgIndex
        pos = x64BodyFillCallArgToReg(words,
                                      pos,
                                      bodyIR,
                                      call.argSlots[argIndex],
                                      x64BodyCallArgPassKind(call, argIndex),
                                      X64BodyR10,
                                      paramSaveOffset,
                                      stackArgBytes)
        if pos < 0:
            return -1
        let stackArgOffset = X64BodyCheckedMul8(stackArgIndex)
        if stackArgOffset < 0:
            return -1
        pos = x64bStore64(words, pos, X64BodyR10, X64BodyRSP, stackArgOffset)
        if pos < 0:
            return -1
    if X64BodyCallHasIndirectResult(bodyIR, call):
        let resultOffset = X64BodyLocalStackOffset(bodyIR, call.resultSlot, paramSaveOffset)
        if resultOffset < 0:
            return -1
        let biasedResultOffset = X64BodyCheckedAddNonNegative(resultOffset,
                                                               stackArgBytes)
        if biasedResultOffset < 0:
            return -1
        pos = x64bLeaStack(words, pos, X64BodyRDI, biasedResultOffset)
        if pos < 0:
            return -1
    let inlineKind = x64BodyInlineAtomicKind(call)
    let indirectKind = X64BodyIndirectCallKind(call)
    if inlineKind > 0:
        pos = x64BodyFillInlineAtomic(words, pos, inlineKind)
    elif indirectKind > 0:
        pos = x64BodyFillIndirectCall(words, pos, indirectKind)
    else:
        pos = x64bCallGroup(words, pos)
    if pos < 0:
        return -1
    if stackArgBytes > 0:
        let addStart = pos
        pos = x64bRspImm32(words, pos, 0, stackArgBytes)
        pos = x64bPadTo(words, pos, addStart + 8)
    if X64BodyCallStoresScalarResult(bodyIR, call):
        # segment-a: word-structured 8-byte result store; an I32 store is REX-free (7B),
        # pad to 8 so the call byte count stays wordCount*4.
        let resStorePos = pos
        var resultBytes = 8
        if X64BodyCallResultIsF64(bodyIR, call):
            pos = x64bMovqRaxFromXmm0(words, pos)
            resultBytes = 16
        pos = x64BodyStoreRegToSlot(words, pos, bodyIR, call.resultSlot, X64BodyRAX, paramSaveOffset)
        pos = x64bPadTo(words, pos, resStorePos + resultBytes)
    return pos

# ---------- op size model ----------

@borrows
fn X64BodyStrEqLiteralByteCount(bodyIR: coreir.BodyIR, op: coreir.BodyOp): int32 =
    if op.operands.len < 2:
        return 0
    if op.target < 0 || op.target >= bodyIR.localSlots.len:
        return 0
    if bodyIR.localSlots[op.target].typeKind != coreir.LocalI32Tag:
        return 0
    let strSlot = op.operands[0]
    if strSlot < 0 ||
       strSlot >= bodyIR.localSlots.len ||
       bodyIR.localSlots[strSlot].typeKind != coreir.LocalStrTag:
        return 0
    let literalId = op.operands[1]
    if literalId < 0 || literalId >= bodyIR.cstringLiterals.len:
        return 0
    # Fixed compact loop: literal LEA-RIP [8], source str address/ptr/len [24],
    # one/zero setup [10], length cmp+jcc [13], byte loop/equal select [53],
    # result store [8]. Literal size affects data only, never code size.
    return 116

@borrows
fn X64BodyStrEqByteCount(bodyIR: coreir.BodyIR, op: coreir.BodyOp): int32 =
    if op.operands.len < 2:
        return 0
    if op.target < 0 || op.target >= bodyIR.localSlots.len:
        return 0
    if bodyIR.localSlots[op.target].typeKind != coreir.LocalI32Tag:
        return 0
    let lhsSlot = op.operands[0]
    if lhsSlot < 0 ||
       lhsSlot >= bodyIR.localSlots.len ||
       bodyIR.localSlots[lhsSlot].typeKind != coreir.LocalStrTag:
        return 0
    let rhsSlot = op.operands[1]
    if rhsSlot < 0 ||
       rhsSlot >= bodyIR.localSlots.len ||
       bodyIR.localSlots[rhsSlot].typeKind != coreir.LocalStrTag:
        return 0
    return 125

@borrows
fn x64BodyGlobalOpIs64(bodyIR: coreir.BodyIR, op: coreir.BodyOp): bool =
    if op.operands.len < 1:
        return false
    if op.operands[0] < 0 || op.operands[0] >= bodyIR.localSlots.len:
        return false
    let typeKind = bodyIR.localSlots[op.operands[0]].typeKind
    if typeKind == coreir.LocalI64Tag:
        return true
    if typeKind == coreir.LocalPtrTag:
        return true
    return false

fn X64BodyIndexedScaleByteCount(elemSize: int32): int32 =
    if elemSize <= 0:
        return 0
    if elemSize == 1:
        return 3
    if elemSize == 4 || elemSize == 8:
        return 7
    # arbitrary elemSize via imul: imm8-encodable (4B) or imm32 (7B), plus add rax,rcx (3B).
    if elemSize <= 127:
        return 7
    return 10

# segment-s6: SIB-scaled element access predicate. Returns the SIB scale-log (0/2/3 for
# elemSize 1/4/8) when base+index*scale folds directly into the element load/store's
# ModRM+SIB addressing byte (mod=00, no separate imul/shl+add); -1 for every other
# elemSize, which keeps the imul+add address-materialization path. Read by BOTH the size
# predictor (X64BodyOpByteCount) and the filler so the two-pass byte account stays 1:1.
fn X64BodyIndexedSibScaleLog(elemSize: int32): int32 =
    if elemSize == 1:
        return 0
    if elemSize == 4:
        return 2
    if elemSize == 8:
        return 3
    return -1

# segment-s7: SIB-form indexed op gate, shared by the size predictor and both
# fillers so the two-pass byte account stays 1:1. The base+index*scale ModRM+SIB
# arm fires for op.operands[0] being EITHER a local aggregate slot (S6 stack base
# `lea rsp`) OR a Ptr base slot carrying the operands[4]==2 sentinel (S7 global
# fixed array: base = &g already materialized into the Ptr slot by an
# address-only GlobalLoad, `mov rax,[rsp]` reload). Both base loads are 8 bytes,
# so baseBytes stays 8 for both forms. Every other Ptr-base IndexedLoad/Store
# (full pre-computed element address, operands < 5 or operands[4] != 2) stays on
# the plain-deref arm-2.
@borrows
fn X64BodyIndexedIsSibForm(bodyIR: coreir.BodyIR, op: coreir.BodyOp): bool =
    if op.operands.len < 4:
        return false
    if op.operands[0] < 0 || op.operands[0] >= bodyIR.localSlots.len:
        return false
    let baseKind = bodyIR.localSlots[op.operands[0]].typeKind
    if baseKind == coreir.LocalAggregateTag:
        return true
    if baseKind == coreir.LocalPtrTag &&
       op.operands.len >= 5 &&
       op.operands[4] == 2:
        return true
    return false

# Aggregate-value element copy: op.operands[1] is a LocalAggregateTag slot whose
# size matches elemSize. Returns the word-by-word copy byte count (mirrors
# X64BodyCopyMemoryByteCount), or 0 when this is not an aggregate-value element.
@borrows
fn X64BodyIndexedAggregateValueCopyBytes(bodyIR: coreir.BodyIR, valueSlot: int32, elemSize: int32): int32 =
    if elemSize <= 0:
        return 0
    if valueSlot < 0 || valueSlot >= bodyIR.localSlots.len:
        return 0
    if bodyIR.localSlots[valueSlot].typeKind != coreir.LocalAggregateTag:
        return 0
    if x64BodySlotSizeOf(bodyIR.localSlots[valueSlot]) != elemSize:
        return 0
    return X64BodyCopyMemoryByteCount(elemSize)

@borrows
fn X64BodyFrameRestoreWordCount(bodyIR: coreir.BodyIR): int32 =
    let _ = bodyIR
    return 3

fn X64BodyWordsOfChecked(byteCount: int32): int32 =
    # A word count is later multiplied by four to allocate/fill the byte image.
    # Reject ceil(/4) values whose padded byte size would exceed int32 first.
    if byteCount <= 0 || byteCount > 2147483644:
        return 0
    return (byteCount + 3) / 4

# ---------- scalar op byte-account components (S0) ----------
# A scalar BinOp/Cmp byte account decomposes as lhsLoad + rhsLoad + core +
# resultStore, each memory access being X64BodySlotAccessBytes (8, disp32-SIB);
# a LoadConst is materialize + resultStore. Naming the 8-byte access as one
# component lets the S1 lhs-reload peephole subtract exactly one such access, and
# keeps the size predictor (X64BodyOpByteCount) and the filler reading the SAME
# decomposition — the invariant the two-pass word account depends on.

# Non-memory ("core") byte count of a supported scalar BinOp, or -1 if opKind is
# not a supported scalar BinOp. Excludes lhs/rhs/addend loads and the result
# store (each X64BodySlotAccessBytes). Verified 1:1 against x64BodyFillBinOp:
#   add/sub/and/or/xor/asr/lsr/lsl : x64bAluRR / x64bShiftCl        = 3
#   mul                            : x64bImulRR                     = 4
#   sdiv                           : x64bCdq(2) + x64bIdiv(3)        = 5
#   udiv                           : x64bXorRR(3) + x64bDiv(3)       = 6
#   madd                           : x64bImulRR(4) + x64bAddRR(3)    = 7
fn X64BodyBinOpCoreBytes(opKind: int32): int32 =
    if opKind == int32(texpr.TypedExprIrOpI32Add) ||
       opKind == int32(texpr.TypedExprIrOpI32Sub) ||
       opKind == int32(texpr.TypedExprIrOpI32BitAnd) ||
       opKind == int32(texpr.TypedExprIrOpI32BitOr) ||
       opKind == int32(texpr.TypedExprIrOpI32BitXor) ||
       opKind == int32(texpr.TypedExprIrOpI32Asr) ||
       opKind == int32(texpr.TypedExprIrOpI32Lsr) ||
       opKind == int32(texpr.TypedExprIrOpI32Lsl):
        return 3
    if opKind == int32(texpr.TypedExprIrOpI32Mul):
        return 4
    if opKind == int32(texpr.TypedExprIrOpI32Sdiv):
        return 5
    if opKind == int32(texpr.TypedExprIrOpI32Udiv):
        return 6
    if opKind == int32(texpr.TypedExprIrOpI32Madd):
        return 7
    return -1

# Scalar-load width class of a slot type: 1 = I32 (load32, zero-extends RAX),
# 2 = I64/Ptr (load64, full 64-bit). 0 = not a scalar GPR value (F64/Str/Agg) —
# excluded from the lhs-reload peephole.
@borrows
fn x64BodyScalarWidthClass(slotTypeKind: int32): int32 =
    if slotTypeKind == coreir.LocalI32Tag:
        return 1
    if slotTypeKind == coreir.LocalI64Tag ||
       slotTypeKind == coreir.LocalPtrTag:
        return 2
    return 0

# opStart of the block that contains opIndex, or -1 if no block owns it.
@borrows
fn x64BodyOpBlockStartOf(bodyIR: coreir.BodyIR, opIndex: int32): int32 =
    for bi in 0..<bodyIR.blocks.len:
        let b = bodyIR.blocks[bi]
        if b.opStart >= 0 && b.opCount >= 0 &&
           opIndex >= b.opStart && opIndex < b.opStart + b.opCount:
            return b.opStart
    return -1

# lhs slot of a scalar BinOp(non-Madd)/Cmp consumer — the operand whose fill
# emits `load lhs -> RAX` as its FIRST instruction — or -1 if `op` is not such a
# consumer. Madd is excluded as a consumer (conservative: its result path is
# unchanged, only its first load could be elided; keep parity with arm64).
@borrows
fn x64BodyConsumerLhsSlot(op: coreir.BodyOp): int32 =
    if op.kind == coreir.BodyOpBinOpTag:
        if op.operands.len < 4:
            return -1
        if op.operands[0] != coreir.LocalI32Tag &&
           op.operands[0] != coreir.LocalI64Tag:
            return -1
        if op.operands[1] == int32(texpr.TypedExprIrOpI32Madd):
            return -1
        return op.operands[2]
    if op.kind == coreir.BodyOpCmpTag:
        if op.operands.len < 3:
            return -1
        return op.operands[1]
    return -1

# ---------- S1: lhs-reload peephole (single source of truth) ----------
# True iff op[opIndex] is a scalar BinOp(non-Madd)/Cmp whose lhs reload can be
# dropped because the immediately preceding SAME-BLOCK op already left that exact
# value resident in RAX. Read by BOTH the size predictor (X64BodyOpByteCount,
# subtract one X64BodySlotAccessBytes) and the filler (x64BodyFillBinOp /
# x64BodyFillCmpOp, skip the first `load lhs -> RAX`). A pure function of bodyIR
# with no side effects; both passes MUST call it with the same opIndex or the
# word accounts desync.
#
# Producer white-list (each leaves RAX == the canonical loaded form of slot S,
# and stores it to S as its LAST instruction):
#   BinOp  : arithmetic result stays in RAX; I32 ops zero-extend, I64 full.
#   Cmp    : setcc + movzx8 => RAX = zero-extended 0/1 (bool I32).
#   LoadConst i32/i64/ptr : mov/movabs materializes into RAX.
# Excluded (conservative, "宁可少删不可错删"):
#   CopyLocal/StoreLocal   : movsxd / multi-chunk / str-agg param-deref shapes
#                            give non-uniform RAX residency.
#   LoadConst F64          : F64 bit pattern, not a GPR scalar consumer value.
#   any width mismatch     : producer result width must equal the consumer lhs
#                            slot width (I32<->I32, I64/Ptr<->I64/Ptr) so a
#                            reload and the resident RAX are bit-identical.
@borrows
fn X64BodyLhsReloadElidableAt(bodyIR: coreir.BodyIR, opIndex: int32): bool =
    if opIndex <= 0 || opIndex >= bodyIR.ops.len:
        return false
    let op = bodyIR.ops[opIndex]
    let lhsSlot = x64BodyConsumerLhsSlot(op)
    if lhsSlot < 0 || lhsSlot >= bodyIR.localSlots.len:
        return false
    let curWidth = x64BodyScalarWidthClass(x64BodySlotType(bodyIR, lhsSlot))
    if curWidth == 0:
        return false
    # Same-block boundary: opIndex must not be its block's first op, so the
    # producer op[opIndex-1] is guaranteed to fall through into it (no incoming
    # edge can arrive between them with a different RAX).
    let blockStart = x64BodyOpBlockStartOf(bodyIR, opIndex)
    if blockStart < 0 || opIndex <= blockStart:
        return false
    let prev = bodyIR.ops[opIndex - 1]
    if prev.kind == coreir.BodyOpBinOpTag:
        if prev.operands.len < 4:
            return false
        if prev.operands[0] != coreir.LocalI32Tag &&
           prev.operands[0] != coreir.LocalI64Tag:
            return false
        if X64BodyBinOpCoreBytes(prev.operands[1]) < 0:
            return false
        if prev.target != lhsSlot:
            return false
        return x64BodyScalarWidthClass(prev.operands[0]) == curWidth
    if prev.kind == coreir.BodyOpCmpTag:
        if prev.target != lhsSlot:
            return false
        return curWidth == 1
    if prev.kind == coreir.BodyOpLoadConstTag:
        if prev.operands.len < 2:
            return false
        if prev.operands[0] != coreir.LocalI32Tag &&
           prev.operands[0] != coreir.LocalI64Tag &&
           prev.operands[0] != coreir.LocalPtrTag:
            return false
        if prev.target != lhsSlot:
            return false
        return x64BodyScalarWidthClass(prev.operands[0]) == curWidth
    return false

# True iff op[prevIndex] is a scalar producer (BinOp / Cmp / LoadConst) whose LAST
# instruction stores RAX to slot `slot`, leaving RAX == the canonical `wantWidth`
# loaded form of that slot (width class 1 = I32 zero-extended, 2 = I64/Ptr full).
# This is the exact producer white-list S1 applies to op[opIndex-1]; S3 reuses it so
# the "value already resident in RAX" contract is bit-identical to S1's.
@borrows
fn x64BodyPrevLeavesRaxForSlot(bodyIR: coreir.BodyIR, prevIndex: int32, slot: int32, wantWidth: int32): bool =
    if prevIndex < 0 || prevIndex >= bodyIR.ops.len:
        return false
    let prev = bodyIR.ops[prevIndex]
    if prev.kind == coreir.BodyOpBinOpTag:
        if prev.operands.len < 4:
            return false
        if prev.operands[0] != coreir.LocalI32Tag &&
           prev.operands[0] != coreir.LocalI64Tag:
            return false
        if X64BodyBinOpCoreBytes(prev.operands[1]) < 0:
            return false
        if prev.target != slot:
            return false
        return x64BodyScalarWidthClass(prev.operands[0]) == wantWidth
    if prev.kind == coreir.BodyOpCmpTag:
        if prev.target != slot:
            return false
        return wantWidth == 1
    if prev.kind == coreir.BodyOpLoadConstTag:
        if prev.operands.len < 2:
            return false
        if prev.operands[0] != coreir.LocalI32Tag &&
           prev.operands[0] != coreir.LocalI64Tag &&
           prev.operands[0] != coreir.LocalPtrTag:
            return false
        if prev.target != slot:
            return false
        return x64BodyScalarWidthClass(prev.operands[0]) == wantWidth
    return false

# ---------- S2 support: body-wide per-slot READ count ----------
# Conservative use model ported 1:1 from arm64 PrimaryBodyIrBuildSlotReadCounts, but
# tallying ONE slot `s`. Op kinds whose operand layout is known (Return/Branch/Call/
# LoadLocal/Store-Copy/BinOp/Cmp) count only their genuine slot READ positions; EVERY
# other op kind counts ALL operands, so a read of `s` in any unmodeled shape — a
# FieldStore/IndexedStore/GlobalStore base or value, an address-taken &s, etc. — is
# still counted. Writes (op.target) are never counted as reads. Call args are read via
# callSequence[ordinal].argSlots; terminator slot fields and operands are all counted.
# Over-counting can only DISABLE store-elide (make a single-use look multi-use), never
# enable an unsafe drop of a genuinely-loaded store. Non-slot operands are avoided by
# using the modeled positions (a BinOp operands[0]=type/[1]=opKind and a LoadConst's
# literal words never collide into a false read of the slot index they numerically
# equal — the LoadConst-collision trap the arm64 census case documents).
@borrows
fn x64BodySlotReadCount(bodyIR: coreir.BodyIR, s: int32): int32 =
    if !bodyIR.x64StackLayoutReady ||
       bodyIR.x64SlotReadCnt.len != bodyIR.localSlots.len:
        panic("x64 stack layout is not prepared")
    if s < 0 || s >= bodyIR.x64SlotReadCnt.len:
        return 0
    return bodyIR.x64SlotReadCnt[s]
@borrows
fn X64BodyStoreElidableAt(bodyIR: coreir.BodyIR, opIndex: int32): bool =
    if opIndex < 0 || opIndex + 1 >= bodyIR.ops.len:
        return false
    let op = bodyIR.ops[opIndex]
    var producerOk = false
    if op.kind == coreir.BodyOpBinOpTag:
        if op.operands.len >= 4 &&
           (op.operands[0] == coreir.LocalI32Tag || op.operands[0] == coreir.LocalI64Tag) &&
           op.operands[1] != int32(texpr.TypedExprIrOpI32Madd) &&
           X64BodyBinOpCoreBytes(op.operands[1]) >= 0:
            producerOk = true
    if op.kind == coreir.BodyOpCmpTag:
        if op.operands.len >= 3:
            producerOk = true
    if !producerOk:
        return false
    let s = op.target
    if s < 0 || s >= bodyIR.localSlots.len:
        return false
    if x64BodyScalarWidthClass(x64BodySlotType(bodyIR, s)) == 0:
        return false
    if x64BodyLocalIsParam(bodyIR.localSlots[s]):
        return false
    if !X64BodyLhsReloadElidableAt(bodyIR, opIndex + 1):
        return false
    if x64BodyConsumerLhsSlot(bodyIR.ops[opIndex + 1]) != s:
        return false
    return x64BodySlotReadCount(bodyIR, s) == 1

# ---------- S5: cmp/branch fusion (boolean materialization elimination) ----------
# Ported 1:1 from arm64 Stage10 Cmp->Cbr fusion (layoutCmpFuse/layoutCbrFuse). When a
# scalar Cmp is a block's LAST op and its materialized bool is consumed ONLY by that
# block's terminating Cbr (conditionKind == LocalNonZero, lhsSlot == cmp.target,
# rhsSlot < 0 => the `bool != 0` guard), the whole boolean round-trip is dead:
#   Cmp side  : setcc(4) + movzx8(4) + bool store(8) dropped — just lhs/rhs load + cmp
#               leaves the compare flags live.
#   Cbr side  : guard reload(8) + cmp#0(7) dropped — jcc branches straight off the flags.
# Correctness rests on the Cmp being the block's LAST op, so the terminator immediately
# follows with only nop op-boundary padding between them (nops preserve EFLAGS) — the
# compare flags are still live at the jcc. Only LocalNonZero is fused (matching arm64):
# the jcc true-branch condition is exactly the Cmp's true condition code, so the polarity
# is a straight passthrough with no inversion:
#   Cbr LocalNonZero, bool!=0 -> trueBlock  <=>  jcc(X64BodyCondTrueCC(cmp)) -> trueByte
# Both the size predictor and the fillers derive fusion from THIS pure predicate so the
# strict two-pass word accounts stay in lockstep with no cache between them.
#
# block index that owns opIndex (or -1). Companion to x64BodyOpBlockStartOf which
# returns the opStart; here we need the index to reach block.termIndex.
@borrows
fn x64BodyOpBlockIndexOf(bodyIR: coreir.BodyIR, opIndex: int32): int32 =
    for bi in 0..<bodyIR.blocks.len:
        let b = bodyIR.blocks[bi]
        if b.opStart >= 0 && b.opCount >= 0 &&
           opIndex >= b.opStart && opIndex < b.opStart + b.opCount:
            return bi
    return -1

# block index whose terminator is terms[termIndex] (or -1). One block owns each term.
@borrows
fn x64BodyTermBlockIndexOf(bodyIR: coreir.BodyIR, termIndex: int32): int32 =
    for bi in 0..<bodyIR.blocks.len:
        if bodyIR.blocks[bi].termIndex == termIndex:
            return bi
    return -1

# True iff block[blockIndex] is a Cmp->Cbr fusion site (see the S5 header above).
@borrows
fn X64BodyCmpBranchFusableBlock(bodyIR: coreir.BodyIR, blockIndex: int32): bool =
    if blockIndex < 0 || blockIndex >= bodyIR.blocks.len:
        return false
    let block = bodyIR.blocks[blockIndex]
    if block.opStart < 0 || block.opCount <= 0:
        return false
    let termIndex = block.termIndex
    if termIndex < 0 || termIndex >= bodyIR.terms.len:
        return false
    let term = bodyIR.terms[termIndex]
    if term.kind != coreir.BodyTermCbrTag:
        return false
    # Only the `bool != 0` guard form is fused (arm64 parity); rhsSlot must be the
    # compare-to-zero sentinel and the bool must live in lhsSlot (resultSlot fallback).
    if term.conditionKind != coreir.BodyCondLocalNonZeroTag:
        return false
    if term.rhsSlot >= 0:
        return false
    var boolSlot = term.lhsSlot
    if boolSlot < 0:
        boolSlot = term.resultSlot
    if boolSlot < 0 || boolSlot >= bodyIR.localSlots.len:
        return false
    let lastOp = block.opStart + block.opCount - 1
    if lastOp < 0 || lastOp >= bodyIR.ops.len:
        return false
    let op = bodyIR.ops[lastOp]
    if op.kind != coreir.BodyOpCmpTag:
        return false
    if X64BodyCmpKind(bodyIR, op) == 0:
        return false
    if op.target != boolSlot:
        return false
    if x64BodyLocalIsParam(bodyIR.localSlots[boolSlot]):
        return false
    # The bool's ONLY body-wide read must be this Cbr; any other reader keeps the store.
    return x64BodySlotReadCount(bodyIR, boolSlot) == 1

# True iff op[opIndex] is the fused Cmp — the block's LAST op at a fusion site. Read
# by the Cmp size case and the Cmp filler to drop setcc+movzx8+store.
@borrows
fn X64BodyCmpFusedAt(bodyIR: coreir.BodyIR, opIndex: int32): bool =
    if opIndex < 0 || opIndex >= bodyIR.ops.len:
        return false
    if bodyIR.ops[opIndex].kind != coreir.BodyOpCmpTag:
        return false
    let bi = x64BodyOpBlockIndexOf(bodyIR, opIndex)
    if bi < 0:
        return false
    let block = bodyIR.blocks[bi]
    if opIndex != block.opStart + block.opCount - 1:
        return false
    return X64BodyCmpBranchFusableBlock(bodyIR, bi)

# True iff terms[termIndex] is the fused Cbr. Read by the Cbr size case and the Cbr
# filler to drop the guard reload+cmp#0 and branch straight off the Cmp flags.
@borrows
fn X64BodyCbrFusedAt(bodyIR: coreir.BodyIR, termIndex: int32): bool =
    return X64BodyCmpBranchFusableBlock(bodyIR, x64BodyTermBlockIndexOf(bodyIR, termIndex))

# ---------- S3: copy-source-elide (single source of truth) ----------
# True iff op[opIndex] is a scalar same-width CopyLocal/StoreLocal whose SOURCE slot was
# just produced by the immediately preceding same-block op with the value still resident
# in RAX — so the copy's leading `load src -> RAX` is redundant and dropped (the target
# store is KEPT). Read by BOTH the size predictor (CopyLocal/StoreLocal case, subtract one
# X64BodySlotAccessBytes) and the filler (x64BodyFillCopySlot, skip the first load). Pure
# function; both passes MUST call it with the same opIndex or the word accounts desync.
#
# Only the two single-uniform-load copy shapes qualify (matching x64BodyFillCopySlot's
# FIRST-instruction path selection exactly), so dropping the lead load is bit-exact:
#   class-2  I64/Ptr -> I64/Ptr, target slotSize == 8  => leading `load64 RAX,[src]`
#   class-1  I32     -> I32,      target slotSize == 4  => leading `load32 RAX,[src]`
# Excluded (non-uniform / multi-load / width-change): I32->I64 movsxd, str/aggregate
# param-deref, and every multi-chunk aggregate copy. Independent of S2: the producer's
# store is NOT elided here (S2 never fires when the consumer is a copy), so memory[src]
# holds the value the kept target store needs — dropping only the reload is exact.
@borrows
fn X64BodyCopySrcElidableAt(bodyIR: coreir.BodyIR, opIndex: int32): bool =
    if opIndex <= 0 || opIndex >= bodyIR.ops.len:
        return false
    let op = bodyIR.ops[opIndex]
    if op.kind != coreir.BodyOpCopyLocalTag && op.kind != coreir.BodyOpStoreLocalTag:
        return false
    if op.operands.len < 1:
        return false
    let src = op.operands[0]
    let tgt = op.target
    if src < 0 || src >= bodyIR.localSlots.len:
        return false
    if tgt < 0 || tgt >= bodyIR.localSlots.len:
        return false
    let srcType = x64BodySlotType(bodyIR, src)
    let tgtType = x64BodySlotType(bodyIR, tgt)
    let tgtSize = x64BodySlotSizeOf(bodyIR.localSlots[tgt])
    var copyWidth = 0
    if (srcType == coreir.LocalI64Tag || srcType == coreir.LocalPtrTag) &&
       (tgtType == coreir.LocalI64Tag || tgtType == coreir.LocalPtrTag) &&
       tgtSize == 8:
        copyWidth = 2
    elif srcType == coreir.LocalI32Tag && tgtType == coreir.LocalI32Tag && tgtSize == 4:
        copyWidth = 1
    if copyWidth == 0:
        return false
    let blockStart = x64BodyOpBlockStartOf(bodyIR, opIndex)
    if blockStart < 0 || opIndex <= blockStart:
        return false
    return x64BodyPrevLeavesRaxForSlot(bodyIR, opIndex - 1, src, copyWidth)

# True iff `op` is a CopyLocal/StoreLocal of the exact scalar single-load shape
# (I64/Ptr->I64/Ptr size 8, or I32->I32 size 4). Only these shapes get a single
# `load src -> RAX` / `store RAX -> tgt`, matching
# X64BodyCopySrcElidableAt's shape gate.
@borrows
fn x64BodyCopyScalarSingle(bodyIR: coreir.BodyIR, op: coreir.BodyOp): bool =
    if op.kind != coreir.BodyOpCopyLocalTag && op.kind != coreir.BodyOpStoreLocalTag:
        return false
    if op.operands.len < 1:
        return false
    let src = op.operands[0]
    let tgt = op.target
    if src < 0 || src >= bodyIR.localSlots.len || tgt < 0 || tgt >= bodyIR.localSlots.len:
        return false
    let srcType = x64BodySlotType(bodyIR, src)
    let tgtType = x64BodySlotType(bodyIR, tgt)
    let tgtSize = x64BodySlotSizeOf(bodyIR.localSlots[tgt])
    if (srcType == coreir.LocalI64Tag || srcType == coreir.LocalPtrTag) &&
       (tgtType == coreir.LocalI64Tag || tgtType == coreir.LocalPtrTag) &&
       tgtSize == 8:
        return true
    if srcType == coreir.LocalI32Tag && tgtType == coreir.LocalI32Tag && tgtSize == 4:
        return true
    return false

var x64BodyPosAssertInitialized: bool
var x64BodyPosAssertEnabled: bool

@borrows
fn X64BodyPosAssertEnabled(): bool =
    if !x64BodyPosAssertInitialized:
        x64BodyPosAssertInitialized = true
        x64BodyPosAssertEnabled = os.GetEnv("CHENG_X64_POS_ASSERT") == "1"
    return x64BodyPosAssertEnabled

# Stack-only operand loads and result stores.
@borrows
fn x64BodyResLoad(words: var int32[], pos: int32, bodyIR: coreir.BodyIR,
                  slotIndex: int32, dstReg: int32, paramSaveOffset: int32): int32 =
    return x64BodyLoadSlotToReg(words, pos, bodyIR, slotIndex, dstReg, paramSaveOffset, 0)

@borrows
fn x64BodyResStore(words: var int32[], pos: int32, bodyIR: coreir.BodyIR,
                   slotIndex: int32, srcReg: int32, paramSaveOffset: int32): int32 =
    return x64BodyStoreRegToSlot(words, pos, bodyIR, slotIndex, srcReg, paramSaveOffset)

# Stack-only disp8-capable accessors used by BinOp/Cmp fillers.
@borrows
fn x64BodyResLoadD8(words: var int32[], pos: int32, bodyIR: coreir.BodyIR,
                    slotIndex: int32, dstReg: int32, paramSaveOffset: int32): int32 =
    return x64BodyLoadSlotToRegD8(words, pos, bodyIR, slotIndex, dstReg, paramSaveOffset)

@borrows
fn x64BodyResStoreD8(words: var int32[], pos: int32, bodyIR: coreir.BodyIR,
                     slotIndex: int32, srcReg: int32, paramSaveOffset: int32): int32 =
    return x64BodyStoreRegToSlotD8(words, pos, bodyIR, slotIndex, srcReg, paramSaveOffset)

# ---------- frozen stack-only layout ----------
@borrows
fn x64bReadCntInc(counts: var int32[], v: int32) =
    if v >= 0 && v < counts.len:
        counts[v] = counts[v] + 1

# Single-pass inversion of x64BodySlotReadCount: builds the body-wide read count for
# EVERY slot at once, mirroring that function's per-op-kind counting exactly (same op
# dispatch, same modeled operand ranges, LoadConst/Invalid skipped so no literal/tag
# collision). counts[s] == x64BodySlotReadCount(bodyIR, s) for every valid s.
@borrows
fn X64BodyBuildSlotReadCounts(bodyIR: coreir.BodyIR): int32[] =
    let n = bodyIR.localSlots.len
    var counts: int32[]
    for _ in 0..<n:
        add(counts, 0)
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        if op.kind == coreir.BodyOpInvalidTag:
            continue
        if op.kind == coreir.BodyOpLoadConstTag:
            continue
        if op.kind == coreir.BodyOpReturnTag:
            x64bReadCntInc(counts, op.target)
            for rri in 0..<op.operands.len:
                x64bReadCntInc(counts, op.operands[rri])
            continue
        if op.kind == coreir.BodyOpBranchTag:
            for bfi in 0..<op.operands.len:
                x64bReadCntInc(counts, op.operands[bfi])
            continue
        if op.kind == coreir.BodyOpCallTag:
            if op.operands.len > 0:
                let ordinal = op.operands[0]
                if ordinal >= 0 && ordinal < bodyIR.callSequence.len:
                    let callOp = bodyIR.callSequence[ordinal]
                    for ai in 0..<callOp.argSlots.len:
                        x64bReadCntInc(counts, callOp.argSlots[ai])
            continue
        if op.kind == coreir.BodyOpLoadLocalTag:
            for lli in 0..<op.operands.len:
                x64bReadCntInc(counts, op.operands[lli])
            continue
        if op.kind == coreir.BodyOpStoreLocalTag ||
           op.kind == coreir.BodyOpCopyLocalTag:
            if op.operands.len >= 1:
                x64bReadCntInc(counts, op.operands[0])
            continue
        if op.kind == coreir.BodyOpBinOpTag:
            for bri in 2..<op.operands.len:
                x64bReadCntInc(counts, op.operands[bri])
            continue
        if op.kind == coreir.BodyOpCmpTag:
            for cri in 1..<op.operands.len:
                x64bReadCntInc(counts, op.operands[cri])
            continue
        for uri in 0..<op.operands.len:
            x64bReadCntInc(counts, op.operands[uri])
    for termIndex in 0..<bodyIR.terms.len:
        let term = bodyIR.terms[termIndex]
        x64bReadCntInc(counts, term.lhsSlot)
        x64bReadCntInc(counts, term.rhsSlot)
        x64bReadCntInc(counts, term.resultSlot)
        for tri in 0..<term.operands.len:
            x64bReadCntInc(counts, term.operands[tri])
    return counts

@borrows
fn X64BodyPrepareStackLayout(bodyIR: var coreir.BodyIR): bool =
    bodyIR.x64StackLayoutReady = false
    bodyIR.x64BlockStartReady = false
    bodyIR.x64SlotReadCnt = []
    bodyIR.x64BlockByteStart = []
    if !X64BodyProductionAdmission(bodyIR):
        return false
    bodyIR.x64SlotReadCnt = X64BodyBuildSlotReadCounts(bodyIR)
    if bodyIR.x64SlotReadCnt.len != bodyIR.localSlots.len:
        return false
    bodyIR.x64StackLayoutReady = true
    var byteStart = X64BodyPrologueByteCount(bodyIR)
    if byteStart <= 0:
        bodyIR.x64StackLayoutReady = false
        return false
    for blockIndex in 0..<bodyIR.blocks.len:
        add(bodyIR.x64BlockByteStart, byteStart)
        let blockBytes = X64BodyBlockSize(bodyIR, blockIndex)
        byteStart = X64BodyCheckedAddNonNegative(byteStart, blockBytes)
        if blockBytes <= 0 || byteStart < 0:
            bodyIR.x64StackLayoutReady = false
            bodyIR.x64SlotReadCnt = []
            bodyIR.x64BlockByteStart = []
            return false
    bodyIR.x64BlockStartReady = true
    return true

@borrows
fn X64BodyOpByteCount(bodyIR: coreir.BodyIR, opIndex: int32): int32 =
    if opIndex < 0 || opIndex >= bodyIR.ops.len:
        return 0
    let op = bodyIR.ops[opIndex]
    if op.kind == coreir.BodyOpInvalidTag:
        return 0
    if op.kind == coreir.BodyOpCallTag:
        return x64BodyCheckedMul4(X64BodyCallWordCount(bodyIR, op))
    if op.kind == coreir.BodyOpReturnTag:
        return 4
    if op.kind == coreir.BodyOpLoadConstTag:
        if op.operands.len >= 2:
            # materialize + resultStore(8). i64/ptr constants beyond int32 range
            # arrive as four 16-bit chunks in operands[1..4] (same producer layout
            # as F64) and need the 10-byte movabs (x64bMovImm64Chunks) => 10+8=18;
            # the narrow form is the 7-byte sign-extended imm32 (x64bMovImm32) =>
            # 7+8=15.
            # segment-a: an I32 slot store is 7B (no REX), else 8B.
            # segment-d1: I32/I64/Ptr LoadConst stores the materialized value through the
            # disp8-capable chokepoint (ResStoreD8), so the store is 4/5/7/8; F64 stays
            # disp32 (its own const-8 branch below).
            var lcStore = X64BodySlotAccessBytesForSlotDisp(bodyIR, op.target)
            if (op.operands[0] == coreir.LocalI64Tag ||
                op.operands[0] == coreir.LocalPtrTag) &&
               op.operands.len >= 5:
                return 10 + lcStore
            if op.operands[0] == coreir.LocalI32Tag ||
               op.operands[0] == coreir.LocalI64Tag ||
               op.operands[0] == coreir.LocalPtrTag:
                return 7 + lcStore
            if op.operands[0] == coreir.LocalF64Tag && op.operands.len >= 5:
                return 10 + X64BodySlotAccessBytes
        return 0
    if op.kind == coreir.BodyOpCopyLocalTag ||
       op.kind == coreir.BodyOpStoreLocalTag:
        if op.operands.len < 1 || op.target < 0 || op.target >= bodyIR.localSlots.len ||
           op.operands[0] < 0 || op.operands[0] >= bodyIR.localSlots.len:
            return 0
        # segment-d1: scalar-single copy (I32->I32 size-4, I64/Ptr size-8) narrows its one
        # load+store to disp8 when the offsets fit. Compute the size directly (disp-aware),
        # mirroring x64BodyFillCopySlot's copyScalarSingle branch, instead of via the
        # symmetric disp32 CopySlotByteCount. Multi-chunk / movsxd / aggregate copies fall
        # through to the unchanged disp32 accounting below.
        if x64BodyCopyScalarSingle(bodyIR, op):
            let ssSrc = X64BodySlotAccessBytesForSlotDisp(bodyIR, op.operands[0])
            let ssTgt = X64BodySlotAccessBytesForSlotDisp(bodyIR, op.target)
            var ssBytes = ssSrc + ssTgt
            if X64BodyCopySrcElidableAt(bodyIR, opIndex):
                ssBytes = ssBytes - ssSrc
            return ssBytes
        # segment-d12: LOCAL inline aggregate copy (non-param, non-movsxd, non-scalar-single)
        # narrows each load/store chunk to disp8 by its own rsp offset. Mirrors the filler's
        # *Auto emitters per chunk; movsxd and param-aggregate copies return -1 and fall to
        # the disp32 CopySlotByteCount below. No S3 adjustment: elision is a
        # single-chunk-only shape, excluded for every aggregate copy.
        let aggCopyBytes = X64BodyCopyLocalInlineBytesDisp(bodyIR, op.operands[0], op.target, X64BodyParamSaveOffset(bodyIR))
        if aggCopyBytes >= 0:
            return aggCopyBytes
        var copyBytes = X64BodyCopySlotByteCount(bodyIR, op.operands[0], op.target)
        # segment-a: the single-load shape's source/target access is 7B for I32 else 8B.
        let copySrcAcc = X64BodySlotAccessBytesForSlot(bodyIR, op.operands[0])
        let copyTgtAcc = X64BodySlotAccessBytesForSlot(bodyIR, op.target)
        # S3: drop the redundant leading source load when its value is already
        # resident in RAX (mirrored by x64BodyFillCopySlot via the same predicate).
        if X64BodyCopySrcElidableAt(bodyIR, opIndex):
            copyBytes = copyBytes - copySrcAcc
        return copyBytes
    if op.kind == coreir.BodyOpResultProjectTag:
        if op.operands.len < 2:
            return 0
        if op.operands[0] == coreir.BodyResultProjectIsErrTag ||
           op.operands[0] == coreir.BodyResultProjectIsOkTag:
            # segment-a: load32(7)+xor(3)+test(3)+setcc(4)+store32(7) = 24 (ok-flag and
            # bool target are both I32, so their slot accesses are REX-free).
            return 24
        if op.operands[0] == coreir.BodyResultProjectValueStrTag ||
           op.operands[0] == coreir.BodyResultProjectErrorStrTag ||
           op.operands[0] == coreir.BodyResultProjectErrInfoTag:
            if op.operands.len >= 4:
                return X64BodyCopyMemoryByteCount(op.operands[3])
            return X64BodyCopyMemoryByteCount(24)
        return 0
    if op.kind == coreir.BodyOpBinOpTag:
        if op.operands.len < 4:
            return 0
        let opKind = op.operands[1]
        if op.operands[0] != coreir.LocalI32Tag &&
           op.operands[0] != coreir.LocalI64Tag:
            return 0
        let binCore = X64BodyBinOpCoreBytes(opKind)
        if binCore < 0:
            return 0
        let isMadd = opKind == int32(texpr.TypedExprIrOpI32Madd)
        if isMadd && op.operands.len < 5:
            return 0
        # lhsLoad + rhsLoad + core + resultStore [+ addendLoad madd]. segment-a: each
        # scalar slot access is 7B for I32 (no REX) or 8B otherwise; the core keeps its
        # REX. I32 add = 7+7+3+7 = 24 (was 27), etc. segment-d1: the BinOp filler routes
        # every operand/result access through the disp8-capable chokepoint (ResLoadD8/
        # ResStoreD8), so each access is 4/5/7/8 by X64BodySlotAccessBytesForSlotDisp.
        let lhsAcc = X64BodySlotAccessBytesForSlotDisp(bodyIR, op.operands[2])
        let rhsAcc = X64BodySlotAccessBytesForSlotDisp(bodyIR, op.operands[3])
        let tgtAcc = X64BodySlotAccessBytesForSlotDisp(bodyIR, op.target)
        var binBytes = lhsAcc + rhsAcc + binCore + tgtAcc
        var maddAcc = 0
        if isMadd:
            maddAcc = X64BodySlotAccessBytesForSlotDisp(bodyIR, op.operands[4])
            binBytes = binBytes + maddAcc
        # S1: drop the lhs reload when it is already resident in RAX (mirrored by
        # x64BodyFillBinOp via the same predicate).
        if X64BodyLhsReloadElidableAt(bodyIR, opIndex):
            binBytes = binBytes - lhsAcc
        # S2: drop the result store when S is a single-use temp consumed straight out
        # of RAX by the next op (mirrored by x64BodyFillBinOp via the same predicate).
        if X64BodyStoreElidableAt(bodyIR, opIndex):
            binBytes = binBytes - tgtAcc
        return binBytes
    if op.kind == coreir.BodyOpCmpTag:
        let cmpKind = X64BodyCmpKind(bodyIR, op)
        if cmpKind == 0:
            return 0
        # S5: fused Cmp->Cbr — setcc(4)+movzx8(4)+bool store(8) dropped, leaving just
        # lhsLoad(8) + rhsLoad(8) + cmp core(3). S1 lhs-reload elision still applies.
        # segment-a: per-slot access (I32 7B, else 8B); cmp/setcc/movzx cores keep REX.
        # segment-d1: the Cmp filler routes lhs/rhs/target loads+store through the disp8
        # chokepoint (ResLoadD8/ResStoreD8), so each access is 4/5/7/8 by ...ForSlotDisp.
        let cmpLhsAcc = X64BodySlotAccessBytesForSlotDisp(bodyIR, op.operands[1])
        let cmpRhsAcc = X64BodySlotAccessBytesForSlotDisp(bodyIR, op.operands[2])
        if cmpKind == 2:
            # Raw stack-class bits -> RAX/RCX, MOVQ -> XMM0/XMM1, UCOMISD.
            # F64 is deliberately excluded from GPR residency/S1, so both loads
            # are mandatory and the pre-predicate core is exactly 14 bytes.
            if X64BodyCmpFusedAt(bodyIR, opIndex):
                return cmpLhsAcc + cmpRhsAcc + 14
            let f64PredicateBytes = X64BodyF64PredicateByteCount(op.operands[0])
            if f64PredicateBytes <= 0:
                return 0
            let cmpTgtAcc = X64BodySlotAccessBytesForSlotDisp(bodyIR, op.target)
            var f64CmpBytes = cmpLhsAcc + cmpRhsAcc + 14 +
                              f64PredicateBytes + cmpTgtAcc
            if X64BodyStoreElidableAt(bodyIR, opIndex):
                f64CmpBytes = f64CmpBytes - cmpTgtAcc
            return f64CmpBytes
        if X64BodyCmpFusedAt(bodyIR, opIndex):
            var fusedBytes = cmpLhsAcc + cmpRhsAcc + 3
            if X64BodyLhsReloadElidableAt(bodyIR, opIndex):
                fusedBytes = fusedBytes - cmpLhsAcc
            return fusedBytes
        # lhsLoad + rhsLoad + core(11) + resultStore. The bool store target is I32 => 7B.
        let cmpTgtAcc = X64BodySlotAccessBytesForSlotDisp(bodyIR, op.target)
        var cmpBytes = cmpLhsAcc + cmpRhsAcc + 11 + cmpTgtAcc
        # S1: drop the lhs reload when it is already resident in RAX (mirrored by
        # x64BodyFillCmpOp via the same predicate).
        if X64BodyLhsReloadElidableAt(bodyIR, opIndex):
            cmpBytes = cmpBytes - cmpLhsAcc
        # S2: drop the result store when S is a single-use temp consumed straight out
        # of RAX by the next op (mirrored by x64BodyFillCmpOp via the same predicate).
        if X64BodyStoreElidableAt(bodyIR, opIndex):
            cmpBytes = cmpBytes - cmpTgtAcc
        return cmpBytes
    if op.kind == coreir.BodyOpStrEqLiteralTag:
        return X64BodyStrEqLiteralByteCount(bodyIR, op)
    if op.kind == coreir.BodyOpGlobalLoadTag ||
       op.kind == coreir.BodyOpGlobalStoreTag:
        if op.operands.len < 1 ||
           op.operands[0] < 0 ||
           op.operands[0] >= bodyIR.localSlots.len:
            return 0
        if op.target < 0 || op.target >= bodyIR.localSlots.len:
            return 0
        if op.kind == coreir.BodyOpGlobalLoadTag &&
           op.operands.len >= 2 &&
           op.operands[1] == 1:
            # Address-only global load: lea rip + store ptr to target.
            if bodyIR.localSlots[op.target].typeKind != coreir.LocalPtrTag:
                return 0
            # segment-d1: leaRip(8) + ptr store via the disp8-capable chokepoint (5/8).
            return 8 + X64BodySlotAccessBytesForSlotDisp(bodyIR, op.target)
        let globalType = bodyIR.localSlots[op.operands[0]].typeKind
        if globalType != coreir.LocalI32Tag &&
           globalType != coreir.LocalI64Tag &&
           globalType != coreir.LocalPtrTag &&
           globalType != coreir.LocalStrTag &&
           !(globalType == coreir.LocalAggregateTag &&
             op.kind == coreir.BodyOpGlobalStoreTag):
            return 0
        if bodyIR.localSlots[op.target].typeKind != globalType:
            return 0
        if globalType == coreir.LocalStrTag:
            let byteCount = x64BodySlotSizeOf(bodyIR.localSlots[op.operands[0]])
            if byteCount <= 0:
                return 0
            let copyBytes = X64BodyCopyMemoryByteCount(byteCount)
            if copyBytes <= 0:
                return copyBytes
            return X64BodyCheckedAddNonNegative(16, copyBytes)
        if globalType == coreir.LocalAggregateTag:
            let aggByteCount = x64BodySlotSizeOf(bodyIR.localSlots[op.operands[0]])
            if aggByteCount <= 0 ||
               x64BodySlotSizeOf(bodyIR.localSlots[op.target]) != aggByteCount:
                return 0
            let aggCopyBytes = X64BodyCopyMemoryByteCount(aggByteCount)
            if aggCopyBytes <= 0:
                return aggCopyBytes
            return X64BodyCheckedAddNonNegative(16, aggCopyBytes)
        # segment-a: leaRip(8) + global value access via R10 (8, keeps REX) + the LOCAL
        # scalar access (store target on load / load target on store) which is 7B for I32.
        # segment-d1: the LOCAL scalar access routes through the disp8-capable chokepoint
        # (4/5/7/8); the R10 global value access (disp=0) stays disp32 inside the fixed 16.
        return 16 + X64BodySlotAccessBytesForSlotDisp(bodyIR, op.target)
    if op.kind == coreir.BodyOpIndexedLoadTag ||
       op.kind == coreir.BodyOpIndexedStoreTag:
        if op.operands.len < 2:
            return 0
        if X64BodyIndexedIsSibForm(bodyIR, op):
            let elemSize = op.operands[3]
            let sibScaleLog = X64BodyIndexedSibScaleLog(elemSize)
            var scaleBytes = 0
            if sibScaleLog < 0:
                scaleBytes = X64BodyIndexedScaleByteCount(elemSize)
                if scaleBytes <= 0:
                    return 0
            var baseBytes = 8
            if op.operands.len >= 5 && op.operands[4] == 1:
                baseBytes = baseBytes + 8
            # segment-a: base load keeps REX (lea/load64=8B); the index load is 7B for I32.
            # segment-s6: elemSize 1/4/8 fold base+index*scale into the element access via a
            # ModRM+SIB byte (scaleBytes=0, no imul/shl+add). Element bytes: load8=movzx SIB 5,
            # load32 SIB 3, load64 SIB 4, store8/store32 SIB 3, store64 SIB 4. Non-SIB sizes
            # (aggregate-copy multiples of 4 / str-24 / arbitrary) keep the imul+add path.
            let idxAcc = X64BodySlotAccessBytesForSlot(bodyIR, op.operands[2])
            let addressBytes = baseBytes + idxAcc + scaleBytes
            let idxValAcc = X64BodySlotAccessBytesForSlot(bodyIR, op.operands[1])
            if op.kind == coreir.BodyOpIndexedLoadTag:
                if elemSize == 1:
                    return addressBytes + 5 + idxValAcc
                if elemSize == 4:
                    return addressBytes + 3 + idxValAcc
                if elemSize == 8:
                    return addressBytes + 4 + 8
                let aggCopyLoad = X64BodyIndexedAggregateValueCopyBytes(bodyIR, op.operands[1], elemSize)
                if aggCopyLoad > 0:
                    let addressAndBase = X64BodyCheckedAddNonNegative(addressBytes, 8)
                    return X64BodyCheckedAddNonNegative(addressAndBase, aggCopyLoad)
                if elemSize == 24:
                    if op.operands[1] < 0 ||
                       op.operands[1] >= bodyIR.localSlots.len ||
                       bodyIR.localSlots[op.operands[1]].typeKind != coreir.LocalStrTag:
                        return 0
                    return addressBytes + 8 + 48
                return 0
            if elemSize == 1 || elemSize == 4:
                return addressBytes + idxValAcc + 3
            if elemSize == 8:
                return addressBytes + 8 + 4
            let aggCopyStore = X64BodyIndexedAggregateValueCopyBytes(bodyIR, op.operands[1], elemSize)
            if aggCopyStore > 0:
                let addressAndBase = X64BodyCheckedAddNonNegative(addressBytes, 8)
                return X64BodyCheckedAddNonNegative(addressAndBase, aggCopyStore)
            if elemSize == 24:
                let valueType = x64BodySlotType(bodyIR, op.operands[1])
                if valueType == coreir.LocalPtrTag:
                    return addressBytes + 8 + 24
                if valueType == coreir.LocalStrTag:
                    return addressBytes + 8 + 48
                return 0
            return 0
        # segment-a: non-aggregate (ptr-based) scalar indexed = base ptr load64(8) +
        # element access via base RAX (7B I32 / 8B) + slot access (7B I32 / 8B). Both
        # the element and slot access are 7B for an I32 value.
        return 8 + 2 * X64BodySlotAccessBytesForSlot(bodyIR, op.operands[1])
    if op.kind == coreir.BodyOpFieldLoadTag ||
       op.kind == coreir.BodyOpFieldStoreTag:
        if op.operands.len < 3:
            return 0
        let baseSlot = op.operands[0]
        let valueSlot = op.operands[1]
        let byteOffset = op.operands[2]
        var byteCount = 0
        if op.operands.len >= 4:
            byteCount = op.operands[3]
        if baseSlot < 0 || baseSlot >= bodyIR.localSlots.len ||
           valueSlot < 0 || valueSlot >= bodyIR.localSlots.len ||
           byteOffset < 0:
            return 0
        if byteCount <= 0:
            byteCount = 8
        let slotSize = x64BodySlotSizeOf(bodyIR.localSlots[valueSlot])
        if slotSize > 0 && slotSize < byteCount:
            return 0
        if op.kind == coreir.BodyOpFieldLoadTag && op.target != valueSlot:
            return 0
        if op.kind == coreir.BodyOpFieldStoreTag && op.target != baseSlot:
            return 0
        let valueOffset = X64BodyLocalStackOffset(bodyIR, valueSlot, X64BodyParamSaveOffset(bodyIR))
        if valueOffset < 0:
            return 0
        var baseBytes: int32
        let baseType = bodyIR.localSlots[baseSlot].typeKind
        if op.kind == coreir.BodyOpFieldLoadTag && baseType == coreir.LocalStrTag:
            baseBytes = 8
        elif baseType == coreir.LocalPtrTag:
            baseBytes = 8
        elif (baseType == coreir.LocalStrTag ||
              baseType == coreir.LocalAggregateTag) &&
             x64BodyLocalIsParam(bodyIR.localSlots[baseSlot]):
            # aggregate/str param slot holds the incoming address: indirect.
            baseBytes = 8
        else:
            let baseOffset = X64BodyLocalStackOffset(bodyIR, baseSlot, X64BodyParamSaveOffset(bodyIR))
            if baseOffset < 0:
                return 0
            let baseSize = x64BodySlotSizeOf(bodyIR.localSlots[baseSlot])
            if baseSize > 0 && byteOffset > baseSize - byteCount:
                return 0
        # FieldStore whose copied VALUE is a str/aggregate param needs one extra
        # load64 (8B) to deref the incoming record pointer (fill-side mirror).
        # The FieldLoad sub-word movzx arm is byte-neutral (17 = 9+8), no term.
        var storeValueBytes = 0
        if op.kind == coreir.BodyOpFieldStoreTag &&
           (bodyIR.localSlots[valueSlot].typeKind == coreir.LocalStrTag ||
            bodyIR.localSlots[valueSlot].typeKind == coreir.LocalAggregateTag) &&
           x64BodyLocalIsParam(bodyIR.localSlots[valueSlot]):
            storeValueBytes = 8
        let copyBytes = X64BodyCopyMemoryByteCount(byteCount)
        let prefixBytes = X64BodyCheckedAddNonNegative(baseBytes, storeValueBytes)
        if copyBytes <= 0 || prefixBytes < 0:
            return -1
        return X64BodyCheckedAddNonNegative(prefixBytes, copyBytes)
    if op.kind == coreir.BodyOpLoadLocalTag:
        if op.operands.len >= 3 &&
           op.operands[0] == coreir.BodyLoadLocalStrIndexU8Tag:
            if op.operands[1] < 0 || op.operands[1] >= bodyIR.localSlots.len ||
               op.operands[2] < 0 || op.operands[2] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return 0
            # segment-a: strAddr(8)+idxLoad+load64(8)+add(3)+load8(9)+targetStore. The
            # index and byte-value target slots are I32 => REX-free 7B accesses => 42.
            return 28 + X64BodySlotAccessBytesForSlot(bodyIR, op.operands[2]) +
                   X64BodySlotAccessBytesForSlot(bodyIR, op.target)
        if op.operands.len >= 3 &&
           (op.operands[0] == coreir.BodyLoadLocalPtrDerefI32Tag ||
            op.operands[0] == coreir.BodyLoadLocalPtrDerefU8Tag ||
            op.operands[0] == coreir.BodyLoadLocalPtrDerefU64Tag):
            if op.operands.len < 2 || op.target < 0 || op.target >= bodyIR.localSlots.len:
                return 0
            # segment-a: ptr load64(8) + deref load + target store.
            if op.operands[0] == coreir.BodyLoadLocalPtrDerefU8Tag:
                # movzx8(9, keeps REX) + target store.
                return 17 + X64BodySlotAccessBytesForSlot(bodyIR, op.target)
            if op.operands[0] == coreir.BodyLoadLocalPtrDerefU64Tag:
                # load64(8) + store64(8) = 24.
                return 24
            # PtrDerefI32: load32 via base RAX (7) + target store.
            return 15 + X64BodySlotAccessBytesForSlot(bodyIR, op.target)
        if op.operands.len >= 2 &&
           op.operands[0] == coreir.BodyLoadLocalAddressTag:
            if op.operands[1] < 0 || op.operands[1] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return 0
            # segment-d1.2: leaStack(&operands[1]) narrows disp8 -> 5B / disp32 -> 8B. The
            # lea is ALWAYS the 64-bit REX.W form regardless of the addressed slot's type,
            # so its byte count keys off the raw frame disp, not ...ForSlotDisp(operands[1]).
            # The ptr store to target routes through the disp8-capable chokepoint (5/8),
            # mirroring x64bLeaStackAuto + x64BodyStoreRegToSlotD8.
            var addrLeaBytes = 8
            if x64bDispIsShort(X64BodyLocalStackOffset(bodyIR, op.operands[1], X64BodyParamSaveOffset(bodyIR))):
                addrLeaBytes = 5
            return addrLeaBytes + X64BodySlotAccessBytesForSlotDisp(bodyIR, op.target)
        if op.operands.len >= 2 &&
           op.operands[0] == coreir.BodyLoadLocalCStringTag:
            if op.operands[1] < 0 || op.operands[1] >= bodyIR.cstringLiterals.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return 0
            # segment-d1.2: leaRip (rip-relative, always disp32 -> fixed 8) + ptr store to
            # target via the disp8-capable chokepoint (5/8).
            return 8 + X64BodySlotAccessBytesForSlotDisp(bodyIR, op.target)
        if op.operands.len >= 1:
            if op.operands[0] < 0 || op.operands[0] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return 0
            # segment-d12: the LoadLocal plain-copy fallback shares x64BodyFillCopySlot, so
            # a local inline aggregate copy narrows per chunk to disp8. Mirror it; other
            # shapes (scalar-single / movsxd / param) fall to CopySlotByteCount.
            let llAggBytes = X64BodyCopyLocalInlineBytesDisp(bodyIR, op.operands[0], op.target, X64BodyParamSaveOffset(bodyIR))
            if llAggBytes >= 0:
                return llAggBytes
            return X64BodyCopySlotByteCount(bodyIR, op.operands[0], op.target)
        return 0
    if op.kind == coreir.BodyOpBranchTag:
        if op.operands.len >= 3:
            let subKind = op.operands[0]
            let guardSlot = op.operands[1]
            if guardSlot < 0 || guardSlot >= bodyIR.localSlots.len:
                return 0
            if X64BodyLoadSlotWordCount(bodyIR, guardSlot) <= 0:
                return 0
            if subKind == coreir.BodyBranchIfLocalNilReturnI32ConstTag:
                return 33
            if subKind == coreir.BodyBranchIfLocalLeZeroReturnI32ConstTag:
                return 37
            if subKind == coreir.BodyBranchIfLocalLeZeroReturnCallNoargTag:
                return 41
            if subKind == coreir.BodyBranchIfLocalLeZeroCallArg0ReturnI32ConstTag:
                if op.operands.len < 4:
                    return 0
                let arg0Slot = op.operands[2]
                if arg0Slot < 0 || arg0Slot >= bodyIR.localSlots.len:
                    return 0
                if X64BodyLoadSlotWordCount(bodyIR, arg0Slot) <= 0:
                    return 0
                return 56
        return 0
    if op.kind == coreir.BodyOpStrEqTag:
        return X64BodyStrEqByteCount(bodyIR, op)
    return 0

# segment-b: byte-granular layout. Op size is the exact filler byte count (no
# word round-up); block starts / reloc offsets / branch targets are all byte
# offsets. Functions stay 4-byte aligned (X64BodyFillWords pads the function
# TAIL to a word), so the physical int32[] words buffer and functionWordOffsets
# remain word-granular.
@borrows
fn X64BodyOpSizeAt(bodyIR: coreir.BodyIR, opIndex: int32): int32 =
    return X64BodyOpByteCount(bodyIR, opIndex)

@borrows
fn X64BodyOpRangeSize(bodyIR: coreir.BodyIR, opStart: int32, opEnd: int32): int32 =
    if opStart < 0 || opEnd < opStart || opEnd > bodyIR.ops.len:
        return -1
    var total: int32
    var oi = opStart
    while oi < opEnd:
        let opSize = X64BodyOpSizeAt(bodyIR, oi)
        if opSize <= 0:
            return -1
        total = X64BodyCheckedAddNonNegative(total, opSize)
        if total < 0:
            return -1
        oi = oi + 1
    return total

# Number of load/store instruction PAIRS to copy exactly `byteCount` bytes of an
# sret aggregate/str return: 8-byte chunks when 8-aligned (str=24B→3,
# Result[str]=64B→8), else 4-byte chunks (Row 12B→3, Body 20B→5). Mirrors
# arm64 PrimaryReturnSretCopyPairCount — a precise count is mandatory, rounding
# up to 8-byte chunks over-writes the caller's adjacent tightly-packed slot.
fn X64ReturnSretCopyPairCount(byteCount: int32): int32 =
    if byteCount <= 0:
        return 0
    if byteCount % 8 == 0:
        return byteCount / 8
    if byteCount % 4 == 0:
        return byteCount / 4
    return byteCount

fn X64ReturnSretCopyIs64(byteCount: int32): bool =
    return byteCount % 8 == 0

fn X64ReturnSretCopyStride(byteCount: int32): int32 =
    if byteCount <= 0:
        return 0
    if byteCount % 8 == 0:
        return 8
    if byteCount % 4 == 0:
        return 4
    return 1

# segment-b: exact filler byte count (mirrors x64BodyFillBlockTerm* 1:1). Was a
# word-rounded upper bound absorbed by the outer term pad; now byte-exact since
# the fill driver no longer pads.
@borrows
fn X64BodyTermSize(bodyIR: coreir.BodyIR, termIndex: int32): int32 =
    if termIndex < 0 || termIndex >= bodyIR.terms.len:
        return 0
    let term = bodyIR.terms[termIndex]
    if term.kind == coreir.BodyTermCbrTag:
        # S5: fused Cbr. Integer flags need jcc then jmp (11B). Four F64
        # predicates also route PF to the ordered or unordered target (17B);
        # greater-than and greater-or-equal remain 11B.
        if X64BodyCbrFusedAt(bodyIR, termIndex):
            let fusedBlockIndex = x64BodyTermBlockIndexOf(bodyIR, termIndex)
            if fusedBlockIndex < 0:
                return 0
            let fusedBlock = bodyIR.blocks[fusedBlockIndex]
            let fusedCmp = bodyIR.ops[fusedBlock.opStart + fusedBlock.opCount - 1]
            if X64BodyCmpKind(bodyIR, fusedCmp) == 2:
                return X64BodyF64FusedBranchByteCount(fusedCmp.operands[0])
            return 11
        # non-fused: guard load + compare core + jcc(6)+jmp(5)=11. segment-a: the guard
        # and rhs slot loads are 7B for I32 (no REX) else 8B; cmpImm32/cmpRR keep REX.
        #   LocalNonZero/Zero   -> guard + cmpImm32(7) + 11
        #   I32Eq..U64Ge rhs>=0 -> guard + rhsLoad + cmpRR(3) + 11
        #   I32Eq..U64Ge rhs<0  -> guard + cmpImm32(7) + 11
        var cbrLhsSlot = term.lhsSlot
        if cbrLhsSlot < 0:
            cbrLhsSlot = term.resultSlot
        let cbrGuardAcc = X64BodySlotAccessBytesForSlot(bodyIR, cbrLhsSlot)
        if term.conditionKind == coreir.BodyCondLocalNonZeroTag ||
           term.conditionKind == coreir.BodyCondLocalZeroTag:
            return cbrGuardAcc + 7 + 11
        if term.conditionKind >= coreir.BodyCondI32EqTag &&
           term.conditionKind <= coreir.BodyCondU64GeTag:
            if term.rhsSlot >= 0:
                return cbrGuardAcc + X64BodySlotAccessBytesForSlot(bodyIR, term.rhsSlot) + 3 + 11
            return cbrGuardAcc + 7 + 11
        return 0
    if term.kind == coreir.BodyTermBrTag:
        # jmp rel32 = 5B.
        return 5
    if term.kind == coreir.BodyTermReturnTag:
        if term.resultSlot < 0 &&
           term.operands.len >= 1 &&
           term.operands[0] == coreir.LocalInvalidTag:
            # void return: epilogue only (add rsp/pop rbp/ret) = 9B.
            return X64BodyEpilogueBytes
        if term.resultSlot >= 0 && term.resultSlot < bodyIR.localSlots.len:
            let resultType = bodyIR.localSlots[term.resultSlot].typeKind
            if resultType == coreir.LocalStrTag ||
               resultType == coreir.LocalAggregateTag:
                let retCopyBytes = x64BodySlotSizeOf(bodyIR.localSlots[term.resultSlot])
                let retCopyPairs = X64ReturnSretCopyPairCount(retCopyBytes)
                if retCopyPairs <= 0:
                    return 0
                # load dst ptr(8) + retCopyPairs*(load+store) + mov(3) + epilogue(9) = 20 + pairs*perPair.
                # segment-a: 8-byte chunks are load64+store64=16; 4-byte chunks are
                # load32+store32=14 (REX-free).
                let retCopyStride = X64ReturnSretCopyStride(retCopyBytes)
                var retPerPair = 16
                if retCopyStride == 4:
                    retPerPair = 14
                var retPairBytes: int32
                if retPerPair == 16:
                    retPairBytes = x64BodyCheckedMul16(retCopyPairs)
                else:
                    retPairBytes = x64BodyCheckedMul14(retCopyPairs)
                var retTermBytes = X64BodyCheckedAddNonNegative(20,
                                                                 retPairBytes)
                if retTermBytes < 0:
                    return 0
                # str/aggregate PARAM return homes the incoming record POINTER, so
                # `return s` derefs it first (one extra 8-byte load).
                if x64BodyLocalIsParam(bodyIR.localSlots[term.resultSlot]):
                    retTermBytes = X64BodyCheckedAddNonNegative(retTermBytes, 8)
                return retTermBytes
            if X64BodyLoadSlotWordCount(bodyIR, term.resultSlot) <= 0:
                return 0
            # segment-a: load(7B I32 / 8B else)+epilogue(9).
            var f64BridgeBytes = 0
            if resultType == coreir.LocalF64Tag:
                f64BridgeBytes = X64BodyF64ReturnBridgeBytes
            let scalarReturnBytes = X64BodyCheckedAddNonNegative(
                X64BodySlotAccessBytesForSlot(bodyIR, term.resultSlot),
                X64BodyEpilogueBytes)
            return X64BodyCheckedAddNonNegative(scalarReturnBytes,
                                                f64BridgeBytes)
        # immediate int return: movImm32(7)+epilogue(9)=16B.
        return 16
    return 0

@borrows
fn X64BodyBlockSize(bodyIR: coreir.BodyIR, blockIndex: int32): int32 =
    if blockIndex < 0 || blockIndex >= bodyIR.blocks.len:
        return 0
    let block = bodyIR.blocks[blockIndex]
    let opEnd = X64BodyCheckedAddNonNegative(block.opStart, block.opCount)
    if opEnd < 0:
        return 0
    let opSize = X64BodyOpRangeSize(bodyIR, block.opStart, opEnd)
    let termSize = X64BodyTermSize(bodyIR, block.termIndex)
    if opSize < 0 || termSize <= 0:
        return 0
    return X64BodyCheckedAddNonNegative(opSize, termSize)

@borrows
fn X64BodyPrologueByteCount(bodyIR: coreir.BodyIR): int32 =
    let paramCount = X64BodyParamCount(bodyIR)
    if paramCount < 0:
        return -1
    let regAvail = X64BodyRegParamAvail(bodyIR)
    var regSave = paramCount
    if regSave > regAvail:
        regSave = regAvail
    let stackCopy = paramCount - regSave
    let regSaveBytes = X64BodyCheckedMul8(regSave)
    let stackCopyBytes = x64BodyCheckedMul16(stackCopy)
    let fixedAndReg = X64BodyCheckedAddNonNegative(19, regSaveBytes)
    return X64BodyCheckedAddNonNegative(fixedAndReg, stackCopyBytes)

@borrows
fn X64BodyPrologueWordCount(bodyIR: coreir.BodyIR): int32 =
    return X64BodyWordsOfChecked(X64BodyPrologueByteCount(bodyIR))

@borrows
fn X64BodyBlockStart(bodyIR: coreir.BodyIR, blockIndex: int32): int32 =
    if !bodyIR.x64BlockStartReady ||
       bodyIR.x64BlockByteStart.len != bodyIR.blocks.len:
        panic("x64 stack block layout is not prepared")
    if blockIndex < 0 || blockIndex >= bodyIR.x64BlockByteStart.len:
        return -1
    return bodyIR.x64BlockByteStart[blockIndex]

@borrows
fn x64BodyBlockStartOrNext(bodyIR: coreir.BodyIR, blockIndex: int32, nextWord: int32): int32 =
    if blockIndex >= 0 && blockIndex < bodyIR.blocks.len:
        return X64BodyBlockStart(bodyIR, blockIndex)
    return nextWord

# segment-b: total BYTE size summed, returned as the WORD count the function
# occupies (tail padded to a word boundary so the next function stays aligned).
@borrows
fn X64BodyIrWordCount(bodyIR: coreir.BodyIR): int32 =
    if !X64BodyProductionAdmission(bodyIR):
        return 0
    if !bodyIR.x64StackLayoutReady || !bodyIR.x64BlockStartReady ||
       bodyIR.x64SlotReadCnt.len != bodyIR.localSlots.len ||
       bodyIR.x64BlockByteStart.len != bodyIR.blocks.len:
        panic("x64 stack layout is not prepared")
    if bodyIR.blocks.len <= 0:
        return 0
    var count = X64BodyPrologueByteCount(bodyIR)
    if count <= 0:
        return 0
    for blockIndex in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockIndex]
        if block.opStart < 0 ||
           block.opCount < 0 ||
           block.opStart > bodyIR.ops.len - block.opCount:
            return 0
        let opEnd = block.opStart + block.opCount
        for opIndex in block.opStart..<opEnd:
            let opSize = X64BodyOpSizeAt(bodyIR, opIndex)
            if opSize <= 0:
                return 0
            count = X64BodyCheckedAddNonNegative(count, opSize)
            if count < 0:
                return 0
        let termSize = X64BodyTermSize(bodyIR, block.termIndex)
        if termSize <= 0:
            return 0
        count = X64BodyCheckedAddNonNegative(count, termSize)
        if count < 0:
            return 0
    return X64BodyWordsOfChecked(count)

# word offset (function-relative) of the rel32 placeholder of call ordinal N
@borrows
fn X64BodyRelocWordOffset(bodyIR: coreir.BodyIR, callOrdinal: int32): int32 =
    if callOrdinal < 0:
        return -1
    var seenCall: int32
    for bi in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[bi]
        if block.opStart < 0 || block.opCount < 0:
            return -1
        var wordPos = X64BodyBlockStart(bodyIR, bi)
        let opEnd = block.opStart + block.opCount
        if opEnd > bodyIR.ops.len:
            return -1
        for oi in block.opStart..<opEnd:
            let op = bodyIR.ops[oi]
            if op.kind == coreir.BodyOpCallTag:
                if seenCall == callOrdinal:
                    let call = bodyIR.callSequence[callOrdinal]
                    if x64BodyInlineAtomicKind(call) > 0:
                        return -1
                    let relOffset = X64BodyCallRelWordOffset(bodyIR, op)
                    if relOffset < 0:
                        return -1
                    return wordPos + relOffset
                seenCall = seenCall + 1
            wordPos = wordPos + X64BodyOpSizeAt(bodyIR, oi)
    return -1

# ---------- cond mapping ----------

fn X64BodyCondTrueCC(condTag: int32): int32 =
    if condTag == coreir.BodyCondI32EqTag ||
       condTag == coreir.BodyCondI64EqTag:
        return X64BodyCcE
    if condTag == coreir.BodyCondI32NeTag ||
       condTag == coreir.BodyCondI64NeTag:
        return X64BodyCcNe
    if condTag == coreir.BodyCondI32LtTag ||
       condTag == coreir.BodyCondI64LtTag:
        return X64BodyCcL
    if condTag == coreir.BodyCondI32LeTag ||
       condTag == coreir.BodyCondI64LeTag:
        return X64BodyCcLe
    if condTag == coreir.BodyCondI32GtTag ||
       condTag == coreir.BodyCondI64GtTag:
        return X64BodyCcG
    if condTag == coreir.BodyCondI32GeTag ||
       condTag == coreir.BodyCondI64GeTag:
        return X64BodyCcGe
    # Unsigned ordering: b/ae/be/a instead of l/ge/le/g.
    if condTag == coreir.BodyCondU32LtTag ||
       condTag == coreir.BodyCondU64LtTag:
        return X64BodyCcB
    if condTag == coreir.BodyCondU32LeTag ||
       condTag == coreir.BodyCondU64LeTag:
        return X64BodyCcBe
    if condTag == coreir.BodyCondU32GtTag ||
       condTag == coreir.BodyCondU64GtTag:
        return X64BodyCcA
    if condTag == coreir.BodyCondU32GeTag ||
       condTag == coreir.BodyCondU64GeTag:
        return X64BodyCcAe
    if condTag == coreir.BodyCondLocalNonZeroTag:
        return X64BodyCcNe
    if condTag == coreir.BodyCondLocalZeroTag:
        return X64BodyCcE
    return -1

fn X64BodyCondIsF64(condTag: int32): bool =
    return condTag >= coreir.BodyCondF64EqTag &&
           condTag <= coreir.BodyCondF64GeTag

# Base SETcc or Jcc after UCOMISD. The first four predicates need an explicit PF predicate
# because unordered sets ZF=PF=CF=1; Gt(A) and Ge(AE) already reject it.
fn X64BodyF64BaseCC(condTag: int32): int32 =
    if condTag == coreir.BodyCondF64EqTag:
        return X64BodyCcE
    if condTag == coreir.BodyCondF64NeTag:
        return X64BodyCcNe
    if condTag == coreir.BodyCondF64LtTag:
        return X64BodyCcB
    if condTag == coreir.BodyCondF64LeTag:
        return X64BodyCcBe
    if condTag == coreir.BodyCondF64GtTag:
        return X64BodyCcA
    if condTag == coreir.BodyCondF64GeTag:
        return X64BodyCcAe
    return -1

fn X64BodyF64PredicateByteCount(condTag: int32): int32 =
    if X64BodyF64BaseCC(condTag) < 0:
        return 0
    if condTag == coreir.BodyCondF64GtTag ||
       condTag == coreir.BodyCondF64GeTag:
        return 8                     # setcc + movzx
    return 15                        # two setcc, byte combine, then movzx

@borrows
fn X64BodyF64FusedBranchByteCount(condTag: int32): int32 =
    if X64BodyF64BaseCC(condTag) < 0:
        return 0
    if condTag == coreir.BodyCondF64GtTag ||
       condTag == coreir.BodyCondF64GeTag:
        return 11                    # jcc true + jmp false
    return 17                        # jp to parity target, then jcc and jmp

# 0=invalid, 1=integer/pointer comparison, 2=F64 comparison. This is the
# admission source of truth shared by sizing, filling and Cmp->Cbr fusion.
@borrows
fn X64BodyCmpKind(bodyIR: coreir.BodyIR, op: coreir.BodyOp): int32 =
    if op.kind != coreir.BodyOpCmpTag || op.operands.len != 3:
        return 0
    if op.target < 0 || op.target >= bodyIR.localSlots.len ||
       bodyIR.localSlots[op.target].typeKind != coreir.LocalI32Tag:
        return 0
    let lhsSlot = op.operands[1]
    let rhsSlot = op.operands[2]
    if lhsSlot < 0 || lhsSlot >= bodyIR.localSlots.len ||
       rhsSlot < 0 || rhsSlot >= bodyIR.localSlots.len:
        return 0
    let lhsType = bodyIR.localSlots[lhsSlot].typeKind
    let rhsType = bodyIR.localSlots[rhsSlot].typeKind
    if X64BodyCondIsF64(op.operands[0]):
        if lhsType == coreir.LocalF64Tag && rhsType == coreir.LocalF64Tag:
            return 2
        return 0
    if op.operands[0] < coreir.BodyCondI32EqTag ||
       op.operands[0] > coreir.BodyCondU64GeTag ||
       X64BodyCondTrueCC(op.operands[0]) < 0:
        return 0
    if lhsType == coreir.LocalF64Tag || rhsType == coreir.LocalF64Tag:
        return 0
    return 1

fn x64BodyFillF64Predicate(words: var int32[], posRaw: int32,
                           condTag: int32): int32 =
    let baseCC = X64BodyF64BaseCC(condTag)
    if baseCC < 0:
        return -1
    var pos = x64bSetcc(words, posRaw, baseCC, X64BodyRAX)
    if condTag == coreir.BodyCondF64GtTag ||
       condTag == coreir.BodyCondF64GeTag:
        return x64bMovzx8RR(words, pos, X64BodyRAX, X64BodyRAX)
    var parityCC = X64BodyCcNp
    if condTag == coreir.BodyCondF64NeTag:
        parityCC = X64BodyCcP
    pos = x64bSetcc(words, pos, parityCC, X64BodyRCX)
    if condTag == coreir.BodyCondF64NeTag:
        pos = x64bOr8RR(words, pos, X64BodyRAX, X64BodyRCX)
    else:
        pos = x64bAnd8RR(words, pos, X64BodyRAX, X64BodyRCX)
    return x64bMovzx8RR(words, pos, X64BodyRAX, X64BodyRAX)

fn x64BodyFillF64FusedBranch(words: var int32[], posRaw: int32,
                             condTag: int32,
                             trueByte: int32,
                             falseByte: int32): int32 =
    let baseCC = X64BodyF64BaseCC(condTag)
    if baseCC < 0:
        return -1
    var pos = posRaw
    if condTag != coreir.BodyCondF64GtTag &&
       condTag != coreir.BodyCondF64GeTag:
        var parityTarget = falseByte
        if condTag == coreir.BodyCondF64NeTag:
            parityTarget = trueByte
        pos = x64bJccRel32(words, pos, X64BodyCcP,
                           parityTarget - (pos + 6))
        if pos < 0:
            return -1
    pos = x64bJccRel32(words, pos, baseCC, trueByte - (pos + 6))
    if pos < 0:
        return -1
    return x64bJmpRel32(words, pos, falseByte - (pos + 5))

# ---------- op fills ----------

@borrows
fn x64BodyFillStrEqLiteralOp(words: var int32[],
                             posRaw: int32,
                             bodyIR: coreir.BodyIR,
                             op: coreir.BodyOp,
                             paramSaveOffset: int32): int32 =
    let byteCount = X64BodyStrEqLiteralByteCount(bodyIR, op)
    if byteCount <= 0 || posRaw < 0:
        return -1
    let literalLen = len(bodyIR.cstringLiterals[op.operands[1]].text)
    let loopPos = posRaw + 55
    let equalPos = posRaw + 105
    let donePos = posRaw + 108
    # First group is the literal-data LEA-RIP; its rel32 field is posRaw+4.
    var pos = x64bLeaRipGroup(words, posRaw, X64BodyRSI)
    pos = x64BodyLoadStrValueAddressToReg(words, pos, bodyIR, op.operands[0], X64BodyRAX, paramSaveOffset)
    pos = x64bLoad64(words, pos, X64BodyRCX, X64BodyRAX, 0)
    pos = x64bLoad32Rex(words, pos, X64BodyRDX, X64BodyRAX, 8)
    pos = x64bMovImm32(words, pos, X64BodyR10, 1, true)
    pos = x64bXorRR(words, pos, X64BodyR11, X64BodyR11, false)
    pos = x64bCmpImm32(words, pos, X64BodyRDX, literalLen, false)
    if pos < 0:
        return -1
    pos = x64bJccRel32(words, pos, X64BodyCcNe, donePos - (pos + 6))
    if pos != loopPos:
        return -1
    pos = x64bTestRR(words, pos, X64BodyRDX, X64BodyRDX, false)
    pos = x64bJccRel32(words, pos, X64BodyCcE, equalPos - (pos + 6))
    pos = x64bLoad8(words, pos, X64BodyRAX, X64BodyRCX, 0)
    pos = x64bLoad8(words, pos, X64BodyRDI, X64BodyRSI, 0)
    pos = x64bCmpRR(words, pos, X64BodyRAX, X64BodyRDI, false)
    if pos < 0:
        return -1
    pos = x64bJccRel32(words, pos, X64BodyCcNe, donePos - (pos + 6))
    pos = x64bAddRR(words, pos, X64BodyRCX, X64BodyR10, true)
    pos = x64bAddRR(words, pos, X64BodyRSI, X64BodyR10, true)
    pos = x64bSubRR(words, pos, X64BodyRDX, X64BodyR10, false)
    if pos < 0:
        return -1
    pos = x64bJmpRel32(words, pos, loopPos - (pos + 5))
    if pos != equalPos:
        return -1
    pos = x64bMovRR(words, pos, X64BodyR11, X64BodyR10, false)
    if pos != donePos:
        return -1
    return x64BodyStoreI32SlotRex(words, pos, bodyIR, op.target, X64BodyR11, paramSaveOffset)

@borrows
fn x64BodyFillStrEqOp(words: var int32[],
                      posRaw: int32,
                      bodyIR: coreir.BodyIR,
                      op: coreir.BodyOp,
                      paramSaveOffset: int32): int32 =
    let byteCount = X64BodyStrEqByteCount(bodyIR, op)
    if byteCount <= 0 || posRaw < 0:
        return -1
    let loopPos = posRaw + 64
    let equalPos = posRaw + 114
    let donePos = posRaw + 117
    var pos = x64BodyLoadStrValueAddressToReg(words, posRaw, bodyIR, op.operands[0], X64BodyRAX, paramSaveOffset)
    pos = x64bLoad64(words, pos, X64BodyRCX, X64BodyRAX, 0)
    pos = x64bLoad32Rex(words, pos, X64BodyRDX, X64BodyRAX, 8)
    pos = x64BodyLoadStrValueAddressToReg(words, pos, bodyIR, op.operands[1], X64BodyRAX, paramSaveOffset)
    pos = x64bLoad64(words, pos, X64BodyRSI, X64BodyRAX, 0)
    pos = x64bMovImm32(words, pos, X64BodyR10, 1, true)
    pos = x64bXorRR(words, pos, X64BodyR11, X64BodyR11, false)
    pos = x64bMemOpRex(words, pos, 0x3B, false, X64BodyRDX, X64BodyRAX, 8)
    if pos < 0:
        return -1
    pos = x64bJccRel32(words, pos, X64BodyCcNe, donePos - (pos + 6))
    if pos != loopPos:
        return -1
    pos = x64bTestRR(words, pos, X64BodyRDX, X64BodyRDX, false)
    pos = x64bJccRel32(words, pos, X64BodyCcE, equalPos - (pos + 6))
    pos = x64bLoad8(words, pos, X64BodyRAX, X64BodyRCX, 0)
    pos = x64bLoad8(words, pos, X64BodyRDI, X64BodyRSI, 0)
    pos = x64bCmpRR(words, pos, X64BodyRAX, X64BodyRDI, false)
    if pos < 0:
        return -1
    pos = x64bJccRel32(words, pos, X64BodyCcNe, donePos - (pos + 6))
    pos = x64bAddRR(words, pos, X64BodyRCX, X64BodyR10, true)
    pos = x64bAddRR(words, pos, X64BodyRSI, X64BodyR10, true)
    pos = x64bSubRR(words, pos, X64BodyRDX, X64BodyR10, false)
    if pos < 0:
        return -1
    pos = x64bJmpRel32(words, pos, loopPos - (pos + 5))
    if pos != equalPos:
        return -1
    pos = x64bMovRR(words, pos, X64BodyR11, X64BodyR10, false)
    if pos != donePos:
        return -1
    return x64BodyStoreI32SlotRex(words, pos, bodyIR, op.target, X64BodyR11, paramSaveOffset)

@borrows
fn x64BodyFillBinOp(words: var int32[],
                    posRaw: int32,
                    bodyIR: coreir.BodyIR,
                    op: coreir.BodyOp,
                    paramSaveOffset: int32,
                    elideLhs: bool,
                    elideStore: bool): int32 =
    if op.operands.len < 4:
        return -1
    let opType = op.operands[0]
    if opType != coreir.LocalI32Tag && opType != coreir.LocalI64Tag:
        return -1
    var opIs64: bool
    if opType == coreir.LocalI64Tag:
        opIs64 = true
    # S1: when elideLhs, the lhs value is already resident in RAX (produced by the
    # preceding same-block op) — skip `load lhs -> RAX`. The size predictor drops
    # the matching X64BodySlotAccessBytes via the same predicate.
    var pos = posRaw
    if !elideLhs:
        pos = x64BodyResLoadD8(words, pos, bodyIR, op.operands[2], X64BodyRAX, paramSaveOffset)
    pos = x64BodyResLoadD8(words, pos, bodyIR, op.operands[3], X64BodyRCX, paramSaveOffset)
    if pos < 0:
        return -1
    let opKind = op.operands[1]
    if opKind == int32(texpr.TypedExprIrOpI32Add):
        pos = x64bAddRR(words, pos, X64BodyRAX, X64BodyRCX, opIs64)
    elif opKind == int32(texpr.TypedExprIrOpI32Sub):
        pos = x64bSubRR(words, pos, X64BodyRAX, X64BodyRCX, opIs64)
    elif opKind == int32(texpr.TypedExprIrOpI32BitAnd):
        pos = x64bAndRR(words, pos, X64BodyRAX, X64BodyRCX, opIs64)
    elif opKind == int32(texpr.TypedExprIrOpI32BitOr):
        pos = x64bOrRR(words, pos, X64BodyRAX, X64BodyRCX, opIs64)
    elif opKind == int32(texpr.TypedExprIrOpI32BitXor):
        pos = x64bXorRR(words, pos, X64BodyRAX, X64BodyRCX, opIs64)
    elif opKind == int32(texpr.TypedExprIrOpI32Mul):
        pos = x64bImulRR(words, pos, X64BodyRAX, X64BodyRCX, opIs64)
    elif opKind == int32(texpr.TypedExprIrOpI32Asr):
        pos = x64bShiftCl(words, pos, 7, X64BodyRAX, opIs64)
    elif opKind == int32(texpr.TypedExprIrOpI32Lsr):
        pos = x64bShiftCl(words, pos, 5, X64BodyRAX, opIs64)
    elif opKind == int32(texpr.TypedExprIrOpI32Lsl):
        pos = x64bShiftCl(words, pos, 4, X64BodyRAX, opIs64)
    elif opKind == int32(texpr.TypedExprIrOpI32Sdiv):
        pos = x64bCdq(words, pos, opIs64)
        pos = x64bIdiv(words, pos, X64BodyRCX, opIs64)
    elif opKind == int32(texpr.TypedExprIrOpI32Udiv):
        pos = x64bXorRR(words, pos, X64BodyRDX, X64BodyRDX, opIs64)
        pos = x64bDiv(words, pos, X64BodyRCX, opIs64)
    elif opKind == int32(texpr.TypedExprIrOpI32Madd):
        if op.operands.len < 5:
            return -1
        pos = x64BodyResLoadD8(words, pos, bodyIR, op.operands[4], X64BodyRDX, paramSaveOffset)
        pos = x64bImulRR(words, pos, X64BodyRAX, X64BodyRCX, opIs64)
        pos = x64bAddRR(words, pos, X64BodyRAX, X64BodyRDX, opIs64)
    else:
        return -1
    # S2: when elideStore, S is a single-use temp consumed straight out of RAX by the
    # next op — drop the dead result store (mirrored by the size predictor's -8).
    if elideStore:
        return pos
    return x64BodyResStoreD8(words, pos, bodyIR, op.target, X64BodyRAX, paramSaveOffset)

@borrows
fn x64BodyFillCmpOp(words: var int32[],
                    posRaw: int32,
                    bodyIR: coreir.BodyIR,
                    op: coreir.BodyOp,
                    paramSaveOffset: int32,
                    elideLhs: bool,
                    elideStore: bool,
                    fused: bool): int32 =
    let cmpKind = X64BodyCmpKind(bodyIR, op)
    if cmpKind == 0:
        return -1
    if cmpKind == 2:
        # F64 stays stack class. Load raw bits through the existing checked slot
        # path, bridge to XMM scratch registers, then compare in the FP domain.
        # X64BodyLhsReloadElidableAt is false for F64; reject any disagreement
        # instead of silently omitting an operand.
        if elideLhs:
            return -1
        var f64Pos = x64BodyResLoadD8(words, posRaw, bodyIR,
                                     op.operands[1], X64BodyRAX,
                                     paramSaveOffset)
        f64Pos = x64BodyResLoadD8(words, f64Pos, bodyIR,
                                 op.operands[2], X64BodyRCX,
                                 paramSaveOffset)
        if f64Pos < 0:
            return -1
        f64Pos = x64bMovqXmmFromReg(words, f64Pos,
                                   X64BodyXMM0, X64BodyRAX)
        f64Pos = x64bMovqXmmFromReg(words, f64Pos,
                                   X64BodyXMM1, X64BodyRCX)
        f64Pos = x64bUcomisdRR(words, f64Pos,
                              X64BodyXMM0, X64BodyXMM1)
        if f64Pos < 0 || fused:
            return f64Pos
        f64Pos = x64BodyFillF64Predicate(words, f64Pos, op.operands[0])
        if f64Pos < 0 || elideStore:
            return f64Pos
        return x64BodyResStoreD8(words, f64Pos, bodyIR, op.target,
                                X64BodyRAX, paramSaveOffset)
    # S1: when elideLhs, the lhs value is already resident in RAX — skip the
    # `load lhs -> RAX` (mirrored by the size predictor's -X64BodySlotAccessBytes).
    var pos = posRaw
    if !elideLhs:
        pos = x64BodyResLoadD8(words, pos, bodyIR, op.operands[1], X64BodyRAX, paramSaveOffset)
    pos = x64BodyResLoadD8(words, pos, bodyIR, op.operands[2], X64BodyRCX, paramSaveOffset)
    if pos < 0:
        return -1
    var cmpIs64: bool
    let cmpLhsType = x64BodySlotType(bodyIR, op.operands[1])
    let cmpRhsType = x64BodySlotType(bodyIR, op.operands[2])
    if cmpLhsType == coreir.LocalI64Tag || cmpLhsType == coreir.LocalPtrTag:
        cmpIs64 = true
    elif cmpRhsType == coreir.LocalI64Tag || cmpRhsType == coreir.LocalPtrTag:
        cmpIs64 = true
    pos = x64bCmpRR(words, pos, X64BodyRAX, X64BodyRCX, cmpIs64)
    # S5: fused Cmp->Cbr — the compare flags are consumed straight by the block's Cbr jcc;
    # drop setcc+movzx8+store (mirrored by the size predictor's fused path).
    if fused:
        return pos
    let condCC = X64BodyCondTrueCC(op.operands[0])
    if condCC < 0:
        return -1
    pos = x64bSetcc(words, pos, condCC, X64BodyRAX)
    pos = x64bMovzx8RR(words, pos, X64BodyRAX, X64BodyRAX)
    # S2: when elideStore, the bool in RAX is consumed straight by the next op — drop
    # the dead result store (mirrored by the size predictor's -8).
    if elideStore:
        return pos
    return x64BodyResStoreD8(words, pos, bodyIR, op.target, X64BodyRAX, paramSaveOffset)

@borrows
fn x64BodyFillResultProjectOp(words: var int32[],
                              posRaw: int32,
                              bodyIR: coreir.BodyIR,
                              op: coreir.BodyOp,
                              paramSaveOffset: int32): int32 =
    if op.operands.len < 2:
        return -1
    let sourceOffset = X64BodyLocalStackOffset(bodyIR, op.operands[1], paramSaveOffset)
    let targetOffset = X64BodyLocalStackOffset(bodyIR, op.target, paramSaveOffset)
    if sourceOffset < 0 || targetOffset < 0:
        return -1
    if op.operands[0] == coreir.BodyResultProjectIsErrTag:
        var pos = x64bLoad32(words, posRaw, X64BodyRCX, X64BodyRSP, sourceOffset + coreir.ResultStrOkOffset)
        pos = x64bXorRR(words, pos, X64BodyRAX, X64BodyRAX, false)
        pos = x64bTestRR(words, pos, X64BodyRCX, X64BodyRCX, false)
        pos = x64bSetcc(words, pos, X64BodyCcE, X64BodyRAX)
        return x64bStore32(words, pos, X64BodyRAX, X64BodyRSP, targetOffset)
    if op.operands[0] == coreir.BodyResultProjectIsOkTag:
        # IsOk = ok-flag 直读（IsErr setcc 条件取反）：ok!=0→1。
        var pos = x64bLoad32(words, posRaw, X64BodyRCX, X64BodyRSP, sourceOffset + coreir.ResultStrOkOffset)
        pos = x64bXorRR(words, pos, X64BodyRAX, X64BodyRAX, false)
        pos = x64bTestRR(words, pos, X64BodyRCX, X64BodyRCX, false)
        pos = x64bSetcc(words, pos, X64BodyCcNe, X64BodyRAX)
        return x64bStore32(words, pos, X64BodyRAX, X64BodyRSP, targetOffset)
    if op.operands[0] != coreir.BodyResultProjectErrorStrTag &&
       op.operands[0] != coreir.BodyResultProjectValueStrTag &&
       op.operands[0] != coreir.BodyResultProjectErrInfoTag:
        return -1
    # 2-operand Value/Error/ErrInfo 无生产者（全部 4-operand 携带布局）：毒化，
    # 不回落 str 固定布局常量（防静默 miscompile）。
    if op.operands.len < 4:
        return -1
    let fieldOffset = op.operands[2]
    let byteCount = op.operands[3]
    if fieldOffset < 0:
        return -1
    return x64BodyFillCopyMemory(words,
                                 posRaw,
                                 X64BodyRSP,
                                 sourceOffset + fieldOffset,
                                 X64BodyRSP,
                                 targetOffset,
                                 byteCount)

@borrows
fn x64BodyFillGlobalLoadOp(words: var int32[],
                           posRaw: int32,
                           bodyIR: coreir.BodyIR,
                           op: coreir.BodyOp,
                           paramSaveOffset: int32): int32 =
    if op.operands.len < 1 ||
       op.target < 0 ||
       op.target >= bodyIR.localSlots.len:
        return -1
    let globalSlot = op.operands[0]
    if globalSlot < 0 ||
       globalSlot >= bodyIR.localSlots.len:
        return -1
    if op.operands.len >= 2 && op.operands[1] == 1:
        # Address-only global load.
        if bodyIR.localSlots[op.target].typeKind != coreir.LocalPtrTag:
            return -1
        var pos = x64bLeaRipGroup(words, posRaw, X64BodyRAX)
        return x64BodyStoreRegToSlotD8(words, pos, bodyIR, op.target, X64BodyRAX, paramSaveOffset)
    if bodyIR.localSlots[globalSlot].typeKind != bodyIR.localSlots[op.target].typeKind:
        return -1
    if bodyIR.localSlots[globalSlot].typeKind == coreir.LocalStrTag:
        let byteCount = x64BodySlotSizeOf(bodyIR.localSlots[globalSlot])
        var pos = x64bLeaRipGroup(words, posRaw, X64BodyR10)
        pos = x64BodyLoadStrValueAddressToReg(words, pos, bodyIR, op.target, X64BodyRCX, paramSaveOffset)
        if pos < 0:
            return -1
        return x64BodyFillCopyMemory(words, pos, X64BodyR10, 0, X64BodyRCX, 0, byteCount)
    var pos = x64bLeaRipGroup(words, posRaw, X64BodyR10)
    if x64BodyGlobalOpIs64(bodyIR, op):
        pos = x64bLoad64(words, pos, X64BodyRAX, X64BodyR10, 0)
    else:
        pos = x64bLoad32(words, pos, X64BodyRAX, X64BodyR10, 0)
    return x64BodyStoreRegToSlotD8(words, pos, bodyIR, op.target, X64BodyRAX, paramSaveOffset)

@borrows
fn x64BodyFillGlobalStoreOp(words: var int32[],
                            posRaw: int32,
                            bodyIR: coreir.BodyIR,
                            op: coreir.BodyOp,
                            paramSaveOffset: int32): int32 =
    if op.operands.len < 1 ||
       op.target < 0 ||
       op.target >= bodyIR.localSlots.len:
        return -1
    let globalSlot = op.operands[0]
    if globalSlot < 0 ||
       globalSlot >= bodyIR.localSlots.len ||
       bodyIR.localSlots[globalSlot].typeKind != bodyIR.localSlots[op.target].typeKind:
        return -1
    if bodyIR.localSlots[globalSlot].typeKind == coreir.LocalStrTag:
        let byteCount = x64BodySlotSizeOf(bodyIR.localSlots[globalSlot])
        var pos = x64bLeaRipGroup(words, posRaw, X64BodyR10)
        pos = x64BodyLoadStrValueAddressToReg(words, pos, bodyIR, op.target, X64BodyRCX, paramSaveOffset)
        if pos < 0:
            return -1
        return x64BodyFillCopyMemory(words, pos, X64BodyRCX, 0, X64BodyR10, 0, byteCount)
    if bodyIR.localSlots[globalSlot].typeKind == coreir.LocalAggregateTag:
        let aggByteCount = x64BodySlotSizeOf(bodyIR.localSlots[globalSlot])
        if aggByteCount <= 0 ||
           x64BodySlotSizeOf(bodyIR.localSlots[op.target]) != aggByteCount:
            return -1
        var aggPos = x64bLeaRipGroup(words, posRaw, X64BodyR10)
        let aggSourceOffset = X64BodyLocalStackOffset(bodyIR, op.target, paramSaveOffset)
        if aggSourceOffset < 0:
            return -1
        if x64BodyLocalIsParam(bodyIR.localSlots[op.target]):
            aggPos = x64bLoad64(words, aggPos, X64BodyRCX, X64BodyRSP, aggSourceOffset)
        else:
            aggPos = x64bLeaStack(words, aggPos, X64BodyRCX, aggSourceOffset)
        if aggPos < 0:
            return -1
        return x64BodyFillCopyMemory(words, aggPos, X64BodyRCX, 0, X64BodyR10, 0, aggByteCount)
    var pos = x64bLeaRipGroup(words, posRaw, X64BodyR10)
    pos = x64BodyLoadSlotToRegD8(words, pos, bodyIR, op.target, X64BodyRAX, paramSaveOffset)
    if pos < 0:
        return -1
    if x64BodyGlobalOpIs64(bodyIR, op):
        return x64bStore64(words, pos, X64BodyRAX, X64BodyR10, 0)
    return x64bStore32(words, pos, X64BodyRAX, X64BodyR10, 0)

# aggregate element address into rax (index scratch rcx)
@borrows
fn x64BodyFillIndexedAggregateAddress(words: var int32[],
                                      posRaw: int32,
                                      bodyIR: coreir.BodyIR,
                                      op: coreir.BodyOp,
                                      paramSaveOffset: int32): int32 =
    if op.operands.len < 4:
        return -1
    let elemSize = op.operands[3]
    var pos = x64BodyLoadSlotToReg(words, posRaw, bodyIR, op.operands[0], X64BodyRAX, paramSaveOffset, 0)
    if pos < 0:
        return -1
    if op.operands.len >= 5 && op.operands[4] == 1:
        pos = x64bLoad64(words, pos, X64BodyRAX, X64BodyRAX, 8)
    pos = x64BodyLoadSlotToReg(words, pos, bodyIR, op.operands[2], X64BodyRCX, paramSaveOffset, 0)
    if pos < 0:
        return -1
    # segment-s6: elemSize 1/4/8 leave base in RAX and the raw index in RCX — the element
    # load/store folds base+index*scale into its ModRM+SIB byte, so no imul/shl+add here.
    if X64BodyIndexedSibScaleLog(elemSize) >= 0:
        return pos
    if elemSize <= 0:
        return -1
    if elemSize <= 127:
        pos = x64bImulRRImm8(words, pos, X64BodyRCX, X64BodyRCX, elemSize)
    else:
        pos = x64bImulRRImm32(words, pos, X64BodyRCX, X64BodyRCX, elemSize)
    return x64bAddRR(words, pos, X64BodyRAX, X64BodyRCX, true)

@borrows
fn x64BodyFillIndexedLoadOp(words: var int32[],
                            posRaw: int32,
                            bodyIR: coreir.BodyIR,
                            op: coreir.BodyOp,
                            paramSaveOffset: int32): int32 =
    if op.operands.len < 2:
        return -1
    if X64BodyIndexedIsSibForm(bodyIR, op):
        let elemSize = op.operands[3]
        var pos = x64BodyFillIndexedAggregateAddress(words, posRaw, bodyIR, op, paramSaveOffset)
        if pos < 0:
            return -1
        # segment-s6: SIB element load [rax + rcx*scale]; RCX is index then destination.
        let sibScaleLog = X64BodyIndexedSibScaleLog(elemSize)
        if elemSize == 1:
            pos = x64bLoad8Sib(words, pos, X64BodyRCX, X64BodyRAX, X64BodyRCX, sibScaleLog)
            return x64BodyStoreRegToSlot(words, pos, bodyIR, op.operands[1], X64BodyRCX, paramSaveOffset)
        if elemSize == 4:
            pos = x64bLoad32Sib(words, pos, X64BodyRCX, X64BodyRAX, X64BodyRCX, sibScaleLog)
            return x64BodyStoreRegToSlot(words, pos, bodyIR, op.operands[1], X64BodyRCX, paramSaveOffset)
        if elemSize == 8:
            pos = x64bLoad64Sib(words, pos, X64BodyRCX, X64BodyRAX, X64BodyRCX, sibScaleLog)
            return x64BodyStoreRegToSlot(words, pos, bodyIR, op.operands[1], X64BodyRCX, paramSaveOffset)
        if X64BodyIndexedAggregateValueCopyBytes(bodyIR, op.operands[1], elemSize) > 0:
            pos = x64BodyLoadSlotToReg(words, pos, bodyIR, op.operands[1], X64BodyR10, paramSaveOffset, 0)
            if pos < 0:
                return -1
            return x64BodyFillCopyMemory(words, pos, X64BodyRAX, 0, X64BodyR10, 0, elemSize)
        if elemSize == 24:
            if op.operands[1] < 0 ||
               op.operands[1] >= bodyIR.localSlots.len ||
               bodyIR.localSlots[op.operands[1]].typeKind != coreir.LocalStrTag:
                return -1
            pos = x64BodyLoadSlotToReg(words, pos, bodyIR, op.operands[1], X64BodyRDX, paramSaveOffset, 0)
            if pos < 0:
                return -1
            for copyIndex in 0..<3:
                pos = x64bLoad64(words, pos, X64BodyR10, X64BodyRAX, copyIndex * 8)
                pos = x64bStore64(words, pos, X64BodyR10, X64BodyRDX, copyIndex * 8)
                if pos < 0:
                    return -1
            return pos
        return -1
    var pos = x64BodyLoadSlotToReg(words, posRaw, bodyIR, op.operands[0], X64BodyRAX, paramSaveOffset, 0)
    if pos < 0:
        return -1
    let resultType = x64BodySlotType(bodyIR, op.operands[1])
    var is64: bool
    if resultType == coreir.LocalI64Tag ||
       resultType == coreir.LocalPtrTag ||
       resultType == coreir.LocalStrTag ||
       resultType == coreir.LocalAggregateTag:
        is64 = true
    if is64:
        pos = x64bLoad64(words, pos, X64BodyRCX, X64BodyRAX, 0)
    else:
        pos = x64bLoad32(words, pos, X64BodyRCX, X64BodyRAX, 0)
    return x64BodyStoreRegToSlot(words, pos, bodyIR, op.operands[1], X64BodyRCX, paramSaveOffset)

@borrows
fn x64BodyFillIndexedStoreOp(words: var int32[],
                             posRaw: int32,
                             bodyIR: coreir.BodyIR,
                             op: coreir.BodyOp,
                             paramSaveOffset: int32): int32 =
    if op.operands.len < 2:
        return -1
    if X64BodyIndexedIsSibForm(bodyIR, op):
        let elemSize = op.operands[3]
        var pos = x64BodyFillIndexedAggregateAddress(words, posRaw, bodyIR, op, paramSaveOffset)
        if pos < 0:
            return -1
        # segment-s6: value loaded into RDX (does not touch base RAX / index RCX), then a
        # SIB element store [rax + rcx*scale].
        let sibScaleLog = X64BodyIndexedSibScaleLog(elemSize)
        if elemSize == 1:
            pos = x64BodyLoadSlotToReg(words, pos, bodyIR, op.operands[1], X64BodyRDX, paramSaveOffset, 0)
            return x64bStore8Sib(words, pos, X64BodyRDX, X64BodyRAX, X64BodyRCX, sibScaleLog)
        if elemSize == 4:
            pos = x64BodyLoadSlotToReg(words, pos, bodyIR, op.operands[1], X64BodyRDX, paramSaveOffset, 0)
            return x64bStore32Sib(words, pos, X64BodyRDX, X64BodyRAX, X64BodyRCX, sibScaleLog)
        if elemSize == 8:
            pos = x64BodyLoadSlotToReg(words, pos, bodyIR, op.operands[1], X64BodyRDX, paramSaveOffset, 0)
            return x64bStore64Sib(words, pos, X64BodyRDX, X64BodyRAX, X64BodyRCX, sibScaleLog)
        if X64BodyIndexedAggregateValueCopyBytes(bodyIR, op.operands[1], elemSize) > 0:
            pos = x64BodyLoadSlotToReg(words, pos, bodyIR, op.operands[1], X64BodyR10, paramSaveOffset, 0)
            if pos < 0:
                return -1
            return x64BodyFillCopyMemory(words, pos, X64BodyR10, 0, X64BodyRAX, 0, elemSize)
        if elemSize == 24:
            let valueType = x64BodySlotType(bodyIR, op.operands[1])
            pos = x64BodyLoadSlotToReg(words, pos, bodyIR, op.operands[1], X64BodyRDX, paramSaveOffset, 0)
            if pos < 0:
                return -1
            if valueType == coreir.LocalPtrTag:
                for copyIndex in 0..<3:
                    pos = x64bStore64(words, pos, X64BodyRDX, X64BodyRAX, copyIndex * 8)
                    if pos < 0:
                        return -1
                return pos
            if valueType == coreir.LocalStrTag:
                for copyIndex in 0..<3:
                    pos = x64bLoad64(words, pos, X64BodyR10, X64BodyRDX, copyIndex * 8)
                    pos = x64bStore64(words, pos, X64BodyR10, X64BodyRAX, copyIndex * 8)
                    if pos < 0:
                        return -1
                return pos
            return -1
        return -1
    var pos = x64BodyLoadSlotToReg(words, posRaw, bodyIR, op.operands[0], X64BodyRAX, paramSaveOffset, 0)
    pos = x64BodyLoadSlotToReg(words, pos, bodyIR, op.operands[1], X64BodyRCX, paramSaveOffset, 0)
    if pos < 0:
        return -1
    if op.operands.len >= 3 &&
       op.operands[2] == coreir.BodyStoreLocalPtrDerefU8Tag:
        return x64bStore8(words, pos, X64BodyRCX, X64BodyRAX, 0)
    let valueType = x64BodySlotType(bodyIR, op.operands[1])
    if valueType == coreir.LocalI64Tag || valueType == coreir.LocalPtrTag:
        return x64bStore64(words, pos, X64BodyRCX, X64BodyRAX, 0)
    return x64bStore32(words, pos, X64BodyRCX, X64BodyRAX, 0)

@borrows
fn x64BodyFillFieldLoadOp(words: var int32[],
                          posRaw: int32,
                          bodyIR: coreir.BodyIR,
                          op: coreir.BodyOp,
                          paramSaveOffset: int32): int32 =
    if op.operands.len < 3:
        return -1
    let baseSlot = op.operands[0]
    let valueSlot = op.operands[1]
    let byteOffset = op.operands[2]
    var byteCount = 0
    if op.operands.len >= 4:
        byteCount = op.operands[3]
    if byteCount <= 0:
        byteCount = 8
    var pos = posRaw
    var sourceReg = X64BodyRSP
    var sourceOffset = byteOffset
    let baseType = bodyIR.localSlots[baseSlot].typeKind
    if baseType == coreir.LocalStrTag:
        pos = x64BodyLoadStrValueAddressToReg(words, pos, bodyIR, baseSlot, X64BodyRAX, paramSaveOffset)
        if pos < 0:
            return -1
        sourceReg = X64BodyRAX
    elif baseType == coreir.LocalPtrTag ||
         (baseType == coreir.LocalAggregateTag &&
          x64BodyLocalIsParam(bodyIR.localSlots[baseSlot])):
        pos = x64BodyLoadSlotToReg(words, pos, bodyIR, baseSlot, X64BodyRAX, paramSaveOffset, 0)
        if pos < 0:
            return -1
        sourceReg = X64BodyRAX
    else:
        let baseOffset = X64BodyLocalStackOffset(bodyIR, baseSlot, paramSaveOffset)
        if baseOffset < 0:
            return -1
        sourceOffset = baseOffset + byteOffset
    let targetOffset = X64BodyLocalStackOffset(bodyIR, valueSlot, paramSaveOffset)
    if targetOffset < 0:
        return -1
    # Sub-word (bool/u8) field into a scalar slot: every consumer reads the slot
    # at full width, so a raw 1-byte copy leaves stale upper bytes from the stack.
    # movzx + full-width store zero-extends instead (same 17 bytes as the 1-byte
    # memcpy pair, so the size model is unchanged). Mirrors the IndexedLoad
    # elemSize==1 arm.
    let fieldValueType = bodyIR.localSlots[valueSlot].typeKind
    if byteCount == 1 &&
       (fieldValueType == coreir.LocalI32Tag ||
        fieldValueType == coreir.LocalI64Tag ||
        fieldValueType == coreir.LocalPtrTag):
        pos = x64bLoad8(words, pos, X64BodyRDX, sourceReg, sourceOffset)
        if pos < 0:
            return -1
        return x64BodyStoreRegToSlot(words, pos, bodyIR, valueSlot, X64BodyRDX, paramSaveOffset)
    return x64BodyFillCopyMemory(words, pos, sourceReg, sourceOffset, X64BodyRSP, targetOffset, byteCount)

@borrows
fn x64BodyFillFieldStoreOp(words: var int32[],
                           posRaw: int32,
                           bodyIR: coreir.BodyIR,
                           op: coreir.BodyOp,
                           paramSaveOffset: int32): int32 =
    if op.operands.len < 3:
        return -1
    let baseSlot = op.operands[0]
    let valueSlot = op.operands[1]
    let byteOffset = op.operands[2]
    var byteCount = 0
    if op.operands.len >= 4:
        byteCount = op.operands[3]
    if byteCount <= 0:
        byteCount = 8
    let sourceOffset = X64BodyLocalStackOffset(bodyIR, valueSlot, paramSaveOffset)
    if sourceOffset < 0:
        return -1
    var pos = posRaw
    var targetReg = X64BodyRSP
    var targetOffset = byteOffset
    let baseType = bodyIR.localSlots[baseSlot].typeKind
    if baseType == coreir.LocalPtrTag ||
       ((baseType == coreir.LocalStrTag ||
         baseType == coreir.LocalAggregateTag) &&
        x64BodyLocalIsParam(bodyIR.localSlots[baseSlot])):
        pos = x64BodyLoadSlotToReg(words, pos, bodyIR, baseSlot, X64BodyRAX, paramSaveOffset, 0)
        if pos < 0:
            return -1
        targetReg = X64BodyRAX
    else:
        let baseOffset = X64BodyLocalStackOffset(bodyIR, baseSlot, paramSaveOffset)
        if baseOffset < 0:
            return -1
        targetOffset = baseOffset + byteOffset
    # str/aggregate PARAM as the copied VALUE: its slot homes the incoming
    # record pointer, not inline data — deref via R10 before copying (the base
    # side of this op and FieldLoad already do the mirror-image deref).
    let storeValueType = bodyIR.localSlots[valueSlot].typeKind
    if (storeValueType == coreir.LocalStrTag ||
        storeValueType == coreir.LocalAggregateTag) &&
       x64BodyLocalIsParam(bodyIR.localSlots[valueSlot]):
        pos = x64bLoad64(words, pos, X64BodyR10, X64BodyRSP, sourceOffset)
        if pos < 0:
            return -1
        return x64BodyFillCopyMemory(words, pos, X64BodyR10, 0, targetReg, targetOffset, byteCount)
    return x64BodyFillCopyMemory(words, pos, X64BodyRSP, sourceOffset, targetReg, targetOffset, byteCount)

@borrows
fn x64BodyFillBranchOp(words: var int32[],
                       posRaw: int32,
                       bodyIR: coreir.BodyIR,
                       op: coreir.BodyOp,
                       paramSaveOffset: int32,
                       frameBytes: int32): int32 =
    if op.operands.len < 3:
        return -1
    let guardSlot = op.operands[1]
    if guardSlot < 0 || guardSlot >= bodyIR.localSlots.len:
        return -1
    var pos = x64BodyLoadSlotToReg(words, posRaw, bodyIR, guardSlot, X64BodyRAX, paramSaveOffset, 0)
    if pos < 0:
        return -1
    let subKind = op.operands[0]
    let guardType = x64BodySlotType(bodyIR, guardSlot)
    var guardIs64: bool
    if guardType == coreir.LocalI64Tag || guardType == coreir.LocalPtrTag:
        guardIs64 = true
    if subKind == coreir.BodyBranchIfLocalNilReturnI32ConstTag:
        let returnValue = op.operands[2]
        let opEnd = posRaw + 33
        pos = x64bTestRR(words, pos, X64BodyRAX, X64BodyRAX, guardIs64)
        if pos < 0:
            return -1
        pos = x64bJccRel32(words, pos, X64BodyCcNe, opEnd - (pos + 6))
        pos = x64bMovImm32(words, pos, X64BodyRAX, returnValue, false)
        return x64bFillEpilogue(words, pos, frameBytes)
    if subKind == coreir.BodyBranchIfLocalLeZeroReturnI32ConstTag:
        let returnValue = op.operands[2]
        let opEnd = posRaw + 37
        pos = x64bCmpImm32(words, pos, X64BodyRAX, 0, guardIs64)
        if pos < 0:
            return -1
        pos = x64bJccRel32(words, pos, X64BodyCcG, opEnd - (pos + 6))
        pos = x64bMovImm32(words, pos, X64BodyRAX, returnValue, false)
        return x64bFillEpilogue(words, pos, frameBytes)
    if subKind == coreir.BodyBranchIfLocalLeZeroReturnCallNoargTag:
        let opEnd = posRaw + 41
        pos = x64bCmpImm32(words, pos, X64BodyRAX, 0, guardIs64)
        if pos < 0:
            return -1
        pos = x64bJccRel32(words, pos, X64BodyCcG, opEnd - (pos + 6))
        pos = x64bPadTo(words, pos, posRaw + 24)
        pos = x64bCallGroup(words, pos)
        return x64bFillEpilogue(words, pos, frameBytes)
    if subKind == coreir.BodyBranchIfLocalLeZeroCallArg0ReturnI32ConstTag:
        if op.operands.len < 4:
            return -1
        let arg0Slot = op.operands[2]
        let returnValue = op.operands[3]
        if arg0Slot < 0 || arg0Slot >= bodyIR.localSlots.len:
            return -1
        let opEnd = posRaw + 56
        pos = x64bCmpImm32(words, pos, X64BodyRAX, 0, guardIs64)
        if pos < 0:
            return -1
        pos = x64bJccRel32(words, pos, X64BodyCcG, opEnd - (pos + 6))
        pos = x64BodyLoadSlotToReg(words, pos, bodyIR, arg0Slot, X64BodyRDI, paramSaveOffset, 0)
        if pos < 0:
            return -1
        pos = x64bPadTo(words, pos, posRaw + 32)
        pos = x64bCallGroup(words, pos)
        pos = x64bMovImm32(words, pos, X64BodyRAX, returnValue, false)
        return x64bFillEpilogue(words, pos, frameBytes)
    return -1

@borrows
fn x64BodyFillBlockOp(words: var int32[],
                      posRaw: int32,
                      bodyIR: coreir.BodyIR,
                      oi: int32,
                      paramSaveOffset: int32,
                      frameBytes: int32): int32 =
    if posRaw < 0 || oi < 0 || oi >= bodyIR.ops.len:
        return -1
    let op = bodyIR.ops[oi]
    if op.kind == coreir.BodyOpCallTag:
        return x64BodyFillCallOp(words, posRaw, bodyIR, op, paramSaveOffset)
    if op.kind == coreir.BodyOpLoadConstTag:
        if op.operands.len < 2:
            return -1
        let constType = op.operands[0]
        if constType == coreir.LocalF64Tag:
            if op.operands.len < 5:
                return -1
            var f64Pos = x64bMovImm64Chunks(words, posRaw, X64BodyRAX,
                                            op.operands[1], op.operands[2],
                                            op.operands[3], op.operands[4])
            return x64BodyStoreRegToSlot(words, f64Pos, bodyIR, op.target, X64BodyRAX, paramSaveOffset)
        if constType != coreir.LocalI32Tag &&
           constType != coreir.LocalI64Tag &&
           constType != coreir.LocalPtrTag:
            return -1
        if (constType == coreir.LocalI64Tag || constType == coreir.LocalPtrTag) &&
           op.operands.len >= 5:
            var widePos = x64bMovImm64Chunks(words, posRaw, X64BodyRAX,
                                             op.operands[1], op.operands[2],
                                             op.operands[3], op.operands[4])
            return x64BodyResStoreD8(words, widePos, bodyIR, op.target, X64BodyRAX, paramSaveOffset)
        var pos = x64bMovImm32(words, posRaw, X64BodyRAX, op.operands[1], constType != coreir.LocalI32Tag)
        return x64BodyResStoreD8(words, pos, bodyIR, op.target, X64BodyRAX, paramSaveOffset)
    if op.kind == coreir.BodyOpCopyLocalTag ||
       op.kind == coreir.BodyOpStoreLocalTag:
        if op.operands.len < 1:
            return -1
        return x64BodyFillCopySlot(words, posRaw, bodyIR, op.operands[0], op.target, paramSaveOffset,
                                   X64BodyCopySrcElidableAt(bodyIR, oi))
    if op.kind == coreir.BodyOpBinOpTag:
        return x64BodyFillBinOp(words, posRaw, bodyIR, op, paramSaveOffset,
                                X64BodyLhsReloadElidableAt(bodyIR, oi),
                                X64BodyStoreElidableAt(bodyIR, oi))
    if op.kind == coreir.BodyOpCmpTag:
        return x64BodyFillCmpOp(words, posRaw, bodyIR, op, paramSaveOffset,
                                X64BodyLhsReloadElidableAt(bodyIR, oi),
                                X64BodyStoreElidableAt(bodyIR, oi),
                                X64BodyCmpFusedAt(bodyIR, oi))
    if op.kind == coreir.BodyOpResultProjectTag:
        return x64BodyFillResultProjectOp(words, posRaw, bodyIR, op, paramSaveOffset)
    if op.kind == coreir.BodyOpStrEqLiteralTag:
        return x64BodyFillStrEqLiteralOp(words, posRaw, bodyIR, op, paramSaveOffset)
    if op.kind == coreir.BodyOpStrEqTag:
        return x64BodyFillStrEqOp(words, posRaw, bodyIR, op, paramSaveOffset)
    if op.kind == coreir.BodyOpGlobalLoadTag:
        return x64BodyFillGlobalLoadOp(words, posRaw, bodyIR, op, paramSaveOffset)
    if op.kind == coreir.BodyOpGlobalStoreTag:
        return x64BodyFillGlobalStoreOp(words, posRaw, bodyIR, op, paramSaveOffset)
    if op.kind == coreir.BodyOpFieldLoadTag:
        return x64BodyFillFieldLoadOp(words, posRaw, bodyIR, op, paramSaveOffset)
    if op.kind == coreir.BodyOpFieldStoreTag:
        return x64BodyFillFieldStoreOp(words, posRaw, bodyIR, op, paramSaveOffset)
    if op.kind == coreir.BodyOpIndexedLoadTag:
        return x64BodyFillIndexedLoadOp(words, posRaw, bodyIR, op, paramSaveOffset)
    if op.kind == coreir.BodyOpIndexedStoreTag:
        return x64BodyFillIndexedStoreOp(words, posRaw, bodyIR, op, paramSaveOffset)
    if op.kind == coreir.BodyOpLoadLocalTag:
        if op.operands.len >= 3 &&
           op.operands[0] == coreir.BodyLoadLocalStrIndexU8Tag:
            if op.operands[1] < 0 || op.operands[1] >= bodyIR.localSlots.len ||
               op.operands[2] < 0 || op.operands[2] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return -1
            var pos = x64BodyLoadStrValueAddressToReg(words, posRaw, bodyIR, op.operands[1], X64BodyRAX, paramSaveOffset)
            pos = x64BodyLoadSlotToReg(words, pos, bodyIR, op.operands[2], X64BodyRCX, paramSaveOffset, 0)
            if pos < 0:
                return -1
            pos = x64bLoad64(words, pos, X64BodyRAX, X64BodyRAX, 0)
            pos = x64bAddRR(words, pos, X64BodyRAX, X64BodyRCX, true)
            pos = x64bLoad8(words, pos, X64BodyRCX, X64BodyRAX, 0)
            return x64BodyStoreRegToSlot(words, pos, bodyIR, op.target, X64BodyRCX, paramSaveOffset)
        if op.operands.len >= 3 &&
           (op.operands[0] == coreir.BodyLoadLocalPtrDerefI32Tag ||
            op.operands[0] == coreir.BodyLoadLocalPtrDerefU8Tag ||
            op.operands[0] == coreir.BodyLoadLocalPtrDerefU64Tag):
            if op.operands[1] < 0 || op.operands[1] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return -1
            var pos = x64BodyLoadSlotToReg(words, posRaw, bodyIR, op.operands[1], X64BodyRAX, paramSaveOffset, 0)
            if pos < 0:
                return -1
            if op.operands[0] == coreir.BodyLoadLocalPtrDerefU8Tag:
                pos = x64bLoad8(words, pos, X64BodyRCX, X64BodyRAX, 0)
            elif op.operands[0] == coreir.BodyLoadLocalPtrDerefU64Tag:
                pos = x64bLoad64(words, pos, X64BodyRCX, X64BodyRAX, 0)
            else:
                pos = x64bLoad32(words, pos, X64BodyRCX, X64BodyRAX, 0)
            return x64BodyStoreRegToSlot(words, pos, bodyIR, op.target, X64BodyRCX, paramSaveOffset)
        if op.operands.len >= 2 &&
           op.operands[0] == coreir.BodyLoadLocalAddressTag:
            if op.operands[1] < 0 || op.operands[1] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return -1
            let addrOffset = X64BodyLocalStackOffset(bodyIR, op.operands[1], paramSaveOffset)
            if addrOffset < 0:
                return -1
            # segment-d1.2: leaStackAuto narrows [rsp+addrOffset] to disp8 when it fits;
            # the ptr store routes through the disp8-capable chokepoint. Size mirrors this.
            var pos = x64bLeaStackAuto(words, posRaw, X64BodyRAX, addrOffset)
            return x64BodyStoreRegToSlotD8(words, pos, bodyIR, op.target, X64BodyRAX, paramSaveOffset)
        if op.operands.len >= 2 &&
           op.operands[0] == coreir.BodyLoadLocalCStringTag:
            if op.operands[1] < 0 || op.operands[1] >= bodyIR.cstringLiterals.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return -1
            # segment-d1.2: leaRip stays disp32; only the ptr store narrows via the
            # disp8-capable chokepoint.
            var pos = x64bLeaRipGroup(words, posRaw, X64BodyRAX)
            return x64BodyStoreRegToSlotD8(words, pos, bodyIR, op.target, X64BodyRAX, paramSaveOffset)
        if op.operands.len >= 1:
            if op.operands[0] < 0 || op.operands[0] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return -1
            # LoadLocal plain-copy fallback: not a CopyLocal/StoreLocal op, so S3 never
            # applies here (its byte-count branch adds no subtraction). Pass false.
            return x64BodyFillCopySlot(words, posRaw, bodyIR, op.operands[0], op.target, paramSaveOffset, false)
        return -1
    if op.kind == coreir.BodyOpBranchTag:
        return x64BodyFillBranchOp(words, posRaw, bodyIR, op, paramSaveOffset, frameBytes)
    if op.kind == coreir.BodyOpReturnTag:
        return x64bPadTo(words, posRaw, posRaw + 4)
    return -1

# ---------- terms ----------

@borrows
fn x64BodyFillBlockTermReturn(words: var int32[],
                              posRaw: int32,
                              term: coreir.BodyTerm,
                              bodyIR: coreir.BodyIR,
                              paramSaveOffset: int32,
                              frameBytes: int32): int32 =
    if posRaw < 0:
        return -1
    if term.resultSlot >= 0 && term.resultSlot < bodyIR.localSlots.len:
        let resultType = bodyIR.localSlots[term.resultSlot].typeKind
        if resultType == coreir.LocalStrTag ||
           resultType == coreir.LocalAggregateTag:
            let sourceOffset = X64BodyLocalStackOffset(bodyIR, term.resultSlot, paramSaveOffset)
            let returnBufferOffset = X64BodyReturnBufferSaveOffset(bodyIR)
            if sourceOffset < 0 || returnBufferOffset < 0:
                return -1
            let retCopyBytes = x64BodySlotSizeOf(bodyIR.localSlots[term.resultSlot])
            let retCopyPairs = X64ReturnSretCopyPairCount(retCopyBytes)
            if retCopyPairs <= 0:
                return -1
            # A str/aggregate PARAM slot homes the incoming record POINTER (by-pointer
            # arg). `return s` must deref that pointer (RDX=source base) and copy from
            # [RDX+i*stride]; reading inline sp+sourceOffset would copy pointer + sret
            # ptr + stack garbage. Local aggregate slots hold inline values (RSP path).
            let retAggParam = x64BodyLocalIsParam(bodyIR.localSlots[term.resultSlot])
            let copyStride = X64ReturnSretCopyStride(retCopyBytes)
            if copyStride <= 0:
                return -1
            var sourceCursor = sourceOffset
            if retAggParam:
                sourceCursor = 0
            var targetCursor = 0
            if !x64BodyCopyDisplacementRangeSupported(sourceCursor, retCopyBytes) ||
               !x64BodyCopyDisplacementRangeSupported(targetCursor, retCopyBytes):
                return -1
            var pos = x64bLoad64(words, posRaw, X64BodyRCX, X64BodyRSP, returnBufferOffset)
            if retAggParam:
                pos = x64bLoad64(words, pos, X64BodyRDX, X64BodyRSP, sourceOffset)
            if copyStride == 8:
                for copyIndex in 0..<retCopyPairs:
                    if retAggParam:
                        pos = x64bLoad64(words, pos, X64BodyRAX, X64BodyRDX, sourceCursor)
                    else:
                        pos = x64bLoad64(words, pos, X64BodyRAX, X64BodyRSP, sourceCursor)
                    pos = x64bStore64(words, pos, X64BodyRAX, X64BodyRCX, targetCursor)
                    if pos < 0:
                        return -1
                    if copyIndex + 1 < retCopyPairs:
                        sourceCursor = X64BodyCheckedAddNonNegative(sourceCursor,
                                                                   copyStride)
                        targetCursor = X64BodyCheckedAddNonNegative(targetCursor,
                                                                   copyStride)
                        if sourceCursor < 0 || targetCursor < 0:
                            return -1
            elif copyStride == 4:
                for copyIndex in 0..<retCopyPairs:
                    if retAggParam:
                        pos = x64bLoad32(words, pos, X64BodyRAX, X64BodyRDX, sourceCursor)
                    else:
                        pos = x64bLoad32(words, pos, X64BodyRAX, X64BodyRSP, sourceCursor)
                    pos = x64bStore32(words, pos, X64BodyRAX, X64BodyRCX, targetCursor)
                    if pos < 0:
                        return -1
                    if copyIndex + 1 < retCopyPairs:
                        sourceCursor = X64BodyCheckedAddNonNegative(sourceCursor,
                                                                   copyStride)
                        targetCursor = X64BodyCheckedAddNonNegative(targetCursor,
                                                                   copyStride)
                        if sourceCursor < 0 || targetCursor < 0:
                            return -1
            else:
                for copyIndex in 0..<retCopyPairs:
                    if retAggParam:
                        pos = x64bLoad8(words, pos, X64BodyRAX, X64BodyRDX, sourceCursor)
                    else:
                        pos = x64bLoad8(words, pos, X64BodyRAX, X64BodyRSP, sourceCursor)
                    pos = x64bStore8(words, pos, X64BodyRAX, X64BodyRCX, targetCursor)
                    if pos < 0:
                        return -1
                    if copyIndex + 1 < retCopyPairs:
                        sourceCursor = X64BodyCheckedAddNonNegative(sourceCursor,
                                                                   copyStride)
                        targetCursor = X64BodyCheckedAddNonNegative(targetCursor,
                                                                   copyStride)
                        if sourceCursor < 0 || targetCursor < 0:
                            return -1
            pos = x64bMovRR(words, pos, X64BodyRAX, X64BodyRCX, true)
            return x64bFillEpilogue(words, pos, frameBytes)
        var pos = x64BodyResLoad(words, posRaw, bodyIR, term.resultSlot, X64BodyRAX, paramSaveOffset)
        if pos < 0:
            return -1
        if resultType == coreir.LocalF64Tag:
            pos = x64bMovqXmm0FromRax(words, pos)
            if pos < 0:
                return -1
        return x64bFillEpilogue(words, pos, frameBytes)
    if term.resultSlot < 0 &&
       term.operands.len >= 1 &&
       term.operands[0] == coreir.LocalInvalidTag:
        return x64bFillEpilogue(words, posRaw, frameBytes)
    var returnValue = 0
    if term.operands.len >= 2 && term.operands[0] == 1:
        returnValue = term.operands[1]
    let pos = x64bMovImm32(words, posRaw, X64BodyRAX, returnValue, false)
    return x64bFillEpilogue(words, pos, frameBytes)

@borrows
fn x64BodyFillBlockTerm(words: var int32[],
                        posRaw: int32,
                        bodyIR: coreir.BodyIR,
                        bi: int32,
                        paramSaveOffset: int32,
                        frameBytes: int32): int32 =
    if posRaw < 0:
        return -1
    let block = bodyIR.blocks[bi]
    let termIndex = block.termIndex
    if termIndex < 0 || termIndex >= bodyIR.terms.len:
        return -1
    let term = bodyIR.terms[termIndex]
    if term.kind == coreir.BodyTermCbrTag:
        let termSize = X64BodyTermSize(bodyIR, termIndex)
        if termSize <= 0:
            return -1
        # segment-b: block starts / op-range sizes are BYTE offsets now, so the
        # function byte base and branch targets carry no ×4 scale.
        let blockStart = X64BodyBlockStart(bodyIR, bi)
        let termStart = blockStart + X64BodyOpRangeSize(bodyIR, block.opStart, block.opStart + block.opCount)
        let functionBase = posRaw - termStart
        let trueByte = functionBase + x64BodyBlockStartOrNext(bodyIR, term.trueBlock, termStart + termSize)
        let falseByte = functionBase + x64BodyBlockStartOrNext(bodyIR, term.falseBlock, termStart + termSize)
        # S5: fused Cbr — the preceding fused Cmp (block's last op) left the compare flags
        # live; branch straight with jcc(cmp true cc) -> trueByte (LocalNonZero: bool!=0
        # <=> compare true), no guard reload / cmp#0. Mirrors X64BodyCbrFusedAt in size.
        if X64BodyCbrFusedAt(bodyIR, termIndex):
            let cmpOp = bodyIR.ops[block.opStart + block.opCount - 1]
            let cmpKind = X64BodyCmpKind(bodyIR, cmpOp)
            if cmpKind == 2:
                return x64BodyFillF64FusedBranch(words, posRaw,
                                                 cmpOp.operands[0],
                                                 trueByte, falseByte)
            if cmpKind != 1:
                return -1
            let fusedCC = X64BodyCondTrueCC(cmpOp.operands[0])
            if fusedCC < 0:
                return -1
            var fusedPos = x64bJccRel32(words, posRaw, fusedCC, trueByte - (posRaw + 6))
            if fusedPos < 0:
                return -1
            return x64bJmpRel32(words, fusedPos, falseByte - (fusedPos + 5))
        var lhsSlot = term.lhsSlot
        if lhsSlot < 0:
            lhsSlot = term.resultSlot
        var pos = x64BodyLoadSlotToReg(words, posRaw, bodyIR, lhsSlot, X64BodyRAX, paramSaveOffset, 0)
        if pos < 0:
            return -1
        var lhsIs64: bool
        let lhsSlotType = x64BodySlotType(bodyIR, lhsSlot)
        if lhsSlotType == coreir.LocalI64Tag || lhsSlotType == coreir.LocalPtrTag:
            lhsIs64 = true
        if term.conditionKind == coreir.BodyCondLocalNonZeroTag ||
           term.conditionKind == coreir.BodyCondLocalZeroTag:
            pos = x64bCmpImm32(words, pos, X64BodyRAX, 0, lhsIs64)
            if pos < 0:
                return -1
            var cc = X64BodyCcNe
            if term.conditionKind == coreir.BodyCondLocalZeroTag:
                cc = X64BodyCcE
            pos = x64bJccRel32(words, pos, cc, trueByte - (pos + 6))
            if pos < 0:
                return -1
            return x64bJmpRel32(words, pos, falseByte - (pos + 5))
        if term.conditionKind >= coreir.BodyCondI32EqTag &&
           term.conditionKind <= coreir.BodyCondU64GeTag:
            let condCC = X64BodyCondTrueCC(term.conditionKind)
            if condCC < 0:
                return -1
            if term.rhsSlot >= 0:
                pos = x64BodyLoadSlotToReg(words, pos, bodyIR, term.rhsSlot, X64BodyRCX, paramSaveOffset, 0)
                if pos < 0:
                    return -1
                var cmpIs64 = lhsIs64
                let rhsSlotType = x64BodySlotType(bodyIR, term.rhsSlot)
                if rhsSlotType == coreir.LocalI64Tag || rhsSlotType == coreir.LocalPtrTag:
                    cmpIs64 = true
                pos = x64bCmpRR(words, pos, X64BodyRAX, X64BodyRCX, cmpIs64)
            else:
                var rhsConst = 0
                if term.operands.len > 0:
                    rhsConst = term.operands[0]
                pos = x64bCmpImm32(words, pos, X64BodyRAX, rhsConst, lhsIs64)
            if pos < 0:
                return -1
            pos = x64bJccRel32(words, pos, condCC, trueByte - (pos + 6))
            if pos < 0:
                return -1
            return x64bJmpRel32(words, pos, falseByte - (pos + 5))
        return -1
    if term.kind == coreir.BodyTermBrTag:
        # segment-b: byte-domain block starts, no ×4.
        let blockStart = X64BodyBlockStart(bodyIR, bi)
        let termStart = blockStart + X64BodyOpRangeSize(bodyIR, block.opStart, block.opStart + block.opCount)
        let functionBase = posRaw - termStart
        let termSize = X64BodyTermSize(bodyIR, termIndex)
        let targetByte = functionBase + x64BodyBlockStartOrNext(bodyIR, term.trueBlock, termStart + termSize)
        return x64bJmpRel32(words, posRaw, targetByte - (posRaw + 5))
    if term.kind == coreir.BodyTermReturnTag:
        return x64BodyFillBlockTermReturn(words, posRaw, term, bodyIR, paramSaveOffset, frameBytes)
    return -1

# ---------- prologue / function fill ----------

@borrows
fn x64BodyFillPrologue(words: var int32[],
                       posRaw: int32,
                       bodyIR: coreir.BodyIR): int32 =
    let frameBytes = X64BodyFrameBytes(bodyIR)
    let paramSaveOffset = X64BodyParamSaveOffset(bodyIR)
    let returnBufferOffset = X64BodyReturnBufferSaveOffset(bodyIR)
    if posRaw < 0 || frameBytes <= 0 || returnBufferOffset < 0:
        return -1
    var pos = x64bPut8(words, posRaw, 0x55)
    pos = x64bPut8(words, pos, 0x48)
    pos = x64bPut8(words, pos, 0x89)
    pos = x64bPut8(words, pos, 0xE5)
    pos = x64bRspImm32(words, pos, 5, frameBytes)
    let paramCount = X64BodyParamCount(bodyIR)
    let regAvail = X64BodyRegParamAvail(bodyIR)
    var shift: int32
    if X64BodyHasSret(bodyIR):
        shift = 1
    var paramIndex: int32
    while paramIndex < paramCount:
        let paramByteOffset = X64BodyCheckedMul8(paramIndex)
        let paramHomeOffset = X64BodyCheckedAddNonNegative(paramSaveOffset,
                                                           paramByteOffset)
        if paramByteOffset < 0 || paramHomeOffset < 0:
            return -1
        if paramIndex < regAvail:
            pos = x64bStore64(words, pos, X64BodyArgReg(paramIndex + shift), X64BodyRSP, paramHomeOffset)
        else:
            let incomingIndex = paramIndex - regAvail
            let incomingByteOffset = X64BodyCheckedMul8(incomingIndex)
            let incomingBase = X64BodyCheckedAddNonNegative(frameBytes, 16)
            let incomingOffset = X64BodyCheckedAddNonNegative(incomingBase,
                                                               incomingByteOffset)
            if incomingByteOffset < 0 || incomingBase < 0 || incomingOffset < 0:
                return -1
            pos = x64bLoad64(words, pos, X64BodyRAX, X64BodyRSP, incomingOffset)
            pos = x64bStore64(words, pos, X64BodyRAX, X64BodyRSP, paramHomeOffset)
        if pos < 0:
            return -1
        paramIndex = paramIndex + 1
    pos = x64bStore64(words, pos, X64BodyRDI, X64BodyRSP, returnBufferOffset)
    return pos

@borrows
fn X64BodyFillWords(words: var int32[],
                    wordOffset: int32,
                    wordCount: int32,
                    bodyIR: coreir.BodyIR): int32 =
    # segment-b: byte-packed interior. Ops/terms emit exactly their byte size
    # (X64BodyOpSizeAt / X64BodyTermSize are byte-exact now); any mismatch is a
    # loud desync (pos != opEndPos). The function TAIL is padded to a word so the
    # next function stays 4-byte aligned and functionWordOffsets remain word units.
    if !X64BodyProductionAdmission(bodyIR):
        return -1
    if !bodyIR.x64StackLayoutReady || !bodyIR.x64BlockStartReady ||
       bodyIR.x64SlotReadCnt.len != bodyIR.localSlots.len ||
       bodyIR.x64BlockByteStart.len != bodyIR.blocks.len:
        panic("x64 stack layout is not prepared")
    let prologueBytes = X64BodyPrologueByteCount(bodyIR)
    let frameBytes = X64BodyFrameBytes(bodyIR)
    let paramSaveOffset = X64BodyParamSaveOffset(bodyIR)
    if wordOffset < 0 || wordCount < X64BodyWordsOfChecked(prologueBytes) || frameBytes <= 0:
        return -1
    let endWord = X64BodyCheckedAddNonNegative(wordOffset, wordCount)
    if endWord < 0 || endWord > words.len:
        return -1
    let base = x64BodyCheckedMul4(wordOffset)
    let functionByteCount = x64BodyCheckedMul4(wordCount)
    let funcEnd = X64BodyCheckedAddNonNegative(base, functionByteCount)
    if base < 0 || functionByteCount < 0 || funcEnd < 0:
        return -1
    var pos = x64BodyFillPrologue(words, base, bodyIR)
    if pos != base + prologueBytes:
        return -1
    for bi in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[bi]
        if block.opStart < 0 || block.opCount < 0 ||
           block.opCount > bodyIR.ops.len ||
           block.opStart > bodyIR.ops.len - block.opCount:
            return -1
        let opEnd = block.opStart + block.opCount
        # per-block-start pos-assert (Step C, env-gated, byte-neutral): the emit
        # cursor must equal the predictor's block byte start (x64BlockByteStart
        # holds byte offsets from function start; base is the function byte base).
        # Today (no per-block reload prefix) this invariant always holds — this is
        # the load-bearing baseline Phase2 reload will turn into the active check.
        # Off => skipped entirely => zero byte delta. On + desync => return -1.
        if X64BodyPosAssertEnabled():
            if pos != base + X64BodyBlockStart(bodyIR, bi):
                return -1
        for oi in block.opStart..<opEnd:
            let opSize = X64BodyOpSizeAt(bodyIR, oi)
            if opSize <= 0:
                return -1
            let opEndPos = pos + opSize
            pos = x64BodyFillBlockOp(words, pos, bodyIR, oi, paramSaveOffset, frameBytes)
            if pos != opEndPos:
                return -1
        let termSize = X64BodyTermSize(bodyIR, block.termIndex)
        if termSize <= 0:
            return -1
        let termEndPos = pos + termSize
        pos = x64BodyFillBlockTerm(words, pos, bodyIR, bi, paramSaveOffset, frameBytes)
        if pos != termEndPos:
            return -1
    if pos < 0 || pos > funcEnd:
        return -1
    pos = x64bPadTo(words, pos, funcEnd)
    if pos != funcEnd:
        return -1
    return wordCount
