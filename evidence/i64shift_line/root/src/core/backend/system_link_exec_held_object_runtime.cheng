import std/strings
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/held_output_fd as heldfd
import cheng/core/backend/primary_object_csgc_emit as csgemit
import cheng/core/backend/system_link_exec as sexec
import cheng/core/backend/system_link_exec_runtime as runtime

@borrows
fn SystemLinkExecHeldObjectRuntimeDiscard(
        plan: var sexec.SystemLinkExecPlan,
        reason: str) =
    runtime.SystemLinkExecRuntimeDiscardPreparedPlan(plan, reason)

@borrows
fn SystemLinkExecHeldObjectRuntimeExecuteInto(
        out: var runtime.SystemLinkExecRuntimeResult,
        objectLease: var heldfd.HeldOutputFdLease,
        err: var str,
        plan: var sexec.SystemLinkExecPlan): bool =
    out = runtime.SystemLinkExecRuntimeResult()
    err = ""
    var leasePublishedForCaller = false
    defer:
        if !leasePublishedForCaller:
            heldfd.HeldOutputFdRetireOrPanic(
                objectLease,
                "held object runtime failure retire")
    if plan.systemLinkPlan.emitKind != creq.CompilerEmitObjValue():
        err = "held object runtime: only --emit:obj is supported"
        SystemLinkExecHeldObjectRuntimeDiscard(plan, err)
        return false
    if plan.systemLinkPlan.outputPath != "" ||
       plan.primaryObjectPlan.outputPath != "" ||
       plan.nativeLinkPlan.outputPath != "":
        err = "held object runtime: path output is forbidden"
        SystemLinkExecHeldObjectRuntimeDiscard(plan, err)
        return false
    var beginErr: str
    if !sexec.SystemLinkExecPlanBeginExecution(plan, beginErr):
        if sexec.SystemLinkExecPlanBeginDiscard(plan):
            runtime.SystemLinkExecRuntimeFinalize(
                plan, false, beginErr)
            out.payloadFinalizeReceipt = plan.payloadFinalizeReceipt
            out.compilerCsgLifetimeReceipt =
                plan.compilerCsgLifetimeReceipt
            out.compilerCsgLifetimeReceiptReady =
                plan.compilerCsgLifetimeReceiptReady
            out.loweringLifetimeReceipt =
                plan.loweringLifetimeReceipt
            out.loweringLifetimeReceiptReady =
                plan.loweringLifetimeReceiptReady
        err = beginErr
        return false
    var succeeded = false
    var bodyErr: str
    defer:
        # Each managed CallOp result in bodyErr moves once into the caller's
        # err place on failure.  Finalization borrows that destination rather
        # than re-reading the consumed CallOp definition.
        runtime.SystemLinkExecRuntimeFinalize(
            plan, succeeded, err)
        out.payloadFinalizeReceipt = plan.payloadFinalizeReceipt
        out.compilerCsgLifetimeReceipt =
            plan.compilerCsgLifetimeReceipt
        out.compilerCsgLifetimeReceiptReady =
            plan.compilerCsgLifetimeReceiptReady
        out.loweringLifetimeReceipt =
            plan.loweringLifetimeReceipt
        out.loweringLifetimeReceiptReady =
            plan.loweringLifetimeReceiptReady
    var objectBytes = rawbytes.EmptyBytes()
    defer:
        rawbytes.BytesFree(objectBytes)
    var objectSha256: str
    var objectByteCount: int32
    var symbolCount: int32
    var relocationCount: int32
    var factsRoot: str
    if !csgemit.PrimaryObjectCsgcEmitPlanObjectBytesInto(
           plan.primaryObjectPlan,
           objectBytes,
           objectSha256,
           objectByteCount,
           symbolCount,
           relocationCount,
           factsRoot,
           bodyErr):
        err = bodyErr
        return false
    var outputSha256: layout.FixedBytes32
    if !heldfd.HeldOutputFdPublishBytes(
           objectLease,
           objectBytes,
           objectSha256,
           outputSha256,
           bodyErr):
        err = bodyErr
        return false
    if objectByteCount != rawbytes.BytesLen(objectBytes):
        bodyErr = "held object runtime: emission byte count mismatch"
        err = bodyErr
        return false
    if !sexec.SystemLinkExecPlanFinalizeCompileReceiptInto(
           plan, outputSha256, bodyErr):
        err = bodyErr
        return false
    out.objectOnlyEmit = true
    out.primaryObjectDirect = true
    out.directObjectBytes = objectByteCount
    out.directObjectSymbolCount = symbolCount
    out.directObjectRelocCount = relocationCount
    out.providerParallelStatus = "none"
    out.outputSha256 = outputSha256
    out.sourceIdentityReceiptCid =
        plan.compileReceipt.sourceIdentityReceiptCid
    out.semanticReceiptCid = plan.compileReceipt.semanticReceiptCid
    out.sourceToCsgBindingSeal = plan.sourceToCsgBindingSeal
    out.worldHeadCid = plan.compileReceipt.worldHeadCid
    out.canonicalOutputDigest =
        plan.compileReceipt.canonicalOutputDigest
    out.compileReceiptCid = plan.compileReceipt.receiptCid
    out.planReport = sexec.SystemLinkExecPlanReport(plan)
    runtime.SystemLinkExecRuntimeAppendLine(
        out.planReport, "system_link_exec=1")
    runtime.SystemLinkExecRuntimeAppendLine(
        out.planReport, "real_backend_codegen=1")
    runtime.SystemLinkExecRuntimeAppendLine(
        out.planReport, "full_backend_codegen=1")
    runtime.SystemLinkExecRuntimeAppendLine(
        out.planReport, "held_object_output=1")
    runtime.SystemLinkExecRuntimeAppendLine(
        out.planReport, "held_object_output_path_credit=0")
    runtime.SystemLinkExecRuntimeAppendLine(
        out.planReport,
        strings.ConcatStr(
            "held_object_output_csgc_facts_root=", factsRoot))
    succeeded = true
    leasePublishedForCaller = true
    err = ""
    return true
