const
    SystemLinkExecRuntimeWindowsPrimaryObjectCacheVersion = "windows-primary-object-cache"
    SystemLinkExecRuntimeGLineBlocked = 0
    SystemLinkExecRuntimeGLineReady = 1

type
    SystemLinkExecRuntimeExactTextIndexMetrics =
        buildCount: int64
        queryCount: int64
        sortComparisonCount: int64
        lookupComparisonCount: int64
        maxLookupComparisons: int32
        retainedBytesEstimate: int64
        liveRetainedBytesEstimate: int64
        peakRetainedBytesEstimate: int64
        compositeKeyBytes: int64
        instanceCount: int32
        releaseCount: int32
        rssGateEligible: int32
        sealed: bool
        released: bool

    SystemLinkExecRuntimeIndexMetrics =
        providerPath: SystemLinkExecRuntimeExactTextIndexMetrics
        relocDefinition: SystemLinkExecRuntimeExactTextIndexMetrics
        relocRoot: SystemLinkExecRuntimeExactTextIndexMetrics
        nativeInput: SystemLinkExecRuntimeExactTextIndexMetrics

    SystemLinkExecRuntimeExactTextIndex =
        entryKeys: str[]
        entryRows: int32[]
        sortedEntryOrdinals: int32[]
        ownedKeyPayloadBytes: int64
        sealed: bool
        metrics: SystemLinkExecRuntimeExactTextIndexMetrics

    SystemLinkExecRuntimeResult =
        providerCompilerPath: str
        primaryObjectPath: str
        primaryObjectAsmPath: str
        primaryObjectCompileLogPath: str
        primaryObjectCacheStatus: str
        primaryObjectCachePath: str
        providerObjectPaths: str[]
        providerCompileLogPaths: str[]
        nativeLinkLogPath: str
        nativeLinkerSelf: bool
        lineMapPath: str
        primaryObjectNs: int64
        providerObjectsNs: int64
        nativeLinkNs: int64
        lineMapNs: int64
        providerParallelStatus: str
        providerParallelJobCount: int32
        providerParallelTaskCount: int32
        providerParallelActiveWorkers: int32
        providerParallelCompletedWorkers: int32
        standaloneDirectEntry: bool
        objectOnlyEmit: bool
        primaryObjectDirect: bool
        directObjectBytes: int32
        directObjectSymbolCount: int32
        directObjectRelocCount: int32
        debugObject: direct.DirectObjectEmitResult
        debugEmissionReceipt: debugreceipt.DebugObjectEmissionReceipt
        providerObjectCacheStatus: str
        providerObjectCacheHitCount: int32
        providerObjectCacheMissCount: int32
        rssExecuteBeginBytes: int64
        rssAfterProviderBytes: int64
        rssAfterPrimaryBytes: int64
        rssBeforeNativeLinkBytes: int64
        rssAfterNativeLinkBytes: int64
        rssAfterLineMapBytes: int64
        outputSha256: layout.FixedBytes32
        sourceIdentityReceiptCid: layout.FixedBytes32
        semanticReceiptCid: layout.FixedBytes32
        sourceToCsgBindingSeal: layout.FixedBytes32
        worldHeadCid: layout.FixedBytes32
        canonicalOutputDigest: layout.FixedBytes32
        compileReceiptCid: layout.FixedBytes32
        planReport: str
        payloadFinalizeReceipt: sexec.SystemLinkExecPayloadFinalizeReceipt
        compilerCsgLifetimeReceipt: compilerlife.CompilerPayloadLifecycleReceipt
        compilerCsgLifetimeReceiptReady: bool
        loweringLifetimeReceipt: compilerlife.CompilerPayloadLifecycleReceipt
        loweringLifetimeReceiptReady: bool
        terminalMemoryCounters: system.RuntimeMemoryCounters
        indexMetrics: SystemLinkExecRuntimeIndexMetrics

    SystemLinkExecRuntimeProviderTaskResult =
        completed: bool
        ok: bool
        fromCache: bool
        providerSourceClosureSha256: layout.FixedBytes32
        providerModule: str
        sourcePath: str
        objectPath: str
        logPath: str
        errorMessage: str
        exportRoots: str[]
        relocDefinitionMetrics: SystemLinkExecRuntimeExactTextIndexMetrics
        relocRootMetrics: SystemLinkExecRuntimeExactTextIndexMetrics

    SystemLinkExecRuntimeProviderParallelContext = object
        rootDir: str
        compilerPath: str
        packageRoot: str
        targetTriple: str
        results: SystemLinkExecRuntimeProviderTaskResult[]
        shardHeads: atomic.I32[]
        shardTails: atomic.I32[]
        doneCount: atomic.I32
        taskCount: int32
        workerCount: int32

var systemLinkExecRuntimeProviderParallelCurrent: SystemLinkExecRuntimeProviderParallelContext
var systemLinkExecRuntimeProviderWorkerNext: atomic.I32

fn SystemLinkExecRuntimeBoolText(value: bool): str =
    if value:
        return "1"
    return "0"

fn SystemLinkExecRuntimeGLineFactsValid(
        providerTaskCount: int32,
        providerActiveWorkers: int32): bool =
    return providerTaskCount >= 0 && providerActiveWorkers >= 0

fn SystemLinkExecRuntimeGLineState(
        providerTaskCount: int32,
        providerActiveWorkers: int32,
        objectOnlyEmit: bool): int32 =
    if !SystemLinkExecRuntimeGLineFactsValid(
           providerTaskCount, providerActiveWorkers):
        panic("system_link_exec_runtime_g_line_negative_fact")
    let providerReady =
        providerTaskCount > 0 && providerActiveWorkers > 0
    # emit=obj has no provider/native-link phase; lowering+codegen is the
    # complete hot path.  Both branches collapse to one scalar ownership-free
    # state before any managed report text is materialized.
    if providerReady || objectOnlyEmit:
        return SystemLinkExecRuntimeGLineReady
    return SystemLinkExecRuntimeGLineBlocked

fn SystemLinkExecRuntimeGLineStatusText(state: int32): str =
    if state == SystemLinkExecRuntimeGLineReady:
        return "ready"
    if state == SystemLinkExecRuntimeGLineBlocked:
        return "blocked"
    panic("system_link_exec_runtime_g_line_status_state_invalid")

fn SystemLinkExecRuntimeGLineBlockerText(state: int32): str =
    if state == SystemLinkExecRuntimeGLineReady:
        return ""
    if state == SystemLinkExecRuntimeGLineBlocked:
        return "provider_hot_path_not_covered"
    panic("system_link_exec_runtime_g_line_blocker_state_invalid")

fn SystemLinkExecRuntimeExactTextIndexValidateCapacity(entryLimit: int32) =
    if entryLimit < 0 || entryLimit > int32(536870911):
        panic("system_link_exec_runtime_exact_text_index_capacity_overflow")

fn SystemLinkExecRuntimeExactTextIndexInit(entryLimit: int32): SystemLinkExecRuntimeExactTextIndex =
    SystemLinkExecRuntimeExactTextIndexValidateCapacity(entryLimit)
    var out: SystemLinkExecRuntimeExactTextIndex
    reserve(out.entryKeys, entryLimit)
    reserve(out.entryRows, entryLimit)
    reserve(out.sortedEntryOrdinals, entryLimit)
    out.metrics.instanceCount = 1
    out.metrics.rssGateEligible = 0
    return out

@borrows
fn SystemLinkExecRuntimeExactTextLess(left: str,
                                      right: str): bool =
    if left == right:
        return false
    let leftLen = len(left)
    let rightLen = len(right)
    var sharedLen = rightLen
    if leftLen < rightLen:
        sharedLen = leftLen
    for i in 0..<sharedLen:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte == rightByte:
            continue
        return leftByte < rightByte
    return leftLen < rightLen

fn SystemLinkExecRuntimeExactTextOrdinalLess(keys: var str[],
                                             leftOrdinal: int32,
                                             rightOrdinal: int32): bool =
    let leftKey = keys[leftOrdinal]
    let rightKey = keys[rightOrdinal]
    if leftKey == rightKey:
        return leftOrdinal < rightOrdinal
    return SystemLinkExecRuntimeExactTextLess(leftKey, rightKey)

fn SystemLinkExecRuntimeExactTextMergePass(keys: var str[],
                                           src: var int32[],
                                           dst: var int32[],
                                           width: int32,
                                           comparisonCount: var int64) =
    let count = src.len
    var leftStart: int32
    while leftStart < count:
        let midRaw = leftStart + width
        var mid = count
        if midRaw < count:
            mid = midRaw
        let rightEndRaw = leftStart + width * 2
        var rightEnd = count
        if rightEndRaw < count:
            rightEnd = rightEndRaw
        var left = leftStart
        var right = mid
        for outIndex in leftStart..<rightEnd:
            var takeLeft = left < mid
            if takeLeft && right < rightEnd:
                comparisonCount = comparisonCount + int64(1)
                takeLeft = !SystemLinkExecRuntimeExactTextOrdinalLess(keys,
                                                                       src[right],
                                                                       src[left])
            if takeLeft:
                dst[outIndex] = src[left]
                left = left + 1
            else:
                dst[outIndex] = src[right]
                right = right + 1
        leftStart = leftStart + width * 2

fn SystemLinkExecRuntimeExactTextIndexRetainedBytesEstimate(
        index: var SystemLinkExecRuntimeExactTextIndex,
        scratchOrdinalCapacity: int32): int64 =
    # Cheng str is a 24-byte value. This remains a capacity estimate, not RSS.
    return int64(index.entryKeys.cap) * int64(24) +
           int64(index.entryRows.cap) * int64(4) +
           int64(index.sortedEntryOrdinals.cap) * int64(4) +
           int64(scratchOrdinalCapacity) * int64(4) +
           index.ownedKeyPayloadBytes

fn SystemLinkExecRuntimeExactTextIndexSeal(
        index: var SystemLinkExecRuntimeExactTextIndex,
        rejectDuplicates: bool,
        duplicateKey: var str,
        firstRow: var int32,
        duplicateRow: var int32): bool =
    duplicateKey = ""
    firstRow = -1
    duplicateRow = -1
    if index.metrics.released:
        panic("system_link_exec_runtime_exact_text_index_seal_after_release")
    if index.sealed:
        panic("system_link_exec_runtime_exact_text_index_sealed_more_than_once")
    let count = index.entryKeys.len
    if count != index.entryRows.len:
        panic("system_link_exec_runtime_exact_text_index_entry_shape_corrupt")
    var entryKeys = share(index.entryKeys)
    index.entryKeys = []
    var sortedEntryOrdinals = share(index.sortedEntryOrdinals)
    index.sortedEntryOrdinals = []
    setLen(sortedEntryOrdinals, count)
    var scratch: int32[]
    setLen(scratch, count)
    for i in 0..<count:
        sortedEntryOrdinals[i] = i
        scratch[i] = i
    index.entryKeys = entryKeys
    entryKeys = []
    index.sortedEntryOrdinals = sortedEntryOrdinals
    sortedEntryOrdinals = []
    let peakEstimate = SystemLinkExecRuntimeExactTextIndexRetainedBytesEstimate(
        index,
        scratch.cap)
    entryKeys = share(index.entryKeys)
    index.entryKeys = []
    sortedEntryOrdinals = share(index.sortedEntryOrdinals)
    index.sortedEntryOrdinals = []
    var width: int32 = 1
    var readScratch = false
    var sortComparisons: int64
    while width < count:
        if readScratch:
            SystemLinkExecRuntimeExactTextMergePass(entryKeys,
                                                     scratch,
                                                     sortedEntryOrdinals,
                                                     width,
                                                     sortComparisons)
        else:
            SystemLinkExecRuntimeExactTextMergePass(entryKeys,
                                                     sortedEntryOrdinals,
                                                     scratch,
                                                     width,
                                                     sortComparisons)
        readScratch = !readScratch
        if width > count / 2:
            width = count
        else:
            width = width * 2
    if readScratch:
        for i in 0..<count:
            sortedEntryOrdinals[i] = scratch[i]
    seqs.freeSeq(scratch)
    index.entryKeys = entryKeys
    entryKeys = []
    index.sortedEntryOrdinals = sortedEntryOrdinals
    sortedEntryOrdinals = []
    index.metrics.sortComparisonCount =
        index.metrics.sortComparisonCount + sortComparisons
    index.sealed = true
    index.metrics.sealed = true
    index.metrics.retainedBytesEstimate =
        SystemLinkExecRuntimeExactTextIndexRetainedBytesEstimate(index, 0)
    index.metrics.liveRetainedBytesEstimate = index.metrics.retainedBytesEstimate
    index.metrics.peakRetainedBytesEstimate = peakEstimate
    if rejectDuplicates && count > 1:
        for sortedIndex in 1..<count:
            let previousOrdinal = index.sortedEntryOrdinals[sortedIndex - 1]
            let currentOrdinal = index.sortedEntryOrdinals[sortedIndex]
            if index.entryKeys[previousOrdinal] == index.entryKeys[currentOrdinal]:
                duplicateKey = strings.CloneStr(index.entryKeys[currentOrdinal])
                firstRow = index.entryRows[previousOrdinal]
                duplicateRow = index.entryRows[currentOrdinal]
                return false
    return true

@borrows
fn SystemLinkExecRuntimeExactTextIndexFind(index: var SystemLinkExecRuntimeExactTextIndex,
                                            key: str,
                                            countQuery: bool): int32 =
    if countQuery:
        index.metrics.queryCount = index.metrics.queryCount + int64(1)
    if index.metrics.released:
        panic("system_link_exec_runtime_exact_text_index_find_after_release")
    if !index.sealed:
        panic("system_link_exec_runtime_exact_text_index_find_before_seal")
    var low: int32
    var high = index.sortedEntryOrdinals.len
    var comparisons: int32
    while low < high:
        let mid = low + (high - low) / 2
        let ordinal = index.sortedEntryOrdinals[mid]
        comparisons = comparisons + 1
        if SystemLinkExecRuntimeExactTextLess(index.entryKeys[ordinal], key):
            low = mid + 1
        else:
            high = mid
    index.metrics.lookupComparisonCount =
        index.metrics.lookupComparisonCount + int64(comparisons)
    if comparisons > index.metrics.maxLookupComparisons:
        index.metrics.maxLookupComparisons = comparisons
    if low < index.sortedEntryOrdinals.len:
        let ordinal = index.sortedEntryOrdinals[low]
        if index.entryKeys[ordinal] == key:
            return ordinal
    return -1

@borrows
fn SystemLinkExecRuntimeExactTextIndexInsert(index: var SystemLinkExecRuntimeExactTextIndex,
                                              key: str,
                                              sourceRow: int32,
                                              ownsKeyPayload: bool,
                                              existingRow: var int32): bool =
    if index.metrics.released:
        panic("system_link_exec_runtime_exact_text_index_insert_after_release")
    if index.sealed:
        panic("system_link_exec_runtime_exact_text_index_insert_after_seal")
    index.metrics.buildCount = index.metrics.buildCount + int64(1)
    let keyPayloadBytes = int64(len(key))
    add(index.entryKeys, strings.CloneStr(key))
    add(index.entryRows, sourceRow)
    if ownsKeyPayload:
        index.ownedKeyPayloadBytes =
            index.ownedKeyPayloadBytes + keyPayloadBytes
    existingRow = -1
    return true

@borrows
fn SystemLinkExecRuntimeExactTextIndexInsertBorrowed(
        index: var SystemLinkExecRuntimeExactTextIndex,
        key: str,
        sourceRow: int32,
        existingRow: var int32): bool =
    return SystemLinkExecRuntimeExactTextIndexInsert(
        index,
        strings.CloneStr(key),
        sourceRow,
        true,
        existingRow)

fn SystemLinkExecRuntimeExactTextIndexRelease(index: var SystemLinkExecRuntimeExactTextIndex): SystemLinkExecRuntimeExactTextIndexMetrics =
    if index.metrics.released:
        panic("system_link_exec_runtime_exact_text_index_double_release")
    let retainedEstimate =
        SystemLinkExecRuntimeExactTextIndexRetainedBytesEstimate(index, 0)
    index.metrics.retainedBytesEstimate = retainedEstimate
    index.metrics.liveRetainedBytesEstimate = retainedEstimate
    if retainedEstimate > index.metrics.peakRetainedBytesEstimate:
        index.metrics.peakRetainedBytesEstimate = retainedEstimate
    index.metrics.compositeKeyBytes = int64(0)
    seqs.freeSeq(index.entryKeys)
    seqs.freeSeq(index.entryRows)
    seqs.freeSeq(index.sortedEntryOrdinals)
    index.ownedKeyPayloadBytes = int64(0)
    index.metrics.liveRetainedBytesEstimate = int64(0)
    index.metrics.releaseCount = index.metrics.releaseCount + 1
    index.metrics.rssGateEligible = 0
    index.metrics.released = true
    return index.metrics

fn SystemLinkExecRuntimeExactTextMetricsAccumulate(target: var SystemLinkExecRuntimeExactTextIndexMetrics,
                                                    delta: SystemLinkExecRuntimeExactTextIndexMetrics) =
    let targetHadInstances = target.instanceCount > 0
    target.buildCount = target.buildCount + delta.buildCount
    target.queryCount = target.queryCount + delta.queryCount
    target.sortComparisonCount = target.sortComparisonCount + delta.sortComparisonCount
    target.lookupComparisonCount = target.lookupComparisonCount + delta.lookupComparisonCount
    if delta.maxLookupComparisons > target.maxLookupComparisons:
        target.maxLookupComparisons = delta.maxLookupComparisons
    target.retainedBytesEstimate = target.retainedBytesEstimate + delta.retainedBytesEstimate
    target.liveRetainedBytesEstimate = target.liveRetainedBytesEstimate + delta.liveRetainedBytesEstimate
    target.peakRetainedBytesEstimate = target.peakRetainedBytesEstimate + delta.peakRetainedBytesEstimate
    target.compositeKeyBytes = target.compositeKeyBytes + delta.compositeKeyBytes
    target.instanceCount = target.instanceCount + delta.instanceCount
    target.releaseCount = target.releaseCount + delta.releaseCount
    target.rssGateEligible = 0
    if delta.instanceCount > 0:
        if targetHadInstances:
            target.sealed = target.sealed && delta.sealed
        else:
            target.sealed = delta.sealed
    target.released = target.instanceCount > 0 &&
                      target.releaseCount == target.instanceCount

@borrows
fn SystemLinkExecRuntimeCanonicalPath(rootDir: str,
                                      raw: str): str =
    return creq.CompilerExactFunctionNormalizePath(share(rootDir), share(raw))

@borrows
fn SystemLinkExecRuntimeEnvFlagEnabled(name: str): bool =
    let raw = strutil.Strip(os.GetEnv(name))
    if len(raw) <= 0:
        return false
    if raw == "0" || raw == "false" || raw == "FALSE":
        return false
    return true

fn SystemLinkExecRuntimeNoCacheEnabled(): bool =
    if SystemLinkExecRuntimeEnvFlagEnabled("CHENG_SYSTEM_LINK_EXEC_NO_CACHE"):
        return true
    if SystemLinkExecRuntimeEnvFlagEnabled("CHENG_STRICT_NO_CACHE"):
        return true
    return SystemLinkExecRuntimeEnvFlagEnabled("CHENG_NO_CACHE")

fn SystemLinkExecRuntimePrimaryObjectCacheDisabled(): bool =
    if SystemLinkExecRuntimeNoCacheEnabled():
        return true
    return SystemLinkExecRuntimeEnvFlagEnabled("CHENG_DISABLE_WINDOWS_PRIMARY_OBJECT_CACHE")

fn SystemLinkExecRuntimeProviderObjectCacheDisabled(): bool =
    if SystemLinkExecRuntimeNoCacheEnabled():
        return true
    return SystemLinkExecRuntimeEnvFlagEnabled("CHENG_DISABLE_PROVIDER_OBJECT_CACHE")

# CSG 生产链 capability 原子切换(域 E,阶段一)。held-exec child 是唯一生产
# 命令上下文;其中 provider 源/对象字节必须只来自 held bundle(tag 14),
# 严禁路径探测/现场读取。bundle 校验(依赖域 A decode view/域 B 递送)接通
# 前,生产上下文中且无 live CLAIMED lease 的到达一律 HARD_RED;非生产开发
# 命令(无 child admission)行为不变。阶段二由 bundle 校验物理替换。
fn SystemLinkExecRuntimeProductionPathAccessRetired(): bool =
    if !system.RuntimeHeldExecChildAdmissionActive():
        return false
    return merkle_store.ProductionAdmittedClaimAuthorityStateCurrent() !=
           merkle_store.ProductionAdmittedClaimStateClaimed

@borrows
fn SystemLinkExecRuntimeHostFileNonEmpty(path: str): bool =
    if len(path) <= 0:
        return false
    let hostPath = chengpath.PathHostFilePath(path)
    if len(hostPath) <= 0:
        return false
    return os.FileSize(hostPath) > int64(0)

fn SystemLinkExecRuntimePathIsSepChar(ch: char): bool =
    if ch == '/':
        return true
    if ch == '\\':
        return true
    return false

@borrows
fn SystemLinkExecRuntimeEnsureDirSegment(path: str, stop: int32): bool =
    if stop <= 0:
        return true
    let dir = strings.SliceBytes(path, 0, stop)
    if len(dir) <= 0:
        return true
    if os.DirExists(dir):
        return true
    if os.FileExists(dir):
        return false
    let made = os.MakeDir(dir)
    if made:
        return os.DirExists(dir)
    return os.DirExists(dir)

@borrows
fn SystemLinkExecRuntimeEnsureDirAll(path: str): bool =
    if len(path) <= 0:
        return false
    if os.DirExists(path):
        return true
    if os.FileExists(path):
        return false
    for i in 0..<path.len:
        if SystemLinkExecRuntimePathIsSepChar(path[i]):
            if i > 0:
                var skip = false
                if i == 2:
                    if path[1] == ':':
                        skip = true
                if !skip:
                    if !SystemLinkExecRuntimeEnsureDirSegment(path, i):
                        return false
    if !SystemLinkExecRuntimeEnsureDirSegment(path, path.len):
        return false
    return os.DirExists(path)

fn SystemLinkExecRuntimeNowNs(): int64 =
    return sexec.SystemLinkExecNowNs()

fn SystemLinkExecRuntimePhaseMsText(ns: int64): str =
    if ns <= int64(0):
        return "0"
    return int64ToStr(ns / int64(1000000))

fn SystemLinkExecRuntimeRssBytes(): int64 =
    return hostops.HostOpsCurrentRssBytes()

@borrows
fn SystemLinkExecRuntimeAppendLine(out: var str, line: str) =
    if len(out) > 0:
        out = Fmt"{out}\n"
    out = Fmt"{out}{line}"

@borrows
fn SystemLinkExecRuntimeAppendKeyValue(out: var str, key: str, value: str) =
    SystemLinkExecRuntimeAppendLine(out, Fmt"{key}={value}")

@borrows
fn SystemLinkExecRuntimeAppendBoolKeyValue(
        out: var str,
        key: str,
        value: bool) =
    if value:
        SystemLinkExecRuntimeAppendKeyValue(out, key, "1")
        return
    SystemLinkExecRuntimeAppendKeyValue(out, key, "0")

fn SystemLinkExecRuntimeAppendGLine(
        out: var str,
        state: int32) =
    if state == SystemLinkExecRuntimeGLineReady:
        SystemLinkExecRuntimeAppendKeyValue(
            out, "g_line_full_backend_parallel", "ready")
        SystemLinkExecRuntimeAppendKeyValue(
            out, "g_line_full_backend_parallel_blocker", "")
        return
    if state == SystemLinkExecRuntimeGLineBlocked:
        SystemLinkExecRuntimeAppendKeyValue(
            out, "g_line_full_backend_parallel", "blocked")
        SystemLinkExecRuntimeAppendKeyValue(
            out,
            "g_line_full_backend_parallel_blocker",
            "provider_hot_path_not_covered")
        return
    panic("system_link_exec_runtime_g_line_append_state_invalid")

@borrows
fn SystemLinkExecRuntimeCurrentExecutablePath(rootDir: str): str =
    let raw = strutil.Strip(cmdline.ProgramName())
    if len(raw) <= 0:
        return ""
    let resolved = hostops.ResolveProgram(rootDir, raw)
    if len(resolved) > 0:
        return resolved
    return chengpath.PathAbsolute(rootDir, raw)

@borrows
fn SystemLinkExecRuntimeResolveProviderCompiler(rootDir: str,
                                                 requestedCompilerPath: str): Result[str] =
    let requested = strutil.Strip(requestedCompilerPath)
    if len(requested) > 0:
        let absolute = chengpath.PathAbsolute(rootDir, requested)
        if chengpath.FileExistsNonEmpty(rootDir, absolute):
            return Ok[str](absolute)
        return Err[str](Fmt" system link exec runtime: missing provider compiler: {absolute}")
    let current = SystemLinkExecRuntimeCurrentExecutablePath(rootDir)
    if len(current) > 0 && chengpath.FileExistsNonEmpty(rootDir, current):
        return Ok[str](current)
    let stage3 = artifactpaths.ArtifactStage3Path(rootDir)
    if chengpath.FileExistsNonEmpty(rootDir, stage3):
        return Ok[str](stage3)
    return Err[str](" system link exec runtime: missing provider compiler/current stage3")

@borrows
fn SystemLinkExecRuntimeResolveWindowsPrimaryCompiler(
        rootDir: str,
        requestedCompilerPath: str): Result[str] =
    let requested = strutil.Strip(requestedCompilerPath)
    if len(requested) > 0:
        return SystemLinkExecRuntimeResolveProviderCompiler(rootDir, requested)
    let explicitCompiler = strutil.Strip(os.GetEnv("CHENG_WINDOWS_PRIMARY_OBJECT_COMPILER"))
    if len(explicitCompiler) > 0:
        return SystemLinkExecRuntimeResolveProviderCompiler(rootDir, explicitCompiler)
    let coldCompiler = strutil.Strip(os.GetEnv("CHENG_COLD_COMPILER"))
    if len(coldCompiler) > 0:
        return SystemLinkExecRuntimeResolveProviderCompiler(rootDir, coldCompiler)
    return Err[str](" system link exec runtime: Windows primary object fallback requires CHENG_COLD_COMPILER or CHENG_WINDOWS_PRIMARY_OBJECT_COMPILER")

@borrows
fn SystemLinkExecRuntimeResolveProviderObjectCompiler(rootDir: str,
                                                      plan: sexec.SystemLinkExecPlan,
                                                      requestedCompilerPath: str): Result[str] =
    if plan.systemLinkPlan.targetTriple == "x86_64-pc-windows-msvc":
        return SystemLinkExecRuntimeResolveWindowsPrimaryCompiler(
            rootDir,
            requestedCompilerPath)
    return SystemLinkExecRuntimeResolveProviderCompiler(rootDir,
                                                        requestedCompilerPath)

fn SystemLinkExecRuntimeCacheAppendU32BE(buf: var layout.ByteBuf,
                                          value: int32) =
    let byte0: int32 = (value >> 24) & 255
    let byte1: int32 = (value >> 16) & 255
    let byte2: int32 = (value >> 8) & 255
    let byte3: int32 = value & 255
    layout.ByteBufAppendByte(buf, byte0)
    layout.ByteBufAppendByte(buf, byte1)
    layout.ByteBufAppendByte(buf, byte2)
    layout.ByteBufAppendByte(buf, byte3)

@borrows
fn SystemLinkExecRuntimeCacheAppendText(buf: var layout.ByteBuf,
                                         text: str) =
    let data = BytesFromString(text)
    SystemLinkExecRuntimeCacheAppendU32BE(buf, BytesLen(data))
    layout.ByteBufAppendBytes(buf, data)

@borrows
fn SystemLinkExecRuntimeCacheAppendFixed32(buf: var layout.ByteBuf,
                                            value: layout.FixedBytes32) =
    layout.ByteBufAppendFixed32(buf, value)

@borrows
fn SystemLinkExecRuntimeCacheHashText(text: str): layout.FixedBytes32 =
    return hash256.Sha256Fixed(layout.ByteSpanFromBytes(BytesFromString(text)))

@borrows
fn SystemLinkExecRuntimeCacheSourceFileCid(rootDir: str, pathRaw: str): Result[layout.FixedBytes32] =
    let path = chengpath.PathTrim(pathRaw)
    if len(path) <= 0:
        return Err[layout.FixedBytes32](" system link exec runtime provider cache: empty source path")
    let sourceText = chengpath.ReadTextFile(rootDir, path)
    if len(sourceText) > 0:
        return Ok[layout.FixedBytes32](SystemLinkExecRuntimeCacheHashText(sourceText))
    let absolutePath = chengpath.PathAbsolute(rootDir, path)
    let hostPath = chengpath.PathHostFilePath(absolutePath)
    var bytesRes = os.ReadFileBytesResult(hostPath)
    if bytesRes.ok:
        var data: rawbytes.Bytes = bytesRes.value
        if rawbytes.BytesLen(data) > 0:
            let cid = hash256.Sha256Fixed(layout.ByteSpanFromBytes(data))
            rawbytes.BytesFree(data)
            return Ok[layout.FixedBytes32](cid)
        rawbytes.BytesFree(data)
    return Err[layout.FixedBytes32](Fmt" system link exec runtime provider cache: missing source path: {path}")

@borrows
fn SystemLinkExecRuntimeCacheAppendSourceFile(buf: var layout.ByteBuf,
                                               rootDir: str,
                                               relPath: str): Result[bool] =
    let path = chengpath.PathAbsolute(rootDir, relPath)
    let cidRes = SystemLinkExecRuntimeCacheSourceFileCid(rootDir, path)
    if !cidRes.ok:
        let errMsg = strings.CloneStr(cidRes.err.msg)
        return Err[bool](errMsg)
    let cid = cidRes.value
    SystemLinkExecRuntimeCacheAppendText(buf, relPath)
    SystemLinkExecRuntimeCacheAppendFixed32(buf, cid)
    return Ok[bool](true)

@borrows
fn SystemLinkExecRuntimeCacheAppendSourceFileAt(buf: var layout.ByteBuf,
                                                 rootDir: str,
                                                 sourcePaths: str[],
                                                 index: int32): Result[bool] =
    if index >= sourcePaths.len:
        return Ok[bool](true)
    let pathOwned = strings.CloneStr(sourcePaths[index])
    let sourceRes = SystemLinkExecRuntimeCacheAppendSourceFile(buf, rootDir, pathOwned)
    if !sourceRes.ok:
        let errMsg = strings.CloneStr(sourceRes.err.msg)
        return Err[bool](errMsg)
    return SystemLinkExecRuntimeCacheAppendSourceFileAt(buf, rootDir, sourcePaths, index + 1)

@borrows
fn SystemLinkExecRuntimeProviderCacheSchemaAbiCid(
        rootDir: str): Result[layout.FixedBytes32] =
    var buf = layout.ByteBufInit(4096)
    SystemLinkExecRuntimeCacheAppendText(
        buf,
        "cheng.system_link_exec_runtime.provider_object_cache.schema_abi")
    let sourcePaths: str[] = [
        "src/core/tooling/compiler_request.cheng",
        "src/core/backend/system_link_plan.cheng",
        "src/core/backend/system_link_exec.cheng",
        "src/core/backend/system_link_exec_runtime.cheng",
        "src/core/backend/object_plan.cheng",
        "src/core/backend/target_matrix.cheng",
        "src/core/ir/type_abi.cheng"
    ]
    let sourceRes = SystemLinkExecRuntimeCacheAppendSourceFileAt(buf, rootDir, sourcePaths, 0)
    if !sourceRes.ok:
        let errMsg = strings.CloneStr(sourceRes.err.msg)
        layout.ByteBufFree(buf)
        return Err[layout.FixedBytes32](errMsg)
    let schemaAbiCid =
        hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return Ok[layout.FixedBytes32](schemaAbiCid)

fn SystemLinkExecRuntimeTemporarySystemLinkPlanReleaseStrict(
        plan: var slplan.SystemLinkPlanStub): Result[bool] =
    var receipt: slplan.SystemLinkPlanReleaseReceipt
    slplan.SystemLinkPlanReleaseWithReceipt(plan, receipt)
    var err: str
    if !slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
            plan, receipt, err):
        return Err[bool](err)
    return Ok[bool](true)

@borrows
fn SystemLinkExecRuntimeSourceClosureSha256(
        rootDir: str,
        plan: sexec.SystemLinkExecPlan,
        sourcePath: str): Result[layout.FixedBytes32] =
    if len(chengpath.PathTrim(share(sourcePath))) <= 0:
        return Err[layout.FixedBytes32](
            " system link exec runtime provider cache: empty source closure entry")
    var req = creq.CompilerRequestNew(
        strings.CloneStr(rootDir),
        chengpath.PathAbsolute(rootDir, sourcePath),
        "",
        strings.CloneStr(plan.systemLinkPlan.targetTriple),
        creq.EmitObj,
        "")
    req.symbolVisibility = strings.CloneStr(plan.systemLinkPlan.symbolVisibility)
    creq.CompilerRequestSeal(req)
    var closurePlan: slplan.SystemLinkPlanStub
    var buildErr: str
    if !slplan.BuildSystemLinkPlanStubWithExternalPackageRoots(
            rootDir,
            req,
            plan.systemLinkPlan.externalPackageRoots,
            closurePlan,
            buildErr):
        return Err[layout.FixedBytes32](
            Fmt" system link exec runtime provider cache: source closure unavailable: {buildErr}")
    var bindingErr: str
    let bindingValid =
        slplan.SystemLinkPlanSourceBundleBindingValidInto(
            closurePlan, bindingErr)
    if !bindingValid:
        let invalidReleaseRes =
            SystemLinkExecRuntimeTemporarySystemLinkPlanReleaseStrict(
                closurePlan)
        if !invalidReleaseRes.ok:
            let invalidReleaseErr = strings.CloneStr(invalidReleaseRes.err.msg)
            return Err[layout.FixedBytes32](invalidReleaseErr)
        return Err[layout.FixedBytes32](
            Fmt" system link exec runtime provider cache: source closure binding invalid: {bindingErr}")
    var closureSha256: layout.FixedBytes32
    slplan.SystemLinkPlanSourceBundleCidValueCopyInto(closurePlan, closureSha256)
    let releaseRes =
        SystemLinkExecRuntimeTemporarySystemLinkPlanReleaseStrict(
            closurePlan)
    if !releaseRes.ok:
        let releaseErr = strings.CloneStr(releaseRes.err.msg)
        return Err[layout.FixedBytes32](releaseErr)
    var zeroCid: layout.FixedBytes32
    if layout.FixedBytes32Equal(closureSha256, zeroCid):
        return Err[layout.FixedBytes32](
            " system link exec runtime provider cache: source closure cid is zero")
    return Ok[layout.FixedBytes32](closureSha256)

@borrows
fn SystemLinkExecRuntimeCompilerSourceClosureSha256(
        rootDir: str,
        plan: sexec.SystemLinkExecPlan): Result[layout.FixedBytes32] =
    return SystemLinkExecRuntimeSourceClosureSha256(
        rootDir,
        plan,
        "src/core/tooling/backend_driver_main.cheng")

@borrows
fn SystemLinkExecRuntimeProviderCacheTargetCc(targetTriple: str): Result[str] =
    if strutil.Contains(targetTriple, "android") ||
       strutil.Contains(targetTriple, "ohos"):
        return Err[str](Fmt" system link exec runtime provider cache: target cc resolver not available: {targetTriple}")
    let cc = os.GetEnv("CC")
    if len(cc) > 0:
        return Ok[str](strings.CloneStr(cc))
    return Ok[str](strings.CloneStr("cc"))

@borrows
fn SystemLinkExecRuntimeCacheSafeTarget(targetTriple: str): str =
    var builder = rawbytes.BytesBuilderNew(len(targetTriple))
    for i in 0..<len(targetTriple):
        let ch = targetTriple[i]
        let digit = ch >= '0' && ch <= '9'
        let upper = ch >= 'A' && ch <= 'Z'
        let lower = ch >= 'a' && ch <= 'z'
        if digit || upper || lower:
            rawbytes.BytesBuilderAppendByte(builder, Int32(ch))
        else:
            rawbytes.BytesBuilderAppendByte(builder, Int32('_'))
    var payload = rawbytes.BytesBuilderFinish(builder)
    let out = rawbytes.BytesToString(payload)
    rawbytes.BytesFree(payload)
    return out

@borrows
fn SystemLinkExecRuntimeCacheAppendOwnedTextsAt(buf: var layout.ByteBuf,
                                                 texts: str[],
                                                 index: int32) =
    if index >= texts.len:
        return
    let owned = strings.CloneStr(texts[index])
    SystemLinkExecRuntimeCacheAppendText(buf, owned)
    SystemLinkExecRuntimeCacheAppendOwnedTextsAt(buf, texts, index + 1)

@borrows
fn SystemLinkExecRuntimeProviderObjectCacheKey(rootDir: str,
                                                plan: sexec.SystemLinkExecPlan,
                                                providerModule: str,
                                                sourcePath: str,
                                                exportRoots: str[],
                                                compilerSourceClosureSha256: layout.FixedBytes32,
                                                providerSourceClosureSha256: layout.FixedBytes32): Result[str] =
    let schemaAbiCidRes =
        SystemLinkExecRuntimeProviderCacheSchemaAbiCid(rootDir)
    if !schemaAbiCidRes.ok:
        return Err[str](strings.CloneStr(schemaAbiCidRes.err.msg))
    var zeroCid: layout.FixedBytes32
    if layout.FixedBytes32Equal(compilerSourceClosureSha256, zeroCid):
        return Err[str](
            " system link exec runtime provider cache: empty compiler source closure cid")
    if layout.FixedBytes32Equal(providerSourceClosureSha256, zeroCid):
        return Err[str](
            " system link exec runtime provider cache: empty provider source closure cid")
    let ccRes = SystemLinkExecRuntimeProviderCacheTargetCc(
        strings.CloneStr(plan.systemLinkPlan.targetTriple))
    if !ccRes.ok:
        return Err[str](strings.CloneStr(ccRes.err.msg))
    var buf = layout.ByteBufInit(1024)
    SystemLinkExecRuntimeCacheAppendText(
        buf,
        "cheng.system_link_exec_runtime.provider_object_cache")
    var schemaAbiCid: layout.FixedBytes32
    var schemaByte: int32
    while schemaByte < layout.FixedBytes32Size:
        schemaAbiCid.data[schemaByte] = schemaAbiCidRes.value.data[schemaByte]
        schemaByte = schemaByte + 1
    SystemLinkExecRuntimeCacheAppendFixed32(buf, schemaAbiCid)
    SystemLinkExecRuntimeCacheAppendFixed32(buf, compilerSourceClosureSha256)
    SystemLinkExecRuntimeCacheAppendFixed32(buf, providerSourceClosureSha256)
    SystemLinkExecRuntimeCacheAppendText(buf, strings.CloneStr(sourcePath))
    SystemLinkExecRuntimeCacheAppendText(buf, strings.CloneStr(plan.systemLinkPlan.workspaceRoot))
    SystemLinkExecRuntimeCacheAppendText(buf, strings.CloneStr(plan.systemLinkPlan.packageRoot))
    SystemLinkExecRuntimeCacheAppendText(buf, strings.CloneStr(plan.systemLinkPlan.packageId))
    SystemLinkExecRuntimeCacheAppendText(buf, strings.CloneStr(plan.systemLinkPlan.targetTriple))
    SystemLinkExecRuntimeCacheAppendText(buf, creq.CompilerEmitText(plan.systemLinkPlan.emitKind))
    SystemLinkExecRuntimeCacheAppendText(buf, strings.CloneStr(plan.systemLinkPlan.symbolVisibility))
    SystemLinkExecRuntimeCacheAppendText(buf, strings.CloneStr(providerModule))
    SystemLinkExecRuntimeCacheAppendU32BE(buf, exportRoots.len)
    SystemLinkExecRuntimeCacheAppendOwnedTextsAt(buf, exportRoots, 0)
    SystemLinkExecRuntimeCacheAppendText(buf, strings.CloneStr(ccRes.value))
    SystemLinkExecRuntimeCacheAppendU32BE(buf, 0)
    let keyCid = hash256.Sha256Fixed(layout.ByteBufView(buf))
    let key = layout.FixedBytes32Hex(keyCid)
    layout.ByteBufFree(buf)
    return Ok[str](key)

@borrows
fn SystemLinkExecRuntimeProviderObjectCachePath(rootDir: str,
                                                 plan: sexec.SystemLinkExecPlan,
                                                 providerModule: str,
                                                 sourcePath: str,
                                                 exportRoots: str[],
                                                 compilerSourceClosureSha256: layout.FixedBytes32,
                                                 providerSourceClosureSha256: layout.FixedBytes32): Result[str] =
    let keyRes = SystemLinkExecRuntimeProviderObjectCacheKey(rootDir,
                                                              plan,
                                                              providerModule,
                                                              sourcePath,
                                                              exportRoots,
                                                              compilerSourceClosureSha256,
                                                              providerSourceClosureSha256)
    if !keyRes.ok:
        return Err[str](strings.CloneStr(keyRes.err.msg))
    let key = strings.CloneStr(keyRes.value)
    let targetSafe = SystemLinkExecRuntimeCacheSafeTarget(
        strings.CloneStr(plan.systemLinkPlan.targetTriple))
    let cacheRoot = chengpath.PathAbsolute(rootDir, "artifacts/provider_object_cache")
    let targetDir = chengpath.PathJoin(cacheRoot, targetSafe)
    let objectName = Fmt"{key}.o"
    let objectPath = chengpath.PathJoin(targetDir, objectName)
    return Ok[str](objectPath)

@borrows
fn SystemLinkExecRuntimeWindowsPrimaryObjectCacheKey(rootDir: str,
                                                     compilerPath: str,
                                                     plan: sexec.SystemLinkExecPlan): Result[str] =
    let _ = rootDir
    var buf = layout.ByteBufInit(1024)
    SystemLinkExecRuntimeCacheAppendText(buf, SystemLinkExecRuntimeWindowsPrimaryObjectCacheVersion)
    SystemLinkExecRuntimeCacheAppendText(buf, strings.CloneStr(compilerPath))
    SystemLinkExecRuntimeCacheAppendText(buf, strings.CloneStr(plan.systemLinkPlan.entryPath))
    SystemLinkExecRuntimeCacheAppendText(buf, strings.CloneStr(plan.systemLinkPlan.workspaceRoot))
    SystemLinkExecRuntimeCacheAppendText(buf, strings.CloneStr(plan.systemLinkPlan.packageRoot))
    SystemLinkExecRuntimeCacheAppendText(buf, strings.CloneStr(plan.systemLinkPlan.packageId))
    SystemLinkExecRuntimeCacheAppendText(buf, strings.CloneStr(plan.systemLinkPlan.targetTriple))
    SystemLinkExecRuntimeCacheAppendText(buf, creq.CompilerEmitText(creq.EmitObj))
    SystemLinkExecRuntimeCacheAppendText(buf, strings.CloneStr(plan.systemLinkPlan.symbolVisibility))
    SystemLinkExecRuntimeCacheAppendText(buf, SystemLinkExecRuntimeWindowsPrimaryExportRoots(plan))
    var sourceBundleCid: layout.FixedBytes32
    var cidByte: int32
    while cidByte < layout.FixedBytes32Size:
        sourceBundleCid.data[cidByte] = plan.sourceBundleCid.data[cidByte]
        cidByte = cidByte + 1
    SystemLinkExecRuntimeCacheAppendFixed32(buf, sourceBundleCid)
    SystemLinkExecRuntimeCacheAppendU32BE(buf, 0)
    let keyCid = hash256.Sha256Fixed(layout.ByteBufView(buf))
    let key = layout.FixedBytes32Hex(keyCid)
    layout.ByteBufFree(buf)
    return Ok[str](key)

@borrows
fn SystemLinkExecRuntimeTextEndsWith(text: str, suffix: str): bool =
    if len(suffix) > len(text):
        return false
    let start = len(text) - len(suffix)
    for i in 0..<len(suffix):
        if text[start + i] != suffix[i]:
            return false
    return true

@borrows
fn SystemLinkExecRuntimeReplaceSuffix(text: str, suffix: str, replacement: str): str =
    if !SystemLinkExecRuntimeTextEndsWith(text, suffix):
        return strings.CloneStr(text)
    return strings.SliceBytes(text, 0, len(text) - len(suffix)) + replacement

@borrows
fn SystemLinkExecRuntimeWindowsPrimaryObjectCachePath(rootDir: str,
                                                      compilerPath: str,
                                                      plan: sexec.SystemLinkExecPlan): Result[str] =
    let keyRes = SystemLinkExecRuntimeWindowsPrimaryObjectCacheKey(rootDir, compilerPath, plan)
    if !keyRes.ok:
        return Err[str](strings.CloneStr(keyRes.err.msg))
    let _ = keyRes
    let rawPath = strings.CloneStr(plan.objectPlan.primaryObjectPath)
    let path1 = SystemLinkExecRuntimeReplaceSuffix(rawPath, "_pure_2.exe.primary.o", "_pure_1.exe.primary.o")
    let path2 = SystemLinkExecRuntimeReplaceSuffix(path1, "_pure_3.exe.primary.o", "_pure_1.exe.primary.o")
    return Ok[str](path2)

@borrows
fn SystemLinkExecRuntimeCopyFileBytesResult(rootDir: str,
                                             sourcePath: str,
                                             outputPath: str): Result[bool] =
    let parent = chengpath.PathParentDir(outputPath)
    if len(parent) <= 0:
        if chengpath.PathIsAbsolute(outputPath):
            return Err[bool](Fmt"copy parent empty for absolute output: {outputPath}")
    if len(parent) > 0:
        let parentBefore = chengpath.PathDirExists(parent)
        let parentAbs = chengpath.PathAbsolute(rootDir, parent)
        let parentAbsBefore = chengpath.PathDirExists(parentAbs)
        let parentLooksAbsolute = chengpath.PathLooksAbsolute(parent)
        let mkdirOk = SystemLinkExecRuntimeEnsureDirAll(parentAbs)
        let parentAfter = chengpath.PathDirExists(parent)
        let parentAbsAfter = chengpath.PathDirExists(parentAbs)
        if !mkdirOk:
            return Err[bool](Fmt"copy mkdir failed: parent={parent} parent_len={strings.IntToStr(parent.len)} parent_abs={parentAbs} looks_abs={SystemLinkExecRuntimeBoolText(parentLooksAbsolute)} before={SystemLinkExecRuntimeBoolText(parentBefore)} abs_before={SystemLinkExecRuntimeBoolText(parentAbsBefore)} after={SystemLinkExecRuntimeBoolText(parentAfter)} abs_after={SystemLinkExecRuntimeBoolText(parentAbsAfter)}")
    if !chengpath.PathFileNonEmpty(sourcePath):
        return Err[bool](Fmt"copy source missing or empty: {sourcePath}")
    var readRes = os.ReadFileBytesResult(sourcePath)
    if !readRes.ok:
        return Err[bool](Fmt"copy read failed: {readRes.err.msg}")
    var data: rawbytes.Bytes = readRes.value
    if rawbytes.BytesLen(data) <= 0:
        rawbytes.BytesFree(data)
        return Err[bool](Fmt"copy read empty: {sourcePath}")
    # Byte-exact copy through the str write path (len-driven raw write).
    let dataText: str = rawbytes.BytesToString(data)
    rawbytes.BytesFree(data)
    if len(dataText) <= 0:
        return Err[bool](Fmt"copy read pack failed: {sourcePath}")
    if !chengpath.WriteTextFile("", chengpath.PathAbsolute(rootDir, outputPath), dataText):
        return Err[bool](Fmt"copy write failed: {outputPath}")
    if !chengpath.FileExistsNonEmpty(rootDir, outputPath):
        return Err[bool](Fmt"copy output missing or empty: {outputPath}")
    return Ok[bool](true)

@borrows
fn SystemLinkExecRuntimeCopyFileBytes(rootDir: str,
                                       sourcePath: str,
                                       outputPath: str): bool =
    let copyRes = SystemLinkExecRuntimeCopyFileBytesResult(rootDir, sourcePath, outputPath)
    return copyRes.ok

@borrows
fn SystemLinkExecRuntimeRestoreProviderObjectCache(rootDir: str,
                                                    plan: sexec.SystemLinkExecPlan,
                                                    providerModule: str,
                                                    sourcePath: str,
                                                    objectPath: str,
                                                    exportRoots: str[],
                                                    compilerSourceClosureSha256: layout.FixedBytes32,
                                                    providerSourceClosureSha256: layout.FixedBytes32): Result[str] =
    if SystemLinkExecRuntimeProviderObjectCacheDisabled():
        return Err[str](" system link exec runtime provider cache: disabled")
    let cachePathRes = SystemLinkExecRuntimeProviderObjectCachePath(rootDir,
                                                                    plan,
                                                                    providerModule,
                                                                    sourcePath,
                                                                    exportRoots,
                                                                    compilerSourceClosureSha256,
                                                                    providerSourceClosureSha256)
    if !cachePathRes.ok:
        return Err[str](strings.CloneStr(cachePathRes.err.msg))
    let cachePath = strings.CloneStr(cachePathRes.value)
    if !chengpath.FileExistsNonEmpty(rootDir, cachePath):
        return Err[str](Fmt" system link exec runtime provider cache: miss: {cachePath}")
    let copyRes = SystemLinkExecRuntimeCopyFileBytesResult(rootDir, cachePath, objectPath)
    if !copyRes.ok:
        return Err[str](Fmt" system link exec runtime provider cache: copy failed: {cachePath}: {strings.CloneStr(copyRes.err.msg)}")
    return Ok[str](cachePath)

@borrows
fn SystemLinkExecRuntimeStoreProviderObjectCache(rootDir: str,
                                                  plan: sexec.SystemLinkExecPlan,
                                                  providerModule: str,
                                                  sourcePath: str,
                                                  objectPath: str,
                                                  exportRoots: str[],
                                                  compilerSourceClosureSha256: layout.FixedBytes32,
                                                  providerSourceClosureSha256: layout.FixedBytes32): Result[str] =
    if SystemLinkExecRuntimeProviderObjectCacheDisabled():
        return Ok[str](strings.CloneStr(""))
    let cachePathRes = SystemLinkExecRuntimeProviderObjectCachePath(rootDir,
                                                                    plan,
                                                                    providerModule,
                                                                    sourcePath,
                                                                    exportRoots,
                                                                    compilerSourceClosureSha256,
                                                                    providerSourceClosureSha256)
    if !cachePathRes.ok:
        return Err[str](strings.CloneStr(cachePathRes.err.msg))
    let cachePath = strings.CloneStr(cachePathRes.value)
    let copyRes = SystemLinkExecRuntimeCopyFileBytesResult(rootDir, objectPath, cachePath)
    if !copyRes.ok:
        return Err[str](Fmt" system link exec runtime provider cache: store failed: {cachePath}: {strings.CloneStr(copyRes.err.msg)}")
    return Ok[str](cachePath)

fn SystemLinkExecRuntimeCopyOptionalHexSidecar(rootDir: str,
                                               sourcePath: str,
                                               outputPath: str): Result[bool] =
    let sourceHex = Fmt"{sourcePath}.hex"
    if !chengpath.FileExistsNonEmpty(rootDir, sourceHex):
        return Ok[bool](true)
    let outputHex = Fmt"{outputPath}.hex"
    let copyRes = SystemLinkExecRuntimeCopyFileBytesResult(rootDir, sourceHex, outputHex)
    if !copyRes.ok:
        return Err[bool](strings.CloneStr(copyRes.err.msg))
    return Ok[bool](true)

@borrows
fn SystemLinkExecRuntimeRestoreWindowsPrimaryObjectCache(rootDir: str,
                                                        compilerPath: str,
                                                        plan: sexec.SystemLinkExecPlan,
                                                        objectPath: str): Result[str] =
    if SystemLinkExecRuntimePrimaryObjectCacheDisabled():
        return Err[str](" system link exec runtime primary object cache: disabled")
    let cachePathRes = SystemLinkExecRuntimeWindowsPrimaryObjectCachePath(rootDir, compilerPath, plan)
    if !cachePathRes.ok:
        return Err[str](strings.CloneStr(cachePathRes.err.msg))
    let cachePath = strings.CloneStr(cachePathRes.value)
    if cachePath == objectPath:
        return Err[str](Fmt" system link exec runtime primary object cache: miss: {cachePath}")
    if !chengpath.FileExistsNonEmpty(rootDir, cachePath):
        return Err[str](Fmt" system link exec runtime primary object cache: object missing: {cachePath}")
    return Ok[str](cachePath)

@borrows
fn SystemLinkExecRuntimeStoreWindowsPrimaryObjectCache(rootDir: str,
                                                       compilerPath: str,
                                                       plan: sexec.SystemLinkExecPlan,
                                                       objectPath: str): Result[str] =
    if SystemLinkExecRuntimePrimaryObjectCacheDisabled():
        return Ok[str](strings.CloneStr(""))
    let cachePathRes = SystemLinkExecRuntimeWindowsPrimaryObjectCachePath(rootDir, compilerPath, plan)
    if !cachePathRes.ok:
        return Err[str](strings.CloneStr(cachePathRes.err.msg))
    let cachePath = strings.CloneStr(cachePathRes.value)
    if cachePath != objectPath:
        return Err[str](Fmt" system link exec runtime primary object cache: store path mismatch: object={objectPath} cache={cachePath}")
    if !chengpath.FileExistsNonEmpty(rootDir, cachePath):
        return Err[str](Fmt" system link exec runtime primary object cache: stored object missing: {cachePath}")
    return Ok[str](cachePath)

@borrows
fn SystemLinkExecRuntimeReasonsError(label: str, reasons: str[]): str =
    return Fmt" system link exec runtime: {label}: {slplan.SystemLinkPlanListText(reasons)}"

@borrows
fn SystemLinkExecRuntimeOwnedTextAtOrEmpty(
        values: str[],
        index: int32): str =
    if index < 0:
        return ""
    if index >= values.len:
        panic("system link exec runtime: owned text source row out of range")
    return strings.CloneStr(values[index])

@borrows
fn SystemLinkExecRuntimeProviderPlanValidationFailure(
        index: var SystemLinkExecRuntimeExactTextIndex,
        metrics: var SystemLinkExecRuntimeExactTextIndexMetrics,
        message: str): Result[bool] =
    let indexMetrics =
        SystemLinkExecRuntimeExactTextIndexRelease(index)
    SystemLinkExecRuntimeExactTextMetricsAccumulate(
        metrics, indexMetrics)
    return Err[bool](strings.CloneStr(message))

@borrows
fn SystemLinkExecRuntimeValidateProviderPlanWithMetrics(rootDir: str,
                                                         plan: var sexec.SystemLinkExecPlan,
                                                         metrics: var SystemLinkExecRuntimeExactTextIndexMetrics): Result[bool] =
    # 域 E 阶段一 HARD_RED 落点:生产上下文中 provider 条目必须改为校验 held
    # bundle(tag 14)内 CID/长度与 plan 记录一致,路径探测已退役;bundle 校验
    # 接通前,无 live CLAIMED lease 的生产到达在此拒签。
    if SystemLinkExecRuntimeProductionPathAccessRetired():
        return Err[bool]("HARD_RED:system_link_exec_runtime_provider_plan_validation_requires_held_bundle")
    let providerSourceCount: int32 = plan.objectPlan.providerSourcePaths.len
    let providerObjectCount: int32 = plan.objectPlan.providerObjectPaths.len
    if providerSourceCount > 0 && providerSourceCount != providerObjectCount:
        return Err[bool](" system link exec runtime: provider source/object count mismatch")
    if providerObjectCount > int32(536870911):
        return Err[bool](" system link exec runtime: provider path index capacity overflow")
    var objectPathIndex = SystemLinkExecRuntimeExactTextIndexInit(providerObjectCount)
    var failMsg: str
    for i in 0..<providerObjectCount:
        if failMsg != "":
            break
        let objectPath = SystemLinkExecRuntimeOwnedTextAtOrEmpty(
            plan.objectPlan.providerObjectPaths, i)
        let sourcePath = SystemLinkExecRuntimeOwnedTextAtOrEmpty(
            plan.objectPlan.providerSourcePaths,
            providerSourceCount > 0 ? i : -1)
        if providerSourceCount > 0:
            if len(sourcePath) <= 0:
                failMsg = Fmt" system link exec runtime: provider source missing at index {strings.IntToStr(i)}"
        if failMsg == "" && len(objectPath) <= 0:
            failMsg = Fmt" system link exec runtime: provider object missing at index {strings.IntToStr(i)}"
        if failMsg == "":
            let canonicalObjectPath = SystemLinkExecRuntimeCanonicalPath(rootDir, objectPath)
            if len(canonicalObjectPath) <= 0:
                failMsg = Fmt" system link exec runtime: invalid provider object path: {objectPath}"
            else:
                var existingRow: int32
                let _ = SystemLinkExecRuntimeExactTextIndexInsert(objectPathIndex,
                                                                   canonicalObjectPath,
                                                                   i,
                                                                   true,
                                                                   existingRow)
                if providerSourceCount > 0:
                    if tmat.TargetIsDarwin(plan.systemLinkPlan.targetTriple) &&
                       (strutil.Contains(sourcePath, "core_runtime_provider_linux.cheng") ||
                        strutil.Contains(sourcePath, "system_helpers_backend_nolibc_linux_aarch64.cheng")):
                        failMsg = Fmt" system link exec runtime: Darwin provider closure selected Linux source: {sourcePath}"
                    elif !chengpath.FileExistsNonEmpty(rootDir, sourcePath):
                        failMsg = Fmt" system link exec runtime: provider source file missing: {sourcePath}"
                elif !chengpath.FileExistsNonEmpty(rootDir, objectPath):
                    failMsg = Fmt" system link exec runtime: external provider object missing: {objectPath}"
    if failMsg == "":
        var duplicateKey: str
        var firstRow: int32
        var duplicateRow: int32
        if !SystemLinkExecRuntimeExactTextIndexSeal(objectPathIndex,
                                                     true,
                                                     duplicateKey,
                                                     firstRow,
                                                     duplicateRow):
            failMsg = Fmt" system link exec runtime: duplicate provider object canonical path: {duplicateKey} first_index={strings.IntToStr(firstRow)} duplicate_index={strings.IntToStr(duplicateRow)}"
    if failMsg != "":
        return SystemLinkExecRuntimeProviderPlanValidationFailure(
            objectPathIndex,
            metrics,
            failMsg)
    let indexMetrics = SystemLinkExecRuntimeExactTextIndexRelease(objectPathIndex)
    SystemLinkExecRuntimeExactTextMetricsAccumulate(metrics, indexMetrics)
    return Ok[bool](true)

@borrows
fn SystemLinkExecRuntimeValidateProviderPlan(rootDir: str,
                                              plan: var sexec.SystemLinkExecPlan): Result[bool] =
    var metrics: SystemLinkExecRuntimeExactTextIndexMetrics
    return SystemLinkExecRuntimeValidateProviderPlanWithMetrics(rootDir, plan, metrics)

@borrows
fn SystemLinkExecRuntimeValidateExecutablePlanWithMetrics(rootDir: str,
                                                           plan: var sexec.SystemLinkExecPlan,
                                                           metrics: var SystemLinkExecRuntimeExactTextIndexMetrics,
                                                           validateProviderPaths: bool): Result[bool] =
    # 域 E 阶段一 HARD_RED 落点:生产上下文中 executable/provider 条目必须
    # 校验 held bundle 内记录,路径探测已退役。
    if SystemLinkExecRuntimeProductionPathAccessRetired():
        return Err[bool]("HARD_RED:system_link_exec_runtime_executable_plan_validation_requires_held_bundle")
    if !SystemLinkExecRuntimeCanExecutePlan(plan):
        var reason = Fmt"plan_not_ready_code_{strings.IntToStr(plan.notReadyCode)}"
        return Err[bool](Fmt" system link exec runtime: {reason}")
    if validateProviderPaths:
        let providerRes = SystemLinkExecRuntimeValidateProviderPlanWithMetrics(rootDir,
                                                                                plan,
                                                                                metrics)
        if !providerRes.ok:
            return providerRes
    if len(plan.objectPlan.browserBridgeObjectPath) > 0 &&
       !chengpath.FileExistsNonEmpty(rootDir, plan.objectPlan.browserBridgeObjectPath):
        return Err[bool](Fmt" system link exec runtime: browser bridge object not materialized: {plan.objectPlan.browserBridgeObjectPath}")
    return Ok[bool](true)

fn SystemLinkExecRuntimeValidateExecutablePlan(rootDir: str,
                                                plan: var sexec.SystemLinkExecPlan): Result[bool] =
    var metrics: SystemLinkExecRuntimeExactTextIndexMetrics
    return SystemLinkExecRuntimeValidateExecutablePlanWithMetrics(rootDir,
                                                                   plan,
                                                                   metrics,
                                                                   true)

@borrows
fn SystemLinkExecRuntimeRecordDirectObject(rootDir: str,
                                            startNs: int64,
                                            directObject: direct.DirectObjectEmitResult,
                                            result: var SystemLinkExecRuntimeResult): Result[bool] =
    let objectPath = strings.CloneStr(directObject.objectPath)
    if !chengpath.FileExistsNonEmpty(rootDir, objectPath):
        return Err[bool](Fmt" system link exec runtime: primary direct object missing after emit: {objectPath}")
    result.primaryObjectNs = SystemLinkExecRuntimeNowNs() - startNs
    result.primaryObjectPath = strings.CloneStr(objectPath)
    result.primaryObjectAsmPath = ""
    result.primaryObjectCompileLogPath = ""
    result.primaryObjectDirect = true
    result.directObjectBytes = directObject.bytesWritten
    result.directObjectSymbolCount = directObject.symbolCount
    result.directObjectRelocCount = directObject.relocCount
    result.debugObject.objectPath = strings.CloneStr(objectPath)
    result.debugObject.outputKind = strings.CloneStr(directObject.outputKind)
    result.debugObject.bytesWritten = directObject.bytesWritten
    result.debugObject.symbolCount = directObject.symbolCount
    result.debugObject.relocCount = directObject.relocCount
    result.debugObject.linkerlessImage = directObject.linkerlessImage
    result.debugObject.systemLink = directObject.systemLink
    result.debugObject.directObjectLayoutMs = directObject.directObjectLayoutMs
    result.debugObject.directObjectEmitMs = directObject.directObjectEmitMs
    result.debugObject.textSectionFileOffset = directObject.textSectionFileOffset
    var cidByte: int32
    while cidByte < layout.FixedBytes32Size:
        result.debugObject.objectCid.data[cidByte] = directObject.objectCid.data[cidByte]
        cidByte = cidByte + 1
    return Ok[bool](true)

fn SystemLinkExecRuntimeCanUseWindowsPrimaryCompiler(plan: var sexec.SystemLinkExecPlan,
                                                     standaloneMain: bool): bool =
    if standaloneMain:
        return false
    if plan.systemLinkPlan.targetTriple != "x86_64-pc-windows-msvc":
        return false
    if plan.primaryObjectPlan.objectFormat != "coff":
        return false
    if len(plan.systemLinkPlan.entryPath) <= 0:
        return false
    if len(plan.objectPlan.primaryObjectPath) <= 0:
        return false
    return true

fn SystemLinkExecRuntimeWindowsPrimaryCompilerPreferred(plan: var sexec.SystemLinkExecPlan,
                                                        standaloneMain: bool,
                                                        objectOnly: bool): bool =
    if !SystemLinkExecRuntimeCanUseWindowsPrimaryCompiler(plan, standaloneMain):
        return false
    # objectOnly with a ready direct-emit plan must stay linkerless; the cold
    # compiler bridge is only a fallback for plans the direct emitter rejects.
    if objectOnly && direct.DirectObjectEmitCanPlanObject(plan.primaryObjectPlan):
        return false
    if objectOnly && cmdline.ParamStr(2) == "--debug-system-link-exec":
        let directReason = direct.DirectObjectEmitX64PlanTextUnsupportedReason(plan.primaryObjectPlan)
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=windows_primary_direct_reject reason={directReason}")
    return true

fn SystemLinkExecRuntimeCanExecutePlan(plan: var sexec.SystemLinkExecPlan): bool =
    if plan.readyCode == 1:
        return true
    if plan.notReadyCode != 3:
        return false
    return SystemLinkExecRuntimeCanUseWindowsPrimaryCompiler(plan, false)

@borrows
fn SystemLinkExecRuntimeWindowsSourceExportRoot(raw: str): str =
    if raw == "_main" || raw == "__main":
        return "main"
    if len(raw) > 1 && raw[0] == '_':
        return strings.SliceBytes(raw, 1, len(raw) - 1)
    return strings.CloneStr(raw)

@borrows
fn SystemLinkExecRuntimeWindowsPrimaryExportRoots(plan: sexec.SystemLinkExecPlan): str =
    var roots: str[]
    for i in 0..<plan.systemLinkPlan.exportRootSymbols.len:
        let root = SystemLinkExecRuntimeWindowsSourceExportRoot(plan.systemLinkPlan.exportRootSymbols[i])
        if len(root) > 0:
            add(roots, strings.CloneStr(root))
    if roots.len > 0:
        return strutil.Join(roots, ",")
    let entryRoot = SystemLinkExecRuntimeWindowsSourceExportRoot(plan.systemLinkPlan.entrySymbol)
    if len(entryRoot) > 0:
        return entryRoot
    if slplan.SystemLinkPlanMainFunctionPresent(plan.systemLinkPlan):
        return "main"
    return ""

@borrows
fn SystemLinkExecRuntimeWindowsPrimaryCompilerArgs(plan: sexec.SystemLinkExecPlan,
                                                   objectPath: str,
                                                   reportPath: str): str[] =
    var argv: str[]
    let packageRoot = strings.CloneStr(plan.systemLinkPlan.packageRoot)
    let entryPath = strings.CloneStr(plan.systemLinkPlan.entryPath)
    let targetTriple = strings.CloneStr(plan.systemLinkPlan.targetTriple)
    let outPath = strings.CloneStr(objectPath)
    let report = strings.CloneStr(reportPath)
    add(argv, "system-link-exec")
    add(argv, Fmt"--root:{packageRoot}")
    add(argv, Fmt"--in:{entryPath}")
    add(argv, "--emit:obj")
    add(argv, Fmt"--target:{targetTriple}")
    add(argv, Fmt"--out:{outPath}")
    add(argv, Fmt"--report-out:{report}")
    add(argv, "--symbol-visibility:internal")
    let roots = SystemLinkExecRuntimeWindowsPrimaryExportRoots(plan)
    if len(roots) > 0:
        add(argv, Fmt"--export-roots:{roots}")
    return argv

fn SystemLinkExecRuntimeCanUseWindowsProviderLinkedCompiler(plan: var sexec.SystemLinkExecPlan,
                                                            standaloneMain: bool): bool =
    let enabled = os.GetEnv("CHENG_WINDOWS_PROVIDER_LINKED_EXE_FALLBACK")
    if enabled != "1" && enabled != "true":
        return false
    if standaloneMain:
        return false
    if plan.systemLinkPlan.emitKind != creq.EmitExe:
        return false
    if plan.systemLinkPlan.targetTriple != "x86_64-pc-windows-msvc":
        return false
    if direct.DirectObjectEmitCanPlanObject(plan.primaryObjectPlan):
        return false
    if plan.objectPlan.providerSourcePaths.len > 0:
        return false
    if plan.objectPlan.providerObjectPaths.len > 0:
        return false
    if len(plan.systemLinkPlan.entryPath) <= 0:
        return false
    if len(plan.systemLinkPlan.outputPath) <= 0:
        return false
    return true

@borrows
fn SystemLinkExecRuntimeWindowsProviderLinkedCompilerArgs(plan: sexec.SystemLinkExecPlan,
                                                          reportPath: str): str[] =
    var argv: str[]
    let packageRoot = strings.CloneStr(plan.systemLinkPlan.packageRoot)
    let entryPath = strings.CloneStr(plan.systemLinkPlan.entryPath)
    let targetTriple = strings.CloneStr(plan.systemLinkPlan.targetTriple)
    let outputPath = strings.CloneStr(plan.systemLinkPlan.outputPath)
    let report = strings.CloneStr(reportPath)
    add(argv, "system-link-exec")
    add(argv, Fmt"--root:{packageRoot}")
    add(argv, Fmt"--in:{entryPath}")
    add(argv, "--emit:exe")
    add(argv, "--link-providers")
    add(argv, Fmt"--target:{targetTriple}")
    add(argv, Fmt"--out:{outputPath}")
    add(argv, Fmt"--report-out:{report}")
    return argv

@borrows
fn SystemLinkExecRuntimeWindowsProviderLinkedCompilerArgsForOutput(plan: sexec.SystemLinkExecPlan,
                                                                  outputPath: str,
                                                                  reportPath: str): str[] =
    var argv: str[]
    let packageRoot = strings.CloneStr(plan.systemLinkPlan.packageRoot)
    let entryPath = strings.CloneStr(plan.systemLinkPlan.entryPath)
    let targetTriple = strings.CloneStr(plan.systemLinkPlan.targetTriple)
    let outPath = strings.CloneStr(outputPath)
    let report = strings.CloneStr(reportPath)
    add(argv, "system-link-exec")
    add(argv, Fmt"--root:{packageRoot}")
    add(argv, Fmt"--in:{entryPath}")
    add(argv, "--emit:exe")
    add(argv, "--link-providers")
    add(argv, Fmt"--target:{targetTriple}")
    add(argv, Fmt"--out:{outPath}")
    add(argv, Fmt"--report-out:{report}")
    return argv

@borrows
fn SystemLinkExecRuntimeMaterializeWindowsProviderObject(rootDir: str,
                                                         compilerPath: str,
                                                         plan: sexec.SystemLinkExecPlan,
                                                         result: var SystemLinkExecRuntimeResult): Result[bool] =
    # 域 E 阶段一 HARD_RED 落点:生产上下文中 Windows provider 编译子进程的
    # raw --in 路径 argv 已退役,字节必须来自 held bundle。
    if SystemLinkExecRuntimeProductionPathAccessRetired():
        return Err[bool]("HARD_RED:system_link_exec_runtime_windows_compile_requires_held_source_bytes")
    let startNs = SystemLinkExecRuntimeNowNs()
    let overrideObject = strutil.Strip(os.GetEnv("CHENG_WINDOWS_RUNTIME_PROVIDER_OBJECT"))
    if len(overrideObject) > 0:
        if !chengpath.FileExistsNonEmpty(rootDir, overrideObject) && !chengpath.FileExistsNonEmpty(rootDir, Fmt"{overrideObject}.hex"):
            result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
            return Err[bool](Fmt" system link exec runtime: Windows provider object override missing: {overrideObject}")
        add(result.providerObjectPaths, strings.CloneStr(overrideObject))
        let overrideExtra = strutil.Strip(os.GetEnv("CHENG_WINDOWS_RUNTIME_PROVIDER_OBJECT_EXTRA"))
        var overrideCount = 1
        if len(overrideExtra) > 0:
            if !chengpath.FileExistsNonEmpty(rootDir, overrideExtra) && !chengpath.FileExistsNonEmpty(rootDir, Fmt"{overrideExtra}.hex"):
                result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
                return Err[bool](Fmt" system link exec runtime: Windows provider object override missing: {overrideExtra}")
            add(result.providerObjectPaths, strings.CloneStr(overrideExtra))
            overrideCount = 2
        result.providerParallelStatus = "windows_override"
        result.providerParallelTaskCount = overrideCount
        result.providerParallelJobCount = overrideCount
        result.providerParallelActiveWorkers = overrideCount
        result.providerParallelCompletedWorkers = overrideCount
        result.providerObjectCacheStatus = "override"
        result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
        return Ok[bool](true)
    let seedOut = Fmt"{plan.systemLinkPlan.outputPath}.provider_seed.exe"
    let providerCoreObjectPath = Fmt"{seedOut}.provider.o"
    let providerWindowsObjectPath = Fmt"{seedOut}.provider.windows.o"
    let reportPath = Fmt"{seedOut}.report.txt"
    let logPath = Fmt"{seedOut}.log"
    let argv = SystemLinkExecRuntimeWindowsProviderLinkedCompilerArgsForOutput(plan, seedOut, reportPath)
    var env = SystemLinkExecRuntimeProviderCompileEnv(compilerPath)
    let run = hostops.RunFileLogged(rootDir,
                                    "system_link_exec_windows_provider_object_seed",
                                    compilerPath,
                                    argv,
                                    env,
                                    rootDir,
                                    0,
                                    logPath)
    if run.exitCode != 0:
        result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
        return Err[bool](Fmt" system link exec runtime: Windows provider seed failed rc={strings.IntToStr(run.exitCode)} log={run.logPath}\n{run.output}")
    let providerCorePresent =
        SystemLinkExecRuntimeHostFileNonEmpty(
            providerCoreObjectPath)
    let providerWindowsPresent =
        SystemLinkExecRuntimeHostFileNonEmpty(
            providerWindowsObjectPath)
    if !providerCorePresent && !providerWindowsPresent:
        result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
        return Err[bool](Fmt" system link exec runtime: Windows provider object missing after seed: {providerCoreObjectPath} or {providerWindowsObjectPath}")
    var providerCount: int32
    if providerCorePresent:
        add(result.providerObjectPaths, strings.CloneStr(providerCoreObjectPath))
        providerCount = providerCount + 1
    if providerWindowsPresent:
        add(result.providerObjectPaths, strings.CloneStr(providerWindowsObjectPath))
        providerCount = providerCount + 1
    for _logIndex in 0..<providerCount:
        add(result.providerCompileLogPaths, Fmt"{logPath}")
    result.providerParallelStatus = "windows_seed"
    result.providerParallelTaskCount = providerCount
    result.providerParallelJobCount = providerCount
    result.providerParallelActiveWorkers = providerCount
    result.providerParallelCompletedWorkers = providerCount
    result.providerObjectCacheStatus = "disabled_miss"
    result.providerObjectCacheMissCount = providerCount
    result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
    return Ok[bool](true)

@borrows
fn SystemLinkExecRuntimeMaterializeWindowsExeWithProviderCompiler(rootDir: str,
                                                                  plan: sexec.SystemLinkExecPlan,
                                                                  result: var SystemLinkExecRuntimeResult,
                                                                  requestedCompilerPath: str): Result[bool] =
    # 域 E 阶段一 HARD_RED 落点:同上,raw --in 路径 argv 已退役。
    if SystemLinkExecRuntimeProductionPathAccessRetired():
        return Err[bool]("HARD_RED:system_link_exec_runtime_windows_compile_requires_held_source_bytes")
    let startNs = SystemLinkExecRuntimeNowNs()
    let compilerRes = SystemLinkExecRuntimeResolveWindowsPrimaryCompiler(
        rootDir,
        requestedCompilerPath)
    if !compilerRes.ok:
        return Err[bool](strings.CloneStr(compilerRes.err.msg))
    let compilerPath = strings.CloneStr(compilerRes.value)
    let outputPath = strings.CloneStr(plan.systemLinkPlan.outputPath)
    let reportPath = Fmt"{outputPath}.provider_link.report.txt"
    let logPath = Fmt"{outputPath}.provider_link.log"
    let argv = SystemLinkExecRuntimeWindowsProviderLinkedCompilerArgs(plan, reportPath)
    var env = SystemLinkExecRuntimeProviderCompileEnv(compilerPath)
    let run = hostops.RunFileLogged(rootDir,
                                    "system_link_exec_windows_provider_linked_exe",
                                    compilerPath,
                                    argv,
                                    env,
                                    rootDir,
                                    0,
                                    logPath)
    result.providerCompilerPath = strings.CloneStr(compilerPath)
    result.primaryObjectNs = SystemLinkExecRuntimeNowNs() - startNs
    result.primaryObjectPath = strings.CloneStr(plan.objectPlan.primaryObjectPath)
    result.primaryObjectAsmPath = ""
    result.primaryObjectCompileLogPath = strings.CloneStr(run.logPath)
    result.primaryObjectDirect = false
    result.nativeLinkLogPath = strings.CloneStr(run.logPath)
    result.nativeLinkNs = result.primaryObjectNs
    if run.exitCode != 0:
        return Err[bool](Fmt" system link exec runtime: Windows provider-linked exe failed rc={strings.IntToStr(run.exitCode)} log={run.logPath}\n{run.output}")
    if !chengpath.FileExistsNonEmpty(rootDir, outputPath):
        return Err[bool](Fmt" system link exec runtime: Windows provider-linked exe missing: {outputPath}")
    let primaryObjectHostPath = chengpath.PathHostFilePath(result.primaryObjectPath)
    if len(result.primaryObjectPath) > 0 && os.FileSize(primaryObjectHostPath) <= int64(0):
        let primaryReportPath = Fmt"{result.primaryObjectPath}.primary_compile.report.txt"
        let primaryLogPath = Fmt"{result.primaryObjectPath}.primary_compile.log"
        let primaryArgv = SystemLinkExecRuntimeWindowsPrimaryCompilerArgs(plan,
                                                                          result.primaryObjectPath,
                                                                          primaryReportPath)
        let primaryRun = hostops.RunFileLogged(rootDir,
                                               "system_link_exec_windows_provider_linked_primary_object",
                                               compilerPath,
                                               primaryArgv,
                                               env,
                                               rootDir,
                                               0,
                                               primaryLogPath)
        result.primaryObjectCompileLogPath = strings.CloneStr(primaryRun.logPath)
        if primaryRun.exitCode != 0:
            return Err[bool](Fmt" system link exec runtime: Windows provider-linked primary object failed rc={strings.IntToStr(primaryRun.exitCode)} log={primaryRun.logPath}\n{primaryRun.output}")
    if len(result.primaryObjectPath) > 0 && os.FileSize(primaryObjectHostPath) <= int64(0):
        return Err[bool](Fmt" system link exec runtime: Windows provider-linked primary object missing: {result.primaryObjectPath}")
    return Ok[bool](true)

@borrows
fn SystemLinkExecRuntimeMaterializeWindowsPrimaryWithCompiler(rootDir: str,
                                                              plan: sexec.SystemLinkExecPlan,
                                                              result: var SystemLinkExecRuntimeResult,
                                                              requestedCompilerPath: str): Result[bool] =
    # 域 E 阶段一 HARD_RED 落点:同上,raw --in 路径 argv 已退役。
    if SystemLinkExecRuntimeProductionPathAccessRetired():
        return Err[bool]("HARD_RED:system_link_exec_runtime_windows_compile_requires_held_source_bytes")
    let startNs = SystemLinkExecRuntimeNowNs()
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=windows_primary_before_compiler_resolve")
    let compilerRes = SystemLinkExecRuntimeResolveWindowsPrimaryCompiler(
        rootDir,
        requestedCompilerPath)
    if !compilerRes.ok:
        result.primaryObjectNs = SystemLinkExecRuntimeNowNs() - startNs
        return Err[bool](strings.CloneStr(compilerRes.err.msg))
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=windows_primary_after_compiler_resolve")
    let compilerPath = strings.CloneStr(compilerRes.value)
    let objectPath = strings.CloneStr(plan.objectPlan.primaryObjectPath)
    let reportPath = Fmt"{objectPath}.primary_compile.report.txt"
    let logPath = Fmt"{objectPath}.primary_compile.log"
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=windows_primary_after_paths")
    let argv = SystemLinkExecRuntimeWindowsPrimaryCompilerArgs(plan, objectPath, reportPath)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=windows_primary_after_args")
    let primaryCacheDisabled = SystemLinkExecRuntimePrimaryObjectCacheDisabled()
    if !primaryCacheDisabled:
        let cacheRes = SystemLinkExecRuntimeRestoreWindowsPrimaryObjectCache(rootDir,
                                                                            compilerPath,
                                                                            plan,
                                                                            objectPath)
        if cacheRes.ok:
            let cachePath = strings.CloneStr(cacheRes.value)
            result.providerCompilerPath = strings.CloneStr(compilerPath)
            result.primaryObjectNs = SystemLinkExecRuntimeNowNs() - startNs
            result.primaryObjectPath = strings.CloneStr(cachePath)
            result.primaryObjectAsmPath = ""
            result.primaryObjectCompileLogPath = strings.CloneStr(cachePath)
            result.primaryObjectCacheStatus = "hit"
            result.primaryObjectCachePath = strings.CloneStr(cachePath)
            result.primaryObjectDirect = false
            return Ok[bool](true)
        result.primaryObjectCacheStatus = "miss"
    else:
        result.primaryObjectCacheStatus = "disabled_miss"
    var env = SystemLinkExecRuntimeProviderCompileEnv(compilerPath)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=windows_primary_before_run")
    let run = hostops.RunFileLogged(rootDir,
                                    "system_link_exec_windows_primary_object",
                                    compilerPath,
                                    argv,
                                    env,
                                    rootDir,
                                    0,
                                    logPath)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=windows_primary_after_run")
    result.providerCompilerPath = strings.CloneStr(compilerPath)
    result.primaryObjectNs = SystemLinkExecRuntimeNowNs() - startNs
    result.primaryObjectPath = strings.CloneStr(objectPath)
    result.primaryObjectAsmPath = ""
    result.primaryObjectCompileLogPath = strings.CloneStr(run.logPath)
    result.primaryObjectDirect = false
    if run.exitCode != 0:
        return Err[bool](Fmt" system link exec runtime: Windows primary object compile failed rc={strings.IntToStr(run.exitCode)} log={run.logPath}\n{run.output}")
    if !chengpath.FileExistsNonEmpty(rootDir, objectPath):
        return Err[bool](Fmt" system link exec runtime: Windows primary object missing after compile: {objectPath}")
    if primaryCacheDisabled:
        return Ok[bool](true)
    let storeCache = SystemLinkExecRuntimeStoreWindowsPrimaryObjectCache(rootDir,
                                                                        compilerPath,
                                                                        plan,
                                                                        objectPath)
    if storeCache.ok:
        result.primaryObjectCacheStatus = "stored"
        result.primaryObjectCachePath = strings.CloneStr(storeCache.value)
    else:
        result.primaryObjectCacheStatus = Fmt"store_error:{strings.CloneStr(storeCache.err.msg)}"
    return Ok[bool](true)

@borrows
fn SystemLinkExecRuntimeMaterializePrimaryObject(rootDir: str,
                                                  plan: var pobj.PrimaryObjectPlan,
                                                  standaloneMain: bool,
                                                  objectOnly: bool,
                                                  result: var SystemLinkExecRuntimeResult): Result[bool] =
    let startNs = SystemLinkExecRuntimeNowNs()
    var useStandalone = false
    if !objectOnly && standaloneMain:
        useStandalone = direct.DirectObjectEmitCanStandaloneMain(plan)
    if objectOnly:
        if direct.DirectObjectEmitCanPlanObject(plan):
            var directObject: direct.DirectObjectEmitResult
            var directObjectErr: str
            if !csgemit.PrimaryObjectCsgcEmitPlanObjectInto(
                   rootDir, plan, directObject, directObjectErr):
                result.primaryObjectNs = SystemLinkExecRuntimeNowNs() - startNs
                return Err[bool](strings.CloneStr(directObjectErr))
            return SystemLinkExecRuntimeRecordDirectObject(
                strings.CloneStr(rootDir), startNs, directObject, result)
    if !objectOnly && useStandalone:
        let ownedRoot = strings.CloneStr(rootDir)
        let directRes: Result[direct.DirectObjectEmitResult] = direct.DirectObjectEmitStandaloneMain(ownedRoot, plan)
        if !directRes.ok:
            result.primaryObjectNs = SystemLinkExecRuntimeNowNs() - startNs
            return Err[bool](strings.CloneStr(directRes.err.msg))
        return SystemLinkExecRuntimeRecordDirectObject(
            strings.CloneStr(rootDir), startNs, Value(directRes), result)
    if !objectOnly && direct.DirectObjectEmitCanPlanObject(plan):
        var directPlan: direct.DirectObjectEmitResult
        var directPlanErr: str
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_before_direct_plan_into")
        if !csgemit.PrimaryObjectCsgcEmitPlanObjectInto(
               rootDir, plan, directPlan, directPlanErr):
            result.primaryObjectNs = SystemLinkExecRuntimeNowNs() - startNs
            return Err[bool](strings.CloneStr(directPlanErr))
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_direct_plan_into")
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_before_record_direct_object")
        let recorded = SystemLinkExecRuntimeRecordDirectObject(
            strings.CloneStr(rootDir), startNs, directPlan, result)
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_record_direct_object")
        return recorded
    result.primaryObjectNs = SystemLinkExecRuntimeNowNs() - startNs
    let validateRes = direct.DirectObjectEmitValidatePlanObject(plan)
    if !validateRes.ok:
        return Err[bool](Fmt"system link exec runtime: direct plan reject context missing_reasons={plan.missingReasons.len} items={plan.itemIds.len} words={plan.instructionWords.len} out_path_len={len(plan.outputPath)} symbols={plan.symbolNames.len} abort={plan.streamedBuildAbortReason}: {strings.CloneStr(validateRes.err.msg)}")
    return Err[bool](" system link exec runtime: direct object emitter rejected plan")

@borrows
fn SystemLinkExecRuntimeAddUniqueText(out: var str[],
                                       value: str) =
    if len(value) <= 0:
        return
    for i in 0..<out.len:
        if out[i] == value:
            return
    add(out, strings.CloneStr(value))

@borrows
fn SystemLinkExecRuntimePlanRelocNeedsSymbol(plan: sexec.SystemLinkExecPlan,
                                              rawSymbol: str): bool =
    let targetSymbol = pobj.PrimaryTargetSymbolName(plan.systemLinkPlan.targetTriple, rawSymbol)
    for i in 0..<plan.primaryObjectPlan.relocTargetSymbols.len:
        let symbol = plan.primaryObjectPlan.relocTargetSymbols[i]
        if symbol == rawSymbol:
            return true
        if symbol == targetSymbol:
            return true
    return false

@borrows
fn SystemLinkExecRuntimeAddCoreRuntimeRootIfNeeded(plan: sexec.SystemLinkExecPlan,
                                                    out: var str[],
                                                    rawSymbol: str) =
    if SystemLinkExecRuntimePlanRelocNeedsSymbol(plan, rawSymbol):
        SystemLinkExecRuntimeAddUniqueText(out, rawSymbol)

@borrows
fn SystemLinkExecRuntimeAddCoreRuntimeRoots(plan: sexec.SystemLinkExecPlan,
                                             out: var str[]) =
    SystemLinkExecRuntimeAddCoreRuntimeRootIfNeeded(plan, out, "cheng_mem_retain")
    SystemLinkExecRuntimeAddCoreRuntimeRootIfNeeded(plan, out, "cheng_mem_release")
    SystemLinkExecRuntimeAddCoreRuntimeRootIfNeeded(plan, out, "cheng_mem_retain_atomic")
    SystemLinkExecRuntimeAddCoreRuntimeRootIfNeeded(plan, out, "cheng_mem_release_atomic")
    # [wall134] cheng_str_drop_owned / cheng_str_snapshot_retain_owned 必须由
    # program_support 通道提供（AppendProgramSupportRelocRoots 的 reloc 扫描臂：
    # 定义唯一点=program_support_backend.cheng，darwin core provider 源不存在
    # 这两个导出）。此前本通道按 reloc 条件列举它们是错误提供者：export roots
    # 契约=「本 provider 源必须导出」，cold 编译器对列出的每个 root 都在源内
    # 找 @exportc 定义，找不到即 fail-closed「export root not found」——条件化
    # 只推迟失败，不消除失败（cold_nested 主对象 str 作用域尾 drop 首次触发）。
    # [wall118] var-ptr ABI glue 同域两行 (cheng_ref_drop_owned /
    # cheng_ref_retain_owned) 已由 [wall146] 删除: 定义唯一点=
    # program_support_backend.cheng @exportc(:6390/:6398), darwin core
    # provider 源零此导出 — 与 [wall134] str glue 两行完全同构的错误
    # 提供者 (export roots 契约=「本 provider 源必须导出」, cold 编译器
    # 逐 root 在源内精确匹配, 找不到即 fail-closed「export root not
    # found」)。8B ref 句柄槽 drop/retain reloc 全权归
    # AppendProgramSupportRelocRoots reloc 扫描臂 ([wall134] 修法二
    # candidate 入根归一 coldRootSpelling raw 拼写已收线, v6 过
    # read-edge 墙后首次触发本形)。
    SystemLinkExecRuntimeAddCoreRuntimeRootIfNeeded(plan, out, "cheng_native_errno_code_bridge")
    SystemLinkExecRuntimeAddCoreRuntimeRootIfNeeded(plan, out, "driver_c_new_string")
    SystemLinkExecRuntimeAddCoreRuntimeRootIfNeeded(plan, out, "driver_c_new_string_copy_n")
    SystemLinkExecRuntimeAddCoreRuntimeRootIfNeeded(plan, out, "cheng_epoch_time_seconds")
