@borrows
fn SystemLinkExecRuntimePlanHasProviderModule(plan: sexec.SystemLinkExecPlan,
                                              moduleName: str): bool =
    for i in 0..<plan.objectPlan.providerModules.len:
        if plan.objectPlan.providerModules[i] == moduleName:
            return true
    for i in 0..<plan.systemLinkPlan.providerModules.len:
        if plan.systemLinkPlan.providerModules[i] == moduleName:
            return true
    return false

