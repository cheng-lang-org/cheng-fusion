@borrows
fn SystemLinkExecRuntimeColdProviderRootSpelling(targetTriple: str,
                                                 symbol: str): str =
    # Provider cold compiles match raw @exportc spellings; plan reloc columns
    # carry the target-decorated form (decoration occurs exactly once at the
    # lowering/mach-o boundary). Strip exactly one decoration at this seam.
    if tmat.TargetIsDarwinA64(targetTriple) &&
       len(symbol) > 1 && symbol[0] == '_':
        return strings.CloneStrRange(symbol, 1, len(symbol) - 1)
    return strings.CloneStr(symbol)

@borrows
fn SystemLinkExecRuntimeAppendProgramSupportRelocRoots(plan: sexec.SystemLinkExecPlan,
                                                       out: var str[],
                                                       definitionMetrics: var SystemLinkExecRuntimeExactTextIndexMetrics,
                                                       rootMetrics: var SystemLinkExecRuntimeExactTextIndexMetrics,
                                                       err: var str): bool =
    err = ""
    if plan.primaryObjectPlan.symbolNames.len > int32(536870911) ||
       out.len > int32(536870911) - plan.primaryObjectPlan.relocTargetSymbols.len:
        err = "system link exec runtime: reloc index capacity overflow"
        return false
    var definitionIndex = SystemLinkExecRuntimeExactTextIndexInit(plan.primaryObjectPlan.symbolNames.len)
    for definitionIndexValue in 0..<plan.primaryObjectPlan.symbolNames.len:
        let symbol = plan.primaryObjectPlan.symbolNames[definitionIndexValue]
        var existingDefinitionRow: int32
        let _ = SystemLinkExecRuntimeExactTextIndexInsertBorrowed(
            definitionIndex,
            symbol,
            definitionIndexValue,
            existingDefinitionRow)
    var duplicateDefinitionKey: str
    var firstDefinitionRow: int32
    var duplicateDefinitionRow: int32
    if !SystemLinkExecRuntimeExactTextIndexSeal(definitionIndex,
                                                true,
                                                duplicateDefinitionKey,
                                                firstDefinitionRow,
                                                duplicateDefinitionRow):
        var firstFunctionIrIndex = -1
        var duplicateFunctionIrIndex = -1
        if firstDefinitionRow >= 0 &&
           firstDefinitionRow < plan.primaryObjectPlan.functionIrIndexes.len:
            firstFunctionIrIndex = plan.primaryObjectPlan.functionIrIndexes[firstDefinitionRow]
        if duplicateDefinitionRow >= 0 &&
           duplicateDefinitionRow < plan.primaryObjectPlan.functionIrIndexes.len:
            duplicateFunctionIrIndex = plan.primaryObjectPlan.functionIrIndexes[duplicateDefinitionRow]
        let releasedDefinitionMetrics =
            SystemLinkExecRuntimeExactTextIndexRelease(definitionIndex)
        SystemLinkExecRuntimeExactTextMetricsAccumulate(definitionMetrics,
                                                         releasedDefinitionMetrics)
        # Return before allocating any reloc-sized root index.
        err = Fmt"system link exec runtime: ambiguous duplicate primary definition symbol={duplicateDefinitionKey} first_index={strings.IntToStr(firstDefinitionRow)} first_function_ir={strings.IntToStr(firstFunctionIrIndex)} duplicate_index={strings.IntToStr(duplicateDefinitionRow)} duplicate_function_ir={strings.IntToStr(duplicateFunctionIrIndex)}"
        return false

    var rootIndex = SystemLinkExecRuntimeExactTextIndexInit(out.len)
    for rootIndexValue in 0..<out.len:
        var existingRootRow: int32
        let _ = SystemLinkExecRuntimeExactTextIndexInsertBorrowed(
            rootIndex,
            out[rootIndexValue],
            rootIndexValue,
            existingRootRow)
    var duplicateRootKey: str
    var firstRootRow: int32
    var duplicateRootRow: int32
    if !SystemLinkExecRuntimeExactTextIndexSeal(rootIndex,
                                                true,
                                                duplicateRootKey,
                                                firstRootRow,
                                                duplicateRootRow):
        let releasedDefinitionMetrics =
            SystemLinkExecRuntimeExactTextIndexRelease(definitionIndex)
        let releasedRootMetrics =
            SystemLinkExecRuntimeExactTextIndexRelease(rootIndex)
        SystemLinkExecRuntimeExactTextMetricsAccumulate(definitionMetrics,
                                                         releasedDefinitionMetrics)
        SystemLinkExecRuntimeExactTextMetricsAccumulate(rootMetrics,
                                                         releasedRootMetrics)
        err = Fmt"system link exec runtime: duplicate provider export root before reloc merge symbol={duplicateRootKey} first_index={strings.IntToStr(firstRootRow)} duplicate_index={strings.IntToStr(duplicateRootRow)}"
        return false

    var candidateIndex = SystemLinkExecRuntimeExactTextIndexInit(
        plan.primaryObjectPlan.relocTargetSymbols.len)
    let debugFlush = pobj.PrimaryTargetSymbolName(plan.systemLinkPlan.targetTriple,
                                                   "cheng_debug_profile_flush_from_argv0")
    let lineMapRoot = pobj.PrimaryTargetSymbolName(plan.systemLinkPlan.targetTriple,
                                                   "cheng_native_register_line_map_from_argv0")
    let getEnvBridge = pobj.PrimaryTargetSymbolName(plan.systemLinkPlan.targetTriple,
                                                     "driver_c_get_env_bridge")
    let newString = pobj.PrimaryTargetSymbolName(plan.systemLinkPlan.targetTriple,
                                                  "driver_c_new_string")
    let newStringCopy = pobj.PrimaryTargetSymbolName(plan.systemLinkPlan.targetTriple,
                                                      "driver_c_new_string_copy_n")
    let coreRuntimePresent = SystemLinkExecRuntimePlanHasProviderModule(plan,
                                                                        "runtime/core_runtime")
    for relocIndex in 0..<plan.primaryObjectPlan.relocTargetSymbols.len:
        let symbol = plan.primaryObjectPlan.relocTargetSymbols[relocIndex]
        if len(symbol) <= 0:
            continue
        if symbol == debugFlush || symbol == lineMapRoot || symbol == getEnvBridge:
            continue
        if coreRuntimePresent && (symbol == newString || symbol == newStringCopy):
            continue
        if SystemLinkExecRuntimeExactTextIndexFind(definitionIndex, symbol, true) >= 0:
            continue
        if SystemLinkExecRuntimeExactTextIndexFind(rootIndex, symbol, true) >= 0:
            continue
        # A target-decorated candidate whose raw @exportc form is already a
        # registered root exports nothing new; adding the decorated form only
        # guarantees a cold "export root not found" miss.
        let coldRootSpelling =
            SystemLinkExecRuntimeColdProviderRootSpelling(
                plan.systemLinkPlan.targetTriple, symbol)
        if coldRootSpelling != symbol &&
           SystemLinkExecRuntimeExactTextIndexFind(
               rootIndex, coldRootSpelling, true) >= 0:
            continue
        # [wall134] candidate 入根集必须归一为 coldRootSpelling（raw @exportc
        # 拼写）：provider cold 编译按精确文本在源内匹配 export root（零装饰
        # 感知），本接缝上方注释已声明「strip exactly one decoration」，此前仅
        # 查重臂使用归一形式、add 臂仍携带 plan reloc 列的 target 装饰形式，
        # cold_nested 主对象 seq-str reloc 首次触发（_cheng_seq_str_add not
        # found，provider=program_support_backend）。raw 与 decorated 两行
        # reloc 归一到同一 key 后去重语义不变（同一 raw 只入根一次）。
        var unusedRow: int32
        let _ = SystemLinkExecRuntimeExactTextIndexInsertBorrowed(
            candidateIndex,
            coldRootSpelling,
            relocIndex,
            unusedRow)
    var unusedDuplicateKey: str
    var unusedFirstRow: int32
    var unusedDuplicateRow: int32
    let _ = SystemLinkExecRuntimeExactTextIndexSeal(candidateIndex,
                                                     false,
                                                     unusedDuplicateKey,
                                                     unusedFirstRow,
                                                     unusedDuplicateRow)
    for candidateOrdinal in 0..<candidateIndex.entryKeys.len:
        let symbol = candidateIndex.entryKeys[candidateOrdinal]
        if SystemLinkExecRuntimeExactTextIndexFind(candidateIndex,
                                                   symbol,
                                                   true) == candidateOrdinal:
            add(out, strings.CloneStr(symbol))

    let sealedDefinitionMetrics = SystemLinkExecRuntimeExactTextIndexRelease(definitionIndex)
    let sealedRootMetrics = SystemLinkExecRuntimeExactTextIndexRelease(rootIndex)
    let sealedCandidateMetrics = SystemLinkExecRuntimeExactTextIndexRelease(candidateIndex)
    SystemLinkExecRuntimeExactTextMetricsAccumulate(definitionMetrics,
                                                     sealedDefinitionMetrics)
    SystemLinkExecRuntimeExactTextMetricsAccumulate(rootMetrics,
                                                     sealedRootMetrics)
    SystemLinkExecRuntimeExactTextMetricsAccumulate(rootMetrics,
                                                     sealedCandidateMetrics)
    return true

@borrows
fn SystemLinkExecRuntimeSystemHelpersBackendSourcePath(rootDir: str): str =
    return chengpath.PathAbsolute(rootDir, "src/std/system_helpers_backend.cheng")

@borrows
fn SystemLinkExecRuntimeSystemHelpersBackendObjectPath(plan: sexec.SystemLinkExecPlan): str =
    return Fmt"{plan.systemLinkPlan.outputPath}.runtime.system_helpers_backend.o"

@borrows
fn SystemLinkExecRuntimeAddSystemHelpersBackendRootIfNeeded(
        plan: sexec.SystemLinkExecPlan,
        out: var str[],
        rawSymbol: str) =
    if SystemLinkExecRuntimePlanRelocNeedsSymbol(plan, rawSymbol):
        SystemLinkExecRuntimeAddUniqueText(out, rawSymbol)

@borrows
fn SystemLinkExecRuntimeCollectSystemHelpersBackendExportRoots(
        plan: sexec.SystemLinkExecPlan): str[] =
    var out: str[]
    SystemLinkExecRuntimeAddSystemHelpersBackendRootIfNeeded(plan, out, "cheng_f64_to_bits")
    SystemLinkExecRuntimeAddSystemHelpersBackendRootIfNeeded(plan, out, "cheng_bits_to_f64")
    SystemLinkExecRuntimeAddSystemHelpersBackendRootIfNeeded(plan, out, "cheng_f32_to_bits")
    SystemLinkExecRuntimeAddSystemHelpersBackendRootIfNeeded(plan, out, "cheng_bits_to_f32")
    return out

@borrows
fn SystemLinkExecRuntimeMaterializeSystemHelpersBackendProviderObject(
        rootDir: str,
        compilerPath: str,
        plan: sexec.SystemLinkExecPlan,
        result: var SystemLinkExecRuntimeResult): Result[bool] =
    # 域 E 阶段一 HARD_RED 落点:生产上下文中 system helpers provider 源必须
    # 来自 held bundle,源路径探测已退役。
    if SystemLinkExecRuntimeProductionPathAccessRetired():
        return Err[bool]("HARD_RED:system_link_exec_runtime_system_helpers_provider_requires_held_source_bytes")
    let exportRoots = SystemLinkExecRuntimeCollectSystemHelpersBackendExportRoots(plan)
    if exportRoots.len <= 0:
        return Ok[bool](true)
    let sourcePath = SystemLinkExecRuntimeSystemHelpersBackendSourcePath(rootDir)
    if len(sourcePath) <= 0 || !chengpath.FileExistsNonEmpty(rootDir, sourcePath):
        return Err[bool](Fmt" system link exec runtime: system helpers backend provider source missing: {sourcePath}")
    let objectPath = SystemLinkExecRuntimeSystemHelpersBackendObjectPath(plan)
    let providerModule = "std/system_helpers_backend"
    let packageRoot = strings.CloneStr(plan.systemLinkPlan.packageRoot)
    let targetTriple = strings.CloneStr(plan.systemLinkPlan.targetTriple)
    # 域 E 阶段一:provider object cache 恢复/存储调用点已删除(域 F 退役
    # provider cache,cache ABI 语义由 bundle 内 compiler identity cargo
    # 接替);此处恒为 miss,每次现场编译。
    result.providerObjectCacheMissCount = result.providerObjectCacheMissCount + 1
    let runRes = SystemLinkExecRuntimeCompileProviderObject(rootDir,
                                                             compilerPath,
                                                             packageRoot,
                                                             targetTriple,
                                                             providerModule,
                                                             sourcePath,
                                                             objectPath,
                                                             -1,
                                                             exportRoots)
    if !runRes.ok:
        return Err[bool](strings.CloneStr(runRes.err.msg))
    add(result.providerObjectPaths, strings.CloneStr(objectPath))
    add(result.providerCompileLogPaths, strings.CloneStr(runRes.value.logPath))
    return Ok[bool](true)

@borrows
fn SystemLinkExecRuntimeMaterializeDarwinSyscallProviderObject(
        rootDir: str,
        compilerPath: str,
        plan: sexec.SystemLinkExecPlan,
        result: var SystemLinkExecRuntimeResult): Result[bool] =
    # C4（R2-C2 2026-09-07）：darwin syscall/atomic shim 对象的物化已外移到
    # 组合根——backend_driver_dispatch_min / compiler_composition_aarch64_main
    # 在进入编译流程前经 codegen_darwin_provider_units 门面（B9，插件侧）预
    # 物化；文件系统即组合边界（对象路径 = {outputPath}.darwin_syscall_provider.o，
    # outputPath 与本侧 plan.systemLinkPlan.outputPath 同源同值），内核经
    # providerObjectPaths 消费。本臂转 consume-or-fail-closed 拒收形（同 C6
    # backend2 两臂）：对象缺失 = 提供者单元不在本内核组合，不设兜底写臂。
    let _ = compilerPath
    if SystemLinkExecRuntimeProductionPathAccessRetired():
        return Err[bool]("HARD_RED:system_link_exec_runtime_darwin_syscall_provider_requires_held_source_bytes")
    if plan.systemLinkPlan.emitKind != creq.EmitExe ||
       !tmat.TargetIsDarwinA64(plan.systemLinkPlan.targetTriple):
        return Ok[bool](true)
    let objectPath = Fmt"{plan.systemLinkPlan.outputPath}.darwin_syscall_provider.o"
    result.providerObjectCacheMissCount = result.providerObjectCacheMissCount + 1
    if !chengpath.FileExistsNonEmpty(rootDir, objectPath):
        return Err[bool](Fmt" system link exec: darwin syscall provider unit is not in the kernel composition (object missing: {objectPath})")
    add(result.providerObjectPaths, strings.CloneStr(objectPath))
    add(result.providerCompileLogPaths, "-")
    return Ok[bool](true)

@borrows
fn SystemLinkExecRuntimeProviderExportRootsInto(plan: sexec.SystemLinkExecPlan,
                                                 providerModule: str,
                                                 out: var str[],
                                                 definitionMetrics: var SystemLinkExecRuntimeExactTextIndexMetrics,
                                                 rootMetrics: var SystemLinkExecRuntimeExactTextIndexMetrics,
                                                 err: var str): bool =
    err = ""
    out = []
    if providerModule == "runtime/compiler_runtime":
        SystemLinkExecRuntimeAddUniqueText(out, "main")
        return true
    if providerModule == "runtime/core_runtime":
        SystemLinkExecRuntimeAddCoreRuntimeRoots(plan, out)
        SystemLinkExecRuntimeAddPureCoreRuntimeBridgeRoots(out)
        return true
    if providerModule == "runtime/debug_runtime":
        SystemLinkExecRuntimeAddDebugRuntimeRoots(plan, out)
        return true
    if providerModule == "runtime/program_support":
        SystemLinkExecRuntimeAddPureProgramSupportBridgeRoots(out)
        # Hard cross-provider root: the compiler-runtime entry provider primes
        # the allocation ledger on every exe link, independent of whether the
        # primary's own relocs mention it.
        SystemLinkExecRuntimeAddUniqueText(out, "cheng_allocation_ledger_process_entry_prime")
        # The core provider's heap entry points reference the program_support
        # allocator on every exe link; likewise invisible to the primary
        # reloc scan.
        SystemLinkExecRuntimeAddUniqueText(out, "cheng_malloc")
        SystemLinkExecRuntimeAddUniqueText(out, "cheng_free")
        SystemLinkExecRuntimeAddUniqueText(out, "cheng_realloc")
        SystemLinkExecRuntimeAddUniqueText(out, "cheng_os_file_exists_bridge")
        SystemLinkExecRuntimeAddUniqueText(out, "cheng_os_dir_exists_bridge")
        SystemLinkExecRuntimeAddUniqueText(out, "cheng_os_file_size_bridge")
        return SystemLinkExecRuntimeAppendProgramSupportRelocRoots(plan,
                                                                    out,
                                                                    definitionMetrics,
                                                                    rootMetrics,
                                                                    err)
    if providerModule == "runtime/program_support_host_runtime":
        SystemLinkExecRuntimeAddUniqueText(out, "cheng_program_support_host_trace")
        SystemLinkExecRuntimeAddPureHostRuntimeBridgeRoots(out)
        # Referenced from the program_support directory/read paths whenever the
        # host runtime is linked; not visible in the primary reloc scan.
        SystemLinkExecRuntimeAddUniqueText(out, "cheng_host_getdents")
        if SystemLinkExecRuntimePlanRelocNeedsSymbol(
               plan, "cheng_host_authenticated_persistent_root"):
            SystemLinkExecRuntimeAddUniqueText(
                out, "cheng_host_authenticated_persistent_root")
        if SystemLinkExecRuntimePlanHasProviderModule(plan, "runtime/program_support"):
            SystemLinkExecRuntimeAddProgramSupportHostRuntimeRoots(plan, out)
        # program_support 的内存登记表 (cheng_malloc/free/retain/release 以及 seq
        # 字符串元素拷贝) 通过 cheng_runtime_ptr_slot_load/store_raw_intrinsic
        # 硬依赖这两个 slot 取/存 helper。该依赖是 provider→provider 传递依赖,
        # 主对象 reloc 里看不到,只有当主对象恰好也直接用到时才会被加进根集。
        # 因此一旦 program_support 在场就无条件提供它们的实体,否则 str-seq
        # 的 realloc 路径在链接期报 unresolved __cheng_runtime_ptr_slot_load_raw。
        let programSupportPresent = SystemLinkExecRuntimePlanHasProviderModule(plan, "runtime/program_support")
        if programSupportPresent || SystemLinkExecRuntimePlanRelocNeedsSymbol(plan, "__cheng_runtime_ptr_slot_load_raw"):
            SystemLinkExecRuntimeAddUniqueText(out, "__cheng_runtime_ptr_slot_load_raw")
        if programSupportPresent || SystemLinkExecRuntimePlanRelocNeedsSymbol(plan, "__cheng_runtime_ptr_slot_store_raw"):
            SystemLinkExecRuntimeAddUniqueText(out, "__cheng_runtime_ptr_slot_store_raw")
        if SystemLinkExecRuntimePlanHasProviderModule(plan, "runtime/core_runtime"):
            SystemLinkExecRuntimeAddUniqueText(out, "cheng_host_close")
            SystemLinkExecRuntimeAddUniqueText(out, "cheng_host_open_runtime")
            SystemLinkExecRuntimeAddUniqueText(out, "cheng_host_read_runtime")
            SystemLinkExecRuntimeAddUniqueText(out, "cheng_host_statfs")
            SystemLinkExecRuntimeAddUniqueText(out, "cheng_host_sysconf")
        if SystemLinkExecRuntimePlanHasProviderModule(plan, "runtime/backend_driver_dispatch"):
            SystemLinkExecRuntimeAddBackendDriverHostRuntimeRoots(out)
        return true
    if providerModule == "std/system_helpers_backend":
        var helpersRoots = SystemLinkExecRuntimeCollectSystemHelpersBackendExportRoots(plan)
        for helpersRootIndex in 0..<helpersRoots.len:
            SystemLinkExecRuntimeAddUniqueText(out, helpersRoots[helpersRootIndex])
        return true
    return true

@borrows
fn SystemLinkExecRuntimeProviderCompileArgs(packageRoot: str,
                                             targetTriple: str,
                                             providerModule: str,
                                             sourcePath: str,
                                             objectPath: str,
                                             exportRoots: str[]): str[] =
    var argv: str[]
    let reportPath = Fmt"{objectPath}.report.txt"
    add(argv, "system-link-exec")
    add(argv, Fmt"--root:{packageRoot}")
    add(argv, Fmt"--in:{sourcePath}")
    add(argv, "--emit:obj")
    add(argv, Fmt"--target:{targetTriple}")
    add(argv, Fmt"--out:{objectPath}")
    add(argv, Fmt"--report-out:{reportPath}")
    if exportRoots.len > 0 && targetTriple != "x86_64-pc-windows-msvc":
        add(argv, "--symbol-visibility:internal")
        let rootText = strutil.Join(exportRoots, ",")
        add(argv, Fmt"--export-roots:{rootText}")
    return argv

@borrows
fn SystemLinkExecRuntimeProviderCompileEnv(
        requestedCompilerPath: str): str[] =
    var env: str[]
    add(env, "CHENG_HOSTOPS_SHELL_STATUS=1")
    add(env, "CHENG_REQUIRE_PURE_SYSTEM_LINK_EXEC=0")
    add(env, "CODEX_ALLOW_C_PROVIDERS=1")
    add(env, "CHENG_NO_BACKEND_DRIVER_HANDOFF=1")
    add(env, "CHENG_BACKEND_DRIVER_HANDOFF=0")
    let requestedCompiler = strutil.Strip(requestedCompilerPath)
    if len(requestedCompiler) <= 0:
        panic("system_link_exec_runtime_provider_compile_env_missing_request_compiler")
    if hostops.HostOpsLegacyResourceGuardEnvPresent([]):
        panic("system_link_exec_runtime_legacy_resource_guard_environment")
    add(env, Fmt"CHENG_COLD_COMPILER={requestedCompiler}")
    add(env, Fmt"CHENG_WINDOWS_PRIMARY_OBJECT_COMPILER={requestedCompiler}")
    let processMax = strutil.Strip(os.GetEnv("CHENG_PROCESS_MAX_RSS_BYTES"))
    if len(processMax) > 0:
        add(env, Fmt"CHENG_PROCESS_MAX_RSS_BYTES={processMax}")
    else:
        add(env, "CHENG_PROCESS_MAX_RSS_BYTES=8589934592")
    let windowsToolchain = strutil.Strip(os.GetEnv("CHENG_WINDOWS_TOOLCHAIN"))
    if len(windowsToolchain) > 0:
        add(env, Fmt"CHENG_WINDOWS_TOOLCHAIN={windowsToolchain}")
    let windowsCc = strutil.Strip(os.GetEnv("CHENG_WINDOWS_CC"))
    if len(windowsCc) > 0:
        add(env, Fmt"CHENG_WINDOWS_CC={windowsCc}")
    let windowsCflags = strutil.Strip(os.GetEnv("CHENG_WINDOWS_CFLAGS"))
    if len(windowsCflags) > 0:
        add(env, Fmt"CHENG_WINDOWS_CFLAGS={windowsCflags}")
    let windowsLdflags = strutil.Strip(os.GetEnv("CHENG_WINDOWS_LDFLAGS"))
    if len(windowsLdflags) > 0:
        add(env, Fmt"CHENG_WINDOWS_LDFLAGS={windowsLdflags}")
    let windowsLdlibs = strutil.Strip(os.GetEnv("CHENG_WINDOWS_LDLIBS"))
    if len(windowsLdlibs) > 0:
        add(env, Fmt"CHENG_WINDOWS_LDLIBS={windowsLdlibs}")
    let strictNoCache = strutil.Strip(os.GetEnv("CHENG_STRICT_NO_CACHE"))
    if len(strictNoCache) > 0:
        add(env, Fmt"CHENG_STRICT_NO_CACHE={strictNoCache}")
    let runtimeNoCache = strutil.Strip(os.GetEnv("CHENG_SYSTEM_LINK_EXEC_NO_CACHE"))
    if len(runtimeNoCache) > 0:
        add(env, Fmt"CHENG_SYSTEM_LINK_EXEC_NO_CACHE={runtimeNoCache}")
    let coldObjectNoCache = strutil.Strip(os.GetEnv("CHENG_DISABLE_COLD_OBJECT_CACHE"))
    if len(coldObjectNoCache) > 0:
        add(env, Fmt"CHENG_DISABLE_COLD_OBJECT_CACHE={coldObjectNoCache}")
    let primaryNoCache = strutil.Strip(os.GetEnv("CHENG_DISABLE_WINDOWS_PRIMARY_OBJECT_CACHE"))
    if len(primaryNoCache) > 0:
        add(env, Fmt"CHENG_DISABLE_WINDOWS_PRIMARY_OBJECT_CACHE={primaryNoCache}")
    let providerNoCache = strutil.Strip(os.GetEnv("CHENG_DISABLE_PROVIDER_OBJECT_CACHE"))
    if len(providerNoCache) > 0:
        add(env, Fmt"CHENG_DISABLE_PROVIDER_OBJECT_CACHE={providerNoCache}")
    return env

@borrows
fn SystemLinkExecRuntimeCompileProviderObject(rootDir: str,
                                               compilerPath: str,
                                               packageRoot: str,
                                               targetTriple: str,
                                               providerModule: str,
                                               sourcePath: str,
                                               objectPath: str,
                                               index: int32,
                                               exportRoots: str[]): Result[hostops.LoggedRun] =
    # 域 E 阶段一 HARD_RED 落点:生产上下文中 provider 编译子进程的
    # --in:<源码路径> raw path argv 已退役,字节必须来自 held bundle 经匿名
    # held file(域 G)以 /dev/fd/N 交付;该形态接通前,无 live CLAIMED
    # lease 的生产到达在此拒签。
    if SystemLinkExecRuntimeProductionPathAccessRetired():
        return Err[hostops.LoggedRun]("HARD_RED:system_link_exec_runtime_provider_compile_requires_held_source_bytes")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=provider_compile_enter index={index}")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=provider_compile_paths compiler={compilerPath} root={rootDir} package={packageRoot}")
    let parent = chengpath.PathParentDir(objectPath)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=provider_compile_after_parent")
    if len(parent) > 0 && !chengpath.MkdirP(rootDir, parent):
        return Err[hostops.LoggedRun](Fmt" system link exec runtime: failed to create provider object dir: {parent}")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=provider_compile_after_mkdir")
    let objectAbs = chengpath.PathAbsolute(rootDir, objectPath)
    if os.FileExists(objectAbs):
        let _ = os.RemoveFile(objectAbs)
    let objectHexAbs = chengpath.PathAbsolute(rootDir, Fmt"{objectPath}.hex")
    if os.FileExists(objectHexAbs):
        let _ = os.RemoveFile(objectHexAbs)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=provider_compile_after_object_remove")
    let logPath = Fmt"{objectPath}.compile.log"
    let reportPath = Fmt"{objectPath}.report.txt"
    let reportAbs = chengpath.PathAbsolute(rootDir, reportPath)
    if os.FileExists(reportAbs):
        let _ = os.RemoveFile(reportAbs)
    let logAbs = chengpath.PathAbsolute(rootDir, logPath)
    if os.FileExists(logAbs):
        let _ = os.RemoveFile(logAbs)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=provider_compile_after_log_remove")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=provider_compile_module_len value={providerModule.len}")
    let argv = SystemLinkExecRuntimeProviderCompileArgs(packageRoot,
                                                         targetTriple,
                                                         providerModule,
                                                         sourcePath,
                                                         objectPath,
                                                         exportRoots)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=provider_compile_after_argv argc={argv.len}")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        for ai in 0..<argv.len:
            os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=provider_compile_argv index={ai} value={argv[ai]}")
    var providerEnv = SystemLinkExecRuntimeProviderCompileEnv(compilerPath)
    let run = hostops.RunFileLogged(rootDir,
                                    Fmt"system_link_exec_provider_{strings.IntToStr(index)}",
                                    compilerPath,
                                    argv,
                                    providerEnv,
                                    rootDir,
                                    0,
                                    logPath)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=provider_compile_after_run rc={run.exitCode}")
    if run.exitCode != 0:
        return Err[hostops.LoggedRun](Fmt" system link exec runtime: provider compile failed rc={strings.IntToStr(run.exitCode)} source={sourcePath} log={run.logPath}\n{run.output}")
    if !chengpath.FileExistsNonEmpty(rootDir, objectPath):
        return Err[hostops.LoggedRun](Fmt" system link exec runtime: provider object missing after compile: {objectPath}")
    return Ok[hostops.LoggedRun](run)

@borrows
fn SystemLinkExecRuntimeProviderTaskResultEmpty(
        sourcePath: str,
        objectPath: str,
        providerModule: str): SystemLinkExecRuntimeProviderTaskResult =
    var out: SystemLinkExecRuntimeProviderTaskResult
    out.sourcePath = Fmt"{sourcePath}"
    out.objectPath = Fmt"{objectPath}"
    out.providerModule = Fmt"{providerModule}"
    return out

@borrows
fn SystemLinkExecRuntimePrepareProviderTask(
        rootDir: str,
        plan: sexec.SystemLinkExecPlan,
        sourcePath: str,
        objectPath: str,
        providerModule: str): SystemLinkExecRuntimeProviderTaskResult =
    let _ = rootDir
    var task = SystemLinkExecRuntimeProviderTaskResultEmpty(
        sourcePath, objectPath, providerModule)
    var exportRoots: str[]
    var definitionMetrics: SystemLinkExecRuntimeExactTextIndexMetrics
    var rootMetrics: SystemLinkExecRuntimeExactTextIndexMetrics
    var rootsErr: str
    if !SystemLinkExecRuntimeProviderExportRootsInto(plan,
                                                      providerModule,
                                                      exportRoots,
                                                      definitionMetrics,
                                                      rootMetrics,
                                                      rootsErr):
        task.completed = true
        task.ok = false
        task.errorMessage = rootsErr
        task.exportRoots = exportRoots
        task.relocDefinitionMetrics = definitionMetrics
        task.relocRootMetrics = rootMetrics
        return task
    # 域 E 阶段一:provider object cache 恢复调用点已删除;任务恒落入
    # 现场编译(SystemLinkExecRuntimeProviderCompileIndex)。
    task.exportRoots = exportRoots
    task.relocDefinitionMetrics = definitionMetrics
    task.relocRootMetrics = rootMetrics
    return task

@borrows
fn SystemLinkExecRuntimeProviderCompileIndex(
        parallel: SystemLinkExecRuntimeProviderParallelContext,
        index: int32) =
    if index < 0 || index >= parallel.taskCount:
        panic("system_link_exec_runtime_provider_index_out_of_range")
    if parallel.results[index].completed:
        return
    let sourcePath: str = parallel.results[index].sourcePath
    let objectPath: str = parallel.results[index].objectPath
    let providerModule: str = parallel.results[index].providerModule
    let runRes = SystemLinkExecRuntimeCompileProviderObject(parallel.rootDir,
                                                             parallel.compilerPath,
                                                             parallel.packageRoot,
                                                             parallel.targetTriple,
                                                             providerModule,
                                                             sourcePath,
                                                             objectPath,
                                                             index,
                                                             parallel.results[index].exportRoots)
    var results = parallel.results
    var task = results[index]
    task.completed = true
    if !runRes.ok:
        task.ok = false
        task.errorMessage =
            strings.CloneStr(runRes.err.msg)
        results[index] = task
        parallel.results = results
        return
    task.ok = true
    task.logPath =
        strings.CloneStr(runRes.value.logPath)
    results[index] = task
    parallel.results = results

@borrows
fn SystemLinkExecRuntimeProviderWsPopOwn(
                                          parallel: SystemLinkExecRuntimeProviderParallelContext,
                                          workerId: int32,
                                          taskIndex: var int32): bool =
    if workerId < 0 || workerId >= parallel.workerCount:
        return false
    let headCell = parallel.shardHeads[workerId]
    let tailCell = parallel.shardTails[workerId]
    let nextTail: int32 = atomic.LoadI32(tailCell) - 1
    atomic.StoreI32(tailCell, nextTail)
    let head = atomic.LoadI32(headCell)
    if head < nextTail:
        taskIndex = nextTail
        return true
    atomic.StoreI32(tailCell, head)
    if head == nextTail:
        if atomic.CasI32(headCell, head, head + 1):
            taskIndex = nextTail
            atomic.StoreI32(tailCell, head + 1)
            return true
    atomic.StoreI32(tailCell, atomic.LoadI32(headCell))
    return false

@borrows
fn SystemLinkExecRuntimeProviderWsStealFrom(
                                             parallel: SystemLinkExecRuntimeProviderParallelContext,
                                             victimId: int32,
                                             taskIndex: var int32): bool =
    if victimId < 0 || victimId >= parallel.workerCount:
        return false
    let headCell = parallel.shardHeads[victimId]
    let tailCell = parallel.shardTails[victimId]
    while true:
        let head = atomic.LoadI32(headCell)
        let tail = atomic.LoadI32(tailCell)
        if head >= tail:
            return false
        if atomic.CasI32(headCell, head, head + 1):
            taskIndex = head
            return true

@borrows
fn SystemLinkExecRuntimeProviderWsTakeTask(
                                            parallel: SystemLinkExecRuntimeProviderParallelContext,
                                            workerId: int32,
                                            taskIndex: var int32): bool =
    if SystemLinkExecRuntimeProviderWsPopOwn(parallel, workerId, taskIndex):
        return true
    var offset = 1
    while offset < parallel.workerCount:
        let victimId = (workerId + offset) % parallel.workerCount
        if SystemLinkExecRuntimeProviderWsStealFrom(parallel,
                                                    victimId,
                                                    taskIndex):
            return true
        offset = offset + 1
    return false

@borrows
fn SystemLinkExecRuntimeProviderWorkerRun(
        parallel: SystemLinkExecRuntimeProviderParallelContext,
        workerId: int32) =
    while true:
        var taskIndex: int32
        if !SystemLinkExecRuntimeProviderWsTakeTask(parallel,
                                                    workerId,
                                                    taskIndex):
            break
        SystemLinkExecRuntimeProviderCompileIndex(parallel, taskIndex)

@borrows
fn SystemLinkExecRuntimeProviderWorkerEntryForId(
        parallel: SystemLinkExecRuntimeProviderParallelContext,
        workerId: int32) =
    if parallel.workerCount <= 0:
        panic("system_link_exec_runtime_provider_worker_parallel_nil")
    if workerId < 0 || workerId >= parallel.workerCount:
        panic("system_link_exec_runtime_provider_worker_id_out_of_range")
    SystemLinkExecRuntimeProviderWorkerRun(parallel, workerId)
    let doneCount = parallel.doneCount
    if doneCount == nil:
        panic("system_link_exec_runtime_provider_worker_done_nil")
    let _ = atomic.AddI32(doneCount, 1)

fn SystemLinkExecRuntimeProviderWorkerMain() =
    let parallel = systemLinkExecRuntimeProviderParallelCurrent
    if parallel.workerCount <= 0:
        panic("system_link_exec_runtime_provider_worker_parallel_unset")
    let workerId = atomic.FetchAddI32(
        systemLinkExecRuntimeProviderWorkerNext, 1)
    SystemLinkExecRuntimeProviderWorkerEntryForId(parallel, workerId)

@borrows
fn SystemLinkExecRuntimePrepareProviderParallelSlots(rootDir: str,
                                                      compilerPath: str,
                                                      plan: sexec.SystemLinkExecPlan,
                                                      taskCount: int32,
                                                      workerCount: int32): SystemLinkExecRuntimeProviderParallelContext =
    var parallel: SystemLinkExecRuntimeProviderParallelContext
    parallel.rootDir = strings.CloneStr(rootDir)
    parallel.compilerPath = strings.CloneStr(compilerPath)
    parallel.packageRoot = strings.CloneStr(plan.systemLinkPlan.packageRoot)
    parallel.targetTriple = strings.CloneStr(plan.systemLinkPlan.targetTriple)
    parallel.taskCount = taskCount
    parallel.workerCount = workerCount
    parallel.doneCount = atomic.NewI32(0)
    if parallel.doneCount == nil:
        panic("system_link_exec_runtime_provider_ws_done_atomic_alloc_failed")
    var results: SystemLinkExecRuntimeProviderTaskResult[]
    for i in 0..<taskCount:
        let sourcePath = SystemLinkExecRuntimeOwnedTextAtOrEmpty(
            plan.objectPlan.providerSourcePaths, i)
        let objectPath = SystemLinkExecRuntimeOwnedTextAtOrEmpty(
            plan.objectPlan.providerObjectPaths, i)
        let providerModule = SystemLinkExecRuntimeOwnedTextAtOrEmpty(
            plan.objectPlan.providerModules,
            i < plan.objectPlan.providerModules.len ? i : -1)
        var task = SystemLinkExecRuntimePrepareProviderTask(
            rootDir,
            plan,
            sourcePath,
            objectPath,
            providerModule)
        add(results, task)
    parallel.results = results
    var shardHeads: atomic.I32[]
    var shardTails: atomic.I32[]
    for workerId in 0..<workerCount:
        let start = (taskCount * workerId) / workerCount
        let finish = (taskCount * (workerId + 1)) / workerCount
        let head = atomic.NewI32(start)
        let tail = atomic.NewI32(finish)
        if head == nil || tail == nil:
            panic("system_link_exec_runtime_provider_ws_deque_alloc_failed")
        add(shardHeads, head)
        add(shardTails, tail)
    parallel.shardHeads = shardHeads
    parallel.shardTails = shardTails
    return parallel

fn SystemLinkExecRuntimeRunProviderWorkers(
        parallel: var SystemLinkExecRuntimeProviderParallelContext) =
    if parallel.workerCount <= 0:
        panic("system_link_exec_runtime_provider_parallel_ctx_nil")
    let workerCount = parallel.workerCount
    var workerThreads: thread.Thread[]
    systemLinkExecRuntimeProviderParallelCurrent = parallel
    systemLinkExecRuntimeProviderWorkerNext = atomic.NewI32(1)
    if systemLinkExecRuntimeProviderWorkerNext == nil:
        systemLinkExecRuntimeProviderParallelCurrent = SystemLinkExecRuntimeProviderParallelContext()
        panic("system_link_exec_runtime_provider_ws_worker_ordinal_alloc_failed")
    for w in 1..<workerCount:
        let t = thread.StartFn(SystemLinkExecRuntimeProviderWorkerMain)
        if t == nil:
            for ti in 0..<workerThreads.len:
                if !thread.JoinThread(workerThreads[ti]):
                    panic("system_link_exec_runtime_provider_ws_join_failed_after_start")
            systemLinkExecRuntimeProviderParallelCurrent = SystemLinkExecRuntimeProviderParallelContext()
            systemLinkExecRuntimeProviderWorkerNext = nil
            panic("system_link_exec_runtime_provider_ws_worker_start_failed")
        add(workerThreads, t)
    SystemLinkExecRuntimeProviderWorkerEntryForId(parallel, 0)
    for ti in 0..<workerThreads.len:
        if !thread.JoinThread(workerThreads[ti]):
            panic("system_link_exec_runtime_provider_ws_worker_join_failed")
    let completedWorkers = atomic.LoadI32(parallel.doneCount)
    systemLinkExecRuntimeProviderParallelCurrent = SystemLinkExecRuntimeProviderParallelContext()
    systemLinkExecRuntimeProviderWorkerNext = nil
    if completedWorkers != workerCount:
        panic("system_link_exec_runtime_provider_ws_worker_count_mismatch")

@borrows
fn SystemLinkExecRuntimeFixedBytes32FromOkResult(res: Result[layout.FixedBytes32]): layout.FixedBytes32 =
    if !res.ok:
        var zero: layout.FixedBytes32
        return zero
    let owned = Value(res)
    return layout.FixedBytes32Copy(owned)

@borrows
fn SystemLinkExecRuntimeCompilerSourceClosureSha256OrZero(rootDir: str,
                                                           plan: sexec.SystemLinkExecPlan,
                                                           cacheDisabled: bool): layout.FixedBytes32 =
    if cacheDisabled:
        var zero: layout.FixedBytes32
        return zero
    return SystemLinkExecRuntimeFixedBytes32FromOkResult(
        SystemLinkExecRuntimeCompilerSourceClosureSha256(rootDir, plan))

@borrows
fn SystemLinkExecRuntimeProviderSourceClosureSha256OrZero(rootDir: str,
                                                           plan: sexec.SystemLinkExecPlan,
                                                           sourcePath: str,
                                                           cacheDisabled: bool): layout.FixedBytes32 =
    if cacheDisabled:
        var zero: layout.FixedBytes32
        return zero
    return SystemLinkExecRuntimeFixedBytes32FromOkResult(
        SystemLinkExecRuntimeSourceClosureSha256(rootDir, plan, sourcePath))

@borrows
fn SystemLinkExecRuntimeMaterializeProviderObjects(rootDir: str,
                                                    compilerPath: str,
                                                    plan: sexec.SystemLinkExecPlan,
                                                    result: var SystemLinkExecRuntimeResult): Result[bool] =
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=provider_materialize_enter")
    let startNs = SystemLinkExecRuntimeNowNs()
    let taskCount: int32 = plan.objectPlan.providerSourcePaths.len
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=provider_materialize_task_count value={taskCount}")
    result.providerParallelTaskCount = taskCount
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=provider_materialize_after_task_count_assign")
    let requestedJobs: int32 = 1
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=provider_materialize_requested_jobs value={requestedJobs}")
    result.providerParallelJobCount = requestedJobs
    if taskCount <= 0:
        result.providerParallelStatus = "none"
        result.providerObjectCacheStatus = "none"
        result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
        return Ok[bool](true)
    if plan.systemLinkPlan.targetTriple == "x86_64-pc-windows-msvc":
        return SystemLinkExecRuntimeMaterializeWindowsProviderObject(rootDir, compilerPath, plan, result)
    var workerCount = requestedJobs
    if workerCount > taskCount:
        workerCount = taskCount
    if workerCount < 1:
        workerCount = 1
    result.providerParallelActiveWorkers = workerCount
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=provider_materialize_worker_count value={workerCount}")
    if workerCount > 1:
        result.providerParallelStatus = "ws"
    else:
        result.providerParallelStatus = "serial"
    # 域 E 阶段一:provider object cache 调用点已删除(域 F 退役),cache ABI
    # 语义由 bundle 内 compiler identity cargo(tag 15)接替;下方两条路径
    # 恒为 miss,每次现场编译。
    if workerCount == 1:
        var relocDefMetrics: SystemLinkExecRuntimeExactTextIndexMetrics
        var relocRootMetrics: SystemLinkExecRuntimeExactTextIndexMetrics
        let packageRoot = strings.CloneStr(plan.systemLinkPlan.packageRoot)
        let targetTriple = strings.CloneStr(plan.systemLinkPlan.targetTriple)
        for i in 0..<taskCount:
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=provider_materialize_serial_task index={i}")
            let sourcePath = SystemLinkExecRuntimeOwnedTextAtOrEmpty(
                plan.objectPlan.providerSourcePaths, i)
            let objectPath = SystemLinkExecRuntimeOwnedTextAtOrEmpty(
                plan.objectPlan.providerObjectPaths, i)
            let providerModule = SystemLinkExecRuntimeOwnedTextAtOrEmpty(
                plan.objectPlan.providerModules,
                i < plan.objectPlan.providerModules.len ? i : -1)
            var exportRoots: str[]
            var definitionMetrics: SystemLinkExecRuntimeExactTextIndexMetrics
            var rootMetrics: SystemLinkExecRuntimeExactTextIndexMetrics
            var rootsErr: str
            if !SystemLinkExecRuntimeProviderExportRootsInto(plan,
                                                              providerModule,
                                                              exportRoots,
                                                              definitionMetrics,
                                                              rootMetrics,
                                                              rootsErr):
                result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
                return Err[bool](strings.CloneStr(rootsErr))
            SystemLinkExecRuntimeExactTextMetricsAccumulate(relocDefMetrics,
                                                             definitionMetrics)
            SystemLinkExecRuntimeExactTextMetricsAccumulate(relocRootMetrics,
                                                             rootMetrics)
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=provider_materialize_serial_paths source_len={sourcePath.len} object_len={objectPath.len}")
            # 域 E 阶段一:cache 恢复/存储调用点已删除,恒 miss 现场编译。
            result.providerObjectCacheMissCount = result.providerObjectCacheMissCount + 1
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), "debug_system_link_exec=provider_materialize_serial_before_compile")
            let runRes = SystemLinkExecRuntimeCompileProviderObject(rootDir,
                                                                    compilerPath,
                                                                    packageRoot,
                                                                    targetTriple,
                                                                    providerModule,
                                                                    sourcePath,
                                                                    objectPath,
                                                                    i,
                                                                    exportRoots)
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=provider_materialize_serial_after_compile ok={runRes.ok}")
            if !runRes.ok:
                result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
                return Err[bool](strings.CloneStr(runRes.err.msg))
            add(result.providerObjectPaths, strings.CloneStr(objectPath))
            add(result.providerCompileLogPaths,
                strings.CloneStr(runRes.value.logPath))
        result.indexMetrics.relocDefinition = relocDefMetrics
        result.indexMetrics.relocRoot = relocRootMetrics
        result.providerParallelCompletedWorkers = 1
        result.providerObjectCacheStatus = "disabled_miss"
        let helpersRes = SystemLinkExecRuntimeMaterializeSystemHelpersBackendProviderObject(
            rootDir, compilerPath, plan, result)
        if !helpersRes.ok:
            result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
            return Err[bool](strings.CloneStr(helpersRes.err.msg))
        let darwinSyscallResSerial =
            SystemLinkExecRuntimeMaterializeDarwinSyscallProviderObject(
                rootDir, compilerPath, plan, result)
        if !darwinSyscallResSerial.ok:
            result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
            return Err[bool](strings.CloneStr(darwinSyscallResSerial.err.msg))
        result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
        return Ok[bool](true)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=provider_materialize_before_prepare")
    var providerParallel = SystemLinkExecRuntimePrepareProviderParallelSlots(
        rootDir,
        compilerPath,
        plan,
        taskCount,
        workerCount)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=provider_materialize_after_prepare")
    SystemLinkExecRuntimeRunProviderWorkers(providerParallel)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=provider_materialize_after_workers")
    result.providerParallelCompletedWorkers = atomic.LoadI32(providerParallel.doneCount)
    var workerRelocDef: SystemLinkExecRuntimeExactTextIndexMetrics
    var workerRelocRoot: SystemLinkExecRuntimeExactTextIndexMetrics
    for i in 0..<taskCount:
        SystemLinkExecRuntimeExactTextMetricsAccumulate(workerRelocDef,
                                                         providerParallel.results[i].relocDefinitionMetrics)
        SystemLinkExecRuntimeExactTextMetricsAccumulate(workerRelocRoot,
                                                         providerParallel.results[i].relocRootMetrics)
        if !providerParallel.results[i].completed:
            result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
            return Err[bool](Fmt" system link exec runtime: provider compile task did not complete at index {strings.IntToStr(i)}")
        if !providerParallel.results[i].ok:
            result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
            return Err[bool](strings.CloneStr(providerParallel.results[i].errorMessage))
        # 域 E 阶段一:cache 存储调用点已删除,任务恒为现场编译 miss。
        result.providerObjectCacheMissCount = result.providerObjectCacheMissCount + 1
        add(result.providerObjectPaths,
            strings.CloneStr(providerParallel.results[i].objectPath))
        add(result.providerCompileLogPaths,
            strings.CloneStr(providerParallel.results[i].logPath))
    result.indexMetrics.relocDefinition = workerRelocDef
    result.indexMetrics.relocRoot = workerRelocRoot
    if result.providerObjectPaths.len != taskCount:
        result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
        return Err[bool](" system link exec runtime: provider indexed merge count mismatch")
    result.providerObjectCacheStatus = "disabled_miss"
    let helpersRes = SystemLinkExecRuntimeMaterializeSystemHelpersBackendProviderObject(
        rootDir, compilerPath, plan, result)
    if !helpersRes.ok:
        result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
        return Err[bool](strings.CloneStr(helpersRes.err.msg))
    let darwinSyscallRes =
        SystemLinkExecRuntimeMaterializeDarwinSyscallProviderObject(
            rootDir, compilerPath, plan, result)
    if !darwinSyscallRes.ok:
        result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
        return Err[bool](strings.CloneStr(darwinSyscallRes.err.msg))
    result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
    return Ok[bool](true)

@borrows
fn SystemLinkExecRuntimeRecordExternalProviderObjects(rootDir: str,
                                                       plan: sexec.SystemLinkExecPlan,
                                                       result: var SystemLinkExecRuntimeResult): Result[bool] =
    # 域 E 阶段一 HARD_RED 落点:生产上下文中外部 provider 对象字节必须来自
    # held bundle(tag 14),路径探测已退役。
    if SystemLinkExecRuntimeProductionPathAccessRetired():
        return Err[bool]("HARD_RED:system_link_exec_runtime_external_provider_objects_require_held_bundle")
    let startNs = SystemLinkExecRuntimeNowNs()
    let firstExternal: int32 = plan.objectPlan.providerSourcePaths.len
    for i in firstExternal..<plan.objectPlan.providerObjectPaths.len:
        let objectPath = strings.CloneStr(plan.objectPlan.providerObjectPaths[i])
        if len(objectPath) <= 0:
            result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
            return Err[bool](Fmt" system link exec runtime: external provider object missing at index {strings.IntToStr(i)}")
        if !chengpath.FileExistsNonEmpty(rootDir, objectPath):
            result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
            return Err[bool](Fmt" system link exec runtime: external provider object missing: {objectPath}")
        add(result.providerObjectPaths, strings.CloneStr(objectPath))
        add(result.providerCompileLogPaths, "-")
    result.providerObjectsNs = SystemLinkExecRuntimeNowNs() - startNs
    return Ok[bool](true)

@borrows
fn SystemLinkExecRuntimeMergeNativeInputPathsFailure(
        existingIndex: var SystemLinkExecRuntimeExactTextIndex,
        providerIndex: var SystemLinkExecRuntimeExactTextIndex,
        message: str): Result[SystemLinkExecRuntimeExactTextIndexMetrics] =
    let failedExistingMetrics =
        SystemLinkExecRuntimeExactTextIndexRelease(existingIndex)
    let failedProviderMetrics =
        SystemLinkExecRuntimeExactTextIndexRelease(providerIndex)
    var failedMetrics: SystemLinkExecRuntimeExactTextIndexMetrics
    SystemLinkExecRuntimeExactTextMetricsAccumulate(
        failedMetrics, failedExistingMetrics)
    SystemLinkExecRuntimeExactTextMetricsAccumulate(
        failedMetrics, failedProviderMetrics)
    return Err[SystemLinkExecRuntimeExactTextIndexMetrics](strings.CloneStr(message))

@borrows
fn SystemLinkExecRuntimeMergeNativeInputPaths(rootDir: str,
                                               paths: var str[],
                                               providerObjectPaths: str[]): Result[SystemLinkExecRuntimeExactTextIndexMetrics] =
    if paths.len > int32(536870911) - providerObjectPaths.len:
        return Err[SystemLinkExecRuntimeExactTextIndexMetrics](" system link exec runtime: native input index capacity overflow")
    var existingIndex = SystemLinkExecRuntimeExactTextIndexInit(paths.len)
    var providerIndexSet =
        SystemLinkExecRuntimeExactTextIndexInit(providerObjectPaths.len)
    var failMsg: str
    for inputIndex in 0..<paths.len:
        if failMsg != "":
            break
        let inputPath = strings.CloneStr(paths[inputIndex])
        let canonicalPath = SystemLinkExecRuntimeCanonicalPath(rootDir, inputPath)
        if len(canonicalPath) <= 0:
            failMsg = Fmt" system link exec runtime: invalid native input path at index {strings.IntToStr(inputIndex)}: {inputPath}"
        else:
            var existingRow: int32
            let _ = SystemLinkExecRuntimeExactTextIndexInsert(existingIndex,
                                                               canonicalPath,
                                                               inputIndex,
                                                               true,
                                                               existingRow)
    var unusedDuplicateKey: str
    var unusedFirstRow: int32
    var unusedDuplicateRow: int32
    if failMsg == "":
        let _ = SystemLinkExecRuntimeExactTextIndexSeal(existingIndex,
                                                         false,
                                                         unusedDuplicateKey,
                                                         unusedFirstRow,
                                                         unusedDuplicateRow)
        for providerIndex in 0..<providerObjectPaths.len:
            if failMsg != "":
                break
            let providerPath = strings.CloneStr(providerObjectPaths[providerIndex])
            let canonicalPath = SystemLinkExecRuntimeCanonicalPath(rootDir, providerPath)
            if len(canonicalPath) <= 0:
                failMsg = Fmt" system link exec runtime: invalid runtime provider input path at index {strings.IntToStr(providerIndex)}: {providerPath}"
            else:
                var unusedRow: int32
                let _ = SystemLinkExecRuntimeExactTextIndexInsert(providerIndexSet,
                                                                   canonicalPath,
                                                                   providerIndex,
                                                                   true,
                                                                   unusedRow)
    if failMsg != "":
        return SystemLinkExecRuntimeMergeNativeInputPathsFailure(
            existingIndex,
            providerIndexSet,
            failMsg)
    let _ = SystemLinkExecRuntimeExactTextIndexSeal(providerIndexSet,
                                                     false,
                                                     unusedDuplicateKey,
                                                     unusedFirstRow,
                                                     unusedDuplicateRow)
    # Canonical alias contract: existing link inputs are an ordered multiset and
    # remain byte-for-byte unchanged. A provider alias already represented by
    # that multiset is skipped; repeated provider aliases append only once.
    for providerIndex in 0..<providerObjectPaths.len:
        let providerPath = strings.CloneStr(providerObjectPaths[providerIndex])
        let canonicalPath = SystemLinkExecRuntimeCanonicalPath(rootDir, providerPath)
        if SystemLinkExecRuntimeExactTextIndexFind(existingIndex,
                                                   canonicalPath,
                                                   true) >= 0:
            continue
        if SystemLinkExecRuntimeExactTextIndexFind(providerIndexSet,
                                                   canonicalPath,
                                                   true) != providerIndex:
            continue
        add(paths, strings.CloneStr(providerPath))
    var metrics: SystemLinkExecRuntimeExactTextIndexMetrics
    let existingMetrics = SystemLinkExecRuntimeExactTextIndexRelease(existingIndex)
    SystemLinkExecRuntimeExactTextMetricsAccumulate(metrics, existingMetrics)
    let providerMetrics = SystemLinkExecRuntimeExactTextIndexRelease(providerIndexSet)
    SystemLinkExecRuntimeExactTextMetricsAccumulate(metrics, providerMetrics)
    return Ok[SystemLinkExecRuntimeExactTextIndexMetrics](metrics)

@borrows
fn SystemLinkExecRuntimeStandaloneNativePlan(plan: sexec.SystemLinkExecPlan,
                                              primaryObjectPath: str): nplan.NativeLinkPlanStub =
    var out: nplan.NativeLinkPlanStub
    var linkInputs: str[]
    add(linkInputs, strings.CloneStr(primaryObjectPath))
    out.targetTriple = strings.CloneStr(plan.systemLinkPlan.targetTriple)
    out.emitKind = creq.EmitExe
    out.outputPath = strings.CloneStr(plan.systemLinkPlan.outputPath)
    out.objectFormat = tmat.TargetPrimaryObjectFormat(plan.systemLinkPlan.targetTriple)
    out.linkerProgram = tmat.TargetLinkerProgram(plan.systemLinkPlan.targetTriple)
    out.linkerFlavor = tmat.TargetLinkerFlavor(plan.systemLinkPlan.targetTriple)
    out.outputKind = nplan.NativeOutputExecutable
    out.entrySymbol = "main"
    out.primaryObjectPath = strings.CloneStr(primaryObjectPath)
    out.browserBridgeObjectPath = ""
    out.linkInputPaths = linkInputs
    out.missingReasons = []
    out.pipelineStage = "standalone_primary_object_to_native_link_plan"
    return out

@borrows
fn SystemLinkExecRuntimeNativeLinkLogPath(plan: sexec.SystemLinkExecPlan): str =
    if len(plan.systemLinkPlan.outputPath) <= 0:
        return ""
    return Fmt"{plan.systemLinkPlan.outputPath}.native_link.log"

@borrows
fn SystemLinkExecRuntimeNativeLinkerIsSelf(targetTriple: str, linkerFlavor: str): bool =
    if linkerFlavor == "coff_pe_builtin":
        if targetTriple == "x86_64-pc-windows-msvc":
            return true
        if targetTriple == "aarch64-pc-windows-msvc":
            return true
        if targetTriple == "arm64-pc-windows-msvc":
            return true
    return nlink.NativeLinkExecIsSelfLinker(targetTriple, linkerFlavor)

@borrows
fn SystemLinkExecRuntimeRunNativeLinkLogged(rootDir: str,
                                           label: str,
                                           nativePlan: nplan.NativeLinkPlanStub,
                                           logPath: str): hostops.LoggedRun =
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=native_link_logged_enter flavor={nativePlan.linkerFlavor}")
    if nativePlan.linkerFlavor == "coff_pe_builtin":
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=native_link_coff_before_call")
        let linkRes = coff_object_linker.CoffLinkExeA64(nativePlan.linkInputPaths,
                                                            nativePlan.outputPath,
                                                            nativePlan.targetTriple)
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=native_link_coff_after_call ok={SystemLinkExecRuntimeBoolText(linkRes.ok)}")
        if !linkRes.ok:
            let outputText = strutil.Join([share(linkRes.err.msg), "\n"], "")
            let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
            return hostops.LoggedRunZero(label, nativePlan.linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 1, outputText)
        let outputText = strutil.Join([
            share(nativePlan.outputPath), " OK\n",
            "native_linker_program=", share(nativePlan.linkerProgram), "\n",
            "native_linker_flavor=", share(nativePlan.linkerFlavor), "\n",
            "system_link_exec_scope=selfhost_direct\n",
            "linkerless_image=1\n",
            "provider_link_mode=internal\n",
            "unresolved_symbol_count=0\n",
            "first_unresolved_symbol=\n"
        ], "")
        let _logged = chengpath.WriteTextFile(rootDir, logPath, outputText)
        return hostops.LoggedRunZero(label, nativePlan.linkerProgram, chengpath.PathAbsolute(rootDir, logPath), 0, outputText)
    return nlink.NativeLinkExecRunLogged(rootDir, label, nativePlan, logPath)

fn SystemLinkExecRuntimeRunNativeLink(rootDir: str,
                                       plan: var sexec.SystemLinkExecPlan,
                                       nativePlan: nplan.NativeLinkPlanStub,
                                       result: var SystemLinkExecRuntimeResult): Result[bool] =
    # 域 E 阶段一 HARD_RED 落点:生产上下文中 exe 写出目标必须是 owner 下发的
    # staging handle(域 F 发布链),直写 req.outputPath 已退役。
    if SystemLinkExecRuntimeProductionPathAccessRetired():
        return Err[bool]("HARD_RED:system_link_exec_runtime_output_write_requires_staging_handle")
    let startNs = SystemLinkExecRuntimeNowNs()
    let logPath = SystemLinkExecRuntimeNativeLinkLogPath(plan)
    let outputAbs = chengpath.PathAbsolute(rootDir, plan.systemLinkPlan.outputPath)
    result.nativeLinkerSelf = SystemLinkExecRuntimeNativeLinkerIsSelf(nativePlan.targetTriple, nativePlan.linkerFlavor)
    if len(outputAbs) > 0 && os.FileExists(outputAbs):
        let _ = os.RemoveFile(outputAbs)
    let run = SystemLinkExecRuntimeRunNativeLinkLogged(rootDir,
                                                       "system_link_exec_native_link",
                                                       nativePlan,
                                                       logPath)
    result.nativeLinkLogPath = run.logPath
    result.nativeLinkNs = SystemLinkExecRuntimeNowNs() - startNs
    if run.exitCode != 0:
        return Err[bool](Fmt" system link exec runtime: native link failed rc={strings.IntToStr(run.exitCode)} log={run.logPath}\n{run.output}")
    if !chengpath.FileExistsNonEmpty(rootDir, plan.systemLinkPlan.outputPath):
        return Err[bool](Fmt" system link exec runtime: native output missing after link: {plan.systemLinkPlan.outputPath}")
    return Ok[bool](true)

@borrows
fn SystemLinkExecRuntimeRunNativeLinkInto(rootDir: str,
                                          plan: sexec.SystemLinkExecPlan,
                                          nativePlan: nplan.NativeLinkPlanStub,
                                          result: var SystemLinkExecRuntimeResult,
                                          err: var str): bool =
    # 域 E 阶段一 HARD_RED 落点:同 RunNativeLink,直写 req.outputPath 已退役。
    if SystemLinkExecRuntimeProductionPathAccessRetired():
        err = "HARD_RED:system_link_exec_runtime_output_write_requires_staging_handle"
        return false
    err = ""
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=native_link_into_enter")
    let startNs = SystemLinkExecRuntimeNowNs()
    let logPath = SystemLinkExecRuntimeNativeLinkLogPath(plan)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=native_link_after_log_path")
    let outputAbs = chengpath.PathAbsolute(rootDir, plan.systemLinkPlan.outputPath)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=native_link_after_output_abs")
    result.nativeLinkerSelf = SystemLinkExecRuntimeNativeLinkerIsSelf(nativePlan.targetTriple, nativePlan.linkerFlavor)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=native_link_after_self_flag")
    if len(outputAbs) > 0 && os.FileExists(outputAbs):
        let _ = os.RemoveFile(outputAbs)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=native_link_before_run_logged")
    let run: hostops.LoggedRun = SystemLinkExecRuntimeRunNativeLinkLogged(rootDir, "system_link_exec_native_link", nativePlan, logPath)
    let runExitCode: int32 = run.exitCode
    let runLogPath: str = run.logPath
    let runOutput: str = run.output
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=native_link_after_run_logged rc={runExitCode}")
    result.nativeLinkLogPath = runLogPath
    result.nativeLinkNs = SystemLinkExecRuntimeNowNs() - startNs
    if runExitCode != 0:
        err = Fmt" system link exec runtime: native link failed rc={strings.IntToStr(runExitCode)} log={runLogPath}\n{runOutput}"
        return false
    if !chengpath.FileExistsNonEmpty(rootDir, plan.systemLinkPlan.outputPath):
        err = Fmt" system link exec runtime: native output missing after link: {plan.systemLinkPlan.outputPath}"
        return false
    return true

@borrows
fn SystemLinkExecRuntimeWriteLineMap(rootDir: str,
                                      plan: sexec.SystemLinkExecPlan,
                                      result: var SystemLinkExecRuntimeResult): Result[bool] =
    # 域 E 阶段一 HARD_RED 落点:生产上下文中 map 写出目标必须是 staging
    # handle(域 F),按路径写已退役。
    if SystemLinkExecRuntimeProductionPathAccessRetired():
        return Err[bool]("HARD_RED:system_link_exec_runtime_output_write_requires_staging_handle")
    let startNs = SystemLinkExecRuntimeNowNs()
    var err: str
    if !plan.loweringPlan.semanticDebugBound:
        return Ok[bool](true)
    if !lower.LoweringPlanPublishedDebugFactsStrictValidateInto(
           plan.loweringPlan, err):
        return Err[bool](err)
    var planEvidence: debugevidence.DebugEmissionPlanEvidence
    if !pobj.PrimaryObjectPlanDebugEmissionEvidenceInto(
           plan.primaryObjectPlan, planEvidence, err):
        return Err[bool](err)
    if result.debugObject.objectPath != result.primaryObjectPath:
        return Err[bool](
            " system link exec runtime: debug object identity missing")
    let objectAbs = chengpath.PathAbsolute(
        rootDir, result.debugObject.objectPath)
    var objectBuffer = bytes.ReadFileBytes(objectAbs)
    defer:
        bytes.FreeByteBuffer(objectBuffer)
    if objectBuffer.data == nil || objectBuffer.len <= 0:
        return Err[bool](" system link exec runtime: debug object read failed")
    var objectBytes = rawbytes.BytesAlloc(objectBuffer.len)
    defer:
        rawbytes.BytesFree(objectBytes)
    if objectBytes.data == nil:
        return Err[bool](
            " system link exec runtime: debug object allocation failed")
    rawmem_support.RawmemCopy(
        objectBytes.data, objectBuffer.data, objectBuffer.len)
    var debugEmissionReceipt: debugreceipt.DebugObjectEmissionReceipt
    if !debugreceipt.DebugObjectEmissionReceiptBuildInto(
           plan.loweringPlan.semanticDebugFacts, planEvidence,
           result.debugObject.objectCid,
           result.debugObject.textSectionFileOffset,
           objectBytes, debugEmissionReceipt, err):
        return Err[bool](err)
    let lineMapRes =
        linemap.WriteExecutableLineMapFromValidatedDebugReceipt(
            rootDir, plan.systemLinkPlan.outputPath,
            debugEmissionReceipt, plan.loweringPlan.semanticDebugFacts,
            planEvidence, result.debugObject.objectCid,
            result.debugObject.textSectionFileOffset, objectBytes)
    result.lineMapNs = SystemLinkExecRuntimeNowNs() - startNs
    if !lineMapRes.ok:
        return Err[bool](strings.CloneStr(lineMapRes.err.msg))
    result.debugEmissionReceipt = debugEmissionReceipt
    result.lineMapPath = lineMapRes.value
    if plan.systemLinkPlan.emitKind == creq.EmitExe &&
       len(result.lineMapPath) > 0 &&
       !chengpath.FileExistsNonEmpty(rootDir, result.lineMapPath):
        return Err[bool](Fmt" system link exec runtime: line-map missing after write: {result.lineMapPath}")
    return Ok[bool](true)

fn SystemLinkExecRuntimeCanUseStandaloneMain(plan: var sexec.SystemLinkExecPlan): bool =
    if plan.systemLinkPlan.emitKind != creq.EmitExe:
        return false
    if plan.systemLinkPlan.targetTriple == "x86_64-pc-windows-msvc":
        return false
    if plan.systemLinkPlan.providerModules.len > 0:
        return false
    if plan.objectPlan.providerModules.len > 0:
        return false
    if plan.objectPlan.providerSourcePaths.len > 0:
        return false
    if plan.objectPlan.providerObjectPaths.len > 0:
        return false
    return direct.DirectObjectEmitCanStandaloneMain(plan.primaryObjectPlan)

fn SystemLinkExecRuntimeCanUseProviderFreePrimaryNativeLink(plan: var sexec.SystemLinkExecPlan,
                                                            standaloneMain: bool,
                                                            objectOnly: bool): bool =
    if standaloneMain || objectOnly:
        return false
    if plan.systemLinkPlan.emitKind != creq.EmitExe:
        return false
    if plan.systemLinkPlan.targetTriple == "x86_64-pc-windows-msvc":
        return false
    if plan.primaryObjectPlan.missingReasons.len > 0:
        return false
    if plan.primaryObjectPlan.relocTargetSymbols.len > 0:
        return false
    if plan.primaryObjectPlan.dataRelocTargetSymbols.len > 0:
        return false
    return direct.DirectObjectEmitCanPlanObject(plan.primaryObjectPlan)

fn SystemLinkExecRuntimeProgressStdErrEnabled(): bool =
    let raw = strutil.Strip(os.GetEnv("CHENG_PROGRESS"))
    if len(raw) <= 0:
        return false
    if raw == "0":
        return false
    if raw == "false":
        return false
    return true

fn SystemLinkExecRuntimeProgressPath(): str =
    return strutil.Strip(os.GetEnv("CHENG_PROGRESS_OUT"))

fn SystemLinkExecRuntimeProgressAppendEnabled(): bool =
    let raw = strutil.Strip(os.GetEnv("CHENG_PROGRESS_APPEND"))
    if len(raw) <= 0:
        return false
    if raw == "0":
        return false
    if raw == "false":
        return false
    return true

@borrows
fn SystemLinkExecRuntimeProgressPrepare(rootDir: str) =
    let progressPath = SystemLinkExecRuntimeProgressPath()
    if len(progressPath) <= 0:
        return
    if SystemLinkExecRuntimeProgressAppendEnabled():
        return
    let _ = chengpath.WriteTextFile(rootDir, progressPath, "")

@borrows
fn SystemLinkExecRuntimeProgressEmit(rootDir: str,
                                      phase: str,
                                      status: str) =
    let stderrEnabled = SystemLinkExecRuntimeProgressStdErrEnabled()
    let progressPath = SystemLinkExecRuntimeProgressPath()
    if !stderrEnabled && len(progressPath) <= 0:
        return
    let line = Fmt"compile_progress phase=runtime_{phase} status={status}"
    if stderrEnabled:
        os.WriteLine(os.Get_stderr(), line)
    if len(progressPath) <= 0:
        return
    let _ = chengpath.AppendTextFile(share(rootDir), progressPath, Fmt"{line}\n")

fn SystemLinkExecRuntimeReleaseExecutionOwners(
        plan: var sexec.SystemLinkExecPlan,
        compilerCsgLifetimeOutcome: int32) =
    sexec.SystemLinkExecPlanRequireCompilerCsgPayloadConsumed(plan)

    var runtimeMetadataReleaseReceipt: sexec.SystemLinkExecRuntimeMetadataReleaseReceipt
    sexec.SystemLinkExecRuntimeMetadataReleaseWithReceipt(
        plan,
        compilerCsgLifetimeOutcome,
        runtimeMetadataReleaseReceipt)
    var runtimeMetadataReleaseErr: str
    if !sexec.SystemLinkExecRuntimeMetadataReleaseReceiptConsumeStrictInto(
           plan,
           runtimeMetadataReleaseReceipt,
           runtimeMetadataReleaseErr):
        panic(runtimeMetadataReleaseErr)
    sexec.SystemLinkExecPlanRecordOwnerReleaseReceipt(
        plan,
        sexec.SystemLinkExecOwnerKindRuntimeMetadata,
        runtimeMetadataReleaseReceipt.ownerToken,
        runtimeMetadataReleaseReceipt.releasedOwnedStorageColumnCount,
        runtimeMetadataReleaseReceipt.releasedBufferCount,
        runtimeMetadataReleaseReceipt.releasedBytes)

    let loweringTerminalReleaseBefore =
        sexec.SystemLinkExecPhaseMemorySnapshotFromPlan(plan)
    var loweringPlanReleaseReceipt: lower.LoweringPlanReleaseReceipt
    lower.LoweringPlanReleaseWithReceipt(
        plan.loweringPlan,
        loweringPlanReleaseReceipt)
    var loweringPlanReleaseErr: str
    if !lower.LoweringPlanReleaseReceiptConsumeStrictInto(
           plan.loweringPlan,
           loweringPlanReleaseReceipt,
           loweringPlanReleaseErr):
        panic(loweringPlanReleaseErr)
    if plan.loweringLifetimeReceiptReady:
        panic("system link exec runtime: duplicate lowering lifetime receipt")
    lowerlife.LoweringPayloadLifecycleEndWithReleaseReceipt(
        plan.loweringPayloadLifecycle,
        loweringPlanReleaseReceipt,
        compilerCsgLifetimeOutcome,
        plan.loweringLifetimeReceipt)
    plan.loweringLifetimeReceiptReady = true
    sexec.SystemLinkExecPlanRecordOwnerReleaseReceipt(
        plan,
        sexec.SystemLinkExecOwnerKindLowering,
        loweringPlanReleaseReceipt.ownerToken,
        loweringPlanReleaseReceipt.releasedOwnedStorageColumnCount,
        loweringPlanReleaseReceipt.releasedBufferCount,
        loweringPlanReleaseReceipt.releasedBytes)
    let loweringTerminalReleaseAfter =
        sexec.SystemLinkExecPhaseMemorySnapshotFromPlan(plan)
    sexec.SystemLinkExecPhaseMemoryRequireStructuredNonIncrease(
        "lowering_terminal_release",
        loweringTerminalReleaseBefore,
        loweringTerminalReleaseAfter)
    plan.phaseMemoryLedger.loweringTerminalRelease =
        sexec.SystemLinkExecPhaseMemoryDeltaFromPlan(
            loweringTerminalReleaseBefore,
            loweringTerminalReleaseAfter,
            plan)

    # Streaming primary functions are released at their per-function boundary.
    # Entry bridges and any retained diagnostic bodies still reach this
    # terminal owner; release their nested buffers physically before clearing
    # the plan header.
    var primaryBodyIrReleaseState: bodylifecycle.BodyIrPayloadReleaseSequenceState
    var primaryBodyIrReleaseReceipt: bodylifecycle.BodyIrPayloadReleaseSequenceReceipt
    bodylifecycle.BodyIrPayloadReleaseSequenceWithReceipt(
        plan.primaryObjectPlan.functionBodyIRs,
        primaryBodyIrReleaseState,
        primaryBodyIrReleaseReceipt)
    var primaryBodyIrReleaseErr: str
    if !bodylifecycle.BodyIrPayloadReleaseSequenceReceiptConsumeStrictInto(
           plan.primaryObjectPlan.functionBodyIRs,
           primaryBodyIrReleaseState,
           primaryBodyIrReleaseReceipt,
           primaryBodyIrReleaseErr):
        panic(primaryBodyIrReleaseErr)
    sexec.SystemLinkExecPlanRecordOwnerReleaseReceipt(
        plan,
        sexec.SystemLinkExecOwnerKindPrimaryBodyIr,
        primaryBodyIrReleaseReceipt.ownerToken,
        1,
        primaryBodyIrReleaseReceipt.releasedBufferCount,
        primaryBodyIrReleaseReceipt.releasedBytes)
    var primaryObjectPlanReleaseReceipt: pobj.PrimaryObjectPlanReleaseReceipt
    pobj.PrimaryObjectPlanReleaseWithReceipt(
        plan.primaryObjectPlan,
        primaryObjectPlanReleaseReceipt)
    var primaryObjectPlanReleaseErr: str
    if !pobj.PrimaryObjectPlanReleaseReceiptConsumeStrictInto(
           plan.primaryObjectPlan,
           primaryObjectPlanReleaseReceipt,
           primaryObjectPlanReleaseErr):
        panic(primaryObjectPlanReleaseErr)
    var primaryPlanOwnerKind =
        sexec.SystemLinkExecOwnerKindPrimaryPlan
    if plan.requestBackendKind == creq.CompilerBackend2:
        plan.backend2PlanReleaseReceipt =
            primaryObjectPlanReleaseReceipt
        primaryPlanOwnerKind =
            sexec.SystemLinkExecOwnerKindBackend2
    sexec.SystemLinkExecPlanRecordOwnerReleaseReceipt(
        plan,
        primaryPlanOwnerKind,
        primaryObjectPlanReleaseReceipt.ownerToken,
        primaryObjectPlanReleaseReceipt.releasedOwnedStorageColumnCount,
        primaryObjectPlanReleaseReceipt.releasedBufferCount,
        primaryObjectPlanReleaseReceipt.releasedBytes)

    var objectPlanReleaseReceipt: objplan.ObjectPlanReleaseReceipt
    objplan.ObjectPlanReleaseWithReceipt(
        plan.objectPlan,
        objectPlanReleaseReceipt)
    var objectPlanReleaseErr: str
    if !objplan.ObjectPlanReleaseReceiptConsumeStrictInto(
           plan.objectPlan,
           objectPlanReleaseReceipt,
           objectPlanReleaseErr):
        panic(objectPlanReleaseErr)
    sexec.SystemLinkExecPlanRecordOwnerReleaseReceipt(
        plan,
        sexec.SystemLinkExecOwnerKindProvider,
        objectPlanReleaseReceipt.ownerToken,
        objectPlanReleaseReceipt.releasedOwnedStorageColumnCount,
        objectPlanReleaseReceipt.releasedBufferCount,
        objectPlanReleaseReceipt.releasedBytes)
    var nativeLinkPlanReleaseReceipt: nplan.NativeLinkPlanReleaseReceipt
    nplan.NativeLinkPlanReleaseWithReceipt(
        plan.nativeLinkPlan,
        nativeLinkPlanReleaseReceipt)
    var nativeLinkPlanReleaseErr: str
    if !nplan.NativeLinkPlanReleaseReceiptConsumeStrictInto(
           plan.nativeLinkPlan,
           nativeLinkPlanReleaseReceipt,
           nativeLinkPlanReleaseErr):
        panic(nativeLinkPlanReleaseErr)
    sexec.SystemLinkExecPlanRecordOwnerReleaseReceipt(
        plan,
        sexec.SystemLinkExecOwnerKindNative,
        nativeLinkPlanReleaseReceipt.ownerToken,
        nativeLinkPlanReleaseReceipt.releasedOwnedStorageColumnCount,
        nativeLinkPlanReleaseReceipt.releasedBufferCount,
        nativeLinkPlanReleaseReceipt.releasedBytes)
    var systemLinkPlanReleaseReceipt: slplan.SystemLinkPlanReleaseReceipt
    slplan.SystemLinkPlanReleaseWithReceipt(
        plan.systemLinkPlan,
        systemLinkPlanReleaseReceipt)
    var systemLinkPlanReleaseErr: str
    if !slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
           plan.systemLinkPlan,
           systemLinkPlanReleaseReceipt,
           systemLinkPlanReleaseErr):
        panic(systemLinkPlanReleaseErr)
    sexec.SystemLinkExecPlanRecordOwnerReleaseReceipt(
        plan,
        sexec.SystemLinkExecOwnerKindSystemLinkPlan,
        systemLinkPlanReleaseReceipt.ownerToken,
        systemLinkPlanReleaseReceipt.releasedOwnedStorageColumnCount,
        systemLinkPlanReleaseReceipt.releasedBufferCount,
        systemLinkPlanReleaseReceipt.releasedBytes)
    plan.allocationOwnerLedger.retainedPayloadEstimateAfterBytes =
        sexec.SystemLinkExecPlanRetainedPayloadDiagnosticEstimateBytes(plan)

@borrows
fn SystemLinkExecRuntimeFinalize(plan: var sexec.SystemLinkExecPlan,
                                 succeeded: bool,
                                 reason: str) =
    var terminalReason = "completed"
    if !succeeded:
        terminalReason = strings.CloneStr(reason)
    if len(terminalReason) <= 0:
        terminalReason = "execution aborted"
    var compilerCsgLifetimeOutcome =
        compilerlife.CompilerPayloadOutcomeDiagnostic
    if succeeded:
        compilerCsgLifetimeOutcome =
            compilerlife.CompilerPayloadOutcomeSuccess
    SystemLinkExecRuntimeReleaseExecutionOwners(
        plan,
        compilerCsgLifetimeOutcome)
    sexec.SystemLinkExecPlanCompleteExecution(plan, succeeded, terminalReason)

@borrows
fn SystemLinkExecRuntimeDiscardPreparedPlan(
        plan: var sexec.SystemLinkExecPlan,
        reason: str) =
    if !plan.compilerCsgProductionLifetime.active ||
       plan.compilerCsgLifetimeReceiptReady:
        panic("system link exec runtime: discard requires active prepared plan")
    if !sexec.SystemLinkExecPlanBeginDiscard(plan):
        panic("system link exec runtime: prepared plan is executing")
    SystemLinkExecRuntimeFinalize(
        plan,
        false,
        reason)

@borrows
fn SystemLinkExecRuntimeFinalizeCompileReceiptInto(
        rootDir: str,
        plan: var sexec.SystemLinkExecPlan,
        outSha256: var layout.FixedBytes32,
        err: var str): bool =
    # 域 E 阶段一 HARD_RED 落点:生产上下文中 receipt 输入必须来自 staging
    # handle 回读/内存 bytes(域 F 发布链),禁止按 req.outputPath 回读;
    # 接通前无 live CLAIMED lease 的生产到达在此拒签。
    if SystemLinkExecRuntimeProductionPathAccessRetired():
        err = "HARD_RED:system_link_exec_runtime_receipt_readback_requires_staging_handle"
        return false
    let outputPath = chengpath.PathAbsolute(rootDir,
                                             plan.systemLinkPlan.outputPath)
    let hostPath = chengpath.PathHostFilePath(outputPath)
    var readRes = os.ReadFileBytesResult(hostPath)
    if !readRes.ok:
        err = Fmt" system link exec runtime: final output read failed: {readRes.err.msg}"
        return false
    var data: rawbytes.Bytes = readRes.value
    if rawbytes.BytesLen(data) <= 0:
        rawbytes.BytesFree(data)
        err = " system link exec runtime: final output is empty"
        return false
    let outputSha256 = hash256.Sha256Fixed(layout.ByteSpanFromBytes(data))
    rawbytes.BytesFree(data)
    if !sexec.SystemLinkExecPlanFinalizeCompileReceiptInto(
            plan,
            outputSha256,
            err):
        return false
    outSha256 = outputSha256
    err = ""
    return true

@borrows
fn SystemLinkExecRuntimeFileSha256Into(
        rootDir: str,
        pathRaw: str,
        outSha256: var layout.FixedBytes32,
        err: var str): bool =
    # 域 E 阶段一 HARD_RED 落点:同 FinalizeCompileReceiptInto,生产上下文
    # 禁止按路径回读 receipt 输入。
    if SystemLinkExecRuntimeProductionPathAccessRetired():
        err = "HARD_RED:system_link_exec_runtime_receipt_readback_requires_staging_handle"
        return false
    let absolutePath = chengpath.PathAbsolute(rootDir, pathRaw)
    let hostPath = chengpath.PathHostFilePath(absolutePath)
    var readRes = os.ReadFileBytesResult(hostPath)
    if !readRes.ok:
        err = Fmt" system link exec runtime: receipt input read failed path={absolutePath}: {readRes.err.msg}"
        return false
    var data: rawbytes.Bytes = readRes.value
    if rawbytes.BytesLen(data) <= 0:
        rawbytes.BytesFree(data)
        err = Fmt" system link exec runtime: receipt input is empty path={absolutePath}"
        return false
    outSha256 =
        hash256.Sha256Fixed(layout.ByteSpanFromBytes(data))
    rawbytes.BytesFree(data)
    err = ""
    return true

@borrows
fn SystemLinkExecRuntimeExecutePlanBodyInto(out: var SystemLinkExecRuntimeResult,
                                             err: var str,
                                             rootDir: str,
                                             plan: var sexec.SystemLinkExecPlan,
                                             requestedProviderCompilerPath: str): bool =
    # 域 E 阶段一 HARD_RED 落点(chokepoint):生产上下文中执行体的一切
    # provider/source/output 路径消费均已退役,held bundle/staging handle
    # 链路(域 A/B/F/G)接通前,无 live CLAIMED lease 的执行到达在此拒签。
    if SystemLinkExecRuntimeProductionPathAccessRetired():
        err = "HARD_RED:system_link_exec_runtime_execute_requires_claimed_lease"
        return false
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_current_into_enter")
    out.rssExecuteBeginBytes = SystemLinkExecRuntimeRssBytes()
    SystemLinkExecRuntimeProgressPrepare(rootDir)
    SystemLinkExecRuntimeProgressEmit(rootDir, "execute", "begin")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_execute_progress_begin")
    var standaloneMain = false
    SystemLinkExecRuntimeProgressEmit(rootDir, "standalone_check", "begin")
    standaloneMain = SystemLinkExecRuntimeCanUseStandaloneMain(plan)
    SystemLinkExecRuntimeProgressEmit(rootDir, "standalone_check", "done")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_standalone_check")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_before_standalone_out")
    out.standaloneDirectEntry = standaloneMain
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_standalone_out")
    let objectOnly = plan.systemLinkPlan.emitKind == creq.EmitObj
    out.objectOnlyEmit = objectOnly
    let providerFreePrimaryNativeLink = SystemLinkExecRuntimeCanUseProviderFreePrimaryNativeLink(plan,
                                                                                                standaloneMain,
                                                                                                objectOnly)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=runtime_after_object_only value={objectOnly}")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_before_provider_source_count")
    let providerSourceCount: int32 = plan.objectPlan.providerSourcePaths.len
    var providerPathsValidated = false
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=runtime_after_provider_source_count value={providerSourceCount}")
    if !objectOnly && !standaloneMain && !providerFreePrimaryNativeLink && providerSourceCount > 0:
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_provider_branch_enter")
        SystemLinkExecRuntimeProgressEmit(rootDir, "validate_before_provider", "begin")
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_provider_after_validate_progress_begin")
        let validRes = SystemLinkExecRuntimeValidateExecutablePlanWithMetrics(rootDir,
                                                                               plan,
                                                                               out.indexMetrics.providerPath,
                                                                               true)
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=runtime_provider_after_validate ok={validRes.ok}")
        if !validRes.ok:
            err = validRes.err.msg
            return false
        providerPathsValidated = true
        SystemLinkExecRuntimeProgressEmit(rootDir, "validate_before_provider", "done")
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_provider_after_validate_progress_done")
        SystemLinkExecRuntimeProgressEmit(rootDir, "provider_compiler", "begin")
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_provider_before_compiler_resolve")
        let compilerRes = SystemLinkExecRuntimeResolveProviderObjectCompiler(
            rootDir,
            plan,
            requestedProviderCompilerPath)
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=runtime_provider_after_compiler_resolve ok={compilerRes.ok}")
        if !compilerRes.ok:
            err = compilerRes.err.msg
            return false
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_provider_before_compiler_path_assign")
        out.providerCompilerPath = compilerRes.value
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_provider_after_compiler_path_assign")
        SystemLinkExecRuntimeProgressEmit(rootDir, "provider_compiler", "done")
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_provider_after_compiler_progress_done")
        SystemLinkExecRuntimeProgressEmit(rootDir, "provider_objects", "begin")
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_provider_before_materialize")
        let providerRes = SystemLinkExecRuntimeMaterializeProviderObjects(rootDir, out.providerCompilerPath, plan, out)
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=runtime_provider_after_materialize ok={providerRes.ok}")
        if !providerRes.ok:
            err = providerRes.err.msg
            return false
        out.rssAfterProviderBytes = SystemLinkExecRuntimeRssBytes()
        SystemLinkExecRuntimeProgressEmit(rootDir, "provider_objects", "done")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_initial_provider_branch")
    SystemLinkExecRuntimeProgressEmit(rootDir, "primary_object", "begin")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_primary_progress_begin")
    var primaryOk = false
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_primary_ok_var")
    var primaryErr = ""
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_primary_err_var")
    var windowsProviderLinkedExe = false
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_windows_provider_linked_var")
    if SystemLinkExecRuntimeCanUseWindowsProviderLinkedCompiler(plan, standaloneMain):
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_windows_provider_linked_branch")
        let windowsLinkedRes = SystemLinkExecRuntimeMaterializeWindowsExeWithProviderCompiler(rootDir,
                                                                                             plan,
                                                                                             out,
                                                                                             requestedProviderCompilerPath)
        primaryOk = windowsLinkedRes.ok
        windowsProviderLinkedExe = windowsLinkedRes.ok
        if !windowsLinkedRes.ok:
            primaryErr = windowsLinkedRes.err.msg
    elif !objectOnly && !standaloneMain && !providerFreePrimaryNativeLink && direct.DirectObjectEmitCanPlanObject(plan.primaryObjectPlan):
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_primary_direct_branch")
        var directObject: direct.DirectObjectEmitResult
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_direct_object_path_var")
        var directPlanErr: str
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_direct_plan_err_var")
        let directOk = csgemit.PrimaryObjectCsgcEmitPlanObjectInto(
            rootDir, plan.primaryObjectPlan, directObject, directPlanErr)
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=runtime_after_direct_path_call ok={directOk}")
        if directOk:
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_direct_before_out_ns")
            out.primaryObjectNs = SystemLinkExecRuntimeNowNs()
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_direct_after_out_ns")
            out.primaryObjectPath = directObject.objectPath
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_direct_after_object_path")
            out.primaryObjectAsmPath = ""
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_direct_after_asm_path")
            out.primaryObjectCompileLogPath = ""
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_direct_after_compile_log_path")
            out.primaryObjectDirect = true
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_direct_after_object_direct")
            out.directObjectBytes = directObject.bytesWritten
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_direct_after_object_bytes")
            out.directObjectSymbolCount = directObject.symbolCount
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_direct_after_symbol_count")
            out.directObjectRelocCount = directObject.relocCount
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_direct_after_reloc_count")
            out.debugObject = directObject
            primaryOk = true
            if cmdline.ParamStr(2) == "--debug-system-link-exec":
                os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_direct_after_primary_ok")
        else:
            primaryErr = directPlanErr
    elif SystemLinkExecRuntimeWindowsPrimaryCompilerPreferred(plan, standaloneMain, objectOnly):
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_windows_primary_compiler_branch")
        let windowsPrimaryRes = SystemLinkExecRuntimeMaterializeWindowsPrimaryWithCompiler(rootDir,
                                                                                          plan,
                                                                                          out,
                                                                                          requestedProviderCompilerPath)
        primaryOk = windowsPrimaryRes.ok
        if !windowsPrimaryRes.ok:
            primaryErr = windowsPrimaryRes.err.msg
    else:
        let primaryRes = SystemLinkExecRuntimeMaterializePrimaryObject(rootDir,
                                                                       plan.primaryObjectPlan,
                                                                       standaloneMain,
                                                                       objectOnly,
                                                                       out)
        primaryOk = primaryRes.ok
        if !primaryRes.ok:
            primaryErr = primaryRes.err.msg
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=runtime_after_primary_branch ok={primaryOk}")
    SystemLinkExecRuntimeProgressEmit(rootDir, "primary_object", "done")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_primary_progress_done")
    if !primaryOk:
        err = primaryErr
        return false
    out.rssAfterPrimaryBytes = SystemLinkExecRuntimeRssBytes()
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_primary_ok_check")
    if !out.primaryObjectDirect && !chengpath.FileExistsNonEmpty(rootDir, out.primaryObjectPath):
        err = Fmt"system-link-exec runtime: primary object output missing after emit: {out.primaryObjectPath}"
        return false
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_primary_exists_check")
    if objectOnly:
        SystemLinkExecRuntimeProgressEmit(rootDir, "execute", "done")
        return true
    if windowsProviderLinkedExe:
        SystemLinkExecRuntimeProgressEmit(rootDir, "native_link", "done")
        SystemLinkExecRuntimeProgressEmit(rootDir, "execute", "done")
        return true
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_object_only_check")
    SystemLinkExecRuntimeProgressEmit(rootDir, "validate_executable", "begin")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_validate_executable_progress_begin")
    let validRes = SystemLinkExecRuntimeValidateExecutablePlanWithMetrics(rootDir,
                                                                           plan,
                                                                           out.indexMetrics.providerPath,
                                                                           !providerPathsValidated)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=runtime_after_validate_executable_call ok={validRes.ok}")
    if !validRes.ok:
        err = validRes.err.msg
        return false
    SystemLinkExecRuntimeProgressEmit(rootDir, "validate_executable", "done")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_validate_executable_progress_done")
    if standaloneMain:
        SystemLinkExecRuntimeProgressEmit(rootDir, "line_map", "begin")
        let standaloneLineMapRes = SystemLinkExecRuntimeWriteLineMap(rootDir, plan, out)
        if !standaloneLineMapRes.ok:
            err = standaloneLineMapRes.err.msg
            return false
        SystemLinkExecRuntimeProgressEmit(rootDir, "line_map", "done")
        SystemLinkExecRuntimeProgressEmit(rootDir, "execute", "done")
        return true
    if !standaloneMain && !providerFreePrimaryNativeLink && providerSourceCount <= 0 && plan.objectPlan.providerObjectPaths.len > 0 &&
       out.providerObjectPaths.len <= 0:
        if cmdline.ParamStr(2) == "--debug-system-link-exec":
            os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_external_provider_branch")
        SystemLinkExecRuntimeProgressEmit(rootDir, "external_provider_objects", "begin")
        let externalProviderRes = SystemLinkExecRuntimeRecordExternalProviderObjects(rootDir, plan, out)
        if !externalProviderRes.ok:
            err = externalProviderRes.err.msg
            return false
        SystemLinkExecRuntimeProgressEmit(rootDir, "external_provider_objects", "done")
    if !standaloneMain && !providerFreePrimaryNativeLink && providerSourceCount > 0 && out.providerObjectPaths.len <= 0:
        SystemLinkExecRuntimeProgressEmit(rootDir, "provider_compiler", "begin")
        let compilerRes = SystemLinkExecRuntimeResolveProviderObjectCompiler(
            rootDir,
            plan,
            requestedProviderCompilerPath)
        if !compilerRes.ok:
            err = compilerRes.err.msg
            return false
        out.providerCompilerPath = compilerRes.value
        SystemLinkExecRuntimeProgressEmit(rootDir, "provider_compiler", "done")
        SystemLinkExecRuntimeProgressEmit(rootDir, "provider_objects", "begin")
        let providerRes = SystemLinkExecRuntimeMaterializeProviderObjects(rootDir,
                                                                          out.providerCompilerPath,
                                                                          plan,
                                                                          out)
        if !providerRes.ok:
            err = providerRes.err.msg
            return false
        SystemLinkExecRuntimeProgressEmit(rootDir, "provider_objects", "done")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_before_native_plan_var")
    var nativePlan: nplan.NativeLinkPlanStub =
        nplan.NativeLinkPlanClone(plan.nativeLinkPlan)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_native_plan_var")
    let targetTriple: str = plan.systemLinkPlan.targetTriple
    let runtimeProviderObjectCount: int32 = out.providerObjectPaths.len
    if targetTriple == "x86_64-pc-windows-msvc" && runtimeProviderObjectCount > 0:
        var winInputs: str[]
        add(winInputs, share(out.primaryObjectPath))
        for rpi in 0..<runtimeProviderObjectCount:
            let providerObjectPath: str = out.providerObjectPaths[rpi]
            add(winInputs, share(providerObjectPath))
        nativePlan.linkInputPaths = winInputs
    elif runtimeProviderObjectCount > 0 &&
         !standaloneMain &&
         !providerFreePrimaryNativeLink:
        let mergeInputsRes = SystemLinkExecRuntimeMergeNativeInputPaths(rootDir,
                                                                        nativePlan.linkInputPaths,
                                                                        out.providerObjectPaths)
        if !mergeInputsRes.ok:
            err = mergeInputsRes.err.msg
            return false
        # Provider objects materialized outside the plan's predicted set
        # (system-helpers backend, darwin syscall shim) join linkInputPaths
        # through the merge above; the native plan's provider partition must
        # carry them in the same append order or the Mach-O request's
        # partition count check rejects the input.
        for extraIndex in nativePlan.providerObjectPaths.len..<out.providerObjectPaths.len:
            add(nativePlan.providerObjectPaths,
                share(out.providerObjectPaths[extraIndex]))
        SystemLinkExecRuntimeExactTextMetricsAccumulate(out.indexMetrics.nativeInput,
                                                         mergeInputsRes.value)
    if standaloneMain || providerFreePrimaryNativeLink:
        nativePlan = SystemLinkExecRuntimeStandaloneNativePlan(plan, out.primaryObjectPath)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_standalone_native_plan")
    SystemLinkExecRuntimeProgressEmit(rootDir, "native_link", "begin")
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), "debug_system_link_exec=runtime_after_native_progress_begin")
    var nativeErr: str
    out.rssBeforeNativeLinkBytes = SystemLinkExecRuntimeRssBytes()
    let nativeOk = SystemLinkExecRuntimeRunNativeLinkInto(rootDir, plan, nativePlan, out, nativeErr)
    if cmdline.ParamStr(2) == "--debug-system-link-exec":
        os.WriteLine(os.Get_stderr(), Fmt"debug_system_link_exec=runtime_after_native_link_call ok={nativeOk}")
    if !nativeOk:
        err = nativeErr
        return false
    out.rssAfterNativeLinkBytes = SystemLinkExecRuntimeRssBytes()
    SystemLinkExecRuntimeProgressEmit(rootDir, "native_link", "done")
    SystemLinkExecRuntimeProgressEmit(rootDir, "line_map", "begin")
    let lineMapRes = SystemLinkExecRuntimeWriteLineMap(rootDir, plan, out)
    if !lineMapRes.ok:
        if out.primaryObjectDirect && plan.systemLinkPlan.targetTriple == "x86_64-pc-windows-msvc":
            out.rssAfterLineMapBytes = SystemLinkExecRuntimeRssBytes()
            SystemLinkExecRuntimeProgressEmit(rootDir, "line_map", "done")
            SystemLinkExecRuntimeProgressEmit(rootDir, "execute", "done")
            return true
        err = lineMapRes.err.msg
        return false
    out.rssAfterLineMapBytes = SystemLinkExecRuntimeRssBytes()
    SystemLinkExecRuntimeProgressEmit(rootDir, "line_map", "done")
    SystemLinkExecRuntimeProgressEmit(rootDir, "execute", "done")
    return true

@borrows
fn SystemLinkExecRuntimeExecutePlanWithCompilerInto(
        out: var SystemLinkExecRuntimeResult,
        err: var str,
        rootDir: str,
        plan: var sexec.SystemLinkExecPlan,
        requestedProviderCompilerPath: str): bool =
    var beginErr: str
    if !sexec.SystemLinkExecPlanBeginExecution(plan, beginErr):
        if sexec.SystemLinkExecPlanBeginDiscard(
                plan):
            SystemLinkExecRuntimeFinalize(
                plan,
                false,
                beginErr)
            out.payloadFinalizeReceipt =
                plan.payloadFinalizeReceipt
            out.compilerCsgLifetimeReceipt =
                plan.compilerCsgLifetimeReceipt
            out.compilerCsgLifetimeReceiptReady =
                plan.compilerCsgLifetimeReceiptReady
            out.loweringLifetimeReceipt =
                plan.loweringLifetimeReceipt
            out.loweringLifetimeReceiptReady =
                plan.loweringLifetimeReceiptReady
        err = beginErr
        return false
    var bodySucceeded = false
    var bodyErr: str
    defer:
        SystemLinkExecRuntimeFinalize(plan, bodySucceeded, bodyErr)
        out.payloadFinalizeReceipt = plan.payloadFinalizeReceipt
        out.compilerCsgLifetimeReceipt =
            plan.compilerCsgLifetimeReceipt
        out.compilerCsgLifetimeReceiptReady =
            plan.compilerCsgLifetimeReceiptReady
        out.loweringLifetimeReceipt =
            plan.loweringLifetimeReceipt
        out.loweringLifetimeReceiptReady =
            plan.loweringLifetimeReceiptReady
        sexec.SystemLinkExecPhaseMemoryReportAppendPhase(
            out.planReport,
            "lowering_terminal_release",
            plan.phaseMemoryLedger.loweringTerminalRelease)
        out.terminalMemoryCounters =
            system.RuntimeMemoryCountersSnapshotQuiescent()
    bodySucceeded = SystemLinkExecRuntimeExecutePlanBodyInto(
        out,
        bodyErr,
        rootDir,
        plan,
        requestedProviderCompilerPath)
    if bodySucceeded:
        var outputSha256: layout.FixedBytes32
        if !SystemLinkExecRuntimeFinalizeCompileReceiptInto(
                rootDir,
                plan,
                outputSha256,
                bodyErr):
            bodySucceeded = false
        else:
            out.outputSha256 = outputSha256
            out.sourceIdentityReceiptCid =
                plan.compileReceipt.sourceIdentityReceiptCid
            out.semanticReceiptCid = plan.compileReceipt.semanticReceiptCid
            out.sourceToCsgBindingSeal = plan.sourceToCsgBindingSeal
            out.worldHeadCid = plan.compileReceipt.worldHeadCid
            out.canonicalOutputDigest =
                plan.compileReceipt.canonicalOutputDigest
            out.compileReceiptCid = plan.compileReceipt.receiptCid
        if bodySucceeded:
            out.planReport = sexec.SystemLinkExecPlanReport(plan)
            # These success atoms are emitted only after the final output
            # bytes have been hashed into the compile receipt.  Keeping them
            # on the successful runtime result avoids turning the plan's
            # unconditional selfhost scope declaration into execution
            # evidence.
            SystemLinkExecRuntimeAppendLine(
                out.planReport, "system_link_exec=1")
            SystemLinkExecRuntimeAppendLine(
                out.planReport, "real_backend_codegen=1")
            SystemLinkExecRuntimeAppendLine(
                out.planReport, "full_backend_codegen=1")
    err = share(bodyErr)
    return bodySucceeded

@borrows
fn SystemLinkExecRuntimeExecutePlanWithCompiler(
        rootDir: str,
        plan: var sexec.SystemLinkExecPlan,
        requestedProviderCompilerPath: str): Result[SystemLinkExecRuntimeResult] =
    var out: SystemLinkExecRuntimeResult
    var err: str
    if SystemLinkExecRuntimeExecutePlanWithCompilerInto(out,
                                                        err,
                                                        rootDir,
                                                        plan,
                                                        requestedProviderCompilerPath):
        return Ok[SystemLinkExecRuntimeResult](out)
    return Err[SystemLinkExecRuntimeResult](strings.CloneStr(err))

@borrows
fn SystemLinkExecRuntimeExecutePlan(rootDir: str,
                                     plan: var sexec.SystemLinkExecPlan): Result[SystemLinkExecRuntimeResult] =
    return SystemLinkExecRuntimeExecutePlanWithCompiler(rootDir, plan, "")

@borrows
fn SystemLinkExecRuntimeAppendIndexMetrics(out: var str,
                                            prefix: str,
                                            metrics: SystemLinkExecRuntimeExactTextIndexMetrics) =
    SystemLinkExecRuntimeAppendKeyValue(out,
                                        Fmt"{prefix}_build_count",
                                        strings.Int64ToStr(metrics.buildCount))
    SystemLinkExecRuntimeAppendKeyValue(out,
                                        Fmt"{prefix}_query_count",
                                        strings.Int64ToStr(metrics.queryCount))
    SystemLinkExecRuntimeAppendKeyValue(out,
                                        Fmt"{prefix}_sort_comparison_count",
                                        strings.Int64ToStr(metrics.sortComparisonCount))
    SystemLinkExecRuntimeAppendKeyValue(out,
                                        Fmt"{prefix}_lookup_comparison_count",
                                        strings.Int64ToStr(metrics.lookupComparisonCount))
    SystemLinkExecRuntimeAppendKeyValue(out,
                                        Fmt"{prefix}_max_lookup_comparisons",
                                        strings.IntToStr(metrics.maxLookupComparisons))
    SystemLinkExecRuntimeAppendKeyValue(out,
                                        Fmt"{prefix}_retained_bytes_estimate",
                                        strings.Int64ToStr(metrics.retainedBytesEstimate))
    SystemLinkExecRuntimeAppendKeyValue(out,
                                        Fmt"{prefix}_live_retained_bytes_estimate",
                                        strings.Int64ToStr(metrics.liveRetainedBytesEstimate))
    SystemLinkExecRuntimeAppendKeyValue(out,
                                        Fmt"{prefix}_peak_retained_bytes_estimate",
                                        strings.Int64ToStr(metrics.peakRetainedBytesEstimate))
    SystemLinkExecRuntimeAppendKeyValue(out,
                                        Fmt"{prefix}_retained_bytes_estimate_scope",
                                        "cheng_str_abi_24_capacity_plus_owned_payload")
    SystemLinkExecRuntimeAppendKeyValue(out,
                                        Fmt"{prefix}_rss_gate_eligible",
                                        strings.IntToStr(metrics.rssGateEligible))
    SystemLinkExecRuntimeAppendKeyValue(out,
                                        Fmt"{prefix}_composite_key_bytes",
                                        strings.Int64ToStr(metrics.compositeKeyBytes))
    SystemLinkExecRuntimeAppendKeyValue(out,
                                        Fmt"{prefix}_instance_count",
                                        strings.IntToStr(metrics.instanceCount))
    SystemLinkExecRuntimeAppendKeyValue(out,
                                        Fmt"{prefix}_release_count",
                                        strings.IntToStr(metrics.releaseCount))
    SystemLinkExecRuntimeAppendKeyValue(out,
                                        Fmt"{prefix}_sealed",
                                        SystemLinkExecRuntimeBoolText(metrics.sealed))
    SystemLinkExecRuntimeAppendKeyValue(out,
                                        Fmt"{prefix}_released",
                                        SystemLinkExecRuntimeBoolText(metrics.released))

@borrows
fn SystemLinkExecRuntimeResultReport(result: SystemLinkExecRuntimeResult): str =
    if !result.compilerCsgLifetimeReceiptReady ||
       !csglife.CompilerCsgProductionLifetimeReceiptClosed(
           result.compilerCsgLifetimeReceipt):
        panic("system link exec runtime: terminal CompilerCSG receipt missing")
    if !result.loweringLifetimeReceiptReady ||
       !compilerlife.CompilerPayloadLifecycleReceiptClosed(
           result.loweringLifetimeReceipt):
        panic("system link exec runtime: terminal lowering receipt missing")
    # let (not var): @borrows result cannot seed a unique var-field root.
    let ownerTableLifetimeReceipt =
        result.payloadFinalizeReceipt.ownerTableLifetimeReceipt
    if !compilerlife.CompilerPayloadLifecycleReceiptClosed(
            ownerTableLifetimeReceipt):
        panic("system link exec runtime: owner table lifetime receipt missing")
    var out = ""
    let gLineState = SystemLinkExecRuntimeGLineState(
        result.providerParallelTaskCount,
        result.providerParallelActiveWorkers,
        result.objectOnlyEmit)
    let primaryObjectCacheEnabledText = SystemLinkExecRuntimeBoolText(!SystemLinkExecRuntimePrimaryObjectCacheDisabled())
    let directObjectBytesText = strings.IntToStr(result.directObjectBytes)
    let directObjectSymbolCountText = strings.IntToStr(result.directObjectSymbolCount)
    let directObjectRelocCountText = strings.IntToStr(result.directObjectRelocCount)
    let providerObjectCountText = strings.IntToStr(result.providerObjectPaths.len)
    let providerObjectPathsText = slplan.SystemLinkPlanListText(result.providerObjectPaths)
    let providerCompileLogsText = slplan.SystemLinkPlanListText(result.providerCompileLogPaths)
    # 域 E 阶段一:provider object cache 已退役(恢复/存储调用点删除),报告
    # 恒报 disabled,不再读取 env 开关制造"仍可用"假象。
    let providerObjectCacheEnabledText = "0"
    let providerObjectCacheHitCountText = strings.IntToStr(result.providerObjectCacheHitCount)
    let providerObjectCacheMissCountText = strings.IntToStr(result.providerObjectCacheMissCount)
    let providerParallelJobCountText = strings.IntToStr(result.providerParallelJobCount)
    let providerParallelTaskCountText = strings.IntToStr(result.providerParallelTaskCount)
    let providerParallelActiveWorkersText = strings.IntToStr(result.providerParallelActiveWorkers)
    let providerParallelCompletedWorkersText = strings.IntToStr(result.providerParallelCompletedWorkers)
    let primaryObjectNsText = SystemLinkExecRuntimePhaseMsText(result.primaryObjectNs)
    let providerObjectsNsText = SystemLinkExecRuntimePhaseMsText(result.providerObjectsNs)
    let nativeLinkNsText = SystemLinkExecRuntimePhaseMsText(result.nativeLinkNs)
    let lineMapNsText = SystemLinkExecRuntimePhaseMsText(result.lineMapNs)
    let rssExecuteBeginText = strings.Int64ToStr(result.rssExecuteBeginBytes)
    let rssAfterProviderText = strings.Int64ToStr(result.rssAfterProviderBytes)
    let rssAfterPrimaryText = strings.Int64ToStr(result.rssAfterPrimaryBytes)
    let rssBeforeNativeLinkText = strings.Int64ToStr(result.rssBeforeNativeLinkBytes)
    let rssAfterNativeLinkText = strings.Int64ToStr(result.rssAfterNativeLinkBytes)
    let rssAfterLineMapText = strings.Int64ToStr(result.rssAfterLineMapBytes)
    SystemLinkExecRuntimeAppendLine(out, "system_link_exec_runtime_execute=1")
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "final_output_sha256",
        layout.FixedBytes32Hex(result.outputSha256))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "final_source_identity_receipt_cid",
        layout.FixedBytes32Hex(result.sourceIdentityReceiptCid))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "final_semantic_receipt_cid",
        layout.FixedBytes32Hex(result.semanticReceiptCid))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "final_source_to_csg_binding_seal",
        layout.FixedBytes32Hex(result.sourceToCsgBindingSeal))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "final_world_head_cid",
        layout.FixedBytes32Hex(result.worldHeadCid))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "final_canonical_output_digest",
        layout.FixedBytes32Hex(result.canonicalOutputDigest))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "final_compile_receipt_cid",
        layout.FixedBytes32Hex(result.compileReceiptCid))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "compiler_csg_lifetime_receipt_ready",
        "1")
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "compiler_csg_lifetime_outcome",
        strings.IntToStr(result.compilerCsgLifetimeReceipt.outcome))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "compiler_csg_lifetime_allocated",
        strings.Int64ToStr(result.compilerCsgLifetimeReceipt.allocated))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "compiler_csg_lifetime_released",
        strings.Int64ToStr(result.compilerCsgLifetimeReceipt.released))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "compiler_csg_lifetime_live",
        strings.Int64ToStr(result.compilerCsgLifetimeReceipt.live))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "compiler_csg_lifetime_allocated_bytes",
        strings.Int64ToStr(
            result.compilerCsgLifetimeReceipt.allocatedBytes))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "compiler_csg_lifetime_released_bytes",
        strings.Int64ToStr(
            result.compilerCsgLifetimeReceipt.releasedBytes))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "compiler_csg_lifetime_live_bytes",
        strings.Int64ToStr(result.compilerCsgLifetimeReceipt.liveBytes))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "compiler_csg_lifetime_physical_buffer_count",
        strings.IntToStr(
            result.compilerCsgLifetimeReceipt.physicalBufferCount))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "compiler_csg_lifetime_physical_free_count",
        strings.Int64ToStr(
            result.compilerCsgLifetimeReceipt.physicalFreeCount))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "compiler_csg_lifetime_storage_released",
        SystemLinkExecRuntimeBoolText(
            result.compilerCsgLifetimeReceipt.storageReleased))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "compiler_csg_lifetime_ledger_storage_released",
        SystemLinkExecRuntimeBoolText(
            result.compilerCsgLifetimeReceipt.ledgerStorageReleased))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "compiler_csg_lifetime_ledger_storage_released_buffer_count",
        strings.IntToStr(
            result.compilerCsgLifetimeReceipt.ledgerStorageReleasedBufferCount))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "compiler_csg_lifetime_ledger_storage_released_bytes",
        strings.Int64ToStr(
            result.compilerCsgLifetimeReceipt.ledgerStorageReleasedBytes))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_outcome",
        strings.IntToStr(ownerTableLifetimeReceipt.outcome))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_allocated",
        strings.Int64ToStr(ownerTableLifetimeReceipt.allocated))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_released",
        strings.Int64ToStr(ownerTableLifetimeReceipt.released))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_live",
        strings.Int64ToStr(ownerTableLifetimeReceipt.live))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_allocated_bytes",
        strings.Int64ToStr(ownerTableLifetimeReceipt.allocatedBytes))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_released_bytes",
        strings.Int64ToStr(ownerTableLifetimeReceipt.releasedBytes))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_live_bytes",
        strings.Int64ToStr(ownerTableLifetimeReceipt.liveBytes))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_borrow_count",
        strings.Int64ToStr(ownerTableLifetimeReceipt.retained))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_borrow_return_count",
        strings.Int64ToStr(ownerTableLifetimeReceipt.borrowReturnCount))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_owner_transfer_count",
        strings.Int64ToStr(ownerTableLifetimeReceipt.ownerTransferCount))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_physical_buffer_count",
        strings.IntToStr(ownerTableLifetimeReceipt.physicalBufferCount))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_physical_free_count",
        strings.Int64ToStr(ownerTableLifetimeReceipt.physicalFreeCount))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_storage_released",
        SystemLinkExecRuntimeBoolText(
            ownerTableLifetimeReceipt.storageReleased))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_ledger_storage_released",
        SystemLinkExecRuntimeBoolText(
            ownerTableLifetimeReceipt.ledgerStorageReleased))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_ledger_storage_released_buffer_count",
        strings.IntToStr(
            ownerTableLifetimeReceipt.ledgerStorageReleasedBufferCount))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "owner_table_lifetime_ledger_storage_released_bytes",
        strings.Int64ToStr(
            ownerTableLifetimeReceipt.ledgerStorageReleasedBytes))
    if result.objectOnlyEmit:
        SystemLinkExecRuntimeAppendKeyValue(
            out, "system_link_exec_emit", "obj")
    else:
        SystemLinkExecRuntimeAppendKeyValue(
            out, "system_link_exec_emit", "exe")
    SystemLinkExecRuntimeAppendBoolKeyValue(
        out,
        "system_link_exec_runtime_standalone_no_runtime",
        result.standaloneDirectEntry)
    SystemLinkExecRuntimeAppendBoolKeyValue(
        out,
        "system_link_exec_runtime_standalone_direct_entry",
        result.standaloneDirectEntry)
    SystemLinkExecRuntimeAppendKeyValue(out, "primary_object_path", result.primaryObjectPath)
    SystemLinkExecRuntimeAppendKeyValue(out, "primary_object_asm_path", result.primaryObjectAsmPath)
    SystemLinkExecRuntimeAppendKeyValue(out, "primary_object_compile_log", result.primaryObjectCompileLogPath)
    SystemLinkExecRuntimeAppendKeyValue(out, "primary_object_cache_status", result.primaryObjectCacheStatus)
    SystemLinkExecRuntimeAppendKeyValue(out, "primary_object_cache_path", result.primaryObjectCachePath)
    SystemLinkExecRuntimeAppendKeyValue(out, "primary_object_cache_enabled", primaryObjectCacheEnabledText)
    SystemLinkExecRuntimeAppendBoolKeyValue(
        out, "primary_object_direct", result.primaryObjectDirect)
    SystemLinkExecRuntimeAppendKeyValue(out, "direct_object_bytes", directObjectBytesText)
    SystemLinkExecRuntimeAppendKeyValue(out, "direct_object_symbol_count", directObjectSymbolCountText)
    SystemLinkExecRuntimeAppendKeyValue(out, "direct_object_reloc_count", directObjectRelocCountText)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_compiler", result.providerCompilerPath)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_object_count", providerObjectCountText)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_object_paths", providerObjectPathsText)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_compile_logs", providerCompileLogsText)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_object_cache_enabled", providerObjectCacheEnabledText)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_object_cache_status", result.providerObjectCacheStatus)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_object_cache_hit_count", providerObjectCacheHitCountText)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_object_cache_miss_count", providerObjectCacheMissCountText)
    if len(result.providerParallelStatus) <= 0:
        SystemLinkExecRuntimeAppendKeyValue(
            out, "provider_parallel_status", "none")
    else:
        SystemLinkExecRuntimeAppendKeyValue(
            out, "provider_parallel_status", result.providerParallelStatus)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_parallel_job_count", providerParallelJobCountText)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_parallel_task_count", providerParallelTaskCountText)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_parallel_active_workers", providerParallelActiveWorkersText)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_parallel_completed_workers", providerParallelCompletedWorkersText)
    if len(result.providerParallelStatus) <= 0:
        SystemLinkExecRuntimeAppendKeyValue(
            out, "provider_schedule", "none")
    else:
        SystemLinkExecRuntimeAppendKeyValue(
            out, "provider_schedule", result.providerParallelStatus)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_requested_job_count", providerParallelJobCountText)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_task_count", providerParallelTaskCountText)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_worker_count", providerParallelActiveWorkersText)
    SystemLinkExecRuntimeAppendKeyValue(out, "provider_completed_worker_count", providerParallelCompletedWorkersText)
    SystemLinkExecRuntimeAppendLine(out, "provider_deterministic_merge=index")
    SystemLinkExecRuntimeAppendLine(out, "provider_parallel_merge_order=index")
    SystemLinkExecRuntimeAppendGLine(out, gLineState)
    if result.standaloneDirectEntry:
        SystemLinkExecRuntimeAppendLine(out, "linkerless_image=1")
        SystemLinkExecRuntimeAppendLine(out, "system_link=0")
        SystemLinkExecRuntimeAppendLine(out, "unresolved_symbol_count=0")
        SystemLinkExecRuntimeAppendLine(out, "first_unresolved_symbol=")
        SystemLinkExecRuntimeAppendLine(out, "provider_link_mode=none")
    elif result.primaryObjectDirect &&
         result.providerObjectPaths.len <= 0 &&
         len(result.nativeLinkLogPath) <= 0:
        SystemLinkExecRuntimeAppendLine(out, "linkerless_image=1")
        SystemLinkExecRuntimeAppendLine(out, "system_link=0")
        SystemLinkExecRuntimeAppendLine(out, "unresolved_symbol_count=0")
        SystemLinkExecRuntimeAppendLine(out, "first_unresolved_symbol=")
        SystemLinkExecRuntimeAppendLine(out, "provider_link_mode=none")
    elif result.nativeLinkerSelf:
        SystemLinkExecRuntimeAppendLine(out, "linkerless_image=1")
        SystemLinkExecRuntimeAppendLine(out, "system_link=0")
        SystemLinkExecRuntimeAppendLine(out, "unresolved_symbol_count=0")
        SystemLinkExecRuntimeAppendLine(out, "first_unresolved_symbol=")
        if result.providerObjectPaths.len > 0 || len(result.nativeLinkLogPath) > 0:
            SystemLinkExecRuntimeAppendLine(out, "provider_link_mode=internal")
        else:
            SystemLinkExecRuntimeAppendLine(out, "provider_link_mode=none")
    elif result.providerObjectPaths.len > 0:
        SystemLinkExecRuntimeAppendLine(out, "linkerless_image=0")
        SystemLinkExecRuntimeAppendLine(out, "system_link=1")
        SystemLinkExecRuntimeAppendLine(out, "provider_link_mode=internal")
    else:
        SystemLinkExecRuntimeAppendLine(out, "linkerless_image=0")
        SystemLinkExecRuntimeAppendLine(out, "system_link=1")
        SystemLinkExecRuntimeAppendLine(out, "provider_link_mode=none")
    SystemLinkExecRuntimeAppendKeyValue(out, "native_link_log", result.nativeLinkLogPath)
    SystemLinkExecRuntimeAppendKeyValue(out, "debug_line_map_path", result.lineMapPath)
    SystemLinkExecRuntimeAppendKeyValue(out, "exec_phase_primary_object_emit_ms", primaryObjectNsText)
    SystemLinkExecRuntimeAppendKeyValue(out, "exec_phase_provider_objects_ms", providerObjectsNsText)
    SystemLinkExecRuntimeAppendKeyValue(out, "exec_phase_native_link_ms", nativeLinkNsText)
    SystemLinkExecRuntimeAppendKeyValue(out, "exec_phase_line_map_ms", lineMapNsText)
    SystemLinkExecRuntimeAppendKeyValue(out, "rss_execute_begin_bytes", rssExecuteBeginText)
    SystemLinkExecRuntimeAppendKeyValue(out, "rss_after_provider_bytes", rssAfterProviderText)
    SystemLinkExecRuntimeAppendKeyValue(out, "rss_after_primary_bytes", rssAfterPrimaryText)
    SystemLinkExecRuntimeAppendKeyValue(out, "rss_before_native_link_bytes", rssBeforeNativeLinkText)
    SystemLinkExecRuntimeAppendKeyValue(out, "rss_after_native_link_bytes", rssAfterNativeLinkText)
    SystemLinkExecRuntimeAppendKeyValue(out, "rss_after_line_map_bytes", rssAfterLineMapText)
    SystemLinkExecRuntimeAppendIndexMetrics(out,
                                             "system_link_exec_provider_path_index",
                                             result.indexMetrics.providerPath)
    SystemLinkExecRuntimeAppendIndexMetrics(out,
                                             "system_link_exec_reloc_definition_index",
                                             result.indexMetrics.relocDefinition)
    SystemLinkExecRuntimeAppendIndexMetrics(out,
                                             "system_link_exec_reloc_root_index",
                                             result.indexMetrics.relocRoot)
    SystemLinkExecRuntimeAppendIndexMetrics(out,
                                             "system_link_exec_native_input_index",
                                             result.indexMetrics.nativeInput)
    var totalIndexMetrics: SystemLinkExecRuntimeExactTextIndexMetrics
    SystemLinkExecRuntimeExactTextMetricsAccumulate(totalIndexMetrics,
                                                     result.indexMetrics.providerPath)
    SystemLinkExecRuntimeExactTextMetricsAccumulate(totalIndexMetrics,
                                                     result.indexMetrics.relocDefinition)
    SystemLinkExecRuntimeExactTextMetricsAccumulate(totalIndexMetrics,
                                                     result.indexMetrics.relocRoot)
    SystemLinkExecRuntimeExactTextMetricsAccumulate(totalIndexMetrics,
                                                     result.indexMetrics.nativeInput)
    SystemLinkExecRuntimeAppendIndexMetrics(out,
                                             "system_link_exec_index_total",
                                             totalIndexMetrics)
    SystemLinkExecRuntimeAppendLine(out, "exec_pipeline_stage=system_link_exec_runtime_execute")
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "cheng_mm_counter_schema",
        "cheng.mm.global.v1")
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "cheng_mm_counter_scope",
        "post_terminal_owner_release_and_plan_report_assembly_pre_runtime_report_assembly")
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "cheng_mm_alloc_total",
        strings.Int64ToStr(result.terminalMemoryCounters.allocTotal))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "cheng_mm_free_total",
        strings.Int64ToStr(result.terminalMemoryCounters.freeTotal))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "cheng_mm_live_total",
        strings.Int64ToStr(result.terminalMemoryCounters.liveTotal))
    SystemLinkExecRuntimeAppendKeyValue(
        out,
        "cheng_mm_counter_invariant",
        "alloc_minus_free_equals_live")
    return out

@borrows
fn SystemLinkExecRuntimeLinuxPassBCurrentReceiptReportInto(
        out: var str,
        err: var str,
        rootDir: str,
        plan: var sexec.SystemLinkExecPlan,
        result: var SystemLinkExecRuntimeResult): bool =
    out = ""
    if !sexec.SystemLinkExecLinuxPassBCurrentReceiptRequest(
            rootDir,
            plan):
        err = "system link exec runtime: Linux pass-B current receipt request mismatch"
        return false
    let providerCount =
        plan.compileReceipt.runtimeProviderSet.len
    if providerCount <= 0 ||
       result.providerParallelTaskCount != providerCount ||
       result.providerObjectPaths.len != providerCount:
        err = "system link exec runtime: final provider execution set mismatch"
        return false
    for providerIndex in 0..<providerCount:
        let providerObjectPath =
            result.providerObjectPaths[providerIndex]
        if len(providerObjectPath) <= 0 ||
           !chengpath.FileExistsNonEmpty(
               rootDir,
               providerObjectPath):
            err = Fmt"system link exec runtime: final provider object missing index={providerIndex}"
            return false
    if !layout.FixedBytes32Equal(
            result.outputSha256,
            plan.compileReceipt.outputDigest) ||
       !layout.FixedBytes32Equal(
            result.sourceIdentityReceiptCid,
            plan.compileReceipt.sourceIdentityReceiptCid) ||
       !layout.FixedBytes32Equal(
            result.semanticReceiptCid,
            plan.compileReceipt.semanticReceiptCid) ||
       !layout.FixedBytes32Equal(
            result.sourceToCsgBindingSeal,
            plan.sourceToCsgBindingSeal) ||
       !layout.FixedBytes32Equal(
            result.worldHeadCid,
            plan.compileReceipt.worldHeadCid) ||
       !layout.FixedBytes32Equal(
            result.canonicalOutputDigest,
            plan.compileReceipt.canonicalOutputDigest) ||
       !layout.FixedBytes32Equal(
            result.compileReceiptCid,
            plan.compileReceipt.receiptCid):
        err = "system link exec runtime: final result/plan receipt mismatch"
        return false
    var backend2VersionManifestSha256: layout.FixedBytes32
    if !SystemLinkExecRuntimeFileSha256Into(
            rootDir,
            "tools/backend2_version_manifest.rec",
            backend2VersionManifestSha256,
            err):
        return false
    var receiptReport: str
    if !sexec.SystemLinkExecLinuxPassBCurrentReceiptReportInto(
            receiptReport,
            err,
            rootDir,
            plan,
            result.outputSha256,
            backend2VersionManifestSha256):
        return false
    let runtimeReport =
        SystemLinkExecRuntimeResultReport(result)
    if len(receiptReport) <= 0 ||
       len(runtimeReport) <= 0:
        err = "system link exec runtime: final receipt report is empty"
        return false
    out = Fmt"{receiptReport}{runtimeReport}"
    err = ""
    return true
