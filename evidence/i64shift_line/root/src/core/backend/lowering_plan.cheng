    loweringPlanRetainedRecordSequence(
        report, plan.canonicalSnapshotFunctionMerkleNodes)
    loweringPlanRetainedRecordSequence(
        report, plan.snapshotCallResultTypedIrNodeIndexes)
    loweringPlanRetainedRecordSequence(
