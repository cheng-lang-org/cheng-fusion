@borrows
fn LoweringPlanRetainedRuntimeItemCount(plan: LoweringPlanStub): int32 =
    return plan.functionNames.len +
           plan.functionSourcePaths.len +
           plan.functionSymbolTexts.len +
           plan.functionSemanticSources.len +
           plan.functionSemanticDeclarationLineIndexes.len +
           plan.functionSemanticParamTypeJoins.len +
           plan.functionSemanticReturnTypes.len +
           plan.functionSemanticSignatureCompletes.len +
           plan.functionTypedIrIndexes.len +
           plan.functionEntryFlags.len +
           plan.functionSignatureLineNumbers.len +
           plan.functionBodyLineNumbers.len

@borrows
fn LoweringPlanRetainedDiagnosticItemCount(plan: LoweringPlanStub): int32 =
    return plan.missingReasons.len +
           plan.functionExportedFlags.len +
           plan.functionExportSymbolNames.len +
           plan.functionExportNameExplicitFlags.len +
           plan.functionExportProducerSourceIndexes.len +
           plan.functionExportProducerDeclarationIndexes.len +
           plan.functionExportProducerNodeIds.len +
           plan.functionExportProducerFactCids.len

@borrows
fn LoweringPlanRetainedPayloadItemCount(plan: LoweringPlanStub): int32 =
    return parser.NormalizedExprLayerExprCount(plan.exprLayer) +
           plan.typedExprFacts.count +
           plan.resolvedCallSnapshot.sourcePathIds.len * 12 +
           plan.typedIr.nodes2_nodeIndexs.len +
           plan.typedIr.statements2_statementIndexs.len +
           plan.typedIr.functions2_functionNameIds.len +
           plan.typedReturnOps.len +
           plan.primaryObjectIr.functions.len +
           plan.primaryObjectIrFunctions.len +
           plan.loweringRules.len +
           plan.compilerCsgExprSliceSidecar.sourceIndex.len * 7 +
           plan.resolvedCallFactSourcePaths.len +
           plan.resolvedCallFactEntryFactIndexes.len +
           LoweringTypedFunctionLookupSidecarRetainedItemCount(plan) +
           LoweringTypedFunctionIdentityIndexRetainedItemCount(plan) +
           LoweringTypedFunctionReferenceIndexRetainedItemCount(plan) +
           LoweringModuleSourceIndexRetainedItemCount(plan) +
           LoweringPlanDeferScopeTransportRetainedItemCount(plan) +
           LoweringPlanOwnershipTransportRetainedItemCount(plan)

@borrows
fn LoweringPlanRetainedApproxBytes(plan: LoweringPlanStub): int64 =
    let runtimeBytes = int64(LoweringPlanRetainedRuntimeItemCount(plan)) * int64(32)
    let diagnosticBytes = int64(LoweringPlanRetainedDiagnosticItemCount(plan)) * int64(24)
    var approximatePayloadCount = LoweringPlanRetainedPayloadItemCount(plan) -
                                  plan.resolvedCallSnapshot.sourcePathIds.len * 12 -
                                  LoweringTypedFunctionLookupSidecarRetainedItemCount(plan) -
                                  LoweringTypedFunctionIdentityIndexRetainedItemCount(plan) -
                                  LoweringTypedFunctionReferenceIndexRetainedItemCount(plan) -
                                  LoweringModuleSourceIndexRetainedItemCount(plan) -
                                  LoweringPlanDeferScopeTransportRetainedItemCount(plan) -
                                  LoweringPlanOwnershipTransportRetainedItemCount(plan)
    if approximatePayloadCount < 0:
        approximatePayloadCount = 0
    let payloadBytes = int64(approximatePayloadCount) * int64(64)
    let resolvedCallBytes = ccsg.CompilerCsgSemanticResolvedCallStructuredLiveBytes(plan.resolvedCallSnapshot)
    let typedBuildIndexBytes =
        texpr.TypedExprIrBuildIndexStructuredLiveBytes(plan.typedIr)
    let typedFunctionIdentityIndexBytes =
        LoweringTypedFunctionIdentityIndexCapacityEstimateBytes(plan)
    let typedFunctionIndexBytes =
        LoweringTypedFunctionLookupSidecarCapacityEstimateBytes(plan)
    let typedFunctionReferenceIndexBytes =
        LoweringTypedFunctionReferenceIndexCapacityEstimateBytes(plan)
    let moduleSourceIndexBytes =
        LoweringModuleSourceIndexCapacityEstimateBytes(plan)
    let deferScopeTransportBytes =
        LoweringPlanDeferScopeTransportCapacityBytes(plan)
    let ownershipTransportBytes =
        LoweringPlanOwnershipTransportCapacityBytes(plan)
    return runtimeBytes + diagnosticBytes + payloadBytes + resolvedCallBytes +
           typedBuildIndexBytes + typedFunctionIndexBytes +
           typedFunctionIdentityIndexBytes +
           typedFunctionReferenceIndexBytes + moduleSourceIndexBytes +
           deferScopeTransportBytes + ownershipTransportBytes

@borrows
fn LoweringPlanStructuredLiveBytes(plan: LoweringPlanStub): int64 =
    return LoweringPlanRetainedApproxBytes(plan)

@borrows
fn LoweringResolvedCallFactSnapshotBound(plan: LoweringPlanStub): bool =
    return plan.resolvedCallSnapshot.internPool != nil

@borrows
fn LoweringResolvedCallFactSnapshotEntryCount(plan: LoweringPlanStub): int32 =
    return plan.resolvedCallSnapshot.sourcePathIds.len

@borrows
fn LoweringCompilerCsgExprSliceSidecarBound(plan: LoweringPlanStub): bool =
    return plan.compilerCsgExprSliceSidecarBound &&
           plan.compilerCsgExprSliceSidecar.sourceIndex.len > 0

@borrows
fn LoweringCompilerCsgExprSliceSidecarComplete(plan: LoweringPlanStub): bool =
    return plan.compilerCsgExprSliceSidecarBound &&
           plan.compilerCsgExprSliceSidecarComplete

@borrows
fn LoweringCompilerCsgExprSliceSidecarCount(plan: LoweringPlanStub): int32 =
    return plan.compilerCsgExprSliceSidecar.sourceIndex.len

@borrows
fn LoweringCompilerCsgExprSliceSidecarFunctionBoundCount(plan: LoweringPlanStub): int32 =
    return plan.compilerCsgExprSliceSidecarFunctionBoundCount

@borrows
fn LoweringCompilerCsgExprSliceSidecarCoveredCount(plan: LoweringPlanStub): int32 =
    return plan.compilerCsgExprSliceSidecarCoveredCount

@borrows
