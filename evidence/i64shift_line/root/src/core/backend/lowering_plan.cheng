    return plan.compilerCsgExprSliceSidecarGapCount

@borrows
fn LoweringCompilerCsgExprSliceSidecarOverlapCount(plan: LoweringPlanStub): int32 =
    return plan.compilerCsgExprSliceSidecarOverlapCount

@borrows
