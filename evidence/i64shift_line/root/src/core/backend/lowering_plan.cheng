const LoweringPlanOwnedStorageColumnCount: int32 = 264

const
    LoweringFunctionSymbolRoleTypedName: int32 = 1
    LoweringFunctionSymbolRoleExplicitExport: int32 = 2
    LoweringFunctionSymbolRoleSourceEntry: int32 = 3

type
    # Architecture-neutral projection of one exact TypedExpr function row to
    # its linker spelling.  The int32 row + immutable CIDs are identity; both
    # strings are owned UTF-8 payload copies and are never used as lookup keys.
    LoweringFunctionSymbolProjection =
        functionRow: int32
        typedFunctionIndex: int32
        originalNameId: langintern.InternId
        explicitExportNameExplicit: int32
        exportProducerSourceIndex: int32
        exportProducerDeclarationIndex: int32
        exportProducerNodeId: int32
        exportProducerFactCid: layout.FixedBytes32
        role: int32
        targetDecorationKind: int32
        payloadUtf8: str
        decoratedUtf8: str
        internPoolDomainCid: layout.FixedBytes32
        loweringIdentityReceiptCid: layout.FixedBytes32

type
    LoweringPlanRetainedStorageReport =
        physicalBufferCount: int32
        retainedBytes: int64

    # Exact capacity-epoch ledger for canonical lowering-owned Seq buffers.
    # Every actual grow retires the prior epoch and creates the new epoch at
    # the call site; terminal free retires the final epoch.
    LoweringSequenceAllocatorLedger =
        allocationEventCount: int64
        releaseEventCount: int64
        liveAllocationCount: int64
        allocatedCapacityBytes: int64
        releasedCapacityBytes: int64
        liveCapacityBytes: int64
        peakLiveCapacityBytes: int64
        closed: bool

    LoweringSequenceAllocatorReceipt =
        allocationEventCount: int64
        releaseEventCount: int64
        allocatedCapacityBytes: int64
        releasedCapacityBytes: int64
        terminalRetainedBufferCount: int32
        terminalRetainedBytes: int64
        terminalReleasedBufferCount: int32
        terminalReleasedBytes: int64
        liveAllocationCount: int64
        liveCapacityBytes: int64
        storageReleased: bool

    LoweringResolvedCallTargetProjectionReceipt =
        begun: bool
        movedToPlan: bool
        expectedItemCount: int32
        categoryId: int32
        builderOwnerId: int32
        planOwnerId: int32
        objectId: int32
        reservedCapacity: int32
        retainedBufferCount: int32
        retainedBytes: int64
        physicalFreeCount: int32
        physicalFreedBytes: int64
        allocated: int64
        released: int64
        live: int64
        allocatedBytes: int64
        releasedBytes: int64
        liveBytes: int64
        ownerTransferCount: int64
        retained: int64
        borrowReturnCount: int64
        ledgerStorageReleasedSequenceCount: int32
        ledgerStorageReleasedBufferCount: int32
        ledgerStorageReleasedBytes: int64
        ledgerStorageReleased: bool
        storageReleased: bool

    LoweringManualConsumeCallBridge =
        tokens: ccsg.CompilerCsgManualConsumeCallTokenTable
        snapshotCallIds: int32[]
        calleeFunctionIds: int32[]
        calleeInterfaceCids: layout.FixedBytes32[]
        canonicalEffectCids: layout.FixedBytes32[]
        bridgeCids: layout.FixedBytes32[]
        snapshotBound: bool

    LoweringExternFfiHandleCallCapabilityBridge =
        semanticCapabilities:
            ccsg.CompilerCsgExternFfiHandleCallCapabilityTable
        semanticContractCids: layout.FixedBytes32[]
        semanticInterfaceCids: layout.FixedBytes32[]
        semanticEffectCids: layout.FixedBytes32[]
        snapshotCallIds: int32[]
        snapshotContractRows: int32[]
        snapshotEffectRows: int32[]
        effectBridgeCids: layout.FixedBytes32[]
        callBridgeCids: layout.FixedBytes32[]
        semanticCargoCid: layout.FixedBytes32
        bridgeCid: layout.FixedBytes32
        snapshotBound: bool

    LoweringResolvedCallTargetProjectionOwner =
        ledger: lifetime.LifetimeLedger
        receipt: LoweringResolvedCallTargetProjectionReceipt
        expectedItemCount: int32
        categoryId: int32
        builderOwnerId: int32
        planOwnerId: int32
        objectId: int32
        reservedCapacity: int32
        begun: bool
        movedToPlan: bool
        builderOwnerClosed: bool
