fn loweringSequenceAllocatorSetLen(
        ledger: var LoweringSequenceAllocatorLedger,
        values: var bool[],
        newLength: int32,
        elementBytes: int32) =
    if ledger.closed || newLength < 0 || elementBytes <= 0:
        panic("lowering sequence allocator: invalid Seq setLen request")
    let beforeCapacity = values.cap
    setLen(values, newLength)
    if values.cap < beforeCapacity ||
       (values.cap > 0 && values.buffer == nil):
        panic("lowering sequence allocator: invalid Seq setLen result")
    if values.cap > beforeCapacity:
        loweringSequenceAllocatorRecordGrowth(
            ledger,
            beforeCapacity,
            values.cap,
            elementBytes)

