fn loweringSequenceAllocatorRelease(
        ledger: var LoweringSequenceAllocatorLedger,
        values: var int32[],
        elementBytes: int32): int64 =
    if ledger.closed || values.cap < 0 || elementBytes <= 0:
        panic("lowering sequence allocator: invalid terminal release")
    let retainedCapacity = values.cap
    var releasedBytes: int64
    if retainedCapacity > 0:
        if values.buffer == nil:
            panic("lowering sequence allocator: live Seq buffer missing")
        releasedBytes =
            int64(retainedCapacity) * int64(elementBytes)
        if ledger.liveAllocationCount <= int64(0) ||
           ledger.liveCapacityBytes < releasedBytes:
            panic("lowering sequence allocator: terminal release underflow")
        ledger.releaseEventCount =
            ledger.releaseEventCount + int64(1)
        ledger.releasedCapacityBytes =
            ledger.releasedCapacityBytes + releasedBytes
        ledger.liveAllocationCount =
            ledger.liveAllocationCount - int64(1)
        ledger.liveCapacityBytes =
            ledger.liveCapacityBytes - releasedBytes
    seqs.freeSeq(values)
    if values.len != 0 || values.cap != 0 || values.buffer != nil:
        panic("lowering sequence allocator: physical Seq release failed")
    return releasedBytes

