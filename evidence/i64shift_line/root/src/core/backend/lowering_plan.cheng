fn LoweringPlanStorageReleased(
        plan: var LoweringPlanStub): bool =
    let retained = LoweringPlanRetainedStorage(plan)
    return retained.physicalBufferCount == 0 &&
           retained.retainedBytes == int64(0) &&
           layout.FixedBytes32Equal(
               plan.semanticSnapshotFactsRootCid,
               layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               plan.semanticSnapshotCargoCid,
               layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               plan.semanticSnapshotLoweringAuthorityCid,
               layout.FixedBytes32()) &&
           LoweringPlanToolchainEncoderProjectionEmpty(plan) &&
           snapshot_bridge.CompilerSnapshotLoweringAuthorityCanonicalEmpty(
               plan.compilerSnapshotLoweringAuthority) &&
           loweringExternFfiHandleCapabilityBridgeStorageReleased(plan) &&
           plan.resolvedCallTargetProjectionOwner.receiptReady &&
           LoweringResolvedCallTargetProjectionReceiptClosed(
               plan.resolvedCallTargetProjectionOwner.receipt) &&
           plan.deferScopeTransportAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.deferScopeTransportAllocatorReceipt) &&
           plan.ownershipTransportAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.ownershipTransportAllocatorReceipt) &&
           plan.typedFunctionReferenceAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.typedFunctionReferenceAllocatorReceipt) &&
           plan.typedFunctionIndexAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.typedFunctionIndexAllocatorReceipt) &&
           plan.typedFunctionIdentityAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.typedFunctionIdentityAllocatorReceipt) &&
           plan.resolvedCallFactAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.resolvedCallFactAllocatorReceipt) &&
           plan.importGraphAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.importGraphAllocatorReceipt) &&
           plan.importEdgeIndexAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.importEdgeIndexAllocatorReceipt) &&
           plan.importOwnerIndexAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.importOwnerIndexAllocatorReceipt) &&
           plan.qualifiedImportResolveCacheAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.qualifiedImportResolveCacheAllocatorReceipt) &&
           plan.unqualifiedImportResolveCacheAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.unqualifiedImportResolveCacheAllocatorReceipt) &&
           plan.moduleSourceIndexAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.moduleSourceIndexAllocatorReceipt) &&
           plan.fnPtrFieldCallAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.fnPtrFieldCallAllocatorReceipt) &&
           plan.typeArenaOwnerProofAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.typeArenaOwnerProofAllocatorReceipt) &&
           plan.functionSemanticIdentityAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.functionSemanticIdentityAllocatorReceipt) &&
           plan.functionRuntimeIdentityAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.functionRuntimeIdentityAllocatorReceipt) &&
           plan.functionEmissionMetadataAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.functionEmissionMetadataAllocatorReceipt) &&
           plan.canonicalSnapshotProjectionAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.canonicalSnapshotProjectionAllocatorReceipt) &&
           plan.semanticDebugProjectionAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.semanticDebugProjectionAllocatorReceipt) &&
           plan.primaryObjectIr.functionShapeAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.primaryObjectIr.functionShapeAllocatorReceipt) &&
           plan.primaryObjectIr.callTargetAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.primaryObjectIr.callTargetAllocatorReceipt) &&
           plan.typedFunctionDenseStoreInputAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.typedFunctionDenseStoreInputAllocatorReceipt) &&
           plan.functionDenseStoreInputAllocatorReceiptReady &&
           LoweringSequenceAllocatorReceiptClosed(
               plan.functionDenseStoreInputAllocatorReceipt) &&
           LoweringPlanCompilerCsgTransferredStorageReleased(plan) &&
           texpr.TypedExprFactTableReleasedEmpty(plan.typedExprFacts) &&
           parser.NormalizedExprLayerStorageReleased(plan.exprLayer)

fn loweringPlanFixed32CopyInto(
        out: var layout.FixedBytes32,
        value: layout.FixedBytes32) =
    for byteIndex in 0..<layout.FixedBytes32Size:
        out.data[byteIndex] = value.data[byteIndex]

fn loweringPlanReleaseOwnedStorage(plan: var LoweringPlanStub) =
    LoweringPlanReleaseDeferScopeTransportAllocators(plan)
    LoweringPlanReleaseOwnershipTransportAllocators(plan)
    LoweringPlanReleasePrimaryObjectIrFunctionShapeAllocators(plan)
    LoweringPlanReleasePrimaryObjectIrCallTargetAllocators(plan)
    LoweringPlanReleaseLineMapUnusedPayload(plan)
    loweringPlanRecordCompilerCsgTransferredRelease(plan)
    plan.workspaceRoot = ""
    plan.packageRoot = ""
    plan.packageId = ""
    plan.entryPath = ""
    plan.entrySymbol = ""
    plan.sourceEntryTypedFunctionIndex = -1
    plan.compilerCsgExprSliceSidecarValidationReason = ""
    plan.primaryObjectIrBuildMode = ""
    plan.pipelineStage = ""
    plan.semanticSnapshotFactsRootCid = layout.FixedBytes32()
    plan.semanticSnapshotCargoCid = layout.FixedBytes32()
    plan.semanticSnapshotLoweringAuthorityCid = layout.FixedBytes32()
    plan.toolchainEncoderBuildProjectionReady = false
    plan.toolchainEncoderBuildProjection =
        execution.CompilerToolchainEncoderAuthorityBuildProjectionReceipt()
    plan.toolchainEncoderCargoObjectReceipt =
        snapshot_bridge.CompilerSnapshotLoweringAuthorityCargoObjectReceipt()
    plan.compilerSnapshotLoweringAuthority =
        snapshot_bridge.CompilerSnapshotLoweringAuthority()
    plan.canonicalSnapshotProjectionAuthorityCid =
        layout.FixedBytes32()
    LoweringPlanReleaseFunctionRuntimeIdentityPayload(plan)
    plan.functionNameInternPoolDomainCid = layout.FixedBytes32()
    plan.functionNameIdentityReceiptCid = layout.FixedBytes32()
    seqs.freeSeqStrRelease(plan.missingReasons)
    plan.pipelineStage = ""

fn LoweringPlanReleaseWithReceipt(
        plan: var LoweringPlanStub,
        receipt: var LoweringPlanReleaseReceipt) =
    if plan.terminalStorageReleased ||
       plan.terminalReleaseReceiptConsumed ||
       !layout.FixedBytes32Equal(
           plan.terminalReleaseOwnerToken,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           plan.terminalReleasedCompilerSnapshotLoweringAuthorityCid,
           layout.FixedBytes32()) ||
       plan.terminalReleasedCompilerSnapshotLoweringAuthorityOwnerId != 0 ||
       plan.terminalReleasedCompilerSnapshotLoweringAuthorityGeneration != 0 ||
       !layout.FixedBytes32Equal(
           plan.terminalReleasedCompilerSnapshotLoweringAuthorityReleaseCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           plan.terminalReleasedCanonicalSnapshotProjectionAuthorityCid,
           layout.FixedBytes32()) ||
       plan.terminalReleasedOwnedStorageColumnCount != 0 ||
       plan.terminalReleasedBufferCount != 0 ||
       plan.terminalReleasedBytes != int64(0):
        panic("lowering plan: duplicate or corrupt terminal release")
    if !plan.lifecycleReleaseTrackingStarted:
        LoweringPlanLifecycleReleaseTrackingBegin(plan)
    let lifecycleBeforeBufferCount =
        LoweringPlanLifecycleTrackedPhysicalBufferCount(plan)
    let lifecycleBeforeBytes =
        LoweringPlanLifecycleTrackedRetainedBytes(plan)
    var ownerResourceBeforeMono = monotimes.GetMonoTime()
    let ownerResourceBeforeTimestampNs = ownerResourceBeforeMono.ns
    let retained = LoweringPlanRetainedStorage(plan)
    let projectionAuthorityCid =
        plan.canonicalSnapshotProjectionAuthorityCid
    let compilerSnapshotAuthorityCid =
        plan.semanticSnapshotLoweringAuthorityCid
    let compilerSnapshotAuthorityOwnerId =
        plan.compilerSnapshotLoweringAuthority.ownerId
    let compilerSnapshotAuthorityGeneration =
        plan.compilerSnapshotLoweringAuthority.generation
    var authorityErr: str
    let authorityEmpty =
        snapshot_bridge.CompilerSnapshotLoweringAuthorityCanonicalEmpty(
            plan.compilerSnapshotLoweringAuthority)
    if authorityEmpty:
        if !layout.FixedBytes32Equal(
               compilerSnapshotAuthorityCid,
               layout.FixedBytes32()) ||
           !layout.FixedBytes32Equal(
               projectionAuthorityCid,
               layout.FixedBytes32()) ||
           LoweringCanonicalSnapshotProjectionAllocatorPhysicalBufferCount(
               plan) != 0 ||
           LoweringCanonicalSnapshotProjectionAllocatorCapacityBytes(plan) !=
               int64(0) ||
           plan.canonicalSnapshotFunctionMerkleLeafBase != 0 ||
           !layout.FixedBytes32Equal(
               plan.canonicalSnapshotFunctionMerkleRootCid,
               layout.FixedBytes32()) ||
           plan.canonicalSnapshotFunctionMerkleSealed ||
           !layout.FixedBytes32Equal(
               plan.canonicalSnapshotProjectionRemainderCid,
               layout.FixedBytes32()):
            panic("lowering plan: empty compiler snapshot authority carried CID")
    elif !LoweringCanonicalSnapshotFunctionMerkleTableStrictValid(plan) ||
         !layout.FixedBytes32Equal(
             LoweringCanonicalSnapshotProjectionRemainderCid(plan),
             plan.canonicalSnapshotProjectionRemainderCid) ||
         !layout.FixedBytes32Equal(
             LoweringCanonicalSnapshotProjectionAuthorityCid(plan),
             projectionAuthorityCid) ||
         !snapshot_bridge.CompilerSnapshotLoweringAuthorityStrictValidateInto(
             plan.compilerSnapshotLoweringAuthority, authorityErr) ||
         !layout.FixedBytes32Equal(
             compilerSnapshotAuthorityCid,
             snapshot_bridge.CompilerSnapshotLoweringAuthorityCid(
                 plan.compilerSnapshotLoweringAuthority)) ||
         !snapshot_bridge.CompilerSnapshotLoweringAuthorityFunctionProjectionMatchesInto(
              plan.compilerSnapshotLoweringAuthority,
              projectionAuthorityCid,
              authorityErr):
        panic("lowering plan: compiler snapshot authority release drift")
    if retained.physicalBufferCount < 0 ||
       retained.retainedBytes < int64(0):
        panic("lowering plan: invalid terminal release preimage")
    LoweringPlanReleaseDeferScopeTransportAllocators(plan)
    LoweringPlanReleaseOwnershipTransportAllocators(plan)
    LoweringPlanReleasePrimaryObjectIrFunctionShapeAllocators(plan)
    LoweringPlanReleasePrimaryObjectIrCallTargetAllocators(plan)
    LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
    LoweringPlanReleaseTypedFunctionLookupSidecarPayload(plan)
    LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
    LoweringPlanReleaseResolvedCallFactIndexPayload(plan)
    LoweringPlanReleaseImportGraphPayload(plan)
    LoweringPlanReleaseImportEdgeIndexPayload(plan)
    LoweringPlanReleaseImportOwnerIndexPayload(plan)
    LoweringPlanReleaseUnqualifiedImportResolveCachePayload(plan)
    LoweringPlanReleaseQualifiedImportResolveCachePayload(plan)
    LoweringPlanReleaseModuleSourceIndexPayload(plan)
    LoweringPlanReleaseFnPtrFieldCallPayload(plan)
    LoweringPlanReleaseTypeArenaOwnerProofPayload(plan)
    LoweringPlanReleaseSemanticIdentityPayload(plan)
    LoweringPlanReleaseFunctionRuntimeIdentityPayload(plan)
    LoweringPlanReleaseFunctionEmissionMetadataPayload(plan)
    LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
    LoweringPlanReleaseSemanticDebugPayload(plan)
    LoweringTypedFunctionDenseStoreInputAllocatorRelease(plan)
    LoweringFunctionDenseStoreInputAllocatorRelease(plan)
    LoweringResolvedCallTargetProjectionRelease(plan)
    let ownerToken =
        loweringPlanReleaseOwnerToken(
            plan,
            retained.physicalBufferCount,
            retained.retainedBytes)
    if layout.FixedBytes32Equal(
           ownerToken, layout.FixedBytes32()):
        panic("lowering plan: invalid terminal release preimage")
    var compilerSnapshotAuthorityReleaseCid: layout.FixedBytes32
    if !authorityEmpty:
        if !snapshot_bridge.CompilerSnapshotLoweringAuthorityReleaseInto(
               plan.compilerSnapshotLoweringAuthority,
               compilerSnapshotAuthorityCid,
               projectionAuthorityCid,
               compilerSnapshotAuthorityReleaseCid,
               authorityErr):
            panic(authorityErr)
    loweringPlanReleaseOwnedStorage(plan)
    loweringPlanFixed32CopyInto(
        plan.terminalReleaseOwnerToken,
        ownerToken)
    loweringPlanFixed32CopyInto(
        plan.terminalReleasedCompilerSnapshotLoweringAuthorityCid,
        compilerSnapshotAuthorityCid)
    plan.terminalReleasedCompilerSnapshotLoweringAuthorityOwnerId =
        compilerSnapshotAuthorityOwnerId
    plan.terminalReleasedCompilerSnapshotLoweringAuthorityGeneration =
        compilerSnapshotAuthorityGeneration
    loweringPlanFixed32CopyInto(
        plan.terminalReleasedCompilerSnapshotLoweringAuthorityReleaseCid,
        compilerSnapshotAuthorityReleaseCid)
    loweringPlanFixed32CopyInto(
        plan.terminalReleasedCanonicalSnapshotProjectionAuthorityCid,
        projectionAuthorityCid)
    plan.terminalReleasedOwnedStorageColumnCount =
        LoweringPlanOwnedStorageColumnCount
    plan.terminalReleasedBufferCount =
        retained.physicalBufferCount
    plan.terminalReleasedBytes = retained.retainedBytes
    LoweringPlanLifecycleReleaseTrackingRecord(
        plan,
        lifecycleBeforeBufferCount,
        lifecycleBeforeBytes,
        LoweringPlanLifecycleTrackedPhysicalBufferCount(plan),
        LoweringPlanLifecycleTrackedRetainedBytes(plan))
    plan.lifecycleReleaseClosed =
        LoweringPlanLifecycleTrackedStorageReleased(plan) &&
        plan.lifecycleReleasedBufferCount ==
            plan.lifecycleInitialBufferCount &&
        plan.lifecycleReleasedBytes ==
            plan.lifecycleInitialBytes
    let storageReleasedNow = LoweringPlanStorageReleased(plan)
    plan.terminalStorageReleased = storageReleasedNow
    var ownerResourceBefore: compilerlife.CompilerPayloadOwnerResourceTracePoint
    compilerlife.CompilerPayloadOwnerResourceTracePointInto(
        ownerResourceBeforeTimestampNs,
        ownerToken,
        retained.retainedBytes,
        retained.retainedBytes,
        retained.physicalBufferCount,
        int64(retained.physicalBufferCount),
        retained.retainedBytes,
        int64(0),
        int64(0),
        int64(retained.physicalBufferCount),
        false,
        false,
        ownerResourceBefore)
    var ownerResourceAfter: compilerlife.CompilerPayloadOwnerResourceTracePoint
    var ownerResourceAfterMono = monotimes.GetMonoTime()
    let ownerResourceAfterTimestampNs = ownerResourceAfterMono.ns
    let ownerResourceAfterStorage =
        LoweringPlanRetainedStorage(plan)
    if ownerResourceAfterTimestampNs <= int64(0):
        panic("lowering plan: after owner/resource timestamp is not monotonic")
    if ownerResourceAfterStorage.physicalBufferCount != 0 ||
       ownerResourceAfterStorage.retainedBytes != int64(0):
        panic("lowering plan: terminal storage still retained")
    if !storageReleasedNow:
        panic("lowering plan: terminal storage predicate false")
    compilerlife.CompilerPayloadOwnerResourceTracePointInto(
        ownerResourceAfterTimestampNs,
        ownerToken,
        int64(0),
        int64(0),
        0,
        int64(retained.physicalBufferCount),
        retained.retainedBytes,
        int64(retained.physicalBufferCount),
        retained.retainedBytes,
        int64(0),
        true,
        true,
        ownerResourceAfter)
    compilerlife.CompilerPayloadOwnerResourceTraceCompleteInto(
        ownerResourceBefore,
        ownerResourceAfter,
        plan.ownerResourceTrace)
    loweringPlanFixed32CopyInto(
        receipt.ownerToken,
        ownerToken)
    loweringPlanFixed32CopyInto(
        receipt.compilerSnapshotLoweringAuthorityCid,
        compilerSnapshotAuthorityCid)
    receipt.compilerSnapshotLoweringAuthorityOwnerId =
        compilerSnapshotAuthorityOwnerId
    receipt.compilerSnapshotLoweringAuthorityGeneration =
        compilerSnapshotAuthorityGeneration
    loweringPlanFixed32CopyInto(
        receipt.compilerSnapshotLoweringAuthorityReleaseCid,
        compilerSnapshotAuthorityReleaseCid)
    loweringPlanFixed32CopyInto(
        receipt.canonicalSnapshotProjectionAuthorityCid,
        projectionAuthorityCid)
    receipt.releasedOwnedStorageColumnCount =
        LoweringPlanOwnedStorageColumnCount
    receipt.releasedBufferCount =
        retained.physicalBufferCount
    receipt.releasedBytes = retained.retainedBytes
    receipt.storageReleased = storageReleasedNow
    receipt.lifecycleInitialBufferCount =
        plan.lifecycleInitialBufferCount
    receipt.lifecycleInitialBytes =
        plan.lifecycleInitialBytes
    receipt.lifecycleReleasedBufferCount =
        plan.lifecycleReleasedBufferCount
    receipt.lifecycleReleasedBytes =
        plan.lifecycleReleasedBytes
    receipt.lifecycleClosed =
        plan.lifecycleReleaseClosed
    if !plan.resolvedCallTargetProjectionOwner.receiptReady ||
       !LoweringResolvedCallTargetProjectionReceiptClosed(
           plan.resolvedCallTargetProjectionOwner.receipt) ||
       !plan.deferScopeTransportAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.deferScopeTransportAllocatorReceipt) ||
       !plan.ownershipTransportAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.ownershipTransportAllocatorReceipt) ||
       !plan.typedFunctionReferenceAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.typedFunctionReferenceAllocatorReceipt) ||
       !plan.typedFunctionIndexAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.typedFunctionIndexAllocatorReceipt) ||
       !plan.typedFunctionIdentityAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.typedFunctionIdentityAllocatorReceipt) ||
       !plan.resolvedCallFactAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.resolvedCallFactAllocatorReceipt) ||
       !plan.importGraphAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.importGraphAllocatorReceipt) ||
       !plan.importEdgeIndexAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.importEdgeIndexAllocatorReceipt) ||
       !plan.importOwnerIndexAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.importOwnerIndexAllocatorReceipt) ||
       !plan.qualifiedImportResolveCacheAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.qualifiedImportResolveCacheAllocatorReceipt) ||
       !plan.unqualifiedImportResolveCacheAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.unqualifiedImportResolveCacheAllocatorReceipt) ||
       !plan.moduleSourceIndexAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.moduleSourceIndexAllocatorReceipt) ||
       !plan.fnPtrFieldCallAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.fnPtrFieldCallAllocatorReceipt) ||
       !plan.typeArenaOwnerProofAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.typeArenaOwnerProofAllocatorReceipt) ||
       !plan.functionSemanticIdentityAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.functionSemanticIdentityAllocatorReceipt) ||
       !plan.functionRuntimeIdentityAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.functionRuntimeIdentityAllocatorReceipt) ||
       !plan.functionEmissionMetadataAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.functionEmissionMetadataAllocatorReceipt) ||
       !plan.canonicalSnapshotProjectionAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.canonicalSnapshotProjectionAllocatorReceipt) ||
       !plan.semanticDebugProjectionAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.semanticDebugProjectionAllocatorReceipt) ||
       !plan.primaryObjectIr.functionShapeAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.primaryObjectIr.functionShapeAllocatorReceipt) ||
       !plan.primaryObjectIr.callTargetAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.primaryObjectIr.callTargetAllocatorReceipt) ||
       !plan.typedFunctionDenseStoreInputAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.typedFunctionDenseStoreInputAllocatorReceipt) ||
       !plan.functionDenseStoreInputAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.functionDenseStoreInputAllocatorReceipt):
        panic("lowering plan: allocator receipt missing")
    receipt.resolvedCallTargetProjection =
        plan.resolvedCallTargetProjectionOwner.receipt
    receipt.deferScopeTransportAllocator =
        plan.deferScopeTransportAllocatorReceipt
    receipt.ownershipTransportAllocator =
        plan.ownershipTransportAllocatorReceipt
    receipt.typedFunctionReferenceAllocator =
        plan.typedFunctionReferenceAllocatorReceipt
    receipt.typedFunctionIndexAllocator =
        plan.typedFunctionIndexAllocatorReceipt
    receipt.typedFunctionIdentityAllocator =
        plan.typedFunctionIdentityAllocatorReceipt
    receipt.resolvedCallFactAllocator =
        plan.resolvedCallFactAllocatorReceipt
    receipt.importGraphAllocator =
        plan.importGraphAllocatorReceipt
    receipt.importEdgeIndexAllocator =
        plan.importEdgeIndexAllocatorReceipt
    receipt.importOwnerIndexAllocator =
        plan.importOwnerIndexAllocatorReceipt
    receipt.qualifiedImportResolveCacheAllocator =
        plan.qualifiedImportResolveCacheAllocatorReceipt
    receipt.unqualifiedImportResolveCacheAllocator =
        plan.unqualifiedImportResolveCacheAllocatorReceipt
    receipt.moduleSourceIndexAllocator =
        plan.moduleSourceIndexAllocatorReceipt
    receipt.fnPtrFieldCallAllocator =
        plan.fnPtrFieldCallAllocatorReceipt
    receipt.typeArenaOwnerProofAllocator =
        plan.typeArenaOwnerProofAllocatorReceipt
    receipt.functionSemanticIdentityAllocator =
        plan.functionSemanticIdentityAllocatorReceipt
    receipt.functionRuntimeIdentityAllocator =
        plan.functionRuntimeIdentityAllocatorReceipt
    receipt.functionEmissionMetadataAllocator =
        plan.functionEmissionMetadataAllocatorReceipt
    receipt.canonicalSnapshotProjectionAllocator =
        plan.canonicalSnapshotProjectionAllocatorReceipt
    receipt.semanticDebugProjectionAllocator =
        plan.semanticDebugProjectionAllocatorReceipt
    receipt.primaryObjectIrFunctionShapeAllocator =
        plan.primaryObjectIr.functionShapeAllocatorReceipt
    receipt.primaryObjectIrCallTargetAllocator =
        plan.primaryObjectIr.callTargetAllocatorReceipt
    receipt.typedFunctionDenseStoreInputAllocator =
        plan.typedFunctionDenseStoreInputAllocatorReceipt
    receipt.functionDenseStoreInputAllocator =
        plan.functionDenseStoreInputAllocatorReceipt
    var storageReleasedFlag: int32
    if receipt.storageReleased:
        storageReleasedFlag = 1
    var lifecycleClosedFlag: int32
    if receipt.lifecycleClosed:
        lifecycleClosedFlag = 1
    var ownerTraceClosedFlag: int32
    if compilerlife.CompilerPayloadOwnerResourceTraceClosed(
           plan.ownerResourceTrace):
        ownerTraceClosedFlag = 1
    if storageReleasedFlag == 0 ||
       lifecycleClosedFlag == 0 ||
       ownerTraceClosedFlag == 0 ||
       LoweringPlanRetainedBufferCount(plan) != 0 ||
       LoweringPlanRetainedBytes(plan) != int64(0):
        panic(Fmt"lowering plan: terminal storage release incomplete storageReleased={storageReleasedFlag} lifecycleClosed={lifecycleClosedFlag} ownerTraceClosed={ownerTraceClosedFlag} releasedBuf={plan.lifecycleReleasedBufferCount} initBuf={plan.lifecycleInitialBufferCount} releasedBytes={plan.lifecycleReleasedBytes} initBytes={plan.lifecycleInitialBytes} retainedBuf={LoweringPlanRetainedBufferCount(plan)} retainedBytes={LoweringPlanRetainedBytes(plan)}")

fn LoweringPlanReleaseReceiptConsumeStrictInto(
        plan: var LoweringPlanStub,
        receipt: var LoweringPlanReleaseReceipt,
        err: var str): bool =
    err = ""
    if !plan.terminalStorageReleased ||
       plan.terminalReleaseReceiptConsumed ||
       !receipt.storageReleased ||
       receipt.releasedOwnedStorageColumnCount !=
           LoweringPlanOwnedStorageColumnCount ||
       receipt.releasedOwnedStorageColumnCount !=
           plan.terminalReleasedOwnedStorageColumnCount ||
       receipt.releasedBufferCount !=
           plan.terminalReleasedBufferCount ||
       receipt.releasedBytes !=
           plan.terminalReleasedBytes ||
       !layout.FixedBytes32Equal(
           receipt.compilerSnapshotLoweringAuthorityCid,
           plan.terminalReleasedCompilerSnapshotLoweringAuthorityCid) ||
       receipt.compilerSnapshotLoweringAuthorityOwnerId !=
           plan.terminalReleasedCompilerSnapshotLoweringAuthorityOwnerId ||
       receipt.compilerSnapshotLoweringAuthorityGeneration !=
           plan.terminalReleasedCompilerSnapshotLoweringAuthorityGeneration ||
       !layout.FixedBytes32Equal(
           receipt.compilerSnapshotLoweringAuthorityReleaseCid,
           plan.terminalReleasedCompilerSnapshotLoweringAuthorityReleaseCid) ||
       !layout.FixedBytes32Equal(
           receipt.canonicalSnapshotProjectionAuthorityCid,
           plan.terminalReleasedCanonicalSnapshotProjectionAuthorityCid) ||
       receipt.lifecycleInitialBufferCount !=
           plan.lifecycleInitialBufferCount ||
       receipt.lifecycleInitialBytes !=
           plan.lifecycleInitialBytes ||
       receipt.lifecycleReleasedBufferCount !=
           plan.lifecycleReleasedBufferCount ||
       receipt.lifecycleReleasedBytes !=
           plan.lifecycleReleasedBytes ||
       !plan.resolvedCallTargetProjectionOwner.receiptReady ||
       plan.resolvedCallTargetProjectionOwner.receiptConsumed ||
       !LoweringResolvedCallTargetProjectionReceiptEqual(
           receipt.resolvedCallTargetProjection,
           plan.resolvedCallTargetProjectionOwner.receipt) ||
       !LoweringResolvedCallTargetProjectionReceiptClosed(
           receipt.resolvedCallTargetProjection) ||
       !plan.deferScopeTransportAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.deferScopeTransportAllocator,
           plan.deferScopeTransportAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.deferScopeTransportAllocator) ||
       !plan.ownershipTransportAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.ownershipTransportAllocator,
           plan.ownershipTransportAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.ownershipTransportAllocator) ||
       !plan.typedFunctionReferenceAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.typedFunctionReferenceAllocator,
           plan.typedFunctionReferenceAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.typedFunctionReferenceAllocator) ||
       !plan.typedFunctionIndexAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.typedFunctionIndexAllocator,
           plan.typedFunctionIndexAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.typedFunctionIndexAllocator) ||
       !plan.typedFunctionIdentityAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.typedFunctionIdentityAllocator,
           plan.typedFunctionIdentityAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.typedFunctionIdentityAllocator) ||
       !plan.resolvedCallFactAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.resolvedCallFactAllocator,
           plan.resolvedCallFactAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.resolvedCallFactAllocator) ||
       !plan.importGraphAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.importGraphAllocator,
           plan.importGraphAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.importGraphAllocator) ||
       !plan.importEdgeIndexAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.importEdgeIndexAllocator,
           plan.importEdgeIndexAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.importEdgeIndexAllocator) ||
       !plan.importOwnerIndexAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.importOwnerIndexAllocator,
           plan.importOwnerIndexAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.importOwnerIndexAllocator) ||
       !plan.qualifiedImportResolveCacheAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.qualifiedImportResolveCacheAllocator,
           plan.qualifiedImportResolveCacheAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.qualifiedImportResolveCacheAllocator) ||
       !plan.unqualifiedImportResolveCacheAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.unqualifiedImportResolveCacheAllocator,
           plan.unqualifiedImportResolveCacheAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.unqualifiedImportResolveCacheAllocator) ||
       !plan.moduleSourceIndexAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.moduleSourceIndexAllocator,
           plan.moduleSourceIndexAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.moduleSourceIndexAllocator) ||
       !plan.fnPtrFieldCallAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.fnPtrFieldCallAllocator,
           plan.fnPtrFieldCallAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.fnPtrFieldCallAllocator) ||
       !plan.typeArenaOwnerProofAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.typeArenaOwnerProofAllocator,
           plan.typeArenaOwnerProofAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.typeArenaOwnerProofAllocator) ||
       !plan.functionSemanticIdentityAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.functionSemanticIdentityAllocator,
           plan.functionSemanticIdentityAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.functionSemanticIdentityAllocator) ||
       !plan.functionRuntimeIdentityAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.functionRuntimeIdentityAllocator,
           plan.functionRuntimeIdentityAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.functionRuntimeIdentityAllocator) ||
       !plan.functionEmissionMetadataAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.functionEmissionMetadataAllocator,
           plan.functionEmissionMetadataAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.functionEmissionMetadataAllocator) ||
       !plan.canonicalSnapshotProjectionAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.canonicalSnapshotProjectionAllocator,
           plan.canonicalSnapshotProjectionAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.canonicalSnapshotProjectionAllocator) ||
       !plan.semanticDebugProjectionAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.semanticDebugProjectionAllocator,
           plan.semanticDebugProjectionAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.semanticDebugProjectionAllocator) ||
       !plan.primaryObjectIr.functionShapeAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.primaryObjectIrFunctionShapeAllocator,
           plan.primaryObjectIr.functionShapeAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.primaryObjectIrFunctionShapeAllocator) ||
       !plan.primaryObjectIr.callTargetAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.primaryObjectIrCallTargetAllocator,
           plan.primaryObjectIr.callTargetAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.primaryObjectIrCallTargetAllocator) ||
       plan.typedFunctionDenseStoreInputAllocatorReceiptConsumed ||
       !loweringTypedFunctionDenseStoreInputAllocatorReceiptMatches(
           plan,
           receipt.typedFunctionDenseStoreInputAllocator) ||
       !plan.functionDenseStoreInputAllocatorReceiptReady ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt.functionDenseStoreInputAllocator,
           plan.functionDenseStoreInputAllocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(
           receipt.functionDenseStoreInputAllocator) ||
       !receipt.lifecycleClosed ||
       !plan.lifecycleReleaseClosed ||
       !compilerlife.CompilerPayloadOwnerResourceTraceClosed(
           plan.ownerResourceTrace) ||
       !layout.FixedBytes32Equal(
           receipt.ownerToken,
           plan.terminalReleaseOwnerToken) ||
       !LoweringPlanStorageReleased(plan) ||
       LoweringPlanRetainedBufferCount(plan) != 0 ||
       LoweringPlanRetainedBytes(plan) != int64(0):
        err = "lowering plan: terminal release receipt mismatch"
        return false
    plan.resolvedCallTargetProjectionOwner.receiptConsumed = true
    plan.typedFunctionDenseStoreInputAllocatorReceiptConsumed = true
    plan.terminalReleaseReceiptConsumed = true
    return true

fn LoweringPlanReleaseAllPayload(plan: var LoweringPlanStub) =
    if plan.terminalStorageReleased &&
       plan.terminalReleaseReceiptConsumed:
        return
    var receipt: LoweringPlanReleaseReceipt
    LoweringPlanReleaseWithReceipt(plan, receipt)
    var err: str
    if !LoweringPlanReleaseReceiptConsumeStrictInto(
           plan, receipt, err):
        panic(err)

fn LoweringParallelReleasePayload() =
    if LoweringFunctionTaskParticipantStoragePhysicalBufferCount(
           loweringParallelParticipantStorage) != 0 ||
       LoweringFunctionTaskResultIdentityPhysicalBufferCount(
           loweringParallelResultIdentity) != 0:
        panic("lowering parallel participant authority not consumed")
    loweringParallelPlan = LoweringPlanStub()
    loweringParallelSourceTexts = []
    loweringParallelBuildFlags = []
    loweringParallelResults = []
    loweringParallelResultReadyFlags = []
    loweringParallelTaskFunctionIndices = []

@borrows
fn LoweringTypedFunctionLookupSidecarRetainedItemCount(
        plan: LoweringPlanStub): int32 =
    return plan.typedFunctionIndexSourcePaths.cap +
           plan.typedFunctionIndexSourceBucketHeads.cap +
           plan.typedFunctionIndexSourceEntryNext.cap +
           plan.typedFunctionIndexAbsoluteSuffixBucketHeads.cap +
           plan.typedFunctionIndexAbsoluteSuffixEntryNext.cap +
           plan.typedFunctionIndexAbsoluteSuffixEntryNames.cap +
           plan.typedFunctionIndexAbsoluteSuffixEntrySourceIndexes.cap +
           plan.typedFunctionIndexBucketHeads.cap +
           plan.typedFunctionIndexEntryNext.cap +
           plan.typedFunctionIndexEntrySourceIndexes.cap +
           plan.typedFunctionIndexEntryNames.cap +
           plan.typedFunctionIndexEntryIndexes.cap

@borrows
fn LoweringTypedFunctionLookupSidecarCapacityEstimateBytes(
        plan: LoweringPlanStub): int64 =
    var total = Int64(plan.typedFunctionIndexSourcePaths.cap) * Int64(16) +
                Int64(plan.typedFunctionIndexEntryNames.cap) * Int64(16) +
                Int64(plan.typedFunctionIndexAbsoluteSuffixEntryNames.cap) * Int64(16)
    for sourceIndex in 0..<plan.typedFunctionIndexSourcePaths.len:
        total = total + Int64(len(plan.typedFunctionIndexSourcePaths[sourceIndex]))
    for entryIndex in 0..<plan.typedFunctionIndexEntryNames.len:
        total = total + Int64(len(plan.typedFunctionIndexEntryNames[entryIndex]))
    for entryIndex in 0..<plan.typedFunctionIndexAbsoluteSuffixEntryNames.len:
        total = total +
                Int64(len(plan.typedFunctionIndexAbsoluteSuffixEntryNames[entryIndex]))
    total = total +
            Int64(plan.typedFunctionIndexSourceBucketHeads.cap) * Int64(4) +
            Int64(plan.typedFunctionIndexSourceEntryNext.cap) * Int64(4) +
            Int64(plan.typedFunctionIndexAbsoluteSuffixBucketHeads.cap) * Int64(4) +
            Int64(plan.typedFunctionIndexAbsoluteSuffixEntryNext.cap) * Int64(4) +
            Int64(plan.typedFunctionIndexAbsoluteSuffixEntrySourceIndexes.cap) * Int64(4) +
            Int64(plan.typedFunctionIndexBucketHeads.cap) * Int64(4) +
            Int64(plan.typedFunctionIndexEntryNext.cap) * Int64(4) +
            Int64(plan.typedFunctionIndexEntrySourceIndexes.cap) * Int64(4) +
            Int64(plan.typedFunctionIndexEntryIndexes.cap) * Int64(4)
    return total

