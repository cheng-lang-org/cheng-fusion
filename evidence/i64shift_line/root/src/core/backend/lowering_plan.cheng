        panic("lowering qualified import resolve cache allocator: begin before release")
    plan.qualifiedImportResolveCacheAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.qualifiedImportResolveCacheAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.qualifiedImportResolveCacheAllocatorReceiptReady = false

fn LoweringQualifiedImportResolveCacheAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.qualifiedImportResolveCacheAllocatorReceiptReady:
        if LoweringQualifiedImportResolveCacheAllocatorPhysicalBufferCount(
               plan) != 0 ||
           LoweringQualifiedImportResolveCacheAllocatorCapacityBytes(plan) !=
               int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.qualifiedImportResolveCacheAllocatorReceipt):
            panic("lowering qualified import resolve cache allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringQualifiedImportResolveCacheAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringQualifiedImportResolveCacheAllocatorCapacityBytes(plan)
    if plan.qualifiedImportResolveCacheAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.qualifiedImportResolveCacheAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering qualified import resolve cache allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringQualifiedImportResolveCacheAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.qualifiedImportResolveCacheAllocatorLedger,
            plan.qualifiedImportResolveCacheSourcePaths,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringQualifiedImportResolveCacheAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.qualifiedImportResolveCacheAllocatorLedger,
            plan.qualifiedImportResolveCacheQualifiers,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringQualifiedImportResolveCacheAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.qualifiedImportResolveCacheAllocatorLedger,
            plan.qualifiedImportResolveCacheTargetSourcePaths,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringQualifiedImportResolveCacheAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.qualifiedImportResolveCacheAllocatorLedger,
            plan.qualifiedImportResolveCacheBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringQualifiedImportResolveCacheAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.qualifiedImportResolveCacheAllocatorLedger,
            plan.qualifiedImportResolveCacheEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    plan.qualifiedImportResolveCacheAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.qualifiedImportResolveCacheAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.qualifiedImportResolveCacheAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.qualifiedImportResolveCacheAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.qualifiedImportResolveCacheAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.qualifiedImportResolveCacheAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.qualifiedImportResolveCacheAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringQualifiedImportResolveCacheAllocatorPhysicalBufferCount(plan) ==
            0 &&
        LoweringQualifiedImportResolveCacheAllocatorCapacityBytes(plan) ==
            int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering qualified import resolve cache allocator: receipt incomplete")
    plan.qualifiedImportResolveCacheAllocatorReceipt = receipt
    plan.qualifiedImportResolveCacheAllocatorReceiptReady = true
    plan.qualifiedImportResolveCacheAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringPlanReleaseQualifiedImportResolveCachePayload(
        plan: var LoweringPlanStub) =
    LoweringQualifiedImportResolveCacheAllocatorRelease(plan)

@borrows
fn loweringPlanQualifiedImportTargetSourcePathFrozen(
        plan: LoweringPlanStub,
        currentSourcePathRaw: str,
        qualifierRaw: str): str =
    let currentSourcePath = parser.ParserNormalizePath(currentSourcePathRaw)
    let qualifier = chengpath.PathTrim(qualifierRaw)
    if currentSourcePath == "" || qualifier == "":
        return ""
    if plan.importEdgeIndexBucketHeads.len <= 0:
        panic("lowering qualified import: frozen edge index missing")
    var ownerModulePath =
        LoweringPlanOwnerModulePathForSource(plan, currentSourcePath)
    var foundSourcePath = ""
    let qualifierParts = parser.ParserSplitChar(qualifier, '.')
    for partIndex in 0..<qualifierParts.len:
        let part = parser.ParserIdentPrefix(
            chengpath.PathTrim(qualifierParts[partIndex]))
        if part == "" || ownerModulePath == "":
            foundSourcePath = ""
            break
        var partSourcePath = ""
        var partModulePath = ""
        let foundPart =
            loweringPlanImportEdgeTargetForOwnerQualifierFrozen(
                plan,
                ownerModulePath,
                part,
                partSourcePath,
                partModulePath)
        if !foundPart:
            partSourcePath = ""
            partModulePath = ""
        if partSourcePath == "":
            foundSourcePath = ""
            break
        foundSourcePath = strings.CloneStr(partSourcePath)
        if partModulePath == "":
            partModulePath = LoweringPlanOwnerModulePathForSource(
                plan, share(foundSourcePath))
        ownerModulePath = partModulePath
    return foundSourcePath

@borrows
fn LoweringPlanQualifiedImportTargetSourcePath(plan: var LoweringPlanStub,
                                                currentSourcePathRaw: str,
                                                qualifierRaw: str): str =
    let currentSourcePath = parser.ParserNormalizePath(currentSourcePathRaw)
    let qualifier = chengpath.PathTrim(qualifierRaw)
    if currentSourcePath == "" || qualifier == "":
        return ""
    if plan.importEdgeIndexBucketHeads.len <= 0:
        LoweringBuildImportEdgeIndex(plan)
    if plan.qualifiedImportResolveCacheBucketHeads.len <= 0:
        for initBucket in 0..<4096:
            LoweringQualifiedImportResolveCacheAppendBucket(plan, -1)
    let cacheBucket = (parser.ParserTextLookupContentHash(currentSourcePath) ^
                       parser.ParserTextLookupContentHash(qualifier)) &
                      (plan.qualifiedImportResolveCacheBucketHeads.len - 1)
    var cacheIndex = plan.qualifiedImportResolveCacheBucketHeads[cacheBucket]
    while cacheIndex >= 0:
        if cacheIndex >= plan.qualifiedImportResolveCacheQualifiers.len ||
           cacheIndex >= plan.qualifiedImportResolveCacheTargetSourcePaths.len ||
           cacheIndex >= plan.qualifiedImportResolveCacheSourcePaths.len:
            break
        if plan.qualifiedImportResolveCacheSourcePaths[cacheIndex] == currentSourcePath &&
           plan.qualifiedImportResolveCacheQualifiers[cacheIndex] == qualifier:
            return plan.qualifiedImportResolveCacheTargetSourcePaths[cacheIndex]
        if cacheIndex >= plan.qualifiedImportResolveCacheEntryNext.len:
            break
        cacheIndex = plan.qualifiedImportResolveCacheEntryNext[cacheIndex]
    let foundSourcePath = loweringPlanQualifiedImportTargetSourcePathFrozen(
        plan, currentSourcePath, qualifier)
    let entryIndex = plan.qualifiedImportResolveCacheSourcePaths.len
    LoweringQualifiedImportResolveCacheAppendRow(
        plan,
        currentSourcePath,
        qualifier,
        foundSourcePath,
        plan.qualifiedImportResolveCacheBucketHeads[cacheBucket])
    plan.qualifiedImportResolveCacheBucketHeads[cacheBucket] = entryIndex
    return foundSourcePath

@borrows
fn LoweringUnqualifiedImportResolveCacheAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.unqualifiedImportResolveCacheSourcePaths.cap > 0:
        count = count + 1
    if plan.unqualifiedImportResolveCacheFunctionNames.cap > 0:
        count = count + 1
    if plan.unqualifiedImportResolveCacheTargetSourcePaths.cap > 0:
        count = count + 1
    if plan.unqualifiedImportResolveCacheBucketHeads.cap > 0:
        count = count + 1
    if plan.unqualifiedImportResolveCacheEntryNext.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringUnqualifiedImportResolveCacheAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(plan.unqualifiedImportResolveCacheSourcePaths.cap) *
            int64(sizeof(str)) +
        int64(plan.unqualifiedImportResolveCacheFunctionNames.cap) *
            int64(sizeof(str)) +
        int64(plan.unqualifiedImportResolveCacheTargetSourcePaths.cap) *
            int64(sizeof(str)) +
        int64(plan.unqualifiedImportResolveCacheBucketHeads.cap) *
            int64(sizeof(int32)) +
        int64(plan.unqualifiedImportResolveCacheEntryNext.cap) *
            int64(sizeof(int32))

fn LoweringUnqualifiedImportResolveCacheAppendBucket(
        plan: var LoweringPlanStub,
        bucketHead: int32) =
    loweringSequenceAllocatorAdd(
        plan.unqualifiedImportResolveCacheAllocatorLedger,
        plan.unqualifiedImportResolveCacheBucketHeads,
        bucketHead,
        sizeof(int32))

@borrows
fn LoweringUnqualifiedImportResolveCacheAppendRow(
        plan: var LoweringPlanStub,
        sourcePath: str,
        functionName: str,
        targetSourcePath: str,
        entryNext: int32) =
    let rowCount = plan.unqualifiedImportResolveCacheSourcePaths.len
    if plan.unqualifiedImportResolveCacheFunctionNames.len != rowCount ||
       plan.unqualifiedImportResolveCacheTargetSourcePaths.len != rowCount ||
       plan.unqualifiedImportResolveCacheEntryNext.len != rowCount:
        panic("lowering unqualified import resolve cache allocator: row shape drift")
    loweringSequenceAllocatorAdd(
        plan.unqualifiedImportResolveCacheAllocatorLedger,
        plan.unqualifiedImportResolveCacheSourcePaths,
        sourcePath,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.unqualifiedImportResolveCacheAllocatorLedger,
        plan.unqualifiedImportResolveCacheFunctionNames,
        functionName,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.unqualifiedImportResolveCacheAllocatorLedger,
        plan.unqualifiedImportResolveCacheTargetSourcePaths,
        targetSourcePath,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.unqualifiedImportResolveCacheAllocatorLedger,
        plan.unqualifiedImportResolveCacheEntryNext,
        entryNext,
        sizeof(int32))

fn loweringUnqualifiedImportResolveCacheAccumulateTerminalRelease(
        releasedBytes: int64,
        releasedBufferCount: var int32,
        totalReleasedBytes: var int64) =
    if releasedBytes > int64(0):
        releasedBufferCount = releasedBufferCount + 1
        totalReleasedBytes = totalReleasedBytes + releasedBytes

fn LoweringUnqualifiedImportResolveCacheAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.unqualifiedImportResolveCacheAllocatorReceiptReady ||
       LoweringUnqualifiedImportResolveCacheAllocatorPhysicalBufferCount(plan) !=
           0 ||
       LoweringUnqualifiedImportResolveCacheAllocatorCapacityBytes(plan) !=
           int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.unqualifiedImportResolveCacheAllocatorReceipt):
        panic("lowering unqualified import resolve cache allocator: begin before release")
    plan.unqualifiedImportResolveCacheAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.unqualifiedImportResolveCacheAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.unqualifiedImportResolveCacheAllocatorReceiptReady = false

fn LoweringUnqualifiedImportResolveCacheAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.unqualifiedImportResolveCacheAllocatorReceiptReady:
        if LoweringUnqualifiedImportResolveCacheAllocatorPhysicalBufferCount(
               plan) != 0 ||
           LoweringUnqualifiedImportResolveCacheAllocatorCapacityBytes(plan) !=
               int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.unqualifiedImportResolveCacheAllocatorReceipt):
            panic("lowering unqualified import resolve cache allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringUnqualifiedImportResolveCacheAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringUnqualifiedImportResolveCacheAllocatorCapacityBytes(plan)
    if plan.unqualifiedImportResolveCacheAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.unqualifiedImportResolveCacheAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering unqualified import resolve cache allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringUnqualifiedImportResolveCacheAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.unqualifiedImportResolveCacheAllocatorLedger,
            plan.unqualifiedImportResolveCacheSourcePaths,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringUnqualifiedImportResolveCacheAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.unqualifiedImportResolveCacheAllocatorLedger,
            plan.unqualifiedImportResolveCacheFunctionNames,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringUnqualifiedImportResolveCacheAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.unqualifiedImportResolveCacheAllocatorLedger,
            plan.unqualifiedImportResolveCacheTargetSourcePaths,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringUnqualifiedImportResolveCacheAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.unqualifiedImportResolveCacheAllocatorLedger,
            plan.unqualifiedImportResolveCacheBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringUnqualifiedImportResolveCacheAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.unqualifiedImportResolveCacheAllocatorLedger,
            plan.unqualifiedImportResolveCacheEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    plan.unqualifiedImportResolveCacheAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.unqualifiedImportResolveCacheAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.unqualifiedImportResolveCacheAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.unqualifiedImportResolveCacheAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.unqualifiedImportResolveCacheAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.unqualifiedImportResolveCacheAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.unqualifiedImportResolveCacheAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringUnqualifiedImportResolveCacheAllocatorPhysicalBufferCount(plan) ==
            0 &&
        LoweringUnqualifiedImportResolveCacheAllocatorCapacityBytes(plan) ==
            int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering unqualified import resolve cache allocator: receipt incomplete")
    plan.unqualifiedImportResolveCacheAllocatorReceipt = receipt
    plan.unqualifiedImportResolveCacheAllocatorReceiptReady = true
    plan.unqualifiedImportResolveCacheAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringPlanReleaseUnqualifiedImportResolveCachePayload(
        plan: var LoweringPlanStub) =
    LoweringUnqualifiedImportResolveCacheAllocatorRelease(plan)

@borrows
fn loweringPlanTypedIrFunctionIndexByNameFrozen(
        plan: LoweringPlanStub,
        sourcePath: str,
        functionName: str): int32 =
    if len(functionName) <= 0:
        return -1
    let denseIndex = dense.DenseStoreFindFunctionInSourceReadonly(
        plan.typedFunctionDenseStore,
        LoweringDenseStoreSourceKey(sourcePath),
        functionName)
    if denseIndex >= 0 &&
       denseIndex < plan.typedIr.functions2_functionNameIds.len:
        return denseIndex
    return -1

@borrows
fn loweringPlanUnqualifiedImportTargetSourcePathFrozen(
        plan: LoweringPlanStub,
        currentSourcePathRaw: str,
        functionNameRaw: str): str =
    let currentSourcePath = parser.ParserNormalizePath(currentSourcePathRaw)
    let functionName = chengpath.PathTrim(functionNameRaw)
    if currentSourcePath == "" || functionName == "":
        return ""
    if plan.importOwnerIndexBucketHeads.len <= 0:
        panic("lowering unqualified import: frozen owner index missing")
    let ownerModulePath =
        LoweringPlanOwnerModulePathForSource(plan, currentSourcePath)
    if ownerModulePath == "":
        return ""
    var foundSourcePath = ""
    let ownerBucket = LoweringImportOwnerIndexBucket(
        ownerModulePath, plan.importOwnerIndexBucketHeads.len)
    if ownerBucket >= 0:
        var ownerEntryIndex = plan.importOwnerIndexBucketHeads[ownerBucket]
        while ownerEntryIndex >= 0:
            if ownerEntryIndex >=
                   plan.importOwnerIndexOwnerModulePaths.len ||
               ownerEntryIndex >=
                   plan.importOwnerIndexEntryEdgeIndexes.len:
                break
            if plan.importOwnerIndexOwnerModulePaths[ownerEntryIndex] ==
                   ownerModulePath:
                let edgeIndex =
                    plan.importOwnerIndexEntryEdgeIndexes[ownerEntryIndex]
                if edgeIndex >= 0 && edgeIndex < plan.importEdges.len:
                    let edge = plan.importEdges[edgeIndex]
                    if edge.resolved && edge.allowsUnqualifiedCall:
                        let targetSourcePath = parser.ParserNormalizePath(
                            edge.targetSourcePath)
                        if targetSourcePath != "" &&
                           loweringPlanTypedIrFunctionIndexByNameFrozen(
                               plan,
                               targetSourcePath,
                               functionName) >= 0:
                            if foundSourcePath != "" &&
                               foundSourcePath != targetSourcePath:
                                return ""
                            foundSourcePath = targetSourcePath
            if ownerEntryIndex >= plan.importOwnerIndexEntryNext.len:
                break
            ownerEntryIndex =
                plan.importOwnerIndexEntryNext[ownerEntryIndex]
    return foundSourcePath

@borrows
fn LoweringPlanUnqualifiedImportTargetSourcePath(plan: var LoweringPlanStub,
                                                  currentSourcePathRaw: str,
                                                  functionNameRaw: str): str =
    let currentSourcePath = parser.ParserNormalizePath(currentSourcePathRaw)
    let functionName = chengpath.PathTrim(functionNameRaw)
    if currentSourcePath == "" || functionName == "":
        return ""
    if plan.importOwnerIndexBucketHeads.len <= 0:
        LoweringBuildImportEdgeIndex(plan)
    if plan.unqualifiedImportResolveCacheBucketHeads.len <= 0:
        for initBucket in 0..<4096:
            LoweringUnqualifiedImportResolveCacheAppendBucket(plan, -1)
    let cacheBucket = (parser.ParserTextLookupContentHash(currentSourcePath) ^
                       parser.ParserTextLookupContentHash(functionName)) &
                      (plan.unqualifiedImportResolveCacheBucketHeads.len - 1)
    var cacheIndex = plan.unqualifiedImportResolveCacheBucketHeads[cacheBucket]
    while cacheIndex >= 0:
        if cacheIndex >= plan.unqualifiedImportResolveCacheFunctionNames.len ||
           cacheIndex >= plan.unqualifiedImportResolveCacheTargetSourcePaths.len ||
           cacheIndex >= plan.unqualifiedImportResolveCacheSourcePaths.len:
            break
        if plan.unqualifiedImportResolveCacheSourcePaths[cacheIndex] == currentSourcePath &&
           plan.unqualifiedImportResolveCacheFunctionNames[cacheIndex] == functionName:
            return plan.unqualifiedImportResolveCacheTargetSourcePaths[cacheIndex]
        if cacheIndex >= plan.unqualifiedImportResolveCacheEntryNext.len:
            break
        cacheIndex = plan.unqualifiedImportResolveCacheEntryNext[cacheIndex]
    let ownerModulePath = LoweringPlanOwnerModulePathForSource(plan, currentSourcePath)
    if ownerModulePath == "":
        let missEntryIndex = plan.unqualifiedImportResolveCacheSourcePaths.len
        LoweringUnqualifiedImportResolveCacheAppendRow(
            plan,
            currentSourcePath,
            functionName,
            "",
            plan.unqualifiedImportResolveCacheBucketHeads[cacheBucket])
        plan.unqualifiedImportResolveCacheBucketHeads[cacheBucket] = missEntryIndex
        return ""
    var foundSourcePath = ""
    let ownerBucket = LoweringImportOwnerIndexBucket(ownerModulePath,
                                                     plan.importOwnerIndexBucketHeads.len)
    if ownerBucket >= 0:
        var ownerEntryIndex = plan.importOwnerIndexBucketHeads[ownerBucket]
        while ownerEntryIndex >= 0:
            if ownerEntryIndex >= plan.importOwnerIndexOwnerModulePaths.len ||
               ownerEntryIndex >= plan.importOwnerIndexEntryEdgeIndexes.len:
                break
            if plan.importOwnerIndexOwnerModulePaths[ownerEntryIndex] == ownerModulePath:
                let edgeIndex = plan.importOwnerIndexEntryEdgeIndexes[ownerEntryIndex]
                if edgeIndex >= 0 && edgeIndex < plan.importEdges.len:
                    let edge = plan.importEdges[edgeIndex]
                    if edge.resolved && edge.allowsUnqualifiedCall:
                        let targetSourcePath = parser.ParserNormalizePath(edge.targetSourcePath)
                        if targetSourcePath != "":
                            let targetIndex = LoweringPlanTypedIrFunctionIndexByName(plan,
                                                                                     targetSourcePath,
                                                                                     functionName)
                            if targetIndex >= 0:
                                if foundSourcePath != "" && foundSourcePath != targetSourcePath:
                                    foundSourcePath = ""
                                    break
                                foundSourcePath = targetSourcePath
            if ownerEntryIndex >= plan.importOwnerIndexEntryNext.len:
                break
            ownerEntryIndex = plan.importOwnerIndexEntryNext[ownerEntryIndex]
    let resolvedEntryIndex = plan.unqualifiedImportResolveCacheSourcePaths.len
    LoweringUnqualifiedImportResolveCacheAppendRow(
        plan,
        currentSourcePath,
        functionName,
        foundSourcePath,
        plan.unqualifiedImportResolveCacheBucketHeads[cacheBucket])
    plan.unqualifiedImportResolveCacheBucketHeads[cacheBucket] = resolvedEntryIndex
    return foundSourcePath

@borrows
fn LoweringStatementIndexOrderGroup(typedIr: texpr.TypedExprIr, idx: int32): int32 =
    if typedIr.statements2_kinds[idx] == texpr.TypedExprIrStmtLocalDecl &&
       arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_enclosingIfLineNumbers, idx) <= 0:
        return 0
    return 1

@borrows
fn LoweringStatementIndexLess(typedIr: texpr.TypedExprIr, lhs: int32, rhs: int32): bool =
    let lhsGroup = LoweringStatementIndexOrderGroup(typedIr, lhs)
    let rhsGroup = LoweringStatementIndexOrderGroup(typedIr, rhs)
    if lhsGroup > rhsGroup:
        return true
    if lhsGroup < rhsGroup:
        return false
    if arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_lineNumbers, lhs) > arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_lineNumbers, rhs):
        return true
    if arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_lineNumbers, lhs) < arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_lineNumbers, rhs):
        return false
    if arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_columnNumbers, lhs) > arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_columnNumbers, rhs):
        return true
    return false

@borrows
fn loweringSequenceAllocatorAdd(
        fnIr: var PrimaryObjectIrFunction,
        value: PrimaryObjectIrStatement) =
    let beforeCapacity = fnIr.statements.cap
    add(fnIr.statements, share(value))
    loweringSequenceAllocatorRecordAddResult(
        fnIr.functionShapeAllocatorLedger,
        beforeCapacity,
        fnIr.statements.cap,
        fnIr.statements.buffer != nil,
        sizeof(PrimaryObjectIrStatement))

@borrows
fn LoweringAppendPrimaryObjectIrStatements(fnIr: var PrimaryObjectIrFunction,
                                             plan: LoweringPlanStub,
                                             typedFnIndex: int32,
                                             sourceTexts: texpr.TypedExprSourceText[]) =
    if typedFnIndex < 0 || typedFnIndex >= plan.typedIr.functions2_functionNameIds.len:
        return
    var stmtStart = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_statementStarts, typedFnIndex)
    if stmtStart < 0:
        return
    if stmtStart >= plan.typedIr.statements2_statementIndexs.len:
        return
    var stmtEnd = stmtStart + arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_statementCounts, typedFnIndex)
    if stmtEnd > plan.typedIr.statements2_statementIndexs.len:
        stmtEnd = plan.typedIr.statements2_statementIndexs.len
    # combo-c regression fix: pre-combo-C the producer sorted the AoS statements[]
    # (TypedExprIrSortStatementRange, by group/line/col) so the lowering saw source order.
    # combo-c (f749b4622) switched this loop to the SoA columns, which are raw insertion
    # order; for inline match arms (`A => return 1`) the body lands before the rewritten
    # if/elif header, scrambling the dispatch (3 enum-match driver miscompiles). Sort the
    # SoA index range by the same key. The match-rewrite scans SoA during production
    # (insertion order) and is unaffected.
    var order: int32[]
    for fillIdx in stmtStart..<stmtEnd:
        add(order, fillIdx)
    var swapped = true
    while swapped:
        swapped = false
        var sortI = 1
        while sortI < order.len:
            if LoweringStatementIndexLess(plan.typedIr, order[sortI], order[sortI - 1]):
                let tmp = order[sortI - 1]
                order[sortI - 1] = order[sortI]
                order[sortI] = tmp
                swapped = true
            sortI = sortI + 1
    for orderIdx in 0..<order.len:
        let stmtIndex = order[orderIdx]
        let typedStmt = texpr.TypedExprIrStatement(
            sourcePath: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_sourcePathIds[stmtIndex])),
            functionName: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_functionNameIds[stmtIndex])),
            statementIndex: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_statementIndexs, stmtIndex),
            lineNumber: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_lineNumbers, stmtIndex),
            columnNumber: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_columnNumbers, stmtIndex),
            endLineNumber: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_endLineNumbers, stmtIndex),
            endColumnNumber: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_endColumnNumbers, stmtIndex),
            lexicalScopeId: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_lexicalScopeIds, stmtIndex),
            suiteScopeId: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_suiteScopeIds, stmtIndex),
            statementOrdinal: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_statementOrdinals, stmtIndex),
            lexicalOrdinal: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_lexicalOrdinals, stmtIndex),
            deferOwnerStatementOrdinal: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_deferOwnerStatementOrdinals, stmtIndex),
            lineIndent: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_lineIndents, stmtIndex),
            enclosingIfLineNumber: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_enclosingIfLineNumbers, stmtIndex),
            enclosingIfConditionText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_enclosingIfConditionTextIds[stmtIndex])),
            exprId: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_exprIdIds[stmtIndex])),
            kind: plan.typedIr.statements2_kinds[stmtIndex],
            callKind: plan.typedIr.statements2_callKinds[stmtIndex],
            detailKind: plan.typedIr.statements2_detailKinds[stmtIndex],
            surfaceText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_surfaceTextIds[stmtIndex])),
            bindingName: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_bindingNameIds[stmtIndex])),
            resultType: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_resultTypeIds[stmtIndex])),
            conditionKind: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_conditionKinds, stmtIndex),
            conditionLhsText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_conditionLhsTextIds[stmtIndex])),
            conditionRhsText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_conditionRhsTextIds[stmtIndex])),
            conditionLiteralText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_conditionLiteralTextIds[stmtIndex])),
            assignRootName: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignRootNameIds[stmtIndex])),
            assignRootType: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignRootTypeIds[stmtIndex])),
            assignRootSourcePath: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignRootSourcePathIds[stmtIndex])),
            assignRootGlobalFlag: plan.typedIr.statements2_assignRootGlobalFlags[stmtIndex],
            assignPlaceKind: plan.typedIr.statements2_assignPlaceKinds[stmtIndex],
            assignFieldName: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignFieldNameIds[stmtIndex])),
            assignFieldType: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignFieldTypeIds[stmtIndex])),
            assignFieldOffsetBytes: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignFieldOffsetBytes, stmtIndex),
            assignFieldSizeBytes: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignFieldSizeBytes, stmtIndex),
            assignFieldAlignBytes: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignFieldAlignBytes, stmtIndex),
            assignValueRootName: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignValueRootNameIds[stmtIndex])),
            assignValueRootType: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignValueRootTypeIds[stmtIndex])),
            assignValueFieldName: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignValueFieldNameIds[stmtIndex])),
            assignValueFieldType: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignValueFieldTypeIds[stmtIndex])),
            assignValueFieldOffsetBytes: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignValueFieldOffsetBytes, stmtIndex),
            assignValueFieldSizeBytes: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignValueFieldSizeBytes, stmtIndex),
            assignValueFieldAlignBytes: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignValueFieldAlignBytes, stmtIndex),
            assignValueOpKind: plan.typedIr.statements2_assignValueOpKinds[stmtIndex],
            assignValueLhsText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignValueLhsTextIds[stmtIndex])),
            assignValueRhsText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignValueRhsTextIds[stmtIndex])),
            assignValueRhsConst: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignValueRhsConsts, stmtIndex),
            assignValueRhsHasConst: plan.typedIr.statements2_assignValueRhsHasConsts[stmtIndex],
            callQualifier: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_callQualifierIds[stmtIndex])),
            callCallee: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_callCalleeIds[stmtIndex])),
            callTarget: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_callTargetIds[stmtIndex])),
            callTargetSourcePath: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_callTargetSourcePathIds[stmtIndex])),
            callTargetSignatureLineNumber: arenamod.ArenaArrayInt32Get(
                plan.typedIr.arena,
                plan.typedIr.statements2_callTargetSignatureLineNumbers,
                stmtIndex),
            callTargetImportc: plan.typedIr.statements2_callTargetImportcs[stmtIndex],
            callArgCount: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_callArgCounts, stmtIndex),
            callArgsText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_callArgsTextIds[stmtIndex])),
            callArgTypesText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_callArgTypesTextIds[stmtIndex])),
            callArgNodeStart: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_callArgNodeStarts, stmtIndex),
            callArgNodeCount: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_callArgNodeCounts, stmtIndex),
            rhsNodeIndex: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_rhsNodeIndexs, stmtIndex),
            rhsBailReason: plan.typedIr.statements2_rhsBailReasons[stmtIndex],
            callSurfaceKind: plan.typedIr.statements2_callSurfaceKinds[stmtIndex],
            forStartNodeIndex: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_forStartNodeIndexs, stmtIndex),
            assignLvalueNodeIndex: arenamod.ArenaArrayInt32Get(
                plan.typedIr.arena,
                plan.typedIr.statements2_assignLvalueNodeIndexs,
                stmtIndex),
            assignIndexNodeIndex: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignIndexNodeIndexs, stmtIndex),
            bindingTargetDefinitionRow: arenamod.ArenaArrayInt32Get(
                plan.typedIr.arena,
                plan.typedIr.statements2_bindingTargetDefinitionRows,
                stmtIndex),
            loweringMode: plan.typedIr.statements2_loweringModes[stmtIndex],
            returnKind: plan.typedIr.statements2_returnKinds[stmtIndex],
            returnRoot: plan.typedIr.statements2_returnRoots[stmtIndex],
        )
        let callQualifier = strings.CloneStr(typedStmt.callQualifier)
        let sourcePathKept = strings.CloneStr(typedStmt.sourcePath)
        let callTargetSourcePathKept = strings.CloneStr(typedStmt.callTargetSourcePath)
        let callTargetKept = strings.CloneStr(typedStmt.callTarget)
        var stmt = LoweringPrimaryObjectIrStatementFromTyped(typedStmt)
        if len(callQualifier) > 0:
            var importedSourcePath = LoweringTypedIrImportAliasTargetSourcePath(plan.typedIr,
                                                                                sourcePathKept,
                                                                                callQualifier)
            if len(importedSourcePath) <= 0:
                importedSourcePath =
                    loweringPlanQualifiedImportTargetSourcePathFrozen(
                        plan,
                        sourcePathKept,
                        callQualifier)
            if len(importedSourcePath) > 0:
                if len(stmt.callTargetSourcePath) <= 0 ||
                   parser.ParserNormalizePath(stmt.callTargetSourcePath) == parser.ParserNormalizePath(sourcePathKept):
                    stmt.callTargetSourcePath = importedSourcePath
        var importcSourcePath = callTargetSourcePathKept
        if len(stmt.callTargetSourcePath) > 0:
            importcSourcePath = stmt.callTargetSourcePath
        if len(importcSourcePath) <= 0:
            importcSourcePath = sourcePathKept
        var importcSymbol = ""
        if LoweringFindImportcTargetSymbolTyped(plan.typedIr,
                                                sourceTexts,
                                                importcSourcePath,
                                                callTargetKept,
                                                importcSymbol):
            stmt.callTargetSourcePath = importcSourcePath
            stmt.callTargetImportc = true
        loweringSequenceAllocatorAdd(fnIr, stmt)
    fnIr.statementCount = fnIr.statements.len

@borrows
fn LoweringFillPrimaryObjectIrParams(fnIr: var PrimaryObjectIrFunction,
                                      typedIr: texpr.TypedExprIr,
                                      typedFnIndex: int32) =
    if typedFnIndex < 0 || typedFnIndex >= typedIr.functions2_functionNameIds.len:
        return
    var nodeEnd = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.functions2_nodeStarts, typedFnIndex) + arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.functions2_nodeCounts, typedFnIndex)
    if nodeEnd > typedIr.nodes2_nodeIndexs.len:
        nodeEnd = typedIr.nodes2_nodeIndexs.len
    for nodeIndex in arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.functions2_nodeStarts, typedFnIndex)..<nodeEnd:
        if typedIr.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpParamRef:
            continue
        let paramSlot = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.nodes2_paramSlots, nodeIndex)
        if paramSlot < 0:
            continue
        while fnIr.paramNames.len <= paramSlot:
            loweringSequenceAllocatorAdd(
                fnIr.functionShapeAllocatorLedger,
                fnIr.paramNames,
                "",
                sizeof(str))
            loweringSequenceAllocatorAdd(
                fnIr.functionShapeAllocatorLedger,
                fnIr.paramTypes,
                "",
                sizeof(str))
        let paramNameRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_paramNameIds[nodeIndex])
        let paramTypeRes: Result[str] = langintern.LookupIntern(typedIr.internPool, typedIr.nodes2_resultTypeIds[nodeIndex])
        if !IsOk(paramNameRes) || !IsOk(paramTypeRes):
            continue
        fnIr.paramNames[paramSlot] = Value(paramNameRes)
        fnIr.paramTypes[paramSlot] = Value(paramTypeRes)

# Exact field-fnptr admission.  The CallExpr row is the query identity; every
# remaining payload was sealed by CompilerCSG before source buffers were
# released.  Missing or duplicated facts for a structural field callee are a
# producer bug and must never fall back to text/name lookup.
@borrows
fn LoweringPrimaryObjectIrCallTargetIsFnPtrFieldCall(
        plan: LoweringPlanStub,
        callNodeIndex: int32): bool =
    if callNodeIndex < 0 ||
       callNodeIndex >= plan.typedIr.nodes2_nodeIndexs.len ||
       plan.typedIr.nodes2_opKinds[callNodeIndex] !=
           texpr.TypedExprIrOpCallExpr:
        return false
    let fieldNodeIndex = arenamod.ArenaArrayInt32Get(
        plan.typedIr.arena,
        plan.typedIr.nodes2_operand2NodeIndexs,
        callNodeIndex)
    var foundRow: int32 = -1
    for row in 0..<plan.fnPtrFieldCallNodeIndexes.len:
        if plan.fnPtrFieldCallNodeIndexes[row] !=
           callNodeIndex:
            continue
        if foundRow >= 0:
            panic(Fmt"lowering: ambiguous frozen fnptr field call fact node={callNodeIndex}")
        foundRow = row
    if fieldNodeIndex < 0:
        if foundRow >= 0:
            panic(Fmt"lowering: fnptr field fact attached to direct CallExpr node={callNodeIndex}")
        return false
    if foundRow < 0:
        panic(Fmt"lowering: frozen fnptr field call fact missing node={callNodeIndex}")
    if !layout.FixedBytes32Equal(
           plan.fnPtrFieldCallTypeArenaArtifactCid,
           plan.typeArenaArtifactCid) ||
       foundRow >= plan.fnPtrFieldCallFieldNodeIndexes.len ||
       foundRow >= plan.fnPtrFieldCallFieldTypeIds.len ||
       foundRow >= plan.fnPtrFieldCallStructuralKinds.len ||
       foundRow >=
           plan.fnPtrFieldCallFunctionInterfaceCids.len ||
       plan.fnPtrFieldCallFieldNodeIndexes[foundRow] !=
           fieldNodeIndex ||
       fieldNodeIndex < 0 ||
       fieldNodeIndex >= callNodeIndex ||
       plan.typedIr.nodes2_opKinds[fieldNodeIndex] !=
           texpr.TypedExprIrOpFieldGet ||
       arenamod.ArenaArrayInt32Get(
           plan.typedIr.arena,
           plan.typedIr.nodes2_exactTypeArenaIds,
           fieldNodeIndex) !=
           plan.fnPtrFieldCallFieldTypeIds[foundRow] ||
       plan.fnPtrFieldCallFieldTypeIds[foundRow] < 0 ||
       plan.fnPtrFieldCallFieldTypeIds[foundRow] >=
           plan.typeArenaStructuralKinds.len ||
       plan.typeArenaStructuralKinds[
           plan.fnPtrFieldCallFieldTypeIds[foundRow]] !=
           plan.fnPtrFieldCallStructuralKinds[foundRow] ||
       layout.FixedBytes32Equal(
           plan.fnPtrFieldCallFunctionInterfaceCids[foundRow],
           layout.FixedBytes32()):
        panic(Fmt"lowering: frozen fnptr field call fact drift node={callNodeIndex} row={foundRow}")
    return true

@borrows
fn LoweringPrimaryObjectIrFnPtrFieldCallForParserOrigin(
        fnIr: PrimaryObjectIrFunction,
        plan: LoweringPlanStub,
        originParserNodeId: int32): bool =
    if originParserNodeId < 0 ||
       fnIr.typedFunctionIndex < 0 ||
       fnIr.typedFunctionIndex >=
           plan.typedIr.functions2_functionNameIds.len:
        return false
    let nodeStart = arenamod.ArenaArrayInt32Get(
        plan.typedIr.arena,
        plan.typedIr.functions2_nodeStarts,
        fnIr.typedFunctionIndex)
    let nodeCount = arenamod.ArenaArrayInt32Get(
        plan.typedIr.arena,
        plan.typedIr.functions2_nodeCounts,
        fnIr.typedFunctionIndex)
    var callNodeIndex: int32 = -1
    for nodeIndex in nodeStart..<nodeStart + nodeCount:
        if plan.typedIr.nodes2_opKinds[nodeIndex] !=
               texpr.TypedExprIrOpCallExpr ||
           arenamod.ArenaArrayInt32Get(
               plan.typedIr.arena,
               plan.typedIr.nodes2_originParserNodeIds,
               nodeIndex) != originParserNodeId:
            continue
        if callNodeIndex >= 0:
            panic(Fmt"lowering: parser call origin is ambiguous function={fnIr.typedFunctionIndex} parser_node={originParserNodeId}")
        callNodeIndex = nodeIndex
    if callNodeIndex < 0:
        return false
    return LoweringPrimaryObjectIrCallTargetIsFnPtrFieldCall(
        plan, callNodeIndex)

# 参数/局部绑定的声明类型可能经过任意长度的命名 fn-ptr alias 链。
# 每一跳只消费 sealed TypedIR 的精确 (owner source, alias identity) 边；
# 歧义、成环和不完整 payload 立即失败，禁止一层展开或文本全局回退。
@borrows
fn LoweringTypeTextResolvesToFnPtr(plan: LoweringPlanStub,
                                    sourcePath: str,
                                    typeTextRaw: str): bool =
    var ownerSourcePath = parser.ParserNormalizePath(sourcePath)
    var declaredType = texpr.TypedExprNormalizeTypeText(
        texpr.TypedExprStripVarType(typeTextRaw))
    if ownerSourcePath == "" || declaredType == "":
        return false
    if texpr.TypedExprTypeTextIsFnPtr(declaredType):
        return true
    var visitedOwners: str[]
    var visitedNames: str[]
    while true:
        var aliasOwnerSourcePath = ""
        var aliasTarget = ""
        var aliasCycle = false
        let aliasState = texpr.TypedExprIrAliasTarget(plan.typedIr,
                                                       ownerSourcePath,
                                                       declaredType,
                                                       visitedOwners,
                                                       visitedNames,
                                                       aliasOwnerSourcePath,
                                                       aliasTarget,
                                                       aliasCycle)
        if aliasCycle:
            panic(Fmt"lowering: function pointer alias cycle source={ownerSourcePath} type={declaredType}")
        if aliasState == texpr.TypedExprBuildIndexAmbiguous:
            panic(Fmt"lowering: function pointer alias ambiguous source={ownerSourcePath} type={declaredType}")
        if aliasState != texpr.TypedExprBuildIndexUnique:
            return false
        let normalizedTarget = texpr.TypedExprNormalizeTypeText(
            texpr.TypedExprStripVarType(aliasTarget))
        if aliasOwnerSourcePath == "" || normalizedTarget == "":
            panic(Fmt"lowering: incomplete function pointer alias payload source={ownerSourcePath} type={declaredType}")
        ownerSourcePath = aliasOwnerSourcePath
        declaredType = normalizedTarget
        if texpr.TypedExprTypeTextIsFnPtr(declaredType):
            return true

# 全局类型只从冻结 lowering plan 的 canonical visible-global 索引读取。
# 生产者 source row、声明 row、TypeArena proof 与三类 CID 必须同域。
@borrows
fn LoweringTypedGlobalTypeForName(plan: LoweringPlanStub,
                                   sourcePath: str,
                                   name: str): str =
    if layout.FixedBytes32Equal(plan.sourceBundleCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(plan.compilerCsgCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(plan.typeArenaArtifactCid, layout.FixedBytes32()):
        panic("lowering: global query lacks frozen canonical CIDs")
    var globalRow: int32
    var definingSourcePath = ""
    let state = texpr.TypedExprIrVisibleSourceRowState(
        plan.typedIr,
        "ir_global_source",
        sourcePath,
        name,
        "",
        globalRow,
        definingSourcePath)
    if state == texpr.TypedExprBuildIndexAmbiguous:
        panic(Fmt"lowering: ambiguous visible global source={sourcePath} name={name}")
    if state != texpr.TypedExprBuildIndexUnique:
        return ""
    if globalRow < 0 ||
       globalRow >= plan.typedIr.globalNames.len ||
       globalRow >= plan.typedIr.globalSourcePaths.len ||
       globalRow >= plan.typedIr.globalTypes.len ||
       globalRow >= plan.typedIr.globalProducerSourceIndexes.len ||
       globalRow >= plan.typedIr.globalDeclarationSourceLocalRows.len ||
       globalRow >= plan.globalTypeArenaTypeIds.len ||
       globalRow >= plan.globalManagedStorageKinds.len ||
       plan.typedIr.globalNames[globalRow] != name ||
       !texpr.TypedExprPathNormalizedEquals(
           plan.typedIr.globalSourcePaths[globalRow], definingSourcePath) ||
       plan.typedIr.globalProducerSourceIndexes[globalRow] < 0 ||
       plan.typedIr.globalDeclarationSourceLocalRows[globalRow] < 0 ||
       plan.globalTypeArenaTypeIds[globalRow] < 0 ||
       plan.globalManagedStorageKinds[globalRow] ==
           coreir.BodyManagedStorageUnknownTag:
        panic(Fmt"lowering: visible global canonical identity incomplete source={sourcePath} name={name} row={globalRow}")
    return plan.typedIr.globalTypes[globalRow]

@borrows
fn LoweringPrimaryObjectIrCallTargetIsFnPtrBinding(fnIr: PrimaryObjectIrFunction,
                                                    plan: LoweringPlanStub,
                                                    sourceTexts: texpr.TypedExprSourceText[],
                                                    targetRaw: str): bool =
    let target = chengpath.PathTrim(targetRaw)
    if target == "":
        return false
    if strutil.Contains(target, "["):
        return false
    if strutil.Contains(target, "."):
        # Field-call identity is a CallExpr node coordinate.  Text-only
        # embedded-call paths cannot classify it and must not guess.
        return false
    for i in 0..<fnIr.paramNames.len:
        if i >= fnIr.paramTypes.len:
            continue
        if fnIr.paramNames[i] != target:
            continue
        if texpr.TypedExprTypeTextIsFnPtr(fnIr.paramTypes[i]):
            return true
        if LoweringTypeTextResolvesToFnPtr(plan,
                                           fnIr.sourcePath,
                                           fnIr.paramTypes[i]):
            return true
    for i in 0..<fnIr.statements.len:
        if fnIr.statements[i].bindingName != target:
            continue
        if texpr.TypedExprTypeTextIsFnPtr(fnIr.statements[i].resultType):
            return true
        if LoweringTypeTextResolvesToFnPtr(plan,
                                           fnIr.sourcePath,
                                           fnIr.statements[i].resultType):
            return true
    # T50-v3: 模块级全局函数值绑定 (如 `var globalB: IntFn`, 经全局读回间接调用
    # `globalB(x)`)。此前完全不在扫描范围 —— 只查了当前函数的形参/局部, 全局
    # 从未查过, 致 f47_probe_two_globals.cheng 的 globalA/globalB 被误登记进
    # callTargets(body-IR 侧走 GlobalLoad+间接调用, 从不建普通 call op)。
    let globalType = LoweringTypedGlobalTypeForName(plan,
                                                    strings.CloneStr(fnIr.sourcePath),
                                                    target)
    if globalType != "":
        if texpr.TypedExprTypeTextIsFnPtr(globalType):
            return true
        if LoweringTypeTextResolvesToFnPtr(plan,
                                           strings.CloneStr(fnIr.sourcePath),
                                           globalType):
            return true
    return false

@borrows
fn LoweringPrimaryObjectIrHasFnPtrCallTarget(fnIr: PrimaryObjectIrFunction,
                                              plan: LoweringPlanStub,
                                              sourceTexts: texpr.TypedExprSourceText[]): bool =
    if fnIr.typedFunctionIndex >= 0 &&
       fnIr.typedFunctionIndex <
           plan.typedIr.functions2_functionNameIds.len:
        let nodeStart = arenamod.ArenaArrayInt32Get(
            plan.typedIr.arena,
            plan.typedIr.functions2_nodeStarts,
            fnIr.typedFunctionIndex)
        let nodeCount = arenamod.ArenaArrayInt32Get(
            plan.typedIr.arena,
            plan.typedIr.functions2_nodeCounts,
            fnIr.typedFunctionIndex)
        for nodeIndex in nodeStart..<nodeStart + nodeCount:
            if plan.typedIr.nodes2_opKinds[nodeIndex] ==
                   texpr.TypedExprIrOpCallExpr &&
               LoweringPrimaryObjectIrCallTargetIsFnPtrFieldCall(
                   plan, nodeIndex):
                return true
    for i in 0..<fnIr.statements.len:
        if LoweringPrimaryObjectIrCallTargetIsFnPtrBinding(fnIr,
                                                           plan,
                                                           sourceTexts,
                                                           fnIr.statements[i].callTarget):
            return true
    for i in 0..<fnIr.callTargets.len:
        if LoweringPrimaryObjectIrCallTargetIsFnPtrBinding(fnIr,
                                                           plan,
                                                           sourceTexts,
                                                           fnIr.callTargets[i]):
            return true
    return false

@borrows
fn LoweringCallHeadIsNonExecutableTypeMaterialization(fnIr: PrimaryObjectIrFunction,
                                                        plan: LoweringPlanStub,
                                                        callHeadRaw: str,
                                                        callTargetSourcePath: str): bool =
    let callHead = chengpath.PathTrim(callHeadRaw)
    let leaf = texpr.TypedExprQualifiedCallLeaf(callHead)
    if leaf == "":
        return false
    # 同名真函数优先；只有 TypedIR 证明这是类型物化时才过滤。
    if loweringPlanTypedIrFunctionIndexByNameFrozen(
           plan, callTargetSourcePath, leaf) >= 0:
        return false
    if texpr.TypedExprIrTypeIsRef(plan.typedIr, fnIr.sourcePath, callHead):
        return true
    if texpr.TypedExprIrTypeDefAliasIsSameSourcePtr(plan.typedIr,
                                                    fnIr.sourcePath,
                                                    leaf):
        return true
    return texpr.TypedExprIrTypeDefAliasIsSameSourceSeq(plan.typedIr,
                                                        fnIr.sourcePath,
                                                        leaf)

@borrows
fn LoweringAppendPrimaryObjectIrEmbeddedCallHead(fnIr: var PrimaryObjectIrFunction,
                                                  plan: LoweringPlanStub,
                                                  sourceTexts: texpr.TypedExprSourceText[],
                                                  callHeadRaw: str,
                                                  callArgsText: str) =
    let callHead = chengpath.PathTrim(callHeadRaw)
    if callHead == "":
        return
    if LoweringReachabilityCallHeadIsPureCast(callHead):
        return
    # T50-v3: EnumType(intExpr) 单参构造 —— node-eval 侧(typed_expr.cheng:12072
    # `argTexts.len == 1 && TypedExprIrTypeIsEnum(...)` 分支)恒建纯 int32
    # 透传节点, 从不生成 call op(枚举 i32 背衬, 构造是同一 i32 值透传, callHead
    # 是类型名而非函数)。与上面 LoweringReachabilityCallHeadIsPureCast 的内建
    # 标量 cast 同款豁免, 只是 cast 目标换成用户声明的枚举类型; 用下游同一权威
    # 谓词 + 同一单参门槛镜像判定(TypedExprFactAt detail=TypedExprReturnKind
    # 实测: `TypedExprReturnKind(arenamod.ArenaArrayInt32Get(...))`, 与
    # fn-value 间接调用是不同的两类问题, 不可用 fn-ptr-binding 过滤覆盖)。
    if LoweringCallArgNames(callArgsText).len == 1 &&
       texpr.TypedExprIrTypeIsEnum(plan.typedIr, fnIr.sourcePath, callHead):
        return
    if LoweringPrimaryObjectIrCallTargetIsFnPtrBinding(fnIr, plan, sourceTexts, callHead):
        return
    let leaf = texpr.TypedExprQualifiedCallLeaf(callHead)
    if leaf == "":
        return
    let qualifier = texpr.TypedExprQualifiedCallQualifier(callHead)
    var callTargetSourcePath = ""
    if qualifier != "":
        callTargetSourcePath = LoweringTypedIrImportAliasTargetSourcePath(plan.typedIr,
                                                                          fnIr.sourcePath,
                                                                          qualifier)
        if callTargetSourcePath == "":
            callTargetSourcePath =
                loweringPlanQualifiedImportTargetSourcePathFrozen(
                    plan,
                    fnIr.sourcePath,
                    qualifier)
    if callTargetSourcePath == "" && qualifier == "":
        callTargetSourcePath =
            loweringPlanUnqualifiedImportTargetSourcePathFrozen(
                plan,
                fnIr.sourcePath,
                leaf)
    if callTargetSourcePath == "" && qualifier == "":
        callTargetSourcePath = fnIr.sourcePath
    # 类型物化在 BodyIR 里不产生 call op；扫描器会独立遍历内层调用。
    if LoweringCallHeadIsNonExecutableTypeMaterialization(fnIr,
                                                           plan,
                                                           callHead,
                                                           callTargetSourcePath):
        return
    var callTargetImportc = false
    var importcSymbol = ""
    if LoweringFindImportcTargetSymbolTyped(plan.typedIr,
                                            sourceTexts,
                                            callTargetSourcePath,
                                            leaf,
                                            importcSymbol):
        callTargetImportc = true
    let callArgCount = LoweringCallArgNames(callArgsText).len
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr,
                                                  callArgCount,
                                                  leaf,
                                                  callTargetSourcePath,
                                                  0,
                                                  callTargetImportc,
                                                  importcSymbol)

# 嵌入文本扫描的字符串/字符字面量状态机（转义处理照抄 typed_expr.cheng
# TypedExprFindWholeCallOpenParen）。返回位置 i 是否为可采样代码位：
# 普通字符串/字符字面量内部一律不可采——否则 "@exportc(" 这类字面量文本
# 会被采成幻影调用目标 → missing_call_target not_ready。Fmt 字符串的
# {expr} 插值区段仍是代码位（Fmt 内嵌调用的可达性依赖它，见
# LoweringMarkReachableEmbeddedCallHeads 注释），{{ / }} 为字面量大括号，
# 插值内的嵌套字符串字面量同样不可采。
@borrows
fn LoweringEmbeddedScanCodeAt(text: str,
                               i: int32,
                               inString: var bool,
                               inFmtString: var bool,
                               inNestedString: var bool,
                               inChar: var bool,
                               escaped: var bool,
                               skipNext: var bool,
                               braceDepth: var int32): bool =
    let piece = text[i]
    if skipNext:
        skipNext = false
        return false
    if inChar:
        if escaped:
            escaped = false
        elif piece == '\\':
            escaped = true
        elif piece == '\'':
            inChar = false
        return false
    if inString:
        if escaped:
            escaped = false
            return false
        if piece == '\\':
            escaped = true
            return false
        if inNestedString:
            if piece == '"':
                inNestedString = false
            return false
        if piece == '"':
            if braceDepth > 0:
                inNestedString = true
            else:
                inString = false
                inFmtString = false
            return false
        if !inFmtString:
            return false
        if piece == '{':
            if braceDepth <= 0 && i + 1 < len(text) && text[i + 1] == '{':
                skipNext = true
            else:
                braceDepth = braceDepth + 1
            return false
        if piece == '}':
            if braceDepth > 0:
                braceDepth = braceDepth - 1
            elif i + 1 < len(text) && text[i + 1] == '}':
                skipNext = true
            return false
        return braceDepth > 0
    if piece == '"':
        inString = true
        inNestedString = false
        braceDepth = 0
        inFmtString = false
        if i >= 3 && text[i - 1] == 't' && text[i - 2] == 'm' && text[i - 3] == 'F':
            if i == 3:
                inFmtString = true
            else:
                let prev = text[i - 4]
                var prevIdent = false
                if prev >= 'a' && prev <= 'z':
                    prevIdent = true
                elif prev >= 'A' && prev <= 'Z':
                    prevIdent = true
                elif prev >= '0' && prev <= '9':
                    prevIdent = true
                elif prev == '_' || prev == '.':
                    prevIdent = true
                if !prevIdent:
                    inFmtString = true
        return false
    if piece == '\'':
        inChar = true
        escaped = false
        return false
    return true

@borrows
fn LoweringAppendPrimaryObjectIrEmbeddedCallTargetsFromText(fnIr: var PrimaryObjectIrFunction,
                                                             plan: LoweringPlanStub,
                                                             sourceTexts: texpr.TypedExprSourceText[],
                                                             textRaw: str) =
    let text = chengpath.PathTrim(textRaw)
    var i: int32
    var inString = false
    var inFmtString = false
    var inNestedString = false
    var inChar = false
    var escaped = false
    var skipNext = false
    var braceDepth: int32
    while i < len(text):
        if !LoweringEmbeddedScanCodeAt(text,
                                       i,
                                       inString,
                                       inFmtString,
                                       inNestedString,
                                       inChar,
                                       escaped,
                                       skipNext,
                                       braceDepth):
            i = i + 1
            continue
        if text[i] != '(':
            i = i + 1
            continue
        var headStop = i
        var headStart = i
        while headStart > 0:
            let ch = text[headStart - 1]
            var identChar = false
            if ch >= 'a' && ch <= 'z':
                identChar = true
            elif ch >= 'A' && ch <= 'Z':
                identChar = true
            elif ch >= '0' && ch <= '9':
                identChar = true
            elif ch == '_' || ch == '.':
                identChar = true
            if !identChar:
                break
            headStart = headStart - 1
        if headStart >= headStop:
            i = i + 1
            continue
        let closePos = texpr.TypedExprFindMatchingParen(text, i)
        var callArgsText = ""
        if closePos > i:
            callArgsText = chengpath.PathTrim(chengpath.TextSlice(text,
                                                                  i + 1,
                                                                  closePos - i - 1))
            LoweringAppendPrimaryObjectIrEmbeddedCallTargetsFromText(fnIr,
                                                                     plan,
                                                                     sourceTexts,
                                                                     callArgsText)
        let callHead = chengpath.PathTrim(chengpath.TextSlice(text,
                                                              headStart,
                                                              headStop - headStart))
        LoweringAppendPrimaryObjectIrEmbeddedCallHead(fnIr,
                                                      plan,
                                                      sourceTexts,
                                                      callHead,
                                                      callArgsText)
        if closePos > i:
            i = closePos + 1
        else:
            i = i + 1

@borrows
fn LoweringAppendPrimaryObjectIrCallTarget(fnIr: var PrimaryObjectIrFunction,
                                            stmt: PrimaryObjectIrStatement,
                                            plan: LoweringPlanStub,
                                            sourceTexts: texpr.TypedExprSourceText[]) =
    if len(stmt.callTarget) <= 0:
        return
    LoweringAppendPrimaryObjectIrEmbeddedCallTargetsFromText(fnIr,
                                                             plan,
                                                             sourceTexts,
                                                             stmt.callArgsText)
    if LoweringPrimaryObjectIrCallTargetIsFnPtrFieldCall(
           plan, stmt.rhsNodeIndex):
        return
    if LoweringPrimaryObjectIrCallTargetIsFnPtrBinding(fnIr, plan, sourceTexts, stmt.callTarget):
        return
    # 类型构造调用 (Int32Ptr = int32 * 等指针别名 / 内建标量 cast) 在 body-IR 由
    # 节点求值器物化, 不产生 call op —— 与 LoweringAppendPrimaryObjectIrEmbeddedCallHead
    # (文本扫描腿) 同款豁免, 不登记为可解析调用目标, 否则幻影 missing_call_target /
    # LoweringSealPrimaryObjectIrCallIdentities ctor 闸 (cheng_native_errno_code_bridge_export
    # 的 `let ep: Int32Ptr = Int32Ptr(raw)` 实测 target=Int32Ptr signature_line=-1)。
    if LoweringReachabilityCallHeadIsPureCast(stmt.callTarget):
        return
    var materializationSourcePath = stmt.callTargetSourcePath
    if len(materializationSourcePath) <= 0:
        materializationSourcePath = fnIr.sourcePath
    if LoweringCallHeadIsNonExecutableTypeMaterialization(fnIr,
                                                           plan,
                                                           stmt.callTarget,
                                                           materializationSourcePath):
        return
    var importcSymbol = ""
    var callTargetImportc = stmt.callTargetImportc
    var callTargetSourcePath = stmt.callTargetSourcePath
    var callTargetSignatureLineNumber =
        stmt.callTargetSignatureLineNumber
    var importcSourcePath = share(callTargetSourcePath)
    if len(importcSourcePath) <= 0:
        importcSourcePath = stmt.sourcePath
    if LoweringFindImportcTargetSymbolTyped(plan.typedIr,
                                            sourceTexts,
                                            importcSourcePath,
                                            stmt.callTarget,
                                            importcSymbol):
        callTargetImportc = true
        callTargetSourcePath = importcSourcePath
    elif stmt.callTargetImportc:
        importcSymbol = LoweringImportcTargetSymbolTyped(plan.typedIr,
                                                         sourceTexts,
                                                         importcSourcePath,
                                                         stmt.callTarget)
    if !callTargetImportc && len(callTargetSourcePath) <= 0:
        callTargetSourcePath = stmt.sourcePath
    if callTargetImportc:
        callTargetSignatureLineNumber = 0
    var targetTypedFunctionIndex: int32 = -1
    let snapshotCallId =
        LoweringPlanSnapshotCallIdForTypedIrNodeIndex(
            plan, stmt.rhsNodeIndex)
    if snapshotCallId >= 0:
        targetTypedFunctionIndex =
            LoweringPlanSnapshotCallTargetTypedFunctionIndexAt(
                plan, snapshotCallId)
    LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr,
        stmt.callArgCount,
        stmt.callTarget,
        callTargetSourcePath,
        callTargetSignatureLineNumber,
        callTargetImportc,
        targetTypedFunctionIndex,
        importcSymbol,
        stmt.callArgTypesText)

# Ok[T](v)/Err[T](msg) 构造内征：经节点求值器 AppendResultConstruct 内联物化 64B
# Result 聚合（无 Ok/Err 调用 ordinal、无 call op）。绝不能登记为 callTarget——否则
# lowering 的调用目标序列含 Ok 而 body-IR 不含 → reachability/call-sequence 双检查
# 判 missing_call_target → 整单元 not_ready。构造头可能带类型实参（`Ok[MiniDecoded]`），
# 先按 `[` 切名再取 leaf。
@borrows
fn LoweringCallTargetIsResultConstruct(callTargetRaw: str): bool =
    if len(callTargetRaw) <= 0:
        return false
    var ctHead = callTargetRaw
    let ctBracket = parser.ParserFindText(ctHead, "[")
    if ctBracket > 0:
        ctHead = chengpath.TextSlice(ctHead, 0, ctBracket)
    let ctLeaf = texpr.TypedExprQualifiedCallLeaf(ctHead)
    # ErrCode[T](code,msg) 构造臂已内征接管 (pobjp ResultConstructHead 认三叶),
    # 不剥叶会让模板被 reachability 拖上前沿强降体 → result.cheng:62 嵌套
    # 字段赋值 bail=711。ErrInfo 叶构造臂未接管, 故意不进名单。
    return ctLeaf == "Ok" || ctLeaf == "Err" || ctLeaf == "ErrCode"

@borrows
fn LoweringStatementCarriesCallTarget(stmt: PrimaryObjectIrStatement): bool =
    # Call-site gate is mandatory here: this runs inside the duplicate-target
    # scan (LoweringComputeStatementCallTargetDuplicateFlags, PERF-6 hashed to
    # O(N) — was O(N^2) via LoweringStatementCallTargetDuplicateEarlier); an
    # ungated Fmt arg materialized ~322B per call = 6.13GB churn on the
    # dispatch_min census.
    if LoweringTraceOn():
        LoweringDebugLine(Fmt"phase=carries_call_target_check target={stmt.callTarget} surface_kind={int32(stmt.callSurfaceKind)}")
    if len(stmt.callTarget) <= 0:
        return false
    if stmt.callKind == texpr.TypedExprCallResultIntrinsic:
        return false
    if stmt.callTarget == "len":
        return false
    if LoweringCallTargetIsResultConstruct(stmt.callTarget):
        return false
    # ErrorInfoOf[T](r) lowers as a pure err-subaggregate projection intrinsic
    # (no call, no ordinal); registering it as a call target would force its
    # uninstantiated generic template ErrorInfoOf[T] reachable and lowered,
    # zeroing its word count and poisoning the unit to the cold backend.
    if texpr.TypedExprQualifiedCallLeaf(stmt.callTarget) == "ErrorInfoOf":
        return false
    if stmt.kind == texpr.TypedExprIrStmtLocalDecl:
        return true
    if stmt.kind == texpr.TypedExprIrStmtLetCall:
        return true
    if stmt.kind == texpr.TypedExprIrStmtCall:
        return true
    if stmt.kind == texpr.TypedExprIrStmtIfCall:
        return true
    # Result intrinsics are BodyOpResultProject* data projections, not calls.
    # Their TypedIR statement remains in the body, but never enters callTargets.
    if stmt.kind == texpr.TypedExprIrStmtAssign:
        return true
    return false

# 线性参考实现 (PERF-6B 前 O(N) 扫; 仅作语义对拍 oracle, 生产热路径已不调用)。
# 键 = (sourcePath, lineNumber, callCallee, PathTrim(callArgsText)); LocalDecl 且
# callTarget 非空才可能命中; ResultIntrinsic 与 LocalDecl 不同 kind 故
# intrinsicIndex==stmtIndex 永不成立 (旧 continue 冗余, 语义等价保留)。
fn LoweringStatementIsResultIntrinsicMirror(fnIr: var PrimaryObjectIrFunction,
                                             stmtIndex: int32): bool =
    if stmtIndex < 0 || stmtIndex >= fnIr.statements.len:
        return false
    let stmt = fnIr.statements[stmtIndex]
    if stmt.kind != texpr.TypedExprIrStmtLocalDecl || stmt.callTarget == "":
        return false
    for intrinsicIndex in 0..<fnIr.statements.len:
        if intrinsicIndex == stmtIndex:
            continue
        let intrinsic = fnIr.statements[intrinsicIndex]
        if intrinsic.kind != texpr.TypedExprIrStmtResultIntrinsic:
            continue
        if intrinsic.sourcePath == stmt.sourcePath &&
           intrinsic.lineNumber == stmt.lineNumber &&
           intrinsic.callCallee == stmt.callCallee &&
           chengpath.PathTrim(intrinsic.callArgsText) == chengpath.PathTrim(stmt.callArgsText):
            return true
    return false

# PERF-6/6B 哈希分桶: (sourcePath,lineNumber,nameKey,argsTrim) 只用于分桶, 命中桶后
# 仍逐字段精确比较, 零近似语义。nameKey 在 duplicate 臂 = callTarget, mirror 臂 = callCallee。
@borrows
fn LoweringCallTargetDuplicateKeyBucket(sourcePath: str,
                                        lineNumber: int32,
                                        nameKey: str,
                                        argsTrim: str,
                                        bucketCount: int32): int32 =
    if bucketCount <= 0:
        return -1
    var h = parser.ParserTextLookupContentHash(sourcePath)
    h = h * 131 + lineNumber
    h = h * 131 + parser.ParserTextLookupContentHash(nameKey)
    h = h * 131 + parser.ParserTextLookupContentHash(argsTrim)
    if h < 0:
        h = -h
    return h & (bucketCount - 1)

# PERF-6 + PERF-6B: 原 LoweringStatementCallTargetDuplicateEarlier 对每个 stmtIndex 都
# `for prevIndex in 0..<stmtIndex` 线性重扫全部前序语句 = O(n²); PERF-6 用单遍哈希分桶
# 把 callTarget 去重降到 O(n)。PERF-6 后残留同阶源 = LoweringStatementIsResultIntrinsicMirror
# 对每个 i 再扫全表 O(n) → 整体仍 O(n²)。PERF-6B = 预建 ResultIntrinsic 键集
# (sourcePath,lineNumber,callCallee,PathTrim(callArgsText)), LocalDecl 查询 O(1) 期望。
# 语义:
#   - mirror 键用 callCallee (非 callTarget), 与线性 oracle 四字段逐一相等完全一致;
#     哈希只分桶, 命中后精确比较, 零近似。
#   - ResultIntrinsic ≠ LocalDecl kind → 同 index 自匹配不可能; 索引含全部 intrinsic。
#   - callTarget 去重集 "首次出现才插入" 不影响 membership 布尔 (同 PERF-6)。
#   - 插入 callTarget 候选只看 CarriesCallTarget(stmt), 与自身是否 duplicate 无关。
fn LoweringComputeStatementCallTargetDuplicateFlags(
        fnIr: var PrimaryObjectIrFunction):
        LoweringStatementCallTargetDuplicateFlagsOwner =
    var out: LoweringStatementCallTargetDuplicateFlagsOwner
    let n = fnIr.statements.len
    if n <= 0:
        return out
    for i in 0..<n:
        loweringSequenceAllocatorAdd(
            out.allocatorLedger,
            out.flags,
            false,
            sizeof(bool))
    let bucketCount = LoweringResolvedCallFactIndexBucketCount(n)
    # PERF-6B: ResultIntrinsic 键集 (callCallee 臂)
    var mirBucketHeads: int32[]
    for b in 0..<bucketCount:
        loweringSequenceAllocatorAdd(
            out.allocatorLedger,
            mirBucketHeads,
            -1,
            sizeof(int32))
    var mirSourcePaths: str[]
    var mirLineNumbers: int32[]
    var mirCallees: str[]
    var mirArgsTrims: str[]
    var mirNext: int32[]
    for i in 0..<n:
        let s = fnIr.statements[i]
        if s.kind != texpr.TypedExprIrStmtResultIntrinsic:
            continue
        let aTrim = chengpath.PathTrim(s.callArgsText)
        let mb = LoweringCallTargetDuplicateKeyBucket(s.sourcePath, s.lineNumber,
                                                      s.callCallee, aTrim, bucketCount)
        loweringSequenceAllocatorAdd(
            out.allocatorLedger,
            mirSourcePaths,
            s.sourcePath,
            sizeof(str))
        loweringSequenceAllocatorAdd(
            out.allocatorLedger,
            mirLineNumbers,
            s.lineNumber,
            sizeof(int32))
        loweringSequenceAllocatorAdd(
            out.allocatorLedger,
            mirCallees,
            s.callCallee,
            sizeof(str))
        loweringSequenceAllocatorAdd(
            out.allocatorLedger,
            mirArgsTrims,
            aTrim,
            sizeof(str))
        loweringSequenceAllocatorAdd(
            out.allocatorLedger,
            mirNext,
            mirBucketHeads[mb],
            sizeof(int32))
        mirBucketHeads[mb] = mirSourcePaths.len - 1
    # PERF-6: callTarget 去重分桶
    var bucketHeads: int32[]
    for b in 0..<bucketCount:
        loweringSequenceAllocatorAdd(
            out.allocatorLedger,
            bucketHeads,
            -1,
            sizeof(int32))
    var entrySourcePaths: str[]
    var entryLineNumbers: int32[]
    var entryCallTargets: str[]
    var entryArgsTrims: str[]
    var entryNext: int32[]
    for i in 0..<n:
        let stmt = fnIr.statements[i]
        let argsTrim = chengpath.PathTrim(stmt.callArgsText)
        let bucket = LoweringCallTargetDuplicateKeyBucket(stmt.sourcePath, stmt.lineNumber,
                                                          stmt.callTarget, argsTrim, bucketCount)
        var hashFound = false
        var e = bucketHeads[bucket]
        while e >= 0:
            if entryLineNumbers[e] == stmt.lineNumber &&
               entryCallTargets[e] == stmt.callTarget &&
               entrySourcePaths[e] == stmt.sourcePath &&
               entryArgsTrims[e] == argsTrim:
                hashFound = true
                break
            e = entryNext[e]
        # PERF-6B: O(1) 期望 mirror 查询 (键 = callCallee 臂)
        var mirrorDup = false
        if stmt.kind == texpr.TypedExprIrStmtLocalDecl && stmt.callTarget != "":
            let mirBucket = LoweringCallTargetDuplicateKeyBucket(stmt.sourcePath, stmt.lineNumber,
                                                                 stmt.callCallee, argsTrim, bucketCount)
            var me = mirBucketHeads[mirBucket]
            while me >= 0:
                if mirLineNumbers[me] == stmt.lineNumber &&
                   mirCallees[me] == stmt.callCallee &&
                   mirSourcePaths[me] == stmt.sourcePath &&
                   mirArgsTrims[me] == argsTrim:
                    mirrorDup = true
                    break
                me = mirNext[me]
        out.flags[i] = hashFound || mirrorDup
        if !hashFound && LoweringStatementCarriesCallTarget(stmt):
            loweringSequenceAllocatorAdd(
                out.allocatorLedger,
                entrySourcePaths,
                stmt.sourcePath,
                sizeof(str))
            loweringSequenceAllocatorAdd(
                out.allocatorLedger,
                entryLineNumbers,
                stmt.lineNumber,
                sizeof(int32))
            loweringSequenceAllocatorAdd(
                out.allocatorLedger,
                entryCallTargets,
                stmt.callTarget,
                sizeof(str))
            loweringSequenceAllocatorAdd(
                out.allocatorLedger,
                entryArgsTrims,
                argsTrim,
                sizeof(str))
            loweringSequenceAllocatorAdd(
                out.allocatorLedger,
                entryNext,
                bucketHeads[bucket],
                sizeof(int32))
            bucketHeads[bucket] = entrySourcePaths.len - 1
    let _ = loweringSequenceAllocatorRelease(
        out.allocatorLedger, mirBucketHeads, sizeof(int32))
    let _ = loweringSequenceAllocatorRelease(
        out.allocatorLedger, mirSourcePaths, sizeof(str))
    let _ = loweringSequenceAllocatorRelease(
        out.allocatorLedger, mirLineNumbers, sizeof(int32))
    let _ = loweringSequenceAllocatorRelease(
        out.allocatorLedger, mirCallees, sizeof(str))
    let _ = loweringSequenceAllocatorRelease(
        out.allocatorLedger, mirArgsTrims, sizeof(str))
    let _ = loweringSequenceAllocatorRelease(
        out.allocatorLedger, mirNext, sizeof(int32))
    let _ = loweringSequenceAllocatorRelease(
        out.allocatorLedger, bucketHeads, sizeof(int32))
    let _ = loweringSequenceAllocatorRelease(
        out.allocatorLedger, entrySourcePaths, sizeof(str))
    let _ = loweringSequenceAllocatorRelease(
        out.allocatorLedger, entryLineNumbers, sizeof(int32))
    let _ = loweringSequenceAllocatorRelease(
        out.allocatorLedger, entryCallTargets, sizeof(str))
    let _ = loweringSequenceAllocatorRelease(
        out.allocatorLedger, entryArgsTrims, sizeof(str))
    let _ = loweringSequenceAllocatorRelease(
        out.allocatorLedger, entryNext, sizeof(int32))
    return out

fn LoweringStatementCallTargetDuplicateFlagsOwnerReleaseWithAllocatorReceipt(
        owner: var LoweringStatementCallTargetDuplicateFlagsOwner,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if owner.allocatorLedger.closed:
        panic("lowering duplicate flags allocator: duplicate release")
    if owner.flags.cap > 0:
        receipt.terminalRetainedBufferCount = 1
        receipt.terminalRetainedBytes =
            int64(owner.flags.cap) * int64(sizeof(bool))
    if owner.allocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       owner.allocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering duplicate flags allocator: allocator/retained drift")
    let releasedBytes = loweringSequenceAllocatorRelease(
        owner.allocatorLedger,
        owner.flags,
        sizeof(bool))
    owner.allocatorLedger.closed = true
    receipt.allocationEventCount =
        owner.allocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        owner.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        owner.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        owner.allocatorLedger.releasedCapacityBytes
    if releasedBytes > int64(0):
        receipt.terminalReleasedBufferCount = 1
        receipt.terminalReleasedBytes = releasedBytes
    receipt.liveAllocationCount =
        owner.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        owner.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        owner.flags.len == 0 &&
        owner.flags.cap == 0 &&
        owner.flags.buffer == nil
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering duplicate flags allocator: receipt incomplete")
    owner = LoweringStatementCallTargetDuplicateFlagsOwner()

fn LoweringStatementCallTargetDuplicateFlagsOwnerRelease(
        owner: var LoweringStatementCallTargetDuplicateFlagsOwner) =
    var receipt: LoweringSequenceAllocatorReceipt
    LoweringStatementCallTargetDuplicateFlagsOwnerReleaseWithAllocatorReceipt(
        owner, receipt)

fn LoweringStatementCallTargetCount(fnIr: var PrimaryObjectIrFunction): int32 =
    var count: int32
    var dupOwner = LoweringComputeStatementCallTargetDuplicateFlags(fnIr)
    for stmtIndex in 0..<fnIr.statements.len:
        if LoweringStatementCarriesCallTarget(fnIr.statements[stmtIndex]) &&
           !dupOwner.flags[stmtIndex]:
            count = count + 1
    LoweringStatementCallTargetDuplicateFlagsOwnerRelease(dupOwner)
    return count

# if/elif 语句本身从不在 LoweringStatementCarriesCallTarget 白名单内 (kind=If/Elif
# 不是 Call/LetCall/...)，故其条件文本里嵌套的真调用 (如 for 循环体内
# `if *(UInt8Ptr(cheng_ptr_plus(data, i))) == uint8(want):`) 从未被扫进
# fnIr.callTargets。primary_object_plan 侧一旦把该嵌套调用正确物化进
# bodyIR.callSequence(body-ir 有 call op)，callTargets 仍然缺这一项——
# 调用序列对账(missing_call_target)按位比对时找不到期望项，只能退到
# 按名全局搜索(AnyUnique)，对非 whitelist 运行时符号(如 cheng_ptr_plus)
# 该搜索失败即报 not_ready。用已有的嵌入文本扫描器(同 call-args 里嵌套调用
# 扫描同款)补扫 if/elif 条件文本，使 callTargets 与 body-ir 调用序列对齐。
@borrows
fn LoweringStatementConditionHasCallSurface(stmt: PrimaryObjectIrStatement): bool =
    if stmt.kind != texpr.TypedExprIrStmtIf && stmt.kind != texpr.TypedExprIrStmtElif:
        return false
    # 严格限定到指针解引用 cast 形 (`*(UInt8Ptr(...))` / `*(Int32Ptr(...))` 等)：
    # 这是 primary_object_plan 侧 ConditionOperandSlot 新增分支唯一会真正合成调用
    # 的形态。任意含 `(` 就判定 (如 `IsErr(r)`/`FileOpenMode(...)`) 会把这些既有
    # 专用识别路径处理的构造也强行登记进 callTargets，与 body-ir 实际调用序列错位
    # → 引入新的 missing_call_target 假阳性 (实测 rbytes/s4dbg/rerr 回归)。
    return parser.ParserFindText(stmt.surfaceText, "*(UInt8Ptr(") >= 0 ||
           parser.ParserFindText(stmt.surfaceText, "*(Int32Ptr(") >= 0 ||
           parser.ParserFindText(stmt.surfaceText, "*(UInt32Ptr(") >= 0 ||
           parser.ParserFindText(stmt.surfaceText, "*(UInt64Ptr(") >= 0 ||
           parser.ParserFindText(stmt.surfaceText, "*(Int64Ptr(") >= 0

# T50: decl/assign RHS 是复合表达式 (`A + call()`/`call() - 1`/三元条件里嵌
# 一个 call) 时, LoweringStatementCarriesCallTarget 判定该语句"不是调用"
# (stmt.callTarget 为空, kind 停留在裸 LocalDecl/Assign), 调用永不进
# fnIr.callTargets。body-ir 侧 node-eval 正确把嵌入调用建成真 call op
# (bodyIrCallCount 因此比 callTargets.len 多 1), 二者 4 路对账在
# PrimaryObjectPlanExpandIrCallTargets 里判 missing_call_sequence not_ready
# (cheng_mem_block_release/cheng_mem_release_locked/
# cheng_panic_cstring_and_exit_export 三例实测同源: 首条语句分别是
# `let total = int64(sizeof(X)) + int64(call(h))` /
# `let rcAfter = call(h) - 1` / 三元 `cond ? call(h) : lit`)。
# 用已有的嵌入文本扫描器(同 if/elif 条件文本扫描同款, 已内建 pure-cast/
# fn-ptr-binding/alias 过滤, 不会误登记类型 cast) 补扫 decl/assign 的
# surfaceText (RHS 原文, 见 TypedExprIrAddLocalDeclStatement 的
# stmt.surfaceText = rhsText); callTarget 非空的语句(裸调用/已被上面分支
# 接管)不重复扫描。
@borrows
fn LoweringStatementDeclRhsHasEmbeddedCallSurface(stmt: PrimaryObjectIrStatement): bool =
    if stmt.kind != texpr.TypedExprIrStmtLocalDecl && stmt.kind != texpr.TypedExprIrStmtAssign:
        return false
    if len(stmt.callTarget) > 0:
        return false
    return parser.ParserFindText(stmt.surfaceText, "(") >= 0

# 与 LoweringStatementCallTargetDuplicateEarlier 同款但键换成
# (sourcePath,lineNumber,surfaceText): decl/assign 复合 RHS 语句自身
# callTarget 为空, 前者的 CarriesCallTarget 前置守卫对它们恒假, 不能复用；
# 同一源行若在 fnIr.statements 里出现两条一致 surfaceText 的记录 (统计口径
# 上游的重复登记), 只让最早一条驱动嵌入扫描, 避免同一嵌入调用被计两次。
fn LoweringStatementSurfaceTextDuplicateEarlier(fnIr: var PrimaryObjectIrFunction,
                                                 stmtIndex: int32): bool =
    if stmtIndex <= 0 || stmtIndex >= fnIr.statements.len:
        return false
    let stmt = fnIr.statements[stmtIndex]
    for prevIndex in 0..<stmtIndex:
        let prev = fnIr.statements[prevIndex]
        if prev.sourcePath == stmt.sourcePath &&
           prev.lineNumber == stmt.lineNumber &&
           prev.surfaceText == stmt.surfaceText:
            return true
    return false

# T50 回归修订：镜像 primary_object_plan.cheng 对应逻辑。
# PrimaryBodyIrIndirectCallIntrinsic 的完整名单 (cheng_call_ptr_i32_raw /
# cheng_call_ptr_void_raw)。这两个名字是纯寄存器间接调用内在指令——全树无任何
# fn/@importc 声明 (body-IR 侧 x86_64_body_emit.cheng 按 call.targetSymbol
# 字面量直接内联发射, primary_object_plan.cheng 四处 PrimaryBodyIrIndirectCallIntrinsic
# 判定点也只把它当"无需 reloc 的寄存器间接调用"处理, 不当成可解析的普通调用目标)。
# 上面新增的 decl/assign 内嵌扫描分支复用 LoweringAppendPrimaryObjectIrEmbeddedCallTargetsFromText
# 把 program_support_backend.cheng:494 的 `let _ = cheng_call_ptr_void_raw(fn_ptr, ctx)`
# 误登记进 fnIr.callTargets, 而该调用从未在 body-IR 侧形成可被 4 路对账匹配的
# 普通 call op (实测 lowering_calls=1 body_ir_calls=0 missing_call_target,
# line=493) —— __cheng_call_indirect_void_export 是 provider 模块的永远可达
# 导出根, 命中即 --link-providers 构建全灭。
@borrows
fn LoweringCallHeadIsIndirectCallIntrinsic(callHead: str): bool =
    return callHead == "cheng_call_ptr_i32_raw" || callHead == "cheng_call_ptr_void_raw"

# 只在新增的 decl/assign 内嵌扫描分支调用: 把 [fromIndex, fnIr.callTargets.len)
# 区间内匹配 LoweringCallHeadIsIndirectCallIntrinsic 的条目原地剔除 (5 路并行
# 数组同步), 恢复"这两个名字从不进 callTargets"的既有不变式——既有两条腿
# (LoweringStatementCarriesCallTarget 整句调用 / if-elif 条件内嵌扫描) 从未
# 在 fnIr.statements 里以这个形态遇到过这两个名字 (program_support_backend.cheng
# 的两处真实调用都被更上游的 runtime_call_indirect_{i32,void}_bridge 专用识别器
# 接管、从不落到这两条既有腿; 全树 grep 亦无第三处), 因此本函数不改动它们的
# 行为, 只对本文件本次新增的分支生效。
fn LoweringRemoveIndirectCallIntrinsicTargetsFromIndex(fnIr: var PrimaryObjectIrFunction,
                                                         fromIndex: int32) =
    if !LoweringPrimaryObjectIrCallTargetShapeComplete(fnIr) ||
       !loweringPrimaryObjectIrCallTargetAllocatorMatches(fnIr):
        panic("lowering primary object call target: indirect filter shape drift")
    if fromIndex < 0 || fromIndex >= fnIr.callTargets.len:
        return
    var candidate: PrimaryObjectIrFunction
    for i in 0..<fromIndex:
        loweringPrimaryObjectIrCallTargetAppendSharedRowAt(
            candidate, fnIr, i)
    for i in fromIndex..<fnIr.callTargets.len:
        if LoweringCallHeadIsIndirectCallIntrinsic(fnIr.callTargets[i]):
            continue
        loweringPrimaryObjectIrCallTargetAppendSharedRowAt(
            candidate, fnIr, i)
    loweringPrimaryObjectIrCallTargetCommitRebuild(fnIr, candidate)

@borrows
fn LoweringFillGeneralCfgCallSequenceFromStatements(fnIr: var PrimaryObjectIrFunction,
                                                     plan: LoweringPlanStub,
                                                     sourceTexts: texpr.TypedExprSourceText[]) =
    let statementCallTargetCount = LoweringStatementCallTargetCount(fnIr)
    var hasConditionEmbeddedCall = false
    for condScanIndex in 0..<fnIr.statements.len:
        if LoweringStatementConditionHasCallSurface(fnIr.statements[condScanIndex]):
            hasConditionEmbeddedCall = true
            break
    var hasDeclEmbeddedCall = false
    for declScanIndex in 0..<fnIr.statements.len:
        if LoweringStatementDeclRhsHasEmbeddedCallSurface(fnIr.statements[declScanIndex]):
            hasDeclEmbeddedCall = true
            break
    if statementCallTargetCount <= 0 && !hasConditionEmbeddedCall && !hasDeclEmbeddedCall:
        return
    if fnIr.callTargets.len > 0 && fnIr.callTargets.len >= statementCallTargetCount:
        return
    if fnIr.callTargets.len > 0:
        LoweringPrimaryObjectIrCallTargetClear(fnIr)
        fnIr.bodyKind = texpr.BodyKindStatementSequence
    var dupOwner = LoweringComputeStatementCallTargetDuplicateFlags(fnIr)
    for stmtIndex in 0..<fnIr.statements.len:
        let stmt = fnIr.statements[stmtIndex]
        if LoweringStatementCarriesCallTarget(stmt) &&
           !dupOwner.flags[stmtIndex]:
            LoweringAppendPrimaryObjectIrCallTarget(fnIr, stmt, plan, sourceTexts)
        elif LoweringStatementConditionHasCallSurface(stmt):
            let conditionSurfaceText = strings.CloneStr(stmt.surfaceText)
            LoweringAppendPrimaryObjectIrEmbeddedCallTargetsFromText(fnIr, plan, sourceTexts, conditionSurfaceText)
        elif LoweringStatementDeclRhsHasEmbeddedCallSurface(stmt) &&
             !LoweringStatementSurfaceTextDuplicateEarlier(fnIr, stmtIndex):
            let declEmbeddedCallBaseIndex = fnIr.callTargets.len
            let declSurfaceText = strings.CloneStr(stmt.surfaceText)
            LoweringAppendPrimaryObjectIrEmbeddedCallTargetsFromText(fnIr, plan, sourceTexts, declSurfaceText)
            LoweringRemoveIndirectCallIntrinsicTargetsFromIndex(fnIr, declEmbeddedCallBaseIndex)
    LoweringStatementCallTargetDuplicateFlagsOwnerRelease(dupOwner)

@borrows
fn LoweringAppendPrimaryObjectIrCallTargetFields(fnIr: var PrimaryObjectIrFunction,
                                                  callArgCount: int32,
                                                  callTarget: str,
                                                  callTargetSourcePath: str,
                                                  callTargetSignatureLineNumber: int32,
                                                  callTargetImportc: bool,
                                                  callImportcSymbol: str) =
    if callTarget == "len":
        return
    if callTarget == "assert":
        return
    if LoweringReachabilityCallHeadIsPureCast(callTarget):
        return
    if callTarget == "range":
        return
    if callTarget == "Range":
        return
    if callTarget == "bytesLen":
        return
    if callTarget == "BytesLen":
        return
    if callTarget == "sizeof":
        return
    if callTarget == "SizeOf":
        return
    # ErrorInfoOf[T](r) is a pure err-subaggregate projection intrinsic, not a
    # call: excluding it keeps its uninstantiated generic template off the
    # reachability frontier (the template has no loweable body).
    if texpr.TypedExprQualifiedCallLeaf(callTarget) == "ErrorInfoOf":
        return
    # 本 helper 的调用方 (嵌入式文本扫描出的嵌套调用 / 编译器内部合成桥接调用) 均
    # 无可靠的实参静态类型可传, 留 "" (gapB 过滤器视为未知, 不过滤, 维持原语义)。
    LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr,
        callArgCount,
        callTarget,
        callTargetSourcePath,
        callTargetSignatureLineNumber,
        callTargetImportc,
        -1,
        callImportcSymbol,
        "")

@borrows
fn LoweringFactCallTargetSourcePath(plan: LoweringPlanStub,
                                     functionSourcePath: str,
                                     fact: ccsg.TypedExprFact): str =
    if len(fact.callTargetSourcePath) > 0:
        return fact.callTargetSourcePath
    if len(fact.callQualifier) > 0:
        var importedSourcePath = LoweringTypedIrImportAliasTargetSourcePath(plan.typedIr,
                                                                            functionSourcePath,
                                                                            fact.callQualifier)
        if len(importedSourcePath) <= 0:
            importedSourcePath =
                loweringPlanQualifiedImportTargetSourcePathFrozen(
                    plan,
                    functionSourcePath,
                    fact.callQualifier)
        if len(importedSourcePath) > 0:
            return importedSourcePath
        return ""
    let unqualifiedImportedSourcePath =
        loweringPlanUnqualifiedImportTargetSourcePathFrozen(
            plan,
            functionSourcePath,
            fact.callTarget)
    if unqualifiedImportedSourcePath != "":
        return unqualifiedImportedSourcePath
    return functionSourcePath

# gapB: ccsg.TypedExprFact (C5 SoA 快照重建载体) 没有 callArgTypesText 列
# (CompilerCsgSemanticResolvedCallTable 持久化 schema 本身未收录实参类型文本)。但
# fnIr.statements 里对应行号的 PrimaryObjectIrStatement 是本次全新前端构建的
# 产物, 其 callArgTypesText 已由 TypedExprIrCallArgTypesText 正确算出 (经
# LoweringPrimaryObjectIrStatementFromTyped 逐字段搬运), 按行号回查即得真值,
# 免于扩展共享持久化快照 schema。单函数内 statements 数量有界, 非全程序扫描,
# 不引入 O(N²)。
    # 同一行常有多条 statement 副本共存 (如 LetCall 与其伴生 Call 形态条目);
    # callArgTypesText 只在 TypedExprIrBindAssignStatementCallFact /
    # TypedExprIrPopulateAssignCallMeta (LetCall 路径) 里被算出并写入, 其余
    # 副本该字段留空。取首个非空值——按"哪条真算过"选, 非按数组序猜, 全部为空
    # 时 (无副本算过) 原样返回 "" (未知, 不臆造)。
fn LoweringStatementCallArgTypesTextAtLine(fnIr: var PrimaryObjectIrFunction,
                                            lineNumber: int32): str =
    if lineNumber <= 0:
        return ""
    for i in 0..<fnIr.statements.len:
        if fnIr.statements[i].lineNumber != lineNumber:
            continue
        if fnIr.statements[i].callArgTypesText != "":
            return fnIr.statements[i].callArgTypesText
    return ""

@borrows
fn LoweringAppendPrimaryObjectIrCallTargetFact(fnIr: var PrimaryObjectIrFunction,
                                                fact: ccsg.TypedExprFact,
                                                plan: LoweringPlanStub,
                                                sourceTexts: texpr.TypedExprSourceText[]) =
    if len(fact.callTarget) <= 0:
        return
    if LoweringPrimaryObjectIrFnPtrFieldCallForParserOrigin(
           fnIr, plan, fact.originParserNodeId):
        LoweringAppendPrimaryObjectIrEmbeddedCallTargetsFromText(
            fnIr, plan, sourceTexts, fact.callArgsText)
        return
    if LoweringPrimaryObjectIrCallTargetIsFnPtrBinding(fnIr, plan, sourceTexts, fact.callTarget):
        LoweringAppendPrimaryObjectIrEmbeddedCallTargetsFromText(fnIr,
                                                                 plan,
                                                                 sourceTexts,
                                                                 fact.callArgsText)
        return
    var callTargetSourcePath = LoweringFactCallTargetSourcePath(plan, fnIr.sourcePath, fact)
    var callTargetImportc = fact.callTargetImportc
    var importcSymbol = ""
    var importcSourcePath = share(callTargetSourcePath)
    if len(importcSourcePath) <= 0 && len(fact.callQualifier) <= 0:
        importcSourcePath = fnIr.sourcePath
    if LoweringFindImportcTargetSymbolTyped(plan.typedIr,
                                            sourceTexts,
                                            importcSourcePath,
                                            fact.callTarget,
                                            importcSymbol):
        callTargetImportc = true
        callTargetSourcePath = importcSourcePath
    elif fact.callTargetImportc:
        importcSymbol = LoweringImportcTargetSymbolTyped(plan.typedIr,
                                                         sourceTexts,
                                                         importcSourcePath,
                                                         fact.callTarget)
    if !callTargetImportc && len(callTargetSourcePath) <= 0 && len(fact.callQualifier) <= 0:
        callTargetSourcePath = fnIr.sourcePath
    let preAppendCount = fnIr.callTargets.len
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr,
                                                  fact.callArgCount,
                                                  fact.callTarget,
                                                  callTargetSourcePath,
                                                  fact.callTargetSignatureLineNumber,
                                                  callTargetImportc,
                                                  importcSymbol)
    if fnIr.callTargets.len > preAppendCount &&
       fnIr.callArgTypesTexts.len == fnIr.callTargets.len:
        fnIr.callArgTypesTexts[fnIr.callArgTypesTexts.len - 1] = LoweringStatementCallArgTypesTextAtLine(fnIr, fact.lineNumber)

@borrows
fn LoweringFillGeneralCfgCallSequenceFromSnapshot(fnIr: var PrimaryObjectIrFunction,
                                                   plan: LoweringPlanStub,
                                                   typedFnIndex: int32,
                                                   sourceTexts: texpr.TypedExprSourceText[]) =
    if typedFnIndex < 0 || typedFnIndex >= plan.typedIr.functions2_functionNameIds.len:
        return
    if fnIr.statements.len <= 0:
        return
    var firstLine: int32 = 2147483647
    var lastLine: int32
    for stmtIndex in 0..<fnIr.statements.len:
        let lineNumber = fnIr.statements[stmtIndex].lineNumber
        if lineNumber <= 0:
            continue
        if lineNumber < firstLine:
            firstLine = lineNumber
        if lineNumber > lastLine:
            lastLine = lineNumber
    if firstLine == 2147483647 || lastLine <= 0:
        return
    let typedFnSourceRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_sourcePathIds[typedFnIndex])
    if !IsOk(typedFnSourceRes):
        return
    let typedFnSourcePath = Value(typedFnSourceRes)
    let normalizedSource = parser.ParserNormalizePath(typedFnSourcePath)
    let factCallCount = LoweringResolvedCallFactCountInRange(plan,
                                                             normalizedSource,
                                                             firstLine,
                                                             lastLine)
    if factCallCount <= 0:
        return
    let statementCallTargetCount = LoweringStatementCallTargetCount(fnIr)
    if factCallCount <= statementCallTargetCount && fnIr.callTargets.len >= statementCallTargetCount:
        var needsImportedSourceResolution = false
        for callIndex in 0..<fnIr.callTargets.len:
            if callIndex >= fnIr.callTargetSourcePaths.len:
                continue
            let existingTarget = fnIr.callTargets[callIndex]
            if existingTarget == "" || existingTarget == "len" || existingTarget == "assert":
                continue
            let existingSourcePath = fnIr.callTargetSourcePaths[callIndex]
            if existingSourcePath != "" &&
               !LoweringSourcePathsEquivalent(existingSourcePath, fnIr.sourcePath):
                continue
            let importedSourcePath =
                loweringPlanUnqualifiedImportTargetSourcePathFrozen(
                    plan,
                    fnIr.sourcePath,
                    existingTarget)
            if importedSourcePath != "":
                needsImportedSourceResolution = true
                break
        if !needsImportedSourceResolution:
            return
    LoweringPrimaryObjectIrCallTargetClear(fnIr)
    fnIr.bodyKind = texpr.BodyKindStatementSequence
    LoweringAppendResolvedCallFactsInRange(fnIr,
                                           plan,
                                           sourceTexts,
                                           normalizedSource,
                                           firstLine,
                                           lastLine)

@borrows
fn LoweringReturnWholeCallIsTypeConstructor(fnIr: PrimaryObjectIrFunction,
                                             plan: LoweringPlanStub,
                                             typedFnIndex: int32,
                                             callHeadRaw: str,
                                             callTargetSourcePathRaw: str): bool =
    let callHead = chengpath.PathTrim(callHeadRaw)
    let leaf = texpr.TypedExprQualifiedCallLeaf(callHead)
    if leaf == "":
        return false
    if LoweringCallHeadIsNonExecutableTypeMaterialization(fnIr,
                                                           plan,
                                                           callHead,
                                                           callTargetSourcePathRaw):
        return true
    let fnReturnTypeRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_returnTypeIds[typedFnIndex])
    if !IsOk(fnReturnTypeRes):
        return false
    # form59 residual: hoist Value(Result[str]) before StripVarType
    let fnReturnType_f59: str = Value(fnReturnTypeRes)
    let returnType = texpr.TypedExprNormalizeTypeText(texpr.TypedExprStripVarType(fnReturnType_f59))
    if returnType == "":
        return false
    if texpr.TypedExprTypeLeafName(returnType) != leaf:
        return false
    var returnSizeBytes: int32
    var returnAlignBytes: int32
    var returnFieldCount: int32
    if !texpr.TypedExprIrLookupTypeLayout(plan.typedIr,
                                          fnIr.sourcePath,
                                          returnType,
                                          returnSizeBytes,
                                          returnAlignBytes,
                                          returnFieldCount):
        return false
    if returnFieldCount <= 0:
        return false
    var ctorSizeBytes: int32
    var ctorAlignBytes: int32
    var ctorFieldCount: int32
    if !texpr.TypedExprIrLookupTypeLayout(plan.typedIr,
                                          callTargetSourcePathRaw,
                                          leaf,
                                          ctorSizeBytes,
                                          ctorAlignBytes,
                                          ctorFieldCount):
        return false
    if ctorFieldCount <= 0:
        return false
    if returnSizeBytes != ctorSizeBytes:
        return false
    if returnAlignBytes != ctorAlignBytes:
        return false
    return returnFieldCount == ctorFieldCount

# gapB: "return 整调用" 模板 (LoweringFillReturnWholeCallSequenceFromTypedFunction)
# 走原始 returnExpr 文本, 无 fnIr.statements 可回查 (整个函数体就是这一个 return
# 表达式, 不落一条独立 statement)。但调用实参在此形态下绝大多数是"直接转发自身
# 形参"(如 `fn f(c: T[]): R = return g(c)`), 该实参的类型恰是 fnIr.paramTypes 里
# 已知的本函数形参类型——按名匹配复用, 不臆造。非裸形参引用 (字面量/复杂表达式)
# 仍留空 (未知, 不过滤)。
fn LoweringReturnWholeCallArgTypesText(fnIr: var PrimaryObjectIrFunction,
                                        callArgsText: str): str =
    let argTexts = LoweringCallArgNames(callArgsText)
    var out = ""
    for i in 0..<argTexts.len:
        var argType = ""
        for p in 0..<fnIr.paramNames.len:
            if fnIr.paramNames[p] == argTexts[i]:
                argType = fnIr.paramTypes[p]
                break
        if i > 0:
            out = strutil.Join([out, ","], "")
        out = strutil.Join([out, argType], "")
    return out

@borrows
fn LoweringFillReturnWholeCallSequenceFromTypedFunction(fnIr: var PrimaryObjectIrFunction,
                                                         plan: LoweringPlanStub,
                                                         typedFnIndex: int32,
                                                         sourceTexts: texpr.TypedExprSourceText[]) =
    if fnIr.callTargets.len > 0:
        return
    if typedFnIndex < 0 || typedFnIndex >= plan.typedIr.functions2_functionNameIds.len:
        return
    let fnReturnExprRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_returnExprIds[typedFnIndex])
    if !IsOk(fnReturnExprRes):
        return
    let returnExpr = chengpath.PathTrim(Value(fnReturnExprRes))
    let callHead = LoweringReachabilityCallHeadFromWholeCall(returnExpr)
    if callHead == "":
        return
    if LoweringReachabilityCallHeadIsPureCast(callHead):
        return
    let openPos = texpr.TypedExprFindWholeCallOpenParen(returnExpr)
    let closePos = texpr.TypedExprFindMatchingParen(returnExpr, openPos)
    if openPos <= 0 || closePos <= openPos || closePos + 1 != len(returnExpr):
        return
    let callArgsText = chengpath.PathTrim(chengpath.TextSlice(returnExpr,
                                                             openPos + 1,
                                                             closePos - openPos - 1))
    let callArgCount = LoweringCallArgNames(callArgsText).len
    let returnNodeIndex = arenamod.ArenaArrayInt32Get(
        plan.typedIr.arena,
        plan.typedIr.functions2_returnNodeIndexs,
        typedFnIndex)
    if LoweringPrimaryObjectIrCallTargetIsFnPtrFieldCall(
           plan, returnNodeIndex):
        LoweringAppendPrimaryObjectIrEmbeddedCallTargetsFromText(
            fnIr, plan, sourceTexts, callArgsText)
        return
    if LoweringPrimaryObjectIrCallTargetIsFnPtrBinding(fnIr, plan, sourceTexts, callHead):
        LoweringAppendPrimaryObjectIrEmbeddedCallTargetsFromText(fnIr,
                                                                 plan,
                                                                 sourceTexts,
                                                                 callArgsText)
        return
    let qualifier = texpr.TypedExprQualifiedCallQualifier(callHead)
    let leaf = texpr.TypedExprQualifiedCallLeaf(callHead)
    if leaf == "":
        return
    # Ok[T](v)/Err[T](msg) 构造内征：return 整调用是 Result 构造，经节点求值器
    # AppendResultConstruct 内联物化、body-IR 无 call op；登记为返回整调用序列会
    # 让调用序列含 Ok 而 body 不含 → missing_call_target。跳过（与 IsTypeConstructor
    # 同类返回）。
    if leaf == "Ok" || leaf == "Err":
        return
    var callTargetSourcePath = ""
    if qualifier != "":
        callTargetSourcePath = LoweringTypedIrImportAliasTargetSourcePath(plan.typedIr,
                                                                          fnIr.sourcePath,
                                                                          qualifier)
        if callTargetSourcePath == "":
            callTargetSourcePath =
                loweringPlanQualifiedImportTargetSourcePathFrozen(
                    plan,
                    fnIr.sourcePath,
                    qualifier)
    if callTargetSourcePath == "" && qualifier == "":
        callTargetSourcePath =
            loweringPlanUnqualifiedImportTargetSourcePathFrozen(
                plan,
                fnIr.sourcePath,
                leaf)
    if callTargetSourcePath == "" && qualifier == "":
        callTargetSourcePath = fnIr.sourcePath
    if LoweringReturnWholeCallIsTypeConstructor(fnIr,
                                                plan,
                                                typedFnIndex,
                                                callHead,
                                                callTargetSourcePath):
        return
    var callTargetImportc = false
    var importcSymbol = ""
    if LoweringFindImportcTargetSymbolTyped(plan.typedIr,
                                            sourceTexts,
                                            callTargetSourcePath,
                                            leaf,
                                            importcSymbol):
        callTargetImportc = true
    let preAppendCount = fnIr.callTargets.len
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr,
                                                  callArgCount,
                                                  leaf,
                                                  callTargetSourcePath,
                                                  0,
                                                  callTargetImportc,
                                                  importcSymbol)
    if fnIr.callTargets.len > preAppendCount &&
       fnIr.callArgTypesTexts.len == fnIr.callTargets.len:
        fnIr.callArgTypesTexts[fnIr.callArgTypesTexts.len - 1] = LoweringReturnWholeCallArgTypesText(fnIr, callArgsText)

@borrows
fn LoweringRemoveBuiltinCallTargets(fnIr: var PrimaryObjectIrFunction,
                                     plan: LoweringPlanStub,
                                     sourceTexts: texpr.TypedExprSourceText[]) =
    if !LoweringPrimaryObjectIrCallTargetShapeComplete(fnIr) ||
       !loweringPrimaryObjectIrCallTargetAllocatorMatches(fnIr):
        panic("lowering primary object call target: builtin filter shape drift")
    var candidate: PrimaryObjectIrFunction
    for i in 0..<fnIr.callTargets.len:
        if fnIr.callTargets[i] == "len":
            continue
        if LoweringReachabilityCallHeadIsPureCast(fnIr.callTargets[i]):
            continue
        if fnIr.callTargets[i] == "range" || fnIr.callTargets[i] == "Range":
            continue
        if fnIr.callTargets[i] == "bytesLen" || fnIr.callTargets[i] == "BytesLen":
            continue
        if fnIr.callTargets[i] == "sizeof" || fnIr.callTargets[i] == "SizeOf":
            continue
        # Ok[T](v)/Err[T](msg) 构造内征经 AppendResultConstruct 内联物化、body-IR 无
        # call op；任何 builder 误登记的 Ok/Err 在此随 builtin 一并移除并重对齐 ordinal，
        # 使 callTargets 与 body-IR 调用序列一致（汇聚点兜底）。
        if LoweringCallTargetIsResultConstruct(fnIr.callTargets[i]):
            continue
        if LoweringPrimaryObjectIrCallTargetIsFnPtrBinding(fnIr, plan, sourceTexts, fnIr.callTargets[i]):
            continue
        loweringPrimaryObjectIrCallTargetAppendSharedRowAt(
            candidate, fnIr, i)
    loweringPrimaryObjectIrCallTargetCommitRebuild(fnIr, candidate)

@borrows
fn LoweringCanonicalSourcePath(workspaceRoot: str,
                                sourcePathRaw: str): str =
    let sourcePathInput = parser.ParserOwnedText(sourcePathRaw)
    let sourcePath = parser.ParserNormalizePath(sourcePathInput)
    if sourcePath == "":
        return ""
    if chengpath.PathIsAbsolute(sourcePath):
        return sourcePath
    let rooted = chengpath.PathRootedAbsolute(
        parser.ParserOwnedText(workspaceRoot), sourcePath)
    if rooted != "":
        return parser.ParserNormalizePath(rooted)
    return sourcePath

fn LoweringMaybeFillBackendDriverRunCommand(fnIr: var PrimaryObjectIrFunction) =
    var tailName = LoweringFunctionTailName(fnIr.functionName)
    if tailName != "BackendDriverDispatchMinRunCommand" &&
       tailName != "BackendDriverDispatchMinRun":
        return
    fnIr.bodyKind = texpr.BodyKindStatementSequence
    LoweringPrimaryObjectIrCallTargetClear(fnIr)
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr,
                                                  0,
                                                  "ParamCount",
                                                  "",
                                                  0,
                                                  true,
                                                  "paramCount")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr,
                                                  0,
                                                  "BackendDriverDispatchMinHelp",
                                                  fnIr.sourcePath,
                                                  0,
                                                  false,
                                                  "")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr,
                                                  1,
                                                  "ParamStr",
                                                  "",
                                                  0,
                                                  true,
                                                  "__cheng_rt_paramStrCopyBridge")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr,
                                                  1,
                                                  "BackendDriverDispatchMinRunCommandWithCmd",
                                                  fnIr.sourcePath,
                                                  0,
                                                  false,
                                                  "")

fn LoweringMaybeFillBackendDriverRunCommandWithCmd(fnIr: var PrimaryObjectIrFunction) =
    let tailName = LoweringFunctionTailName(fnIr.functionName)
    if tailName != "BackendDriverDispatchMinRunCommandWithCmd":
        return
    fnIr.bodyKind = texpr.BodyKindStatementSequence
    LoweringPrimaryObjectIrCallTargetClear(fnIr)
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr, 1, "BackendDriverDispatchMinCommandCode", fnIr.sourcePath, 0, false, "")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr, 0, "BackendDriverDispatchMinHelp", fnIr.sourcePath, 0, false, "")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr, 0, "BackendDriverDispatchMinStatusFromCmdline", fnIr.sourcePath, 0, false, "")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr, 0, "BackendDriverDispatchMinPrintBuildPlanCommandFromCmdline", fnIr.sourcePath, 0, false, "")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr, 0, "BackendDriverDispatchMinVerifyExportVisibilityFromCmdline", fnIr.sourcePath, 0, false, "")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr, 0, "BackendDriverDispatchMinVerifyExportVisibilityParallelFromCmdline", fnIr.sourcePath, 0, false, "")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr, 0, "BackendDriverDispatchMinRunSystemLinkExecFromCmdline", fnIr.sourcePath, 0, false, "")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr, 0, "BackendDriverDispatchMinRunHostSmokesFromCmdline", fnIr.sourcePath, 0, false, "")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr, 0, "BackendDriverDispatchMinRunDebugReportFromCmdline", fnIr.sourcePath, 0, false, "")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr, 0, "BackendDriverDispatchMinRunPrintSymbolsFromCmdline", fnIr.sourcePath, 0, false, "")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr, 0, "BackendDriverDispatchMinRunPrintLineMapFromCmdline", fnIr.sourcePath, 0, false, "")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr, 0, "BackendDriverDispatchMinRunProfileRunFromCmdline", fnIr.sourcePath, 0, false, "")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr, 0, "BackendDriverDispatchMinRunProfileReportFromCmdline", fnIr.sourcePath, 0, false, "")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr, 0, "BackendDriverDispatchMinRunCrashReportFromCmdline", fnIr.sourcePath, 0, false, "")
    LoweringAppendPrimaryObjectIrCallTargetFields(fnIr, 0, "BackendDriverDispatchMinRunDryCompileConcreteFields", fnIr.sourcePath, 0, false, "")

fn LoweringMaybeFillBackendDriverPrintBridge(fnIr: var PrimaryObjectIrFunction) =
    let tailName = LoweringFunctionTailName(fnIr.functionName)
    if tailName == "BackendDriverDispatchMinPrintLine":
        fnIr.bodyKind = texpr.BodyKindReturnCallArg0I32
        LoweringPrimaryObjectIrCallTargetClear(fnIr)
        LoweringAppendPrimaryObjectIrCallTargetFields(fnIr,
                                                      1,
                                                      "BackendDriverDispatchMinStdoutLineReturn2Bridge",
                                                      fnIr.sourcePath,
                                                      0,
                                                      true,
                                                      "driver_c_stdout_line_return2_bridge")
        return
    if tailName == "BackendDriverDispatchMinPrintErr":
        fnIr.bodyKind = texpr.BodyKindReturnCallArg0I32
        LoweringPrimaryObjectIrCallTargetClear(fnIr)
        LoweringAppendPrimaryObjectIrCallTargetFields(fnIr,
                                                      1,
                                                      "BackendDriverDispatchMinStderrLineReturn2Bridge",
                                                      fnIr.sourcePath,
                                                      0,
                                                      true,
                                                      "driver_c_stderr_line_return2_bridge")

@borrows
fn LoweringModuleSourceIndexBucket(modulePath: str,
                                    bucketCount: int32): int32 =
    if modulePath == "" || bucketCount <= 0:
        return -1
    return parser.ParserTextLookupContentHash(modulePath) & (bucketCount - 1)

@borrows
fn LoweringModuleSourceIndexAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.moduleSourceIndexBucketHeads.cap > 0: count = count + 1
    if plan.moduleSourceIndexEntryNext.cap > 0: count = count + 1
    if plan.moduleSourceIndexModulePaths.cap > 0: count = count + 1
    if plan.moduleSourceIndexCanonicalSourcePaths.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringModuleSourceIndexAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(plan.moduleSourceIndexBucketHeads.cap) *
            int64(sizeof(int32)) +
        int64(plan.moduleSourceIndexEntryNext.cap) *
            int64(sizeof(int32)) +
        int64(plan.moduleSourceIndexModulePaths.cap) *
            int64(sizeof(str)) +
        int64(plan.moduleSourceIndexCanonicalSourcePaths.cap) *
            int64(sizeof(str))

fn LoweringModuleSourceIndexAppendBucket(
        plan: var LoweringPlanStub,
        bucketHead: int32) =
    loweringSequenceAllocatorAdd(
        plan.moduleSourceIndexAllocatorLedger,
        plan.moduleSourceIndexBucketHeads,
        bucketHead,
        sizeof(int32))

@borrows
fn LoweringModuleSourceIndexAppendRow(
        plan: var LoweringPlanStub,
        entryNext: int32,
        modulePath: str,
        canonicalSourcePath: str) =
    let rowCount = plan.moduleSourceIndexEntryNext.len
    if plan.moduleSourceIndexModulePaths.len != rowCount ||
       plan.moduleSourceIndexCanonicalSourcePaths.len != rowCount:
        panic("lowering module source index allocator: row shape drift")
    loweringSequenceAllocatorAdd(
        plan.moduleSourceIndexAllocatorLedger,
        plan.moduleSourceIndexEntryNext,
        entryNext,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.moduleSourceIndexAllocatorLedger,
        plan.moduleSourceIndexModulePaths,
        modulePath,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.moduleSourceIndexAllocatorLedger,
        plan.moduleSourceIndexCanonicalSourcePaths,
        canonicalSourcePath,
        sizeof(str))

fn loweringModuleSourceIndexAccumulateTerminalRelease(
        releasedBytes: int64,
        releasedBufferCount: var int32,
        totalReleasedBytes: var int64) =
    if releasedBytes > int64(0):
        releasedBufferCount = releasedBufferCount + 1
        totalReleasedBytes = totalReleasedBytes + releasedBytes

fn LoweringModuleSourceIndexAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.moduleSourceIndexAllocatorReceiptReady ||
       LoweringModuleSourceIndexAllocatorPhysicalBufferCount(plan) != 0 ||
       LoweringModuleSourceIndexAllocatorCapacityBytes(plan) != int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.moduleSourceIndexAllocatorReceipt):
        panic("lowering module source index allocator: begin before release")
    plan.moduleSourceIndexAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.moduleSourceIndexAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.moduleSourceIndexAllocatorReceiptReady = false

fn LoweringModuleSourceIndexAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.moduleSourceIndexAllocatorReceiptReady:
        if LoweringModuleSourceIndexAllocatorPhysicalBufferCount(plan) != 0 ||
           LoweringModuleSourceIndexAllocatorCapacityBytes(plan) != int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.moduleSourceIndexAllocatorReceipt):
            panic("lowering module source index allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringModuleSourceIndexAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringModuleSourceIndexAllocatorCapacityBytes(plan)
    if plan.moduleSourceIndexAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.moduleSourceIndexAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering module source index allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringModuleSourceIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.moduleSourceIndexAllocatorLedger,
            plan.moduleSourceIndexBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringModuleSourceIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.moduleSourceIndexAllocatorLedger,
            plan.moduleSourceIndexEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringModuleSourceIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.moduleSourceIndexAllocatorLedger,
            plan.moduleSourceIndexModulePaths,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringModuleSourceIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.moduleSourceIndexAllocatorLedger,
            plan.moduleSourceIndexCanonicalSourcePaths,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    plan.moduleSourceIndexAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.moduleSourceIndexAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.moduleSourceIndexAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.moduleSourceIndexAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.moduleSourceIndexAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.moduleSourceIndexAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.moduleSourceIndexAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringModuleSourceIndexAllocatorPhysicalBufferCount(plan) == 0 &&
        LoweringModuleSourceIndexAllocatorCapacityBytes(plan) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering module source index allocator: receipt incomplete")
    plan.moduleSourceIndexAllocatorReceipt = receipt
    plan.moduleSourceIndexAllocatorReceiptReady = true
    plan.moduleSourceIndexAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringPlanReleaseModuleSourceIndexPayload(plan: var LoweringPlanStub) =
    plan.moduleSourceIndexBuilt = false
    LoweringModuleSourceIndexAllocatorRelease(plan)

fn LoweringResetModuleSourceIndexCounters(plan: var LoweringPlanStub) =
    plan.moduleSourceIndexCompleted = false
    plan.moduleSourceIndexBuildSourceCount = 0
    plan.moduleSourceIndexBuildBucketVisitCount = 0
    plan.moduleSourceIndexLookupCount = 0
    plan.moduleSourceIndexLookupBucketVisitCount = 0
    plan.moduleSourceIndexLookupMaxBucketVisitCount = 0
    plan.moduleSourceIndexDuplicateModuleCount = 0
    plan.moduleSourceIndexSourceCountSnapshot = 0
    plan.moduleSourceIndexPeakCapacityEstimateBytes = Int64(0)
    plan.moduleSourceIndexCompositeKeyPayloadBytes = Int64(0)

# Per-row exact identity, mirroring the system link plan rule: in-root
# sources derive their exact module path; root-out sources have no module
# anchor and their canonical absolute source file path is the identity.
@borrows
fn LoweringSourcePathUnderRoot(path: str, root: str): bool =
    if root == "" || !parser.ParserSourceIdentityPathAbsolute(path):
        return false
    if root == "/":
        return true
    if path.len <= root.len:
        return false
    if chengpath.TextSlice(path, 0, root.len) != root:
        return false
    return path[root.len] == '/'

@borrows
fn LoweringSourcePathWithinRoots(
        plan: var LoweringPlanStub,
        externalPackageRoots: parser.ParserExternalPackageRoot[],
        canonicalSourcePath: str): bool =
    if LoweringSourcePathUnderRoot(canonicalSourcePath, plan.packageRoot) ||
       LoweringSourcePathUnderRoot(canonicalSourcePath, plan.workspaceRoot):
        return true
    for rootIndex in 0..<externalPackageRoots.len:
        if LoweringSourcePathUnderRoot(
                canonicalSourcePath,
                externalPackageRoots[rootIndex].packageRoot):
            return true
    return false

fn LoweringBuildModuleSourceIndex(
        plan: var LoweringPlanStub,
        sourceBundleOwner:
            var slplan.SystemLinkPlanSourceBundleOwner,
        err: var str): bool =
    slplan.SystemLinkPlanSourceBundleOwnerPayloadReadBorrowed(
        sourceBundleOwner)
    LoweringPlanReleaseModuleSourceIndexPayload(plan)
    LoweringModuleSourceIndexAllocatorBegin(plan)
    LoweringResetModuleSourceIndexCounters(plan)
    for rootOrdinal in 0..<
            sourceBundleOwner.externalRootRowIndexes.len:
        let rootIndex =
            slplan.SystemLinkPlanSourceBundleOwnerExternalRootRowAtBorrowed(
                sourceBundleOwner, rootOrdinal)
        if rootIndex < 0 ||
           rootIndex >= sourceBundleOwner.externalPackageRoots.len:
            err = Fmt" lowering plan: external root row out of range ordinal={rootOrdinal} row={rootIndex}"
            LoweringPlanReleaseModuleSourceIndexPayload(plan)
            return false
    let bucketCount = LoweringTypedFunctionIndexBucketCount(
        sourceBundleOwner.sourceRowIndexes.len)
    for _bucketIndex in 0..<bucketCount:
        LoweringModuleSourceIndexAppendBucket(plan, -1)
    for sourceOrdinal in 0..<sourceBundleOwner.sourceRowIndexes.len:
        let sourceIndex =
            slplan.SystemLinkPlanSourceBundleOwnerSourceRowAtBorrowed(
                sourceBundleOwner, sourceOrdinal)
        if sourceIndex < 0 ||
           sourceIndex >= sourceBundleOwner.sourceClosurePaths.len:
            err = Fmt" lowering plan: source row out of range ordinal={sourceOrdinal} row={sourceIndex}"
            LoweringPlanReleaseModuleSourceIndexPayload(plan)
            return false
        let moduleIndex =
            slplan.SystemLinkPlanSourceBundleOwnerModuleRowAtBorrowed(
                sourceBundleOwner, sourceOrdinal)
        if moduleIndex < 0 ||
           moduleIndex >= sourceBundleOwner.ownerModulePaths.len:
            err = Fmt" lowering plan: module row out of range ordinal={sourceOrdinal} row={moduleIndex}"
            LoweringPlanReleaseModuleSourceIndexPayload(plan)
            return false
        let canonicalSourcePath = LoweringCanonicalSourcePath(
            plan.workspaceRoot,
            sourceBundleOwner.sourceClosurePaths[sourceIndex])
        var modulePath: str
        if LoweringSourcePathWithinRoots(
                plan,
                sourceBundleOwner.externalPackageRoots,
                canonicalSourcePath):
            modulePath = chengpath.PathTrim(
                parser.ParserSourcePathToModulePathWithExternalPackageRoots(
                    plan.workspaceRoot,
                    plan.packageRoot,
                    sourceBundleOwner.externalPackageRoots,
                    canonicalSourcePath))
        else:
            modulePath = share(canonicalSourcePath)
        if modulePath !=
           sourceBundleOwner.ownerModulePaths[moduleIndex]:
            err = Fmt" lowering plan: module row identity mismatch source={canonicalSourcePath} expected={sourceBundleOwner.ownerModulePaths[moduleIndex]} actual={modulePath}"
            LoweringPlanReleaseModuleSourceIndexPayload(plan)
            return false
        let bucket = LoweringModuleSourceIndexBucket(
            modulePath,
            plan.moduleSourceIndexBucketHeads.len)
        if canonicalSourcePath == "" || modulePath == "" || bucket < 0:
            err = Fmt" lowering plan: module source identity invalid source={canonicalSourcePath} module={modulePath}"
            LoweringPlanReleaseModuleSourceIndexPayload(plan)
            return false
        var entryIndex = plan.moduleSourceIndexBucketHeads[bucket]
        var visitCount: int32
        while entryIndex >= 0:
            visitCount = visitCount + 1
            plan.moduleSourceIndexBuildBucketVisitCount =
                plan.moduleSourceIndexBuildBucketVisitCount + 1
            if visitCount > plan.moduleSourceIndexModulePaths.len ||
               entryIndex >= plan.moduleSourceIndexEntryNext.len ||
               entryIndex >= plan.moduleSourceIndexModulePaths.len ||
               entryIndex >= plan.moduleSourceIndexCanonicalSourcePaths.len:
                err = " lowering plan: module source index chain corrupt"
                LoweringPlanReleaseModuleSourceIndexPayload(plan)
                return false
            if plan.moduleSourceIndexModulePaths[entryIndex] == modulePath:
                plan.moduleSourceIndexDuplicateModuleCount =
                    plan.moduleSourceIndexDuplicateModuleCount + 1
                err = Fmt" lowering plan: duplicate module source identity module={modulePath} first={plan.moduleSourceIndexCanonicalSourcePaths[entryIndex]} second={canonicalSourcePath}"
                LoweringPlanReleaseModuleSourceIndexPayload(plan)
                return false
            entryIndex = plan.moduleSourceIndexEntryNext[entryIndex]
        let newEntryIndex = plan.moduleSourceIndexModulePaths.len
        LoweringModuleSourceIndexAppendRow(
            plan,
            plan.moduleSourceIndexBucketHeads[bucket],
            modulePath,
            canonicalSourcePath)
        plan.moduleSourceIndexBucketHeads[bucket] = newEntryIndex
        plan.moduleSourceIndexBuildSourceCount =
            plan.moduleSourceIndexBuildSourceCount + 1
    plan.moduleSourceIndexSourceCountSnapshot =
        plan.moduleSourceIndexModulePaths.len
    plan.moduleSourceIndexBuilt = true
    plan.moduleSourceIndexCompleted = true
    plan.moduleSourceIndexPeakCapacityEstimateBytes =
        LoweringModuleSourceIndexCapacityEstimateBytes(plan)
    return true

@borrows
fn LoweringModuleSourceIndexLookup(plan: var LoweringPlanStub,
                                    modulePathRaw: str,
                                    sourcePathOut: var str,
                                    err: var str): bool =
    sourcePathOut = ""
    let modulePath = chengpath.PathTrim(modulePathRaw)
    if !plan.moduleSourceIndexBuilt:
        err = " lowering plan: module source index not built"
        return false
    if plan.moduleSourceIndexEntryNext.len !=
           plan.moduleSourceIndexModulePaths.len ||
       plan.moduleSourceIndexCanonicalSourcePaths.len !=
           plan.moduleSourceIndexModulePaths.len:
        err = " lowering plan: module source index columns mismatch"
        return false
    plan.moduleSourceIndexLookupCount =
        plan.moduleSourceIndexLookupCount + 1
    let bucket = LoweringModuleSourceIndexBucket(
        modulePath,
        plan.moduleSourceIndexBucketHeads.len)
    if bucket < 0:
        err = Fmt" lowering plan: module source lookup invalid module={modulePath}"
        return false
    var entryIndex = plan.moduleSourceIndexBucketHeads[bucket]
    var visitCount: int32
    var matchCount: int32
    while entryIndex >= 0:
        visitCount = visitCount + 1
        plan.moduleSourceIndexLookupBucketVisitCount =
            plan.moduleSourceIndexLookupBucketVisitCount + 1
        if visitCount > plan.moduleSourceIndexModulePaths.len ||
           entryIndex >= plan.moduleSourceIndexEntryNext.len ||
           entryIndex >= plan.moduleSourceIndexModulePaths.len ||
           entryIndex >= plan.moduleSourceIndexCanonicalSourcePaths.len:
            err = " lowering plan: module source lookup chain corrupt"
            return false
        if plan.moduleSourceIndexModulePaths[entryIndex] == modulePath:
            matchCount = matchCount + 1
            sourcePathOut =
                plan.moduleSourceIndexCanonicalSourcePaths[entryIndex]
        entryIndex = plan.moduleSourceIndexEntryNext[entryIndex]
    if visitCount > plan.moduleSourceIndexLookupMaxBucketVisitCount:
        plan.moduleSourceIndexLookupMaxBucketVisitCount = visitCount
    if matchCount != 1:
        sourcePathOut = ""
        err = Fmt" lowering plan: module source match count module={modulePath} count={matchCount}"
        return false
    return true

@borrows
fn LoweringTypedFunctionIdentityBucket(sourceIndex: int32,
                                       functionName: str,
                                       declarationLineIndex: int32,
                                       bucketCount: int32): int32 =
    if sourceIndex < 0 || functionName == "" ||
       declarationLineIndex <= 0 || bucketCount <= 0:
        return -1
    var hash = parser.ParserTextLookupContentHash(functionName)
    hash = hash * 131 + sourceIndex + 1
    hash = hash * 131 + declarationLineIndex
    return hash & (bucketCount - 1)

@borrows
fn LoweringTypedFunctionIdentityAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.typedFunctionIdentitySourcePaths.cap > 0: count = count + 1
    if plan.typedFunctionIdentitySourceBucketHeads.cap > 0:
        count = count + 1
    if plan.typedFunctionIdentitySourceEntryNext.cap > 0:
        count = count + 1
    if plan.typedFunctionIdentityBucketHeads.cap > 0:
        count = count + 1
    if plan.typedFunctionIdentityEntryNext.cap > 0:
        count = count + 1
    if plan.typedFunctionIdentityEntrySourceIndexes.cap > 0:
        count = count + 1
    if plan.typedFunctionIdentityEntryNameIds.cap > 0:
        count = count + 1
    if plan.typedFunctionIdentityEntryDeclarationLines.cap > 0:
        count = count + 1
    if plan.typedFunctionIdentityEntryFunctionIndexes.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringTypedFunctionIdentityAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(plan.typedFunctionIdentitySourcePaths.cap) *
            int64(sizeof(str)) +
        int64(plan.typedFunctionIdentitySourceBucketHeads.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionIdentitySourceEntryNext.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionIdentityBucketHeads.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionIdentityEntryNext.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionIdentityEntrySourceIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionIdentityEntryNameIds.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionIdentityEntryDeclarationLines.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionIdentityEntryFunctionIndexes.cap) *
            int64(sizeof(int32))

fn LoweringTypedFunctionIdentityAppendBuckets(
        plan: var LoweringPlanStub,
        bucketHead: int32) =
    if plan.typedFunctionIdentitySourceBucketHeads.len !=
       plan.typedFunctionIdentityBucketHeads.len:
        panic("lowering typed function identity allocator: bucket shape drift")
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIdentityAllocatorLedger,
        plan.typedFunctionIdentitySourceBucketHeads,
        bucketHead,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIdentityAllocatorLedger,
        plan.typedFunctionIdentityBucketHeads,
        bucketHead,
        sizeof(int32))

@borrows
fn LoweringTypedFunctionIdentityAppendSourceRow(
        plan: var LoweringPlanStub,
        sourcePath: str,
        entryNext: int32) =
    if plan.typedFunctionIdentitySourcePaths.len !=
       plan.typedFunctionIdentitySourceEntryNext.len:
        panic("lowering typed function identity allocator: source row shape drift")
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIdentityAllocatorLedger,
        plan.typedFunctionIdentitySourcePaths,
        sourcePath,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIdentityAllocatorLedger,
        plan.typedFunctionIdentitySourceEntryNext,
        entryNext,
        sizeof(int32))

fn LoweringTypedFunctionIdentityAppendEntryRow(
        plan: var LoweringPlanStub,
        entryNext: int32,
        sourceIndex: int32,
        nameId: langintern.InternId,
        declarationLine: int32,
        functionIndex: int32) =
    let rowCount = plan.typedFunctionIdentityEntryFunctionIndexes.len
    if plan.typedFunctionIdentityEntryNext.len != rowCount ||
       plan.typedFunctionIdentityEntrySourceIndexes.len != rowCount ||
       plan.typedFunctionIdentityEntryNameIds.len != rowCount ||
       plan.typedFunctionIdentityEntryDeclarationLines.len != rowCount:
        panic("lowering typed function identity allocator: entry row shape drift")
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIdentityAllocatorLedger,
        plan.typedFunctionIdentityEntryNext,
        entryNext,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIdentityAllocatorLedger,
        plan.typedFunctionIdentityEntrySourceIndexes,
        sourceIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIdentityAllocatorLedger,
        plan.typedFunctionIdentityEntryNameIds,
        nameId,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIdentityAllocatorLedger,
        plan.typedFunctionIdentityEntryDeclarationLines,
        declarationLine,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIdentityAllocatorLedger,
        plan.typedFunctionIdentityEntryFunctionIndexes,
        functionIndex,
        sizeof(int32))

fn loweringTypedFunctionIdentityAccumulateTerminalRelease(
        releasedBytes: int64,
        releasedBufferCount: var int32,
        totalReleasedBytes: var int64) =
    if releasedBytes > int64(0):
        releasedBufferCount = releasedBufferCount + 1
        totalReleasedBytes = totalReleasedBytes + releasedBytes

fn LoweringTypedFunctionIdentityAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.typedFunctionIdentityAllocatorReceiptReady ||
       LoweringTypedFunctionIdentityAllocatorPhysicalBufferCount(plan) != 0 ||
       LoweringTypedFunctionIdentityAllocatorCapacityBytes(plan) != int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.typedFunctionIdentityAllocatorReceipt):
        panic("lowering typed function identity allocator: begin before release")
    plan.typedFunctionIdentityAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.typedFunctionIdentityAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.typedFunctionIdentityAllocatorReceiptReady = false

fn LoweringTypedFunctionIdentityAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.typedFunctionIdentityAllocatorReceiptReady:
        if LoweringTypedFunctionIdentityAllocatorPhysicalBufferCount(plan) !=
               0 ||
           LoweringTypedFunctionIdentityAllocatorCapacityBytes(plan) !=
               int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.typedFunctionIdentityAllocatorReceipt):
            panic("lowering typed function identity allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringTypedFunctionIdentityAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringTypedFunctionIdentityAllocatorCapacityBytes(plan)
    if plan.typedFunctionIdentityAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.typedFunctionIdentityAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering typed function identity allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringTypedFunctionIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIdentityAllocatorLedger,
            plan.typedFunctionIdentitySourcePaths,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIdentityAllocatorLedger,
            plan.typedFunctionIdentitySourceBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIdentityAllocatorLedger,
            plan.typedFunctionIdentitySourceEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIdentityAllocatorLedger,
            plan.typedFunctionIdentityBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIdentityAllocatorLedger,
            plan.typedFunctionIdentityEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIdentityAllocatorLedger,
            plan.typedFunctionIdentityEntrySourceIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIdentityAllocatorLedger,
            plan.typedFunctionIdentityEntryNameIds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIdentityAllocatorLedger,
            plan.typedFunctionIdentityEntryDeclarationLines,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIdentityAllocatorLedger,
            plan.typedFunctionIdentityEntryFunctionIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    plan.typedFunctionIdentityAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.typedFunctionIdentityAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.typedFunctionIdentityAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.typedFunctionIdentityAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.typedFunctionIdentityAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.typedFunctionIdentityAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.typedFunctionIdentityAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringTypedFunctionIdentityAllocatorPhysicalBufferCount(plan) == 0 &&
        LoweringTypedFunctionIdentityAllocatorCapacityBytes(plan) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering typed function identity allocator: receipt incomplete")
    plan.typedFunctionIdentityAllocatorReceipt = receipt
    plan.typedFunctionIdentityAllocatorReceiptReady = true
    plan.typedFunctionIdentityAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringPlanReleaseTypedFunctionIdentityIndexPayload(
        plan: var LoweringPlanStub) =
    plan.typedFunctionIdentityIndexBuilt = false
    LoweringTypedFunctionIdentityAllocatorRelease(plan)

fn LoweringBuildTypedFunctionIdentityIndex(plan: var LoweringPlanStub,
                                            err: var str): bool =
    LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
    LoweringTypedFunctionIdentityAllocatorBegin(plan)
    plan.typedFunctionIdentityBuildFunctionCount = 0
    plan.typedFunctionIdentityBuildBucketVisitCount = 0
    plan.typedFunctionIdentityLookupCount = 0
    plan.typedFunctionIdentityLookupBucketVisitCount = 0
    plan.typedFunctionIdentityLookupMaxBucketVisitCount = 0
    let functionCount = plan.typedIr.functions2_functionNameIds.len
    if plan.typedIr.functions2_sourcePathIds.len != functionCount ||
       plan.typedIr.functions2_signatureLineNumbers.len != functionCount ||
       plan.typedIr.functions2_returnTypeIds.len != functionCount ||
       plan.typedIr.functions2_resultExprClasses.len != functionCount:
        err = " lowering plan: typed ir function identity columns mismatch"
        return false
    let bucketCount = LoweringTypedFunctionIndexBucketCount(functionCount)
    for _sourceBucketIndex in 0..<bucketCount:
        LoweringTypedFunctionIdentityAppendBuckets(plan, -1)
    for typedFunctionIndex in 0..<functionCount:
        let sourceRes: Result[str] = langintern.LookupIntern(
            plan.typedIr.internPool,
            plan.typedIr.functions2_sourcePathIds[typedFunctionIndex])
        let nameRes: Result[str] = langintern.LookupIntern(
            plan.typedIr.internPool,
            plan.typedIr.functions2_functionNameIds[typedFunctionIndex])
        if !IsOk(sourceRes) || !IsOk(nameRes):
            err = Fmt" lowering plan: typed ir function identity intern missing index={typedFunctionIndex}"
            LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
            return false
        let sourcePath = LoweringCanonicalSourcePath(plan.workspaceRoot,
                                                     Value(sourceRes))
        let functionName = chengpath.PathTrim(Value(nameRes))
        let declarationLineIndex = arenamod.ArenaArrayInt32Get(
            plan.typedIr.arena,
            plan.typedIr.functions2_signatureLineNumbers,
            typedFunctionIndex)
        if sourcePath == "" || functionName == "" || declarationLineIndex <= 0:
            err = Fmt" lowering plan: typed ir semantic identity invalid index={typedFunctionIndex} source={sourcePath} function={functionName} line={declarationLineIndex}"
            LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
            return false
        let sourceBucket = LoweringTypedFunctionIndexSourceBucket(
            sourcePath,
            plan.typedFunctionIdentitySourceBucketHeads.len)
        if sourceBucket < 0:
            err = Fmt" lowering plan: typed ir semantic source bucket invalid source={sourcePath}"
            LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
            return false
        var sourceIndex: int32
        sourceIndex = -1
        var sourceEntryIndex = plan.typedFunctionIdentitySourceBucketHeads[sourceBucket]
        var sourceChainVisitCount: int32
        while sourceEntryIndex >= 0:
            sourceChainVisitCount = sourceChainVisitCount + 1
            plan.typedFunctionIdentityBuildBucketVisitCount =
                plan.typedFunctionIdentityBuildBucketVisitCount + 1
            if sourceChainVisitCount > plan.typedFunctionIdentitySourcePaths.len:
                err = " lowering plan: typed function identity source chain cycle"
                LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
                return false
            if sourceEntryIndex >= plan.typedFunctionIdentitySourcePaths.len ||
               sourceEntryIndex >= plan.typedFunctionIdentitySourceEntryNext.len:
                err = " lowering plan: typed function identity source index corrupt"
                LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
                return false
            if plan.typedFunctionIdentitySourcePaths[sourceEntryIndex] == sourcePath:
                sourceIndex = sourceEntryIndex
                break
            sourceEntryIndex = plan.typedFunctionIdentitySourceEntryNext[sourceEntryIndex]
        if sourceIndex < 0:
            sourceIndex = plan.typedFunctionIdentitySourcePaths.len
            LoweringTypedFunctionIdentityAppendSourceRow(
                plan,
                sourcePath,
                plan.typedFunctionIdentitySourceBucketHeads[sourceBucket])
            plan.typedFunctionIdentitySourceBucketHeads[sourceBucket] = sourceIndex
        let identityBucket = LoweringTypedFunctionIdentityBucket(
            sourceIndex,
            functionName,
            declarationLineIndex,
            plan.typedFunctionIdentityBucketHeads.len)
        if identityBucket < 0:
            err = Fmt" lowering plan: typed function identity bucket invalid function={functionName}"
            LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
            return false
        var identityEntryIndex = plan.typedFunctionIdentityBucketHeads[identityBucket]
        var identityChainVisitCount: int32
        while identityEntryIndex >= 0:
            identityChainVisitCount = identityChainVisitCount + 1
            plan.typedFunctionIdentityBuildBucketVisitCount =
                plan.typedFunctionIdentityBuildBucketVisitCount + 1
            if identityChainVisitCount >
               plan.typedFunctionIdentityEntryFunctionIndexes.len:
                err = " lowering plan: typed function identity entry chain cycle"
                LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
                return false
            if identityEntryIndex >= plan.typedFunctionIdentityEntryNext.len ||
               identityEntryIndex >= plan.typedFunctionIdentityEntrySourceIndexes.len ||
               identityEntryIndex >= plan.typedFunctionIdentityEntryNameIds.len ||
               identityEntryIndex >= plan.typedFunctionIdentityEntryDeclarationLines.len ||
               identityEntryIndex >= plan.typedFunctionIdentityEntryFunctionIndexes.len:
                err = " lowering plan: typed function identity entry index corrupt"
                LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
                return false
            let indexedNameRes: Result[str] = langintern.LookupIntern(
                plan.typedIr.internPool,
                plan.typedFunctionIdentityEntryNameIds[identityEntryIndex])
            if !IsOk(indexedNameRes):
                err = Fmt" lowering plan: typed function identity name intern missing entry={identityEntryIndex}"
                LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
                return false
            let indexedSourceIndex =
                plan.typedFunctionIdentityEntrySourceIndexes[identityEntryIndex]
            if indexedSourceIndex < 0 ||
               indexedSourceIndex >= plan.typedFunctionIdentitySourcePaths.len:
                err = Fmt" lowering plan: typed function identity entry source out of range entry={identityEntryIndex} source={indexedSourceIndex}"
                LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
                return false
            if indexedSourceIndex == sourceIndex &&
               plan.typedFunctionIdentitySourcePaths[indexedSourceIndex] == sourcePath &&
               Value(indexedNameRes) == functionName &&
               plan.typedFunctionIdentityEntryDeclarationLines[identityEntryIndex] == declarationLineIndex:
                let previousFunctionIndex =
                    plan.typedFunctionIdentityEntryFunctionIndexes[identityEntryIndex]
                err = Fmt" lowering plan: duplicate typed ir semantic identity source={sourcePath} function={functionName} line={declarationLineIndex} first={previousFunctionIndex} second={typedFunctionIndex}"
                LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
                return false
            identityEntryIndex =
                plan.typedFunctionIdentityEntryNext[identityEntryIndex]
        let newIdentityEntryIndex =
            plan.typedFunctionIdentityEntryFunctionIndexes.len
        LoweringTypedFunctionIdentityAppendEntryRow(
            plan,
            plan.typedFunctionIdentityBucketHeads[identityBucket],
            sourceIndex,
            plan.typedIr.functions2_functionNameIds[typedFunctionIndex],
            declarationLineIndex,
            typedFunctionIndex)
        plan.typedFunctionIdentityBucketHeads[identityBucket] =
            newIdentityEntryIndex
        plan.typedFunctionIdentityBuildFunctionCount =
            plan.typedFunctionIdentityBuildFunctionCount + 1
    plan.typedFunctionIdentityIndexBuilt = true
    return true

@borrows
fn LoweringTypedIrExactSemanticIdentityIndex(plan: var LoweringPlanStub,
                                               physicalSourcePathRaw: str,
                                               functionNameRaw: str,
                                               declarationLineIndex: int32,
                                               typedSourcePathOut: var str,
                                               typedFunctionIndexOut: var int32,
                                               err: var str): bool =
    typedSourcePathOut = ""
    typedFunctionIndexOut = -1
    let physicalSourcePath = LoweringCanonicalSourcePath(plan.workspaceRoot,
                                                          physicalSourcePathRaw)
    let functionName = chengpath.PathTrim(functionNameRaw)
    if physicalSourcePath == "" || functionName == "" || declarationLineIndex <= 0:
        err = Fmt" lowering plan: invalid compiler csg semantic identity source={physicalSourcePath} function={functionName} line={declarationLineIndex}"
        return false
    if !plan.typedFunctionIdentityIndexBuilt:
        err = " lowering plan: typed function identity index not built"
        return false
    let entryCount = plan.typedFunctionIdentityEntryFunctionIndexes.len
    if plan.typedFunctionIdentityEntryNext.len != entryCount ||
       plan.typedFunctionIdentityEntrySourceIndexes.len != entryCount ||
       plan.typedFunctionIdentityEntryNameIds.len != entryCount ||
       plan.typedFunctionIdentityEntryDeclarationLines.len != entryCount ||
       plan.typedFunctionIdentitySourceEntryNext.len !=
           plan.typedFunctionIdentitySourcePaths.len:
        err = " lowering plan: typed function identity index columns mismatch"
        return false
    plan.typedFunctionIdentityLookupCount =
        plan.typedFunctionIdentityLookupCount + 1
    var lookupVisitCount: int32
    let sourceBucket = LoweringTypedFunctionIndexSourceBucket(
        physicalSourcePath,
        plan.typedFunctionIdentitySourceBucketHeads.len)
    var sourceIndex: int32
    sourceIndex = -1
    if sourceBucket >= 0:
        var sourceEntryIndex =
            plan.typedFunctionIdentitySourceBucketHeads[sourceBucket]
        var sourceChainVisitCount: int32
        while sourceEntryIndex >= 0:
            sourceChainVisitCount = sourceChainVisitCount + 1
            lookupVisitCount = lookupVisitCount + 1
            plan.typedFunctionIdentityLookupBucketVisitCount =
                plan.typedFunctionIdentityLookupBucketVisitCount + 1
            if sourceChainVisitCount > plan.typedFunctionIdentitySourcePaths.len:
                err = " lowering plan: typed function identity source lookup cycle"
                if lookupVisitCount > plan.typedFunctionIdentityLookupMaxBucketVisitCount:
                    plan.typedFunctionIdentityLookupMaxBucketVisitCount = lookupVisitCount
                return false
            if sourceEntryIndex >= plan.typedFunctionIdentitySourcePaths.len ||
               sourceEntryIndex >= plan.typedFunctionIdentitySourceEntryNext.len:
                err = " lowering plan: typed function identity source lookup corrupt"
                if lookupVisitCount > plan.typedFunctionIdentityLookupMaxBucketVisitCount:
                    plan.typedFunctionIdentityLookupMaxBucketVisitCount = lookupVisitCount
                return false
            if plan.typedFunctionIdentitySourcePaths[sourceEntryIndex] ==
               physicalSourcePath:
                sourceIndex = sourceEntryIndex
                break
            sourceEntryIndex =
                plan.typedFunctionIdentitySourceEntryNext[sourceEntryIndex]
    var matchCount: int32
    if sourceIndex >= 0:
        let identityBucket = LoweringTypedFunctionIdentityBucket(
            sourceIndex,
            functionName,
            declarationLineIndex,
            plan.typedFunctionIdentityBucketHeads.len)
        if identityBucket >= 0:
            var identityEntryIndex =
                plan.typedFunctionIdentityBucketHeads[identityBucket]
            var identityChainVisitCount: int32
            while identityEntryIndex >= 0:
                identityChainVisitCount = identityChainVisitCount + 1
                lookupVisitCount = lookupVisitCount + 1
                plan.typedFunctionIdentityLookupBucketVisitCount =
                    plan.typedFunctionIdentityLookupBucketVisitCount + 1
                if identityChainVisitCount > entryCount:
                    err = " lowering plan: typed function identity lookup cycle"
                    if lookupVisitCount > plan.typedFunctionIdentityLookupMaxBucketVisitCount:
                        plan.typedFunctionIdentityLookupMaxBucketVisitCount = lookupVisitCount
                    return false
                if identityEntryIndex >= entryCount:
                    err = " lowering plan: typed function identity lookup corrupt"
                    if lookupVisitCount > plan.typedFunctionIdentityLookupMaxBucketVisitCount:
                        plan.typedFunctionIdentityLookupMaxBucketVisitCount = lookupVisitCount
                    return false
                let indexedNameRes: Result[str] = langintern.LookupIntern(
                    plan.typedIr.internPool,
                    plan.typedFunctionIdentityEntryNameIds[identityEntryIndex])
                if !IsOk(indexedNameRes):
                    err = Fmt" lowering plan: typed function identity lookup name intern missing entry={identityEntryIndex}"
                    if lookupVisitCount > plan.typedFunctionIdentityLookupMaxBucketVisitCount:
                        plan.typedFunctionIdentityLookupMaxBucketVisitCount = lookupVisitCount
                    return false
                let indexedSourceIndex =
                    plan.typedFunctionIdentityEntrySourceIndexes[identityEntryIndex]
                if indexedSourceIndex < 0 ||
                   indexedSourceIndex >= plan.typedFunctionIdentitySourcePaths.len:
                    err = Fmt" lowering plan: typed function identity lookup source out of range entry={identityEntryIndex} source={indexedSourceIndex}"
                    if lookupVisitCount > plan.typedFunctionIdentityLookupMaxBucketVisitCount:
                        plan.typedFunctionIdentityLookupMaxBucketVisitCount = lookupVisitCount
                    return false
                if indexedSourceIndex == sourceIndex &&
                   plan.typedFunctionIdentitySourcePaths[indexedSourceIndex] == physicalSourcePath &&
                   Value(indexedNameRes) == functionName &&
                   plan.typedFunctionIdentityEntryDeclarationLines[identityEntryIndex] == declarationLineIndex:
                    matchCount = matchCount + 1
                    typedFunctionIndexOut =
                        plan.typedFunctionIdentityEntryFunctionIndexes[identityEntryIndex]
                identityEntryIndex =
                    plan.typedFunctionIdentityEntryNext[identityEntryIndex]
    if lookupVisitCount > plan.typedFunctionIdentityLookupMaxBucketVisitCount:
        plan.typedFunctionIdentityLookupMaxBucketVisitCount = lookupVisitCount
    if matchCount != 1:
        err = Fmt" lowering plan: compiler csg semantic identity match count source={physicalSourcePath} function={functionName} line={declarationLineIndex} count={matchCount}"
        typedSourcePathOut = ""
        typedFunctionIndexOut = -1
        return false
    if typedFunctionIndexOut < 0 ||
       typedFunctionIndexOut >= plan.typedIr.functions2_sourcePathIds.len:
        let badIndex = typedFunctionIndexOut
        err = Fmt" lowering plan: typed function identity result out of range index={badIndex}"
        typedFunctionIndexOut = -1
        return false
    let typedSourceRes: Result[str] = langintern.LookupIntern(
        plan.typedIr.internPool,
        plan.typedIr.functions2_sourcePathIds[typedFunctionIndexOut])
    if !IsOk(typedSourceRes):
        let missingIndex = typedFunctionIndexOut
        err = Fmt" lowering plan: typed function identity result source intern missing index={missingIndex}"
        typedFunctionIndexOut = -1
        return false
    typedSourcePathOut = parser.ParserNormalizePath(Value(typedSourceRes))
    return true

@borrows
fn LoweringValidateCompilerCsgSemanticSignature(plan: var LoweringPlanStub,
                                                  node: ccsg.CompilerCsgNode,
                                                  typedSourcePath: str,
                                                  typedFunctionIndex: int32,
                                                  err: var str): bool =
    if node.semanticSignatureComplete == 0:
        return true
    if node.semanticSignatureComplete != 1:
        err = Fmt" lowering plan: compiler csg semantic signature completeness invalid function={node.factText} value={node.semanticSignatureComplete}"
        return false
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >= plan.typedIr.functions2_returnTypeIds.len:
        err = Fmt" lowering plan: compiler csg semantic signature typed function missing function={node.factText} index={typedFunctionIndex}"
        return false
    let semanticReturnType = texpr.TypedExprNormalizeTypeText(
        node.semanticReturnType)
    if semanticReturnType == "":
        err = Fmt" lowering plan: compiler csg semantic return type missing function={node.factText} line={node.semanticDeclarationLineIndex}"
        return false
    let typedReturnRes: Result[str] = langintern.LookupIntern(
        plan.typedIr.internPool,
        plan.typedIr.functions2_returnTypeIds[typedFunctionIndex])
    if !IsOk(typedReturnRes):
        err = Fmt" lowering plan: typed ir return type intern missing function={node.factText} index={typedFunctionIndex}"
        return false
    let typedReturnType = strings.CloneStr(texpr.TypedExprNormalizeTypeText(Value(typedReturnRes)))
    # Typed IR keeps the empty void marker from the source scope; the CSG
    # semantic record canonicalizes it to "void". Compare in canonical form.
    # share(borrow_result) into var is illegal; CloneStr yields owned authority.
    var typedReturnTypeCanonical = strings.CloneStr(typedReturnType)
    if typedReturnTypeCanonical.len == 0:
        typedReturnTypeCanonical = strings.CloneStr("void")
    if typedReturnTypeCanonical != semanticReturnType:
        err = Fmt" lowering plan: compiler csg semantic return type drift function={node.factText} expected={semanticReturnType} actual={typedReturnType}"
        return false
    let buildIndex = texpr.TypedExprIrCanonicalMetadataIndex(plan.typedIr)
    if buildIndex == nil:
        err = Fmt" lowering plan: compiler csg semantic signature build index missing function={node.factText}"
        return false
    let semanticParamTypes = texpr.TypedExprSplitParamTypeJoin(
        node.semanticParamTypeJoin)
    var declarationRowIndex: int32
    var matchRank: int32
    var explicitContractMismatch: bool
    var emptyExplicitGenericTypes: str[]
    let lookupState = texpr.TypedExprBuildIndexLookupCallDeclarationInSource(
        buildIndex,
        typedSourcePath,
        node.factText,
        texpr.TypedExprCallDeclarationFunction,
        semanticParamTypes,
        emptyExplicitGenericTypes,
        false,
        declarationRowIndex,
        matchRank,
        explicitContractMismatch)
    if lookupState != texpr.TypedExprBuildIndexUnique || matchRank != 2:
        err = Fmt" lowering plan: compiler csg semantic parameter identity not unique function={node.factText} line={node.semanticDeclarationLineIndex} rank={matchRank}"
        return false
    # Build-index registration canonicalizes @borrows function parameters one
    # step past the semantic join: every argument without an explicit borrow
    # marker is wrapped into borrow-mode text. The semantic record keeps the
    # join unwrapped. Compare the declared text against the exact canonical
    # image of the semantic piece under that single documented transform; any
    # other difference (including the runtime-form strip that hides var-view
    # parameter markers) is drift.
    let declaredBorrowsArguments =
        typedFunctionIndex >= 0 &&
        typedFunctionIndex < plan.typedIr.functions2_borrowsArguments.len &&
        plan.typedIr.functions2_borrowsArguments[typedFunctionIndex]
    for paramIndex in 0..<semanticParamTypes.len:
        let semanticParamType = texpr.TypedExprNormalizeTypeText(
            semanticParamTypes[paramIndex])
        let declaredParamType = texpr.TypedExprCallDeclarationParamType(
            buildIndex,
            declarationRowIndex,
            paramIndex)
        let declaredParamTypeNorm = texpr.TypedExprNormalizeTypeText(
            declaredParamType)
        # t13: spec 迁移——semanticParamType 在 borrows 条件与 err Fmt 中仍被读，
        # move 形静态非法；share 产生共享 owning def。
        var declaredExpectedParamType = share(semanticParamType)
        if declaredBorrowsArguments && semanticParamType != "" &&
           !texpr.TypedExprCallArgumentHasExplicitBorrow(
               semanticParamTypes[paramIndex]):
            declaredExpectedParamType = texpr.TypedExprCallBorrowModeType(
                share(semanticParamTypes[paramIndex]))
        if semanticParamType == "" ||
           declaredExpectedParamType != declaredParamTypeNorm:
            let declaredRuntimeParamType = texpr.TypedExprCallRuntimeType(
                declaredParamType)
            let expectedTypeId = langintern.FindInternId(
                plan.typedIr.internPool,
                texpr.TypedExprNormalizeTypeText(
                    semanticParamTypes[paramIndex]))
            let actualTypeId = langintern.FindInternId(
                plan.typedIr.internPool,
                texpr.TypedExprNormalizeTypeText(declaredParamType))
            err = Fmt" lowering plan: compiler csg semantic parameter type drift function={node.factText} line={node.semanticDeclarationLineIndex} index={paramIndex} expected={semanticParamType} actual={declaredParamTypeNorm} declared_raw={declaredParamType} declared_runtime={declaredRuntimeParamType} expected_type_id={expectedTypeId} actual_type_id={actualTypeId} borrows_arguments={declaredBorrowsArguments ? 1 : 0} declaration_row={declarationRowIndex} typed_function={typedFunctionIndex} param_count={semanticParamTypes.len} source={typedSourcePath}"
            return false
    let declarationReturnType = texpr.TypedExprNormalizeTypeText(
        texpr.TypedExprCallDeclarationResolvedReturnType(buildIndex,
                                                         declarationRowIndex,
                                                         semanticParamTypes,
                                                         emptyExplicitGenericTypes,
                                                         false))
    if declarationReturnType != semanticReturnType:
        err = Fmt" lowering plan: compiler csg semantic declaration return drift function={node.factText} line={node.semanticDeclarationLineIndex} expected={semanticReturnType} actual={declarationReturnType}"
        return false
    return true

@borrows
fn LoweringFunctionEmissionMetadataAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.functionOwnerModulePaths.cap > 0: count = count + 1
    if plan.functionCallConvs.cap > 0: count = count + 1
    if plan.functionResultLayoutKinds.cap > 0: count = count + 1
    if plan.functionSignatureLineNumbers.cap > 0: count = count + 1
    if plan.functionBodyLineNumbers.cap > 0: count = count + 1
    return count

@borrows
fn LoweringFunctionEmissionMetadataAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(plan.functionOwnerModulePaths.cap) * int64(sizeof(str)) +
        int64(plan.functionCallConvs.cap) * int64(sizeof(int32)) +
        int64(plan.functionResultLayoutKinds.cap) * int64(sizeof(int32)) +
        int64(plan.functionSignatureLineNumbers.cap) * int64(sizeof(int32)) +
        int64(plan.functionBodyLineNumbers.cap) * int64(sizeof(int32))

@borrows
fn LoweringFunctionEmissionMetadataAppendRow(
        plan: var LoweringPlanStub,
        ownerModulePath: str,
        callConv: int32,
        resultLayoutKind: int32,
        signatureLineNumber: int32,
        bodyLineNumber: int32) =
    let rowCount = plan.functionOwnerModulePaths.len
    if plan.functionCallConvs.len != rowCount ||
       plan.functionResultLayoutKinds.len != rowCount ||
       plan.functionSignatureLineNumbers.len != rowCount ||
       plan.functionBodyLineNumbers.len != rowCount:
        panic("lowering function emission metadata allocator: row shape drift")
    loweringSequenceAllocatorAdd(
        plan.functionEmissionMetadataAllocatorLedger,
        plan.functionOwnerModulePaths,
        ownerModulePath,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.functionEmissionMetadataAllocatorLedger,
        plan.functionCallConvs,
        callConv,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.functionEmissionMetadataAllocatorLedger,
        plan.functionResultLayoutKinds,
        resultLayoutKind,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.functionEmissionMetadataAllocatorLedger,
        plan.functionSignatureLineNumbers,
        signatureLineNumber,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.functionEmissionMetadataAllocatorLedger,
        plan.functionBodyLineNumbers,
        bodyLineNumber,
        sizeof(int32))

fn LoweringFunctionEmissionMetadataAppendLineRow(
        plan: var LoweringPlanStub,
        signatureLineNumber: int32,
        bodyLineNumber: int32) =
    if plan.functionSignatureLineNumbers.len !=
           plan.functionBodyLineNumbers.len ||
       plan.functionSignatureLineNumbers.len >=
           plan.functionOwnerModulePaths.len:
        panic("lowering function emission metadata allocator: line row shape drift")
    loweringSequenceAllocatorAdd(
        plan.functionEmissionMetadataAllocatorLedger,
        plan.functionSignatureLineNumbers,
        signatureLineNumber,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.functionEmissionMetadataAllocatorLedger,
        plan.functionBodyLineNumbers,
        bodyLineNumber,
        sizeof(int32))

fn LoweringFunctionEmissionMetadataReleaseLineRowsForReplace(
        plan: var LoweringPlanStub) =
    if plan.functionEmissionMetadataAllocatorReceiptReady ||
       plan.functionEmissionMetadataAllocatorLedger.closed ||
       plan.functionSignatureLineNumbers.len !=
           plan.functionBodyLineNumbers.len:
        panic("lowering function emission metadata allocator: invalid line replace")
    let _ = loweringSequenceAllocatorRelease(
        plan.functionEmissionMetadataAllocatorLedger,
        plan.functionSignatureLineNumbers,
        sizeof(int32))
    let _ = loweringSequenceAllocatorRelease(
        plan.functionEmissionMetadataAllocatorLedger,
        plan.functionBodyLineNumbers,
        sizeof(int32))
    if plan.functionSignatureLineNumbers.cap != 0 ||
       plan.functionBodyLineNumbers.cap != 0:
        panic("lowering function emission metadata allocator: line release incomplete")

fn loweringFunctionEmissionMetadataAccumulateTerminalRelease(
        releasedBytes: int64,
        releasedBufferCount: var int32,
        totalReleasedBytes: var int64) =
    if releasedBytes > int64(0):
        releasedBufferCount = releasedBufferCount + 1
        totalReleasedBytes = totalReleasedBytes + releasedBytes

fn LoweringFunctionEmissionMetadataAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.functionEmissionMetadataAllocatorReceiptReady ||
       LoweringFunctionEmissionMetadataAllocatorPhysicalBufferCount(plan) != 0 ||
       LoweringFunctionEmissionMetadataAllocatorCapacityBytes(plan) != int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.functionEmissionMetadataAllocatorReceipt):
        panic("lowering function emission metadata allocator: begin before release")
    plan.functionEmissionMetadataAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.functionEmissionMetadataAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.functionEmissionMetadataAllocatorReceiptReady = false

fn LoweringFunctionEmissionMetadataAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.functionEmissionMetadataAllocatorReceiptReady:
        if LoweringFunctionEmissionMetadataAllocatorPhysicalBufferCount(plan) != 0 ||
           LoweringFunctionEmissionMetadataAllocatorCapacityBytes(plan) != int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.functionEmissionMetadataAllocatorReceipt):
            panic("lowering function emission metadata allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringFunctionEmissionMetadataAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringFunctionEmissionMetadataAllocatorCapacityBytes(plan)
    if plan.functionEmissionMetadataAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.functionEmissionMetadataAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering function emission metadata allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringFunctionEmissionMetadataAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionEmissionMetadataAllocatorLedger,
            plan.functionOwnerModulePaths,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionEmissionMetadataAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionEmissionMetadataAllocatorLedger,
            plan.functionCallConvs,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionEmissionMetadataAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionEmissionMetadataAllocatorLedger,
            plan.functionResultLayoutKinds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionEmissionMetadataAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionEmissionMetadataAllocatorLedger,
            plan.functionSignatureLineNumbers,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionEmissionMetadataAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionEmissionMetadataAllocatorLedger,
            plan.functionBodyLineNumbers,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    plan.functionEmissionMetadataAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.functionEmissionMetadataAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.functionEmissionMetadataAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.functionEmissionMetadataAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.functionEmissionMetadataAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.functionEmissionMetadataAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.functionEmissionMetadataAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringFunctionEmissionMetadataAllocatorPhysicalBufferCount(plan) == 0 &&
        LoweringFunctionEmissionMetadataAllocatorCapacityBytes(plan) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering function emission metadata allocator: receipt incomplete")
    plan.functionEmissionMetadataAllocatorReceipt = receipt
    plan.functionEmissionMetadataAllocatorReceiptReady = true
    plan.functionEmissionMetadataAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringPlanReleaseFunctionEmissionMetadataPayload(
        plan: var LoweringPlanStub) =
    LoweringFunctionEmissionMetadataAllocatorRelease(plan)

@borrows
fn LoweringFunctionRuntimeIdentityAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.functionSourcePaths.cap > 0: count = count + 1
    if plan.functionNames.cap > 0: count = count + 1
    if plan.functionNameIds.cap > 0: count = count + 1
    if plan.functionSymbolTexts.cap > 0: count = count + 1
    if plan.functionExportedFlags.cap > 0: count = count + 1
    if plan.functionExportSymbolNames.cap > 0: count = count + 1
    if plan.functionExportNameExplicitFlags.cap > 0: count = count + 1
    if plan.functionExportProducerSourceIndexes.cap > 0: count = count + 1
    if plan.functionExportProducerDeclarationIndexes.cap > 0:
        count = count + 1
    if plan.functionExportProducerNodeIds.cap > 0: count = count + 1
    if plan.functionExportProducerFactCids.cap > 0: count = count + 1
    if plan.functionEntryFlags.cap > 0: count = count + 1
    return count

@borrows
fn LoweringFunctionRuntimeIdentityAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(plan.functionSourcePaths.cap) * int64(sizeof(str)) +
        int64(plan.functionNames.cap) * int64(sizeof(str)) +
        int64(plan.functionNameIds.cap) * int64(sizeof(int32)) +
        int64(plan.functionSymbolTexts.cap) * int64(sizeof(str)) +
        int64(plan.functionExportedFlags.cap) * int64(sizeof(int32)) +
        int64(plan.functionExportSymbolNames.cap) * int64(sizeof(str)) +
        int64(plan.functionExportNameExplicitFlags.cap) *
            int64(sizeof(int32)) +
        int64(plan.functionExportProducerSourceIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.functionExportProducerDeclarationIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.functionExportProducerNodeIds.cap) *
            int64(sizeof(int32)) +
        int64(plan.functionExportProducerFactCids.cap) *
            int64(sizeof(layout.FixedBytes32)) +
        int64(plan.functionEntryFlags.cap) * int64(sizeof(int32))

@borrows
fn loweringFunctionRuntimeIdentityAppendStoredRow(
        plan: var LoweringPlanStub,
        sourcePath: str,
        functionName: str,
        symbolText: str,
        exportedFlag: int32,
        exportSymbolName: str,
        exportNameExplicit: int32,
        producerSourceIndex: int32,
        producerDeclarationIndex: int32,
        producerNodeId: int32,
        producerFactCid: layout.FixedBytes32,
        entryFlag: int32) =
    let rowCount = plan.functionSourcePaths.len
    if plan.functionNames.len != rowCount ||
       plan.functionSymbolTexts.len != rowCount ||
       plan.functionExportedFlags.len != rowCount ||
       plan.functionExportSymbolNames.len != rowCount ||
       plan.functionExportNameExplicitFlags.len != rowCount ||
       plan.functionExportProducerSourceIndexes.len != rowCount ||
       plan.functionExportProducerDeclarationIndexes.len != rowCount ||
       plan.functionExportProducerNodeIds.len != rowCount ||
       plan.functionExportProducerFactCids.len != rowCount ||
       plan.functionEntryFlags.len != rowCount:
        panic("lowering runtime function identity allocator: row shape drift")
    loweringSequenceAllocatorAdd(
        plan.functionRuntimeIdentityAllocatorLedger,
        plan.functionSourcePaths,
        sourcePath,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.functionRuntimeIdentityAllocatorLedger,
        plan.functionNames,
        functionName,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.functionRuntimeIdentityAllocatorLedger,
        plan.functionSymbolTexts,
        symbolText,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.functionRuntimeIdentityAllocatorLedger,
        plan.functionExportedFlags,
        exportedFlag,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.functionRuntimeIdentityAllocatorLedger,
        plan.functionExportSymbolNames,
        exportSymbolName,
        sizeof(str))
    if exportedFlag != 0:
        if exportSymbolName == "":
            panic("lowering runtime function identity: export payload missing")
    elif exportSymbolName != "":
        panic("lowering runtime function identity: unowned export payload")
    loweringSequenceAllocatorAdd(
        plan.functionRuntimeIdentityAllocatorLedger,
        plan.functionExportNameExplicitFlags,
        exportNameExplicit,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.functionRuntimeIdentityAllocatorLedger,
        plan.functionExportProducerSourceIndexes,
        producerSourceIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.functionRuntimeIdentityAllocatorLedger,
        plan.functionExportProducerDeclarationIndexes,
        producerDeclarationIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.functionRuntimeIdentityAllocatorLedger,
        plan.functionExportProducerNodeIds,
        producerNodeId,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.functionRuntimeIdentityAllocatorLedger,
        plan.functionExportProducerFactCids,
        producerFactCid,
        sizeof(layout.FixedBytes32))
    loweringSequenceAllocatorAdd(
        plan.functionRuntimeIdentityAllocatorLedger,
        plan.functionEntryFlags,
        entryFlag,
        sizeof(int32))

# Compatibility surface used only by allocator lifecycle tests and by typed
# fallback rows that have no CompilerCSG producer. Such rows carry the exact
# absent-lineage sentinel and therefore cannot publish an exported receipt.
@borrows
fn LoweringFunctionRuntimeIdentityAppendRow(
        plan: var LoweringPlanStub,
        sourcePath: str,
        functionName: str,
        symbolText: str,
        exportedFlag: int32,
        exportSymbolName: str,
        entryFlag: int32) =
    loweringFunctionRuntimeIdentityAppendStoredRow(
        plan,
        sourcePath,
        functionName,
        symbolText,
        exportedFlag,
        exportSymbolName,
        0,
        -1,
        -1,
        -1,
        layout.FixedBytes32(),
        entryFlag)

@borrows
fn LoweringFunctionRuntimeIdentityAppendProducerRow(
        plan: var LoweringPlanStub,
        sourcePath: str,
        functionName: str,
        symbolText: str,
        exportedFlag: int32,
        exportSymbolName: str,
        exportNameExplicit: int32,
        producerSourceIndex: int32,
        producerDeclarationIndex: int32,
        producerNodeId: int32,
        producerFactCid: layout.FixedBytes32,
        entryFlag: int32) =
    if producerSourceIndex < 0 || producerDeclarationIndex < 0 ||
       producerNodeId <= 0 ||
       layout.FixedBytes32Equal(producerFactCid, layout.FixedBytes32()) ||
       (exportNameExplicit != 0 && exportNameExplicit != 1):
        panic("lowering runtime function identity: producer lineage invalid")
    loweringFunctionRuntimeIdentityAppendStoredRow(
        plan,
        sourcePath,
        functionName,
        symbolText,
        exportedFlag,
        exportSymbolName,
        exportNameExplicit,
        producerSourceIndex,
        producerDeclarationIndex,
        producerNodeId,
        producerFactCid,
        entryFlag)

fn loweringFunctionRuntimeIdentityAccumulateTerminalRelease(
        releasedBytes: int64,
        releasedBufferCount: var int32,
        totalReleasedBytes: var int64) =
    if releasedBytes > int64(0):
        releasedBufferCount = releasedBufferCount + 1
        totalReleasedBytes = totalReleasedBytes + releasedBytes

fn LoweringFunctionRuntimeIdentityAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.functionRuntimeIdentityAllocatorReceiptReady ||
       LoweringFunctionRuntimeIdentityAllocatorPhysicalBufferCount(plan) != 0 ||
       LoweringFunctionRuntimeIdentityAllocatorCapacityBytes(plan) != int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.functionRuntimeIdentityAllocatorReceipt):
        panic("lowering runtime function identity allocator: begin before release")
    plan.functionRuntimeIdentityAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.functionRuntimeIdentityAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.functionRuntimeIdentityAllocatorReceiptReady = false

fn LoweringFunctionRuntimeIdentityAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.functionRuntimeIdentityAllocatorReceiptReady:
        if LoweringFunctionRuntimeIdentityAllocatorPhysicalBufferCount(plan) != 0 ||
           LoweringFunctionRuntimeIdentityAllocatorCapacityBytes(plan) != int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.functionRuntimeIdentityAllocatorReceipt):
            panic("lowering runtime function identity allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringFunctionRuntimeIdentityAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringFunctionRuntimeIdentityAllocatorCapacityBytes(plan)
    if plan.functionRuntimeIdentityAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.functionRuntimeIdentityAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering runtime function identity allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringFunctionRuntimeIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionRuntimeIdentityAllocatorLedger,
            plan.functionSourcePaths,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionRuntimeIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionRuntimeIdentityAllocatorLedger,
            plan.functionNames,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionRuntimeIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionRuntimeIdentityAllocatorLedger,
            plan.functionNameIds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionRuntimeIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionRuntimeIdentityAllocatorLedger,
            plan.functionSymbolTexts,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionRuntimeIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionRuntimeIdentityAllocatorLedger,
            plan.functionExportedFlags,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionRuntimeIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionRuntimeIdentityAllocatorLedger,
            plan.functionExportSymbolNames,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionRuntimeIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionRuntimeIdentityAllocatorLedger,
            plan.functionExportNameExplicitFlags,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionRuntimeIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionRuntimeIdentityAllocatorLedger,
            plan.functionExportProducerSourceIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionRuntimeIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionRuntimeIdentityAllocatorLedger,
            plan.functionExportProducerDeclarationIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionRuntimeIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionRuntimeIdentityAllocatorLedger,
            plan.functionExportProducerNodeIds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionRuntimeIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionRuntimeIdentityAllocatorLedger,
            plan.functionExportProducerFactCids,
            sizeof(layout.FixedBytes32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionRuntimeIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionRuntimeIdentityAllocatorLedger,
            plan.functionEntryFlags,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    plan.functionRuntimeIdentityAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.functionRuntimeIdentityAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.functionRuntimeIdentityAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.functionRuntimeIdentityAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.functionRuntimeIdentityAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.functionRuntimeIdentityAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.functionRuntimeIdentityAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringFunctionRuntimeIdentityAllocatorPhysicalBufferCount(plan) == 0 &&
        LoweringFunctionRuntimeIdentityAllocatorCapacityBytes(plan) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering runtime function identity allocator: receipt incomplete")
    plan.functionRuntimeIdentityAllocatorReceipt = receipt
    plan.functionRuntimeIdentityAllocatorReceiptReady = true
    plan.functionRuntimeIdentityAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringPlanReleaseFunctionRuntimeIdentityPayload(
        plan: var LoweringPlanStub) =
    LoweringFunctionRuntimeIdentityAllocatorRelease(plan)

@borrows
fn LoweringFunctionSemanticIdentityAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.functionSemanticSources.cap > 0: count = count + 1
    if plan.functionSemanticDeclarationLineIndexes.cap > 0:
        count = count + 1
    if plan.functionSemanticParamTypeJoins.cap > 0:
        count = count + 1
    if plan.functionSemanticReturnTypes.cap > 0: count = count + 1
    if plan.functionSemanticSignatureCompletes.cap > 0:
        count = count + 1
    if plan.functionTypedIrIndexes.cap > 0: count = count + 1
    return count

@borrows
fn LoweringFunctionSemanticIdentityAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(plan.functionSemanticSources.cap) *
            int64(sizeof(str)) +
        int64(plan.functionSemanticDeclarationLineIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.functionSemanticParamTypeJoins.cap) *
            int64(sizeof(str)) +
        int64(plan.functionSemanticReturnTypes.cap) *
            int64(sizeof(str)) +
        int64(plan.functionSemanticSignatureCompletes.cap) *
            int64(sizeof(int32)) +
        int64(plan.functionTypedIrIndexes.cap) *
            int64(sizeof(int32))

@borrows
fn LoweringFunctionSemanticIdentityAppendRow(
        plan: var LoweringPlanStub,
        semanticSource: str,
        declarationLineIndex: int32,
        paramTypeJoin: str,
        returnType: str,
        signatureComplete: int32,
        typedIrIndex: int32) =
    let rowCount = plan.functionSemanticSources.len
    if plan.functionSemanticDeclarationLineIndexes.len != rowCount ||
       plan.functionSemanticParamTypeJoins.len != rowCount ||
       plan.functionSemanticReturnTypes.len != rowCount ||
       plan.functionSemanticSignatureCompletes.len != rowCount ||
       plan.functionTypedIrIndexes.len != rowCount:
        panic("lowering semantic function identity allocator: row shape drift")
    loweringSequenceAllocatorAdd(
        plan.functionSemanticIdentityAllocatorLedger,
        plan.functionSemanticSources,
        semanticSource,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.functionSemanticIdentityAllocatorLedger,
        plan.functionSemanticDeclarationLineIndexes,
        declarationLineIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.functionSemanticIdentityAllocatorLedger,
        plan.functionSemanticParamTypeJoins,
        paramTypeJoin,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.functionSemanticIdentityAllocatorLedger,
        plan.functionSemanticReturnTypes,
        returnType,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.functionSemanticIdentityAllocatorLedger,
        plan.functionSemanticSignatureCompletes,
        signatureComplete,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.functionSemanticIdentityAllocatorLedger,
        plan.functionTypedIrIndexes,
        typedIrIndex,
        sizeof(int32))

fn loweringFunctionSemanticIdentityAccumulateTerminalRelease(
        releasedBytes: int64,
        releasedBufferCount: var int32,
        totalReleasedBytes: var int64) =
    if releasedBytes > int64(0):
        releasedBufferCount = releasedBufferCount + 1
        totalReleasedBytes = totalReleasedBytes + releasedBytes

fn LoweringFunctionSemanticIdentityAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.functionSemanticIdentityAllocatorReceiptReady ||
       LoweringFunctionSemanticIdentityAllocatorPhysicalBufferCount(plan) != 0 ||
       LoweringFunctionSemanticIdentityAllocatorCapacityBytes(plan) != int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.functionSemanticIdentityAllocatorReceipt):
        panic("lowering semantic function identity allocator: begin before release")
    plan.functionSemanticIdentityAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.functionSemanticIdentityAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.functionSemanticIdentityAllocatorReceiptReady = false

fn LoweringFunctionSemanticIdentityAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.functionSemanticIdentityAllocatorReceiptReady:
        if LoweringFunctionSemanticIdentityAllocatorPhysicalBufferCount(plan) != 0 ||
           LoweringFunctionSemanticIdentityAllocatorCapacityBytes(plan) != int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.functionSemanticIdentityAllocatorReceipt):
            panic("lowering semantic function identity allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringFunctionSemanticIdentityAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringFunctionSemanticIdentityAllocatorCapacityBytes(plan)
    if plan.functionSemanticIdentityAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.functionSemanticIdentityAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering semantic function identity allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringFunctionSemanticIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionSemanticIdentityAllocatorLedger,
            plan.functionSemanticSources,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionSemanticIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionSemanticIdentityAllocatorLedger,
            plan.functionSemanticDeclarationLineIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionSemanticIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionSemanticIdentityAllocatorLedger,
            plan.functionSemanticParamTypeJoins,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionSemanticIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionSemanticIdentityAllocatorLedger,
            plan.functionSemanticReturnTypes,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionSemanticIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionSemanticIdentityAllocatorLedger,
            plan.functionSemanticSignatureCompletes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFunctionSemanticIdentityAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.functionSemanticIdentityAllocatorLedger,
            plan.functionTypedIrIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    plan.functionSemanticIdentityAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.functionSemanticIdentityAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.functionSemanticIdentityAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.functionSemanticIdentityAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.functionSemanticIdentityAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.functionSemanticIdentityAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.functionSemanticIdentityAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringFunctionSemanticIdentityAllocatorPhysicalBufferCount(plan) == 0 &&
        LoweringFunctionSemanticIdentityAllocatorCapacityBytes(plan) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering semantic function identity allocator: receipt incomplete")
    plan.functionSemanticIdentityAllocatorReceipt = receipt
    plan.functionSemanticIdentityAllocatorReceiptReady = true
    plan.functionSemanticIdentityAllocatorLedger =
        LoweringSequenceAllocatorLedger()

@borrows
fn LoweringAppendCompilerCsgSemanticFunctionRow(
        plan: var LoweringPlanStub,
        node: ccsg.CompilerCsgNode,
        physicalSourcePath: str,
        typedFunctionClaimed: var bool[],
        err: var str): bool =
    if node.nodeKind != ccsg.CompilerCsgNodeKindSymbol ||
       node.nodeId <= 0 ||
       node.producerSourceIndex < 0 ||
       node.producerDeclarationIndex < 0 ||
       (node.exportNameExplicit != 0 &&
        node.exportNameExplicit != 1) ||
       layout.FixedBytes32Equal(node.factCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           node.factCid, ccsg.CompilerCsgHashNodeRecord(node)) ||
       node.semanticSource == "" ||
       node.semanticDeclarationLineIndex <= 0 ||
       node.factText == "" ||
       chengpath.PathTrim(node.factText) != node.factText:
        err = Fmt" lowering plan: compiler csg semantic symbol identity invalid function={node.factText} source={node.semanticSource} line={node.semanticDeclarationLineIndex}"
        return false
    var typedSourcePath: str
    var typedFunctionIndex: int32
    if !LoweringTypedIrExactSemanticIdentityIndex(
            plan,
            physicalSourcePath,
            node.factText,
            node.semanticDeclarationLineIndex,
            typedSourcePath,
            typedFunctionIndex,
            err):
        return false
    if typedFunctionClaimed.len != plan.typedIr.functions2_functionNameIds.len ||
       typedFunctionIndex < 0 ||
       typedFunctionIndex >= typedFunctionClaimed.len:
        err = Fmt" lowering plan: compiler csg semantic claim domain mismatch function={node.factText} index={typedFunctionIndex}"
        return false
    if typedFunctionClaimed[typedFunctionIndex]:
        err = Fmt" lowering plan: duplicate compiler csg semantic identity source={typedSourcePath} function={node.factText} line={node.semanticDeclarationLineIndex}"
        return false
    if !LoweringValidateCompilerCsgSemanticSignature(plan,
                                                      node,
                                                      typedSourcePath,
                                                      typedFunctionIndex,
                                                      err):
        return false
    if node.entryFlag != 0:
        if plan.sourceEntryTypedFunctionIndex >= 0 &&
           plan.sourceEntryTypedFunctionIndex != typedFunctionIndex:
            err = Fmt" lowering plan: multiple exact source-entry TypedExpr rows first={plan.sourceEntryTypedFunctionIndex} second={typedFunctionIndex}"
            return false
        plan.sourceEntryTypedFunctionIndex = typedFunctionIndex
    typedFunctionClaimed[typedFunctionIndex] = true
    let functionRuntimeSourcePath =
        LoweringCanonicalSourcePath(plan.workspaceRoot, physicalSourcePath)
    LoweringFunctionRuntimeIdentityAppendProducerRow(
        plan,
        functionRuntimeSourcePath,
        node.factText,
        node.symbolText,
        node.exportedFlag,
        node.exportSymbolName,
        node.exportNameExplicit,
        node.producerSourceIndex,
        node.producerDeclarationIndex,
        node.nodeId,
        node.factCid,
        typedFunctionIndex == plan.sourceEntryTypedFunctionIndex ? 1 : 0)
    LoweringFunctionEmissionMetadataAppendRow(
        plan,
        node.modulePath,
        node.callConv,
        node.resultLayoutKind,
        node.semanticDeclarationLineIndex,
        0)
    LoweringFunctionSemanticIdentityAppendRow(
        plan,
        node.semanticSource,
        node.semanticDeclarationLineIndex,
        node.semanticParamTypeJoin,
        node.semanticReturnType,
        node.semanticSignatureComplete,
        typedFunctionIndex)
    err = ""
    return true

fn loweringSequenceAllocatorSetLen(
        owner: var LoweringSemanticIdentityTypedIndexScratchOwner,
        domain: LoweringSemanticIdentityTypedIndexScratchLength) =
    if owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed:
        panic("lowering semantic identity scratch: invalid setLen state")
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.typedIndexSeen,
        domain.length,
        sizeof(bool))

@borrows
fn LoweringSemanticIdentityTypedIndexScratchPhysicalBufferCount(
        owner: LoweringSemanticIdentityTypedIndexScratchOwner):
        int32 =
    if owner.typedIndexSeen.cap > 0:
        return 1
    return 0

@borrows
fn LoweringSemanticIdentityTypedIndexScratchCapacityBytes(
        owner: LoweringSemanticIdentityTypedIndexScratchOwner):
        int64 =
    return int64(owner.typedIndexSeen.cap) *
           int64(sizeof(bool))

@borrows
fn loweringSemanticIdentityTypedIndexScratchOwnerToken(
        receipt: LoweringSequenceAllocatorReceipt):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(128)
    loweringPlanReleaseAppendText(
        buf,
        "cheng.compiler.lowering.semantic_identity_typed_index_scratch")
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocationEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releaseEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalRetainedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalRetainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalReleasedBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveAllocationCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveCapacityBytes)
    let token = hash256.Sha256Fixed(
        layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn LoweringSemanticIdentityTypedIndexScratchReleaseWithReceipt(
        owner: var LoweringSemanticIdentityTypedIndexScratchOwner,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()) ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(
               LoweringSemanticIdentityTypedIndexScratchPhysicalBufferCount(
                   owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringSemanticIdentityTypedIndexScratchCapacityBytes(owner):
        panic("lowering semantic identity scratch: owner state drift")
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringSemanticIdentityTypedIndexScratchPhysicalBufferCount(owner)
    receipt.terminalRetainedBytes =
        LoweringSemanticIdentityTypedIndexScratchCapacityBytes(owner)
    let releasedBytes =
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.typedIndexSeen,
            sizeof(bool))
    owner.allocatorLedger.closed = true
    receipt.allocationEventCount =
        owner.allocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        owner.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        owner.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        owner.allocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = releasedBytes
    receipt.liveAllocationCount =
        owner.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        owner.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringSemanticIdentityTypedIndexScratchPhysicalBufferCount(
            owner) == 0 &&
        LoweringSemanticIdentityTypedIndexScratchCapacityBytes(owner) ==
            int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering semantic identity scratch: receipt incomplete")
    owner.allocatorReceipt = receipt
    owner.ownerToken =
        loweringSemanticIdentityTypedIndexScratchOwnerToken(receipt)
    owner.allocatorReceiptReady = true
    owner.allocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringSemanticIdentityTypedIndexScratchReceiptConsumeStrict(
        owner: var LoweringSemanticIdentityTypedIndexScratchOwner,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    if !owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt, owner.allocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !layout.FixedBytes32Equal(
           owner.ownerToken,
           loweringSemanticIdentityTypedIndexScratchOwnerToken(receipt)) ||
       LoweringSemanticIdentityTypedIndexScratchPhysicalBufferCount(owner) !=
           0 ||
       LoweringSemanticIdentityTypedIndexScratchCapacityBytes(owner) !=
           int64(0):
        return false
    owner.allocatorReceiptConsumed = true
    return true

fn LoweringSemanticIdentityTypedIndexScratchClose(
        owner: var LoweringSemanticIdentityTypedIndexScratchOwner) =
    var receipt: LoweringSequenceAllocatorReceipt
    LoweringSemanticIdentityTypedIndexScratchReleaseWithReceipt(
        owner, receipt)
    if !LoweringSemanticIdentityTypedIndexScratchReceiptConsumeStrict(
           owner, receipt):
        panic("lowering semantic identity scratch: strict consume failed")

fn LoweringValidateFunctionSemanticIdentityRows(plan: var LoweringPlanStub,
                                                  err: var str): bool =
    let rowCount = plan.functionNames.len
    if plan.functionSourcePaths.len != rowCount ||
       plan.functionOwnerModulePaths.len != rowCount ||
       plan.functionSymbolTexts.len != rowCount ||
       plan.functionSemanticSources.len != rowCount ||
       plan.functionSemanticDeclarationLineIndexes.len != rowCount ||
       plan.functionSemanticParamTypeJoins.len != rowCount ||
       plan.functionSemanticReturnTypes.len != rowCount ||
       plan.functionSemanticSignatureCompletes.len != rowCount ||
       plan.functionTypedIrIndexes.len != rowCount ||
       plan.functionExportedFlags.len != rowCount ||
       plan.functionExportSymbolNames.len != rowCount ||
       plan.functionExportNameExplicitFlags.len != rowCount ||
       plan.functionExportProducerSourceIndexes.len != rowCount ||
       plan.functionExportProducerDeclarationIndexes.len != rowCount ||
       plan.functionExportProducerNodeIds.len != rowCount ||
       plan.functionExportProducerFactCids.len != rowCount ||
       plan.functionNameIds.len != rowCount ||
       plan.functionEntryFlags.len != rowCount ||
       plan.functionCallConvs.len != rowCount ||
       plan.functionResultLayoutKinds.len != rowCount ||
       plan.functionSignatureLineNumbers.len != rowCount ||
       plan.functionBodyLineNumbers.len != rowCount:
        err = Fmt" lowering plan: semantic function row columns mismatch rows={rowCount}"
        return false
    var scratch: LoweringSemanticIdentityTypedIndexScratchOwner
    loweringSequenceAllocatorSetLen(
        scratch,
        LoweringSemanticIdentityTypedIndexScratchLength(
            length: plan.typedIr.functions2_functionNameIds.len))
    for rowIndex in 0..<rowCount:
        let typedIndex = plan.functionTypedIrIndexes[rowIndex]
        if typedIndex < 0 || typedIndex >= scratch.typedIndexSeen.len:
            LoweringSemanticIdentityTypedIndexScratchClose(scratch)
            err = Fmt" lowering plan: semantic function row typed index out of range row={rowIndex} index={typedIndex}"
            return false
        if scratch.typedIndexSeen[typedIndex]:
            LoweringSemanticIdentityTypedIndexScratchClose(scratch)
            err = Fmt" lowering plan: semantic function row typed index duplicated row={rowIndex} index={typedIndex}"
            return false
        scratch.typedIndexSeen[typedIndex] = true
        let typedSourceRes: Result[str] = langintern.LookupIntern(
            plan.typedIr.internPool,
            plan.typedIr.functions2_sourcePathIds[typedIndex])
        let typedNameRes: Result[str] = langintern.LookupIntern(
            plan.typedIr.internPool,
            plan.typedIr.functions2_functionNameIds[typedIndex])
        if !IsOk(typedSourceRes) || !IsOk(typedNameRes):
            LoweringSemanticIdentityTypedIndexScratchClose(scratch)
            err = Fmt" lowering plan: semantic function row typed intern missing row={rowIndex} index={typedIndex}"
            return false
        let typedLine = arenamod.ArenaArrayInt32Get(
            plan.typedIr.arena,
            plan.typedIr.functions2_signatureLineNumbers,
            typedIndex)
        if LoweringCanonicalSourcePath(plan.workspaceRoot,
                                       plan.functionSourcePaths[rowIndex]) !=
           LoweringCanonicalSourcePath(plan.workspaceRoot,
                                       Value(typedSourceRes)) ||
           plan.functionNames[rowIndex] != Value(typedNameRes) ||
           plan.functionNameIds[rowIndex] !=
               plan.typedIr.functions2_functionNameIds[typedIndex] ||
           plan.functionSemanticDeclarationLineIndexes[rowIndex] != typedLine ||
           plan.functionSignatureLineNumbers[rowIndex] != typedLine:
            LoweringSemanticIdentityTypedIndexScratchClose(scratch)
            err = Fmt" lowering plan: semantic function row identity drift row={rowIndex} function={plan.functionNames[rowIndex]} typed_index={typedIndex}"
            return false
    LoweringSemanticIdentityTypedIndexScratchClose(scratch)
    let identityReceipt = LoweringFunctionNameIdentityReceiptCid(plan)
    if !layout.FixedBytes32Equal(
           plan.functionNameIdentityReceiptCid,
           layout.FixedBytes32()) &&
       !layout.FixedBytes32Equal(
           plan.functionNameIdentityReceiptCid,
           identityReceipt):
        err = " lowering plan: function name identity receipt drift"
        return false
    plan.functionNameIdentityReceiptCid = identityReceipt
    err = ""
    return true

fn LoweringBuildExactFunctionNameIdentityColumn(
        plan: var LoweringPlanStub,
        err: var str): bool =
    let rowCount = plan.functionTypedIrIndexes.len
    for rowIndex in 0..<rowCount:
        let typedFunctionIndex = plan.functionTypedIrIndexes[rowIndex]
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >=
               plan.typedIr.functions2_functionNameIds.len:
            err = Fmt" lowering plan: exact function name typed index out of range row={rowIndex} index={typedFunctionIndex}"
            return false
    loweringSequenceAllocatorSetLen(
        plan.functionRuntimeIdentityAllocatorLedger,
        plan.functionNameIds,
        rowCount,
        sizeof(int32))
    for rowIndex in 0..<rowCount:
        let typedFunctionIndex = plan.functionTypedIrIndexes[rowIndex]
        plan.functionNameIds[rowIndex] =
            plan.typedIr.functions2_functionNameIds[typedFunctionIndex]
    err = ""
    return true

@borrows
fn LoweringUniqueTypedCallTargetSignatureLine(
        plan: LoweringPlanStub,
        sourcePathRaw: str,
        functionNameRaw: str): int32 =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let functionName = chengpath.PathTrim(functionNameRaw)
    let tailName = LoweringFunctionTailName(functionName)
    if sourcePath == "" || functionName == "":
        return -1
    var foundLine: int32 = -1
    var foundIndex: int32 = -1
    for fnIndex in 0..<plan.typedIr.functions2_functionNameIds.len:
        let sourceRes: Result[str] = langintern.LookupIntern(
            plan.typedIr.internPool,
            plan.typedIr.functions2_sourcePathIds[fnIndex])
        let nameRes: Result[str] = langintern.LookupIntern(
            plan.typedIr.internPool,
            plan.typedIr.functions2_functionNameIds[fnIndex])
        if !IsOk(sourceRes) || !IsOk(nameRes) ||
           parser.ParserNormalizePath(Value(sourceRes)) != sourcePath ||
           (Value(nameRes) != functionName && Value(nameRes) != tailName):
            continue
        let candidateLine = arenamod.ArenaArrayInt32Get(
            plan.typedIr.arena,
            plan.typedIr.functions2_signatureLineNumbers,
            fnIndex)
        if candidateLine <= 0 || foundLine >= 0:
            return -1
        foundLine = candidateLine
        foundIndex = fnIndex
    return foundIndex

@borrows
fn LoweringSealPrimaryObjectIrCallIdentities(
        fnIr: var PrimaryObjectIrFunction,
        plan: LoweringPlanStub) =
    let callCount = fnIr.callTargets.len
    if fnIr.callArgCounts.len != callCount ||
       fnIr.callTargetSourcePaths.len != callCount ||
       fnIr.callTargetSignatureLineNumbers.len != callCount ||
       fnIr.callTargetImportcFlags.len != callCount ||
       fnIr.callTargetTypedFunctionIndexes.len != callCount ||
       fnIr.callImportcSymbols.len != callCount ||
       fnIr.callArgTypesTexts.len != callCount:
        panic(Fmt"lowering plan: call target CSR shape mismatch function={fnIr.functionName} calls={callCount} lines={fnIr.callTargetSignatureLineNumbers.len}")
    for callIndex in 0..<callCount:
        if fnIr.callTargetImportcFlags[callIndex]:
            if fnIr.callTargetSignatureLineNumbers[callIndex] != 0 ||
               fnIr.callTargetTypedFunctionIndexes[callIndex] != -1:
                panic(Fmt"lowering plan: importc call carries declaration line function={fnIr.functionName} call_index={callIndex}")
            continue
        var targetTypedFunctionIndex =
            fnIr.callTargetTypedFunctionIndexes[callIndex]
        if targetTypedFunctionIndex < 0:
            targetTypedFunctionIndex =
                LoweringUniqueTypedCallTargetSignatureLine(
                    plan,
                    fnIr.callTargetSourcePaths[callIndex],
                    fnIr.callTargets[callIndex])
            if targetTypedFunctionIndex >= 0:
                fnIr.callTargetTypedFunctionIndexes[callIndex] =
                    targetTypedFunctionIndex
        var targetInterfaceCid: layout.FixedBytes32
        if targetTypedFunctionIndex < 0 ||
           !LoweringPlanFunctionInterfaceCidAt(
               plan,
               targetTypedFunctionIndex,
               targetInterfaceCid):
            panic(Fmt"lowering plan: call target exact TypedExpr identity missing function={fnIr.functionName} call_index={callIndex}")

fn LoweringBuildOneFunctionInto(plan: var LoweringPlanStub,
                                 sourceTexts: var texpr.TypedExprSourceText[],
                                 i: int32,
                                 letCallReturnLiteralStart: int32,
                                 out: var PrimaryObjectIrFunction) =
    let sourcePath = plan.functionSourcePaths[i]
    let functionName = plan.functionNames[i]
    var fnIr: PrimaryObjectIrFunction
    fnIr.sourcePath = strings.CloneStr(sourcePath)
    fnIr.functionName = strings.CloneStr(functionName)
    fnIr.typedFunctionIndex = -1
    LoweringResourceGuardCheck()
    var requestedSignatureLineNumber: int32
    if i >= 0 && i < plan.functionSignatureLineNumbers.len:
        requestedSignatureLineNumber = plan.functionSignatureLineNumbers[i]
    if i < 0 || i >= plan.functionTypedIrIndexes.len:
        panic(Fmt"lowering plan: function typed identity missing row={i} function={functionName}")
    let typedFnIndex = plan.functionTypedIrIndexes[i]
    if typedFnIndex < 0 ||
       typedFnIndex >= plan.typedIr.functions2_functionNameIds.len:
        panic(Fmt"lowering plan: function typed identity out of range row={i} function={functionName} index={typedFnIndex}")
    if LoweringRowDebugEnabled() &&
       functionName == loweringRowDebugName:
        os.WriteLine(os.GetStderr(),
                     Fmt"row_debug_lookup source={sourcePath} name={functionName} sig_line={requestedSignatureLineNumber} typed_count={plan.typedIr.functions2_functionNameIds.len} index={typedFnIndex}")
        var dbgSameSourceCount: int32
        var dbgSameSourceMaxLine: int32
        var dbgSameSourceMaxName = ""
        for dbgFnIndex in 0..<plan.typedIr.functions2_functionNameIds.len:
            let dbgFnNameRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_functionNameIds[dbgFnIndex])
            let dbgFnSourceRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_sourcePathIds[dbgFnIndex])
            if !IsOk(dbgFnNameRes) || !IsOk(dbgFnSourceRes):
                continue
            let dbgFnName = Value(dbgFnNameRes)
            let dbgFnSource = Value(dbgFnSourceRes)
            if LoweringSourcePathsEquivalent(dbgFnSource, sourcePath):
                dbgSameSourceCount = dbgSameSourceCount + 1
                if arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_signatureLineNumbers, dbgFnIndex) > dbgSameSourceMaxLine:
                    dbgSameSourceMaxLine = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_signatureLineNumbers, dbgFnIndex)
                    dbgSameSourceMaxName = strings.CloneStr(dbgFnName)
            if dbgFnName == functionName ||
               LoweringFunctionTailName(dbgFnName) == functionName ||
               strutil.Contains(dbgFnName, functionName):
                os.WriteLine(os.GetStderr(),
                             Fmt"row_debug_candidate index={dbgFnIndex} source={dbgFnSource} name={dbgFnName} statements={arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_statementCounts, dbgFnIndex)}")
            if LoweringSourcePathsEquivalent(dbgFnSource, sourcePath) &&
               arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_signatureLineNumbers, dbgFnIndex) >= 4200 &&
               arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_signatureLineNumbers, dbgFnIndex) <= 4500:
                os.WriteLine(os.GetStderr(),
                             Fmt"row_debug_near index={dbgFnIndex} line={arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_signatureLineNumbers, dbgFnIndex)} source={dbgFnSource} name={dbgFnName} statements={arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_statementCounts, dbgFnIndex)}")
        os.WriteLine(os.GetStderr(),
                     Fmt"row_debug_same_source count={dbgSameSourceCount} max_line={dbgSameSourceMaxLine} max_name={dbgSameSourceMaxName}")
    LoweringResourceGuardCheck()
    fnIr.typedFunctionIndex = typedFnIndex
    fnIr.signatureLineNumber = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_signatureLineNumbers, typedFnIndex)
    LoweringAttachDeferScopeTransport(fnIr, plan.typedIr, typedFnIndex)
    LoweringAttachOwnershipTransport(fnIr, plan.typedIr, typedFnIndex)
    LoweringAppendPrimaryObjectIrStatements(fnIr, plan, typedFnIndex, sourceTexts)
    LoweringResourceGuardCheck()
    LoweringFillPrimaryObjectIrParams(fnIr, plan.typedIr, typedFnIndex)
    LoweringResourceGuardCheck()
    var bodyLineNumber: int32
    fnIr.bodyKind = LoweringPrimaryObjectIrLeafBodyKindFromTypedIrIndex(plan.typedIr, typedFnIndex, bodyLineNumber)
    LoweringResourceGuardCheck()
    fnIr.bodyLineNumber = bodyLineNumber
    var hasLetCall = false
    if typedFnIndex >= 0 && LoweringTypedIrFunctionHasOpKind(plan.typedIr, typedFnIndex, texpr.TypedExprIrOpLetCall):
        hasLetCall = true
    var hasControlFlow = false
    var hasSideEffectStatement = false
    var sideEffectStatementCount: int32
    if typedFnIndex >= 0:
        var stmtEnd = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_statementStarts, typedFnIndex) + arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_statementCounts, typedFnIndex)
        if stmtEnd > plan.typedIr.statements2_statementIndexs.len:
            stmtEnd = plan.typedIr.statements2_statementIndexs.len
        for si in arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_statementStarts, typedFnIndex)..<stmtEnd:
            let stmtKind = plan.typedIr.statements2_kinds[si]
            if stmtKind == texpr.TypedExprIrStmtIf || stmtKind == texpr.TypedExprIrStmtElif || stmtKind == texpr.TypedExprIrStmtElse || stmtKind == texpr.TypedExprIrStmtFor:
                hasControlFlow = true
            if stmtKind == texpr.TypedExprIrStmtCall || stmtKind == texpr.TypedExprIrStmtLetCall || stmtKind == texpr.TypedExprIrStmtIfCall || stmtKind == texpr.TypedExprIrStmtResultIntrinsic:
                hasSideEffectStatement = true
                sideEffectStatementCount = sideEffectStatementCount + 1
            # An assignment is an observable side effect: it can write through a
            # global seq / out-param / field (`gArr[i] = ...`). Without counting
            # it, a void function whose only effect is a stored mutation under
            # control flow (selection sort's in-loop swap) was wrongly classified
            # as an empty BodyKindReturnVoid and emitted as a bare `ret` — the
            # sort became a no-op. Treat StmtAssign as a side effect so the full
            # body is lowered.
            if stmtKind == texpr.TypedExprIrStmtAssign:
                hasSideEffectStatement = true
                sideEffectStatementCount = sideEffectStatementCount + 1
    if hasControlFlow:
        fnIr.bodyKind = texpr.BodyKindStatementSequence
    if hasControlFlow && !hasLetCall && !hasSideEffectStatement && typedFnIndex >= 0 && typedFnIndex < plan.typedIr.functions2_functionNameIds.len:
        let returnTypeRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_returnTypeIds[typedFnIndex])
        if IsOk(returnTypeRes):
            let returnType = Value(returnTypeRes)
            if returnType == "" || returnType == "void":
                fnIr.bodyKind = texpr.BodyKindReturnVoid
    if fnIr.bodyKind == texpr.BodyKindUnsupported && LoweringTypedIrFunctionIsVoidReturn(plan.typedIr, typedFnIndex):
        fnIr.bodyKind = texpr.BodyKindReturnVoid
    let functionTailName = LoweringFunctionTailName(fnIr.functionName)
    if functionTailName == "__cheng_setCmdLine_export":
        fnIr.bodyKind = texpr.BodyKindRuntimeSetCmdLine
    elif functionTailName == "paramCount_export" || functionTailName == "__cheng_rt_paramCount_export" || functionTailName == "__cmdCountFromRuntime_export" || functionTailName == "cmdCountFromRuntime_export":
        fnIr.bodyKind = texpr.BodyKindRuntimeParamCount
    elif functionTailName == "__cheng_rt_paramStrCopyBridge_export":
        fnIr.bodyKind = texpr.BodyKindRuntimeParamStrCopyBridge
    if fnIr.bodyKind == "missing_call_target" &&
       LoweringPrimaryObjectIrHasFnPtrCallTarget(fnIr, plan, sourceTexts):
        fnIr.bodyKind = texpr.BodyKindStatementSequence
    if typedFnIndex >= 0 && typedFnIndex < plan.typedIr.functions2_functionNameIds.len:
        let _ = LoweringApplyPureCastReturnBodyKind(fnIr, plan, typedFnIndex)
    if LoweringRowDebugEnabled() &&
       functionName == loweringRowDebugName:
        os.WriteLine(os.GetStderr(),
                     Fmt"row_debug name={functionName} typed_index={typedFnIndex} statements={fnIr.statements.len} body_kind={fnIr.bodyKind} body_line={bodyLineNumber} has_let_call={hasLetCall} side_effect_count={sideEffectStatementCount} control_flow={hasControlFlow}")
        for dbgStmtIndex in 0..<fnIr.statements.len:
            let dbgStmt = fnIr.statements[dbgStmtIndex]
            os.WriteLine(os.GetStderr(),
                         Fmt"row_debug_stmt index={dbgStmtIndex} line={dbgStmt.lineNumber} kind={dbgStmt.kind} callee={dbgStmt.callCallee} target={dbgStmt.callTarget} args={dbgStmt.callArgCount}")
    if (fnIr.bodyKind == texpr.BodyKindUnsupported || fnIr.bodyKind == "" || hasLetCall) && sideEffectStatementCount <= 1:
        var callIndex = LoweringFindResolvedCallFactIndex(plan, sourcePath, bodyLineNumber)
        # Ok[T](v)/Err[T](msg) 构造内征不是真调用：单调用体分类会把构造头登记为
        # callTarget 并设模板 body_kind，但 Ok/Err 经 AppendResultConstruct 内联物化、
        # body-IR 无对应 call op → 调用序列不一致。重置 callIndex 让函数走通用
        # statement_sequence 路径（节点求值器自身构造 Result）。
        if callIndex >= 0 && LoweringCallTargetIsResultConstruct(LoweringResolvedCallSnapshotText(plan,
                                                                                                  plan.resolvedCallSnapshot.callTargetIds[callIndex])):
            callIndex = -1
        if callIndex >= 0:
            let fact = LoweringResolvedCallSnapshotFactAt(plan, callIndex)
            var directReturnRoot = false
            if typedFnIndex >= 0 &&
               typedFnIndex < plan.typedIr.functions2_functionNameIds.len:
                let returnExprRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_returnExprIds[typedFnIndex])
                let returnTypeRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_returnTypeIds[typedFnIndex])
                if IsOk(returnExprRes) && IsOk(returnTypeRes):
                    let returnExprText = Value(returnExprRes)
                    let returnTypeText = Value(returnTypeRes)
                    # The returnRoot fact flag is set for calls that appear inside
                    # wrapped return expressions (casts/derefs); the template body
                    # kinds drop the wrapper, so require the return expression to
                    # be exactly the call before classifying as a passthrough.
                    if fact.returnRoot &&
                       LoweringReturnExprMatchesCallFact(returnExprText, fact):
                        directReturnRoot = true
                    let directReturnNormType = texpr.TypedExprNormalizeTypeText(returnTypeText)
                    if !directReturnRoot &&
                       (directReturnNormType == "int32" || directReturnNormType == "int64") &&
                       fact.lineNumber == bodyLineNumber &&
                       LoweringReturnExprMatchesCallFact(returnExprText, fact):
                        directReturnRoot = true
            elif fact.returnRoot:
                directReturnRoot = true
            if directReturnRoot:
                var pureCastApplied = false
                if typedFnIndex >= 0 &&
                   typedFnIndex < plan.typedIr.functions2_functionNameIds.len:
                    pureCastApplied = LoweringApplyPureCastReturnBodyKind(fnIr,
                                                                          plan,
                                                                          typedFnIndex)
                if pureCastApplied:
                    let _ = pureCastApplied
                else:
                    if LoweringReturnCallArgsPassThrough(fnIr.paramNames, fact.callArgsText, fact.callArgCount):
                        var firstImportcSymbol = ""
                        if fact.callTargetImportc:
                            firstImportcSymbol = LoweringImportcTargetSymbolTyped(plan.typedIr, sourceTexts, fact.callTargetSourcePath, fact.callTarget)
                        # TypedExprFact (C5 SoA carrier) 无 callArgTypesText 列——该值经
                        # CompilerCsgSemanticResolvedCallTable 持久化快照重建, 快照 schema 本身
                        # 未收录实参类型文本; 按行号回查 fnIr.statements (本函数全新前端
                        # 构建产物, 已含真值) 补回, 免于扩展共享持久化快照 schema。
                        LoweringPrimaryObjectIrCallTargetAppendExactRow(
                            fnIr,
                            fact.callArgCount,
                            fact.callTarget,
                            LoweringFactCallTargetSourcePath(
                                plan, sourcePath, fact),
                            fact.callTargetSignatureLineNumber,
                            fact.callTargetImportc,
                            LoweringResolvedCallTargetTypedFunctionIndexAt(
                                plan, callIndex),
                            firstImportcSymbol,
                            LoweringStatementCallArgTypesTextAtLine(
                                fnIr, fact.lineNumber))
            else:
                var firstImportcSymbol = ""
                if fact.callTargetImportc:
                    firstImportcSymbol = LoweringImportcTargetSymbolTyped(plan.typedIr, sourceTexts, fact.callTargetSourcePath, fact.callTarget)
                LoweringPrimaryObjectIrCallTargetAppendExactRow(
                    fnIr,
                    fact.callArgCount,
                    fact.callTarget,
                    LoweringFactCallTargetSourcePath(
                        plan, sourcePath, fact),
                    fact.callTargetSignatureLineNumber,
                    fact.callTargetImportc,
                    LoweringResolvedCallTargetTypedFunctionIndexAt(
                        plan, callIndex),
                    firstImportcSymbol,
                    LoweringStatementCallArgTypesTextAtLine(
                        fnIr, fact.lineNumber))
    if fnIr.bodyKind == texpr.BodyKindUnsupported && typedFnIndex >= 0 && typedFnIndex < plan.typedIr.functions2_functionNameIds.len:
        if arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_returnNodeIndexs, typedFnIndex) >= 0 && arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_returnNodeIndexs, typedFnIndex) < plan.typedIr.nodes2_nodeIndexs.len:
            let retNodeIdx = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_returnNodeIndexs, typedFnIndex)
            let retSourcePath = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_sourcePathIds[retNodeIdx]))
            let retFunctionName = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_functionNameIds[retNodeIdx]))
            let retNodeIndex = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_nodeIndexs, retNodeIdx)
            let retLineNumber = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_lineNumbers, retNodeIdx)
            let retOpKind = plan.typedIr.nodes2_opKinds[retNodeIdx]
            let retStructuralTypeId =
                texpr.TypedExprIrNodeStructuralTypeIdAt(
                    plan.typedIr, retNodeIdx)
            let retResultType = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_resultTypeIds[retNodeIdx]))
            let retSurfaceText = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_surfaceTextIds[retNodeIdx]))
            let retParamSlot = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_paramSlots, retNodeIdx)
            let retParamName = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_paramNameIds[retNodeIdx]))
            let retOperand0 = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_operand0NodeIndexs, retNodeIdx)
            let retOperand1 = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_operand1NodeIndexs, retNodeIdx)
            let retOperand2 = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_operand2NodeIndexs, retNodeIdx)
            let retLiteralText = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_literalTextIds[retNodeIdx]))
            let retFieldTypeSourcePath = Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.nodes2_fieldTypeSourcePathIds[retNodeIdx]))
            let retFieldOffset = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_fieldOffsetBytes, retNodeIdx)
            let retFieldSize = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_fieldSizeBytes, retNodeIdx)
            let retFieldAlign = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_fieldAlignBytes, retNodeIdx)
            let retElemSize = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.nodes2_elemSizeBytes, retNodeIdx)
            let returnNode = texpr.TypedExprIrNode(
                sourcePath: retSourcePath,
                functionName: retFunctionName,
                nodeIndex: retNodeIndex,
                lineNumber: retLineNumber,
                opKind: retOpKind,
                resultStructuralTypeId: retStructuralTypeId,
                resultType: retResultType,
                surfaceText: retSurfaceText,
                paramSlot: retParamSlot,
                paramName: retParamName,
                operand0NodeIndex: retOperand0,
                operand1NodeIndex: retOperand1,
                operand2NodeIndex: retOperand2,
                literalText: retLiteralText,
                fieldTypeSourcePath: retFieldTypeSourcePath,
                fieldOffsetBytes: retFieldOffset,
                fieldSizeBytes: retFieldSize,
                fieldAlignBytes: retFieldAlign,
                elemSizeBytes: retElemSize,
            )
    var canInspectReturnZero = false
    if fnIr.bodyKind == texpr.BodyKindUnsupported:
        canInspectReturnZero = true
    if fnIr.bodyKind == texpr.BodyKindStatementSequence:
        canInspectReturnZero = true
    if canInspectReturnZero && typedFnIndex >= 0 && typedFnIndex < plan.typedIr.functions2_functionNameIds.len:
        let returnExprRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_returnExprIds[typedFnIndex])
        var hasReturnZero = false
        if IsOk(returnExprRes):
            let returnExprText = Value(returnExprRes)
            hasReturnZero = returnExprText == "return int32(0)" || returnExprText == "return 0" || returnExprText == "int32(0)" || returnExprText == "0"
        if hasReturnZero && fnIr.statements.len == 1:
            let stmt = fnIr.statements[0]
            let callArgsText = chengpath.PathTrim(stmt.callArgsText)
            var callArgIsZero = false
            if callArgsText == "int32(0)":
                callArgIsZero = true
            if callArgsText == "0":
                callArgIsZero = true
            if stmt.kind == texpr.TypedExprIrStmtCall && stmt.callArgCount == 1 && callArgIsZero && len(stmt.callTarget) > 0:
                if fnIr.callTargets.len <= 0:
                    var stmtCallTargetSourcePath = stmt.callTargetSourcePath
                    if len(stmtCallTargetSourcePath) <= 0:
                        stmtCallTargetSourcePath = stmt.sourcePath
                    var targetTypedFunctionIndex: int32 = -1
                    let snapshotCallId =
                        LoweringPlanSnapshotCallIdForTypedIrNodeIndex(
                            plan, stmt.rhsNodeIndex)
                    if snapshotCallId >= 0:
                        targetTypedFunctionIndex =
                            LoweringPlanSnapshotCallTargetTypedFunctionIndexAt(
                                plan, snapshotCallId)
                    var importcSymbol = ""
                    if stmt.callTargetImportc:
                        importcSymbol = LoweringImportcTargetSymbolTyped(plan.typedIr,
                                                                         sourceTexts,
                                                                         stmt.callTargetSourcePath,
                                                                         stmt.callTarget)
                    LoweringPrimaryObjectIrCallTargetAppendExactRow(
                        fnIr,
                        stmt.callArgCount,
                        stmt.callTarget,
                        stmtCallTargetSourcePath,
                        stmt.callTargetSignatureLineNumber,
                        stmt.callTargetImportc,
                        targetTypedFunctionIndex,
                        importcSymbol,
                        stmt.callArgTypesText)
                if fnIr.callTargets.len == 1:
                    fnIr.bodyKind = texpr.BodyKindCallArg0Const0ReturnI32Const0
    if fnIr.bodyKind == texpr.BodyKindUnsupported:
        LoweringMaybeFillBackendDriverRunCommand(fnIr)
        LoweringMaybeFillBackendDriverRunCommandWithCmd(fnIr)
        LoweringMaybeFillBackendDriverPrintBridge(fnIr)
    if fnIr.bodyKind == texpr.BodyKindUnsupported && typedFnIndex >= 0 && typedFnIndex < plan.typedIr.functions2_functionNameIds.len:
        let returnTypeRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_returnTypeIds[typedFnIndex])
        let commandCodeTailName = LoweringFunctionTailName(fnIr.functionName)
        if commandCodeTailName == "BackendDriverDispatchMinCommandCode" && IsOk(returnTypeRes):
            if texpr.TypedExprNormalizeTypeText(Value(returnTypeRes)) == "int32" &&
               fnIr.paramNames.len == 1 &&
                fnIr.paramTypes.len == 1 &&
               texpr.TypedExprNormalizeTypeText(fnIr.paramTypes[0]) == "str":
                fnIr.bodyKind = texpr.BodyKindBackendDriverCommandCode
                LoweringPrimaryObjectIrCallTargetClear(fnIr)
    LoweringFillGeneralCfgCallSequenceFromSnapshot(fnIr,
                                                   plan,
                                                   typedFnIndex,
                                                   sourceTexts)
    LoweringFillGeneralCfgCallSequenceFromStatements(fnIr, plan, sourceTexts)
    LoweringFillReturnWholeCallSequenceFromTypedFunction(fnIr,
                                                         plan,
                                                         typedFnIndex,
                                                         sourceTexts)
    if fnIr.bodyKind == texpr.BodyKindUnsupported && fnIr.statements.len > 0:
        fnIr.bodyKind = texpr.BodyKindStatementSequence
    LoweringRemoveBuiltinCallTargets(fnIr, plan, sourceTexts)
    if typedFnIndex >= 0 && typedFnIndex < plan.typedIr.functions2_functionNameIds.len:
        let _ = LoweringApplyPureCastReturnBodyKind(fnIr, plan, typedFnIndex)
    LoweringSealPrimaryObjectIrCallIdentities(fnIr, plan)
    fnIr.callTargetCount = fnIr.callTargets.len
    out.sourcePath = fnIr.sourcePath
    out.functionName = fnIr.functionName
    out.signatureLineNumber = fnIr.signatureLineNumber
    out.bodyLineNumber = fnIr.bodyLineNumber
    out.bodyKind = fnIr.bodyKind
    out.typedFunctionIndex = fnIr.typedFunctionIndex
    out.paramNames = fnIr.paramNames
    out.paramTypes = fnIr.paramTypes
    out.statementCount = fnIr.statementCount
    out.statements = fnIr.statements
    out.functionShapeAllocatorLedger =
        fnIr.functionShapeAllocatorLedger
    out.callTargetCount = fnIr.callTargetCount
    out.callArgCounts = fnIr.callArgCounts
    out.callTargets = fnIr.callTargets
    out.callTargetSourcePaths = fnIr.callTargetSourcePaths
    out.callTargetSignatureLineNumbers =
        fnIr.callTargetSignatureLineNumbers
    out.callTargetImportcFlags = fnIr.callTargetImportcFlags
    out.callTargetTypedFunctionIndexes =
        fnIr.callTargetTypedFunctionIndexes
    out.callImportcSymbols = fnIr.callImportcSymbols
    out.callArgTypesTexts = fnIr.callArgTypesTexts
    out.callTargetAllocatorLedger = fnIr.callTargetAllocatorLedger
    out.deferScopeTransport = fnIr.deferScopeTransport
    out.ownershipTransport = fnIr.ownershipTransport
    out.bodyIR = fnIr.bodyIR
    out.bodyIrNoAliasApplied = fnIr.bodyIrNoAliasApplied
    out.bodyIrNoAliasLocalCount = fnIr.bodyIrNoAliasLocalCount
    out.bodyIrNoAliasForwardRewriteCount = fnIr.bodyIrNoAliasForwardRewriteCount

fn LoweringFillSkippedPrimaryObjectIrDescriptor(plan: var LoweringPlanStub,
                                                 functionIndex: int32,
                                                 out: var PrimaryObjectIrFunction) =
    if functionIndex < 0:
        return
    if functionIndex < plan.functionSourcePaths.len:
        out.sourcePath = plan.functionSourcePaths[functionIndex]
    if functionIndex < plan.functionNames.len:
        out.functionName = plan.functionNames[functionIndex]
    out.typedFunctionIndex = -1
    if len(out.sourcePath) <= 0 || len(out.functionName) <= 0:
        return
    if functionIndex >= plan.functionTypedIrIndexes.len:
        panic(Fmt"lowering plan: skipped function typed identity missing row={functionIndex} function={out.functionName}")
    let typedFnIndex = plan.functionTypedIrIndexes[functionIndex]
    out.typedFunctionIndex = typedFnIndex
    if typedFnIndex < 0 ||
       typedFnIndex >= plan.typedIr.functions2_functionNameIds.len:
        panic(Fmt"lowering plan: skipped function typed identity out of range row={functionIndex} function={out.functionName} index={typedFnIndex}")
    out.signatureLineNumber = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_signatureLineNumbers, typedFnIndex)
    var bodyLineNumber: int32
    out.bodyKind = LoweringPrimaryObjectIrLeafBodyKindFromTypedIrIndex(plan.typedIr,
                                                                       typedFnIndex,
                                                                       bodyLineNumber)
    out.bodyLineNumber = bodyLineNumber
    LoweringFillPrimaryObjectIrParams(out, plan.typedIr, typedFnIndex)

@borrows
fn FunctionTaskPublishBodyIrIdentity(workerId: int32,
                                     funcIndex: int32,
                                     resultCid: layout.FixedBytes32) =
    if workerId < 0:
        return
    var workerIds: int32[] = loweringParallelResultIdentity.workerIds
    var resultCids: layout.FixedBytes32[] = loweringParallelResultIdentity.resultCids
    if funcIndex >= workerIds.len ||
       funcIndex >= resultCids.len:
        panic("function_task_executor_result_column_missing")
    workerIds[funcIndex] = workerId
    resultCids[funcIndex] = layout.FixedBytes32Copy(resultCid)

@borrows
fn FunctionTaskExecuteBodyIr(workerId: int32,
                             funcIndex: int32) =
    if loweringParallelBuildFlags.len > funcIndex && !loweringParallelBuildFlags[funcIndex]:
        var skippedFn: PrimaryObjectIrFunction
        LoweringFillSkippedPrimaryObjectIrDescriptor(loweringParallelPlan,
                                                     funcIndex,
                                                     skippedFn)
        LoweringCopyPrimaryObjectIrFunctionInto(
            skippedFn, loweringParallelResults[funcIndex])
        FunctionTaskMarkBodyIrResultReady(funcIndex)
        return
    var fnIr: PrimaryObjectIrFunction
    LoweringBuildOneFunctionInto(loweringParallelPlan,
                                  loweringParallelSourceTexts,
                                  funcIndex,
                                  loweringParallelLetCallReturnLiteralStart,
                                  fnIr)
    let resultCid = coreir.BodyIRCleanupSourceControlCid(fnIr.bodyIR)
    if layout.FixedBytes32Equal(resultCid, layout.FixedBytes32()):
        panic("function_task_executor_result_cid_missing")
    LoweringCopyPrimaryObjectIrFunctionInto(
        fnIr, loweringParallelResults[funcIndex])
    FunctionTaskPublishBodyIrIdentity(workerId, funcIndex, resultCid)
    FunctionTaskMarkBodyIrResultReady(funcIndex)

@borrows
fn FunctionTaskResultLockAcquire(lock: atomic.I32) =
    if lock == nil:
        return
    while !atomic.CasI32(lock, 0, 1):
        thread.Yield()

@borrows
fn FunctionTaskResultLockRelease(lock: atomic.I32) =
    if lock == nil:
        return
    atomic.StoreI32(lock, 0)

fn FunctionTaskMarkBodyIrResultReady(funcIndex: int32) =
    if funcIndex >= 0 && funcIndex < loweringParallelResultReadyFlags.len:
        loweringParallelResultReadyFlags[funcIndex] = 1

fn FunctionTaskBuildMaterializedTasks(functionCount: int32): int32[] =
    var tasks: int32[]
    for i in 0..<functionCount:
        if loweringParallelBuildFlags.len > i && !loweringParallelBuildFlags[i]:
            FunctionTaskExecuteBodyIr(-1, i)
            continue
        add(tasks, i)
    return tasks

fn FunctionTaskExecuteSerial(functionCount: int32) =
    for i in 0..<functionCount:
        FunctionTaskExecuteBodyIr(-1, i)

@borrows
fn FunctionTaskParticipantRootFromFixed(
        value: layout.FixedBytes32):
        system.RuntimeAllocationLedgerParticipantRoot =
    var out: system.RuntimeAllocationLedgerParticipantRoot
    for byteIndex in 0..<8:
        out.word0 = (out.word0 << uint64(8)) |
            uint64(value.data[byteIndex])
        out.word1 = (out.word1 << uint64(8)) |
            uint64(value.data[8 + byteIndex])
        out.word2 = (out.word2 << uint64(8)) |
            uint64(value.data[16 + byteIndex])
        out.word3 = (out.word3 << uint64(8)) |
            uint64(value.data[24 + byteIndex])
    return out

@borrows
fn FunctionTaskParticipantRootEqual(
        left: system.RuntimeAllocationLedgerParticipantRoot,
        right: system.RuntimeAllocationLedgerParticipantRoot): bool =
    return left.word0 == right.word0 &&
        left.word1 == right.word1 &&
        left.word2 == right.word2 &&
        left.word3 == right.word3

fn FunctionTaskParallelBoundaryCid(
        functionCount: int32,
        actualWorkerCount: int32,
        taskCount: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(64)
    loweringPlanReleaseAppendText(
        buf, "cheng.compiler.lowering.function_task.parallel_boundary.v1")
    loweringFunctionNameIdentityAppendU32(buf, functionCount)
    loweringFunctionNameIdentityAppendU32(buf, actualWorkerCount)
    loweringFunctionNameIdentityAppendU32(buf, taskCount)
    layout.ByteBufAppendFixed32(
        buf, loweringParallelPlan.sourceBundleCid)
    layout.ByteBufAppendFixed32(
        buf, loweringParallelPlan.compilerCsgCid)
    layout.ByteBufAppendFixed32(
        buf,
        loweringParallelPlan.canonicalSnapshotProjectionAuthorityCid)
    for workerId in 0..<actualWorkerCount:
        loweringFunctionNameIdentityAppendU32(buf, workerId)
        loweringFunctionNameIdentityAppendU32(
            buf, (taskCount * workerId) / actualWorkerCount)
        loweringFunctionNameIdentityAppendU32(
            buf, (taskCount * (workerId + 1)) / actualWorkerCount)
    loweringFunctionNameIdentityAppendU32(
        buf, loweringParallelTaskFunctionIndices.len)
    for taskRow in 0..<loweringParallelTaskFunctionIndices.len:
        loweringFunctionNameIdentityAppendU32(
            buf, loweringParallelTaskFunctionIndices[taskRow])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn FunctionTaskWorkerResultCid(
        workerId: int32,
        boundaryCid: layout.FixedBytes32): layout.FixedBytes32 =
    var selectedCount: int32
    for taskRow in 0..<loweringParallelTaskFunctionIndices.len:
        let funcIndex = loweringParallelTaskFunctionIndices[taskRow]
        if funcIndex >= 0 &&
           funcIndex < loweringParallelResultIdentity.workerIds.len &&
           loweringParallelResultIdentity.workerIds[funcIndex] == workerId:
            selectedCount = selectedCount + 1
    var buf = layout.ByteBufInit(64)
    loweringPlanReleaseAppendText(
        buf, "cheng.compiler.lowering.function_task.worker_result.v1")
    layout.ByteBufAppendFixed32(buf, boundaryCid)
    loweringFunctionNameIdentityAppendU32(buf, workerId)
    loweringFunctionNameIdentityAppendU32(buf, selectedCount)
    for taskRow in 0..<loweringParallelTaskFunctionIndices.len:
        let funcIndex = loweringParallelTaskFunctionIndices[taskRow]
        if funcIndex < 0 ||
           funcIndex >= loweringParallelResultIdentity.workerIds.len ||
           loweringParallelResultIdentity.workerIds[funcIndex] != workerId:
            continue
        if funcIndex >= loweringParallelResultReadyFlags.len ||
           loweringParallelResultReadyFlags[funcIndex] != 1 ||
           funcIndex >= loweringParallelResultIdentity.resultCids.len ||
           layout.FixedBytes32Equal(
               loweringParallelResultIdentity.resultCids[funcIndex],
               layout.FixedBytes32()):
            layout.ByteBufFree(buf)
            panic("function_task_executor_result_column_incomplete")
        loweringFunctionNameIdentityAppendU32(buf, funcIndex)
        layout.ByteBufAppendFixed32(
            buf, loweringParallelResultIdentity.resultCids[funcIndex])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn FunctionTaskParticipantSourceStore(
        workerId: int32,
        capability: var
            system.RuntimeAllocationLedgerParticipantCapability) =
    var sourceRows: int32[] = loweringParallelParticipantStorage.sourceRows
    var sourceGenerations: int32[] =
        loweringParallelParticipantStorage.sourceGenerations
    var sourceOwners: int32[] = loweringParallelParticipantStorage.sourceOwners
    if workerId < 0 ||
       workerId >= sourceRows.len ||
       sourceRows[workerId] != 0 ||
       sourceGenerations[workerId] != 0 ||
       sourceOwners[workerId] != 0:
        panic("function_task_participant_source_store_invalid")
    sourceRows[workerId] = capability.row
    sourceGenerations[workerId] = capability.generation
    sourceOwners[workerId] = capability.owner
    capability = system.RuntimeAllocationLedgerParticipantCapability()
    if !system.RuntimeAllocationLedgerParticipantCapabilityIsEmpty(
           capability):
        panic("function_task_participant_source_store_not_cleared")

@borrows
fn FunctionTaskParticipantSourceTake(
        workerId: int32,
        capability: var
            system.RuntimeAllocationLedgerParticipantCapability) =
    var sourceRows: int32[] = loweringParallelParticipantStorage.sourceRows
    var sourceGenerations: int32[] =
        loweringParallelParticipantStorage.sourceGenerations
    var sourceOwners: int32[] = loweringParallelParticipantStorage.sourceOwners
    if workerId < 0 ||
       workerId >= sourceRows.len ||
       sourceGenerations[workerId] <= 0 ||
       sourceOwners[workerId] <= 0:
        panic("function_task_participant_source_take_invalid")
    capability.row = sourceRows[workerId]
    capability.generation = sourceGenerations[workerId]
    capability.owner = sourceOwners[workerId]
    sourceRows[workerId] = 0
    sourceGenerations[workerId] = 0
    sourceOwners[workerId] = 0
    if sourceRows[workerId] != 0 ||
       sourceGenerations[workerId] != 0 ||
       sourceOwners[workerId] != 0:
        panic("function_task_participant_source_take_not_cleared")

@borrows
fn FunctionTaskParticipantTerminalStore(
        workerId: int32,
        capability: var
            system.RuntimeAllocationLedgerParticipantCapability,
        result: system.RuntimeAllocationLedgerParticipantRoot) =
    var terminalRows: int32[] = loweringParallelParticipantStorage.terminalRows
    var terminalGenerations: int32[] =
        loweringParallelParticipantStorage.terminalGenerations
    var terminalOwners: int32[] =
        loweringParallelParticipantStorage.terminalOwners
    var terminalResultWord0s: uint64[] =
        loweringParallelParticipantStorage.terminalResultWord0s
    var terminalResultWord1s: uint64[] =
        loweringParallelParticipantStorage.terminalResultWord1s
    var terminalResultWord2s: uint64[] =
        loweringParallelParticipantStorage.terminalResultWord2s
    var terminalResultWord3s: uint64[] =
        loweringParallelParticipantStorage.terminalResultWord3s
    if workerId < 0 ||
       workerId >= terminalRows.len ||
       terminalGenerations[workerId] != 0 ||
       terminalOwners[workerId] != 0:
        panic("function_task_participant_terminal_store_invalid")
    terminalRows[workerId] = capability.row
    terminalGenerations[workerId] = capability.generation
    terminalOwners[workerId] = capability.owner
    terminalResultWord0s[workerId] = result.word0
    terminalResultWord1s[workerId] = result.word1
    terminalResultWord2s[workerId] = result.word2
    terminalResultWord3s[workerId] = result.word3
    capability = system.RuntimeAllocationLedgerParticipantCapability()
    if !system.RuntimeAllocationLedgerParticipantCapabilityIsEmpty(
           capability):
        panic("function_task_participant_terminal_store_not_cleared")

@borrows
fn FunctionTaskParticipantTerminalTake(
        workerId: int32,
        capability: var
            system.RuntimeAllocationLedgerParticipantCapability,
        result: var system.RuntimeAllocationLedgerParticipantRoot) =
    var terminalRows: int32[] = loweringParallelParticipantStorage.terminalRows
    var terminalGenerations: int32[] =
        loweringParallelParticipantStorage.terminalGenerations
    var terminalOwners: int32[] =
        loweringParallelParticipantStorage.terminalOwners
    var terminalResultWord0s: uint64[] =
        loweringParallelParticipantStorage.terminalResultWord0s
    var terminalResultWord1s: uint64[] =
        loweringParallelParticipantStorage.terminalResultWord1s
    var terminalResultWord2s: uint64[] =
        loweringParallelParticipantStorage.terminalResultWord2s
    var terminalResultWord3s: uint64[] =
        loweringParallelParticipantStorage.terminalResultWord3s
    if workerId < 0 ||
       workerId >= terminalRows.len ||
       terminalGenerations[workerId] <= 0 ||
       terminalOwners[workerId] <= 0:
        panic("function_task_participant_terminal_take_invalid")
    capability.row = terminalRows[workerId]
    capability.generation = terminalGenerations[workerId]
    capability.owner = terminalOwners[workerId]
    result.word0 = terminalResultWord0s[workerId]
    result.word1 = terminalResultWord1s[workerId]
    result.word2 = terminalResultWord2s[workerId]
    result.word3 = terminalResultWord3s[workerId]
    terminalRows[workerId] = 0
    terminalGenerations[workerId] = 0
    terminalOwners[workerId] = 0
    terminalResultWord0s[workerId] = uint64(0)
    terminalResultWord1s[workerId] = uint64(0)
    terminalResultWord2s[workerId] = uint64(0)
    terminalResultWord3s[workerId] = uint64(0)

fn loweringFunctionTaskAllocatorReceiptSeal(
        ledger: var LoweringSequenceAllocatorLedger,
        terminalRetainedBufferCount: int32,
        terminalRetainedBytes: int64,
        terminalReleasedBufferCount: int32,
        terminalReleasedBytes: int64,
        storageReleased: bool,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if ledger.closed ||
       terminalRetainedBufferCount < 0 ||
       terminalRetainedBufferCount != terminalReleasedBufferCount ||
       terminalRetainedBytes < int64(0) ||
       terminalRetainedBytes != terminalReleasedBytes ||
       !storageReleased:
        panic("function task allocator: terminal release drift")
    ledger.closed = true
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.allocationEventCount = ledger.allocationEventCount
    receipt.releaseEventCount = ledger.releaseEventCount
    receipt.allocatedCapacityBytes = ledger.allocatedCapacityBytes
    receipt.releasedCapacityBytes = ledger.releasedCapacityBytes
    receipt.terminalRetainedBufferCount = terminalRetainedBufferCount
    receipt.terminalRetainedBytes = terminalRetainedBytes
    receipt.terminalReleasedBufferCount = terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount = ledger.liveAllocationCount
    receipt.liveCapacityBytes = ledger.liveCapacityBytes
    receipt.storageReleased = storageReleased
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("function task allocator: receipt incomplete")

@borrows
fn LoweringFunctionTaskParticipantStoragePhysicalBufferCount(
        owner: LoweringFunctionTaskParticipantStorageOwner): int32 =
    var count: int32
    if owner.sourceRows.cap > 0:
        count = count + 1
    if owner.sourceGenerations.cap > 0:
        count = count + 1
    if owner.sourceOwners.cap > 0:
        count = count + 1
    if owner.terminalRows.cap > 0:
        count = count + 1
    if owner.terminalGenerations.cap > 0:
        count = count + 1
    if owner.terminalOwners.cap > 0:
        count = count + 1
    if owner.terminalResultWord0s.cap > 0:
        count = count + 1
    if owner.terminalResultWord1s.cap > 0:
        count = count + 1
    if owner.terminalResultWord2s.cap > 0:
        count = count + 1
    if owner.terminalResultWord3s.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringFunctionTaskParticipantStorageCapacityBytes(
        owner: LoweringFunctionTaskParticipantStorageOwner): int64 =
    return int64(owner.sourceRows.cap) * int64(sizeof(int32)) +
        int64(owner.sourceGenerations.cap) * int64(sizeof(int32)) +
        int64(owner.sourceOwners.cap) * int64(sizeof(int32)) +
        int64(owner.terminalRows.cap) * int64(sizeof(int32)) +
        int64(owner.terminalGenerations.cap) * int64(sizeof(int32)) +
        int64(owner.terminalOwners.cap) * int64(sizeof(int32)) +
        int64(owner.terminalResultWord0s.cap) * int64(sizeof(uint64)) +
        int64(owner.terminalResultWord1s.cap) * int64(sizeof(uint64)) +
        int64(owner.terminalResultWord2s.cap) * int64(sizeof(uint64)) +
        int64(owner.terminalResultWord3s.cap) * int64(sizeof(uint64))

@borrows
fn loweringFunctionTaskParticipantStorageOwnerToken(
        owner: LoweringFunctionTaskParticipantStorageOwner,
        receipt: LoweringSequenceAllocatorReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(192)
    loweringPlanReleaseAppendText(
        buf,
        "cheng.compiler.lowering.function_task_participant_storage")
    loweringPlanReleaseAppendU32Field(buf, owner.domain.functionCount)
    loweringPlanReleaseAppendU32Field(buf, owner.domain.actualWorkerCount)
    loweringPlanReleaseAppendU32Field(buf, owner.domain.taskCount)
    layout.ByteBufAppendFixed32(buf, owner.boundaryCid)
    loweringPlanReleaseAppendI64Field(buf, receipt.allocationEventCount)
    loweringPlanReleaseAppendI64Field(buf, receipt.releaseEventCount)
    loweringPlanReleaseAppendI64Field(buf, receipt.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(buf, receipt.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalRetainedBufferCount)
    loweringPlanReleaseAppendI64Field(buf, receipt.terminalRetainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(buf, receipt.terminalReleasedBytes)
    loweringPlanReleaseAppendI64Field(buf, receipt.liveAllocationCount)
    loweringPlanReleaseAppendI64Field(buf, receipt.liveCapacityBytes)
    let token = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn LoweringFunctionTaskParticipantStorageBegin(
        owner: var LoweringFunctionTaskParticipantStorageOwner,
        domain: LoweringFunctionTaskParticipantStorageDomain) =
    if domain.functionCount <= 0 ||
       domain.actualWorkerCount <= 1 ||
       domain.actualWorkerCount > 128 ||
       domain.taskCount <= 1 ||
       owner.sourceRows.len != 0 ||
       LoweringFunctionTaskParticipantStoragePhysicalBufferCount(owner) !=
           0 ||
       owner.allocatorLedger.allocationEventCount != int64(0) ||
       owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()):
        panic("function task participant storage: begin state invalid")
    owner.domain = domain
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.sourceRows,
        domain.actualWorkerCount,
        sizeof(int32))
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.sourceGenerations,
        domain.actualWorkerCount,
        sizeof(int32))
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.sourceOwners,
        domain.actualWorkerCount,
        sizeof(int32))
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.terminalRows,
        domain.actualWorkerCount,
        sizeof(int32))
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.terminalGenerations,
        domain.actualWorkerCount,
        sizeof(int32))
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.terminalOwners,
        domain.actualWorkerCount,
        sizeof(int32))
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.terminalResultWord0s,
        domain.actualWorkerCount,
        sizeof(uint64))
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.terminalResultWord1s,
        domain.actualWorkerCount,
        sizeof(uint64))
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.terminalResultWord2s,
        domain.actualWorkerCount,
        sizeof(uint64))
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.terminalResultWord3s,
        domain.actualWorkerCount,
        sizeof(uint64))
    if owner.sourceRows.len != domain.actualWorkerCount ||
       owner.sourceGenerations.len != domain.actualWorkerCount ||
       owner.sourceOwners.len != domain.actualWorkerCount ||
       owner.terminalRows.len != domain.actualWorkerCount ||
       owner.terminalGenerations.len != domain.actualWorkerCount ||
       owner.terminalOwners.len != domain.actualWorkerCount ||
       owner.terminalResultWord0s.len != domain.actualWorkerCount ||
       owner.terminalResultWord1s.len != domain.actualWorkerCount ||
       owner.terminalResultWord2s.len != domain.actualWorkerCount ||
       owner.terminalResultWord3s.len != domain.actualWorkerCount ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(
               LoweringFunctionTaskParticipantStoragePhysicalBufferCount(
                   owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringFunctionTaskParticipantStorageCapacityBytes(owner):
        panic("function task participant storage: allocation drift")
    owner.boundaryCid = FunctionTaskParallelBoundaryCid(
        domain.functionCount,
        domain.actualWorkerCount,
        domain.taskCount)
    if layout.FixedBytes32Equal(
           owner.boundaryCid, layout.FixedBytes32()):
        panic("function task participant storage: boundary cid missing")
    owner.boundaryRoot =
        FunctionTaskParticipantRootFromFixed(owner.boundaryCid)

fn LoweringFunctionTaskParticipantStorageReleaseWithReceipt(
        owner: var LoweringFunctionTaskParticipantStorageOwner,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if owner.domain.actualWorkerCount <= 1 ||
       owner.sourceRows.len != owner.domain.actualWorkerCount ||
       owner.terminalRows.len != owner.domain.actualWorkerCount ||
       owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()) ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(
               LoweringFunctionTaskParticipantStoragePhysicalBufferCount(
                   owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringFunctionTaskParticipantStorageCapacityBytes(owner):
        panic("function task participant storage: owner state drift")
    for workerId in 0..<owner.domain.actualWorkerCount:
        if owner.sourceRows[workerId] != 0 ||
           owner.sourceGenerations[workerId] != 0 ||
           owner.sourceOwners[workerId] != 0 ||
           owner.terminalRows[workerId] != 0 ||
           owner.terminalGenerations[workerId] != 0 ||
           owner.terminalOwners[workerId] != 0 ||
           owner.terminalResultWord0s[workerId] != uint64(0) ||
           owner.terminalResultWord1s[workerId] != uint64(0) ||
           owner.terminalResultWord2s[workerId] != uint64(0) ||
           owner.terminalResultWord3s[workerId] != uint64(0):
            panic("function task participant storage: authority not drained")
    let retainedBufferCount =
        LoweringFunctionTaskParticipantStoragePhysicalBufferCount(owner)
    let retainedBytes =
        LoweringFunctionTaskParticipantStorageCapacityBytes(owner)
    var releasedBytes: int64
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        owner.allocatorLedger, owner.sourceRows, sizeof(int32))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        owner.allocatorLedger, owner.sourceGenerations, sizeof(int32))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        owner.allocatorLedger, owner.sourceOwners, sizeof(int32))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        owner.allocatorLedger, owner.terminalRows, sizeof(int32))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        owner.allocatorLedger, owner.terminalGenerations, sizeof(int32))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        owner.allocatorLedger, owner.terminalOwners, sizeof(int32))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        owner.allocatorLedger, owner.terminalResultWord0s, sizeof(uint64))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        owner.allocatorLedger, owner.terminalResultWord1s, sizeof(uint64))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        owner.allocatorLedger, owner.terminalResultWord2s, sizeof(uint64))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        owner.allocatorLedger, owner.terminalResultWord3s, sizeof(uint64))
    loweringFunctionTaskAllocatorReceiptSeal(
        owner.allocatorLedger,
        retainedBufferCount,
        retainedBytes,
        retainedBufferCount,
        releasedBytes,
        LoweringFunctionTaskParticipantStoragePhysicalBufferCount(owner) ==
            0 &&
        LoweringFunctionTaskParticipantStorageCapacityBytes(owner) ==
            int64(0),
        receipt)
    owner.allocatorReceipt = receipt
    owner.ownerToken =
        loweringFunctionTaskParticipantStorageOwnerToken(owner, receipt)
    owner.allocatorReceiptReady = true
    owner.allocatorLedger = LoweringSequenceAllocatorLedger()

fn LoweringFunctionTaskParticipantStorageReceiptConsumeStrict(
        owner: var LoweringFunctionTaskParticipantStorageOwner,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    if !owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt, owner.allocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !layout.FixedBytes32Equal(
           owner.ownerToken,
           loweringFunctionTaskParticipantStorageOwnerToken(
               owner, receipt)) ||
       LoweringFunctionTaskParticipantStoragePhysicalBufferCount(owner) !=
           0 ||
       LoweringFunctionTaskParticipantStorageCapacityBytes(owner) !=
           int64(0):
        return false
    owner.allocatorReceiptConsumed = true
    return true

fn LoweringFunctionTaskParticipantStorageClose(
        owner: var LoweringFunctionTaskParticipantStorageOwner) =
    var receipt: LoweringSequenceAllocatorReceipt
    LoweringFunctionTaskParticipantStorageReleaseWithReceipt(
        owner, receipt)
    if !LoweringFunctionTaskParticipantStorageReceiptConsumeStrict(
           owner, receipt):
        panic("function task participant storage: strict consume failed")

@borrows
fn LoweringFunctionTaskResultIdentityPhysicalBufferCount(
        owner: LoweringFunctionTaskResultIdentityOwner): int32 =
    var count: int32
    if owner.workerIds.cap > 0:
        count = count + 1
    if owner.resultCids.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringFunctionTaskResultIdentityCapacityBytes(
        owner: LoweringFunctionTaskResultIdentityOwner): int64 =
    return int64(owner.workerIds.cap) * int64(sizeof(int32)) +
        int64(owner.resultCids.cap) * int64(sizeof(layout.FixedBytes32))

@borrows
fn loweringFunctionTaskResultIdentityOwnerToken(
        owner: LoweringFunctionTaskResultIdentityOwner,
        receipt: LoweringSequenceAllocatorReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(160)
    loweringPlanReleaseAppendText(
        buf, "cheng.compiler.lowering.function_task_result_identity")
    loweringPlanReleaseAppendU32Field(buf, owner.domain.functionCount)
    loweringPlanReleaseAppendI64Field(buf, receipt.allocationEventCount)
    loweringPlanReleaseAppendI64Field(buf, receipt.releaseEventCount)
    loweringPlanReleaseAppendI64Field(buf, receipt.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(buf, receipt.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalRetainedBufferCount)
    loweringPlanReleaseAppendI64Field(buf, receipt.terminalRetainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(buf, receipt.terminalReleasedBytes)
    loweringPlanReleaseAppendI64Field(buf, receipt.liveAllocationCount)
    loweringPlanReleaseAppendI64Field(buf, receipt.liveCapacityBytes)
    let token = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn LoweringFunctionTaskResultIdentityBegin(
        owner: var LoweringFunctionTaskResultIdentityOwner,
        domain: LoweringFunctionTaskResultIdentityDomain) =
    if domain.functionCount <= 0 ||
       owner.workerIds.len != 0 ||
       owner.resultCids.len != 0 ||
       LoweringFunctionTaskResultIdentityPhysicalBufferCount(owner) != 0 ||
       owner.allocatorLedger.allocationEventCount != int64(0) ||
       owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()):
        panic("function task result identity: begin state invalid")
    owner.domain = domain
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.workerIds,
        domain.functionCount,
        sizeof(int32))
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.resultCids,
        domain.functionCount,
        sizeof(layout.FixedBytes32))
    for functionIndex in 0..<domain.functionCount:
        owner.workerIds[functionIndex] = -1
    if owner.workerIds.len != domain.functionCount ||
       owner.resultCids.len != domain.functionCount ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(
               LoweringFunctionTaskResultIdentityPhysicalBufferCount(
                   owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringFunctionTaskResultIdentityCapacityBytes(owner):
        panic("function task result identity: allocation drift")

fn LoweringFunctionTaskResultIdentityReleaseWithReceipt(
        owner: var LoweringFunctionTaskResultIdentityOwner,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if owner.domain.functionCount <= 0 ||
       owner.workerIds.len != owner.domain.functionCount ||
       owner.resultCids.len != owner.domain.functionCount ||
       owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()) ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(
               LoweringFunctionTaskResultIdentityPhysicalBufferCount(
                   owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringFunctionTaskResultIdentityCapacityBytes(owner):
        panic("function task result identity: owner state drift")
    let retainedBufferCount =
        LoweringFunctionTaskResultIdentityPhysicalBufferCount(owner)
    let retainedBytes =
        LoweringFunctionTaskResultIdentityCapacityBytes(owner)
    var releasedBytes: int64
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        owner.allocatorLedger, owner.workerIds, sizeof(int32))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        owner.allocatorLedger,
        owner.resultCids,
        sizeof(layout.FixedBytes32))
    loweringFunctionTaskAllocatorReceiptSeal(
        owner.allocatorLedger,
        retainedBufferCount,
        retainedBytes,
        retainedBufferCount,
        releasedBytes,
        LoweringFunctionTaskResultIdentityPhysicalBufferCount(owner) == 0 &&
        LoweringFunctionTaskResultIdentityCapacityBytes(owner) == int64(0),
        receipt)
    owner.allocatorReceipt = receipt
    owner.ownerToken =
        loweringFunctionTaskResultIdentityOwnerToken(owner, receipt)
    owner.allocatorReceiptReady = true
    owner.allocatorLedger = LoweringSequenceAllocatorLedger()

fn LoweringFunctionTaskResultIdentityReceiptConsumeStrict(
        owner: var LoweringFunctionTaskResultIdentityOwner,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    if !owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt, owner.allocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !layout.FixedBytes32Equal(
           owner.ownerToken,
           loweringFunctionTaskResultIdentityOwnerToken(owner, receipt)) ||
       LoweringFunctionTaskResultIdentityPhysicalBufferCount(owner) != 0 ||
       LoweringFunctionTaskResultIdentityCapacityBytes(owner) != int64(0):
        return false
    owner.allocatorReceiptConsumed = true
    return true

fn LoweringFunctionTaskResultIdentityClose(
        owner: var LoweringFunctionTaskResultIdentityOwner) =
    var receipt: LoweringSequenceAllocatorReceipt
    LoweringFunctionTaskResultIdentityReleaseWithReceipt(owner, receipt)
    if !LoweringFunctionTaskResultIdentityReceiptConsumeStrict(
           owner, receipt):
        panic("function task result identity: strict consume failed")

fn FunctionTaskParticipantsPrepare(
        functionCount: int32,
        actualWorkerCount: int32,
        taskCount: int32) =
    if actualWorkerCount <= 1 || actualWorkerCount > 128:
        panic("function_task_participant_capacity_invalid")
    var domain: LoweringFunctionTaskParticipantStorageDomain
    domain.functionCount = functionCount
    domain.actualWorkerCount = actualWorkerCount
    domain.taskCount = taskCount
    LoweringFunctionTaskParticipantStorageBegin(
        loweringParallelParticipantStorage, domain)
    for workerId in 0..<actualWorkerCount:
        var minted: system.RuntimeAllocationLedgerParticipantCapability
        if !system.RuntimeAllocationLedgerParticipantMint(
               workerId,
               loweringParallelParticipantStorage.boundaryRoot,
               minted):
            panic("function_task_participant_mint_failed")
        let priorGeneration = minted.generation
        let priorOwner = minted.owner
        var moved: system.RuntimeAllocationLedgerParticipantCapability
        if !system.RuntimeAllocationLedgerParticipantMove(
               minted, moved) ||
           !system.RuntimeAllocationLedgerParticipantCapabilityIsEmpty(
               minted) ||
           moved.generation == priorGeneration ||
           moved.owner == priorOwner:
            panic("function_task_participant_move_failed")
        FunctionTaskParticipantSourceStore(workerId, moved)

fn FunctionTaskParticipantsConsume() =
    for workerId in 0..<loweringParallelWorkerCount:
        var capability: system.RuntimeAllocationLedgerParticipantCapability
        var publishedResult: system.RuntimeAllocationLedgerParticipantRoot
        FunctionTaskParticipantTerminalTake(
            workerId, capability, publishedResult)
        let expectedResultCid = FunctionTaskWorkerResultCid(
            workerId, loweringParallelParticipantStorage.boundaryCid)
        let expectedResult = FunctionTaskParticipantRootFromFixed(
            expectedResultCid)
        if !FunctionTaskParticipantRootEqual(
               publishedResult, expectedResult) ||
           !system.RuntimeAllocationLedgerParticipantConsume(
               capability,
               workerId,
               loweringParallelParticipantStorage.boundaryRoot,
               expectedResult) ||
           !system.RuntimeAllocationLedgerParticipantCapabilityIsEmpty(
               capability):
            panic("function_task_participant_consume_failed")
    LoweringFunctionTaskParticipantStorageClose(
        loweringParallelParticipantStorage)
    LoweringFunctionTaskResultIdentityClose(
        loweringParallelResultIdentity)
    loweringParallelParticipantStorage =
        LoweringFunctionTaskParticipantStorageOwner()
    loweringParallelResultIdentity =
        LoweringFunctionTaskResultIdentityOwner()

fn FunctionTaskWsPopOwn(workerId: int32,
                         funcIndex: var int32): bool =
    if workerId < 0 || workerId >= loweringParallelWorkerCount:
        return false
    let headCell = loweringParallelShardHeads[workerId]
    let tailCell = loweringParallelShardTails[workerId]
    let nextTail = atomic.LoadI32(tailCell) - 1
    atomic.StoreI32(tailCell, nextTail)
    let head = atomic.LoadI32(headCell)
    if head < nextTail:
        if nextTail < 0 || nextTail >= loweringParallelTaskFunctionIndices.len:
            panic("function_task_ws_pop_task_index_out_of_range")
        funcIndex = loweringParallelTaskFunctionIndices[nextTail]
        return true
    if head == nextTail:
        if atomic.CasI32(headCell, head, head + 1):
            atomic.StoreI32(tailCell, head + 1)
            if nextTail < 0 || nextTail >= loweringParallelTaskFunctionIndices.len:
                panic("function_task_ws_pop_last_task_index_out_of_range")
            funcIndex = loweringParallelTaskFunctionIndices[nextTail]
            return true
        atomic.StoreI32(tailCell, head + 1)
        return false
    atomic.StoreI32(tailCell, head)
    return false

fn FunctionTaskWsStealFrom(victimId: int32,
                            funcIndex: var int32): bool =
    if victimId < 0 || victimId >= loweringParallelWorkerCount:
        return false
    let headCell = loweringParallelShardHeads[victimId]
    let tailCell = loweringParallelShardTails[victimId]
    while true:
        let head = atomic.LoadI32(headCell)
        let tail = atomic.LoadI32(tailCell)
        if head >= tail:
            return false
        if atomic.CasI32(headCell, head, head + 1):
            if head < 0 || head >= loweringParallelTaskFunctionIndices.len:
                panic("function_task_ws_steal_task_index_out_of_range")
            funcIndex = loweringParallelTaskFunctionIndices[head]
            return true

fn FunctionTaskWsTakeTask(workerId: int32,
                           funcIndex: var int32): bool =
    if FunctionTaskWsPopOwn(workerId, funcIndex):
        return true
    var offset = 1
    while offset < loweringParallelWorkerCount:
        let victimId = (workerId + offset) % loweringParallelWorkerCount
        if FunctionTaskWsStealFrom(victimId, funcIndex):
            return true
        offset = offset + 1
    return false

fn FunctionTaskParallelWorkerRun(workerId: int32) =
    if workerId < 0 || workerId >= loweringParallelWorkerCount:
        panic("function_task_executor_worker_id_invalid")
    var participant: system.RuntimeAllocationLedgerParticipantCapability
    FunctionTaskParticipantSourceTake(workerId, participant)
    if !system.RuntimeAllocationLedgerParticipantClaim(
           participant,
           workerId,
           loweringParallelParticipantStorage.boundaryRoot):
        panic("function_task_participant_claim_failed")
    while true:
        var funcIndex: int32
        if !FunctionTaskWsTakeTask(workerId, funcIndex):
            break
        FunctionTaskExecuteBodyIr(workerId, funcIndex)
    LoweringDebugLine(Fmt"ftask_worker_loop_done id={workerId}")
    let resultCid = FunctionTaskWorkerResultCid(
        workerId, loweringParallelParticipantStorage.boundaryCid)
    let resultRoot = FunctionTaskParticipantRootFromFixed(resultCid)
    if !system.RuntimeAllocationLedgerParticipantPublish(
           participant,
           workerId,
           loweringParallelParticipantStorage.boundaryRoot,
           resultRoot):
        panic("function_task_participant_publish_failed")
    FunctionTaskParticipantTerminalStore(
        workerId, participant, resultRoot)
    let _ = atomic.AddI32(loweringParallelDoneCount, 1)

fn FunctionTaskParallelWorkerMain() =
    let workerId =
        system.RuntimeAllocationLedgerParticipantStartedWorkerOrdinal()
    if workerId <= 0 || workerId >= loweringParallelWorkerCount:
        panic("function_task_executor_worker_dispatch_out_of_range")
    FunctionTaskParallelWorkerRun(workerId)

fn LoweringFunctionTaskWorkerThreadScratchBegin(
        owner: var LoweringFunctionTaskWorkerThreadScratchOwner,
        domain: LoweringFunctionTaskWorkerThreadScratchDomain) =
    if domain.actualWorkerCount <= 1 ||
       domain.threadCount != domain.actualWorkerCount - 1 ||
       owner.workerThreads.len != 0 ||
       owner.workerThreads.cap != 0 ||
       owner.allocatorLedger.allocationEventCount != int64(0) ||
       owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()):
        panic("function task worker thread scratch: begin state invalid")
    owner.domain = domain

fn LoweringFunctionTaskWorkerThreadScratchAppend(
        owner: var LoweringFunctionTaskWorkerThreadScratchOwner,
        value: thread.Thread) =
    if value == nil ||
       owner.workerThreads.len >= owner.domain.threadCount:
        panic("function task worker thread scratch: domain exhausted")
    loweringSequenceAllocatorAdd(
        owner.allocatorLedger,
        owner.workerThreads,
        value,
        sizeof(thread.Thread))

@borrows
fn LoweringFunctionTaskWorkerThreadScratchPhysicalBufferCount(
        owner: LoweringFunctionTaskWorkerThreadScratchOwner): int32 =
    return owner.workerThreads.cap > 0 ? 1 : 0

@borrows
fn LoweringFunctionTaskWorkerThreadScratchCapacityBytes(
        owner: LoweringFunctionTaskWorkerThreadScratchOwner): int64 =
    return int64(owner.workerThreads.cap) *
           int64(sizeof(thread.Thread))

fn loweringFunctionTaskWorkerThreadScratchReleaseColumn(
        owner: var LoweringFunctionTaskWorkerThreadScratchOwner): int64 =
    let retainedCapacity = owner.workerThreads.cap
    var releasedBytes: int64
    if retainedCapacity > 0:
        if owner.workerThreads.buffer == nil:
            panic("function task worker thread scratch: live buffer missing")
        releasedBytes =
            int64(retainedCapacity) * int64(sizeof(thread.Thread))
        if owner.allocatorLedger.liveAllocationCount <= int64(0) ||
           owner.allocatorLedger.liveCapacityBytes < releasedBytes:
            panic("function task worker thread scratch: release underflow")
        owner.allocatorLedger.releaseEventCount =
            owner.allocatorLedger.releaseEventCount + int64(1)
        owner.allocatorLedger.releasedCapacityBytes =
            owner.allocatorLedger.releasedCapacityBytes + releasedBytes
        owner.allocatorLedger.liveAllocationCount =
            owner.allocatorLedger.liveAllocationCount - int64(1)
        owner.allocatorLedger.liveCapacityBytes =
            owner.allocatorLedger.liveCapacityBytes - releasedBytes
    for threadIndex in 0..<owner.workerThreads.len:
        owner.workerThreads[threadIndex] = nil
    seqs.freeSeq(owner.workerThreads)
    if owner.workerThreads.len != 0 ||
       owner.workerThreads.cap != 0 ||
       owner.workerThreads.buffer != nil:
        panic("function task worker thread scratch: physical release failed")
    return releasedBytes

@borrows
fn loweringFunctionTaskWorkerThreadScratchOwnerToken(
        owner: LoweringFunctionTaskWorkerThreadScratchOwner,
        receipt: LoweringSequenceAllocatorReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(168)
    loweringPlanReleaseAppendText(
        buf, "cheng.compiler.lowering.function_task_worker_thread_scratch")
    loweringPlanReleaseAppendU32Field(
        buf, owner.domain.actualWorkerCount)
    loweringPlanReleaseAppendU32Field(
        buf, owner.domain.threadCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocationEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releaseEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalRetainedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalRetainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalReleasedBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveAllocationCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveCapacityBytes)
    let token = hash256.Sha256Fixed(
        layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn LoweringFunctionTaskWorkerThreadScratchReleaseWithReceipt(
        owner: var LoweringFunctionTaskWorkerThreadScratchOwner,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if owner.workerThreads.len != owner.domain.threadCount ||
       owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()) ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(
               LoweringFunctionTaskWorkerThreadScratchPhysicalBufferCount(
                   owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringFunctionTaskWorkerThreadScratchCapacityBytes(owner):
        panic("function task worker thread scratch: owner state drift")
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringFunctionTaskWorkerThreadScratchPhysicalBufferCount(owner)
    receipt.terminalRetainedBytes =
        LoweringFunctionTaskWorkerThreadScratchCapacityBytes(owner)
    let terminalReleasedBytes =
        loweringFunctionTaskWorkerThreadScratchReleaseColumn(owner)
    owner.allocatorLedger.closed = true
    receipt.allocationEventCount =
        owner.allocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        owner.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        owner.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        owner.allocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        owner.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        owner.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringFunctionTaskWorkerThreadScratchPhysicalBufferCount(owner) ==
            0 &&
        LoweringFunctionTaskWorkerThreadScratchCapacityBytes(owner) ==
            int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("function task worker thread scratch: receipt incomplete")
    owner.allocatorReceipt = receipt
    owner.ownerToken =
        loweringFunctionTaskWorkerThreadScratchOwnerToken(owner, receipt)
    owner.allocatorReceiptReady = true
    owner.allocatorLedger = LoweringSequenceAllocatorLedger()

fn LoweringFunctionTaskWorkerThreadScratchReceiptConsumeStrict(
        owner: var LoweringFunctionTaskWorkerThreadScratchOwner,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    if !owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt, owner.allocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !layout.FixedBytes32Equal(
           owner.ownerToken,
           loweringFunctionTaskWorkerThreadScratchOwnerToken(
               owner, receipt)) ||
       LoweringFunctionTaskWorkerThreadScratchPhysicalBufferCount(owner) !=
           0 ||
       LoweringFunctionTaskWorkerThreadScratchCapacityBytes(owner) !=
           int64(0):
        return false
    owner.allocatorReceiptConsumed = true
    return true

fn LoweringFunctionTaskWorkerThreadScratchClose(
        owner: var LoweringFunctionTaskWorkerThreadScratchOwner) =
    var receipt: LoweringSequenceAllocatorReceipt
    LoweringFunctionTaskWorkerThreadScratchReleaseWithReceipt(
        owner, receipt)
    if !LoweringFunctionTaskWorkerThreadScratchReceiptConsumeStrict(
           owner, receipt):
        panic("function task worker thread scratch: strict consume failed")

fn FunctionTaskExecuteParallel(functionCount: int32,
                                jobCount: int32,
                                taskCount: int32) =
    var actualWorkerCount = jobCount
    if actualWorkerCount > taskCount:
        actualWorkerCount = taskCount
    if actualWorkerCount <= 1:
        FunctionTaskExecuteSerial(functionCount)
        return
    LoweringDebugLine("ftask_parallel_begin")
    let doneCount = atomic.NewI32(0)
    if doneCount == nil:
        panic("function_task_executor_atomic_alloc_failed")
    loweringParallelDoneCount = doneCount
    let resultLock = atomic.NewI32(0)
    if resultLock == nil:
        panic("function_task_executor_result_lock_alloc_failed")
    loweringParallelResultLock = resultLock
    LoweringDebugLine("ftask_parallel_after_atomics")
    loweringParallelTaskFunctionIndices = FunctionTaskBuildMaterializedTasks(functionCount)
    if loweringParallelTaskFunctionIndices.len != taskCount:
        panic("function_task_executor_task_count_mismatch")
    LoweringDebugLine("ftask_parallel_after_tasks")
    loweringParallelShardHeads = []
    loweringParallelShardTails = []
    loweringParallelWorkerCount = actualWorkerCount
    for workerId in 0..<actualWorkerCount:
        let start = (taskCount * workerId) / actualWorkerCount
        let finish = (taskCount * (workerId + 1)) / actualWorkerCount
        let head = atomic.NewI32(start)
        let tail = atomic.NewI32(finish)
        if head == nil || tail == nil:
            panic("function_task_executor_deque_alloc_failed")
        add(loweringParallelShardHeads, head)
        add(loweringParallelShardTails, tail)
    LoweringDebugLine("ftask_parallel_after_shards")
    loweringParallelLastActiveWorkerCount = actualWorkerCount
    FunctionTaskParticipantsPrepare(
        functionCount, actualWorkerCount, taskCount)
    var workerThreadScratch: LoweringFunctionTaskWorkerThreadScratchOwner
    LoweringFunctionTaskWorkerThreadScratchBegin(
        workerThreadScratch,
        LoweringFunctionTaskWorkerThreadScratchDomain(
            actualWorkerCount: actualWorkerCount,
            threadCount: actualWorkerCount - 1))
    for w in 1..<actualWorkerCount:
        let t = thread.StartFn(FunctionTaskParallelWorkerMain)
        if t == nil:
            panic("function_task_executor_worker_start_failed")
        LoweringFunctionTaskWorkerThreadScratchAppend(
            workerThreadScratch, t)
    LoweringDebugLine("ftask_parallel_after_spawn")
    FunctionTaskParallelWorkerRun(0)
    LoweringDebugLine("ftask_parallel_after_main_worker")
    for ti in 0..<workerThreadScratch.workerThreads.len:
        LoweringDebugLine(Fmt"ftask_parallel_join_begin ti={ti}")
        if !thread.JoinThread(
               workerThreadScratch.workerThreads[ti]):
            panic("function_task_executor_worker_join_failed")
        LoweringDebugLine(Fmt"ftask_parallel_join_done ti={ti}")
    LoweringDebugLine("ftask_parallel_after_join")
    FunctionTaskParticipantsConsume()
    LoweringFunctionTaskWorkerThreadScratchClose(
        workerThreadScratch)
    loweringParallelLastCompletedWorkerCount = atomic.LoadI32(loweringParallelDoneCount)
    if loweringParallelLastCompletedWorkerCount != actualWorkerCount:
        panic("function_task_executor_worker_count_mismatch")
    loweringParallelDoneCount = nil

fn FunctionTaskExecuteAuto(functionCount: int32,
                            jobCount: int32,
                            taskCount: int32) =
    loweringParallelLastRequestedJobCount = jobCount
    loweringParallelLastActiveWorkerCount = 0
    loweringParallelLastCompletedWorkerCount = 0
    loweringParallelLastTaskCount = taskCount
    if jobCount > 1 && taskCount > 1:
        FunctionTaskExecuteParallel(functionCount, jobCount, taskCount)
        return
    FunctionTaskExecuteSerial(functionCount)

fn LoweringParallelRecordSerial(jobCount: int32, taskCount: int32) =
    # Serial primary-ir build accounting: one worker, every function a task.
    loweringParallelLastRequestedJobCount = jobCount
    loweringParallelLastActiveWorkerCount = 1
    loweringParallelLastCompletedWorkerCount = 1
    loweringParallelLastTaskCount = taskCount

fn LoweringParallelLastRequestedJobCount(): int32 =
    return loweringParallelLastRequestedJobCount

fn LoweringParallelLastActiveWorkerCount(): int32 =
    return loweringParallelLastActiveWorkerCount

fn LoweringParallelLastCompletedWorkerCount(): int32 =
    return loweringParallelLastCompletedWorkerCount

fn LoweringParallelLastTaskCount(): int32 =
    return loweringParallelLastTaskCount

@borrows
fn LoweringBuildFlagMaterializedFunctionCount(buildFlags: bool[],
                                               functionCount: int32): int32 =
    var count: int32
    for i in 0..<functionCount:
        if buildFlags.len > i && !buildFlags[i]:
            continue
        count = count + 1
    return count

fn LoweringCaptureDenseStoreLookupReport(plan: var LoweringPlanStub) =
    let denseStoreReport = dense.DenseStoreContractReport(plan.functionDenseStore)
    plan.loweringDenseStoreQueryCount = denseStoreReport.sourceScopedQueryCount
    plan.loweringDenseStoreHitCount = denseStoreReport.sourceScopedQueryHitCount
    plan.loweringDenseStoreMissCount = denseStoreReport.sourceScopedQueryMissCount

fn LoweringCapturePrimaryIrPhaseArenaReport(plan: var LoweringPlanStub) =
    plan.loweringPhaseArenaResetCount = 0
    plan.loweringPhaseArenaReserveCount = 0
    plan.loweringPhaseArenaCapacityBytes = int64(0)
    plan.loweringPhaseArenaUsedBytes = int64(0)
    plan.loweringPhaseArenaPeakBytes = int64(0)
    plan.loweringPhaseArenaSpillCount = 0

fn LoweringBuildPrimaryObjectIrInPlan(plan: var LoweringPlanStub,
                                       sourceTexts: var texpr.TypedExprSourceText[],
                                       buildFlags: var bool[]) =
    if LoweringTraceOn():
        LoweringDebugLine(Fmt"lowering_primary_ir_enter functions={plan.functionNames.len} flags={buildFlags.len}")
        for fnDbgIndex in 0..<plan.functionNames.len:
            var fnDbgFlag: bool
            if fnDbgIndex < buildFlags.len:
                fnDbgFlag = buildFlags[fnDbgIndex]
            LoweringDebugLine(Fmt"lowering_primary_ir_fn index={fnDbgIndex} name={plan.functionNames[fnDbgIndex]} source={plan.functionSourcePaths[fnDbgIndex]} flag={fnDbgFlag}")
    LoweringDebugLine("lowering_primary_ir_after_primary_ir_init_skip")
    if false:
        plan.primaryObjectIrFunctions = []
    LoweringDebugLine("lowering_primary_ir_after_function_array_clear_skip")
    if false:
        plan.primaryObjectIrBuildFunctionCount = 0
        plan.primaryObjectIrFunctionCountSnapshot = 0
        plan.primaryObjectIrSkippedFunctionCount = 0
        plan.typedIrFunctionCountSnapshot = 0
        plan.typedIrNodeCountSnapshot = 0
        plan.typedIrStatementCountSnapshot = 0
        plan.primaryObjectIrEntryBodyKindCode = 0
        plan.primaryObjectIrEntryStatementCount = 0
        plan.primaryObjectIrFullMaterialization = 0
    LoweringDebugLine("lowering_primary_ir_before_snapshots")
    var typedIrFunctionCountSnapshot: int32
    typedIrFunctionCountSnapshot = plan.typedIr.functions2_functionNameIds.len
    var typedIrNodeCountSnapshot: int32
    typedIrNodeCountSnapshot = plan.typedIr.nodes2_nodeIndexs.len
    var typedIrStatementCountSnapshot: int32
    typedIrStatementCountSnapshot = plan.typedIr.statements2_statementIndexs.len
    plan.typedIrFunctionCountSnapshot = typedIrFunctionCountSnapshot
    plan.typedIrNodeCountSnapshot = typedIrNodeCountSnapshot
    plan.typedIrStatementCountSnapshot = typedIrStatementCountSnapshot
    LoweringDebugLine("lowering_primary_ir_after_snapshots")
    var primaryObjectIrEntryTypedFunctionIndex: int32
    primaryObjectIrEntryTypedFunctionIndex = -1
    var primaryObjectIrEntryBodyKindCode: int32
    var primaryObjectIrEntryStatementCount: int32
    LoweringDebugLine("lowering_primary_ir_after_entry_defaults")
    LoweringDebugLine("lowering_primary_ir_before_functions_array")
    var functions: PrimaryObjectIrFunction[]
    LoweringDebugLine("lowering_primary_ir_after_functions_array")
    let letCallReturnLiteralStart = texpr.BodyKindLetCallReturnI32ConstPrefixLen
    let functionCount = plan.functionNames.len
    LoweringDebugLine(Fmt"lowering_primary_ir_after_function_count count={functionCount}")
    if functionCount <= 0:
        return
    LoweringDebugLine("lowering_primary_ir_after_empty_check")
    let materializedFunctionCount = LoweringBuildFlagMaterializedFunctionCount(buildFlags, functionCount)
    LoweringDebugLine(Fmt"lowering_primary_ir_after_materialized_count count={materializedFunctionCount}")
    let skippedFunctionCount = functionCount - materializedFunctionCount
    LoweringDebugLine(Fmt"lowering_primary_ir_after_skipped_count count={skippedFunctionCount}")
    plan.primaryObjectIrFullMaterialization = 0
    LoweringDebugLine("lowering_primary_ir_after_full_materialization_zero")
    if skippedFunctionCount <= 0:
        plan.primaryObjectIrFullMaterialization = 1
    LoweringDebugLine("lowering_primary_ir_after_full_materialization_flag")
    var jobCount = plan.requestedJobCount
    if jobCount <= 0:
        jobCount = 1
        let backendJobsRaw = os.GetEnv("BACKEND_JOBS")
        LoweringDebugLine(Fmt"lowering_primary_ir_after_backend_jobs_env len={len(backendJobsRaw)}")
        if len(backendJobsRaw) > 0:
            let parsed = int32(strutil.ParseInt(backendJobsRaw))
            if parsed > 0:
                jobCount = parsed
    LoweringDebugLine(Fmt"lowering_primary_ir_after_job_count_parse count={jobCount}")
    var useParallelPrimaryIrBuild: bool
    if jobCount > 1:
        if materializedFunctionCount > 1:
            useParallelPrimaryIrBuild = true
    LoweringDebugLine("lowering_primary_ir_after_parallel_decision")
    if !useParallelPrimaryIrBuild:
        LoweringParallelRecordSerial(jobCount, materializedFunctionCount)
    if useParallelPrimaryIrBuild:
        LoweringDebugLine("lowering_parallel_prep_before_plan_assign")
        loweringParallelPlan = plan
        LoweringDebugLine("lowering_parallel_prep_after_plan_assign")
        loweringParallelSourceTexts = LoweringCloneTypedExprSourceTexts(sourceTexts)
        LoweringDebugLine("lowering_parallel_prep_after_source_clone")
        loweringParallelBuildFlags = LoweringCloneBoolFlags(buildFlags)
        LoweringDebugLine("lowering_parallel_prep_after_flags_clone")
        loweringParallelLetCallReturnLiteralStart = letCallReturnLiteralStart
        loweringParallelResults = []
        loweringParallelResultReadyFlags = []
        var resultIdentityDomain: LoweringFunctionTaskResultIdentityDomain
        resultIdentityDomain.functionCount = functionCount
        LoweringFunctionTaskResultIdentityBegin(
            loweringParallelResultIdentity,
            resultIdentityDomain)
        for i in 0..<functionCount:
            add(loweringParallelResults, PrimaryObjectIrFunction())
            add(loweringParallelResultReadyFlags, 0)
        LoweringDebugLine("lowering_parallel_prep_after_results_init")
        FunctionTaskExecuteAuto(functionCount, jobCount, materializedFunctionCount)
        LoweringDebugLine("lowering_parallel_prep_after_execute_auto")
        for i in 0..<functionCount:
            if i % 128 == 0:
                os.ProcessResourceGuardCheck()
                LoweringProgress(Fmt"primary_object_ir_parallel_merge_index={i}")
            if i >= loweringParallelResultReadyFlags.len ||
               loweringParallelResultReadyFlags[i] != 1:
                panic("function_task_executor_result_not_published")
            if i < loweringParallelBuildFlags.len &&
               loweringParallelBuildFlags[i] &&
               len(loweringParallelResults[i].functionName) <= 0:
                panic("function_task_executor_result_empty_function")
            var mergedFn: PrimaryObjectIrFunction
            LoweringCopyPrimaryObjectIrFunctionInto(loweringParallelResults[i], mergedFn)
            add(functions, mergedFn)
        loweringParallelPlan = LoweringPlanStub()
        loweringParallelSourceTexts = []
        loweringParallelBuildFlags = []
        loweringParallelResults = []
        loweringParallelResultReadyFlags = []
        loweringParallelResultLock = nil
        loweringParallelTaskFunctionIndices = []
        loweringParallelShardHeads = []
        loweringParallelShardTails = []
        loweringParallelWorkerCount = 0
        plan.primaryObjectIrBuildFunctionCount = materializedFunctionCount
        plan.primaryObjectIrFunctionCountSnapshot = functions.len
        plan.primaryObjectIrSkippedFunctionCount = skippedFunctionCount
        for entryIndex in 0..<functions.len:
            if entryIndex < plan.functionEntryFlags.len && plan.functionEntryFlags[entryIndex] != 0:
                primaryObjectIrEntryTypedFunctionIndex = functions[entryIndex].typedFunctionIndex
                primaryObjectIrEntryBodyKindCode = LoweringBodyKindCode(functions[entryIndex].bodyKind)
                primaryObjectIrEntryStatementCount = functions[entryIndex].statements.len
        if primaryObjectIrEntryTypedFunctionIndex !=
           plan.sourceEntryTypedFunctionIndex:
            panic("lowering primary object IR: exact source-entry identity drift")
        plan.primaryObjectIrEntryTypedFunctionIndex = primaryObjectIrEntryTypedFunctionIndex
        plan.primaryObjectIrEntryBodyKindCode = primaryObjectIrEntryBodyKindCode
        plan.primaryObjectIrEntryStatementCount = primaryObjectIrEntryStatementCount
        LoweringCapturePrimaryIrPhaseArenaReport(plan)
        plan.primaryObjectIr.functions = functions
        functions = []
        LoweringDebugLine("lowering_primary_ir_dense_report_skip")
        LoweringDebugLine("lowering_primary_ir_phase_report_skip")
        return
    LoweringDebugLine("lowering_primary_ir_before_serial_loop")
    var i: int32
    i = 0
    var serialLoopActive: bool
    if i < functionCount:
        serialLoopActive = true
    while serialLoopActive:
        if LoweringTraceOn():
            LoweringDebugLine(Fmt"lowering_primary_ir_serial_loop_index={i}")
        if i % 128 == 0:
            os.ProcessResourceGuardCheck()
        var skipFunctionBuild: bool
        if buildFlags.len > i:
            if !buildFlags[i]:
                skipFunctionBuild = true
        if skipFunctionBuild:
            var skippedFn: PrimaryObjectIrFunction
            LoweringFillSkippedPrimaryObjectIrDescriptor(plan, i, skippedFn)
            add(functions, skippedFn)
            skippedFn = PrimaryObjectIrFunction()
            i = i + 1
            serialLoopActive = false
            if i < functionCount:
                serialLoopActive = true
            continue
        var fnIr: PrimaryObjectIrFunction
        LoweringBuildOneFunctionInto(plan,
                                      sourceTexts,
                                      i,
                                      letCallReturnLiteralStart,
                                      fnIr)
        add(functions, fnIr)
        fnIr = PrimaryObjectIrFunction()
        i = i + 1
        serialLoopActive = false
        if i < functionCount:
            serialLoopActive = true
    LoweringDebugLine(Fmt"lowering_primary_ir_after_serial_loop count={functions.len}")
    plan.primaryObjectIrBuildFunctionCount = materializedFunctionCount
    plan.primaryObjectIrFunctionCountSnapshot = functions.len
    LoweringDebugLine("lowering_primary_ir_after_build_count_store")
    plan.primaryObjectIrSkippedFunctionCount = skippedFunctionCount
    LoweringDebugLine("lowering_primary_ir_after_skip_count_store")
    LoweringDebugLine("lowering_primary_ir_after_functions_store_skip")
    var entryIndex: int32
    entryIndex = 0
    var entryFunctionCount: int32
    entryFunctionCount = functions.len
    var entryFlagCount: int32
    entryFlagCount = plan.functionEntryFlags.len
    while entryIndex < entryFunctionCount:
        var isEntryFunction: bool
        if entryIndex < entryFlagCount:
            if plan.functionEntryFlags[entryIndex] != 0:
                isEntryFunction = true
        if isEntryFunction:
            primaryObjectIrEntryTypedFunctionIndex = functions[entryIndex].typedFunctionIndex
            primaryObjectIrEntryBodyKindCode = LoweringBodyKindCode(functions[entryIndex].bodyKind)
            primaryObjectIrEntryStatementCount = functions[entryIndex].statements.len
        entryIndex = entryIndex + 1
    LoweringDebugLine("lowering_primary_ir_after_entry_scan")
    if primaryObjectIrEntryTypedFunctionIndex !=
       plan.sourceEntryTypedFunctionIndex:
        panic("lowering primary object IR: exact source-entry identity drift")
    plan.primaryObjectIrEntryTypedFunctionIndex = primaryObjectIrEntryTypedFunctionIndex
    LoweringDebugLine("lowering_primary_ir_after_entry_index_store")
    plan.primaryObjectIrEntryBodyKindCode = primaryObjectIrEntryBodyKindCode
    LoweringDebugLine("lowering_primary_ir_after_entry_body_store")
    plan.primaryObjectIrEntryStatementCount = primaryObjectIrEntryStatementCount
    LoweringDebugLine("lowering_primary_ir_after_entry_statement_store")
    LoweringCapturePrimaryIrPhaseArenaReport(plan)
    plan.primaryObjectIr.functions = functions
    functions = []
    LoweringDebugLine("lowering_primary_ir_after_primary_ir_functions_store")
    LoweringDebugLine("lowering_primary_ir_dense_report_skip")
    LoweringDebugLine("lowering_primary_ir_phase_report_skip")

fn LoweringBuildPrimaryObjectIr(plan: var LoweringPlanStub,
                                 sourceTexts: var texpr.TypedExprSourceText[],
                                 buildFlags: var bool[]): PrimaryObjectIr =
    LoweringBuildPrimaryObjectIrInPlan(plan, sourceTexts, buildFlags)
    return plan.primaryObjectIr
@borrows
fn LoweringIsImportcAnnotation(lineRaw: str): bool =
    let line = chengpath.PathTrim(lineRaw)
    if line == "":
        return false
    return chengpath.TextStartsWith(line, "@importc")

@borrows
fn LoweringPlanHasFunction(plan: var LoweringPlanStub,
                            sourcePathRaw: str,
                            functionNameRaw: str): bool =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let functionName = chengpath.PathTrim(functionNameRaw)
    let tailName = LoweringFunctionTailName(functionName)
    if len(sourcePath) <= 0 || len(functionName) <= 0:
        return false
    for i in 0..<plan.functionNames.len:
        if i >= plan.functionSourcePaths.len:
            continue
        if !LoweringSourcePathsEquivalent(plan.functionSourcePaths[i], sourcePath):
            continue
        if plan.functionNames[i] == functionName ||
           plan.functionNames[i] == tailName:
            return true
    return false

@borrows
fn LoweringPlanFunctionIndex(plan: var LoweringPlanStub,
                              sourcePathRaw: str,
                              functionNameRaw: str): int32 =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let functionName = chengpath.PathTrim(functionNameRaw)
    let tailName = LoweringFunctionTailName(functionName)
    # Resolved-call targets may carry the dotted module qualifier ("seqs.Add")
    # while plan rows store the plain declaration name ("Add").
    let leafName = texpr.TypedExprQualifiedCallLeaf(functionName)
    if len(functionName) <= 0:
        return -1
    if sourcePath != "":
        let denseIndex = dense.DenseStoreFindFunctionInSource(plan.functionDenseStore,
                                                              LoweringDenseStoreSourceKey(sourcePath),
                                                              functionName)
        if denseIndex >= 0 && denseIndex < plan.functionNames.len:
            return denseIndex
        if leafName != functionName:
            let denseLeafIndex = dense.DenseStoreFindFunctionInSource(plan.functionDenseStore,
                                                                      LoweringDenseStoreSourceKey(sourcePath),
                                                                      leafName)
            if denseLeafIndex >= 0 && denseLeafIndex < plan.functionNames.len:
                return denseLeafIndex
        plan.loweringDenseStoreFallbackScanCount = plan.loweringDenseStoreFallbackScanCount + 1
        if LoweringTraceOn():
            LoweringDebugLine(Fmt"lowering_dense_fallback_function source={sourcePath} function={functionName}")
    var foundIndex: int32 = -1
    for i in 0..<plan.functionNames.len:
        if i >= plan.functionSourcePaths.len:
            continue
        if sourcePath != "" &&
           parser.ParserNormalizePath(plan.functionSourcePaths[i]) != sourcePath:
            continue
        if plan.functionNames[i] != functionName &&
           plan.functionNames[i] != tailName &&
           plan.functionNames[i] != leafName:
            continue
        if sourcePath == "":
            if foundIndex >= 0:
                return -1
            foundIndex = i
            continue
        return i
    return foundIndex

@borrows
fn LoweringPlanFunctionIndexAtLine(plan: var LoweringPlanStub,
                                    sourcePathRaw: str,
                                    functionNameRaw: str,
                                    signatureLineNumber: int32): int32 =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let functionName = chengpath.PathTrim(functionNameRaw)
    let tailName = LoweringFunctionTailName(functionName)
    # Resolved-call targets may carry the dotted module qualifier ("seqs.Add")
    # while plan rows store the plain declaration name ("Add"). Source path and
    # signature line equality keep the leaf comparison exact.
    let leafName = texpr.TypedExprQualifiedCallLeaf(functionName)
    if sourcePath == "" || functionName == "" || signatureLineNumber <= 0:
        return -1
    var foundIndex: int32 = -1
    for i in 0..<plan.functionNames.len:
        if i >= plan.functionSourcePaths.len ||
           i >= plan.functionSignatureLineNumbers.len ||
           parser.ParserNormalizePath(plan.functionSourcePaths[i]) != sourcePath ||
           (plan.functionNames[i] != functionName &&
            plan.functionNames[i] != tailName &&
            plan.functionNames[i] != leafName) ||
           plan.functionSignatureLineNumbers[i] != signatureLineNumber:
            continue
        if foundIndex >= 0:
            return -1
        foundIndex = i
    return foundIndex

fn LoweringMarkReachableFunctionIndex(functionIndex: int32,
                                       reachable: var bool[],
                                       frontier: var int32[]) =
    if functionIndex < 0 || functionIndex >= reachable.len:
        return
    if reachable[functionIndex]:
        return
    reachable[functionIndex] = true
    add(frontier, functionIndex)

@borrows
fn LoweringReachabilityCallHeadFromWholeCall(exprRaw: str): str =
    let expr = chengpath.PathTrim(exprRaw)
    if len(expr) <= 0:
        return ""
    let openPos = texpr.TypedExprFindWholeCallOpenParen(expr)
    if openPos <= 0:
        return ""
    let closePos = texpr.TypedExprFindMatchingParen(expr, openPos)
    if closePos <= openPos || closePos + 1 != len(expr):
        return ""
    let callHead = chengpath.PathTrim(chengpath.TextSlice(expr, 0, openPos))
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        return ""
    return callHead

@borrows
fn LoweringReachabilityReturnExprText(stmt: texpr.TypedExprIrStatement): str =
    var text = chengpath.PathTrim(stmt.surfaceText)
    if text == "":
        return ""
    if chengpath.TextStartsWith(text, "return "):
        text = chengpath.PathTrim(chengpath.TextSlice(text, 7, len(text) - 7))
    return text

@borrows
fn LoweringReachabilityCallHeadIsPureCast(callHeadRaw: str): bool =
    let callHead = texpr.TypedExprQualifiedCallLeaf(chengpath.PathTrim(callHeadRaw))
    if callHead == "bool":
        return true
    if callHead == "char":
        return true
    if callHead == "Char":
        return true
    if callHead == "int":
        return true
    if callHead == "Int":
        return true
    if callHead == "int8":
        return true
    if callHead == "Int8":
        return true
    if callHead == "int16":
        return true
    if callHead == "Int16":
        return true
    if callHead == "int32":
        return true
    if callHead == "Int32":
        return true
    if callHead == "int64":
        return true
    if callHead == "Int64":
        return true
    if callHead == "uint":
        return true
    if callHead == "UInt":
        return true
    if callHead == "uint8":
        return true
    if callHead == "UInt8":
        return true
    if callHead == "uint16":
        return true
    if callHead == "UInt16":
        return true
    if callHead == "uint32":
        return true
    if callHead == "UInt32":
        return true
    if callHead == "uint64":
        return true
    if callHead == "UInt64":
        return true
    if callHead == "float32":
        return true
    if callHead == "float64":
        return true
    if callHead == "ptr":
        return true
    if callHead == "cstring":
        return true
    if callHead == "owned_cstring":
        return true
    if callHead == "utf8_view":
        return true
    if callHead == "bytes_view":
        return true
    return false

@borrows
fn LoweringMarkReachableCallHead(plan: var LoweringPlanStub,
                                 sourcePath: str,
                                 callHead: str,
                                 reachable: var bool[],
                                 frontier: var int32[]) =
    if callHead == "":
        return
    if LoweringReachabilityCallHeadIsPureCast(callHead):
        return
    let qualifier = texpr.TypedExprQualifiedCallQualifier(callHead)
    let leaf = texpr.TypedExprQualifiedCallLeaf(callHead)
    if qualifier != "" && leaf != "":
        var qualifiedSourcePath = LoweringTypedIrImportAliasTargetSourcePath(plan.typedIr,
                                                                             sourcePath,
                                                                             qualifier)
        if qualifiedSourcePath == "":
            qualifiedSourcePath = LoweringPlanQualifiedImportTargetSourcePath(plan,
                                                                              sourcePath,
                                                                              qualifier)
        if qualifiedSourcePath != "":
            let qualifiedTargetIndex = LoweringPlanFunctionIndex(plan,
                                                                 qualifiedSourcePath,
                                                                 leaf)
            if LoweringRowDebugEnabled() &&
               strutil.Contains(callHead, loweringRowDebugName):
                os.WriteLine(os.GetStderr(),
                             Fmt"mark_call_head_qualified head={callHead} source={sourcePath} target_source={qualifiedSourcePath} target_index={qualifiedTargetIndex}")
            if qualifiedTargetIndex >= 0 && qualifiedTargetIndex < reachable.len:
                LoweringMarkReachableFunctionIndex(qualifiedTargetIndex, reachable, frontier)
                return
    var targetIndex = LoweringPlanFunctionIndex(plan,
                                                sourcePath,
                                                callHead)
    if targetIndex < 0:
        targetIndex = LoweringPlanFunctionIndex(plan,
                                                "",
                                                callHead)
    if targetIndex < 0:
        # qualified heads (os.ProcessRssBytes) resolve by tail name
        var tailStart: int32
        for headIndex in 0..<len(callHead):
            if callHead[headIndex] == '.':
                tailStart = headIndex + 1
        if tailStart > 0 && tailStart < len(callHead):
            targetIndex = LoweringPlanFunctionIndex(plan,
                                                    "",
                                                    strings.SliceBytes(callHead, tailStart, len(callHead) - tailStart))
    if LoweringRowDebugEnabled() &&
       strutil.Contains(callHead, loweringRowDebugName):
        os.WriteLine(os.GetStderr(),
                     Fmt"mark_call_head head={callHead} source={sourcePath} target_index={targetIndex}")
    if targetIndex < 0 || targetIndex >= reachable.len:
        return
    LoweringMarkReachableFunctionIndex(targetIndex, reachable, frontier)

# Call facts are not generated for calls nested inside Fmt interpolation
# (or other embedded argument text), so reachability would skip their
# targets and leave skeleton rows that fail as not_ready. Scan the raw
# argument text for every `ident(`/`a.b(` head and mark it — reachability
# over-approximation is safe.
@borrows
fn LoweringMarkReachableEmbeddedCallHeads(plan: var LoweringPlanStub,
                                           sourcePath: str,
                                           argsText: str,
                                           reachable: var bool[],
                                           frontier: var int32[]) =
    var i: int32
    var inString = false
    var inFmtString = false
    var inNestedString = false
    var inChar = false
    var escaped = false
    var skipNext = false
    var braceDepth: int32
    while i < len(argsText):
        if !LoweringEmbeddedScanCodeAt(argsText,
                                       i,
                                       inString,
                                       inFmtString,
                                       inNestedString,
                                       inChar,
                                       escaped,
                                       skipNext,
                                       braceDepth):
            i = i + 1
            continue
        if argsText[i] != '(':
            i = i + 1
            continue
        var headStop = i
        var headStart = i
        while headStart > 0:
            let ch = argsText[headStart - 1]
            var identChar = false
            if ch >= 'a' && ch <= 'z':
                identChar = true
            elif ch >= 'A' && ch <= 'Z':
                identChar = true
            elif ch >= '0' && ch <= '9':
                identChar = true
            elif ch == '_' || ch == '.':
                identChar = true
            if !identChar:
                break
            headStart = headStart - 1
        if headStop > headStart:
            let headText = strings.SliceBytes(argsText, headStart, headStop - headStart)
            LoweringMarkReachableCallHead(plan,
                                          sourcePath,
                                          headText,
                                          reachable,
                                          frontier)
        i = i + 1

@borrows
fn LoweringMarkReachableAddressArgs(plan: var LoweringPlanStub,
                                     sourcePath: str,
                                     callArgsText: str,
                                     reachable: var bool[],
                                     frontier: var int32[]) =
    let pieces = texpr.TypedExprSplitTopLevelCsv(callArgsText)
    for i in 0..<pieces.len:
        let addressName = LoweringFunctionAddressArgName(pieces[i])
        if addressName == "":
            continue
        LoweringMarkReachableCallHead(plan,
                                      sourcePath,
                                      addressName,
                                      reachable,
                                      frontier)

@borrows
fn LoweringExportRootIndexAllocatorPhysicalBufferCount(
        index: LoweringExportRootIndex): int32 =
    var count: int32
    if index.candidateBucketHeads.cap > 0: count = count + 1
    if index.candidateEntryNext.cap > 0: count = count + 1
    if index.candidateEntryKinds.cap > 0: count = count + 1
    if index.candidateEntryNames.cap > 0: count = count + 1
    if index.candidateEntryHeads.cap > 0: count = count + 1
    if index.candidateEntryTails.cap > 0: count = count + 1
    if index.candidateNext.cap > 0: count = count + 1
    if index.candidateFunctionIndexes.cap > 0: count = count + 1
    if index.exactExportBucketHeads.cap > 0: count = count + 1
    if index.exactExportEntryNext.cap > 0: count = count + 1
    if index.exactExportEntryNames.cap > 0: count = count + 1
    if index.exactExportEntryFirstFunctionIndexes.cap > 0:
        count = count + 1
    if index.exactExportEntryCounts.cap > 0: count = count + 1
    return count

@borrows
fn LoweringExportRootIndexAllocatorCapacityBytes(
        index: LoweringExportRootIndex): int64 =
    return int64(index.candidateBucketHeads.cap) * int64(sizeof(int32)) +
        int64(index.candidateEntryNext.cap) * int64(sizeof(int32)) +
        int64(index.candidateEntryKinds.cap) * int64(sizeof(int32)) +
        int64(index.candidateEntryNames.cap) * int64(sizeof(str)) +
        int64(index.candidateEntryHeads.cap) * int64(sizeof(int32)) +
        int64(index.candidateEntryTails.cap) * int64(sizeof(int32)) +
        int64(index.candidateNext.cap) * int64(sizeof(int32)) +
        int64(index.candidateFunctionIndexes.cap) * int64(sizeof(int32)) +
        int64(index.exactExportBucketHeads.cap) * int64(sizeof(int32)) +
        int64(index.exactExportEntryNext.cap) * int64(sizeof(int32)) +
        int64(index.exactExportEntryNames.cap) * int64(sizeof(str)) +
        int64(index.exactExportEntryFirstFunctionIndexes.cap) *
            int64(sizeof(int32)) +
        int64(index.exactExportEntryCounts.cap) * int64(sizeof(int32))

fn LoweringExportRootIndexAppendBuckets(
        index: var LoweringExportRootIndex,
        candidateHead: int32,
        exactExportHead: int32) =
    if index.candidateBucketHeads.len !=
           index.exactExportBucketHeads.len:
        panic("lowering export root index allocator: bucket shape drift")
    loweringSequenceAllocatorAdd(
        index.allocatorLedger,
        index.candidateBucketHeads,
        candidateHead,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        index.allocatorLedger,
        index.exactExportBucketHeads,
        exactExportHead,
        sizeof(int32))

@borrows
fn LoweringExportRootIndexAppendCandidateEntry(
        index: var LoweringExportRootIndex,
        entryNext: int32,
        kind: int32,
        name: str,
        head: int32,
        tail: int32) =
    let rowCount = index.candidateEntryNext.len
    if index.candidateEntryKinds.len != rowCount ||
       index.candidateEntryNames.len != rowCount ||
       index.candidateEntryHeads.len != rowCount ||
       index.candidateEntryTails.len != rowCount:
        panic("lowering export root index allocator: candidate entry shape drift")
    loweringSequenceAllocatorAdd(
        index.allocatorLedger,
        index.candidateEntryNext,
        entryNext,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        index.allocatorLedger,
        index.candidateEntryKinds,
        kind,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        index.allocatorLedger,
        index.candidateEntryNames,
        name,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        index.allocatorLedger,
        index.candidateEntryHeads,
        head,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        index.allocatorLedger,
        index.candidateEntryTails,
        tail,
        sizeof(int32))

fn LoweringExportRootIndexAppendCandidateRow(
        index: var LoweringExportRootIndex,
        next: int32,
        functionIndex: int32) =
    if index.candidateNext.len != index.candidateFunctionIndexes.len:
        panic("lowering export root index allocator: candidate row shape drift")
    loweringSequenceAllocatorAdd(
        index.allocatorLedger,
        index.candidateNext,
        next,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        index.allocatorLedger,
        index.candidateFunctionIndexes,
        functionIndex,
        sizeof(int32))

@borrows
fn LoweringExportRootIndexAppendExactEntry(
        index: var LoweringExportRootIndex,
        entryNext: int32,
        name: str,
        firstFunctionIndex: int32,
        count: int32) =
    let rowCount = index.exactExportEntryNext.len
    if index.exactExportEntryNames.len != rowCount ||
       index.exactExportEntryFirstFunctionIndexes.len != rowCount ||
       index.exactExportEntryCounts.len != rowCount:
        panic("lowering export root index allocator: exact entry shape drift")
    loweringSequenceAllocatorAdd(
        index.allocatorLedger,
        index.exactExportEntryNext,
        entryNext,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        index.allocatorLedger,
        index.exactExportEntryNames,
        name,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        index.allocatorLedger,
        index.exactExportEntryFirstFunctionIndexes,
        firstFunctionIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        index.allocatorLedger,
        index.exactExportEntryCounts,
        count,
        sizeof(int32))

fn loweringExportRootIndexAccumulateTerminalRelease(
        releasedBytes: int64,
        releasedBufferCount: var int32,
        totalReleasedBytes: var int64) =
    if releasedBytes > int64(0):
        releasedBufferCount = releasedBufferCount + 1
        totalReleasedBytes = totalReleasedBytes + releasedBytes

fn LoweringExportRootIndexAllocatorBegin(
        index: var LoweringExportRootIndex) =
    if !index.allocatorReceiptReady ||
       LoweringExportRootIndexAllocatorPhysicalBufferCount(index) != 0 ||
       LoweringExportRootIndexAllocatorCapacityBytes(index) != int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(index.allocatorReceipt):
        panic("lowering export root index allocator: begin before release")
    index.allocatorLedger = LoweringSequenceAllocatorLedger()
    index.allocatorReceipt = LoweringSequenceAllocatorReceipt()
    index.allocatorReceiptReady = false
    index.built = false
    index.completed = false
    index.buildFunctionCount = 0
    index.buildBucketVisitCount = 0
    index.lookupCount = 0
    index.lookupBucketVisitCount = 0
    index.lookupCandidateVisitCount = 0
    index.lookupMaxBucketVisitCount = 0
    index.retainedItemCountSnapshot = 0
    index.peakCapacityEstimateBytes = int64(0)

fn LoweringExportRootIndexAllocatorRelease(
        index: var LoweringExportRootIndex) =
    if index.allocatorReceiptReady:
        if LoweringExportRootIndexAllocatorPhysicalBufferCount(index) != 0 ||
           LoweringExportRootIndexAllocatorCapacityBytes(index) != int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(index.allocatorReceipt):
            panic("lowering export root index allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringExportRootIndexAllocatorPhysicalBufferCount(index)
    receipt.terminalRetainedBytes =
        LoweringExportRootIndexAllocatorCapacityBytes(index)
    if index.allocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       index.allocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering export root index allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringExportRootIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            index.allocatorLedger,
            index.candidateBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringExportRootIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            index.allocatorLedger,
            index.candidateEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringExportRootIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            index.allocatorLedger,
            index.candidateEntryKinds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringExportRootIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            index.allocatorLedger,
            index.candidateEntryNames,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringExportRootIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            index.allocatorLedger,
            index.candidateEntryHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringExportRootIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            index.allocatorLedger,
            index.candidateEntryTails,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringExportRootIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            index.allocatorLedger,
            index.candidateNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringExportRootIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            index.allocatorLedger,
            index.candidateFunctionIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringExportRootIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            index.allocatorLedger,
            index.exactExportBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringExportRootIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            index.allocatorLedger,
            index.exactExportEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringExportRootIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            index.allocatorLedger,
            index.exactExportEntryNames,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringExportRootIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            index.allocatorLedger,
            index.exactExportEntryFirstFunctionIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringExportRootIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            index.allocatorLedger,
            index.exactExportEntryCounts,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    index.allocatorLedger.closed = true
    receipt.allocationEventCount = index.allocatorLedger.allocationEventCount
    receipt.releaseEventCount = index.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        index.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        index.allocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount = terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount = index.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes = index.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringExportRootIndexAllocatorPhysicalBufferCount(index) == 0 &&
        LoweringExportRootIndexAllocatorCapacityBytes(index) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering export root index allocator: receipt incomplete")
    index.allocatorReceipt = receipt
    index.allocatorReceiptReady = true
    index.allocatorLedger = LoweringSequenceAllocatorLedger()

@borrows
fn LoweringExportRootIndexBucket(kind: int32,
                                 name: str,
                                 bucketCount: int32): int32 =
    if kind < 0 || name == "" || bucketCount <= 0:
        return -1
    var hash = parser.ParserTextLookupContentHash(name)
    hash = hash * 131 + kind + 1
    return hash & (bucketCount - 1)

@borrows
fn LoweringExportRootIndexFindCandidateEntry(
        index: var LoweringExportRootIndex,
        kind: int32,
        name: str): int32 =
    let bucket = LoweringExportRootIndexBucket(
        kind,
        name,
        index.candidateBucketHeads.len)
    if bucket < 0:
        return -1
    var entryIndex = index.candidateBucketHeads[bucket]
    var visitCount: int32
    while entryIndex >= 0:
        visitCount = visitCount + 1
        index.lookupBucketVisitCount = index.lookupBucketVisitCount + 1
        if visitCount > index.candidateEntryNames.len ||
           entryIndex >= index.candidateEntryNext.len ||
           entryIndex >= index.candidateEntryKinds.len ||
           entryIndex >= index.candidateEntryNames.len ||
           entryIndex >= index.candidateEntryHeads.len ||
           entryIndex >= index.candidateEntryTails.len:
            assert(false, " lowering export root index: candidate chain corrupt")
        if index.candidateEntryKinds[entryIndex] == kind &&
           index.candidateEntryNames[entryIndex] == name:
            if visitCount > index.lookupMaxBucketVisitCount:
                index.lookupMaxBucketVisitCount = visitCount
            return entryIndex
        entryIndex = index.candidateEntryNext[entryIndex]
    if visitCount > index.lookupMaxBucketVisitCount:
        index.lookupMaxBucketVisitCount = visitCount
    return -1

@borrows
fn LoweringExportRootIndexAddCandidate(index: var LoweringExportRootIndex,
                                       kind: int32,
                                       name: str,
                                       functionIndex: int32) =
    if name == "" || functionIndex < 0:
        return
    let bucket = LoweringExportRootIndexBucket(
        kind,
        name,
        index.candidateBucketHeads.len)
    if bucket < 0:
        panic("lowering export root index: candidate key invalid")
    var entryIndex = index.candidateBucketHeads[bucket]
    var visitCount: int32
    while entryIndex >= 0:
        visitCount = visitCount + 1
        index.buildBucketVisitCount = index.buildBucketVisitCount + 1
        if visitCount > index.candidateEntryNames.len ||
           entryIndex >= index.candidateEntryNext.len ||
           entryIndex >= index.candidateEntryKinds.len ||
           entryIndex >= index.candidateEntryNames.len ||
           entryIndex >= index.candidateEntryHeads.len ||
           entryIndex >= index.candidateEntryTails.len:
            assert(false, " lowering export root index: build candidate chain corrupt")
        if index.candidateEntryKinds[entryIndex] == kind &&
           index.candidateEntryNames[entryIndex] == name:
            break
        entryIndex = index.candidateEntryNext[entryIndex]
    if entryIndex < 0:
        entryIndex = index.candidateEntryNames.len
        LoweringExportRootIndexAppendCandidateEntry(
            index,
            index.candidateBucketHeads[bucket],
            kind,
            name,
            -1,
            -1)
        index.candidateBucketHeads[bucket] = entryIndex
    let candidateTail = index.candidateEntryTails[entryIndex]
    if candidateTail >= 0:
        if candidateTail >= index.candidateFunctionIndexes.len ||
           candidateTail >= index.candidateNext.len:
            assert(false, " lowering export root index: candidate tail corrupt")
        if index.candidateFunctionIndexes[candidateTail] == functionIndex:
            return
    let candidateIndex = index.candidateFunctionIndexes.len
    LoweringExportRootIndexAppendCandidateRow(index, -1, functionIndex)
    if candidateTail < 0:
        index.candidateEntryHeads[entryIndex] = candidateIndex
    else:
        index.candidateNext[candidateTail] = candidateIndex
    index.candidateEntryTails[entryIndex] = candidateIndex

@borrows
fn LoweringExportRootIndexAddMatchAliases(index: var LoweringExportRootIndex,
                                          kind: int32,
                                          candidateName: str,
                                          functionIndex: int32) =
    if candidateName == "":
        return
    LoweringExportRootIndexAddCandidate(index,
                                        kind,
                                        candidateName,
                                        functionIndex)
    if candidateName[0] == '_' && len(candidateName) > 1:
        LoweringExportRootIndexAddCandidate(
            index,
            kind,
            strings.SliceBytes(candidateName, 1, len(candidateName) - 1),
            functionIndex)
    LoweringExportRootIndexAddCandidate(index,
                                        kind,
                                        Fmt"_{candidateName}",
                                        functionIndex)

@borrows
fn LoweringExportRootIndexExactBucket(name: str,
                                      bucketCount: int32): int32 =
    if name == "" || bucketCount <= 0:
        return -1
    return parser.ParserTextLookupContentHash(name) & (bucketCount - 1)

@borrows
fn LoweringExportRootIndexAddExactExport(index: var LoweringExportRootIndex,
                                         name: str,
                                         functionIndex: int32) =
    if name == "" || functionIndex < 0:
        return
    let bucket = LoweringExportRootIndexExactBucket(
        name,
        index.exactExportBucketHeads.len)
    if bucket < 0:
        panic("lowering export root index: exact export key invalid")
    var entryIndex = index.exactExportBucketHeads[bucket]
    var visitCount: int32
    while entryIndex >= 0:
        visitCount = visitCount + 1
        index.buildBucketVisitCount = index.buildBucketVisitCount + 1
        if visitCount > index.exactExportEntryNames.len ||
           entryIndex >= index.exactExportEntryNext.len ||
           entryIndex >= index.exactExportEntryNames.len ||
           entryIndex >= index.exactExportEntryFirstFunctionIndexes.len ||
           entryIndex >= index.exactExportEntryCounts.len:
            assert(false, " lowering export root index: exact export chain corrupt")
        if index.exactExportEntryNames[entryIndex] == name:
            index.exactExportEntryCounts[entryIndex] =
                index.exactExportEntryCounts[entryIndex] + 1
            return
        entryIndex = index.exactExportEntryNext[entryIndex]
    let newEntryIndex = index.exactExportEntryNames.len
    LoweringExportRootIndexAppendExactEntry(
        index,
        index.exactExportBucketHeads[bucket],
        name,
        functionIndex,
        1)
    index.exactExportBucketHeads[bucket] = newEntryIndex

@borrows
fn LoweringExportRootIndexRetainedItemCount(
        index: LoweringExportRootIndex): int32 =
    return index.candidateBucketHeads.cap +
           index.candidateEntryNext.cap +
           index.candidateEntryKinds.cap +
           index.candidateEntryNames.cap +
           index.candidateEntryHeads.cap +
           index.candidateEntryTails.cap +
           index.candidateNext.cap +
           index.candidateFunctionIndexes.cap +
           index.exactExportBucketHeads.cap +
           index.exactExportEntryNext.cap +
           index.exactExportEntryNames.cap +
           index.exactExportEntryFirstFunctionIndexes.cap +
           index.exactExportEntryCounts.cap

@borrows
fn LoweringExportRootIndexCapacityEstimateBytes(
        index: LoweringExportRootIndex): int64 =
    var total = Int64(index.candidateEntryNames.cap) * Int64(16) +
                Int64(index.exactExportEntryNames.cap) * Int64(16)
    for entryIndex in 0..<index.candidateEntryNames.len:
        total = total + Int64(len(index.candidateEntryNames[entryIndex]))
    for entryIndex in 0..<index.exactExportEntryNames.len:
        total = total + Int64(len(index.exactExportEntryNames[entryIndex]))
    total = total +
            Int64(index.candidateBucketHeads.cap) * Int64(4) +
            Int64(index.candidateEntryNext.cap) * Int64(4) +
            Int64(index.candidateEntryKinds.cap) * Int64(4) +
            Int64(index.candidateEntryHeads.cap) * Int64(4) +
            Int64(index.candidateEntryTails.cap) * Int64(4) +
            Int64(index.candidateNext.cap) * Int64(4) +
            Int64(index.candidateFunctionIndexes.cap) * Int64(4) +
            Int64(index.exactExportBucketHeads.cap) * Int64(4) +
            Int64(index.exactExportEntryNext.cap) * Int64(4) +
            Int64(index.exactExportEntryFirstFunctionIndexes.cap) * Int64(4) +
            Int64(index.exactExportEntryCounts.cap) * Int64(4)
    return total

fn LoweringBuildExportRootIndex(plan: var LoweringPlanStub,
                                index: var LoweringExportRootIndex,
                                err: var str): bool =
    LoweringExportRootIndexReleasePayload(index)
    LoweringExportRootIndexAllocatorBegin(index)
    let functionCount = plan.functionNames.len
    if plan.functionSymbolTexts.len != functionCount ||
       plan.functionExportedFlags.len != functionCount ||
       plan.functionExportSymbolNames.len != functionCount:
        err = " lowering export root index: function columns mismatch"
        LoweringExportRootIndexReleasePayload(index)
        return false
    let bucketCount = LoweringTypedFunctionIndexBucketCount(functionCount * 8)
    for bucketIndex in 0..<bucketCount:
        LoweringExportRootIndexAppendBuckets(index, -1, -1)
    for functionIndex in 0..<functionCount:
        let functionName = plan.functionNames[functionIndex]
        let functionTail = LoweringFunctionTailName(functionName)
        let symbolText = plan.functionSymbolTexts[functionIndex]
        let exportName = plan.functionExportSymbolNames[functionIndex]
        LoweringExportRootIndexAddMatchAliases(index,
                                               0,
                                               exportName,
                                               functionIndex)
        LoweringExportRootIndexAddMatchAliases(index,
                                               0,
                                               symbolText,
                                               functionIndex)
        LoweringExportRootIndexAddMatchAliases(index,
                                               0,
                                               functionName,
                                               functionIndex)
        LoweringExportRootIndexAddMatchAliases(index,
                                               0,
                                               functionTail,
                                               functionIndex)
        LoweringExportRootIndexAddMatchAliases(index,
                                               1,
                                               functionName,
                                               functionIndex)
        LoweringExportRootIndexAddMatchAliases(index,
                                               1,
                                               functionTail,
                                               functionIndex)
        if plan.functionExportedFlags[functionIndex] != 0:
            LoweringExportRootIndexAddExactExport(index,
                                                  exportName,
                                                  functionIndex)
        index.buildFunctionCount = index.buildFunctionCount + 1
    index.built = true
    index.completed = true
    index.retainedItemCountSnapshot =
        LoweringExportRootIndexRetainedItemCount(index)
    index.peakCapacityEstimateBytes =
        LoweringExportRootIndexCapacityEstimateBytes(index)
    return true

@borrows
fn LoweringExportRootIndexExactExportResult(
        index: var LoweringExportRootIndex,
        root: str): int32 =
    let bucket = LoweringExportRootIndexExactBucket(
        root,
        index.exactExportBucketHeads.len)
    if bucket < 0:
        return -1
    var entryIndex = index.exactExportBucketHeads[bucket]
    var visitCount: int32
    while entryIndex >= 0:
        visitCount = visitCount + 1
        index.lookupBucketVisitCount = index.lookupBucketVisitCount + 1
        if visitCount > index.exactExportEntryNames.len ||
           entryIndex >= index.exactExportEntryNext.len ||
           entryIndex >= index.exactExportEntryNames.len ||
           entryIndex >= index.exactExportEntryFirstFunctionIndexes.len ||
           entryIndex >= index.exactExportEntryCounts.len:
            assert(false, " lowering export root index: exact lookup chain corrupt")
        if index.exactExportEntryNames[entryIndex] == root:
            if visitCount > index.lookupMaxBucketVisitCount:
                index.lookupMaxBucketVisitCount = visitCount
            if index.exactExportEntryCounts[entryIndex] > 1:
                return -2
            return index.exactExportEntryFirstFunctionIndexes[entryIndex]
        entryIndex = index.exactExportEntryNext[entryIndex]
    if visitCount > index.lookupMaxBucketVisitCount:
        index.lookupMaxBucketVisitCount = visitCount
    return -1

fn LoweringExportRootIndexConsiderEntry(
        index: var LoweringExportRootIndex,
        entryIndex: int32,
        foundIndex: var int32): bool =
    if entryIndex < 0:
        return true
    var candidateIndex = index.candidateEntryHeads[entryIndex]
    var visitCount: int32
    while candidateIndex >= 0:
        visitCount = visitCount + 1
        index.lookupCandidateVisitCount = index.lookupCandidateVisitCount + 1
        if visitCount > index.candidateFunctionIndexes.len ||
           candidateIndex >= index.candidateNext.len ||
           candidateIndex >= index.candidateFunctionIndexes.len:
            assert(false, " lowering export root index: lookup candidate chain corrupt")
        let candidateFunctionIndex =
            index.candidateFunctionIndexes[candidateIndex]
        if foundIndex < 0:
            foundIndex = candidateFunctionIndex
        elif foundIndex != candidateFunctionIndex:
            return false
        candidateIndex = index.candidateNext[candidateIndex]
    return true

@borrows
fn LoweringExportRootIndexLookup(index: var LoweringExportRootIndex,
                                 rootRaw: str): int32 =
    if !index.built:
        panic("lowering export root index: lookup before build")
    let root = chengpath.PathTrim(rootRaw)
    if root == "":
        return -1
    index.lookupCount = index.lookupCount + 1
    let exactExportResult = LoweringExportRootIndexExactExportResult(index,
                                                                     root)
    if exactExportResult >= 0 || exactExportResult == -2:
        return exactExportResult
    var foundIndex: int32 = -1
    let directEntry = LoweringExportRootIndexFindCandidateEntry(index,
                                                                 0,
                                                                 root)
    if !LoweringExportRootIndexConsiderEntry(index,
                                              directEntry,
                                              foundIndex):
        return -2
    let rootTail = LoweringFunctionTailName(root)
    if rootTail != root:
        let tailEntry = LoweringExportRootIndexFindCandidateEntry(index,
                                                                   1,
                                                                   rootTail)
        if !LoweringExportRootIndexConsiderEntry(index,
                                                  tailEntry,
                                                  foundIndex):
            return -2
    return foundIndex

fn LoweringExportRootIndexReleasePayload(index: var LoweringExportRootIndex) =
    index.built = false
    index.completed = false
    LoweringExportRootIndexAllocatorRelease(index)

@borrows
fn LoweringMarkReachableCallSurfaces(plan: var LoweringPlanStub,
                                      sourcePath: str,
                                      text: str,
                                      reachable: var bool[],
                                      frontier: var int32[]) =
    let n = len(text)
    if n <= 1:
        return
    for i in 0..<n:
        if text[i] != '(':
            continue
        var identEnd = i
        var identStart = i
        while identStart > 0:
            let ch = text[identStart - 1]
            var identChar = false
            if ch >= 'a' && ch <= 'z':
                identChar = true
            elif ch >= 'A' && ch <= 'Z':
                identChar = true
            elif ch >= '0' && ch <= '9':
                identChar = true
            elif ch == '_':
                identChar = true
            if !identChar:
                break
            identStart = identStart - 1
        if identStart >= identEnd:
            continue
        let head = strings.SliceBytes(text, identStart, identEnd - identStart)
        LoweringMarkReachableCallHead(plan, sourcePath, head, reachable, frontier)
        LoweringMarkReachableCallHead(plan, "", head, reachable, frontier)

fn LoweringExpandReachableFunctionFlags(plan: var LoweringPlanStub,
                                         reachable: var bool[],
                                         frontier: var int32[]) =
    var cursor: int32
    while cursor < frontier.len:
        let functionIndex = frontier[cursor]
        cursor = cursor + 1
        if functionIndex < 0 || functionIndex >= plan.functionNames.len:
            continue
        if functionIndex >= plan.functionSourcePaths.len:
            continue
        let typedFnIndex = LoweringPlanTypedIrFunctionIndex(plan,
                                                            plan.functionSourcePaths[functionIndex],
                                                            plan.functionNames[functionIndex])
        if LoweringTraceOn():
            LoweringDebugLine(Fmt"lowering_expand_visit index={functionIndex} name={plan.functionNames[functionIndex]} typed_index={typedFnIndex}")
        if typedFnIndex < 0 || typedFnIndex >= plan.typedIr.functions2_functionNameIds.len:
            continue
        let fnSourceRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_sourcePathIds[typedFnIndex])
        if !IsOk(fnSourceRes):
            continue
        let typedFnSourcePathRaw = Value(fnSourceRes)
        let typedFnSourcePath = parser.ParserNormalizePath(typedFnSourcePathRaw)
        var stmtEnd = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_statementStarts, typedFnIndex) + arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_statementCounts, typedFnIndex)
        if stmtEnd > plan.typedIr.statements2_statementIndexs.len:
            stmtEnd = plan.typedIr.statements2_statementIndexs.len
        for stmtIndex in arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_statementStarts, typedFnIndex)..<stmtEnd:
            let stmt = texpr.TypedExprIrStatement(
                sourcePath: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_sourcePathIds[stmtIndex])),
                functionName: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_functionNameIds[stmtIndex])),
                statementIndex: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_statementIndexs, stmtIndex),
                lineNumber: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_lineNumbers, stmtIndex),
                columnNumber: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_columnNumbers, stmtIndex),
                lineIndent: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_lineIndents, stmtIndex),
                enclosingIfLineNumber: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_enclosingIfLineNumbers, stmtIndex),
                enclosingIfConditionText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_enclosingIfConditionTextIds[stmtIndex])),
                exprId: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_exprIdIds[stmtIndex])),
                kind: plan.typedIr.statements2_kinds[stmtIndex],
                callKind: plan.typedIr.statements2_callKinds[stmtIndex],
                detailKind: plan.typedIr.statements2_detailKinds[stmtIndex],
                surfaceText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_surfaceTextIds[stmtIndex])),
                bindingName: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_bindingNameIds[stmtIndex])),
                resultType: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_resultTypeIds[stmtIndex])),
                conditionKind: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_conditionKinds, stmtIndex),
                conditionLhsText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_conditionLhsTextIds[stmtIndex])),
                conditionRhsText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_conditionRhsTextIds[stmtIndex])),
                conditionLiteralText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_conditionLiteralTextIds[stmtIndex])),
                assignRootName: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignRootNameIds[stmtIndex])),
                assignRootType: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignRootTypeIds[stmtIndex])),
                assignRootSourcePath: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignRootSourcePathIds[stmtIndex])),
                assignRootGlobalFlag: plan.typedIr.statements2_assignRootGlobalFlags[stmtIndex],
                assignPlaceKind: plan.typedIr.statements2_assignPlaceKinds[stmtIndex],
                assignFieldName: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignFieldNameIds[stmtIndex])),
                assignFieldType: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignFieldTypeIds[stmtIndex])),
                assignFieldOffsetBytes: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignFieldOffsetBytes, stmtIndex),
                assignFieldSizeBytes: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignFieldSizeBytes, stmtIndex),
                assignFieldAlignBytes: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignFieldAlignBytes, stmtIndex),
                assignValueRootName: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignValueRootNameIds[stmtIndex])),
                assignValueRootType: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignValueRootTypeIds[stmtIndex])),
                assignValueFieldName: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignValueFieldNameIds[stmtIndex])),
                assignValueFieldType: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignValueFieldTypeIds[stmtIndex])),
                assignValueFieldOffsetBytes: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignValueFieldOffsetBytes, stmtIndex),
                assignValueFieldSizeBytes: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignValueFieldSizeBytes, stmtIndex),
                assignValueFieldAlignBytes: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignValueFieldAlignBytes, stmtIndex),
                assignValueOpKind: plan.typedIr.statements2_assignValueOpKinds[stmtIndex],
                assignValueLhsText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignValueLhsTextIds[stmtIndex])),
                assignValueRhsText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_assignValueRhsTextIds[stmtIndex])),
                assignValueRhsConst: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignValueRhsConsts, stmtIndex),
                assignValueRhsHasConst: plan.typedIr.statements2_assignValueRhsHasConsts[stmtIndex],
                callQualifier: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_callQualifierIds[stmtIndex])),
                callCallee: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_callCalleeIds[stmtIndex])),
                callTarget: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_callTargetIds[stmtIndex])),
                callTargetSourcePath: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_callTargetSourcePathIds[stmtIndex])),
                callTargetSignatureLineNumber: arenamod.ArenaArrayInt32Get(
                    plan.typedIr.arena,
                    plan.typedIr.statements2_callTargetSignatureLineNumbers,
                    stmtIndex),
                callTargetImportc: plan.typedIr.statements2_callTargetImportcs[stmtIndex],
                callArgCount: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_callArgCounts, stmtIndex),
                callArgsText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_callArgsTextIds[stmtIndex])),
                callArgTypesText: Value(langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_callArgTypesTextIds[stmtIndex])),
                callArgNodeStart: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_callArgNodeStarts, stmtIndex),
                callArgNodeCount: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_callArgNodeCounts, stmtIndex),
                rhsNodeIndex: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_rhsNodeIndexs, stmtIndex),
                rhsBailReason: plan.typedIr.statements2_rhsBailReasons[stmtIndex],
                callSurfaceKind: plan.typedIr.statements2_callSurfaceKinds[stmtIndex],
                forStartNodeIndex: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_forStartNodeIndexs, stmtIndex),
                assignLvalueNodeIndex: arenamod.ArenaArrayInt32Get(
                    plan.typedIr.arena,
                    plan.typedIr.statements2_assignLvalueNodeIndexs,
                    stmtIndex),
                assignIndexNodeIndex: arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_assignIndexNodeIndexs, stmtIndex),
                bindingTargetDefinitionRow: arenamod.ArenaArrayInt32Get(
                    plan.typedIr.arena,
                    plan.typedIr.statements2_bindingTargetDefinitionRows,
                    stmtIndex),
                loweringMode: plan.typedIr.statements2_loweringModes[stmtIndex],
                returnKind: plan.typedIr.statements2_returnKinds[stmtIndex],
                returnRoot: plan.typedIr.statements2_returnRoots[stmtIndex],
            )
            if LoweringTraceOn():
                LoweringDebugLine(Fmt"lowering_expand_stmt fn={plan.functionNames[functionIndex]} stmt_kind={int32(stmt.kind)} call_target={stmt.callTarget} importc={stmt.callTargetImportc}")
            if len(stmt.callTarget) <= 0:
                if stmt.kind == texpr.TypedExprIrStmtReturn:
                    let returnCallHead = LoweringReachabilityCallHeadFromWholeCall(LoweringReachabilityReturnExprText(stmt))
                    LoweringMarkReachableCallHead(plan,
                                                  typedFnSourcePathRaw,
                                                  returnCallHead,
                                                  reachable,
                                                  frontier)
                LoweringMarkReachableCallSurfaces(plan,
                                                  typedFnSourcePathRaw,
                                                  stmt.surfaceText,
                                                  reachable,
                                                  frontier)
                continue
            if stmt.callTargetImportc:
                continue
            LoweringMarkReachableCallHead(plan,
                                          stmt.callTargetSourcePath,
                                          stmt.callTarget,
                                          reachable,
                                          frontier)
            LoweringMarkReachableAddressArgs(plan,
                                             typedFnSourcePathRaw,
                                             stmt.callArgsText,
                                             reachable,
                                             frontier)
            LoweringMarkReachableCallSurfaces(plan,
                                              typedFnSourcePathRaw,
                                              stmt.callArgsText,
                                              reachable,
                                              frontier)
            LoweringMarkReachableCallSurfaces(plan,
                                              typedFnSourcePathRaw,
                                              stmt.surfaceText,
                                              reachable,
                                              frontier)
        let returnExprRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_returnExprIds[typedFnIndex])
        if !IsOk(returnExprRes):
            continue
        let functionReturnCallHead = LoweringReachabilityCallHeadFromWholeCall(Value(returnExprRes))
        LoweringMarkReachableCallHead(plan,
                                      typedFnSourcePathRaw,
                                      functionReturnCallHead,
                                      reachable,
                                      frontier)
        let typedFnFirstLine = arenamod.ArenaArrayInt32Get(plan.typedIr.arena,
                                                           plan.typedIr.functions2_signatureLineNumbers,
                                                           typedFnIndex)
        let typedFnLastLine = arenamod.ArenaArrayInt32Get(plan.typedIr.arena,
                                                          plan.typedIr.functions2_endLineNumbers,
                                                          typedFnIndex)
        LoweringMarkResolvedCallSnapshotReachableInRange(plan,
                                                         typedFnSourcePath,
                                                         typedFnFirstLine,
                                                         typedFnLastLine,
                                                         reachable,
                                                         frontier)

fn LoweringBuildExecutableReachableFunctionFlags(plan: var LoweringPlanStub): bool[] =
    var reachable: bool[]
    var frontier: int32[]
    for i in 0..<plan.functionNames.len:
        add(reachable, false)
    for i in 0..<plan.functionEntryFlags.len:
        if i >= reachable.len:
            continue
        if plan.functionEntryFlags[i] == 0:
            continue
        LoweringMarkReachableFunctionIndex(i, reachable, frontier)
    LoweringExpandReachableFunctionFlags(plan, reachable, frontier)
    return reachable

@borrows
fn LoweringFunctionReferenceSourceBucket(sourcePath: str,
                                           bucketCount: int32): int32 =
    if sourcePath == "" || bucketCount <= 0:
        return -1
    return parser.ParserTextLookupContentHash(sourcePath) & (bucketCount - 1)

@borrows
fn LoweringFunctionReferenceAliasBucket(sourceIndex: int32,
                                          aliasName: str,
                                          bucketCount: int32): int32 =
    if sourceIndex < 0 || aliasName == "" || bucketCount <= 0:
        return -1
    var hash = parser.ParserTextLookupContentHash(aliasName)
    hash = hash * 131 + sourceIndex + 1
    return hash & (bucketCount - 1)

@borrows
fn LoweringFunctionReferenceGlobalBucket(aliasName: str,
                                           bucketCount: int32): int32 =
    if aliasName == "" || bucketCount <= 0:
        return -1
    return parser.ParserTextLookupContentHash(aliasName) & (bucketCount - 1)

@borrows
fn LoweringTypedFunctionReferenceAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.typedFunctionReferenceSourcePaths.cap > 0: count = count + 1
    if plan.typedFunctionReferenceSourceBucketHeads.cap > 0: count = count + 1
    if plan.typedFunctionReferenceSourceEntryNext.cap > 0: count = count + 1
    if plan.typedFunctionReferenceAliasBucketHeads.cap > 0: count = count + 1
    if plan.typedFunctionReferenceAliasEntryNext.cap > 0: count = count + 1
    if plan.typedFunctionReferenceAliasEntrySourceIndexes.cap > 0:
        count = count + 1
    if plan.typedFunctionReferenceAliasEntryNames.cap > 0: count = count + 1
    if plan.typedFunctionReferenceAliasEntryCandidateHeads.cap > 0:
        count = count + 1
    if plan.typedFunctionReferenceAliasEntryCandidateTails.cap > 0:
        count = count + 1
    if plan.typedFunctionReferenceAliasCandidateNext.cap > 0: count = count + 1
    if plan.typedFunctionReferenceAliasCandidateFunctionIndexes.cap > 0:
        count = count + 1
    if plan.typedFunctionReferenceGlobalBucketHeads.cap > 0: count = count + 1
    if plan.typedFunctionReferenceGlobalEntryNext.cap > 0: count = count + 1
    if plan.typedFunctionReferenceGlobalEntryNames.cap > 0: count = count + 1
    if plan.typedFunctionReferenceGlobalEntryCandidateHeads.cap > 0:
        count = count + 1
    if plan.typedFunctionReferenceGlobalEntryCandidateTails.cap > 0:
        count = count + 1
    if plan.typedFunctionReferenceGlobalCandidateNext.cap > 0: count = count + 1
    if plan.typedFunctionReferenceGlobalCandidateSourceIndexes.cap > 0:
        count = count + 1
    if plan.typedFunctionReferenceGlobalCandidateFunctionIndexes.cap > 0:
        count = count + 1
    if plan.typedFunctionReferenceClaimedFlags.cap > 0: count = count + 1
    if plan.typedFunctionReferenceFlags.cap > 0: count = count + 1
    return count

@borrows
fn LoweringTypedFunctionReferenceAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(plan.typedFunctionReferenceSourcePaths.cap) *
            int64(sizeof(str)) +
        int64(plan.typedFunctionReferenceSourceBucketHeads.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceSourceEntryNext.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceAliasBucketHeads.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceAliasEntryNext.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceAliasEntrySourceIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceAliasEntryNames.cap) *
            int64(sizeof(str)) +
        int64(plan.typedFunctionReferenceAliasEntryCandidateHeads.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceAliasEntryCandidateTails.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceAliasCandidateNext.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceAliasCandidateFunctionIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceGlobalBucketHeads.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceGlobalEntryNext.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceGlobalEntryNames.cap) *
            int64(sizeof(str)) +
        int64(plan.typedFunctionReferenceGlobalEntryCandidateHeads.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceGlobalEntryCandidateTails.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceGlobalCandidateNext.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceGlobalCandidateSourceIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceGlobalCandidateFunctionIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionReferenceClaimedFlags.cap) *
            int64(sizeof(bool)) +
        int64(plan.typedFunctionReferenceFlags.cap) *
            int64(sizeof(bool))

fn LoweringTypedFunctionReferenceAppendSourceBucket(
        plan: var LoweringPlanStub,
        bucketHead: int32) =
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceSourceBucketHeads,
        bucketHead,
        sizeof(int32))

fn LoweringTypedFunctionReferenceAppendAliasGlobalBuckets(
        plan: var LoweringPlanStub,
        bucketHead: int32) =
    if plan.typedFunctionReferenceAliasBucketHeads.len !=
       plan.typedFunctionReferenceGlobalBucketHeads.len:
        panic("lowering function reference allocator: bucket shape drift")
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceAliasBucketHeads,
        bucketHead,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceGlobalBucketHeads,
        bucketHead,
        sizeof(int32))

fn LoweringTypedFunctionReferenceSetFlagDomain(
        plan: var LoweringPlanStub,
        functionCount: int32) =
    if plan.typedFunctionReferenceFlags.len != 0 ||
       plan.typedFunctionReferenceClaimedFlags.len != 0:
        panic("lowering function reference allocator: flag domain already bound")
    loweringSequenceAllocatorSetLen(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceFlags,
        functionCount,
        sizeof(bool))
    loweringSequenceAllocatorSetLen(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceClaimedFlags,
        functionCount,
        sizeof(bool))

@borrows
fn LoweringTypedFunctionReferenceAppendSourceRow(
        plan: var LoweringPlanStub,
        sourcePath: str,
        entryNext: int32) =
    if plan.typedFunctionReferenceSourcePaths.len !=
       plan.typedFunctionReferenceSourceEntryNext.len:
        panic("lowering function reference allocator: source row shape drift")
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceSourcePaths,
        sourcePath,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceSourceEntryNext,
        entryNext,
        sizeof(int32))

@borrows
fn LoweringTypedFunctionReferenceAppendAliasEntry(
        plan: var LoweringPlanStub,
        entryNext: int32,
        sourceIndex: int32,
        aliasName: str,
        candidateHead: int32,
        candidateTail: int32) =
    let rowCount = plan.typedFunctionReferenceAliasEntryNames.len
    if plan.typedFunctionReferenceAliasEntryNext.len != rowCount ||
       plan.typedFunctionReferenceAliasEntrySourceIndexes.len != rowCount ||
       plan.typedFunctionReferenceAliasEntryCandidateHeads.len != rowCount ||
       plan.typedFunctionReferenceAliasEntryCandidateTails.len != rowCount:
        panic("lowering function reference allocator: alias entry shape drift")
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceAliasEntryNext,
        entryNext,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceAliasEntrySourceIndexes,
        sourceIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceAliasEntryNames,
        aliasName,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceAliasEntryCandidateHeads,
        candidateHead,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceAliasEntryCandidateTails,
        candidateTail,
        sizeof(int32))

fn LoweringTypedFunctionReferenceAppendAliasCandidate(
        plan: var LoweringPlanStub,
        candidateNext: int32,
        functionIndex: int32) =
    if plan.typedFunctionReferenceAliasCandidateNext.len !=
       plan.typedFunctionReferenceAliasCandidateFunctionIndexes.len:
        panic("lowering function reference allocator: alias candidate shape drift")
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceAliasCandidateNext,
        candidateNext,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceAliasCandidateFunctionIndexes,
        functionIndex,
        sizeof(int32))

@borrows
fn LoweringTypedFunctionReferenceAppendGlobalEntry(
        plan: var LoweringPlanStub,
        entryNext: int32,
        aliasName: str,
        candidateHead: int32,
        candidateTail: int32) =
    let rowCount = plan.typedFunctionReferenceGlobalEntryNames.len
    if plan.typedFunctionReferenceGlobalEntryNext.len != rowCount ||
       plan.typedFunctionReferenceGlobalEntryCandidateHeads.len != rowCount ||
       plan.typedFunctionReferenceGlobalEntryCandidateTails.len != rowCount:
        panic("lowering function reference allocator: global entry shape drift")
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceGlobalEntryNext,
        entryNext,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceGlobalEntryNames,
        aliasName,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceGlobalEntryCandidateHeads,
        candidateHead,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceGlobalEntryCandidateTails,
        candidateTail,
        sizeof(int32))

fn LoweringTypedFunctionReferenceAppendGlobalCandidate(
        plan: var LoweringPlanStub,
        candidateNext: int32,
        sourceIndex: int32,
        functionIndex: int32) =
    let rowCount =
        plan.typedFunctionReferenceGlobalCandidateFunctionIndexes.len
    if plan.typedFunctionReferenceGlobalCandidateNext.len != rowCount ||
       plan.typedFunctionReferenceGlobalCandidateSourceIndexes.len != rowCount:
        panic("lowering function reference allocator: global candidate shape drift")
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceGlobalCandidateNext,
        candidateNext,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceGlobalCandidateSourceIndexes,
        sourceIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionReferenceAllocatorLedger,
        plan.typedFunctionReferenceGlobalCandidateFunctionIndexes,
        functionIndex,
        sizeof(int32))

fn loweringTypedFunctionReferenceAccumulateTerminalRelease(
        releasedBytes: int64,
        releasedBufferCount: var int32,
        totalReleasedBytes: var int64) =
    if releasedBytes > int64(0):
        releasedBufferCount = releasedBufferCount + 1
        totalReleasedBytes = totalReleasedBytes + releasedBytes

fn LoweringTypedFunctionReferenceAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.typedFunctionReferenceAllocatorReceiptReady ||
       LoweringTypedFunctionReferenceAllocatorPhysicalBufferCount(plan) != 0 ||
       LoweringTypedFunctionReferenceAllocatorCapacityBytes(plan) != int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.typedFunctionReferenceAllocatorReceipt):
        panic("lowering function reference allocator: begin before closed release")
    plan.typedFunctionReferenceAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.typedFunctionReferenceAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.typedFunctionReferenceAllocatorReceiptReady = false

fn LoweringTypedFunctionReferenceAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.typedFunctionReferenceAllocatorReceiptReady:
        if LoweringTypedFunctionReferenceAllocatorPhysicalBufferCount(plan) != 0 ||
           LoweringTypedFunctionReferenceAllocatorCapacityBytes(plan) != int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.typedFunctionReferenceAllocatorReceipt):
            panic("lowering function reference allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringTypedFunctionReferenceAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringTypedFunctionReferenceAllocatorCapacityBytes(plan)
    if plan.typedFunctionReferenceAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.typedFunctionReferenceAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering function reference allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceSourcePaths,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceSourceBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceSourceEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceAliasBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceAliasEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceAliasEntrySourceIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceAliasEntryNames,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceAliasEntryCandidateHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceAliasEntryCandidateTails,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceAliasCandidateNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceAliasCandidateFunctionIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceGlobalBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceGlobalEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceGlobalEntryNames,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceGlobalEntryCandidateHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceGlobalEntryCandidateTails,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceGlobalCandidateNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceGlobalCandidateSourceIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceGlobalCandidateFunctionIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceClaimedFlags,
            sizeof(bool)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionReferenceAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionReferenceAllocatorLedger,
            plan.typedFunctionReferenceFlags,
            sizeof(bool)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    plan.typedFunctionReferenceAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.typedFunctionReferenceAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.typedFunctionReferenceAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.typedFunctionReferenceAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.typedFunctionReferenceAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        terminalReleasedBufferCount
    receipt.terminalReleasedBytes =
        terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.typedFunctionReferenceAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.typedFunctionReferenceAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringTypedFunctionReferenceAllocatorPhysicalBufferCount(plan) == 0 &&
        LoweringTypedFunctionReferenceAllocatorCapacityBytes(plan) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering function reference allocator: receipt incomplete")
    plan.typedFunctionReferenceAllocatorReceipt = receipt
    plan.typedFunctionReferenceAllocatorReceiptReady = true
    plan.typedFunctionReferenceAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringPlanReleaseTypedFunctionReferenceIndexPayload(
        plan: var LoweringPlanStub) =
    plan.typedFunctionReferenceIndexBuilt = false
    LoweringTypedFunctionReferenceAllocatorRelease(plan)

fn LoweringResetTypedFunctionReferenceCounters(plan: var LoweringPlanStub) =
    plan.typedFunctionReferenceIndexCompleted = false
    plan.typedFunctionReferenceBuildFunctionCount = 0
    plan.typedFunctionReferenceBuildStatementCount = 0
    plan.typedFunctionReferenceBuildNodeCount = 0
    plan.typedFunctionReferenceBuildBucketVisitCount = 0
    plan.typedFunctionReferenceResolveLookupCount = 0
    plan.typedFunctionReferenceResolveBucketVisitCount = 0
    plan.typedFunctionReferenceResolveMaxBucketVisitCount = 0
    plan.typedFunctionReferenceSurfaceByteVisitCount = Int64(0)
    plan.typedFunctionReferenceDirectTargetCount = 0
    plan.typedFunctionReferenceFuncRefCount = 0
    plan.typedFunctionReferenceSurfaceCount = 0
    plan.typedFunctionReferenceAddressCount = 0
    plan.typedFunctionReferenceReferencedFunctionCount = 0
    plan.typedFunctionReferenceAmbiguousCount = 0
    plan.typedFunctionReferenceMissingCount = 0
    plan.typedFunctionReferenceFlagQueryCount = 0
    plan.typedFunctionReferenceSourceCountSnapshot = 0
    plan.typedFunctionReferenceAliasCountSnapshot = 0
    plan.typedFunctionReferenceGlobalAliasCountSnapshot = 0
    plan.typedFunctionReferencePeakCapacityEstimateBytes = Int64(0)
    plan.typedFunctionReferenceCompositeKeyPayloadBytes = Int64(0)

@borrows
fn LoweringFunctionReferenceFindOrAddSource(plan: var LoweringPlanStub,
                                             sourcePathRaw: str,
                                             err: var str): int32 =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let bucket = LoweringFunctionReferenceSourceBucket(
        sourcePath,
        plan.typedFunctionReferenceSourceBucketHeads.len)
    if bucket < 0:
        err = Fmt" lowering plan: function reference source invalid source={sourcePath}"
        return -1
    var entryIndex = plan.typedFunctionReferenceSourceBucketHeads[bucket]
    var visitCount: int32
    while entryIndex >= 0:
        visitCount = visitCount + 1
        plan.typedFunctionReferenceBuildBucketVisitCount =
            plan.typedFunctionReferenceBuildBucketVisitCount + 1
        if visitCount > plan.typedFunctionReferenceSourcePaths.len:
            err = " lowering plan: function reference source chain cycle"
            return -1
        if entryIndex >= plan.typedFunctionReferenceSourcePaths.len ||
           entryIndex >= plan.typedFunctionReferenceSourceEntryNext.len:
            err = " lowering plan: function reference source chain corrupt"
            return -1
        if plan.typedFunctionReferenceSourcePaths[entryIndex] == sourcePath:
            return entryIndex
        entryIndex = plan.typedFunctionReferenceSourceEntryNext[entryIndex]
    let sourceIndex = plan.typedFunctionReferenceSourcePaths.len
    LoweringTypedFunctionReferenceAppendSourceRow(
        plan,
        sourcePath,
        plan.typedFunctionReferenceSourceBucketHeads[bucket])
    plan.typedFunctionReferenceSourceBucketHeads[bucket] = sourceIndex
    return sourceIndex

@borrows
fn LoweringFunctionReferenceFindSource(plan: var LoweringPlanStub,
                                        sourcePathRaw: str): int32 =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let bucket = LoweringFunctionReferenceSourceBucket(
        sourcePath,
        plan.typedFunctionReferenceSourceBucketHeads.len)
    if bucket < 0:
        return -1
    var entryIndex = plan.typedFunctionReferenceSourceBucketHeads[bucket]
    var visitCount: int32
    while entryIndex >= 0:
        visitCount = visitCount + 1
        plan.typedFunctionReferenceResolveBucketVisitCount =
            plan.typedFunctionReferenceResolveBucketVisitCount + 1
        if visitCount > plan.typedFunctionReferenceSourcePaths.len:
            return -1
        if entryIndex >= plan.typedFunctionReferenceSourcePaths.len ||
           entryIndex >= plan.typedFunctionReferenceSourceEntryNext.len:
            return -1
        if plan.typedFunctionReferenceSourcePaths[entryIndex] == sourcePath:
            if visitCount > plan.typedFunctionReferenceResolveMaxBucketVisitCount:
                plan.typedFunctionReferenceResolveMaxBucketVisitCount = visitCount
            return entryIndex
        entryIndex = plan.typedFunctionReferenceSourceEntryNext[entryIndex]
    if visitCount > plan.typedFunctionReferenceResolveMaxBucketVisitCount:
        plan.typedFunctionReferenceResolveMaxBucketVisitCount = visitCount
    return -1

@borrows
fn LoweringFunctionReferenceAddAlias(plan: var LoweringPlanStub,
                                      sourceIndex: int32,
                                      aliasNameRaw: str,
                                      functionIndex: int32,
                                      err: var str): bool =
    let aliasName = chengpath.PathTrim(aliasNameRaw)
    if sourceIndex < 0 || aliasName == "" || functionIndex < 0:
        err = Fmt" lowering plan: function reference alias invalid source={sourceIndex} alias={aliasName} function={functionIndex}"
        return false
    let aliasBucket = LoweringFunctionReferenceAliasBucket(
        sourceIndex,
        aliasName,
        plan.typedFunctionReferenceAliasBucketHeads.len)
    if aliasBucket < 0:
        err = Fmt" lowering plan: function reference alias bucket invalid alias={aliasName}"
        return false
    var aliasEntryIndex =
        plan.typedFunctionReferenceAliasBucketHeads[aliasBucket]
    var aliasVisitCount: int32
    var aliasFound = false
    while aliasEntryIndex >= 0:
        aliasVisitCount = aliasVisitCount + 1
        plan.typedFunctionReferenceBuildBucketVisitCount =
            plan.typedFunctionReferenceBuildBucketVisitCount + 1
        if aliasVisitCount >
           plan.typedFunctionReferenceAliasEntryNames.len:
            err = " lowering plan: function reference alias chain cycle"
            return false
        if aliasEntryIndex >= plan.typedFunctionReferenceAliasEntryNext.len ||
           aliasEntryIndex >= plan.typedFunctionReferenceAliasEntrySourceIndexes.len ||
           aliasEntryIndex >= plan.typedFunctionReferenceAliasEntryNames.len ||
           aliasEntryIndex >= plan.typedFunctionReferenceAliasEntryCandidateHeads.len ||
           aliasEntryIndex >= plan.typedFunctionReferenceAliasEntryCandidateTails.len:
            err = " lowering plan: function reference alias chain corrupt"
            return false
        if plan.typedFunctionReferenceAliasEntrySourceIndexes[aliasEntryIndex] == sourceIndex &&
           plan.typedFunctionReferenceAliasEntryNames[aliasEntryIndex] == aliasName:
            aliasFound = true
            break
        aliasEntryIndex =
            plan.typedFunctionReferenceAliasEntryNext[aliasEntryIndex]
    if !aliasFound:
        let newAliasEntryIndex =
            plan.typedFunctionReferenceAliasEntryNames.len
        LoweringTypedFunctionReferenceAppendAliasEntry(
            plan,
            plan.typedFunctionReferenceAliasBucketHeads[aliasBucket],
            sourceIndex,
            aliasName,
            -1,
            -1)
        plan.typedFunctionReferenceAliasBucketHeads[aliasBucket] =
            newAliasEntryIndex
        aliasEntryIndex = newAliasEntryIndex
    let localCandidateIndex =
        plan.typedFunctionReferenceAliasCandidateFunctionIndexes.len
    LoweringTypedFunctionReferenceAppendAliasCandidate(
        plan, -1, functionIndex)
    let localTail =
        plan.typedFunctionReferenceAliasEntryCandidateTails[aliasEntryIndex]
    if localTail < 0:
        plan.typedFunctionReferenceAliasEntryCandidateHeads[aliasEntryIndex] =
            localCandidateIndex
    else:
        if localTail >= plan.typedFunctionReferenceAliasCandidateNext.len:
            err = " lowering plan: function reference alias candidate tail corrupt"
            return false
        plan.typedFunctionReferenceAliasCandidateNext[localTail] =
            localCandidateIndex
    plan.typedFunctionReferenceAliasEntryCandidateTails[aliasEntryIndex] =
        localCandidateIndex
    let globalBucket = LoweringFunctionReferenceGlobalBucket(
        aliasName,
        plan.typedFunctionReferenceGlobalBucketHeads.len)
    if globalBucket < 0:
        err = Fmt" lowering plan: function reference global bucket invalid alias={aliasName}"
        return false
    var globalEntryIndex =
        plan.typedFunctionReferenceGlobalBucketHeads[globalBucket]
    var globalVisitCount: int32
    while globalEntryIndex >= 0:
        globalVisitCount = globalVisitCount + 1
        plan.typedFunctionReferenceBuildBucketVisitCount =
            plan.typedFunctionReferenceBuildBucketVisitCount + 1
        if globalVisitCount >
           plan.typedFunctionReferenceGlobalEntryNames.len:
            err = " lowering plan: function reference global chain cycle"
            return false
        if globalEntryIndex >= plan.typedFunctionReferenceGlobalEntryNext.len ||
           globalEntryIndex >= plan.typedFunctionReferenceGlobalEntryNames.len ||
           globalEntryIndex >= plan.typedFunctionReferenceGlobalEntryCandidateHeads.len ||
           globalEntryIndex >= plan.typedFunctionReferenceGlobalEntryCandidateTails.len:
            err = " lowering plan: function reference global chain corrupt"
            return false
        if plan.typedFunctionReferenceGlobalEntryNames[globalEntryIndex] == aliasName:
            break
        globalEntryIndex =
            plan.typedFunctionReferenceGlobalEntryNext[globalEntryIndex]
    if globalEntryIndex < 0:
        let newGlobalEntryIndex =
            plan.typedFunctionReferenceGlobalEntryNames.len
        LoweringTypedFunctionReferenceAppendGlobalEntry(
            plan,
            plan.typedFunctionReferenceGlobalBucketHeads[globalBucket],
            aliasName,
            -1,
            -1)
        plan.typedFunctionReferenceGlobalBucketHeads[globalBucket] =
            newGlobalEntryIndex
        globalEntryIndex = newGlobalEntryIndex
    let globalCandidateIndex =
        plan.typedFunctionReferenceGlobalCandidateFunctionIndexes.len
    LoweringTypedFunctionReferenceAppendGlobalCandidate(
        plan, -1, sourceIndex, functionIndex)
    let globalTail =
        plan.typedFunctionReferenceGlobalEntryCandidateTails[globalEntryIndex]
    if globalTail < 0:
        plan.typedFunctionReferenceGlobalEntryCandidateHeads[globalEntryIndex] =
            globalCandidateIndex
    else:
        if globalTail >= plan.typedFunctionReferenceGlobalCandidateNext.len:
            err = " lowering plan: function reference global candidate tail corrupt"
            return false
        plan.typedFunctionReferenceGlobalCandidateNext[globalTail] =
            globalCandidateIndex
    plan.typedFunctionReferenceGlobalEntryCandidateTails[globalEntryIndex] =
        globalCandidateIndex
    return true

@borrows
fn LoweringFunctionReferenceLookupLocalExact(plan: var LoweringPlanStub,
                                               sourceIndex: int32,
                                               aliasNameRaw: str): int32 =
    let aliasName = chengpath.PathTrim(aliasNameRaw)
    plan.typedFunctionReferenceResolveLookupCount =
        plan.typedFunctionReferenceResolveLookupCount + 1
    let bucket = LoweringFunctionReferenceAliasBucket(
        sourceIndex,
        aliasName,
        plan.typedFunctionReferenceAliasBucketHeads.len)
    if bucket < 0:
        return -1
    var entryIndex = plan.typedFunctionReferenceAliasBucketHeads[bucket]
    var visitCount: int32
    while entryIndex >= 0:
        visitCount = visitCount + 1
        plan.typedFunctionReferenceResolveBucketVisitCount =
            plan.typedFunctionReferenceResolveBucketVisitCount + 1
        if visitCount > plan.typedFunctionReferenceAliasEntryNames.len ||
           entryIndex >= plan.typedFunctionReferenceAliasEntryNext.len ||
           entryIndex >= plan.typedFunctionReferenceAliasEntrySourceIndexes.len ||
           entryIndex >= plan.typedFunctionReferenceAliasEntryNames.len ||
           entryIndex >= plan.typedFunctionReferenceAliasEntryCandidateHeads.len ||
           entryIndex >= plan.typedFunctionReferenceAliasEntryCandidateTails.len:
            assert(false, " lowering plan: function reference local lookup chain corrupt")
        if plan.typedFunctionReferenceAliasEntrySourceIndexes[entryIndex] == sourceIndex &&
           plan.typedFunctionReferenceAliasEntryNames[entryIndex] == aliasName:
            if visitCount > plan.typedFunctionReferenceResolveMaxBucketVisitCount:
                plan.typedFunctionReferenceResolveMaxBucketVisitCount = visitCount
            return entryIndex
        entryIndex = plan.typedFunctionReferenceAliasEntryNext[entryIndex]
    if visitCount > plan.typedFunctionReferenceResolveMaxBucketVisitCount:
        plan.typedFunctionReferenceResolveMaxBucketVisitCount = visitCount
    return -1

@borrows
fn LoweringFunctionReferenceLookupGlobalExact(plan: var LoweringPlanStub,
                                                aliasNameRaw: str): int32 =
    let aliasName = chengpath.PathTrim(aliasNameRaw)
    plan.typedFunctionReferenceResolveLookupCount =
        plan.typedFunctionReferenceResolveLookupCount + 1
    let bucket = LoweringFunctionReferenceGlobalBucket(
        aliasName,
        plan.typedFunctionReferenceGlobalBucketHeads.len)
    if bucket < 0:
        return -1
    var entryIndex = plan.typedFunctionReferenceGlobalBucketHeads[bucket]
    var visitCount: int32
    while entryIndex >= 0:
        visitCount = visitCount + 1
        plan.typedFunctionReferenceResolveBucketVisitCount =
            plan.typedFunctionReferenceResolveBucketVisitCount + 1
        if visitCount > plan.typedFunctionReferenceGlobalEntryNames.len ||
           entryIndex >= plan.typedFunctionReferenceGlobalEntryNext.len ||
           entryIndex >= plan.typedFunctionReferenceGlobalEntryNames.len ||
           entryIndex >= plan.typedFunctionReferenceGlobalEntryCandidateHeads.len ||
           entryIndex >= plan.typedFunctionReferenceGlobalEntryCandidateTails.len:
            assert(false, " lowering plan: function reference global lookup chain corrupt")
        if plan.typedFunctionReferenceGlobalEntryNames[entryIndex] == aliasName:
            if visitCount > plan.typedFunctionReferenceResolveMaxBucketVisitCount:
                plan.typedFunctionReferenceResolveMaxBucketVisitCount = visitCount
            return entryIndex
        entryIndex = plan.typedFunctionReferenceGlobalEntryNext[entryIndex]
    if visitCount > plan.typedFunctionReferenceResolveMaxBucketVisitCount:
        plan.typedFunctionReferenceResolveMaxBucketVisitCount = visitCount
    return -1

@borrows
fn LoweringFunctionReferenceDotTail(nameRaw: str): str =
    let name = chengpath.PathTrim(nameRaw)
    var tailStart: int32
    for i in 0..<len(name):
        if name[i] == '.':
            tailStart = i + 1
    if tailStart > 0 && tailStart < len(name):
        return strings.SliceBytes(name, tailStart, len(name) - tailStart)
    return name

fn LoweringFunctionReferenceRecordKind(plan: var LoweringPlanStub,
                                        referenceKind: int32,
                                        err: var str): bool =
    if referenceKind == 1:
        plan.typedFunctionReferenceDirectTargetCount =
            plan.typedFunctionReferenceDirectTargetCount + 1
    elif referenceKind == 2:
        plan.typedFunctionReferenceFuncRefCount =
            plan.typedFunctionReferenceFuncRefCount + 1
    elif referenceKind == 3:
        plan.typedFunctionReferenceSurfaceCount =
            plan.typedFunctionReferenceSurfaceCount + 1
    elif referenceKind == 4:
        plan.typedFunctionReferenceAddressCount =
            plan.typedFunctionReferenceAddressCount + 1
    else:
        err = Fmt" lowering plan: invalid function reference kind={referenceKind}"
        return false
    return true

@borrows
fn LoweringFunctionReferenceMarkFunction(plan: var LoweringPlanStub,
                                          functionIndex: int32,
                                          referenceText: str,
                                          err: var str): bool =
    if functionIndex < 0 ||
       functionIndex >= plan.typedFunctionReferenceFlags.len ||
       functionIndex >= plan.typedFunctionReferenceClaimedFlags.len:
        err = Fmt" lowering plan: function reference target out of range index={functionIndex} text={referenceText}"
        return false
    if plan.typedFunctionReferenceClaimedFlags[functionIndex]:
        return true
    if !plan.typedFunctionReferenceFlags[functionIndex]:
        plan.typedFunctionReferenceFlags[functionIndex] = true
        plan.typedFunctionReferenceReferencedFunctionCount =
            plan.typedFunctionReferenceReferencedFunctionCount + 1
    return true

@borrows
fn LoweringFunctionReferenceMarkLocalEntry(plan: var LoweringPlanStub,
                                            entryIndex: int32,
                                            referenceText: str,
                                            err: var str): bool =
    if entryIndex < 0 ||
       entryIndex >= plan.typedFunctionReferenceAliasEntryCandidateHeads.len:
        return true
    var candidateIndex =
        plan.typedFunctionReferenceAliasEntryCandidateHeads[entryIndex]
    var visitCount: int32
    while candidateIndex >= 0:
        visitCount = visitCount + 1
        if visitCount > plan.typedFunctionReferenceAliasCandidateFunctionIndexes.len ||
           candidateIndex >= plan.typedFunctionReferenceAliasCandidateNext.len ||
           candidateIndex >= plan.typedFunctionReferenceAliasCandidateFunctionIndexes.len:
            err = " lowering plan: function reference local candidate chain corrupt"
            return false
        if !LoweringFunctionReferenceMarkFunction(
                plan,
                plan.typedFunctionReferenceAliasCandidateFunctionIndexes[candidateIndex],
                referenceText,
                err):
            return false
        candidateIndex =
            plan.typedFunctionReferenceAliasCandidateNext[candidateIndex]
    return true

@borrows
fn LoweringFunctionReferenceMarkLocalName(plan: var LoweringPlanStub,
                                           sourceIndex: int32,
                                           nameRaw: str,
                                           includeDotTail: bool,
                                           referenceKind: int32,
                                           referenceText: str,
                                           err: var str): bool =
    let name = chengpath.PathTrim(nameRaw)
    let colonTail = LoweringFunctionTailName(name)
    let dotTail = LoweringFunctionReferenceDotTail(colonTail)
    var found = false
    let exactEntry = LoweringFunctionReferenceLookupLocalExact(plan,
                                                                sourceIndex,
                                                                name)
    if exactEntry >= 0:
        found = true
        if !LoweringFunctionReferenceMarkLocalEntry(plan,
                                                     exactEntry,
                                                     referenceText,
                                                     err):
            return false
    if colonTail != name:
        let tailEntry = LoweringFunctionReferenceLookupLocalExact(plan,
                                                                   sourceIndex,
                                                                   colonTail)
        if tailEntry >= 0:
            found = true
            if !LoweringFunctionReferenceMarkLocalEntry(plan,
                                                         tailEntry,
                                                         referenceText,
                                                         err):
                return false
    if includeDotTail && dotTail != name && dotTail != colonTail:
        let dotEntry = LoweringFunctionReferenceLookupLocalExact(plan,
                                                                  sourceIndex,
                                                                  dotTail)
        if dotEntry >= 0:
            found = true
            if !LoweringFunctionReferenceMarkLocalEntry(plan,
                                                         dotEntry,
                                                         referenceText,
                                                         err):
                return false
    if !found:
        return false
    return LoweringFunctionReferenceRecordKind(plan, referenceKind, err)

fn LoweringFunctionReferenceGlobalEntrySource(
        plan: var LoweringPlanStub,
        entryIndex: int32,
        uniqueSourceIndex: var int32,
        multipleSources: var bool): bool =
    if entryIndex < 0 ||
       entryIndex >= plan.typedFunctionReferenceGlobalEntryCandidateHeads.len:
        return false
    var found = false
    var candidateIndex =
        plan.typedFunctionReferenceGlobalEntryCandidateHeads[entryIndex]
    var visitCount: int32
    while candidateIndex >= 0:
        visitCount = visitCount + 1
        if visitCount > plan.typedFunctionReferenceGlobalCandidateSourceIndexes.len ||
           candidateIndex >= plan.typedFunctionReferenceGlobalCandidateNext.len ||
           candidateIndex >= plan.typedFunctionReferenceGlobalCandidateSourceIndexes.len:
            assert(false, " lowering plan: function reference global candidate chain corrupt")
        let sourceIndex =
            plan.typedFunctionReferenceGlobalCandidateSourceIndexes[candidateIndex]
        if uniqueSourceIndex < 0:
            uniqueSourceIndex = sourceIndex
        elif uniqueSourceIndex != sourceIndex:
            multipleSources = true
        found = true
        candidateIndex =
            plan.typedFunctionReferenceGlobalCandidateNext[candidateIndex]
    return found

@borrows
fn LoweringFunctionReferenceMarkGlobalEntryForSource(
        plan: var LoweringPlanStub,
        entryIndex: int32,
        sourceIndex: int32,
        referenceText: str,
        err: var str): bool =
    var candidateIndex =
        plan.typedFunctionReferenceGlobalEntryCandidateHeads[entryIndex]
    var visitCount: int32
    while candidateIndex >= 0:
        visitCount = visitCount + 1
        if visitCount > plan.typedFunctionReferenceGlobalCandidateFunctionIndexes.len ||
           candidateIndex >= plan.typedFunctionReferenceGlobalCandidateNext.len ||
           candidateIndex >= plan.typedFunctionReferenceGlobalCandidateSourceIndexes.len ||
           candidateIndex >= plan.typedFunctionReferenceGlobalCandidateFunctionIndexes.len:
            err = " lowering plan: function reference global candidate chain corrupt"
            return false
        if plan.typedFunctionReferenceGlobalCandidateSourceIndexes[candidateIndex] ==
           sourceIndex:
            if !LoweringFunctionReferenceMarkFunction(
                    plan,
                    plan.typedFunctionReferenceGlobalCandidateFunctionIndexes[candidateIndex],
                    referenceText,
                    err):
                return false
        candidateIndex =
            plan.typedFunctionReferenceGlobalCandidateNext[candidateIndex]
    return true

@borrows
fn LoweringFunctionReferenceMarkUniqueGlobalName(
        plan: var LoweringPlanStub,
        nameRaw: str,
        includeDotTail: bool,
        referenceKind: int32,
        referenceText: str,
        err: var str): bool =
    let name = chengpath.PathTrim(nameRaw)
    let colonTail = LoweringFunctionTailName(name)
    let dotTail = LoweringFunctionReferenceDotTail(colonTail)
    var entries: int32[3]
    entries[0] = -1
    entries[1] = -1
    entries[2] = -1
    var entryCount: int32
    let exactEntry = LoweringFunctionReferenceLookupGlobalExact(plan, name)
    if exactEntry >= 0:
        entries[entryCount] = exactEntry
        entryCount = entryCount + 1
    if colonTail != name:
        let tailEntry = LoweringFunctionReferenceLookupGlobalExact(plan,
                                                                    colonTail)
        if tailEntry >= 0:
            entries[entryCount] = tailEntry
            entryCount = entryCount + 1
    if includeDotTail && dotTail != name && dotTail != colonTail:
        let dotEntry = LoweringFunctionReferenceLookupGlobalExact(plan,
                                                                   dotTail)
        if dotEntry >= 0:
            entries[entryCount] = dotEntry
            entryCount = entryCount + 1
    var uniqueSourceIndex: int32 = -1
    var multipleSources = false
    var found = false
    for entryOffset in 0..<entryCount:
        if LoweringFunctionReferenceGlobalEntrySource(plan,
                                                      entries[entryOffset],
                                                      uniqueSourceIndex,
                                                      multipleSources):
            found = true
    if !found || multipleSources:
        plan.typedFunctionReferenceMissingCount =
            plan.typedFunctionReferenceMissingCount + 1
        return true
    for entryOffset in 0..<entryCount:
        if !LoweringFunctionReferenceMarkGlobalEntryForSource(
                plan,
                entries[entryOffset],
                uniqueSourceIndex,
                referenceText,
                err):
            return false
    return LoweringFunctionReferenceRecordKind(plan, referenceKind, err)

@borrows
fn LoweringFunctionReferenceResolveLocalName(plan: var LoweringPlanStub,
                                              sourceIndex: int32,
                                              nameRaw: str,
                                              includeDotTail: bool,
                                              referenceKind: int32,
                                              referenceText: str,
                                              err: var str): bool =
    if LoweringFunctionReferenceMarkLocalName(plan,
                                              sourceIndex,
                                              nameRaw,
                                              includeDotTail,
                                              referenceKind,
                                              referenceText,
                                              err):
        return true
    if err != "":
        return false
    plan.typedFunctionReferenceMissingCount =
        plan.typedFunctionReferenceMissingCount + 1
    return true

@borrows
fn LoweringFunctionReferenceResolveSurface(plan: var LoweringPlanStub,
                                            sourceIndex: int32,
                                            head: str,
                                            err: var str): bool =
    if LoweringFunctionReferenceMarkLocalName(plan,
                                              sourceIndex,
                                              head,
                                              true,
                                              3,
                                              head,
                                              err):
        return true
    if err != "":
        return false
    return LoweringFunctionReferenceMarkUniqueGlobalName(plan,
                                                         head,
                                                         true,
                                                         3,
                                                         head,
                                                         err)

@borrows
fn LoweringFunctionReferenceScanSurface(plan: var LoweringPlanStub,
                                         sourceIndex: int32,
                                         text: str,
                                         err: var str): bool =
    for i in 0..<len(text):
        plan.typedFunctionReferenceSurfaceByteVisitCount =
            plan.typedFunctionReferenceSurfaceByteVisitCount + Int64(1)
        if text[i] != '(':
            continue
        let identEnd = i
        var identStart = i
        while identStart > 0:
            let ch = text[identStart - 1]
            var identChar = false
            if ch >= 'a' && ch <= 'z':
                identChar = true
            elif ch >= 'A' && ch <= 'Z':
                identChar = true
            elif ch >= '0' && ch <= '9':
                identChar = true
            elif ch == '_' || ch == '.':
                identChar = true
            if !identChar:
                break
            identStart = identStart - 1
        if identStart >= identEnd:
            continue
        let head = strings.SliceBytes(text,
                                      identStart,
                                      identEnd - identStart)
        if !LoweringFunctionReferenceResolveSurface(plan,
                                                    sourceIndex,
                                                    head,
                                                    err):
            return false
    return true

@borrows
fn LoweringFunctionReferenceScanAddressArgs(plan: var LoweringPlanStub,
                                             sourceIndex: int32,
                                             callArgsText: str,
                                             err: var str): bool =
    var hasAddressMarker = false
    for i in 0..<len(callArgsText):
        if callArgsText[i] == '&':
            hasAddressMarker = true
            break
    if !hasAddressMarker:
        return true
    let pieces = texpr.TypedExprSplitTopLevelCsv(callArgsText)
    for i in 0..<pieces.len:
        let addressName = LoweringFunctionAddressArgName(pieces[i])
        if addressName == "":
            continue
        if !LoweringFunctionReferenceResolveLocalName(plan,
                                                      sourceIndex,
                                                      addressName,
                                                      false,
                                                      4,
                                                      addressName,
                                                      err):
            return false
    return true

@borrows
fn LoweringBuildTypedFunctionReferenceIndex(plan: var LoweringPlanStub,
                                             compilerCsg: ccsg.CompilerCsg,
                                             typedFunctionClaimed: bool[],
                                             err: var str): bool =
    LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
    LoweringTypedFunctionReferenceAllocatorBegin(plan)
    LoweringResetTypedFunctionReferenceCounters(plan)
    let functionCount = plan.typedIr.functions2_functionNameIds.len
    if plan.typedIr.functions2_sourcePathIds.len != functionCount ||
       typedFunctionClaimed.len != functionCount:
        err = " lowering plan: function reference function columns mismatch"
        return false
    let sourceBucketCount = LoweringTypedFunctionIndexBucketCount(functionCount)
    let aliasBucketCount = LoweringTypedFunctionIndexBucketCount(functionCount * 2)
    for _sourceBucketIndex in 0..<sourceBucketCount:
        LoweringTypedFunctionReferenceAppendSourceBucket(plan, -1)
    for _aliasBucketIndex in 0..<aliasBucketCount:
        LoweringTypedFunctionReferenceAppendAliasGlobalBuckets(
            plan, -1)
    LoweringTypedFunctionReferenceSetFlagDomain(
        plan, functionCount)
    for functionIndex in 0..<functionCount:
        plan.typedFunctionReferenceClaimedFlags[functionIndex] =
            typedFunctionClaimed[functionIndex]
    for functionIndex in 0..<functionCount:
        let sourceRes: Result[str] = langintern.LookupIntern(
            plan.typedIr.internPool,
            plan.typedIr.functions2_sourcePathIds[functionIndex])
        let nameRes: Result[str] = langintern.LookupIntern(
            plan.typedIr.internPool,
            plan.typedIr.functions2_functionNameIds[functionIndex])
        if !IsOk(sourceRes) || !IsOk(nameRes):
            err = Fmt" lowering plan: function reference definition intern missing index={functionIndex}"
            LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
            return false
        let functionName = chengpath.PathTrim(Value(nameRes))
        let sourceIndex = LoweringFunctionReferenceFindOrAddSource(
            plan,
            Value(sourceRes),
            err)
        if sourceIndex < 0 || functionName == "":
            if err == "":
                err = Fmt" lowering plan: function reference definition invalid index={functionIndex} function={functionName}"
            LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
            return false
        if !LoweringFunctionReferenceAddAlias(plan,
                                               sourceIndex,
                                               functionName,
                                               functionIndex,
                                               err):
            LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
            return false
        let tailName = LoweringFunctionTailName(functionName)
        if tailName != functionName:
            if !LoweringFunctionReferenceAddAlias(plan,
                                                   sourceIndex,
                                                   tailName,
                                                   functionIndex,
                                                   err):
                LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
                return false
        plan.typedFunctionReferenceBuildFunctionCount =
            plan.typedFunctionReferenceBuildFunctionCount + 1
    plan.typedFunctionReferenceSourceCountSnapshot =
        plan.typedFunctionReferenceSourcePaths.len
    plan.typedFunctionReferenceAliasCountSnapshot =
        plan.typedFunctionReferenceAliasEntryNames.len
    plan.typedFunctionReferenceGlobalAliasCountSnapshot =
        plan.typedFunctionReferenceGlobalEntryNames.len
    let statementCount = plan.typedIr.statements2_statementIndexs.len
    if plan.typedIr.statements2_sourcePathIds.len != statementCount ||
       plan.typedIr.statements2_surfaceTextIds.len != statementCount ||
       plan.typedIr.statements2_callArgsTextIds.len != statementCount ||
       plan.typedIr.statements2_callTargetIds.len != statementCount ||
       plan.typedIr.statements2_callTargetSourcePathIds.len != statementCount ||
       arenamod.ArenaArrayInt32Len(
           plan.typedIr.arena,
           plan.typedIr.statements2_callTargetSignatureLineNumbers) !=
           statementCount ||
       plan.typedIr.statements2_callTargetImportcs.len != statementCount:
        err = " lowering plan: function reference statement columns mismatch"
        LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
        return false
    for statementIndex in 0..<statementCount:
        let sourceRes: Result[str] = langintern.LookupIntern(
            plan.typedIr.internPool,
            plan.typedIr.statements2_sourcePathIds[statementIndex])
        let surfaceRes: Result[str] = langintern.LookupIntern(
            plan.typedIr.internPool,
            plan.typedIr.statements2_surfaceTextIds[statementIndex])
        let callArgsRes: Result[str] = langintern.LookupIntern(
            plan.typedIr.internPool,
            plan.typedIr.statements2_callArgsTextIds[statementIndex])
        let callTargetRes: Result[str] = langintern.LookupIntern(
            plan.typedIr.internPool,
            plan.typedIr.statements2_callTargetIds[statementIndex])
        let callTargetSourceRes: Result[str] = langintern.LookupIntern(
            plan.typedIr.internPool,
            plan.typedIr.statements2_callTargetSourcePathIds[statementIndex])
        if !IsOk(sourceRes) || !IsOk(surfaceRes) ||
           !IsOk(callArgsRes) || !IsOk(callTargetRes) ||
           !IsOk(callTargetSourceRes):
            err = Fmt" lowering plan: function reference statement intern missing index={statementIndex}"
            LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
            return false
        let statementSourcePath = Value(sourceRes)
        let statementSourceIndex = LoweringFunctionReferenceFindSource(
            plan,
            statementSourcePath)
        if statementSourceIndex < 0:
            err = Fmt" lowering plan: function reference statement source missing index={statementIndex} source={statementSourcePath}"
            LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
            return false
        let callTarget = chengpath.PathTrim(Value(callTargetRes))
        let callTargetSignatureLineNumber = arenamod.ArenaArrayInt32Get(
            plan.typedIr.arena,
            plan.typedIr.statements2_callTargetSignatureLineNumbers,
            statementIndex)
        if (plan.typedIr.statements2_callTargetImportcs[statementIndex] &&
            callTargetSignatureLineNumber != 0) ||
           (!plan.typedIr.statements2_callTargetImportcs[statementIndex] &&
            callTarget != "" && callTargetSignatureLineNumber <= 0):
            err = Fmt" lowering plan: function reference call identity invalid index={statementIndex} target={callTarget} target_signature_line={callTargetSignatureLineNumber}"
            LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
            return false
        if !plan.typedIr.statements2_callTargetImportcs[statementIndex] &&
           callTarget != "":
            let targetSourcePath = Value(callTargetSourceRes)
            if targetSourcePath == "":
                err = Fmt" lowering plan: function reference target source missing index={statementIndex} target={callTarget}"
                LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
                return false
            let targetSourceIndex = LoweringFunctionReferenceFindSource(
                plan,
                targetSourcePath)
            if !LoweringFunctionReferenceResolveLocalName(plan,
                                                          targetSourceIndex,
                                                          callTarget,
                                                          false,
                                                          1,
                                                          callTarget,
                                                          err):
                LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
                return false
        let surfaceText = Value(surfaceRes)
        let callArgsText = Value(callArgsRes)
        if !LoweringFunctionReferenceScanSurface(plan,
                                                 statementSourceIndex,
                                                 surfaceText,
                                                 err) ||
           !LoweringFunctionReferenceScanSurface(plan,
                                                  statementSourceIndex,
                                                  callArgsText,
                                                  err) ||
           !LoweringFunctionReferenceScanAddressArgs(plan,
                                                      statementSourceIndex,
                                                      callArgsText,
                                                      err):
            LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
            return false
        plan.typedFunctionReferenceBuildStatementCount =
            plan.typedFunctionReferenceBuildStatementCount + 1
    let nodeCount = plan.typedIr.nodes2_nodeIndexs.len
    if plan.typedIr.nodes2_opKinds.len != nodeCount ||
       arenamod.ArenaArrayInt32Len(
           plan.typedIr.arena,
           plan.typedIr.nodes2_funcRefTargetDomains) != nodeCount ||
       arenamod.ArenaArrayInt32Len(
           plan.typedIr.arena,
           plan.typedIr.nodes2_funcRefCallDeclarationRows) != nodeCount:
        err = " lowering plan: function reference node columns mismatch"
        LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
        return false
    for nodeIndex in 0..<nodeCount:
        if plan.typedIr.nodes2_opKinds[nodeIndex] == texpr.TypedExprIrOpFuncRef:
            var targetTypedFunctionIndex: int32
            if !ccsg.CompilerCsgFuncRefTargetTypedFunctionIndexInto(
                    compilerCsg.semanticGraph.reachableFunctionTable,
                    plan.compilerCsgExprSliceSidecar,
                    compilerCsg.parserNormalizedExprReceipt,
                    plan.typedIr,
                    nodeIndex,
                    targetTypedFunctionIndex,
                    err):
                LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
                return false
            if !LoweringFunctionReferenceRecordKind(plan, 2, err) ||
               !LoweringFunctionReferenceMarkFunction(
                    plan,
                    targetTypedFunctionIndex,
                    "exact CallDeclaration FuncRef",
                    err):
                LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
                return false
        plan.typedFunctionReferenceBuildNodeCount =
            plan.typedFunctionReferenceBuildNodeCount + 1
    plan.typedFunctionReferenceIndexBuilt = true
    plan.typedFunctionReferenceIndexCompleted = true
    plan.typedFunctionReferencePeakCapacityEstimateBytes =
        LoweringTypedFunctionReferenceIndexCapacityEstimateBytes(plan)
    return true

@borrows
fn LoweringValidateCompilerCsgFuncRefTargets(
        plan: LoweringPlanStub,
        compilerCsg: ccsg.CompilerCsg,
        err: var str): bool =
    let nodeCount = plan.typedIr.nodes2_nodeIndexs.len
    if plan.typedIr.nodes2_opKinds.len != nodeCount ||
       arenamod.ArenaArrayInt32Len(
           plan.typedIr.arena,
           plan.typedIr.nodes2_funcRefTargetDomains) != nodeCount ||
       arenamod.ArenaArrayInt32Len(
           plan.typedIr.arena,
           plan.typedIr.nodes2_funcRefCallDeclarationRows) != nodeCount:
        err = " lowering plan: exact FuncRef target columns mismatch"
        return false
    for nodeIndex in 0..<nodeCount:
        if plan.typedIr.nodes2_opKinds[nodeIndex] !=
               texpr.TypedExprIrOpFuncRef:
            continue
        var targetTypedFunctionIndex: int32
        if !ccsg.CompilerCsgFuncRefTargetTypedFunctionIndexInto(
                compilerCsg.semanticGraph.reachableFunctionTable,
                plan.compilerCsgExprSliceSidecar,
                compilerCsg.parserNormalizedExprReceipt,
                plan.typedIr,
                nodeIndex,
                targetTypedFunctionIndex,
                err):
            return false
    err = ""
    return true

fn LoweringPlanTypedFunctionIndexIsReferenced(plan: var LoweringPlanStub,
                                               typedFunctionIndex: int32): bool =
    if !plan.typedFunctionReferenceIndexBuilt:
        panic("lowering plan: function reference index not built")
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >= plan.typedFunctionReferenceFlags.len:
        panic(Fmt"lowering plan: function reference query out of range index={typedFunctionIndex}")
    plan.typedFunctionReferenceFlagQueryCount =
        plan.typedFunctionReferenceFlagQueryCount + 1
    return plan.typedFunctionReferenceFlags[typedFunctionIndex]

@borrows
fn LoweringFunctionIsBackendSyntheticRoot(sourcePathRaw: str,
                                           functionNameRaw: str): bool =
    let functionName = chengpath.PathTrim(functionNameRaw)
    # "Panic" joins "assert"/"Assert" in this registry for the same reason:
    # the backend's Result-Value panic-guard synthesis (see
    # PrimaryBodyIrAppendResultValuePanicGuard) appends a CallOp targeting
    # "Panic" directly into a function's bodyIR.callSequence — no real
    # source-level call node ever references it, so the AST-reference scan
    # above (the typed function reference index) can never see this edge. Under
    # a narrow export-root closure (few roots, no unrelated caller happens to
    # reach std/system.cheng's Panic), the row is dropped from
    # plan.functionNames entirely, so later "mark Panic reachable" fixups
    # (PrimaryObjectPlanProgramUsesValueIntrinsic) have no row left to mark —
    # target_index stays -1 and the whole unit trips plan_not_ready. This
    # registry runs before that narrowing decision, so listing the symbol
    # here keeps its typed row in the closure structurally, independent of
    # whether any one function's body has been lowered yet.
    if functionName != "assert" && functionName != "Assert" && functionName != "Panic":
        return false
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let suffix = "/src/std/system.cheng"
    if len(sourcePath) < len(suffix):
        return false
    return strings.SliceBytes(sourcePath,
                              len(sourcePath) - len(suffix),
                              len(suffix)) == suffix

@borrows
fn LoweringFunctionListText(functionSymbolTexts: str[]): str =
    return LoweringListText(functionSymbolTexts)

@borrows
fn LoweringPrimaryObjectIrBodyKindListText(
        ir: PrimaryObjectIr): str =
    if ir.functions.len <= 0:
        return "-"
    var out = ""
    for i in 0..<ir.functions.len:
        if i > 0:
            out = Fmt"{out},"
        out = Fmt"{out}{ir.functions[i].bodyKind}"
    return out

@borrows
fn LoweringPrimaryObjectIrCountBodyKind(ir: PrimaryObjectIr,
                                         bodyKind: str): int32 =
    var count: int32
    for i in 0..<ir.functions.len:
        if ir.functions[i].bodyKind == bodyKind:
            count = count + 1
    return count

fn LoweringPrimaryObjectIrReportProjectionDomainForFunctionCount(
        functionCount: int32): LoweringPrimaryObjectIrReportProjectionDomain =
    if functionCount < 0 ||
       functionCount > 238609294:
        panic("lowering primary object report projection: function domain invalid")
    var out: LoweringPrimaryObjectIrReportProjectionDomain
    out.functionCount = functionCount
    if functionCount > 0:
        out.scalarPartCount = functionCount * 2 - 1
        out.callTargetPartCountLimit = functionCount * 9 - 1
    return out

@borrows
fn LoweringPrimaryObjectIrReportAppendCallCount(
        owner: var LoweringPrimaryObjectIrReportProjectionOwner,
        value: str) =
    if owner.callSequenceCountsParts.len >= owner.domain.scalarPartCount:
        panic("lowering primary object report projection: call-count domain exhausted")
    loweringSequenceAllocatorAdd(
        owner.allocatorLedger,
        owner.callSequenceCountsParts,
        value,
        sizeof(str))

@borrows
fn LoweringPrimaryObjectIrReportAppendCallTarget(
        owner: var LoweringPrimaryObjectIrReportProjectionOwner,
        value: str) =
    if owner.callSequenceTargetsParts.len >=
           owner.domain.callTargetPartCountLimit:
        panic("lowering primary object report projection: call-target domain exhausted")
    loweringSequenceAllocatorAdd(
        owner.allocatorLedger,
        owner.callSequenceTargetsParts,
        value,
        sizeof(str))

