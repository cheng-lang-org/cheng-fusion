        compilerSnapshotLoweringAuthorityCid: layout.FixedBytes32
        compilerSnapshotLoweringAuthorityOwnerId: int32
        compilerSnapshotLoweringAuthorityGeneration: int32
        compilerSnapshotLoweringAuthorityReleaseCid: layout.FixedBytes32
        canonicalSnapshotProjectionAuthorityCid: layout.FixedBytes32
        releasedOwnedStorageColumnCount: int32
        releasedBufferCount: int32
        releasedBytes: int64
        storageReleased: bool
        lifecycleInitialBufferCount: int32
        lifecycleInitialBytes: int64
        lifecycleReleasedBufferCount: int32
        lifecycleReleasedBytes: int64
        lifecycleClosed: bool
        resolvedCallTargetProjection: LoweringResolvedCallTargetProjectionReceipt
        deferScopeTransportAllocator: LoweringSequenceAllocatorReceipt
        ownershipTransportAllocator: LoweringSequenceAllocatorReceipt
        typedFunctionReferenceAllocator: LoweringSequenceAllocatorReceipt
        typedFunctionIndexAllocator: LoweringSequenceAllocatorReceipt
        typedFunctionIdentityAllocator: LoweringSequenceAllocatorReceipt
        resolvedCallFactAllocator: LoweringSequenceAllocatorReceipt
        importGraphAllocator: LoweringSequenceAllocatorReceipt
