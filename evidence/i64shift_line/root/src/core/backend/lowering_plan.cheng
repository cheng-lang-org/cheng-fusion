        sizeof(str))

@borrows
fn LoweringPrimaryObjectIrReportAppendStatementSequenceResultType(
        owner: var LoweringPrimaryObjectIrReportProjectionOwner,
        value: str) =
    if owner.statementSequenceResultTypesParts.len >=
           owner.domain.scalarPartCount:
        panic("lowering primary object report projection: result-type domain exhausted")
    loweringSequenceAllocatorAdd(
        owner.allocatorLedger,
        owner.statementSequenceResultTypesParts,
        value,
        sizeof(str))

@borrows
fn LoweringPrimaryObjectIrReportAppendNoAliasAppliedFlag(
        owner: var LoweringPrimaryObjectIrReportProjectionOwner,
        value: str) =
    if owner.noAliasAppliedFlagsParts.len >= owner.domain.scalarPartCount:
        panic("lowering primary object report projection: noalias-flag domain exhausted")
    loweringSequenceAllocatorAdd(
        owner.allocatorLedger,
        owner.noAliasAppliedFlagsParts,
        value,
        sizeof(str))

@borrows
fn LoweringPrimaryObjectIrReportAppendNoAliasLocalCount(
        owner: var LoweringPrimaryObjectIrReportProjectionOwner,
        value: str) =
    if owner.noAliasLocalCountsParts.len >= owner.domain.scalarPartCount:
        panic("lowering primary object report projection: noalias-local domain exhausted")
    loweringSequenceAllocatorAdd(
        owner.allocatorLedger,
        owner.noAliasLocalCountsParts,
        value,
        sizeof(str))

@borrows
fn LoweringPrimaryObjectIrReportAppendNoAliasForwardRewriteCount(
        owner: var LoweringPrimaryObjectIrReportProjectionOwner,
        value: str) =
    if owner.noAliasForwardRewriteCountsParts.len >=
           owner.domain.scalarPartCount:
        panic("lowering primary object report projection: noalias-forward domain exhausted")
    loweringSequenceAllocatorAdd(
        owner.allocatorLedger,
        owner.noAliasForwardRewriteCountsParts,
        value,
        sizeof(str))

@borrows
fn LoweringPrimaryObjectIrReportProjectionPhysicalBufferCount(
        owner: LoweringPrimaryObjectIrReportProjectionOwner): int32 =
    var count: int32
    if owner.callSequenceCountsParts.cap > 0:
        count = count + 1
    if owner.callSequenceTargetsParts.cap > 0:
        count = count + 1
    if owner.structuredCallCountsParts.cap > 0:
        count = count + 1
    if owner.bodyIrCallCountsParts.cap > 0:
        count = count + 1
    if owner.statementSequenceCountsParts.cap > 0:
        count = count + 1
    if owner.statementSequenceKindsParts.cap > 0:
        count = count + 1
    if owner.statementSequenceTargetsParts.cap > 0:
        count = count + 1
    if owner.statementSequenceBindingsParts.cap > 0:
        count = count + 1
    if owner.statementSequenceResultTypesParts.cap > 0:
        count = count + 1
    if owner.noAliasAppliedFlagsParts.cap > 0:
        count = count + 1
    if owner.noAliasLocalCountsParts.cap > 0:
        count = count + 1
    if owner.noAliasForwardRewriteCountsParts.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringPrimaryObjectIrReportProjectionCapacityBytes(
        owner: LoweringPrimaryObjectIrReportProjectionOwner): int64 =
    return int64(owner.callSequenceCountsParts.cap) *
               int64(sizeof(str)) +
           int64(owner.callSequenceTargetsParts.cap) *
               int64(sizeof(str)) +
           int64(owner.structuredCallCountsParts.cap) *
               int64(sizeof(str)) +
           int64(owner.bodyIrCallCountsParts.cap) *
               int64(sizeof(str)) +
           int64(owner.statementSequenceCountsParts.cap) *
               int64(sizeof(str)) +
           int64(owner.statementSequenceKindsParts.cap) *
               int64(sizeof(str)) +
           int64(owner.statementSequenceTargetsParts.cap) *
               int64(sizeof(str)) +
           int64(owner.statementSequenceBindingsParts.cap) *
               int64(sizeof(str)) +
           int64(owner.statementSequenceResultTypesParts.cap) *
               int64(sizeof(str)) +
           int64(owner.noAliasAppliedFlagsParts.cap) *
               int64(sizeof(str)) +
           int64(owner.noAliasLocalCountsParts.cap) *
               int64(sizeof(str)) +
           int64(owner.noAliasForwardRewriteCountsParts.cap) *
               int64(sizeof(str))

@borrows
fn LoweringPrimaryObjectIrReportProjectionValidateComplete(
        owner: LoweringPrimaryObjectIrReportProjectionOwner) =
    let expected = owner.domain.scalarPartCount
    if owner.domain.functionCount < 0 ||
       expected < 0 ||
       owner.domain.callTargetPartCountLimit < expected ||
       owner.callSequenceCountsParts.len != expected ||
       owner.structuredCallCountsParts.len != expected ||
       owner.bodyIrCallCountsParts.len != expected ||
       owner.statementSequenceCountsParts.len != expected ||
       owner.statementSequenceKindsParts.len != expected ||
       owner.statementSequenceTargetsParts.len != expected ||
       owner.statementSequenceBindingsParts.len != expected ||
       owner.statementSequenceResultTypesParts.len != expected ||
       owner.noAliasAppliedFlagsParts.len != expected ||
       owner.noAliasLocalCountsParts.len != expected ||
       owner.noAliasForwardRewriteCountsParts.len != expected ||
       owner.callSequenceTargetsParts.len < expected ||
       owner.callSequenceTargetsParts.len >
           owner.domain.callTargetPartCountLimit:
        panic("lowering primary object report projection: incomplete domain")

@borrows
fn loweringPrimaryObjectIrReportProjectionOwnerToken(
        owner: LoweringPrimaryObjectIrReportProjectionOwner,
        receipt: LoweringSequenceAllocatorReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(192)
    loweringPlanReleaseAppendText(
        buf, "cheng.compiler.lowering.primary_object_ir_report_projection")
    loweringPlanReleaseAppendU32Field(
        buf, owner.domain.functionCount)
    loweringPlanReleaseAppendU32Field(
        buf, owner.domain.scalarPartCount)
    loweringPlanReleaseAppendU32Field(
        buf, owner.domain.callTargetPartCountLimit)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocationEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releaseEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalRetainedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalRetainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalReleasedBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveAllocationCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveCapacityBytes)
    let token = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn LoweringPrimaryObjectIrReportProjectionReleaseWithReceipt(
        owner: var LoweringPrimaryObjectIrReportProjectionOwner,
        receipt: var LoweringSequenceAllocatorReceipt) =
    LoweringPrimaryObjectIrReportProjectionValidateComplete(owner)
    if owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()) ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(
               LoweringPrimaryObjectIrReportProjectionPhysicalBufferCount(
                   owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringPrimaryObjectIrReportProjectionCapacityBytes(owner):
        panic("lowering primary object report projection: owner state drift")
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringPrimaryObjectIrReportProjectionPhysicalBufferCount(owner)
    receipt.terminalRetainedBytes =
        LoweringPrimaryObjectIrReportProjectionCapacityBytes(owner)
    var terminalReleasedBytes: int64
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.callSequenceCountsParts,
            sizeof(str))
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.callSequenceTargetsParts,
            sizeof(str))
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.structuredCallCountsParts,
            sizeof(str))
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.bodyIrCallCountsParts,
            sizeof(str))
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.statementSequenceCountsParts,
            sizeof(str))
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.statementSequenceKindsParts,
            sizeof(str))
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.statementSequenceTargetsParts,
            sizeof(str))
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.statementSequenceBindingsParts,
            sizeof(str))
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.statementSequenceResultTypesParts,
            sizeof(str))
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.noAliasAppliedFlagsParts,
            sizeof(str))
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.noAliasLocalCountsParts,
            sizeof(str))
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.noAliasForwardRewriteCountsParts,
            sizeof(str))
    owner.allocatorLedger.closed = true
    receipt.allocationEventCount =
        owner.allocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        owner.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        owner.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        owner.allocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        owner.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        owner.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringPrimaryObjectIrReportProjectionPhysicalBufferCount(owner) ==
            0 &&
        LoweringPrimaryObjectIrReportProjectionCapacityBytes(owner) ==
            int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering primary object report projection: receipt incomplete")
    owner.allocatorReceipt = receipt
    owner.ownerToken =
        loweringPrimaryObjectIrReportProjectionOwnerToken(owner, receipt)
    owner.allocatorReceiptReady = true
    owner.allocatorLedger = LoweringSequenceAllocatorLedger()

fn LoweringPrimaryObjectIrReportProjectionReceiptConsumeStrict(
        owner: var LoweringPrimaryObjectIrReportProjectionOwner,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    if !owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt, owner.allocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !layout.FixedBytes32Equal(
           owner.ownerToken,
           loweringPrimaryObjectIrReportProjectionOwnerToken(owner, receipt)) ||
       LoweringPrimaryObjectIrReportProjectionPhysicalBufferCount(owner) !=
           0 ||
       LoweringPrimaryObjectIrReportProjectionCapacityBytes(owner) !=
           int64(0):
        return false
    owner.allocatorReceiptConsumed = true
    return true

@borrows
fn LoweringPrimaryObjectIrReportText(ir: PrimaryObjectIr): str =
    # parts-builder 重写: 12 个 module-level var 用 Fmt"{var}..." 累积 N=5611
    # functions 即 O(N^2) 复制 ~1.5GB per var × 12 = 18GB churn。改 12 个 str[]
    # parts + 循环 add + Join 一次。末尾 19 行统一走 LoweringReportPartsOwner
    # 用 outParts builder 避免大 string concat。
    var reportProjection: LoweringPrimaryObjectIrReportProjectionOwner
    reportProjection.domain =
        LoweringPrimaryObjectIrReportProjectionDomainForFunctionCount(
            ir.functions.len)
    for i in 0..<ir.functions.len:
        if i > 0:
            LoweringPrimaryObjectIrReportAppendCallCount(
                reportProjection, ",")
            LoweringPrimaryObjectIrReportAppendCallTarget(
                reportProjection, ",")
            LoweringPrimaryObjectIrReportAppendStructuredCallCount(
                reportProjection, ",")
            LoweringPrimaryObjectIrReportAppendBodyIrCallCount(
                reportProjection, ",")
            LoweringPrimaryObjectIrReportAppendStatementSequenceCount(
                reportProjection, ",")
            LoweringPrimaryObjectIrReportAppendStatementSequenceKind(
                reportProjection, ",")
            LoweringPrimaryObjectIrReportAppendStatementSequenceTarget(
                reportProjection, ",")
            LoweringPrimaryObjectIrReportAppendStatementSequenceBinding(
                reportProjection, ",")
            LoweringPrimaryObjectIrReportAppendStatementSequenceResultType(
                reportProjection, ",")
            LoweringPrimaryObjectIrReportAppendNoAliasAppliedFlag(
                reportProjection, ",")
            LoweringPrimaryObjectIrReportAppendNoAliasLocalCount(
                reportProjection, ",")
            LoweringPrimaryObjectIrReportAppendNoAliasForwardRewriteCount(
                reportProjection, ",")
        if ir.functions[i].bodyIrNoAliasApplied:
            LoweringPrimaryObjectIrReportAppendNoAliasAppliedFlag(
                reportProjection, "1")
        else:
            LoweringPrimaryObjectIrReportAppendNoAliasAppliedFlag(
                reportProjection, "0")
        LoweringPrimaryObjectIrReportAppendNoAliasLocalCount(
            reportProjection,
            IntToStr(ir.functions[i].bodyIrNoAliasLocalCount))
        LoweringPrimaryObjectIrReportAppendNoAliasForwardRewriteCount(
            reportProjection,
            IntToStr(ir.functions[i].bodyIrNoAliasForwardRewriteCount))
        var targetCount: int32 = ir.functions[i].callTargets.len
        let bodyIrCallCount: int32 = ir.functions[i].bodyIR.callSequence.len
        var structuredCallCount = bodyIrCallCount
        if structuredCallCount <= 0:
            structuredCallCount = targetCount
        LoweringPrimaryObjectIrReportAppendStructuredCallCount(
            reportProjection, IntToStr(structuredCallCount))
        LoweringPrimaryObjectIrReportAppendBodyIrCallCount(
            reportProjection, IntToStr(structuredCallCount))
        LoweringPrimaryObjectIrReportAppendCallCount(
            reportProjection, IntToStr(targetCount))
        if targetCount <= 0 && bodyIrCallCount <= 0:
            LoweringPrimaryObjectIrReportAppendCallTarget(
                reportProjection, "-")
        elif targetCount <= 0:
            LoweringPrimaryObjectIrReportAppendCallTarget(
                reportProjection,
                strings.CloneStr(
                    ir.functions[i].bodyIR.callSequence[0].targetSymbol))
            if bodyIrCallCount > 1:
                LoweringPrimaryObjectIrReportAppendCallTarget(
                    reportProjection, "|")
                LoweringPrimaryObjectIrReportAppendCallTarget(
                    reportProjection,
                    strings.CloneStr(
                        ir.functions[i].bodyIR.callSequence[1].targetSymbol))
            if bodyIrCallCount > 2:
                LoweringPrimaryObjectIrReportAppendCallTarget(
                    reportProjection, "|")
                LoweringPrimaryObjectIrReportAppendCallTarget(
                    reportProjection,
                    strings.CloneStr(
                        ir.functions[i].bodyIR.callSequence[2].targetSymbol))
            if bodyIrCallCount > 3:
                LoweringPrimaryObjectIrReportAppendCallTarget(
                    reportProjection, "|")
                LoweringPrimaryObjectIrReportAppendCallTarget(
                    reportProjection,
                    strings.CloneStr(
                        ir.functions[i].bodyIR.callSequence[3].targetSymbol))
            if bodyIrCallCount > 4:
                LoweringPrimaryObjectIrReportAppendCallTarget(
                    reportProjection, "|...")
        else:
            LoweringPrimaryObjectIrReportAppendCallTarget(
                reportProjection,
                strings.CloneStr(ir.functions[i].callTargets[0]))
            if targetCount > 1:
                LoweringPrimaryObjectIrReportAppendCallTarget(
                    reportProjection, "|")
                LoweringPrimaryObjectIrReportAppendCallTarget(
                    reportProjection,
                    strings.CloneStr(ir.functions[i].callTargets[1]))
            if targetCount > 2:
                LoweringPrimaryObjectIrReportAppendCallTarget(
                    reportProjection, "|")
                LoweringPrimaryObjectIrReportAppendCallTarget(
                    reportProjection,
                    strings.CloneStr(ir.functions[i].callTargets[2]))
            if targetCount > 3:
                LoweringPrimaryObjectIrReportAppendCallTarget(
                    reportProjection, "|")
                LoweringPrimaryObjectIrReportAppendCallTarget(
                    reportProjection,
                    strings.CloneStr(ir.functions[i].callTargets[3]))
            if targetCount > 4:
                LoweringPrimaryObjectIrReportAppendCallTarget(
                    reportProjection, "|...")
        let stmtCount: int32 = ir.functions[i].statements.len
        LoweringPrimaryObjectIrReportAppendStatementSequenceCount(
            reportProjection, IntToStr(stmtCount))
        if stmtCount <= 0:
            LoweringPrimaryObjectIrReportAppendStatementSequenceKind(
                reportProjection, "-")
            LoweringPrimaryObjectIrReportAppendStatementSequenceTarget(
                reportProjection, "-")
            LoweringPrimaryObjectIrReportAppendStatementSequenceBinding(
                reportProjection, "-")
            LoweringPrimaryObjectIrReportAppendStatementSequenceResultType(
                reportProjection, "-")
        else:
            var kindText = texpr.TypedExprIrStatementKindText(ir.functions[i].statements[0].kind)
            var targetText =
                strings.CloneStr(ir.functions[i].statements[0].callTarget)
            var bindingText = ""
            var resultTypeText = ""
            var stmtLimit = stmtCount
            if stmtLimit > 5:
                stmtLimit = 5
            for stmtIndex in 0..<stmtLimit:
                if stmtIndex > 0:
                    bindingText = Fmt"{bindingText}|"
                    resultTypeText = Fmt"{resultTypeText}|"
                var bindingName = ir.functions[i].statements[stmtIndex].bindingName
                if len(bindingName) <= 0:
                    bindingName = "-"
                var resultType = ir.functions[i].statements[stmtIndex].resultType
                if len(resultType) <= 0:
                    resultType = "-"
                bindingText = Fmt"{bindingText}{bindingName}"
                resultTypeText = Fmt"{resultTypeText}{resultType}"
            if stmtCount > stmtLimit:
                bindingText = Fmt"{bindingText}|..."
                resultTypeText = Fmt"{resultTypeText}|..."
            if len(targetText) <= 0:
                targetText = "-"
            if stmtCount > 1:
                kindText = Fmt"{kindText}|{texpr.TypedExprIrStatementKindText(ir.functions[i].statements[1].kind)}"
                let nextTarget = ir.functions[i].statements[1].callTarget
                if len(nextTarget) > 0:
                    targetText = Fmt"{targetText}|{nextTarget}"
                else:
                    targetText = Fmt"{targetText}|-"
            if stmtCount > 2:
                kindText = Fmt"{kindText}|{texpr.TypedExprIrStatementKindText(ir.functions[i].statements[2].kind)}"
                let nextTarget = ir.functions[i].statements[2].callTarget
                if len(nextTarget) > 0:
                    targetText = Fmt"{targetText}|{nextTarget}"
                else:
                    targetText = Fmt"{targetText}|-"
            if stmtCount > 3:
                kindText = Fmt"{kindText}|{texpr.TypedExprIrStatementKindText(ir.functions[i].statements[3].kind)}"
                let nextTarget = ir.functions[i].statements[3].callTarget
                if len(nextTarget) > 0:
                    targetText = Fmt"{targetText}|{nextTarget}"
                else:
                    targetText = Fmt"{targetText}|-"
            if stmtCount > 4:
                kindText = Fmt"{kindText}|{texpr.TypedExprIrStatementKindText(ir.functions[i].statements[4].kind)}"
                let fifthTarget = ir.functions[i].statements[4].callTarget
                if len(fifthTarget) > 0:
                    targetText = Fmt"{targetText}|{fifthTarget}"
                else:
                    targetText = Fmt"{targetText}|-"
            if stmtCount > 5:
                kindText = Fmt"{kindText}|..."
                targetText = Fmt"{targetText}|..."
            LoweringPrimaryObjectIrReportAppendStatementSequenceKind(
                reportProjection, kindText)
            LoweringPrimaryObjectIrReportAppendStatementSequenceTarget(
                reportProjection, targetText)
            LoweringPrimaryObjectIrReportAppendStatementSequenceBinding(
                reportProjection, bindingText)
            LoweringPrimaryObjectIrReportAppendStatementSequenceResultType(
                reportProjection, resultTypeText)
    LoweringPrimaryObjectIrReportProjectionValidateComplete(
        reportProjection)
    let callSequenceCounts =
        strutil.Join(reportProjection.callSequenceCountsParts, "")
    let callSequenceTargets =
        strutil.Join(reportProjection.callSequenceTargetsParts, "")
    let structuredCallCounts =
        strutil.Join(reportProjection.structuredCallCountsParts, "")
    let bodyIrCallCounts =
        strutil.Join(reportProjection.bodyIrCallCountsParts, "")
    let statementSequenceCounts =
        strutil.Join(reportProjection.statementSequenceCountsParts, "")
    let statementSequenceKinds =
        strutil.Join(reportProjection.statementSequenceKindsParts, "")
    let statementSequenceTargets =
        strutil.Join(reportProjection.statementSequenceTargetsParts, "")
    let statementSequenceBindings =
        strutil.Join(reportProjection.statementSequenceBindingsParts, "")
    let statementSequenceResultTypes =
        strutil.Join(reportProjection.statementSequenceResultTypesParts, "")
    let noAliasAppliedFlags =
        strutil.Join(reportProjection.noAliasAppliedFlagsParts, "")
    let noAliasLocalCounts =
        strutil.Join(reportProjection.noAliasLocalCountsParts, "")
    let noAliasForwardRewriteCounts =
        strutil.Join(
            reportProjection.noAliasForwardRewriteCountsParts, "")
    var reportProjectionReceipt: LoweringSequenceAllocatorReceipt
    LoweringPrimaryObjectIrReportProjectionReleaseWithReceipt(
        reportProjection, reportProjectionReceipt)
    if !LoweringPrimaryObjectIrReportProjectionReceiptConsumeStrict(
           reportProjection, reportProjectionReceipt):
        panic("lowering primary object report projection: strict consume failed")
    var outParts: LoweringReportPartsOwner
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_function_count", IntToStr(ir.functions.len))
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_body_kinds", LoweringPrimaryObjectIrBodyKindListText(ir))
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_call_sequence_counts", callSequenceCounts)
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_call_sequence_targets", callSequenceTargets)
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_structured_call_counts", structuredCallCounts)
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_body_ir_call_counts", bodyIrCallCounts)
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_statement_sequence_counts", statementSequenceCounts)
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_statement_sequence_kinds", statementSequenceKinds)
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_statement_sequence_targets", statementSequenceTargets)
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_statement_sequence_bindings", statementSequenceBindings)
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_statement_sequence_result_types", statementSequenceResultTypes)
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_noalias_applied_flags", noAliasAppliedFlags)
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_noalias_local_counts", noAliasLocalCounts)
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_noalias_forward_rewrite_counts", noAliasForwardRewriteCounts)
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_return_f64_mul_count", IntToStr(LoweringPrimaryObjectIrCountBodyKind(ir, texpr.BodyKindReturnF64MulArgs)))
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_str_len_fast_count", IntToStr(LoweringPrimaryObjectIrCountBodyKind(ir, texpr.BodyKindStrLenFastI32)))
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_return_str_empty_count", IntToStr(LoweringPrimaryObjectIrCountBodyKind(ir, texpr.BodyKindReturnStrEmpty)))
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_cstring_to_str_copy_count", IntToStr(LoweringPrimaryObjectIrCountBodyKind(ir, texpr.BodyKindCstringToStrCopy)))
    LoweringReportPartsAppendLine(outParts, "primary_object_ir_main_f64_mul_check_exit_count", IntToStr(LoweringPrimaryObjectIrCountBodyKind(ir, texpr.BodyKindMainF64MulCheckExit)))
    let report = strutil.Join(outParts.parts, "")
    var reportPartsReceipt: LoweringSequenceAllocatorReceipt
    LoweringReportPartsReleaseWithReceipt(
        outParts, reportPartsReceipt)
    if !LoweringReportPartsReceiptConsumeStrict(
           outParts, reportPartsReceipt):
        panic("lowering primary object report parts: strict consume failed")
    return report

@borrows
fn LoweringMissingReasons(functionNames: str[], functionEntryFlags: int32[], entrySymbol: str): str[] =
    var missing: str[]
    if functionNames.len <= 0:
        add(missing, "lowering_functions_missing")
        return missing
    if len(entrySymbol) > 0:
        var entryLowered = false
        for i in 0..<functionEntryFlags.len:
            if functionEntryFlags[i] != 0:
                entryLowered = true
        if !entryLowered:
            add(missing, "lowering_entry_function_missing")
    return missing

fn LoweringReleaseCompilerCsgAfterBind(compilerCsg: var ccsg.CompilerCsg,
                                        plan: var LoweringPlanStub) =
    if plan.compilerCsgBackendPayloadReleased:
        panic("lowering plan: compiler csg backend payload released more than once")
    let beforeBufferCount =
        ccsg.CompilerCsgLifecycleTrackedPhysicalBufferCount(compilerCsg)
    let beforeBytes =
        ccsg.CompilerCsgLifecycleRetainedBytes(compilerCsg)
    ccsg.CompilerCsgReleaseBackendInputPayload(compilerCsg)
    let afterBufferCount =
        ccsg.CompilerCsgLifecycleTrackedPhysicalBufferCount(compilerCsg)
    let afterBytes =
        ccsg.CompilerCsgLifecycleRetainedBytes(compilerCsg)
    if afterBufferCount > beforeBufferCount ||
       afterBytes > beforeBytes:
        panic("lowering plan: compiler csg local release grew payload")
    plan.compilerCsgLifecycleReleasedBufferCount =
        plan.compilerCsgLifecycleReleasedBufferCount +
            (beforeBufferCount - afterBufferCount)
    plan.compilerCsgLifecycleReleasedBytes =
        plan.compilerCsgLifecycleReleasedBytes +
            (beforeBytes - afterBytes)
    let transferredBufferCount =
        plan.compilerCsgLifecycleInitialBufferCount -
        plan.compilerCsgLifecycleReleasedBufferCount -
        afterBufferCount
    let transferredBytes =
        plan.compilerCsgLifecycleInitialBytes -
        plan.compilerCsgLifecycleReleasedBytes -
        afterBytes
    if transferredBufferCount < 0 || transferredBytes < int64(0):
        panic("lowering plan: compiler csg transfer receipt underflow")
    plan.compilerCsgLifecycleTransferredBufferCount =
        transferredBufferCount
    plan.compilerCsgLifecycleTransferredBytes = transferredBytes
    plan.compilerCsgBackendPayloadReleased = true

@borrows
fn LoweringTypedExprFactTableStorageReleased(table: texpr.TypedExprFactTable): bool =
    return table.count == 0 &&
           table.arena.capacityBytes == 0 &&
           table.internPool == nil &&
           table.exprIdIds.capacity == 0 &&
           table.sourcePathIds.capacity == 0 &&
           table.callQualifierIds.capacity == 0 &&
           table.callCalleeIds.capacity == 0 &&
           table.callTargetIds.capacity == 0 &&
           table.callTargetSourcePathIds.capacity == 0 &&
           table.callArgsTextIds.capacity == 0 &&
           table.typeTextIds.capacity == 0 &&
           table.lineNumbers.capacity == 0 &&
           table.columnNumbers.capacity == 0 &&
           table.endLineNumbers.capacity == 0 &&
           table.endColumnNumbers.capacity == 0 &&
           table.lexicalScopeIds.capacity == 0 &&
           table.suiteScopeIds.capacity == 0 &&
           table.statementOrdinals.capacity == 0 &&
           table.lexicalOrdinals.capacity == 0 &&
           table.deferOwnerStatementOrdinals.capacity == 0 &&
           table.callArgCounts.capacity == 0 &&
           table.kinds.capacity == 0 &&
           table.surfaceCallKinds.capacity == 0 &&
           table.callReasons.capacity == 0 &&
           table.abiClasses.capacity == 0 &&
           table.valueKinds.capacity == 0 &&
           table.placeKinds.capacity == 0 &&
           table.sinkPlaceKinds.capacity == 0 &&
           table.loweringModes.capacity == 0 &&
           table.callKinds.capacity == 0 &&
           table.typeCallKinds.capacity == 0 &&
           table.returnKinds.capacity == 0 &&
           table.callResolveds.capacity == 0 &&
           table.callTargetImportcs.capacity == 0 &&
           table.callPrefixStyles.capacity == 0

fn LoweringCompilerCsgCompactExprPayloadReleased(compilerCsg: var ccsg.CompilerCsg): bool =
    return compilerCsg.exprLayer.sourceCount == 0 &&
           compilerCsg.exprLayer.exprs.len == 0 &&
           compilerCsg.exprLayer.exprNext.len == 0 &&
           compilerCsg.exprLayer.questionResidualCount == 0 &&
           compilerCsg.exprLayer.exprLookup.slots.len == 0 &&
           compilerCsg.exprLayer.exprLookup.buckets.len == 0 &&
           compilerCsg.exprLayerLiveBytes == Int64(0) &&
           LoweringTypedExprFactTableStorageReleased(compilerCsg.typedExprFacts) &&
           compilerCsg.typedFactsLiveBytes == Int64(0) &&
           compilerCsg.semanticGraph.typedFactTable.sourceIndexes.len == 0

fn LoweringReleaseCompilerCsgCompactExprPayload(
        compilerCsg: var ccsg.CompilerCsg,
        plan: var LoweringPlanStub) =
    # The compact semantic-graph summary/slices are the only lowering inputs. A reset forbidden
    # FactTable may still own a large Arena, so count==0 is not a release proof.
    let beforeBufferCount =
        ccsg.CompilerCsgLifecycleTrackedPhysicalBufferCount(compilerCsg)
    let beforeBytes =
        ccsg.CompilerCsgLifecycleRetainedBytes(compilerCsg)
    var exprReleasedBufferCount: int32
    var exprReleasedBytes: int64
    ccsg.CompilerCsgNormalizedExprLayerTerminalReleaseWithReceipt(
        compilerCsg.exprLayer,
        exprReleasedBufferCount,
        exprReleasedBytes)
    compilerCsg.exprLayerLiveBytes = Int64(0)
    texpr.TypedExprFactTableRelease(compilerCsg.typedExprFacts)
    compilerCsg.typedFactsLiveBytes = Int64(0)
    var typedFactReleasedBufferCount: int32
    var typedFactReleasedBytes: int64
    ccsg.CompilerCsgSemanticTypedFactTableTerminalReleaseWithReceipt(
        compilerCsg.semanticGraph.typedFactTable,
        typedFactReleasedBufferCount,
        typedFactReleasedBytes)
    let afterBufferCount =
        ccsg.CompilerCsgLifecycleTrackedPhysicalBufferCount(compilerCsg)
    let afterBytes =
        ccsg.CompilerCsgLifecycleRetainedBytes(compilerCsg)
    if afterBufferCount > beforeBufferCount ||
       afterBytes > beforeBytes:
        panic("lowering plan: compact csg local release grew payload")
    plan.compilerCsgLifecycleReleasedBufferCount =
        plan.compilerCsgLifecycleReleasedBufferCount +
            (beforeBufferCount - afterBufferCount)
    plan.compilerCsgLifecycleReleasedBytes =
        plan.compilerCsgLifecycleReleasedBytes +
            (beforeBytes - afterBytes)
    if exprReleasedBufferCount + typedFactReleasedBufferCount >
           beforeBufferCount - afterBufferCount ||
       exprReleasedBytes + typedFactReleasedBytes >
           beforeBytes - afterBytes:
        panic("lowering plan: nested compiler csg release receipt overflow")

fn LoweringAbortCompilerCsgBind(compilerCsg: var ccsg.CompilerCsg,
                                plan: var LoweringPlanStub): bool =
    # The bind below moves payloads incrementally. A failed validation must
    # release both the already-moved plan payload and the remainder still held
    # by CompilerCsg before returning the original diagnostic.
    let releaseCompilerCsg = !plan.compilerCsgBackendPayloadReleased
    if releaseCompilerCsg:
        LoweringReleaseCompilerCsgAfterBind(compilerCsg, plan)
    LoweringPlanReleaseAllPayload(plan)
    return false

fn LoweringSevenStageTypedExprArtifact(
        compilerCsg: var ccsg.CompilerCsg): str =
    # Producer-owned exact serialization.  Tooling may hash/copy these bytes
    # but may not reconstruct them from counts or previously computed hashes.
    var rows: str[]
    let table = compilerCsg.semanticGraph.typedFactTable
    add(rows, "schema=cheng.compiler.typed_expr_fact_table\n")
    add(rows,
        Fmt"typed_fact_count={strings.IntToStr(compilerCsg.typedExprFactCountSnapshot)}\n")
    add(rows,
        Fmt"typed_fact_row_count={strings.IntToStr(table.sourceIndexes.len)}\n")
    for i in 0..<table.sourceIndexes.len:
        add(rows,
            Fmt"row={strings.IntToStr(i)}\t{strings.IntToStr(table.sourceIndexes[i])}\t{strings.IntToStr(table.functionIndexes[i])}\t{strings.Int64ToStr(table.semanticIdentityCertificates[i])}\t{strings.IntToStr(table.valueKinds[i])}\t{strings.IntToStr(table.placeKinds[i])}\t{if table.hasSinks[i]: \"1\" else: \"0\"}\t{strings.IntToStr(table.sinkPlaceKinds[i])}\t{strings.IntToStr(table.loweringModes[i])}\t{strings.IntToStr(table.callKinds[i])}\t{strings.IntToStr(table.typeCallKinds[i])}\t{strings.IntToStr(table.returnKinds[i])}\t{if table.returnRoots[i]: \"1\" else: \"0\"}\n")
    return strutil.Join(rows, "")

fn LoweringSevenStageBodyIrArtifactPartsBegin(
        owner: var LoweringSevenStageBodyIrArtifactPartsOwner,
        domain: LoweringSevenStageBodyIrArtifactPartsDomain) =
    if domain.partCount < 2 ||
       owner.parts.len != 0 ||
       owner.parts.cap != 0 ||
       owner.allocatorLedger.allocationEventCount != int64(0) ||
       owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()):
        panic("lowering seven-stage body ir artifact parts: begin state invalid")
    owner.domain = domain

@borrows
fn LoweringSevenStageBodyIrArtifactPartsAppend(
        owner: var LoweringSevenStageBodyIrArtifactPartsOwner,
        value: str) =
    if owner.parts.len >= owner.domain.partCount:
        panic("lowering seven-stage body ir artifact parts: domain exhausted")
    var parts = owner.parts
    owner.parts = []
    loweringSequenceAllocatorAdd(
        owner.allocatorLedger,
        parts,
        value,
        sizeof(str))
    owner.parts = parts

@borrows
fn LoweringSevenStageBodyIrArtifactPartsPhysicalBufferCount(
        owner: LoweringSevenStageBodyIrArtifactPartsOwner): int32 =
    return owner.parts.cap > 0 ? 1 : 0

@borrows
fn LoweringSevenStageBodyIrArtifactPartsCapacityBytes(
        owner: LoweringSevenStageBodyIrArtifactPartsOwner): int64 =
    return int64(owner.parts.cap) * int64(sizeof(str))

@borrows
fn loweringSevenStageBodyIrArtifactPartsOwnerToken(
        owner: LoweringSevenStageBodyIrArtifactPartsOwner,
        receipt: LoweringSequenceAllocatorReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(160)
    loweringPlanReleaseAppendText(
        buf, "cheng.compiler.lowering.seven_stage_body_ir_artifact_parts")
    loweringPlanReleaseAppendU32Field(
        buf, owner.domain.partCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocationEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releaseEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalRetainedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalRetainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalReleasedBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveAllocationCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveCapacityBytes)
    let token = hash256.Sha256Fixed(
        layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn LoweringSevenStageBodyIrArtifactPartsReleaseWithReceipt(
        owner: var LoweringSevenStageBodyIrArtifactPartsOwner,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if owner.parts.len != owner.domain.partCount ||
       owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()) ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(
               LoweringSevenStageBodyIrArtifactPartsPhysicalBufferCount(
                   owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringSevenStageBodyIrArtifactPartsCapacityBytes(owner):
        panic("lowering seven-stage body ir artifact parts: owner state drift")
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringSevenStageBodyIrArtifactPartsPhysicalBufferCount(owner)
    receipt.terminalRetainedBytes =
        LoweringSevenStageBodyIrArtifactPartsCapacityBytes(owner)
    let terminalReleasedBytes =
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.parts,
            sizeof(str))
    owner.allocatorLedger.closed = true
    receipt.allocationEventCount =
        owner.allocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        owner.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        owner.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        owner.allocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        owner.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        owner.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringSevenStageBodyIrArtifactPartsPhysicalBufferCount(owner) == 0 &&
        LoweringSevenStageBodyIrArtifactPartsCapacityBytes(owner) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering seven-stage body ir artifact parts: receipt incomplete")
    owner.allocatorReceipt = receipt
    owner.ownerToken =
        loweringSevenStageBodyIrArtifactPartsOwnerToken(owner, receipt)
    owner.allocatorReceiptReady = true
    owner.allocatorLedger = LoweringSequenceAllocatorLedger()

fn LoweringSevenStageBodyIrArtifactPartsReceiptConsumeStrict(
        owner: var LoweringSevenStageBodyIrArtifactPartsOwner,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    if !owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt, owner.allocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !layout.FixedBytes32Equal(
           owner.ownerToken,
           loweringSevenStageBodyIrArtifactPartsOwnerToken(owner, receipt)) ||
       LoweringSevenStageBodyIrArtifactPartsPhysicalBufferCount(owner) != 0 ||
       LoweringSevenStageBodyIrArtifactPartsCapacityBytes(owner) != int64(0):
        return false
    owner.allocatorReceiptConsumed = true
    return true

fn LoweringSevenStageBodyIrArtifactPartsClose(
        owner: var LoweringSevenStageBodyIrArtifactPartsOwner) =
    var receipt: LoweringSequenceAllocatorReceipt
    LoweringSevenStageBodyIrArtifactPartsReleaseWithReceipt(
        owner, receipt)
    if !LoweringSevenStageBodyIrArtifactPartsReceiptConsumeStrict(
           owner, receipt):
        panic("lowering seven-stage body ir artifact parts: strict consume failed")

@borrows
fn LoweringSevenStageBodyIrArtifactAppendFunction(
        plan: LoweringPlanStub,
        partsOwner: var LoweringSevenStageBodyIrArtifactPartsOwner,
        functionIndex: int32) =
    if functionIndex >= plan.primaryObjectIr.functions.len:
        return
    var encoded = b2fc.Backend2BodyIrEncode(
        plan.primaryObjectIr.functions[functionIndex].bodyIR)
    let functionName = strings.CloneStr(
        plan.primaryObjectIr.functions[functionIndex].functionName)
    let encodedHex = rawbytes.BytesToHex(encoded)
    LoweringSevenStageBodyIrArtifactPartsAppend(
        partsOwner,
        Fmt"function={strings.IntToStr(functionIndex)}\tname={functionName}\tbyte_length={strings.IntToStr(rawbytes.BytesLen(encoded))}\tbody_ir_hex={encodedHex}\n")
    rawbytes.BytesFree(encoded)
    LoweringSevenStageBodyIrArtifactAppendFunction(
        plan, partsOwner, functionIndex + 1)

@borrows
fn LoweringSevenStageBodyIrArtifact(
        plan: LoweringPlanStub): str =
    if plan.primaryObjectIr.functions.len > 2147483645:
        panic("lowering seven-stage body ir artifact: function domain overflow")
    var partsOwner: LoweringSevenStageBodyIrArtifactPartsOwner
    LoweringSevenStageBodyIrArtifactPartsBegin(
        partsOwner,
        LoweringSevenStageBodyIrArtifactPartsDomain(
            partCount: plan.primaryObjectIr.functions.len + 2))
    LoweringSevenStageBodyIrArtifactPartsAppend(
        partsOwner, "schema=cheng.compiler.lowering_body_ir\n")
    LoweringSevenStageBodyIrArtifactPartsAppend(
        partsOwner,
        Fmt"function_count={strings.IntToStr(plan.primaryObjectIr.functions.len)}\n")
    LoweringSevenStageBodyIrArtifactAppendFunction(plan, partsOwner, 0)
    let artifact = strutil.Join(partsOwner.parts, "")
    LoweringSevenStageBodyIrArtifactPartsClose(partsOwner)
    return artifact

@borrows
fn loweringTypeArenaForestTypeSyntaxRow(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        producerSourceIndex: int32,
        sourceLocalTypeSyntaxRow: int32): int32 =
    if producerSourceIndex < 0 ||
       producerSourceIndex >= receipt.sourceSidecars.len ||
       sourceLocalTypeSyntaxRow < 0 ||
       sourceLocalTypeSyntaxRow >=
           receipt.sourceSidecars[producerSourceIndex].typeSyntaxKinds.len:
        return -1
    var forestRow = sourceLocalTypeSyntaxRow
    for sourceIndex in 0..<producerSourceIndex:
        forestRow = forestRow +
            receipt.sourceSidecars[sourceIndex].typeSyntaxKinds.len
    return forestRow

fn loweringTypeArenaProofForParserTypeSyntax(
        compilerCsg: var ccsg.CompilerCsg,
        producerSourceIndex: int32,
        sourceLocalTypeSyntaxRow: int32,
        typeIdOut: var int32,
        managedStorageKindOut: var int32): bool =
    typeIdOut = -1
    managedStorageKindOut = coreir.BodyManagedStorageUnknownTag
    if !typearena.TypedExprTypeArenaComplete(compilerCsg.typeArena):
        return false
    let forestRow = loweringTypeArenaForestTypeSyntaxRow(
        compilerCsg.parserNormalizedExprReceipt,
        producerSourceIndex,
        sourceLocalTypeSyntaxRow)
    if forestRow < 0 ||
       forestRow >= compilerCsg.typeArena.typeSyntaxCount ||
       arenamod.ArenaArrayInt32Get(
           compilerCsg.typeArena.arena,
           compilerCsg.typeArena.typeSyntaxProducerSourceIndexes,
           forestRow) != producerSourceIndex:
        return false
    let typeId = typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
        compilerCsg.typeArena, forestRow)
    if typeId < 0:
        return false
    typeIdOut = typeId
    managedStorageKindOut = coreir.BodyManagedStorageUnmanagedTag
    if typearena.TypedExprTypeArenaManagedAt(
           compilerCsg.typeArena, typeId):
        managedStorageKindOut = coreir.BodyManagedStorageManagedTag
    return true

@borrows
fn loweringTypeArenaFunctionReturnTypeSyntaxRow(
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        declarationRow: int32): int32 =
    var found: int32 = -1
    for typeSyntaxRow in 0..<sidecar.typeSyntaxKinds.len:
        if sidecar.typeSyntaxDeclarationOwnerIds[typeSyntaxRow] ==
               declarationRow &&
           sidecar.typeSyntaxRootKinds[typeSyntaxRow] ==
               Int32(parser.ParserTypeSyntaxRootFunctionReturn):
            if found >= 0:
                return -1
            found = typeSyntaxRow
    return found

fn loweringTypeArenaGraphNodeRow(
        compilerCsg: var ccsg.CompilerCsg,
        graphNodeId: int32): int32 =
    var found: int32 = -1
    for nodeRow in 0..<compilerCsg.nodes.len:
        if compilerCsg.nodes[nodeRow].nodeId == graphNodeId:
            if found >= 0:
                return -1
            found = nodeRow
    return found

fn loweringTypeArenaBindFunctionReturnProofs(
        compilerCsg: var ccsg.CompilerCsg,
        plan: var LoweringPlanStub): bool =
    let functionCount = plan.typedIr.functions2_functionNameIds.len
    if compilerCsg.semanticGraph.typedIrTable.functionGraphNodeIds.len !=
           functionCount:
        return false
    for functionIndex in 0..<functionCount:
        LoweringTypeArenaOwnerProofAppendFunctionRow(
            plan,
            -1,
            coreir.BodyManagedStorageUnknownTag)
        let graphNodeRow = loweringTypeArenaGraphNodeRow(
            compilerCsg,
            compilerCsg.semanticGraph.typedIrTable.functionGraphNodeIds[
                functionIndex])
        if graphNodeRow < 0:
            continue
        let graphNode = compilerCsg.nodes[graphNodeRow]
        let producerSourceIndex = graphNode.producerSourceIndex
        if producerSourceIndex < 0 ||
           producerSourceIndex >=
               compilerCsg.parserNormalizedExprReceipt.sourceSidecars.len:
            continue
        let sidecar =
            compilerCsg.parserNormalizedExprReceipt.sourceSidecars[
                producerSourceIndex]
        var declarationRow: int32 = -1
        for row in 0..<sidecar.declarationSourceLocalRows.len:
            if sidecar.declarationSourceLocalRows[row] ==
                   graphNode.producerDeclarationIndex:
                if declarationRow >= 0:
                    declarationRow = -1
                    break
                declarationRow = row
        if declarationRow < 0 ||
           sidecar.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationFunction):
            continue
        let typeSyntaxRow =
            loweringTypeArenaFunctionReturnTypeSyntaxRow(
                sidecar, declarationRow)
        var typeId: int32
        var storageKind: int32
        if typeSyntaxRow >= 0 &&
           loweringTypeArenaProofForParserTypeSyntax(
               compilerCsg,
               producerSourceIndex,
               typeSyntaxRow,
               typeId,
               storageKind):
            plan.typedFunctionReturnTypeArenaTypeIds[functionIndex] = typeId
            plan.typedFunctionReturnManagedStorageKinds[functionIndex] =
                storageKind
    return true

fn loweringTypeArenaBindGlobalProofs(
        compilerCsg: var ccsg.CompilerCsg,
        plan: var LoweringPlanStub): bool =
    let globalCount = plan.typedIr.globalNames.len
    if !texpr.TypedExprIrGlobalParserIdentityComplete(
           plan.typedIr):
        return false
    for _ in 0..<globalCount:
        LoweringTypeArenaOwnerProofAppendGlobalRow(
            plan,
            -1,
            coreir.BodyManagedStorageUnknownTag)
    for globalRow in 0..<globalCount:
        let producerSourceIndex =
            plan.typedIr.globalProducerSourceIndexes[globalRow]
        let declarationRow =
            plan.typedIr.globalDeclarationSourceLocalRows[globalRow]
        if producerSourceIndex < 0 ||
           producerSourceIndex >=
               compilerCsg.parserNormalizedExprReceipt.sourceSidecars.len:
            return false
        let sidecar =
            compilerCsg.parserNormalizedExprReceipt.sourceSidecars[
                producerSourceIndex]
        if sidecar.sourceIndex != producerSourceIndex ||
           declarationRow < 0 ||
           declarationRow >=
               sidecar.declarationSourceLocalRows.len ||
           declarationRow >= sidecar.declarationKinds.len ||
           declarationRow >=
               sidecar.declarationFunctionRows.len ||
           declarationRow >=
               sidecar.declarationLexicalScopeIds.len ||
           declarationRow >=
               sidecar.declarationTypeSyntaxRootIds.len ||
           sidecar.declarationSourceLocalRows[
               declarationRow] != declarationRow:
            return false
        let scopeRow =
            sidecar.declarationLexicalScopeIds[declarationRow]
        if sidecar.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationLocal) ||
           sidecar.declarationFunctionRows[declarationRow] != -1 ||
           scopeRow < 0 ||
           scopeRow >=
               sidecar.declarationLexicalScopeKinds.len ||
           sidecar.declarationLexicalScopeKinds[scopeRow] !=
               Int32(parser.ParserDeclarationLexicalScopeSource):
            return false
        let typeSyntaxRow =
            sidecar.declarationTypeSyntaxRootIds[declarationRow]
        var typeId: int32
        var storageKind: int32
        if typeSyntaxRow >= 0 &&
           loweringTypeArenaProofForParserTypeSyntax(
               compilerCsg,
               producerSourceIndex,
               typeSyntaxRow,
               typeId,
               storageKind):
            plan.globalTypeArenaTypeIds[globalRow] = typeId
            plan.globalManagedStorageKinds[globalRow] = storageKind
    return plan.globalTypeArenaTypeIds.len == globalCount &&
           plan.globalManagedStorageKinds.len == globalCount

fn loweringSequenceAllocatorSetLen(
        owner: var LoweringFunctionInterfaceProjectionScratchOwner,
        domain: LoweringFunctionInterfaceProjectionScratchLength) =
    if owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed:
        panic("lowering function interface projection scratch: invalid setLen state")
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.claimed,
        domain.length,
        sizeof(bool))

@borrows
fn LoweringFunctionInterfaceProjectionScratchPhysicalBufferCount(
        owner: LoweringFunctionInterfaceProjectionScratchOwner):
        int32 =
    if owner.claimed.cap > 0:
        return 1
    return 0

@borrows
fn LoweringFunctionInterfaceProjectionScratchCapacityBytes(
        owner: LoweringFunctionInterfaceProjectionScratchOwner):
        int64 =
    return int64(owner.claimed.cap) *
           int64(sizeof(bool))

@borrows
fn loweringFunctionInterfaceProjectionScratchOwnerToken(
        receipt: LoweringSequenceAllocatorReceipt):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(128)
    loweringPlanReleaseAppendText(
        buf,
        "cheng.compiler.lowering.function_interface_projection_scratch")
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocationEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releaseEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalRetainedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalRetainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalReleasedBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveAllocationCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveCapacityBytes)
    let token = hash256.Sha256Fixed(
        layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn LoweringFunctionInterfaceProjectionScratchReleaseWithReceipt(
        owner: var LoweringFunctionInterfaceProjectionScratchOwner,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()) ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(
               LoweringFunctionInterfaceProjectionScratchPhysicalBufferCount(
                   owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringFunctionInterfaceProjectionScratchCapacityBytes(owner):
        panic("lowering function interface projection scratch: owner state drift")
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringFunctionInterfaceProjectionScratchPhysicalBufferCount(owner)
    receipt.terminalRetainedBytes =
        LoweringFunctionInterfaceProjectionScratchCapacityBytes(owner)
    let releasedBytes =
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.claimed,
            sizeof(bool))
    owner.allocatorLedger.closed = true
    receipt.allocationEventCount =
        owner.allocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        owner.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        owner.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        owner.allocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = releasedBytes
    receipt.liveAllocationCount =
        owner.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        owner.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringFunctionInterfaceProjectionScratchPhysicalBufferCount(
            owner) == 0 &&
        LoweringFunctionInterfaceProjectionScratchCapacityBytes(owner) ==
            int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering function interface projection scratch: receipt incomplete")
    owner.allocatorReceipt = receipt
    owner.ownerToken =
        loweringFunctionInterfaceProjectionScratchOwnerToken(receipt)
    owner.allocatorReceiptReady = true
    owner.allocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringFunctionInterfaceProjectionScratchReceiptConsumeStrict(
        owner: var LoweringFunctionInterfaceProjectionScratchOwner,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    if !owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt, owner.allocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !layout.FixedBytes32Equal(
           owner.ownerToken,
           loweringFunctionInterfaceProjectionScratchOwnerToken(receipt)) ||
       LoweringFunctionInterfaceProjectionScratchPhysicalBufferCount(
           owner) != 0 ||
       LoweringFunctionInterfaceProjectionScratchCapacityBytes(owner) !=
           int64(0):
        return false
    owner.allocatorReceiptConsumed = true
    return true

fn LoweringFunctionInterfaceProjectionScratchClose(
        owner: var LoweringFunctionInterfaceProjectionScratchOwner) =
    var receipt: LoweringSequenceAllocatorReceipt
    LoweringFunctionInterfaceProjectionScratchReleaseWithReceipt(
        owner, receipt)
    if !LoweringFunctionInterfaceProjectionScratchReceiptConsumeStrict(
           owner, receipt):
        panic("lowering function interface projection scratch: strict consume failed")

fn loweringPlanFunctionInterfaceProjectionStrictValidateInto(
        snapshot: var snapshot_schema.CsgCompilerSnapshotTables,
        typedFunctionCount: int32,
        functionIds: var int32[],
        fragmentCids: var layout.FixedBytes32[],
        interfaceCids: var layout.FixedBytes32[],
        err: var str): bool =
    if !snapshot_schema.CsgCompilerSnapshotTablesStrictValidateInto(
           snapshot, err):
        return false
    let functionCount = snapshot.functions.typedFunctionIndexes.len
    if typedFunctionCount <= 0 ||
       functionCount != typedFunctionCount ||
       functionIds.len != typedFunctionCount ||
       fragmentCids.len != typedFunctionCount ||
       interfaceCids.len != typedFunctionCount:
        err =
            " lowering plan: canonical function identity coverage mismatch"
        return false
    var scratch: LoweringFunctionInterfaceProjectionScratchOwner
    loweringSequenceAllocatorSetLen(
        scratch,
        LoweringFunctionInterfaceProjectionScratchLength(
            length: typedFunctionCount))
    for functionId in 0..<functionCount:
        let typedFunctionIndex =
            snapshot.functions.typedFunctionIndexes[functionId]
        let symbolId = snapshot.functions.symbolIds[functionId]
        let fragmentCid = snapshot.functions.fragmentCids[functionId]
        let interfaceCid = snapshot.functions.interfaceCids[functionId]
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >= typedFunctionCount ||
           scratch.claimed[typedFunctionIndex] ||
           symbolId < 0 ||
           symbolId >= snapshot.symbols.interfaceCids.len ||
           layout.FixedBytes32Equal(
               fragmentCid, layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(
               interfaceCid, layout.FixedBytes32()) ||
           !layout.FixedBytes32Equal(
               interfaceCid,
               snapshot.symbols.interfaceCids[symbolId]) ||
           functionIds[typedFunctionIndex] != functionId ||
           !layout.FixedBytes32Equal(
               fragmentCids[typedFunctionIndex], fragmentCid) ||
           !layout.FixedBytes32Equal(
               interfaceCids[typedFunctionIndex], interfaceCid):
            LoweringFunctionInterfaceProjectionScratchClose(scratch)
            err =
                " lowering plan: canonical function identity drift"
            return false
        scratch.claimed[typedFunctionIndex] = true
    for typedFunctionIndex in 0..<typedFunctionCount:
        if !scratch.claimed[typedFunctionIndex]:
            LoweringFunctionInterfaceProjectionScratchClose(scratch)
            err =
                " lowering plan: canonical function identity hole"
            return false
    LoweringFunctionInterfaceProjectionScratchClose(scratch)
    err = ""
    return true

fn loweringManualConsumeBridgeAppendI32(
        buf: var layout.ByteBuf,
        value: int32) =
    var raw = Int64(value)
    if raw < 0:
        raw = raw + Int64(4294967296)
    layout.ByteBufAppendByte(buf, Int32((raw >> 24) & Int64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> 16) & Int64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> 8) & Int64(255)))
    layout.ByteBufAppendByte(buf, Int32(raw & Int64(255)))

@borrows
fn loweringExternFfiHandleCapabilityBridgeAppendDomain(
        buf: var layout.ByteBuf,
        domain: str) =
    loweringManualConsumeBridgeAppendI32(buf, domain.len)
    for byteIndex in 0..<domain.len:
        layout.ByteBufAppendByte(
            buf, Int32(domain[byteIndex]) & 255)

@borrows
fn loweringExternFfiHandleCapabilitySemanticI32(
        table: ccsg.CompilerCsgExternFfiHandleCallCapabilityTable,
        column: arenamod.ArenaArrayInt32,
        row: int32): int32 =
    return arenamod.ArenaArrayInt32Get(table.arena, column, row)

@borrows
fn loweringExternFfiHandleCapabilitySemanticShapeValid(
        table: ccsg.CompilerCsgExternFfiHandleCallCapabilityTable): bool =
    let callCount = table.resolvedCallRows.len
    let effectCount = table.effectRows.len
    return table.complete &&
           table.arena.capacityBytes > 0 &&
           table.callCoordinateKinds.len == callCount &&
           table.callerTypedFunctionIndexes.len == callCount &&
           table.typedCallNodeIndexes.len == callCount &&
           table.contractRows.len == callCount &&
           table.effectStarts.len == callCount &&
           table.effectCounts.len == callCount &&
           table.callCapabilityCids.len == callCount &&
           table.effectKinds.len == effectCount &&
           table.effectTargetKinds.len == effectCount &&
           table.effectParameterOrdinals.len == effectCount &&
           table.effectArgumentRows.len == effectCount &&
           table.effectArgumentValueNodeIndexes.len == effectCount &&
           table.effectValueDefinitionRows.len == effectCount &&
           table.effectGenerationRootValueDefinitionRows.len ==
               effectCount &&
           table.effectExactTypeIds.len == effectCount &&
           table.effectCarrierKinds.len == effectCount &&
           table.effectArgumentBindingCids.len == effectCount &&
           table.effectTypeCids.len == effectCount &&
           table.effectGenerationCids.len == effectCount &&
           table.effectDefinitionLineageCids.len == effectCount &&
           table.effectCapabilityCids.len == effectCount &&
           !layout.FixedBytes32Equal(
               table.cargoCid, layout.FixedBytes32())

@borrows
fn loweringExternFfiHandleCapabilityBridgeStorageReleased(
        plan: var LoweringPlanStub): bool =
    return ccsg.CompilerCsgExternFfiHandleCallCapabilityTableReleasedEmpty(
               plan.externFfiHandleCallCapabilityBridge.semanticCapabilities) &&
           plan.externFfiHandleCallCapabilityBridge.semanticContractCids.len == 0 &&
           plan.externFfiHandleCallCapabilityBridge.semanticContractCids.cap == 0 &&
           plan.externFfiHandleCallCapabilityBridge.semanticInterfaceCids.len == 0 &&
           plan.externFfiHandleCallCapabilityBridge.semanticInterfaceCids.cap == 0 &&
           plan.externFfiHandleCallCapabilityBridge.semanticEffectCids.len == 0 &&
           plan.externFfiHandleCallCapabilityBridge.semanticEffectCids.cap == 0 &&
           plan.externFfiHandleCallCapabilityBridge.snapshotCallIds.len == 0 &&
           plan.externFfiHandleCallCapabilityBridge.snapshotCallIds.cap == 0 &&
           plan.externFfiHandleCallCapabilityBridge.snapshotContractRows.len == 0 &&
           plan.externFfiHandleCallCapabilityBridge.snapshotContractRows.cap == 0 &&
           plan.externFfiHandleCallCapabilityBridge.snapshotEffectRows.len == 0 &&
           plan.externFfiHandleCallCapabilityBridge.snapshotEffectRows.cap == 0 &&
           plan.externFfiHandleCallCapabilityBridge.effectBridgeCids.len == 0 &&
           plan.externFfiHandleCallCapabilityBridge.effectBridgeCids.cap == 0 &&
           plan.externFfiHandleCallCapabilityBridge.callBridgeCids.len == 0 &&
           plan.externFfiHandleCallCapabilityBridge.callBridgeCids.cap == 0 &&
           layout.FixedBytes32Equal(
               plan.externFfiHandleCallCapabilityBridge.semanticCargoCid, layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               plan.externFfiHandleCallCapabilityBridge.bridgeCid, layout.FixedBytes32()) &&
           !plan.externFfiHandleCallCapabilityBridge.snapshotBound

fn LoweringExternFfiHandleCallCapabilityBridgeRelease(
        bridge: var LoweringExternFfiHandleCallCapabilityBridge) =
    ccsg.CompilerCsgExternFfiHandleCallCapabilityTableRelease(
        bridge.semanticCapabilities)
    freeSeq(bridge.semanticContractCids)
    freeSeq(bridge.semanticInterfaceCids)
    freeSeq(bridge.semanticEffectCids)
    freeSeq(bridge.snapshotCallIds)
    freeSeq(bridge.snapshotContractRows)
    freeSeq(bridge.snapshotEffectRows)
    freeSeq(bridge.effectBridgeCids)
    freeSeq(bridge.callBridgeCids)
    bridge = LoweringExternFfiHandleCallCapabilityBridge()

@borrows
fn LoweringExternFfiHandleCallCapabilityBridgePhysicalBufferCount(
        bridge: LoweringExternFfiHandleCallCapabilityBridge): int32 =
    var count: int32
    if bridge.semanticCapabilities.arena.capacityBytes > 0:
        count = count + 1
    if bridge.semanticCapabilities.callCapabilityCids.cap > 0:
        count = count + 1
    if bridge.semanticCapabilities.effectArgumentBindingCids.cap > 0:
        count = count + 1
    if bridge.semanticCapabilities.effectTypeCids.cap > 0:
        count = count + 1
    if bridge.semanticCapabilities.effectGenerationCids.cap > 0:
        count = count + 1
    if bridge.semanticCapabilities.effectDefinitionLineageCids.cap > 0:
        count = count + 1
    if bridge.semanticCapabilities.effectCapabilityCids.cap > 0:
        count = count + 1
    if bridge.semanticContractCids.cap > 0: count = count + 1
    if bridge.semanticInterfaceCids.cap > 0: count = count + 1
    if bridge.semanticEffectCids.cap > 0: count = count + 1
    if bridge.snapshotCallIds.cap > 0: count = count + 1
    if bridge.snapshotContractRows.cap > 0: count = count + 1
    if bridge.snapshotEffectRows.cap > 0: count = count + 1
    if bridge.effectBridgeCids.cap > 0: count = count + 1
    if bridge.callBridgeCids.cap > 0: count = count + 1
    return count

@borrows
fn LoweringExternFfiHandleCallCapabilityBridgeRetainedBytes(
        bridge: LoweringExternFfiHandleCallCapabilityBridge): int64 =
    var total =
        Int64(bridge.semanticCapabilities.arena.capacityBytes)
    total = total +
        Int64(bridge.semanticCapabilities.callCapabilityCids.cap) *
            Int64(sizeof(layout.FixedBytes32))
    total = total +
        Int64(bridge.semanticCapabilities.effectArgumentBindingCids.cap) *
            Int64(sizeof(layout.FixedBytes32))
    total = total +
        Int64(bridge.semanticCapabilities.effectTypeCids.cap) *
            Int64(sizeof(layout.FixedBytes32))
    total = total +
        Int64(bridge.semanticCapabilities.effectGenerationCids.cap) *
            Int64(sizeof(layout.FixedBytes32))
    total = total +
        Int64(
            bridge.semanticCapabilities.effectDefinitionLineageCids.cap) *
            Int64(sizeof(layout.FixedBytes32))
    total = total +
        Int64(bridge.semanticCapabilities.effectCapabilityCids.cap) *
            Int64(sizeof(layout.FixedBytes32))
    total = total +
        Int64(bridge.semanticContractCids.cap) *
            Int64(sizeof(layout.FixedBytes32))
    total = total +
        Int64(bridge.semanticInterfaceCids.cap) *
            Int64(sizeof(layout.FixedBytes32))
    total = total +
        Int64(bridge.semanticEffectCids.cap) *
            Int64(sizeof(layout.FixedBytes32))
    total = total + Int64(bridge.snapshotCallIds.cap) * Int64(sizeof(int32))
    total = total +
        Int64(bridge.snapshotContractRows.cap) * Int64(sizeof(int32))
    total = total +
        Int64(bridge.snapshotEffectRows.cap) * Int64(sizeof(int32))
    total = total +
        Int64(bridge.effectBridgeCids.cap) *
            Int64(sizeof(layout.FixedBytes32))
    total = total +
        Int64(bridge.callBridgeCids.cap) *
            Int64(sizeof(layout.FixedBytes32))
    return total

@borrows
fn loweringExternFfiHandleCapabilityBridgeFail(
        bridge: var LoweringExternFfiHandleCallCapabilityBridge,
        err: var str,
        reason: str): bool =
    if err == "":
        err = reason
    LoweringExternFfiHandleCallCapabilityBridgeRelease(bridge)
    return false

@borrows
fn loweringExternFfiHandleCapabilityBridgeMovedFail(
        bridge: var LoweringExternFfiHandleCallCapabilityBridge,
        plan: var LoweringPlanStub,
        err: var str,
        reason: str): bool =
    if err == "":
        err = reason
    plan.externFfiHandleCallCapabilityBridge = bridge
    bridge = LoweringExternFfiHandleCallCapabilityBridge()
    return false

@borrows
fn loweringExternFfiHandleCapabilityContractTableShapeValid(
        contracts: ccsg.CompilerCsgExternFfiHandleContractTable): bool =
    let contractCount = contracts.contractCids.len
    let effectCount = contracts.effectCids.len
    return contracts.complete &&
           contracts.effectStarts.len == contractCount &&
           contracts.effectCounts.len == contractCount &&
           contracts.interfaceCids.len == contractCount &&
           contracts.effectContractRows.len == effectCount &&
           contracts.effectKinds.len == effectCount &&
           contracts.effectTargetKinds.len == effectCount &&
           contracts.effectParameterOrdinals.len == effectCount &&
           contracts.effectTypeIds.len == effectCount &&
           contracts.effectTypeCids.len == effectCount &&
           contracts.effectAbiCarrierKinds.len == effectCount

@borrows
fn loweringExternFfiHandleCapabilityResolvedCallExact(
        bridge: LoweringExternFfiHandleCallCapabilityBridge,
        plan: LoweringPlanStub,
        callRow: int32): bool =
    let table = bridge.semanticCapabilities
    if callRow < 0 || callRow >= table.resolvedCallRows.len:
        return false
    let resolvedCallRow =
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.resolvedCallRows, callRow)
    let callerTypedFunctionIndex =
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.callerTypedFunctionIndexes, callRow)
    let typedCallNodeIndex =
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.typedCallNodeIndexes, callRow)
    if loweringExternFfiHandleCapabilitySemanticI32(
           table, table.callCoordinateKinds, callRow) !=
               ccsg.CompilerCsgExternFfiHandleCallCoordinateResolvedCallRow ||
       resolvedCallRow < 0 ||
       resolvedCallRow >= plan.resolvedCallSnapshot.sourceIndexes.len ||
       resolvedCallRow >= plan.resolvedCallSnapshot.functionIndexes.len ||
       resolvedCallRow >= plan.resolvedCallSnapshot.typedCallNodeIndexes.len ||
       callerTypedFunctionIndex !=
           plan.resolvedCallSnapshot.functionIndexes[resolvedCallRow] ||
       typedCallNodeIndex !=
           plan.resolvedCallSnapshot.typedCallNodeIndexes[resolvedCallRow] ||
       typedCallNodeIndex < 0 ||
       typedCallNodeIndex >= plan.snapshotCallIdByTypedIrNodeIndex.len:
        return false
    let snapshotCallId = bridge.snapshotCallIds[callRow]
    return snapshotCallId >= 0 &&
           snapshotCallId < plan.snapshotCallIds.len &&
           plan.snapshotCallIdByTypedIrNodeIndex[typedCallNodeIndex] ==
               snapshotCallId &&
           plan.snapshotCallIds[snapshotCallId] == snapshotCallId &&
           plan.snapshotCallResultTypedIrNodeIndexes[snapshotCallId] ==
               typedCallNodeIndex &&
           plan.snapshotCallCallerTypedFunctionIndexes[snapshotCallId] ==
               callerTypedFunctionIndex &&
           plan.snapshotCallTargetExternFunctionIds[snapshotCallId] >= 0 &&
           plan.snapshotCallTargetFunctionIds[snapshotCallId] == -1

@borrows
fn loweringExternFfiHandleCapabilityArgumentExact(
        bridge: LoweringExternFfiHandleCallCapabilityBridge,
        plan: LoweringPlanStub,
        callRow: int32,
        effectRow: int32): bool =
    let table = bridge.semanticCapabilities
    let resolvedCallRow =
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.resolvedCallRows, callRow)
    let targetKind =
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.effectTargetKinds, effectRow)
    let effectKind =
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.effectKinds, effectRow)
    let ordinal = loweringExternFfiHandleCapabilitySemanticI32(
        table, table.effectParameterOrdinals, effectRow)
    let argumentRow = loweringExternFfiHandleCapabilitySemanticI32(
        table, table.effectArgumentRows, effectRow)
    let valueNodeIndex = loweringExternFfiHandleCapabilitySemanticI32(
        table, table.effectArgumentValueNodeIndexes, effectRow)
    let valueDefinitionRow =
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.effectValueDefinitionRows, effectRow)
    let generationRootDefinitionRow =
        loweringExternFfiHandleCapabilitySemanticI32(
            table,
            table.effectGenerationRootValueDefinitionRows,
            effectRow)
    let exactTypeId = loweringExternFfiHandleCapabilitySemanticI32(
        table, table.effectExactTypeIds, effectRow)
    let bindingCid = table.effectArgumentBindingCids[effectRow]
    let definitionCount =
        plan.snapshotValueDefinitionTypedFunctionIndexes.len
    let callerTypedFunctionIndex =
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.callerTypedFunctionIndexes, callRow)
    if valueDefinitionRow < 0 ||
       valueDefinitionRow >= definitionCount ||
       generationRootDefinitionRow < 0 ||
       generationRootDefinitionRow >= definitionCount ||
       generationRootDefinitionRow > valueDefinitionRow ||
       exactTypeId < 0 ||
       plan.snapshotValueDefinitionTypedFunctionIndexes[
           valueDefinitionRow] != callerTypedFunctionIndex ||
       plan.snapshotValueDefinitionTypedFunctionIndexes[
           generationRootDefinitionRow] != callerTypedFunctionIndex ||
       arenamod.ArenaArrayInt32Get(
           plan.typedIr.arena,
           plan.typedIr.valueDefinitions_typedFunctionIndexes,
           valueDefinitionRow) != callerTypedFunctionIndex ||
       arenamod.ArenaArrayInt32Get(
           plan.typedIr.arena,
           plan.typedIr.valueDefinitions_typedFunctionIndexes,
           generationRootDefinitionRow) != callerTypedFunctionIndex ||
       arenamod.ArenaArrayInt32Get(
           plan.typedIr.arena,
           plan.typedIr.valueDefinitions_exactTypeIds,
           valueDefinitionRow) != exactTypeId ||
       arenamod.ArenaArrayInt32Get(
           plan.typedIr.arena,
           plan.typedIr.valueDefinitions_exactTypeIds,
           generationRootDefinitionRow) != exactTypeId:
        return false
    let valueDefiningNodeIndex = arenamod.ArenaArrayInt32Get(
        plan.typedIr.arena,
        plan.typedIr.valueDefinitions_definingTypedNodeIndexes,
        valueDefinitionRow)
    let rootDefiningNodeIndex = arenamod.ArenaArrayInt32Get(
        plan.typedIr.arena,
        plan.typedIr.valueDefinitions_definingTypedNodeIndexes,
        generationRootDefinitionRow)
    if valueDefiningNodeIndex < 0 ||
       valueDefiningNodeIndex >= plan.typedIr.nodes2_nodeIndexs.len ||
       rootDefiningNodeIndex < 0 ||
       rootDefiningNodeIndex >= plan.typedIr.nodes2_nodeIndexs.len ||
       arenamod.ArenaArrayInt32Get(
           plan.typedIr.arena,
           plan.typedIr.nodes2_producedValueDefinitionRows,
           valueDefiningNodeIndex) != valueDefinitionRow ||
       arenamod.ArenaArrayInt32Get(
           plan.typedIr.arena,
           plan.typedIr.nodes2_producedValueDefinitionRows,
           rootDefiningNodeIndex) != generationRootDefinitionRow:
        return false
    if targetKind == ccsg.CompilerCsgExternFfiHandleTargetResult:
        let snapshotCallId = bridge.snapshotCallIds[callRow]
        let typedCallNodeIndex =
            loweringExternFfiHandleCapabilitySemanticI32(
                table, table.typedCallNodeIndexes, callRow)
        if snapshotCallId < 0 ||
           snapshotCallId >=
               plan.snapshotCallResultValueDefinitionRows.len:
            return false
        return effectKind ==
                   ccsg.CompilerCsgEffectExternFfiHandleProduce &&
               ordinal == -1 &&
               argumentRow == -1 &&
               valueNodeIndex == typedCallNodeIndex &&
               valueDefiningNodeIndex == typedCallNodeIndex &&
               valueDefinitionRow == generationRootDefinitionRow &&
               valueDefinitionRow ==
                   plan.snapshotCallResultValueDefinitionRows[
                       snapshotCallId] &&
               layout.FixedBytes32Equal(
                   bindingCid, layout.FixedBytes32())
    if targetKind !=
           ccsg.CompilerCsgExternFfiHandleTargetParameter ||
       (effectKind != ccsg.CompilerCsgEffectExternFfiHandleBorrow &&
        effectKind != ccsg.CompilerCsgEffectExternFfiHandleConsume):
        return false
    let argumentStart =
        plan.resolvedCallSnapshot.callArgumentStarts[resolvedCallRow]
    let argumentCount =
        plan.resolvedCallSnapshot.callArgCounts[resolvedCallRow]
    if valueNodeIndex < 0 ||
       valueNodeIndex >= plan.typedIr.nodes2_nodeIndexs.len:
        return false
    let bindingDefinitionRow = arenamod.ArenaArrayInt32Get(
        plan.typedIr.arena,
        plan.typedIr.nodes2_bindingValueDefinitionRows,
        valueNodeIndex)
    let producedDefinitionRow = arenamod.ArenaArrayInt32Get(
        plan.typedIr.arena,
        plan.typedIr.nodes2_producedValueDefinitionRows,
        valueNodeIndex)
    var expectedValueDefinitionRow = bindingDefinitionRow
    if expectedValueDefinitionRow < 0:
        expectedValueDefinitionRow = producedDefinitionRow
    return !(bindingDefinitionRow >= 0 && producedDefinitionRow >= 0) &&
           expectedValueDefinitionRow == valueDefinitionRow &&
           ordinal >= 0 && ordinal < argumentCount &&
           argumentRow == argumentStart + ordinal &&
           argumentRow >= 0 &&
           argumentRow <
               plan.resolvedCallSnapshot.callArgumentCallRows.len &&
           plan.resolvedCallSnapshot.callArgumentCallRows[argumentRow] ==
               resolvedCallRow &&
           plan.resolvedCallSnapshot.callArgumentOrdinals[argumentRow] ==
               ordinal &&
           plan.resolvedCallSnapshot.callArgumentValueNodeIndexes[
               argumentRow] == valueNodeIndex &&
           layout.FixedBytes32Equal(
               plan.resolvedCallSnapshot.callArgumentBindingCids[
                   argumentRow],
               bindingCid) &&
           !layout.FixedBytes32Equal(
               bindingCid, layout.FixedBytes32())

@borrows
fn loweringExternFfiHandleCapabilitySnapshotEffectRowInto(
        bridge: LoweringExternFfiHandleCallCapabilityBridge,
        plan: LoweringPlanStub,
        callRow: int32,
        effectRow: int32,
        out: var int32): bool =
    let table = bridge.semanticCapabilities
    let snapshotCallId = bridge.snapshotCallIds[callRow]
    let snapshotContractRow = bridge.snapshotContractRows[callRow]
    let effectStart =
        plan.snapshotCallExternFfiHandleEffectStarts[snapshotCallId]
    let effectCount =
        plan.snapshotCallExternFfiHandleEffectCounts[snapshotCallId]
    let semanticEffectStart =
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.effectStarts, callRow)
    let semanticEffectCount =
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.effectCounts, callRow)
    let effectOffset = effectRow - semanticEffectStart
    if effectStart < 0 || effectCount <= 0 ||
       effectCount != semanticEffectCount ||
       effectOffset < 0 || effectOffset >= effectCount ||
       effectStart >
           plan.snapshotExternFfiHandleEffectCids.len - effectCount:
        return false
    let snapshotEffectRow = effectStart + effectOffset
    if plan.snapshotExternFfiHandleEffectContractRows[
           snapshotEffectRow] != snapshotContractRow ||
       plan.snapshotExternFfiHandleEffectKinds[snapshotEffectRow] !=
           loweringExternFfiHandleCapabilitySemanticI32(
               table, table.effectKinds, effectRow) ||
       plan.snapshotExternFfiHandleEffectTargetKinds[
           snapshotEffectRow] !=
           loweringExternFfiHandleCapabilitySemanticI32(
               table, table.effectTargetKinds, effectRow) ||
       plan.snapshotExternFfiHandleEffectParameterOrdinals[
           snapshotEffectRow] !=
           loweringExternFfiHandleCapabilitySemanticI32(
               table, table.effectParameterOrdinals, effectRow) ||
       plan.snapshotExternFfiHandleEffectAbiCarrierKinds[
           snapshotEffectRow] !=
           loweringExternFfiHandleCapabilitySemanticI32(
               table, table.effectCarrierKinds, effectRow) ||
       !layout.FixedBytes32Equal(
           plan.snapshotExternFfiHandleEffectTypeCids[
               snapshotEffectRow],
           table.effectTypeCids[effectRow]) ||
       !layout.FixedBytes32Equal(
           plan.snapshotExternFfiHandleEffectCids[
               snapshotEffectRow],
           bridge.semanticEffectCids[effectRow]):
        return false
    out = snapshotEffectRow
    return true

@borrows
fn loweringExternFfiHandleCapabilityEffectBridgeCid(
        bridge: LoweringExternFfiHandleCallCapabilityBridge,
        plan: LoweringPlanStub,
        callRow: int32,
        effectRow: int32): layout.FixedBytes32 =
    let table = bridge.semanticCapabilities
    let snapshotEffectRow = bridge.snapshotEffectRows[effectRow]
    var buf = layout.ByteBufInit(768)
    loweringExternFfiHandleCapabilityBridgeAppendDomain(
        buf, "cheng.lowering.extern_ffi_handle_call_capability.effect")
    layout.ByteBufAppendFixed32(
        buf, plan.canonicalSnapshotProjectionAuthorityCid)
    layout.ByteBufAppendFixed32(buf, bridge.semanticCargoCid)
    loweringManualConsumeBridgeAppendI32(buf, callRow)
    loweringManualConsumeBridgeAppendI32(
        buf, bridge.snapshotCallIds[callRow])
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.contractRows, callRow))
    loweringManualConsumeBridgeAppendI32(
        buf, bridge.snapshotContractRows[callRow])
    layout.ByteBufAppendFixed32(
        buf, table.callCapabilityCids[callRow])
    loweringManualConsumeBridgeAppendI32(buf, effectRow)
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.effectRows, effectRow))
    loweringManualConsumeBridgeAppendI32(buf, snapshotEffectRow)
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.effectKinds, effectRow))
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.effectTargetKinds, effectRow))
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.effectParameterOrdinals, effectRow))
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.effectArgumentRows, effectRow))
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.effectArgumentValueNodeIndexes, effectRow))
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.effectValueDefinitionRows, effectRow))
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table,
            table.effectGenerationRootValueDefinitionRows,
            effectRow))
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.effectExactTypeIds, effectRow))
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.effectCarrierKinds, effectRow))
    layout.ByteBufAppendFixed32(
        buf, table.effectArgumentBindingCids[effectRow])
    layout.ByteBufAppendFixed32(buf, table.effectTypeCids[effectRow])
    layout.ByteBufAppendFixed32(
        buf, table.effectGenerationCids[effectRow])
    layout.ByteBufAppendFixed32(
        buf, table.effectDefinitionLineageCids[effectRow])
    layout.ByteBufAppendFixed32(
        buf, table.effectCapabilityCids[effectRow])
    layout.ByteBufAppendFixed32(
        buf, bridge.semanticEffectCids[effectRow])
    loweringManualConsumeBridgeAppendI32(
        buf, plan.snapshotExternFfiHandleEffectContractRows[
            snapshotEffectRow])
    loweringManualConsumeBridgeAppendI32(
        buf, plan.snapshotExternFfiHandleEffectKinds[snapshotEffectRow])
    loweringManualConsumeBridgeAppendI32(
        buf, plan.snapshotExternFfiHandleEffectTargetKinds[
            snapshotEffectRow])
    loweringManualConsumeBridgeAppendI32(
        buf, plan.snapshotExternFfiHandleEffectParameterOrdinals[
            snapshotEffectRow])
    loweringManualConsumeBridgeAppendI32(
        buf, plan.snapshotExternFfiHandleEffectAbiCarrierKinds[
            snapshotEffectRow])
    layout.ByteBufAppendFixed32(
        buf, plan.snapshotExternFfiHandleEffectTypeCids[
            snapshotEffectRow])
    layout.ByteBufAppendFixed32(
        buf, plan.snapshotExternFfiHandleEffectCids[snapshotEffectRow])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn loweringExternFfiHandleCapabilityCallBridgeCid(
        bridge: LoweringExternFfiHandleCallCapabilityBridge,
        plan: LoweringPlanStub,
        callRow: int32): layout.FixedBytes32 =
    let table = bridge.semanticCapabilities
    let effectStart = loweringExternFfiHandleCapabilitySemanticI32(
        table, table.effectStarts, callRow)
    let effectCount = loweringExternFfiHandleCapabilitySemanticI32(
        table, table.effectCounts, callRow)
    let snapshotCallId = bridge.snapshotCallIds[callRow]
    var buf = layout.ByteBufInit(576 + effectCount * 32)
    loweringExternFfiHandleCapabilityBridgeAppendDomain(
        buf, "cheng.lowering.extern_ffi_handle_call_capability.call")
    layout.ByteBufAppendFixed32(
        buf, plan.canonicalSnapshotProjectionAuthorityCid)
    layout.ByteBufAppendFixed32(buf, bridge.semanticCargoCid)
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.callCoordinateKinds, callRow))
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.resolvedCallRows, callRow))
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.callerTypedFunctionIndexes, callRow))
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.typedCallNodeIndexes, callRow))
    loweringManualConsumeBridgeAppendI32(
        buf,
        loweringExternFfiHandleCapabilitySemanticI32(
            table, table.contractRows, callRow))
    loweringManualConsumeBridgeAppendI32(buf, effectStart)
    loweringManualConsumeBridgeAppendI32(buf, effectCount)
    layout.ByteBufAppendFixed32(
        buf, table.callCapabilityCids[callRow])
    layout.ByteBufAppendFixed32(
        buf, bridge.semanticContractCids[callRow])
    layout.ByteBufAppendFixed32(
        buf, bridge.semanticInterfaceCids[callRow])
    loweringManualConsumeBridgeAppendI32(buf, snapshotCallId)
    loweringManualConsumeBridgeAppendI32(
        buf, bridge.snapshotContractRows[callRow])
    layout.ByteBufAppendFixed32(
        buf, plan.snapshotCallExternFfiHandleContractCids[
            snapshotCallId])
    layout.ByteBufAppendFixed32(
        buf, plan.snapshotCallExternFfiHandleInterfaceCids[
            snapshotCallId])
    loweringManualConsumeBridgeAppendI32(buf, effectCount)
    for effectRow in effectStart..<effectStart + effectCount:
        layout.ByteBufAppendFixed32(
            buf, bridge.effectBridgeCids[effectRow])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn loweringExternFfiHandleCapabilityBridgeCid(
        bridge: LoweringExternFfiHandleCallCapabilityBridge,
        plan: LoweringPlanStub): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(
        256 + bridge.callBridgeCids.len * 32)
    loweringExternFfiHandleCapabilityBridgeAppendDomain(
        buf, "cheng.lowering.extern_ffi_handle_call_capability.bridge")
    layout.ByteBufAppendFixed32(
        buf, plan.canonicalSnapshotProjectionAuthorityCid)
    layout.ByteBufAppendFixed32(buf, bridge.semanticCargoCid)
    loweringManualConsumeBridgeAppendI32(
        buf, bridge.semanticCapabilities.resolvedCallRows.len)
    loweringManualConsumeBridgeAppendI32(
        buf, bridge.semanticCapabilities.effectRows.len)
    for callRow in 0..<bridge.callBridgeCids.len:
        layout.ByteBufAppendFixed32(buf, bridge.callBridgeCids[callRow])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn loweringExternFfiHandleCallCapabilityBridgeStrictValidate(
        bridge: LoweringExternFfiHandleCallCapabilityBridge,
        plan: LoweringPlanStub,
        err: var str): bool =
    let table = bridge.semanticCapabilities
    let callCount = table.resolvedCallRows.len
    let effectCount = table.effectRows.len
    let zeroCid = layout.FixedBytes32()
    let canonicalCallCount = plan.snapshotCallIds.len
    let canonicalEffectCount =
        plan.snapshotExternFfiHandleEffectCids.len
    let valueDefinitionCount =
        plan.typedIr.valueDefinitions_typedFunctionIndexes.len
    if !bridge.snapshotBound ||
       !loweringExternFfiHandleCapabilitySemanticShapeValid(table) ||
       plan.snapshotCallResultTypedIrNodeIndexes.len != canonicalCallCount ||
       plan.snapshotCallCallerTypedFunctionIndexes.len != canonicalCallCount ||
       plan.snapshotCallTargetFunctionIds.len != canonicalCallCount ||
       plan.snapshotCallTargetExternFunctionIds.len != canonicalCallCount ||
       plan.snapshotCallResultValueDefinitionRows.len !=
           canonicalCallCount ||
       plan.snapshotCallExternFfiHandleContractRows.len !=
           canonicalCallCount ||
       plan.snapshotCallExternFfiHandleContractCids.len !=
           canonicalCallCount ||
       plan.snapshotCallExternFfiHandleInterfaceCids.len !=
           canonicalCallCount ||
       plan.snapshotCallExternFfiHandleEffectStarts.len !=
           canonicalCallCount ||
       plan.snapshotCallExternFfiHandleEffectCounts.len !=
           canonicalCallCount ||
       plan.snapshotExternFfiHandleEffectContractRows.len !=
           canonicalEffectCount ||
       plan.snapshotExternFfiHandleEffectKinds.len !=
           canonicalEffectCount ||
       plan.snapshotExternFfiHandleEffectTargetKinds.len !=
           canonicalEffectCount ||
       plan.snapshotExternFfiHandleEffectParameterOrdinals.len !=
           canonicalEffectCount ||
       plan.snapshotExternFfiHandleEffectTypeCids.len !=
           canonicalEffectCount ||
       plan.snapshotExternFfiHandleEffectAbiCarrierKinds.len !=
           canonicalEffectCount ||
       plan.resolvedCallSnapshot.callArgumentStarts.len !=
           plan.resolvedCallSnapshot.sourceIndexes.len ||
       plan.resolvedCallSnapshot.callArgCounts.len !=
           plan.resolvedCallSnapshot.sourceIndexes.len ||
       plan.resolvedCallSnapshot.callArgumentCallRows.len !=
           plan.resolvedCallSnapshot.callArgumentOrdinals.len ||
       plan.resolvedCallSnapshot.callArgumentCallRows.len !=
           plan.resolvedCallSnapshot.callArgumentValueNodeIndexes.len ||
       plan.resolvedCallSnapshot.callArgumentCallRows.len !=
           plan.resolvedCallSnapshot.callArgumentBindingCids.len ||
       plan.snapshotValueDefinitionTypedFunctionIndexes.len !=
           valueDefinitionCount ||
       bridge.semanticContractCids.len != callCount ||
       bridge.semanticInterfaceCids.len != callCount ||
       bridge.snapshotCallIds.len != callCount ||
       bridge.snapshotContractRows.len != callCount ||
       bridge.callBridgeCids.len != callCount ||
       bridge.semanticEffectCids.len != effectCount ||
       bridge.snapshotEffectRows.len != effectCount ||
       bridge.effectBridgeCids.len != effectCount ||
       !layout.FixedBytes32Equal(
           bridge.semanticCargoCid, table.cargoCid) ||
       layout.FixedBytes32Equal(bridge.semanticCargoCid, zeroCid) ||
       layout.FixedBytes32Equal(bridge.bridgeCid, zeroCid) ||
       layout.FixedBytes32Equal(
           plan.canonicalSnapshotProjectionAuthorityCid, zeroCid):
        err = " lowering plan: extern ffi handle capability bridge shape invalid"
        return false
    var expectedEffectStart: int32
    for callRow in 0..<callCount:
        let effectStart =
            loweringExternFfiHandleCapabilitySemanticI32(
                table, table.effectStarts, callRow)
        let callEffectCount =
            loweringExternFfiHandleCapabilitySemanticI32(
                table, table.effectCounts, callRow)
        let snapshotCallId = bridge.snapshotCallIds[callRow]
        let snapshotContractRow = bridge.snapshotContractRows[callRow]
        if effectStart != expectedEffectStart ||
           callEffectCount <= 0 ||
           effectStart > effectCount - callEffectCount ||
           !loweringExternFfiHandleCapabilityResolvedCallExact(
               bridge, plan, callRow) ||
           snapshotContractRow < 0 ||
           snapshotCallId < 0 ||
           snapshotCallId >=
               plan.snapshotCallExternFfiHandleContractRows.len ||
           plan.snapshotCallExternFfiHandleContractRows[
               snapshotCallId] != snapshotContractRow ||
           !layout.FixedBytes32Equal(
               bridge.semanticContractCids[callRow],
               plan.snapshotCallExternFfiHandleContractCids[
                   snapshotCallId]) ||
           !layout.FixedBytes32Equal(
               bridge.semanticInterfaceCids[callRow],
               plan.snapshotCallExternFfiHandleInterfaceCids[
                   snapshotCallId]) ||
           layout.FixedBytes32Equal(
               table.callCapabilityCids[callRow], zeroCid) ||
           layout.FixedBytes32Equal(
               bridge.callBridgeCids[callRow], zeroCid) ||
           layout.FixedBytes32Equal(
               bridge.semanticContractCids[callRow], zeroCid) ||
           layout.FixedBytes32Equal(
               bridge.semanticInterfaceCids[callRow], zeroCid):
            err = " lowering plan: extern ffi handle capability call identity drift"
            return false
        for priorCallRow in 0..<callRow:
            if bridge.snapshotCallIds[priorCallRow] == snapshotCallId:
                err = " lowering plan: duplicate extern ffi handle capability CallId"
                return false
        for effectRow in effectStart..<effectStart + callEffectCount:
            var expectedSnapshotEffectRow: int32
            if loweringExternFfiHandleCapabilitySemanticI32(
                   table, table.effectValueDefinitionRows, effectRow) < 0 ||
               loweringExternFfiHandleCapabilitySemanticI32(
                   table, table.effectExactTypeIds, effectRow) < 0 ||
               layout.FixedBytes32Equal(
                   table.effectTypeCids[effectRow], zeroCid) ||
               layout.FixedBytes32Equal(
                   table.effectGenerationCids[effectRow], zeroCid) ||
               layout.FixedBytes32Equal(
                   table.effectDefinitionLineageCids[effectRow],
                   zeroCid) ||
               layout.FixedBytes32Equal(
                   table.effectCapabilityCids[effectRow], zeroCid) ||
               layout.FixedBytes32Equal(
                   bridge.semanticEffectCids[effectRow], zeroCid) ||
               layout.FixedBytes32Equal(
                   bridge.effectBridgeCids[effectRow], zeroCid) ||
               !loweringExternFfiHandleCapabilityArgumentExact(
                   bridge, plan, callRow, effectRow) ||
               !loweringExternFfiHandleCapabilitySnapshotEffectRowInto(
                   bridge,
                   plan,
                   callRow,
                   effectRow,
                   expectedSnapshotEffectRow) ||
               bridge.snapshotEffectRows[effectRow] !=
                   expectedSnapshotEffectRow ||
               !layout.FixedBytes32Equal(
                   bridge.effectBridgeCids[effectRow],
                   loweringExternFfiHandleCapabilityEffectBridgeCid(
                       bridge, plan, callRow, effectRow)):
                err = " lowering plan: extern ffi handle capability effect identity drift"
                return false
        if !layout.FixedBytes32Equal(
               bridge.callBridgeCids[callRow],
               loweringExternFfiHandleCapabilityCallBridgeCid(
                   bridge, plan, callRow)):
            err = " lowering plan: extern ffi handle capability call CID drift"
            return false
        expectedEffectStart = effectStart + callEffectCount
    if expectedEffectStart != effectCount ||
       !layout.FixedBytes32Equal(
           bridge.bridgeCid,
           loweringExternFfiHandleCapabilityBridgeCid(bridge, plan)):
        err = " lowering plan: extern ffi handle capability bridge root drift"
        return false
    err = ""
    return true

@borrows
fn LoweringExternFfiHandleCallCapabilityBridgeStrictValidateInto(
        plan: LoweringPlanStub,
        err: var str): bool =
    return loweringExternFfiHandleCallCapabilityBridgeStrictValidate(
        plan.externFfiHandleCallCapabilityBridge, plan, err)

fn loweringExternFfiHandleCapabilityBridgeBindErr(
        err: var str,
        reason: str): bool =
    if err == "":
        err = reason
    return false

fn LoweringBindExternFfiHandleCallCapabilityBridge(
        compilerCsg: var ccsg.CompilerCsg,
        plan: var LoweringPlanStub,
        err: var str): bool =
    if !loweringExternFfiHandleCapabilityBridgeStorageReleased(plan) ||
       !loweringExternFfiHandleCapabilitySemanticShapeValid(
           compilerCsg.externFfiHandleCallCapabilities) ||
       !loweringExternFfiHandleCapabilityContractTableShapeValid(
           compilerCsg.externFfiHandleContracts):
        return loweringExternFfiHandleCapabilityBridgeFail(
            plan.externFfiHandleCallCapabilityBridge,
            err,
            " lowering plan: extern ffi handle capability bridge source invalid")
    var bridge: LoweringExternFfiHandleCallCapabilityBridge
    bridge.semanticCapabilities =
        compilerCsg.externFfiHandleCallCapabilities
    compilerCsg.externFfiHandleCallCapabilities =
        ccsg.CompilerCsgExternFfiHandleCallCapabilityTable()
    bridge.semanticCargoCid = bridge.semanticCapabilities.cargoCid
    let callCount = bridge.semanticCapabilities.resolvedCallRows.len
    for callRow in 0..<callCount:
        let semanticContractRow =
            loweringExternFfiHandleCapabilitySemanticI32(
                bridge.semanticCapabilities,
                bridge.semanticCapabilities.contractRows,
                callRow)
        let typedCallNodeIndex =
            loweringExternFfiHandleCapabilitySemanticI32(
                bridge.semanticCapabilities,
                bridge.semanticCapabilities.typedCallNodeIndexes,
                callRow)
        if semanticContractRow < 0 ||
           semanticContractRow >=
               compilerCsg.externFfiHandleContracts.contractCids.len ||
           typedCallNodeIndex < 0 ||
           typedCallNodeIndex >=
               plan.snapshotCallIdByTypedIrNodeIndex.len:
            return loweringExternFfiHandleCapabilityBridgeMovedFail(
                bridge,
                plan,
                err,
                " lowering plan: extern ffi handle semantic call coordinate invalid")
        let snapshotCallId =
            plan.snapshotCallIdByTypedIrNodeIndex[typedCallNodeIndex]
        if snapshotCallId < 0 ||
           snapshotCallId >=
               plan.snapshotCallExternFfiHandleContractRows.len:
            return loweringExternFfiHandleCapabilityBridgeMovedFail(
                bridge,
                plan,
                err,
                " lowering plan: extern ffi handle canonical CallId missing")
        let snapshotContractRow =
            plan.snapshotCallExternFfiHandleContractRows[
                snapshotCallId]
        if snapshotContractRow < 0 ||
           !layout.FixedBytes32Equal(
               compilerCsg.externFfiHandleContracts.contractCids[
                   semanticContractRow],
               plan.snapshotCallExternFfiHandleContractCids[
                   snapshotCallId]) ||
           !layout.FixedBytes32Equal(
               compilerCsg.externFfiHandleContracts.interfaceCids[
                   semanticContractRow],
               plan.snapshotCallExternFfiHandleInterfaceCids[
                   snapshotCallId]):
            return loweringExternFfiHandleCapabilityBridgeMovedFail(
                bridge,
                plan,
                err,
                " lowering plan: extern ffi handle contract CID mapping failed")
        add(bridge.semanticContractCids,
            layout.FixedBytes32Copy(
                compilerCsg.externFfiHandleContracts.contractCids[
                    semanticContractRow]))
        add(bridge.semanticInterfaceCids,
            layout.FixedBytes32Copy(
                compilerCsg.externFfiHandleContracts.interfaceCids[
                    semanticContractRow]))
        add(bridge.snapshotCallIds, snapshotCallId)
        add(bridge.snapshotContractRows, snapshotContractRow)
        let effectStart =
            loweringExternFfiHandleCapabilitySemanticI32(
                bridge.semanticCapabilities,
                bridge.semanticCapabilities.effectStarts,
                callRow)
        let effectCount =
            loweringExternFfiHandleCapabilitySemanticI32(
                bridge.semanticCapabilities,
                bridge.semanticCapabilities.effectCounts,
                callRow)
        let semanticContractEffectStart =
            compilerCsg.externFfiHandleContracts.effectStarts[
                semanticContractRow]
        if effectStart != bridge.semanticEffectCids.len ||
           effectCount !=
               compilerCsg.externFfiHandleContracts.effectCounts[
                   semanticContractRow] ||
           semanticContractEffectStart < 0 || effectCount <= 0 ||
           semanticContractEffectStart >
               compilerCsg.externFfiHandleContracts.effectCids.len -
                   effectCount:
            return loweringExternFfiHandleCapabilityBridgeMovedFail(
                bridge,
                plan,
                err,
                " lowering plan: extern ffi handle semantic effect CSR drift")
        for effectOffset in 0..<effectCount:
            let effectRow = effectStart + effectOffset
            let semanticEffectRow =
                loweringExternFfiHandleCapabilitySemanticI32(
                    bridge.semanticCapabilities,
                    bridge.semanticCapabilities.effectRows,
                    effectRow)
            if semanticEffectRow !=
                   semanticContractEffectStart + effectOffset ||
               compilerCsg.externFfiHandleContracts.effectContractRows[
                   semanticEffectRow] !=
                   semanticContractRow ||
               compilerCsg.externFfiHandleContracts.effectKinds[
                   semanticEffectRow] !=
                   loweringExternFfiHandleCapabilitySemanticI32(
                       bridge.semanticCapabilities,
                       bridge.semanticCapabilities.effectKinds,
                       effectRow) ||
               compilerCsg.externFfiHandleContracts.effectTargetKinds[
                   semanticEffectRow] !=
                   loweringExternFfiHandleCapabilitySemanticI32(
                       bridge.semanticCapabilities,
                       bridge.semanticCapabilities.effectTargetKinds,
                       effectRow) ||
               compilerCsg.externFfiHandleContracts.effectParameterOrdinals[
                   semanticEffectRow] !=
                   loweringExternFfiHandleCapabilitySemanticI32(
                       bridge.semanticCapabilities,
                       bridge.semanticCapabilities.effectParameterOrdinals,
                       effectRow) ||
               compilerCsg.externFfiHandleContracts.effectTypeIds[
                   semanticEffectRow] !=
                   loweringExternFfiHandleCapabilitySemanticI32(
                       bridge.semanticCapabilities,
                       bridge.semanticCapabilities.effectExactTypeIds,
                       effectRow) ||
               compilerCsg.externFfiHandleContracts.effectAbiCarrierKinds[
                   semanticEffectRow] !=
                   loweringExternFfiHandleCapabilitySemanticI32(
                       bridge.semanticCapabilities,
                       bridge.semanticCapabilities.effectCarrierKinds,
                       effectRow) ||
               !layout.FixedBytes32Equal(
                   compilerCsg.externFfiHandleContracts.effectTypeCids[
                       semanticEffectRow],
                   bridge.semanticCapabilities.effectTypeCids[
                       effectRow]):
                return loweringExternFfiHandleCapabilityBridgeMovedFail(
                    bridge,
                    plan,
                    err,
                    " lowering plan: extern ffi handle semantic effect drift")
            add(bridge.semanticEffectCids,
                layout.FixedBytes32Copy(
                    compilerCsg.externFfiHandleContracts.effectCids[
                        semanticEffectRow]))
            var snapshotEffectRow: int32
            if !loweringExternFfiHandleCapabilitySnapshotEffectRowInto(
                   bridge,
                   plan,
                   callRow,
                   effectRow,
                   snapshotEffectRow):
                return loweringExternFfiHandleCapabilityBridgeMovedFail(
                    bridge,
                    plan,
                    err,
                    " lowering plan: extern ffi handle canonical effect mapping failed")
            add(bridge.snapshotEffectRows, snapshotEffectRow)
            add(bridge.effectBridgeCids,
                loweringExternFfiHandleCapabilityEffectBridgeCid(
                    bridge, plan, callRow, effectRow))
        add(bridge.callBridgeCids,
            loweringExternFfiHandleCapabilityCallBridgeCid(
                bridge, plan, callRow))
    bridge.snapshotBound = true
    bridge.bridgeCid =
        loweringExternFfiHandleCapabilityBridgeCid(
            bridge, plan)
    if !loweringExternFfiHandleCallCapabilityBridgeStrictValidate(
           bridge, plan, err):
        return loweringExternFfiHandleCapabilityBridgeMovedFail(
            bridge, plan, err, "")
    plan.externFfiHandleCallCapabilityBridge = bridge
    bridge = LoweringExternFfiHandleCallCapabilityBridge()
    err = ""
    return true

@borrows
fn loweringManualConsumeBridgeCid(
        tokenCid: layout.FixedBytes32,
        snapshotCallId: int32,
        calleeFunctionId: int32,
        interfaceCid: layout.FixedBytes32,
        canonicalEffectCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(160)
    let domain = "cheng.lowering.manual_consume_call_bridge"
    loweringManualConsumeBridgeAppendI32(buf, domain.len)
    for byteIndex in 0..<domain.len:
        layout.ByteBufAppendByte(
            buf, Int32(domain[byteIndex]) & 255)
    layout.ByteBufAppendFixed32(buf, tokenCid)
    loweringManualConsumeBridgeAppendI32(buf, snapshotCallId)
    loweringManualConsumeBridgeAppendI32(buf, calleeFunctionId)
    layout.ByteBufAppendFixed32(buf, interfaceCid)
    layout.ByteBufAppendFixed32(buf, canonicalEffectCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn LoweringManualConsumeCallBridgeRelease(
        bridge: var LoweringManualConsumeCallBridge) =
    ccsg.CompilerCsgManualConsumeCallTokenTableRelease(
        bridge.tokens)
    freeSeq(bridge.snapshotCallIds)
    freeSeq(bridge.calleeFunctionIds)
    freeSeq(bridge.calleeInterfaceCids)
    freeSeq(bridge.canonicalEffectCids)
    freeSeq(bridge.bridgeCids)
    bridge = LoweringManualConsumeCallBridge()

@borrows
fn loweringManualConsumeTokenResolvedRowExact(
        plan: LoweringPlanStub,
        tokens: ccsg.CompilerCsgManualConsumeCallTokenTable,
        tokenRow: int32): bool =
    if tokenRow < 0 ||
       tokenRow >= tokens.tokenIds.len:
        return false
    let callRow = tokens.callRows[tokenRow]
    if callRow < 0 ||
       callRow >= plan.resolvedCallSnapshot.sourceIndexes.len ||
       callRow >=
           plan.resolvedCallTargetTypedFunctionIndexes.len:
        return false
    let argumentStart =
        plan.resolvedCallSnapshot.callArgumentStarts[callRow]
    let argumentCount =
        plan.resolvedCallSnapshot.callArgCounts[callRow]
    let targetArgumentRow =
        tokens.targetArgumentRows[tokenRow]
    let sourceArgumentRow =
        tokens.sourceArgumentRows[tokenRow]
    if argumentStart < 0 ||
       argumentCount < 0 ||
       argumentStart >
           plan.resolvedCallSnapshot.callArgumentCallRows.len -
               argumentCount ||
       targetArgumentRow < argumentStart ||
       targetArgumentRow >= argumentStart + argumentCount ||
       sourceArgumentRow < argumentStart ||
       sourceArgumentRow >= argumentStart + argumentCount:
        return false
    return tokens.callerTypedFunctionIndexes[tokenRow] ==
               plan.resolvedCallSnapshot.functionIndexes[callRow] &&
           tokens.callExprNodeIndexes[tokenRow] ==
               plan.resolvedCallSnapshot.typedCallNodeIndexes[
                   callRow] &&
           tokens.calleeFunctionIndexes[tokenRow] ==
               plan.resolvedCallTargetTypedFunctionIndexes[
                   callRow] &&
           plan.resolvedCallSnapshot.callArgumentCallRows[
               targetArgumentRow] == callRow &&
           plan.resolvedCallSnapshot.callArgumentCallRows[
               sourceArgumentRow] == callRow &&
           tokens.targetArgumentOrdinals[tokenRow] ==
               plan.resolvedCallSnapshot.callArgumentOrdinals[
                   targetArgumentRow] &&
           tokens.sourceArgumentOrdinals[tokenRow] ==
               plan.resolvedCallSnapshot.callArgumentOrdinals[
                   sourceArgumentRow] &&
           tokens.targetArgLinkNodeIndexes[tokenRow] ==
               plan.resolvedCallSnapshot.callArgumentArgLinkNodeIndexes[
                       targetArgumentRow] &&
           tokens.sourceArgLinkNodeIndexes[tokenRow] ==
               plan.resolvedCallSnapshot.callArgumentArgLinkNodeIndexes[
                       sourceArgumentRow] &&
           tokens.targetValueNodeIndexes[tokenRow] ==
               plan.resolvedCallSnapshot.callArgumentValueNodeIndexes[
                   targetArgumentRow] &&
           tokens.sourceValueNodeIndexes[tokenRow] ==
               plan.resolvedCallSnapshot.callArgumentValueNodeIndexes[
                   sourceArgumentRow] &&
           tokens.targetParameterDeclarationRows[tokenRow] ==
               plan.resolvedCallSnapshot.callArgumentTargetParameterDeclarationRows[
                       targetArgumentRow] &&
           tokens.sourceParameterDeclarationRows[tokenRow] ==
               plan.resolvedCallSnapshot.callArgumentTargetParameterDeclarationRows[
                       sourceArgumentRow] &&
           plan.resolvedCallSnapshot.callArgumentTargetParameterMutableFlags[
                   targetArgumentRow] &&
           !plan.resolvedCallSnapshot.callArgumentTargetParameterMutableFlags[
                   sourceArgumentRow] &&
           layout.FixedBytes32Equal(
               tokens.targetBindingCids[tokenRow],
               plan.resolvedCallSnapshot.callArgumentBindingCids[
                   targetArgumentRow]) &&
           layout.FixedBytes32Equal(
               tokens.sourceBindingCids[tokenRow],
               plan.resolvedCallSnapshot.callArgumentBindingCids[
                   sourceArgumentRow])

@borrows
fn loweringManualConsumeSnapshotRowExact(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        plan: LoweringPlanStub,
        tokens: ccsg.CompilerCsgManualConsumeCallTokenTable,
        tokenRow: int32,
        snapshotCallId: int32,
        calleeFunctionId: int32): bool =
    if tokenRow < 0 ||
       tokenRow >= tokens.tokenIds.len:
        return false
    let callRow = tokens.callRows[tokenRow]
    let callExprNodeIndex =
        tokens.callExprNodeIndexes[tokenRow]
    if callRow < 0 ||
       callRow >=
           plan.resolvedCallTargetTypedFunctionIndexes.len ||
       callExprNodeIndex < 0 ||
       callExprNodeIndex >=
           plan.snapshotCallIdByTypedIrNodeIndex.len ||
       snapshotCallId < 0 ||
       snapshotCallId >= snapshot.calls.calleeSymbolIds.len ||
       snapshotCallId >= snapshot.calls.callerFunctionIds.len ||
       snapshotCallId >=
           plan.snapshotCallCallerTypedFunctionIndexes.len ||
       snapshotCallId >=
           plan.snapshotCallTargetTypedFunctionIndexes.len ||
       snapshotCallId >=
           plan.snapshotCallResultTypedIrNodeIndexes.len ||
       plan.snapshotCallIdByTypedIrNodeIndex[
           callExprNodeIndex] != snapshotCallId ||
       plan.snapshotCallResultTypedIrNodeIndexes[
           snapshotCallId] != callExprNodeIndex:
        return false
    let callerFunctionId =
        snapshot.calls.callerFunctionIds[snapshotCallId]
    let calleeSymbolId =
        snapshot.calls.calleeSymbolIds[snapshotCallId]
    if callerFunctionId < 0 ||
       callerFunctionId >=
           snapshot.functions.typedFunctionIndexes.len ||
       calleeSymbolId < 0 ||
       calleeSymbolId >= snapshot.symbols.functionIds.len ||
       snapshot.symbols.functionIds[calleeSymbolId] !=
           calleeFunctionId ||
       calleeFunctionId < 0 ||
       calleeFunctionId >=
           snapshot.functions.typedFunctionIndexes.len ||
       calleeFunctionId >=
           snapshot.functions.interfaceCids.len ||
       calleeFunctionId >=
           snapshot.functions.annotationFlags.len:
        return false
    let callerTypedFunctionIndex =
        snapshot.functions.typedFunctionIndexes[callerFunctionId]
    let calleeTypedFunctionIndex =
        snapshot.functions.typedFunctionIndexes[calleeFunctionId]
    var boundCalleeInterfaceCid: layout.FixedBytes32
    if callerTypedFunctionIndex < 0 ||
       callerTypedFunctionIndex !=
           tokens.callerTypedFunctionIndexes[tokenRow] ||
       plan.snapshotCallCallerTypedFunctionIndexes[
           snapshotCallId] != callerTypedFunctionIndex ||
       calleeTypedFunctionIndex < 0 ||
       calleeTypedFunctionIndex !=
           tokens.calleeFunctionIndexes[tokenRow] ||
       plan.resolvedCallTargetTypedFunctionIndexes[callRow] !=
           calleeTypedFunctionIndex ||
       plan.snapshotCallTargetTypedFunctionIndexes[
           snapshotCallId] != calleeTypedFunctionIndex ||
       !LoweringPlanFunctionInterfaceCidAt(
           plan,
           calleeTypedFunctionIndex,
           boundCalleeInterfaceCid) ||
       !layout.FixedBytes32Equal(
           boundCalleeInterfaceCid,
           snapshot.functions.interfaceCids[calleeFunctionId]) ||
       (snapshot.functions.annotationFlags[calleeFunctionId] &
            snapshot_schema.CsgCompilerFunctionAnnotationManualConsume) == 0:
        return false
    return true

@borrows
fn loweringManualConsumeCallBridgeBindFail(
        bridge: var LoweringManualConsumeCallBridge,
        err: var str,
        fallbackReason: str): bool =
    if err == "":
        err = fallbackReason
    LoweringManualConsumeCallBridgeRelease(bridge)
    return false

fn LoweringBindManualConsumeCallBridge(
        snapshot: var snapshot_schema.CsgCompilerSnapshotTables,
        plan: var LoweringPlanStub,
        err: var str): bool =
    if plan.manualConsumeCallBridge.snapshotBound ||
       plan.manualConsumeCallBridge.snapshotCallIds.len != 0 ||
       plan.manualConsumeCallBridge.calleeFunctionIds.len != 0 ||
       plan.manualConsumeCallBridge.calleeInterfaceCids.len != 0 ||
       plan.manualConsumeCallBridge.canonicalEffectCids.len != 0 ||
       plan.manualConsumeCallBridge.bridgeCids.len != 0 ||
       !ccsg.CompilerCsgManualConsumeCallTokenTableExactValidateAgainstInto(
                plan.resolvedCallSnapshot,
                plan.typedIr,
                plan.resolvedCallTargetTypedFunctionIndexes,
                plan.manualConsumeCallBridge.tokens,
                err):
        return loweringManualConsumeCallBridgeBindFail(
            plan.manualConsumeCallBridge,
            err,
            " lowering plan: manual-consume bridge destination invalid")
    let tokenCount = plan.manualConsumeCallBridge.tokens.tokenIds.len
    for tokenRow in 0..<tokenCount:
        let callRow = plan.manualConsumeCallBridge.tokens.callRows[tokenRow]
        let callExprNodeIndex =
            plan.manualConsumeCallBridge.tokens.callExprNodeIndexes[tokenRow]
        if !loweringManualConsumeTokenResolvedRowExact(
               plan, plan.manualConsumeCallBridge.tokens, tokenRow) ||
           callRow < 0 ||
           callRow >=
               plan.resolvedCallTargetTypedFunctionIndexes.len ||
           callExprNodeIndex < 0 ||
           callExprNodeIndex >=
               plan.snapshotCallIdByTypedIrNodeIndex.len:
            err = " lowering plan: manual-consume bridge call identity invalid"
            return loweringManualConsumeCallBridgeBindFail(
                plan.manualConsumeCallBridge, err, "")
        let snapshotCallId =
            plan.snapshotCallIdByTypedIrNodeIndex[
                callExprNodeIndex]
        if snapshotCallId < 0 ||
           snapshotCallId >= snapshot.calls.calleeSymbolIds.len ||
           snapshotCallId >=
               plan.snapshotCallTargetTypedFunctionIndexes.len:
            err = " lowering plan: manual-consume snapshot CallId missing"
            return loweringManualConsumeCallBridgeBindFail(
                plan.manualConsumeCallBridge, err, "")
        let calleeSymbolId =
            snapshot.calls.calleeSymbolIds[snapshotCallId]
        if calleeSymbolId < 0 ||
           calleeSymbolId >= snapshot.symbols.functionIds.len:
            err = " lowering plan: manual-consume callee SymbolId invalid"
            return loweringManualConsumeCallBridgeBindFail(
                plan.manualConsumeCallBridge, err, "")
        let calleeFunctionId =
            snapshot.symbols.functionIds[calleeSymbolId]
        if !loweringManualConsumeSnapshotRowExact(
               snapshot,
               plan,
               plan.manualConsumeCallBridge.tokens,
               tokenRow,
               snapshotCallId,
               calleeFunctionId):
            err =
                " lowering plan: manual-consume snapshot row identity drift"
            return loweringManualConsumeCallBridgeBindFail(
                plan.manualConsumeCallBridge, err, "")
        let interfaceCid =
            snapshot.functions.interfaceCids[calleeFunctionId]
        var canonicalEffectCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerFunctionManualConsumeEffectCidInto(
               snapshot,
               calleeFunctionId,
               canonicalEffectCid,
               err):
            return loweringManualConsumeCallBridgeBindFail(
                plan.manualConsumeCallBridge,
                err,
                " lowering plan: manual-consume canonical effect invalid")
        let bridgeCid = loweringManualConsumeBridgeCid(
            plan.manualConsumeCallBridge.tokens.tokenCids[tokenRow],
            snapshotCallId,
            calleeFunctionId,
            interfaceCid,
            canonicalEffectCid)
        add(plan.manualConsumeCallBridge.snapshotCallIds, snapshotCallId)
        add(plan.manualConsumeCallBridge.calleeFunctionIds, calleeFunctionId)
        add(plan.manualConsumeCallBridge.calleeInterfaceCids,
            layout.FixedBytes32Copy(interfaceCid))
        add(plan.manualConsumeCallBridge.canonicalEffectCids,
            layout.FixedBytes32Copy(canonicalEffectCid))
        add(plan.manualConsumeCallBridge.bridgeCids, bridgeCid)
    plan.manualConsumeCallBridge.snapshotBound = true
    err = ""
    return true

@borrows
fn LoweringManualConsumeCallBridgeStrictValidateInto(
        snapshot: snapshot_schema.CsgCompilerSnapshotTables,
        plan: var LoweringPlanStub,
        err: var str): bool =
    let count = plan.manualConsumeCallBridge.tokens.tokenIds.len
    if !plan.manualConsumeCallBridge.snapshotBound ||
       plan.manualConsumeCallBridge.snapshotCallIds.len != count ||
       plan.manualConsumeCallBridge.calleeFunctionIds.len != count ||
       plan.manualConsumeCallBridge.calleeInterfaceCids.len != count ||
       plan.manualConsumeCallBridge.canonicalEffectCids.len != count ||
       plan.manualConsumeCallBridge.bridgeCids.len != count ||
       !ccsg.CompilerCsgManualConsumeCallTokenTableExactValidateAgainstInto(
                plan.resolvedCallSnapshot,
                plan.typedIr,
                plan.resolvedCallTargetTypedFunctionIndexes,
                plan.manualConsumeCallBridge.tokens,
                err):
        if err == "":
            err = " lowering plan: manual-consume bridge shape invalid"
        return false
    for tokenRow in 0..<count:
        if !loweringManualConsumeTokenResolvedRowExact(
               plan,
               plan.manualConsumeCallBridge.tokens,
               tokenRow):
            err =
                " lowering plan: manual-consume resolved row identity drift"
            return false
        let callId =
            plan.manualConsumeCallBridge.snapshotCallIds[tokenRow]
        let functionId =
            plan.manualConsumeCallBridge.calleeFunctionIds[tokenRow]
        if !loweringManualConsumeSnapshotRowExact(
               snapshot,
               plan,
               plan.manualConsumeCallBridge.tokens,
               tokenRow,
               callId,
               functionId):
            err = " lowering plan: manual-consume bridge row invalid"
            return false
        let calleeSymbolId = snapshot.calls.calleeSymbolIds[callId]
        var expectedEffectCid: layout.FixedBytes32
        if calleeSymbolId < 0 ||
           calleeSymbolId >= snapshot.symbols.functionIds.len ||
           snapshot.symbols.functionIds[calleeSymbolId] != functionId ||
           !snapshot_schema.CsgCompilerFunctionManualConsumeEffectCidInto(
               snapshot,
               functionId,
               expectedEffectCid,
               err) ||
           !layout.FixedBytes32Equal(
               plan.manualConsumeCallBridge.
                   calleeInterfaceCids[tokenRow],
               snapshot.functions.interfaceCids[functionId]) ||
           !layout.FixedBytes32Equal(
               plan.manualConsumeCallBridge.
                   canonicalEffectCids[tokenRow],
               expectedEffectCid) ||
           !layout.FixedBytes32Equal(
               plan.manualConsumeCallBridge.bridgeCids[tokenRow],
               loweringManualConsumeBridgeCid(
                   plan.manualConsumeCallBridge.tokens.tokenCids[tokenRow],
                   callId,
                   functionId,
                   plan.manualConsumeCallBridge.
                       calleeInterfaceCids[tokenRow],
                   plan.manualConsumeCallBridge.
                       canonicalEffectCids[tokenRow])):
            if err == "":
                err = " lowering plan: manual-consume bridge CID drift"
            return false
    err = ""
    return true

@borrows
fn loweringBodyIrParamPhysicalSlot(
        bodyIR: coreir.BodyIR,
        paramOrdinal: int32): int32 =
    if paramOrdinal < 0 || paramOrdinal > 2147483646:
        return -1
    if paramOrdinal >= bodyIR.entryParameterSlotIds.len:
        return -1
    let slotId = bodyIR.entryParameterSlotIds[paramOrdinal]
    if slotId < 0 || slotId >= bodyIR.localSlots.len ||
       bodyIR.localSlots[slotId].stackOffset !=
           0 - 1 - paramOrdinal:
        panic("lowering manual-consume: parameter index drift")
    return slotId

@borrows
fn LoweringBodyIrFreezeEntryDefinitionOwnership(
        bodyIR: var coreir.BodyIR,
        plan: var LoweringPlanStub,
        transport: LoweringOwnershipTransportSoA,
        typedFunctionIndex: int32) =
    let typedIr = plan.typedIr
    if !bodyIR.controlFlowSealed ||
       bodyIR.controlFunctionRow != typedFunctionIndex ||
       bodyIR.entryDefinitionOwnershipSealed ||
       !transport.complete ||
       transport.typedFunctionIndex != typedFunctionIndex ||
       !LoweringOwnershipTransportShapeComplete(transport) ||
       !LoweringOwnershipTransportDefinitionCsrExact(transport) ||
       !coreir.BodyIREntryParameterSlotsShapeValid(bodyIR) ||
       !layout.FixedBytes32Equal(
           transport.typeArenaArtifactCid,
           plan.typeArenaArtifactCid):
        panic("lowering manual-consume: entry ownership source invalid")
    var ownershipKinds: int32[]
    var semanticRows: int32[]
    var claimed: bool[]
    for _ in 0..<bodyIR.localSlots.len:
        add(ownershipKinds, int32(coreir.OwnInvalid))
        add(semanticRows, -1)
        add(claimed, false)
    for row in 0..<transport.definitionRows.len:
        if transport.originKinds[row] !=
               int32(texpr.TypedExprValueDefinitionOriginParameter):
            continue
        let nodeIndex = transport.definingNodeIndexes[row]
        if nodeIndex < 0 ||
           nodeIndex >= typedIr.nodes2_nodeIndexs.len ||
           typedIr.nodes2_opKinds[nodeIndex] !=
               texpr.TypedExprIrOpParamRef:
            panic("lowering manual-consume: parameter node identity invalid")
        let paramOrdinal = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_paramSlots,
            nodeIndex)
        let slotId = loweringBodyIrParamPhysicalSlot(
            bodyIR, paramOrdinal)
        if slotId < 0:
            panic("lowering manual-consume: parameter physical slot missing")
        if claimed[slotId]:
            panic("lowering manual-consume: parameter physical slot claimed")
        let exactTypeId = transport.exactTypeIds[row]
        let managed = transport.managedFlags[row]
        let managedKind = managed ?
            coreir.BodyManagedStorageManagedTag :
            coreir.BodyManagedStorageUnmanagedTag
        if exactTypeId < 0 ||
           !coreir.BodyIRBindTypeArenaArtifactCid(
               bodyIR, transport.typeArenaArtifactCid) ||
           !managedreplace.ManagedLvalueReplaceProductionBindTypeClosure(
               bodyIR,
               plan.typeArenaArtifactCid,
               exactTypeId,
               plan.typeArenaStructuralKinds,
               plan.typeArenaScalarKinds,
               plan.typeArenaChildTypeIds,
               plan.typeArenaFixedLengths,
               plan.typeArenaSizeBytes,
               plan.typeArenaAlignBytes) ||
           !coreir.BodyIRBindLocalSlotTypeArenaProof(
               bodyIR,
               slotId,
               transport.typeArenaArtifactCid,
               exactTypeId,
               managedKind):
            panic("lowering manual-consume: parameter exact TypeId bind failed")
        let ownership = transport.ownershipKinds[row]
        let mutableFlag =
            typedIr.nodes2_paramMutableFlags[nodeIndex]
        # [w77] Freeze-side mirror of the [w61] canonical borrowed-view
        # parameter admission arm on the transport build side.  A `var T`
        # parameter over a managed T is stamped Borrowed by the typed-expr
        # producer ("a managed parameter is a borrowed place at this node")
        # while its exact arena type is the non-owning BorrowedView whose
        # trait derivation intentionally leaves resultTypeManaged false.
        # The build side admits exactly that conjunction and appends the
        # row verbatim, so the freeze projection must admit the same
        # conjunction or every such function is rejected here.  All eight
        # fingerprint columns are producer-exact facts already readable on
        # this side (three via the transport SoA, three via the same
        # typed-IR arena columns the build side reads, plus the ParamRef op
        # already enforced at the loop head); any other shape keeps the
        # original panic.  The admitted row freezes exactly like the
        # managed Borrowed arm below: mutable (every reachable row is a
        # `var` view) as OwnBorrowUnique, an immutable borrowed view would
        # take that arm's shared branch.
        let canonicalBorrowedViewParameter =
            !managed &&
            ownership == texpr.TypedExprExprBorrowed &&
            transport.originKinds[row] ==
                int32(texpr.TypedExprValueDefinitionOriginParameter) &&
            typedIr.nodes2_opKinds[nodeIndex] ==
                texpr.TypedExprIrOpParamRef &&
            arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_originParserNodeIds,
                nodeIndex) == -1 &&
            arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_syntheticOriginKinds,
                nodeIndex) ==
                texpr.TypedExprSyntheticOriginParameter &&
            arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_spanAuthorityKinds,
                nodeIndex) ==
                texpr.TypedExprSpanAuthorityNoSource &&
            transport.proofKinds[row] ==
                texpr.TypedExprSnapshotTypeProofReference
        var bodyOwnership = coreir.OwnInvalid
        if !managed:
            if ownership != texpr.TypedExprExprUnmanaged &&
               !canonicalBorrowedViewParameter:
                # [w77] Diagnostic enrichment only: pass/fail boundary is
                # unchanged; the original text stays as the prefix and the
                # payload carries the admitted-conjunction witness columns.
                panic(Fmt"lowering manual-consume: unmanaged parameter ownership invalid row={transport.definitionRows[row]} node={nodeIndex} origin={transport.originKinds[row]} ownership={Int32(ownership)} managed={managed} mutable={mutableFlag} op={Int32(typedIr.nodes2_opKinds[nodeIndex])} proof={transport.proofKinds[row]} tfn={typedFunctionIndex}")
            if canonicalBorrowedViewParameter:
                if mutableFlag:
                    bodyOwnership = coreir.OwnBorrowUnique
                else:
                    bodyOwnership = coreir.OwnBorrowShared
            else:
                bodyOwnership = coreir.OwnPlain
        elif ownership == texpr.TypedExprExprOwned:
            if mutableFlag:
                panic("lowering manual-consume: mutable managed parameter is owned")
            bodyOwnership = coreir.OwnMove
        elif ownership == texpr.TypedExprExprBorrowed:
            if mutableFlag:
                bodyOwnership = coreir.OwnBorrowUnique
            else:
                bodyOwnership = coreir.OwnBorrowShared
        else:
            panic("lowering manual-consume: managed parameter ownership unavailable")
        ownershipKinds[slotId] = int32(bodyOwnership)
        if int32(bodyOwnership) == int32(coreir.OwnPlain) ||
           int32(bodyOwnership) == int32(coreir.OwnInvalid):
            semanticRows[slotId] = -1
        else:
            semanticRows[slotId] = transport.definitionRows[row]
        claimed[slotId] = true
    coreir.BodyIRFreezeEntryDefinitionAuthority(
        bodyIR, ownershipKinds, semanticRows)
    if !coreir.BodyIREntryDefinitionOwnershipShapeValid(bodyIR):
        panic("lowering manual-consume: entry ownership freeze invalid")

@borrows
fn loweringBodyIrManualPostChainsFrom(
        bodyIR: coreir.BodyIR,
        postRow: int32,
        baseDomain: int32,
        baseRow: int32): bool =
    var currentRow = postRow
    while currentRow >= 0:
        if currentRow >= bodyIR.manualConsume.callOrdinals.len:
            return false
        let domain =
            bodyIR.manualConsume.targetDefinitionDomains[
                currentRow]
        let row =
            bodyIR.manualConsume.targetDefinitionRows[
                currentRow]
        if domain !=
               coreir.BodyDefinitionDomainManualConsumePostCallTag:
            return domain == baseDomain && row == baseRow
        if row < 0 || row >= currentRow:
            return false
        currentRow = row
    return false

@borrows
fn loweringBodyIrDefinitionRefForValueDefinition(
        bodyIR: coreir.BodyIR,
        typedIr: var texpr.TypedExprIr,
        transport: LoweringOwnershipTransportSoA,
        valueDefinitionRow: int32,
        expectedSlotId: int32,
        allowPriorPostDefinition: bool,
        domainOut: var int32,
        rowOut: var int32): bool =
    domainOut = coreir.BodyDefinitionDomainInvalidTag
    rowOut = -1
    if expectedSlotId < 0 ||
       expectedSlotId >= bodyIR.localSlots.len:
        return false
    var transportRow: int32 = -1
    for candidateRow in 0..<transport.definitionRows.len:
        if transport.definitionRows[candidateRow] !=
               valueDefinitionRow:
            continue
        if transportRow >= 0:
            return false
        transportRow = candidateRow
    if transportRow < 0:
        return false
    var baseDomain = coreir.BodyDefinitionDomainInvalidTag
    var baseRow: int32 = -1
    if transport.originKinds[transportRow] ==
           int32(texpr.TypedExprValueDefinitionOriginParameter):
        let nodeIndex = transport.definingNodeIndexes[transportRow]
        if nodeIndex < 0 ||
           nodeIndex >= typedIr.nodes2_nodeIndexs.len ||
           typedIr.nodes2_opKinds[nodeIndex] !=
               texpr.TypedExprIrOpParamRef:
            return false
        let paramOrdinal = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_paramSlots,
            nodeIndex)
        let slotId = loweringBodyIrParamPhysicalSlot(
            bodyIR, paramOrdinal)
        if slotId != expectedSlotId ||
           !bodyIR.entryDefinitionOwnershipSealed ||
           slotId >= bodyIR.entryDefinitionOwnershipKinds.len ||
           bodyIR.entryDefinitionOwnershipKinds[slotId] ==
               int32(coreir.OwnInvalid):
            return false
        baseDomain = coreir.BodyDefinitionDomainEntrySlotTag
        baseRow = slotId
    else:
        for opIndex in 0..<bodyIR.ops.len:
            if bodyIR.ops[opIndex].valueDefSemanticRow !=
                   valueDefinitionRow ||
               bodyIR.ops[opIndex].valueDefSlot != expectedSlotId ||
               bodyIR.ops[opIndex].valueDefOwnership !=
                   coreir.OwnMove:
                continue
            if baseRow >= 0:
                return false
            baseDomain = coreir.BodyDefinitionDomainBodyOpTag
            baseRow = opIndex
        if baseRow < 0:
            return false
    if allowPriorPostDefinition:
        var priorRow = bodyIR.manualConsume.callOrdinals.len - 1
        while priorRow >= 0:
            if bodyIR.manualConsume.targetOwnerSlotIds[priorRow] ==
                   expectedSlotId &&
               bodyIR.manualConsume.postDefinitionDomains[priorRow] ==
                   coreir.BodyDefinitionDomainManualConsumePostCallTag &&
               bodyIR.manualConsume.postDefinitionRows[priorRow] ==
                   priorRow &&
               loweringBodyIrManualPostChainsFrom(
                   bodyIR, priorRow, baseDomain, baseRow):
                domainOut =
                    coreir.BodyDefinitionDomainManualConsumePostCallTag
                rowOut = priorRow
                return true
            priorRow = priorRow - 1
    domainOut = baseDomain
    rowOut = baseRow
    return true

@borrows
fn loweringBodyIrManualConsumeSourceSlot(
        call: coreir.CallOp,
        ordinal: int32): int32 =
    if ordinal < 0 ||
       ordinal >= call.argSlots.len ||
       ordinal >= call.argPassKinds.len:
        return -1
    let passKind = call.argPassKinds[ordinal]
    if passKind == coreir.BodyCallPassStackValueTag:
        return call.argSlots[ordinal]
    if passKind == coreir.BodyCallPassParamAddressTag ||
       passKind == coreir.BodyCallPassByAddressAggregateTag:
        if !coreir.CallArgSlotIsAddress(call.argSlots[ordinal]):
            return -1
        return coreir.CallArgSlotAddressId(
            call.argSlots[ordinal])
    return -1

@borrows
fn LoweringBodyIrProjectManualConsumeEffects(
        bodyIR: var coreir.BodyIR,
        plan: var LoweringPlanStub,
        transport: LoweringOwnershipTransportSoA,
        typedFunctionIndex: int32) =
    LoweringBodyIrFreezeEntryDefinitionOwnership(
        bodyIR, plan, transport, typedFunctionIndex)
    var manualConsumeTokenErr: str
    if !plan.manualConsumeCallBridge.snapshotBound ||
       !ccsg.CompilerCsgManualConsumeCallTokenTableStrictValidateInto(
           plan.manualConsumeCallBridge.tokens,
           manualConsumeTokenErr):
        panic(Fmt"lowering manual-consume: canonical token bridge invalid:{manualConsumeTokenErr}")
    var expectedCount: int32
    for tokenRow in 0..<
            plan.manualConsumeCallBridge.tokens.tokenIds.len:
        if plan.manualConsumeCallBridge.tokens.callerTypedFunctionIndexes[tokenRow] ==
               typedFunctionIndex:
            expectedCount = expectedCount + 1
    if expectedCount == 0:
        return
    for callOrdinal in 0..<bodyIR.callSequence.len:
        var tokenRow: int32 = -1
        for candidateRow in 0..<
                plan.manualConsumeCallBridge.tokens.tokenIds.len:
            if plan.manualConsumeCallBridge.tokens.callerTypedFunctionIndexes[
                   candidateRow] != typedFunctionIndex ||
               plan.manualConsumeCallBridge.tokens.callExprNodeIndexes[candidateRow] !=
                   bodyIR.callSequence[
                       callOrdinal].semanticCallExprNodeIndex:
                continue
            if tokenRow >= 0:
                panic("lowering manual-consume: duplicate call token")
            tokenRow = candidateRow
        if tokenRow < 0:
            continue
        if callOrdinal >= bodyIR.callTargetDomainKinds.len ||
           callOrdinal >= bodyIR.callTargetRows.len ||
           callOrdinal >= bodyIR.callTargetInterfaceCids.len ||
           bodyIR.callTargetDomainKinds[callOrdinal] !=
               coreir.BodyCallTargetDomainFunctionTag ||
           bodyIR.callTargetRows[callOrdinal] !=
               plan.manualConsumeCallBridge.tokens.calleeFunctionIndexes[tokenRow] ||
           !layout.FixedBytes32Equal(
               bodyIR.callTargetInterfaceCids[callOrdinal],
               plan.manualConsumeCallBridge.calleeInterfaceCids[tokenRow]) ||
           plan.manualConsumeCallBridge.snapshotCallIds[tokenRow] < 0:
            panic("lowering manual-consume: BodyIR call identity drift")
        let targetOrdinal =
            plan.manualConsumeCallBridge.tokens.targetArgumentOrdinals[tokenRow]
        let sourceOrdinal =
            plan.manualConsumeCallBridge.tokens.sourceArgumentOrdinals[tokenRow]
        if targetOrdinal < 0 ||
           targetOrdinal >=
               bodyIR.callSequence[callOrdinal].argSlots.len ||
           targetOrdinal >=
               bodyIR.callSequence[callOrdinal].argPassKinds.len ||
           bodyIR.callSequence[
               callOrdinal].argPassKinds[targetOrdinal] !=
               coreir.BodyCallPassBorrowAddressTag ||
           !coreir.CallArgSlotIsAddress(
               bodyIR.callSequence[
                   callOrdinal].argSlots[targetOrdinal]):
            panic("lowering manual-consume: target place is not an exact borrow")
        let targetPlaceSlotId =
            coreir.CallArgSlotAddressId(
                bodyIR.callSequence[
                    callOrdinal].argSlots[targetOrdinal])
        if targetPlaceSlotId < 0 ||
           targetPlaceSlotId >= bodyIR.localSlots.len:
            panic("lowering manual-consume: target place slot invalid")
        var targetOwnerSlotId = targetPlaceSlotId
        if bodyIR.localSlots[targetPlaceSlotId].placeKind ==
               coreir.BodyPlaceBorrowAddressTag:
            targetOwnerSlotId =
                bodyIR.localSlots[targetPlaceSlotId].auxValue
        let sourceSlotId =
            loweringBodyIrManualConsumeSourceSlot(
                bodyIR.callSequence[callOrdinal],
                sourceOrdinal)
        if targetOwnerSlotId < 0 ||
           targetOwnerSlotId >= bodyIR.localSlots.len ||
           sourceSlotId < 0 ||
           sourceSlotId >= bodyIR.localSlots.len:
            panic("lowering manual-consume: physical owner slot invalid")
        var targetDefinitionDomain: int32
        var targetDefinitionRow: int32
        var sourceDefinitionDomain: int32
        var sourceDefinitionRow: int32
        if !loweringBodyIrDefinitionRefForValueDefinition(
               bodyIR,
               plan.typedIr,
               transport,
               plan.manualConsumeCallBridge.tokens.targetPlaceRootValueDefinitionRows[
                   tokenRow],
               targetOwnerSlotId,
               true,
               targetDefinitionDomain,
               targetDefinitionRow) ||
           !loweringBodyIrDefinitionRefForValueDefinition(
               bodyIR,
               plan.typedIr,
               transport,
               plan.manualConsumeCallBridge.tokens.sourceValueDefinitionRows[tokenRow],
               sourceSlotId,
               false,
               sourceDefinitionDomain,
               sourceDefinitionRow):
            panic("lowering manual-consume: immutable value-definition mapping missing")
        var effect: coreir.BodyIRManualConsumeCallEffect
        effect.callOrdinal = callOrdinal
        effect.snapshotCallId =
            plan.manualConsumeCallBridge.snapshotCallIds[tokenRow]
        effect.targetArgumentOrdinal = targetOrdinal
        effect.sourceArgumentOrdinal = sourceOrdinal
        effect.targetPlaceSlotId = targetPlaceSlotId
        effect.targetOwnerSlotId = targetOwnerSlotId
        effect.sourcePlaceSlotId = sourceSlotId
        effect.targetArgumentBindingCid =
            layout.FixedBytes32Copy(
                plan.manualConsumeCallBridge.tokens.targetBindingCids[tokenRow])
        effect.sourceArgumentBindingCid =
            layout.FixedBytes32Copy(
                plan.manualConsumeCallBridge.tokens.sourceBindingCids[tokenRow])
        effect.targetProjectionCid =
            layout.FixedBytes32Copy(
                plan.manualConsumeCallBridge.tokens.targetProjectionCids[tokenRow])
        effect.sourceProjectionCid =
            layout.FixedBytes32Copy(
                plan.manualConsumeCallBridge.tokens.sourceProjectionCids[tokenRow])
        effect.targetDefinitionDomain = targetDefinitionDomain
        effect.targetDefinitionRow = targetDefinitionRow
        effect.sourceDefinitionDomain = sourceDefinitionDomain
        effect.sourceDefinitionRow = sourceDefinitionRow
        effect.targetTypeArenaTypeId =
            plan.manualConsumeCallBridge.tokens.targetTypeIds[tokenRow]
        effect.sourceTypeArenaTypeId =
            plan.manualConsumeCallBridge.tokens.sourceTypeIds[tokenRow]
        effect.postDefinitionDomain =
            coreir.BodyDefinitionDomainManualConsumePostCallTag
        effect.postDefinitionRow =
            bodyIR.manualConsume.callOrdinals.len
        effect.effectCid =
            layout.FixedBytes32Copy(
                plan.manualConsumeCallBridge.canonicalEffectCids[tokenRow])
        effect.linearTokenCid =
            layout.FixedBytes32Copy(
                plan.manualConsumeCallBridge.tokens.tokenCids[tokenRow])
        effect.bridgeCid =
            layout.FixedBytes32Copy(
                plan.manualConsumeCallBridge.bridgeCids[tokenRow])
        coreir.BodyIRManualConsumeAppendCall(bodyIR, effect)
    if bodyIR.manualConsume.callOrdinals.len != expectedCount:
        panic("lowering manual-consume: call token coverage incomplete")
    coreir.BodyIRManualConsumeSeal(bodyIR)
    if !coreir.BodyIRManualConsumeSidecarShapeValid(bodyIR):
        panic("lowering manual-consume: sealed BodyIR sidecar invalid")

@borrows
fn loweringBodyIrExternFfiHandleCapabilityArgumentSlot(
        call: coreir.CallOp,
        targetKind: int32,
        parameterOrdinal: int32): int32 =
    if targetKind ==
           ccsg.CompilerCsgExternFfiHandleTargetResult:
        if parameterOrdinal != -1 ||
           call.resultPassKind !=
               coreir.BodyCallPassStackValueTag:
            return -1
        return call.resultSlot
    if targetKind !=
           ccsg.CompilerCsgExternFfiHandleTargetParameter ||
       parameterOrdinal < 0 ||
       parameterOrdinal >= call.argSlots.len ||
       parameterOrdinal >= call.argPassKinds.len ||
       call.argPassKinds[parameterOrdinal] !=
           coreir.BodyCallPassStackValueTag ||
       call.argSlots[parameterOrdinal] < 0:
        return -1
    return call.argSlots[parameterOrdinal]

@borrows
fn LoweringBodyIrProjectExternFfiHandleCapabilities(
        bodyIR: var coreir.BodyIR,
        plan: var LoweringPlanStub,
        typedFunctionIndex: int32) =
    if !coreir.BodyIRExternFfiHandleCapabilitySidecarIsCanonicalEmpty(
           bodyIR.externFfiHandleCapabilities):
        panic("lowering ffi handle capability: BodyIR destination not empty")
    var bridgeErr: str
    if !LoweringExternFfiHandleCallCapabilityBridgeStrictValidateInto(
           plan, bridgeErr):
        panic(Fmt"lowering ffi handle capability: canonical bridge invalid:{bridgeErr}")
    let bridge = plan.externFfiHandleCallCapabilityBridge
    let table = bridge.semanticCapabilities
    var expectedCallCount: int32
    var expectedEffectCount: int32
    for semanticCallRow in 0..<table.resolvedCallRows.len:
        if loweringExternFfiHandleCapabilitySemanticI32(
               table,
               table.callerTypedFunctionIndexes,
               semanticCallRow) != typedFunctionIndex:
            continue
        expectedCallCount = expectedCallCount + 1
        expectedEffectCount = expectedEffectCount +
            loweringExternFfiHandleCapabilitySemanticI32(
                table, table.effectCounts, semanticCallRow)
    if expectedCallCount == 0:
        return
    if !bodyIR.controlFlowSealed ||
       bodyIR.controlFunctionRow != typedFunctionIndex ||
       !layout.FixedBytes32Equal(
           bodyIR.typeArenaArtifactCid,
           plan.typeArenaArtifactCid):
        panic("lowering ffi handle capability: BodyIR function authority missing")
    coreir.BodyIRExternFfiHandleCapabilityBegin(
        bodyIR,
        typedFunctionIndex,
        plan.canonicalSnapshotProjectionAuthorityCid,
        bridge.semanticCargoCid,
        bridge.bridgeCid)
    var projectedCallCount: int32
    var projectedEffectCount: int32
    for callOrdinal in 0..<bodyIR.callSequence.len:
        let typedCallNodeIndex =
            bodyIR.callSequence[
                callOrdinal].semanticCallExprNodeIndex
        if typedCallNodeIndex < 0:
            continue
        var semanticCallRow: int32 = -1
        for candidateRow in 0..<table.resolvedCallRows.len:
            if loweringExternFfiHandleCapabilitySemanticI32(
                   table,
                   table.callerTypedFunctionIndexes,
                   candidateRow) != typedFunctionIndex ||
               loweringExternFfiHandleCapabilitySemanticI32(
                   table,
                   table.typedCallNodeIndexes,
                   candidateRow) != typedCallNodeIndex:
                continue
            if semanticCallRow >= 0:
                panic("lowering ffi handle capability: duplicate semantic call")
            semanticCallRow = candidateRow
        if semanticCallRow < 0:
            continue
        let snapshotCallId = bridge.snapshotCallIds[semanticCallRow]
        if snapshotCallId < 0 ||
           snapshotCallId >= plan.snapshotCallIds.len ||
           plan.snapshotCallIds[snapshotCallId] != snapshotCallId ||
           plan.snapshotCallCallerTypedFunctionIndexes[
               snapshotCallId] != typedFunctionIndex ||
           plan.snapshotCallResultTypedIrNodeIndexes[
               snapshotCallId] != typedCallNodeIndex ||
           callOrdinal >= bodyIR.callTargetDomainKinds.len ||
           callOrdinal >= bodyIR.callTargetRows.len ||
           callOrdinal >= bodyIR.callTargetInterfaceCids.len ||
           bodyIR.callTargetDomainKinds[callOrdinal] !=
               coreir.BodyCallTargetDomainExternFunctionTag ||
           bodyIR.callTargetRows[callOrdinal] !=
               plan.snapshotCallTargetExternFunctionIds[
                   snapshotCallId] ||
           !layout.FixedBytes32Equal(
               bodyIR.callTargetInterfaceCids[callOrdinal],
               plan.snapshotCallExternAbiInterfaceCids[
                   snapshotCallId]):
            panic("lowering ffi handle capability: BodyIR call identity drift")
        let semanticContractRow =
            loweringExternFfiHandleCapabilitySemanticI32(
                table, table.contractRows, semanticCallRow)
        let semanticEffectStart =
            loweringExternFfiHandleCapabilitySemanticI32(
                table, table.effectStarts, semanticCallRow)
        let effectCount =
            loweringExternFfiHandleCapabilitySemanticI32(
                table, table.effectCounts, semanticCallRow)
        var callCapability: coreir.BodyIRExternFfiHandleCallCapability
        callCapability.callOrdinal = callOrdinal
        callCapability.semanticCapabilityCallRow =
            semanticCallRow
        callCapability.resolvedCallRow =
            loweringExternFfiHandleCapabilitySemanticI32(
                table, table.resolvedCallRows, semanticCallRow)
        callCapability.snapshotCallId = snapshotCallId
        callCapability.semanticContractRow = semanticContractRow
        callCapability.snapshotContractRow =
            bridge.snapshotContractRows[semanticCallRow]
        callCapability.semanticEffectStart = semanticEffectStart
        callCapability.effectCount = effectCount
        callCapability.callCapabilityCid =
            layout.FixedBytes32Copy(
                table.callCapabilityCids[semanticCallRow])
        callCapability.contractCid =
            layout.FixedBytes32Copy(
                bridge.semanticContractCids[semanticCallRow])
        callCapability.interfaceCid =
            layout.FixedBytes32Copy(
                bridge.semanticInterfaceCids[semanticCallRow])
        callCapability.callBridgeCid =
            layout.FixedBytes32Copy(
                bridge.callBridgeCids[semanticCallRow])
        coreir.BodyIRExternFfiHandleCapabilityAppendCall(
            bodyIR, callCapability)
        for effectOffset in 0..<effectCount:
            let semanticCapabilityEffectRow =
                semanticEffectStart + effectOffset
            let targetKind =
                loweringExternFfiHandleCapabilitySemanticI32(
                    table,
                    table.effectTargetKinds,
                    semanticCapabilityEffectRow)
            let parameterOrdinal =
                loweringExternFfiHandleCapabilitySemanticI32(
                    table,
                    table.effectParameterOrdinals,
                    semanticCapabilityEffectRow)
            let argumentSlotId =
                loweringBodyIrExternFfiHandleCapabilityArgumentSlot(
                    bodyIR.callSequence[callOrdinal],
                    targetKind,
                    parameterOrdinal)
            let exactTypeId =
                loweringExternFfiHandleCapabilitySemanticI32(
                    table,
                    table.effectExactTypeIds,
                    semanticCapabilityEffectRow)
            let typeClosureOk =
                managedreplace.ManagedLvalueReplaceProductionBindTypeClosure(
                        bodyIR,
                        plan.typeArenaArtifactCid,
                        exactTypeId,
                        plan.typeArenaStructuralKinds,
                        plan.typeArenaScalarKinds,
                        plan.typeArenaChildTypeIds,
                        plan.typeArenaFixedLengths,
                        plan.typeArenaSizeBytes,
                        plan.typeArenaAlignBytes)
            let slotProofOk =
                coreir.BodyIRBindLocalSlotTypeArenaProof(
                    bodyIR,
                    argumentSlotId,
                    plan.typeArenaArtifactCid,
                    exactTypeId,
                    coreir.BodyManagedStorageUnmanagedTag)
            if argumentSlotId < 0 || exactTypeId < 0 ||
               !typeClosureOk ||
               !slotProofOk:
                panic("lowering ffi handle capability: exact TypeId slot bind failed")
            let snapshotEffectRow =
                bridge.snapshotEffectRows[
                    semanticCapabilityEffectRow]
            if snapshotEffectRow < 0 ||
               snapshotEffectRow >=
                   plan.snapshotExternFfiHandleEffectContractRows.len:
                panic("lowering ffi handle capability: snapshot effect missing")
            var effectCapability: coreir.BodyIRExternFfiHandleEffectCapability
            effectCapability.semanticCapabilityEffectRow =
                semanticCapabilityEffectRow
            effectCapability.contractEffectRow =
                loweringExternFfiHandleCapabilitySemanticI32(
                    table,
                    table.effectRows,
                    semanticCapabilityEffectRow)
            effectCapability.snapshotEffectRow = snapshotEffectRow
            effectCapability.snapshotEffectContractRow =
                plan.snapshotExternFfiHandleEffectContractRows[
                    snapshotEffectRow]
            effectCapability.effectKind =
                loweringExternFfiHandleCapabilitySemanticI32(
                    table,
                    table.effectKinds,
                    semanticCapabilityEffectRow)
            effectCapability.targetKind = targetKind
            effectCapability.parameterOrdinal = parameterOrdinal
            effectCapability.argumentRow =
                loweringExternFfiHandleCapabilitySemanticI32(
                    table,
                    table.effectArgumentRows,
                    semanticCapabilityEffectRow)
            effectCapability.argumentSlotId = argumentSlotId
            effectCapability.argumentValueNodeIndex =
                loweringExternFfiHandleCapabilitySemanticI32(
                    table,
                    table.effectArgumentValueNodeIndexes,
                    semanticCapabilityEffectRow)
            effectCapability.valueDefinitionRow =
                loweringExternFfiHandleCapabilitySemanticI32(
                    table,
                    table.effectValueDefinitionRows,
                    semanticCapabilityEffectRow)
            effectCapability.generationRootValueDefinitionRow =
                loweringExternFfiHandleCapabilitySemanticI32(
                    table,
                    table.effectGenerationRootValueDefinitionRows,
                    semanticCapabilityEffectRow)
            effectCapability.exactTypeId = exactTypeId
            effectCapability.carrierKind =
                loweringExternFfiHandleCapabilitySemanticI32(
                    table,
                    table.effectCarrierKinds,
                    semanticCapabilityEffectRow)
            effectCapability.argumentBindingCid =
                layout.FixedBytes32Copy(
                    table.effectArgumentBindingCids[
                        semanticCapabilityEffectRow])
            effectCapability.typeCid =
                layout.FixedBytes32Copy(
                    table.effectTypeCids[
                        semanticCapabilityEffectRow])
            effectCapability.generationCid =
                layout.FixedBytes32Copy(
                    table.effectGenerationCids[
                        semanticCapabilityEffectRow])
            effectCapability.definitionLineageCid =
                layout.FixedBytes32Copy(
                    table.effectDefinitionLineageCids[
                        semanticCapabilityEffectRow])
            effectCapability.effectCapabilityCid =
                layout.FixedBytes32Copy(
                    table.effectCapabilityCids[
                        semanticCapabilityEffectRow])
            effectCapability.contractEffectCid =
                layout.FixedBytes32Copy(
                    bridge.semanticEffectCids[
                        semanticCapabilityEffectRow])
            effectCapability.effectBridgeCid =
                layout.FixedBytes32Copy(
                    bridge.effectBridgeCids[
                        semanticCapabilityEffectRow])
            coreir.BodyIRExternFfiHandleCapabilityAppendEffect(
                bodyIR, effectCapability)
            projectedEffectCount = projectedEffectCount + 1
        projectedCallCount = projectedCallCount + 1
    if projectedCallCount != expectedCallCount ||
       projectedEffectCount != expectedEffectCount:
        panic("lowering ffi handle capability: projection coverage incomplete")
    coreir.BodyIRExternFfiHandleCapabilitySeal(bodyIR)
    if !coreir.BodyIRExternFfiHandleCapabilitySidecarShapeValid(
           bodyIR):
        panic("lowering ffi handle capability: sealed BodyIR sidecar invalid")

fn LoweringCanonicalSnapshotExternFfiHandleContractRowForSymbolId(
        snapshot: var snapshot_schema.CsgCompilerSnapshotTables,
        calleeSymbolId: int32): int32 =
    var lower: int32
    var upper =
        snapshot.externFfiHandleContracts.externSymbolIds.len
    var contractRow: int32 = -1
    while lower < upper:
        let candidateRow = lower + (upper - lower) / 2
        let candidateSymbolId =
            snapshot.externFfiHandleContracts.externSymbolIds[
                candidateRow]
        if candidateSymbolId == calleeSymbolId:
            contractRow = candidateRow
            break
        if candidateSymbolId < calleeSymbolId:
            lower = candidateRow + 1
        else:
            upper = candidateRow
    if contractRow >= 0:
        return contractRow
    return -1

fn LoweringPlanFunctionInterfaceBindingsStrictValidateInto(
        snapshot: var snapshot_schema.CsgCompilerSnapshotTables,
        plan: var LoweringPlanStub,
        err: var str): bool =
    if !snapshot_bridge.CompilerSnapshotLoweringAuthorityStrictValidateInto(
           plan.compilerSnapshotLoweringAuthority, err):
        return false
    if layout.FixedBytes32Equal(
           plan.semanticSnapshotFactsRootCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           plan.semanticSnapshotCargoCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           plan.semanticSnapshotLoweringAuthorityCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           plan.semanticSnapshotFactsRootCid,
           snapshot_bridge.CompilerSnapshotLoweringAuthorityFactsRootCid(
               plan.compilerSnapshotLoweringAuthority)) ||
       !layout.FixedBytes32Equal(
           plan.semanticSnapshotCargoCid,
           snapshot_bridge.CompilerSnapshotLoweringAuthorityCargoCid(
               plan.compilerSnapshotLoweringAuthority)) ||
       !layout.FixedBytes32Equal(
           plan.semanticSnapshotLoweringAuthorityCid,
           snapshot_bridge.CompilerSnapshotLoweringAuthorityCid(
               plan.compilerSnapshotLoweringAuthority)):
        err = " lowering plan: compiler snapshot authority binding drift"
        return false
    if plan.semanticSnapshotSchemaVersion !=
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
       plan.semanticSnapshotSchemaVersion != snapshot.schemaVersion ||
       plan.semanticSnapshotEpoch <= 0 ||
       plan.semanticSnapshotEpoch != snapshot.semanticEpoch ||
       !layout.FixedBytes32Equal(
           plan.semanticSnapshotPredecessorReceiptCid,
           snapshot.predecessorReceiptCid):
        err = " lowering plan: canonical snapshot envelope drift"
        return false
    if !loweringPlanFunctionInterfaceProjectionStrictValidateInto(
        snapshot,
        plan.typedIr.functions2_functionNameIds.len,
        plan.snapshotFunctionIdsByTypedFunctionIndex,
        plan.snapshotFunctionFragmentCidsByTypedFunctionIndex,
        plan.interfaceCidByTypedFunctionIndex,
        err):
        return false
    if !snapshot_schema.CsgCompilerExternFfiHandleContractsStrictValidateInto(
           snapshot, err):
        return false
    let callCount = snapshot.calls.callerFunctionIds.len
    let typedNodeCount = plan.typedIr.nodes2_nodeIndexs.len
    let effectCount =
        snapshot.externFfiHandleContracts.effectKinds.len
    if plan.snapshotCallResultTypedIrNodeIndexes.len != callCount ||
       plan.snapshotCallCallerTypedFunctionIndexes.len != callCount ||
       plan.snapshotCallIds.len != callCount ||
       plan.snapshotCallCalleeSymbolIds.len != callCount ||
       plan.snapshotCallTargetFunctionIds.len != callCount ||
       plan.snapshotCallTargetExternFunctionIds.len != callCount ||
       plan.snapshotCallTargetTypedFunctionIndexes.len != callCount ||
       plan.snapshotCallExternAbiInterfaceCids.len != callCount ||
       plan.snapshotCallExternFfiHandleContractRows.len != callCount ||
       plan.snapshotCallExternFfiHandleFunctionSymbolCids.len != callCount ||
       plan.snapshotCallExternFfiHandleParserProvenanceCids.len != callCount ||
       plan.snapshotCallExternFfiHandleContractCids.len != callCount ||
       plan.snapshotCallExternFfiHandleInterfaceCids.len != callCount ||
       plan.snapshotCallExternFfiHandleUnwindKinds.len != callCount ||
       plan.snapshotCallExternFfiHandleEffectStarts.len != callCount ||
       plan.snapshotCallExternFfiHandleEffectCounts.len != callCount ||
       plan.snapshotExternFfiHandleEffectContractRows.len != effectCount ||
       plan.snapshotExternFfiHandleEffectKinds.len != effectCount ||
       plan.snapshotExternFfiHandleEffectTargetKinds.len != effectCount ||
       plan.snapshotExternFfiHandleEffectParameterOrdinals.len != effectCount ||
       plan.snapshotExternFfiHandleEffectParameterSymbolCids.len != effectCount ||
       plan.snapshotExternFfiHandleEffectTypeCids.len != effectCount ||
       plan.snapshotExternFfiHandleEffectAbiCarrierKinds.len != effectCount ||
       plan.snapshotExternFfiHandleEffectCids.len != effectCount ||
       plan.snapshotCallResultValueDefinitionRows.len != callCount ||
       plan.snapshotCallIdByTypedIrNodeIndex.len != typedNodeCount ||
       plan.snapshotValueDefinitionTypedFunctionIndexes.len !=
           snapshot.valueDefinitions.functionIds.len:
        err = " lowering plan: canonical snapshot call/value bridge shape drift"
        return false
    if !layout.FixedBytes32Equal(
           plan.snapshotExternFfiHandleCargoCid,
           snapshot.externFfiHandleContracts.cargoCid):
        err = " lowering plan: canonical snapshot ffi handle cargo drift"
        return false
    if !LoweringCanonicalSnapshotFunctionMerkleTableStrictValid(plan) ||
       !layout.FixedBytes32Equal(
           LoweringCanonicalSnapshotProjectionRemainderCid(plan),
           plan.canonicalSnapshotProjectionRemainderCid):
        err = " lowering plan: canonical snapshot merkle table drift"
        return false
    let expectedProjectionAuthorityCid =
        LoweringCanonicalSnapshotProjectionAuthorityCid(plan)
    if layout.FixedBytes32Equal(
           plan.canonicalSnapshotProjectionAuthorityCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           plan.canonicalSnapshotProjectionAuthorityCid,
           expectedProjectionAuthorityCid) ||
       !snapshot_bridge.CompilerSnapshotLoweringAuthorityFunctionProjectionMatchesInto(
           plan.compilerSnapshotLoweringAuthority,
           plan.canonicalSnapshotProjectionAuthorityCid,
           err):
        if err.len == 0:
            err =
                " lowering plan: canonical snapshot projection authority drift"
        return false
    for effectRow in 0..<effectCount:
        if plan.snapshotExternFfiHandleEffectContractRows[effectRow] !=
               snapshot.externFfiHandleContracts.effectContractRows[
                   effectRow] ||
           plan.snapshotExternFfiHandleEffectKinds[effectRow] !=
               snapshot.externFfiHandleContracts.effectKinds[effectRow] ||
           plan.snapshotExternFfiHandleEffectTargetKinds[effectRow] !=
               snapshot.externFfiHandleContracts.effectTargetKinds[
                   effectRow] ||
           plan.snapshotExternFfiHandleEffectParameterOrdinals[effectRow] !=
               snapshot.externFfiHandleContracts.effectParameterOrdinals[
                   effectRow] ||
           !layout.FixedBytes32Equal(
               plan.snapshotExternFfiHandleEffectParameterSymbolCids[
                   effectRow],
               snapshot.externFfiHandleContracts.effectParameterSymbolCids[effectRow]) ||
           !layout.FixedBytes32Equal(
               plan.snapshotExternFfiHandleEffectTypeCids[effectRow],
               snapshot.externFfiHandleContracts.effectTypeCids[
                   effectRow]) ||
           plan.snapshotExternFfiHandleEffectAbiCarrierKinds[effectRow] !=
               snapshot.externFfiHandleContracts.effectAbiCarrierKinds[
                   effectRow] ||
           !layout.FixedBytes32Equal(
               plan.snapshotExternFfiHandleEffectCids[effectRow],
               snapshot.externFfiHandleContracts.effectCids[effectRow]):
            err = " lowering plan: canonical snapshot ffi handle effect drift"
            return false
    for typedIrNodeIndex in 0..<typedNodeCount:
        let callId =
            plan.snapshotCallIdByTypedIrNodeIndex[typedIrNodeIndex]
        if callId >= 0 &&
           (callId >= callCount ||
            plan.snapshotCallResultTypedIrNodeIndexes[callId] !=
                typedIrNodeIndex):
            err =
                " lowering plan: canonical snapshot CallId reverse index drift"
            return false
    let zeroCid = layout.FixedBytes32()
    for callId in 0..<callCount:
        let callerFunctionId =
            snapshot.calls.callerFunctionIds[callId]
        let calleeSymbolId =
            snapshot.calls.calleeSymbolIds[callId]
        let resultTypedNodeId =
            snapshot.calls.resultTypedNodeIds[callId]
        if callerFunctionId < 0 ||
           callerFunctionId >=
               snapshot.functions.typedFunctionIndexes.len ||
           calleeSymbolId < 0 ||
           calleeSymbolId >= snapshot.symbols.functionIds.len ||
           resultTypedNodeId < 0 ||
           resultTypedNodeId >=
               snapshot.typedNodes.typedIrNodeIndexes.len:
            err =
                " lowering plan: canonical snapshot call identity invalid"
            return false
        let resultTypedIrNodeIndex =
            snapshot.typedNodes.typedIrNodeIndexes[resultTypedNodeId]
        let targetFunctionId =
            plan.snapshotCallTargetFunctionIds[callId]
        let targetExternFunctionId =
            plan.snapshotCallTargetExternFunctionIds[callId]
        let targetTypedFunctionIndex =
            plan.snapshotCallTargetTypedFunctionIndexes[callId]
        let ffiHandleContractRow =
            plan.snapshotCallExternFfiHandleContractRows[callId]
        let ffiHandleEffectStart =
            plan.snapshotCallExternFfiHandleEffectStarts[callId]
        let ffiHandleEffectCount =
            plan.snapshotCallExternFfiHandleEffectCounts[callId]
        let ffiHandleUnwindKind =
            plan.snapshotCallExternFfiHandleUnwindKinds[callId]
        if plan.snapshotCallResultTypedIrNodeIndexes[callId] !=
               resultTypedIrNodeIndex ||
           plan.snapshotCallIds[callId] != callId ||
           plan.snapshotCallCalleeSymbolIds[callId] != calleeSymbolId ||
           resultTypedIrNodeIndex < 0 ||
           resultTypedIrNodeIndex >= typedNodeCount ||
           plan.snapshotCallIdByTypedIrNodeIndex[
               resultTypedIrNodeIndex] != callId ||
           plan.snapshotCallCallerTypedFunctionIndexes[callId] !=
               snapshot.functions.typedFunctionIndexes[
                   callerFunctionId] ||
           (targetFunctionId >= 0) == (targetExternFunctionId >= 0) ||
           snapshot.symbols.functionIds[calleeSymbolId] !=
               targetFunctionId ||
           snapshot.symbols.externFunctionIds[calleeSymbolId] !=
               targetExternFunctionId ||
           (targetExternFunctionId >= 0 &&
            targetTypedFunctionIndex != -1) ||
           plan.snapshotCallResultValueDefinitionRows[callId] !=
               snapshot.calls.resultValueDefinitionRows[callId]:
            err =
                " lowering plan: canonical snapshot call/value identity drift"
            return false
        if targetFunctionId >= 0:
            if targetFunctionId >=
                   snapshot.functions.typedFunctionIndexes.len ||
               snapshot.functions.typedFunctionIndexes[targetFunctionId] !=
                   targetTypedFunctionIndex ||
               !layout.FixedBytes32Equal(
                   plan.snapshotCallExternAbiInterfaceCids[callId],
                   zeroCid) ||
               ffiHandleContractRow != -1 ||
               ffiHandleUnwindKind != 0 ||
               ffiHandleEffectStart != -1 ||
               ffiHandleEffectCount != 0 ||
               !layout.FixedBytes32Equal(
                   plan.snapshotCallExternFfiHandleFunctionSymbolCids[
                       callId], zeroCid) ||
               !layout.FixedBytes32Equal(
                   plan.snapshotCallExternFfiHandleParserProvenanceCids[
                       callId], zeroCid) ||
               !layout.FixedBytes32Equal(
                   plan.snapshotCallExternFfiHandleContractCids[callId],
                   zeroCid) ||
               !layout.FixedBytes32Equal(
                   plan.snapshotCallExternFfiHandleInterfaceCids[callId],
                   zeroCid):
                err =
                    " lowering plan: ordinary call carries extern identity"
                return false
        else:
            if targetExternFunctionId < 0 ||
               targetExternFunctionId >=
                   snapshot.externFunctions.symbolIds.len ||
               snapshot.externFunctions.symbolIds[targetExternFunctionId] !=
                   calleeSymbolId ||
               !layout.FixedBytes32Equal(
                   plan.snapshotCallExternAbiInterfaceCids[callId],
                   snapshot.externFunctions.interfaceCids[
                       targetExternFunctionId]):
                err =
                    " lowering plan: extern call ABI identity drift"
                return false
            let contractRow =
                LoweringCanonicalSnapshotExternFfiHandleContractRowForSymbolId(
                    snapshot, calleeSymbolId)
            if ffiHandleContractRow != contractRow:
                err =
                    " lowering plan: extern call ffi handle row drift"
                return false
            if ffiHandleContractRow < 0:
                if ffiHandleEffectStart != -1 ||
                   ffiHandleEffectCount != 0 ||
                   ffiHandleUnwindKind != 0 ||
                   !layout.FixedBytes32Equal(
                       plan.snapshotCallExternFfiHandleFunctionSymbolCids[
                           callId], zeroCid) ||
                   !layout.FixedBytes32Equal(
                       plan.snapshotCallExternFfiHandleParserProvenanceCids[
                           callId], zeroCid) ||
                   !layout.FixedBytes32Equal(
                       plan.snapshotCallExternFfiHandleContractCids[callId],
                       zeroCid) ||
                   !layout.FixedBytes32Equal(
                       plan.snapshotCallExternFfiHandleInterfaceCids[callId],
                       zeroCid):
                    err =
                        " lowering plan: unannotated extern carries ffi handle identity"
                    return false
            else:
                if snapshot.externFfiHandleContracts.externSymbolIds[
                       contractRow] != calleeSymbolId ||
                   !layout.FixedBytes32Equal(
                       plan.snapshotCallExternFfiHandleFunctionSymbolCids[
                           callId],
                       snapshot.externFfiHandleContracts.functionSymbolCids[
                           contractRow]) ||
                   !layout.FixedBytes32Equal(
                       plan.snapshotCallExternFfiHandleParserProvenanceCids[
                           callId],
                       snapshot.externFfiHandleContracts.parserProvenanceCids[contractRow]) ||
                   !layout.FixedBytes32Equal(
                       plan.snapshotCallExternFfiHandleContractCids[callId],
                       snapshot.externFfiHandleContracts.contractCids[
                           contractRow]) ||
                   !layout.FixedBytes32Equal(
                       plan.snapshotCallExternFfiHandleInterfaceCids[callId],
                       snapshot.externFfiHandleContracts.interfaceCids[
                           contractRow]) ||
                   ffiHandleEffectStart !=
                       snapshot.externFfiHandleContracts.effectStarts[
                           contractRow] ||
                   ffiHandleEffectCount !=
                       snapshot.externFfiHandleContracts.effectCounts[
                           contractRow] ||
                   ffiHandleUnwindKind !=
                       snapshot.externFfiHandleContracts.unwindKinds[
                           contractRow] ||
                   ffiHandleUnwindKind !=
                       snapshot_schema.CsgCompilerExternFfiHandleUnwindNoUnwind ||
                   ffiHandleEffectStart < 0 ||
                   ffiHandleEffectCount <= 0 ||
                   ffiHandleEffectCount > effectCount - ffiHandleEffectStart:
                    err =
                        " lowering plan: extern ffi handle contract drift"
                    return false
    for definitionRow in 0..<
            snapshot.valueDefinitions.functionIds.len:
        let functionId =
            snapshot.valueDefinitions.functionIds[definitionRow]
        if functionId < 0 ||
           functionId >=
               snapshot.functions.typedFunctionIndexes.len ||
           plan.snapshotValueDefinitionTypedFunctionIndexes[
               definitionRow] !=
               snapshot.functions.typedFunctionIndexes[functionId]:
            err =
                " lowering plan: canonical value-definition function identity drift"
            return false
    err = ""
    return true

@borrows
fn LoweringPlanFunctionInterfaceCidAt(
        plan: LoweringPlanStub,
        typedFunctionIndex: int32,
        out: var layout.FixedBytes32): bool =
    if plan.semanticSnapshotSchemaVersion !=
           snapshot_schema.CsgCompilerSnapshotSchemaVersionLatest ||
       plan.semanticSnapshotEpoch <= 0 ||
       layout.FixedBytes32Equal(
           plan.semanticSnapshotPredecessorReceiptCid,
           layout.FixedBytes32()) ||
       typedFunctionIndex < 0 ||
       typedFunctionIndex >=
           plan.interfaceCidByTypedFunctionIndex.len ||
       plan.snapshotFunctionIdsByTypedFunctionIndex.len !=
           plan.interfaceCidByTypedFunctionIndex.len ||
       plan.snapshotFunctionFragmentCidsByTypedFunctionIndex.len !=
           plan.interfaceCidByTypedFunctionIndex.len ||
       plan.snapshotFunctionIdsByTypedFunctionIndex[
           typedFunctionIndex] < 0 ||
       layout.FixedBytes32Equal(
           plan.snapshotFunctionFragmentCidsByTypedFunctionIndex[
               typedFunctionIndex],
           layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           plan.interfaceCidByTypedFunctionIndex[typedFunctionIndex],
           layout.FixedBytes32()) ||
       !LoweringCanonicalSnapshotFunctionMembershipValid(
           plan, typedFunctionIndex):
        return false
    out = plan.interfaceCidByTypedFunctionIndex[typedFunctionIndex]
    return true

@borrows
fn LoweringPlanSnapshotCallIdForTypedIrNodeIndex(
        plan: LoweringPlanStub,
        typedIrNodeIndex: int32): int32 =
    if typedIrNodeIndex < 0 ||
       typedIrNodeIndex >= plan.snapshotCallIdByTypedIrNodeIndex.len:
        return -1
    return plan.snapshotCallIdByTypedIrNodeIndex[typedIrNodeIndex]

@borrows
fn LoweringPlanSnapshotCallTargetTypedFunctionIndexAt(
        plan: LoweringPlanStub,
        callId: int32): int32 =
    if callId < 0 ||
       callId >= plan.snapshotCallTargetTypedFunctionIndexes.len:
        panic("lowering plan: canonical snapshot CallId out of range")
    return plan.snapshotCallTargetTypedFunctionIndexes[callId]

@borrows
fn LoweringBodyIrBindCanonicalCallIdentity(
        bodyIR: var coreir.BodyIR,
        plan: LoweringPlanStub,
        callOrdinal: int32,
        typedIrNodeIndex: int32) =
    if bodyIR.controlFlowSealed ||
       bodyIR.controlFunctionRow < 0 ||
       callOrdinal < 0 ||
       callOrdinal >= bodyIR.callSequence.len ||
       bodyIR.callSequence[callOrdinal].semanticCallExprNodeIndex != -1:
        panic("lowering body ir: canonical call binding state invalid")
    let snapshotCallId =
        LoweringPlanSnapshotCallIdForTypedIrNodeIndex(
            plan, typedIrNodeIndex)
    if snapshotCallId < 0 ||
       snapshotCallId >=
           plan.snapshotCallResultTypedIrNodeIndexes.len ||
       snapshotCallId >=
           plan.snapshotCallCallerTypedFunctionIndexes.len ||
       snapshotCallId >= plan.snapshotCallIds.len ||
       snapshotCallId >= plan.snapshotCallCalleeSymbolIds.len ||
       snapshotCallId >= plan.snapshotCallTargetFunctionIds.len ||
       snapshotCallId >= plan.snapshotCallTargetExternFunctionIds.len ||
       snapshotCallId >=
           plan.snapshotCallTargetTypedFunctionIndexes.len ||
       snapshotCallId >= plan.snapshotCallExternAbiInterfaceCids.len ||
       snapshotCallId >=
           plan.snapshotCallExternFfiHandleContractRows.len ||
       snapshotCallId >=
           plan.snapshotCallExternFfiHandleUnwindKinds.len ||
       snapshotCallId >=
           plan.snapshotCallExternFfiHandleEffectStarts.len ||
       snapshotCallId >=
           plan.snapshotCallExternFfiHandleEffectCounts.len ||
       plan.snapshotCallResultTypedIrNodeIndexes[snapshotCallId] !=
           typedIrNodeIndex ||
       plan.snapshotCallIds[snapshotCallId] != snapshotCallId ||
       plan.snapshotCallCallerTypedFunctionIndexes[snapshotCallId] !=
           bodyIR.controlFunctionRow:
        panic("lowering body ir: canonical CallId identity missing")
    let calleeSymbolId =
        plan.snapshotCallCalleeSymbolIds[snapshotCallId]
    let targetFunctionId =
        plan.snapshotCallTargetFunctionIds[snapshotCallId]
    let targetExternFunctionId =
        plan.snapshotCallTargetExternFunctionIds[snapshotCallId]
    let targetTypedFunctionIndex =
        plan.snapshotCallTargetTypedFunctionIndexes[snapshotCallId]
    if calleeSymbolId < 0 ||
       (targetFunctionId >= 0) == (targetExternFunctionId >= 0):
        panic("lowering body ir: canonical call target partition invalid")
    bodyIR.callSequence[callOrdinal].semanticCallExprNodeIndex = typedIrNodeIndex
    if targetFunctionId >= 0:
        var targetInterfaceCid: layout.FixedBytes32
        if targetTypedFunctionIndex < 0 ||
           bodyIR.callSequence[callOrdinal].targetIsImportc ||
           !LoweringPlanFunctionInterfaceCidAt(
               plan,
               targetTypedFunctionIndex,
               targetInterfaceCid):
            panic("lowering body ir: canonical ordinary call identity missing")
        coreir.BodyIRControlFlowBindCallTarget(
            bodyIR,
            callOrdinal,
            coreir.BodyCallTargetDomainFunctionTag,
            targetTypedFunctionIndex,
            targetInterfaceCid)
    else:
        let zeroCid = layout.FixedBytes32()
        let externAbiInterfaceCid =
            plan.snapshotCallExternAbiInterfaceCids[snapshotCallId]
        let ffiHandleContractRow =
            plan.snapshotCallExternFfiHandleContractRows[snapshotCallId]
        let ffiHandleFunctionSymbolCid =
            plan.snapshotCallExternFfiHandleFunctionSymbolCids[
                snapshotCallId]
        let ffiHandleParserProvenanceCid =
            plan.snapshotCallExternFfiHandleParserProvenanceCids[
                snapshotCallId]
        let ffiHandleContractCid =
            plan.snapshotCallExternFfiHandleContractCids[snapshotCallId]
        let ffiHandleInterfaceCid =
            plan.snapshotCallExternFfiHandleInterfaceCids[snapshotCallId]
        let ffiHandleUnwindKind =
            plan.snapshotCallExternFfiHandleUnwindKinds[snapshotCallId]
        let ffiHandleEffectStart =
            plan.snapshotCallExternFfiHandleEffectStarts[snapshotCallId]
        let ffiHandleEffectCount =
            plan.snapshotCallExternFfiHandleEffectCounts[snapshotCallId]
        if !bodyIR.callSequence[callOrdinal].targetIsImportc ||
           targetTypedFunctionIndex != -1 ||
           layout.FixedBytes32Equal(externAbiInterfaceCid, zeroCid) ||
           layout.FixedBytes32Equal(
               plan.snapshotExternFfiHandleCargoCid, zeroCid):
            panic("lowering body ir: canonical extern call identity missing")
        if layout.FixedBytes32Equal(
               plan.canonicalSnapshotProjectionAuthorityCid, zeroCid):
            panic("lowering body ir: canonical projection authority missing")
        if ffiHandleContractRow < 0:
            if ffiHandleUnwindKind != 0 ||
               ffiHandleEffectStart != -1 ||
               ffiHandleEffectCount != 0 ||
               !layout.FixedBytes32Equal(
                   ffiHandleFunctionSymbolCid, zeroCid) ||
               !layout.FixedBytes32Equal(
                   ffiHandleParserProvenanceCid, zeroCid) ||
               !layout.FixedBytes32Equal(
                   ffiHandleContractCid, zeroCid) ||
               !layout.FixedBytes32Equal(
                   ffiHandleInterfaceCid, zeroCid):
                panic("lowering body ir: unannotated extern identity drift")
        else:
            if ffiHandleUnwindKind !=
                   snapshot_schema.CsgCompilerExternFfiHandleUnwindNoUnwind ||
               layout.FixedBytes32Equal(
                   ffiHandleFunctionSymbolCid, zeroCid) ||
               layout.FixedBytes32Equal(
                   ffiHandleParserProvenanceCid, zeroCid) ||
               layout.FixedBytes32Equal(
                   ffiHandleContractCid, zeroCid) ||
               layout.FixedBytes32Equal(
                   ffiHandleInterfaceCid, zeroCid) ||
               ffiHandleEffectStart < 0 ||
               ffiHandleEffectCount <= 0 ||
               ffiHandleEffectCount >
                   plan.snapshotExternFfiHandleEffectContractRows.len -
                       ffiHandleEffectStart:
                panic("lowering body ir: ffi handle effect identity missing")
            for effectOffset in 0..<ffiHandleEffectCount:
                if plan.snapshotExternFfiHandleEffectContractRows[
                       ffiHandleEffectStart + effectOffset] !=
                       ffiHandleContractRow:
                    panic("lowering body ir: ffi handle effect CSR drift")
        coreir.BodyIRControlFlowBindCallTarget(
            bodyIR,
            callOrdinal,
            coreir.BodyCallTargetDomainExternFunctionTag,
            targetExternFunctionId,
            externAbiInterfaceCid)

@borrows
fn LoweringCanonicalSnapshotProjectionAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.snapshotFunctionIdsByTypedFunctionIndex.cap > 0:
        count = count + 1
    if plan.snapshotFunctionFragmentCidsByTypedFunctionIndex.cap > 0:
        count = count + 1
    if plan.interfaceCidByTypedFunctionIndex.cap > 0: count = count + 1
    if plan.canonicalSnapshotFunctionMerkleNodes.cap > 0:
        count = count + 1
    if plan.snapshotCallResultTypedIrNodeIndexes.cap > 0: count = count + 1
    if plan.snapshotCallIdByTypedIrNodeIndex.cap > 0: count = count + 1
    if plan.snapshotCallCallerTypedFunctionIndexes.cap > 0:
        count = count + 1
    if plan.snapshotCallIds.cap > 0: count = count + 1
    if plan.snapshotCallCalleeSymbolIds.cap > 0: count = count + 1
    if plan.snapshotCallTargetFunctionIds.cap > 0: count = count + 1
    if plan.snapshotCallTargetExternFunctionIds.cap > 0:
        count = count + 1
    if plan.snapshotCallTargetTypedFunctionIndexes.cap > 0:
        count = count + 1
    if plan.snapshotCallExternAbiInterfaceCids.cap > 0:
        count = count + 1
    if plan.snapshotCallExternFfiHandleContractRows.cap > 0:
        count = count + 1
    if plan.snapshotCallExternFfiHandleFunctionSymbolCids.cap > 0:
        count = count + 1
    if plan.snapshotCallExternFfiHandleParserProvenanceCids.cap > 0:
        count = count + 1
    if plan.snapshotCallExternFfiHandleContractCids.cap > 0:
        count = count + 1
    if plan.snapshotCallExternFfiHandleInterfaceCids.cap > 0:
        count = count + 1
    if plan.snapshotCallExternFfiHandleUnwindKinds.cap > 0:
        count = count + 1
    if plan.snapshotCallExternFfiHandleEffectStarts.cap > 0:
        count = count + 1
    if plan.snapshotCallExternFfiHandleEffectCounts.cap > 0:
        count = count + 1
    if plan.snapshotExternFfiHandleEffectContractRows.cap > 0:
        count = count + 1
    if plan.snapshotExternFfiHandleEffectKinds.cap > 0:
        count = count + 1
    if plan.snapshotExternFfiHandleEffectTargetKinds.cap > 0:
        count = count + 1
    if plan.snapshotExternFfiHandleEffectParameterOrdinals.cap > 0:
        count = count + 1
    if plan.snapshotExternFfiHandleEffectParameterSymbolCids.cap > 0:
        count = count + 1
    if plan.snapshotExternFfiHandleEffectTypeCids.cap > 0:
        count = count + 1
    if plan.snapshotExternFfiHandleEffectAbiCarrierKinds.cap > 0:
        count = count + 1
    if plan.snapshotExternFfiHandleEffectCids.cap > 0:
        count = count + 1
    if plan.snapshotCallResultValueDefinitionRows.cap > 0:
        count = count + 1
    if plan.snapshotValueDefinitionTypedFunctionIndexes.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringCanonicalSnapshotProjectionAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(plan.snapshotFunctionIdsByTypedFunctionIndex.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotFunctionFragmentCidsByTypedFunctionIndex.cap) *
            int64(sizeof(layout.FixedBytes32)) +
        int64(plan.interfaceCidByTypedFunctionIndex.cap) *
            int64(sizeof(layout.FixedBytes32)) +
        int64(plan.canonicalSnapshotFunctionMerkleNodes.cap) *
            int64(sizeof(layout.FixedBytes32)) +
        int64(plan.snapshotCallResultTypedIrNodeIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotCallIdByTypedIrNodeIndex.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotCallCallerTypedFunctionIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotCallIds.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotCallCalleeSymbolIds.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotCallTargetFunctionIds.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotCallTargetExternFunctionIds.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotCallTargetTypedFunctionIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotCallExternAbiInterfaceCids.cap) *
            int64(sizeof(layout.FixedBytes32)) +
        int64(plan.snapshotCallExternFfiHandleContractRows.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotCallExternFfiHandleFunctionSymbolCids.cap) *
            int64(sizeof(layout.FixedBytes32)) +
        int64(plan.snapshotCallExternFfiHandleParserProvenanceCids.cap) *
            int64(sizeof(layout.FixedBytes32)) +
        int64(plan.snapshotCallExternFfiHandleContractCids.cap) *
            int64(sizeof(layout.FixedBytes32)) +
        int64(plan.snapshotCallExternFfiHandleInterfaceCids.cap) *
            int64(sizeof(layout.FixedBytes32)) +
        int64(plan.snapshotCallExternFfiHandleUnwindKinds.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotCallExternFfiHandleEffectStarts.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotCallExternFfiHandleEffectCounts.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotExternFfiHandleEffectContractRows.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotExternFfiHandleEffectKinds.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotExternFfiHandleEffectTargetKinds.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotExternFfiHandleEffectParameterOrdinals.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotExternFfiHandleEffectParameterSymbolCids.cap) *
            int64(sizeof(layout.FixedBytes32)) +
        int64(plan.snapshotExternFfiHandleEffectTypeCids.cap) *
            int64(sizeof(layout.FixedBytes32)) +
        int64(plan.snapshotExternFfiHandleEffectAbiCarrierKinds.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotExternFfiHandleEffectCids.cap) *
            int64(sizeof(layout.FixedBytes32)) +
        int64(plan.snapshotCallResultValueDefinitionRows.cap) *
            int64(sizeof(int32)) +
        int64(plan.snapshotValueDefinitionTypedFunctionIndexes.cap) *
            int64(sizeof(int32))

fn LoweringCanonicalSnapshotProjectionSetDomains(
        plan: var LoweringPlanStub,
        typedFunctionCount: int32,
        typedNodeCount: int32) =
    if plan.snapshotFunctionIdsByTypedFunctionIndex.len != 0 ||
       plan.snapshotFunctionFragmentCidsByTypedFunctionIndex.len != 0 ||
       plan.interfaceCidByTypedFunctionIndex.len != 0 ||
       plan.canonicalSnapshotFunctionMerkleNodes.len != 0 ||
       plan.canonicalSnapshotFunctionMerkleLeafBase != 0 ||
       !layout.FixedBytes32Equal(
           plan.canonicalSnapshotFunctionMerkleRootCid,
           layout.FixedBytes32()) ||
       plan.canonicalSnapshotFunctionMerkleSealed ||
       !layout.FixedBytes32Equal(
           plan.canonicalSnapshotProjectionRemainderCid,
           layout.FixedBytes32()) ||
       plan.snapshotCallIdByTypedIrNodeIndex.len != 0 ||
       typedFunctionCount < 0 ||
       typedNodeCount < 0:
        panic("lowering canonical snapshot projection allocator: domain shape drift")
    loweringSequenceAllocatorSetLen(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotFunctionIdsByTypedFunctionIndex,
        typedFunctionCount,
        sizeof(int32))
    loweringSequenceAllocatorSetLen(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotFunctionFragmentCidsByTypedFunctionIndex,
        typedFunctionCount,
        sizeof(layout.FixedBytes32))
    loweringSequenceAllocatorSetLen(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.interfaceCidByTypedFunctionIndex,
        typedFunctionCount,
        sizeof(layout.FixedBytes32))
    for typedFunctionIndex in 0..<typedFunctionCount:
        plan.snapshotFunctionIdsByTypedFunctionIndex[
            typedFunctionIndex] = -1
    loweringSequenceAllocatorSetLen(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallIdByTypedIrNodeIndex,
        typedNodeCount,
        sizeof(int32))
    for typedIrNodeIndex in 0..<typedNodeCount:
        plan.snapshotCallIdByTypedIrNodeIndex[typedIrNodeIndex] = -1

@borrows
fn LoweringCanonicalSnapshotProjectionAppendCallRow(
        plan: var LoweringPlanStub,
        callId: int32,
        calleeSymbolId: int32,
        targetFunctionId: int32,
        targetExternFunctionId: int32,
        targetTypedFunctionIndex: int32,
        externAbiInterfaceCid: layout.FixedBytes32,
        ffiHandleContractRow: int32,
        ffiHandleFunctionSymbolCid: layout.FixedBytes32,
        ffiHandleParserProvenanceCid: layout.FixedBytes32,
        ffiHandleContractCid: layout.FixedBytes32,
        ffiHandleInterfaceCid: layout.FixedBytes32,
        snapshotCallExternFfiHandleUnwindKinds: int32,
        ffiHandleEffectStart: int32,
        ffiHandleEffectCount: int32,
        resultTypedIrNodeIndex: int32,
        callerTypedFunctionIndex: int32,
        resultValueDefinitionRow: int32) =
    let rowCount = plan.snapshotCallResultTypedIrNodeIndexes.len
    if plan.snapshotCallCallerTypedFunctionIndexes.len != rowCount ||
       plan.snapshotCallIds.len != rowCount ||
       plan.snapshotCallCalleeSymbolIds.len != rowCount ||
       plan.snapshotCallTargetFunctionIds.len != rowCount ||
       plan.snapshotCallTargetExternFunctionIds.len != rowCount ||
       plan.snapshotCallTargetTypedFunctionIndexes.len != rowCount ||
       plan.snapshotCallExternAbiInterfaceCids.len != rowCount ||
       plan.snapshotCallExternFfiHandleContractRows.len != rowCount ||
       plan.snapshotCallExternFfiHandleFunctionSymbolCids.len != rowCount ||
       plan.snapshotCallExternFfiHandleParserProvenanceCids.len != rowCount ||
       plan.snapshotCallExternFfiHandleContractCids.len != rowCount ||
       plan.snapshotCallExternFfiHandleInterfaceCids.len != rowCount ||
       plan.snapshotCallExternFfiHandleUnwindKinds.len != rowCount ||
       plan.snapshotCallExternFfiHandleEffectStarts.len != rowCount ||
       plan.snapshotCallExternFfiHandleEffectCounts.len != rowCount ||
       plan.snapshotCallResultValueDefinitionRows.len != rowCount:
        panic("lowering canonical snapshot projection allocator: call row shape drift")
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallResultTypedIrNodeIndexes,
        resultTypedIrNodeIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallCallerTypedFunctionIndexes,
        callerTypedFunctionIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallIds,
        callId,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallCalleeSymbolIds,
        calleeSymbolId,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallTargetFunctionIds,
        targetFunctionId,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallTargetExternFunctionIds,
        targetExternFunctionId,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallTargetTypedFunctionIndexes,
        targetTypedFunctionIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallExternAbiInterfaceCids,
        externAbiInterfaceCid,
        sizeof(layout.FixedBytes32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallExternFfiHandleContractRows,
        ffiHandleContractRow,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallExternFfiHandleFunctionSymbolCids,
        ffiHandleFunctionSymbolCid,
        sizeof(layout.FixedBytes32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallExternFfiHandleParserProvenanceCids,
        ffiHandleParserProvenanceCid,
        sizeof(layout.FixedBytes32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallExternFfiHandleContractCids,
        ffiHandleContractCid,
        sizeof(layout.FixedBytes32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallExternFfiHandleInterfaceCids,
        ffiHandleInterfaceCid,
        sizeof(layout.FixedBytes32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallExternFfiHandleUnwindKinds,
        snapshotCallExternFfiHandleUnwindKinds,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallExternFfiHandleEffectStarts,
        ffiHandleEffectStart,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallExternFfiHandleEffectCounts,
        ffiHandleEffectCount,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotCallResultValueDefinitionRows,
        resultValueDefinitionRow,
        sizeof(int32))

@borrows
fn LoweringCanonicalSnapshotProjectionAppendExternFfiHandleEffectRow(
        plan: var LoweringPlanStub,
        contractRow: int32,
        effectKind: int32,
        targetKind: int32,
        parameterOrdinal: int32,
        parameterSymbolCid: layout.FixedBytes32,
        typeCid: layout.FixedBytes32,
        abiCarrierKind: int32,
        effectCid: layout.FixedBytes32) =
    let rowCount = plan.snapshotExternFfiHandleEffectContractRows.len
    if plan.snapshotExternFfiHandleEffectKinds.len != rowCount ||
       plan.snapshotExternFfiHandleEffectTargetKinds.len != rowCount ||
       plan.snapshotExternFfiHandleEffectParameterOrdinals.len != rowCount ||
       plan.snapshotExternFfiHandleEffectParameterSymbolCids.len != rowCount ||
       plan.snapshotExternFfiHandleEffectTypeCids.len != rowCount ||
       plan.snapshotExternFfiHandleEffectAbiCarrierKinds.len != rowCount ||
       plan.snapshotExternFfiHandleEffectCids.len != rowCount:
        panic("lowering canonical snapshot projection allocator: ffi effect row shape drift")
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotExternFfiHandleEffectContractRows,
        contractRow,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotExternFfiHandleEffectKinds,
        effectKind,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotExternFfiHandleEffectTargetKinds,
        targetKind,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotExternFfiHandleEffectParameterOrdinals,
        parameterOrdinal,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotExternFfiHandleEffectParameterSymbolCids,
        parameterSymbolCid,
        sizeof(layout.FixedBytes32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotExternFfiHandleEffectTypeCids,
        typeCid,
        sizeof(layout.FixedBytes32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotExternFfiHandleEffectAbiCarrierKinds,
        abiCarrierKind,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotExternFfiHandleEffectCids,
        effectCid,
        sizeof(layout.FixedBytes32))

fn loweringCanonicalSnapshotFunctionMerkleLeafBase(
        functionCount: int32): int32 =
    if functionCount < 0:
        panic("lowering canonical snapshot function merkle: negative function count")
    var leafBase: int32 = 1
    while leafBase < functionCount:
        if leafBase > 1073741823:
            panic("lowering canonical snapshot function merkle: tree overflow")
        leafBase = leafBase * 2
    return leafBase

@borrows
fn loweringCanonicalSnapshotFunctionLeafCid(
        plan: LoweringPlanStub,
        typedFunctionIndex: int32): layout.FixedBytes32 =
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >=
           plan.snapshotFunctionIdsByTypedFunctionIndex.len ||
       typedFunctionIndex >=
           plan.snapshotFunctionFragmentCidsByTypedFunctionIndex.len ||
       typedFunctionIndex >=
           plan.interfaceCidByTypedFunctionIndex.len:
        panic("lowering canonical snapshot function merkle: leaf out of range")
    var buf = layout.ByteBufInit(128)
    loweringPlanReleaseAppendText(
        buf,
        "cheng.compiler.lowering_plan.canonical_snapshot_function_leaf")
    loweringPlanReleaseAppendU32Field(buf, typedFunctionIndex)
    loweringPlanReleaseAppendU32Field(
        buf,
        plan.snapshotFunctionIdsByTypedFunctionIndex[typedFunctionIndex])
    layout.ByteBufAppendFixed32(
        buf,
        plan.snapshotFunctionFragmentCidsByTypedFunctionIndex[
            typedFunctionIndex])
    layout.ByteBufAppendFixed32(
        buf, plan.interfaceCidByTypedFunctionIndex[typedFunctionIndex])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn loweringCanonicalSnapshotFunctionPaddingCid(
        functionCount: int32,
        typedFunctionIndex: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(96)
    loweringPlanReleaseAppendText(
        buf,
        "cheng.compiler.lowering_plan.canonical_snapshot_function_padding")
    loweringPlanReleaseAppendU32Field(buf, functionCount)
    loweringPlanReleaseAppendU32Field(buf, typedFunctionIndex)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn loweringCanonicalSnapshotFunctionBranchCid(
        functionCount: int32,
        nodeIndex: int32,
        leftCid: layout.FixedBytes32,
        rightCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(160)
    loweringPlanReleaseAppendText(
        buf,
        "cheng.compiler.lowering_plan.canonical_snapshot_function_branch")
    loweringPlanReleaseAppendU32Field(buf, functionCount)
    loweringPlanReleaseAppendU32Field(buf, nodeIndex)
    layout.ByteBufAppendFixed32(buf, leftCid)
    layout.ByteBufAppendFixed32(buf, rightCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn loweringCanonicalSnapshotFunctionCurrentNodeCid(
        plan: var LoweringPlanStub,
        nodeIndex: int32,
        leafBase: int32): layout.FixedBytes32 =
    let leafStart = leafBase - 1
    if nodeIndex >= leafStart:
        let typedFunctionIndex = nodeIndex - leafStart
        if typedFunctionIndex <
               plan.snapshotFunctionIdsByTypedFunctionIndex.len:
            return loweringCanonicalSnapshotFunctionLeafCid(
                plan, typedFunctionIndex)
        return loweringCanonicalSnapshotFunctionPaddingCid(
            plan.snapshotFunctionIdsByTypedFunctionIndex.len,
            typedFunctionIndex)
    let leftIndex = nodeIndex * 2 + 1
    let rightIndex = leftIndex + 1
    let leftCid = loweringCanonicalSnapshotFunctionCurrentNodeCid(
        plan, leftIndex, leafBase)
    let rightCid = loweringCanonicalSnapshotFunctionCurrentNodeCid(
        plan, rightIndex, leafBase)
    return loweringCanonicalSnapshotFunctionBranchCid(
        plan.snapshotFunctionIdsByTypedFunctionIndex.len,
        nodeIndex,
        leftCid,
        rightCid)

fn LoweringCanonicalSnapshotFunctionMerkleSeal(
        plan: var LoweringPlanStub) =
    let functionCount =
        plan.snapshotFunctionIdsByTypedFunctionIndex.len
    if functionCount !=
           plan.snapshotFunctionFragmentCidsByTypedFunctionIndex.len ||
       functionCount != plan.interfaceCidByTypedFunctionIndex.len ||
       plan.canonicalSnapshotFunctionMerkleNodes.len != 0 ||
       plan.canonicalSnapshotFunctionMerkleLeafBase != 0 ||
       plan.canonicalSnapshotFunctionMerkleSealed ||
       !layout.FixedBytes32Equal(
           plan.canonicalSnapshotFunctionMerkleRootCid,
           layout.FixedBytes32()):
        panic("lowering canonical snapshot function merkle: seal state drift")
    let leafBase =
        loweringCanonicalSnapshotFunctionMerkleLeafBase(functionCount)
    let nodeCount = leafBase + (leafBase - 1)
    loweringSequenceAllocatorSetLen(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.canonicalSnapshotFunctionMerkleNodes,
        nodeCount,
        sizeof(layout.FixedBytes32))
    let leafStart = leafBase - 1
    for typedFunctionIndex in 0..<leafBase:
        let nodeIndex = leafStart + typedFunctionIndex
        if typedFunctionIndex < functionCount:
            plan.canonicalSnapshotFunctionMerkleNodes[nodeIndex] =
                loweringCanonicalSnapshotFunctionLeafCid(
                    plan, typedFunctionIndex)
        else:
            plan.canonicalSnapshotFunctionMerkleNodes[nodeIndex] =
                loweringCanonicalSnapshotFunctionPaddingCid(
                    functionCount, typedFunctionIndex)
    var nodeIndex = leafStart
    while nodeIndex > 0:
        nodeIndex = nodeIndex - 1
        let leftIndex = nodeIndex * 2 + 1
        let rightIndex = leftIndex + 1
        plan.canonicalSnapshotFunctionMerkleNodes[nodeIndex] =
            loweringCanonicalSnapshotFunctionBranchCid(
                functionCount,
                nodeIndex,
                plan.canonicalSnapshotFunctionMerkleNodes[leftIndex],
                plan.canonicalSnapshotFunctionMerkleNodes[rightIndex])
    plan.canonicalSnapshotFunctionMerkleLeafBase = leafBase
    plan.canonicalSnapshotFunctionMerkleRootCid =
        plan.canonicalSnapshotFunctionMerkleNodes[0]
    plan.canonicalSnapshotFunctionMerkleSealed = true

fn LoweringCanonicalSnapshotFunctionMerkleTableStrictValid(
        plan: var LoweringPlanStub): bool =
    let functionCount =
        plan.snapshotFunctionIdsByTypedFunctionIndex.len
    if functionCount !=
           plan.snapshotFunctionFragmentCidsByTypedFunctionIndex.len ||
       functionCount != plan.interfaceCidByTypedFunctionIndex.len ||
       !plan.canonicalSnapshotFunctionMerkleSealed:
        return false
    let leafBase =
        loweringCanonicalSnapshotFunctionMerkleLeafBase(functionCount)
    let nodeCount = leafBase + (leafBase - 1)
    if plan.canonicalSnapshotFunctionMerkleLeafBase != leafBase ||
       plan.canonicalSnapshotFunctionMerkleNodes.len != nodeCount ||
       layout.FixedBytes32Equal(
           plan.canonicalSnapshotFunctionMerkleRootCid,
           layout.FixedBytes32()):
        return false
    let leafStart = leafBase - 1
    for typedFunctionIndex in 0..<leafBase:
        var expectedLeafCid: layout.FixedBytes32
        if typedFunctionIndex < functionCount:
            expectedLeafCid = loweringCanonicalSnapshotFunctionLeafCid(
                plan, typedFunctionIndex)
        else:
            expectedLeafCid =
                loweringCanonicalSnapshotFunctionPaddingCid(
                    functionCount, typedFunctionIndex)
        if !layout.FixedBytes32Equal(
               plan.canonicalSnapshotFunctionMerkleNodes[
                   leafStart + typedFunctionIndex],
               expectedLeafCid):
            return false
    var nodeIndex = leafStart
    while nodeIndex > 0:
        nodeIndex = nodeIndex - 1
        let leftIndex = nodeIndex * 2 + 1
        let rightIndex = leftIndex + 1
        let expectedBranchCid =
            loweringCanonicalSnapshotFunctionBranchCid(
                functionCount,
                nodeIndex,
                plan.canonicalSnapshotFunctionMerkleNodes[leftIndex],
                plan.canonicalSnapshotFunctionMerkleNodes[rightIndex])
        if !layout.FixedBytes32Equal(
               plan.canonicalSnapshotFunctionMerkleNodes[nodeIndex],
               expectedBranchCid):
            return false
    let currentRootCid =
        loweringCanonicalSnapshotFunctionCurrentNodeCid(
            plan, 0, leafBase)
    return layout.FixedBytes32Equal(
               plan.canonicalSnapshotFunctionMerkleNodes[0],
               plan.canonicalSnapshotFunctionMerkleRootCid) &&
        layout.FixedBytes32Equal(
            currentRootCid,
            plan.canonicalSnapshotFunctionMerkleRootCid)

fn LoweringCanonicalSnapshotProjectionRemainderCid(
        plan: var LoweringPlanStub): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(4096)
    loweringPlanReleaseAppendText(
        buf,
        "cheng.compiler.lowering_plan.canonical_snapshot_projection_remainder")
    loweringPlanReleaseAppendU32Field(
        buf, plan.semanticSnapshotSchemaVersion)
    loweringPlanReleaseAppendI64Field(
        buf, plan.semanticSnapshotEpoch)
    layout.ByteBufAppendFixed32(
        buf, plan.semanticSnapshotPredecessorReceiptCid)
    layout.ByteBufAppendFixed32(
        buf, plan.semanticSnapshotFactsRootCid)
    layout.ByteBufAppendFixed32(
        buf, plan.semanticSnapshotCargoCid)
    layout.ByteBufAppendFixed32(
        buf, plan.semanticSnapshotLoweringAuthorityCid)
    loweringPlanReleaseAppendU32Field(
        buf, plan.toolchainEncoderBuildProjectionReady ? 1 : 0)
    layout.ByteBufAppendFixed32(
        buf, plan.toolchainEncoderBuildProjection.receiptCid)
    layout.ByteBufAppendFixed32(
        buf, plan.toolchainEncoderCargoObjectReceipt.receiptCid)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotCallResultTypedIrNodeIndexes)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotCallIdByTypedIrNodeIndex)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotCallCallerTypedFunctionIndexes)
    loweringPlanReleaseAppendInt32s(buf, plan.snapshotCallIds)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotCallCalleeSymbolIds)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotCallTargetFunctionIds)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotCallTargetExternFunctionIds)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotCallTargetTypedFunctionIndexes)
    loweringPlanReleaseAppendFixed32s(
        buf, plan.snapshotCallExternAbiInterfaceCids)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotCallExternFfiHandleContractRows)
    loweringPlanReleaseAppendFixed32s(
        buf, plan.snapshotCallExternFfiHandleFunctionSymbolCids)
    loweringPlanReleaseAppendFixed32s(
        buf, plan.snapshotCallExternFfiHandleParserProvenanceCids)
    loweringPlanReleaseAppendFixed32s(
        buf, plan.snapshotCallExternFfiHandleContractCids)
    loweringPlanReleaseAppendFixed32s(
        buf, plan.snapshotCallExternFfiHandleInterfaceCids)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotCallExternFfiHandleUnwindKinds)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotCallExternFfiHandleEffectStarts)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotCallExternFfiHandleEffectCounts)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotExternFfiHandleEffectContractRows)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotExternFfiHandleEffectKinds)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotExternFfiHandleEffectTargetKinds)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotExternFfiHandleEffectParameterOrdinals)
    loweringPlanReleaseAppendFixed32s(
        buf, plan.snapshotExternFfiHandleEffectParameterSymbolCids)
    loweringPlanReleaseAppendFixed32s(
        buf, plan.snapshotExternFfiHandleEffectTypeCids)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotExternFfiHandleEffectAbiCarrierKinds)
    loweringPlanReleaseAppendFixed32s(
        buf, plan.snapshotExternFfiHandleEffectCids)
    layout.ByteBufAppendFixed32(
        buf, plan.snapshotExternFfiHandleCargoCid)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotCallResultValueDefinitionRows)
    loweringPlanReleaseAppendInt32s(
        buf, plan.snapshotValueDefinitionTypedFunctionIndexes)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn LoweringCanonicalSnapshotProjectionAuthorityCid(
        plan: LoweringPlanStub): layout.FixedBytes32 =
    if !plan.canonicalSnapshotFunctionMerkleSealed ||
       plan.canonicalSnapshotFunctionMerkleLeafBase <= 0 ||
       layout.FixedBytes32Equal(
           plan.canonicalSnapshotFunctionMerkleRootCid,
           layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           plan.canonicalSnapshotProjectionRemainderCid,
           layout.FixedBytes32()):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(192)
    loweringPlanReleaseAppendText(
        buf,
        "cheng.compiler.lowering_plan.canonical_snapshot_projection_merkle")
    loweringPlanReleaseAppendU32Field(
        buf, plan.snapshotFunctionIdsByTypedFunctionIndex.len)
    loweringPlanReleaseAppendU32Field(
        buf, plan.canonicalSnapshotFunctionMerkleLeafBase)
    layout.ByteBufAppendFixed32(
        buf, plan.canonicalSnapshotFunctionMerkleRootCid)
    layout.ByteBufAppendFixed32(
        buf, plan.canonicalSnapshotProjectionRemainderCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn LoweringCanonicalSnapshotFunctionMembershipValid(
        plan: LoweringPlanStub,
        typedFunctionIndex: int32): bool =
    let functionCount =
        plan.snapshotFunctionIdsByTypedFunctionIndex.len
    let leafBase = plan.canonicalSnapshotFunctionMerkleLeafBase
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >= functionCount ||
       functionCount !=
           plan.snapshotFunctionFragmentCidsByTypedFunctionIndex.len ||
       functionCount != plan.interfaceCidByTypedFunctionIndex.len ||
       !plan.canonicalSnapshotFunctionMerkleSealed ||
       leafBase <= 0 ||
       leafBase !=
           loweringCanonicalSnapshotFunctionMerkleLeafBase(functionCount):
        return false
    let nodeCount = leafBase + (leafBase - 1)
    var authorityErr: str
    let projectionAuthorityOk =
        layout.FixedBytes32Equal(
            LoweringCanonicalSnapshotProjectionAuthorityCid(plan),
            plan.canonicalSnapshotProjectionAuthorityCid)
    let authorityStrictOk =
        snapshot_bridge.CompilerSnapshotLoweringAuthorityStrictValidateInto(
            plan.compilerSnapshotLoweringAuthority, authorityErr)
    let functionProjectionOk =
        snapshot_bridge.CompilerSnapshotLoweringAuthorityFunctionProjectionMatchesInto(
            plan.compilerSnapshotLoweringAuthority,
            plan.canonicalSnapshotProjectionAuthorityCid,
            authorityErr)
    if plan.canonicalSnapshotFunctionMerkleNodes.len != nodeCount ||
       !projectionAuthorityOk ||
       !authorityStrictOk ||
       !functionProjectionOk:
        return false
    var nodeIndex = (leafBase - 1) + typedFunctionIndex
    var currentCid = loweringCanonicalSnapshotFunctionLeafCid(
        plan, typedFunctionIndex)
    if !layout.FixedBytes32Equal(
           currentCid,
           plan.canonicalSnapshotFunctionMerkleNodes[nodeIndex]):
        return false
    while nodeIndex > 0:
        let parentIndex = (nodeIndex - 1) / 2
        let leftIndex = parentIndex * 2 + 1
        let rightIndex = leftIndex + 1
        var expectedParentCid: layout.FixedBytes32
        if nodeIndex == leftIndex:
            expectedParentCid =
                loweringCanonicalSnapshotFunctionBranchCid(
                    functionCount,
                    parentIndex,
                    currentCid,
                    plan.canonicalSnapshotFunctionMerkleNodes[rightIndex])
        else:
            expectedParentCid =
                loweringCanonicalSnapshotFunctionBranchCid(
                    functionCount,
                    parentIndex,
                    plan.canonicalSnapshotFunctionMerkleNodes[leftIndex],
                    currentCid)
        if !layout.FixedBytes32Equal(
               expectedParentCid,
               plan.canonicalSnapshotFunctionMerkleNodes[parentIndex]):
            return false
        currentCid = expectedParentCid
        nodeIndex = parentIndex
    return layout.FixedBytes32Equal(
        currentCid,
        plan.canonicalSnapshotFunctionMerkleRootCid)

fn LoweringCanonicalSnapshotProjectionAppendValueDefinitionRow(
        plan: var LoweringPlanStub,
        typedFunctionIndex: int32) =
    loweringSequenceAllocatorAdd(
        plan.canonicalSnapshotProjectionAllocatorLedger,
        plan.snapshotValueDefinitionTypedFunctionIndexes,
        typedFunctionIndex,
        sizeof(int32))

fn loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        releasedBytes: int64,
        releasedBufferCount: var int32,
        totalReleasedBytes: var int64) =
    if releasedBytes > int64(0):
        releasedBufferCount = releasedBufferCount + 1
        totalReleasedBytes = totalReleasedBytes + releasedBytes

fn LoweringCanonicalSnapshotProjectionAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.canonicalSnapshotProjectionAllocatorReceiptReady ||
       LoweringCanonicalSnapshotProjectionAllocatorPhysicalBufferCount(plan) != 0 ||
       LoweringCanonicalSnapshotProjectionAllocatorCapacityBytes(plan) != int64(0) ||
       !layout.FixedBytes32Equal(
           plan.snapshotExternFfiHandleCargoCid,
           layout.FixedBytes32()) ||
       plan.canonicalSnapshotFunctionMerkleLeafBase != 0 ||
       !layout.FixedBytes32Equal(
           plan.canonicalSnapshotFunctionMerkleRootCid,
           layout.FixedBytes32()) ||
       plan.canonicalSnapshotFunctionMerkleSealed ||
       !layout.FixedBytes32Equal(
           plan.canonicalSnapshotProjectionRemainderCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           plan.canonicalSnapshotProjectionAuthorityCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           plan.semanticSnapshotFactsRootCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           plan.semanticSnapshotCargoCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           plan.semanticSnapshotLoweringAuthorityCid,
           layout.FixedBytes32()) ||
       !snapshot_bridge.CompilerSnapshotLoweringAuthorityCanonicalEmpty(
           plan.compilerSnapshotLoweringAuthority) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.canonicalSnapshotProjectionAllocatorReceipt):
        panic("lowering canonical snapshot projection allocator: begin before release")
    plan.canonicalSnapshotProjectionAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.canonicalSnapshotProjectionAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.canonicalSnapshotProjectionAllocatorReceiptReady = false

fn LoweringCanonicalSnapshotProjectionAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.canonicalSnapshotProjectionAllocatorReceiptReady:
        if LoweringCanonicalSnapshotProjectionAllocatorPhysicalBufferCount(plan) != 0 ||
           LoweringCanonicalSnapshotProjectionAllocatorCapacityBytes(plan) != int64(0) ||
           !layout.FixedBytes32Equal(
               plan.snapshotExternFfiHandleCargoCid,
               layout.FixedBytes32()) ||
           plan.canonicalSnapshotFunctionMerkleLeafBase != 0 ||
           !layout.FixedBytes32Equal(
               plan.canonicalSnapshotFunctionMerkleRootCid,
               layout.FixedBytes32()) ||
           plan.canonicalSnapshotFunctionMerkleSealed ||
           !layout.FixedBytes32Equal(
               plan.canonicalSnapshotProjectionRemainderCid,
               layout.FixedBytes32()) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.canonicalSnapshotProjectionAllocatorReceipt):
            panic("lowering canonical snapshot projection allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringCanonicalSnapshotProjectionAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringCanonicalSnapshotProjectionAllocatorCapacityBytes(plan)
    if plan.canonicalSnapshotProjectionAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.canonicalSnapshotProjectionAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering canonical snapshot projection allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotFunctionIdsByTypedFunctionIndex,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotFunctionFragmentCidsByTypedFunctionIndex,
            sizeof(layout.FixedBytes32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.interfaceCidByTypedFunctionIndex,
            sizeof(layout.FixedBytes32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.canonicalSnapshotFunctionMerkleNodes,
            sizeof(layout.FixedBytes32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallResultTypedIrNodeIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallIdByTypedIrNodeIndex,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallCallerTypedFunctionIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallIds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallCalleeSymbolIds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallTargetFunctionIds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallTargetExternFunctionIds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallTargetTypedFunctionIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallExternAbiInterfaceCids,
            sizeof(layout.FixedBytes32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallExternFfiHandleContractRows,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallExternFfiHandleFunctionSymbolCids,
            sizeof(layout.FixedBytes32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallExternFfiHandleParserProvenanceCids,
            sizeof(layout.FixedBytes32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallExternFfiHandleContractCids,
            sizeof(layout.FixedBytes32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallExternFfiHandleInterfaceCids,
            sizeof(layout.FixedBytes32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallExternFfiHandleUnwindKinds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallExternFfiHandleEffectStarts,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallExternFfiHandleEffectCounts,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotExternFfiHandleEffectContractRows,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotExternFfiHandleEffectKinds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotExternFfiHandleEffectTargetKinds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotExternFfiHandleEffectParameterOrdinals,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotExternFfiHandleEffectParameterSymbolCids,
            sizeof(layout.FixedBytes32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotExternFfiHandleEffectTypeCids,
            sizeof(layout.FixedBytes32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotExternFfiHandleEffectAbiCarrierKinds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotExternFfiHandleEffectCids,
            sizeof(layout.FixedBytes32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotCallResultValueDefinitionRows,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringCanonicalSnapshotProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.canonicalSnapshotProjectionAllocatorLedger,
            plan.snapshotValueDefinitionTypedFunctionIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    plan.snapshotExternFfiHandleCargoCid = layout.FixedBytes32()
    plan.canonicalSnapshotFunctionMerkleLeafBase = 0
    plan.canonicalSnapshotFunctionMerkleRootCid = layout.FixedBytes32()
    plan.canonicalSnapshotFunctionMerkleSealed = false
    plan.canonicalSnapshotProjectionRemainderCid = layout.FixedBytes32()
    plan.canonicalSnapshotProjectionAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.canonicalSnapshotProjectionAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.canonicalSnapshotProjectionAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.canonicalSnapshotProjectionAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.canonicalSnapshotProjectionAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount = terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.canonicalSnapshotProjectionAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.canonicalSnapshotProjectionAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringCanonicalSnapshotProjectionAllocatorPhysicalBufferCount(plan) == 0 &&
        LoweringCanonicalSnapshotProjectionAllocatorCapacityBytes(plan) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering canonical snapshot projection allocator: receipt incomplete")
    plan.canonicalSnapshotProjectionAllocatorReceipt = receipt
    plan.canonicalSnapshotProjectionAllocatorReceiptReady = true
    plan.canonicalSnapshotProjectionAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringPlanReleaseCanonicalSnapshotProjectionPayload(
        plan: var LoweringPlanStub) =
    LoweringCanonicalSnapshotProjectionAllocatorRelease(plan)

fn LoweringBindCanonicalFunctionInterfaces(
        snapshot: var snapshot_schema.CsgCompilerSnapshotTables,
        authority: var snapshot_bridge.CompilerSnapshotLoweringAuthority,
        plan: var LoweringPlanStub,
        err: var str): bool =
    if plan.semanticSnapshotSchemaVersion != 0 ||
       plan.semanticSnapshotEpoch != int64(0) ||
       !layout.FixedBytes32Equal(
           plan.semanticSnapshotPredecessorReceiptCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           plan.semanticSnapshotFactsRootCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           plan.semanticSnapshotCargoCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           plan.semanticSnapshotLoweringAuthorityCid,
           layout.FixedBytes32()) ||
       !snapshot_bridge.CompilerSnapshotLoweringAuthorityCanonicalEmpty(
           plan.compilerSnapshotLoweringAuthority) ||
       plan.snapshotFunctionIdsByTypedFunctionIndex.len != 0 ||
       plan.snapshotFunctionFragmentCidsByTypedFunctionIndex.len != 0 ||
       plan.interfaceCidByTypedFunctionIndex.len != 0 ||
       plan.canonicalSnapshotFunctionMerkleNodes.len != 0 ||
       plan.canonicalSnapshotFunctionMerkleLeafBase != 0 ||
       !layout.FixedBytes32Equal(
           plan.canonicalSnapshotFunctionMerkleRootCid,
           layout.FixedBytes32()) ||
       plan.canonicalSnapshotFunctionMerkleSealed ||
       !layout.FixedBytes32Equal(
           plan.canonicalSnapshotProjectionRemainderCid,
           layout.FixedBytes32()) ||
       plan.snapshotCallResultTypedIrNodeIndexes.len != 0 ||
       plan.snapshotCallIdByTypedIrNodeIndex.len != 0 ||
       plan.snapshotCallCallerTypedFunctionIndexes.len != 0 ||
       plan.snapshotCallIds.len != 0 ||
       plan.snapshotCallCalleeSymbolIds.len != 0 ||
       plan.snapshotCallTargetFunctionIds.len != 0 ||
       plan.snapshotCallTargetExternFunctionIds.len != 0 ||
       plan.snapshotCallTargetTypedFunctionIndexes.len != 0 ||
       plan.snapshotCallExternAbiInterfaceCids.len != 0 ||
       plan.snapshotCallExternFfiHandleContractRows.len != 0 ||
       plan.snapshotCallExternFfiHandleFunctionSymbolCids.len != 0 ||
       plan.snapshotCallExternFfiHandleParserProvenanceCids.len != 0 ||
       plan.snapshotCallExternFfiHandleContractCids.len != 0 ||
       plan.snapshotCallExternFfiHandleInterfaceCids.len != 0 ||
       plan.snapshotCallExternFfiHandleUnwindKinds.len != 0 ||
       plan.snapshotCallExternFfiHandleEffectStarts.len != 0 ||
       plan.snapshotCallExternFfiHandleEffectCounts.len != 0 ||
       plan.snapshotExternFfiHandleEffectContractRows.len != 0 ||
       plan.snapshotExternFfiHandleEffectKinds.len != 0 ||
       plan.snapshotExternFfiHandleEffectTargetKinds.len != 0 ||
       plan.snapshotExternFfiHandleEffectParameterOrdinals.len != 0 ||
       plan.snapshotExternFfiHandleEffectParameterSymbolCids.len != 0 ||
       plan.snapshotExternFfiHandleEffectTypeCids.len != 0 ||
       plan.snapshotExternFfiHandleEffectAbiCarrierKinds.len != 0 ||
       plan.snapshotExternFfiHandleEffectCids.len != 0 ||
       !layout.FixedBytes32Equal(
           plan.snapshotExternFfiHandleCargoCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           plan.canonicalSnapshotProjectionAuthorityCid,
           layout.FixedBytes32()) ||
       plan.snapshotCallResultValueDefinitionRows.len != 0 ||
       plan.snapshotValueDefinitionTypedFunctionIndexes.len != 0:
        err =
            " lowering plan: canonical FunctionInterfaceCid destination is not empty"
        return false
    if !snapshot_bridge.CompilerSnapshotLoweringAuthoritySnapshotMatchesInto(
           authority, snapshot, err):
        return false
    if !snapshot_schema.CsgCompilerExternFfiHandleContractsStrictValidateInto(
           snapshot, err):
        return false
    LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
    LoweringCanonicalSnapshotProjectionAllocatorBegin(plan)
    let typedFunctionCount =
        plan.typedIr.functions2_functionNameIds.len
    let functionCount = snapshot.functions.typedFunctionIndexes.len
    if functionCount != typedFunctionCount:
        LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
        err =
            " lowering plan: canonical FunctionInterfaceCid count mismatch"
        return false
    let typedNodeCount = plan.typedIr.nodes2_nodeIndexs.len
    LoweringCanonicalSnapshotProjectionSetDomains(
        plan,
        typedFunctionCount,
        typedNodeCount)
    for functionId in 0..<functionCount:
        let typedFunctionIndex =
            snapshot.functions.typedFunctionIndexes[functionId]
        let fragmentCid = snapshot.functions.fragmentCids[functionId]
        let interfaceCid = snapshot.functions.interfaceCids[functionId]
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >= typedFunctionCount ||
           plan.snapshotFunctionIdsByTypedFunctionIndex[
               typedFunctionIndex] != -1 ||
           !layout.FixedBytes32Equal(
               plan.snapshotFunctionFragmentCidsByTypedFunctionIndex[
                   typedFunctionIndex],
               layout.FixedBytes32()) ||
           !layout.FixedBytes32Equal(
               plan.interfaceCidByTypedFunctionIndex[typedFunctionIndex],
               layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(
               fragmentCid, layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(
               interfaceCid, layout.FixedBytes32()):
            LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
            err =
                " lowering plan: canonical function identity index collision"
            return false
        plan.snapshotFunctionIdsByTypedFunctionIndex[
            typedFunctionIndex] = functionId
        plan.snapshotFunctionFragmentCidsByTypedFunctionIndex[
            typedFunctionIndex] = fragmentCid
        plan.interfaceCidByTypedFunctionIndex[typedFunctionIndex] =
            interfaceCid
    if !loweringPlanFunctionInterfaceProjectionStrictValidateInto(
           snapshot,
           typedFunctionCount,
           plan.snapshotFunctionIdsByTypedFunctionIndex,
           plan.snapshotFunctionFragmentCidsByTypedFunctionIndex,
           plan.interfaceCidByTypedFunctionIndex,
           err):
        LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
        return false
    LoweringCanonicalSnapshotFunctionMerkleSeal(plan)
    plan.snapshotExternFfiHandleCargoCid =
        snapshot.externFfiHandleContracts.cargoCid
    let effectCount =
        snapshot.externFfiHandleContracts.effectKinds.len
    for effectRow in 0..<effectCount:
        LoweringCanonicalSnapshotProjectionAppendExternFfiHandleEffectRow(
            plan,
            snapshot.externFfiHandleContracts.effectContractRows[
                effectRow],
            snapshot.externFfiHandleContracts.effectKinds[effectRow],
            snapshot.externFfiHandleContracts.effectTargetKinds[
                effectRow],
            snapshot.externFfiHandleContracts.effectParameterOrdinals[
                effectRow],
            snapshot.externFfiHandleContracts.effectParameterSymbolCids[
                effectRow],
            snapshot.externFfiHandleContracts.effectTypeCids[effectRow],
            snapshot.externFfiHandleContracts.effectAbiCarrierKinds[
                effectRow],
            snapshot.externFfiHandleContracts.effectCids[effectRow])
    let callCount = snapshot.calls.callerFunctionIds.len
    for callId in 0..<callCount:
        let callerFunctionId =
            snapshot.calls.callerFunctionIds[callId]
        let calleeSymbolId =
            snapshot.calls.calleeSymbolIds[callId]
        let resultTypedNodeId =
            snapshot.calls.resultTypedNodeIds[callId]
        if callerFunctionId < 0 ||
           callerFunctionId >= functionCount ||
           calleeSymbolId < 0 ||
           calleeSymbolId >= snapshot.symbols.functionIds.len ||
           resultTypedNodeId < 0 ||
           resultTypedNodeId >=
               snapshot.typedNodes.typedIrNodeIndexes.len:
            LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
            err =
                " lowering plan: canonical snapshot call projection invalid"
            return false
        let resultTypedIrNodeIndex =
            snapshot.typedNodes.typedIrNodeIndexes[resultTypedNodeId]
        if resultTypedIrNodeIndex < 0 ||
           resultTypedIrNodeIndex >= typedNodeCount ||
           plan.snapshotCallIdByTypedIrNodeIndex[
               resultTypedIrNodeIndex] >= 0:
            LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
            err =
                " lowering plan: canonical snapshot CallExpr projection collision"
            return false
        plan.snapshotCallIdByTypedIrNodeIndex[
            resultTypedIrNodeIndex] = callId
        let targetFunctionId =
            snapshot.symbols.functionIds[calleeSymbolId]
        let targetExternFunctionId =
            snapshot.symbols.externFunctionIds[calleeSymbolId]
        if (targetFunctionId >= 0) == (targetExternFunctionId >= 0):
            LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
            err =
                " lowering plan: canonical snapshot call target XOR invalid"
            return false
        var targetTypedFunctionIndex: int32 = -1
        var externAbiInterfaceCid: layout.FixedBytes32
        var ffiHandleContractRow: int32 = -1
        var ffiHandleFunctionSymbolCid: layout.FixedBytes32
        var ffiHandleParserProvenanceCid: layout.FixedBytes32
        var ffiHandleContractCid: layout.FixedBytes32
        var ffiHandleInterfaceCid: layout.FixedBytes32
        var ffiHandleUnwindKind: int32
        var ffiHandleEffectStart: int32 = -1
        var ffiHandleEffectCount: int32
        if targetFunctionId >= 0:
            if targetFunctionId >= functionCount:
                LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
                err =
                    " lowering plan: canonical snapshot callee FunctionId invalid"
                return false
            targetTypedFunctionIndex =
                snapshot.functions.typedFunctionIndexes[targetFunctionId]
        else:
            if targetExternFunctionId < 0 ||
               targetExternFunctionId >=
                   snapshot.externFunctions.symbolIds.len ||
               snapshot.externFunctions.symbolIds[
                   targetExternFunctionId] != calleeSymbolId:
                LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
                err =
                    " lowering plan: canonical snapshot extern identity invalid"
                return false
            externAbiInterfaceCid =
                snapshot.externFunctions.interfaceCids[
                    targetExternFunctionId]
            ffiHandleContractRow =
                LoweringCanonicalSnapshotExternFfiHandleContractRowForSymbolId(
                    snapshot, calleeSymbolId)
            if ffiHandleContractRow >= 0:
                let contractRow = ffiHandleContractRow
                ffiHandleFunctionSymbolCid =
                    snapshot.externFfiHandleContracts.functionSymbolCids[
                        contractRow]
                ffiHandleParserProvenanceCid =
                    snapshot.externFfiHandleContracts.parserProvenanceCids[
                        contractRow]
                ffiHandleContractCid =
                    snapshot.externFfiHandleContracts.contractCids[
                        contractRow]
                ffiHandleInterfaceCid =
                    snapshot.externFfiHandleContracts.interfaceCids[
                        contractRow]
                ffiHandleUnwindKind =
                    snapshot.externFfiHandleContracts.unwindKinds[
                        contractRow]
                if ffiHandleUnwindKind !=
                       snapshot_schema.CsgCompilerExternFfiHandleUnwindNoUnwind:
                    LoweringPlanReleaseCanonicalSnapshotProjectionPayload(
                        plan)
                    err =
                        " lowering plan: canonical snapshot no-unwind contract invalid"
                    return false
                ffiHandleEffectStart =
                    snapshot.externFfiHandleContracts.effectStarts[
                        contractRow]
                ffiHandleEffectCount =
                    snapshot.externFfiHandleContracts.effectCounts[
                        contractRow]
                if ffiHandleEffectStart < 0 ||
                   ffiHandleEffectCount <= 0 ||
                   ffiHandleEffectCount >
                       effectCount - ffiHandleEffectStart:
                    LoweringPlanReleaseCanonicalSnapshotProjectionPayload(
                        plan)
                    err =
                        " lowering plan: canonical snapshot ffi handle CSR invalid"
                    return false
        LoweringCanonicalSnapshotProjectionAppendCallRow(
            plan, callId, calleeSymbolId, targetFunctionId,
            targetExternFunctionId, targetTypedFunctionIndex,
            externAbiInterfaceCid,
            ffiHandleContractRow,
            ffiHandleFunctionSymbolCid,
            ffiHandleParserProvenanceCid,
            ffiHandleContractCid,
            ffiHandleInterfaceCid,
            ffiHandleUnwindKind,
            ffiHandleEffectStart,
            ffiHandleEffectCount,
            resultTypedIrNodeIndex,
            snapshot.functions.typedFunctionIndexes[callerFunctionId],
            snapshot.calls.resultValueDefinitionRows[callId])
    for definitionRow in 0..<
            snapshot.valueDefinitions.functionIds.len:
        let functionId =
            snapshot.valueDefinitions.functionIds[definitionRow]
        if functionId < 0 || functionId >= functionCount:
            LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
            err =
                " lowering plan: canonical value-definition FunctionId invalid"
            return false
        LoweringCanonicalSnapshotProjectionAppendValueDefinitionRow(
            plan,
            snapshot.functions.typedFunctionIndexes[functionId])
    plan.semanticSnapshotSchemaVersion = snapshot.schemaVersion
    plan.semanticSnapshotEpoch = snapshot.semanticEpoch
    plan.semanticSnapshotPredecessorReceiptCid =
        snapshot.predecessorReceiptCid
    plan.semanticSnapshotFactsRootCid =
        snapshot_bridge.CompilerSnapshotLoweringAuthorityFactsRootCid(
            authority)
    plan.semanticSnapshotCargoCid =
        snapshot_bridge.CompilerSnapshotLoweringAuthorityCargoCid(
            authority)
    plan.semanticSnapshotLoweringAuthorityCid =
        snapshot_bridge.CompilerSnapshotLoweringAuthorityCid(authority)
    plan.canonicalSnapshotProjectionRemainderCid =
        LoweringCanonicalSnapshotProjectionRemainderCid(plan)
    let projectionAuthorityCid =
        LoweringCanonicalSnapshotProjectionAuthorityCid(plan)
    if layout.FixedBytes32Equal(
           projectionAuthorityCid,
           layout.FixedBytes32()):
        LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
        plan.semanticSnapshotSchemaVersion = 0
        plan.semanticSnapshotEpoch = int64(0)
        plan.semanticSnapshotPredecessorReceiptCid =
            layout.FixedBytes32()
        plan.semanticSnapshotFactsRootCid = layout.FixedBytes32()
        plan.semanticSnapshotCargoCid = layout.FixedBytes32()
        plan.semanticSnapshotLoweringAuthorityCid =
            layout.FixedBytes32()
        plan.compilerSnapshotLoweringAuthority =
            snapshot_bridge.CompilerSnapshotLoweringAuthority()
        err =
            " lowering plan: canonical snapshot projection authority missing"
        return false
    if !snapshot_bridge.CompilerSnapshotLoweringAuthorityBindFunctionProjectionInto(
           authority, projectionAuthorityCid, err):
        LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
        plan.semanticSnapshotSchemaVersion = 0
        plan.semanticSnapshotEpoch = int64(0)
        plan.semanticSnapshotPredecessorReceiptCid =
            layout.FixedBytes32()
        plan.semanticSnapshotFactsRootCid = layout.FixedBytes32()
        plan.semanticSnapshotCargoCid = layout.FixedBytes32()
        plan.semanticSnapshotLoweringAuthorityCid =
            layout.FixedBytes32()
        return false
    plan.compilerSnapshotLoweringAuthority = authority
    authority = snapshot_bridge.CompilerSnapshotLoweringAuthority()
    plan.canonicalSnapshotProjectionAuthorityCid =
        projectionAuthorityCid
    err = ""
    return true

@borrows
fn LoweringFnPtrFieldCallAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.fnPtrFieldCallNodeIndexes.cap > 0: count = count + 1
    if plan.fnPtrFieldCallFieldNodeIndexes.cap > 0: count = count + 1
    if plan.fnPtrFieldCallFieldTypeIds.cap > 0: count = count + 1
    if plan.fnPtrFieldCallStructuralKinds.cap > 0: count = count + 1
    if plan.fnPtrFieldCallFunctionInterfaceCids.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringFnPtrFieldCallAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(plan.fnPtrFieldCallNodeIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.fnPtrFieldCallFieldNodeIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.fnPtrFieldCallFieldTypeIds.cap) *
            int64(sizeof(int32)) +
        int64(plan.fnPtrFieldCallStructuralKinds.cap) *
            int64(sizeof(int32)) +
        int64(plan.fnPtrFieldCallFunctionInterfaceCids.cap) *
            int64(sizeof(layout.FixedBytes32))

@borrows
fn LoweringFnPtrFieldCallAppendRow(
        plan: var LoweringPlanStub,
        callNodeIndex: int32,
        fieldNodeIndex: int32,
        fieldTypeId: int32,
        structuralKind: int32,
        functionInterfaceCid: layout.FixedBytes32) =
    let rowCount = plan.fnPtrFieldCallNodeIndexes.len
    if plan.fnPtrFieldCallFieldNodeIndexes.len != rowCount ||
       plan.fnPtrFieldCallFieldTypeIds.len != rowCount ||
       plan.fnPtrFieldCallStructuralKinds.len != rowCount ||
       plan.fnPtrFieldCallFunctionInterfaceCids.len != rowCount:
        panic("lowering fnptr field call allocator: row shape drift")
    loweringSequenceAllocatorAdd(
        plan.fnPtrFieldCallAllocatorLedger,
        plan.fnPtrFieldCallNodeIndexes,
        callNodeIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.fnPtrFieldCallAllocatorLedger,
        plan.fnPtrFieldCallFieldNodeIndexes,
        fieldNodeIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.fnPtrFieldCallAllocatorLedger,
        plan.fnPtrFieldCallFieldTypeIds,
        fieldTypeId,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.fnPtrFieldCallAllocatorLedger,
        plan.fnPtrFieldCallStructuralKinds,
        structuralKind,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.fnPtrFieldCallAllocatorLedger,
        plan.fnPtrFieldCallFunctionInterfaceCids,
        functionInterfaceCid,
        sizeof(layout.FixedBytes32))

fn loweringFnPtrFieldCallAccumulateTerminalRelease(
        releasedBytes: int64,
        releasedBufferCount: var int32,
        totalReleasedBytes: var int64) =
    if releasedBytes > int64(0):
        releasedBufferCount = releasedBufferCount + 1
        totalReleasedBytes = totalReleasedBytes + releasedBytes

fn LoweringFnPtrFieldCallAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.fnPtrFieldCallAllocatorReceiptReady ||
       LoweringFnPtrFieldCallAllocatorPhysicalBufferCount(plan) != 0 ||
       LoweringFnPtrFieldCallAllocatorCapacityBytes(plan) != int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.fnPtrFieldCallAllocatorReceipt):
        panic("lowering fnptr field call allocator: begin before release")
    plan.fnPtrFieldCallAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.fnPtrFieldCallAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.fnPtrFieldCallAllocatorReceiptReady = false

fn LoweringFnPtrFieldCallAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.fnPtrFieldCallAllocatorReceiptReady:
        if LoweringFnPtrFieldCallAllocatorPhysicalBufferCount(plan) != 0 ||
           LoweringFnPtrFieldCallAllocatorCapacityBytes(plan) != int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.fnPtrFieldCallAllocatorReceipt):
            panic("lowering fnptr field call allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringFnPtrFieldCallAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringFnPtrFieldCallAllocatorCapacityBytes(plan)
    if plan.fnPtrFieldCallAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.fnPtrFieldCallAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering fnptr field call allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringFnPtrFieldCallAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.fnPtrFieldCallAllocatorLedger,
            plan.fnPtrFieldCallNodeIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFnPtrFieldCallAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.fnPtrFieldCallAllocatorLedger,
            plan.fnPtrFieldCallFieldNodeIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFnPtrFieldCallAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.fnPtrFieldCallAllocatorLedger,
            plan.fnPtrFieldCallFieldTypeIds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFnPtrFieldCallAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.fnPtrFieldCallAllocatorLedger,
            plan.fnPtrFieldCallStructuralKinds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringFnPtrFieldCallAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.fnPtrFieldCallAllocatorLedger,
            plan.fnPtrFieldCallFunctionInterfaceCids,
            sizeof(layout.FixedBytes32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    plan.fnPtrFieldCallAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.fnPtrFieldCallAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.fnPtrFieldCallAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.fnPtrFieldCallAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.fnPtrFieldCallAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.fnPtrFieldCallAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.fnPtrFieldCallAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringFnPtrFieldCallAllocatorPhysicalBufferCount(plan) == 0 &&
        LoweringFnPtrFieldCallAllocatorCapacityBytes(plan) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering fnptr field call allocator: receipt incomplete")
    plan.fnPtrFieldCallAllocatorReceipt = receipt
    plan.fnPtrFieldCallAllocatorReceiptReady = true
    plan.fnPtrFieldCallAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringPlanReleaseFnPtrFieldCallPayload(
        plan: var LoweringPlanStub) =
    LoweringFnPtrFieldCallAllocatorRelease(plan)

@borrows
fn LoweringTypeArenaOwnerProofAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.typedFunctionReturnTypeArenaTypeIds.cap > 0:
        count = count + 1
    if plan.typedFunctionReturnManagedStorageKinds.cap > 0:
        count = count + 1
    if plan.globalTypeArenaTypeIds.cap > 0:
        count = count + 1
    if plan.globalManagedStorageKinds.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringTypeArenaOwnerProofAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(plan.typedFunctionReturnTypeArenaTypeIds.cap) *
               int64(sizeof(int32)) +
           int64(plan.typedFunctionReturnManagedStorageKinds.cap) *
               int64(sizeof(int32)) +
           int64(plan.globalTypeArenaTypeIds.cap) *
               int64(sizeof(int32)) +
           int64(plan.globalManagedStorageKinds.cap) *
               int64(sizeof(int32))

fn LoweringTypeArenaOwnerProofAppendFunctionRow(
        plan: var LoweringPlanStub,
        typeId: int32,
        managedStorageKind: int32) =
    if plan.typedFunctionReturnTypeArenaTypeIds.len !=
           plan.typedFunctionReturnManagedStorageKinds.len:
        panic("lowering TypeArena owner proof allocator: function row shape drift")
    loweringSequenceAllocatorAdd(
        plan.typeArenaOwnerProofAllocatorLedger,
        plan.typedFunctionReturnTypeArenaTypeIds,
        typeId,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typeArenaOwnerProofAllocatorLedger,
        plan.typedFunctionReturnManagedStorageKinds,
        managedStorageKind,
        sizeof(int32))

fn LoweringTypeArenaOwnerProofAppendGlobalRow(
        plan: var LoweringPlanStub,
        typeId: int32,
        managedStorageKind: int32) =
    if plan.globalTypeArenaTypeIds.len !=
           plan.globalManagedStorageKinds.len:
        panic("lowering TypeArena owner proof allocator: global row shape drift")
    loweringSequenceAllocatorAdd(
        plan.typeArenaOwnerProofAllocatorLedger,
        plan.globalTypeArenaTypeIds,
        typeId,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typeArenaOwnerProofAllocatorLedger,
        plan.globalManagedStorageKinds,
        managedStorageKind,
        sizeof(int32))

fn loweringTypeArenaOwnerProofAccumulateTerminalRelease(
        releasedBytes: int64,
        releasedBufferCount: var int32,
        totalReleasedBytes: var int64) =
    if releasedBytes > int64(0):
        releasedBufferCount = releasedBufferCount + 1
        totalReleasedBytes = totalReleasedBytes + releasedBytes

fn LoweringTypeArenaOwnerProofAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.typeArenaOwnerProofAllocatorReceiptReady ||
       LoweringTypeArenaOwnerProofAllocatorPhysicalBufferCount(plan) != 0 ||
       LoweringTypeArenaOwnerProofAllocatorCapacityBytes(plan) != int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.typeArenaOwnerProofAllocatorReceipt):
        panic("lowering TypeArena owner proof allocator: begin before release")
    plan.typeArenaOwnerProofAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.typeArenaOwnerProofAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.typeArenaOwnerProofAllocatorReceiptReady = false

fn LoweringTypeArenaOwnerProofAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.typeArenaOwnerProofAllocatorReceiptReady:
        if LoweringTypeArenaOwnerProofAllocatorPhysicalBufferCount(plan) != 0 ||
           LoweringTypeArenaOwnerProofAllocatorCapacityBytes(plan) !=
               int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.typeArenaOwnerProofAllocatorReceipt):
            panic("lowering TypeArena owner proof allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringTypeArenaOwnerProofAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringTypeArenaOwnerProofAllocatorCapacityBytes(plan)
    if plan.typeArenaOwnerProofAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.typeArenaOwnerProofAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering TypeArena owner proof allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringTypeArenaOwnerProofAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typeArenaOwnerProofAllocatorLedger,
            plan.typedFunctionReturnTypeArenaTypeIds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypeArenaOwnerProofAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typeArenaOwnerProofAllocatorLedger,
            plan.typedFunctionReturnManagedStorageKinds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypeArenaOwnerProofAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typeArenaOwnerProofAllocatorLedger,
            plan.globalTypeArenaTypeIds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypeArenaOwnerProofAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typeArenaOwnerProofAllocatorLedger,
            plan.globalManagedStorageKinds,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    plan.typeArenaOwnerProofAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.typeArenaOwnerProofAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.typeArenaOwnerProofAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.typeArenaOwnerProofAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.typeArenaOwnerProofAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount = terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.typeArenaOwnerProofAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.typeArenaOwnerProofAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringTypeArenaOwnerProofAllocatorPhysicalBufferCount(plan) == 0 &&
        LoweringTypeArenaOwnerProofAllocatorCapacityBytes(plan) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering TypeArena owner proof allocator: receipt incomplete")
    plan.typeArenaOwnerProofAllocatorReceipt = receipt
    plan.typeArenaOwnerProofAllocatorReceiptReady = true
    plan.typeArenaOwnerProofAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringPlanReleaseTypeArenaOwnerProofPayload(
        plan: var LoweringPlanStub) =
    LoweringTypeArenaOwnerProofAllocatorRelease(plan)

fn LoweringBindCanonicalTypeArenaProofs(
        compilerCsg: var ccsg.CompilerCsg,
        plan: var LoweringPlanStub,
        err: var str): bool =
    if !layout.FixedBytes32Equal(
           plan.typeArenaArtifactCid, layout.FixedBytes32()) ||
       plan.typedFunctionReturnTypeArenaTypeIds.len != 0 ||
       plan.typedFunctionReturnManagedStorageKinds.len != 0 ||
       plan.globalTypeArenaTypeIds.len != 0 ||
       plan.globalManagedStorageKinds.len != 0 ||
       plan.typeArenaStructuralKinds.len != 0 ||
       plan.typeArenaScalarKinds.len != 0 ||
       plan.typeArenaChildTypeIds.len != 0 ||
       plan.typeArenaLayoutChildStarts.len != 0 ||
       plan.typeArenaLayoutChildCounts.len != 0 ||
       plan.typeArenaLayoutChildTypeIds.len != 0 ||
       plan.typeArenaLayoutChildIdentityKinds.len != 0 ||
       plan.typeArenaLayoutChildMemberRows.len != 0 ||
       plan.typeArenaLayoutChildSelectorOrdinals.len != 0 ||
       plan.typeArenaLayoutChildOffsets.len != 0 ||
       plan.typeArenaLayoutChildWidths.len != 0 ||
       plan.typeArenaFixedLengths.len != 0 ||
       plan.typeArenaVariantCounts.len != 0 ||
       plan.typeArenaSizeBytes.len != 0 ||
       plan.typeArenaAlignBytes.len != 0 ||
       plan.typeArenaLayoutPresent.len != 0 ||
       !layout.FixedBytes32Equal(
           plan.fnPtrFieldCallTypeArenaArtifactCid,
           layout.FixedBytes32()) ||
       plan.fnPtrFieldCallNodeIndexes.len != 0 ||
       plan.fnPtrFieldCallFieldNodeIndexes.len != 0 ||
       plan.fnPtrFieldCallFieldTypeIds.len != 0 ||
       plan.fnPtrFieldCallStructuralKinds.len != 0 ||
       plan.fnPtrFieldCallFunctionInterfaceCids.len != 0:
        err = " lowering plan: TypeArena proof destination is not empty"
        return false
    if !typearena.TypedExprTypeArenaComplete(compilerCsg.typeArena) ||
       !typearena.TypedExprTypeArenaStrictValidateInto(
           compilerCsg.typeArena, err) ||
       layout.FixedBytes32Equal(
           compilerCsg.typeArena.artifactRaw32,
           layout.FixedBytes32()):
        if err == "":
            err = " lowering plan: canonical TypeArena artifact invalid"
        return false
    plan.typeArenaArtifactCid = compilerCsg.typeArena.artifactRaw32
    if !ccsg.CompilerCsgCanonicalTypeFactsInto(
           compilerCsg,
           plan.typeArenaStructuralKinds,
           plan.typeArenaScalarKinds,
           plan.typeArenaChildTypeIds,
           plan.typeArenaLayoutChildStarts,
           plan.typeArenaLayoutChildCounts,
           plan.typeArenaLayoutChildTypeIds,
           plan.typeArenaLayoutChildIdentityKinds,
           plan.typeArenaLayoutChildMemberRows,
           plan.typeArenaLayoutChildSelectorOrdinals,
           plan.typeArenaLayoutChildOffsets,
           plan.typeArenaLayoutChildWidths,
           plan.typeArenaFixedLengths,
           plan.typeArenaVariantCounts,
           plan.typeArenaSizeBytes,
           plan.typeArenaAlignBytes,
           plan.typeArenaLayoutPresent,
           err) ||
       plan.typeArenaStructuralKinds.len <= 0 ||
       plan.typeArenaStructuralKinds.len !=
           plan.typeArenaScalarKinds.len ||
       plan.typeArenaStructuralKinds.len !=
           plan.typeArenaChildTypeIds.len ||
       plan.typeArenaStructuralKinds.len !=
           plan.typeArenaLayoutChildStarts.len ||
       plan.typeArenaStructuralKinds.len !=
           plan.typeArenaLayoutChildCounts.len ||
       plan.typeArenaLayoutChildTypeIds.len !=
           plan.typeArenaLayoutChildIdentityKinds.len ||
       plan.typeArenaLayoutChildTypeIds.len !=
           plan.typeArenaLayoutChildMemberRows.len ||
       plan.typeArenaLayoutChildTypeIds.len !=
           plan.typeArenaLayoutChildSelectorOrdinals.len ||
       plan.typeArenaLayoutChildTypeIds.len !=
           plan.typeArenaLayoutChildOffsets.len ||
       plan.typeArenaLayoutChildTypeIds.len !=
           plan.typeArenaLayoutChildWidths.len ||
       plan.typeArenaStructuralKinds.len !=
           plan.typeArenaFixedLengths.len ||
       plan.typeArenaStructuralKinds.len !=
           plan.typeArenaVariantCounts.len ||
       plan.typeArenaStructuralKinds.len !=
           plan.typeArenaSizeBytes.len ||
       plan.typeArenaStructuralKinds.len !=
           plan.typeArenaAlignBytes.len ||
       plan.typeArenaStructuralKinds.len !=
           plan.typeArenaLayoutPresent.len:
       if err == "":
           err = " lowering plan: canonical TypeArena fact projection failed"
       return false
    # RefObject layout rows carry the 8/8 pointer-handle extent (wall47
    # exact-layout verdict) while their field rows live in pointee-offset
    # space; the row-size containment below therefore applies to non-ref
    # rows only (same exemption as the snapshot layout CID preimage).
    for typeId in 0..<plan.typeArenaStructuralKinds.len:
        let childStart = plan.typeArenaLayoutChildStarts[typeId]
        let childCount = plan.typeArenaLayoutChildCounts[typeId]
        if childStart < 0 || childCount < 0 ||
           childStart > plan.typeArenaLayoutChildTypeIds.len - childCount:
            err = Fmt" lowering plan: canonical TypeArena layout CSR invalid type_id={typeId}"
            return false
        for childOffset in 0..<childCount:
            let childRow = childStart + childOffset
            let childTypeId = plan.typeArenaLayoutChildTypeIds[childRow]
            let identityKind = plan.typeArenaLayoutChildIdentityKinds[childRow]
            let memberRow = plan.typeArenaLayoutChildMemberRows[childRow]
            let selectorOrdinal = plan.typeArenaLayoutChildSelectorOrdinals[childRow]
            let byteOffset = plan.typeArenaLayoutChildOffsets[childRow]
            let byteWidth = plan.typeArenaLayoutChildWidths[childRow]
            if childTypeId < 0 ||
               childTypeId >= plan.typeArenaStructuralKinds.len ||
               (identityKind != 1 && identityKind != 2) ||
               memberRow < 0 || selectorOrdinal < 0 ||
               byteOffset < 0 || byteWidth <= 0 ||
               (plan.typeArenaStructuralKinds[typeId] !=
                    Int32(typearena.TypedExprStructuralTypeRefObject) &&
                byteOffset >
                    plan.typeArenaSizeBytes[typeId] - byteWidth) ||
               byteWidth != plan.typeArenaSizeBytes[childTypeId]:
                err = Fmt" lowering plan: canonical TypeArena layout member invalid type_id={typeId} member={childOffset}"
                return false
    let fnPtrFieldCalls = compilerCsg.fnPtrFieldCalls
    let fnPtrFieldCallCount =
        fnPtrFieldCalls.callNodeIndexes.len
    if !fnPtrFieldCalls.complete ||
       !layout.FixedBytes32Equal(
           fnPtrFieldCalls.typeArenaArtifactCid,
           plan.typeArenaArtifactCid) ||
       fnPtrFieldCallCount !=
           fnPtrFieldCalls.fieldNodeIndexes.len ||
       fnPtrFieldCallCount !=
           fnPtrFieldCalls.fieldTypeIds.len ||
       fnPtrFieldCallCount !=
           fnPtrFieldCalls.fieldStructuralKinds.len ||
       fnPtrFieldCallCount !=
           fnPtrFieldCalls.functionInterfaceCids.len:
        err = " lowering plan: canonical fnptr field call facts incomplete"
        return false
    LoweringPlanReleaseFnPtrFieldCallPayload(plan)
    LoweringFnPtrFieldCallAllocatorBegin(plan)
    plan.fnPtrFieldCallTypeArenaArtifactCid =
        fnPtrFieldCalls.typeArenaArtifactCid
    for row in 0..<fnPtrFieldCallCount:
        LoweringFnPtrFieldCallAppendRow(
            plan,
            fnPtrFieldCalls.callNodeIndexes[row],
            fnPtrFieldCalls.fieldNodeIndexes[row],
            fnPtrFieldCalls.fieldTypeIds[row],
            fnPtrFieldCalls.fieldStructuralKinds[row],
            fnPtrFieldCalls.functionInterfaceCids[row])
    LoweringPlanReleaseTypeArenaOwnerProofPayload(plan)
    LoweringTypeArenaOwnerProofAllocatorBegin(plan)
    if !loweringTypeArenaBindFunctionReturnProofs(compilerCsg, plan) ||
       !loweringTypeArenaBindGlobalProofs(compilerCsg, plan):
        err = " lowering plan: canonical TypeArena proof replay failed"
        return false
    err = ""
    return true

fn loweringSequenceAllocatorSetLen(
        owner: var LoweringCompilerCsgBindTypedFunctionClaimScratchOwner,
        domain: LoweringCompilerCsgBindTypedFunctionClaimScratchLength) =
    if owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed:
        panic("lowering compiler csg bind claim scratch: invalid setLen state")
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.typedFunctionClaimed,
        domain.length,
        sizeof(bool))

@borrows
fn LoweringCompilerCsgBindTypedFunctionClaimScratchPhysicalBufferCount(
        owner: LoweringCompilerCsgBindTypedFunctionClaimScratchOwner):
        int32 =
    if owner.typedFunctionClaimed.cap > 0:
        return 1
    return 0

@borrows
fn LoweringCompilerCsgBindTypedFunctionClaimScratchCapacityBytes(
        owner: LoweringCompilerCsgBindTypedFunctionClaimScratchOwner):
        int64 =
    return int64(owner.typedFunctionClaimed.cap) *
           int64(sizeof(bool))

@borrows
fn loweringCompilerCsgBindTypedFunctionClaimScratchOwnerToken(
        receipt: LoweringSequenceAllocatorReceipt):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(128)
    loweringPlanReleaseAppendText(
        buf,
        "cheng.compiler.lowering.compiler_csg_bind_typed_function_claim_scratch")
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocationEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releaseEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalRetainedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalRetainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalReleasedBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveAllocationCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveCapacityBytes)
    let token = hash256.Sha256Fixed(
        layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn LoweringCompilerCsgBindTypedFunctionClaimScratchReleaseWithReceipt(
        owner: var LoweringCompilerCsgBindTypedFunctionClaimScratchOwner,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()) ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(
               LoweringCompilerCsgBindTypedFunctionClaimScratchPhysicalBufferCount(
                   owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringCompilerCsgBindTypedFunctionClaimScratchCapacityBytes(
               owner):
        panic("lowering compiler csg bind claim scratch: owner state drift")
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringCompilerCsgBindTypedFunctionClaimScratchPhysicalBufferCount(
            owner)
    receipt.terminalRetainedBytes =
        LoweringCompilerCsgBindTypedFunctionClaimScratchCapacityBytes(owner)
    let releasedBytes =
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.typedFunctionClaimed,
            sizeof(bool))
    owner.allocatorLedger.closed = true
    receipt.allocationEventCount =
        owner.allocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        owner.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        owner.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        owner.allocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = releasedBytes
    receipt.liveAllocationCount =
        owner.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        owner.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringCompilerCsgBindTypedFunctionClaimScratchPhysicalBufferCount(
            owner) == 0 &&
        LoweringCompilerCsgBindTypedFunctionClaimScratchCapacityBytes(owner) ==
            int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering compiler csg bind claim scratch: receipt incomplete")
    owner.allocatorReceipt = receipt
    owner.ownerToken =
        loweringCompilerCsgBindTypedFunctionClaimScratchOwnerToken(receipt)
    owner.allocatorReceiptReady = true
    owner.allocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringCompilerCsgBindTypedFunctionClaimScratchReceiptConsumeStrict(
        owner: var LoweringCompilerCsgBindTypedFunctionClaimScratchOwner,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    if !owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt, owner.allocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !layout.FixedBytes32Equal(
           owner.ownerToken,
           loweringCompilerCsgBindTypedFunctionClaimScratchOwnerToken(
               receipt)) ||
       LoweringCompilerCsgBindTypedFunctionClaimScratchPhysicalBufferCount(
           owner) != 0 ||
       LoweringCompilerCsgBindTypedFunctionClaimScratchCapacityBytes(owner) !=
           int64(0):
        return false
    owner.allocatorReceiptConsumed = true
    return true

fn LoweringCompilerCsgBindTypedFunctionClaimScratchClose(
        owner: var LoweringCompilerCsgBindTypedFunctionClaimScratchOwner) =
    var receipt: LoweringSequenceAllocatorReceipt
    LoweringCompilerCsgBindTypedFunctionClaimScratchReleaseWithReceipt(
        owner, receipt)
    if !LoweringCompilerCsgBindTypedFunctionClaimScratchReceiptConsumeStrict(
           owner, receipt):
        panic("lowering compiler csg bind claim scratch: strict consume failed")

@borrows
fn LoweringPlanToolchainEncoderProjectionEmpty(
        plan: LoweringPlanStub): bool =
    let zero = layout.FixedBytes32()
    return !plan.toolchainEncoderBuildProjectionReady &&
        layout.FixedBytes32Equal(
            plan.toolchainEncoderBuildProjection.receiptCid, zero) &&
        layout.FixedBytes32Equal(
            plan.toolchainEncoderCargoObjectReceipt.receiptCid, zero)

@borrows
fn LoweringPlanToolchainEncoderProjectionStrictValid(
        plan: LoweringPlanStub): bool =
    if !plan.toolchainEncoderBuildProjectionReady ||
       !snapshot_bridge.CompilerSnapshotLoweringAuthorityCargoObjectReceiptStrictValid(
           plan.toolchainEncoderCargoObjectReceipt) ||
       !layout.FixedBytes32Equal(
           plan.toolchainEncoderBuildProjection.compilerCsgCargoObjectReceiptCid,
           plan.toolchainEncoderCargoObjectReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(
           plan.toolchainEncoderBuildProjection.compilerCsgCargoCid,
           plan.toolchainEncoderCargoObjectReceipt.cargoCid) ||
       !layout.FixedBytes32Equal(
           plan.toolchainEncoderBuildProjection.compilerCsgFactsRootCid,
           plan.toolchainEncoderCargoObjectReceipt.factsRootCid) ||
       !layout.FixedBytes32Equal(
           plan.toolchainEncoderBuildProjection.contentCid,
           plan.toolchainEncoderCargoObjectReceipt.contentCid):
        return false
    let verified =
        execution.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
            plan.toolchainEncoderBuildProjection)
    if result.IsErr(verified):
        return false
    let path =
        snapshot_bridge.CompilerSnapshotLoweringAuthorityCargoObjectAbsolutePath(
            plan.workspaceRoot,
            plan.toolchainEncoderCargoObjectReceipt)
    return path.len > 0

@borrows
fn LoweringPlanIssueToolchainEncoderBuildProjectionInto(
        compilerExecution: execution.CompilerExecutionIdentity,
        semanticSnapshot:
            var snapshot_schema.CsgCompilerSnapshotTables,
        authority: var snapshot_bridge.CompilerSnapshotLoweringAuthority,
        workspaceRoot: str,
        plan: var LoweringPlanStub,
        err: var str): bool =
    if !LoweringPlanToolchainEncoderProjectionEmpty(plan):
        err =
            " lowering plan: toolchain encoder projection destination is not empty"
        return false
    var moduleMatchCount: int32
    let sourceCount = semanticSnapshot.sources.modulePathTextIds.len
    for sourceRow in 0..<sourceCount:
        let textId = semanticSnapshot.sources.modulePathTextIds[sourceRow]
        if textId < 0 || textId >= semanticSnapshot.texts.len:
            err =
                " lowering plan: toolchain encoder module TextId invalid"
            return false
        if semanticSnapshot.texts[textId] ==
           contract.CodegenUnitEncoderAuthorityPath(
               "riscv64-unknown-linux-gnu"):
            moduleMatchCount = moduleMatchCount + 1
    # Ordinary user snapshots do not contain compiler implementation modules.
    # Presence is an exact immutable-row query; when present every following
    # authority/cargo column becomes mandatory.
    if moduleMatchCount == 0:
        err = ""
        return true
    var source: snapshot_bridge.CompilerSnapshotLoweringAuthorityCanonicalSourceProjection
    if !snapshot_bridge.CompilerSnapshotLoweringAuthorityCanonicalSourceProjectionInto(
           authority,
           semanticSnapshot,
           contract.CodegenUnitEncoderAuthorityPath(
               "riscv64-unknown-linux-gnu"),
           source,
           err):
        return false
    var compilerCsg: snapshot_bridge.CompilerSnapshotLoweringAuthorityCompilerCsgProjection
    if !snapshot_bridge.CompilerSnapshotLoweringAuthorityCompilerCsgProjectionInto(
           authority, compilerCsg, err):
        return false
    var cargo: snapshot_bridge.CompilerSnapshotLoweringAuthorityCargoObjectReceipt
    if !snapshot_bridge.CompilerSnapshotLoweringAuthorityCargoObjectReceiptInto(
           authority,
           workspaceRoot,
           source.contentCid,
           cargo,
           err):
        return false
    if source.sourceRow < 0 || source.producerRow < 0 ||
       source.modulePathTextId < 0 ||
       cargo.authoritySlot != authority.ownerId - 1 ||
       cargo.authorityGeneration != authority.generation ||
       cargo.cargoObjectRow != cargo.authoritySlot ||
       !layout.FixedBytes32Equal(
           cargo.cargoCid, compilerCsg.cargoCid) ||
       !layout.FixedBytes32Equal(
           cargo.factsRootCid, compilerCsg.cargoFactsRootCid) ||
       !layout.FixedBytes32Equal(cargo.contentCid, source.contentCid):
        err =
            " lowering plan: toolchain encoder authority projection drift"
        return false
    let built =
        execution.CompilerToolchainEncoderAuthorityBuildProjectionMake(
            compilerExecution,
            compilerCsg.compilerCsgArtifactCid,
            compilerCsg.graphCid,
            compilerCsg.canonicalGraphCid,
            compilerCsg.sourceBundleCid,
            compilerCsg.cargoCid,
            compilerCsg.cargoFactsRootCid,
            cargo.receiptCid,
            source.producerRow,
            source.sourceRow,
            source.modulePathTextId,
            source.documentCid,
            source.contentCid)
    if result.IsErr(built):
        err = strings.CloneStr(result.Error(built))
        return false
    let projection = result.Value(built)
    let verified =
        execution.CompilerToolchainEncoderAuthorityBuildProjectionVerifyForBuild(
            projection, compilerExecution)
    if result.IsErr(verified):
        err = strings.CloneStr(result.Error(verified))
        return false
    plan.toolchainEncoderBuildProjection = projection
    plan.toolchainEncoderCargoObjectReceipt = cargo
    plan.toolchainEncoderBuildProjectionReady = true
    if !LoweringPlanToolchainEncoderProjectionStrictValid(plan):
        plan.toolchainEncoderBuildProjection =
            execution.CompilerToolchainEncoderAuthorityBuildProjectionReceipt()
        plan.toolchainEncoderCargoObjectReceipt =
            snapshot_bridge.CompilerSnapshotLoweringAuthorityCargoObjectReceipt()
        plan.toolchainEncoderBuildProjectionReady = false
        err =
            " lowering plan: toolchain encoder build projection invalid"
        return false
    err = ""
    return true

@borrows
fn BuildLoweringPlanStubFromCompilerCsgBorrowedWithSourceBundleOwner(
        linkPlan: var slplan.SystemLinkPlanStub,
        universe: cworld.CompilerLocalUniverse,
        compilerExecution: execution.CompilerExecutionIdentity,
        sourceBundleOwner:
            var slplan.SystemLinkPlanSourceBundleOwner,
        semanticSnapshot:
            var snapshot_schema.CsgCompilerSnapshotTables,
        semanticSnapshotLoweringAuthority:
            var snapshot_bridge.CompilerSnapshotLoweringAuthority,
        compilerCsg: var ccsg.CompilerCsg,
        plan: var LoweringPlanStub,
        err: var str): bool =
    if !snapshot_bridge.CompilerSnapshotLoweringAuthorityClaimCurrentInto(
           semanticSnapshotLoweringAuthority,
           linkPlan,
           universe,
           compilerExecution,
           semanticSnapshot,
           compilerCsg,
           err):
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    let claimedSnapshotAuthorityCid =
        snapshot_bridge.CompilerSnapshotLoweringAuthorityCid(
            semanticSnapshotLoweringAuthority)
    var claimedSnapshotAuthorityReleaseRequired = true
    defer:
        if claimedSnapshotAuthorityReleaseRequired:
            var abortReleaseCid: layout.FixedBytes32
            var abortReleaseErr: str
            if !snapshot_bridge.CompilerSnapshotLoweringAuthorityReleaseInto(
                   semanticSnapshotLoweringAuthority,
                   claimedSnapshotAuthorityCid,
                   layout.FixedBytes32(),
                   abortReleaseCid,
                   abortReleaseErr):
                panic(abortReleaseErr)
    if !slplan.SystemLinkPlanSourceBundleOwnerBorrowForLoweringInto(
           linkPlan, sourceBundleOwner, err):
        return false
    var sourceBundleBorrowActive = true
    defer:
        if sourceBundleBorrowActive:
            slplan.SystemLinkPlanSourceBundleOwnerReturnFromLowering(
                sourceBundleOwner)
            sourceBundleBorrowActive = false
    LoweringDebugLine("lowering_plan_enter")
    LoweringProgress("init_begin")
    LoweringDebugLine("lowering_plan_after_progress")
    # This API accepts a reusable owning output. Destroy manually managed
    # TypedIR/fact/resolved-call payload before replacing the value; assigning a
    # zero struct alone would lose Arena and InternPool ownership.
    LoweringPlanReleaseAllPayload(plan)
    LoweringResolvedCallTargetProjectionResetForBuild(plan)
    plan.terminalReleaseOwnerToken = layout.FixedBytes32()
    plan.terminalReleasedCompilerSnapshotLoweringAuthorityCid =
        layout.FixedBytes32()
    plan.terminalReleasedCompilerSnapshotLoweringAuthorityOwnerId = 0
    plan.terminalReleasedCompilerSnapshotLoweringAuthorityGeneration = 0
    plan.terminalReleasedCompilerSnapshotLoweringAuthorityReleaseCid =
        layout.FixedBytes32()
    plan.terminalReleasedCanonicalSnapshotProjectionAuthorityCid =
        layout.FixedBytes32()
    plan.terminalReleasedOwnedStorageColumnCount = 0
    plan.terminalReleasedBufferCount = 0
    plan.terminalReleasedBytes = int64(0)
    plan.terminalStorageReleased = false
    plan.terminalReleaseReceiptConsumed = false
    plan.lifecycleReleaseTrackingStarted = false
    plan.lifecycleReleaseClosed = false
    plan.lifecycleInitialBufferCount = 0
    plan.lifecycleInitialBytes = int64(0)
    plan.lifecycleReleasedBufferCount = 0
    plan.lifecycleReleasedBytes = int64(0)
    plan.deferScopeTransportAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.deferScopeTransportAllocatorReceiptReady = false
    plan.ownershipTransportAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.ownershipTransportAllocatorReceiptReady = false
    plan.primaryObjectIr.functionShapeAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.primaryObjectIr.functionShapeAllocatorReceiptReady = false
    plan.primaryObjectIr.callTargetAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.primaryObjectIr.callTargetAllocatorReceiptReady = false
    plan.typedFunctionDenseStoreInputAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.typedFunctionDenseStoreInputAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.typedFunctionDenseStoreInputAllocatorOwnerToken =
        layout.FixedBytes32()
    plan.typedFunctionDenseStoreInputAllocatorReceiptReady = false
    plan.typedFunctionDenseStoreInputAllocatorReceiptConsumed = false
    plan.functionDenseStoreInputAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.functionDenseStoreInputAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.functionDenseStoreInputAllocatorReceiptReady = false
    plan.typedFunctionReferenceAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.typedFunctionReferenceAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.typedFunctionReferenceAllocatorReceiptReady = false
    plan.typedFunctionIndexAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.typedFunctionIndexAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.typedFunctionIndexAllocatorReceiptReady = false
    plan.typedFunctionIdentityAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.typedFunctionIdentityAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.typedFunctionIdentityAllocatorReceiptReady = false
    plan.resolvedCallFactAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.resolvedCallFactAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.resolvedCallFactAllocatorReceiptReady = false
    plan.importGraphAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.importGraphAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.importGraphAllocatorReceiptReady = false
    plan.importEdgeIndexAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.importEdgeIndexAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.importEdgeIndexAllocatorReceiptReady = false
    plan.importOwnerIndexAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.importOwnerIndexAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.importOwnerIndexAllocatorReceiptReady = false
    plan.unqualifiedImportResolveCacheAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.unqualifiedImportResolveCacheAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.unqualifiedImportResolveCacheAllocatorReceiptReady = false
    plan.qualifiedImportResolveCacheAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.qualifiedImportResolveCacheAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.qualifiedImportResolveCacheAllocatorReceiptReady = false
    plan.moduleSourceIndexAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.moduleSourceIndexAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.moduleSourceIndexAllocatorReceiptReady = false
    plan.fnPtrFieldCallAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.fnPtrFieldCallAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.fnPtrFieldCallAllocatorReceiptReady = false
    plan.typeArenaOwnerProofAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.typeArenaOwnerProofAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.typeArenaOwnerProofAllocatorReceiptReady = false
    plan.functionSemanticIdentityAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.functionSemanticIdentityAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.functionSemanticIdentityAllocatorReceiptReady = false
    plan.functionRuntimeIdentityAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.functionRuntimeIdentityAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.functionRuntimeIdentityAllocatorReceiptReady = false
    plan.functionEmissionMetadataAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.functionEmissionMetadataAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.functionEmissionMetadataAllocatorReceiptReady = false
    plan.semanticDebugProjectionAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.semanticDebugProjectionAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.semanticDebugProjectionAllocatorReceiptReady = false
    plan.compilerCsgLifecycleInitialBufferCount =
        ccsg.CompilerCsgLifecycleTrackedPhysicalBufferCount(
            compilerCsg)
    plan.compilerCsgLifecycleInitialBytes =
        ccsg.CompilerCsgLifecycleRetainedBytes(compilerCsg)
    plan.compilerCsgLifecycleReleasedBufferCount = 0
    plan.compilerCsgLifecycleReleasedBytes = int64(0)
    plan.compilerCsgLifecycleTransferredBufferCount = 0
    plan.compilerCsgLifecycleTransferredBytes = int64(0)
    plan.compilerCsgLifecycleTransferredReleaseRecorded = false
    LoweringDebugLine("lowering_plan_after_plan_init")
    # Validate and physically release the full expression payload before source
    # closure/import-index construction adds any more live memory.
    if compilerCsg.semanticGraph.builderName !=
       "BuildCompilerCsgSemanticConsumeEntryTextInto":
        err = " lowering plan: compiler csg semantic graph missing"
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    if compilerCsg.typedExprFacts.count != 0:
        err = Fmt" lowering plan: forbidden typed-expr facts must be empty count={compilerCsg.typedExprFacts.count}"
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    if !LoweringValidateCompilerCsgSemanticCompactExprContract(compilerCsg, err):
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    # Observe typed_expr and CSG while their producer-owned immutable bytes
    # are still live.  The collector consumes borrowed views only.
    var sevenStageActive = ssr.SevenStageReceiptActive()
    var sevenStageIdentity: ssr.SevenStageSourceIdentity
    if sevenStageActive:
        sevenStageIdentity = ssr.SevenStageSourceIdentityResolve(
            layout.FixedBytes32Hex(linkPlan.sourceBundleCidValue))
        let typedExprSidecar =
            texpr.TypedExprIrReportText(compilerCsg.typedIr)
        let typedExprArtifact =
            LoweringSevenStageTypedExprArtifact(compilerCsg)
        if !ssr.SevenStageReceiptObserve(
            ssr.SevenStageReceiptStageTypedExpr,
            ssr.SevenStageReceiptLaneShared,
            sevenStageIdentity,
            "src/core/backend/lowering_plan.cheng",
            rawbytes.BytesFromString(typedExprSidecar),
            rawbytes.BytesFromString(typedExprArtifact)):
            err = " lowering plan: typed-expr seven-stage receipt write failed"
            return LoweringAbortCompilerCsgBind(compilerCsg, plan)
        let csgSidecar =
            ccsg.CompilerCsgCanonicalSidecarReport(compilerCsg)
        let csgArtifact = ccsg.CompilerCsgWireReport(compilerCsg)
        if !ssr.SevenStageReceiptObserve(
            ssr.SevenStageReceiptStageCsg,
            ssr.SevenStageReceiptLaneShared,
            sevenStageIdentity,
            "src/core/tooling/compiler_csg.cheng",
            rawbytes.BytesFromString(csgSidecar),
            rawbytes.BytesFromString(csgArtifact)):
            err = " lowering plan: csg seven-stage receipt write failed"
            return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    plan.typedExprFactCountSnapshot = compilerCsg.typedExprFactCountSnapshot
    plan.exprSummary = compilerCsg.semanticGraph.exprSummary
    plan.compilerCsgExprSliceSidecarCount = compilerCsg.semanticGraph.exprSliceTable.sourceIndex.len
    plan.compilerCsgExprSliceSidecarComplete = compilerCsg.semanticGraph.exprSliceTypedFactComplete
    plan.compilerCsgExprSliceSidecarCoveredCount = compilerCsg.semanticGraph.exprSliceTypedFactCoveredCount
    plan.compilerCsgExprSliceSidecarGapCount = compilerCsg.semanticGraph.exprSliceTypedFactGapCount
    plan.compilerCsgExprSliceSidecarOverlapCount = compilerCsg.semanticGraph.exprSliceTypedFactOverlapCount
    plan.compilerCsgExprSliceSidecarInvalidSliceCount = compilerCsg.semanticGraph.exprSliceTypedFactInvalidSliceCount
    plan.compilerCsgExprSliceSidecarSyntheticCount = compilerCsg.semanticGraph.exprSliceSyntheticCount
    plan.compilerCsgExprSliceSidecarValidationReason = compilerCsg.semanticGraph.exprSliceValidationReason
    plan.compilerCsgExprSliceSidecarFunctionBoundCount = compilerCsg.semanticGraph.exprSliceFunctionBoundCount
    plan.compilerCsgExprSliceSidecar = compilerCsg.semanticGraph.exprSliceTable
    compilerCsg.semanticGraph.exprSliceTable = ccsg.CompilerCsgSemanticExprSliceTable()
    if compilerCsg.semanticGraph.typedFactTable.sourceIndexes.len != plan.typedExprFactCountSnapshot:
        err = Fmt" lowering plan: typed-fact snapshot count mismatch expected={plan.typedExprFactCountSnapshot} actual={compilerCsg.semanticGraph.typedFactTable.sourceIndexes.len}"
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    if !LoweringValidateCompilerCsgExprSliceSidecar(plan, err):
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    plan.typedExprTypeCallDefaultInitCountSnapshot = compilerCsg.semanticGraph.typedFactTable.typeCallDefaultInitCount
    plan.typedExprTypeCallConstructorCountSnapshot = compilerCsg.semanticGraph.typedFactTable.typeCallConstructorCount
    plan.typedFactSummary = compilerCsg.semanticGraph.typedFactTable.summary
    plan.resolvedCallSnapshot = compilerCsg.semanticGraph.resolvedCallTable
    compilerCsg.semanticGraph.resolvedCallTable = ccsg.CompilerCsgSemanticResolvedCallTable()
    if !LoweringValidateResolvedCallSnapshot(plan,
                                             compilerCsg.typedIr.functions2_functionNameIds.len,
                                             err):
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    if !LoweringBindResolvedCallTargetTypedFunctionIndexes(
           compilerCsg, plan, err):
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    if !ccsg.CompilerCsgBuildManualConsumeCallTokensInto(
           plan.resolvedCallSnapshot,
           compilerCsg.typedIr,
           plan.resolvedCallTargetTypedFunctionIndexes,
           plan.manualConsumeCallBridge.tokens,
           err):
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    LoweringReleaseCompilerCsgCompactExprPayload(compilerCsg, plan)
    if !LoweringCompilerCsgCompactExprPayloadReleased(compilerCsg):
        err = " lowering plan: compact expression payload retained before source closure"
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    plan.compactExprPayloadReleasedBeforeSourceClosure = true
    LoweringDebugLine("lowering_plan_after_compact_expr_release")
    let workspaceRoot = linkPlan.workspaceRoot
    LoweringDebugLine("lowering_plan_after_workspace_root")
    let packageRoot = linkPlan.packageRoot
    LoweringDebugLine("lowering_plan_after_package_root")
    slplan.SystemLinkPlanSourceBundleOwnerPayloadReadBorrowed(
        sourceBundleOwner)
    LoweringDebugLine("lowering_plan_after_external_roots")
    let packageId = linkPlan.packageId
    LoweringDebugLine("lowering_plan_after_package_id")
    let entryPath = linkPlan.entryPath
    LoweringDebugLine("lowering_plan_after_entry_path")
    let entrySymbol = linkPlan.entrySymbol
    LoweringDebugLine("lowering_plan_after_entry_symbol")
    LoweringProgress("source_closure_begin")
    if !plan.compactExprPayloadReleasedBeforeSourceClosure ||
       !LoweringCompilerCsgCompactExprPayloadReleased(compilerCsg):
        err = " lowering plan: source closure entered before compact expression payload release"
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    LoweringDebugLine("lowering_plan_before_source_closure")
    LoweringDebugLine(
        Fmt"lowering_plan_source_closure_owner rows={sourceBundleOwner.sourceRowIndexes.len} edges={sourceBundleOwner.importEdgeRowIndexes.len}")
    var typedClosureCount: int32
    typedClosureCount = compilerCsg.typedIr.sourceContextIndexSourcePaths.len
    if typedClosureCount > 0:
        LoweringDebugLine(Fmt"lowering_plan_typed_source_closure count={typedClosureCount}")
    else:
        LoweringDebugLine("lowering_plan_source_closure_structured_only")
    LoweringDebugLine(
        Fmt"lowering_plan_after_source_closure_resolve count={sourceBundleOwner.sourceRowIndexes.len}")
    LoweringProgress("source_closure_done")
    LoweringDebugLine("lowering_plan_before_plan_bind")
    plan.workspaceRoot = workspaceRoot
    LoweringDebugLine("lowering_plan_after_plan_workspace")
    plan.packageRoot = packageRoot
    LoweringDebugLine("lowering_plan_after_plan_package_root")
    plan.packageId = packageId
    LoweringDebugLine("lowering_plan_after_plan_package_id")
    plan.entryPath = entryPath
    LoweringDebugLine("lowering_plan_after_plan_entry_path")
    plan.entrySymbol = entrySymbol
    plan.sourceEntryTypedFunctionIndex = -1
    LoweringDebugLine("lowering_plan_after_plan_entry_symbol")
    plan.requestedJobCount = slplan.SystemLinkPlanJobCount(linkPlan)
    LoweringDebugLine("lowering_plan_after_plan_job_count")
    LoweringPlanReleaseImportGraphPayload(plan)
    LoweringImportGraphAllocatorBegin(plan)
    for planImportEdgeOrdinal in 0..<
            sourceBundleOwner.importEdgeRowIndexes.len:
        let planImportEdgeIndex =
            slplan.SystemLinkPlanSourceBundleOwnerImportEdgeRowAtBorrowed(
                sourceBundleOwner, planImportEdgeOrdinal)
        if planImportEdgeIndex < 0 ||
           planImportEdgeIndex >= sourceBundleOwner.importEdges.len:
            err = Fmt" lowering plan: import edge row out of range ordinal={planImportEdgeOrdinal} row={planImportEdgeIndex}"
            return LoweringAbortCompilerCsgBind(
                compilerCsg, plan)
        LoweringImportGraphAppendBorrowedEdge(
            plan,
            sourceBundleOwner.importEdges[planImportEdgeIndex])
    LoweringBuildImportEdgeIndex(plan)
    LoweringDebugLine("lowering_plan_after_plan_import_edges")
    plan.sourceBundleCid = compilerCsg.sourceBundleCid
    LoweringDebugLine("lowering_plan_after_plan_source_cid")
    plan.compilerCsgCid = compilerCsg.graphCid
    LoweringDebugLine("lowering_plan_after_plan_csg_cid")
    if !LoweringPlanIssueToolchainEncoderBuildProjectionInto(
           compilerExecution,
           semanticSnapshot,
           semanticSnapshotLoweringAuthority,
           workspaceRoot,
           plan,
           err):
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    if false:
        LoweringProgress("resolved_call_index_begin")
    LoweringBuildResolvedCallFactIndex(plan)
    LoweringDebugLine("lowering_plan_after_resolved_call_index")
    if false:
        LoweringProgress("resolved_call_index_done")
    if false:
        LoweringProgress("typed_ir_bind_begin")
    LoweringDebugLine("lowering_plan_before_typed_ir_empty_check")
    var compilerTypedFunctionCount: int32
    compilerTypedFunctionCount = compilerCsg.typedIr.functions2_functionNameIds.len
    var compilerNodeCount: int32
    compilerNodeCount = compilerCsg.nodes.len
    if compilerTypedFunctionCount <= 0:
        if compilerNodeCount > 0:
            err = " lowering plan: compiler csg typed ir missing"
            return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    LoweringDebugLine("lowering_plan_after_typed_ir_empty_check")
    if !ccsg.CompilerCsgFnPtrFieldCallTableStrictValidateInto(
           compilerCsg, err):
        return LoweringAbortCompilerCsgBind(
            compilerCsg, plan)
    texpr.TypedExprIrMoveInto(plan.typedIr, compilerCsg.typedIr)
    LoweringDebugLine("lowering_plan_after_typed_ir_move")
    if !LoweringBindCanonicalFunctionInterfaces(
           semanticSnapshot,
           semanticSnapshotLoweringAuthority,
           plan,
           err):
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    claimedSnapshotAuthorityReleaseRequired = false
    if !LoweringPlanFunctionInterfaceBindingsStrictValidateInto(
           semanticSnapshot, plan, err) ||
       !LoweringBindExternFfiHandleCallCapabilityBridge(
           compilerCsg, plan, err) ||
       !LoweringExternFfiHandleCallCapabilityBridgeStrictValidateInto(
           plan, err) ||
       !LoweringBindManualConsumeCallBridge(
           semanticSnapshot, plan, err) ||
       !LoweringManualConsumeCallBridgeStrictValidateInto(
           semanticSnapshot, plan, err):
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    LoweringDebugLine(
        "lowering_plan_after_function_interface_snapshot_bind")
    if !LoweringBindCanonicalTypeArenaProofs(
           compilerCsg, plan, err):
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    LoweringDebugLine("lowering_plan_after_type_arena_proof_bind")
    if !LoweringBuildTypedFunctionIdentityIndex(plan, err):
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    LoweringDebugLine("lowering_plan_after_typed_function_identity_index")
    if !LoweringBuildModuleSourceIndex(plan,
                                        sourceBundleOwner,
                                        err):
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    LoweringDebugLine(Fmt"lowering_plan_after_module_source_index sources={plan.moduleSourceIndexSourceCountSnapshot} visits={plan.moduleSourceIndexBuildBucketVisitCount}")
    LoweringPlanReleaseFunctionRuntimeIdentityPayload(plan)
    LoweringPlanReleaseFunctionEmissionMetadataPayload(plan)
    LoweringPlanReleaseSemanticIdentityPayload(plan)
    LoweringFunctionRuntimeIdentityAllocatorBegin(plan)
    LoweringFunctionEmissionMetadataAllocatorBegin(plan)
    LoweringFunctionSemanticIdentityAllocatorBegin(plan)
    plan.functionNameInternPoolDomainCid =
        LoweringFunctionNameInternPoolDomainCid(plan)
    plan.functionNameIdentityReceiptCid = layout.FixedBytes32()
    var typedFunctionClaimScratch: LoweringCompilerCsgBindTypedFunctionClaimScratchOwner
    loweringSequenceAllocatorSetLen(
        typedFunctionClaimScratch,
        LoweringCompilerCsgBindTypedFunctionClaimScratchLength(
            length: plan.typedIr.functions2_functionNameIds.len))
    if false:
        LoweringProgress("typed_ir_bind_done")
    if false:
        LoweringProgress("symbol_rows_begin")
    LoweringDebugLine("lowering_plan_before_symbol_rows")
    var compilerSymbolNodeCount: int32
    compilerSymbolNodeCount = compilerCsg.nodes.len
    # Read CHENG_EXP_DBG once: per-node os.GetEnv in this loop allocates ~32B
    # per probe across every csg symbol node.
    let expdbgEnabled = os.GetEnv("CHENG_EXP_DBG") != ""
    var i: int32
    while i < compilerSymbolNodeCount:
        let node = compilerCsg.nodes[i]
        i = i + 1
        if node.nodeKind != ccsg.CompilerCsgNodeKindSymbol:
            continue
        if expdbgEnabled:
            os.WriteLine(os.GetStderr(), Fmt"expdbg lownode fn={node.factText} exported={strings.IntToStr(node.exportedFlag)} alias={node.exportSymbolName} module={node.modulePath}")
        var sourcePath: str
        if !LoweringModuleSourceIndexLookup(plan,
                                            node.semanticSource,
                                            sourcePath,
                                            err):
            LoweringCompilerCsgBindTypedFunctionClaimScratchClose(
                typedFunctionClaimScratch)
            return LoweringAbortCompilerCsgBind(compilerCsg, plan)
        var moduleSourcePath = strings.CloneStr(sourcePath)
        if node.modulePath != node.semanticSource:
            if !LoweringModuleSourceIndexLookup(plan,
                                                node.modulePath,
                                                moduleSourcePath,
                                                err):
                LoweringCompilerCsgBindTypedFunctionClaimScratchClose(
                    typedFunctionClaimScratch)
                return LoweringAbortCompilerCsgBind(compilerCsg, plan)
        if expdbgEnabled:
            os.WriteLine(os.GetStderr(), Fmt"expdbg lowsrc fn={node.factText} source=[{sourcePath}] typed_fns={strings.IntToStr(plan.typedIr.functions2_functionNameIds.len)}")
        if sourcePath == "" || moduleSourcePath == "" ||
           sourcePath != moduleSourcePath:
            err = Fmt" lowering plan: compiler csg semantic source mismatch semantic={node.semanticSource} module={node.modulePath} semantic_path={sourcePath} module_path={moduleSourcePath} function={node.factText}"
            LoweringCompilerCsgBindTypedFunctionClaimScratchClose(
                typedFunctionClaimScratch)
            return LoweringAbortCompilerCsgBind(compilerCsg, plan)
        if !LoweringAppendCompilerCsgSemanticFunctionRow(plan,
                                                          node,
                                                          sourcePath,
                                                          typedFunctionClaimScratch.typedFunctionClaimed,
                                                          err):
            LoweringCompilerCsgBindTypedFunctionClaimScratchClose(
                typedFunctionClaimScratch)
            return LoweringAbortCompilerCsgBind(compilerCsg, plan)
        if expdbgEnabled && node.exportedFlag != 0:
            os.WriteLine(os.GetStderr(), Fmt"expdbg lowrow fn={node.factText} alias={node.exportSymbolName}")
    LoweringPlanReleaseModuleSourceIndexPayload(plan)
    LoweringDebugLine(Fmt"lowering_plan_after_symbol_rows count={plan.functionNames.len}")
    if false:
        LoweringProgress("symbol_rows_done")
    var functionRowsFromCsgNodesCount: int32
    functionRowsFromCsgNodesCount = plan.functionNames.len
    plan.functionRowsFromCsgNodes = functionRowsFromCsgNodesCount
    LoweringDebugLine(Fmt"lowering_plan_after_function_rows_from_csg count={functionRowsFromCsgNodesCount}")
    if false:
        LoweringProgress("function_rows_from_typed_ir_begin")
    LoweringDebugLine("lowering_plan_before_retain_typed_closure")
    var retainTypedClosureFunctions: bool
    if linkPlan.emitKind == creq.EmitExe:
        retainTypedClosureFunctions = true
    elif linkPlan.emitKind == creq.EmitObj:
        retainTypedClosureFunctions = true
    elif linkPlan.emitKind == creq.EmitShared:
        retainTypedClosureFunctions = true
    else:
        var typedFactCountForRetain: int32
        typedFactCountForRetain = plan.typedExprFactCountSnapshot
        var typedFunctionCountForRetain: int32
        typedFunctionCountForRetain = plan.typedIr.functions2_functionNameIds.len
        if plan.functionRowsFromCsgNodes <= 1:
            if typedFactCountForRetain <= 0:
                if typedFunctionCountForRetain > 1:
                    retainTypedClosureFunctions = true
    LoweringDebugLine("lowering_plan_after_retain_typed_closure")
    if !LoweringValidateCompilerCsgFuncRefTargets(
            plan, compilerCsg, err):
        LoweringCompilerCsgBindTypedFunctionClaimScratchClose(
            typedFunctionClaimScratch)
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    if !retainTypedClosureFunctions:
        if !LoweringBuildTypedFunctionReferenceIndex(plan,
                                                      compilerCsg,
                                                      typedFunctionClaimScratch.typedFunctionClaimed,
                                                      err):
            LoweringCompilerCsgBindTypedFunctionClaimScratchClose(
                typedFunctionClaimScratch)
            return LoweringAbortCompilerCsgBind(compilerCsg, plan)
        LoweringDebugLine(Fmt"lowering_plan_after_function_reference_index referenced={plan.typedFunctionReferenceReferencedFunctionCount} lookups={plan.typedFunctionReferenceResolveLookupCount} visits={plan.typedFunctionReferenceResolveBucketVisitCount}")
    LoweringReleaseCompilerCsgAfterBind(compilerCsg, plan)
    LoweringDebugLine("lowering_plan_after_compiler_csg_release")
    if false:
        LoweringProgress("compiler_csg_release_done")
    LoweringDebugLine("lowering_plan_before_typed_function_rows")
    if os.GetEnv("CHENG_LOWERING_TRACE_FILTER") == "ref_dbg":
        for refDbgIndex in 0..<plan.typedIr.statements2_statementIndexs.len:
            let refDbgCallTargetRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_callTargetIds[refDbgIndex])
            let refDbgCallTargetSourcePathRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_callTargetSourcePathIds[refDbgIndex])
            let refDbgSourcePathRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.statements2_sourcePathIds[refDbgIndex])
            if !IsOk(refDbgCallTargetRes) || !IsOk(refDbgCallTargetSourcePathRes) || !IsOk(refDbgSourcePathRes):
                continue
            let refDbgCallTarget = Value(refDbgCallTargetRes)
            let refDbgCallTargetSourcePath = Value(refDbgCallTargetSourcePathRes)
            let refDbgSourcePath = Value(refDbgSourcePathRes)
            if strutil.Contains(refDbgCallTarget, "DispatchMinPrintLine"):
                LoweringDebugLine(Fmt"ref_dbg stmt target={refDbgCallTarget} target_source={refDbgCallTargetSourcePath} importc={plan.typedIr.statements2_callTargetImportcs[refDbgIndex]} stmt_source={refDbgSourcePath} line={arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.statements2_lineNumbers, refDbgIndex)}")
        for refDbgIndex in 0..<LoweringResolvedCallSnapshotRowCount(plan):
            let refDbgFact = LoweringResolvedCallSnapshotFactAt(plan, refDbgIndex)
            if strutil.Contains(refDbgFact.callTarget, "DispatchMinPrintLine"):
                LoweringDebugLine(Fmt"ref_dbg fact target={refDbgFact.callTarget} target_source={refDbgFact.callTargetSourcePath} resolved={refDbgFact.callResolved} importc={refDbgFact.callTargetImportc} fact_source={refDbgFact.sourcePath} line={refDbgFact.lineNumber}")
    var typedFunctionRowCount: int32
    typedFunctionRowCount = plan.typedIr.functions2_functionNameIds.len
    var fnIndex: int32
    while fnIndex < typedFunctionRowCount:
        let typedRowIndex = fnIndex
        let fnSourceRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_sourcePathIds[typedRowIndex])
        let fnNameRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_functionNameIds[typedRowIndex])
        let fnReturnRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_returnTypeIds[typedRowIndex])
        let signatureLineNumber = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_signatureLineNumbers, typedRowIndex)
        let fnBodyLineNumber = arenamod.ArenaArrayInt32Get(plan.typedIr.arena, plan.typedIr.functions2_bodyLineNumbers, typedRowIndex)
        fnIndex = fnIndex + 1
        if !IsOk(fnSourceRes) || !IsOk(fnNameRes) || !IsOk(fnReturnRes):
            err = Fmt" lowering plan: typed ir function row intern missing index={typedRowIndex}"
            LoweringCompilerCsgBindTypedFunctionClaimScratchClose(
                typedFunctionClaimScratch)
            return LoweringAbortCompilerCsgBind(compilerCsg, plan)
        let fnSourcePath = Value(fnSourceRes)
        let functionName = Value(fnNameRes)
        if fnBodyLineNumber == 0:
            continue
        if typedRowIndex <
               typedFunctionClaimScratch.typedFunctionClaimed.len &&
           typedFunctionClaimScratch.typedFunctionClaimed[
               typedRowIndex]:
            if LoweringRowDebugEnabled() &&
               functionName == loweringRowDebugName:
                LoweringDebugLine(Fmt"typed_row_dedup_skip name={functionName} source={fnSourcePath}")
            continue
        let isEntryFunction =
            typedRowIndex == plan.sourceEntryTypedFunctionIndex
        if !retainTypedClosureFunctions:
            if !isEntryFunction:
                if !LoweringPlanTypedFunctionIndexIsReferenced(plan, typedRowIndex) &&
                   !LoweringFunctionIsBackendSyntheticRoot(fnSourcePath, functionName):
                    if LoweringTraceOn():
                        LoweringDebugLine(Fmt"symbol_drop typed_row name={functionName} source={fnSourcePath}")
                    continue
        let ownerModulePath = parser.ParserSourcePathToModulePathWithExternalPackageRoots(workspaceRoot,
                                                                                           packageRoot,
                                                                                           sourceBundleOwner.externalPackageRoots,
                                                                                           fnSourcePath)
        var functionEntryFlag: int32
        if isEntryFunction:
            functionEntryFlag = 1
        LoweringFunctionRuntimeIdentityAppendRow(
            plan,
            fnSourcePath,
            functionName,
            LoweringFunctionSymbolText(ownerModulePath, functionName),
            0,
            "",
            functionEntryFlag)
        var functionResultLayoutKind = LoweringLayoutKindInvalid()
        if texpr.TypedExprNormalizeTypeText(
               Value(fnReturnRes)) == "int32":
            functionResultLayoutKind = LoweringLayoutKindI32()
        LoweringFunctionEmissionMetadataAppendRow(
            plan,
            ownerModulePath,
            LoweringCallConvInternal(),
            functionResultLayoutKind,
            signatureLineNumber,
            0)
        LoweringFunctionSemanticIdentityAppendRow(
            plan,
            ownerModulePath,
            signatureLineNumber,
            "",
            Value(fnReturnRes),
            0,
            typedRowIndex)
        typedFunctionClaimScratch.typedFunctionClaimed[
            typedRowIndex] = true
    LoweringCompilerCsgBindTypedFunctionClaimScratchClose(
        typedFunctionClaimScratch)
    LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
    if !LoweringBuildExactFunctionNameIdentityColumn(plan, err):
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    if !LoweringValidateFunctionSemanticIdentityRows(plan, err):
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    LoweringDebugLine(Fmt"lowering_plan_after_typed_function_rows count={plan.functionNames.len}")
    if false:
        LoweringProgress("function_rows_from_typed_ir_done")
    if !LoweringFunctionNameIdentityStrictValid(plan):
        err = " lowering plan: exact function name identity invalid"
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    LoweringDebugLine("lowering_plan_after_exact_name_ids")
    var missingReasons: str[]
    if plan.functionNames.len <= 0:
        add(missingReasons, "lowering_functions_missing")
    elif len(entrySymbol) > 0:
        var entryLowered: bool
        var entryFlagIndex: int32
        var entryFlagCount: int32
        entryFlagCount = plan.functionEntryFlags.len
        while entryFlagIndex < entryFlagCount:
            if plan.functionEntryFlags[entryFlagIndex] != 0:
                entryLowered = true
            entryFlagIndex = entryFlagIndex + 1
        if !entryLowered:
            add(missingReasons, "lowering_entry_function_missing")
    LoweringDebugLine(Fmt"lowering_plan_after_missing_reasons count={missingReasons.len}")
    if false:
        LoweringProgress("typed_function_index_begin")
    LoweringBuildTypedFunctionIndex(plan)
    LoweringBuildFunctionDenseStore(plan)
    if !LoweringValidateResolvedCallTargets(plan, err):
        return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    LoweringDebugLine("lowering_plan_after_dense_store_build")
    if false:
        LoweringProgress("typed_function_index_done")
    if false:
        LoweringProgress("return_ops_begin")
    plan.typedReturnOps = []
    LoweringDebugLine("lowering_plan_after_return_ops_clear")
    if false:
        LoweringProgress("return_ops_done")
    var typedSourceTexts: texpr.TypedExprSourceText[]
    LoweringDebugLine("lowering_plan_after_source_texts_init")
    if false:
        LoweringProgress("source_texts_begin")
    if false:
        LoweringProgress("source_texts_done")
    if false:
        LoweringProgress("primary_object_ir_begin")
    var primaryBuildFlags: bool[]
    LoweringDebugLine("lowering_plan_before_primary_build_flags")
    let loweringEmitKind = linkPlan.emitKind
    let fullMaterializeExe = strutil.Strip(os.GetEnv("CHENG_FULL_MATERIALIZE_EXE")) == "1"
    if loweringEmitKind == creq.EmitExe && fullMaterializeExe:
        LoweringDebugLine("lowering_plan_primary_flags_exe_full_materialize")
        plan.primaryObjectIrBuildMode = "exe_full_materialization"
        primaryBuildFlags = []
    elif loweringEmitKind == creq.EmitExe:
        LoweringDebugLine("lowering_plan_primary_flags_exe")
        plan.primaryObjectIrBuildMode = "exe_entry"
        plan.primaryObjectIrReachableFirst = 1
        primaryBuildFlags = LoweringBuildExecutableReachableFunctionFlags(plan)
    elif loweringEmitKind == creq.EmitObj:
        LoweringDebugLine("lowering_plan_primary_flags_obj")
        plan.primaryObjectIrExportRootCount = linkPlan.exportRootSymbols.len
        # C5 流水化 (§3.4 真解): emit obj 一律不在 lowering 相物化
        # PrimaryObjectIrStatement 字符串层 (真根: 全量物化 139,049 语句 ×
        # ~44KB 同时常驻, +6.2GB 峰值), 全部建骨架行 (buildFlags 全 false →
        # LoweringFillSkippedPrimaryObjectIrDescriptor), 让 primary 相的精确
        # bodyIR 级 reachability + EnsureFunctionLowered 按需重建单函数接管 +
        # Step2 用完即释 (PrimaryObjectPlanReleaseLazyFunctionStatements)。lazy
        # 与 export roots 裁剪正交 (primary 侧 PrimaryObjectPlanExportRootMatches
        # 直接读 linkPlan.exportRootSymbols 做精确 reachability, 不依赖 lowering
        # 侧的粗剪), 这统一了此前 object_export_roots / object_export_roots_prepruned
        # 分支残留的全量 eager 物化路径。唯一保留 = 显式 export root 的歧义校验
        # (原 LoweringBuildObjectReachableFunctionFlags 的 missingReasons 副作用)。
        var exportRootIndex: LoweringExportRootIndex
        if !LoweringBuildExportRootIndex(plan, exportRootIndex, err):
            return LoweringAbortCompilerCsgBind(compilerCsg, plan)
        for rootIndex in 0..<linkPlan.exportRootSymbols.len:
            let root = linkPlan.exportRootSymbols[rootIndex]
            let objRootFunctionIndex = LoweringExportRootIndexLookup(
                exportRootIndex,
                root)
            if objRootFunctionIndex == -2:
                add(missingReasons, Fmt"lowering_export_root_ambiguous:{root}")
        LoweringExportRootIndexReleasePayload(exportRootIndex)
        plan.primaryObjectIrBuildMode = "object_all_lazy"
        plan.primaryObjectIrReachableFirst = 1
        for _skeletonI in 0..<plan.functionNames.len:
            add(primaryBuildFlags, false)
    else:
        LoweringDebugLine("lowering_plan_primary_flags_full")
        plan.primaryObjectIrBuildMode = "full_materialization"
        primaryBuildFlags = []
    LoweringDebugLine(Fmt"lowering_plan_after_primary_build_flags count={primaryBuildFlags.len}")
    LoweringBuildPrimaryObjectIrInPlan(plan,
                                        typedSourceTexts,
                                        primaryBuildFlags)
    LoweringDebugLine("lowering_plan_after_primary_object_ir_build")
    LoweringPlanCapturePrimaryObjectLineRows(plan)
    LoweringDebugLine("lowering_plan_after_primary_object_line_rows")
    # All source/name lookups are complete once primary rows and line rows have
    # been materialized. The dense store remains the runtime owner; this drops
    # only the bounded lookup sidecar at its true last consumer.
    LoweringPlanReleaseTypedFunctionLookupSidecarPayload(plan)
    LoweringDebugLine("lowering_plan_after_typed_function_lookup_sidecar_release")
    for sourceTextIndex in 0..<typedSourceTexts.len:
        texpr.TypedExprClearSourceTextAllFields(typedSourceTexts[sourceTextIndex])
    if true:
        typedSourceTexts = []
    LoweringDebugLine("lowering_plan_after_typed_source_texts_clear")
    if false:
        LoweringProgress("primary_object_ir_done")
        LoweringProgress("lowering_rules_begin")
    plan.loweringRuleCount = plan.typedExprFactCountSnapshot
    if false:
        plan.loweringRules = []
        LoweringProgress("lowering_rules_done")
    LoweringDebugLine("lowering_plan_after_lowering_rules")
    if missingReasons.len > 0:
        plan.missingReasons = missingReasons
    LoweringDebugLine("lowering_plan_after_missing_reasons_store")
    plan.pipelineStage = "canonical_csg_to_lowering_plan"
    LoweringDebugLine("lowering_plan_after_pipeline_stage")
    if sevenStageActive:
        let loweringSidecar = LoweringPlanStubReport(plan)
        let loweringArtifact = LoweringSevenStageBodyIrArtifact(plan)
        if !ssr.SevenStageReceiptObserve(
            ssr.SevenStageReceiptStageLowering,
            ssr.SevenStageReceiptLaneShared,
            sevenStageIdentity,
            "src/core/backend/lowering_plan.cheng",
            rawbytes.BytesFromString(loweringSidecar),
            rawbytes.BytesFromString(loweringArtifact)):
            err = " lowering plan: lowering seven-stage receipt write failed"
            return LoweringAbortCompilerCsgBind(compilerCsg, plan)
    primaryBuildFlags = []
    missingReasons = []
    LoweringDebugLine("lowering_plan_after_temp_arrays_clear")
    err = ""
    LoweringDebugLine("lowering_plan_before_success_return")
    return true

fn BuildLoweringPlanStubFromCompilerCsgBorrowed(linkPlan: var slplan.SystemLinkPlanStub,
                                                  compilerCsg: var ccsg.CompilerCsg,
                                                  plan: var LoweringPlanStub,
                                                  err: var str): bool =
    err =
        " lowering plan: canonical semantic snapshot input is required"
    return false

fn BuildLoweringPlanStubFromCompilerCsg(linkPlan: slplan.SystemLinkPlanStub,
                                          compilerCsg: var ccsg.CompilerCsg,
                                          plan: var LoweringPlanStub,
                                          err: var str): bool =
    err =
        " lowering plan: canonical semantic snapshot input is required"
    return false

fn loweringPlanReleaseTypedReturnOps(
        values: var texpr.TypedExprReturnOpFact[]) =
    for returnOpIndex in 0..<values.len:
        values[returnOpIndex].sourcePath = ""
        values[returnOpIndex].functionName = ""
        values[returnOpIndex].returnType = ""
        values[returnOpIndex].lhsName = ""
        values[returnOpIndex].lhsType = ""
        values[returnOpIndex].rhsName = ""
        values[returnOpIndex].rhsType = ""
        values[returnOpIndex].accName = ""
        values[returnOpIndex].accType = ""
        values[returnOpIndex].returnExpr = ""
    seqs.chengSeqFreeTyped(values)

fn loweringPlanReleaseLoweringRules(
        values: var texpr.TypedExprLoweringRule[]) =
    for ruleIndex in 0..<values.len:
        values[ruleIndex].exprId = ""
        values[ruleIndex].sourcePath = ""
        values[ruleIndex].callQualifier = ""
        values[ruleIndex].callCallee = ""
        values[ruleIndex].callTarget = ""
        values[ruleIndex].callTargetSourcePath = ""
        values[ruleIndex].callArgsText = ""
        values[ruleIndex].typeText = ""
    seqs.chengSeqFreeTyped(values)

fn LoweringPlanReleasePrePrimaryObjectPayload(plan: var LoweringPlanStub) =
    let lifecycleBeforeBufferCount =
        LoweringPlanLifecycleTrackedPhysicalBufferCount(plan)
    let lifecycleBeforeBytes =
        LoweringPlanLifecycleTrackedRetainedBytes(plan)
    # reachableFirst 模式（exe_entry / object_all_lazy）下 primary 相必定发生懒物化：
    # 骨架函数经 EnsureFunctionLowered、已物化的 StatementSequence 函数（含 entry）
    # 经 PrimaryBuildBodyIrForFunction 二次 LoweringBuildOneFunctionInto，两者都经
    # LoweringAttachDeferScopeTransport 读 typedIr.statements2。skipped>0 只是「存在
    # 骨架函数」的充分条件而非懒物化的必要条件——skipped=0 的纯 reachable 编译
    # （如单函数程序）同样二次物化，提前清空 statements2 会让二次物化在 defer
    # scope transport 切片判据处必死。故保留判据只看 reachableFirst，与 skipped 无关。
    let keepLazyPrimaryInputs = plan.primaryObjectIrReachableFirst != 0
    # compact resolved-call snapshot 是 primary 精确调用身份的正式输入，不由 emit
    # 模式或 skipped-function 数量决定生命周期。全量 typed facts 仍按原合同释放；
    # snapshot 与其索引统一推迟到 primary 尾回收。
    LoweringNormalizedExprLayerTerminalRelease(plan.exprLayer)
    LoweringPlanReleaseCompilerCsgExprSliceSidecar(plan)
    # Primary consumes TypedIR, the resolved-call snapshot and import indexes;
    # no primary/backend2 path consumes the forbidden fact table, including lazy
    # materialization. Release it unconditionally at the handoff boundary.
    texpr.TypedExprFactTableRelease(plan.typedExprFacts)
    # typedIr.nodes 留给 primary 阶段的节点求值器（批次2c）消费；
    # LoweringPlanReleaseAfterPrimaryObjectPlan 整体重置 typedIr 时回收。
    if !keepLazyPrimaryInputs:
        # combo C Phase2: clear statements2_* SoA (was `plan.typedIr.statements = []`
        # on the now-removed AoS). Keeps functions2_/nodes2_ for the primary evaluator.
        texpr.TypedExprIrClearSoAStatementsData(plan.typedIr)
    # Primary target resolution still consumes the import graph even after all
    # function bodies have been materialized. Keep that graph and its exact
    # indexes until LoweringPlanReleaseAfterPrimaryObjectPlan; build mode is not
    # a lifetime proof.
    # Keep both typed-function authorities through primary. The dense store is
    # the exact fast path; the older index remains the required relative versus
    # absolute source-path equivalence path when a CSG import target is absolute
    # but the TypedIR source row is workspace-relative.
    loweringPlanReleaseTypedReturnOps(plan.typedReturnOps)
    loweringPlanReleaseLoweringRules(plan.loweringRules)
    LoweringPlanLifecycleReleaseTrackingRecord(
        plan,
        lifecycleBeforeBufferCount,
        lifecycleBeforeBytes,
        LoweringPlanLifecycleTrackedPhysicalBufferCount(plan),
        LoweringPlanLifecycleTrackedRetainedBytes(plan))

fn LoweringPlanReleasePrimaryImportResolutionPayload(plan: var LoweringPlanStub) =
    LoweringPlanReleaseImportGraphPayload(plan)
    LoweringPlanReleaseImportEdgeIndexPayload(plan)
    LoweringPlanReleaseImportOwnerIndexPayload(plan)
    LoweringPlanReleaseUnqualifiedImportResolveCachePayload(plan)
    LoweringPlanReleaseQualifiedImportResolveCachePayload(plan)

fn LoweringNormalizedExprLayerTerminalRelease(
        layer: var parser.NormalizedExprLayer) =
    var receipt: parser.NormalizedExprLayerTerminalReleaseReceipt
    parser.NormalizedExprLayerTerminalReleaseWithReceipt(
        layer, receipt)

fn LoweringPlanReleaseCompilerCsgExprSliceSidecar(plan: var LoweringPlanStub) =
    seqs.freeSeq(plan.compilerCsgExprSliceSidecar.sourceIndex)
    seqs.freeSeqStrRelease(plan.compilerCsgExprSliceSidecar.sourcePaths)
    seqs.freeSeq(plan.compilerCsgExprSliceSidecar.functionIndex)
    seqs.freeSeq(plan.compilerCsgExprSliceSidecar.exprStart)
    seqs.freeSeq(plan.compilerCsgExprSliceSidecar.exprCount)
    seqs.freeSeq(plan.compilerCsgExprSliceSidecar.typedFactStart)
    seqs.freeSeq(plan.compilerCsgExprSliceSidecar.typedFactCount)
    seqs.freeSeq(
        plan.compilerCsgExprSliceSidecar.typedFactSemanticDigests)
    seqs.freeSeq(
        plan.compilerCsgExprSliceSidecar.typedIrSemanticDigests)
    seqs.freeSeq(
        plan.compilerCsgExprSliceSidecar.typedIrFunctionIndexes)
    seqs.freeSeq(plan.compilerCsgExprSliceSidecar.semanticValidated)
    seqs.freeSeq(plan.compilerCsgExprSliceSidecar.functionSliceIndexes)
    plan.compilerCsgExprSliceSidecar = ccsg.CompilerCsgSemanticExprSliceTable()
    plan.compilerCsgExprSliceSidecarBound = false
    plan.compilerCsgExprSliceSidecarComplete = false
    plan.compilerCsgExprSliceSidecarCount = 0
    plan.compilerCsgExprSliceSidecarFunctionBoundCount = 0
    plan.compilerCsgExprSliceSidecarCoveredCount = 0
    plan.compilerCsgExprSliceSidecarGapCount = 0
    plan.compilerCsgExprSliceSidecarOverlapCount = 0
    plan.compilerCsgExprSliceSidecarInvalidSliceCount = 0
    plan.compilerCsgExprSliceSidecarSyntheticCount = 0
    plan.compilerCsgExprSliceSidecarValidationReason = ""
    plan.compilerCsgExprSliceSidecarRangeQueryCount = 0
    plan.compilerCsgExprSliceSidecarRangeHitCount = 0
    plan.compilerCsgExprSliceSidecarRangeEmptyCount = 0
    plan.compilerCsgExprSliceSidecarRangeFallbackCount = 0

fn LoweringPlanCapturePrimaryObjectLineRows(plan: var LoweringPlanStub) =
    LoweringFunctionEmissionMetadataReleaseLineRowsForReplace(plan)
    for i in 0..<plan.functionNames.len:
        var signatureLineNumber: int32
        var bodyLineNumber: int32
        if i >= 0 && i < plan.primaryObjectIr.functions.len:
            signatureLineNumber = plan.primaryObjectIr.functions[i].signatureLineNumber
            bodyLineNumber = plan.primaryObjectIr.functions[i].bodyLineNumber
        LoweringFunctionEmissionMetadataAppendLineRow(
            plan,
            signatureLineNumber,
            bodyLineNumber)
    if plan.functionSignatureLineNumbers.len !=
           plan.functionOwnerModulePaths.len ||
       plan.functionBodyLineNumbers.len !=
           plan.functionOwnerModulePaths.len:
        panic("lowering function emission metadata allocator: line replacement shape drift")

@borrows
fn LoweringPlanFunctionSignatureLineNumber(plan: LoweringPlanStub,
                                            index: int32): int32 =
    if index >= 0 && index < plan.functionSignatureLineNumbers.len:
        return plan.functionSignatureLineNumbers[index]
    if index >= 0 && index < plan.primaryObjectIr.functions.len:
        return plan.primaryObjectIr.functions[index].signatureLineNumber
    return 0

@borrows
fn LoweringPlanFunctionBodyLineNumber(plan: LoweringPlanStub,
                                       index: int32): int32 =
    if index >= 0 && index < plan.functionBodyLineNumbers.len:
        return plan.functionBodyLineNumbers[index]
    if index >= 0 && index < plan.primaryObjectIr.functions.len:
        return plan.primaryObjectIr.functions[index].bodyLineNumber
    return 0

fn LoweringPlanReleaseResolvedCallSnapshot(plan: var LoweringPlanStub) =
    LoweringExternFfiHandleCallCapabilityBridgeRelease(
        plan.externFfiHandleCallCapabilityBridge)
    LoweringManualConsumeCallBridgeRelease(
        plan.manualConsumeCallBridge)
    ccsg.CompilerCsgSemanticResolvedCallTableRelease(
        plan.resolvedCallSnapshot)

fn LoweringPlanReleaseSemanticIdentityPayload(plan: var LoweringPlanStub) =
    LoweringFunctionSemanticIdentityAllocatorRelease(plan)

fn loweringSemanticDebugProjectionAppendFunctionIdInto(
        ledger: var LoweringSequenceAllocatorLedger,
        functionIdsByTypedFunctionIndex: var int32[],
        functionId: int32) =
    loweringSequenceAllocatorAdd(
        ledger,
        functionIdsByTypedFunctionIndex,
        functionId,
        sizeof(int32))

fn loweringSemanticDebugProjectionAppendTypedNodeIdInto(
        ledger: var LoweringSequenceAllocatorLedger,
        typedNodeIdsByTypedIrNodeIndex: var int32[],
        typedNodeId: int32) =
    loweringSequenceAllocatorAdd(
        ledger,
        typedNodeIdsByTypedIrNodeIndex,
        typedNodeId,
        sizeof(int32))

fn loweringSemanticDebugProjectionAppendDebugOpIdInto(
        ledger: var LoweringSequenceAllocatorLedger,
        debugOpIdsByTypedIrNodeIndex: var int32[],
        debugOpId: int32) =
    loweringSequenceAllocatorAdd(
        ledger,
        debugOpIdsByTypedIrNodeIndex,
        debugOpId,
        sizeof(int32))

fn LoweringSemanticDebugProjectionAppendFunctionId(
        plan: var LoweringPlanStub,
        functionId: int32) =
    loweringSemanticDebugProjectionAppendFunctionIdInto(
        plan.semanticDebugProjectionAllocatorLedger,
        plan.semanticDebugFunctionIdsByTypedFunctionIndex,
        functionId)

fn LoweringSemanticDebugProjectionAppendNodeRow(
        plan: var LoweringPlanStub,
        typedNodeId: int32,
        debugOpId: int32) =
    if plan.semanticDebugTypedNodeIdsByTypedIrNodeIndex.len !=
           plan.semanticDebugOpIdsByTypedIrNodeIndex.len:
        panic("lowering semantic debug projection allocator: row shape drift")
    loweringSemanticDebugProjectionAppendTypedNodeIdInto(
        plan.semanticDebugProjectionAllocatorLedger,
        plan.semanticDebugTypedNodeIdsByTypedIrNodeIndex,
        typedNodeId)
    loweringSemanticDebugProjectionAppendDebugOpIdInto(
        plan.semanticDebugProjectionAllocatorLedger,
        plan.semanticDebugOpIdsByTypedIrNodeIndex,
        debugOpId)

@borrows
fn LoweringSemanticDebugProjectionAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.semanticDebugFunctionIdsByTypedFunctionIndex.cap > 0:
        count = count + 1
    if plan.semanticDebugTypedNodeIdsByTypedIrNodeIndex.cap > 0:
        count = count + 1
    if plan.semanticDebugOpIdsByTypedIrNodeIndex.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringSemanticDebugProjectionAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(
               plan.semanticDebugFunctionIdsByTypedFunctionIndex.cap) *
               int64(sizeof(int32)) +
           int64(plan.semanticDebugTypedNodeIdsByTypedIrNodeIndex.cap) *
               int64(sizeof(int32)) +
           int64(plan.semanticDebugOpIdsByTypedIrNodeIndex.cap) *
               int64(sizeof(int32))

fn loweringSemanticDebugProjectionAccumulateTerminalRelease(
        releasedBytes: int64,
        releasedBufferCount: var int32,
        totalReleasedBytes: var int64) =
    if releasedBytes > int64(0):
        releasedBufferCount = releasedBufferCount + 1
        totalReleasedBytes = totalReleasedBytes + releasedBytes

fn LoweringSemanticDebugProjectionAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.semanticDebugProjectionAllocatorReceiptReady ||
       LoweringSemanticDebugProjectionAllocatorPhysicalBufferCount(plan) !=
           0 ||
       LoweringSemanticDebugProjectionAllocatorCapacityBytes(plan) !=
           int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.semanticDebugProjectionAllocatorReceipt):
        panic("lowering semantic debug projection allocator: begin before release")
    plan.semanticDebugProjectionAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.semanticDebugProjectionAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.semanticDebugProjectionAllocatorReceiptReady = false

fn LoweringSemanticDebugProjectionAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.semanticDebugProjectionAllocatorReceiptReady:
        if LoweringSemanticDebugProjectionAllocatorPhysicalBufferCount(
               plan) != 0 ||
           LoweringSemanticDebugProjectionAllocatorCapacityBytes(plan) !=
               int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.semanticDebugProjectionAllocatorReceipt):
            panic("lowering semantic debug projection allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringSemanticDebugProjectionAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringSemanticDebugProjectionAllocatorCapacityBytes(plan)
    if plan.semanticDebugProjectionAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.semanticDebugProjectionAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering semantic debug projection allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringSemanticDebugProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.semanticDebugProjectionAllocatorLedger,
            plan.semanticDebugFunctionIdsByTypedFunctionIndex,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringSemanticDebugProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.semanticDebugProjectionAllocatorLedger,
            plan.semanticDebugTypedNodeIdsByTypedIrNodeIndex,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringSemanticDebugProjectionAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.semanticDebugProjectionAllocatorLedger,
            plan.semanticDebugOpIdsByTypedIrNodeIndex,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    plan.semanticDebugProjectionAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.semanticDebugProjectionAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.semanticDebugProjectionAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.semanticDebugProjectionAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.semanticDebugProjectionAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.semanticDebugProjectionAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.semanticDebugProjectionAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringSemanticDebugProjectionAllocatorPhysicalBufferCount(plan) ==
            0 &&
        LoweringSemanticDebugProjectionAllocatorCapacityBytes(plan) ==
            int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering semantic debug projection allocator: receipt incomplete")
    plan.semanticDebugProjectionAllocatorReceipt = receipt
    plan.semanticDebugProjectionAllocatorReceiptReady = true
    plan.semanticDebugProjectionAllocatorLedger =
        LoweringSequenceAllocatorLedger()

@borrows
fn loweringSemanticDebugProjectionCandidatePhysicalBufferCount(
        owner: LoweringSemanticDebugProjectionOwner): int32 =
    var count: int32
    if owner.functionIdsByTypedFunctionIndex.cap > 0:
        count = count + 1
    if owner.typedNodeIdsByTypedIrNodeIndex.cap > 0:
        count = count + 1
    if owner.debugOpIdsByTypedIrNodeIndex.cap > 0:
        count = count + 1
    return count

@borrows
fn loweringSemanticDebugProjectionCandidateCapacityBytes(
        owner: LoweringSemanticDebugProjectionOwner): int64 =
    return int64(owner.functionIdsByTypedFunctionIndex.cap) *
               int64(sizeof(int32)) +
           int64(owner.typedNodeIdsByTypedIrNodeIndex.cap) *
               int64(sizeof(int32)) +
           int64(owner.debugOpIdsByTypedIrNodeIndex.cap) *
               int64(sizeof(int32))

fn loweringSemanticDebugProjectionCandidateRelease(
        owner: var LoweringSemanticDebugProjectionOwner) =
    let retainedBufferCount =
        loweringSemanticDebugProjectionCandidatePhysicalBufferCount(owner)
    let retainedBytes =
        loweringSemanticDebugProjectionCandidateCapacityBytes(owner)
    if owner.allocatorLedger.liveAllocationCount !=
           int64(retainedBufferCount) ||
       owner.allocatorLedger.liveCapacityBytes != retainedBytes:
        panic("lowering semantic debug projection candidate: allocator/retained drift")
    let _ = loweringSequenceAllocatorRelease(
        owner.allocatorLedger,
        owner.functionIdsByTypedFunctionIndex,
        sizeof(int32))
    let _ = loweringSequenceAllocatorRelease(
        owner.allocatorLedger,
        owner.typedNodeIdsByTypedIrNodeIndex,
        sizeof(int32))
    let _ = loweringSequenceAllocatorRelease(
        owner.allocatorLedger,
        owner.debugOpIdsByTypedIrNodeIndex,
        sizeof(int32))
    owner.allocatorLedger.closed = true
    if owner.allocatorLedger.allocationEventCount !=
           owner.allocatorLedger.releaseEventCount ||
       owner.allocatorLedger.allocatedCapacityBytes !=
           owner.allocatorLedger.releasedCapacityBytes ||
       owner.allocatorLedger.liveAllocationCount != int64(0) ||
       owner.allocatorLedger.liveCapacityBytes != int64(0) ||
       loweringSemanticDebugProjectionCandidatePhysicalBufferCount(owner) !=
           0 ||
       loweringSemanticDebugProjectionCandidateCapacityBytes(owner) !=
           int64(0):
        panic("lowering semantic debug projection candidate: release incomplete")
    owner = LoweringSemanticDebugProjectionOwner()

fn LoweringPlanReleaseSemanticDebugPayload(plan: var LoweringPlanStub) =
    plan.semanticDebugBound = false
    plan.semanticDebugSourceVersion = 0
    plan.semanticDebugPredecessorReceiptCid = layout.FixedBytes32()
    plan.semanticDebugBindingReceiptCid = layout.FixedBytes32()
    plan.semanticDebugSnapshotCid = layout.FixedBytes32()
    plan.semanticDebugWorldHeadCid = layout.FixedBytes32()
    plan.semanticDebugCompilerCid = layout.FixedBytes32()
    plan.semanticDebugSourceBundleCid = layout.FixedBytes32()
    plan.semanticDebugCsgRootCid = layout.FixedBytes32()
    plan.semanticDebugValidationReceiptCid = layout.FixedBytes32()
    plan.semanticDebugProjectionCid = layout.FixedBytes32()
    plan.semanticDebugBinding =
        debugbindingreceipt.SemanticSnapshotDebugBindingReceipt()
    plan.semanticDebugFacts.packageId = ""
    for factIndex in 0..<plan.semanticDebugFacts.facts.len:
        plan.semanticDebugFacts.facts[factIndex].
            functionFact.modulePath = ""
        plan.semanticDebugFacts.facts[factIndex].
            functionFact.functionName = ""
        plan.semanticDebugFacts.facts[factIndex].
            functionFact.qualifiedName = ""
        plan.semanticDebugFacts.facts[factIndex].
            operationFact.modulePath = ""
        plan.semanticDebugFacts.facts[factIndex].
            symbolFact.modulePath = ""
        plan.semanticDebugFacts.facts[factIndex].
            symbolFact.name = ""
        plan.semanticDebugFacts.facts[factIndex].
            symbolFact.qualifiedName = ""
        plan.semanticDebugFacts.facts[factIndex].
            layoutFact.canonicalTypeName = ""
    seqs.chengSeqFreeTyped(plan.semanticDebugFacts.facts)
    plan.semanticDebugFacts = debugfact.DebugFactBundle()
    LoweringSemanticDebugProjectionAllocatorRelease(plan)

# Atomically binds one already-admitted DebugFact projection to the exact
# TypedExprIr that lowering will consume. Producer indexes are snapshot facts;
# no source path, name, arity, span, or row-order guess participates.
@borrows
fn loweringPlanSemanticDebugTypedProducerShape(
        plan: LoweringPlanStub,
        typedFunctionCount: int32,
        typedNodeCount: int32): bool =
    if !texpr.TypedExprIrFunctions2ShapeComplete(plan.typedIr) ||
       !texpr.TypedExprIrNodes2ShapeComplete(plan.typedIr) ||
       typedFunctionCount != plan.typedIr.functions2_functionNameIds.len ||
       typedNodeCount != plan.typedIr.nodes2_nodeIndexs.len:
        return false
    var expectedNodeStart: int32
    for typedFunctionIndex in 0..<typedFunctionCount:
        let nodeStart = arenamod.ArenaArrayInt32Get(
            plan.typedIr.arena,
            plan.typedIr.functions2_nodeStarts,
            typedFunctionIndex)
        let nodeCount = arenamod.ArenaArrayInt32Get(
            plan.typedIr.arena,
            plan.typedIr.functions2_nodeCounts,
            typedFunctionIndex)
        if nodeStart != expectedNodeStart || nodeCount < 0 ||
           nodeStart > typedNodeCount ||
           nodeCount > typedNodeCount - nodeStart:
            return false
        expectedNodeStart = expectedNodeStart + nodeCount
    if expectedNodeStart != typedNodeCount:
        return false
    for typedIrNodeIndex in 0..<typedNodeCount:
        if arenamod.ArenaArrayInt32Get(
               plan.typedIr.arena,
               plan.typedIr.nodes2_nodeIndexs,
               typedIrNodeIndex) != typedIrNodeIndex:
            return false
    return true

@borrows
fn LoweringPlanBindPublishedDebugFactsInto(
        plan: var LoweringPlanStub,
        bundle: debugfact.DebugFactBundle,
        err: var str): bool =
    err = ""
    var factErr: str
    if !debugfact.DebugFactBundleStrictValidateInto(bundle, factErr):
        err = " lowering debug snapshot: " + factErr
        return false
    let typedFunctionCount = plan.typedIr.functions2_functionNameIds.len
    let typedNodeCount = plan.typedIr.nodes2_nodeIndexs.len
    if bundle.functionCount != typedFunctionCount ||
       bundle.typedNodeCount != typedNodeCount ||
       bundle.debugOpCount != typedNodeCount ||
       !loweringPlanSemanticDebugTypedProducerShape(
           plan, bundle.functionCount, bundle.typedNodeCount):
        err = " lowering debug snapshot: producer index coverage mismatch"
        return false
    var projectionOwner: LoweringSemanticDebugProjectionOwner
    for typedFunctionIndex in 0..<typedFunctionCount:
        loweringSemanticDebugProjectionAppendFunctionIdInto(
            projectionOwner.allocatorLedger,
            projectionOwner.functionIdsByTypedFunctionIndex,
            -1)
    for functionId in 0..<bundle.functionCount:
        let fact = bundle.facts[functionId]
        let typedFunctionIndex = fact.functionFact.typedFunctionIndex
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >= typedFunctionCount ||
           projectionOwner.functionIdsByTypedFunctionIndex[
               typedFunctionIndex] != -1:
            loweringSemanticDebugProjectionCandidateRelease(
                projectionOwner)
            err = " lowering debug snapshot: FunctionId producer index is not bijective"
            return false
        projectionOwner.functionIdsByTypedFunctionIndex[
            typedFunctionIndex] = functionId
    for typedIrNodeIndex in 0..<typedNodeCount:
        if projectionOwner.typedNodeIdsByTypedIrNodeIndex.len !=
               projectionOwner.debugOpIdsByTypedIrNodeIndex.len:
            loweringSemanticDebugProjectionCandidateRelease(
                projectionOwner)
            err = " lowering debug snapshot: TypedNodeId row shape mismatch"
            return false
        loweringSemanticDebugProjectionAppendTypedNodeIdInto(
            projectionOwner.allocatorLedger,
            projectionOwner.typedNodeIdsByTypedIrNodeIndex,
            -1)
        loweringSemanticDebugProjectionAppendDebugOpIdInto(
            projectionOwner.allocatorLedger,
            projectionOwner.debugOpIdsByTypedIrNodeIndex,
            -1)
    for debugOpId in 0..<bundle.debugOpCount:
        let factIndex = bundle.functionCount + debugOpId
        let row = bundle.facts[factIndex].operationFact
        let typedIrNodeIndex = row.typedIrNodeIndex
        if row.functionId < 0 || row.functionId >= bundle.functionCount ||
           typedIrNodeIndex < 0 || typedIrNodeIndex >= typedNodeCount ||
           projectionOwner.typedNodeIdsByTypedIrNodeIndex[
               typedIrNodeIndex] != -1 ||
           projectionOwner.debugOpIdsByTypedIrNodeIndex[
               typedIrNodeIndex] != -1 ||
           int32(plan.typedIr.nodes2_opKinds[typedIrNodeIndex]) !=
               row.typedOpKind ||
           arenamod.ArenaArrayInt32Get(
               plan.typedIr.arena,
               plan.typedIr.nodes2_originParserNodeIds,
               typedIrNodeIndex) != row.originParserNodeId ||
           arenamod.ArenaArrayInt32Get(
               plan.typedIr.arena,
               plan.typedIr.nodes2_syntheticOriginKinds,
               typedIrNodeIndex) != row.syntheticOriginKind:
            loweringSemanticDebugProjectionCandidateRelease(
                projectionOwner)
            err = " lowering debug snapshot: TypedNodeId producer index or op kind mismatch"
            return false
        let typedFunctionIndex =
            bundle.facts[row.functionId].functionFact.typedFunctionIndex
        let nodeStart = arenamod.ArenaArrayInt32Get(
            plan.typedIr.arena,
            plan.typedIr.functions2_nodeStarts,
            typedFunctionIndex)
        let nodeCount = arenamod.ArenaArrayInt32Get(
            plan.typedIr.arena,
            plan.typedIr.functions2_nodeCounts,
            typedFunctionIndex)
        if typedIrNodeIndex < nodeStart ||
           typedIrNodeIndex >= nodeStart + nodeCount:
            loweringSemanticDebugProjectionCandidateRelease(
                projectionOwner)
            err = " lowering debug snapshot: TypedNodeId function CSR mismatch"
            return false
        projectionOwner.typedNodeIdsByTypedIrNodeIndex[
            typedIrNodeIndex] = row.typedNodeId
        projectionOwner.debugOpIdsByTypedIrNodeIndex[
            typedIrNodeIndex] = debugOpId
    for typedFunctionIndex in 0..<typedFunctionCount:
        if projectionOwner.functionIdsByTypedFunctionIndex[
               typedFunctionIndex] < 0:
            loweringSemanticDebugProjectionCandidateRelease(
                projectionOwner)
            err = " lowering debug snapshot: FunctionId coverage incomplete"
            return false
    for typedIrNodeIndex in 0..<typedNodeCount:
        if projectionOwner.typedNodeIdsByTypedIrNodeIndex[
               typedIrNodeIndex] < 0 ||
           projectionOwner.debugOpIdsByTypedIrNodeIndex[
               typedIrNodeIndex] < 0:
            loweringSemanticDebugProjectionCandidateRelease(
                projectionOwner)
            err = " lowering debug snapshot: TypedNodeId coverage incomplete"
            return false
    LoweringPlanReleaseSemanticDebugPayload(plan)
    plan.semanticDebugSourceVersion = bundle.sourceVersion
    plan.semanticDebugPredecessorReceiptCid = bundle.predecessorReceiptCid
    plan.semanticDebugBindingReceiptCid = bundle.bindingReceiptCid
    plan.semanticDebugSnapshotCid = bundle.semanticSnapshotCid
    plan.semanticDebugWorldHeadCid = bundle.worldHeadCid
    plan.semanticDebugCompilerCid = bundle.compilerCid
    plan.semanticDebugSourceBundleCid = bundle.sourceBundleCid
    plan.semanticDebugCsgRootCid = bundle.csgRootCid
    plan.semanticDebugValidationReceiptCid = bundle.validationReceiptCid
    plan.semanticDebugProjectionCid = bundle.projectionCid
    plan.semanticDebugFacts = bundle
    plan.semanticDebugFunctionIdsByTypedFunctionIndex =
        projectionOwner.functionIdsByTypedFunctionIndex
    plan.semanticDebugTypedNodeIdsByTypedIrNodeIndex =
        projectionOwner.typedNodeIdsByTypedIrNodeIndex
    plan.semanticDebugOpIdsByTypedIrNodeIndex =
        projectionOwner.debugOpIdsByTypedIrNodeIndex
    plan.semanticDebugProjectionAllocatorLedger =
        projectionOwner.allocatorLedger
    plan.semanticDebugProjectionAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.semanticDebugProjectionAllocatorReceiptReady = false
    plan.semanticDebugBound = true
    return true

@borrows
fn LoweringPlanPublishedDebugFactsStrictValidateInto(
        plan: LoweringPlanStub,
        err: var str): bool =
    err = ""
    if !plan.semanticDebugBound:
        err = " lowering debug snapshot: no published DebugFact bundle"
        return false
    let bundle = plan.semanticDebugFacts
    if !debugfact.DebugFactBundleStrictValidateInto(bundle, err):
        return false
    if !loweringPlanSemanticDebugTypedProducerShape(
            plan, bundle.functionCount, bundle.typedNodeCount):
        err = " lowering debug snapshot: retained TypedExprIr shape invalid"
        return false
    if bundle.sourceVersion != plan.semanticDebugSourceVersion ||
       !layout.FixedBytes32Equal(
           bundle.predecessorReceiptCid,
           plan.semanticDebugPredecessorReceiptCid) ||
       !layout.FixedBytes32Equal(
           bundle.bindingReceiptCid,
           plan.semanticDebugBindingReceiptCid) ||
       !layout.FixedBytes32Equal(
           bundle.semanticSnapshotCid,
           plan.semanticDebugSnapshotCid) ||
       !layout.FixedBytes32Equal(
           bundle.worldHeadCid,
           plan.semanticDebugWorldHeadCid) ||
       !layout.FixedBytes32Equal(
           bundle.compilerCid,
           plan.semanticDebugCompilerCid) ||
       !layout.FixedBytes32Equal(
           bundle.sourceBundleCid,
           plan.semanticDebugSourceBundleCid) ||
       !layout.FixedBytes32Equal(
           bundle.csgRootCid,
           plan.semanticDebugCsgRootCid) ||
       !layout.FixedBytes32Equal(
           bundle.validationReceiptCid,
           plan.semanticDebugValidationReceiptCid) ||
       !layout.FixedBytes32Equal(
           bundle.projectionCid,
           plan.semanticDebugProjectionCid) ||
       bundle.functionCount !=
           plan.semanticDebugFunctionIdsByTypedFunctionIndex.len ||
       bundle.typedNodeCount !=
           plan.semanticDebugTypedNodeIdsByTypedIrNodeIndex.len ||
       bundle.debugOpCount !=
           plan.semanticDebugOpIdsByTypedIrNodeIndex.len:
        err = " lowering debug snapshot: retained bundle identity drift"
        return false
    for functionId in 0..<bundle.functionCount:
        let row = bundle.facts[functionId]
        if row.kind != debugfact.DebugFactKindFunction ||
           row.functionFact.typedFunctionIndex < 0 ||
           row.functionFact.typedFunctionIndex >= bundle.functionCount ||
           plan.semanticDebugFunctionIdsByTypedFunctionIndex[
               row.functionFact.typedFunctionIndex] != functionId:
            err = " lowering debug snapshot: retained FunctionId bridge drift"
            return false
    for debugOpId in 0..<bundle.debugOpCount:
        let row = bundle.facts[
            bundle.functionCount + debugOpId]
        if row.kind != debugfact.DebugFactKindOperation ||
           row.operationFact.typedIrNodeIndex < 0 ||
           row.operationFact.typedIrNodeIndex >= bundle.typedNodeCount ||
           plan.semanticDebugTypedNodeIdsByTypedIrNodeIndex[
               row.operationFact.typedIrNodeIndex] !=
               row.operationFact.typedNodeId ||
           plan.semanticDebugOpIdsByTypedIrNodeIndex[
               row.operationFact.typedIrNodeIndex] != debugOpId:
            err = " lowering debug snapshot: retained DebugOp bridge drift"
            return false
        let typedIrNodeIndex = row.operationFact.typedIrNodeIndex
        let typedFunctionIndex = bundle.facts[
            row.operationFact.functionId].functionFact.typedFunctionIndex
        let nodeStart = arenamod.ArenaArrayInt32Get(
            plan.typedIr.arena,
            plan.typedIr.functions2_nodeStarts,
            typedFunctionIndex)
        let nodeCount = arenamod.ArenaArrayInt32Get(
            plan.typedIr.arena,
            plan.typedIr.functions2_nodeCounts,
            typedFunctionIndex)
        if int32(plan.typedIr.nodes2_opKinds[typedIrNodeIndex]) !=
               row.operationFact.typedOpKind ||
           arenamod.ArenaArrayInt32Get(
               plan.typedIr.arena,
               plan.typedIr.nodes2_originParserNodeIds,
               typedIrNodeIndex) != row.operationFact.originParserNodeId ||
           arenamod.ArenaArrayInt32Get(
               plan.typedIr.arena,
               plan.typedIr.nodes2_syntheticOriginKinds,
               typedIrNodeIndex) != row.operationFact.syntheticOriginKind ||
           typedIrNodeIndex < nodeStart ||
           typedIrNodeIndex >= nodeStart + nodeCount:
            err = " lowering debug snapshot: retained TypedExpr producer bridge drift"
            return false
    return true

fn LoweringPlanBindPublishedDebugBindingReceiptInto(
        plan: var LoweringPlanStub,
        receipt: debugbindingreceipt.SemanticSnapshotDebugBindingReceipt,
        err: var str): bool =
    if !LoweringPlanPublishedDebugFactsStrictValidateInto(plan, err) ||
       !debugbindingreceipt.SemanticSnapshotDebugBindingReceiptValidateFactsInto(
           receipt, plan.semanticDebugFacts, err):
        return false
    if !layout.FixedBytes32Equal(
           receipt.loweringBridgeRootCid,
           LoweringPlanSemanticDebugBridgeRoot(plan)):
        err = " lowering debug snapshot: binding lowering bridge mismatch"
        return false
    let emptyCid = layout.FixedBytes32()
    if !layout.FixedBytes32Equal(
           plan.semanticDebugBinding.receiptCid, emptyCid):
        if !debugbindingreceipt.SemanticSnapshotDebugBindingReceiptEqual(
               plan.semanticDebugBinding, receipt):
            err = " lowering debug snapshot: immutable binding receipt changed"
            return false
        err = ""
        return true
    plan.semanticDebugBinding = receipt
    err = ""
    return true

fn loweringPlanSemanticDebugBridgeAppendI32(
        buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

@borrows
fn loweringPlanSemanticDebugBridgeAppendText(
        buf: var layout.ByteBuf, value: str) =
    loweringPlanSemanticDebugBridgeAppendI32(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

@borrows
fn LoweringPlanSemanticDebugBridgeRoot(
        plan: LoweringPlanStub): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(
        128 + plan.semanticDebugFunctionIdsByTypedFunctionIndex.len * 4 +
        plan.semanticDebugTypedNodeIdsByTypedIrNodeIndex.len * 8)
    loweringPlanSemanticDebugBridgeAppendText(
        buf, "cheng.semantic_snapshot.debug_lowering_bridge")
    layout.ByteBufAppendFixed32(buf, plan.semanticDebugProjectionCid)
    loweringPlanSemanticDebugBridgeAppendI32(
        buf, plan.semanticDebugFunctionIdsByTypedFunctionIndex.len)
    for index in 0..<plan.semanticDebugFunctionIdsByTypedFunctionIndex.len:
        loweringPlanSemanticDebugBridgeAppendI32(
            buf, plan.semanticDebugFunctionIdsByTypedFunctionIndex[index])
    loweringPlanSemanticDebugBridgeAppendI32(
        buf, plan.semanticDebugTypedNodeIdsByTypedIrNodeIndex.len)
    for index in 0..<plan.semanticDebugTypedNodeIdsByTypedIrNodeIndex.len:
        loweringPlanSemanticDebugBridgeAppendI32(
            buf, plan.semanticDebugTypedNodeIdsByTypedIrNodeIndex[index])
        loweringPlanSemanticDebugBridgeAppendI32(
            buf, plan.semanticDebugOpIdsByTypedIrNodeIndex[index])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn LoweringPlanPublishedDebugBindingReceiptStrictValidateInto(
        plan: LoweringPlanStub,
        err: var str): bool =
    if !LoweringPlanPublishedDebugFactsStrictValidateInto(plan, err):
        return false
    if !debugbindingreceipt.SemanticSnapshotDebugBindingReceiptValidateFactsInto(
           plan.semanticDebugBinding, plan.semanticDebugFacts, err):
        return false
    if !layout.FixedBytes32Equal(
           plan.semanticDebugBinding.loweringBridgeRootCid,
           LoweringPlanSemanticDebugBridgeRoot(plan)):
        err = " lowering debug snapshot: binding lowering bridge drift"
        return false
    return true

@borrows
fn LoweringPlanBodyIrBeginSemanticDebug(
        plan: LoweringPlanStub,
        typedFunctionIndex: int32,
        bodyIR: var coreir.BodyIR): bool =
    if !plan.semanticDebugBound:
        return true
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >=
           plan.semanticDebugFunctionIdsByTypedFunctionIndex.len ||
       plan.semanticDebugFunctionIdsByTypedFunctionIndex[
           typedFunctionIndex] < 0:
        return false
    let functionId = plan.semanticDebugFunctionIdsByTypedFunctionIndex[
        typedFunctionIndex]
    if bodyIR.debugProvenanceRequired:
        return bodyIR.debugFunctionId == functionId &&
               bodyIR.debugProvenanceComplete
    if bodyIR.ops.len != 0 || bodyIR.terms.len != 0:
        return false
    return coreir.BodyIRDebugProvenanceBegin(bodyIR, functionId)

@borrows
fn LoweringPlanBodyIrSetExactDebugContext(
        plan: LoweringPlanStub,
        typedFunctionIndex: int32,
        typedIrNodeIndex: int32,
        bodyIR: var coreir.BodyIR): bool =
    if !plan.semanticDebugBound:
        return true
    if typedIrNodeIndex < 0 ||
       typedIrNodeIndex >= plan.semanticDebugOpIdsByTypedIrNodeIndex.len ||
       plan.semanticDebugOpIdsByTypedIrNodeIndex[typedIrNodeIndex] < 0 ||
       !LoweringPlanBodyIrBeginSemanticDebug(
           plan, typedFunctionIndex, bodyIR):
        return false
    let nodeStart = arenamod.ArenaArrayInt32Get(
        plan.typedIr.arena,
        plan.typedIr.functions2_nodeStarts,
        typedFunctionIndex)
    let nodeCount = arenamod.ArenaArrayInt32Get(
        plan.typedIr.arena,
        plan.typedIr.functions2_nodeCounts,
        typedFunctionIndex)
    if typedIrNodeIndex < nodeStart ||
       typedIrNodeIndex >= nodeStart + nodeCount:
        return false
    return coreir.BodyIRDebugProvenanceSetExact(
        bodyIR,
        plan.semanticDebugOpIdsByTypedIrNodeIndex[typedIrNodeIndex])

fn LoweringPlanBodyIrSetSyntheticDebugContext(
        plan: LoweringPlanStub,
        typedFunctionIndex: int32,
        syntheticKind: int32,
        bodyIR: var coreir.BodyIR): bool =
    if !plan.semanticDebugBound:
        return true
    if !LoweringPlanBodyIrBeginSemanticDebug(
            plan, typedFunctionIndex, bodyIR) ||
       syntheticKind < coreir.BodyDebugSyntheticCleanup ||
       syntheticKind > coreir.BodyDebugSyntheticRuntime:
        return false
    return coreir.BodyIRDebugProvenanceSetSynthetic(bodyIR, syntheticKind)

fn LoweringPlanBodyIrFinalizeSemanticDebug(
        plan: LoweringPlanStub,
        typedFunctionIndex: int32,
        bodyIR: var coreir.BodyIR): bool =
    if !plan.semanticDebugBound:
        return !bodyIR.debugProvenanceRequired
    if !LoweringPlanBodyIrBeginSemanticDebug(
            plan, typedFunctionIndex, bodyIR):
        return false
    return coreir.BodyIRDebugProvenanceShapeValid(bodyIR)

fn loweringPlanLifecycleDumpProduced(plan: var LoweringPlanStub, tag: str) =
    os.WriteLine(os.GetStderr(),
                 Fmt"lifecycle_{tag} buf={LoweringPlanLifecycleTrackedPhysicalBufferCount(plan)} bytes={LoweringPlanLifecycleTrackedRetainedBytes(plan)} shapeBuf={LoweringPlanPrimaryObjectIrFunctionShapeAllocatorPhysicalBufferCount(plan)} shapeBytes={LoweringPlanPrimaryObjectIrFunctionShapeAllocatorCapacityBytes(plan)} callBuf={LoweringPlanPrimaryObjectIrCallTargetAllocatorPhysicalBufferCount(plan)} callBytes={LoweringPlanPrimaryObjectIrCallTargetAllocatorCapacityBytes(plan)} deferBuf={LoweringPlanDeferScopeTransportPhysicalBufferCount(plan)} ownBuf={LoweringPlanOwnershipTransportPhysicalBufferCount(plan)} denseBuf={dense.DenseStorePhysicalBufferCount(plan.typedFunctionDenseStore)} projBuf={LoweringResolvedCallTargetProjectionPhysicalBufferCount(plan)} arena={plan.typedIr.arena.capacityBytes}")

fn LoweringPlanReleaseAfterPrimaryObjectPlan(plan: var LoweringPlanStub) =
    loweringPlanLifecycleDumpProduced(plan, "before_after_primary")
    if plan.primaryObjectIrFunctionCountSnapshot <= 0:
        plan.primaryObjectIrFunctionCountSnapshot = plan.primaryObjectIr.functions.len
    LoweringPlanReleaseDeferScopeTransportAllocators(plan)
    LoweringPlanReleaseOwnershipTransportAllocators(plan)
    LoweringPlanReleasePrimaryObjectIrFunctionShapeAllocators(plan)
    LoweringPlanReleasePrimaryObjectIrCallTargetAllocators(plan)
    LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
    LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
    LoweringPlanReleaseModuleSourceIndexPayload(plan)
    LoweringPlanReleaseFnPtrFieldCallPayload(plan)
    texpr.TypedExprIrReleasePayload(plan.typedIr)
    LoweringPlanReleaseTypeArenaOwnerProofPayload(plan)
    seqs.freeSeq(plan.typeArenaStructuralKinds)
    seqs.freeSeq(plan.typeArenaScalarKinds)
    seqs.freeSeq(plan.typeArenaChildTypeIds)
    seqs.freeSeq(plan.typeArenaLayoutChildStarts)
    seqs.freeSeq(plan.typeArenaLayoutChildCounts)
    seqs.freeSeq(plan.typeArenaLayoutChildTypeIds)
    seqs.freeSeq(plan.typeArenaLayoutChildIdentityKinds)
    seqs.freeSeq(plan.typeArenaLayoutChildMemberRows)
    seqs.freeSeq(plan.typeArenaLayoutChildSelectorOrdinals)
    seqs.freeSeq(plan.typeArenaLayoutChildOffsets)
    seqs.freeSeq(plan.typeArenaLayoutChildWidths)
    seqs.freeSeq(plan.typeArenaFixedLengths)
    seqs.freeSeq(plan.typeArenaVariantCounts)
    seqs.freeSeq(plan.typeArenaSizeBytes)
    seqs.freeSeq(plan.typeArenaAlignBytes)
    seqs.freeSeq(plan.typeArenaLayoutPresent)
    LoweringResolvedCallTargetProjectionRelease(plan)
    var zeroToken: layout.FixedBytes32
    loweringPlanFixed32CopyInto(
        plan.fnPtrFieldCallTypeArenaArtifactCid,
        zeroToken)
    LoweringPrimaryObjectIrReleasePayload(plan.primaryObjectIr)
    LoweringPrimaryObjectIrFunctionArrayReleasePayload(
        plan.primaryObjectIrFunctions)
    LoweringNormalizedExprLayerTerminalRelease(plan.exprLayer)
    LoweringPlanReleaseCompilerCsgExprSliceSidecar(plan)
    texpr.TypedExprFactTableRelease(plan.typedExprFacts)
    LoweringPlanReleaseResolvedCallSnapshot(plan)
    LoweringPlanReleaseResolvedCallFactIndexPayload(plan)
    LoweringPlanReleaseTypedFunctionLookupSidecarPayload(plan)
    LoweringTypedFunctionDenseStoreInputAllocatorRelease(plan)
    dense.DenseStoreRelease(plan.typedFunctionDenseStore)
    LoweringPlanReleaseSemanticIdentityPayload(plan)
    # Keep the admitted DebugFact bundle and exact producer-index bridge until
    # final object bytes have been joined and the object receipt is validated.
    # LoweringPlanReleaseLineMapUnusedPayload performs the single release.
    LoweringPlanReleasePrimaryImportResolutionPayload(plan)

fn LoweringPlanLifecycleTrackedRetainedBytes(
        plan: var LoweringPlanStub): int64 =
    return Int64(plan.typedIr.arena.capacityBytes) +
           LoweringPlanLifecycleProducedRetainedBytes(plan)

fn LoweringPlanLifecycleProducedRetainedBytes(
        plan: var LoweringPlanStub): int64 =
    return dense.DenseStoreRetainedBytes(plan.typedFunctionDenseStore) +
           LoweringResolvedCallTargetProjectionRetainedBytes(plan) +
           LoweringPlanDeferScopeTransportCapacityBytes(plan) +
           LoweringPlanOwnershipTransportCapacityBytes(plan) +
           LoweringPlanPrimaryObjectIrFunctionShapeAllocatorCapacityBytes(
               plan) +
           LoweringPlanPrimaryObjectIrCallTargetAllocatorCapacityBytes(plan)

fn LoweringPlanLifecycleTrackedPhysicalBufferCount(
        plan: var LoweringPlanStub): int32 =
    var count = LoweringPlanLifecycleProducedPhysicalBufferCount(plan)
    if plan.typedIr.arena.capacityBytes > 0:
        count = count + 1
    return count

fn LoweringPlanLifecycleProducedPhysicalBufferCount(
        plan: var LoweringPlanStub): int32 =
    return dense.DenseStorePhysicalBufferCount(
               plan.typedFunctionDenseStore) +
           LoweringResolvedCallTargetProjectionPhysicalBufferCount(plan) +
           LoweringPlanDeferScopeTransportPhysicalBufferCount(plan) +
           LoweringPlanOwnershipTransportPhysicalBufferCount(plan) +
           LoweringPlanPrimaryObjectIrFunctionShapeAllocatorPhysicalBufferCount(
               plan) +
           LoweringPlanPrimaryObjectIrCallTargetAllocatorPhysicalBufferCount(
               plan)

fn LoweringPlanLifecycleTrackedStorageReleased(
        plan: var LoweringPlanStub): bool =
    return plan.typedIr.arena.capacityBytes == 0 &&
           LoweringPlanLifecycleProducedStorageReleased(plan)

fn LoweringPlanLifecycleProducedStorageReleased(
        plan: var LoweringPlanStub): bool =
    return dense.DenseStorePhysicalBufferCount(
               plan.typedFunctionDenseStore) == 0 &&
           dense.DenseStoreRetainedBytes(
               plan.typedFunctionDenseStore) == int64(0) &&
           LoweringResolvedCallTargetProjectionStorageReleased(plan) &&
           LoweringPlanDeferScopeTransportPhysicalBufferCount(plan) == 0 &&
           LoweringPlanDeferScopeTransportCapacityBytes(plan) == int64(0) &&
           LoweringPlanOwnershipTransportPhysicalBufferCount(plan) == 0 &&
           LoweringPlanOwnershipTransportCapacityBytes(plan) == int64(0) &&
           LoweringPlanPrimaryObjectIrFunctionShapeAllocatorPhysicalBufferCount(
               plan) == 0 &&
           LoweringPlanPrimaryObjectIrFunctionShapeAllocatorCapacityBytes(
               plan) == int64(0) &&
           LoweringPlanPrimaryObjectIrCallTargetAllocatorPhysicalBufferCount(
               plan) == 0 &&
           LoweringPlanPrimaryObjectIrCallTargetAllocatorCapacityBytes(plan) ==
               int64(0)

fn LoweringPlanLifecycleReleaseTrackingBegin(
        plan: var LoweringPlanStub) =
    if plan.lifecycleReleaseTrackingStarted ||
       plan.lifecycleReleaseClosed:
        panic("lowering plan: duplicate lifecycle release tracking begin")
    plan.lifecycleInitialBufferCount =
        LoweringPlanLifecycleTrackedPhysicalBufferCount(plan)
    plan.lifecycleInitialBytes =
        LoweringPlanLifecycleTrackedRetainedBytes(plan)
    if plan.lifecycleInitialBufferCount < 0 ||
       plan.lifecycleInitialBytes < int64(0) ||
       (plan.lifecycleInitialBufferCount == 0 &&
        plan.lifecycleInitialBytes != int64(0)) ||
       (plan.lifecycleInitialBufferCount > 0 &&
        plan.lifecycleInitialBytes <= int64(0)):
        panic("lowering plan: invalid lifecycle release tracking preimage")
    plan.lifecycleReleasedBufferCount = 0
    plan.lifecycleReleasedBytes = int64(0)
    plan.lifecycleReleaseTrackingStarted = true
    loweringPlanLifecycleDumpProduced(plan, "begin")

fn LoweringPlanLifecycleReleaseTrackingRecord(
        plan: var LoweringPlanStub,
        beforeBufferCount: int32,
        beforeBytes: int64,
        afterBufferCount: int32,
        afterBytes: int64) =
    if !plan.lifecycleReleaseTrackingStarted:
        return
    if plan.lifecycleReleaseClosed ||
       beforeBufferCount < afterBufferCount ||
       beforeBytes < afterBytes ||
       afterBufferCount < 0 ||
       afterBytes < int64(0):
        panic("lowering plan: invalid lifecycle physical release delta")
    let releasedBufferCount =
        beforeBufferCount - afterBufferCount
    let releasedBytes = beforeBytes - afterBytes
    if plan.lifecycleReleasedBufferCount >
           plan.lifecycleInitialBufferCount - releasedBufferCount ||
       plan.lifecycleReleasedBytes >
           plan.lifecycleInitialBytes - releasedBytes:
        panic(Fmt"lowering plan: lifecycle physical release overflow init_buf={plan.lifecycleInitialBufferCount} released_buf_before={plan.lifecycleReleasedBufferCount} delta_buf={releasedBufferCount} before_buf={beforeBufferCount} after_buf={afterBufferCount} init_bytes={plan.lifecycleInitialBytes} released_bytes_before={plan.lifecycleReleasedBytes} delta_bytes={releasedBytes} before_bytes={beforeBytes} after_bytes={afterBytes} tracking_started={plan.lifecycleReleaseTrackingStarted ? 1 : 0} lifecycle_closed={plan.lifecycleReleaseClosed ? 1 : 0}")
    plan.lifecycleReleasedBufferCount =
        plan.lifecycleReleasedBufferCount + releasedBufferCount
    plan.lifecycleReleasedBytes =
        plan.lifecycleReleasedBytes + releasedBytes

fn LoweringPlanCompilerCsgTransferredStorageReleased(
        plan: var LoweringPlanStub): bool =
    return plan.typedIr.arena.capacityBytes == 0 &&
           plan.typedIr.internPool == nil &&
           ccsg.CompilerCsgTypedIrDynamicSequenceBytes(
               plan.typedIr, true) == int64(0) &&
           texpr.TypedExprIrBuildIndexStructuredLiveBytes(
               plan.typedIr) == int64(0) &&
           plan.compilerCsgExprSliceSidecar.sourceIndex.cap == 0 &&
           plan.compilerCsgExprSliceSidecar.sourcePaths.cap == 0 &&
           plan.compilerCsgExprSliceSidecar.functionIndex.cap == 0 &&
           plan.compilerCsgExprSliceSidecar.exprStart.cap == 0 &&
           plan.compilerCsgExprSliceSidecar.exprCount.cap == 0 &&
           plan.compilerCsgExprSliceSidecar.typedFactStart.cap == 0 &&
           plan.compilerCsgExprSliceSidecar.typedFactCount.cap == 0 &&
           plan.compilerCsgExprSliceSidecar.typedFactSemanticDigests.cap == 0 &&
           plan.compilerCsgExprSliceSidecar.typedIrSemanticDigests.cap == 0 &&
           plan.compilerCsgExprSliceSidecar.typedIrFunctionIndexes.cap == 0 &&
           plan.compilerCsgExprSliceSidecar.semanticValidated.cap == 0 &&
           plan.compilerCsgExprSliceSidecar.functionSliceIndexes.cap == 0 &&
           plan.resolvedCallSnapshot.internPool == nil &&
           ccsg.CompilerCsgSemanticResolvedCallDynamicSequenceBytes(
               plan.resolvedCallSnapshot, true) == int64(0) &&
           ccsg.CompilerCsgExternFfiHandleCallCapabilityTableReleasedEmpty(
               plan.externFfiHandleCallCapabilityBridge.
                   semanticCapabilities)

fn loweringPlanRecordCompilerCsgTransferredRelease(
        plan: var LoweringPlanStub) =
    if plan.compilerCsgLifecycleTransferredReleaseRecorded:
        return
    if !LoweringPlanCompilerCsgTransferredStorageReleased(plan):
        panic("lowering plan: transferred compiler csg storage still live")
    if plan.compilerCsgLifecycleTransferredBufferCount < 0 ||
       plan.compilerCsgLifecycleTransferredBytes < int64(0):
        panic("lowering plan: transferred compiler csg receipt invalid")
    if plan.compilerCsgLifecycleReleasedBufferCount < 0 ||
       plan.compilerCsgLifecycleReleasedBufferCount >
           plan.compilerCsgLifecycleInitialBufferCount ||
       plan.compilerCsgLifecycleTransferredBufferCount >
           plan.compilerCsgLifecycleInitialBufferCount -
               plan.compilerCsgLifecycleReleasedBufferCount ||
       plan.compilerCsgLifecycleReleasedBytes < int64(0) ||
       plan.compilerCsgLifecycleReleasedBytes >
           plan.compilerCsgLifecycleInitialBytes ||
       plan.compilerCsgLifecycleTransferredBytes >
           plan.compilerCsgLifecycleInitialBytes -
               plan.compilerCsgLifecycleReleasedBytes:
        panic("lowering plan: compiler csg release partition invalid")
    plan.compilerCsgLifecycleReleasedBufferCount =
        plan.compilerCsgLifecycleReleasedBufferCount +
            plan.compilerCsgLifecycleTransferredBufferCount
    plan.compilerCsgLifecycleReleasedBytes =
        plan.compilerCsgLifecycleReleasedBytes +
            plan.compilerCsgLifecycleTransferredBytes
    plan.compilerCsgLifecycleTransferredReleaseRecorded = true

fn LoweringPlanReleaseAfterPrimaryObjectPlanWithReceipt(
        plan: var LoweringPlanStub,
        releasedBufferCount: var int32,
        releasedBytes: var int64) =
    # lifecycle 释放账本锚点 = primary 分配链完成点：早于本点 begin 会把
    # primary 相后续分配快照进 initial，终态对账必 mismatch（system_link_exec
    # 的 lowering payload lifecycle begin 与本点同锚）；terminal release 里的
    # lazy begin 仅作 abort 早退兜底，正常路径到 terminal 必须已 started。
    if !plan.lifecycleReleaseTrackingStarted:
        LoweringPlanLifecycleReleaseTrackingBegin(plan)
    # 链式账面 before：lazy 重建/流式 emit 区间的 transport/shape 释放发生在
    # 无 record 覆盖的窗口内（其归并进本点 delta）。before 取账面剩余
    # （initial - 已记 released），after 取实存快照；若实存高于账面（存在
    # 未记分配），ReleaseTrackingRecord 的 before<after 判据照常硬死。
    let lifecycleBeforeBufferCount =
        plan.lifecycleInitialBufferCount -
        plan.lifecycleReleasedBufferCount
    let lifecycleBeforeBytes =
        plan.lifecycleInitialBytes -
        plan.lifecycleReleasedBytes
    releasedBufferCount =
        LoweringPlanLifecycleProducedPhysicalBufferCount(plan)
    releasedBytes =
        LoweringPlanLifecycleProducedRetainedBytes(plan)
    LoweringPlanReleaseAfterPrimaryObjectPlan(plan)
    if !LoweringPlanLifecycleProducedStorageReleased(plan):
        panic("lowering plan: produced release receipt incomplete")
    LoweringPlanLifecycleReleaseTrackingRecord(
        plan,
        lifecycleBeforeBufferCount,
        lifecycleBeforeBytes,
        LoweringPlanLifecycleTrackedPhysicalBufferCount(plan),
        LoweringPlanLifecycleTrackedRetainedBytes(plan))
    loweringPlanRecordCompilerCsgTransferredRelease(plan)

fn LoweringPlanCompilerCsgReleasedBufferCount(
        plan: var LoweringPlanStub): int32 =
    return plan.compilerCsgLifecycleReleasedBufferCount

fn LoweringPlanCompilerCsgReleasedBytes(
        plan: var LoweringPlanStub): int64 =
    return plan.compilerCsgLifecycleReleasedBytes

fn LoweringPlanCompilerCsgReleaseReceiptComplete(
        plan: var LoweringPlanStub): bool =
    return plan.compilerCsgLifecycleTransferredReleaseRecorded &&
           plan.compilerCsgLifecycleReleasedBufferCount >= 0 &&
           plan.compilerCsgLifecycleReleasedBytes >= int64(0) &&
           plan.compilerCsgLifecycleReleasedBufferCount <=
               plan.compilerCsgLifecycleInitialBufferCount &&
           plan.compilerCsgLifecycleReleasedBytes <=
               plan.compilerCsgLifecycleInitialBytes

fn LoweringPlanReleaseLineMapUnusedPayload(plan: var LoweringPlanStub) =
    LoweringPlanReleasePrimaryObjectIrFunctionShapeAllocators(plan)
    LoweringPlanReleasePrimaryObjectIrCallTargetAllocators(plan)
    LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
    LoweringPlanReleaseTypedFunctionReferenceIndexPayload(plan)
    LoweringPlanReleaseModuleSourceIndexPayload(plan)
    LoweringPlanReleaseFnPtrFieldCallPayload(plan)
    LoweringNormalizedExprLayerTerminalRelease(plan.exprLayer)
    LoweringPlanReleaseCompilerCsgExprSliceSidecar(plan)
    texpr.TypedExprFactTableRelease(plan.typedExprFacts)
    LoweringPlanReleaseResolvedCallSnapshot(plan)
    LoweringPlanReleaseResolvedCallFactIndexPayload(plan)
    LoweringPlanReleaseTypedFunctionLookupSidecarPayload(plan)
    LoweringPlanReleaseSemanticIdentityPayload(plan)
    LoweringPlanReleaseFunctionEmissionMetadataPayload(plan)
    LoweringPlanReleaseSemanticDebugPayload(plan)
    LoweringPlanReleasePrimaryImportResolutionPayload(plan)
    LoweringTypedFunctionDenseStoreInputAllocatorRelease(plan)
    dense.DenseStoreRelease(plan.typedFunctionDenseStore)
    LoweringFunctionDenseStoreInputAllocatorRelease(plan)
    dense.DenseStoreRelease(plan.functionDenseStore)
    texpr.TypedExprIrReleasePayload(plan.typedIr)
    LoweringPlanReleaseTypeArenaOwnerProofPayload(plan)
    seqs.freeSeq(plan.typeArenaStructuralKinds)
    seqs.freeSeq(plan.typeArenaScalarKinds)
    seqs.freeSeq(plan.typeArenaChildTypeIds)
    seqs.freeSeq(plan.typeArenaLayoutChildStarts)
    seqs.freeSeq(plan.typeArenaLayoutChildCounts)
    seqs.freeSeq(plan.typeArenaLayoutChildTypeIds)
    seqs.freeSeq(plan.typeArenaLayoutChildIdentityKinds)
    seqs.freeSeq(plan.typeArenaLayoutChildMemberRows)
    seqs.freeSeq(plan.typeArenaLayoutChildSelectorOrdinals)
    seqs.freeSeq(plan.typeArenaLayoutChildOffsets)
    seqs.freeSeq(plan.typeArenaLayoutChildWidths)
    seqs.freeSeq(plan.typeArenaFixedLengths)
    seqs.freeSeq(plan.typeArenaVariantCounts)
    seqs.freeSeq(plan.typeArenaSizeBytes)
    seqs.freeSeq(plan.typeArenaAlignBytes)
    seqs.freeSeq(plan.typeArenaLayoutPresent)
    LoweringPlanReleaseCanonicalSnapshotProjectionPayload(plan)
    LoweringResolvedCallTargetProjectionRelease(plan)
    plan.semanticSnapshotSchemaVersion = 0
    plan.semanticSnapshotEpoch = int64(0)
    var zeroToken: layout.FixedBytes32
    loweringPlanFixed32CopyInto(
        plan.semanticSnapshotPredecessorReceiptCid,
        zeroToken)
    loweringPlanFixed32CopyInto(
        plan.fnPtrFieldCallTypeArenaArtifactCid,
        zeroToken)
    loweringPlanReleaseTypedReturnOps(plan.typedReturnOps)
    LoweringPrimaryObjectIrReleasePayload(plan.primaryObjectIr)
    LoweringPrimaryObjectIrFunctionArrayReleasePayload(
        plan.primaryObjectIrFunctions)
    loweringPlanReleaseLoweringRules(plan.loweringRules)

fn loweringPlanRetainedRecordCapacity(
        report: var LoweringPlanRetainedStorageReport,
        capacity: int32,
        elementBytes: int32) =
    if capacity < 0 || elementBytes <= 0:
        panic("lowering plan: invalid owned sequence capacity")
    if capacity > 0:
        report.physicalBufferCount =
            report.physicalBufferCount + 1
        report.retainedBytes =
            report.retainedBytes +
            int64(capacity) * int64(elementBytes)

fn loweringPlanRetainedRecordSequence(
        report: var LoweringPlanRetainedStorageReport,
        values: var int32[]) =
    loweringPlanRetainedRecordCapacity(
        report, values.cap, sizeof(int32))

fn loweringPlanRetainedRecordSequence(
        report: var LoweringPlanRetainedStorageReport,
        values: var bool[]) =
    loweringPlanRetainedRecordCapacity(
        report, values.cap, sizeof(bool))

fn loweringPlanRetainedRecordSequence(
        report: var LoweringPlanRetainedStorageReport,
        values: var layout.FixedBytes32[]) =
    loweringPlanRetainedRecordCapacity(
        report, values.cap, sizeof(layout.FixedBytes32))

fn loweringPlanRetainedRecordExternFfiHandleCallCapabilityBridgeSidecar(
        report: var LoweringPlanRetainedStorageReport,
        bridge: var LoweringExternFfiHandleCallCapabilityBridge) =
    loweringPlanRetainedRecordSequence(report, bridge.semanticContractCids)
    loweringPlanRetainedRecordSequence(report, bridge.semanticInterfaceCids)
    loweringPlanRetainedRecordSequence(report, bridge.semanticEffectCids)
    loweringPlanRetainedRecordSequence(report, bridge.snapshotCallIds)
    loweringPlanRetainedRecordSequence(report, bridge.snapshotContractRows)
    loweringPlanRetainedRecordSequence(report, bridge.snapshotEffectRows)
    loweringPlanRetainedRecordSequence(report, bridge.effectBridgeCids)
    loweringPlanRetainedRecordSequence(report, bridge.callBridgeCids)

@borrows
fn loweringPlanRetainedRecordString(
        report: var LoweringPlanRetainedStorageReport,
        value: str) =
    report.retainedBytes =
        report.retainedBytes + int64(value.len)

fn loweringPlanRetainedRecordStringArray(
        report: var LoweringPlanRetainedStorageReport,
        values: var str[]) =
    loweringPlanRetainedRecordCapacity(
        report, values.cap, sizeof(str))
    for valueIndex in 0..<values.len:
        loweringPlanRetainedRecordString(
            report, values[valueIndex])

fn loweringPlanRetainedRecordTypedReturnOps(
        report: var LoweringPlanRetainedStorageReport,
        values: var texpr.TypedExprReturnOpFact[]) =
    loweringPlanRetainedRecordCapacity(
        report, values.cap,
        sizeof(texpr.TypedExprReturnOpFact))
    for valueIndex in 0..<values.len:
        loweringPlanRetainedRecordString(
            report, values[valueIndex].sourcePath)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].functionName)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].returnType)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].lhsName)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].lhsType)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].rhsName)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].rhsType)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].accName)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].accType)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].returnExpr)

fn loweringPlanRetainedRecordLoweringRules(
        report: var LoweringPlanRetainedStorageReport,
        values: var texpr.TypedExprLoweringRule[]) =
    loweringPlanRetainedRecordCapacity(
        report, values.cap,
        sizeof(texpr.TypedExprLoweringRule))
    for valueIndex in 0..<values.len:
        loweringPlanRetainedRecordString(
            report, values[valueIndex].exprId)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].sourcePath)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].callQualifier)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].callCallee)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].callTarget)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].callTargetSourcePath)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].callArgsText)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].typeText)

fn loweringPlanRetainedRecordImportEdges(
        report: var LoweringPlanRetainedStorageReport,
        values: var parser.ImportEdge[]) =
    loweringPlanRetainedRecordCapacity(
        report, values.cap, sizeof(parser.ImportEdge))
    for valueIndex in 0..<values.len:
        loweringPlanRetainedRecordString(
            report, values[valueIndex].ownerModulePath)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].targetModulePath)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].targetSourcePath)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].importAlias)
        loweringPlanRetainedRecordString(
            report, values[valueIndex].qualifier)

fn loweringPlanRetainedRecordPrimaryStatement(
        report: var LoweringPlanRetainedStorageReport,
        statement: var PrimaryObjectIrStatement) =
    loweringPlanRetainedRecordString(report, statement.sourcePath)
    loweringPlanRetainedRecordString(report, statement.functionName)
    loweringPlanRetainedRecordString(report, statement.surfaceText)
    loweringPlanRetainedRecordString(report, statement.bindingName)
    loweringPlanRetainedRecordString(report, statement.resultType)
    loweringPlanRetainedRecordString(
        report, statement.conditionLhsText)
    loweringPlanRetainedRecordString(
        report, statement.conditionRhsText)
    loweringPlanRetainedRecordString(
        report, statement.conditionLiteralText)
    loweringPlanRetainedRecordString(report, statement.assignRootName)
    loweringPlanRetainedRecordString(report, statement.assignRootType)
    loweringPlanRetainedRecordString(
        report, statement.assignRootSourcePath)
    loweringPlanRetainedRecordString(report, statement.assignFieldName)
    loweringPlanRetainedRecordString(report, statement.assignFieldType)
    loweringPlanRetainedRecordString(
        report, statement.assignValueRootName)
    loweringPlanRetainedRecordString(
        report, statement.assignValueRootType)
    loweringPlanRetainedRecordString(
        report, statement.assignValueFieldName)
    loweringPlanRetainedRecordString(
        report, statement.assignValueFieldType)
    loweringPlanRetainedRecordString(
        report, statement.assignValueLhsText)
    loweringPlanRetainedRecordString(
        report, statement.assignValueRhsText)
    loweringPlanRetainedRecordString(report, statement.callCallee)
    loweringPlanRetainedRecordString(report, statement.callTarget)
    loweringPlanRetainedRecordString(
        report, statement.callTargetSourcePath)
    loweringPlanRetainedRecordString(report, statement.callArgsText)
    loweringPlanRetainedRecordString(
        report, statement.callArgTypesText)

fn loweringPlanRetainedRecordPrimaryFunctions(
        report: var LoweringPlanRetainedStorageReport,
        values: var PrimaryObjectIrFunction[]) =
    loweringPlanRetainedRecordCapacity(
        report, values.cap, sizeof(PrimaryObjectIrFunction))
    for functionIndex in 0..<values.len:
        var fnIr = values[functionIndex]
        loweringPlanRetainedRecordString(report, fnIr.sourcePath)
        loweringPlanRetainedRecordString(report, fnIr.functionName)
        loweringPlanRetainedRecordString(report, fnIr.bodyKind)
        loweringPlanRetainedRecordStringArray(report, fnIr.paramNames)
        loweringPlanRetainedRecordStringArray(report, fnIr.paramTypes)
        loweringPlanRetainedRecordCapacity(
            report, fnIr.statements.cap,
            sizeof(PrimaryObjectIrStatement))
        for statementIndex in 0..<fnIr.statements.len:
            loweringPlanRetainedRecordPrimaryStatement(
                report, fnIr.statements[statementIndex])
        loweringPlanRetainedRecordSequence(report, fnIr.callArgCounts)
        loweringPlanRetainedRecordStringArray(report, fnIr.callTargets)
        loweringPlanRetainedRecordStringArray(
            report, fnIr.callTargetSourcePaths)
        loweringPlanRetainedRecordSequence(
            report, fnIr.callTargetSignatureLineNumbers)
        loweringPlanRetainedRecordSequence(
            report, fnIr.callTargetImportcFlags)
        loweringPlanRetainedRecordSequence(
            report, fnIr.callTargetTypedFunctionIndexes)
        loweringPlanRetainedRecordStringArray(
            report, fnIr.callImportcSymbols)
        loweringPlanRetainedRecordStringArray(
            report, fnIr.callArgTypesTexts)
        report.physicalBufferCount =
            report.physicalBufferCount +
            LoweringDeferScopeTransportPhysicalBufferCount(
                fnIr.deferScopeTransport) +
            LoweringOwnershipTransportPhysicalBufferCount(
                fnIr.ownershipTransport)
        report.retainedBytes =
            report.retainedBytes +
            LoweringDeferScopeTransportRetainedBytes(
                fnIr.deferScopeTransport) +
            LoweringOwnershipTransportCapacityBytes(
                fnIr.ownershipTransport)
        let bodyRetained = bodylifecycle.BodyIrPayloadRetained(fnIr.bodyIR)
        report.physicalBufferCount =
            report.physicalBufferCount +
            bodyRetained.physicalBufferCount
        report.retainedBytes =
            report.retainedBytes + bodyRetained.retainedBytes

fn loweringPlanRetainedRecordDebugFacts(
        report: var LoweringPlanRetainedStorageReport,
        bundle: var debugfact.DebugFactBundle) =
    loweringPlanRetainedRecordString(report, bundle.packageId)
    loweringPlanRetainedRecordCapacity(
        report, bundle.facts.cap, sizeof(debugfact.DebugFact))
    for factIndex in 0..<bundle.facts.len:
        loweringPlanRetainedRecordString(
            report, bundle.facts[factIndex].
                functionFact.modulePath)
        loweringPlanRetainedRecordString(
            report, bundle.facts[factIndex].
                functionFact.functionName)
        loweringPlanRetainedRecordString(
            report, bundle.facts[factIndex].
                functionFact.qualifiedName)
        loweringPlanRetainedRecordString(
            report, bundle.facts[factIndex].
                operationFact.modulePath)
        loweringPlanRetainedRecordString(
            report, bundle.facts[factIndex].
                symbolFact.modulePath)
        loweringPlanRetainedRecordString(
            report, bundle.facts[factIndex].
                symbolFact.name)
        loweringPlanRetainedRecordString(
            report, bundle.facts[factIndex].
                symbolFact.qualifiedName)
        loweringPlanRetainedRecordString(
            report, bundle.facts[factIndex].
                layoutFact.canonicalTypeName)

fn LoweringPlanRetainedStorage(
        plan: var LoweringPlanStub): LoweringPlanRetainedStorageReport =
    var report: LoweringPlanRetainedStorageReport
    loweringPlanRetainedRecordString(report, plan.workspaceRoot)
    loweringPlanRetainedRecordString(report, plan.packageRoot)
    loweringPlanRetainedRecordString(report, plan.packageId)
    loweringPlanRetainedRecordString(report, plan.entryPath)
    loweringPlanRetainedRecordString(report, plan.entrySymbol)
    loweringPlanRetainedRecordString(
        report, plan.compilerCsgExprSliceSidecarValidationReason)
    loweringPlanRetainedRecordString(
        report, plan.primaryObjectIrBuildMode)
    loweringPlanRetainedRecordString(report, plan.pipelineStage)

    loweringPlanRetainedRecordStringArray(report, plan.resolvedCallFactSourcePaths)
    loweringPlanRetainedRecordSequence(report, plan.resolvedCallFactSourceBucketHeads)
    loweringPlanRetainedRecordSequence(report, plan.resolvedCallFactSourceEntryNext)
    loweringPlanRetainedRecordSequence(report, plan.resolvedCallFactBucketHeads)
    loweringPlanRetainedRecordSequence(report, plan.resolvedCallFactEntryNext)
    loweringPlanRetainedRecordSequence(report, plan.resolvedCallFactEntrySourceIndexes)
    loweringPlanRetainedRecordSequence(report, plan.resolvedCallFactEntryLineNumbers)
    loweringPlanRetainedRecordSequence(report, plan.resolvedCallFactEntryFactIndexes)
    loweringPlanRetainedRecordStringArray(report, plan.typedFunctionIndexSourcePaths)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIndexSourceBucketHeads)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIndexSourceEntryNext)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIndexAbsoluteSuffixBucketHeads)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIndexAbsoluteSuffixEntryNext)
    loweringPlanRetainedRecordStringArray(report, plan.typedFunctionIndexAbsoluteSuffixEntryNames)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIndexAbsoluteSuffixEntrySourceIndexes)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIndexBucketHeads)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIndexEntryNext)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIndexEntrySourceIndexes)
    loweringPlanRetainedRecordStringArray(report, plan.typedFunctionIndexEntryNames)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIndexEntryIndexes)
    loweringPlanRetainedRecordStringArray(report, plan.typedFunctionIdentitySourcePaths)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIdentitySourceBucketHeads)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIdentitySourceEntryNext)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIdentityBucketHeads)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIdentityEntryNext)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIdentityEntrySourceIndexes)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIdentityEntryNameIds)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIdentityEntryDeclarationLines)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionIdentityEntryFunctionIndexes)
    loweringPlanRetainedRecordStringArray(report, plan.typedFunctionReferenceSourcePaths)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionReferenceSourceBucketHeads)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionReferenceSourceEntryNext)
