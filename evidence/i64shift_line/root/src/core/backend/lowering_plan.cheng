    loweringPlanRetainedRecordSequence(
        report, plan.resolvedCallTargetTypedFunctionIndexes)
    loweringPlanRetainedRecordExternFfiHandleCallCapabilityBridgeSidecar(
        report, plan.externFfiHandleCallCapabilityBridge)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.tokenIds)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.callRows)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.callerTypedFunctionIndexes)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.callExprNodeIndexes)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.calleeFunctionIndexes)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.targetArgumentRows)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.sourceArgumentRows)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.targetArgumentOrdinals)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.sourceArgumentOrdinals)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.targetArgLinkNodeIndexes)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.sourceArgLinkNodeIndexes)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.targetValueNodeIndexes)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.sourceValueNodeIndexes)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.targetParameterDeclarationRows)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.sourceParameterDeclarationRows)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.targetTypeIds)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.sourceTypeIds)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.targetBindingCids)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.sourceBindingCids)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.targetPlaceRootValueDefinitionRows)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.sourceValueDefinitionRows)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.targetProjectionCids)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.sourceProjectionCids)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.typedEffectCids)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.tokenCids)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.projection.effectStarts)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.projection.effectCounts)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.projection.
            effectProjectionCids)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.projection.hopIds)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.projection.hopEffectRows)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.projection.hopOrdinals)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.projection.hopNodeIndexes)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.projection.hopOpKinds)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.projection.hopExactTypeIds)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.projection.
            hopOwnerProducerSourceIndexes)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.projection.
            hopOwnerDeclarationSourceLocalRows)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.projection.
            hopOperand0NodeIndexes)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.projection.
            hopFieldProducerSourceIndexes)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.projection.
            hopFieldOwnerDeclarationSourceLocalRows)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.projection.
            hopFieldDeclarationSourceLocalRows)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.projection.hopFieldOrdinals)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.projection.hopFieldBuiltinKinds)
    loweringPlanRetainedRecordSequence(
        report,
        plan.manualConsumeCallBridge.tokens.projection.hopIndexNodeIndexes)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.tokens.projection.hopCids)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.snapshotCallIds)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.calleeFunctionIds)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.calleeInterfaceCids)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.canonicalEffectCids)
    loweringPlanRetainedRecordSequence(
        report, plan.manualConsumeCallBridge.bridgeCids)
    report.physicalBufferCount =
        report.physicalBufferCount +
        loweringResolvedCallTargetProjectionLedgerPhysicalBufferCount(
            plan.resolvedCallTargetProjectionOwner)
    report.retainedBytes =
        report.retainedBytes +
        loweringResolvedCallTargetProjectionLedgerRetainedBytes(
            plan.resolvedCallTargetProjectionOwner)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionReturnTypeArenaTypeIds)
    loweringPlanRetainedRecordSequence(report, plan.typedFunctionReturnManagedStorageKinds)
    loweringPlanRetainedRecordSequence(report, plan.globalTypeArenaTypeIds)
    loweringPlanRetainedRecordSequence(report, plan.globalManagedStorageKinds)
    loweringPlanRetainedRecordTypedReturnOps(report, plan.typedReturnOps)
    loweringPlanRetainedRecordPrimaryFunctions(
        report, plan.primaryObjectIrFunctions)
    loweringPlanRetainedRecordLoweringRules(report, plan.loweringRules)
    loweringPlanRetainedRecordStringArray(report, plan.functionSourcePaths)
    loweringPlanRetainedRecordStringArray(report, plan.functionOwnerModulePaths)
    loweringPlanRetainedRecordStringArray(report, plan.functionNames)
    loweringPlanRetainedRecordStringArray(report, plan.functionSymbolTexts)
    loweringPlanRetainedRecordStringArray(report, plan.functionSemanticSources)
    loweringPlanRetainedRecordSequence(report, plan.functionSemanticDeclarationLineIndexes)
    loweringPlanRetainedRecordStringArray(report, plan.functionSemanticParamTypeJoins)
    loweringPlanRetainedRecordStringArray(report, plan.functionSemanticReturnTypes)
    loweringPlanRetainedRecordSequence(report, plan.functionSemanticSignatureCompletes)
    loweringPlanRetainedRecordSequence(report, plan.functionTypedIrIndexes)
    loweringPlanRetainedRecordSequence(report, plan.semanticDebugFunctionIdsByTypedFunctionIndex)
    loweringPlanRetainedRecordSequence(report, plan.semanticDebugTypedNodeIdsByTypedIrNodeIndex)
    loweringPlanRetainedRecordSequence(report, plan.semanticDebugOpIdsByTypedIrNodeIndex)
    loweringPlanRetainedRecordSequence(report, plan.functionExportedFlags)
    loweringPlanRetainedRecordStringArray(report, plan.functionExportSymbolNames)
    loweringPlanRetainedRecordSequence(
        report, plan.functionExportNameExplicitFlags)
    loweringPlanRetainedRecordSequence(
        report, plan.functionExportProducerSourceIndexes)
    loweringPlanRetainedRecordSequence(
        report, plan.functionExportProducerDeclarationIndexes)
    loweringPlanRetainedRecordSequence(
        report, plan.functionExportProducerNodeIds)
    loweringPlanRetainedRecordSequence(
        report, plan.functionExportProducerFactCids)
    loweringPlanRetainedRecordSequence(report, plan.functionNameIds)
    loweringPlanRetainedRecordSequence(report, plan.functionEntryFlags)
    loweringPlanRetainedRecordSequence(report, plan.functionCallConvs)
    loweringPlanRetainedRecordSequence(report, plan.functionResultLayoutKinds)
    loweringPlanRetainedRecordSequence(report, plan.functionSignatureLineNumbers)
    loweringPlanRetainedRecordSequence(report, plan.functionBodyLineNumbers)
    loweringPlanRetainedRecordImportEdges(report, plan.importEdges)
    loweringPlanRetainedRecordStringArray(report, plan.importEdgeIndexOwnerModulePaths)
    loweringPlanRetainedRecordStringArray(report, plan.importEdgeIndexQualifiers)
    loweringPlanRetainedRecordSequence(report, plan.importEdgeIndexEntryEdgeIndexes)
    loweringPlanRetainedRecordSequence(report, plan.importEdgeIndexBucketHeads)
    loweringPlanRetainedRecordSequence(report, plan.importEdgeIndexEntryNext)
    loweringPlanRetainedRecordStringArray(report, plan.importOwnerIndexOwnerModulePaths)
    loweringPlanRetainedRecordSequence(report, plan.importOwnerIndexEntryEdgeIndexes)
    loweringPlanRetainedRecordSequence(report, plan.importOwnerIndexBucketHeads)
    loweringPlanRetainedRecordSequence(report, plan.importOwnerIndexEntryNext)
    loweringPlanRetainedRecordStringArray(report, plan.unqualifiedImportResolveCacheSourcePaths)
    loweringPlanRetainedRecordStringArray(report, plan.unqualifiedImportResolveCacheFunctionNames)
    loweringPlanRetainedRecordStringArray(report, plan.unqualifiedImportResolveCacheTargetSourcePaths)
    loweringPlanRetainedRecordSequence(report, plan.unqualifiedImportResolveCacheBucketHeads)
    loweringPlanRetainedRecordSequence(report, plan.unqualifiedImportResolveCacheEntryNext)
    loweringPlanRetainedRecordStringArray(report, plan.qualifiedImportResolveCacheSourcePaths)
    loweringPlanRetainedRecordStringArray(report, plan.qualifiedImportResolveCacheQualifiers)
    loweringPlanRetainedRecordStringArray(report, plan.qualifiedImportResolveCacheTargetSourcePaths)
    loweringPlanRetainedRecordSequence(report, plan.qualifiedImportResolveCacheBucketHeads)
    loweringPlanRetainedRecordSequence(report, plan.qualifiedImportResolveCacheEntryNext)
    loweringPlanRetainedRecordStringArray(report, plan.missingReasons)

    # These five nested owners are moved from CompilerCSG. Production bind
    # records their exact physical allocation/byte partition once; after the
    # partition is consumed, no retained contribution is legal.
    if !plan.compilerCsgLifecycleTransferredReleaseRecorded:
        if plan.compilerCsgLifecycleTransferredBufferCount < 0 ||
           plan.compilerCsgLifecycleTransferredBytes < int64(0):
            panic("lowering plan: invalid transferred storage receipt")
        report.physicalBufferCount =
            report.physicalBufferCount +
            plan.compilerCsgLifecycleTransferredBufferCount
        report.retainedBytes =
            report.retainedBytes +
            plan.compilerCsgLifecycleTransferredBytes

    report.physicalBufferCount =
        report.physicalBufferCount +
        dense.DenseStorePhysicalBufferCount(
            plan.typedFunctionDenseStore) +
        dense.DenseStorePhysicalBufferCount(plan.functionDenseStore)
    report.retainedBytes =
        report.retainedBytes +
        dense.DenseStoreRetainedBytes(plan.typedFunctionDenseStore) +
        dense.DenseStoreRetainedBytes(plan.functionDenseStore)
    loweringPlanRetainedRecordPrimaryFunctions(
        report, plan.primaryObjectIr.functions)
    loweringPlanRetainedRecordDebugFacts(
        report, plan.semanticDebugFacts)
    if report.physicalBufferCount < 0 ||
       report.retainedBytes < int64(0):
        panic("lowering plan: retained storage overflow")
    return report

fn LoweringPlanRetainedBufferCount(
        plan: var LoweringPlanStub): int32 =
    return LoweringPlanRetainedStorage(plan).physicalBufferCount

fn LoweringPlanRetainedBytes(
        plan: var LoweringPlanStub): int64 =
    return LoweringPlanRetainedStorage(plan).retainedBytes

fn loweringPlanReleaseAppendU32BE(
        buf: var layout.ByteBuf,
        value: int64) =
    layout.ByteBufAppendByte(buf, Int32((value >> 24) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 16) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 8) & 255))
    layout.ByteBufAppendByte(buf, Int32(value & 255))

@borrows
fn loweringPlanReleaseAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    loweringPlanReleaseAppendU32BE(buf, value.len)
    for textIndex in 0..<value.len:
        layout.ByteBufAppendByte(buf, value[textIndex])

fn loweringPlanReleaseAppendU32Field(
        buf: var layout.ByteBuf,
        value: int64) =
    loweringPlanReleaseAppendU32BE(buf, 4)
    loweringPlanReleaseAppendU32BE(buf, value)

fn loweringPlanReleaseAppendI64Field(
        buf: var layout.ByteBuf,
        value: int64) =
    loweringPlanReleaseAppendU32BE(buf, 8)
    loweringPlanReleaseAppendU32BE(buf, value >> 32)
    loweringPlanReleaseAppendU32BE(buf, value)

@borrows
fn loweringPlanReleaseAppendInt32s(
        buf: var layout.ByteBuf,
        values: int32[]) =
    loweringPlanReleaseAppendU32Field(buf, values.len)
    for valueIndex in 0..<values.len:
        loweringPlanReleaseAppendU32Field(
            buf, values[valueIndex])

@borrows
fn loweringPlanReleaseAppendFixed32s(
        buf: var layout.ByteBuf,
        values: layout.FixedBytes32[]) =
    loweringPlanReleaseAppendU32Field(buf, values.len)
    for valueIndex in 0..<values.len:
        layout.ByteBufAppendFixed32(buf, values[valueIndex])

@borrows
fn loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf: var layout.ByteBuf,
        table: ccsg.CompilerCsgExternFfiHandleCallCapabilityTable,
        column: arenamod.ArenaArrayInt32) =
    loweringPlanReleaseAppendU32Field(buf, column.len)
    for valueIndex in 0..<column.len:
        loweringPlanReleaseAppendU32Field(
            buf,
            loweringExternFfiHandleCapabilitySemanticI32(
                table, column, valueIndex))

@borrows
fn loweringPlanReleaseAppendExternFfiHandleCallCapabilityBridge(
        buf: var layout.ByteBuf,
        bridge: LoweringExternFfiHandleCallCapabilityBridge) =
    let table = bridge.semanticCapabilities
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.callCoordinateKinds)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.resolvedCallRows)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.callerTypedFunctionIndexes)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.typedCallNodeIndexes)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.contractRows)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.effectStarts)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.effectCounts)
    loweringPlanReleaseAppendFixed32s(buf, table.callCapabilityCids)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.effectRows)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.effectKinds)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.effectTargetKinds)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.effectParameterOrdinals)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.effectArgumentRows)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.effectArgumentValueNodeIndexes)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.effectValueDefinitionRows)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.effectGenerationRootValueDefinitionRows)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.effectExactTypeIds)
    loweringPlanReleaseAppendExternFfiHandleCapabilityArenaInt32s(
        buf, table, table.effectCarrierKinds)
    loweringPlanReleaseAppendFixed32s(
        buf, table.effectArgumentBindingCids)
    loweringPlanReleaseAppendFixed32s(buf, table.effectTypeCids)
    loweringPlanReleaseAppendFixed32s(buf, table.effectGenerationCids)
    loweringPlanReleaseAppendFixed32s(
        buf, table.effectDefinitionLineageCids)
    loweringPlanReleaseAppendFixed32s(buf, table.effectCapabilityCids)
    layout.ByteBufAppendFixed32(buf, table.cargoCid)
    loweringPlanReleaseAppendU32Field(buf, table.complete ? 1 : 0)
    loweringPlanReleaseAppendFixed32s(buf, bridge.semanticContractCids)
    loweringPlanReleaseAppendFixed32s(buf, bridge.semanticInterfaceCids)
    loweringPlanReleaseAppendFixed32s(buf, bridge.semanticEffectCids)
    loweringPlanReleaseAppendInt32s(buf, bridge.snapshotCallIds)
    loweringPlanReleaseAppendInt32s(buf, bridge.snapshotContractRows)
    loweringPlanReleaseAppendInt32s(buf, bridge.snapshotEffectRows)
    loweringPlanReleaseAppendFixed32s(buf, bridge.effectBridgeCids)
    loweringPlanReleaseAppendFixed32s(buf, bridge.callBridgeCids)
    layout.ByteBufAppendFixed32(buf, bridge.semanticCargoCid)
    layout.ByteBufAppendFixed32(buf, bridge.bridgeCid)
    loweringPlanReleaseAppendU32Field(buf, bridge.snapshotBound ? 1 : 0)

@borrows
fn loweringPlanReleaseAppendResolvedCallTargetProjectionReceipt(
        buf: var layout.ByteBuf,
        receipt: LoweringResolvedCallTargetProjectionReceipt) =
    loweringPlanReleaseAppendU32Field(
        buf, receipt.begun ? 1 : 0)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.movedToPlan ? 1 : 0)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.expectedItemCount)
    loweringPlanReleaseAppendU32Field(buf, receipt.categoryId)
    loweringPlanReleaseAppendU32Field(buf, receipt.builderOwnerId)
    loweringPlanReleaseAppendU32Field(buf, receipt.planOwnerId)
    loweringPlanReleaseAppendU32Field(buf, receipt.objectId)
    loweringPlanReleaseAppendU32Field(buf, receipt.reservedCapacity)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.retainedBufferCount)
    loweringPlanReleaseAppendI64Field(buf, receipt.retainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.physicalFreeCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.physicalFreedBytes)
    loweringPlanReleaseAppendI64Field(buf, receipt.allocated)
    loweringPlanReleaseAppendI64Field(buf, receipt.released)
    loweringPlanReleaseAppendI64Field(buf, receipt.live)
    loweringPlanReleaseAppendI64Field(buf, receipt.allocatedBytes)
    loweringPlanReleaseAppendI64Field(buf, receipt.releasedBytes)
    loweringPlanReleaseAppendI64Field(buf, receipt.liveBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.ownerTransferCount)
    loweringPlanReleaseAppendI64Field(buf, receipt.retained)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.borrowReturnCount)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.ledgerStorageReleasedSequenceCount)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.ledgerStorageReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.ledgerStorageReleasedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.ledgerStorageReleased ? 1 : 0)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.storageReleased ? 1 : 0)

fn loweringPlanReleaseOwnerToken(
        plan: var LoweringPlanStub,
        releasedBufferCount: int32,
        releasedBytes: int64): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(2048)
    loweringPlanReleaseAppendText(
        buf, "cheng.compiler.lowering_plan.owner_release")
    loweringPlanReleaseAppendU32Field(
        buf, LoweringPlanOwnedStorageColumnCount)
    loweringPlanReleaseAppendU32Field(
        buf, releasedBufferCount)
    loweringPlanReleaseAppendI64Field(buf, releasedBytes)
    let deferScopeAllocator =
        plan.deferScopeTransportAllocatorReceipt
    loweringPlanReleaseAppendI64Field(
        buf, deferScopeAllocator.allocationEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, deferScopeAllocator.releaseEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, deferScopeAllocator.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(
        buf, deferScopeAllocator.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
