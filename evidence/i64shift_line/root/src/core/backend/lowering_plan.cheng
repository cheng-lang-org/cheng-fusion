    loweringPlanRetainedRecordSequence(report, plan.fnPtrFieldCallNodeIndexes)
    loweringPlanRetainedRecordSequence(report, plan.fnPtrFieldCallFieldNodeIndexes)
    loweringPlanRetainedRecordSequence(report, plan.fnPtrFieldCallFieldTypeIds)
    loweringPlanRetainedRecordSequence(report, plan.fnPtrFieldCallStructuralKinds)
