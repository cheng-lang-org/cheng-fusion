fn loweringSequenceAllocatorRelease(
        ledger: var LoweringSequenceAllocatorLedger,
        values: var texpr.TypedExprIrStatementKind[],
        elementBytes: int32): int64 =
    if ledger.closed || values.cap < 0 || elementBytes <= 0:
        panic("lowering sequence allocator: invalid terminal release")
    let retainedCapacity = values.cap
    var releasedBytes: int64
    if retainedCapacity > 0:
        if values.buffer == nil:
            panic("lowering sequence allocator: live Seq buffer missing")
        releasedBytes =
            int64(retainedCapacity) * int64(elementBytes)
        if ledger.liveAllocationCount <= int64(0) ||
           ledger.liveCapacityBytes < releasedBytes:
            panic("lowering sequence allocator: terminal release underflow")
        ledger.releaseEventCount =
            ledger.releaseEventCount + int64(1)
        ledger.releasedCapacityBytes =
            ledger.releasedCapacityBytes + releasedBytes
        ledger.liveAllocationCount =
            ledger.liveAllocationCount - int64(1)
        ledger.liveCapacityBytes =
            ledger.liveCapacityBytes - releasedBytes
    seqs.freeSeq(values)
    if values.len != 0 || values.cap != 0 || values.buffer != nil:
        panic("lowering sequence allocator: physical Seq release failed")
    return releasedBytes

fn loweringSequenceAllocatorRelease(
        ledger: var LoweringSequenceAllocatorLedger,
        values: var bool[],
        elementBytes: int32): int64 =
    if ledger.closed || values.cap < 0 || elementBytes <= 0:
        panic("lowering sequence allocator: invalid terminal release")
    let retainedCapacity = values.cap
    var releasedBytes: int64
    if retainedCapacity > 0:
        if values.buffer == nil:
            panic("lowering sequence allocator: live Seq buffer missing")
        releasedBytes =
            int64(retainedCapacity) * int64(elementBytes)
        if ledger.liveAllocationCount <= int64(0) ||
           ledger.liveCapacityBytes < releasedBytes:
            panic("lowering sequence allocator: terminal release underflow")
        ledger.releaseEventCount =
            ledger.releaseEventCount + int64(1)
        ledger.releasedCapacityBytes =
            ledger.releasedCapacityBytes + releasedBytes
        ledger.liveAllocationCount =
            ledger.liveAllocationCount - int64(1)
        ledger.liveCapacityBytes =
            ledger.liveCapacityBytes - releasedBytes
    seqs.freeSeq(values)
    if values.len != 0 || values.cap != 0 || values.buffer != nil:
        panic("lowering sequence allocator: physical Seq release failed")
    return releasedBytes

fn loweringSequenceAllocatorRelease(
        ledger: var LoweringSequenceAllocatorLedger,
        values: var texpr.TypedExprExprClass[],
        elementBytes: int32): int64 =
    if ledger.closed || values.cap < 0 || elementBytes <= 0:
        panic("lowering sequence allocator: invalid terminal release")
    let retainedCapacity = values.cap
    var releasedBytes: int64
    if retainedCapacity > 0:
        if values.buffer == nil:
            panic("lowering sequence allocator: live Seq buffer missing")
        releasedBytes =
            int64(retainedCapacity) * int64(elementBytes)
        if ledger.liveAllocationCount <= int64(0) ||
           ledger.liveCapacityBytes < releasedBytes:
            panic("lowering sequence allocator: terminal release underflow")
        ledger.releaseEventCount =
            ledger.releaseEventCount + int64(1)
        ledger.releasedCapacityBytes =
            ledger.releasedCapacityBytes + releasedBytes
        ledger.liveAllocationCount =
            ledger.liveAllocationCount - int64(1)
        ledger.liveCapacityBytes =
            ledger.liveCapacityBytes - releasedBytes
    seqs.freeSeq(values)
    if values.len != 0 || values.cap != 0 || values.buffer != nil:
        panic("lowering sequence allocator: physical Seq release failed")
    return releasedBytes

fn loweringSequenceAllocatorRelease(
        ledger: var LoweringSequenceAllocatorLedger,
        values: var texpr.TypedExprIrOpKind[],
        elementBytes: int32): int64 =
    if ledger.closed || values.cap < 0 || elementBytes <= 0:
        panic("lowering sequence allocator: invalid terminal release")
    let retainedCapacity = values.cap
    var releasedBytes: int64
    if retainedCapacity > 0:
        if values.buffer == nil:
            panic("lowering sequence allocator: live Seq buffer missing")
        releasedBytes =
            int64(retainedCapacity) * int64(elementBytes)
        if ledger.liveAllocationCount <= int64(0) ||
           ledger.liveCapacityBytes < releasedBytes:
            panic("lowering sequence allocator: terminal release underflow")
        ledger.releaseEventCount =
            ledger.releaseEventCount + int64(1)
        ledger.releasedCapacityBytes =
            ledger.releasedCapacityBytes + releasedBytes
        ledger.liveAllocationCount =
            ledger.liveAllocationCount - int64(1)
        ledger.liveCapacityBytes =
            ledger.liveCapacityBytes - releasedBytes
    seqs.freeSeq(values)
    if values.len != 0 || values.cap != 0 || values.buffer != nil:
        panic("lowering sequence allocator: physical Seq release failed")
    return releasedBytes

@borrows
fn LoweringSequenceAllocatorReceiptClosed(
        receipt: LoweringSequenceAllocatorReceipt): bool =
    return receipt.allocationEventCount >= int64(0) &&
           receipt.allocationEventCount ==
               receipt.releaseEventCount &&
           receipt.allocatedCapacityBytes >= int64(0) &&
           receipt.allocatedCapacityBytes ==
               receipt.releasedCapacityBytes &&
           receipt.terminalRetainedBufferCount >= 0 &&
           receipt.terminalRetainedBufferCount ==
               receipt.terminalReleasedBufferCount &&
           receipt.terminalRetainedBytes >= int64(0) &&
           receipt.terminalRetainedBytes ==
               receipt.terminalReleasedBytes &&
           receipt.liveAllocationCount == int64(0) &&
           receipt.liveCapacityBytes == int64(0) &&
           receipt.storageReleased

@borrows
fn LoweringSequenceAllocatorReceiptEqual(
        lhs: LoweringSequenceAllocatorReceipt,
        rhs: LoweringSequenceAllocatorReceipt): bool =
    return lhs.allocationEventCount == rhs.allocationEventCount &&
           lhs.releaseEventCount == rhs.releaseEventCount &&
           lhs.allocatedCapacityBytes == rhs.allocatedCapacityBytes &&
           lhs.releasedCapacityBytes == rhs.releasedCapacityBytes &&
           lhs.terminalRetainedBufferCount ==
               rhs.terminalRetainedBufferCount &&
           lhs.terminalRetainedBytes == rhs.terminalRetainedBytes &&
           lhs.terminalReleasedBufferCount ==
               rhs.terminalReleasedBufferCount &&
           lhs.terminalReleasedBytes == rhs.terminalReleasedBytes &&
           lhs.liveAllocationCount == rhs.liveAllocationCount &&
           lhs.liveCapacityBytes == rhs.liveCapacityBytes &&
           lhs.storageReleased == rhs.storageReleased

fn LoweringSequenceAllocatorReceiptAccumulate(
        out: var LoweringSequenceAllocatorReceipt,
        receipt: LoweringSequenceAllocatorReceipt) =
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering sequence allocator: incomplete child receipt")
    out.allocationEventCount =
        out.allocationEventCount + receipt.allocationEventCount
    out.releaseEventCount =
        out.releaseEventCount + receipt.releaseEventCount
    out.allocatedCapacityBytes =
        out.allocatedCapacityBytes + receipt.allocatedCapacityBytes
    out.releasedCapacityBytes =
        out.releasedCapacityBytes + receipt.releasedCapacityBytes
    out.terminalRetainedBufferCount =
        out.terminalRetainedBufferCount +
            receipt.terminalRetainedBufferCount
    out.terminalRetainedBytes =
        out.terminalRetainedBytes + receipt.terminalRetainedBytes
    out.terminalReleasedBufferCount =
        out.terminalReleasedBufferCount +
            receipt.terminalReleasedBufferCount
    out.terminalReleasedBytes =
        out.terminalReleasedBytes + receipt.terminalReleasedBytes
    out.liveAllocationCount =
        out.liveAllocationCount + receipt.liveAllocationCount
    out.liveCapacityBytes =
        out.liveCapacityBytes + receipt.liveCapacityBytes
    out.storageReleased = true

fn LoweringOwnershipTransportAppendExactRow(
        transport: var LoweringOwnershipTransportSoA,
        definitionGroupRow: int32,
        definitionRow: int32,
        originKind: int32,
        sourceLocalNodeIndex: int32,
        declarationSourceLocalRow: int32,
        patternSourceLocalRow: int32,
        sourceStatementIndex: int32,
        definingNodeIndex: int32,
        exactTypeId: int32,
        ownership: texpr.TypedExprExprClass,
        borrowOwnerValueDefinitionRow: int32,
        proofKind: int32,
        managed: bool,
        nodeOpKind: texpr.TypedExprIrOpKind,
        callDeclarationIndex: int32) =
    let rowCount = transport.definitionRows.len
    if transport.allocatorLedger.closed ||
       transport.definitionGroupRows.len != rowCount ||
       transport.originKinds.len != rowCount ||
       transport.sourceLocalNodeIndexes.len != rowCount ||
       transport.declarationSourceLocalRows.len != rowCount ||
       transport.patternSourceLocalRows.len != rowCount ||
       transport.sourceStatementIndexes.len != rowCount ||
       transport.definingNodeIndexes.len != rowCount ||
       transport.exactTypeIds.len != rowCount ||
       transport.ownershipKinds.len != rowCount ||
       transport.borrowOwnerValueDefinitionRows.len != rowCount ||
       transport.proofKinds.len != rowCount ||
       transport.managedFlags.len != rowCount ||
       transport.nodeOpKinds.len != rowCount ||
       transport.callDeclarationIndexes.len != rowCount:
        panic("lowering ownership transport: append shape drift")
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.definitionGroupRows,
        definitionGroupRow,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.definitionRows,
        definitionRow,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.originKinds,
        originKind,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.sourceLocalNodeIndexes,
        sourceLocalNodeIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.declarationSourceLocalRows,
        declarationSourceLocalRow,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.patternSourceLocalRows,
        patternSourceLocalRow,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.sourceStatementIndexes,
        sourceStatementIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.definingNodeIndexes,
        definingNodeIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.exactTypeIds,
        exactTypeId,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.ownershipKinds,
        ownership,
        sizeof(texpr.TypedExprExprClass))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.borrowOwnerValueDefinitionRows,
        borrowOwnerValueDefinitionRow,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.proofKinds,
        proofKind,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.managedFlags,
        managed,
        sizeof(bool))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.nodeOpKinds,
        nodeOpKind,
        sizeof(texpr.TypedExprIrOpKind))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.callDeclarationIndexes,
        callDeclarationIndex,
        sizeof(int32))

fn LoweringOwnershipTransportReleaseWithAllocatorReceipt(
        transport: var LoweringOwnershipTransportSoA,
        receipt: var LoweringSequenceAllocatorReceipt) =
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringOwnershipTransportPhysicalBufferCount(transport)
    receipt.terminalRetainedBytes =
        LoweringOwnershipTransportCapacityBytes(transport)
    if transport.allocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       transport.allocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering ownership transport: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    let releasedDefinitionGroupBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.definitionGroupRows,
            sizeof(int32))
    if releasedDefinitionGroupBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedDefinitionGroupBytes
    let releasedDefinitionBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.definitionRows,
            sizeof(int32))
    if releasedDefinitionBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedDefinitionBytes
    let releasedOriginBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.originKinds,
            sizeof(int32))
    if releasedOriginBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedOriginBytes
    let releasedSourceLocalBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.sourceLocalNodeIndexes,
            sizeof(int32))
    if releasedSourceLocalBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedSourceLocalBytes
    let releasedDeclarationSourceBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.declarationSourceLocalRows,
            sizeof(int32))
    if releasedDeclarationSourceBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedDeclarationSourceBytes
    let releasedPatternSourceBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.patternSourceLocalRows,
            sizeof(int32))
    if releasedPatternSourceBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedPatternSourceBytes
    let releasedSourceStatementBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.sourceStatementIndexes,
            sizeof(int32))
    if releasedSourceStatementBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedSourceStatementBytes
    let releasedDefiningNodeBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.definingNodeIndexes,
            sizeof(int32))
    if releasedDefiningNodeBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedDefiningNodeBytes
    let releasedExactTypeBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.exactTypeIds,
            sizeof(int32))
    if releasedExactTypeBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedExactTypeBytes
    let releasedOwnershipBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.ownershipKinds,
            sizeof(texpr.TypedExprExprClass))
    if releasedOwnershipBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedOwnershipBytes
    let releasedBorrowOwnerBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.borrowOwnerValueDefinitionRows,
            sizeof(int32))
    if releasedBorrowOwnerBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedBorrowOwnerBytes
    let releasedProofBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.proofKinds,
            sizeof(int32))
    if releasedProofBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedProofBytes
    let releasedManagedBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.managedFlags,
            sizeof(bool))
    if releasedManagedBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedManagedBytes
    let releasedNodeOpBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.nodeOpKinds,
            sizeof(texpr.TypedExprIrOpKind))
    if releasedNodeOpBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedNodeOpBytes
    let releasedCallDeclarationBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.callDeclarationIndexes,
            sizeof(int32))
    if releasedCallDeclarationBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedCallDeclarationBytes
    transport.allocatorLedger.closed = true
    receipt.allocationEventCount =
        transport.allocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        transport.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        transport.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        transport.allocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        terminalReleasedBufferCount
    receipt.terminalReleasedBytes =
        terminalReleasedBytes
    receipt.liveAllocationCount =
        transport.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        transport.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringOwnershipTransportPhysicalBufferCount(transport) == 0 &&
        LoweringOwnershipTransportCapacityBytes(transport) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering ownership transport: allocator receipt incomplete")
    transport = LoweringOwnershipTransportSoA()
    transport.typedFunctionIndex = -1

fn LoweringOwnershipTransportRelease(
        transport: var LoweringOwnershipTransportSoA) =
    var receipt: LoweringSequenceAllocatorReceipt
    LoweringOwnershipTransportReleaseWithAllocatorReceipt(
        transport, receipt)

@borrows
fn LoweringOwnershipTransportClone(
        transport: LoweringOwnershipTransportSoA): LoweringOwnershipTransportSoA =
    if !transport.complete ||
       !LoweringOwnershipTransportShapeComplete(transport) ||
       !LoweringOwnershipTransportDefinitionCsrExact(transport):
        panic("lowering ownership transport: clone source incomplete")
    var out: LoweringOwnershipTransportSoA
    out.typedFunctionIndex = transport.typedFunctionIndex
    out.sourceValueDefinitionStart =
        transport.sourceValueDefinitionStart
    out.sourceValueDefinitionCount =
        transport.sourceValueDefinitionCount
    out.typeArenaArtifactCid = transport.typeArenaArtifactCid
    for row in 0..<transport.definitionRows.len:
        LoweringOwnershipTransportAppendExactRow(
            out,
            transport.definitionGroupRows[row],
            transport.definitionRows[row],
            transport.originKinds[row],
            transport.sourceLocalNodeIndexes[row],
            transport.declarationSourceLocalRows[row],
            transport.patternSourceLocalRows[row],
            transport.sourceStatementIndexes[row],
            transport.definingNodeIndexes[row],
            transport.exactTypeIds[row],
            transport.ownershipKinds[row],
            transport.borrowOwnerValueDefinitionRows[row],
            transport.proofKinds[row],
            transport.managedFlags[row],
            transport.nodeOpKinds[row],
            transport.callDeclarationIndexes[row])
    out.complete = true
    if !LoweringOwnershipTransportShapeComplete(out) ||
       !LoweringOwnershipTransportDefinitionCsrExact(out):
        panic("lowering ownership transport: clone destination incomplete")
    return out

fn LoweringOwnershipTransportMoveInto(
        out: var LoweringOwnershipTransportSoA,
        transport: var LoweringOwnershipTransportSoA) =
    if !transport.complete ||
       !LoweringOwnershipTransportShapeComplete(transport) ||
       !LoweringOwnershipTransportDefinitionCsrExact(transport):
        panic("lowering ownership transport: move source incomplete")
    LoweringOwnershipTransportRelease(out)
    out = transport
    transport = LoweringOwnershipTransportSoA()
    transport.typedFunctionIndex = -1

fn LoweringPrimaryObjectIrCallTargetShapeComplete(
        fnIr: var PrimaryObjectIrFunction): bool =
    let count = fnIr.callTargets.len
    return fnIr.callArgCounts.len == count &&
           fnIr.callTargetSourcePaths.len == count &&
           fnIr.callTargetSignatureLineNumbers.len == count &&
           fnIr.callTargetImportcFlags.len == count &&
           fnIr.callTargetTypedFunctionIndexes.len == count &&
           fnIr.callImportcSymbols.len == count &&
           fnIr.callArgTypesTexts.len == count

fn LoweringPrimaryObjectIrCallTargetAllocatorPhysicalBufferCount(
        fnIr: var PrimaryObjectIrFunction): int32 =
    var count: int32
    if fnIr.callArgCounts.cap > 0:
        count = count + 1
    if fnIr.callTargets.cap > 0:
        count = count + 1
    if fnIr.callTargetSourcePaths.cap > 0:
        count = count + 1
    if fnIr.callTargetSignatureLineNumbers.cap > 0:
        count = count + 1
    if fnIr.callTargetImportcFlags.cap > 0:
        count = count + 1
    if fnIr.callTargetTypedFunctionIndexes.cap > 0:
        count = count + 1
    if fnIr.callImportcSymbols.cap > 0:
        count = count + 1
    if fnIr.callArgTypesTexts.cap > 0:
        count = count + 1
    return count

fn LoweringPrimaryObjectIrCallTargetAllocatorCapacityBytes(
        fnIr: var PrimaryObjectIrFunction): int64 =
    return int64(fnIr.callArgCounts.cap) * int64(sizeof(int32)) +
           int64(fnIr.callTargets.cap) * int64(sizeof(str)) +
           int64(fnIr.callTargetSourcePaths.cap) * int64(sizeof(str)) +
           int64(fnIr.callTargetSignatureLineNumbers.cap) *
               int64(sizeof(int32)) +
           int64(fnIr.callTargetImportcFlags.cap) * int64(sizeof(bool)) +
           int64(fnIr.callTargetTypedFunctionIndexes.cap) *
               int64(sizeof(int32)) +
           int64(fnIr.callImportcSymbols.cap) * int64(sizeof(str)) +
           int64(fnIr.callArgTypesTexts.cap) * int64(sizeof(str))

fn loweringPrimaryObjectIrCallTargetAllocatorMatches(
        fnIr: var PrimaryObjectIrFunction): bool =
    return fnIr.callTargetAllocatorLedger.liveAllocationCount ==
               int64(
                   LoweringPrimaryObjectIrCallTargetAllocatorPhysicalBufferCount(
                       fnIr)) &&
           fnIr.callTargetAllocatorLedger.liveCapacityBytes ==
               LoweringPrimaryObjectIrCallTargetAllocatorCapacityBytes(fnIr)

@borrows
fn LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr: var PrimaryObjectIrFunction,
        callArgCount: int32,
        callTarget: str,
        callTargetSourcePath: str,
        callTargetSignatureLineNumber: int32,
        callTargetImportc: bool,
        callTargetTypedFunctionIndex: int32,
        callImportcSymbol: str,
        callArgTypesText: str) =
    if !LoweringPrimaryObjectIrCallTargetShapeComplete(fnIr) ||
       fnIr.callTargetAllocatorLedger.closed:
        panic("lowering primary object call target: invalid append owner")
    loweringSequenceAllocatorAdd(
        fnIr.callTargetAllocatorLedger,
        fnIr.callArgCounts,
        callArgCount,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        fnIr.callTargetAllocatorLedger,
        fnIr.callTargets,
        callTarget,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        fnIr.callTargetAllocatorLedger,
        fnIr.callTargetSourcePaths,
        callTargetSourcePath,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        fnIr.callTargetAllocatorLedger,
        fnIr.callTargetSignatureLineNumbers,
        callTargetSignatureLineNumber,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        fnIr.callTargetAllocatorLedger,
        fnIr.callTargetImportcFlags,
        callTargetImportc,
        sizeof(bool))
    loweringSequenceAllocatorAdd(
        fnIr.callTargetAllocatorLedger,
        fnIr.callTargetTypedFunctionIndexes,
        callTargetTypedFunctionIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        fnIr.callTargetAllocatorLedger,
        fnIr.callImportcSymbols,
        callImportcSymbol,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        fnIr.callTargetAllocatorLedger,
        fnIr.callArgTypesTexts,
        callArgTypesText,
        sizeof(str))
    if !LoweringPrimaryObjectIrCallTargetShapeComplete(fnIr) ||
       !loweringPrimaryObjectIrCallTargetAllocatorMatches(fnIr):
        panic("lowering primary object call target: append shape drift")

fn loweringPrimaryObjectIrCallTargetReleaseColumns(
        fnIr: var PrimaryObjectIrFunction): int64 =
    if !LoweringPrimaryObjectIrCallTargetShapeComplete(fnIr) ||
       !loweringPrimaryObjectIrCallTargetAllocatorMatches(fnIr):
        panic("lowering primary object call target: allocator/retained drift")
    var releasedBytes: int64
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        fnIr.callTargetAllocatorLedger,
        fnIr.callArgCounts,
        sizeof(int32))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        fnIr.callTargetAllocatorLedger,
        fnIr.callTargets,
        sizeof(str))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        fnIr.callTargetAllocatorLedger,
        fnIr.callTargetSourcePaths,
        sizeof(str))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        fnIr.callTargetAllocatorLedger,
        fnIr.callTargetSignatureLineNumbers,
        sizeof(int32))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        fnIr.callTargetAllocatorLedger,
        fnIr.callTargetImportcFlags,
        sizeof(bool))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        fnIr.callTargetAllocatorLedger,
        fnIr.callTargetTypedFunctionIndexes,
        sizeof(int32))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        fnIr.callTargetAllocatorLedger,
        fnIr.callImportcSymbols,
        sizeof(str))
    releasedBytes = releasedBytes + loweringSequenceAllocatorRelease(
        fnIr.callTargetAllocatorLedger,
        fnIr.callArgTypesTexts,
        sizeof(str))
    if !LoweringPrimaryObjectIrCallTargetShapeComplete(fnIr) ||
       !loweringPrimaryObjectIrCallTargetAllocatorMatches(fnIr):
        panic("lowering primary object call target: release shape drift")
    return releasedBytes

fn LoweringPrimaryObjectIrCallTargetClear(
        fnIr: var PrimaryObjectIrFunction) =
    let _ = loweringPrimaryObjectIrCallTargetReleaseColumns(fnIr)

fn loweringPrimaryObjectIrCallTargetAppendSharedRowAt(
        out: var PrimaryObjectIrFunction,
        source: var PrimaryObjectIrFunction,
        row: int32) =
    LoweringPrimaryObjectIrCallTargetAppendExactRow(
        out,
        source.callArgCounts[row],
        share(source.callTargets[row]),
        share(source.callTargetSourcePaths[row]),
        source.callTargetSignatureLineNumbers[row],
        source.callTargetImportcFlags[row],
        source.callTargetTypedFunctionIndexes[row],
        share(source.callImportcSymbols[row]),
        share(source.callArgTypesTexts[row]))

fn loweringPrimaryObjectIrCallTargetCommitRebuild(
        fnIr: var PrimaryObjectIrFunction,
        candidate: var PrimaryObjectIrFunction) =
    if !LoweringPrimaryObjectIrCallTargetShapeComplete(candidate) ||
       !loweringPrimaryObjectIrCallTargetAllocatorMatches(candidate):
        panic("lowering primary object call target: rebuild candidate drift")
    let oldPeakLiveBytes =
        fnIr.callTargetAllocatorLedger.peakLiveCapacityBytes
    let overlapPeakBytes =
        fnIr.callTargetAllocatorLedger.liveCapacityBytes +
            candidate.callTargetAllocatorLedger.peakLiveCapacityBytes
    let _ = loweringPrimaryObjectIrCallTargetReleaseColumns(fnIr)
    candidate.callTargetAllocatorLedger.allocationEventCount =
        candidate.callTargetAllocatorLedger.allocationEventCount +
            fnIr.callTargetAllocatorLedger.allocationEventCount
    candidate.callTargetAllocatorLedger.releaseEventCount =
        candidate.callTargetAllocatorLedger.releaseEventCount +
            fnIr.callTargetAllocatorLedger.releaseEventCount
    candidate.callTargetAllocatorLedger.allocatedCapacityBytes =
        candidate.callTargetAllocatorLedger.allocatedCapacityBytes +
            fnIr.callTargetAllocatorLedger.allocatedCapacityBytes
    candidate.callTargetAllocatorLedger.releasedCapacityBytes =
        candidate.callTargetAllocatorLedger.releasedCapacityBytes +
            fnIr.callTargetAllocatorLedger.releasedCapacityBytes
    if oldPeakLiveBytes >
           candidate.callTargetAllocatorLedger.peakLiveCapacityBytes:
        candidate.callTargetAllocatorLedger.peakLiveCapacityBytes =
            oldPeakLiveBytes
    if overlapPeakBytes >
           candidate.callTargetAllocatorLedger.peakLiveCapacityBytes:
        candidate.callTargetAllocatorLedger.peakLiveCapacityBytes =
            overlapPeakBytes
    fnIr.callArgCounts = candidate.callArgCounts
    fnIr.callTargets = candidate.callTargets
    fnIr.callTargetSourcePaths = candidate.callTargetSourcePaths
    fnIr.callTargetSignatureLineNumbers =
        candidate.callTargetSignatureLineNumbers
    fnIr.callTargetImportcFlags = candidate.callTargetImportcFlags
    fnIr.callTargetTypedFunctionIndexes =
        candidate.callTargetTypedFunctionIndexes
    fnIr.callImportcSymbols = candidate.callImportcSymbols
    fnIr.callArgTypesTexts = candidate.callArgTypesTexts
    fnIr.callTargetAllocatorLedger = candidate.callTargetAllocatorLedger
    if !LoweringPrimaryObjectIrCallTargetShapeComplete(fnIr) ||
       !loweringPrimaryObjectIrCallTargetAllocatorMatches(fnIr):
        panic("lowering primary object call target: rebuild commit drift")

fn LoweringPrimaryObjectIrCallTargetCopyRowsExact(
        dst: var PrimaryObjectIrFunction,
        src: PrimaryObjectIrFunction) =
    if !LoweringPrimaryObjectIrCallTargetShapeComplete(src):
        panic("lowering primary object call target: copy source shape invalid")
    var candidate: PrimaryObjectIrFunction
    for row in 0..<src.callTargets.len:
        LoweringPrimaryObjectIrCallTargetAppendExactRow(
            candidate,
            src.callArgCounts[row],
            strings.CloneStr(src.callTargets[row]),
            strings.CloneStr(src.callTargetSourcePaths[row]),
            src.callTargetSignatureLineNumbers[row],
            src.callTargetImportcFlags[row],
            src.callTargetTypedFunctionIndexes[row],
            strings.CloneStr(src.callImportcSymbols[row]),
            strings.CloneStr(src.callArgTypesTexts[row]))
    loweringPrimaryObjectIrCallTargetCommitRebuild(dst, candidate)

fn LoweringPrimaryObjectIrCallTargetReleaseWithAllocatorReceipt(
        fnIr: var PrimaryObjectIrFunction,
        receipt: var LoweringSequenceAllocatorReceipt) =
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringPrimaryObjectIrCallTargetAllocatorPhysicalBufferCount(fnIr)
    receipt.terminalRetainedBytes =
        LoweringPrimaryObjectIrCallTargetAllocatorCapacityBytes(fnIr)
    let terminalReleasedBytes =
        loweringPrimaryObjectIrCallTargetReleaseColumns(fnIr)
    fnIr.callTargetAllocatorLedger.closed = true
    receipt.allocationEventCount =
        fnIr.callTargetAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        fnIr.callTargetAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        fnIr.callTargetAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        fnIr.callTargetAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        fnIr.callTargetAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        fnIr.callTargetAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringPrimaryObjectIrCallTargetAllocatorPhysicalBufferCount(fnIr) ==
            0 &&
        LoweringPrimaryObjectIrCallTargetAllocatorCapacityBytes(fnIr) ==
            int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering primary object call target: allocator receipt incomplete")
    fnIr.callTargetAllocatorLedger = LoweringSequenceAllocatorLedger()

fn LoweringPrimaryObjectIrFunctionReleaseDeferScopeTransport(
        fnIr: var PrimaryObjectIrFunction) =
    LoweringDeferScopeTransportRelease(fnIr.deferScopeTransport)

fn LoweringPrimaryObjectIrFunctionReleaseOwnershipTransport(
        fnIr: var PrimaryObjectIrFunction) =
    LoweringOwnershipTransportRelease(fnIr.ownershipTransport)

fn LoweringPrimaryObjectIrReleaseDeferScopeTransports(
        primaryIr: var PrimaryObjectIr) =
    for functionIndex in 0..<primaryIr.functions.len:
        LoweringPrimaryObjectIrFunctionReleaseDeferScopeTransport(
            primaryIr.functions[functionIndex])

fn LoweringPrimaryObjectIrReleaseOwnershipTransports(
        primaryIr: var PrimaryObjectIr) =
    for functionIndex in 0..<primaryIr.functions.len:
        LoweringPrimaryObjectIrFunctionReleaseOwnershipTransport(
            primaryIr.functions[functionIndex])

fn LoweringPrimaryObjectIrFunctionArrayReleaseDeferScopeTransports(
        functions: var PrimaryObjectIrFunction[]) =
    for functionIndex in 0..<functions.len:
        LoweringPrimaryObjectIrFunctionReleaseDeferScopeTransport(
            functions[functionIndex])

fn LoweringPrimaryObjectIrFunctionArrayReleaseOwnershipTransports(
        functions: var PrimaryObjectIrFunction[]) =
    for functionIndex in 0..<functions.len:
        LoweringPrimaryObjectIrFunctionReleaseOwnershipTransport(
            functions[functionIndex])

fn LoweringPlanReleaseDeferScopeTransportAllocators(
        plan: var LoweringPlanStub) =
    if plan.deferScopeTransportAllocatorReceiptReady:
        if LoweringPlanDeferScopeTransportPhysicalBufferCount(plan) != 0 ||
           LoweringPlanDeferScopeTransportCapacityBytes(plan) != int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.deferScopeTransportAllocatorReceipt):
            panic("lowering plan: defer scope allocator repeat drift")
        return
    var total: LoweringSequenceAllocatorReceipt
    total.storageReleased = true
    for functionIndex in 0..<plan.primaryObjectIr.functions.len:
        var receipt: LoweringSequenceAllocatorReceipt
        LoweringDeferScopeTransportReleaseWithAllocatorReceipt(
            plan.primaryObjectIr.functions[functionIndex].deferScopeTransport,
            receipt)
        LoweringSequenceAllocatorReceiptAccumulate(
            total, receipt)
    for functionIndex in 0..<plan.primaryObjectIrFunctions.len:
        var receipt: LoweringSequenceAllocatorReceipt
        LoweringDeferScopeTransportReleaseWithAllocatorReceipt(
            plan.primaryObjectIrFunctions[functionIndex].deferScopeTransport,
            receipt)
        LoweringSequenceAllocatorReceiptAccumulate(
            total, receipt)
    if !LoweringSequenceAllocatorReceiptClosed(total) ||
       LoweringPlanDeferScopeTransportPhysicalBufferCount(plan) != 0 ||
       LoweringPlanDeferScopeTransportCapacityBytes(plan) != int64(0):
        panic("lowering plan: defer scope allocator terminal mismatch")
    plan.deferScopeTransportAllocatorReceipt = total
    plan.deferScopeTransportAllocatorReceiptReady = true

fn LoweringPlanReleaseOwnershipTransportAllocators(
        plan: var LoweringPlanStub) =
    if plan.ownershipTransportAllocatorReceiptReady:
        if LoweringPlanOwnershipTransportPhysicalBufferCount(plan) != 0 ||
           LoweringPlanOwnershipTransportCapacityBytes(plan) != int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.ownershipTransportAllocatorReceipt):
            panic("lowering plan: ownership allocator repeat drift")
        return
    var total: LoweringSequenceAllocatorReceipt
    total.storageReleased = true
    for functionIndex in 0..<plan.primaryObjectIr.functions.len:
        var receipt: LoweringSequenceAllocatorReceipt
        LoweringOwnershipTransportReleaseWithAllocatorReceipt(
            plan.primaryObjectIr.functions[functionIndex].ownershipTransport,
            receipt)
        LoweringSequenceAllocatorReceiptAccumulate(
            total, receipt)
    for functionIndex in 0..<plan.primaryObjectIrFunctions.len:
        var receipt: LoweringSequenceAllocatorReceipt
        LoweringOwnershipTransportReleaseWithAllocatorReceipt(
            plan.primaryObjectIrFunctions[functionIndex].ownershipTransport,
            receipt)
        LoweringSequenceAllocatorReceiptAccumulate(
            total, receipt)
    if !LoweringSequenceAllocatorReceiptClosed(total) ||
       LoweringPlanOwnershipTransportPhysicalBufferCount(plan) != 0 ||
       LoweringPlanOwnershipTransportCapacityBytes(plan) != int64(0):
        panic("lowering plan: ownership allocator terminal mismatch")
    plan.ownershipTransportAllocatorReceipt = total
    plan.ownershipTransportAllocatorReceiptReady = true

fn LoweringPrimaryObjectIrFunctionArrayCallTargetPhysicalBufferCount(
        functions: var PrimaryObjectIrFunction[]): int32 =
    var count: int32
    for functionIndex in 0..<functions.len:
        count = count +
            LoweringPrimaryObjectIrCallTargetAllocatorPhysicalBufferCount(
                functions[functionIndex])
    return count

fn LoweringPrimaryObjectIrFunctionArrayCallTargetCapacityBytes(
        functions: var PrimaryObjectIrFunction[]): int64 =
    var bytes: int64
    for functionIndex in 0..<functions.len:
        bytes = bytes +
            LoweringPrimaryObjectIrCallTargetAllocatorCapacityBytes(
                functions[functionIndex])
    return bytes

fn LoweringPlanPrimaryObjectIrCallTargetAllocatorPhysicalBufferCount(
        plan: var LoweringPlanStub): int32 =
    return LoweringPrimaryObjectIrFunctionArrayCallTargetPhysicalBufferCount(
               plan.primaryObjectIr.functions) +
           LoweringPrimaryObjectIrFunctionArrayCallTargetPhysicalBufferCount(
               plan.primaryObjectIrFunctions)

fn LoweringPlanPrimaryObjectIrCallTargetAllocatorCapacityBytes(
        plan: var LoweringPlanStub): int64 =
    return LoweringPrimaryObjectIrFunctionArrayCallTargetCapacityBytes(
               plan.primaryObjectIr.functions) +
           LoweringPrimaryObjectIrFunctionArrayCallTargetCapacityBytes(
               plan.primaryObjectIrFunctions)

fn LoweringPlanReleasePrimaryObjectIrCallTargetAllocators(
        plan: var LoweringPlanStub) =
    if plan.primaryObjectIr.callTargetAllocatorReceiptReady:
        if LoweringPlanPrimaryObjectIrCallTargetAllocatorPhysicalBufferCount(
               plan) != 0 ||
           LoweringPlanPrimaryObjectIrCallTargetAllocatorCapacityBytes(plan) !=
               int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.primaryObjectIr.callTargetAllocatorReceipt):
            panic("lowering plan: primary object call target allocator repeat drift")
        return
    var total: LoweringSequenceAllocatorReceipt
    total.storageReleased = true
    for functionIndex in 0..<plan.primaryObjectIr.functions.len:
        var receipt: LoweringSequenceAllocatorReceipt
        LoweringPrimaryObjectIrCallTargetReleaseWithAllocatorReceipt(
            plan.primaryObjectIr.functions[functionIndex],
            receipt)
        LoweringSequenceAllocatorReceiptAccumulate(total, receipt)
    for functionIndex in 0..<plan.primaryObjectIrFunctions.len:
        var receipt: LoweringSequenceAllocatorReceipt
        LoweringPrimaryObjectIrCallTargetReleaseWithAllocatorReceipt(
            plan.primaryObjectIrFunctions[functionIndex],
            receipt)
        LoweringSequenceAllocatorReceiptAccumulate(total, receipt)
    if !LoweringSequenceAllocatorReceiptClosed(total) ||
       LoweringPlanPrimaryObjectIrCallTargetAllocatorPhysicalBufferCount(
           plan) != 0 ||
       LoweringPlanPrimaryObjectIrCallTargetAllocatorCapacityBytes(plan) !=
           int64(0):
        panic("lowering plan: primary object call target allocator terminal mismatch")
    plan.primaryObjectIr.callTargetAllocatorReceipt = total
    plan.primaryObjectIr.callTargetAllocatorReceiptReady = true

fn LoweringPrimaryObjectIrStatementReleaseStrings(
        statement: var PrimaryObjectIrStatement) =
    statement.sourcePath = ""
    statement.functionName = ""
    statement.surfaceText = ""
    statement.bindingName = ""
    statement.resultType = ""
    statement.conditionLhsText = ""
    statement.conditionRhsText = ""
    statement.conditionLiteralText = ""
    statement.assignRootName = ""
    statement.assignRootType = ""
    statement.assignRootSourcePath = ""
    statement.assignFieldName = ""
    statement.assignFieldType = ""
    statement.assignValueRootName = ""
    statement.assignValueRootType = ""
    statement.assignValueFieldName = ""
    statement.assignValueFieldType = ""
    statement.assignValueLhsText = ""
    statement.assignValueRhsText = ""
    statement.callCallee = ""
    statement.callTarget = ""
    statement.callTargetSourcePath = ""
    statement.callArgsText = ""
    statement.callArgTypesText = ""

@borrows
fn LoweringPrimaryObjectIrFunctionShapeAllocatorPhysicalBufferCount(
        fnIr: PrimaryObjectIrFunction): int32 =
    var count: int32
    if fnIr.statements.cap > 0:
        count = count + 1
    if fnIr.paramNames.cap > 0:
        count = count + 1
    if fnIr.paramTypes.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringPrimaryObjectIrFunctionShapeAllocatorCapacityBytes(
        fnIr: PrimaryObjectIrFunction): int64 =
    return int64(fnIr.statements.cap) *
               int64(sizeof(PrimaryObjectIrStatement)) +
           int64(fnIr.paramNames.cap) * int64(sizeof(str)) +
           int64(fnIr.paramTypes.cap) * int64(sizeof(str))

@borrows
fn loweringPrimaryObjectIrFunctionShapeAllocatorMatches(
        fnIr: PrimaryObjectIrFunction): bool =
    return fnIr.functionShapeAllocatorLedger.liveAllocationCount ==
               int64(
                   LoweringPrimaryObjectIrFunctionShapeAllocatorPhysicalBufferCount(
                       fnIr)) &&
           fnIr.functionShapeAllocatorLedger.liveCapacityBytes ==
               LoweringPrimaryObjectIrFunctionShapeAllocatorCapacityBytes(fnIr)

fn loweringPrimaryObjectIrFunctionShapeRecordTerminalRelease(
        fnIr: var PrimaryObjectIrFunction,
        retainedCapacity: int32,
        elementBytes: int32): int64 =
    if fnIr.functionShapeAllocatorLedger.closed ||
       retainedCapacity < 0 ||
       elementBytes <= 0:
        panic("lowering primary object function shape: invalid terminal release")
    if retainedCapacity == 0:
        return int64(0)
    let releasedBytes =
        int64(retainedCapacity) * int64(elementBytes)
    if fnIr.functionShapeAllocatorLedger.liveAllocationCount <= int64(0) ||
       fnIr.functionShapeAllocatorLedger.liveCapacityBytes < releasedBytes:
        panic("lowering primary object function shape: terminal release underflow")
    fnIr.functionShapeAllocatorLedger.releaseEventCount =
        fnIr.functionShapeAllocatorLedger.releaseEventCount + int64(1)
    fnIr.functionShapeAllocatorLedger.releasedCapacityBytes =
        fnIr.functionShapeAllocatorLedger.releasedCapacityBytes +
        releasedBytes
    fnIr.functionShapeAllocatorLedger.liveAllocationCount =
        fnIr.functionShapeAllocatorLedger.liveAllocationCount - int64(1)
    fnIr.functionShapeAllocatorLedger.liveCapacityBytes =
        fnIr.functionShapeAllocatorLedger.liveCapacityBytes - releasedBytes
    return releasedBytes

fn loweringPrimaryObjectIrFunctionShapeReleaseStatements(
        fnIr: var PrimaryObjectIrFunction): int64 =
    let retainedCapacity = fnIr.statements.cap
    for statementIndex in 0..<fnIr.statements.len:
        LoweringPrimaryObjectIrStatementReleaseStrings(
            fnIr.statements[statementIndex])
    let releasedBytes =
        loweringPrimaryObjectIrFunctionShapeRecordTerminalRelease(
            fnIr,
            retainedCapacity,
            sizeof(PrimaryObjectIrStatement))
    seqs.freeSeq(fnIr.statements)
    if fnIr.statements.len != 0 ||
       fnIr.statements.cap != 0 ||
       fnIr.statements.buffer != nil:
        panic("lowering primary object function shape: statement release failed")
    return releasedBytes

# object_all_lazy skeleton keeps paramNames/paramTypes (in the lifecycle Begin
# snapshot) and leaves statements/callTargets/defer/ownership empty. backend2
# LoweringBuildOneFunctionInto grows those empty columns after Begin; if they
# stay live, after-primary Record overflows (released > initial). Release only
# the post-Begin columns. Writeback is the two-component `ir.functions[index]`
# store (C5 nested-write rule).
fn LoweringPrimaryObjectIrReleaseLazyConsumedFunctionPayload(
        ir: var PrimaryObjectIr,
        index: int32) =
    if index < 0 || index >= ir.functions.len:
        return
    var fnIr = ir.functions[index]
    let _ = loweringPrimaryObjectIrFunctionShapeReleaseStatements(fnIr)
    LoweringPrimaryObjectIrCallTargetClear(fnIr)
    LoweringPrimaryObjectIrFunctionReleaseDeferScopeTransport(fnIr)
    LoweringPrimaryObjectIrFunctionReleaseOwnershipTransport(fnIr)

fn loweringPrimaryObjectIrFunctionShapeReleaseParamNames(
        fnIr: var PrimaryObjectIrFunction): int64 =
    let retainedCapacity = fnIr.paramNames.cap
    let releasedBytes =
        loweringPrimaryObjectIrFunctionShapeRecordTerminalRelease(
            fnIr, retainedCapacity, sizeof(str))
    seqs.freeSeqStrRelease(fnIr.paramNames)
    if fnIr.paramNames.len != 0 ||
       fnIr.paramNames.cap != 0 ||
       fnIr.paramNames.buffer != nil:
        panic("lowering primary object function shape: param name release failed")
    return releasedBytes

fn loweringPrimaryObjectIrFunctionShapeReleaseParamTypes(
        fnIr: var PrimaryObjectIrFunction): int64 =
    let retainedCapacity = fnIr.paramTypes.cap
    let releasedBytes =
        loweringPrimaryObjectIrFunctionShapeRecordTerminalRelease(
            fnIr, retainedCapacity, sizeof(str))
    seqs.freeSeqStrRelease(fnIr.paramTypes)
    if fnIr.paramTypes.len != 0 ||
       fnIr.paramTypes.cap != 0 ||
       fnIr.paramTypes.buffer != nil:
        panic("lowering primary object function shape: param type release failed")
    return releasedBytes

fn LoweringPrimaryObjectIrFunctionShapeReleaseWithAllocatorReceipt(
        fnIr: var PrimaryObjectIrFunction,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if !loweringPrimaryObjectIrFunctionShapeAllocatorMatches(fnIr):
        panic("lowering primary object function shape: allocator/owner drift")
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringPrimaryObjectIrFunctionShapeAllocatorPhysicalBufferCount(fnIr)
    receipt.terminalRetainedBytes =
        LoweringPrimaryObjectIrFunctionShapeAllocatorCapacityBytes(fnIr)
    var terminalReleasedBytes: int64
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringPrimaryObjectIrFunctionShapeReleaseStatements(fnIr)
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringPrimaryObjectIrFunctionShapeReleaseParamNames(fnIr)
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringPrimaryObjectIrFunctionShapeReleaseParamTypes(fnIr)
    fnIr.functionShapeAllocatorLedger.closed = true
    receipt.allocationEventCount =
        fnIr.functionShapeAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        fnIr.functionShapeAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        fnIr.functionShapeAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        fnIr.functionShapeAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        fnIr.functionShapeAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        fnIr.functionShapeAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringPrimaryObjectIrFunctionShapeAllocatorPhysicalBufferCount(
            fnIr) == 0 &&
        LoweringPrimaryObjectIrFunctionShapeAllocatorCapacityBytes(fnIr) ==
            int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering primary object function shape: receipt incomplete")
    fnIr.functionShapeAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringPrimaryObjectIrFunctionReleasePayload(
        fnIr: var PrimaryObjectIrFunction) =
    fnIr.sourcePath = ""
    fnIr.functionName = ""
    fnIr.bodyKind = ""
    var functionShapeReceipt: LoweringSequenceAllocatorReceipt
    LoweringPrimaryObjectIrFunctionShapeReleaseWithAllocatorReceipt(
        fnIr, functionShapeReceipt)
    var callTargetReceipt: LoweringSequenceAllocatorReceipt
    LoweringPrimaryObjectIrCallTargetReleaseWithAllocatorReceipt(
        fnIr, callTargetReceipt)
    LoweringDeferScopeTransportRelease(fnIr.deferScopeTransport)
    LoweringOwnershipTransportRelease(fnIr.ownershipTransport)
    let retainedBodyIr = bodylifecycle.BodyIrPayloadRetained(fnIr.bodyIR)
    let releasedBodyIr = bodylifecycle.BodyIrPayloadRelease(fnIr.bodyIR)
    if releasedBodyIr.releasedBufferCount !=
           retainedBodyIr.physicalBufferCount ||
       releasedBodyIr.releasedBytes != retainedBodyIr.retainedBytes ||
       releasedBodyIr.releasedManagedStringValueCount !=
           retainedBodyIr.managedStringValueCount ||
       releasedBodyIr.releasedManagedStringBytes !=
           retainedBodyIr.managedStringBytes ||
       !releasedBodyIr.storageReleased ||
       bodylifecycle.BodyIrPayloadHasPhysicalStorage(fnIr.bodyIR):
        panic("lowering primary object IR BodyIR payload release mismatch")
    fnIr = PrimaryObjectIrFunction()

fn LoweringPrimaryObjectIrFunctionArrayReleasePayload(
        functions: var PrimaryObjectIrFunction[]) =
    for functionIndex in 0..<functions.len:
        LoweringPrimaryObjectIrFunctionReleasePayload(
            functions[functionIndex])
    seqs.freeSeq(functions)

fn LoweringPrimaryObjectIrFunctionArrayShapeAllocatorPhysicalBufferCount(
        functions: var PrimaryObjectIrFunction[]): int32 =
    var count: int32
    for functionIndex in 0..<functions.len:
        count = count +
            LoweringPrimaryObjectIrFunctionShapeAllocatorPhysicalBufferCount(
                functions[functionIndex])
    return count

fn LoweringPrimaryObjectIrFunctionArrayShapeAllocatorCapacityBytes(
        functions: var PrimaryObjectIrFunction[]): int64 =
    var bytes: int64
    for functionIndex in 0..<functions.len:
        bytes = bytes +
            LoweringPrimaryObjectIrFunctionShapeAllocatorCapacityBytes(
                functions[functionIndex])
    return bytes

fn LoweringPlanPrimaryObjectIrFunctionShapeAllocatorPhysicalBufferCount(
        plan: var LoweringPlanStub): int32 =
    return LoweringPrimaryObjectIrFunctionArrayShapeAllocatorPhysicalBufferCount(
               plan.primaryObjectIr.functions) +
           LoweringPrimaryObjectIrFunctionArrayShapeAllocatorPhysicalBufferCount(
               plan.primaryObjectIrFunctions)

fn LoweringPlanPrimaryObjectIrFunctionShapeAllocatorCapacityBytes(
        plan: var LoweringPlanStub): int64 =
    return LoweringPrimaryObjectIrFunctionArrayShapeAllocatorCapacityBytes(
               plan.primaryObjectIr.functions) +
           LoweringPrimaryObjectIrFunctionArrayShapeAllocatorCapacityBytes(
               plan.primaryObjectIrFunctions)

fn LoweringPlanReleasePrimaryObjectIrFunctionShapeAllocators(
        plan: var LoweringPlanStub) =
    if plan.primaryObjectIr.functionShapeAllocatorReceiptReady:
        if LoweringPlanPrimaryObjectIrFunctionShapeAllocatorPhysicalBufferCount(
               plan) != 0 ||
           LoweringPlanPrimaryObjectIrFunctionShapeAllocatorCapacityBytes(
               plan) != int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.primaryObjectIr.functionShapeAllocatorReceipt):
            panic("lowering plan: primary object function shape repeat drift")
        return
    var total: LoweringSequenceAllocatorReceipt
    total.storageReleased = true
    for functionIndex in 0..<plan.primaryObjectIr.functions.len:
        var receipt: LoweringSequenceAllocatorReceipt
        LoweringPrimaryObjectIrFunctionShapeReleaseWithAllocatorReceipt(
            plan.primaryObjectIr.functions[functionIndex],
            receipt)
        LoweringSequenceAllocatorReceiptAccumulate(total, receipt)
    for functionIndex in 0..<plan.primaryObjectIrFunctions.len:
        var receipt: LoweringSequenceAllocatorReceipt
        LoweringPrimaryObjectIrFunctionShapeReleaseWithAllocatorReceipt(
            plan.primaryObjectIrFunctions[functionIndex],
            receipt)
        LoweringSequenceAllocatorReceiptAccumulate(total, receipt)
    if !LoweringSequenceAllocatorReceiptClosed(total) ||
       LoweringPlanPrimaryObjectIrFunctionShapeAllocatorPhysicalBufferCount(
           plan) != 0 ||
       LoweringPlanPrimaryObjectIrFunctionShapeAllocatorCapacityBytes(plan) !=
           int64(0):
        panic("lowering plan: primary object function shape terminal mismatch")
    plan.primaryObjectIr.functionShapeAllocatorReceipt = total
    plan.primaryObjectIr.functionShapeAllocatorReceiptReady = true

fn LoweringPrimaryObjectIrReleasePayload(primaryIr: var PrimaryObjectIr) =
    LoweringPrimaryObjectIrFunctionArrayReleasePayload(
        primaryIr.functions)
    let functionShapeAllocatorReceipt =
        primaryIr.functionShapeAllocatorReceipt
    let functionShapeAllocatorReceiptReady =
        primaryIr.functionShapeAllocatorReceiptReady
    let callTargetAllocatorReceipt =
        primaryIr.callTargetAllocatorReceipt
    let callTargetAllocatorReceiptReady =
        primaryIr.callTargetAllocatorReceiptReady
    primaryIr = PrimaryObjectIr()
    primaryIr.functionShapeAllocatorReceipt =
        functionShapeAllocatorReceipt
    primaryIr.functionShapeAllocatorReceiptReady =
        functionShapeAllocatorReceiptReady
    primaryIr.callTargetAllocatorReceipt =
        callTargetAllocatorReceipt
    primaryIr.callTargetAllocatorReceiptReady =
        callTargetAllocatorReceiptReady

fn LoweringPositionAtOrBefore(leftLine: int32,
                              leftColumn: int32,
                              rightLine: int32,
                              rightColumn: int32): bool =
    if leftLine < rightLine:
        return true
    if leftLine > rightLine:
        return false
    return leftColumn <= rightColumn

fn LoweringStructuredSpanValid(startLine: int32,
                                startColumn: int32,
                                endLine: int32,
                                endColumn: int32): bool =
    return startLine > 0 && startColumn > 0 && endLine > 0 && endColumn > 0 &&
           LoweringPositionAtOrBefore(startLine,
                                      startColumn,
                                      endLine,
                                      endColumn)

fn LoweringStructuredSpanContains(outerStartLine: int32,
                                   outerStartColumn: int32,
                                   outerEndLine: int32,
                                   outerEndColumn: int32,
                                   innerStartLine: int32,
                                   innerStartColumn: int32,
                                   innerEndLine: int32,
                                   innerEndColumn: int32): bool =
    return LoweringPositionAtOrBefore(outerStartLine,
                                      outerStartColumn,
                                      innerStartLine,
                                      innerStartColumn) &&
           LoweringPositionAtOrBefore(innerEndLine,
                                      innerEndColumn,
                                      outerEndLine,
                                      outerEndColumn)

fn loweringDeferScopeBuildScratchRecordSetLen(
        owner: var LoweringDeferScopeBuildScratchOwner,
        beforeCapacity: int32,
        afterCapacity: int32,
        bufferPresent: bool,
        newLength: int32) =
    if owner.allocatorLedger.closed ||
       newLength < 0 ||
       afterCapacity < beforeCapacity ||
       (afterCapacity > 0 && !bufferPresent):
        panic("lowering defer scope scratch: invalid setLen result")
    if afterCapacity > beforeCapacity:
        loweringSequenceAllocatorRecordGrowth(
            owner.allocatorLedger,
            beforeCapacity,
            afterCapacity,
            sizeof(int32))

fn loweringSequenceAllocatorSetLen(
        owner: var LoweringDeferScopeBuildScratchOwner,
        domain: LoweringDeferScopeBuildScopeChildCountLength) =
    let beforeCapacity = owner.scopeChildCounts.cap
    setLen(owner.scopeChildCounts, domain.length)
    loweringDeferScopeBuildScratchRecordSetLen(
        owner,
        beforeCapacity,
        owner.scopeChildCounts.cap,
        owner.scopeChildCounts.buffer != nil,
        domain.length)

fn loweringSequenceAllocatorSetLen(
        owner: var LoweringDeferScopeBuildScratchOwner,
        domain: LoweringDeferScopeBuildStatementOrdinalLength) =
    let beforeCapacity = owner.statementRowByOrdinal.cap
    setLen(owner.statementRowByOrdinal, domain.length)
    loweringDeferScopeBuildScratchRecordSetLen(
        owner,
        beforeCapacity,
        owner.statementRowByOrdinal.cap,
        owner.statementRowByOrdinal.buffer != nil,
        domain.length)

fn loweringSequenceAllocatorSetLen(
        owner: var LoweringDeferScopeBuildScratchOwner,
        domain: LoweringDeferScopeBuildLexicalStatementLength) =
    let beforeCapacity = owner.lexicalStatementCounts.cap
    setLen(owner.lexicalStatementCounts, domain.length)
    loweringDeferScopeBuildScratchRecordSetLen(
        owner,
        beforeCapacity,
        owner.lexicalStatementCounts.cap,
        owner.lexicalStatementCounts.buffer != nil,
        domain.length)

fn loweringSequenceAllocatorSetLen(
        owner: var LoweringDeferScopeBuildScratchOwner,
        domain: LoweringDeferScopeBuildScopeOwnerLength) =
    let beforeCapacity = owner.scopeDeferOwners.cap
    setLen(owner.scopeDeferOwners, domain.length)
    loweringDeferScopeBuildScratchRecordSetLen(
        owner,
        beforeCapacity,
        owner.scopeDeferOwners.cap,
        owner.scopeDeferOwners.buffer != nil,
        domain.length)

@borrows
fn LoweringDeferScopeBuildScratchPhysicalBufferCount(
        owner: LoweringDeferScopeBuildScratchOwner): int32 =
    var count: int32
    if owner.scopeChildCounts.cap > 0:
        count = count + 1
    if owner.statementRowByOrdinal.cap > 0:
        count = count + 1
    if owner.lexicalStatementCounts.cap > 0:
        count = count + 1
    if owner.scopeDeferOwners.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringDeferScopeBuildScratchCapacityBytes(
        owner: LoweringDeferScopeBuildScratchOwner): int64 =
    return (
        int64(owner.scopeChildCounts.cap) +
        int64(owner.statementRowByOrdinal.cap) +
        int64(owner.lexicalStatementCounts.cap) +
        int64(owner.scopeDeferOwners.cap)) *
        int64(sizeof(int32))

fn loweringDeferScopeBuildScratchRecordTerminalRelease(
        owner: var LoweringDeferScopeBuildScratchOwner,
        retainedCapacity: int32): int64 =
    if owner.allocatorLedger.closed ||
       retainedCapacity < 0:
        panic("lowering defer scope scratch: invalid terminal release")
    if retainedCapacity == 0:
        return int64(0)
    let releasedBytes =
        int64(retainedCapacity) * int64(sizeof(int32))
    if owner.allocatorLedger.liveAllocationCount <= int64(0) ||
       owner.allocatorLedger.liveCapacityBytes < releasedBytes:
        panic("lowering defer scope scratch: terminal release underflow")
    owner.allocatorLedger.releaseEventCount =
        owner.allocatorLedger.releaseEventCount + int64(1)
    owner.allocatorLedger.releasedCapacityBytes =
        owner.allocatorLedger.releasedCapacityBytes + releasedBytes
    owner.allocatorLedger.liveAllocationCount =
        owner.allocatorLedger.liveAllocationCount - int64(1)
    owner.allocatorLedger.liveCapacityBytes =
        owner.allocatorLedger.liveCapacityBytes - releasedBytes
    return releasedBytes

fn loweringDeferScopeBuildScratchReleaseScopeChildren(
        owner: var LoweringDeferScopeBuildScratchOwner): int64 =
    let retainedCapacity = owner.scopeChildCounts.cap
    let releasedBytes =
        loweringDeferScopeBuildScratchRecordTerminalRelease(
            owner, retainedCapacity)
    seqs.freeSeq(owner.scopeChildCounts)
    if owner.scopeChildCounts.len != 0 ||
       owner.scopeChildCounts.cap != 0 ||
       owner.scopeChildCounts.buffer != nil:
        panic("lowering defer scope scratch: child release failed")
    return releasedBytes

fn loweringDeferScopeBuildScratchReleaseStatementOrdinals(
        owner: var LoweringDeferScopeBuildScratchOwner): int64 =
    let retainedCapacity = owner.statementRowByOrdinal.cap
    let releasedBytes =
        loweringDeferScopeBuildScratchRecordTerminalRelease(
            owner, retainedCapacity)
    seqs.freeSeq(owner.statementRowByOrdinal)
    if owner.statementRowByOrdinal.len != 0 ||
       owner.statementRowByOrdinal.cap != 0 ||
       owner.statementRowByOrdinal.buffer != nil:
        panic("lowering defer scope scratch: statement release failed")
    return releasedBytes

fn loweringDeferScopeBuildScratchReleaseLexicalStatements(
        owner: var LoweringDeferScopeBuildScratchOwner): int64 =
    let retainedCapacity = owner.lexicalStatementCounts.cap
    let releasedBytes =
        loweringDeferScopeBuildScratchRecordTerminalRelease(
            owner, retainedCapacity)
    seqs.freeSeq(owner.lexicalStatementCounts)
    if owner.lexicalStatementCounts.len != 0 ||
       owner.lexicalStatementCounts.cap != 0 ||
       owner.lexicalStatementCounts.buffer != nil:
        panic("lowering defer scope scratch: lexical release failed")
    return releasedBytes

fn loweringDeferScopeBuildScratchReleaseScopeOwners(
        owner: var LoweringDeferScopeBuildScratchOwner): int64 =
    let retainedCapacity = owner.scopeDeferOwners.cap
    let releasedBytes =
        loweringDeferScopeBuildScratchRecordTerminalRelease(
            owner, retainedCapacity)
    seqs.freeSeq(owner.scopeDeferOwners)
    if owner.scopeDeferOwners.len != 0 ||
       owner.scopeDeferOwners.cap != 0 ||
       owner.scopeDeferOwners.buffer != nil:
        panic("lowering defer scope scratch: owner release failed")
    return releasedBytes

@borrows
fn loweringDeferScopeBuildScratchOwnerToken(
        receipt: LoweringSequenceAllocatorReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(128)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocationEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releaseEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalRetainedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalRetainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalReleasedBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveAllocationCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveCapacityBytes)
    let token = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn LoweringDeferScopeBuildScratchReleaseWithReceipt(
        owner: var LoweringDeferScopeBuildScratchOwner,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()) ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(
               LoweringDeferScopeBuildScratchPhysicalBufferCount(owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringDeferScopeBuildScratchCapacityBytes(owner):
        panic("lowering defer scope scratch: owner state drift")
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringDeferScopeBuildScratchPhysicalBufferCount(owner)
    receipt.terminalRetainedBytes =
        LoweringDeferScopeBuildScratchCapacityBytes(owner)
    var terminalReleasedBytes: int64
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringDeferScopeBuildScratchReleaseScopeChildren(owner)
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringDeferScopeBuildScratchReleaseStatementOrdinals(owner)
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringDeferScopeBuildScratchReleaseLexicalStatements(owner)
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringDeferScopeBuildScratchReleaseScopeOwners(owner)
    owner.allocatorLedger.closed = true
    receipt.allocationEventCount =
        owner.allocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        owner.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        owner.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        owner.allocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        owner.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        owner.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringDeferScopeBuildScratchPhysicalBufferCount(owner) == 0 &&
        LoweringDeferScopeBuildScratchCapacityBytes(owner) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering defer scope scratch: receipt incomplete")
    owner.allocatorReceipt = receipt
    owner.ownerToken =
        loweringDeferScopeBuildScratchOwnerToken(receipt)
    owner.allocatorReceiptReady = true
    owner.allocatorLedger = LoweringSequenceAllocatorLedger()

fn LoweringDeferScopeBuildScratchReceiptConsumeStrict(
        owner: var LoweringDeferScopeBuildScratchOwner,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    if !owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt, owner.allocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !layout.FixedBytes32Equal(
           owner.ownerToken,
           loweringDeferScopeBuildScratchOwnerToken(receipt)) ||
       LoweringDeferScopeBuildScratchPhysicalBufferCount(owner) != 0 ||
       LoweringDeferScopeBuildScratchCapacityBytes(owner) != int64(0):
        return false
    owner.allocatorReceiptConsumed = true
    return true

@borrows
fn LoweringBuildDeferScopeTransport(
        typedIr: texpr.TypedExprIr,
        typedFunctionIndex: int32,
        out: var LoweringDeferScopeTransportSoA) =
    if !texpr.TypedExprIrFunctions2ShapeComplete(typedIr):
        panic("lowering defer scope transport: function columns incomplete")
    if !texpr.TypedExprIrScopes2ShapeComplete(typedIr):
        panic("lowering defer scope transport: scope columns incomplete")
    if !texpr.TypedExprIrStatements2ShapeComplete(typedIr):
        panic("lowering defer scope transport: statement columns incomplete")
    if typedIr.internPool == nil:
        panic("lowering defer scope transport: typed intern pool missing")
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >= typedIr.functions2_functionNameIds.len:
        panic("lowering defer scope transport: function index out of range")

    let statementStart = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.functions2_statementStarts,
        typedFunctionIndex)
    let statementCount = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.functions2_statementCounts,
        typedFunctionIndex)
    let scopeStart = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.functions2_scopeStarts,
        typedFunctionIndex)
    let scopeCount = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.functions2_scopeCounts,
        typedFunctionIndex)
    if statementStart < 0 || statementCount < 0 ||
       statementStart > typedIr.statements2_statementIndexs.len ||
       statementCount > typedIr.statements2_statementIndexs.len - statementStart:
        panic("lowering defer scope transport: function statement slice out of range")
    if scopeStart < 0 || scopeCount <= 0 ||
       scopeStart > typedIr.scopes2_scopeIds.len ||
       scopeCount > typedIr.scopes2_scopeIds.len - scopeStart:
        panic("lowering defer scope transport: function scope slice out of range")

    var built: LoweringDeferScopeTransportSoA
    built.typedFunctionIndex = typedFunctionIndex
    built.sourceStatementStart = statementStart
    built.sourceStatementCount = statementCount
    built.sourceScopeStart = scopeStart
    built.sourceScopeCount = scopeCount

    var scratch: LoweringDeferScopeBuildScratchOwner
    loweringSequenceAllocatorSetLen(
        scratch,
        LoweringDeferScopeBuildScopeChildCountLength(
            length: scopeCount))
    for localScopeIndex in 0..<scopeCount:
        let typedScopeRow = scopeStart + localScopeIndex
        let localScopeId = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.scopes2_scopeIds, typedScopeRow)
        let localParentScopeId = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.scopes2_parentScopeIds, typedScopeRow)
        let scopeKind = typedIr.scopes2_kinds[typedScopeRow]
        let ownerOrdinal = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.scopes2_ownerStatementOrdinals,
            typedScopeRow)
        let lexicalOrdinal = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.scopes2_lexicalOrdinals, typedScopeRow)
        let startLine = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.scopes2_startLineNumbers, typedScopeRow)
        let startColumn = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.scopes2_startColumnNumbers, typedScopeRow)
        let endLine = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.scopes2_endLineNumbers, typedScopeRow)
        let endColumn = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.scopes2_endColumnNumbers, typedScopeRow)
        if localScopeId != localScopeIndex:
            panic("lowering defer scope transport: scope id is not function-local dense")
        if !LoweringStructuredSpanValid(startLine,
                                         startColumn,
                                         endLine,
                                         endColumn):
            panic("lowering defer scope transport: scope span invalid")
        if localScopeIndex == 0:
            if localParentScopeId != -1 ||
               scopeKind != parser.NormalizedScopeRoot ||
               ownerOrdinal != -1 || lexicalOrdinal != 0:
                panic("lowering defer scope transport: root scope contract invalid")
        else:
            if localParentScopeId < 0 ||
               localParentScopeId >= localScopeIndex:
                panic("lowering defer scope transport: scope parent is missing or not prior")
            if scopeKind == parser.NormalizedScopeRoot:
                panic("lowering defer scope transport: duplicate root scope")
            if lexicalOrdinal !=
                   scratch.scopeChildCounts[localParentScopeId]:
                panic("lowering defer scope transport: scope lexical ordinal drift")
            scratch.scopeChildCounts[localParentScopeId] =
                lexicalOrdinal + 1
            if !LoweringStructuredSpanContains(
                    built.scopeStartLineNumbers[localParentScopeId],
                    built.scopeStartColumnNumbers[localParentScopeId],
                    built.scopeEndLineNumbers[localParentScopeId],
                    built.scopeEndColumnNumbers[localParentScopeId],
                    startLine,
                    startColumn,
                    endLine,
                    endColumn):
                panic("lowering defer scope transport: child scope escapes parent span")
        LoweringDeferScopeTransportAppendScopeExactRow(
            built,
            localScopeId,
            localParentScopeId,
            scopeKind,
            ownerOrdinal,
            lexicalOrdinal,
            startLine,
            startColumn,
            endLine,
            endColumn)

    let functionSourcePathId = typedIr.functions2_sourcePathIds[typedFunctionIndex]
    let functionNameId = typedIr.functions2_functionNameIds[typedFunctionIndex]
    loweringSequenceAllocatorSetLen(
        scratch,
        LoweringDeferScopeBuildStatementOrdinalLength(
            length: statementCount))
    loweringSequenceAllocatorSetLen(
        scratch,
        LoweringDeferScopeBuildLexicalStatementLength(
            length: scopeCount))
    for i in 0..<statementCount:
        scratch.statementRowByOrdinal[i] = -1
    var nextStatementOrdinal: int32
    for localStatementIndex in 0..<statementCount:
        let typedStatementRow = statementStart + localStatementIndex
        if typedIr.statements2_sourcePathIds[typedStatementRow] != functionSourcePathId ||
           typedIr.statements2_functionNameIds[typedStatementRow] != functionNameId:
            panic("lowering defer scope transport: statement source/function identity drift")
        let statementIndex = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.statements2_statementIndexs, typedStatementRow)
        if statementIndex != typedStatementRow:
            panic("lowering defer scope transport: statement row identity drift")
        let lineNumber = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.statements2_lineNumbers, typedStatementRow)
        let columnNumber = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.statements2_columnNumbers, typedStatementRow)
        let endLineNumber = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.statements2_endLineNumbers, typedStatementRow)
        let endColumnNumber = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.statements2_endColumnNumbers, typedStatementRow)
        if !LoweringStructuredSpanValid(lineNumber,
                                         columnNumber,
                                         endLineNumber,
                                         endColumnNumber):
            panic("lowering defer scope transport: statement span invalid")
        let localLexicalScopeId = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.statements2_lexicalScopeIds, typedStatementRow)
        if localLexicalScopeId < 0 || localLexicalScopeId >= scopeCount:
            panic("lowering defer scope transport: statement lexical scope out of range")
        if !LoweringStructuredSpanContains(
                built.scopeStartLineNumbers[localLexicalScopeId],
                built.scopeStartColumnNumbers[localLexicalScopeId],
                built.scopeEndLineNumbers[localLexicalScopeId],
                built.scopeEndColumnNumbers[localLexicalScopeId],
                lineNumber,
                columnNumber,
                endLineNumber,
                endColumnNumber):
            panic(Fmt"lowering defer scope transport: statement escapes lexical scope line={lineNumber} col={columnNumber} endLine={endLineNumber} endCol={endColumnNumber} scope={localLexicalScopeId} scopeStart={built.scopeStartLineNumbers[localLexicalScopeId]} scopeStartCol={built.scopeStartColumnNumbers[localLexicalScopeId]} scopeEnd={built.scopeEndLineNumbers[localLexicalScopeId]} scopeEndCol={built.scopeEndColumnNumbers[localLexicalScopeId]}")
        let localSuiteScopeId = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.statements2_suiteScopeIds, typedStatementRow)
        if localSuiteScopeId >= 0:
            if localSuiteScopeId >= scopeCount:
                panic("lowering defer scope transport: statement suite scope out of range")
        elif localSuiteScopeId != -1:
            panic("lowering defer scope transport: invalid negative suite scope")
        let localStatementOrdinal = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.statements2_statementOrdinals, typedStatementRow)
        let lexicalOrdinal = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.statements2_lexicalOrdinals, typedStatementRow)
        if localStatementOrdinal >= 0:
            if localStatementOrdinal >= statementCount ||
               localStatementOrdinal != nextStatementOrdinal ||
               scratch.statementRowByOrdinal[localStatementOrdinal] >= 0:
                panic("lowering defer scope transport: statement ordinal is not function-local dense")
            if lexicalOrdinal < 0 ||
               lexicalOrdinal !=
                   scratch.lexicalStatementCounts[localLexicalScopeId]:
                panic("lowering defer scope transport: statement lexical ordinal drift")
            scratch.statementRowByOrdinal[nextStatementOrdinal] =
                localStatementIndex
            scratch.lexicalStatementCounts[localLexicalScopeId] =
                lexicalOrdinal + 1
            nextStatementOrdinal = nextStatementOrdinal + 1
        else:
            if localStatementOrdinal != -1 || lexicalOrdinal != -1 ||
               localSuiteScopeId >= 0:
                panic("lowering defer scope transport: unstructured statement carries structural identity")
        let deferOwnerOrdinal = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.statements2_deferOwnerStatementOrdinals,
            typedStatementRow)
        if deferOwnerOrdinal < -1:
            panic("lowering defer scope transport: invalid negative defer owner")
        let statementKind = typedIr.statements2_kinds[typedStatementRow]
        if statementKind == texpr.TypedExprIrStmtLocalDecl &&
           deferOwnerOrdinal >= 0 &&
           (localStatementOrdinal < 0 || lexicalOrdinal < 0):
            panic("lowering defer scope transport: defer local declaration lost lexical ordinal")
        LoweringDeferScopeTransportAppendStatementExactRow(
            built,
            statementIndex,
            statementKind,
            lineNumber,
            columnNumber,
            endLineNumber,
            endColumnNumber,
            localLexicalScopeId,
            localSuiteScopeId,
            localStatementOrdinal,
            lexicalOrdinal,
            deferOwnerOrdinal)

    loweringSequenceAllocatorSetLen(
        scratch,
        LoweringDeferScopeBuildScopeOwnerLength(
            length: scopeCount))
    for localScopeIndex in 0..<scopeCount:
        scratch.scopeDeferOwners[localScopeIndex] = -1
        let localOwnerOrdinal = built.scopeOwnerStatementOrdinals[localScopeIndex]
        if localScopeIndex == 0:
            if localOwnerOrdinal != -1:
                panic("lowering defer scope transport: root scope owner drift")
            continue
        let parentScopeId = built.scopeParentIds[localScopeIndex]
        if localOwnerOrdinal == -1:
            # Function bodies and continuation-only lexical scopes are parser
            # scopes, not statement suites. They inherit the active defer from
            # their lexical parent and deliberately have no statement owner.
            if built.scopeKinds[localScopeIndex] ==
               parser.NormalizedScopeDeferSuite:
                panic("lowering defer scope transport: defer suite owner statement missing")
            scratch.scopeDeferOwners[localScopeIndex] =
                scratch.scopeDeferOwners[parentScopeId]
            continue
        if localOwnerOrdinal < -1 ||
           localOwnerOrdinal >= nextStatementOrdinal:
            let functionNameResult = langintern.LookupIntern(
                typedIr.internPool, functionNameId)
            let functionName = IsOk(functionNameResult) ?
                Value(functionNameResult) : "<missing>"
            panic(Fmt"lowering defer scope transport: scope owner statement missing function={functionName} scope={localScopeIndex} kind={built.scopeKinds[localScopeIndex]} owner={localOwnerOrdinal} statement_count={nextStatementOrdinal} start_line={built.scopeStartLineNumbers[localScopeIndex]}")
        let ownerRow =
            scratch.statementRowByOrdinal[localOwnerOrdinal]
        if ownerRow < 0 || built.statementSuiteScopeIds[ownerRow] != localScopeIndex:
            panic("lowering defer scope transport: scope owner back-reference drift")
        if built.statementLexicalScopeIds[ownerRow] != parentScopeId:
            panic("lowering defer scope transport: scope owner lexical parent drift")
        scratch.scopeDeferOwners[localScopeIndex] =
            scratch.scopeDeferOwners[parentScopeId]
        if built.scopeKinds[localScopeIndex] == parser.NormalizedScopeDeferSuite:
            if built.statementKinds[ownerRow] != texpr.TypedExprIrStmtDefer:
                panic("lowering defer scope transport: defer suite owner kind drift")
            scratch.scopeDeferOwners[localScopeIndex] =
                localOwnerOrdinal

    for localStatementIndex in 0..<statementCount:
        let localDeferOwner =
            built.statementDeferOwnerStatementOrdinals[localStatementIndex]
        if localDeferOwner >= 0:
            if localDeferOwner >= nextStatementOrdinal:
                panic("lowering defer scope transport: defer owner statement missing")
            let ownerRow =
                scratch.statementRowByOrdinal[localDeferOwner]
            if ownerRow < 0 ||
               built.statementKinds[ownerRow] != texpr.TypedExprIrStmtDefer:
                panic("lowering defer scope transport: defer owner kind drift")
            if ownerRow >= localStatementIndex:
                panic("lowering defer scope transport: defer owner is not activated before body")
        let lexicalScopeId = built.statementLexicalScopeIds[localStatementIndex]
        if localDeferOwner !=
               scratch.scopeDeferOwners[lexicalScopeId]:
            panic("lowering defer scope transport: defer owner scope drift")
        let suiteScopeId = built.statementSuiteScopeIds[localStatementIndex]
        if suiteScopeId >= 0:
            if built.statementOrdinals[localStatementIndex] < 0 ||
               built.scopeOwnerStatementOrdinals[suiteScopeId] !=
                   built.statementOrdinals[localStatementIndex]:
                panic("lowering defer scope transport: suite owner mapping drift")
        let statementKind = built.statementKinds[localStatementIndex]
        if statementKind == texpr.TypedExprIrStmtDefer:
            if suiteScopeId < 0 ||
               built.scopeKinds[suiteScopeId] != parser.NormalizedScopeDeferSuite:
                panic("lowering defer scope transport: defer statement suite missing")
        if (statementKind == texpr.TypedExprIrStmtReturn ||
            statementKind == texpr.TypedExprIrStmtBreak ||
            statementKind == texpr.TypedExprIrStmtContinue) &&
           suiteScopeId >= 0:
            panic("lowering defer scope transport: control transfer owns suite")

    if !LoweringDeferScopeTransportShapeComplete(built) ||
       built.scopeIds.len != scopeCount ||
       built.statementIndexes.len != statementCount:
        panic("lowering defer scope transport: destination shape incomplete")
    var scratchReceipt: LoweringSequenceAllocatorReceipt
    LoweringDeferScopeBuildScratchReleaseWithReceipt(
        scratch, scratchReceipt)
    if !LoweringDeferScopeBuildScratchReceiptConsumeStrict(
           scratch, scratchReceipt):
        panic("lowering defer scope transport: scratch strict consume failed")
    built.complete = true
    LoweringDeferScopeTransportMoveInto(out, built)

@borrows
fn LoweringAttachDeferScopeTransport(
        fnIr: var PrimaryObjectIrFunction,
        typedIr: texpr.TypedExprIr,
        typedFunctionIndex: int32) =
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >= typedIr.functions2_functionNameIds.len:
        panic("lowering defer scope transport: attach function index out of range")
    let sourcePathResult = langintern.LookupIntern(
        typedIr.internPool,
        typedIr.functions2_sourcePathIds[typedFunctionIndex])
    let functionNameResult = langintern.LookupIntern(
        typedIr.internPool,
        typedIr.functions2_functionNameIds[typedFunctionIndex])
    if !IsOk(sourcePathResult) || !IsOk(functionNameResult):
        panic("lowering defer scope transport: attach function identity missing")
    if !LoweringSourcePathsEquivalent(fnIr.sourcePath, Value(sourcePathResult)) ||
       fnIr.functionName != Value(functionNameResult) ||
       fnIr.typedFunctionIndex != typedFunctionIndex:
        panic("lowering defer scope transport: attach function identity drift")
    LoweringBuildDeferScopeTransport(typedIr,
                                     typedFunctionIndex,
                                     fnIr.deferScopeTransport)

@borrows
fn LoweringBodyIrControlBegin(
        bodyIR: var coreir.BodyIR,
        transport: LoweringDeferScopeTransportSoA,
        typedFunctionIndex: int32) =
    if !transport.complete ||
       !LoweringDeferScopeTransportShapeComplete(transport) ||
       typedFunctionIndex < 0 ||
       transport.typedFunctionIndex != typedFunctionIndex ||
       transport.scopeIds.len <= 0 ||
       transport.scopeIds[0] != 0 ||
       transport.scopeParentIds[0] != -1:
        panic("lowering body ir control: exact transport missing")
    coreir.BodyIRControlFlowBegin(bodyIR, typedFunctionIndex)
    for scopeId in 1..<transport.scopeIds.len:
        if transport.scopeIds[scopeId] != scopeId:
            panic("lowering body ir control: scope row identity drift")
        let appendedScopeId = coreir.BodyIRControlFlowAddScope(
            bodyIR, transport.scopeParentIds[scopeId])
        if appendedScopeId != scopeId:
            panic("lowering body ir control: scope append identity drift")

@borrows
fn LoweringBodyIrControlStatementScope(
        transport: LoweringDeferScopeTransportSoA,
        statementRow: int32): int32 =
    if !transport.complete ||
       !LoweringDeferScopeTransportShapeComplete(transport) ||
       statementRow < transport.sourceStatementStart:
        panic("lowering body ir control: statement row out of transport")
    let localStatementRow =
        statementRow - transport.sourceStatementStart
    if localStatementRow < 0 ||
       localStatementRow >= transport.sourceStatementCount ||
       localStatementRow >= transport.statementIndexes.len ||
       transport.statementIndexes[localStatementRow] != statementRow:
        panic("lowering body ir control: statement row identity drift")
    let scopeId =
        transport.statementLexicalScopeIds[localStatementRow]
    if scopeId < 0 || scopeId >= transport.scopeIds.len:
        panic("lowering body ir control: statement scope invalid")
    return scopeId

fn LoweringBodyIrControlBindNewBlocks(
        bodyIR: var coreir.BodyIR,
        scopeId: int32) =
    if bodyIR.controlFlowSealed ||
       bodyIR.controlFunctionRow < 0 ||
       scopeId < 0 ||
       scopeId >= bodyIR.controlScopeParentIds.len ||
       bodyIR.blockScopeIds.len > bodyIR.blocks.len:
        panic("lowering body ir control: block binding state invalid")
    while bodyIR.blockScopeIds.len < bodyIR.blocks.len:
        coreir.BodyIRControlFlowBindBlockScope(
            bodyIR, bodyIR.blockScopeIds.len, scopeId)

@borrows
fn LoweringBodyIrControlBindTermClass(
        bodyIR: coreir.BodyIR,
        termIndexes: var int32[],
        edgeKind: int32,
        termEdgeKinds: var int32[]) =
    if termEdgeKinds.len != bodyIR.terms.len ||
       (edgeKind != coreir.BodyControlEdgeBreak &&
        edgeKind != coreir.BodyControlEdgeContinue &&
        edgeKind != coreir.BodyControlEdgeLoopBack):
        panic("lowering body ir control: term class state invalid")
    for row in 0..<termIndexes.len:
        let termIndex = termIndexes[row]
        if termIndex < 0 ||
           termIndex >= bodyIR.terms.len ||
           bodyIR.terms[termIndex].kind != coreir.BodyTermBrTag ||
           termEdgeKinds[termIndex] >= 0:
            panic("lowering body ir control: term edge class invalid")
        termEdgeKinds[termIndex] = edgeKind

fn LoweringBodyIrDeferActivationScratchBegin(
        owner: var LoweringBodyIrDeferActivationScratchOwner,
        domain: LoweringBodyIrDeferActivationScratchDomain) =
    if domain.typedFunctionIndex < 0 ||
       domain.statementRow < 0 ||
       domain.deferId < 0 ||
       owner.deferIds.len != 0 ||
       owner.deferIds.cap != 0 ||
       owner.allocatorLedger.allocationEventCount != int64(0) ||
       owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()):
        panic("lowering body ir defer activation scratch: begin state invalid")
    owner.domain = domain

fn loweringSequenceAllocatorAdd(
        owner: var LoweringBodyIrDeferActivationScratchOwner,
        value: LoweringBodyIrDeferActivationScratchValue) =
    if owner.deferIds.len != 0 ||
       value.value != owner.domain.deferId:
        panic("lowering body ir defer activation scratch: domain mismatch")
    loweringSequenceAllocatorAdd(
        owner.allocatorLedger,
        owner.deferIds,
        value.value,
        sizeof(int32))

fn LoweringBodyIrDeferActivationScratchAppend(
        owner: var LoweringBodyIrDeferActivationScratchOwner,
        value: int32) =
    loweringSequenceAllocatorAdd(
        owner,
        LoweringBodyIrDeferActivationScratchValue(value: value))

@borrows
fn LoweringBodyIrDeferActivationScratchPhysicalBufferCount(
        owner: LoweringBodyIrDeferActivationScratchOwner): int32 =
    return owner.deferIds.cap > 0 ? 1 : 0

@borrows
fn LoweringBodyIrDeferActivationScratchCapacityBytes(
        owner: LoweringBodyIrDeferActivationScratchOwner): int64 =
    return int64(owner.deferIds.cap) * int64(sizeof(int32))

@borrows
fn loweringBodyIrDeferActivationScratchOwnerToken(
        owner: LoweringBodyIrDeferActivationScratchOwner,
        receipt: LoweringSequenceAllocatorReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(176)
    loweringPlanReleaseAppendText(
        buf, "cheng.compiler.lowering.body_ir_defer_activation_scratch")
    loweringPlanReleaseAppendU32Field(
        buf, owner.domain.typedFunctionIndex)
    loweringPlanReleaseAppendU32Field(
        buf, owner.domain.statementRow)
    loweringPlanReleaseAppendU32Field(
        buf, owner.domain.deferId)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocationEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releaseEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalRetainedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalRetainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalReleasedBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveAllocationCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveCapacityBytes)
    let token = hash256.Sha256Fixed(
        layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn LoweringBodyIrDeferActivationScratchReleaseWithReceipt(
        owner: var LoweringBodyIrDeferActivationScratchOwner,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if owner.deferIds.len != 1 ||
       owner.deferIds[0] != owner.domain.deferId ||
       owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()) ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(
               LoweringBodyIrDeferActivationScratchPhysicalBufferCount(
                   owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringBodyIrDeferActivationScratchCapacityBytes(owner):
        panic("lowering body ir defer activation scratch: owner state drift")
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringBodyIrDeferActivationScratchPhysicalBufferCount(owner)
    receipt.terminalRetainedBytes =
        LoweringBodyIrDeferActivationScratchCapacityBytes(owner)
    let terminalReleasedBytes =
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.deferIds,
            sizeof(int32))
    owner.allocatorLedger.closed = true
    receipt.allocationEventCount =
        owner.allocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        owner.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        owner.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        owner.allocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        owner.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        owner.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringBodyIrDeferActivationScratchPhysicalBufferCount(owner) == 0 &&
        LoweringBodyIrDeferActivationScratchCapacityBytes(owner) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering body ir defer activation scratch: receipt incomplete")
    owner.allocatorReceipt = receipt
    owner.ownerToken =
        loweringBodyIrDeferActivationScratchOwnerToken(owner, receipt)
    owner.allocatorReceiptReady = true
    owner.allocatorLedger = LoweringSequenceAllocatorLedger()

fn LoweringBodyIrDeferActivationScratchReceiptConsumeStrict(
        owner: var LoweringBodyIrDeferActivationScratchOwner,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    if !owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt, owner.allocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !layout.FixedBytes32Equal(
           owner.ownerToken,
           loweringBodyIrDeferActivationScratchOwnerToken(owner, receipt)) ||
       LoweringBodyIrDeferActivationScratchPhysicalBufferCount(owner) != 0 ||
       LoweringBodyIrDeferActivationScratchCapacityBytes(owner) != int64(0):
        return false
    owner.allocatorReceiptConsumed = true
    return true

fn LoweringBodyIrDeferActivationScratchClose(
        owner: var LoweringBodyIrDeferActivationScratchOwner) =
    var receipt: LoweringSequenceAllocatorReceipt
    LoweringBodyIrDeferActivationScratchReleaseWithReceipt(
        owner, receipt)
    if !LoweringBodyIrDeferActivationScratchReceiptConsumeStrict(
           owner, receipt):
        panic("lowering body ir defer activation scratch: strict consume failed")

@borrows
fn LoweringBodyIrControlBindDeferAction(
        bodyIR: var coreir.BodyIR,
        transport: LoweringDeferScopeTransportSoA,
        statementRow: int32,
        declarationBlockId: int32,
        activationAfterOpOrdinal: int32): int32 =
    if !transport.complete ||
       !LoweringDeferScopeTransportShapeComplete(transport) ||
       bodyIR.controlFlowSealed ||
       bodyIR.controlFunctionRow != transport.typedFunctionIndex ||
       statementRow < transport.sourceStatementStart:
        panic("lowering body ir control: defer producer state invalid")
    let localStatementRow =
        statementRow - transport.sourceStatementStart
    if localStatementRow < 0 ||
       localStatementRow >= transport.sourceStatementCount ||
       localStatementRow >= transport.statementIndexes.len ||
       transport.statementIndexes[localStatementRow] != statementRow ||
       transport.statementKinds[localStatementRow] !=
           texpr.TypedExprIrStmtDefer ||
       transport.statementDeferOwnerStatementOrdinals[
           localStatementRow] != -1:
        panic("lowering body ir control: defer producer row invalid")
    let declarationScopeId =
        transport.statementLexicalScopeIds[localStatementRow]
    let suiteScopeId =
        transport.statementSuiteScopeIds[localStatementRow]
    if declarationScopeId < 0 ||
       declarationScopeId >= transport.scopeIds.len ||
       suiteScopeId < 0 ||
       suiteScopeId >= transport.scopeIds.len ||
       transport.scopeIds[declarationScopeId] !=
           declarationScopeId ||
       transport.scopeIds[suiteScopeId] != suiteScopeId ||
       transport.scopeKinds[suiteScopeId] !=
           parser.NormalizedScopeDeferSuite ||
       transport.scopeParentIds[suiteScopeId] !=
           declarationScopeId ||
       transport.scopeOwnerStatementOrdinals[suiteScopeId] !=
           transport.statementOrdinals[localStatementRow] ||
       declarationBlockId < 0 ||
       declarationBlockId >= bodyIR.blocks.len ||
       declarationBlockId >= bodyIR.blockScopeIds.len ||
       bodyIR.blockScopeIds[declarationBlockId] !=
           declarationScopeId ||
       activationAfterOpOrdinal < 0 ||
       activationAfterOpOrdinal >
           bodyIR.blocks[declarationBlockId].opCount:
        panic("lowering body ir control: defer producer authority invalid")
    for priorDeferId in 0..<bodyIR.deferStatementRows.len:
        if bodyIR.deferFunctionRows[priorDeferId] ==
               transport.typedFunctionIndex &&
           bodyIR.deferStatementRows[priorDeferId] == statementRow:
            panic("lowering body ir control: defer producer duplicated")
    let deferId = coreir.BodyIRControlFlowAddDefer(
        bodyIR,
        declarationScopeId,
        suiteScopeId,
        transport.statementLexicalOrdinals[localStatementRow],
        transport.typedFunctionIndex,
        statementRow)
    var activationScratch: LoweringBodyIrDeferActivationScratchOwner
    LoweringBodyIrDeferActivationScratchBegin(
        activationScratch,
        LoweringBodyIrDeferActivationScratchDomain(
            typedFunctionIndex: transport.typedFunctionIndex,
            statementRow: statementRow,
            deferId: deferId))
    LoweringBodyIrDeferActivationScratchAppend(
        activationScratch, deferId)
    coreir.BodyIRControlFlowAddDeferActivationSite(
        bodyIR,
        declarationBlockId,
        activationAfterOpOrdinal,
        activationScratch.deferIds)
    LoweringBodyIrDeferActivationScratchClose(
        activationScratch)
    return deferId

@borrows
fn loweringBodyIrControlScopeDescendsFrom(
        bodyIR: coreir.BodyIR,
        scopeId: int32,
        ancestorScopeId: int32): bool =
    if scopeId < 0 ||
       scopeId >= bodyIR.controlScopeParentIds.len ||
       ancestorScopeId < 0 ||
       ancestorScopeId >= bodyIR.controlScopeParentIds.len:
        return false
    var currentScopeId = scopeId
    var remaining = bodyIR.controlScopeParentIds.len + 1
    while currentScopeId >= 0 && remaining > 0:
        if currentScopeId == ancestorScopeId:
            return true
        if currentScopeId >= bodyIR.controlScopeParentIds.len:
            return false
        currentScopeId =
            bodyIR.controlScopeParentIds[currentScopeId]
        remaining = remaining - 1
    return false

fn LoweringBodyIrControlSealScratchBegin(
        owner: var LoweringBodyIrControlSealScratchOwner,
        domain: LoweringBodyIrControlSealScratchDomain) =
    if domain.termCount < 0 ||
       owner.termEdgeKinds.len != 0 ||
       owner.successors.len != 0 ||
       owner.successorEdgeKinds.len != 0 ||
       owner.allocatorLedger.allocationEventCount != int64(0) ||
       owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()):
        panic("lowering body ir control seal scratch: begin state invalid")
    owner.domain = domain
    owner.currentTermIndex = -1

fn loweringSequenceAllocatorAdd(
        owner: var LoweringBodyIrControlSealScratchOwner,
        value: LoweringBodyIrControlSealTermEdgeKindValue) =
    if owner.termScratchOpen ||
       owner.termEdgeKinds.len >= owner.domain.termCount:
        panic("lowering body ir control seal scratch: term domain exhausted")
    loweringSequenceAllocatorAdd(
        owner.allocatorLedger,
        owner.termEdgeKinds,
        value.value,
        sizeof(int32))

fn loweringSequenceAllocatorAdd(
        owner: var LoweringBodyIrControlSealScratchOwner,
        value: LoweringBodyIrControlSealSuccessorValue) =
    if !owner.termScratchOpen ||
       owner.currentTermIndex < 0 ||
       owner.currentTermIndex >= owner.domain.termCount ||
       owner.successors.len >= 2:
        panic("lowering body ir control seal scratch: successor domain exhausted")
    loweringSequenceAllocatorAdd(
        owner.allocatorLedger,
        owner.successors,
        value.value,
        sizeof(int32))

fn loweringSequenceAllocatorAdd(
        owner: var LoweringBodyIrControlSealScratchOwner,
        value: LoweringBodyIrControlSealSuccessorEdgeKindValue) =
    if !owner.termScratchOpen ||
       owner.currentTermIndex < 0 ||
       owner.currentTermIndex >= owner.domain.termCount ||
       owner.successorEdgeKinds.len >= 2:
        panic("lowering body ir control seal scratch: edge domain exhausted")
    loweringSequenceAllocatorAdd(
        owner.allocatorLedger,
        owner.successorEdgeKinds,
        value.value,
        sizeof(int32))

fn LoweringBodyIrControlSealScratchAppendTermEdgeKind(
        owner: var LoweringBodyIrControlSealScratchOwner,
        value: int32) =
    loweringSequenceAllocatorAdd(
        owner,
        LoweringBodyIrControlSealTermEdgeKindValue(value: value))

fn LoweringBodyIrControlSealScratchAppendSuccessor(
        owner: var LoweringBodyIrControlSealScratchOwner,
        value: int32) =
    loweringSequenceAllocatorAdd(
        owner,
        LoweringBodyIrControlSealSuccessorValue(value: value))

fn LoweringBodyIrControlSealScratchAppendSuccessorEdgeKind(
        owner: var LoweringBodyIrControlSealScratchOwner,
        value: int32) =
    loweringSequenceAllocatorAdd(
        owner,
        LoweringBodyIrControlSealSuccessorEdgeKindValue(value: value))

fn LoweringBodyIrControlSealScratchBeginTerm(
        owner: var LoweringBodyIrControlSealScratchOwner,
        termIndex: int32) =
    if owner.termScratchOpen ||
       termIndex < 0 ||
       termIndex >= owner.domain.termCount ||
       owner.successors.len != 0 ||
       owner.successors.cap != 0 ||
       owner.successorEdgeKinds.len != 0 ||
       owner.successorEdgeKinds.cap != 0:
        panic("lowering body ir control seal scratch: term begin invalid")
    owner.currentTermIndex = termIndex
    owner.termScratchOpen = true

fn LoweringBodyIrControlSealScratchReleaseTerm(
        owner: var LoweringBodyIrControlSealScratchOwner) =
    if !owner.termScratchOpen ||
       owner.currentTermIndex < 0 ||
       owner.currentTermIndex >= owner.domain.termCount ||
       owner.successors.len != owner.successorEdgeKinds.len ||
       owner.successors.len > 2:
        panic("lowering body ir control seal scratch: term release invalid")
    loweringSequenceAllocatorRelease(
        owner.allocatorLedger,
        owner.successors,
        sizeof(int32))
    loweringSequenceAllocatorRelease(
        owner.allocatorLedger,
        owner.successorEdgeKinds,
        sizeof(int32))
    owner.currentTermIndex = -1
    owner.termScratchOpen = false

@borrows
fn LoweringBodyIrControlSealScratchPhysicalBufferCount(
        owner: LoweringBodyIrControlSealScratchOwner): int32 =
    var count: int32
    if owner.termEdgeKinds.cap > 0:
        count = count + 1
    if owner.successors.cap > 0:
        count = count + 1
    if owner.successorEdgeKinds.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringBodyIrControlSealScratchCapacityBytes(
        owner: LoweringBodyIrControlSealScratchOwner): int64 =
    return int64(owner.termEdgeKinds.cap) * int64(sizeof(int32)) +
           int64(owner.successors.cap) * int64(sizeof(int32)) +
           int64(owner.successorEdgeKinds.cap) * int64(sizeof(int32))

@borrows
fn loweringBodyIrControlSealScratchOwnerToken(
        owner: LoweringBodyIrControlSealScratchOwner,
        receipt: LoweringSequenceAllocatorReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(160)
    loweringPlanReleaseAppendText(
        buf, "cheng.compiler.lowering.body_ir_control_seal_scratch")
    loweringPlanReleaseAppendU32Field(
        buf, owner.domain.termCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocationEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releaseEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalRetainedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalRetainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalReleasedBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveAllocationCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveCapacityBytes)
    let token = hash256.Sha256Fixed(
        layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn LoweringBodyIrControlSealScratchReleaseWithReceipt(
        owner: var LoweringBodyIrControlSealScratchOwner,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if owner.termScratchOpen ||
       owner.currentTermIndex != -1 ||
       owner.termEdgeKinds.len != owner.domain.termCount ||
       owner.successors.len != 0 ||
       owner.successors.cap != 0 ||
       owner.successorEdgeKinds.len != 0 ||
       owner.successorEdgeKinds.cap != 0 ||
       owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()) ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(
               LoweringBodyIrControlSealScratchPhysicalBufferCount(owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringBodyIrControlSealScratchCapacityBytes(owner):
        panic("lowering body ir control seal scratch: owner state drift")
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringBodyIrControlSealScratchPhysicalBufferCount(owner)
    receipt.terminalRetainedBytes =
        LoweringBodyIrControlSealScratchCapacityBytes(owner)
    var terminalReleasedBytes: int64
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.termEdgeKinds,
            sizeof(int32))
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.successors,
            sizeof(int32))
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.successorEdgeKinds,
            sizeof(int32))
    owner.allocatorLedger.closed = true
    receipt.allocationEventCount =
        owner.allocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        owner.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        owner.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        owner.allocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        owner.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        owner.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringBodyIrControlSealScratchPhysicalBufferCount(owner) == 0 &&
        LoweringBodyIrControlSealScratchCapacityBytes(owner) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering body ir control seal scratch: receipt incomplete")
    owner.allocatorReceipt = receipt
    owner.ownerToken =
        loweringBodyIrControlSealScratchOwnerToken(owner, receipt)
    owner.allocatorReceiptReady = true
    owner.allocatorLedger = LoweringSequenceAllocatorLedger()

fn LoweringBodyIrControlSealScratchReceiptConsumeStrict(
        owner: var LoweringBodyIrControlSealScratchOwner,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    if !owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt, owner.allocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !layout.FixedBytes32Equal(
           owner.ownerToken,
           loweringBodyIrControlSealScratchOwnerToken(owner, receipt)) ||
       LoweringBodyIrControlSealScratchPhysicalBufferCount(owner) != 0 ||
       LoweringBodyIrControlSealScratchCapacityBytes(owner) != int64(0):
        return false
    owner.allocatorReceiptConsumed = true
    return true

fn LoweringBodyIrControlSealScratchClose(
        owner: var LoweringBodyIrControlSealScratchOwner) =
    var receipt: LoweringSequenceAllocatorReceipt
    LoweringBodyIrControlSealScratchReleaseWithReceipt(
        owner, receipt)
    if !LoweringBodyIrControlSealScratchReceiptConsumeStrict(
           owner, receipt):
        panic("lowering body ir control seal scratch: strict consume failed")

@borrows
fn LoweringBodyIrControlSeal(
        bodyIR: var coreir.BodyIR,
        transport: LoweringDeferScopeTransportSoA,
        breakTermIndexes: var int32[],
        continueTermIndexes: var int32[],
        loopBackTermIndexes: var int32[]) =
    if !transport.complete ||
       !LoweringDeferScopeTransportShapeComplete(transport) ||
       transport.statementIndexes.len !=
           transport.sourceStatementCount ||
       bodyIR.controlFunctionRow != transport.typedFunctionIndex ||
       bodyIR.blockScopeIds.len != bodyIR.blocks.len ||
       bodyIR.termSuccessorStarts.len != 0 ||
       bodyIR.successorBlockIds.len != 0 ||
       bodyIR.deferDeclarationScopeIds.len !=
           bodyIR.deferStatementRows.len ||
       bodyIR.deferSuiteScopeIds.len !=
           bodyIR.deferStatementRows.len ||
       bodyIR.deferLexicalOrdinals.len !=
           bodyIR.deferStatementRows.len ||
       bodyIR.deferFunctionRows.len !=
           bodyIR.deferStatementRows.len ||
       bodyIR.deferActionCids.len !=
           bodyIR.deferStatementRows.len:
        panic("lowering body ir control: seal state invalid")
    var expectedDeferId: int32
    for localStatementRow in 0..<transport.statementIndexes.len:
        if transport.statementKinds[localStatementRow] !=
               texpr.TypedExprIrStmtDefer:
            continue
        if expectedDeferId >= bodyIR.deferStatementRows.len:
            panic(
                "lowering body ir control: detached defer action producer missing")
        let declarationScopeId =
            transport.statementLexicalScopeIds[localStatementRow]
        let suiteScopeId =
            transport.statementSuiteScopeIds[localStatementRow]
        if transport.statementIndexes[localStatementRow] <
               transport.sourceStatementStart ||
           transport.statementIndexes[localStatementRow] -
               transport.sourceStatementStart !=
               localStatementRow ||
           transport.statementDeferOwnerStatementOrdinals[
               localStatementRow] != -1 ||
           declarationScopeId < 0 ||
           declarationScopeId >= transport.scopeIds.len ||
           suiteScopeId < 0 ||
           suiteScopeId >= transport.scopeIds.len ||
           transport.scopeIds[declarationScopeId] !=
               declarationScopeId ||
           transport.scopeIds[suiteScopeId] != suiteScopeId ||
           transport.scopeKinds[suiteScopeId] !=
               parser.NormalizedScopeDeferSuite ||
           transport.scopeParentIds[suiteScopeId] !=
               declarationScopeId ||
           transport.scopeOwnerStatementOrdinals[suiteScopeId] !=
               transport.statementOrdinals[localStatementRow]:
            panic(
                "lowering body ir control: defer producer transport drift")
        if bodyIR.deferDeclarationScopeIds[expectedDeferId] !=
               declarationScopeId ||
           bodyIR.deferSuiteScopeIds[expectedDeferId] !=
               suiteScopeId ||
           bodyIR.deferLexicalOrdinals[expectedDeferId] !=
               transport.statementLexicalOrdinals[localStatementRow] ||
           bodyIR.deferFunctionRows[expectedDeferId] !=
               transport.typedFunctionIndex ||
           bodyIR.deferStatementRows[expectedDeferId] !=
               transport.statementIndexes[localStatementRow]:
            panic(
                "lowering body ir control: defer producer identity drift")
        var actionBlockCount: int32
        for blockId in 0..<bodyIR.blocks.len:
            if loweringBodyIrControlScopeDescendsFrom(
                   bodyIR,
                   bodyIR.blockScopeIds[blockId],
                   suiteScopeId):
                actionBlockCount = actionBlockCount + 1
        if actionBlockCount <= 0:
            panic(
                "lowering body ir control: detached defer action producer missing")
        expectedDeferId = expectedDeferId + 1
    if expectedDeferId != bodyIR.deferStatementRows.len:
        panic("lowering body ir control: orphan defer action producer")
    var sealScratch: LoweringBodyIrControlSealScratchOwner
    LoweringBodyIrControlSealScratchBegin(
        sealScratch,
        LoweringBodyIrControlSealScratchDomain(
            termCount: bodyIR.terms.len))
    for _ in 0..<bodyIR.terms.len:
        LoweringBodyIrControlSealScratchAppendTermEdgeKind(
            sealScratch, -1)
    LoweringBodyIrControlBindTermClass(
        share(bodyIR),
        breakTermIndexes,
        coreir.BodyControlEdgeBreak,
        sealScratch.termEdgeKinds)
    LoweringBodyIrControlBindTermClass(
        share(bodyIR),
        continueTermIndexes,
        coreir.BodyControlEdgeContinue,
        sealScratch.termEdgeKinds)
    LoweringBodyIrControlBindTermClass(
        share(bodyIR),
        loopBackTermIndexes,
        coreir.BodyControlEdgeLoopBack,
        sealScratch.termEdgeKinds)
    for termIndex in 0..<bodyIR.terms.len:
        let term = bodyIR.terms[termIndex]
        LoweringBodyIrControlSealScratchBeginTerm(
            sealScratch, termIndex)
        if term.kind == coreir.BodyTermReturnTag:
            coreir.BodyIRControlFlowBindTermSuccessors(
                bodyIR,
                termIndex,
                sealScratch.successors,
                sealScratch.successorEdgeKinds)
            LoweringBodyIrControlSealScratchReleaseTerm(
                sealScratch)
            continue
        elif term.kind == coreir.BodyTermBrTag:
            if term.trueBlock < 0 ||
               term.trueBlock >= bodyIR.blocks.len:
                panic(
                    "lowering body ir control: branch successor invalid")
            LoweringBodyIrControlSealScratchAppendSuccessor(
                sealScratch, term.trueBlock)
            let edgeKind = sealScratch.termEdgeKinds[termIndex] >= 0 ?
                sealScratch.termEdgeKinds[termIndex] :
                coreir.BodyControlEdgeNormal
            LoweringBodyIrControlSealScratchAppendSuccessorEdgeKind(
                sealScratch, edgeKind)
        elif term.kind == coreir.BodyTermCbrTag:
            if term.trueBlock < 0 ||
               term.trueBlock >= bodyIR.blocks.len ||
               term.falseBlock < 0 ||
               term.falseBlock >= bodyIR.blocks.len:
                panic(
                    "lowering body ir control: conditional successor invalid")
            LoweringBodyIrControlSealScratchAppendSuccessor(
                sealScratch, term.trueBlock)
            LoweringBodyIrControlSealScratchAppendSuccessorEdgeKind(
                sealScratch, coreir.BodyControlEdgeNormal)
            LoweringBodyIrControlSealScratchAppendSuccessor(
                sealScratch, term.falseBlock)
            LoweringBodyIrControlSealScratchAppendSuccessorEdgeKind(
                sealScratch, coreir.BodyControlEdgeNormal)
        else:
            panic("lowering body ir control: unsupported terminator")
        coreir.BodyIRControlFlowBindTermSuccessors(
            bodyIR,
            termIndex,
            sealScratch.successors,
            sealScratch.successorEdgeKinds)
        LoweringBodyIrControlSealScratchReleaseTerm(
            sealScratch)
    LoweringBodyIrControlSealScratchClose(sealScratch)
    coreir.BodyIRControlFlowSeal(bodyIR)

@borrows
fn LoweringBuildOwnershipTransport(
        typedIr: texpr.TypedExprIr,
        typedFunctionIndex: int32,
        out: var LoweringOwnershipTransportSoA) =
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >= typedIr.functions2_functionNameIds.len:
        panic("lowering ownership transport: function index out of range")
    let statementStart = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.functions2_statementStarts,
        typedFunctionIndex)
    let statementCount = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.functions2_statementCounts,
        typedFunctionIndex)
    let nodeStart = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.functions2_nodeStarts,
        typedFunctionIndex)
    let nodeCount = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.functions2_nodeCounts,
        typedFunctionIndex)
    let definitionStart = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.functions2_valueDefinitionStarts,
        typedFunctionIndex)
    let definitionCount = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.functions2_valueDefinitionCounts,
        typedFunctionIndex)
    if statementStart < 0 || statementCount < 0 ||
       statementStart > typedIr.statements2_statementIndexs.len ||
       statementCount >
           typedIr.statements2_statementIndexs.len - statementStart ||
       nodeStart < 0 || nodeCount < 0 ||
       nodeStart > typedIr.nodes2_nodeIndexs.len ||
       nodeCount > typedIr.nodes2_nodeIndexs.len - nodeStart ||
       definitionStart < 0 || definitionCount < 0 ||
       definitionStart >
           texpr.TypedExprValueDefinitionAuthorityCount(typedIr) ||
       definitionCount >
           texpr.TypedExprValueDefinitionAuthorityCount(typedIr) -
               definitionStart:
        panic("lowering ownership transport: function CSR range invalid")

    var built: LoweringOwnershipTransportSoA
    built.typedFunctionIndex = typedFunctionIndex
    built.sourceValueDefinitionStart = definitionStart
    built.sourceValueDefinitionCount = definitionCount
    built.typeArenaArtifactCid =
        typedIr.valueDefinitionTypeArenaArtifactCid
    var authorityErr: str
    if !texpr.TypedExprValueDefinitionAuthorityStrictValidateInto(
            typedIr, authorityErr):
        panic(Fmt"lowering ownership transport: authority invalid:{authorityErr}")
    # A function with no value definition has no ownership fact to
    # transport.  Keep the transport structurally complete, but do not invent a
    # TypeArena domain for an empty payload.
    if definitionCount == 0:
        built.complete = true
        LoweringOwnershipTransportMoveInto(out, built)
        return

    if !typedIr.valueDefinitionTypeArenaBound ||
       !coreir.BodyIRTypeArenaArtifactCidValid(
           typedIr.valueDefinitionTypeArenaArtifactCid):
        panic("lowering ownership transport: exact TypeArena domain missing")
    for definitionOffset in 0..<definitionCount:
        let definitionRow = definitionStart + definitionOffset
        if texpr.TypedExprValueDefinitionTypedFunctionIndexAt(
               typedIr, definitionRow) != typedFunctionIndex:
            panic("lowering ownership transport: function definition authority drift")
        let originKind = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.valueDefinitions_originKinds,
            definitionRow)
        let groupRow = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.valueDefinitions_groupRows,
            definitionRow)
        let sourceLocalNodeIndex = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.valueDefinitions_sourceLocalNodeIndexes,
            definitionRow)
        let declarationSourceLocalRow =
            texpr.TypedExprValueDefinitionDeclarationSourceLocalRowAt(
                typedIr, definitionRow)
        let patternSourceLocalRow =
            texpr.TypedExprValueDefinitionPatternSourceLocalRowAt(
                typedIr, definitionRow)
        if originKind ==
               Int32(texpr.TypedExprValueDefinitionOriginBindingInitializer):
            if groupRow < 0 ||
               groupRow >=
                   texpr.TypedExprValueDefinitionGroupAuthorityCount(
                       typedIr) ||
               arenamod.ArenaArrayInt32Get(
                   typedIr.arena,
                   typedIr.valueDefinitionGroups_typedFunctionIndexes,
                   groupRow) != typedFunctionIndex ||
               arenamod.ArenaArrayInt32Get(
                   typedIr.arena,
                   typedIr.valueDefinitionGroups_definitionRows,
                   groupRow) != definitionRow ||
               arenamod.ArenaArrayInt32Get(
                   typedIr.arena,
                   typedIr.valueDefinitionGroups_consumedFlags,
                   groupRow) != 1 ||
               sourceLocalNodeIndex < 0 ||
               declarationSourceLocalRow < 0 ||
               patternSourceLocalRow < 0:
                panic("lowering ownership transport: binding definition authority drift")
        elif originKind ==
                 Int32(texpr.TypedExprValueDefinitionOriginParameter):
            if groupRow != -1 ||
               sourceLocalNodeIndex != -1 ||
               declarationSourceLocalRow < 0 ||
               patternSourceLocalRow != -1:
                panic("lowering ownership transport: parameter definition authority drift")
        elif originKind ==
                 Int32(texpr.TypedExprValueDefinitionOriginCallResult):
            if groupRow != -1 ||
               sourceLocalNodeIndex < 0 ||
               declarationSourceLocalRow != -1 ||
               patternSourceLocalRow != -1:
                panic("lowering ownership transport: call-result definition authority drift")
        elif originKind ==
                 Int32(
                     texpr.TypedExprValueDefinitionOriginManagedTemporary):
            if groupRow != -1 ||
               sourceLocalNodeIndex < 0 ||
               declarationSourceLocalRow != -1 ||
               patternSourceLocalRow != -1:
                panic("lowering ownership transport: managed temporary definition authority drift")
        else:
            panic("lowering ownership transport: definition origin invalid")
        let definingNodeIndex =
            texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                typedIr, definitionRow)
        if definingNodeIndex < nodeStart ||
           definingNodeIndex >= nodeStart + nodeCount:
            panic("lowering ownership transport: definition node escapes function")
        let exactTypeId =
            texpr.TypedExprValueDefinitionExactTypeIdAt(
                typedIr, definitionRow)
        if exactTypeId < 0 ||
           exactTypeId !=
               texpr.TypedExprIrNodeStructuralTypeIdAt(
                   typedIr, definingNodeIndex):
            panic("lowering ownership transport: exact TypeId drift")
        let ownership =
            texpr.TypedExprValueDefinitionOwnershipAt(
                typedIr, definitionRow)
        let borrowOwnerValueDefinitionRow =
            texpr.TypedExprValueDefinitionBorrowOwnerValueDefinitionRowAt(
                typedIr, definitionRow)
        let proofKind =
            texpr.TypedExprValueDefinitionProofKindAt(
                typedIr, definitionRow)
        let managed = typedIr.nodes2_resultTypeManagedFlags[
            definingNodeIndex]
        # [w61] Canonical borrowed-view parameter: a `var T` parameter over a
        # managed T is stamped Borrowed by the typed-expr producer ("a managed
        # parameter is a borrowed place at this node"), while its exact arena
        # type is the non-owning BorrowedView whose trait derivation
        # intentionally leaves resultTypeManaged false.  Both columns are
        # producer-exact; only their conjunction is new here.  The Borrowed
        # class itself carries the text authority's managed-referent premise
        # (unmanaged referents derive Unmanaged before the ParamRef arm), so
        # the admission arm mirrors exactly the producer fingerprint columns
        # that remain readable here: the exact TypeArena pointer is sealed
        # out of the typed IR before lowering (compiler_csg seal moves it to
        # the CSG work arena), so no per-type column is re-derived.  Any
        # other shape keeps the original drift panic.
        let canonicalBorrowedViewParameter =
            !managed &&
            ownership == texpr.TypedExprExprBorrowed &&
            originKind ==
                Int32(texpr.TypedExprValueDefinitionOriginParameter) &&
            typedIr.nodes2_opKinds[definingNodeIndex] ==
                texpr.TypedExprIrOpParamRef &&
            arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_originParserNodeIds,
                definingNodeIndex) == -1 &&
            arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_syntheticOriginKinds,
                definingNodeIndex) ==
                texpr.TypedExprSyntheticOriginParameter &&
            arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_spanAuthorityKinds,
                definingNodeIndex) ==
                texpr.TypedExprSpanAuthorityNoSource &&
            proofKind == texpr.TypedExprSnapshotTypeProofReference
        if (managed &&
            ownership != texpr.TypedExprExprOwned &&
            ownership != texpr.TypedExprExprBorrowed) ||
           (!canonicalBorrowedViewParameter &&
            !managed &&
            ownership != texpr.TypedExprExprUnmanaged):
            # [w61] Diagnostic enrichment only: pass/fail boundary is
            # byte-identical; the payload carries the ownership class
            # expectation (managed flag), the actual stamped class
            # (definition ownership + defining node expr class), and the
            # exact node coordinates needed to attribute the drift.
            panic(Fmt"lowering ownership transport: managed ownership class drift definition={definitionRow} node={definingNodeIndex} origin={originKind} ownership={Int32(ownership)} node_class={Int32(texpr.TypedExprIrNodeExprClassAt(typedIr, definingNodeIndex))} managed={managed} op={Int32(typedIr.nodes2_opKinds[definingNodeIndex])} exact_type={exactTypeId} node_type={texpr.TypedExprIrNodeStructuralTypeIdAt(typedIr, definingNodeIndex)} proof={Int32(proofKind)} source_local={sourceLocalNodeIndex} decl_local={declarationSourceLocalRow} tfn={typedFunctionIndex}")
        if managed && ownership == texpr.TypedExprExprBorrowed:
            if borrowOwnerValueDefinitionRow < definitionStart ||
               borrowOwnerValueDefinitionRow >=
                   definitionStart + definitionCount:
                panic("lowering ownership transport: borrowed owner escapes function")
            let ownerOriginKind = arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.valueDefinitions_originKinds,
                borrowOwnerValueDefinitionRow)
            let ownerOwnership =
                texpr.TypedExprValueDefinitionOwnershipAt(
                    typedIr, borrowOwnerValueDefinitionRow)
            let ownerRoot =
                texpr.TypedExprValueDefinitionBorrowOwnerValueDefinitionRowAt(
                    typedIr, borrowOwnerValueDefinitionRow)
            if borrowOwnerValueDefinitionRow == definitionRow:
                if originKind !=
                       Int32(texpr.TypedExprValueDefinitionOriginParameter):
                    panic("lowering ownership transport: only borrowed parameters may self-root")
            elif ownerOwnership != texpr.TypedExprExprOwned &&
                 !(ownerOwnership == texpr.TypedExprExprBorrowed &&
                   ownerOriginKind ==
                       Int32(texpr.TypedExprValueDefinitionOriginParameter) &&
                   ownerRoot == borrowOwnerValueDefinitionRow):
                panic("lowering ownership transport: borrowed owner root is not canonical")
        elif borrowOwnerValueDefinitionRow != -1:
            panic("lowering ownership transport: non-borrowed definition carries owner")
        if proofKind == texpr.TypedExprSnapshotTypeProofNone:
            panic("lowering ownership transport: exact type proof missing")
        let sourceStatementIndex =
            texpr.TypedExprIrNodeOwnerStatementIndexAt(
                typedIr, definingNodeIndex)
        let nodeOpKind = typedIr.nodes2_opKinds[definingNodeIndex]
        let nodeParserOriginId = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_originParserNodeIds,
            definingNodeIndex)
        let nodeSyntheticOriginKind = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_syntheticOriginKinds,
            definingNodeIndex)
        let nodeSpanAuthorityKind = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_spanAuthorityKinds,
            definingNodeIndex)
        # [w63] Detached zero-value declaration template: a bare `var n: T`
        # binding (no explicit initializer) is registered by typed_expr as a
        # synthetic NilPtr producer node built outside any statement
        # (TypedExprIrAddLocalDeclStatement); the exact owner-statement claim
        # only adopts statement-root-reachable subtrees, so the node's owner
        # statement index is -1 by construction.  Mirror the producer-side
        # detached-zero-declaration fingerprint column-for-column (binding
        # origin, owner -1, NilPtr op, parser origin -1, Desugared synthetic
        # origin, NoSource span authority), matching the schema and codec
        # consumer mirrors; any mismatched column leaves the original guard
        # verdict untouched.
        let detachedZeroValueDeclarationNode: bool =
            originKind ==
                Int32(
                    texpr.TypedExprValueDefinitionOriginBindingInitializer) &&
            sourceStatementIndex == -1 &&
            nodeOpKind == texpr.TypedExprIrOpNilPtr &&
            nodeParserOriginId == -1 &&
            nodeSyntheticOriginKind ==
                texpr.TypedExprSyntheticOriginDesugared &&
            nodeSpanAuthorityKind == texpr.TypedExprSpanAuthorityNoSource
        if (originKind ==
                Int32(
                    texpr.TypedExprValueDefinitionOriginParameter) &&
            sourceStatementIndex != -1) ||
           (originKind !=
                Int32(
                    texpr.TypedExprValueDefinitionOriginParameter) &&
            !detachedZeroValueDeclarationNode &&
            (sourceStatementIndex < statementStart ||
             sourceStatementIndex >=
                 statementStart + statementCount)):
            panic(Fmt"lowering ownership transport: exact owner statement row invalid definition={definitionRow} node={definingNodeIndex} origin={originKind} owner_stmt={sourceStatementIndex} stmt_start={statementStart} stmt_count={statementCount} node_op={Int32(nodeOpKind)} parser_origin={nodeParserOriginId} synthetic={nodeSyntheticOriginKind} span={nodeSpanAuthorityKind} tfn={typedFunctionIndex}")
        let callDeclarationIndex = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_callDeclarationIndexes,
            definingNodeIndex)
        if nodeOpKind == texpr.TypedExprIrOpCallExpr:
            # Canonical typed-expr call-node authority contract: a
            # declaration-backed CallExpr carries callDeclarationIndex >= 0
            # (its exact producer row is sealed by typed expr); intrinsic and
            # indirect field calls carry exactly -1 with their canonical
            # authority state.  Accept exactly those states here.
            if callDeclarationIndex < -1:
                panic(Fmt"lowering ownership transport: call declaration row invalid definition={definitionRow} node={definingNodeIndex} call_decl={callDeclarationIndex} tfn={typedFunctionIndex}")
            if callDeclarationIndex == -1 &&
               !texpr.TypedExprIrCallNodeMinusOneDeclarationStateValidAt(
                   typedIr, definingNodeIndex):
                panic(Fmt"lowering ownership transport: call declaration identity drift definition={definitionRow} node={definingNodeIndex} op={nodeOpKind} call_decl={callDeclarationIndex} origin={originKind} tfn={typedFunctionIndex}")
        elif callDeclarationIndex != -1:
            panic(Fmt"lowering ownership transport: non-call node carries declaration row definition={definitionRow} node={definingNodeIndex} op={nodeOpKind} call_decl={callDeclarationIndex} tfn={typedFunctionIndex}")
        if originKind ==
               Int32(texpr.TypedExprValueDefinitionOriginParameter) &&
           nodeOpKind != texpr.TypedExprIrOpParamRef:
            panic("lowering ownership transport: parameter producer node drift")
        if originKind ==
               Int32(texpr.TypedExprValueDefinitionOriginCallResult) &&
           nodeOpKind != texpr.TypedExprIrOpCallExpr:
            panic("lowering ownership transport: call-result producer node drift")
        if originKind ==
               Int32(
                   texpr.TypedExprValueDefinitionOriginManagedTemporary) &&
           (ownership != texpr.TypedExprExprOwned ||
            !managed ||
            !texpr.TypedExprIrOpIsExactManagedTemporaryProducer(
                nodeOpKind) ||
            arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_originParserNodeIds,
                definingNodeIndex) != sourceLocalNodeIndex):
            panic("lowering ownership transport: managed temporary producer authority drift")
        LoweringOwnershipTransportAppendExactRow(
            built,
            groupRow,
            definitionRow,
            originKind,
            sourceLocalNodeIndex,
            declarationSourceLocalRow,
            patternSourceLocalRow,
            sourceStatementIndex,
            definingNodeIndex,
            exactTypeId,
            ownership,
            borrowOwnerValueDefinitionRow,
            proofKind,
            managed,
            nodeOpKind,
            callDeclarationIndex)
    if !LoweringOwnershipTransportShapeComplete(built) ||
       !LoweringOwnershipTransportDefinitionCsrExact(built):
        panic("lowering ownership transport: destination shape incomplete")
    built.complete = true
    LoweringOwnershipTransportMoveInto(out, built)

@borrows
fn LoweringAttachOwnershipTransport(
        fnIr: var PrimaryObjectIrFunction,
        typedIr: texpr.TypedExprIr,
        typedFunctionIndex: int32) =
    if fnIr.typedFunctionIndex != typedFunctionIndex:
        panic("lowering ownership transport: attach function identity drift")
    LoweringBuildOwnershipTransport(
        typedIr, typedFunctionIndex, fnIr.ownershipTransport)

@borrows
fn LoweringOwnershipTransportRowForDefinition(
        transport: LoweringOwnershipTransportSoA,
        sourceStatementIndex: int32,
        definingNodeIndex: int32): int32 =
    if !transport.complete ||
       !LoweringOwnershipTransportShapeComplete(transport):
        panic("lowering ownership transport: query source incomplete")
    if !LoweringOwnershipTransportDefinitionCsrExact(transport):
        panic("lowering ownership transport: definition CSR identity invalid")
    if sourceStatementIndex < 0 || definingNodeIndex < 0:
        panic("lowering ownership transport: exact query identity missing")
    var found: int32 = -1
    for row in 0..<transport.sourceStatementIndexes.len:
        if transport.sourceStatementIndexes[row] == sourceStatementIndex &&
           transport.definingNodeIndexes[row] == definingNodeIndex:
            if found >= 0:
                panic("lowering ownership transport: exact definition identity duplicated")
            found = row
    return found

@borrows
fn loweringOwnershipBodyKind(
        ownership: texpr.TypedExprExprClass): coreir.OwnershipKind =
    if ownership == texpr.TypedExprExprOwned:
        return coreir.OwnMove
    if ownership == texpr.TypedExprExprBorrowed:
        return coreir.OwnBorrowShared
    panic("lowering ownership transport: managed ownership class unsupported")
    return coreir.OwnInvalid

@borrows
fn loweringBodyIrBorrowOwnerPhysicalRef(
        bodyIR: coreir.BodyIR,
        typedIr: texpr.TypedExprIr,
        transport: LoweringOwnershipTransportSoA,
        ownerValueDefinitionRow: int32,
        domainOut: var int32,
        rowOut: var int32): bool =
    domainOut = coreir.BodyDefinitionDomainInvalidTag
    rowOut = -1
    var transportRow: int32 = -1
    for candidateRow in 0..<transport.definitionRows.len:
        if transport.definitionRows[candidateRow] !=
               ownerValueDefinitionRow:
            continue
        if transportRow >= 0:
            return false
        transportRow = candidateRow
    if transportRow < 0:
        return false
    if transport.originKinds[transportRow] ==
           Int32(texpr.TypedExprValueDefinitionOriginParameter):
        let nodeIndex = transport.definingNodeIndexes[transportRow]
        if nodeIndex < 0 ||
           nodeIndex >= typedIr.nodes2_nodeIndexs.len ||
           typedIr.nodes2_opKinds[nodeIndex] !=
               texpr.TypedExprIrOpParamRef:
            return false
        let paramOrdinal = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.nodes2_paramSlots, nodeIndex)
        let slotId = loweringBodyIrParamPhysicalSlot(
            bodyIR, paramOrdinal)
        if slotId < 0 ||
           transport.ownershipKinds[transportRow] !=
               texpr.TypedExprExprBorrowed ||
           transport.borrowOwnerValueDefinitionRows[transportRow] !=
               ownerValueDefinitionRow:
            return false
        domainOut = coreir.BodyDefinitionDomainEntrySlotTag
        rowOut = slotId
        return true
    if transport.ownershipKinds[transportRow] !=
           texpr.TypedExprExprOwned ||
       transport.borrowOwnerValueDefinitionRows[transportRow] != -1:
        return false
    for opIndex in 0..<bodyIR.ops.len:
        let candidate = bodyIR.ops[opIndex]
        if candidate.valueDefSemanticRow != ownerValueDefinitionRow ||
           candidate.valueDefOwnership != coreir.OwnMove:
            continue
        if rowOut >= 0:
            return false
        domainOut = coreir.BodyDefinitionDomainBodyOpTag
        rowOut = opIndex
    return rowOut >= 0

@borrows
fn LoweringBindManagedCallResultDefinition(
        bodyIR: var coreir.BodyIR,
        lowering: LoweringPlanStub,
        transport: LoweringOwnershipTransportSoA,
        sourceStatementIndex: int32,
        definingNodeIndex: int32,
        callIndex: int32,
        bodyOpIndex: int32) =
    # Transport rows are keyed by (owner statement, defining node), and the
    # owner statement column is stamped at build time from
    # TypedExprIrNodeOwnerStatementIndexAt(definingNodeIndex).  The canonical
    # statement path passes that same row as sourceStatementIndex, but the
    # node-eval call path (AppendCallExprNodeToSlot) constructs its statement
    # view without a statement row, so its zero value is a placeholder, not a
    # row identity.  The statement index is therefore not an independent
    # caller authority: derive the key from the same typed-ir column the
    # build side used, and fail closed when a caller passes a real (nonzero)
    # row that disagrees with the node owner.
    if definingNodeIndex < 0 ||
       definingNodeIndex >= lowering.typedIr.nodes2_nodeIndexs.len:
        panic("lowering ownership transport: call definition node out of range")
    let ownerStatementIndex = texpr.TypedExprIrNodeOwnerStatementIndexAt(
        lowering.typedIr, definingNodeIndex)
    if sourceStatementIndex > 0 &&
       sourceStatementIndex != ownerStatementIndex:
        panic("lowering ownership transport: call definition statement key drift")
    let row = LoweringOwnershipTransportRowForDefinition(
        transport, ownerStatementIndex, definingNodeIndex)
    if row < 0 || !transport.managedFlags[row] ||
       transport.nodeOpKinds[row] != texpr.TypedExprIrOpCallExpr ||
       transport.callDeclarationIndexes[row] < 0:
        panic("lowering ownership transport: managed call definition missing")
    if callIndex < 0 || callIndex >= bodyIR.callSequence.len ||
       bodyOpIndex < 0 || bodyOpIndex >= bodyIR.ops.len:
        panic("lowering ownership transport: BodyIR coordinate invalid")
    var call = bodyIR.callSequence[callIndex]
    var op = bodyIR.ops[bodyOpIndex]
    if op.kind != coreir.BodyOpCallTag ||
       op.operands.len != 1 ||
       op.operands[0] != callIndex ||
       op.target != call.resultSlot ||
       call.resultSlot < 0 ||
       call.resultSlot >= bodyIR.localSlots.len ||
       call.resultPassKind == coreir.BodyCallPassForwardEntrySretTag:
        panic("lowering ownership transport: call result is not a local value definition")
    if call.resultOwnership != coreir.OwnInvalid ||
       call.resultExprNodeIndex != -1 ||
       call.resultDefinitionOriginKind !=
           coreir.BodyDefinitionOriginUnknownTag ||
       call.resultDefinitionOriginId != -1 ||
       call.resultValueDefinitionRow != -1 ||
       call.resultBorrowOwnerValueDefinitionRow != -1 ||
       call.resultBorrowOwnerDefinitionDomain !=
           coreir.BodyDefinitionDomainInvalidTag ||
       call.resultBorrowOwnerDefinitionRow != -1 ||
       call.sourceDefinitionDomain !=
           coreir.BodyDefinitionDomainInvalidTag ||
       call.sourceDefinitionRow != -1 ||
       call.consumeActionRow != -1 ||
       op.valueDefOwnership != coreir.OwnInvalid ||
       op.valueDefSlot != -1 ||
       op.valueDefExprNodeIndex != -1 ||
       op.valueDefOriginKind != coreir.BodyDefinitionOriginUnknownTag ||
       op.valueDefOriginId != -1 ||
       op.valueDefSemanticRow != -1 ||
       op.valueDefBorrowOwnerSemanticRow != -1 ||
       op.valueDefBorrowOwnerDefinitionDomain !=
           coreir.BodyDefinitionDomainInvalidTag ||
       op.valueDefBorrowOwnerDefinitionRow != -1 ||
       op.sourceDefinitionDomain !=
           coreir.BodyDefinitionDomainInvalidTag ||
       op.sourceDefinitionRow != -1 ||
       op.consumeActionRow != -1:
        panic("lowering ownership transport: call result authority already bound")
    let semanticDefinitionRow = transport.definitionRows[row]
    let exactTypeId = transport.exactTypeIds[row]
    if semanticDefinitionRow <
           transport.sourceValueDefinitionStart ||
       semanticDefinitionRow !=
           transport.sourceValueDefinitionStart + row ||
       exactTypeId < 0 ||
       exactTypeId >= lowering.typeArenaStructuralKinds.len ||
       exactTypeId >= lowering.typeArenaScalarKinds.len ||
       exactTypeId >= lowering.typeArenaChildTypeIds.len ||
       exactTypeId >= lowering.typeArenaFixedLengths.len ||
       exactTypeId >= lowering.typeArenaSizeBytes.len ||
       exactTypeId >= lowering.typeArenaAlignBytes.len ||
       !layout.FixedBytes32Equal(
           transport.typeArenaArtifactCid,
           lowering.typeArenaArtifactCid):
        panic("lowering ownership transport: exact semantic TypeId authority invalid")
    if !managedreplace.ManagedLvalueReplaceProductionBindTypeClosure(
           bodyIR,
           lowering.typeArenaArtifactCid,
           exactTypeId,
           lowering.typeArenaStructuralKinds,
           lowering.typeArenaScalarKinds,
           lowering.typeArenaChildTypeIds,
           lowering.typeArenaFixedLengths,
           lowering.typeArenaSizeBytes,
           lowering.typeArenaAlignBytes) ||
       !coreir.BodyIRBindLocalSlotTypeArenaProof(
           bodyIR,
           call.resultSlot,
           lowering.typeArenaArtifactCid,
           exactTypeId,
           coreir.BodyManagedStorageManagedTag):
        panic("lowering ownership transport: exact TypeId closure bind failed")
    let ownership =
        loweringOwnershipBodyKind(transport.ownershipKinds[row])
    let borrowOwnerSemanticRow =
        transport.borrowOwnerValueDefinitionRows[row]
    var borrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainInvalidTag
    var borrowOwnerDefinitionRow: int32 = -1
    if ownership == coreir.OwnBorrowShared:
        if borrowOwnerSemanticRow < 0 ||
           !loweringBodyIrBorrowOwnerPhysicalRef(
               bodyIR,
               lowering.typedIr,
               transport,
               borrowOwnerSemanticRow,
               borrowOwnerDefinitionDomain,
               borrowOwnerDefinitionRow):
            panic("lowering ownership transport: borrowed call result owner unresolved")
        if borrowOwnerDefinitionDomain ==
               coreir.BodyDefinitionDomainBodyOpTag &&
           borrowOwnerDefinitionRow >= bodyOpIndex:
            panic("lowering ownership transport: borrowed call result owner does not precede definition")
    elif borrowOwnerSemanticRow != -1:
        panic("lowering ownership transport: owned call result carries borrow owner")
    call.resultOwnership = ownership
    call.resultExprNodeIndex = transport.definingNodeIndexes[row]
    call.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    call.resultDefinitionOriginId =
        semanticDefinitionRow
    call.resultValueDefinitionRow =
        semanticDefinitionRow
    call.resultBorrowOwnerValueDefinitionRow =
        borrowOwnerSemanticRow
    call.resultBorrowOwnerDefinitionDomain =
        borrowOwnerDefinitionDomain
    call.resultBorrowOwnerDefinitionRow =
        borrowOwnerDefinitionRow
    op.valueDefSlot = call.resultSlot
    op.valueDefExprNodeIndex = transport.definingNodeIndexes[row]
    op.valueDefOwnership = ownership
    op.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = semanticDefinitionRow
    op.valueDefSemanticRow = semanticDefinitionRow
    op.valueDefBorrowOwnerSemanticRow =
        borrowOwnerSemanticRow
    op.valueDefBorrowOwnerDefinitionDomain =
        borrowOwnerDefinitionDomain
    op.valueDefBorrowOwnerDefinitionRow =
        borrowOwnerDefinitionRow
    bodyIR.callSequence[callIndex] = call
    bodyIR.ops[bodyOpIndex] = op

@borrows
fn LoweringTypedFunctionIndexAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.typedFunctionIndexSourcePaths.cap > 0: count = count + 1
    if plan.typedFunctionIndexSourceBucketHeads.cap > 0:
        count = count + 1
    if plan.typedFunctionIndexSourceEntryNext.cap > 0:
        count = count + 1
    if plan.typedFunctionIndexAbsoluteSuffixBucketHeads.cap > 0:
        count = count + 1
    if plan.typedFunctionIndexAbsoluteSuffixEntryNext.cap > 0:
        count = count + 1
    if plan.typedFunctionIndexAbsoluteSuffixEntryNames.cap > 0:
        count = count + 1
    if plan.typedFunctionIndexAbsoluteSuffixEntrySourceIndexes.cap > 0:
        count = count + 1
    if plan.typedFunctionIndexBucketHeads.cap > 0:
        count = count + 1
    if plan.typedFunctionIndexEntryNext.cap > 0:
        count = count + 1
    if plan.typedFunctionIndexEntrySourceIndexes.cap > 0:
        count = count + 1
    if plan.typedFunctionIndexEntryNames.cap > 0:
        count = count + 1
    if plan.typedFunctionIndexEntryIndexes.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringTypedFunctionIndexAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(plan.typedFunctionIndexSourcePaths.cap) *
            int64(sizeof(str)) +
        int64(plan.typedFunctionIndexSourceBucketHeads.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionIndexSourceEntryNext.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionIndexAbsoluteSuffixBucketHeads.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionIndexAbsoluteSuffixEntryNext.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionIndexAbsoluteSuffixEntryNames.cap) *
            int64(sizeof(str)) +
        int64(plan.typedFunctionIndexAbsoluteSuffixEntrySourceIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionIndexBucketHeads.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionIndexEntryNext.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionIndexEntrySourceIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.typedFunctionIndexEntryNames.cap) *
            int64(sizeof(str)) +
        int64(plan.typedFunctionIndexEntryIndexes.cap) *
            int64(sizeof(int32))

fn LoweringTypedFunctionIndexAppendSourceBuckets(
        plan: var LoweringPlanStub,
        bucketHead: int32) =
    if plan.typedFunctionIndexSourceBucketHeads.len !=
       plan.typedFunctionIndexAbsoluteSuffixBucketHeads.len:
        panic("lowering typed function index allocator: source bucket shape drift")
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIndexAllocatorLedger,
        plan.typedFunctionIndexSourceBucketHeads,
        bucketHead,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIndexAllocatorLedger,
        plan.typedFunctionIndexAbsoluteSuffixBucketHeads,
        bucketHead,
        sizeof(int32))

fn LoweringTypedFunctionIndexAppendFunctionBucket(
        plan: var LoweringPlanStub,
        bucketHead: int32) =
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIndexAllocatorLedger,
        plan.typedFunctionIndexBucketHeads,
        bucketHead,
        sizeof(int32))

@borrows
fn LoweringTypedFunctionIndexAppendSourceRow(
        plan: var LoweringPlanStub,
        sourcePath: str,
        entryNext: int32) =
    if plan.typedFunctionIndexSourcePaths.len !=
       plan.typedFunctionIndexSourceEntryNext.len:
        panic("lowering typed function index allocator: source row shape drift")
    var typedFunctionIndexSourcePaths = plan.typedFunctionIndexSourcePaths
    plan.typedFunctionIndexSourcePaths = []
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIndexAllocatorLedger,
        typedFunctionIndexSourcePaths,
        sourcePath,
        sizeof(str))
    plan.typedFunctionIndexSourcePaths = typedFunctionIndexSourcePaths
    var typedFunctionIndexSourceEntryNext = plan.typedFunctionIndexSourceEntryNext
    plan.typedFunctionIndexSourceEntryNext = []
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIndexAllocatorLedger,
        typedFunctionIndexSourceEntryNext,
        entryNext,
        sizeof(int32))
    plan.typedFunctionIndexSourceEntryNext = typedFunctionIndexSourceEntryNext

@borrows
fn LoweringTypedFunctionIndexAppendAbsoluteSuffixRow(
        plan: var LoweringPlanStub,
        entryNext: int32,
        suffixName: str,
        sourceIndex: int32) =
    let rowCount =
        plan.typedFunctionIndexAbsoluteSuffixEntryNames.len
    if plan.typedFunctionIndexAbsoluteSuffixEntryNext.len != rowCount ||
       plan.typedFunctionIndexAbsoluteSuffixEntrySourceIndexes.len !=
           rowCount:
        panic("lowering typed function index allocator: suffix row shape drift")
    var typedFunctionIndexAbsoluteSuffixEntryNext =
        plan.typedFunctionIndexAbsoluteSuffixEntryNext
    plan.typedFunctionIndexAbsoluteSuffixEntryNext = []
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIndexAllocatorLedger,
        typedFunctionIndexAbsoluteSuffixEntryNext,
        entryNext,
        sizeof(int32))
    plan.typedFunctionIndexAbsoluteSuffixEntryNext =
        typedFunctionIndexAbsoluteSuffixEntryNext
    var typedFunctionIndexAbsoluteSuffixEntryNames =
        plan.typedFunctionIndexAbsoluteSuffixEntryNames
    plan.typedFunctionIndexAbsoluteSuffixEntryNames = []
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIndexAllocatorLedger,
        typedFunctionIndexAbsoluteSuffixEntryNames,
        suffixName,
        sizeof(str))
    plan.typedFunctionIndexAbsoluteSuffixEntryNames =
        typedFunctionIndexAbsoluteSuffixEntryNames
    var typedFunctionIndexAbsoluteSuffixEntrySourceIndexes =
        plan.typedFunctionIndexAbsoluteSuffixEntrySourceIndexes
    plan.typedFunctionIndexAbsoluteSuffixEntrySourceIndexes = []
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIndexAllocatorLedger,
        typedFunctionIndexAbsoluteSuffixEntrySourceIndexes,
        sourceIndex,
        sizeof(int32))
    plan.typedFunctionIndexAbsoluteSuffixEntrySourceIndexes =
        typedFunctionIndexAbsoluteSuffixEntrySourceIndexes

@borrows
fn LoweringTypedFunctionIndexAppendEntryRow(
        plan: var LoweringPlanStub,
        entryNext: int32,
        sourceIndex: int32,
        functionName: str,
        functionIndex: int32) =
    let rowCount = plan.typedFunctionIndexEntryNames.len
    if plan.typedFunctionIndexEntryNext.len != rowCount ||
       plan.typedFunctionIndexEntrySourceIndexes.len != rowCount ||
       plan.typedFunctionIndexEntryIndexes.len != rowCount:
        panic("lowering typed function index allocator: entry row shape drift")
    var typedFunctionIndexEntryNext = plan.typedFunctionIndexEntryNext
    plan.typedFunctionIndexEntryNext = []
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIndexAllocatorLedger,
        typedFunctionIndexEntryNext,
        entryNext,
        sizeof(int32))
    plan.typedFunctionIndexEntryNext = typedFunctionIndexEntryNext
    var typedFunctionIndexEntrySourceIndexes =
        plan.typedFunctionIndexEntrySourceIndexes
    plan.typedFunctionIndexEntrySourceIndexes = []
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIndexAllocatorLedger,
        typedFunctionIndexEntrySourceIndexes,
        sourceIndex,
        sizeof(int32))
    plan.typedFunctionIndexEntrySourceIndexes =
        typedFunctionIndexEntrySourceIndexes
    var typedFunctionIndexEntryNames = plan.typedFunctionIndexEntryNames
    plan.typedFunctionIndexEntryNames = []
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIndexAllocatorLedger,
        typedFunctionIndexEntryNames,
        functionName,
        sizeof(str))
    plan.typedFunctionIndexEntryNames = typedFunctionIndexEntryNames
    var typedFunctionIndexEntryIndexes = plan.typedFunctionIndexEntryIndexes
    plan.typedFunctionIndexEntryIndexes = []
    loweringSequenceAllocatorAdd(
        plan.typedFunctionIndexAllocatorLedger,
        typedFunctionIndexEntryIndexes,
        functionIndex,
        sizeof(int32))
    plan.typedFunctionIndexEntryIndexes = typedFunctionIndexEntryIndexes

fn loweringTypedFunctionIndexAccumulateTerminalRelease(
        releasedBytes: int64,
        releasedBufferCount: var int32,
        totalReleasedBytes: var int64) =
    if releasedBytes > int64(0):
        releasedBufferCount = releasedBufferCount + 1
        totalReleasedBytes = totalReleasedBytes + releasedBytes

fn LoweringTypedFunctionIndexAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.typedFunctionIndexAllocatorReceiptReady ||
       LoweringTypedFunctionIndexAllocatorPhysicalBufferCount(plan) != 0 ||
       LoweringTypedFunctionIndexAllocatorCapacityBytes(plan) != int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.typedFunctionIndexAllocatorReceipt):
        panic("lowering typed function index allocator: begin before release")
    plan.typedFunctionIndexAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.typedFunctionIndexAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.typedFunctionIndexAllocatorReceiptReady = false

fn LoweringTypedFunctionIndexAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.typedFunctionIndexAllocatorReceiptReady:
        if LoweringTypedFunctionIndexAllocatorPhysicalBufferCount(plan) != 0 ||
           LoweringTypedFunctionIndexAllocatorCapacityBytes(plan) != int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.typedFunctionIndexAllocatorReceipt):
            panic("lowering typed function index allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringTypedFunctionIndexAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringTypedFunctionIndexAllocatorCapacityBytes(plan)
    if plan.typedFunctionIndexAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.typedFunctionIndexAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering typed function index allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringTypedFunctionIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIndexAllocatorLedger,
            plan.typedFunctionIndexSourcePaths,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIndexAllocatorLedger,
            plan.typedFunctionIndexSourceBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIndexAllocatorLedger,
            plan.typedFunctionIndexSourceEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIndexAllocatorLedger,
            plan.typedFunctionIndexAbsoluteSuffixBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIndexAllocatorLedger,
            plan.typedFunctionIndexAbsoluteSuffixEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIndexAllocatorLedger,
            plan.typedFunctionIndexAbsoluteSuffixEntryNames,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIndexAllocatorLedger,
            plan.typedFunctionIndexAbsoluteSuffixEntrySourceIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIndexAllocatorLedger,
            plan.typedFunctionIndexBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIndexAllocatorLedger,
            plan.typedFunctionIndexEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIndexAllocatorLedger,
            plan.typedFunctionIndexEntrySourceIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIndexAllocatorLedger,
            plan.typedFunctionIndexEntryNames,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringTypedFunctionIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.typedFunctionIndexAllocatorLedger,
            plan.typedFunctionIndexEntryIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    plan.typedFunctionIndexAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.typedFunctionIndexAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.typedFunctionIndexAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.typedFunctionIndexAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.typedFunctionIndexAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.typedFunctionIndexAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.typedFunctionIndexAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringTypedFunctionIndexAllocatorPhysicalBufferCount(plan) == 0 &&
        LoweringTypedFunctionIndexAllocatorCapacityBytes(plan) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering typed function index allocator: receipt incomplete")
    plan.typedFunctionIndexAllocatorReceipt = receipt
    plan.typedFunctionIndexAllocatorReceiptReady = true
    plan.typedFunctionIndexAllocatorLedger =
        LoweringSequenceAllocatorLedger()

@borrows
fn LoweringTypedFunctionIndexExactSourceIndex(plan: LoweringPlanStub,
                                               sourcePathRaw: str): int32 =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let bucket = LoweringTypedFunctionIndexSourceBucket(sourcePath,
                                                        plan.typedFunctionIndexSourceBucketHeads.len)
    if bucket < 0:
        return -1
    var entryIndex = plan.typedFunctionIndexSourceBucketHeads[bucket]
    var visitCount: int32
    while entryIndex >= 0:
        visitCount = visitCount + 1
        if visitCount > plan.typedFunctionIndexSourcePaths.len ||
           entryIndex >= plan.typedFunctionIndexSourcePaths.len ||
           entryIndex >= plan.typedFunctionIndexSourceEntryNext.len:
            assert(false, " lowering typed function index: source chain corrupt")
        if plan.typedFunctionIndexSourcePaths[entryIndex] == sourcePath:
            return entryIndex
        entryIndex = plan.typedFunctionIndexSourceEntryNext[entryIndex]
    return -1

@borrows
fn LoweringTypedFunctionIndexFindOrAddSource(plan: var LoweringPlanStub,
                                              sourcePath: str): int32 =
    let normalizedSourcePath = parser.ParserNormalizePath(sourcePath)
    if len(normalizedSourcePath) <= 0:
        return -1
    let bucket = LoweringTypedFunctionIndexSourceBucket(normalizedSourcePath,
                                                        plan.typedFunctionIndexSourceBucketHeads.len)
    if bucket < 0:
        return -1
    var entryIndex = plan.typedFunctionIndexSourceBucketHeads[bucket]
    var visitCount: int32
    while entryIndex >= 0:
        visitCount = visitCount + 1
        plan.typedFunctionIndexBuildBucketVisitCount =
            plan.typedFunctionIndexBuildBucketVisitCount + 1
        if visitCount > plan.typedFunctionIndexSourcePaths.len ||
           entryIndex >= plan.typedFunctionIndexSourcePaths.len ||
           entryIndex >= plan.typedFunctionIndexSourceEntryNext.len:
            assert(false, " lowering typed function index: build source chain corrupt")
        if plan.typedFunctionIndexSourcePaths[entryIndex] == normalizedSourcePath:
            return entryIndex
        entryIndex = plan.typedFunctionIndexSourceEntryNext[entryIndex]
    let sourceIndex = plan.typedFunctionIndexSourcePaths.len
    LoweringTypedFunctionIndexAppendSourceRow(
        plan,
        normalizedSourcePath,
        plan.typedFunctionIndexSourceBucketHeads[bucket])
    plan.typedFunctionIndexSourceBucketHeads[bucket] = sourceIndex
    plan.typedFunctionIndexBuildSourceCount =
        plan.typedFunctionIndexBuildSourceCount + 1
    return sourceIndex

@borrows
fn LoweringTypedFunctionIndexAddAbsoluteSuffix(plan: var LoweringPlanStub,
                                                sourceIndex: int32,
                                                suffixName: str) =
    let bucket = LoweringTypedFunctionIndexSourceBucket(
        suffixName,
        plan.typedFunctionIndexAbsoluteSuffixBucketHeads.len)
    if bucket < 0:
        panic("lowering typed function index: absolute suffix invalid")
    var entryIndex = plan.typedFunctionIndexAbsoluteSuffixBucketHeads[bucket]
    var visitCount: int32
    while entryIndex >= 0:
        visitCount = visitCount + 1
        plan.typedFunctionIndexBuildBucketVisitCount =
            plan.typedFunctionIndexBuildBucketVisitCount + 1
        if visitCount > plan.typedFunctionIndexAbsoluteSuffixEntryNames.len ||
           entryIndex >= plan.typedFunctionIndexAbsoluteSuffixEntryNext.len ||
           entryIndex >= plan.typedFunctionIndexAbsoluteSuffixEntryNames.len ||
           entryIndex >= plan.typedFunctionIndexAbsoluteSuffixEntrySourceIndexes.len:
            panic("lowering typed function index: absolute suffix chain corrupt")
        if plan.typedFunctionIndexAbsoluteSuffixEntryNames[entryIndex] == suffixName &&
           plan.typedFunctionIndexAbsoluteSuffixEntrySourceIndexes[entryIndex] == sourceIndex:
            return
        entryIndex = plan.typedFunctionIndexAbsoluteSuffixEntryNext[entryIndex]
    let newEntryIndex = plan.typedFunctionIndexAbsoluteSuffixEntryNames.len
    LoweringTypedFunctionIndexAppendAbsoluteSuffixRow(
        plan,
        plan.typedFunctionIndexAbsoluteSuffixBucketHeads[bucket],
        suffixName,
        sourceIndex)
    plan.typedFunctionIndexAbsoluteSuffixBucketHeads[bucket] = newEntryIndex

@borrows
fn LoweringTypedFunctionIndexAddSourceSuffixes(plan: var LoweringPlanStub,
                                                sourceIndex: int32,
                                                sourcePath: str) =
    if sourceIndex < 0 || !chengpath.PathIsAbsolute(sourcePath):
        return
    for slashIndex in 0..<len(sourcePath):
        if sourcePath[slashIndex] != '/' || slashIndex + 1 >= len(sourcePath):
            continue
        let suffixName = strings.SliceBytes(sourcePath,
                                            slashIndex + 1,
                                            len(sourcePath) - slashIndex - 1)
        LoweringTypedFunctionIndexAddAbsoluteSuffix(plan,
                                                    sourceIndex,
                                                    suffixName)

@borrows
fn LoweringBuildTypedFunctionIndexAdd(plan: var LoweringPlanStub,
                                       bucketTails: var int32[],
                                       sourceIndex: int32,
                                       functionName: str,
                                       functionIndex: int32) =
    let bucket = LoweringTypedFunctionIndexBucket(sourceIndex,
                                                  functionName,
                                                  plan.typedFunctionIndexBucketHeads.len)
    if bucket < 0:
        return
    let entryIndex = plan.typedFunctionIndexEntryIndexes.len
    LoweringTypedFunctionIndexAppendEntryRow(
        plan,
        -1,
        sourceIndex,
        functionName,
        functionIndex)
    if plan.typedFunctionIndexBucketHeads[bucket] < 0:
        plan.typedFunctionIndexBucketHeads[bucket] = entryIndex
    else:
        plan.typedFunctionIndexEntryNext[bucketTails[bucket]] = entryIndex
    bucketTails[bucket] = entryIndex

@borrows
fn LoweringTypedFunctionIndexConsiderNameInSource(plan: LoweringPlanStub,
                                                   sourceIndex: int32,
                                                   functionName: str,
                                                   foundIndex: var int32) =
    if sourceIndex < 0 || functionName == "":
        return
    let bucket = LoweringTypedFunctionIndexBucket(sourceIndex,
                                                  functionName,
                                                  plan.typedFunctionIndexBucketHeads.len)
    if bucket < 0:
        return
    var entryIndex = plan.typedFunctionIndexBucketHeads[bucket]
    var visitCount: int32
    while entryIndex >= 0:
        visitCount = visitCount + 1
        if visitCount > plan.typedFunctionIndexEntryIndexes.len ||
           entryIndex >= plan.typedFunctionIndexEntryNext.len ||
           entryIndex >= plan.typedFunctionIndexEntrySourceIndexes.len ||
           entryIndex >= plan.typedFunctionIndexEntryNames.len ||
           entryIndex >= plan.typedFunctionIndexEntryIndexes.len:
            assert(false, " lowering typed function index: entry out of range")
        if plan.typedFunctionIndexEntrySourceIndexes[entryIndex] == sourceIndex &&
           plan.typedFunctionIndexEntryNames[entryIndex] == functionName:
            let candidateIndex = plan.typedFunctionIndexEntryIndexes[entryIndex]
            if foundIndex < 0 || candidateIndex < foundIndex:
                foundIndex = candidateIndex
        entryIndex = plan.typedFunctionIndexEntryNext[entryIndex]

@borrows
fn LoweringTypedFunctionIndexConsiderSource(plan: LoweringPlanStub,
                                             sourceIndex: int32,
                                             functionName: str,
                                             functionTail: str,
                                             foundIndex: var int32) =
    if sourceIndex < 0:
        return
    LoweringTypedFunctionIndexConsiderNameInSource(plan,
                                                   sourceIndex,
                                                   functionName,
                                                   foundIndex)
    if functionTail != functionName:
        LoweringTypedFunctionIndexConsiderNameInSource(plan,
                                                       sourceIndex,
                                                       functionTail,
                                                       foundIndex)

@borrows
fn LoweringTypedFunctionIndexConsiderAbsoluteSuffixSources(
        plan: LoweringPlanStub,
        relativeSourcePath: str,
        functionName: str,
        functionTail: str,
        foundIndex: var int32) =
    let bucket = LoweringTypedFunctionIndexSourceBucket(
        relativeSourcePath,
        plan.typedFunctionIndexAbsoluteSuffixBucketHeads.len)
    if bucket < 0:
        return
    var entryIndex = plan.typedFunctionIndexAbsoluteSuffixBucketHeads[bucket]
    var visitCount: int32
    while entryIndex >= 0:
        visitCount = visitCount + 1
        if visitCount > plan.typedFunctionIndexAbsoluteSuffixEntryNames.len ||
           entryIndex >= plan.typedFunctionIndexAbsoluteSuffixEntryNext.len ||
           entryIndex >= plan.typedFunctionIndexAbsoluteSuffixEntryNames.len ||
           entryIndex >= plan.typedFunctionIndexAbsoluteSuffixEntrySourceIndexes.len:
            assert(false, " lowering typed function index: absolute suffix lookup chain corrupt")
        if plan.typedFunctionIndexAbsoluteSuffixEntryNames[entryIndex] ==
           relativeSourcePath:
            LoweringTypedFunctionIndexConsiderSource(
                plan,
                plan.typedFunctionIndexAbsoluteSuffixEntrySourceIndexes[entryIndex],
                functionName,
                functionTail,
                foundIndex)
        entryIndex = plan.typedFunctionIndexAbsoluteSuffixEntryNext[entryIndex]

@borrows
fn LoweringTypedFunctionIndexLookup(plan: LoweringPlanStub,
                                    sourcePathRaw: str,
                                    functionNameRaw: str): int32 =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let functionName = chengpath.PathTrim(functionNameRaw)
    if sourcePath == "" || functionName == "":
        return -1
    let functionTail = LoweringFunctionTailName(functionName)
    var foundIndex: int32 = -1
    let exactSourceIndex = LoweringTypedFunctionIndexExactSourceIndex(plan,
                                                                      sourcePath)
    LoweringTypedFunctionIndexConsiderSource(plan,
                                             exactSourceIndex,
                                             functionName,
                                             functionTail,
                                             foundIndex)
    if chengpath.PathIsAbsolute(sourcePath):
        for slashIndex in 0..<len(sourcePath):
            if sourcePath[slashIndex] != '/' ||
               slashIndex + 1 >= len(sourcePath):
                continue
            let relativeSuffix = strings.SliceBytes(
                sourcePath,
                slashIndex + 1,
                len(sourcePath) - slashIndex - 1)
            let relativeSourceIndex =
                LoweringTypedFunctionIndexExactSourceIndex(plan,
                                                            relativeSuffix)
            LoweringTypedFunctionIndexConsiderSource(plan,
                                                     relativeSourceIndex,
                                                     functionName,
                                                     functionTail,
                                                     foundIndex)
    else:
        LoweringTypedFunctionIndexConsiderAbsoluteSuffixSources(
            plan,
            sourcePath,
            functionName,
            functionTail,
            foundIndex)
    return foundIndex

@borrows
fn LoweringTypedFunctionIndexLookupAtLine(plan: var LoweringPlanStub,
                                          sourcePathRaw: str,
                                          functionNameRaw: str,
                                          signatureLineNumber: int32): int32 =
    if signatureLineNumber <= 0:
        return LoweringTypedFunctionIndexLookup(plan, sourcePathRaw, functionNameRaw)
    var typedSourcePath: str
    var typedFunctionIndex: int32
    var lookupErr: str
    if LoweringTypedIrExactSemanticIdentityIndex(plan,
                                                 sourcePathRaw,
                                                 functionNameRaw,
                                                 signatureLineNumber,
                                                 typedSourcePath,
                                                 typedFunctionIndex,
                                                 lookupErr):
        return typedFunctionIndex
    return -1

fn LoweringPlanReleaseTypedFunctionLookupSidecarPayload(
        plan: var LoweringPlanStub) =
    plan.typedFunctionIndexBuilt = false
    LoweringTypedFunctionIndexAllocatorRelease(plan)

fn LoweringResetTypedFunctionIndexCounters(plan: var LoweringPlanStub) =
    plan.typedFunctionIndexCompleted = false
    plan.typedFunctionIndexBuildFunctionCount = 0
    plan.typedFunctionIndexBuildSourceCount = 0
    plan.typedFunctionIndexBuildBucketVisitCount = 0
    plan.typedFunctionIndexLookupCount = 0
    plan.typedFunctionIndexLookupBucketVisitCount = 0
    plan.typedFunctionIndexLookupMaxBucketVisitCount = 0
    plan.typedFunctionIndexSourceCountSnapshot = 0
    plan.typedFunctionIndexEntryCountSnapshot = 0
    plan.typedFunctionIndexPeakSidecarCapacityEstimateBytes = Int64(0)
    plan.typedFunctionIndexCompositeKeyPayloadBytes = Int64(0)

fn loweringTypedFunctionDenseStoreInputAllocatorOpen(
        plan: var LoweringPlanStub): bool =
    return !plan.typedFunctionDenseStoreInputAllocatorLedger.closed &&
           !plan.typedFunctionDenseStoreInputAllocatorReceiptReady &&
           !plan.typedFunctionDenseStoreInputAllocatorReceiptConsumed &&
           layout.FixedBytes32Equal(
               plan.typedFunctionDenseStoreInputAllocatorOwnerToken,
               layout.FixedBytes32())

fn LoweringSequenceAllocatorSetLen(
        plan: var LoweringPlanStub,
        values: var str[],
        domain: LoweringTypedDenseFunctionNameLength) =
    if !loweringTypedFunctionDenseStoreInputAllocatorOpen(plan):
        panic("lowering typed dense input: setLen after close")
    loweringSequenceAllocatorSetLen(
        plan.typedFunctionDenseStoreInputAllocatorLedger,
        values,
        domain.length,
        sizeof(str))

fn LoweringSequenceAllocatorSetLen(
        plan: var LoweringPlanStub,
        values: var int32[],
        domain: LoweringTypedDenseParamCountLength) =
    if !loweringTypedFunctionDenseStoreInputAllocatorOpen(plan):
        panic("lowering typed dense input: setLen after close")
    loweringSequenceAllocatorSetLen(
        plan.typedFunctionDenseStoreInputAllocatorLedger,
        values,
        domain.length,
        sizeof(int32))

fn LoweringSequenceAllocatorSetLen(
        plan: var LoweringPlanStub,
        values: var int32[],
        domain: LoweringTypedDenseResultTypeLength) =
    if !loweringTypedFunctionDenseStoreInputAllocatorOpen(plan):
        panic("lowering typed dense input: setLen after close")
    loweringSequenceAllocatorSetLen(
        plan.typedFunctionDenseStoreInputAllocatorLedger,
        values,
        domain.length,
        sizeof(int32))

fn LoweringSequenceAllocatorSetLen(
        plan: var LoweringPlanStub,
        values: var str[],
        domain: LoweringTypedDenseSourcePathLength) =
    if !loweringTypedFunctionDenseStoreInputAllocatorOpen(plan):
        panic("lowering typed dense input: setLen after close")
    loweringSequenceAllocatorSetLen(
        plan.typedFunctionDenseStoreInputAllocatorLedger,
        values,
        domain.length,
        sizeof(str))

fn LoweringSequenceAllocatorSetLen(
        plan: var LoweringPlanStub,
        values: var int32[],
        domain: LoweringTypedDenseBodyKindLength) =
    if !loweringTypedFunctionDenseStoreInputAllocatorOpen(plan):
        panic("lowering typed dense input: setLen after close")
    loweringSequenceAllocatorSetLen(
        plan.typedFunctionDenseStoreInputAllocatorLedger,
        values,
        domain.length,
        sizeof(int32))

fn LoweringSequenceAllocatorSetLen(
        plan: var LoweringPlanStub,
        values: var int32[],
        domain: LoweringTypedDenseEntryFlagLength) =
    if !loweringTypedFunctionDenseStoreInputAllocatorOpen(plan):
        panic("lowering typed dense input: setLen after close")
    loweringSequenceAllocatorSetLen(
        plan.typedFunctionDenseStoreInputAllocatorLedger,
        values,
        domain.length,
        sizeof(int32))

fn LoweringSequenceAllocatorSetLen(
        plan: var LoweringPlanStub,
        values: var int32[],
        domain: LoweringTypedDenseTypedIndexLength) =
    if !loweringTypedFunctionDenseStoreInputAllocatorOpen(plan):
        panic("lowering typed dense input: setLen after close")
    loweringSequenceAllocatorSetLen(
        plan.typedFunctionDenseStoreInputAllocatorLedger,
        values,
        domain.length,
        sizeof(int32))

fn LoweringSequenceAllocatorSetLen(
        plan: var LoweringPlanStub,
        values: var int32[],
        domain: LoweringTypedDenseParamTypeStartLength) =
    if !loweringTypedFunctionDenseStoreInputAllocatorOpen(plan):
        panic("lowering typed dense input: setLen after close")
    loweringSequenceAllocatorSetLen(
        plan.typedFunctionDenseStoreInputAllocatorLedger,
        values,
        domain.length,
        sizeof(int32))

@borrows
fn LoweringTypedFunctionDenseStoreInputAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.typedFunctionDenseStore.functionNames.cap > 0:
        count = count + 1
    if plan.typedFunctionDenseStore.functionParamCounts.cap > 0:
        count = count + 1
    if plan.typedFunctionDenseStore.functionResultTypeTags.cap > 0:
        count = count + 1
    if plan.typedFunctionDenseStore.functionSourcePaths.cap > 0:
        count = count + 1
    if plan.typedFunctionDenseStore.functionBodyKinds.cap > 0:
        count = count + 1
    if plan.typedFunctionDenseStore.functionEntryFlags.cap > 0:
        count = count + 1
    if plan.typedFunctionDenseStore.functionTypedIndices.cap > 0:
        count = count + 1
    if plan.typedFunctionDenseStore.functionParamTypeTags.cap > 0:
        count = count + 1
    if plan.typedFunctionDenseStore.functionParamTypeStarts.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringTypedFunctionDenseStoreInputAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(plan.typedFunctionDenseStore.functionNames.cap) *
               int64(sizeof(str)) +
           int64(plan.typedFunctionDenseStore.functionParamCounts.cap) *
               int64(sizeof(int32)) +
           int64(plan.typedFunctionDenseStore.functionResultTypeTags.cap) *
               int64(sizeof(int32)) +
           int64(plan.typedFunctionDenseStore.functionSourcePaths.cap) *
               int64(sizeof(str)) +
           int64(plan.typedFunctionDenseStore.functionBodyKinds.cap) *
               int64(sizeof(int32)) +
           int64(plan.typedFunctionDenseStore.functionEntryFlags.cap) *
               int64(sizeof(int32)) +
           int64(plan.typedFunctionDenseStore.functionTypedIndices.cap) *
               int64(sizeof(int32)) +
           int64(plan.typedFunctionDenseStore.functionParamTypeTags.cap) *
               int64(sizeof(int32)) +
           int64(plan.typedFunctionDenseStore.functionParamTypeStarts.cap) *
               int64(sizeof(int32))

@borrows
fn loweringTypedFunctionDenseStoreInputAllocatorMatches(
        plan: LoweringPlanStub): bool =
    return plan.typedFunctionDenseStoreInputAllocatorLedger.liveAllocationCount ==
               int64(
                   LoweringTypedFunctionDenseStoreInputAllocatorPhysicalBufferCount(
                       plan)) &&
           plan.typedFunctionDenseStoreInputAllocatorLedger.liveCapacityBytes ==
               LoweringTypedFunctionDenseStoreInputAllocatorCapacityBytes(
                   plan)

@borrows
fn loweringTypedFunctionDenseStoreInputOwnerToken(
        receipt: LoweringSequenceAllocatorReceipt):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(160)
    loweringPlanReleaseAppendText(
        buf,
        "cheng.compiler.lowering.typed_function_dense_store_input")
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocationEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releaseEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalRetainedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalRetainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalReleasedBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveAllocationCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveCapacityBytes)
    let token = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn LoweringTypedFunctionDenseStoreInputAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.typedFunctionDenseStoreInputAllocatorReceiptReady ||
       !plan.typedFunctionDenseStoreInputAllocatorReceiptConsumed ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.typedFunctionDenseStoreInputAllocatorReceipt) ||
       !layout.FixedBytes32Equal(
           plan.typedFunctionDenseStoreInputAllocatorOwnerToken,
           loweringTypedFunctionDenseStoreInputOwnerToken(
               plan.typedFunctionDenseStoreInputAllocatorReceipt)) ||
       LoweringTypedFunctionDenseStoreInputAllocatorPhysicalBufferCount(
           plan) != 0 ||
       LoweringTypedFunctionDenseStoreInputAllocatorCapacityBytes(plan) !=
           int64(0):
        panic("lowering typed dense input: begin before strict consume")
    plan.typedFunctionDenseStoreInputAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.typedFunctionDenseStoreInputAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.typedFunctionDenseStoreInputAllocatorOwnerToken =
        layout.FixedBytes32()
    plan.typedFunctionDenseStoreInputAllocatorReceiptReady = false
    plan.typedFunctionDenseStoreInputAllocatorReceiptConsumed = false

fn LoweringTypedFunctionDenseStoreInputAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.typedFunctionDenseStoreInputAllocatorReceiptReady:
        if LoweringTypedFunctionDenseStoreInputAllocatorPhysicalBufferCount(
               plan) != 0 ||
           LoweringTypedFunctionDenseStoreInputAllocatorCapacityBytes(plan) !=
               int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.typedFunctionDenseStoreInputAllocatorReceipt):
            panic("lowering typed dense input: repeat release drift")
        return
    if plan.typedFunctionDenseStoreInputAllocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           plan.typedFunctionDenseStoreInputAllocatorOwnerToken,
           layout.FixedBytes32()) ||
       !loweringTypedFunctionDenseStoreInputAllocatorMatches(plan):
        panic("lowering typed dense input: allocator/owner drift")
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringTypedFunctionDenseStoreInputAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringTypedFunctionDenseStoreInputAllocatorCapacityBytes(plan)
    var terminalReleasedBytes: int64
    terminalReleasedBytes = terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            plan.typedFunctionDenseStoreInputAllocatorLedger,
            plan.typedFunctionDenseStore.functionNames,
            sizeof(str))
    terminalReleasedBytes = terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            plan.typedFunctionDenseStoreInputAllocatorLedger,
            plan.typedFunctionDenseStore.functionParamCounts,
            sizeof(int32))
    terminalReleasedBytes = terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            plan.typedFunctionDenseStoreInputAllocatorLedger,
            plan.typedFunctionDenseStore.functionResultTypeTags,
            sizeof(int32))
    terminalReleasedBytes = terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            plan.typedFunctionDenseStoreInputAllocatorLedger,
            plan.typedFunctionDenseStore.functionSourcePaths,
            sizeof(str))
    terminalReleasedBytes = terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            plan.typedFunctionDenseStoreInputAllocatorLedger,
            plan.typedFunctionDenseStore.functionBodyKinds,
            sizeof(int32))
    terminalReleasedBytes = terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            plan.typedFunctionDenseStoreInputAllocatorLedger,
            plan.typedFunctionDenseStore.functionEntryFlags,
            sizeof(int32))
    terminalReleasedBytes = terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            plan.typedFunctionDenseStoreInputAllocatorLedger,
            plan.typedFunctionDenseStore.functionTypedIndices,
            sizeof(int32))
    terminalReleasedBytes = terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            plan.typedFunctionDenseStoreInputAllocatorLedger,
            plan.typedFunctionDenseStore.functionParamTypeTags,
            sizeof(int32))
    terminalReleasedBytes = terminalReleasedBytes +
        loweringSequenceAllocatorRelease(
            plan.typedFunctionDenseStoreInputAllocatorLedger,
            plan.typedFunctionDenseStore.functionParamTypeStarts,
            sizeof(int32))
    plan.typedFunctionDenseStoreInputAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.typedFunctionDenseStoreInputAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.typedFunctionDenseStoreInputAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.typedFunctionDenseStoreInputAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.typedFunctionDenseStoreInputAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.typedFunctionDenseStoreInputAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.typedFunctionDenseStoreInputAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringTypedFunctionDenseStoreInputAllocatorPhysicalBufferCount(
            plan) == 0 &&
        LoweringTypedFunctionDenseStoreInputAllocatorCapacityBytes(plan) ==
            int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering typed dense input: receipt incomplete")
    plan.typedFunctionDenseStoreInputAllocatorReceipt = receipt
    plan.typedFunctionDenseStoreInputAllocatorOwnerToken =
        loweringTypedFunctionDenseStoreInputOwnerToken(receipt)
    plan.typedFunctionDenseStoreInputAllocatorReceiptReady = true
    plan.typedFunctionDenseStoreInputAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn loweringTypedFunctionDenseStoreInputAllocatorReceiptMatches(
        plan: var LoweringPlanStub,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    return plan.typedFunctionDenseStoreInputAllocatorReceiptReady &&
           !plan.typedFunctionDenseStoreInputAllocatorReceiptConsumed &&
           LoweringSequenceAllocatorReceiptEqual(
               receipt,
               plan.typedFunctionDenseStoreInputAllocatorReceipt) &&
           LoweringSequenceAllocatorReceiptClosed(receipt) &&
           layout.FixedBytes32Equal(
               plan.typedFunctionDenseStoreInputAllocatorOwnerToken,
               loweringTypedFunctionDenseStoreInputOwnerToken(receipt)) &&
           LoweringTypedFunctionDenseStoreInputAllocatorPhysicalBufferCount(
               plan) == 0 &&
           LoweringTypedFunctionDenseStoreInputAllocatorCapacityBytes(plan) ==
               int64(0)

fn LoweringTypedFunctionDenseStoreInputAllocatorReceiptConsumeStrict(
        plan: var LoweringPlanStub,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    if !loweringTypedFunctionDenseStoreInputAllocatorReceiptMatches(
           plan, receipt):
        return false
    plan.typedFunctionDenseStoreInputAllocatorReceiptConsumed = true
    return true

fn loweringTypedFunctionDenseStoreInputReleaseAndConsumeForRebuild(
        plan: var LoweringPlanStub) =
    LoweringTypedFunctionDenseStoreInputAllocatorRelease(plan)
    let receipt =
        plan.typedFunctionDenseStoreInputAllocatorReceipt
    if !LoweringTypedFunctionDenseStoreInputAllocatorReceiptConsumeStrict(
           plan, receipt):
        panic("lowering typed dense input: rebuild strict consume failed")

fn loweringSequenceAllocatorSetLen(
        owner: var LoweringTypedFunctionIndexBucketTailScratchOwner,
        domain: LoweringTypedFunctionIndexBucketTailScratchLength) =
    if owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed:
        panic("lowering typed index bucket-tail scratch: invalid setLen state")
    loweringSequenceAllocatorSetLen(
        owner.allocatorLedger,
        owner.typedIndexBucketTails,
        domain.length,
        sizeof(int32))

@borrows
fn LoweringTypedFunctionIndexBucketTailScratchPhysicalBufferCount(
        owner: LoweringTypedFunctionIndexBucketTailScratchOwner):
        int32 =
    if owner.typedIndexBucketTails.cap > 0:
        return 1
    return 0

@borrows
fn LoweringTypedFunctionIndexBucketTailScratchCapacityBytes(
        owner: LoweringTypedFunctionIndexBucketTailScratchOwner):
        int64 =
    return int64(owner.typedIndexBucketTails.cap) *
           int64(sizeof(int32))

@borrows
fn loweringTypedFunctionIndexBucketTailScratchOwnerToken(
        receipt: LoweringSequenceAllocatorReceipt):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(128)
    loweringPlanReleaseAppendText(
        buf,
        "cheng.compiler.lowering.typed_function_index_bucket_tail_scratch")
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocationEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releaseEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalRetainedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalRetainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalReleasedBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveAllocationCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveCapacityBytes)
    let token = hash256.Sha256Fixed(
        layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn LoweringTypedFunctionIndexBucketTailScratchReleaseWithReceipt(
        owner: var LoweringTypedFunctionIndexBucketTailScratchOwner,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()) ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(
               LoweringTypedFunctionIndexBucketTailScratchPhysicalBufferCount(
                   owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringTypedFunctionIndexBucketTailScratchCapacityBytes(owner):
        panic("lowering typed index bucket-tail scratch: owner state drift")
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringTypedFunctionIndexBucketTailScratchPhysicalBufferCount(owner)
    receipt.terminalRetainedBytes =
        LoweringTypedFunctionIndexBucketTailScratchCapacityBytes(owner)
    let releasedBytes =
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.typedIndexBucketTails,
            sizeof(int32))
    owner.allocatorLedger.closed = true
    receipt.allocationEventCount =
        owner.allocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        owner.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        owner.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        owner.allocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = releasedBytes
    receipt.liveAllocationCount =
        owner.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        owner.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringTypedFunctionIndexBucketTailScratchPhysicalBufferCount(
            owner) == 0 &&
        LoweringTypedFunctionIndexBucketTailScratchCapacityBytes(owner) ==
            int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering typed index bucket-tail scratch: receipt incomplete")
    owner.allocatorReceipt = receipt
    owner.ownerToken =
        loweringTypedFunctionIndexBucketTailScratchOwnerToken(receipt)
    owner.allocatorReceiptReady = true
    owner.allocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringTypedFunctionIndexBucketTailScratchReceiptConsumeStrict(
        owner: var LoweringTypedFunctionIndexBucketTailScratchOwner,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    if !owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt, owner.allocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !layout.FixedBytes32Equal(
           owner.ownerToken,
           loweringTypedFunctionIndexBucketTailScratchOwnerToken(receipt)) ||
       LoweringTypedFunctionIndexBucketTailScratchPhysicalBufferCount(
           owner) != 0 ||
       LoweringTypedFunctionIndexBucketTailScratchCapacityBytes(owner) !=
           int64(0):
        return false
    owner.allocatorReceiptConsumed = true
    return true

fn LoweringTypedFunctionIndexBucketTailScratchClose(
        owner: var LoweringTypedFunctionIndexBucketTailScratchOwner) =
    var receipt: LoweringSequenceAllocatorReceipt
    LoweringTypedFunctionIndexBucketTailScratchReleaseWithReceipt(
        owner, receipt)
    if !LoweringTypedFunctionIndexBucketTailScratchReceiptConsumeStrict(
           owner, receipt):
        panic("lowering typed index bucket-tail scratch: strict consume failed")

fn LoweringBuildTypedFunctionIndex(plan: var LoweringPlanStub) =
    LoweringPlanReleaseTypedFunctionLookupSidecarPayload(plan)
    loweringTypedFunctionDenseStoreInputReleaseAndConsumeForRebuild(plan)
    dense.DenseStoreRelease(plan.typedFunctionDenseStore)
    LoweringTypedFunctionDenseStoreInputAllocatorBegin(plan)
    plan.typedFunctionDenseStore = dense.DenseStoreNew()
    LoweringTypedFunctionIndexAllocatorBegin(plan)
    LoweringResetTypedFunctionIndexCounters(plan)
    let functionCount = plan.typedIr.functions2_functionNameIds.len
    var functionNames: str[]
    var functionParamCounts: int32[]
    var functionResultTypeTags: int32[]
    var functionSourcePaths: str[]
    var functionBodyKinds: int32[]
    var functionEntryFlags: int32[]
    var functionTypedIndices: int32[]
    var functionParamTypeTags: int32[]
    var functionParamTypeStarts: int32[]
    let sourceBucketCount = LoweringTypedFunctionIndexBucketCount(functionCount)
    for bucketIndex in 0..<sourceBucketCount:
        LoweringTypedFunctionIndexAppendSourceBuckets(plan, -1)
    let typedIndexBucketCount = LoweringTypedFunctionIndexBucketCount(functionCount * 2)
    for bucketIndex in 0..<typedIndexBucketCount:
        LoweringTypedFunctionIndexAppendFunctionBucket(plan, -1)
    var bucketTailScratch: LoweringTypedFunctionIndexBucketTailScratchOwner
    loweringSequenceAllocatorSetLen(
        bucketTailScratch,
        LoweringTypedFunctionIndexBucketTailScratchLength(
            length: typedIndexBucketCount))
    for bucketIndex in
            0..<bucketTailScratch.typedIndexBucketTails.len:
        bucketTailScratch.typedIndexBucketTails[bucketIndex] = -1
    LoweringSequenceAllocatorSetLen(
        plan,
        functionNames,
        LoweringTypedDenseFunctionNameLength(length: functionCount))
    LoweringSequenceAllocatorSetLen(
        plan,
        functionParamCounts,
        LoweringTypedDenseParamCountLength(length: functionCount))
    LoweringSequenceAllocatorSetLen(
        plan,
        functionResultTypeTags,
        LoweringTypedDenseResultTypeLength(length: functionCount))
    LoweringSequenceAllocatorSetLen(
        plan,
        functionSourcePaths,
        LoweringTypedDenseSourcePathLength(length: functionCount))
    LoweringSequenceAllocatorSetLen(
        plan,
        functionBodyKinds,
        LoweringTypedDenseBodyKindLength(length: functionCount))
    LoweringSequenceAllocatorSetLen(
        plan,
        functionEntryFlags,
        LoweringTypedDenseEntryFlagLength(length: functionCount))
    LoweringSequenceAllocatorSetLen(
        plan,
        functionTypedIndices,
        LoweringTypedDenseTypedIndexLength(length: functionCount))
    LoweringSequenceAllocatorSetLen(
        plan,
        functionParamTypeStarts,
        LoweringTypedDenseParamTypeStartLength(length: functionCount + 1))
    for functionIndex in 0..<plan.typedIr.functions2_functionNameIds.len:
        let fnNameRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_functionNameIds[functionIndex])
        let fnReturnTypeRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_returnTypeIds[functionIndex])
        let fnSourceRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_sourcePathIds[functionIndex])
        if !IsOk(fnNameRes) || !IsOk(fnReturnTypeRes) || !IsOk(fnSourceRes):
            LoweringTypedFunctionIndexBucketTailScratchClose(
                bucketTailScratch)
            panic(Fmt"lowering typed function index: function intern missing index={functionIndex}")
        let fnName = Value(fnNameRes)
        let fnReturnType = Value(fnReturnTypeRes)
        let fnSource = Value(fnSourceRes)
        functionNames[functionIndex] = share(fnName)
        functionParamCounts[functionIndex] = 0
        functionResultTypeTags[functionIndex] = dense.DenseStoreResultTypeTagFromTypeText(fnReturnType)
        functionSourcePaths[functionIndex] = LoweringDenseStoreSourceKey(fnSource)
        functionBodyKinds[functionIndex] = dense.DenseStoreBodyKindTypedTag()
        functionEntryFlags[functionIndex] = 0
        if functionIndex == plan.sourceEntryTypedFunctionIndex:
            functionEntryFlags[functionIndex] = dense.DenseEntryIsEntryFlag
        functionTypedIndices[functionIndex] = functionIndex
        functionParamTypeStarts[functionIndex] = 0
        let sourceCountBefore = plan.typedFunctionIndexSourcePaths.len
        let sourceIndex = LoweringTypedFunctionIndexFindOrAddSource(plan, fnSource)
        if sourceIndex >= 0:
            if plan.typedFunctionIndexSourcePaths.len > sourceCountBefore:
                LoweringTypedFunctionIndexAddSourceSuffixes(
                    plan,
                    sourceIndex,
                    plan.typedFunctionIndexSourcePaths[sourceIndex])
            LoweringBuildTypedFunctionIndexAdd(plan,
                                               bucketTailScratch.typedIndexBucketTails,
                                               sourceIndex,
                                               fnName,
                                               functionIndex)
        else:
            LoweringTypedFunctionIndexBucketTailScratchClose(
                bucketTailScratch)
            panic(Fmt"lowering typed function index: source invalid index={functionIndex} source={fnSource}")
        plan.typedFunctionIndexBuildFunctionCount =
            plan.typedFunctionIndexBuildFunctionCount + 1
    LoweringTypedFunctionIndexBucketTailScratchClose(
        bucketTailScratch)
    functionParamTypeStarts[functionCount] = 0
    var store = dense.DenseStoreNew()
    dense.DenseStoreBuildFromFunctionArrays(store,
                                            functionNames,
                                            functionParamCounts,
                                            functionResultTypeTags,
                                            functionSourcePaths,
                                            functionBodyKinds,
                                            functionEntryFlags,
                                            functionTypedIndices,
                                            functionParamTypeTags,
                                            functionParamTypeStarts)
    plan.typedFunctionDenseStore = store
    if !loweringTypedFunctionDenseStoreInputAllocatorMatches(plan):
        panic("lowering typed dense input: transfer drift")
    plan.typedFunctionIndexSourceCountSnapshot =
        plan.typedFunctionIndexSourcePaths.len
    plan.typedFunctionIndexEntryCountSnapshot =
        plan.typedFunctionIndexEntryIndexes.len
    plan.typedFunctionIndexBuilt = true
    plan.typedFunctionIndexCompleted = true
    plan.typedFunctionIndexPeakSidecarCapacityEstimateBytes =
        LoweringTypedFunctionLookupSidecarCapacityEstimateBytes(plan)

@borrows
fn LoweringFunctionDenseStoreInputAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.functionDenseStore.functionParamCounts.cap > 0:
        count = count + 1
    if plan.functionDenseStore.functionResultTypeTags.cap > 0:
        count = count + 1
    if plan.functionDenseStore.functionSourcePaths.cap > 0:
        count = count + 1
    if plan.functionDenseStore.functionBodyKinds.cap > 0:
        count = count + 1
    if plan.functionDenseStore.functionEntryFlags.cap > 0:
        count = count + 1
    if plan.functionDenseStore.functionTypedIndices.cap > 0:
        count = count + 1
    if plan.functionDenseStore.functionParamTypeStarts.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringFunctionDenseStoreInputAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(
               plan.functionDenseStore.functionParamCounts.cap) *
               int64(sizeof(int32)) +
           int64(
               plan.functionDenseStore.functionResultTypeTags.cap) *
               int64(sizeof(int32)) +
           int64(
               plan.functionDenseStore.functionSourcePaths.cap) *
               int64(sizeof(str)) +
           int64(
               plan.functionDenseStore.functionBodyKinds.cap) *
               int64(sizeof(int32)) +
           int64(
               plan.functionDenseStore.functionEntryFlags.cap) *
               int64(sizeof(int32)) +
           int64(
               plan.functionDenseStore.functionTypedIndices.cap) *
               int64(sizeof(int32)) +
           int64(
               plan.functionDenseStore.functionParamTypeStarts.cap) *
               int64(sizeof(int32))

@borrows
fn loweringFunctionDenseStoreInputAllocatorMatches(
        plan: LoweringPlanStub): bool =
    return plan.functionDenseStoreInputAllocatorLedger.liveAllocationCount ==
               int64(
                   LoweringFunctionDenseStoreInputAllocatorPhysicalBufferCount(
                       plan)) &&
           plan.functionDenseStoreInputAllocatorLedger.liveCapacityBytes ==
               LoweringFunctionDenseStoreInputAllocatorCapacityBytes(plan)

fn LoweringFunctionDenseStoreInputAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.functionDenseStoreInputAllocatorReceiptReady ||
       LoweringFunctionDenseStoreInputAllocatorPhysicalBufferCount(plan) !=
           0 ||
       LoweringFunctionDenseStoreInputAllocatorCapacityBytes(plan) !=
           int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.functionDenseStoreInputAllocatorReceipt):
        panic("lowering function dense store input: begin before release")
    plan.functionDenseStoreInputAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.functionDenseStoreInputAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.functionDenseStoreInputAllocatorReceiptReady = false

fn loweringFunctionDenseStoreInputRecordTerminalRelease(
        plan: var LoweringPlanStub,
        retainedCapacity: int32,
        elementBytes: int32): int64 =
    if plan.functionDenseStoreInputAllocatorLedger.closed ||
       retainedCapacity < 0 ||
       elementBytes <= 0:
        panic("lowering function dense store input: invalid terminal release")
    if retainedCapacity == 0:
        return int64(0)
    let releasedBytes =
        int64(retainedCapacity) * int64(elementBytes)
    if plan.functionDenseStoreInputAllocatorLedger.liveAllocationCount <=
           int64(0) ||
       plan.functionDenseStoreInputAllocatorLedger.liveCapacityBytes <
           releasedBytes:
        panic("lowering function dense store input: terminal release underflow")
    plan.functionDenseStoreInputAllocatorLedger.releaseEventCount =
        plan.functionDenseStoreInputAllocatorLedger.releaseEventCount +
        int64(1)
    plan.functionDenseStoreInputAllocatorLedger.releasedCapacityBytes =
        plan.functionDenseStoreInputAllocatorLedger.releasedCapacityBytes +
        releasedBytes
    plan.functionDenseStoreInputAllocatorLedger.liveAllocationCount =
        plan.functionDenseStoreInputAllocatorLedger.liveAllocationCount -
        int64(1)
    plan.functionDenseStoreInputAllocatorLedger.liveCapacityBytes =
        plan.functionDenseStoreInputAllocatorLedger.liveCapacityBytes -
        releasedBytes
    return releasedBytes

fn loweringFunctionDenseStoreInputReleaseParamCounts(
        plan: var LoweringPlanStub): int64 =
    let retainedCapacity =
        plan.functionDenseStore.functionParamCounts.cap
    let releasedBytes =
        loweringFunctionDenseStoreInputRecordTerminalRelease(
            plan, retainedCapacity, sizeof(int32))
    seqs.freeSeq(plan.functionDenseStore.functionParamCounts)
    if plan.functionDenseStore.functionParamCounts.len != 0 ||
       plan.functionDenseStore.functionParamCounts.cap != 0 ||
       plan.functionDenseStore.functionParamCounts.buffer != nil:
        panic("lowering function dense store input: param count release failed")
    return releasedBytes

fn loweringFunctionDenseStoreInputReleaseResultTags(
        plan: var LoweringPlanStub): int64 =
    let retainedCapacity =
        plan.functionDenseStore.functionResultTypeTags.cap
    let releasedBytes =
        loweringFunctionDenseStoreInputRecordTerminalRelease(
            plan, retainedCapacity, sizeof(int32))
    seqs.freeSeq(plan.functionDenseStore.functionResultTypeTags)
    if plan.functionDenseStore.functionResultTypeTags.len != 0 ||
       plan.functionDenseStore.functionResultTypeTags.cap != 0 ||
       plan.functionDenseStore.functionResultTypeTags.buffer != nil:
        panic("lowering function dense store input: result tag release failed")
    return releasedBytes

fn loweringFunctionDenseStoreInputReleaseSourcePaths(
        plan: var LoweringPlanStub): int64 =
    let retainedCapacity =
        plan.functionDenseStore.functionSourcePaths.cap
    let releasedBytes =
        loweringFunctionDenseStoreInputRecordTerminalRelease(
            plan, retainedCapacity, sizeof(str))
    seqs.freeSeqStrRelease(
        plan.functionDenseStore.functionSourcePaths)
    if plan.functionDenseStore.functionSourcePaths.len != 0 ||
       plan.functionDenseStore.functionSourcePaths.cap != 0 ||
       plan.functionDenseStore.functionSourcePaths.buffer != nil:
        panic("lowering function dense store input: source path release failed")
    return releasedBytes

fn loweringFunctionDenseStoreInputReleaseBodyKinds(
        plan: var LoweringPlanStub): int64 =
    let retainedCapacity =
        plan.functionDenseStore.functionBodyKinds.cap
    let releasedBytes =
        loweringFunctionDenseStoreInputRecordTerminalRelease(
            plan, retainedCapacity, sizeof(int32))
    seqs.freeSeq(plan.functionDenseStore.functionBodyKinds)
    if plan.functionDenseStore.functionBodyKinds.len != 0 ||
       plan.functionDenseStore.functionBodyKinds.cap != 0 ||
       plan.functionDenseStore.functionBodyKinds.buffer != nil:
        panic("lowering function dense store input: body kind release failed")
    return releasedBytes

fn loweringFunctionDenseStoreInputReleaseEntryFlags(
        plan: var LoweringPlanStub): int64 =
    let retainedCapacity =
        plan.functionDenseStore.functionEntryFlags.cap
    let releasedBytes =
        loweringFunctionDenseStoreInputRecordTerminalRelease(
            plan, retainedCapacity, sizeof(int32))
    seqs.freeSeq(plan.functionDenseStore.functionEntryFlags)
    if plan.functionDenseStore.functionEntryFlags.len != 0 ||
       plan.functionDenseStore.functionEntryFlags.cap != 0 ||
       plan.functionDenseStore.functionEntryFlags.buffer != nil:
        panic("lowering function dense store input: entry flag release failed")
    return releasedBytes

fn loweringFunctionDenseStoreInputReleaseTypedIndices(
        plan: var LoweringPlanStub): int64 =
    let retainedCapacity =
        plan.functionDenseStore.functionTypedIndices.cap
    let releasedBytes =
        loweringFunctionDenseStoreInputRecordTerminalRelease(
            plan, retainedCapacity, sizeof(int32))
    seqs.freeSeq(plan.functionDenseStore.functionTypedIndices)
    if plan.functionDenseStore.functionTypedIndices.len != 0 ||
       plan.functionDenseStore.functionTypedIndices.cap != 0 ||
       plan.functionDenseStore.functionTypedIndices.buffer != nil:
        panic("lowering function dense store input: typed index release failed")
    return releasedBytes

fn loweringFunctionDenseStoreInputReleaseParamTypeStarts(
        plan: var LoweringPlanStub): int64 =
    let retainedCapacity =
        plan.functionDenseStore.functionParamTypeStarts.cap
    let releasedBytes =
        loweringFunctionDenseStoreInputRecordTerminalRelease(
            plan, retainedCapacity, sizeof(int32))
    seqs.freeSeq(plan.functionDenseStore.functionParamTypeStarts)
    if plan.functionDenseStore.functionParamTypeStarts.len != 0 ||
       plan.functionDenseStore.functionParamTypeStarts.cap != 0 ||
       plan.functionDenseStore.functionParamTypeStarts.buffer != nil:
        panic("lowering function dense store input: param start release failed")
    return releasedBytes

fn LoweringFunctionDenseStoreInputAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.functionDenseStoreInputAllocatorReceiptReady:
        if LoweringFunctionDenseStoreInputAllocatorPhysicalBufferCount(
               plan) != 0 ||
           LoweringFunctionDenseStoreInputAllocatorCapacityBytes(plan) !=
               int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.functionDenseStoreInputAllocatorReceipt):
            panic("lowering function dense store input: repeat release drift")
        return
    if !loweringFunctionDenseStoreInputAllocatorMatches(plan):
        panic("lowering function dense store input: allocator/owner drift")
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringFunctionDenseStoreInputAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringFunctionDenseStoreInputAllocatorCapacityBytes(plan)
    var terminalReleasedBytes: int64
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringFunctionDenseStoreInputReleaseParamCounts(plan)
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringFunctionDenseStoreInputReleaseResultTags(plan)
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringFunctionDenseStoreInputReleaseSourcePaths(plan)
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringFunctionDenseStoreInputReleaseBodyKinds(plan)
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringFunctionDenseStoreInputReleaseEntryFlags(plan)
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringFunctionDenseStoreInputReleaseTypedIndices(plan)
    terminalReleasedBytes =
        terminalReleasedBytes +
        loweringFunctionDenseStoreInputReleaseParamTypeStarts(plan)
    plan.functionDenseStoreInputAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.functionDenseStoreInputAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.functionDenseStoreInputAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.functionDenseStoreInputAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.functionDenseStoreInputAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.functionDenseStoreInputAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.functionDenseStoreInputAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringFunctionDenseStoreInputAllocatorPhysicalBufferCount(plan) ==
            0 &&
        LoweringFunctionDenseStoreInputAllocatorCapacityBytes(plan) ==
            int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering function dense store input: receipt incomplete")
    plan.functionDenseStoreInputAllocatorReceipt = receipt
    plan.functionDenseStoreInputAllocatorReceiptReady = true
    plan.functionDenseStoreInputAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringBuildFunctionDenseStore(plan: var LoweringPlanStub) =
    LoweringFunctionDenseStoreInputAllocatorRelease(plan)
    dense.DenseStoreRelease(plan.functionDenseStore)
    LoweringFunctionDenseStoreInputAllocatorBegin(plan)
    plan.functionDenseStore = dense.DenseStoreNew()
    let functionCount = plan.functionNames.len
    var functionParamCounts: int32[]
    var functionResultTypeTags: int32[]
    var functionSourcePaths: str[]
    var functionBodyKinds: int32[]
    var functionEntryFlags: int32[]
    var functionTypedIndices: int32[]
    var functionParamTypeTags: int32[]
    var functionParamTypeStarts: int32[]
    loweringSequenceAllocatorSetLen(
        plan.functionDenseStoreInputAllocatorLedger,
        functionParamCounts,
        functionCount,
        sizeof(int32))
    loweringSequenceAllocatorSetLen(
        plan.functionDenseStoreInputAllocatorLedger,
        functionResultTypeTags,
        functionCount,
        sizeof(int32))
    loweringSequenceAllocatorSetLen(
        plan.functionDenseStoreInputAllocatorLedger,
        functionSourcePaths,
        functionCount,
        sizeof(str))
    loweringSequenceAllocatorSetLen(
        plan.functionDenseStoreInputAllocatorLedger,
        functionBodyKinds,
        functionCount,
        sizeof(int32))
    loweringSequenceAllocatorSetLen(
        plan.functionDenseStoreInputAllocatorLedger,
        functionEntryFlags,
        functionCount,
        sizeof(int32))
    loweringSequenceAllocatorSetLen(
        plan.functionDenseStoreInputAllocatorLedger,
        functionTypedIndices,
        functionCount,
        sizeof(int32))
    loweringSequenceAllocatorSetLen(
        plan.functionDenseStoreInputAllocatorLedger,
        functionParamTypeStarts,
        functionCount + 1,
        sizeof(int32))
    for functionIndex in 0..<functionCount:
        functionParamCounts[functionIndex] = 0
        functionResultTypeTags[functionIndex] = dense.DenseStoreResultTypeTagInvalid()
        if functionIndex < plan.functionSourcePaths.len:
            functionSourcePaths[functionIndex] = LoweringDenseStoreSourceKey(plan.functionSourcePaths[functionIndex])
        functionBodyKinds[functionIndex] = dense.DenseStoreBodyKindTypedTag()
        if functionIndex < plan.functionEntryFlags.len:
            functionEntryFlags[functionIndex] = plan.functionEntryFlags[functionIndex]
        functionTypedIndices[functionIndex] = functionIndex
        functionParamTypeStarts[functionIndex] = 0
    functionParamTypeStarts[functionCount] = 0
    var store = dense.DenseStoreNew()
    dense.DenseStoreBuildFromFunctionArrays(store,
                                            share(plan.functionNames),
                                            functionParamCounts,
                                            functionResultTypeTags,
                                            functionSourcePaths,
                                            functionBodyKinds,
                                            functionEntryFlags,
                                            functionTypedIndices,
                                            functionParamTypeTags,
                                            functionParamTypeStarts)
    plan.functionDenseStore = store
    if !loweringFunctionDenseStoreInputAllocatorMatches(plan):
        panic("lowering function dense store input: transfer drift")

@borrows
fn LoweringDenseStoreSourceKey(sourcePathRaw: str): str =
    var sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let cwd = parser.ParserNormalizePath(chengpath.PathCurrentDir())
    let cwdPrefix = strutil.Join([strings.CloneStr(cwd), "/"], "")
    if cwd != "" && parser.ParserStartsWithExact(sourcePath, cwdPrefix):
        sourcePath = chengpath.TextSlice(sourcePath, cwdPrefix.len, sourcePath.len - cwdPrefix.len)
    while parser.ParserStartsWithExact(sourcePath, "./"):
        sourcePath = chengpath.TextSlice(sourcePath, 2, sourcePath.len - 2)
    while chengpath.TextContains(sourcePath, "/./"):
        let pos = parser.ParserFindText(sourcePath, "/./")
        if pos < 0:
            break
        sourcePath = strutil.Join([chengpath.TextSlice(sourcePath, 0, pos + 1),
                                   chengpath.TextSlice(sourcePath, pos + 3, sourcePath.len - pos - 3)], "")
    return sourcePath

@borrows
fn LoweringPlanTypedIrFunctionIndexByName(plan: LoweringPlanStub,
                                           sourcePath: str,
                                           functionName: str): int32 =
    if len(functionName) <= 0:
        return -1
    let denseIndex = dense.DenseStoreFindFunctionInSourceReadonly(plan.typedFunctionDenseStore,
                                                                  LoweringDenseStoreSourceKey(sourcePath),
                                                                  functionName)
    if denseIndex >= 0 && denseIndex < plan.typedIr.functions2_functionNameIds.len:
        return denseIndex
    let indexedIndex = LoweringTypedFunctionIndexLookup(plan, sourcePath, functionName)
    if indexedIndex >= 0 && indexedIndex < plan.typedIr.functions2_functionNameIds.len:
        return indexedIndex
    return -1

@borrows
fn LoweringPlanTypedIrFunctionIndex(plan: LoweringPlanStub,
                                     sourcePath: str,
                                     functionName: str): int32 =
    return LoweringPlanTypedIrFunctionIndexByName(plan, sourcePath, functionName)

@borrows
fn LoweringPlanTypedIrFunctionIndexAtLine(plan: var LoweringPlanStub,
                                           sourcePath: str,
                                           functionName: str,
                                           signatureLineNumber: int32): int32 =
    if signatureLineNumber <= 0:
        return -1
    let indexedIndex = LoweringTypedFunctionIndexLookupAtLine(plan,
                                                              sourcePath,
                                                              functionName,
                                                              signatureLineNumber)
    if indexedIndex >= 0 && indexedIndex < plan.typedIr.functions2_functionNameIds.len:
        return indexedIndex
    return -1

@borrows
fn LoweringTypedIrFunctionHasOpKind(ir: texpr.TypedExprIr,
                                     fnIndex: int32,
                                     opKind: texpr.TypedExprIrOpKind): bool =
    if fnIndex < 0 || fnIndex >= ir.functions2_functionNameIds.len:
        return false
    let fnIr = texpr.TypedExprIrFunction(
        sourcePath: Value(langintern.LookupIntern(ir.internPool, ir.functions2_sourcePathIds[fnIndex])),
        functionName: Value(langintern.LookupIntern(ir.internPool, ir.functions2_functionNameIds[fnIndex])),
        signatureLineNumber: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_signatureLineNumbers, fnIndex),
        endLineNumber: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_endLineNumbers, fnIndex),
        bodyLineNumber: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_bodyLineNumbers, fnIndex),
        returnType: Value(langintern.LookupIntern(ir.internPool, ir.functions2_returnTypeIds[fnIndex])),
        resultExprClass: ir.functions2_resultExprClasses[fnIndex],
        returnExpr: Value(langintern.LookupIntern(ir.internPool, ir.functions2_returnExprIds[fnIndex])),
        statementStart: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_statementStarts, fnIndex),
        statementCount: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_statementCounts, fnIndex),
        nodeStart: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_nodeStarts, fnIndex),
        nodeCount: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_nodeCounts, fnIndex),
        returnNodeIndex: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_returnNodeIndexs, fnIndex),
    )
    var nodeEnd = fnIr.nodeStart + fnIr.nodeCount
    if nodeEnd > ir.nodes2_nodeIndexs.len:
        nodeEnd = ir.nodes2_nodeIndexs.len
    for nodeIndex in fnIr.nodeStart..<nodeEnd:
        if ir.nodes2_opKinds[nodeIndex] == opKind:
            return true
    return false

@borrows
fn LoweringPrimaryObjectIrLeafBodyKindFromTypedIrIndex(ir: texpr.TypedExprIr,
                                                        fnIndex: int32,
                                                        bodyLineNumber: var int32): str =
    if fnIndex < 0:
        bodyLineNumber = 0
        return texpr.BodyKindUnsupported
    let fnIr = texpr.TypedExprIrFunction(
        sourcePath: Value(langintern.LookupIntern(ir.internPool, ir.functions2_sourcePathIds[fnIndex])),
        functionName: Value(langintern.LookupIntern(ir.internPool, ir.functions2_functionNameIds[fnIndex])),
        signatureLineNumber: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_signatureLineNumbers, fnIndex),
        endLineNumber: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_endLineNumbers, fnIndex),
        bodyLineNumber: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_bodyLineNumbers, fnIndex),
        returnType: Value(langintern.LookupIntern(ir.internPool, ir.functions2_returnTypeIds[fnIndex])),
        resultExprClass: ir.functions2_resultExprClasses[fnIndex],
        returnExpr: Value(langintern.LookupIntern(ir.internPool, ir.functions2_returnExprIds[fnIndex])),
        statementStart: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_statementStarts, fnIndex),
        statementCount: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_statementCounts, fnIndex),
        nodeStart: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_nodeStarts, fnIndex),
        nodeCount: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_nodeCounts, fnIndex),
        returnNodeIndex: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_returnNodeIndexs, fnIndex),
    )
    bodyLineNumber = fnIr.bodyLineNumber
    if fnIr.statementCount > 0:
        return texpr.BodyKindUnsupported
    if fnIr.returnNodeIndex >= 0 && fnIr.returnNodeIndex < ir.nodes2_nodeIndexs.len:
        let returnKind = LoweringPrimaryObjectIrBodyKindFromTypedIrOp(ir, fnIr.returnNodeIndex)
        if returnKind != texpr.BodyKindUnsupported:
            return returnKind
    return texpr.BodyKindUnsupported

@borrows
fn LoweringTypedIrFunctionIsVoidReturn(ir: texpr.TypedExprIr,
                                        fnIndex: int32): bool =
    if fnIndex < 0 || fnIndex >= ir.functions2_functionNameIds.len:
        return false
    let fnIr = texpr.TypedExprIrFunction(
        sourcePath: Value(langintern.LookupIntern(ir.internPool, ir.functions2_sourcePathIds[fnIndex])),
        functionName: Value(langintern.LookupIntern(ir.internPool, ir.functions2_functionNameIds[fnIndex])),
        signatureLineNumber: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_signatureLineNumbers, fnIndex),
        endLineNumber: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_endLineNumbers, fnIndex),
        bodyLineNumber: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_bodyLineNumbers, fnIndex),
        returnType: Value(langintern.LookupIntern(ir.internPool, ir.functions2_returnTypeIds[fnIndex])),
        resultExprClass: ir.functions2_resultExprClasses[fnIndex],
        returnExpr: Value(langintern.LookupIntern(ir.internPool, ir.functions2_returnExprIds[fnIndex])),
        statementStart: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_statementStarts, fnIndex),
        statementCount: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_statementCounts, fnIndex),
        nodeStart: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_nodeStarts, fnIndex),
        nodeCount: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_nodeCounts, fnIndex),
        returnNodeIndex: arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_returnNodeIndexs, fnIndex),
    )
    if fnIr.returnType != "" && fnIr.returnType != "void":
        return false
    if fnIr.returnExpr == "return":
        return true
    if fnIr.returnExpr == "" &&
       fnIr.statementCount <= 0 &&
       fnIr.nodeCount <= 0:
        return true
    return false

fn LoweringResolvedCallFactIndexBucketCount(factCount: int32): int32 =
    var need = factCount * 2 + 16
    if need < 16:
        need = 16
    var out = 1
    while out < need:
        out = out * 2
    return out

@borrows
fn LoweringResolvedCallSnapshotRowCount(plan: LoweringPlanStub): int32 =
    return plan.resolvedCallSnapshot.sourcePathIds.len

@borrows
fn LoweringResolvedCallTargetTypedFunctionIndexAt(
        plan: LoweringPlanStub,
        resolvedCallRow: int32): int32 =
    if resolvedCallRow < 0 ||
       resolvedCallRow >=
           plan.resolvedCallTargetTypedFunctionIndexes.len:
        panic(
            "lowering plan: resolved-call target TypedExpr row out of range")
    return plan.resolvedCallTargetTypedFunctionIndexes[resolvedCallRow]

fn loweringSequenceAllocatorSetLen(
        owner: var LoweringResolvedCallTargetGraphScratchOwner,
        domain: LoweringResolvedCallTargetGraphScratchLength) =
    if owner.allocatorLedger.closed ||
       owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       domain.length < 0:
        panic("lowering resolved-call target scratch: invalid setLen request")
    let beforeCapacity =
        owner.typedFunctionIndexByGraphNodeId.cap
    setLen(
        owner.typedFunctionIndexByGraphNodeId,
        domain.length)
    if owner.typedFunctionIndexByGraphNodeId.cap < beforeCapacity ||
       (owner.typedFunctionIndexByGraphNodeId.cap > 0 &&
        owner.typedFunctionIndexByGraphNodeId.buffer == nil):
        panic("lowering resolved-call target scratch: invalid setLen result")
    if owner.typedFunctionIndexByGraphNodeId.cap > beforeCapacity:
        loweringSequenceAllocatorRecordGrowth(
            owner.allocatorLedger,
            beforeCapacity,
            owner.typedFunctionIndexByGraphNodeId.cap,
            sizeof(int32))

@borrows
fn LoweringResolvedCallTargetGraphScratchPhysicalBufferCount(
        owner: LoweringResolvedCallTargetGraphScratchOwner): int32 =
    if owner.typedFunctionIndexByGraphNodeId.cap > 0:
        return 1
    return 0

@borrows
fn LoweringResolvedCallTargetGraphScratchCapacityBytes(
        owner: LoweringResolvedCallTargetGraphScratchOwner): int64 =
    return int64(
               owner.typedFunctionIndexByGraphNodeId.cap) *
           int64(sizeof(int32))

@borrows
fn loweringResolvedCallTargetGraphScratchOwnerToken(
        receipt: LoweringSequenceAllocatorReceipt):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(128)
    loweringPlanReleaseAppendText(
        buf,
        "cheng.compiler.lowering.resolved_call_target_graph_scratch")
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocationEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releaseEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalRetainedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalRetainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalReleasedBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveAllocationCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveCapacityBytes)
    let token = hash256.Sha256Fixed(
        layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn LoweringResolvedCallTargetGraphScratchReleaseWithReceipt(
        owner: var LoweringResolvedCallTargetGraphScratchOwner,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()) ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(
               LoweringResolvedCallTargetGraphScratchPhysicalBufferCount(
                   owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringResolvedCallTargetGraphScratchCapacityBytes(owner):
        panic("lowering resolved-call target scratch: owner state drift")
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringResolvedCallTargetGraphScratchPhysicalBufferCount(owner)
    receipt.terminalRetainedBytes =
        LoweringResolvedCallTargetGraphScratchCapacityBytes(owner)
    let releasedBytes =
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.typedFunctionIndexByGraphNodeId,
            sizeof(int32))
    owner.allocatorLedger.closed = true
    receipt.allocationEventCount =
        owner.allocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        owner.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        owner.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        owner.allocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = releasedBytes
    receipt.liveAllocationCount =
        owner.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        owner.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringResolvedCallTargetGraphScratchPhysicalBufferCount(owner) ==
            0 &&
        LoweringResolvedCallTargetGraphScratchCapacityBytes(owner) ==
            int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering resolved-call target scratch: receipt incomplete")
    owner.allocatorReceipt = receipt
    owner.ownerToken =
        loweringResolvedCallTargetGraphScratchOwnerToken(receipt)
    owner.allocatorReceiptReady = true
    owner.allocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringResolvedCallTargetGraphScratchReceiptConsumeStrict(
        owner: var LoweringResolvedCallTargetGraphScratchOwner,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    if !owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt, owner.allocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !layout.FixedBytes32Equal(
           owner.ownerToken,
           loweringResolvedCallTargetGraphScratchOwnerToken(receipt)) ||
       LoweringResolvedCallTargetGraphScratchPhysicalBufferCount(owner) !=
           0 ||
       LoweringResolvedCallTargetGraphScratchCapacityBytes(owner) !=
           int64(0):
        return false
    owner.allocatorReceiptConsumed = true
    return true

fn LoweringResolvedCallTargetGraphScratchClose(
        owner: var LoweringResolvedCallTargetGraphScratchOwner) =
    var receipt: LoweringSequenceAllocatorReceipt
    LoweringResolvedCallTargetGraphScratchReleaseWithReceipt(
        owner, receipt)
    if !LoweringResolvedCallTargetGraphScratchReceiptConsumeStrict(
           owner, receipt):
        panic("lowering resolved-call target scratch: strict consume failed")

@borrows
fn LoweringResolvedCallTargetProjectionReceiptEqual(
        lhs: LoweringResolvedCallTargetProjectionReceipt,
        rhs: LoweringResolvedCallTargetProjectionReceipt): bool =
    return lhs.begun == rhs.begun &&
           lhs.movedToPlan == rhs.movedToPlan &&
           lhs.expectedItemCount == rhs.expectedItemCount &&
           lhs.categoryId == rhs.categoryId &&
           lhs.builderOwnerId == rhs.builderOwnerId &&
           lhs.planOwnerId == rhs.planOwnerId &&
           lhs.objectId == rhs.objectId &&
           lhs.reservedCapacity == rhs.reservedCapacity &&
           lhs.retainedBufferCount == rhs.retainedBufferCount &&
           lhs.retainedBytes == rhs.retainedBytes &&
           lhs.physicalFreeCount == rhs.physicalFreeCount &&
           lhs.physicalFreedBytes == rhs.physicalFreedBytes &&
           lhs.allocated == rhs.allocated &&
           lhs.released == rhs.released &&
           lhs.live == rhs.live &&
           lhs.allocatedBytes == rhs.allocatedBytes &&
           lhs.releasedBytes == rhs.releasedBytes &&
           lhs.liveBytes == rhs.liveBytes &&
           lhs.ownerTransferCount == rhs.ownerTransferCount &&
           lhs.retained == rhs.retained &&
           lhs.borrowReturnCount == rhs.borrowReturnCount &&
           lhs.ledgerStorageReleasedSequenceCount ==
               rhs.ledgerStorageReleasedSequenceCount &&
           lhs.ledgerStorageReleasedBufferCount ==
               rhs.ledgerStorageReleasedBufferCount &&
           lhs.ledgerStorageReleasedBytes ==
               rhs.ledgerStorageReleasedBytes &&
           lhs.ledgerStorageReleased ==
               rhs.ledgerStorageReleased &&
           lhs.storageReleased == rhs.storageReleased

@borrows
fn LoweringResolvedCallTargetProjectionReceiptClosed(
        receipt: LoweringResolvedCallTargetProjectionReceipt): bool =
    if !receipt.begun:
        return !receipt.movedToPlan &&
               receipt.expectedItemCount == 0 &&
               receipt.categoryId == 0 &&
               receipt.builderOwnerId == 0 &&
               receipt.planOwnerId == 0 &&
               receipt.objectId == 0 &&
               receipt.reservedCapacity == 0 &&
               receipt.retainedBufferCount == 0 &&
               receipt.retainedBytes == int64(0) &&
               receipt.physicalFreeCount == 0 &&
               receipt.physicalFreedBytes == int64(0) &&
               receipt.allocated == int64(0) &&
               receipt.released == int64(0) &&
               receipt.live == int64(0) &&
               receipt.allocatedBytes == int64(0) &&
               receipt.releasedBytes == int64(0) &&
               receipt.liveBytes == int64(0) &&
               receipt.ownerTransferCount == int64(0) &&
               receipt.retained == int64(0) &&
               receipt.borrowReturnCount == int64(0) &&
               receipt.ledgerStorageReleasedSequenceCount == 0 &&
               receipt.ledgerStorageReleasedBufferCount == 0 &&
               receipt.ledgerStorageReleasedBytes == int64(0) &&
               receipt.ledgerStorageReleased &&
               receipt.storageReleased
    if receipt.expectedItemCount < 0 ||
       receipt.categoryId != 1 ||
       receipt.builderOwnerId != 1 ||
       receipt.planOwnerId != 2 ||
       receipt.ledgerStorageReleasedSequenceCount != 6 ||
       receipt.ledgerStorageReleasedBufferCount <= 0 ||
       receipt.ledgerStorageReleasedBytes <= int64(0) ||
       !receipt.ledgerStorageReleased ||
       !receipt.storageReleased ||
       receipt.live != int64(0) ||
       receipt.liveBytes != int64(0) ||
       receipt.allocated != receipt.released ||
       receipt.allocatedBytes != receipt.releasedBytes ||
       receipt.retained != receipt.borrowReturnCount:
        return false
    if receipt.expectedItemCount == 0:
        return receipt.objectId == 0 &&
               receipt.reservedCapacity == 0 &&
               receipt.retainedBufferCount == 0 &&
               receipt.retainedBytes == int64(0) &&
               receipt.physicalFreeCount == 0 &&
               receipt.physicalFreedBytes == int64(0) &&
               receipt.allocated == int64(0) &&
               receipt.allocatedBytes == int64(0) &&
               receipt.ownerTransferCount == int64(0)
    return receipt.objectId == 1 &&
           receipt.reservedCapacity >= receipt.expectedItemCount &&
           receipt.retainedBufferCount == 1 &&
           receipt.retainedBytes ==
               int64(receipt.reservedCapacity) *
                   int64(sizeof(int32)) &&
           receipt.physicalFreeCount == 1 &&
           receipt.physicalFreedBytes == receipt.retainedBytes &&
           receipt.allocated == int64(1) &&
           receipt.released == int64(1) &&
           receipt.allocatedBytes == receipt.retainedBytes &&
           receipt.releasedBytes == receipt.retainedBytes &&
           receipt.ownerTransferCount ==
               (receipt.movedToPlan ? int64(1) : int64(0))

fn loweringResolvedCallTargetProjectionBeginExact(
        owner: var LoweringResolvedCallTargetProjectionOwner,
        values: var int32[],
        expectedItemCount: int32) =
    if expectedItemCount < 0 ||
       values.len != 0 ||
       values.cap != 0 ||
       owner.begun ||
       owner.receiptReady ||
       owner.receiptConsumed:
        panic(
            "lowering resolved-call target projection: invalid begin state")
    lifetime.LifetimeLedgerInit(owner.ledger)
    let objectCapacityBound =
        expectedItemCount > 0 ? 1 : 0
    lifetime.LifetimeLedgerReserveExact(
        owner.ledger, 1, 2, objectCapacityBound, 0)
    owner.categoryId =
        lifetime.LifetimeLedgerRegisterCategory(
            owner.ledger,
            "resolved_call_target_typed_function_index_projection")
    owner.builderOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            owner.ledger, "lowering_projection_builder")
    owner.planOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            owner.ledger, "lowering_plan")
    owner.expectedItemCount = expectedItemCount
    if expectedItemCount > 0:
        seqs.reserve(values, expectedItemCount)
        if values.cap < expectedItemCount ||
           values.buffer == nil:
            panic(
                "lowering resolved-call target projection: reserve failed")
        owner.reservedCapacity = values.cap
        owner.objectId =
            lifetime.LifetimeLedgerReserveObject(
                owner.ledger,
                owner.categoryId,
                int64(owner.reservedCapacity) *
                    int64(sizeof(int32)))
        lifetime.LifetimeLedgerOwn(
            owner.ledger,
            owner.objectId,
            owner.builderOwnerId)
    owner.begun = true

fn LoweringResolvedCallTargetProjectionBegin(
        plan: var LoweringPlanStub,
        expectedItemCount: int32) =
    loweringResolvedCallTargetProjectionBeginExact(
        plan.resolvedCallTargetProjectionOwner,
        plan.resolvedCallTargetTypedFunctionIndexes,
        expectedItemCount)

fn loweringResolvedCallTargetProjectionAppendExact(
        owner: var LoweringResolvedCallTargetProjectionOwner,
        values: var int32[],
        typedFunctionIndex: int32) =
    if !owner.begun ||
       owner.movedToPlan ||
       owner.builderOwnerClosed ||
       owner.receiptReady ||
       owner.receiptConsumed ||
       owner.expectedItemCount <= 0 ||
       values.len >= owner.expectedItemCount ||
       owner.objectId <= 0 ||
       owner.reservedCapacity <= 0 ||
       values.cap != owner.reservedCapacity:
        panic(
            "lowering resolved-call target projection: invalid append state")
    let capacityBefore = values.cap
    add(values, typedFunctionIndex)
    if values.cap != capacityBefore ||
       values.buffer == nil:
        panic(
            "lowering resolved-call target projection: append grew reserved storage")

fn LoweringResolvedCallTargetProjectionAppend(
        plan: var LoweringPlanStub,
        typedFunctionIndex: int32) =
    loweringResolvedCallTargetProjectionAppendExact(
        plan.resolvedCallTargetProjectionOwner,
        plan.resolvedCallTargetTypedFunctionIndexes,
        typedFunctionIndex)

fn loweringResolvedCallTargetProjectionMoveToPlanExact(
        owner: var LoweringResolvedCallTargetProjectionOwner,
        values: var int32[]) =
    if !owner.begun ||
       owner.movedToPlan ||
       owner.builderOwnerClosed ||
       owner.receiptReady ||
       owner.receiptConsumed ||
       values.len != owner.expectedItemCount ||
       values.cap != owner.reservedCapacity:
        panic(
            "lowering resolved-call target projection: invalid plan move")
    if owner.objectId > 0:
        lifetime.LifetimeLedgerMove(
            owner.ledger,
            owner.objectId,
            owner.builderOwnerId,
            owner.planOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        owner.ledger, owner.builderOwnerId)
    owner.builderOwnerClosed = true
    owner.movedToPlan = true

fn LoweringResolvedCallTargetProjectionMoveToPlan(
        plan: var LoweringPlanStub) =
    loweringResolvedCallTargetProjectionMoveToPlanExact(
        plan.resolvedCallTargetProjectionOwner,
        plan.resolvedCallTargetTypedFunctionIndexes)

fn loweringResolvedCallTargetProjectionReleaseExact(
        owner: var LoweringResolvedCallTargetProjectionOwner,
        values: var int32[]) =
    if owner.receiptReady:
        if !LoweringResolvedCallTargetProjectionReceiptClosed(
               owner.receipt):
            panic(
                "lowering resolved-call target projection: corrupt closed receipt")
        return
    if !owner.begun:
        if values.len != 0 ||
           values.cap != 0 ||
           values.buffer != nil:
            panic(
                "lowering resolved-call target projection: unregistered storage")
        var emptyReceipt: LoweringResolvedCallTargetProjectionReceipt
        emptyReceipt.ledgerStorageReleased = true
        emptyReceipt.storageReleased = true
        owner.receipt = emptyReceipt
        owner.receiptReady = true
        return
    if owner.expectedItemCount < 0 ||
       owner.reservedCapacity < owner.expectedItemCount ||
       values.cap != owner.reservedCapacity ||
       (owner.movedToPlan &&
        values.len != owner.expectedItemCount) ||
       (!owner.movedToPlan &&
        values.len > owner.expectedItemCount):
        panic(
            "lowering resolved-call target projection: release shape mismatch")
    let retainedBufferCount =
        owner.reservedCapacity > 0 ? 1 : 0
    let retainedBytes =
        int64(owner.reservedCapacity) * int64(sizeof(int32))
    let ledgerRetainedBytes =
        loweringResolvedCallTargetProjectionLedgerRetainedBytes(owner)
    seqs.freeSeq(values)
    if values.len != 0 ||
       values.cap != 0 ||
       values.buffer != nil:
        panic(
            "lowering resolved-call target projection: physical free failed")
    if owner.objectId > 0:
        let releasingOwnerId =
            owner.movedToPlan ?
                owner.planOwnerId :
                owner.builderOwnerId
        lifetime.LifetimeLedgerRelease(
            owner.ledger,
            owner.objectId,
            releasingOwnerId)
    if !owner.builderOwnerClosed:
        lifetime.LifetimeLedgerAssertOwnerClosed(
            owner.ledger, owner.builderOwnerId)
        owner.builderOwnerClosed = true
    lifetime.LifetimeLedgerAssertOwnerClosed(
        owner.ledger, owner.planOwnerId)
    lifetime.LifetimeLedgerAssertClosed(owner.ledger)
    var metrics: lifetime.LifetimeLedgerMetrics
    lifetime.LifetimeLedgerReadTotalMetrics(
        owner.ledger, metrics)
    let ledgerStorageRelease =
        lifetime.LifetimeLedgerReleaseStorage(owner.ledger)
    if ledgerStorageRelease.releasedSequenceCapacityBytes !=
           ledgerRetainedBytes:
        panic(
            "lowering resolved-call target projection: ledger physical release byte mismatch")
    var receipt: LoweringResolvedCallTargetProjectionReceipt
    receipt.begun = true
    receipt.movedToPlan = owner.movedToPlan
    receipt.expectedItemCount = owner.expectedItemCount
    receipt.categoryId = owner.categoryId
    receipt.builderOwnerId = owner.builderOwnerId
    receipt.planOwnerId = owner.planOwnerId
    receipt.objectId = owner.objectId
    receipt.reservedCapacity = owner.reservedCapacity
    receipt.retainedBufferCount = retainedBufferCount
    receipt.retainedBytes = retainedBytes
    receipt.physicalFreeCount = retainedBufferCount
    receipt.physicalFreedBytes = retainedBytes
    receipt.allocated = metrics.allocated
    receipt.released = metrics.released
    receipt.live = metrics.live
    receipt.allocatedBytes = metrics.allocatedBytes
    receipt.releasedBytes = metrics.releasedBytes
    receipt.liveBytes = metrics.liveBytes
    receipt.ownerTransferCount = metrics.ownerTransferCount
    receipt.retained = metrics.retained
    receipt.borrowReturnCount = metrics.borrowReturnCount
    receipt.ledgerStorageReleasedSequenceCount =
        ledgerStorageRelease.releasedSequenceCount
    receipt.ledgerStorageReleasedBufferCount =
        ledgerStorageRelease.releasedSequenceBufferCount
    receipt.ledgerStorageReleasedBytes =
        ledgerStorageRelease.releasedSequenceCapacityBytes
    receipt.ledgerStorageReleased =
        ledgerStorageRelease.storageReleased
    receipt.storageReleased =
        values.len == 0 &&
        values.cap == 0 &&
        values.buffer == nil &&
        lifetime.LifetimeLedgerStorageReleased(owner.ledger)
    if !LoweringResolvedCallTargetProjectionReceiptClosed(
           receipt):
        panic(
            "lowering resolved-call target projection: terminal receipt unbalanced")
    owner.receipt = receipt
    owner.receiptReady = true

fn LoweringResolvedCallTargetProjectionRelease(
        plan: var LoweringPlanStub) =
    loweringResolvedCallTargetProjectionReleaseExact(
        plan.resolvedCallTargetProjectionOwner,
        plan.resolvedCallTargetTypedFunctionIndexes)

fn LoweringResolvedCallTargetProjectionReceiptInto(
        plan: var LoweringPlanStub,
        out: var LoweringResolvedCallTargetProjectionReceipt) =
    if !plan.resolvedCallTargetProjectionOwner.receiptReady ||
       !LoweringResolvedCallTargetProjectionReceiptClosed(
           plan.resolvedCallTargetProjectionOwner.receipt):
        panic(
            "lowering resolved-call target projection: receipt not ready")
    out = plan.resolvedCallTargetProjectionOwner.receipt

fn LoweringResolvedCallTargetProjectionReceiptConsumeStrict(
        plan: var LoweringPlanStub,
        receipt: LoweringResolvedCallTargetProjectionReceipt): bool =
    if !plan.resolvedCallTargetProjectionOwner.receiptReady ||
       plan.resolvedCallTargetProjectionOwner.receiptConsumed ||
       !LoweringResolvedCallTargetProjectionReceiptEqual(
           receipt,
           plan.resolvedCallTargetProjectionOwner.receipt) ||
       !LoweringResolvedCallTargetProjectionReceiptClosed(receipt):
        return false
    plan.resolvedCallTargetProjectionOwner.receiptConsumed = true
    return true

fn LoweringResolvedCallTargetProjectionResetForBuild(
        plan: var LoweringPlanStub) =
    if !plan.resolvedCallTargetProjectionOwner.receiptReady ||
       !plan.resolvedCallTargetProjectionOwner.receiptConsumed ||
       !LoweringResolvedCallTargetProjectionReceiptClosed(
           plan.resolvedCallTargetProjectionOwner.receipt) ||
       plan.resolvedCallTargetTypedFunctionIndexes.len != 0 ||
       plan.resolvedCallTargetTypedFunctionIndexes.cap != 0:
        panic(
            "lowering resolved-call target projection: reset before strict consume")
    plan.resolvedCallTargetProjectionOwner =
        LoweringResolvedCallTargetProjectionOwner()

fn LoweringResolvedCallTargetProjectionCapacity(
        plan: var LoweringPlanStub): int32 =
    return plan.resolvedCallTargetTypedFunctionIndexes.cap

fn loweringResolvedCallTargetProjectionLedgerPhysicalBufferCount(
        owner: var LoweringResolvedCallTargetProjectionOwner): int32 =
    var count: int32
    if owner.ledger.categoryNames.cap > 0:
        count = count + 1
    if owner.ledger.ownerNames.cap > 0:
        count = count + 1
    if owner.ledger.ownerClosed.cap > 0:
        count = count + 1
    if owner.ledger.objects.cap > 0:
        count = count + 1
    if owner.ledger.borrows.cap > 0:
        count = count + 1
    if owner.ledger.categoryMetrics.cap > 0:
        count = count + 1
    return count

fn loweringResolvedCallTargetProjectionLedgerRetainedBytes(
        owner: var LoweringResolvedCallTargetProjectionOwner): int64 =
    return int64(owner.ledger.categoryNames.cap) * int64(sizeof(str)) +
           int64(owner.ledger.ownerNames.cap) * int64(sizeof(str)) +
           int64(owner.ledger.ownerClosed.cap) * int64(sizeof(bool)) +
           int64(owner.ledger.objects.cap) *
               int64(sizeof(lifetime.LifetimeLedgerObject)) +
           int64(owner.ledger.borrows.cap) *
               int64(sizeof(lifetime.LifetimeLedgerBorrow)) +
           int64(owner.ledger.categoryMetrics.cap) *
               int64(sizeof(lifetime.LifetimeLedgerMetrics))

fn LoweringResolvedCallTargetProjectionPhysicalBufferCount(
        plan: var LoweringPlanStub): int32 =
    var count =
        loweringResolvedCallTargetProjectionLedgerPhysicalBufferCount(
            plan.resolvedCallTargetProjectionOwner)
    if plan.resolvedCallTargetTypedFunctionIndexes.cap > 0:
        count = count + 1
    return count

fn LoweringResolvedCallTargetProjectionRetainedBytes(
        plan: var LoweringPlanStub): int64 =
    return int64(
               plan.resolvedCallTargetTypedFunctionIndexes.cap) *
           int64(sizeof(int32)) +
           loweringResolvedCallTargetProjectionLedgerRetainedBytes(
               plan.resolvedCallTargetProjectionOwner)

fn LoweringResolvedCallTargetProjectionStorageReleased(
        plan: var LoweringPlanStub): bool =
    return plan.resolvedCallTargetProjectionOwner.receiptReady &&
           LoweringResolvedCallTargetProjectionReceiptClosed(
               plan.resolvedCallTargetProjectionOwner.receipt) &&
           plan.resolvedCallTargetTypedFunctionIndexes.len == 0 &&
           plan.resolvedCallTargetTypedFunctionIndexes.cap == 0 &&
           plan.resolvedCallTargetTypedFunctionIndexes.buffer == nil

fn LoweringBindResolvedCallTargetTypedFunctionIndexes(
        compilerCsg: var ccsg.CompilerCsg,
        plan: var LoweringPlanStub,
        err: var str): bool =
    if plan.resolvedCallTargetTypedFunctionIndexes.len != 0:
        err =
            " lowering plan: resolved-call target TypedExpr destination is not empty"
        return false
    let reachable =
        compilerCsg.semanticGraph.reachableFunctionTable
    let slices = plan.compilerCsgExprSliceSidecar
    let callCount =
        plan.resolvedCallSnapshot.targetGraphNodeIds.len
    if !plan.resolvedCallSnapshot.graphNodeProjectionComplete ||
       reachable.graphNodeIds.len !=
           slices.functionSliceIndexes.len ||
       callCount !=
           plan.resolvedCallSnapshot.callTargetImportcFlags.len:
        err =
            " lowering plan: resolved-call target TypedExpr authority incomplete"
        return false
    var scratch: LoweringResolvedCallTargetGraphScratchOwner
    loweringSequenceAllocatorSetLen(
        scratch,
        LoweringResolvedCallTargetGraphScratchLength(
            length: compilerCsg.nodes.len + 1))
    for graphNodeId in
            0..<scratch.typedFunctionIndexByGraphNodeId.len:
        scratch.typedFunctionIndexByGraphNodeId[graphNodeId] = -1
    for reachableFunctionIndex in 0..<reachable.graphNodeIds.len:
        let graphNodeId =
            reachable.graphNodeIds[reachableFunctionIndex]
        let sliceIndex =
            slices.functionSliceIndexes[reachableFunctionIndex]
        if graphNodeId <= 0 ||
           graphNodeId >=
               scratch.typedFunctionIndexByGraphNodeId.len ||
           scratch.typedFunctionIndexByGraphNodeId[
               graphNodeId] >= 0:
            LoweringResolvedCallTargetGraphScratchClose(scratch)
            err =
                " lowering plan: resolved-call target graph projection invalid"
            return false
        if sliceIndex < 0:
            continue
        if sliceIndex >= slices.typedIrFunctionIndexes.len:
            LoweringResolvedCallTargetGraphScratchClose(scratch)
            err =
                " lowering plan: resolved-call target slice index invalid"
            return false
        let typedFunctionIndex =
            slices.typedIrFunctionIndexes[sliceIndex]
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >=
               compilerCsg.typedIr.functions2_functionNameIds.len:
            LoweringResolvedCallTargetGraphScratchClose(scratch)
            err =
                " lowering plan: resolved-call target TypedExpr row invalid"
            return false
        scratch.typedFunctionIndexByGraphNodeId[graphNodeId] =
            typedFunctionIndex
    LoweringResolvedCallTargetProjectionBegin(plan, callCount)
    for callRow in 0..<callCount:
        let importc =
            plan.resolvedCallSnapshot.callTargetImportcFlags[callRow]
        let targetGraphNodeId =
            plan.resolvedCallSnapshot.targetGraphNodeIds[callRow]
        if importc:
            if targetGraphNodeId != -1:
                LoweringResolvedCallTargetGraphScratchClose(scratch)
                LoweringResolvedCallTargetProjectionRelease(plan)
                err =
                    " lowering plan: importc call carried Cheng target row"
                return false
            LoweringResolvedCallTargetProjectionAppend(plan, -1)
            continue
        if targetGraphNodeId <= 0 ||
           targetGraphNodeId >=
               scratch.typedFunctionIndexByGraphNodeId.len ||
           scratch.typedFunctionIndexByGraphNodeId[
               targetGraphNodeId] < 0:
            LoweringResolvedCallTargetGraphScratchClose(scratch)
            LoweringResolvedCallTargetProjectionRelease(plan)
            err =
                " lowering plan: Cheng call target TypedExpr row missing"
            return false
        LoweringResolvedCallTargetProjectionAppend(
            plan,
            scratch.typedFunctionIndexByGraphNodeId[
                targetGraphNodeId])
    LoweringResolvedCallTargetGraphScratchClose(scratch)
    LoweringResolvedCallTargetProjectionMoveToPlan(plan)
    err = ""
    return true

@borrows
fn LoweringResolvedCallSnapshotText(plan: LoweringPlanStub,
                                    textId: langintern.InternId): str =
    return Value(langintern.LookupIntern(plan.resolvedCallSnapshot.internPool, textId))

@borrows
fn LoweringExprSummaryKindCountTotal(summary: ccsg.CompilerCsgSemanticExprSummary): int64 =
    return int64(summary.ifCount) +
           int64(summary.rangeCount) +
           int64(summary.comprehensionCount) +
           int64(summary.strFormatCount) +
           int64(summary.resultIntrinsicCount) +
           int64(summary.callCount) +
           int64(summary.tryCount) +
           int64(summary.defaultInitCount) +
           int64(summary.constructorCount) +
           int64(summary.returnCount) +
           int64(summary.assignCount) +
           int64(summary.ifStmtCount) +
           int64(summary.elifStmtCount) +
           int64(summary.elseStmtCount) +
           int64(summary.forStmtCount) +
           int64(summary.matchStmtCount) +
           int64(summary.caseStmtCount) +
           int64(summary.whileStmtCount)

@borrows
fn LoweringExprSummaryShapeValid(summary: ccsg.CompilerCsgSemanticExprSummary): bool =
    if summary.sourceCount < 0 || summary.exprCount < 0 ||
       summary.ifCount < 0 || summary.rangeCount < 0 ||
       summary.comprehensionCount < 0 || summary.strFormatCount < 0 ||
       summary.resultIntrinsicCount < 0 || summary.callCount < 0 ||
       summary.tryCount < 0 || summary.defaultInitCount < 0 ||
       summary.constructorCount < 0 || summary.returnCount < 0 ||
       summary.assignCount < 0 || summary.ifStmtCount < 0 ||
       summary.elifStmtCount < 0 || summary.elseStmtCount < 0 ||
       summary.forStmtCount < 0 || summary.matchStmtCount < 0 ||
       summary.caseStmtCount < 0 || summary.whileStmtCount < 0 ||
       summary.questionResidualCount < 0 ||
       summary.questionResidualCount > summary.exprCount:
        return false
    return LoweringExprSummaryKindCountTotal(summary) == int64(summary.exprCount)

fn LoweringValidateCompilerCsgSemanticCompactExprContract(compilerCsg: var ccsg.CompilerCsg,
                                                      err: var str): bool =
    let summary = compilerCsg.semanticGraph.exprSummary
    if !LoweringExprSummaryShapeValid(summary):
        err = Fmt" lowering plan: compiler csg expr summary invalid sources={summary.sourceCount} exprs={summary.exprCount} kind_total={LoweringExprSummaryKindCountTotal(summary)} residuals={summary.questionResidualCount}"
        return false
    if !compilerCsg.semanticGraph.oracleCompared || !compilerCsg.semanticGraph.oracleMatched ||
       compilerCsg.semanticGraph.oracleMismatchReason != "":
        err = Fmt" lowering plan: compiler csg oracle contract incomplete compared={compilerCsg.semanticGraph.oracleCompared} matched={compilerCsg.semanticGraph.oracleMatched} reason={compilerCsg.semanticGraph.oracleMismatchReason}"
        return false
    err = ""
    return true

fn LoweringValidateResolvedCallSnapshot(plan: var LoweringPlanStub,
                                        expectedFunctionCount: int32,
                                        err: var str): bool =
    let rowCount = LoweringResolvedCallSnapshotRowCount(plan)
    var structureErr: str
    if !ccsg.CompilerCsgSemanticResolvedCallTableValidate(plan.resolvedCallSnapshot,
                                                     expectedFunctionCount,
                                                     structureErr):
        err = Fmt" lowering plan: resolved-call snapshot invalid:{structureErr}"
        return false
    for rowIndex in 0..<rowCount:
        let sourcePathRes: Result[str] = langintern.LookupIntern(plan.resolvedCallSnapshot.internPool,
                                                                 plan.resolvedCallSnapshot.sourcePathIds[rowIndex])
        let callTargetRes: Result[str] = langintern.LookupIntern(plan.resolvedCallSnapshot.internPool,
                                                                 plan.resolvedCallSnapshot.callTargetIds[rowIndex])
        let callQualifierRes: Result[str] = langintern.LookupIntern(plan.resolvedCallSnapshot.internPool,
                                                                    plan.resolvedCallSnapshot.callQualifierIds[rowIndex])
        let callCalleeRes: Result[str] = langintern.LookupIntern(plan.resolvedCallSnapshot.internPool,
                                                                 plan.resolvedCallSnapshot.callCalleeIds[rowIndex])
        let callTargetSourcePathRes: Result[str] = langintern.LookupIntern(plan.resolvedCallSnapshot.internPool,
                                                                           plan.resolvedCallSnapshot.callTargetSourcePathIds[rowIndex])
        let callArgsTextRes: Result[str] = langintern.LookupIntern(plan.resolvedCallSnapshot.internPool,
                                                                   plan.resolvedCallSnapshot.callArgsTextIds[rowIndex])
        if !IsOk(sourcePathRes) || !IsOk(callTargetRes) ||
           !IsOk(callQualifierRes) || !IsOk(callCalleeRes) ||
           !IsOk(callTargetSourcePathRes) || !IsOk(callArgsTextRes) ||
           plan.resolvedCallSnapshot.sourceIndexes[rowIndex] < 0 ||
           plan.resolvedCallSnapshot.functionIndexes[rowIndex] < 0 ||
           plan.resolvedCallSnapshot.functionRowNext[rowIndex] < -1 ||
           plan.resolvedCallSnapshot.functionIndexes[rowIndex] >= plan.resolvedCallSnapshot.functionRowHeads.len ||
           Value(sourcePathRes) == "" ||
           plan.resolvedCallSnapshot.lineNumbers[rowIndex] <= 0 ||
           Value(callTargetRes) == "" ||
           (!plan.resolvedCallSnapshot.callTargetImportcFlags[rowIndex] &&
            Value(callTargetSourcePathRes) == "") ||
           (plan.resolvedCallSnapshot.callTargetImportcFlags[rowIndex] &&
            plan.resolvedCallSnapshot.callTargetSignatureLineNumbers[rowIndex] != 0) ||
           (!plan.resolvedCallSnapshot.callTargetImportcFlags[rowIndex] &&
            plan.resolvedCallSnapshot.callTargetSignatureLineNumbers[rowIndex] <= 0) ||
           plan.resolvedCallSnapshot.callArgCounts[rowIndex] < 0:
            err = Fmt" lowering plan: invalid resolved-call snapshot row index={rowIndex}"
            return false
    err = ""
    return true

fn LoweringValidateResolvedCallTargets(plan: var LoweringPlanStub,
                                        err: var str): bool =
    let rowCount = LoweringResolvedCallSnapshotRowCount(plan)
    for rowIndex in 0..<rowCount:
        if plan.resolvedCallSnapshot.callTargetImportcFlags[rowIndex]:
            continue
        let sourcePath = LoweringResolvedCallSnapshotText(plan,
                                                          plan.resolvedCallSnapshot.sourcePathIds[rowIndex])
        let targetSourcePath = LoweringResolvedCallSnapshotText(plan,
                                                                plan.resolvedCallSnapshot.callTargetSourcePathIds[rowIndex])
        let target = LoweringResolvedCallSnapshotText(plan,
                                                      plan.resolvedCallSnapshot.callTargetIds[rowIndex])
        let targetSignatureLineNumber =
            plan.resolvedCallSnapshot.callTargetSignatureLineNumbers[rowIndex]
        let targetIndex = LoweringPlanFunctionIndexAtLine(
            plan,
            targetSourcePath,
            target,
            targetSignatureLineNumber)
        if targetIndex < 0:
            err = Fmt" lowering plan: exact resolved-call target missing source={sourcePath} line={plan.resolvedCallSnapshot.lineNumbers[rowIndex]} target_source={targetSourcePath} target={target} target_signature_line={targetSignatureLineNumber}"
            return false
    err = ""
    return true

fn LoweringValidateCompilerCsgExprSliceSidecar(plan: var LoweringPlanStub,
                                                err: var str): bool =
    let table = plan.compilerCsgExprSliceSidecar
    let sliceCount = table.sourceIndex.len
    if table.sourcePaths.len != sliceCount ||
       table.functionIndex.len != sliceCount ||
       table.exprStart.len != sliceCount ||
       table.exprCount.len != sliceCount ||
       table.typedFactStart.len != sliceCount ||
       table.typedFactCount.len != sliceCount:
        err = " lowering plan: compiler csg expr-slice sidecar column length mismatch"
        return false
    if !plan.compilerCsgExprSliceSidecarComplete ||
       plan.compilerCsgExprSliceSidecarValidationReason != "complete" ||
       plan.compilerCsgExprSliceSidecarGapCount != 0 ||
       plan.compilerCsgExprSliceSidecarOverlapCount != 0 ||
       plan.compilerCsgExprSliceSidecarInvalidSliceCount != 0 ||
       plan.compilerCsgExprSliceSidecarSyntheticCount != 0:
        err = Fmt" lowering plan: compiler csg expr-slice sidecar incomplete reason={plan.compilerCsgExprSliceSidecarValidationReason} gaps={plan.compilerCsgExprSliceSidecarGapCount} overlaps={plan.compilerCsgExprSliceSidecarOverlapCount} invalid={plan.compilerCsgExprSliceSidecarInvalidSliceCount} synthetic={plan.compilerCsgExprSliceSidecarSyntheticCount}"
        return false
    var expectedExprStart: int32
    var expectedFactStart: int32
    var functionBoundCount: int32
    for sliceIndex in 0..<sliceCount:
        if table.sourceIndex[sliceIndex] < 0 || table.sourcePaths[sliceIndex] == "" ||
           table.functionIndex[sliceIndex] < -1 ||
           table.exprStart[sliceIndex] != expectedExprStart || table.exprCount[sliceIndex] < 0 ||
           table.typedFactStart[sliceIndex] != expectedFactStart || table.typedFactCount[sliceIndex] < 0:
            err = Fmt" lowering plan: invalid compiler csg expr-slice row index={sliceIndex}"
            return false
        expectedExprStart = expectedExprStart + table.exprCount[sliceIndex]
        expectedFactStart = expectedFactStart + table.typedFactCount[sliceIndex]
        if table.functionIndex[sliceIndex] >= 0:
            functionBoundCount = functionBoundCount + 1
        plan.compilerCsgExprSliceSidecarRangeQueryCount = plan.compilerCsgExprSliceSidecarRangeQueryCount + 1
        if table.exprCount[sliceIndex] == 0 && table.typedFactCount[sliceIndex] == 0:
            plan.compilerCsgExprSliceSidecarRangeEmptyCount = plan.compilerCsgExprSliceSidecarRangeEmptyCount + 1
        else:
            plan.compilerCsgExprSliceSidecarRangeHitCount = plan.compilerCsgExprSliceSidecarRangeHitCount + 1
    if expectedExprStart != plan.exprSummary.exprCount ||
       expectedFactStart != plan.typedExprFactCountSnapshot ||
       functionBoundCount != plan.compilerCsgExprSliceSidecarFunctionBoundCount ||
       sliceCount != plan.compilerCsgExprSliceSidecarCount ||
       plan.compilerCsgExprSliceSidecarCoveredCount != plan.typedExprFactCountSnapshot:
        err = Fmt" lowering plan: compiler csg expr-slice totals mismatch slices={sliceCount} exprs={expectedExprStart}/{plan.exprSummary.exprCount} facts={expectedFactStart}/{plan.typedExprFactCountSnapshot} functions={functionBoundCount}/{plan.compilerCsgExprSliceSidecarFunctionBoundCount} covered={plan.compilerCsgExprSliceSidecarCoveredCount}"
        return false
    plan.compilerCsgExprSliceSidecarBound = sliceCount > 0
    plan.compilerCsgExprSliceConsumedCount = sliceCount
    plan.compilerCsgExprSliceConsumedFunctionBoundCount = functionBoundCount
    plan.compilerCsgExprSliceVerifiedComplete = true
    err = ""
    return true

fn LoweringCompilerCsgExprSliceSidecarRangeAt(plan: var LoweringPlanStub,
                                               sliceIndex: int32,
                                               sourceIndex: var int32,
                                               sourcePath: var str,
                                               functionIndex: var int32,
                                               exprStart: var int32,
                                               exprCount: var int32,
                                               typedFactStart: var int32,
                                               typedFactCount: var int32): bool =
    let table = plan.compilerCsgExprSliceSidecar
    if !plan.compilerCsgExprSliceSidecarBound ||
       sliceIndex < 0 || sliceIndex >= table.sourceIndex.len:
        panic("lowering plan: compiler csg expr-slice query out of range")
    sourceIndex = table.sourceIndex[sliceIndex]
    sourcePath = table.sourcePaths[sliceIndex]
    functionIndex = table.functionIndex[sliceIndex]
    exprStart = table.exprStart[sliceIndex]
    exprCount = table.exprCount[sliceIndex]
    typedFactStart = table.typedFactStart[sliceIndex]
    typedFactCount = table.typedFactCount[sliceIndex]
    plan.compilerCsgExprSliceSidecarRangeQueryCount = plan.compilerCsgExprSliceSidecarRangeQueryCount + 1
    if exprCount == 0 && typedFactCount == 0:
        plan.compilerCsgExprSliceSidecarRangeEmptyCount = plan.compilerCsgExprSliceSidecarRangeEmptyCount + 1
    else:
        plan.compilerCsgExprSliceSidecarRangeHitCount = plan.compilerCsgExprSliceSidecarRangeHitCount + 1
    return true

@borrows
fn LoweringResolvedCallSnapshotFactAt(plan: LoweringPlanStub,
                                      rowIndex: int32): texpr.TypedExprFact =
    var fact: texpr.TypedExprFact
    fact.sourcePath = LoweringResolvedCallSnapshotText(plan,
                                                       plan.resolvedCallSnapshot.sourcePathIds[rowIndex])
    fact.lineNumber = plan.resolvedCallSnapshot.lineNumbers[rowIndex]
    fact.columnNumber = plan.resolvedCallSnapshot.columnNumbers[rowIndex]
    fact.callResolved = true
    fact.callQualifier = LoweringResolvedCallSnapshotText(plan,
                                                          plan.resolvedCallSnapshot.callQualifierIds[rowIndex])
    fact.callCallee = LoweringResolvedCallSnapshotText(plan,
                                                       plan.resolvedCallSnapshot.callCalleeIds[rowIndex])
    fact.callTarget = LoweringResolvedCallSnapshotText(plan,
                                                       plan.resolvedCallSnapshot.callTargetIds[rowIndex])
    fact.callTargetSourcePath = LoweringResolvedCallSnapshotText(plan,
                                                                 plan.resolvedCallSnapshot.callTargetSourcePathIds[rowIndex])
    fact.callTargetSignatureLineNumber =
        plan.resolvedCallSnapshot.callTargetSignatureLineNumbers[rowIndex]
    fact.callTargetImportc = plan.resolvedCallSnapshot.callTargetImportcFlags[rowIndex]
    fact.callArgCount = plan.resolvedCallSnapshot.callArgCounts[rowIndex]
    fact.callArgsText = LoweringResolvedCallSnapshotText(plan,
                                                         plan.resolvedCallSnapshot.callArgsTextIds[rowIndex])
    fact.returnRoot = plan.resolvedCallSnapshot.returnRootFlags[rowIndex]
    return fact

@borrows
fn LoweringResolvedCallFactAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.resolvedCallFactSourcePaths.cap > 0: count = count + 1
    if plan.resolvedCallFactSourceBucketHeads.cap > 0: count = count + 1
    if plan.resolvedCallFactSourceEntryNext.cap > 0: count = count + 1
    if plan.resolvedCallFactBucketHeads.cap > 0: count = count + 1
    if plan.resolvedCallFactEntryNext.cap > 0: count = count + 1
    if plan.resolvedCallFactEntrySourceIndexes.cap > 0: count = count + 1
    if plan.resolvedCallFactEntryLineNumbers.cap > 0: count = count + 1
    if plan.resolvedCallFactEntryFactIndexes.cap > 0: count = count + 1
    return count

@borrows
fn LoweringResolvedCallFactAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(plan.resolvedCallFactSourcePaths.cap) *
            int64(sizeof(str)) +
        int64(plan.resolvedCallFactSourceBucketHeads.cap) *
            int64(sizeof(int32)) +
        int64(plan.resolvedCallFactSourceEntryNext.cap) *
            int64(sizeof(int32)) +
        int64(plan.resolvedCallFactBucketHeads.cap) *
            int64(sizeof(int32)) +
        int64(plan.resolvedCallFactEntryNext.cap) *
            int64(sizeof(int32)) +
        int64(plan.resolvedCallFactEntrySourceIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.resolvedCallFactEntryLineNumbers.cap) *
            int64(sizeof(int32)) +
        int64(plan.resolvedCallFactEntryFactIndexes.cap) *
            int64(sizeof(int32))

fn LoweringResolvedCallFactAppendSourceBucket(
        plan: var LoweringPlanStub,
        bucketHead: int32) =
    loweringSequenceAllocatorAdd(
        plan.resolvedCallFactAllocatorLedger,
        plan.resolvedCallFactSourceBucketHeads,
        bucketHead,
        sizeof(int32))

fn LoweringResolvedCallFactAppendLookupBucket(
        plan: var LoweringPlanStub,
        bucketHead: int32) =
    loweringSequenceAllocatorAdd(
        plan.resolvedCallFactAllocatorLedger,
        plan.resolvedCallFactBucketHeads,
        bucketHead,
        sizeof(int32))

@borrows
fn LoweringResolvedCallFactAppendSourceRow(
        plan: var LoweringPlanStub,
        sourcePath: str,
        entryNext: int32) =
    if plan.resolvedCallFactSourcePaths.len !=
       plan.resolvedCallFactSourceEntryNext.len:
        panic("lowering resolved call fact allocator: source row shape drift")
    var resolvedCallFactSourcePaths = plan.resolvedCallFactSourcePaths
    plan.resolvedCallFactSourcePaths = []
    loweringSequenceAllocatorAdd(
        plan.resolvedCallFactAllocatorLedger,
        resolvedCallFactSourcePaths,
        sourcePath,
        sizeof(str))
    plan.resolvedCallFactSourcePaths = resolvedCallFactSourcePaths
    var resolvedCallFactSourceEntryNext = plan.resolvedCallFactSourceEntryNext
    plan.resolvedCallFactSourceEntryNext = []
    loweringSequenceAllocatorAdd(
        plan.resolvedCallFactAllocatorLedger,
        resolvedCallFactSourceEntryNext,
        entryNext,
        sizeof(int32))
    plan.resolvedCallFactSourceEntryNext = resolvedCallFactSourceEntryNext

fn LoweringResolvedCallFactAppendEntryRow(
        plan: var LoweringPlanStub,
        entryNext: int32,
        sourceIndex: int32,
        lineNumber: int32,
        factIndex: int32) =
    let rowCount = plan.resolvedCallFactEntryFactIndexes.len
    if plan.resolvedCallFactEntryNext.len != rowCount ||
       plan.resolvedCallFactEntrySourceIndexes.len != rowCount ||
       plan.resolvedCallFactEntryLineNumbers.len != rowCount:
        panic("lowering resolved call fact allocator: entry row shape drift")
    loweringSequenceAllocatorAdd(
        plan.resolvedCallFactAllocatorLedger,
        plan.resolvedCallFactEntryNext,
        entryNext,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.resolvedCallFactAllocatorLedger,
        plan.resolvedCallFactEntrySourceIndexes,
        sourceIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.resolvedCallFactAllocatorLedger,
        plan.resolvedCallFactEntryLineNumbers,
        lineNumber,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.resolvedCallFactAllocatorLedger,
        plan.resolvedCallFactEntryFactIndexes,
        factIndex,
        sizeof(int32))

fn loweringResolvedCallFactAccumulateTerminalRelease(
        releasedBytes: int64,
        releasedBufferCount: var int32,
        totalReleasedBytes: var int64) =
    if releasedBytes > int64(0):
        releasedBufferCount = releasedBufferCount + 1
        totalReleasedBytes = totalReleasedBytes + releasedBytes

fn LoweringResolvedCallFactAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.resolvedCallFactAllocatorReceiptReady ||
       LoweringResolvedCallFactAllocatorPhysicalBufferCount(plan) != 0 ||
       LoweringResolvedCallFactAllocatorCapacityBytes(plan) != int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.resolvedCallFactAllocatorReceipt):
        panic("lowering resolved call fact allocator: begin before release")
    plan.resolvedCallFactAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.resolvedCallFactAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.resolvedCallFactAllocatorReceiptReady = false

fn LoweringResolvedCallFactAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.resolvedCallFactAllocatorReceiptReady:
        if LoweringResolvedCallFactAllocatorPhysicalBufferCount(plan) != 0 ||
           LoweringResolvedCallFactAllocatorCapacityBytes(plan) != int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.resolvedCallFactAllocatorReceipt):
            panic("lowering resolved call fact allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringResolvedCallFactAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringResolvedCallFactAllocatorCapacityBytes(plan)
    if plan.resolvedCallFactAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.resolvedCallFactAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering resolved call fact allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringResolvedCallFactAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.resolvedCallFactAllocatorLedger,
            plan.resolvedCallFactSourcePaths,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringResolvedCallFactAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.resolvedCallFactAllocatorLedger,
            plan.resolvedCallFactSourceBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringResolvedCallFactAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.resolvedCallFactAllocatorLedger,
            plan.resolvedCallFactSourceEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringResolvedCallFactAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.resolvedCallFactAllocatorLedger,
            plan.resolvedCallFactBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringResolvedCallFactAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.resolvedCallFactAllocatorLedger,
            plan.resolvedCallFactEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringResolvedCallFactAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.resolvedCallFactAllocatorLedger,
            plan.resolvedCallFactEntrySourceIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringResolvedCallFactAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.resolvedCallFactAllocatorLedger,
            plan.resolvedCallFactEntryLineNumbers,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringResolvedCallFactAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.resolvedCallFactAllocatorLedger,
            plan.resolvedCallFactEntryFactIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    plan.resolvedCallFactAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.resolvedCallFactAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.resolvedCallFactAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.resolvedCallFactAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.resolvedCallFactAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.resolvedCallFactAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.resolvedCallFactAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringResolvedCallFactAllocatorPhysicalBufferCount(plan) == 0 &&
        LoweringResolvedCallFactAllocatorCapacityBytes(plan) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering resolved call fact allocator: receipt incomplete")
    plan.resolvedCallFactAllocatorReceipt = receipt
    plan.resolvedCallFactAllocatorReceiptReady = true
    plan.resolvedCallFactAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringPlanReleaseResolvedCallFactIndexPayload(
        plan: var LoweringPlanStub) =
    LoweringResolvedCallFactAllocatorRelease(plan)

@borrows
fn LoweringResolvedCallFactSourceBucket(sourcePath: str,
                                         bucketCount: int32): int32 =
    if len(sourcePath) <= 0 || bucketCount <= 0:
        return -1
    return parser.ParserTextLookupContentHash(sourcePath) & (bucketCount - 1)

fn LoweringResolvedCallFactBucket(sourceIndex: int32,
                                   lineNumber: int32,
                                   bucketCount: int32): int32 =
    if sourceIndex < 0 || lineNumber <= 0 || bucketCount <= 0:
        return -1
    return ((sourceIndex + 1) * 131 + lineNumber) & (bucketCount - 1)

@borrows
fn LoweringResolvedCallFactSourceIndex(plan: LoweringPlanStub,
                                        sourcePath: str): int32 =
    let normalizedSourcePath = parser.ParserNormalizePath(sourcePath)
    let bucket = LoweringResolvedCallFactSourceBucket(normalizedSourcePath,
                                                       plan.resolvedCallFactSourceBucketHeads.len)
    if bucket < 0:
        return -1
    var entryIndex = plan.resolvedCallFactSourceBucketHeads[bucket]
    while entryIndex >= 0:
        if entryIndex >= plan.resolvedCallFactSourcePaths.len:
            return -1
        if plan.resolvedCallFactSourcePaths[entryIndex] == normalizedSourcePath:
            return entryIndex
        entryIndex = plan.resolvedCallFactSourceEntryNext[entryIndex]
    return -1

@borrows
fn LoweringResolvedCallFactFindOrAddSource(plan: var LoweringPlanStub,
                                            sourcePath: str): int32 =
    let normalizedSourcePath = parser.ParserNormalizePath(sourcePath)
    if len(normalizedSourcePath) <= 0:
        return -1
    let existingIndex = LoweringResolvedCallFactSourceIndex(plan, normalizedSourcePath)
    if existingIndex >= 0:
        return existingIndex
    let bucket = LoweringResolvedCallFactSourceBucket(normalizedSourcePath,
                                                       plan.resolvedCallFactSourceBucketHeads.len)
    if bucket < 0:
        return -1
    let entryIndex = plan.resolvedCallFactSourcePaths.len
    LoweringResolvedCallFactAppendSourceRow(
        plan,
        normalizedSourcePath,
        plan.resolvedCallFactSourceBucketHeads[bucket])
    plan.resolvedCallFactSourceBucketHeads[bucket] = entryIndex
    return entryIndex

fn LoweringBuildResolvedCallFactIndex(plan: var LoweringPlanStub) =
    LoweringPlanReleaseResolvedCallFactIndexPayload(plan)
    LoweringResolvedCallFactAllocatorBegin(plan)
    let snapshotRowCount = LoweringResolvedCallSnapshotRowCount(plan)
    let sourceBucketCount = LoweringResolvedCallFactIndexBucketCount(snapshotRowCount / 4 + 4)
    for bucketIndex in 0..<sourceBucketCount:
        LoweringResolvedCallFactAppendSourceBucket(plan, -1)
    let bucketCount = LoweringResolvedCallFactIndexBucketCount(snapshotRowCount)
    var bucketTails: int32[]
    for bucketIndex in 0..<bucketCount:
        LoweringResolvedCallFactAppendLookupBucket(plan, -1)
        loweringSequenceAllocatorAdd(
            plan.resolvedCallFactAllocatorLedger,
            bucketTails,
            -1,
            sizeof(int32))
    for factIndex in 0..<snapshotRowCount:
        let fact = LoweringResolvedCallSnapshotFactAt(plan, factIndex)
        let sourceIndex = LoweringResolvedCallFactFindOrAddSource(plan, fact.sourcePath)
        let bucket = LoweringResolvedCallFactBucket(sourceIndex, fact.lineNumber, bucketCount)
        if bucket < 0:
            continue
        let entryIndex = plan.resolvedCallFactEntryFactIndexes.len
        LoweringResolvedCallFactAppendEntryRow(
            plan,
            -1,
            sourceIndex,
            fact.lineNumber,
            factIndex)
        if plan.resolvedCallFactBucketHeads[bucket] < 0:
            plan.resolvedCallFactBucketHeads[bucket] = entryIndex
        else:
            plan.resolvedCallFactEntryNext[bucketTails[bucket]] = entryIndex
        bucketTails[bucket] = entryIndex
    let _ = loweringSequenceAllocatorRelease(
        plan.resolvedCallFactAllocatorLedger,
        bucketTails,
        sizeof(int32))

@borrows
fn LoweringFindResolvedCallFactIndex(plan: LoweringPlanStub,
                                      sourcePath: str,
                                      lineNumber: int32): int32 =
    if lineNumber <= 0:
        return -1
    let sourceIndex = LoweringResolvedCallFactSourceIndex(plan, sourcePath)
    let bucket = LoweringResolvedCallFactBucket(sourceIndex, lineNumber, plan.resolvedCallFactBucketHeads.len)
    if bucket < 0:
        return -1
    var entryIndex = plan.resolvedCallFactBucketHeads[bucket]
    while entryIndex >= 0:
        if entryIndex >= plan.resolvedCallFactEntryFactIndexes.len:
            return -1
        if plan.resolvedCallFactEntrySourceIndexes[entryIndex] == sourceIndex &&
           plan.resolvedCallFactEntryLineNumbers[entryIndex] == lineNumber:
            return plan.resolvedCallFactEntryFactIndexes[entryIndex]
        entryIndex = plan.resolvedCallFactEntryNext[entryIndex]
    return -1

@borrows
fn LoweringFindResolvedCallFactExact(plan: LoweringPlanStub,
                                      sourcePath: str,
                                      lineNumber: int32,
                                      callQualifier: str,
                                      callCallee: str,
                                      callArgCount: int32,
                                      callArgsText: str): int32 =
    if lineNumber <= 0 || callCallee == "" || callArgCount < 0:
        return -1
    let sourceIndex = LoweringResolvedCallFactSourceIndex(plan, sourcePath)
    let bucket = LoweringResolvedCallFactBucket(sourceIndex,
                                                lineNumber,
                                                plan.resolvedCallFactBucketHeads.len)
    if bucket < 0:
        return -1
    let normalizedArgsText = chengpath.PathTrim(callArgsText)
    var matchedFactIndex: int32 = -1
    var entryIndex = plan.resolvedCallFactBucketHeads[bucket]
    while entryIndex >= 0:
        if entryIndex >= plan.resolvedCallFactEntryFactIndexes.len:
            return -1
        if plan.resolvedCallFactEntrySourceIndexes[entryIndex] == sourceIndex &&
           plan.resolvedCallFactEntryLineNumbers[entryIndex] == lineNumber:
            let factIndex = plan.resolvedCallFactEntryFactIndexes[entryIndex]
            let fact = LoweringResolvedCallSnapshotFactAt(plan, factIndex)
            if fact.callQualifier == callQualifier &&
               fact.callCallee == callCallee &&
               fact.callArgCount == callArgCount &&
               chengpath.PathTrim(fact.callArgsText) == normalizedArgsText:
                if matchedFactIndex < 0:
                    matchedFactIndex = factIndex
                else:
                    let matchedFact = LoweringResolvedCallSnapshotFactAt(plan,
                                                                         matchedFactIndex)
                    if matchedFact.callTarget != fact.callTarget ||
                       parser.ParserNormalizePath(matchedFact.callTargetSourcePath) != parser.ParserNormalizePath(fact.callTargetSourcePath) ||
                       matchedFact.callTargetImportc != fact.callTargetImportc:
                        return -1
        entryIndex = plan.resolvedCallFactEntryNext[entryIndex]
    return matchedFactIndex

@borrows
fn LoweringResolvedCallFactCountInRange(plan: LoweringPlanStub,
                                        sourcePath: str,
                                        firstLine: int32,
                                        lastLine: int32): int32 =
    if firstLine <= 0 || lastLine < firstLine:
        return 0
    let sourceIndex = LoweringResolvedCallFactSourceIndex(plan, sourcePath)
    if sourceIndex < 0:
        return 0
    var count: int32
    var lineNumber = firstLine
    while lineNumber <= lastLine:
        if lineNumber % 128 == 0:
            os.ProcessResourceGuardCheck()
        let bucket = LoweringResolvedCallFactBucket(sourceIndex,
                                                    lineNumber,
                                                    plan.resolvedCallFactBucketHeads.len)
        if bucket >= 0:
            var entryIndex = plan.resolvedCallFactBucketHeads[bucket]
            while entryIndex >= 0:
                if entryIndex >= plan.resolvedCallFactEntryFactIndexes.len:
                    break
                if plan.resolvedCallFactEntrySourceIndexes[entryIndex] == sourceIndex &&
                   plan.resolvedCallFactEntryLineNumbers[entryIndex] == lineNumber:
                    let factIndex = plan.resolvedCallFactEntryFactIndexes[entryIndex]
                    let callTarget = LoweringResolvedCallSnapshotText(plan,
                                                                     plan.resolvedCallSnapshot.callTargetIds[factIndex])
                    if callTarget != "len" && callTarget != "assert":
                        count = count + 1
                entryIndex = plan.resolvedCallFactEntryNext[entryIndex]
        lineNumber = lineNumber + 1
    return count

@borrows
fn LoweringAppendResolvedCallFactsInRange(fnIr: var PrimaryObjectIrFunction,
                                          plan: LoweringPlanStub,
                                          sourceTexts: texpr.TypedExprSourceText[],
                                          sourcePath: str,
                                          firstLine: int32,
                                          lastLine: int32) =
    if firstLine <= 0 || lastLine < firstLine:
        return
    let sourceIndex = LoweringResolvedCallFactSourceIndex(plan, sourcePath)
    if sourceIndex < 0:
        return
    var lineNumber = firstLine
    while lineNumber <= lastLine:
        if lineNumber % 128 == 0:
            os.ProcessResourceGuardCheck()
        let bucket = LoweringResolvedCallFactBucket(sourceIndex,
                                                    lineNumber,
                                                    plan.resolvedCallFactBucketHeads.len)
        if bucket >= 0:
            var entryIndex = plan.resolvedCallFactBucketHeads[bucket]
            while entryIndex >= 0:
                if entryIndex >= plan.resolvedCallFactEntryFactIndexes.len:
                    break
                if plan.resolvedCallFactEntrySourceIndexes[entryIndex] == sourceIndex &&
                   plan.resolvedCallFactEntryLineNumbers[entryIndex] == lineNumber:
                    let factIndex = plan.resolvedCallFactEntryFactIndexes[entryIndex]
                    let fact = LoweringResolvedCallSnapshotFactAt(plan, factIndex)
                    LoweringAppendPrimaryObjectIrCallTargetFact(fnIr, fact, plan, sourceTexts)
                entryIndex = plan.resolvedCallFactEntryNext[entryIndex]
        lineNumber = lineNumber + 1

@borrows
fn LoweringMarkResolvedCallSnapshotReachableInRange(plan: var LoweringPlanStub,
                                                     sourcePath: str,
                                                     firstLine: int32,
                                                     lastLine: int32,
                                                     reachable: var bool[],
                                                     frontier: var int32[]) =
    if firstLine <= 0 || lastLine < firstLine:
        return
    let sourceIndex = LoweringResolvedCallFactSourceIndex(plan, sourcePath)
    if sourceIndex < 0:
        return
    var lineNumber = firstLine
    while lineNumber <= lastLine:
        if lineNumber % 128 == 0:
            os.ProcessResourceGuardCheck()
        let bucket = LoweringResolvedCallFactBucket(sourceIndex,
                                                    lineNumber,
                                                    plan.resolvedCallFactBucketHeads.len)
        if bucket >= 0:
            var entryIndex = plan.resolvedCallFactBucketHeads[bucket]
            while entryIndex >= 0:
                if entryIndex >= plan.resolvedCallFactEntryFactIndexes.len:
                    break
                if plan.resolvedCallFactEntrySourceIndexes[entryIndex] == sourceIndex &&
                   plan.resolvedCallFactEntryLineNumbers[entryIndex] == lineNumber:
                    let factIndex = plan.resolvedCallFactEntryFactIndexes[entryIndex]
                    let fact = LoweringResolvedCallSnapshotFactAt(plan, factIndex)
                    if !fact.callTargetImportc:
                        let factTargetIndex = LoweringPlanFunctionIndex(plan,
                                                                       fact.callTargetSourcePath,
                                                                       fact.callTarget)
                        if factTargetIndex < 0 || factTargetIndex >= reachable.len:
                            panic(Fmt"lowering plan: resolved-call target missing source={fact.sourcePath} line={fact.lineNumber} target_source={fact.callTargetSourcePath} target={fact.callTarget}")
                        LoweringMarkReachableFunctionIndex(factTargetIndex,
                                                          reachable,
                                                          frontier)
                        LoweringMarkReachableAddressArgs(plan,
                                                         fact.sourcePath,
                                                         fact.callArgsText,
                                                         reachable,
                                                         frontier)
                        LoweringMarkReachableEmbeddedCallHeads(plan,
                                                              fact.sourcePath,
                                                              fact.callArgsText,
                                                              reachable,
                                                              frontier)
                entryIndex = plan.resolvedCallFactEntryNext[entryIndex]
        lineNumber = lineNumber + 1

@borrows
fn LoweringPureCastReturnBodyKind(returnTypeRaw: str,
                                  paramNameRaw: str,
                                  paramTypeRaw: str,
                                  returnExprRaw: str): str =
    let paramName = chengpath.PathTrim(paramNameRaw)
    if paramName == "":
        return ""
    let paramType = texpr.TypedExprNormalizeTypeText(paramTypeRaw)
    if paramType != "int32" && paramType != "int64" &&
       paramType != "uint64" && paramType != "float64":
        return ""
    let returnType = texpr.TypedExprNormalizeTypeText(returnTypeRaw)
    var returnExpr = chengpath.PathTrim(returnExprRaw)
    if strutil.StartsWith(returnExpr, "return "):
        returnExpr = chengpath.PathTrim(chengpath.TextSlice(returnExpr,
                                                            len("return "),
                                                            len(returnExpr) - len("return ")))
    if returnExpr == paramName && returnType == paramType:
        if returnType == "int64" || returnType == "uint64":
            return texpr.BodyKindReturnI64Arg0
        if returnType == "float64":
            return texpr.BodyKindReturnF64Arg0
    let openPos = texpr.TypedExprFindWholeCallOpenParen(returnExpr)
    if openPos <= 0:
        return ""
    let closePos = texpr.TypedExprFindMatchingParen(returnExpr, openPos)
    if closePos <= openPos || closePos + 1 != len(returnExpr):
        return ""
    let callHead = chengpath.PathTrim(chengpath.TextSlice(returnExpr, 0, openPos))
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(callHead):
        return ""
    let callArg = chengpath.PathTrim(chengpath.TextSlice(returnExpr,
                                                         openPos + 1,
                                                         closePos - openPos - 1))
    if callArg != paramName:
        return ""
    let callLeaf = texpr.TypedExprQualifiedCallLeaf(callHead)
    var castType = ""
    if callLeaf == "Int8":
        castType = "int8"
    elif callLeaf == "Int16":
        castType = "int16"
    elif callLeaf == "Int32":
        castType = "int32"
    elif callLeaf == "Int64":
        castType = "int64"
    elif callLeaf == "UInt8":
        castType = "uint8"
    elif callLeaf == "UInt16":
        castType = "uint16"
    elif callLeaf == "UInt32":
        castType = "uint32"
    elif callLeaf == "UInt64":
        castType = "uint64"
    elif callLeaf == "Int":
        castType = "int"
    elif callLeaf == "UInt":
        castType = "uint"
    else:
        castType = callLeaf
    castType = texpr.TypedExprNormalizeTypeText(castType)
    if castType != returnType:
        return ""
    if castType == "int64":
        if paramType == "int32":
            return texpr.BodyKindReturnI64FromI32Arg0
        if paramType == "int64":
            return texpr.BodyKindReturnI64Arg0
        return ""
    if castType == "uint64":
        if paramType == "int32":
            return texpr.BodyKindReturnI64FromI32Arg0
        if paramType == "int64" || paramType == "uint64":
            return texpr.BodyKindReturnI64Arg0
        return ""
    if castType == "float64":
        if paramType == "int32":
            return texpr.BodyKindReturnF64FromI32Arg0
        if paramType == "int64":
            return texpr.BodyKindReturnF64FromI64Arg0
    return ""

@borrows
fn LoweringApplyPureCastReturnBodyKind(fnIr: var PrimaryObjectIrFunction,
                                       plan: LoweringPlanStub,
                                       typedFnIndex: int32): bool =
    if fnIr.paramNames.len != 1 || fnIr.paramTypes.len != 1:
        return false
    let fnReturnTypeRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_returnTypeIds[typedFnIndex])
    let fnReturnExprRes: Result[str] = langintern.LookupIntern(plan.typedIr.internPool, plan.typedIr.functions2_returnExprIds[typedFnIndex])
    if !IsOk(fnReturnTypeRes) || !IsOk(fnReturnExprRes):
        return false
    let pureCastBodyKind = LoweringPureCastReturnBodyKind(Value(fnReturnTypeRes),
                                                          fnIr.paramNames[0],
                                                          fnIr.paramTypes[0],
                                                          Value(fnReturnExprRes))
    if pureCastBodyKind == "":
        return false
    fnIr.bodyKind = pureCastBodyKind
    LoweringPrimaryObjectIrCallTargetClear(fnIr)
    return true

@borrows
fn LoweringCallArgNames(callArgsText: str): str[] =
    var out: str[]
    let pieces = texpr.TypedExprSplitTopLevelCsv(callArgsText)
    for i in 0..<pieces.len:
        let name = chengpath.PathTrim(strings.CloneStr(pieces[i]))
        if len(name) > 0:
            add(out, strings.CloneStr(name))
    return out

@borrows
fn LoweringFunctionAddressArgName(textRaw: str): str =
    let text = chengpath.PathTrim(textRaw)
    if len(text) > 1 && text[0] == '&':
        let rawName = chengpath.PathTrim(chengpath.TextSlice(text, 1, len(text) - 1))
        if rawName == "":
            return ""
        if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(rawName):
            return ""
        return rawName
    if len(text) <= 6:
        return ""
    if !chengpath.TextStartsWith(text, "ptr("):
        return ""
    if text[len(text) - 1] != ')':
        return ""
    let inner = chengpath.PathTrim(chengpath.TextSlice(text, 4, len(text) - 5))
    if len(inner) <= 1 || inner[0] != '&':
        return ""
    let rawName = chengpath.PathTrim(chengpath.TextSlice(inner, 1, len(inner) - 1))
    if rawName == "":
        return ""
    if !texpr.TypedExprCallHeadIsPlainQualifiedIdent(rawName):
        return ""
    return rawName

@borrows
fn LoweringConcreteTypeText(typeTextRaw: str): str =
    let typeText = texpr.TypedExprNormalizeTypeText(typeTextRaw)
    if typeText == "" ||
       typeText == "unknown" ||
       typeText == "call_expr":
        return ""
    return typeText

@borrows
fn LoweringStatementMatchesFact(stmt: texpr.TypedExprIrStatement,
                                 fact: texpr.TypedExprFact): bool =
    if parser.ParserNormalizePath(stmt.sourcePath) !=
       parser.ParserNormalizePath(fact.sourcePath):
        return false
    if stmt.lineNumber != fact.lineNumber ||
       stmt.columnNumber != fact.columnNumber:
        return false
    if stmt.exprId != "" && fact.exprId != "" && stmt.exprId != fact.exprId:
        return false
    if stmt.callTarget != "" && fact.callTarget != "" && stmt.callTarget != fact.callTarget:
        return false
    if chengpath.PathTrim(stmt.callArgsText) != "" &&
       chengpath.PathTrim(fact.callArgsText) != "" &&
       chengpath.PathTrim(stmt.callArgsText) != chengpath.PathTrim(fact.callArgsText):
        return false
    return true

@borrows
fn LoweringStatementResultTypeFromFacts(stmt: texpr.TypedExprIrStatement,
                                         facts: texpr.TypedExprFactTable,
                                         startIndex: int32,
                                         endIndex: int32): str =
    let directType = LoweringConcreteTypeText(stmt.resultType)
    if directType != "":
        return directType
    if startIndex < 0 || endIndex < startIndex:
        return ""
    var cappedEnd = endIndex
    if cappedEnd > facts.count:
        cappedEnd = facts.count
    for factIndex in startIndex..<cappedEnd:
        let fact = texpr.TypedExprFactAt(facts, factIndex)
        if !LoweringStatementMatchesFact(stmt, fact):
            continue
        let factType = LoweringConcreteTypeText(fact.typeText)
        if factType != "":
            return factType
    return ""

@borrows
fn LoweringReturnExprMatchesCallFact(returnExprRaw: str,
                                      fact: ccsg.TypedExprFact): bool =
    let returnExpr = chengpath.PathTrim(returnExprRaw)
    if len(returnExpr) <= 0:
        return false
    var surface = fact.callCallee
    if len(fact.callQualifier) > 0:
        surface = Fmt"{fact.callQualifier}.{fact.callCallee}"
    var expected = Fmt"{surface}()"
    if fact.callArgCount > 0:
        expected = Fmt"{surface}({chengpath.PathTrim(fact.callArgsText)})"
    return returnExpr == expected

@borrows
fn LoweringReturnCallArgsPassThrough(paramNames: var str[],
                                      callArgsText: str,
                                      callArgCount: int32): bool =
    if callArgCount <= 0:
        return true
    let callArgNames = LoweringCallArgNames(callArgsText)
    if callArgNames.len != callArgCount:
        return false
    if paramNames.len < callArgCount:
        return false
    for i in 0..<callArgCount:
        if callArgNames[i] != paramNames[i]:
            return false
    return true

@borrows
fn LoweringFindImportcTargetSymbolTyped(typedIr: texpr.TypedExprIr,
                                         sourceTexts: texpr.TypedExprSourceText[],
                                         targetSourcePath: str,
                                         functionName: str,
                                         symbolOut: var str): bool =
    let typedSymbol = texpr.TypedExprIrLookupImportcTargetSymbol(typedIr,
                                                                 targetSourcePath,
                                                                 functionName)
    if typedSymbol != "":
        symbolOut = typedSymbol
        return true
    symbolOut = ""
    return false

@borrows
fn LoweringImportcTargetSymbolTyped(typedIr: texpr.TypedExprIr,
                                     sourceTexts: texpr.TypedExprSourceText[],
                                     targetSourcePath: str,
                                     functionName: str): str =
    var symbol = ""
    if LoweringFindImportcTargetSymbolTyped(typedIr,
                                            sourceTexts,
                                            targetSourcePath,
                                            functionName,
                                            symbol):
        return symbol
    return functionName

fn LoweringPrimaryObjectIrStatementFromTyped(typedStmt: texpr.TypedExprIrStatement): PrimaryObjectIrStatement =
    var out: PrimaryObjectIrStatement
    out.sourcePath = typedStmt.sourcePath
    out.functionName = typedStmt.functionName
    out.statementIndex = typedStmt.statementIndex
    out.lineNumber = typedStmt.lineNumber
    out.columnNumber = typedStmt.columnNumber
    out.endLineNumber = typedStmt.endLineNumber
    out.endColumnNumber = typedStmt.endColumnNumber
    out.lexicalScopeId = typedStmt.lexicalScopeId
    out.suiteScopeId = typedStmt.suiteScopeId
    out.statementOrdinal = typedStmt.statementOrdinal
    out.lexicalOrdinal = typedStmt.lexicalOrdinal
    out.deferOwnerStatementOrdinal = typedStmt.deferOwnerStatementOrdinal
    out.lineIndent = typedStmt.lineIndent
    out.kind = typedStmt.kind
    out.callKind = typedStmt.callKind
    out.detailKind = typedStmt.detailKind
    out.surfaceText = typedStmt.surfaceText
    out.bindingName = typedStmt.bindingName
    out.resultType = typedStmt.resultType
    out.conditionKind = typedStmt.conditionKind
    out.conditionLhsText = typedStmt.conditionLhsText
    out.conditionRhsText = typedStmt.conditionRhsText
    out.conditionLiteralText = typedStmt.conditionLiteralText
    out.assignRootName = typedStmt.assignRootName
    out.assignRootType = typedStmt.assignRootType
    out.assignRootSourcePath = typedStmt.assignRootSourcePath
    out.assignRootGlobalFlag = typedStmt.assignRootGlobalFlag
    out.assignPlaceKind = typedStmt.assignPlaceKind
    out.assignFieldName = typedStmt.assignFieldName
    out.assignFieldType = typedStmt.assignFieldType
    out.assignFieldOffsetBytes = typedStmt.assignFieldOffsetBytes
    out.assignFieldSizeBytes = typedStmt.assignFieldSizeBytes
    out.assignFieldAlignBytes = typedStmt.assignFieldAlignBytes
    out.assignValueRootName = typedStmt.assignValueRootName
    out.assignValueRootType = typedStmt.assignValueRootType
    out.assignValueFieldName = typedStmt.assignValueFieldName
    out.assignValueFieldType = typedStmt.assignValueFieldType
    out.assignValueFieldOffsetBytes = typedStmt.assignValueFieldOffsetBytes
    out.assignValueFieldSizeBytes = typedStmt.assignValueFieldSizeBytes
    out.assignValueFieldAlignBytes = typedStmt.assignValueFieldAlignBytes
    out.assignValueOpKind = typedStmt.assignValueOpKind
    out.assignValueLhsText = typedStmt.assignValueLhsText
    out.assignValueRhsText = typedStmt.assignValueRhsText
    out.callCallee = typedStmt.callCallee
    out.callTarget = typedStmt.callTarget
    out.callTargetSourcePath = typedStmt.callTargetSourcePath
    out.callTargetSignatureLineNumber =
        typedStmt.callTargetSignatureLineNumber
    out.callTargetImportc = typedStmt.callTargetImportc
    out.callArgCount = typedStmt.callArgCount
    out.callArgsText = typedStmt.callArgsText
    out.callArgTypesText = typedStmt.callArgTypesText
    out.callArgNodeStart = typedStmt.callArgNodeStart
    out.callArgNodeCount = typedStmt.callArgNodeCount
    out.rhsNodeIndex = typedStmt.rhsNodeIndex
    out.rhsBailReason = typedStmt.rhsBailReason
    out.callSurfaceKind = typedStmt.callSurfaceKind
    # P2 atomic: typed_expr statement carries no resolution kind yet (init only
    # at lowering→PObjP transition); seed Unresolved so downstream producer
    # (PrimaryBodyIrTargetFunctionIndex) is the sole writer.
    out.callTargetResolutionKind = texpr.CallTargetUnresolved
    out.forStartNodeIndex = typedStmt.forStartNodeIndex
    out.assignLvalueNodeIndex = typedStmt.assignLvalueNodeIndex
    out.assignIndexNodeIndex = typedStmt.assignIndexNodeIndex
    out.bindingTargetDefinitionRow = typedStmt.bindingTargetDefinitionRow
    out.returnRoot = typedStmt.returnRoot
    return out

@borrows
fn LoweringTypedIrImportAliasTargetSourcePath(typedIr: texpr.TypedExprIr,
                                               currentSourcePathRaw: str,
                                               qualifierRaw: str): str =
    let currentSourcePath = parser.ParserNormalizePath(currentSourcePathRaw)
    let qualifier = chengpath.PathTrim(qualifierRaw)
    if currentSourcePath == "" || qualifier == "":
        return ""
    for i in 0..<typedIr.typeAliasSourcePaths.len:
        if i >= typedIr.typeAliasQualifiers.len ||
           i >= typedIr.typeAliasTargetSourcePaths.len:
            continue
        if LoweringSourcePathsEquivalent(typedIr.typeAliasSourcePaths[i], currentSourcePath) &&
           typedIr.typeAliasQualifiers[i] == qualifier:
            return typedIr.typeAliasTargetSourcePaths[i]
    return ""

@borrows
fn LoweringPlanOwnerModulePathForSource(plan: LoweringPlanStub,
                                         sourcePathRaw: str): str =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    if sourcePath == "":
        return ""
    return parser.ParserSourcePathToModulePath(plan.workspaceRoot,
                                               plan.packageRoot,
                                               sourcePath)

@borrows
fn LoweringImportGraphAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    return plan.importEdges.cap > 0 ? 1 : 0

@borrows
fn LoweringImportGraphAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(plan.importEdges.cap) *
           int64(sizeof(parser.ImportEdge))

fn LoweringImportGraphAppendBorrowedEdge(
        plan: var LoweringPlanStub,
        edge: var parser.ImportEdge) =
    var ownedEdge: parser.ImportEdge
    ownedEdge.ownerProducerSourceIndex =
        edge.ownerProducerSourceIndex
    ownedEdge.importDeclarationSourceLocalRow =
        edge.importDeclarationSourceLocalRow
    ownedEdge.importItemSourceLocalRow =
        edge.importItemSourceLocalRow
    ownedEdge.importDeclarationRow =
        edge.importDeclarationRow
    ownedEdge.importItemRow = edge.importItemRow
    ownedEdge.ownerModulePath =
        parser.ParserOwnedText(edge.ownerModulePath)
    ownedEdge.targetModulePath =
        parser.ParserOwnedText(edge.targetModulePath)
    ownedEdge.targetSourcePath =
        parser.ParserOwnedText(edge.targetSourcePath)
    ownedEdge.targetSourcePathLen = edge.targetSourcePathLen
    ownedEdge.targetSourcePathFirstCode =
        edge.targetSourcePathFirstCode
    ownedEdge.targetSourcePathLastCode =
        edge.targetSourcePathLastCode
    ownedEdge.targetSourcePathDotCount =
        edge.targetSourcePathDotCount
    ownedEdge.targetSourcePathHash =
        edge.targetSourcePathHash
    ownedEdge.targetProfileIndex = edge.targetProfileIndex
    ownedEdge.importAlias =
        parser.ParserOwnedText(edge.importAlias)
    ownedEdge.qualifier =
        parser.ParserOwnedText(edge.qualifier)
    ownedEdge.allowsUnqualifiedCall =
        edge.allowsUnqualifiedCall
    ownedEdge.resolved = edge.resolved
    loweringSequenceAllocatorAdd(
        plan.importGraphAllocatorLedger,
        plan.importEdges,
        ownedEdge,
        sizeof(parser.ImportEdge))

fn LoweringImportGraphAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.importGraphAllocatorReceiptReady ||
       LoweringImportGraphAllocatorPhysicalBufferCount(plan) != 0 ||
       LoweringImportGraphAllocatorCapacityBytes(plan) != int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.importGraphAllocatorReceipt):
        panic("lowering import graph allocator: begin before release")
    plan.importGraphAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.importGraphAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.importGraphAllocatorReceiptReady = false

fn LoweringImportGraphAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.importGraphAllocatorReceiptReady:
        if LoweringImportGraphAllocatorPhysicalBufferCount(plan) != 0 ||
           LoweringImportGraphAllocatorCapacityBytes(plan) != int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.importGraphAllocatorReceipt):
            panic("lowering import graph allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringImportGraphAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringImportGraphAllocatorCapacityBytes(plan)
    if plan.importGraphAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.importGraphAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering import graph allocator: allocator/retained drift")
    for edgeIndex in 0..<plan.importEdges.len:
        plan.importEdges[edgeIndex].ownerModulePath = ""
        plan.importEdges[edgeIndex].targetModulePath = ""
        plan.importEdges[edgeIndex].targetSourcePath = ""
        plan.importEdges[edgeIndex].importAlias = ""
        plan.importEdges[edgeIndex].qualifier = ""
    let releasedBytes = loweringSequenceAllocatorRelease(
        plan.importGraphAllocatorLedger,
        plan.importEdges,
        sizeof(parser.ImportEdge))
    plan.importGraphAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.importGraphAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.importGraphAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.importGraphAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.importGraphAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        releasedBytes > int64(0) ? 1 : 0
    receipt.terminalReleasedBytes = releasedBytes
    receipt.liveAllocationCount =
        plan.importGraphAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.importGraphAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringImportGraphAllocatorPhysicalBufferCount(plan) == 0 &&
        LoweringImportGraphAllocatorCapacityBytes(plan) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering import graph allocator: receipt incomplete")
    plan.importGraphAllocatorReceipt = receipt
    plan.importGraphAllocatorReceiptReady = true
    plan.importGraphAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringPlanReleaseImportGraphPayload(
        plan: var LoweringPlanStub) =
    LoweringImportGraphAllocatorRelease(plan)

@borrows
fn LoweringImportEdgeIndexBucket(ownerModulePath: str,
                                  qualifier: str,
                                  bucketCount: int32): int32 =
    if ownerModulePath == "" || qualifier == "" || bucketCount <= 0:
        return -1
    return (parser.ParserTextLookupContentHash(ownerModulePath) ^
            parser.ParserTextLookupContentHash(qualifier)) & (bucketCount - 1)

@borrows
fn LoweringImportEdgeIndexAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.importEdgeIndexOwnerModulePaths.cap > 0: count = count + 1
    if plan.importEdgeIndexQualifiers.cap > 0: count = count + 1
    if plan.importEdgeIndexEntryEdgeIndexes.cap > 0: count = count + 1
    if plan.importEdgeIndexBucketHeads.cap > 0: count = count + 1
    if plan.importEdgeIndexEntryNext.cap > 0: count = count + 1
    return count

@borrows
fn LoweringImportEdgeIndexAllocatorCapacityBytes(
        plan: LoweringPlanStub): int64 =
    return int64(plan.importEdgeIndexOwnerModulePaths.cap) *
            int64(sizeof(str)) +
        int64(plan.importEdgeIndexQualifiers.cap) *
            int64(sizeof(str)) +
        int64(plan.importEdgeIndexEntryEdgeIndexes.cap) *
            int64(sizeof(int32)) +
        int64(plan.importEdgeIndexBucketHeads.cap) *
            int64(sizeof(int32)) +
        int64(plan.importEdgeIndexEntryNext.cap) *
            int64(sizeof(int32))

fn LoweringImportEdgeIndexAppendBucket(
        plan: var LoweringPlanStub,
        bucketHead: int32) =
    loweringSequenceAllocatorAdd(
        plan.importEdgeIndexAllocatorLedger,
        plan.importEdgeIndexBucketHeads,
        bucketHead,
        sizeof(int32))

@borrows
fn LoweringImportEdgeIndexAppendRow(
        plan: var LoweringPlanStub,
        ownerModulePath: str,
        qualifier: str,
        edgeIndex: int32,
        entryNext: int32) =
    let rowCount = plan.importEdgeIndexOwnerModulePaths.len
    if plan.importEdgeIndexQualifiers.len != rowCount ||
       plan.importEdgeIndexEntryEdgeIndexes.len != rowCount ||
       plan.importEdgeIndexEntryNext.len != rowCount:
        panic("lowering import edge index allocator: row shape drift")
    loweringSequenceAllocatorAdd(
        plan.importEdgeIndexAllocatorLedger,
        plan.importEdgeIndexOwnerModulePaths,
        ownerModulePath,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.importEdgeIndexAllocatorLedger,
        plan.importEdgeIndexQualifiers,
        qualifier,
        sizeof(str))
    loweringSequenceAllocatorAdd(
        plan.importEdgeIndexAllocatorLedger,
        plan.importEdgeIndexEntryEdgeIndexes,
        edgeIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        plan.importEdgeIndexAllocatorLedger,
        plan.importEdgeIndexEntryNext,
        entryNext,
        sizeof(int32))

fn loweringImportEdgeIndexAccumulateTerminalRelease(
        releasedBytes: int64,
        releasedBufferCount: var int32,
        totalReleasedBytes: var int64) =
    if releasedBytes > int64(0):
        releasedBufferCount = releasedBufferCount + 1
        totalReleasedBytes = totalReleasedBytes + releasedBytes

fn LoweringImportEdgeIndexAllocatorBegin(
        plan: var LoweringPlanStub) =
    if !plan.importEdgeIndexAllocatorReceiptReady ||
       LoweringImportEdgeIndexAllocatorPhysicalBufferCount(plan) != 0 ||
       LoweringImportEdgeIndexAllocatorCapacityBytes(plan) != int64(0) ||
       !LoweringSequenceAllocatorReceiptClosed(
           plan.importEdgeIndexAllocatorReceipt):
        panic("lowering import edge index allocator: begin before release")
    plan.importEdgeIndexAllocatorLedger =
        LoweringSequenceAllocatorLedger()
    plan.importEdgeIndexAllocatorReceipt =
        LoweringSequenceAllocatorReceipt()
    plan.importEdgeIndexAllocatorReceiptReady = false

fn LoweringImportEdgeIndexAllocatorRelease(
        plan: var LoweringPlanStub) =
    if plan.importEdgeIndexAllocatorReceiptReady:
        if LoweringImportEdgeIndexAllocatorPhysicalBufferCount(plan) != 0 ||
           LoweringImportEdgeIndexAllocatorCapacityBytes(plan) != int64(0) ||
           !LoweringSequenceAllocatorReceiptClosed(
               plan.importEdgeIndexAllocatorReceipt):
            panic("lowering import edge index allocator: repeat release drift")
        return
    var receipt: LoweringSequenceAllocatorReceipt
    receipt.terminalRetainedBufferCount =
        LoweringImportEdgeIndexAllocatorPhysicalBufferCount(plan)
    receipt.terminalRetainedBytes =
        LoweringImportEdgeIndexAllocatorCapacityBytes(plan)
    if plan.importEdgeIndexAllocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       plan.importEdgeIndexAllocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering import edge index allocator: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    loweringImportEdgeIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.importEdgeIndexAllocatorLedger,
            plan.importEdgeIndexOwnerModulePaths,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringImportEdgeIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.importEdgeIndexAllocatorLedger,
            plan.importEdgeIndexQualifiers,
            sizeof(str)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringImportEdgeIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.importEdgeIndexAllocatorLedger,
            plan.importEdgeIndexEntryEdgeIndexes,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringImportEdgeIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.importEdgeIndexAllocatorLedger,
            plan.importEdgeIndexBucketHeads,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    loweringImportEdgeIndexAccumulateTerminalRelease(
        loweringSequenceAllocatorRelease(
            plan.importEdgeIndexAllocatorLedger,
            plan.importEdgeIndexEntryNext,
            sizeof(int32)),
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    plan.importEdgeIndexAllocatorLedger.closed = true
    receipt.allocationEventCount =
        plan.importEdgeIndexAllocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        plan.importEdgeIndexAllocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        plan.importEdgeIndexAllocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        plan.importEdgeIndexAllocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        terminalReleasedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        plan.importEdgeIndexAllocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        plan.importEdgeIndexAllocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringImportEdgeIndexAllocatorPhysicalBufferCount(plan) == 0 &&
        LoweringImportEdgeIndexAllocatorCapacityBytes(plan) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering import edge index allocator: receipt incomplete")
    plan.importEdgeIndexAllocatorReceipt = receipt
    plan.importEdgeIndexAllocatorReceiptReady = true
    plan.importEdgeIndexAllocatorLedger =
        LoweringSequenceAllocatorLedger()

fn LoweringPlanReleaseImportEdgeIndexPayload(
        plan: var LoweringPlanStub) =
    LoweringImportEdgeIndexAllocatorRelease(plan)

@borrows
fn LoweringImportOwnerIndexBucket(ownerModulePath: str,
                                   bucketCount: int32): int32 =
    if ownerModulePath == "" || bucketCount <= 0:
        return -1
    return parser.ParserTextLookupContentHash(ownerModulePath) & (bucketCount - 1)

@borrows
fn LoweringImportOwnerIndexAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.importOwnerIndexOwnerModulePaths.cap > 0: count = count + 1
    if plan.importOwnerIndexEntryEdgeIndexes.cap > 0: count = count + 1
    if plan.importOwnerIndexBucketHeads.cap > 0: count = count + 1
    if plan.importOwnerIndexEntryNext.cap > 0: count = count + 1
    return count

@borrows
