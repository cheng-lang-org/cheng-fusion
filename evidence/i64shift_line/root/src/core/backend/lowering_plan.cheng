        resolvedCallSnapshot: ccsg.CompilerCsgSemanticResolvedCallTable
        externFfiHandleCallCapabilityBridge:
            LoweringExternFfiHandleCallCapabilityBridge
        manualConsumeCallBridge: LoweringManualConsumeCallBridge
        resolvedCallTargetTypedFunctionIndexes: int32[]
        resolvedCallTargetProjectionOwner: LoweringResolvedCallTargetProjectionOwner
        resolvedCallFactSourcePaths: str[]
