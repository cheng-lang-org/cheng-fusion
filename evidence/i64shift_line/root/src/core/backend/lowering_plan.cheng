@borrows
fn LoweringBodyKindCode(kind: str): int32 =
    if kind == texpr.BodyKindUnsupported:
        return 10
    if kind == texpr.BodyKindStatementSequence:
        return 12
    if kind == texpr.BodyKindReturnVoid:
        return 13
    if len(kind) > 0:
        return 99
    return 0

fn LoweringCallConvInternal(): int32 =
    return 1

fn LoweringRegallocCanonicalAllocatorImportBound(): bool =
    let constraints = contract.CodegenUnitConstraintSet("arm64-apple-darwin")
    return constraints.registerUniverse.len == 31 &&
           constraints.fixedArgRegs.len == 8 &&
           constraints.fixedResultReg == 0 &&
           constraints.fixedSretReg == 8 &&
           constraints.fixedReturnReg == 0 &&
           constraints.parallelCopyScratchReg == 16 &&
           constraints.stackAlignmentBytes == 16

fn LoweringRegallocProductionReceiptMissingDependency(): str =
    return ""

fn LoweringLayoutKindInvalid(): int32 =
    return 0

fn LoweringLayoutKindI32(): int32 =
    return 5

@borrows
fn LoweringAppendLine(out: var str, key: str, value: str) =
    if len(out) > 0:
        out = Fmt"{out}\n"
    out = Fmt"{out}{key}={value}"

# parts-builder 版本: 避免 var-str 累加在 N 行上 O(N^2) 复制累积串。
# dispatch_min census full materialize 路径下,LoweringPlanStubReport 调用 79 次
# 该 helper,GB 级 subreport 注入后再调用 4 次尾部 append 实测复制 16GB+(8GB
# guard 杀点)。新 helper 用 add 进 parts,函数末尾单次 strutil.Join。
@borrows
fn LoweringReportPartsAppendText(
        owner: var LoweringReportPartsOwner,
        value: str) =
    if owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()):
        panic("lowering report parts: append after close")
    var parts = owner.parts
    owner.parts = []
    loweringSequenceAllocatorAdd(
        owner.allocatorLedger,
        parts,
        value,
        sizeof(str))
    owner.parts = parts

@borrows
fn LoweringReportPartsAppendLine(
        owner: var LoweringReportPartsOwner,
        key: str,
        value: str) =
    if owner.parts.len > 0:
        LoweringReportPartsAppendText(owner, "\n")
    LoweringReportPartsAppendText(owner, key)
    LoweringReportPartsAppendText(owner, "=")
    LoweringReportPartsAppendText(owner, value)

@borrows
fn LoweringReportPartsAppendBlock(
        owner: var LoweringReportPartsOwner,
        value: str) =
    if value.len <= 0:
        return
    if owner.parts.len > 0:
        LoweringReportPartsAppendText(owner, "\n")
    LoweringReportPartsAppendText(owner, value)

fn LoweringReportPartsPhysicalBufferCount(
        owner: var LoweringReportPartsOwner): int32 =
    return owner.parts.cap > 0 ? 1 : 0

fn LoweringReportPartsCapacityBytes(
        owner: var LoweringReportPartsOwner): int64 =
    return int64(owner.parts.cap) * int64(sizeof(str))

@borrows
fn loweringReportPartsOwnerToken(
        receipt: LoweringSequenceAllocatorReceipt): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(128)
    loweringPlanReleaseAppendText(
        buf, "cheng.compiler.lowering.report_parts")
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocationEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releaseEventCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.allocatedCapacityBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.releasedCapacityBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalRetainedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalRetainedBytes)
    loweringPlanReleaseAppendU32Field(
        buf, receipt.terminalReleasedBufferCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.terminalReleasedBytes)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveAllocationCount)
    loweringPlanReleaseAppendI64Field(
        buf, receipt.liveCapacityBytes)
    let token = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return token

fn LoweringReportPartsReleaseWithReceipt(
        owner: var LoweringReportPartsOwner,
        receipt: var LoweringSequenceAllocatorReceipt) =
    if owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !layout.FixedBytes32Equal(
           owner.ownerToken, layout.FixedBytes32()) ||
       owner.allocatorLedger.liveAllocationCount !=
           int64(LoweringReportPartsPhysicalBufferCount(owner)) ||
       owner.allocatorLedger.liveCapacityBytes !=
           LoweringReportPartsCapacityBytes(owner):
        panic("lowering report parts: owner state drift")
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringReportPartsPhysicalBufferCount(owner)
    receipt.terminalRetainedBytes =
        LoweringReportPartsCapacityBytes(owner)
    let terminalReleasedBytes =
        loweringSequenceAllocatorRelease(
            owner.allocatorLedger,
            owner.parts,
            sizeof(str))
    owner.allocatorLedger.closed = true
    receipt.allocationEventCount =
        owner.allocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        owner.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        owner.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        owner.allocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        receipt.terminalRetainedBufferCount
    receipt.terminalReleasedBytes = terminalReleasedBytes
    receipt.liveAllocationCount =
        owner.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        owner.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringReportPartsPhysicalBufferCount(owner) == 0 &&
        LoweringReportPartsCapacityBytes(owner) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering report parts: receipt incomplete")
    owner.allocatorReceipt = receipt
    owner.ownerToken =
        loweringReportPartsOwnerToken(receipt)
    owner.allocatorReceiptReady = true
    owner.allocatorLedger = LoweringSequenceAllocatorLedger()

fn LoweringReportPartsReceiptConsumeStrict(
        owner: var LoweringReportPartsOwner,
        receipt: LoweringSequenceAllocatorReceipt): bool =
    if !owner.allocatorReceiptReady ||
       owner.allocatorReceiptConsumed ||
       !LoweringSequenceAllocatorReceiptEqual(
           receipt, owner.allocatorReceipt) ||
       !LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !layout.FixedBytes32Equal(
           owner.ownerToken,
           loweringReportPartsOwnerToken(receipt)) ||
       LoweringReportPartsPhysicalBufferCount(owner) != 0 ||
       LoweringReportPartsCapacityBytes(owner) != int64(0):
        return false
    owner.allocatorReceiptConsumed = true
    return true

fn LoweringFinalizeBodyIrNoAlias(fnIr: var PrimaryObjectIrFunction) =
    var stats: noalias.BodyIrNoAliasFinalizeStats
    noalias.BodyIrNoAliasFinalizeInPlace(fnIr.bodyIR, stats)
    fnIr.bodyIrNoAliasApplied = stats.applied
    fnIr.bodyIrNoAliasLocalCount = stats.localCount
    fnIr.bodyIrNoAliasForwardRewriteCount = stats.forwardRewriteCount
    if !stats.dodSoAContractOk:
        fnIr.bodyKind = "body_ir_dod_soa_contract_invalid"

fn LoweringCopyPrimaryObjectIrFunctionInto(src: var PrimaryObjectIrFunction,
                                            out: var PrimaryObjectIrFunction) =
    out.sourcePath = src.sourcePath
    out.functionName = src.functionName
    out.signatureLineNumber = src.signatureLineNumber
    out.bodyLineNumber = src.bodyLineNumber
    out.bodyKind = src.bodyKind
    out.typedFunctionIndex = src.typedFunctionIndex
    out.paramNames = src.paramNames
    out.paramTypes = src.paramTypes
    out.statementCount = src.statementCount
    out.statements = src.statements
    out.functionShapeAllocatorLedger =
        src.functionShapeAllocatorLedger
    out.callTargetCount = src.callTargetCount
    out.callArgCounts = src.callArgCounts
    out.callTargets = src.callTargets
    out.callTargetSourcePaths = src.callTargetSourcePaths
    out.callTargetSignatureLineNumbers = src.callTargetSignatureLineNumbers
    out.callTargetImportcFlags = src.callTargetImportcFlags
    out.callTargetTypedFunctionIndexes =
        src.callTargetTypedFunctionIndexes
    out.callImportcSymbols = src.callImportcSymbols
    out.callArgTypesTexts = src.callArgTypesTexts
    out.callTargetAllocatorLedger = src.callTargetAllocatorLedger
    out.deferScopeTransport = src.deferScopeTransport
    out.ownershipTransport = src.ownershipTransport
    out.bodyIR = src.bodyIR
    out.bodyIrNoAliasApplied = src.bodyIrNoAliasApplied
    out.bodyIrNoAliasLocalCount = src.bodyIrNoAliasLocalCount
    out.bodyIrNoAliasForwardRewriteCount = src.bodyIrNoAliasForwardRewriteCount

var loweringPhaseReady: bool
var loweringPhaseEnabled: bool
var loweringPhaseLastNs: int64

@borrows
fn LoweringProgress(label: str) =
    if !loweringPhaseReady:
        loweringPhaseEnabled = os.GetEnv("CHENG_LOWERING_PHASE") == "1"
        loweringPhaseLastNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        loweringPhaseReady = true
    if !loweringPhaseEnabled:
        return
    let nowNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    let sinceMs = (nowNs - loweringPhaseLastNs) / int64(1000000)
    loweringPhaseLastNs = nowNs
    os.WriteLine(os.Get_stderr(), Fmt"lowering_phase={label} since_ms={strings.Int64ToStr(sinceMs)}")

var loweringTraceReady: bool
var loweringTraceEnabled: bool
var loweringTraceFilter: str

@borrows
fn LoweringDebugLine(line: str) =
    if !loweringTraceReady:
        loweringTraceEnabled = os.GetEnv("CHENG_LOWERING_TRACE") == "1"
        loweringTraceFilter = os.GetEnv("CHENG_LOWERING_TRACE_FILTER")
        loweringTraceReady = true
    if !loweringTraceEnabled:
        return
    if loweringTraceFilter != "" && !strutil.Contains(line, loweringTraceFilter):
        return
    os.WriteLine(os.Get_stderr(), line)

# Call-site gate for LoweringDebugLine(Fmt...) in hot paths. The Fmt argument
# materializes at the call site even when tracing is off (~322B per call); the
# O(N^2) statement dedup scan turned one such site into GB-level allocator
# churn. Hot sites must do `if LoweringTraceOn(): LoweringDebugLine(Fmt...)`.
fn LoweringTraceOn(): bool =
    if !loweringTraceReady:
        loweringTraceEnabled = os.GetEnv("CHENG_LOWERING_TRACE") == "1"
        loweringTraceFilter = os.GetEnv("CHENG_LOWERING_TRACE_FILTER")
        loweringTraceReady = true
    return loweringTraceEnabled

var loweringRowDebugReady: bool
var loweringRowDebugName: str

# CHENG_LOWERING_ROW_DEBUG is probed in per-fact/per-function loops; per-call
# os.GetEnv allocates ~32B each probe, so cache the value once per process.
fn LoweringRowDebugEnabled(): bool =
    if !loweringRowDebugReady:
        loweringRowDebugName = os.GetEnv("CHENG_LOWERING_ROW_DEBUG")
        loweringRowDebugReady = true
    return loweringRowDebugName != ""

fn LoweringResourceGuardCheck() =
    if loweringParallelWorkerCount > 0:
        return
    os.ProcessResourceGuardCheck()

fn LoweringDebugStderr(): bool =
    return os.GetEnv("CHENG_LOWERING_DEBUG_STDERR") == "1"

@borrows
fn LoweringListText(items: str[]): str =
    if items.len <= 0:
        return "-"
    var out = ""
    for i in 0..<items.len:
        if len(out) > 0:
            out = Fmt"{out},"
        out = Fmt"{out}{items[i]}"
    return out

@borrows
fn LoweringFunctionSymbolText(ownerModulePath: str, functionName: str): str =
    return Fmt"{ownerModulePath}::{functionName}"

@borrows
fn loweringFunctionSymbolUtf8Valid(text: str): bool =
    var cursor: int32
    while cursor < text.len:
        let b0 = int32(text[cursor]) & 255
        if b0 <= 127:
            cursor = cursor + 1
        elif b0 >= 194 && b0 <= 223:
            if cursor + 1 >= text.len:
                return false
            let b1 = int32(text[cursor + 1]) & 255
            if b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 2
        elif b0 >= 224 && b0 <= 239:
            if cursor + 2 >= text.len:
                return false
            let b1 = int32(text[cursor + 1]) & 255
            let b2 = int32(text[cursor + 2]) & 255
            if b2 < 128 || b2 > 191:
                return false
            if b0 == 224:
                if b1 < 160 || b1 > 191:
                    return false
            elif b0 == 237:
                if b1 < 128 || b1 > 159:
                    return false
            elif b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 3
        elif b0 >= 240 && b0 <= 244:
            if cursor + 3 >= text.len:
                return false
            let b1 = int32(text[cursor + 1]) & 255
            let b2 = int32(text[cursor + 2]) & 255
            let b3 = int32(text[cursor + 3]) & 255
            if b2 < 128 || b2 > 191 || b3 < 128 || b3 > 191:
                return false
            if b0 == 240:
                if b1 < 144 || b1 > 191:
                    return false
            elif b0 == 244:
                if b1 < 128 || b1 > 143:
                    return false
            elif b1 < 128 || b1 > 191:
                return false
            cursor = cursor + 4
        else:
            return false
    return true

fn loweringFunctionSymbolHexNibble(value: int32): int32 =
    if value >= 0 && value <= 9:
        return int32('0') + value
    if value >= 10 && value <= 15:
        return int32('a') + value - 10
    panic("lowering function symbol mangle: nibble out of range")
    return int32('0')

# Canonical injective symbol framing.  The byte length and full lowercase-hex
# payload make every UTF-8 source byte recoverable; '/', '.', '-', '_' and
# their literal escape-looking spellings therefore cannot collapse together.
@borrows
fn LoweringFunctionSymbolMangleOwned(text: str): str =
    # `c` + at most ten decimal digits + `_` + two hex digits per byte.
    if text.len > 1073741817 ||
       !loweringFunctionSymbolUtf8Valid(text):
        panic("lowering function symbol mangle: source invalid")
    var out = buffer.NewByteBuffer()
    buffer.AppendByte(out, int32('c'))
    let byteLengthText = strings.IntToStr(text.len)
    for lengthIndex in 0..<byteLengthText.len:
        buffer.AppendByte(
            out, int32(byteLengthText[lengthIndex]) & 255)
    buffer.AppendByte(out, int32('_'))
    for byteIndex in 0..<text.len:
        let byteValue = int32(text[byteIndex]) & 255
        buffer.AppendByte(
            out, loweringFunctionSymbolHexNibble((byteValue >> 4) & 15))
        buffer.AppendByte(
            out, loweringFunctionSymbolHexNibble(byteValue & 15))
    return buffer.FinishString(out)

fn loweringFunctionSymbolHexValue(value: int32): int32 =
    if value >= int32('0') && value <= int32('9'):
        return value - int32('0')
    if value >= int32('a') && value <= int32('f'):
        return value - int32('a') + 10
    return -1

# Parse and compare the framing without allocating a second encoded string.
# Rejects uppercase hex, leading-zero lengths and any non-canonical spelling.
@borrows
fn LoweringFunctionSymbolMangleStrictValid(
        text: str,
        mangled: str): bool =
    if !loweringFunctionSymbolUtf8Valid(text) ||
       text.len > 1073741817 ||
       mangled.len < 3 || mangled[0] != 'c':
        return false
    var cursor: int32 = 1
    var decodedLength: int32
    var digitCount: int32
    while cursor < mangled.len && mangled[cursor] != '_':
        let digit = int32(mangled[cursor]) - int32('0')
        if digit < 0 || digit > 9 ||
           (digitCount == 0 && digit == 0 &&
            cursor + 1 < mangled.len && mangled[cursor + 1] != '_') ||
           decodedLength > (2147483647 - digit) / 10:
            return false
        decodedLength = decodedLength * 10 + digit
        digitCount = digitCount + 1
        cursor = cursor + 1
    if digitCount <= 0 || cursor >= mangled.len ||
       mangled[cursor] != '_' || decodedLength != text.len ||
       mangled.len - cursor - 1 != text.len * 2:
        return false
    cursor = cursor + 1
    for byteIndex in 0..<text.len:
        let high = loweringFunctionSymbolHexValue(
            int32(mangled[cursor + byteIndex * 2]) & 255)
        let low = loweringFunctionSymbolHexValue(
            int32(mangled[cursor + byteIndex * 2 + 1]) & 255)
        if high < 0 || low < 0 ||
           ((high << 4) | low) !=
               (int32(text[byteIndex]) & 255):
            return false
    return true

@borrows
fn loweringFunctionSymbolTargetDecorateOwned(
        targetTriple: str,
        raw: str,
        decorationKind: var int32): str =
    decorationKind = 0
    if contract.CodegenUnitDecoratesLeadingUnderscore(targetTriple):
        if raw.len >= 2147483647:
            panic("lowering function symbol decoration: length overflow")
        decorationKind = 1
        return Fmt"_{raw}"
    return strings.CloneStr(raw)

# Unique production projection shared by primary and backend2.  Every lookup
# starts from the exact TypedExpr row/InternId pair.  Export/name strings are
# immutable receipt-bound payload only; no text, leaf, or name+arity lookup is
# performed here.  Target decoration occurs exactly once at this boundary.
@borrows
fn LoweringProjectFunctionSymbolExact(
        plan: var LoweringPlanStub,
        linkPlan: var slplan.SystemLinkPlanStub,
        functionRow: int32): LoweringFunctionSymbolProjection =
    if functionRow < 0 ||
       functionRow >= plan.functionTypedIrIndexes.len ||
       functionRow >= plan.functionNameIds.len ||
       functionRow >= plan.functionNames.len ||
       functionRow >= plan.functionSymbolTexts.len ||
       functionRow >= plan.functionOwnerModulePaths.len ||
       functionRow >= plan.functionSignatureLineNumbers.len ||
       functionRow >= plan.functionExportedFlags.len ||
       functionRow >= plan.functionExportSymbolNames.len ||
       functionRow >= plan.functionExportNameExplicitFlags.len ||
       functionRow >= plan.functionExportProducerSourceIndexes.len ||
       functionRow >=
           plan.functionExportProducerDeclarationIndexes.len ||
       functionRow >= plan.functionExportProducerNodeIds.len ||
       functionRow >= plan.functionExportProducerFactCids.len ||
       functionRow >= plan.functionEntryFlags.len ||
       layout.FixedBytes32Equal(
           plan.functionNameInternPoolDomainCid,
           layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           plan.functionNameIdentityReceiptCid,
           layout.FixedBytes32()):
        panic("lowering function symbol projection: authority shape invalid")
    let typedFunctionIndex = plan.functionTypedIrIndexes[functionRow]
    let originalNameId = plan.functionNameIds[functionRow]
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >= plan.typedIr.functions2_functionNameIds.len ||
       plan.typedIr.functions2_functionNameIds[typedFunctionIndex] !=
           originalNameId:
        panic("lowering function symbol projection: typed identity drift")
    let nameRes: Result[str] =
        langintern.LookupInternOwnedCopy(
            plan.typedIr.internPool, originalNameId)
    if !IsOk(nameRes):
        panic("lowering function symbol projection: intern lookup failed")
    let ownedFunctionName = Value(nameRes)
    if ownedFunctionName != plan.functionNames[functionRow] ||
       !loweringFunctionSymbolUtf8Valid(ownedFunctionName):
        panic("lowering function symbol projection: intern payload drift")
    var payload = LoweringFunctionSymbolText(
        plan.functionOwnerModulePaths[functionRow], ownedFunctionName)
    if payload != plan.functionSymbolTexts[functionRow]:
        panic("lowering function symbol projection: typed payload drift")
    var role = LoweringFunctionSymbolRoleTypedName
    let exportNameExplicit =
        plan.functionExportNameExplicitFlags[functionRow]
    let exportProducerSourceIndex =
        plan.functionExportProducerSourceIndexes[functionRow]
    let exportProducerDeclarationIndex =
        plan.functionExportProducerDeclarationIndexes[functionRow]
    let exportProducerNodeId =
        plan.functionExportProducerNodeIds[functionRow]
    let exportProducerFactCid = layout.FixedBytes32Copy(
        plan.functionExportProducerFactCids[functionRow])
    let producerLineagePresent =
        exportProducerSourceIndex >= 0 &&
        exportProducerDeclarationIndex >= 0 &&
        exportProducerNodeId > 0 &&
        !layout.FixedBytes32Equal(
            exportProducerFactCid, layout.FixedBytes32())
    let producerLineageAbsent =
        exportProducerSourceIndex == -1 &&
        exportProducerDeclarationIndex == -1 &&
        exportProducerNodeId == -1 &&
        layout.FixedBytes32Equal(
            exportProducerFactCid, layout.FixedBytes32())
    if (!producerLineagePresent && !producerLineageAbsent) ||
       (exportNameExplicit != 0 && exportNameExplicit != 1):
        panic("lowering function symbol projection: producer lineage invalid")
    if plan.functionExportedFlags[functionRow] != 0:
        if plan.functionExportSymbolNames[functionRow] == "" ||
           !producerLineagePresent:
            panic("lowering function symbol projection: export payload missing")
        payload = strings.CloneStr(
            plan.functionExportSymbolNames[functionRow])
        role = LoweringFunctionSymbolRoleExplicitExport
    elif plan.functionExportSymbolNames[functionRow] != "":
        panic("lowering function symbol projection: unowned export payload")
    let effectiveExplicitExport =
        plan.functionExportedFlags[functionRow] != 0 &&
        exportNameExplicit != 0
    if linkPlan.emitKind == creq.EmitExe &&
       plan.functionEntryFlags[functionRow] != 0 &&
       !effectiveExplicitExport:
        payload = linkPlan.moduleKind ==
            slplan.SystemCompilerControlPlane ?
            "cheng_tooling_source_entry" :
            "cheng_program_source_entry"
        role = LoweringFunctionSymbolRoleSourceEntry
    elif linkPlan.emitKind == creq.EmitObj &&
         plan.functionEntryFlags[functionRow] != 0 &&
         typedFunctionIndex == plan.sourceEntryTypedFunctionIndex &&
         linkPlan.exportRootSymbols.len == 0 &&
         !effectiveExplicitExport:
        # `main` is ordinary interned data.  No InternId value is privileged.
        payload = strings.CloneStr(ownedFunctionName)
        role = LoweringFunctionSymbolRoleSourceEntry
    if payload == "" || !loweringFunctionSymbolUtf8Valid(payload):
        panic("lowering function symbol projection: payload is not UTF-8")
    # Explicit export is a public ABI payload: preserve every UTF-8 byte and
    # add only the target ABI prefix.  Internal typed names alone receive the
    # module/line-scope mangle.
    var targetPayload = strings.CloneStr(payload)
    if role == LoweringFunctionSymbolRoleTypedName:
        var lineScoped: bool
        if payload.len >= 2:
            for byteIndex in 0..<(payload.len - 1):
                if payload[byteIndex] == ':' && payload[byteIndex + 1] == ':':
                    lineScoped = true
        targetPayload = LoweringFunctionSymbolMangleOwned(payload)
        if !LoweringFunctionSymbolMangleStrictValid(
               payload, targetPayload):
            panic("lowering function symbol projection: mangle not canonical")
        if lineScoped &&
           plan.functionSignatureLineNumbers[functionRow] > 0:
            let lineScopeSuffix = Fmt"__L{strings.IntToStr(plan.functionSignatureLineNumbers[functionRow])}"
            if targetPayload.len > 2147483647 - lineScopeSuffix.len:
                panic("lowering function symbol projection: length overflow")
            targetPayload = Fmt"{targetPayload}{lineScopeSuffix}"
    var decorationKind: int32
    let decorated = loweringFunctionSymbolTargetDecorateOwned(
        linkPlan.targetTriple, targetPayload, decorationKind)
    if decorated == "" || !loweringFunctionSymbolUtf8Valid(decorated):
        panic("lowering function symbol projection: decorated payload invalid")
    var out: LoweringFunctionSymbolProjection
    out.functionRow = functionRow
    out.typedFunctionIndex = typedFunctionIndex
    out.originalNameId = originalNameId
    out.explicitExportNameExplicit = exportNameExplicit
    out.exportProducerSourceIndex = exportProducerSourceIndex
    out.exportProducerDeclarationIndex =
        exportProducerDeclarationIndex
    out.exportProducerNodeId = exportProducerNodeId
    out.exportProducerFactCid = exportProducerFactCid
    out.role = role
    out.targetDecorationKind = decorationKind
    out.payloadUtf8 = payload
    out.decoratedUtf8 = decorated
    out.internPoolDomainCid = layout.FixedBytes32Copy(
        plan.functionNameInternPoolDomainCid)
    out.loweringIdentityReceiptCid = layout.FixedBytes32Copy(
        plan.functionNameIdentityReceiptCid)
    return out

fn loweringFunctionNameIdentityAppendU32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

@borrows
fn loweringFunctionNameIdentityAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    loweringFunctionNameIdentityAppendU32(buf, value.len)
    for byteIndex in 0..<value.len:
        layout.ByteBufAppendByte(buf, int32(value[byteIndex]) & 255)

@borrows
fn LoweringFunctionNameInternPoolDomainCid(
        plan: LoweringPlanStub): layout.FixedBytes32 =
    if plan.typedIr.internPool == nil ||
       layout.FixedBytes32Equal(
           plan.canonicalSnapshotProjectionAuthorityCid,
           layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           plan.compilerCsgCid,
           layout.FixedBytes32()):
        panic("lowering function name identity: intern domain authority missing")
    var buf = layout.ByteBufInit(256)
    loweringFunctionNameIdentityAppendText(
        buf, "cheng.compiler.function_name_intern_projection.v1")
    layout.ByteBufAppendFixed32(
        buf, plan.canonicalSnapshotProjectionAuthorityCid)
    layout.ByteBufAppendFixed32(buf, plan.compilerCsgCid)
    loweringFunctionNameIdentityAppendU32(
        buf, plan.typedIr.functions2_functionNameIds.len)
    for typedFunctionIndex in 0..<
            plan.typedIr.functions2_functionNameIds.len:
        let nameId =
            plan.typedIr.functions2_functionNameIds[typedFunctionIndex]
        let nameRes: Result[str] =
            langintern.LookupIntern(plan.typedIr.internPool, nameId)
        if !IsOk(nameRes):
            layout.ByteBufFree(buf)
            panic("lowering function name identity: intern projection missing")
        loweringFunctionNameIdentityAppendU32(buf, typedFunctionIndex)
        loweringFunctionNameIdentityAppendU32(buf, nameId)
        loweringFunctionNameIdentityAppendText(buf, Value(nameRes))
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn LoweringFunctionNameIdentityReceiptCid(
        plan: LoweringPlanStub): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    loweringFunctionNameIdentityAppendText(
        buf, "cheng.compiler.lowering_function_symbol_projection.v3")
    layout.ByteBufAppendFixed32(
        buf, plan.functionNameInternPoolDomainCid)
    loweringFunctionNameIdentityAppendU32(
        buf, plan.sourceEntryTypedFunctionIndex)
    loweringFunctionNameIdentityAppendU32(buf, plan.functionNameIds.len)
    for rowIndex in 0..<plan.functionNameIds.len:
        loweringFunctionNameIdentityAppendU32(
            buf, plan.functionTypedIrIndexes[rowIndex])
        loweringFunctionNameIdentityAppendU32(
            buf, plan.functionNameIds[rowIndex])
        loweringFunctionNameIdentityAppendU32(
            buf, plan.functionExportedFlags[rowIndex])
        loweringFunctionNameIdentityAppendText(
            buf, plan.functionExportSymbolNames[rowIndex])
        if plan.functionExportedFlags[rowIndex] != 0:
            if plan.functionExportSymbolNames[rowIndex] == "":
                layout.ByteBufFree(buf)
                panic("lowering function name identity: export payload missing")
        elif plan.functionExportSymbolNames[rowIndex] != "":
            layout.ByteBufFree(buf)
            panic("lowering function name identity: unowned export payload")
        let exportNameExplicit =
            plan.functionExportNameExplicitFlags[rowIndex]
        let exportProducerSourceIndex =
            plan.functionExportProducerSourceIndexes[rowIndex]
        let exportProducerDeclarationIndex =
            plan.functionExportProducerDeclarationIndexes[rowIndex]
        let exportProducerNodeId =
            plan.functionExportProducerNodeIds[rowIndex]
        let exportProducerFactCid =
            plan.functionExportProducerFactCids[rowIndex]
        let producerLineagePresent =
            exportProducerSourceIndex >= 0 &&
            exportProducerDeclarationIndex >= 0 &&
            exportProducerNodeId > 0 &&
            !layout.FixedBytes32Equal(
                exportProducerFactCid, layout.FixedBytes32())
        let producerLineageAbsent =
            exportProducerSourceIndex == -1 &&
            exportProducerDeclarationIndex == -1 &&
            exportProducerNodeId == -1 &&
            layout.FixedBytes32Equal(
                exportProducerFactCid, layout.FixedBytes32())
        if (exportNameExplicit != 0 && exportNameExplicit != 1) ||
           (!producerLineagePresent && !producerLineageAbsent) ||
           (plan.functionExportedFlags[rowIndex] != 0 &&
            !producerLineagePresent):
            layout.ByteBufFree(buf)
            panic("lowering function name identity: producer lineage invalid")
        loweringFunctionNameIdentityAppendU32(buf, exportNameExplicit)
        loweringFunctionNameIdentityAppendU32(
            buf, exportProducerSourceIndex)
        loweringFunctionNameIdentityAppendU32(
            buf, exportProducerDeclarationIndex)
        loweringFunctionNameIdentityAppendU32(
            buf, exportProducerNodeId)
        layout.ByteBufAppendFixed32(buf, exportProducerFactCid)
        loweringFunctionNameIdentityAppendU32(
            buf, plan.functionEntryFlags[rowIndex])
        loweringFunctionNameIdentityAppendText(
            buf, plan.functionSymbolTexts[rowIndex])
        loweringFunctionNameIdentityAppendText(
            buf, plan.functionOwnerModulePaths[rowIndex])
        loweringFunctionNameIdentityAppendU32(
            buf, plan.functionSignatureLineNumbers[rowIndex])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn LoweringFunctionNameIdentityStrictValid(
        plan: LoweringPlanStub): bool =
    let rowCount = plan.functionNames.len
    if rowCount <= 0 ||
       plan.functionNameIds.len != rowCount ||
       plan.functionTypedIrIndexes.len != rowCount ||
       plan.functionExportedFlags.len != rowCount ||
       plan.functionExportSymbolNames.len != rowCount ||
       plan.functionExportNameExplicitFlags.len != rowCount ||
       plan.functionExportProducerSourceIndexes.len != rowCount ||
       plan.functionExportProducerDeclarationIndexes.len != rowCount ||
       plan.functionExportProducerNodeIds.len != rowCount ||
       plan.functionExportProducerFactCids.len != rowCount ||
       plan.functionEntryFlags.len != rowCount ||
       plan.functionSymbolTexts.len != rowCount ||
       plan.functionOwnerModulePaths.len != rowCount ||
       plan.functionSignatureLineNumbers.len != rowCount ||
       layout.FixedBytes32Equal(
           plan.functionNameInternPoolDomainCid,
           layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           plan.functionNameIdentityReceiptCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           plan.functionNameInternPoolDomainCid,
           LoweringFunctionNameInternPoolDomainCid(plan)):
        return false
    for rowIndex in 0..<rowCount:
        let typedFunctionIndex = plan.functionTypedIrIndexes[rowIndex]
        let expectedEntryFlag =
            typedFunctionIndex == plan.sourceEntryTypedFunctionIndex ? 1 : 0
        let producerLineagePresent =
            plan.functionExportProducerSourceIndexes[rowIndex] >= 0 &&
            plan.functionExportProducerDeclarationIndexes[rowIndex] >= 0 &&
            plan.functionExportProducerNodeIds[rowIndex] > 0 &&
            !layout.FixedBytes32Equal(
                plan.functionExportProducerFactCids[rowIndex],
                layout.FixedBytes32())
        let producerLineageAbsent =
            plan.functionExportProducerSourceIndexes[rowIndex] == -1 &&
            plan.functionExportProducerDeclarationIndexes[rowIndex] == -1 &&
            plan.functionExportProducerNodeIds[rowIndex] == -1 &&
            layout.FixedBytes32Equal(
                plan.functionExportProducerFactCids[rowIndex],
                layout.FixedBytes32())
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >=
               plan.typedIr.functions2_functionNameIds.len ||
           plan.functionNameIds[rowIndex] !=
               plan.typedIr.functions2_functionNameIds[
                   typedFunctionIndex] ||
           (plan.functionExportedFlags[rowIndex] != 0 &&
            (plan.functionExportSymbolNames[rowIndex] == "" ||
             !producerLineagePresent)) ||
           (plan.functionExportedFlags[rowIndex] == 0 &&
            plan.functionExportSymbolNames[rowIndex] != "") ||
           (plan.functionExportNameExplicitFlags[rowIndex] != 0 &&
            plan.functionExportNameExplicitFlags[rowIndex] != 1) ||
           (!producerLineagePresent && !producerLineageAbsent) ||
           plan.functionEntryFlags[rowIndex] != expectedEntryFlag:
            return false
    if (len(plan.entrySymbol) > 0 &&
        (plan.sourceEntryTypedFunctionIndex < 0 ||
         plan.sourceEntryTypedFunctionIndex >=
             plan.typedIr.functions2_functionNameIds.len)) ||
       (len(plan.entrySymbol) == 0 &&
        plan.sourceEntryTypedFunctionIndex != -1):
        return false
    return layout.FixedBytes32Equal(
        plan.functionNameIdentityReceiptCid,
        LoweringFunctionNameIdentityReceiptCid(plan))

fn LoweringCloneTypedExprSourceTexts(items: var texpr.TypedExprSourceText[]): texpr.TypedExprSourceText[] =
    var out: texpr.TypedExprSourceText[]
    for i in 0..<items.len:
        add(out, share(items[i]))
    return out

@borrows
fn LoweringCloneBoolFlags(items: bool[]): bool[] =
    var out: bool[]
    for i in 0..<items.len:
        add(out, items[i])
    return out

@borrows
fn LoweringFunctionTailName(functionName: str): str =
    var tailStart = 0
    if len(functionName) >= 2:
        for j in 0..<(len(functionName) - 1):
            if functionName[j] == ':' && functionName[j + 1] == ':':
                tailStart = j + 2
    if tailStart > 0 && tailStart < len(functionName):
        return strings.CloneStr(chengpath.TextSlice(functionName, tailStart, len(functionName) - tailStart))
    return strings.CloneStr(functionName)

@borrows
fn LoweringPrimaryObjectIrBodyKindFromTypedIrOp(ir: texpr.TypedExprIr,
                                               nodeIndex: int32): str =
    let opKind = ir.nodes2_opKinds[nodeIndex]
    let resultTypeRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_resultTypeIds[nodeIndex])
    if !IsOk(resultTypeRes):
        return texpr.BodyKindUnsupported
    let resultType = Value(resultTypeRes)
    if opKind == texpr.TypedExprIrOpParamRef && resultType == "float64":
        if arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_paramSlots, nodeIndex) == 0:
            return texpr.BodyKindReturnF64Arg0
        return texpr.BodyKindUnsupported
    if opKind == texpr.TypedExprIrOpParamRef &&
       (resultType == "int64" || resultType == "uint64"):
        if arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_paramSlots, nodeIndex) == 0:
            return texpr.BodyKindReturnI64Arg0
        return texpr.BodyKindUnsupported
    if opKind == texpr.TypedExprIrOpI32IfArg0LeZeroConstElseConst:
        let literalTextRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.nodes2_literalTextIds[nodeIndex])
        if !IsOk(literalTextRes):
            return texpr.BodyKindUnsupported
        let literalText = Value(literalTextRes)
        var commaIndex = -1
        for i in 0..<len(literalText):
            if literalText[i] == ',':
                commaIndex = i
                break
        if commaIndex > 0 && commaIndex + 1 < len(literalText):
            let thenText = chengpath.TextSlice(literalText, 0, commaIndex)
            let elseStart = commaIndex + 1
            let elseText = chengpath.TextSlice(literalText,
                                               elseStart,
                                               len(literalText) - elseStart)
            return Fmt"if_arg0_le_zero_return_i32_const_{thenText}_else_i32_const_{elseText}"
        return texpr.BodyKindUnsupported
    if opKind == texpr.TypedExprIrOpF64Mul:
        return texpr.BodyKindReturnF64MulArgs
    if opKind == texpr.TypedExprIrOpStrLenFast:
        return texpr.BodyKindStrLenFastI32
    if opKind == texpr.TypedExprIrOpReturnBoolI32Arg0Range0To31:
        return texpr.BodyKindReturnBoolI32Arg0Range0To31
    if opKind == texpr.TypedExprIrOpStrEmptyReturn:
        return texpr.BodyKindReturnStrEmpty
    if opKind == texpr.TypedExprIrOpCstringToStrCopy:
        return texpr.BodyKindCstringToStrCopy
    if opKind == texpr.TypedExprIrOpMainF64MulCheckExit:
        return texpr.BodyKindMainF64MulCheckExit
    if opKind == texpr.TypedExprIrOpReturnStrLiteral:
        return texpr.BodyKindReturnStrLiteral
    return texpr.BodyKindUnsupported

fn LoweringTypedFunctionIndexBucketCount(functionCount: int32): int32 =
    var need = functionCount * 2 + 16
    if need < 16:
        need = 16
    var out = 1
    while out < need:
        out = out * 2
    return out

@borrows
fn LoweringTypedFunctionIndexBucket(sourceIndex: int32,
                                     functionName: str,
                                     bucketCount: int32): int32 =
    if sourceIndex < 0 || len(functionName) <= 0 || bucketCount <= 0:
        return -1
    var hash = parser.ParserTextLookupContentHash(functionName)
    hash = hash * 131 + sourceIndex + 1
    return hash & (bucketCount - 1)

@borrows
fn LoweringTypedFunctionIndexSourceBucket(sourcePath: str,
                                           bucketCount: int32): int32 =
    if len(sourcePath) <= 0 || bucketCount <= 0:
        return -1
    return parser.ParserTextLookupContentHash(sourcePath) & (bucketCount - 1)

# Mixed relative/absolute source paths must compare equal: CSG node rows
# carry absolute paths while typed-IR rows carry workspace-relative ones.
# When exactly one side is absolute, match the relative one as a /-anchored
# suffix of the absolute one (byte compare, no allocation).
@borrows
fn loweringAbsoluteRelativePathSuffixEquivalent(
        absolutePath: str,
        relativePath: str): bool =
    let absoluteLength = len(absolutePath)
    let relativeLength = len(relativePath)
    if absoluteLength <= relativeLength:
        return false
    if absolutePath[absoluteLength - relativeLength - 1] != '/':
        return false
    for index in 0..<relativeLength:
        if absolutePath[absoluteLength - relativeLength + index] !=
           relativePath[index]:
            return false
    return true

@borrows
fn LoweringSourcePathsEquivalent(leftRaw: str, rightRaw: str): bool =
    let left = parser.ParserNormalizePath(leftRaw)
    let right = parser.ParserNormalizePath(rightRaw)
    if left == right:
        return true
    if len(left) <= 0 || len(right) <= 0:
        return false
    let leftAbs = left[0] == '/'
    let rightAbs = right[0] == '/'
    if leftAbs == rightAbs:
        return false
    if leftAbs:
        return loweringAbsoluteRelativePathSuffixEquivalent(left, right)
    return loweringAbsoluteRelativePathSuffixEquivalent(right, left)

fn LoweringDeferScopeTransportScopeColumnCount(): int32 =
    return 9

fn LoweringDeferScopeTransportStatementColumnCount(): int32 =
    return 11

@borrows
fn LoweringDeferScopeTransportShapeComplete(
        transport: LoweringDeferScopeTransportSoA): bool =
    let scopeCount = transport.scopeIds.len
    let statementCount = transport.statementIndexes.len
    return transport.scopeParentIds.len == scopeCount &&
           transport.scopeKinds.len == scopeCount &&
           transport.scopeOwnerStatementOrdinals.len == scopeCount &&
           transport.scopeLexicalOrdinals.len == scopeCount &&
           transport.scopeStartLineNumbers.len == scopeCount &&
           transport.scopeStartColumnNumbers.len == scopeCount &&
           transport.scopeEndLineNumbers.len == scopeCount &&
           transport.scopeEndColumnNumbers.len == scopeCount &&
           transport.statementKinds.len == statementCount &&
           transport.statementLineNumbers.len == statementCount &&
           transport.statementColumnNumbers.len == statementCount &&
           transport.statementEndLineNumbers.len == statementCount &&
           transport.statementEndColumnNumbers.len == statementCount &&
           transport.statementLexicalScopeIds.len == statementCount &&
           transport.statementSuiteScopeIds.len == statementCount &&
           transport.statementOrdinals.len == statementCount &&
           transport.statementLexicalOrdinals.len == statementCount &&
           transport.statementDeferOwnerStatementOrdinals.len == statementCount

@borrows
fn LoweringDeferScopeTransportRetainedItemCount(
        transport: LoweringDeferScopeTransportSoA): int32 =
    return transport.scopeIds.cap +
           transport.scopeParentIds.cap +
           transport.scopeKinds.cap +
           transport.scopeOwnerStatementOrdinals.cap +
           transport.scopeLexicalOrdinals.cap +
           transport.scopeStartLineNumbers.cap +
           transport.scopeStartColumnNumbers.cap +
           transport.scopeEndLineNumbers.cap +
           transport.scopeEndColumnNumbers.cap +
           transport.statementIndexes.cap +
           transport.statementKinds.cap +
           transport.statementLineNumbers.cap +
           transport.statementColumnNumbers.cap +
           transport.statementEndLineNumbers.cap +
           transport.statementEndColumnNumbers.cap +
           transport.statementLexicalScopeIds.cap +
           transport.statementSuiteScopeIds.cap +
           transport.statementOrdinals.cap +
           transport.statementLexicalOrdinals.cap +
           transport.statementDeferOwnerStatementOrdinals.cap

@borrows
fn LoweringDeferScopeTransportLiveItemCount(
        transport: LoweringDeferScopeTransportSoA): int32 =
    return transport.scopeIds.len +
           transport.scopeParentIds.len +
           transport.scopeKinds.len +
           transport.scopeOwnerStatementOrdinals.len +
           transport.scopeLexicalOrdinals.len +
           transport.scopeStartLineNumbers.len +
           transport.scopeStartColumnNumbers.len +
           transport.scopeEndLineNumbers.len +
           transport.scopeEndColumnNumbers.len +
           transport.statementIndexes.len +
           transport.statementKinds.len +
           transport.statementLineNumbers.len +
           transport.statementColumnNumbers.len +
           transport.statementEndLineNumbers.len +
           transport.statementEndColumnNumbers.len +
           transport.statementLexicalScopeIds.len +
           transport.statementSuiteScopeIds.len +
           transport.statementOrdinals.len +
           transport.statementLexicalOrdinals.len +
           transport.statementDeferOwnerStatementOrdinals.len

@borrows
fn LoweringDeferScopeTransportCapacityBytes(
        transport: LoweringDeferScopeTransportSoA): int64 =
    return int64(transport.scopeIds.cap) * int64(sizeof(int32)) +
           int64(transport.scopeParentIds.cap) * int64(sizeof(int32)) +
           int64(transport.scopeKinds.cap) *
               int64(sizeof(parser.NormalizedScopeKind)) +
           int64(transport.scopeOwnerStatementOrdinals.cap) *
               int64(sizeof(int32)) +
           int64(transport.scopeLexicalOrdinals.cap) *
               int64(sizeof(int32)) +
           int64(transport.scopeStartLineNumbers.cap) *
               int64(sizeof(int32)) +
           int64(transport.scopeStartColumnNumbers.cap) *
               int64(sizeof(int32)) +
           int64(transport.scopeEndLineNumbers.cap) *
               int64(sizeof(int32)) +
           int64(transport.scopeEndColumnNumbers.cap) *
               int64(sizeof(int32)) +
           int64(transport.statementIndexes.cap) * int64(sizeof(int32)) +
           int64(transport.statementKinds.cap) *
               int64(sizeof(texpr.TypedExprIrStatementKind)) +
           int64(transport.statementLineNumbers.cap) *
               int64(sizeof(int32)) +
           int64(transport.statementColumnNumbers.cap) *
               int64(sizeof(int32)) +
           int64(transport.statementEndLineNumbers.cap) *
               int64(sizeof(int32)) +
           int64(transport.statementEndColumnNumbers.cap) *
               int64(sizeof(int32)) +
           int64(transport.statementLexicalScopeIds.cap) *
               int64(sizeof(int32)) +
           int64(transport.statementSuiteScopeIds.cap) *
               int64(sizeof(int32)) +
           int64(transport.statementOrdinals.cap) *
               int64(sizeof(int32)) +
           int64(transport.statementLexicalOrdinals.cap) *
               int64(sizeof(int32)) +
           int64(transport.statementDeferOwnerStatementOrdinals.cap) *
               int64(sizeof(int32))

@borrows
fn LoweringDeferScopeTransportPhysicalBufferCount(
        transport: LoweringDeferScopeTransportSoA): int32 =
    var count: int32
    if transport.scopeIds.cap > 0: count = count + 1
    if transport.scopeParentIds.cap > 0: count = count + 1
    if transport.scopeKinds.cap > 0: count = count + 1
    if transport.scopeOwnerStatementOrdinals.cap > 0: count = count + 1
    if transport.scopeLexicalOrdinals.cap > 0: count = count + 1
    if transport.scopeStartLineNumbers.cap > 0: count = count + 1
    if transport.scopeStartColumnNumbers.cap > 0: count = count + 1
    if transport.scopeEndLineNumbers.cap > 0: count = count + 1
    if transport.scopeEndColumnNumbers.cap > 0: count = count + 1
    if transport.statementIndexes.cap > 0: count = count + 1
    if transport.statementKinds.cap > 0: count = count + 1
    if transport.statementLineNumbers.cap > 0: count = count + 1
    if transport.statementColumnNumbers.cap > 0: count = count + 1
    if transport.statementEndLineNumbers.cap > 0: count = count + 1
    if transport.statementEndColumnNumbers.cap > 0: count = count + 1
    if transport.statementLexicalScopeIds.cap > 0: count = count + 1
    if transport.statementSuiteScopeIds.cap > 0: count = count + 1
    if transport.statementOrdinals.cap > 0: count = count + 1
    if transport.statementLexicalOrdinals.cap > 0: count = count + 1
    if transport.statementDeferOwnerStatementOrdinals.cap > 0:
        count = count + 1
    return count

@borrows
fn LoweringDeferScopeTransportRetainedBytes(
        transport: LoweringDeferScopeTransportSoA): int64 =
    return LoweringDeferScopeTransportCapacityBytes(transport)

@borrows
fn LoweringDeferScopeTransportLiveBytes(
        transport: LoweringDeferScopeTransportSoA): int64 =
    return int64(transport.scopeIds.len) * int64(sizeof(int32)) +
           int64(transport.scopeParentIds.len) * int64(sizeof(int32)) +
           int64(transport.scopeKinds.len) *
               int64(sizeof(parser.NormalizedScopeKind)) +
           int64(transport.scopeOwnerStatementOrdinals.len) *
               int64(sizeof(int32)) +
           int64(transport.scopeLexicalOrdinals.len) *
               int64(sizeof(int32)) +
           int64(transport.scopeStartLineNumbers.len) *
               int64(sizeof(int32)) +
           int64(transport.scopeStartColumnNumbers.len) *
               int64(sizeof(int32)) +
           int64(transport.scopeEndLineNumbers.len) *
               int64(sizeof(int32)) +
           int64(transport.scopeEndColumnNumbers.len) *
               int64(sizeof(int32)) +
           int64(transport.statementIndexes.len) * int64(sizeof(int32)) +
           int64(transport.statementKinds.len) *
               int64(sizeof(texpr.TypedExprIrStatementKind)) +
           int64(transport.statementLineNumbers.len) *
               int64(sizeof(int32)) +
           int64(transport.statementColumnNumbers.len) *
               int64(sizeof(int32)) +
           int64(transport.statementEndLineNumbers.len) *
               int64(sizeof(int32)) +
           int64(transport.statementEndColumnNumbers.len) *
               int64(sizeof(int32)) +
           int64(transport.statementLexicalScopeIds.len) *
               int64(sizeof(int32)) +
           int64(transport.statementSuiteScopeIds.len) *
               int64(sizeof(int32)) +
           int64(transport.statementOrdinals.len) *
               int64(sizeof(int32)) +
           int64(transport.statementLexicalOrdinals.len) *
               int64(sizeof(int32)) +
           int64(transport.statementDeferOwnerStatementOrdinals.len) *
               int64(sizeof(int32))

fn LoweringDeferScopeTransportAppendScopeExactRow(
        transport: var LoweringDeferScopeTransportSoA,
        scopeId: int32,
        parentScopeId: int32,
        scopeKind: parser.NormalizedScopeKind,
        ownerStatementOrdinal: int32,
        lexicalOrdinal: int32,
        startLineNumber: int32,
        startColumnNumber: int32,
        endLineNumber: int32,
        endColumnNumber: int32) =
    let rowCount = transport.scopeIds.len
    if transport.allocatorLedger.closed ||
       transport.scopeParentIds.len != rowCount ||
       transport.scopeKinds.len != rowCount ||
       transport.scopeOwnerStatementOrdinals.len != rowCount ||
       transport.scopeLexicalOrdinals.len != rowCount ||
       transport.scopeStartLineNumbers.len != rowCount ||
       transport.scopeStartColumnNumbers.len != rowCount ||
       transport.scopeEndLineNumbers.len != rowCount ||
       transport.scopeEndColumnNumbers.len != rowCount:
        panic("lowering defer scope transport: scope append shape drift")
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.scopeIds,
        scopeId,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.scopeParentIds,
        parentScopeId,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.scopeKinds,
        scopeKind,
        sizeof(parser.NormalizedScopeKind))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.scopeOwnerStatementOrdinals,
        ownerStatementOrdinal,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.scopeLexicalOrdinals,
        lexicalOrdinal,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.scopeStartLineNumbers,
        startLineNumber,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.scopeStartColumnNumbers,
        startColumnNumber,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.scopeEndLineNumbers,
        endLineNumber,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.scopeEndColumnNumbers,
        endColumnNumber,
        sizeof(int32))

fn LoweringDeferScopeTransportAppendStatementExactRow(
        transport: var LoweringDeferScopeTransportSoA,
        statementIndex: int32,
        statementKind: texpr.TypedExprIrStatementKind,
        lineNumber: int32,
        columnNumber: int32,
        endLineNumber: int32,
        endColumnNumber: int32,
        lexicalScopeId: int32,
        suiteScopeId: int32,
        statementOrdinal: int32,
        lexicalOrdinal: int32,
        deferOwnerStatementOrdinal: int32) =
    let rowCount = transport.statementIndexes.len
    if transport.allocatorLedger.closed ||
       transport.statementKinds.len != rowCount ||
       transport.statementLineNumbers.len != rowCount ||
       transport.statementColumnNumbers.len != rowCount ||
       transport.statementEndLineNumbers.len != rowCount ||
       transport.statementEndColumnNumbers.len != rowCount ||
       transport.statementLexicalScopeIds.len != rowCount ||
       transport.statementSuiteScopeIds.len != rowCount ||
       transport.statementOrdinals.len != rowCount ||
       transport.statementLexicalOrdinals.len != rowCount ||
       transport.statementDeferOwnerStatementOrdinals.len != rowCount:
        panic("lowering defer scope transport: statement append shape drift")
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.statementIndexes,
        statementIndex,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.statementKinds,
        statementKind,
        sizeof(texpr.TypedExprIrStatementKind))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.statementLineNumbers,
        lineNumber,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.statementColumnNumbers,
        columnNumber,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.statementEndLineNumbers,
        endLineNumber,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.statementEndColumnNumbers,
        endColumnNumber,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.statementLexicalScopeIds,
        lexicalScopeId,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.statementSuiteScopeIds,
        suiteScopeId,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.statementOrdinals,
        statementOrdinal,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.statementLexicalOrdinals,
        lexicalOrdinal,
        sizeof(int32))
    loweringSequenceAllocatorAdd(
        transport.allocatorLedger,
        transport.statementDeferOwnerStatementOrdinals,
        deferOwnerStatementOrdinal,
        sizeof(int32))

fn LoweringDeferScopeTransportReleaseWithAllocatorReceipt(
        transport: var LoweringDeferScopeTransportSoA,
        receipt: var LoweringSequenceAllocatorReceipt) =
    receipt = LoweringSequenceAllocatorReceipt()
    receipt.terminalRetainedBufferCount =
        LoweringDeferScopeTransportPhysicalBufferCount(transport)
    receipt.terminalRetainedBytes =
        LoweringDeferScopeTransportCapacityBytes(transport)
    if transport.allocatorLedger.liveAllocationCount !=
           int64(receipt.terminalRetainedBufferCount) ||
       transport.allocatorLedger.liveCapacityBytes !=
           receipt.terminalRetainedBytes:
        panic("lowering defer scope transport: allocator/retained drift")
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    let releasedScopeIdsBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.scopeIds,
            sizeof(int32))
    if releasedScopeIdsBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedScopeIdsBytes
    let releasedScopeParentIdsBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.scopeParentIds,
            sizeof(int32))
    if releasedScopeParentIdsBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedScopeParentIdsBytes
    let releasedScopeKindsBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.scopeKinds,
            sizeof(parser.NormalizedScopeKind))
    if releasedScopeKindsBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedScopeKindsBytes
    let releasedScopeOwnersBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.scopeOwnerStatementOrdinals,
            sizeof(int32))
    if releasedScopeOwnersBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedScopeOwnersBytes
    let releasedScopeLexicalBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.scopeLexicalOrdinals,
            sizeof(int32))
    if releasedScopeLexicalBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedScopeLexicalBytes
    let releasedScopeStartLineBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.scopeStartLineNumbers,
            sizeof(int32))
    if releasedScopeStartLineBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedScopeStartLineBytes
    let releasedScopeStartColumnBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.scopeStartColumnNumbers,
            sizeof(int32))
    if releasedScopeStartColumnBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedScopeStartColumnBytes
    let releasedScopeEndLineBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.scopeEndLineNumbers,
            sizeof(int32))
    if releasedScopeEndLineBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedScopeEndLineBytes
    let releasedScopeEndColumnBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.scopeEndColumnNumbers,
            sizeof(int32))
    if releasedScopeEndColumnBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedScopeEndColumnBytes
    let releasedStatementIndexesBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.statementIndexes,
            sizeof(int32))
    if releasedStatementIndexesBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedStatementIndexesBytes
    let releasedStatementKindsBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.statementKinds,
            sizeof(texpr.TypedExprIrStatementKind))
    if releasedStatementKindsBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedStatementKindsBytes
    let releasedStatementLineBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.statementLineNumbers,
            sizeof(int32))
    if releasedStatementLineBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedStatementLineBytes
    let releasedStatementColumnBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.statementColumnNumbers,
            sizeof(int32))
    if releasedStatementColumnBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedStatementColumnBytes
    let releasedStatementEndLineBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.statementEndLineNumbers,
            sizeof(int32))
    if releasedStatementEndLineBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedStatementEndLineBytes
    let releasedStatementEndColumnBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.statementEndColumnNumbers,
            sizeof(int32))
    if releasedStatementEndColumnBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedStatementEndColumnBytes
    let releasedStatementLexicalScopeBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.statementLexicalScopeIds,
            sizeof(int32))
    if releasedStatementLexicalScopeBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedStatementLexicalScopeBytes
    let releasedStatementSuiteScopeBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.statementSuiteScopeIds,
            sizeof(int32))
    if releasedStatementSuiteScopeBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedStatementSuiteScopeBytes
    let releasedStatementOrdinalBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.statementOrdinals,
            sizeof(int32))
    if releasedStatementOrdinalBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedStatementOrdinalBytes
    let releasedStatementLexicalOrdinalBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.statementLexicalOrdinals,
            sizeof(int32))
    if releasedStatementLexicalOrdinalBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedStatementLexicalOrdinalBytes
    let releasedStatementDeferOwnerBytes =
        loweringSequenceAllocatorRelease(
            transport.allocatorLedger,
            transport.statementDeferOwnerStatementOrdinals,
            sizeof(int32))
    if releasedStatementDeferOwnerBytes > int64(0):
        terminalReleasedBufferCount =
            terminalReleasedBufferCount + 1
        terminalReleasedBytes =
            terminalReleasedBytes + releasedStatementDeferOwnerBytes
    transport.allocatorLedger.closed = true
    receipt.allocationEventCount =
        transport.allocatorLedger.allocationEventCount
    receipt.releaseEventCount =
        transport.allocatorLedger.releaseEventCount
    receipt.allocatedCapacityBytes =
        transport.allocatorLedger.allocatedCapacityBytes
    receipt.releasedCapacityBytes =
        transport.allocatorLedger.releasedCapacityBytes
    receipt.terminalReleasedBufferCount =
        terminalReleasedBufferCount
    receipt.terminalReleasedBytes =
        terminalReleasedBytes
    receipt.liveAllocationCount =
        transport.allocatorLedger.liveAllocationCount
    receipt.liveCapacityBytes =
        transport.allocatorLedger.liveCapacityBytes
    receipt.storageReleased =
        LoweringDeferScopeTransportPhysicalBufferCount(transport) == 0 &&
        LoweringDeferScopeTransportCapacityBytes(transport) == int64(0)
    if !LoweringSequenceAllocatorReceiptClosed(receipt):
        panic("lowering defer scope transport: allocator receipt incomplete")
    transport = LoweringDeferScopeTransportSoA()
    transport.typedFunctionIndex = -1

fn LoweringDeferScopeTransportRelease(
        transport: var LoweringDeferScopeTransportSoA) =
    var receipt: LoweringSequenceAllocatorReceipt
    LoweringDeferScopeTransportReleaseWithAllocatorReceipt(
        transport, receipt)

@borrows
fn LoweringDeferScopeTransportClone(
        transport: LoweringDeferScopeTransportSoA): LoweringDeferScopeTransportSoA =
    if !LoweringDeferScopeTransportShapeComplete(transport):
        panic("lowering defer scope transport: clone source shape incomplete")
    var out: LoweringDeferScopeTransportSoA
    out.typedFunctionIndex = transport.typedFunctionIndex
    out.sourceStatementStart = transport.sourceStatementStart
    out.sourceStatementCount = transport.sourceStatementCount
    out.sourceScopeStart = transport.sourceScopeStart
    out.sourceScopeCount = transport.sourceScopeCount
    for i in 0..<transport.scopeIds.len:
        LoweringDeferScopeTransportAppendScopeExactRow(
            out,
            transport.scopeIds[i],
            transport.scopeParentIds[i],
            transport.scopeKinds[i],
            transport.scopeOwnerStatementOrdinals[i],
            transport.scopeLexicalOrdinals[i],
            transport.scopeStartLineNumbers[i],
            transport.scopeStartColumnNumbers[i],
            transport.scopeEndLineNumbers[i],
            transport.scopeEndColumnNumbers[i])
    for i in 0..<transport.statementIndexes.len:
        LoweringDeferScopeTransportAppendStatementExactRow(
            out,
            transport.statementIndexes[i],
            transport.statementKinds[i],
            transport.statementLineNumbers[i],
            transport.statementColumnNumbers[i],
            transport.statementEndLineNumbers[i],
            transport.statementEndColumnNumbers[i],
            transport.statementLexicalScopeIds[i],
            transport.statementSuiteScopeIds[i],
            transport.statementOrdinals[i],
            transport.statementLexicalOrdinals[i],
            transport.statementDeferOwnerStatementOrdinals[i])
    out.complete = transport.complete
    if !LoweringDeferScopeTransportShapeComplete(out):
        panic("lowering defer scope transport: clone destination shape incomplete")
    return out

fn LoweringDeferScopeTransportMoveInto(
        out: var LoweringDeferScopeTransportSoA,
        transport: var LoweringDeferScopeTransportSoA) =
    if !LoweringDeferScopeTransportShapeComplete(transport):
        panic("lowering defer scope transport: move source shape incomplete")
    LoweringDeferScopeTransportRelease(out)
    out = transport
    transport = LoweringDeferScopeTransportSoA()

@borrows
fn LoweringOwnershipTransportShapeComplete(
        transport: LoweringOwnershipTransportSoA): bool =
    let count = transport.definitionRows.len
    return transport.definitionGroupRows.len == count &&
           transport.originKinds.len == count &&
           transport.sourceLocalNodeIndexes.len == count &&
           transport.declarationSourceLocalRows.len == count &&
           transport.patternSourceLocalRows.len == count &&
           transport.sourceStatementIndexes.len == count &&
           transport.definingNodeIndexes.len == count &&
           transport.exactTypeIds.len == count &&
           transport.ownershipKinds.len == count &&
           transport.borrowOwnerValueDefinitionRows.len == count &&
           transport.proofKinds.len == count &&
           transport.managedFlags.len == count &&
           transport.nodeOpKinds.len == count &&
           transport.callDeclarationIndexes.len == count

@borrows
fn LoweringOwnershipTransportDefinitionCsrExact(
        transport: LoweringOwnershipTransportSoA): bool =
    if transport.sourceValueDefinitionStart < 0 ||
       transport.sourceValueDefinitionCount < 0 ||
       transport.definitionRows.len !=
           transport.sourceValueDefinitionCount:
        return false
    for row in 0..<transport.definitionRows.len:
        let definitionRow = transport.definitionRows[row]
        if definitionRow < transport.sourceValueDefinitionStart:
            return false
        let localDefinitionRow =
            definitionRow - transport.sourceValueDefinitionStart
        if localDefinitionRow != row:
            return false
    return true

@borrows
fn LoweringOwnershipTransportRetainedItemCount(
        transport: LoweringOwnershipTransportSoA): int32 =
    return transport.definitionGroupRows.cap +
           transport.definitionRows.cap +
           transport.originKinds.cap +
           transport.sourceLocalNodeIndexes.cap +
           transport.declarationSourceLocalRows.cap +
           transport.patternSourceLocalRows.cap +
           transport.sourceStatementIndexes.cap +
           transport.definingNodeIndexes.cap +
           transport.exactTypeIds.cap +
           transport.ownershipKinds.cap +
           transport.borrowOwnerValueDefinitionRows.cap +
           transport.proofKinds.cap +
           transport.managedFlags.cap +
           transport.nodeOpKinds.cap +
           transport.callDeclarationIndexes.cap

@borrows
fn LoweringOwnershipTransportLiveItemCount(
        transport: LoweringOwnershipTransportSoA): int32 =
    return transport.definitionGroupRows.len +
           transport.definitionRows.len +
           transport.originKinds.len +
           transport.sourceLocalNodeIndexes.len +
           transport.declarationSourceLocalRows.len +
           transport.patternSourceLocalRows.len +
           transport.sourceStatementIndexes.len +
           transport.definingNodeIndexes.len +
           transport.exactTypeIds.len +
           transport.ownershipKinds.len +
           transport.borrowOwnerValueDefinitionRows.len +
           transport.proofKinds.len +
           transport.managedFlags.len +
           transport.nodeOpKinds.len +
           transport.callDeclarationIndexes.len

@borrows
fn LoweringOwnershipTransportCapacityBytes(
        transport: LoweringOwnershipTransportSoA): int64 =
    return int64(transport.definitionGroupRows.cap) *
               int64(sizeof(int32)) +
           int64(transport.definitionRows.cap) * int64(sizeof(int32)) +
           int64(transport.originKinds.cap) * int64(sizeof(int32)) +
           int64(transport.sourceLocalNodeIndexes.cap) *
               int64(sizeof(int32)) +
           int64(transport.declarationSourceLocalRows.cap) *
               int64(sizeof(int32)) +
           int64(transport.patternSourceLocalRows.cap) *
               int64(sizeof(int32)) +
           int64(transport.sourceStatementIndexes.cap) *
               int64(sizeof(int32)) +
           int64(transport.definingNodeIndexes.cap) *
               int64(sizeof(int32)) +
           int64(transport.exactTypeIds.cap) * int64(sizeof(int32)) +
           int64(transport.ownershipKinds.cap) *
               int64(sizeof(texpr.TypedExprExprClass)) +
           int64(transport.borrowOwnerValueDefinitionRows.cap) *
               int64(sizeof(int32)) +
           int64(transport.proofKinds.cap) * int64(sizeof(int32)) +
           int64(transport.managedFlags.cap) * int64(sizeof(bool)) +
           int64(transport.nodeOpKinds.cap) *
               int64(sizeof(texpr.TypedExprIrOpKind)) +
           int64(transport.callDeclarationIndexes.cap) *
               int64(sizeof(int32))

@borrows
fn LoweringOwnershipTransportPhysicalBufferCount(
        transport: LoweringOwnershipTransportSoA): int32 =
    var count: int32
    if transport.definitionGroupRows.cap > 0: count = count + 1
    if transport.definitionRows.cap > 0: count = count + 1
    if transport.originKinds.cap > 0: count = count + 1
    if transport.sourceLocalNodeIndexes.cap > 0: count = count + 1
    if transport.declarationSourceLocalRows.cap > 0: count = count + 1
    if transport.patternSourceLocalRows.cap > 0: count = count + 1
    if transport.sourceStatementIndexes.cap > 0: count = count + 1
    if transport.definingNodeIndexes.cap > 0: count = count + 1
    if transport.exactTypeIds.cap > 0: count = count + 1
    if transport.ownershipKinds.cap > 0: count = count + 1
    if transport.borrowOwnerValueDefinitionRows.cap > 0:
        count = count + 1
    if transport.proofKinds.cap > 0: count = count + 1
    if transport.managedFlags.cap > 0: count = count + 1
    if transport.nodeOpKinds.cap > 0: count = count + 1
    if transport.callDeclarationIndexes.cap > 0: count = count + 1
    return count

@borrows
fn LoweringOwnershipTransportLiveBytes(
        transport: LoweringOwnershipTransportSoA): int64 =
    return int64(transport.definitionGroupRows.len) *
               int64(sizeof(int32)) +
           int64(transport.definitionRows.len) * int64(sizeof(int32)) +
           int64(transport.originKinds.len) * int64(sizeof(int32)) +
           int64(transport.sourceLocalNodeIndexes.len) *
               int64(sizeof(int32)) +
           int64(transport.declarationSourceLocalRows.len) *
               int64(sizeof(int32)) +
           int64(transport.patternSourceLocalRows.len) *
               int64(sizeof(int32)) +
           int64(transport.sourceStatementIndexes.len) *
               int64(sizeof(int32)) +
           int64(transport.definingNodeIndexes.len) *
               int64(sizeof(int32)) +
           int64(transport.exactTypeIds.len) * int64(sizeof(int32)) +
           int64(transport.ownershipKinds.len) *
               int64(sizeof(texpr.TypedExprExprClass)) +
           int64(transport.borrowOwnerValueDefinitionRows.len) *
               int64(sizeof(int32)) +
           int64(transport.proofKinds.len) * int64(sizeof(int32)) +
           int64(transport.managedFlags.len) * int64(sizeof(bool)) +
           int64(transport.nodeOpKinds.len) *
               int64(sizeof(texpr.TypedExprIrOpKind)) +
           int64(transport.callDeclarationIndexes.len) *
               int64(sizeof(int32))

fn loweringSequenceAllocatorRecordGrowth(
        ledger: var LoweringSequenceAllocatorLedger,
        beforeCapacity: int32,
        afterCapacity: int32,
        elementBytes: int32) =
    if ledger.closed ||
       beforeCapacity < 0 ||
       afterCapacity <= beforeCapacity ||
       elementBytes <= 0:
        panic("lowering sequence allocator: invalid growth event")
    if beforeCapacity > 0:
        let retiredBytes =
            int64(beforeCapacity) * int64(elementBytes)
        if ledger.liveAllocationCount <= int64(0) ||
           ledger.liveCapacityBytes < retiredBytes:
            panic("lowering sequence allocator: growth retire underflow")
        ledger.releaseEventCount =
            ledger.releaseEventCount + int64(1)
        ledger.releasedCapacityBytes =
            ledger.releasedCapacityBytes + retiredBytes
        ledger.liveAllocationCount =
            ledger.liveAllocationCount - int64(1)
        ledger.liveCapacityBytes =
            ledger.liveCapacityBytes - retiredBytes
    let allocatedBytes =
        int64(afterCapacity) * int64(elementBytes)
    ledger.allocationEventCount =
        ledger.allocationEventCount + int64(1)
    ledger.allocatedCapacityBytes =
        ledger.allocatedCapacityBytes + allocatedBytes
    ledger.liveAllocationCount =
        ledger.liveAllocationCount + int64(1)
    ledger.liveCapacityBytes =
        ledger.liveCapacityBytes + allocatedBytes
    if ledger.liveCapacityBytes > ledger.peakLiveCapacityBytes:
        ledger.peakLiveCapacityBytes =
            ledger.liveCapacityBytes

fn loweringSequenceAllocatorRecordAddResult(
        ledger: var LoweringSequenceAllocatorLedger,
        beforeCapacity: int32,
        afterCapacity: int32,
        bufferPresent: bool,
        elementBytes: int32) =
    if ledger.closed:
        panic("lowering sequence allocator: add after close")
    if afterCapacity < beforeCapacity ||
       afterCapacity <= 0 ||
       !bufferPresent:
        panic("lowering sequence allocator: invalid Seq add result")
    if afterCapacity > beforeCapacity:
        loweringSequenceAllocatorRecordGrowth(
            ledger,
            beforeCapacity,
            afterCapacity,
            elementBytes)

fn loweringSequenceAllocatorAdd(
        ledger: var LoweringSequenceAllocatorLedger,
        values: var int32[],
        value: int32,
        elementBytes: int32) =
    let beforeCapacity = values.cap
    add(values, value)
    loweringSequenceAllocatorRecordAddResult(
        ledger,
        beforeCapacity,
        values.cap,
        values.buffer != nil,
        elementBytes)

