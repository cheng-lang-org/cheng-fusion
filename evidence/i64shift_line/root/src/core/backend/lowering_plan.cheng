@borrows
fn LoweringTypedFunctionReferenceIndexRetainedItemCount(
        plan: LoweringPlanStub): int32 =
    return plan.typedFunctionReferenceSourcePaths.cap +
           plan.typedFunctionReferenceSourceBucketHeads.cap +
           plan.typedFunctionReferenceSourceEntryNext.cap +
           plan.typedFunctionReferenceAliasBucketHeads.cap +
           plan.typedFunctionReferenceAliasEntryNext.cap +
           plan.typedFunctionReferenceAliasEntrySourceIndexes.cap +
           plan.typedFunctionReferenceAliasEntryNames.cap +
           plan.typedFunctionReferenceAliasEntryCandidateHeads.cap +
           plan.typedFunctionReferenceAliasEntryCandidateTails.cap +
           plan.typedFunctionReferenceAliasCandidateNext.cap +
           plan.typedFunctionReferenceAliasCandidateFunctionIndexes.cap +
           plan.typedFunctionReferenceGlobalBucketHeads.cap +
           plan.typedFunctionReferenceGlobalEntryNext.cap +
           plan.typedFunctionReferenceGlobalEntryNames.cap +
           plan.typedFunctionReferenceGlobalEntryCandidateHeads.cap +
           plan.typedFunctionReferenceGlobalEntryCandidateTails.cap +
           plan.typedFunctionReferenceGlobalCandidateNext.cap +
           plan.typedFunctionReferenceGlobalCandidateSourceIndexes.cap +
           plan.typedFunctionReferenceGlobalCandidateFunctionIndexes.cap +
           plan.typedFunctionReferenceClaimedFlags.cap +
           plan.typedFunctionReferenceFlags.cap

@borrows
fn LoweringTypedFunctionReferenceIndexCapacityEstimateBytes(
        plan: LoweringPlanStub): int64 =
    var total = Int64(plan.typedFunctionReferenceSourcePaths.cap) * Int64(16)
    for sourceIndex in 0..<plan.typedFunctionReferenceSourcePaths.len:
        total = total +
                Int64(len(plan.typedFunctionReferenceSourcePaths[sourceIndex]))
    total = total +
            Int64(plan.typedFunctionReferenceAliasEntryNames.cap) * Int64(16)
    for aliasIndex in 0..<plan.typedFunctionReferenceAliasEntryNames.len:
        total = total +
                Int64(len(plan.typedFunctionReferenceAliasEntryNames[aliasIndex]))
    total = total +
            Int64(plan.typedFunctionReferenceGlobalEntryNames.cap) * Int64(16)
    for aliasIndex in 0..<plan.typedFunctionReferenceGlobalEntryNames.len:
        total = total +
                Int64(len(plan.typedFunctionReferenceGlobalEntryNames[aliasIndex]))
    total = total +
            Int64(plan.typedFunctionReferenceSourceBucketHeads.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceSourceEntryNext.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceAliasBucketHeads.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceAliasEntryNext.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceAliasEntrySourceIndexes.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceAliasEntryCandidateHeads.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceAliasEntryCandidateTails.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceAliasCandidateNext.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceAliasCandidateFunctionIndexes.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceGlobalBucketHeads.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceGlobalEntryNext.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceGlobalEntryCandidateHeads.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceGlobalEntryCandidateTails.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceGlobalCandidateNext.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceGlobalCandidateSourceIndexes.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceGlobalCandidateFunctionIndexes.cap) * Int64(4) +
            Int64(plan.typedFunctionReferenceClaimedFlags.cap) +
            Int64(plan.typedFunctionReferenceFlags.cap)
    return total

