    loweringPlanRetainedRecordSequence(
        report, plan.snapshotFunctionIdsByTypedFunctionIndex)
    loweringPlanRetainedRecordSequence(
        report, plan.snapshotFunctionFragmentCidsByTypedFunctionIndex)
    loweringPlanRetainedRecordSequence(
