@borrows
fn LoweringPlanRulesForSource(plan: LoweringPlanStub,
                                sourcePathRaw: str): texpr.TypedExprLoweringRule[] =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    var out: texpr.TypedExprLoweringRule[]
    for i in 0..<plan.loweringRules.len:
        if plan.loweringRules[i].sourcePath != sourcePath:
            continue
        var rule: texpr.TypedExprLoweringRule
        rule.exprId = plan.loweringRules[i].exprId
        rule.sourcePath = plan.loweringRules[i].sourcePath
        rule.lineNumber = plan.loweringRules[i].lineNumber
        rule.columnNumber = plan.loweringRules[i].columnNumber
        rule.surfaceCallKind = plan.loweringRules[i].surfaceCallKind
        rule.callResolved = plan.loweringRules[i].callResolved
        rule.callReason = plan.loweringRules[i].callReason
        rule.callQualifier = plan.loweringRules[i].callQualifier
        rule.callCallee = plan.loweringRules[i].callCallee
        rule.callTarget = plan.loweringRules[i].callTarget
        rule.callTargetSourcePath = plan.loweringRules[i].callTargetSourcePath
        rule.callTargetImportc = plan.loweringRules[i].callTargetImportc
        rule.callPrefixStyle = plan.loweringRules[i].callPrefixStyle
        rule.callArgCount = plan.loweringRules[i].callArgCount
        rule.callArgsText = plan.loweringRules[i].callArgsText
        rule.typeText = plan.loweringRules[i].typeText
        rule.abiClass = plan.loweringRules[i].abiClass
        rule.valueKind = plan.loweringRules[i].valueKind
        rule.placeKind = plan.loweringRules[i].placeKind
        rule.loweringMode = plan.loweringRules[i].loweringMode
        rule.callKind = plan.loweringRules[i].callKind
        rule.typeCallKind = plan.loweringRules[i].typeCallKind
        rule.returnKind = plan.loweringRules[i].returnKind
        rule.argPassKind = plan.loweringRules[i].argPassKind
        rule.resultPassKind = plan.loweringRules[i].resultPassKind
        rule.materializeKind = plan.loweringRules[i].materializeKind
        rule.copyKind = plan.loweringRules[i].copyKind
        rule.importKind = plan.loweringRules[i].importKind
        add(out, share(rule))
    return out

@borrows
fn LoweringPlanFunctionEntryFlagsField(plan: LoweringPlanStub): int32[] =
    return plan.functionEntryFlags

@borrows
fn LoweringPlanMissingReasonsField(plan: LoweringPlanStub): str[] =
    return plan.missingReasons

@borrows
fn LoweringPlanPipelineStage(plan: LoweringPlanStub): str =
    return strings.CloneStr(plan.pipelineStage)

fn BuildLoweringPlanStub(linkPlan: slplan.SystemLinkPlanStub,
                           plan: var LoweringPlanStub,
                           err: var str): bool =
    err =
        " lowering plan: canonical semantic snapshot input is required"
    return false

@borrows
fn LoweringPlanNonEmptyOrDash(value: str): str =
    if len(value) <= 0:
        return "-"
    return strings.CloneStr(value)

@borrows
fn LoweringPlanStubReport(plan: LoweringPlanStub): str =
    # parts-builder 重写: 旧版 var-str + 79 LoweringAppendLine + 4 subreport Fmt
    # 在 dispatch_min census 路径下 GB 级 subreport 注入后,尾部 4 行 LoweringAppendLine
    # 每行 2x O(GB) 复制 = 16GB+ 撞 8GB guard 杀。新版统一走
    # LoweringReportPartsOwner + 末尾单次 strutil.Join,O(N^2) 复制降到 O(N)。
    if plan.exprLayer.sourceCount != 0 || plan.exprLayer.exprs.len != 0 ||
       plan.exprLayer.exprNext.len != 0 || plan.exprLayer.questionResidualCount != 0 ||
       plan.exprLayer.exprLookup.slots.len != 0 || plan.exprLayer.exprLookup.buckets.len != 0:
        panic("lowering plan report: forbidden expr layer must be empty")
    if plan.typedExprFacts.count != 0:
        panic(Fmt"lowering plan report: forbidden typed-expr facts must be empty count={plan.typedExprFacts.count}")
    var parts: LoweringReportPartsOwner
    let entryFunction = strings.CloneStr(plan.entrySymbol)
    let functionCount = plan.functionNames.len
    let functionList = LoweringFunctionListText(plan.functionSymbolTexts)
    let missingReasons = slplan.SystemLinkPlanListText(plan.missingReasons)
    let primaryIrBuildMode = strings.CloneStr(plan.primaryObjectIrBuildMode)
    let pipelineStage = LoweringPlanPipelineStage(plan)
    LoweringReportPartsAppendLine(parts, "lowering_function_count", IntToStr(functionCount))
    LoweringReportPartsAppendLine(parts, "lowering_total_count", IntToStr(functionCount))
    LoweringReportPartsAppendLine(
        parts,
        "lowering_semantic_snapshot_schema_version",
        IntToStr(plan.semanticSnapshotSchemaVersion))
    LoweringReportPartsAppendLine(
        parts,
        "lowering_semantic_snapshot_epoch",
        strings.Int64ToStr(plan.semanticSnapshotEpoch))
    LoweringReportPartsAppendLine(
        parts,
        "lowering_semantic_snapshot_predecessor_receipt_cid",
        layout.FixedBytes32Hex(
            plan.semanticSnapshotPredecessorReceiptCid))
    LoweringReportPartsAppendLine(
        parts,
        "lowering_semantic_snapshot_facts_root_cid",
        layout.FixedBytes32Hex(plan.semanticSnapshotFactsRootCid))
    LoweringReportPartsAppendLine(
        parts,
        "lowering_semantic_snapshot_cargo_cid",
        layout.FixedBytes32Hex(plan.semanticSnapshotCargoCid))
    LoweringReportPartsAppendLine(
        parts,
        "lowering_semantic_snapshot_lowering_authority_cid",
        layout.FixedBytes32Hex(
            plan.semanticSnapshotLoweringAuthorityCid))
    if plan.toolchainEncoderBuildProjectionReady:
        if !LoweringPlanToolchainEncoderProjectionStrictValid(plan):
            panic("lowering plan report: toolchain encoder projection invalid")
        let encoder = plan.toolchainEncoderBuildProjection
        let cargo = plan.toolchainEncoderCargoObjectReceipt
        let cargoPath =
            snapshot_bridge.CompilerSnapshotLoweringAuthorityCargoObjectAbsolutePath(
                plan.workspaceRoot, cargo)
        if cargoPath.len == 0:
            panic("lowering plan report: toolchain encoder Cargo path invalid")
        LoweringReportPartsAppendLine(
            parts,
            "encoder_build_projection_schema",
            execution.CompilerToolchainEncoderAuthorityBuildProjectionReceiptDomain)
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_build_authority_cid",
            layout.FixedBytes32Hex(encoder.buildAuthorityCid))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_canonical_row",
            IntToStr(encoder.canonicalRow))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_compiler_csg_artifact_cid",
            layout.FixedBytes32Hex(encoder.compilerCsgArtifactCid))
        LoweringReportPartsAppendLine(
            parts,
            "encoder_build_projection_compiler_csg_canonical_graph_cid",
            layout.FixedBytes32Hex(encoder.compilerCsgCanonicalGraphCid))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_compiler_csg_cargo_cid",
            layout.FixedBytes32Hex(encoder.compilerCsgCargoCid))
        LoweringReportPartsAppendLine(
            parts,
            "encoder_build_projection_compiler_csg_cargo_object_receipt_cid",
            layout.FixedBytes32Hex(
                encoder.compilerCsgCargoObjectReceiptCid))
        LoweringReportPartsAppendLine(
            parts,
            "encoder_build_projection_compiler_csg_facts_root_cid",
            layout.FixedBytes32Hex(encoder.compilerCsgFactsRootCid))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_compiler_csg_graph_cid",
            layout.FixedBytes32Hex(encoder.compilerCsgGraphCid))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_compiler_csg_source_bundle_cid",
            layout.FixedBytes32Hex(encoder.compilerCsgSourceBundleCid))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_content_cid",
            layout.FixedBytes32Hex(encoder.contentCid))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_document_cid",
            layout.FixedBytes32Hex(encoder.documentCid))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_module_path_text_id",
            IntToStr(encoder.modulePathTextId))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_producer_row",
            IntToStr(encoder.producerRow))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_projection_cid",
            layout.FixedBytes32Hex(encoder.projectionCid))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_receipt_cid",
            layout.FixedBytes32Hex(encoder.receiptCid))
        LoweringReportPartsAppendLine(
            parts,
            "encoder_build_projection_cargo_object_authority_slot",
            IntToStr(cargo.authoritySlot))
        LoweringReportPartsAppendLine(
            parts,
            "encoder_build_projection_cargo_object_authority_generation",
            IntToStr(cargo.authorityGeneration))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_cargo_object_row",
            IntToStr(cargo.cargoObjectRow))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_cargo_store_generation",
            strings.Int64ToStr(cargo.storeGeneration))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_cargo_store_identity_cid",
            layout.FixedBytes32Hex(cargo.cargoStoreIdentityCid))
        LoweringReportPartsAppendLine(
            parts,
            "encoder_build_projection_cargo_before_store_identity_cid",
            layout.FixedBytes32Hex(cargo.beforeStoreIdentityCid))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_cargo_head_cid",
            layout.FixedBytes32Hex(cargo.cargoHeadCid))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_cargo_manifest_cid",
            layout.FixedBytes32Hex(cargo.cargoManifestCid))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_cargo_store_receipt_cid",
            layout.FixedBytes32Hex(cargo.cargoStoreReceiptCid))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_cargo_csgc_object_cid",
            layout.FixedBytes32Hex(cargo.cargoCsgcObjectCid))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_cargo_absolute_path",
            cargoPath)
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_cargo_absolute_path_cid",
            layout.FixedBytes32Hex(cargo.cargoAbsolutePathCid))
        LoweringReportPartsAppendLine(
            parts, "encoder_build_projection_cargo_byte_count",
            IntToStr(cargo.cargoByteCount))
        LoweringReportPartsAppendLine(
            parts,
            "encoder_build_projection_cargo_before_read_observation_cid",
            layout.FixedBytes32Hex(cargo.beforeReadObservationCid))
        LoweringReportPartsAppendLine(
            parts,
            "encoder_build_projection_cargo_after_read_observation_cid",
            layout.FixedBytes32Hex(cargo.afterReadObservationCid))
    LoweringReportPartsAppendLine(
        parts,
        "lowering_snapshot_function_id_count",
        IntToStr(plan.snapshotFunctionIdsByTypedFunctionIndex.len))
    LoweringReportPartsAppendLine(
        parts,
        "lowering_snapshot_function_fragment_cid_count",
        IntToStr(
            plan.snapshotFunctionFragmentCidsByTypedFunctionIndex.len))
    LoweringReportPartsAppendLine(
        parts,
        "lowering_function_interface_cid_count",
        IntToStr(plan.interfaceCidByTypedFunctionIndex.len))
    LoweringReportPartsAppendLine(
        parts,
        "lowering_snapshot_call_count",
        IntToStr(plan.snapshotCallTargetTypedFunctionIndexes.len))
    LoweringReportPartsAppendLine(
        parts,
        "lowering_snapshot_value_definition_count",
        IntToStr(
            plan.snapshotValueDefinitionTypedFunctionIndexes.len))
    LoweringReportPartsAppendLine(parts, "lowering_reachable_count", IntToStr(plan.primaryObjectIrBuildFunctionCount))
    LoweringReportPartsAppendLine(parts, "lowering_skipped_count", IntToStr(plan.primaryObjectIrSkippedFunctionCount))
    LoweringReportPartsAppendLine(parts, "lowering_primary_ir_materialized_function_count", IntToStr(plan.primaryObjectIrBuildFunctionCount))
    LoweringReportPartsAppendLine(parts, "lowering_primary_ir_skipped_function_count", IntToStr(plan.primaryObjectIrSkippedFunctionCount))
    LoweringReportPartsAppendLine(parts, "lowering_source_entry_typed_function_index", IntToStr(plan.sourceEntryTypedFunctionIndex))
    LoweringReportPartsAppendLine(parts, "lowering_function_name_intern_pool_domain_cid", layout.FixedBytes32Hex(plan.functionNameInternPoolDomainCid))
    LoweringReportPartsAppendLine(parts, "lowering_function_name_identity_receipt_cid", layout.FixedBytes32Hex(plan.functionNameIdentityReceiptCid))
    var primaryIrFunctionCount = plan.primaryObjectIrFunctionCountSnapshot
    if primaryIrFunctionCount <= 0:
        primaryIrFunctionCount = plan.primaryObjectIr.functions.len
    LoweringReportPartsAppendLine(parts, "lowering_primary_ir_slot_function_count", IntToStr(primaryIrFunctionCount))
    let denseStoreReport = dense.DenseStoreContractReport(plan.functionDenseStore)
    LoweringReportPartsAppendLine(parts, "lowering_dense_store_function_count", IntToStr(denseStoreReport.functionCount))
    LoweringReportPartsAppendLine(parts, "lowering_dense_store_source_scoped_key_count", IntToStr(denseStoreReport.sourceScopedKeyCount))
    LoweringReportPartsAppendLine(parts, "lowering_dense_store_source_scoped_source_count", IntToStr(denseStoreReport.sourceScopedSourceCount))
    LoweringReportPartsAppendLine(parts, "lowering_dense_store_source_scoped_query_count", IntToStr(denseStoreReport.sourceScopedQueryCount))
    LoweringReportPartsAppendLine(parts, "lowering_dense_store_source_scoped_query_hit_count", IntToStr(denseStoreReport.sourceScopedQueryHitCount))
    LoweringReportPartsAppendLine(parts, "lowering_dense_store_source_scoped_query_miss_count", IntToStr(denseStoreReport.sourceScopedQueryMissCount))
    LoweringReportPartsAppendLine(parts, "lowering_dense_store_pointer_key_count", IntToStr(denseStoreReport.pointerKeyCount))
    LoweringReportPartsAppendLine(parts, "lowering_dense_store_suffix_guess_count", IntToStr(denseStoreReport.suffixGuessCount))
    LoweringReportPartsAppendLine(parts, "lowering_dense_store_tail_alias_count", IntToStr(denseStoreReport.tailAliasCount))
    LoweringReportPartsAppendLine(parts, "lowering_dense_store_query_count", IntToStr(denseStoreReport.sourceScopedQueryCount))
    LoweringReportPartsAppendLine(parts, "lowering_dense_store_hit_count", IntToStr(denseStoreReport.sourceScopedQueryHitCount))
    LoweringReportPartsAppendLine(parts, "lowering_dense_store_miss_count", IntToStr(denseStoreReport.sourceScopedQueryMissCount))
    LoweringReportPartsAppendLine(parts, "lowering_dense_store_fallback_scan_count", IntToStr(plan.loweringDenseStoreFallbackScanCount))
    LoweringReportPartsAppendLine(parts, "lowering_phase_arena_reset_count", IntToStr(plan.loweringPhaseArenaResetCount))
    LoweringReportPartsAppendLine(parts, "lowering_phase_arena_reserve_count", IntToStr(plan.loweringPhaseArenaReserveCount))
    LoweringReportPartsAppendLine(parts, "lowering_phase_arena_capacity_bytes", strings.Int64ToStr(plan.loweringPhaseArenaCapacityBytes))
    LoweringReportPartsAppendLine(parts, "lowering_phase_arena_used_bytes", strings.Int64ToStr(plan.loweringPhaseArenaUsedBytes))
    LoweringReportPartsAppendLine(parts, "lowering_phase_arena_peak_bytes", strings.Int64ToStr(plan.loweringPhaseArenaPeakBytes))
    LoweringReportPartsAppendLine(parts, "lowering_phase_arena_spill_count", IntToStr(plan.loweringPhaseArenaSpillCount))
    LoweringReportPartsAppendLine(parts, "phase_arena_peak_bytes", strings.Int64ToStr(plan.loweringPhaseArenaPeakBytes))
    LoweringReportPartsAppendLine(parts, "phase_arena_reset_count", IntToStr(plan.loweringPhaseArenaResetCount))
    LoweringReportPartsAppendLine(parts, "phase_arena_spill_count", IntToStr(plan.loweringPhaseArenaSpillCount))
    LoweringReportPartsAppendLine(parts, "lowering_retained_runtime_item_count", IntToStr(LoweringPlanRetainedRuntimeItemCount(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_retained_diagnostic_item_count", IntToStr(LoweringPlanRetainedDiagnosticItemCount(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_retained_payload_item_count", IntToStr(LoweringPlanRetainedPayloadItemCount(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_retained_approx_bytes", strings.Int64ToStr(LoweringPlanRetainedApproxBytes(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_structured_live_bytes", strings.Int64ToStr(LoweringPlanStructuredLiveBytes(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_structured_live_bytes_measurement_kind", "deterministic_capacity_estimate_not_process_rss")
    LoweringReportPartsAppendLine(parts, "lowering_defer_scope_transport_function_count", IntToStr(LoweringPlanDeferScopeTransportFunctionCount(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_defer_scope_transport_scope_row_count", IntToStr(LoweringPlanDeferScopeTransportScopeRowCount(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_defer_scope_transport_statement_row_count", IntToStr(LoweringPlanDeferScopeTransportStatementRowCount(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_defer_scope_transport_retained_item_count", IntToStr(LoweringPlanDeferScopeTransportRetainedItemCount(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_defer_scope_transport_capacity_bytes", strings.Int64ToStr(LoweringPlanDeferScopeTransportCapacityBytes(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_defer_scope_transport_retained_bytes", strings.Int64ToStr(LoweringPlanDeferScopeTransportRetainedBytes(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_defer_scope_transport_live_bytes", strings.Int64ToStr(LoweringPlanDeferScopeTransportLiveBytes(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_ownership_transport_function_count", IntToStr(LoweringPlanOwnershipTransportFunctionCount(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_ownership_transport_row_count", IntToStr(LoweringPlanOwnershipTransportRowCount(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_ownership_transport_retained_item_count", IntToStr(LoweringPlanOwnershipTransportRetainedItemCount(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_ownership_transport_capacity_bytes", strings.Int64ToStr(LoweringPlanOwnershipTransportCapacityBytes(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_ownership_transport_live_bytes", strings.Int64ToStr(LoweringPlanOwnershipTransportLiveBytes(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_defer_scope_transport_measurement_kind", "function_local_dense_slice_capacity_and_live")
    LoweringReportPartsAppendLine(parts, "lowering_defer_scope_transport_codec_kind", "in_memory_only_no_codec")
    var typedFunctionIndexCompletedText = "false"
    if plan.typedFunctionIndexCompleted:
        typedFunctionIndexCompletedText = "true"
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_index_completed", typedFunctionIndexCompletedText)
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_index_build_function_count", IntToStr(plan.typedFunctionIndexBuildFunctionCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_index_build_source_count", IntToStr(plan.typedFunctionIndexBuildSourceCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_index_build_bucket_visit_count", IntToStr(plan.typedFunctionIndexBuildBucketVisitCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_index_lookup_count", IntToStr(plan.typedFunctionIndexLookupCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_index_lookup_bucket_visit_count", IntToStr(plan.typedFunctionIndexLookupBucketVisitCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_index_lookup_max_bucket_visit_count", IntToStr(plan.typedFunctionIndexLookupMaxBucketVisitCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_index_source_count", IntToStr(plan.typedFunctionIndexSourceCountSnapshot))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_index_entry_count", IntToStr(plan.typedFunctionIndexEntryCountSnapshot))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_index_composite_key_payload_bytes", strings.Int64ToStr(plan.typedFunctionIndexCompositeKeyPayloadBytes))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_lookup_sidecar_retained_item_count", IntToStr(LoweringTypedFunctionLookupSidecarRetainedItemCount(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_lookup_sidecar_capacity_estimate_bytes", strings.Int64ToStr(LoweringTypedFunctionLookupSidecarCapacityEstimateBytes(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_lookup_sidecar_peak_capacity_estimate_bytes", strings.Int64ToStr(plan.typedFunctionIndexPeakSidecarCapacityEstimateBytes))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_lookup_sidecar_measurement_kind", "deterministic_capacity_estimate_not_process_rss")
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_dense_store_function_count", IntToStr(LoweringTypedFunctionDenseStoreFunctionCount(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_identity_build_function_count", IntToStr(plan.typedFunctionIdentityBuildFunctionCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_identity_build_bucket_visit_count", IntToStr(plan.typedFunctionIdentityBuildBucketVisitCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_identity_lookup_count", IntToStr(plan.typedFunctionIdentityLookupCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_identity_lookup_bucket_visit_count", IntToStr(plan.typedFunctionIdentityLookupBucketVisitCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_identity_lookup_max_bucket_visit_count", IntToStr(plan.typedFunctionIdentityLookupMaxBucketVisitCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_identity_retained_item_count", IntToStr(LoweringTypedFunctionIdentityIndexRetainedItemCount(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_identity_capacity_estimate_bytes", strings.Int64ToStr(LoweringTypedFunctionIdentityIndexCapacityEstimateBytes(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_identity_measurement_kind", "deterministic_capacity_estimate_not_process_rss")
    var functionReferenceCompletedText = "false"
    if plan.typedFunctionReferenceIndexCompleted:
        functionReferenceCompletedText = "true"
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_index_completed", functionReferenceCompletedText)
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_build_function_count", IntToStr(plan.typedFunctionReferenceBuildFunctionCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_build_statement_count", IntToStr(plan.typedFunctionReferenceBuildStatementCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_build_node_count", IntToStr(plan.typedFunctionReferenceBuildNodeCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_build_bucket_visit_count", IntToStr(plan.typedFunctionReferenceBuildBucketVisitCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_resolve_lookup_count", IntToStr(plan.typedFunctionReferenceResolveLookupCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_resolve_bucket_visit_count", IntToStr(plan.typedFunctionReferenceResolveBucketVisitCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_resolve_max_bucket_visit_count", IntToStr(plan.typedFunctionReferenceResolveMaxBucketVisitCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_surface_byte_visit_count", strings.Int64ToStr(plan.typedFunctionReferenceSurfaceByteVisitCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_direct_target_count", IntToStr(plan.typedFunctionReferenceDirectTargetCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_func_ref_count", IntToStr(plan.typedFunctionReferenceFuncRefCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_surface_count", IntToStr(plan.typedFunctionReferenceSurfaceCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_address_count", IntToStr(plan.typedFunctionReferenceAddressCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_referenced_function_count", IntToStr(plan.typedFunctionReferenceReferencedFunctionCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_ambiguous_count", IntToStr(plan.typedFunctionReferenceAmbiguousCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_missing_count", IntToStr(plan.typedFunctionReferenceMissingCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_flag_query_count", IntToStr(plan.typedFunctionReferenceFlagQueryCount))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_source_count", IntToStr(plan.typedFunctionReferenceSourceCountSnapshot))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_alias_count", IntToStr(plan.typedFunctionReferenceAliasCountSnapshot))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_global_alias_count", IntToStr(plan.typedFunctionReferenceGlobalAliasCountSnapshot))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_composite_key_payload_bytes", strings.Int64ToStr(plan.typedFunctionReferenceCompositeKeyPayloadBytes))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_retained_item_count", IntToStr(LoweringTypedFunctionReferenceIndexRetainedItemCount(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_capacity_estimate_bytes", strings.Int64ToStr(LoweringTypedFunctionReferenceIndexCapacityEstimateBytes(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_peak_capacity_estimate_bytes", strings.Int64ToStr(plan.typedFunctionReferencePeakCapacityEstimateBytes))
    LoweringReportPartsAppendLine(parts, "lowering_typed_function_reference_measurement_kind", "deterministic_capacity_estimate_not_process_rss")
    var moduleSourceIndexCompletedText = "false"
    if plan.moduleSourceIndexCompleted:
        moduleSourceIndexCompletedText = "true"
    LoweringReportPartsAppendLine(parts, "lowering_module_source_index_completed", moduleSourceIndexCompletedText)
    LoweringReportPartsAppendLine(parts, "lowering_module_source_index_build_source_count", IntToStr(plan.moduleSourceIndexBuildSourceCount))
    LoweringReportPartsAppendLine(parts, "lowering_module_source_index_build_bucket_visit_count", IntToStr(plan.moduleSourceIndexBuildBucketVisitCount))
    LoweringReportPartsAppendLine(parts, "lowering_module_source_index_lookup_count", IntToStr(plan.moduleSourceIndexLookupCount))
    LoweringReportPartsAppendLine(parts, "lowering_module_source_index_lookup_bucket_visit_count", IntToStr(plan.moduleSourceIndexLookupBucketVisitCount))
    LoweringReportPartsAppendLine(parts, "lowering_module_source_index_lookup_max_bucket_visit_count", IntToStr(plan.moduleSourceIndexLookupMaxBucketVisitCount))
    LoweringReportPartsAppendLine(parts, "lowering_module_source_index_duplicate_module_count", IntToStr(plan.moduleSourceIndexDuplicateModuleCount))
    LoweringReportPartsAppendLine(parts, "lowering_module_source_index_source_count", IntToStr(plan.moduleSourceIndexSourceCountSnapshot))
    LoweringReportPartsAppendLine(parts, "lowering_module_source_index_composite_key_payload_bytes", strings.Int64ToStr(plan.moduleSourceIndexCompositeKeyPayloadBytes))
    LoweringReportPartsAppendLine(parts, "lowering_module_source_index_retained_item_count", IntToStr(LoweringModuleSourceIndexRetainedItemCount(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_module_source_index_capacity_estimate_bytes", strings.Int64ToStr(LoweringModuleSourceIndexCapacityEstimateBytes(plan)))
    LoweringReportPartsAppendLine(parts, "lowering_module_source_index_peak_capacity_estimate_bytes", strings.Int64ToStr(plan.moduleSourceIndexPeakCapacityEstimateBytes))
    LoweringReportPartsAppendLine(parts, "lowering_module_source_index_measurement_kind", "deterministic_capacity_estimate_not_process_rss")
    LoweringReportPartsAppendLine(parts, "lowering_reachable_first", IntToStr(plan.primaryObjectIrReachableFirst))
    LoweringReportPartsAppendLine(
        parts, "lowering_reachable_first_mode", primaryIrBuildMode)
    LoweringReportPartsAppendLine(parts, "lowering_export_root_count", IntToStr(plan.primaryObjectIrExportRootCount))
    LoweringReportPartsAppendLine(parts, "lowering_primary_ir_full_materialization", IntToStr(plan.primaryObjectIrFullMaterialization))
    LoweringReportPartsAppendLine(parts, "lowering_functions", functionList)
    LoweringReportPartsAppendLine(parts, "lowering_entry_function", entryFunction)
    let exprSummary = plan.exprSummary
    LoweringReportPartsAppendLine(parts, "expr_surface_source_count", IntToStr(exprSummary.sourceCount))
    LoweringReportPartsAppendLine(parts, "expr_surface_expr_count", IntToStr(exprSummary.exprCount))
    LoweringReportPartsAppendLine(parts, "expr_surface_if_count", IntToStr(exprSummary.ifCount))
    LoweringReportPartsAppendLine(parts, "expr_surface_range_count", IntToStr(exprSummary.rangeCount))
    LoweringReportPartsAppendLine(parts, "expr_surface_comprehension_count", IntToStr(exprSummary.comprehensionCount))
    LoweringReportPartsAppendLine(parts, "expr_surface_fmt_count", IntToStr(exprSummary.strFormatCount))
    LoweringReportPartsAppendLine(parts, "expr_surface_result_intrinsic_count", IntToStr(exprSummary.resultIntrinsicCount))
    LoweringReportPartsAppendLine(parts, "expr_surface_try_count", IntToStr(exprSummary.tryCount))
    LoweringReportPartsAppendLine(parts, "expr_surface_default_init_count", IntToStr(exprSummary.defaultInitCount))
    LoweringReportPartsAppendLine(parts, "expr_surface_constructor_count", IntToStr(exprSummary.constructorCount))
    LoweringReportPartsAppendLine(parts, "expr_surface_question_residual_count", IntToStr(exprSummary.questionResidualCount))
    LoweringReportPartsAppendLine(parts, "typed_expr_fact_payload_retained_count", IntToStr(plan.typedExprFacts.count))
    var compactExprReleasedText = "false"
    if plan.compactExprPayloadReleasedBeforeSourceClosure:
        compactExprReleasedText = "true"
    LoweringReportPartsAppendLine(parts, "compact_expr_payload_released_before_source_closure", compactExprReleasedText)
    LoweringReportPartsAppendLine(parts, "resolved_call_snapshot_entry_count", IntToStr(plan.resolvedCallSnapshot.sourcePathIds.len))
    LoweringReportPartsAppendLine(parts, "extern_ffi_handle_call_capability_bridge_call_count", IntToStr(plan.externFfiHandleCallCapabilityBridge.snapshotCallIds.len))
    LoweringReportPartsAppendLine(parts, "extern_ffi_handle_call_capability_bridge_effect_count", IntToStr(plan.externFfiHandleCallCapabilityBridge.snapshotEffectRows.len))
    LoweringReportPartsAppendLine(parts, "extern_ffi_handle_call_capability_bridge_physical_buffer_count", IntToStr(LoweringExternFfiHandleCallCapabilityBridgePhysicalBufferCount(plan.externFfiHandleCallCapabilityBridge)))
    LoweringReportPartsAppendLine(parts, "extern_ffi_handle_call_capability_bridge_retained_bytes", strings.Int64ToStr(LoweringExternFfiHandleCallCapabilityBridgeRetainedBytes(plan.externFfiHandleCallCapabilityBridge)))
    LoweringReportPartsAppendLine(parts, "extern_ffi_handle_call_capability_bridge_semantic_cargo_cid", layout.FixedBytes32Hex(plan.externFfiHandleCallCapabilityBridge.semanticCargoCid))
    LoweringReportPartsAppendLine(parts, "extern_ffi_handle_call_capability_bridge_cid", layout.FixedBytes32Hex(plan.externFfiHandleCallCapabilityBridge.bridgeCid))
    LoweringReportPartsAppendLine(parts, "typed_expr_lowering_rule_count", IntToStr(plan.loweringRuleCount))
    let typedFactSummaryReport = ccsg.CompilerCsgSemanticTypedFactSummaryReportText(plan.typedFactSummary,
                                                                             plan.typedExprFactCountSnapshot)
    LoweringReportPartsAppendBlock(parts, typedFactSummaryReport)
    let typedIrReport = texpr.TypedExprIrReportText(plan.typedIr)
    LoweringReportPartsAppendBlock(parts, typedIrReport)
    let returnOpReport =
        texpr.TypedExprReturnOpFactsReportText(plan.typedReturnOps)
    LoweringReportPartsAppendBlock(parts, returnOpReport)
    let primaryObjectIrReport =
        LoweringPrimaryObjectIrReportText(plan.primaryObjectIr)
    LoweringReportPartsAppendBlock(parts, primaryObjectIrReport)
    LoweringReportPartsAppendLine(parts, "lowering_source_bundle_cid", layout.FixedBytes32Hex(plan.sourceBundleCid))
    LoweringReportPartsAppendLine(parts, "lowering_compiler_csg_cid", layout.FixedBytes32Hex(plan.compilerCsgCid))
    LoweringReportPartsAppendLine(parts, "lowering_type_arena_artifact_cid", layout.FixedBytes32Hex(plan.typeArenaArtifactCid))
    LoweringReportPartsAppendLine(parts, "lowering_missing_reasons", missingReasons)
    LoweringReportPartsAppendLine(parts, "exec_pipeline_stage", pipelineStage)
    let report = strutil.Join(parts.parts, "")
    var reportPartsReceipt: LoweringSequenceAllocatorReceipt
    LoweringReportPartsReleaseWithReceipt(parts, reportPartsReceipt)
    if !LoweringReportPartsReceiptConsumeStrict(
           parts, reportPartsReceipt):
        panic("lowering plan report parts: strict consume failed")
    return report
