fn LoweringPlanReleaseImportOwnerIndexPayload(
        plan: var LoweringPlanStub) =
    LoweringImportOwnerIndexAllocatorRelease(plan)

fn LoweringBuildImportEdgeIndex(plan: var LoweringPlanStub) =
    LoweringPlanReleaseUnqualifiedImportResolveCachePayload(plan)
    LoweringUnqualifiedImportResolveCacheAllocatorBegin(plan)
    LoweringPlanReleaseQualifiedImportResolveCachePayload(plan)
    LoweringQualifiedImportResolveCacheAllocatorBegin(plan)
    LoweringPlanReleaseImportEdgeIndexPayload(plan)
    LoweringImportEdgeIndexAllocatorBegin(plan)
    LoweringPlanReleaseImportOwnerIndexPayload(plan)
    LoweringImportOwnerIndexAllocatorBegin(plan)
    let bucketCount = LoweringTypedFunctionIndexBucketCount(plan.importEdges.len)
    for bucketIndex in 0..<bucketCount:
        LoweringImportEdgeIndexAppendBucket(plan, -1)
        LoweringImportOwnerIndexAppendBucket(plan, -1)
    for edgeIndex in 0..<plan.importEdges.len:
        let edge = plan.importEdges[edgeIndex]
        if !edge.resolved:
            continue
        let ownerModulePath = chengpath.PathTrim(edge.ownerModulePath)
        let qualifier = parser.ParserIdentPrefix(chengpath.PathTrim(edge.qualifier))
        if ownerModulePath == "":
            continue
        let ownerBucket = LoweringImportOwnerIndexBucket(ownerModulePath,
                                                         plan.importOwnerIndexBucketHeads.len)
        if ownerBucket >= 0:
            let ownerEntryIndex = plan.importOwnerIndexOwnerModulePaths.len
            LoweringImportOwnerIndexAppendRow(
                plan,
                ownerModulePath,
                edgeIndex,
                plan.importOwnerIndexBucketHeads[ownerBucket])
            plan.importOwnerIndexBucketHeads[ownerBucket] = ownerEntryIndex
        if qualifier != "":
            let bucket = LoweringImportEdgeIndexBucket(ownerModulePath,
                                                       qualifier,
                                                       plan.importEdgeIndexBucketHeads.len)
            if bucket >= 0:
                let entryIndex = plan.importEdgeIndexOwnerModulePaths.len
                LoweringImportEdgeIndexAppendRow(
                    plan,
                    ownerModulePath,
                    qualifier,
                    edgeIndex,
                    plan.importEdgeIndexBucketHeads[bucket])
                plan.importEdgeIndexBucketHeads[bucket] = entryIndex

@borrows
fn loweringPlanImportEdgeTargetForOwnerQualifierFrozen(
        plan: LoweringPlanStub,
        ownerModulePathRaw: str,
        qualifierRaw: str,
        targetSourcePathOut: var str,
        targetModulePathOut: var str): bool =
    targetSourcePathOut = ""
    targetModulePathOut = ""
    let ownerModulePath = chengpath.PathTrim(ownerModulePathRaw)
    let qualifier = parser.ParserIdentPrefix(chengpath.PathTrim(qualifierRaw))
    if ownerModulePath == "" || qualifier == "":
        return false
    if plan.importEdgeIndexBucketHeads.len <= 0:
        panic("lowering import edge index: frozen lookup source missing")
    let bucket = LoweringImportEdgeIndexBucket(ownerModulePath,
                                               qualifier,
                                               plan.importEdgeIndexBucketHeads.len)
    if bucket < 0:
        return false
    var entryIndex = plan.importEdgeIndexBucketHeads[bucket]
    var foundSourcePath = ""
    var foundModulePath = ""
    while entryIndex >= 0:
        if entryIndex >= plan.importEdgeIndexOwnerModulePaths.len ||
           entryIndex >= plan.importEdgeIndexQualifiers.len ||
           entryIndex >= plan.importEdgeIndexEntryEdgeIndexes.len:
            break
        if plan.importEdgeIndexOwnerModulePaths[entryIndex] == ownerModulePath &&
           plan.importEdgeIndexQualifiers[entryIndex] == qualifier:
            let edgeIndex = plan.importEdgeIndexEntryEdgeIndexes[entryIndex]
            if edgeIndex >= 0 && edgeIndex < plan.importEdges.len:
                let edge = plan.importEdges[edgeIndex]
                if edge.resolved:
                    let targetSourcePath = parser.ParserNormalizePath(edge.targetSourcePath)
                    if targetSourcePath != "":
                        if foundSourcePath != "" && foundSourcePath != targetSourcePath:
                            targetSourcePathOut = ""
                            targetModulePathOut = ""
                            return false
                        foundSourcePath = targetSourcePath
                        foundModulePath = chengpath.PathTrim(edge.targetModulePath)
        if entryIndex >= plan.importEdgeIndexEntryNext.len:
            break
        entryIndex = plan.importEdgeIndexEntryNext[entryIndex]
    if foundSourcePath == "":
        return false
    targetSourcePathOut = foundSourcePath
    targetModulePathOut = foundModulePath
    return true

@borrows
fn LoweringPlanImportEdgeTargetForOwnerQualifier(plan: var LoweringPlanStub,
                                                  ownerModulePathRaw: str,
                                                  qualifierRaw: str,
                                                  targetSourcePathOut: var str,
                                                  targetModulePathOut: var str): bool =
    if plan.importEdgeIndexBucketHeads.len <= 0:
        LoweringBuildImportEdgeIndex(plan)
    return loweringPlanImportEdgeTargetForOwnerQualifierFrozen(
        plan,
        ownerModulePathRaw,
        qualifierRaw,
        targetSourcePathOut,
        targetModulePathOut)

