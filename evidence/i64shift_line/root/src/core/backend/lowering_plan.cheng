        importOwnerIndexAllocator: LoweringSequenceAllocatorReceipt
        qualifiedImportResolveCacheAllocator: LoweringSequenceAllocatorReceipt
        unqualifiedImportResolveCacheAllocator: LoweringSequenceAllocatorReceipt
        moduleSourceIndexAllocator: LoweringSequenceAllocatorReceipt
        fnPtrFieldCallAllocator: LoweringSequenceAllocatorReceipt
        typeArenaOwnerProofAllocator: LoweringSequenceAllocatorReceipt
        functionSemanticIdentityAllocator: LoweringSequenceAllocatorReceipt
        functionRuntimeIdentityAllocator: LoweringSequenceAllocatorReceipt
        functionEmissionMetadataAllocator: LoweringSequenceAllocatorReceipt
        canonicalSnapshotProjectionAllocator: LoweringSequenceAllocatorReceipt
        semanticDebugProjectionAllocator: LoweringSequenceAllocatorReceipt
        primaryObjectIrFunctionShapeAllocator: LoweringSequenceAllocatorReceipt
        primaryObjectIrCallTargetAllocator: LoweringSequenceAllocatorReceipt
        typedFunctionDenseStoreInputAllocator: LoweringSequenceAllocatorReceipt
        functionDenseStoreInputAllocator: LoweringSequenceAllocatorReceipt

    LoweringSemanticDebugProjectionOwner =
