        bodyIrCallCountsParts: str[]
        statementSequenceCountsParts: str[]
        statementSequenceKindsParts: str[]
        statementSequenceTargetsParts: str[]
        statementSequenceBindingsParts: str[]
        statementSequenceResultTypesParts: str[]
        noAliasAppliedFlagsParts: str[]
        noAliasLocalCountsParts: str[]
        noAliasForwardRewriteCountsParts: str[]
        domain: LoweringPrimaryObjectIrReportProjectionDomain
        allocatorLedger: LoweringSequenceAllocatorLedger
        allocatorReceipt: LoweringSequenceAllocatorReceipt
        ownerToken: layout.FixedBytes32
        allocatorReceiptReady: bool
        allocatorReceiptConsumed: bool

    LoweringReportPartsOwner =
        parts: str[]
        allocatorLedger: LoweringSequenceAllocatorLedger
        allocatorReceipt: LoweringSequenceAllocatorReceipt
        ownerToken: layout.FixedBytes32
        allocatorReceiptReady: bool
        allocatorReceiptConsumed: bool

    LoweringTypedDenseFunctionNameLength =
        length: int32

    LoweringTypedDenseParamCountLength =
        length: int32

    LoweringTypedDenseResultTypeLength =
        length: int32

    LoweringTypedDenseSourcePathLength =
        length: int32

