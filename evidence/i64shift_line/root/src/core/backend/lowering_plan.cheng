fn LoweringQualifiedImportResolveCacheAllocatorPhysicalBufferCount(
        plan: LoweringPlanStub): int32 =
    var count: int32
    if plan.qualifiedImportResolveCacheSourcePaths.cap > 0:
        count = count + 1
    if plan.qualifiedImportResolveCacheQualifiers.cap > 0:
        count = count + 1
    if plan.qualifiedImportResolveCacheTargetSourcePaths.cap > 0:
        count = count + 1
    if plan.qualifiedImportResolveCacheBucketHeads.cap > 0:
        count = count + 1
    if plan.qualifiedImportResolveCacheEntryNext.cap > 0:
