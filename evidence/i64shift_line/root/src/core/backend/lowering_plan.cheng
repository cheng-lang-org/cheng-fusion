        allocatorReceipt: LoweringSequenceAllocatorReceipt
        ownerToken: layout.FixedBytes32
        allocatorReceiptReady: bool
        allocatorReceiptConsumed: bool

    LoweringFunctionTaskParticipantStorageDomain =
        functionCount: int32
        actualWorkerCount: int32
        taskCount: int32

    LoweringFunctionTaskParticipantStorageOwner =
        sourceRows: int32[]
        sourceGenerations: int32[]
        sourceOwners: int32[]
        terminalRows: int32[]
        terminalGenerations: int32[]
        terminalOwners: int32[]
        terminalResultWord0s: uint64[]
        terminalResultWord1s: uint64[]
        terminalResultWord2s: uint64[]
        terminalResultWord3s: uint64[]
        boundaryCid: layout.FixedBytes32
        boundaryRoot: system.RuntimeAllocationLedgerParticipantRoot
        domain: LoweringFunctionTaskParticipantStorageDomain
        allocatorLedger: LoweringSequenceAllocatorLedger
        allocatorReceipt: LoweringSequenceAllocatorReceipt
        ownerToken: layout.FixedBytes32
        allocatorReceiptReady: bool
        allocatorReceiptConsumed: bool

    LoweringFunctionTaskResultIdentityDomain =
        functionCount: int32

    LoweringFunctionTaskResultIdentityOwner =
        workerIds: int32[]
        resultCids: layout.FixedBytes32[]
        domain: LoweringFunctionTaskResultIdentityDomain
        allocatorLedger: LoweringSequenceAllocatorLedger
        allocatorReceipt: LoweringSequenceAllocatorReceipt
        ownerToken: layout.FixedBytes32
        allocatorReceiptReady: bool
        allocatorReceiptConsumed: bool

    LoweringStatementCallTargetDuplicateFlagsOwner =
        flags: bool[]
        allocatorLedger: LoweringSequenceAllocatorLedger

    PrimaryObjectIrStatement =
        sourcePath: str
        functionName: str
        statementIndex: int32
        lineNumber: int32
        columnNumber: int32
        endLineNumber: int32
        endColumnNumber: int32
        lexicalScopeId: int32
        suiteScopeId: int32
        statementOrdinal: int32
        lexicalOrdinal: int32
        deferOwnerStatementOrdinal: int32
        lineIndent: int32
        kind: texpr.TypedExprIrStatementKind
        callKind: texpr.TypedExprCallKind
        detailKind: parser.NormalizedExprDetailKind
        surfaceText: str
        bindingName: str
        resultType: str
        conditionKind: int32
        conditionLhsText: str
        conditionRhsText: str
        conditionLiteralText: str
        assignRootName: str
        assignRootType: str
        assignRootSourcePath: str
        assignRootGlobalFlag: bool
        assignPlaceKind: texpr.TypedExprPlaceKind
        assignFieldName: str
        assignFieldType: str
        assignFieldOffsetBytes: int32
        assignFieldSizeBytes: int32
        assignFieldAlignBytes: int32
        assignValueRootName: str
        assignValueRootType: str
        assignValueFieldName: str
        assignValueFieldType: str
        assignValueFieldOffsetBytes: int32
        assignValueFieldSizeBytes: int32
        assignValueFieldAlignBytes: int32
        assignValueOpKind: texpr.TypedExprIrOpKind
        assignValueLhsText: str
        assignValueRhsText: str
        callCallee: str
        callTarget: str
        callTargetSourcePath: str
        callTargetSignatureLineNumber: int32
        callTargetImportc: bool
        callArgCount: int32
        callArgsText: str
        callArgTypesText: str
        callArgNodeStart: int32
        callArgNodeCount: int32
        # 2b 表达式节点 DAG 根（typedIr.nodes 下标），-1=无节点。
        rhsNodeIndex: int32
        rhsBailReason: texpr.RhsBailReason
        # P2 schema (atomic w/ producer at primary_object_plan PrimaryBodyIrTargetFunctionIndex
        # + 17 tail consumer sites): explicit 10-case call-target resolution
        # status, init = CallTargetUnresolved. Set by producer when statement
        # call resolution runs; consumer (PObjP tail-name reads, dispatch_min
        # output) reads kind directly instead of count-阈值 reverse guess.
        callTargetResolutionKind: texpr.CallTargetResolutionKind
        callSurfaceKind: texpr.CallSurfaceKind
        forStartNodeIndex: int32
        assignLvalueNodeIndex: int32
        assignIndexNodeIndex: int32
        # [wall72] 语句级绑定目标定义行：typed-ir 权威 valueDefinitions 行
        # （声明组唯一 definitionRows）；-1=本语句无绑定目标定义身份。
        # 消费端（primary new-object alloc 定义盖章）只认本列坐标，
        # 不按 LHS lvalue 节点行（文本降级设计恒 -1）。
        bindingTargetDefinitionRow: int32
        returnRoot: bool

    # Function-local lowering carrier for structured exits. Both groups are SoA:
    # scope rows are dense local ids; statement rows retain TypedExprIr CSR order.
    # source*Start/count name physical TypedIR SoA slices, never source-wide ids.
    # No surface text or indentation participates in this contract.
    LoweringDeferScopeTransportSoA =
        typedFunctionIndex: int32
        sourceStatementStart: int32
        sourceStatementCount: int32
        sourceScopeStart: int32
        sourceScopeCount: int32
        scopeIds: int32[]
        scopeParentIds: int32[]
        scopeKinds: parser.NormalizedScopeKind[]
        scopeOwnerStatementOrdinals: int32[]
        scopeLexicalOrdinals: int32[]
        scopeStartLineNumbers: int32[]
        scopeStartColumnNumbers: int32[]
        scopeEndLineNumbers: int32[]
        scopeEndColumnNumbers: int32[]
        statementIndexes: int32[]
        statementKinds: texpr.TypedExprIrStatementKind[]
        statementLineNumbers: int32[]
        statementColumnNumbers: int32[]
        statementEndLineNumbers: int32[]
        statementEndColumnNumbers: int32[]
        statementLexicalScopeIds: int32[]
        statementSuiteScopeIds: int32[]
        statementOrdinals: int32[]
        statementLexicalOrdinals: int32[]
        statementDeferOwnerStatementOrdinals: int32[]
        allocatorLedger: LoweringSequenceAllocatorLedger
        complete: bool

    # Function-local immutable bridge for every exact TypedExpr value
    # definition. Rows are selected by the function value-definition CSR;
    # declaration groups remain an optional BindingInitializer-only edge.
    # Source text, binding names and mutable LocalSlot ownership never
    # participate in identity.
    LoweringOwnershipTransportSoA =
        typedFunctionIndex: int32 = -1
        sourceValueDefinitionStart: int32
        sourceValueDefinitionCount: int32
        typeArenaArtifactCid: layout.FixedBytes32
        definitionGroupRows: int32[]
        definitionRows: int32[]
        originKinds: int32[]
        sourceLocalNodeIndexes: int32[]
        declarationSourceLocalRows: int32[]
        patternSourceLocalRows: int32[]
        sourceStatementIndexes: int32[]
        definingNodeIndexes: int32[]
        exactTypeIds: int32[]
        ownershipKinds: texpr.TypedExprExprClass[]
        borrowOwnerValueDefinitionRows: int32[]
        proofKinds: int32[]
        managedFlags: bool[]
        nodeOpKinds: texpr.TypedExprIrOpKind[]
        callDeclarationIndexes: int32[]
        allocatorLedger: LoweringSequenceAllocatorLedger
        complete: bool

    PrimaryObjectIrFunction =
        sourcePath: str
        functionName: str
        signatureLineNumber: int32
        bodyLineNumber: int32
        bodyKind: str
        typedFunctionIndex: int32
        paramNames: str[]
        paramTypes: str[]
        statementCount: int32
        statements: PrimaryObjectIrStatement[]
        functionShapeAllocatorLedger: LoweringSequenceAllocatorLedger
        callTargetCount: int32
        callArgCounts: int32[]
        callTargets: str[]
        callTargetSourcePaths: str[]
        callTargetSignatureLineNumbers: int32[]
        callTargetImportcFlags: bool[]
        # Exact Cheng target TypedExpr function row per call ordinal.
        # Importc and explicit synthetic operations carry -1 and are admitted
        # only by their separate call-kind authority.
        callTargetTypedFunctionIndexes: int32[]
        callImportcSymbols: str[]
        # gapB overload-dispatch 类型过滤: 与 callTargets 平行 (同 ordinal), 每个调用位
        # 实参静态类型的逗号联结文本 (TypedExprIrCallArgTypesText 产出); 未知/不可推导
        # 留 "" (保守: 不过滤, 维持原有解析语义, 不臆造)。
        callArgTypesTexts: str[]
        callTargetAllocatorLedger: LoweringSequenceAllocatorLedger
        deferScopeTransport: LoweringDeferScopeTransportSoA
        ownershipTransport: LoweringOwnershipTransportSoA
        bodyIR: coreir.BodyIR
        bodyIrNoAliasApplied: bool
        bodyIrNoAliasLocalCount: int32
        bodyIrNoAliasForwardRewriteCount: int32

    PrimaryObjectIr =
        functions: PrimaryObjectIrFunction[]
        functionShapeAllocatorReceipt: LoweringSequenceAllocatorReceipt
        functionShapeAllocatorReceiptReady: bool
        callTargetAllocatorReceipt: LoweringSequenceAllocatorReceipt
        callTargetAllocatorReceiptReady: bool

    LoweringExportRootIndex =
        candidateBucketHeads: int32[]
        candidateEntryNext: int32[]
        candidateEntryKinds: int32[]
        candidateEntryNames: str[]
        candidateEntryHeads: int32[]
        candidateEntryTails: int32[]
        candidateNext: int32[]
        candidateFunctionIndexes: int32[]
        exactExportBucketHeads: int32[]
        exactExportEntryNext: int32[]
        exactExportEntryNames: str[]
        exactExportEntryFirstFunctionIndexes: int32[]
        exactExportEntryCounts: int32[]
        allocatorLedger: LoweringSequenceAllocatorLedger
        allocatorReceipt: LoweringSequenceAllocatorReceipt
        allocatorReceiptReady: bool
        built: bool
        completed: bool
        buildFunctionCount: int32
        buildBucketVisitCount: int32
        lookupCount: int32
        lookupBucketVisitCount: int32
        lookupCandidateVisitCount: int32
        lookupMaxBucketVisitCount: int32
        retainedItemCountSnapshot: int32
        peakCapacityEstimateBytes: int64

    LoweringPlanStub =
        workspaceRoot: str
        packageRoot: str
        packageId: str
        entryPath: str
        entrySymbol: str
        # Exact TypedExpr row admitted for the structured source-entry role.
        # All downstream entry flags are projections of this int32 identity.
        sourceEntryTypedFunctionIndex: int32
        sourceBundleCid: layout.FixedBytes32
        compilerCsgCid: layout.FixedBytes32
        canonicalCompilerCsgCid: layout.FixedBytes32
        exprLayer: parser.NormalizedExprLayer
        exprSummary: ccsg.CompilerCsgSemanticExprSummary
        compilerCsgExprSliceSidecar: ccsg.CompilerCsgSemanticExprSliceTable
        compilerCsgExprSliceSidecarBound: bool
        compilerCsgExprSliceSidecarComplete: bool
        compilerCsgExprSliceSidecarCount: int32
        compilerCsgExprSliceSidecarFunctionBoundCount: int32
        compilerCsgExprSliceSidecarCoveredCount: int32
        compilerCsgExprSliceSidecarGapCount: int32
        compilerCsgExprSliceSidecarOverlapCount: int32
        compilerCsgExprSliceSidecarInvalidSliceCount: int32
        compilerCsgExprSliceSidecarSyntheticCount: int32
        compilerCsgExprSliceSidecarValidationReason: str
        compilerCsgExprSliceSidecarRangeQueryCount: int32
        compilerCsgExprSliceSidecarRangeHitCount: int32
        compilerCsgExprSliceSidecarRangeEmptyCount: int32
        compilerCsgExprSliceSidecarRangeFallbackCount: int32
        compilerCsgExprSliceConsumedCount: int32
        compilerCsgExprSliceConsumedFunctionBoundCount: int32
        compilerCsgExprSliceVerifiedComplete: bool
        typedExprFacts: ccsg.TypedExprFactTable
        typedExprFactCountSnapshot: int32
        typedExprTypeCallDefaultInitCountSnapshot: int32
        typedExprTypeCallConstructorCountSnapshot: int32
        typedFactSummary: ccsg.CompilerCsgSemanticTypedFactSummary
        compactExprPayloadReleasedBeforeSourceClosure: bool
        compilerCsgBackendPayloadReleased: bool
        compilerCsgLifecycleInitialBufferCount: int32
        compilerCsgLifecycleInitialBytes: int64
        compilerCsgLifecycleReleasedBufferCount: int32
        compilerCsgLifecycleReleasedBytes: int64
        compilerCsgLifecycleTransferredBufferCount: int32
