fn PrimaryFillCallIndirectVoidBridgeWords(words: var int32[],
                                           wordOffset: int32): bool =
    if wordOffset < 0 || wordOffset + 2 >= words.len:
        return false
    # form44 案卷根修 (BACKFILL-9 F47 收尾): 原 BLR+RET 二段式跳板是自锁死
    # 循环——BLR 会把 X30(LR) 改写成"桥自己那条 RET 的地址", 被调方按标准
    # ABI 用未改动的 X30 做自己的 RET 时会跳回桥的 RET, 而桥的 RET 再次用
    # 同一个 X30 跳回自己, 永久自旋(实测: f47_probe_two_globals 间接调用后
    # 挂起, CPU 占用 ~80% 不落地; lldb 断点确认 PC 冻结在桥的 RET 指令)。
    # 改成纯尾调用(BR 不写 LR), 保留调用方进入桥时的 X30 不变, 被调方的
    # RET 直接跳回真正的原始调用方。
    words[wordOffset] = Value(a64.A64EncAddImm(true, a64.A64X16, a64.A64X0, 0))
    words[wordOffset + 1] = Value(a64.A64EncAddImm(true, a64.A64X0, a64.A64X1, 0))
    words[wordOffset + 2] = a64.A64EncBr(a64.A64X16)
    return true

fn PrimaryFillCallIndirectI32BridgeWords(words: var int32[],
                                          wordOffset: int32): bool =
    if wordOffset < 0 || wordOffset + 4 >= words.len:
        return false
    # form44 案卷根修: 同 PrimaryFillCallIndirectVoidBridgeWords 的 BLR+RET
    # 自锁死循环, 尾调用改 BR。
    words[wordOffset] = Value(a64.A64EncAddImm(true, a64.A64X16, a64.A64X0, 0))
    words[wordOffset + 1] = Value(a64.A64EncAddImm(true, a64.A64X0, a64.A64X1, 0))
    words[wordOffset + 2] = Value(a64.A64EncAddImm(false, a64.A64X1, a64.A64X2, 0))
    words[wordOffset + 3] = Value(a64.A64EncAddImm(false, a64.A64X2, a64.A64X3, 0))
    words[wordOffset + 4] = a64.A64EncBr(a64.A64X16)
    return true

fn PrimaryFillCallIndirectSretAgg1BridgeWords(words: var int32[],
                                               wordOffset: int32): bool =
    if wordOffset < 0 || wordOffset + 2 >= words.len:
        return false
    # form44 案卷根修: 同上——BLR+RET 二段式跳板对 __cheng_call_indirect_sret_agg1
    # 是自锁死循环(X8 sret 指针本身未被这两条 ADD/BR 触碰, 全程正确直通被调方,
    # 问题只在 LR/尾返回路径)。改尾调用 BR, sret 语义不变。
    words[wordOffset] = Value(a64.A64EncAddImm(true, a64.A64X16, a64.A64X0, 0))
    words[wordOffset + 1] = Value(a64.A64EncAddImm(true, a64.A64X0, a64.A64X1, 0))
    words[wordOffset + 2] = a64.A64EncBr(a64.A64X16)
    return true

