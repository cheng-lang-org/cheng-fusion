        words[pos + 2] = a64.A64EncSha256H(0, 1, 24)
        words[pos + 3] = a64.A64EncSha256H2(1, 25, 24)
        pos = pos + 4
        words[pos] = a64.A64EncSha256Su0(18, 19)
        words[pos + 1] = a64.A64EncSha256Su1(18, 16, 17)
        pos = pos + 2
        words[pos] = a64.A64EncLdrQ(26, a64.A64X2, 176)
        pos = pos + 1
        words[pos] = a64.A64EncMovV16b(25, 0)
        words[pos + 1] = a64.A64EncAddV4s(24, 19, 26)
        words[pos + 2] = a64.A64EncSha256H(0, 1, 24)
        words[pos + 3] = a64.A64EncSha256H2(1, 25, 24)
        pos = pos + 4
        words[pos] = a64.A64EncSha256Su0(19, 16)
        words[pos + 1] = a64.A64EncSha256Su1(19, 17, 18)
        pos = pos + 2
        words[pos] = a64.A64EncLdrQ(26, a64.A64X2, 192)
        pos = pos + 1
        words[pos] = a64.A64EncMovV16b(25, 0)
        words[pos + 1] = a64.A64EncAddV4s(24, 16, 26)
        words[pos + 2] = a64.A64EncSha256H(0, 1, 24)
        words[pos + 3] = a64.A64EncSha256H2(1, 25, 24)
        pos = pos + 4
        words[pos] = a64.A64EncLdrQ(26, a64.A64X2, 208)
        pos = pos + 1
        words[pos] = a64.A64EncMovV16b(25, 0)
        words[pos + 1] = a64.A64EncAddV4s(24, 17, 26)
        words[pos + 2] = a64.A64EncSha256H(0, 1, 24)
        words[pos + 3] = a64.A64EncSha256H2(1, 25, 24)
        pos = pos + 4
        words[pos] = a64.A64EncLdrQ(26, a64.A64X2, 224)
        pos = pos + 1
        words[pos] = a64.A64EncMovV16b(25, 0)
        words[pos + 1] = a64.A64EncAddV4s(24, 18, 26)
        words[pos + 2] = a64.A64EncSha256H(0, 1, 24)
        words[pos + 3] = a64.A64EncSha256H2(1, 25, 24)
        pos = pos + 4
        words[pos] = a64.A64EncLdrQ(26, a64.A64X2, 240)
        pos = pos + 1
        words[pos] = a64.A64EncMovV16b(25, 0)
        words[pos + 1] = a64.A64EncAddV4s(24, 19, 26)
        words[pos + 2] = a64.A64EncSha256H(0, 1, 24)
        words[pos + 3] = a64.A64EncSha256H2(1, 25, 24)
        pos = pos + 4
        words[pos] = a64.A64EncAddV4s(0, 0, 6)
        words[pos + 1] = a64.A64EncAddV4s(1, 1, 7)
        words[pos + 2] = Value(a64.A64EncAddImm(true, 1, 1, 64))
        pos = pos + 3
        words[pos] = a64.A64EncStrQ(0, a64.A64X0, 0)
        words[pos + 1] = a64.A64EncStrQ(1, a64.A64X0, 16)
        pos = pos + 2
    return pos

# Emit inline ARMv8 SHA-256 single-block compress. X0=state ptr (32B, in/out), X1=block ptr (64B),
# X2=k256 ptr (256B). Mirrors sha256_hw_v3.s instruction-for-instruction (register-for-register,
# no invented scheduling): 12-word prologue (load state+block, rev32 message words, save a0/b0) +
# 4x5-word initial round groups (rounds 0..15, K offsets 0/16/32/48) + 1-word x9 = k256+64 init +
# 12x13-word unrolled message-schedule round groups (rounds 16..63, x9 walks K[16..63]) + 4-word
# epilogue (feed-forward add + store state). EXACTLY 193 words (must match
# PrimaryInlineSha256BlockInstructionWordCount).
fn PrimaryBodyIRFillInlineSha256Block(words: var int32[],
                                        offset: int32,
                                        inlineKind: int32): int32 =
    if inlineKind == 2:
        return PrimaryBodyIRFillInlineSha256Serial64Block(words, offset, inlineKind)
    if inlineKind == 3:
        return PrimaryBodyIRFillInlineSha256x3Block(words, offset, inlineKind)
    if inlineKind != 1:
        return -1
    if offset + 192 >= words.len:
        return -1
    var pos = offset
    words[pos] = a64.A64EncLdrQ(0, a64.A64X0, 0)
    words[pos + 1] = a64.A64EncLdrQ(1, a64.A64X0, 16)
    words[pos + 2] = a64.A64EncLdrQ(4, a64.A64X1, 0)
    words[pos + 3] = a64.A64EncLdrQ(5, a64.A64X1, 16)
    words[pos + 4] = a64.A64EncLdrQ(6, a64.A64X1, 32)
    words[pos + 5] = a64.A64EncLdrQ(7, a64.A64X1, 48)
    words[pos + 6] = a64.A64EncRev32V16b(4, 4)
    words[pos + 7] = a64.A64EncRev32V16b(5, 5)
    words[pos + 8] = a64.A64EncRev32V16b(6, 6)
    words[pos + 9] = a64.A64EncRev32V16b(7, 7)
    words[pos + 10] = a64.A64EncMovV16b(2, 0)
    words[pos + 11] = a64.A64EncMovV16b(3, 1)
    pos = pos + 12
    for g in 0..<4:
        let msgReg = 4 + g
        let koff = g * 16
        words[pos] = a64.A64EncLdrQ(16, a64.A64X2, koff)
        words[pos + 1] = a64.A64EncAddV4s(20, msgReg, 16)
        words[pos + 2] = a64.A64EncMovV16b(18, 0)
        words[pos + 3] = a64.A64EncSha256H(0, 1, 20)
        words[pos + 4] = a64.A64EncSha256H2(1, 18, 20)
        pos = pos + 5
    words[pos] = Value(a64.A64EncAddImm(true, a64.A64X9, a64.A64X2, 64))
    pos = pos + 1
    for i in 0..<12:
        words[pos] = a64.A64EncSha256Su0(4, 5)
        words[pos + 1] = a64.A64EncSha256Su1(4, 6, 7)
        words[pos + 2] = a64.A64EncLdrQ(16, a64.A64X9, 0)
        words[pos + 3] = Value(a64.A64EncAddImm(true, a64.A64X9, a64.A64X9, 16))
        words[pos + 4] = a64.A64EncAddV4s(20, 4, 16)
        words[pos + 5] = a64.A64EncMovV16b(18, 0)
        words[pos + 6] = a64.A64EncSha256H(0, 1, 20)
        words[pos + 7] = a64.A64EncSha256H2(1, 18, 20)
        words[pos + 8] = a64.A64EncMovV16b(21, 4)
        words[pos + 9] = a64.A64EncMovV16b(4, 5)
        words[pos + 10] = a64.A64EncMovV16b(5, 6)
        words[pos + 11] = a64.A64EncMovV16b(6, 7)
        words[pos + 12] = a64.A64EncMovV16b(7, 21)
        pos = pos + 13
    words[pos] = a64.A64EncAddV4s(0, 0, 2)
    words[pos + 1] = a64.A64EncAddV4s(1, 1, 3)
    words[pos + 2] = a64.A64EncStrQ(0, a64.A64X0, 0)
    words[pos + 3] = a64.A64EncStrQ(1, a64.A64X0, 16)
    pos = pos + 4
    return pos

fn PrimaryBodyIRFillStackAdjustExact(words: var int32[],
                                      offset: int32,
                                      byteCount: int32,
                                      subtract: bool): int32 =
    if byteCount < 0:
        panic("primary object: negative call stack adjustment")
    var pos = offset
    var remain = byteCount
    while remain > 0:
        if pos < 0 || pos >= words.len:
            return -1
        var chunk = remain
        if chunk > 4095:
            chunk = 4095
        if subtract:
            words[pos] = Value(a64.A64EncSubImm(true,
                                                a64.A64SP,
                                                a64.A64SP,
                                                chunk))
        else:
            words[pos] = Value(a64.A64EncAddImm(true,
                                                a64.A64SP,
                                                a64.A64SP,
                                                chunk))
        pos = pos + 1
        remain = remain - chunk
    return pos

fn PrimaryBodyIRFillCopyMemory(words: var int32[],
                                offset: int32,
                                sourceReg: int32,
                                sourceOffset: int32,
                                targetReg: int32,
                                targetOffset: int32,
                                byteCount: int32): int32 =
    var primaryColdCond22: bool
    if byteCount <= 0:
        primaryColdCond22 = true
    if sourceOffset < 0:
        primaryColdCond22 = true
    if targetOffset < 0:
        primaryColdCond22 = true
    if primaryColdCond22:
        return -1
    if sourceOffset + byteCount - 1 <= 4095 &&
       targetOffset + byteCount - 1 <= 4095:
        var pos = offset
        for copyIndex in 0..<byteCount:
            if pos + 1 >= words.len:
                return -1
            words[pos] = Value(a64.A64EncLdrbImm(a64.A64X11,
                                                 sourceReg,
                                                 sourceOffset + copyIndex))
            words[pos + 1] = Value(a64.A64EncStrbImm(a64.A64X11,
                                                     targetReg,
                                                     targetOffset + copyIndex))
            pos = pos + 2
        return pos
    # Slow path: byteCount alone exceeds the LDRB/STRB imm12 window (0..4095)
    # even at offset 0 — e.g. a large aggregate Result[T] value projection
    # (value_slot_size well past 4096 bytes). Every caller of this function
    # already materializes both sides to offset 0 in a non-SP register
    # whenever PrimaryBodyIrCopySideNeedsAddressReg fires, and that guard
    # always fires once byteCount alone exceeds its 4000-byte threshold —
    # so this branch is only ever reached with sourceOffset==0,
    # targetOffset==0, and non-SP base registers. Copy in fixed 4095-byte
    # windows, re-folding both bases forward by exactly one window (a single
    # ADD immediate each — 4095 fits the imm12 range) between windows so
    # every LDRB/STRB stays inside its own imm12 window regardless of total
    # byteCount. If that invariant is ever violated, fail loudly instead of
    # corrupting SP or silently truncating the copy.
    if sourceOffset != 0 || targetOffset != 0 ||
       sourceReg == a64.A64SP || targetReg == a64.A64SP:
        return -1
    var pos = offset
    var remaining = byteCount
    while remaining > 0:
        var chunk = remaining
        if chunk > 4095:
            chunk = 4095
        for copyIndex in 0..<chunk:
            if pos + 1 >= words.len:
                return -1
            words[pos] = Value(a64.A64EncLdrbImm(a64.A64X11, sourceReg, copyIndex))
            words[pos + 1] = Value(a64.A64EncStrbImm(a64.A64X11, targetReg, copyIndex))
            pos = pos + 2
        remaining = remaining - chunk
        if remaining > 0:
            pos = PrimaryBodyIRFillRegAddImmToReg(words, pos, sourceReg, sourceReg, chunk)
            if pos < 0:
                return -1
            pos = PrimaryBodyIRFillRegAddImmToReg(words, pos, targetReg, targetReg, chunk)
            if pos < 0:
                return -1
    return pos

fn PrimaryBodyIRFillGlobalDataAddress(words: var int32[],
                                        offset: int32,
                                        reg: int32): int32 =
    if offset < 0 || offset + 1 >= words.len:
        return -1
    words[offset] = a64.A64EncAdrp(reg)
    words[offset + 1] = Value(a64.A64EncAddImm(true, reg, reg, 0))
    return offset + 2

fn PrimaryBodyIRFillSpAdd(words: var int32[], offset: int32, frameBytesRaw: int32): int32 =
    var pos = offset
    var frameBytes = frameBytesRaw
    while frameBytes > 4095:
        if pos < 0 || pos >= words.len:
            return -1
        words[pos] = Value(a64.A64EncAddImm(true, a64.A64SP, a64.A64SP, 4095))
        pos = pos + 1
        frameBytes = frameBytes - 4095
    if frameBytes > 0:
        if pos < 0 || pos >= words.len:
            return -1
        words[pos] = Value(a64.A64EncAddImm(true, a64.A64SP, a64.A64SP, frameBytes))
        pos = pos + 1
    return pos

@borrows
fn PrimaryBodyIRFillFrameRestore(words: var int32[], offset: int32, frameBytes: int32, bodyIR: coreir.BodyIR): int32 =
    if offset < 0 || offset >= words.len:
        return -1
    var pos = offset
    words[pos] = Value(a64.A64EncLdp64(a64.A64FP, a64.A64LR, a64.A64SP, int64(0)))
    pos = PrimaryBodyIRFillSpAdd(words, pos + 1, frameBytes)
    if pos < 0 || pos >= words.len:
        return -1
    words[pos] = a64.A64EncRet()
    return pos + 1

fn PrimaryBodyCondA64TrueCode(condTag: int32): int32 =
    if condTag == coreir.BodyCondI32EqTag ||
       condTag == coreir.BodyCondI64EqTag:
        return 0
    if condTag == coreir.BodyCondI32NeTag ||
       condTag == coreir.BodyCondI64NeTag:
        return 1
    if condTag == coreir.BodyCondI32LtTag ||
       condTag == coreir.BodyCondI64LtTag:
        return 11
    if condTag == coreir.BodyCondI32LeTag ||
       condTag == coreir.BodyCondI64LeTag:
        return 13
    if condTag == coreir.BodyCondI32GtTag ||
       condTag == coreir.BodyCondI64GtTag:
        return 12
    if condTag == coreir.BodyCondI32GeTag ||
       condTag == coreir.BodyCondI64GeTag:
        return 10
    # Unsigned ordering: lo/ls/hi/hs (a64 codes 3/9/8/2) instead of lt/le/gt/ge.
    if condTag == coreir.BodyCondU32LtTag ||
       condTag == coreir.BodyCondU64LtTag:
        return a64.A64CondLO
    if condTag == coreir.BodyCondU32LeTag ||
       condTag == coreir.BodyCondU64LeTag:
        return a64.A64CondLS
    if condTag == coreir.BodyCondU32GtTag ||
       condTag == coreir.BodyCondU64GtTag:
        return a64.A64CondHI
    if condTag == coreir.BodyCondU32GeTag ||
       condTag == coreir.BodyCondU64GeTag:
        return a64.A64CondHS
    if condTag == coreir.BodyCondF64EqTag:
        return a64.A64CondEQ
    if condTag == coreir.BodyCondF64NeTag:
        return a64.A64CondNE
    if condTag == coreir.BodyCondF64LtTag:
        return a64.A64CondMI
    if condTag == coreir.BodyCondF64LeTag:
        return a64.A64CondLS
    if condTag == coreir.BodyCondF64GtTag:
        return a64.A64CondGT
    if condTag == coreir.BodyCondF64GeTag:
        return a64.A64CondGE
    if condTag == coreir.BodyCondLocalNonZeroTag:
        return 1
    if condTag == coreir.BodyCondLocalZeroTag:
        return 0
    return 1

fn PrimaryBodyIREmitPrologueWord(index: int32): int32 =
    if index == 0:
        return Value(a64.A64EncSubImm(true, a64.A64SP, a64.A64SP, 32))
    if index == 1:
        return Value(a64.A64EncStp64(a64.A64FP, a64.A64LR, a64.A64SP, int64(0)))
    if index == 2:
        return Value(a64.A64EncAddImm(true, a64.A64FP, a64.A64SP, 0))
    return 0

@borrows
fn PrimaryBodyIREmitTermWord(term: coreir.BodyTerm, relOffset: int32): int32 =
    if term.kind == coreir.BodyTermCbrTag:
        if relOffset == 0:
            return a64.A64EncMovz(false, 0, 0, 0)
        return 0
    if term.kind == coreir.BodyTermBrTag:
        if relOffset == 0:
            return a64.A64EncBPlaceholder()
        return 0
    return a64.A64EncRet()
