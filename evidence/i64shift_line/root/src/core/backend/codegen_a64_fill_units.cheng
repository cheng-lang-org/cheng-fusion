# codegen_a64_fill_units.cheng —— B6 搬出簇 A 承接单元（aarch64 归属）
#
# 形态裁定（kernel-split-blueprint-20260824/BLUEPRINT.md 通道② + B6 批表；
# kernel-b6-20260825/B6_REPORT.md）：
#   - 蓝图 B6 的 arm64 Fill 家族物理迁出按「迁移闭包」执行：仅迁入对
#     primary_object_plan 内核符号（布局 helper 族/backpatch 状态机/trace
#     门）零依赖的子簇（调用闭包封闭：34 函数，含 B6a 运行时桥簇
#     :56559-:56797 全体、B6b 纯 Fill 簇、B6d FillSpAdd/FillFrameRestore/
#     CondA64TrueCode/EmitPrologueWord/EmitTermWord）；其余 Fill 主族
#     （FillBlockOp/FillCallOp/CopySlot 等 29 函数）因反向依赖内核共享
#     helper+backpatch 状态（闭包实测 165 函数含 StartsWith 等中立符号，
#     物理迁出不可行）留内核，经 codegen_a64_body_units 门面消费编码器
#     原语（B4 同型）。函数体逐字迁移零改写。
#   - 本文件 import aarch64_encode 在 aarch64 单元内合法（closure 只查
#     kernel→arch）；内核经 shared-format 门面（codegen_a64_body_units）
#     访问本单元槽位。
#   - PrimaryFill*Words 运行时桥簇与 PrimaryA64{BranchImm26,BranchImm19,
#     BWord,CbnzW0Word}、PrimaryBodyIrLocalReg 在现树零调用方（grep 全仓
#     实证），随簇整体迁入保持原样（不删已有代码）。
#
# 归属：aarch64（B6 ②搬出通道；蓝图 B6a/B6b/B6d 指定形态）。
import std/result
import cheng/core/ir/core_types as coreir
import cheng/core/backend/aarch64_encode as a64

@borrows
fn PrimaryBodyIRFillInlineF64Trunc(words: var int32[],
                                    offset: int32,
                                    inlineKind: int32): int32 =
    if inlineKind != 1 && inlineKind != 2:
        return -1
    if offset >= words.len:
        return -1
    if inlineKind == 1:
        words[offset] = a64.A64EncFcvtzsWd(a64.A64X0, 0)
    else:
        words[offset] = a64.A64EncFcvtzsXd(a64.A64X0, 0)
    return offset + 1

@borrows
fn PrimaryBodyIRFillInlineF64FromInt(words: var int32[],
                                      offset: int32,
                                      inlineKind: int32,
                                      unsignedSrc: bool): int32 =
    if inlineKind != 1 && inlineKind != 2:
        return -1
    if offset + 1 >= words.len:
        return -1
    if inlineKind == 1:
        if unsignedSrc:
            words[offset] = a64.A64EncUcvtfDw(0, a64.A64X0)
        else:
            words[offset] = a64.A64EncScvtfDw(0, a64.A64X0)
    else:
        if unsignedSrc:
            words[offset] = a64.A64EncUcvtfDx(0, a64.A64X0)
        else:
            words[offset] = a64.A64EncScvtfDx(0, a64.A64X0)
    words[offset + 1] = a64.A64EncFmovXd(a64.A64X0, 0)
    return offset + 2

@borrows
fn PrimaryBodyIrLocalReg(slotId: int32): int32 =
    var reg = a64.A64X9 + slotId
    if reg > 28:
        reg = a64.A64X9
    return reg

fn PrimaryA64BranchImm26(fromWord: int32, toWord: int32): int32 =
    return (toWord - fromWord) & 67108863

fn PrimaryA64BranchImm19(fromWord: int32, toWord: int32): int32 =
    return (toWord - fromWord) & 524287

fn PrimaryA64BWord(fromWord: int32, toWord: int32): int32 =
    return a64.A64EncBPlaceholder() + PrimaryA64BranchImm26(fromWord, toWord)

fn PrimaryA64CbnzW0Word(fromWord: int32, toWord: int32): int32 =
    return 889192448 + PrimaryA64BranchImm19(fromWord, toWord) * 32

fn PrimaryFillReturnF64MulWords(words: var int32[],
                                wordOffset: int32): bool =
    if wordOffset < 0 || wordOffset + 1 >= words.len:
        return false
    words[wordOffset] = a64.A64EncFmulD(a64.A64X0, a64.A64X0, a64.A64X1)
    words[wordOffset + 1] = a64.A64EncRet()
    return true

fn PrimaryFillReturnF64FromI32Arg0Words(words: var int32[],
                                        wordOffset: int32): bool =
    if wordOffset < 0 || wordOffset + 1 >= words.len:
        return false
    words[wordOffset] = a64.A64EncScvtfDw(a64.A64X0, a64.A64X0)
    words[wordOffset + 1] = a64.A64EncRet()
    return true

fn PrimaryFillReturnF64FromI64Arg0Words(words: var int32[],
                                        wordOffset: int32): bool =
    if wordOffset < 0 || wordOffset + 1 >= words.len:
        return false
    words[wordOffset] = a64.A64EncScvtfDx(a64.A64X0, a64.A64X0)
    words[wordOffset + 1] = a64.A64EncRet()
    return true

fn PrimaryFillEntryBridgeWords(words: var int32[],
                               wordOffset: int32): bool =
    if wordOffset < 0 || wordOffset + 16 >= words.len:
        return false
    words[wordOffset] = Value(a64.A64EncSubImm(true, a64.A64SP, a64.A64SP, 32))
    words[wordOffset + 1] = Value(a64.A64EncStp64(a64.A64X0, a64.A64X1, a64.A64SP, int64(0)))
    words[wordOffset + 2] = -117436418
    words[wordOffset + 3] = a64.A64EncBlPlaceholder()
    words[wordOffset + 4] = -113244191
    words[wordOffset + 5] = -113246176
    words[wordOffset + 6] = a64.A64EncBlPlaceholder()
    words[wordOffset + 7] = -1455421472
    words[wordOffset + 8] = a64.A64EncBlPlaceholder()
    words[wordOffset + 9] = -1191177248
    words[wordOffset + 10] = -113244191
    words[wordOffset + 11] = -113246176
    words[wordOffset + 12] = a64.A64EncBlPlaceholder()
    words[wordOffset + 13] = -1186982944
    words[wordOffset + 14] = -113242114
    words[wordOffset + 15] = Value(a64.A64EncAddImm(true, a64.A64SP, a64.A64SP, 32))
    words[wordOffset + 16] = a64.A64EncRet()
    return true

