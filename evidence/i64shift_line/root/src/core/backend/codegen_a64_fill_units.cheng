                                           wordOffset: int32): bool =
    if wordOffset < 0 || wordOffset + 17 >= words.len:
        return false
    words[wordOffset] = -1447199747
    words[wordOffset + 1] = -1862269955
    words[wordOffset + 2] = a64.A64EncBlPlaceholder()
    words[wordOffset + 3] = 1895825439
    words[wordOffset + 4] = 1409286284
    words[wordOffset + 5] = a64.A64EncBlPlaceholder()
    words[wordOffset + 6] = -1463583747
    words[wordOffset + 7] = a64.A64EncRet()
    words[wordOffset + 8] = -1862253592
    words[wordOffset + 9] = -117440225
    words[wordOffset + 10] = -117439201
    words[wordOffset + 11] = -1191177953
    words[wordOffset + 12] = 1384120352
    words[wordOffset + 13] = a64.A64EncBlPlaceholder()
    words[wordOffset + 14] = -1862253600
    words[wordOffset + 15] = a64.A64EncBlPlaceholder()
    words[wordOffset + 16] = -1463583747
    words[wordOffset + 17] = a64.A64EncRet()
    return true

fn PrimaryFillReturnStrEmptyWords(words: var int32[],
                                   wordOffset: int32): bool =
    if wordOffset < 0 || wordOffset + 3 >= words.len:
        return false
    words[wordOffset] = -117440225
    words[wordOffset + 1] = -117439201
    words[wordOffset + 2] = -1191177953
    words[wordOffset + 3] = a64.A64EncRet()
    return true

fn PrimaryFillStrLenFastWords(words: var int32[],
                              wordOffset: int32): bool =
    if wordOffset < 0 || wordOffset + 7 >= words.len:
        return false
    words[wordOffset] = Value(a64.A64EncLdrImm(true, a64.A64X9, a64.A64X0, int64(0)))
    words[wordOffset + 1] = Value(a64.A64EncCbz(true, a64.A64X9, int64(5)))
    words[wordOffset + 2] = Value(a64.A64EncLdrswImm(a64.A64X10, a64.A64X0, int64(8)))
    words[wordOffset + 3] = Value(a64.A64EncCmpImm(false, a64.A64X10, 0))
    words[wordOffset + 4] = Value(a64.A64EncCsel(false, a64.A64X0, a64.A64ZR, a64.A64X10, a64.A64CondLE))
    words[wordOffset + 5] = a64.A64EncRet()
    words[wordOffset + 6] = a64.A64EncMovz(false, a64.A64X0, 0, 0)
    words[wordOffset + 7] = a64.A64EncRet()
    return true

fn PrimaryBodyIRFillStackAddressToReg(words: var int32[],
                                       offset: int32,
                                       reg: int32,
                                       stackOffsetRaw: int32): int32 =
    if offset < 0 || offset >= words.len || stackOffsetRaw < 0:
        return -1
    var pos = offset
    var remain = stackOffsetRaw
    if remain > 4095:
        words[pos] = Value(a64.A64EncAddImm(true, reg, a64.A64SP, 4095))
        pos = pos + 1
        remain = remain - 4095
        while remain > 4095:
            if pos >= words.len:
                return -1
            words[pos] = Value(a64.A64EncAddImm(true, reg, reg, 4095))
            pos = pos + 1
            remain = remain - 4095
        if pos >= words.len:
            return -1
        words[pos] = Value(a64.A64EncAddImm(true, reg, reg, remain))
        return pos + 1
    words[pos] = Value(a64.A64EncAddImm(true, reg, a64.A64SP, remain))
    return pos + 1

# Generalizes PrimaryBodyIRFillStackAddressToReg to an arbitrary base register
# (Ptr/aggregate-param/str field-base addresses live in a general register,
# not SP): folds a constant byte offset into `reg` via chunked ADD immediate
# (4095 per instruction) so a subsequent field access can run at offset 0
# regardless of how large the original offset was. The chunking math is
# identical to the SP case, so PrimaryBodyIrStackAddressWordCount(offsetBytes)
# is also this function's exact word count — no separate size-pass twin needed.
fn PrimaryBodyIRFillRegAddImmToReg(words: var int32[],
                                    offset: int32,
                                    reg: int32,
                                    baseReg: int32,
                                    offsetBytes: int32): int32 =
    if offset < 0 || offset >= words.len || offsetBytes < 0:
        return -1
    var pos = offset
    var remain = offsetBytes
    if remain > 4095:
        words[pos] = Value(a64.A64EncAddImm(true, reg, baseReg, 4095))
        pos = pos + 1
        remain = remain - 4095
        while remain > 4095:
            if pos >= words.len:
                return -1
            words[pos] = Value(a64.A64EncAddImm(true, reg, reg, 4095))
            pos = pos + 1
            remain = remain - 4095
        if pos >= words.len:
            return -1
        words[pos] = Value(a64.A64EncAddImm(true, reg, reg, remain))
        return pos + 1
    words[pos] = Value(a64.A64EncAddImm(true, reg, baseReg, remain))
    return pos + 1

fn PrimaryBodyIRFillInlineAtomicFetchAdd(words: var int32[],
                                          offset: int32,
                                          inlineKind: int32): int32 =
    if inlineKind == 1:
        if offset >= words.len:
            return -1
        words[offset] = a64.A64EncLdaddalW(a64.A64X1, a64.A64X0, a64.A64X0)
        return offset + 1
    if inlineKind == 2:
        if offset + 3 >= words.len:
            return -1
        words[offset] = Value(a64.A64EncCbz(true, a64.A64X0, int64(3)))
        words[offset + 1] = a64.A64EncLdaddalW(a64.A64X1, a64.A64X0, a64.A64X0)
        words[offset + 2] = Value(a64.A64EncBImm(int64(2)))
        words[offset + 3] = a64.A64EncMovz(false, a64.A64X0, 0, 0)
        return offset + 4
    return -1

fn PrimaryBodyIRFillInlinePtrSlot(words: var int32[],
                                   offset: int32,
                                   inlineKind: int32): int32 =
    if inlineKind != 1 && inlineKind != 2:
        return -1
    if offset + 3 >= words.len:
        return -1
    words[offset] = a64.A64EncMovz(false, a64.A64X10, 3, 0)
    words[offset + 1] = a64.A64EncLslv(true, a64.A64X10, a64.A64X1, a64.A64X10)
    words[offset + 2] = a64.A64EncAddReg(true, a64.A64X9, a64.A64X0, a64.A64X10)
    if inlineKind == 1:
        words[offset + 3] = Value(a64.A64EncLdrImm(true, a64.A64X0, a64.A64X9, int64(0)))
    else:
        words[offset + 3] = Value(a64.A64EncStrImm(true, a64.A64X2, a64.A64X9, int64(0)))
    return offset + 4

# Emit inline ARMv8 AES-128 block encrypt. X0=state ptr (16B, in/out), X1=roundKeys ptr (176B standard
# schedule rk[0..10]). State pinned in V0, V1=per-round key. 10x AESE rk[0..9] + 9x AESMC + final EOR rk[10].
# EXACTLY 33 words (must match PrimaryInlineAesBlockInstructionWordCount).
fn PrimaryBodyIRFillInlineAesBlock(words: var int32[],
                                    offset: int32,
                                    inlineKind: int32): int32 =
    if inlineKind == 2:
        return PrimaryBodyIRFillInlineAes4xBlock(words, offset, inlineKind)
    if inlineKind != 1:
        return -1
    if offset + 32 >= words.len:
        return -1
    var pos = offset
    words[pos] = a64.A64EncLdrQ(0, a64.A64X0, 0)
    pos = pos + 1
    for i in 0..<9:
        words[pos] = a64.A64EncLdrQ(1, a64.A64X1, i * 16)
        words[pos + 1] = a64.A64EncAese(0, 1)
        words[pos + 2] = a64.A64EncAesmc(0, 0)
        pos = pos + 3
    words[pos] = a64.A64EncLdrQ(1, a64.A64X1, 144)
    words[pos + 1] = a64.A64EncAese(0, 1)
    pos = pos + 2
    words[pos] = a64.A64EncLdrQ(1, a64.A64X1, 160)
    words[pos + 1] = a64.A64EncEorV16b(0, 0, 1)
    pos = pos + 2
    words[pos] = a64.A64EncStrQ(0, a64.A64X0, 0)
    pos = pos + 1
    return pos

# Emit inline ARMv8 AES-128 4-block interleaved encrypt (kind 2). X0..X3 = four 16B state
# buffers (in/out, e.g. four CTR counter blocks), X4 = roundKeys ptr (176B schedule).
# States pinned in V0..V3, V4 = per-round key. Interleave (4x AESE + 4x AESMC per round)
# keeps the AESE pipe fed: sequence measured on Apple M4 Pro at ~14.8GB/s bulk vs
# CommonCrypto CCCrypt AES-128 at ~13.1GB/s (4-block KAT verified byte-for-byte vs CCCrypt).
# XOR-inside AESE semantics: rounds use rk[0..9] (no pre-whitening EOR), round 10 has no
# AESMC, final EOR rk[10]. EXACTLY 99 words (must match PrimaryInlineAesBlockInstructionWordCount).
fn PrimaryBodyIRFillInlineAes4xBlock(words: var int32[],
                                     offset: int32,
                                     inlineKind: int32): int32 =
    if inlineKind != 2:
        return -1
    if offset + 98 >= words.len:
        return -1
    var pos = offset
    words[pos] = a64.A64EncLdrQ(0, a64.A64X0, 0)
    words[pos + 1] = a64.A64EncLdrQ(1, a64.A64X1, 0)
    words[pos + 2] = a64.A64EncLdrQ(2, a64.A64X2, 0)
    words[pos + 3] = a64.A64EncLdrQ(3, a64.A64X3, 0)
    pos = pos + 4
    for i in 0..<9:
        words[pos] = a64.A64EncLdrQ(4, a64.A64X4, i * 16)
        pos = pos + 1
        words[pos] = a64.A64EncAese(0, 4)
        words[pos + 1] = a64.A64EncAesmc(0, 0)
        words[pos + 2] = a64.A64EncAese(1, 4)
        words[pos + 3] = a64.A64EncAesmc(1, 1)
        words[pos + 4] = a64.A64EncAese(2, 4)
        words[pos + 5] = a64.A64EncAesmc(2, 2)
        words[pos + 6] = a64.A64EncAese(3, 4)
        words[pos + 7] = a64.A64EncAesmc(3, 3)
        pos = pos + 8
    words[pos] = a64.A64EncLdrQ(4, a64.A64X4, 144)
    words[pos + 1] = a64.A64EncAese(0, 4)
    words[pos + 2] = a64.A64EncAese(1, 4)
    words[pos + 3] = a64.A64EncAese(2, 4)
    words[pos + 4] = a64.A64EncAese(3, 4)
    pos = pos + 5
    words[pos] = a64.A64EncLdrQ(4, a64.A64X4, 160)
    words[pos + 1] = a64.A64EncEorV16b(0, 0, 4)
    words[pos + 2] = a64.A64EncEorV16b(1, 1, 4)
    words[pos + 3] = a64.A64EncEorV16b(2, 2, 4)
    words[pos + 4] = a64.A64EncEorV16b(3, 3, 4)
    pos = pos + 5
    words[pos] = a64.A64EncStrQ(0, a64.A64X0, 0)
    words[pos + 1] = a64.A64EncStrQ(1, a64.A64X1, 0)
    words[pos + 2] = a64.A64EncStrQ(2, a64.A64X2, 0)
    words[pos + 3] = a64.A64EncStrQ(3, a64.A64X3, 0)
