@borrows
fn TargetIsDarwinA64(targetTriple: str): bool =
    if targetTriple == "arm64-apple-darwin":
        return true
    if targetTriple == "aarch64-apple-ios":
        return true
    if targetTriple == "arm64-apple-ios":
        return true
    return false

@borrows
fn TargetIsDarwin(targetTriple: str): bool =
    if targetTriple == "arm64-apple-darwin":
        return true
    if targetTriple == "x86_64-apple-darwin":
        return true
    if targetTriple == "aarch64-apple-ios":
        return true
    if targetTriple == "arm64-apple-ios":
        return true
    return false

@borrows
fn TargetIsWasm(targetTriple: str): bool =
    return targetTriple == "wasm32-unknown-unknown"

@borrows
fn TargetIsLinuxX64(targetTriple: str): bool =
    return targetTriple == "x86_64-unknown-linux-gnu"

@borrows
fn TargetIsLinuxA64(targetTriple: str): bool =
    if targetTriple == "aarch64-unknown-linux-gnu":
        return true
    if targetTriple == "arm64-unknown-linux-gnu":
        return true
    return false

@borrows
fn TargetIsAndroidA64(targetTriple: str): bool =
    return targetTriple == "aarch64-linux-android"

@borrows
fn TargetIsOhosA64(targetTriple: str): bool =
    if targetTriple == "aarch64-linux-ohos":
        return true
    if targetTriple == "aarch64-unknown-linux-ohos":
        return true
    return false

@borrows
fn TargetIsLinuxRv64(targetTriple: str): bool =
    return targetTriple == "riscv64-unknown-linux-gnu"

@borrows
fn TargetIsRv64Bare(targetTriple: str): bool =
    return targetTriple == "riscv64-unknown-none-elf"

@borrows
fn TargetIsEsp32S31(targetTriple: str): bool =
    if targetTriple == "riscv32-esp32s31-none-elf":
        return true
    if targetTriple == "esp32s31":
        return true
    return false

@borrows
fn TargetIsLinuxRv32(targetTriple: str): bool =
    return targetTriple == "riscv32-unknown-linux-gnu"

@borrows
fn TargetIsRv32Bare(targetTriple: str): bool =
    return targetTriple == "riscv32-unknown-none-elf"

@borrows
fn TargetIsRv32(targetTriple: str): bool =
    if TargetIsLinuxRv32(targetTriple):
        return true
    if TargetIsRv32Bare(targetTriple):
        return true
    if TargetIsEsp32S31(targetTriple):
        return true
    return false

@borrows
fn TargetIsRiscvCodegen(targetTriple: str): bool =
    if TargetIsLinuxRv64(targetTriple):
        return true
    if TargetIsRv64Bare(targetTriple):
        return true
    if TargetIsRv32(targetTriple):
        return true
    return false

@borrows
fn TargetIsWindowsA64(targetTriple: str): bool =
    if targetTriple == "aarch64-pc-windows-msvc":
        return true
    if targetTriple == "arm64-pc-windows-msvc":
        return true
    return false

@borrows
fn TargetIsWindowsX64(targetTriple: str): bool =
    return targetTriple == "x86_64-pc-windows-msvc"

@borrows
fn TargetIsWindows(targetTriple: str): bool =
    if targetTriple == "aarch64-pc-windows-msvc":
        return true
    if targetTriple == "arm64-pc-windows-msvc":
        return true
    if targetTriple == "x86_64-pc-windows-msvc":
        return true
    return false

@borrows
fn TargetIsElfObject(targetTriple: str): bool =
    if targetTriple == "aarch64-unknown-linux-gnu":
        return true
    if targetTriple == "arm64-unknown-linux-gnu":
        return true
    if targetTriple == "aarch64-linux-android":
        return true
    if targetTriple == "aarch64-linux-ohos":
        return true
    if targetTriple == "aarch64-unknown-linux-ohos":
        return true
    if targetTriple == "x86_64-unknown-linux-gnu":
        return true
    if targetTriple == "riscv64-unknown-linux-gnu":
        return true
    if targetTriple == "riscv64-unknown-none-elf":
        return true
    if TargetIsRv32(targetTriple):
        return true
    return false

@borrows
fn TargetIsCoffObject(targetTriple: str): bool =
    if targetTriple == "aarch64-pc-windows-msvc":
        return true
    if targetTriple == "arm64-pc-windows-msvc":
        return true
    if targetTriple == "x86_64-pc-windows-msvc":
        return true
    return false

@borrows
fn TargetUsesLinuxNolibcRuntime(targetTriple: str): bool =
    if targetTriple == "aarch64-unknown-linux-gnu":
        return true
    if targetTriple == "arm64-unknown-linux-gnu":
        return true
    return false

@borrows
fn TargetNeedsNativeProviders(targetTriple: str): bool =
    if TargetIsRv64Bare(targetTriple):
        return false
    if TargetIsRv32Bare(targetTriple):
        return false
    if TargetIsEsp32S31(targetTriple):
        return false
    return !TargetIsWasm(targetTriple)

@borrows
fn TargetRequiresNativeProviderModules(targetTriple: str): bool =
    if targetTriple == "wasm32-unknown-unknown":
        return false
    if targetTriple == "riscv64-unknown-none-elf":
        return false
    if TargetIsRv32Bare(targetTriple):
        return false
    if TargetIsEsp32S31(targetTriple):
        return false
    if targetTriple == "aarch64-unknown-linux-gnu":
        return false
    if targetTriple == "arm64-unknown-linux-gnu":
        return false
    return true

@borrows
fn TargetPrimaryObjectFormat(targetTriple: str): str =
    if targetTriple == "arm64-apple-darwin":
        return "macho"
    if targetTriple == "aarch64-apple-ios":
        return "macho"
    if targetTriple == "arm64-apple-ios":
        return "macho"
    if targetTriple == "wasm32-unknown-unknown":
        return "wasm"
    if targetTriple == "aarch64-pc-windows-msvc":
        return "coff"
    if targetTriple == "arm64-pc-windows-msvc":
        return "coff"
    if targetTriple == "x86_64-pc-windows-msvc":
        return "coff"
    if targetTriple == "aarch64-unknown-linux-gnu":
        return "elf"
    if targetTriple == "arm64-unknown-linux-gnu":
        return "elf"
    if targetTriple == "aarch64-linux-android":
        return "elf"
    if targetTriple == "aarch64-linux-ohos":
        return "elf"
    if targetTriple == "aarch64-unknown-linux-ohos":
        return "elf"
    if targetTriple == "x86_64-unknown-linux-gnu":
        return "elf"
    if targetTriple == "riscv64-unknown-linux-gnu":
        return "elf"
    if targetTriple == "riscv64-unknown-none-elf":
        return "elf"
    if TargetIsRv32(targetTriple):
        return "elf"
    return "unknown"

@borrows
fn TargetLinkerFlavor(targetTriple: str): str =
    if targetTriple == "arm64-apple-darwin":
        return "macho_arm64_provider_internal"
    if targetTriple == "aarch64-apple-ios":
        return "macho_arm64_provider_internal"
    if targetTriple == "arm64-apple-ios":
        return "macho_arm64_provider_internal"
    if targetTriple == "aarch64-unknown-linux-gnu":
        return "elf_aarch64_nolibc_internal"
    if targetTriple == "arm64-unknown-linux-gnu":
        return "elf_aarch64_nolibc_internal"
    if targetTriple == "riscv64-unknown-linux-gnu":
        return "elf_riscv64_builtin"
    if targetTriple == "riscv64-unknown-none-elf":
        return "elf_riscv64_bare_builtin"
    if TargetIsLinuxRv32(targetTriple):
        return "elf_riscv32_builtin"
    if TargetIsRv32Bare(targetTriple):
        return "elf_riscv32_bare_builtin"
    if TargetIsEsp32S31(targetTriple):
        return "elf_riscv32_esp32s31_obj"
    if targetTriple == "aarch64-pc-windows-msvc":
        return "coff_pe_builtin"
    if targetTriple == "arm64-pc-windows-msvc":
        return "coff_pe_builtin"
    if targetTriple == "x86_64-pc-windows-msvc":
        return "coff_pe_builtin"
    if targetTriple == "x86_64-unknown-linux-gnu":
        return "elf_x86_64_internal"
    return "system_linker"

@borrows
fn TargetLinkerProgram(targetTriple: str): str =
    if targetTriple == "arm64-apple-darwin":
        return "internal_macho_linker"
    if targetTriple == "aarch64-apple-ios":
        return "internal_macho_linker"
    if targetTriple == "arm64-apple-ios":
        return "internal_macho_linker"
    if targetTriple == "aarch64-unknown-linux-gnu":
        return "internal_elf_linker"
    if targetTriple == "arm64-unknown-linux-gnu":
        return "internal_elf_linker"
    if targetTriple == "riscv64-unknown-linux-gnu":
        return "builtin_elf_linker_riscv64"
    if targetTriple == "riscv64-unknown-none-elf":
        return "builtin_elf_linker_riscv64_bare"
    if TargetIsLinuxRv32(targetTriple):
        return "builtin_elf_linker_riscv32"
    if TargetIsRv32Bare(targetTriple):
        return "none"
    if TargetIsEsp32S31(targetTriple):
        return "none"
    if targetTriple == "aarch64-linux-android":
        return "android_aarch64_clang"
    if targetTriple == "aarch64-linux-ohos":
        return "ohos_aarch64_clang"
    if targetTriple == "aarch64-unknown-linux-ohos":
        return "ohos_aarch64_clang"
    if targetTriple == "aarch64-pc-windows-msvc":
        return "builtin_coff_linker"
    if targetTriple == "arm64-pc-windows-msvc":
        return "builtin_coff_linker"
    if targetTriple == "x86_64-pc-windows-msvc":
        return "builtin_coff_linker"
    if targetTriple == "x86_64-unknown-linux-gnu":
        return "internal_elf_linker"
    return "cc"

fn TargetTripleDarwinA64(): str =
    return "arm64-apple-darwin"
