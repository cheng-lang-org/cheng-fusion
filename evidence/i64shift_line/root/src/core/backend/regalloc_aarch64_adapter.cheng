import cheng/core/ir/core_types as coreir
import std/strings
import cheng/core/ir/body_ir_access as bodyaccess
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/aarch64_encode as a64
import cheng/core/lang/typed_expr as texpr
import cheng/std/bytes_layout as layout
import std/os
import std/result

fn regallocA64Fail(recipe: var contract.RegallocA64ActionRecipe,
                   code: int32,
                   detail: int32) =
    recipe.valid = false
    recipe.errorCode = code
    recipe.errorDetail = detail

fn regallocA64FunctionFail(out: var contract.RegallocA64FunctionRecipes,
                           code: int32,
                           detail: int32) =
    out.valid = false
    out.errorCode = code
    out.errorDetail = detail

fn regallocA64SiteFail(recipe: var contract.RegallocA64SiteRecipe,
                       code: int32,
                       detail: int32) =
    recipe.valid = false
    recipe.errorCode = code
    recipe.errorDetail = detail

fn regallocA64MachineFragmentInit(): contract.RegallocA64MachineFragment =
    var fragment: contract.RegallocA64MachineFragment
    fragment.ownerOrdinal = -1
    fragment.actionConsumerOrdinal = -1
    fragment.siteIndex = -1
    fragment.blockIndex = -1
    fragment.edgeIndex = -1
    fragment.ingressIndex = -1
    fragment.sourceBlock = -1
    fragment.targetBlock = -1
    fragment.valueId = -1
    fragment.encoderEventStart = -1
    fragment.trampolineWordStart = -1
    fragment.trampolineTargetBlock = -1
    fragment.trampolineTargetWordStart = -1
    return fragment

@borrows
fn RegallocA64BodyOpKindKnown(kind: int32): bool =
    # Deliberately enumerated.  A new BodyOp tag cannot enter through a range
    # check and silently inherit another tag's ownership policy.
    if kind == coreir.BodyOpLoadConstTag:
        return true
    if kind == coreir.BodyOpCallTag:
        return true
    if kind == coreir.BodyOpBinOpTag:
        return true
    if kind == coreir.BodyOpCmpTag:
        return true
    if kind == coreir.BodyOpBranchTag:
        return true
    if kind == coreir.BodyOpReturnTag:
        return true
    if kind == coreir.BodyOpLoadLocalTag:
        return true
    if kind == coreir.BodyOpStoreLocalTag:
        return true
    if kind == coreir.BodyOpCopyLocalTag:
        return true
    if kind == coreir.BodyOpResultProjectTag:
        return true
    if kind == coreir.BodyOpStrEqLiteralTag:
        return true
    if kind == coreir.BodyOpIndexedLoadTag:
        return true
    if kind == coreir.BodyOpIndexedStoreTag:
        return true
    if kind == coreir.BodyOpFieldLoadTag:
        return true
    if kind == coreir.BodyOpFieldStoreTag:
        return true
    if kind == coreir.BodyOpGlobalLoadTag:
        return true
    if kind == coreir.BodyOpGlobalStoreTag:
        return true
    if kind == coreir.BodyOpStrEqTag:
        return true
    if kind == coreir.BodyOpResultPanicGuardTag:
        return true
    return false

@borrows
fn RegallocA64ActionKindMachine(kind: int32): bool =
    return alloc.RegallocSinglePassValueActionBindingKind(kind) ==
           alloc.RegallocValueBindingMachine

@borrows
fn RegallocA64ActionKindStructural(kind: int32): bool =
    return alloc.RegallocSinglePassValueActionBindingKind(kind) ==
           alloc.RegallocValueBindingStructural

fn regallocA64Align(value: int32, alignment: int32): int32 =
    if value < 0 || alignment <= 0:
        return -1
    let remainder = value % alignment
    if remainder == 0:
        return value
    let delta = alignment - remainder
    if value > 2147483647 - delta:
        return -1
    return value + delta

fn regallocA64RegEffect(reg: int32): int32 =
    if reg == a64.A64X16:
        return contract.RegallocA64EffectX16
    if reg == a64.A64X17:
        return contract.RegallocA64EffectX17
    return 0

fn regallocA64RemoveRegEffect(effectMask: int32,
                              reg: int32): int32 =
    let effect = regallocA64RegEffect(reg)
    if effect != 0 && (effectMask & effect) != 0:
        return effectMask - effect
    return effectMask

fn regallocA64AppendWrittenReg(regs: var int32[], reg: int32) =
    if reg < 0 || reg > a64.A64SP:
        return
    for index in 0..<regs.len:
        if regs[index] == reg:
            return
    add(regs, reg)

fn regallocA64SortWrittenRegs(regs: var int32[]) =
    for left in 0..<regs.len:
        var best = left
        for right in (left + 1)..<regs.len:
            if regs[right] < regs[best]:
                best = right
        if best != left:
            let value = regs[left]
            regs[left] = regs[best]
            regs[best] = value

fn regallocA64AppendEffectWrittenRegs(effectMask: int32,
                                      regs: var int32[]) =
    if (effectMask & contract.RegallocA64EffectX16) != 0:
        regallocA64AppendWrittenReg(regs, a64.A64X16)
    if (effectMask & contract.RegallocA64EffectX17) != 0:
        regallocA64AppendWrittenReg(regs, a64.A64X17)

@borrows
fn regallocA64AppendFrameRestoreWrittenRegs(
        plan: var alloc.RegallocSinglePassValuePlan,
        regs: var int32[]) =
    for reg in 0..<63:
        if (plan.usedCalleeMask & (int64(1) << reg)) != 0:
            regallocA64AppendWrittenReg(regs, reg)
    regallocA64AppendWrittenReg(regs, a64.A64FP)
    regallocA64AppendWrittenReg(regs, a64.A64LR)
    regallocA64AppendWrittenReg(regs, a64.A64SP)

fn regallocA64StackImmediateFits(byteOffset: int32,
                                 width: int32): bool =
    if byteOffset < 0:
        return false
    if width == 1:
        return byteOffset <= 4095
    if width == 2:
        return byteOffset % 2 == 0 && byteOffset <= 8190
    if width == 4:
        return byteOffset % 4 == 0 && byteOffset <= 16380
    if width == 8:
        return byteOffset % 8 == 0 && byteOffset <= 32760
    return false

@borrows
fn regallocA64WordsSpMemoryCallEffects(words: int32[]): int32 =
    var effects: int32
    var stackDerived: bool[]
    for _ in 0..<31:
        add(stackDerived, false)
    for wordIndex in 0..<words.len:
        let word = uint32(words[wordIndex])
        let top = word & uint32(0xffc00000)
        let baseReg = int32((word >> uint32(5)) & uint32(31))
        let scalarLoad = top == uint32(0x39400000) ||
                         top == uint32(0x79400000) ||
                         top == uint32(0xb9400000) ||
                         top == uint32(0xf9400000)
        let pairLoad = top == uint32(0xa9400000) ||
                       top == uint32(0xa9c00000) ||
                       top == uint32(0xa8c00000)
        let scalarStore = top == uint32(0x39000000) ||
                          top == uint32(0x79000000) ||
                          top == uint32(0xb9000000) ||
                          top == uint32(0xf9000000)
        let pairStore = top == uint32(0xa9000000) ||
                        top == uint32(0xa9800000) ||
                        top == uint32(0xa8800000)
        var baseIsStack = baseReg == a64.A64SP
        if baseReg >= 0 && baseReg < stackDerived.len &&
           stackDerived[baseReg]:
            baseIsStack = true
        if baseIsStack:
            if scalarLoad || pairLoad:
                effects = effects | contract.RegallocA64EffectSpLoad
            elif scalarStore || pairStore:
                effects = effects | contract.RegallocA64EffectSpStore
        let isCall =
            (word & uint32(0xfc000000)) == uint32(0x94000000) ||
            (word & uint32(0xfffffc1f)) == uint32(0xd63f0000)
        if isCall:
            effects = effects | contract.RegallocA64EffectCall
            for reg in 0..<19:
                stackDerived[reg] = false
            stackDerived[a64.A64LR] = false
        let destinationReg = int32(word & uint32(31))
        if scalarLoad || pairLoad:
            if destinationReg >= 0 &&
               destinationReg < stackDerived.len:
                stackDerived[destinationReg] = false
            if pairLoad:
                let secondReg = int32(
                    (word >> uint32(10)) & uint32(31))
                if secondReg >= 0 && secondReg < stackDerived.len:
                    stackDerived[secondReg] = false
            continue
        if scalarStore || pairStore || isCall:
            continue
        let addImmediate =
            (word & uint32(0x7f000000)) == uint32(0x11000000) ||
            (word & uint32(0x7f000000)) == uint32(0x51000000)
        if addImmediate:
            var derived = baseReg == a64.A64SP
            if baseReg >= 0 && baseReg < stackDerived.len &&
               stackDerived[baseReg]:
                derived = true
            if destinationReg >= 0 &&
               destinationReg < stackDerived.len:
                stackDerived[destinationReg] = derived
            continue
        if (word & uint32(0xffe0ffe0)) == uint32(0xaa0003e0):
            let sourceReg = int32(
                (word >> uint32(16)) & uint32(31))
            var derived: bool
            if sourceReg >= 0 && sourceReg < stackDerived.len:
                derived = stackDerived[sourceReg]
            if destinationReg >= 0 &&
               destinationReg < stackDerived.len:
                stackDerived[destinationReg] = derived
            continue
        if (word & uint32(0xffe08000)) == uint32(0x9b000000):
            let leftReg = int32(
                (word >> uint32(5)) & uint32(31))
            let rightReg = int32(
                (word >> uint32(16)) & uint32(31))
            let addendReg = int32(
                (word >> uint32(10)) & uint32(31))
            var derived: bool
            if leftReg >= 0 && leftReg < stackDerived.len &&
               stackDerived[leftReg]:
                derived = true
            if rightReg >= 0 && rightReg < stackDerived.len &&
               stackDerived[rightReg]:
                derived = true
            if addendReg >= 0 && addendReg < stackDerived.len &&
               stackDerived[addendReg]:
                derived = true
            if destinationReg >= 0 &&
               destinationReg < stackDerived.len:
                stackDerived[destinationReg] = derived
            continue
        let isAdrp =
            (word & uint32(0x9f000000)) == uint32(0x90000000)
        let isWideImmediate =
            (word & uint32(0x1f800000)) == uint32(0x12800000) ||
            (word & uint32(0x1f800000)) == uint32(0x52800000) ||
            (word & uint32(0x1f800000)) == uint32(0x72800000)
        if (isAdrp || isWideImmediate) &&
           destinationReg >= 0 && destinationReg < stackDerived.len:
            stackDerived[destinationReg] = false
    return effects

@borrows
fn regallocA64SlotWidth(bodyIR: var coreir.BodyIR,
                        slotIndex: int32): int32 =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return 0
    # Canonical ingress has already proved typeKind/sizeBytes/alignBytes as one
    # frozen row. Emission consumes that exact layout column and never
    # reconstructs a width from the type classification.
    return bodyIR.localSlots[slotIndex].sizeBytes

@borrows
fn regallocA64ValueSlot(plan: var alloc.RegallocSinglePassValuePlan,
                        valueId: int32): int32 =
    if valueId < 0 || valueId >= plan.valueSlotIndices.len:
        return -1
    return plan.valueSlotIndices[valueId]

fn regallocA64AppendStackAddress(words: var int32[],
                                 targetReg: int32,
                                 byteOffset: int32): bool =
    if byteOffset < 0:
        return false
    var remain = byteOffset
    var baseReg = a64.A64SP
    if remain == 0:
        add(words, Value(a64.A64EncAddImm(true, targetReg, baseReg, 0)))
        return true
    while remain > 0:
        var step = remain
        if step > 4095:
            step = 4095
        add(words, Value(a64.A64EncAddImm(true, targetReg, baseReg, step)))
        baseReg = targetReg
        remain = remain - step
    return true

fn regallocA64AppendLoad(words: var int32[],
                         targetReg: int32,
                         byteOffset: int32,
                         width: int32): bool =
    if byteOffset < 0:
        return false
    if width == 1:
        if byteOffset <= 4095:
            add(words, Value(a64.A64EncLdrbImm(
                targetReg, a64.A64SP, byteOffset)))
            return true
    elif width == 2:
        if byteOffset % 2 == 0 && byteOffset <= 8190:
            add(words, Value(a64.A64EncLdrhImm(
                targetReg, a64.A64SP, byteOffset)))
            return true
    elif width == 4:
        if byteOffset % 4 == 0 && byteOffset <= 16380:
            add(words, Value(a64.A64EncLdrImm(
                false, targetReg, a64.A64SP, int64(byteOffset))))
            return true
    elif width == 8:
        if byteOffset % 8 == 0 && byteOffset <= 32760:
            add(words, Value(a64.A64EncLdrImm(
                true, targetReg, a64.A64SP, int64(byteOffset))))
            return true
    else:
        return false
    # A load may use its destination as the temporary address register: the
    # final load replaces the address, so no reserved x16/x17 is needed.
    if !regallocA64AppendStackAddress(words, targetReg, byteOffset):
        return false
    if width == 1:
        add(words, Value(a64.A64EncLdrbImm(targetReg, targetReg, 0)))
        return true
    if width == 2:
        add(words, Value(a64.A64EncLdrhImm(targetReg, targetReg, 0)))
        return true
    if width == 4 || width == 8:
        add(words, Value(a64.A64EncLdrImm(width == 8,
                                          targetReg,
                                          targetReg,
                                          int64(0))))
        return true
    return false

fn regallocA64AppendStore(words: var int32[],
                          sourceReg: int32,
                          byteOffset: int32,
                          width: int32): bool =
    if byteOffset < 0:
        return false
    if width == 1:
        if byteOffset <= 4095:
            add(words, Value(a64.A64EncStrbImm(
                sourceReg, a64.A64SP, byteOffset)))
            return true
    elif width == 2:
        if byteOffset % 2 == 0 && byteOffset <= 8190:
            add(words, Value(a64.A64EncStrhImm(
                sourceReg, a64.A64SP, byteOffset)))
            return true
    elif width == 4:
        if byteOffset % 4 == 0 && byteOffset <= 16380:
            add(words, Value(a64.A64EncStrImm(
                false, sourceReg, a64.A64SP, int64(byteOffset))))
            return true
    elif width == 8:
        if byteOffset % 8 == 0 && byteOffset <= 32760:
            add(words, Value(a64.A64EncStrImm(
                true, sourceReg, a64.A64SP, int64(byteOffset))))
            return true
    else:
        return false
    # Stores cannot destroy their live source.  Large stack offsets therefore
    # have an explicit reserved-register requirement, audited by the gate.
    if !regallocA64AppendStackAddress(words, a64.A64X17, byteOffset):
        return false
    if width == 1:
        add(words, Value(a64.A64EncStrbImm(sourceReg, a64.A64X17, 0)))
    elif width == 2:
        add(words, Value(a64.A64EncStrhImm(sourceReg, a64.A64X17, 0)))
    else:
        add(words, Value(a64.A64EncStrImm(
            width == 8, sourceReg, a64.A64X17, int64(0))))
    return true

fn regallocA64AppendSpAdjust(words: var int32[],
                             byteCount: int32,
                             subtract: bool): bool =
    if byteCount < 0:
        return false
    var remain = byteCount
    while remain > 0:
        var step = remain
        if step > 4095:
            step = 4095
        if subtract:
            add(words, Value(a64.A64EncSubImm(
                true, a64.A64SP, a64.A64SP, step)))
        else:
            add(words, Value(a64.A64EncAddImm(
                true, a64.A64SP, a64.A64SP, step)))
        remain = remain - step
    return true

@borrows
fn regallocA64ParamIndex(slot: coreir.LocalSlot): int32 =
    if slot.stackOffset >= 0:
        return -1
    return 0 - 1 - slot.stackOffset

@borrows
fn regallocA64IncomingParamWidth(slot: coreir.LocalSlot): int32 =
    if slot.typeKind == coreir.LocalI32Tag:
        if slot.auxValue == 1:
            return 1
        return 4
    return 8

@borrows
fn regallocA64ParamSlotIndex(bodyIR: var coreir.BodyIR,
                             paramIndex: int32): int32 =
    var found: int32 = -1
    for slotIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[slotIndex]
        if regallocA64ParamIndex(slot) != paramIndex:
            continue
        if found >= 0:
            return -2
        found = slotIndex
    return found

@borrows
fn regallocA64EntryValueForSlot(
        plan: var alloc.RegallocSinglePassValuePlan,
        slotIndex: int32): int32 =
    var found: int32 = -1
    for valueId in 0..<plan.valueSlotIndices.len:
        if valueId >= plan.valueDefIsEntry.len ||
           !plan.valueDefIsEntry[valueId] ||
           plan.valueSlotIndices[valueId] != slotIndex:
            continue
        if found >= 0:
            return -2
        found = valueId
    return found

@borrows
fn regallocA64IncomingStackParamOffset(
        bodyIR: var coreir.BodyIR,
        paramIndex: int32): int32 =
    if paramIndex < 8:
        return -1
    var offset: int32
    for current in 8..<(paramIndex + 1):
        var width = 8
        for slotIndex in 0..<bodyIR.localSlots.len:
            let slot = bodyIR.localSlots[slotIndex]
            if regallocA64ParamIndex(slot) == current:
                width = regallocA64IncomingParamWidth(slot)
                break
        offset = regallocA64Align(offset, width)
        if offset < 0:
            return -1
        if current == paramIndex:
            return offset
        if offset > 2147483647 - width:
            return -1
        offset = offset + width
    return -1

fn regallocA64AppendMove(words: var int32[],
                         targetReg: int32,
                         sourceReg: int32,
                         is64: bool): bool =
    # A frozen machine action must own bytes.  A self ORR is not a producer.
    if targetReg < 0 || sourceReg < 0 || targetReg == sourceReg:
        return false
    add(words, a64.A64EncOrrReg(is64, targetReg, a64.A64ZR, sourceReg))
    return true

fn regallocA64AppendCopyMove(words: var int32[],
                             targetReg: int32,
                             sourceReg: int32,
                             sourceType: int32,
                             targetType: int32,
                             targetAuxValue: int32): bool =
    if targetReg < 0 || sourceReg < 0:
        return false
    # A pointer slot with aux metadata is a write-through destination, not a
    # register-value copy.  This adapter must not silently reinterpret it.
    if targetType == coreir.LocalPtrTag && targetAuxValue != 0:
        return false
    if sourceType == coreir.LocalI32Tag &&
       targetType == coreir.LocalI64Tag:
        # BodyIR CopyLocal widening is signed, including the same-reg case.
        add(words, a64.A64EncSxtw(targetReg, sourceReg))
        return true
    if sourceType == coreir.LocalI64Tag &&
       targetType == coreir.LocalI32Tag:
        # The W write performs the required truncation and clears high bits.
        add(words, a64.A64EncOrrReg(
            false, targetReg, a64.A64ZR, sourceReg))
        return true
    let representationCopy = sourceType == targetType ||
        (sourceType == coreir.LocalPtrTag &&
         targetType == coreir.LocalI64Tag) ||
        (sourceType == coreir.LocalI64Tag &&
         targetType == coreir.LocalPtrTag)
    if !representationCopy:
        return false
    return regallocA64AppendMove(
        words, targetReg, sourceReg, sourceType != coreir.LocalI32Tag)

@borrows
fn regallocA64AppendImmediate(words: var int32[],
                              targetReg: int32,
                              op: coreir.BodyOp): bool =
    if op.operands.len != 2 && op.operands.len != 5:
        return false
    let is64 = op.operands[0] != coreir.LocalI32Tag
    if op.operands.len == 5:
        add(words, a64.A64EncMovz(true, targetReg,
                                  op.operands[1] & 65535, 0))
        for chunkIndex in 2..<5:
            if op.operands[chunkIndex] != 0:
                add(words, a64.A64EncMovk(true, targetReg,
                                          op.operands[chunkIndex] & 65535,
                                          chunkIndex - 1))
        return true
    let value = op.operands[1]
    if value >= 0 && value <= 65535:
        add(words, a64.A64EncMovz(is64, targetReg, value, 0))
        return true
    if value < 0 && value >= -65536:
        add(words, a64.A64EncMovn(is64, targetReg,
                                  (0 - value - 1) & 65535, 0))
        return true
    if value < 0:
        add(words, a64.A64EncMovn(is64, targetReg,
                                  (0 - value - 1) & 65535, 0))
    else:
        add(words, a64.A64EncMovz(is64, targetReg,
                                  value & 65535, 0))
    add(words, a64.A64EncMovk(is64, targetReg,
                              (value >> 16) & 65535, 1))
    return true

@borrows
fn regallocA64OperandReg(table: var bodyaccess.BodyIrAccessTable,
                         plan: var alloc.RegallocSinglePassValuePlan,
                         opIndex: int32,
                         operandIndex: int32): int32 =
    if opIndex < 0 || opIndex >= table.opFactStarts.len:
        return -1
    let start = table.opFactStarts[opIndex]
    let count = table.opFactCounts[opIndex]
    if start < 0 || count < 0 || start > table.facts.len - count:
        return -1
    for factIndex in start..<(start + count):
        let fact = table.facts[factIndex]
        if fact.kind == bodyaccess.BodyIrAccessFactUse &&
           fact.operandIndex == operandIndex:
            if factIndex < 0 || factIndex >= plan.operandRegByFact.len:
                return -1
            return plan.operandRegByFact[factIndex]
    return -1

@borrows
fn regallocA64TermOperandReg(table: var bodyaccess.BodyIrAccessTable,
                             plan: var alloc.RegallocSinglePassValuePlan,
                             termIndex: int32,
                             operandIndex: int32): int32 =
    if termIndex < 0 || termIndex >= table.termFactStarts.len:
        return -1
    let start = table.termFactStarts[termIndex]
    let count = table.termFactCounts[termIndex]
    if start < 0 || count < 0 || start > table.facts.len - count:
        return -1
    for factIndex in start..<(start + count):
        let fact = table.facts[factIndex]
        if fact.kind == bodyaccess.BodyIrAccessFactUse &&
           fact.operandIndex == operandIndex:
            if factIndex < 0 || factIndex >= plan.operandRegByFact.len:
                return -1
            return plan.operandRegByFact[factIndex]
    return -1

fn regallocA64AppendAddressOffset(words: var int32[],
                                  targetReg: int32,
                                  baseReg: int32,
                                  byteOffset: int32): bool =
    if byteOffset < 0:
        return false
    if targetReg != baseReg &&
       !regallocA64AppendMove(words, targetReg, baseReg, true):
        return false
    var remain = byteOffset
    while remain > 0:
        var step = remain
        if step > 4095:
            step = 4095
        add(words, Value(a64.A64EncAddImm(
            true, targetReg, targetReg, step)))
        remain = remain - step
    return true

fn regallocA64CondCode(cond: int32): int32 =
    if cond == coreir.BodyCondI32EqTag ||
       cond == coreir.BodyCondI64EqTag ||
       cond == coreir.BodyCondF64EqTag:
        return a64.A64CondEQ
    if cond == coreir.BodyCondI32NeTag ||
       cond == coreir.BodyCondI64NeTag ||
       cond == coreir.BodyCondF64NeTag:
        return a64.A64CondNE
    if cond == coreir.BodyCondI32LtTag ||
       cond == coreir.BodyCondI64LtTag:
        return a64.A64CondLT
    if cond == coreir.BodyCondI32LeTag ||
       cond == coreir.BodyCondI64LeTag:
        return a64.A64CondLE
    if cond == coreir.BodyCondI32GtTag ||
       cond == coreir.BodyCondI64GtTag ||
       cond == coreir.BodyCondF64GtTag:
        return a64.A64CondGT
    if cond == coreir.BodyCondI32GeTag ||
       cond == coreir.BodyCondI64GeTag ||
       cond == coreir.BodyCondF64GeTag:
        return a64.A64CondGE
    if cond == coreir.BodyCondU32LtTag ||
       cond == coreir.BodyCondU64LtTag:
        return a64.A64CondLO
    if cond == coreir.BodyCondU32LeTag ||
       cond == coreir.BodyCondU64LeTag:
        return a64.A64CondLS
    if cond == coreir.BodyCondU32GtTag ||
       cond == coreir.BodyCondU64GtTag:
        return a64.A64CondHI
    if cond == coreir.BodyCondU32GeTag ||
       cond == coreir.BodyCondU64GeTag:
        return a64.A64CondHS
    # FCMP unordered sets C=1,V=1,Z=0,N=0. Integer LT/LE would therefore
    # accept NaN for < and <=. MI/LS are the AArch64 floating predicates
    # mirrored by the primary and backend2 emitters.
    if cond == coreir.BodyCondF64LtTag:
        return a64.A64CondMI
    if cond == coreir.BodyCondF64LeTag:
        return a64.A64CondLS
    return -1

fn regallocA64OperandRegOrGprStack(
        words: var int32[],
        bodyIR: var coreir.BodyIR,
        table: var bodyaccess.BodyIrAccessTable,
        plan: var alloc.RegallocSinglePassValuePlan,
        localOffsets: var int32[],
        opIndex: int32,
        operandIndex: int32,
        slotIndex: int32,
        scratchReg: int32): int32 =
    let allocated = regallocA64OperandReg(
        table, plan, opIndex, operandIndex)
    if allocated >= 0:
        return allocated
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len ||
       slotIndex >= localOffsets.len:
        return -1
    let typeKind = bodyIR.localSlots[slotIndex].typeKind
    var width: int32
    if typeKind == coreir.LocalI32Tag:
        width = 4
    elif typeKind == coreir.LocalI64Tag ||
         typeKind == coreir.LocalPtrTag ||
         typeKind == coreir.LocalF64Tag:
        width = 8
    elif typeKind == coreir.LocalAggregateTag &&
         bodyIR.localSlots[slotIndex].stackOffset < 0:
        # var 参数聚合槽(stackOffset<0 是参数标记):槽内容是调用方聚合体的
        # 地址指针,按 8 字节装 — 地址算术(vfaddr/字段取址)的合法操作数。
        width = 8
    else:
        return -1
    if !regallocA64AppendLoad(words, scratchReg,
                              localOffsets[slotIndex], width):
        return -1
    return scratchReg

fn regallocA64OperandRegOrF64Stack(
        words: var int32[],
        bodyIR: var coreir.BodyIR,
        table: var bodyaccess.BodyIrAccessTable,
        plan: var alloc.RegallocSinglePassValuePlan,
        localOffsets: var int32[],
        opIndex: int32,
        operandIndex: int32,
        slotIndex: int32,
        scratchReg: int32): int32 =
    let allocated = regallocA64OperandReg(
        table, plan, opIndex, operandIndex)
    if allocated >= 0:
        return allocated
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len ||
       slotIndex >= localOffsets.len ||
       bodyIR.localSlots[slotIndex].typeKind != coreir.LocalF64Tag ||
       !regallocA64AppendLoad(words, scratchReg,
                              localOffsets[slotIndex], 8):
        return -1
    return scratchReg

fn regallocA64TermOperandRegOrF64Stack(
        words: var int32[],
        bodyIR: var coreir.BodyIR,
        table: var bodyaccess.BodyIrAccessTable,
        plan: var alloc.RegallocSinglePassValuePlan,
        localOffsets: var int32[],
        termIndex: int32,
        operandIndex: int32,
        slotIndex: int32,
        scratchReg: int32): int32 =
    let allocated = regallocA64TermOperandReg(
        table, plan, termIndex, operandIndex)
    if allocated >= 0:
        return allocated
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len ||
       slotIndex >= localOffsets.len ||
       bodyIR.localSlots[slotIndex].typeKind != coreir.LocalF64Tag ||
       !regallocA64AppendLoad(words, scratchReg,
                              localOffsets[slotIndex], 8):
        return -1
    return scratchReg

@borrows
fn regallocA64AppendBinOp(words: var int32[],
                          bodyIR: var coreir.BodyIR,
                          table: var bodyaccess.BodyIrAccessTable,
                          plan: var alloc.RegallocSinglePassValuePlan,
                          localOffsets: var int32[],
                          opIndex: int32,
                          targetReg: int32,
                          op: coreir.BodyOp): bool =
    if op.operands.len != 4 && op.operands.len != 5:
        return false
    let opType = op.operands[0]
    let lhsSlot = op.operands[2]
    let rhsSlot = op.operands[3]
    if opType == coreir.LocalF64Tag:
        if op.operands.len != 4 || lhsSlot < 0 ||
           lhsSlot >= bodyIR.localSlots.len || rhsSlot < 0 ||
           rhsSlot >= bodyIR.localSlots.len ||
           bodyIR.localSlots[lhsSlot].typeKind != coreir.LocalF64Tag ||
           bodyIR.localSlots[rhsSlot].typeKind != coreir.LocalF64Tag:
            return false
        let lhsF64 = regallocA64OperandRegOrF64Stack(
            words, bodyIR, table, plan, localOffsets,
            opIndex, 2, lhsSlot, a64.A64X16)
        let rhsF64 = regallocA64OperandRegOrF64Stack(
            words, bodyIR, table, plan, localOffsets,
            opIndex, 3, rhsSlot, a64.A64X17)
        if lhsF64 < 0 || rhsF64 < 0:
            return false
        add(words, a64.A64EncFmovDx(16, lhsF64))
        add(words, a64.A64EncFmovDx(17, rhsF64))
        let kind = op.operands[1]
        if kind == int32(texpr.TypedExprIrOpF64Add):
            add(words, a64.A64EncFaddD(16, 16, 17))
        elif kind == int32(texpr.TypedExprIrOpF64Sub):
            add(words, a64.A64EncFsubD(16, 16, 17))
        elif kind == int32(texpr.TypedExprIrOpF64Mul):
            add(words, a64.A64EncFmulD(16, 16, 17))
        elif kind == int32(texpr.TypedExprIrOpF64Div):
            add(words, a64.A64EncFdivD(16, 16, 17))
        else:
            return false
        add(words, a64.A64EncFmovXd(targetReg, 16))
        return true
    var lhs = regallocA64OperandReg(table, plan, opIndex, 2)
    if lhs < 0:
        lhs = regallocA64OperandRegOrGprStack(
            words, bodyIR, table, plan, localOffsets,
            opIndex, 2, lhsSlot, a64.A64X16)
    var rhs = regallocA64OperandReg(table, plan, opIndex, 3)
    if rhs < 0:
        rhs = regallocA64OperandRegOrGprStack(
            words, bodyIR, table, plan, localOffsets,
            opIndex, 3, rhsSlot, a64.A64X17)
    if lhs < 0 || rhs < 0:
        return false
    let is64 = opType == coreir.LocalI64Tag
    let kind = op.operands[1]
    if kind == int32(texpr.TypedExprIrOpI32Add) ||
       kind == int32(texpr.TypedExprIrOpI64Add):
        add(words, a64.A64EncAddReg(is64, targetReg, lhs, rhs))
        return true
    if kind == int32(texpr.TypedExprIrOpI32Sub) ||
       kind == int32(texpr.TypedExprIrOpI64Sub):
        add(words, a64.A64EncSubReg(is64, targetReg, lhs, rhs))
        return true
    if kind == int32(texpr.TypedExprIrOpI32Mul) ||
       kind == int32(texpr.TypedExprIrOpI64Mul):
        add(words, a64.A64EncMul(is64, targetReg, lhs, rhs))
        return true
    if kind == int32(texpr.TypedExprIrOpI32BitAnd) ||
       kind == int32(texpr.TypedExprIrOpI64BitAnd):
        add(words, a64.A64EncAndReg(is64, targetReg, lhs, rhs))
        return true
    if kind == int32(texpr.TypedExprIrOpI32BitOr) ||
       kind == int32(texpr.TypedExprIrOpI64BitOr):
        add(words, a64.A64EncOrrReg(is64, targetReg, lhs, rhs))
        return true
    if kind == int32(texpr.TypedExprIrOpI32BitXor) ||
       kind == int32(texpr.TypedExprIrOpI64BitXor):
        add(words, a64.A64EncEorReg(is64, targetReg, lhs, rhs))
        return true
    if kind == int32(texpr.TypedExprIrOpI32Asr) ||
       kind == int32(texpr.TypedExprIrOpI64Asr):
        add(words, a64.A64EncAsrv(is64, targetReg, lhs, rhs))
        return true
    if kind == int32(texpr.TypedExprIrOpI32Lsr) ||
       kind == int32(texpr.TypedExprIrOpI64Lsr):
        add(words, a64.A64EncLsrv(is64, targetReg, lhs, rhs))
        return true
    if kind == int32(texpr.TypedExprIrOpI32Lsl) ||
       kind == int32(texpr.TypedExprIrOpI64Lsl):
        add(words, a64.A64EncLslv(is64, targetReg, lhs, rhs))
        return true
    if kind == int32(texpr.TypedExprIrOpI32Sdiv) ||
       kind == int32(texpr.TypedExprIrOpI64Sdiv):
        add(words, a64.A64EncSdiv(is64, targetReg, lhs, rhs))
        return true
    if kind == int32(texpr.TypedExprIrOpI32Udiv) ||
       kind == int32(texpr.TypedExprIrOpI64Udiv):
        add(words, a64.A64EncUdiv(is64, targetReg, lhs, rhs))
        return true
    if kind == int32(texpr.TypedExprIrOpI32Madd) &&
       op.operands.len == 5:
        let addend = regallocA64OperandReg(table, plan, opIndex, 4)
        if addend < 0:
            return false
        add(words, a64.A64EncMadd(is64, targetReg, lhs, rhs, addend))
        return true
    return false

@borrows
fn regallocA64AppendCmp(words: var int32[],
                        bodyIR: var coreir.BodyIR,
                        table: var bodyaccess.BodyIrAccessTable,
                        plan: var alloc.RegallocSinglePassValuePlan,
                        localOffsets: var int32[],
                        opIndex: int32,
                        targetReg: int32,
                        op: coreir.BodyOp): bool =
    if op.operands.len != 3:
        return false
    let cond = regallocA64CondCode(op.operands[0])
    if cond < 0:
        return false
    let lhsSlot = op.operands[1]
    let rhsSlot = op.operands[2]
    if lhsSlot < 0 || lhsSlot >= bodyIR.localSlots.len ||
       rhsSlot < 0 || rhsSlot >= bodyIR.localSlots.len:
        return false
    let lhsType = bodyIR.localSlots[lhsSlot].typeKind
    let rhsType = bodyIR.localSlots[rhsSlot].typeKind
    if lhsType == coreir.LocalF64Tag || rhsType == coreir.LocalF64Tag:
        if lhsType != coreir.LocalF64Tag || rhsType != coreir.LocalF64Tag:
            return false
        let lhsF64 = regallocA64OperandRegOrF64Stack(
            words, bodyIR, table, plan, localOffsets,
            opIndex, 1, lhsSlot, a64.A64X16)
        let rhsF64 = regallocA64OperandRegOrF64Stack(
            words, bodyIR, table, plan, localOffsets,
            opIndex, 2, rhsSlot, a64.A64X17)
        if lhsF64 < 0 || rhsF64 < 0:
            return false
        add(words, a64.A64EncFmovDx(16, lhsF64))
        add(words, a64.A64EncFmovDx(17, rhsF64))
        add(words, a64.A64EncFcmpD(16, 17))
        add(words, Value(a64.A64EncCset(targetReg, cond)))
        return true
    let lhs = regallocA64OperandReg(table, plan, opIndex, 1)
    let rhs = regallocA64OperandReg(table, plan, opIndex, 2)
    if lhs < 0 || rhs < 0:
        return false
    let is64 = lhsType == coreir.LocalI64Tag ||
               bodyIR.localSlots[lhsSlot].typeKind == coreir.LocalPtrTag ||
               rhsType == coreir.LocalI64Tag ||
               rhsType == coreir.LocalPtrTag
    add(words, a64.A64EncCmpReg(is64, lhs, rhs))
    add(words, Value(a64.A64EncCset(targetReg, cond)))
    return true

@borrows
fn regallocA64AppendDataAddress(recipe: var contract.RegallocA64ActionRecipe,
                                targetReg: int32,
                                symbol: str): bool =
    if len(symbol) <= 0:
        return false
    recipe.effectMask = recipe.effectMask |
                        regallocA64RegEffect(targetReg)
    let start = recipe.words.len
    add(recipe.words, a64.A64EncAdrp(targetReg))
    add(recipe.words, Value(a64.A64EncAddImm(true,
                                             targetReg,
                                             targetReg,
                                             0)))
    var page: contract.RegallocA64ActionReloc
    page.kind = contract.RegallocA64RelocPage21
    page.wordIndex = start
    page.byteOffset = start * 4
    page.callOrdinal = -1
    page.targetSymbol = strings.CloneStr(symbol)
    add(recipe.relocs, share(page))
    var pageOff: contract.RegallocA64ActionReloc
    pageOff.kind = contract.RegallocA64RelocPageOff12
    pageOff.wordIndex = start + 1
    pageOff.byteOffset = (start + 1) * 4
    pageOff.callOrdinal = -1
    pageOff.targetSymbol = strings.CloneStr(page.targetSymbol)
    add(recipe.relocs, share(pageOff))
    return true

@borrows
fn regallocA64AppendSiteDataAddress(
        recipe: var contract.RegallocA64SiteRecipe,
        targetReg: int32,
        symbol: str): bool =
    if len(symbol) <= 0:
        return false
    recipe.effectMask = recipe.effectMask |
                        regallocA64RegEffect(targetReg)
    let start = recipe.words.len
    add(recipe.words, a64.A64EncAdrp(targetReg))
    add(recipe.words, Value(a64.A64EncAddImm(
        true, targetReg, targetReg, 0)))
    var page: contract.RegallocA64ActionReloc
    page.kind = contract.RegallocA64RelocPage21
    page.wordIndex = start
    page.byteOffset = start * 4
    page.callOrdinal = -1
    page.targetSymbol = strings.CloneStr(symbol)
    add(recipe.relocs, share(page))
    var pageOff: contract.RegallocA64ActionReloc
    pageOff.kind = contract.RegallocA64RelocPageOff12
    pageOff.wordIndex = start + 1
    pageOff.byteOffset = (start + 1) * 4
    pageOff.callOrdinal = -1
    pageOff.targetSymbol = strings.CloneStr(page.targetSymbol)
    add(recipe.relocs, share(pageOff))
    return true

fn regallocA64AppendStoreToAddress(words: var int32[],
                                   sourceReg: int32,
                                   baseReg: int32,
                                   byteOffset: int32,
                                   width: int32): bool =
    if sourceReg < 0 || baseReg < 0 || byteOffset < 0:
        return false
    if width == 1 && byteOffset <= 4095:
        add(words, Value(a64.A64EncStrbImm(
            sourceReg, baseReg, byteOffset)))
        return true
    if width == 2 && byteOffset % 2 == 0 && byteOffset <= 8190:
        add(words, Value(a64.A64EncStrhImm(
            sourceReg, baseReg, byteOffset)))
        return true
    if width == 4 && byteOffset % 4 == 0 && byteOffset <= 16380:
        add(words, Value(a64.A64EncStrImm(
            false, sourceReg, baseReg, int64(byteOffset))))
        return true
    if width == 8 && byteOffset % 8 == 0 && byteOffset <= 32760:
        add(words, Value(a64.A64EncStrImm(
            true, sourceReg, baseReg, int64(byteOffset))))
        return true
    if width != 1 && width != 2 && width != 4 && width != 8:
        return false
    if !regallocA64AppendAddressOffset(
           words, a64.A64X17, baseReg, byteOffset):
        return false
    if width == 1:
        add(words, Value(a64.A64EncStrbImm(
            sourceReg, a64.A64X17, 0)))
    elif width == 2:
        add(words, Value(a64.A64EncStrhImm(
            sourceReg, a64.A64X17, 0)))
    else:
        add(words, Value(a64.A64EncStrImm(
            width == 8, sourceReg, a64.A64X17, int64(0))))
    return true

fn regallocA64AppendLoadFromAddress(words: var int32[],
                                    targetReg: int32,
                                    baseReg: int32,
                                    byteOffset: int32,
                                    width: int32): bool =
    if targetReg < 0 || baseReg < 0 || byteOffset < 0:
        return false
    if width == 1 && byteOffset <= 4095:
        add(words, Value(a64.A64EncLdrbImm(
            targetReg, baseReg, byteOffset)))
        return true
    if width == 2 && byteOffset % 2 == 0 && byteOffset <= 8190:
        add(words, Value(a64.A64EncLdrhImm(
            targetReg, baseReg, byteOffset)))
        return true
    if width == 4 && byteOffset % 4 == 0 && byteOffset <= 16380:
        add(words, Value(a64.A64EncLdrImm(
            false, targetReg, baseReg, int64(byteOffset))))
        return true
    if width == 8 && byteOffset % 8 == 0 && byteOffset <= 32760:
        add(words, Value(a64.A64EncLdrImm(
            true, targetReg, baseReg, int64(byteOffset))))
        return true
    if width != 1 && width != 2 && width != 4 && width != 8:
        return false
    if !regallocA64AppendAddressOffset(
           words, a64.A64X17, baseReg, byteOffset):
        return false
    if width == 1:
        add(words, Value(a64.A64EncLdrbImm(
            targetReg, a64.A64X17, 0)))
    elif width == 2:
        add(words, Value(a64.A64EncLdrhImm(
            targetReg, a64.A64X17, 0)))
    else:
        add(words, Value(a64.A64EncLdrImm(
            width == 8, targetReg, a64.A64X17, int64(0))))
    return true

@borrows
fn regallocA64AppendIndexedAddress(
        words: var int32[],
        bodyIR: var coreir.BodyIR,
        table: var bodyaccess.BodyIrAccessTable,
        plan: var alloc.RegallocSinglePassValuePlan,
        opIndex: int32,
        addressReg: int32): int32 =
    if opIndex < 0 || opIndex >= bodyIR.ops.len || addressReg < 0:
        return -1
    let op = bodyIR.ops[opIndex]
    if op.kind != coreir.BodyOpIndexedLoadTag &&
       op.kind != coreir.BodyOpIndexedStoreTag:
        return -1
    if op.operands.len < 4:
        return addressReg
    if op.operands.len != 4 && op.operands.len != 5:
        return -1
    if op.operands.len == 5:
        if op.operands[4] != 1:
            return -1
        add(words, Value(a64.A64EncLdrImm(
            true, a64.A64X17, addressReg, int64(8))))
        addressReg = a64.A64X17
    let indexReg = regallocA64OperandReg(table, plan, opIndex, 2)
    let stride = op.operands[3]
    if indexReg < 0 || stride <= 0:
        return -1
    # A positive int32 stride is semantic input. The imm16 width only selects
    # whether materialization needs MOVZ or MOVZ+MOVK.
    add(words, a64.A64EncMovz(
        true, a64.A64X16, stride & 65535, 0))
    if stride > 65535:
        add(words, a64.A64EncMovk(
            true, a64.A64X16, (stride >> 16) & 65535, 1))
    add(words, a64.A64EncMadd(
        true, a64.A64X17, indexReg, a64.A64X16, addressReg))
    return a64.A64X17

@borrows
fn regallocA64AppendIndexedStore(
        words: var int32[],
        bodyIR: var coreir.BodyIR,
        table: var bodyaccess.BodyIrAccessTable,
        plan: var alloc.RegallocSinglePassValuePlan,
        localOffsets: var int32[],
        opIndex: int32,
        resolvedAddressReg: int32): bool =
    if opIndex < 0 || opIndex >= bodyIR.ops.len:
        return false
    let op = bodyIR.ops[opIndex]
    if op.kind != coreir.BodyOpIndexedStoreTag ||
       (op.operands.len != 2 && op.operands.len != 3 &&
        op.operands.len != 4 && op.operands.len != 5):
        return false
    let baseSlot = op.operands[0]
    let valueSlot = op.operands[1]
    if baseSlot < 0 || baseSlot >= bodyIR.localSlots.len ||
       valueSlot < 0 || valueSlot >= bodyIR.localSlots.len:
        return false
    var valueReg = regallocA64OperandReg(table, plan, opIndex, 1)
    var addressReg = resolvedAddressReg
    if addressReg < 0:
        addressReg = regallocA64OperandReg(table, plan, opIndex, 0)
    if addressReg < 0:
        if !regallocA64AppendMemoryBaseAddress(
               words, bodyIR, localOffsets,
               a64.A64X17, baseSlot):
            return false
        addressReg = a64.A64X17
    if addressReg < 0:
        return false
    var width = regallocA64SlotWidth(bodyIR, valueSlot)
    if op.operands.len == 3:
        width = 1
    if op.operands.len >= 4:
        addressReg = regallocA64AppendIndexedAddress(
            words, bodyIR, table, plan, opIndex, addressReg)
        if addressReg < 0:
            return false
        width = op.operands[3]
    if valueReg < 0 &&
       bodyIR.localSlots[valueSlot].typeKind == coreir.LocalF64Tag:
        valueReg = regallocA64OperandRegOrF64Stack(
            words, bodyIR, table, plan, localOffsets,
            opIndex, 1, valueSlot, a64.A64X16)
    if valueReg < 0:
        return false
    return regallocA64AppendStoreToAddress(
        words, valueReg, addressReg, 0, width)

@borrows
fn regallocA64AppendFieldStore(
        words: var int32[],
        bodyIR: var coreir.BodyIR,
        table: var bodyaccess.BodyIrAccessTable,
        plan: var alloc.RegallocSinglePassValuePlan,
        localOffsets: var int32[],
        opIndex: int32,
        resolvedAddressReg: int32): bool =
    if opIndex < 0 || opIndex >= bodyIR.ops.len:
        return false
    let op = bodyIR.ops[opIndex]
    if op.kind != coreir.BodyOpFieldStoreTag || op.operands.len != 4:
        return false
    let baseSlot = op.operands[0]
    if baseSlot < 0 || baseSlot >= bodyIR.localSlots.len:
        return false
    let valueSlot = op.operands[1]
    if valueSlot < 0 || valueSlot >= bodyIR.localSlots.len:
        return false
    var valueReg = regallocA64OperandReg(table, plan, opIndex, 1)
    var addressReg = resolvedAddressReg
    if addressReg < 0:
        addressReg = regallocA64OperandReg(table, plan, opIndex, 0)
    if addressReg < 0:
        if !regallocA64AppendMemoryBaseAddress(
               words, bodyIR, localOffsets,
               a64.A64X17, baseSlot):
            return false
        addressReg = a64.A64X17
    if addressReg < 0:
        return false
    if valueReg < 0 &&
       bodyIR.localSlots[valueSlot].typeKind == coreir.LocalF64Tag:
        valueReg = regallocA64OperandRegOrF64Stack(
            words, bodyIR, table, plan, localOffsets,
            opIndex, 1, valueSlot, a64.A64X16)
    if valueReg < 0:
        return false
    return regallocA64AppendStoreToAddress(
        words, valueReg, addressReg,
        op.operands[2], op.operands[3])

@borrows
fn regallocA64AppendSlotAddressWords(
        words: var int32[],
        bodyIR: var coreir.BodyIR,
        localOffsets: var int32[],
        targetReg: int32,
        slotIndex: int32,
        spBias: int32): bool =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len ||
       slotIndex >= localOffsets.len:
        return false
    let slot = bodyIR.localSlots[slotIndex]
    if slot.placeKind == coreir.BodyPlaceParamAddressTag ||
        (slot.stackOffset < 0 &&
        (slot.typeKind == coreir.LocalStrTag ||
         slot.typeKind == coreir.LocalAggregateTag)):
        return regallocA64AppendLoad(words, targetReg,
                                     localOffsets[slotIndex] + spBias, 8)
    if slot.placeKind == coreir.BodyPlaceBorrowAddressTag:
        let owner = slot.auxValue
        if owner < 0 || owner >= bodyIR.localSlots.len ||
           owner >= localOffsets.len || slot.stackOffset < 0 ||
           bodyIR.localSlots[owner].stackOffset < 0 ||
           slot.stackOffset < bodyIR.localSlots[owner].stackOffset:
            return false
        let delta = slot.stackOffset -
                    bodyIR.localSlots[owner].stackOffset
        return regallocA64AppendStackAddress(
            words, targetReg,
            localOffsets[owner] + delta + spBias)
    return regallocA64AppendStackAddress(words, targetReg,
                                          localOffsets[slotIndex] + spBias)

@borrows
fn regallocA64AppendMemoryBaseAddress(
        words: var int32[],
        bodyIR: var coreir.BodyIR,
        localOffsets: var int32[],
        targetReg: int32,
        slotIndex: int32): bool =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return false
    let slot = bodyIR.localSlots[slotIndex]
    let addressBacked =
        slot.placeKind == coreir.BodyPlaceParamAddressTag ||
        slot.placeKind == coreir.BodyPlaceBorrowAddressTag ||
        (slot.stackOffset < 0 &&
         (slot.typeKind == coreir.LocalStrTag ||
          slot.typeKind == coreir.LocalAggregateTag))
    if !addressBacked &&
       !bodyaccess.BodyIrAccessBaseIsLocalMemory(bodyIR, slotIndex):
        return false
    return regallocA64AppendSlotAddressWords(
        words, bodyIR, localOffsets, targetReg, slotIndex, 0)

@borrows
fn regallocA64DataSymbolProjectionShapeValid(
        bodyIR: var coreir.BodyIR,
        slotDataSymbols: var str[],
        cstringDataSymbols: var str[],
        projectionRequired: bool): bool =
    if !projectionRequired:
        return slotDataSymbols.len == 0 &&
               cstringDataSymbols.len == 0
    if slotDataSymbols.len != bodyIR.localSlots.len ||
       cstringDataSymbols.len != bodyIR.cstringLiterals.len:
        return false
    for slotIndex in 0..<bodyIR.localSlots.len:
        let globalSlot =
            bodyIR.localSlots[slotIndex].placeKind ==
                coreir.BodyPlaceGlobalAddressTag
        if globalSlot != (len(slotDataSymbols[slotIndex]) > 0):
            return false
    for literalIndex in 0..<bodyIR.cstringLiterals.len:
        if len(cstringDataSymbols[literalIndex]) <= 0:
            return false
    return true

@borrows
fn regallocA64AppendProjectedSlotDataAddress(
        recipe: var contract.RegallocA64ActionRecipe,
        bodyIR: var coreir.BodyIR,
        slotDataSymbols: var str[],
        projectionRequired: bool,
        targetReg: int32,
        slotIndex: int32): bool =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return false
    if projectionRequired:
        if slotIndex >= slotDataSymbols.len:
            return false
        return regallocA64AppendDataAddress(
            recipe, targetReg, slotDataSymbols[slotIndex])
    return regallocA64AppendDataAddress(
        recipe, targetReg, bodyIR.localSlots[slotIndex].name)

@borrows
fn regallocA64AppendProjectedSiteSlotDataAddress(
        recipe: var contract.RegallocA64SiteRecipe,
        bodyIR: var coreir.BodyIR,
        slotDataSymbols: var str[],
        projectionRequired: bool,
        targetReg: int32,
        slotIndex: int32): bool =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return false
    if projectionRequired:
        if slotIndex >= slotDataSymbols.len:
            return false
        return regallocA64AppendSiteDataAddress(
            recipe, targetReg, slotDataSymbols[slotIndex])
    return regallocA64AppendSiteDataAddress(
        recipe, targetReg, bodyIR.localSlots[slotIndex].name)

@borrows
fn regallocA64AppendProjectedCStringDataAddress(
        recipe: var contract.RegallocA64ActionRecipe,
        bodyIR: var coreir.BodyIR,
        cstringDataSymbols: var str[],
        projectionRequired: bool,
        targetReg: int32,
        literalIndex: int32): bool =
    if literalIndex < 0 ||
       literalIndex >= bodyIR.cstringLiterals.len:
        return false
    if projectionRequired:
        if literalIndex >= cstringDataSymbols.len:
            return false
        return regallocA64AppendDataAddress(
            recipe, targetReg, cstringDataSymbols[literalIndex])
    return regallocA64AppendDataAddress(
        recipe, targetReg,
        bodyIR.cstringLiterals[literalIndex].dataLabel)

@borrows
fn regallocA64AppendSlotAddress(
        recipe: var contract.RegallocA64ActionRecipe,
        bodyIR: var coreir.BodyIR,
        slotDataSymbols: var str[],
        projectionRequired: bool,
        localOffsets: var int32[],
        targetReg: int32,
        slotIndex: int32,
        spBias: int32): bool =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        return false
    let slot = bodyIR.localSlots[slotIndex]
    if slot.placeKind == coreir.BodyPlaceGlobalAddressTag:
        return regallocA64AppendProjectedSlotDataAddress(
            recipe, bodyIR, slotDataSymbols,
            projectionRequired, targetReg, slotIndex)
    return regallocA64AppendSlotAddressWords(
        recipe.words, bodyIR, localOffsets,
        targetReg, slotIndex, spBias)

@borrows
fn regallocA64AppendStrValueAddress(
        words: var int32[],
        bodyIR: var coreir.BodyIR,
        localOffsets: var int32[],
        slotIndex: int32,
        targetReg: int32): bool =
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len ||
       slotIndex >= localOffsets.len ||
       bodyIR.localSlots[slotIndex].typeKind != coreir.LocalStrTag:
        return false
    if bodyIR.localSlots[slotIndex].stackOffset < 0 ||
       bodyIR.localSlots[slotIndex].placeKind ==
           coreir.BodyPlaceParamAddressTag:
        return regallocA64AppendLoad(words, targetReg,
                                     localOffsets[slotIndex], 8)
    return regallocA64AppendStackAddress(words, targetReg,
                                          localOffsets[slotIndex])

fn regallocA64MemoryCopyChunkWidth(sourceByteOffset: int32,
                                   copied: int32,
                                   byteCount: int32): int32 =
    if byteCount - copied >= 8 &&
       (sourceByteOffset + copied) % 8 == 0 && copied % 8 == 0:
        return 8
    if byteCount - copied >= 4 &&
       (sourceByteOffset + copied) % 4 == 0 && copied % 4 == 0:
        return 4
    return 1

@borrows
fn regallocA64AppendMemorySliceCopyToLocalStack(
        recipe: var contract.RegallocA64ActionRecipe,
        bodyIR: var coreir.BodyIR,
        slotDataSymbols: var str[],
        projectionRequired: bool,
        localOffsets: var int32[],
        sourceSlotIndex: int32,
        sourceByteOffset: int32,
        targetSlotIndex: int32,
        byteCount: int32): bool =
    if sourceSlotIndex < 0 ||
       sourceSlotIndex >= bodyIR.localSlots.len ||
       sourceSlotIndex >= localOffsets.len ||
       targetSlotIndex < 0 ||
       targetSlotIndex >= bodyIR.localSlots.len ||
       targetSlotIndex >= localOffsets.len:
        return false
    let sourceSlot = bodyIR.localSlots[sourceSlotIndex]
    let targetSlot = bodyIR.localSlots[targetSlotIndex]
    if (sourceSlot.typeKind != coreir.LocalStrTag &&
        sourceSlot.typeKind != coreir.LocalAggregateTag) ||
       (targetSlot.typeKind != coreir.LocalStrTag &&
        targetSlot.typeKind != coreir.LocalAggregateTag) ||
       sourceByteOffset < 0 || byteCount <= 0 ||
       sourceSlot.sizeBytes < byteCount ||
       sourceByteOffset > sourceSlot.sizeBytes - byteCount ||
       targetSlot.sizeBytes < byteCount ||
       !bodyaccess.BodyIrAccessBaseIsLocalMemory(
           bodyIR, targetSlotIndex):
        return false
    let sourceIsLocal = bodyaccess.BodyIrAccessBaseIsLocalMemory(
        bodyIR, sourceSlotIndex)
    let sourceIsAddress =
        sourceSlot.placeKind == coreir.BodyPlaceParamAddressTag ||
        sourceSlot.placeKind == coreir.BodyPlaceBorrowAddressTag ||
        sourceSlot.placeKind == coreir.BodyPlaceGlobalAddressTag ||
        sourceSlot.stackOffset < 0
    if !sourceIsLocal && !sourceIsAddress:
        return false
    let targetOffset = localOffsets[targetSlotIndex]
    recipe.effectMask = recipe.effectMask |
                        contract.RegallocA64EffectX16
    if sourceIsAddress:
        recipe.effectMask = recipe.effectMask |
                            contract.RegallocA64EffectX17

    # Keep an address-backed source in x17 across every chunk exactly when
    # neither the source loads nor target stores need x17 as a temporary.
    # Large offsets retain per-chunk rematerialization for correctness.
    var sourceAddressStable: bool
    if sourceIsAddress:
        sourceAddressStable = true
        var checked: int32
        while checked < byteCount:
            let width = regallocA64MemoryCopyChunkWidth(
                sourceByteOffset, checked, byteCount)
            if !regallocA64StackImmediateFits(
                   sourceByteOffset + checked, width) ||
               !regallocA64StackImmediateFits(
                   targetOffset + checked, width):
                sourceAddressStable = false
            checked = checked + width
        if sourceAddressStable &&
           !regallocA64AppendSlotAddress(
               recipe, bodyIR, slotDataSymbols,
               projectionRequired, localOffsets,
               a64.A64X17, sourceSlotIndex, 0):
            return false

    var copied: int32
    while copied < byteCount:
        let width = regallocA64MemoryCopyChunkWidth(
            sourceByteOffset, copied, byteCount)
        if sourceIsLocal:
            if !regallocA64AppendLoad(
                   recipe.words, a64.A64X16,
                   localOffsets[sourceSlotIndex] +
                       sourceByteOffset + copied,
                   width):
                return false
        else:
            if !sourceAddressStable &&
               !regallocA64AppendSlotAddress(
                   recipe, bodyIR, slotDataSymbols,
                   projectionRequired, localOffsets,
                   a64.A64X17, sourceSlotIndex, 0):
                return false
            if !regallocA64AppendLoadFromAddress(
                   recipe.words, a64.A64X16, a64.A64X17,
                   sourceByteOffset + copied, width):
                return false
        if !regallocA64StackImmediateFits(
               targetOffset + copied, width):
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX17
        if !regallocA64AppendStore(
               recipe.words, a64.A64X16,
               targetOffset + copied, width):
            return false
        copied = copied + width
    recipe.producerWritesMemoryOnly = true
    return true

@borrows
fn regallocA64AppendAggregateCopyToLocalStack(
        recipe: var contract.RegallocA64ActionRecipe,
        bodyIR: var coreir.BodyIR,
        slotDataSymbols: var str[],
        projectionRequired: bool,
        localOffsets: var int32[],
        sourceSlotIndex: int32,
        targetSlotIndex: int32): bool =
    if sourceSlotIndex < 0 ||
       sourceSlotIndex >= bodyIR.localSlots.len ||
       targetSlotIndex < 0 ||
       targetSlotIndex >= bodyIR.localSlots.len:
        return false
    let sourceSlot = bodyIR.localSlots[sourceSlotIndex]
    let targetSlot = bodyIR.localSlots[targetSlotIndex]
    if sourceSlot.typeKind != targetSlot.typeKind ||
       sourceSlot.sizeBytes <= 0 ||
       sourceSlot.sizeBytes != targetSlot.sizeBytes:
        return false
    return regallocA64AppendMemorySliceCopyToLocalStack(
        recipe, bodyIR, slotDataSymbols,
        projectionRequired, localOffsets, sourceSlotIndex, 0,
        targetSlotIndex, sourceSlot.sizeBytes)

@borrows
fn regallocA64AppendStrEqLiteral(
        recipe: var contract.RegallocA64ActionRecipe,
        bodyIR: var coreir.BodyIR,
        cstringDataSymbols: var str[],
        projectionRequired: bool,
        localOffsets: var int32[],
        targetReg: int32,
        op: coreir.BodyOp): bool =
    recipe.effectMask = recipe.effectMask |
                        contract.RegallocA64EffectX16 |
                        contract.RegallocA64EffectX17
    regallocA64AppendWrittenReg(recipe.writtenRegs, a64.A64X7)
    regallocA64AppendWrittenReg(recipe.writtenRegs, a64.A64X8)
    if op.operands.len != 2:
        return false
    let literalId = op.operands[1]
    if literalId < 0 || literalId >= bodyIR.cstringLiterals.len:
        return false
    let literal = bodyIR.cstringLiterals[literalId]
    let literalLen = len(literal.text)
    # Recipe words and PAGE/PAGEOFF relocs are frozen together. The literal data
    # address makes the compare loop constant-size instead of encoding one
    # LDRB/CMP/B triplet per byte.
    if !regallocA64AppendProjectedCStringDataAddress(
           recipe, bodyIR, cstringDataSymbols,
           projectionRequired, a64.A64X17, literalId) ||
       !regallocA64AppendStrValueAddress(
           recipe.words, bodyIR, localOffsets,
           op.operands[0], a64.A64X16):
        return false
    add(recipe.words, Value(a64.A64EncLdrImm(
        true, a64.A64X8, a64.A64X16, int64(0))))
    add(recipe.words, Value(a64.A64EncLdrImm(
        false, targetReg, a64.A64X16, int64(8))))
    add(recipe.words, a64.A64EncMovz(
        false, a64.A64X7, literalLen & 65535, 0))
    if literalLen > 65535:
        add(recipe.words, a64.A64EncMovk(
            false, a64.A64X7, (literalLen >> 16) & 65535, 1))
    add(recipe.words, a64.A64EncCmpReg(
        false, targetReg, a64.A64X7))
    let lengthFailPos = recipe.words.len
    add(recipe.words, a64.A64EncBPlaceholder())
    let loopHead = recipe.words.len
    let emptySuccessPos = recipe.words.len
    add(recipe.words, a64.A64EncBPlaceholder())
    add(recipe.words, Value(a64.A64EncLdrbImm(
        a64.A64X16, a64.A64X8, 0)))
    add(recipe.words, Value(a64.A64EncLdrbImm(
        a64.A64X7, a64.A64X17, 0)))
    add(recipe.words, a64.A64EncCmpReg(
        false, a64.A64X16, a64.A64X7))
    let byteFailPos = recipe.words.len
    add(recipe.words, a64.A64EncBPlaceholder())
    add(recipe.words, Value(a64.A64EncAddImm(
        true, a64.A64X8, a64.A64X8, 1)))
    add(recipe.words, Value(a64.A64EncAddImm(
        true, a64.A64X17, a64.A64X17, 1)))
    add(recipe.words, Value(a64.A64EncSubImm(
        false, targetReg, targetReg, 1)))
    let backPos = recipe.words.len
    add(recipe.words, a64.A64EncBPlaceholder())
    let successPos = recipe.words.len
    add(recipe.words, a64.A64EncMovz(false, targetReg, 1, 0))
    let successEndPos = recipe.words.len
    add(recipe.words, a64.A64EncBPlaceholder())
    let failPos = recipe.words.len
    add(recipe.words, a64.A64EncMovz(false, targetReg, 0, 0))
    let endPos = recipe.words.len
    let lengthFailDistance = failPos - lengthFailPos
    let emptySuccessDistance = successPos - emptySuccessPos
    let byteFailDistance = failPos - byteFailPos
    let backDistance = loopHead - backPos
    let successEndDistance = endPos - successEndPos
    recipe.words[lengthFailPos] = Value(a64.A64EncBCond(
        int64(lengthFailDistance), a64.A64CondNE))
    recipe.words[emptySuccessPos] = Value(a64.A64EncCbz(
        false, targetReg, int64(emptySuccessDistance)))
    recipe.words[byteFailPos] = Value(a64.A64EncBCond(
        int64(byteFailDistance), a64.A64CondNE))
    recipe.words[backPos] = Value(a64.A64EncBImm(
        int64(backDistance)))
    recipe.words[successEndPos] = Value(a64.A64EncBImm(
        int64(successEndDistance)))
    return true

@borrows
fn regallocA64AppendStrEq(
        recipe: var contract.RegallocA64ActionRecipe,
        bodyIR: var coreir.BodyIR,
        localOffsets: var int32[],
        targetReg: int32,
        op: coreir.BodyOp): bool =
    recipe.effectMask = recipe.effectMask |
                        contract.RegallocA64EffectX16 |
                        contract.RegallocA64EffectX17
    regallocA64AppendWrittenReg(recipe.writtenRegs, a64.A64X7)
    regallocA64AppendWrittenReg(recipe.writtenRegs, a64.A64X8)
    if op.operands.len != 2 ||
       !regallocA64AppendStrValueAddress(
           recipe.words, bodyIR, localOffsets,
           op.operands[0], a64.A64X16):
        return false
    add(recipe.words, Value(a64.A64EncLdrImm(
        true, a64.A64X8, a64.A64X16, int64(0))))
    add(recipe.words, Value(a64.A64EncLdrImm(
        false, targetReg, a64.A64X16, int64(8))))
    if !regallocA64AppendStrValueAddress(
           recipe.words, bodyIR, localOffsets,
           op.operands[1], a64.A64X17):
        return false
    add(recipe.words, Value(a64.A64EncLdrImm(
        false, a64.A64X7, a64.A64X17, int64(8))))
    add(recipe.words, a64.A64EncCmpReg(false,
                                       targetReg,
                                       a64.A64X7))
    let lengthFailPos = recipe.words.len
    add(recipe.words, a64.A64EncBPlaceholder())
    add(recipe.words, Value(a64.A64EncLdrImm(
        true, a64.A64X17, a64.A64X17, int64(0))))
    if !regallocA64AppendMove(
           recipe.words, a64.A64X16, a64.A64X8, true):
        return false
    let loopHead = recipe.words.len
    let emptySuccessPos = recipe.words.len
    add(recipe.words, a64.A64EncBPlaceholder())
    add(recipe.words, Value(a64.A64EncLdrbImm(
        a64.A64X8, a64.A64X16, 0)))
    add(recipe.words, Value(a64.A64EncLdrbImm(
        a64.A64X7, a64.A64X17, 0)))
    add(recipe.words, a64.A64EncCmpReg(false,
                                       a64.A64X8,
                                       a64.A64X7))
    let byteFailPos = recipe.words.len
    add(recipe.words, a64.A64EncBPlaceholder())
    add(recipe.words, Value(a64.A64EncAddImm(
        true, a64.A64X16, a64.A64X16, 1)))
    add(recipe.words, Value(a64.A64EncAddImm(
        true, a64.A64X17, a64.A64X17, 1)))
    add(recipe.words, Value(a64.A64EncSubImm(
        false, targetReg, targetReg, 1)))
    let backPos = recipe.words.len
    add(recipe.words, a64.A64EncBPlaceholder())
    let successPos = recipe.words.len
    add(recipe.words, a64.A64EncMovz(false, targetReg, 1, 0))
    let successEndPos = recipe.words.len
    add(recipe.words, a64.A64EncBPlaceholder())
    let failPos = recipe.words.len
    add(recipe.words, a64.A64EncMovz(false, targetReg, 0, 0))
    let endPos = recipe.words.len
    let lengthFailDistance = failPos - lengthFailPos
    let emptySuccessDistance = successPos - emptySuccessPos
    let byteFailDistance = failPos - byteFailPos
    let backDistance = loopHead - backPos
    let successEndDistance = endPos - successEndPos
    recipe.words[lengthFailPos] = Value(a64.A64EncBCond(
        int64(lengthFailDistance), a64.A64CondNE))
    recipe.words[emptySuccessPos] = Value(a64.A64EncCbz(
        false, targetReg,
        int64(emptySuccessDistance)))
    recipe.words[byteFailPos] = Value(a64.A64EncBCond(
        int64(byteFailDistance), a64.A64CondNE))
    recipe.words[backPos] = Value(a64.A64EncBImm(
        int64(backDistance)))
    recipe.words[successEndPos] = Value(a64.A64EncBImm(
        int64(successEndDistance)))
    return true

@borrows
fn regallocA64AppendProducer(recipe: var contract.RegallocA64ActionRecipe,
                             bodyIR: var coreir.BodyIR,
                             slotDataSymbols: var str[],
                             cstringDataSymbols: var str[],
                             projectionRequired: bool,
                             table: var bodyaccess.BodyIrAccessTable,
                             plan: var alloc.RegallocSinglePassValuePlan,
                             localOffsets: var int32[],
                             action: alloc.RegallocValueAction,
                             targetReg: int32): bool =
    if action.opIndex < 0 || action.opIndex >= bodyIR.ops.len:
        return false
    let op = bodyIR.ops[action.opIndex]
    recipe.producerOpKind = op.kind
    recipe.ownsBodyOp = true
    recipe.effectMask = recipe.effectMask |
                        regallocA64RegEffect(targetReg)
    if op.kind == coreir.BodyOpLoadConstTag:
        return regallocA64AppendImmediate(recipe.words, targetReg, op)
    if op.kind == coreir.BodyOpCallTag:
        return false
    if op.kind == coreir.BodyOpBinOpTag:
        if op.operands.len > 0 &&
           op.operands[0] == coreir.LocalF64Tag:
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX16 |
                                contract.RegallocA64EffectX17
        elif op.operands.len == 4 &&
             ((op.operands[2] >= 0 && op.operands[2] < bodyIR.localSlots.len &&
               regallocA64OperandReg(table, plan, action.opIndex, 2) < 0) ||
              (op.operands[3] >= 0 && op.operands[3] < bodyIR.localSlots.len &&
               regallocA64OperandReg(table, plan, action.opIndex, 3) < 0)):
            # 栈驻标量操作数(F64 同款):producer 现场装栈进 scratch,占用 X16/X17。
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX16 |
                                contract.RegallocA64EffectX17
        return regallocA64AppendBinOp(
            recipe.words, bodyIR, table, plan, localOffsets,
            action.opIndex, targetReg, op)
    if op.kind == coreir.BodyOpCmpTag:
        if op.operands.len == 3:
            let lhsSlot = op.operands[1]
            if lhsSlot >= 0 && lhsSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[lhsSlot].typeKind ==
                   coreir.LocalF64Tag:
                recipe.effectMask = recipe.effectMask |
                                    contract.RegallocA64EffectX16 |
                                    contract.RegallocA64EffectX17
        return regallocA64AppendCmp(
            recipe.words, bodyIR, table, plan, localOffsets,
            action.opIndex, targetReg, op)
    if op.kind == coreir.BodyOpBranchTag ||
       op.kind == coreir.BodyOpReturnTag:
        return false
    if op.kind == coreir.BodyOpStoreLocalTag ||
       op.kind == coreir.BodyOpCopyLocalTag:
        let slot = regallocA64ValueSlot(plan, action.valueId)
        if op.operands[0] < 0 ||
           op.operands[0] >= bodyIR.localSlots.len ||
           slot < 0 || slot >= bodyIR.localSlots.len:
            return false
        let sourceSlot = bodyIR.localSlots[op.operands[0]]
        let targetSlot = bodyIR.localSlots[slot]
        if sourceSlot.typeKind == coreir.LocalStrTag ||
           sourceSlot.typeKind == coreir.LocalAggregateTag:
            return regallocA64AppendAggregateCopyToLocalStack(
                recipe, bodyIR, slotDataSymbols,
                projectionRequired, localOffsets,
                op.operands[0], slot)
        var sourceReg = regallocA64OperandReg(table, plan,
                                              action.opIndex, 0)
        if sourceReg < 0 &&
           sourceSlot.typeKind == coreir.LocalF64Tag:
            var scratchReg = a64.A64X17
            if targetReg == a64.A64X17:
                scratchReg = a64.A64X16
            sourceReg = regallocA64OperandRegOrF64Stack(
                recipe.words, bodyIR, table, plan, localOffsets,
                action.opIndex, 0, op.operands[0], scratchReg)
            recipe.effectMask = recipe.effectMask |
                                regallocA64RegEffect(scratchReg)
        return regallocA64AppendCopyMove(
            recipe.words, targetReg, sourceReg,
            sourceSlot.typeKind, targetSlot.typeKind,
            targetSlot.auxValue)
    if op.kind == coreir.BodyOpLoadLocalTag:
        if op.operands.len == 1:
            var sourceReg = regallocA64OperandReg(table, plan,
                                                  action.opIndex, 0)
            if op.operands[0] < 0 ||
               op.operands[0] >= bodyIR.localSlots.len ||
               op.target < 0 || op.target >= bodyIR.localSlots.len:
                return false
            let sourceSlot = bodyIR.localSlots[op.operands[0]]
            let targetSlot = bodyIR.localSlots[op.target]
            if sourceReg < 0 &&
               sourceSlot.typeKind == coreir.LocalF64Tag:
                var scratchReg = a64.A64X17
                if targetReg == a64.A64X17:
                    scratchReg = a64.A64X16
                sourceReg = regallocA64OperandRegOrF64Stack(
                    recipe.words, bodyIR, table, plan, localOffsets,
                    action.opIndex, 0, op.operands[0], scratchReg)
                recipe.effectMask = recipe.effectMask |
                                    regallocA64RegEffect(scratchReg)
            return regallocA64AppendCopyMove(
                recipe.words, targetReg, sourceReg,
                sourceSlot.typeKind, targetSlot.typeKind,
                targetSlot.auxValue)
        if op.operands.len == 2 &&
           op.operands[0] == coreir.BodyLoadLocalAddressTag:
            let sourceSlot = op.operands[1]
            if sourceSlot < 0 || sourceSlot >= localOffsets.len:
                return false
            return regallocA64AppendStackAddress(recipe.words, targetReg,
                                                  localOffsets[sourceSlot])
        if op.operands.len == 2 &&
           op.operands[0] == coreir.BodyLoadLocalCStringTag:
            let literal = op.operands[1]
            if literal < 0 || literal >= bodyIR.cstringLiterals.len:
                return false
            return regallocA64AppendProjectedCStringDataAddress(
                recipe, bodyIR, cstringDataSymbols,
                projectionRequired, targetReg, literal)
        if op.operands.len == 3 &&
           op.operands[0] == coreir.BodyLoadLocalStrIndexU8Tag:
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX17
            if !regallocA64AppendStrValueAddress(
                   recipe.words, bodyIR, localOffsets,
                   op.operands[1], a64.A64X17):
                return false
            let indexReg = regallocA64OperandReg(table, plan,
                                                 action.opIndex, 2)
            if indexReg < 0:
                return false
            add(recipe.words, Value(a64.A64EncLdrImm(
                true, a64.A64X17, a64.A64X17, int64(0))))
            add(recipe.words, a64.A64EncAddReg(
                true, a64.A64X17, a64.A64X17, indexReg))
            add(recipe.words, Value(a64.A64EncLdrbImm(
                targetReg, a64.A64X17, 0)))
            return true
        if op.operands.len == 3 &&
           (op.operands[0] == coreir.BodyLoadLocalPtrDerefI32Tag ||
            op.operands[0] == coreir.BodyLoadLocalPtrDerefU8Tag ||
            op.operands[0] == coreir.BodyLoadLocalPtrDerefU64Tag):
            let pointerReg = regallocA64OperandReg(table, plan,
                                                   action.opIndex, 1)
            if pointerReg < 0:
                return false
            if op.operands[2] == 1:
                add(recipe.words, Value(a64.A64EncLdrbImm(
                    targetReg, pointerReg, 0)))
                return true
            if op.operands[2] == 4 || op.operands[2] == 8:
                add(recipe.words, Value(a64.A64EncLdrImm(
                    op.operands[2] == 8, targetReg, pointerReg, int64(0))))
                return true
            return false
        return false
    if op.kind == coreir.BodyOpResultProjectTag:
        recipe.effectMask = recipe.effectMask |
                            contract.RegallocA64EffectX16
        if op.operands.len == 4 &&
           (op.operands[0] == coreir.BodyResultProjectErrorStrTag ||
            op.operands[0] == coreir.BodyResultProjectValueStrTag ||
            op.operands[0] == coreir.BodyResultProjectErrInfoTag):
            return regallocA64AppendMemorySliceCopyToLocalStack(
                recipe, bodyIR, slotDataSymbols,
                projectionRequired, localOffsets,
                op.operands[1], op.operands[2],
                op.target, op.operands[3])
        if op.operands.len != 2 ||
           (op.operands[0] != coreir.BodyResultProjectIsErrTag &&
            op.operands[0] != coreir.BodyResultProjectIsOkTag):
            return false
        let sourceSlot = op.operands[1]
        if sourceSlot < 0 || sourceSlot >= localOffsets.len:
            return false
        if bodyIR.localSlots[sourceSlot].placeKind ==
           coreir.BodyPlaceParamAddressTag:
            if !regallocA64AppendLoad(recipe.words, a64.A64X16,
                                      localOffsets[sourceSlot], 8):
                return false
            add(recipe.words, Value(a64.A64EncLdrImm(
                false, a64.A64X16, a64.A64X16,
                int64(coreir.ResultStrOkOffset))))
        else:
            if !regallocA64AppendLoad(
                   recipe.words, a64.A64X16,
                   localOffsets[sourceSlot] + coreir.ResultStrOkOffset, 4):
                return false
        add(recipe.words, Value(a64.A64EncCmpImm(false,
                                                 a64.A64X16, 0)))
        var cond = a64.A64CondNE
        if op.operands[0] == coreir.BodyResultProjectIsErrTag:
            cond = a64.A64CondEQ
        add(recipe.words, Value(a64.A64EncCset(targetReg, cond)))
        return true
    if op.kind == coreir.BodyOpIndexedLoadTag:
        if op.operands.len != 2 && op.operands.len != 4 &&
           op.operands.len != 5:
            return false
        var addressReg = regallocA64OperandReg(table, plan,
                                               action.opIndex, 0)
        let baseSlot = op.operands[0]
        if addressReg < 0:
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX17
            if baseSlot >= 0 && baseSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[baseSlot].placeKind ==
                   coreir.BodyPlaceGlobalAddressTag:
                if !regallocA64AppendProjectedSlotDataAddress(
                       recipe, bodyIR, slotDataSymbols,
                       projectionRequired, a64.A64X17, baseSlot):
                    return false
            elif !regallocA64AppendMemoryBaseAddress(
                     recipe.words, bodyIR, localOffsets,
                     a64.A64X17, baseSlot):
                return false
            addressReg = a64.A64X17
        if addressReg < 0:
            return false
        if op.operands.len >= 4:
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX16 |
                                contract.RegallocA64EffectX17
            addressReg = regallocA64AppendIndexedAddress(
                recipe.words, bodyIR, table, plan,
                action.opIndex, addressReg)
            if addressReg < 0:
                return false
        let width = regallocA64SlotWidth(bodyIR, op.target)
        if width == 1:
            add(recipe.words, Value(a64.A64EncLdrbImm(
                targetReg, addressReg, 0)))
            return true
        if width == 4 || width == 8:
            add(recipe.words, Value(a64.A64EncLdrImm(
                width == 8, targetReg, addressReg, int64(0))))
            return true
        return false
    if op.kind == coreir.BodyOpIndexedStoreTag:
        recipe.effectMask = regallocA64RemoveRegEffect(
            recipe.effectMask, targetReg)
        let baseSlot = op.operands[0]
        var resolvedAddressReg: int32 = -1
        if baseSlot >= 0 && baseSlot < bodyIR.localSlots.len &&
           bodyIR.localSlots[baseSlot].placeKind ==
               coreir.BodyPlaceGlobalAddressTag:
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX17
            if !regallocA64AppendProjectedSlotDataAddress(
                   recipe, bodyIR, slotDataSymbols,
                   projectionRequired, a64.A64X17, baseSlot):
                return false
            resolvedAddressReg = a64.A64X17
        if op.operands.len >= 4:
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX16 |
                                contract.RegallocA64EffectX17
        elif regallocA64OperandReg(
                 table, plan, action.opIndex, 0) < 0:
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX17
        if op.operands.len >= 2:
            let valueSlot = op.operands[1]
            if valueSlot >= 0 && valueSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[valueSlot].typeKind ==
                   coreir.LocalF64Tag &&
               regallocA64OperandReg(
                   table, plan, action.opIndex, 1) < 0:
                recipe.effectMask = recipe.effectMask |
                                    contract.RegallocA64EffectX16
        recipe.producerWritesMemoryOnly = true
        return regallocA64AppendIndexedStore(
            recipe.words, bodyIR, table, plan, localOffsets,
            action.opIndex, resolvedAddressReg)
    if op.kind == coreir.BodyOpFieldLoadTag:
        if op.operands.len != 4:
            return false
        let baseSlot = op.operands[0]
        var addressReg = regallocA64OperandReg(table, plan,
                                               action.opIndex, 0)
        if addressReg < 0:
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX17
            if baseSlot >= 0 && baseSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[baseSlot].placeKind ==
                   coreir.BodyPlaceGlobalAddressTag:
                if !regallocA64AppendProjectedSlotDataAddress(
                       recipe, bodyIR, slotDataSymbols,
                       projectionRequired, a64.A64X17, baseSlot):
                    return false
            elif !regallocA64AppendMemoryBaseAddress(
                     recipe.words, bodyIR, localOffsets,
                     a64.A64X17, baseSlot):
                return false
            addressReg = a64.A64X17
        if addressReg < 0:
            return false
        let byteOffset = op.operands[2]
        let byteCount = op.operands[3]
        if byteCount == 1:
            add(recipe.words, Value(a64.A64EncLdrbImm(
                targetReg, addressReg, byteOffset)))
            return true
        if byteCount == 4 || byteCount == 8:
            add(recipe.words, Value(a64.A64EncLdrImm(
                byteCount == 8, targetReg, addressReg,
                int64(byteOffset))))
            return true
        # 整聚合字段读(str/struct >8B,如 for-SEQ 迭代的 24B str 元素):
        # 无法进寄存器,按块从源地址拷进目标槽 home,producer 只写内存。
        if byteCount > 8 && op.target >= 0 &&
           op.target < bodyIR.localSlots.len &&
           op.target < localOffsets.len:
            let aggTargetSlot = bodyIR.localSlots[op.target]
            if (aggTargetSlot.typeKind == coreir.LocalStrTag ||
                aggTargetSlot.typeKind == coreir.LocalAggregateTag) &&
               aggTargetSlot.sizeBytes == byteCount &&
               bodyaccess.BodyIrAccessBaseIsLocalMemory(bodyIR, op.target):
                let aggTargetOffset = localOffsets[op.target]
                recipe.effectMask = recipe.effectMask |
                                    contract.RegallocA64EffectX16
                var aggCopied: int32
                while aggCopied < byteCount:
                    let aggWidth = regallocA64MemoryCopyChunkWidth(
                        byteOffset, aggCopied, byteCount)
                    if !regallocA64AppendLoadFromAddress(
                           recipe.words, a64.A64X16, addressReg,
                           byteOffset + aggCopied, aggWidth):
                        return false
                    if !regallocA64StackImmediateFits(
                           aggTargetOffset + aggCopied, aggWidth):
                        recipe.effectMask = recipe.effectMask |
                                            contract.RegallocA64EffectX17
                    if !regallocA64AppendStore(
                           recipe.words, a64.A64X16,
                           aggTargetOffset + aggCopied, aggWidth):
                        return false
                    aggCopied = aggCopied + aggWidth
                recipe.producerWritesMemoryOnly = true
                return true
        return false
    if op.kind == coreir.BodyOpFieldStoreTag:
        recipe.effectMask = regallocA64RemoveRegEffect(
            recipe.effectMask, targetReg)
        let baseSlot = op.operands[0]
        var resolvedAddressReg: int32 = -1
        if baseSlot >= 0 && baseSlot < bodyIR.localSlots.len &&
           bodyIR.localSlots[baseSlot].placeKind ==
               coreir.BodyPlaceGlobalAddressTag:
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX17
            if !regallocA64AppendProjectedSlotDataAddress(
                   recipe, bodyIR, slotDataSymbols,
                   projectionRequired, a64.A64X17, baseSlot):
                return false
            resolvedAddressReg = a64.A64X17
        if regallocA64OperandReg(
               table, plan, action.opIndex, 0) < 0 ||
           !regallocA64StackImmediateFits(
               op.operands[2], op.operands[3]):
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX17
        if op.operands.len >= 2:
            let valueSlot = op.operands[1]
            if valueSlot >= 0 && valueSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[valueSlot].typeKind ==
                   coreir.LocalF64Tag &&
               regallocA64OperandReg(
                   table, plan, action.opIndex, 1) < 0:
                recipe.effectMask = recipe.effectMask |
                                    contract.RegallocA64EffectX16
        recipe.producerWritesMemoryOnly = true
        return regallocA64AppendFieldStore(
            recipe.words, bodyIR, table, plan, localOffsets,
            action.opIndex, resolvedAddressReg)
    if op.kind == coreir.BodyOpGlobalLoadTag:
        if op.operands.len < 1:
            return false
        let globalSlot = op.operands[0]
        if globalSlot < 0 || globalSlot >= bodyIR.localSlots.len:
            return false
        if !regallocA64AppendProjectedSlotDataAddress(
               recipe, bodyIR, slotDataSymbols,
               projectionRequired, a64.A64X17, globalSlot):
            return false
        let width = regallocA64SlotWidth(bodyIR, op.target)
        if width != 4 && width != 8:
            return false
        add(recipe.words, Value(a64.A64EncLdrImm(
            width == 8, targetReg, a64.A64X17, int64(0))))
        return true
    if op.kind == coreir.BodyOpStrEqLiteralTag:
        return regallocA64AppendStrEqLiteral(
            recipe, bodyIR, cstringDataSymbols,
            projectionRequired, localOffsets, targetReg, op)
    if op.kind == coreir.BodyOpStrEqTag:
        return regallocA64AppendStrEq(
            recipe, bodyIR, localOffsets, targetReg, op)
    if op.kind == coreir.BodyOpGlobalStoreTag ||
       op.kind == coreir.BodyOpResultPanicGuardTag:
        return false
    return false

fn regallocA64AppendAggregateCopy(words: var int32[],
                                  sourceOffset: int32,
                                  targetReg: int32,
                                  byteCount: int32): bool =
    if sourceOffset < 0 || targetReg < 0 || byteCount <= 0:
        return false
    var copied: int32
    while copied < byteCount:
        var width = 1
        if byteCount - copied >= 8 && copied % 8 == 0:
            width = 8
        elif byteCount - copied >= 4 && copied % 4 == 0:
            width = 4
        if !regallocA64AppendLoad(words, a64.A64X16,
                                  sourceOffset + copied, width):
            return false
        if width == 1:
            add(words, Value(a64.A64EncStrbImm(
                a64.A64X16, targetReg, copied)))
        else:
            add(words, Value(a64.A64EncStrImm(
                width == 8, a64.A64X16, targetReg,
                int64(copied))))
        copied = copied + width
    return true

fn regallocA64AppendAggregateCopyFromReg(
        words: var int32[],
        sourceReg: int32,
        targetReg: int32,
        byteCount: int32): bool =
    if sourceReg < 0 || targetReg < 0 || sourceReg == targetReg ||
       byteCount <= 0:
        return false
    var sourceBase = sourceReg
    var targetBase = targetReg
    var remaining = byteCount
    while remaining > 0:
        var chunk = remaining
        if chunk > 4095:
            chunk = 4095
        for byteIndex in 0..<chunk:
            add(words, Value(a64.A64EncLdrbImm(
                a64.A64X16, sourceBase, byteIndex)))
            add(words, Value(a64.A64EncStrbImm(
                a64.A64X16, targetBase, byteIndex)))
        remaining = remaining - chunk
        if remaining > 0:
            add(words, Value(a64.A64EncAddImm(
                true, sourceBase, sourceBase, chunk)))
            add(words, Value(a64.A64EncAddImm(
                true, targetBase, targetBase, chunk)))
    return true

@borrows
fn regallocA64CallOutgoingFrame(
        table: var bodyaccess.BodyIrAccessTable,
        callOrdinal: int32): int32 =
    if callOrdinal < 0 || callOrdinal >= table.callFactStarts.len:
        return -1
    let start = table.callFactStarts[callOrdinal]
    let count = table.callFactCounts[callOrdinal]
    if start < 0 || count <= 0 || start > table.facts.len - count:
        return -1
    var frameBytes: int32
    for factIndex in start..<(start + count):
        let fact = table.facts[factIndex]
        if fact.fixedKind == bodyaccess.BodyIrAccessFixedCallArg &&
           fact.outgoingStackFrameBytes > frameBytes:
            frameBytes = fact.outgoingStackFrameBytes
    return frameBytes

@borrows
fn regallocA64CallResultIsF64(bodyIR: var coreir.BodyIR,
                              call: coreir.CallOp): bool =
    return call.resultSlot >= 0 &&
           call.resultSlot < bodyIR.localSlots.len &&
           bodyIR.localSlots[call.resultSlot].typeKind ==
               coreir.LocalF64Tag

@borrows
fn regallocA64CallHasUnsupportedF64CAbi(
        bodyIR: var coreir.BodyIR,
        call: coreir.CallOp): bool =
    if !call.targetIsImportc:
        return false
    for argIndex in 0..<call.argSlots.len:
        let slotIndex = call.argSlots[argIndex]
        if slotIndex >= 0 && slotIndex < bodyIR.localSlots.len &&
           bodyIR.localSlots[slotIndex].typeKind == coreir.LocalF64Tag:
            return true
    return regallocA64CallResultIsF64(bodyIR, call)

@borrows
fn regallocA64SretForwardActionValid(
        plan: var alloc.RegallocSinglePassValuePlan,
        callOrdinal: int32): bool =
    var matchCount: int32
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.kind != alloc.RegallocValueActionSretForward:
            continue
        if action.callOrdinal != callOrdinal ||
           action.fixedKind != bodyaccess.BodyIrAccessFixedSretForward ||
           action.passKind != coreir.BodyCallPassForwardEntrySretTag ||
           action.semanticRegister != plan.constraints.fixedSretReg ||
           alloc.RegallocSinglePassValueActionBindingKind(action.kind) !=
               alloc.RegallocValueBindingStructural:
            return false
        matchCount = matchCount + 1
    return matchCount == 1

@borrows
fn regallocA64CallArgTypeIs(bodyIR: var coreir.BodyIR,
                            call: coreir.CallOp,
                            argIndex: int32,
                            typeKind: int32): bool =
    if argIndex < 0 || argIndex >= call.argSlots.len:
        return false
    let slotIndex = call.argSlots[argIndex]
    return slotIndex >= 0 && slotIndex < bodyIR.localSlots.len &&
           bodyIR.localSlots[slotIndex].typeKind == typeKind

@borrows
fn RegallocA64EntryAbiSupported(bodyIR: var coreir.BodyIR): bool =
    if !bodyIR.entryIsCAbi:
        return true
    # AAPCS64 f64 return already leaves through D0.  Incoming f64 requires the
    # independent NSRN/D register bank; the frozen action schema only proves
    # positional X-register ingress, so reject that exact export surface.
    for slotIndex in 0..<bodyIR.localSlots.len:
        if bodyIR.localSlots[slotIndex].stackOffset < 0 &&
           bodyIR.localSlots[slotIndex].typeKind == coreir.LocalF64Tag:
            return false
    return true

@borrows
fn regallocA64AppendCall(recipe: var contract.RegallocA64ActionRecipe,
                         bodyIR: var coreir.BodyIR,
                         table: var bodyaccess.BodyIrAccessTable,
                         plan: var alloc.RegallocSinglePassValuePlan,
                         action: alloc.RegallocValueAction): bool =
    if action.opIndex < 0 || action.opIndex >= bodyIR.ops.len ||
       action.callOrdinal < 0 ||
       action.callOrdinal >= bodyIR.callSequence.len:
        return false
    let op = bodyIR.ops[action.opIndex]
    if op.kind != coreir.BodyOpCallTag &&
       op.kind != coreir.BodyOpResultPanicGuardTag:
        return false
    let call = bodyIR.callSequence[action.callOrdinal]
    let outgoingFrame = regallocA64CallOutgoingFrame(
        table, action.callOrdinal)
    if outgoingFrame < 0:
        return false
    recipe.producerOpKind = op.kind
    recipe.ownsBodyOp = true
    recipe.ownsCall = true
    if call.resultPassKind ==
           coreir.BodyCallPassForwardEntrySretTag &&
       call.targetSymbol != "cheng_call_ptr_sret_agg1_raw":
        return false
    if call.targetSymbol == "cheng_call_ptr_sret_agg1_raw":
        recipe.effectMask = recipe.effectMask |
                            contract.RegallocA64EffectX16
        if !bodyIR.entryIsCAbi || call.argSlots.len != 2 ||
           call.argPassKinds.len != 2 ||
           call.argPassKinds[0] !=
               coreir.BodyCallPassStackValueTag ||
           call.argPassKinds[1] !=
               coreir.BodyCallPassStackValueTag ||
           !regallocA64CallArgTypeIs(
               bodyIR, call, 0, coreir.LocalPtrTag) ||
           !regallocA64CallArgTypeIs(
               bodyIR, call, 1, coreir.LocalPtrTag) ||
           call.resultSlot >= 0 ||
           call.resultPassKind !=
               coreir.BodyCallPassForwardEntrySretTag ||
           !regallocA64SretForwardActionValid(
               plan, action.callOrdinal) ||
           !regallocA64AppendMove(recipe.words, a64.A64X16,
                                  a64.A64X0, true) ||
           !regallocA64AppendMove(recipe.words, a64.A64X0,
                                  a64.A64X1, true):
            return false
        # x8 is deliberately not written here.  Its exact forward obligation
        # is carried by BodyCallPassForwardEntrySretTag ->
        # BodyIrAccessFixedSretForward -> RegallocValueActionSretForward and
        # is therefore frozen into the production receipt.
        add(recipe.words, a64.A64EncBlr(a64.A64X16))
        return regallocA64AppendSpAdjust(
            recipe.words, outgoingFrame, false)
    if call.targetSymbol == "cheng_call_ptr_i32_raw":
        recipe.effectMask = recipe.effectMask |
                            contract.RegallocA64EffectX16
        if call.argSlots.len != 4 || call.argPassKinds.len != 4 ||
           call.argPassKinds[0] !=
               coreir.BodyCallPassStackValueTag ||
           call.argPassKinds[1] !=
               coreir.BodyCallPassStackValueTag ||
           call.argPassKinds[2] !=
               coreir.BodyCallPassStackValueTag ||
           call.argPassKinds[3] !=
               coreir.BodyCallPassStackValueTag ||
           !regallocA64CallArgTypeIs(
               bodyIR, call, 0, coreir.LocalPtrTag) ||
           !regallocA64CallArgTypeIs(
               bodyIR, call, 1, coreir.LocalI64Tag) ||
           !regallocA64CallArgTypeIs(
               bodyIR, call, 2, coreir.LocalI32Tag) ||
           !regallocA64CallArgTypeIs(
               bodyIR, call, 3, coreir.LocalI32Tag) ||
           call.resultSlot < 0 ||
           call.resultSlot >= bodyIR.localSlots.len ||
           bodyIR.localSlots[call.resultSlot].typeKind !=
               coreir.LocalI32Tag ||
           call.resultPassKind != coreir.BodyCallPassStackValueTag:
            return false
        if !regallocA64AppendMove(recipe.words, a64.A64X16,
                                  a64.A64X0, true) ||
           !regallocA64AppendMove(recipe.words, a64.A64X0,
                                  a64.A64X1, true) ||
           !regallocA64AppendMove(recipe.words, a64.A64X1,
                                  a64.A64X2, false) ||
           !regallocA64AppendMove(recipe.words, a64.A64X2,
                                  a64.A64X3, false):
            return false
        add(recipe.words, a64.A64EncBlr(a64.A64X16))
        return regallocA64AppendSpAdjust(
            recipe.words, outgoingFrame, false)
    if call.targetSymbol == "cheng_call_ptr_void_raw":
        recipe.effectMask = recipe.effectMask |
                            contract.RegallocA64EffectX16
        if call.argSlots.len != 2 || call.argPassKinds.len != 2 ||
           call.argPassKinds[0] !=
               coreir.BodyCallPassStackValueTag ||
           call.argPassKinds[1] !=
               coreir.BodyCallPassStackValueTag ||
           !regallocA64CallArgTypeIs(
               bodyIR, call, 0, coreir.LocalPtrTag) ||
           !regallocA64CallArgTypeIs(
               bodyIR, call, 1, coreir.LocalPtrTag) ||
           call.resultSlot >= 0 ||
           call.resultPassKind != coreir.BodyCallPassStackValueTag ||
           !regallocA64AppendMove(recipe.words, a64.A64X16,
                                  a64.A64X0, true) ||
           !regallocA64AppendMove(recipe.words, a64.A64X0,
                                  a64.A64X1, true):
            return false
        add(recipe.words, a64.A64EncBlr(a64.A64X16))
        return regallocA64AppendSpAdjust(
            recipe.words, outgoingFrame, false)
    if len(call.targetSymbol) <= 0:
        return false
    if bodyIR.callTargetDomainKinds.len != bodyIR.callSequence.len ||
       bodyIR.callTargetRows.len != bodyIR.callSequence.len ||
       bodyIR.callTargetInterfaceCids.len != bodyIR.callSequence.len ||
       bodyIR.callTargetDomainKinds[action.callOrdinal] < 0 ||
       bodyIR.callTargetRows[action.callOrdinal] < 0 ||
       !coreir.BodyIRTypeArenaArtifactCidValid(
           bodyIR.callTargetInterfaceCids[action.callOrdinal]):
        return false
    if op.kind == coreir.BodyOpResultPanicGuardTag:
        let condReg = regallocA64OperandReg(table, plan,
                                            action.opIndex, 0)
        if condReg < 0:
            return false
        add(recipe.words, Value(a64.A64EncCbnz(false,
                                               condReg,
                                               int64(2))))
    let wordIndex = recipe.words.len
    add(recipe.words, a64.A64EncBlPlaceholder())
    var reloc: contract.RegallocA64ActionReloc
    reloc.kind = contract.RegallocA64RelocCall26
    reloc.wordIndex = wordIndex
    reloc.byteOffset = wordIndex * 4
    reloc.callOrdinal = action.callOrdinal
    reloc.opIndex = action.opIndex
    reloc.subIndex = -1
    reloc.targetDomain =
        bodyIR.callTargetDomainKinds[action.callOrdinal]
    reloc.targetRow = bodyIR.callTargetRows[action.callOrdinal]
    reloc.targetInterfaceCid = layout.FixedBytes32Copy(
        bodyIR.callTargetInterfaceCids[action.callOrdinal])
    reloc.targetSymbol = strings.CloneStr(call.targetSymbol)
    add(recipe.relocs, share(reloc))
    if regallocA64CallResultIsF64(bodyIR, call):
        # Every f64-returning callee publishes the physical result in D0.
        # The value plan stores scalar results from its fixed GPR X0, so bridge
        # the raw payload before StoreFixedResult consumes it.
        add(recipe.words, a64.A64EncFmovXd(a64.A64X0, 0))
    return regallocA64AppendSpAdjust(
        recipe.words, outgoingFrame, false)

@borrows
fn regallocA64RecipeWordsValid(recipe: var contract.RegallocA64ActionRecipe): bool =
    for wordIndex in 0..<recipe.words.len:
        if recipe.words[wordIndex] == 0 ||
           recipe.words[wordIndex] == a64.A64EncNop():
            return false
    for relocIndex in 0..<recipe.relocs.len:
        let reloc = recipe.relocs[relocIndex]
        if reloc.wordIndex < 0 || reloc.wordIndex >= recipe.words.len ||
           reloc.byteOffset != reloc.wordIndex * 4 ||
           len(reloc.targetSymbol) <= 0:
            return false
    return true

@borrows
fn regallocA64SiteRecipeWordsValid(
        recipe: var contract.RegallocA64SiteRecipe): bool =
    for wordIndex in 0..<recipe.words.len:
        if recipe.words[wordIndex] == 0 ||
           recipe.words[wordIndex] == a64.A64EncNop():
            return false
    for relocIndex in 0..<recipe.relocs.len:
        let reloc = recipe.relocs[relocIndex]
        if reloc.wordIndex < 0 || reloc.wordIndex >= recipe.words.len ||
           reloc.byteOffset != reloc.wordIndex * 4 ||
           len(reloc.targetSymbol) <= 0:
            return false
    return recipe.branchWordIndices.len ==
               recipe.branchTargetBlocks.len &&
           recipe.branchWordIndices.len ==
               recipe.branchConditionCodes.len

@borrows
fn regallocA64OpHasDefinition(table: var bodyaccess.BodyIrAccessTable,
                              opIndex: int32): bool =
    if opIndex < 0 || opIndex >= table.opFactStarts.len:
        return false
    let start = table.opFactStarts[opIndex]
    let count = table.opFactCounts[opIndex]
    if start < 0 || count < 0 || start > table.facts.len - count:
        return false
    for factIndex in start..<(start + count):
        if table.facts[factIndex].kind == bodyaccess.BodyIrAccessFactDef:
            return true
    return false

@borrows
fn regallocA64AppendRecipeWords(words: var int32[],
                                source: var int32[]) =
    for wordIndex in 0..<source.len:
        add(words, source[wordIndex])

@borrows
fn regallocA64BuildOpRecipe(
        bodyIR: var coreir.BodyIR,
        slotDataSymbols: var str[],
        projectionRequired: bool,
        table: var bodyaccess.BodyIrAccessTable,
        plan: var alloc.RegallocSinglePassValuePlan,
        localOffsets: var int32[],
        epilogueWords: var int32[],
        opIndex: int32,
        blockIndex: int32): contract.RegallocA64SiteRecipe =
    var recipe: contract.RegallocA64SiteRecipe
    recipe.valid = true
    recipe.siteKind = bodyaccess.BodyIrAccessSiteOp
    recipe.siteIndex = opIndex
    recipe.blockIndex = blockIndex
    recipe.reachable = true
    if opIndex < 0 || opIndex >= bodyIR.ops.len:
        regallocA64SiteFail(recipe, contract.RegallocA64RecipeErrorBody,
                           opIndex)
        return recipe
    let op = bodyIR.ops[opIndex]
    recipe.irKind = op.kind
    if regallocA64OpHasDefinition(table, opIndex) ||
       op.kind == coreir.BodyOpCallTag ||
       op.kind == coreir.BodyOpResultPanicGuardTag:
        recipe.ownedByAction = true
        return recipe
    var ok: bool
    if (op.kind == coreir.BodyOpLoadLocalTag ||
        op.kind == coreir.BodyOpStoreLocalTag ||
        op.kind == coreir.BodyOpCopyLocalTag) &&
       op.operands.len == 1 &&
       op.target >= 0 && op.target < bodyIR.localSlots.len &&
       op.operands[0] >= 0 &&
       op.operands[0] < bodyIR.localSlots.len &&
       bodyIR.localSlots[op.target].typeKind == coreir.LocalPtrTag &&
       (bodyIR.localSlots[op.target].auxValue == coreir.LocalI32Tag ||
        bodyIR.localSlots[op.target].auxValue == coreir.LocalI64Tag ||
        bodyIR.localSlots[op.target].auxValue == coreir.LocalStrTag):
        let sourceReg = regallocA64OperandReg(
            table, plan, opIndex, 0)
        let targetAddressReg = regallocA64OperandReg(
            table, plan, opIndex, bodyaccess.BodyIrAccessNoIndex)
        let sourceType = bodyIR.localSlots[op.operands[0]].typeKind
        let targetType = bodyIR.localSlots[op.target].auxValue
        if targetAddressReg >= 0:
            if sourceReg >= 0 &&
               targetType == coreir.LocalI32Tag &&
               sourceType == coreir.LocalI32Tag:
                add(recipe.words, Value(a64.A64EncStrImm(
                    false, sourceReg, targetAddressReg, int64(0))))
                ok = true
            elif sourceReg >= 0 &&
                 targetType == coreir.LocalI64Tag &&
                 sourceType == coreir.LocalI32Tag:
                recipe.effectMask = recipe.effectMask |
                                    contract.RegallocA64EffectX17
                add(recipe.words, a64.A64EncSxtw(
                    a64.A64X17, sourceReg))
                add(recipe.words, Value(a64.A64EncStrImm(
                    true, a64.A64X17, targetAddressReg, int64(0))))
                ok = true
            elif sourceReg >= 0 &&
                 targetType == coreir.LocalI64Tag &&
                 (sourceType == coreir.LocalI64Tag ||
                  sourceType == coreir.LocalPtrTag):
                add(recipe.words, Value(a64.A64EncStrImm(
                    true, sourceReg, targetAddressReg, int64(0))))
                ok = true
            elif targetType == coreir.LocalStrTag &&
                 sourceType == coreir.LocalStrTag &&
                 op.operands[0] < localOffsets.len:
                recipe.effectMask = recipe.effectMask |
                                    contract.RegallocA64EffectX16
                let sourceOffset = localOffsets[op.operands[0]]
                ok = regallocA64AppendAggregateCopy(
                    recipe.words, sourceOffset, targetAddressReg,
                    bodyIR.localSlots[op.operands[0]].sizeBytes)
    elif op.kind == coreir.BodyOpIndexedStoreTag:
        let baseSlot = op.operands[0]
        var resolvedAddressReg: int32 = -1
        var addressReady = true
        if baseSlot >= 0 && baseSlot < bodyIR.localSlots.len &&
           bodyIR.localSlots[baseSlot].placeKind ==
               coreir.BodyPlaceGlobalAddressTag:
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX17
            addressReady =
                regallocA64AppendProjectedSiteSlotDataAddress(
                    recipe, bodyIR, slotDataSymbols,
                    projectionRequired, a64.A64X17, baseSlot)
            resolvedAddressReg = a64.A64X17
        if op.operands.len >= 4:
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX16 |
                                contract.RegallocA64EffectX17
        elif regallocA64OperandReg(table, plan, opIndex, 0) < 0:
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX17
        if op.operands.len >= 2:
            let valueSlot = op.operands[1]
            if valueSlot >= 0 && valueSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[valueSlot].typeKind ==
                   coreir.LocalF64Tag &&
               regallocA64OperandReg(table, plan, opIndex, 1) < 0:
                recipe.effectMask = recipe.effectMask |
                                    contract.RegallocA64EffectX16
        ok = addressReady && regallocA64AppendIndexedStore(
            recipe.words, bodyIR, table, plan, localOffsets,
            opIndex, resolvedAddressReg)
    elif op.kind == coreir.BodyOpFieldStoreTag:
        let baseSlot = op.operands[0]
        var resolvedAddressReg: int32 = -1
        var addressReady = true
        if baseSlot >= 0 && baseSlot < bodyIR.localSlots.len &&
           bodyIR.localSlots[baseSlot].placeKind ==
               coreir.BodyPlaceGlobalAddressTag:
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX17
            addressReady =
                regallocA64AppendProjectedSiteSlotDataAddress(
                    recipe, bodyIR, slotDataSymbols,
                    projectionRequired, a64.A64X17, baseSlot)
            resolvedAddressReg = a64.A64X17
        if regallocA64OperandReg(table, plan, opIndex, 0) < 0 ||
           !regallocA64StackImmediateFits(
               op.operands[2], op.operands[3]):
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX17
        if op.operands.len >= 2:
            let valueSlot = op.operands[1]
            if valueSlot >= 0 && valueSlot < bodyIR.localSlots.len &&
               bodyIR.localSlots[valueSlot].typeKind ==
                   coreir.LocalF64Tag &&
               regallocA64OperandReg(table, plan, opIndex, 1) < 0:
                recipe.effectMask = recipe.effectMask |
                                    contract.RegallocA64EffectX16
        ok = addressReady && regallocA64AppendFieldStore(
            recipe.words, bodyIR, table, plan, localOffsets,
            opIndex, resolvedAddressReg)
    elif op.kind == coreir.BodyOpGlobalStoreTag:
        recipe.effectMask = recipe.effectMask |
                            contract.RegallocA64EffectX17
        if op.operands.len == 1 && op.target >= 0 &&
           op.target < bodyIR.localSlots.len:
            let globalSlot = op.operands[0]
            var sourceReg = regallocA64OperandReg(
                table, plan, opIndex, bodyaccess.BodyIrAccessNoIndex)
            if sourceReg < 0 &&
               bodyIR.localSlots[op.target].typeKind ==
                   coreir.LocalF64Tag:
                sourceReg = regallocA64OperandRegOrF64Stack(
                    recipe.words, bodyIR, table, plan, localOffsets,
                    opIndex, bodyaccess.BodyIrAccessNoIndex,
                    op.target, a64.A64X16)
                recipe.effectMask = recipe.effectMask |
                                    contract.RegallocA64EffectX16
            if globalSlot >= 0 && globalSlot < bodyIR.localSlots.len &&
               sourceReg >= 0:
                if regallocA64AppendProjectedSiteSlotDataAddress(
                       recipe, bodyIR, slotDataSymbols,
                       projectionRequired, a64.A64X17, globalSlot):
                    ok = regallocA64AppendStoreToAddress(
                        recipe.words, sourceReg, a64.A64X17, 0,
                        regallocA64SlotWidth(bodyIR, op.target))
    elif op.kind == coreir.BodyOpBranchTag:
        if (op.operands.len == 3 || op.operands.len == 4) &&
           op.operands[1] >= 0 &&
           op.operands[1] < bodyIR.localSlots.len:
            let guardReg = regallocA64OperandReg(
                table, plan, opIndex, 1)
            let subKind = op.operands[0]
            if guardReg >= 0 &&
               (subKind ==
                    coreir.BodyBranchIfLocalNilReturnI32ConstTag ||
                subKind ==
                    coreir.BodyBranchIfLocalLeZeroReturnI32ConstTag):
                var constOp: coreir.BodyOp
                constOp.kind = coreir.BodyOpLoadConstTag
                add(constOp.operands, coreir.LocalI32Tag)
                add(constOp.operands, op.operands[2])
                if subKind ==
                   coreir.BodyBranchIfLocalNilReturnI32ConstTag:
                    regallocA64AppendWrittenReg(
                        recipe.writtenRegs, a64.A64X0)
                    regallocA64AppendFrameRestoreWrittenRegs(
                        plan, recipe.writtenRegs)
                    let branchPos = recipe.words.len
                    add(recipe.words, a64.A64EncBPlaceholder())
                    ok = regallocA64AppendImmediate(
                        recipe.words, a64.A64X0, constOp)
                    if ok:
                        regallocA64AppendRecipeWords(
                            recipe.words, epilogueWords)
                        let branchDistance = recipe.words.len - branchPos
                        recipe.words[branchPos] = Value(a64.A64EncCbnz(
                            bodyIR.localSlots[op.operands[1]].typeKind !=
                                coreir.LocalI32Tag,
                            guardReg,
                            int64(branchDistance)))
                        add(recipe.branchWordIndices, branchPos)
                        add(recipe.branchTargetBlocks, -1)
                        add(recipe.branchConditionCodes,
                            a64.A64CondNE)
                else:
                    regallocA64AppendWrittenReg(
                        recipe.writtenRegs, a64.A64X0)
                    regallocA64AppendFrameRestoreWrittenRegs(
                        plan, recipe.writtenRegs)
                    add(recipe.words, Value(a64.A64EncCmpImm(
                        false, guardReg, 0)))
                    let branchPos = recipe.words.len
                    add(recipe.words, a64.A64EncBPlaceholder())
                    ok = regallocA64AppendImmediate(
                        recipe.words, a64.A64X0, constOp)
                    if ok:
                        regallocA64AppendRecipeWords(
                            recipe.words, epilogueWords)
                        let branchDistance = recipe.words.len - branchPos
                        recipe.words[branchPos] = Value(a64.A64EncBCond(
                            int64(branchDistance),
                            a64.A64CondGT))
                        add(recipe.branchWordIndices, branchPos)
                        add(recipe.branchTargetBlocks, -1)
                        add(recipe.branchConditionCodes,
                            a64.A64CondGT)
    elif op.kind == coreir.BodyOpReturnTag:
        regallocA64AppendFrameRestoreWrittenRegs(
            plan, recipe.writtenRegs)
        if op.target >= 0 && op.target < bodyIR.localSlots.len &&
           bodyIR.localSlots[op.target].typeKind ==
               coreir.LocalF64Tag:
            add(recipe.words, a64.A64EncFmovDx(0, a64.A64X0))
        regallocA64AppendRecipeWords(recipe.words, epilogueWords)
        ok = recipe.words.len > 0
    if !ok:
        regallocA64SiteFail(recipe, contract.RegallocA64RecipeErrorProducer,
                           opIndex)
        return recipe
    recipe.machineOwnerKind = contract.RegallocA64SiteOwnerOp
    if recipe.words.len <= 0 || !regallocA64SiteRecipeWordsValid(recipe):
        regallocA64SiteFail(recipe, contract.RegallocA64RecipeErrorEncoding,
                           opIndex)
    let recipeWords = recipe.words
    recipe.effectMask = recipe.effectMask |
                        regallocA64WordsSpMemoryCallEffects(recipeWords)
    regallocA64AppendEffectWrittenRegs(
        recipe.effectMask, recipe.writtenRegs)
    regallocA64SortWrittenRegs(recipe.writtenRegs)
    return recipe

@borrows
fn regallocA64BuildTermRecipe(
        bodyIR: var coreir.BodyIR,
        table: var bodyaccess.BodyIrAccessTable,
        plan: var alloc.RegallocSinglePassValuePlan,
        localOffsets: var int32[],
        epilogueWords: var int32[],
        termIndex: int32,
        blockIndex: int32): contract.RegallocA64SiteRecipe =
    var recipe: contract.RegallocA64SiteRecipe
    recipe.valid = true
    recipe.siteKind = bodyaccess.BodyIrAccessSiteTerm
    recipe.siteIndex = termIndex
    recipe.blockIndex = blockIndex
    recipe.reachable = true
    if termIndex < 0 || termIndex >= bodyIR.terms.len:
        regallocA64SiteFail(recipe, contract.RegallocA64RecipeErrorBody,
                           termIndex)
        return recipe
    let term = bodyIR.terms[termIndex]
    recipe.irKind = term.kind
    if term.kind == coreir.BodyTermReturnTag:
        regallocA64AppendFrameRestoreWrittenRegs(
            plan, recipe.writtenRegs)
        if term.resultSlot >= 0 &&
           term.resultSlot < bodyIR.localSlots.len &&
           bodyIR.localSlots[term.resultSlot].typeKind ==
               coreir.LocalF64Tag:
            # Fixed return actions leave the raw payload in X0. Publish the
            # language-level f64 result in the physical ABI register D0.
            add(recipe.words, a64.A64EncFmovDx(0, a64.A64X0))
        regallocA64AppendRecipeWords(recipe.words, epilogueWords)
    elif term.kind == coreir.BodyTermBrTag:
        add(recipe.branchWordIndices, recipe.words.len)
        add(recipe.branchTargetBlocks, term.trueBlock)
        add(recipe.branchConditionCodes, -1)
        add(recipe.words, a64.A64EncBPlaceholder())
    elif term.kind == coreir.BodyTermCbrTag:
        var lhsSlot = term.resultSlot
        if term.lhsSlot >= 0:
            lhsSlot = term.lhsSlot
        if lhsSlot < 0 || lhsSlot >= bodyIR.localSlots.len:
            regallocA64SiteFail(recipe,
                               contract.RegallocA64RecipeErrorProducer,
                               termIndex)
            return recipe
        let lhsType = bodyIR.localSlots[lhsSlot].typeKind
        let lhsIs64 = lhsType == coreir.LocalI64Tag ||
                      lhsType == coreir.LocalPtrTag
        var lhsReg: int32 = -1
        if lhsType != coreir.LocalF64Tag:
            lhsReg = regallocA64TermOperandReg(
                table, plan, termIndex, 0)
            if lhsReg < 0:
                regallocA64SiteFail(
                    recipe, contract.RegallocA64RecipeErrorProducer,
                    termIndex)
                return recipe
        var cond = regallocA64CondCode(term.conditionKind)
        if term.conditionKind == coreir.BodyCondLocalNonZeroTag:
            cond = a64.A64CondNE
            add(recipe.words, Value(a64.A64EncCmpImm(
                lhsType != coreir.LocalI32Tag, lhsReg, 0)))
        elif term.conditionKind == coreir.BodyCondLocalZeroTag:
            cond = a64.A64CondEQ
            add(recipe.words, Value(a64.A64EncCmpImm(
                lhsType != coreir.LocalI32Tag, lhsReg, 0)))
        elif term.conditionKind >= coreir.BodyCondF64EqTag &&
             term.conditionKind <= coreir.BodyCondF64GeTag:
            if lhsType != coreir.LocalF64Tag || term.rhsSlot < 0 ||
               term.rhsSlot >= bodyIR.localSlots.len ||
               bodyIR.localSlots[term.rhsSlot].typeKind !=
                   coreir.LocalF64Tag:
                regallocA64SiteFail(recipe,
                                   contract.RegallocA64RecipeErrorProducer,
                                   termIndex)
                return recipe
            lhsReg = regallocA64TermOperandRegOrF64Stack(
                recipe.words, bodyIR, table, plan, localOffsets,
                termIndex, 0, lhsSlot, a64.A64X16)
            let rhsReg = regallocA64TermOperandRegOrF64Stack(
                recipe.words, bodyIR, table, plan, localOffsets,
                termIndex, 1, term.rhsSlot, a64.A64X17)
            if lhsReg < 0 || rhsReg < 0:
                regallocA64SiteFail(
                    recipe, contract.RegallocA64RecipeErrorProducer,
                    termIndex)
                return recipe
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX16 |
                                contract.RegallocA64EffectX17
            add(recipe.words, a64.A64EncFmovDx(16, lhsReg))
            add(recipe.words, a64.A64EncFmovDx(17, rhsReg))
            add(recipe.words, a64.A64EncFcmpD(16, 17))
        elif cond >= 0:
            if term.rhsSlot >= 0:
                let rhsReg = regallocA64TermOperandReg(
                    table, plan, termIndex, 1)
                if rhsReg < 0:
                    regallocA64SiteFail(
                        recipe, contract.RegallocA64RecipeErrorProducer,
                        termIndex)
                    return recipe
                add(recipe.words, a64.A64EncCmpReg(
                    lhsIs64, lhsReg, rhsReg))
            else:
                var rhsConst: int32
                if term.operands.len == 1:
                    rhsConst = term.operands[0]
                if rhsConst >= 0 && rhsConst <= 4095:
                    add(recipe.words, Value(a64.A64EncCmpImm(
                        lhsIs64, lhsReg, rhsConst)))
                else:
                    var constOp: coreir.BodyOp
                    constOp.kind = coreir.BodyOpLoadConstTag
                    add(constOp.operands, lhsType)
                    add(constOp.operands, rhsConst)
                    if !regallocA64AppendImmediate(
                           recipe.words, a64.A64X16, constOp):
                        regallocA64SiteFail(
                            recipe, contract.RegallocA64RecipeErrorProducer,
                            termIndex)
                        return recipe
                    recipe.effectMask = recipe.effectMask |
                                        contract.RegallocA64EffectX16
                    add(recipe.words, a64.A64EncCmpReg(
                        lhsIs64, lhsReg, a64.A64X16))
        if cond < 0:
            regallocA64SiteFail(recipe,
                               contract.RegallocA64RecipeErrorProducer,
                               termIndex)
            return recipe
        add(recipe.branchWordIndices, recipe.words.len)
        add(recipe.branchTargetBlocks, term.trueBlock)
        add(recipe.branchConditionCodes, cond)
        add(recipe.words, a64.A64EncBPlaceholder())
        add(recipe.branchWordIndices, recipe.words.len)
        add(recipe.branchTargetBlocks, term.falseBlock)
        add(recipe.branchConditionCodes, -1)
        add(recipe.words, a64.A64EncBPlaceholder())
    else:
        regallocA64SiteFail(recipe, contract.RegallocA64RecipeErrorBody,
                           termIndex)
        return recipe
    recipe.machineOwnerKind = contract.RegallocA64SiteOwnerTerm
    if recipe.words.len <= 0 || !regallocA64SiteRecipeWordsValid(recipe):
        regallocA64SiteFail(recipe, contract.RegallocA64RecipeErrorEncoding,
                           termIndex)
    let recipeWords = recipe.words
    recipe.effectMask = recipe.effectMask |
                        regallocA64WordsSpMemoryCallEffects(recipeWords)
    regallocA64AppendEffectWrittenRegs(
        recipe.effectMask, recipe.writtenRegs)
    regallocA64SortWrittenRegs(recipe.writtenRegs)
    return recipe

@borrows
fn regallocA64BuildRecipe(bodyIR: var coreir.BodyIR,
                          slotDataSymbols: var str[],
                          cstringDataSymbols: var str[],
                          projectionRequired: bool,
                          table: var bodyaccess.BodyIrAccessTable,
                          plan: var alloc.RegallocSinglePassValuePlan,
                          localOffsets: var int32[],
                          returnBufferSaveOffset: int32,
                          action: alloc.RegallocValueAction): contract.RegallocA64ActionRecipe =
    var recipe: contract.RegallocA64ActionRecipe
    recipe.valid = true
    recipe.consumerOrdinal = action.consumerOrdinal
    recipe.actionKind = action.kind
    recipe.bindingKind =
        alloc.RegallocSinglePassValueActionBindingKind(action.kind)
    if recipe.bindingKind == alloc.RegallocValueBindingStructural:
        return recipe
    if recipe.bindingKind != alloc.RegallocValueBindingMachine:
        regallocA64Fail(recipe, contract.RegallocA64RecipeErrorAction,
                       action.kind)
        return recipe
    recipe.effectMask = regallocA64RegEffect(action.sourceReg) |
                        regallocA64RegEffect(action.targetReg) |
                        regallocA64RegEffect(action.scratchReg)
    regallocA64AppendWrittenReg(recipe.writtenRegs, action.targetReg)
    var ok: bool
    var sourceSlot = action.sourceStackSlot
    var targetSlot = action.targetStackSlot
    let valueSlot = regallocA64ValueSlot(plan, action.valueId)
    if sourceSlot < 0 &&
       (action.sourceLocation == alloc.RegallocValueLocationStack ||
        action.sourceLocation == alloc.RegallocValueLocationAddress):
        sourceSlot = valueSlot
    if targetSlot < 0 &&
       action.targetLocation == alloc.RegallocValueLocationStack:
        targetSlot = valueSlot
    if action.kind == alloc.RegallocValueActionEntryReload:
        if action.sourceLocation == alloc.RegallocValueLocationRegister:
            if valueSlot >= 0 && valueSlot < bodyIR.localSlots.len:
                ok = regallocA64AppendMove(
                    recipe.words, action.targetReg, action.sourceReg,
                    regallocA64SlotWidth(bodyIR, valueSlot) == 8)
        elif sourceSlot >= 0 && sourceSlot < localOffsets.len:
            ok = regallocA64AppendLoad(
                recipe.words, action.targetReg,
                localOffsets[sourceSlot],
                regallocA64SlotWidth(bodyIR, sourceSlot))
    elif action.kind == alloc.RegallocValueActionReloadOperand ||
       action.kind == alloc.RegallocValueActionRestoreTemporary ||
       action.kind == alloc.RegallocValueActionReloadCall:
        if sourceSlot >= 0 && sourceSlot < localOffsets.len:
            ok = regallocA64AppendLoad(
                recipe.words, action.targetReg,
                localOffsets[sourceSlot],
                regallocA64SlotWidth(bodyIR, sourceSlot))
    elif action.kind == alloc.RegallocValueActionSpillTemporary ||
         action.kind == alloc.RegallocValueActionSpillCall:
        if targetSlot >= 0 && targetSlot < localOffsets.len:
            let spillWidth = regallocA64SlotWidth(bodyIR, targetSlot)
            if !regallocA64StackImmediateFits(
                   localOffsets[targetSlot], spillWidth):
                recipe.effectMask = recipe.effectMask |
                                    contract.RegallocA64EffectX17
            ok = regallocA64AppendStore(
                recipe.words, action.sourceReg,
                localOffsets[targetSlot],
                spillWidth)
    elif action.kind == alloc.RegallocValueActionBindDef ||
         action.kind == alloc.RegallocValueActionStoreDef ||
         action.kind == alloc.RegallocValueActionStoreHome:
        var producerReg = action.targetReg
        if action.kind == alloc.RegallocValueActionStoreDef ||
           action.kind == alloc.RegallocValueActionStoreHome:
            producerReg = a64.A64X16
        ok = regallocA64AppendProducer(
            recipe, bodyIR, slotDataSymbols,
            cstringDataSymbols, projectionRequired,
            table, plan, localOffsets, action, producerReg)
        if ok && !recipe.producerWritesMemoryOnly &&
           (action.kind == alloc.RegallocValueActionStoreDef ||
            action.kind == alloc.RegallocValueActionStoreHome):
            let slot = regallocA64ValueSlot(plan, action.valueId)
            if slot < 0 || slot >= localOffsets.len:
                ok = false
            else:
                let storeWidth = regallocA64SlotWidth(bodyIR, slot)
                if !regallocA64StackImmediateFits(
                       localOffsets[slot], storeWidth):
                    recipe.effectMask = recipe.effectMask |
                                        contract.RegallocA64EffectX17
                ok = regallocA64AppendStore(
                    recipe.words, producerReg, localOffsets[slot],
                    storeWidth)
    elif action.kind == alloc.RegallocValueActionMoveFixed ||
         action.kind == alloc.RegallocValueActionBindFixedResult:
        let slot = regallocA64ValueSlot(plan, action.valueId)
        ok = regallocA64AppendMove(
            recipe.words, action.targetReg, action.sourceReg,
            regallocA64SlotWidth(bodyIR, slot) == 8)
    elif action.kind == alloc.RegallocValueActionLoadFixed:
        if action.sourceLocation == alloc.RegallocValueLocationConstant:
            if coreir.CallArgSlotIsCString(action.encodedValue):
                let literalId =
                    coreir.CallArgSlotCStringId(action.encodedValue)
                if literalId >= 0 &&
                   literalId < bodyIR.cstringLiterals.len:
                    ok = regallocA64AppendProjectedCStringDataAddress(
                        recipe, bodyIR, cstringDataSymbols,
                        projectionRequired, action.targetReg,
                        literalId)
            elif coreir.CallArgSlotIsAddress(action.encodedValue):
                # [wall138] 只写目的实参（setMem dst 形）在 body_ir_access
                # decode 侧（bodyIrAccessDecodeCallArg writeOnlyAddress 臂）
                # 按契约发成 FixedCallArg Fixed fact，encodedValue 携带
                # CallArgSlotAddress 编码槽。该编码值是槽地址的编码表示，
                # 不是算术常量：直接 Immediate 物化会把 tag|槽号位型当裸
                # 指针喂给被调桥（cold_nested_fmt_interpolation_smoke
                # 实证 w0=0x80000673=CallArgSlotAddress(3) 位型，死点
                # str w0,[x1] SIGSEGV）。此处按同一编码空间精确解码：
                # 局部槽 add reg,sp,#off，全局槽 data-symbol adrp+add，
                # 与 AddressFixed/StoreStackArg-Address 臂同一物化契约。
                # 解码失败即 recipe 失败（下方 !ok 统一 SiteFail），
                # 不回落、不兜底。
                let addressSlot = coreir.CallArgSlotAddressId(
                    action.encodedValue)
                if addressSlot < 0:
                    ok = false
                else:
                    ok = regallocA64AppendSlotAddress(
                        recipe, bodyIR, slotDataSymbols,
                        projectionRequired, localOffsets,
                        action.targetReg, addressSlot, 0)
            else:
                var constOp: coreir.BodyOp
                constOp.kind = coreir.BodyOpLoadConstTag
                constOp.target = -1
                add(constOp.operands, coreir.LocalI32Tag)
                let ordinal =
                    coreir.CallArgSlotConstOrdinal(action.encodedValue)
                if ordinal == 1:
                    add(constOp.operands, 1)
                elif ordinal == 2 || ordinal == 3:
                    add(constOp.operands, 0)
                else:
                    add(constOp.operands, action.encodedValue)
                ok = regallocA64AppendImmediate(
                    recipe.words, action.targetReg, constOp)
        elif sourceSlot >= 0 && sourceSlot < localOffsets.len:
            var loadWidth = action.abiSizeBytes
            if loadWidth <= 0:
                loadWidth = regallocA64SlotWidth(bodyIR, sourceSlot)
            ok = regallocA64AppendLoad(
                recipe.words, action.targetReg,
                localOffsets[sourceSlot],
                loadWidth)
    elif action.kind == alloc.RegallocValueActionAddressFixed:
        var slot = sourceSlot
        if slot < 0:
            slot = action.encodedValue
        ok = regallocA64AppendSlotAddress(
            recipe, bodyIR, slotDataSymbols,
            projectionRequired, localOffsets,
            action.targetReg, slot, 0)
    elif action.kind == alloc.RegallocValueActionStoreFixedResult:
        if targetSlot >= 0 && targetSlot < localOffsets.len:
            let storeWidth = regallocA64SlotWidth(bodyIR, targetSlot)
            if !regallocA64StackImmediateFits(
                   localOffsets[targetSlot], storeWidth):
                recipe.effectMask = recipe.effectMask |
                                    contract.RegallocA64EffectX17
            ok = regallocA64AppendStore(
                recipe.words, action.sourceReg,
                localOffsets[targetSlot],
                storeWidth)
    elif action.kind == alloc.RegallocValueActionEdgeParallelCopy ||
         action.kind == alloc.RegallocValueActionParallelScratchSave ||
         action.kind == alloc.RegallocValueActionParallelScratchRestore:
        if action.sourceLocation == alloc.RegallocValueLocationRegister &&
           action.targetLocation == alloc.RegallocValueLocationRegister:
            ok = regallocA64AppendMove(recipe.words,
                                       action.targetReg,
                                       action.sourceReg, true)
        elif action.sourceLocation == alloc.RegallocValueLocationRegister &&
             action.targetLocation == alloc.RegallocValueLocationStack &&
             targetSlot >= 0 && targetSlot < localOffsets.len:
            let storeWidth = regallocA64SlotWidth(bodyIR, targetSlot)
            if !regallocA64StackImmediateFits(
                   localOffsets[targetSlot], storeWidth):
                recipe.effectMask = recipe.effectMask |
                                    contract.RegallocA64EffectX17
            ok = regallocA64AppendStore(
                recipe.words, action.sourceReg, localOffsets[targetSlot],
                storeWidth)
        elif action.sourceLocation == alloc.RegallocValueLocationStack &&
             action.targetLocation == alloc.RegallocValueLocationRegister &&
             sourceSlot >= 0 && sourceSlot < localOffsets.len:
            ok = regallocA64AppendLoad(
                recipe.words, action.targetReg, localOffsets[sourceSlot],
                regallocA64SlotWidth(bodyIR, sourceSlot))
    elif action.kind == alloc.RegallocValueActionStoreSretReturn:
        let slot = regallocA64ValueSlot(plan, action.valueId)
        if slot >= 0 && slot < localOffsets.len:
            var copyBytes = action.abiSizeBytes
            if copyBytes <= 0:
                copyBytes = bodyIR.localSlots[slot].sizeBytes
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX16
            ok = regallocA64AppendLoad(
                recipe.words, action.targetReg,
                returnBufferSaveOffset, 8)
            if ok:
                if bodyIR.localSlots[slot].stackOffset < 0 &&
                   (bodyIR.localSlots[slot].typeKind ==
                        coreir.LocalAggregateTag ||
                   bodyIR.localSlots[slot].typeKind ==
                        coreir.LocalStrTag):
                    recipe.effectMask = recipe.effectMask |
                                        contract.RegallocA64EffectX17
                    ok = regallocA64AppendLoad(
                        recipe.words, a64.A64X17,
                        localOffsets[slot], 8)
                    if ok:
                        ok = regallocA64AppendAggregateCopyFromReg(
                            recipe.words, a64.A64X17,
                            action.targetReg, copyBytes)
                else:
                    ok = regallocA64AppendAggregateCopy(
                        recipe.words, localOffsets[slot],
                        action.targetReg, copyBytes)
    elif action.kind == alloc.RegallocValueActionStoreStackArg:
        var sourceReg = action.sourceReg
        if action.outgoingStackArgIndex == 0:
            ok = regallocA64AppendSpAdjust(
                recipe.words, action.outgoingStackFrameBytes, true)
            if action.outgoingStackFrameBytes > 0:
                regallocA64AppendWrittenReg(
                    recipe.writtenRegs, a64.A64SP)
        else:
            ok = action.outgoingStackArgIndex > 0
        if action.sourceLocation == alloc.RegallocValueLocationStack &&
           sourceSlot >= 0 && sourceSlot < localOffsets.len:
            sourceReg = a64.A64X16
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX16
            ok = ok && regallocA64AppendLoad(
                recipe.words, sourceReg,
                localOffsets[sourceSlot] +
                    action.outgoingStackFrameBytes,
                action.outgoingStackByteWidth)
        elif action.sourceLocation == alloc.RegallocValueLocationRegister:
            ok = ok && sourceReg >= 0
        elif action.sourceLocation == alloc.RegallocValueLocationConstant:
            sourceReg = a64.A64X16
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX16
            if coreir.CallArgSlotIsCString(action.encodedValue):
                let literalId =
                    coreir.CallArgSlotCStringId(action.encodedValue)
                ok = ok && literalId >= 0 &&
                     literalId < bodyIR.cstringLiterals.len
                if ok:
                    ok = regallocA64AppendProjectedCStringDataAddress(
                        recipe, bodyIR, cstringDataSymbols,
                        projectionRequired, sourceReg, literalId)
            elif coreir.CallArgSlotIsAddress(action.encodedValue):
                # [wall138] 与 LoadFixed/Constant 臂同一编码空间契约：
                # 地址通道实参（CallArgSlotAddress 编码槽）按槽地址物化，
                # 严禁编码位型当算术常量装载。spBias=出栈帧字节数。
                let addressSlot = coreir.CallArgSlotAddressId(
                    action.encodedValue)
                if addressSlot < 0:
                    ok = false
                else:
                    ok = ok && regallocA64AppendSlotAddress(
                        recipe, bodyIR, slotDataSymbols,
                        projectionRequired, localOffsets, sourceReg,
                        addressSlot, action.outgoingStackFrameBytes)
            else:
                var constOp: coreir.BodyOp
                constOp.kind = coreir.BodyOpLoadConstTag
                add(constOp.operands, coreir.LocalI32Tag)
                let ordinal =
                    coreir.CallArgSlotConstOrdinal(action.encodedValue)
                if ordinal == 1:
                    add(constOp.operands, 1)
                elif ordinal == 2 || ordinal == 3:
                    add(constOp.operands, 0)
                else:
                    add(constOp.operands, action.encodedValue)
                ok = ok && regallocA64AppendImmediate(
                    recipe.words, sourceReg, constOp)
        elif action.sourceLocation == alloc.RegallocValueLocationAddress:
            sourceReg = a64.A64X16
            recipe.effectMask = recipe.effectMask |
                                contract.RegallocA64EffectX16
            ok = ok && regallocA64AppendSlotAddress(
                recipe, bodyIR, slotDataSymbols,
                projectionRequired, localOffsets, sourceReg,
                action.encodedValue,
                action.outgoingStackFrameBytes)
        if ok:
            if !regallocA64StackImmediateFits(
                   action.outgoingStackByteOffset,
                   action.outgoingStackByteWidth):
                recipe.effectMask = recipe.effectMask |
                                    contract.RegallocA64EffectX17
            ok = regallocA64AppendStore(
                recipe.words, sourceReg,
                action.outgoingStackByteOffset,
                action.outgoingStackByteWidth)
    elif action.kind == alloc.RegallocValueActionCallClobber:
        ok = regallocA64AppendCall(recipe, bodyIR, table, plan, action)
        if action.outgoingStackFrameBytes > 0:
            regallocA64AppendWrittenReg(
                recipe.writtenRegs, a64.A64SP)
    if !ok:
        regallocA64Fail(recipe, contract.RegallocA64RecipeErrorProducer,
                       action.consumerOrdinal)
        return recipe
    if recipe.words.len <= 0 || !regallocA64RecipeWordsValid(recipe):
        regallocA64Fail(recipe, contract.RegallocA64RecipeErrorEncoding,
                       action.consumerOrdinal)
    let recipeWords = recipe.words
    recipe.effectMask = recipe.effectMask |
                        regallocA64WordsSpMemoryCallEffects(recipeWords)
    regallocA64AppendEffectWrittenRegs(
        recipe.effectMask, recipe.writtenRegs)
    regallocA64SortWrittenRegs(recipe.writtenRegs)
    return recipe

fn regallocA64IntSeq(count: int32, value: int32): int32[] =
    var out: int32[]
    for index in 0..<count:
        add(out, value)
    return out

@borrows
fn regallocA64FunctionAppendAction(
        out: var contract.RegallocA64FunctionRecipes,
        actionIndex: int32): bool =
    if actionIndex < 0 || actionIndex >= out.recipes.len ||
       actionIndex >= out.actionWordStarts.len ||
       actionIndex >= out.actionWordCounts.len ||
       out.actionWordStarts[actionIndex] >= 0:
        return false
    let recipe = out.recipes[actionIndex]
    if !recipe.valid:
        return false
    let start = out.functionWords.len
    out.actionWordStarts[actionIndex] = start
    out.actionWordCounts[actionIndex] = recipe.words.len
    for wordIndex in 0..<recipe.words.len:
        add(out.functionWords, recipe.words[wordIndex])
    for relocIndex in 0..<recipe.relocs.len:
        # Re-own field-wise: a by-value struct copy aliases the source
        # element's managed targetSymbol, and any assignment through that
        # alias releases the source element's buffer (ORC wrong-owner).
        var reloc: contract.RegallocA64ActionReloc
        reloc.kind = recipe.relocs[relocIndex].kind
        reloc.wordIndex = start + recipe.relocs[relocIndex].wordIndex
        reloc.byteOffset =
            start * 4 + recipe.relocs[relocIndex].byteOffset
        reloc.callOrdinal = recipe.relocs[relocIndex].callOrdinal
        reloc.opIndex = recipe.relocs[relocIndex].opIndex
        reloc.subIndex = recipe.relocs[relocIndex].subIndex
        reloc.targetDomain = recipe.relocs[relocIndex].targetDomain
        reloc.targetRow = recipe.relocs[relocIndex].targetRow
        reloc.targetInterfaceCid = layout.FixedBytes32Copy(
            recipe.relocs[relocIndex].targetInterfaceCid)
        reloc.targetSymbol =
            strings.CloneStr(recipe.relocs[relocIndex].targetSymbol)
        add(out.functionRelocs, share(reloc))
    return true

@borrows
fn regallocA64ActionMatches(action: alloc.RegallocValueAction,
                            placement: int32,
                            blockIndex: int32,
                            opIndex: int32,
                            termIndex: int32,
                            edgeIndex: int32): bool =
    if action.placement != placement:
        return false
    if blockIndex >= 0 && action.blockIndex != blockIndex:
        return false
    if opIndex >= 0 && action.opIndex != opIndex:
        return false
    if termIndex >= 0 && action.termIndex != termIndex:
        return false
    if edgeIndex >= 0 && action.edgeIndex != edgeIndex:
        return false
    return true

@borrows
fn regallocA64FunctionAppendMatchingActions(
        out: var contract.RegallocA64FunctionRecipes,
        plan: var alloc.RegallocSinglePassValuePlan,
        placement: int32,
        blockIndex: int32,
        opIndex: int32,
        termIndex: int32,
        edgeIndex: int32): bool =
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if regallocA64ActionMatches(
               action, placement,
               blockIndex, opIndex, termIndex, edgeIndex) &&
           !regallocA64FunctionAppendAction(out, actionIndex):
            return false
    return true

@borrows
fn regallocA64FunctionAppendSite(
        out: var contract.RegallocA64FunctionRecipes,
        recipe: contract.RegallocA64SiteRecipe): bool =
    if !recipe.valid:
        return false
    let start = out.functionWords.len
    for wordIndex in 0..<recipe.words.len:
        add(out.functionWords, recipe.words[wordIndex])
    for relocIndex in 0..<recipe.relocs.len:
        # Re-own field-wise: a by-value struct copy aliases the source
        # element's managed targetSymbol, and any assignment through that
        # alias releases the source element's buffer (ORC wrong-owner).
        var reloc: contract.RegallocA64ActionReloc
        reloc.kind = recipe.relocs[relocIndex].kind
        reloc.wordIndex = start + recipe.relocs[relocIndex].wordIndex
        reloc.byteOffset =
            start * 4 + recipe.relocs[relocIndex].byteOffset
        reloc.callOrdinal = recipe.relocs[relocIndex].callOrdinal
        reloc.opIndex = recipe.relocs[relocIndex].opIndex
        reloc.subIndex = recipe.relocs[relocIndex].subIndex
        reloc.targetDomain = recipe.relocs[relocIndex].targetDomain
        reloc.targetRow = recipe.relocs[relocIndex].targetRow
        reloc.targetInterfaceCid = layout.FixedBytes32Copy(
            recipe.relocs[relocIndex].targetInterfaceCid)
        reloc.targetSymbol =
            strings.CloneStr(recipe.relocs[relocIndex].targetSymbol)
        add(out.functionRelocs, share(reloc))
    return true

@borrows
fn regallocA64EdgeHasMachineWords(
        out: var contract.RegallocA64FunctionRecipes,
        plan: var alloc.RegallocSinglePassValuePlan,
        edgeIndex: int32): bool =
    for actionIndex in 0..<plan.actions.len:
        if plan.actions[actionIndex].placement ==
               alloc.RegallocValuePlacementEdge &&
           plan.actions[actionIndex].edgeIndex == edgeIndex &&
           actionIndex < out.recipes.len &&
           out.recipes[actionIndex].words.len > 0:
            return true
    return false

@borrows
fn regallocA64BuildBlockEmissionOrder(
        bodyIR: var coreir.BodyIR,
        plan: var alloc.RegallocSinglePassValuePlan): int32[] =
    var out: int32[]
    var emitted = regallocA64IntSeq(bodyIR.blocks.len, 0)
    for ordinal in 0..<bodyIR.blocks.len:
        let _ = ordinal
        var selected: int32 = -1
        var selectedPosition: int32 = 2147483647
        for blockIndex in 0..<bodyIR.blocks.len:
            if emitted[blockIndex] != 0 ||
               blockIndex >= plan.blockEntryPositions.len ||
               plan.blockEntryPositions[blockIndex] < 0:
                continue
            let position = plan.blockEntryPositions[blockIndex]
            if position < selectedPosition ||
               (position == selectedPosition && blockIndex < selected):
                selected = blockIndex
                selectedPosition = position
        if selected < 0:
            return out
        emitted[selected] = 1
        add(out, selected)
    return out

@borrows
fn regallocA64FindEdge(
        plan: var alloc.RegallocSinglePassValuePlan,
        sourceBlock: int32,
        targetBlock: int32): int32 =
    for edgeIndex in 0..<plan.edgeSourceBlocks.len:
        if edgeIndex < plan.edgeTargetBlocks.len &&
           plan.edgeSourceBlocks[edgeIndex] == sourceBlock &&
           plan.edgeTargetBlocks[edgeIndex] == targetBlock:
            return edgeIndex
    return -1

fn regallocA64PatchFunctionBranches(
        out: var contract.RegallocA64FunctionRecipes,
        plan: var alloc.RegallocSinglePassValuePlan,
        trampolineBranchWords: var int32[],
        trampolineTargetBlocks: var int32[]): bool =
    for termIndex in 0..<out.termRecipes.len:
        var recipe = out.termRecipes[termIndex]
        if termIndex >= out.termWordStarts.len ||
           recipe.branchWordIndices.len !=
               recipe.branchTargetBlocks.len ||
           recipe.branchWordIndices.len !=
               recipe.branchConditionCodes.len:
            return false
        let termStart = out.termWordStarts[termIndex]
        for branchIndex in 0..<recipe.branchWordIndices.len:
            let localWord = recipe.branchWordIndices[branchIndex]
            let targetBlock = recipe.branchTargetBlocks[branchIndex]
            if termStart < 0 || localWord < 0 ||
               localWord >= recipe.words.len ||
               targetBlock < 0 ||
               targetBlock >= out.blockWordStarts.len:
                return false
            var targetWord = out.blockWordStarts[targetBlock]
            let edgeIndex = regallocA64FindEdge(
                plan, recipe.blockIndex, targetBlock)
            if edgeIndex >= 0 &&
               edgeIndex < out.edgeSplitWordStarts.len &&
               out.edgeSplitWordStarts[edgeIndex] >= 0:
                targetWord = out.edgeSplitWordStarts[edgeIndex]
            let absoluteWord = termStart + localWord
            let delta = targetWord - absoluteWord
            var encoded: int32
            let cond = recipe.branchConditionCodes[branchIndex]
            if cond >= 0:
                if delta < -262144 || delta > 262143:
                    return false
                encoded = Value(a64.A64EncBCond(int64(delta), cond))
            else:
                if delta < -33554432 || delta > 33554431:
                    return false
                encoded = Value(a64.A64EncBImm(int64(delta)))
            recipe.words[localWord] = encoded
            if absoluteWord < 0 || absoluteWord >= out.functionWords.len:
                return false
            out.functionWords[absoluteWord] = encoded
        out.termRecipes[termIndex] = recipe
    if trampolineBranchWords.len != trampolineTargetBlocks.len:
        return false
    for branchIndex in 0..<trampolineBranchWords.len:
        let wordIndex = trampolineBranchWords[branchIndex]
        let targetBlock = trampolineTargetBlocks[branchIndex]
        if wordIndex < 0 || wordIndex >= out.functionWords.len ||
           targetBlock < 0 || targetBlock >= out.blockWordStarts.len:
            return false
        let delta = out.blockWordStarts[targetBlock] - wordIndex
        if delta < -33554432 || delta > 33554431:
            return false
        out.functionWords[wordIndex] = Value(a64.A64EncBImm(int64(delta)))
    return true

@borrows
fn regallocA64AppendFragmentRelocs(
        out: var contract.RegallocA64FunctionRecipes,
        fragment: var contract.RegallocA64MachineFragment) =
    for relocIndex in 0..<out.functionRelocs.len:
        if out.functionRelocs[relocIndex].wordIndex >= fragment.wordStart &&
           out.functionRelocs[relocIndex].wordIndex <
               fragment.wordStart + fragment.wordCount:
            # Re-own field-wise: a by-value struct copy aliases the
            # function-level element's managed targetSymbol, and assigning
            # through that alias releases the live buffer (ORC wrong-owner).
            var copied: contract.RegallocA64ActionReloc
            copied.kind = out.functionRelocs[relocIndex].kind
            copied.wordIndex = out.functionRelocs[relocIndex].wordIndex
            copied.byteOffset = out.functionRelocs[relocIndex].byteOffset
            copied.callOrdinal =
                out.functionRelocs[relocIndex].callOrdinal
            copied.opIndex = out.functionRelocs[relocIndex].opIndex
            copied.subIndex = out.functionRelocs[relocIndex].subIndex
            copied.targetDomain =
                out.functionRelocs[relocIndex].targetDomain
            copied.targetRow = out.functionRelocs[relocIndex].targetRow
            copied.targetInterfaceCid = layout.FixedBytes32Copy(
                out.functionRelocs[relocIndex].targetInterfaceCid)
            copied.targetSymbol = strings.CloneStr(
                out.functionRelocs[relocIndex].targetSymbol)
            add(fragment.relocs, share(copied))

@borrows
fn regallocA64WordsEndWith(words: int32[],
                           suffix: int32[]): bool =
    if suffix.len <= 0 || suffix.len > words.len:
        return false
    let suffixStart = words.len - suffix.len
    for suffixIndex in 0..<suffix.len:
        if words[suffixStart + suffixIndex] != suffix[suffixIndex]:
            return false
    return true

@borrows
fn regallocA64WordRangeEffects(words: int32[],
                               wordStart: int32,
                               wordCount: int32): int32 =
    if wordStart < 0 || wordCount <= 0 ||
       wordStart > words.len - wordCount:
        return -1
    var rangeWords: int32[]
    for wordIndex in wordStart..<(wordStart + wordCount):
        add(rangeWords, words[wordIndex])
    return regallocA64WordsSpMemoryCallEffects(rangeWords)

@borrows
fn regallocA64AppendNonFrameWrittenRegs(
        out: var contract.RegallocA64FunctionRecipes,
        source: int32[],
        destination: var int32[]) =
    for sourceIndex in 0..<source.len:
        let reg = source[sourceIndex]
        var frameReg = reg == a64.A64FP ||
                       reg == a64.A64LR ||
                       reg == a64.A64SP
        for calleeIndex in 0..<out.calleeSavedRegs.len:
            if out.calleeSavedRegs[calleeIndex] == reg:
                frameReg = true
                break
        if !frameReg:
            regallocA64AppendWrittenReg(destination, reg)
    regallocA64SortWrittenRegs(destination)

@borrows
fn regallocA64AppendFrameEpilogueFragment(
        out: var contract.RegallocA64FunctionRecipes,
        recipe: contract.RegallocA64SiteRecipe,
        siteWordStart: int32): bool =
    let recipeWords = recipe.words
    let epilogueWords = out.epilogueWords
    if !regallocA64WordsEndWith(recipeWords, epilogueWords):
        return false
    let epilogueStart = siteWordStart +
                        recipeWords.len - epilogueWords.len
    var fragment = regallocA64MachineFragmentInit()
    fragment.ownerKind = contract.RegallocA64FragmentOwnerFrameEpilogue
    fragment.ownerOrdinal = recipe.siteIndex
    fragment.siteKind = recipe.siteKind
    fragment.siteIndex = recipe.siteIndex
    fragment.blockIndex = recipe.blockIndex
    fragment.irKind = recipe.irKind
    fragment.wordStart = epilogueStart
    fragment.wordCount = epilogueWords.len
    let functionWords = out.functionWords
    fragment.effectMask = regallocA64WordRangeEffects(
        functionWords, fragment.wordStart, fragment.wordCount)
    if fragment.effectMask < 0:
        return false
    for calleeIndex in 0..<out.calleeSavedRegs.len:
        regallocA64AppendWrittenReg(
            fragment.writtenRegs, out.calleeSavedRegs[calleeIndex])
    regallocA64AppendWrittenReg(fragment.writtenRegs, a64.A64FP)
    regallocA64AppendWrittenReg(fragment.writtenRegs, a64.A64LR)
    regallocA64AppendWrittenReg(fragment.writtenRegs, a64.A64SP)
    regallocA64SortWrittenRegs(fragment.writtenRegs)
    regallocA64AppendFragmentRelocs(out, fragment)
    add(out.machineFragments, share(fragment))
    return true

@borrows
fn regallocA64BuildMachineFragments(
        bodyIR: var coreir.BodyIR,
        plan: var alloc.RegallocSinglePassValuePlan,
        out: var contract.RegallocA64FunctionRecipes): bool =
    let functionWords = out.functionWords
    let epilogueWords = out.epilogueWords
    var framePrologueWordCount = out.prologueWords.len
    if out.abiIngressWordIndices.len > 0:
        framePrologueWordCount = out.abiIngressWordIndices[0]
    if framePrologueWordCount <= 0 ||
       framePrologueWordCount > out.prologueWords.len:
        return false
    var prologueFragment = regallocA64MachineFragmentInit()
    prologueFragment.ownerKind =
        contract.RegallocA64FragmentOwnerFramePrologue
    prologueFragment.ownerOrdinal = 0
    prologueFragment.siteKind = bodyaccess.BodyIrAccessSiteEntry
    prologueFragment.wordStart = 0
    prologueFragment.wordCount = framePrologueWordCount
    prologueFragment.effectMask = regallocA64WordRangeEffects(
        functionWords, 0, framePrologueWordCount)
    if prologueFragment.effectMask < 0:
        return false
    regallocA64AppendFragmentRelocs(out, prologueFragment)
    add(out.machineFragments, share(prologueFragment))
    for actionIndex in 0..<out.recipes.len:
        let recipe = out.recipes[actionIndex]
        if recipe.words.len <= 0:
            continue
        if actionIndex >= plan.actions.len ||
           actionIndex >= out.actionWordStarts.len ||
           out.actionWordStarts[actionIndex] < 0:
            return false
        let action = plan.actions[actionIndex]
        var fragment = regallocA64MachineFragmentInit()
        fragment.ownerKind = contract.RegallocA64FragmentOwnerAction
        if action.kind == alloc.RegallocValueActionEdgeParallelCopy:
            fragment.ownerKind = contract.RegallocA64FragmentOwnerEdge
        fragment.ownerOrdinal = action.consumerOrdinal
        fragment.actionConsumerOrdinal = action.consumerOrdinal
        if action.placement == alloc.RegallocValuePlacementEdge:
            if action.blockIndex < 0 ||
               action.blockIndex >= bodyIR.blocks.len:
                return false
            fragment.siteKind = bodyaccess.BodyIrAccessSiteTerm
            fragment.siteIndex =
                bodyIR.blocks[action.blockIndex].termIndex
        else:
            fragment.siteKind = bodyaccess.BodyIrAccessSiteOp
            if action.termIndex >= 0:
                fragment.siteKind = bodyaccess.BodyIrAccessSiteTerm
            fragment.siteIndex = action.termIndex
            if action.opIndex >= 0:
                fragment.siteIndex = action.opIndex
        if action.placement != alloc.RegallocValuePlacementEdge &&
           action.opIndex < 0 && action.termIndex < 0:
            fragment.siteKind = bodyaccess.BodyIrAccessSiteEntry
        fragment.blockIndex = action.blockIndex
        fragment.edgeIndex = action.edgeIndex
        fragment.sourceBlock = action.sourceBlock
        fragment.targetBlock = action.targetBlock
        fragment.requiresEdgeSplit = action.requiresEdgeSplit
        fragment.valueId = action.valueId
        fragment.irKind = action.kind
        fragment.wordStart = out.actionWordStarts[actionIndex]
        fragment.wordCount = recipe.words.len
        fragment.effectMask = recipe.effectMask
        fragment.writtenRegs = share(recipe.writtenRegs)
        regallocA64AppendFragmentRelocs(out, fragment)
        add(out.machineFragments, share(fragment))
    for opIndex in 0..<out.opRecipes.len:
        let recipe = out.opRecipes[opIndex]
        let recipeWords = recipe.words
        if recipe.machineOwnerKind != contract.RegallocA64SiteOwnerOp ||
           recipeWords.len <= 0:
            continue
        let ownsEpilogue = regallocA64WordsEndWith(
            recipeWords, epilogueWords)
        var siteWordCount = recipeWords.len
        if ownsEpilogue:
            siteWordCount = recipeWords.len - epilogueWords.len
        if siteWordCount > 0:
            var fragment = regallocA64MachineFragmentInit()
            fragment.ownerKind = contract.RegallocA64FragmentOwnerOp
            fragment.ownerOrdinal = opIndex
            fragment.siteKind = bodyaccess.BodyIrAccessSiteOp
            fragment.siteIndex = opIndex
            fragment.blockIndex = recipe.blockIndex
            fragment.irKind = recipe.irKind
            fragment.wordStart = out.opWordStarts[opIndex]
            fragment.wordCount = siteWordCount
            fragment.effectMask = regallocA64WordRangeEffects(
                functionWords, fragment.wordStart,
                fragment.wordCount)
            if fragment.effectMask < 0:
                return false
            fragment.effectMask = fragment.effectMask |
                (recipe.effectMask &
                 (contract.RegallocA64EffectX16 |
                  contract.RegallocA64EffectX17))
            let recipeWrittenRegs = recipe.writtenRegs
            if ownsEpilogue:
                regallocA64AppendNonFrameWrittenRegs(
                    out, recipeWrittenRegs, fragment.writtenRegs)
            else:
                fragment.writtenRegs = share(recipeWrittenRegs)
            for branchIndex in 0..<recipe.branchWordIndices.len:
                let localWord = recipe.branchWordIndices[branchIndex]
                let targetBlock = recipe.branchTargetBlocks[branchIndex]
                add(fragment.branchWordIndices,
                    fragment.wordStart + localWord)
                add(fragment.branchTargetBlocks, targetBlock)
                if targetBlock >= 0:
                    if targetBlock >= out.blockWordStarts.len:
                        return false
                    add(fragment.branchTargetWordStarts,
                        out.blockWordStarts[targetBlock])
                else:
                    add(fragment.branchTargetWordStarts,
                        out.opWordStarts[opIndex] + recipeWords.len)
            regallocA64AppendFragmentRelocs(out, fragment)
            add(out.machineFragments, share(fragment))
        if ownsEpilogue &&
           !regallocA64AppendFrameEpilogueFragment(
               out, recipe, out.opWordStarts[opIndex]):
            return false
    for termIndex in 0..<out.termRecipes.len:
        let recipe = out.termRecipes[termIndex]
        let recipeWords = recipe.words
        if recipe.machineOwnerKind != contract.RegallocA64SiteOwnerTerm ||
           recipeWords.len <= 0:
            continue
        let ownsEpilogue = regallocA64WordsEndWith(
            recipeWords, epilogueWords)
        var siteWordCount = recipeWords.len
        if ownsEpilogue:
            siteWordCount = recipeWords.len - epilogueWords.len
        if siteWordCount > 0:
            var fragment = regallocA64MachineFragmentInit()
            fragment.ownerKind = contract.RegallocA64FragmentOwnerTerm
            fragment.ownerOrdinal = termIndex
            fragment.siteKind = bodyaccess.BodyIrAccessSiteTerm
            fragment.siteIndex = termIndex
            fragment.blockIndex = recipe.blockIndex
            fragment.irKind = recipe.irKind
            fragment.wordStart = out.termWordStarts[termIndex]
            fragment.wordCount = siteWordCount
            fragment.effectMask = regallocA64WordRangeEffects(
                functionWords, fragment.wordStart,
                fragment.wordCount)
            if fragment.effectMask < 0:
                return false
            fragment.effectMask = fragment.effectMask |
                (recipe.effectMask &
                 (contract.RegallocA64EffectX16 |
                  contract.RegallocA64EffectX17))
            let recipeWrittenRegs = recipe.writtenRegs
            if ownsEpilogue:
                regallocA64AppendNonFrameWrittenRegs(
                    out, recipeWrittenRegs, fragment.writtenRegs)
            else:
                fragment.writtenRegs = share(recipeWrittenRegs)
            for branchIndex in 0..<recipe.branchWordIndices.len:
                let localWord = recipe.branchWordIndices[branchIndex]
                let targetBlock = recipe.branchTargetBlocks[branchIndex]
                add(fragment.branchWordIndices,
                    fragment.wordStart + localWord)
                add(fragment.branchTargetBlocks, targetBlock)
                var targetWord = out.blockWordStarts[targetBlock]
                let edgeIndex = regallocA64FindEdge(
                    plan, recipe.blockIndex, targetBlock)
                if edgeIndex >= 0 &&
                   edgeIndex < out.edgeSplitWordStarts.len &&
                   out.edgeSplitWordStarts[edgeIndex] >= 0:
                    targetWord = out.edgeSplitWordStarts[edgeIndex]
                add(fragment.branchTargetWordStarts, targetWord)
            regallocA64AppendFragmentRelocs(out, fragment)
            add(out.machineFragments, share(fragment))
        if ownsEpilogue &&
           !regallocA64AppendFrameEpilogueFragment(
               out, recipe, out.termWordStarts[termIndex]):
            return false
    for edgeIndex in 0..<out.edgeSplitWordStarts.len:
        if out.edgeSplitWordStarts[edgeIndex] < 0:
            continue
        if edgeIndex >= plan.edgeTargetBlocks.len:
            return false
        var trampolineBranchWord = out.edgeSplitWordStarts[edgeIndex]
        for actionIndex in 0..<plan.actions.len:
            if plan.actions[actionIndex].placement ==
                   alloc.RegallocValuePlacementEdge &&
               plan.actions[actionIndex].edgeIndex == edgeIndex:
                let actionEnd = out.actionWordStarts[actionIndex] +
                                out.actionWordCounts[actionIndex]
                if actionEnd > trampolineBranchWord:
                    trampolineBranchWord = actionEnd
        var fragment = regallocA64MachineFragmentInit()
        fragment.ownerKind = contract.RegallocA64FragmentOwnerEdgeTrampoline
        fragment.ownerOrdinal = edgeIndex
        fragment.siteKind = bodyaccess.BodyIrAccessSiteTerm
        fragment.blockIndex = plan.edgeSourceBlocks[edgeIndex]
        if fragment.blockIndex < 0 ||
           fragment.blockIndex >= bodyIR.blocks.len:
            return false
        fragment.siteIndex =
            bodyIR.blocks[fragment.blockIndex].termIndex
        fragment.edgeIndex = edgeIndex
        fragment.sourceBlock = plan.edgeSourceBlocks[edgeIndex]
        fragment.targetBlock = plan.edgeTargetBlocks[edgeIndex]
        for actionIndex in 0..<plan.actions.len:
            if plan.actions[actionIndex].placement ==
                   alloc.RegallocValuePlacementEdge &&
               plan.actions[actionIndex].edgeIndex == edgeIndex &&
               plan.actions[actionIndex].requiresEdgeSplit:
                fragment.requiresEdgeSplit = true
        fragment.wordStart = trampolineBranchWord
        fragment.wordCount = 1
        fragment.trampolineWordStart =
            out.edgeSplitWordStarts[edgeIndex]
        fragment.trampolineTargetBlock =
            plan.edgeTargetBlocks[edgeIndex]
        fragment.trampolineTargetWordStart =
            out.blockWordStarts[fragment.trampolineTargetBlock]
        add(fragment.branchWordIndices, fragment.wordStart)
        add(fragment.branchTargetBlocks,
            fragment.trampolineTargetBlock)
        add(fragment.branchTargetWordStarts,
            fragment.trampolineTargetWordStart)
        add(out.machineFragments, share(fragment))
    for ingressIndex in 0..<out.abiIngressWordIndices.len:
        if ingressIndex >= out.abiIngressWordCounts.len ||
           ingressIndex >= out.abiIngressRegs.len ||
           ingressIndex >= out.abiIngressOffsets.len ||
           ingressIndex >= out.abiIngressParamOrdinals.len ||
           ingressIndex >= out.abiIngressValueIds.len ||
           ingressIndex >= out.abiIngressWidths.len:
            return false
        var fragment = regallocA64MachineFragmentInit()
        fragment.ownerKind = contract.RegallocA64FragmentOwnerAbiIngress
        fragment.ownerOrdinal = ingressIndex
        fragment.siteKind = bodyaccess.BodyIrAccessSiteEntry
        fragment.ingressIndex = ingressIndex
        fragment.valueId = out.abiIngressValueIds[ingressIndex]
        fragment.irKind = out.abiIngressRegs[ingressIndex]
        fragment.wordStart = out.abiIngressWordIndices[ingressIndex]
        fragment.wordCount = out.abiIngressWordCounts[ingressIndex]
        var ingressWords: int32[]
        for wordIndex in 0..<fragment.wordCount:
            add(ingressWords,
                out.functionWords[fragment.wordStart + wordIndex])
        fragment.effectMask =
            regallocA64WordsSpMemoryCallEffects(ingressWords)
        if fragment.wordCount != 1 ||
           fragment.effectMask != contract.RegallocA64EffectSpStore ||
           !regallocA64StackImmediateFits(
               out.abiIngressOffsets[ingressIndex],
               out.abiIngressWidths[ingressIndex]):
            return false
        add(out.machineFragments, share(fragment))
    # Sort by (wordStart, ownerKind) through an index permutation: swapping
    # fragment structs in place aliases their managed relocs/writtenRegs
    # columns and the swap assignments release the live buffers (ORC
    # wrong-owner). share() per element keeps exactly one owner per column.
    var order: int32[]
    for index in 0..<out.machineFragments.len:
        add(order, index)
    for left in 0..<order.len:
        var best = left
        for right in (left + 1)..<order.len:
            let candidate = out.machineFragments[order[right]]
            let current = out.machineFragments[order[best]]
            if candidate.wordStart < current.wordStart ||
               (candidate.wordStart == current.wordStart &&
                candidate.ownerKind < current.ownerKind):
                best = right
        if best != left:
            let hold = order[left]
            order[left] = order[best]
            order[best] = hold
    var sorted: contract.RegallocA64MachineFragment[]
    for index in 0..<order.len:
        add(sorted, share(out.machineFragments[order[index]]))
    out.machineFragments = sorted
    return true

@borrows
fn regallocA64BindFunctionRelocOwners(
        bodyIR: var coreir.BodyIR,
        plan: var alloc.RegallocSinglePassValuePlan,
        out: var contract.RegallocA64FunctionRecipes): bool =
    var ownerOpByWord = regallocA64IntSeq(
        out.functionWords.len, -1)
    for actionIndex in 0..<plan.actions.len:
        if actionIndex >= out.actionWordStarts.len ||
           actionIndex >= out.actionWordCounts.len:
            return false
        let wordStart = out.actionWordStarts[actionIndex]
        let wordCount = out.actionWordCounts[actionIndex]
        if wordCount <= 0:
            continue
        let opIndex = plan.actions[actionIndex].opIndex
        if opIndex < 0:
            continue
        if opIndex >= bodyIR.ops.len || wordStart < 0 ||
           wordStart > ownerOpByWord.len - wordCount:
            return false
        for wordIndex in wordStart..<(wordStart + wordCount):
            if ownerOpByWord[wordIndex] >= 0:
                return false
            ownerOpByWord[wordIndex] = opIndex
    for opIndex in 0..<bodyIR.ops.len:
        if opIndex >= out.opWordStarts.len ||
           opIndex >= out.opWordCounts.len:
            return false
        let wordStart = out.opWordStarts[opIndex]
        let wordCount = out.opWordCounts[opIndex]
        if wordCount <= 0:
            continue
        if wordStart < 0 ||
           wordStart > ownerOpByWord.len - wordCount:
            return false
        for wordIndex in wordStart..<(wordStart + wordCount):
            if ownerOpByWord[wordIndex] >= 0:
                return false
            ownerOpByWord[wordIndex] = opIndex
    var nextDataSubIndex = regallocA64IntSeq(bodyIR.ops.len, 0)
    var relocIndex: int32
    while relocIndex < out.functionRelocs.len:
        let kind = out.functionRelocs[relocIndex].kind
        let wordIndex = out.functionRelocs[relocIndex].wordIndex
        if wordIndex < 0 || wordIndex >= ownerOpByWord.len:
            return false
        let opIndex = ownerOpByWord[wordIndex]
        if opIndex < 0 || opIndex >= bodyIR.ops.len:
            return false
        if kind == contract.RegallocA64RelocCall26:
            out.functionRelocs[relocIndex].opIndex = opIndex
            out.functionRelocs[relocIndex].subIndex = -1
            relocIndex = relocIndex + 1
            continue
        if kind != contract.RegallocA64RelocPage21 ||
           relocIndex + 1 >= out.functionRelocs.len:
            return false
        let pageOffIndex = relocIndex + 1
        if out.functionRelocs[pageOffIndex].kind !=
               contract.RegallocA64RelocPageOff12 ||
           out.functionRelocs[pageOffIndex].wordIndex != wordIndex + 1 ||
           out.functionRelocs[pageOffIndex].targetSymbol !=
               out.functionRelocs[relocIndex].targetSymbol ||
           wordIndex + 1 >= ownerOpByWord.len ||
           ownerOpByWord[wordIndex + 1] != opIndex:
            return false
        let subIndex = nextDataSubIndex[opIndex]
        out.functionRelocs[relocIndex].opIndex = opIndex
        out.functionRelocs[relocIndex].subIndex = subIndex
        out.functionRelocs[pageOffIndex].opIndex = opIndex
        out.functionRelocs[pageOffIndex].subIndex = subIndex
        nextDataSubIndex[opIndex] = subIndex + 1
        relocIndex = relocIndex + 2
    # [wall107] Project the bind-authoritative owner fields back onto the
    # action and site reloc rows.  The function-level table above is
    # assembled from those rows, and the production machine-recipe proof
    # compares every field of every projection (function table, action
    # recipes, site recipes, machine fragments) against each other.  The
    # bind loop filled only the function table, so data reloc rows kept
    # their -1 sentinels in the action/site projections and the proof's
    # field equality rejected every function carrying an action-level
    # data reference (stage code 1043).  Copy the two bound fields into
    # each projection row located by absolute word, kind, and symbol;
    # rows with no matching function entry keep their values so any
    # genuine misalignment still rejects downstream.
    var boundRows = regallocA64IntSeq(out.functionWords.len, -1)
    for relocIndex in 0..<out.functionRelocs.len:
        let boundWord = out.functionRelocs[relocIndex].wordIndex
        if boundWord < 0 || boundWord >= boundRows.len:
            return false
        boundRows[boundWord] = relocIndex
    for actionIndex in 0..<out.recipes.len:
        let actionWordStart = out.actionWordStarts[actionIndex]
        if actionWordStart < 0:
            continue
        for relocIndex in 0..<out.recipes[actionIndex].relocs.len:
            let absoluteWordIndex = actionWordStart +
                out.recipes[actionIndex].relocs[relocIndex].wordIndex
            if absoluteWordIndex < 0 || absoluteWordIndex >= boundRows.len:
                continue
            let boundIndex = boundRows[absoluteWordIndex]
            if boundIndex < 0:
                continue
            if out.recipes[actionIndex].relocs[relocIndex].kind !=
                   out.functionRelocs[boundIndex].kind ||
               out.recipes[actionIndex].relocs[relocIndex].targetSymbol !=
                   out.functionRelocs[boundIndex].targetSymbol:
                continue
            var row = out.recipes[actionIndex].relocs[relocIndex]
            row.opIndex = out.functionRelocs[boundIndex].opIndex
            row.subIndex = out.functionRelocs[boundIndex].subIndex
            out.recipes[actionIndex].relocs[relocIndex] = row
    for opRecipeIndex in 0..<out.opRecipes.len:
        let opWordStart = out.opWordStarts[opRecipeIndex]
        if opWordStart < 0:
            continue
        for relocIndex in 0..<out.opRecipes[opRecipeIndex].relocs.len:
            let absoluteWordIndex = opWordStart +
                out.opRecipes[opRecipeIndex].relocs[relocIndex].wordIndex
            if absoluteWordIndex < 0 || absoluteWordIndex >= boundRows.len:
                continue
            let boundIndex = boundRows[absoluteWordIndex]
            if boundIndex < 0:
                continue
            if out.opRecipes[opRecipeIndex].relocs[relocIndex].kind !=
                   out.functionRelocs[boundIndex].kind ||
               out.opRecipes[opRecipeIndex].relocs[relocIndex].targetSymbol !=
                   out.functionRelocs[boundIndex].targetSymbol:
                continue
            var row = out.opRecipes[opRecipeIndex].relocs[relocIndex]
            row.opIndex = out.functionRelocs[boundIndex].opIndex
            row.subIndex = out.functionRelocs[boundIndex].subIndex
            out.opRecipes[opRecipeIndex].relocs[relocIndex] = row
    for termRecipeIndex in 0..<out.termRecipes.len:
        let termWordStart = out.termWordStarts[termRecipeIndex]
        if termWordStart < 0:
            continue
        for relocIndex in 0..<out.termRecipes[termRecipeIndex].relocs.len:
            let absoluteWordIndex = termWordStart +
                out.termRecipes[termRecipeIndex].relocs[relocIndex].wordIndex
            if absoluteWordIndex < 0 || absoluteWordIndex >= boundRows.len:
                continue
            let boundIndex = boundRows[absoluteWordIndex]
            if boundIndex < 0:
                continue
            if out.termRecipes[termRecipeIndex].relocs[relocIndex].kind !=
                   out.functionRelocs[boundIndex].kind ||
               out.termRecipes[termRecipeIndex].relocs[relocIndex].targetSymbol !=
                   out.functionRelocs[boundIndex].targetSymbol:
                continue
            var row = out.termRecipes[termRecipeIndex].relocs[relocIndex]
            row.opIndex = out.functionRelocs[boundIndex].opIndex
            row.subIndex = out.functionRelocs[boundIndex].subIndex
            out.termRecipes[termRecipeIndex].relocs[relocIndex] = row
    return true

# [wall107] Reject-path-only alignment probe for the production
# machine-recipe proof stage 1043 (frozen relocs aligned).  Mirrors the
# production proof walks field-for-field.  It never mutates validity,
# words, relocs, or any emitted byte: green (aligned) recipes stay
# completely silent, and a misaligned recipe prints the exact failing
# leg plus coordinates so the entry-bridge verdict can be attributed.
@borrows
fn regallocA64FragmentRelocMatchesFunctionReloc(
        out: var contract.RegallocA64FunctionRecipes,
        fragmentIndex: int32,
        fragmentRelocIndex: int32,
        functionRelocIndex: int32): bool =
    return out.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].kind ==
               out.functionRelocs[functionRelocIndex].kind &&
           out.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].callOrdinal ==
               out.functionRelocs[functionRelocIndex].callOrdinal &&
           out.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].opIndex ==
               out.functionRelocs[functionRelocIndex].opIndex &&
           out.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].subIndex ==
               out.functionRelocs[functionRelocIndex].subIndex &&
           out.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].targetDomain ==
               out.functionRelocs[functionRelocIndex].targetDomain &&
           out.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].targetRow ==
               out.functionRelocs[functionRelocIndex].targetRow &&
           layout.FixedBytes32Equal(
               out.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].targetInterfaceCid,
               out.functionRelocs[functionRelocIndex].targetInterfaceCid) &&
           out.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].targetSymbol ==
               out.functionRelocs[functionRelocIndex].targetSymbol &&
           out.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].wordIndex ==
               out.functionRelocs[functionRelocIndex].wordIndex &&
           out.machineFragments[fragmentIndex].relocs[fragmentRelocIndex].byteOffset ==
               out.functionRelocs[functionRelocIndex].byteOffset

@borrows
fn regallocA64RelocAlignmentDiagnostics(
        out: var contract.RegallocA64FunctionRecipes) =
    var fragRelocTotal: int32
    var fragMap = ""
    for fragmentIndex in 0..<out.machineFragments.len:
        let fragment = out.machineFragments[fragmentIndex]
        fragRelocTotal = fragRelocTotal + fragment.relocs.len
        fragMap = Fmt"{fragMap}|f{fragmentIndex}:k={fragment.ownerKind}:w={fragment.wordStart}:{fragment.wordCount}:r={fragment.relocs.len}"
    # Leg 1: the (wordStart, ownerKind)-sorted fragment reloc
    # concatenation must equal functionRelocs exactly, in order and in
    # every field (production proof prefix walk).
    var leg1: bool = true
    var leg1Fragment: int32 = -1
    var leg1FragmentReloc: int32 = -1
    var functionRelocIndex: int32
    for fragmentIndex in 0..<out.machineFragments.len:
        if !leg1:
            break
        for fragmentRelocIndex in 0..<out.machineFragments[fragmentIndex].relocs.len:
            if functionRelocIndex >= out.functionRelocs.len:
                leg1 = false
                leg1Fragment = fragmentIndex
                leg1FragmentReloc = fragmentRelocIndex
                break
            if !regallocA64FragmentRelocMatchesFunctionReloc(
                   out, fragmentIndex, fragmentRelocIndex,
                   functionRelocIndex):
                leg1 = false
                leg1Fragment = fragmentIndex
                leg1FragmentReloc = fragmentRelocIndex
                break
            functionRelocIndex = functionRelocIndex + 1
    if leg1 && functionRelocIndex != out.functionRelocs.len:
        leg1 = false
    var leg3: bool = true
    var leg3Reloc: int32 = -1
    var leg3Row: int32 = -1
    var rows = regallocA64IntSeq(out.functionWords.len, -1)
    if leg1:
        # Leg 3: per-word uniqueness/coverage on the function reloc table.
        for relocIndex in 0..<out.functionRelocs.len:
            let wordIndex = out.functionRelocs[relocIndex].wordIndex
            if wordIndex < 0 || wordIndex >= rows.len ||
               rows[wordIndex] >= 0:
                leg3 = false
                leg3Reloc = relocIndex
                if wordIndex >= 0 && wordIndex < rows.len:
                    leg3Row = rows[wordIndex]
                break
            rows[wordIndex] = relocIndex
    var leg4: bool = true
    var leg4Action: int32 = -1
    var leg4Reloc: int32 = -1
    var leg4Abs: int32 = -1
    var leg4Row: int32 = -1
    var leg4DiffMask: int32
    if leg1 && leg3:
        # Leg 4: every action recipe reloc must project onto the function
        # reloc row at its absolute word with every field equal (the
        # byteOffset/wordIndex projections included).
        for actionIndex in 0..<out.recipes.len:
            if !leg4:
                break
            let actionWordStart = out.actionWordStarts[actionIndex]
            if actionWordStart < 0:
                continue
            for recipeRelocIndex in 0..<out.recipes[actionIndex].relocs.len:
                let absoluteWordIndex = actionWordStart +
                    out.recipes[actionIndex].relocs[recipeRelocIndex].wordIndex
                if absoluteWordIndex < 0 ||
                   absoluteWordIndex >= rows.len:
                    leg4 = false
                    leg4Action = actionIndex
                    leg4Reloc = recipeRelocIndex
                    leg4Abs = absoluteWordIndex
                    leg4Row = -2
                    break
                let functionRow = rows[absoluteWordIndex]
                if functionRow < 0:
                    leg4 = false
                    leg4Action = actionIndex
                    leg4Reloc = recipeRelocIndex
                    leg4Abs = absoluteWordIndex
                    leg4Row = functionRow
                    break
                let functionReloc = out.functionRelocs[functionRow]
                let recipeReloc = out.recipes[actionIndex].relocs[recipeRelocIndex]
                var diffMask: int32
                if recipeReloc.kind != functionReloc.kind:
                    diffMask = diffMask | 1
                if recipeReloc.callOrdinal != functionReloc.callOrdinal:
                    diffMask = diffMask | 2
                if recipeReloc.opIndex != functionReloc.opIndex:
                    diffMask = diffMask | 4
                if recipeReloc.subIndex != functionReloc.subIndex:
                    diffMask = diffMask | 8
                if recipeReloc.targetDomain != functionReloc.targetDomain:
                    diffMask = diffMask | 16
                if recipeReloc.targetRow != functionReloc.targetRow:
                    diffMask = diffMask | 32
                if !layout.FixedBytes32Equal(
                       recipeReloc.targetInterfaceCid,
                       functionReloc.targetInterfaceCid):
                    diffMask = diffMask | 64
                if recipeReloc.targetSymbol != functionReloc.targetSymbol:
                    diffMask = diffMask | 128
                if functionReloc.wordIndex != absoluteWordIndex:
                    diffMask = diffMask | 256
                if functionReloc.byteOffset !=
                   actionWordStart * 4 + recipeReloc.byteOffset:
                    diffMask = diffMask | 512
                if diffMask != 0:
                    leg4 = false
                    leg4Action = actionIndex
                    leg4Reloc = recipeRelocIndex
                    leg4Abs = absoluteWordIndex
                    leg4Row = functionRow
                    leg4DiffMask = diffMask
                    break
    if leg1 && leg3 && leg4:
        return
    var probe = Fmt"phase=regalloc_a64_reloc_align_probe fragments={out.machineFragments.len} frag_relocs={fragRelocTotal} func_relocs={out.functionRelocs.len} words={out.functionWords.len} actions={out.recipes.len} leg1={leg1} leg3={leg3} leg4={leg4} fragmap={fragMap}"
    if !leg1:
        let fragmentReloc = out.machineFragments[leg1Fragment].relocs[leg1FragmentReloc]
        let functionReloc = out.functionRelocs[functionRelocIndex]
        probe = Fmt"{probe} l1_frag={leg1Fragment} l1_fr={leg1FragmentReloc} l1_func={functionRelocIndex} l1_frag_kind={fragmentReloc.kind} l1_func_kind={functionReloc.kind} l1_frag_word={fragmentReloc.wordIndex} l1_func_word={functionReloc.wordIndex} l1_frag_op={fragmentReloc.opIndex} l1_func_op={functionReloc.opIndex} l1_frag_sub={fragmentReloc.subIndex} l1_func_sub={functionReloc.subIndex} l1_frag_sym={fragmentReloc.targetSymbol} l1_func_sym={functionReloc.targetSymbol}"
    if !leg3:
        probe = Fmt"{probe} l3_reloc={leg3Reloc} l3_word={out.functionRelocs[leg3Reloc].wordIndex} l3_prev_row={leg3Row}"
    if !leg4:
        probe = Fmt"{probe} l4_action={leg4Action} l4_reloc={leg4Reloc} l4_abs={leg4Abs} l4_row={leg4Row} l4_mask={leg4DiffMask}"
        if leg4Row >= 0:
            probe = Fmt"{probe} l4_func_kind={out.functionRelocs[leg4Row].kind} l4_func_op={out.functionRelocs[leg4Row].opIndex} l4_func_sub={out.functionRelocs[leg4Row].subIndex} l4_act_kind={out.recipes[leg4Action].relocs[leg4Reloc].kind} l4_act_op={out.recipes[leg4Action].relocs[leg4Reloc].opIndex} l4_act_sub={out.recipes[leg4Action].relocs[leg4Reloc].subIndex} l4_sym={out.recipes[leg4Action].relocs[leg4Reloc].targetSymbol}"
    os.WriteLine(os.GetStderr(), probe)

@borrows
fn regallocA64ComposeFunction(
        bodyIR: var coreir.BodyIR,
        plan: var alloc.RegallocSinglePassValuePlan,
        out: var contract.RegallocA64FunctionRecipes): bool =
    out.blockEmissionOrder = regallocA64BuildBlockEmissionOrder(
        bodyIR, plan)
    out.reachableBlockCount = out.blockEmissionOrder.len
    if out.reachableBlockCount <= 0:
        return false
    out.blockWordStarts = regallocA64IntSeq(bodyIR.blocks.len, -1)
    out.opWordStarts = regallocA64IntSeq(bodyIR.ops.len, -1)
    out.opWordCounts = regallocA64IntSeq(bodyIR.ops.len, 0)
    out.termWordStarts = regallocA64IntSeq(bodyIR.terms.len, -1)
    out.termWordCounts = regallocA64IntSeq(bodyIR.terms.len, 0)
    out.edgeSplitWordStarts = regallocA64IntSeq(
        plan.edgeSourceBlocks.len, -1)
    out.actionWordStarts = regallocA64IntSeq(plan.actions.len, -1)
    out.actionWordCounts = regallocA64IntSeq(plan.actions.len, 0)
    regallocA64AppendRecipeWords(out.functionWords, out.prologueWords)
    if !regallocA64FunctionAppendMatchingActions(
           out, plan, alloc.RegallocValuePlacementFunctionEntry,
           -1, -1, -1, -1):
        return false
    var trampolineBranchWords: int32[]
    var trampolineTargetBlocks: int32[]
    for scheduleIndex in 0..<out.blockEmissionOrder.len:
        let blockIndex = out.blockEmissionOrder[scheduleIndex]
        let block = bodyIR.blocks[blockIndex]
        out.blockWordStarts[blockIndex] = out.functionWords.len
        if !regallocA64FunctionAppendMatchingActions(
               out, plan, alloc.RegallocValuePlacementBlockEntry,
               blockIndex, -1, -1, -1):
            return false
        for opIndex in block.opStart..<(block.opStart + block.opCount):
            if !regallocA64FunctionAppendMatchingActions(
                   out, plan, alloc.RegallocValuePlacementBeforeOp,
                   blockIndex, opIndex, -1, -1):
                return false
            out.opWordStarts[opIndex] = out.functionWords.len
            if opIndex < 0 || opIndex >= out.opRecipes.len:
                return false
            let opRecipe = out.opRecipes[opIndex]
            if !regallocA64FunctionAppendSite(out, opRecipe):
                return false
            out.opWordCounts[opIndex] = opRecipe.words.len
            if !regallocA64FunctionAppendMatchingActions(
                   out, plan, alloc.RegallocValuePlacementAfterOp,
                   blockIndex, opIndex, -1, -1):
                return false
        if !regallocA64FunctionAppendMatchingActions(
               out, plan, alloc.RegallocValuePlacementBlockExit,
               blockIndex, -1, -1, -1):
            return false
        let termIndex = block.termIndex
        if !regallocA64FunctionAppendMatchingActions(
               out, plan, alloc.RegallocValuePlacementBeforeTerm,
               blockIndex, -1, termIndex, -1):
            return false
        out.termWordStarts[termIndex] = out.functionWords.len
        if termIndex < 0 || termIndex >= out.termRecipes.len:
            return false
        let termRecipe = out.termRecipes[termIndex]
        if !regallocA64FunctionAppendSite(out, termRecipe):
            return false
        out.termWordCounts[termIndex] = termRecipe.words.len
        if !regallocA64FunctionAppendMatchingActions(
               out, plan, alloc.RegallocValuePlacementAfterTerm,
               blockIndex, -1, termIndex, -1):
            return false
        # Every real machine edge copy gets its own source-adjacent trampoline.
        # This is correct for critical and non-critical edges and keeps frozen
        # consumer order identical to allocator position order.
        for edgeIndex in 0..<plan.edgeSourceBlocks.len:
            if plan.edgeSourceBlocks[edgeIndex] != blockIndex ||
               !regallocA64EdgeHasMachineWords(out, plan, edgeIndex):
                continue
            out.edgeSplitWordStarts[edgeIndex] = out.functionWords.len
            if !regallocA64FunctionAppendMatchingActions(
                   out, plan, alloc.RegallocValuePlacementEdge,
                   blockIndex, -1, -1, edgeIndex):
                return false
            add(trampolineBranchWords, out.functionWords.len)
            add(trampolineTargetBlocks,
                plan.edgeTargetBlocks[edgeIndex])
            add(out.functionWords, a64.A64EncBPlaceholder())
    for actionIndex in 0..<plan.actions.len:
        if out.actionWordStarts[actionIndex] < 0:
            # Structural proof actions have no physical placement requirement;
            # freeze an empty range at the end without inventing bytes.
            if out.recipes[actionIndex].words.len != 0 ||
               out.recipes[actionIndex].bindingKind !=
                   alloc.RegallocValueBindingStructural:
                return false
            out.actionWordStarts[actionIndex] = out.functionWords.len
    if !regallocA64PatchFunctionBranches(
           out, plan, trampolineBranchWords,
           trampolineTargetBlocks):
        return false
    if !regallocA64BindFunctionRelocOwners(bodyIR, plan, out):
        return false
    if !regallocA64BuildMachineFragments(bodyIR, plan, out):
        return false
    # [wall107] Reject-path-only probe; silent on aligned recipes.
    regallocA64RelocAlignmentDiagnostics(out)
    for wordIndex in 0..<out.functionWords.len:
        if out.functionWords[wordIndex] == 0 ||
           out.functionWords[wordIndex] == a64.A64EncNop():
            return false
    return out.functionWords.len > 0

@borrows
fn RegallocA64PrepareFunctionActionRecipesWithDataProjection(
        bodyIR: var coreir.BodyIR,
        plan: var alloc.RegallocSinglePassValuePlan,
        slotDataSymbols: var str[],
        cstringDataSymbols: var str[],
        projectionRequired: bool): contract.RegallocA64FunctionRecipes =
    var out: contract.RegallocA64FunctionRecipes
    out.valid = true
    out.machineXlen = 64
    if !regallocA64DataSymbolProjectionShapeValid(
           bodyIR, slotDataSymbols, cstringDataSymbols,
           projectionRequired):
        regallocA64FunctionFail(out, contract.RegallocA64RecipeErrorBody, -1)
        return out
    if !alloc.RegallocSinglePassValuePlanValidate(plan) ||
       plan.finalized || plan.emissionSymbolBound ||
       plan.nextIssueOrdinal != 0 || plan.nextAckOrdinal != 0:
        regallocA64FunctionFail(out, contract.RegallocA64RecipeErrorPlan, 0)
        return out
    if !alloc.RegallocSinglePassValuePlanMatchesBodyIrIngress(
           bodyIR, plan):
        regallocA64FunctionFail(out, contract.RegallocA64RecipeErrorPlan, 1)
        return out
    var table = bodyaccess.BodyIrAccessDecode(bodyIR)
    if !table.valid:
        regallocA64FunctionFail(out, contract.RegallocA64RecipeErrorBody,
                               table.errorSiteIndex)
        return out
    if !RegallocA64EntryAbiSupported(bodyIR):
        regallocA64FunctionFail(out, contract.RegallocA64RecipeErrorBody, -1)
        return out
    for callIndex in 0..<bodyIR.callSequence.len:
        let call = bodyIR.callSequence[callIndex]
        if regallocA64CallHasUnsupportedF64CAbi(bodyIR, call):
            # The frozen value-action schema currently has one positional X
            # bank and cannot prove independent AAPCS64 NGRN/NSRN placement.
            # Reject before emitting a call instead of publishing wrong ABI.
            regallocA64FunctionFail(
                out, contract.RegallocA64RecipeErrorBody, callIndex)
            return out
    for opIndex in 0..<bodyIR.ops.len:
        let kind = bodyIR.ops[opIndex].kind
        if !RegallocA64BodyOpKindKnown(kind):
            regallocA64FunctionFail(out, contract.RegallocA64RecipeErrorBody,
                                   opIndex)
            return out
        out.bodyOpKindMask = out.bodyOpKindMask | (int64(1) << kind)
    var outgoing: int32
    for actionIndex in 0..<plan.actions.len:
        if plan.actions[actionIndex].outgoingStackFrameBytes > outgoing:
            outgoing = plan.actions[actionIndex].outgoingStackFrameBytes
        if plan.actions[actionIndex].kind ==
           alloc.RegallocValueActionStoreSretReturn:
            out.hasSretReturn = true
    outgoing = regallocA64Align(outgoing, 16)
    if outgoing < 0:
        regallocA64FunctionFail(out, contract.RegallocA64RecipeErrorFrame, 0)
        return out
    out.outgoingStackBytes = outgoing
    var bodyStackEnd: int32 = 16
    var parameterCount: int32
    for slotIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[slotIndex]
        let slotAlignBytes = slot.alignBytes
        let slotSizeBytes = slot.sizeBytes
        let slotStackOffset = slot.stackOffset
        if slotAlignBytes <= 0 || slotSizeBytes <= 0:
            regallocA64FunctionFail(out,
                                   contract.RegallocA64RecipeErrorFrame,
                                   slotIndex)
            return out
        let paramIndex = regallocA64ParamIndex(slot)
        if paramIndex >= 0:
            if regallocA64ParamSlotIndex(bodyIR, paramIndex) != slotIndex:
                regallocA64FunctionFail(
                    out, contract.RegallocA64RecipeErrorFrame, slotIndex)
                return out
            if paramIndex == 2147483647:
                regallocA64FunctionFail(
                    out, contract.RegallocA64RecipeErrorFrame, slotIndex)
                return out
            if paramIndex + 1 > parameterCount:
                parameterCount = paramIndex + 1
            continue
        if slotStackOffset < 16 ||
           slotStackOffset % slotAlignBytes != 0 ||
           slotStackOffset > 2147483647 - slotSizeBytes:
            regallocA64FunctionFail(out,
                                   contract.RegallocA64RecipeErrorFrame,
                                   slotIndex)
            return out
        let slotEnd = slotStackOffset + slotSizeBytes
        if slotEnd > bodyStackEnd:
            bodyStackEnd = slotEnd
    for reg in 0..<63:
        if (plan.usedCalleeMask & (int64(1) << reg)) == 0:
            continue
        var allowed: bool
        for candidateIndex in 0..<plan.constraints.allocatableCalleeRegs.len:
            if plan.constraints.allocatableCalleeRegs[candidateIndex] == reg:
                allowed = true
                break
        if !allowed:
            regallocA64FunctionFail(out,
                                   contract.RegallocA64RecipeErrorFrame,
                                   reg)
            return out
        add(out.calleeSavedRegs, reg)
    if out.calleeSavedRegs.len > (2147483647 - 16) / 8:
        regallocA64FunctionFail(out,
                               contract.RegallocA64RecipeErrorFrame,
                               3)
        return out
    for calleeIndex in 0..<out.calleeSavedRegs.len:
        add(out.calleeSavedOffsets,
            16 + calleeIndex * 8)
    out.calleeRegionEnd = 16 + out.calleeSavedRegs.len * 8
    out.ingressRegionStart = out.calleeRegionEnd
    out.paramSaveOffset = out.ingressRegionStart
    out.paramSaveCount = parameterCount
    var ingressCount: int32
    var parameterNeedsHome: bool[]
    for paramIndex in 0..<parameterCount:
        let slotIndex = regallocA64ParamSlotIndex(bodyIR, paramIndex)
        if slotIndex < 0:
            regallocA64FunctionFail(out,
                                   contract.RegallocA64RecipeErrorFrame,
                                   paramIndex)
            return out
        let valueId = regallocA64EntryValueForSlot(plan, slotIndex)
        if valueId < 0 || valueId >= plan.valueMemoryHomes.len:
            regallocA64FunctionFail(out,
                                   contract.RegallocA64RecipeErrorFrame,
                                   slotIndex)
            return out
        let slot = bodyIR.localSlots[slotIndex]
        let width = regallocA64IncomingParamWidth(slot)
        if width != 1 && width != 2 && width != 4 && width != 8:
            regallocA64FunctionFail(out,
                                   contract.RegallocA64RecipeErrorFrame,
                                   slotIndex)
            return out
        add(out.parameterValueIds, valueId)
        add(out.parameterWidths, width)
        add(out.parameterHomeOffsets, -1)
        var needsHome = plan.valueMemoryHomes[valueId]
        if slot.typeKind == coreir.LocalF64Tag:
            # F64 stays in the stack class and all arithmetic/comparison
            # recipes consume its authoritative ingress home.
            needsHome = true
        add(parameterNeedsHome, needsHome)
    # Derive every additional stack consumer in one action pass. This replaces
    # the old per-parameter full action rescans and ensures that every address
    # later published in localStackOffsets is actually written by prologue.
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        var valueSlot: int32 = -1
        if action.valueId >= 0 &&
           action.valueId < plan.valueSlotIndices.len:
            valueSlot = plan.valueSlotIndices[action.valueId]
        if action.sourceLocation == alloc.RegallocValueLocationStack:
            var sourceSlot = valueSlot
            if action.sourceStackSlot >= 0:
                sourceSlot = action.sourceStackSlot
            if sourceSlot >= 0 && sourceSlot < bodyIR.localSlots.len:
                let sourceLocal = bodyIR.localSlots[sourceSlot]
                let sourceParam = regallocA64ParamIndex(sourceLocal)
                if sourceParam >= 0 &&
                   sourceParam < plan.constraints.fixedArgRegs.len &&
                   sourceParam < parameterNeedsHome.len:
                    parameterNeedsHome[sourceParam] = true
        if action.targetLocation == alloc.RegallocValueLocationStack:
            var targetSlot = valueSlot
            if action.targetStackSlot >= 0:
                targetSlot = action.targetStackSlot
            if targetSlot >= 0 && targetSlot < bodyIR.localSlots.len:
                let targetLocal = bodyIR.localSlots[targetSlot]
                let targetParam = regallocA64ParamIndex(targetLocal)
                if targetParam >= 0 &&
                   targetParam < plan.constraints.fixedArgRegs.len &&
                   targetParam < parameterNeedsHome.len:
                    parameterNeedsHome[targetParam] = true
    for paramIndex in 0..<parameterCount:
        if paramIndex < plan.constraints.fixedArgRegs.len &&
           parameterNeedsHome[paramIndex]:
            ingressCount = ingressCount + 1
    if out.hasSretReturn:
        ingressCount = ingressCount + 1
    if ingressCount > (2147483647 - out.ingressRegionStart) / 8:
        regallocA64FunctionFail(out,
                               contract.RegallocA64RecipeErrorFrame,
                               2)
        return out
    out.ingressRegionSize = ingressCount * 8
    out.bodyRegionStart = out.ingressRegionStart + out.ingressRegionSize
    var nextIngressOffset = out.ingressRegionStart
    for paramIndex in 0..<parameterCount:
        if paramIndex < plan.constraints.fixedArgRegs.len &&
           parameterNeedsHome[paramIndex]:
            out.parameterHomeOffsets[paramIndex] = nextIngressOffset
            nextIngressOffset = nextIngressOffset + 8
    out.returnBufferSaveOffset = -1
    if out.hasSretReturn:
        out.returnBufferSaveOffset = nextIngressOffset
        nextIngressOffset = nextIngressOffset + 8
    if nextIngressOffset != out.bodyRegionStart:
        regallocA64FunctionFail(out,
                               contract.RegallocA64RecipeErrorFrame,
                               3)
        return out
    var bodyStorageStart = out.bodyRegionStart
    let bodySpan = bodyStackEnd - 16
    if bodySpan < 0 || bodyStorageStart > 2147483647 - bodySpan:
        regallocA64FunctionFail(out,
                               contract.RegallocA64RecipeErrorFrame,
                               4)
        return out
    var frameEnd = bodyStorageStart + bodySpan
    if plan.stackSlotCount < 0 ||
       plan.stackSlotCount > (2147483647 - out.bodyRegionStart) / 8:
        regallocA64FunctionFail(out,
                               contract.RegallocA64RecipeErrorFrame,
                               4)
        return out
    let proofBodyEnd = out.bodyRegionStart + plan.stackSlotCount * 8
    if proofBodyEnd > frameEnd:
        frameEnd = proofBodyEnd
    out.frameBytes = regallocA64Align(frameEnd, 16)
    if out.frameBytes <= 0:
        regallocA64FunctionFail(out, contract.RegallocA64RecipeErrorFrame, 4)
        return out
    for slotIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[slotIndex]
        let paramIndex = regallocA64ParamIndex(slot)
        if paramIndex < 0:
            add(out.localStackOffsets,
                bodyStorageStart + slot.stackOffset - 16)
        elif paramIndex < plan.constraints.fixedArgRegs.len:
            add(out.localStackOffsets,
                out.parameterHomeOffsets[paramIndex])
        else:
            let incomingOffset = regallocA64IncomingStackParamOffset(
                bodyIR, paramIndex)
            if incomingOffset < 0 ||
               out.frameBytes > 2147483647 - incomingOffset:
                regallocA64FunctionFail(out,
                                       contract.RegallocA64RecipeErrorFrame,
                                       slotIndex)
                return out
            add(out.localStackOffsets,
                out.frameBytes + incomingOffset)
    if !regallocA64AppendSpAdjust(out.prologueWords,
                                  out.frameBytes, true):
        regallocA64FunctionFail(out, contract.RegallocA64RecipeErrorFrame, 4)
        return out
    add(out.prologueWords, Value(a64.A64EncStp64(
        a64.A64FP, a64.A64LR, a64.A64SP, int64(0))))
    add(out.prologueWords, Value(a64.A64EncAddImm(
        true, a64.A64FP, a64.A64SP, 0)))
    # Keep the strict callee-save band contiguous with frame setup.  ABI
    # ingress follows it as a separately frozen, explicitly indexed band.
    for calleeIndex in 0..<out.calleeSavedRegs.len:
        if !regallocA64AppendStore(
               out.prologueWords,
               out.calleeSavedRegs[calleeIndex],
               out.calleeSavedOffsets[calleeIndex], 8):
            regallocA64FunctionFail(out,
                                   contract.RegallocA64RecipeErrorFrame,
                                   7)
            return out
    for paramIndex in 0..<out.parameterValueIds.len:
        let homeOffset = out.parameterHomeOffsets[paramIndex]
        if homeOffset < 0:
            continue
        let width = out.parameterWidths[paramIndex]
        if !regallocA64StackImmediateFits(homeOffset, width):
            regallocA64FunctionFail(out,
                                   contract.RegallocA64RecipeErrorFrame,
                                   5)
            return out
        let ingressWord = out.prologueWords.len
        if !regallocA64AppendStore(
               out.prologueWords,
               plan.constraints.fixedArgRegs[paramIndex],
               homeOffset, width) ||
           out.prologueWords.len != ingressWord + 1:
            regallocA64FunctionFail(out,
                                   contract.RegallocA64RecipeErrorFrame,
                                   5)
            return out
        add(out.abiIngressRegs,
            plan.constraints.fixedArgRegs[paramIndex])
        add(out.abiIngressOffsets, homeOffset)
        add(out.abiIngressParamOrdinals, paramIndex)
        add(out.abiIngressValueIds,
            out.parameterValueIds[paramIndex])
        add(out.abiIngressWidths, width)
        add(out.abiIngressWordIndices, ingressWord)
        add(out.abiIngressWordCounts, 1)
    if out.hasSretReturn:
        if !regallocA64StackImmediateFits(
               out.returnBufferSaveOffset, 8):
            regallocA64FunctionFail(out,
                                   contract.RegallocA64RecipeErrorFrame,
                                   6)
            return out
        let ingressWord = out.prologueWords.len
        if !regallocA64AppendStore(
               out.prologueWords, a64.A64X8,
               out.returnBufferSaveOffset, 8) ||
           out.prologueWords.len != ingressWord + 1:
            regallocA64FunctionFail(out,
                                   contract.RegallocA64RecipeErrorFrame,
                                   6)
            return out
        add(out.abiIngressRegs, a64.A64X8)
        add(out.abiIngressOffsets, out.returnBufferSaveOffset)
        add(out.abiIngressParamOrdinals, -1)
        add(out.abiIngressValueIds, -1)
        add(out.abiIngressWidths, 8)
        add(out.abiIngressWordIndices, ingressWord)
        add(out.abiIngressWordCounts, 1)
    for calleeIndex in 0..<out.calleeSavedRegs.len:
        if !regallocA64AppendLoad(
               out.epilogueWords,
               out.calleeSavedRegs[calleeIndex],
               out.calleeSavedOffsets[calleeIndex], 8):
            regallocA64FunctionFail(out,
                                   contract.RegallocA64RecipeErrorFrame,
                                   8)
            return out
    add(out.epilogueWords, Value(a64.A64EncLdp64(
        a64.A64FP, a64.A64LR, a64.A64SP, int64(0))))
    if !regallocA64AppendSpAdjust(out.epilogueWords,
                                  out.frameBytes, false):
        regallocA64FunctionFail(out, contract.RegallocA64RecipeErrorFrame, 9)
        return out
    add(out.epilogueWords, a64.A64EncRet())
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.consumerOrdinal != actionIndex:
            regallocA64FunctionFail(out,
                                   contract.RegallocA64RecipeErrorAction,
                                   actionIndex)
            return out
        let recipe = regallocA64BuildRecipe(
            bodyIR, slotDataSymbols, cstringDataSymbols,
            projectionRequired, table, plan, out.localStackOffsets,
            out.returnBufferSaveOffset, action)
        let recipeValid = recipe.valid
        let recipeErrorCode = recipe.errorCode
        let recipeErrorDetail = recipe.errorDetail
        add(out.recipes, recipe)
        if !recipeValid:
            regallocA64FunctionFail(out, recipeErrorCode,
                                   recipeErrorDetail)
            return out
    var opOwners = regallocA64IntSeq(bodyIR.ops.len, -1)
    var termOwners = regallocA64IntSeq(bodyIR.terms.len, -1)
    for blockIndex in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockIndex]
        if block.opStart < 0 || block.opCount < 0 ||
           block.opStart > bodyIR.ops.len - block.opCount ||
           block.termIndex < 0 || block.termIndex >= bodyIR.terms.len ||
           termOwners[block.termIndex] >= 0:
            regallocA64FunctionFail(
                out, contract.RegallocA64RecipeErrorBody, blockIndex)
            return out
        termOwners[block.termIndex] = blockIndex
        for opIndex in block.opStart..<(block.opStart + block.opCount):
            if opOwners[opIndex] >= 0:
                regallocA64FunctionFail(
                    out, contract.RegallocA64RecipeErrorBody, opIndex)
                return out
            opOwners[opIndex] = blockIndex
    for opIndex in 0..<bodyIR.ops.len:
        if opOwners[opIndex] < 0:
            regallocA64FunctionFail(
                out, contract.RegallocA64RecipeErrorBody, opIndex)
            return out
        let ownerBlock = opOwners[opIndex]
        if ownerBlock < plan.blockEntryPositions.len &&
           plan.blockEntryPositions[ownerBlock] >= 0:
            let opRecipe = regallocA64BuildOpRecipe(
                bodyIR, slotDataSymbols, projectionRequired,
                table, plan, out.localStackOffsets,
                out.epilogueWords, opIndex, ownerBlock)
            let opRecipeValid = opRecipe.valid
            let opRecipeErrorCode = opRecipe.errorCode
            let opRecipeErrorDetail = opRecipe.errorDetail
            add(out.opRecipes, opRecipe)
            if !opRecipeValid:
                regallocA64FunctionFail(out, opRecipeErrorCode,
                                       opRecipeErrorDetail)
                return out
        else:
            var opRecipe: contract.RegallocA64SiteRecipe
            opRecipe.valid = true
            opRecipe.siteKind = bodyaccess.BodyIrAccessSiteOp
            opRecipe.siteIndex = opIndex
            opRecipe.blockIndex = ownerBlock
            opRecipe.irKind = bodyIR.ops[opIndex].kind
            add(out.opRecipes, opRecipe)
    for termIndex in 0..<bodyIR.terms.len:
        if termOwners[termIndex] < 0:
            regallocA64FunctionFail(
                out, contract.RegallocA64RecipeErrorBody, termIndex)
            return out
        let ownerBlock = termOwners[termIndex]
        if ownerBlock < plan.blockEntryPositions.len &&
           plan.blockEntryPositions[ownerBlock] >= 0:
            let termRecipe = regallocA64BuildTermRecipe(
                bodyIR, table, plan, out.localStackOffsets,
                out.epilogueWords,
                termIndex, ownerBlock)
            let termRecipeValid = termRecipe.valid
            let termRecipeErrorCode = termRecipe.errorCode
            let termRecipeErrorDetail = termRecipe.errorDetail
            add(out.termRecipes, termRecipe)
            if !termRecipeValid:
                regallocA64FunctionFail(out, termRecipeErrorCode,
                                       termRecipeErrorDetail)
                return out
        else:
            var termRecipe: contract.RegallocA64SiteRecipe
            termRecipe.valid = true
            termRecipe.siteKind = bodyaccess.BodyIrAccessSiteTerm
            termRecipe.siteIndex = termIndex
            termRecipe.blockIndex = ownerBlock
            termRecipe.irKind = bodyIR.terms[termIndex].kind
            add(out.termRecipes, termRecipe)
    if !regallocA64ComposeFunction(bodyIR, plan, out):
        regallocA64FunctionFail(out,
                               contract.RegallocA64RecipeErrorEncoding,
                               out.functionWords.len)
        return out
    return out

@borrows
fn RegallocA64PrepareFunctionActionRecipesWithDataSymbolProjection(
        bodyIR: var coreir.BodyIR,
        plan: var alloc.RegallocSinglePassValuePlan,
        slotDataSymbols: var str[],
        cstringDataSymbols: var str[]): contract.RegallocA64FunctionRecipes =
    return RegallocA64PrepareFunctionActionRecipesWithDataProjection(
        bodyIR, plan, slotDataSymbols, cstringDataSymbols, true)

@borrows
fn RegallocA64PrepareFunctionActionRecipes(
        bodyIR: var coreir.BodyIR,
        plan: var alloc.RegallocSinglePassValuePlan): contract.RegallocA64FunctionRecipes =
    var slotDataSymbols: str[]
    var cstringDataSymbols: str[]
    return RegallocA64PrepareFunctionActionRecipesWithDataProjection(
        bodyIR, plan, slotDataSymbols, cstringDataSymbols, false)

@borrows
fn RegallocA64ActionRecipeWordCount(
        recipe: contract.RegallocA64ActionRecipe): int32 =
    if !recipe.valid:
        return -1
    return recipe.words.len

@borrows
fn RegallocA64ActionRecipeFill(
        recipe: contract.RegallocA64ActionRecipe,
        words: var int32[],
        offset: int32): int32 =
    if !recipe.valid || offset < 0 ||
       offset > words.len - recipe.words.len:
        return -1
    for wordIndex in 0..<recipe.words.len:
        words[offset + wordIndex] = recipe.words[wordIndex]
    return offset + recipe.words.len

@borrows
fn RegallocA64SiteRecipeWordCount(
        recipe: contract.RegallocA64SiteRecipe): int32 =
    if !recipe.valid:
        return -1
    return recipe.words.len

@borrows
fn RegallocA64SiteRecipeFill(
        recipe: contract.RegallocA64SiteRecipe,
        words: var int32[],
        offset: int32): int32 =
    if !recipe.valid || offset < 0 ||
       offset > words.len - recipe.words.len:
        return -1
    for wordIndex in 0..<recipe.words.len:
        words[offset + wordIndex] = recipe.words[wordIndex]
    return offset + recipe.words.len

@borrows
fn RegallocA64FunctionRecipeWordCount(
        recipe: contract.RegallocA64FunctionRecipes): int32 =
    if !recipe.valid:
        return -1
    return recipe.functionWords.len

@borrows
fn RegallocA64FunctionRecipeFill(
        recipe: contract.RegallocA64FunctionRecipes,
        words: var int32[],
        offset: int32): int32 =
    if !recipe.valid || offset < 0 ||
       offset > words.len - recipe.functionWords.len:
        return -1
    for wordIndex in 0..<recipe.functionWords.len:
        words[offset + wordIndex] = recipe.functionWords[wordIndex]
    return offset + recipe.functionWords.len

fn RegallocA64WordsSpMemoryCallEffectMask(
        words: var int32[]): int32 =
    return regallocA64WordsSpMemoryCallEffects(words)

# B1（2026-08-25）：契约单元派发注册（蓝图 3.2）。本 impl 承载 aarch64 单元
# 的 recipe 准备入口；data symbol projection 两列由内核侧构造后经契约统一
# 签名以字段投影传入（copy-in，与 emitter 原默认臂实参形态一致）。

fn RegallocA64CodegenUnitPrepareFunctionRecipes(
        bodyIR: var coreir.BodyIR,
        plan: var alloc.RegallocSinglePassValuePlan,
        symbolName: str,
        encoderSourceRow: int32,
        encoderSourceCid: layout.FixedBytes32,
        slotDataSymbols: var str[],
        cstringDataSymbols: var str[]): contract.RegallocA64FunctionRecipes =
    return RegallocA64PrepareFunctionActionRecipesWithDataSymbolProjection(
        bodyIR, plan, slotDataSymbols, cstringDataSymbols)

fn RegallocA64CodegenUnitRegister(): bool =
    return contract.CodegenUnitRegisterPrepareRecipes(
        contract.CodegenUnitA64,
        RegallocA64CodegenUnitPrepareFunctionRecipes)
