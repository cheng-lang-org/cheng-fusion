# bail44 helper B1 — IndexedMemberAddressSlotV2 base-kind expand (ghost-with-dead-wire).
#
# Status: SCAFFOLD / GHOST-WITH-DEAD-WIRE (same pattern as the retired Step 1 P4
# overlay scaffold).
#
# Design source: PrimaryBodyIrIndexedMemberAddressSlot (primary_object_plan.cheng:14344+).
# Current line 14419 base-kind gate:
#   if imvBaseKind != coreir.LocalAggregateTag && imvBaseKind != coreir.LocalPtrTag:
#       return false
# This rejects struct-by-value (LocalI64Tag wrapped struct head) and similar
# valid bases, surfacing as bail_44 → bodySemanticsMissing on indexed member
# stores like `arr[i].field = ...` when root binding kind escapes Aggregate/Ptr.
#
# B1 expand idea: also accept LocalI64Tag (raw integer/struct head) and
# LocalAggregateTag/LocalPtrTag (existing). LocalI32Tag/LocalF64Tag/LocalStrTag
# remain rejected (scalar/string roots cannot host indexed member addresses).
#
# This ghost module lands the algorithm + a stable wire so cold compiler resolves
# the module. The shared-file body change at primary_object_plan.cheng:14419 is
# deferred (op-lane shared file, cross-session per CLAUDE.md guideline).

import cheng/core/ir/core_types as coreir
import std/os
import std/strings

type
    Bail44ImaBaseDecision =
        accept: bool
        baseKind: int32
        rejectReason: int32
        # rejectReason codes: 0=ok, 1=invalid_kind_tag, 2=scalar_root_unsupported,
        # 3=string_root_unsupported, 4=already_supported_legacy.

    Bail44ImaEmitDecision =
        accept: bool
        baseDecision: Bail44ImaBaseDecision
        hasIndex: bool
        fieldOffset: int32
        emitOpCount: int32
        # emitOpCount = expected number of body-IR ops produced by accept path
        # (1 for direct base, 2 for indexed, 3 for indexed+field).

fn Bail44ImaBaseKindAccept(baseKind: int32): Bail44ImaBaseDecision =
    var d: Bail44ImaBaseDecision
    d.baseKind = baseKind
    d.accept = false
    d.rejectReason = 1
    if baseKind == coreir.LocalAggregateTag:
        d.accept = true
        d.rejectReason = 4
        return d
    if baseKind == coreir.LocalPtrTag:
        d.accept = true
        d.rejectReason = 4
        return d
    if baseKind == coreir.LocalI64Tag:
        # B1 expand: raw int64 base (struct-head materialised as i64) is a
        # legitimate IMA root when an indexed dereference plus field offset
        # follows. Legacy gate rejected this and emitted bail_44.
        d.accept = true
        d.rejectReason = 0
        return d
    if baseKind == coreir.LocalI32Tag:
        d.rejectReason = 2
        return d
    if baseKind == coreir.LocalF64Tag:
        d.rejectReason = 2
        return d
    if baseKind == coreir.LocalStrTag:
        d.rejectReason = 3
        return d
    return d

fn Bail44ImaEmitDecide(baseKind: int32,
                       hasIndex: bool,
                       fieldOffset: int32): Bail44ImaEmitDecision =
    var e: Bail44ImaEmitDecision
    e.baseDecision = Bail44ImaBaseKindAccept(baseKind)
    e.hasIndex = hasIndex
    e.fieldOffset = fieldOffset
    e.accept = false
    e.emitOpCount = 0
    if !e.baseDecision.accept:
        return e
    if !hasIndex:
        # IMA requires at least one `[i]` segment per legacy resolver contract
        # (primary_object_plan.cheng:14367); without it the simpler single-trailing
        # resolver applies.
        e.accept = false
        return e
    e.accept = true
    var ops: int32 = 1
    if hasIndex:
        ops = ops + 1
    if fieldOffset != 0:
        ops = ops + 1
    e.emitOpCount = ops

    let traceGate = os.GetEnv("CHENG_BAIL44_B1_DRYRUN")
    if traceGate == "1":
        var line: str = "[bail44-b1-dryrun] base_kind="
        line = line + strings.IntToStr(baseKind)
        line = line + " accept="
        if e.accept:
            line = line + "1"
        else:
            line = line + "0"
        line = line + " emit_ops="
        line = line + strings.IntToStr(e.emitOpCount)
        os.WriteLine(os.GetStderr(), line)
    return e

fn Bail44ImaEmitAcceptCount(decisions: Bail44ImaEmitDecision[]): int32 =
    var total: int32
    for di in 0..<len(decisions):
        if decisions[di].accept:
            total = total + 1
    return total
