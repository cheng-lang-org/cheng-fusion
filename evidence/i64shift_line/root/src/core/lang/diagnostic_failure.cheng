import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import std/seqs
import std/strings
import std/system

const DiagnosticFailureSchemaVersionLatest: int32 = 1
const DiagnosticFailureProducerParser: int32 = 1
const DiagnosticFailureSeverityError: int32 = 1
const DiagnosticFailureAnchorSource: int32 = 1
const DiagnosticFailureAnchorSpan: int32 = 2
const DiagnosticFailureAnchorParserNode: int32 = 3
const DiagnosticFailureAnchorOwnerDeclaration: int32 = 4
const DiagnosticFailureAnchorParserNodeOwnerDeclaration: int32 = 5
const DiagnosticFailureParserCode: str = "CHENG-SNAPSHOT-COMPILER-CSG"
const DiagnosticFailureLocalDocumentDomain: str = "cheng.compiler.diagnostic_failure.local_document"
const DiagnosticFailureLocalReceiptDomain: str = "cheng.compiler.diagnostic_failure.local_source_receipt"
const DiagnosticFailureRowProofDomain: str = "cheng.compiler.diagnostic_failure.row"
const DiagnosticFailureReceiptDomain: str = "cheng.compiler.diagnostic_failure.receipt"

type
    # Immutable after SealInto.  Every identity column is structural; source
    # paths, source lines and names are never admitted as producer identity.
    DiagnosticFailureArtifact =
        schemaVersion: int32
        producerKinds: int32[]
        producerSourceIndexes: int32[]
        producerSourceSnapshotCounts: int32[]
        producerSourceByteLengths: int32[]
        producerSourceIdentityReceiptCids: layout.FixedBytes32[]
        producerDocumentCids: layout.FixedBytes32[]
        producerContentCids: layout.FixedBytes32[]
        anchorKinds: int32[]
        parserNodeIds: int32[]
        ownerDeclarationSourceLocalRows: int32[]
        spanStartBytes: int32[]
        spanEndBytes: int32[]
        severities: int32[]
        codes: str[]
        messages: str[]
        proofCids: layout.FixedBytes32[]
        parserDiagnosticAuthorityRootCid: layout.FixedBytes32
        receiptCid: layout.FixedBytes32

    DiagnosticFailureArtifactReleaseReceipt =
        hadPayload: bool
        sequenceCapacityBefore: int64
        logicalStringCountBefore: int64
        physicalFreeCount: int64
        orcReleaseCount: int64
        storageReleased: bool

fn DiagnosticFailureArtifactReleased(
        artifact: var DiagnosticFailureArtifact): bool =
    return artifact.schemaVersion == 0 &&
           artifact.producerKinds.len == 0 &&
           artifact.producerKinds.cap == 0 &&
           artifact.producerSourceIndexes.len == 0 &&
           artifact.producerSourceIndexes.cap == 0 &&
           artifact.producerSourceSnapshotCounts.len == 0 &&
           artifact.producerSourceSnapshotCounts.cap == 0 &&
           artifact.producerSourceByteLengths.len == 0 &&
           artifact.producerSourceByteLengths.cap == 0 &&
           artifact.producerSourceIdentityReceiptCids.len == 0 &&
           artifact.producerSourceIdentityReceiptCids.cap == 0 &&
           artifact.producerDocumentCids.len == 0 &&
           artifact.producerDocumentCids.cap == 0 &&
           artifact.producerContentCids.len == 0 &&
           artifact.producerContentCids.cap == 0 &&
           artifact.anchorKinds.len == 0 &&
           artifact.anchorKinds.cap == 0 &&
           artifact.parserNodeIds.len == 0 &&
           artifact.parserNodeIds.cap == 0 &&
           artifact.ownerDeclarationSourceLocalRows.len == 0 &&
           artifact.ownerDeclarationSourceLocalRows.cap == 0 &&
           artifact.spanStartBytes.len == 0 &&
           artifact.spanStartBytes.cap == 0 &&
           artifact.spanEndBytes.len == 0 &&
           artifact.spanEndBytes.cap == 0 &&
           artifact.severities.len == 0 &&
           artifact.severities.cap == 0 &&
           artifact.codes.len == 0 &&
           artifact.codes.cap == 0 &&
           artifact.messages.len == 0 &&
           artifact.messages.cap == 0 &&
           artifact.proofCids.len == 0 &&
           artifact.proofCids.cap == 0 &&
           layout.FixedBytes32Equal(
               artifact.parserDiagnosticAuthorityRootCid,
               layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               artifact.receiptCid, layout.FixedBytes32())

fn DiagnosticFailureArtifactPhysicalBufferCount(
        artifact: var DiagnosticFailureArtifact): int32 =
    var count: int32
    if artifact.producerKinds.cap > 0:
        count = count + 1
    if artifact.producerSourceIndexes.cap > 0:
        count = count + 1
    if artifact.producerSourceSnapshotCounts.cap > 0:
        count = count + 1
    if artifact.producerSourceByteLengths.cap > 0:
        count = count + 1
    if artifact.producerSourceIdentityReceiptCids.cap > 0:
        count = count + 1
    if artifact.producerDocumentCids.cap > 0:
        count = count + 1
    if artifact.producerContentCids.cap > 0:
        count = count + 1
    if artifact.anchorKinds.cap > 0:
        count = count + 1
    if artifact.parserNodeIds.cap > 0:
        count = count + 1
    if artifact.ownerDeclarationSourceLocalRows.cap > 0:
        count = count + 1
    if artifact.spanStartBytes.cap > 0:
        count = count + 1
    if artifact.spanEndBytes.cap > 0:
        count = count + 1
    if artifact.severities.cap > 0:
        count = count + 1
    if artifact.codes.cap > 0:
        count = count + 1
    if artifact.messages.cap > 0:
        count = count + 1
    if artifact.proofCids.cap > 0:
        count = count + 1
    return count

fn DiagnosticFailureArtifactSequenceCapacity(
        artifact: var DiagnosticFailureArtifact): int64 =
    return Int64(artifact.producerKinds.cap) +
           Int64(artifact.producerSourceIndexes.cap) +
           Int64(artifact.producerSourceSnapshotCounts.cap) +
           Int64(artifact.producerSourceByteLengths.cap) +
           Int64(artifact.producerSourceIdentityReceiptCids.cap) +
           Int64(artifact.producerDocumentCids.cap) +
           Int64(artifact.producerContentCids.cap) +
           Int64(artifact.anchorKinds.cap) +
           Int64(artifact.parserNodeIds.cap) +
           Int64(artifact.ownerDeclarationSourceLocalRows.cap) +
           Int64(artifact.spanStartBytes.cap) +
           Int64(artifact.spanEndBytes.cap) +
           Int64(artifact.severities.cap) +
           Int64(artifact.codes.cap) +
           Int64(artifact.messages.cap) +
           Int64(artifact.proofCids.cap)

fn DiagnosticFailureArtifactLogicalStringCount(
        artifact: var DiagnosticFailureArtifact): int64 =
    var count: int64
    for row in 0..<artifact.codes.len:
        if artifact.codes[row] != "":
            count = count + Int64(1)
    for row in 0..<artifact.messages.len:
        if artifact.messages[row] != "":
            count = count + Int64(1)
    return count

fn DiagnosticFailureArtifactDynamicSequenceBytes(
        artifact: var DiagnosticFailureArtifact,
        retainedCapacity: bool): int64 =
    let producerKindSlots =
        retainedCapacity ? artifact.producerKinds.cap :
                           artifact.producerKinds.len
    let producerSourceIndexSlots =
        retainedCapacity ? artifact.producerSourceIndexes.cap :
                           artifact.producerSourceIndexes.len
    let producerSourceSnapshotCountSlots =
        retainedCapacity ? artifact.producerSourceSnapshotCounts.cap :
                           artifact.producerSourceSnapshotCounts.len
    let producerSourceByteLengthSlots =
        retainedCapacity ? artifact.producerSourceByteLengths.cap :
                           artifact.producerSourceByteLengths.len
    let sourceReceiptSlots =
        retainedCapacity ?
            artifact.producerSourceIdentityReceiptCids.cap :
            artifact.producerSourceIdentityReceiptCids.len
    let documentCidSlots =
        retainedCapacity ? artifact.producerDocumentCids.cap :
                           artifact.producerDocumentCids.len
    let contentCidSlots =
        retainedCapacity ? artifact.producerContentCids.cap :
                           artifact.producerContentCids.len
    let anchorKindSlots =
        retainedCapacity ? artifact.anchorKinds.cap :
                           artifact.anchorKinds.len
    let parserNodeSlots =
        retainedCapacity ? artifact.parserNodeIds.cap :
                           artifact.parserNodeIds.len
    let ownerDeclarationSlots =
        retainedCapacity ?
            artifact.ownerDeclarationSourceLocalRows.cap :
            artifact.ownerDeclarationSourceLocalRows.len
    let spanStartSlots =
        retainedCapacity ? artifact.spanStartBytes.cap :
                           artifact.spanStartBytes.len
    let spanEndSlots =
        retainedCapacity ? artifact.spanEndBytes.cap :
                           artifact.spanEndBytes.len
    let severitySlots =
        retainedCapacity ? artifact.severities.cap :
                           artifact.severities.len
    let codeSlots =
        retainedCapacity ? artifact.codes.cap : artifact.codes.len
    let messageSlots =
        retainedCapacity ? artifact.messages.cap : artifact.messages.len
    let proofSlots =
        retainedCapacity ? artifact.proofCids.cap :
                           artifact.proofCids.len
    let int32Slots = Int64(producerKindSlots) +
                     Int64(producerSourceIndexSlots) +
                     Int64(producerSourceSnapshotCountSlots) +
                     Int64(producerSourceByteLengthSlots) +
                     Int64(anchorKindSlots) +
                     Int64(parserNodeSlots) +
                     Int64(ownerDeclarationSlots) +
                     Int64(spanStartSlots) +
                     Int64(spanEndSlots) +
                     Int64(severitySlots)
    let cidSlots = Int64(sourceReceiptSlots) +
                   Int64(documentCidSlots) +
                   Int64(contentCidSlots) +
                   Int64(proofSlots)
    let stringSlots = Int64(codeSlots) + Int64(messageSlots)
    var total = int32Slots * Int64(sizeof(int32)) +
                cidSlots * Int64(sizeof(layout.FixedBytes32)) +
                stringSlots * Int64(sizeof(str))
    for row in 0..<artifact.codes.len:
        total = total + Int64(artifact.codes[row].len)
    for row in 0..<artifact.messages.len:
        total = total + Int64(artifact.messages[row].len)
    return total

fn DiagnosticFailureArtifactScalarBytes(
        artifact: var DiagnosticFailureArtifact): int64 =
    let _ = artifact
    return Int64(sizeof(DiagnosticFailureArtifact))

fn DiagnosticFailureArtifactReleaseInto(
        artifact: var DiagnosticFailureArtifact,
        receipt: var DiagnosticFailureArtifactReleaseReceipt) =
    receipt = DiagnosticFailureArtifactReleaseReceipt()
    receipt.sequenceCapacityBefore =
        DiagnosticFailureArtifactSequenceCapacity(artifact)
    receipt.logicalStringCountBefore =
        DiagnosticFailureArtifactLogicalStringCount(artifact)
    receipt.hadPayload = !DiagnosticFailureArtifactReleased(artifact)
    let physicalBufferCountBefore =
        DiagnosticFailureArtifactPhysicalBufferCount(artifact)
    let freeCountBefore = system.memFreeCount()
    let orcReleaseCountBefore = system.memReleaseCount()
    seqs.freeSeq(artifact.producerKinds)
    seqs.freeSeq(artifact.producerSourceIndexes)
    seqs.freeSeq(artifact.producerSourceSnapshotCounts)
    seqs.freeSeq(artifact.producerSourceByteLengths)
    seqs.freeSeq(artifact.producerSourceIdentityReceiptCids)
    seqs.freeSeq(artifact.producerDocumentCids)
    seqs.freeSeq(artifact.producerContentCids)
    seqs.freeSeq(artifact.anchorKinds)
    seqs.freeSeq(artifact.parserNodeIds)
    seqs.freeSeq(artifact.ownerDeclarationSourceLocalRows)
    seqs.freeSeq(artifact.spanStartBytes)
    seqs.freeSeq(artifact.spanEndBytes)
    seqs.freeSeq(artifact.severities)
    seqs.freeSeqStrRelease(artifact.codes)
    seqs.freeSeqStrRelease(artifact.messages)
    seqs.freeSeq(artifact.proofCids)
    artifact = DiagnosticFailureArtifact()
    receipt.physicalFreeCount =
        system.memFreeCount() - freeCountBefore
    receipt.orcReleaseCount =
        system.memReleaseCount() - orcReleaseCountBefore
    receipt.storageReleased =
        DiagnosticFailureArtifactReleased(artifact)
    if receipt.physicalFreeCount <
           Int64(physicalBufferCountBefore) ||
       !receipt.storageReleased:
        panic("diagnostic failure: artifact release incomplete")

fn diagnosticFailureArtifactDescriptorsAlias(
        out: var DiagnosticFailureArtifact,
        source: var DiagnosticFailureArtifact): bool =
    let sourceSchemaVersion = source.schemaVersion
    var aliasMarker: int32
    if out.schemaVersion == 0:
        aliasMarker = 1
    else:
        aliasMarker = 0
    source.schemaVersion = aliasMarker
    let aliases = out.schemaVersion == aliasMarker
    source.schemaVersion = sourceSchemaVersion
    return aliases

fn diagnosticFailureCheckedAdd(left: int32,
                               right: int32,
                               reason: str): int32 =
    if left < 0 || right < 0 || left > 2147483647 - right:
        panic(reason)
    return left + right

fn diagnosticFailureCheckedMul(left: int32,
                               right: int32,
                               reason: str): int32 =
    if left < 0 || right < 0 ||
       (right != 0 && left > 2147483647 / right):
        panic(reason)
    return left * right

fn diagnosticFailureAppendU32BE(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

@borrows
fn diagnosticFailureAppendText(buf: var layout.ByteBuf, value: str) =
    diagnosticFailureAppendU32BE(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

@borrows
fn diagnosticFailureAppendCid(
        buf: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    diagnosticFailureAppendU32BE(buf, layout.FixedBytes32Size)
    layout.ByteBufAppendFixed32(buf, value)

fn diagnosticFailureBufCid(buf: var layout.ByteBuf): layout.FixedBytes32 =
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn DiagnosticFailureSourceContentCid(
        sourceText: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(sourceText.len)
    for index in 0..<sourceText.len:
        layout.ByteBufAppendByte(buf, Int32(sourceText[index]) & 255)
    return diagnosticFailureBufCid(buf)

fn DiagnosticFailureLocalDocumentCid(
        sourceIndex: int32): layout.FixedBytes32 =
    if sourceIndex < 0:
        panic("diagnostic failure: negative local source index")
    var buf = layout.ByteBufInit(96)
    diagnosticFailureAppendText(buf, DiagnosticFailureLocalDocumentDomain)
    diagnosticFailureAppendU32BE(buf, sourceIndex)
    return diagnosticFailureBufCid(buf)

fn DiagnosticFailureLocalSourceIdentityReceiptCid(
        sourceIndex: int32,
        sourceSnapshotCount: int32,
        documentCid: layout.FixedBytes32,
        contentCid: layout.FixedBytes32): layout.FixedBytes32 =
    if sourceIndex < 0 || sourceSnapshotCount <= sourceIndex ||
       layout.FixedBytes32Equal(documentCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(contentCid, layout.FixedBytes32()):
        panic("diagnostic failure: invalid local source receipt")
    var buf = layout.ByteBufInit(192)
    diagnosticFailureAppendText(buf, DiagnosticFailureLocalReceiptDomain)
    diagnosticFailureAppendU32BE(buf, sourceIndex)
    diagnosticFailureAppendU32BE(buf, sourceSnapshotCount)
    diagnosticFailureAppendCid(buf, documentCid)
    diagnosticFailureAppendCid(buf, contentCid)
    return diagnosticFailureBufCid(buf)

fn DiagnosticFailureRowProofCid(
        artifact: var DiagnosticFailureArtifact,
        row: int32): layout.FixedBytes32 =
    if row < 0 || row >= artifact.producerKinds.len:
        return layout.FixedBytes32()
    let codeCapacity = diagnosticFailureCheckedAdd(
        256,
        artifact.codes[row].len,
        "diagnostic failure: row proof capacity overflow")
    let rowCapacity = diagnosticFailureCheckedAdd(
        codeCapacity,
        artifact.messages[row].len,
        "diagnostic failure: row proof capacity overflow")
    var buf = layout.ByteBufInit(rowCapacity)
    diagnosticFailureAppendText(buf, DiagnosticFailureRowProofDomain)
    diagnosticFailureAppendU32BE(buf, artifact.schemaVersion)
    diagnosticFailureAppendU32BE(buf, artifact.producerKinds[row])
    diagnosticFailureAppendU32BE(
        buf, artifact.producerSourceIndexes[row])
    diagnosticFailureAppendU32BE(
        buf, artifact.producerSourceSnapshotCounts[row])
    diagnosticFailureAppendU32BE(
        buf, artifact.producerSourceByteLengths[row])
    diagnosticFailureAppendCid(
        buf, artifact.producerSourceIdentityReceiptCids[row])
    diagnosticFailureAppendCid(buf, artifact.producerDocumentCids[row])
    diagnosticFailureAppendCid(buf, artifact.producerContentCids[row])
    diagnosticFailureAppendU32BE(buf, artifact.anchorKinds[row])
    diagnosticFailureAppendU32BE(buf, artifact.parserNodeIds[row])
    diagnosticFailureAppendU32BE(
        buf, artifact.ownerDeclarationSourceLocalRows[row])
    diagnosticFailureAppendU32BE(buf, artifact.spanStartBytes[row])
    diagnosticFailureAppendU32BE(buf, artifact.spanEndBytes[row])
    diagnosticFailureAppendU32BE(buf, artifact.severities[row])
    diagnosticFailureAppendText(buf, artifact.codes[row])
    diagnosticFailureAppendText(buf, artifact.messages[row])
    diagnosticFailureAppendCid(
        buf, artifact.parserDiagnosticAuthorityRootCid)
    return diagnosticFailureBufCid(buf)

fn DiagnosticFailureReceiptCid(
        artifact: var DiagnosticFailureArtifact): layout.FixedBytes32 =
    let proofBytes = diagnosticFailureCheckedMul(
        artifact.proofCids.len,
        layout.FixedBytes32Size,
        "diagnostic failure: receipt proof capacity overflow")
    let receiptCapacity = diagnosticFailureCheckedAdd(
        128,
        proofBytes,
        "diagnostic failure: receipt capacity overflow")
    var buf = layout.ByteBufInit(receiptCapacity)
    diagnosticFailureAppendText(buf, DiagnosticFailureReceiptDomain)
    diagnosticFailureAppendU32BE(buf, artifact.schemaVersion)
    diagnosticFailureAppendU32BE(buf, artifact.proofCids.len)
    for row in 0..<artifact.proofCids.len:
        diagnosticFailureAppendCid(buf, artifact.proofCids[row])
    return diagnosticFailureBufCid(buf)

fn DiagnosticFailureArtifactStrictValidateInto(
        artifact: var DiagnosticFailureArtifact,
        err: var str): bool =
    let rowCount = artifact.producerKinds.len
    if artifact.schemaVersion != DiagnosticFailureSchemaVersionLatest ||
       rowCount <= 0 ||
       rowCount != artifact.producerSourceIndexes.len ||
       rowCount != artifact.producerSourceSnapshotCounts.len ||
       rowCount != artifact.producerSourceByteLengths.len ||
       rowCount != artifact.producerSourceIdentityReceiptCids.len ||
       rowCount != artifact.producerDocumentCids.len ||
       rowCount != artifact.producerContentCids.len ||
       rowCount != artifact.anchorKinds.len ||
       rowCount != artifact.parserNodeIds.len ||
       rowCount != artifact.ownerDeclarationSourceLocalRows.len ||
       rowCount != artifact.spanStartBytes.len ||
       rowCount != artifact.spanEndBytes.len ||
       rowCount != artifact.severities.len ||
       rowCount != artifact.codes.len ||
       rowCount != artifact.messages.len ||
       rowCount != artifact.proofCids.len:
        err = " diagnostic failure: artifact columns split"
        return false
    for row in 0..<rowCount:
        let anchor = artifact.anchorKinds[row]
        let needsParser =
            anchor == DiagnosticFailureAnchorParserNode ||
            anchor ==
                DiagnosticFailureAnchorParserNodeOwnerDeclaration
        let needsOwner =
            anchor == DiagnosticFailureAnchorOwnerDeclaration ||
            anchor ==
                DiagnosticFailureAnchorParserNodeOwnerDeclaration
        if artifact.producerKinds[row] !=
               DiagnosticFailureProducerParser ||
           artifact.producerSourceIndexes[row] < 0 ||
           artifact.producerSourceSnapshotCounts[row] <=
               artifact.producerSourceIndexes[row] ||
           artifact.producerSourceByteLengths[row] < 0 ||
           layout.FixedBytes32Equal(
               artifact.producerSourceIdentityReceiptCids[row],
               layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(
               artifact.producerDocumentCids[row],
               layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(
               artifact.producerContentCids[row],
               layout.FixedBytes32()) ||
           anchor < DiagnosticFailureAnchorSource ||
           anchor >
               DiagnosticFailureAnchorParserNodeOwnerDeclaration ||
           artifact.spanStartBytes[row] < 0 ||
           artifact.spanEndBytes[row] <
               artifact.spanStartBytes[row] ||
           artifact.spanEndBytes[row] >
               artifact.producerSourceByteLengths[row] ||
           (needsParser && artifact.parserNodeIds[row] < 0) ||
           (!needsParser && artifact.parserNodeIds[row] != -1) ||
           (needsOwner &&
            artifact.ownerDeclarationSourceLocalRows[row] < 0) ||
           (!needsOwner &&
            artifact.ownerDeclarationSourceLocalRows[row] != -1) ||
           artifact.severities[row] !=
               DiagnosticFailureSeverityError ||
           artifact.codes[row] != DiagnosticFailureParserCode ||
           artifact.messages[row] == "" ||
           !layout.FixedBytes32Equal(
               DiagnosticFailureRowProofCid(artifact, row),
               artifact.proofCids[row]):
            err = " diagnostic failure: invalid parser failure row"
            return false
    if !layout.FixedBytes32Equal(
           DiagnosticFailureReceiptCid(artifact),
           artifact.receiptCid):
        err = " diagnostic failure: receipt mismatch"
        return false
    err = ""
    return true

fn DiagnosticFailureArtifactBindParserAuthorityInto(
        artifact: var DiagnosticFailureArtifact,
        parserDiagnosticAuthorityRootCid: layout.FixedBytes32,
        err: var str): bool =
    if layout.FixedBytes32Equal(
           parserDiagnosticAuthorityRootCid,
           layout.FixedBytes32()) ||
       !DiagnosticFailureArtifactStrictValidateInto(artifact, err):
        if err == "":
            err = " diagnostic failure: parser authority missing"
        return false
    artifact.parserDiagnosticAuthorityRootCid =
        parserDiagnosticAuthorityRootCid
    for row in 0..<artifact.proofCids.len:
        artifact.proofCids[row] =
            DiagnosticFailureRowProofCid(artifact, row)
    artifact.receiptCid = DiagnosticFailureReceiptCid(artifact)
    return DiagnosticFailureArtifactStrictValidateInto(artifact, err)

fn DiagnosticFailureArtifactPortableAuthorityStrictValidateInto(
        artifact: var DiagnosticFailureArtifact,
        sourceIdentityReceiptCid: layout.FixedBytes32,
        producerDocumentCids: layout.FixedBytes32[],
        producerContentCids: layout.FixedBytes32[],
        err: var str): bool =
    if producerDocumentCids.len <= 0 ||
       producerDocumentCids.len != producerContentCids.len ||
       layout.FixedBytes32Equal(
           sourceIdentityReceiptCid, layout.FixedBytes32()) ||
       !DiagnosticFailureArtifactStrictValidateInto(artifact, err):
        if err == "":
            err = " diagnostic failure: portable source authority invalid"
        return false
    let sourceCount = producerDocumentCids.len
    for row in 0..<artifact.producerKinds.len:
        let producerSourceIndex =
            artifact.producerSourceIndexes[row]
        if producerSourceIndex < 0 ||
           producerSourceIndex >= sourceCount ||
           artifact.producerSourceSnapshotCounts[row] != sourceCount ||
           !layout.FixedBytes32Equal(
               artifact.producerSourceIdentityReceiptCids[row],
               sourceIdentityReceiptCid) ||
           !layout.FixedBytes32Equal(
               artifact.producerDocumentCids[row],
               producerDocumentCids[producerSourceIndex]) ||
           !layout.FixedBytes32Equal(
               artifact.producerContentCids[row],
               producerContentCids[producerSourceIndex]):
            err = " diagnostic failure: portable source authority split"
            return false
    err = ""
    return true

@borrows
fn diagnosticFailureArtifactSealParserIdentityInto(
        sourceText: str,
        producerSourceIndex: int32,
        producerSourceSnapshotCount: int32,
        producerSourceIdentityReceiptCid: layout.FixedBytes32,
        producerDocumentCid: layout.FixedBytes32,
        producerContentCid: layout.FixedBytes32,
        anchorKind: int32,
        parserNodeId: int32,
        ownerDeclarationSourceLocalRow: int32,
        spanStartByte: int32,
        spanEndByte: int32,
        message: str,
        out: var DiagnosticFailureArtifact,
        err: var str): bool =
    if producerSourceIndex < 0 ||
       producerSourceSnapshotCount <= producerSourceIndex ||
       layout.FixedBytes32Equal(
           producerSourceIdentityReceiptCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           producerDocumentCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           producerContentCid,
           DiagnosticFailureSourceContentCid(sourceText)):
        err = " diagnostic failure: parser source identity invalid"
        return false
    var staged: DiagnosticFailureArtifact
    staged.schemaVersion = DiagnosticFailureSchemaVersionLatest
    add(staged.producerKinds, DiagnosticFailureProducerParser)
    add(staged.producerSourceIndexes, producerSourceIndex)
    add(staged.producerSourceSnapshotCounts,
        producerSourceSnapshotCount)
    add(staged.producerSourceByteLengths, sourceText.len)
    add(staged.producerSourceIdentityReceiptCids,
        producerSourceIdentityReceiptCid)
    add(staged.producerDocumentCids, producerDocumentCid)
    add(staged.producerContentCids, producerContentCid)
    add(staged.anchorKinds, anchorKind)
    add(staged.parserNodeIds, parserNodeId)
    add(staged.ownerDeclarationSourceLocalRows,
        ownerDeclarationSourceLocalRow)
    add(staged.spanStartBytes, spanStartByte)
    add(staged.spanEndBytes, spanEndByte)
    add(staged.severities, DiagnosticFailureSeverityError)
    add(staged.codes, strings.CloneStr(DiagnosticFailureParserCode))
    add(staged.messages, strings.CloneStr(message))
    add(staged.proofCids, DiagnosticFailureRowProofCid(staged, 0))
    staged.receiptCid = DiagnosticFailureReceiptCid(staged)
    if !DiagnosticFailureArtifactStrictValidateInto(staged, err):
        var releaseReceipt: DiagnosticFailureArtifactReleaseReceipt
        DiagnosticFailureArtifactReleaseInto(staged, releaseReceipt)
        return false
    DiagnosticFailureArtifactMoveInto(out, staged)
    err = ""
    return true

@borrows
fn DiagnosticFailureArtifactSealParserLocalInto(
        sourceText: str,
        localSourceIndex: int32,
        anchorKind: int32,
        parserNodeId: int32,
        ownerDeclarationSourceLocalRow: int32,
        spanStartByte: int32,
        spanEndByte: int32,
        message: str,
        out: var DiagnosticFailureArtifact,
        err: var str): bool =
    let localSourceCount = diagnosticFailureCheckedAdd(
        localSourceIndex,
        1,
        "diagnostic failure: local source count overflow")
    let contentCid = DiagnosticFailureSourceContentCid(sourceText)
    let documentCid =
        DiagnosticFailureLocalDocumentCid(localSourceIndex)
    let sourceReceiptCid =
        DiagnosticFailureLocalSourceIdentityReceiptCid(
            localSourceIndex,
            localSourceCount,
            documentCid,
            contentCid)
    return diagnosticFailureArtifactSealParserIdentityInto(
        sourceText,
        localSourceIndex,
        localSourceCount,
        sourceReceiptCid,
        documentCid,
        contentCid,
        anchorKind,
        parserNodeId,
        ownerDeclarationSourceLocalRow,
        spanStartByte,
        spanEndByte,
        message,
        out,
        err)

@borrows
fn DiagnosticFailureArtifactSealParserPortableInto(
        sourceText: str,
        producerSourceIndex: int32,
        producerSourceSnapshotCount: int32,
        producerSourceIdentityReceiptCid: layout.FixedBytes32,
        producerDocumentCid: layout.FixedBytes32,
        producerContentCid: layout.FixedBytes32,
        anchorKind: int32,
        parserNodeId: int32,
        ownerDeclarationSourceLocalRow: int32,
        spanStartByte: int32,
        spanEndByte: int32,
        message: str,
        out: var DiagnosticFailureArtifact,
        err: var str): bool =
    return diagnosticFailureArtifactSealParserIdentityInto(
        sourceText,
        producerSourceIndex,
        producerSourceSnapshotCount,
        producerSourceIdentityReceiptCid,
        producerDocumentCid,
        producerContentCid,
        anchorKind,
        parserNodeId,
        ownerDeclarationSourceLocalRow,
        spanStartByte,
        spanEndByte,
        message,
        out,
        err)

fn DiagnosticFailureArtifactMoveInto(
        out: var DiagnosticFailureArtifact,
        source: var DiagnosticFailureArtifact) =
    var sourceErr: str
    if !DiagnosticFailureArtifactStrictValidateInto(source, sourceErr):
        panic(sourceErr)
    if diagnosticFailureArtifactDescriptorsAlias(out, source):
        panic("diagnostic failure: artifact move source aliases destination descriptor")
    var releaseReceipt: DiagnosticFailureArtifactReleaseReceipt
    DiagnosticFailureArtifactReleaseInto(out, releaseReceipt)
    out = source
    source = DiagnosticFailureArtifact()
    var outErr: str
    if !DiagnosticFailureArtifactStrictValidateInto(out, outErr):
        panic(outErr)
    if !DiagnosticFailureArtifactReleased(source):
        panic("diagnostic failure: artifact move source retained payload")

fn DiagnosticFailureArtifactCloneInto(
        source: var DiagnosticFailureArtifact,
        out: var DiagnosticFailureArtifact,
        err: var str): bool =
    if !DiagnosticFailureArtifactStrictValidateInto(source, err):
        return false
    var staged: DiagnosticFailureArtifact
    staged.schemaVersion = source.schemaVersion
    for row in 0..<source.producerKinds.len:
        add(staged.producerKinds, source.producerKinds[row])
        add(staged.producerSourceIndexes,
            source.producerSourceIndexes[row])
        add(staged.producerSourceSnapshotCounts,
            source.producerSourceSnapshotCounts[row])
        add(staged.producerSourceByteLengths,
            source.producerSourceByteLengths[row])
        add(staged.producerSourceIdentityReceiptCids,
            source.producerSourceIdentityReceiptCids[row])
        add(staged.producerDocumentCids,
            source.producerDocumentCids[row])
        add(staged.producerContentCids,
            source.producerContentCids[row])
        add(staged.anchorKinds, source.anchorKinds[row])
        add(staged.parserNodeIds, source.parserNodeIds[row])
        add(staged.ownerDeclarationSourceLocalRows,
            source.ownerDeclarationSourceLocalRows[row])
        add(staged.spanStartBytes, source.spanStartBytes[row])
        add(staged.spanEndBytes, source.spanEndBytes[row])
        add(staged.severities, source.severities[row])
        add(staged.codes, strings.CloneStr(source.codes[row]))
        add(staged.messages, strings.CloneStr(source.messages[row]))
        add(staged.proofCids, source.proofCids[row])
    staged.parserDiagnosticAuthorityRootCid =
        source.parserDiagnosticAuthorityRootCid
    staged.receiptCid = source.receiptCid
    if !DiagnosticFailureArtifactStrictValidateInto(staged, err):
        var releaseReceipt: DiagnosticFailureArtifactReleaseReceipt
        DiagnosticFailureArtifactReleaseInto(staged, releaseReceipt)
        return false
    DiagnosticFailureArtifactMoveInto(out, staged)
    err = ""
    return true
