fn ParserValueExprAppendEnumVariantInto(
        tree: var ParserValueExprTree,
        declarationRoot: int32,
        nameTokenIndex: int32,
        payloadTypeSyntaxNodeIndex: int32,
        err: var str): bool =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       declarationRoot < 0 || declarationRoot >= tree.typeSyntaxCount ||
       ParserValueExprTypeSyntaxKindAt(tree, declarationRoot) !=
           ParserTypeSyntaxEnum ||
       ParserValueExprTypeSyntaxRootKindAt(tree, declarationRoot) !=
           ParserTypeSyntaxRootTypeDeclarationRhs ||
       ParserValueExprTypeSyntaxDeclarationOwnerAt(
           tree, declarationRoot) != declarationRoot ||
       nameTokenIndex < 0 || nameTokenIndex >= tree.tokenCount ||
       !ParserValueExprTokenCanName(
           ParserValueExprTokenKindAt(tree, nameTokenIndex)) ||
       payloadTypeSyntaxNodeIndex < -1 ||
       payloadTypeSyntaxNodeIndex >= tree.typeSyntaxCount:
        err = "parser type syntax: enum variant authority invalid"
        return false
    let producerSourceIndex =
        ParserValueExprTypeSyntaxProducerSourceIndexAt(tree, declarationRoot)
    let declarationOwnerToken =
        ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
            tree, declarationRoot)
    if ParserValueExprTokenSourceIdAt(tree, nameTokenIndex) !=
           ParserValueExprTypeSyntaxSourceIdAt(tree, declarationRoot):
        err = "parser type syntax: enum variant crosses source identity"
        return false
    let existingCount = ParserValueExprTypeSyntaxEnumVariantCountAt(
        tree, declarationRoot)
    var variantStart = ParserValueExprTypeSyntaxColumnAt(
        tree, tree.typeSyntaxEnumVariantStarts, declarationRoot)
    if existingCount == 0:
        if variantStart != -1:
            err = "parser type syntax: enum variant CSR start invalid"
            return false
        variantStart = tree.typeEnumVariantCount
        arenamod.ArenaArrayInt32Set(
            tree.arena,
            tree.typeSyntaxEnumVariantStarts,
            declarationRoot,
            variantStart)
    elif variantStart < 0 ||
         variantStart + existingCount != tree.typeEnumVariantCount:
        err = "parser type syntax: enum variant CSR is not contiguous"
        return false
    for offset in 0..<existingCount:
        if ParserValueExprNameTokenTextEqualsToken(
               tree,
               ParserValueExprTypeSyntaxEnumVariantNameTokenAt(
                   tree, declarationRoot, offset),
               nameTokenIndex):
            err = "parser type syntax: duplicate enum variant name"
            return false
    if payloadTypeSyntaxNodeIndex >= 0 &&
       (ParserValueExprTypeSyntaxProducerSourceIndexAt(
            tree, payloadTypeSyntaxNodeIndex) != producerSourceIndex ||
        ParserValueExprTypeSyntaxRootKindAt(
            tree, payloadTypeSyntaxNodeIndex) !=
            ParserTypeSyntaxRootInvalid ||
        ParserValueExprTypeSyntaxDeclarationOwnerAt(
            tree, payloadTypeSyntaxNodeIndex) != -1 ||
        ParserValueExprTypeSyntaxOwnerTokenAt(
            tree, payloadTypeSyntaxNodeIndex) != nameTokenIndex):
        err = "parser type syntax: enum payload TypeSyntax invalid"
        return false
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.typeEnumVariantProducerSourceIndexes,
        producerSourceIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.typeEnumVariantDeclarationOwnerNodeIndexes,
        declarationRoot)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.typeEnumVariantDeclarationOwnerTokenIndexes,
        declarationOwnerToken)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.typeEnumVariantNameTokenIndexes,
        nameTokenIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.typeEnumVariantOrdinals, existingCount)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.typeEnumVariantPayloadTypeSyntaxNodeIndexes,
        payloadTypeSyntaxNodeIndex)
    tree.typeEnumVariantCount = tree.typeEnumVariantCount + 1
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.typeSyntaxEnumVariantCounts,
        declarationRoot,
        existingCount + 1)
    err = ""
    return true

@borrows
fn ParserValueExprTreeEnumVariantsStrictValidateInto(
        tree: ParserValueExprTree,
        err: var str): bool =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.typeEnumVariantCount < 0 ||
       tree.typeSyntaxEnumVariantStarts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxEnumVariantCounts.len != tree.typeSyntaxCount ||
       tree.typeEnumVariantProducerSourceIndexes.len !=
           tree.typeEnumVariantCount ||
       tree.typeEnumVariantDeclarationOwnerNodeIndexes.len !=
           tree.typeEnumVariantCount ||
       tree.typeEnumVariantDeclarationOwnerTokenIndexes.len !=
           tree.typeEnumVariantCount ||
       tree.typeEnumVariantNameTokenIndexes.len !=
           tree.typeEnumVariantCount ||
       tree.typeEnumVariantOrdinals.len != tree.typeEnumVariantCount ||
       tree.typeEnumVariantPayloadTypeSyntaxNodeIndexes.len !=
           tree.typeEnumVariantCount:
        err = "parser type syntax: enum variant authority shape invalid"
        return false
    var payloadSeen: bool[]
    setLen(payloadSeen, tree.typeSyntaxCount)
    var variantCursor: int32
    for row in 0..<tree.typeSyntaxCount:
        let variantStart = ParserValueExprTypeSyntaxColumnAt(
            tree, tree.typeSyntaxEnumVariantStarts, row)
        let variantCount = ParserValueExprTypeSyntaxEnumVariantCountAt(
            tree, row)
        let enumRoot = ParserValueExprTypeSyntaxKindAt(tree, row) ==
                           ParserTypeSyntaxEnum &&
                       ParserValueExprTypeSyntaxRootKindAt(tree, row) ==
                           ParserTypeSyntaxRootTypeDeclarationRhs
        if (variantCount == 0) != (variantStart == -1) ||
           (!enumRoot && variantCount != 0) ||
           (variantCount > 0 &&
            (variantStart != variantCursor ||
             variantStart + variantCount > tree.typeEnumVariantCount)):
            err = "parser type syntax: enum variant CSR invalid"
            return false
        if variantCount == 0:
            continue
        var names = ParserNameSeenSetInit(variantCount * 2)
        var previousNameToken: int32 = -1
        for variantOffset in 0..<variantCount:
            let variantRow = variantStart + variantOffset
            let producerSourceIndex = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.typeEnumVariantProducerSourceIndexes,
                variantRow)
            let declarationOwner = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.typeEnumVariantDeclarationOwnerNodeIndexes,
                variantRow)
            let declarationOwnerToken = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.typeEnumVariantDeclarationOwnerTokenIndexes,
                variantRow)
            let nameToken = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.typeEnumVariantNameTokenIndexes,
                variantRow)
            let ordinal = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.typeEnumVariantOrdinals, variantRow)
            let payloadTypeSyntaxNode = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.typeEnumVariantPayloadTypeSyntaxNodeIndexes,
                variantRow)
            if producerSourceIndex !=
                   ParserValueExprTypeSyntaxProducerSourceIndexAt(tree, row) ||
               declarationOwner != row ||
               declarationOwnerToken !=
                   ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                       tree, row) ||
               nameToken < 0 || nameToken >= tree.tokenCount ||
               nameToken <= previousNameToken ||
               !ParserValueExprTokenCanName(
                   ParserValueExprTokenKindAt(tree, nameToken)) ||
               ParserValueExprTokenSourceIdAt(tree, nameToken) !=
                   ParserValueExprTypeSyntaxSourceIdAt(tree, row) ||
               ordinal != variantOffset ||
               payloadTypeSyntaxNode < -1 ||
               payloadTypeSyntaxNode >= tree.typeSyntaxCount ||
               !ParserNameSeenSetInsert(tree, names, nameToken):
                err = "parser type syntax: enum variant row invalid"
                return false
            if payloadTypeSyntaxNode >= 0:
                if payloadSeen[payloadTypeSyntaxNode] ||
                   ParserValueExprTypeSyntaxProducerSourceIndexAt(
                       tree, payloadTypeSyntaxNode) != producerSourceIndex ||
                   ParserValueExprTypeSyntaxRootKindAt(
                       tree, payloadTypeSyntaxNode) !=
                       ParserTypeSyntaxRootInvalid ||
                   ParserValueExprTypeSyntaxDeclarationOwnerAt(
                       tree, payloadTypeSyntaxNode) != -1 ||
                   ParserValueExprTypeSyntaxOwnerTokenAt(
                       tree, payloadTypeSyntaxNode) != nameToken:
                    err = "parser type syntax: enum payload authority invalid"
                    return false
                payloadSeen[payloadTypeSyntaxNode] = true
            previousNameToken = nameToken
        variantCursor = variantCursor + variantCount
    if variantCursor != tree.typeEnumVariantCount:
        err = "parser type syntax: enum variant coverage invalid"
        return false
    err = ""
    return true

@borrows
fn ParserValueExprTreeGenericSymbolsStrictValidateInto(
        tree: ParserValueExprTree,
        err: var str): bool =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.typeGenericSymbolCount < 0 ||
       tree.typeGenericSymbolChildCount < 0 ||
       tree.typeGenericSymbolProducerSourceIndexes.len !=
           tree.typeGenericSymbolCount ||
       tree.typeGenericSymbolDeclarationOwnerTokenIndexes.len !=
           tree.typeGenericSymbolCount ||
       tree.typeGenericSymbolNameTokenIndexes.len !=
           tree.typeGenericSymbolCount ||
       tree.typeGenericSymbolOrdinals.len != tree.typeGenericSymbolCount ||
       tree.typeGenericSymbolSpanStarts.len !=
           tree.typeGenericSymbolCount ||
       tree.typeGenericSymbolSpanEnds.len != tree.typeGenericSymbolCount ||
       tree.typeGenericSymbolOwnerDeclarationRows.len !=
           tree.typeGenericSymbolCount ||
       tree.typeGenericSymbolOwnerTypeSyntaxNodeIndexes.len !=
           tree.typeGenericSymbolCount ||
       tree.typeGenericSymbolConstraintTypeSyntaxNodeIndexes.len !=
           tree.typeGenericSymbolCount ||
       tree.typeGenericSymbolDefaultTypeSyntaxNodeIndexes.len !=
           tree.typeGenericSymbolCount ||
       tree.typeGenericSymbolChildStarts.len !=
           tree.typeGenericSymbolCount ||
       tree.typeGenericSymbolChildCounts.len !=
           tree.typeGenericSymbolCount ||
       tree.typeGenericSymbolChildTypeSyntaxNodeIndexes.len !=
           tree.typeGenericSymbolChildCount:
        err = "parser type syntax: generic parameter authority shape invalid"
        return false
    var childSeen: bool[]
    setLen(childSeen, tree.typeSyntaxCount)
    var childCursor: int32
    for symbolRow in 0..<tree.typeGenericSymbolCount:
        let producerSourceIndex =
            ParserValueExprTypeGenericSymbolProducerSourceIndexAt(
                tree, symbolRow)
        let declarationOwnerToken =
            ParserValueExprTypeGenericSymbolDeclarationOwnerTokenAt(
                tree, symbolRow)
        let nameToken = ParserValueExprTypeGenericSymbolNameTokenAt(
            tree, symbolRow)
        let ordinal = ParserValueExprTypeGenericSymbolOrdinalAt(
            tree, symbolRow)
        let spanStart = ParserValueExprTypeGenericSymbolSpanStartAt(
            tree, symbolRow)
        let spanEnd = ParserValueExprTypeGenericSymbolSpanEndAt(
            tree, symbolRow)
        let ownerDeclarationRow =
            ParserValueExprTypeGenericSymbolOwnerDeclarationAt(
                tree, symbolRow)
        let ownerTypeSyntaxNode =
            ParserValueExprTypeGenericSymbolOwnerTypeSyntaxNodeAt(
                tree, symbolRow)
        let constraintTypeSyntaxNode =
            ParserValueExprTypeGenericSymbolConstraintTypeSyntaxNodeAt(
                tree, symbolRow)
        let defaultTypeSyntaxNode =
            ParserValueExprTypeGenericSymbolDefaultTypeSyntaxNodeAt(
                tree, symbolRow)
        let childStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeGenericSymbolChildStarts, symbolRow)
        let childCount = ParserValueExprTypeGenericSymbolChildCountAt(
            tree, symbolRow)
        let expectedChildCount =
            (constraintTypeSyntaxNode >= 0 ? 1 : 0) +
            (defaultTypeSyntaxNode >= 0 ? 1 : 0)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= tree.producerSourceCount ||
           declarationOwnerToken < 0 ||
           declarationOwnerToken >= tree.tokenCount ||
           nameToken < 0 || nameToken >= tree.tokenCount ||
           ParserValueExprTokenProducerSourceIndexAt(
               tree, declarationOwnerToken) != producerSourceIndex ||
           ParserValueExprTokenProducerSourceIndexAt(
               tree, nameToken) != producerSourceIndex ||
           !ParserValueExprTokenCanName(
               ParserValueExprTokenKindAt(tree, nameToken)) ||
           ordinal < 0 ||
           spanStart > ParserValueExprTokenStartAt(tree, nameToken) ||
           spanEnd < ParserValueExprTokenEndAt(tree, nameToken) ||
           spanStart < 0 || spanEnd <= spanStart ||
           ownerDeclarationRow < 0 ||
           ownerDeclarationRow >= tree.declarationCount ||
           ownerTypeSyntaxNode < -1 ||
           ownerTypeSyntaxNode >= tree.typeSyntaxCount ||
           constraintTypeSyntaxNode < -1 ||
           constraintTypeSyntaxNode >= tree.typeSyntaxCount ||
           defaultTypeSyntaxNode < -1 ||
           defaultTypeSyntaxNode >= tree.typeSyntaxCount ||
           childStart != childCursor || childCount != expectedChildCount ||
           childCount < 0 || childCount > 2 ||
           childStart >
               tree.typeGenericSymbolChildCount - childCount:
            err = "parser type syntax: generic symbol authority invalid"
            return false
        let ownerDeclarationKind = ParserDeclarationKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationKinds,
                ownerDeclarationRow))
        let ownerDeclarationGenericStart = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationGenericSymbolStarts,
            ownerDeclarationRow)
        let ownerDeclarationGenericCount = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationGenericSymbolCounts,
            ownerDeclarationRow)
        if (ownerDeclarationKind != ParserDeclarationType &&
            ownerDeclarationKind != ParserDeclarationFunction &&
            ownerDeclarationKind != ParserDeclarationConcept &&
            ownerDeclarationKind != ParserDeclarationTrait) ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationProducerSourceIndexes,
               ownerDeclarationRow) != producerSourceIndex ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationNameTokenIndexes,
               ownerDeclarationRow) != declarationOwnerToken ||
           ownerDeclarationGenericStart < 0 ||
           ownerDeclarationGenericCount <= 0 ||
           symbolRow < ownerDeclarationGenericStart ||
           symbolRow >= ownerDeclarationGenericStart +
               ownerDeclarationGenericCount ||
           ordinal != symbolRow - ownerDeclarationGenericStart:
            err = "parser type syntax: generic declaration owner invalid"
            return false
        if ownerTypeSyntaxNode >= 0:
            let ownerGenericStart =
                ParserValueExprTypeSyntaxGenericSymbolStartAt(
                    tree, ownerTypeSyntaxNode)
            let ownerGenericCount =
                ParserValueExprTypeSyntaxGenericSymbolCountAt(
                    tree, ownerTypeSyntaxNode)
            if ParserValueExprTypeSyntaxRootKindAt(
                   tree, ownerTypeSyntaxNode) ==
                   ParserTypeSyntaxRootInvalid ||
               ParserValueExprTypeSyntaxProducerSourceIndexAt(
                   tree, ownerTypeSyntaxNode) != producerSourceIndex ||
               ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                   tree, ownerTypeSyntaxNode) != declarationOwnerToken ||
               ownerGenericStart < 0 || ownerGenericCount <= 0 ||
               symbolRow < ownerGenericStart ||
               symbolRow >= ownerGenericStart + ownerGenericCount ||
               ordinal != symbolRow - ownerGenericStart:
                err = "parser type syntax: generic parameter owner root invalid"
                return false
        for childOffset in 0..<childCount:
            let child = ParserValueExprTypeGenericSymbolChildAt(
                tree, symbolRow, childOffset)
            let expectedChild =
                childOffset == 0 && constraintTypeSyntaxNode >= 0 ?
                    constraintTypeSyntaxNode : defaultTypeSyntaxNode
            let expectedRootKind =
                child == constraintTypeSyntaxNode ?
                    ParserTypeSyntaxRootGenericConstraint :
                    ParserTypeSyntaxRootGenericDefault
            if child < 0 || child >= tree.typeSyntaxCount ||
               child != expectedChild || childSeen[child] ||
               ParserValueExprTypeSyntaxRootKindAt(tree, child) !=
                   expectedRootKind ||
               ParserValueExprTypeSyntaxProducerSourceIndexAt(
                   tree, child) != producerSourceIndex ||
               ParserValueExprTypeSyntaxOwnerTokenAt(tree, child) !=
                   nameToken ||
               ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                   tree, child) != declarationOwnerToken ||
               ParserValueExprTypeSyntaxDeclarationOwnerAt(
                   tree, child) != -1 ||
               ParserValueExprTypeSyntaxSpanStartAt(tree, child) <
                   spanStart ||
               ParserValueExprTypeSyntaxSpanEndAt(tree, child) >
                   spanEnd:
                err = "parser type syntax: generic parameter child CSR invalid"
                return false
            childSeen[child] = true
        childCursor = childCursor + childCount
    if childCursor != tree.typeGenericSymbolChildCount:
        err = "parser type syntax: generic parameter child coverage invalid"
        return false
    err = ""
    return true

@borrows
fn parserTypeSyntaxConstExprMatchesTokenRangeInto(
        tree: ParserValueExprTree,
        rootIndex: int32,
        tokenStartRaw: int32,
        tokenLimitRaw: int32,
        producerSourceIndex: int32,
        visited: var bool[],
        err: var str): bool =
    var tokenStart = tokenStartRaw
    var tokenLimit = tokenLimitRaw
    while tokenStart < tokenLimit &&
          ParserValueExprTokenKindAt(tree, tokenStart) ==
              ParserValueTokenLeftParen:
        let closeIndex = ParserValueExprFindMatchingToken(
            tree,
            tokenStart,
            tokenLimit,
            ParserValueTokenLeftParen,
            ParserValueTokenRightParen)
        if closeIndex != tokenLimit - 1:
            break
        tokenStart = tokenStart + 1
        tokenLimit = tokenLimit - 1
    if rootIndex < 0 || rootIndex >= tree.typeConstExprCount ||
       tokenStart >= tokenLimit || visited.len != tree.typeConstExprCount:
        err = "parser type syntax: const token range shape invalid"
        return false
    var depth: int32
    var additiveSplit: int32 = -1
    var multiplicativeSplit: int32 = -1
    for tokenIndex in tokenStart..<tokenLimit:
        let tokenKind = ParserValueExprTokenKindAt(tree, tokenIndex)
        if ParserValueExprTokenProducerSourceIndexAt(
               tree, tokenIndex) != producerSourceIndex:
            err = "parser type syntax: const token source invalid"
            return false
        if tokenKind == ParserValueTokenLeftParen:
            depth = depth + 1
        elif tokenKind == ParserValueTokenRightParen:
            depth = depth - 1
            if depth < 0:
                err = "parser type syntax: const parentheses invalid"
                return false
        elif depth == 0:
            # [S1b step-3 (9)] An operand may also end in a module const NAME
            # (`SlotStep * 2`); the split scan must see it, or the binary node
            # would be judged against a single-token range.
            let previousCanEnd =
                tokenIndex > tokenStart &&
                (ParserValueExprTokenKindAt(tree, tokenIndex - 1) ==
                     ParserValueTokenInteger ||
                 ParserValueExprTokenKindAt(tree, tokenIndex - 1) ==
                     ParserValueTokenRightParen ||
                 parserTypeSyntaxTokenCanName(
                     ParserValueExprTokenKindAt(tree, tokenIndex - 1)))
            if previousCanEnd &&
               (tokenKind == ParserValueTokenPlus ||
                tokenKind == ParserValueTokenMinus):
                additiveSplit = tokenIndex
            elif previousCanEnd &&
                 (tokenKind == ParserValueTokenStar ||
                  tokenKind == ParserValueTokenSlash ||
                  tokenKind == ParserValueTokenPercent):
                multiplicativeSplit = tokenIndex
    if depth != 0:
        err = "parser type syntax: const parentheses invalid"
        return false
    let split = additiveSplit >= 0 ?
        additiveSplit : multiplicativeSplit
    let nodeKind = ParserTypeConstExprKind(
        arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeConstExprKinds, rootIndex))
    let nodeToken = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.typeConstExprTokenIndexes, rootIndex)
    let left = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.typeConstExprLeftChildIndexes, rootIndex)
    let right = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.typeConstExprRightChildIndexes, rootIndex)
    let integerValue = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.typeConstExprIntegerValues, rootIndex)
    if visited[rootIndex] ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.typeConstExprProducerSourceIndexes,
           rootIndex) != producerSourceIndex:
        err = "parser type syntax: const AST node reused"
        return false
    if split >= 0:
        let splitKind = ParserValueExprTokenKindAt(tree, split)
        var expectedKind = ParserTypeConstExprAdd
        if splitKind == ParserValueTokenMinus:
            expectedKind = ParserTypeConstExprSubtract
        elif splitKind == ParserValueTokenStar:
            expectedKind = ParserTypeConstExprMultiply
        elif splitKind == ParserValueTokenSlash:
            expectedKind = ParserTypeConstExprDivide
        elif splitKind == ParserValueTokenPercent:
            expectedKind = ParserTypeConstExprModulo
        if nodeKind != expectedKind || nodeToken != split ||
           integerValue != 0 || left < 0 || right < 0:
            err = "parser type syntax: const binary AST mismatch"
            return false
        visited[rootIndex] = true
        return parserTypeSyntaxConstExprMatchesTokenRangeInto(
                   tree,
                   left,
                   tokenStart,
                   split,
                   producerSourceIndex,
                   visited,
                   err) &&
               parserTypeSyntaxConstExprMatchesTokenRangeInto(
                   tree,
                   right,
                   split + 1,
                   tokenLimit,
                   producerSourceIndex,
                   visited,
                   err)
    let firstKind = ParserValueExprTokenKindAt(tree, tokenStart)
    if firstKind == ParserValueTokenPlus ||
       firstKind == ParserValueTokenMinus:
        let expectedKind = firstKind == ParserValueTokenPlus ?
            ParserTypeConstExprUnaryPlus :
            ParserTypeConstExprUnaryMinus
        if nodeKind != expectedKind || nodeToken != tokenStart ||
           integerValue != 0 || left < 0 || right != -1:
            err = "parser type syntax: const unary AST mismatch"
            return false
        visited[rootIndex] = true
        return parserTypeSyntaxConstExprMatchesTokenRangeInto(
            tree,
            left,
            tokenStart + 1,
            tokenLimit,
            producerSourceIndex,
            visited,
            err)
    # [S1b step-3 (9)] A name leaf covers exactly one namable token.  The
    # resolved value is NOT re-derived here: it was bound by the module const
    # table while the source was parsed, and the tree's identity row carries
    # (kind, token, value) so a drift changes that identity.  This matcher stays
    # purely structural on purpose -- it also runs over trees whose parse-phase
    # table is gone (merged forests and the canonical-source sidecar).
    if parserTypeSyntaxTokenCanName(firstKind):
        if tokenLimit != tokenStart + 1 ||
           nodeKind != ParserTypeConstExprName ||
           nodeToken != tokenStart || left != -1 || right != -1:
            err = "parser type syntax: const name AST mismatch"
            return false
        visited[rootIndex] = true
        return true
    if tokenLimit != tokenStart + 1 ||
       firstKind != ParserValueTokenInteger ||
       nodeKind != ParserTypeConstExprInteger ||
       nodeToken != tokenStart || left != -1 || right != -1:
        err = "parser type syntax: const integer AST mismatch"
        return false
    let spanStart = ParserValueExprTokenStartAt(tree, tokenStart)
    let spanEnd = ParserValueExprTokenEndAt(tree, tokenStart)
    let textLen = spanEnd - spanStart
    let text = langintern.LookupInternBorrowedText(
        tree.internPool,
        ParserValueExprTokenSourceIdAt(tree, tokenStart))
    var parsedValue: int64
    if textLen == 0:
        err = "parser type syntax: const integer token empty"
        return false
    for offset in 0..<textLen:
        if text[spanStart + offset] < '0' ||
           text[spanStart + offset] > '9':
            err = "parser type syntax: const integer token invalid"
            return false
        parsedValue = parsedValue * Int64(10) +
                      Int64(Int32(text[spanStart + offset]) - Int32('0'))
        if parsedValue > Int64(2147483647):
            err = "parser type syntax: const integer token overflow"
            return false
    if integerValue != Int32(parsedValue):
        err = "parser type syntax: const integer value mismatch"
        return false
    visited[rootIndex] = true
    return true

@borrows
fn ParserValueExprTreeTypeSyntaxBracketArgsStrictValidateInto(
        tree: ParserValueExprTree,
        err: var str): bool =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.typeSyntaxCount < 0 || tree.typeSyntaxChildCount < 0 ||
       tree.typeSyntaxBracketArgCount < 0 ||
       tree.typeSyntaxKinds.len != tree.typeSyntaxCount ||
       tree.typeSyntaxProducerSourceIndexes.len != tree.typeSyntaxCount ||
       tree.typeSyntaxSourceLocalRows.len != tree.typeSyntaxCount ||
       tree.typeSyntaxSpanStarts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxSpanEnds.len != tree.typeSyntaxCount ||
       tree.typeSyntaxOwnerTokenIndexes.len != tree.typeSyntaxCount ||
       tree.typeSyntaxDeclarationOwnerTokenIndexes.len !=
           tree.typeSyntaxCount ||
       tree.typeSyntaxDeclarationOwnerNodeIndexes.len !=
           tree.typeSyntaxCount ||
       tree.typeSyntaxRootKinds.len != tree.typeSyntaxCount ||
       tree.typeSyntaxChildStarts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxChildCounts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxChildNodeIndexes.len != tree.typeSyntaxChildCount ||
       tree.typeSyntaxBracketArgStarts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxBracketArgCounts.len != tree.typeSyntaxCount ||
       tree.typeSyntaxBracketArgTokenStarts.len !=
           tree.typeSyntaxBracketArgCount ||
       tree.typeSyntaxBracketArgTokenCounts.len !=
           tree.typeSyntaxBracketArgCount ||
       tree.typeSyntaxBracketArgTypeNodeIndexes.len !=
           tree.typeSyntaxBracketArgCount ||
       tree.typeSyntaxBracketArgConstExprRootIndexes.len !=
           tree.typeSyntaxBracketArgCount ||
       tree.typeSyntaxQuestionTokenIndexes.len != tree.typeSyntaxCount ||
       tree.typeConstExprCount < 0 ||
       tree.typeConstExprKinds.len != tree.typeConstExprCount ||
       tree.typeConstExprProducerSourceIndexes.len !=
           tree.typeConstExprCount ||
       tree.typeConstExprTokenIndexes.len != tree.typeConstExprCount ||
       tree.typeConstExprLeftChildIndexes.len != tree.typeConstExprCount ||
       tree.typeConstExprRightChildIndexes.len != tree.typeConstExprCount ||
       tree.typeConstExprIntegerValues.len != tree.typeConstExprCount:
        err = "parser type syntax: bracket type authority shape invalid"
        return false
    for constIndex in 0..<tree.typeConstExprCount:
        let constKind = ParserTypeConstExprKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena, tree.typeConstExprKinds, constIndex))
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.typeConstExprProducerSourceIndexes,
            constIndex)
        let tokenIndex = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeConstExprTokenIndexes, constIndex)
        let left = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeConstExprLeftChildIndexes, constIndex)
        let right = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeConstExprRightChildIndexes, constIndex)
        let integerValue = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeConstExprIntegerValues, constIndex)
        let integerNode = constKind == ParserTypeConstExprInteger
        let unaryNode = constKind == ParserTypeConstExprUnaryPlus ||
                        constKind == ParserTypeConstExprUnaryMinus
        let binaryNode = constKind == ParserTypeConstExprAdd ||
                         constKind == ParserTypeConstExprSubtract ||
                         constKind == ParserTypeConstExprMultiply ||
                         constKind == ParserTypeConstExprDivide ||
                         constKind == ParserTypeConstExprModulo
        # [S1b step-3 (9)] A name leaf carries the resolved int32 in the same
        # integer-value column an integer literal uses, and (like a literal)
        # owns no children.  Its token must be namable, so the value can never
        # hide behind a token the grammar would have rejected.
        let nameNode = constKind == ParserTypeConstExprName
        if producerSourceIndex < 0 ||
           producerSourceIndex >= tree.producerSourceCount ||
           tokenIndex < 0 || tokenIndex >= tree.tokenCount ||
           (integerNode && (left != -1 || right != -1)) ||
           (nameNode &&
            (left != -1 || right != -1 ||
             !ParserValueExprTokenCanName(
                 ParserValueExprTokenKindAt(tree, tokenIndex)))) ||
           (unaryNode &&
            (left < 0 || left >= constIndex || right != -1)) ||
           (binaryNode &&
            (left < 0 || left >= constIndex || right < 0 ||
             right >= constIndex)) ||
           ((unaryNode || binaryNode) && integerValue != 0) ||
           (!integerNode && !unaryNode && !binaryNode && !nameNode):
            err = "parser type syntax: const AST authority invalid"
            return false
    var constVisited: bool[]
    setLen(constVisited, tree.typeConstExprCount)
    var sourceTypeSyntaxRows: int32[]
    setLen(sourceTypeSyntaxRows, tree.producerSourceCount)
    var childCursor: int32
    var argCursor: int32
    for row in 0..<tree.typeSyntaxCount:
        let kind = ParserValueExprTypeSyntaxKindAt(tree, row)
        let producerSourceIndex =
            ParserValueExprTypeSyntaxProducerSourceIndexAt(tree, row)
        let sourceLocalRow =
            ParserValueExprTypeSyntaxSourceLocalRowAt(tree, row)
        let rootKind =
            ParserValueExprTypeSyntaxRootKindAt(tree, row)
        let declarationOwner =
            ParserValueExprTypeSyntaxDeclarationOwnerAt(tree, row)
        let declarationOwnerToken =
            ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(tree, row)
        let declarationRoot =
            rootKind == ParserTypeSyntaxRootTypeDeclarationRhs ||
            rootKind == ParserTypeSyntaxRootFieldDeclaration
        if declarationRoot:
            if !ParserValueExprTypeSyntaxDeclarationOwnerEdgeValid(
                   tree, row, declarationOwner) ||
               declarationOwnerToken < 0 ||
               declarationOwnerToken >= tree.tokenCount ||
               ParserValueExprTokenProducerSourceIndexAt(
                   tree, declarationOwnerToken) !=
                   ParserValueExprTypeSyntaxProducerSourceIndexAt(
                       tree, row) ||
               ParserValueExprTokenSourceIdAt(
                   tree, declarationOwnerToken) !=
                   ParserValueExprTypeSyntaxSourceIdAt(tree, row):
                err = "parser type syntax: declaration owner authority invalid"
                return false
            if rootKind == ParserTypeSyntaxRootTypeDeclarationRhs:
                if declarationOwnerToken !=
                       ParserValueExprTypeSyntaxOwnerTokenAt(tree, row):
                    err = "parser type syntax: declaration root token invalid"
                    return false
            elif declarationOwnerToken !=
                 ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                     tree, declarationOwner):
                err = "parser type syntax: nested declaration token drift"
                return false
        elif declarationOwner != -1:
            err = "parser type syntax: non-root declaration owner present"
            return false
        let childStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeSyntaxChildStarts, row)
        let childCount = ParserValueExprTypeSyntaxChildCountAt(tree, row)
        let argStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeSyntaxBracketArgStarts, row)
        let argCount = ParserValueExprTypeSyntaxBracketArgCountAt(tree, row)
        let questionToken =
            ParserValueExprTypeSyntaxQuestionTokenAt(tree, row)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= tree.producerSourceCount ||
           sourceLocalRow != sourceTypeSyntaxRows[producerSourceIndex] ||
           childStart != childCursor || childCount < 0 ||
           childStart + childCount > tree.typeSyntaxChildCount ||
           argStart != argCursor || argCount < 0 ||
           argStart + argCount > tree.typeSyntaxBracketArgCount:
            err = "parser type syntax: bracket type CSR range invalid"
            return false
        sourceTypeSyntaxRows[producerSourceIndex] =
            sourceTypeSyntaxRows[producerSourceIndex] + 1
        let fixedArray = kind == ParserTypeSyntaxFixedArray
        let bracketApply = kind == ParserTypeSyntaxBracketApply
        let optional = kind == ParserTypeSyntaxOptional
        let grouped = kind == ParserTypeSyntaxGrouped
        let objectType = kind == ParserTypeSyntaxObject ||
                         kind == ParserTypeSyntaxRefObject
        let implicitObject = kind == ParserTypeSyntaxImplicitObject
        if ((fixedArray || bracketApply) &&
            (argCount <= 0 || childCount <= 0)) ||
           (!fixedArray && !bracketApply && argCount != 0) ||
           (fixedArray && (argCount != 1 || childCount != 1)) ||
           (optional && childCount != 1) ||
           (grouped && childCount != 1) ||
           (objectType && childCount > 1) ||
           (implicitObject && childCount != 0) ||
           (optional != (questionToken >= 0)):
            err = "parser type syntax: bracket type node shape invalid"
            return false
        if objectType:
            let markerToken =
                ParserValueExprTypeSyntaxNameTokenAt(tree, row)
            let markerKind =
                markerToken >= 0 && markerToken < tree.tokenCount ?
                    ParserValueExprTokenKindAt(tree, markerToken) :
                    ParserValueTokenInvalid
            if markerToken < 0 || markerToken >= tree.tokenCount ||
               ParserValueExprTokenProducerSourceIndexAt(
                   tree, markerToken) !=
                   ParserValueExprTypeSyntaxProducerSourceIndexAt(tree, row) ||
               ParserValueExprTypeSyntaxSpanStartAt(tree, row) !=
                   ParserValueExprTokenStartAt(tree, markerToken) ||
               (kind == ParserTypeSyntaxObject &&
                markerKind != ParserValueTokenObject &&
                markerKind != ParserValueTokenOf) ||
               (kind == ParserTypeSyntaxRefObject &&
                markerKind != ParserValueTokenRef):
                err = "parser type syntax: object marker authority invalid"
                return false
            if childCount == 0:
                let bareObject =
                    kind == ParserTypeSyntaxObject &&
                    markerKind == ParserValueTokenObject &&
                    ParserValueExprTypeSyntaxSpanEndAt(tree, row) ==
                        ParserValueExprTokenEndAt(tree, markerToken)
                let explicitRefObject =
                    kind == ParserTypeSyntaxRefObject &&
                    markerToken + 1 < tree.tokenCount &&
                    ParserValueExprTokenKindAt(tree, markerToken + 1) ==
                        ParserValueTokenObject &&
                    ParserValueExprTokenProducerSourceIndexAt(
                        tree, markerToken + 1) ==
                        ParserValueExprTypeSyntaxProducerSourceIndexAt(
                            tree, row) &&
                    ParserValueExprTokenSourceIdAt(
                        tree, markerToken + 1) ==
                        ParserValueExprTypeSyntaxSourceIdAt(tree, row) &&
                    ParserValueExprTokenEndAt(tree, markerToken) <=
                        ParserValueExprTokenStartAt(
                            tree, markerToken + 1) &&
                    ParserValueExprTypeSyntaxSpanEndAt(tree, row) ==
                        ParserValueExprTokenEndAt(tree, markerToken + 1)
                if !bareObject && !explicitRefObject:
                    err = "parser type syntax: empty object span invalid"
                    return false
            else:
                let baseType =
                    ParserValueExprTypeSyntaxChildAt(tree, row, 0)
                var baseStartToken = markerToken + 1
                if kind == ParserTypeSyntaxRefObject:
                    baseStartToken = markerToken + 3
                elif markerKind == ParserValueTokenObject:
                    baseStartToken = markerToken + 2
                let ofToken = baseStartToken - 1
                let producerSource =
                    ParserValueExprTypeSyntaxProducerSourceIndexAt(
                        tree, row)
                let sourceTextId =
                    ParserValueExprTypeSyntaxSourceIdAt(tree, row)
                if baseStartToken <= markerToken ||
                   baseStartToken >= tree.tokenCount ||
                   ParserValueExprTokenKindAt(
                       tree, ofToken) !=
                       ParserValueTokenOf ||
                   ParserValueExprTokenProducerSourceIndexAt(
                       tree, ofToken) != producerSource ||
                   ParserValueExprTokenSourceIdAt(
                       tree, ofToken) != sourceTextId ||
                   (kind == ParserTypeSyntaxRefObject &&
                    (markerToken + 2 >= tree.tokenCount ||
                     ParserValueExprTokenKindAt(
                         tree, markerToken + 1) !=
                         ParserValueTokenObject ||
                     ParserValueExprTokenKindAt(
                         tree, markerToken + 2) !=
                         ParserValueTokenOf ||
                     ParserValueExprTokenProducerSourceIndexAt(
                         tree, markerToken + 1) != producerSource ||
                     ParserValueExprTokenSourceIdAt(
                         tree, markerToken + 1) != sourceTextId ||
                     ParserValueExprTokenEndAt(
                         tree, markerToken) >
                         ParserValueExprTokenStartAt(
                             tree, markerToken + 1) ||
                     ParserValueExprTokenEndAt(
                         tree, markerToken + 1) >
                         ParserValueExprTokenStartAt(tree, ofToken))) ||
                   baseType < 0 || baseType >= row ||
                   ParserValueExprTokenEndAt(tree, ofToken) >
                       ParserValueExprTypeSyntaxSpanStartAt(
                           tree, baseType) ||
                   ParserValueExprTypeSyntaxProducerSourceIndexAt(
                       tree, baseType) != producerSource ||
                   ParserValueExprTypeSyntaxSourceIdAt(
                       tree, baseType) != sourceTextId ||
                   ParserValueExprTypeSyntaxOwnerTokenAt(tree, baseType) !=
                       ParserValueExprTypeSyntaxOwnerTokenAt(tree, row) ||
                   ParserValueExprTypeSyntaxRootKindAt(tree, baseType) !=
                       ParserTypeSyntaxRootInvalid ||
                   ParserValueExprTypeSyntaxDeclarationOwnerAt(
                       tree, baseType) != -1 ||
                   ParserValueExprTypeSyntaxSpanStartAt(tree, baseType) !=
                       ParserValueExprTokenStartAt(tree, baseStartToken) ||
                   ParserValueExprTypeSyntaxSpanEndAt(tree, baseType) !=
                       ParserValueExprTypeSyntaxSpanEndAt(tree, row):
                    err = "parser type syntax: object inheritance edge invalid"
                    return false
        if grouped:
            let leftToken =
                ParserValueExprTypeSyntaxNameTokenAt(tree, row)
            let rightToken =
                leftToken >= 0 && leftToken < tree.tokenCount ?
                    ParserValueExprFindMatchingToken(
                        tree,
                        leftToken,
                        tree.tokenCount,
                        ParserValueTokenLeftParen,
                        ParserValueTokenRightParen) :
                    -1
            let child =
                ParserValueExprTypeSyntaxChildAt(tree, row, 0)
            let producerSource =
                ParserValueExprTypeSyntaxProducerSourceIndexAt(
                    tree, row)
            let sourceTextId =
                ParserValueExprTypeSyntaxSourceIdAt(tree, row)
            if leftToken < 0 || leftToken >= tree.tokenCount ||
               rightToken <= leftToken + 1 ||
               rightToken >= tree.tokenCount ||
               ParserValueExprTokenKindAt(tree, leftToken) !=
                   ParserValueTokenLeftParen ||
               ParserValueExprTokenKindAt(tree, rightToken) !=
                   ParserValueTokenRightParen ||
               ParserValueExprTokenProducerSourceIndexAt(
                   tree, leftToken) != producerSource ||
               ParserValueExprTokenProducerSourceIndexAt(
                   tree, rightToken) != producerSource ||
               ParserValueExprTokenSourceIdAt(
                   tree, leftToken) != sourceTextId ||
               ParserValueExprTokenSourceIdAt(
                   tree, rightToken) != sourceTextId ||
               ParserValueExprTypeSyntaxSpanStartAt(tree, row) !=
                   ParserValueExprTokenStartAt(tree, leftToken) ||
               ParserValueExprTypeSyntaxSpanEndAt(tree, row) !=
                   ParserValueExprTokenEndAt(tree, rightToken) ||
               child < 0 || child >= row ||
               ParserValueExprTypeSyntaxProducerSourceIndexAt(
                   tree, child) != producerSource ||
               ParserValueExprTypeSyntaxSourceIdAt(
                   tree, child) != sourceTextId ||
               ParserValueExprTypeSyntaxOwnerTokenAt(tree, child) !=
                   ParserValueExprTypeSyntaxOwnerTokenAt(tree, row) ||
               ParserValueExprTypeSyntaxRootKindAt(tree, child) !=
                   ParserTypeSyntaxRootInvalid ||
               ParserValueExprTypeSyntaxDeclarationOwnerAt(
                   tree, child) != -1 ||
               ParserValueExprTypeSyntaxSpanStartAt(tree, child) !=
                   ParserValueExprTokenStartAt(tree, leftToken + 1) ||
               ParserValueExprTypeSyntaxSpanEndAt(tree, child) !=
                   ParserValueExprTokenEndAt(tree, rightToken - 1):
                err = "parser type syntax: grouped token authority invalid"
                return false
        if optional:
            let child = ParserValueExprTypeSyntaxChildAt(tree, row, 0)
            if child < 0 || child >= row ||
               questionToken <= 0 || questionToken >= tree.tokenCount ||
               ParserValueExprTokenKindAt(tree, questionToken) !=
                   ParserValueTokenQuestion ||
               ParserValueExprTokenProducerSourceIndexAt(
                   tree, questionToken) !=
                   ParserValueExprTypeSyntaxProducerSourceIndexAt(
                       tree, row) ||
               ParserValueExprTypeSyntaxProducerSourceIndexAt(
                   tree, child) !=
                   ParserValueExprTypeSyntaxProducerSourceIndexAt(
                       tree, row) ||
               ParserValueExprTypeSyntaxOwnerTokenAt(tree, child) !=
                   ParserValueExprTypeSyntaxOwnerTokenAt(tree, row) ||
               ParserValueExprTypeSyntaxSpanStartAt(tree, child) !=
                   ParserValueExprTypeSyntaxSpanStartAt(tree, row) ||
               ParserValueExprTypeSyntaxSpanEndAt(tree, child) !=
                   ParserValueExprTokenEndAt(tree, questionToken - 1) ||
               ParserValueExprTypeSyntaxSpanEndAt(tree, row) !=
                   ParserValueExprTokenEndAt(tree, questionToken) ||
               ParserValueExprTypeSyntaxRootKindAt(tree, child) !=
                   ParserTypeSyntaxRootInvalid ||
               ParserValueExprTypeSyntaxDeclarationOwnerAt(
                   tree, child) != -1:
                err = "parser type syntax: optional token authority invalid"
                return false
        var typeChildOffset: int32 = 1
        for argOffset in 0..<argCount:
            let argRow = argStart + argOffset
            let tokenStart = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.typeSyntaxBracketArgTokenStarts, argRow)
            let tokenCount = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.typeSyntaxBracketArgTokenCounts, argRow)
            let typeNode = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.typeSyntaxBracketArgTypeNodeIndexes, argRow)
            let constRoot = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.typeSyntaxBracketArgConstExprRootIndexes,
                argRow)
            let tokenLimit = tokenStart + tokenCount
            if tokenStart <= 0 || tokenCount <= 0 ||
               tokenLimit >= tree.tokenCount || typeNode < -1 ||
               typeNode >= row || constRoot < -1 ||
               constRoot >= tree.typeConstExprCount ||
               (typeNode >= 0) == (constRoot >= 0) ||
               (argOffset == 0 &&
                ParserValueExprTokenKindAt(tree, tokenStart - 1) !=
                    ParserValueTokenLeftBracket) ||
               (argOffset > 0 &&
                ((ParserValueExprTokenKindAt(tree, tokenStart - 1) !=
                      ParserValueTokenComma &&
                  ParserValueExprTokenKindAt(tree, tokenStart - 1) !=
                      ParserValueTokenSemicolon) ||
                 arenamod.ArenaArrayInt32Get(
                     tree.arena,
                     tree.typeSyntaxBracketArgTokenStarts,
                     argRow - 1) +
                     arenamod.ArenaArrayInt32Get(
                         tree.arena,
                         tree.typeSyntaxBracketArgTokenCounts,
                         argRow - 1) != tokenStart - 1)) ||
               (argOffset + 1 == argCount &&
                ParserValueExprTokenKindAt(tree, tokenLimit) !=
                    ParserValueTokenRightBracket):
                err = "parser type syntax: bracket token authority invalid"
                return false
            if typeNode >= 0:
                if fixedArray || typeChildOffset >= childCount ||
                   ParserValueExprTypeSyntaxChildAt(
                       tree, row, typeChildOffset) != typeNode ||
                   ParserValueExprTypeSyntaxProducerSourceIndexAt(
                       tree, typeNode) !=
                       ParserValueExprTypeSyntaxProducerSourceIndexAt(
                           tree, row) ||
                   ParserValueExprTypeSyntaxOwnerTokenAt(tree, typeNode) !=
                       ParserValueExprTypeSyntaxOwnerTokenAt(tree, row) ||
                   ParserValueExprTypeSyntaxSpanStartAt(tree, typeNode) !=
                       ParserValueExprTokenStartAt(tree, tokenStart) ||
                   ParserValueExprTypeSyntaxSpanEndAt(tree, typeNode) !=
                       ParserValueExprTokenEndAt(tree, tokenLimit - 1) ||
                   ParserValueExprTypeSyntaxRootKindAt(tree, typeNode) !=
                       ParserTypeSyntaxRootInvalid ||
                   ParserValueExprTypeSyntaxDeclarationOwnerAt(
                       tree, typeNode) != -1 ||
                   ParserValueExprTypeSyntaxGenericSymbolCountAt(
                       tree, typeNode) != 0:
                    err = "parser type syntax: bracket type child authority invalid"
                    return false
                typeChildOffset = typeChildOffset + 1
            else:
                var matchErr: str
                if arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.typeConstExprProducerSourceIndexes,
                       constRoot) !=
                       ParserValueExprTypeSyntaxProducerSourceIndexAt(
                           tree, row) ||
                   !parserTypeSyntaxConstExprMatchesTokenRangeInto(
                       tree,
                       constRoot,
                       tokenStart,
                       tokenLimit,
                       ParserValueExprTypeSyntaxProducerSourceIndexAt(
                           tree, row),
                       constVisited,
                       matchErr):
                    err = "parser type syntax: bracket const authority invalid"
                    return false
        if (fixedArray || bracketApply) && typeChildOffset != childCount:
            err = "parser type syntax: bracket type child coverage invalid"
            return false
        if fixedArray:
            let constRoot = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.typeSyntaxBracketArgConstExprRootIndexes,
                argStart)
            var fixedValue: int32
            var fixedErr: str
            if arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.typeSyntaxBracketArgTypeNodeIndexes,
                argStart) != -1 || constRoot < 0 ||
               arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.typeSyntaxBracketArgTokenCounts,
                    argStart) != 1 ||
               ParserValueExprTokenKindAt(
                    tree,
                    arenamod.ArenaArrayInt32Get(
                        tree.arena,
                        tree.typeSyntaxBracketArgTokenStarts,
                        argStart)) != ParserValueTokenInteger ||
               !ParserValueExprTypeConstExprEvaluateInto(
                    tree, constRoot, fixedValue, fixedErr) ||
               fixedValue != ParserValueExprTypeSyntaxFixedLengthAt(
                    tree, row):
                err = "parser type syntax: fixed array argument authority invalid"
                return false
        childCursor = childCursor + childCount
        argCursor = argCursor + argCount
    if childCursor != tree.typeSyntaxChildCount ||
       argCursor != tree.typeSyntaxBracketArgCount:
        err = "parser type syntax: bracket type CSR coverage invalid"
        return false
    for constIndex in 0..<tree.typeConstExprCount:
        if !constVisited[constIndex]:
            err = "parser type syntax: const AST coverage invalid"
            return false
    err = ""
    return true

fn ParserValueExprAppendTypeSyntaxNode(
        tree: var ParserValueExprTree,
        kind: ParserTypeSyntaxKind,
        tokenStart: int32,
        tokenLimit: int32,
        ownerTokenIndex: int32,
        nameTokenIndex: int32,
        fixedLength: int32,
        children: int32[],
        rootKind: ParserTypeSyntaxRootKind): int32 =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       kind == ParserTypeSyntaxInvalid ||
       tokenStart < 0 || tokenStart >= tokenLimit ||
       tokenLimit > tree.tokenCount ||
       ownerTokenIndex < 0 || ownerTokenIndex >= tree.tokenCount ||
       nameTokenIndex < -1 || nameTokenIndex >= tree.tokenCount ||
       fixedLength < -1:
        panic("parser type syntax: invalid node")
    let sourceTextId = ParserValueExprTokenSourceIdAt(tree, tokenStart)
    if ParserValueExprTokenSourceIdAt(tree, tokenLimit - 1) != sourceTextId ||
       ParserValueExprTokenSourceIdAt(tree, ownerTokenIndex) != sourceTextId ||
       (nameTokenIndex >= 0 &&
        ParserValueExprTokenSourceIdAt(tree, nameTokenIndex) != sourceTextId):
        panic("parser type syntax: node crosses source identity")
    let nodeIndex = tree.typeSyntaxCount
    let childStart = tree.typeSyntaxChildCount
    for childOffset in 0..<children.len:
        let child = children[childOffset]
        if child < 0 || child >= nodeIndex:
            panic("parser type syntax: child is not prior postorder node")
        arenamod.ArenaArrayInt32Add(
            tree.arena, tree.typeSyntaxChildNodeIndexes, child)
        tree.typeSyntaxChildCount = tree.typeSyntaxChildCount + 1
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.typeSyntaxKinds,
                                 Int32(kind))
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.typeSyntaxSourceTextIds,
                                 sourceTextId)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.typeSyntaxProducerSourceIndexes, 0)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.typeSyntaxSourceLocalRows, nodeIndex)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.typeSyntaxSpanStarts,
                                 ParserValueExprTokenStartAt(tree, tokenStart))
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.typeSyntaxSpanEnds,
                                 ParserValueExprTokenEndAt(tree, tokenLimit - 1))
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.typeSyntaxOwnerTokenIndexes,
                                 ownerTokenIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.typeSyntaxDeclarationOwnerTokenIndexes, -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.typeSyntaxDeclarationOwnerNodeIndexes,
        -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.typeSyntaxGenericSymbolStarts, -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.typeSyntaxGenericSymbolCounts, 0)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.typeSyntaxChildStarts,
                                 childStart)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.typeSyntaxChildCounts,
                                 children.len)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.typeSyntaxBracketArgStarts,
                                 tree.typeSyntaxBracketArgCount)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.typeSyntaxBracketArgCounts,
                                 0)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.typeSyntaxNameTokenIndexes,
                                 nameTokenIndex)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.typeSyntaxFixedLengths,
                                 fixedLength)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.typeSyntaxQuestionTokenIndexes, -1)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.typeSyntaxRootKinds,
                                 Int32(rootKind))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.typeSyntaxEnumVariantStarts,
        -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.typeSyntaxEnumVariantCounts, 0)
    tree.typeSyntaxCount = tree.typeSyntaxCount + 1
    return nodeIndex

fn ParserValueExprTypeSyntaxSetQuestionToken(
        tree: var ParserValueExprTree,
        nodeIndex: int32,
        questionTokenIndex: int32) =
    if nodeIndex < 0 || nodeIndex >= tree.typeSyntaxCount ||
       ParserValueExprTypeSyntaxKindAt(tree, nodeIndex) !=
           ParserTypeSyntaxOptional ||
       ParserValueExprTypeSyntaxQuestionTokenAt(tree, nodeIndex) != -1 ||
       questionTokenIndex <= 0 || questionTokenIndex >= tree.tokenCount ||
       ParserValueExprTokenKindAt(tree, questionTokenIndex) !=
           ParserValueTokenQuestion ||
       ParserValueExprTypeSyntaxChildCountAt(tree, nodeIndex) != 1 ||
       ParserValueExprTypeSyntaxSpanEndAt(tree, nodeIndex) !=
           ParserValueExprTokenEndAt(tree, questionTokenIndex):
        panic("parser type syntax: invalid optional question token")
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.typeSyntaxQuestionTokenIndexes,
        nodeIndex,
        questionTokenIndex)

fn ParserValueExprTypeSyntaxSetBracketArgs(
        tree: var ParserValueExprTree,
        nodeIndex: int32,
        tokenStarts: int32[],
        tokenCounts: int32[],
        typeNodes: int32[],
        err: var str): bool =
    if nodeIndex < 0 || nodeIndex >= tree.typeSyntaxCount ||
       tokenStarts.len == 0 || tokenStarts.len != tokenCounts.len ||
       tokenStarts.len != typeNodes.len ||
       ParserValueExprTypeSyntaxBracketArgCountAt(tree, nodeIndex) != 0:
        panic("parser type syntax: invalid bracket args")
    for index in 0..<tokenStarts.len:
        let tokenStart = tokenStarts[index]
        let tokenCount = tokenCounts[index]
        let typeNode = typeNodes[index]
        var constRoot: int32 = -1
        if tokenStart < 0 || tokenCount <= 0 ||
           tokenStart + tokenCount > tree.tokenCount || typeNode < -1 ||
           typeNode >= nodeIndex:
            panic("parser type syntax: bracket arg token range invalid")
        if typeNode >= 0:
            if ParserValueExprTypeSyntaxSpanStartAt(tree, typeNode) !=
                   ParserValueExprTokenStartAt(tree, tokenStart) ||
               ParserValueExprTypeSyntaxSpanEndAt(tree, typeNode) !=
                   ParserValueExprTokenEndAt(
                       tree, tokenStart + tokenCount - 1) ||
               ParserValueExprTypeSyntaxProducerSourceIndexAt(
                   tree, typeNode) !=
                   ParserValueExprTypeSyntaxProducerSourceIndexAt(
                       tree, nodeIndex) ||
               ParserValueExprTypeSyntaxOwnerTokenAt(tree, typeNode) !=
                   ParserValueExprTypeSyntaxOwnerTokenAt(tree, nodeIndex):
                panic("parser type syntax: bracket type arg authority invalid")
            var childSeen = false
            for childOffset in 0..<
                    ParserValueExprTypeSyntaxChildCountAt(tree, nodeIndex):
                if ParserValueExprTypeSyntaxChildAt(
                       tree, nodeIndex, childOffset) == typeNode:
                    if childSeen:
                        panic("parser type syntax: duplicate bracket type child")
                    childSeen = true
            if !childSeen:
                panic(Fmt"parser type syntax: bracket type arg is not a child node={nodeIndex} type_node={typeNode} child_count={ParserValueExprTypeSyntaxChildCountAt(tree, nodeIndex)}")
        else:
            let tokenLimit = tokenStart + tokenCount
            if !parserTypeSyntaxConstTokensOnly(
                   tree, tokenStart, tokenLimit):
                err = "parser type syntax: bracket argument has no exact type or const authority"
                return false
            let constProducerSourceIndex =
                ParserValueExprTypeSyntaxProducerSourceIndexAt(
                    tree, nodeIndex)
            var constCursor = tokenStart
            if !parserTypeSyntaxParseConstExpr(
                   tree,
                   constProducerSourceIndex,
                   constCursor,
                   tokenLimit,
                   constRoot,
                   err) ||
               constCursor != tokenLimit:
                if len(err) == 0:
                    err = "parser type syntax: const expression has trailing token"
                return false
        arenamod.ArenaArrayInt32Add(
            tree.arena, tree.typeSyntaxBracketArgTokenStarts, tokenStart)
        arenamod.ArenaArrayInt32Add(
            tree.arena, tree.typeSyntaxBracketArgTokenCounts, tokenCount)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeSyntaxBracketArgTypeNodeIndexes,
            typeNode)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeSyntaxBracketArgConstExprRootIndexes,
            constRoot)
        tree.typeSyntaxBracketArgCount = tree.typeSyntaxBracketArgCount + 1
    arenamod.ArenaArrayInt32Set(tree.arena,
                                 tree.typeSyntaxBracketArgCounts,
                                 nodeIndex,
                                 tokenStarts.len)
    err = ""
    return true

fn ParserValueExprTypeSyntaxSetRootKind(
        tree: var ParserValueExprTree,
        nodeIndex: int32,
        rootKind: ParserTypeSyntaxRootKind) =
    if rootKind == ParserTypeSyntaxRootInvalid:
        panic("parser type syntax: invalid root kind")
    let existing = ParserValueExprTypeSyntaxRootKindAt(tree, nodeIndex)
    if existing != ParserTypeSyntaxRootInvalid:
        panic("parser type syntax: duplicate root assignment")
    arenamod.ArenaArrayInt32Set(tree.arena,
                                 tree.typeSyntaxRootKinds,
                                 nodeIndex,
                                 Int32(rootKind))

fn ParserValueExprTypeSyntaxSetDeclarationOwner(
        tree: var ParserValueExprTree,
        nodeIndex: int32,
        declarationOwnerNodeIndex: int32) =
    if !ParserValueExprTypeSyntaxDeclarationOwnerEdgeValid(
           tree, nodeIndex, declarationOwnerNodeIndex) ||
       ParserValueExprTypeSyntaxDeclarationOwnerAt(tree, nodeIndex) != -1:
        panic("parser type syntax: invalid declaration owner edge")
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.typeSyntaxDeclarationOwnerNodeIndexes,
        nodeIndex,
        declarationOwnerNodeIndex)

fn ParserValueExprTypeSyntaxSetDeclarationOwnerToken(
        tree: var ParserValueExprTree,
        nodeIndex: int32,
        declarationOwnerTokenIndex: int32) =
    if nodeIndex < 0 || nodeIndex >= tree.typeSyntaxCount ||
       declarationOwnerTokenIndex < 0 ||
       declarationOwnerTokenIndex >= tree.tokenCount ||
       ParserValueExprTypeSyntaxRootKindAt(tree, nodeIndex) ==
           ParserTypeSyntaxRootInvalid ||
       ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(tree, nodeIndex) != -1 ||
       ParserValueExprTokenSourceIdAt(tree, declarationOwnerTokenIndex) !=
           ParserValueExprTypeSyntaxSourceIdAt(tree, nodeIndex):
        panic("parser type syntax: declaration owner token invalid")
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.typeSyntaxDeclarationOwnerTokenIndexes,
        nodeIndex,
        declarationOwnerTokenIndex)

fn ParserValueExprTypeSyntaxSetGenericSymbols(
        tree: var ParserValueExprTree,
        nodeIndex: int32,
        symbolStart: int32,
        symbolCount: int32) =
    if nodeIndex < 0 || nodeIndex >= tree.typeSyntaxCount ||
       ParserValueExprTypeSyntaxRootKindAt(tree, nodeIndex) ==
           ParserTypeSyntaxRootInvalid ||
       symbolStart < 0 || symbolCount <= 0 ||
       symbolStart > tree.typeGenericSymbolCount - symbolCount ||
       ParserValueExprTypeSyntaxGenericSymbolStartAt(tree, nodeIndex) != -1 ||
       ParserValueExprTypeSyntaxGenericSymbolCountAt(tree, nodeIndex) != 0:
        panic("parser type syntax: generic symbol range invalid")
    arenamod.ArenaArrayInt32Set(
        tree.arena, tree.typeSyntaxGenericSymbolStarts, nodeIndex, symbolStart)
    arenamod.ArenaArrayInt32Set(
        tree.arena, tree.typeSyntaxGenericSymbolCounts, nodeIndex, symbolCount)
    let rootKind = ParserValueExprTypeSyntaxRootKindAt(tree, nodeIndex)
    for symbolOffset in 0..<symbolCount:
        let symbolRow = symbolStart + symbolOffset
        let existingOwner = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.typeGenericSymbolOwnerTypeSyntaxNodeIndexes,
            symbolRow)
        if existingOwner < 0 ||
           rootKind == ParserTypeSyntaxRootTypeDeclarationRhs:
            arenamod.ArenaArrayInt32Set(
                tree.arena,
                tree.typeGenericSymbolOwnerTypeSyntaxNodeIndexes,
                symbolRow,
                nodeIndex)

fn ParserValueExprAppendDeclarationGenericSymbols(
        tree: var ParserValueExprTree,
        declarationOwnerTokenIndex: int32,
        openIndex: int32,
        closeIndex: int32,
        symbolStartOut: var int32,
        symbolCountOut: var int32,
        err: var str): bool =
    symbolStartOut = -1
    symbolCountOut = 0
    if openIndex < 0 || closeIndex <= openIndex ||
       closeIndex >= tree.tokenCount ||
       ParserValueExprTokenKindAt(tree, openIndex) !=
           ParserValueTokenLeftBracket ||
       ParserValueExprTokenKindAt(tree, closeIndex) !=
           ParserValueTokenRightBracket ||
       ParserValueExprFindMatchingToken(
           tree,
           openIndex,
           closeIndex + 1,
           ParserValueTokenLeftBracket,
           ParserValueTokenRightBracket) != closeIndex:
        err = "parser type syntax: declaration generic range invalid"
        return false
    let symbolStart = tree.typeGenericSymbolCount
    # [ar2-scratch] AD1 batch 2b: the seven segment columns are born and
    # die inside this function (2b verdict: no tree escape, no out-param,
    # no callee argument -- the consumers are all in-body), so they ride
    # the tree scratch arena with no CopyOut.  Every accepted segment
    # consumes at least one token and consecutive segments are separated
    # by at least one top-level separator token, so the bracket token span
    # is a hard bound on the segment count; one reserve replaces seven
    # add-growth chains.
    var segmentStarts: ParserScratchSeqInt32
    var segmentLimits: ParserScratchSeqInt32
    var nameTokenIndexes: ParserScratchSeqInt32
    var constraintStarts: ParserScratchSeqInt32
    var constraintLimits: ParserScratchSeqInt32
    var defaultStarts: ParserScratchSeqInt32
    var defaultLimits: ParserScratchSeqInt32
    let segmentSpan = closeIndex - openIndex - 1
    if !ParserScratchSeqReserve(tree, segmentStarts, segmentSpan):
        panic("parser scratch: generic segment starts reserve failed")
    if !ParserScratchSeqReserve(tree, segmentLimits, segmentSpan):
        panic("parser scratch: generic segment limits reserve failed")
    if !ParserScratchSeqReserve(tree, nameTokenIndexes, segmentSpan):
        panic("parser scratch: generic name tokens reserve failed")
    if !ParserScratchSeqReserve(tree, constraintStarts, segmentSpan):
        panic("parser scratch: generic constraint starts reserve failed")
    if !ParserScratchSeqReserve(tree, constraintLimits, segmentSpan):
        panic("parser scratch: generic constraint limits reserve failed")
    if !ParserScratchSeqReserve(tree, defaultStarts, segmentSpan):
        panic("parser scratch: generic default starts reserve failed")
    if !ParserScratchSeqReserve(tree, defaultLimits, segmentSpan):
        panic("parser scratch: generic default limits reserve failed")
    var cursor = openIndex + 1
    var segmentStart = cursor
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    while cursor <= closeIndex:
        let atEnd = cursor == closeIndex
        var split = atEnd
        if !atEnd:
            let kind = ParserValueExprTokenKindAt(tree, cursor)
            if kind == ParserValueTokenLeftParen:
                parenDepth = parenDepth + 1
            elif kind == ParserValueTokenRightParen:
                parenDepth = parenDepth - 1
            elif kind == ParserValueTokenLeftBracket:
                bracketDepth = bracketDepth + 1
            elif kind == ParserValueTokenRightBracket:
                bracketDepth = bracketDepth - 1
            elif kind == ParserValueTokenLeftBrace:
                braceDepth = braceDepth + 1
            elif kind == ParserValueTokenRightBrace:
                braceDepth = braceDepth - 1
            elif (kind == ParserValueTokenComma ||
                  kind == ParserValueTokenSemicolon) &&
                 parenDepth == 0 && bracketDepth == 0 &&
                 braceDepth == 0:
                split = true
        if parenDepth < 0 || bracketDepth < 0 || braceDepth < 0:
            err = "parser type syntax: unbalanced generic declaration"
            return false
        if split:
            if cursor <= segmentStart:
                err = cursor == closeIndex ?
                    "parser type syntax: trailing generic declaration separator" :
                    "parser type syntax: empty generic declaration item"
                return false
            let colonIndex = ParserValueExprFindTopLevelKind(
                tree,
                segmentStart,
                cursor,
                ParserValueTokenColon)
            let assignIndex = ParserValueExprFindTopLevelKind(
                tree,
                segmentStart,
                cursor,
                ParserValueTokenAssign)
            if colonIndex >= 0 && assignIndex >= 0 &&
               assignIndex < colonIndex:
                err = "parser type syntax: generic default precedes constraint"
                return false
            var nameLimit = cursor
            if colonIndex >= 0: nameLimit = colonIndex
            if assignIndex >= 0 && assignIndex < nameLimit:
                nameLimit = assignIndex
            if nameLimit != segmentStart + 1 ||
               !ParserValueExprTokenCanName(
                   ParserValueExprTokenKindAt(tree, segmentStart)):
                err = "parser type syntax: generic declaration name missing"
                return false
            if colonIndex >= 0 &&
               (colonIndex + 1 >= cursor ||
                (assignIndex >= 0 && colonIndex + 1 >= assignIndex)):
                err = "parser type syntax: generic constraint type missing"
                return false
            if assignIndex >= 0 && assignIndex + 1 >= cursor:
                err = "parser type syntax: generic default type missing"
                return false
            let nameTokenIndex = segmentStart
            for prior in 0..<ParserScratchSeqLen(tree, nameTokenIndexes):
                if !ParserValueExprNameTokenTextEqualsToken(
                       tree,
                       ParserScratchSeqGet(tree, nameTokenIndexes,
                                           prior),
                       nameTokenIndex):
                    err = "parser type syntax: duplicate generic declaration name"
                    return false
            ParserScratchSeqAdd(tree, segmentStarts, segmentStart)
            ParserScratchSeqAdd(tree, segmentLimits, cursor)
            ParserScratchSeqAdd(tree, nameTokenIndexes, nameTokenIndex)
            ParserScratchSeqAdd(tree, constraintStarts,
                colonIndex < 0 ? -1 : colonIndex + 1)
            ParserScratchSeqAdd(tree, constraintLimits,
                colonIndex < 0 ?
                    -1 :
                    (assignIndex < 0 ? cursor : assignIndex))
            ParserScratchSeqAdd(tree, defaultStarts,
                assignIndex < 0 ? -1 : assignIndex + 1)
            ParserScratchSeqAdd(tree, defaultLimits,
                assignIndex < 0 ? -1 : cursor)
            segmentStart = cursor + 1
        cursor = cursor + 1
    if parenDepth != 0 || bracketDepth != 0 || braceDepth != 0:
        err = "parser type syntax: unbalanced generic declaration"
        return false
    if ParserScratchSeqLen(tree, nameTokenIndexes) <= 0:
        err = "parser type syntax: empty generic declaration"
        return false
    for ordinal in 0..<ParserScratchSeqLen(tree, nameTokenIndexes):
        let nameTokenIndex = ParserScratchSeqGet(tree, nameTokenIndexes,
                                                 ordinal)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolProducerSourceIndexes,
            0)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolDeclarationOwnerTokenIndexes,
            declarationOwnerTokenIndex)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolNameTokenIndexes,
            nameTokenIndex)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolOrdinals,
            ordinal)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolSpanStarts,
            ParserValueExprTokenStartAt(
                tree,
                ParserScratchSeqGet(tree, segmentStarts, ordinal)))
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolSpanEnds,
            ParserValueExprTokenEndAt(
                tree,
                ParserScratchSeqGet(tree, segmentLimits, ordinal) - 1))
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolOwnerDeclarationRows,
            -1)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolOwnerTypeSyntaxNodeIndexes,
            -1)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolConstraintTypeSyntaxNodeIndexes,
            -1)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolDefaultTypeSyntaxNodeIndexes,
            -1)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolChildStarts,
            tree.typeGenericSymbolChildCount)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolChildCounts,
            0)
        tree.typeGenericSymbolCount = tree.typeGenericSymbolCount + 1
    let symbolCount = ParserScratchSeqLen(tree, nameTokenIndexes)
    for symbolOffset in 0..<symbolCount:
        let symbolRow = symbolStart + symbolOffset
        let childStart = tree.typeGenericSymbolChildCount
        var childCount: int32
        let constraintStart = ParserScratchSeqGet(
            tree, constraintStarts, symbolOffset)
        if constraintStart >= 0:
            var constraintRoot: int32
            if !ParserValueExprAppendTypeSyntaxRootInto(
                   tree,
                   constraintStart,
                   ParserScratchSeqGet(tree, constraintLimits,
                                       symbolOffset),
                   ParserScratchSeqGet(tree, nameTokenIndexes,
                                       symbolOffset),
                   ParserTypeSyntaxRootGenericConstraint,
                   false,
                   -1,
                   declarationOwnerTokenIndex,
                   constraintRoot,
                   err):
                return false
            ParserValueExprTypeSyntaxSetGenericSymbols(
                tree, constraintRoot, symbolStart, symbolCount)
            arenamod.ArenaArrayInt32Set(
                tree.arena,
                tree.typeGenericSymbolConstraintTypeSyntaxNodeIndexes,
                symbolRow,
                constraintRoot)
            arenamod.ArenaArrayInt32Add(
                tree.arena,
                tree.typeGenericSymbolChildTypeSyntaxNodeIndexes,
                constraintRoot)
            tree.typeGenericSymbolChildCount =
                tree.typeGenericSymbolChildCount + 1
            childCount = childCount + 1
        let defaultStart = ParserScratchSeqGet(
            tree, defaultStarts, symbolOffset)
        if defaultStart >= 0:
            var defaultRoot: int32
            if !ParserValueExprAppendTypeSyntaxRootInto(
                   tree,
                   defaultStart,
                   ParserScratchSeqGet(tree, defaultLimits,
                                       symbolOffset),
                   ParserScratchSeqGet(tree, nameTokenIndexes,
                                       symbolOffset),
                   ParserTypeSyntaxRootGenericDefault,
                   false,
                   -1,
                   declarationOwnerTokenIndex,
                   defaultRoot,
                   err):
                return false
            ParserValueExprTypeSyntaxSetGenericSymbols(
                tree, defaultRoot, symbolStart, symbolCount)
            arenamod.ArenaArrayInt32Set(
                tree.arena,
                tree.typeGenericSymbolDefaultTypeSyntaxNodeIndexes,
                symbolRow,
                defaultRoot)
            arenamod.ArenaArrayInt32Add(
                tree.arena,
                tree.typeGenericSymbolChildTypeSyntaxNodeIndexes,
                defaultRoot)
            tree.typeGenericSymbolChildCount =
                tree.typeGenericSymbolChildCount + 1
            childCount = childCount + 1
        arenamod.ArenaArrayInt32Set(
            tree.arena,
            tree.typeGenericSymbolChildStarts,
            symbolRow,
            childStart)
        arenamod.ArenaArrayInt32Set(
            tree.arena,
            tree.typeGenericSymbolChildCounts,
            symbolRow,
            childCount)
    symbolStartOut = symbolStart
    symbolCountOut = symbolCount
    err = ""
    return true

# [implicit generic] Bracket-free sibling of
# ParserValueExprAppendDeclarationGenericSymbols.  Implicit inference already
# owns the exact name tokens (there is no `[` .. `]` list to re-scan), so this
# primitive only performs the row append; the caller keeps `ordinalBase`
# continuity because ParserValueExprSetDeclarationGenericSymbols asserts
# `ordinals[row] == row - windowStart` across the whole declaration window.
# An implicit parameter has neither a constraint nor a default, so those two
# node columns stay -1 and every row's child CSR is empty -- the same row
# shape the explicit path writes for a bare `[T]`.  Rows are appended with the
# growing ArenaArrayInt32Add exactly like the explicit columns at
# `:17835-17883` (these columns carry no parse-time static reservation), and
# the producer source index is the parser tree's own single-source index 0,
# mirrored from `:17835-17838` and `:17468`; the forest merge rebases it with
# `sourceOffset +` exactly like every other row of this column.
fn ParserValueExprAppendImplicitGenericSymbols(
        tree: var ParserValueExprTree,
        declarationOwnerTokenIndex: int32,
        nameTokenIndexes: int32[],
        ordinalBase: int32,
        symbolStartOut: var int32,
        symbolCountOut: var int32,
        err: var str): bool =
    symbolStartOut = -1
    symbolCountOut = 0
    if declarationOwnerTokenIndex < 0 ||
       declarationOwnerTokenIndex >= tree.tokenCount ||
       ordinalBase < 0 || nameTokenIndexes.len <= 0:
        err = "parser type syntax: implicit generic declaration missing"
        return false
    for ordinal in 0..<nameTokenIndexes.len:
        let nameTokenIndex = nameTokenIndexes[ordinal]
        if nameTokenIndex < 0 || nameTokenIndex >= tree.tokenCount ||
           !ParserValueExprTokenCanName(
               ParserValueExprTokenKindAt(tree, nameTokenIndex)):
            err = "parser type syntax: implicit generic name token invalid"
            return false
        for prior in 0..<ordinal:
            if !ParserValueExprNameTokenTextEqualsToken(
                   tree, nameTokenIndexes[prior], nameTokenIndex):
                err = "parser type syntax: duplicate implicit generic declaration"
                return false
    let symbolStart = tree.typeGenericSymbolCount
    for ordinal in 0..<nameTokenIndexes.len:
        let nameTokenIndex = nameTokenIndexes[ordinal]
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolProducerSourceIndexes,
            0)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolDeclarationOwnerTokenIndexes,
            declarationOwnerTokenIndex)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolNameTokenIndexes,
            nameTokenIndex)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolOrdinals,
            ordinalBase + ordinal)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolSpanStarts,
            ParserValueExprTokenStartAt(tree, nameTokenIndex))
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolSpanEnds,
            ParserValueExprTokenEndAt(tree, nameTokenIndex))
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolOwnerDeclarationRows,
            -1)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolOwnerTypeSyntaxNodeIndexes,
            -1)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolConstraintTypeSyntaxNodeIndexes,
            -1)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolDefaultTypeSyntaxNodeIndexes,
            -1)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolChildStarts,
            tree.typeGenericSymbolChildCount)
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.typeGenericSymbolChildCounts,
            0)
        tree.typeGenericSymbolCount = tree.typeGenericSymbolCount + 1
    symbolStartOut = symbolStart
    symbolCountOut = nameTokenIndexes.len
    err = ""
    return true

fn parserTypeSyntaxTokenCanName(kind: ParserValueTokenKind): bool =
    return ParserValueExprTokenCanName(kind) ||
           kind == ParserValueTokenSet

# [S1b step-3 (9)] Module `const` table lookups.  Rows are (name token,
# int32 flag, value) in declaration order; the name is matched on its exact
# token text, because token rows are per source and the same const name can be
# declared by two sources.
@borrows
fn parserTypeSyntaxModuleConstFindInto(
        tree: ParserValueExprTree,
        nameToken: int32,
        int32Out: var bool,
        valueOut: var int32): bool =
    int32Out = false
    valueOut = 0
    if tree == nil || nameToken < 0 || nameToken >= tree.tokenCount:
        return false
    if nameToken < 0 || nameToken >= tree.tokenCount:
        return false
    var row = tree.typeConstModuleNameTokens.len - 1
    while row >= 0:
        let candidate = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeConstModuleNameTokens, row)
        if candidate < 0 || candidate >= tree.tokenCount:
            panic("parser type syntax: module const name token invalid")
        if ParserValueExprNameTokenTextEqualsToken(tree, candidate,
                                                   nameToken):
            int32Out = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.typeConstModuleInt32Flags, row) != 0
            valueOut = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.typeConstModuleValues, row)
            return true
        row = row - 1
    return false

fn parserTypeSyntaxModuleConstRegister(
        tree: var ParserValueExprTree,
        nameToken: int32,
        int32Flag: bool,
        value: int32,
        err: var str): bool =
    if nameToken < 0 || nameToken >= tree.tokenCount ||
       !ParserValueExprTokenCanName(
           ParserValueExprTokenKindAt(tree, nameToken)):
        err = "parser type syntax: module const name invalid"
        return false
    var existingFlag: bool
    var existingValue: int32
    if parserTypeSyntaxModuleConstFindInto(
           tree, nameToken, existingFlag, existingValue):
        # Same rule the typed-expression module-const scan already enforces
        # (TypedExprModuleConstLocalEntryIsFresh): re-registering one name with
        # a different value is a source conflict, never last-writer-wins.
        if existingFlag != int32Flag || existingValue != value:
            panic(Fmt"parser type syntax: conflicting module const name={ParserValueExprTokenText(tree, nameToken)}")
        err = ""
        return true
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.typeConstModuleNameTokens, nameToken)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.typeConstModuleInt32Flags, int32Flag ? 1 : 0)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.typeConstModuleValues, value)
    err = ""
    return true

# The lexer admits `0x`/`0b`/`0o` integer tokens and `_` separators
# (parser.cheng:14936), which the const grammar's decimal-only literal branch
# does not read.  A module const's declared value is resolved here, so the table
# accepts the lexer's own literal set; the bracket-length path itself is
# unchanged.
@borrows
fn parserTypeSyntaxModuleConstRadixValueInto(
        tree: ParserValueExprTree,
        tokenIndex: int32,
        valueOut: var int32): bool =
    # [tg-knife] digits read from the borrowed interned source view; the
    # radix/digit/overflow arithmetic is byte-identical to the previous
    # cloned-string form.
    valueOut = 0
    let spanStart = ParserValueExprTokenStartAt(tree, tokenIndex)
    let spanEnd = ParserValueExprTokenEndAt(tree, tokenIndex)
    let textLen = spanEnd - spanStart
    if textLen <= 0:
        return false
    let text = langintern.LookupInternBorrowedText(
        tree.internPool,
        ParserValueExprTokenSourceIdAt(tree, tokenIndex))
    var radix: int64 = Int64(10)
    var cursor = 0
    if textLen > 2 && text[spanStart] == '0':
        if text[spanStart + 1] == 'x' || text[spanStart + 1] == 'X':
            radix = Int64(16)
            cursor = 2
        elif text[spanStart + 1] == 'b' || text[spanStart + 1] == 'B':
            radix = Int64(2)
            cursor = 2
        elif text[spanStart + 1] == 'o' || text[spanStart + 1] == 'O':
            radix = Int64(8)
            cursor = 2
    if cursor >= textLen:
        return false
    var value: int64
    while cursor < textLen:
        let ch = text[spanStart + cursor]
        if ch == '_':
            cursor = cursor + 1
            continue
        var digit: int64 = Int64(-1)
        if ch >= '0' && ch <= '9':
            digit = Int64(Int32(ch) - Int32('0'))
        elif ch >= 'a' && ch <= 'f':
            digit = Int64(Int32(ch) - Int32('a')) + Int64(10)
        elif ch >= 'A' && ch <= 'F':
            digit = Int64(Int32(ch) - Int32('A')) + Int64(10)
        if digit < 0 || digit >= radix:
            return false
        value = value * radix + digit
        if value > Int64(2147483647):
            return false
        cursor = cursor + 1
    valueOut = int32(value)
    return true

# Resolve one module const initializer token range to an int32 value.  The
# const grammar and evaluator of the bracket path are reused verbatim over a
# scratch const AST; the appended rows are truncated before returning, so the
# tree's const AST never holds a node that no bracket argument owns.  Returns
# false for "declared, but not an int32 compile-time value" -- a hard failure
# only where a `T[NAME]` length actually names it (C chain:
# cold_const_i32_value).
fn parserTypeSyntaxModuleConstValueInto(
        tree: var ParserValueExprTree,
        initStart: int32,
        initLimit: int32,
        valueOut: var int32): bool =
    valueOut = 0
    if initStart < 0 || initLimit <= initStart ||
       initLimit > tree.tokenCount:
        return false
    let constCount = tree.typeConstExprCount
    let kindsLen = tree.typeConstExprKinds.len
    let producerLen = tree.typeConstExprProducerSourceIndexes.len
    let tokenLen = tree.typeConstExprTokenIndexes.len
    let leftLen = tree.typeConstExprLeftChildIndexes.len
    let rightLen = tree.typeConstExprRightChildIndexes.len
    let integerLen = tree.typeConstExprIntegerValues.len
    var cursor = initStart
    var root: int32 = -1
    var parseErr: str
    var resolved = false
    var value: int32
    if parserTypeSyntaxConstTokensOnly(tree, initStart, initLimit) &&
       parserTypeSyntaxParseConstExpr(
           tree, 0, cursor, initLimit, root, parseErr) &&
       cursor == initLimit:
        var evalErr: str
        if ParserValueExprTypeConstExprEvaluateInto(
               tree, root, value, evalErr):
            resolved = true
    tree.typeConstExprKinds.len = kindsLen
    tree.typeConstExprProducerSourceIndexes.len = producerLen
    tree.typeConstExprTokenIndexes.len = tokenLen
    tree.typeConstExprLeftChildIndexes.len = leftLen
    tree.typeConstExprRightChildIndexes.len = rightLen
    tree.typeConstExprIntegerValues.len = integerLen
    tree.typeConstExprCount = constCount
    if !resolved && initLimit == initStart + 1 &&
       ParserValueExprTokenKindAt(tree, initStart) ==
           ParserValueTokenInteger:
        var literal: int32
        if parserTypeSyntaxModuleConstRadixValueInto(tree, initStart,
                                                       literal):
            resolved = true
            value = literal
    if resolved:
        valueOut = value
    return resolved

@borrows
fn parserTypeSyntaxFixedLengthInto(tree: ParserValueExprTree,
                                    tokenIndex: int32,
                                    out: var int32): bool =
    if ParserValueExprTokenKindAt(tree, tokenIndex) !=
           ParserValueTokenInteger:
        return false
    # [tg-knife] digits read from the borrowed interned source view;
    # arithmetic identical to the previous cloned-string form.
    let spanStart = ParserValueExprTokenStartAt(tree, tokenIndex)
    let spanEnd = ParserValueExprTokenEndAt(tree, tokenIndex)
    let textLen = spanEnd - spanStart
    let text = langintern.LookupInternBorrowedText(
        tree.internPool,
        ParserValueExprTokenSourceIdAt(tree, tokenIndex))
    if textLen == 0:
        return false
    var value: int64
    for index in 0..<textLen:
        let ch = text[spanStart + index]
        if ch < '0' || ch > '9':
            return false
        value = value * Int64(10) + Int64(Int32(ch) - Int32('0'))
        if value > Int64(2147483647):
            return false
    if value <= 0:
        return false
    out = int32(value)
    return true

@borrows
fn parserTypeSyntaxTopLevelColon(
        tree: ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32): int32 =
    return ParserValueExprFindTopLevelKind(
        tree, tokenStart, tokenLimit, ParserValueTokenColon)

fn parserTypeSyntaxRollback(
        tree: var ParserValueExprTree,
        typeSyntaxCount: int32,
        typeSyntaxChildCount: int32,
        typeSyntaxBracketArgCount: int32) =
    if typeSyntaxCount < 0 || typeSyntaxCount > tree.typeSyntaxCount ||
       typeSyntaxChildCount < 0 ||
       typeSyntaxChildCount > tree.typeSyntaxChildCount ||
       typeSyntaxBracketArgCount < 0 ||
       typeSyntaxBracketArgCount > tree.typeSyntaxBracketArgCount:
        panic("parser type syntax: invalid rollback checkpoint")
    tree.typeSyntaxKinds.len = typeSyntaxCount
    tree.typeSyntaxSourceTextIds.len = typeSyntaxCount
    tree.typeSyntaxProducerSourceIndexes.len = typeSyntaxCount
    tree.typeSyntaxSourceLocalRows.len = typeSyntaxCount
    tree.typeSyntaxSpanStarts.len = typeSyntaxCount
    tree.typeSyntaxSpanEnds.len = typeSyntaxCount
    tree.typeSyntaxOwnerTokenIndexes.len = typeSyntaxCount
    tree.typeSyntaxDeclarationOwnerTokenIndexes.len = typeSyntaxCount
    tree.typeSyntaxDeclarationOwnerNodeIndexes.len = typeSyntaxCount
    tree.typeSyntaxGenericSymbolStarts.len = typeSyntaxCount
    tree.typeSyntaxGenericSymbolCounts.len = typeSyntaxCount
    tree.typeSyntaxChildStarts.len = typeSyntaxCount
    tree.typeSyntaxChildCounts.len = typeSyntaxCount
    tree.typeSyntaxBracketArgStarts.len = typeSyntaxCount
    tree.typeSyntaxBracketArgCounts.len = typeSyntaxCount
    tree.typeSyntaxNameTokenIndexes.len = typeSyntaxCount
    tree.typeSyntaxFixedLengths.len = typeSyntaxCount
    tree.typeSyntaxQuestionTokenIndexes.len = typeSyntaxCount
    tree.typeSyntaxRootKinds.len = typeSyntaxCount
    tree.typeSyntaxEnumVariantStarts.len = typeSyntaxCount
    tree.typeSyntaxEnumVariantCounts.len = typeSyntaxCount
    tree.typeSyntaxChildNodeIndexes.len = typeSyntaxChildCount
    tree.typeSyntaxBracketArgTokenStarts.len = typeSyntaxBracketArgCount
    tree.typeSyntaxBracketArgTokenCounts.len = typeSyntaxBracketArgCount
    tree.typeSyntaxBracketArgTypeNodeIndexes.len =
        typeSyntaxBracketArgCount
    tree.typeSyntaxCount = typeSyntaxCount
    tree.typeSyntaxChildCount = typeSyntaxChildCount
    tree.typeSyntaxBracketArgCount = typeSyntaxBracketArgCount

fn parserTypeSyntaxTryArgumentInto(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        ownerTokenIndex: int32,
        nodeOut: var int32): bool =
    let typeSyntaxCount = tree.typeSyntaxCount
    let typeSyntaxChildCount = tree.typeSyntaxChildCount
    let typeSyntaxBracketArgCount = tree.typeSyntaxBracketArgCount
    var parseErr: str
    if parserTypeSyntaxParseRange(
           tree,
           tokenStart,
           tokenLimit,
           ownerTokenIndex,
           nodeOut,
           parseErr):
        return true
    parserTypeSyntaxRollback(
        tree,
        typeSyntaxCount,
        typeSyntaxChildCount,
        typeSyntaxBracketArgCount)
    nodeOut = -1
    return false

@borrows
fn parserTypeSyntaxBracketArgRangesInto(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        starts: var int32[],
        counts: var int32[],
        err: var str): bool =
    starts = []
    counts = []
    if tokenStart >= tokenLimit:
        err = "parser type syntax: empty bracket arguments"
        return false
    # [ar2-scratch] AD1 batch 2a: bracket argument ranges ride the tree
    # scratch arena.  Each segment consumes at least one token, so the token
    # span is a hard bound on the count; one reserve replaces the add-growth
    # chain.
    var startsScratch: ParserScratchSeqInt32
    var countsScratch: ParserScratchSeqInt32
    if !ParserScratchSeqReserve(tree, startsScratch, tokenLimit - tokenStart):
        panic("parser scratch: bracket argument starts reserve failed")
    if !ParserScratchSeqReserve(tree, countsScratch, tokenLimit - tokenStart):
        panic("parser scratch: bracket argument counts reserve failed")
    var segmentStart = tokenStart
    var cursor = tokenStart
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    while cursor <= tokenLimit:
        let atEnd = cursor == tokenLimit
        var split = atEnd
        if !atEnd:
            let kind = ParserValueExprTokenKindAt(tree, cursor)
            if kind == ParserValueTokenLeftParen: parenDepth = parenDepth + 1
            elif kind == ParserValueTokenRightParen: parenDepth = parenDepth - 1
            elif kind == ParserValueTokenLeftBracket:
                bracketDepth = bracketDepth + 1
            elif kind == ParserValueTokenRightBracket:
                bracketDepth = bracketDepth - 1
            elif kind == ParserValueTokenLeftBrace: braceDepth = braceDepth + 1
            elif kind == ParserValueTokenRightBrace: braceDepth = braceDepth - 1
            elif (kind == ParserValueTokenComma ||
                  kind == ParserValueTokenSemicolon) &&
                 parenDepth == 0 && bracketDepth == 0 &&
                 braceDepth == 0:
                split = true
        if parenDepth < 0 || bracketDepth < 0 || braceDepth < 0:
            err = "parser type syntax: unbalanced bracket argument"
            return false
        if split:
            if cursor <= segmentStart:
                err = "parser type syntax: empty bracket argument"
                return false
            ParserScratchSeqAdd(tree, startsScratch, segmentStart)
            ParserScratchSeqAdd(tree, countsScratch, cursor - segmentStart)
            segmentStart = cursor + 1
        cursor = cursor + 1
    if parenDepth != 0 || bracketDepth != 0 || braceDepth != 0:
        err = "parser type syntax: unbalanced bracket argument"
        return false
    ParserScratchCopyOutToHeap(tree, startsScratch, starts)
    ParserScratchCopyOutToHeap(tree, countsScratch, counts)
    err = ""
    return true

fn parserTypeSyntaxListInto(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        ownerTokenIndex: int32,
        namedItems: bool,
        out: var int32[],
        err: var str): bool =
    out = []
    if tokenStart >= tokenLimit:
        return true
    # [ar2-scratch] AD1 batch 2a: type list items ride the tree scratch
    # arena.  Each item consumes at least one token, so the token span is a
    # hard bound; CopyOut at the success exit keeps the heap-seq out-param
    # contract unchanged for the callers (which may still append, e.g. the
    # fn-type return slot).
    var outScratch: ParserScratchSeqInt32
    if !ParserScratchSeqReserve(tree, outScratch, tokenLimit - tokenStart):
        panic("parser scratch: type list reserve failed")
    var segmentStart = tokenStart
    var cursor = tokenStart
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    while cursor <= tokenLimit:
        let atEnd = cursor == tokenLimit
        var split = atEnd
        if !atEnd:
            let kind = ParserValueExprTokenKindAt(tree, cursor)
            if kind == ParserValueTokenLeftParen: parenDepth = parenDepth + 1
            elif kind == ParserValueTokenRightParen: parenDepth = parenDepth - 1
            elif kind == ParserValueTokenLeftBracket:
                bracketDepth = bracketDepth + 1
            elif kind == ParserValueTokenRightBracket:
                bracketDepth = bracketDepth - 1
            elif kind == ParserValueTokenLeftBrace: braceDepth = braceDepth + 1
            elif kind == ParserValueTokenRightBrace: braceDepth = braceDepth - 1
            elif (kind == ParserValueTokenComma ||
                  kind == ParserValueTokenSemicolon) &&
                 parenDepth == 0 && bracketDepth == 0 && braceDepth == 0:
                split = true
        if parenDepth < 0 || bracketDepth < 0 || braceDepth < 0:
            err = "parser type syntax: unbalanced type list"
            return false
        if split:
            if cursor <= segmentStart:
                err = "parser type syntax: empty type list item"
                return false
            var itemStart = segmentStart
            var itemLimit = cursor
            var itemOwner = ownerTokenIndex
            if namedItems:
                let colon = parserTypeSyntaxTopLevelColon(
                    tree, segmentStart, cursor)
                if colon >= segmentStart:
                    if colon == segmentStart || colon + 1 >= cursor:
                        err = "parser type syntax: malformed named type item"
                        return false
                    itemOwner = segmentStart
                    itemStart = colon + 1
                    let defaultAssign = ParserValueExprFindTopLevelKind(
                        tree,
                        itemStart,
                        cursor,
                        ParserValueTokenAssign)
                    if defaultAssign >= 0:
                        if defaultAssign == itemStart ||
                           defaultAssign + 1 >= cursor:
                            err = "parser type syntax: malformed named type default"
                            return false
                        itemLimit = defaultAssign
            var itemNode: int32
            if !parserTypeSyntaxParseRange(tree,
                                            itemStart,
                                            itemLimit,
                                            itemOwner,
                                            itemNode,
                                            err):
                return false
            ParserScratchSeqAdd(tree, outScratch, itemNode)
            segmentStart = cursor + 1
        cursor = cursor + 1
    if parenDepth != 0 || bracketDepth != 0 || braceDepth != 0:
        err = "parser type syntax: unbalanced type list"
        return false
    ParserScratchCopyOutToHeap(tree, outScratch, out)
    return true

fn parserTypeSyntaxParseVariant(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        ownerTokenIndex: int32,
        nodeOut: var int32,
        err: var str): bool =
    if tokenStart < 0 || tokenStart >= tokenLimit ||
       tokenLimit > tree.tokenCount ||
       ParserValueExprTokenKindAt(tree, tokenStart) !=
           ParserValueTokenIdentifier:
        err = "parser type syntax: variant name missing"
        return false
    var fields: int32[]
    if tokenStart + 1 < tokenLimit:
        if ParserValueExprTokenKindAt(tree, tokenStart + 1) !=
               ParserValueTokenLeftParen:
            err = "parser type syntax: variant payload opener missing"
            return false
        let closeIndex = ParserValueExprFindMatchingToken(
            tree,
            tokenStart + 1,
            tokenLimit,
            ParserValueTokenLeftParen,
            ParserValueTokenRightParen)
        if closeIndex != tokenLimit - 1:
            err = "parser type syntax: variant payload close mismatch"
            return false
        if !parserTypeSyntaxListInto(
               tree,
               tokenStart + 2,
               closeIndex,
               tokenStart,
               true,
               fields,
               err):
            return false
    nodeOut = ParserValueExprAppendTypeSyntaxNode(
        tree,
        ParserTypeSyntaxVariant,
        tokenStart,
        tokenLimit,
        ownerTokenIndex,
        tokenStart,
        -1,
        fields,
        ParserTypeSyntaxRootInvalid)
    err = ""
    return true

fn parserTypeSyntaxParseAlgebraic(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        ownerTokenIndex: int32,
        nodeOut: var int32,
        err: var str): bool =
    var variants: int32[]
    # [d5-presize] one variant per top-level `|` segment; every variant
    # consumes at least one token, so (tokenLimit - tokenStart + 1) is a
    # sound bound.  True count restored by setLen before the len==0 check.
    setLen(variants, tokenLimit - tokenStart + 1)
    var variantCount: int32
    var names = ParserNameSeenSetInit(16)
    var segmentStart = tokenStart
    var cursor = tokenStart
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    while cursor <= tokenLimit:
        let atEnd = cursor == tokenLimit
        var split = atEnd
        if !atEnd:
            let kind = ParserValueExprTokenKindAt(tree, cursor)
            if kind == ParserValueTokenLeftParen:
                parenDepth = parenDepth + 1
            elif kind == ParserValueTokenRightParen:
                parenDepth = parenDepth - 1
            elif kind == ParserValueTokenLeftBracket:
                bracketDepth = bracketDepth + 1
            elif kind == ParserValueTokenRightBracket:
                bracketDepth = bracketDepth - 1
            elif kind == ParserValueTokenLeftBrace:
                braceDepth = braceDepth + 1
            elif kind == ParserValueTokenRightBrace:
                braceDepth = braceDepth - 1
            elif kind == ParserValueTokenPipe &&
                 parenDepth == 0 && bracketDepth == 0 &&
                 braceDepth == 0:
                split = true
        if parenDepth < 0 || bracketDepth < 0 || braceDepth < 0:
            err = "parser type syntax: algebraic delimiters invalid"
            return false
        if split:
            if cursor <= segmentStart:
                err = "parser type syntax: empty algebraic variant"
                return false
            if !ParserNameSeenSetInsert(tree, names, segmentStart):
                err = "parser type syntax: duplicate algebraic variant"
                return false
            var variantNode: int32
            if !parserTypeSyntaxParseVariant(
                   tree,
                   segmentStart,
                   cursor,
                   ownerTokenIndex,
                   variantNode,
                   err):
                return false
            variants[variantCount] = variantNode
            variantCount = variantCount + 1
            segmentStart = cursor + 1
        cursor = cursor + 1
    setLen(variants, variantCount)
    if parenDepth != 0 || bracketDepth != 0 || braceDepth != 0 ||
       variants.len == 0:
        err = "parser type syntax: algebraic variant list invalid"
        return false
    nodeOut = ParserValueExprAppendTypeSyntaxNode(
        tree,
        ParserTypeSyntaxAlgebraic,
        tokenStart,
        tokenLimit,
        ownerTokenIndex,
        -1,
        -1,
        variants,
        ParserTypeSyntaxRootInvalid)
    err = ""
    return true

fn parserTypeSyntaxParsePrimary(
        tree: var ParserValueExprTree,
        cursor: var int32,
        tokenLimit: int32,
        ownerTokenIndex: int32,
        nodeOut: var int32,
        err: var str): bool =
    if cursor >= tokenLimit:
        err = "parser type syntax: type primary missing"
        return false
    let primaryStart = cursor
    let firstKind = ParserValueExprTokenKindAt(tree, cursor)
    if firstKind == ParserValueTokenLeftParen:
        let closeIndex = ParserValueExprFindMatchingToken(
            tree,
            cursor,
            tokenLimit,
            ParserValueTokenLeftParen,
            ParserValueTokenRightParen)
        if closeIndex < 0:
            err = "parser type syntax: grouped type unterminated"
            return false
        if closeIndex == cursor + 1:
            err = "parser type syntax: grouped type empty"
            return false
        var nested: int32
        if !parserTypeSyntaxParseRange(
               tree,
               cursor + 1,
               closeIndex,
               ownerTokenIndex,
               nested,
               err):
            return false
        cursor = closeIndex + 1
        nodeOut = ParserValueExprAppendTypeSyntaxNode(
            tree,
            ParserTypeSyntaxGrouped,
            primaryStart,
            cursor,
            ownerTokenIndex,
            primaryStart,
            -1,
            [nested],
            ParserTypeSyntaxRootInvalid)
        return true
    if firstKind == ParserValueTokenRef:
        cursor = cursor + 1
        if cursor >= tokenLimit ||
           ParserValueExprTokenKindAt(tree, cursor) !=
               ParserValueTokenObject:
            err = ParserValueExprAdmissionDiagnostic(
                tree,
                primaryStart,
                "ZRPC_PUBLIC_REF_TYPE_FORBIDDEN_USE_REF_OBJECT")
            return false
        cursor = cursor + 1
        var baseChildren: int32[]
        if cursor < tokenLimit:
            if ParserValueExprTokenKindAt(tree, cursor) !=
                   ParserValueTokenOf:
                err = Fmt"parser type syntax: ref object trailing token offset={ParserValueExprTokenStartAt(tree, cursor)}"
                return false
            cursor = cursor + 1
            if cursor >= tokenLimit:
                err = "parser type syntax: ref object inheritance base missing"
                return false
            var baseType: int32
            if !parserTypeSyntaxParseRange(tree,
                                            cursor,
                                            tokenLimit,
                                            ownerTokenIndex,
                                            baseType,
                                            err):
                return false
            add(baseChildren, baseType)
            cursor = tokenLimit
        nodeOut = ParserValueExprAppendTypeSyntaxNode(
            tree,
            ParserTypeSyntaxRefObject,
            primaryStart,
            cursor,
            ownerTokenIndex,
            primaryStart,
            -1,
            baseChildren,
            ParserTypeSyntaxRootInvalid)
        return true
    if firstKind == ParserValueTokenOf:
        cursor = cursor + 1
        if cursor >= tokenLimit:
            err = "parser type syntax: object inheritance base missing"
            return false
        var baseType: int32
        if !parserTypeSyntaxParseRange(tree,
                                        cursor,
                                        tokenLimit,
                                        ownerTokenIndex,
                                        baseType,
                                        err):
            return false
        cursor = tokenLimit
        nodeOut = ParserValueExprAppendTypeSyntaxNode(
            tree,
            ParserTypeSyntaxObject,
            primaryStart,
            cursor,
            ownerTokenIndex,
            primaryStart,
            -1,
            [baseType],
            ParserTypeSyntaxRootInvalid)
        return true
    if firstKind == ParserValueTokenVar:
        cursor = cursor + 1
        var nested: int32
        if !parserTypeSyntaxParseRange(tree,
                                        cursor,
                                        tokenLimit,
                                        ownerTokenIndex,
                                        nested,
                                        err):
            return false
        cursor = tokenLimit
        nodeOut = ParserValueExprAppendTypeSyntaxNode(
            tree,
            ParserTypeSyntaxVarBorrow,
            primaryStart,
            cursor,
            ownerTokenIndex,
            primaryStart,
            -1,
            [nested],
            ParserTypeSyntaxRootInvalid)
        return true
    if firstKind == ParserValueTokenObject:
        cursor = cursor + 1
        var baseChildren: int32[]
        if cursor < tokenLimit:
            if ParserValueExprTokenKindAt(tree, cursor) !=
                   ParserValueTokenOf:
                err = Fmt"parser type syntax: object trailing token offset={ParserValueExprTokenStartAt(tree, cursor)}"
                return false
            cursor = cursor + 1
            if cursor >= tokenLimit:
                err = "parser type syntax: object inheritance base missing"
                return false
            var baseType: int32
            if !parserTypeSyntaxParseRange(tree,
                                            cursor,
                                            tokenLimit,
                                            ownerTokenIndex,
                                            baseType,
                                            err):
                return false
            add(baseChildren, baseType)
            cursor = tokenLimit
        nodeOut = ParserValueExprAppendTypeSyntaxNode(
            tree,
            ParserTypeSyntaxObject,
            primaryStart,
            cursor,
            ownerTokenIndex,
            primaryStart,
            -1,
            baseChildren,
            ParserTypeSyntaxRootInvalid)
        return true
    if firstKind == ParserValueTokenEnum:
        # Enum member declarations are value declarations, not type children.
        # The exact RHS span remains bound by this marker node and the token
        # table; semantic enum rows are produced separately.
        cursor = tokenLimit
        nodeOut = ParserValueExprAppendTypeSyntaxNode(
            tree,
            ParserTypeSyntaxEnum,
            primaryStart,
            cursor,
            ownerTokenIndex,
            primaryStart,
            -1,
            [],
            ParserTypeSyntaxRootInvalid)
        return true
    if firstKind == ParserValueTokenTuple:
        cursor = cursor + 1
        if cursor >= tokenLimit ||
           ParserValueExprTokenKindAt(tree, cursor) !=
               ParserValueTokenLeftBracket:
            err = "parser type syntax: tuple field list missing"
            return false
        let closeIndex = ParserValueExprFindMatchingToken(
            tree,
            cursor,
            tokenLimit,
            ParserValueTokenLeftBracket,
            ParserValueTokenRightBracket)
        if closeIndex < 0:
            err = "parser type syntax: tuple field list unterminated"
            return false
        var fields: int32[]
        if !parserTypeSyntaxListInto(tree,
                                      cursor + 1,
                                      closeIndex,
                                      ownerTokenIndex,
                                      true,
                                      fields,
                                      err):
            return false
        cursor = closeIndex + 1
        nodeOut = ParserValueExprAppendTypeSyntaxNode(
            tree,
            ParserTypeSyntaxTuple,
            primaryStart,
            cursor,
            ownerTokenIndex,
            primaryStart,
            -1,
            fields,
            ParserTypeSyntaxRootInvalid)
        return true
    if firstKind == ParserValueTokenFn:
        cursor = cursor + 1
        if cursor >= tokenLimit ||
           ParserValueExprTokenKindAt(tree, cursor) !=
               ParserValueTokenLeftParen:
            err = "parser type syntax: function type parameter list missing"
            return false
        let closeIndex = ParserValueExprFindMatchingToken(
            tree,
            cursor,
            tokenLimit,
            ParserValueTokenLeftParen,
            ParserValueTokenRightParen)
        if closeIndex < 0:
            err = "parser type syntax: function type parameter list unterminated"
            return false
        var parts: int32[]
        if !parserTypeSyntaxListInto(tree,
                                      cursor + 1,
                                      closeIndex,
                                      ownerTokenIndex,
                                      true,
                                      parts,
                                      err):
            return false
        cursor = closeIndex + 1
        if cursor < tokenLimit &&
           (ParserValueExprTokenKindAt(tree, cursor) ==
                ParserValueTokenColon ||
            ParserValueExprTokenKindAt(tree, cursor) ==
                ParserValueTokenArrow):
            cursor = cursor + 1
            var returnNode: int32
            if !parserTypeSyntaxParseRange(tree,
                                            cursor,
                                            tokenLimit,
                                            ownerTokenIndex,
                                            returnNode,
                                            err):
                return false
            add(parts, returnNode)
            cursor = tokenLimit
        nodeOut = ParserValueExprAppendTypeSyntaxNode(
            tree,
            ParserTypeSyntaxFunction,
            primaryStart,
            cursor,
            ownerTokenIndex,
            primaryStart,
            -1,
            parts,
            ParserTypeSyntaxRootInvalid)
        return true
    if !parserTypeSyntaxTokenCanName(firstKind):
        err = Fmt"parser type syntax: unsupported primary token={Int32(firstKind)} offset={ParserValueExprTokenStartAt(tree, cursor)}"
        return false
    var nameNodes: int32[]
    while cursor < tokenLimit:
        if !parserTypeSyntaxTokenCanName(
               ParserValueExprTokenKindAt(tree, cursor)):
            break
        let nameToken = cursor
        cursor = cursor + 1
        add(nameNodes,
            ParserValueExprAppendTypeSyntaxNode(
                tree,
                ParserTypeSyntaxNominal,
                nameToken,
                cursor,
                ownerTokenIndex,
                nameToken,
                -1,
                [],
                ParserTypeSyntaxRootInvalid))
        if cursor >= tokenLimit ||
           ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenDot:
            break
        if cursor + 1 >= tokenLimit ||
           !parserTypeSyntaxTokenCanName(
               ParserValueExprTokenKindAt(tree, cursor + 1)):
            err = "parser type syntax: qualified type segment missing"
            return false
        cursor = cursor + 1
    if nameNodes.len == 1:
        nodeOut = nameNodes[0]
        return true
    nodeOut = ParserValueExprAppendTypeSyntaxNode(
        tree,
        ParserTypeSyntaxQualified,
        primaryStart,
        cursor,
        ownerTokenIndex,
        ParserValueExprTypeSyntaxNameTokenAt(
            tree, nameNodes[nameNodes.len - 1]),
        -1,
        nameNodes,
        ParserTypeSyntaxRootInvalid)
    return true

fn parserTypeSyntaxParseRange(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        ownerTokenIndex: int32,
        nodeOut: var int32,
        err: var str): bool =
    if tokenStart < 0 || tokenStart >= tokenLimit ||
       tokenLimit > tree.tokenCount:
        err = "parser type syntax: empty type range"
        return false
    let algebraicPipe = ParserValueExprFindTopLevelKind(
        tree, tokenStart, tokenLimit, ParserValueTokenPipe)
    let variantPayload =
        tokenStart + 1 < tokenLimit &&
        ParserValueExprTokenKindAt(tree, tokenStart) ==
            ParserValueTokenIdentifier &&
        ParserValueExprTokenKindAt(tree, tokenStart + 1) ==
            ParserValueTokenLeftParen
    if algebraicPipe >= 0 || variantPayload:
        return parserTypeSyntaxParseAlgebraic(
            tree,
            tokenStart,
            tokenLimit,
            ownerTokenIndex,
            nodeOut,
            err)
    var cursor = tokenStart
    if !parserTypeSyntaxParsePrimary(tree,
                                      cursor,
                                      tokenLimit,
                                      ownerTokenIndex,
                                      nodeOut,
                                      err):
        return false
    while cursor < tokenLimit:
        let kind = ParserValueExprTokenKindAt(tree, cursor)
        if kind == ParserValueTokenQuestion:
            let questionToken = cursor
            cursor = cursor + 1
            nodeOut = ParserValueExprAppendTypeSyntaxNode(
                tree,
                ParserTypeSyntaxOptional,
                tokenStart,
                cursor,
                ownerTokenIndex,
                -1,
                -1,
                [nodeOut],
                ParserTypeSyntaxRootInvalid)
            ParserValueExprTypeSyntaxSetQuestionToken(
                tree, nodeOut, questionToken)
            continue
        if kind == ParserValueTokenStar:
            err = ParserValueExprAdmissionDiagnostic(
                tree,
                cursor,
                "ZRPC_PUBLIC_RAW_POINTER_TYPE_FORBIDDEN")
            return false
        if kind != ParserValueTokenLeftBracket:
            err = Fmt"parser type syntax: trailing token offset={ParserValueExprTokenStartAt(tree, cursor)}"
            return false
        let closeIndex = ParserValueExprFindMatchingToken(
            tree,
            cursor,
            tokenLimit,
            ParserValueTokenLeftBracket,
            ParserValueTokenRightBracket)
        if closeIndex < 0:
            err = "parser type syntax: type argument list unterminated"
            return false
        let wrapperStart = tokenStart
        if closeIndex == cursor + 1:
            cursor = closeIndex + 1
            nodeOut = ParserValueExprAppendTypeSyntaxNode(
                tree,
                ParserTypeSyntaxSeq,
                wrapperStart,
                cursor,
                ownerTokenIndex,
                -1,
                -1,
                [nodeOut],
                ParserTypeSyntaxRootInvalid)
            continue
        var bracketArgStarts: int32[]
        var bracketArgCounts: int32[]
        if !parserTypeSyntaxBracketArgRangesInto(
               tree,
               cursor + 1,
               closeIndex,
               bracketArgStarts,
               bracketArgCounts,
               err):
            return false
        var fixedLength: int32
        if bracketArgStarts.len == 1 && bracketArgCounts[0] == 1 &&
           parserTypeSyntaxFixedLengthInto(tree, cursor + 1, fixedLength):
            cursor = closeIndex + 1
            nodeOut = ParserValueExprAppendTypeSyntaxNode(
                tree,
                ParserTypeSyntaxFixedArray,
                wrapperStart,
                cursor,
                ownerTokenIndex,
                -1,
                fixedLength,
                [nodeOut],
                ParserTypeSyntaxRootInvalid)
            if !ParserValueExprTypeSyntaxSetBracketArgs(
                   tree,
                   nodeOut,
                   bracketArgStarts,
                   bracketArgCounts,
                   [-1],
                   err):
                return false
            continue
        # [S1b step-3 (9)] `T[NAME]` with a module `const` NAME.  A bare
        # identifier is a perfectly valid TYPE argument too -- the nominal path
        # in parserTypeSyntaxParsePrimary accepts any namable token -- so the
        # generic-application branch below would claim the argument and the
        # const would never be evaluated.  The decision therefore has to be
        # taken BEFORE the type-argument attempt (which also rolls its own
        # syntax back on failure, so it cannot be re-judged afterwards), and it
        # is taken on the exact same evidence the C chain uses:
        # cold_parse_any_fixed_array_type consults symbols_find_const first and
        # dies when the const is not an int32.  A name that is NOT in the table
        # is left completely alone: it keeps the existing type-argument
        # reading, which is what every `Table[int32]`-shaped application
        # depends on.
        var constLengthArg = false
        if bracketArgStarts.len == 1 && bracketArgCounts[0] == 1 &&
           parserTypeSyntaxTokenCanName(
               ParserValueExprTokenKindAt(tree, bracketArgStarts[0])):
            var constInt32: bool
            var constValue: int32
            if parserTypeSyntaxModuleConstFindInto(
                   tree, bracketArgStarts[0], constInt32, constValue):
                if !constInt32:
                    err = Fmt"parser type syntax: fixed array length const must be int32 name={ParserValueExprTokenText(tree, bracketArgStarts[0])}"
                    return false
                if constValue <= 0:
                    err = Fmt"parser type syntax: fixed array length const must be positive name={ParserValueExprTokenText(tree, bracketArgStarts[0])} value={constValue}"
                    return false
                constLengthArg = true
        var bracketArgTypeNodes: int32[]
        var wrapperChildren: int32[]
        var ownedTree: ParserValueExprTree
        ownedTree = tree
        add(wrapperChildren, nodeOut)
        for argOffset in 0..<bracketArgStarts.len:
            var argTypeNode: int32 = -1
            let argStart = bracketArgStarts[argOffset]
            if !constLengthArg:
                if parserTypeSyntaxTryArgumentInto(
                       ownedTree,
                       argStart,
                       argStart + bracketArgCounts[argOffset],
                       ownerTokenIndex,
                       argTypeNode):
                    add(wrapperChildren, argTypeNode)
            add(bracketArgTypeNodes, argTypeNode)
        tree = ownedTree
        cursor = closeIndex + 1
        nodeOut = ParserValueExprAppendTypeSyntaxNode(
            tree,
            ParserTypeSyntaxBracketApply,
            wrapperStart,
            cursor,
            ownerTokenIndex,
            -1,
            -1,
            wrapperChildren,
            ParserTypeSyntaxRootInvalid)
        if !ParserValueExprTypeSyntaxSetBracketArgs(
               tree,
               nodeOut,
               bracketArgStarts,
               bracketArgCounts,
               bracketArgTypeNodes,
               err):
            return false
    err = ""
    return true

fn ParserValueExprAppendTypeSyntaxRootInto(
        tree: var ParserValueExprTree,
        tokenStartRaw: int32,
        tokenLimit: int32,
        ownerTokenIndex: int32,
        rootKind: ParserTypeSyntaxRootKind,
        aliasDeclaration: bool,
        declarationOwnerNodeIndex: int32,
        declarationOwnerTokenIndexRaw: int32,
        rootNodeOut: var int32,
        err: var str): bool =
    rootNodeOut = -1
    var tokenStart = tokenStartRaw
    if tokenStart < tokenLimit &&
       (ParserValueExprTokenKindAt(tree, tokenStart) ==
            ParserValueTokenColon ||
        ParserValueExprTokenKindAt(tree, tokenStart) ==
            ParserValueTokenArrow):
        tokenStart = tokenStart + 1
    if rootKind == ParserTypeSyntaxRootInvalid ||
       tokenStart >= tokenLimit:
        err = "parser type syntax: root range missing"
        return false
    let nodeCountBefore = tree.typeSyntaxCount
    let childCountBefore = tree.typeSyntaxChildCount
    var rootNode: int32
    if !parserTypeSyntaxParseRange(tree,
                                    tokenStart,
                                    tokenLimit,
                                    ownerTokenIndex,
                                    rootNode,
                                    err):
        return false
    if aliasDeclaration:
        let parsedKind = ParserValueExprTypeSyntaxKindAt(tree, rootNode)
        if parsedKind != ParserTypeSyntaxObject &&
           parsedKind != ParserTypeSyntaxRefObject &&
           parsedKind != ParserTypeSyntaxEnum &&
           parsedKind != ParserTypeSyntaxAlgebraic:
            rootNode = ParserValueExprAppendTypeSyntaxNode(
                tree,
                ParserTypeSyntaxAlias,
                tokenStart,
                tokenLimit,
                ownerTokenIndex,
                -1,
                -1,
                [rootNode],
                ParserTypeSyntaxRootInvalid)
    ParserValueExprTypeSyntaxSetRootKind(tree, rootNode, rootKind)
    if rootKind == ParserTypeSyntaxRootTypeDeclarationRhs:
        if declarationOwnerNodeIndex >= 0:
            err = "parser type syntax: type declaration has external owner"
            return false
        ParserValueExprTypeSyntaxSetDeclarationOwner(
            tree, rootNode, rootNode)
    elif rootKind == ParserTypeSyntaxRootFieldDeclaration:
        if declarationOwnerNodeIndex < 0:
            err = "parser type syntax: field declaration owner missing"
            return false
        ParserValueExprTypeSyntaxSetDeclarationOwner(
            tree, rootNode, declarationOwnerNodeIndex)
    elif declarationOwnerNodeIndex >= 0:
        err = "parser type syntax: unexpected declaration owner"
        return false
    var declarationOwnerTokenIndex = declarationOwnerTokenIndexRaw
    if rootKind == ParserTypeSyntaxRootFieldDeclaration:
        declarationOwnerTokenIndex =
            ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                tree, declarationOwnerNodeIndex)
    elif declarationOwnerTokenIndex < 0:
        declarationOwnerTokenIndex = ownerTokenIndex
    ParserValueExprTypeSyntaxSetDeclarationOwnerToken(
        tree, rootNode, declarationOwnerTokenIndex)
    if tree.typeSyntaxCount <= nodeCountBefore ||
       tree.typeSyntaxChildCount < childCountBefore:
        panic("parser type syntax: root producer made no progress")
    rootNodeOut = rootNode
    err = ""
    return true

fn ParserValueExprAppendTypeSyntaxRoot(
        tree: var ParserValueExprTree,
        tokenStartRaw: int32,
        tokenLimit: int32,
        ownerTokenIndex: int32,
        rootKind: ParserTypeSyntaxRootKind,
        aliasDeclaration: bool,
        err: var str): bool =
    var ignoredRoot: int32
    return ParserValueExprAppendTypeSyntaxRootInto(
        tree,
        tokenStartRaw,
        tokenLimit,
        ownerTokenIndex,
        rootKind,
        aliasDeclaration,
        -1,
        ownerTokenIndex,
        ignoredRoot,
        err)

fn ParserValueExprAppendTypeSyntaxRootWithGenericSymbols(
        tree: var ParserValueExprTree,
        tokenStartRaw: int32,
        tokenLimit: int32,
        ownerTokenIndex: int32,
        rootKind: ParserTypeSyntaxRootKind,
        declarationOwnerTokenIndex: int32,
        genericSymbolStart: int32,
        genericSymbolCount: int32,
        err: var str): bool =
    var rootNode: int32
    if !ParserValueExprAppendTypeSyntaxRootInto(
           tree,
           tokenStartRaw,
           tokenLimit,
           ownerTokenIndex,
           rootKind,
           false,
           -1,
           declarationOwnerTokenIndex,
           rootNode,
           err):
        return false
    if genericSymbolCount > 0:
        ParserValueExprTypeSyntaxSetGenericSymbols(
            tree, rootNode, genericSymbolStart, genericSymbolCount)
    elif genericSymbolStart >= 0:
        err = "parser type syntax: empty generic symbol range"
        return false
    return true

fn ParserValueExprSetNodeGenericRange(tree: var ParserValueExprTree,
                                        nodeIndex: int32,
                                        genericStart: int32,
                                        genericCount: int32) =
    ParserValueExprRequireNode(tree, nodeIndex)
    if genericStart < 0 || genericCount < 0 ||
       genericStart > tree.genericCount - genericCount:
        panic("parser value expr: generic range out of bounds")
    arenamod.ArenaArrayInt32Set(tree.arena,
                                 tree.explicitGenericStarts,
                                 nodeIndex,
                                 genericStart)
    arenamod.ArenaArrayInt32Set(tree.arena,
                                 tree.explicitGenericCounts,
                                 nodeIndex,
                                 genericCount)

fn ParserValueExprAppendArgumentRoots(tree: var ParserValueExprTree,
                                        callNodeIndex: int32,
                                        roots: int32[]) =
    ParserValueExprRequireNode(tree, callNodeIndex)
    let rootStart = tree.rootCount
    for rootIndex in 0..<roots.len:
        ParserValueExprRequireNode(tree, roots[rootIndex])
        arenamod.ArenaArrayInt32Add(tree.arena,
                                     tree.rootNodeIndexes,
                                     roots[rootIndex])
        tree.rootCount = tree.rootCount + 1
    arenamod.ArenaArrayInt32Set(tree.arena,
                                 tree.argumentRootStarts,
                                 callNodeIndex,
                                 rootStart)
    arenamod.ArenaArrayInt32Set(tree.arena,
                                 tree.argumentRootCounts,
                                 callNodeIndex,
                                 roots.len)

fn ParserValueExprTokenCanStartSpaceAtom(kind: ParserValueTokenKind): bool =
    return ParserValueExprTokenCanName(kind) ||
           kind == ParserValueTokenInteger || kind == ParserValueTokenFloat ||
           kind == ParserValueTokenString || kind == ParserValueTokenChar ||
           kind == ParserValueTokenFmtString || kind == ParserValueTokenTrue ||
           kind == ParserValueTokenFalse || kind == ParserValueTokenNil ||
           kind == ParserValueTokenLeftParen ||
           kind == ParserValueTokenLeftBracket ||
           kind == ParserValueTokenLeftBrace || kind == ParserValueTokenFn ||
           kind == ParserValueTokenIterator

fn ParserValueExprBinaryPrecedence(kind: ParserValueTokenKind): int32 =
    if kind == ParserValueTokenLogicalOr: return 20
    if kind == ParserValueTokenLogicalAnd: return 30
    if kind == ParserValueTokenPipe: return 40
    if kind == ParserValueTokenCaret: return 45
    if kind == ParserValueTokenAmp: return 50
    if kind == ParserValueTokenEqual || kind == ParserValueTokenNotEqual:
        return 60
    if kind == ParserValueTokenLess || kind == ParserValueTokenLessEqual ||
       kind == ParserValueTokenGreater || kind == ParserValueTokenGreaterEqual:
        return 65
    if kind == ParserValueTokenIn || kind == ParserValueTokenNotIn:
        return 70
    if kind == ParserValueTokenRangeInclusive ||
       kind == ParserValueTokenRangeExclusive:
        return 75
    if kind == ParserValueTokenShiftLeft || kind == ParserValueTokenShiftRight:
        return 77
    if kind == ParserValueTokenPlus || kind == ParserValueTokenMinus:
        return 80
    if kind == ParserValueTokenStar || kind == ParserValueTokenSlash ||
       kind == ParserValueTokenPercent:
        return 90
    return -1

fn ParserValueExprTokenIsPrefix(kind: ParserValueTokenKind): bool =
    return kind == ParserValueTokenPlus || kind == ParserValueTokenMinus ||
           kind == ParserValueTokenBang || kind == ParserValueTokenTilde ||
           kind == ParserValueTokenDollar || kind == ParserValueTokenCaret ||
           kind == ParserValueTokenPercent || kind == ParserValueTokenAwait

@borrows
fn ParserValueExprAdmissionDiagnostic(
        tree: ParserValueExprTree,
        tokenIndex: int32,
        code: str): str =
    if tree == nil || tokenIndex < 0 || tokenIndex >= tree.tokenCount:
        return Fmt"{code} token_index={tokenIndex}"
    return Fmt"{code} token_index={tokenIndex} token_kind={Int32(ParserValueExprTokenKindAt(tree, tokenIndex))} source_id={ParserValueExprTokenSourceIdAt(tree, tokenIndex)} span_start={ParserValueExprTokenStartAt(tree, tokenIndex)} span_end={ParserValueExprTokenEndAt(tree, tokenIndex)}"

@borrows
fn ParserValueExprTokenTight(tree: ParserValueExprTree,
                               leftToken: int32,
                               rightToken: int32): bool =
    return ParserValueExprTokenSourceIdAt(tree, leftToken) ==
               ParserValueExprTokenSourceIdAt(tree, rightToken) &&
           ParserValueExprTokenEndAt(tree, leftToken) ==
               ParserValueExprTokenStartAt(tree, rightToken)

@borrows
fn ParserValueExprQuestionHasColon(tree: ParserValueExprTree,
                                     questionIndex: int32,
                                     tokenLimit: int32): bool =
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    var nestedQuestions: int32
    var cursor = questionIndex + 1
    while cursor < tokenLimit:
        let kind = ParserValueExprTokenKindAt(tree, cursor)
        if kind == ParserValueTokenLeftParen: parenDepth = parenDepth + 1
        elif kind == ParserValueTokenRightParen:
            if parenDepth == 0: return false
            parenDepth = parenDepth - 1
        elif kind == ParserValueTokenLeftBracket: bracketDepth = bracketDepth + 1
        elif kind == ParserValueTokenRightBracket:
            if bracketDepth == 0: return false
            bracketDepth = bracketDepth - 1
        elif kind == ParserValueTokenLeftBrace: braceDepth = braceDepth + 1
        elif kind == ParserValueTokenRightBrace:
            if braceDepth == 0: return false
            braceDepth = braceDepth - 1
        elif parenDepth == 0 && bracketDepth == 0 && braceDepth == 0:
            if kind == ParserValueTokenComma || kind == ParserValueTokenSemicolon:
                return false
            if kind == ParserValueTokenQuestion:
                nestedQuestions = nestedQuestions + 1
            elif kind == ParserValueTokenColon:
                if nestedQuestions == 0:
                    return true
                nestedQuestions = nestedQuestions - 1
        cursor = cursor + 1
    return false

@borrows
fn ParserValueExprFindMatchingToken(tree: ParserValueExprTree,
                                      openIndex: int32,
                                      tokenLimit: int32,
                                      openKind: ParserValueTokenKind,
                                      closeKind: ParserValueTokenKind): int32 =
    if openIndex < 0 || openIndex >= tokenLimit ||
       ParserValueExprTokenKindAt(tree, openIndex) != openKind:
        return -1
    var depth: int32
    for cursor in openIndex..<tokenLimit:
        let kind = ParserValueExprTokenKindAt(tree, cursor)
        if kind == openKind:
            depth = depth + 1
        elif kind == closeKind:
            depth = depth - 1
            if depth == 0:
                return cursor
    return -1

fn ParserValueExprParseIfLike(tree: var ParserValueExprTree,
                                cursor: var int32,
                                tokenLimit: int32,
                                kind: ParserValueExprKind,
                                rootOut: var int32,
                                err: var str): bool =
    let keywordIndex = cursor
    let sourceTextId = ParserValueExprTokenSourceIdAt(tree, keywordIndex)
    let spanStart = ParserValueExprTokenStartAt(tree, keywordIndex)
    cursor = cursor + 1
    var children: int32[]
    # [d5-presize] one child per branch (2 per condition+value link, 1 per
    # else) and every add consumes at least one token, so
    # (tokenLimit - keywordIndex) is a sound upper bound.  Presizing removes
    # the add-growth doublings that leak one superseded buffer each; the true
    # count is restored with setLen right after the loop, before any read.
    setLen(children, tokenLimit - keywordIndex)
    var childCount: int32
    var sawElse = false
    while cursor < tokenLimit:
        let branchKind = ParserValueExprTokenKindAt(tree, cursor)
        if branchKind == ParserValueTokenElse:
            cursor = cursor + 1
            if cursor >= tokenLimit ||
               ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenColon:
                err = "parser value expr: else separator missing"
                return false
            cursor = cursor + 1
            var elseRoot: int32
            if !ParserValueExprParseExpression(tree,
                                                cursor,
                                                tokenLimit,
                                                0,
                                                elseRoot,
                                                err):
                return false
            children[childCount] = elseRoot
            childCount = childCount + 1
            sawElse = true
            break
        if branchKind == ParserValueTokenElif:
            cursor = cursor + 1
        var conditionRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            tokenLimit,
                                            0,
                                            conditionRoot,
                                            err):
            return false
        if cursor >= tokenLimit ||
           ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenColon:
            err = "parser value expr: conditional branch separator missing"
            return false
        cursor = cursor + 1
        var valueRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            tokenLimit,
                                            0,
                                            valueRoot,
                                            err):
            return false
        children[childCount] = conditionRoot
        childCount = childCount + 1
        children[childCount] = valueRoot
        childCount = childCount + 1
        if cursor >= tokenLimit ||
           (ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenElif &&
            ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenElse):
            break
    setLen(children, childCount)
    if kind == ParserValueExprIf && !sawElse:
        err = "parser value expr: if expression else missing"
        return false
    if children.len < 2:
        err = "parser value expr: conditional expression branch missing"
        return false
    let lastChild = children[children.len - 1]
    rootOut = ParserValueExprAppendNode(
        tree,
        sourceTextId,
        kind,
        spanStart,
        ParserValueExprNodeSpanEndAt(tree, lastChild),
        children)
    ParserValueExprSetNodeOperator(
        tree,
        rootOut,
        ParserValueExprTokenStartAt(tree, keywordIndex),
        ParserValueExprTokenEndAt(tree, keywordIndex))
    return true

fn ParserValueExprParsePrefixComprehension(tree: var ParserValueExprTree,
                                             cursor: var int32,
                                             tokenLimit: int32,
                                             rootOut: var int32,
                                             err: var str): bool =
    let forIndex = cursor
    let sourceTextId = ParserValueExprTokenSourceIdAt(tree, forIndex)
    let spanStart = ParserValueExprTokenStartAt(tree, forIndex)
    cursor = cursor + 1
    let patternStartToken = cursor
    var parenDepth: int32
    var bracketDepth: int32
    var patternStopToken: int32 = -1
    while cursor < tokenLimit:
        let tokenKind = ParserValueExprTokenKindAt(tree, cursor)
        if tokenKind == ParserValueTokenLeftParen: parenDepth = parenDepth + 1
        elif tokenKind == ParserValueTokenRightParen: parenDepth = parenDepth - 1
        elif tokenKind == ParserValueTokenLeftBracket: bracketDepth = bracketDepth + 1
        elif tokenKind == ParserValueTokenRightBracket: bracketDepth = bracketDepth - 1
        elif tokenKind == ParserValueTokenIn && parenDepth == 0 && bracketDepth == 0:
            patternStopToken = cursor
            break
        cursor = cursor + 1
    if patternStopToken <= patternStartToken:
        err = "parser value expr: comprehension pattern or in missing"
        return false
    let previousScopeRow = tree.activeDeclarationLexicalScopeRow
    let comprehensionScopeRow =
        ParserValueExprAppendDeclarationLexicalScope(
            tree,
            ParserDeclarationLexicalScopeBlock,
            previousScopeRow,
            tree.activeFunctionDeclarationRow)
    tree.activeDeclarationLexicalScopeRow = comprehensionScopeRow
    let comprehensionDeclarationStart = tree.declarationCount
    let comprehensionPatternStart = tree.patternCount
    let patternRegionRow = tree.regionCount
    ParserValueExprAppendRegion(
        tree,
        ParserValueExprRegionPattern,
        ParserValueExprTokenSourceIdAt(tree, patternStartToken),
        ParserValueExprTokenStartAt(tree, patternStartToken),
        ParserValueExprTokenEndAt(tree, patternStopToken - 1),
        patternStartToken)
    if !ParserValueExprParsePatternListRange(
           tree,
           patternStartToken,
           patternStopToken,
           forIndex,
           tokenLimit,
           false,
           ParserPatternParseBindingDeclaration,
           ParserPatternOwnerRegion,
           patternRegionRow,
           err):
        return false
    let patternStart = ParserValueExprTokenStartAt(tree, patternStartToken)
    let patternEnd = ParserValueExprTokenEndAt(tree, patternStopToken - 1)
    cursor = patternStopToken + 1
    tree.activeDeclarationLexicalScopeRow = previousScopeRow
    var iteratorRoot: int32
    if !ParserValueExprParseExpression(tree,
                                        cursor,
                                        tokenLimit,
                                        0,
                                        iteratorRoot,
                                        err):
        return false
    tree.activeDeclarationLexicalScopeRow = comprehensionScopeRow
    let iteratorAnchorToken = cursor - 1
    for patternRow in comprehensionPatternStart..<tree.patternCount:
        if ParserPatternKind(arenamod.ArenaArrayInt32Get(
               tree.arena, tree.patternKinds, patternRow)) !=
               ParserPatternBinding:
            continue
        let declarationRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.patternBindingDeclarationRows,
            patternRow)
        if !ParserValueExprAppendLexicalBinding(
               tree,
               declarationRow,
               patternRow,
               ParserLexicalBindingIntroductionPatternIterator,
               -1,
               iteratorRoot,
               iteratorAnchorToken,
               err):
            return false
    var children: int32[]
    add(children, iteratorRoot)
    if cursor < tokenLimit &&
       ParserValueExprTokenKindAt(tree, cursor) == ParserValueTokenIf:
        cursor = cursor + 1
        var filterRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            tokenLimit,
                                            0,
                                            filterRoot,
                                            err):
            return false
        add(children, filterRoot)
    if cursor >= tokenLimit ||
       ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenColon:
        err = "parser value expr: comprehension body separator missing"
        return false
    cursor = cursor + 1
    var bodyRoot: int32
    if !ParserValueExprParseExpression(tree,
                                        cursor,
                                        tokenLimit,
                                        0,
                                        bodyRoot,
                                        err):
        return false
    add(children, bodyRoot)
    rootOut = ParserValueExprAppendNode(
        tree,
        sourceTextId,
        ParserValueExprComprehension,
        spanStart,
        ParserValueExprNodeSpanEndAt(tree, bodyRoot),
        children)
    ParserValueExprSetNodeAtom(tree,
                                rootOut,
                                patternStart,
                                patternEnd)
    ParserValueExprSetNodeOperator(
        tree,
        rootOut,
        ParserValueExprTokenStartAt(tree, forIndex),
        ParserValueExprTokenEndAt(tree, forIndex))
    let comprehensionSpanEnd =
        ParserValueExprNodeSpanEndAt(tree, rootOut)
    for declarationRow in
            comprehensionDeclarationStart..<tree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeRows,
               declarationRow) != comprehensionScopeRow:
            continue
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationSpanEnds,
               declarationRow) < comprehensionSpanEnd:
            panic("parser comprehension: declaration span does not cover body")
        arenamod.ArenaArrayInt32Set(
            tree.arena,
            tree.declarationSpanEnds,
            declarationRow,
            comprehensionSpanEnd)
    ParserValueExprSetDeclarationLexicalScopeSpanBytes(
        tree,
        comprehensionScopeRow,
        spanStart,
        comprehensionSpanEnd)
    tree.activeDeclarationLexicalScopeRow = previousScopeRow
    return true

fn ParserValueExprProcessSuiteRange(tree: var ParserValueExprTree,
                                      tokenStart: int32,
                                      tokenLimit: int32,
                                      err: var str): bool =
    if tokenStart < 0 || tokenStart >= tokenLimit ||
       tokenLimit > tree.tokenCount:
        err = Fmt"PARSER_EMPTY_SUITE_FORBIDDEN token_start={tokenStart} token_limit={tokenLimit}"
        return false
    let previousScopeRow = tree.activeDeclarationLexicalScopeRow
    var suiteOwnerDeclarationRow = tree.activeFunctionDeclarationRow
    if suiteOwnerDeclarationRow < 0:
        suiteOwnerDeclarationRow = tree.activeConceptTraitDeclarationRow
    let suiteScopeRow =
        ParserValueExprAppendDeclarationLexicalScope(
            tree,
            ParserDeclarationLexicalScopeBlock,
            previousScopeRow,
            suiteOwnerDeclarationRow)
    tree.activeDeclarationLexicalScopeRow = suiteScopeRow
    ParserValueExprSetDeclarationLexicalScopeSpanTokens(
        tree, suiteScopeRow, tokenStart, tokenLimit)
    var cursor = tokenStart
    var bindingBlockColumn: int32 = -1
    var bindingEntryColumn: int32 = -1
    var bindingBlockEntryCount: int32
    var bindingBlockMutableFlag = false
    while cursor < tokenLimit:
        var statementLimit = ParserValueExprLogicalLineEnd(
            tree, cursor, tokenLimit)
        statementLimit = ParserValueExprExtendIndentedValueRange(
            tree, cursor, statementLimit, tokenLimit)
        if statementLimit <= cursor:
            err = "parser value expr: suite statement made no progress"
            return false
        let statementColumn = ParserValueExprTokenColumnAt(tree, cursor)
        let firstKind = ParserValueExprTokenKindAt(tree, cursor)
        if bindingBlockColumn >= 0 &&
           statementColumn <= bindingBlockColumn:
            if bindingBlockEntryCount <= 0:
                err = "parser declaration: binding block is empty"
                return false
            bindingBlockColumn = -1
            bindingEntryColumn = -1
            bindingBlockEntryCount = 0
            bindingBlockMutableFlag = false
        if (firstKind == ParserValueTokenLet ||
            firstKind == ParserValueTokenVar ||
            firstKind == ParserValueTokenConst) &&
           cursor + 1 == statementLimit:
            bindingBlockColumn = statementColumn
            bindingEntryColumn = -1
            bindingBlockEntryCount = 0
            bindingBlockMutableFlag = firstKind == ParserValueTokenVar
            cursor = statementLimit
            continue
        if bindingBlockColumn >= 0:
            if bindingEntryColumn < 0:
                bindingEntryColumn = statementColumn
            if statementColumn != bindingEntryColumn:
                err = "parser declaration: binding block entry indentation invalid"
                return false
            let bindingEntryLimit = ParserValueExprExtendBindingEntryFormB(
                tree, cursor, statementLimit, tokenLimit)
            if !ParserValueExprProcessBindingEntryRange(
                   tree,
                   cursor,
                   bindingEntryLimit,
                   cursor,
                   bindingBlockMutableFlag,
                   err):
                return false
            bindingBlockEntryCount = bindingBlockEntryCount + 1
            cursor = bindingEntryLimit
            continue
        if (firstKind == ParserValueTokenLet ||
            firstKind == ParserValueTokenVar ||
            firstKind == ParserValueTokenConst) &&
           cursor + 1 < statementLimit:
            # 普通(非绑定块) var/let/const Form-B 语句(`var x:` EOL、类型
            # 独占更深缩进下一逻辑行, 入口 :7359 `var runtimeResult:` 实证):
            # 与绑定块/字段同族(wall17)延伸语句范围至类型行——延伸必须发
            # 生在套件循环 cursor 推进处, 否则类型行被当独立语句二次解析
            # (forwarding authority invalid 自伤)。行内非 Form-B 时延伸
            # 函数原样返回。
            statementLimit = ParserValueExprExtendBindingEntryFormB(
                tree, cursor + 1, statementLimit, tokenLimit)
        if firstKind == ParserValueTokenConcept ||
           firstKind == ParserValueTokenTrait:
            statementLimit = ParserValueExprIndentedSuiteEnd(
                tree,
                statementLimit,
                tokenLimit,
                statementColumn)
        if !ParserValueExprProcessStatementRange(tree,
                                                  cursor,
                                                  statementLimit,
                                                  false,
                                                  err):
            err = Fmt"{err} statement_offset={ParserValueExprTokenStartAt(tree, cursor)}"
            return false
        cursor = statementLimit
    if bindingBlockColumn >= 0 && bindingBlockEntryCount <= 0:
        err = "parser declaration: binding block is empty"
        return false
    tree.activeDeclarationLexicalScopeRow = previousScopeRow
    return true

fn ParserValueExprParseFunctionLiteral(tree: var ParserValueExprTree,
                                         cursor: var int32,
                                         tokenLimit: int32,
                                         rootOut: var int32,
                                         err: var str): bool =
    let keywordIndex = cursor
    let keywordKind = ParserValueExprTokenKindAt(tree, keywordIndex)
    let sourceTextId = ParserValueExprTokenSourceIdAt(tree, keywordIndex)
    let spanStart = ParserValueExprTokenStartAt(tree, keywordIndex)
    cursor = cursor + 1
    var nameStart: int32 = -1
    var nameEnd: int32 = -1
    if cursor < tokenLimit &&
       ParserValueExprTokenCanName(
           ParserValueExprTokenKindAt(tree, cursor)):
        nameStart = ParserValueExprTokenStartAt(tree, cursor)
        nameEnd = ParserValueExprTokenEndAt(tree, cursor)
        cursor = cursor + 1
    if cursor < tokenLimit &&
       ParserValueExprTokenKindAt(tree, cursor) == ParserValueTokenLeftBracket:
        let genericClose = ParserValueExprFindMatchingToken(
            tree,
            cursor,
            tokenLimit,
            ParserValueTokenLeftBracket,
            ParserValueTokenRightBracket)
        if genericClose < 0:
            err = "parser value expr: literal type parameter list unterminated"
            return false
        cursor = genericClose + 1
    if cursor >= tokenLimit ||
       ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenLeftParen:
        err = "parser value expr: literal parameter list missing"
        return false
    let paramClose = ParserValueExprFindMatchingToken(
        tree,
        cursor,
        tokenLimit,
        ParserValueTokenLeftParen,
        ParserValueTokenRightParen)
    if paramClose < 0:
        err = "parser value expr: literal parameter list unterminated"
        return false
    cursor = paramClose + 1
    if cursor < tokenLimit &&
       ParserValueExprTokenKindAt(tree, cursor) == ParserValueTokenColon:
        cursor = cursor + 1
        var typeDepth: int32
        while cursor < tokenLimit:
            let kind = ParserValueExprTokenKindAt(tree, cursor)
            if kind == ParserValueTokenLeftBracket ||
               kind == ParserValueTokenLeftParen:
                typeDepth = typeDepth + 1
            elif kind == ParserValueTokenRightBracket ||
                 kind == ParserValueTokenRightParen:
                typeDepth = typeDepth - 1
            elif typeDepth == 0 &&
                 (kind == ParserValueTokenWhere ||
                  kind == ParserValueTokenAssign):
                break
            cursor = cursor + 1
    var children: int32[]
    # [d5-presize] the exact child count (where root + unowned statement
    # roots) is only known after the suite is parsed, so the where root is
    # staged below instead of appended: the two loops after the suite count
    # first, setLen exactly once (zero displaced buffers, zero over-size),
    # then fill by index in the same order the adds used to produce.
    var hasWhereChild = false
    var whereChildRoot: int32 = -1
    if cursor < tokenLimit &&
       ParserValueExprTokenKindAt(tree, cursor) == ParserValueTokenWhere:
        cursor = cursor + 1
        var whereRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            tokenLimit,
                                            0,
                                            whereRoot,
                                            err):
            return false
        hasWhereChild = true
        whereChildRoot = whereRoot
    if cursor >= tokenLimit ||
       ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenAssign:
        err = "parser value expr: literal suite assignment missing"
        return false
    cursor = cursor + 1
    var suiteLimit = ParserValueExprFindTopLevelKind(
        tree,
        cursor,
        tokenLimit,
        ParserValueTokenComma)
    if suiteLimit < 0:
        suiteLimit = tokenLimit
    if cursor >= suiteLimit:
        err = ParserValueExprAdmissionDiagnostic(
            tree,
            cursor - 1,
            "PARSER_EMPTY_SUITE_FORBIDDEN")
        return false
    let rootCountBefore = tree.statementRootCount
    if !ParserValueExprProcessSuiteRange(tree,
                                         cursor,
                                         suiteLimit,
                                         err):
        return false
    var childCount: int32
    if hasWhereChild:
        childCount = childCount + 1
    for rootIndex in rootCountBefore..<tree.statementRootCount:
        let statementRoot =
            ParserValueExprStatementRootNodeAt(tree, rootIndex)
        # A nested literal has already claimed its own statement roots.
        # Only still-unowned roots are direct children of this literal.
        if ParserValueExprNodeParentAt(tree, statementRoot) < 0:
            childCount = childCount + 1
    setLen(children, childCount)
    var childIndex: int32
    if hasWhereChild:
        children[0] = whereChildRoot
        childIndex = 1
    for rootIndex in rootCountBefore..<tree.statementRootCount:
        let statementRoot =
            ParserValueExprStatementRootNodeAt(tree, rootIndex)
        if ParserValueExprNodeParentAt(tree, statementRoot) < 0:
            children[childIndex] = statementRoot
            childIndex = childIndex + 1
    cursor = suiteLimit
    var nodeKind = ParserValueExprFunctionLiteral
    if keywordKind == ParserValueTokenIterator:
        nodeKind = ParserValueExprIteratorLiteral
    rootOut = ParserValueExprAppendNode(
        tree,
        sourceTextId,
        nodeKind,
        spanStart,
        ParserValueExprTokenEndAt(tree, suiteLimit - 1),
        children)
    if nameStart >= 0:
        ParserValueExprSetNodeAtom(tree, rootOut, nameStart, nameEnd)
    ParserValueExprSetNodeOperator(
        tree,
        rootOut,
        ParserValueExprTokenStartAt(tree, keywordIndex),
        ParserValueExprTokenEndAt(tree, keywordIndex))
    return true

fn ParserValueExprParseCase(tree: var ParserValueExprTree,
                              cursor: var int32,
                              tokenLimit: int32,
                              rootOut: var int32,
                              err: var str): bool =
    let caseIndex = cursor
    let sourceTextId = ParserValueExprTokenSourceIdAt(tree, caseIndex)
    let spanStart = ParserValueExprTokenStartAt(tree, caseIndex)
    cursor = cursor + 1
    var subjectRoot: int32
    if !ParserValueExprParseExpression(tree,
                                        cursor,
                                        tokenLimit,
                                        0,
                                        subjectRoot,
                                        err):
        return false
    var children: int32[]
    # [d5-presize] children = subject + optional direct value + one root per
    # `of` branch + optional else.  Every add consumes at least one token, so
    # (tokenLimit - caseIndex) is a sound bound; the true count is restored
    # by setLen before the lastChild read at the end.
    setLen(children, tokenLimit - caseIndex)
    var childCount: int32 = 1
    children[0] = subjectRoot
    var directValue = false
    var branchCount: int32
    var hadColon = false
    if cursor < tokenLimit &&
       ParserValueExprTokenKindAt(tree, cursor) == ParserValueTokenColon:
        hadColon = true
        cursor = cursor + 1
    if hadColon && cursor < tokenLimit &&
       ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenOf &&
       ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenElse:
        var directRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            tokenLimit,
                                            0,
                                            directRoot,
                                            err):
            return false
        children[childCount] = directRoot
        childCount = childCount + 1
        directValue = true
    var patternRoots: int32[]
    var entryExpressionRoots: int32[]
    while cursor < tokenLimit &&
          ParserValueExprTokenKindAt(tree, cursor) == ParserValueTokenOf:
        let ofIndex = cursor
        cursor = cursor + 1
        let entryStartToken = cursor
        var parenDepth: int32
        var bracketDepth: int32
        var braceDepth: int32
        var entryStopToken: int32 = -1
        while cursor < tokenLimit:
            let kind = ParserValueExprTokenKindAt(tree, cursor)
            if kind == ParserValueTokenLeftParen: parenDepth = parenDepth + 1
            elif kind == ParserValueTokenRightParen: parenDepth = parenDepth - 1
            elif kind == ParserValueTokenLeftBracket: bracketDepth = bracketDepth + 1
            elif kind == ParserValueTokenRightBracket: bracketDepth = bracketDepth - 1
            elif kind == ParserValueTokenLeftBrace: braceDepth = braceDepth + 1
            elif kind == ParserValueTokenRightBrace: braceDepth = braceDepth - 1
            elif parenDepth == 0 && bracketDepth == 0 && braceDepth == 0 &&
                 (kind == ParserValueTokenIf || kind == ParserValueTokenColon):
                entryStopToken = cursor
                break
            cursor = cursor + 1
        if entryStopToken <= entryStartToken:
            err = "parser value expr: case entry missing"
            return false
        let previousScopeRow = tree.activeDeclarationLexicalScopeRow
        let branchScopeRow =
            ParserValueExprAppendDeclarationLexicalScope(
                tree,
                ParserDeclarationLexicalScopeBlock,
                previousScopeRow,
                tree.activeFunctionDeclarationRow)
        tree.activeDeclarationLexicalScopeRow = branchScopeRow
        let branchDeclarationStart = tree.declarationCount
        let branchPatternStart = tree.patternCount
        setLen(patternRoots, 0)
        setLen(entryExpressionRoots, 0)
        if !ParserValueExprParseCaseEntryListRange(
               tree,
               entryStartToken,
               entryStopToken,
               ofIndex,
               tokenLimit,
               ParserPatternOwnerInvalid,
               -1,
               patternRoots,
               entryExpressionRoots,
               err):
            return false
        if patternRoots.len > 1:
            for patternRow in branchPatternStart..<tree.patternCount:
                if ParserPatternKind(arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.patternKinds,
                       patternRow)) == ParserPatternBinding:
                    err = "parser lexical binding: case alternatives with bindings require one exact pattern"
                    return false
        if !ParserValueExprRegisterPatternBindings(
               tree,
               branchPatternStart,
               ParserLexicalBindingIntroductionPatternEntry,
               -1,
               -1,
               entryStopToken - 1,
               err):
            return false
        var branchChildren: int32[]
        # [d5-presize] tight bound: one slot per entry expression + at most
        # one guard + exactly one value.  setLen once, fill by index, restore
        # the true count before the branch node consumes the list.
        setLen(branchChildren, entryExpressionRoots.len + 2)
        var branchChildCount: int32
        for entryOffset in 0..<entryExpressionRoots.len:
            branchChildren[branchChildCount] =
                entryExpressionRoots[entryOffset]
            branchChildCount = branchChildCount + 1
        if ParserValueExprTokenKindAt(tree, cursor) == ParserValueTokenIf:
            cursor = cursor + 1
            var guardRoot: int32
            if !ParserValueExprParseExpression(tree,
                                                cursor,
                                                tokenLimit,
                                                0,
                                                guardRoot,
                                                err):
                return false
            branchChildren[branchChildCount] = guardRoot
            branchChildCount = branchChildCount + 1
        if cursor >= tokenLimit ||
           ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenColon:
            err = "parser value expr: case branch separator missing"
            return false
        cursor = cursor + 1
        var valueRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            tokenLimit,
                                            0,
                                            valueRoot,
                                            err):
            return false
        branchChildren[branchChildCount] = valueRoot
        branchChildCount = branchChildCount + 1
        setLen(branchChildren, branchChildCount)
        let branchRoot = ParserValueExprAppendNode(
            tree,
            sourceTextId,
            ParserValueExprCaseBranch,
            ParserValueExprTokenStartAt(tree, ofIndex),
            ParserValueExprNodeSpanEndAt(tree, valueRoot),
            branchChildren)
        let branchSpanEnd =
            ParserValueExprNodeSpanEndAt(tree, branchRoot)
        for declarationRow in branchDeclarationStart..<tree.declarationCount:
            if arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationLexicalScopeRows,
                   declarationRow) != branchScopeRow ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationSpanEnds,
                   declarationRow) < branchSpanEnd:
                panic("parser case expression: branch declaration authority invalid")
            arenamod.ArenaArrayInt32Set(
                tree.arena,
                tree.declarationSpanEnds,
                declarationRow,
                branchSpanEnd)
        for patternOffset in 0..<patternRoots.len:
            ParserValueExprSetPatternRootOwner(
                tree,
                patternRoots[patternOffset],
                ParserPatternOwnerValueNode,
                branchRoot)
        ParserValueExprSetDeclarationLexicalScopeSpanBytes(
            tree,
            branchScopeRow,
            ParserValueExprTokenStartAt(tree, ofIndex),
            ParserValueExprNodeSpanEndAt(tree, branchRoot))
        children[childCount] = branchRoot
        childCount = childCount + 1
        branchCount = branchCount + 1
        tree.activeDeclarationLexicalScopeRow = previousScopeRow
    if !directValue && branchCount == 0:
        err = ParserValueExprAdmissionDiagnostic(
            tree,
            caseIndex,
            "PARSER_EMPTY_CASE_EXPRESSION_BRANCHES")
        return false
    if cursor < tokenLimit &&
       ParserValueExprTokenKindAt(tree, cursor) == ParserValueTokenElse:
        cursor = cursor + 1
        if cursor >= tokenLimit ||
           ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenColon:
            err = "parser value expr: case else separator missing"
            return false
        cursor = cursor + 1
        var elseRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            tokenLimit,
                                            0,
                                            elseRoot,
                                            err):
            return false
        children[childCount] = elseRoot
        childCount = childCount + 1
    setLen(children, childCount)
    let lastChild = children[children.len - 1]
    rootOut = ParserValueExprAppendNode(
        tree,
        sourceTextId,
        ParserValueExprCase,
        spanStart,
        ParserValueExprNodeSpanEndAt(tree, lastChild),
        children)
    ParserValueExprSetNodeOperator(
        tree,
        rootOut,
        ParserValueExprTokenStartAt(tree, caseIndex),
        ParserValueExprTokenEndAt(tree, caseIndex))
    return true

@borrows
fn ParserValueExprSourcePositionAt(source: str,
                                     spanStart: int32,
                                     startLineNumber: int32,
                                     startColumnNumber: int32,
                                     targetOffset: int32,
                                     lineNumberOut: var int32,
                                     columnNumberOut: var int32) =
    if spanStart < 0 || targetOffset < spanStart || targetOffset > source.len:
        panic("parser value expr: source position target out of bounds")
    lineNumberOut = startLineNumber
    columnNumberOut = startColumnNumber
    for sourceIndex in spanStart..<targetOffset:
        if source[sourceIndex] == '\n':
            lineNumberOut = lineNumberOut + 1
            columnNumberOut = 1
        else:
            columnNumberOut = columnNumberOut + 1

@borrows
fn ParserValueExprFmtHexNibble(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return Int32(ch) - Int32('0')
    if ch >= 'a' && ch <= 'f':
        return Int32(ch) - Int32('a') + 10
    if ch >= 'A' && ch <= 'F':
        return Int32(ch) - Int32('A') + 10
    return -1

# 外层 Fmt 串转义逐字节消解（镜像 bootstrap/cold_parser.c
# cold_fmt_decode_outer_byte）：支持 \n \r \t \0 \\ \" \{ \} 与两位
# 十六进制 \xNN，其余转义一律报错；`\{`/`\}` 不参与括号配对与闭洞。
@borrows
fn ParserValueExprFmtDecodeOuterByte(source: str,
                                      cursor: var int32,
                                      limit: int32,
                                      byteOut: var int32,
                                      fromEscapeOut: var bool,
                                      err: var str): bool =
    if cursor < 0 || cursor >= limit:
        panic("parser value expr: Fmt interpolation decoder cursor invalid")
    fromEscapeOut = false
    let current = Int32(source[cursor])
    cursor = cursor + 1
    if current != Int32('\\'):
        byteOut = current
        return true
    fromEscapeOut = true
    if cursor >= limit:
        err = "parser value expr: unterminated Fmt interpolation escape"
        return false
    let next = Int32(source[cursor])
    cursor = cursor + 1
    if next == Int32('n'):
        byteOut = 10
    elif next == Int32('r'):
        byteOut = 13
    elif next == Int32('t'):
        byteOut = 9
    elif next == Int32('0'):
        byteOut = 0
    elif next == Int32('\\') || next == Int32('"') ||
         next == Int32('{') || next == Int32('}'):
        byteOut = next
    elif next == Int32('x'):
        if cursor + 1 >= limit:
            err = "parser value expr: unterminated Fmt interpolation hex escape"
            return false
        let hi = ParserValueExprFmtHexNibble(source[cursor])
        let lo = ParserValueExprFmtHexNibble(source[cursor + 1])
        if hi < 0 || lo < 0:
            err = "parser value expr: invalid Fmt interpolation hex escape"
            return false
        cursor = cursor + 2
        byteOut = hi * 16 + lo
    else:
        err = "parser value expr: unsupported Fmt interpolation escape"
        return false
    return true

# Fmt 插值洞闭界扫描（C 冷层 cold_fmt_decode_interpolation 状态机的
# 无发射版）: 外层转义逐单元消解后判定 code 态裸 `}`; 嵌套串/字符/行注/
# 块注释/花括号深度全部按解码流语义配对, `\\"` 不开串、`\}` 不闭洞,
# `\xNN` 等异形转义与 C 权威零分歧 (lowering_plan.cheng 行内 if 插值
# `\\"1\\"/\\"0\\"` 实证族)。
@borrows
fn ParserValueExprFmtFindInterpolationEnd(source: str,
                                            expressionStart: int32,
                                            contentLimit: int32,
                                            closeOffsetOut: var int32,
                                            err: var str): bool =
    var rawCursor = expressionStart
    var braceDepth: int32
    # 0=code 1=string 2=char 3=line-comment 4=block-comment
    var state: int32
    var quotedEscape = false
    var codeSlash = false
    var blockStar = false
    while rawCursor < contentLimit:
        let unitRawStart = rawCursor
        var unitCode: int32
        var fromOuterEscape = false
        if !ParserValueExprFmtDecodeOuterByte(source,
                                               rawCursor,
                                               contentLimit,
                                               unitCode,
                                               fromOuterEscape,
                                               err):
            return false
        if state == 1 || state == 2:
            let quoteCode = if state == 1: Int32('"') else: Int32('\'')
            if quotedEscape:
                quotedEscape = false
            elif unitCode == Int32('\\'):
                quotedEscape = true
            elif unitCode == quoteCode:
                state = 0
            elif unitCode == 10 || unitCode == 13:
                err = "parser value expr: unterminated Fmt interpolation quoted literal"
                return false
        elif state == 3:
            if unitCode == 10:
                state = 0
        elif state == 4:
            if blockStar && unitCode == Int32('/'):
                state = 0
                blockStar = false
            else:
                blockStar = unitCode == Int32('*')
        else:
            if codeSlash:
                codeSlash = false
                if unitCode == Int32('/'):
                    state = 3
                elif unitCode == Int32('*'):
                    state = 4
                    blockStar = false
            if state == 0:
                if unitCode == Int32('"'):
                    state = 1
                    quotedEscape = false
                elif unitCode == Int32('\''):
                    state = 2
                    quotedEscape = false
                elif unitCode == Int32('#'):
                    state = 3
                elif unitCode == Int32('/'):
                    codeSlash = true
                elif unitCode == Int32('{'):
                    braceDepth = braceDepth + 1
                elif unitCode == Int32('}'):
                    if braceDepth == 0 && !fromOuterEscape:
                        closeOffsetOut = unitRawStart
                        return true
                    elif braceDepth > 0:
                        braceDepth = braceDepth - 1
    if state == 1 || state == 2 || quotedEscape:
        err = "parser value expr: unterminated Fmt interpolation quoted literal"
        return false
    if state == 4:
        err = "parser value expr: unterminated Fmt interpolation comment"
        return false
    err = "parser value expr: unterminated Fmt interpolation"
    return false

fn ParserValueExprParseFmtInterpolations(tree: var ParserValueExprTree,
                                           fmtTokenIndex: int32,
                                           rootsOut: var int32[],
                                           err: var str): bool =
    let sourceTextId = ParserValueExprTokenSourceIdAt(tree, fmtTokenIndex)
    let source = ParserValueExprSourceText(tree, sourceTextId)
    let tokenStart = ParserValueExprTokenStartAt(tree, fmtTokenIndex)
    let tokenEnd = ParserValueExprTokenEndAt(tree, fmtTokenIndex)
    # 洞解码流嵌套 `Fmt\"...\"` 的 token 形为 `Fmt\`+`"` 起: 与 `Fmt"`
    # 直引号形同族同判(转义对由洞单元机已配平), 两处起端形均受理。
    var fmtEscapedStart = false
    if tokenEnd - tokenStart >= 6 && source[tokenStart + 3] == '\\' &&
       source[tokenStart + 4] == '"':
        fmtEscapedStart = true
    if tokenEnd - tokenStart < 5 ||
       !ParserTextEqualsAt(source, tokenStart, "Fmt") ||
       (source[tokenStart + 3] != '"' && !fmtEscapedStart) ||
       source[tokenEnd - 1] != '"':
        err = "parser value expr: malformed Fmt literal token"
        return false
    # 转义起端形的内容区间为 `Fmt\"` 与 `\"` 之间(闭引号对末两位),
    # 直引号形为 `Fmt"` 与 `"` 之间——分别取游标与界限, 否则闭端 `\"`
    # 会被内容游走当未配对转义误拒。
    var contentLimit = tokenEnd - 1
    var cursor = tokenStart + 4
    if fmtEscapedStart:
        cursor = tokenStart + 5
        contentLimit = tokenEnd - 2
    # [ar2-scratch] AD1 batch 2a: interpolation roots ride the tree scratch
    # arena.  Each hole consumes at least three source bytes (`{` + `}` with
    # a non-empty scan between), so span/3 + 1 is a hard bound on the count.
    var rootsScratch: ParserScratchSeqInt32
    if !ParserScratchSeqReserve(tree, rootsScratch,
                                (tokenEnd - tokenStart) / 3 + 1):
        panic("parser scratch: interpolation roots reserve failed")
    while cursor < contentLimit:
        let ch = source[cursor]
        if ch == '\\':
            if cursor + 1 >= contentLimit:
                err = "parser value expr: unterminated Fmt escape"
                return false
            cursor = cursor + 2
            continue
        if ch == '{':
            if cursor + 1 < contentLimit && source[cursor + 1] == '{':
                cursor = cursor + 2
                continue
            let expressionStart = cursor + 1
            var expressionLimit: int32
            if !ParserValueExprFmtFindInterpolationEnd(source,
                                                         expressionStart,
                                                         contentLimit,
                                                         expressionLimit,
                                                         err):
                return false
            var expressionLine: int32
            var expressionColumn: int32
            ParserValueExprSourcePositionAt(
                source,
                tokenStart,
                ParserValueExprTokenLineAt(tree, fmtTokenIndex),
                ParserValueExprTokenColumnAt(tree, fmtTokenIndex),
                expressionStart,
                expressionLine,
                expressionColumn)
            var expressionTokenStart: int32
            var expressionTokenCount: int32
            if !ParserValueExprLexSpan(tree,
                                        source,
                                        sourceTextId,
                                        expressionStart,
                                        expressionLimit,
                                        expressionLine,
                                        expressionColumn,
                                        fmtTokenIndex,
                                        true,
                                        expressionTokenStart,
                                        expressionTokenCount,
                                        err):
                return false
            if expressionTokenCount <= 0:
                err = "parser value expr: empty Fmt interpolation"
                return false
            var expressionCursor = expressionTokenStart
            var expressionRoot: int32
            if !ParserValueExprParseExpression(
                    tree,
                    expressionCursor,
                    expressionTokenStart + expressionTokenCount,
                    0,
                    expressionRoot,
                    err):
                return false
            if expressionCursor != expressionTokenStart + expressionTokenCount:
                err = Fmt"parser value expr: Fmt interpolation trailing token offset={ParserValueExprTokenStartAt(tree, expressionCursor)}"
                return false
            ParserScratchSeqAdd(tree, rootsScratch, expressionRoot)
            cursor = expressionLimit + 1
            continue
        if ch == '}':
            if cursor + 1 < contentLimit && source[cursor + 1] == '}':
                cursor = cursor + 2
                continue
            err = Fmt"parser value expr: unmatched Fmt close brace at offset {cursor}"
            return false
        cursor = cursor + 1
    ParserScratchCopyOutToHeap(tree, rootsScratch, rootsOut)
    return true

fn ParserValueExprParsePrimary(tree: var ParserValueExprTree,
                                 cursor: var int32,
                                 tokenLimit: int32,
                                 rootOut: var int32,
                                 err: var str): bool =
    rootOut = -1
    if cursor < 0 || cursor >= tokenLimit:
        err = "parser value expr: primary missing"
        return false
    let tokenIndex = cursor
    let tokenKind = ParserValueExprTokenKindAt(tree, tokenIndex)
    let sourceTextId = ParserValueExprTokenSourceIdAt(tree, tokenIndex)
    let spanStart = ParserValueExprTokenStartAt(tree, tokenIndex)
    let spanEnd = ParserValueExprTokenEndAt(tree, tokenIndex)
    var conversionOpen: int32 = -1
    var conversionClose: int32 = -1
    var conversionPrefixUnambiguous =
        tokenKind == ParserValueTokenVar ||
        tokenKind == ParserValueTokenRef ||
        tokenKind == ParserValueTokenSet ||
        tokenKind == ParserValueTokenTuple ||
        tokenKind == ParserValueTokenEnum
    var conversionParenDepth: int32
    var conversionBracketDepth: int32
    var conversionScan = tokenIndex
    while conversionScan < tokenLimit:
        let conversionKind = ParserValueExprTokenKindAt(tree, conversionScan)
        # Before the candidate paren, only a contiguous type prefix may
        # appear (identifiers, dot, brackets, star, question).  Anything else
        # (colon, comma, keyword, literal, operators) ends conversion
        # detection and the token parses as a normal primary.  Without this
        # guard the scan runs past the expression end: `if true:` followed by
        # a suite containing `var buf: T[]` and `foo(2, 4)` was misread as a
        # `T[]` conversion of the later call.
        if conversionOpen < 0 && conversionScan > tokenIndex &&
           conversionKind != ParserValueTokenIdentifier &&
           conversionKind != ParserValueTokenDot &&
           conversionKind != ParserValueTokenLeftBracket &&
           conversionKind != ParserValueTokenRightBracket &&
           conversionKind != ParserValueTokenStar &&
           conversionKind != ParserValueTokenQuestion &&
           conversionKind != ParserValueTokenLeftParen:
            break
        if conversionOpen >= 0 && conversionScan > conversionClose &&
           conversionParenDepth == 0 && conversionBracketDepth == 0 &&
           conversionKind != ParserValueTokenLeftParen &&
           conversionKind != ParserValueTokenLeftBracket &&
           conversionKind != ParserValueTokenDot &&
           conversionKind != ParserValueTokenQuestion &&
           conversionKind != ParserValueTokenStar:
            break
        if conversionKind == ParserValueTokenLeftBracket:
            if conversionScan + 1 < tokenLimit &&
               ParserValueExprTokenKindAt(tree, conversionScan + 1) ==
                   ParserValueTokenRightBracket:
                conversionPrefixUnambiguous = true
            conversionBracketDepth = conversionBracketDepth + 1
        elif conversionKind == ParserValueTokenRightBracket:
            conversionBracketDepth = conversionBracketDepth - 1
            if conversionBracketDepth < 0:
                break
        elif conversionKind == ParserValueTokenLeftParen:
            if conversionParenDepth == 0 && conversionBracketDepth == 0 &&
               conversionScan > tokenIndex &&
               ParserValueExprTokenTight(tree,
                                           conversionScan - 1,
                                           conversionScan) &&
               conversionPrefixUnambiguous:
                let candidateClose = ParserValueExprFindMatchingToken(
                    tree,
                    conversionScan,
                    tokenLimit,
                    ParserValueTokenLeftParen,
                    ParserValueTokenRightParen)
                if candidateClose > conversionScan:
                    # The whole prefix must be space-contiguous: `is64 ?`
                    # followed by `int32(1)` is a ternary, not an
                    # optional-type conversion — the `?` after a space is
                    # the ternary/try operator, and the `(` after a later
                    # identifier must not close a fake conversion prefix.
                    # A valid conversion prefix is tight end to end, such as
                    # `T?(x)` or `str[](x)`. A tight raw-pointer prefix is
                    # still recognized here only so admission can reject its
                    # exact `*` token before any conversion node is emitted.
                    var prefixTight = true
                    var prefixScan = tokenIndex + 1
                    while prefixScan <= conversionScan:
                        if !ParserValueExprTokenTight(tree,
                                                      prefixScan - 1,
                                                      prefixScan):
                            prefixTight = false
                            break
                        prefixScan = prefixScan + 1
                    if prefixTight:
                        conversionOpen = conversionScan
                        conversionClose = candidateClose
            conversionParenDepth = conversionParenDepth + 1
        elif conversionKind == ParserValueTokenRightParen:
            conversionParenDepth = conversionParenDepth - 1
            if conversionParenDepth < 0:
                break
        elif conversionParenDepth == 0 && conversionBracketDepth == 0 &&
             (conversionKind == ParserValueTokenStar ||
              conversionKind == ParserValueTokenQuestion):
            conversionPrefixUnambiguous = true
        conversionScan = conversionScan + 1
    if conversionOpen > tokenIndex && conversionClose > conversionOpen:
        for prefixToken in tokenIndex..<conversionOpen:
            if ParserValueExprTokenKindAt(tree, prefixToken) ==
                   ParserValueTokenStar:
                err = ParserValueExprAdmissionDiagnostic(
                    tree,
                    prefixToken,
                    "ZRPC_PUBLIC_RAW_POINTER_TYPE_FORBIDDEN")
                return false
        cursor = conversionOpen + 1
        if cursor == conversionClose:
            err = "parser value expr: type conversion operand missing"
            return false
        if cursor + 1 < conversionClose &&
           ParserValueExprTokenKindAt(tree, cursor) ==
               ParserValueTokenIdentifier &&
           (ParserValueExprTokenKindAt(tree, cursor + 1) ==
                ParserValueTokenAssign ||
            ParserValueExprTokenKindAt(tree, cursor + 1) ==
                ParserValueTokenColon):
            err = "parser value expr: type conversion operand cannot be named"
            return false
        var operandRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            conversionClose,
                                            0,
                                            operandRoot,
                                            err):
            return false
        if cursor != conversionClose:
            err = "parser value expr: type conversion requires exactly one operand"
            return false
        var conversionChildren: int32[]
        add(conversionChildren, operandRoot)
        rootOut = ParserValueExprAppendNode(
            tree,
            sourceTextId,
            ParserValueExprTypeConversion,
            spanStart,
            ParserValueExprTokenEndAt(tree, conversionClose),
            conversionChildren)
        ParserValueExprSetNodeAtom(
            tree,
            rootOut,
            spanStart,
            ParserValueExprTokenStartAt(tree, conversionOpen))
        cursor = conversionClose + 1
        return true
    if tokenKind == ParserValueTokenIf:
        return ParserValueExprParseIfLike(tree,
                                           cursor,
                                           tokenLimit,
                                           ParserValueExprIf,
                                           rootOut,
                                           err)
    if tokenKind == ParserValueTokenWhen:
        return ParserValueExprParseIfLike(tree,
                                           cursor,
                                           tokenLimit,
                                           ParserValueExprWhen,
                                           rootOut,
                                           err)
    if tokenKind == ParserValueTokenCase:
        return ParserValueExprParseCase(tree,
                                         cursor,
                                         tokenLimit,
                                         rootOut,
                                         err)
    if tokenKind == ParserValueTokenFor:
        return ParserValueExprParsePrefixComprehension(tree,
                                                        cursor,
                                                        tokenLimit,
                                                        rootOut,
                                                        err)
    if tokenKind == ParserValueTokenFn ||
       tokenKind == ParserValueTokenIterator:
        return ParserValueExprParseFunctionLiteral(tree,
                                                    cursor,
                                                    tokenLimit,
                                                    rootOut,
                                                    err)
    if tokenKind == ParserValueTokenFmtString:
        var interpolationRoots: int32[]
        if !ParserValueExprParseFmtInterpolations(tree,
                                                   tokenIndex,
                                                   interpolationRoots,
                                                   err):
            return false
        rootOut = ParserValueExprAppendNode(tree,
                                             sourceTextId,
                                             ParserValueExprFmtLiteral,
                                             spanStart,
                                             spanEnd,
                                             interpolationRoots)
        ParserValueExprSetNodeAtom(tree, rootOut, spanStart, spanEnd)
        cursor = cursor + 1
        return true
    if tokenKind == ParserValueTokenStar:
        err = ParserValueExprAdmissionDiagnostic(
            tree,
            tokenIndex,
            "ZRPC_PUBLIC_DEREFERENCE_FORBIDDEN")
        return false
    if tokenKind == ParserValueTokenAmp:
        # `&place` 取址（如 atomicLoadI32(&a.value)）：operand 必须是可取址
        # place（标识符或字段路径），下游按 root 槽 + 总偏移物化地址
        # （typed_expr structural unary 只承接 FieldGet/LocalRef/ParamRef/
        # FuncRef）。rvalue 形（&f(x)、&字面量等无稳定地址）继续由本闸拒。
        cursor = cursor + 1
        var addrOperandRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            tokenLimit,
                                            100,
                                            addrOperandRoot,
                                            err):
            return false
        let addrOperandKind = ParserValueExprNodeKindAt(tree, addrOperandRoot)
        if addrOperandKind != ParserValueExprIdentifier &&
           addrOperandKind != ParserValueExprField:
            err = ParserValueExprAdmissionDiagnostic(
                tree,
                tokenIndex,
                "ZRPC_PUBLIC_ADDRESS_OF_FORBIDDEN")
            return false
        var addrChildren: int32[]
        add(addrChildren, addrOperandRoot)
        rootOut = ParserValueExprAppendNode(
            tree,
            sourceTextId,
            ParserValueExprUnary,
            spanStart,
            ParserValueExprNodeSpanEndAt(tree, addrOperandRoot),
            addrChildren)
        ParserValueExprSetNodeOperator(tree,
                                        rootOut,
                                        spanStart,
                                        spanEnd)
        return true
    if ParserValueExprTokenIsPrefix(tokenKind):
        cursor = cursor + 1
        var operandRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            tokenLimit,
                                            100,
                                            operandRoot,
                                            err):
            return false
        var children: int32[]
        add(children, operandRoot)
        rootOut = ParserValueExprAppendNode(
            tree,
            sourceTextId,
            ParserValueExprUnary,
            spanStart,
            ParserValueExprNodeSpanEndAt(tree, operandRoot),
            children)
        ParserValueExprSetNodeOperator(tree,
                                        rootOut,
                                        spanStart,
                                        spanEnd)
        return true
    if ParserValueExprTokenCanName(tokenKind) ||
       tokenKind == ParserValueTokenTrue ||
       tokenKind == ParserValueTokenFalse ||
       tokenKind == ParserValueTokenNil ||
       tokenKind == ParserValueTokenInteger ||
       tokenKind == ParserValueTokenFloat ||
       tokenKind == ParserValueTokenString ||
       tokenKind == ParserValueTokenChar:
        var nodeKind = ParserValueExprIdentifier
        if tokenKind == ParserValueTokenTrue || tokenKind == ParserValueTokenFalse:
            nodeKind = ParserValueExprBoolLiteral
        elif tokenKind == ParserValueTokenNil:
            nodeKind = ParserValueExprNilLiteral
        elif tokenKind == ParserValueTokenInteger:
            nodeKind = ParserValueExprIntegerLiteral
        elif tokenKind == ParserValueTokenFloat:
            nodeKind = ParserValueExprFloatLiteral
        elif tokenKind == ParserValueTokenString:
            nodeKind = ParserValueExprStringLiteral
        elif tokenKind == ParserValueTokenChar:
            nodeKind = ParserValueExprCharLiteral
        var noChildren: int32[]
        rootOut = ParserValueExprAppendNode(tree,
                                             sourceTextId,
                                             nodeKind,
                                             spanStart,
                                             spanEnd,
                                             noChildren)
        ParserValueExprSetNodeAtom(tree, rootOut, spanStart, spanEnd)
        if nodeKind == ParserValueExprIdentifier:
            ParserValueExprSetNodeOwnerName(tree,
                                             rootOut,
                                             -1,
                                             -1,
                                             spanStart,
                                             spanEnd)
            if !ParserValueExprResolveIdentifierBinding(
                   tree, rootOut, tokenIndex, err):
                return false
        cursor = cursor + 1
        return true
    if tokenKind == ParserValueTokenLeftParen:
        let closeIndex = ParserValueExprFindMatchingToken(
            tree,
            tokenIndex,
            tokenLimit,
            ParserValueTokenLeftParen,
            ParserValueTokenRightParen)
        if closeIndex < 0:
            err = "parser value expr: parenthesized expression unterminated"
            return false
        cursor = cursor + 1
        if cursor == closeIndex:
            err = "parser value expr: empty tuple literal is not a value"
            return false
        var elements: int32[]
        var isTupleLiteral = false
        var firstNameStart: int32 = -1
        var firstNameEnd: int32 = -1
        if cursor + 1 < closeIndex &&
           ParserValueExprTokenCanName(
               ParserValueExprTokenKindAt(tree, cursor)) &&
           ParserValueExprTokenKindAt(tree, cursor + 1) ==
               ParserValueTokenColon:
            firstNameStart = ParserValueExprTokenStartAt(tree, cursor)
            firstNameEnd = ParserValueExprTokenEndAt(tree, cursor)
            cursor = cursor + 2
            isTupleLiteral = true
        var firstRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            closeIndex,
                                            0,
                                            firstRoot,
                                            err):
            return false
        if firstNameStart >= 0:
            ParserValueExprSetNodeArgumentName(tree,
                                                firstRoot,
                                                firstNameStart,
                                                firstNameEnd)
        add(elements, firstRoot)
        while cursor < closeIndex:
            if ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenComma:
                err = "parser value expr: tuple delimiter expected"
                return false
            isTupleLiteral = true
            cursor = cursor + 1
            if cursor == closeIndex:
                break
            var elementNameStart: int32 = -1
            var elementNameEnd: int32 = -1
            if cursor + 1 < closeIndex &&
               ParserValueExprTokenCanName(
                   ParserValueExprTokenKindAt(tree, cursor)) &&
               ParserValueExprTokenKindAt(tree, cursor + 1) ==
                   ParserValueTokenColon:
                elementNameStart = ParserValueExprTokenStartAt(tree, cursor)
                elementNameEnd = ParserValueExprTokenEndAt(tree, cursor)
                cursor = cursor + 2
            var elementRoot: int32
            if !ParserValueExprParseExpression(tree,
                                                cursor,
                                                closeIndex,
                                                0,
                                                elementRoot,
                                                err):
                return false
            if elementNameStart >= 0:
                ParserValueExprSetNodeArgumentName(tree,
                                                    elementRoot,
                                                    elementNameStart,
                                                    elementNameEnd)
            add(elements, elementRoot)
        cursor = closeIndex + 1
        if !isTupleLiteral:
            var groupedChildren: int32[]
            add(groupedChildren, firstRoot)
            rootOut = ParserValueExprAppendNode(
                tree,
                sourceTextId,
                ParserValueExprGrouped,
                spanStart,
                ParserValueExprTokenEndAt(tree, closeIndex),
                groupedChildren)
            return true
        rootOut = ParserValueExprAppendNode(
            tree,
            sourceTextId,
            ParserValueExprTupleLiteral,
            spanStart,
            ParserValueExprTokenEndAt(tree, closeIndex),
            elements)
        return true
    if tokenKind == ParserValueTokenLeftBracket ||
       tokenKind == ParserValueTokenLeftBrace:
        let closeKind = if tokenKind == ParserValueTokenLeftBracket: ParserValueTokenRightBracket else: ParserValueTokenRightBrace
        let closeIndex = ParserValueExprFindMatchingToken(tree,
                                                            tokenIndex,
                                                            tokenLimit,
                                                            tokenKind,
                                                            closeKind)
        if closeIndex < 0:
            err = "parser value expr: literal delimiter unterminated"
            return false
        cursor = cursor + 1
        var items: int32[]
        # [d5-presize] items <= remaining token span (every add consumes at
        # least one token).  Presize once, fill by index, and restore the
        # true count before the literal node consumes the list.
        setLen(items, closeIndex - tokenIndex)
        var itemCount: int32
        var listComprehension = false
        var comprehensionPreviousScope: int32 = -1
        var comprehensionScopeRow: int32 = -1
        var patternStart: int32 = -1
        var patternEnd: int32 = -1
        if cursor < closeIndex:
            let comprehensionFor =
                tokenKind == ParserValueTokenLeftBracket ?
                    ParserValueExprFindTopLevelKind(
                        tree,
                        cursor,
                        closeIndex,
                        ParserValueTokenFor) :
                    -1
            if comprehensionFor > cursor:
                listComprehension = true
                let bodyStartToken = cursor
                let bodyLimitToken = comprehensionFor
                let patternStartToken = comprehensionFor + 1
                let inIndex = ParserValueExprFindTopLevelKind(
                    tree,
                    patternStartToken,
                    closeIndex,
                    ParserValueTokenIn)
                if inIndex <= patternStartToken || inIndex >= closeIndex:
                    err = "parser value expr: list comprehension pattern missing"
                    return false
                comprehensionPreviousScope =
                    tree.activeDeclarationLexicalScopeRow
                comprehensionScopeRow =
                    ParserValueExprAppendDeclarationLexicalScope(
                        tree,
                        ParserDeclarationLexicalScopeBlock,
                        comprehensionPreviousScope,
                        tree.activeFunctionDeclarationRow)
                tree.activeDeclarationLexicalScopeRow =
                    comprehensionScopeRow
                ParserValueExprSetDeclarationLexicalScopeSpanTokens(
                    tree,
                    comprehensionScopeRow,
                    tokenIndex,
                    closeIndex + 1)
                let listPatternRowStart = tree.patternCount
                let patternRegionRow = tree.regionCount
                ParserValueExprAppendRegion(
                    tree,
                    ParserValueExprRegionPattern,
                    ParserValueExprTokenSourceIdAt(tree, patternStartToken),
                    ParserValueExprTokenStartAt(tree, patternStartToken),
                    ParserValueExprTokenEndAt(tree, inIndex - 1),
                    patternStartToken)
                if !ParserValueExprParsePatternListRange(
                       tree,
                       patternStartToken,
                       inIndex,
                       tokenIndex,
                       closeIndex + 1,
                       false,
                       ParserPatternParseBindingDeclaration,
                       ParserPatternOwnerRegion,
                       patternRegionRow,
                       err):
                    return false
                patternStart = ParserValueExprTokenStartAt(tree,
                                                             patternStartToken)
                patternEnd = ParserValueExprTokenEndAt(tree, inIndex - 1)
                cursor = inIndex + 1
                tree.activeDeclarationLexicalScopeRow =
                    comprehensionPreviousScope
                var iteratorRoot: int32
                if !ParserValueExprParseExpression(tree,
                                                    cursor,
                                                    closeIndex,
                                                    0,
                                                    iteratorRoot,
                                                    err):
                    return false
                tree.activeDeclarationLexicalScopeRow =
                    comprehensionScopeRow
                let iteratorAnchorToken = cursor - 1
                if !ParserValueExprRegisterPatternBindings(
                       tree,
                       listPatternRowStart,
                       ParserLexicalBindingIntroductionPatternIterator,
                       -1,
                       iteratorRoot,
                       iteratorAnchorToken,
                       err):
                    return false
                var bodyCursor = bodyStartToken
                var bodyRoot: int32
                if !ParserValueExprParseExpression(
                       tree,
                       bodyCursor,
                       bodyLimitToken,
                       0,
                       bodyRoot,
                       err) ||
                   bodyCursor != bodyLimitToken:
                    if err == "":
                        err = "parser value expr: list comprehension body trailing token"
                    return false
                items[itemCount] = bodyRoot
                itemCount = itemCount + 1
                items[itemCount] = iteratorRoot
                itemCount = itemCount + 1
                if cursor < closeIndex &&
                   ParserValueExprTokenKindAt(tree, cursor) == ParserValueTokenIf:
                    cursor = cursor + 1
                    var filterRoot: int32
                    if !ParserValueExprParseExpression(tree,
                                                        cursor,
                                                        closeIndex,
                                                        0,
                                                        filterRoot,
                                                        err):
                        return false
                    items[itemCount] = filterRoot
                    itemCount = itemCount + 1
            else:
                var firstRoot: int32
                if !ParserValueExprParseExpression(tree,
                                                    cursor,
                                                    closeIndex,
                                                    0,
                                                    firstRoot,
                                                    err):
                    return false
                items[itemCount] = firstRoot
                itemCount = itemCount + 1
                while cursor < closeIndex:
                    if ParserValueExprTokenKindAt(tree, cursor) !=
                       ParserValueTokenComma:
                        err = "parser value expr: literal item delimiter expected"
                        return false
                    cursor = cursor + 1
                    if cursor == closeIndex:
                        break
                    var itemRoot: int32
                    if !ParserValueExprParseExpression(tree,
                                                        cursor,
                                                        closeIndex,
                                                        0,
                                                        itemRoot,
                                                        err):
                        return false
                    items[itemCount] = itemRoot
                    itemCount = itemCount + 1
        if cursor != closeIndex:
            err = "parser value expr: literal trailing tokens"
            return false
        cursor = closeIndex + 1
        setLen(items, itemCount)
        var nodeKind = ParserValueExprListLiteral
        if tokenKind == ParserValueTokenLeftBrace:
            nodeKind = ParserValueExprBraceLiteral
        if listComprehension:
            nodeKind = ParserValueExprComprehension
        rootOut = ParserValueExprAppendNode(
            tree,
            sourceTextId,
            nodeKind,
            spanStart,
            ParserValueExprTokenEndAt(tree, closeIndex),
            items)
        if patternStart >= 0:
            ParserValueExprSetNodeAtom(tree,
                                        rootOut,
                                        patternStart,
                                        patternEnd)
        if listComprehension:
            tree.activeDeclarationLexicalScopeRow =
                comprehensionPreviousScope
        return true
    err = Fmt"parser value expr: unsupported primary token={Int32(tokenKind)} offset={spanStart}"
    return false

@borrows
fn ParserValueExprGenericSuffix(tree: var ParserValueExprTree,
                                  openIndex: int32,
                                  tokenLimit: int32,
                                  closeOut: var int32,
                                  genericTokenStarts: var int32[],
                                  genericTokenEnds: var int32[]): bool =
    closeOut = -1
    genericTokenStarts = []
    genericTokenEnds = []
    if ParserValueExprTokenKindAt(tree, openIndex) !=
       ParserValueTokenLeftBracket:
        return false
    let closeIndex = ParserValueExprFindMatchingToken(
        tree,
        openIndex,
        tokenLimit,
        ParserValueTokenLeftBracket,
        ParserValueTokenRightBracket)
    if closeIndex <= openIndex + 1 || closeIndex + 1 >= tokenLimit:
        return false
    if ParserValueExprTokenKindAt(tree, closeIndex + 1) !=
       ParserValueTokenLeftParen ||
       !ParserValueExprTokenTight(tree, closeIndex, closeIndex + 1):
        return false
    # [ar2-scratch] AD1 batch 2a: generic parameter spans ride the tree
    # scratch arena.  Segments are delimited by top-level commas and each
    # segment consumes at least one token, so the bracket span bounds the
    # count; CopyOut at the success exit keeps the heap-seq out-param
    # contract unchanged.
    var startsScratch: ParserScratchSeqInt32
    var endsScratch: ParserScratchSeqInt32
    if !ParserScratchSeqReserve(tree, startsScratch, closeIndex - openIndex):
        panic("parser scratch: generic starts reserve failed")
    if !ParserScratchSeqReserve(tree, endsScratch, closeIndex - openIndex):
        panic("parser scratch: generic ends reserve failed")
    var startToken = openIndex + 1
    var bracketDepth: int32
    var parenDepth: int32
    var cursor = startToken
    while cursor <= closeIndex:
        let atEnd = cursor == closeIndex
        var split = atEnd
        if !atEnd:
            let kind = ParserValueExprTokenKindAt(tree, cursor)
            if kind == ParserValueTokenLeftBracket:
                bracketDepth = bracketDepth + 1
            elif kind == ParserValueTokenRightBracket:
                bracketDepth = bracketDepth - 1
            elif kind == ParserValueTokenLeftParen:
                parenDepth = parenDepth + 1
            elif kind == ParserValueTokenRightParen:
                parenDepth = parenDepth - 1
            elif kind == ParserValueTokenComma &&
                 bracketDepth == 0 && parenDepth == 0:
                split = true
        if split:
            if cursor <= startToken:
                return false
            ParserScratchSeqAdd(tree, startsScratch, startToken)
            ParserScratchSeqAdd(tree, endsScratch, cursor)
            startToken = cursor + 1
        cursor = cursor + 1
    if bracketDepth != 0 || parenDepth != 0 ||
       ParserScratchSeqLen(tree, startsScratch) == 0:
        return false
    closeOut = closeIndex
    ParserScratchCopyOutToHeap(tree, startsScratch, genericTokenStarts)
    ParserScratchCopyOutToHeap(tree, endsScratch, genericTokenEnds)
    return true

fn ParserValueExprSetCallStaticName(tree: var ParserValueExprTree,
                                      callNode: int32,
                                      calleeNode: int32) =
    var staticCalleeNode = calleeNode
    var calleeKind =
        ParserValueExprNodeKindAt(tree, staticCalleeNode)
    while calleeKind == ParserValueExprGrouped:
        if ParserValueExprNodeChildCount(tree, staticCalleeNode) != 1:
            panic("parser value expr: grouped callee arity invalid")
        staticCalleeNode =
            ParserValueExprNodeFirstChild(tree, staticCalleeNode)
        if staticCalleeNode < 0:
            panic("parser value expr: grouped callee child missing")
        calleeKind =
            ParserValueExprNodeKindAt(tree, staticCalleeNode)
    if calleeKind == ParserValueExprIdentifier:
        let nameStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.nameStarts, staticCalleeNode)
        let nameEnd = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.nameEnds, staticCalleeNode)
        ParserValueExprSetNodeOwnerName(tree,
                                         callNode,
                                         -1,
                                         -1,
                                         nameStart,
                                         nameEnd)
        return
    if calleeKind == ParserValueExprField:
        let ownerNode =
            ParserValueExprNodeFirstChild(tree, staticCalleeNode)
        if ownerNode < 0:
            panic("parser value expr: field callee owner missing")
        let nameStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.atomStarts, staticCalleeNode)
        let nameEnd = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.atomEnds, staticCalleeNode)
        ParserValueExprSetNodeOwnerName(
            tree,
            callNode,
            ParserValueExprNodeSpanStartAt(tree, ownerNode),
            ParserValueExprNodeSpanEndAt(tree, ownerNode),
            nameStart,
            nameEnd)

fn ParserValueExprParseCallSuffix(tree: var ParserValueExprTree,
                                    cursor: var int32,
                                    tokenLimit: int32,
                                    calleeRoot: int32,
                                    genericTokenStarts: int32[],
                                    genericTokenEnds: int32[],
                                    rootOut: var int32,
                                    err: var str): bool =
    let openIndex = cursor
    if openIndex >= tokenLimit ||
       ParserValueExprTokenKindAt(tree, openIndex) !=
       ParserValueTokenLeftParen:
        err = "parser value expr: call suffix missing"
        return false
    let closeIndex = ParserValueExprFindMatchingToken(
        tree,
        openIndex,
        tokenLimit,
        ParserValueTokenLeftParen,
        ParserValueTokenRightParen)
    if closeIndex < 0:
        err = "parser value expr: call suffix unterminated"
        return false
    cursor = openIndex + 1
    # [ar2-scratch] AD1 batch 2a: argument roots ride the tree scratch
    # arena.  Capacity is exact (D5 handoff note): each argument after the
    # first consumes one top-level comma, so topLevelCommas + 1 bounds the
    # root count on every path that reaches the copy-out.
    var topLevelCommas: int32
    var scanCursor = openIndex + 1
    var scanParenDepth: int32
    var scanBracketDepth: int32
    var scanBraceDepth: int32
    while scanCursor < closeIndex:
        let scanKind = ParserValueExprTokenKindAt(tree, scanCursor)
        if scanKind == ParserValueTokenLeftParen:
            scanParenDepth = scanParenDepth + 1
        elif scanKind == ParserValueTokenRightParen:
            scanParenDepth = scanParenDepth - 1
        elif scanKind == ParserValueTokenLeftBracket:
            scanBracketDepth = scanBracketDepth + 1
        elif scanKind == ParserValueTokenRightBracket:
            scanBracketDepth = scanBracketDepth - 1
        elif scanKind == ParserValueTokenLeftBrace:
            scanBraceDepth = scanBraceDepth + 1
        elif scanKind == ParserValueTokenRightBrace:
            scanBraceDepth = scanBraceDepth - 1
        elif scanKind == ParserValueTokenComma &&
             scanParenDepth == 0 && scanBracketDepth == 0 &&
             scanBraceDepth == 0:
            topLevelCommas = topLevelCommas + 1
        scanCursor = scanCursor + 1
    var argRootsScratch: ParserScratchSeqInt32
    if !ParserScratchSeqReserve(tree, argRootsScratch, topLevelCommas + 1):
        panic("parser scratch: argument roots reserve failed")
    while cursor < closeIndex:
        var nameStart: int32 = -1
        var nameEnd: int32 = -1
        if cursor + 1 < closeIndex &&
           ParserValueExprTokenCanName(
               ParserValueExprTokenKindAt(tree, cursor)) &&
           (ParserValueExprTokenKindAt(tree, cursor + 1) ==
                ParserValueTokenAssign ||
            ParserValueExprTokenKindAt(tree, cursor + 1) ==
                ParserValueTokenColon):
            nameStart = ParserValueExprTokenStartAt(tree, cursor)
            nameEnd = ParserValueExprTokenEndAt(tree, cursor)
            cursor = cursor + 2
        var argRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            closeIndex,
                                            0,
                                            argRoot,
                                            err):
            return false
        if nameStart >= 0:
            ParserValueExprSetNodeArgumentName(tree,
                                                argRoot,
                                                nameStart,
                                                nameEnd)
        ParserScratchSeqAdd(tree, argRootsScratch, argRoot)
        if cursor == closeIndex:
            break
        if ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenComma:
            err = "parser value expr: call argument delimiter expected"
            return false
        cursor = cursor + 1
        if cursor == closeIndex:
            break
    cursor = closeIndex + 1
    var argRoots: int32[]
    ParserScratchCopyOutToHeap(tree, argRootsScratch, argRoots)
    # [call-suffix-presize] `children` is exactly [calleeRoot] + argRoots, so
    # its length is known before the loop.  Growing it with `add` inside the
    # loop is the shape that leaks one buffer per call (amplified repro
    # src/tests/_chk_repro_loopseq_fix_probe.cheng: pre-sized + indexed = 0
    # blocks over 1000 calls, `add` in loop = >=15).  Fill by index instead;
    # the resulting list is identical.
    var children: int32[]
    setLen(children, argRoots.len + 1)
    children[0] = calleeRoot
    for argIndex in 0..<argRoots.len:
        children[argIndex + 1] = argRoots[argIndex]
    let sourceTextId = ParserValueExprNodeSourceIdAt(tree, calleeRoot)
    rootOut = ParserValueExprAppendNode(
        tree,
        sourceTextId,
        ParserValueExprCall,
        ParserValueExprNodeSpanStartAt(tree, calleeRoot),
        ParserValueExprTokenEndAt(tree, closeIndex),
        children)
    ParserValueExprSetNodeAtom(
        tree,
        rootOut,
        ParserValueExprNodeSpanStartAt(tree, calleeRoot),
        ParserValueExprNodeSpanEndAt(tree, calleeRoot))
    ParserValueExprSetCallStaticName(tree, rootOut, calleeRoot)
    ParserValueExprSetNodeCallArgsSpan(
        tree,
        rootOut,
        ParserValueExprTokenEndAt(tree, openIndex),
        ParserValueExprTokenStartAt(tree, closeIndex))
    let genericStart = tree.genericCount
    for genericIndex in 0..<genericTokenStarts.len:
        let firstToken = genericTokenStarts[genericIndex]
        let stopToken = genericTokenEnds[genericIndex]
        ParserValueExprAppendGenericSpan(
            tree,
            ParserValueExprTokenStartAt(tree, firstToken),
            ParserValueExprTokenEndAt(tree, stopToken - 1))
    ParserValueExprSetNodeGenericRange(tree,
                                        rootOut,
                                        genericStart,
                                        genericTokenStarts.len)
    ParserValueExprAppendArgumentRoots(tree, rootOut, argRoots)
    return true

fn ParserValueExprParsePostfix(tree: var ParserValueExprTree,
                                 cursor: var int32,
                                 tokenLimit: int32,
                                 rootIn: int32,
                                 rootOut: var int32,
                                 err: var str): bool =
    rootOut = rootIn
    while cursor < tokenLimit:
        let kind = ParserValueExprTokenKindAt(tree, cursor)
        if kind == ParserValueTokenArrow:
            err = ParserValueExprAdmissionDiagnostic(
                tree,
                cursor,
                "ZRPC_PUBLIC_POINTER_MEMBER_FORBIDDEN")
            return false
        if kind == ParserValueTokenDot:
            let operatorIndex = cursor
            if cursor + 1 >= tokenLimit ||
               !ParserValueExprTokenCanName(
                   ParserValueExprTokenKindAt(tree, cursor + 1)):
                err = "parser value expr: field name missing"
                return false
            let nameIndex = cursor + 1
            let fieldRoot = ParserValueExprAppendNode1(
                tree,
                ParserValueExprNodeSourceIdAt(tree, rootOut),
                ParserValueExprField,
                ParserValueExprNodeSpanStartAt(tree, rootOut),
                ParserValueExprTokenEndAt(tree, nameIndex),
                rootOut)
            ParserValueExprSetNodeAtom(
                tree,
                fieldRoot,
                ParserValueExprTokenStartAt(tree, nameIndex),
                ParserValueExprTokenEndAt(tree, nameIndex))
            ParserValueExprSetNodeOwnerName(
                tree,
                fieldRoot,
                ParserValueExprNodeSpanStartAt(tree, rootOut),
                ParserValueExprNodeSpanEndAt(tree, rootOut),
                ParserValueExprTokenStartAt(tree, nameIndex),
                ParserValueExprTokenEndAt(tree, nameIndex))
            ParserValueExprSetNodeOperator(
                tree,
                fieldRoot,
                ParserValueExprTokenStartAt(tree, operatorIndex),
                ParserValueExprTokenEndAt(tree, operatorIndex))
            rootOut = fieldRoot
            cursor = cursor + 2
            continue
        if kind == ParserValueTokenLeftParen &&
           ParserValueExprNodeSpanEndAt(tree, rootOut) ==
               ParserValueExprTokenStartAt(tree, cursor):
            var noGenericStarts: int32[]
            var noGenericEnds: int32[]
            var callRoot: int32
            if !ParserValueExprParseCallSuffix(tree,
                                                cursor,
                                                tokenLimit,
                                                rootOut,
                                                noGenericStarts,
                                                noGenericEnds,
                                                callRoot,
                                                err):
                return false
            rootOut = callRoot
            continue
        if kind == ParserValueTokenLeftBracket &&
           ParserValueExprNodeSpanEndAt(tree, rootOut) ==
               ParserValueExprTokenStartAt(tree, cursor):
            var genericClose: int32
            var genericStarts: int32[]
            var genericEnds: int32[]
            if ParserValueExprGenericSuffix(tree,
                                             cursor,
                                             tokenLimit,
                                             genericClose,
                                             genericStarts,
                                             genericEnds):
                cursor = genericClose + 1
                var callRoot: int32
                if !ParserValueExprParseCallSuffix(tree,
                                                    cursor,
                                                    tokenLimit,
                                                    rootOut,
                                                    genericStarts,
                                                    genericEnds,
                                                    callRoot,
                                                    err):
                    return false
                rootOut = callRoot
                continue
            let openIndex = cursor
            let closeIndex = ParserValueExprFindMatchingToken(
                tree,
                openIndex,
                tokenLimit,
                ParserValueTokenLeftBracket,
                ParserValueTokenRightBracket)
            if closeIndex < 0 || closeIndex == openIndex + 1:
                err = "parser value expr: index expression missing or unterminated"
                return false
            cursor = cursor + 1
            var indexRoot: int32
            if !ParserValueExprParseExpression(tree,
                                                cursor,
                                                closeIndex,
                                                76,
                                                indexRoot,
                                                err):
                return false
            var children: int32[]
            add(children, rootOut)
            var nodeKind = ParserValueExprIndex
            var operatorStart = ParserValueExprTokenStartAt(tree, openIndex)
            var operatorEnd = ParserValueExprTokenEndAt(tree, openIndex)
            # 索引内容允许完整算符链(`A[(packed >> 18) & 63]` 位与等低优先级
            # 算符为合法既有语法): 76 cap 的首段解析只消费高优先级段, 此处
            # 把非范围算符按优先级左结合续链; 范围算符仍交下方切片分支。
            while cursor < closeIndex:
                let chainKind = ParserValueExprTokenKindAt(tree, cursor)
                if chainKind == ParserValueTokenRangeInclusive ||
                   chainKind == ParserValueTokenRangeExclusive:
                    break
                let chainPrecedence = ParserValueExprBinaryPrecedence(chainKind)
                if chainPrecedence < 0:
                    break
                let chainOperatorIndex = cursor
                cursor = cursor + 1
                var chainRhsRoot: int32
                if !ParserValueExprParseExpression(tree,
                                                    cursor,
                                                    closeIndex,
                                                    chainPrecedence + 1,
                                                    chainRhsRoot,
                                                    err):
                    return false
                let chainLhsRoot = indexRoot
                indexRoot = ParserValueExprAppendNode2(
                    tree,
                    ParserValueExprNodeSourceIdAt(tree, chainLhsRoot),
                    ParserValueExprBinary,
                    ParserValueExprNodeSpanStartAt(tree, chainLhsRoot),
                    ParserValueExprNodeSpanEndAt(tree, chainRhsRoot),
                    indexRoot,
                    chainRhsRoot)
                ParserValueExprSetNodeOperator(
                    tree,
                    indexRoot,
                    ParserValueExprTokenStartAt(tree, chainOperatorIndex),
                    ParserValueExprTokenEndAt(tree, chainOperatorIndex))
            # 续链完成后才把索引根并入子列: 首段解析的 indexRoot 在续链中已
            # 被逐级收养为二元链节点, 提前入列会让它与链尾同时持有双亲
            # (value node has two parents)。
            add(children, indexRoot)
            if cursor < closeIndex &&
               (ParserValueExprTokenKindAt(tree, cursor) ==
                    ParserValueTokenRangeInclusive ||
                ParserValueExprTokenKindAt(tree, cursor) ==
                    ParserValueTokenRangeExclusive):
                let rangeIndex = cursor
                cursor = cursor + 1
                var endRoot: int32
                if !ParserValueExprParseExpression(tree,
                                                    cursor,
                                                    closeIndex,
                                                    0,
                                                    endRoot,
                                                    err):
                    return false
                add(children, endRoot)
                nodeKind = ParserValueExprSlice
                operatorStart = ParserValueExprTokenStartAt(tree, rangeIndex)
                operatorEnd = ParserValueExprTokenEndAt(tree, rangeIndex)
            if cursor != closeIndex:
                err = "parser value expr: index trailing tokens"
                return false
            cursor = closeIndex + 1
            let indexNode = ParserValueExprAppendNode(
                tree,
                ParserValueExprNodeSourceIdAt(tree, rootOut),
                nodeKind,
                ParserValueExprNodeSpanStartAt(tree, rootOut),
                ParserValueExprTokenEndAt(tree, closeIndex),
                children)
            ParserValueExprSetNodeOperator(tree,
                                            indexNode,
                                            operatorStart,
                                            operatorEnd)
            rootOut = indexNode
            continue
        if kind == ParserValueTokenQuestion &&
           !ParserValueExprQuestionHasColon(tree, cursor, tokenLimit):
            let questionIndex = cursor
            var children: int32[]
            add(children, rootOut)
            let tryNode = ParserValueExprAppendNode(
                tree,
                ParserValueExprNodeSourceIdAt(tree, rootOut),
                ParserValueExprTry,
                ParserValueExprNodeSpanStartAt(tree, rootOut),
                ParserValueExprTokenEndAt(tree, questionIndex),
                children)
            ParserValueExprSetNodeOperator(
                tree,
                tryNode,
                ParserValueExprTokenStartAt(tree, questionIndex),
                ParserValueExprTokenEndAt(tree, questionIndex))
            rootOut = tryNode
            cursor = cursor + 1
            continue
        break
    return true

fn ParserValueExprParseExpression(tree: var ParserValueExprTree,
                                    cursor: var int32,
                                    tokenLimit: int32,
                                    minPrecedence: int32,
                                    rootOut: var int32,
                                    err: var str): bool =
    var primaryRoot: int32
    if !ParserValueExprParsePrimary(tree,
                                     cursor,
                                     tokenLimit,
                                     primaryRoot,
                                     err):
        return false
    if !ParserValueExprParsePostfix(tree,
                                     cursor,
                                     tokenLimit,
                                     primaryRoot,
                                     rootOut,
                                     err):
        return false
    if cursor < tokenLimit &&
       ParserValueExprTokenCanStartSpaceAtom(
           ParserValueExprTokenKindAt(tree, cursor)) &&
       ParserValueExprNodeSpanEndAt(tree, rootOut) <
           ParserValueExprTokenStartAt(tree, cursor):
        var argumentPrimary: int32
        if !ParserValueExprParsePrimary(tree,
                                         cursor,
                                         tokenLimit,
                                         argumentPrimary,
                                         err):
            return false
        var argumentRoot: int32
        if !ParserValueExprParsePostfix(tree,
                                         cursor,
                                         tokenLimit,
                                         argumentPrimary,
                                         argumentRoot,
                                         err):
            return false
        var children: int32[]
        add(children, rootOut)
        add(children, argumentRoot)
        let calleeRoot = rootOut
        let spaceCallRoot = ParserValueExprAppendNode(
            tree,
            ParserValueExprNodeSourceIdAt(tree, calleeRoot),
            ParserValueExprSpaceCall,
            ParserValueExprNodeSpanStartAt(tree, calleeRoot),
            ParserValueExprNodeSpanEndAt(tree, argumentRoot),
            children)
        ParserValueExprSetNodeAtom(
            tree,
            spaceCallRoot,
            ParserValueExprNodeSpanStartAt(tree, calleeRoot),
            ParserValueExprNodeSpanEndAt(tree, calleeRoot))
        ParserValueExprSetCallStaticName(tree, spaceCallRoot, calleeRoot)
        ParserValueExprSetNodeCallArgsSpan(
            tree,
            spaceCallRoot,
            ParserValueExprNodeSpanStartAt(tree, argumentRoot),
            ParserValueExprNodeSpanEndAt(tree, argumentRoot))
        var argumentRoots: int32[]
        add(argumentRoots, argumentRoot)
        ParserValueExprAppendArgumentRoots(tree,
                                            spaceCallRoot,
                                            argumentRoots)
        rootOut = spaceCallRoot
    while cursor < tokenLimit:
        let operatorKind = ParserValueExprTokenKindAt(tree, cursor)
        let precedence = ParserValueExprBinaryPrecedence(operatorKind)
        if precedence < minPrecedence:
            break
        let operatorIndex = cursor
        cursor = cursor + 1
        var rhsRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            tokenLimit,
                                            precedence + 1,
                                            rhsRoot,
                                            err):
            return false
        let binaryRoot = ParserValueExprAppendNode2(
            tree,
            ParserValueExprNodeSourceIdAt(tree, rootOut),
            ParserValueExprBinary,
            ParserValueExprNodeSpanStartAt(tree, rootOut),
            ParserValueExprNodeSpanEndAt(tree, rhsRoot),
            rootOut,
            rhsRoot)
        ParserValueExprSetNodeOperator(
            tree,
            binaryRoot,
            ParserValueExprTokenStartAt(tree, operatorIndex),
            ParserValueExprTokenEndAt(tree, operatorIndex))
        rootOut = binaryRoot
    if minPrecedence <= 15 && cursor < tokenLimit &&
       ParserValueExprTokenKindAt(tree, cursor) == ParserValueTokenQuestion &&
       ParserValueExprQuestionHasColon(tree, cursor, tokenLimit):
        let questionIndex = cursor
        cursor = cursor + 1
        var thenRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            tokenLimit,
                                            0,
                                            thenRoot,
                                            err):
            return false
        if cursor >= tokenLimit ||
           ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenColon:
            err = "parser value expr: ternary separator missing"
            return false
        let colonIndex = cursor
        cursor = cursor + 1
        var elseRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            tokenLimit,
                                            15,
                                            elseRoot,
                                            err):
            return false
        var children: int32[]
        add(children, rootOut)
        add(children, thenRoot)
        add(children, elseRoot)
        let ternaryRoot = ParserValueExprAppendNode(
            tree,
            ParserValueExprNodeSourceIdAt(tree, rootOut),
            ParserValueExprTernary,
            ParserValueExprNodeSpanStartAt(tree, rootOut),
            ParserValueExprNodeSpanEndAt(tree, elseRoot),
            children)
        ParserValueExprSetNodeOperator(
            tree,
            ternaryRoot,
            ParserValueExprTokenStartAt(tree, questionIndex),
            ParserValueExprTokenEndAt(tree, colonIndex))
        rootOut = ternaryRoot
    return true

fn ParserValueExprTokenContinuesLine(kind: ParserValueTokenKind): bool =
    # `enum` at a line end continues the declaration onto the member list
    # below it (`PathComponent = enum\n    pcFile, pcDir, ...`): the member
    # list is declaration text owned by the enum declaration, not an
    # expression statement.
    return ParserValueExprBinaryPrecedence(kind) >= 0 ||
           kind == ParserValueTokenAssign || kind == ParserValueTokenComma ||
           kind == ParserValueTokenDot || kind == ParserValueTokenArrow ||
           kind == ParserValueTokenLeftParen ||
           kind == ParserValueTokenLeftBracket ||
           kind == ParserValueTokenEnum ||
           kind == ParserValueTokenLeftBrace || kind == ParserValueTokenQuestion

@borrows
fn ParserValueExprLogicalLineEnd(tree: ParserValueExprTree,
                                   tokenStart: int32,
                                   tokenLimit: int32): int32 =
    if tokenStart < 0 || tokenStart >= tokenLimit:
        return tokenStart
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    var pendingTernaryColonCount: int32
    var previousTokenClosesTernary = false
    var cursor = tokenStart
    while cursor < tokenLimit:
        let tokenLine = ParserValueExprTokenLineAt(tree, cursor)
        # A real line break is relative to the previous token, not the
        # range's first line: `fn f(a: int32,\n    b: int32) =` keeps the
        # `=` on the closing line with the `)`, while a continuation-token
        # line end joins the following line.  The blank-gap rule from the
        # ordinary join is preserved: a blank line ends the statement even
        # after a continuing token (e.g. the type star in
        # `Int32Ptr = int32 *` must not swallow the next declaration).
        if cursor > tokenStart &&
           tokenLine > ParserValueExprTokenLineAt(tree, cursor - 1) &&
           parenDepth == 0 && bracketDepth == 0 && braceDepth == 0:
            let previousKind = ParserValueExprTokenKindAt(tree, cursor - 1)
            let previousContinues =
                ParserValueExprTokenContinuesLine(previousKind) &&
                (previousKind != ParserValueTokenQuestion ||
                 ParserValueExprQuestionHasColon(
                     tree, cursor - 1, tokenLimit))
            # 多行三元续支（`cond\n    ? a\n    : b`，规范 1.3.4 合法，
            # typed_expr.cheng:39517 实证形）：行首 `?`（带 `:` 且前 token
            # 非套件冒号——套件分界优先）与三元未闭合
            # （pendingTernaryColonCount>0）时的行首 `:` 不截断。`?` 起头
            # 的语句本非法，放行后由三元解析裁决（无 `:` 配对仍硬错误）；
            # postfix `expr?` 无 `:` 不续，行为不变。
            let currentOpensTernary =
                ParserValueExprTokenKindAt(tree, cursor) ==
                    ParserValueTokenQuestion &&
                ParserValueExprQuestionHasColon(tree, cursor, tokenLimit) &&
                previousKind != ParserValueTokenColon
            if (!previousContinues &&
                !previousTokenClosesTernary &&
                pendingTernaryColonCount <= 0 &&
                !currentOpensTernary) ||
               tokenLine > ParserValueExprTokenLineAt(tree, cursor - 1) + 1:
                return cursor
        let kind = ParserValueExprTokenKindAt(tree, cursor)
        previousTokenClosesTernary = false
        if kind == ParserValueTokenLeftParen: parenDepth = parenDepth + 1
        elif kind == ParserValueTokenRightParen: parenDepth = parenDepth - 1
        elif kind == ParserValueTokenLeftBracket: bracketDepth = bracketDepth + 1
        elif kind == ParserValueTokenRightBracket: bracketDepth = bracketDepth - 1
        elif kind == ParserValueTokenLeftBrace: braceDepth = braceDepth + 1
        elif kind == ParserValueTokenRightBrace: braceDepth = braceDepth - 1
        elif parenDepth == 0 && bracketDepth == 0 && braceDepth == 0:
            if kind == ParserValueTokenQuestion &&
               ParserValueExprQuestionHasColon(tree, cursor, tokenLimit):
                pendingTernaryColonCount = pendingTernaryColonCount + 1
            elif kind == ParserValueTokenColon &&
                 pendingTernaryColonCount > 0:
                pendingTernaryColonCount = pendingTernaryColonCount - 1
                previousTokenClosesTernary = true
        if parenDepth < 0 || bracketDepth < 0 || braceDepth < 0:
            return cursor
        cursor = cursor + 1
    return tokenLimit

@borrows
fn ParserValueExprPhysicalLineEnd(tree: ParserValueExprTree,
                                    tokenStart: int32,
                                    tokenLimit: int32): int32 =
    if tokenStart < 0 || tokenStart >= tokenLimit:
        return tokenStart
    let lineNumber = ParserValueExprTokenLineAt(tree, tokenStart)
    var cursor = tokenStart + 1
    while cursor < tokenLimit &&
          ParserValueExprTokenLineAt(tree, cursor) == lineNumber:
        cursor = cursor + 1
    return cursor

# A trailing `=` or `enum` starts a declaration-owned indented type body, not
# a generic expression continuation. A trailing `?` is a complete TypeSyntax
# postfix. A trailing forbidden `*` is isolated on the same physical header
# so admission rejects that exact token instead of swallowing the following
# declaration as a binary continuation. Other multiline type expressions
# retain the balanced logical-line scanner (for example `Result[\n    T]`).
@borrows
fn ParserValueExprTypeDeclarationHeaderEnd(
        tree: ParserValueExprTree,
        tokenStart: int32,
        logicalLineEnd: int32): int32 =
    let physicalLineEnd = ParserValueExprPhysicalLineEnd(
        tree, tokenStart, logicalLineEnd)
    if physicalLineEnd <= tokenStart:
        return physicalLineEnd
    let finalKind = ParserValueExprTokenKindAt(tree, physicalLineEnd - 1)
    if finalKind == ParserValueTokenAssign ||
       finalKind == ParserValueTokenEnum ||
       finalKind == ParserValueTokenStar ||
       finalKind == ParserValueTokenQuestion:
        return physicalLineEnd
    return logicalLineEnd

@borrows
fn ParserValueExprIndentedSuiteEnd(tree: ParserValueExprTree,
                                     tokenStart: int32,
                                     tokenLimit: int32,
                                     ownerColumn: int32): int32 =
    var cursor = tokenStart
    while cursor < tokenLimit &&
          ParserValueExprTokenColumnAt(tree, cursor) > ownerColumn:
        let next = ParserValueExprPhysicalLineEnd(tree, cursor, tokenLimit)
        if next <= cursor:
            panic("parser value expr: indented suite made no progress")
        cursor = next
    return cursor

@borrows
fn ParserValueExprFindTopLevelKind(tree: ParserValueExprTree,
                                     tokenStart: int32,
                                     tokenLimit: int32,
                                     wanted: ParserValueTokenKind): int32 =
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    for cursor in tokenStart..<tokenLimit:
        let kind = ParserValueExprTokenKindAt(tree, cursor)
        if kind == wanted && parenDepth == 0 &&
           bracketDepth == 0 && braceDepth == 0:
            return cursor
        if kind == ParserValueTokenLeftParen: parenDepth = parenDepth + 1
        elif kind == ParserValueTokenRightParen: parenDepth = parenDepth - 1
        elif kind == ParserValueTokenLeftBracket: bracketDepth = bracketDepth + 1
        elif kind == ParserValueTokenRightBracket: bracketDepth = bracketDepth - 1
        elif kind == ParserValueTokenLeftBrace: braceDepth = braceDepth + 1
        elif kind == ParserValueTokenRightBrace: braceDepth = braceDepth - 1
    return -1

fn ParserValueExprAppendAnnotationArgNode(
        tree: var ParserValueExprTree,
        ownerAnnotationRow: int32,
        kind: ParserAnnotationArgKind,
        tokenIndex: int32,
        separatorTokenIndex: int32,
        tokenStart: int32,
        tokenLimit: int32,
        children: int32[]): int32 =
    let row = tree.annotationArgCount
    if ownerAnnotationRow < 0 ||
       ownerAnnotationRow >= tree.annotationCount ||
       kind == ParserAnnotationArgInvalid ||
       tokenIndex < 0 || tokenIndex >= tree.tokenCount ||
       separatorTokenIndex < -1 ||
       separatorTokenIndex >= tree.tokenCount ||
       tokenStart < 0 || tokenStart >= tokenLimit ||
       tokenLimit > tree.tokenCount:
        panic("parser annotation: argument authority invalid")
    let childStart = tree.annotationArgChildCount
    for childOffset in 0..<children.len:
        let child = children[childOffset]
        if child < 0 || child >= row ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.annotationArgOwnerRows,
               child) != ownerAnnotationRow:
            panic("parser annotation: argument child authority invalid")
        arenamod.ArenaArrayInt32Add(
            tree.arena, tree.annotationArgChildNodeIndexes, child)
        tree.annotationArgChildCount = tree.annotationArgChildCount + 1
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.annotationArgProducerSourceIndexes, 0)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.annotationArgSourceLocalRows, row)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.annotationArgOwnerRows, ownerAnnotationRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.annotationArgKinds, Int32(kind))
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.annotationArgTokenIndexes, tokenIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.annotationArgSeparatorTokenIndexes,
        separatorTokenIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.annotationArgSpanStarts,
        ParserValueExprTokenStartAt(tree, tokenStart))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.annotationArgSpanEnds,
        ParserValueExprTokenEndAt(tree, tokenLimit - 1))
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.annotationArgChildStarts, childStart)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.annotationArgChildCounts, children.len)
    tree.annotationArgCount = row + 1
    return row

@borrows
fn ParserValueExprAnnotationArgKeyKind(
        tree: ParserValueExprTree,
        nodeIndex: int32): bool =
    if nodeIndex < 0 || nodeIndex >= tree.annotationArgCount:
        return false
    let kind = ParserAnnotationArgKind(arenamod.ArenaArrayInt32Get(
        tree.arena, tree.annotationArgKinds, nodeIndex))
    return kind == ParserAnnotationArgIdentifier ||
           kind == ParserAnnotationArgNumber ||
           kind == ParserAnnotationArgString ||
           kind == ParserAnnotationArgBoolean

fn ParserValueExprParseAnnotationArgInto(
        tree: var ParserValueExprTree,
        cursor: var int32,
        tokenLimit: int32,
        ownerAnnotationRow: int32,
        rootOut: var int32,
        err: var str): bool =
    rootOut = -1
    if cursor < 0 || cursor >= tokenLimit:
        err = "parser annotation: argument missing"
        return false
    let startToken = cursor
    let kind = ParserValueExprTokenKindAt(tree, cursor)
    if ParserValueExprTokenCanName(kind):
        cursor = cursor + 1
        rootOut = ParserValueExprAppendAnnotationArgNode(
            tree, ownerAnnotationRow, ParserAnnotationArgIdentifier,
            startToken, -1, startToken, cursor, [])
    elif kind == ParserValueTokenInteger || kind == ParserValueTokenFloat:
        cursor = cursor + 1
        rootOut = ParserValueExprAppendAnnotationArgNode(
            tree, ownerAnnotationRow, ParserAnnotationArgNumber,
            startToken, -1, startToken, cursor, [])
    elif kind == ParserValueTokenString:
        cursor = cursor + 1
        rootOut = ParserValueExprAppendAnnotationArgNode(
            tree, ownerAnnotationRow, ParserAnnotationArgString,
            startToken, -1, startToken, cursor, [])
    elif kind == ParserValueTokenChar:
        cursor = cursor + 1
        rootOut = ParserValueExprAppendAnnotationArgNode(
            tree, ownerAnnotationRow, ParserAnnotationArgCharacter,
            startToken, -1, startToken, cursor, [])
    elif kind == ParserValueTokenTrue || kind == ParserValueTokenFalse:
        cursor = cursor + 1
        rootOut = ParserValueExprAppendAnnotationArgNode(
            tree, ownerAnnotationRow, ParserAnnotationArgBoolean,
            startToken, -1, startToken, cursor, [])
    elif kind == ParserValueTokenLeftBracket:
        cursor = cursor + 1
        # [ar2-scratch] AD1 batch 2a: list children ride the tree scratch
        # arena.  Each element consumes at least one token, so the token
        # span is a hard bound; CopyOut right before the append keeps the
        # heap-seq consumer contract unchanged.
        var childrenScratch: ParserScratchSeqInt32
        if !ParserScratchSeqReserve(tree, childrenScratch,
                                    tokenLimit - startToken):
            panic("parser scratch: annotation list reserve failed")
        while cursor < tokenLimit &&
              ParserValueExprTokenKindAt(tree, cursor) !=
                  ParserValueTokenRightBracket:
            var child: int32
            if !ParserValueExprParseAnnotationArgInto(
                   tree, cursor, tokenLimit, ownerAnnotationRow, child, err):
                return false
            ParserScratchSeqAdd(tree, childrenScratch, child)
            if cursor < tokenLimit &&
               ParserValueExprTokenKindAt(tree, cursor) ==
                   ParserValueTokenComma:
                cursor = cursor + 1
                if cursor < tokenLimit &&
                   ParserValueExprTokenKindAt(tree, cursor) ==
                       ParserValueTokenRightBracket:
                    break
            else:
                break
        if cursor >= tokenLimit ||
           ParserValueExprTokenKindAt(tree, cursor) !=
               ParserValueTokenRightBracket:
            err = "parser annotation: list close missing"
            return false
        cursor = cursor + 1
        var children: int32[]
        ParserScratchCopyOutToHeap(tree, childrenScratch, children)
        rootOut = ParserValueExprAppendAnnotationArgNode(
            tree, ownerAnnotationRow, ParserAnnotationArgList,
            startToken, -1, startToken, cursor, children)
    elif kind == ParserValueTokenLeftBrace:
        cursor = cursor + 1
        # [ar2-scratch] AD1 batch 2a: dictionary entries ride the tree
        # scratch arena (same provable span bound and CopyOut exit as the
        # list arm above).
        var entriesScratch: ParserScratchSeqInt32
        if !ParserScratchSeqReserve(tree, entriesScratch,
                                    tokenLimit - startToken):
            panic("parser scratch: annotation dict reserve failed")
        while cursor < tokenLimit &&
              ParserValueExprTokenKindAt(tree, cursor) !=
                  ParserValueTokenRightBrace:
            var entry: int32
            if !ParserValueExprParseAnnotationArgInto(
                   tree, cursor, tokenLimit, ownerAnnotationRow, entry, err):
                return false
            if ParserAnnotationArgKind(arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.annotationArgKinds,
                   entry)) != ParserAnnotationArgKeyValue:
                err = "parser annotation: dictionary entry is not key/value"
                return false
            ParserScratchSeqAdd(tree, entriesScratch, entry)
            if cursor < tokenLimit &&
               ParserValueExprTokenKindAt(tree, cursor) ==
                   ParserValueTokenComma:
                cursor = cursor + 1
                if cursor < tokenLimit &&
                   ParserValueExprTokenKindAt(tree, cursor) ==
                       ParserValueTokenRightBrace:
                    break
            else:
                break
        if cursor >= tokenLimit ||
           ParserValueExprTokenKindAt(tree, cursor) !=
               ParserValueTokenRightBrace:
            err = "parser annotation: dictionary close missing"
            return false
        cursor = cursor + 1
        var entries: int32[]
        ParserScratchCopyOutToHeap(tree, entriesScratch, entries)
        rootOut = ParserValueExprAppendAnnotationArgNode(
            tree, ownerAnnotationRow, ParserAnnotationArgDict,
            startToken, -1, startToken, cursor, entries)
    else:
        err = "parser annotation: unsupported argument token"
        return false
    if cursor < tokenLimit &&
       (ParserValueExprTokenKindAt(tree, cursor) ==
            ParserValueTokenColon ||
        ParserValueExprTokenKindAt(tree, cursor) ==
            ParserValueTokenAssign):
        if !ParserValueExprAnnotationArgKeyKind(tree, rootOut):
            err = "parser annotation: key kind invalid"
            return false
        let separatorToken = cursor
        cursor = cursor + 1
        var valueNode: int32
        if !ParserValueExprParseAnnotationArgInto(
               tree,
               cursor,
               tokenLimit,
               ownerAnnotationRow,
               valueNode,
               err):
            return false
        rootOut = ParserValueExprAppendAnnotationArgNode(
            tree,
            ownerAnnotationRow,
            ParserAnnotationArgKeyValue,
            separatorToken,
            separatorToken,
            startToken,
            cursor,
            [rootOut, valueNode])
    return true

fn ParserValueExprAppendAnnotationInto(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        annotationRowOut: var int32,
        err: var str): bool =
    annotationRowOut = -1
    if tokenStart < 0 || tokenStart + 1 >= tokenLimit ||
       tokenLimit > tree.tokenCount ||
       ParserValueExprTokenKindAt(tree, tokenStart) !=
           ParserValueTokenAt ||
       !ParserValueExprTokenCanName(
           ParserValueExprTokenKindAt(tree, tokenStart + 1)):
        err = "parser annotation: name missing"
        return false
    let annotationRow = tree.annotationCount
    let rootStart = tree.annotationArgRootCount
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.annotationProducerSourceIndexes, 0)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.annotationSourceLocalRows, annotationRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.annotationNameTokenIndexes, tokenStart + 1)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.annotationTargetTokenIndexes, -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.annotationSpanStarts,
        ParserValueExprTokenStartAt(tree, tokenStart))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.annotationSpanEnds,
        ParserValueExprTokenEndAt(tree, tokenLimit - 1))
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.annotationArgRootStarts, rootStart)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.annotationArgRootCounts, 0)
    tree.annotationCount = annotationRow + 1
    annotationRowOut = annotationRow
    if tokenStart + 2 == tokenLimit:
        return true
    let openToken = tokenStart + 2
    if ParserValueExprTokenKindAt(tree, openToken) !=
           ParserValueTokenLeftParen:
        err = "parser annotation: argument list must use parentheses"
        return false
    let closeToken = ParserValueExprFindMatchingToken(
        tree,
        openToken,
        tokenLimit,
        ParserValueTokenLeftParen,
        ParserValueTokenRightParen)
    if closeToken != tokenLimit - 1:
        err = "parser annotation: argument list close mismatch"
        return false
    ParserValueExprAppendRegion(
        tree,
        ParserValueExprRegionAnnotationArgs,
        ParserValueExprTokenSourceIdAt(tree, openToken),
        ParserValueExprTokenStartAt(tree, openToken),
        ParserValueExprTokenEndAt(tree, closeToken),
        openToken)
    var cursor = openToken + 1
    while cursor < closeToken:
        var root: int32
        if !ParserValueExprParseAnnotationArgInto(
               tree,
               cursor,
               closeToken,
               annotationRow,
               root,
               err):
            return false
        arenamod.ArenaArrayInt32Add(
            tree.arena, tree.annotationArgRootNodeIndexes, root)
        tree.annotationArgRootCount = tree.annotationArgRootCount + 1
        if cursor >= closeToken:
            break
        let separatorKind = ParserValueExprTokenKindAt(tree, cursor)
        if separatorKind != ParserValueTokenComma &&
           separatorKind != ParserValueTokenSemicolon:
            err = "parser annotation: argument separator missing"
            return false
        cursor = cursor + 1
        if cursor >= closeToken:
            err = "parser annotation: trailing top-level separator"
            return false
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.annotationArgRootCounts,
        annotationRow,
        tree.annotationArgRootCount - rootStart)
    return true

fn ParserValueExprBindAnnotationTargets(
        tree: var ParserValueExprTree,
        annotationStart: int32,
        annotationCount: int32,
        targetTokenIndex: int32) =
    if annotationStart < 0 || annotationCount <= 0 ||
       annotationStart > tree.annotationCount - annotationCount ||
       targetTokenIndex < 0 || targetTokenIndex >= tree.tokenCount:
        panic("parser annotation: target range invalid")
    for offset in 0..<annotationCount:
        let row = annotationStart + offset
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationNameTokenIndexes, row)
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.annotationTargetTokenIndexes,
               row) != -1 ||
           ParserValueExprTokenSourceIdAt(tree, nameToken) !=
               ParserValueExprTokenSourceIdAt(tree, targetTokenIndex) ||
           ParserValueExprTokenStartAt(tree, targetTokenIndex) <=
               arenamod.ArenaArrayInt32Get(
                   tree.arena, tree.annotationSpanEnds, row):
            panic("parser annotation: target identity invalid")
        arenamod.ArenaArrayInt32Set(
            tree.arena,
            tree.annotationTargetTokenIndexes,
            row,
            targetTokenIndex)

@borrows
fn ParserValueExprFindTopLevelBranch(tree: ParserValueExprTree,
                                       tokenStart: int32,
                                       tokenLimit: int32,
                                       ownerBranchTokenIndex: int32): int32 =
    if ownerBranchTokenIndex < 0 ||
       ownerBranchTokenIndex >= tree.tokenCount:
        return -1
    let ownerLine = ParserValueExprTokenLineAt(
        tree, ownerBranchTokenIndex)
    let ownerColumn = ParserValueExprTokenColumnAt(
        tree, ownerBranchTokenIndex)
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    var inlineNestedConditionalDepth: int32
    var inlineCaseGuardPending = false
    for cursor in tokenStart..<tokenLimit:
        let kind = ParserValueExprTokenKindAt(tree, cursor)
        if kind == ParserValueTokenLeftParen: parenDepth = parenDepth + 1
        elif kind == ParserValueTokenRightParen: parenDepth = parenDepth - 1
        elif kind == ParserValueTokenLeftBracket: bracketDepth = bracketDepth + 1
        elif kind == ParserValueTokenRightBracket: bracketDepth = bracketDepth - 1
        elif kind == ParserValueTokenLeftBrace: braceDepth = braceDepth + 1
        elif kind == ParserValueTokenRightBrace: braceDepth = braceDepth - 1
        elif parenDepth == 0 && bracketDepth == 0 && braceDepth == 0 &&
             ParserValueExprTokenLineAt(tree, cursor) == ownerLine &&
             kind == ParserValueTokenOf:
            inlineCaseGuardPending = true
        elif parenDepth == 0 && bracketDepth == 0 && braceDepth == 0 &&
             ParserValueExprTokenLineAt(tree, cursor) == ownerLine &&
             kind == ParserValueTokenColon:
            inlineCaseGuardPending = false
        elif parenDepth == 0 && bracketDepth == 0 && braceDepth == 0 &&
             (kind == ParserValueTokenCase ||
              kind == ParserValueTokenWhen ||
              (kind == ParserValueTokenIf &&
               !inlineCaseGuardPending)) &&
             ParserValueExprTokenLineAt(tree, cursor) == ownerLine:
            # Single-line suites use the normal nearest-unmatched-conditional
            # rule. A nested if/when/case on the owner's physical line must
            # consume its own branch before a later branch belongs to the
            # owner. `if` between `of` and its colon is a case guard, not a
            # nested conditional.
            inlineNestedConditionalDepth =
                inlineNestedConditionalDepth + 1
        elif parenDepth == 0 && bracketDepth == 0 && braceDepth == 0 &&
             (kind == ParserValueTokenElif || kind == ParserValueTokenElse):
            # A branch in an indented suite is owned by the conditional only
            # at the owner's exact indentation.  `else` inside a nested
            # statement or an `if` expression in that suite is a different
            # token authority even though delimiter depth is also zero.
            # Inline branches remain on the owner's physical line.
            let branchLine = ParserValueExprTokenLineAt(tree, cursor)
            let branchColumn = ParserValueExprTokenColumnAt(tree, cursor)
            if branchLine == ownerLine &&
               inlineNestedConditionalDepth > 0:
                if kind == ParserValueTokenElse:
                    inlineNestedConditionalDepth =
                        inlineNestedConditionalDepth - 1
                continue
            if branchColumn == ownerColumn || branchLine == ownerLine:
                return cursor
    return -1

@borrows
fn ParserValueExprPatternTokenIsWildcard(
        tree: ParserValueExprTree,
        tokenIndex: int32): bool =
    let source = ParserValueExprSourceText(
        tree, ParserValueExprTokenSourceIdAt(tree, tokenIndex))
    let start = ParserValueExprTokenStartAt(tree, tokenIndex)
    let finish = ParserValueExprTokenEndAt(tree, tokenIndex)
    return finish == start + 1 && start >= 0 && finish <= source.len &&
           source[start] == '_'

fn ParserValueExprAppendPatternNode(
        tree: var ParserValueExprTree,
        kind: ParserPatternKind,
        nameTokenIndex: int32,
        bindingDeclarationRow: int32,
        startToken: int32,
        endTokenExclusive: int32,
        children: int32[]): int32 =
    if tree.lexicalBindingAuthoritySealed:
        panic("parser lexical binding: sealed pattern mutation")
    let row = tree.patternCount
    if kind == ParserPatternInvalid || startToken < 0 ||
       startToken >= endTokenExclusive || endTokenExclusive > tree.tokenCount ||
       nameTokenIndex < -1 || nameTokenIndex >= tree.tokenCount ||
       bindingDeclarationRow < -1 ||
       bindingDeclarationRow >= tree.declarationCount ||
       tree.activeDeclarationLexicalScopeRow < 0:
        panic("parser pattern: node authority invalid")
    let childStart = tree.patternChildCount
    for childOffset in 0..<children.len:
        if children[childOffset] < 0 || children[childOffset] >= row:
            panic("parser pattern: child is not postorder")
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.patternChildNodeIndexes,
            children[childOffset])
        tree.patternChildCount = tree.patternChildCount + 1
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.patternProducerSourceIndexes, 0)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.patternSourceLocalRows, row)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.patternKinds, Int32(kind))
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.patternNameTokenIndexes, nameTokenIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.patternOwnerLexicalScopeRows,
        tree.activeDeclarationLexicalScopeRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.patternOwnerKinds,
        Int32(ParserPatternOwnerInvalid))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.patternOwnerRows,
        -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.patternBindingDeclarationRows,
        bindingDeclarationRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.patternTypeSyntaxRootIndexes, -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.patternSpanStarts,
        ParserValueExprTokenStartAt(tree, startToken))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.patternSpanEnds,
        ParserValueExprTokenEndAt(tree, endTokenExclusive - 1))
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.patternChildStarts, childStart)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.patternChildCounts, children.len)
    tree.patternCount = row + 1
    return row

fn ParserValueExprSetPatternRootOwner(
        tree: var ParserValueExprTree,
        patternRoot: int32,
        ownerKind: ParserPatternOwnerKind,
        ownerRow: int32) =
    if tree == nil ||
       tree.lifecycleState != ParserValueExprOwnerActive ||
       patternRoot < 0 || patternRoot >= tree.patternCount ||
       (ownerKind != ParserPatternOwnerRegion &&
        ownerKind != ParserPatternOwnerValueNode) ||
       (ownerKind == ParserPatternOwnerRegion &&
        (ownerRow < 0 || ownerRow >= tree.regionCount)) ||
       (ownerKind == ParserPatternOwnerValueNode &&
        (ownerRow < 0 || ownerRow >= tree.nodeCount)) ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.patternOwnerKinds,
           patternRoot) != Int32(ParserPatternOwnerInvalid) ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.patternOwnerRows,
           patternRoot) != -1:
        panic("parser pattern: root owner authority invalid")
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.patternOwnerKinds,
        patternRoot,
        Int32(ownerKind))
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.patternOwnerRows,
        patternRoot,
        ownerRow)

fn ParserValueExprPatternAppendBindingDeclaration(
        tree: var ParserValueExprTree,
        nameToken: int32,
        declarationStartToken: int32,
        declarationEndTokenExclusive: int32,
        mutableFlag: bool,
        bindingNameTokens: var int32[],
        err: var str): int32 =
    var name = ParserValueExprTokenText(tree, nameToken)
    for row in 0..<bindingNameTokens.len:
        var previousName =
            ParserValueExprTokenText(tree, bindingNameTokens[row])
        let duplicate = previousName == name
        os.ReleaseStr(previousName)
        if duplicate:
            err = Fmt"parser pattern: duplicate binding '{name}'"
            os.ReleaseStr(name)
            return -1
    os.ReleaseStr(name)
    add(bindingNameTokens, nameToken)
    let owner = ParserValueExprActiveDeclarationOwner(tree)
    return ParserValueExprAppendDeclaration(
        tree,
        ParserDeclarationLocal,
        nameToken,
        owner,
        tree.activeDeclarationLexicalScopeRow,
        tree.activeFunctionRow,
        -1,
        declarationStartToken,
        declarationEndTokenExclusive,
        mutableFlag)

fn ParserValueExprParsePatternInto(
        tree: var ParserValueExprTree,
        cursor: var int32,
        tokenLimit: int32,
        declarationStartToken: int32,
        declarationEndTokenExclusive: int32,
        mutableFlag: bool,
        parseContext: ParserPatternParseContext,
        bindingNameTokens: var int32[],
        rootOut: var int32,
        err: var str): bool =
    if cursor < 0 || cursor >= tokenLimit:
        err = "parser pattern: primary missing"
        return false
    if parseContext != ParserPatternParseBindingDeclaration &&
       parseContext != ParserPatternParseMatchArm:
        err = "parser pattern: parse context missing"
        return false
    let startToken = cursor
    let kind = ParserValueExprTokenKindAt(tree, cursor)
    var primaryRoot: int32 = -1
    if ParserValueExprTokenCanName(kind):
        let nameToken = cursor
        cursor = cursor + 1
        if cursor < tokenLimit &&
           ParserValueExprTokenKindAt(tree, cursor) ==
               ParserValueTokenColon:
            cursor = cursor + 1
            var child: int32
            if !ParserValueExprParsePatternInto(
                   tree,
                   cursor,
                   tokenLimit,
                   declarationStartToken,
                   declarationEndTokenExclusive,
                   mutableFlag,
                   parseContext,
                   bindingNameTokens,
                   child,
                   err):
                return false
            primaryRoot = ParserValueExprAppendPatternNode(
                tree,
                ParserPatternNamedField,
                nameToken,
                -1,
                startToken,
                cursor,
                [child])
        elif cursor < tokenLimit &&
             ParserValueExprTokenKindAt(tree, cursor) ==
                 ParserValueTokenLeftParen:
            cursor = cursor + 1
            var children: int32[]
            while cursor < tokenLimit &&
                  ParserValueExprTokenKindAt(tree, cursor) !=
                      ParserValueTokenRightParen:
                var child: int32
                if !ParserValueExprParsePatternInto(
                       tree,
                       cursor,
                       tokenLimit,
                       declarationStartToken,
                       declarationEndTokenExclusive,
                       mutableFlag,
                       parseContext,
                       bindingNameTokens,
                       child,
                       err):
                    return false
                add(children, child)
                if cursor < tokenLimit &&
                   ParserValueExprTokenKindAt(tree, cursor) ==
                       ParserValueTokenComma:
                    cursor = cursor + 1
                else:
                    break
            if cursor >= tokenLimit ||
               ParserValueExprTokenKindAt(tree, cursor) !=
                   ParserValueTokenRightParen:
                err = "parser pattern: constructor close missing"
                return false
            cursor = cursor + 1
            primaryRoot = ParserValueExprAppendPatternNode(
                tree,
                ParserPatternConstructor,
                nameToken,
                -1,
                startToken,
                cursor,
                children)
        elif ParserValueExprPatternTokenIsWildcard(tree, nameToken):
            primaryRoot = ParserValueExprAppendPatternNode(
                tree,
                ParserPatternWildcard,
                nameToken,
                -1,
                startToken,
                cursor,
                [])
        elif parseContext == ParserPatternParseMatchArm &&
             ParserValueExprDeclarationExportedAt(tree, nameToken):
            primaryRoot = ParserValueExprAppendPatternNode(
                tree,
                ParserPatternLiteral,
                nameToken,
                -1,
                startToken,
                cursor,
                [])
        else:
            let declarationRow =
                ParserValueExprPatternAppendBindingDeclaration(
                    tree,
                    nameToken,
                    declarationStartToken,
                    declarationEndTokenExclusive,
                    mutableFlag,
                    bindingNameTokens,
                    err)
            if declarationRow < 0:
                return false
            primaryRoot = ParserValueExprAppendPatternNode(
                tree,
                ParserPatternBinding,
                nameToken,
                declarationRow,
                startToken,
                cursor,
                [])
    elif kind == ParserValueTokenLeftParen ||
         kind == ParserValueTokenLeftBracket ||
         kind == ParserValueTokenLeftBrace:
        let closeKind = kind == ParserValueTokenLeftParen ?
            ParserValueTokenRightParen :
            (kind == ParserValueTokenLeftBracket ?
                ParserValueTokenRightBracket : ParserValueTokenRightBrace)
        let aggregateKind = kind == ParserValueTokenLeftParen ?
            ParserPatternTuple :
            (kind == ParserValueTokenLeftBracket ?
                ParserPatternSequence : ParserPatternObject)
        cursor = cursor + 1
        var children: int32[]
        while cursor < tokenLimit &&
              ParserValueExprTokenKindAt(tree, cursor) != closeKind:
            var child: int32
            if !ParserValueExprParsePatternInto(
                   tree,
                   cursor,
                   tokenLimit,
               declarationStartToken,
               declarationEndTokenExclusive,
               mutableFlag,
               parseContext,
               bindingNameTokens,
               child,
               err):
                return false
            add(children, child)
            if cursor < tokenLimit &&
               ParserValueExprTokenKindAt(tree, cursor) ==
                   ParserValueTokenComma:
                cursor = cursor + 1
            else:
                break
        if cursor >= tokenLimit ||
           ParserValueExprTokenKindAt(tree, cursor) != closeKind:
            err = "parser pattern: aggregate close missing"
            return false
        cursor = cursor + 1
        primaryRoot = ParserValueExprAppendPatternNode(
            tree,
            aggregateKind,
            -1,
            -1,
            startToken,
            cursor,
            children)
    elif kind == ParserValueTokenInteger || kind == ParserValueTokenFloat ||
         kind == ParserValueTokenString || kind == ParserValueTokenChar ||
         kind == ParserValueTokenTrue || kind == ParserValueTokenFalse ||
         kind == ParserValueTokenNil:
        cursor = cursor + 1
        primaryRoot = ParserValueExprAppendPatternNode(
            tree,
            ParserPatternLiteral,
            cursor - 1,
            -1,
            startToken,
            cursor,
            [])
    else:
        err = "parser pattern: token is not a pattern"
        return false
    if cursor < tokenLimit &&
       (ParserValueExprTokenKindAt(tree, cursor) ==
            ParserValueTokenRangeInclusive ||
        ParserValueExprTokenKindAt(tree, cursor) ==
            ParserValueTokenRangeExclusive):
        cursor = cursor + 1
        var right: int32
        if !ParserValueExprParsePatternInto(
               tree,
               cursor,
               tokenLimit,
           declarationStartToken,
           declarationEndTokenExclusive,
           mutableFlag,
           parseContext,
           bindingNameTokens,
           right,
           err):
            return false
        rootOut = ParserValueExprAppendPatternNode(
            tree,
            ParserPatternRange,
            -1,
            -1,
            startToken,
            cursor,
            [primaryRoot, right])
        return true
    rootOut = primaryRoot
    return true

fn ParserValueExprParsePatternRange(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        declarationStartToken: int32,
        declarationEndTokenExclusive: int32,
        mutableFlag: bool,
        parseContext: ParserPatternParseContext,
        rootOut: var int32,
        err: var str): bool =
    var cursor = tokenStart
    rootOut = -1
    var bindingNameTokens: int32[]
    if !ParserValueExprParsePatternInto(
           tree,
           cursor,
           tokenLimit,
           declarationStartToken,
           declarationEndTokenExclusive,
           mutableFlag,
           parseContext,
           bindingNameTokens,
           rootOut,
           err):
        return false
    if cursor != tokenLimit:
        err = "parser pattern: trailing token"
        return false
    return true

fn ParserValueExprParsePatternListRange(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        declarationStartToken: int32,
        declarationEndTokenExclusive: int32,
        mutableFlag: bool,
        parseContext: ParserPatternParseContext,
        ownerKind: ParserPatternOwnerKind,
        ownerRow: int32,
        err: var str): bool =
    if (ownerKind != ParserPatternOwnerRegion &&
        ownerKind != ParserPatternOwnerValueNode) ||
       (ownerKind == ParserPatternOwnerRegion &&
        (ownerRow < 0 || ownerRow >= tree.regionCount)) ||
       (ownerKind == ParserPatternOwnerValueNode &&
        (ownerRow < 0 || ownerRow >= tree.nodeCount)):
        err = "parser pattern: list owner missing"
        return false
    var segmentStart = tokenStart
    var cursor = tokenStart
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    var bindingNameTokens: int32[]
    while cursor <= tokenLimit:
        let atEnd = cursor == tokenLimit
        var split = atEnd
        if !atEnd:
            let kind = ParserValueExprTokenKindAt(tree, cursor)
            if kind == ParserValueTokenComma && parenDepth == 0 &&
               bracketDepth == 0 && braceDepth == 0:
                split = true
            elif kind == ParserValueTokenLeftParen:
                parenDepth = parenDepth + 1
            elif kind == ParserValueTokenRightParen:
                parenDepth = parenDepth - 1
            elif kind == ParserValueTokenLeftBracket:
                bracketDepth = bracketDepth + 1
            elif kind == ParserValueTokenRightBracket:
                bracketDepth = bracketDepth - 1
            elif kind == ParserValueTokenLeftBrace:
                braceDepth = braceDepth + 1
            elif kind == ParserValueTokenRightBrace:
                braceDepth = braceDepth - 1
        if parenDepth < 0 || bracketDepth < 0 || braceDepth < 0:
            err = "parser pattern: list delimiters invalid"
            return false
        if split:
            if cursor <= segmentStart:
                err = "parser pattern: empty list entry"
                return false
            var patternCursor = segmentStart
            var root: int32
            if !ParserValueExprParsePatternInto(
                   tree,
                   patternCursor,
                   cursor,
                   declarationStartToken,
                   declarationEndTokenExclusive,
                   mutableFlag,
                   parseContext,
                   bindingNameTokens,
                   root,
                   err) || patternCursor != cursor:
                if err == "":
                    err = "parser pattern: list entry trailing token"
                return false
            ParserValueExprSetPatternRootOwner(
                tree,
                root,
                ownerKind,
                ownerRow)
            if atEnd:
                break
            segmentStart = cursor + 1
        cursor = cursor + 1
    return parenDepth == 0 && bracketDepth == 0 && braceDepth == 0

fn ParserValueExprParseCaseEntryListRange(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        declarationStartToken: int32,
        declarationEndTokenExclusive: int32,
        patternOwnerKind: ParserPatternOwnerKind,
        patternOwnerRow: int32,
        patternRootsOut: var int32[],
        expressionRootsOut: var int32[],
        err: var str): bool =
    if tokenStart < 0 || tokenStart >= tokenLimit ||
       tokenLimit > tree.tokenCount:
        err = "parser case entry: range invalid"
        return false
    if (patternOwnerKind == ParserPatternOwnerInvalid &&
        patternOwnerRow != -1) ||
       (patternOwnerKind == ParserPatternOwnerRegion &&
        (patternOwnerRow < 0 || patternOwnerRow >= tree.regionCount)) ||
       patternOwnerKind == ParserPatternOwnerValueNode:
        err = "parser case entry: pattern owner invalid"
        return false
    var segmentStart = tokenStart
    var cursor = tokenStart
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    var bindingNameTokens: int32[]
    # [d5-presize] one root per comma-separated entry; every entry consumes
    # at least one token, so (tokenLimit - tokenStart) is a sound bound for
    # both out lists.  True counts are restored by setLen before the success
    # return; every error return below discards both lists, and both callers
    # only read them after a true return.
    setLen(patternRootsOut, tokenLimit - tokenStart)
    var patternRootCount: int32
    setLen(expressionRootsOut, tokenLimit - tokenStart)
    var expressionRootCount: int32
    while cursor <= tokenLimit:
        let atEnd = cursor == tokenLimit
        var split = atEnd
        if !atEnd:
            let kind = ParserValueExprTokenKindAt(tree, cursor)
            if kind == ParserValueTokenComma && parenDepth == 0 &&
               bracketDepth == 0 && braceDepth == 0:
                split = true
            elif kind == ParserValueTokenLeftParen:
                parenDepth = parenDepth + 1
            elif kind == ParserValueTokenRightParen:
                parenDepth = parenDepth - 1
            elif kind == ParserValueTokenLeftBracket:
                bracketDepth = bracketDepth + 1
            elif kind == ParserValueTokenRightBracket:
                bracketDepth = bracketDepth - 1
            elif kind == ParserValueTokenLeftBrace:
                braceDepth = braceDepth + 1
            elif kind == ParserValueTokenRightBrace:
                braceDepth = braceDepth - 1
        if parenDepth < 0 || bracketDepth < 0 || braceDepth < 0:
            err = "parser case entry: delimiters invalid"
            return false
        if split:
            if cursor <= segmentStart:
                err = "parser case entry: empty entry"
                return false
            let declarationCheckpoint = tree.declarationCount
            let patternCheckpoint = tree.patternCount
            let patternChildCheckpoint = tree.patternChildCount
            let bindingNameCheckpoint = bindingNameTokens.len
            var patternCursor = segmentStart
            var patternRoot: int32
            var patternErr: str
            let parsedPattern = ParserValueExprParsePatternInto(
                tree,
                patternCursor,
                cursor,
                declarationStartToken,
                declarationEndTokenExclusive,
                false,
                ParserPatternParseMatchArm,
                bindingNameTokens,
                patternRoot,
                patternErr)
            if parsedPattern && patternCursor == cursor:
                if patternOwnerKind == ParserPatternOwnerRegion:
                    ParserValueExprSetPatternRootOwner(
                        tree,
                        patternRoot,
                        ParserPatternOwnerRegion,
                        patternOwnerRow)
                patternRootsOut[patternRootCount] = patternRoot
                patternRootCount = patternRootCount + 1
            else:
                ParserValueExprRollbackPatternTransaction(
                    tree,
                    declarationCheckpoint,
                    patternCheckpoint,
                    patternChildCheckpoint)
                bindingNameTokens.len = bindingNameCheckpoint
                if ParserStartsWithExact(
                       patternErr,
                       "parser pattern: duplicate binding"):
                    err = patternErr
                    return false
                var expressionCursor = segmentStart
                var expressionRoot: int32
                if !ParserValueExprParseExpression(
                       tree,
                       expressionCursor,
                       cursor,
                       0,
                       expressionRoot,
                       err):
                    return false
                if expressionCursor != cursor:
                    err = "parser case entry: expression trailing token"
                    return false
                expressionRootsOut[expressionRootCount] = expressionRoot
                expressionRootCount = expressionRootCount + 1
            if atEnd:
                break
            segmentStart = cursor + 1
        cursor = cursor + 1
    if parenDepth != 0 || bracketDepth != 0 || braceDepth != 0:
        err = "parser case entry: delimiters unterminated"
        return false
    setLen(patternRootsOut, patternRootCount)
    setLen(expressionRootsOut, expressionRootCount)
    err = ""
    return true

fn ParserValueExprRollbackPatternTransaction(
        tree: var ParserValueExprTree,
        declarationCount: int32,
        patternCount: int32,
        patternChildCount: int32) =
    tree.declarationCount = declarationCount
    tree.declarationProducerSourceIndexes.len = declarationCount
    tree.declarationSourceLocalRows.len = declarationCount
    tree.declarationKinds.len = declarationCount
    tree.declarationNameTokenIndexes.len = declarationCount
    tree.declarationOwnerRows.len = declarationCount
    tree.declarationLexicalScopeRows.len = declarationCount
    tree.declarationFunctionRows.len = declarationCount
    tree.declarationTypeSyntaxRootIndexes.len = declarationCount
    tree.declarationDefaultStatementRootRows.len = declarationCount
    tree.declarationGenericSymbolStarts.len = declarationCount
    tree.declarationGenericSymbolCounts.len = declarationCount
    tree.declarationSuiteLexicalScopeRows.len = declarationCount
    tree.declarationSpanStarts.len = declarationCount
    tree.declarationSpanEnds.len = declarationCount
    tree.declarationNameSpanStarts.len = declarationCount
    tree.declarationNameSpanEnds.len = declarationCount
    tree.declarationMutableFlags.len = declarationCount
    tree.declarationExportedFlags.len = declarationCount
    tree.patternCount = patternCount
    tree.patternProducerSourceIndexes.len = patternCount
    tree.patternSourceLocalRows.len = patternCount
    tree.patternKinds.len = patternCount
    tree.patternNameTokenIndexes.len = patternCount
    tree.patternOwnerLexicalScopeRows.len = patternCount
    tree.patternOwnerKinds.len = patternCount
    tree.patternOwnerRows.len = patternCount
    tree.patternBindingDeclarationRows.len = patternCount
    tree.patternTypeSyntaxRootIndexes.len = patternCount
    tree.patternSpanStarts.len = patternCount
    tree.patternSpanEnds.len = patternCount
    tree.patternChildStarts.len = patternCount
    tree.patternChildCounts.len = patternCount
    tree.patternChildCount = patternChildCount
    tree.patternChildNodeIndexes.len = patternChildCount

@borrows
fn ParserValueExprStatementEndTokenFor(tree: ParserValueExprTree,
                                       rootNodeIndex: int32,
                                       firstTokenIndex: int32,
                                       lastTokenIndex: int32): int32 =
    # Grouping parentheses are not nodes: the root's span end is the last
    # semantic token, which can sit before the range's last token (e.g. an
    # `if (a && b):` condition where the range's last token is `)`).  Walk
    # the end token back to the one whose end is exactly the root span end;
    # anything else is a genuine tree inconsistency.
    let rootSpanEnd = ParserValueExprNodeSpanEndAt(tree, rootNodeIndex)
    var endToken = lastTokenIndex
    while endToken > firstTokenIndex &&
          ParserValueExprTokenEndAt(tree, endToken) > rootSpanEnd:
        endToken = endToken - 1
    if ParserValueExprTokenEndAt(tree, endToken) != rootSpanEnd:
        panic("parser value expr: statement root end token differs from node")
    return endToken

fn ParserValueExprParseExactRoot(tree: var ParserValueExprTree,
                                   tokenStart: int32,
                                   tokenLimit: int32,
                                   role: ParserValueExprStatementRole,
                                   anchorTokenIndex: int32,
                                   rootOut: var int32,
                                   err: var str): bool =
    if tokenStart < 0 || tokenStart >= tokenLimit:
        err = "parser value expr: empty expression event"
        return false
    var cursor = tokenStart
    if !ParserValueExprParseExpression(tree,
                                        cursor,
                                        tokenLimit,
                                        0,
                                        rootOut,
                                        err):
        return false
    if cursor != tokenLimit:
        err = Fmt"parser value expr: expression event trailing token offset={ParserValueExprTokenStartAt(tree, cursor)}"
        return false
    ParserValueExprAppendStatementRoot(tree,
                                        rootOut,
                                        role,
                                        anchorTokenIndex,
                                        ParserValueExprStatementEndTokenFor(
                                            tree,
                                            rootOut,
                                            anchorTokenIndex,
                                            tokenLimit - 1))
    return true

fn ParserValueExprParseParameterDefaults(tree: var ParserValueExprTree,
                                            openIndex: int32,
                                            closeIndex: int32,
                                            declarationOwnerTokenIndex: int32,
                                            genericSymbolStart: int32,
                                            genericSymbolCount: int32,
                                            err: var str): bool =
    let parameterDeclarationStart = tree.declarationCount
    var segmentStart = openIndex + 1
    var cursor = segmentStart
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    var pendingOwnerTokens: int32[]
    var pendingSpanStarts: int32[]
    var pendingSpanEnds: int32[]
    while cursor <= closeIndex:
        let atEnd = cursor == closeIndex
        var split = atEnd
        if !atEnd:
            let kind = ParserValueExprTokenKindAt(tree, cursor)
            if kind == ParserValueTokenLeftParen: parenDepth = parenDepth + 1
            elif kind == ParserValueTokenRightParen: parenDepth = parenDepth - 1
            elif kind == ParserValueTokenLeftBracket: bracketDepth = bracketDepth + 1
            elif kind == ParserValueTokenRightBracket: bracketDepth = bracketDepth - 1
            elif kind == ParserValueTokenLeftBrace: braceDepth = braceDepth + 1
            elif kind == ParserValueTokenRightBrace: braceDepth = braceDepth - 1
            elif (kind == ParserValueTokenComma ||
                  kind == ParserValueTokenSemicolon) &&
                 parenDepth == 0 && bracketDepth == 0 && braceDepth == 0:
                split = true
        if split && cursor > segmentStart:
            let assignIndex = ParserValueExprFindTopLevelKind(
                tree,
                segmentStart,
                cursor,
                ParserValueTokenAssign)
            let colonIndex = ParserValueExprFindTopLevelKind(
                tree,
                segmentStart,
                cursor,
                ParserValueTokenColon)
            var ownerToken: int32 = -1
            var currentParameterDeclarationRow: int32 = -1
            for ownerProbe in segmentStart..<cursor:
                if ParserValueExprTokenCanName(
                       ParserValueExprTokenKindAt(tree, ownerProbe)):
                    ownerToken = ownerProbe
                    break
            if colonIndex >= segmentStart:
                var typeLimit = cursor
                if assignIndex >= segmentStart:
                    typeLimit = assignIndex
                if ownerToken < 0 || colonIndex + 1 >= typeLimit:
                    err = "parser type syntax: parameter type owner missing"
                    return false
                if colonIndex + 1 < typeLimit:
                    ParserValueExprAppendRegion(
                        tree,
                        ParserValueExprRegionParamType,
                        ParserValueExprTokenSourceIdAt(tree, colonIndex + 1),
                        ParserValueExprTokenStartAt(tree, colonIndex + 1),
                        ParserValueExprTokenEndAt(tree, typeLimit - 1),
                        colonIndex + 1)
                    for pendingIndex in 0..<pendingOwnerTokens.len:
                        var pendingErr: str
                        if !ParserValueExprAppendTypeSyntaxRootWithGenericSymbols(
                               tree,
                               colonIndex + 1,
                               typeLimit,
                               pendingOwnerTokens[pendingIndex],
                               ParserTypeSyntaxRootFunctionParameter,
                               declarationOwnerTokenIndex,
                               genericSymbolStart,
                               genericSymbolCount,
                               pendingErr):
                            err = pendingErr
                            return false
                        let pendingTypeRoot = tree.typeSyntaxCount - 1
                        ParserValueExprAppendDeclaration(
                            tree,
                            ParserDeclarationParameter,
                            pendingOwnerTokens[pendingIndex],
                            tree.activeFunctionDeclarationRow,
                            tree.activeDeclarationLexicalScopeRow,
                            tree.activeFunctionRow,
                            pendingTypeRoot,
                            pendingSpanStarts[pendingIndex],
                            pendingSpanEnds[pendingIndex],
                            ParserValueExprTypeSyntaxKindAt(
                                tree, pendingTypeRoot) ==
                                ParserTypeSyntaxVarBorrow)
                    var ownerTypeErr: str
                    if !ParserValueExprAppendTypeSyntaxRootWithGenericSymbols(
                           tree,
                           colonIndex + 1,
                           typeLimit,
                           ownerToken,
                           ParserTypeSyntaxRootFunctionParameter,
                           declarationOwnerTokenIndex,
                           genericSymbolStart,
                           genericSymbolCount,
                           ownerTypeErr):
                        err = ownerTypeErr
                        return false
                    let parameterTypeRoot = tree.typeSyntaxCount - 1
                    currentParameterDeclarationRow =
                        ParserValueExprAppendDeclaration(
                        tree,
                        ParserDeclarationParameter,
                        ownerToken,
                        tree.activeFunctionDeclarationRow,
                        tree.activeDeclarationLexicalScopeRow,
                        tree.activeFunctionRow,
                        parameterTypeRoot,
                        segmentStart,
                        cursor,
                        ParserValueExprTypeSyntaxKindAt(
                            tree, parameterTypeRoot) ==
                            ParserTypeSyntaxVarBorrow)
                    setLen(pendingOwnerTokens, 0)
                    setLen(pendingSpanStarts, 0)
                    setLen(pendingSpanEnds, 0)
            elif assignIndex < 0:
                if ownerToken < 0:
                    err = "parser type syntax: untyped parameter owner missing"
                    return false
                add(pendingOwnerTokens, ownerToken)
                add(pendingSpanStarts, segmentStart)
                add(pendingSpanEnds, cursor)
            else:
                if ownerToken < 0:
                    err = "parser declaration: parameter owner missing"
                    return false
                currentParameterDeclarationRow =
                    ParserValueExprAppendDeclaration(
                    tree,
                    ParserDeclarationParameter,
                    ownerToken,
                    tree.activeFunctionDeclarationRow,
                    tree.activeDeclarationLexicalScopeRow,
                    tree.activeFunctionRow,
                    -1,
                    segmentStart,
                    cursor,
                    false)
            if assignIndex >= segmentStart && assignIndex + 1 >= cursor:
                err = "parser value expr: parameter default is empty"
                return false
            if assignIndex >= segmentStart:
                if currentParameterDeclarationRow < 0:
                    err = "parser declaration: parameter default owner missing"
                    return false
                var defaultRoot: int32
                var defaultErr: str
                if !ParserValueExprParseExactRoot(tree,
                                                   assignIndex + 1,
                                                   cursor,
                                                   ParserValueExprStatementParameterDefault,
                                                   assignIndex,
                                                   defaultRoot,
                                                   defaultErr):
                    err = defaultErr
                    return false
                let defaultRootEvent =
                    ParserValueExprNodeDirectStatementRootEventAt(
                        tree, defaultRoot)
                if defaultRootEvent < 0 ||
                   ParserValueExprStatementRootRoleAt(
                       tree, defaultRootEvent) !=
                       ParserValueExprStatementParameterDefault:
                    err = "parser value expr: parameter default root identity missing"
                    return false
                ParserValueExprSetStatementRootDeclarationAuthority(
                    tree,
                    defaultRootEvent,
                    currentParameterDeclarationRow,
                    1)
            segmentStart = cursor + 1
        cursor = cursor + 1
    if pendingOwnerTokens.len > 0:
        err = "parser type syntax: grouped parameter type missing"
        return false
    for declarationRow in parameterDeclarationStart..<tree.declarationCount:
        if ParserDeclarationKind(arenamod.ArenaArrayInt32Get(
               tree.arena, tree.declarationKinds, declarationRow)) ==
               ParserDeclarationParameter:
            var bindingErr: str
            if !ParserValueExprAppendLexicalBinding(
                   tree,
                   declarationRow,
                   -1,
                   ParserLexicalBindingIntroductionParameterList,
                   -1,
                   -1,
                   closeIndex,
                   bindingErr):
                err = bindingErr
                return false
    return true

@borrows
fn ParserValueExprSkipBacktickName(tree: ParserValueExprTree,
                                   cursor: int32,
                                   tokenLimit: int32): int32 =
    # Backtick-quoted operator names (`[]=`, `()`) are tokenized as separate
    # punctuation tokens, and their contents (notably `=` and parens) must
    # never be mistaken for the suite assign or the parameter list.  The
    # ordinary parser treats the whole backtick segment as the name; mirror
    # that here by skipping to the closing backtick.
    if cursor < 0 || cursor >= tokenLimit ||
       ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenBacktick:
        return cursor
    var closeBacktick = cursor + 1
    while closeBacktick < tokenLimit &&
          ParserValueExprTokenKindAt(tree, closeBacktick) !=
              ParserValueTokenBacktick:
        closeBacktick = closeBacktick + 1
    if closeBacktick >= tokenLimit:
        return cursor
    return closeBacktick + 1

# [implicit generic] Ambient type parameters: when a routine header omits
# `typeParamList`, the free single-uppercase names of its parameter and return
# types *are* its type parameters (docs/cheng-formal-spec.md:518-529).  This
# mirrors the C chain's cold_infer_implicit_generic_names
# (bootstrap/cheng_cold.c:5055) and the order it is called in
# (bootstrap/cheng_cold.c:5260-5261): parameters left to right first, the
# return type after them, first appearance wins (spec :524).
#
# Unlike the C chain's raw text scan this walks the parsed type ranges, so a
# parameter *name* is never a candidate (`fn f(Q: float64)` keeps `Q` a value
# parameter) and a parameter default expression is never scanned at all.
# [tg-knife] The candidate is passed as its own name token: the caller no
# longer materializes the name text, and visibility is judged token-vs-token
# over the interned views (same verdict as the previous cloned-string
# comparison against a CloneStrRange copy of the same bytes).
@borrows
fn ParserValueExprImplicitGenericNameDeclared(
        tree: ParserValueExprTree,
        nameToken: int32): bool =
    if nameToken < 0 || nameToken >= tree.tokenCount:
        return false
    for row in 0..<tree.declarationCount:
        let kind = ParserDeclarationKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena, tree.declarationKinds, row))
        if kind != ParserDeclarationType &&
           kind != ParserDeclarationConcept &&
           kind != ParserDeclarationTrait:
            continue
        let declaredNameToken = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationNameTokenIndexes, row)
        if declaredNameToken < 0 || declaredNameToken >= tree.tokenCount:
            continue
        if ParserValueExprNameTokenTextEqualsToken(tree, declaredNameToken,
                                                   nameToken):
            return true
    return false

@borrows
fn ParserValueExprImplicitGenericCollectTypeRangeInto(
        tree: ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        nameTokenIndexes: var int32[],
        err: var str): bool =
    if tokenStart < 0 || tokenLimit < tokenStart ||
       tokenLimit > tree.tokenCount:
        err = Fmt"parser value expr: implicit generic: type range invalid open={tokenStart} close={tokenLimit} tokens={tree.tokenCount}"
        return false
    for cursor in tokenStart..<tokenLimit:
        if !ParserValueExprTokenCanName(
               ParserValueExprTokenKindAt(tree, cursor)):
            continue
        # [tg-knife] single-uppercase test over the borrowed interned view.
        let spanStart = ParserValueExprTokenStartAt(tree, cursor)
        let spanEnd = ParserValueExprTokenEndAt(tree, cursor)
        if spanEnd - spanStart != 1:
            continue
        let code = Int32(langintern.LookupInternBorrowedText(
            tree.internPool,
            ParserValueExprTokenSourceIdAt(tree, cursor))[spanStart])
        if code < 65 || code > 90:
            continue
        # `mod.T` is a qualified name: it denotes a member of another module
        # and can never be a free parameter of this routine (spec :528).
        if cursor > tokenStart &&
           ParserValueExprTokenKindAt(tree, cursor - 1) ==
               ParserValueTokenDot:
            continue
        # A name this source already declares as a type / concept / trait is
        # that declared type, never an ambient parameter (spec :529).
        if ParserValueExprImplicitGenericNameDeclared(tree, cursor):
            continue
        var seen = false
        for prior in 0..<nameTokenIndexes.len:
            if ParserValueExprNameTokenTextEqualsToken(
                   tree, nameTokenIndexes[prior], cursor):
                seen = true
                break
        if seen:
            continue
        add(nameTokenIndexes, cursor)
    err = ""
    return true

@borrows
fn ParserValueExprImplicitGenericCollectParameterTypesInto(
        tree: ParserValueExprTree,
        openIndex: int32,
        closeIndex: int32,
        nameTokenIndexes: var int32[],
        err: var str): bool =
    var segmentStart = openIndex + 1
    var cursor = segmentStart
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    while cursor <= closeIndex:
        let atEnd = cursor == closeIndex
        var split = atEnd
        if !atEnd:
            let kind = ParserValueExprTokenKindAt(tree, cursor)
            if kind == ParserValueTokenLeftParen:
                parenDepth = parenDepth + 1
            elif kind == ParserValueTokenRightParen:
                parenDepth = parenDepth - 1
            elif kind == ParserValueTokenLeftBracket:
                bracketDepth = bracketDepth + 1
            elif kind == ParserValueTokenRightBracket:
                bracketDepth = bracketDepth - 1
            elif kind == ParserValueTokenLeftBrace:
                braceDepth = braceDepth + 1
            elif kind == ParserValueTokenRightBrace:
                braceDepth = braceDepth - 1
            elif (kind == ParserValueTokenComma ||
                  kind == ParserValueTokenSemicolon) &&
                 parenDepth == 0 && bracketDepth == 0 &&
                 braceDepth == 0:
                split = true
        if split && cursor > segmentStart:
            # Same split the parameter parser uses (parser.cheng:22649-22680):
            # a parameter's type is the top-level `:` .. `=` range of its
            # segment, so default expressions stay out of the scan.
            let assignIndex = ParserValueExprFindTopLevelKind(
                tree, segmentStart, cursor, ParserValueTokenAssign)
            let colonIndex = ParserValueExprFindTopLevelKind(
                tree, segmentStart, cursor, ParserValueTokenColon)
            if colonIndex >= segmentStart:
                var typeLimit = cursor
                if assignIndex >= segmentStart:
                    typeLimit = assignIndex
                if colonIndex + 1 < typeLimit &&
                   !ParserValueExprImplicitGenericCollectTypeRangeInto(
                       tree,
                       colonIndex + 1,
                       typeLimit,
                       nameTokenIndexes,
                       err):
                    return false
        if split:
            segmentStart = cursor + 1
        cursor = cursor + 1
    err = ""
    return true

# The one fact this scan refuses to guess at -- a return type token window that
# left the routine's own signature -- is judged *before* the first symbol row is
# appended, so a failure leaves tree.typeGenericSymbolCount and every generic
# CSR column untouched.
fn ParserValueExprInferRoutineImplicitGenericSymbols(
        tree: var ParserValueExprTree,
        routineOwnerTokenIndex: int32,
        parameterOpenIndex: int32,
        parameterCloseIndex: int32,
        returnTypeStart: int32,
        returnTypeLimit: int32,
        symbolStartOut: var int32,
        symbolCountOut: var int32,
        err: var str): bool =
    symbolStartOut = -1
    symbolCountOut = 0
    if routineOwnerTokenIndex < 0 ||
       routineOwnerTokenIndex >= tree.tokenCount ||
       parameterOpenIndex < 0 ||
       parameterCloseIndex <= parameterOpenIndex ||
       parameterCloseIndex >= tree.tokenCount:
        err = "parser type syntax: routine implicit generic range invalid"
        return false
    # [hard fail] The return type window is a token range this routine only
    # borrows; a limit outside the token stream would let the scan read tokens
    # that are not part of this signature.  Judged before the first symbol row
    # is appended.
    if returnTypeStart < 0 || returnTypeLimit < returnTypeStart ||
       returnTypeLimit > tree.tokenCount:
        err = Fmt"parser value expr: implicit generic: routine return type range invalid name_token={routineOwnerTokenIndex} open={parameterOpenIndex} close={parameterCloseIndex} limit={returnTypeLimit} tokens={tree.tokenCount}"
        return false
    var nameTokenIndexes: int32[]
    if !ParserValueExprImplicitGenericCollectParameterTypesInto(
           tree,
           parameterOpenIndex,
           parameterCloseIndex,
           nameTokenIndexes,
           err):
        return false
    if returnTypeStart < returnTypeLimit &&
       !ParserValueExprImplicitGenericCollectTypeRangeInto(
           tree,
           returnTypeStart,
           returnTypeLimit,
           nameTokenIndexes,
           err):
        return false
    if nameTokenIndexes.len <= 0:
        err = ""
        return true
    return ParserValueExprAppendImplicitGenericSymbols(
        tree,
        routineOwnerTokenIndex,
        nameTokenIndexes,
        0,
        symbolStartOut,
        symbolCountOut,
        err)

fn ParserValueExprProcessRoutineRange(tree: var ParserValueExprTree,
                                        tokenStart: int32,
                                        tokenLimit: int32,
                                        bodilessImportcAllowed: bool,
                                        err: var str): bool =
    var cursor = tokenStart
    if cursor < tokenLimit &&
       ParserValueExprTokenKindAt(tree, cursor) == ParserValueTokenAsync:
        cursor = cursor + 1
    var routineKeyword = ParserValueTokenInvalid
    if cursor < tokenLimit &&
       (ParserValueExprTokenKindAt(tree, cursor) == ParserValueTokenFn ||
        ParserValueExprTokenKindAt(tree, cursor) ==
            ParserValueTokenIterator ||
        ParserValueExprTokenKindAt(tree, cursor) == ParserValueTokenMacro ||
        ParserValueExprTokenKindAt(tree, cursor) ==
            ParserValueTokenTemplate):
        routineKeyword = ParserValueExprTokenKindAt(tree, cursor)
        cursor = cursor + 1
    let routineOwnerTokenIndex = cursor
    cursor = ParserValueExprSkipBacktickName(tree, cursor, tokenLimit)
    let openIndex = ParserValueExprFindTopLevelKind(
        tree,
        cursor,
        tokenLimit,
        ParserValueTokenLeftParen)
    if openIndex < 0:
        err = "parser value expr: routine parameter event missing"
        return false
    if openIndex > cursor + 1:
        ParserValueExprAppendRegion(
            tree,
            ParserValueExprRegionTypeParamList,
            ParserValueExprTokenSourceIdAt(tree, cursor + 1),
            ParserValueExprTokenStartAt(tree, cursor + 1),
            ParserValueExprTokenEndAt(tree, openIndex - 1),
            cursor + 1)
    let closeIndex = ParserValueExprFindMatchingToken(
        tree,
        openIndex,
        tokenLimit,
        ParserValueTokenLeftParen,
        ParserValueTokenRightParen)
    if closeIndex < 0:
        err = "parser value expr: routine parameter event unterminated"
        return false
    let previousFunctionDeclarationRow = tree.activeFunctionDeclarationRow
    let previousFunctionRow = tree.activeFunctionRow
    let previousScopeRow = tree.activeDeclarationLexicalScopeRow
    let declarationOwner = ParserValueExprActiveDeclarationOwner(tree)
    let functionRow = tree.declarationFunctionCount
    tree.declarationFunctionCount = tree.declarationFunctionCount + 1
    let functionDeclarationRow = ParserValueExprAppendDeclaration(
        tree,
        ParserDeclarationFunction,
        routineOwnerTokenIndex,
        declarationOwner,
        tree.activeDeclarationLexicalScopeRow,
        functionRow,
        -1,
        tokenStart,
        tokenLimit,
        false)
    tree.activeFunctionDeclarationRow = functionDeclarationRow
    tree.activeFunctionRow = functionRow
    let functionScopeRow =
        ParserValueExprAppendDeclarationLexicalScope(
            tree,
            ParserDeclarationLexicalScopeFunction,
            previousScopeRow,
            functionDeclarationRow)
    tree.activeDeclarationLexicalScopeRow = functionScopeRow
    ParserValueExprSetDeclarationLexicalScopeSpanTokens(
        tree, functionScopeRow, tokenStart, tokenLimit)
    # The return type window is resolved here, before the generic window is
    # fixed, because implicit inference has to scan it; the statements below
    # that consume these three values are unchanged.
    let assignIndex = ParserValueExprFindTopLevelKind(
        tree,
        closeIndex + 1,
        tokenLimit,
        ParserValueTokenAssign)
    var whereIndex: int32 = -1
    if assignIndex >= 0:
        whereIndex = ParserValueExprFindTopLevelKind(
            tree,
            closeIndex + 1,
            assignIndex,
            ParserValueTokenWhere)
    var returnTypeLimit = assignIndex
    if whereIndex >= 0:
        returnTypeLimit = whereIndex
    var genericSymbolStart: int32 = -1
    # Explicit zero: the implicit inference below runs only while this count is
    # still zero, so the value must not rest on the implicit scalar default.
    # The default is specified (cheng-formal-spec.md:594 forbids the redundant
    # `= 0` on a typed let/var), so this is hardening of a fragile point, not a
    # bug fix.
    var genericSymbolCount: int32
    var genericOpen = routineOwnerTokenIndex + 1
    if ParserValueExprTokenKindAt(tree, routineOwnerTokenIndex) ==
           ParserValueTokenBacktick:
        genericOpen = cursor
    if genericOpen < openIndex &&
       ParserValueExprTokenKindAt(tree, genericOpen) ==
           ParserValueTokenLeftBracket:
        let genericClose = ParserValueExprFindMatchingToken(
            tree,
            genericOpen,
            openIndex,
            ParserValueTokenLeftBracket,
            ParserValueTokenRightBracket)
        if genericClose < 0 || genericClose + 1 != openIndex ||
           !ParserValueExprAppendDeclarationGenericSymbols(
               tree,
               routineOwnerTokenIndex,
               genericOpen,
               genericClose,
               genericSymbolStart,
               genericSymbolCount,
               err):
            if err == "":
                err = "parser type syntax: routine generic declaration invalid"
            return false
    # `genericSymbolCount` is still zero exactly when the header carried no
    # `typeParamList` -- the trigger condition of cheng-formal-spec.md:522.  A
    # routine that is about to fail with "routine suite assignment missing" is
    # left alone so that its own diagnostic survives.
    if genericSymbolCount <= 0 && (assignIndex >= 0 || bodilessImportcAllowed):
        var implicitReturnLimit = returnTypeLimit
        if assignIndex < 0:
            implicitReturnLimit = tokenLimit
        if !ParserValueExprInferRoutineImplicitGenericSymbols(
               tree,
               routineOwnerTokenIndex,
               openIndex,
               closeIndex,
               closeIndex + 1,
               implicitReturnLimit,
               genericSymbolStart,
               genericSymbolCount,
               err):
            return false
    if genericSymbolCount > 0:
        ParserValueExprSetDeclarationGenericSymbols(
            tree,
            functionDeclarationRow,
            genericSymbolStart,
            genericSymbolCount)
    if !ParserValueExprParseParameterDefaults(tree,
                                               openIndex,
                                               closeIndex,
                                               routineOwnerTokenIndex,
                                               genericSymbolStart,
                                               genericSymbolCount,
                                               err):
        return false
    if assignIndex < 0:
        # An @importc routine declaration carries a signature but no suite
        # (and no `=`); it is only legal when the statement loop witnessed a
        # preceding @importc annotation line.  A normal routine missing `=`
        # stays a hard error.
        if !bodilessImportcAllowed:
            err = "parser value expr: routine suite assignment missing"
            return false
        if closeIndex + 1 < tokenLimit:
            ParserValueExprAppendRegion(
                tree,
                ParserValueExprRegionReturnType,
                ParserValueExprTokenSourceIdAt(tree, closeIndex + 1),
                ParserValueExprTokenStartAt(tree, closeIndex + 1),
                ParserValueExprTokenEndAt(tree, tokenLimit - 1),
                closeIndex + 1)
            if !ParserValueExprAppendTypeSyntaxRootWithGenericSymbols(
                   tree,
                   closeIndex + 1,
                   tokenLimit,
                   routineOwnerTokenIndex,
                   ParserTypeSyntaxRootFunctionReturn,
                   routineOwnerTokenIndex,
                   genericSymbolStart,
                   genericSymbolCount,
                   err):
                return false
        tree.activeFunctionDeclarationRow = previousFunctionDeclarationRow
        tree.activeFunctionRow = previousFunctionRow
        tree.activeDeclarationLexicalScopeRow = previousScopeRow
        return true
    if closeIndex + 1 < returnTypeLimit:
        ParserValueExprAppendRegion(
            tree,
            ParserValueExprRegionReturnType,
            ParserValueExprTokenSourceIdAt(tree, closeIndex + 1),
            ParserValueExprTokenStartAt(tree, closeIndex + 1),
            ParserValueExprTokenEndAt(tree, returnTypeLimit - 1),
            closeIndex + 1)
        if !ParserValueExprAppendTypeSyntaxRootWithGenericSymbols(
               tree,
               closeIndex + 1,
               returnTypeLimit,
               routineOwnerTokenIndex,
               ParserTypeSyntaxRootFunctionReturn,
               routineOwnerTokenIndex,
               genericSymbolStart,
               genericSymbolCount,
               err):
            return false
    if whereIndex >= 0 && whereIndex + 1 < assignIndex:
        var whereRoot: int32
        if !ParserValueExprParseExactRoot(tree,
                                           whereIndex + 1,
                                           assignIndex,
                                           ParserValueExprStatementWhereCondition,
                                           whereIndex,
                                           whereRoot,
                                           err):
            return false
    if assignIndex + 1 < tokenLimit:
        let suiteStart = assignIndex + 1
        ParserValueExprSetDeclarationSuiteLexicalScope(
            tree, functionDeclarationRow, functionScopeRow)
        let statementRootStart = tree.statementRootCount
        var templateBodyRow: int32 = -1
        if routineKeyword == ParserValueTokenTemplate:
            let bodyLineLimit = ParserValueExprLogicalLineEnd(
                tree, suiteStart, tokenLimit)
            let bodyStatementArm = parserForwardingStatementCoreArm(
                tree, suiteStart, tokenLimit, -1)
            let templateBodyArm =
                bodyLineLimit == tokenLimit && bodyStatementArm == 21 ?
                    1 : 0
            templateBodyRow = parserForwardingProductionBegin(
                tree,
                ParserForwardingProductionTemplateBody,
                templateBodyArm,
                suiteStart,
                suiteStart,
                tokenLimit - 1)
        if !ParserValueExprProcessSuiteRange(tree,
                                              suiteStart,
                                              tokenLimit,
                                              err):
            return false
        if templateBodyRow >= 0:
            parserForwardingProductionFinish(
                tree,
                templateBodyRow,
                ParserForwardingProductionChildInvalid,
                -1,
                -1,
                0)
        # Cheng functions return their final top-level bare expression.  Mark
        # that parser-owned root here, while routine boundaries and indentation
        # are still exact; later phases must not rediscover it from source text.
        let bodyColumn = ParserValueExprTokenColumnAt(tree, suiteStart)
        var lastTopLevelStatementStart: int32 = -1
        var statementCursor = suiteStart
        while statementCursor < tokenLimit:
            let statementLimit = ParserValueExprLogicalLineEnd(
                tree, statementCursor, tokenLimit)
            if statementLimit <= statementCursor:
                panic("parser value expr: routine suite scan made no progress")
            if ParserValueExprTokenColumnAt(tree, statementCursor) ==
                   bodyColumn:
                lastTopLevelStatementStart = statementCursor
            statementCursor = statementLimit
        let routineHasImplicitReturn =
            routineKeyword == ParserValueTokenInvalid ||
            routineKeyword == ParserValueTokenFn
        if routineHasImplicitReturn && lastTopLevelStatementStart >= 0:
            let sourceId = ParserValueExprTokenSourceIdAt(
                tree, lastTopLevelStatementStart)
            let spanStart = ParserValueExprTokenStartAt(
                tree, lastTopLevelStatementStart)
            var implicitRootEvent: int32 = -1
            for rootEvent in statementRootStart..<tree.statementRootCount:
                if ParserValueExprStatementRootRoleAt(tree, rootEvent) !=
                       ParserValueExprStatementExpression:
                    continue
                let rootNode = ParserValueExprStatementRootNodeAt(
                    tree, rootEvent)
                if ParserValueExprNodeSourceIdAt(tree, rootNode) != sourceId ||
                   ParserValueExprNodeSpanStartAt(tree, rootNode) != spanStart:
                    continue
                if implicitRootEvent >= 0:
                    panic("parser value expr: duplicate routine implicit return root")
                implicitRootEvent = rootEvent
            if implicitRootEvent >= 0:
                ParserValueExprSetStatementRootRole(
                    tree,
                    implicitRootEvent,
                    ParserValueExprStatementImplicitReturnValue)
        tree.activeFunctionDeclarationRow = previousFunctionDeclarationRow
        tree.activeFunctionRow = previousFunctionRow
        tree.activeDeclarationLexicalScopeRow = previousScopeRow
        return true
    err = ParserValueExprAdmissionDiagnostic(
        tree,
        assignIndex,
        "PARSER_EMPTY_SUITE_FORBIDDEN")
    tree.activeFunctionDeclarationRow = previousFunctionDeclarationRow
    tree.activeFunctionRow = previousFunctionRow
    tree.activeDeclarationLexicalScopeRow = previousScopeRow
    return false

@borrows
fn ParserValueExprMigrationElseIfSpanAt(
        tree: ParserValueExprTree,
        elseTokenIndex: int32,
        tokenLimit: int32,
        spanStartOut: var int32,
        spanEndOut: var int32): bool =
    spanStartOut = -1
    spanEndOut = -1
    let ifTokenIndex = elseTokenIndex + 1
    let conditionTokenIndex = ifTokenIndex + 1
    if tree == nil ||
       elseTokenIndex < 0 ||
       conditionTokenIndex >= tokenLimit ||
       tokenLimit > tree.tokenCount ||
       ParserValueExprTokenKindAt(tree, elseTokenIndex) !=
           ParserValueTokenElse ||
       ParserValueExprTokenKindAt(tree, ifTokenIndex) !=
           ParserValueTokenIf:
        return false
    let sourceId = ParserValueExprTokenSourceIdAt(tree, elseTokenIndex)
    if ParserValueExprTokenSourceIdAt(tree, ifTokenIndex) != sourceId ||
       ParserValueExprTokenSourceIdAt(tree, conditionTokenIndex) != sourceId:
        return false
    let lineNumber = ParserValueExprTokenLineAt(tree, elseTokenIndex)
    if ParserValueExprTokenLineAt(tree, ifTokenIndex) != lineNumber ||
       ParserValueExprTokenLineAt(tree, conditionTokenIndex) != lineNumber:
        return false
    let elseStart = ParserValueExprTokenStartAt(tree, elseTokenIndex)
    let elseEnd = ParserValueExprTokenEndAt(tree, elseTokenIndex)
    let ifStart = ParserValueExprTokenStartAt(tree, ifTokenIndex)
    let ifEnd = ParserValueExprTokenEndAt(tree, ifTokenIndex)
    let conditionStart = ParserValueExprTokenStartAt(
        tree,
        conditionTokenIndex)
    let source = ParserValueExprSourceText(tree, sourceId)
    if elseStart < 0 || elseEnd != elseStart + Len("else") ||
       ifStart <= elseEnd || ifEnd != ifStart + Len("if") ||
       conditionStart <= ifEnd || conditionStart > source.len ||
       !ParserTextRangeEquals(source,
                              elseStart,
                              Len("else"),
                              "else") ||
       !ParserTextRangeEquals(source,
                              ifStart,
                              Len("if"),
                              "if"):
        return false
    for byteIndex in elseEnd..<ifStart:
        if !ParserIsInlineSpace(source[byteIndex]):
            return false
    for byteIndex in ifEnd..<conditionStart:
        if !ParserIsInlineSpace(source[byteIndex]):
            return false
    spanStartOut = elseStart
    spanEndOut = ifEnd
    return true

fn ParserValueExprProcessConditionalStatement(tree: var ParserValueExprTree,
                                                 tokenStart: int32,
                                                 tokenLimit: int32,
                                                 err: var str): bool =
    var cursor = tokenStart
    while cursor < tokenLimit:
        let branchTokenIndex = cursor
        var branchKind = ParserValueExprTokenKindAt(tree, cursor)
        if branchKind == ParserValueTokenElse:
            var migrationSpanStart: int32
            var migrationSpanEnd: int32
            if tree.migrationSourceSyntax &&
               ParserValueExprMigrationElseIfSpanAt(
                   tree,
                   cursor,
                   tokenLimit,
                   migrationSpanStart,
                   migrationSpanEnd):
                cursor = cursor + 1
                branchKind = ParserValueTokenElif
            else:
                cursor = cursor + 1
                if cursor >= tokenLimit ||
                   ParserValueExprTokenKindAt(tree, cursor) !=
                       ParserValueTokenColon:
                    err = "parser value expr: statement else separator missing"
                    return false
                cursor = cursor + 1
                if cursor < tokenLimit:
                    return ParserValueExprProcessSuiteRange(tree,
                                                            cursor,
                                                            tokenLimit,
                                                            err)
                err = ParserValueExprAdmissionDiagnostic(
                    tree,
                    cursor - 1,
                    "PARSER_EMPTY_SUITE_FORBIDDEN")
                return false
        if branchKind != ParserValueTokenIf &&
           branchKind != ParserValueTokenWhen &&
           branchKind != ParserValueTokenElif:
            err = "parser value expr: conditional statement branch missing"
            return false
        cursor = cursor + 1
        var conditionRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            tokenLimit,
                                            0,
                                            conditionRoot,
                                            err):
            return false
        ParserValueExprAppendStatementRoot(
            tree,
            conditionRoot,
            ParserValueExprStatementCondition,
            branchTokenIndex,
            ParserValueExprStatementEndTokenFor(
                tree,
                conditionRoot,
                branchTokenIndex,
                cursor - 1))
        if cursor >= tokenLimit ||
           ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenColon:
            err = "parser value expr: conditional statement separator missing"
            return false
        cursor = cursor + 1
        let nextBranch = ParserValueExprFindTopLevelBranch(
            tree, cursor, tokenLimit, branchTokenIndex)
        let suiteLimit = if nextBranch >= 0: nextBranch else: tokenLimit
        if cursor >= suiteLimit:
            err = ParserValueExprAdmissionDiagnostic(
                tree,
                cursor - 1,
                "PARSER_EMPTY_SUITE_FORBIDDEN")
            return false
        if !ParserValueExprProcessSuiteRange(tree,
                                             cursor,
                                             suiteLimit,
                                             err):
            return false
        if nextBranch < 0:
            return true
        cursor = nextBranch
    return true

@borrows
fn ParserValueExprTypeDefaultLimit(tree: ParserValueExprTree,
                                     tokenStart: int32,
                                     tokenLimit: int32,
                                     baseParenDepth: int32,
                                     baseBracketDepth: int32,
                                     baseBraceDepth: int32): int32 =
    var parenDepth = baseParenDepth
    var bracketDepth = baseBracketDepth
    var braceDepth = baseBraceDepth
    var cursor = tokenStart
    while cursor < tokenLimit:
        let kind = ParserValueExprTokenKindAt(tree, cursor)
        if (kind == ParserValueTokenComma ||
            kind == ParserValueTokenSemicolon) &&
           parenDepth == baseParenDepth &&
           bracketDepth == baseBracketDepth &&
           braceDepth == baseBraceDepth:
            return cursor
        if kind == ParserValueTokenRightParen &&
           parenDepth == baseParenDepth:
            return cursor
        if kind == ParserValueTokenRightBracket &&
           bracketDepth == baseBracketDepth:
            return cursor
        if kind == ParserValueTokenRightBrace &&
           braceDepth == baseBraceDepth:
            return cursor
        if kind == ParserValueTokenLeftParen: parenDepth = parenDepth + 1
        elif kind == ParserValueTokenRightParen: parenDepth = parenDepth - 1
        elif kind == ParserValueTokenLeftBracket:
            bracketDepth = bracketDepth + 1
        elif kind == ParserValueTokenRightBracket:
            bracketDepth = bracketDepth - 1
        elif kind == ParserValueTokenLeftBrace: braceDepth = braceDepth + 1
        elif kind == ParserValueTokenRightBrace: braceDepth = braceDepth - 1
        cursor = cursor + 1
    return tokenLimit

# A type declaration has one structural `=` between the declared name and its
# type expression.  Every later `=` belongs to a value-bearing field, tuple
# element, enum member, variant payload, or proc-type parameter.  Parse those
# RHS ranges with the same value parser; never treat the whole type expression
# as value text.
fn ParserValueExprAppendEnumVariantSegmentInto(
        tree: var ParserValueExprTree,
        declarationRoot: int32,
        tokenStart: int32,
        tokenLimit: int32,
        err: var str): bool =
    if tokenStart >= tokenLimit ||
       !ParserValueExprTokenCanName(
           ParserValueExprTokenKindAt(tree, tokenStart)):
        err = "parser type syntax: enum variant name missing"
        return false
    if tokenStart + 1 < tokenLimit:
        if ParserValueExprTokenKindAt(tree, tokenStart + 1) !=
               ParserValueTokenAssign ||
           tokenStart + 2 >= tokenLimit:
            err = "parser type syntax: enum variant trailing syntax invalid"
            return false
    return ParserValueExprAppendEnumVariantInto(
        tree, declarationRoot, tokenStart, -1, err)

fn ParserValueExprAppendEnumVariantsRangeInto(
        tree: var ParserValueExprTree,
        declarationRoot: int32,
        tokenStart: int32,
        tokenLimit: int32,
        err: var str): bool =
    if tokenStart >= tokenLimit:
        err = "parser type syntax: enum variant range missing"
        return false
    var segmentStart = tokenStart
    var cursor = tokenStart
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    while cursor <= tokenLimit:
        let atEnd = cursor == tokenLimit
        var split = atEnd
        var commaSplit = false
        if !atEnd:
            let kind = ParserValueExprTokenKindAt(tree, cursor)
            if cursor > segmentStart && parenDepth == 0 &&
               bracketDepth == 0 && braceDepth == 0 &&
               ParserValueExprTokenLineAt(tree, cursor) >
                   ParserValueExprTokenLineAt(tree, cursor - 1):
                split = true
            elif kind == ParserValueTokenComma && parenDepth == 0 &&
                 bracketDepth == 0 && braceDepth == 0:
                split = true
                commaSplit = true
            if !split:
                if kind == ParserValueTokenLeftParen:
                    parenDepth = parenDepth + 1
                elif kind == ParserValueTokenRightParen:
                    parenDepth = parenDepth - 1
                elif kind == ParserValueTokenLeftBracket:
                    bracketDepth = bracketDepth + 1
                elif kind == ParserValueTokenRightBracket:
                    bracketDepth = bracketDepth - 1
                elif kind == ParserValueTokenLeftBrace:
                    braceDepth = braceDepth + 1
                elif kind == ParserValueTokenRightBrace:
                    braceDepth = braceDepth - 1
        if parenDepth < 0 || bracketDepth < 0 || braceDepth < 0:
            err = "parser type syntax: enum variant delimiters invalid"
            return false
        if split:
            if cursor <= segmentStart ||
               !ParserValueExprAppendEnumVariantSegmentInto(
                   tree,
                   declarationRoot,
                   segmentStart,
                   cursor,
                   err):
                if err == "":
                    err = "parser type syntax: empty enum variant"
                return false
            if atEnd:
                break
            if commaSplit:
                segmentStart = cursor + 1
                if segmentStart >= tokenLimit:
                    err = "parser type syntax: trailing enum variant comma"
                    return false
                cursor = segmentStart
                continue
            segmentStart = cursor
            continue
        cursor = cursor + 1
    if parenDepth != 0 || bracketDepth != 0 || braceDepth != 0:
        err = "parser type syntax: enum variant delimiters unbalanced"
        return false
    return true

# [phaseB-parser] 入口文件字段精确坐标绑定链的 inline 元素补齐：
# `type N = tuple[a: T, ...]` 的每个具名元素与 object 缩进字段同构——
# 一个 FieldDeclaration type-syntax root（把元素类型 span 重新解析为独立
# root，declarationOwner 精确指回该类型声明根）+ 一条 ParserDeclarationField
# 声明行（owner=类型声明行、scope=该类型的 Type 词法域）。此前 tuple 内联
# 元素在声明流中无声明行，compiler csg 的 exact-layout parser identity
# 绑定无坐标可绑，命名构造 Pair(x: ...) 必挂 unknown object constructor
# field（object 缩进字段同形同墙的决定性对照见 VERIFY_phaseb_a r3）。
# 无名元素（tuple[int32, str]）不产字段声明行；元素默认值仍由
# tupleElem 的 type-syntax 通道承载，不在本臂展开。
fn ParserValueExprAppendInlineTupleFieldDeclarations(
        tree: var ParserValueExprTree,
        declarationRoot: int32,
        typeDeclarationRow: int32,
        declarationTokenStart: int32,
        declarationTokenLimit: int32,
        err: var str): bool =
    let previousScopeRow = tree.activeDeclarationLexicalScopeRow
    let typeScopeRow =
        ParserValueExprAppendDeclarationLexicalScope(
            tree,
            ParserDeclarationLexicalScopeType,
            previousScopeRow,
            typeDeclarationRow)
    tree.activeDeclarationLexicalScopeRow = typeScopeRow
    ParserValueExprFinalizeTypeDeclarationLexicalScope(
        tree,
        typeScopeRow,
        typeDeclarationRow,
        declarationTokenStart,
        declarationTokenLimit)
    let tupleNode = ParserValueExprTypeSyntaxChildAt(
        tree, declarationRoot, 0)
    let elementCount = ParserValueExprTypeSyntaxChildCountAt(
        tree, tupleNode)
    var elementOffset = 0
    while elementOffset < elementCount:
        let elementNode = ParserValueExprTypeSyntaxChildAt(
            tree, tupleNode, elementOffset)
        elementOffset = elementOffset + 1
        let nameToken = ParserValueExprTypeSyntaxOwnerTokenAt(
            tree, elementNode)
        if nameToken < 0 || nameToken + 1 >= tree.tokenCount ||
           !ParserValueExprTokenCanName(
               ParserValueExprTokenKindAt(tree, nameToken)) ||
           ParserValueExprTokenKindAt(tree, nameToken + 1) !=
               ParserValueTokenColon ||
           ParserValueExprTokenEndAt(tree, nameToken + 1) >
               ParserValueExprTypeSyntaxSpanStartAt(tree, elementNode):
            # 无名元素（tuple[int32, str]）不产字段声明行
            continue
        let typeStartToken = nameToken + 2
        var typeLimitToken = typeStartToken
        while typeLimitToken < tree.tokenCount &&
              ParserValueExprTokenEndAt(tree, typeLimitToken) <
                  ParserValueExprTypeSyntaxSpanEndAt(tree, elementNode):
            typeLimitToken = typeLimitToken + 1
        if typeLimitToken >= tree.tokenCount ||
           ParserValueExprTokenEndAt(tree, typeLimitToken) !=
               ParserValueExprTypeSyntaxSpanEndAt(tree, elementNode):
            tree.activeDeclarationLexicalScopeRow = previousScopeRow
            err = "parser type syntax: tuple element type span invalid"
            return false
        var fieldRoot: int32
        if !ParserValueExprAppendTypeSyntaxRootInto(
               tree,
               typeStartToken,
               typeLimitToken + 1,
               nameToken,
               ParserTypeSyntaxRootFieldDeclaration,
               false,
               declarationRoot,
               -1,
               fieldRoot,
               err):
            tree.activeDeclarationLexicalScopeRow = previousScopeRow
            return false
        let ownerGenericCount =
            ParserValueExprTypeSyntaxGenericSymbolCountAt(
                tree, declarationRoot)
        if ownerGenericCount > 0:
            ParserValueExprTypeSyntaxSetGenericSymbols(
                tree,
                fieldRoot,
                ParserValueExprTypeSyntaxGenericSymbolStartAt(
                    tree, declarationRoot),
                ownerGenericCount)
        let fieldRow = ParserValueExprAppendDeclaration(
            tree,
            ParserDeclarationField,
            nameToken,
            typeDeclarationRow,
            typeScopeRow,
            -1,
            fieldRoot,
            nameToken,
            typeLimitToken + 1,
            false)
        if fieldRow <= typeDeclarationRow:
            tree.activeDeclarationLexicalScopeRow = previousScopeRow
            err = "parser declaration: tuple element field row invalid"
            return false
    tree.activeDeclarationLexicalScopeRow = previousScopeRow
    err = ""
    return true

fn ParserValueExprProcessTypeDeclarationRangeInto(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        fieldDeclarationOwnerNodeIndex: int32,
        declarationRootOut: var int32,
        err: var str): bool =
    declarationRootOut = -1
    let declarationAssign = ParserValueExprFindTopLevelKind(
        tree, tokenStart, tokenLimit, ParserValueTokenAssign)
    if declarationAssign < 0:
        return true
    var rhsLimit = tokenLimit
    if rhsLimit > declarationAssign + 1 &&
       ParserValueExprTokenKindAt(tree, rhsLimit - 1) ==
           ParserValueTokenColon:
        rhsLimit = rhsLimit - 1
    let declarationColon = ParserValueExprFindTopLevelKind(
        tree, tokenStart, declarationAssign, ParserValueTokenColon)
    var genericSymbolStart: int32 = -1
    var genericSymbolCount: int32
    if declarationColon >= tokenStart:
        if declarationColon == tokenStart ||
           declarationColon + 1 >= declarationAssign:
            err = "parser type syntax: field declaration type missing"
            return false
        ParserValueExprAppendRegion(
            tree,
            ParserValueExprRegionFieldDeclType,
            ParserValueExprTokenSourceIdAt(tree, declarationColon + 1),
            ParserValueExprTokenStartAt(tree, declarationColon + 1),
            ParserValueExprTokenEndAt(tree, declarationAssign - 1),
            declarationColon + 1)
        var fieldRoot: int32
        if !ParserValueExprAppendTypeSyntaxRootInto(
               tree,
               declarationColon + 1,
               declarationAssign,
               tokenStart,
               ParserTypeSyntaxRootFieldDeclaration,
               false,
               fieldDeclarationOwnerNodeIndex,
               -1,
               fieldRoot,
               err):
            return false
        declarationRootOut = fieldRoot
        let ownerGenericCount =
            ParserValueExprTypeSyntaxGenericSymbolCountAt(
                tree, fieldDeclarationOwnerNodeIndex)
        if ownerGenericCount > 0:
            ParserValueExprTypeSyntaxSetGenericSymbols(
                tree,
                fieldRoot,
                ParserValueExprTypeSyntaxGenericSymbolStartAt(
                    tree, fieldDeclarationOwnerNodeIndex),
                ownerGenericCount)
    else:
        var declarationOwner = tokenStart
        if ParserValueExprTokenKindAt(tree, tokenStart) ==
               ParserValueTokenType:
            declarationOwner = tokenStart + 1
        if declarationOwner >= declarationAssign:
            err = "parser type syntax: type declaration owner missing"
            return false
        if fieldDeclarationOwnerNodeIndex >= 0:
            err = "parser type syntax: type declaration has field owner"
            return false
        let genericOpen = declarationOwner + 1
        if genericOpen < declarationAssign &&
           ParserValueExprTokenKindAt(tree, genericOpen) ==
               ParserValueTokenLeftBracket:
            let genericClose = ParserValueExprFindMatchingToken(
                tree,
                genericOpen,
                declarationAssign,
                ParserValueTokenLeftBracket,
                ParserValueTokenRightBracket)
            if genericClose < 0 || genericClose + 1 != declarationAssign ||
               !ParserValueExprAppendDeclarationGenericSymbols(
                   tree,
                   declarationOwner,
                   genericOpen,
                   genericClose,
                   genericSymbolStart,
                   genericSymbolCount,
                   err):
                if err == "":
                    err = "parser type syntax: type generic declaration invalid"
                return false
        if declarationAssign + 1 >= rhsLimit:
            declarationRootOut = ParserValueExprAppendTypeSyntaxNode(
                tree,
                ParserTypeSyntaxImplicitObject,
                declarationOwner,
                declarationOwner + 1,
                declarationOwner,
                declarationOwner,
                -1,
                [],
                ParserTypeSyntaxRootInvalid)
            ParserValueExprTypeSyntaxSetRootKind(
                tree,
                declarationRootOut,
                ParserTypeSyntaxRootTypeDeclarationRhs)
            ParserValueExprTypeSyntaxSetDeclarationOwner(
                tree, declarationRootOut, declarationRootOut)
            ParserValueExprTypeSyntaxSetDeclarationOwnerToken(
                tree, declarationRootOut, declarationOwner)
        else:
            ParserValueExprAppendRegion(
                tree,
                ParserValueExprRegionTypeExprText,
                ParserValueExprTokenSourceIdAt(tree, declarationAssign + 1),
                ParserValueExprTokenStartAt(tree, declarationAssign + 1),
                ParserValueExprTokenEndAt(tree, rhsLimit - 1),
                declarationAssign + 1)
            if !ParserValueExprAppendTypeSyntaxRootInto(
                   tree,
                   declarationAssign + 1,
                   rhsLimit,
                   declarationOwner,
                   ParserTypeSyntaxRootTypeDeclarationRhs,
                   true,
                   -1,
                   declarationOwner,
                   declarationRootOut,
                   err):
                return false
        if genericSymbolCount > 0:
            ParserValueExprTypeSyntaxSetGenericSymbols(
                tree,
                declarationRootOut,
                genericSymbolStart,
                genericSymbolCount)
    if declarationRootOut >= 0 &&
       ParserValueExprTypeSyntaxKindAt(tree, declarationRootOut) ==
           ParserTypeSyntaxEnum:
        let enumToken = declarationAssign + 1
        if enumToken >= tokenLimit ||
           ParserValueExprTokenKindAt(tree, enumToken) !=
               ParserValueTokenEnum:
            err = "parser type syntax: enum declaration marker missing"
            return false
        var variantStart = enumToken + 1
        if variantStart < tokenLimit &&
           ParserValueExprTokenKindAt(tree, variantStart) ==
               ParserValueTokenColon:
            variantStart = variantStart + 1
        if variantStart < tokenLimit &&
           !ParserValueExprAppendEnumVariantsRangeInto(
               tree,
               declarationRootOut,
               variantStart,
               tokenLimit,
               err):
            return false
    if ParserValueExprTokenKindAt(tree, tokenStart) == ParserValueTokenType:
        # A real `type` header: witness the declaration head and the entire
        # type-expression text after the structural `=`.  Field lines inside a
        # type block also pass through here; they are covered by FieldBlock.
        if declarationAssign > tokenStart:
            ParserValueExprAppendRegion(
                tree,
                ParserValueExprRegionTypeDeclHeader,
                ParserValueExprTokenSourceIdAt(tree, tokenStart),
                ParserValueExprTokenStartAt(tree, tokenStart),
                ParserValueExprTokenEndAt(tree, declarationAssign - 1),
                tokenStart)
    let whereIndex = ParserValueExprFindTopLevelKind(
        tree, tokenStart, declarationAssign, ParserValueTokenWhere)
    if whereIndex >= 0 && whereIndex + 1 < declarationAssign:
        var whereRoot: int32
        if !ParserValueExprParseExactRoot(tree,
                                           whereIndex + 1,
                                           declarationAssign,
                                           ParserValueExprStatementWhereCondition,
                                           whereIndex,
                                           whereRoot,
                                           err):
            return false
    let defaultRootEventStart = tree.statementRootCount
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    var cursor = declarationAssign + 1
    while cursor < tokenLimit:
        let kind = ParserValueExprTokenKindAt(tree, cursor)
        if kind == ParserValueTokenLeftParen:
            parenDepth = parenDepth + 1
        elif kind == ParserValueTokenRightParen:
            parenDepth = parenDepth - 1
        elif kind == ParserValueTokenLeftBracket:
            bracketDepth = bracketDepth + 1
        elif kind == ParserValueTokenRightBracket:
            bracketDepth = bracketDepth - 1
        elif kind == ParserValueTokenLeftBrace:
            braceDepth = braceDepth + 1
        elif kind == ParserValueTokenRightBrace:
            braceDepth = braceDepth - 1
        elif kind == ParserValueTokenAssign:
            let valueStart = cursor + 1
            if valueStart >= tokenLimit:
                err = "parser value expr: type value default missing"
                return false
            let valueLimit = ParserValueExprTypeDefaultLimit(
                tree,
                valueStart,
                tokenLimit,
                parenDepth,
                bracketDepth,
                braceDepth)
            if valueLimit <= valueStart:
                err = "parser value expr: empty type value default"
                return false
            var defaultRoot: int32
            if !ParserValueExprParseExactRoot(tree,
                                               valueStart,
                                               valueLimit,
                                               ParserValueExprStatementTypeDefault,
                                               cursor,
                                               defaultRoot,
                                               err):
                return false
            cursor = valueLimit
            continue
        if parenDepth < 0 || bracketDepth < 0 || braceDepth < 0:
            err = "parser value expr: unbalanced type declaration"
            return false
        cursor = cursor + 1
    if parenDepth != 0 || bracketDepth != 0 || braceDepth != 0:
        return false
    var declarationRow: int32
    if declarationColon >= tokenStart:
        if tree.activeTypeDeclarationRow < 0:
            err = "parser declaration: field declaration owner missing"
            return false
        declarationRow = ParserValueExprAppendDeclaration(
            tree,
            ParserDeclarationField,
            tokenStart,
            tree.activeTypeDeclarationRow,
            tree.activeDeclarationLexicalScopeRow,
            -1,
            declarationRootOut,
            tokenStart,
            tokenLimit,
            false)
    else:
        var declarationOwnerToken = tokenStart
        if ParserValueExprTokenKindAt(tree, tokenStart) ==
               ParserValueTokenType:
            declarationOwnerToken = tokenStart + 1
        let ownerRow = ParserValueExprActiveDeclarationOwner(tree)
        declarationRow = ParserValueExprAppendDeclaration(
            tree,
            ParserDeclarationType,
            declarationOwnerToken,
            ownerRow,
            tree.activeDeclarationLexicalScopeRow,
            -1,
            declarationRootOut,
            tokenStart,
            tokenLimit,
            false)
        if genericSymbolCount > 0:
            ParserValueExprSetDeclarationGenericSymbols(
                tree,
                declarationRow,
                genericSymbolStart,
                genericSymbolCount)
        tree.activeTypeDeclarationRow = declarationRow
        # [phaseB-parser] 内联 tuple 具名元素的字段声明行补齐（见
        # ParserValueExprAppendInlineTupleFieldDeclarations）：仅别名包裹
        # tuple 的声明根进入本臂，object/ref object/enum 声明根走原 body
        # 通道，零改动。
        if ParserValueExprTypeSyntaxAliasDeclarationRootWrapsTuple(
               tree, declarationRootOut):
            if !ParserValueExprAppendInlineTupleFieldDeclarations(
                   tree,
                   declarationRootOut,
                   declarationRow,
                   tokenStart,
                   tokenLimit,
                   err):
                return false
    for defaultRootEvent in defaultRootEventStart..<tree.statementRootCount:
        if ParserValueExprStatementRootRoleAt(
               tree, defaultRootEvent) ==
               ParserValueExprStatementTypeDefault:
            ParserValueExprSetStatementRootDeclarationAuthority(
                tree, defaultRootEvent, declarationRow, 1)
    return true

fn ParserValueExprProcessTypeDeclarationRange(tree: var ParserValueExprTree,
                                                tokenStart: int32,
                                                tokenLimit: int32,
                                                err: var str): bool =
    var ignoredRoot: int32
    return ParserValueExprProcessTypeDeclarationRangeInto(
        tree, tokenStart, tokenLimit, -1, ignoredRoot, err)

fn ParserValueExprProcessTypeBodyRange(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        declarationRoot: int32,
        declarationRow: int32,
        err: var str): bool =
    if tokenStart < 0 || tokenStart >= tokenLimit ||
       tokenLimit > tree.tokenCount || declarationRoot < 0 ||
       declarationRoot >= tree.typeSyntaxCount ||
       declarationRow < 0 || declarationRow >= tree.declarationCount ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationTypeSyntaxRootIndexes,
           declarationRow) != declarationRoot:
        err = "parser type syntax: declaration body authority invalid"
        return false
    let declarationRowKind = ParserDeclarationKind(
        arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationKinds, declarationRow))
    if declarationRowKind != ParserDeclarationType &&
       declarationRowKind != ParserDeclarationField:
        err = "parser type syntax: declaration body owner kind invalid"
        return false
    let declarationRootKind =
        ParserValueExprTypeSyntaxRootKindAt(tree, declarationRoot)
    let declarationOwner =
        ParserValueExprTypeSyntaxDeclarationOwnerAt(
            tree, declarationRoot)
    let declarationKind =
        ParserValueExprTypeSyntaxKindAt(tree, declarationRoot)
    let topLevelBody =
        declarationRootKind == ParserTypeSyntaxRootTypeDeclarationRhs &&
        declarationOwner == declarationRoot &&
        (declarationKind == ParserTypeSyntaxImplicitObject ||
         declarationKind == ParserTypeSyntaxObject ||
         declarationKind == ParserTypeSyntaxRefObject ||
         declarationKind == ParserTypeSyntaxEnum)
    let nestedBody =
        declarationRootKind == ParserTypeSyntaxRootFieldDeclaration &&
        declarationOwner >= 0 &&
        declarationOwner < declarationRoot &&
        (declarationKind == ParserTypeSyntaxObject ||
         declarationKind == ParserTypeSyntaxRefObject)
    if !topLevelBody && !nestedBody:
        err = "parser type syntax: declaration body requires object or enum"
        return false
    if declarationKind == ParserTypeSyntaxEnum:
        let previousScopeRow = tree.activeDeclarationLexicalScopeRow
        let typeScopeRow =
            ParserValueExprAppendDeclarationLexicalScope(
                tree,
                ParserDeclarationLexicalScopeType,
                previousScopeRow,
                declarationRow)
        tree.activeDeclarationLexicalScopeRow = typeScopeRow
        ParserValueExprFinalizeTypeDeclarationLexicalScope(
            tree,
            typeScopeRow,
            declarationRow,
            tokenStart,
            tokenLimit)
        let enumOk = ParserValueExprAppendEnumVariantsRangeInto(
            tree, declarationRoot, tokenStart, tokenLimit, err)
        tree.activeDeclarationLexicalScopeRow = previousScopeRow
        return enumOk
    let previousScopeRow = tree.activeDeclarationLexicalScopeRow
    let typeScopeRow =
        ParserValueExprAppendDeclarationLexicalScope(
            tree,
            ParserDeclarationLexicalScopeType,
            previousScopeRow,
            declarationRow)
    tree.activeDeclarationLexicalScopeRow = typeScopeRow
    ParserValueExprFinalizeTypeDeclarationLexicalScope(
        tree,
        typeScopeRow,
        declarationRow,
        tokenStart,
        tokenLimit)
    var cursor = tokenStart
    while cursor < tokenLimit:
        let lineLimit = ParserValueExprLogicalLineEnd(
            tree, cursor, tokenLimit)
        if lineLimit <= cursor:
            err = "parser type syntax: declaration body made no progress"
            return false
        var statementLimit = lineLimit
        var nestedBodyLimit = lineLimit
        var lineHasNestedBody =
            ParserValueExprTokenKindAt(tree, lineLimit - 1) ==
                ParserValueTokenColon
        if lineHasNestedBody:
            # Form-B 字段(类型独占更深缩进行的 `name:` 行, 与例程头 Form-B
            # 同族): 行内仅 名称+冒号 两 token、下一逻辑行更深缩进且无顶层
            # 冒号(即类型表达式而非 `field: T` 字段行)时, 类型行并入字段
            # 语句范围; nested object 体(更深行为字段行)与空体负例维持
            # 既有路径与硬错误, 类型正误交由类型语法解析裁决。
            if lineLimit == cursor + 2 &&
               ParserValueExprTokenCanName(
                   ParserValueExprTokenKindAt(tree, cursor)):
                let typeLineEnd = ParserValueExprLogicalLineEnd(
                    tree, lineLimit, tokenLimit)
                if typeLineEnd > lineLimit &&
                   ParserValueExprTokenColumnAt(tree, lineLimit) >
                       ParserValueExprTokenColumnAt(tree, cursor) &&
                   ParserValueExprFindTopLevelKind(
                       tree, lineLimit, typeLineEnd,
                       ParserValueTokenColon) < 0:
                    statementLimit = typeLineEnd
                    lineHasNestedBody = false
        if lineHasNestedBody:
            nestedBodyLimit = ParserValueExprIndentedSuiteEnd(
                tree,
                lineLimit,
                tokenLimit,
                ParserValueExprTokenColumnAt(tree, cursor))
            if nestedBodyLimit <= lineLimit:
                err = "parser type syntax: nested object body is empty"
                return false
        let declarationStart = tree.declarationCount
        if !ParserValueExprProcessStatementRangeWithTypeOwner(
               tree,
               cursor,
               statementLimit,
               false,
               declarationRoot,
               err):
            err = Fmt"{err} statement_offset={ParserValueExprTokenStartAt(tree, cursor)}"
            return false
        if lineHasNestedBody:
            if tree.declarationCount != declarationStart + 1:
                err = "parser type syntax: nested object field declaration missing"
                return false
            let fieldRoot = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationTypeSyntaxRootIndexes,
                declarationStart)
            if fieldRoot < 0 || fieldRoot >= tree.typeSyntaxCount ||
               ParserValueExprTypeSyntaxDeclarationOwnerAt(
                   tree, fieldRoot) != declarationRoot ||
               (ParserValueExprTypeSyntaxKindAt(tree, fieldRoot) !=
                    ParserTypeSyntaxObject &&
                ParserValueExprTypeSyntaxKindAt(tree, fieldRoot) !=
                    ParserTypeSyntaxRefObject):
                err = "parser type syntax: nested object field authority invalid"
                return false
            if !ParserValueExprProcessTypeBodyRange(
                   tree,
                   lineLimit,
                   nestedBodyLimit,
                   fieldRoot,
                   declarationStart,
                   err):
                return false
        cursor = nestedBodyLimit
    tree.activeDeclarationLexicalScopeRow = previousScopeRow
    err = ""
    return true

# Form-B 绑定条目(`name:` EOL、类型独占更深缩进下一逻辑行, 与字段 Form-B
# 同族): 行内仅 名称+冒号 两 token、下一逻辑行更深缩进且无顶层冒号(类型
# 表达式)时, 类型行并入条目范围; 其余形状(含无更深行的负例)维持原边界,
# 下游 `binding annotation missing` 硬错误口径不变。
@borrows
fn ParserValueExprExtendBindingEntryFormB(
        tree: ParserValueExprTree,
        tokenStart: int32,
        statementLimit: int32,
        tokenLimit: int32): int32 =
    if statementLimit != tokenStart + 2 ||
       !ParserValueExprTokenCanName(
           ParserValueExprTokenKindAt(tree, tokenStart)) ||
       ParserValueExprTokenKindAt(tree, statementLimit - 1) !=
           ParserValueTokenColon:
        return statementLimit
    let typeLineEnd = ParserValueExprLogicalLineEnd(
        tree, statementLimit, tokenLimit)
    if typeLineEnd <= statementLimit:
        return statementLimit
    # 更深缩进判定以**行首 token 列**为基准(非 tokenStart 名称列):
    # var/let/const 前缀形的名称被前缀顶深(`    var runtimeResult:` 名在
    # 列 9), 类型行 8 空格(列 9)与名称同列——按名称列判必漏; 按行首
    # `var` 列(5)判类型行(9)为更深。字段形行首即名称, 行为不变。
    var headerColumn = ParserValueExprTokenColumnAt(tree, tokenStart)
    var lineProbe = tokenStart - 1
    while lineProbe >= 0 &&
          ParserValueExprTokenLineAt(tree, lineProbe) ==
              ParserValueExprTokenLineAt(tree, tokenStart):
        headerColumn = ParserValueExprTokenColumnAt(tree, lineProbe)
        lineProbe = lineProbe - 1
    if ParserValueExprTokenColumnAt(tree, statementLimit) <= headerColumn:
        return statementLimit
    if ParserValueExprFindTopLevelKind(
           tree, statementLimit, typeLineEnd, ParserValueTokenColon) >= 0:
        return statementLimit
    return typeLineEnd

fn ParserValueExprProcessBindingEntryRange(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        declarationStartToken: int32,
        mutableFlag: bool,
        err: var str): bool =
    if tokenStart < 0 || tokenStart >= tokenLimit ||
       tokenLimit > tree.tokenCount ||
       declarationStartToken < 0 || declarationStartToken > tokenStart:
        err = "parser declaration: binding entry range invalid"
        return false
    var bindingTypeRoot: int32 = -1
    let assignIndex = ParserValueExprFindTopLevelKind(
        tree, tokenStart, tokenLimit, ParserValueTokenAssign)
    var patternLimit = tokenLimit
    if assignIndex >= 0:
        patternLimit = assignIndex
    if patternLimit <= tokenStart:
        err = "parser declaration: binding pattern missing"
        return false
    let patternRegionRow = tree.regionCount
    ParserValueExprAppendRegion(
        tree,
        ParserValueExprRegionPattern,
        ParserValueExprTokenSourceIdAt(tree, tokenStart),
        ParserValueExprTokenStartAt(tree, tokenStart),
        ParserValueExprTokenEndAt(tree, patternLimit - 1),
        tokenStart)
    let colonIndex = ParserValueExprFindTopLevelKind(
        tree, tokenStart, patternLimit, ParserValueTokenColon)
    var exactPatternLimit = patternLimit
    if colonIndex >= 0:
        if colonIndex == tokenStart || colonIndex + 1 >= patternLimit:
            err = "parser type syntax: binding annotation missing"
            return false
        exactPatternLimit = colonIndex
        ParserValueExprAppendRegion(
            tree,
            ParserValueExprRegionTypeExprText,
            ParserValueExprTokenSourceIdAt(tree, colonIndex + 1),
            ParserValueExprTokenStartAt(tree, colonIndex + 1),
            ParserValueExprTokenEndAt(tree, patternLimit - 1),
            colonIndex + 1)
        var typeOwnerToken: int32 = -1
        for ownerProbe in tokenStart..<colonIndex:
            if ParserValueExprTokenCanName(
                   ParserValueExprTokenKindAt(tree, ownerProbe)):
                typeOwnerToken = ownerProbe
                break
        if typeOwnerToken < 0:
            if err == "":
                err = "parser type syntax: binding owner missing"
            return false
        # [implicit generic] A local annotation inside a routine that owns a
        # type parameter window takes that window, exactly like a parameter or
        # return type root.  `ownerToken` stays the bound name (the annotation
        # belongs to that binding); the declaration-owner token becomes the
        # routine's name token, which is what makes the window's ownership
        # provable downstream.  A routine without a window keeps the previous
        # call byte for byte.
        var bindingRoutineOwnerToken: int32 = -1
        var bindingRoutineGenericStart: int32 = -1
        var bindingRoutineGenericCount: int32
        if tree.activeFunctionDeclarationRow >= 0:
            bindingRoutineGenericStart = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationGenericSymbolStarts,
                tree.activeFunctionDeclarationRow)
            bindingRoutineGenericCount = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationGenericSymbolCounts,
                tree.activeFunctionDeclarationRow)
            if bindingRoutineGenericCount > 0:
                bindingRoutineOwnerToken = arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.declarationNameTokenIndexes,
                    tree.activeFunctionDeclarationRow)
        var bindingRootErr: str
        var bindingRootOk: bool
        if bindingRoutineGenericCount > 0:
            bindingRootOk =
                ParserValueExprAppendTypeSyntaxRootWithGenericSymbols(
                    tree,
                    colonIndex + 1,
                    patternLimit,
                    typeOwnerToken,
                    ParserTypeSyntaxRootBindingAnnotation,
                    bindingRoutineOwnerToken,
                    bindingRoutineGenericStart,
                    bindingRoutineGenericCount,
                    bindingRootErr)
        else:
            bindingRootOk = ParserValueExprAppendTypeSyntaxRoot(
                tree,
                colonIndex + 1,
                patternLimit,
                typeOwnerToken,
                ParserTypeSyntaxRootBindingAnnotation,
                false,
                bindingRootErr)
        err = bindingRootErr
        if !bindingRootOk:
            if err == "":
                err = "parser type syntax: binding owner missing"
            return false
        bindingTypeRoot = tree.typeSyntaxCount - 1
    let declarationStart = tree.declarationCount
    let patternStart = tree.patternCount
    var patternRoot: int32
    if !ParserValueExprParsePatternRange(
           tree,
           tokenStart,
           exactPatternLimit,
           declarationStartToken,
           tokenLimit,
           mutableFlag,
           ParserPatternParseBindingDeclaration,
           patternRoot,
           err):
        return false
    ParserValueExprSetPatternRootOwner(
        tree,
        patternRoot,
        ParserPatternOwnerRegion,
        patternRegionRow)
    if bindingTypeRoot >= 0:
        for declarationRow in declarationStart..<tree.declarationCount:
            arenamod.ArenaArrayInt32Set(
                tree.arena,
                tree.declarationTypeSyntaxRootIndexes,
                declarationRow,
                bindingTypeRoot)
        for patternRow in patternStart..<tree.patternCount:
            let patternKind = ParserPatternKind(arenamod.ArenaArrayInt32Get(
                tree.arena, tree.patternKinds, patternRow))
            if patternKind == ParserPatternBinding ||
               patternRow == patternRoot:
                arenamod.ArenaArrayInt32Set(
                    tree.arena,
                    tree.patternTypeSyntaxRootIndexes,
                    patternRow,
                    bindingTypeRoot)
    let bindingPatternLimit = tree.patternCount
    if assignIndex < 0:
        for patternRow in patternStart..<bindingPatternLimit:
            if ParserPatternKind(arenamod.ArenaArrayInt32Get(
                   tree.arena, tree.patternKinds, patternRow)) ==
                   ParserPatternBinding:
                let declarationRow = arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.patternBindingDeclarationRows,
                    patternRow)
                if !ParserValueExprAppendLexicalBinding(
                       tree,
                       declarationRow,
                       patternRow,
                       ParserLexicalBindingIntroductionDeclaration,
                       -1,
                       -1,
                       tokenLimit - 1,
                       err):
                    return false
        return true
    if assignIndex + 1 >= tokenLimit:
        err = "parser value expr: binding initializer missing"
        return false
    let bindingDeclarationCount =
        tree.declarationCount - declarationStart
    let statementRole =
        bindingDeclarationCount > 0 ?
            ParserValueExprStatementBindingInitializer :
            ParserValueExprStatementAssignmentRhs
    let previousPendingStart =
        tree.activePendingBindingDeclarationStart
    let previousPendingCount =
        tree.activePendingBindingDeclarationCount
    let previousPendingScope =
        tree.activePendingBindingLexicalScopeRow
    tree.activePendingBindingDeclarationStart = declarationStart
    tree.activePendingBindingDeclarationCount = bindingDeclarationCount
    tree.activePendingBindingLexicalScopeRow =
        tree.activeDeclarationLexicalScopeRow
    var valueRoot: int32
    if !ParserValueExprParseExactRoot(
           tree,
           assignIndex + 1,
           tokenLimit,
           statementRole,
           assignIndex,
           valueRoot,
           err):
        tree.activePendingBindingDeclarationStart = previousPendingStart
        tree.activePendingBindingDeclarationCount = previousPendingCount
        tree.activePendingBindingLexicalScopeRow = previousPendingScope
        return false
    tree.activePendingBindingDeclarationStart = previousPendingStart
    tree.activePendingBindingDeclarationCount = previousPendingCount
    tree.activePendingBindingLexicalScopeRow = previousPendingScope
    if bindingDeclarationCount > 0:
        let bindingInitializerEnd =
            ParserValueExprNodeSpanEndAt(tree, valueRoot)
        for declarationRow in declarationStart..<declarationStart + bindingDeclarationCount:
            arenamod.ArenaArrayInt32Set(
                tree.arena,
                tree.declarationSpanEnds,
                declarationRow,
                bindingInitializerEnd)
        ParserValueExprSetStatementRootDeclarationAuthority(
            tree,
            ParserValueExprNodeDirectStatementRootEventAt(tree, valueRoot),
            declarationStart,
            bindingDeclarationCount)
    for patternRow in patternStart..<bindingPatternLimit:
        if ParserPatternKind(arenamod.ArenaArrayInt32Get(
               tree.arena, tree.patternKinds, patternRow)) ==
               ParserPatternBinding:
            let declarationRow = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.patternBindingDeclarationRows,
                patternRow)
            if !ParserValueExprAppendLexicalBinding(
                   tree,
                   declarationRow,
                   patternRow,
                   ParserLexicalBindingIntroductionInitializer,
                   ParserValueExprNodeDirectStatementRootEventAt(
                       tree, valueRoot),
                   valueRoot,
                   tokenLimit - 1,
                   err):
                return false
    return true

fn parserValueExprAppendImportModuleTokenRange(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        appendedCount: var int32): bool =
    if tree == nil || tree.importOrigins == nil ||
       tokenStart < 0 || tokenLimit <= tokenStart ||
       tokenLimit > tree.tokenCount:
        return false
    var origins = tree.importOrigins
    var expectName = true
    var moduleTokenIndexes = origins.moduleTokenIndexes
    var moduleTokenCount = origins.moduleTokenCount
    for tokenIndex in tokenStart..<tokenLimit:
        let kind = ParserValueExprTokenKindAt(tree, tokenIndex)
        if expectName:
            if !ParserValueExprTokenCanName(kind):
                tree.importOrigins = origins
                return false
            arenamod.ArenaArrayInt32Add(
                tree.arena,
                moduleTokenIndexes,
                tokenIndex)
            moduleTokenCount = moduleTokenCount + 1
            appendedCount = appendedCount + 1
            expectName = false
        else:
            if kind != ParserValueTokenSlash:
                tree.importOrigins = origins
                return false
            expectName = true
    origins.moduleTokenIndexes = moduleTokenIndexes
    origins.moduleTokenCount = moduleTokenCount
    tree.importOrigins = origins
    return !expectName

fn parserValueExprAppendImportItem(
        tree: var ParserValueExprTree,
        declarationRow: int32,
        prefixStart: int32,
        prefixLimit: int32,
        itemStart: int32,
        itemLimit: int32,
        spanStartToken: int32,
        spanLimitToken: int32,
        aliasToken: int32): bool =
    if tree == nil || tree.importOrigins == nil:
        return false
    if declarationRow < 0 ||
       declarationRow >= tree.importOrigins.declarationCount ||
       itemStart < 0 || itemLimit <= itemStart ||
       itemLimit > tree.tokenCount || spanStartToken < 0 ||
       spanLimitToken <= spanStartToken ||
       spanLimitToken > tree.tokenCount ||
       aliasToken < -1 || aliasToken >= tree.tokenCount:
        return false
    let moduleTokenStart = tree.importOrigins.moduleTokenCount
    var moduleTokenCount: int32
    if prefixStart >= 0 &&
       !parserValueExprAppendImportModuleTokenRange(
           tree,
           prefixStart,
           prefixLimit,
           moduleTokenCount):
        return false
    let prefixTokenCount = moduleTokenCount
    if !parserValueExprAppendImportModuleTokenRange(
           tree,
           itemStart,
           itemLimit,
           moduleTokenCount):
        return false
    let itemRow = tree.importOrigins.itemCount
    var origins = tree.importOrigins
    var itemProducerSourceIndexes = origins.itemProducerSourceIndexes
    var itemSourceLocalRows = origins.itemSourceLocalRows
    var itemDeclarationRows = origins.itemDeclarationRows
    var itemAliasTokenIndexes = origins.itemAliasTokenIndexes
    var itemSpanStarts = origins.itemSpanStarts
    var itemSpanEnds = origins.itemSpanEnds
    var itemModuleTokenStarts = origins.itemModuleTokenStarts
    var itemModuleTokenCounts = origins.itemModuleTokenCounts
    var itemPrefixTokenCounts = origins.itemPrefixTokenCounts
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        itemProducerSourceIndexes,
        0)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        itemSourceLocalRows,
        itemRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        itemDeclarationRows,
        declarationRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        itemAliasTokenIndexes,
        aliasToken)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        itemSpanStarts,
        ParserValueExprTokenStartAt(tree, spanStartToken))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        itemSpanEnds,
        ParserValueExprTokenEndAt(tree, spanLimitToken - 1))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        itemModuleTokenStarts,
        moduleTokenStart)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        itemModuleTokenCounts,
        moduleTokenCount)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        itemPrefixTokenCounts,
        prefixTokenCount)
    origins.itemProducerSourceIndexes = itemProducerSourceIndexes
    origins.itemSourceLocalRows = itemSourceLocalRows
    origins.itemDeclarationRows = itemDeclarationRows
    origins.itemAliasTokenIndexes = itemAliasTokenIndexes
    origins.itemSpanStarts = itemSpanStarts
    origins.itemSpanEnds = itemSpanEnds
    origins.itemModuleTokenStarts = itemModuleTokenStarts
    origins.itemModuleTokenCounts = itemModuleTokenCounts
    origins.itemPrefixTokenCounts = itemPrefixTokenCounts
    origins.itemCount = itemRow + 1
    tree.importOrigins = origins
    return true

fn ParserValueExprAppendImportDeclaration(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        err: var str): bool =
    if tree == nil || tree.importOrigins == nil ||
       tokenStart < 0 || tokenLimit <= tokenStart + 1 ||
       tokenLimit > tree.tokenCount ||
       ParserValueExprTokenKindAt(tree, tokenStart) !=
           ParserValueTokenImport:
        err = "parser import origin: invalid declaration range"
        return false
    let declarationRow = tree.importOrigins.declarationCount
    let itemStartRow = tree.importOrigins.itemCount
    var origins = tree.importOrigins
    var declarationProducerSourceIndexes =
        origins.declarationProducerSourceIndexes
    var declarationSourceLocalRows = origins.declarationSourceLocalRows
    var declarationKeywordTokenIndexes =
        origins.declarationKeywordTokenIndexes
    var declarationSpanStarts = origins.declarationSpanStarts
    var declarationSpanEnds = origins.declarationSpanEnds
    var declarationItemStarts = origins.declarationItemStarts
    var declarationItemCounts = origins.declarationItemCounts
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        declarationProducerSourceIndexes,
        0)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        declarationSourceLocalRows,
        declarationRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        declarationKeywordTokenIndexes,
        tokenStart)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        declarationSpanStarts,
        ParserValueExprTokenStartAt(tree, tokenStart))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        declarationSpanEnds,
        ParserValueExprTokenEndAt(tree, tokenLimit - 1))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        declarationItemStarts,
        itemStartRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        declarationItemCounts,
        0)
    origins.declarationProducerSourceIndexes =
        declarationProducerSourceIndexes
    origins.declarationSourceLocalRows = declarationSourceLocalRows
    origins.declarationKeywordTokenIndexes =
        declarationKeywordTokenIndexes
    origins.declarationSpanStarts = declarationSpanStarts
    origins.declarationSpanEnds = declarationSpanEnds
    origins.declarationItemStarts = declarationItemStarts
    origins.declarationItemCounts = declarationItemCounts
    origins.declarationCount = declarationRow + 1
    tree.importOrigins = origins
    var groupedOpen: int32 = -1
    for tokenIndex in tokenStart + 1..<tokenLimit:
        if ParserValueExprTokenKindAt(tree, tokenIndex) ==
               ParserValueTokenLeftBracket:
            groupedOpen = tokenIndex
            break
    if groupedOpen >= 0:
        if groupedOpen < tokenStart + 3 ||
           ParserValueExprTokenKindAt(tree, groupedOpen - 1) !=
               ParserValueTokenSlash ||
           ParserValueExprTokenKindAt(tree, tokenLimit - 1) !=
               ParserValueTokenRightBracket:
            err = "parser import origin: malformed grouped declaration"
            return false
        let prefixStart = tokenStart + 1
        let prefixLimit = groupedOpen - 1
        var itemStart = groupedOpen + 1
        for tokenIndex in groupedOpen + 1..<tokenLimit:
            let kind = ParserValueExprTokenKindAt(tree, tokenIndex)
            if kind != ParserValueTokenComma &&
               kind != ParserValueTokenRightBracket:
                continue
            if !parserValueExprAppendImportItem(
                   tree,
                   declarationRow,
                   prefixStart,
                   prefixLimit,
                   itemStart,
                   tokenIndex,
                   itemStart,
                   tokenIndex,
                   -1):
                err = "parser import origin: malformed grouped item"
                return false
            itemStart = tokenIndex + 1
        if itemStart != tokenLimit:
            err = "parser import origin: grouped declaration not closed"
            return false
    else:
        var moduleLimit = tokenStart + 2
        var cursor = tokenStart + 2
        while cursor + 1 < tokenLimit &&
              ParserValueExprTokenKindAt(tree, cursor) ==
                  ParserValueTokenSlash &&
              ParserValueExprTokenCanName(
                  ParserValueExprTokenKindAt(tree, cursor + 1)):
            moduleLimit = cursor + 2
            cursor = cursor + 2
        var aliasToken: int32 = -1
        if moduleLimit < tokenLimit:
            if tokenLimit - moduleLimit != 2 ||
               !ParserValueExprTokenTextEqualsText(tree, moduleLimit,
                                                   "as") ||
               !ParserValueExprTokenCanName(
                   ParserValueExprTokenKindAt(tree, moduleLimit + 1)):
                err = "parser import origin: malformed alias"
                return false
            aliasToken = moduleLimit + 1
        if !parserValueExprAppendImportItem(
               tree,
               declarationRow,
               -1,
               -1,
               tokenStart + 1,
               moduleLimit,
               tokenStart + 1,
               tokenLimit,
               aliasToken):
            err = "parser import origin: malformed module path"
            return false
    let itemCount = tree.importOrigins.itemCount - itemStartRow
    if itemCount <= 0:
        err = "parser import origin: declaration has no item"
        return false
    var originsAfterItems = tree.importOrigins
    var declarationItemCountsAfter =
        originsAfterItems.declarationItemCounts
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        declarationItemCountsAfter,
        declarationRow,
        itemCount)
    originsAfterItems.declarationItemCounts =
        declarationItemCountsAfter
    tree.importOrigins = originsAfterItems
    err = ""
    return true

fn ParserValueExprProcessConceptTraitRange(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        err: var str): bool =
    if tokenStart < 0 || tokenStart + 2 >= tokenLimit ||
       tokenLimit > tree.tokenCount:
        err = "parser concept/trait: declaration range invalid"
        return false
    let keywordKind = ParserValueExprTokenKindAt(tree, tokenStart)
    if keywordKind != ParserValueTokenConcept &&
       keywordKind != ParserValueTokenTrait:
        err = "parser concept/trait: declaration keyword missing"
        return false
    let nameToken = tokenStart + 1
    if !ParserValueExprTokenCanName(
           ParserValueExprTokenKindAt(tree, nameToken)):
        err = "parser concept/trait: declaration name missing"
        return false
    let colonToken = ParserValueExprFindTopLevelKind(
        tree,
        nameToken + 1,
        tokenLimit,
        ParserValueTokenColon)
    if colonToken < 0 || colonToken + 1 >= tokenLimit:
        err = colonToken < 0 ?
            "parser concept/trait: suite separator missing" :
            ParserValueExprAdmissionDiagnostic(
                tree,
                colonToken,
                "PARSER_EMPTY_SUITE_FORBIDDEN")
        return false
    var genericSymbolStart: int32 = -1
    var genericSymbolCount: int32
    let genericOpen = nameToken + 1
    if genericOpen < colonToken:
        if ParserValueExprTokenKindAt(tree, genericOpen) !=
               ParserValueTokenLeftBracket:
            err = "parser concept/trait: unexpected declaration header token"
            return false
        let genericClose = ParserValueExprFindMatchingToken(
            tree,
            genericOpen,
            colonToken,
            ParserValueTokenLeftBracket,
            ParserValueTokenRightBracket)
        if genericClose < 0 || genericClose + 1 != colonToken ||
           !ParserValueExprAppendDeclarationGenericSymbols(
               tree,
               nameToken,
               genericOpen,
               genericClose,
               genericSymbolStart,
               genericSymbolCount,
               err):
            if err == "":
                err = "parser concept/trait: generic declaration invalid"
            return false
    ParserValueExprAppendRegion(
        tree,
        ParserValueExprRegionConceptTraitHeader,
        ParserValueExprTokenSourceIdAt(tree, tokenStart),
        ParserValueExprTokenStartAt(tree, tokenStart),
        ParserValueExprTokenEndAt(tree, colonToken),
        tokenStart)
    let declarationKind =
        keywordKind == ParserValueTokenConcept ?
            ParserDeclarationConcept : ParserDeclarationTrait
    let declarationRow = ParserValueExprAppendDeclaration(
        tree,
        declarationKind,
        nameToken,
        ParserValueExprActiveDeclarationOwner(tree),
        tree.activeDeclarationLexicalScopeRow,
        -1,
        -1,
        tokenStart,
        tokenLimit,
        false)
    if genericSymbolCount > 0:
        ParserValueExprSetDeclarationGenericSymbols(
            tree,
            declarationRow,
            genericSymbolStart,
            genericSymbolCount)
    let previousConceptTraitDeclarationRow =
        tree.activeConceptTraitDeclarationRow
    tree.activeConceptTraitDeclarationRow = declarationRow
    let suiteScopeRow = tree.declarationLexicalScopeCount
    let suiteOk = ParserValueExprProcessSuiteRange(
        tree,
        colonToken + 1,
        tokenLimit,
        err)
    tree.activeConceptTraitDeclarationRow =
        previousConceptTraitDeclarationRow
    if !suiteOk:
        return false
    if suiteScopeRow < 0 ||
       suiteScopeRow >= tree.declarationLexicalScopeCount ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationLexicalScopeOwnerDeclarationRows,
           suiteScopeRow) != declarationRow ||
       ParserDeclarationLexicalScopeKind(
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeKinds,
               suiteScopeRow)) != ParserDeclarationLexicalScopeBlock:
        panic("parser concept/trait: suite scope owner drift")
    ParserValueExprSetDeclarationSuiteLexicalScope(
        tree, declarationRow, suiteScopeRow)
    err = ""
    return true

@borrows
fn parserForwardingStatementCoreStart(
        tree: ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32): int32 =
    var cursor = tokenStart
    while cursor < tokenLimit &&
          ParserValueExprTokenKindAt(tree, cursor) == ParserValueTokenAt:
        if cursor + 1 >= tokenLimit ||
           !ParserValueExprTokenCanName(
               ParserValueExprTokenKindAt(tree, cursor + 1)):
            return -1
        cursor = cursor + 2
        if cursor < tokenLimit &&
           ParserValueExprTokenKindAt(tree, cursor) ==
               ParserValueTokenLeftParen:
            let closeToken = ParserValueExprFindMatchingToken(
                tree,
                cursor,
                tokenLimit,
                ParserValueTokenLeftParen,
                ParserValueTokenRightParen)
            if closeToken < 0:
                return -1
            cursor = closeToken + 1
    return cursor < tokenLimit ? cursor : -1

@borrows
fn parserForwardingStatementCoreArm(
        tree: ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        fieldDeclarationOwnerNodeIndex: int32): int32 =
    let coreStart = parserForwardingStatementCoreStart(
        tree, tokenStart, tokenLimit)
    if coreStart < 0:
        return -1
    let firstKind = ParserValueExprTokenKindAt(tree, coreStart)
    if firstKind == ParserValueTokenModule ||
       firstKind == ParserValueTokenImport ||
       firstKind == ParserValueTokenAt ||
       firstKind == ParserValueTokenOf:
        return -1
    let armAssign = ParserValueExprFindTopLevelKind(
        tree, coreStart, tokenLimit, ParserValueTokenAssign)
    if armAssign >= coreStart &&
       armAssign + 1 < tokenLimit &&
       ParserValueExprTokenKindAt(tree, armAssign + 1) ==
           ParserValueTokenGreater:
        return -2
    if firstKind == ParserValueTokenLet ||
       firstKind == ParserValueTokenVar ||
       firstKind == ParserValueTokenConst:
        return 0
    if firstKind == ParserValueTokenType:
        return 1
    if firstKind == ParserValueTokenReturn:
        return 3
    if firstKind == ParserValueTokenYield:
        return 4
    if firstKind == ParserValueTokenBreak:
        return 5
    if firstKind == ParserValueTokenContinue:
        return 6
    if firstKind == ParserValueTokenDefer:
        return 7
    if firstKind == ParserValueTokenIf:
        return 8
    if firstKind == ParserValueTokenMatch:
        return 9
    if firstKind == ParserValueTokenWhile:
        return 10
    if firstKind == ParserValueTokenFor:
        return 11
    if firstKind == ParserValueTokenCase:
        return 12
    if firstKind == ParserValueTokenWhen:
        return 13
    if firstKind == ParserValueTokenElif ||
       firstKind == ParserValueTokenElse:
        # 规范 §stmt/ifStmt（docs/cheng-formal-spec.md:345）：elif/else 只是
        # if 语句的续支，不存在独立 elif/else 语句产线。以二者起头的语句
        # 范围必为缺 if 头的非法源，分类到 -3 交 caller 走 admission 硬门禁；
        # 严禁落进尾部 armAssign 兜底——authority-reused-20260827 案卷：
        # 那会把 `elif cond: x = v` 整行误吞成赋值壳产线（span 全行、anchor
        # = 行内 `=`），与真实行内体产线双认领同一 AssignmentRhs root。
        return -3
    if firstKind == ParserValueTokenBlock:
        # 类型体字段名可命中上下文关键字 `block`(如 sha256 `block: Bytes`):
        # field owner 在场时必须先按字段归类(同 :23615 口径), 否则被
        # blockStmt(arm14)抢类, 在 TopLevelBegin 拒产(arm14 无顶层映射)
        # 后的无主环境里起 Statement 产线 → stmt_begin_diag 崩溃。
        if fieldDeclarationOwnerNodeIndex >= 0 &&
           ParserValueExprFindTopLevelKind(
               tree, coreStart, tokenLimit, ParserValueTokenColon) >= 0:
            return -1
        # 规范 §lexical：`block` 是上下文关键字，仅 `block [ident] ":"
        # suite` 形按 blockStmt（arm14）；语句首后随顶层 `=` 的赋值形按
        # ident 走 arm2/arm21——与词法权限注释(ParserValueExprTokenCanName)
        # 及语句处理器(StartsIndentedSuite 守卫)同一拼写域，否则发布器在该
        # 行上不创建 lexical-scope 行，authority 退化 ValueNode 而验证器按
        # arm14 索 LexicalScope → "forwarding production: authority invalid"。
        if ParserValueExprStatementStartsIndentedSuite(
                tree, coreStart, tokenLimit):
            return 14
        if armAssign >= 0:
            return 2
        return 21
    if firstKind == ParserValueTokenMacro:
        return 15
    if firstKind == ParserValueTokenTemplate:
        return 16
    if firstKind == ParserValueTokenConcept:
        return 17
    if firstKind == ParserValueTokenTrait:
        return 18
    if firstKind == ParserValueTokenFn:
        return 19
    if firstKind == ParserValueTokenIterator:
        return 20
    if firstKind == ParserValueTokenAsync &&
       coreStart + 1 < tokenLimit:
        let asyncTargetKind =
            ParserValueExprTokenKindAt(tree, coreStart + 1)
        if asyncTargetKind == ParserValueTokenFn:
            return 19
        if asyncTargetKind == ParserValueTokenIterator:
            return 20
    if firstKind == ParserValueTokenIdentifier &&
       coreStart + 1 < tokenLimit &&
       ParserValueExprTokenTextEqualsText(tree, coreStart, "importc") &&
       ParserValueExprTokenKindAt(tree, coreStart + 1) ==
           ParserValueTokenFn:
        return 19
    if fieldDeclarationOwnerNodeIndex >= 0 &&
       ParserValueExprFindTopLevelKind(
           tree, coreStart, tokenLimit, ParserValueTokenColon) >= 0:
        return -1
    if armAssign >= 0:
        return 2
    return 21

fn parserForwardingTopLevelCoreArm(statementCoreArm: int32): int32 =
    if statementCoreArm == 0:
        return 0
    if statementCoreArm == 19:
        return 1
    if statementCoreArm == 20:
        return 2
    if statementCoreArm == 15:
        return 3
    if statementCoreArm == 16:
        return 4
    if statementCoreArm == 17:
        return 5
    if statementCoreArm == 18:
        return 6
    if statementCoreArm == 1:
        return 7
    if statementCoreArm == 21:
        return 8
    return -1

fn parserForwardingTopLevelBegin(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        statementCoreArm: int32,
        annotationStart: int32,
        annotationCount: int32,
        declRowOut: var int32,
        coreRowOut: var int32) =
    declRowOut = -1
    coreRowOut = -1
    let topLevelArm = parserForwardingTopLevelCoreArm(statementCoreArm)
    if topLevelArm < 0:
        return
    let coreStart = parserForwardingStatementCoreStart(
        tree, tokenStart, tokenLimit)
    if coreStart < 0:
        panic("parser forwarding production: top-level core missing")
    var spanStartToken = tokenStart
    if annotationCount > 0:
        let firstAnnotationNameToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.annotationNameTokenIndexes,
            annotationStart)
        spanStartToken = firstAnnotationNameToken - 1
        if spanStartToken < 0 ||
           ParserValueExprTokenKindAt(tree, spanStartToken) !=
               ParserValueTokenAt ||
           ParserValueExprTokenStartAt(tree, spanStartToken) !=
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.annotationSpanStarts,
                   annotationStart):
            panic("parser forwarding production: annotation start token missing")
    declRowOut = parserForwardingProductionBegin(
        tree,
        ParserForwardingProductionTopLevelDecl,
        -1,
        coreStart,
        spanStartToken,
        tokenLimit - 1)
    coreRowOut = parserForwardingProductionBegin(
        tree,
        ParserForwardingProductionTopLevelCore,
        topLevelArm,
        coreStart,
        coreStart,
        tokenLimit - 1)

fn parserForwardingTopLevelFinish(
        tree: var ParserValueExprTree,
        declRow: int32,
        coreRow: int32,
        annotationStart: int32,
        annotationCount: int32) =
    if declRow < 0 && coreRow < 0:
        return
    if declRow < 0 || coreRow < 0:
        panic("parser forwarding production: split top-level rows")
    parserForwardingProductionFinish(
        tree,
        coreRow,
        ParserForwardingProductionChildInvalid,
        -1,
        -1,
        0)
    parserForwardingProductionFinish(
        tree,
        declRow,
        ParserForwardingProductionChildInvalid,
        -1,
        annotationCount > 0 ? annotationStart : -1,
        annotationCount)

@borrows
fn parserForwardingProductionFindStatementAuthorityRoot(
        tree: ParserValueExprTree,
        startRow: int32,
        expectedRoleA: int32,
        expectedRoleB: int32,
        anchorRequired: bool,
        anchorToken: int32): int32 =
    # 两段扫描：先精确匹配首选角色（BindingInitializer），再回退到兜底
    # 角色（AssignmentRhs，通配符丢弃绑定），保证首选形态不被内层语句根
    # 抢占。
    if expectedRoleA >= 0:
        var scanRow = startRow
        while scanRow < tree.statementRootCount:
            if Int32(ParserValueExprStatementRootRoleAt(
                    tree, scanRow)) == expectedRoleA:
                var declarationAuthorityOk = true
                if expectedRoleA ==
                        Int32(ParserValueExprStatementBindingInitializer):
                    let declarationCount = ParserValueExprStatementRootBindingDeclarationCountAt(
                        tree, scanRow)
                    declarationAuthorityOk = declarationCount > 0
                if declarationAuthorityOk &&
                   (!anchorRequired ||
                    ParserValueExprStatementRootAnchorTokenAt(
                        tree, scanRow) == anchorToken):
                    return scanRow
            scanRow = scanRow + 1
    if expectedRoleB >= 0:
        var scanRow = startRow
        while scanRow < tree.statementRootCount:
            if Int32(ParserValueExprStatementRootRoleAt(
                    tree, scanRow)) == expectedRoleB:
                if !anchorRequired ||
                   ParserValueExprStatementRootAnchorTokenAt(
                       tree, scanRow) == anchorToken:
                    return scanRow
            scanRow = scanRow + 1
    return -1

fn parserForwardingDirectStatementBegin(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        armIndex: int32,
        statementRowOut: var int32,
        coreRowOut: var int32) =
    let coreStart = parserForwardingStatementCoreStart(
        tree, tokenStart, tokenLimit)
    if coreStart < 0 ||
       armIndex < 0 ||
       armIndex > 21:
        panic("parser forwarding production: direct statement invalid")
    statementRowOut = parserForwardingProductionBegin(
        tree,
        ParserForwardingProductionStatement,
        -1,
        coreStart,
        tokenStart,
        tokenLimit - 1)
    coreRowOut = parserForwardingProductionBegin(
        tree,
        ParserForwardingProductionStatementCore,
        armIndex,
        coreStart,
        coreStart,
        tokenLimit - 1)

fn parserForwardingDirectStatementFinish(
        tree: var ParserValueExprTree,
        statementRow: int32,
        coreRow: int32,
        authorityKind: ParserForwardingProductionChildKind,
        authorityRow: int32) =
    parserForwardingProductionFinish(
        tree, coreRow, authorityKind, authorityRow, -1, 0)
    parserForwardingProductionFinish(
        tree,
        statementRow,
        ParserForwardingProductionChildInvalid,
        -1,
        -1,
        0)

fn parserValueExprProcessStatementCoreRangeWithTypeOwner(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        importcAnnotationPending: bool,
        fieldDeclarationOwnerNodeIndex: int32,
        err: var str): bool =
    if tokenStart >= tokenLimit:
        return true
    var first = tokenStart
    let firstKind = ParserValueExprTokenKindAt(tree, first)
    if firstKind == ParserValueTokenType:
        return ParserValueExprProcessTypeDeclarationRange(tree,
                                                           tokenStart,
                                                           tokenLimit,
                                                           err)
    if firstKind == ParserValueTokenConcept ||
       firstKind == ParserValueTokenTrait:
        return ParserValueExprProcessConceptTraitRange(
            tree, tokenStart, tokenLimit, err)
    if firstKind == ParserValueTokenAt || firstKind == ParserValueTokenImport ||
       firstKind == ParserValueTokenModule:
        # Value layer skips these headers by design; still record the exact
        # logical-line span so the canonical receipt can witness them.
        var regionKind = ParserValueExprRegionInvalid
        if firstKind == ParserValueTokenAt:
            regionKind = ParserValueExprRegionAnnotationLine
        elif firstKind == ParserValueTokenModule:
            regionKind = ParserValueExprRegionModuleHeaderLine
        if regionKind != ParserValueExprRegionInvalid:
            ParserValueExprAppendRegion(
                tree,
                regionKind,
                ParserValueExprTokenSourceIdAt(tree, first),
                ParserValueExprTokenStartAt(tree, first),
                ParserValueExprTokenEndAt(tree, tokenLimit - 1),
                first)
        if firstKind == ParserValueTokenModule:
            if first + 1 >= tokenLimit ||
               !ParserValueExprTokenCanName(
                   ParserValueExprTokenKindAt(tree, first + 1)):
                err = "parser declaration: module name missing"
                return false
            tree.activeModuleDeclarationRow =
                ParserValueExprAppendDeclaration(
                    tree,
                    ParserDeclarationModule,
                    first + 1,
                    -1,
                    tree.activeDeclarationLexicalScopeRow,
                    -1,
                    -1,
                    first,
                    tokenLimit,
                    false)
        if firstKind == ParserValueTokenImport &&
           !ParserValueExprAppendImportDeclaration(
               tree, first, tokenLimit, err):
            return false
        if firstKind == ParserValueTokenAt:
            let annotationStart = tree.annotationCount
            var annotationCursor = first
            var targetImportc = importcAnnotationPending
            while annotationCursor < tokenLimit &&
                  ParserValueExprTokenKindAt(
                      tree, annotationCursor) == ParserValueTokenAt:
                if annotationCursor + 1 >= tokenLimit ||
                   !ParserValueExprTokenCanName(
                       ParserValueExprTokenKindAt(
                           tree, annotationCursor + 1)):
                    err = "parser annotation: name missing"
                    return false
                var annotationLimit = annotationCursor + 2
                if annotationLimit < tokenLimit &&
                   ParserValueExprTokenKindAt(
                       tree, annotationLimit) ==
                       ParserValueTokenLeftParen:
                    let closeToken = ParserValueExprFindMatchingToken(
                        tree,
                        annotationLimit,
                        tokenLimit,
                        ParserValueTokenLeftParen,
                        ParserValueTokenRightParen)
                    if closeToken < 0:
                        err = "parser annotation: argument list close mismatch"
                        return false
                    annotationLimit = closeToken + 1
                var annotationRow: int32
                if !ParserValueExprAppendAnnotationInto(
                       tree,
                       annotationCursor,
                       annotationLimit,
                       annotationRow,
                       err) ||
                   annotationRow < annotationStart:
                    if err == "":
                        err = "parser annotation: row missing"
                    return false
                if ParserValueExprTokenText(
                       tree,
                       arenamod.ArenaArrayInt32Get(
                           tree.arena,
                           tree.annotationNameTokenIndexes,
                           annotationRow)) == "importc":
                    targetImportc = true
                annotationCursor = annotationLimit
            let annotationCount = tree.annotationCount - annotationStart
            if annotationCount <= 0:
                err = "parser annotation: row missing"
                return false
            if annotationCursor < tokenLimit:
                ParserValueExprBindAnnotationTargets(
                    tree,
                    annotationStart,
                    annotationCount,
                    annotationCursor)
                return parserValueExprProcessStatementCoreRangeWithTypeOwner(
                    tree,
                    annotationCursor,
                    tokenLimit,
                    targetImportc,
                    fieldDeclarationOwnerNodeIndex,
                    err)
        return true
    if firstKind == ParserValueTokenBreak ||
       firstKind == ParserValueTokenContinue:
        if first + 1 != tokenLimit:
            err = "parser value expr: trailing token after terminal statement"
            return false
        # B6 根修: break/continue 此前不产树节点, 归一化行只带 frozen
        # anchor, receipt 按 node id 拒收 (夹具判词 kind=20/21
        # root=-1 origin=-1)。为每条终止语句追加叶子节点并注册语句根事
        # 件, 行绑定与其他语句同走 (line, col, role) 径。规范: 终止语句
        # 无值, 节点 span = 关键字 token span; 权威映射无独立 role, 复用
        # Expression (else 行记 Condition 同款先例)。
        var b6TerminalKind = ParserValueExprBreakNode
        if firstKind == ParserValueTokenContinue:
            b6TerminalKind = ParserValueExprContinueNode
        var b6TerminalChildren: int32[]
        let b6TerminalNode = ParserValueExprAppendNode(
            tree,
            ParserValueExprTokenSourceIdAt(tree, first),
            b6TerminalKind,
            ParserValueExprTokenStartAt(tree, first),
            ParserValueExprTokenEndAt(tree, first),
            b6TerminalChildren)
        ParserValueExprAppendStatementRoot(
            tree,
            b6TerminalNode,
            ParserValueExprStatementExpression,
            first,
            first)
        return true
    if firstKind == ParserValueTokenReturn ||
       firstKind == ParserValueTokenYield:
        if first + 1 >= tokenLimit:
            return true
        var valueRoot: int32
        var valueRole = ParserValueExprStatementReturnValue
        if firstKind == ParserValueTokenYield:
            valueRole = ParserValueExprStatementYieldValue
        return ParserValueExprParseExactRoot(tree,
                                              first + 1,
                                              tokenLimit,
                                              valueRole,
                                              first,
                                              valueRoot,
                                              err)
    if firstKind == ParserValueTokenIf || firstKind == ParserValueTokenWhen:
        return ParserValueExprProcessConditionalStatement(tree,
                                                           tokenStart,
                                                           tokenLimit,
                                                           err)
    if firstKind == ParserValueTokenElif || firstKind == ParserValueTokenElse:
        return ParserValueExprProcessConditionalStatement(tree,
                                                           tokenStart,
                                                           tokenLimit,
                                                           err)
    if firstKind == ParserValueTokenIdentifier &&
       first + 1 < tokenLimit &&
       ParserValueExprTokenTextEqualsText(tree, first, "importc") &&
       ParserValueExprTokenKindAt(tree, first + 1) == ParserValueTokenFn:
        # Legacy `importc fn name(...): type` declaration: signature only, no
        # suite and no `=`.  Same bodyless handling as the @importc form.
        let routineDeclarationStart = tree.declarationCount
        if !ParserValueExprProcessRoutineRange(tree,
                                               first + 1,
                                               tokenLimit,
                                               true,
                                               err):
            return false
        # 裸 importc 形的 function declaration span 自 `fn` token 起, 而
        # StatementCore production 的 span 自 `importc` token 起——authority
        # 校验(:8134-8142)要求 declaration span 与 production span 精确相等。
        # 对齐 declaration spanStart 至 `importc` token 起点(spanEnd 两侧同
        # 为 tokenLimit-1 末 token, 无需修); @importc 形 annotation 独立行,
        # fn 语句 span 本就自 fn 起, 不走此径。
        if tree.declarationCount > routineDeclarationStart:
            arenamod.ArenaArrayInt32Set(
                tree.arena,
                tree.declarationSpanStarts,
                routineDeclarationStart,
                ParserValueExprTokenStartAt(tree, first))
        return true
    if firstKind == ParserValueTokenFn ||
       firstKind == ParserValueTokenIterator ||
       firstKind == ParserValueTokenMacro ||
       firstKind == ParserValueTokenTemplate ||
       firstKind == ParserValueTokenAsync:
        return ParserValueExprProcessRoutineRange(tree,
                                                   tokenStart,
                                                   tokenLimit,
                                                   importcAnnotationPending,
                                                   err)
    if firstKind == ParserValueTokenDefer ||
       (firstKind == ParserValueTokenBlock &&
        fieldDeclarationOwnerNodeIndex < 0 &&
        ParserValueExprStatementStartsIndentedSuite(
            tree, tokenStart, tokenLimit)):
        let colonIndex = ParserValueExprFindTopLevelKind(
            tree, first + 1, tokenLimit, ParserValueTokenColon)
        if colonIndex < 0:
            err = "parser value expr: suite separator missing"
            return false
        if firstKind == ParserValueTokenDefer:
            # B6 根修: defer 行与 break/continue 同族 (anchor-only 行,
            # receipt 按 node id 拒收 kind=19 surface=defer:)。追加叶子
            # 节点 + 语句根事件, span = defer 关键字 token, role 复用
            # Expression。
            var b6DeferChildren: int32[]
            let b6DeferNode = ParserValueExprAppendNode(
                tree,
                ParserValueExprTokenSourceIdAt(tree, first),
                ParserValueExprDeferNode,
                ParserValueExprTokenStartAt(tree, first),
                ParserValueExprTokenEndAt(tree, first),
                b6DeferChildren)
            ParserValueExprAppendStatementRoot(
                tree,
                b6DeferNode,
                ParserValueExprStatementExpression,
                first,
                first)
        if colonIndex + 1 < tokenLimit:
            if firstKind == ParserValueTokenBlock:
                let blockRow = parserForwardingProductionBegin(
                    tree,
                    ParserForwardingProductionBlockStmt,
                    colonIndex == first + 1 ? 0 : 1,
                    first,
                    first,
                    tokenLimit - 1)
                if !ParserValueExprProcessSuiteRange(
                       tree, colonIndex + 1, tokenLimit, err):
                    return false
                parserForwardingProductionFinish(
                    tree,
                    blockRow,
                    ParserForwardingProductionChildInvalid,
                    -1,
                    -1,
                    0)
                return true
            return ParserValueExprProcessSuiteRange(
                tree, colonIndex + 1, tokenLimit, err)
        err = ParserValueExprAdmissionDiagnostic(
            tree,
            colonIndex,
            "PARSER_EMPTY_SUITE_FORBIDDEN")
        return false
    if firstKind == ParserValueTokenWhile ||
       firstKind == ParserValueTokenMatch ||
       firstKind == ParserValueTokenCase:
        var cursor = first + 1
        var conditionRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            tokenLimit,
                                            0,
                                            conditionRoot,
                                            err):
            return false
        ParserValueExprAppendStatementRoot(
            tree,
            conditionRoot,
            ParserValueExprStatementCondition,
            first,
            ParserValueExprStatementEndTokenFor(
                tree,
                conditionRoot,
                first,
                cursor - 1))
        if cursor < tokenLimit &&
           ParserValueExprTokenKindAt(tree, cursor) == ParserValueTokenColon:
            cursor = cursor + 1
        if cursor < tokenLimit:
            if ParserValueExprTokenLineAt(tree, cursor) ==
               ParserValueExprTokenLineAt(tree, first):
                return ParserValueExprProcessStatementRangeWithTypeOwner(
                    tree,
                    cursor,
                    tokenLimit,
                    false,
                    fieldDeclarationOwnerNodeIndex,
                    err)
            return ParserValueExprProcessSuiteRange(
                tree,
                cursor,
                tokenLimit,
                err)
        if firstKind == ParserValueTokenCase:
            err = ParserValueExprAdmissionDiagnostic(
                tree,
                first,
                "PARSER_EMPTY_CASE_STATEMENT_BRANCHES")
        else:
            err = ParserValueExprAdmissionDiagnostic(
                tree,
                cursor - 1,
                "PARSER_EMPTY_SUITE_FORBIDDEN")
        return false
    if firstKind == ParserValueTokenFor:
        let inIndex = ParserValueExprFindTopLevelKind(
            tree, first + 1, tokenLimit, ParserValueTokenIn)
        if inIndex < 0 || inIndex + 1 >= tokenLimit:
            err = "parser value expr: for source missing"
            return false
        let previousScopeRow = tree.activeDeclarationLexicalScopeRow
        let forScopeRow =
            ParserValueExprAppendDeclarationLexicalScope(
                tree,
                ParserDeclarationLexicalScopeBlock,
                previousScopeRow,
                tree.activeFunctionDeclarationRow)
        tree.activeDeclarationLexicalScopeRow = forScopeRow
        ParserValueExprSetDeclarationLexicalScopeSpanTokens(
            tree, forScopeRow, first, tokenLimit)
        let forPatternStart = tree.patternCount
        if inIndex > first + 1:
            let patternRegionRow = tree.regionCount
            ParserValueExprAppendRegion(
                tree,
                ParserValueExprRegionPattern,
                ParserValueExprTokenSourceIdAt(tree, first + 1),
                ParserValueExprTokenStartAt(tree, first + 1),
                ParserValueExprTokenEndAt(tree, inIndex - 1),
                first + 1)
            if !ParserValueExprParsePatternListRange(
                   tree,
                   first + 1,
                   inIndex,
                   first,
                   tokenLimit,
                   false,
                   ParserPatternParseBindingDeclaration,
                   ParserPatternOwnerRegion,
                   patternRegionRow,
                   err):
                return false
        var cursor = inIndex + 1
        tree.activeDeclarationLexicalScopeRow = previousScopeRow
        var sourceRoot: int32
        if !ParserValueExprParseExpression(tree,
                                            cursor,
                                            tokenLimit,
                                            0,
                                            sourceRoot,
                                            err):
            return false
        tree.activeDeclarationLexicalScopeRow = forScopeRow
        if !ParserValueExprRegisterPatternBindings(
               tree,
               forPatternStart,
               ParserLexicalBindingIntroductionPatternIterator,
               -1,
               sourceRoot,
               cursor - 1,
               err):
            return false
        ParserValueExprAppendStatementRoot(
            tree,
            sourceRoot,
            ParserValueExprStatementLoopSource,
            first,
            ParserValueExprStatementEndTokenFor(
                tree,
                sourceRoot,
                first,
                cursor - 1))
        if cursor >= tokenLimit ||
           ParserValueExprTokenKindAt(tree, cursor) != ParserValueTokenColon:
            err = "parser value expr: for suite separator missing"
            return false
        cursor = cursor + 1
        if cursor >= tokenLimit:
            err = ParserValueExprAdmissionDiagnostic(
                tree,
                cursor - 1,
                "PARSER_EMPTY_SUITE_FORBIDDEN")
            return false
        if !ParserValueExprProcessSuiteRange(tree,
                                             cursor,
                                             tokenLimit,
                                             err):
            return false
        tree.activeDeclarationLexicalScopeRow = previousScopeRow
        return true
    if firstKind == ParserValueTokenOf:
        let colonIndex = ParserValueExprFindTopLevelKind(
            tree, first + 1, tokenLimit, ParserValueTokenColon)
        if colonIndex < 0:
            err = "parser value expr: case branch separator missing"
            return false
        let guardIndex = ParserValueExprFindTopLevelKind(
            tree, first + 1, colonIndex, ParserValueTokenIf)
        let previousScopeRow = tree.activeDeclarationLexicalScopeRow
        let caseArmScopeRow =
            ParserValueExprAppendDeclarationLexicalScope(
                tree,
                ParserDeclarationLexicalScopeBlock,
                previousScopeRow,
                tree.activeFunctionDeclarationRow)
        tree.activeDeclarationLexicalScopeRow = caseArmScopeRow
        ParserValueExprSetDeclarationLexicalScopeSpanTokens(
            tree, caseArmScopeRow, first, tokenLimit)
        if colonIndex > first + 1:
            let caseArmRegionRow = tree.regionCount
            ParserValueExprAppendRegion(
                tree,
                ParserValueExprRegionCaseArm,
                ParserValueExprTokenSourceIdAt(tree, first + 1),
                ParserValueExprTokenStartAt(tree, first + 1),
                ParserValueExprTokenEndAt(tree, colonIndex - 1),
                first + 1)
            var patternLimit = colonIndex
            if guardIndex >= 0:
                patternLimit = guardIndex
            if patternLimit > first + 1:
                var patternRoots: int32[]
                var entryExpressionRoots: int32[]
                let casePatternStart = tree.patternCount
                if !ParserValueExprParseCaseEntryListRange(
                       tree,
                       first + 1,
                       patternLimit,
                       first,
                       tokenLimit,
                       ParserPatternOwnerRegion,
                       caseArmRegionRow,
                       patternRoots,
                       entryExpressionRoots,
                       err):
                    return false
                if patternRoots.len > 1:
                    for patternRow in casePatternStart..<tree.patternCount:
                        if ParserPatternKind(arenamod.ArenaArrayInt32Get(
                               tree.arena,
                               tree.patternKinds,
                               patternRow)) == ParserPatternBinding:
                            err = "parser lexical binding: case alternatives with bindings require one exact pattern"
                            return false
                if !ParserValueExprRegisterPatternBindings(
                       tree,
                       casePatternStart,
                       ParserLexicalBindingIntroductionPatternEntry,
                       -1,
                       -1,
                       patternLimit - 1,
                       err):
                    return false
                for entryOffset in 0..<entryExpressionRoots.len:
                    let entryExpressionRoot =
                        entryExpressionRoots[entryOffset]
                    ParserValueExprAppendStatementRoot(
                        tree,
                        entryExpressionRoot,
                        ParserValueExprStatementCaseEntry,
                        first,
                        ParserValueExprStatementEndTokenFor(
                            tree,
                            entryExpressionRoot,
                            first + 1,
                            patternLimit - 1))
            else:
                err = "parser case entry: missing"
                return false
        if guardIndex >= 0 && guardIndex + 1 < colonIndex:
            var guardRoot: int32
            if !ParserValueExprParseExactRoot(tree,
                                               guardIndex + 1,
                                               colonIndex,
                                               ParserValueExprStatementCaseGuard,
                                               guardIndex,
                                               guardRoot,
                                               err):
                return false
        if colonIndex + 1 >= tokenLimit:
            err = ParserValueExprAdmissionDiagnostic(
                tree,
                colonIndex,
                "PARSER_EMPTY_SUITE_FORBIDDEN")
            return false
        let caseSuiteStart = colonIndex + 1
        if ParserValueExprTokenLineAt(tree, caseSuiteStart) ==
           ParserValueExprTokenLineAt(tree, colonIndex):
            if !ParserValueExprProcessStatementRangeWithTypeOwner(
                   tree,
                   caseSuiteStart,
                   tokenLimit,
                   false,
                   fieldDeclarationOwnerNodeIndex,
                   err):
                return false
        elif !ParserValueExprProcessSuiteRange(
                 tree,
                 caseSuiteStart,
                 tokenLimit,
                 err):
            return false
        tree.activeDeclarationLexicalScopeRow = previousScopeRow
        return true
    if firstKind == ParserValueTokenLet || firstKind == ParserValueTokenVar ||
       firstKind == ParserValueTokenConst:
        if first + 1 >= tokenLimit:
            err = "parser declaration: binding entry missing"
            return false
        return ParserValueExprProcessBindingEntryRange(
            tree,
            first + 1,
            tokenLimit,
            first,
            firstKind == ParserValueTokenVar,
            err)
    let armAssign = ParserValueExprFindTopLevelKind(
        tree, first, tokenLimit, ParserValueTokenAssign)
    if armAssign >= 0 && armAssign + 1 < tokenLimit &&
       ParserValueExprTokenKindAt(tree, armAssign + 1) ==
           ParserValueTokenGreater:
        if armAssign <= first:
            err = "parser match arm: pattern missing"
            return false
        if armAssign + 2 >= tokenLimit:
            err = "parser match arm: suite missing"
            return false
        let previousScopeRow = tree.activeDeclarationLexicalScopeRow
        let matchArmScopeRow =
            ParserValueExprAppendDeclarationLexicalScope(
                tree,
                ParserDeclarationLexicalScopeBlock,
                previousScopeRow,
                tree.activeFunctionDeclarationRow)
        tree.activeDeclarationLexicalScopeRow = matchArmScopeRow
        ParserValueExprSetDeclarationLexicalScopeSpanTokens(
            tree, matchArmScopeRow, first, tokenLimit)
        let caseArmRegionRow = tree.regionCount
        ParserValueExprAppendRegion(
            tree,
            ParserValueExprRegionCaseArm,
            ParserValueExprTokenSourceIdAt(tree, first),
            ParserValueExprTokenStartAt(tree, first),
            ParserValueExprTokenEndAt(tree, tokenLimit - 1),
            first)
        ParserValueExprAppendRegion(
            tree,
            ParserValueExprRegionPattern,
            ParserValueExprTokenSourceIdAt(tree, first),
            ParserValueExprTokenStartAt(tree, first),
            ParserValueExprTokenEndAt(tree, armAssign - 1),
            first)
        let matchArmPatternStart = tree.patternCount
        var patternRoot: int32
        if !ParserValueExprParsePatternRange(
               tree,
               first,
               armAssign,
               first,
               tokenLimit,
               false,
               ParserPatternParseMatchArm,
               patternRoot,
               err):
            return false
        ParserValueExprSetPatternRootOwner(
            tree,
            patternRoot,
            ParserPatternOwnerRegion,
            caseArmRegionRow)
        if !ParserValueExprRegisterPatternBindings(
               tree,
               matchArmPatternStart,
               ParserLexicalBindingIntroductionPatternEntry,
               -1,
               -1,
               armAssign - 1,
               err):
            return false
        let rhsStart = armAssign + 2
        var armOk = false
        if ParserValueExprTokenLineAt(tree, rhsStart) ==
           ParserValueExprTokenLineAt(tree, armAssign):
            armOk = ParserValueExprProcessStatementRangeWithTypeOwner(
                tree,
                rhsStart,
                tokenLimit,
                false,
                fieldDeclarationOwnerNodeIndex,
                err)
        else:
            armOk = ParserValueExprProcessSuiteRange(
                tree,
                rhsStart,
                tokenLimit,
                err)
        tree.activeDeclarationLexicalScopeRow = previousScopeRow
        return armOk
    let assignedFieldColon = ParserValueExprFindTopLevelKind(
        tree, first, armAssign >= 0 ? armAssign : tokenLimit,
        ParserValueTokenColon)
    var assignedFieldDeclarationRow: int32 = -1
    if assignedFieldColon > first && armAssign > assignedFieldColon:
        if !ParserValueExprTokenCanName(
               ParserValueExprTokenKindAt(tree, first)):
            err = "parser declaration: field name must be an identifier"
            return false
        if assignedFieldColon + 1 >= armAssign:
            err = "parser type syntax: assigned field type missing"
            return false
        ParserValueExprAppendRegion(
            tree,
            ParserValueExprRegionFieldDeclType,
            ParserValueExprTokenSourceIdAt(tree, assignedFieldColon + 1),
            ParserValueExprTokenStartAt(tree, assignedFieldColon + 1),
            ParserValueExprTokenEndAt(tree, armAssign - 1),
            assignedFieldColon + 1)
        var assignedFieldRoot: int32
        if !ParserValueExprAppendTypeSyntaxRootInto(
               tree,
               assignedFieldColon + 1,
               armAssign,
               first,
               ParserTypeSyntaxRootFieldDeclaration,
               false,
               fieldDeclarationOwnerNodeIndex,
               -1,
               assignedFieldRoot,
               err):
            return false
        let assignedOwnerGenericCount =
            ParserValueExprTypeSyntaxGenericSymbolCountAt(
                tree, fieldDeclarationOwnerNodeIndex)
        if assignedOwnerGenericCount > 0:
            ParserValueExprTypeSyntaxSetGenericSymbols(
                tree,
                assignedFieldRoot,
                ParserValueExprTypeSyntaxGenericSymbolStartAt(
                    tree, fieldDeclarationOwnerNodeIndex),
                assignedOwnerGenericCount)
        if tree.activeTypeDeclarationRow < 0:
            err = "parser declaration: assigned field owner missing"
            return false
        assignedFieldDeclarationRow = ParserValueExprAppendDeclaration(
            tree,
            ParserDeclarationField,
            first,
            tree.activeTypeDeclarationRow,
            tree.activeDeclarationLexicalScopeRow,
            -1,
            assignedFieldRoot,
            first,
            tokenLimit,
            false)
    if armAssign > first:
        ParserValueExprAppendRegion(
            tree,
            ParserValueExprRegionLValue,
            ParserValueExprTokenSourceIdAt(tree, first),
            ParserValueExprTokenStartAt(tree, first),
            ParserValueExprTokenEndAt(tree, armAssign - 1),
            first)
    if armAssign >= 0:
        if armAssign + 1 >= tokenLimit:
            err = "parser value expr: assignment value missing"
            return false
        var valueRoot: int32
        let valueRole =
            assignedFieldDeclarationRow >= 0 ?
                ParserValueExprStatementTypeDefault :
                ParserValueExprStatementAssignmentRhs
        if !ParserValueExprParseExactRoot(tree,
                                           armAssign + 1,
                                           tokenLimit,
                                           valueRole,
                                           armAssign,
                                           valueRoot,
                                           err):
            return false
        if assignedFieldDeclarationRow >= 0:
            ParserValueExprSetStatementRootDeclarationAuthority(
                tree,
                ParserValueExprNodeDirectStatementRootEventAt(
                    tree, valueRoot),
                assignedFieldDeclarationRow,
                1)
        return true
    let fieldColon = ParserValueExprFindTopLevelKind(
        tree, first, tokenLimit, ParserValueTokenColon)
    if fieldColon >= 0:
        let ternaryQuestion = ParserValueExprFindTopLevelKind(
            tree, first, fieldColon, ParserValueTokenQuestion)
        if ternaryQuestion >= 0:
            var ternaryRoot: int32
            return ParserValueExprParseExactRoot(tree,
                                                  first,
                                                  tokenLimit,
                                                  ParserValueExprStatementExpression,
                                                  first,
                                                  ternaryRoot,
                                                  err)
        # A field/type-only declaration has no value expression event. The
        # final colon of `field: object:` owns the nested objectFields suite;
        # it is not part of the field TypeSyntax.
        var fieldTypeLimit = tokenLimit
        if fieldTypeLimit > fieldColon + 1 &&
           ParserValueExprTokenKindAt(tree, fieldTypeLimit - 1) ==
               ParserValueTokenColon:
            fieldTypeLimit = fieldTypeLimit - 1
        if fieldColon + 1 >= fieldTypeLimit:
            err = "parser type syntax: field declaration type missing"
            return false
        if !ParserValueExprTokenCanName(
               ParserValueExprTokenKindAt(tree, first)):
            err = "parser declaration: field name must be an identifier"
            return false
        ParserValueExprAppendRegion(
            tree,
            ParserValueExprRegionFieldDeclType,
            ParserValueExprTokenSourceIdAt(tree, fieldColon + 1),
            ParserValueExprTokenStartAt(tree, fieldColon + 1),
            ParserValueExprTokenEndAt(tree, fieldTypeLimit - 1),
            fieldColon + 1)
        var fieldRoot: int32
        if !ParserValueExprAppendTypeSyntaxRootInto(
               tree,
               fieldColon + 1,
               fieldTypeLimit,
               first,
               ParserTypeSyntaxRootFieldDeclaration,
               false,
               fieldDeclarationOwnerNodeIndex,
               -1,
               fieldRoot,
               err):
            return false
        let fieldOwnerGenericCount =
            ParserValueExprTypeSyntaxGenericSymbolCountAt(
                tree, fieldDeclarationOwnerNodeIndex)
        if fieldOwnerGenericCount > 0:
            ParserValueExprTypeSyntaxSetGenericSymbols(
                tree,
                fieldRoot,
                ParserValueExprTypeSyntaxGenericSymbolStartAt(
                    tree, fieldDeclarationOwnerNodeIndex),
                fieldOwnerGenericCount)
        if tree.activeTypeDeclarationRow < 0:
            err = "parser declaration: field owner missing"
            return false
        ParserValueExprAppendDeclaration(
            tree,
            ParserDeclarationField,
            first,
            tree.activeTypeDeclarationRow,
            tree.activeDeclarationLexicalScopeRow,
            -1,
            fieldRoot,
            first,
            tokenLimit,
            false)
        return true
    var expressionRoot: int32
    return ParserValueExprParseExactRoot(tree,
                                          first,
                                          tokenLimit,
                                          ParserValueExprStatementExpression,
                                          first,
                                          expressionRoot,
                                          err)

fn ParserValueExprProcessStatementRangeWithTypeOwner(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32,
        importcAnnotationPending: bool,
        fieldDeclarationOwnerNodeIndex: int32,
        err: var str): bool =
    let coreStart = parserForwardingStatementCoreStart(
        tree, tokenStart, tokenLimit)
    let armIndex = parserForwardingStatementCoreArm(
        tree,
        tokenStart,
        tokenLimit,
        fieldDeclarationOwnerNodeIndex)
    if armIndex == -1:
        return parserValueExprProcessStatementCoreRangeWithTypeOwner(
            tree,
            tokenStart,
            tokenLimit,
            importcAnnotationPending,
            fieldDeclarationOwnerNodeIndex,
            err)
    if armIndex == -3:
        # 孤儿 elif/else（缺 if 头）= 规范非法形，硬门禁拒收；不产任何壳
        # 产线，杜绝 arm2 兜底双认领路径。
        err = ParserValueExprAdmissionDiagnostic(
            tree,
            coreStart,
            "PARSER_BRANCH_WITHOUT_IF")
        return false
    if armIndex == -2:
        let patternStart = tree.patternCount
        let matchArmRow = parserForwardingProductionBegin(
            tree,
            ParserForwardingProductionMatchArm,
            -1,
            coreStart,
            tokenStart,
            tokenLimit - 1)
        if !parserValueExprProcessStatementCoreRangeWithTypeOwner(
               tree,
               tokenStart,
               tokenLimit,
               importcAnnotationPending,
               fieldDeclarationOwnerNodeIndex,
               err):
            return false
        if tree.patternCount <= patternStart:
            panic("parser forwarding production: match arm pattern missing")
        var patternAuthorityRow: int32 = -1
        for patternRow in patternStart..<tree.patternCount:
            if ParserPatternOwnerKind(arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.patternOwnerKinds,
                   patternRow)) != ParserPatternOwnerRegion:
                continue
            let ownerRegion = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.patternOwnerRows, patternRow)
            if ownerRegion < 0 || ownerRegion >= tree.regionCount ||
               ParserValueExprRegionKind(arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.regionKinds,
                   ownerRegion)) != ParserValueExprRegionCaseArm ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.regionSpanStarts,
                   ownerRegion) !=
                   ParserValueExprTokenStartAt(tree, tokenStart) ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.regionSpanEnds,
                   ownerRegion) !=
                   ParserValueExprTokenEndAt(tree, tokenLimit - 1):
                continue
            if patternAuthorityRow >= 0:
                panic("parser forwarding production: duplicate match arm pattern root")
            patternAuthorityRow = patternRow
        if patternAuthorityRow < 0:
            panic("parser forwarding production: match arm pattern root missing")
        parserForwardingProductionFinish(
            tree,
            matchArmRow,
            ParserForwardingProductionChildPattern,
            patternAuthorityRow,
            -1,
            0)
        return true
    let annotationStart = tree.annotationCount
    let statementRow = parserForwardingProductionBegin(
        tree,
        ParserForwardingProductionStatement,
        -1,
        coreStart,
        tokenStart,
        tokenLimit - 1)
    let coreRow = parserForwardingProductionBegin(
        tree,
        ParserForwardingProductionStatementCore,
        armIndex,
        coreStart,
        coreStart,
        tokenLimit - 1)
    let nodeStart = tree.nodeCount
    let statementRootStart = tree.statementRootCount
    let declarationStart = tree.declarationCount
    let patternStart = tree.patternCount
    let scopeStart = tree.declarationLexicalScopeCount
    if !parserValueExprProcessStatementCoreRangeWithTypeOwner(
           tree,
           tokenStart,
           tokenLimit,
           importcAnnotationPending,
           fieldDeclarationOwnerNodeIndex,
           err):
        return false
    var authorityKind = ParserForwardingProductionChildToken
    var authorityRow = coreStart
    # Statement-root authority must be the root whose exact role (and, for
    # assignment-shaped arms, anchor token) matches this arm's contract.
    # statementRootStart is merely the first NEW root of the range: nested
    # statements inside the initializer/RHS may append their own roots before
    # the outer binding/assignment root, so the first root is not necessarily
    # the authority target.  Selecting blindly recorded e.g. an inner
    # AssignmentRhs root for an arm-0 binding and crashed child layout with
    # "binding initializer declaration authority missing".
    var expectedRoleA: int32 = -1
    var expectedRoleB: int32 = -1
    var authorityAnchorRequired = false
    if armIndex == 0:
        # 首选 BindingInitializer；通配符丢弃绑定 `let _ = expr` 不创建声明
        # 行，其语句根是 AssignmentRhs——由 expectedRoleB 兜底。
        expectedRoleA = Int32(ParserValueExprStatementBindingInitializer)
        expectedRoleB = Int32(ParserValueExprStatementAssignmentRhs)
        authorityAnchorRequired = true
    elif armIndex == 2:
        expectedRoleA = Int32(ParserValueExprStatementAssignmentRhs)
        authorityAnchorRequired = true
    elif armIndex == 3:
        expectedRoleA = Int32(ParserValueExprStatementReturnValue)
    elif armIndex == 4:
        expectedRoleA = Int32(ParserValueExprStatementYieldValue)
    elif armIndex == 8 || armIndex == 9 || armIndex == 10 ||
         armIndex == 12 || armIndex == 13:
        expectedRoleA = Int32(ParserValueExprStatementCondition)
    elif armIndex == 11:
        expectedRoleA = Int32(ParserValueExprStatementLoopSource)
    elif armIndex == 21:
        expectedRoleA = Int32(ParserValueExprStatementExpression)
        expectedRoleB = Int32(ParserValueExprStatementImplicitReturnValue)
    if expectedRoleA >= 0 && tree.statementRootCount > statementRootStart:
        var authorityAnchorToken = -1
        if authorityAnchorRequired:
            # 与 seal 校验器同口径：StatementCore production 的 span 起点是
            # coreStart（非语句起点 tokenStart），顶层 `=` 必须在该 span 内。
            authorityAnchorToken = ParserValueExprFindTopLevelKind(
                tree,
                coreStart,
                tokenLimit,
                ParserValueTokenAssign)
        let matchedRoot = parserForwardingProductionFindStatementAuthorityRoot(
            tree,
            statementRootStart,
            expectedRoleA,
            expectedRoleB,
            authorityAnchorRequired,
            authorityAnchorToken)
        if matchedRoot >= 0:
            authorityKind = ParserForwardingProductionChildStatementRoot
            authorityRow = matchedRoot
    if authorityKind == ParserForwardingProductionChildToken:
        if armIndex == 0:
            # Binding without a binding-initializer statement root: fall back
            # to the pattern authority (validator accepts either form).
            if tree.patternCount > patternStart:
                var patternRoot: int32 = -1
                for patternRow in patternStart..<tree.patternCount:
                    if ParserPatternOwnerKind(arenamod.ArenaArrayInt32Get(
                           tree.arena,
                           tree.patternOwnerKinds,
                           patternRow)) != ParserPatternOwnerRegion:
                        continue
                    let regionRow = arenamod.ArenaArrayInt32Get(
                        tree.arena, tree.patternOwnerRows, patternRow)
                    if regionRow < 0 || regionRow >= tree.regionCount ||
                       ParserValueExprRegionKind(arenamod.ArenaArrayInt32Get(
                           tree.arena,
                           tree.regionKinds,
                           regionRow)) != ParserValueExprRegionPattern:
                        continue
                    if patternRoot >= 0:
                        panic("parser forwarding production: duplicate binding pattern root")
                    patternRoot = patternRow
                if patternRoot < 0:
                    panic("parser forwarding production: binding pattern root missing")
                authorityKind = ParserForwardingProductionChildPattern
                authorityRow = patternRoot
        elif (armIndex == 1 || armIndex >= 15 && armIndex <= 20) &&
             tree.declarationCount > declarationStart:
            authorityKind = ParserForwardingProductionChildDeclaration
            authorityRow = declarationStart
        elif (armIndex == 7 || armIndex == 14) &&
             tree.declarationLexicalScopeCount > scopeStart:
            authorityKind = ParserForwardingProductionChildLexicalScope
            authorityRow = scopeStart
        elif tree.nodeCount > nodeStart &&
             armIndex != 3 && armIndex != 4 &&
             armIndex != 5 && armIndex != 6:
            authorityKind = ParserForwardingProductionChildValueNode
            authorityRow = nodeStart
    parserForwardingProductionFinish(
        tree,
        coreRow,
        authorityKind,
        authorityRow,
        -1,
        0)
    let addedAnnotationCount = tree.annotationCount - annotationStart
    parserForwardingProductionFinish(
        tree,
        statementRow,
        ParserForwardingProductionChildInvalid,
        -1,
        addedAnnotationCount > 0 ? annotationStart : -1,
        addedAnnotationCount)
    return true

fn ParserValueExprProcessStatementRange(tree: var ParserValueExprTree,
                                          tokenStart: int32,
                                          tokenLimit: int32,
                                          importcAnnotationPending: bool,
                                          err: var str): bool =
    return ParserValueExprProcessStatementRangeWithTypeOwner(
        tree,
        tokenStart,
        tokenLimit,
        importcAnnotationPending,
        -1,
        err)

@borrows
fn ParserValueExprMultilineValueStart(tree: ParserValueExprTree,
                                        tokenStart: int32,
                                        lineLimit: int32,
                                        valueStartOut: var int32): bool =
    valueStartOut = tokenStart
    if tokenStart >= lineLimit:
        return false
    let firstKind = ParserValueExprTokenKindAt(tree, tokenStart)
    var wrappedValue = false
    if firstKind == ParserValueTokenLet || firstKind == ParserValueTokenVar ||
       firstKind == ParserValueTokenConst:
        let assignIndex = ParserValueExprFindTopLevelKind(
            tree, tokenStart + 1, lineLimit, ParserValueTokenAssign)
        if assignIndex < 0 || assignIndex + 1 >= lineLimit:
            return false
        valueStartOut = assignIndex + 1
        wrappedValue = true
    elif firstKind == ParserValueTokenReturn ||
         firstKind == ParserValueTokenYield:
        if tokenStart + 1 >= lineLimit:
            return false
        valueStartOut = tokenStart + 1
        wrappedValue = true
    let valueKind = ParserValueExprTokenKindAt(tree, valueStartOut)
    if valueKind == ParserValueTokenCase ||
       valueKind == ParserValueTokenIf ||
       valueKind == ParserValueTokenWhen:
        return true
    return wrappedValue &&
           (valueKind == ParserValueTokenFn ||
            valueKind == ParserValueTokenIterator)

@borrows
fn ParserValueExprStatementStartsIndentedSuite(
        tree: ParserValueExprTree,
        tokenStart: int32,
        lineLimit: int32): bool =
    let kind = ParserValueExprTokenKindAt(tree, tokenStart)
    let armAssign = ParserValueExprFindTopLevelKind(
        tree, tokenStart, lineLimit, ParserValueTokenAssign)
    if armAssign >= tokenStart &&
       armAssign + 2 < lineLimit &&
       ParserValueExprTokenKindAt(tree, armAssign + 1) ==
           ParserValueTokenGreater:
        return ParserValueExprStatementStartsIndentedSuite(
            tree, armAssign + 2, lineLimit)
    if kind == ParserValueTokenBlock:
        let colonIndex = ParserValueExprFindTopLevelKind(
            tree, tokenStart + 1, lineLimit, ParserValueTokenColon)
        let assignIndex = ParserValueExprFindTopLevelKind(
            tree, tokenStart + 1, lineLimit, ParserValueTokenAssign)
        return colonIndex >= 0 &&
               (assignIndex < 0 || colonIndex < assignIndex)
    return kind == ParserValueTokenIf ||
           kind == ParserValueTokenWhen ||
           kind == ParserValueTokenElif ||
           kind == ParserValueTokenElse ||
           kind == ParserValueTokenWhile ||
           kind == ParserValueTokenFor ||
           kind == ParserValueTokenMatch ||
           kind == ParserValueTokenCase ||
           kind == ParserValueTokenOf ||
           kind == ParserValueTokenDefer

@borrows
fn ParserValueExprExtendIndentedValueRange(tree: ParserValueExprTree,
                                             tokenStart: int32,
                                             lineLimit: int32,
                                             tokenLimit: int32): int32 =
    var valueStart: int32
    let ownsStatementSuite = ParserValueExprStatementStartsIndentedSuite(
        tree, tokenStart, lineLimit)
    let ownsMultilineValue =
        ParserValueExprMultilineValueStart(tree,
                                            tokenStart,
                                            lineLimit,
                                            valueStart)
    let headerKind = ParserValueExprTokenKindAt(tree, tokenStart)
    # 规范 §stmt/ifStmt（docs/cheng-formal-spec.md:345）：elif/else 分支属于
    # 其 if/when 语句——无论套件是缩进形还是 `cond: stmt` 行内形，同列后随
    # 的分支头都必须并入本语句范围。authority-reused-20260827 根修：此前仅
    # 缩进形续链，行内形 elif/else 落单成独立语句范围后被分类器 arm2 兜底
    # 误吞成赋值壳产线，与真实行内体产线双认领同一 AssignmentRhs root。
    let ownsBranchChainFollowers =
        (headerKind == ParserValueTokenIf ||
         headerKind == ParserValueTokenWhen ||
         headerKind == ParserValueTokenElif)
    if !ownsStatementSuite && !ownsMultilineValue &&
       !ownsBranchChainFollowers:
        return lineLimit
    let lastKind = ParserValueExprTokenKindAt(tree, lineLimit - 1)
    let colonlessCase =
        ownsMultilineValue &&
        ParserValueExprTokenKindAt(tree, valueStart) ==
            ParserValueTokenCase
    # 规范 §expr/ifExpr（docs/cheng-formal-spec.md:488）：else 是 ifExpr 必备
    # 分支，值位置跨行 if/elif/else 链属合法形（C 链
    # parse_multiline_if_let_binding + cold_emit_multiline_value_if 以 if
    # 缩进显式支持整链）。value 头是 if/when 时，与 value 头同列的后随
    # elif/else 行在规范上唯一属于该条件链，必须并入本语句范围，否则链尾
    # 落单成独立语句、ifExpr 解析窗口内无 else → `if expression else
    # missing`（GEN2 自烤 rc=2@66s 墙，wall152 同族）。
    let valueIsConditional =
        ownsMultilineValue &&
        (ParserValueExprTokenKindAt(tree, valueStart) ==
             ParserValueTokenIf ||
         ParserValueExprTokenKindAt(tree, valueStart) ==
             ParserValueTokenWhen)
    let ownsIndentedBody = ownsStatementSuite || ownsMultilineValue
    let swallowsIndentedBody =
        lastKind == ParserValueTokenColon ||
        lastKind == ParserValueTokenAssign ||
        colonlessCase
    if ownsIndentedBody && !swallowsIndentedBody &&
       !ownsBranchChainFollowers && !valueIsConditional:
        return lineLimit
    let headerIndent = ParserValueExprTokenColumnAt(tree, tokenStart)
    # 分支链吞并列：value 条件链取 value 头列（elif/else 与 if 同列），
    # 语句头条件链取语句头列——两者对语句头 if/when 重合（valueStart 即
    # tokenStart），行为逐字节不变。
    var chainIndent = headerIndent
    if valueIsConditional:
        chainIndent = ParserValueExprTokenColumnAt(tree, valueStart)
    var cursor = lineLimit
    if ownsIndentedBody && swallowsIndentedBody:
        while cursor < tokenLimit:
            if ParserValueExprTokenColumnAt(tree, cursor) <= headerIndent:
                break
            let next = ParserValueExprLogicalLineEnd(tree, cursor, tokenLimit)
            if next <= cursor:
                break
            cursor = next
    if ownsBranchChainFollowers || valueIsConditional:
        while cursor < tokenLimit:
            if ParserValueExprTokenColumnAt(tree, cursor) != chainIndent:
                break
            let branchKind = ParserValueExprTokenKindAt(tree, cursor)
            if branchKind != ParserValueTokenElif &&
               branchKind != ParserValueTokenElse:
                break
            var next = ParserValueExprLogicalLineEnd(
                tree, cursor, tokenLimit)
            next = ParserValueExprExtendIndentedValueRange(
                tree, cursor, next, tokenLimit)
            if next <= cursor:
                panic("parser value expr: conditional branch made no progress")
            cursor = next
            if branchKind == ParserValueTokenElse:
                break
    if cursor == lineLimit &&
       ParserValueExprTokenKindAt(tree, tokenStart) ==
           ParserValueTokenCase:
        let headerColon = ParserValueExprFindTopLevelKind(
            tree,
            tokenStart + 1,
            lineLimit,
            ParserValueTokenColon)
        let headerHasInlineSuite =
            headerColon >= 0 && headerColon + 1 < lineLimit
        if !headerHasInlineSuite:
            while cursor < tokenLimit &&
                  ParserValueExprTokenColumnAt(tree, cursor) ==
                      headerIndent &&
                  (ParserValueExprTokenKindAt(tree, cursor) ==
                       ParserValueTokenOf ||
                   ParserValueExprTokenKindAt(tree, cursor) ==
                       ParserValueTokenElse):
                var next = ParserValueExprLogicalLineEnd(
                    tree, cursor, tokenLimit)
                next = ParserValueExprExtendIndentedValueRange(
                    tree, cursor, next, tokenLimit)
                if next <= cursor:
                    panic("parser value expr: unindented case branch made no progress")
                cursor = next
    return cursor

# 归类缺口根修（routine suite assignment missing 族）：多行签名的返回类型可
# 以换行紧跟在参数右括号冒号之后（`):\n    RetType =`）。逻辑行扫描把行尾
# depth-0 冒号视为语句终止（缩进套件分界），因此头部在返回类型行之前被切
# 断，suite `=` 不入语句范围而被误判缺套件。仅在例程关键字语句上、且截断
# 点为「括号配平且无顶层 `=` 的行尾冒号」时，逐行吞并更深缩进的续行直到顶
# 层 `=`。负例保真：无后续行、非配平冒号、已含顶层 `=`、跟随列不深于声明
# 列的形状一律原样返回，既有硬错误不弱化。
@borrows
fn ParserValueExprExtendRoutineHeaderReturnType(
        tree: ParserValueExprTree,
        tokenStart: int32,
        lineLimit: int32,
        tokenLimit: int32): int32 =
    if lineLimit <= tokenStart || lineLimit > tokenLimit:
        return lineLimit
    let headerColumn = ParserValueExprTokenColumnAt(tree, tokenStart)
    var sawSuiteAssign = false
    var cursor = lineLimit
    while cursor < tokenLimit && cursor > tokenStart &&
          ParserValueExprTokenKindAt(tree, cursor - 1) ==
              ParserValueTokenColon &&
          ParserValueExprTokenColumnAt(tree, cursor) > headerColumn:
        var parenDepth: int32
        var bracketDepth: int32
        var braceDepth: int32
        var balanced = true
        var sawTopLevelAssign = false
        var walk = tokenStart
        while walk < cursor - 1 && balanced:
            let walkKind = ParserValueExprTokenKindAt(tree, walk)
            if walkKind == ParserValueTokenLeftParen:
                parenDepth = parenDepth + 1
            elif walkKind == ParserValueTokenRightParen:
                parenDepth = parenDepth - 1
            elif walkKind == ParserValueTokenLeftBracket:
                bracketDepth = bracketDepth + 1
            elif walkKind == ParserValueTokenRightBracket:
                bracketDepth = bracketDepth - 1
            elif walkKind == ParserValueTokenLeftBrace:
                braceDepth = braceDepth + 1
            elif walkKind == ParserValueTokenRightBrace:
                braceDepth = braceDepth - 1
            elif parenDepth == 0 && bracketDepth == 0 &&
                 braceDepth == 0 && walk > tokenStart &&
                 walkKind == ParserValueTokenAssign:
                sawTopLevelAssign = true
            if parenDepth < 0 || bracketDepth < 0 || braceDepth < 0:
                balanced = false
            walk = walk + 1
        if !balanced || sawTopLevelAssign ||
           parenDepth != 0 || bracketDepth != 0 || braceDepth != 0:
            break
        let logicalEnd = ParserValueExprLogicalLineEnd(
            tree, cursor, tokenLimit)
        if logicalEnd <= cursor:
            break
        # 续行吞并的终点必须落在本逻辑行内首个 depth-0 套件赋值 `=` 上：
        # 逻辑行扫描把行尾 `=` 视为续行符（TokenContinuesLine），不加帽
        # 会把缩进套件首语句一并吞进头部范围，终端守卫随之失效（8/16
        # stage3 接受的 `):\n    RetType =` 形被误判缺套件）。
        # `=` 为物理行行尾 → 止于 `=` 之后，缩进套件体由
        # ParserValueExprExtendRoutineSuiteRange 按缩进接管；
        # `=` 同行后随 token（行内套件，stage3 合法的
        # `):\n    RetType = stmt` 形）→ 止于逻辑行尾，行内体并入头部。
        var next = logicalEnd
        var capWalk = cursor
        var capParenDepth: int32
        var capBracketDepth: int32
        var capBraceDepth: int32
        while capWalk < logicalEnd:
            let capKind = ParserValueExprTokenKindAt(tree, capWalk)
            if capKind == ParserValueTokenLeftParen:
                capParenDepth = capParenDepth + 1
            elif capKind == ParserValueTokenRightParen:
                capParenDepth = capParenDepth - 1
            elif capKind == ParserValueTokenLeftBracket:
                capBracketDepth = capBracketDepth + 1
            elif capKind == ParserValueTokenRightBracket:
                capBracketDepth = capBracketDepth - 1
            elif capKind == ParserValueTokenLeftBrace:
                capBraceDepth = capBraceDepth + 1
            elif capKind == ParserValueTokenRightBrace:
                capBraceDepth = capBraceDepth - 1
            elif capParenDepth == 0 && capBracketDepth == 0 &&
                 capBraceDepth == 0 &&
                 capKind == ParserValueTokenAssign:
                let assignLineEnd = ParserValueExprPhysicalLineEnd(
                    tree, capWalk, logicalEnd)
                sawSuiteAssign = true
                next = capWalk + 1 < assignLineEnd ? logicalEnd :
                    capWalk + 1
                break
            capWalk = capWalk + 1
        cursor = next
    # 合法续行链必须含有套件赋值（行尾 `=` 或带行内体的 `=`）；否则被截
    # 断处之后根本不是返回类型而是无套件赋值的缩进块——整体回退原始边
    # 界，维持既有硬错误。含 `=` 形状的语句级正误（返回类型是否合法类
    # 型表达式）由例程解析器与语义阶段裁决，与 8/16 stage3 口径一致。
    if cursor == lineLimit:
        return lineLimit
    if !sawSuiteAssign &&
       ParserValueExprTokenKindAt(tree, cursor - 1) !=
           ParserValueTokenAssign:
        # 无套件 Form-B 单行帽（@importc 前向声明 `fn f():\n    RetType`）：
        # 续行恰好一行且其后无更深缩进延续（下一 token 回到声明列或更外，
        # 或 EOF）时接受吞并——bodiless 合法性由 ProcessRoutineRange 的
        # bodilessImportcAllowed 裁决（非 importc 缺套件例程仍在
        # "routine suite assignment missing" 硬错误，不弱化）; 续行后仍有
        # 更深缩进块（无 `=` 的缩进体）维持回退。
        if cursor >= tokenLimit ||
           ParserValueExprTokenColumnAt(tree, cursor) <= headerColumn:
            return cursor
        # Form-B `):\n    RetType\n    =\n    body`：下一 token 是缩进 `=`。
        # 并入头部（行尾 `=` 止于 `=` 之后；行内 `= stmt` 止于逻辑行尾），
        # 缩进套件由 ExtendRoutineSuiteRange 接管。禁止回退到 lineLimit。
        if ParserValueExprTokenKindAt(tree, cursor) ==
               ParserValueTokenAssign:
            let assignLineEnd = ParserValueExprPhysicalLineEnd(
                tree, cursor, tokenLimit)
            if cursor + 1 < assignLineEnd:
                return ParserValueExprLogicalLineEnd(
                    tree, cursor, tokenLimit)
            return cursor + 1
        return lineLimit
    return cursor

# A multiline routine suite starts after a top-level `=` whose next token is
# on a later physical line.  The ordinary logical-line scanner deliberately
# stops after the first complete body statement, so routine boundaries must be
# extended by declaration indentation while the parser still owns exact token
# columns.  Inline routines keep their original logical-line limit.
@borrows
fn ParserValueExprExtendRoutineSuiteRange(tree: ParserValueExprTree,
                                            tokenStart: int32,
                                            lineLimit: int32,
                                            tokenLimit: int32): int32 =
    # The suite assign is the one after the signature (keyword, name, params);
    # a backtick-quoted operator name may itself contain `=` at depth 0, so
    # skip keyword(s) and the backtick name before searching.
    var assignSearchStart = tokenStart
    while assignSearchStart < lineLimit &&
          (ParserValueExprTokenKindAt(tree, assignSearchStart) ==
               ParserValueTokenFn ||
           ParserValueExprTokenKindAt(tree, assignSearchStart) ==
               ParserValueTokenIterator ||
           ParserValueExprTokenKindAt(tree, assignSearchStart) ==
               ParserValueTokenMacro ||
           ParserValueExprTokenKindAt(tree, assignSearchStart) ==
               ParserValueTokenTemplate ||
           ParserValueExprTokenKindAt(tree, assignSearchStart) ==
               ParserValueTokenAsync):
        assignSearchStart = assignSearchStart + 1
    assignSearchStart = ParserValueExprSkipBacktickName(
        tree, assignSearchStart, lineLimit)
    let assignIndex = ParserValueExprFindTopLevelKind(
        tree, assignSearchStart, lineLimit, ParserValueTokenAssign)
    if assignIndex < 0 || assignIndex + 1 >= tokenLimit:
        return lineLimit
    if ParserValueExprTokenLineAt(tree, assignIndex + 1) ==
       ParserValueExprTokenLineAt(tree, assignIndex):
        return lineLimit
    let headerColumn = ParserValueExprTokenColumnAt(tree, tokenStart)
    var cursor = assignIndex + 1
    while cursor < tokenLimit:
        if ParserValueExprTokenColumnAt(tree, cursor) <= headerColumn:
            break
        var statementLimit = ParserValueExprLogicalLineEnd(
            tree, cursor, tokenLimit)
        statementLimit = ParserValueExprExtendIndentedValueRange(
            tree, cursor, statementLimit, tokenLimit)
        if statementLimit <= cursor:
            panic("parser value expr: routine suite extension made no progress")
        cursor = statementLimit
    if cursor < lineLimit:
        return lineLimit
    return cursor

fn parserTypeSyntaxAppendConstNode(
        tree: var ParserValueExprTree,
        producerSourceIndex: int32,
        kind: ParserTypeConstExprKind,
        tokenIndex: int32,
        leftChild: int32,
        rightChild: int32,
        integerValue: int32): int32 =
    if tree == nil ||
       tree.lifecycleState != ParserValueExprOwnerActive ||
       producerSourceIndex < 0 ||
       producerSourceIndex >= tree.producerSourceCount ||
       tokenIndex < 0 || tokenIndex >= tree.tokenCount ||
       leftChild >= tree.typeConstExprCount ||
       rightChild >= tree.typeConstExprCount:
        panic("parser TypeSyntax: invalid const AST append")
    let nodeIndex = tree.typeConstExprCount
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.typeConstExprKinds, Int32(kind))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.typeConstExprProducerSourceIndexes,
        producerSourceIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.typeConstExprTokenIndexes, tokenIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.typeConstExprLeftChildIndexes,
        leftChild)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.typeConstExprRightChildIndexes,
        rightChild)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.typeConstExprIntegerValues,
        integerValue)
    tree.typeConstExprCount = nodeIndex + 1
    return nodeIndex

# [S1b step-3 (9)] One module const binding entry: `Name [: Type] = Value`.
# Only a plain single-name binding enters the table; anything else (a
# destructuring pattern, a `:=` form the declaration walk rejects, an entry with
# no initializer) is skipped -- it simply has no const value to resolve, and the
# declaration walk itself still owns every diagnostic about its shape.
fn parserTypeSyntaxModuleConstEntryInto(
        tree: var ParserValueExprTree,
        entryStart: int32,
        entryLimit: int32,
        err: var str): bool =
    err = ""
    if entryStart < 0 || entryLimit <= entryStart ||
       entryLimit > tree.tokenCount ||
       !ParserValueExprTokenCanName(
           ParserValueExprTokenKindAt(tree, entryStart)):
        return true
    let assignIndex = ParserValueExprFindTopLevelKind(
        tree, entryStart, entryLimit, ParserValueTokenAssign)
    if assignIndex <= entryStart:
        return true
    let colonIndex = ParserValueExprFindTopLevelKind(
        tree, entryStart, assignIndex, ParserValueTokenColon)
    if colonIndex >= 0 && colonIndex != entryStart + 1:
        return true
    let hasAnnotation = colonIndex >= 0 && colonIndex + 1 < assignIndex
    var annotationIsInt32 = true
    if hasAnnotation:
        annotationIsInt32 =
            colonIndex + 2 == assignIndex &&
            ParserValueExprTokenTextEqualsText(tree, colonIndex + 1,
                                               "int32")
    var int32Flag = false
    var value: int32
    if annotationIsInt32:
        int32Flag = parserTypeSyntaxModuleConstValueInto(
            tree, assignIndex + 1, entryLimit, value)
    return parserTypeSyntaxModuleConstRegister(
        tree, entryStart, int32Flag, value, err)

# [S1b step-3 (9)] Module const collection: one pre-pass over the freshly lexed
# tokens, before any statement or type syntax is produced.  Scanning the token
# stream (rather than registering bindings as the declaration walk reaches
# them) is what makes a `T[NAME]` written ABOVE its `const` resolve: the spec
# requires only that N be a compile-time constant
# (docs/cheng-formal-spec.md:555), and the C chain's symbols table is likewise
# complete before it parses a type.  Only module-level `const` declarations are
# collected -- never `type` names, which stay type arguments.
fn parserTypeSyntaxModuleConstCollectInto(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenCount: int32,
        err: var str): bool =
    err = ""
    if tree == nil || tokenStart < 0 || tokenCount < 0 ||
       tokenStart + tokenCount > tree.tokenCount:
        err = "parser type syntax: module const scan range invalid"
        return false
    let tokenLimit = tokenStart + tokenCount
    let moduleColumn = ParserValueExprTokenColumnAt(tree, tokenStart)
    var cursor = tokenStart
    var blockColumn: int32 = -1
    while cursor < tokenLimit:
        var lineEnd = ParserValueExprLogicalLineEnd(tree, cursor, tokenLimit)
        lineEnd = ParserValueExprExtendIndentedValueRange(
            tree, cursor, lineEnd, tokenLimit)
        if lineEnd <= cursor:
            err = "parser type syntax: module const scan made no progress"
            return false
        let lineColumn = ParserValueExprTokenColumnAt(tree, cursor)
        if blockColumn >= 0 && lineColumn <= blockColumn:
            blockColumn = -1
        if lineColumn == moduleColumn &&
           ParserValueExprTokenKindAt(tree, cursor) ==
               ParserValueTokenConst:
            if cursor + 1 == lineEnd:
                blockColumn = lineColumn
                cursor = lineEnd
                continue
            if !parserTypeSyntaxModuleConstEntryInto(
                   tree, cursor + 1, lineEnd, err):
                return false
            cursor = lineEnd
            continue
        if blockColumn >= 0 && lineColumn > blockColumn:
            let entryLimit = ParserValueExprExtendBindingEntryFormB(
                tree, cursor, lineEnd, tokenLimit)
            if !parserTypeSyntaxModuleConstEntryInto(
                   tree, cursor, entryLimit, err):
                return false
            cursor = entryLimit
            continue
        cursor = lineEnd
    err = ""
    return true

fn parserTypeSyntaxConstTokensOnly(
        tree: var ParserValueExprTree,
        tokenStart: int32,
        tokenLimit: int32): bool =
    if tokenStart < 0 || tokenLimit <= tokenStart ||
       tokenLimit > tree.tokenCount:
        return false
    # [S1b step-3 (9)] A module const name is an ordinary leaf of the const
    # grammar (C chain: cold_eval_i32_const_expr's leaf branch tries
    # symbols_find_const).  Whether the name really is a const is decided by
    # parserTypeSyntaxParseConstPrimary, which fails loudly when the table has
    # no such row.
    for tokenIndex in tokenStart..<tokenLimit:
        let kind = ParserValueExprTokenKindAt(tree, tokenIndex)
        if kind != ParserValueTokenInteger &&
           kind != ParserValueTokenPlus &&
           kind != ParserValueTokenMinus &&
           kind != ParserValueTokenStar &&
           kind != ParserValueTokenSlash &&
           kind != ParserValueTokenPercent &&
           kind != ParserValueTokenLeftParen &&
           kind != ParserValueTokenRightParen &&
           !parserTypeSyntaxTokenCanName(kind):
            return false
    return true

fn parserTypeSyntaxParseConstPrimary(
        tree: var ParserValueExprTree,
        producerSourceIndex: int32,
        cursor: var int32,
        tokenLimit: int32,
        rootOut: var int32,
        errorText: var str): bool =
    rootOut = -1
    if cursor < 0 || cursor >= tokenLimit:
        errorText = "parser TypeSyntax: const primary missing"
        return false
    let tokenIndex = cursor
    let kind = ParserValueExprTokenKindAt(tree, tokenIndex)
    if kind == ParserValueTokenPlus || kind == ParserValueTokenMinus:
        cursor = cursor + 1
        var child: int32
        if !parserTypeSyntaxParseConstPrimary(
               tree,
               producerSourceIndex,
               cursor,
               tokenLimit,
               child,
               errorText):
            return false
        rootOut = parserTypeSyntaxAppendConstNode(
            tree,
            producerSourceIndex,
            kind == ParserValueTokenPlus ?
                ParserTypeConstExprUnaryPlus :
                ParserTypeConstExprUnaryMinus,
            tokenIndex,
            child,
            -1,
            0)
        return true
    if kind == ParserValueTokenLeftParen:
        cursor = cursor + 1
        if !parserTypeSyntaxParseConstExpr(
               tree,
               producerSourceIndex,
               cursor,
               tokenLimit,
               rootOut,
               errorText) ||
           cursor >= tokenLimit ||
           ParserValueExprTokenKindAt(tree, cursor) !=
               ParserValueTokenRightParen:
            errorText = "parser TypeSyntax: const close paren missing"
            return false
        cursor = cursor + 1
        return true
    if parserTypeSyntaxTokenCanName(kind):
        # [S1b step-3 (9)] Const-expression leaf naming a module const.  The
        # table lookup is the whole decision: a name that is not a registered
        # int32 const is a hard error here (never a silent fall-through),
        # because the bracket branch only routes a name into this grammar when
        # it already knows the name, and an arithmetic argument has no other
        # legal reading.
        var int32Flag: bool
        var constValue: int32
        if !parserTypeSyntaxModuleConstFindInto(
               tree, tokenIndex, int32Flag, constValue):
            errorText = Fmt"parser TypeSyntax: const name is not visible name={ParserValueExprTokenText(tree, tokenIndex)}"
            return false
        if !int32Flag:
            errorText = Fmt"parser TypeSyntax: fixed array length const must be int32 name={ParserValueExprTokenText(tree, tokenIndex)}"
            return false
        cursor = cursor + 1
        rootOut = parserTypeSyntaxAppendConstNode(
            tree,
            producerSourceIndex,
            ParserTypeConstExprName,
            tokenIndex,
            -1,
            -1,
            constValue)
        return true
    if kind != ParserValueTokenInteger:
        errorText = "parser TypeSyntax: const integer missing"
        return false
    let spanStart = ParserValueExprTokenStartAt(tree, tokenIndex)
    let spanEnd = ParserValueExprTokenEndAt(tree, tokenIndex)
    let textLen = spanEnd - spanStart
    let text = langintern.LookupInternBorrowedText(
        tree.internPool,
        ParserValueExprTokenSourceIdAt(tree, tokenIndex))
    if textLen == 0:
        errorText = "parser TypeSyntax: empty const integer"
        return false
    var value: int64
    for offset in 0..<textLen:
        if text[spanStart + offset] < '0' ||
           text[spanStart + offset] > '9':
            errorText = "parser TypeSyntax: invalid const integer"
            return false
        value = value * Int64(10) +
                Int64(Int32(text[spanStart + offset]) - Int32('0'))
        if value > Int64(2147483647):
            errorText = "parser TypeSyntax: const integer overflow"
            return false
    cursor = cursor + 1
    rootOut = parserTypeSyntaxAppendConstNode(
        tree,
        producerSourceIndex,
        ParserTypeConstExprInteger,
        tokenIndex,
        -1,
        -1,
        Int32(value))
    return true

fn parserTypeSyntaxParseConstMul(
        tree: var ParserValueExprTree,
        producerSourceIndex: int32,
        cursor: var int32,
        tokenLimit: int32,
        rootOut: var int32,
        errorText: var str): bool =
    if !parserTypeSyntaxParseConstPrimary(
           tree,
           producerSourceIndex,
           cursor,
           tokenLimit,
           rootOut,
           errorText):
        return false
    while cursor < tokenLimit:
        let kind = ParserValueExprTokenKindAt(tree, cursor)
        if kind != ParserValueTokenStar &&
           kind != ParserValueTokenSlash &&
           kind != ParserValueTokenPercent:
            break
        let operatorToken = cursor
        cursor = cursor + 1
        var right: int32
        if !parserTypeSyntaxParseConstPrimary(
               tree,
               producerSourceIndex,
               cursor,
               tokenLimit,
               right,
               errorText):
            return false
        var constKind = ParserTypeConstExprMultiply
        if kind == ParserValueTokenSlash:
            constKind = ParserTypeConstExprDivide
        elif kind == ParserValueTokenPercent:
            constKind = ParserTypeConstExprModulo
        rootOut = parserTypeSyntaxAppendConstNode(
            tree,
            producerSourceIndex,
            constKind,
            operatorToken,
            rootOut,
            right,
            0)
    return true

fn parserTypeSyntaxParseConstExpr(
        tree: var ParserValueExprTree,
        producerSourceIndex: int32,
        cursor: var int32,
        tokenLimit: int32,
        rootOut: var int32,
        errorText: var str): bool =
    if !parserTypeSyntaxParseConstMul(
           tree,
           producerSourceIndex,
           cursor,
           tokenLimit,
           rootOut,
           errorText):
        return false
    while cursor < tokenLimit:
        let kind = ParserValueExprTokenKindAt(tree, cursor)
        if kind != ParserValueTokenPlus && kind != ParserValueTokenMinus:
            break
        let operatorToken = cursor
        cursor = cursor + 1
        var right: int32
        if !parserTypeSyntaxParseConstMul(
               tree,
               producerSourceIndex,
               cursor,
               tokenLimit,
               right,
               errorText):
            return false
        rootOut = parserTypeSyntaxAppendConstNode(
            tree,
            producerSourceIndex,
            kind == ParserValueTokenPlus ?
                ParserTypeConstExprAdd : ParserTypeConstExprSubtract,
            operatorToken,
            rootOut,
            right,
            0)
    return true

# [produce-attr] Per-region live-block attribution for the statement-event
# loop.  Five note points split one iteration into four regions; each note
# credits the delta since the previous note to that previous point's region, so
# a `continue` that skips later points still credits every block to exactly one
# region.  Armed once by CHENG_PRODUCE_ATTR=1; unset leaves the default path
# with five counter reads per iteration and zero output.
var parserProduceAttrInitialized: bool
var parserProduceAttrEnabled: bool
var parserProduceAttrPrevLive: int64
var parserProduceAttrPrevSlot: int32

const
    ParserProduceAttrSlotCount: int32 = 9

var parserProduceAttrCalls: int32[9]
var parserProduceAttrBlocks: int64[9]

fn ParserProduceAttrReset() =
    if !parserProduceAttrInitialized:
        parserProduceAttrInitialized = true
        parserProduceAttrEnabled = os.GetEnv("CHENG_PRODUCE_ATTR") == "1"
    if !parserProduceAttrEnabled:
        return
    parserProduceAttrPrevSlot = -1
    var attrResetIndex: int32
    while attrResetIndex < ParserProduceAttrSlotCount:
        parserProduceAttrCalls[attrResetIndex] = 0
        parserProduceAttrBlocks[attrResetIndex] = 0
        attrResetIndex = attrResetIndex + 1

fn ParserProduceAttrNote(slot: int32) =
    if !parserProduceAttrEnabled:
        return
    let attrNow = system.MemLiveAllocations()
    if parserProduceAttrPrevSlot >= 0:
        parserProduceAttrBlocks[parserProduceAttrPrevSlot] =
            parserProduceAttrBlocks[parserProduceAttrPrevSlot] +
                (attrNow - parserProduceAttrPrevLive)
    parserProduceAttrCalls[slot] = parserProduceAttrCalls[slot] + 1
    parserProduceAttrPrevSlot = slot
    parserProduceAttrPrevLive = attrNow

fn ParserProduceAttrDump() =
    if !parserProduceAttrEnabled:
        return
    var attrReport: str = "produce_attr"
    var attrDumpIndex: int32
    while attrDumpIndex < ParserProduceAttrSlotCount:
        attrReport = Fmt"{attrReport} s{attrDumpIndex}={parserProduceAttrCalls[attrDumpIndex]}/{parserProduceAttrBlocks[attrDumpIndex]}"
        attrDumpIndex = attrDumpIndex + 1
    os.WriteLine(os.Get_stderr(), attrReport)
    parserProduceAttrPrevSlot = -1

fn ParserValueExprProduceStatementEvents(tree: var ParserValueExprTree,
                                           tokenStart: int32,
                                           tokenCount: int32,
                                           err: var str): bool =
    let tokenLimit = tokenStart + tokenCount
    var cursor = tokenStart
    var typeBlockColumn: int32 = -1
    var typeEntryColumn: int32 = -1
    var activeTypeDeclarationRoot: int32 = -1
    var activeTypeLexicalScopeRow: int32 = -1
    var activeTypeScopeStartToken: int32 = -1
    let sourceLexicalScopeRow = tree.activeDeclarationLexicalScopeRow
    var routineBlockColumn: int32 = -1
    var routineEntryColumn: int32 = -1
    var bindingBlockColumn: int32 = -1
    var bindingEntryColumn: int32 = -1
    var bindingBlockEntryCount: int32
    var bindingBlockMutableFlag = false
    var importcAnnotationPending = false
    var pendingAnnotationStart: int32 = -1
    var pendingAnnotationCount: int32
    # Field sequence of the open type block: first entry line's first token to
    # the last entry line's end, witnessed as one FieldBlock region on close.
    var typeBlockRegionStart: int32 = -1
    var typeBlockRegionEnd: int32 = -1
    var produceProbeAt: int32 = tokenStart
    ParserProduceAttrReset()
    while cursor < tokenLimit:
        ParserProduceAttrNote(0)
        if cursor >= produceProbeAt:
            produceProbeAt = cursor + 512
            ParserDebugStage(Fmt"produce_probe cursor={cursor} span={tokenStart}:{tokenLimit}")
        var lineEnd = ParserValueExprLogicalLineEnd(tree, cursor, tokenLimit)
        lineEnd = ParserValueExprExtendIndentedValueRange(
            tree, cursor, lineEnd, tokenLimit)
        ParserProduceAttrNote(1)
        if lineEnd <= cursor:
            err = "parser value expr: statement event made no progress"
            return false
        let lineColumn = ParserValueExprTokenColumnAt(tree, cursor)
        let firstKind = ParserValueExprTokenKindAt(tree, cursor)
        if typeBlockColumn >= 0 && typeEntryColumn >= 0 &&
           lineColumn > typeEntryColumn &&
           lineEnd == cursor + 2 &&
           ParserValueExprTokenCanName(firstKind) &&
           ParserValueExprTokenKindAt(tree, lineEnd - 1) ==
               ParserValueTokenColon:
            # Form-B 字段(type 块成员体, 与 ProcessTypeBodyRange 同款规则):
            # 成员字段 `name:` EOL、类型独占更深缩进下一逻辑行时, 类型行
            # 并入字段语句范围; 更深行含顶层冒号(字段行形)或无更深行的
            # 形状维持既有路径与硬错误。
            let fieldTypeEnd = ParserValueExprLogicalLineEnd(
                tree, lineEnd, tokenLimit)
            if fieldTypeEnd > lineEnd &&
               ParserValueExprTokenColumnAt(tree, lineEnd) > lineColumn &&
               ParserValueExprFindTopLevelKind(
                   tree, lineEnd, fieldTypeEnd, ParserValueTokenColon) < 0:
                lineEnd = fieldTypeEnd
        var boundAnnotationStart: int32 = -1
        var boundAnnotationCount: int32
        if firstKind != ParserValueTokenAt && pendingAnnotationCount > 0:
            boundAnnotationStart = pendingAnnotationStart
            boundAnnotationCount = pendingAnnotationCount
            ParserValueExprBindAnnotationTargets(
                tree,
                pendingAnnotationStart,
                pendingAnnotationCount,
                cursor)
            pendingAnnotationStart = -1
            pendingAnnotationCount = 0
        if typeBlockColumn >= 0 && lineColumn <= typeBlockColumn:
            if activeTypeLexicalScopeRow >= 0:
                ParserValueExprFinalizeTypeDeclarationLexicalScope(
                    tree,
                    activeTypeLexicalScopeRow,
                    tree.activeTypeDeclarationRow,
                    activeTypeScopeStartToken,
                    typeBlockRegionEnd)
            if typeBlockRegionStart >= 0 &&
               typeBlockRegionEnd > typeBlockRegionStart:
                ParserValueExprAppendRegion(
                    tree,
                    ParserValueExprRegionFieldBlock,
                    ParserValueExprTokenSourceIdAt(tree, typeBlockRegionStart),
                    ParserValueExprTokenStartAt(tree, typeBlockRegionStart),
                    ParserValueExprTokenEndAt(tree, typeBlockRegionEnd - 1),
                    typeBlockRegionStart)
            typeBlockColumn = -1
            typeEntryColumn = -1
            activeTypeDeclarationRoot = -1
            activeTypeLexicalScopeRow = -1
            activeTypeScopeStartToken = -1
            tree.activeTypeDeclarationRow = -1
            tree.activeDeclarationLexicalScopeRow = sourceLexicalScopeRow
            typeBlockRegionStart = -1
            typeBlockRegionEnd = -1
        if routineBlockColumn >= 0 && lineColumn <= routineBlockColumn:
            routineBlockColumn = -1
            routineEntryColumn = -1
        if bindingBlockColumn >= 0 && lineColumn <= bindingBlockColumn:
            if bindingBlockEntryCount <= 0:
                err = "parser declaration: binding block is empty"
                return false
            bindingBlockColumn = -1
            bindingEntryColumn = -1
            bindingBlockEntryCount = 0
            bindingBlockMutableFlag = false
        # [slab-k1] 静息点观察: 块闭包判定后、分派前。缺省零读零写。
        if ParserSegmentDiagEnabled():
            ParserSegmentDiagObserveBoundary(
                tree,
                tokenStart,
                cursor,
                typeBlockColumn,
                routineBlockColumn,
                bindingBlockColumn,
                boundAnnotationStart,
                pendingAnnotationCount,
                firstKind)
        if (firstKind == ParserValueTokenLet ||
            firstKind == ParserValueTokenVar ||
            firstKind == ParserValueTokenConst) &&
           cursor + 1 == lineEnd:
            bindingBlockColumn = lineColumn
            bindingEntryColumn = -1
            bindingBlockEntryCount = 0
            bindingBlockMutableFlag = firstKind == ParserValueTokenVar
            cursor = lineEnd
            continue
        if bindingBlockColumn >= 0:
            if bindingEntryColumn < 0:
                bindingEntryColumn = lineColumn
            if lineColumn != bindingEntryColumn:
                err = "parser declaration: binding block entry indentation invalid"
                return false
            let bindingEntryLimit = ParserValueExprExtendBindingEntryFormB(
                tree, cursor, lineEnd, tokenLimit)
            if !ParserValueExprProcessBindingEntryRange(
                   tree,
                   cursor,
                   bindingEntryLimit,
                   cursor,
                   bindingBlockMutableFlag,
                   err):
                return false
            bindingBlockEntryCount = bindingBlockEntryCount + 1
            cursor = bindingEntryLimit
            continue
        if firstKind == ParserValueTokenConcept ||
           firstKind == ParserValueTokenTrait:
            let declarationSuiteEnd = ParserValueExprIndentedSuiteEnd(
                tree,
                lineEnd,
                tokenLimit,
                lineColumn)
            var topDeclRow: int32
            var topCoreRow: int32
            parserForwardingTopLevelBegin(
                tree,
                cursor,
                declarationSuiteEnd,
                firstKind == ParserValueTokenConcept ? 17 : 18,
                boundAnnotationStart,
                boundAnnotationCount,
                topDeclRow,
                topCoreRow)
            var statementRow: int32
            var statementCoreRow: int32
            parserForwardingDirectStatementBegin(
                tree,
                cursor,
                declarationSuiteEnd,
                firstKind == ParserValueTokenConcept ? 17 : 18,
                statementRow,
                statementCoreRow)
            let declarationStart = tree.declarationCount
            if !ParserValueExprProcessConceptTraitRange(
                   tree,
                   cursor,
                   declarationSuiteEnd,
                   err):
                return false
            if tree.declarationCount <= declarationStart:
                panic("parser forwarding production: concept/trait declaration missing")
            parserForwardingDirectStatementFinish(
                tree,
                statementRow,
                statementCoreRow,
                ParserForwardingProductionChildDeclaration,
                declarationStart)
            parserForwardingTopLevelFinish(
                tree,
                topDeclRow,
                topCoreRow,
                boundAnnotationStart,
                boundAnnotationCount)
            cursor = declarationSuiteEnd
            continue
        if firstKind == ParserValueTokenType && cursor + 1 == lineEnd:
            typeBlockColumn = lineColumn
            typeEntryColumn = -1
            activeTypeDeclarationRoot = -1
            activeTypeLexicalScopeRow = -1
            activeTypeScopeStartToken = -1
            tree.activeTypeDeclarationRow = -1
            tree.activeDeclarationLexicalScopeRow = sourceLexicalScopeRow
            cursor = lineEnd
            continue
        if firstKind == ParserValueTokenType:
            let previousTypeDeclarationRow = tree.activeTypeDeclarationRow
            let declarationHeaderEnd =
                ParserValueExprTypeDeclarationHeaderEnd(
                    tree, cursor, lineEnd)
            let declarationSuiteEnd = ParserValueExprIndentedSuiteEnd(
                tree,
                declarationHeaderEnd,
                tokenLimit,
                lineColumn)
            var topDeclRow: int32
            var topCoreRow: int32
            parserForwardingTopLevelBegin(
                tree,
                cursor,
                declarationSuiteEnd,
                1,
                boundAnnotationStart,
                boundAnnotationCount,
                topDeclRow,
                topCoreRow)
            var statementRow: int32
            var statementCoreRow: int32
            parserForwardingDirectStatementBegin(
                tree,
                cursor,
                declarationSuiteEnd,
                1,
                statementRow,
                statementCoreRow)
            let declarationStart = tree.declarationCount
            var declarationRoot: int32
            if !ParserValueExprProcessTypeDeclarationRangeInto(
                   tree,
                   cursor,
                   declarationHeaderEnd,
                   -1,
                   declarationRoot,
                   err) ||
               declarationRoot < 0:
                if err == "":
                    err = "parser type syntax: direct declaration root missing"
                return false
            if ParserValueExprTokenKindAt(
                   tree, declarationHeaderEnd - 1) ==
                   ParserValueTokenColon &&
               declarationSuiteEnd <= declarationHeaderEnd:
                err = "parser type syntax: object or enum body is empty"
                return false
            if declarationSuiteEnd > declarationHeaderEnd:
                ParserValueExprAppendRegion(
                    tree,
                    ParserValueExprRegionFieldBlock,
                    ParserValueExprTokenSourceIdAt(
                        tree, declarationHeaderEnd),
                    ParserValueExprTokenStartAt(
                        tree, declarationHeaderEnd),
                    ParserValueExprTokenEndAt(
                        tree, declarationSuiteEnd - 1),
                    declarationHeaderEnd)
                if !ParserValueExprProcessTypeBodyRange(
                       tree,
                       declarationHeaderEnd,
                       declarationSuiteEnd,
                       declarationRoot,
                       tree.activeTypeDeclarationRow,
                       err):
                    return false
            tree.activeTypeDeclarationRow = previousTypeDeclarationRow
            if tree.declarationCount <= declarationStart:
                panic("parser forwarding production: type declaration missing")
            parserForwardingDirectStatementFinish(
                tree,
                statementRow,
                statementCoreRow,
                ParserForwardingProductionChildDeclaration,
                declarationStart)
            parserForwardingTopLevelFinish(
                tree,
                topDeclRow,
                topCoreRow,
                boundAnnotationStart,
                boundAnnotationCount)
            cursor = declarationSuiteEnd
            continue
        if firstKind == ParserValueTokenFn && cursor + 1 == lineEnd:
            routineBlockColumn = lineColumn
            routineEntryColumn = -1
            cursor = lineEnd
            continue
        if firstKind == ParserValueTokenFn ||
           firstKind == ParserValueTokenIterator ||
           firstKind == ParserValueTokenMacro ||
           firstKind == ParserValueTokenTemplate ||
           firstKind == ParserValueTokenAsync:
            lineEnd = ParserValueExprExtendRoutineHeaderReturnType(
                tree, cursor, lineEnd, tokenLimit)
            lineEnd = ParserValueExprExtendRoutineSuiteRange(
                tree, cursor, lineEnd, tokenLimit)
        if typeBlockColumn >= 0:
            if typeEntryColumn < 0:
                typeEntryColumn = lineColumn
            if lineColumn == typeEntryColumn:
                if activeTypeLexicalScopeRow >= 0:
                    ParserValueExprFinalizeTypeDeclarationLexicalScope(
                        tree,
                        activeTypeLexicalScopeRow,
                        tree.activeTypeDeclarationRow,
                        activeTypeScopeStartToken,
                        typeBlockRegionEnd)
                tree.activeDeclarationLexicalScopeRow =
                    sourceLexicalScopeRow
                let declarationHeaderEnd =
                    ParserValueExprTypeDeclarationHeaderEnd(
                        tree, cursor, lineEnd)
                var declarationRoot: int32
                if !ParserValueExprProcessTypeDeclarationRangeInto(
                       tree,
                       cursor,
                       declarationHeaderEnd,
                       -1,
                       declarationRoot,
                       err):
                    return false
                activeTypeDeclarationRoot = declarationRoot
                if typeBlockRegionStart < 0:
                    typeBlockRegionStart = cursor
                activeTypeLexicalScopeRow = ParserValueExprAppendDeclarationLexicalScope(
                    tree,
                    ParserDeclarationLexicalScopeType,
                    sourceLexicalScopeRow,
                    tree.activeTypeDeclarationRow)
                activeTypeScopeStartToken = cursor
                tree.activeDeclarationLexicalScopeRow = activeTypeLexicalScopeRow
                typeBlockRegionEnd = declarationHeaderEnd
                if ParserValueExprTypeSyntaxKindAt(
                       tree, declarationRoot) == ParserTypeSyntaxEnum:
                    cursor = declarationHeaderEnd
                    continue
                cursor = declarationHeaderEnd
                continue
            if activeTypeDeclarationRoot >= 0 &&
               ParserValueExprTypeSyntaxKindAt(
                   tree, activeTypeDeclarationRoot) ==
                   ParserTypeSyntaxEnum:
                lineEnd = ParserValueExprPhysicalLineEnd(
                    tree, cursor, tokenLimit)
                if !ParserValueExprAppendEnumVariantsRangeInto(
                       tree,
                       activeTypeDeclarationRoot,
                       cursor,
                       lineEnd,
                       err):
                    return false
                typeBlockRegionEnd = lineEnd
                cursor = lineEnd
                continue
        if routineBlockColumn >= 0:
            if routineEntryColumn < 0:
                routineEntryColumn = lineColumn
            if lineColumn == routineEntryColumn:
                lineEnd = ParserValueExprExtendRoutineSuiteRange(
                    tree, cursor, lineEnd, tokenLimit)
                let routineStatementArm =
                    parserForwardingStatementCoreArm(
                        tree, cursor, lineEnd, -1)
                if routineStatementArm == -3:
                    # 孤儿 elif/else 不能成为 routine 入口行；先于
                    # DirectStatementBegin 拒收，避免非法 arm 触发 panic。
                    err = ParserValueExprAdmissionDiagnostic(
                        tree,
                        cursor,
                        "PARSER_BRANCH_WITHOUT_IF")
                    return false
                var topDeclRow: int32
                var topCoreRow: int32
                parserForwardingTopLevelBegin(
                    tree,
                    cursor,
                    lineEnd,
                    routineStatementArm,
                    boundAnnotationStart,
                    boundAnnotationCount,
                    topDeclRow,
                    topCoreRow)
                var statementRow: int32
                var statementCoreRow: int32
                parserForwardingDirectStatementBegin(
                    tree,
                    cursor,
                    lineEnd,
                    routineStatementArm,
                    statementRow,
                    statementCoreRow)
                let declarationStart = tree.declarationCount
                if !ParserValueExprProcessRoutineRange(tree,
                                                        cursor,
                                                        lineEnd,
                                                        false,
                                                        err):
                    return false
                if tree.declarationCount <= declarationStart:
                    panic("parser forwarding production: routine declaration missing")
                parserForwardingDirectStatementFinish(
                    tree,
                    statementRow,
                    statementCoreRow,
                    ParserForwardingProductionChildDeclaration,
                    declarationStart)
                parserForwardingTopLevelFinish(
                    tree,
                    topDeclRow,
                    topCoreRow,
                    boundAnnotationStart,
                    boundAnnotationCount)
                cursor = lineEnd
                continue
        ParserProduceAttrNote(2)
        let annotationCountBefore = tree.annotationCount
        let statementCoreArm = parserForwardingStatementCoreArm(
            tree, cursor, lineEnd, activeTypeDeclarationRoot)
        ParserProduceAttrNote(5)
        var topDeclRow: int32
        var topCoreRow: int32
        parserForwardingTopLevelBegin(
            tree,
            cursor,
            lineEnd,
            statementCoreArm,
            boundAnnotationStart,
            boundAnnotationCount,
            topDeclRow,
            topCoreRow)
        ParserProduceAttrNote(6)
        if !ParserValueExprProcessStatementRangeWithTypeOwner(
               tree,
               cursor,
               lineEnd,
               importcAnnotationPending,
               activeTypeDeclarationRoot,
               err):
            err = Fmt"{err} statement_offset={ParserValueExprTokenStartAt(tree, cursor)}"
            return false
        ParserProduceAttrNote(3)
        var topAnnotationStart = boundAnnotationStart
        var topAnnotationCount = boundAnnotationCount
        let inlineAnnotationCount =
            tree.annotationCount - annotationCountBefore
        if inlineAnnotationCount > 0:
            if topAnnotationCount == 0:
                topAnnotationStart = annotationCountBefore
            elif topAnnotationStart + topAnnotationCount !=
                     annotationCountBefore:
                panic("parser forwarding production: top-level annotations split")
            topAnnotationCount =
                topAnnotationCount + inlineAnnotationCount
        parserForwardingTopLevelFinish(
            tree,
            topDeclRow,
            topCoreRow,
            topAnnotationStart,
            topAnnotationCount)
        if typeBlockColumn >= 0:
            typeBlockRegionEnd = lineEnd
        if firstKind == ParserValueTokenAt:
            let addedAnnotationCount =
                tree.annotationCount - annotationCountBefore
            if addedAnnotationCount <= 0:
                err = "parser annotation: producer emitted no row"
                return false
            var firstUnboundRow: int32 = -1
            var unboundCount: int32
            for offset in 0..<addedAnnotationCount:
                let annotationRow = annotationCountBefore + offset
                let targetToken = arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.annotationTargetTokenIndexes,
                    annotationRow)
                if targetToken < 0:
                    if firstUnboundRow < 0:
                        firstUnboundRow = annotationRow
                    elif firstUnboundRow + unboundCount != annotationRow:
                        err = "parser annotation: unbound rows are not contiguous"
                        return false
                    unboundCount = unboundCount + 1
                    let nameToken = arenamod.ArenaArrayInt32Get(
                        tree.arena,
                        tree.annotationNameTokenIndexes,
                        annotationRow)
                    if ParserValueExprTokenTextEqualsText(tree, nameToken,
                                                          "importc"):
                        importcAnnotationPending = true
            if unboundCount > 0:
                if pendingAnnotationCount == 0:
                    pendingAnnotationStart = firstUnboundRow
                elif pendingAnnotationStart + pendingAnnotationCount !=
                         firstUnboundRow:
                    err = "parser annotation: pending rows are not contiguous"
                    return false
                pendingAnnotationCount =
                    pendingAnnotationCount + unboundCount
        if firstKind != ParserValueTokenAt:
            importcAnnotationPending = false
        ParserProduceAttrNote(4)
        cursor = lineEnd
    if activeTypeLexicalScopeRow >= 0:
        ParserValueExprFinalizeTypeDeclarationLexicalScope(
            tree,
            activeTypeLexicalScopeRow,
            tree.activeTypeDeclarationRow,
            activeTypeScopeStartToken,
            typeBlockRegionEnd)
    if typeBlockRegionStart >= 0 &&
       typeBlockRegionEnd > typeBlockRegionStart:
        ParserValueExprAppendRegion(
            tree,
            ParserValueExprRegionFieldBlock,
            ParserValueExprTokenSourceIdAt(tree, typeBlockRegionStart),
            ParserValueExprTokenStartAt(tree, typeBlockRegionStart),
            ParserValueExprTokenEndAt(tree, typeBlockRegionEnd - 1),
            typeBlockRegionStart)
    if bindingBlockColumn >= 0 && bindingBlockEntryCount <= 0:
        err = "parser declaration: binding block is empty"
        return false
    if pendingAnnotationCount != 0:
        err = "parser annotation: target missing"
        return false
    return true

# [U0-cut] Pass-1 per-column exact reservation for the per-source parser tree
# arena.
#
# The tree arena is used through exactly one primitive, `ArenaArrayInt32Add`
# over the columns listed below (parser.cheng has zero `ArenaAllocBytes`,
# `ArenaAllocZero` and `ArenaArrayU8Add` call sites).  That primitive grows a
# column by doubling at the arena bump top and abandons the previous block in
# place, never reclaiming it (src/core/runtime/arena.cheng:373-397).  For a
# column whose last block holds 2^k entries the arena therefore holds
#     4*(8 + 16 + ... + 2^k) = 4*(2^(k+1) - 8) bytes
# of which 4*(2^k - 8) are abandoned blocks -- exactly `used_c/2 - 16`.  Summed
# over the C columns that ever allocated:
#     abandoned = U0/2 - 16*C          where U0 = ArenaUsed(tree.arena)
# and the abandoned blocks are fully resident, because a block only reaches its
# capacity when every slot in it has been written.  The untouched tail of the
# last block is not resident at all: mmap pages are kernel-zero and are only
# charged once touched (src/core/runtime/program_support_backend.cheng:6106-6108).
# Reserving every column at the length pass 0 measured removes all of them, so
# pass 1's arena ends at the live bytes instead of the geometric block sum.
#
# This is a measured fact, not a heuristic: pass 0 parses the same
# `parserInputText` through the same code with the same `migrationSourceSyntax`
# flag, so its per-column lengths are this parse's per-column lengths.  A
# short census is not silent: the column would take the grow branch and
# re-create the abandoned block, and `ArenaUsed(tree.arena)` would exceed the
# pass-0 measurement the caller reserved.
const
    ParserValueExprTreeArenaColumnCount: int32 = 201

# Pass-0 side: the exact final length of every tree arena column, appended to
# `out` in the fixed order `ParserValueExprTreeArenaColumnCensusApply` reads.
@borrows
fn ParserValueExprTreeArenaColumnCensusInto(
        tree: ParserValueExprTree,
        out: var int32[]): bool =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return false
    let censusStart = out.len
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.kinds))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.nodeProducerSourceIndexes))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.nodeSourceLocalIndexes))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.sourceTextIds))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.sourceTextLengths))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.spanStarts))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.spanEnds))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.atomStarts))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.atomEnds))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.ownerStarts))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.ownerEnds))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.nameStarts))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.nameEnds))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.operatorStarts))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.operatorEnds))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.argumentNameStarts))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.argumentNameEnds))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.callArgsStarts))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.callArgsEnds))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.argumentRootStarts))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.argumentRootCounts))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.firstChilds))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.childCounts))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.nextSiblings))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.parentNodeIndexes))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.nodeStatementRootEventIndexes))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.nodeLexicalScopeRows))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.nodeBindingResolutionKinds))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.nodeResolvedBindingDeclarationRows))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.nodeResolvedBindingPatternRows))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.explicitGenericStarts))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.explicitGenericCounts))
    add(out, arenamod.ArenaArrayInt32Len(tree.arena, tree.explicitGenericSpanStarts))
