@borrows
fn NormalizedExprDefaultInitType(expr: NormalizedExpr): str =
    if expr.kind != NormalizedExprDefaultInit:
        return ""
    return expr.surfaceText

@borrows
fn NormalizedExprConstructorType(expr: NormalizedExpr): str =
    if expr.kind != NormalizedExprConstructor:
        return ""
    return expr.surfaceText

fn NormalizedExprCallSurfaceKind(expr: NormalizedExpr): NormalizedExprSurfaceCallKind =
    if expr.kind != NormalizedExprCall:
        return NormalizedExprSurfaceCallNone
    return expr.callSurfaceKind

fn NormalizedExprCallResolved(expr: NormalizedExpr): bool =
    if expr.kind != NormalizedExprCall:
        return false
    return expr.callResolved

fn NormalizedExprCallReasonKind(expr: NormalizedExpr): NormalizedExprCallReason =
    if expr.kind != NormalizedExprCall:
        return NormalizedExprCallReasonNone
    return expr.callReason

fn NormalizedExprCallQualifier(expr: NormalizedExpr): str =
    if expr.kind != NormalizedExprCall:
        return ""
    return expr.callQualifier

fn NormalizedExprCallCallee(expr: NormalizedExpr): str =
    if expr.kind != NormalizedExprCall:
        return ""
    return expr.callCallee

fn NormalizedExprCallTarget(expr: NormalizedExpr): str =
    if expr.kind != NormalizedExprCall:
        return ""
    return expr.callTarget

fn NormalizedExprCallTargetSourcePath(expr: NormalizedExpr): str =
    if expr.kind != NormalizedExprCall:
        return ""
    return expr.callTargetSourcePath

fn NormalizedExprCallTargetImportc(expr: NormalizedExpr): bool =
    if expr.kind != NormalizedExprCall:
        return false
    return expr.callTargetImportc

fn NormalizedExprLayerCallResolvedCount(layer: NormalizedExprLayer): int32 =
    var count: int32
    for i in 0..<layer.exprs.len:
        let expr = layer.exprs[i]
        if expr.kind != NormalizedExprCall:
            continue
        if expr.callResolved:
            count = count + 1
    return count

fn NormalizedExprLayerCallUnresolvedCount(layer: NormalizedExprLayer): int32 =
    var count: int32
    for i in 0..<layer.exprs.len:
        let expr = layer.exprs[i]
        if expr.kind != NormalizedExprCall:
            continue
        if !expr.callResolved:
            count = count + 1
    return count

fn NormalizedExprLayerCallKindCountExact(layer: NormalizedExprLayer,
                                           callKind: NormalizedExprSurfaceCallKind): int32 =
    if callKind == NormalizedExprSurfaceCallNone:
        return 0
    var count: int32
    for i in 0..<layer.exprs.len:
        let expr = layer.exprs[i]
        if expr.kind != NormalizedExprCall:
            continue
        if expr.callSurfaceKind == callKind:
            count = count + 1
    return count

fn NormalizedExprLayerCallReasonCountExact(layer: NormalizedExprLayer,
                                             callReason: NormalizedExprCallReason): int32 =
    if callReason == NormalizedExprCallReasonNone:
        return 0
    var count: int32
    for i in 0..<layer.exprs.len:
        let expr = layer.exprs[i]
        if expr.kind != NormalizedExprCall:
            continue
        if expr.callReason == callReason:
            count = count + 1
    return count

fn NormalizedExprLayerCallTargetImportcCount(layer: NormalizedExprLayer): int32 =
    var count: int32
    for i in 0..<layer.exprs.len:
        let expr = layer.exprs[i]
        if expr.kind != NormalizedExprCall:
            continue
        if expr.callTargetImportc:
            count = count + 1
    return count

fn NormalizedExprLayerHasExprExact(layer: NormalizedExprLayer,
                                     kind: NormalizedExprKind,
                                     detailKind: NormalizedExprDetailKind,
                                     lineNumber: int32): bool =
    for i in 0..<layer.exprs.len:
        let expr = layer.exprs[i]
        if expr.kind != kind:
            continue
        if expr.detailKind != detailKind:
            continue
        if expr.lineNumber != lineNumber:
            continue
        return true
    return false

fn NormalizedExprLayerHasCallExpr(layer: NormalizedExprLayer,
                                    callKind: NormalizedExprSurfaceCallKind,
                                    lineNumber: int32): bool =
    if callKind == NormalizedExprSurfaceCallNone:
        return false
    for i in 0..<layer.exprs.len:
        let expr = layer.exprs[i]
        if expr.kind != NormalizedExprCall:
            continue
        if expr.callSurfaceKind != callKind:
            continue
        if expr.lineNumber != lineNumber:
            continue
        return true
    return false

fn NormalizedExprLayerHasConstructorExpr(layer: NormalizedExprLayer,
                                           lineNumber: int32): bool =
    for i in 0..<layer.exprs.len:
        let expr = layer.exprs[i]
        if expr.kind != NormalizedExprConstructor:
            continue
        if expr.lineNumber != lineNumber:
            continue
        return true
    return false

@borrows
fn ParserNormalizePath(pathRaw: str): str =
    var path = ParserOwnedText(pathRaw)
    # pure-path codegen evaluates `a && b` without short-circuit: `path.len >= 4 &&
    # path[0] == ...` still loads path[0] when len==0 (null data) → SEGV. Nest guards.
    while path.len > 1:
        let last = path[path.len - 1]
        if last != '/' && last != '\\':
            break
        path = ParserOwnedText(chengpath.TextSlice(path, 0, path.len - 1))
    while path.len >= 4:
        if path[0] != '.':
            break
        if path[1] != '/':
            break
        if path[2] != '.':
            break
        if path[3] != '/':
            break
        path = ParserOwnedText(chengpath.TextSlice(path, 2, path.len))
    return path

@borrows
fn ParserBaseName(pathRaw: str): str =
    let path = ParserNormalizePath(pathRaw)
    return chengpath.PathBaseName(path)

@borrows
fn ParserFileStem(pathRaw: str): str =
    let path = ParserNormalizePath(pathRaw)
    if path == "":
        return ""
    var lastSep: int32 = -1
    for i in 0..<path.len:
        if path[i] == '/' || path[i] == '\\':
            lastSep = i
    var start: int32
    if lastSep >= 0:
        start = lastSep + 1
    var lastDot: int32 = -1
    for i in start..<path.len:
        if path[i] == '.':
            lastDot = i
    if lastDot <= start:
        return chengpath.TextSlice(path, start, path.len - start)
    return chengpath.TextSlice(path, start, lastDot - start)

@borrows
fn ParserLastPathPiece(pathRaw: str): str =
    let path = ParserNormalizePath(pathRaw)
    if path == "":
        return ""
    var lastSep: int32 = -1
    for i in 0..<path.len:
        if path[i] == '/' || path[i] == '\\':
            lastSep = i
    if lastSep < 0:
        return path
    if lastSep + 1 >= path.len:
        return ""
    return chengpath.TextSlice(path, lastSep + 1, path.len - lastSep - 1)

@borrows
fn ParserDirPart(pathRaw: str): str =
    let path = ParserNormalizePath(pathRaw)
    if path == "":
        return ""
    var lastSep: int32 = -1
    for i in 0..<path.len:
        if path[i] == '/' || path[i] == '\\':
            lastSep = i
    if lastSep <= 0:
        return ""
    return chengpath.TextSlice(path, 0, lastSep)

fn ParserPackageManifestExists(dirRaw: str): bool =
    let dir = ParserNormalizePath(dirRaw)
    if dir == "":
        return false
    let manifestPath = chengpath.PathJoin(dir, "cheng-package.toml")
    return chengpath.PathFileExists(manifestPath)

@borrows
fn ParserPackageManifestText(packageRootRaw: str): str =
    let packageRoot = ParserNormalizePath(packageRootRaw)
    if packageRoot == "":
        return ""
    for i in 0..<parserPackageManifestCacheRoots.len:
        if parserPackageManifestCacheRoots[i] == packageRoot:
            return ParserOwnedText(parserPackageManifestCacheTexts[i])
    let manifestPath = chengpath.PathJoin(packageRoot, "cheng-package.toml")
    # PathFileExists 在 node-eval 自编译 driver 的 dry-compile census 上下文里对
    # 真实存在的文件返 false(致 manifest 读不到 → packageId 兜底成
    # cheng/<worktree目录名> → cheng/libp2p/... 跨包 import 解析失败 →
    # census dry-compile unresolved imports 中止)。该 PathFileExists 守卫冗余:
    # PathReadTextFileWithHandle 对不存在文件自然返空,直接读即可,绕开 flaky 存在性检查。
    let manifestTextRaw = chengpath.PathReadTextFileWithHandle(manifestPath)
    let text = ParserOwnedText(manifestTextRaw)
    add(parserPackageManifestCacheRoots, packageRoot)
    add(parserPackageManifestCacheTexts, share(text))
    return text

@borrows
fn ParserManifestValue(manifestTextRaw: str,
                         keyRaw: str): str =
    let manifestText = ParserOwnedText(manifestTextRaw)
    let keyInput = ParserOwnedText(keyRaw)
    var keyStart: int32
    var keyStop: int32
    if !ParserTrimmedLineRange(keyInput, keyStart, keyStop):
        return ""
    if manifestText == "":
        return ""
    let key = ParserOwnedTextRange(keyInput, keyStart, keyStop - keyStart)
    let prefix = ParserConcat3(key, " = ", "")
    let lines = ParserSplitChar(manifestText, '\n')
    for i in 0..<lines.len:
        let ownedLine = ParserOwnedText(lines[i])
        var lineStart: int32
        var lineStop: int32
        if !ParserTrimmedCommentRange(ownedLine, lineStart, lineStop):
            continue
        if lineStart + prefix.len > lineStop:
            continue
        var prefixMatch = true
        for j in 0..<prefix.len:
            if ownedLine[lineStart + j] != prefix[j]:
                prefixMatch = false
                break
        if !prefixMatch:
            continue
        let valueStart = lineStart + prefix.len
        if valueStart >= lineStop || ownedLine[valueStart] != '"':
            continue
        for valueStop in valueStart + 1..<lineStop:
            if ownedLine[valueStop] == '"':
                return ParserOwnedTextRange(
                    ownedLine, valueStart + 1, valueStop - valueStart - 1)
    return ""

# raw channelId hex 严格校验: 长度必须恰 64 (sha256 32 字节的十六进制), 且每字符
# 属 [0-9a-fA-F] (与 std/bytes_layout FixedBytes32FromHex 解码器同集)。不合硬拒,
# 由调用方决定是硬错还是"无 channel"。这是消费方 pin 的 channelId, 不做 did:key 解码。
@borrows
fn ParserChannelHexValid(channelRaw: str): bool =
    let channelInput = ParserOwnedText(channelRaw)
    let channel = chengpath.PathTrim(channelInput)
    if channel.len != 64:
        return false
    for i in 0..<channel.len:
        let ch = channel[i]
        let digit = ch >= '0' && ch <= '9'
        let lower = ch >= 'a' && ch <= 'f'
        let upper = ch >= 'A' && ch <= 'F'
        if !(digit || lower || upper):
            return false
    return true

# 单行 `key = "value"` 抽取 (line 须已去注释+去首尾空白)。命中返引号内值, 否则 ""。
@borrows
fn ParserManifestLineValue(line: str, keyRaw: str): str =
    let ownedLine = ParserOwnedText(line)
    let keyInput = ParserOwnedText(keyRaw)
    var keyStart: int32
    var keyStop: int32
    if !ParserTrimmedLineRange(keyInput, keyStart, keyStop):
        return ""
    if ownedLine == "":
        return ""
    let key = ParserOwnedTextRange(keyInput, keyStart, keyStop - keyStart)
    let prefix = ParserConcat3(key, " = ", "")
    if !ParserStartsWithExact(ownedLine, prefix):
        return ""
    let valueStart = prefix.len
    if valueStart >= ownedLine.len || ownedLine[valueStart] != '"':
        return ""
    for valueStop in valueStart + 1..<ownedLine.len:
        if ownedLine[valueStop] == '"':
            return ParserOwnedTextRange(
                ownedLine, valueStart + 1, valueStop - valueStart - 1)
    return ""

@borrows
fn ParserManifestNormalizePackageId(packageIdRaw: str): str =
    let packageIdInput = ParserOwnedText(packageIdRaw)
    var idStart: int32
    var idStop: int32
    if !ParserTrimmedLineRange(packageIdInput, idStart, idStop):
        return ""
    let id = ParserOwnedTextRange(packageIdInput, idStart, idStop - idStart)
    if ParserStartsWithExact(id, "pkg://"):
        return ParserOwnedTextRange(id, 6, id.len - 6)
    return id

# 命中的 dependency section 的 channel 值: 空=未配(合法, 无 P5 路径); 非空必过 64-hex
# 严校, 不合硬错 (Let it crash, 绝不静默忽略坏配置)。
@borrows
fn ParserManifestValidatedChannel(channelRaw: str, packageId: str): str =
    let channelInput = ParserOwnedText(channelRaw)
    var channelStart: int32
    var channelStop: int32
    if !ParserTrimmedLineRange(channelInput, channelStart, channelStop):
        return ""
    let channel = ParserOwnedTextRange(
        channelInput, channelStart, channelStop - channelStart)
    if channel == "":
        return ""
    if !ParserChannelHexValid(channel):
        system.Panic(ParserConcat4(
            "cheng-package.toml: dependency channel 非 64-hex channelId pkg=",
            ParserOwnedText(packageId),
            " channel=",
            channel))
    return ParserOwnedLowerAsciiText(channel)

# 消费方 cheng-package.toml 里 [dependencies.<name>] 段的 channel pin。
# 段内含 package_id = "pkg://cheng/foo" 与可选 channel = "<64 hex>"; 按 package_id
# (pkg:// 前缀归一后) 匹配请求包, 返回其 channel (经严校)。未配 channel/未命中段 → ""。
# channelId == sha256(signerPubKey), 落在消费方 = 信任决定处 (非中心 registry)。
@borrows
fn ParserManifestDependencyChannel(manifestTextRaw: str,
                                   packageIdRaw: str): str =
    let manifestText = ParserOwnedText(manifestTextRaw)
    let wantPackageId = ParserManifestNormalizePackageId(packageIdRaw)
    if manifestText == "" || wantPackageId == "":
        return ""
    let lines = ParserSplitChar(manifestText, '\n')
    var inDependencySection = false
    var sectionPackageId = ""
    var sectionChannel = ""
    for i in 0..<lines.len:
        let lineInput = ParserOwnedText(lines[i])
        let line = ParserTrimmedLineWithoutComment(lineInput)
        if line == "":
            continue
        if line[0] == '[':
            if inDependencySection && ParserManifestNormalizePackageId(sectionPackageId) == wantPackageId:
                return ParserManifestValidatedChannel(sectionChannel, wantPackageId)
            inDependencySection = ParserStartsWithExact(line, "[dependencies.")
            sectionPackageId = ""
            sectionChannel = ""
            continue
        if !inDependencySection:
            continue
        let pid = ParserManifestLineValue(line, "package_id")
        if pid != "":
            sectionPackageId = pid
        let ch = ParserManifestLineValue(line, "channel")
        if ch != "":
            sectionChannel = ch
    if inDependencySection && ParserManifestNormalizePackageId(sectionPackageId) == wantPackageId:
        return ParserManifestValidatedChannel(sectionChannel, wantPackageId)
    return ""

fn ParserSharedRoot(packageRootRaw: str): str =
    var cursor = ParserNormalizePath(packageRootRaw)
    while cursor != "":
        let manifestText = ParserPackageManifestText(cursor)
        let packageId = ParserManifestValue(manifestText, "package_id")
        if packageId == "pkg://cheng":
            return cursor
        let parent = chengpath.PathParentDir(cursor)
        if parent == "" || parent == cursor:
            break
        cursor = parent
    return ""

@borrows
fn ParserWorkspaceRoot(packageRootRaw: str): str =
    let packageRoot = ParserNormalizePath(packageRootRaw)
    let sharedRoot = ParserSharedPackageRoot(packageRoot)
    if sharedRoot != "":
        return sharedRoot
    return packageRoot

@borrows
fn ParserPackageId(packageRootRaw: str): str =
    let packageRoot: str = ParserNormalizePath(packageRootRaw)
    if packageRoot == "":
        return ""
    let manifestText = ParserPackageManifestText(packageRoot)
    let manifestPackageId = ParserManifestValue(manifestText, "package_id")
    if ParserStartsWithExact(manifestPackageId, "pkg://"):
        return ParserTextSliceCopy(manifestPackageId, 6, manifestPackageId.len - 6)
    if manifestPackageId != "":
        return manifestPackageId
    var lastSep: int32 = -1
    for i in 0..<packageRoot.len:
        if packageRoot[i] == '/' || packageRoot[i] == '\\':
            lastSep = i
    var name: str
    if lastSep >= 0:
        let packageRootLen = packageRoot.len
        name = chengpath.TextSlice(packageRoot,
                                   lastSep + 1,
                                   packageRootLen - lastSep - 1)
    else:
        name = packageRoot
    if name == "cheng-lang":
        return "cheng"
    if name == "":
        return ""
    return ParserConcat2("cheng/", name)

@borrows
fn ParserExternalPackageRootCertifiedNewWithChannel(importPrefixRaw: str,
                                                       canonicalPackageIdRaw: str,
                                                       packageRootRaw: str,
                                                       channelRaw: str): ParserExternalPackageRoot =
    var out: ParserExternalPackageRoot
    let importPrefixInput = ParserOwnedText(importPrefixRaw)
    let normalizedImportPrefix =
        ParserManifestNormalizePackageId(importPrefixInput)
    out.packageId = ParserOwnedText(normalizedImportPrefix)
    let canonicalPackageIdInput = ParserOwnedText(canonicalPackageIdRaw)
    let normalizedCanonicalPackageId =
        ParserManifestNormalizePackageId(canonicalPackageIdInput)
    out.canonicalPackageId = ParserOwnedText(normalizedCanonicalPackageId)
    let packageRootInput = ParserOwnedText(packageRootRaw)
    let normalizedPackageRoot = ParserNormalizePath(packageRootInput)
    out.packageRoot = ParserOwnedText(normalizedPackageRoot)
    let channelInput = ParserOwnedText(channelRaw)
    let normalizedChannel = chengpath.PathTrim(channelInput)
    let channel = ParserOwnedText(normalizedChannel)
    if channel != "" && !ParserChannelHexValid(channel):
        system.Panic(strutil.Join(["ParserExternalPackageRoot: channel 非 64-hex channelId pkg=", ParserOwnedText(out.canonicalPackageId), " channel=", ParserOwnedText(channel)], ""))
    out.channel = ParserOwnedLowerAsciiText(channel)
    return out

fn ParserExternalPackageRootCertifiedNew(importPrefixRaw: str,
                                           canonicalPackageIdRaw: str,
                                           packageRootRaw: str): ParserExternalPackageRoot =
    return ParserExternalPackageRootCertifiedNewWithChannel(importPrefixRaw,
                                                              canonicalPackageIdRaw,
                                                              packageRootRaw,
                                                              "")

@borrows
fn ParserExternalSourcePathLess(left: str, right: str): bool =
    let sharedLen = left.len < right.len ? left.len : right.len
    for index in 0..<sharedLen:
        if left[index] == right[index]:
            continue
        return left[index] < right[index]
    return left.len < right.len

@borrows
fn ParserExternalPackageRootSnapshotValidate(
        root: ParserExternalPackageRoot): bool =
    if !root.verifiedSnapshotRequired:
        return root.verifiedSourcePaths.len == 0 &&
               root.verifiedSourceTexts.len == 0
    if root.verifiedSourcePaths.len <= 0 ||
       root.verifiedSourcePaths.len != root.verifiedSourceTexts.len:
        return false
    let sourcePrefix = ParserConcat2(root.packageRoot, "/src/")
    for sourceIndex in 0..<root.verifiedSourcePaths.len:
        var canonicalSourcePath: str
        if !ParserSourceIdentityLexicalPathInto(
                root.verifiedSourcePaths[sourceIndex],
                canonicalSourcePath) ||
           canonicalSourcePath != root.verifiedSourcePaths[sourceIndex] ||
           !ParserSourceIdentityPathAbsolute(canonicalSourcePath) ||
           !ParserStartsWithExact(canonicalSourcePath, sourcePrefix):
            return false
        if sourceIndex > 0 &&
           !ParserExternalSourcePathLess(
                root.verifiedSourcePaths[sourceIndex - 1],
                canonicalSourcePath):
            return false
    return true

@borrows
fn ParserExternalPackageRootCertifiedSnapshotNew(
        importPrefixRaw: str,
        canonicalPackageIdRaw: str,
        packageRootRaw: str,
        sourcePaths: str[],
        sourceTexts: str[]): ParserExternalPackageRoot =
    var out = ParserExternalPackageRootCertifiedNew(
        ParserOwnedText(importPrefixRaw),
        ParserOwnedText(canonicalPackageIdRaw),
        ParserOwnedText(packageRootRaw))
    out.verifiedSnapshotRequired = true
    if sourcePaths.len != sourceTexts.len:
        system.Panic(
            "ParserExternalPackageRoot: verified source snapshot length mismatch")
    for sourceIndex in 0..<sourcePaths.len:
        add(out.verifiedSourcePaths,
            ParserOwnedText(sourcePaths[sourceIndex]))
        add(out.verifiedSourceTexts,
            ParserOwnedText(sourceTexts[sourceIndex]))
    if !ParserExternalPackageRootSnapshotValidate(out):
        system.Panic(
            "ParserExternalPackageRoot: invalid verified source snapshot")
    return out

fn ParserExternalPackageRootNewWithChannel(packageIdRaw: str,
                                             packageRootRaw: str,
                                             channelRaw: str): ParserExternalPackageRoot =
    var out = ParserExternalPackageRootCertifiedNewWithChannel(packageIdRaw,
                                                                packageIdRaw,
                                                                packageRootRaw,
                                                                channelRaw)
    # Compatibility/import-only roots carry no semantic-owner certificate.
    # Any source-bundle identity consumer must require the explicit Certified
    # constructor instead of treating an import prefix as package identity.
    out.canonicalPackageId = ""
    return out

fn ParserExternalPackageRootNew(packageIdRaw: str,
                                  packageRootRaw: str): ParserExternalPackageRoot =
    return ParserExternalPackageRootNewWithChannel(packageIdRaw, packageRootRaw, "")

@borrows
fn ParserExternalPackageRootsClone(
        items: ParserExternalPackageRoot[]): ParserExternalPackageRoot[] =
    var out: ParserExternalPackageRoot[]
    for itemIndex in 0..<items.len:
        var item: ParserExternalPackageRoot
        item.packageId = ParserOwnedText(items[itemIndex].packageId)
        item.canonicalPackageId =
            ParserOwnedText(items[itemIndex].canonicalPackageId)
        item.packageRoot =
            ParserOwnedText(items[itemIndex].packageRoot)
        item.channel = ParserOwnedText(items[itemIndex].channel)
        item.verifiedSnapshotRequired =
            items[itemIndex].verifiedSnapshotRequired
        if items[itemIndex].verifiedSourcePaths.len !=
               items[itemIndex].verifiedSourceTexts.len:
            panic("parser: external root verified snapshot length mismatch")
        for sourceIndex in
                0..<items[itemIndex].verifiedSourcePaths.len:
            add(item.verifiedSourcePaths,
                ParserOwnedText(
                    items[itemIndex].verifiedSourcePaths[sourceIndex]))
            add(item.verifiedSourceTexts,
                ParserOwnedText(
                    items[itemIndex].verifiedSourceTexts[sourceIndex]))
        add(out, item)
    return out

@borrows
fn ParserExternalPackageRootByModulePath(modulePathRaw: str,
                                           externalPackageRoots: ParserExternalPackageRoot[],
                                           outPackageRoot: var str,
                                           outPackageId: var str,
                                           outPackagePrefix: var str): bool =
    let modulePath = chengpath.PathTrim(share(modulePathRaw))
    outPackageRoot = ""
    outPackageId = ""
    outPackagePrefix = ""
    var bestLen: int32
    for i in 0..<externalPackageRoots.len:
        let packageId = chengpath.PathTrim(
            share(externalPackageRoots[i].packageId))
        let packageRoot = ParserNormalizePath(externalPackageRoots[i].packageRoot)
        if packageId == "" || packageRoot == "":
            continue
        let packagePrefix = ParserConcat2(packageId, "/")
        if modulePath.len <= packageId.len || !ParserStartsWithExact(modulePath, packagePrefix):
            continue
        if packageId.len <= bestLen:
            continue
        bestLen = packageId.len
        outPackageRoot = packageRoot
        outPackageId = packageId
        outPackagePrefix = packagePrefix
    return bestLen > 0

# import cheng/foo/bar → 命中最长前缀 cheng/foo/ 的外部包根, 取其 channel pin。
# 与 ParserExternalPackageRootByModulePath 同前缀口径; 只在命中包 channel 非空时返 true
# (无 channel = 无 P5 channelId 解析路径, 是增量特性不是降级)。
@borrows
fn ParserExternalPackageChannelByModulePath(modulePathRaw: str,
                                              externalPackageRoots: ParserExternalPackageRoot[],
                                              outChannel: var str): bool =
    let modulePath = chengpath.PathTrim(share(modulePathRaw))
    outChannel = ""
    var bestLen: int32
    for i in 0..<externalPackageRoots.len:
        let packageId = chengpath.PathTrim(
            share(externalPackageRoots[i].packageId))
        let channel = chengpath.PathTrim(
            share(externalPackageRoots[i].channel))
        if packageId == "" || channel == "":
            continue
        let packagePrefix = ParserConcat2(packageId, "/")
        if modulePath.len <= packageId.len || !ParserStartsWithExact(modulePath, packagePrefix):
            continue
        if packageId.len <= bestLen:
            continue
        bestLen = packageId.len
        outChannel = channel
    return bestLen > 0

@borrows
fn ParserExternalPackageRootBySourcePath(sourcePathRaw: str,
                                           externalPackageRoots: ParserExternalPackageRoot[],
                                           outPackageRoot: var str,
                                           outPackageId: var str): bool =
    let sourcePath = ParserNormalizePath(sourcePathRaw)
    outPackageRoot = ""
    outPackageId = ""
    var bestLen: int32
    for i in 0..<externalPackageRoots.len:
        let packageId = chengpath.PathTrim(
            share(externalPackageRoots[i].packageId))
        let packageRoot = ParserNormalizePath(externalPackageRoots[i].packageRoot)
        if packageId == "" || packageRoot == "":
            continue
        let sourcePrefix = ParserConcat2(packageRoot, "/src/")
        if !ParserStartsWithExact(sourcePath, sourcePrefix):
            continue
        if packageRoot.len <= bestLen:
            continue
        bestLen = packageRoot.len
        outPackageRoot = packageRoot
        outPackageId = packageId
    return bestLen > 0

@borrows
fn ParserSourceExists(path: str): bool =
    ParserDebugStage("source_exists_enter")
    if len(path) <= 0:
        return false
    ParserDebugStage("source_exists_after_nonempty")
    let exists = os.FileExists(path)
    ParserDebugStage("source_exists_after_stat")
    return exists

@borrows
fn ParserSourceTextWithExternalPackageRootsInto(
        sourcePathRaw: str,
        externalPackageRoots: ParserExternalPackageRoot[],
        outText: var str,
        err: var str): bool =
    outText = ""
    let sourcePath = ParserNormalizePath(sourcePathRaw)
    if sourcePath == "":
        err = " parser: source path missing"
        return false
    var packageRoot: str
    var packageId: str
    if ParserExternalPackageRootBySourcePath(sourcePath,
                                             externalPackageRoots,
                                             packageRoot,
                                             packageId):
        for rootIndex in 0..<externalPackageRoots.len:
            let root = externalPackageRoots[rootIndex]
            if ParserNormalizePath(root.packageRoot) != packageRoot ||
               chengpath.PathTrim(share(root.packageId)) != packageId:
                continue
            if !root.verifiedSnapshotRequired:
                break
            if !ParserExternalPackageRootSnapshotValidate(root):
                err = " parser: verified external source snapshot invalid"
                return false
            for sourceIndex in 0..<root.verifiedSourcePaths.len:
                if root.verifiedSourcePaths[sourceIndex] == sourcePath:
                    outText = ParserOwnedText(
                        root.verifiedSourceTexts[sourceIndex])
                    err = ""
                    return true
            err = ParserConcat3(
                " parser: verified external source missing from snapshot: ",
                sourcePath,
                "")
            return false
    if !ParserSourceExists(sourcePath):
        err = ParserConcat3(" parser: source missing: ", sourcePath, "")
        return false
    outText = ParserOwnedText(
        chengpath.PathReadTextFileWithHandle(sourcePath))
    err = ""
    return true

@borrows
fn ParserSourceExistsWithExternalPackageRoots(
        sourcePath: str,
        externalPackageRoots: ParserExternalPackageRoot[]): bool =
    var text: str
    var err: str
    return ParserSourceTextWithExternalPackageRootsInto(sourcePath,
                                                         externalPackageRoots,
                                                         text,
                                                         err)

fn ParserExprIsResultIntrinsicName(name: str): bool =
    return ParserResultIntrinsicDetailKind(name) != NormalizedExprDetailNone

@borrows
fn ParserResultIntrinsicDetailKindRange(text: str,
                                          start: int32,
                                          stop: int32): NormalizedExprDetailKind =
    if start < 0 || stop > text.len || stop <= start:
        return NormalizedExprDetailNone
    let tokenLen = stop - start
    let first = text[start]
    if tokenLen == 2:
        if first == 'O' && ParserTextRangeEquals(text, start, tokenLen, "Ok"):
            return NormalizedExprDetailResultOk
        return NormalizedExprDetailNone
    if tokenLen == 3:
        if first == 'E' && ParserTextRangeEquals(text, start, tokenLen, "Err"):
            return NormalizedExprDetailResultErr
        return NormalizedExprDetailNone
    if tokenLen == 4:
        if first == 'I' && ParserTextRangeEquals(text, start, tokenLen, "IsOk"):
            return NormalizedExprDetailResultIsOk
        return NormalizedExprDetailNone
    if tokenLen == 5:
        if first == 'V' && ParserTextRangeEquals(text, start, tokenLen, "Value"):
            return NormalizedExprDetailResultValue
        if first == 'E' && ParserTextRangeEquals(text, start, tokenLen, "Error"):
            return NormalizedExprDetailResultError
        if first == 'I' && ParserTextRangeEquals(text, start, tokenLen, "IsErr"):
            return NormalizedExprDetailResultIsErr
        return NormalizedExprDetailNone
    if tokenLen == 11 &&
       first == 'E' &&
       ParserTextRangeEquals(text, start, tokenLen, "ErrorInfoOf"):
        return NormalizedExprDetailResultErrorInfoOf
    return NormalizedExprDetailNone

@borrows
fn ParserResultIntrinsicDetailKind(name: str): NormalizedExprDetailKind =
    return ParserResultIntrinsicDetailKindRange(name, 0, name.len)

fn ParserFmtExprDetailKind(modeRaw: str): NormalizedExprDetailKind =
    if modeRaw == "fmt_literal":
        return NormalizedExprDetailStrFormatLiteral
    if modeRaw == "fmt_call":
        return NormalizedExprDetailStrFormatCall
    return NormalizedExprDetailNone

fn ParserIsIdentChar(ch: char): bool =
    let digit = ch >= '0' && ch <= '9'
    let upper = ch >= 'A' && ch <= 'Z'
    let lower = ch >= 'a' && ch <= 'z'
    return digit || upper || lower || ch == '_'

@borrows
fn ParserPreviousToken(lineRaw: str,
                         stopExclusive: int32): str =
    if stopExclusive <= 0:
        return ""
    var cursor = stopExclusive
    while cursor > 0:
        let prevPos = cursor - 1
        if !ParserIsInlineSpace(lineRaw[prevPos]):
            break
        cursor = prevPos
    if cursor <= 0:
        return ""
    let end = cursor - 1
    if end < 0:
        return ""
    var start = end + 1
    while start > 0:
        let prevPos = start - 1
        if !ParserIsIdentChar(lineRaw[prevPos]):
            break
        start = prevPos
    if start > end:
        return ""
    return ParserTextSliceCopy(lineRaw, start, end - start + 1)

@borrows
fn ParserPreviousTokenIsDeclKeyword(lineRaw: str,
                                      stopExclusive: int32): bool =
    if stopExclusive <= 0:
        return false
    var cursor = stopExclusive
    while cursor > 0:
        let prevPos = cursor - 1
        if !ParserIsInlineSpace(lineRaw[prevPos]):
            break
        cursor = prevPos
    if cursor <= 0:
        return false
    let end = cursor - 1
    if end < 0:
        return false
    var start = end + 1
    while start > 0:
        let prevPos = start - 1
        if !ParserIsIdentChar(lineRaw[prevPos]):
            break
        start = prevPos
    if start > end:
        return false
    let tokenLen = end - start + 1
    if tokenLen == 2 && ParserTextEqualsAt(lineRaw, start, "fn"):
        return true
    if tokenLen == 4 &&
       (ParserTextEqualsAt(lineRaw, start, "func") ||
        ParserTextEqualsAt(lineRaw, start, "proc")):
        return true
    if tokenLen == 6 && ParserTextEqualsAt(lineRaw, start, "method"):
        return true
    if tokenLen == 7 && ParserTextEqualsAt(lineRaw, start, "importc"):
        return true
    if tokenLen == 9 && ParserTextEqualsAt(lineRaw, start, "converter"):
        return true
    return false

@borrows
fn ParserDottedQualifierDepth(lineRaw: str,
                                identStart: int32): int32 =
    if identStart <= 1:
        return 0
    let qualifierStop = identStart - 1
    if lineRaw[qualifierStop] != '.':
        return 0
    var depth: int32
    var segmentStart: int32 = identStart
    var scanning = true
    while scanning && segmentStart > 1:
        let dotPos = segmentStart - 1
        if lineRaw[dotPos] != '.':
            break
        var identPos = dotPos
        while identPos > 0:
            let prevPos = identPos - 1
            if !ParserIsIdentChar(lineRaw[prevPos]):
                break
            identPos = prevPos
        if identPos >= dotPos:
            break
        depth = depth + 1
        segmentStart = identPos
        if segmentStart <= 1:
            break
        if lineRaw[segmentStart - 1] != '.':
            scanning = false
    return depth

@borrows
fn ParserNextNonSpaceChar(lineRaw: str,
                            start: int32): char =
    for cursor in start..<lineRaw.len:
        if !ParserIsInlineSpace(lineRaw[cursor]):
            return lineRaw[cursor]
    return Char(0)

@borrows
fn ParserSkipInlineSpaces(lineRaw: str,
                            start: int32): int32 =
    var cursor = start
    var scanning = true
    while cursor < lineRaw.len && scanning:
        if ParserIsInlineSpace(lineRaw[cursor]):
            cursor = cursor + 1
        else:
            scanning = false
    return cursor

fn ParserStrictCallSyntaxEnabled(): bool =
    if parserStrictCallSyntaxInitialized:
        return parserStrictCallSyntaxEnabled
    let raw: str = chengpath.PathTrim(os.GetEnv("CHENG_STRICT_CALL_SYNTAX"))
    parserStrictCallSyntaxEnabled = raw == "1" || raw == "true" || raw == "TRUE" || raw == "on" || raw == "yes"
    parserStrictCallSyntaxInitialized = true
    return parserStrictCallSyntaxEnabled

fn ParserStrictAtomStart(ch: char): bool =
    if ParserIsIdentChar(ch):
        return true
    if ch >= '0' && ch <= '9':
        return true
    return ch == '"' || ch == '\'' || ch == '(' || ch == '[' || ch == '{'

@borrows
fn ParserStrictQualifiedStart(lineRaw: str,
                                identStart: int32): int32 =
    var start = identStart
    var scanning = true
    while scanning && start >= 2:
        let dotPos = start - 1
        if lineRaw[dotPos] != '.':
            break
        var segmentStart = dotPos
        while segmentStart > 0:
            let prevPos = segmentStart - 1
            if !ParserIsIdentChar(lineRaw[prevPos]):
                break
            segmentStart = prevPos
        if segmentStart >= dotPos:
            scanning = false
        else:
            start = segmentStart
    return start

@borrows
fn ParserTextLookupContainsAnyExactBorrowed(localCallLookup: ParserTextLookup,
                                              externalCallLookup: ParserTextLookup,
                                              importcCallLookup: ParserTextLookup,
                                              value: str): bool =
    if value == "":
        return false
    if ParserTextLookupContainsExactBorrowed(localCallLookup, value):
        return true
    if ParserTextLookupContainsExactBorrowed(externalCallLookup, value):
        return true
    if ParserTextLookupContainsExactBorrowed(importcCallLookup, value):
        return true
    return false

@borrows
fn ParserStrictKnownCallNameAt3(lineRaw: str,
                                  identStart: int32,
                                  identStop: int32,
                                  localCallLookup: ParserTextLookup,
                                  externalCallLookup: ParserTextLookup,
                                  importcCallLookup: ParserTextLookup): str =
    if identStop <= identStart:
        return ""
    let callName: str = ParserTextSliceCopy(lineRaw, identStart, identStop - identStart)
    if ParserTextLookupContainsAnyExactBorrowed(localCallLookup,
                                                 externalCallLookup,
                                                 importcCallLookup,
                                                 callName):
        return callName
    let qualifiedStart = ParserStrictQualifiedStart(lineRaw, identStart)
    if qualifiedStart < identStart:
        let qualifiedName: str = ParserTextSliceCopy(lineRaw, qualifiedStart, identStop - qualifiedStart)
        if ParserTextLookupContainsAnyExactBorrowed(localCallLookup,
                                                     externalCallLookup,
                                                     importcCallLookup,
                                                     qualifiedName):
            return qualifiedName
    return ""

fn ParserRejectSpaceCallIfStrict3(lineRaw: str,
                                    lineNumber: int32,
                                    localCallLookup: ParserTextLookup,
                                    externalCallLookup: ParserTextLookup,
                                    importcCallLookup: ParserTextLookup,
                                    err: var str): bool =
    if !ParserStrictCallSyntaxEnabled():
        return false
    var inString = false
    var inChar = false
    var cursor: int32
    while cursor < lineRaw.len:
        let ch = lineRaw[cursor]
        if !inChar:
            if ch == Char(34):
                if !ParserQuoteIsEscaped(lineRaw, cursor):
                    inString = !inString
                    cursor = cursor + 1
                    continue
        if !inString:
            if ch == Char(39):
                if !ParserQuoteIsEscaped(lineRaw, cursor):
                    inChar = !inChar
                    cursor = cursor + 1
                    continue
        if inString:
            cursor = cursor + 1
            continue
        if inChar:
            cursor = cursor + 1
            continue
        if ch == Char(35):
            break
        if !ParserIsIdentChar(ch):
            cursor = cursor + 1
            continue
        let identStart = cursor
        while cursor < lineRaw.len:
            if !ParserIsIdentChar(lineRaw[cursor]):
                break
            cursor = cursor + 1
        let identStop = cursor
        if identStop >= lineRaw.len:
            continue
        if !ParserIsInlineSpace(lineRaw[identStop]):
            continue
        let callName: str = ParserStrictKnownCallNameAt3(lineRaw,
                                                          identStart,
                                                          identStop,
                                                          localCallLookup,
                                                          externalCallLookup,
                                                          importcCallLookup)
        if callName == "":
            continue
        let argStart = ParserSkipInlineSpaces(lineRaw, identStop)
        if argStart >= lineRaw.len:
            continue
        let next = lineRaw[argStart]
        if ParserStrictAtomStart(next):
            err = Fmt"Space call syntax is removed in the elegant syntax profile; use f(x) at line {lineNumber} near {callName}"
            return true
    return false

fn ParserParseRangeExpr(textRaw: str,
                          startExprOut: var str,
                          endExprOut: var str,
                          endInclusiveOut: var bool): bool =
    startExprOut = ""
    endExprOut = ""
    endInclusiveOut = false
    let trimmed = chengpath.PathTrim(textRaw)
    if trimmed == "":
        return false
    var opPos = ParserFindTopLevelToken(trimmed, "..<")
    var opLen: int32 = 3
    if opPos < 0:
        opPos = ParserFindTopLevelToken(trimmed, "..")
        opLen = 2
        endInclusiveOut = true
    if opPos <= 0 || opPos + opLen >= trimmed.len:
        return false
    startExprOut = chengpath.PathTrim(ParserTextSliceFast(trimmed, 0, opPos))
    endExprOut = chengpath.PathTrim(ParserTextSliceFast(trimmed,
                                                         opPos + opLen,
                                                         trimmed.len - opPos - opLen))
    return startExprOut != "" && endExprOut != ""

@borrows
fn ParserParseRangeExprAt(lineRaw: str,
                            opPos: int32,
                            startExprOut: var str,
                            endExprOut: var str,
                            endInclusiveOut: var bool): bool =
    startExprOut = ""
    endExprOut = ""
    endInclusiveOut = false
    if opPos < 0 || opPos + 1 >= lineRaw.len:
        return false
    if lineRaw[opPos] != '.' || lineRaw[opPos + 1] != '.':
        return false
    var opLen: int32 = 2
    var hasExclusiveMarker = false
    if opPos + 2 < lineRaw.len:
        hasExclusiveMarker = lineRaw[opPos + 2] == '<'
    if hasExclusiveMarker:
        opLen = 3
    else:
        endInclusiveOut = true
    var segmentStart: int32
    var inString = false
    var inChar = false
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    var i: int32
    while i < opPos:
        let ch = lineRaw[i]
        if !inChar && ch == Char(34) && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
            i = i + 1
            continue
        if !inString && ch == '\'' && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
            i = i + 1
            continue
        if inString || inChar:
            i = i + 1
            continue
        if ch == '(':
            parenDepth = parenDepth + 1
            i = i + 1
            continue
        if ch == ')':
            parenDepth = parenDepth - 1
            i = i + 1
            continue
        if ch == '[':
            bracketDepth = bracketDepth + 1
            segmentStart = i + 1
            i = i + 1
            continue
        if ch == ']':
            bracketDepth = bracketDepth - 1
            i = i + 1
            continue
        if ch == '{':
            braceDepth = braceDepth + 1
            segmentStart = i + 1
            i = i + 1
            continue
        if ch == '}':
            braceDepth = braceDepth - 1
            i = i + 1
            continue
        if parenDepth == 0 &&
           bracketDepth == 0 &&
           braceDepth == 0 &&
           (ch == '=' || ch == ',' || ch == ':'):
            segmentStart = i + 1
        if parenDepth == 0 &&
           bracketDepth == 0 &&
           braceDepth == 0 &&
           ParserTextEqualsAt(lineRaw, i, "in"):
            var leftOk = true
            if i > 0:
                leftOk = !ParserIsIdentChar(lineRaw[i - 1])
            var rightOk = true
            if i + 2 < lineRaw.len:
                rightOk = !ParserIsIdentChar(lineRaw[i + 2])
            if leftOk && rightOk:
                segmentStart = i + 2
                i = i + 2
                continue
        i = i + 1
    var segmentStop = lineRaw.len
    inString = false
    inChar = false
    parenDepth = 0
    bracketDepth = 0
    braceDepth = 0
    i = opPos + opLen
    for i in i..<lineRaw.len:
        let ch = lineRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
            continue
        if !inString && ch == '\'' && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
            continue
        if inString || inChar:
            continue
        if ch == '(':
            parenDepth = parenDepth + 1
            continue
        if ch == ')':
            if parenDepth == 0 && bracketDepth == 0 && braceDepth == 0:
                segmentStop = i
                break
            parenDepth = parenDepth - 1
            continue
        if ch == '[':
            bracketDepth = bracketDepth + 1
            continue
        if ch == ']':
            if parenDepth == 0 && bracketDepth == 0 && braceDepth == 0:
                segmentStop = i
                break
            bracketDepth = bracketDepth - 1
            continue
        if ch == '{':
            braceDepth = braceDepth + 1
            continue
        if ch == '}':
            if parenDepth == 0 && bracketDepth == 0 && braceDepth == 0:
                segmentStop = i
                break
            braceDepth = braceDepth - 1
            continue
        if parenDepth == 0 &&
           bracketDepth == 0 &&
           braceDepth == 0 &&
           (ch == ',' || ch == ':'):
            segmentStop = i
            break
    let rangeText = chengpath.PathTrim(ParserTextSliceFast(lineRaw, segmentStart, segmentStop - segmentStart))
    return ParserParseRangeExpr(rangeText, startExprOut, endExprOut, endInclusiveOut)

@borrows
fn ParserParseFmtExprAt(lineRaw: str,
                          fmtPos: int32,
                          modeOut: var str,
                          literalOut: var str,
                          argTextOut: var str,
                          endColumnOut: var int32): bool =
    modeOut = ""
    literalOut = ""
    argTextOut = ""
    endColumnOut = -1
    if fmtPos < 0 || fmtPos + 3 > lineRaw.len:
        return false
    if !ParserTextEqualsAt(lineRaw, fmtPos, "Fmt"):
        return false
    if fmtPos > 0:
        if ParserIsIdentChar(lineRaw[fmtPos - 1]):
            return false
    if fmtPos + 3 < lineRaw.len:
        if ParserIsIdentChar(lineRaw[fmtPos + 3]):
            return false
    if ParserPreviousTokenIsDeclKeyword(lineRaw, fmtPos):
        return false
    let cursor = ParserSkipInlineSpaces(lineRaw, fmtPos + 3)
    if cursor >= lineRaw.len:
        return false
    let nextChar = lineRaw[cursor]
    if nextChar == '"':
        for closePos in cursor + 1..<lineRaw.len:
            if lineRaw[closePos] == '"' && !ParserQuoteIsEscaped(lineRaw, closePos):
                modeOut = "fmt_literal"
                literalOut = ParserTextSliceCopy(lineRaw, cursor + 1, closePos - cursor - 1)
                argTextOut = ParserTextSliceCopy(lineRaw, cursor, closePos - cursor + 1)
                endColumnOut = closePos + 1
                return true
        return false
    if nextChar == '(':
        let closePos = ParserFindMatchingParen(lineRaw, cursor)
        if closePos <= cursor:
            return false
        modeOut = "fmt_call"
        argTextOut = chengpath.PathTrim(ParserTextSliceFast(lineRaw, cursor + 1, closePos - cursor - 1))
        endColumnOut = closePos + 1
        return true
    return false

@borrows
fn ParserParseListComprehensionAt(lineRaw: str,
                                    openPos: int32,
                                    itemTextOut: var str,
                                    bindingTextOut: var str,
                                    sourceTextOut: var str,
                                    filterTextOut: var str,
                                    filterColumnOut: var int32,
                                    endColumnOut: var int32): bool =
    itemTextOut = ""
    bindingTextOut = ""
    sourceTextOut = ""
    filterTextOut = ""
    filterColumnOut = -1
    endColumnOut = -1
    if openPos < 0 || openPos >= lineRaw.len || lineRaw[openPos] != '[':
        return false
    let closePos = ParserFindMatchingBracket(lineRaw, openPos)
    if closePos <= openPos:
        return false
    let inner = chengpath.PathTrim(ParserTextSliceFast(lineRaw, openPos + 1, closePos - openPos - 1))
    if inner == "":
        return false
    let forPos = ParserFindTopLevelKeyword(inner, "for")
    if forPos <= 0:
        return false
    let inPos = ParserFindTopLevelKeyword(inner, "in")
    if inPos <= forPos + Len("for"):
        return false
    let ifPos = ParserFindTopLevelKeyword(inner, "if")
    itemTextOut = chengpath.PathTrim(ParserTextSliceFast(inner, 0, forPos))
    bindingTextOut = chengpath.PathTrim(ParserTextSliceFast(inner,
                                                             forPos + Len("for"),
                                                             inPos - forPos - Len("for")))
    var sourceStop = inner.len
    if ifPos >= 0:
        sourceStop = ifPos
    sourceTextOut = chengpath.PathTrim(ParserTextSliceFast(inner,
                                                            inPos + Len("in"),
                                                            sourceStop - inPos - Len("in")))
    if ifPos >= 0:
        filterTextOut = chengpath.PathTrim(ParserTextSliceFast(inner,
                                                                ifPos + Len("if"),
                                                                inner.len - ifPos - Len("if")))
        filterColumnOut = openPos + ifPos + 2
    endColumnOut = closePos + 1
    return itemTextOut != "" && bindingTextOut != "" && sourceTextOut != ""

fn ParserIsTrimChar(ch: char): bool =
    if ParserIsInlineSpace(ch):
        return true
    let code = Int32(ch)
    return code == 10 || code == 13

@borrows
fn ParserTrimmedSliceRange(text: str,
                             startRaw: int32,
                             stopRaw: int32): str =
    var start = startRaw
    if start < 0:
        start = 0
    var stop = stopRaw
    if stop > text.len:
        stop = text.len
    if stop <= start:
        return ""
    while start < stop:
        if !ParserIsTrimChar(ParserCharAt(text, start)):
            break
        start = start + 1
    while stop > start:
        let stopIdx: int32 = stop - 1
        if !ParserIsTrimChar(ParserCharAt(text, stopIdx)):
            break
        stop = stop - 1
    if stop <= start:
        return ""
    return ParserOwnedTextRange(text, start, stop - start)

fn ParserTrimmedLineWithoutComment(lineRaw: str): str =
    let stripped = ParserStripLineComment(lineRaw)
    return ParserTrimmedSliceRange(stripped, 0, stripped.len)

@borrows
fn ParserTrimmedLineRange(lineRaw: str,
                            startOut: var int32,
                            stopOut: var int32): bool =
    var start: int32
    var stop = lineRaw.len
    while start < stop:
        if !ParserIsTrimChar(lineRaw[start]):
            break
        start = start + 1
    while stop > start:
        if !ParserIsTrimChar(lineRaw[stop - 1]):
            break
        stop = stop - 1
    startOut = start
    stopOut = stop
    return stop > start

@borrows
fn ParserTrimmedCommentRange(lineRaw: str,
                               startOut: var int32,
                               stopOut: var int32): bool =
    var stop = lineRaw.len
    let hashPos = ParserFindText(lineRaw, "#")
    if hashPos >= 0:
        stop = hashPos
    var start: int32
    while start < stop:
        if !ParserIsTrimChar(lineRaw[start]):
            break
        start = start + 1
    while stop > start:
        if !ParserIsTrimChar(lineRaw[stop - 1]):
            break
        stop = stop - 1
    startOut = start
    stopOut = stop
    return stop > start

@borrows
fn ParserImportLineTailRange(lineRaw: str,
                               startOut: var int32,
                               stopOut: var int32): bool =
    startOut = -1
    stopOut = -1
    var lineStart: int32
    var lineStop: int32
    if !ParserTrimmedCommentRange(lineRaw, lineStart, lineStop):
        return false
    let importPrefix = "import "
    if lineStart + importPrefix.len > lineStop:
        return false
    if !ParserTextRangeEquals(lineRaw, lineStart, importPrefix.len, importPrefix):
        return false
    startOut = lineStart + importPrefix.len
    stopOut = lineStop
    return true

@borrows
fn ParserHasNonTrimChar(lineRaw: str): bool =
    for i in 0..<lineRaw.len:
        if !ParserIsTrimChar(lineRaw[i]):
            return true
    return false

@borrows
fn ParserLineTrimmedEquals(lineRaw: str, word: str): bool =
    let wordLen = word.len
    if wordLen <= 0:
        return false
    var start = 0
    while start < lineRaw.len && ParserIsTrimChar(lineRaw[start]):
        start = start + 1
    if start + wordLen > lineRaw.len:
        return false
    for i in 0..<wordLen:
        if lineRaw[start + i] != word[i]:
            return false
    let endPos = start + wordLen
    if endPos >= lineRaw.len:
        return true
    return ParserIsTrimChar(lineRaw[endPos])

@borrows
fn ParserStripLineComment(lineRaw: str): str =
    # Hot: most source lines have no '#' — skip quote-state machine entirely.
    # Semantic identity: unchanged bytes still cross this boundary as a new owner.
    let n = lineRaw.len
    if n <= 0:
        return ParserOwnedText(lineRaw)
    var probe: int32
    while probe < n:
        if lineRaw[probe] == '#':
            break
        probe = probe + 1
    if probe >= n:
        return ParserOwnedText(lineRaw)
    var inString = false
    var inChar = false
    for i in 0..<n:
        let ch = lineRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
        elif !inString && ch == '\'' && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
        elif !inString && !inChar && ch == '#':
            return ParserOwnedTextRange(lineRaw, 0, i)
    return ParserOwnedText(lineRaw)

# View-returning twin of ParserStripLineComment for hot read-only scans:
# identical '#'-quote-aware stripping, but the unchanged/truncated bytes are
# returned as a borrow instead of ParserOwnedText/ParserOwnedTextRange copies.
# Callers must not retain the result past the input line's lifetime.
@borrows
@borrow_result
fn ParserStripLineCommentHashAwareView(lineRaw: str): str =
    let n = lineRaw.len
    if n <= 0:
        return lineRaw
    var probe: int32
    while probe < n:
        if lineRaw[probe] == '#':
            break
        probe = probe + 1
    if probe >= n:
        return lineRaw
    var inString = false
    var inChar = false
    for i in 0..<n:
        let ch = lineRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
        elif !inString && ch == '\'' && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
        elif !inString && !inChar && ch == '#':
            return ParserTextSliceFast(lineRaw, 0, i)
    return lineRaw


# `//`-aware 版本: ParserStripLineComment 只认 '#' 前缀行注释(编译器自身源码
# 惯用记号), 但 Cheng 词法层(outline_parser.cheng)同时接受 '#' 与 '//' 两种行
# 注释前缀, std/app 代码(如 json.cheng)一律用 '//'。纯 '//' 注释行经
# ParserStripLineComment 剥不掉、原样当代码文本存活, 若行内碰巧含未配对的
# '('/'[' (哪怕落在非字符串的英文单引号内, 如 `// state.pos is at opening '['`)
# 会被续行括号深度扫描误判成"这行没写完", 把注释行之后的整个函数体逐行拼接成
# 一条巨型伪语句, 命中文本里某处真实的 return 关键字后炸出畸形返回语句
# (bail=801, jsonParseArray 一类)。只给续行判定/空行判定这一类消费点用; 不改
# ParserStripLineComment 本体(25+ 既有调用点只关心"是否空行/是否有缩进", 与
# 注释记号选取无关, 改本体是超出本次窄安全切口验证范围的宽改动)。
@borrows
@borrow_result
fn ParserStripLineCommentSlashAware(lineRaw: str): str =
    # Hot: lines without '#' and '/' cannot host '#' or '//' comments.
    let n = lineRaw.len
    if n <= 0:
        return lineRaw
    var probe: int32
    while probe < n:
        let pch = lineRaw[probe]
        if pch == '#' || pch == '/':
            break
        probe = probe + 1
    if probe >= n:
        return lineRaw
    var inString = false
    var inChar = false
    for i in 0..<n:
        let ch = lineRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
        elif !inString && ch == '\'' && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
        elif !inString && !inChar && ch == '#':
            return ParserTextSliceFast(lineRaw, 0, i)
        elif !inString && !inChar && ch == '/' && i + 1 < n && lineRaw[i + 1] == '/':
            return ParserTextSliceFast(lineRaw, 0, i)
    return lineRaw

# `//`-aware 版本: ParserTrimmedCommentRange 只认 '#' 前缀行注释, 与
# ParserStripLineComment 本体同一缺口(见 ParserStripLineCommentSlashAware 定义
# 处注释)。这里只给"结构判定"消费点(控制头/match 头关键字识别的 trim 边界)用:
# 纯 '//' 注释行/行尾 '//' 注释剥不掉、原样留在 [start,stop) 范围内, 若其中碰巧
# 含冒号(如 `if x > 0 // note: check`), 会被下游顶层冒号扫描误判成"条件已闭合"
# 或让顶层关键字/冒号定位越过注释文本产生偏差(同 ParserJoinContinuationLines 一
# 族的剥注释驱动结构判定缺口)。start/stop 仍是 lineRaw 原始下标(与
# ParserTrimmedCommentRange 契约一致), 复用 ParserStripLineCommentSlashAware 的
# quote-aware 扫描(避免把字符串字面量里的 "//"，如 URL，误判成注释起点)。
@borrows
fn ParserTrimmedCommentRangeSlashAware(lineRaw: str,
                               startOut: var int32,
                               stopOut: var int32): bool =
    let stripped = ParserStripLineCommentSlashAware(lineRaw)
    var stop = stripped.len
    var start: int32
    while start < stop:
        if !ParserIsTrimChar(lineRaw[start]):
            break
        start = start + 1
    while stop > start:
        if !ParserIsTrimChar(lineRaw[stop - 1]):
            break
        stop = stop - 1
    startOut = start
    stopOut = stop
    return stop > start

# 续行拼接专用: quote-aware 剥注释 + trim。头行早已用 ParserStripLineComment,
# 续行若用 quote-blind 的 ParserTrimmedLineWithoutComment 会把字符串字面量内的
# '#' 当注释起点截断, 语句 surfaceText 变成引号/括号不闭合的调用前缀, 节点路径
# 与文本 whole-call 双拒 → bail=707 (dispatch_min 闭包 15/18 行主根)。
fn ParserTrimmedLineWithoutCommentQuoteAware(lineRaw: str): str =
    let stripped = ParserStripLineComment(lineRaw)
    return ParserTrimmedSliceRange(stripped, 0, stripped.len)

# `//`-aware 版本: 续行拼接消费点(ParserJoinContinuationLines/InPlace)专用。头行
# 判定已换 ParserStripLineCommentSlashAware, 若续行文本抽取仍用只认 '#' 的
# ParserTrimmedLineWithoutCommentQuoteAware, 纯 '//' 续行会原样当代码文本拼进
# `line`, 其杂散内容会误导下一轮 ParserLineNeedsContinuation 判定(同族缺口)。
@borrows
fn ParserTrimmedLineWithoutCommentQuoteAwareSlashAware(lineRaw: str): str =
    let stripped = ParserStripLineCommentSlashAware(lineRaw)
    return ParserTrimmedSliceRange(stripped, 0, stripped.len)

# [c1-declname] 归一化表达式族声明名 token 排除的精确证据源: value-expr
# 树声明 CSR 里 ParserDeclarationFunction 行的名字 token。泛型声明头
# `fn Ok[T](value: T): Result[T]` 的声明名 `Ok` 是声明身份, 不是表达式;
# 行扫描器把它追加成 NormalizedExprResultIntrinsic 表达式行后, 该行在
# value-expr 树中无声明节点 (root/origin 双 -1), 下游 compiler parser
# receipt 对函数身份域内每条归一化表达式要求携带 parser 节点, 必然
# fail-closed ("normalized expression parser node missing")。镜像
# phaseB-enum 成员行排除法, 证据源升级到 token 精度: 仅当 (line, column)
# 与声明名 token 的精确位置重合才排除, 同签名行其余位置的合法 Result
# intrinsic 表达式不受影响。列口径: token 列与行扫描 append 的 col=i+1
# 同为 1-based 字节列 (词法 initialColumnNumber=1, 逐字节推进)。
@borrows
fn ParserValueExprFunctionDeclNameAt(tree: ParserValueExprTree,
                                       line: int32,
                                       column: int32): bool =
    if line < 1 || column < 1:
        return false
    for row in 0..<tree.declarationCount:
        if ParserDeclarationKind(
               arenamod.ArenaArrayInt32Get(
                   tree.arena, tree.declarationKinds, row)) ==
               ParserDeclarationFunction:
            let nameToken = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.declarationNameTokenIndexes, row)
            if nameToken >= 0 && nameToken < tree.tokenCount:
                if ParserValueExprTokenLineAt(tree, nameToken) == line:
                    if ParserValueExprTokenColumnAt(tree, nameToken) ==
                           column:
                        return true
    return false

@borrows
fn ParserAppendSimpleSurfaceExprsLine(sourcePath: str,
                                        lineNumber: int32,
                                        lineRaw: str,
                                        appendIfExprs: bool,
                                        appendQuestionExprs: bool,
                                        appendResultIntrinsics: bool,
                                        layer: var NormalizedExprLayer) =
    var i: int32
    var inString = false
    var inChar = false
    while i < lineRaw.len:
        let ch = lineRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
            i = i + 1
            continue
        if !inString && ch == '\'' && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
            i = i + 1
            continue
        if inString || inChar:
            i = i + 1
            continue
        if appendQuestionExprs && ch == '?':
            let nextChar = ParserNextNonSpaceChar(lineRaw, i + 1)
            if nextChar == Char(0) || nextChar == ',' || nextChar == ';' ||
               nextChar == ':' || nextChar == ')' || nextChar == ']' || nextChar == '}':
                NormalizedExprLayerAppend(layer,
                                            sourcePath,
                                            lineNumber,
                                            i + 1,
                                            NormalizedExprTry,
                                            NormalizedExprDetailTryPostfixQuestion,
                                            "?")
            # 三元 `?`（IfTernary）不建 surface 条目：该条目无任何消费者
            # （grep 全树仅建/打印两引用），且无合法身份模型——root>=0 路径
            # 无 anchor==`?` 位置的 statement root event 可绑（seal line/col
            # 校验必撞），origin 字段在 structured source 域被严格定义为
            # call 专属（:30262）。typed 层三元消费走 parser 树 Ternary
            # 节点（CompositeActive/StaticExprTypeAtLevel），不经此行扫描。
            i = i + 1
            continue
        if !ParserIsIdentChar(ch):
            i = i + 1
            continue
        if i > 0:
            if ParserIsIdentChar(lineRaw[i - 1]):
                i = i + 1
                continue
        var stop = i + 1
        while stop < lineRaw.len:
            if !ParserIsIdentChar(lineRaw[stop]):
                break
            stop = stop + 1
        let identLen = stop - i
        if appendIfExprs &&
           identLen == 2 &&
           lineRaw[i] == 'i' &&
           ParserTextRangeEquals(lineRaw, i, identLen, "if"):
            NormalizedExprLayerAppend(layer,
                                        sourcePath,
                                        lineNumber,
                                        i + 1,
                                        NormalizedExprIf,
                                        NormalizedExprDetailIfKeyword,
                                        "if")
        elif appendResultIntrinsics &&
             ParserPreviousNonSpaceChar(lineRaw, i) != '.' &&
             ParserFindTopLevelTokenRange(lineRaw, stop, lineRaw.len, "=>") < 0:
            let detailKind = ParserResultIntrinsicDetailKindRange(lineRaw, i, stop)
            if detailKind != NormalizedExprDetailNone:
                # [c1-declname] 声明名 token 排除: 该 (line, col) 若是
                # 函数声明名 token (如 `fn Ok[T]` 的 `Ok`), 它是声明身份
                # 不是表达式, 跳过 append; 同行其余位置的合法 Result
                # intrinsic 表达式不受影响 (token 精度, 证据源见 helper)。
                if !ParserValueExprFunctionDeclNameAt(
                       layer.valueExprTree, lineNumber, i + 1):
                    let ident = ParserTextSliceCopy(lineRaw, i, identLen)
                    NormalizedExprLayerAppend(layer,
                                                sourcePath,
                                                lineNumber,
                                                i + 1,
                                                NormalizedExprResultIntrinsic,
                                                detailKind,
                                                ident)
        i = stop

@borrows
fn ParserStatementHeadKeywordCodeRange(lineRaw: str,
                                         start: int32,
                                         stop: int32): int32 =
    if start < 0 || stop > lineRaw.len || stop <= start:
        return 0
    let tokenLen = stop - start
    let first = lineRaw[start]
    if tokenLen == 2:
        if first == 'f' && ParserTextRangeEquals(lineRaw, start, tokenLen, "fn"):
            return 1
        if first == 'i' && ParserTextRangeEquals(lineRaw, start, tokenLen, "if"):
            return 1
        return 0
    if tokenLen == 3:
        if first == 'l' && ParserTextRangeEquals(lineRaw, start, tokenLen, "let"):
            return 1
        if first == 'v' && ParserTextRangeEquals(lineRaw, start, tokenLen, "var"):
            return 1
        if first == 'f' && ParserTextRangeEquals(lineRaw, start, tokenLen, "for"):
            return 1
        return 0
    if tokenLen == 4:
        if first == 't' && ParserTextRangeEquals(lineRaw, start, tokenLen, "type"):
            return 1
        if first == 'e' && ParserTextRangeEquals(lineRaw, start, tokenLen, "elif"):
            return 1
        # "else" 是 4 字节 (e-l-s-e), 之前误放在 tokenLen==5 分支里 (与 5 字节
        # 的 ParserTextRangeEquals 长度比较恒假, 死代码, 从未真正匹配过) ——
        # "else: STMT" 单行 suite 因此从未被当成语句头关键字挡下, 落到通用
        # 顶层 "=" 扫描, 把整个 "else: gI4" 当成赋值目标名 (T38B 案卷实测的
        # 垃圾切片根因之一)。挪到这里, 长度与实际字节数一致。
        if first == 'e' && ParserTextRangeEquals(lineRaw, start, tokenLen, "else"):
            return 1
        return 0
    if tokenLen == 5:
        if first == 'c' && ParserTextRangeEquals(lineRaw, start, tokenLen, "const"):
            return 1
        if first == 'w' && ParserTextRangeEquals(lineRaw, start, tokenLen, "while"):
            return 1
        if first == 'd' && ParserTextRangeEquals(lineRaw, start, tokenLen, "defer"):
            return 1
        if first == 'b' && ParserTextRangeEquals(lineRaw, start, tokenLen, "break"):
            return 1
        return 0
    if tokenLen == 6:
        if first == 'i' && ParserTextRangeEquals(lineRaw, start, tokenLen, "import"):
            return 1
        if first == 'r' && ParserTextRangeEquals(lineRaw, start, tokenLen, "return"):
            return 1
        return 0
    if tokenLen == 8:
        if first == 'c' && ParserTextRangeEquals(lineRaw, start, tokenLen, "continue"):
            return 1
        return 0
    return 0

@borrows
fn ParserPreviousNonSpaceChar(lineRaw: str,
                                stopExclusive: int32): char =
    if stopExclusive <= 0:
        return Char(0)
    var cursor = stopExclusive
    while cursor > 0:
        let prevPos = cursor - 1
        if !ParserIsInlineSpace(lineRaw[prevPos]):
            return lineRaw[prevPos]
        cursor = prevPos
    return Char(0)

# Position of the previous non-space char before stopExclusive, or -1 when only
# whitespace/start precedes. Lets a scanner inspect the two-char `=>` arm arrow
# (whose `>` is the immediate predecessor of an inline arm body).
@borrows
fn ParserPreviousNonSpaceCharPos(lineRaw: str,
                                   stopExclusive: int32): int32 =
    if stopExclusive <= 0:
        return -1
    var cursor = stopExclusive
    while cursor > 0:
        let prevPos = cursor - 1
        if !ParserIsInlineSpace(lineRaw[prevPos]):
            return prevPos
        cursor = prevPos
    return -1

@borrows
fn ParserAppendReturnStmtExprsLine(sourcePath: str,
                                    lineNumber: int32,
                                    lineRaw: str,
                                    layer: var NormalizedExprLayer) =
    var i: int32
    var inString = false
    var inChar = false
    while i < lineRaw.len:
        let ch = lineRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
            i = i + 1
            continue
        if !inString && ch == Char(39) && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
            i = i + 1
            continue
        if inString || inChar:
            i = i + 1
            continue
        if ch == Char(35):
            return
        if !ParserIsIdentChar(ch):
            i = i + 1
            continue
        if i > 0:
            if ParserIsIdentChar(lineRaw[i - 1]):
                i = i + 1
                continue
        var stop = i + 1
        while stop < lineRaw.len:
            if !ParserIsIdentChar(lineRaw[stop]):
                break
            stop = stop + 1
        let ident = ParserTextSliceCopy(lineRaw, i, stop - i)
        if ident == "return":
            let prevPos = ParserPreviousNonSpaceCharPos(lineRaw, i)
            var prev: char
            if prevPos >= 0:
                prev = lineRaw[prevPos]
            else:
                prev = Char(0)
            # inline match-arm return body (`Label => return E`): the arm arrow's
            # `>` precedes the return. Accept it so the per-arm return value is
            # captured (it nests as the rewritten-if then-body). `=>` is the only
            # construct where `>` legitimately precedes a statement-leading return.
            var armArrowReturn = false
            if prev == '>' && prevPos >= 1 && lineRaw[prevPos - 1] == '=':
                armArrowReturn = true
            # inline Form-B 单行函数体（`fn f(): T = return E`）：`=` 是除
            # `=>` 外唯一能合法先行 return 的字符。补行让 normalized layer
            # 持有该 return 行（随后 BindStatementRoots 按 role+anchor 精确
            # 绑 tree root），function receipt 的 normalized statement
            # identity 才能覆盖 inline 体（csg snapshot 的 function origin
            # receipt 消费它），typed_expr 的 scope-start return 直读路径
            # 也由此认领。
            if prev == Char(0) || prev == ':' || prev == ';' ||
               armArrowReturn || prev == '=':
                let exprText = ParserTrimmedSliceRange(lineRaw,
                                                       stop,
                                                       lineRaw.len)
                # 裸 `return`（无表达式）不建 surface Return 条目：parser
                # value-expr 层对裸 return 不建 statement root event
                # (:24269-24272 同构), surface 条目 root/anchor 无从绑定,
                # seal 必撞 frozen anchor missing; 且 exprText 空无信息量。
                if exprText != "":
                    NormalizedExprLayerAppendSpan(layer,
                                                  sourcePath,
                                                  lineNumber,
                                                  i + 1,
                                                  NormalizedExprReturn,
                                                  NormalizedExprDetailNone,
                                                  exprText,
                                                  lineRaw.len)
        i = stop

@borrows
fn ParserLineRangeStartsWithStatementKeyword(lineRaw: str,
                                               start: int32,
                                               stop: int32,
                                               keyword: str): bool =
    let keywordLen = keyword.len
    if keywordLen <= 0:
        return false
    let lineLen = stop - start
    if lineLen < keywordLen:
        return false
    for i in 0..<keywordLen:
        if lineRaw[start + i] != keyword[i]:
            return false
    if lineLen == keywordLen:
        return true
    let nextCh = lineRaw[start + keywordLen]
    if ParserIsInlineSpace(nextCh):
        return true
    return nextCh == ':'

@borrows
fn ParserLineStartsWithStatementKeyword(lineRaw: str,
                                          keyword: str): bool =
    var start: int32
    var stop: int32
    if !ParserTrimmedCommentRange(lineRaw, start, stop):
        return false
    return ParserLineRangeStartsWithStatementKeyword(lineRaw,
                                                     start,
                                                     stop,
                                                     keyword)

@borrows
fn ParserLineRangeEqualsElseControlKeyword(lineRaw: str,
                                             start: int32,
                                             stop: int32): bool =
    let keyword = "else"
    let keywordLen = keyword.len
    let lineLen = stop - start
    if lineLen < keywordLen:
        return false
    for i in 0..<keywordLen:
        if lineRaw[start + i] != keyword[i]:
            return false
    if lineLen == keywordLen:
        return true
    # T38B: 原先要求 lineLen 恰好 == keywordLen+1 (即整行只能是精确的
    # "else:", 不能再有任何内容), 单行 else suite (`else: STMT`) 因此从未
    # 被识别成 ElseStmt——STMT 的赋值虽被 ParserAppendAssignStmtExprsLine
    # (本案卷同批修复) 正确解析出来, 但没有 ElseStmt 语句包住它, 后端把它
    # 当成无条件的顶层语句, 致 if 分支为真时仍被 else 体覆盖 (实测:
    # `if v>100: gI4=999 else: gI4=v` 传入 v=200 时错误产出 gI4=200, 应为
    # 999)。放宽成与 if/elif/for/while 同款的前缀语义 (紧跟字符是 ':' 即可,
    # 不要求到此为止), STMT 交给既有的同行 body 归属机制 (indent+lineNumber
    # 判定, 见 PrimaryBodyIrStructuredBodyEnd) 处理, 与 elif/while/for 单行
    # suite 已验证正确的路径一致。
    return lineRaw[start + keywordLen] == ':'

@borrows
fn ParserLineTokenEquals(lineRaw: str,
                          start: int32,
                          stop: int32,
                          keyword: str): bool =
    let tokenLen = stop - start
    if tokenLen != keyword.len:
        return false
    for i in 0..<tokenLen:
        if lineRaw[start + i] != keyword[i]:
            return false
    return true

# T38B: 单行控制头 suite (`if`/`elif`/`else`/`while`/`for`/`defer`
# [COND] ":" STMT,
# suite ::= statement 钦定合法, 见 docs/cheng-formal-spec.md:247) 与单行函数体
# 糖 (`fn f(...) [: T] = STMT`) 同构——整行以关键字起头, 但真正的语句体
# STMT 在签名 "=" 或控制头顶层 ":" 之后。判定"头 token 是不是这几个控制
# 关键字之一"抽成共用判定, 避免多处判定标准漂移。
@borrows
fn ParserLineHeadTokenIsInlineSuiteControlKeyword(lineRaw: str,
                                                    start: int32,
                                                    tokenStop: int32): bool =
    let tokenLen = tokenStop - start
    if ParserTextRangeEquals(lineRaw, start, tokenLen, "if"):
        return true
    if ParserTextRangeEquals(lineRaw, start, tokenLen, "elif"):
        return true
    if ParserTextRangeEquals(lineRaw, start, tokenLen, "else"):
        return true
    if ParserTextRangeEquals(lineRaw, start, tokenLen, "while"):
        return true
    if ParserTextRangeEquals(lineRaw, start, tokenLen, "for"):
        return true
    if ParserTextRangeEquals(lineRaw, start, tokenLen, "defer"):
        return true
    return false

# [searchStart, lineStop) 范围内, 若起始处是单行控制头 suite 关键字
# (if/elif/else/while/for/defer), 返回该头部顶层 ":" 的位置 (suite 分隔符); 否则
# -1。供 ParserAssignmentStmtSearchStart / ParserControlHeaderInlineBodyColumn
# 共用, 两处判定标准不漂移。
@borrows
fn ParserInlineSuiteHeadColonPos(lineRaw: str,
                                   searchStartRaw: int32,
                                   lineStop: int32): int32 =
    var start = searchStartRaw
    if start < 0:
        start = 0
    while start < lineStop && ParserIsInlineSpace(lineRaw[start]):
        start = start + 1
    var tokenStop = start
    while tokenStop < lineStop:
        if !ParserIsIdentChar(lineRaw[tokenStop]):
            break
        tokenStop = tokenStop + 1
    if tokenStop <= start:
        return -1
    if !ParserLineHeadTokenIsInlineSuiteControlKeyword(lineRaw, start, tokenStop):
        return -1
    return ParserFindTopLevelTokenRange(lineRaw, tokenStop, lineStop, ":")

# 从 [searchStart, lineStop) 起, 沿着可能嵌套的单行控制头 suite 链
# (`if a: if b: STMT` 这种形态, 或 T38 的 `fn f(...) = if c: STMT` 复合形态)
# 一路跳过控制头, 落到真正的语句体 STMT 起点。每跳过一层, searchStart 严格
# 前进 (colonPos+1 > 上一轮 searchStart), 保证有限步终止。不是控制头起始时
# 原样返回 searchStart。
@borrows
fn ParserInlineSuiteStatementStart(lineRaw: str,
                                     searchStartRaw: int32,
                                     lineStop: int32): int32 =
    var searchStart = searchStartRaw
    if searchStart < 0:
        searchStart = 0
    while true:
        let colonPos = ParserInlineSuiteHeadColonPos(lineRaw, searchStart, lineStop)
        if colonPos < 0:
            return searchStart
        searchStart = colonPos + 1

# 计算一行"真正应该开始查找赋值 '=' 的位置"。绝大多数行 (不以语句头关键字
# 起头) 从 0 开始, 与原 ParserFindTopLevelAssignmentEq(lineRaw) 逐字节等价。
# 以 "fn" 起头的行 (单行函数体糖) 或以 if/elif/else/while/for/defer 起头的行 (单行
# 控制头 suite) 跳过签名 "=" 或控制头 ":" (可能又是另一层单行 suite, 递归
# 跳过), 落到真正的语句体起点。其余语句头关键字 (let/var/const/type/import/
# return/break/continue) 从不含内联赋值语句体, 返回 -1 表示"整行都不是赋值候选"。
# ParserLineIsAssignmentStmtCandidate / ParserAppendAssignStmtExprsLine 都靠
# 这一个函数判定起点, 避免两处判定标准漂移 (T38 案卷同款教训)。
@borrows
fn ParserAssignmentStmtSearchStart(lineRaw: str): int32 =
    var start: int32
    var stop: int32
    if !ParserTrimmedLineRange(lineRaw, start, stop):
        return -1
    var tokenStop = start
    while tokenStop < stop:
        if !ParserIsIdentChar(lineRaw[tokenStop]):
            break
        tokenStop = tokenStop + 1
    if tokenStop <= start:
        return 0
    if ParserStatementHeadKeywordCodeRange(lineRaw, start, tokenStop) == 0:
        return 0
    if ParserTextRangeEquals(lineRaw, start, tokenStop - start, "fn"):
        # 单行函数体糖: 签名自身的顶层 "=" 之后是真正的语句体 STMT (可能还
        # 嵌套一层单行控制头 suite, 如 `fn f(v) = if c: g = v`)。签名声明了
        # 返回类型 (`)` 与顶层 "=" 之间还有顶层 ":T") 时交给既有单表达式函数
        # 体路径, 不当赋值候选展开——同 ParserControlHeaderSearchStart 的判定,
        # 两处不漂移。
        let sigEqPos = ParserFindTopLevelAssignmentEq(lineRaw)
        if sigEqPos < 0:
            return -1
        if ParserFindTopLevelTokenRange(lineRaw, start, sigEqPos, ":") >= 0:
            return -1
        return ParserInlineSuiteStatementStart(lineRaw, sigEqPos + 1, stop)
    if ParserLineHeadTokenIsInlineSuiteControlKeyword(lineRaw, start, tokenStop):
        # 单行控制头 suite: 头部顶层 ":" 之后是真正的语句体 STMT。
        let headColonPos = ParserFindTopLevelTokenRange(lineRaw, tokenStop, stop, ":")
        if headColonPos < 0:
            return -1
        return ParserInlineSuiteStatementStart(lineRaw, headColonPos + 1, stop)
    return -1

# 单行控制头 suite (if/elif/else/while/for, 可能嵌套) 的语句体起点 1-based
# 列号——供 typed_expr 判定"同行调用落在控制头条件部分 (属于头部本身/更内层
# 条件) 还是内联语句体部分 (属于 then/loop 体, 该按普通语句处理而不是被误当
# 成条件内嵌调用消费掉)"。行首不是这些控制关键字时返回 0 (整行都是语句体或
# 其它构造, 不做任何限制, 保持既有行为——例如 `let x = if c: a else: b` 这种
# 三元表达式绑定行, 行首是 "let" 不是控制关键字, 原样放行)。
@borrows
fn ParserControlHeaderInlineBodyColumn(lineRaw: str): int32 =
    let bodyStart = ParserInlineSuiteStatementStart(lineRaw, 0, lineRaw.len)
    if bodyStart <= 0:
        return 0
    return bodyStart + 1

@borrows
fn ParserLineIsAssignmentStmtCandidate(lineRaw: str): bool =
    let searchStart = ParserAssignmentStmtSearchStart(lineRaw)
    if searchStart < 0:
        return false
    return ParserFindTopLevelAssignmentEqFrom(lineRaw, searchStart) >= 0

@borrows
fn ParserFindTopLevelTokenRange(textRaw: str,
                                  startRaw: int32,
                                  stopRaw: int32,
                                  target: str): int32 =
    var start = startRaw
    if start < 0:
        start = 0
    var stop = stopRaw
    if stop > textRaw.len:
        stop = textRaw.len
    if target == "" || stop <= start || target.len > stop - start:
        return -1
    var inString = false
    var inChar = false
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    var i = start
    while i < stop:
        let ch = textRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(textRaw, i):
            inString = !inString
            i = i + 1
            continue
        if !inString && ch == Char(39) && !ParserQuoteIsEscaped(textRaw, i):
            inChar = !inChar
            i = i + 1
            continue
        if inString || inChar:
            i = i + 1
            continue
        if ch == '(':
            parenDepth = parenDepth + 1
            i = i + 1
            continue
        if ch == ')':
            parenDepth = parenDepth - 1
            i = i + 1
            continue
        if ch == '[':
            bracketDepth = bracketDepth + 1
            i = i + 1
            continue
        if ch == ']':
            bracketDepth = bracketDepth - 1
            i = i + 1
            continue
        if ch == '{':
            braceDepth = braceDepth + 1
            i = i + 1
            continue
        if ch == '}':
            braceDepth = braceDepth - 1
            i = i + 1
            continue
        if parenDepth == 0 &&
           bracketDepth == 0 &&
           braceDepth == 0 &&
           i + target.len <= stop &&
           ParserTextEqualsAt(textRaw, i, target):
            return i
        i = i + 1
    return -1

@borrows
fn ParserAppendAssignStmtExprsLine(sourcePath: str,
                                    lineNumber: int32,
                                    lineRaw: str,
                                    layer: var NormalizedExprLayer) =
    # 单行函数体糖 (`fn f(...) = STMT`) / 单行控制头 suite
    # (`if/elif/else/while/for ... : STMT`, 可能嵌套) 都由
    # ParserAssignmentStmtSearchStart 统一算出真正的语句体起点——与
    # ParserLineIsAssignmentStmtCandidate 共用同一判定标准, 两处不漂移。
    let assignSearchStart = ParserAssignmentStmtSearchStart(lineRaw)
    if assignSearchStart < 0:
        return
    let eqPos = ParserFindTopLevelAssignmentEqFrom(lineRaw, assignSearchStart)
    if eqPos < 0:
        return
    let lhsText = ParserTrimmedSliceRange(lineRaw, assignSearchStart, eqPos)
    let rhsText = ParserTrimmedSliceRange(lineRaw,
                                          eqPos + 1,
                                          lineRaw.len)
    if lhsText == "" || rhsText == "":
        return
    # 语句 columnNumber 是第一个非空白字符的 1-based 列, 不是 eqPos+1 (赋值号
    # 列) — deref 赋值 `*(...) = v` 起点是 `*` (如 core_runtime:431 col 9),
    # 用 eqPos+1 (col 45) 会让 defer scope transport 把语句 span 误判为超出
    # 其 lexical scope (wave5 既有)。
    var stmtColumnStart = assignSearchStart
    while stmtColumnStart < lineRaw.len &&
          (lineRaw[stmtColumnStart] == ' ' || lineRaw[stmtColumnStart] == '\t'):
        stmtColumnStart = stmtColumnStart + 1
    NormalizedExprLayerAppendAssign(layer,
                                    share(sourcePath),
                                    lineNumber,
                                    stmtColumnStart + 1,
                                    lhsText,
                                    rhsText,
                                    lineRaw.len)

# 单行函数体糖 `fn f(...) [: T] = STMT` 的 STMT 本身若又是单行控制头 suite
# (`fn f(v) = if c: g = v`), 真正的控制关键字不在行首(行首是 "fn")而在签名
# 顶层 "=" 之后。返回"控制头关键字检测应该从哪个字节开始"——非 "fn" 起头的
# 行原样返回 lineStart (逐字节兼容旧行为); "fn" 起头且能找到签名顶层 "="
# 时返回其后一位 (调用方自行跳过前导空白); 找不到顶层 "=" 时返回 -1。
#
# 签名声明了返回类型 (`)` 与顶层 "=" 之间还有顶层 ":T") 时也返回 lineStart,
# 即不把 STMT 当控制语句体展开——纯语法层面无法区分 `fn f(v): T = if c: a
# else: b` 到底是"控制语句体"(void 函数, suite ::= statement) 还是"三元
# if-表达式"(有返回类型时才有意义), 但"是否声明了返回类型"这个语法信号可以
# 分辨: 有声明就交给既有的单表达式函数体/三元 if-表达式路径 (T38 repro7
# `Twice(v): int32 = v * 2` 同款, 早已验证正确), 不重复展开、不注入多余的
# IfStmt/ElseStmt 污染 exprLayer 致三元表达式节点构建错乱。
@borrows
fn ParserControlHeaderSearchStart(lineRaw: str,
                                    lineStart: int32,
                                    lineStop: int32): int32 =
    var tokenStop = lineStart
    while tokenStop < lineStop:
        if !ParserIsIdentChar(lineRaw[tokenStop]):
            break
        tokenStop = tokenStop + 1
    if tokenStop <= lineStart:
        return lineStart
    if !ParserTextRangeEquals(lineRaw, lineStart, tokenStop - lineStart, "fn"):
        return lineStart
    let sigEqPos = ParserFindTopLevelAssignmentEq(lineRaw)
    if sigEqPos < 0:
        return -1
    if ParserFindTopLevelTokenRange(lineRaw, lineStart, sigEqPos, ":") >= 0:
        return lineStart
    return sigEqPos + 1

@borrows
fn parserLegacyElseIfPayloadStart(lineRaw: str,
                                  start: int32,
                                  stop: int32): int32 =
    let elseKeyword = "else"
    if start < 0 || stop > lineRaw.len ||
       stop - start <= elseKeyword.len:
        return -1
    if !ParserTextRangeEquals(lineRaw,
                              start,
                              elseKeyword.len,
                              elseKeyword):
        return -1
    var cursor = start + elseKeyword.len
    if cursor >= stop || !ParserIsInlineSpace(lineRaw[cursor]):
        return -1
    cursor = ParserSkipInlineSpaces(lineRaw, cursor)
    if !ParserLineRangeStartsWithStatementKeyword(lineRaw,
                                                   cursor,
                                                   stop,
                                                   "if"):
        return -1
    cursor = cursor + Len("if")
    if cursor >= stop || !ParserIsInlineSpace(lineRaw[cursor]):
        return -1
    return ParserSkipInlineSpaces(lineRaw, cursor)

@borrows
fn parserReadControlStmtSeedRangeMode(
        lineNumber: int32,
        lineRaw: str,
        rangeStartRaw: int32,
        migrationSourceSyntax: bool,
        seed: var ParserStructuredStatementSeed,
        suiteDelimiterPos: var int32,
        inlineSuiteBodyStart: var int32): bool =
    var lineStart: int32
    var lineStop: int32
    if !ParserTrimmedCommentRangeSlashAware(lineRaw, lineStart, lineStop):
        return false
    var headStart = rangeStartRaw
    if headStart < 0:
        headStart = ParserControlHeaderSearchStart(lineRaw, lineStart, lineStop)
    if headStart < 0:
        return false
    while headStart < lineStop && ParserIsInlineSpace(lineRaw[headStart]):
        headStart = headStart + 1
    var kind = NormalizedExprIfStmt
    var payloadStart: int32
    if ParserLineRangeStartsWithStatementKeyword(lineRaw, headStart, lineStop, "if"):
        kind = NormalizedExprIfStmt
        payloadStart = headStart + 3
    elif ParserLineRangeStartsWithStatementKeyword(lineRaw, headStart, lineStop, "elif"):
        kind = NormalizedExprElifStmt
        payloadStart = headStart + 5
    elif migrationSourceSyntax &&
         parserLegacyElseIfPayloadStart(lineRaw, headStart, lineStop) >= 0:
        kind = NormalizedExprElifStmt
        payloadStart = parserLegacyElseIfPayloadStart(lineRaw,
                                                       headStart,
                                                       lineStop)
    elif ParserLineRangeEqualsElseControlKeyword(lineRaw, headStart, lineStop):
        kind = NormalizedExprElseStmt
        payloadStart = headStart + 4
    elif ParserLineRangeStartsWithStatementKeyword(lineRaw, headStart, lineStop, "for"):
        kind = NormalizedExprForStmt
        payloadStart = headStart + 4
    elif ParserLineRangeStartsWithStatementKeyword(lineRaw, headStart, lineStop, "while"):
        kind = NormalizedExprWhileStmt
        payloadStart = headStart + 6
    else:
        return false
    let colonPos = ParserFindTopLevelTokenRange(lineRaw,
                                                 headStart,
                                                 lineStop,
                                                 ":")
    if colonPos < payloadStart:
        return false
    var payload = ""
    if kind != NormalizedExprElseStmt:
        if colonPos <= payloadStart:
            return false
        payload = ParserTrimmedSliceRange(lineRaw, payloadStart, colonPos)
        if payload == "":
            return false
    var bodyStart = ParserSkipInlineSpaces(lineRaw, colonPos + 1)
    if bodyStart >= lineStop:
        bodyStart = -1
    seed.lineIndex = lineNumber - 1
    seed.lineNumber = lineNumber
    seed.columnNumber = headStart + 1
    seed.endLineNumber = lineNumber
    seed.endColumnNumber = lineRaw.len
    seed.kind = kind
    seed.surfaceText = payload
    seed.lexicalScopeId = -1
    seed.suiteScopeId = -1
    seed.statementOrdinal = -1
    seed.lexicalOrdinal = -1
    seed.deferOwnerStatementOrdinal = -1
    suiteDelimiterPos = colonPos
    inlineSuiteBodyStart = bodyStart
    return true

@borrows
fn ParserReadControlStmtSeedRange(lineNumber: int32,
                                    lineRaw: str,
                                    rangeStartRaw: int32,
                                    seed: var ParserStructuredStatementSeed,
                                    suiteDelimiterPos: var int32,
                                    inlineSuiteBodyStart: var int32): bool =
    return parserReadControlStmtSeedRangeMode(lineNumber,
                                               lineRaw,
                                               rangeStartRaw,
                                               false,
                                               seed,
                                               suiteDelimiterPos,
                                               inlineSuiteBodyStart)

fn ParserAppendControlStmtExprsLine(sourcePath: str,
                                     lineNumber: int32,
                                     lineRaw: str,
                                     layer: var NormalizedExprLayer) =
    var seed: ParserStructuredStatementSeed
    var suiteDelimiterPos: int32
    var inlineSuiteBodyStart: int32
    if !ParserReadControlStmtSeedRange(lineNumber,
                                        lineRaw,
                                        -1,
                                        seed,
                                        suiteDelimiterPos,
                                        inlineSuiteBodyStart):
        return
    NormalizedExprLayerAppendSpan(layer,
                                   sourcePath,
                                   lineNumber,
                                   seed.columnNumber,
                                   seed.kind,
                                   NormalizedExprDetailNone,
                                   seed.surfaceText,
                                   seed.endColumnNumber)

@borrows
fn ParserReadMatchStmtSeedRange(lineNumber: int32,
                                  lineRaw: str,
                                  rangeStartRaw: int32,
                                  seed: var ParserStructuredStatementSeed,
                                  suiteDelimiterPos: var int32,
                                  inlineSuiteBodyStart: var int32): bool =
    var lineStart: int32
    var lineStop: int32
    if !ParserTrimmedCommentRangeSlashAware(lineRaw, lineStart, lineStop):
        return false
    var headStart = rangeStartRaw
    if headStart < 0:
        headStart = lineStart
    headStart = ParserSkipInlineSpaces(lineRaw, headStart)
    var kind = NormalizedExprMatchStmt
    var surfaceText = ""
    var delimiterPos: int32 = -1
    if ParserLineRangeStartsWithStatementKeyword(lineRaw, headStart, lineStop, "match"):
        let payloadStart = headStart + 6
        var payloadStop = lineStop
        let colonPos = ParserFindTopLevelTokenRange(lineRaw,
                                                    payloadStart,
                                                    lineStop,
                                                    ":")
        if colonPos > payloadStart:
            payloadStop = colonPos
            delimiterPos = colonPos
        elif lineStop > payloadStart && lineRaw[lineStop - 1] == '{':
            payloadStop = lineStop - 1
            delimiterPos = lineStop - 1
        else:
            return false
        surfaceText = ParserTrimmedSliceRange(lineRaw, payloadStart, payloadStop)
        if surfaceText == "":
            return false
    else:
        let arrow = ParserFindTopLevelTokenRange(lineRaw,
                                                  headStart,
                                                  lineStop,
                                                  "=>")
        if arrow <= headStart:
            return false
        surfaceText = ParserTrimmedSliceRange(lineRaw, headStart, arrow)
        if surfaceText == "":
            return false
        kind = NormalizedExprCaseStmt
        delimiterPos = arrow + 1
    var bodyStart = ParserSkipInlineSpaces(lineRaw, delimiterPos + 1)
    if bodyStart >= lineStop:
        bodyStart = -1
    seed.lineIndex = lineNumber - 1
    seed.lineNumber = lineNumber
    seed.columnNumber = headStart + 1
    seed.endLineNumber = lineNumber
    seed.endColumnNumber = lineRaw.len
    seed.kind = kind
    seed.surfaceText = surfaceText
    seed.lexicalScopeId = -1
    seed.suiteScopeId = -1
    seed.statementOrdinal = -1
    seed.lexicalOrdinal = -1
    seed.deferOwnerStatementOrdinal = -1
    suiteDelimiterPos = delimiterPos
    inlineSuiteBodyStart = bodyStart
    return true

fn ParserAppendMatchStmtExprsLine(sourcePath: str,
                                   lineNumber: int32,
                                   lineRaw: str,
                                   layer: var NormalizedExprLayer) =
    var seed: ParserStructuredStatementSeed
    var suiteDelimiterPos: int32
    var inlineSuiteBodyStart: int32
    if !ParserReadMatchStmtSeedRange(lineNumber,
                                      lineRaw,
                                      -1,
                                      seed,
                                      suiteDelimiterPos,
                                      inlineSuiteBodyStart):
        return
    NormalizedExprLayerAppendSpan(layer,
                                   sourcePath,
                                   lineNumber,
                                   seed.columnNumber,
                                   seed.kind,
                                   NormalizedExprDetailNone,
                                   seed.surfaceText,
                                   seed.endColumnNumber)

# B14 根修: 列基核。columnBase = 该文本在真实源行内的起始列偏移(0 基),
# 事实 (line,col) 恒等于 Fmt token 的真实起点 (freeze 身份契约, B6 事件锚
# 同款先例); ParserValueExprStampStrFormatFacts 按 FmtLiteral 节点的真实
# token (line,col) 匹配盖章, 契约因此全域成立。
@borrows
fn ParserAppendFmtExprsLineColumnBase(sourcePath: str,
                                        lineNumber: int32,
                                        lineRaw: str,
                                        columnBase: int32,
                                        layer: var NormalizedExprLayer) =
    if lineRaw.len < 3:
        return
    for i in 0..<(lineRaw.len - 2):
        var mode = ""
        var literalText = ""
        var argText = ""
        var endColumn = -1
        if !ParserParseFmtExprAt(lineRaw, i, mode, literalText, argText, endColumn):
            continue
        NormalizedExprLayerAppendSpan(layer,
                                        sourcePath,
                                        lineNumber,
                                        columnBase + i + 1,
                                        NormalizedExprStrFormat,
                                        ParserFmtExprDetailKind(mode),
                                        "Fmt",
                                        columnBase + endColumn)
    return

@borrows
fn ParserAppendFmtExprsLine(sourcePath: str,
                              lineNumber: int32,
                              lineRaw: str,
                              layer: var NormalizedExprLayer) =
    ParserAppendFmtExprsLineColumnBase(sourcePath,
                                       lineNumber,
                                       lineRaw,
                                       0,
                                       layer)

# B14 根修: join 组感知的 Fmt 播种。joined 文本播种给出 (头行, joined 列),
# 而 FmtLiteral 节点锚在真实 token 行列 —— join 续行上的 Fmt 事实因此恒无
# node 身份 (cleanup_cfg:5595 receipt 墙)。头行 part = 未 trim 的整行 (列
# 恒等); 各续行 contribution 与 ParserJoinContinuationLineAt 的 part 抽取
# 同一函数 (quote-aware 剥注释 + trim), 列基 = 剥离的前导空白宽。纯注释/
# 空白续行 trim 后为空 —— 与 join 的 part 跳过规则一致, 零播种。追加时点
# 在头行行扫描内, 层内行号组序不变量保持 (B6 组扩展事件同形)。
@borrows
fn ParserAppendFmtExprsJoinGroupLine(sourcePath: str,
                                       preparedLines: str[],
                                       headSlot: int32,
                                       groupEndSlot: int32,
                                       layer: var NormalizedExprLayer) =
    if headSlot < 0 || headSlot >= preparedLines.len:
        return
    ParserAppendFmtExprsLine(sourcePath,
                             headSlot + 1,
                             preparedLines[headSlot],
                             layer)
    var contSlot = headSlot + 1
    while contSlot < groupEndSlot && contSlot < preparedLines.len:
        let contRaw = preparedLines[contSlot]
        if ParserHasNonTrimChar(contRaw):
            let contTrim = ParserTrimmedLineWithoutCommentQuoteAwareSlashAware(
                contRaw)
            if contTrim != "":
                var lead: int32
                while lead < contRaw.len &&
                      ParserIsInlineSpace(contRaw[lead]):
                    lead = lead + 1
                ParserAppendFmtExprsLineColumnBase(sourcePath,
                                                   contSlot + 1,
                                                   contTrim,
                                                   lead,
                                                   layer)
        contSlot = contSlot + 1

@borrows
fn ParserAppendStringifyCallExprsLine(sourcePath: str,
                                        lineNumber: int32,
                                        lineRaw: str,
                                        layer: var NormalizedExprLayer) =
    var i: int32
    var inString = false
    var inChar = false
    while i < lineRaw.len:
        let ch = lineRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
            i = i + 1
            continue
        if !inString && ch == Char(39) && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
            i = i + 1
            continue
        if inString || inChar:
            i = i + 1
            continue
        if ch == Char(35):
            return
        if ch != '$' || i + 1 >= lineRaw.len:
            i = i + 1
            continue
        if lineRaw[i + 1] == '(':
            var callArgsText = ""
            var callArgCount: int32
            var endColumnNumber: int32 = -1
            if !ParserCallSurfaceFromOpenParen(lineRaw,
                                                 i + 1,
                                                 callArgsText,
                                                 callArgCount,
                                                 endColumnNumber):
                i = i + 1
                continue
            NormalizedExprLayerAppendCall(layer,
                                            sourcePath,
                                            lineNumber,
                                            i + 1,
                                            "$",
                                            NormalizedExprSurfaceCallNone,
                                            true,
                                            NormalizedExprCallReasonNone,
                                            "",
                                            "$",
                                            "$",
                                            "",
                                            false,
                                            callArgsText,
                                            callArgCount,
                                            false,
                                            endColumnNumber)
            i = endColumnNumber
            continue
        if !ParserIsIdentChar(lineRaw[i + 1]):
            i = i + 1
            continue
        var stop = i + 1
        while stop < lineRaw.len:
            let operandCh = lineRaw[stop]
            if ParserIsIdentChar(operandCh) || operandCh == '.':
                stop = stop + 1
                continue
            break
        let callArgsText = ParserTextSliceCopy(lineRaw, i + 1, stop - i - 1)
        if callArgsText == "":
            i = i + 1
            continue
        NormalizedExprLayerAppendCall(layer,
                                        sourcePath,
                                        lineNumber,
                                        i + 1,
                                        "$",
                                        NormalizedExprSurfaceCallNone,
                                        true,
                                        NormalizedExprCallReasonNone,
                                        "",
                                        "$",
                                        "$",
                                        "",
                                        false,
                                        callArgsText,
                                        1,
                                        true,
                                        stop)
        i = stop
    return

@borrows
fn ParserAppendRangeExprsLine(sourcePath: str,
                                lineNumber: int32,
                                lineRaw: str,
                                layer: var NormalizedExprLayer) =
    var i: int32
    var inString = false
    var inChar = false
    while i + 1 < lineRaw.len:
        let ch = lineRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
            i = i + 1
            continue
        if !inString && ch == '\'' && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
            i = i + 1
            continue
        if inString || inChar:
            i = i + 1
            continue
        if ch != '.' || lineRaw[i + 1] != '.':
            i = i + 1
            continue
        var detailKind = NormalizedExprDetailRangeInclusive
        var surfaceText = ".."
        var step: int32 = 2
        var hasExclusiveMarker = false
        if i + 2 < lineRaw.len:
            hasExclusiveMarker = lineRaw[i + 2] == '<'
        if hasExclusiveMarker:
            detailKind = NormalizedExprDetailRangeExclusive
            surfaceText = "..<"
            step = 3
        NormalizedExprLayerAppend(layer,
                                    sourcePath,
                                    lineNumber,
                                    i + 1,
                                    NormalizedExprRange,
                                    detailKind,
                                    surfaceText)
        i = i + step
        continue

@borrows
fn ParserCallExprUsesDedicatedNormalization(
        callNameRaw: str): bool =
    let callName = callNameRaw
    if ParserTextEqualsExact(callName, "Fmt"):
        return true
    if ParserTextEqualsExact(callName, "Ok"):
        return true
    if ParserTextEqualsExact(callName, "Err"):
        return true
    if ParserTextEqualsExact(callName, "Value"):
        return true
    if ParserTextEqualsExact(callName, "Error"):
        return true
    if ParserTextEqualsExact(callName, "IsOk"):
        return true
    if ParserTextEqualsExact(callName, "IsErr"):
        return true
    if ParserTextEqualsExact(callName, "ErrorInfoOf"):
        return true
    return false

@borrows
fn ParserCallNameIsBuiltinPrimitiveConversion(callNameRaw: str): bool =
    let callName = callNameRaw
    if callName == "bool" ||
       callName == "char" ||
       callName == "int8" ||
       callName == "int16" ||
       callName == "int32" ||
       callName == "int64" ||
       callName == "uint8" ||
       callName == "uint16" ||
       callName == "uint32" ||
       callName == "uint64" ||
       callName == "float32" ||
       callName == "float64" ||
       callName == "str" ||
       callName == "ptr" ||
       callName == "cstring" ||
       callName == "utf8_view" ||
       callName == "bytes_view" ||
       callName == "owned_cstring":
        return true
    return false

@borrows
fn ParserCallNameIsBuiltinCallee(callNameRaw: str): bool =
    let callName = callNameRaw
    if callName == "add" ||
       callName == "assert" ||
       callName == "echo" ||
       callName == "Echo" ||
       callName == "setLen" ||
       callName == "reserve" ||
       callName == "clear" ||
       callName == "len" ||
       callName == "new" ||
       callName == "memRetain" ||
       callName == "memRelease" ||
       callName == "memAllocCount":
        return true
    return ParserCallNameIsBuiltinPrimitiveConversion(callName)

@borrows
fn ParserBuiltinCallValueSemantic(
        callNameRaw: str): ParserBuiltinValueSemantic =
    let callName = callNameRaw
    if ParserCallNameIsBuiltinPrimitiveConversion(callName) ||
       callName == "new":
        return ParserBuiltinValueOwned
    return ParserBuiltinValueNone

@borrows
fn ParserTypeExprIsScalarDefaultForbidden(typeRaw: str): bool =
    let typeText = chengpath.PathTrim(typeRaw)
    if typeText == "bool":
        return true
    if typeText == "int8":
        return true
    if typeText == "uint8":
        return true
    if typeText == "int16":
        return true
    if typeText == "uint16":
        return true
    if typeText == "int32":
        return true
    if typeText == "int":
        return true
    if typeText == "uint32":
        return true
    if typeText == "int64":
        return true
    if typeText == "uint64":
        return true
    if typeText == "float":
        return true
    if typeText == "float32":
        return true
    if typeText == "float64":
        return true
    if typeText == "char":
        return true
    if typeText == "str":
        return true
    if typeText == "cstring":
        return true
    if typeText == "ptr":
        return true
    if ParserStartsWithExact(typeText, "ptr["):
        return true
    if ParserStartsWithExact(typeText, "Pointer["):
        return true
    return false

@borrows
fn ParserTypeExprIsTuple(typeRaw: str): bool =
    let typeText = chengpath.PathTrim(typeRaw)
    if !ParserStartsWithExact(typeText, "tuple["):
        return false
    if typeText.len <= Len("tuple["):
        return false
    return typeText[typeText.len - 1] == ']'

@borrows
fn ParserTypeExprIsSeq(typeRaw: str): bool =
    let typeText = chengpath.PathTrim(typeRaw)
    if typeText.len < 2:
        return false
    if chengpath.TextSlice(typeText, typeText.len - 2, 2) != "[]":
        return false
    return true

@borrows
fn ParserTypeExprIsFixedArray(typeRaw: str): bool =
    let typeText = chengpath.PathTrim(typeRaw)
    if typeText.len < 4:
        return false
    if ParserTypeExprIsSeq(typeText):
        return false
    if typeText[typeText.len - 1] != ']':
        return false
    var depth: int32
    var openPos: int32 = -1
    var closePos: int32 = -1
    for i in 0..<typeText.len:
        if typeText[i] == '[':
            if depth == 0:
                openPos = i
            depth = depth + 1
            continue
        if typeText[i] == ']':
            depth = depth - 1
            if depth < 0:
                return false
            if depth == 0:
                closePos = i
    if depth != 0 || openPos <= 0 || closePos != typeText.len - 1:
        return false
    let sizeText = chengpath.PathTrim(chengpath.TextSlice(typeText, openPos + 1, closePos - openPos - 1))
    if sizeText == "":
        return false
    for i in 0..<sizeText.len:
        let ch = sizeText[i]
        if ParserIsInlineSpace(ch):
            continue
        if ch < '0' || ch > '9':
            return false
    return true

@borrows
fn ParserTypeExprDot(typeRaw: str): int32 =
    let typeText = chengpath.PathTrim(typeRaw)
    var dotPos: int32 = -1
    for i in 0..<typeText.len:
        if typeText[i] == '.':
            dotPos = i
    return dotPos

@borrows
fn ParserTypeExprQualifier(typeRaw: str): str =
    let typeText = chengpath.PathTrim(typeRaw)
    let dotPos = ParserTypeExprDot(typeText)
    if dotPos <= 0:
        return ""
    return chengpath.PathTrim(chengpath.TextSlice(typeText, 0, dotPos))

@borrows
fn ParserTypeExprLeaf(typeRaw: str): str =
    let typeText = chengpath.PathTrim(typeRaw)
    let dotPos = ParserTypeExprDot(typeText)
    if dotPos < 0:
        return ParserIdentPrefix(typeText)
    if dotPos + 1 >= typeText.len:
        return ""
    return ParserIdentPrefix(chengpath.TextSlice(typeText, dotPos + 1, typeText.len - dotPos - 1))

@borrows
fn ParserTypeDeclNameFromTrimmedLine(lineRaw: str): str =
    let line = chengpath.PathTrim(lineRaw)
    if line == "":
        return ""
    let eqPos = ParserFindTopLevelToken(line, "=")
    if eqPos <= 0:
        return ""
    let headRaw = chengpath.PathTrim(chengpath.TextSlice(line, 0, eqPos))
    let genericPos = ParserFindTopLevelToken(headRaw, "[")
    var head: str
    if genericPos > 0:
        head = chengpath.PathTrim(chengpath.TextSlice(headRaw, 0, genericPos))
    else:
        head = headRaw
    return ParserIdentPrefix(ParserFirstToken(head))

@borrows
fn ParserTypeDeclIsRefObjectFromTrimmedLine(lineRaw: str): bool =
    let line = chengpath.PathTrim(lineRaw)
    let eqPos = ParserFindTopLevelToken(line, "=")
    if eqPos <= 0:
        return false
    let tail = chengpath.PathTrim(chengpath.TextSlice(line, eqPos + 1, line.len - eqPos - 1))
    if tail == "ref object":
        return true
    return ParserStartsWithExact(tail, "ref object ")

fn ParserAddUniqueTypeDecl(out: var NormalizedTypeDecl[],
                             nameRaw: str,
                             refObject: bool) =
    let name = ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    if name == "":
        return
    for i in 0..<out.len:
        if out[i].name != name:
            continue
        if refObject:
            out[i].refObject = true
        return
    var decl: NormalizedTypeDecl
    decl.name = name
    decl.refObject = refObject
    add(out, decl)

@borrows
fn ParserReadNormalizedTypeDeclsLines(lines: str[],
                                        decls: var NormalizedTypeDecl[]) =
    decls = []
    var inTypeBlock = false
    for i in 0..<lines.len:
        let rawLine = lines[i]
        if ParserHasLeadingIndent(rawLine):
            if !inTypeBlock:
                continue
            var first = -1
            for c in 0..<rawLine.len:
                let ch = rawLine[c]
                if ch != ' ' && ch != '\t':
                    first = c
                    break
            if first < 0 || rawLine[first] == '#':
                continue
            let trimmed = chengpath.PathTrim(ParserStripLineComment(rawLine))
            let declName = ParserTypeDeclNameFromTrimmedLine(trimmed)
            if declName == "":
                continue
            ParserAddUniqueTypeDecl(decls, declName, ParserTypeDeclIsRefObjectFromTrimmedLine(trimmed))
            continue
        # 顶层行: 只有 "type" 头需要 trim/剥注释; 其余行零分配复位状态.
        # 语义与旧逐行 PathTrim(StripLineComment) 逐字等价:
        # - 空行/纯 '#' 注释: trimmed=="" 原路径 continue, 不改 inTypeBlock;
        # - 'type' + 非标识符 (含 EOL/空白/#): 进全量 trim 判定;
        # - '//' 不是 ParserStripLineComment 的注释记号, 按普通行复位.
        var first = -1
        for c in 0..<rawLine.len:
            let ch = rawLine[c]
            if ch != ' ' && ch != '\t':
                first = c
                break
        if first < 0 || rawLine[first] == '#':
            continue
        if first + 4 > rawLine.len ||
           !(rawLine[first] == 't' && rawLine[first + 1] == 'y' &&
             rawLine[first + 2] == 'p' && rawLine[first + 3] == 'e') ||
           (first + 4 < rawLine.len && ParserIsIdentChar(rawLine[first + 4])):
            inTypeBlock = false
            continue
        let trimmed = chengpath.PathTrim(ParserStripLineComment(rawLine))
        if trimmed == "":
            continue
        inTypeBlock = trimmed == "type"

@borrows
fn ParserProfileHasDeclaredType(profile: NormalizedExprCallProfile,
                                  nameRaw: str): bool =
    let name = ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    if name == "":
        return false
    for i in 0..<profile.typeDecls.len:
        if profile.typeDecls[i].name == name:
            return true
    return false

@borrows
fn ParserProfileHasRefObjectType(profile: NormalizedExprCallProfile,
                                   nameRaw: str): bool =
    let name = ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    if name == "":
        return false
    for i in 0..<profile.typeDecls.len:
        if profile.typeDecls[i].name == name:
            return profile.typeDecls[i].refObject
    return false

@borrows
fn ParserProfileImportTargetIndexForQualifier(profile: NormalizedExprCallProfile,
                                                qualifierRaw: str): int32 =
    let qualifier = ParserIdentPrefix(chengpath.PathTrim(qualifierRaw))
    if qualifier == "":
        return -1
    var targetIndex = -1
    for i in 0..<profile.importEdges.len:
        let edge = profile.importEdges[i]
        if !edge.resolved || edge.targetProfileIndex < 0 || edge.qualifier != qualifier:
            continue
        if targetIndex < 0:
            targetIndex = edge.targetProfileIndex
            continue
        if targetIndex != edge.targetProfileIndex:
            return -1
    return targetIndex

@borrows
fn ParserResolveQualifiedTypeProfileIndex(currentProfile: NormalizedExprCallProfile,
                                            profiles: NormalizedExprCallProfile[],
                                            qualifierChainRaw: str): int32 =
    let qualifierChain = chengpath.PathTrim(qualifierChainRaw)
    if qualifierChain == "":
        return -1
    let parts = ParserSplitChar(qualifierChain, '.')
    var targetIndex = -1
    var ownerProfileIndex = -1
    for i in 0..<parts.len:
        if ownerProfileIndex < 0:
            targetIndex = ParserProfileImportTargetIndexForQualifier(
                currentProfile, parts[i])
        else:
            targetIndex = ParserProfileImportTargetIndexForQualifier(
                profiles[ownerProfileIndex], parts[i])
        if targetIndex < 0 || targetIndex >= profiles.len:
            return -1
        ownerProfileIndex = targetIndex
    return targetIndex

@borrows
fn ParserResolveUnqualifiedTypeProfileIndex(currentProfile: NormalizedExprCallProfile,
                                              profiles: NormalizedExprCallProfile[],
                                              typeNameRaw: str): int32 =
    let typeName = ParserIdentPrefix(chengpath.PathTrim(typeNameRaw))
    if typeName == "":
        return -1
    if ParserProfileHasDeclaredType(currentProfile, typeName):
        return -2
    var targetIndex = -1
    for i in 0..<currentProfile.importEdges.len:
        let edge = currentProfile.importEdges[i]
        if !edge.resolved || edge.targetProfileIndex < 0 || edge.targetProfileIndex >= profiles.len:
            continue
        if !ParserProfileHasDeclaredType(profiles[edge.targetProfileIndex], typeName):
            continue
        if targetIndex < 0:
            targetIndex = edge.targetProfileIndex
            continue
        if targetIndex != edge.targetProfileIndex:
            return -1
    return targetIndex

@borrows
fn ParserDefaultInitRemovedDefaultError(exprRaw: str): str =
    let expr = chengpath.PathTrim(exprRaw)
    return strutil.Join(["[cheng_seed] default[T] removed expr=",
                         expr,
                         "; use T() for object/tuple, typed implicit init or literals for T[]/T[N], and new(T) for ref object"], "")

@borrows
fn ParserDefaultInitScalarError(typeRaw: str): str =
    let typeText = chengpath.PathTrim(typeRaw)
    return strutil.Join(["[cheng_seed] simple type T() unsupported expr=",
                         typeText,
                         "(); simple types use typed implicit init"], "")

@borrows
fn ParserDefaultInitSeqOrFixedError(typeRaw: str): str =
    let typeText = chengpath.PathTrim(typeRaw)
    return strutil.Join(["[cheng_seed] seq/fixed-array T() unsupported expr=",
                         typeText,
                         "(); use typed implicit init or literals"], "")

@borrows
fn ParserDefaultInitRefObjectError(typeRaw: str): str =
    let typeText = chengpath.PathTrim(typeRaw)
    return strutil.Join(["[cheng_seed] ref object T() unsupported expr=",
                         typeText,
                         "(); use new(T)"], "")

@borrows
fn ParserRedundantExplicitDefaultError(typeRaw: str,
                                         exprRaw: str): str =
    let typeText = chengpath.PathTrim(typeRaw)
    let exprText = chengpath.PathTrim(exprRaw)
    return strutil.Join(["[cheng_seed] redundant explicit default init; omit initializer type=",
                         typeText,
                         " expr=",
                         exprText], "")

@borrows
fn ParserCompactText(textRaw: str): str =
    var out = ""
    for i in 0..<textRaw.len:
        let ch = textRaw[i]
        if ParserIsInlineSpace(ch):
            continue
        out = strutil.Join([out, chengpath.TextSlice(textRaw, i, 1)], "")
    return out

@borrows
fn ParserExprMatchesCompactConstructor(exprRaw: str,
                                         compactType: str): bool =
    if compactType == "":
        return false
    let target = strutil.Join([ParserOwnedText(compactType), "()"], "")
    var targetIndex: int32
    for i in 0..<exprRaw.len:
        let ch = exprRaw[i]
        if ParserIsInlineSpace(ch):
            continue
        if targetIndex >= target.len:
            return false
        if ch != target[targetIndex]:
            return false
        targetIndex = targetIndex + 1
    return targetIndex == target.len

@borrows
fn ParserFindTopLevelAssignmentEq(textRaw: str): int32 =
    return ParserFindTopLevelAssignmentEqFrom(textRaw, 0)

# 与 ParserFindTopLevelAssignmentEq 同一算法, 多一个可选起点 fromIndex——
# 供单行函数体糖 `fn f(...) [: T] = STMT` 场景在跳过签名自身的 "=" 之后,
# 继续找 STMT 里真正的赋值 "=" (若 STMT 恰好是赋值语句) 复用, 不重新发明
# 判定标准。fromIndex<=0 时与 ParserFindTopLevelAssignmentEq(textRaw) 逐字节
# 等价。前提: fromIndex 处的括号/方括号/花括号嵌套深度必须为 0 (调用方目前
# 唯一用法是传入 ParserFindTopLevelAssignmentEq 自己返回的匹配位置+1, 该
# 算法的匹配条件本就要求那个位置深度为 0, 满足前提)。
@borrows
fn ParserFindTopLevelAssignmentEqFrom(textRaw: str, fromIndexRaw: int32): int32 =
    var fromIndex = fromIndexRaw
    if fromIndex < 0:
        fromIndex = 0
    var inString = false
    var inChar = false
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    for i in fromIndex..<textRaw.len:
        let ch = textRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(textRaw, i):
            inString = !inString
            continue
        if !inString && ch == '\'' && !ParserQuoteIsEscaped(textRaw, i):
            inChar = !inChar
            continue
        if inString || inChar:
            continue
        if ch == '(':
            parenDepth = parenDepth + 1
            continue
        if ch == ')':
            parenDepth = parenDepth - 1
            continue
        if ch == '[':
            bracketDepth = bracketDepth + 1
            continue
        if ch == ']':
            bracketDepth = bracketDepth - 1
            continue
        if ch == '{':
            braceDepth = braceDepth + 1
            continue
        if ch == '}':
            braceDepth = braceDepth - 1
            continue
        if parenDepth == 0 &&
           bracketDepth == 0 &&
           braceDepth == 0 &&
           ch == '=':
            var prev: char
            var next: char
            if i > 0:
                prev = textRaw[i - 1]
            if i + 1 < textRaw.len:
                next = textRaw[i + 1]
            if prev == '=' || prev == '!' || prev == '<' || prev == '>' || next == '=' || next == '>':
                continue
            return i
    return -1

@borrows
fn ParserLineIndent(lineRaw: str): int32 =
    var indent: int32
    while indent < lineRaw.len:
        let ch = lineRaw[indent]
        if ch != ' ' && ch != '\t':
            break
        indent = indent + 1
    return indent

@borrows
fn ParserTypeExprIsIntDefaultType(typeRaw: str): bool =
    let typeText = chengpath.PathTrim(typeRaw)
    if typeText == "int8":
        return true
    if typeText == "uint8":
        return true
    if typeText == "int16":
        return true
    if typeText == "uint16":
        return true
    if typeText == "int32":
        return true
    if typeText == "int":
        return true
    if typeText == "uint32":
        return true
    if typeText == "uint":
        return true
    if typeText == "int64":
        return true
    if typeText == "uint64":
        return true
    return false

@borrows
fn ParserTypeExprIsFloatDefaultType(typeRaw: str): bool =
    let typeText = chengpath.PathTrim(typeRaw)
    if typeText == "float":
        return true
    if typeText == "float32":
        return true
    if typeText == "float64":
        return true
    return false

@borrows
fn ParserTypeExprIsStringDefaultType(typeRaw: str): bool =
    let typeText = chengpath.PathTrim(typeRaw)
    if typeText == "str":
        return true
    if typeText == "cstring":
        return true
    return false

@borrows
fn ParserTypeExprLooksLikeLowerGenericFunction(typeRaw: str): bool =
    let typeText = chengpath.PathTrim(typeRaw)
    if typeText == "":
        return false
    if typeText == "Bytes":
        return false
    if ParserTypeExprIsTuple(typeText):
        return false
    if ParserTypeExprIsSeq(typeText):
        return false
    if ParserTypeExprIsFixedArray(typeText):
        return false
    if ParserStartsWithExact(typeText, "Result["):
        return false
    var bracketPos: int32 = -1
    for i in 0..<typeText.len:
        if typeText[i] == '[':
            bracketPos = i
            break
    if bracketPos <= 0:
        return false
    if bracketPos + 1 >= typeText.len:
        return false
    let base = ParserTypeExprLeaf(typeText)
    if base == "":
        return false
    if base[0] < 'a':
        return false
    if base[0] > 'z':
        return false
    return true

@borrows
fn ParserDefaultInitTypeStatus(currentProfile: NormalizedExprCallProfile,
                                 profiles: NormalizedExprCallProfile[],
                                 typeRaw: str,
                                 err: var str): int32 =
    err = ""
    let typeText = chengpath.PathTrim(typeRaw)
    if typeText == "":
        return 0
    if ParserTypeExprIsScalarDefaultForbidden(typeText):
        err = ParserDefaultInitScalarError(typeText)
        return -1
    if ParserTypeExprIsSeq(typeText):
        err = ParserDefaultInitSeqOrFixedError(typeText)
        return -1
    if ParserTypeExprIsFixedArray(typeText):
        err = ParserDefaultInitSeqOrFixedError(typeText)
        return -1
    if typeText == "Bytes":
        return 1
    if ParserTypeExprIsTuple(typeText):
        return 1
    let qualifier = ParserTypeExprQualifier(typeText)
    let leaf = ParserTypeExprLeaf(typeText)
    if leaf == "":
        return 0
    if qualifier != "":
        let targetIndex = ParserResolveQualifiedTypeProfileIndex(currentProfile, profiles, qualifier)
        if targetIndex < 0:
            return 0
        if !ParserProfileHasDeclaredType(profiles[targetIndex], leaf):
            return 0
        if ParserProfileHasRefObjectType(profiles[targetIndex], leaf):
            err = ParserDefaultInitRefObjectError(typeText)
            return -1
        return 1
    let localType = ParserResolveUnqualifiedTypeProfileIndex(currentProfile, profiles, leaf)
    if localType == -2:
        if ParserProfileHasRefObjectType(currentProfile, leaf):
            err = ParserDefaultInitRefObjectError(typeText)
            return -1
        return 1
    if localType < 0:
        return 0
    if ParserProfileHasRefObjectType(profiles[localType], leaf):
        err = ParserDefaultInitRefObjectError(typeText)
        return -1
    return 1

@borrows
fn ParserConstructorTypeStatus(currentProfile: NormalizedExprCallProfile,
                                 profiles: NormalizedExprCallProfile[],
                                 typeRaw: str): int32 =
    let typeText = chengpath.PathTrim(typeRaw)
    if typeText == "":
        return 0
    if ParserTypeExprIsScalarDefaultForbidden(typeText):
        return 0
    if typeText == "Bytes" || ParserTypeExprIsTuple(typeText) ||
       ParserTypeExprIsSeq(typeText) || ParserTypeExprIsFixedArray(typeText):
        return 1
    let qualifier = ParserTypeExprQualifier(typeText)
    let leaf = ParserTypeExprLeaf(typeText)
    if leaf == "":
        return 0
    if qualifier != "":
        let targetIndex = ParserResolveQualifiedTypeProfileIndex(currentProfile, profiles, qualifier)
        if targetIndex < 0:
            return 0
        if !ParserProfileHasDeclaredType(profiles[targetIndex], leaf):
            return 0
        if ParserProfileHasRefObjectType(profiles[targetIndex], leaf):
            return 0
        return 1
    let localType = ParserResolveUnqualifiedTypeProfileIndex(currentProfile, profiles, leaf)
    if localType == -2:
        if ParserProfileHasRefObjectType(currentProfile, leaf):
            return 0
        return 1
    if localType < 0:
        return 0
    if ParserProfileHasRefObjectType(profiles[localType], leaf):
        return 0
    return 1

@borrows
fn ParserExprMatchesImplicitDefault(currentProfile: NormalizedExprCallProfile,
                                      profiles: NormalizedExprCallProfile[],
                                      typeRaw: str,
                                      exprRaw: str): bool =
    ParserTraceStage("implicit_default:enter")
    let typeText = chengpath.PathTrim(typeRaw)
    let exprText = chengpath.PathTrim(exprRaw)
    if typeText == "" || exprText == "":
        return false
    ParserTraceStage("implicit_default:after_empty")
    if typeText == "bool" && exprText == "false":
        return true
    if ParserTypeExprIsIntDefaultType(typeText) && exprText == "0":
        return true
    if ParserTypeExprIsFloatDefaultType(typeText):
        if exprText == "0" || exprText == "0.0":
            return true
    if ParserTypeExprIsStringDefaultType(typeText) && exprText == "\"\"":
        return true
    if typeText == "char" && exprText == "'\\0'":
        return true
    if exprText == "[]":
        if ParserTypeExprIsSeq(typeText):
            return true
        if ParserTypeExprIsFixedArray(typeText):
            return true
    ParserTraceStage("implicit_default:before_compact_type")
    let compactType = ParserCompactText(typeText)
    ParserTraceStage("implicit_default:after_compact_type")
    ParserTraceStage("implicit_default:before_compact_expr")
    let compactExprMatchesConstructor = ParserExprMatchesCompactConstructor(exprText, compactType)
    ParserTraceStage("implicit_default:after_compact_expr")
    if compactExprMatchesConstructor:
        var typeErr = ""
        ParserTraceStage("implicit_default:before_type_status")
        let status = ParserDefaultInitTypeStatus(currentProfile, profiles, typeText, typeErr)
        ParserTraceStage("implicit_default:after_type_status")
        return status > 0
    return false

@borrows
fn ParserParseTypedInitializerLine(lineRaw: str,
                                     prefixRaw: str,
                                     typeOut: var str,
                                     exprOut: var str): bool =
    typeOut = ""
    exprOut = ""
    let line = chengpath.PathTrim(lineRaw)
    let prefixLen = prefixRaw.len
    if prefixRaw != "" && !ParserStartsWithExact(line, prefixRaw):
        return false
    var tail: str
    if prefixLen > 0:
        tail = chengpath.TextSlice(
            line, prefixLen, line.len - prefixLen)
    else:
        tail = line
    let eqPos = ParserFindTopLevelAssignmentEq(tail)
    if eqPos <= 0:
        return false
    let left = chengpath.PathTrim(chengpath.TextSlice(tail, 0, eqPos))
    let colonPos = ParserFindTopLevelToken(left, ":")
    if colonPos <= 0:
        return false
    typeOut = chengpath.PathTrim(chengpath.TextSlice(left, colonPos + 1, left.len - colonPos - 1))
    exprOut = chengpath.PathTrim(chengpath.TextSlice(tail, eqPos + 1, tail.len - eqPos - 1))
    return typeOut != "" && exprOut != ""

fn ParserParseTupleElemDefaultText(elemRaw: str,
                                     typeOut: var str,
                                     exprOut: var str): bool =
    typeOut = ""
    exprOut = ""
    let elem = chengpath.PathTrim(elemRaw)
    if elem == "":
        return false
    let eqPos = ParserFindTopLevelAssignmentEq(elem)
    if eqPos <= 0:
        return false
    let head = chengpath.PathTrim(chengpath.TextSlice(elem, 0, eqPos))
    if head == "":
        return false
    let colonPos = ParserFindTopLevelToken(head, ":")
    if colonPos > 0:
        typeOut = chengpath.PathTrim(chengpath.TextSlice(head, colonPos + 1, head.len - colonPos - 1))
    else:
        typeOut = head
    exprOut = chengpath.PathTrim(chengpath.TextSlice(elem, eqPos + 1, elem.len - eqPos - 1))
    return typeOut != "" && exprOut != ""

@borrows
fn ParserFindTupleTypeRedundantDefaultLine(lineRaw: str,
                                             currentProfile: NormalizedExprCallProfile,
                                             profiles: NormalizedExprCallProfile[],
                                             typeOut: var str,
                                             exprOut: var str): bool =
    typeOut = ""
    exprOut = ""
    let line = chengpath.PathTrim(ParserStripLineComment(lineRaw))
    if line == "":
        return false
    let eqPos = ParserFindTopLevelToken(line, "=")
    if eqPos <= 0:
        return false
    let tupleType = chengpath.PathTrim(chengpath.TextSlice(line, eqPos + 1, line.len - eqPos - 1))
    if !ParserTypeExprIsTuple(tupleType):
        return false
    let body = chengpath.TextSlice(tupleType, Len("tuple["), tupleType.len - Len("tuple[") - 1)
    var inString = false
    var inChar = false
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    var itemStart: int32
    var i: int32
    while i <= body.len:
        let atEnd = i >= body.len
        if !atEnd:
            let ch = body[i]
            if !inChar && ch == '"' && !ParserQuoteIsEscaped(body, i):
                inString = !inString
                i = i + 1
                continue
            if !inString && ch == '\'' && !ParserQuoteIsEscaped(body, i):
                inChar = !inChar
                i = i + 1
                continue
            if inString || inChar:
                i = i + 1
                continue
            if ch == '(':
                parenDepth = parenDepth + 1
                i = i + 1
                continue
            if ch == ')':
                parenDepth = parenDepth - 1
                i = i + 1
                continue
            if ch == '[':
                bracketDepth = bracketDepth + 1
                i = i + 1
                continue
            if ch == ']':
                bracketDepth = bracketDepth - 1
                i = i + 1
                continue
            if ch == '{':
                braceDepth = braceDepth + 1
                i = i + 1
                continue
            if ch == '}':
                braceDepth = braceDepth - 1
                i = i + 1
                continue
        var splitHere = atEnd
        if !splitHere:
            if body[i] == ',':
                if !inString:
                    if !inChar:
                        if parenDepth == 0:
                            if bracketDepth == 0:
                                if braceDepth == 0:
                                    splitHere = true
        if splitHere:
            let item = chengpath.PathTrim(chengpath.TextSlice(body, itemStart, i - itemStart))
            var elemType = ""
            var elemExpr = ""
            if ParserParseTupleElemDefaultText(item, elemType, elemExpr):
                if ParserExprMatchesImplicitDefault(currentProfile, profiles, elemType, elemExpr):
                    typeOut = elemType
                    exprOut = elemExpr
                    return true
            itemStart = i + 1
        i = i + 1
    return false

@borrows
fn ParserFindRedundantExplicitDefaultLine(lineRaw: str,
                                            inTypeBlock: bool,
                                            currentProfile: NormalizedExprCallProfile,
                                            profiles: NormalizedExprCallProfile[],
                                            typeOut: var str,
                                            exprOut: var str): bool =
    ParserTraceStage("redundant_default_enter")
    typeOut = ""
    exprOut = ""
    ParserTraceStage("redundant_default_before_let")
    var parsedLetOrVar = false
    if ParserParseTypedInitializerLine(lineRaw, "let ", typeOut, exprOut):
        parsedLetOrVar = true
    elif ParserParseTypedInitializerLine(lineRaw, "var ", typeOut, exprOut):
        parsedLetOrVar = true
    if parsedLetOrVar:
        ParserTraceStage("redundant_default_after_let_or_var")
        ParserTraceStage("redundant_default_before_let_or_var_match")
        let matched = ParserExprMatchesImplicitDefault(currentProfile, profiles, typeOut, exprOut)
        ParserTraceStage("redundant_default_after_let_or_var_match")
        return matched
    ParserTraceStage("redundant_default_after_let_var")
    if inTypeBlock:
        ParserTraceStage("redundant_default_type_block")
        if ParserParseTypedInitializerLine(lineRaw, "", typeOut, exprOut):
            ParserTraceStage("redundant_default_type_field")
            return ParserExprMatchesImplicitDefault(currentProfile, profiles, typeOut, exprOut)
        ParserTraceStage("redundant_default_before_tuple")
        if ParserFindTupleTypeRedundantDefaultLine(lineRaw, currentProfile, profiles, typeOut, exprOut):
            ParserTraceStage("redundant_default_tuple")
            return true
    ParserTraceStage("redundant_default_done")
    return false

fn ParserIsTypeExprChar(ch: char): bool =
    return ParserIsIdentChar(ch) || ch == '.' || ch == '[' || ch == ']'

@borrows
fn ParserFindRemovedDefaultExprLine(lineRaw: str,
                                      exprTextOut: var str,
                                      columnNumberOut: var int32): bool =
    exprTextOut = ""
    columnNumberOut = -1
    var inString = false
    var inChar = false
    var i: int32
    while i + Len("default[") <= lineRaw.len:
        let ch = lineRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
            i = i + 1
            continue
        if !inString && ch == '\'' && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
            i = i + 1
            continue
        if inString || inChar:
            i = i + 1
            continue
        if i > 0:
            if ParserIsIdentChar(lineRaw[i - 1]):
                i = i + 1
                continue
        if !ParserTextEqualsAt(lineRaw, i, "default["):
            i = i + 1
            continue
        let closePos = ParserFindMatchingBracket(lineRaw, i + Len("default"))
        if closePos < 0:
            return false
        exprTextOut = ParserTextSliceCopy(lineRaw, i, closePos - i + 1)
        columnNumberOut = i + 1
        return true
    return false

@borrows
fn ParserAppendDefaultInitExprsLine(sourcePath: str,
                                      lineNumber: int32,
                                      lineRaw: str,
                                      currentProfile: NormalizedExprCallProfile,
                                      profiles: NormalizedExprCallProfile[],
                                      layer: var NormalizedExprLayer,
                                      err: var str): bool =
    err = ""
    var removedExpr = ""
    var removedColumn = -1
    if ParserFindRemovedDefaultExprLine(lineRaw, removedExpr, removedColumn):
        let _ = removedColumn
        err = ParserDefaultInitRemovedDefaultError(removedExpr)
        return false
    var inString = false
    var inChar = false
    var i: int32
    while i < lineRaw.len:
        let ch = lineRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
            i = i + 1
            continue
        if !inString && ch == '\'' && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
            i = i + 1
            continue
        if inString || inChar || ch != '(':
            i = i + 1
            continue
        let closePos = ParserFindMatchingParen(lineRaw, i)
        if closePos < 0:
            i = i + 1
            continue
        let argText = chengpath.PathTrim(ParserTextSliceFast(lineRaw, i + 1, closePos - i - 1))
        if argText != "":
            i = closePos + 1
            continue
        var calleeStop = i - 1
        while calleeStop >= 0:
            if !ParserIsInlineSpace(lineRaw[calleeStop]):
                break
            calleeStop = calleeStop - 1
        if calleeStop < 0:
            i = closePos + 1
            continue
        var calleeStart = 0
        for calleeOffset in 0..calleeStop:
            let calleeScan = calleeStop - calleeOffset
            if !ParserIsTypeExprChar(lineRaw[calleeScan]):
                calleeStart = calleeScan + 1
                break
        if calleeStart > calleeStop || ParserPreviousTokenIsDeclKeyword(lineRaw, calleeStart):
            i = closePos + 1
            continue
        let typeText = chengpath.PathTrim(ParserTextSliceFast(lineRaw, calleeStart, calleeStop - calleeStart + 1))
        var typeErr = ""
        let status = ParserDefaultInitTypeStatus(currentProfile, profiles, typeText, typeErr)
        if status < 0:
            err = typeErr
            return false
        if status > 0:
            NormalizedExprLayerAppendSpan(layer,
                                            sourcePath,
                                            lineNumber,
                                            calleeStart + 1,
                                            NormalizedExprDefaultInit,
                                            NormalizedExprDetailNone,
                                            typeText,
                                            closePos + 1)
        i = closePos + 1
    return true

@borrows
fn ParserAppendConstructorExprsLine(sourcePath: str,
                                      lineNumber: int32,
                                      lineRaw: str,
                                      currentProfile: NormalizedExprCallProfile,
                                      profiles: NormalizedExprCallProfile[],
                                      layer: var NormalizedExprLayer) =
    var inString = false
    var inChar = false
    var i: int32
    while i < lineRaw.len:
        let ch = lineRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
            i = i + 1
            continue
        if !inString && ch == '\'' && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
            i = i + 1
            continue
        if inString || inChar || ch != '(':
            i = i + 1
            continue
        let closePos = ParserFindMatchingParen(lineRaw, i)
        if closePos < 0:
            i = i + 1
            continue
        let argsText = chengpath.PathTrim(ParserTextSliceFast(lineRaw, i + 1, closePos - i - 1))
        if argsText == "":
            i = closePos + 1
            continue
        var calleeStop = i - 1
        while calleeStop >= 0:
            if !ParserIsInlineSpace(lineRaw[calleeStop]):
                break
            calleeStop = calleeStop - 1
        if calleeStop < 0:
            i = closePos + 1
            continue
        var calleeStart = 0
        for calleeOffset2 in 0..calleeStop:
            let calleeScan2 = calleeStop - calleeOffset2
            if !ParserIsTypeExprChar(lineRaw[calleeScan2]):
                calleeStart = calleeScan2 + 1
                break
        if calleeStart > calleeStop || ParserPreviousTokenIsDeclKeyword(lineRaw, calleeStart):
            i = closePos + 1
            continue
        let typeText = chengpath.PathTrim(ParserTextSliceFast(lineRaw, calleeStart, calleeStop - calleeStart + 1))
        if ParserConstructorTypeStatus(currentProfile, profiles, typeText) > 0:
            NormalizedExprLayerAppendConstructor(layer,
                                                   sourcePath,
                                                   lineNumber,
                                                   calleeStart + 1,
                                                   typeText,
                                                   argsText,
                                                   ParserCountTopLevelArgs(argsText),
                                                   false,
                                                   closePos + 1)
        i = closePos + 1

@borrows
fn ParserCallExprFirstDotExact(text: str): int32 =
    for i in 0..<text.len:
        if text[i] == '.':
            return i
    return -1

@borrows
fn ParserCallExprLastDotExact(text: str): int32 =
    var dotPos: int32 = -1
    for i in 0..<text.len:
        if text[i] == '.':
            dotPos = i
    return dotPos

@borrows
fn ParserCallExprLastDot(textRaw: str): int32 =
    return ParserCallExprLastDotExact(chengpath.PathTrim(textRaw))

@borrows
fn ParserFindMatchingParen(textRaw: str,
                             openPos: int32): int32 =
    let openCh: char = '('
    let closeCh: char = ')'
    return ParserFindMatchingPair(textRaw, openPos, openCh, closeCh)

@borrows
fn ParserFindMatchingBracket(textRaw: str,
                               openPos: int32): int32 =
    let openCh: char = '['
    let closeCh: char = ']'
    return ParserFindMatchingPair(textRaw, openPos, openCh, closeCh)

# Return the opening parenthesis for `name(...)` and `name[Types](...)` after
# the caller has scanned the bare name.  Call normalization keeps the bare
# callee as its identity while preserving explicit generic arguments in the
# source surface and type layer.
@borrows
fn ParserCallOpenParenAfterName(textRaw: str,
                                 nameEnd: int32): int32 =
    var nextPos = ParserSkipInlineSpaces(textRaw, nameEnd)
    if nextPos < textRaw.len && textRaw[nextPos] == '[':
        let genericClose = ParserFindMatchingBracket(textRaw, nextPos)
        if genericClose <= nextPos ||
           chengpath.PathTrim(ParserTextSliceFast(
               textRaw,
               nextPos + 1,
               genericClose - nextPos - 1)) == "":
            return -1
        nextPos = ParserSkipInlineSpaces(textRaw, genericClose + 1)
    if nextPos >= textRaw.len || textRaw[nextPos] != '(':
        return -1
    return nextPos

@borrows
fn ParserFindMatchingBrace(textRaw: str,
                             openPos: int32): int32 =
    let openCh: char = '{'
    let closeCh: char = '}'
    return ParserFindMatchingPair(textRaw, openPos, openCh, closeCh)

@borrows
fn ParserFindMatchingPair(textRaw: str,
                            openPos: int32,
                            openCh: char,
                            closeCh: char): int32 =
    if openPos < 0 || openPos >= textRaw.len:
        return -1
    if textRaw[openPos] != openCh:
        return -1
    var depth: int32
    var inString = false
    var inChar = false
    for i in openPos..<textRaw.len:
        let ch = textRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(textRaw, i):
            inString = !inString
            continue
        if !inString && ch == '\'' && !ParserQuoteIsEscaped(textRaw, i):
            inChar = !inChar
            continue
        if inString || inChar:
            continue
        if ch == openCh:
            depth = depth + 1
        elif ch == closeCh:
            depth = depth - 1
            if depth == 0:
                return i
    return -1

@borrows
fn ParserFindTopLevelToken(textRaw: str,
                             target: str): int32 =
    if target == "" || target.len > textRaw.len:
        return -1
    var inString = false
    var inChar = false
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    for i in 0..<textRaw.len:
        let ch = textRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(textRaw, i):
            inString = !inString
            continue
        if !inString && ch == '\'' && !ParserQuoteIsEscaped(textRaw, i):
            inChar = !inChar
            continue
        if inString || inChar:
            continue
        if ch == '(':
            parenDepth = parenDepth + 1
            continue
        if ch == ')':
            parenDepth = parenDepth - 1
            continue
        if ch == '[':
            bracketDepth = bracketDepth + 1
            continue
        if ch == ']':
            bracketDepth = bracketDepth - 1
            continue
        if ch == '{':
            braceDepth = braceDepth + 1
            continue
        if ch == '}':
            braceDepth = braceDepth - 1
            continue
        if parenDepth == 0 &&
           bracketDepth == 0 &&
           braceDepth == 0 &&
           ParserTextEqualsAt(textRaw, i, target):
            return i
    return -1

@borrows
fn ParserFindTopLevelKeyword(textRaw: str,
                               keyword: str): int32 =
    if keyword == "" || keyword.len > textRaw.len:
        return -1
    var inString = false
    var inChar = false
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    for i in 0..<textRaw.len:
        let ch = textRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(textRaw, i):
            inString = !inString
            continue
        if !inString && ch == '\'' && !ParserQuoteIsEscaped(textRaw, i):
            inChar = !inChar
            continue
        if inString || inChar:
            continue
        if ch == '(':
            parenDepth = parenDepth + 1
            continue
        if ch == ')':
            parenDepth = parenDepth - 1
            continue
        if ch == '[':
            bracketDepth = bracketDepth + 1
            continue
        if ch == ']':
            bracketDepth = bracketDepth - 1
            continue
        if ch == '{':
            braceDepth = braceDepth + 1
            continue
        if ch == '}':
            braceDepth = braceDepth - 1
            continue
        if parenDepth != 0 || bracketDepth != 0 || braceDepth != 0:
            continue
        if !ParserTextEqualsAt(textRaw, i, keyword):
            continue
        var leftOk = true
        if i > 0:
            leftOk = !ParserIsIdentChar(textRaw[i - 1])
        let rightPos = i + keyword.len
        var rightOk = true
        if rightPos < textRaw.len:
            rightOk = !ParserIsIdentChar(textRaw[rightPos])
        if leftOk && rightOk:
            return i
    return -1

fn ParserSplitTopLevelCsv(textRaw: str): str[] =
    var out: str[]
    var start: int32
    var bracketDepth: int32
    var parenDepth: int32
    var braceDepth: int32
    for i in 0..<textRaw.len:
        let piece = textRaw[i]
        if piece == '[':
            bracketDepth = bracketDepth + 1
        elif piece == ']':
            bracketDepth = bracketDepth - 1
        elif piece == '(':
            parenDepth = parenDepth + 1
        elif piece == ')':
            parenDepth = parenDepth - 1
        elif piece == '{':
            braceDepth = braceDepth + 1
        elif piece == '}':
            braceDepth = braceDepth - 1
        elif piece == ',' && bracketDepth == 0 && parenDepth == 0 && braceDepth == 0:
            add(out, chengpath.PathTrim(chengpath.TextSlice(textRaw, start, i - start)))
            start = i + 1
    add(out, chengpath.PathTrim(chengpath.TextSlice(textRaw, start, textRaw.len - start)))
    return out

@borrows
fn ParserQuoteIsEscaped(textRaw: str,
                          indexRaw: int32): bool =
    var index = indexRaw - 1
    var slashCount: int32
    let indexStart = index
    if indexStart >= 0:
        for indexOffset in 0..(indexStart - 0):
            index = indexStart - indexOffset
            if textRaw[index] != '\\':
                break
            slashCount = slashCount + 1
    return slashCount % 2 == 1

@borrows
fn ParserCountTopLevelArgs(textRaw: str): int32 =
    let trimmedWhole = chengpath.PathTrim(textRaw)
    if trimmedWhole == "":
        return 0
    var inString = false
    var inChar = false
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    var itemCount: int32
    var itemStart: int32
    var i: int32
    while i <= textRaw.len:
        let atEnd = i >= textRaw.len
        var splitHere = atEnd
        if !atEnd:
            let ch = textRaw[i]
            if !inChar && ch == '"' && !ParserQuoteIsEscaped(textRaw, i):
                inString = !inString
            elif !inString && ch == '\'' && !ParserQuoteIsEscaped(textRaw, i):
                inChar = !inChar
            elif !inString && !inChar && ch == '(':
                parenDepth = parenDepth + 1
            elif !inString && !inChar && ch == ')':
                parenDepth = parenDepth - 1
            elif !inString && !inChar && ch == '[':
                bracketDepth = bracketDepth + 1
            elif !inString && !inChar && ch == ']':
                bracketDepth = bracketDepth - 1
            elif !inString && !inChar && ch == '{':
                braceDepth = braceDepth + 1
            elif !inString && !inChar && ch == '}':
                braceDepth = braceDepth - 1
            elif !inString && !inChar &&
                 parenDepth == 0 &&
                 bracketDepth == 0 &&
                 braceDepth == 0 &&
                 ch == ',':
                splitHere = true
        if splitHere:
            let piece = chengpath.PathTrim(ParserTextSliceFast(textRaw, itemStart, i - itemStart))
            itemCount = itemCount + 1
            itemStart = i + 1
            if atEnd:
                break
        i = i + 1
    return itemCount

const
    ParserValueExprOwnerUninitialized: int32 = 0
    ParserValueExprOwnerActive: int32 = 1
    ParserValueExprOwnerReleased: int32 = 2
    ParserValueExprOwnerDiagnosticFailure: int32 = 3
    ParserValueExprArenaInitialBytes: int32 = 8192

fn ParserValueExprTreeEnsureActive(tree: var ParserValueExprTree) =
    if tree != nil && tree.lifecycleState == ParserValueExprOwnerActive:
        if tree.arena.capacityBytes <= 0 || tree.internPool == nil:
            panic("parser value expr: active owner has no storage")
        if !tree.ownerAttached:
            panic("parser value expr: detached owner cannot mutate borrowed tree")
        if tree.borrowLeaseCount != 0:
            panic("parser value expr: immutable borrowed tree cannot be mutated")
        tree.structuralValidationPassed = false
        return
    if tree != nil &&
       (tree.arena.capacityBytes != 0 || tree.internPool != nil):
        panic("parser value expr: inactive owner retains storage")
    tree = new(ParserValueExprTree)
    tree.structuralValidationPassed = false
    tree.arena = arenamod.ArenaInitDefault(ParserValueExprArenaInitialBytes)
    tree.internPool = langintern.InternPoolNew()
    tree.importOrigins = new(ParserImportOriginSoA)
    tree.lifecycleState = ParserValueExprOwnerActive
    tree.ownerAttached = true
    tree.activeModuleDeclarationRow = -1
    tree.activeTypeDeclarationRow = -1
    tree.activeFunctionDeclarationRow = -1
    tree.activeConceptTraitDeclarationRow = -1
    tree.activeFunctionRow = -1
    tree.activeDeclarationLexicalScopeRow = -1
    tree.activePendingBindingDeclarationStart = -1
    tree.activePendingBindingLexicalScopeRow = -1
    tree.activeForwardingProductionRow = -1
    tree.failureStartByte = -1
    tree.failureEndByte = -1

fn ParserForwardingProductionKindText(
        kind: ParserForwardingProductionKind): str =
    if kind == ParserForwardingProductionTopLevelDecl:
        return "ParserForwardingProductionTopLevelDecl"
    if kind == ParserForwardingProductionTopLevelCore:
        return "ParserForwardingProductionTopLevelCore"
    if kind == ParserForwardingProductionTemplateBody:
        return "ParserForwardingProductionTemplateBody"
    if kind == ParserForwardingProductionStatement:
        return "ParserForwardingProductionStatement"
    if kind == ParserForwardingProductionStatementCore:
        return "ParserForwardingProductionStatementCore"
    if kind == ParserForwardingProductionMatchArm:
        return "ParserForwardingProductionMatchArm"
    if kind == ParserForwardingProductionBlockStmt:
        return "ParserForwardingProductionBlockStmt"
    return "ParserForwardingProductionInvalid"

fn ParserForwardingProductionChildKindText(
        kind: ParserForwardingProductionChildKind): str =
    if kind == ParserForwardingProductionChildForwardingProduction:
        return "ParserForwardingProductionChildForwardingProduction"
    if kind == ParserForwardingProductionChildValueNode:
        return "ParserForwardingProductionChildValueNode"
    if kind == ParserForwardingProductionChildStatementRoot:
        return "ParserForwardingProductionChildStatementRoot"
    if kind == ParserForwardingProductionChildRegion:
        return "ParserForwardingProductionChildRegion"
    if kind == ParserForwardingProductionChildToken:
        return "ParserForwardingProductionChildToken"
    if kind == ParserForwardingProductionChildDeclaration:
        return "ParserForwardingProductionChildDeclaration"
    if kind == ParserForwardingProductionChildPattern:
        return "ParserForwardingProductionChildPattern"
    if kind == ParserForwardingProductionChildAnnotation:
        return "ParserForwardingProductionChildAnnotation"
    if kind == ParserForwardingProductionChildLexicalScope:
        return "ParserForwardingProductionChildLexicalScope"
    if kind == ParserForwardingProductionChildTypeSyntax:
        return "ParserForwardingProductionChildTypeSyntax"
    return "ParserForwardingProductionChildInvalid"

fn parserForwardingProductionArmValid(
        kind: ParserForwardingProductionKind,
        armIndex: int32): bool =
    if kind == ParserForwardingProductionTopLevelDecl ||
       kind == ParserForwardingProductionStatement ||
       kind == ParserForwardingProductionMatchArm:
        return armIndex == -1
    if kind == ParserForwardingProductionTopLevelCore:
        return armIndex >= 0 && armIndex <= 8
    if kind == ParserForwardingProductionTemplateBody ||
       kind == ParserForwardingProductionBlockStmt:
        return armIndex >= 0 && armIndex <= 1
    if kind == ParserForwardingProductionStatementCore:
        return armIndex >= 0 && armIndex <= 21
    return false

fn parserForwardingProductionBegin(
        tree: var ParserValueExprTree,
        kind: ParserForwardingProductionKind,
        armIndex: int32,
        anchorTokenIndex: int32,
        spanStartTokenIndex: int32,
        spanEndTokenIndex: int32): int32 =
    ParserValueExprTreeEnsureActive(tree)
    if tree.forwardingProductionsSealed ||
       !parserForwardingProductionArmValid(kind, armIndex) ||
       anchorTokenIndex < 0 || anchorTokenIndex >= tree.tokenCount ||
       spanStartTokenIndex < 0 ||
       spanStartTokenIndex >= tree.tokenCount ||
       spanEndTokenIndex < 0 ||
       spanEndTokenIndex >= tree.tokenCount:
        panic("parser forwarding production: invalid begin")
    let producerSourceIndex =
        ParserValueExprTokenProducerSourceIndexAt(tree, anchorTokenIndex)
    if kind == ParserForwardingProductionStatement &&
       tree.activeForwardingProductionRow < 0:
        # 诊断：无主 Statement production 的产生点（span 即源码定位）。
        let diagSpanStart = ParserValueExprTokenStartAt(
            tree, spanStartTokenIndex)
        let diagLine = ParserValueExprTokenLineAt(
            tree, spanStartTokenIndex)
        var diagText = ""
        var diagScan = spanStartTokenIndex
        while diagScan < tree.tokenCount &&
              diagScan < spanStartTokenIndex + 10 &&
              ParserValueExprTokenLineAt(tree, diagScan) == diagLine:
            diagText = Fmt"{diagText} {ParserValueExprTokenText(tree, diagScan)}"
            diagScan = diagScan + 1
        panic(Fmt"stmt_begin_diag kind={Int32(kind)} arm={armIndex} owner={tree.activeForwardingProductionRow} span_start_byte={diagSpanStart} source_line={diagLine} anchor={anchorTokenIndex} stmt=[{diagText}]")
    let sourceTextId =
        ParserValueExprTokenSourceIdAt(tree, anchorTokenIndex)
    if producerSourceIndex != 0 || tree.producerSourceCount != 1 ||
       ParserValueExprTokenProducerSourceIndexAt(
           tree, spanStartTokenIndex) != producerSourceIndex ||
       ParserValueExprTokenProducerSourceIndexAt(
           tree, spanEndTokenIndex) != producerSourceIndex ||
       ParserValueExprTokenSourceIdAt(
           tree, spanStartTokenIndex) != sourceTextId ||
       ParserValueExprTokenSourceIdAt(
           tree, spanEndTokenIndex) != sourceTextId:
        panic("parser forwarding production: mutable producer is not source-local")
    let spanStart =
        ParserValueExprTokenStartAt(tree, spanStartTokenIndex)
    let spanEnd =
        ParserValueExprTokenEndAt(tree, spanEndTokenIndex)
    if spanStart < 0 || spanEnd <= spanStart ||
       ParserValueExprTokenStartAt(tree, anchorTokenIndex) < spanStart ||
       ParserValueExprTokenEndAt(tree, anchorTokenIndex) > spanEnd ||
       spanEnd > ParserValueExprSourceLen(tree, sourceTextId):
        panic("parser forwarding production: token span invalid")
    let row = tree.forwardingProductionCount
    let ownerRow = tree.activeForwardingProductionRow
    if ownerRow < -1 || ownerRow >= row:
        panic("parser forwarding production: owner row invalid")
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.forwardingProductionProducerSourceIndexes,
        producerSourceIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.forwardingProductionSourceLocalRows, row)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.forwardingProductionKinds, Int32(kind))
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.forwardingProductionArmIndexes, armIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.forwardingProductionOwnerRows, ownerRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.forwardingProductionAnchorTokenIndexes,
        anchorTokenIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.forwardingProductionSpanStartTokenIndexes,
        spanStartTokenIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.forwardingProductionSpanEndTokenIndexes,
        spanEndTokenIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.forwardingProductionSpanStarts, spanStart)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.forwardingProductionSpanEnds, spanEnd)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.forwardingProductionAuthorityKinds,
        Int32(ParserForwardingProductionChildInvalid))
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.forwardingProductionAuthorityRows, -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.forwardingProductionAnnotationStarts, -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.forwardingProductionAnnotationCounts, 0)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.forwardingProductionChildStarts, -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.forwardingProductionChildCounts, 0)
    tree.forwardingProductionCount = row + 1
    tree.activeForwardingProductionRow = row
    return row

fn parserForwardingProductionFinish(
        tree: var ParserValueExprTree,
        row: int32,
        authorityKind: ParserForwardingProductionChildKind,
        authorityRow: int32,
        annotationStart: int32,
        annotationCount: int32) =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.forwardingProductionsSealed ||
       row < 0 || row >= tree.forwardingProductionCount ||
       tree.activeForwardingProductionRow != row ||
       annotationCount < 0 ||
       (annotationCount == 0 && annotationStart != -1) ||
       (annotationCount > 0 &&
        (annotationStart < 0 ||
         annotationStart + annotationCount > tree.annotationCount)):
        panic("parser forwarding production: invalid finish")
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.forwardingProductionAuthorityKinds,
        row,
        Int32(authorityKind))
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.forwardingProductionAuthorityRows,
        row,
        authorityRow)
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.forwardingProductionAnnotationStarts,
        row,
        annotationStart)
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.forwardingProductionAnnotationCounts,
        row,
        annotationCount)
    tree.activeForwardingProductionRow = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.forwardingProductionOwnerRows, row)

@borrows
fn parserForwardingProductionAuthorityRowValid(
        tree: ParserValueExprTree,
        kind: ParserForwardingProductionChildKind,
        row: int32): bool =
    if kind == ParserForwardingProductionChildInvalid:
        return row == -1
    if kind == ParserForwardingProductionChildForwardingProduction:
        return row >= 0 && row < tree.forwardingProductionCount
    if kind == ParserForwardingProductionChildValueNode:
        return row >= 0 && row < tree.nodeCount
    if kind == ParserForwardingProductionChildStatementRoot:
        return row >= 0 && row < tree.statementRootCount
    if kind == ParserForwardingProductionChildRegion:
        return row >= 0 && row < tree.regionCount
    if kind == ParserForwardingProductionChildToken:
        return row >= 0 && row < tree.tokenCount
    if kind == ParserForwardingProductionChildDeclaration:
        return row >= 0 && row < tree.declarationCount
    if kind == ParserForwardingProductionChildPattern:
        return row >= 0 && row < tree.patternCount
    if kind == ParserForwardingProductionChildAnnotation:
        return row >= 0 && row < tree.annotationCount
    if kind == ParserForwardingProductionChildLexicalScope:
        return row >= 0 && row < tree.declarationLexicalScopeCount
    if kind == ParserForwardingProductionChildTypeSyntax:
        return row >= 0 && row < tree.typeSyntaxCount
    return false

fn parserForwardingProductionChildRowRebase(
        kind: ParserForwardingProductionChildKind,
        row: int32,
        forwardingOffset: int32,
        nodeOffset: int32,
        statementRootOffset: int32,
        regionOffset: int32,
        tokenOffset: int32,
        declarationOffset: int32,
        patternOffset: int32,
        annotationOffset: int32,
        lexicalScopeOffset: int32,
        typeSyntaxOffset: int32): int32 =
    if kind == ParserForwardingProductionChildInvalid:
        return -1
    if kind == ParserForwardingProductionChildForwardingProduction:
        return forwardingOffset + row
    if kind == ParserForwardingProductionChildValueNode:
        return nodeOffset + row
    if kind == ParserForwardingProductionChildStatementRoot:
        return statementRootOffset + row
    if kind == ParserForwardingProductionChildRegion:
        return regionOffset + row
    if kind == ParserForwardingProductionChildToken:
        return tokenOffset + row
    if kind == ParserForwardingProductionChildDeclaration:
        return declarationOffset + row
    if kind == ParserForwardingProductionChildPattern:
        return patternOffset + row
    if kind == ParserForwardingProductionChildAnnotation:
        return annotationOffset + row
    if kind == ParserForwardingProductionChildLexicalScope:
        return lexicalScopeOffset + row
    if kind == ParserForwardingProductionChildTypeSyntax:
        return typeSyntaxOffset + row
    panic("parser forwarding production: child kind cannot be rebased")

@borrows
fn ParserValueExprForwardingProductionChildProducerSourceIndexAt(
        tree: ParserValueExprTree,
        kind: ParserForwardingProductionChildKind,
        row: int32): int32 =
    if !parserForwardingProductionAuthorityRowValid(tree, kind, row) ||
       kind == ParserForwardingProductionChildInvalid:
        return -1
    if kind == ParserForwardingProductionChildForwardingProduction:
        return arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionProducerSourceIndexes,
            row)
    if kind == ParserForwardingProductionChildValueNode:
        return ParserValueExprNodeProducerSourceIndexAt(tree, row)
    if kind == ParserForwardingProductionChildStatementRoot:
        return ParserValueExprNodeProducerSourceIndexAt(
            tree, ParserValueExprStatementRootNodeAt(tree, row))
    if kind == ParserForwardingProductionChildRegion:
        return ParserValueExprTokenProducerSourceIndexAt(
            tree,
            arenamod.ArenaArrayInt32Get(
                tree.arena, tree.regionAnchorTokenIndexes, row))
    if kind == ParserForwardingProductionChildToken:
        return ParserValueExprTokenProducerSourceIndexAt(tree, row)
    if kind == ParserForwardingProductionChildDeclaration:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationProducerSourceIndexes, row)
    if kind == ParserForwardingProductionChildPattern:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternProducerSourceIndexes, row)
    if kind == ParserForwardingProductionChildAnnotation:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationProducerSourceIndexes, row)
    if kind == ParserForwardingProductionChildLexicalScope:
        return arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeProducerSourceIndexes,
            row)
    if kind == ParserForwardingProductionChildTypeSyntax:
        return ParserValueExprTypeSyntaxProducerSourceIndexAt(tree, row)
    return -1

@borrows
fn ParserValueExprForwardingProductionChildSourceTextIdAt(
        tree: ParserValueExprTree,
        kind: ParserForwardingProductionChildKind,
        row: int32): int32 =
    if !parserForwardingProductionAuthorityRowValid(tree, kind, row) ||
       kind == ParserForwardingProductionChildInvalid:
        return -1
    if kind == ParserForwardingProductionChildForwardingProduction:
        return ParserValueExprTokenSourceIdAt(
            tree,
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.forwardingProductionAnchorTokenIndexes,
                row))
    if kind == ParserForwardingProductionChildValueNode:
        return ParserValueExprNodeSourceIdAt(tree, row)
    if kind == ParserForwardingProductionChildStatementRoot:
        return ParserValueExprNodeSourceIdAt(
            tree, ParserValueExprStatementRootNodeAt(tree, row))
    if kind == ParserForwardingProductionChildRegion:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.regionSourceTextIds, row)
    if kind == ParserForwardingProductionChildToken:
        return ParserValueExprTokenSourceIdAt(tree, row)
    if kind == ParserForwardingProductionChildDeclaration:
        return ParserValueExprTokenSourceIdAt(
            tree,
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationNameTokenIndexes,
                row))
    if kind == ParserForwardingProductionChildPattern:
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternNameTokenIndexes, row)
        if nameToken >= 0:
            return ParserValueExprTokenSourceIdAt(tree, nameToken)
    elif kind == ParserForwardingProductionChildAnnotation:
        return ParserValueExprTokenSourceIdAt(
            tree,
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.annotationNameTokenIndexes,
                row))
    elif kind == ParserForwardingProductionChildTypeSyntax:
        return ParserValueExprTypeSyntaxSourceIdAt(tree, row)
    let producerSourceIndex =
        ParserValueExprForwardingProductionChildProducerSourceIndexAt(
            tree, kind, row)
    let spanStart =
        ParserValueExprForwardingProductionChildSpanStartAt(
            tree, kind, row)
    let spanEnd =
        ParserValueExprForwardingProductionChildSpanEndAt(
            tree, kind, row)
    for tokenRow in 0..<tree.tokenCount:
        if ParserValueExprTokenProducerSourceIndexAt(
               tree, tokenRow) == producerSourceIndex &&
           ParserValueExprTokenStartAt(tree, tokenRow) >= spanStart &&
           ParserValueExprTokenEndAt(tree, tokenRow) <= spanEnd:
            return ParserValueExprTokenSourceIdAt(tree, tokenRow)
    return -1

@borrows
fn ParserValueExprForwardingProductionChildSpanStartAt(
        tree: ParserValueExprTree,
        kind: ParserForwardingProductionChildKind,
        row: int32): int32 =
    if !parserForwardingProductionAuthorityRowValid(tree, kind, row) ||
       kind == ParserForwardingProductionChildInvalid:
        return -1
    if kind == ParserForwardingProductionChildForwardingProduction:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.forwardingProductionSpanStarts, row)
    if kind == ParserForwardingProductionChildValueNode:
        return ParserValueExprNodeSpanStartAt(tree, row)
    if kind == ParserForwardingProductionChildStatementRoot:
        return ParserValueExprNodeSpanStartAt(
            tree, ParserValueExprStatementRootNodeAt(tree, row))
    if kind == ParserForwardingProductionChildRegion:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.regionSpanStarts, row)
    if kind == ParserForwardingProductionChildToken:
        return ParserValueExprTokenStartAt(tree, row)
    if kind == ParserForwardingProductionChildDeclaration:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationSpanStarts, row)
    if kind == ParserForwardingProductionChildPattern:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternSpanStarts, row)
    if kind == ParserForwardingProductionChildAnnotation:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationSpanStarts, row)
    if kind == ParserForwardingProductionChildLexicalScope:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationLexicalScopeSpanStarts, row)
    if kind == ParserForwardingProductionChildTypeSyntax:
        return ParserValueExprTypeSyntaxSpanStartAt(tree, row)
    return -1

@borrows
fn ParserValueExprForwardingProductionChildSpanEndAt(
        tree: ParserValueExprTree,
        kind: ParserForwardingProductionChildKind,
        row: int32): int32 =
    if !parserForwardingProductionAuthorityRowValid(tree, kind, row) ||
       kind == ParserForwardingProductionChildInvalid:
        return -1
    if kind == ParserForwardingProductionChildForwardingProduction:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.forwardingProductionSpanEnds, row)
    if kind == ParserForwardingProductionChildValueNode:
        return ParserValueExprNodeSpanEndAt(tree, row)
    if kind == ParserForwardingProductionChildStatementRoot:
        return ParserValueExprNodeSpanEndAt(
            tree, ParserValueExprStatementRootNodeAt(tree, row))
    if kind == ParserForwardingProductionChildRegion:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.regionSpanEnds, row)
    if kind == ParserForwardingProductionChildToken:
        return ParserValueExprTokenEndAt(tree, row)
    if kind == ParserForwardingProductionChildDeclaration:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationSpanEnds, row)
    if kind == ParserForwardingProductionChildPattern:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternSpanEnds, row)
    if kind == ParserForwardingProductionChildAnnotation:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationSpanEnds, row)
    if kind == ParserForwardingProductionChildLexicalScope:
        return arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationLexicalScopeSpanEnds, row)
    if kind == ParserForwardingProductionChildTypeSyntax:
        return ParserValueExprTypeSyntaxSpanEndAt(tree, row)
    return -1

@borrows
fn parserForwardingProductionOwnerKindValid(
        tree: ParserValueExprTree,
        kind: ParserForwardingProductionKind,
        ownerRow: int32): bool =
    if kind == ParserForwardingProductionTopLevelDecl:
        return ownerRow == -1
    if ownerRow < 0 || ownerRow >= tree.forwardingProductionCount:
        return false
    let ownerKind = ParserForwardingProductionKind(
        arenamod.ArenaArrayInt32Get(
            tree.arena, tree.forwardingProductionKinds, ownerRow))
    let ownerArm = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.forwardingProductionArmIndexes, ownerRow)
    if kind == ParserForwardingProductionTopLevelCore:
        return ownerKind == ParserForwardingProductionTopLevelDecl
    if kind == ParserForwardingProductionStatementCore:
        return ownerKind == ParserForwardingProductionStatement
    if kind == ParserForwardingProductionTemplateBody:
        return ownerKind == ParserForwardingProductionStatementCore &&
               ownerArm == 16
    if kind == ParserForwardingProductionMatchArm:
        return ownerKind == ParserForwardingProductionStatementCore &&
               (ownerArm == 9 || ownerArm == 12)
    if kind == ParserForwardingProductionBlockStmt:
        return ownerKind == ParserForwardingProductionStatementCore &&
               ownerArm == 14
    if kind == ParserForwardingProductionStatement:
        return ownerKind == ParserForwardingProductionTopLevelCore ||
               ownerKind == ParserForwardingProductionTemplateBody ||
               ownerKind == ParserForwardingProductionStatementCore ||
               ownerKind == ParserForwardingProductionMatchArm ||
               ownerKind == ParserForwardingProductionBlockStmt
    return false

fn parserForwardingProductionExpectedAuthorityKind(
        kind: ParserForwardingProductionKind,
        armIndex: int32): ParserForwardingProductionChildKind =
    if kind == ParserForwardingProductionMatchArm:
        return ParserForwardingProductionChildPattern
    if kind != ParserForwardingProductionStatementCore:
        return ParserForwardingProductionChildInvalid
    if armIndex == 1 || armIndex >= 15 && armIndex <= 20:
        return ParserForwardingProductionChildDeclaration
    if armIndex == 2 ||
       armIndex >= 8 && armIndex <= 13 ||
       armIndex == 21:
        return ParserForwardingProductionChildStatementRoot
    if armIndex == 7 || armIndex == 14:
        return ParserForwardingProductionChildLexicalScope
    if armIndex >= 3 && armIndex <= 6:
        return ParserForwardingProductionChildToken
    return ParserForwardingProductionChildInvalid

@borrows
fn parserForwardingProductionAuthoritySpanKey(
        spanStart: int32,
        spanEnd: int32): int64 =
    return (Int64(spanStart) << 32) | Int64(spanEnd)

@borrows
fn parserForwardingProductionStatementRootAuthorityKey(
        role: ParserValueExprStatementRole,
        anchorToken: int32): int64 =
    return (Int64(Int32(role)) << 32) |
           (Int64(anchorToken) + Int64(1))

# 判重域按 (producer, span) 精确计数。span 是源内字节偏移，森林 append 时原样
# 拷贝（设计如此），跨源可撞；只按 span 计数的表会把不同源的同 span 行当成
# 同源重复（fail-closed 误报）。这里用 span→链首 的精确索引（spanKey 为无损
# 64 位打包）加一条平行 row 链，链上逐行比对 producer + span（声明域再加
# declaration kind）；链冲突由精确字段比对消解，不做哈希压缩。
@borrows
fn parserForwardingProductionDeclarationSpanProducerCount(
        tree: ParserValueExprTree,
        declarationKind: ParserDeclarationKind,
        producerSourceIndex: int32,
        spanStart: int32,
        spanEnd: int32,
        headBySpan: hashmaps.HashMapPtrInt,
        nextInSpan: int32[]): int32 =
    var found: bool
    let head = hashmaps.HashMapPtrIntGetEx(
        headBySpan,
        parserForwardingProductionAuthoritySpanKey(spanStart, spanEnd),
        found)
    var count: int32
    var cursor: int32 = head - 1
    while cursor >= 0:
        if arenamod.ArenaArrayInt32Get(
               tree.arena, tree.declarationSpanStarts, cursor) == spanStart &&
           arenamod.ArenaArrayInt32Get(
               tree.arena, tree.declarationSpanEnds, cursor) == spanEnd &&
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationProducerSourceIndexes,
               cursor) == producerSourceIndex &&
           ParserDeclarationKind(arenamod.ArenaArrayInt32Get(
               tree.arena, tree.declarationKinds, cursor)) ==
               declarationKind:
            count = count + 1
        cursor = nextInSpan[cursor] - 1
    return count

@borrows
fn parserForwardingProductionLexicalScopeSpanProducerCount(
        tree: ParserValueExprTree,
        producerSourceIndex: int32,
        spanStart: int32,
        spanEnd: int32,
        headBySpan: hashmaps.HashMapPtrInt,
        nextInSpan: int32[]): int32 =
    var found: bool
    let head = hashmaps.HashMapPtrIntGetEx(
        headBySpan,
        parserForwardingProductionAuthoritySpanKey(spanStart, spanEnd),
        found)
    var count: int32
    var cursor: int32 = head - 1
    while cursor >= 0:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeSpanStarts,
               cursor) == spanStart &&
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeSpanEnds,
               cursor) == spanEnd &&
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeProducerSourceIndexes,
               cursor) == producerSourceIndex:
            count = count + 1
        cursor = nextInSpan[cursor] - 1
    return count

@borrows
fn parserForwardingProductionPatternSpanProducerCount(
        tree: ParserValueExprTree,
        producerSourceIndex: int32,
        spanStart: int32,
        spanEnd: int32,
        headBySpan: hashmaps.HashMapPtrInt,
        nextInSpan: int32[]): int32 =
    var found: bool
    let head = hashmaps.HashMapPtrIntGetEx(
        headBySpan,
        parserForwardingProductionAuthoritySpanKey(spanStart, spanEnd),
        found)
    var count: int32
    var cursor: int32 = head - 1
    while cursor >= 0:
        let regionRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternOwnerRows, cursor)
        if regionRow >= 0 && regionRow < tree.regionCount &&
           arenamod.ArenaArrayInt32Get(
               tree.arena, tree.regionSpanStarts, regionRow) == spanStart &&
           arenamod.ArenaArrayInt32Get(
               tree.arena, tree.regionSpanEnds, regionRow) == spanEnd &&
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.patternProducerSourceIndexes,
               cursor) == producerSourceIndex:
            count = count + 1
        cursor = nextInSpan[cursor] - 1
    return count

@borrows
fn parserForwardingProductionAuthorityTargetValid(
        tree: ParserValueExprTree,
        row: int32,
        kind: ParserForwardingProductionKind,
        armIndex: int32,
        authorityKind: ParserForwardingProductionChildKind,
        authorityRow: int32,
        anchorToken: int32,
        spanStartToken: int32,
        spanEndToken: int32,
        spanStart: int32,
        spanEnd: int32,
        producerSourceIndex: int32,
        declarationHeadBySpan: hashmaps.HashMapPtrInt,
        declarationNextInSpan: int32[],
        statementRootRoleCounts: hashmaps.HashMapPtrInt,
        lexicalScopeHeadBySpan: hashmaps.HashMapPtrInt,
        lexicalScopeNextInSpan: int32[],
        patternHeadBySpan: hashmaps.HashMapPtrInt,
        patternNextInSpan: int32[]): bool =
    var found: bool
    let bindingDeclaration =
        kind == ParserForwardingProductionStatementCore && armIndex == 0
    let valuedTerminal =
        kind == ParserForwardingProductionStatementCore &&
        (armIndex == 3 || armIndex == 4)
    if bindingDeclaration:
        if authorityKind !=
               ParserForwardingProductionChildStatementRoot &&
           authorityKind != ParserForwardingProductionChildPattern:
            return false
    elif valuedTerminal:
        if authorityKind != ParserForwardingProductionChildToken &&
           authorityKind !=
               ParserForwardingProductionChildStatementRoot:
            return false
    elif authorityKind !=
             parserForwardingProductionExpectedAuthorityKind(
                 kind, armIndex):
        return false
    if authorityKind == ParserForwardingProductionChildInvalid:
        return authorityRow == -1
    if authorityKind == ParserForwardingProductionChildToken:
        return authorityRow == anchorToken &&
               (!valuedTerminal ||
                (spanStart ==
                     ParserValueExprTokenStartAt(tree, anchorToken) &&
                 spanEnd ==
                     ParserValueExprTokenEndAt(tree, anchorToken)))
    if authorityKind == ParserForwardingProductionChildDeclaration:
        let declarationKind = ParserDeclarationKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena, tree.declarationKinds, authorityRow))
        var expectedKind = ParserDeclarationFunction
        if armIndex == 0:
            expectedKind = ParserDeclarationLocal
        elif armIndex == 1:
            expectedKind = ParserDeclarationType
        elif armIndex == 17:
            expectedKind = ParserDeclarationConcept
        elif armIndex == 18:
            expectedKind = ParserDeclarationTrait
        if declarationKind != expectedKind ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationSpanStarts,
               authorityRow) != spanStart ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationSpanEnds,
               authorityRow) != spanEnd:
            return false
        if ParserValueExprForwardingProductionChildProducerSourceIndexAt(
               tree,
               ParserForwardingProductionChildDeclaration,
               authorityRow) != producerSourceIndex:
            return false
        let exactDeclarationCount =
            parserForwardingProductionDeclarationSpanProducerCount(
                tree,
                expectedKind,
                producerSourceIndex,
                spanStart,
                spanEnd,
                declarationHeadBySpan,
                declarationNextInSpan)
        return exactDeclarationCount == 1
    if authorityKind == ParserForwardingProductionChildStatementRoot:
        let role = ParserValueExprStatementRootRoleAt(
            tree, authorityRow)
        var expectedRole = ParserValueExprStatementCondition
        if armIndex == 0:
            # BindingInitializer 为常规绑定；AssignmentRhs 为通配符丢弃
            # 绑定 `let _ = expr`（wildcard 模式不创建声明行）。
            expectedRole = ParserValueExprStatementBindingInitializer
        elif armIndex == 2:
            expectedRole = ParserValueExprStatementAssignmentRhs
        elif armIndex == 3:
            expectedRole = ParserValueExprStatementReturnValue
        elif armIndex == 4:
            expectedRole = ParserValueExprStatementYieldValue
        elif armIndex == 11:
            expectedRole = ParserValueExprStatementLoopSource
        elif armIndex == 21:
            if role != ParserValueExprStatementExpression &&
               role != ParserValueExprStatementImplicitReturnValue:
                return false
        elif role != ParserValueExprStatementCondition:
            return false
        if armIndex != 21 && role != expectedRole:
            let wildcardDiscard = armIndex == 0 &&
                role == ParserValueExprStatementAssignmentRhs
            if !wildcardDiscard:
                return false
        let authorityAnchor =
            ParserValueExprStatementRootAnchorTokenAt(
                tree, authorityRow)
        if armIndex == 0 || armIndex == 2:
            let topLevelAssign = ParserValueExprFindTopLevelKind(
                tree,
                spanStartToken,
                spanEndToken + 1,
                ParserValueTokenAssign)
            if authorityAnchor != topLevelAssign:
                return false
            if armIndex == 0:
                let declarationCount =
                    ParserValueExprStatementRootBindingDeclarationCountAt(
                        tree, authorityRow)
                let exactStatementRootCount =
                    hashmaps.HashMapPtrIntGetEx(
                        statementRootRoleCounts,
                        parserForwardingProductionStatementRootAuthorityKey(
                            ParserValueExprStatementBindingInitializer,
                            topLevelAssign),
                        found)
                if declarationCount > 0 &&
                   exactStatementRootCount == 1:
                    return true
                # 通配符丢弃绑定 `let _ = expr`：wildcard 模式不创建声明行，
                # 语句根角色是 AssignmentRhs。丢弃绑定没有需要证明的声明，
                # 其 authority 与 arm-2 赋值同构：锚点对齐 + 全树唯一。
                if role == ParserValueExprStatementAssignmentRhs:
                    let discardCount = hashmaps.HashMapPtrIntGetEx(
                        statementRootRoleCounts,
                        parserForwardingProductionStatementRootAuthorityKey(
                            ParserValueExprStatementAssignmentRhs,
                            topLevelAssign),
                        found)
                    return discardCount == 1
                return false
            let exactStatementRootCount =
                hashmaps.HashMapPtrIntGetEx(
                    statementRootRoleCounts,
                    parserForwardingProductionStatementRootAuthorityKey(
                        ParserValueExprStatementAssignmentRhs,
                        topLevelAssign),
                    found)
            return exactStatementRootCount == 1
        if authorityAnchor != anchorToken:
            return false
        if armIndex == 21:
            let expressionCount = hashmaps.HashMapPtrIntGetEx(
                statementRootRoleCounts,
                parserForwardingProductionStatementRootAuthorityKey(
                    ParserValueExprStatementExpression,
                    anchorToken),
                found)
            let implicitReturnCount = hashmaps.HashMapPtrIntGetEx(
                statementRootRoleCounts,
                parserForwardingProductionStatementRootAuthorityKey(
                    ParserValueExprStatementImplicitReturnValue,
                    anchorToken),
                found)
            return expressionCount + implicitReturnCount == 1
        let exactStatementRootCount = hashmaps.HashMapPtrIntGetEx(
            statementRootRoleCounts,
            parserForwardingProductionStatementRootAuthorityKey(
                expectedRole, anchorToken),
            found)
        return exactStatementRootCount == 1
    if authorityKind == ParserForwardingProductionChildLexicalScope:
        let colonToken = ParserValueExprFindTopLevelKind(
            tree,
            spanStartToken,
            spanEndToken + 1,
            ParserValueTokenColon)
        if colonToken < spanStartToken || colonToken >= spanEndToken:
            return false
        let suiteSpanStart =
            ParserValueExprTokenStartAt(tree, colonToken + 1)
        if ParserDeclarationLexicalScopeKind(
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.declarationLexicalScopeKinds,
                       authorityRow)) ==
                   ParserDeclarationLexicalScopeBlock &&
           arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationLexicalScopeSpanStarts,
                   authorityRow) == suiteSpanStart &&
           arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationLexicalScopeSpanEnds,
                   authorityRow) == spanEnd:
            if ParserValueExprForwardingProductionChildProducerSourceIndexAt(
                   tree,
                   ParserForwardingProductionChildLexicalScope,
                   authorityRow) != producerSourceIndex:
                return false
            let exactScopeCount =
                parserForwardingProductionLexicalScopeSpanProducerCount(
                    tree,
                    producerSourceIndex,
                    suiteSpanStart,
                    spanEnd,
                    lexicalScopeHeadBySpan,
                    lexicalScopeNextInSpan)
            return exactScopeCount == 1
        return false
    if authorityKind == ParserForwardingProductionChildPattern:
        if ParserPatternOwnerKind(arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.patternOwnerKinds,
               authorityRow)) != ParserPatternOwnerRegion:
            return false
        if ParserValueExprForwardingProductionChildProducerSourceIndexAt(
               tree,
               ParserForwardingProductionChildPattern,
               authorityRow) != producerSourceIndex:
            return false
        let regionRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternOwnerRows, authorityRow)
        if regionRow < 0 || regionRow >= tree.regionCount:
            return false
        let regionKind = ParserValueExprRegionKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena, tree.regionKinds, regionRow))
        let regionSpanStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.regionSpanStarts, regionRow)
        let regionSpanEnd = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.regionSpanEnds, regionRow)
        if bindingDeclaration:
            if regionKind != ParserValueExprRegionPattern ||
               regionSpanStart < spanStart || regionSpanEnd > spanEnd ||
               ParserValueExprFindTopLevelKind(
                   tree,
                   spanStartToken,
                   spanEndToken + 1,
                   ParserValueTokenAssign) >= 0:
                return false
            let declarationCount =
                parserForwardingProductionDeclarationSpanProducerCount(
                    tree,
                    ParserDeclarationLocal,
                    producerSourceIndex,
                    spanStart,
                    spanEnd,
                    declarationHeadBySpan,
                    declarationNextInSpan)
            let exactPatternCount =
                parserForwardingProductionPatternSpanProducerCount(
                    tree,
                    producerSourceIndex,
                    regionSpanStart,
                    regionSpanEnd,
                    patternHeadBySpan,
                    patternNextInSpan)
            return declarationCount > 0 && exactPatternCount == 1
        if regionKind != ParserValueExprRegionCaseArm ||
           regionSpanStart != spanStart || regionSpanEnd != spanEnd:
            return false
        let exactPatternCount =
            parserForwardingProductionPatternSpanProducerCount(
                tree,
                producerSourceIndex,
                spanStart,
                spanEnd,
                patternHeadBySpan,
                patternNextInSpan)
        return exactPatternCount == 1
    return false

@borrows
fn parserForwardingProductionChildContractValid(
        tree: ParserValueExprTree,
        row: int32,
        kind: ParserForwardingProductionKind,
        armIndex: int32): bool =
    let childStart = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.forwardingProductionChildStarts, row)
    let childCount = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.forwardingProductionChildCounts, row)
    var forwardingCount: int32
    var forwardingKind = ParserForwardingProductionInvalid
    for offset in 0..<childCount:
        let childIndex = childStart + offset
        if ParserForwardingProductionChildKind(
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.forwardingProductionChildKinds,
                   childIndex)) !=
               ParserForwardingProductionChildForwardingProduction:
            continue
        let childRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionChildRows,
            childIndex)
        let childKind = ParserForwardingProductionKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.forwardingProductionKinds,
                childRow))
        if forwardingCount == 0:
            forwardingKind = childKind
        elif forwardingKind != childKind:
            return false
        forwardingCount = forwardingCount + 1
    if kind == ParserForwardingProductionTopLevelDecl:
        return forwardingCount == 1 &&
               forwardingKind ==
                   ParserForwardingProductionTopLevelCore
    if kind == ParserForwardingProductionTopLevelCore:
        if forwardingCount != 1 ||
           forwardingKind != ParserForwardingProductionStatement:
            return false
        var statementRow: int32 = -1
        for offset in 0..<childCount:
            let childIndex = childStart + offset
            if ParserForwardingProductionChildKind(
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.forwardingProductionChildKinds,
                       childIndex)) ==
                   ParserForwardingProductionChildForwardingProduction:
                statementRow = arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.forwardingProductionChildRows,
                    childIndex)
                break
        if statementRow < 0:
            return false
        let statementChildStart = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionChildStarts,
            statementRow)
        let statementChildCount = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionChildCounts,
            statementRow)
        var statementCoreRow: int32 = -1
        var statementCoreCount: int32
        for offset in 0..<statementChildCount:
            let childIndex = statementChildStart + offset
            if ParserForwardingProductionChildKind(
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.forwardingProductionChildKinds,
                       childIndex)) !=
                   ParserForwardingProductionChildForwardingProduction:
                continue
            let candidateRow = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.forwardingProductionChildRows,
                childIndex)
            if ParserForwardingProductionKind(
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.forwardingProductionKinds,
                       candidateRow)) !=
                   ParserForwardingProductionStatementCore:
                return false
            statementCoreRow = candidateRow
            statementCoreCount = statementCoreCount + 1
        if statementCoreCount != 1:
            return false
        let statementCoreArm = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionArmIndexes,
            statementCoreRow)
        return parserForwardingTopLevelCoreArm(statementCoreArm) ==
               armIndex
    if kind == ParserForwardingProductionStatement:
        return forwardingCount == 1 &&
               forwardingKind ==
                   ParserForwardingProductionStatementCore
    if kind == ParserForwardingProductionTemplateBody ||
       kind == ParserForwardingProductionBlockStmt ||
       kind == ParserForwardingProductionMatchArm:
        return forwardingCount > 0 &&
               forwardingKind ==
                   ParserForwardingProductionStatement
    if kind != ParserForwardingProductionStatementCore:
        return false
    if armIndex == 9:
        return forwardingCount > 0 &&
               forwardingKind ==
                   ParserForwardingProductionMatchArm
    if armIndex == 14:
        return forwardingCount == 1 &&
               forwardingKind ==
                   ParserForwardingProductionBlockStmt
    if armIndex == 16:
        return forwardingCount == 1 &&
               forwardingKind ==
                   ParserForwardingProductionTemplateBody
    if armIndex == 5 || armIndex == 6:
        return forwardingCount == 0
    return forwardingCount == 0 ||
           forwardingKind == ParserForwardingProductionStatement

@borrows
fn parserForwardingProductionBindingTypeSyntaxRoot(
        tree: ParserValueExprTree,
        row: int32): int32 =
    if row < 0 || row >= tree.forwardingProductionCount ||
       ParserForwardingProductionKind(arenamod.ArenaArrayInt32Get(
           tree.arena, tree.forwardingProductionKinds, row)) !=
           ParserForwardingProductionStatementCore ||
       arenamod.ArenaArrayInt32Get(
           tree.arena, tree.forwardingProductionArmIndexes, row) != 0:
        return -1
    let authorityKind = ParserForwardingProductionChildKind(
        arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionAuthorityKinds,
            row))
    let authorityRow = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.forwardingProductionAuthorityRows, row)
    var typeSyntaxRoot: int32 = -1
    if authorityKind == ParserForwardingProductionChildPattern:
        if authorityRow < 0 || authorityRow >= tree.patternCount:
            panic("parser forwarding production: binding pattern authority invalid")
        typeSyntaxRoot = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.patternTypeSyntaxRootIndexes,
            authorityRow)
    elif authorityKind == ParserForwardingProductionChildStatementRoot:
        if authorityRow < 0 || authorityRow >= tree.statementRootCount:
            panic("parser forwarding production: binding initializer authority invalid")
        let declarationStart =
            ParserValueExprStatementRootBindingDeclarationStartAt(
                tree, authorityRow)
        let declarationCount =
            ParserValueExprStatementRootBindingDeclarationCountAt(
                tree, authorityRow)
        if declarationCount <= 0:
            let badRole = ParserValueExprStatementRootRoleAt(
                tree, authorityRow)
            if badRole == ParserValueExprStatementAssignmentRhs:
                # 通配符丢弃绑定 `let _ = expr`：无声明行、无类型语法可提取，
                # authority 仅锚定语句本身。
                return -1
            panic(Fmt"parser forwarding production: binding initializer declaration authority missing row={row} authority_row={authorityRow} role={Int32(badRole)} declaration_count={declarationCount} statement_roots={tree.statementRootCount}")
        for declarationOffset in 0..<declarationCount:
            let declarationRow = declarationStart + declarationOffset
            if declarationRow < 0 || declarationRow >= tree.declarationCount:
                panic("parser forwarding production: binding declaration authority invalid")
            let declarationTypeSyntaxRoot = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationTypeSyntaxRootIndexes,
                declarationRow)
            if declarationOffset == 0:
                typeSyntaxRoot = declarationTypeSyntaxRoot
            elif declarationTypeSyntaxRoot != typeSyntaxRoot:
                panic("parser forwarding production: binding declaration type identity split")
    if typeSyntaxRoot < 0:
        return -1
    if typeSyntaxRoot >= tree.typeSyntaxCount ||
       ParserValueExprTypeSyntaxRootKindAt(tree, typeSyntaxRoot) !=
           ParserTypeSyntaxRootBindingAnnotation:
        panic("parser forwarding production: binding type syntax authority invalid")
    return typeSyntaxRoot

fn parserForwardingProductionsSeal(tree: var ParserValueExprTree) =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.forwardingProductionsSealed ||
       tree.activeForwardingProductionRow != -1 ||
       tree.forwardingProductionChildCount != 0 ||
       tree.forwardingProductionChildKinds.len != 0 ||
       tree.forwardingProductionChildRows.len != 0:
        panic("parser forwarding production: invalid seal state")
    var childCounts: int32[]
    var childCursors: int32[]
    setLen(childCounts, tree.forwardingProductionCount)
    setLen(childCursors, tree.forwardingProductionCount)
    for row in 0..<tree.forwardingProductionCount:
        let ownerRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.forwardingProductionOwnerRows, row)
        let authorityKind = ParserForwardingProductionChildKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.forwardingProductionAuthorityKinds,
                row))
        let authorityRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.forwardingProductionAuthorityRows, row)
        if ownerRow >= 0:
            childCounts[ownerRow] = childCounts[ownerRow] + 1
        if authorityKind != ParserForwardingProductionChildInvalid:
            if !parserForwardingProductionAuthorityRowValid(
                   tree, authorityKind, authorityRow):
                panic("parser forwarding production: authority row invalid")
            childCounts[row] = childCounts[row] + 1
        elif authorityRow != -1:
            panic("parser forwarding production: invalid authority sentinel")
        let annotationCount = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionAnnotationCounts,
            row)
        childCounts[row] = childCounts[row] + annotationCount
        if parserForwardingProductionBindingTypeSyntaxRoot(tree, row) >= 0:
            childCounts[row] = childCounts[row] + 1
    var totalChildCount: int32
    for row in 0..<tree.forwardingProductionCount:
        let count = childCounts[row]
        arenamod.ArenaArrayInt32Set(
            tree.arena,
            tree.forwardingProductionChildStarts,
            row,
            count == 0 ? -1 : totalChildCount)
        arenamod.ArenaArrayInt32Set(
            tree.arena,
            tree.forwardingProductionChildCounts,
            row,
            count)
        childCursors[row] = totalChildCount
        totalChildCount = totalChildCount + count
    for childIndex in 0..<totalChildCount:
        arenamod.ArenaArrayInt32Add(
            tree.arena,
            tree.forwardingProductionChildKinds,
            Int32(ParserForwardingProductionChildInvalid))
        arenamod.ArenaArrayInt32Add(
            tree.arena, tree.forwardingProductionChildRows, -1)
    for row in 0..<tree.forwardingProductionCount:
        let authorityKind = ParserForwardingProductionChildKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.forwardingProductionAuthorityKinds,
                row))
        if authorityKind != ParserForwardingProductionChildInvalid:
            let cursor = childCursors[row]
            arenamod.ArenaArrayInt32Set(
                tree.arena,
                tree.forwardingProductionChildKinds,
                cursor,
                Int32(authorityKind))
            arenamod.ArenaArrayInt32Set(
                tree.arena,
                tree.forwardingProductionChildRows,
                cursor,
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.forwardingProductionAuthorityRows,
                    row))
            childCursors[row] = cursor + 1
        let annotationStart = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionAnnotationStarts,
            row)
        let annotationCount = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionAnnotationCounts,
            row)
        for offset in 0..<annotationCount:
            let cursor = childCursors[row]
            arenamod.ArenaArrayInt32Set(
                tree.arena,
                tree.forwardingProductionChildKinds,
                cursor,
                Int32(ParserForwardingProductionChildAnnotation))
            arenamod.ArenaArrayInt32Set(
                tree.arena,
                tree.forwardingProductionChildRows,
                cursor,
                annotationStart + offset)
            childCursors[row] = cursor + 1
        let bindingTypeSyntaxRoot =
            parserForwardingProductionBindingTypeSyntaxRoot(tree, row)
        if bindingTypeSyntaxRoot >= 0:
            let cursor = childCursors[row]
            arenamod.ArenaArrayInt32Set(
                tree.arena,
                tree.forwardingProductionChildKinds,
                cursor,
                Int32(ParserForwardingProductionChildTypeSyntax))
            arenamod.ArenaArrayInt32Set(
                tree.arena,
                tree.forwardingProductionChildRows,
                cursor,
                bindingTypeSyntaxRoot)
            childCursors[row] = cursor + 1
    for childRow in 0..<tree.forwardingProductionCount:
        let ownerRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionOwnerRows,
            childRow)
        if ownerRow < 0:
            continue
        let cursor = childCursors[ownerRow]
        arenamod.ArenaArrayInt32Set(
            tree.arena,
            tree.forwardingProductionChildKinds,
            cursor,
            Int32(ParserForwardingProductionChildForwardingProduction))
        arenamod.ArenaArrayInt32Set(
            tree.arena,
            tree.forwardingProductionChildRows,
            cursor,
            childRow)
        childCursors[ownerRow] = cursor + 1
    tree.forwardingProductionChildCount = totalChildCount
    tree.forwardingProductionsSealed = true

# 判重用 int64 开放寻址集合（替换两处 0..<row 三角回扫 O(n²) 判重）。
# slots 存 key+1（0=空），容量恒为 2 的幂，用 & mask 取位代替取模：int64 %
# 的 node-eval lowering 会留未归约结果（见 NormalizedExprLookupSlotForKey 注释）。
# key 上界：kind/scope/row/hash32 均非负且 < 2^31（调用点前序校验保证），
# (Int64(a) << 32) | Int64(b) 不会溢出 int64。返回 true=首次插入，false=重复。
fn parserInt64SeenCapacityFor(count: int32): int32 =
    var cap: int32 = 1
    while cap < count * 2:
        cap = cap * 2
    return cap

fn parserInt64SeenInsert(slots: var int64[], key: int64): bool =
    let mask = Int64(slots.len) - 1
    var probe: int32 = Int32(key & mask)
    if probe < 0:
        probe = 0
    var scanned: int32
    while scanned < slots.len:
        let storedPlus1 = slots[probe]
        if storedPlus1 == 0:
            slots[probe] = key + 1
            return true
        if storedPlus1 == key + 1:
            return false
        probe = probe + 1
        if probe >= slots.len:
            probe = 0
        scanned = scanned + 1
    panic("parser int64 seen set: table full")

@borrows
fn ParserValueExprTreeForwardingProductionsStrictValidateInto(
        tree: ParserValueExprTree,
        err: var str): bool =
    err = ""
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       !tree.forwardingProductionsSealed ||
       tree.activeForwardingProductionRow != -1 ||
       tree.forwardingProductionCount < 0 ||
       tree.forwardingProductionChildCount < 0 ||
       tree.forwardingProductionProducerSourceIndexes.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionSourceLocalRows.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionKinds.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionArmIndexes.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionOwnerRows.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionAnchorTokenIndexes.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionSpanStartTokenIndexes.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionSpanEndTokenIndexes.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionSpanStarts.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionSpanEnds.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionAuthorityKinds.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionAuthorityRows.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionAnnotationStarts.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionAnnotationCounts.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionChildStarts.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionChildCounts.len !=
           tree.forwardingProductionCount ||
       tree.forwardingProductionChildKinds.len !=
           tree.forwardingProductionChildCount ||
       tree.forwardingProductionChildRows.len !=
           tree.forwardingProductionChildCount:
        err = "parser forwarding production: column lengths invalid"
        return false
    var nextSourceLocalRows: int32[]
    var childCursors: int32[]
    var authoritySeenSlots: int64[]
    setLen(nextSourceLocalRows, tree.producerSourceCount)
    setLen(childCursors, tree.forwardingProductionCount)
    setLen(authoritySeenSlots,
           parserInt64SeenCapacityFor(tree.forwardingProductionCount))
    var declarationHeadBySpan = hashmaps.HashMapPtrIntInit(
        parserInt64SeenCapacityFor(tree.declarationCount))
    var declarationNextInSpan: int32[]
    setLen(declarationNextInSpan, tree.declarationCount)
    var statementRootRoleCounts = hashmaps.HashMapPtrIntInit(
        parserInt64SeenCapacityFor(tree.statementRootCount))
    var lexicalScopeHeadBySpan = hashmaps.HashMapPtrIntInit(
        parserInt64SeenCapacityFor(tree.declarationLexicalScopeCount))
    var lexicalScopeNextInSpan: int32[]
    setLen(lexicalScopeNextInSpan, tree.declarationLexicalScopeCount)
    var patternHeadBySpan = hashmaps.HashMapPtrIntInit(
        parserInt64SeenCapacityFor(tree.patternCount))
    var patternNextInSpan: int32[]
    setLen(patternNextInSpan, tree.patternCount)
    var authorityCountFound: bool
    for declarationRow in 0..<tree.declarationCount:
        let spanStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationSpanStarts, declarationRow)
        let spanEnd = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationSpanEnds, declarationRow)
        let key = parserForwardingProductionAuthoritySpanKey(
            spanStart, spanEnd)
        let head = hashmaps.HashMapPtrIntGetEx(
            declarationHeadBySpan, key, authorityCountFound)
        declarationNextInSpan[declarationRow] = head
        hashmaps.HashMapPtrIntPut(
            declarationHeadBySpan, key, declarationRow + 1)
    for statementRootRow in 0..<tree.statementRootCount:
        let role = ParserValueExprStatementRootRoleAt(
            tree, statementRootRow)
        let anchorToken = ParserValueExprStatementRootAnchorTokenAt(
            tree, statementRootRow)
        let key = parserForwardingProductionStatementRootAuthorityKey(
            role, anchorToken)
        let oldCount = hashmaps.HashMapPtrIntGetEx(
            statementRootRoleCounts, key, authorityCountFound)
        hashmaps.HashMapPtrIntPut(
            statementRootRoleCounts, key, oldCount + 1)
    for scopeRow in 0..<tree.declarationLexicalScopeCount:
        if ParserDeclarationLexicalScopeKind(
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.declarationLexicalScopeKinds,
                    scopeRow)) == ParserDeclarationLexicalScopeBlock:
            let spanStart = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationLexicalScopeSpanStarts,
                scopeRow)
            let spanEnd = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationLexicalScopeSpanEnds,
                scopeRow)
            let key = parserForwardingProductionAuthoritySpanKey(
                spanStart, spanEnd)
            let head = hashmaps.HashMapPtrIntGetEx(
                lexicalScopeHeadBySpan, key, authorityCountFound)
            lexicalScopeNextInSpan[scopeRow] = head
            hashmaps.HashMapPtrIntPut(
                lexicalScopeHeadBySpan, key, scopeRow + 1)
    for patternRow in 0..<tree.patternCount:
        if ParserPatternOwnerKind(
                arenamod.ArenaArrayInt32Get(
                    tree.arena, tree.patternOwnerKinds, patternRow)) ==
                ParserPatternOwnerRegion:
            let regionRow = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.patternOwnerRows, patternRow)
            if regionRow >= 0 && regionRow < tree.regionCount:
                let regionKind = ParserValueExprRegionKind(
                    arenamod.ArenaArrayInt32Get(
                        tree.arena, tree.regionKinds, regionRow))
                if regionKind != ParserValueExprRegionCaseArm &&
                   regionKind != ParserValueExprRegionPattern:
                    continue
                let spanStart = arenamod.ArenaArrayInt32Get(
                    tree.arena, tree.regionSpanStarts, regionRow)
                let spanEnd = arenamod.ArenaArrayInt32Get(
                    tree.arena, tree.regionSpanEnds, regionRow)
                let key = parserForwardingProductionAuthoritySpanKey(
                    spanStart, spanEnd)
                let head = hashmaps.HashMapPtrIntGetEx(
                    patternHeadBySpan, key, authorityCountFound)
                patternNextInSpan[patternRow] = head
                hashmaps.HashMapPtrIntPut(
                    patternHeadBySpan, key, patternRow + 1)
    var expectedChildStart: int32
    for row in 0..<tree.forwardingProductionCount:
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionProducerSourceIndexes,
            row)
        let sourceLocalRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionSourceLocalRows,
            row)
        let kind = ParserForwardingProductionKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena, tree.forwardingProductionKinds, row))
        let armIndex = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.forwardingProductionArmIndexes, row)
        let ownerRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.forwardingProductionOwnerRows, row)
        let anchorToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionAnchorTokenIndexes,
            row)
        let spanStartToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionSpanStartTokenIndexes,
            row)
        let spanEndToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionSpanEndTokenIndexes,
            row)
        let spanStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.forwardingProductionSpanStarts, row)
        let spanEnd = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.forwardingProductionSpanEnds, row)
        let childStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.forwardingProductionChildStarts, row)
        let childCount = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.forwardingProductionChildCounts, row)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= tree.producerSourceCount ||
           sourceLocalRow != nextSourceLocalRows[producerSourceIndex] ||
           !parserForwardingProductionArmValid(kind, armIndex) ||
           ownerRow < -1 || ownerRow >= row ||
           !parserForwardingProductionOwnerKindValid(
               tree, kind, ownerRow) ||
           (ownerRow >= 0 &&
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.forwardingProductionProducerSourceIndexes,
                ownerRow) != producerSourceIndex) ||
           anchorToken < 0 || anchorToken >= tree.tokenCount ||
           spanStartToken < 0 || spanStartToken >= tree.tokenCount ||
           spanEndToken < 0 || spanEndToken >= tree.tokenCount ||
           ParserValueExprTokenProducerSourceIndexAt(tree, anchorToken) !=
               producerSourceIndex ||
           ParserValueExprTokenProducerSourceIndexAt(
               tree, spanStartToken) != producerSourceIndex ||
           ParserValueExprTokenProducerSourceIndexAt(
               tree, spanEndToken) != producerSourceIndex ||
           ParserValueExprTokenSourceIdAt(tree, spanStartToken) !=
               ParserValueExprTokenSourceIdAt(tree, anchorToken) ||
           ParserValueExprTokenSourceIdAt(tree, spanEndToken) !=
               ParserValueExprTokenSourceIdAt(tree, anchorToken) ||
           spanStart < 0 || spanEnd <= spanStart ||
           spanStart !=
               ParserValueExprTokenStartAt(tree, spanStartToken) ||
           spanEnd !=
               ParserValueExprTokenEndAt(tree, spanEndToken) ||
           ParserValueExprTokenStartAt(tree, anchorToken) < spanStart ||
           ParserValueExprTokenEndAt(tree, anchorToken) > spanEnd ||
           spanEnd > ParserValueExprSourceLen(
               tree,
               ParserValueExprTokenSourceIdAt(
                   tree, anchorToken)) ||
           (ownerRow >= 0 &&
            (spanStart <
                 arenamod.ArenaArrayInt32Get(
                     tree.arena,
                     tree.forwardingProductionSpanStarts,
                     ownerRow) ||
             spanEnd >
                 arenamod.ArenaArrayInt32Get(
                     tree.arena,
                     tree.forwardingProductionSpanEnds,
                     ownerRow))) ||
           childCount <= 0 ||
           childStart != expectedChildStart ||
           childStart + childCount >
               tree.forwardingProductionChildCount:
            err = Fmt"parser forwarding production: row invalid row={row} kind={Int32(kind)} arm={armIndex} owner={ownerRow} anchor={anchorToken} span={spanStart}:{spanEnd} child_start={childStart} expected_child_start={expectedChildStart} child_count={childCount} child_total={tree.forwardingProductionChildCount}"
            return false
        nextSourceLocalRows[producerSourceIndex] = sourceLocalRow + 1
        childCursors[row] = childStart
        expectedChildStart = expectedChildStart + childCount
        let authorityKind = ParserForwardingProductionChildKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.forwardingProductionAuthorityKinds,
                row))
        let authorityRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.forwardingProductionAuthorityRows, row)
        if !parserForwardingProductionAuthorityRowValid(
               tree, authorityKind, authorityRow) ||
           !parserForwardingProductionAuthorityTargetValid(
               tree,
               row,
               kind,
               armIndex,
               authorityKind,
               authorityRow,
               anchorToken,
               spanStartToken,
               spanEndToken,
               spanStart,
               spanEnd,
               producerSourceIndex,
               declarationHeadBySpan,
               declarationNextInSpan,
               statementRootRoleCounts,
               lexicalScopeHeadBySpan,
               lexicalScopeNextInSpan,
               patternHeadBySpan,
               patternNextInSpan):
            err = Fmt"parser forwarding production: authority invalid row={row} kind={Int32(kind)} arm={armIndex} auth_kind={Int32(authorityKind)} auth_row={authorityRow} expected_auth={Int32(parserForwardingProductionExpectedAuthorityKind(kind, armIndex))} owner={ownerRow} span={spanStart}:{spanEnd} source_local={sourceLocalRow} producer={producerSourceIndex}"
            return false
        if authorityKind != ParserForwardingProductionChildInvalid:
            let seenKey = (
                (Int64(Int32(authorityKind)) << 32) |
                Int64(authorityRow))
            if !parserInt64SeenInsert(authoritySeenSlots, seenKey):
                err = Fmt"parser forwarding production: authority target reused row={row}"
                return false
            let cursor = childCursors[row]
            if ParserForwardingProductionChildKind(
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.forwardingProductionChildKinds,
                       cursor)) != authorityKind ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.forwardingProductionChildRows,
                   cursor) != authorityRow:
                err = Fmt"parser forwarding production: authority child drift row={row}"
                return false
            childCursors[row] = cursor + 1
        let annotationStart = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionAnnotationStarts,
            row)
        let annotationCount = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionAnnotationCounts,
            row)
        if annotationCount < 0 ||
           (annotationCount > 0 &&
            kind != ParserForwardingProductionTopLevelDecl &&
            kind != ParserForwardingProductionStatement) ||
           (annotationCount == 0 && annotationStart != -1) ||
           (annotationCount > 0 &&
            (annotationStart < 0 ||
             annotationStart + annotationCount > tree.annotationCount)):
            err = Fmt"parser forwarding production: annotation range invalid row={row}"
            return false
        var previousAnnotationEnd: int32 = -1
        for offset in 0..<annotationCount:
            let cursor = childCursors[row]
            let annotationRow = annotationStart + offset
            if ParserForwardingProductionChildKind(
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.forwardingProductionChildKinds,
                       cursor)) !=
                   ParserForwardingProductionChildAnnotation ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.forwardingProductionChildRows,
                   cursor) != annotationRow ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.annotationTargetTokenIndexes,
                   annotationRow) != anchorToken ||
               (previousAnnotationEnd >= 0 &&
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.annotationSpanStarts,
                    annotationRow) < previousAnnotationEnd):
                err = Fmt"parser forwarding production: annotation child drift row={row}"
                return false
            previousAnnotationEnd = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.annotationSpanEnds,
                annotationRow)
            childCursors[row] = cursor + 1
        let bindingTypeSyntaxRoot =
            parserForwardingProductionBindingTypeSyntaxRoot(tree, row)
        if bindingTypeSyntaxRoot >= 0:
            let cursor = childCursors[row]
            if cursor < 0 || cursor >= tree.forwardingProductionChildCount ||
               ParserForwardingProductionChildKind(
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.forwardingProductionChildKinds,
                       cursor)) != ParserForwardingProductionChildTypeSyntax ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.forwardingProductionChildRows,
                   cursor) != bindingTypeSyntaxRoot:
                err = Fmt"parser forwarding production: binding type child drift row={row}"
                return false
            childCursors[row] = cursor + 1
        var exactSpanStart =
            ParserValueExprTokenStartAt(tree, anchorToken)
        var exactSpanEnd =
            ParserValueExprTokenEndAt(tree, anchorToken)
        for offset in 0..<childCount:
            let childIndex = childStart + offset
            let childKind = ParserForwardingProductionChildKind(
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.forwardingProductionChildKinds,
                    childIndex))
            let childRow = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.forwardingProductionChildRows,
                childIndex)
            let childProducerSourceIndex =
                ParserValueExprForwardingProductionChildProducerSourceIndexAt(
                    tree, childKind, childRow)
            let childSourceTextId =
                ParserValueExprForwardingProductionChildSourceTextIdAt(
                    tree, childKind, childRow)
            let childSpanStart =
                ParserValueExprForwardingProductionChildSpanStartAt(
                    tree, childKind, childRow)
            let childSpanEnd =
                ParserValueExprForwardingProductionChildSpanEndAt(
                    tree, childKind, childRow)
            if childProducerSourceIndex != producerSourceIndex ||
               childSourceTextId !=
                   ParserValueExprTokenSourceIdAt(
                       tree, anchorToken) ||
               childSpanStart < spanStart ||
               childSpanEnd > spanEnd ||
               childSpanEnd <= childSpanStart:
                err = Fmt"parser forwarding production: child source/span invalid row={row} child={childIndex}"
                return false
            if childSpanStart < exactSpanStart:
                exactSpanStart = childSpanStart
            if childSpanEnd > exactSpanEnd:
                exactSpanEnd = childSpanEnd
        if spanStart != exactSpanStart || spanEnd != exactSpanEnd:
            err = Fmt"parser forwarding production: exact child union invalid row={row} kind={Int32(kind)} arm={armIndex} owner={ownerRow} span={spanStart}:{spanEnd} union={exactSpanStart}:{exactSpanEnd} child_start={childStart} child_count={childCount} anchor_token={anchorToken}"
            return false
        if !parserForwardingProductionChildContractValid(
               tree, row, kind, armIndex):
            err = Fmt"parser forwarding production: child contract invalid row={row}"
            return false
    if expectedChildStart != tree.forwardingProductionChildCount:
        err = "parser forwarding production: child CSR coverage invalid"
        return false
    for childRow in 0..<tree.forwardingProductionCount:
        let ownerRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.forwardingProductionOwnerRows,
            childRow)
        if ownerRow < 0:
            continue
        let cursor = childCursors[ownerRow]
        if cursor < 0 ||
           cursor >= tree.forwardingProductionChildCount ||
           ParserForwardingProductionChildKind(
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.forwardingProductionChildKinds,
                   cursor)) !=
               ParserForwardingProductionChildForwardingProduction ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.forwardingProductionChildRows,
               cursor) != childRow:
            err = Fmt"parser forwarding production: owner child drift row={childRow}"
            return false
        childCursors[ownerRow] = cursor + 1
    for row in 0..<tree.forwardingProductionCount:
        let childStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.forwardingProductionChildStarts, row)
        let childCount = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.forwardingProductionChildCounts, row)
        if childCursors[row] != childStart + childCount:
            err = Fmt"parser forwarding production: child count drift row={row}"
            return false
    err = ""
    return true

fn ParserValueExprAppendDeclarationLexicalScope(
        tree: var ParserValueExprTree,
        kind: ParserDeclarationLexicalScopeKind,
        parentScopeRow: int32,
        ownerDeclarationRow: int32): int32 =
    ParserValueExprTreeEnsureActive(tree)
    if tree.lexicalBindingAuthoritySealed:
        panic("parser lexical binding: sealed tree scope mutation")
    let row = tree.declarationLexicalScopeCount
    if kind == ParserDeclarationLexicalScopeInvalid ||
       parentScopeRow < -1 || parentScopeRow >= row ||
       ownerDeclarationRow < -1 ||
       ownerDeclarationRow >= tree.declarationCount:
        panic("parser declaration: lexical scope authority invalid")
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationLexicalScopeProducerSourceIndexes,
        0)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationLexicalScopeSourceLocalRows,
        row)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.declarationLexicalScopeKinds, Int32(kind))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationLexicalScopeParentRows,
        parentScopeRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationLexicalScopeOwnerDeclarationRows,
        ownerDeclarationRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationLexicalScopeSpanStarts,
        -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationLexicalScopeSpanEnds,
        -1)
    tree.declarationLexicalScopeCount = row + 1
    return row

fn ParserValueExprSetDeclarationLexicalScopeSpanBytes(
        tree: var ParserValueExprTree,
        scopeRow: int32,
        spanStart: int32,
        spanEnd: int32) =
    ParserValueExprTreeEnsureActive(tree)
    if scopeRow < 0 || scopeRow >= tree.declarationLexicalScopeCount ||
       spanStart < 0 || spanEnd < spanStart ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationLexicalScopeSpanStarts,
           scopeRow) != -1 ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationLexicalScopeSpanEnds,
           scopeRow) != -1:
        panic("parser declaration: lexical scope span authority invalid")
    let kind = ParserDeclarationLexicalScopeKind(
        arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeKinds,
            scopeRow))
    if spanEnd == spanStart &&
       kind != ParserDeclarationLexicalScopeSource:
        panic("parser declaration: empty non-source lexical scope")
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.declarationLexicalScopeSpanStarts,
        scopeRow,
        spanStart)
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.declarationLexicalScopeSpanEnds,
        scopeRow,
        spanEnd)

fn ParserValueExprSetDeclarationLexicalScopeSpanTokens(
        tree: var ParserValueExprTree,
        scopeRow: int32,
        tokenStart: int32,
        tokenLimit: int32) =
    if tokenStart < 0 || tokenStart >= tokenLimit ||
       tokenLimit > tree.tokenCount:
        panic("parser declaration: lexical scope token range invalid")
    ParserValueExprSetDeclarationLexicalScopeSpanBytes(
        tree,
        scopeRow,
        ParserValueExprTokenStartAt(tree, tokenStart),
        ParserValueExprTokenEndAt(tree, tokenLimit - 1))

fn ParserValueExprFinalizeTypeDeclarationLexicalScope(
        tree: var ParserValueExprTree,
        scopeRow: int32,
        declarationRow: int32,
        tokenStart: int32,
        tokenLimit: int32) =
    if scopeRow < 0 || scopeRow >= tree.declarationLexicalScopeCount ||
       declarationRow < 0 || declarationRow >= tree.declarationCount ||
       tokenStart < 0 || tokenStart >= tokenLimit ||
       tokenLimit > tree.tokenCount ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationLexicalScopeOwnerDeclarationRows,
           scopeRow) != declarationRow:
        let diagScopeOwner = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeOwnerDeclarationRows,
            scopeRow)
        panic(Fmt"parser declaration: type lexical scope finalize invalid scope={scopeRow} declaration={declarationRow} scope_owner={diagScopeOwner} token_start={tokenStart} token_limit={tokenLimit}")
    let spanEnd = ParserValueExprTokenEndAt(tree, tokenLimit - 1)
    let declarationEnd = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.declarationSpanEnds, declarationRow)
    if spanEnd < declarationEnd:
        panic("parser declaration: type lexical scope shrinks owner")
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.declarationSpanEnds,
        declarationRow,
        spanEnd)
    ParserValueExprSetDeclarationLexicalScopeSpanTokens(
        tree, scopeRow, tokenStart, tokenLimit)

@borrows
fn ParserIdentifierLanguageExported(name: str): bool =
    return name.len > 0 &&
           name[0] >= 'A' && name[0] <= 'Z'

@borrows
fn ParserValueExprDeclarationExportedAt(
        tree: ParserValueExprTree,
        nameTokenIndex: int32): bool =
    var name = ParserValueExprTokenText(tree, nameTokenIndex)
    let exported = name.len > 0 &&
                   name[0] >= 'A' && name[0] <= 'Z'
    os.ReleaseStr(name)
    return exported

@borrows
fn ParserValueExprActiveDeclarationOwner(
        tree: ParserValueExprTree): int32 =
    if tree.activeFunctionDeclarationRow >= 0:
        return tree.activeFunctionDeclarationRow
    if tree.activeConceptTraitDeclarationRow >= 0:
        return tree.activeConceptTraitDeclarationRow
    if tree.activeTypeDeclarationRow >= 0:
        return tree.activeTypeDeclarationRow
    return tree.activeModuleDeclarationRow

fn ParserValueExprAppendDeclaration(
        tree: var ParserValueExprTree,
        kind: ParserDeclarationKind,
        nameTokenIndex: int32,
        ownerDeclarationRow: int32,
        lexicalScopeRow: int32,
        functionRow: int32,
        typeSyntaxRootIndex: int32,
        declarationStartToken: int32,
        declarationEndTokenExclusive: int32,
        mutableFlag: bool): int32 =
    ParserValueExprTreeEnsureActive(tree)
    if tree.lexicalBindingAuthoritySealed:
        panic("parser lexical binding: sealed tree declaration mutation")
    let row = tree.declarationCount
    if kind == ParserDeclarationInvalid || nameTokenIndex < 0 ||
       nameTokenIndex >= tree.tokenCount || declarationStartToken < 0 ||
       declarationStartToken >= declarationEndTokenExclusive ||
       declarationEndTokenExclusive > tree.tokenCount ||
       ownerDeclarationRow < -1 || ownerDeclarationRow >= row ||
       lexicalScopeRow < 0 ||
       lexicalScopeRow >= tree.declarationLexicalScopeCount ||
       functionRow < -1 || functionRow >= tree.declarationFunctionCount ||
       typeSyntaxRootIndex < -1 ||
       typeSyntaxRootIndex >= tree.typeSyntaxCount:
        panic("parser declaration: append authority invalid")
    let sourceLocalRow = row
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.declarationProducerSourceIndexes, 0)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.declarationSourceLocalRows, sourceLocalRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.declarationKinds, Int32(kind))
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.declarationNameTokenIndexes, nameTokenIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.declarationOwnerRows, ownerDeclarationRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.declarationLexicalScopeRows, lexicalScopeRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.declarationFunctionRows, functionRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationTypeSyntaxRootIndexes,
        typeSyntaxRootIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationDefaultStatementRootRows,
        -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationGenericSymbolStarts,
        -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationGenericSymbolCounts,
        0)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationSuiteLexicalScopeRows,
        -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationSpanStarts,
        ParserValueExprTokenStartAt(tree, declarationStartToken))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationSpanEnds,
        ParserValueExprTokenEndAt(tree, declarationEndTokenExclusive - 1))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationNameSpanStarts,
        ParserValueExprTokenStartAt(tree, nameTokenIndex))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationNameSpanEnds,
        ParserValueExprTokenEndAt(tree, nameTokenIndex))
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.declarationMutableFlags, mutableFlag ? 1 : 0)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.declarationExportedFlags,
        ParserValueExprDeclarationExportedAt(tree, nameTokenIndex) ? 1 : 0)
    tree.declarationCount = row + 1
    return row

fn ParserValueExprSetDeclarationGenericSymbols(
        tree: var ParserValueExprTree,
        declarationRow: int32,
        symbolStart: int32,
        symbolCount: int32) =
    if declarationRow < 0 || declarationRow >= tree.declarationCount ||
       symbolStart < 0 || symbolCount <= 0 ||
       symbolStart > tree.typeGenericSymbolCount - symbolCount ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationGenericSymbolStarts,
           declarationRow) != -1 ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationGenericSymbolCounts,
           declarationRow) != 0:
        panic("parser declaration: generic symbol CSR invalid")
    let declarationKind = ParserDeclarationKind(
        arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationKinds, declarationRow))
    if declarationKind != ParserDeclarationType &&
       declarationKind != ParserDeclarationFunction &&
       declarationKind != ParserDeclarationConcept &&
       declarationKind != ParserDeclarationTrait:
        panic("parser declaration: generic owner kind invalid")
    for symbolOffset in 0..<symbolCount:
        let symbolRow = symbolStart + symbolOffset
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.typeGenericSymbolOwnerDeclarationRows,
               symbolRow) != -1 ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.typeGenericSymbolOrdinals,
               symbolRow) != symbolOffset:
            panic("parser declaration: generic owner row invalid")
        arenamod.ArenaArrayInt32Set(
            tree.arena,
            tree.typeGenericSymbolOwnerDeclarationRows,
            symbolRow,
            declarationRow)
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.declarationGenericSymbolStarts,
        declarationRow,
        symbolStart)
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.declarationGenericSymbolCounts,
        declarationRow,
        symbolCount)

fn ParserValueExprSetDeclarationSuiteLexicalScope(
        tree: var ParserValueExprTree,
        declarationRow: int32,
        suiteScopeRow: int32) =
    if declarationRow < 0 || declarationRow >= tree.declarationCount ||
       suiteScopeRow < 0 ||
       suiteScopeRow >= tree.declarationLexicalScopeCount ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationSuiteLexicalScopeRows,
           declarationRow) != -1 ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationLexicalScopeOwnerDeclarationRows,
           suiteScopeRow) != declarationRow:
        panic("parser declaration: suite lexical scope invalid")
    let declarationKind = ParserDeclarationKind(
        arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationKinds, declarationRow))
    let scopeKind = ParserDeclarationLexicalScopeKind(
        arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeKinds,
            suiteScopeRow))
    let functionSuite = declarationKind == ParserDeclarationFunction &&
                        scopeKind == ParserDeclarationLexicalScopeFunction
    let conceptTraitSuite =
        (declarationKind == ParserDeclarationConcept ||
         declarationKind == ParserDeclarationTrait) &&
        scopeKind == ParserDeclarationLexicalScopeBlock
    if !functionSuite && !conceptTraitSuite:
        panic("parser declaration: suite owner kind invalid")
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.declarationSuiteLexicalScopeRows,
        declarationRow,
        suiteScopeRow)

@borrows
fn ParserValueExprLexicalBindingHash(
        lexicalScopeRow: int32,
        name: str,
        bucketCount: int32): int32 =
    if lexicalScopeRow < 0 || name == "" || bucketCount <= 0 ||
       (bucketCount & (bucketCount - 1)) != 0:
        return -1
    var hash: int64 = Int64(lexicalScopeRow) + 1
    for index in 0..<name.len:
        hash = (hash * 16777619 + Int64(Int32(name[index])) + 1) %
               2147483647
    return Int32(hash) & (bucketCount - 1)

# [c2-knife] Span hash over the borrowed interned source text.  Byte-
# identical arithmetic to ParserValueExprLexicalBindingHash on the same
# bytes (same seed, multiplier, increment, modulus, mask); the only change
# is the bytes' provenance: the unique interned source view instead of a
# per-call CloneStrRange heap string.
@borrows
fn ParserValueExprLexicalBindingHashSpan(
        tree: ParserValueExprTree,
        sourceTextId: int32,
        spanStart: int32,
        spanEnd: int32,
        lexicalScopeRow: int32,
        bucketCount: int32): int32 =
    if lexicalScopeRow < 0 || spanEnd <= spanStart || bucketCount <= 0 ||
       (bucketCount & (bucketCount - 1)) != 0:
        return -1
    if spanStart < 0:
        panic("parser value expr: source span out of bounds")
    let text = langintern.LookupInternBorrowedText(tree.internPool,
                                                   sourceTextId)
    var hash: int64 = Int64(lexicalScopeRow) + 1
    var index: int32 = spanStart
    while index < spanEnd:
        hash = (hash * 16777619 + Int64(Int32(text[index])) + 1) %
               2147483647
        index = index + 1
    return Int32(hash) & (bucketCount - 1)

# [c2-knife] Span equality over the interned source views.  Identical spans
# are trivially equal; same-text spans compare bytes in the borrowed view;
# distinct interned texts (Fmt-interpolation source split) keep the cloned
# compare on this cold path.
@borrows
fn ParserValueExprNameSpanEqualsSpan(
        tree: ParserValueExprTree,
        sourceTextIdA: int32,
        spanStartA: int32,
        spanEndA: int32,
        sourceTextIdB: int32,
        spanStartB: int32,
        spanEndB: int32): bool =
    if spanStartA == spanStartB && spanEndA == spanEndB &&
       sourceTextIdA == sourceTextIdB:
        return true
    let lengthA = spanEndA - spanStartA
    if lengthA != spanEndB - spanStartB:
        return false
    if sourceTextIdA == sourceTextIdB:
        let text = langintern.LookupInternBorrowedText(tree.internPool,
                                                       sourceTextIdA)
        var index: int32
        while index < lengthA:
            if text[spanStartA + index] != text[spanStartB + index]:
                return false
            index = index + 1
        return true
    return ParserValueExprProjectSpan(tree, sourceTextIdA, spanStartA,
                                      spanEndA) ==
           ParserValueExprProjectSpan(tree, sourceTextIdB, spanStartB,
                                      spanEndB)

@borrows
fn ParserValueExprNameTokenTextEqualsToken(
        tree: ParserValueExprTree,
        nameTokenA: int32,
        nameTokenB: int32): bool =
    if nameTokenA == nameTokenB:
        return true
    return ParserValueExprNameSpanEqualsSpan(
        tree,
        ParserValueExprTokenSourceIdAt(tree, nameTokenA),
        ParserValueExprTokenStartAt(tree, nameTokenA),
        ParserValueExprTokenEndAt(tree, nameTokenA),
        ParserValueExprTokenSourceIdAt(tree, nameTokenB),
        ParserValueExprTokenStartAt(tree, nameTokenB),
        ParserValueExprTokenEndAt(tree, nameTokenB))

# [tg-knife] Token span vs external text equality over the borrowed interned
# source view.  Byte-identical verdict to comparing a CloneStrRange clone of
# the token's own span against `other` (the token's text is by definition its
# span inside its own interned source), with no heap materialization.
@borrows
fn ParserValueExprTokenTextEqualsText(tree: ParserValueExprTree,
                                        tokenIndex: int32,
                                        other: str): bool =
    let spanStart = ParserValueExprTokenStartAt(tree, tokenIndex)
    let spanEnd = ParserValueExprTokenEndAt(tree, tokenIndex)
    let spanLen = spanEnd - spanStart
    if spanLen != other.len:
        return false
    if spanLen == 0:
        return true
    let text = langintern.LookupInternBorrowedText(
        tree.internPool,
        ParserValueExprTokenSourceIdAt(tree, tokenIndex))
    var index: int32
    for index in 0..<spanLen:
        if text[spanStart + index] != other[index]:
            return false
    return true

fn ParserValueExprLexicalBindingRehash(
        tree: var ParserValueExprTree,
        bucketCount: int32) =
    if bucketCount < 32 || (bucketCount & (bucketCount - 1)) != 0:
        panic("parser lexical binding: bucket count invalid")
    var bucketHeads = arenamod.ArenaArrayInt32Init()
    for bucketIndex in 0..<bucketCount:
        arenamod.ArenaArrayInt32Add(tree.arena, bucketHeads, -1)
    for bindingRow in 0..<tree.lexicalBindingCount:
        let scopeRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.lexicalBindingScopeRows, bindingRow)
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.lexicalBindingNameTokenIndexes, bindingRow)
        let bucket = ParserValueExprLexicalBindingHashSpan(
            tree,
            ParserValueExprTokenSourceIdAt(tree, nameToken),
            ParserValueExprTokenStartAt(tree, nameToken),
            ParserValueExprTokenEndAt(tree, nameToken),
            scopeRow,
            bucketCount)
        if bucket < 0:
            panic("parser lexical binding: rehash key invalid")
        arenamod.ArenaArrayInt32Set(
            tree.arena,
            tree.lexicalBindingNextRows,
            bindingRow,
            arenamod.ArenaArrayInt32Get(tree.arena, bucketHeads, bucket))
        arenamod.ArenaArrayInt32Set(
            tree.arena, bucketHeads, bucket, bindingRow)
    tree.lexicalBindingBucketHeads = bucketHeads
    tree.lexicalBindingBucketCount = bucketCount

fn ParserValueExprLexicalBindingEnsureCapacity(
        tree: var ParserValueExprTree) =
    if tree.lexicalBindingBucketCount <= 0:
        ParserValueExprLexicalBindingRehash(tree, 32)
        return
    if (tree.lexicalBindingCount + 1) * 4 >=
           tree.lexicalBindingBucketCount * 3:
        if tree.lexicalBindingBucketCount > 1073741823:
            panic("parser lexical binding: bucket count overflow")
        ParserValueExprLexicalBindingRehash(
            tree, tree.lexicalBindingBucketCount * 2)

@borrows
fn ParserValueExprLexicalBindingVisibleAtNode(
        tree: ParserValueExprTree,
        bindingRow: int32,
        nodeIndex: int32): bool =
    if bindingRow < 0 || bindingRow >= tree.lexicalBindingCount ||
       nodeIndex < 0 || nodeIndex >= tree.nodeCount:
        return false
    let anchorToken = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.lexicalBindingVisibilityAnchorTokenIndexes,
        bindingRow)
    let introductionKind = ParserLexicalBindingIntroductionKind(
        arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.lexicalBindingIntroductionKinds,
            bindingRow))
    if introductionKind ==
           ParserLexicalBindingIntroductionInitializer ||
       introductionKind ==
           ParserLexicalBindingIntroductionPatternIterator:
        return nodeIndex >
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.lexicalBindingIntroductionValueNodeRows,
                   bindingRow)
    if anchorToken < 0 || anchorToken >= tree.tokenCount ||
       ParserValueExprTokenProducerSourceIndexAt(tree, anchorToken) !=
           ParserValueExprNodeProducerSourceIndexAt(tree, nodeIndex):
        return false
    if ParserValueExprTokenSourceIdAt(tree, anchorToken) ==
           ParserValueExprNodeSourceIdAt(tree, nodeIndex):
        return ParserValueExprNodeSpanStartAt(tree, nodeIndex) >=
               ParserValueExprTokenEndAt(tree, anchorToken)
    # Fmt interpolation owns a distinct interned source text while retaining
    # the same producer row. Its exact append frontier remains authoritative.
    return arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.lexicalBindingVisibleFromNodeIndexes,
               bindingRow) <= nodeIndex

@borrows
fn ParserValueExprLexicalBindingFindVisibleSpan(
        tree: ParserValueExprTree,
        lexicalScopeRow: int32,
        sourceTextId: int32,
        spanStart: int32,
        spanEnd: int32,
        nodeIndex: int32): int32 =
    if tree == nil ||
       tree.lifecycleState != ParserValueExprOwnerActive ||
       lexicalScopeRow < 0 ||
       lexicalScopeRow >= tree.declarationLexicalScopeCount ||
       spanEnd <= spanStart || nodeIndex < 0 ||
       nodeIndex >= tree.nodeCount ||
       tree.lexicalBindingBucketCount <= 0:
        return -1
    if spanStart < 0:
        panic("parser value expr: source span out of bounds")
    var scopeRow = lexicalScopeRow
    while scopeRow >= 0:
        let bucket = ParserValueExprLexicalBindingHashSpan(
            tree,
            sourceTextId,
            spanStart,
            spanEnd,
            scopeRow,
            tree.lexicalBindingBucketCount)
        var bindingRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.lexicalBindingBucketHeads, bucket)
        while bindingRow >= 0:
            if arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.lexicalBindingScopeRows,
                   bindingRow) == scopeRow &&
               ParserValueExprLexicalBindingVisibleAtNode(
                   tree, bindingRow, nodeIndex) &&
               ParserValueExprNameSpanEqualsSpan(
                   tree,
                   sourceTextId,
                   spanStart,
                   spanEnd,
                   ParserValueExprTokenSourceIdAt(
                       tree,
                       arenamod.ArenaArrayInt32Get(
                           tree.arena,
                           tree.lexicalBindingNameTokenIndexes,
                           bindingRow)),
                   ParserValueExprTokenStartAt(
                       tree,
                       arenamod.ArenaArrayInt32Get(
                           tree.arena,
                           tree.lexicalBindingNameTokenIndexes,
                           bindingRow)),
                   ParserValueExprTokenEndAt(
                       tree,
                       arenamod.ArenaArrayInt32Get(
                           tree.arena,
                           tree.lexicalBindingNameTokenIndexes,
                           bindingRow))):
                return bindingRow
            bindingRow = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.lexicalBindingNextRows, bindingRow)
        scopeRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeParentRows,
            scopeRow)
    return -1

@borrows
fn ParserValueExprLexicalBindingFindVisible(
        tree: ParserValueExprTree,
        lexicalScopeRow: int32,
        nameToken: int32,
        nodeIndex: int32): int32 =
    if tree == nil ||
       tree.lifecycleState != ParserValueExprOwnerActive ||
       lexicalScopeRow < 0 ||
       lexicalScopeRow >= tree.declarationLexicalScopeCount ||
       nameToken < 0 || nameToken >= tree.tokenCount ||
       nodeIndex < 0 || nodeIndex >= tree.nodeCount ||
       tree.lexicalBindingBucketCount <= 0:
        return -1
    var scopeRow = lexicalScopeRow
    while scopeRow >= 0:
        let bucket = ParserValueExprLexicalBindingHashSpan(
            tree,
            ParserValueExprTokenSourceIdAt(tree, nameToken),
            ParserValueExprTokenStartAt(tree, nameToken),
            ParserValueExprTokenEndAt(tree, nameToken),
            scopeRow,
            tree.lexicalBindingBucketCount)
        var bindingRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.lexicalBindingBucketHeads, bucket)
        while bindingRow >= 0:
            if arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.lexicalBindingScopeRows,
                   bindingRow) == scopeRow &&
               ParserValueExprLexicalBindingVisibleAtNode(
                   tree, bindingRow, nodeIndex) &&
               ParserValueExprNameTokenTextEqualsToken(
                   tree,
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.lexicalBindingNameTokenIndexes,
                       bindingRow),
                   nameToken):
                return bindingRow
            bindingRow = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.lexicalBindingNextRows, bindingRow)
        scopeRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeParentRows,
            scopeRow)
    return -1

@borrows
fn ParserValueExprPendingBindingNameMatches(
        tree: ParserValueExprTree,
        lexicalScopeRow: int32,
        nameToken: int32): bool =
    if tree.activePendingBindingDeclarationStart < 0 ||
       tree.activePendingBindingDeclarationCount <= 0 ||
       tree.activePendingBindingLexicalScopeRow != lexicalScopeRow:
        return false
    let declarationLimit =
        tree.activePendingBindingDeclarationStart +
        tree.activePendingBindingDeclarationCount
    for declarationRow in
            tree.activePendingBindingDeclarationStart..<declarationLimit:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeRows,
               declarationRow) == lexicalScopeRow &&
           ParserValueExprNameTokenTextEqualsToken(
               tree,
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationNameTokenIndexes,
                   declarationRow),
               nameToken):
            return true
    return false

fn ParserValueExprAppendLexicalBinding(
        tree: var ParserValueExprTree,
        declarationRow: int32,
        patternRow: int32,
        introductionKind: ParserLexicalBindingIntroductionKind,
        introductionStatementRootRow: int32,
        introductionValueNodeRow: int32,
        visibilityAnchorTokenIndex: int32,
        err: var str): bool =
    if tree.lexicalBindingAuthoritySealed:
        panic("parser lexical binding: sealed table mutation")
    if declarationRow < 0 || declarationRow >= tree.declarationCount ||
       introductionStatementRootRow < -1 ||
       introductionStatementRootRow >= tree.statementRootCount ||
       introductionValueNodeRow < -1 ||
       introductionValueNodeRow >= tree.nodeCount ||
       introductionKind ==
           ParserLexicalBindingIntroductionInvalid ||
       visibilityAnchorTokenIndex < 0 ||
       visibilityAnchorTokenIndex >= tree.tokenCount:
        err = "parser lexical binding: declaration row invalid"
        return false
    let declarationKind = ParserDeclarationKind(
        arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationKinds, declarationRow))
    let scopeRow = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.declarationLexicalScopeRows, declarationRow)
    let nameToken = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.declarationNameTokenIndexes, declarationRow)
    if declarationKind == ParserDeclarationParameter:
        if patternRow != -1:
            err = "parser lexical binding: parameter owns pattern row"
            return false
    elif declarationKind == ParserDeclarationLocal:
        if patternRow < 0 || patternRow >= tree.patternCount ||
           arenamod.ArenaArrayInt32Get(
               tree.arena, tree.patternKinds, patternRow) !=
               Int32(ParserPatternBinding) ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.patternBindingDeclarationRows,
               patternRow) != declarationRow:
            err = "parser lexical binding: pattern declaration mismatch"
            return false
    else:
        err = "parser lexical binding: declaration kind invalid"
        return false
    ParserValueExprLexicalBindingEnsureCapacity(tree)
    let bucket = ParserValueExprLexicalBindingHashSpan(
        tree,
        ParserValueExprTokenSourceIdAt(tree, nameToken),
        ParserValueExprTokenStartAt(tree, nameToken),
        ParserValueExprTokenEndAt(tree, nameToken),
        scopeRow,
        tree.lexicalBindingBucketCount)
    var existing = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.lexicalBindingBucketHeads, bucket)
    while existing >= 0:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.lexicalBindingScopeRows,
               existing) == scopeRow &&
           ParserValueExprNameTokenTextEqualsToken(
               tree,
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.lexicalBindingNameTokenIndexes,
                   existing),
               nameToken):
            err = Fmt"parser lexical binding: duplicate declaration name={ParserValueExprTokenText(tree, nameToken)} scope={scopeRow}"
            return false
        existing = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.lexicalBindingNextRows, existing)
    let bindingRow = tree.lexicalBindingCount
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.lexicalBindingScopeRows, scopeRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.lexicalBindingNameTokenIndexes, nameToken)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.lexicalBindingDeclarationRows, declarationRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.lexicalBindingPatternRows, patternRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.lexicalBindingVisibleFromNodeIndexes,
        tree.nodeCount)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.lexicalBindingIntroductionKinds,
        Int32(introductionKind))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.lexicalBindingIntroductionStatementRootRows,
        introductionStatementRootRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.lexicalBindingIntroductionValueNodeRows,
        introductionValueNodeRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.lexicalBindingVisibilityAnchorTokenIndexes,
        visibilityAnchorTokenIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.lexicalBindingNextRows,
        arenamod.ArenaArrayInt32Get(
            tree.arena, tree.lexicalBindingBucketHeads, bucket))
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.lexicalBindingBucketHeads,
        bucket,
        bindingRow)
    tree.lexicalBindingCount = bindingRow + 1
    err = ""
    return true

fn ParserValueExprResolveIdentifierBinding(
        tree: var ParserValueExprTree,
        nodeIndex: int32,
        nameTokenIndex: int32,
        err: var str): bool =
    let scopeRow = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.nodeLexicalScopeRows, nodeIndex)
    if ParserValueExprPendingBindingNameMatches(
           tree, scopeRow, nameTokenIndex):
        err = Fmt"parser lexical binding: initializer self-reference name={ParserValueExprTokenText(tree, nameTokenIndex)} scope={scopeRow}"
        return false
    let bindingRow = ParserValueExprLexicalBindingFindVisible(
        tree, scopeRow, nameTokenIndex, nodeIndex)
    if bindingRow < 0:
        err = ""
        return true
    let declarationRow = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.lexicalBindingDeclarationRows, bindingRow)
    let patternRow = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.lexicalBindingPatternRows, bindingRow)
    let resolutionKind =
        patternRow < 0 ?
            ParserValueExprBindingResolutionParameter :
            ParserValueExprBindingResolutionPattern
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.nodeBindingResolutionKinds,
        nodeIndex,
        Int32(resolutionKind))
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.nodeResolvedBindingDeclarationRows,
        nodeIndex,
        declarationRow)
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.nodeResolvedBindingPatternRows,
        nodeIndex,
        patternRow)
    err = ""
    return true

fn ParserValueExprRegisterPatternBindings(
        tree: var ParserValueExprTree,
        patternStart: int32,
        introductionKind: ParserLexicalBindingIntroductionKind,
        introductionStatementRootRow: int32,
        introductionValueNodeRow: int32,
        visibilityAnchorTokenIndex: int32,
        err: var str): bool =
    if patternStart < 0 || patternStart > tree.patternCount:
        err = "parser lexical binding: pattern range invalid"
        return false
    for patternRow in patternStart..<tree.patternCount:
        if ParserPatternKind(arenamod.ArenaArrayInt32Get(
               tree.arena, tree.patternKinds, patternRow)) !=
               ParserPatternBinding:
            continue
        let declarationRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.patternBindingDeclarationRows,
            patternRow)
        if !ParserValueExprAppendLexicalBinding(
               tree,
               declarationRow,
               patternRow,
               introductionKind,
               introductionStatementRootRow,
               introductionValueNodeRow,
               visibilityAnchorTokenIndex,
               err):
            return false
    err = ""
    return true

@borrows
fn ParserValueExprTreeIsActive(tree: ParserValueExprTree): bool =
    return tree != nil &&
           tree.lifecycleState == ParserValueExprOwnerActive

@borrows
fn ParserValueExprTreeLexicalBindingAuthoritySealed(
        tree: ParserValueExprTree): bool =
    return tree != nil &&
           tree.lifecycleState == ParserValueExprOwnerActive &&
           tree.lexicalBindingAuthoritySealed

@borrows
fn ParserValueExprNodeBindingResolutionAt(
        tree: ParserValueExprTree,
        nodeIndex: int32,
        lexicalScopeRowOut: var int32,
        resolutionKindOut: var ParserValueExprBindingResolutionKind,
        declarationRowOut: var int32,
        patternRowOut: var int32): bool =
    lexicalScopeRowOut = -1
    resolutionKindOut = ParserValueExprBindingResolutionNone
    declarationRowOut = -1
    patternRowOut = -1
    if !ParserValueExprTreeLexicalBindingAuthoritySealed(tree) ||
       nodeIndex < 0 || nodeIndex >= tree.nodeCount:
        return false
    lexicalScopeRowOut = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.nodeLexicalScopeRows, nodeIndex)
    resolutionKindOut = ParserValueExprBindingResolutionKind(
        arenamod.ArenaArrayInt32Get(
            tree.arena, tree.nodeBindingResolutionKinds, nodeIndex))
    declarationRowOut = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.nodeResolvedBindingDeclarationRows,
        nodeIndex)
    patternRowOut = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.nodeResolvedBindingPatternRows, nodeIndex)
    return true

@borrows
fn ParserValueExprTreeNodeCount(tree: ParserValueExprTree): int32 =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return 0
    return tree.nodeCount

@borrows
fn ParserValueExprTreeTokenCount(tree: ParserValueExprTree): int32 =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return 0
    return tree.tokenCount

@borrows
fn ParserValueExprTreeCallEventCount(
        tree: ParserValueExprTree): int32 =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return 0
    return tree.callEventCount

@borrows
fn ParserValueExprTreeRootCount(tree: ParserValueExprTree): int32 =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return 0
    return tree.rootCount

@borrows
fn ParserValueExprTreeStatementRootCount(
        tree: ParserValueExprTree): int32 =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return 0
    return tree.statementRootCount

# ---------------------------------------------------------------------------
# [ar2-scratch] AD1 scratch facade (design
# .rebuild/ad1_line/ARENA_ROUTING_DESIGN.md §2.3/§3.3/§3.4).  Thin wrappers
# over existing src/core/runtime/arena.cheng primitives only -- zero new
# runtime surface.  Produce-window transient int32 columns ride the
# per-source scratch arena hung off the tree: one arena block per source
# replaces the allocator-block churn of heap-seq add growth, and every
# handle dies with the tree because the scratch arena is released at every
# tree.arena release point.  Handles are 16-byte values without an arena
# reference, so any use after release fails closed in `arenaRequireLive`.
# Growth policy (design §3.4, lessons.md:194): reserve a provable capacity
# once, then only ParserScratchSeqAdd -- geometric growth on a shared bump
# arena is forbidden.  The arena grows by in-place realloc doubling and
# panics on exhaustion; there is no heap fallback (let-it-crash).
# ParserScratchCopyOutToHeap is the single sanctioned escape back to heap
# seqs.
# ---------------------------------------------------------------------------

fn parserScratchAuditInit() =
    if !parserScratchAuditInitialized:
        parserScratchAuditInitialized = true
        parserScratchAuditEnabled =
            os.GetEnv("CHENG_PARSER_SCRATCH_AUDIT") == "1"

fn parserScratchEnsure(tree: var ParserValueExprTree) =
    if tree.scratchArena.capacityBytes > 0:
        return
    tree.scratchArena = arenamod.ArenaInitDefault(
        ParserValueExprArenaInitialBytes)

@borrows
fn ParserScratchSeqGet(tree: ParserValueExprTree,
                       col: ParserScratchSeqInt32,
                       index: int32): int32 =
    # The arena primitive Get bounds-checks the index but does not
    # re-validate the arena (zero runtime cost by design); the facade owns
    # the fail-closed contract: a handle read after tree release -- or any
    # generation-stale handle -- must panic, never touch freed storage.
    if tree.scratchArena.capacityBytes <= 0 ||
       col.generation != tree.scratchArena.generation:
        panic("parser scratch: stale handle read")
    return arenamod.ArenaArrayInt32Get(tree.scratchArena, col, index)

@borrows
fn ParserScratchSeqLen(tree: ParserValueExprTree,
                       col: ParserScratchSeqInt32): int32 =
    return arenamod.ArenaArrayInt32Len(tree.scratchArena, col)

# Logical shrink only: moves len, never the arena bump cursor, so the
# reserved bytes stay owned by this column until the tree releases.
fn ParserScratchSeqLenTruncate(tree: var ParserValueExprTree,
                               col: var ParserScratchSeqInt32,
                               n: int32) =
    if n < 0 || n > col.len:
        panic("parser scratch: truncate length out of range")
    col.len = n

fn ParserScratchSeqReserve(tree: var ParserValueExprTree,
                           col: var ParserScratchSeqInt32,
                           capacity: int32): bool =
    parserScratchEnsure(tree)
    if !arenamod.ArenaArrayInt32ReserveEmpty(tree.scratchArena, col, capacity):
        return false
    parserScratchAuditInit()
    if parserScratchAuditEnabled && capacity > 0:
        # Poison every reserved slot so a routed-site bug that reads past
        # the written length observes 0xA5A5A5A5 garbage instead of a
        # plausible zero (design §3.3 dynamic escape detector).
        let poisoned: int32 = -1515870811
        var fillIndex: int32
        while fillIndex < capacity:
            arenamod.ArenaArrayInt32AddReserved(tree.scratchArena, col,
                                                poisoned)
            fillIndex = fillIndex + 1
        ParserScratchSeqLenTruncate(tree, col, 0)
    return true

fn ParserScratchSeqAdd(tree: var ParserValueExprTree,
                       col: var ParserScratchSeqInt32,
                       value: int32) =
    parserScratchEnsure(tree)
    arenamod.ArenaArrayInt32AddReserved(tree.scratchArena, col, value)

fn ParserScratchCopyOutToHeap(tree: var ParserValueExprTree,
                              col: ParserScratchSeqInt32,
                              out: var int32[]) =
    let n = arenamod.ArenaArrayInt32Len(tree.scratchArena, col)
    setLen(out, n)
    var copyIndex: int32
    while copyIndex < n:
        out[copyIndex] = ParserScratchSeqGet(tree, col, copyIndex)
        copyIndex = copyIndex + 1

fn parserScratchRelease(tree: var ParserValueExprTree) =
    if tree.scratchArena.capacityBytes <= 0:
        return
    parserScratchAuditInit()
    if parserScratchAuditEnabled:
        if tree.scratchArena.usedBytes > 1048576:
            panic(Fmt"parser scratch audit: per-source scratch bytes over 1MiB used={tree.scratchArena.usedBytes}")
        os.WriteLine(os.Get_stderr(),
                     Fmt"parser_scratch_audit release bytes={tree.scratchArena.usedBytes} capacity={tree.scratchArena.capacityBytes}")
        # Re-poison every byte the arena ever handed out so a bypass read
        # after release observes 0xA5 garbage instead of plausible zeros.
        let refill = arenamod.ArenaAllocBytes(tree.scratchArena,
                                              tree.scratchArena.usedBytes)
        arenamod.ArenaFillBytes(tree.scratchArena, refill, 165)
    arenamod.ArenaRelease(tree.scratchArena)
    if tree.scratchArena.capacityBytes != 0:
        panic("parser scratch: release did not clear storage")

fn ParserValueExprTreeRelease(tree: var ParserValueExprTree) =
    if tree == nil:
        return
    if tree.lifecycleState == ParserValueExprOwnerDiagnosticFailure:
        if tree.ownerAttached || tree.borrowLeaseCount != 0 ||
           tree.arena.capacityBytes <= 0 || tree.internPool == nil:
            panic("parser value expr: diagnostic failure storage split")
        arenamod.ArenaRelease(tree.arena)
        parserScratchRelease(tree)
        langintern.InternPoolRelease(tree.internPool)
        var failureReleaseReceipt: diagnostic_failure.DiagnosticFailureArtifactReleaseReceipt
        diagnostic_failure.DiagnosticFailureArtifactReleaseInto(
            tree.failureArtifact, failureReleaseReceipt)
        tree.lifecycleState = ParserValueExprOwnerReleased
        tree = nil
        return
    if tree.lifecycleState != ParserValueExprOwnerActive:
        panic("parser value expr: owner release outside active lifecycle")
    if !tree.ownerAttached:
        panic("parser value expr: duplicate or borrowed owner release")
    tree.ownerAttached = false
    if tree.borrowLeaseCount == 0:
        arenamod.ArenaRelease(tree.arena)
        parserScratchRelease(tree)
        langintern.InternPoolRelease(tree.internPool)
        tree.lifecycleState = ParserValueExprOwnerReleased
    tree = nil

fn parserValueExprTreeSealDiagnosticFailure(
        tree: var ParserValueExprTree) =
    if tree == nil ||
       tree.lifecycleState != ParserValueExprOwnerActive ||
       !tree.ownerAttached ||
       tree.borrowLeaseCount != 0:
        panic("parser value expr: invalid diagnostic failure transition")
    tree.ownerAttached = false
    tree.lifecycleState = ParserValueExprOwnerDiagnosticFailure

@borrows
fn ParserValueExprTreeFailureAuthorityLeaseBegin(
        tree: ParserValueExprTree): bool =
    if tree == nil ||
       tree.lifecycleState != ParserValueExprOwnerDiagnosticFailure ||
       tree.ownerAttached ||
       tree.borrowLeaseCount != 0 ||
       tree.arena.capacityBytes <= 0 ||
       tree.internPool == nil:
        return false
    tree.borrowLeaseCount = 1
    tree.lifecycleState = ParserValueExprOwnerActive
    return true

@borrows
fn ParserValueExprTreeFailureAuthorityLeaseEnd(
        tree: ParserValueExprTree) =
    if tree == nil ||
       tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.ownerAttached ||
       tree.borrowLeaseCount != 1 ||
       tree.arena.capacityBytes <= 0 ||
       tree.internPool == nil:
        panic("parser value expr: diagnostic authority lease split")
    tree.borrowLeaseCount = 0
    tree.lifecycleState = ParserValueExprOwnerDiagnosticFailure

fn ParserValueExprTreeFailureArtifactMoveInto(
        tree: var ParserValueExprTree,
        out: var diagnostic_failure.DiagnosticFailureArtifact,
        err: var str): bool =
    if tree == nil ||
       tree.lifecycleState != ParserValueExprOwnerDiagnosticFailure:
        err = "parser value expr: diagnostic failure outcome missing"
        return false
    if !diagnostic_failure.DiagnosticFailureArtifactStrictValidateInto(
           tree.failureArtifact, err):
        return false
    diagnostic_failure.DiagnosticFailureArtifactMoveInto(
        out, tree.failureArtifact)
    err = ""
    return true

# Ref-object handle is passed by value. Field extracts are borrow
# projections, so the formal is @borrows; the returned lease is still
# Owned (lease increment), not @borrow_result. `var T` on a ref object
# is an 8-byte pointer slot and lacks authority.
@borrows
fn ParserValueExprTreeBorrow(
        tree: ParserValueExprTree): ParserValueExprTree =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        panic("parser value expr: borrow outside active lifecycle")
    if tree.borrowLeaseCount >= 2147483647:
        panic("parser value expr: borrow lease overflow")
    tree.borrowLeaseCount = tree.borrowLeaseCount + 1
    return tree

@borrows
fn ParserValueExprTreeReleaseBorrow(tree: ParserValueExprTree) =
    if tree == nil:
        panic("parser value expr: missing borrow lease handle")
    if tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.borrowLeaseCount <= 0:
        panic("parser value expr: invalid borrow lease release")
    tree.borrowLeaseCount = tree.borrowLeaseCount - 1
    if tree.borrowLeaseCount == 0 && !tree.ownerAttached:
        arenamod.ArenaRelease(tree.arena)
        parserScratchRelease(tree)
        langintern.InternPoolRelease(tree.internPool)
        if tree.arena.capacityBytes != 0 ||
           tree.internPool.ownerLifecycleState !=
               langintern.InternPoolOwnerReleased:
            panic("parser value expr: final borrow physical release incomplete")
        tree.lifecycleState = ParserValueExprOwnerReleased

fn ParserValueExprTreeClone(tree: var ParserValueExprTree): ParserValueExprTree =
    var out: ParserValueExprTree
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return out
    ParserValueExprTreeAppendFromImpl(out, tree, false)
    return out

fn ParserValueExprTreeAppendFrom(out: var ParserValueExprTree,
                                   sourceTree: var ParserValueExprTree) =
    ParserValueExprTreeAppendFromImpl(out, sourceTree, true)

fn ParserValueExprTreeAppendFromImpl(out: var ParserValueExprTree,
                                      sourceTree: var ParserValueExprTree,
                                      productionCommit: bool) =
    if sourceTree == nil ||
       sourceTree.lifecycleState != ParserValueExprOwnerActive:
        return
    var structuralErr: str
    if !sourceTree.structuralValidationPassed:
        if !ParserValueExprTreeTokensStrictValidateInto(
               sourceTree, structuralErr) ||
           !ParserValueExprTreeTypeSyntaxBracketArgsStrictValidateInto(
               sourceTree, structuralErr) ||
           !ParserValueExprTreeGenericSymbolsStrictValidateInto(
               sourceTree, structuralErr) ||
           !ParserValueExprTreeEnumVariantsStrictValidateInto(
               sourceTree, structuralErr) ||
           !ParserValueExprTreeNodeOriginsStrictValidateInto(
               sourceTree, structuralErr) ||
           !ParserValueExprTreeImportOriginsStrictValidateInto(
               sourceTree, structuralErr) ||
           !ParserValueExprTreeDeclarationsStrictValidateInto(
               sourceTree, structuralErr) ||
           !ParserValueExprTreeStatementRootsStrictValidateInto(
               sourceTree, structuralErr) ||
           !ParserValueExprTreeAnnotationsStrictValidateInto(
               sourceTree, structuralErr) ||
           !ParserValueExprTreePatternsStrictValidateInto(
               sourceTree, structuralErr) ||
           !ParserValueExprTreeForwardingProductionsStrictValidateInto(
               sourceTree, structuralErr) ||
           !ParserValueExprTreeLexicalBindingsStrictValidateInto(
               sourceTree, structuralErr):
            panic(Fmt"parser value expr: invalid structural producer: {structuralErr}")
        if sourceTree.lexicalBindingAuthoritySealed:
            sourceTree.structuralValidationPassed = true
    if productionCommit &&
       (sourceTree.appendCommitCount != 0 ||
        sourceTree.appendNodeVisitCount != 0 ||
        sourceTree.appendTokenVisitCount != 0):
        panic("parser value expr: source tree copied by production commit more than once")
    ParserValueExprTreeEnsureActive(out)
    # Forest append is an atomic rebase transaction: a previously sealed
    # destination is opened only inside this function, fully revalidated, and
    # resealed before control returns.
    out.lexicalBindingAuthoritySealed = false
    if sourceTree.producerSourceCount <= 0:
        panic("parser value expr: producer source rows missing")
    let sourceImportOrigins = sourceTree.importOrigins
    let sourceOffset = out.producerSourceCount
    let nodeOffset = out.nodeCount
    let genericOffset = out.genericCount
    let rootOffset = out.rootCount
    let statementRootOffset = out.statementRootCount
    let tokenOffset = out.tokenCount
    let importDeclarationOffset = out.importOrigins.declarationCount
    let importItemOffset = out.importOrigins.itemCount
    let importModuleTokenOffset = out.importOrigins.moduleTokenCount
    let declarationOffset = out.declarationCount
    let functionOffset = out.declarationFunctionCount
    let declarationScopeOffset = out.declarationLexicalScopeCount
    let regionOffset = out.regionCount
    let patternOffset = out.patternCount
    let patternChildOffset = out.patternChildCount
    let annotationOffset = out.annotationCount
    let annotationArgOffset = out.annotationArgCount
    let annotationArgRootOffset = out.annotationArgRootCount
    let annotationArgChildOffset = out.annotationArgChildCount
    let forwardingProductionOffset = out.forwardingProductionCount
    let forwardingProductionChildOffset =
        out.forwardingProductionChildCount
    out.producerSourceCount = out.producerSourceCount +
                              sourceTree.producerSourceCount
    for genericIndex in 0..<sourceTree.genericCount:
        ParserValueExprAppendGenericSpan(
            out,
            arenamod.ArenaArrayInt32Get(sourceTree.arena,
                                         sourceTree.explicitGenericSpanStarts,
                                         genericIndex),
            arenamod.ArenaArrayInt32Get(sourceTree.arena,
                                         sourceTree.explicitGenericSpanEnds,
                                         genericIndex))
    var remappedSourceIds: int32[]
    for nodeIndex in 0..<sourceTree.nodeCount:
        let sourceId = ParserValueExprNodeSourceIdAt(sourceTree, nodeIndex)
        if sourceId < 0 || sourceId >= sourceTree.producerSourceCount:
            panic("parser value expr: forest source row out of range")
        if sourceId >= remappedSourceIds.len:
            let remapOldLen = remappedSourceIds.len
            setLen(remappedSourceIds, sourceId + 1)
            for fillIndex in remapOldLen..<remappedSourceIds.len:
                remappedSourceIds[fillIndex] = -1
        var remappedSourceId = remappedSourceIds[sourceId]
        if remappedSourceId < 0:
            let sourceLength = ParserValueExprSourceLen(sourceTree,
                                                         sourceId)
            remappedSourceId = langintern.Intern(
                out.internPool,
                strings.CloneStrRange(
                    ParserValueExprSourceText(sourceTree, sourceId),
                    0,
                    sourceLength))
            if remappedSourceId < 0 ||
               remappedSourceId != arenamod.ArenaArrayInt32Len(
                   out.arena, out.sourceTextLengths):
                panic("parser value expr: forest source length column out of lockstep")
            arenamod.ArenaArrayInt32Add(out.arena,
                                         out.sourceTextLengths,
                                         sourceLength)
            remappedSourceIds[sourceId] = remappedSourceId
        var children: int32[]
        var child = ParserValueExprNodeFirstChild(sourceTree, nodeIndex)
        let childCount = ParserValueExprNodeChildCount(sourceTree, nodeIndex)
        var childIndex: int32
        while childIndex < childCount:
            if child < 0 || child >= nodeIndex:
                panic("parser value expr: source tree is not postorder")
            add(children, nodeOffset + child)
            child = ParserValueExprNodeNextSibling(sourceTree, child)
            childIndex = childIndex + 1
        let copiedNode = ParserValueExprAppendNode(
            out,
            remappedSourceId,
            ParserValueExprNodeKindAt(sourceTree, nodeIndex),
            ParserValueExprNodeSpanStartAt(sourceTree, nodeIndex),
            ParserValueExprNodeSpanEndAt(sourceTree, nodeIndex),
            children)
        arenamod.ArenaArrayInt32Set(
            out.arena,
            out.nodeProducerSourceIndexes,
            copiedNode,
            sourceOffset + ParserValueExprNodeProducerSourceIndexAt(
                sourceTree, nodeIndex))
        arenamod.ArenaArrayInt32Set(
            out.arena,
            out.nodeSourceLocalIndexes,
            copiedNode,
            ParserValueExprNodeSourceLocalIndexAt(sourceTree, nodeIndex))
        let sourceNodeScope = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.nodeLexicalScopeRows,
            nodeIndex)
        let sourceResolutionKind = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.nodeBindingResolutionKinds,
            nodeIndex)
        let sourceResolvedDeclaration = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.nodeResolvedBindingDeclarationRows,
            nodeIndex)
        let sourceResolvedPattern = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.nodeResolvedBindingPatternRows,
            nodeIndex)
        arenamod.ArenaArrayInt32Set(
            out.arena,
            out.nodeLexicalScopeRows,
            copiedNode,
            declarationScopeOffset + sourceNodeScope)
        arenamod.ArenaArrayInt32Set(
            out.arena,
            out.nodeBindingResolutionKinds,
            copiedNode,
            sourceResolutionKind)
        arenamod.ArenaArrayInt32Set(
            out.arena,
            out.nodeResolvedBindingDeclarationRows,
            copiedNode,
            sourceResolvedDeclaration < 0 ?
                -1 : declarationOffset + sourceResolvedDeclaration)
        arenamod.ArenaArrayInt32Set(
            out.arena,
            out.nodeResolvedBindingPatternRows,
            copiedNode,
            sourceResolvedPattern < 0 ?
                -1 : patternOffset + sourceResolvedPattern)
        let atomStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.atomStarts, nodeIndex)
        let atomEnd = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.atomEnds, nodeIndex)
        if atomStart >= 0:
            ParserValueExprSetNodeAtom(out, copiedNode, atomStart, atomEnd)
        let ownerStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.ownerStarts, nodeIndex)
        let ownerEnd = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.ownerEnds, nodeIndex)
        let nameStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.nameStarts, nodeIndex)
        let nameEnd = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.nameEnds, nodeIndex)
        if ownerStart >= 0 || nameStart >= 0:
            ParserValueExprSetNodeOwnerName(out,
                                             copiedNode,
                                             ownerStart,
                                             ownerEnd,
                                             nameStart,
                                             nameEnd)
        let operatorStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.operatorStarts, nodeIndex)
        let operatorEnd = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.operatorEnds, nodeIndex)
        if operatorStart >= 0:
            ParserValueExprSetNodeOperator(out,
                                            copiedNode,
                                            operatorStart,
                                            operatorEnd)
        let argumentNameStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.argumentNameStarts, nodeIndex)
        let argumentNameEnd = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.argumentNameEnds, nodeIndex)
        if argumentNameStart >= 0:
            ParserValueExprSetNodeArgumentName(out,
                                                copiedNode,
                                                argumentNameStart,
                                                argumentNameEnd)
        let callArgsStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.callArgsStarts, nodeIndex)
        let callArgsEnd = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.callArgsEnds, nodeIndex)
        if callArgsStart >= 0:
            ParserValueExprSetNodeCallArgsSpan(out,
                                                copiedNode,
                                                callArgsStart,
                                                callArgsEnd)
        let sourceGenericStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.explicitGenericStarts, nodeIndex)
        let sourceGenericCount = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.explicitGenericCounts, nodeIndex)
        ParserValueExprSetNodeGenericRange(out,
                                            copiedNode,
                                            genericOffset + sourceGenericStart,
                                            sourceGenericCount)
    for rootIndex in 0..<sourceTree.rootCount:
        let sourceRoot = ParserValueExprRootNodeAt(sourceTree, rootIndex)
        arenamod.ArenaArrayInt32Add(out.arena,
                                     out.rootNodeIndexes,
                                     nodeOffset + sourceRoot)
        out.rootCount = out.rootCount + 1
    for statementRootIndex in 0..<sourceTree.statementRootCount:
        let sourceRoot = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.statementRootNodeIndexes,
            statementRootIndex)
        arenamod.ArenaArrayInt32Add(out.arena,
                                     out.statementRootNodeIndexes,
                                     nodeOffset + sourceRoot)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.statementRootRoles,
            arenamod.ArenaArrayInt32Get(sourceTree.arena,
                                          sourceTree.statementRootRoles,
                                          statementRootIndex))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.statementRootAnchorTokenIndexes,
            tokenOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.statementRootAnchorTokenIndexes,
                statementRootIndex))
        let sourceBindingDeclarationStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.statementRootBindingDeclarationStarts,
            statementRootIndex)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.statementRootBindingDeclarationStarts,
            sourceBindingDeclarationStart < 0 ?
                -1 : declarationOffset + sourceBindingDeclarationStart)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.statementRootBindingDeclarationCounts,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.statementRootBindingDeclarationCounts,
                statementRootIndex))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.statementRootAnchorLineNumbers,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.statementRootAnchorLineNumbers,
                statementRootIndex))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.statementRootAnchorColumnNumbers,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.statementRootAnchorColumnNumbers,
                statementRootIndex))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.statementRootEndLineNumbers,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.statementRootEndLineNumbers,
                statementRootIndex))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.statementRootEndColumnNumbers,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.statementRootEndColumnNumbers,
                statementRootIndex))
        arenamod.ArenaArrayInt32Set(
            out.arena,
            out.nodeStatementRootEventIndexes,
            nodeOffset + sourceRoot,
            out.statementRootCount)
        out.statementRootCount = out.statementRootCount + 1
    for nodeIndex in 0..<sourceTree.nodeCount:
        let sourceRootStart = ParserValueExprNodeArgumentRootStart(
            sourceTree, nodeIndex)
        let sourceRootCount = ParserValueExprNodeArgumentRootCount(
            sourceTree, nodeIndex)
        if sourceRootStart >= 0:
            arenamod.ArenaArrayInt32Set(
                out.arena,
                out.argumentRootStarts,
                nodeOffset + nodeIndex,
                rootOffset + sourceRootStart)
            arenamod.ArenaArrayInt32Set(
                out.arena,
                out.argumentRootCounts,
                nodeOffset + nodeIndex,
                sourceRootCount)
    # Per-source remap cache, same shape as the node loop above.  This loop
    # used to CloneStr + Intern the whole source text of every token
    # (O(tokenCount x source bytes) of malloc/memcpy plus a full-text hash
    # and probe compares).  langintern.Intern looks the text up first and
    # returns the pooled id, so interning each sourceId once at its first
    # sighting keeps both the pool append order and every id value.
    var remappedTokenSourceIds: int32[]
    for tokenIndex in 0..<sourceTree.tokenCount:
        let sourceId = ParserValueExprTokenSourceIdAt(sourceTree, tokenIndex)
        var remappedSourceId: int32 = -1
        if sourceId >= 0:
            if sourceId >= remappedTokenSourceIds.len:
                let tokenRemapOldLen = remappedTokenSourceIds.len
                setLen(remappedTokenSourceIds, sourceId + 1)
                for tokenRemapFill in tokenRemapOldLen..<remappedTokenSourceIds.len:
                    remappedTokenSourceIds[tokenRemapFill] = -1
            remappedSourceId = remappedTokenSourceIds[sourceId]
        if remappedSourceId < 0:
            remappedSourceId = langintern.Intern(
                out.internPool,
                strings.CloneStr(
                    ParserValueExprSourceText(sourceTree, sourceId)))
            if sourceId >= 0:
                remappedTokenSourceIds[sourceId] = remappedSourceId
        let sourceLexicalParentIndex =
            ParserValueExprTokenLexicalParentIndexAt(
                sourceTree, tokenIndex)
        var remappedLexicalParentIndex: int32 = -1
        if sourceLexicalParentIndex >= 0:
            remappedLexicalParentIndex =
                tokenOffset + sourceLexicalParentIndex
        ParserValueExprAppendToken(
            out,
            remappedSourceId,
            ParserValueExprTokenKindAt(sourceTree, tokenIndex),
            ParserValueExprTokenStartAt(sourceTree, tokenIndex),
            ParserValueExprTokenEndAt(sourceTree, tokenIndex),
            arenamod.ArenaArrayInt32Get(sourceTree.arena,
                                         sourceTree.tokenLineNumbers,
                                         tokenIndex),
            arenamod.ArenaArrayInt32Get(sourceTree.arena,
                                         sourceTree.tokenColumnNumbers,
                                         tokenIndex),
            sourceOffset + ParserValueExprTokenProducerSourceIndexAt(
                sourceTree, tokenIndex),
            ParserValueExprTokenSourceLocalIndexAt(
                sourceTree, tokenIndex),
            remappedLexicalParentIndex)
    for declarationRow in 0..<sourceImportOrigins.declarationCount:
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.declarationProducerSourceIndexes,
            sourceOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.declarationProducerSourceIndexes,
                declarationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.declarationSourceLocalRows,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.declarationSourceLocalRows,
                declarationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.declarationKeywordTokenIndexes,
            tokenOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.declarationKeywordTokenIndexes,
                declarationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.declarationSpanStarts,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.declarationSpanStarts,
                declarationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.declarationSpanEnds,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.declarationSpanEnds,
                declarationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.declarationItemStarts,
            importItemOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.declarationItemStarts,
                declarationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.declarationItemCounts,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.declarationItemCounts,
                declarationRow))
        out.importOrigins.declarationCount =
            out.importOrigins.declarationCount + 1
    for itemRow in 0..<sourceImportOrigins.itemCount:
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.itemProducerSourceIndexes,
            sourceOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.itemProducerSourceIndexes,
                itemRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.itemSourceLocalRows,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.itemSourceLocalRows,
                itemRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.itemDeclarationRows,
            importDeclarationOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.itemDeclarationRows,
                itemRow))
        let sourceAliasToken = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceImportOrigins.itemAliasTokenIndexes,
            itemRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.itemAliasTokenIndexes,
            sourceAliasToken < 0 ? -1 : tokenOffset + sourceAliasToken)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.itemSpanStarts,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.itemSpanStarts,
                itemRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.itemSpanEnds,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.itemSpanEnds,
                itemRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.itemModuleTokenStarts,
            importModuleTokenOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.itemModuleTokenStarts,
                itemRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.itemModuleTokenCounts,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.itemModuleTokenCounts,
                itemRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.itemPrefixTokenCounts,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.itemPrefixTokenCounts,
                itemRow))
        out.importOrigins.itemCount = out.importOrigins.itemCount + 1
    for moduleTokenRow in 0..<sourceImportOrigins.moduleTokenCount:
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.importOrigins.moduleTokenIndexes,
            tokenOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceImportOrigins.moduleTokenIndexes,
                moduleTokenRow))
        out.importOrigins.moduleTokenCount =
            out.importOrigins.moduleTokenCount + 1
    let typeSyntaxOffset = out.typeSyntaxCount
    let typeGenericSymbolOffset = out.typeGenericSymbolCount
    for symbolIndex in 0..<sourceTree.typeGenericSymbolCount:
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeGenericSymbolProducerSourceIndexes,
            symbolIndex)
        let declarationOwnerTokenIndex = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeGenericSymbolDeclarationOwnerTokenIndexes,
            symbolIndex)
        let nameTokenIndex = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeGenericSymbolNameTokenIndexes,
            symbolIndex)
        let ordinal = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeGenericSymbolOrdinals,
            symbolIndex)
        let spanStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeGenericSymbolSpanStarts,
            symbolIndex)
        let spanEnd = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeGenericSymbolSpanEnds,
            symbolIndex)
        let ownerDeclarationRow = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeGenericSymbolOwnerDeclarationRows,
            symbolIndex)
        let ownerTypeSyntaxNode = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeGenericSymbolOwnerTypeSyntaxNodeIndexes,
            symbolIndex)
        let constraintTypeSyntaxNode = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeGenericSymbolConstraintTypeSyntaxNodeIndexes,
            symbolIndex)
        let defaultTypeSyntaxNode = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeGenericSymbolDefaultTypeSyntaxNodeIndexes,
            symbolIndex)
        let childStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeGenericSymbolChildStarts,
            symbolIndex)
        let childCount = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeGenericSymbolChildCounts,
            symbolIndex)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= sourceTree.producerSourceCount ||
           declarationOwnerTokenIndex < 0 ||
           declarationOwnerTokenIndex >= sourceTree.tokenCount ||
           nameTokenIndex < 0 || nameTokenIndex >= sourceTree.tokenCount ||
           ordinal < 0 || spanStart < 0 || spanEnd <= spanStart ||
           ownerDeclarationRow < 0 ||
           ownerDeclarationRow >= sourceTree.declarationCount ||
           ownerTypeSyntaxNode < -1 ||
           ownerTypeSyntaxNode >= sourceTree.typeSyntaxCount ||
           constraintTypeSyntaxNode < -1 ||
           constraintTypeSyntaxNode >= sourceTree.typeSyntaxCount ||
           defaultTypeSyntaxNode < -1 ||
           defaultTypeSyntaxNode >= sourceTree.typeSyntaxCount ||
           childStart < 0 || childCount < 0 ||
           childStart >
               sourceTree.typeGenericSymbolChildCount - childCount:
            panic("parser type syntax: generic symbol source row invalid")
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeGenericSymbolProducerSourceIndexes,
            sourceOffset + producerSourceIndex)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeGenericSymbolDeclarationOwnerTokenIndexes,
            tokenOffset + declarationOwnerTokenIndex)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeGenericSymbolNameTokenIndexes,
            tokenOffset + nameTokenIndex)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeGenericSymbolOrdinals,
            ordinal)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeGenericSymbolSpanStarts,
            spanStart)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeGenericSymbolSpanEnds,
            spanEnd)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeGenericSymbolOwnerDeclarationRows,
            declarationOffset + ownerDeclarationRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeGenericSymbolOwnerTypeSyntaxNodeIndexes,
            ownerTypeSyntaxNode < 0 ?
                -1 : typeSyntaxOffset + ownerTypeSyntaxNode)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeGenericSymbolConstraintTypeSyntaxNodeIndexes,
            constraintTypeSyntaxNode < 0 ?
                -1 : typeSyntaxOffset + constraintTypeSyntaxNode)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeGenericSymbolDefaultTypeSyntaxNodeIndexes,
            defaultTypeSyntaxNode < 0 ?
                -1 : typeSyntaxOffset + defaultTypeSyntaxNode)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeGenericSymbolChildStarts,
            out.typeGenericSymbolChildCount)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeGenericSymbolChildCounts,
            childCount)
        for childOffset in 0..<childCount:
            let childTypeSyntaxNode = arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.typeGenericSymbolChildTypeSyntaxNodeIndexes,
                childStart + childOffset)
            if childTypeSyntaxNode < 0 ||
               childTypeSyntaxNode >= sourceTree.typeSyntaxCount:
                panic("parser type syntax: generic child row invalid")
            arenamod.ArenaArrayInt32Add(
                out.arena,
                out.typeGenericSymbolChildTypeSyntaxNodeIndexes,
                typeSyntaxOffset + childTypeSyntaxNode)
            out.typeGenericSymbolChildCount =
                out.typeGenericSymbolChildCount + 1
        out.typeGenericSymbolCount = out.typeGenericSymbolCount + 1
    let typeConstExprOffset = out.typeConstExprCount
    let typeEnumVariantOffset = out.typeEnumVariantCount
    for variantRow in 0..<sourceTree.typeEnumVariantCount:
        let sourceProducerIndex = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeEnumVariantProducerSourceIndexes,
            variantRow)
        let sourceDeclarationOwner = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeEnumVariantDeclarationOwnerNodeIndexes,
            variantRow)
        let sourceDeclarationOwnerToken = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeEnumVariantDeclarationOwnerTokenIndexes,
            variantRow)
        let sourceNameToken = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeEnumVariantNameTokenIndexes,
            variantRow)
        let sourceOrdinal = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeEnumVariantOrdinals,
            variantRow)
        let sourcePayloadTypeSyntaxNode = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeEnumVariantPayloadTypeSyntaxNodeIndexes,
            variantRow)
        if sourceProducerIndex < 0 ||
           sourceProducerIndex >= sourceTree.producerSourceCount ||
           sourceDeclarationOwner < 0 ||
           sourceDeclarationOwner >= sourceTree.typeSyntaxCount ||
           sourceDeclarationOwnerToken < 0 ||
           sourceDeclarationOwnerToken >= sourceTree.tokenCount ||
           sourceNameToken < 0 || sourceNameToken >= sourceTree.tokenCount ||
           sourceOrdinal < 0 || sourcePayloadTypeSyntaxNode < -1 ||
           sourcePayloadTypeSyntaxNode >= sourceTree.typeSyntaxCount:
            panic("parser type syntax: appended enum variant row invalid")
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeEnumVariantProducerSourceIndexes,
            sourceOffset + sourceProducerIndex)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeEnumVariantDeclarationOwnerNodeIndexes,
            typeSyntaxOffset + sourceDeclarationOwner)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeEnumVariantDeclarationOwnerTokenIndexes,
            tokenOffset + sourceDeclarationOwnerToken)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeEnumVariantNameTokenIndexes,
            tokenOffset + sourceNameToken)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeEnumVariantOrdinals,
            sourceOrdinal)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeEnumVariantPayloadTypeSyntaxNodeIndexes,
            sourcePayloadTypeSyntaxNode < 0 ?
                -1 : typeSyntaxOffset + sourcePayloadTypeSyntaxNode)
        out.typeEnumVariantCount = out.typeEnumVariantCount + 1
    for constIndex in 0..<sourceTree.typeConstExprCount:
        let sourceProducerIndex = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeConstExprProducerSourceIndexes,
            constIndex)
        let sourceToken = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeConstExprTokenIndexes,
            constIndex)
        let sourceLeft = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeConstExprLeftChildIndexes,
            constIndex)
        let sourceRight = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeConstExprRightChildIndexes,
            constIndex)
        if sourceProducerIndex < 0 ||
           sourceProducerIndex >= sourceTree.producerSourceCount ||
           sourceToken < 0 || sourceToken >= sourceTree.tokenCount ||
           sourceLeft < -1 || sourceLeft >= constIndex ||
           sourceRight < -1 || sourceRight >= constIndex:
            panic("parser type syntax: appended const AST row invalid")
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeConstExprKinds,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena, sourceTree.typeConstExprKinds, constIndex))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeConstExprProducerSourceIndexes,
            sourceOffset + sourceProducerIndex)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeConstExprTokenIndexes,
            tokenOffset + sourceToken)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeConstExprLeftChildIndexes,
            sourceLeft < 0 ? -1 : typeConstExprOffset + sourceLeft)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeConstExprRightChildIndexes,
            sourceRight < 0 ? -1 : typeConstExprOffset + sourceRight)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeConstExprIntegerValues,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.typeConstExprIntegerValues,
                constIndex))
        out.typeConstExprCount = out.typeConstExprCount + 1
    # Per-source remap cache for the type-syntax loop, same shape as the
    # token loop above.  Every type-syntax row re-cloned and re-interned
    # the whole source text of its source; langintern.Intern looks the text
    # up first and returns the pooled id, so interning each sourceId once at
    # its first sighting keeps the pool append order and every id value.
    var remappedTypeSourceIds: int32[]
    for typeNodeIndex in 0..<sourceTree.typeSyntaxCount:
        let sourceTypeSourceId = ParserValueExprTypeSyntaxSourceIdAt(
            sourceTree, typeNodeIndex)
        var remappedTypeSourceId: int32 = -1
        if sourceTypeSourceId >= 0:
            if sourceTypeSourceId >= remappedTypeSourceIds.len:
                let typeRemapOldLen = remappedTypeSourceIds.len
                setLen(remappedTypeSourceIds, sourceTypeSourceId + 1)
                for typeRemapFill in typeRemapOldLen..<remappedTypeSourceIds.len:
                    remappedTypeSourceIds[typeRemapFill] = -1
            remappedTypeSourceId = remappedTypeSourceIds[sourceTypeSourceId]
        if remappedTypeSourceId < 0:
            remappedTypeSourceId = langintern.Intern(
                out.internPool,
                strings.CloneStr(
                    ParserValueExprSourceText(sourceTree, sourceTypeSourceId)))
            if sourceTypeSourceId >= 0:
                remappedTypeSourceIds[sourceTypeSourceId] = remappedTypeSourceId
        let childStart = out.typeSyntaxChildCount
        let childCount = ParserValueExprTypeSyntaxChildCountAt(
            sourceTree, typeNodeIndex)
        for childOffset in 0..<childCount:
            let sourceChild = ParserValueExprTypeSyntaxChildAt(
                sourceTree, typeNodeIndex, childOffset)
            if sourceChild < 0 || sourceChild >= typeNodeIndex:
                panic("parser type syntax: appended source is not postorder")
            arenamod.ArenaArrayInt32Add(
                out.arena,
                out.typeSyntaxChildNodeIndexes,
                typeSyntaxOffset + sourceChild)
            out.typeSyntaxChildCount = out.typeSyntaxChildCount + 1
        let bracketArgStart = out.typeSyntaxBracketArgCount
        let bracketArgCount = ParserValueExprTypeSyntaxBracketArgCountAt(
            sourceTree, typeNodeIndex)
        for argOffset in 0..<bracketArgCount:
            let sourceArgTypeNode =
                ParserValueExprTypeSyntaxBracketArgTypeNodeAt(
                    sourceTree, typeNodeIndex, argOffset)
            let sourceArgConstRoot =
                ParserValueExprTypeSyntaxBracketArgConstExprRootAt(
                    sourceTree, typeNodeIndex, argOffset)
            if sourceArgTypeNode < -1 ||
               sourceArgTypeNode >= typeNodeIndex ||
               sourceArgConstRoot < -1 ||
               sourceArgConstRoot >= sourceTree.typeConstExprCount ||
               (sourceArgTypeNode >= 0) == (sourceArgConstRoot >= 0):
                panic("parser type syntax: bracket arg authority source row invalid")
            arenamod.ArenaArrayInt32Add(
                out.arena,
                out.typeSyntaxBracketArgTokenStarts,
                tokenOffset + ParserValueExprTypeSyntaxBracketArgTokenStartAt(
                    sourceTree, typeNodeIndex, argOffset))
            arenamod.ArenaArrayInt32Add(
                out.arena,
                out.typeSyntaxBracketArgTokenCounts,
                ParserValueExprTypeSyntaxBracketArgTokenCountAt(
                    sourceTree, typeNodeIndex, argOffset))
            arenamod.ArenaArrayInt32Add(
                out.arena,
                out.typeSyntaxBracketArgTypeNodeIndexes,
                sourceArgTypeNode < 0 ?
                    -1 : typeSyntaxOffset + sourceArgTypeNode)
            arenamod.ArenaArrayInt32Add(
                out.arena,
                out.typeSyntaxBracketArgConstExprRootIndexes,
                sourceArgConstRoot < 0 ?
                    -1 : typeConstExprOffset + sourceArgConstRoot)
            out.typeSyntaxBracketArgCount =
                out.typeSyntaxBracketArgCount + 1
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxKinds,
            Int32(ParserValueExprTypeSyntaxKindAt(
                sourceTree, typeNodeIndex)))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxSourceTextIds,
            remappedTypeSourceId)
        let sourceProducerIndex =
            ParserValueExprTypeSyntaxProducerSourceIndexAt(
                sourceTree, typeNodeIndex)
        let sourceLocalRow =
            ParserValueExprTypeSyntaxSourceLocalRowAt(
                sourceTree, typeNodeIndex)
        let sourceOwnerToken = ParserValueExprTypeSyntaxOwnerTokenAt(
            sourceTree, typeNodeIndex)
        let sourceDeclarationOwnerToken =
            ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                sourceTree, typeNodeIndex)
        let sourceDeclarationOwner =
            ParserValueExprTypeSyntaxDeclarationOwnerAt(
                sourceTree, typeNodeIndex)
        let sourceGenericStart = ParserValueExprTypeSyntaxGenericSymbolStartAt(
            sourceTree, typeNodeIndex)
        let sourceGenericCount = ParserValueExprTypeSyntaxGenericSymbolCountAt(
            sourceTree, typeNodeIndex)
        let sourceNameToken = ParserValueExprTypeSyntaxNameTokenAt(
            sourceTree, typeNodeIndex)
        let sourceQuestionToken =
            ParserValueExprTypeSyntaxQuestionTokenAt(
                sourceTree, typeNodeIndex)
        if sourceProducerIndex < 0 ||
           sourceProducerIndex >= sourceTree.producerSourceCount ||
           sourceLocalRow < 0 ||
           sourceOwnerToken < 0 || sourceOwnerToken >= sourceTree.tokenCount ||
           sourceDeclarationOwnerToken < -1 ||
           sourceDeclarationOwnerToken >= sourceTree.tokenCount ||
           sourceDeclarationOwner < -1 ||
           sourceDeclarationOwner >= sourceTree.typeSyntaxCount ||
           sourceGenericStart < -1 || sourceGenericCount < 0 ||
           (sourceGenericCount == 0) != (sourceGenericStart == -1) ||
           (sourceGenericCount > 0 &&
            sourceGenericStart >
                sourceTree.typeGenericSymbolCount - sourceGenericCount) ||
           sourceNameToken < -1 || sourceNameToken >= sourceTree.tokenCount ||
           sourceQuestionToken < -1 ||
           sourceQuestionToken >= sourceTree.tokenCount:
            panic("parser type syntax: producer source row invalid")
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxProducerSourceIndexes,
            sourceOffset + sourceProducerIndex)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxSourceLocalRows,
            sourceLocalRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxSpanStarts,
            ParserValueExprTypeSyntaxSpanStartAt(
                sourceTree, typeNodeIndex))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxSpanEnds,
            ParserValueExprTypeSyntaxSpanEndAt(
                sourceTree, typeNodeIndex))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxOwnerTokenIndexes,
            tokenOffset + sourceOwnerToken)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxDeclarationOwnerTokenIndexes,
            sourceDeclarationOwnerToken < 0 ?
                -1 : tokenOffset + sourceDeclarationOwnerToken)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxDeclarationOwnerNodeIndexes,
            sourceDeclarationOwner < 0 ?
                -1 : typeSyntaxOffset + sourceDeclarationOwner)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxGenericSymbolStarts,
            sourceGenericStart < 0 ?
                -1 : typeGenericSymbolOffset + sourceGenericStart)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxGenericSymbolCounts,
            sourceGenericCount)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxChildStarts,
            childStart)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxChildCounts,
            childCount)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxBracketArgStarts,
            bracketArgStart)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxBracketArgCounts,
            bracketArgCount)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxNameTokenIndexes,
            sourceNameToken < 0 ? -1 : tokenOffset + sourceNameToken)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxFixedLengths,
            ParserValueExprTypeSyntaxFixedLengthAt(
                sourceTree, typeNodeIndex))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxQuestionTokenIndexes,
            sourceQuestionToken < 0 ?
                -1 : tokenOffset + sourceQuestionToken)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxRootKinds,
            Int32(ParserValueExprTypeSyntaxRootKindAt(
                sourceTree, typeNodeIndex)))
        let sourceVariantStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeSyntaxEnumVariantStarts,
            typeNodeIndex)
        let sourceVariantCount = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.typeSyntaxEnumVariantCounts,
            typeNodeIndex)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxEnumVariantStarts,
            sourceVariantStart < 0 ?
                -1 : typeEnumVariantOffset + sourceVariantStart)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.typeSyntaxEnumVariantCounts,
            sourceVariantCount)
        out.typeSyntaxCount = out.typeSyntaxCount + 1
    for scopeRow in 0..<sourceTree.declarationLexicalScopeCount:
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationLexicalScopeProducerSourceIndexes,
            scopeRow)
        let parentRow = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationLexicalScopeParentRows,
            scopeRow)
        let ownerRow = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationLexicalScopeOwnerDeclarationRows,
            scopeRow)
        let spanStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationLexicalScopeSpanStarts,
            scopeRow)
        let spanEnd = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationLexicalScopeSpanEnds,
            scopeRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationLexicalScopeProducerSourceIndexes,
            sourceOffset + producerSourceIndex)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationLexicalScopeSourceLocalRows,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.declarationLexicalScopeSourceLocalRows,
                scopeRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationLexicalScopeKinds,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.declarationLexicalScopeKinds,
                scopeRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationLexicalScopeParentRows,
            parentRow < 0 ? -1 : declarationScopeOffset + parentRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationLexicalScopeOwnerDeclarationRows,
            ownerRow < 0 ? -1 : declarationOffset + ownerRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationLexicalScopeSpanStarts,
            spanStart)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationLexicalScopeSpanEnds,
            spanEnd)
        out.declarationLexicalScopeCount =
            out.declarationLexicalScopeCount + 1
    for declarationRow in 0..<sourceTree.declarationCount:
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationProducerSourceIndexes,
            declarationRow)
        let sourceLocalRow = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationSourceLocalRows,
            declarationRow)
        let nameTokenIndex = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationNameTokenIndexes,
            declarationRow)
        let ownerRow = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationOwnerRows,
            declarationRow)
        let lexicalScopeRow = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationLexicalScopeRows,
            declarationRow)
        let functionRow = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationFunctionRows,
            declarationRow)
        let typeSyntaxRoot = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationTypeSyntaxRootIndexes,
            declarationRow)
        let defaultStatementRoot = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationDefaultStatementRootRows,
            declarationRow)
        let genericSymbolStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationGenericSymbolStarts,
            declarationRow)
        let genericSymbolCount = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationGenericSymbolCounts,
            declarationRow)
        let suiteScopeRow = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.declarationSuiteLexicalScopeRows,
            declarationRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationProducerSourceIndexes,
            sourceOffset + producerSourceIndex)
        arenamod.ArenaArrayInt32Add(
            out.arena, out.declarationSourceLocalRows, sourceLocalRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationKinds,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.declarationKinds,
                declarationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationNameTokenIndexes,
            tokenOffset + nameTokenIndex)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationOwnerRows,
            ownerRow < 0 ? -1 : declarationOffset + ownerRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationLexicalScopeRows,
            declarationScopeOffset + lexicalScopeRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationFunctionRows,
            functionRow < 0 ? -1 : functionOffset + functionRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationTypeSyntaxRootIndexes,
            typeSyntaxRoot < 0 ? -1 : typeSyntaxOffset + typeSyntaxRoot)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationDefaultStatementRootRows,
            defaultStatementRoot < 0 ?
                -1 : statementRootOffset + defaultStatementRoot)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationGenericSymbolStarts,
            genericSymbolStart < 0 ?
                -1 : typeGenericSymbolOffset + genericSymbolStart)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationGenericSymbolCounts,
            genericSymbolCount)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationSuiteLexicalScopeRows,
            suiteScopeRow < 0 ?
                -1 : declarationScopeOffset + suiteScopeRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationSpanStarts,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.declarationSpanStarts,
                declarationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationSpanEnds,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.declarationSpanEnds,
                declarationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationNameSpanStarts,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.declarationNameSpanStarts,
                declarationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationNameSpanEnds,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.declarationNameSpanEnds,
                declarationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationMutableFlags,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.declarationMutableFlags,
                declarationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.declarationExportedFlags,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.declarationExportedFlags,
                declarationRow))
        out.declarationCount = out.declarationCount + 1
    out.declarationFunctionCount = out.declarationFunctionCount +
                                   sourceTree.declarationFunctionCount
    for patternRow in 0..<sourceTree.patternCount:
        let sourceProducer = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.patternProducerSourceIndexes,
            patternRow)
        let sourceNameToken = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.patternNameTokenIndexes, patternRow)
        let sourceScope = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.patternOwnerLexicalScopeRows,
            patternRow)
        let sourceOwnerKind = ParserPatternOwnerKind(
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.patternOwnerKinds,
                patternRow))
        let sourceOwnerRow = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.patternOwnerRows,
            patternRow)
        let sourceDeclaration = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.patternBindingDeclarationRows,
            patternRow)
        let sourceTypeSyntaxRoot = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.patternTypeSyntaxRootIndexes,
            patternRow)
        let sourceChildStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.patternChildStarts, patternRow)
        let sourceChildCount = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.patternChildCounts, patternRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.patternProducerSourceIndexes,
            sourceOffset + sourceProducer)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.patternSourceLocalRows,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.patternSourceLocalRows,
                patternRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.patternKinds,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena, sourceTree.patternKinds, patternRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.patternNameTokenIndexes,
            sourceNameToken < 0 ? -1 : tokenOffset + sourceNameToken)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.patternOwnerLexicalScopeRows,
            declarationScopeOffset + sourceScope)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.patternOwnerKinds,
            Int32(sourceOwnerKind))
        var remappedOwnerRow: int32 = -1
        if sourceOwnerKind == ParserPatternOwnerRegion:
            remappedOwnerRow = regionOffset + sourceOwnerRow
        elif sourceOwnerKind == ParserPatternOwnerValueNode:
            remappedOwnerRow = nodeOffset + sourceOwnerRow
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.patternOwnerRows,
            remappedOwnerRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.patternBindingDeclarationRows,
            sourceDeclaration < 0 ?
                -1 : declarationOffset + sourceDeclaration)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.patternTypeSyntaxRootIndexes,
            sourceTypeSyntaxRoot < 0 ?
                -1 : typeSyntaxOffset + sourceTypeSyntaxRoot)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.patternSpanStarts,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena, sourceTree.patternSpanStarts, patternRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.patternSpanEnds,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena, sourceTree.patternSpanEnds, patternRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.patternChildStarts,
            patternChildOffset + sourceChildStart)
        arenamod.ArenaArrayInt32Add(
            out.arena, out.patternChildCounts, sourceChildCount)
        for childOffset in 0..<sourceChildCount:
            arenamod.ArenaArrayInt32Add(
                out.arena,
                out.patternChildNodeIndexes,
                patternOffset + arenamod.ArenaArrayInt32Get(
                    sourceTree.arena,
                    sourceTree.patternChildNodeIndexes,
                    sourceChildStart + childOffset))
            out.patternChildCount = out.patternChildCount + 1
        out.patternCount = out.patternCount + 1
    for bindingRow in 0..<sourceTree.lexicalBindingCount:
        let sourceDeclaration = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.lexicalBindingDeclarationRows,
            bindingRow)
        let sourcePattern = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.lexicalBindingPatternRows,
            bindingRow)
        let sourceIntroduction = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.lexicalBindingIntroductionStatementRootRows,
            bindingRow)
        let sourceIntroductionValueNode = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.lexicalBindingIntroductionValueNodeRows,
            bindingRow)
        var bindingErr: str
        if !ParserValueExprAppendLexicalBinding(
               out,
               declarationOffset + sourceDeclaration,
               sourcePattern < 0 ? -1 : patternOffset + sourcePattern,
               ParserLexicalBindingIntroductionKind(
                   arenamod.ArenaArrayInt32Get(
                       sourceTree.arena,
                       sourceTree.lexicalBindingIntroductionKinds,
                       bindingRow)),
               sourceIntroduction < 0 ?
                   -1 : statementRootOffset + sourceIntroduction,
               sourceIntroductionValueNode < 0 ?
                   -1 : nodeOffset + sourceIntroductionValueNode,
               tokenOffset + arenamod.ArenaArrayInt32Get(
                   sourceTree.arena,
                   sourceTree.lexicalBindingVisibilityAnchorTokenIndexes,
                   bindingRow),
               bindingErr):
            panic(Fmt"parser lexical binding: append failed: {bindingErr}")
        arenamod.ArenaArrayInt32Set(
            out.arena,
            out.lexicalBindingVisibleFromNodeIndexes,
            out.lexicalBindingCount - 1,
            nodeOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.lexicalBindingVisibleFromNodeIndexes,
                bindingRow))
    for annotationRow in 0..<sourceTree.annotationCount:
        let sourceProducer = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.annotationProducerSourceIndexes,
            annotationRow)
        let sourceNameToken = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.annotationNameTokenIndexes,
            annotationRow)
        let sourceTargetToken = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.annotationTargetTokenIndexes,
            annotationRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationProducerSourceIndexes,
            sourceOffset + sourceProducer)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationSourceLocalRows,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.annotationSourceLocalRows,
                annotationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationNameTokenIndexes,
            tokenOffset + sourceNameToken)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationTargetTokenIndexes,
            tokenOffset + sourceTargetToken)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationSpanStarts,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.annotationSpanStarts,
                annotationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationSpanEnds,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.annotationSpanEnds,
                annotationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationArgRootStarts,
            annotationArgRootOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.annotationArgRootStarts,
                annotationRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationArgRootCounts,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.annotationArgRootCounts,
                annotationRow))
        out.annotationCount = out.annotationCount + 1
    for rootRow in 0..<sourceTree.annotationArgRootCount:
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationArgRootNodeIndexes,
            annotationArgOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.annotationArgRootNodeIndexes,
                rootRow))
        out.annotationArgRootCount = out.annotationArgRootCount + 1
    for argRow in 0..<sourceTree.annotationArgCount:
        let sourceToken = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.annotationArgTokenIndexes,
            argRow)
        let sourceSeparator = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.annotationArgSeparatorTokenIndexes,
            argRow)
        let sourceChildStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.annotationArgChildStarts,
            argRow)
        let sourceChildCount = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.annotationArgChildCounts,
            argRow)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationArgProducerSourceIndexes,
            sourceOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.annotationArgProducerSourceIndexes,
                argRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationArgSourceLocalRows,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.annotationArgSourceLocalRows,
                argRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationArgOwnerRows,
            annotationOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.annotationArgOwnerRows,
                argRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationArgKinds,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.annotationArgKinds,
                argRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationArgTokenIndexes,
            tokenOffset + sourceToken)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationArgSeparatorTokenIndexes,
            sourceSeparator < 0 ? -1 : tokenOffset + sourceSeparator)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationArgSpanStarts,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.annotationArgSpanStarts,
                argRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationArgSpanEnds,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.annotationArgSpanEnds,
                argRow))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationArgChildStarts,
            annotationArgChildOffset + sourceChildStart)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.annotationArgChildCounts,
            sourceChildCount)
        for childOffset in 0..<sourceChildCount:
            arenamod.ArenaArrayInt32Add(
                out.arena,
                out.annotationArgChildNodeIndexes,
                annotationArgOffset + arenamod.ArenaArrayInt32Get(
                    sourceTree.arena,
                    sourceTree.annotationArgChildNodeIndexes,
                    sourceChildStart + childOffset))
            out.annotationArgChildCount =
                out.annotationArgChildCount + 1
        out.annotationArgCount = out.annotationArgCount + 1
    # Regions copy after tokens: the anchor is a token index, so it must be
    # remapped by tokenOffset and the bounds check in AppendRegion requires
    # the destination tokens to exist first (previously copied before the
    # token loop with the raw source anchor, which panicked on first append).
    # Per-source remap cache for the region loop, same shape as the token and
    # type-syntax loops above.  Every region row used to CloneStr + Intern the
    # whole source text of its region source (O(regionCount x source bytes) of
    # malloc/memcpy plus a full-text hash and probe compares per row).
    # langintern.Intern looks the text up first and returns the pooled id, so
    # interning each sourceId once at its first sighting keeps both the pool
    # append order and every id value.  Negative source ids skip the cache and
    # take the exact old path.
    var remappedRegionSourceIds: int32[]
    for regionIndex in 0..<sourceTree.regionCount:
        let regionSourceId = arenamod.ArenaArrayInt32Get(
            sourceTree.arena, sourceTree.regionSourceTextIds, regionIndex)
        var remappedRegionSourceId: int32 = -1
        if regionSourceId >= 0:
            if regionSourceId >= remappedRegionSourceIds.len:
                let regionRemapOldLen = remappedRegionSourceIds.len
                setLen(remappedRegionSourceIds, regionSourceId + 1)
                for regionRemapFill in regionRemapOldLen..<remappedRegionSourceIds.len:
                    remappedRegionSourceIds[regionRemapFill] = -1
            remappedRegionSourceId = remappedRegionSourceIds[regionSourceId]
        if remappedRegionSourceId < 0:
            remappedRegionSourceId = langintern.Intern(
                out.internPool,
                strings.CloneStr(
                    ParserValueExprSourceText(
                        sourceTree, regionSourceId)))
            if regionSourceId >= 0:
                remappedRegionSourceIds[regionSourceId] = remappedRegionSourceId
        ParserValueExprAppendRegion(
            out,
            ParserValueExprRegionKind(arenamod.ArenaArrayInt32Get(
                sourceTree.arena, sourceTree.regionKinds, regionIndex)),
            remappedRegionSourceId,
            arenamod.ArenaArrayInt32Get(sourceTree.arena,
                                         sourceTree.regionSpanStarts,
                                         regionIndex),
            arenamod.ArenaArrayInt32Get(sourceTree.arena,
                                         sourceTree.regionSpanEnds,
                                         regionIndex),
            tokenOffset +
                arenamod.ArenaArrayInt32Get(
                    sourceTree.arena,
                    sourceTree.regionAnchorTokenIndexes,
                    regionIndex))
    for row in 0..<sourceTree.forwardingProductionCount:
        let sourceOwner = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.forwardingProductionOwnerRows,
            row)
        let authorityKind = ParserForwardingProductionChildKind(
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.forwardingProductionAuthorityKinds,
                row))
        let authorityRow = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.forwardingProductionAuthorityRows,
            row)
        let annotationStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.forwardingProductionAnnotationStarts,
            row)
        let childStart = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.forwardingProductionChildStarts,
            row)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionProducerSourceIndexes,
            sourceOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.forwardingProductionProducerSourceIndexes,
                row))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionSourceLocalRows,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.forwardingProductionSourceLocalRows,
                row))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionKinds,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.forwardingProductionKinds,
                row))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionArmIndexes,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.forwardingProductionArmIndexes,
                row))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionOwnerRows,
            sourceOwner < 0 ?
                -1 : forwardingProductionOffset + sourceOwner)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionAnchorTokenIndexes,
            tokenOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.forwardingProductionAnchorTokenIndexes,
                row))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionSpanStartTokenIndexes,
            tokenOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.forwardingProductionSpanStartTokenIndexes,
                row))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionSpanEndTokenIndexes,
            tokenOffset + arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.forwardingProductionSpanEndTokenIndexes,
                row))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionSpanStarts,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.forwardingProductionSpanStarts,
                row))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionSpanEnds,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.forwardingProductionSpanEnds,
                row))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionAuthorityKinds,
            Int32(authorityKind))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionAuthorityRows,
            parserForwardingProductionChildRowRebase(
                authorityKind,
                authorityRow,
                forwardingProductionOffset,
                nodeOffset,
                statementRootOffset,
                regionOffset,
                tokenOffset,
                declarationOffset,
                patternOffset,
                annotationOffset,
                declarationScopeOffset,
                typeSyntaxOffset))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionAnnotationStarts,
            annotationStart < 0 ? -1 : annotationOffset + annotationStart)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionAnnotationCounts,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.forwardingProductionAnnotationCounts,
                row))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionChildStarts,
            childStart < 0 ?
                -1 : forwardingProductionChildOffset + childStart)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionChildCounts,
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.forwardingProductionChildCounts,
                row))
        out.forwardingProductionCount =
            out.forwardingProductionCount + 1
    for childIndex in 0..<sourceTree.forwardingProductionChildCount:
        let childKind = ParserForwardingProductionChildKind(
            arenamod.ArenaArrayInt32Get(
                sourceTree.arena,
                sourceTree.forwardingProductionChildKinds,
                childIndex))
        let childRow = arenamod.ArenaArrayInt32Get(
            sourceTree.arena,
            sourceTree.forwardingProductionChildRows,
            childIndex)
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionChildKinds,
            Int32(childKind))
        arenamod.ArenaArrayInt32Add(
            out.arena,
            out.forwardingProductionChildRows,
            parserForwardingProductionChildRowRebase(
                childKind,
                childRow,
                forwardingProductionOffset,
                nodeOffset,
                statementRootOffset,
                regionOffset,
                tokenOffset,
                declarationOffset,
                patternOffset,
                annotationOffset,
                declarationScopeOffset,
                typeSyntaxOffset))
        out.forwardingProductionChildCount =
            out.forwardingProductionChildCount + 1
    out.forwardingProductionsSealed = true
    if !ParserValueExprTreeTokensStrictValidateInto(out, structuralErr):
        panic(Fmt"parser value expr: invalid appended token identity: {structuralErr}")
    if !ParserValueExprTreeImportOriginsStrictValidateInto(
           out, structuralErr):
        panic(Fmt"parser import origin: invalid appended forest: {structuralErr}")
    if !ParserValueExprTreeGenericSymbolsStrictValidateInto(
           out, structuralErr):
        panic(Fmt"parser type syntax: invalid appended generic parameters: {structuralErr}")
    if !ParserValueExprTreeDeclarationsStrictValidateInto(out, structuralErr):
        panic(Fmt"parser declaration: invalid appended forest: {structuralErr}")
    if !ParserValueExprTreeStatementRootsStrictValidateInto(
           out, structuralErr):
        panic(Fmt"parser value expr: invalid appended statement roots: {structuralErr}")
    if !ParserValueExprTreeAnnotationsStrictValidateInto(
           out, structuralErr):
        panic(Fmt"parser annotation: invalid appended forest: {structuralErr}")
    if !ParserValueExprTreePatternsStrictValidateInto(out, structuralErr):
        panic(Fmt"parser pattern: invalid appended forest: {structuralErr}")
    if !ParserValueExprTreeForwardingProductionsStrictValidateInto(
           out, structuralErr):
        panic(Fmt"parser forwarding production: invalid appended forest: {structuralErr}")
    if !ParserValueExprTreeLexicalBindingsStrictValidateInto(
           out, structuralErr):
        panic(Fmt"parser lexical binding: invalid appended forest: {structuralErr}")
    if productionCommit:
        sourceTree.appendCommitCount = 1
        sourceTree.appendNodeVisitCount = Int64(sourceTree.nodeCount)
        sourceTree.appendTokenVisitCount = Int64(sourceTree.tokenCount)
        out.appendCommitCount = out.appendCommitCount + 1
        out.appendNodeVisitCount = out.appendNodeVisitCount +
                                   Int64(sourceTree.nodeCount)
        out.appendTokenVisitCount = out.appendTokenVisitCount +
                                    Int64(sourceTree.tokenCount)
    else:
        sourceTree.cloneNodeVisitCount = sourceTree.cloneNodeVisitCount +
                                         Int64(sourceTree.nodeCount)
        sourceTree.cloneTokenVisitCount = sourceTree.cloneTokenVisitCount +
                                          Int64(sourceTree.tokenCount)
        out.cloneNodeVisitCount = sourceTree.cloneNodeVisitCount
        out.cloneTokenVisitCount = sourceTree.cloneTokenVisitCount
    out.lexicalBindingAuthoritySealed = true

@borrows
fn ParserValueExprTreeLogicalBytes(tree: ParserValueExprTree): int64 =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return Int64(0)
    let scalarBytes = Int64(tree.nodeCount) * Int64(31 * 4) +
                      Int64(tree.genericCount) * Int64(2 * 4) +
                      Int64(tree.rootCount + tree.callEventCount) * Int64(4) +
                      Int64(tree.statementRootCount) * Int64(9 * 4) +
                      Int64(tree.regionCount) * Int64(5 * 4) +
                      Int64(tree.typeSyntaxCount) * Int64(20 * 4) +
                      Int64(tree.typeSyntaxChildCount) * Int64(4) +
                      Int64(tree.typeSyntaxBracketArgCount) * Int64(4 * 4) +
                      Int64(tree.typeGenericSymbolCount) * Int64(12 * 4) +
                      Int64(tree.typeGenericSymbolChildCount) * Int64(4) +
                      Int64(tree.typeEnumVariantCount) * Int64(6 * 4) +
                      Int64(tree.typeConstExprCount) * Int64(6 * 4) +
                      Int64(tree.typeConstModuleNameTokens.len) *
                          Int64(3 * 4) +
                      Int64(tree.declarationCount) * Int64(18 * 4) +
                      Int64(tree.declarationLexicalScopeCount) * Int64(7 * 4) +
                      Int64(tree.lexicalBindingCount) * Int64(10 * 4) +
                      Int64(tree.lexicalBindingBucketCount) * Int64(4) +
                      Int64(tree.patternCount) * Int64(13 * 4) +
                      Int64(tree.patternChildCount) * Int64(4) +
                      Int64(tree.annotationCount) * Int64(8 * 4) +
                      Int64(tree.annotationArgRootCount) * Int64(4) +
                      Int64(tree.annotationArgCount) * Int64(10 * 4) +
                      Int64(tree.annotationArgChildCount) * Int64(4) +
                      Int64(tree.forwardingProductionCount) *
                          Int64(16 * 4) +
                      Int64(tree.forwardingProductionChildCount) *
                          Int64(2 * 4) +
                      Int64(tree.tokenCount) * Int64(9 * 4)
    return scalarBytes +
           langintern.InternPoolLogicalPayloadBytes(tree.internPool)

@borrows
fn ParserValueExprTreeRetainedBytes(tree: ParserValueExprTree): int64 =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return Int64(0)
    let internBytes = langintern.InternPoolRetainedBytes(tree.internPool)
    return Int64(arenamod.ArenaCapacity(tree.arena)) +
           internBytes.structuredBytes + internBytes.logicalPayloadBytes

@borrows
fn ParserValueExprTreeBorrowLeaseCount(tree: ParserValueExprTree): int32 =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return 0
    return tree.borrowLeaseCount

@borrows
fn ParserValueExprTreeAppendCommitCount(tree: ParserValueExprTree): int32 =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return 0
    return tree.appendCommitCount

@borrows
fn ParserValueExprTreeAppendNodeVisitCount(tree: ParserValueExprTree): int64 =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return Int64(0)
    return tree.appendNodeVisitCount

@borrows
fn ParserValueExprTreeAppendTokenVisitCount(tree: ParserValueExprTree): int64 =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return Int64(0)
    return tree.appendTokenVisitCount

@borrows
fn ParserValueExprTreeCloneNodeVisitCount(tree: ParserValueExprTree): int64 =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return Int64(0)
    return tree.cloneNodeVisitCount

@borrows
fn ParserValueExprTreeCloneTokenVisitCount(tree: ParserValueExprTree): int64 =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return Int64(0)
    return tree.cloneTokenVisitCount

@borrows
fn ParserValueExprTreeRequireSingleProductionCommitCopy(
        tree: ParserValueExprTree) =
    if tree == nil:
        return
    if tree.lifecycleState != ParserValueExprOwnerActive:
        panic("parser value expr: commit-copy audit outside active lifecycle")
    if tree.appendNodeVisitCount > Int64(tree.nodeCount) ||
       tree.appendTokenVisitCount > Int64(tree.tokenCount):
        panic("parser value expr: node/token copied more than once by production commit")

@borrows
fn ParserValueExprRequireNode(tree: ParserValueExprTree,
                                nodeIndex: int32) =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       nodeIndex < 0 || nodeIndex >= tree.nodeCount:
        panic("parser value expr: node index out of bounds")

@borrows
fn ParserValueExprNodeProducerSourceIndexAt(
        tree: ParserValueExprTree,
        nodeIndex: int32): int32 =
    ParserValueExprRequireNode(tree, nodeIndex)
    return arenamod.ArenaArrayInt32Get(
        tree.arena, tree.nodeProducerSourceIndexes, nodeIndex)

@borrows
fn ParserValueExprNodeSourceLocalIndexAt(
        tree: ParserValueExprTree,
        nodeIndex: int32): int32 =
    ParserValueExprRequireNode(tree, nodeIndex)
    return arenamod.ArenaArrayInt32Get(
        tree.arena, tree.nodeSourceLocalIndexes, nodeIndex)

@borrows
fn ParserValueExprTreeNodeOriginsStrictValidateInto(
        tree: ParserValueExprTree,
        err: var str): bool =
    err = ""
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.producerSourceCount <= 0 ||
       tree.nodeCount < 0 || tree.statementRootCount < 0 ||
       tree.nodeProducerSourceIndexes.len != tree.nodeCount ||
       tree.nodeSourceLocalIndexes.len != tree.nodeCount ||
       tree.firstChilds.len != tree.nodeCount ||
       tree.childCounts.len != tree.nodeCount ||
       tree.nextSiblings.len != tree.nodeCount ||
       tree.parentNodeIndexes.len != tree.nodeCount ||
       tree.nodeStatementRootEventIndexes.len != tree.nodeCount ||
       tree.nodeLexicalScopeRows.len != tree.nodeCount ||
       tree.nodeBindingResolutionKinds.len != tree.nodeCount ||
       tree.nodeResolvedBindingDeclarationRows.len != tree.nodeCount ||
       tree.nodeResolvedBindingPatternRows.len != tree.nodeCount:
        err = "parser value expr: node origin columns invalid"
        return false
    var nextSourceLocalIndexes: int32[]
    setLen(nextSourceLocalIndexes, tree.producerSourceCount)
    var childSeen: bool[]
    setLen(childSeen, tree.nodeCount)
    for nodeIndex in 0..<tree.nodeCount:
        let producerSourceIndex = ParserValueExprNodeProducerSourceIndexAt(
            tree, nodeIndex)
        let sourceLocalIndex = ParserValueExprNodeSourceLocalIndexAt(
            tree, nodeIndex)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= tree.producerSourceCount ||
           sourceLocalIndex != nextSourceLocalIndexes[producerSourceIndex]:
            err = Fmt"parser value expr: node origin domain invalid node={nodeIndex} source={producerSourceIndex} local={sourceLocalIndex}"
            return false
        nextSourceLocalIndexes[producerSourceIndex] = sourceLocalIndex + 1
        let parentIndex = ParserValueExprNodeParentAt(tree, nodeIndex)
        let firstChild = ParserValueExprNodeFirstChild(tree, nodeIndex)
        let childCount = ParserValueExprNodeChildCount(tree, nodeIndex)
        let directStatementRoot =
            ParserValueExprNodeDirectStatementRootEventAt(tree, nodeIndex)
        if parentIndex < -1 || parentIndex >= tree.nodeCount ||
           (parentIndex >= 0 && parentIndex <= nodeIndex) ||
           childCount < 0 ||
           (childCount == 0 && firstChild != -1) ||
           (childCount > 0 &&
            (firstChild < 0 || firstChild >= nodeIndex)) ||
           directStatementRoot < -1 ||
           directStatementRoot >= tree.statementRootCount:
            err = Fmt"parser value expr: node edge domain invalid node={nodeIndex} parent={parentIndex} first_child={firstChild} child_count={childCount} statement_root={directStatementRoot}"
            return false
        var childIndex = firstChild
        for childOrdinal in 0..<childCount:
            if childIndex < 0 || childIndex >= nodeIndex ||
               childSeen[childIndex] ||
               ParserValueExprNodeParentAt(tree, childIndex) != nodeIndex:
                err = Fmt"parser value expr: child authority invalid node={nodeIndex} ordinal={childOrdinal} child={childIndex}"
                return false
            childSeen[childIndex] = true
            let nextSibling =
                ParserValueExprNodeNextSibling(tree, childIndex)
            if childOrdinal + 1 == childCount:
                if nextSibling != -1:
                    err = Fmt"parser value expr: child chain exceeds declared count node={nodeIndex} child={childIndex}"
                    return false
            elif nextSibling < 0 || nextSibling >= nodeIndex:
                err = Fmt"parser value expr: child chain ends before declared count node={nodeIndex} child={childIndex}"
                return false
            childIndex = nextSibling
    for nodeIndex in 0..<tree.nodeCount:
        let parentIndex = ParserValueExprNodeParentAt(tree, nodeIndex)
        let nextSibling = ParserValueExprNodeNextSibling(tree, nodeIndex)
        if parentIndex < 0:
            if childSeen[nodeIndex] || nextSibling != -1:
                err = Fmt"parser value expr: root node has child-edge residue node={nodeIndex}"
                return false
        elif !childSeen[nodeIndex]:
            err = Fmt"parser value expr: parent edge has no exact child-chain owner node={nodeIndex} parent={parentIndex}"
            return false
    err = ""
    return true

@borrows
fn ParserValueExprLexicalScopeFunctionRow(
        tree: ParserValueExprTree,
        lexicalScopeRow: int32): int32 =
    var scopeRow = lexicalScopeRow
    var visited: int32
    while scopeRow >= 0:
        if scopeRow >= tree.declarationLexicalScopeCount ||
           visited >= tree.declarationLexicalScopeCount:
            return -2
        if ParserDeclarationLexicalScopeKind(
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationLexicalScopeKinds,
                   scopeRow)) ==
               ParserDeclarationLexicalScopeFunction:
            let ownerDeclaration = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationLexicalScopeOwnerDeclarationRows,
                scopeRow)
            if ownerDeclaration < 0 ||
               ownerDeclaration >= tree.declarationCount ||
               ParserDeclarationKind(arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationKinds,
                   ownerDeclaration)) != ParserDeclarationFunction:
                return -2
            return arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationFunctionRows,
                ownerDeclaration)
        scopeRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeParentRows,
            scopeRow)
        visited = visited + 1
    return -1

@borrows
fn ParserValueExprTreeLexicalBindingsStrictValidateInto(
        tree: ParserValueExprTree,
        err: var str): bool =
    err = ""
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.lexicalBindingCount < 0 ||
       tree.lexicalBindingScopeRows.len != tree.lexicalBindingCount ||
       tree.lexicalBindingNameTokenIndexes.len != tree.lexicalBindingCount ||
       tree.lexicalBindingDeclarationRows.len != tree.lexicalBindingCount ||
       tree.lexicalBindingPatternRows.len != tree.lexicalBindingCount ||
       tree.lexicalBindingVisibleFromNodeIndexes.len !=
           tree.lexicalBindingCount ||
       tree.lexicalBindingIntroductionKinds.len !=
           tree.lexicalBindingCount ||
       tree.lexicalBindingIntroductionStatementRootRows.len !=
           tree.lexicalBindingCount ||
       tree.lexicalBindingIntroductionValueNodeRows.len !=
           tree.lexicalBindingCount ||
       tree.lexicalBindingVisibilityAnchorTokenIndexes.len !=
           tree.lexicalBindingCount ||
       tree.lexicalBindingNextRows.len != tree.lexicalBindingCount ||
       tree.nodeLexicalScopeRows.len != tree.nodeCount ||
       tree.nodeBindingResolutionKinds.len != tree.nodeCount ||
       tree.nodeResolvedBindingDeclarationRows.len != tree.nodeCount ||
       tree.nodeResolvedBindingPatternRows.len != tree.nodeCount ||
       tree.activePendingBindingDeclarationStart != -1 ||
       tree.activePendingBindingDeclarationCount != 0 ||
       tree.activePendingBindingLexicalScopeRow != -1:
        err = "parser lexical binding: column shape or parse state invalid"
        return false
    if tree.lexicalBindingCount == 0:
        if tree.lexicalBindingBucketCount != 0 ||
           tree.lexicalBindingBucketHeads.len != 0:
            err = "parser lexical binding: empty table owns buckets"
            return false
    elif tree.lexicalBindingBucketCount < 32 ||
         (tree.lexicalBindingBucketCount &
          (tree.lexicalBindingBucketCount - 1)) != 0 ||
         tree.lexicalBindingBucketHeads.len !=
             tree.lexicalBindingBucketCount:
        err = "parser lexical binding: bucket shape invalid"
        return false
    var bindingSeen: bool[]
    setLen(bindingSeen, tree.lexicalBindingCount)
    for bucketIndex in 0..<tree.lexicalBindingBucketCount:
        var bindingRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.lexicalBindingBucketHeads, bucketIndex)
        var chainLength: int32
        while bindingRow >= 0:
            if bindingRow >= tree.lexicalBindingCount ||
               bindingSeen[bindingRow] ||
               chainLength >= tree.lexicalBindingCount:
                err = "parser lexical binding: bucket chain invalid"
                return false
            let scopeRow = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.lexicalBindingScopeRows, bindingRow)
            let nameToken = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.lexicalBindingNameTokenIndexes,
                bindingRow)
            if scopeRow < 0 ||
               scopeRow >= tree.declarationLexicalScopeCount ||
               nameToken < 0 || nameToken >= tree.tokenCount ||
               ParserValueExprLexicalBindingHashSpan(
                   tree,
                   ParserValueExprTokenSourceIdAt(tree, nameToken),
                   ParserValueExprTokenStartAt(tree, nameToken),
                   ParserValueExprTokenEndAt(tree, nameToken),
                   scopeRow,
                   tree.lexicalBindingBucketCount) != bucketIndex:
                err = "parser lexical binding: bucket key mismatch"
                return false
            var duplicateRow = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.lexicalBindingNextRows, bindingRow)
            var duplicateScanCount: int32
            while duplicateRow >= 0 &&
                  duplicateScanCount < tree.lexicalBindingCount:
                if arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.lexicalBindingScopeRows,
                       duplicateRow) == scopeRow &&
                   ParserValueExprNameTokenTextEqualsToken(
                       tree,
                       arenamod.ArenaArrayInt32Get(
                           tree.arena,
                           tree.lexicalBindingNameTokenIndexes,
                           duplicateRow),
                       nameToken):
                    err = "parser lexical binding: duplicate scope/name row"
                    return false
                duplicateRow = arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.lexicalBindingNextRows,
                    duplicateRow)
                duplicateScanCount = duplicateScanCount + 1
            if duplicateRow >= 0:
                err = "parser lexical binding: duplicate scan cycle"
                return false
            bindingSeen[bindingRow] = true
            bindingRow = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.lexicalBindingNextRows, bindingRow)
            chainLength = chainLength + 1
    var declarationBindingSeen: bool[]
    setLen(declarationBindingSeen, tree.declarationCount)
    for bindingRow in 0..<tree.lexicalBindingCount:
        if !bindingSeen[bindingRow]:
            err = "parser lexical binding: row is unreachable"
            return false
        let scopeRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.lexicalBindingScopeRows, bindingRow)
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.lexicalBindingNameTokenIndexes,
            bindingRow)
        let declarationRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.lexicalBindingDeclarationRows,
            bindingRow)
        let patternRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.lexicalBindingPatternRows, bindingRow)
        let visibleFrom = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.lexicalBindingVisibleFromNodeIndexes,
            bindingRow)
        let introductionStatementRoot = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.lexicalBindingIntroductionStatementRootRows,
            bindingRow)
        let introductionKind = ParserLexicalBindingIntroductionKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.lexicalBindingIntroductionKinds,
                bindingRow))
        let introductionValueNode = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.lexicalBindingIntroductionValueNodeRows,
            bindingRow)
        let visibilityAnchorToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.lexicalBindingVisibilityAnchorTokenIndexes,
            bindingRow)
        if declarationRow < 0 ||
           declarationRow >= tree.declarationCount ||
           declarationBindingSeen[declarationRow] ||
           visibleFrom < 0 || visibleFrom > tree.nodeCount ||
           introductionStatementRoot < -1 ||
           introductionStatementRoot >= tree.statementRootCount ||
           introductionKind <=
               ParserLexicalBindingIntroductionInvalid ||
           introductionKind >
               ParserLexicalBindingIntroductionPatternEntry ||
           introductionValueNode < -1 ||
           introductionValueNode >= tree.nodeCount ||
           visibilityAnchorToken < 0 ||
           visibilityAnchorToken >= tree.tokenCount ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationNameTokenIndexes,
               declarationRow) != nameToken ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeRows,
               declarationRow) != scopeRow:
            err = Fmt"parser lexical binding: declaration authority invalid row={bindingRow}"
            return false
        declarationBindingSeen[declarationRow] = true
        let producer = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeProducerSourceIndexes,
            scopeRow)
        if ParserValueExprTokenProducerSourceIndexAt(
               tree, visibilityAnchorToken) != producer:
            err = "parser lexical binding: visibility anchor producer mismatch"
            return false
        let declarationKind = ParserDeclarationKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena, tree.declarationKinds, declarationRow))
        let declarationFunction = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationFunctionRows,
            declarationRow)
        if ParserValueExprLexicalScopeFunctionRow(tree, scopeRow) !=
               declarationFunction:
            err = "parser lexical binding: declaration function mismatch"
            return false
        if declarationKind == ParserDeclarationParameter:
            if patternRow != -1 ||
               introductionKind !=
                   ParserLexicalBindingIntroductionParameterList ||
               introductionStatementRoot != -1 ||
               introductionValueNode != -1 ||
               ParserValueExprTokenKindAt(
                   tree, visibilityAnchorToken) !=
                   ParserValueTokenRightParen ||
               ParserDeclarationLexicalScopeKind(
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.declarationLexicalScopeKinds,
                       scopeRow)) !=
                   ParserDeclarationLexicalScopeFunction:
                err = "parser lexical binding: parameter pattern row invalid"
                return false
        elif declarationKind == ParserDeclarationLocal:
            if patternRow < 0 || patternRow >= tree.patternCount ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena, tree.patternKinds, patternRow) !=
                   Int32(ParserPatternBinding) ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.patternBindingDeclarationRows,
                   patternRow) != declarationRow:
                err = "parser lexical binding: pattern row authority invalid"
                return false
            if arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.patternOwnerLexicalScopeRows,
                   patternRow) != scopeRow:
                err = "parser lexical binding: pattern scope mismatch"
                return false
            if introductionKind ==
                   ParserLexicalBindingIntroductionInitializer:
                if introductionStatementRoot < 0 ||
                   introductionValueNode < 0:
                    err = "parser lexical binding: initializer introduction row missing"
                    return false
                let rootNode = ParserValueExprStatementRootNodeAt(
                    tree, introductionStatementRoot)
                let declarationStart =
                    ParserValueExprStatementRootBindingDeclarationStartAt(
                        tree, introductionStatementRoot)
                let declarationCount =
                    ParserValueExprStatementRootBindingDeclarationCountAt(
                        tree, introductionStatementRoot)
                if ParserValueExprStatementRootRoleAt(
                       tree, introductionStatementRoot) !=
                       ParserValueExprStatementBindingInitializer ||
                   declarationStart < 0 || declarationCount <= 0 ||
                   declarationRow < declarationStart ||
                   declarationRow >= declarationStart + declarationCount ||
                   introductionValueNode != rootNode ||
                   visibleFrom != introductionValueNode + 1 ||
                   ParserValueExprTokenProducerSourceIndexAt(
                       tree, visibilityAnchorToken) !=
                       ParserValueExprNodeProducerSourceIndexAt(
                           tree, rootNode) ||
                   ParserValueExprTokenEndAt(
                       tree, visibilityAnchorToken) <
                       ParserValueExprNodeSpanEndAt(tree, rootNode):
                    err = "parser lexical binding: initializer introduction authority invalid"
                    return false
            elif introductionKind ==
                     ParserLexicalBindingIntroductionDeclaration:
                if introductionStatementRoot != -1 ||
                   introductionValueNode != -1 ||
                   arenamod.ArenaArrayInt32Get(
                     tree.arena,
                     tree.declarationSpanEnds,
                     declarationRow) !=
                     ParserValueExprTokenEndAt(
                         tree, visibilityAnchorToken):
                    err = "parser lexical binding: declaration introduction anchor invalid"
                    return false
            elif introductionKind ==
                     ParserLexicalBindingIntroductionPatternIterator:
                if introductionStatementRoot != -1 ||
                   introductionValueNode < 0 ||
                   visibleFrom != introductionValueNode + 1 ||
                   ParserValueExprNodeProducerSourceIndexAt(
                       tree, introductionValueNode) != producer ||
                   ParserValueExprTokenEndAt(
                       tree, visibilityAnchorToken) <
                       ParserValueExprNodeSpanEndAt(
                           tree, introductionValueNode):
                    err = "parser lexical binding: iterator introduction authority invalid"
                    return false
            elif introductionKind ==
                     ParserLexicalBindingIntroductionPatternEntry:
                if introductionStatementRoot != -1 ||
                   introductionValueNode != -1 ||
                   ParserValueExprTokenEndAt(
                       tree, visibilityAnchorToken) <
                       arenamod.ArenaArrayInt32Get(
                           tree.arena,
                           tree.patternSpanEnds,
                           patternRow):
                    err = "parser lexical binding: pattern entry introduction authority invalid"
                    return false
            else:
                err = "parser lexical binding: local introduction kind invalid"
                return false
        else:
            err = "parser lexical binding: declaration kind invalid"
            return false
    for nodeIndex in 0..<tree.nodeCount:
        let scopeRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.nodeLexicalScopeRows, nodeIndex)
        let resolutionKind = ParserValueExprBindingResolutionKind(
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.nodeBindingResolutionKinds,
                nodeIndex))
        let declarationRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.nodeResolvedBindingDeclarationRows,
            nodeIndex)
        let patternRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.nodeResolvedBindingPatternRows,
            nodeIndex)
        if scopeRow < 0 ||
           scopeRow >= tree.declarationLexicalScopeCount ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeProducerSourceIndexes,
               scopeRow) !=
               ParserValueExprNodeProducerSourceIndexAt(tree, nodeIndex):
            err = Fmt"parser lexical binding: node scope invalid node={nodeIndex}"
            return false
        if ParserValueExprNodeKindAt(tree, nodeIndex) !=
               ParserValueExprIdentifier:
            if resolutionKind != ParserValueExprBindingResolutionNone ||
               declarationRow != -1 || patternRow != -1:
                err = Fmt"parser lexical binding: non-identifier resolved node={nodeIndex}"
                return false
            continue
        let atomStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.atomStarts, nodeIndex)
        let atomEnd = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.atomEnds, nodeIndex)
        var expectedBinding = -1
        if atomEnd > atomStart:
            expectedBinding =
                ParserValueExprLexicalBindingFindVisibleSpan(
                    tree,
                    scopeRow,
                    ParserValueExprNodeSourceIdAt(tree, nodeIndex),
                    atomStart,
                    atomEnd,
                    nodeIndex)
        if expectedBinding < 0:
            if resolutionKind != ParserValueExprBindingResolutionNone ||
               declarationRow != -1 || patternRow != -1:
                err = Fmt"parser lexical binding: unresolved identifier owns rows node={nodeIndex}"
                return false
            continue
        let expectedDeclaration = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.lexicalBindingDeclarationRows,
            expectedBinding)
        let expectedPattern = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.lexicalBindingPatternRows,
            expectedBinding)
        let expectedKind =
            expectedPattern < 0 ?
                ParserValueExprBindingResolutionParameter :
                ParserValueExprBindingResolutionPattern
        if resolutionKind != expectedKind ||
           declarationRow != expectedDeclaration ||
           patternRow != expectedPattern:
            err = Fmt"parser lexical binding: identifier exact row mismatch node={nodeIndex} declaration={declarationRow} expected={expectedDeclaration} pattern={patternRow} expected_pattern={expectedPattern}"
            return false
    err = ""
    return true

@borrows
fn ParserValueExprTreeImportOriginsStrictValidateInto(
        tree: ParserValueExprTree,
        err: var str): bool =
    err = ""
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.importOrigins == nil:
        err = "parser import origin: owner unavailable"
        return false
    let origins = tree.importOrigins
    if origins.declarationCount < 0 || origins.itemCount < 0 ||
       origins.moduleTokenCount < 0 ||
       origins.declarationProducerSourceIndexes.len !=
           origins.declarationCount ||
       origins.declarationSourceLocalRows.len !=
           origins.declarationCount ||
       origins.declarationKeywordTokenIndexes.len !=
           origins.declarationCount ||
       origins.declarationSpanStarts.len !=
           origins.declarationCount ||
       origins.declarationSpanEnds.len !=
           origins.declarationCount ||
       origins.declarationItemStarts.len !=
           origins.declarationCount ||
       origins.declarationItemCounts.len !=
           origins.declarationCount ||
       origins.itemProducerSourceIndexes.len != origins.itemCount ||
       origins.itemSourceLocalRows.len != origins.itemCount ||
       origins.itemDeclarationRows.len != origins.itemCount ||
       origins.itemAliasTokenIndexes.len != origins.itemCount ||
       origins.itemSpanStarts.len != origins.itemCount ||
       origins.itemSpanEnds.len != origins.itemCount ||
       origins.itemModuleTokenStarts.len != origins.itemCount ||
       origins.itemModuleTokenCounts.len != origins.itemCount ||
       origins.itemPrefixTokenCounts.len != origins.itemCount ||
       origins.moduleTokenIndexes.len != origins.moduleTokenCount:
        err = "parser import origin: column shape mismatch"
        return false
    var nextDeclarationRows: int32[]
    var nextItemRows: int32[]
    setLen(nextDeclarationRows, tree.producerSourceCount)
    setLen(nextItemRows, tree.producerSourceCount)
    var itemCursor: int32
    for declarationRow in 0..<origins.declarationCount:
        let producer = arenamod.ArenaArrayInt32Get(
            tree.arena,
            origins.declarationProducerSourceIndexes,
            declarationRow)
        let localRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            origins.declarationSourceLocalRows,
            declarationRow)
        let keywordToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            origins.declarationKeywordTokenIndexes,
            declarationRow)
        let spanStart = arenamod.ArenaArrayInt32Get(
            tree.arena, origins.declarationSpanStarts, declarationRow)
        let spanEnd = arenamod.ArenaArrayInt32Get(
            tree.arena, origins.declarationSpanEnds, declarationRow)
        let itemStart = arenamod.ArenaArrayInt32Get(
            tree.arena, origins.declarationItemStarts, declarationRow)
        let itemCount = arenamod.ArenaArrayInt32Get(
            tree.arena, origins.declarationItemCounts, declarationRow)
        if producer < 0 || producer >= tree.producerSourceCount ||
           localRow != nextDeclarationRows[producer] ||
           keywordToken < 0 || keywordToken >= tree.tokenCount ||
           ParserValueExprTokenProducerSourceIndexAt(
               tree, keywordToken) != producer ||
           ParserValueExprTokenKindAt(tree, keywordToken) !=
               ParserValueTokenImport ||
           !ParserValueExprTokenTextEqualsText(tree, keywordToken, "import") ||
           spanStart != ParserValueExprTokenStartAt(tree, keywordToken) ||
           spanEnd <= spanStart ||
           itemStart != itemCursor || itemCount <= 0 ||
           itemStart > origins.itemCount - itemCount:
            err = "parser import origin: declaration authority invalid"
            return false
        nextDeclarationRows[producer] = localRow + 1
        itemCursor = itemStart + itemCount
    if itemCursor != origins.itemCount:
        err = "parser import origin: declaration item CSR incomplete"
        return false
    var moduleTokenCursor: int32
    for itemRow in 0..<origins.itemCount:
        let producer = arenamod.ArenaArrayInt32Get(
            tree.arena, origins.itemProducerSourceIndexes, itemRow)
        let localRow = arenamod.ArenaArrayInt32Get(
            tree.arena, origins.itemSourceLocalRows, itemRow)
        let declarationRow = arenamod.ArenaArrayInt32Get(
            tree.arena, origins.itemDeclarationRows, itemRow)
        let aliasToken = arenamod.ArenaArrayInt32Get(
            tree.arena, origins.itemAliasTokenIndexes, itemRow)
        let spanStart = arenamod.ArenaArrayInt32Get(
            tree.arena, origins.itemSpanStarts, itemRow)
        let spanEnd = arenamod.ArenaArrayInt32Get(
            tree.arena, origins.itemSpanEnds, itemRow)
        let tokenStart = arenamod.ArenaArrayInt32Get(
            tree.arena, origins.itemModuleTokenStarts, itemRow)
        let tokenCount = arenamod.ArenaArrayInt32Get(
            tree.arena, origins.itemModuleTokenCounts, itemRow)
        let prefixTokenCount = arenamod.ArenaArrayInt32Get(
            tree.arena, origins.itemPrefixTokenCounts, itemRow)
        if producer < 0 || producer >= tree.producerSourceCount ||
           localRow != nextItemRows[producer] ||
           declarationRow < 0 ||
           declarationRow >= origins.declarationCount ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               origins.declarationProducerSourceIndexes,
                   declarationRow) != producer ||
           aliasToken < -1 || aliasToken >= tree.tokenCount ||
           (aliasToken >= 0 &&
            (ParserValueExprTokenProducerSourceIndexAt(
                 tree, aliasToken) != producer ||
             !ParserValueExprTokenCanName(
                 ParserValueExprTokenKindAt(tree, aliasToken)) ||
             ParserValueExprTokenTextEqualsText(tree, aliasToken, "") ||
             aliasToken <= 0 ||
             ParserValueExprTokenKindAt(tree, aliasToken - 1) !=
                 ParserValueTokenIdentifier ||
             !ParserValueExprTokenTextEqualsText(tree, aliasToken - 1,
                                                 "as") ||
             spanEnd !=
                 ParserValueExprTokenEndAt(tree, aliasToken))) ||
           spanStart <
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   origins.declarationSpanStarts,
                   declarationRow) ||
           spanEnd <= spanStart ||
           spanEnd >
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   origins.declarationSpanEnds,
                   declarationRow) ||
           tokenStart != moduleTokenCursor || tokenCount <= 0 ||
           prefixTokenCount < 0 ||
           prefixTokenCount >= tokenCount ||
           tokenStart > origins.moduleTokenCount - tokenCount:
            err = "parser import origin: item authority invalid"
            return false
        for tokenOffset in 0..<tokenCount:
            let tokenIndex = arenamod.ArenaArrayInt32Get(
                tree.arena,
                origins.moduleTokenIndexes,
                tokenStart + tokenOffset)
            if tokenIndex < 0 || tokenIndex >= tree.tokenCount ||
               ParserValueExprTokenProducerSourceIndexAt(
                   tree, tokenIndex) != producer ||
               !ParserValueExprTokenCanName(
                   ParserValueExprTokenKindAt(tree, tokenIndex)) ||
               ParserValueExprTokenTextEqualsText(tree, tokenIndex, ""):
                err = "parser import origin: module token invalid"
                return false
        let lastModuleToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            origins.moduleTokenIndexes,
            tokenStart + tokenCount - 1)
        let keywordToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            origins.declarationKeywordTokenIndexes,
            declarationRow)
        let declarationItemStart = arenamod.ArenaArrayInt32Get(
            tree.arena,
            origins.declarationItemStarts,
            declarationRow)
        let declarationItemCount = arenamod.ArenaArrayInt32Get(
            tree.arena,
            origins.declarationItemCounts,
            declarationRow)
        let itemOffset = itemRow - declarationItemStart
        if itemOffset < 0 || itemOffset >= declarationItemCount:
            err = "parser import origin: item declaration CSR mismatch"
            return false
        let firstModuleToken = arenamod.ArenaArrayInt32Get(
            tree.arena, origins.moduleTokenIndexes, tokenStart)
        let firstSuffixToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            origins.moduleTokenIndexes,
            tokenStart + prefixTokenCount)
        for moduleOffset in 1..<tokenCount:
            if moduleOffset == prefixTokenCount:
                continue
            let previousToken = arenamod.ArenaArrayInt32Get(
                tree.arena,
                origins.moduleTokenIndexes,
                tokenStart + moduleOffset - 1)
            let nextToken = arenamod.ArenaArrayInt32Get(
                tree.arena,
                origins.moduleTokenIndexes,
                tokenStart + moduleOffset)
            if nextToken != previousToken + 2 ||
               ParserValueExprTokenKindAt(tree, previousToken + 1) !=
                   ParserValueTokenSlash ||
               !ParserValueExprTokenTextEqualsText(tree,
                                                   previousToken + 1, "/"):
                err = "parser import origin: module token adjacency invalid"
                return false
        if prefixTokenCount == 0:
            if declarationItemCount != 1 || itemOffset != 0 ||
               firstModuleToken != keywordToken + 1 ||
               spanStart !=
                   ParserValueExprTokenStartAt(tree, firstModuleToken) ||
               ((aliasToken < 0 &&
                 (spanEnd !=
                      ParserValueExprTokenEndAt(
                          tree, lastModuleToken) ||
                  arenamod.ArenaArrayInt32Get(
                      tree.arena,
                      origins.declarationSpanEnds,
                      declarationRow) != spanEnd)) ||
                (aliasToken >= 0 &&
                 (aliasToken != lastModuleToken + 2 ||
                  ParserValueExprTokenText(
                      tree, lastModuleToken + 1) != "as" ||
                  spanEnd !=
                      ParserValueExprTokenEndAt(tree, aliasToken) ||
                  arenamod.ArenaArrayInt32Get(
                      tree.arena,
                      origins.declarationSpanEnds,
                      declarationRow) != spanEnd))):
                err = "parser import origin: simple surface replay failed"
                return false
        else:
            let lastPrefixToken = arenamod.ArenaArrayInt32Get(
                tree.arena,
                origins.moduleTokenIndexes,
                tokenStart + prefixTokenCount - 1)
            if aliasToken != -1 || firstModuleToken != keywordToken + 1 ||
               (itemOffset == 0 &&
                (lastPrefixToken + 3 != firstSuffixToken ||
                 ParserValueExprTokenKindAt(tree, lastPrefixToken + 1) !=
                     ParserValueTokenSlash ||
                 ParserValueExprTokenText(
                     tree, lastPrefixToken + 1) != "/" ||
                 ParserValueExprTokenKindAt(tree, lastPrefixToken + 2) !=
                     ParserValueTokenLeftBracket ||
                 ParserValueExprTokenText(
                     tree, lastPrefixToken + 2) != "[")) ||
               spanStart !=
                   ParserValueExprTokenStartAt(tree, firstSuffixToken) ||
               spanEnd !=
                   ParserValueExprTokenEndAt(tree, lastModuleToken):
                err = "parser import origin: grouped surface replay failed"
                return false
            if itemOffset > 0:
                let previousTokenStart = arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    origins.itemModuleTokenStarts,
                    itemRow - 1)
                let previousTokenCount = arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    origins.itemModuleTokenCounts,
                    itemRow - 1)
                let previousLastToken = arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    origins.moduleTokenIndexes,
                    previousTokenStart + previousTokenCount - 1)
                if firstSuffixToken != previousLastToken + 2 ||
                   ParserValueExprTokenKindAt(
                       tree, previousLastToken + 1) !=
                       ParserValueTokenComma ||
                   ParserValueExprTokenText(
                       tree, previousLastToken + 1) != ",":
                    err = "parser import origin: grouped item boundary invalid"
                    return false
                for prefixOffset in 0..<prefixTokenCount:
                    if arenamod.ArenaArrayInt32Get(
                           tree.arena,
                           origins.moduleTokenIndexes,
                           tokenStart + prefixOffset) !=
                       arenamod.ArenaArrayInt32Get(
                           tree.arena,
                           origins.moduleTokenIndexes,
                           previousTokenStart + prefixOffset):
                        err = "parser import origin: grouped prefix drift"
                        return false
            if itemOffset + 1 == declarationItemCount:
                if lastModuleToken + 1 >= tree.tokenCount ||
                   ParserValueExprTokenKindAt(
                       tree, lastModuleToken + 1) !=
                       ParserValueTokenRightBracket ||
                   ParserValueExprTokenText(
                       tree, lastModuleToken + 1) != "]" ||
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       origins.declarationSpanEnds,
                       declarationRow) !=
                       ParserValueExprTokenEndAt(
                           tree, lastModuleToken + 1):
                    err = "parser import origin: grouped close boundary invalid"
                    return false
            elif lastModuleToken + 1 >= tree.tokenCount ||
                 ParserValueExprTokenKindAt(
                     tree, lastModuleToken + 1) !=
                     ParserValueTokenComma ||
                 ParserValueExprTokenText(
                     tree, lastModuleToken + 1) != ",":
                err = "parser import origin: grouped separator missing"
                return false
        nextItemRows[producer] = localRow + 1
        moduleTokenCursor = tokenStart + tokenCount
    if moduleTokenCursor != origins.moduleTokenCount:
        err = "parser import origin: module token CSR incomplete"
        return false
    err = ""
    return true

@borrows
fn ParserValueExprTreeDeclarationsStrictValidateInto(
        tree: ParserValueExprTree,
        err: var str): bool =
    err = ""
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.producerSourceCount <= 0 || tree.declarationCount < 0 ||
       tree.declarationFunctionCount < 0 ||
       tree.declarationProducerSourceIndexes.len != tree.declarationCount ||
       tree.declarationSourceLocalRows.len != tree.declarationCount ||
       tree.declarationKinds.len != tree.declarationCount ||
       tree.declarationNameTokenIndexes.len != tree.declarationCount ||
       tree.declarationOwnerRows.len != tree.declarationCount ||
       tree.declarationLexicalScopeRows.len != tree.declarationCount ||
       tree.declarationFunctionRows.len != tree.declarationCount ||
       tree.declarationTypeSyntaxRootIndexes.len != tree.declarationCount ||
       tree.declarationDefaultStatementRootRows.len !=
           tree.declarationCount ||
       tree.declarationGenericSymbolStarts.len != tree.declarationCount ||
       tree.declarationGenericSymbolCounts.len != tree.declarationCount ||
       tree.declarationSuiteLexicalScopeRows.len != tree.declarationCount ||
       tree.declarationSpanStarts.len != tree.declarationCount ||
       tree.declarationSpanEnds.len != tree.declarationCount ||
       tree.declarationNameSpanStarts.len != tree.declarationCount ||
       tree.declarationNameSpanEnds.len != tree.declarationCount ||
       tree.declarationMutableFlags.len != tree.declarationCount ||
       tree.declarationExportedFlags.len != tree.declarationCount:
        err = "parser declaration: column shape mismatch"
        return false
    if tree.declarationLexicalScopeCount <= 0 ||
       tree.declarationLexicalScopeProducerSourceIndexes.len !=
           tree.declarationLexicalScopeCount ||
       tree.declarationLexicalScopeSourceLocalRows.len !=
           tree.declarationLexicalScopeCount ||
       tree.declarationLexicalScopeKinds.len !=
           tree.declarationLexicalScopeCount ||
       tree.declarationLexicalScopeParentRows.len !=
           tree.declarationLexicalScopeCount ||
       tree.declarationLexicalScopeOwnerDeclarationRows.len !=
           tree.declarationLexicalScopeCount ||
       tree.declarationLexicalScopeSpanStarts.len !=
           tree.declarationLexicalScopeCount ||
       tree.declarationLexicalScopeSpanEnds.len !=
           tree.declarationLexicalScopeCount:
        err = "parser declaration: lexical scope shape mismatch"
        return false
    var nextScopeSourceLocalRows: int32[]
    setLen(nextScopeSourceLocalRows, tree.producerSourceCount)
    for scopeRow in 0..<tree.declarationLexicalScopeCount:
        let scopeProducer = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeProducerSourceIndexes,
            scopeRow)
        let scopeLocal = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeSourceLocalRows,
            scopeRow)
        let scopeKind = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationLexicalScopeKinds, scopeRow)
        let parent = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationLexicalScopeParentRows, scopeRow)
        let scopeOwner = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeOwnerDeclarationRows,
            scopeRow)
        let scopeStart = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeSpanStarts,
            scopeRow)
        let scopeEnd = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeSpanEnds,
            scopeRow)
        if scopeProducer < 0 || scopeProducer >= tree.producerSourceCount ||
           scopeLocal != nextScopeSourceLocalRows[scopeProducer] ||
           scopeKind < Int32(ParserDeclarationLexicalScopeSource) ||
           scopeKind > Int32(ParserDeclarationLexicalScopeBlock) ||
           parent < -1 || parent >= scopeRow || scopeOwner < -1 ||
           scopeOwner >= tree.declarationCount ||
           scopeStart < 0 || scopeEnd < scopeStart ||
           (scopeEnd == scopeStart &&
            scopeKind != Int32(ParserDeclarationLexicalScopeSource)) ||
           (scopeKind == Int32(ParserDeclarationLexicalScopeSource) &&
            (parent != -1 || scopeOwner != -1 || scopeStart != 0)):
            err = "parser declaration: lexical scope authority invalid"
            return false
        if parent >= 0:
            let parentProducer = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationLexicalScopeProducerSourceIndexes,
                parent)
            let parentStart = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationLexicalScopeSpanStarts,
                parent)
            let parentEnd = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationLexicalScopeSpanEnds,
                parent)
            if parentProducer != scopeProducer ||
               parentStart > scopeStart || parentEnd < scopeEnd:
                err = "parser declaration: lexical scope parent span mismatch"
                return false
        if scopeOwner >= 0:
            let ownerProducer = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationProducerSourceIndexes,
                scopeOwner)
            let ownerStart = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationSpanStarts,
                scopeOwner)
            let ownerEnd = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationSpanEnds,
                scopeOwner)
            if ownerProducer != scopeProducer ||
               ownerStart > scopeStart || ownerEnd < scopeEnd:
                err = "parser declaration: lexical scope owner span mismatch"
                return false
        nextScopeSourceLocalRows[scopeProducer] = scopeLocal + 1
    var nextSourceLocalRows: int32[]
    var functionDeclarationSeen: bool[]
    setLen(nextSourceLocalRows, tree.producerSourceCount)
    setLen(functionDeclarationSeen, tree.declarationFunctionCount)
    for row in 0..<tree.declarationCount:
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationProducerSourceIndexes, row)
        let sourceLocalRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationSourceLocalRows, row)
        let kind = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationKinds, row)
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationNameTokenIndexes, row)
        let owner = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationOwnerRows, row)
        let scope = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationLexicalScopeRows, row)
        let functionRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationFunctionRows, row)
        let typeRoot = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationTypeSyntaxRootIndexes, row)
        let defaultStatementRoot = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationDefaultStatementRootRows,
            row)
        let genericStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationGenericSymbolStarts, row)
        let genericCount = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationGenericSymbolCounts, row)
        let suiteScope = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationSuiteLexicalScopeRows, row)
        let spanStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationSpanStarts, row)
        let spanEnd = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationSpanEnds, row)
        let nameStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationNameSpanStarts, row)
        let nameEnd = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationNameSpanEnds, row)
        let mutableFlag = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationMutableFlags, row)
        let exportedFlag = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationExportedFlags, row)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= tree.producerSourceCount ||
           sourceLocalRow != nextSourceLocalRows[producerSourceIndex] ||
           kind < Int32(ParserDeclarationModule) ||
           kind > Int32(ParserDeclarationTrait) ||
           nameToken < 0 || nameToken >= tree.tokenCount ||
           owner < -1 || owner >= row || scope < 0 ||
           scope >= tree.declarationLexicalScopeCount ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeProducerSourceIndexes,
               scope) != producerSourceIndex ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeSpanStarts,
               scope) > spanStart ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeSpanEnds,
               scope) < spanEnd ||
           functionRow < -1 ||
           functionRow >= tree.declarationFunctionCount ||
           typeRoot < -1 || typeRoot >= tree.typeSyntaxCount ||
           defaultStatementRoot < -1 ||
           defaultStatementRoot >= tree.statementRootCount ||
           (kind != Int32(ParserDeclarationParameter) &&
            defaultStatementRoot != -1) ||
           genericStart < -1 || genericCount < 0 ||
           (genericCount == 0 && genericStart != -1) ||
           (genericCount > 0 &&
            (genericStart < 0 ||
             genericStart >
                 tree.typeGenericSymbolCount - genericCount)) ||
           suiteScope < -1 ||
           suiteScope >= tree.declarationLexicalScopeCount ||
           spanStart < 0 || spanEnd <= spanStart ||
           nameStart < spanStart || nameEnd <= nameStart ||
           nameEnd > spanEnd ||
           nameStart != ParserValueExprTokenStartAt(tree, nameToken) ||
           nameEnd != ParserValueExprTokenEndAt(tree, nameToken) ||
           (mutableFlag != 0 && mutableFlag != 1) ||
           (exportedFlag != 0 && exportedFlag != 1) ||
           exportedFlag !=
               (ParserValueExprDeclarationExportedAt(tree, nameToken) ? 1 : 0):
            err = Fmt"parser declaration: row authority invalid row={row} producer={producerSourceIndex} local={sourceLocalRow} kind={kind} name_token={nameToken} owner={owner} scope={scope} function={functionRow} type_root={typeRoot} default_root={defaultStatementRoot} generic={genericStart}+{genericCount} suite_scope={suiteScope} span={spanStart}..{spanEnd} name_span={nameStart}..{nameEnd} mutable={mutableFlag} exported={exportedFlag}"
            return false
        let ownerKind = owner < 0 ? Int32(ParserDeclarationInvalid) :
            arenamod.ArenaArrayInt32Get(
                tree.arena, tree.declarationKinds, owner)
        if (kind == Int32(ParserDeclarationModule) &&
            (owner != -1 || functionRow != -1 ||
             typeRoot != -1 || mutableFlag != 0)) ||
           (kind == Int32(ParserDeclarationType) &&
            (typeRoot < 0 ||
             (owner >= 0 &&
              ownerKind != Int32(ParserDeclarationModule) &&
              ownerKind != Int32(ParserDeclarationType) &&
              ownerKind != Int32(ParserDeclarationFunction) &&
              ownerKind != Int32(ParserDeclarationConcept) &&
              ownerKind != Int32(ParserDeclarationTrait)))) ||
           (kind == Int32(ParserDeclarationFunction) &&
            (functionRow < 0 ||
             (owner >= 0 &&
              ownerKind != Int32(ParserDeclarationModule) &&
              ownerKind != Int32(ParserDeclarationType) &&
              ownerKind != Int32(ParserDeclarationFunction) &&
              ownerKind != Int32(ParserDeclarationConcept) &&
              ownerKind != Int32(ParserDeclarationTrait)))) ||
           (kind == Int32(ParserDeclarationField) &&
            (owner < 0 || ownerKind != Int32(ParserDeclarationType) ||
             functionRow != -1 || typeRoot < 0)) ||
           (kind == Int32(ParserDeclarationParameter) &&
            (owner < 0 || ownerKind != Int32(ParserDeclarationFunction) ||
             functionRow < 0)) ||
           (kind == Int32(ParserDeclarationLocal) &&
            ((functionRow >= 0 &&
              (owner < 0 ||
               ownerKind != Int32(ParserDeclarationFunction))) ||
             (functionRow < 0 && owner >= 0 &&
              ownerKind != Int32(ParserDeclarationModule) &&
              ownerKind != Int32(ParserDeclarationType) &&
              ownerKind != Int32(ParserDeclarationConcept) &&
              ownerKind != Int32(ParserDeclarationTrait)))) ||
           ((kind == Int32(ParserDeclarationConcept) ||
             kind == Int32(ParserDeclarationTrait)) &&
            (functionRow != -1 || typeRoot != -1 || mutableFlag != 0 ||
             (owner >= 0 &&
              ownerKind != Int32(ParserDeclarationModule) &&
              ownerKind != Int32(ParserDeclarationType) &&
              ownerKind != Int32(ParserDeclarationFunction) &&
              ownerKind != Int32(ParserDeclarationConcept) &&
              ownerKind != Int32(ParserDeclarationTrait)))):
            err = Fmt"parser declaration: owner domain invalid row={row}"
            return false
        let functionDeclaration =
            kind == Int32(ParserDeclarationFunction)
        let conceptTraitDeclaration =
            kind == Int32(ParserDeclarationConcept) ||
            kind == Int32(ParserDeclarationTrait)
        if functionDeclaration && suiteScope >= 0:
            if arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationLexicalScopeOwnerDeclarationRows,
                   suiteScope) != row ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationLexicalScopeKinds,
                   suiteScope) !=
                   Int32(ParserDeclarationLexicalScopeFunction):
                err = Fmt"parser declaration: function suite owner invalid row={row}"
                return false
        elif conceptTraitDeclaration:
            if suiteScope < 0 ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationLexicalScopeOwnerDeclarationRows,
                   suiteScope) != row ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationLexicalScopeKinds,
                   suiteScope) !=
                   Int32(ParserDeclarationLexicalScopeBlock):
                err = Fmt"parser declaration: concept/trait suite owner invalid row={row}"
                return false
        elif suiteScope != -1:
            err = Fmt"parser declaration: non-suite declaration edge invalid row={row}"
            return false
        if genericCount > 0:
            if kind != Int32(ParserDeclarationType) &&
               kind != Int32(ParserDeclarationFunction) &&
               kind != Int32(ParserDeclarationConcept) &&
               kind != Int32(ParserDeclarationTrait):
                err = Fmt"parser declaration: generic owner kind invalid row={row}"
                return false
            for genericOffset in 0..<genericCount:
                let genericRow = genericStart + genericOffset
                if ParserValueExprTypeGenericSymbolOwnerDeclarationAt(
                       tree, genericRow) != row ||
                   ParserValueExprTypeGenericSymbolOrdinalAt(
                       tree, genericRow) != genericOffset:
                    err = Fmt"parser declaration: generic owner CSR invalid row={row} symbol={genericRow}"
                    return false
        if kind == Int32(ParserDeclarationFunction):
            if functionDeclarationSeen[functionRow]:
                err = "parser declaration: duplicate function row"
                return false
            functionDeclarationSeen[functionRow] = true
        nextSourceLocalRows[producerSourceIndex] = sourceLocalRow + 1
    for functionRow in 0..<functionDeclarationSeen.len:
        if !functionDeclarationSeen[functionRow]:
            err = "parser declaration: function row has no declaration"
            return false
    # A type declaration and its parser-owned TypeSyntax root are a
    # one-to-one identity join.  Keeping this proof in the parser tree (not
    # only in the projected receipt) makes clone/append and every production
    # consumer reject exchanged, duplicated, or deleted declaration roots
    # before semantic lowering can observe them.
    var typeDeclarationRootSeen: bool[]
    setLen(typeDeclarationRootSeen, tree.typeSyntaxCount)
    var typeDeclarationCount: int32
    for declarationRow in 0..<tree.declarationCount:
        let declarationKind = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationKinds, declarationRow)
        let declarationRoot = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationTypeSyntaxRootIndexes,
            declarationRow)
        if declarationKind == Int32(ParserDeclarationType):
            typeDeclarationCount = typeDeclarationCount + 1
            let declarationProducer = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationProducerSourceIndexes,
                declarationRow)
            let declarationNameToken = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationNameTokenIndexes,
                declarationRow)
            if declarationRoot < 0 ||
               declarationRoot >= tree.typeSyntaxCount ||
               ParserValueExprTypeSyntaxRootKindAt(
                   tree, declarationRoot) !=
                   ParserTypeSyntaxRootTypeDeclarationRhs ||
               ParserValueExprTypeSyntaxProducerSourceIndexAt(
                   tree, declarationRoot) != declarationProducer ||
               ParserValueExprTokenProducerSourceIndexAt(
                   tree, declarationNameToken) != declarationProducer ||
               ParserValueExprTypeSyntaxOwnerTokenAt(
                   tree, declarationRoot) != declarationNameToken ||
               ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
                   tree, declarationRoot) != declarationNameToken ||
               ParserValueExprTypeSyntaxDeclarationOwnerAt(
                   tree, declarationRoot) != declarationRoot ||
               typeDeclarationRootSeen[declarationRoot]:
                err = Fmt"parser declaration: type root join invalid row={declarationRow}"
                return false
            typeDeclarationRootSeen[declarationRoot] = true
        elif declarationRoot >= 0 &&
             declarationRoot < tree.typeSyntaxCount &&
             ParserValueExprTypeSyntaxRootKindAt(
                 tree, declarationRoot) ==
                 ParserTypeSyntaxRootTypeDeclarationRhs:
            err = Fmt"parser declaration: non-type owns type root row={declarationRow}"
            return false
    var typeDeclarationRootCount: int32
    for typeRow in 0..<tree.typeSyntaxCount:
        if ParserValueExprTypeSyntaxRootKindAt(tree, typeRow) ==
               ParserTypeSyntaxRootTypeDeclarationRhs:
            typeDeclarationRootCount = typeDeclarationRootCount + 1
            if !typeDeclarationRootSeen[typeRow]:
                err = Fmt"parser declaration: unbound type root row={typeRow}"
                return false
    if typeDeclarationRootCount != typeDeclarationCount:
        err = "parser declaration: type root coverage mismatch"
        return false
    err = ""
    return true

# Build a source-line lookup from the canonical declaration rows and exact
# name-token identities.  It is used only to prevent the legacy NormalizedExpr
# assignment scanner from emitting a second producer for a type declaration;
# no source text, declared name, or line-based semantic identity is recovered.
# B6: flags cover every line carrying a token inside a Type declaration span
# (header + field rows, e.g. compact tuple `field: T = default`).  The
# declaration rows own the exact token spans, so the extension is span-derived,
# not a line-text heuristic.
@borrows
fn ParserValueExprTypeDeclarationHeaderLineFlagsInto(
        tree: ParserValueExprTree,
        lineCount: int32,
        flags: var bool[],
        err: var str): bool =
    setLen(flags, 0)
    if lineCount < 0 ||
       !ParserValueExprTreeDeclarationsStrictValidateInto(tree, err):
        if err == "":
            err = "parser declaration: type header lookup owner invalid"
        return false
    setLen(flags, lineCount)
    var b6TypeSpanStarts: int32[]
    var b6TypeSpanEnds: int32[]
    for declarationRow in 0..<tree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               declarationRow) != Int32(ParserDeclarationType):
            continue
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationNameTokenIndexes,
            declarationRow)
        let lineNumber = ParserValueExprTokenLineAt(tree, nameToken)
        if lineNumber <= 0 || lineNumber > lineCount ||
           flags[lineNumber - 1]:
            err = Fmt"parser declaration: type header line identity invalid row={declarationRow} line={lineNumber}"
            return false
        flags[lineNumber - 1] = true
        add(b6TypeSpanStarts, arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationSpanStarts,
            declarationRow))
        add(b6TypeSpanEnds, arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationSpanEnds,
            declarationRow))
    for tokenIndex in 0..<tree.tokenCount:
        let b6TokenStart = ParserValueExprTokenStartAt(tree, tokenIndex)
        var b6SpanHit = false
        for b6SpanIndex in 0..<b6TypeSpanStarts.len:
            if b6TokenStart >= b6TypeSpanStarts[b6SpanIndex] &&
               b6TokenStart < b6TypeSpanEnds[b6SpanIndex]:
                b6SpanHit = true
                break
        if !b6SpanHit:
            continue
        let b6TokenLine = ParserValueExprTokenLineAt(tree, tokenIndex)
        if b6TokenLine <= 0 || b6TokenLine > lineCount:
            continue
        flags[b6TokenLine - 1] = true
    err = ""
    return true

@borrows
fn ParserValueExprTreeStatementRootsStrictValidateInto(
        tree: ParserValueExprTree,
        err: var str): bool =
    err = ""
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.statementRootCount < 0 ||
       tree.statementRootNodeIndexes.len != tree.statementRootCount ||
       tree.statementRootRoles.len != tree.statementRootCount ||
       tree.statementRootAnchorTokenIndexes.len != tree.statementRootCount ||
       tree.statementRootBindingDeclarationStarts.len !=
           tree.statementRootCount ||
       tree.statementRootBindingDeclarationCounts.len !=
           tree.statementRootCount ||
       tree.statementRootAnchorLineNumbers.len != tree.statementRootCount ||
       tree.statementRootAnchorColumnNumbers.len != tree.statementRootCount ||
       tree.statementRootEndLineNumbers.len != tree.statementRootCount ||
       tree.statementRootEndColumnNumbers.len != tree.statementRootCount:
        err = "parser value expr: statement root column shape mismatch"
        return false
    if tree.nodeStatementRootEventIndexes.len != tree.nodeCount:
        err = "parser value expr: node statement root column shape mismatch"
        return false
    for nodeIndex in 0..<tree.nodeCount:
        let eventIndex = ParserValueExprNodeDirectStatementRootEventAt(
            tree, nodeIndex)
        if eventIndex < -1 || eventIndex >= tree.statementRootCount ||
           (eventIndex >= 0 &&
            ParserValueExprStatementRootNodeAt(tree, eventIndex) !=
                nodeIndex):
            err = Fmt"parser value expr: node statement root authority invalid node={nodeIndex} event={eventIndex}"
            return false
    for rootIndex in 0..<tree.statementRootCount:
        let nodeIndex = ParserValueExprStatementRootNodeAt(tree, rootIndex)
        let role = ParserValueExprStatementRootRoleAt(tree, rootIndex)
        let anchorToken = ParserValueExprStatementRootAnchorTokenAt(
            tree, rootIndex)
        let declarationStart =
            ParserValueExprStatementRootBindingDeclarationStartAt(
                tree, rootIndex)
        let declarationCount =
            ParserValueExprStatementRootBindingDeclarationCountAt(
                tree, rootIndex)
        if nodeIndex < 0 || nodeIndex >= tree.nodeCount ||
           role <= ParserValueExprStatementInvalid ||
           role > ParserValueExprStatementCaseGuard ||
           anchorToken < 0 || anchorToken >= tree.tokenCount ||
           ParserValueExprNodeDirectStatementRootEventAt(
               tree, nodeIndex) != rootIndex ||
           ParserValueExprTokenSourceIdAt(tree, anchorToken) !=
               ParserValueExprNodeSourceIdAt(tree, nodeIndex) ||
           ParserValueExprStatementRootAnchorLineAt(tree, rootIndex) !=
               ParserValueExprTokenLineAt(tree, anchorToken) ||
           ParserValueExprStatementRootAnchorColumnAt(tree, rootIndex) !=
               ParserValueExprTokenColumnAt(tree, anchorToken) ||
           ParserValueExprStatementRootEndLineAt(tree, rootIndex) <
               ParserValueExprStatementRootAnchorLineAt(tree, rootIndex) ||
           ParserValueExprStatementRootEndColumnAt(tree, rootIndex) <= 0:
            err = Fmt"parser value expr: statement root authority invalid row={rootIndex}"
            return false
        let declarationAuthorityRole =
            role == ParserValueExprStatementBindingInitializer ||
            role == ParserValueExprStatementTypeDefault ||
            role == ParserValueExprStatementParameterDefault
        if !declarationAuthorityRole:
            if declarationStart != -1 || declarationCount != 0:
                err = Fmt"parser value expr: statement without declaration authority owns declarations row={rootIndex}"
                return false
            continue
        if ParserValueExprTokenKindAt(tree, anchorToken) !=
               ParserValueTokenAssign ||
           declarationStart < 0 || declarationCount <= 0 ||
           declarationStart > tree.declarationCount ||
           declarationCount > tree.declarationCount - declarationStart:
            err = Fmt"parser value expr: statement declaration authority range invalid row={rootIndex}"
            return false
        let anchorSourceId = ParserValueExprTokenSourceIdAt(
            tree, anchorToken)
        let anchorStart = ParserValueExprTokenStartAt(tree, anchorToken)
        let nodeSpanEnd = ParserValueExprNodeSpanEndAt(tree, nodeIndex)
        if (role == ParserValueExprStatementTypeDefault ||
            role == ParserValueExprStatementParameterDefault) &&
           declarationCount != 1:
            err = Fmt"parser value expr: declaration default cardinality invalid row={rootIndex}"
            return false
        for declarationOffset in 0..<declarationCount:
            let declarationRow = declarationStart + declarationOffset
            let nameToken = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationNameTokenIndexes,
                declarationRow)
            let declarationKind = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationKinds,
                declarationRow)
            let nameSourceId =
                ParserValueExprTokenSourceIdAt(tree, nameToken)
            let declarationSpanStart = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationSpanStarts,
                declarationRow)
            let declarationSpanEnd = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationSpanEnds,
                declarationRow)
            let nameStart = ParserValueExprTokenStartAt(tree, nameToken)
            if role == ParserValueExprStatementBindingInitializer:
                if declarationKind != Int32(ParserDeclarationLocal) ||
                   nameSourceId != anchorSourceId ||
                   declarationSpanStart >= anchorStart ||
                   declarationSpanEnd != nodeSpanEnd ||
                   nameStart >= anchorStart:
                    err = Fmt"parser value expr: binding statement declaration authority invalid row={rootIndex} declaration={declarationRow} kind={declarationKind} name_source={nameSourceId} anchor_source={anchorSourceId} declaration_start={declarationSpanStart} anchor_start={anchorStart} declaration_end={declarationSpanEnd} node_end={nodeSpanEnd} name_start={nameStart}"
                    return false
            elif role == ParserValueExprStatementTypeDefault:
                let declarationFunctionRow = arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.declarationFunctionRows,
                    declarationRow)
                let declarationScopeRow = arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.declarationLexicalScopeRows,
                    declarationRow)
                let declarationScopeKind = arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.declarationLexicalScopeKinds,
                    declarationScopeRow)
                let typeDeclarationAuthority =
                    declarationKind == Int32(ParserDeclarationType) &&
                    declarationScopeKind ==
                        Int32(ParserDeclarationLexicalScopeSource)
                let fieldDeclarationAuthority =
                    declarationKind == Int32(ParserDeclarationField) &&
                    declarationScopeKind ==
                        Int32(ParserDeclarationLexicalScopeType)
                if declarationFunctionRow != -1 ||
                   (!typeDeclarationAuthority &&
                    !fieldDeclarationAuthority) ||
                   nameSourceId != anchorSourceId ||
                   declarationSpanStart >= anchorStart ||
                   declarationSpanEnd < nodeSpanEnd ||
                   nameStart >= anchorStart:
                    err = Fmt"parser value expr: type default declaration authority invalid row={rootIndex} declaration={declarationRow} kind={declarationKind} function={declarationFunctionRow} scope_kind={declarationScopeKind} name_source={nameSourceId} anchor_source={anchorSourceId} declaration_start={declarationSpanStart} anchor_start={anchorStart} declaration_end={declarationSpanEnd} node_end={nodeSpanEnd} name_start={nameStart}"
                    return false
            else:
                let declarationDefaultRoot =
                    arenamod.ArenaArrayInt32Get(
                        tree.arena,
                        tree.declarationDefaultStatementRootRows,
                        declarationRow)
                let declarationFunctionRow =
                    arenamod.ArenaArrayInt32Get(
                        tree.arena,
                        tree.declarationFunctionRows,
                        declarationRow)
                let declarationOwnerRow =
                    arenamod.ArenaArrayInt32Get(
                        tree.arena,
                        tree.declarationOwnerRows,
                        declarationRow)
                let declarationScopeRow =
                    arenamod.ArenaArrayInt32Get(
                        tree.arena,
                        tree.declarationLexicalScopeRows,
                        declarationRow)
                let declarationProducer =
                    arenamod.ArenaArrayInt32Get(
                        tree.arena,
                        tree.declarationProducerSourceIndexes,
                        declarationRow)
                if declarationKind !=
                       Int32(ParserDeclarationParameter) ||
                   declarationDefaultRoot != rootIndex ||
                   declarationFunctionRow < 0 ||
                   declarationOwnerRow < 0 ||
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.declarationKinds,
                       declarationOwnerRow) !=
                       Int32(ParserDeclarationFunction) ||
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.declarationFunctionRows,
                       declarationOwnerRow) != declarationFunctionRow ||
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.declarationLexicalScopeKinds,
                       declarationScopeRow) !=
                       Int32(ParserDeclarationLexicalScopeFunction) ||
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.declarationLexicalScopeOwnerDeclarationRows,
                       declarationScopeRow) != declarationOwnerRow ||
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.declarationLexicalScopeProducerSourceIndexes,
                       declarationScopeRow) != declarationProducer ||
                   nameSourceId != anchorSourceId ||
                   declarationSpanStart >= anchorStart ||
                   declarationSpanEnd != nodeSpanEnd ||
                   nameStart >= anchorStart:
                    err = Fmt"parser value expr: parameter default declaration authority invalid row={rootIndex} declaration={declarationRow} kind={declarationKind} default_root={declarationDefaultRoot} function={declarationFunctionRow} owner={declarationOwnerRow} scope={declarationScopeRow} name_source={nameSourceId} anchor_source={anchorSourceId} declaration_start={declarationSpanStart} anchor_start={anchorStart} declaration_end={declarationSpanEnd} node_end={nodeSpanEnd} name_start={nameStart}"
                    return false
    err = ""
    return true

@borrows
fn ParserValueExprTreeAnnotationsStrictValidateInto(
        tree: ParserValueExprTree,
        err: var str): bool =
    err = ""
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.annotationCount < 0 || tree.annotationArgCount < 0 ||
       tree.annotationArgRootCount < 0 ||
       tree.annotationArgChildCount < 0 ||
       tree.annotationProducerSourceIndexes.len != tree.annotationCount ||
       tree.annotationSourceLocalRows.len != tree.annotationCount ||
       tree.annotationNameTokenIndexes.len != tree.annotationCount ||
       tree.annotationTargetTokenIndexes.len != tree.annotationCount ||
       tree.annotationSpanStarts.len != tree.annotationCount ||
       tree.annotationSpanEnds.len != tree.annotationCount ||
       tree.annotationArgRootStarts.len != tree.annotationCount ||
       tree.annotationArgRootCounts.len != tree.annotationCount ||
       tree.annotationArgRootNodeIndexes.len !=
           tree.annotationArgRootCount ||
       tree.annotationArgProducerSourceIndexes.len !=
           tree.annotationArgCount ||
       tree.annotationArgSourceLocalRows.len != tree.annotationArgCount ||
       tree.annotationArgOwnerRows.len != tree.annotationArgCount ||
       tree.annotationArgKinds.len != tree.annotationArgCount ||
       tree.annotationArgTokenIndexes.len != tree.annotationArgCount ||
       tree.annotationArgSeparatorTokenIndexes.len !=
           tree.annotationArgCount ||
       tree.annotationArgSpanStarts.len != tree.annotationArgCount ||
       tree.annotationArgSpanEnds.len != tree.annotationArgCount ||
       tree.annotationArgChildStarts.len != tree.annotationArgCount ||
       tree.annotationArgChildCounts.len != tree.annotationArgCount ||
       tree.annotationArgChildNodeIndexes.len !=
           tree.annotationArgChildCount:
        err = "parser annotation: column shape mismatch"
        return false
    var nextAnnotationLocalRows: int32[]
    var nextArgLocalRows: int32[]
    var rootSeen: bool[]
    var childSeen: bool[]
    setLen(nextAnnotationLocalRows, tree.producerSourceCount)
    setLen(nextArgLocalRows, tree.producerSourceCount)
    setLen(rootSeen, tree.annotationArgCount)
    setLen(childSeen, tree.annotationArgCount)
    var rootCursor: int32
    for row in 0..<tree.annotationCount:
        let producer = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationProducerSourceIndexes, row)
        let localRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationSourceLocalRows, row)
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationNameTokenIndexes, row)
        let targetToken = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationTargetTokenIndexes, row)
        let spanStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationSpanStarts, row)
        let spanEnd = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationSpanEnds, row)
        let argStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationArgRootStarts, row)
        let argCount = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationArgRootCounts, row)
        if producer < 0 || producer >= tree.producerSourceCount ||
           localRow != nextAnnotationLocalRows[producer] ||
           nameToken < 0 || nameToken >= tree.tokenCount ||
           targetToken < 0 || targetToken >= tree.tokenCount ||
           !ParserValueExprTokenCanName(
               ParserValueExprTokenKindAt(tree, nameToken)) ||
           ParserValueExprTokenProducerSourceIndexAt(tree, nameToken) !=
               producer ||
           ParserValueExprTokenProducerSourceIndexAt(tree, targetToken) !=
               producer ||
           ParserValueExprTokenSourceIdAt(tree, nameToken) !=
               ParserValueExprTokenSourceIdAt(tree, targetToken) ||
           spanStart < 0 || spanEnd <= spanStart ||
           ParserValueExprTokenStartAt(tree, nameToken) <= spanStart ||
           ParserValueExprTokenEndAt(tree, nameToken) > spanEnd ||
           ParserValueExprTokenStartAt(tree, targetToken) <= spanEnd ||
           argStart != rootCursor || argCount < 0 ||
           argStart + argCount > tree.annotationArgRootCount:
            err = "parser annotation: row authority invalid"
            return false
        for offset in 0..<argCount:
            let root = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.annotationArgRootNodeIndexes,
                argStart + offset)
            if root < 0 || root >= tree.annotationArgCount ||
               rootSeen[root] || childSeen[root] ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena, tree.annotationArgOwnerRows, root) != row:
                err = "parser annotation: root authority invalid"
                return false
            rootSeen[root] = true
        nextAnnotationLocalRows[producer] =
            nextAnnotationLocalRows[producer] + 1
        rootCursor = rootCursor + argCount
    if rootCursor != tree.annotationArgRootCount:
        err = "parser annotation: root CSR coverage invalid"
        return false
    var childCursor: int32
    for row in 0..<tree.annotationArgCount:
        let producer = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationArgProducerSourceIndexes, row)
        let localRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationArgSourceLocalRows, row)
        let owner = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationArgOwnerRows, row)
        let kindRaw = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationArgKinds, row)
        let kind = ParserAnnotationArgKind(kindRaw)
        let token = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationArgTokenIndexes, row)
        let separator = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationArgSeparatorTokenIndexes, row)
        let spanStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationArgSpanStarts, row)
        let spanEnd = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationArgSpanEnds, row)
        let childStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationArgChildStarts, row)
        let childCount = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.annotationArgChildCounts, row)
        if producer < 0 || producer >= tree.producerSourceCount ||
           localRow != nextArgLocalRows[producer] ||
           owner < 0 || owner >= tree.annotationCount ||
           kindRaw < Int32(ParserAnnotationArgIdentifier) ||
           kindRaw > Int32(ParserAnnotationArgKeyValue) ||
           token < 0 || token >= tree.tokenCount ||
           separator < -1 || separator >= tree.tokenCount ||
           ParserValueExprTokenProducerSourceIndexAt(tree, token) !=
               producer ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.annotationProducerSourceIndexes,
               owner) != producer ||
           spanStart < 0 || spanEnd <= spanStart ||
           childStart != childCursor || childCount < 0 ||
           childStart + childCount > tree.annotationArgChildCount:
            err = "parser annotation: argument row authority invalid"
            return false
        let scalar = kind == ParserAnnotationArgIdentifier ||
                     kind == ParserAnnotationArgNumber ||
                     kind == ParserAnnotationArgString ||
                     kind == ParserAnnotationArgCharacter ||
                     kind == ParserAnnotationArgBoolean
        if scalar && (childCount != 0 || separator != -1):
            err = "parser annotation: scalar argument owns structure"
            return false
        if scalar:
            let ownerNameToken = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.annotationNameTokenIndexes,
                owner)
            if !ParserAnnotationArgScalarTokenKindMatches(
                   kind,
                   ParserValueExprTokenKindAt(tree, token)) ||
               ParserValueExprTokenSourceIdAt(tree, token) !=
                   ParserValueExprTokenSourceIdAt(
                       tree, ownerNameToken) ||
               spanStart != ParserValueExprTokenStartAt(tree, token) ||
               spanEnd != ParserValueExprTokenEndAt(tree, token):
                err = "parser annotation: scalar token identity invalid"
                return false
        if (kind == ParserAnnotationArgList ||
            kind == ParserAnnotationArgDict) && separator != -1:
            err = "parser annotation: aggregate separator invalid"
            return false
        if kind == ParserAnnotationArgKeyValue:
            if childCount != 2 || separator != token ||
               (ParserValueExprTokenKindAt(tree, separator) !=
                    ParserValueTokenColon &&
                ParserValueExprTokenKindAt(tree, separator) !=
                    ParserValueTokenAssign):
                err = "parser annotation: key/value shape invalid"
                return false
        for offset in 0..<childCount:
            let child = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.annotationArgChildNodeIndexes,
                childStart + offset)
            if child < 0 || child >= row || childSeen[child] ||
               rootSeen[child] ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena, tree.annotationArgOwnerRows, child) != owner ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.annotationArgProducerSourceIndexes,
                   child) != producer:
                err = "parser annotation: child authority invalid"
                return false
            childSeen[child] = true
            if kind == ParserAnnotationArgDict &&
               ParserAnnotationArgKind(arenamod.ArenaArrayInt32Get(
                   tree.arena, tree.annotationArgKinds, child)) !=
                   ParserAnnotationArgKeyValue:
                err = "parser annotation: dictionary child is not key/value"
                return false
        if kind == ParserAnnotationArgKeyValue:
            let keyNode = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.annotationArgChildNodeIndexes,
                childStart)
            if !ParserValueExprAnnotationArgKeyKind(tree, keyNode):
                err = "parser annotation: key kind authority invalid"
                return false
        nextArgLocalRows[producer] = nextArgLocalRows[producer] + 1
        childCursor = childCursor + childCount
    if childCursor != tree.annotationArgChildCount:
        err = "parser annotation: child CSR coverage invalid"
        return false
    for row in 0..<tree.annotationArgCount:
        if rootSeen[row] == childSeen[row]:
            err = "parser annotation: argument must have one parent or root"
            return false
    err = ""
    return true

# [implicit generic] A binding annotation root takes the generic window of the
# routine its statement lives in, and with it that routine's
# declaration-owner token -- the same contract parameter and return type roots
# already follow (`:22683`/`:22710`/`:22975`/`:23006` pass the routine token,
# not the parameter name).  The routine is found through exact columns only:
# the annotation root is `declarationTypeSyntaxRootIndexes` of its binding
# declarations, a binding declaration carries the enclosing function row, and a
# routine's own declaration row is the unique `ParserDeclarationFunction` row
# carrying that function row.  Any missing or ambiguous hop answers -1, which
# every caller treats as a failed check (fail closed).
@borrows
fn ParserValueExprBindingAnnotationRoutineOwnerToken(
        tree: ParserValueExprTree,
        annotationRoot: int32): int32 =
    var functionRow: int32 = -1
    var declarationMatches: int32
    for declarationRow in 0..<tree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationTypeSyntaxRootIndexes,
               declarationRow) != annotationRoot:
            continue
        let rowFunctionRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationFunctionRows, declarationRow)
        if rowFunctionRow < 0:
            return -1
        if declarationMatches > 0 && rowFunctionRow != functionRow:
            return -1
        functionRow = rowFunctionRow
        declarationMatches = declarationMatches + 1
    if declarationMatches <= 0:
        return -1
    var routineRow: int32 = -1
    for declarationRow in 0..<tree.declarationCount:
        if ParserDeclarationKind(arenamod.ArenaArrayInt32Get(
               tree.arena, tree.declarationKinds, declarationRow)) !=
               ParserDeclarationFunction:
            continue
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationFunctionRows,
               declarationRow) != functionRow:
            continue
        if routineRow >= 0:
            return -1
        routineRow = declarationRow
    if routineRow < 0:
        return -1
    return arenamod.ArenaArrayInt32Get(
        tree.arena, tree.declarationNameTokenIndexes, routineRow)

@borrows
fn ParserValueExprTreePatternsStrictValidateInto(
        tree: ParserValueExprTree,
        err: var str): bool =
    err = ""
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.patternCount < 0 || tree.patternChildCount < 0 ||
       tree.patternProducerSourceIndexes.len != tree.patternCount ||
       tree.patternSourceLocalRows.len != tree.patternCount ||
       tree.patternKinds.len != tree.patternCount ||
       tree.patternNameTokenIndexes.len != tree.patternCount ||
       tree.patternOwnerLexicalScopeRows.len != tree.patternCount ||
       tree.patternOwnerKinds.len != tree.patternCount ||
       tree.patternOwnerRows.len != tree.patternCount ||
       tree.patternBindingDeclarationRows.len != tree.patternCount ||
       tree.patternTypeSyntaxRootIndexes.len != tree.patternCount ||
       tree.patternSpanStarts.len != tree.patternCount ||
       tree.patternSpanEnds.len != tree.patternCount ||
       tree.patternChildStarts.len != tree.patternCount ||
       tree.patternChildCounts.len != tree.patternCount ||
       tree.patternChildNodeIndexes.len != tree.patternChildCount:
        err = "parser pattern: column shape mismatch"
        return false
    var nextSourceLocalRows: int32[]
    var childSeen: bool[]
    var parentRows: int32[]
    var bindingSeenSlots: int64[]
    var bindingSeenRows: int32[]
    setLen(nextSourceLocalRows, tree.producerSourceCount)
    setLen(childSeen, tree.patternCount)
    setLen(parentRows, tree.patternCount)
    let bindingSeenCapacity =
        parserInt64SeenCapacityFor(tree.patternCount)
    setLen(bindingSeenSlots, bindingSeenCapacity)
    setLen(bindingSeenRows, bindingSeenCapacity)
    for row in 0..<tree.patternCount:
        parentRows[row] = -1
    var childCursor: int32
    for row in 0..<tree.patternCount:
        let producer = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternProducerSourceIndexes, row)
        let localRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternSourceLocalRows, row)
        let kind = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternKinds, row)
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternNameTokenIndexes, row)
        let scope = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternOwnerLexicalScopeRows, row)
        let ownerKind = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternOwnerKinds, row)
        let ownerRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternOwnerRows, row)
        let declarationRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternBindingDeclarationRows, row)
        let typeSyntaxRoot = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternTypeSyntaxRootIndexes, row)
        let spanStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternSpanStarts, row)
        let spanEnd = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternSpanEnds, row)
        let childStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternChildStarts, row)
        let childCount = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternChildCounts, row)
        if producer < 0 || producer >= tree.producerSourceCount ||
           localRow != nextSourceLocalRows[producer] ||
           kind < Int32(ParserPatternBinding) ||
           kind > Int32(ParserPatternRange) ||
           nameToken < -1 || nameToken >= tree.tokenCount ||
           scope < 0 || scope >= tree.declarationLexicalScopeCount ||
           ownerKind < Int32(ParserPatternOwnerInvalid) ||
           ownerKind > Int32(ParserPatternOwnerValueNode) ||
           (ownerKind == Int32(ParserPatternOwnerInvalid) &&
            ownerRow != -1) ||
           (ownerKind != Int32(ParserPatternOwnerInvalid) &&
            ownerRow < 0) ||
           declarationRow < -1 || declarationRow >= tree.declarationCount ||
           typeSyntaxRoot < -1 ||
           typeSyntaxRoot >= tree.typeSyntaxCount ||
           spanStart < 0 || spanEnd <= spanStart ||
           childStart != childCursor || childCount < 0 ||
           childStart + childCount > tree.patternChildCount ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeProducerSourceIndexes,
               scope) != producer:
            err = "parser pattern: row authority invalid"
            return false
        if kind == Int32(ParserPatternBinding):
            if nameToken < 0 || declarationRow < 0 ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena, tree.declarationKinds, declarationRow) !=
                   Int32(ParserDeclarationLocal) ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationNameTokenIndexes,
                   declarationRow) != nameToken ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationLexicalScopeRows,
                   declarationRow) != scope:
                err = "parser pattern: binding declaration mismatch"
                return false
            var name = ParserValueExprTokenText(tree, nameToken)
            # (scope, name text hash) 开放寻址判重，碰撞时文本精确复核。
            # key = (Int64(scope) << 32) | hash32，scope < 2^31 由前序 row
            # authority 校验保证，hash32 经 & 0xFFFFFFFF 归一为非负，无溢出。
            # O(P²) 三角回扫 → O(1) 期望。
            # ParserValueExprTokenText is @borrows-marked for call-site
            # authority, so this owned copy has no scope-end drop; release it
            # exactly once on both the duplicate and clean exits.
            let nameHash =
                Int64(ParserTextLookupContentHash(name)) & 4294967295
            let seenKey = (
                (Int64(scope) << 32) |
                nameHash)
            let seenMask = Int64(bindingSeenSlots.len) - 1
            var probe = Int32(seenKey & seenMask)
            if probe < 0:
                probe = 0
            var scanned: int32
            var duplicateRow: int32 = -1
            while scanned < bindingSeenSlots.len:
                let storedPlus1 = bindingSeenSlots[probe]
                if storedPlus1 == 0:
                    bindingSeenSlots[probe] = seenKey + 1
                    bindingSeenRows[probe] = row
                    break
                if storedPlus1 == seenKey + 1:
                    let storedRow = bindingSeenRows[probe]
                    var storedName = ParserValueExprTokenText(
                        tree,
                        arenamod.ArenaArrayInt32Get(
                            tree.arena,
                            tree.patternNameTokenIndexes,
                            storedRow))
                    let nameMatches = storedName == name
                    os.ReleaseStr(storedName)
                    if nameMatches:
                        duplicateRow = storedRow
                        break
                probe = probe + 1
                if probe >= bindingSeenSlots.len:
                    probe = 0
                scanned = scanned + 1
            if scanned >= bindingSeenSlots.len:
                panic("parser pattern seen set: table full")
            if duplicateRow >= 0:
                err = Fmt"parser pattern: duplicate binding in scope name={name} scope={scope} row={row} previous={duplicateRow}"
                os.ReleaseStr(name)
                return false
            os.ReleaseStr(name)
        elif declarationRow != -1:
            err = "parser pattern: non-binding owns declaration"
            return false
        for offset in 0..<childCount:
            let child = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.patternChildNodeIndexes,
                childStart + offset)
            if child < 0 || child >= row || childSeen[child] ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena, tree.patternProducerSourceIndexes, child) !=
                   producer ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena, tree.patternOwnerLexicalScopeRows, child) !=
                   scope:
                err = "parser pattern: child authority invalid"
                return false
            childSeen[child] = true
            parentRows[child] = row
        childCursor = childCursor + childCount
        nextSourceLocalRows[producer] = localRow + 1
    if childCursor != tree.patternChildCount:
        err = "parser pattern: child coverage mismatch"
        return false
    if tree.regionKinds.len != tree.regionCount ||
       tree.regionSourceTextIds.len != tree.regionCount ||
       tree.regionSpanStarts.len != tree.regionCount ||
       tree.regionSpanEnds.len != tree.regionCount ||
       tree.regionAnchorTokenIndexes.len != tree.regionCount:
        err = "parser pattern: region owner columns invalid"
        return false
    for row in 0..<tree.patternCount:
        let ownerKind = ParserPatternOwnerKind(arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternOwnerKinds, row))
        let ownerRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternOwnerRows, row)
        if parentRows[row] >= 0:
            if ownerKind != ParserPatternOwnerInvalid || ownerRow != -1:
                err = "parser pattern: child owns syntax surface"
                return false
            continue
        let producer = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternProducerSourceIndexes, row)
        let patternSpanStart = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternSpanStarts, row)
        let patternSpanEnd = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternSpanEnds, row)
        if ownerKind == ParserPatternOwnerRegion:
            if ownerRow < 0 || ownerRow >= tree.regionCount:
                err = "parser pattern: region root owner invalid"
                return false
            let regionKind = ParserValueExprRegionKind(
                arenamod.ArenaArrayInt32Get(
                    tree.arena, tree.regionKinds, ownerRow))
            if regionKind != ParserValueExprRegionPattern &&
               regionKind != ParserValueExprRegionCaseArm:
                err = "parser pattern: region owner kind invalid"
                return false
            let anchorToken = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.regionAnchorTokenIndexes, ownerRow)
            if anchorToken < 0 || anchorToken >= tree.tokenCount ||
               ParserValueExprTokenProducerSourceIndexAt(
                   tree, anchorToken) != producer ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena, tree.regionSourceTextIds, ownerRow) !=
                   ParserValueExprTokenSourceIdAt(tree, anchorToken) ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena, tree.regionSpanStarts, ownerRow) >
                   patternSpanStart ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena, tree.regionSpanEnds, ownerRow) <
                   patternSpanEnd:
                err = "parser pattern: region root identity mismatch"
                return false
        elif ownerKind == ParserPatternOwnerValueNode:
            if ownerRow < 0 || ownerRow >= tree.nodeCount ||
               ParserValueExprNodeKindAt(tree, ownerRow) !=
                   ParserValueExprCaseBranch ||
               ParserValueExprNodeProducerSourceIndexAt(
                   tree, ownerRow) != producer ||
               ParserValueExprNodeSpanStartAt(tree, ownerRow) >
                   patternSpanStart ||
               ParserValueExprNodeSpanEndAt(tree, ownerRow) <
                   patternSpanEnd:
                err = "parser pattern: value-node root identity mismatch"
                return false
        else:
            err = "parser pattern: root owner missing"
            return false
    var annotationRootOwnerPattern: int32[]
    setLen(annotationRootOwnerPattern, tree.typeSyntaxCount)
    for typeRow in 0..<tree.typeSyntaxCount:
        annotationRootOwnerPattern[typeRow] = -1
    for row in 0..<tree.patternCount:
        let kind = ParserPatternKind(arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternKinds, row))
        let typeSyntaxRoot = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternTypeSyntaxRootIndexes, row)
        if typeSyntaxRoot < 0:
            continue
        if kind != ParserPatternBinding && parentRows[row] >= 0:
            err = "parser pattern: nested non-binding owns type annotation"
            return false
        let producer = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternProducerSourceIndexes, row)
        if ParserValueExprTypeSyntaxRootKindAt(
               tree, typeSyntaxRoot) !=
               ParserTypeSyntaxRootBindingAnnotation ||
           ParserValueExprTypeSyntaxProducerSourceIndexAt(
               tree, typeSyntaxRoot) != producer ||
           ParserValueExprTypeSyntaxDeclarationOwnerAt(
               tree, typeSyntaxRoot) != -1:
            err = "parser pattern: binding annotation TypeSyntax invalid"
            return false
        if parentRows[row] < 0:
            if annotationRootOwnerPattern[typeSyntaxRoot] >= 0:
                err = "parser pattern: binding annotation root reused"
                return false
            annotationRootOwnerPattern[typeSyntaxRoot] = row
    for row in 0..<tree.patternCount:
        let kind = ParserPatternKind(arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternKinds, row))
        if kind != ParserPatternBinding:
            continue
        let declarationRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternBindingDeclarationRows, row)
        let typeSyntaxRoot = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternTypeSyntaxRootIndexes, row)
        let declarationTypeSyntaxRoot = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationTypeSyntaxRootIndexes,
            declarationRow)
        var rootPattern = row
        while parentRows[rootPattern] >= 0:
            rootPattern = parentRows[rootPattern]
        let rootTypeSyntax = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.patternTypeSyntaxRootIndexes,
            rootPattern)
        if typeSyntaxRoot != rootTypeSyntax ||
           declarationTypeSyntaxRoot != typeSyntaxRoot:
            err = "parser pattern: binding annotation declaration join invalid"
            return false
        if typeSyntaxRoot < 0:
            continue
        if annotationRootOwnerPattern[typeSyntaxRoot] != rootPattern:
            err = "parser pattern: binding annotation owner root invalid"
            return false
        let bindingNameToken = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.patternNameTokenIndexes, row)
        let declarationProducer = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationProducerSourceIndexes,
            declarationRow)
        if declarationProducer !=
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.patternProducerSourceIndexes,
                   row) ||
           ParserValueExprTokenProducerSourceIndexAt(
               tree, bindingNameToken) != declarationProducer:
            err = "parser pattern: binding annotation source join invalid"
            return false
    for typeRow in 0..<tree.typeSyntaxCount:
        let rootPattern = annotationRootOwnerPattern[typeRow]
        if rootPattern < 0:
            continue
        var firstBindingNameToken: int32 = -1
        for bindingRow in 0..<tree.patternCount:
            if ParserPatternKind(arenamod.ArenaArrayInt32Get(
                   tree.arena, tree.patternKinds, bindingRow)) !=
                   ParserPatternBinding ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.patternTypeSyntaxRootIndexes,
                   bindingRow) != typeRow:
                continue
            var bindingRoot = bindingRow
            while parentRows[bindingRoot] >= 0:
                bindingRoot = parentRows[bindingRoot]
            if bindingRoot != rootPattern:
                err = "parser pattern: binding annotation root crossed pattern"
                return false
            let nameToken = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.patternNameTokenIndexes,
                bindingRow)
            if firstBindingNameToken < 0 ||
               nameToken < firstBindingNameToken:
                firstBindingNameToken = nameToken
        if firstBindingNameToken < 0:
            firstBindingNameToken = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.patternNameTokenIndexes,
                rootPattern)
        # [implicit generic] With a generic window the annotation root follows
        # the parameter/return contract: the declaration-owner token is the
        # routine's name token, derived here through exact columns.  Without a
        # window the previous contract holds verbatim: both tokens are the
        # bound name.
        var expectedDeclarationOwnerToken = firstBindingNameToken
        if firstBindingNameToken >= 0 &&
           ParserValueExprTypeSyntaxGenericSymbolCountAt(
               tree, typeRow) > 0:
            expectedDeclarationOwnerToken =
                ParserValueExprBindingAnnotationRoutineOwnerToken(
                    tree, typeRow)
        if firstBindingNameToken < 0 ||
           ParserValueExprTypeSyntaxOwnerTokenAt(
               tree, typeRow) != firstBindingNameToken ||
           ParserValueExprTypeSyntaxDeclarationOwnerTokenAt(
               tree, typeRow) != expectedDeclarationOwnerToken ||
           ParserValueExprTypeSyntaxSpanStartAt(tree, typeRow) <=
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.patternSpanEnds,
                   rootPattern):
            err = "parser pattern: binding annotation owner/span invalid"
            return false
    err = ""
    return true

@borrows
fn ParserValueExprRequireToken(tree: ParserValueExprTree,
                                 tokenIndex: int32) =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       tokenIndex < 0 || tokenIndex >= tree.tokenCount:
        panic("parser value expr: token index out of bounds")

@borrows
@borrow_result
fn ParserValueExprSourceText(tree: ParserValueExprTree,
                               sourceTextId: int32): str =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        panic("parser value expr: source lookup after release")
    return langintern.LookupInternBorrowedText(tree.internPool,
                                               sourceTextId)

# Length-only source lookup for bounds checks.  LookupInternOwnedCopy is a
# full byte copy of the source per call; AppendToken ran it once per token,
# making lexing quadratic (x509.cheng 108KB took minutes + gigabytes of
# transient copies).  The bounds check only needs the length, so use the
# borrowed view (LookupIntern is @borrow_result, no copy).
@borrows
fn ParserValueExprSourceLen(tree: ParserValueExprTree,
                            sourceTextId: int32): int32 =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        panic("parser value expr: source length lookup after release")
    if sourceTextId < 0 ||
       sourceTextId >= arenamod.ArenaArrayInt32Len(
           tree.arena, tree.sourceTextLengths):
        panic("parser value expr: source text length row out of range")
    return arenamod.ArenaArrayInt32Get(tree.arena,
                                        tree.sourceTextLengths,
                                        sourceTextId)

@borrows
fn ParserValueExprProjectSpan(tree: ParserValueExprTree,
                                sourceTextId: int32,
                                spanStart: int32,
                                spanEnd: int32): str =
    if spanStart < 0 && spanEnd < 0:
        return ""
    # Bounds come from the lex-time authoritative int32 length column, not
    # from the interned str view (a polluted by-value view once materialized
    # a 128MiB owned copy here). Copy only the requested range bytes.
    let sourceLen = ParserValueExprSourceLen(tree, sourceTextId)
    if spanStart < 0 || spanEnd < spanStart || spanEnd > sourceLen:
        panic("parser value expr: source span out of bounds")
    let sourceText = langintern.LookupInternBorrowedText(
        tree.internPool, sourceTextId)
    return strings.CloneStrRange(sourceText,
                                  spanStart,
                                  spanEnd - spanStart)

@borrows
fn ParserValueExprTokenKindAt(tree: ParserValueExprTree,
                                tokenIndex: int32): ParserValueTokenKind =
    ParserValueExprRequireToken(tree, tokenIndex)
    return ParserValueTokenKind(arenamod.ArenaArrayInt32Get(
        tree.arena, tree.tokenKinds, tokenIndex))

@borrows
fn ParserValueExprTokenSourceIdAt(tree: ParserValueExprTree,
                                    tokenIndex: int32): int32 =
    ParserValueExprRequireToken(tree, tokenIndex)
    return arenamod.ArenaArrayInt32Get(tree.arena,
                                        tree.tokenSourceTextIds,
                                        tokenIndex)

@borrows
fn ParserValueExprTokenProducerSourceIndexAt(
        tree: ParserValueExprTree,
        tokenIndex: int32): int32 =
    ParserValueExprRequireToken(tree, tokenIndex)
    return arenamod.ArenaArrayInt32Get(
        tree.arena, tree.tokenProducerSourceIndexes, tokenIndex)

@borrows
fn ParserValueExprTokenSourceLocalIndexAt(
        tree: ParserValueExprTree,
        tokenIndex: int32): int32 =
    ParserValueExprRequireToken(tree, tokenIndex)
    return arenamod.ArenaArrayInt32Get(
        tree.arena, tree.tokenSourceLocalIndexes, tokenIndex)

@borrows
fn ParserValueExprTokenLexicalParentIndexAt(
        tree: ParserValueExprTree,
        tokenIndex: int32): int32 =
    ParserValueExprRequireToken(tree, tokenIndex)
    return arenamod.ArenaArrayInt32Get(
        tree.arena, tree.tokenLexicalParentIndexes, tokenIndex)

@borrows
fn ParserValueExprTokenStartAt(tree: ParserValueExprTree,
                                 tokenIndex: int32): int32 =
    ParserValueExprRequireToken(tree, tokenIndex)
    return arenamod.ArenaArrayInt32Get(tree.arena,
                                        tree.tokenStarts,
                                        tokenIndex)

@borrows
fn ParserValueExprTokenEndAt(tree: ParserValueExprTree,
                               tokenIndex: int32): int32 =
    ParserValueExprRequireToken(tree, tokenIndex)
    return arenamod.ArenaArrayInt32Get(tree.arena,
                                        tree.tokenEnds,
                                        tokenIndex)

@borrows
fn ParserValueExprTokenLineAt(tree: ParserValueExprTree,
                                tokenIndex: int32): int32 =
    ParserValueExprRequireToken(tree, tokenIndex)
    return arenamod.ArenaArrayInt32Get(tree.arena,
                                        tree.tokenLineNumbers,
                                        tokenIndex)

@borrows
fn ParserValueExprTokenColumnAt(tree: ParserValueExprTree,
                                  tokenIndex: int32): int32 =
    ParserValueExprRequireToken(tree, tokenIndex)
    return arenamod.ArenaArrayInt32Get(tree.arena,
                                        tree.tokenColumnNumbers,
                                        tokenIndex)

@borrows
fn ParserValueExprTokenText(tree: ParserValueExprTree,
                              tokenIndex: int32): str =
    return ParserValueExprProjectSpan(
        tree,
        ParserValueExprTokenSourceIdAt(tree, tokenIndex),
        ParserValueExprTokenStartAt(tree, tokenIndex),
        ParserValueExprTokenEndAt(tree, tokenIndex))

@borrows
fn ParserValueExprTreeTokensStrictValidateInto(
        tree: ParserValueExprTree,
        err: var str): bool =
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.producerSourceCount <= 0 ||
       tree.tokenKinds.len != tree.tokenCount ||
       tree.tokenSourceTextIds.len != tree.tokenCount ||
       tree.tokenProducerSourceIndexes.len != tree.tokenCount ||
       tree.tokenSourceLocalIndexes.len != tree.tokenCount ||
       tree.tokenLexicalParentIndexes.len != tree.tokenCount ||
       tree.tokenStarts.len != tree.tokenCount ||
       tree.tokenEnds.len != tree.tokenCount ||
       tree.tokenLineNumbers.len != tree.tokenCount ||
       tree.tokenColumnNumbers.len != tree.tokenCount:
        err = "parser value expr: token identity shape invalid"
        return false
    var sourceLocalCounts: int32[]
    var lastRootEnds: int32[]
    var lastChildEnds: int32[]
    setLen(sourceLocalCounts, tree.producerSourceCount)
    setLen(lastRootEnds, tree.producerSourceCount)
    setLen(lastChildEnds, tree.tokenCount)
    for sourceIndex in 0..<lastRootEnds.len:
        lastRootEnds[sourceIndex] = -1
    for tokenIndex in 0..<lastChildEnds.len:
        lastChildEnds[tokenIndex] = -1
    for tokenIndex in 0..<tree.tokenCount:
        let producerSourceIndex =
            ParserValueExprTokenProducerSourceIndexAt(tree, tokenIndex)
        let sourceLocalIndex =
            ParserValueExprTokenSourceLocalIndexAt(tree, tokenIndex)
        let lexicalParentIndex =
            ParserValueExprTokenLexicalParentIndexAt(tree, tokenIndex)
        let sourceTextId =
            ParserValueExprTokenSourceIdAt(tree, tokenIndex)
        let spanStart = ParserValueExprTokenStartAt(tree, tokenIndex)
        let spanEnd = ParserValueExprTokenEndAt(tree, tokenIndex)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= tree.producerSourceCount ||
           sourceLocalIndex != sourceLocalCounts[producerSourceIndex] ||
           ParserValueExprTokenKindAt(tree, tokenIndex) ==
               ParserValueTokenInvalid ||
           spanStart < 0 || spanEnd <= spanStart ||
           spanEnd > ParserValueExprSourceLen(tree, sourceTextId) ||
           ParserValueExprTokenLineAt(tree, tokenIndex) <= 0 ||
           ParserValueExprTokenColumnAt(tree, tokenIndex) <= 0:
            err = Fmt"parser value expr: token identity row invalid row={tokenIndex}"
            return false
        sourceLocalCounts[producerSourceIndex] =
            sourceLocalCounts[producerSourceIndex] + 1
        if lexicalParentIndex == -1:
            if spanStart < lastRootEnds[producerSourceIndex]:
                err = Fmt"parser value expr: primary token stream order invalid row={tokenIndex}"
                return false
            lastRootEnds[producerSourceIndex] = spanEnd
            continue
        if lexicalParentIndex < 0 || lexicalParentIndex >= tokenIndex ||
           ParserValueExprTokenProducerSourceIndexAt(
               tree, lexicalParentIndex) != producerSourceIndex ||
           ParserValueExprTokenSourceIdAt(tree, lexicalParentIndex) !=
               sourceTextId ||
           ParserValueExprTokenKindAt(tree, lexicalParentIndex) !=
               ParserValueTokenFmtString ||
           spanStart <= ParserValueExprTokenStartAt(
               tree, lexicalParentIndex) ||
           spanEnd >= ParserValueExprTokenEndAt(
               tree, lexicalParentIndex) ||
           spanStart < lastChildEnds[lexicalParentIndex]:
            err = Fmt"parser value expr: interpolation token parent invalid row={tokenIndex} parent={lexicalParentIndex}"
            return false
        lastChildEnds[lexicalParentIndex] = spanEnd
    err = ""
    return true

@borrows
fn ParserValueExprTypeConstExprEvaluateInto(
        tree: ParserValueExprTree,
        rootIndex: int32,
        valueOut: var int32,
        err: var str): bool =
    valueOut = 0
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive ||
       rootIndex < 0 || rootIndex >= tree.typeConstExprCount:
        err = "parser TypeSyntax: const AST root invalid"
        return false
    var values: int64[]
    setLen(values, rootIndex + 1)
    for nodeIndex in 0..rootIndex:
        let kind = ParserTypeConstExprKind(arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeConstExprKinds, nodeIndex))
        let left = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeConstExprLeftChildIndexes, nodeIndex)
        let right = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeConstExprRightChildIndexes, nodeIndex)
        var value: int64
        if kind == ParserTypeConstExprInteger:
            if left != -1 || right != -1:
                err = "parser TypeSyntax: const integer has children"
                return false
            value = Int64(arenamod.ArenaArrayInt32Get(
                tree.arena, tree.typeConstExprIntegerValues, nodeIndex))
        elif kind == ParserTypeConstExprUnaryPlus ||
             kind == ParserTypeConstExprUnaryMinus:
            if left < 0 || left >= nodeIndex || right != -1:
                err = "parser TypeSyntax: const unary edge invalid"
                return false
            value = values[left]
            if kind == ParserTypeConstExprUnaryMinus: value = -value
        elif kind == ParserTypeConstExprName:
            # [S1b step-3 (9)] The module const table resolved this leaf while
            # the source was parsed; the value is carried by the node, exactly
            # like an integer literal's digits.
            if left != -1 || right != -1:
                err = "parser TypeSyntax: const name has children"
                return false
            value = Int64(arenamod.ArenaArrayInt32Get(
                tree.arena, tree.typeConstExprIntegerValues, nodeIndex))
        else:
            if left < 0 || left >= nodeIndex ||
               right < 0 || right >= nodeIndex:
                err = "parser TypeSyntax: const binary edge invalid"
                return false
            if kind == ParserTypeConstExprAdd:
                value = values[left] + values[right]
            elif kind == ParserTypeConstExprSubtract:
                value = values[left] - values[right]
            elif kind == ParserTypeConstExprMultiply:
                value = values[left] * values[right]
            elif kind == ParserTypeConstExprDivide:
                if values[right] == 0:
                    err = "parser TypeSyntax: const division by zero"
                    return false
                value = values[left] / values[right]
            elif kind == ParserTypeConstExprModulo:
                if values[right] == 0:
                    err = "parser TypeSyntax: const modulo by zero"
                    return false
                value = values[left] % values[right]
            else:
                err = "parser TypeSyntax: const AST kind invalid"
                return false
        if value < Int64(-2147483648) || value > Int64(2147483647):
            err = "parser TypeSyntax: const AST overflow"
            return false
        values[nodeIndex] = value
    valueOut = Int32(values[rootIndex])
    err = ""
    return true

fn ParserValueExprAppendToken(tree: var ParserValueExprTree,
                                sourceTextId: int32,
                                kind: ParserValueTokenKind,
                                spanStart: int32,
                                spanEnd: int32,
                                lineNumber: int32,
                                columnNumber: int32,
                                producerSourceIndex: int32,
                                sourceLocalIndex: int32,
                                lexicalParentIndex: int32) =
    ParserValueExprTreeEnsureActive(tree)
    if tree.lexicalBindingAuthoritySealed:
        panic("parser lexical binding: sealed token mutation")
    let sourceLen = ParserValueExprSourceLen(tree, sourceTextId)
    if kind == ParserValueTokenInvalid || spanStart < 0 ||
       spanEnd <= spanStart || spanEnd > sourceLen ||
       lineNumber <= 0 || columnNumber <= 0 ||
       producerSourceIndex < 0 ||
       producerSourceIndex >= tree.producerSourceCount ||
       sourceLocalIndex < 0 ||
       (lexicalParentIndex != -1 &&
        (lexicalParentIndex < 0 || lexicalParentIndex >= tree.tokenCount)):
        panic("parser value expr: invalid token append")
    arenamod.ArenaArrayInt32Add(tree.arena, tree.tokenKinds, Int32(kind))
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.tokenSourceTextIds,
                                 sourceTextId)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.tokenProducerSourceIndexes,
        producerSourceIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.tokenSourceLocalIndexes, sourceLocalIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.tokenLexicalParentIndexes, lexicalParentIndex)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.tokenStarts, spanStart)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.tokenEnds, spanEnd)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.tokenLineNumbers,
                                 lineNumber)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.tokenColumnNumbers,
                                 columnNumber)
    tree.tokenCount = tree.tokenCount + 1

fn ParserValueExprIsIdentStart(ch: char): bool =
    return (ch >= 'a' && ch <= 'z') ||
           (ch >= 'A' && ch <= 'Z') || ch == '_'

fn ParserValueExprIsIdentContinue(ch: char): bool =
    return ParserValueExprIsIdentStart(ch) || (ch >= '0' && ch <= '9')

@borrows
fn ParserValueExprKeywordKind(source: str,
                                start: int32,
                                stop: int32): ParserValueTokenKind =
    let count = stop - start
    if count == 2 && ParserTextEqualsAt(source, start, "if"):
        return ParserValueTokenIf
    if count == 2 && ParserTextEqualsAt(source, start, "in"):
        return ParserValueTokenIn
    if count == 2 && ParserTextEqualsAt(source, start, "fn"):
        return ParserValueTokenFn
    if count == 2 && ParserTextEqualsAt(source, start, "of"):
        return ParserValueTokenOf
    if count == 3 && ParserTextEqualsAt(source, start, "let"):
        return ParserValueTokenLet
    if count == 3 && ParserTextEqualsAt(source, start, "var"):
        return ParserValueTokenVar
    if count == 3 && ParserTextEqualsAt(source, start, "ref"):
        return ParserValueTokenRef
    if count == 3 && ParserTextEqualsAt(source, start, "set"):
        return ParserValueTokenSet
    if count == 3 && ParserTextEqualsAt(source, start, "nil"):
        return ParserValueTokenNil
    if count == 3 && ParserTextEqualsAt(source, start, "for"):
        return ParserValueTokenFor
    if count == 4 && ParserTextEqualsAt(source, start, "true"):
        return ParserValueTokenTrue
    if count == 4 && ParserTextEqualsAt(source, start, "else"):
        return ParserValueTokenElse
    if count == 4 && ParserTextEqualsAt(source, start, "when"):
        return ParserValueTokenWhen
    if count == 4 && ParserTextEqualsAt(source, start, "case"):
        return ParserValueTokenCase
    if count == 4 && ParserTextEqualsAt(source, start, "type"):
        return ParserValueTokenType
    if count == 4 && ParserTextEqualsAt(source, start, "enum"):
        return ParserValueTokenEnum
    if count == 4 && ParserTextEqualsAt(source, start, "elif"):
        return ParserValueTokenElif
    if count == 5 && ParserTextEqualsAt(source, start, "false"):
        return ParserValueTokenFalse
    if count == 5 && ParserTextEqualsAt(source, start, "await"):
        return ParserValueTokenAwait
    if count == 5 && ParserTextEqualsAt(source, start, "notin"):
        return ParserValueTokenNotIn
    if count == 5 && ParserTextEqualsAt(source, start, "where"):
        return ParserValueTokenWhere
    if count == 5 && ParserTextEqualsAt(source, start, "const"):
        return ParserValueTokenConst
    if count == 5 && ParserTextEqualsAt(source, start, "defer"):
        return ParserValueTokenDefer
    if count == 5 && ParserTextEqualsAt(source, start, "match"):
        return ParserValueTokenMatch
    if count == 5 && ParserTextEqualsAt(source, start, "async"):
        return ParserValueTokenAsync
    if count == 5 && ParserTextEqualsAt(source, start, "yield"):
        return ParserValueTokenYield
    if count == 5 && ParserTextEqualsAt(source, start, "break"):
        return ParserValueTokenBreak
    if count == 5 && ParserTextEqualsAt(source, start, "while"):
        return ParserValueTokenWhile
    if count == 5 && ParserTextEqualsAt(source, start, "block"):
        return ParserValueTokenBlock
    if count == 5 && ParserTextEqualsAt(source, start, "macro"):
        return ParserValueTokenMacro
    if count == 5 && ParserTextEqualsAt(source, start, "trait"):
        return ParserValueTokenTrait
    if count == 5 && ParserTextEqualsAt(source, start, "tuple"):
        return ParserValueTokenTuple
    if count == 6 && ParserTextEqualsAt(source, start, "return"):
        return ParserValueTokenReturn
    if count == 6 && ParserTextEqualsAt(source, start, "import"):
        return ParserValueTokenImport
    if count == 6 && ParserTextEqualsAt(source, start, "module"):
        return ParserValueTokenModule
    if count == 6 && ParserTextEqualsAt(source, start, "object"):
        return ParserValueTokenObject
    if count == 7 && ParserTextEqualsAt(source, start, "concept"):
        return ParserValueTokenConcept
    if count == 8 && ParserTextEqualsAt(source, start, "continue"):
        return ParserValueTokenContinue
    if count == 8 && ParserTextEqualsAt(source, start, "template"):
        return ParserValueTokenTemplate
    if count == 8 && ParserTextEqualsAt(source, start, "iterator"):
        return ParserValueTokenIterator
    return ParserValueTokenIdentifier

# `block` and `object` are contextual. `block` opens a labeled suite only at
# statement head; `object` introduces an object type only where type syntax is
# expected. Everywhere else both are ordinary source identifiers. Keep these
# exceptions in the lexer authority so every declaration/expression consumer
# agrees on the same name domain instead of carrying local keyword guesses.
@borrows
fn ParserValueExprTokenCanName(kind: ParserValueTokenKind): bool =
    return kind == ParserValueTokenIdentifier ||
           kind == ParserValueTokenBlock ||
           kind == ParserValueTokenObject

@borrows
fn ParserValueExprLexQuoted(source: str,
                              start: int32,
                              quotePos: int32,
                              limit: int32,
                              quote: char,
                              stopOut: var int32,
                              err: var str): bool =
    var cursor = quotePos + 1
    while cursor < limit:
        let ch = source[cursor]
        if ch == '\\':
            if cursor + 1 >= limit || source[cursor + 1] == '\n':
                err = Fmt"parser value expr: unterminated escape at offset {cursor}"
                return false
            if source[cursor + 1] == 'x':
                if cursor + 3 >= limit:
                    err = Fmt"parser value expr: short hex escape at offset {cursor}"
                    return false
                for hexIndex in cursor + 2..<cursor + 4:
                    let hex = source[hexIndex]
                    let validHex = (hex >= '0' && hex <= '9') ||
                                   (hex >= 'a' && hex <= 'f') ||
                                   (hex >= 'A' && hex <= 'F')
                    if !validHex:
                        err = Fmt"parser value expr: invalid hex escape at offset {hexIndex}"
                        return false
                cursor = cursor + 4
                continue
            cursor = cursor + 2
            continue
        if ch == quote:
            stopOut = cursor + 1
            return true
        if ch == '\n' || ch == '\r':
            err = Fmt"parser value expr: unterminated literal at offset {start}"
            return false
        cursor = cursor + 1
    err = Fmt"parser value expr: unterminated literal at offset {start}"
    return false

# ---- Fmt 洞转义引号字面量的值侧收口共享权威 ----
# 精确形: 剪裁后 `\\"…\\"` (串) 或 `\\'…\\'` (字符), 首端为反斜杠引导的
# 定界符。普通字符串原子永不会以反斜杠开头 (其首字符是定界符本身),
# 故该形判定无歧义。载荷 = 精确一层外转义消解后的内层字面量源文, 内层
# 自身转义由既有字符串值解码路径继续处理。
@borrows
fn ParserValueExprFmtEscapedQuotedPayload(textRaw: str,
                                            payloadOut: var str): bool =
    payloadOut = ""
    let text = chengpath.PathTrim(textRaw)
    if text.len < 4:
        return false
    let openByte = text[0]
    if openByte != '\\':
        return false
    let quote = text[1]
    if quote != '"' && quote != '\'':
        return false
    if text[text.len - 2] != '\\' || text[text.len - 1] != quote:
        return false
    let inner = chengpath.TextSlice(text, 2, text.len - 2)
    var parts: str[]
    var index = 0
    while index < inner.len:
        let ch = inner[index]
        if ch == '\\' && index + 1 < inner.len:
            let nxt = inner[index + 1]
            if nxt == 'n':
                add(parts, "\n")
            elif nxt == 'r':
                add(parts, "\r")
            elif nxt == 't':
                add(parts, "\t")
            elif nxt == '0':
                add(parts, "\0")
            elif nxt == '\\':
                add(parts, "\\")
            elif nxt == '"':
                add(parts, "\"")
            elif nxt == '\'':
                add(parts, "'")
            elif nxt == '{':
                add(parts, "{")
            elif nxt == '}':
                add(parts, "}")
            elif nxt == 'x':
                if index + 3 >= inner.len:
                    return false
                let hi = ParserValueExprFmtHexNibble(inner[index + 2])
                let lo = ParserValueExprFmtHexNibble(inner[index + 3])
                if hi < 0 || lo < 0:
                    return false
                add(parts, Fmt"{Char(hi * 16 + lo)}")
                index = index + 4
                continue
            else:
                # 与既有 PrimaryBodyIrStringLiteralPayload 宽容口径一致:
                # 未知转义保留原样两字节, 不作二次发明。
                add(parts, strings.CharToStr(ch))
                add(parts, strings.CharToStr(nxt))
            index = index + 2
            continue
        add(parts, strings.CharToStr(ch))
        index = index + 1
    payloadOut = strutil.Join(parts, "")
    return true

@borrows
fn ParserValueExprLexSource(tree: var ParserValueExprTree,
                              source: str,
                              sourceTextIdOut: var int32,
                              tokenStartOut: var int32,
                              tokenCountOut: var int32,
                              err: var str): bool =
    ParserValueExprTreeEnsureActive(tree)
    sourceTextIdOut = langintern.Intern(tree.internPool,
                                        strings.CloneStr(source))
    if sourceTextIdOut < 0 ||
       sourceTextIdOut != arenamod.ArenaArrayInt32Len(
           tree.arena, tree.sourceTextLengths):
        panic("parser value expr: source text length column out of lockstep")
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.sourceTextLengths,
                                 source.len)
    return ParserValueExprLexSpan(tree,
                                  source,
                                  sourceTextIdOut,
                                  0,
                                  source.len,
                                  1,
                                  1,
                                  -1,
                                  false,
                                  tokenStartOut,
                                  tokenCountOut,
                                  err)

# 洞解码流的嵌套转义字面量配对扫描(转义块与 Fmt 特例共用): 从
# `\<quote>` 开引号起按单元机找配对的转义闭引号, 返回字面量类别与
# 闭引号单元末端位置; 未配对即 unterminated literal(硬错误)。
@borrows
fn parserValueExprLexHoleEscapedLiteral(source: str,
                                         literalStart: int32,
                                         spanLimit: int32,
                                         literalKindOut: var int32,
                                         literalStopOut: var int32,
                                         err: var str): bool =
    let openerQuote = Int32(source[literalStart + 1])
    var scanCursor = literalStart + 2
    var innerEscaped = false
    while scanCursor < spanLimit:
        var unitCode: int32
        var unitFromEscape = false
        let unitRawStart = scanCursor
        if !ParserValueExprFmtDecodeOuterByte(source,
                                               scanCursor,
                                               spanLimit,
                                               unitCode,
                                               unitFromEscape,
                                               err):
            return false
        if unitCode == 10 || unitCode == 13:
            break
        if innerEscaped:
            innerEscaped = false
        elif unitCode == Int32('\\'):
            innerEscaped = true
        elif unitCode == openerQuote:
            literalStopOut = scanCursor
            literalKindOut = ParserValueTokenString
            if source[literalStart + 1] == '\'':
                literalKindOut = ParserValueTokenChar
            return true
    err = Fmt"parser value expr: unterminated literal at offset {literalStart}"
    return false

@borrows
fn ParserValueExprLexSpan(tree: var ParserValueExprTree,
                            source: str,
                            sourceTextId: int32,
                            spanStart: int32,
                            spanLimit: int32,
                            initialLineNumber: int32,
                            initialColumnNumber: int32,
                            lexicalParentIndex: int32,
                            fmtHoleLex: bool,
                            tokenStartOut: var int32,
                            tokenCountOut: var int32,
                            err: var str): bool =
    ParserValueExprTreeEnsureActive(tree)
    if spanStart < 0 || spanLimit < spanStart || spanLimit > source.len ||
       initialLineNumber <= 0 || initialColumnNumber <= 0 ||
       tree.producerSourceCount != 1 ||
       (lexicalParentIndex != -1 &&
        (lexicalParentIndex < 0 || lexicalParentIndex >= tree.tokenCount)):
        err = "parser value expr: invalid lexical span"
        return false
    tokenStartOut = tree.tokenCount
    tokenCountOut = 0
    err = ""
    var cursor = spanStart
    var lineNumber = initialLineNumber
    var columnNumber = initialColumnNumber
    while cursor < spanLimit:
        let ch = source[cursor]
        # 仅 Fmt 插值洞重词法启用: 洞表面继承外层串转义语义, `\\"`…`\\"`
        # (或 `\\'`…`\\'`) 按解码流单元机界定嵌套字符串/字符字面量, 产出
        # 携带原文转义形的裸 span 字符串 token——坐标全程单源, 值侧由字符
        # 串字面量收口按精确形谓词解码; 其余 `\\X` 跳对, 裸 `\\` 照拒。
        if fmtHoleLex && ch == '\\':
            if cursor + 1 >= spanLimit || source[cursor + 1] == '\n':
                err = Fmt"parser value expr: unterminated escape at offset {cursor}"
                return false
            let escapeNext = source[cursor + 1]
            if escapeNext == '"' || escapeNext == '\'':
                let literalStart = cursor
                let literalTokenLine = lineNumber
                let literalTokenColumn = columnNumber
                var literalStop: int32
                var literalKind: int32
                if !parserValueExprLexHoleEscapedLiteral(source,
                                                          literalStart,
                                                          spanLimit,
                                                          literalKind,
                                                          literalStop,
                                                          err):
                    tree.failureSpanExact = true
                    tree.failureStartByte = literalStart
                    tree.failureEndByte = spanLimit
                    return false
                cursor = literalStop
                ParserValueExprAppendToken(tree,
                                            sourceTextId,
                                            literalKind,
                                            literalStart,
                                            cursor,
                                            literalTokenLine,
                                            literalTokenColumn,
                                            0,
                                            tree.tokenCount,
                                            lexicalParentIndex)
                columnNumber = columnNumber + cursor - literalStart
                continue
            cursor = cursor + 2
            columnNumber = columnNumber + 2
            continue
        if ch == ' ' || ch == '\t' || ch == '\r':
            cursor = cursor + 1
            columnNumber = columnNumber + 1
            continue
        if ch == '\n':
            cursor = cursor + 1
            lineNumber = lineNumber + 1
            columnNumber = 1
            continue
        if ch == '#':
            while cursor < spanLimit && source[cursor] != '\n':
                cursor = cursor + 1
                columnNumber = columnNumber + 1
            continue
        if ch == '/' && cursor + 1 < spanLimit && source[cursor + 1] == '/':
            while cursor < spanLimit && source[cursor] != '\n':
                cursor = cursor + 1
                columnNumber = columnNumber + 1
            continue
        if ch == '/' && cursor + 1 < spanLimit && source[cursor + 1] == '*':
            let commentStart = cursor
            cursor = cursor + 2
            columnNumber = columnNumber + 2
            var closed = false
            while cursor + 1 < spanLimit:
                if source[cursor] == '*' && source[cursor + 1] == '/':
                    cursor = cursor + 2
                    columnNumber = columnNumber + 2
                    closed = true
                    break
                if source[cursor] == '\n':
                    cursor = cursor + 1
                    lineNumber = lineNumber + 1
                    columnNumber = 1
                else:
                    cursor = cursor + 1
                    columnNumber = columnNumber + 1
            if !closed:
                tree.failureSpanExact = true
                tree.failureStartByte = commentStart
                tree.failureEndByte = spanLimit
                err = Fmt"parser value expr: unterminated block comment at offset {commentStart}"
                return false
            continue
        let tokenStart = cursor
        let tokenLine = lineNumber
        let tokenColumn = columnNumber
        if ParserValueExprIsIdentStart(ch):
            cursor = cursor + 1
            while cursor < spanLimit &&
                  ParserValueExprIsIdentContinue(source[cursor]):
                cursor = cursor + 1
            var kind = ParserValueExprKeywordKind(source, tokenStart, cursor)
            if tree.migrationSourceSyntax &&
               kind == ParserValueTokenIdentifier &&
               ((cursor - tokenStart == Len("proc") &&
                 ParserTextEqualsAt(
                    source, tokenStart, "proc")) ||
                (cursor - tokenStart == Len("method") &&
                 ParserTextEqualsAt(
                    source, tokenStart, "method")) ||
                (cursor - tokenStart == Len("converter") &&
                 ParserTextEqualsAt(
                    source, tokenStart, "converter"))):
                kind = ParserValueTokenFn
            if kind == ParserValueTokenIdentifier &&
               cursor - tokenStart == 3 &&
               ParserTextEqualsAt(source, tokenStart, "Fmt") &&
               cursor < spanLimit && source[cursor] == '"':
                var literalStop: int32
                if !ParserValueExprLexQuoted(source,
                                              tokenStart,
                                              cursor,
                                              spanLimit,
                                              '"',
                                              literalStop,
                                              err):
                    return false
                cursor = literalStop
                kind = ParserValueTokenFmtString
            # 洞解码流内嵌套 `Fmt\"...\"`: 与上行主词法 Fmt 特例同族——
            # 转义引号对由洞转义单元机配对, 整枚并成 FmtString token;
            # 否则 `Fmt` 被当裸标识符、紧随的转义串成独立字符串, 调用
            # 参数分隔处误判 delimiter(csgc_cargo 嵌套 Fmt 插值实证)。
            if kind == ParserValueTokenIdentifier &&
               cursor - tokenStart == 3 &&
               ParserTextEqualsAt(source, tokenStart, "Fmt") &&
               fmtHoleLex && cursor + 1 < spanLimit &&
               source[cursor] == '\\' && source[cursor + 1] == '"':
                var holeLiteralStop: int32
                var holeLiteralKind: int32
                if !parserValueExprLexHoleEscapedLiteral(source,
                                                          cursor,
                                                          spanLimit,
                                                          holeLiteralKind,
                                                          holeLiteralStop,
                                                          err):
                    return false
                cursor = holeLiteralStop
                kind = ParserValueTokenFmtString
            ParserValueExprAppendToken(tree,
                                         sourceTextId,
                                         kind,
                                         tokenStart,
                                         cursor,
                                         tokenLine,
                                         tokenColumn,
                                         0,
                                         tree.tokenCount,
                                         lexicalParentIndex)
            columnNumber = columnNumber + cursor - tokenStart
            continue
        if ch >= '0' && ch <= '9':
            var isFloat = false
            var radix: int32 = 10
            if cursor + 1 < spanLimit && ch == '0':
                if source[cursor + 1] == 'x' || source[cursor + 1] == 'X':
                    radix = 16
                elif source[cursor + 1] == 'b' || source[cursor + 1] == 'B':
                    radix = 2
                elif source[cursor + 1] == 'o' || source[cursor + 1] == 'O':
                    radix = 8
            cursor = cursor + 1
            while cursor < spanLimit:
                let numberCh = source[cursor]
                if radix == 10 && (numberCh == 'e' || numberCh == 'E'):
                    isFloat = true
                    cursor = cursor + 1
                    if cursor < spanLimit &&
                       (source[cursor] == '+' || source[cursor] == '-'):
                        cursor = cursor + 1
                    continue
                let decimalDigit = numberCh >= '0' && numberCh <= '9' &&
                                   (radix == 10 ||
                                    Int32(numberCh) - Int32('0') < radix)
                let hexDigit = radix == 16 &&
                               ((numberCh >= 'a' && numberCh <= 'f') ||
                                (numberCh >= 'A' && numberCh <= 'F'))
                let radixMarker = cursor == tokenStart + 1 &&
                                  ((radix == 16 &&
                                    (numberCh == 'x' || numberCh == 'X')) ||
                                   (radix == 2 &&
                                    (numberCh == 'b' || numberCh == 'B')) ||
                                   (radix == 8 &&
                                    (numberCh == 'o' || numberCh == 'O')))
                if decimalDigit || hexDigit || numberCh == '_' || radixMarker:
                    cursor = cursor + 1
                    continue
                if radix == 10 && numberCh == '.' &&
                   !(cursor + 1 < spanLimit && source[cursor + 1] == '.'):
                    isFloat = true
                    cursor = cursor + 1
                    continue
                break
            var kind = ParserValueTokenInteger
            if isFloat:
                kind = ParserValueTokenFloat
            ParserValueExprAppendToken(tree,
                                         sourceTextId,
                                         kind,
                                         tokenStart,
                                         cursor,
                                         tokenLine,
                                         tokenColumn,
                                         0,
                                         tree.tokenCount,
                                         lexicalParentIndex)
            columnNumber = columnNumber + cursor - tokenStart
            continue
        if ch == '"' || ch == '\'':
            var literalStop: int32
            if !ParserValueExprLexQuoted(source,
                                          tokenStart,
                                          tokenStart,
                                          spanLimit,
                                          ch,
                                          literalStop,
                                          err):
                tree.failureSpanExact = true
                tree.failureStartByte = tokenStart
                tree.failureEndByte = spanLimit
                return false
            cursor = literalStop
            var kind = ParserValueTokenString
            if ch == '\'':
                kind = ParserValueTokenChar
            ParserValueExprAppendToken(tree,
                                         sourceTextId,
                                         kind,
                                         tokenStart,
                                         cursor,
                                         tokenLine,
                                         tokenColumn,
                                         0,
                                         tree.tokenCount,
                                         lexicalParentIndex)
            columnNumber = columnNumber + cursor - tokenStart
            continue
        var tokenKind = ParserValueTokenInvalid
        var tokenLen: int32 = 1
        if cursor + 2 < spanLimit &&
           source[cursor] == '.' && source[cursor + 1] == '.' &&
           source[cursor + 2] == '<':
            tokenKind = ParserValueTokenRangeExclusive
            tokenLen = 3
        elif cursor + 1 < spanLimit:
            let next = source[cursor + 1]
            if ch == '-' && next == '>': tokenKind = ParserValueTokenArrow
            elif ch == '=' && next == '=': tokenKind = ParserValueTokenEqual
            elif ch == '!' && next == '=': tokenKind = ParserValueTokenNotEqual
            elif ch == '<' && next == '=': tokenKind = ParserValueTokenLessEqual
            elif ch == '>' && next == '=': tokenKind = ParserValueTokenGreaterEqual
            elif ch == '<' && next == '<': tokenKind = ParserValueTokenShiftLeft
            elif ch == '>' && next == '>': tokenKind = ParserValueTokenShiftRight
            elif ch == '&' && next == '&': tokenKind = ParserValueTokenLogicalAnd
            elif ch == '|' && next == '|': tokenKind = ParserValueTokenLogicalOr
            elif ch == '.' && next == '.': tokenKind = ParserValueTokenRangeInclusive
            if tokenKind != ParserValueTokenInvalid:
                tokenLen = 2
        if tokenKind == ParserValueTokenInvalid:
            if ch == '(': tokenKind = ParserValueTokenLeftParen
            elif ch == ')': tokenKind = ParserValueTokenRightParen
            elif ch == '[': tokenKind = ParserValueTokenLeftBracket
            elif ch == ']': tokenKind = ParserValueTokenRightBracket
            elif ch == '{': tokenKind = ParserValueTokenLeftBrace
            elif ch == '}': tokenKind = ParserValueTokenRightBrace
            elif ch == ',': tokenKind = ParserValueTokenComma
            elif ch == ':': tokenKind = ParserValueTokenColon
            elif ch == ';': tokenKind = ParserValueTokenSemicolon
            elif ch == '@': tokenKind = ParserValueTokenAt
            elif ch == '`': tokenKind = ParserValueTokenBacktick
            elif ch == '.': tokenKind = ParserValueTokenDot
            elif ch == '?': tokenKind = ParserValueTokenQuestion
            elif ch == '+': tokenKind = ParserValueTokenPlus
            elif ch == '-': tokenKind = ParserValueTokenMinus
            elif ch == '*': tokenKind = ParserValueTokenStar
            elif ch == '/': tokenKind = ParserValueTokenSlash
            elif ch == '%': tokenKind = ParserValueTokenPercent
            elif ch == '!': tokenKind = ParserValueTokenBang
            elif ch == '~': tokenKind = ParserValueTokenTilde
            elif ch == '$': tokenKind = ParserValueTokenDollar
            elif ch == '^': tokenKind = ParserValueTokenCaret
            elif ch == '&': tokenKind = ParserValueTokenAmp
            elif ch == '|': tokenKind = ParserValueTokenPipe
            elif ch == '=': tokenKind = ParserValueTokenAssign
            elif ch == '<': tokenKind = ParserValueTokenLess
            elif ch == '>': tokenKind = ParserValueTokenGreater
        if tokenKind == ParserValueTokenInvalid:
            tree.failureSpanExact = true
            tree.failureStartByte = cursor
            tree.failureEndByte = cursor + 1
            err = Fmt"parser value expr: unsupported token at offset {cursor}"
            return false
        ParserValueExprAppendToken(tree,
                                     sourceTextId,
                                     tokenKind,
                                     tokenStart,
                                     tokenStart + tokenLen,
                                     tokenLine,
                                     tokenColumn,
                                     0,
                                     tree.tokenCount,
                                     lexicalParentIndex)
        cursor = cursor + tokenLen
        columnNumber = columnNumber + tokenLen
    tokenCountOut = tree.tokenCount - tokenStartOut
    return true

@borrows
fn ParserValueExprNodeKindAt(tree: ParserValueExprTree,
                               nodeIndex: int32): ParserValueExprKind =
    ParserValueExprRequireNode(tree, nodeIndex)
    return ParserValueExprKind(arenamod.ArenaArrayInt32Get(
        tree.arena, tree.kinds, nodeIndex))

@borrows
fn ParserValueExprNodeSourceIdAt(tree: ParserValueExprTree,
                                   nodeIndex: int32): int32 =
    ParserValueExprRequireNode(tree, nodeIndex)
    return arenamod.ArenaArrayInt32Get(tree.arena,
                                        tree.sourceTextIds,
                                        nodeIndex)

@borrows
fn ParserValueExprNodeSpanStartAt(tree: ParserValueExprTree,
                                    nodeIndex: int32): int32 =
    ParserValueExprRequireNode(tree, nodeIndex)
    return arenamod.ArenaArrayInt32Get(tree.arena,
                                        tree.spanStarts,
                                        nodeIndex)

@borrows
fn ParserValueExprNodeSpanEndAt(tree: ParserValueExprTree,
                                  nodeIndex: int32): int32 =
    ParserValueExprRequireNode(tree, nodeIndex)
    return arenamod.ArenaArrayInt32Get(tree.arena,
                                        tree.spanEnds,
                                        nodeIndex)

@borrows
fn ParserValueExprNodeText(tree: ParserValueExprTree,
                             nodeIndex: int32): str =
    return ParserValueExprProjectSpan(
        tree,
        ParserValueExprNodeSourceIdAt(tree, nodeIndex),
        ParserValueExprNodeSpanStartAt(tree, nodeIndex),
        ParserValueExprNodeSpanEndAt(tree, nodeIndex))

@borrows
fn ParserValueExprNodeOptionalSpanText(tree: ParserValueExprTree,
                                         nodeIndex: int32,
                                         starts: arenamod.ArenaArrayInt32,
                                         ends: arenamod.ArenaArrayInt32): str =
    ParserValueExprRequireNode(tree, nodeIndex)
    return ParserValueExprProjectSpan(
        tree,
        ParserValueExprNodeSourceIdAt(tree, nodeIndex),
        arenamod.ArenaArrayInt32Get(tree.arena, starts, nodeIndex),
        arenamod.ArenaArrayInt32Get(tree.arena, ends, nodeIndex))

@borrows
fn ParserValueExprNodeAtomText(tree: ParserValueExprTree,
                                 nodeIndex: int32): str =
    return ParserValueExprNodeOptionalSpanText(tree,
                                                nodeIndex,
                                                tree.atomStarts,
                                                tree.atomEnds)

@borrows
fn ParserValueExprNodeOwnerText(tree: ParserValueExprTree,
                                  nodeIndex: int32): str =
    return ParserValueExprNodeOptionalSpanText(tree,
                                                nodeIndex,
                                                tree.ownerStarts,
                                                tree.ownerEnds)

@borrows
fn ParserValueExprNodeNameText(tree: ParserValueExprTree,
                                 nodeIndex: int32): str =
