@borrows
fn ParserValueExprStatementRootEndColumnAt(
        tree: ParserValueExprTree,
        rootIndex: int32): int32 =
    if tree.lifecycleState != ParserValueExprOwnerActive ||
       rootIndex < 0 || rootIndex >= tree.statementRootCount:
        panic("parser value expr: statement root end-column index out of bounds")
    return arenamod.ArenaArrayInt32Get(
        tree.arena, tree.statementRootEndColumnNumbers, rootIndex)

fn ParserValueExprSetStatementRootRole(
        tree: var ParserValueExprTree,
        rootIndex: int32,
        role: ParserValueExprStatementRole) =
    ParserValueExprTreeEnsureActive(tree)
    if rootIndex < 0 || rootIndex >= tree.statementRootCount:
        panic("parser value expr: statement root role set out of bounds")
    if role == ParserValueExprStatementInvalid:
        panic("parser value expr: statement root role set invalid")
    arenamod.ArenaArrayInt32Set(
        tree.arena, tree.statementRootRoles, rootIndex, Int32(role))

fn ParserValueExprSetStatementRootDeclarationAuthority(
        tree: var ParserValueExprTree,
        rootIndex: int32,
        declarationStart: int32,
        declarationCount: int32) =
    ParserValueExprTreeEnsureActive(tree)
    if rootIndex < 0 || rootIndex >= tree.statementRootCount:
        panic("parser value expr: statement root declaration authority index invalid")
    let role = ParserValueExprStatementRootRoleAt(tree, rootIndex)
    if (role != ParserValueExprStatementBindingInitializer &&
        role != ParserValueExprStatementTypeDefault &&
        role != ParserValueExprStatementParameterDefault) ||
       declarationStart < 0 || declarationCount <= 0 ||
       declarationStart > tree.declarationCount ||
       declarationCount > tree.declarationCount - declarationStart ||
       ParserValueExprStatementRootBindingDeclarationStartAt(
           tree, rootIndex) != -1 ||
       ParserValueExprStatementRootBindingDeclarationCountAt(
           tree, rootIndex) != 0:
        panic("parser value expr: statement root declaration authority invalid")
    if role == ParserValueExprStatementParameterDefault:
        if declarationCount != 1 ||
           ParserDeclarationKind(arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               declarationStart)) != ParserDeclarationParameter ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationDefaultStatementRootRows,
               declarationStart) != -1:
            panic("parser value expr: parameter default declaration authority invalid")
        arenamod.ArenaArrayInt32Set(
            tree.arena,
            tree.declarationDefaultStatementRootRows,
            declarationStart,
            rootIndex)
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.statementRootBindingDeclarationStarts,
        rootIndex,
        declarationStart)
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.statementRootBindingDeclarationCounts,
        rootIndex,
        declarationCount)

fn ParserValueExprAppendStatementRoot(tree: var ParserValueExprTree,
                                        nodeIndex: int32,
                                        role: ParserValueExprStatementRole,
                                        anchorTokenIndex: int32,
                                        endTokenIndex: int32) =
    ParserValueExprRequireNode(tree, nodeIndex)
    ParserValueExprRequireToken(tree, anchorTokenIndex)
    ParserValueExprRequireToken(tree, endTokenIndex)
    if role == ParserValueExprStatementInvalid:
        panic("parser value expr: statement root role is invalid")
    if ParserValueExprTokenSourceIdAt(tree, endTokenIndex) !=
           ParserValueExprNodeSourceIdAt(tree, nodeIndex) ||
       ParserValueExprTokenEndAt(tree, endTokenIndex) !=
           ParserValueExprNodeSpanEndAt(tree, nodeIndex):
        panic("parser value expr: statement root end token differs from node")
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.statementRootNodeIndexes,
                                 nodeIndex)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.statementRootRoles,
                                 Int32(role))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.statementRootAnchorTokenIndexes,
        anchorTokenIndex)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.statementRootBindingDeclarationStarts,
        -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.statementRootBindingDeclarationCounts,
        0)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.statementRootAnchorLineNumbers,
        ParserValueExprTokenLineAt(tree, anchorTokenIndex))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.statementRootAnchorColumnNumbers,
        ParserValueExprTokenColumnAt(tree, anchorTokenIndex))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.statementRootEndLineNumbers,
        ParserValueExprTokenLineAt(tree, endTokenIndex))
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.statementRootEndColumnNumbers,
        ParserValueExprTokenColumnAt(tree, endTokenIndex) +
            ParserValueExprTokenEndAt(tree, endTokenIndex) -
            ParserValueExprTokenStartAt(tree, endTokenIndex) - 1)
    if ParserValueExprNodeDirectStatementRootEventAt(tree, nodeIndex) >= 0:
        panic("parser value expr: node is root of two statement events")
    arenamod.ArenaArrayInt32Set(
        tree.arena,
        tree.nodeStatementRootEventIndexes,
        nodeIndex,
        tree.statementRootCount)
    tree.statementRootCount = tree.statementRootCount + 1

@borrows
fn ParserValueExprSetNodeSpanColumn(tree: var ParserValueExprTree,
                                      nodeIndex: int32,
                                      starts: arenamod.ArenaArrayInt32,
                                      ends: arenamod.ArenaArrayInt32,
                                      spanStart: int32,
                                      spanEnd: int32) =
    ParserValueExprRequireNode(tree, nodeIndex)
    # Bounds check needs only the source length; ParserValueExprSourceText
    # is a full byte copy per call and this setter runs for every span
    # column of every node (same disease as the AppendToken lexing blowup).
    let sourceLen = ParserValueExprSourceLen(
        tree, ParserValueExprNodeSourceIdAt(tree, nodeIndex))
    if (spanStart < 0 || spanEnd < 0) &&
       !(spanStart == -1 && spanEnd == -1):
        panic("parser value expr: half-empty optional span")
    if spanStart >= 0 && (spanEnd < spanStart || spanEnd > sourceLen):
        panic("parser value expr: optional span out of bounds")
    arenamod.ArenaArrayInt32Set(tree.arena, starts, nodeIndex, spanStart)
    arenamod.ArenaArrayInt32Set(tree.arena, ends, nodeIndex, spanEnd)

fn ParserValueExprSetNodeAtom(tree: var ParserValueExprTree,
                                nodeIndex: int32,
                                spanStart: int32,
                                spanEnd: int32) =
    ParserValueExprSetNodeSpanColumn(tree,
                                      nodeIndex,
                                      tree.atomStarts,
                                      tree.atomEnds,
                                      spanStart,
                                      spanEnd)

fn ParserValueExprSetNodeOwnerName(tree: var ParserValueExprTree,
                                     nodeIndex: int32,
                                     ownerStart: int32,
                                     ownerEnd: int32,
                                     nameStart: int32,
                                     nameEnd: int32) =
    ParserValueExprSetNodeSpanColumn(tree,
                                      nodeIndex,
                                      tree.ownerStarts,
                                      tree.ownerEnds,
                                      ownerStart,
                                      ownerEnd)
    ParserValueExprSetNodeSpanColumn(tree,
                                      nodeIndex,
                                      tree.nameStarts,
                                      tree.nameEnds,
                                      nameStart,
                                      nameEnd)

fn ParserValueExprSetNodeOperator(tree: var ParserValueExprTree,
                                    nodeIndex: int32,
                                    spanStart: int32,
                                    spanEnd: int32) =
    ParserValueExprSetNodeSpanColumn(tree,
                                      nodeIndex,
                                      tree.operatorStarts,
                                      tree.operatorEnds,
                                      spanStart,
                                      spanEnd)

fn ParserValueExprSetNodeArgumentName(tree: var ParserValueExprTree,
                                        nodeIndex: int32,
                                        spanStart: int32,
                                        spanEnd: int32) =
    ParserValueExprSetNodeSpanColumn(tree,
                                      nodeIndex,
                                      tree.argumentNameStarts,
                                      tree.argumentNameEnds,
                                      spanStart,
                                      spanEnd)

fn ParserValueExprSetNodeCallArgsSpan(tree: var ParserValueExprTree,
                                        nodeIndex: int32,
                                        spanStart: int32,
                                        spanEnd: int32) =
    ParserValueExprSetNodeSpanColumn(tree,
                                      nodeIndex,
                                      tree.callArgsStarts,
                                      tree.callArgsEnds,
                                      spanStart,
                                      spanEnd)

fn ParserValueExprSetNextSibling(tree: var ParserValueExprTree,
                                   nodeIndex: int32,
                                   siblingIndex: int32) =
    ParserValueExprRequireNode(tree, nodeIndex)
    if siblingIndex >= tree.nodeCount:
        panic("parser value expr: sibling index out of bounds")
    arenamod.ArenaArrayInt32Set(tree.arena,
                                 tree.nextSiblings,
                                 nodeIndex,
                                 siblingIndex)

fn parserValueExprAppendNodeColumns(tree: var ParserValueExprTree,
                               sourceTextId: int32,
                               kind: ParserValueExprKind,
                               spanStart: int32,
                               spanEnd: int32,
                               firstChild: int32,
                               childCount: int32): int32 =
    ParserValueExprTreeEnsureActive(tree)
    if tree.lexicalBindingAuthoritySealed:
        panic("parser value expr: sealed node mutation")
    let source = ParserValueExprSourceText(tree, sourceTextId)
    if kind == ParserValueExprInvalid || spanStart < 0 ||
       spanEnd <= spanStart || spanEnd > source.len:
        panic("parser value expr: invalid node append")
    let nodeIndex = tree.nodeCount
    arenamod.ArenaArrayInt32Add(tree.arena, tree.kinds, Int32(kind))
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.nodeProducerSourceIndexes, 0)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.nodeSourceLocalIndexes, nodeIndex)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.sourceTextIds,
                                 sourceTextId)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.spanStarts, spanStart)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.spanEnds, spanEnd)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.atomStarts, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.atomEnds, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.ownerStarts, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.ownerEnds, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.nameStarts, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.nameEnds, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.operatorStarts, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.operatorEnds, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.argumentNameStarts, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.argumentNameEnds, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.callArgsStarts, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.callArgsEnds, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.argumentRootStarts, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.argumentRootCounts, 0)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.firstChilds, firstChild)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.childCounts, childCount)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.nextSiblings, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.parentNodeIndexes, -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.nodeStatementRootEventIndexes, -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.nodeLexicalScopeRows,
        tree.activeDeclarationLexicalScopeRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.nodeBindingResolutionKinds,
        Int32(ParserValueExprBindingResolutionNone))
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.nodeResolvedBindingDeclarationRows, -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.nodeResolvedBindingPatternRows, -1)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.explicitGenericStarts,
                                 tree.genericCount)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.explicitGenericCounts,
                                 0)
    if kind == ParserValueExprCall || kind == ParserValueExprSpaceCall:
        arenamod.ArenaArrayInt32Add(tree.arena,
                                     tree.callEventNodeIndexes,
                                     nodeIndex)
        tree.callEventCount = tree.callEventCount + 1
    tree.nodeCount = tree.nodeCount + 1
    return nodeIndex

fn ParserValueExprAppendNode1(tree: var ParserValueExprTree,
                               sourceTextId: int32,
                               kind: ParserValueExprKind,
                               spanStart: int32,
                               spanEnd: int32,
                               child0: int32): int32 =
    # [gk-knife] single-child append: identical row columns and child wiring
    # to ParserValueExprAppendNode with a one-element list, minus the heap
    # children buffer (per-iteration redeclared seqs leak one block each).
    ParserValueExprTreeEnsureActive(tree)
    if tree.lexicalBindingAuthoritySealed:
        panic("parser value expr: sealed node mutation")
    ParserValueExprRequireNode(tree, child0)
    if ParserValueExprNodeParentAt(tree, child0) >= 0:
        panic("parser value expr: value node has two parents")
    ParserValueExprSetNextSibling(tree, child0, -1)
    arenamod.ArenaArrayInt32Set(tree.arena,
                                 tree.parentNodeIndexes,
                                 child0,
                                 tree.nodeCount)
    return parserValueExprAppendNodeColumns(tree,
                                             sourceTextId,
                                             kind,
                                             spanStart,
                                             spanEnd,
                                             child0,
                                             1)

fn ParserValueExprAppendNode2(tree: var ParserValueExprTree,
                               sourceTextId: int32,
                               kind: ParserValueExprKind,
                               spanStart: int32,
                               spanEnd: int32,
                               child0: int32,
                               child1: int32): int32 =
    # [gk-knife] two-child append: identical row columns and child wiring
    # to ParserValueExprAppendNode with a two-element list (see above).
    ParserValueExprTreeEnsureActive(tree)
    if tree.lexicalBindingAuthoritySealed:
        panic("parser value expr: sealed node mutation")
    ParserValueExprRequireNode(tree, child0)
    if ParserValueExprNodeParentAt(tree, child0) >= 0:
        panic("parser value expr: value node has two parents")
    ParserValueExprRequireNode(tree, child1)
    if ParserValueExprNodeParentAt(tree, child1) >= 0:
        panic("parser value expr: value node has two parents")
    ParserValueExprSetNextSibling(tree, child0, child1)
    ParserValueExprSetNextSibling(tree, child1, -1)
    arenamod.ArenaArrayInt32Set(tree.arena,
                                 tree.parentNodeIndexes,
                                 child0,
                                 tree.nodeCount)
    arenamod.ArenaArrayInt32Set(tree.arena,
                                 tree.parentNodeIndexes,
                                 child1,
                                 tree.nodeCount)
    return parserValueExprAppendNodeColumns(tree,
                                             sourceTextId,
                                             kind,
                                             spanStart,
                                             spanEnd,
                                             child0,
                                             2)

fn ParserValueExprAppendNode(tree: var ParserValueExprTree,
                               sourceTextId: int32,
                               kind: ParserValueExprKind,
                               spanStart: int32,
                               spanEnd: int32,
                               children: int32[]): int32 =
    ParserValueExprTreeEnsureActive(tree)
    if tree.lexicalBindingAuthoritySealed:
        panic("parser lexical binding: sealed node mutation")
    let source = ParserValueExprSourceText(tree, sourceTextId)
    if kind == ParserValueExprInvalid || spanStart < 0 ||
       spanEnd <= spanStart || spanEnd > source.len:
        panic("parser value expr: invalid node append")
    let nodeIndex = tree.nodeCount
    for childIndex in 0..<children.len:
        let child = children[childIndex]
        ParserValueExprRequireNode(tree, child)
        if ParserValueExprNodeParentAt(tree, child) >= 0:
            panic("parser value expr: value node has two parents")
        let sibling = if childIndex + 1 < children.len: children[childIndex + 1] else: -1
        ParserValueExprSetNextSibling(tree, child, sibling)
        arenamod.ArenaArrayInt32Set(tree.arena,
                                     tree.parentNodeIndexes,
                                     child,
                                     nodeIndex)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.kinds, Int32(kind))
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.nodeProducerSourceIndexes, 0)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.nodeSourceLocalIndexes, nodeIndex)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.sourceTextIds,
                                 sourceTextId)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.spanStarts, spanStart)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.spanEnds, spanEnd)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.atomStarts, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.atomEnds, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.ownerStarts, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.ownerEnds, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.nameStarts, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.nameEnds, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.operatorStarts, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.operatorEnds, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.argumentNameStarts, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.argumentNameEnds, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.callArgsStarts, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.callArgsEnds, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.argumentRootStarts, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.argumentRootCounts, 0)
    let firstChild = if children.len > 0: children[0] else: -1
    arenamod.ArenaArrayInt32Add(tree.arena, tree.firstChilds, firstChild)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.childCounts, children.len)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.nextSiblings, -1)
    arenamod.ArenaArrayInt32Add(tree.arena, tree.parentNodeIndexes, -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.nodeStatementRootEventIndexes, -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.nodeLexicalScopeRows,
        tree.activeDeclarationLexicalScopeRow)
    arenamod.ArenaArrayInt32Add(
        tree.arena,
        tree.nodeBindingResolutionKinds,
        Int32(ParserValueExprBindingResolutionNone))
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.nodeResolvedBindingDeclarationRows, -1)
    arenamod.ArenaArrayInt32Add(
        tree.arena, tree.nodeResolvedBindingPatternRows, -1)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.explicitGenericStarts,
                                 tree.genericCount)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.explicitGenericCounts,
                                 0)
    tree.nodeCount = tree.nodeCount + 1
    if kind == ParserValueExprCall || kind == ParserValueExprSpaceCall:
        arenamod.ArenaArrayInt32Add(tree.arena,
                                     tree.callEventNodeIndexes,
                                     nodeIndex)
        tree.callEventCount = tree.callEventCount + 1
    return nodeIndex

fn ParserValueExprAppendGenericSpan(tree: var ParserValueExprTree,
                                      spanStart: int32,
                                      spanEnd: int32) =
    if tree.lifecycleState != ParserValueExprOwnerActive ||
       spanStart < 0 || spanEnd <= spanStart:
        panic("parser value expr: invalid generic span")
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.explicitGenericSpanStarts,
                                 spanStart)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.explicitGenericSpanEnds,
                                 spanEnd)
    tree.genericCount = tree.genericCount + 1

fn ParserValueExprAppendRegion(tree: var ParserValueExprTree,
                                 kind: ParserValueExprRegionKind,
                                 sourceTextId: int32,
                                 spanStart: int32,
                                 spanEnd: int32,
                                 anchorTokenIndex: int32) =
    if tree.lifecycleState != ParserValueExprOwnerActive ||
       kind == ParserValueExprRegionInvalid || sourceTextId < 0 ||
       spanStart < 0 || spanEnd <= spanStart ||
       anchorTokenIndex < 0 || anchorTokenIndex >= tree.tokenCount:
        panic("parser value expr: invalid region span")
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.regionKinds,
                                 Int32(kind))
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.regionSourceTextIds,
                                 sourceTextId)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.regionSpanStarts,
                                 spanStart)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.regionSpanEnds,
                                 spanEnd)
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.regionAnchorTokenIndexes,
                                 anchorTokenIndex)
    tree.regionCount = tree.regionCount + 1

