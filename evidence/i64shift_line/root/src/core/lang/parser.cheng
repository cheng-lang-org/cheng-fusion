        tree.arena,
        tree.statementRootBindingDeclarationCounts,
        rootIndex)

# Exact authority for a statement value owned by a source/type declaration
# rather than by a function.  CompilerCSG uses this to partition full-source
# normalized rows without treating the complement of function line ranges as
# proof.
@borrows
fn ParserValueExprStatementRootIsNonFunctionDeclarationValue(
        tree: ParserValueExprTree,
        rootIndex: int32): bool =
    if tree == nil ||
       tree.lifecycleState != ParserValueExprOwnerActive ||
       rootIndex < 0 || rootIndex >= tree.statementRootCount:
        return false
    let role = ParserValueExprStatementRootRoleAt(tree, rootIndex)
    if role != ParserValueExprStatementBindingInitializer &&
       role != ParserValueExprStatementTypeDefault:
        return false
    let declarationStart =
        ParserValueExprStatementRootBindingDeclarationStartAt(
            tree, rootIndex)
    let declarationCount =
        ParserValueExprStatementRootBindingDeclarationCountAt(
            tree, rootIndex)
    if declarationStart < 0 || declarationCount <= 0 ||
       declarationStart > tree.declarationCount ||
       declarationCount > tree.declarationCount - declarationStart:
        return false
    for declarationRow in declarationStart..<declarationStart + declarationCount:
        let declarationKind = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationKinds, declarationRow)
        let functionRow = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.declarationFunctionRows, declarationRow)
        let lexicalScopeRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeRows,
            declarationRow)
        if functionRow != -1 ||
           lexicalScopeRow < 0 ||
           lexicalScopeRow >= tree.declarationLexicalScopeCount:
            return false
        let lexicalScopeKind = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationLexicalScopeKinds,
            lexicalScopeRow)
        if declarationKind == Int32(ParserDeclarationLocal):
            if lexicalScopeKind !=
                   Int32(ParserDeclarationLexicalScopeSource):
                return false
        elif declarationKind == Int32(ParserDeclarationField):
            if lexicalScopeKind !=
                   Int32(ParserDeclarationLexicalScopeType):
                return false
        elif declarationKind == Int32(ParserDeclarationType):
            if lexicalScopeKind !=
                   Int32(ParserDeclarationLexicalScopeSource):
                return false
        else:
            return false
    return true

# Exact authority for a bare expression owned directly by the source lexical
# scope.  This is the parser edge used by CompilerCSG for the entry source's
# final `main()` expression; consumers must not infer it from line position or
# expression text.
@borrows
fn ParserValueExprStatementRootIsSourceExpressionValue(
        tree: ParserValueExprTree,
        rootIndex: int32): bool =
    if tree == nil ||
       tree.lifecycleState != ParserValueExprOwnerActive ||
       rootIndex < 0 || rootIndex >= tree.statementRootCount ||
       ParserValueExprStatementRootRoleAt(tree, rootIndex) !=
           ParserValueExprStatementExpression ||
       ParserValueExprStatementRootBindingDeclarationStartAt(
           tree, rootIndex) != -1 ||
       ParserValueExprStatementRootBindingDeclarationCountAt(
           tree, rootIndex) != 0:
        return false
    let rootNode = ParserValueExprStatementRootNodeAt(tree, rootIndex)
    if rootNode < 0 || rootNode >= tree.nodeCount:
        return false
    let lexicalScopeRow = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.nodeLexicalScopeRows, rootNode)
    if lexicalScopeRow < 0 ||
       lexicalScopeRow >= tree.declarationLexicalScopeCount ||
       ParserDeclarationLexicalScopeKind(
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeKinds,
               lexicalScopeRow)) != ParserDeclarationLexicalScopeSource ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationLexicalScopeParentRows,
           lexicalScopeRow) != -1 ||
       arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationLexicalScopeOwnerDeclarationRows,
           lexicalScopeRow) != -1:
        return false
    return ParserValueExprLexicalScopeFunctionRow(
        tree, lexicalScopeRow) == -1

@borrows
fn ParserValueExprStatementRootAnchorLineAt(
        tree: ParserValueExprTree,
        rootIndex: int32): int32 =
    if tree.lifecycleState != ParserValueExprOwnerActive ||
       rootIndex < 0 || rootIndex >= tree.statementRootCount:
        panic("parser value expr: statement root line index out of bounds")
    return arenamod.ArenaArrayInt32Get(
        tree.arena, tree.statementRootAnchorLineNumbers, rootIndex)

