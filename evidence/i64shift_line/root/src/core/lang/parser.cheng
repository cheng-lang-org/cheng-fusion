    if tree.lifecycleState != ParserValueExprOwnerActive ||
       eventIndex < 0 || eventIndex >= tree.callEventCount:
        panic("parser value expr: call event index out of bounds")
    return arenamod.ArenaArrayInt32Get(tree.arena,
                                        tree.callEventNodeIndexes,
                                        eventIndex)

