@borrows
fn ParserValueExprNodeExplicitGenericCount(
        tree: ParserValueExprTree,
        nodeIndex: int32): int32 =
    ParserValueExprRequireNode(tree, nodeIndex)
    return arenamod.ArenaArrayInt32Get(
        tree.arena, tree.explicitGenericCounts, nodeIndex)

@borrows
fn ParserValueExprNodeExplicitGenericText(
        tree: ParserValueExprTree,
        nodeIndex: int32,
        genericOrdinal: int32): str =
    ParserValueExprRequireNode(tree, nodeIndex)
    let genericStart = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.explicitGenericStarts, nodeIndex)
    let genericCount = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.explicitGenericCounts, nodeIndex)
    if genericOrdinal < 0 || genericOrdinal >= genericCount:
        panic("parser value expr: explicit generic ordinal out of bounds")
    let genericIndex = genericStart + genericOrdinal
    return ParserValueExprProjectSpan(
        tree,
        ParserValueExprNodeSourceIdAt(tree, nodeIndex),
        arenamod.ArenaArrayInt32Get(
            tree.arena, tree.explicitGenericSpanStarts, genericIndex),
        arenamod.ArenaArrayInt32Get(
            tree.arena, tree.explicitGenericSpanEnds, genericIndex))

@borrows
fn ParserValueExprNodeFirstChild(tree: ParserValueExprTree,
                                   nodeIndex: int32): int32 =
    ParserValueExprRequireNode(tree, nodeIndex)
    return arenamod.ArenaArrayInt32Get(tree.arena,
                                        tree.firstChilds,
                                        nodeIndex)

