    return arenamod.ArenaArrayInt32Get(tree.arena,
                                        tree.parentNodeIndexes,
                                        nodeIndex)

@borrows
fn ParserValueExprNodeDirectStatementRootEventAt(
        tree: ParserValueExprTree,
        nodeIndex: int32): int32 =
    ParserValueExprRequireNode(tree, nodeIndex)
    return arenamod.ArenaArrayInt32Get(
        tree.arena, tree.nodeStatementRootEventIndexes, nodeIndex)

@borrows
fn ParserValueExprNodeEnclosingStatementRootEventAt(
        tree: ParserValueExprTree,
        nodeIndex: int32): int32 =
    ParserValueExprRequireNode(tree, nodeIndex)
    var cursor = nodeIndex
    while cursor >= 0:
        let eventIndex = ParserValueExprNodeDirectStatementRootEventAt(
            tree, cursor)
        if eventIndex >= 0:
            return eventIndex
        cursor = ParserValueExprNodeParentAt(tree, cursor)
    return -1

@borrows
fn ParserValueExprNodeEnclosingStatementRootNodeAt(
        tree: ParserValueExprTree,
        nodeIndex: int32): int32 =
    let eventIndex = ParserValueExprNodeEnclosingStatementRootEventAt(
        tree, nodeIndex)
    if eventIndex < 0:
        return -1
    return ParserValueExprStatementRootNodeAt(tree, eventIndex)

@borrows
fn ParserValueExprNodeEnclosingStatementRoleAt(
        tree: ParserValueExprTree,
        nodeIndex: int32): ParserValueExprStatementRole =
    let eventIndex = ParserValueExprNodeEnclosingStatementRootEventAt(
        tree, nodeIndex)
    if eventIndex < 0:
        return ParserValueExprStatementInvalid
    return ParserValueExprStatementRootRoleAt(tree, eventIndex)

@borrows
fn ParserValueExprNodeArgumentRootStart(tree: ParserValueExprTree,
                                          nodeIndex: int32): int32 =
    ParserValueExprRequireNode(tree, nodeIndex)
    return arenamod.ArenaArrayInt32Get(tree.arena,
                                        tree.argumentRootStarts,
                                        nodeIndex)

@borrows
fn ParserValueExprNodeArgumentRootCount(tree: ParserValueExprTree,
                                          nodeIndex: int32): int32 =
    ParserValueExprRequireNode(tree, nodeIndex)
    return arenamod.ArenaArrayInt32Get(tree.arena,
                                        tree.argumentRootCounts,
                                        nodeIndex)

@borrows
fn ParserValueExprRootNodeAt(tree: ParserValueExprTree,
                               rootIndex: int32): int32 =
    if tree.lifecycleState != ParserValueExprOwnerActive ||
       rootIndex < 0 || rootIndex >= tree.rootCount:
        panic("parser value expr: root index out of bounds")
    return arenamod.ArenaArrayInt32Get(tree.arena,
                                        tree.rootNodeIndexes,
                                        rootIndex)

@borrows
fn ParserValueExprCallEventNodeAt(tree: ParserValueExprTree,
