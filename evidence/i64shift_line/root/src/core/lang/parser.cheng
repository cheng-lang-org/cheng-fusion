# Pass-1 side: reserve every column at the census length before the first
# append, so no column ever abandons a block.
@borrows
fn ParserValueExprTreeArenaColumnCensusApply(
        tree: var ParserValueExprTree,
        census: int32[],
        base: int32,
        err: var str): bool =
    if tree == nil ||
       tree.lifecycleState != ParserValueExprOwnerActive ||
       base < 0 ||
       base + ParserValueExprTreeArenaColumnCount > census.len:
        err = "parser value expr: tree arena column census shape invalid"
        return false
    var cursor: int32 = base
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           tree.arena, tree.kinds, census[cursor]):
        err = "parser value expr: tree arena column census reserve failed column=kinds"
        return false
    cursor = cursor + 1
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           tree.arena, tree.nodeProducerSourceIndexes, census[cursor]):
        err = "parser value expr: tree arena column census reserve failed column=nodeProducerSourceIndexes"
        return false
    cursor = cursor + 1
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           tree.arena, tree.nodeSourceLocalIndexes, census[cursor]):
        err = "parser value expr: tree arena column census reserve failed column=nodeSourceLocalIndexes"
        return false
    cursor = cursor + 1
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           tree.arena, tree.sourceTextIds, census[cursor]):
        err = "parser value expr: tree arena column census reserve failed column=sourceTextIds"
        return false
    cursor = cursor + 1
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           tree.arena, tree.sourceTextLengths, census[cursor]):
        err = "parser value expr: tree arena column census reserve failed column=sourceTextLengths"
        return false
    cursor = cursor + 1
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           tree.arena, tree.spanStarts, census[cursor]):
        err = "parser value expr: tree arena column census reserve failed column=spanStarts"
        return false
    cursor = cursor + 1
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           tree.arena, tree.spanEnds, census[cursor]):
        err = "parser value expr: tree arena column census reserve failed column=spanEnds"
        return false
    cursor = cursor + 1
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           tree.arena, tree.atomStarts, census[cursor]):
        err = "parser value expr: tree arena column census reserve failed column=atomStarts"
        return false
    cursor = cursor + 1
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           tree.arena, tree.atomEnds, census[cursor]):
        err = "parser value expr: tree arena column census reserve failed column=atomEnds"
        return false
    cursor = cursor + 1
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           tree.arena, tree.ownerStarts, census[cursor]):
        err = "parser value expr: tree arena column census reserve failed column=ownerStarts"
        return false
    cursor = cursor + 1
    if !arenamod.ArenaArrayInt32ReserveEmpty(
