@borrows
fn ParserValueExprTypeSyntaxKindAt(
        tree: ParserValueExprTree,
        nodeIndex: int32): ParserTypeSyntaxKind =
    return ParserTypeSyntaxKind(ParserValueExprTypeSyntaxColumnAt(
        tree, tree.typeSyntaxKinds, nodeIndex))

fn ParserTypeSyntaxKindText(kind: ParserTypeSyntaxKind): str =
    if kind == ParserTypeSyntaxNominal: return "ParserTypeSyntaxNominal"
    if kind == ParserTypeSyntaxQualified: return "ParserTypeSyntaxQualified"
    if kind == ParserTypeSyntaxBracketApply:
        return "ParserTypeSyntaxBracketApply"
    if kind == ParserTypeSyntaxSeq: return "ParserTypeSyntaxSeq"
    if kind == ParserTypeSyntaxFixedArray:
        return "ParserTypeSyntaxFixedArray"
    if kind == ParserTypeSyntaxTuple: return "ParserTypeSyntaxTuple"
    if kind == ParserTypeSyntaxFunction: return "ParserTypeSyntaxFunction"
    if kind == ParserTypeSyntaxVarBorrow:
        return "ParserTypeSyntaxVarBorrow"
    if kind == ParserTypeSyntaxAlias: return "ParserTypeSyntaxAlias"
    if kind == ParserTypeSyntaxObject: return "ParserTypeSyntaxObject"
    if kind == ParserTypeSyntaxRefObject:
        return "ParserTypeSyntaxRefObject"
    if kind == ParserTypeSyntaxImplicitObject:
        return "ParserTypeSyntaxImplicitObject"
    if kind == ParserTypeSyntaxEnum: return "ParserTypeSyntaxEnum"
    if kind == ParserTypeSyntaxVariant: return "ParserTypeSyntaxVariant"
    if kind == ParserTypeSyntaxAlgebraic:
        return "ParserTypeSyntaxAlgebraic"
    if kind == ParserTypeSyntaxGrouped:
        return "ParserTypeSyntaxGrouped"
    if kind == ParserTypeSyntaxOptional:
        return "ParserTypeSyntaxOptional"
    return "ParserTypeSyntaxInvalid"

