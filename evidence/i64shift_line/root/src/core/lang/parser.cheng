@borrows
fn NormalizedExprLayerAppendStructuredStatement(layer: var NormalizedExprLayer,
                                                  sourcePath: str,
                                                  seed: ParserStructuredStatementSeed) =
    if seed.anchorTokenIndex < 0 ||
       seed.spanStart < 0 ||
       seed.spanEnd <= seed.spanStart:
        panic("structured statement parser anchor missing")
    var expr: NormalizedExpr
    expr.exprId = NormalizedExprMakeId(sourcePath,
                                         seed.lineNumber,
                                         seed.columnNumber,
                                         seed.kind,
                                         NormalizedExprDetailNone)
    expr.sourcePath = strings.CloneStr(sourcePath)
    expr.lineNumber = seed.lineNumber
    expr.columnNumber = seed.columnNumber
    expr.endLineNumber = seed.endLineNumber
    expr.endColumnNumber = seed.endColumnNumber
    expr.kind = seed.kind
    expr.detailKind = NormalizedExprDetailNone
    expr.surfaceText = seed.surfaceText
    expr.callSurfaceKind = NormalizedExprSurfaceCallNone
    expr.callResolved = false
    expr.callReason = NormalizedExprCallReasonNone
    expr.callQualifier = ""
    expr.callCallee = ""
    expr.callTarget = ""
    expr.callTargetSourcePath = ""
    expr.callTargetImportc = false
    expr.callPrefixStyle = false
    expr.callArgCount = 0
    expr.callArgsText = ""
    expr.valueExprCallNodeIndex = -1
    expr.originParserNodeId = -1
    expr.callArgValueRootStart = -1
    expr.callArgValueRootCount = 0
    expr.valueExprRootNodeIndex = -1
    expr.valueExprSpanStart = seed.spanStart
    expr.valueExprSpanEnd = seed.spanEnd
    expr.valueExprStatementRole = ParserValueExprStatementInvalid
    expr.anchorTokenIndex = seed.anchorTokenIndex
    expr.lexicalScopeId = seed.lexicalScopeId
    expr.suiteScopeId = seed.suiteScopeId
    expr.statementOrdinal = seed.statementOrdinal
    expr.lexicalOrdinal = seed.lexicalOrdinal
    expr.deferOwnerStatementOrdinal = seed.deferOwnerStatementOrdinal
    if NormalizedExprLayerContainsExpr(layer, expr):
        return
    add(layer.exprs, expr)
    add(layer.exprNext, -1)
    if layer.exprs[layer.exprs.len - 1].kind == NormalizedExprIf &&
       layer.exprs[layer.exprs.len - 1].lineNumber == 0 &&
       layer.exprs[layer.exprs.len - 1].sourcePath == "":
        panic("parser value expr: A5 StructuredStatement append produced zero slot")
    NormalizedExprLayerRememberExpr(layer, layer.exprs.len - 1)

@borrows
fn NormalizedExprLayerAppendScope(layer: var NormalizedExprLayer,
                                    sourcePath: str,
                                    parentScopeId: int32,
                                    kind: NormalizedScopeKind,
                                    ownerStatementOrdinal: int32,
                                    lexicalOrdinal: int32,
                                    indentColumn: int32,
                                    startLineNumber: int32,
                                    startColumnNumber: int32,
                                    endLineNumber: int32,
                                    endColumnNumber: int32): int32 =
    let scopeId = layer.scopes.len
    var scope: NormalizedScopeFact
    scope.sourcePath = share(sourcePath)
    scope.scopeId = scopeId
    scope.sourceScopeId = scope.scopeId
    scope.parentScopeId = parentScopeId
    scope.kind = kind
    scope.ownerStatementOrdinal = ownerStatementOrdinal
    scope.ownerStatementRow = -1
    scope.ownerDeclarationRow = -1
    scope.moduleRootAnchor = kind == NormalizedScopeRoot
    scope.lexicalOrdinal = lexicalOrdinal
    scope.indentColumn = indentColumn
    scope.startLineNumber = startLineNumber
    scope.startColumnNumber = startColumnNumber
    scope.endLineNumber = endLineNumber
    scope.endColumnNumber = endColumnNumber
    scope.anchorTokenIndex = -1
    add(layer.scopes, scope)
    return scopeId

fn NormalizedExprLayerAdd(total: var NormalizedExprLayer,
                            delta: var NormalizedExprLayer) =
    if normalizedExprLayerDescriptorsAlias(total, delta):
        panic("parser value expr: layer add source aliases destination descriptor")
    if total.valueExprTreeBorrowLease:
        panic("parser value expr: cannot append into borrowed layer tree")
    if delta.valueExprTreeBorrowLease:
        panic("parser value expr: cannot commit-copy borrowed source layer tree")
    if total.valueExprTree != nil &&
       total.valueExprTree == delta.valueExprTree:
        panic("parser value expr: layer add has duplicate owner descriptors")
    total.sourceCount = total.sourceCount + delta.sourceCount
    total.questionResidualCount = total.questionResidualCount + delta.questionResidualCount
    var valueNodeOffset: int32
    var valueRootOffset: int32
    var valueTokenOffset: int32
    var valueDeclarationOffset: int32
    let valueExprRowOffset = total.exprs.len
    if ParserValueExprTreeIsActive(total.valueExprTree):
        valueNodeOffset = total.valueExprTree.nodeCount
        valueRootOffset = total.valueExprTree.rootCount
        valueTokenOffset = total.valueExprTree.tokenCount
        valueDeclarationOffset = total.valueExprTree.declarationCount
    ParserValueExprTreeAppendFrom(total.valueExprTree, delta.valueExprTree)
    ParserValueExprTreeRequireSingleProductionCommitCopy(total.valueExprTree)
    # Scope identity is (sourcePath, localScopeId). Physical array offsets are
    # resolved by the per-source scope index; merging must not rewrite IDs.
    for i in 0..<delta.exprs.len:
        var expr: NormalizedExpr
        NormalizedExprCloneInto(delta.exprs[i], expr)
        if expr.valueExprCallNodeIndex >= 0:
            if expr.originParserNodeId < 0 ||
               expr.originParserNodeId >= delta.valueExprTree.nodeCount ||
               expr.originParserNodeId !=
                   ParserValueExprNodeSourceLocalIndexAt(
                       delta.valueExprTree,
                       expr.valueExprCallNodeIndex):
                panic("parser value expr: call has invalid source-local origin")
        elif expr.originParserNodeId >= 0:
            if expr.originParserNodeId >= delta.valueExprTree.nodeCount:
                panic(Fmt"parser value expr: parser origin node invalid origin={expr.originParserNodeId} nodeCount={delta.valueExprTree.nodeCount} kind={NormalizedExprKindCode(expr.kind)} root={expr.valueExprRootNodeIndex} line={expr.lineNumber} src={expr.sourcePath}")
        if expr.valueExprCallNodeIndex >= 0:
            expr.valueExprCallNodeIndex = expr.valueExprCallNodeIndex +
                                          valueNodeOffset
        if expr.valueExprRootNodeIndex >= 0:
            expr.valueExprRootNodeIndex = expr.valueExprRootNodeIndex +
                                          valueNodeOffset
        if expr.callArgValueRootStart >= 0:
            expr.callArgValueRootStart = expr.callArgValueRootStart +
                                         valueRootOffset
        if expr.anchorTokenIndex >= 0:
            expr.anchorTokenIndex =
                expr.anchorTokenIndex + valueTokenOffset
        NormalizedExprLayerAppendExisting(total, expr)
    for i in 0..<delta.scopes.len:
        var scope = NormalizedScopeFactClone(delta.scopes[i])
        if scope.anchorTokenIndex >= 0:
            scope.anchorTokenIndex =
                scope.anchorTokenIndex + valueTokenOffset
        if scope.ownerStatementRow >= 0:
            scope.ownerStatementRow =
                scope.ownerStatementRow + valueExprRowOffset
        if scope.ownerDeclarationRow >= 0:
            scope.ownerDeclarationRow =
                scope.ownerDeclarationRow + valueDeclarationOffset
        add(total.scopes, scope)
    ParserValueExprTreeRelease(delta.valueExprTree)
    var deltaReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
    NormalizedExprLayerTerminalReleaseWithReceipt(
        delta, deltaReleaseReceipt)

@borrows
fn NormalizedExprLayerExprCount(layer: NormalizedExprLayer): int32 =
    return layer.exprs.len

@borrows
fn NormalizedExprLayerCountKind(layer: NormalizedExprLayer,
                                  kind: NormalizedExprKind): int32 =
    var count: int32
    for i in 0..<layer.exprs.len:
        if layer.exprs[i].kind == kind:
            count = count + 1
    return count

@borrows
fn NormalizedExprLayerKindCountsBuild(layer: NormalizedExprLayer): NormalizedExprLayerKindCounts =
    var counts: NormalizedExprLayerKindCounts
    counts.exprCount = layer.exprs.len
    for i in 0..<layer.exprs.len:
        let kind = layer.exprs[i].kind
        if kind == NormalizedExprIf:
            counts.ifCount = counts.ifCount + 1
        elif kind == NormalizedExprRange:
            counts.rangeCount = counts.rangeCount + 1
        elif kind == NormalizedExprComprehension:
            counts.comprehensionCount = counts.comprehensionCount + 1
        elif kind == NormalizedExprStrFormat:
            counts.strFormatCount = counts.strFormatCount + 1
        elif kind == NormalizedExprResultIntrinsic:
            counts.resultIntrinsicCount = counts.resultIntrinsicCount + 1
        elif kind == NormalizedExprCall:
            counts.callCount = counts.callCount + 1
        elif kind == NormalizedExprTry:
            counts.tryCount = counts.tryCount + 1
        elif kind == NormalizedExprDefaultInit:
            counts.defaultInitCount = counts.defaultInitCount + 1
        elif kind == NormalizedExprConstructor:
            counts.constructorCount = counts.constructorCount + 1
        elif kind == NormalizedExprReturn:
            counts.returnCount = counts.returnCount + 1
        elif kind == NormalizedExprAssign:
            counts.assignCount = counts.assignCount + 1
        elif kind == NormalizedExprIfStmt:
            counts.ifStmtCount = counts.ifStmtCount + 1
        elif kind == NormalizedExprElifStmt:
            counts.elifStmtCount = counts.elifStmtCount + 1
        elif kind == NormalizedExprElseStmt:
            counts.elseStmtCount = counts.elseStmtCount + 1
        elif kind == NormalizedExprForStmt:
            counts.forStmtCount = counts.forStmtCount + 1
        elif kind == NormalizedExprMatchStmt:
            counts.matchStmtCount = counts.matchStmtCount + 1
        elif kind == NormalizedExprCaseStmt:
            counts.caseStmtCount = counts.caseStmtCount + 1
        elif kind == NormalizedExprWhileStmt:
            counts.whileStmtCount = counts.whileStmtCount + 1
        elif kind == NormalizedExprDeferStmt:
            counts.deferStmtCount = counts.deferStmtCount + 1
        elif kind == NormalizedExprBreakStmt:
            counts.breakStmtCount = counts.breakStmtCount + 1
        elif kind == NormalizedExprContinueStmt:
            counts.continueStmtCount = counts.continueStmtCount + 1
    return counts

@borrows
fn NormalizedExprLayerIfCount(layer: NormalizedExprLayer): int32 =
    return NormalizedExprLayerCountKind(layer, NormalizedExprIf)

