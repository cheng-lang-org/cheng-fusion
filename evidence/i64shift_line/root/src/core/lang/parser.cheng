fn ParserAnnotationArgScalarTokenKindMatches(
        kind: ParserAnnotationArgKind,
        tokenKind: ParserValueTokenKind): bool =
    if kind == ParserAnnotationArgIdentifier:
        return ParserValueExprTokenCanName(tokenKind)
    if kind == ParserAnnotationArgNumber:
        return tokenKind == ParserValueTokenInteger ||
               tokenKind == ParserValueTokenFloat
    if kind == ParserAnnotationArgString:
        return tokenKind == ParserValueTokenString
    if kind == ParserAnnotationArgCharacter:
        return tokenKind == ParserValueTokenChar
    if kind == ParserAnnotationArgBoolean:
        return tokenKind == ParserValueTokenTrue ||
               tokenKind == ParserValueTokenFalse
    return false

