        return false
    cursor = cursor + 1
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           tree.arena, tree.explicitGenericStarts, census[cursor]):
        err = "parser value expr: tree arena column census reserve failed column=explicitGenericStarts"
        return false
    cursor = cursor + 1
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           tree.arena, tree.explicitGenericCounts, census[cursor]):
        err = "parser value expr: tree arena column census reserve failed column=explicitGenericCounts"
        return false
    cursor = cursor + 1
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           tree.arena, tree.explicitGenericSpanStarts, census[cursor]):
        err = "parser value expr: tree arena column census reserve failed column=explicitGenericSpanStarts"
        return false
    cursor = cursor + 1
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           tree.arena, tree.explicitGenericSpanEnds, census[cursor]):
        err = "parser value expr: tree arena column census reserve failed column=explicitGenericSpanEnds"
        return false
    cursor = cursor + 1
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           tree.arena, tree.regionKinds, census[cursor]):
        err = "parser value expr: tree arena column census reserve failed column=regionKinds"
        return false
