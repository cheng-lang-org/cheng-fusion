fn NormalizedExprCloneInto(expr: var NormalizedExpr,
                           out: var NormalizedExpr) =
    # Into 风格(var 出参逐字段拷贝): struct 按值返回在自宿主 codegen 下
    # 产出零值目标(kind=If 枚举序数 0 + 全零字段=幽灵槽指纹实锤),
    # 本文件内 NormalizedExpr 的按值返回一律改走本函数(含 spanStart/spanEnd
    # 补拷——旧 Clone 漏拷这两字段)。
    out.exprId = expr.exprId
    out.sourcePath = expr.sourcePath
    out.lineNumber = expr.lineNumber
    out.columnNumber = expr.columnNumber
    out.endLineNumber = expr.endLineNumber
    out.endColumnNumber = expr.endColumnNumber
    out.kind = expr.kind
    out.detailKind = expr.detailKind
    out.surfaceText = expr.surfaceText
    out.callSurfaceKind = expr.callSurfaceKind
    out.callResolved = expr.callResolved
    out.callReason = expr.callReason
    out.callQualifier = expr.callQualifier
    out.callCallee = expr.callCallee
    out.callTarget = expr.callTarget
    out.callTargetSourcePath = expr.callTargetSourcePath
    out.callTargetImportc = expr.callTargetImportc
    out.callPrefixStyle = expr.callPrefixStyle
    out.callArgCount = expr.callArgCount
    out.callArgsText = expr.callArgsText
    out.valueExprCallNodeIndex = expr.valueExprCallNodeIndex
    out.originParserNodeId = expr.originParserNodeId
    out.callArgValueRootStart = expr.callArgValueRootStart
    out.callArgValueRootCount = expr.callArgValueRootCount
    out.valueExprRootNodeIndex = expr.valueExprRootNodeIndex
    out.valueExprSpanStart = expr.valueExprSpanStart
    out.valueExprSpanEnd = expr.valueExprSpanEnd
    out.valueExprStatementRole = expr.valueExprStatementRole
    out.anchorTokenIndex = expr.anchorTokenIndex
    out.lexicalScopeId = expr.lexicalScopeId
    out.suiteScopeId = expr.suiteScopeId
    out.statementOrdinal = expr.statementOrdinal
    out.lexicalOrdinal = expr.lexicalOrdinal
    out.deferOwnerStatementOrdinal = expr.deferOwnerStatementOrdinal
    out.spanStart = expr.spanStart
    out.spanEnd = expr.spanEnd

fn NormalizedScopeFactClone(scope: var NormalizedScopeFact): NormalizedScopeFact =
    var out: NormalizedScopeFact
    out.sourcePath = scope.sourcePath
    out.scopeId = scope.scopeId
    out.sourceScopeId = scope.sourceScopeId
    out.parentScopeId = scope.parentScopeId
    out.kind = scope.kind
    out.ownerStatementOrdinal = scope.ownerStatementOrdinal
    out.ownerStatementRow = scope.ownerStatementRow
    out.ownerDeclarationRow = scope.ownerDeclarationRow
    out.moduleRootAnchor = scope.moduleRootAnchor
    out.lexicalOrdinal = scope.lexicalOrdinal
    out.indentColumn = scope.indentColumn
    out.startLineNumber = scope.startLineNumber
    out.startColumnNumber = scope.startColumnNumber
    out.endLineNumber = scope.endLineNumber
    out.endColumnNumber = scope.endColumnNumber
    out.anchorTokenIndex = scope.anchorTokenIndex
    return out

@borrows
fn NormalizedExprEndColumn(columnNumber: int32,
                             surfaceText: str): int32 =
    if Len(surfaceText) <= 0:
        return columnNumber
    return columnNumber + Len(surfaceText) - 1

fn NormalizedExprKindCode(kind: NormalizedExprKind): int32 =
    if kind == NormalizedExprIf:
        return 1
    if kind == NormalizedExprRange:
        return 2
    if kind == NormalizedExprComprehension:
        return 3
    if kind == NormalizedExprStrFormat:
        return 4
    if kind == NormalizedExprResultIntrinsic:
        return 5
    if kind == NormalizedExprCall:
        return 6
    if kind == NormalizedExprTry:
        return 7
    if kind == NormalizedExprDefaultInit:
        return 8
    if kind == NormalizedExprConstructor:
        return 9
    if kind == NormalizedExprReturn:
        return 10
    if kind == NormalizedExprAssign:
        return 11
    if kind == NormalizedExprIfStmt:
        return 12
    if kind == NormalizedExprElifStmt:
        return 13
    if kind == NormalizedExprElseStmt:
        return 14
    if kind == NormalizedExprForStmt:
        return 15
    if kind == NormalizedExprMatchStmt:
        return 16
    if kind == NormalizedExprCaseStmt:
        return 17
    if kind == NormalizedExprWhileStmt:
        return 18
    if kind == NormalizedExprDeferStmt:
        return 19
    if kind == NormalizedExprBreakStmt:
        return 20
    if kind == NormalizedExprContinueStmt:
        return 21
    return 0

@borrows
fn NormalizedExprLookupTextFirstCode(text: str): int32 =
    if text == "":
        return 0
    return Int32(text[0])

@borrows
fn NormalizedExprLookupTextLastCode(text: str): int32 =
    if text == "":
        return 0
    return Int32(text[text.len - 1])

fn NormalizedExprLookupInitInto(lookup: var NormalizedExprLookup,
                                  minCap: int32) =
    var cap: int32 = 32
    while cap < minCap:
        cap = cap * 2
    setLen(lookup.slots, cap)
    setLen(lookup.buckets, 0)
    for i in 0..<cap:
        lookup.slots[i] = 0

fn NormalizedExprLookupInit(minCap: int32): NormalizedExprLookup =
    var lookup: NormalizedExprLookup
    NormalizedExprLookupInitInto(lookup, minCap)
    return lookup

fn NormalizedExprLookupDetailKind(kind: NormalizedExprKind,
                                    detailKind: NormalizedExprDetailKind): NormalizedExprDetailKind =
    if kind == NormalizedExprCall:
        return NormalizedExprDetailNone
    return detailKind

fn NormalizedExprLookupKeyExact(sourcePath: str,
                                  lineNumber: int32,
                                  columnNumber: int32,
                                  kind: NormalizedExprKind,
                                  detailKind: NormalizedExprDetailKind,
                                  surfaceText: str): NormalizedExprLookupKey =
    var key: NormalizedExprLookupKey
    key.sourcePathLen = sourcePath.len
    key.sourcePathFirstCode = NormalizedExprLookupTextFirstCode(sourcePath)
    key.sourcePathLastCode = NormalizedExprLookupTextLastCode(sourcePath)
    key.lineNumber = lineNumber
    key.columnNumber = columnNumber
    key.kindCode = NormalizedExprKindCode(kind)
    key.detailCode = NormalizedExprDetailKindCode(NormalizedExprLookupDetailKind(kind, detailKind))
    key.surfaceLen = surfaceText.len
    key.surfaceFirstCode = NormalizedExprLookupTextFirstCode(surfaceText)
    key.surfaceLastCode = NormalizedExprLookupTextLastCode(surfaceText)
    return key

fn NormalizedExprLookupKeyFromExpr(expr: NormalizedExpr): NormalizedExprLookupKey =
    return NormalizedExprLookupKeyExact(strings.CloneStr(expr.sourcePath),
                                          expr.lineNumber,
                                          expr.columnNumber,
                                          expr.kind,
                                          expr.detailKind,
                                          strings.CloneStr(expr.surfaceText))

@borrows
fn NormalizedExprLookupKeyOwnedCopy(
       key: NormalizedExprLookupKey): NormalizedExprLookupKey =
    return NormalizedExprLookupKey(
        sourcePathLen: key.sourcePathLen,
        sourcePathFirstCode: key.sourcePathFirstCode,
        sourcePathLastCode: key.sourcePathLastCode,
        lineNumber: key.lineNumber,
        columnNumber: key.columnNumber,
        kindCode: key.kindCode,
        detailCode: key.detailCode,
        surfaceLen: key.surfaceLen,
        surfaceFirstCode: key.surfaceFirstCode,
        surfaceLastCode: key.surfaceLastCode)

fn NormalizedExprLookupHash(key: NormalizedExprLookupKey): int64 =
    var h: int64 = Int64(key.sourcePathLen)
    h = h * 131 + Int64(key.sourcePathFirstCode)
    h = h * 131 + Int64(key.sourcePathLastCode)
    h = h * 131 + Int64(key.lineNumber)
    h = h * 131 + Int64(key.columnNumber)
    h = h * 131 + Int64(key.kindCode)
    h = h * 131 + Int64(key.detailCode)
    h = h * 131 + Int64(key.surfaceLen)
    h = h * 131 + Int64(key.surfaceFirstCode)
    h = h * 131 + Int64(key.surfaceLastCode)
    if h < 0:
        h = -h
    return h

fn NormalizedExprLookupKeyMatchesBucket(key: NormalizedExprLookupKey,
                                          bucket: NormalizedExprLookupBucket): bool =
    if bucket.sourcePathLen != key.sourcePathLen:
        return false
    if bucket.sourcePathFirstCode != key.sourcePathFirstCode:
        return false
    if bucket.sourcePathLastCode != key.sourcePathLastCode:
        return false
    if bucket.lineNumber != key.lineNumber:
        return false
    if bucket.columnNumber != key.columnNumber:
        return false
    if bucket.kindCode != key.kindCode:
        return false
    if bucket.detailCode != key.detailCode:
        return false
    if bucket.surfaceLen != key.surfaceLen:
        return false
    if bucket.surfaceFirstCode != key.surfaceFirstCode:
        return false
    if bucket.surfaceLastCode != key.surfaceLastCode:
        return false
    return true

@borrows
fn NormalizedExprLookupSlotForKey(lookup: NormalizedExprLookup,
                                    key: NormalizedExprLookupKey): int32 =
    if lookup.slots.len <= 0:
        return -1
    # slots.len is always a power of two (InitInto/Grow only double), so the
    # start slot is hash & (len - 1). This avoids an int64 modulo whose
    # node-eval lowering left the result un-reduced; the old
    # Int32(hash % len) truncated to a negative value for ~half the keys and
    # the `probe < 0 -> 0` clamp collapsed them all onto slot 0, turning every
    # lookup into a full-table linear scan (O(n) per op, O(n^2) per layer).
    let hashVal = NormalizedExprLookupHash(
        NormalizedExprLookupKeyOwnedCopy(key))
    let slotMask: int64 = Int64(lookup.slots.len) - 1
    var probe: int32 = Int32(hashVal & slotMask)
    if probe < 0:
        probe = 0
    var scanned: int32
    while scanned < lookup.slots.len:
        let bucketIndexPlus1 = lookup.slots[probe]
        if bucketIndexPlus1 == 0:
            return probe
        let bucket = lookup.buckets[bucketIndexPlus1 - 1]
        if NormalizedExprLookupKeyMatchesBucket(
               NormalizedExprLookupKeyOwnedCopy(key), bucket):
            return probe
        probe = probe + 1
        if probe >= lookup.slots.len:
            probe = 0
        scanned = scanned + 1
    return -1

fn NormalizedExprLookupRehash(lookup: var NormalizedExprLookup,
                                newCap: int32) =
    setLen(lookup.slots, newCap)
    for i in 0..<newCap:
        lookup.slots[i] = 0
    for bucketIndex in 0..<lookup.buckets.len:
        let bucket = lookup.buckets[bucketIndex]
        var key: NormalizedExprLookupKey
        key.sourcePathLen = bucket.sourcePathLen
        key.sourcePathFirstCode = bucket.sourcePathFirstCode
        key.sourcePathLastCode = bucket.sourcePathLastCode
        key.lineNumber = bucket.lineNumber
        key.columnNumber = bucket.columnNumber
        key.kindCode = bucket.kindCode
        key.detailCode = bucket.detailCode
        key.surfaceLen = bucket.surfaceLen
        key.surfaceFirstCode = bucket.surfaceFirstCode
        key.surfaceLastCode = bucket.surfaceLastCode
        let slot = NormalizedExprLookupSlotForKey(lookup, key)
        if slot >= 0:
            lookup.slots[slot] = bucketIndex + 1

fn NormalizedExprLookupGrow(lookup: var NormalizedExprLookup) =
    var nextCap: int32 = lookup.slots.len * 2
    if nextCap < 32:
        nextCap = 32
    NormalizedExprLookupRehash(lookup, nextCap)

fn NormalizedExprLookupEnsureBucket(lookup: var NormalizedExprLookup,
                                      sourcePath: str,
                                      lineNumber: int32,
                                      columnNumber: int32,
                                      kind: NormalizedExprKind,
                                      detailKind: NormalizedExprDetailKind,
                                      surfaceText: str): int32 =
    if lookup.slots.len <= 0:
        NormalizedExprLookupInitInto(lookup, 32)
    if (lookup.buckets.len + 1) * 10 >= lookup.slots.len * 7:
        NormalizedExprLookupGrow(lookup)
    let key = NormalizedExprLookupKeyExact(sourcePath,
                                             lineNumber,
                                             columnNumber,
                                             kind,
                                             detailKind,
                                             surfaceText)
    let slot = NormalizedExprLookupSlotForKey(lookup, key)
    if slot < 0:
        return -1
    let existing = lookup.slots[slot]
    if existing > 0:
        return existing - 1
    var bucket: NormalizedExprLookupBucket
    bucket.sourcePathLen = key.sourcePathLen
    bucket.sourcePathFirstCode = key.sourcePathFirstCode
    bucket.sourcePathLastCode = key.sourcePathLastCode
    bucket.lineNumber = key.lineNumber
    bucket.columnNumber = key.columnNumber
    bucket.kindCode = key.kindCode
    bucket.detailCode = key.detailCode
    bucket.surfaceLen = key.surfaceLen
    bucket.surfaceFirstCode = key.surfaceFirstCode
    bucket.surfaceLastCode = key.surfaceLastCode
    bucket.head = -1
    add(lookup.buckets, bucket)
    lookup.slots[slot] = lookup.buckets.len
    return lookup.buckets.len - 1

@borrows
fn NormalizedExprLookupBucketIndexExact(lookup: NormalizedExprLookup,
                                          sourcePath: str,
                                          lineNumber: int32,
                                          columnNumber: int32,
                                          kind: NormalizedExprKind,
                                          detailKind: NormalizedExprDetailKind,
                                          surfaceText: str): int32 =
    if sourcePath == "":
        return -1
    let key = NormalizedExprLookupKeyExact(strings.CloneStr(sourcePath),
                                             lineNumber,
                                             columnNumber,
                                             kind,
                                             detailKind,
                                             strings.CloneStr(surfaceText))
    let slot = NormalizedExprLookupSlotForKey(lookup, key)
    if slot < 0:
        return -1
    let bucketIndexPlus1 = lookup.slots[slot]
    if bucketIndexPlus1 > 0:
        return bucketIndexPlus1 - 1
    return -1

fn NormalizedExprMatchesExact(expr: NormalizedExpr,
                                expected: NormalizedExpr): bool =
    if expr.sourcePath != expected.sourcePath:
        return false
    if expr.lineNumber != expected.lineNumber:
        return false
    if expr.columnNumber != expected.columnNumber:
        return false
    if expr.kind != expected.kind:
        return false
    if expr.detailKind != expected.detailKind:
        return false
    if expr.surfaceText != expected.surfaceText:
        return false
    if expr.callSurfaceKind != expected.callSurfaceKind:
        return false
    if expr.callResolved != expected.callResolved:
        return false
    if expr.callReason != expected.callReason:
        return false
    if expr.callQualifier != expected.callQualifier:
        return false
    if expr.callCallee != expected.callCallee:
        return false
    if expr.callTarget != expected.callTarget:
        return false
    if expr.callTargetSourcePath != expected.callTargetSourcePath:
        return false
    if expr.callTargetImportc != expected.callTargetImportc:
        return false
    if expr.callPrefixStyle != expected.callPrefixStyle:
        return false
    if expr.callArgCount != expected.callArgCount:
        return false
    if expr.callArgsText != expected.callArgsText:
        return false
    if expr.lexicalScopeId != expected.lexicalScopeId:
        return false
    if expr.suiteScopeId != expected.suiteScopeId:
        return false
    if expr.statementOrdinal != expected.statementOrdinal:
        return false
    if expr.lexicalOrdinal != expected.lexicalOrdinal:
        return false
    if expr.deferOwnerStatementOrdinal != expected.deferOwnerStatementOrdinal:
        return false
    return true

@borrows
fn NormalizedExprLayerContainsExpr(layer: var NormalizedExprLayer,
                                     expr: NormalizedExpr): bool =
    let bucketIndex = NormalizedExprLookupBucketIndexExact(layer.exprLookup,
                                                             expr.sourcePath,
                                                             expr.lineNumber,
                                                             expr.columnNumber,
                                                             expr.kind,
                                                             expr.detailKind,
                                                             expr.surfaceText)
    if bucketIndex < 0 || bucketIndex >= layer.exprLookup.buckets.len:
        return false
    var exprIndex = layer.exprLookup.buckets[bucketIndex].head
    var guard: int32
    while exprIndex >= 0 && guard <= layer.exprs.len:
        if exprIndex < 0 || exprIndex >= layer.exprs.len:
            return false
        if layer.exprs[exprIndex].sourcePath == expr.sourcePath &&
           layer.exprs[exprIndex].lineNumber == expr.lineNumber &&
           layer.exprs[exprIndex].columnNumber == expr.columnNumber &&
           layer.exprs[exprIndex].kind == expr.kind &&
           layer.exprs[exprIndex].detailKind == expr.detailKind &&
           layer.exprs[exprIndex].surfaceText == expr.surfaceText &&
           layer.exprs[exprIndex].callSurfaceKind == expr.callSurfaceKind &&
           layer.exprs[exprIndex].callResolved == expr.callResolved &&
           layer.exprs[exprIndex].callReason == expr.callReason &&
           layer.exprs[exprIndex].callQualifier == expr.callQualifier &&
           layer.exprs[exprIndex].callCallee == expr.callCallee &&
           layer.exprs[exprIndex].callTarget == expr.callTarget &&
           layer.exprs[exprIndex].callTargetSourcePath == expr.callTargetSourcePath &&
           layer.exprs[exprIndex].callTargetImportc == expr.callTargetImportc &&
           layer.exprs[exprIndex].callPrefixStyle == expr.callPrefixStyle &&
           layer.exprs[exprIndex].callArgCount == expr.callArgCount &&
           layer.exprs[exprIndex].callArgsText == expr.callArgsText &&
           layer.exprs[exprIndex].lexicalScopeId == expr.lexicalScopeId &&
           layer.exprs[exprIndex].suiteScopeId == expr.suiteScopeId &&
           layer.exprs[exprIndex].statementOrdinal == expr.statementOrdinal &&
           layer.exprs[exprIndex].lexicalOrdinal == expr.lexicalOrdinal &&
           layer.exprs[exprIndex].deferOwnerStatementOrdinal == expr.deferOwnerStatementOrdinal:
            return true
        if exprIndex >= layer.exprNext.len:
            return false
        exprIndex = layer.exprNext[exprIndex]
        guard = guard + 1
    return false

fn NormalizedExprLayerRememberExpr(layer: var NormalizedExprLayer,
                                     exprIndex: int32) =
    if exprIndex < 0 || exprIndex >= layer.exprs.len:
        return
    let bucketIndex = NormalizedExprLookupEnsureBucket(layer.exprLookup,
                                                         strings.CloneStr(
                                                             layer.exprs[exprIndex].sourcePath),
                                                         layer.exprs[exprIndex].lineNumber,
                                                         layer.exprs[exprIndex].columnNumber,
                                                         layer.exprs[exprIndex].kind,
                                                         layer.exprs[exprIndex].detailKind,
                                                         strings.CloneStr(
                                                             layer.exprs[exprIndex].surfaceText))
    if bucketIndex < 0:
        return
    var bucket = layer.exprLookup.buckets[bucketIndex]
    var current = bucket.head
    var guard: int32
    while current >= 0 && guard <= layer.exprs.len:
        if current == exprIndex:
            return
        if current >= layer.exprNext.len:
            return
        current = layer.exprNext[current]
        guard = guard + 1
    while layer.exprNext.len <= exprIndex:
        add(layer.exprNext, -1)
    layer.exprNext[exprIndex] = bucket.head
    bucket.head = exprIndex
    layer.exprLookup.buckets[bucketIndex] = bucket

fn NormalizedExprLayerAppendExisting(layer: var NormalizedExprLayer,
                                       expr: var NormalizedExpr) =
    if NormalizedExprLayerContainsExpr(layer, expr):
        return
    # 字段直移版: 与 NormalizedExprClone 逐字段搬移语义完全一致(源条目
    # 留空壳, 调用方不复用), 但不经 struct 按值返回发射路径——该路径
    # 在自宿主/车头两代 codegen 上均产生 str 字段丢失的幽灵槽(判词 30/32)。
    var ownedExpr: NormalizedExpr
    ownedExpr.exprId = expr.exprId
    ownedExpr.sourcePath = expr.sourcePath
    ownedExpr.lineNumber = expr.lineNumber
    ownedExpr.columnNumber = expr.columnNumber
    ownedExpr.endLineNumber = expr.endLineNumber
    ownedExpr.endColumnNumber = expr.endColumnNumber
    ownedExpr.kind = expr.kind
    ownedExpr.detailKind = expr.detailKind
    ownedExpr.surfaceText = expr.surfaceText
    ownedExpr.callSurfaceKind = expr.callSurfaceKind
    ownedExpr.callResolved = expr.callResolved
    ownedExpr.callReason = expr.callReason
    ownedExpr.callQualifier = expr.callQualifier
    ownedExpr.callCallee = expr.callCallee
    ownedExpr.callTarget = expr.callTarget
    ownedExpr.callTargetSourcePath = expr.callTargetSourcePath
    ownedExpr.callTargetImportc = expr.callTargetImportc
    ownedExpr.callPrefixStyle = expr.callPrefixStyle
    ownedExpr.callArgCount = expr.callArgCount
    ownedExpr.callArgsText = expr.callArgsText
    ownedExpr.valueExprCallNodeIndex = expr.valueExprCallNodeIndex
    ownedExpr.originParserNodeId = expr.originParserNodeId
    ownedExpr.callArgValueRootStart = expr.callArgValueRootStart
    ownedExpr.callArgValueRootCount = expr.callArgValueRootCount
    ownedExpr.valueExprRootNodeIndex = expr.valueExprRootNodeIndex
    ownedExpr.valueExprSpanStart = expr.valueExprSpanStart
    ownedExpr.valueExprSpanEnd = expr.valueExprSpanEnd
    ownedExpr.valueExprStatementRole = expr.valueExprStatementRole
    ownedExpr.anchorTokenIndex = expr.anchorTokenIndex
    ownedExpr.lexicalScopeId = expr.lexicalScopeId
    ownedExpr.suiteScopeId = expr.suiteScopeId
    ownedExpr.statementOrdinal = expr.statementOrdinal
    ownedExpr.lexicalOrdinal = expr.lexicalOrdinal
    ownedExpr.deferOwnerStatementOrdinal = expr.deferOwnerStatementOrdinal
    ownedExpr.spanStart = expr.spanStart
    ownedExpr.spanEnd = expr.spanEnd
    add(layer.exprs, ownedExpr)
    add(layer.exprNext, -1)
    if layer.exprs[layer.exprs.len - 1].kind == NormalizedExprIf &&
       layer.exprs[layer.exprs.len - 1].lineNumber == 0 &&
       layer.exprs[layer.exprs.len - 1].sourcePath == "":
        panic("parser value expr: A0 Existing append produced zero slot")
    NormalizedExprLayerRememberExpr(layer, layer.exprs.len - 1)

@borrows
fn ParserConcat2(a: str, b: str): str =
    var buf = buffer.NewByteBuffer()
    if a != "":
        buffer.AppendText(buf, a)
    if b != "":
        buffer.AppendText(buf, b)
    return buffer.FinishString(buf)

@borrows
fn ParserConcat3(a: str, b: str, c: str): str =
    var buf = buffer.NewByteBuffer()
    if a != "":
        buffer.AppendText(buf, a)
    if b != "":
        buffer.AppendText(buf, b)
    if c != "":
        buffer.AppendText(buf, c)
    return buffer.FinishString(buf)

@borrows
fn ParserConcat4(a: str, b: str, c: str, d: str): str =
    var buf = buffer.NewByteBuffer()
    if a != "":
        buffer.AppendText(buf, a)
    if b != "":
        buffer.AppendText(buf, b)
    if c != "":
        buffer.AppendText(buf, c)
    if d != "":
        buffer.AppendText(buf, d)
    return buffer.FinishString(buf)

@borrows
fn ParserOwnedTextRange(text: str,
                        start: int32,
                        count: int32): str =
    if start < 0 || count < 0 || start > text.len - count:
        panic("parser: owned text range out of bounds")
    var out = buffer.NewByteBuffer()
    for index in start..<start + count:
        buffer.AppendByte(out, Int32(text[index]) & 255)
    return buffer.FinishString(out)

@borrows
fn ParserOwnedText(text: str): str =
    return ParserOwnedTextRange(text, 0, text.len)

@borrows
fn ParserOwnedLowerAsciiText(text: str): str =
    var out = buffer.NewByteBuffer()
    for index in 0..<text.len:
        var value = Int32(text[index]) & 255
        if value >= Int32('A') && value <= Int32('Z'):
            value = value + 32
        buffer.AppendByte(out, value)
    return buffer.FinishString(out)

@borrows
fn ParserStrLenAt(s: str): int32 =
    return s.len

@borrows
@borrow_result
fn ParserLineWithoutTrailingCr(lineRaw: str): str =
    if ParserStrLenAt(lineRaw) <= 0:
        return lineRaw
    let tailIdx: int32 = ParserStrLenAt(lineRaw) - 1
    if Int32(lineRaw[tailIdx]) == 13:
        return ParserTextSliceFast(lineRaw, 0, tailIdx)
    return lineRaw

@borrows
fn ParserOnlyInlineSpaces(text: str,
                            startRaw: int32,
                            stopRaw: int32): bool =
    var start = startRaw
    if start < 0:
        start = 0
    var stop = stopRaw
    if stop > text.len:
        stop = text.len
    if stop < start:
        return false
    for i in start..<stop:
        if !ParserIsInlineSpace(ParserCharAt(text, i)):
            return false
    return true

@borrows
fn ParserFindMultilineStringOpenOnLine(lineRaw: str): int32 =
    var inString = false
    var inChar = false
    var i: int32
    for i in i..<lineRaw.len:
        let ch = lineRaw[i]
        if !inString && !inChar && ch == Char(35):
            return -1
        if !inChar && ch == Char(34) && !ParserQuoteIsEscaped(lineRaw, i):
            if !inString &&
               i + 2 < lineRaw.len &&
               lineRaw[i + 1] == Char(34) &&
               lineRaw[i + 2] == Char(34):
                return i
            inString = !inString
            continue
        if !inString && ch == Char(39) && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
            continue
    return -1

@borrows
fn ParserLineIsMultilineStringClose(lineRaw: str,
                                      indentOut: var str): bool =
    indentOut = ""
    let indentMarker = ParserMultilineStringCloseIndentMarker(lineRaw)
    if indentMarker <= 0:
        return false
    indentOut = ParserTextSliceCopy(lineRaw, 0, indentMarker - 1)
    return true

@borrows
fn ParserMultilineStringCloseIndentMarker(lineRaw: str): int32 =
    var start: int32
    var stop = lineRaw.len
    while start < stop:
        if !ParserIsTrimChar(lineRaw[start]):
            break
        start = start + 1
    while stop > start:
        if !ParserIsTrimChar(lineRaw[stop - 1]):
            break
        stop = stop - 1
    if stop - start != 3:
        return 0
    if start + 2 >= lineRaw.len:
        return 0
    if lineRaw[start] != Char(34):
        return 0
    if lineRaw[start + 1] != Char(34):
        return 0
    if lineRaw[start + 2] != Char(34):
        return 0
    return start + 1

@borrows
fn ParserEscapedShortStringLen(text: str): int32 =
    var outLen: int32
    for i in 0..<text.len:
        let code = Int32(text[i])
        if code == 34 || code == 92 || code == 10 || code == 13 || code == 9:
            outLen = outLen + 2
        else:
            outLen = outLen + 1
    return outLen

fn ParserWriteShortStringEscaped(out: var str,
                                   writePos: var int32,
                                   text: str) =
    for i in 0..<text.len:
        let code = Int32(text[i])
        if code == 34:
            ParserWriteByteFast(out, writePos, 92)
            ParserWriteByteFast(out, writePos, 34)
        elif code == 92:
            ParserWriteByteFast(out, writePos, 92)
            ParserWriteByteFast(out, writePos, 92)
        elif code == 10:
            ParserWriteByteFast(out, writePos, 92)
            ParserWriteByteFast(out, writePos, 110)
        elif code == 13:
            ParserWriteByteFast(out, writePos, 92)
            ParserWriteByteFast(out, writePos, 110)
        elif code == 9:
            ParserWriteByteFast(out, writePos, 92)
            ParserWriteByteFast(out, writePos, 116)
        else:
            ParserWriteByteFast(out, writePos, code)

@borrows
fn ParserMeasureMultilineStringRewrite(lines: str[],
                                         outLen: var int32,
                                         err: var str): bool =
    outLen = 0
    err = ""
    var i: int32
    while i < lines.len:
        let line = ParserLineWithoutTrailingCr(lines[i])
        let openPos = ParserFindMultilineStringOpenOnLine(line)
        if openPos < 0:
            outLen = outLen + line.len
            if i + 1 < lines.len:
                outLen = outLen + 1
            i = i + 1
            continue
        if !ParserOnlyInlineSpaces(line, openPos + 3, line.len):
            err = Fmt"multiline string opener must be followed by a newline at line {i + 1}"
            return false
        var closeIndex: int32 = -1
        var closeIndent = ""
        for candidate in i + 1..<lines.len:
            let closeLine = ParserLineWithoutTrailingCr(lines[candidate])
            let closeIndentMarker = ParserMultilineStringCloseIndentMarker(closeLine)
            if closeIndentMarker > 0:
                closeIndex = candidate
                closeIndent = ParserTextSliceCopy(closeLine, 0, closeIndentMarker - 1)
                break
        if closeIndex < 0:
            err = Fmt"unterminated multiline string starting at line {i + 1}"
            return false
        outLen = outLen + openPos + 1
        for bodyIndex in i + 1..<closeIndex:
            let bodyLine = ParserLineWithoutTrailingCr(lines[bodyIndex])
            if ParserHasNonTrimChar(bodyLine):
                if closeIndent != "" && !ParserTextEqualsAt(bodyLine, 0, closeIndent):
                    err = Fmt"multiline string body indentation is shallower than closing delimiter at line {bodyIndex + 1}"
                    return false
                let bodyText = ParserTextSliceCopy(bodyLine,
                                                    closeIndent.len,
                                                    bodyLine.len - closeIndent.len)
                outLen = outLen + ParserEscapedShortStringLen(bodyText)
            if bodyIndex + 1 < closeIndex:
                outLen = outLen + 2
        outLen = outLen + 1
        var newlineCount = closeIndex - i
        if closeIndex + 1 < lines.len:
            newlineCount = newlineCount + 1
        outLen = outLen + newlineCount
        i = closeIndex + 1
    return true

@borrows
fn ParserRewriteMultilineStringSourceText(textRaw: str,
                                            rewrittenOut: var str,
                                            err: var str): bool =
    if !ParserSourceHasMultilineString(textRaw):
        rewrittenOut = textRaw
        err = ""
        return true
    let lines = ParserSplitChar(textRaw, '\n')
    var outLen: int32
    if !ParserMeasureMultilineStringRewrite(lines, outLen, err):
        return false
    if outLen <= 0:
        rewrittenOut = ""
        err = ""
        return true
    var out = NewStringAlloc(outLen)
    var writePos: int32
    var i: int32
    while i < lines.len:
        let line = ParserLineWithoutTrailingCr(lines[i])
        let openPos = ParserFindMultilineStringOpenOnLine(line)
        if openPos < 0:
            ParserWriteTextFast(out, writePos, line)
            if i + 1 < lines.len:
                ParserWriteByteFast(out, writePos, 10)
            i = i + 1
            continue
        if !ParserOnlyInlineSpaces(line, openPos + 3, line.len):
            err = Fmt"multiline string opener must be followed by a newline at line {i + 1}"
            return false
        var closeIndex: int32 = -1
        var closeIndent = ""
        for candidate in i + 1..<lines.len:
            let closeLine = ParserLineWithoutTrailingCr(lines[candidate])
            let closeIndentMarker = ParserMultilineStringCloseIndentMarker(closeLine)
            if closeIndentMarker > 0:
                closeIndex = candidate
                closeIndent = ParserTextSliceCopy(closeLine, 0, closeIndentMarker - 1)
                break
        if closeIndex < 0:
            err = Fmt"unterminated multiline string starting at line {i + 1}"
            return false
        ParserWriteTextFast(out, writePos, ParserTextSliceCopy(line, 0, openPos))
        ParserWriteByteFast(out, writePos, 34)
        for bodyIndex in i + 1..<closeIndex:
            let bodyLine = ParserLineWithoutTrailingCr(lines[bodyIndex])
            var bodyText = ""
            if ParserHasNonTrimChar(bodyLine):
                if closeIndent != "" && !ParserTextEqualsAt(bodyLine, 0, closeIndent):
                    err = Fmt"multiline string body indentation is shallower than closing delimiter at line {bodyIndex + 1}"
                    return false
                bodyText = ParserTextSliceCopy(bodyLine,
                                                closeIndent.len,
                                                bodyLine.len - closeIndent.len)
            ParserWriteShortStringEscaped(out, writePos, bodyText)
            if bodyIndex + 1 < closeIndex:
                ParserWriteByteFast(out, writePos, 92)
                ParserWriteByteFast(out, writePos, 110)
        ParserWriteByteFast(out, writePos, 34)
        var newlineCount = closeIndex - i
        if closeIndex + 1 < lines.len:
            newlineCount = newlineCount + 1
        for _ in 0..<newlineCount:
            ParserWriteByteFast(out, writePos, 10)
        i = closeIndex + 1
    if writePos != outLen:
        Panic("parser multiline string rewrite length mismatch")
    rewrittenOut = out
    err = ""
    return true

@borrows
fn ParserSourceRewriteLineStarts(text: str): int32[] =
    var out: int32[]
    add(out, 0)
    for index in 0..<text.len:
        if text[index] == '\n':
            add(out, index + 1)
    return out

@borrows
fn ParserSourceRewriteOffsetPosition(lineStarts: int32[],
                                       textLength: int32,
                                       byteOffset: int32,
                                       lineOut: var int32,
                                       columnOut: var int32): bool =
    if lineStarts.len <= 0 || byteOffset < 0 || byteOffset > textLength:
        return false
    var low: int32
    var high = lineStarts.len
    while low < high:
        let middle = low + (high - low) / 2
        if lineStarts[middle] <= byteOffset:
            low = middle + 1
        else:
            high = middle
    let line = low - 1
    if line < 0:
        return false
    lineOut = line
    columnOut = byteOffset - lineStarts[line]
    return true

@borrows
fn parserSourceRewriteCoordinateMapFromExactRewriteInto(
        textRaw: str,
        rewrittenText: str,
        out: var ParserSourceRewriteCoordinateMap,
        err: var str): bool =
    out = ParserSourceRewriteCoordinateMap()
    let originalLines = ParserSplitChar(textRaw, '\n')
    let rewrittenLines = ParserSplitChar(rewrittenText, '\n')
    if originalLines.len != rewrittenLines.len:
        err = "parser rewrite coordinate map line count mismatch"
        return false
    out.originalTextLength = textRaw.len
    out.rewrittenTextLength = rewrittenText.len
    out.originalLineStarts = ParserSourceRewriteLineStarts(textRaw)
    out.rewrittenLineStarts = ParserSourceRewriteLineStarts(rewrittenText)
    if out.originalLineStarts.len != originalLines.len ||
       out.rewrittenLineStarts.len != rewrittenLines.len:
        err = "parser rewrite coordinate map line index mismatch"
        return false
    setLen(out.multilineOpenColumns, originalLines.len)
    setLen(out.originalLineLengths, originalLines.len)
    setLen(out.multilineRewrittenEndColumns, originalLines.len)
    setLen(out.multilineCloseLineIndexes, originalLines.len)
    setLen(out.multilineOriginalEndColumns, originalLines.len)
    for lineIndex in 0..<originalLines.len:
        out.originalLineLengths[lineIndex] =
            ParserLineWithoutTrailingCr(originalLines[lineIndex]).len
        out.multilineOpenColumns[lineIndex] = -1
        out.multilineRewrittenEndColumns[lineIndex] = -1
        out.multilineCloseLineIndexes[lineIndex] = -1
        out.multilineOriginalEndColumns[lineIndex] = -1
    var lineIndex: int32
    while lineIndex < originalLines.len:
        let originalLine = ParserLineWithoutTrailingCr(
            originalLines[lineIndex])
        let openColumn = ParserFindMultilineStringOpenOnLine(originalLine)
        if openColumn < 0:
            lineIndex = lineIndex + 1
            continue
        var closeLineIndex: int32 = -1
        var closeIndentMarker: int32
        for candidate in lineIndex + 1..<originalLines.len:
            let closeLine = ParserLineWithoutTrailingCr(
                originalLines[candidate])
            let marker = ParserMultilineStringCloseIndentMarker(closeLine)
            if marker > 0:
                closeLineIndex = candidate
                closeIndentMarker = marker
                break
        if closeLineIndex < 0:
            err = "parser rewrite coordinate map close delimiter missing"
            return false
        let rewrittenLine = ParserLineWithoutTrailingCr(
            rewrittenLines[lineIndex])
        if rewrittenLine.len <= openColumn ||
           rewrittenLine[openColumn] != Char(34):
            err = "parser rewrite coordinate map opener mismatch"
            return false
        out.multilineOpenColumns[lineIndex] = openColumn
        out.multilineRewrittenEndColumns[lineIndex] = rewrittenLine.len
        out.multilineCloseLineIndexes[lineIndex] = closeLineIndex
        # ParserMultilineStringCloseIndentMarker returns delimiter_start + 1.
        out.multilineOriginalEndColumns[lineIndex] = closeIndentMarker + 2
        lineIndex = closeLineIndex + 1
    err = ""
    return true

@borrows
fn ParserSourceRewriteCoordinateMapBuildInto(
        textRaw: str,
        rewrittenText: str,
        out: var ParserSourceRewriteCoordinateMap,
        err: var str): bool =
    var expectedRewritten: str
    if !ParserRewriteMultilineStringSourceText(textRaw,
                                                expectedRewritten,
                                                err):
        return false
    if expectedRewritten != rewrittenText:
        err = "parser rewrite coordinate map input mismatch"
        return false
    return parserSourceRewriteCoordinateMapFromExactRewriteInto(
        textRaw, rewrittenText, out, err)

@borrows
fn ParserRewriteMultilineStringSourceTextWithCoordinateMap(
        textRaw: str,
        rewrittenOut: var str,
        coordinateMapOut: var ParserSourceRewriteCoordinateMap,
        err: var str): bool =
    if !ParserRewriteMultilineStringSourceText(
           textRaw, rewrittenOut, err):
        return false
    return parserSourceRewriteCoordinateMapFromExactRewriteInto(
        textRaw, rewrittenOut, coordinateMapOut, err)

@borrows
fn ParserSourceRewriteOffsetToOriginalInto(
        coordinateMap: ParserSourceRewriteCoordinateMap,
        originalText: str,
        rewrittenText: str,
        rewrittenByteOffset: int32,
        originalByteOffsetOut: var int32,
        err: var str): bool =
    if coordinateMap.originalTextLength != originalText.len ||
       coordinateMap.rewrittenTextLength != rewrittenText.len ||
       coordinateMap.originalLineStarts.len !=
           coordinateMap.rewrittenLineStarts.len ||
       coordinateMap.originalLineStarts.len !=
           coordinateMap.originalLineLengths.len ||
       coordinateMap.originalLineStarts.len !=
           coordinateMap.multilineOpenColumns.len ||
       coordinateMap.originalLineStarts.len !=
           coordinateMap.multilineRewrittenEndColumns.len ||
       coordinateMap.originalLineStarts.len !=
           coordinateMap.multilineCloseLineIndexes.len ||
       coordinateMap.originalLineStarts.len !=
           coordinateMap.multilineOriginalEndColumns.len:
        err = "parser rewrite coordinate map shape mismatch"
        return false
    if rewrittenByteOffset == rewrittenText.len:
        originalByteOffsetOut = originalText.len
        err = ""
        return true
    var lineIndex: int32
    var column: int32
    if !ParserSourceRewriteOffsetPosition(
           coordinateMap.rewrittenLineStarts,
           rewrittenText.len,
           rewrittenByteOffset,
           lineIndex,
           column) ||
       lineIndex < 0 ||
       lineIndex >= coordinateMap.originalLineStarts.len:
        err = "parser rewrite coordinate offset is invalid"
        return false
    let openColumn = coordinateMap.multilineOpenColumns[lineIndex]
    if openColumn >= 0 && column > openColumn:
        if column != coordinateMap.multilineRewrittenEndColumns[lineIndex]:
            err = "parser rewrite coordinate boundary is inside rewritten literal"
            return false
        let closeLineIndex =
            coordinateMap.multilineCloseLineIndexes[lineIndex]
        let closeEndColumn =
            coordinateMap.multilineOriginalEndColumns[lineIndex]
        if closeLineIndex <= lineIndex ||
           closeLineIndex >= coordinateMap.originalLineStarts.len ||
           closeEndColumn <= 0:
            err = "parser rewrite coordinate close boundary is invalid"
            return false
        originalByteOffsetOut =
            coordinateMap.originalLineStarts[closeLineIndex] + closeEndColumn
        if originalByteOffsetOut > originalText.len:
            err = "parser rewrite coordinate close boundary exceeds source"
            return false
        err = ""
        return true
    if column > coordinateMap.originalLineLengths[lineIndex]:
        err = "parser rewrite coordinate column exceeds original line"
        return false
    originalByteOffsetOut =
        coordinateMap.originalLineStarts[lineIndex] + column
    err = ""
    return true

@borrows
fn ParserSourceRewriteSpanToOriginalInto(
        coordinateMap: ParserSourceRewriteCoordinateMap,
        originalText: str,
        rewrittenText: str,
        rewrittenStartByte: int32,
        rewrittenEndByte: int32,
        originalStartByteOut: var int32,
        originalEndByteOut: var int32,
        err: var str): bool =
    if rewrittenStartByte < 0 ||
       rewrittenEndByte <= rewrittenStartByte ||
       !ParserSourceRewriteOffsetToOriginalInto(
           coordinateMap,
           originalText,
           rewrittenText,
           rewrittenStartByte,
           originalStartByteOut,
           err) ||
       !ParserSourceRewriteOffsetToOriginalInto(
           coordinateMap,
           originalText,
           rewrittenText,
           rewrittenEndByte,
           originalEndByteOut,
           err):
        return false
    if originalEndByteOut <= originalStartByteOut:
        err = "parser rewrite coordinate span collapsed"
        return false
    err = ""
    return true

@borrows
fn ParserDiagnosticFailureAnchorSpanToOriginalInto(
        anchorKind: int32,
        coordinateMap: ParserSourceRewriteCoordinateMap,
        originalText: str,
        rewrittenText: str,
        rewrittenStartByte: int32,
        rewrittenEndByte: int32,
        originalStartByteOut: var int32,
        originalEndByteOut: var int32,
        err: var str): bool =
    if anchorKind < diagnostic_failure.DiagnosticFailureAnchorSource ||
       anchorKind > diagnostic_failure.DiagnosticFailureAnchorParserNodeOwnerDeclaration:
        err = "parser rewrite coordinate diagnostic anchor is invalid"
        return false
    if anchorKind ==
           diagnostic_failure.DiagnosticFailureAnchorSource:
        originalStartByteOut = 0
        originalEndByteOut = originalText.len
        err = ""
        return true
    return ParserSourceRewriteSpanToOriginalInto(
        coordinateMap,
        originalText,
        rewrittenText,
        rewrittenStartByte,
        rewrittenEndByte,
        originalStartByteOut,
        originalEndByteOut,
        err)

@borrows
fn ParserSourceHasMultilineString(textRaw: str): bool =
    if textRaw.len < 3:
        return false
    for i in 0..<(textRaw.len - 2):
        if textRaw[i] == Char(34) &&
           textRaw[i + 1] == Char(34) &&
           textRaw[i + 2] == Char(34):
            return true
    return false
fn ParserWriteByteFast(out: var str,
                         writePos: var int32,
                         value: int32) =
    rawmem_support.RawmemWriteI8(StrDataPtr(out), writePos, int8(value))
    writePos = writePos + 1

fn ParserI32DecimalLen(value: int32): int32 =
    var magnitude = int64(value)
    var outLen: int32 = 1
    if magnitude < 0:
        outLen = outLen + 1
        magnitude = -magnitude
    while magnitude >= int64(10):
        magnitude = magnitude / int64(10)
        outLen = outLen + 1
    return outLen

fn ParserWriteI32DecimalFast(out: var str,
                              writePos: var int32,
                              value: int32) =
    let textLen = ParserI32DecimalLen(value)
    var magnitude = int64(value)
    let negative = magnitude < 0
    if negative:
        magnitude = -magnitude
    var cursor = writePos + textLen - 1
    while magnitude >= int64(10):
        let digit = int32(magnitude % int64(10))
        rawmem_support.RawmemWriteI8(StrDataPtr(out), cursor, int8(48 + digit))
        magnitude = magnitude / int64(10)
        cursor = cursor - 1
    rawmem_support.RawmemWriteI8(StrDataPtr(out), cursor, int8(48 + int32(magnitude)))
    if negative:
        rawmem_support.RawmemWriteI8(StrDataPtr(out), writePos, int8(45))
    writePos = writePos + textLen

@borrows
fn NormalizedExprMakeCallId(sourcePath: str,
                              lineNumber: int32,
                              columnNumber: int32,
                              surfaceText: str,
                              callSurfaceKind: NormalizedExprSurfaceCallKind,
                              callReason: NormalizedExprCallReason,
                              callQualifier: str,
                              callCallee: str,
                              callTarget: str,
                              normalizedTargetSourcePath: str,
                              callTargetImportc: bool): str =
    let surfaceKindText = ParserCallSurfaceKindText(callSurfaceKind)
    let reasonText = ParserCallReasonText(callReason)
    let importcText = chengpath.PathBoolText(callTargetImportc)
    let totalLen = sourcePath.len +
                   ParserI32DecimalLen(lineNumber) +
                   ParserI32DecimalLen(columnNumber) +
                   surfaceText.len +
                   surfaceKindText.len +
                   reasonText.len +
                   callQualifier.len +
                   callCallee.len +
                   callTarget.len +
                   normalizedTargetSourcePath.len +
                   importcText.len +
                   15
    if totalLen <= 0:
        return ""
    var out = NewStringAlloc(totalLen)
    var writePos: int32
    ParserWriteTextFast(out, writePos, sourcePath)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteI32DecimalFast(out, writePos, lineNumber)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteI32DecimalFast(out, writePos, columnNumber)
    ParserWriteTextFast(out, writePos, ":call:")
    ParserWriteTextFast(out, writePos, surfaceText)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, surfaceKindText)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, reasonText)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, callQualifier)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, callCallee)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, callTarget)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, normalizedTargetSourcePath)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, importcText)
    return out

@borrows
fn NormalizedExprMakeId(sourcePath: str,
                          lineNumber: int32,
                          columnNumber: int32,
                          kind: NormalizedExprKind,
                          detailKind: NormalizedExprDetailKind): str =
    let lineText: str = Fmt"{lineNumber}"
    let columnText: str = Fmt"{columnNumber}"
    let kindText: str = Fmt"{NormalizedExprKindCode(kind)}"
    let detailCodeText: str = Fmt"{NormalizedExprDetailKindCode(detailKind)}"
    let totalLen = sourcePath.len + lineText.len + columnText.len + kindText.len + detailCodeText.len + 4
    if totalLen <= 0:
        return ""
    var out = NewStringAlloc(totalLen)
    var writePos: int32
    ParserWriteTextFast(out, writePos, sourcePath)
    ParserWriteByteFast(out, writePos, 35)
    ParserWriteTextFast(out, writePos, lineText)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, columnText)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, kindText)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, detailCodeText)
    return out

fn NormalizedExprMakeCallLikeId(sourcePath: str,
                                  lineNumber: int32,
                                  columnNumber: int32,
                                  kind: NormalizedExprKind,
                                  callSurfaceKind: NormalizedExprSurfaceCallKind,
                                  callResolved: bool,
                                  callReason: NormalizedExprCallReason,
                                  callQualifier: str,
                                  callCallee: str,
                                  callTarget: str,
                                  callTargetSourcePath: str,
                                  callTargetImportc: bool,
                                  callPrefixStyle: bool,
                                  callArgCount: int32,
                                  callArgsText: str): str =
    let callSurfaceKindText = ParserCallSurfaceKindText(callSurfaceKind)
    let callReasonText = ParserCallReasonText(callReason)
    let lineText: str = Fmt"{lineNumber}"
    let columnText: str = Fmt"{columnNumber}"
    let kindText: str = Fmt"{NormalizedExprKindCode(kind)}"
    let resolvedText = if callResolved: "1" else: "0"
    let targetImportcText = if callTargetImportc: "1" else: "0"
    let prefixStyleText = if callPrefixStyle: "1" else: "0"
    let argCountText: str = Fmt"{callArgCount}"
    let normalizedTargetSourcePath = ParserNormalizePath(callTargetSourcePath)
    let totalLen = sourcePath.len +
                   lineText.len +
                   columnText.len +
                   kindText.len +
                   callSurfaceKindText.len +
                   resolvedText.len +
                   callReasonText.len +
                   callQualifier.len +
                   callCallee.len +
                   callTarget.len +
                   normalizedTargetSourcePath.len +
                   targetImportcText.len +
                   prefixStyleText.len +
                   argCountText.len +
                   callArgsText.len +
                   14
    if totalLen <= 0:
        return ""
    var out = NewStringAlloc(totalLen)
    var writePos: int32
    ParserWriteTextFast(out, writePos, sourcePath)
    ParserWriteByteFast(out, writePos, 35)
    ParserWriteTextFast(out, writePos, lineText)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, columnText)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, kindText)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, callSurfaceKindText)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, resolvedText)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, callReasonText)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, callQualifier)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, callCallee)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, callTarget)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, normalizedTargetSourcePath)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, targetImportcText)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, prefixStyleText)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, argCountText)
    ParserWriteByteFast(out, writePos, 58)
    ParserWriteTextFast(out, writePos, callArgsText)
    return out

fn NormalizedExprLayerClone(layer: var NormalizedExprLayer): NormalizedExprLayer =
    var out: NormalizedExprLayer
    out.sourceCount = layer.sourceCount
    out.questionResidualCount = layer.questionResidualCount
    for i in 0..<layer.exprs.len:
        var clonedExpr: NormalizedExpr
        NormalizedExprCloneInto(layer.exprs[i], clonedExpr)
        add(out.exprs, clonedExpr)
    for i in 0..<layer.exprNext.len:
        add(out.exprNext, layer.exprNext[i])
    for i in 0..<layer.scopes.len:
        add(out.scopes, NormalizedScopeFactClone(layer.scopes[i]))
    var clonedLookup: NormalizedExprLookup
    for i in 0..<layer.exprLookup.slots.len:
        add(clonedLookup.slots, layer.exprLookup.slots[i])
    for i in 0..<layer.exprLookup.buckets.len:
        add(clonedLookup.buckets, layer.exprLookup.buckets[i])
    out.exprLookup = clonedLookup
    # The structural tree is immutable after parser production.  Transactional
    # clones copy only mutable metadata and hold an explicit read lease instead
    # of rebuilding every node/token column.
    if layer.valueExprTree != nil:
        out.valueExprTree = ParserValueExprTreeBorrow(layer.valueExprTree)
        out.valueExprTreeBorrowLease = true
    return out

fn normalizedExprLayerDescriptorsAlias(lhs: var NormalizedExprLayer,
                                         rhs: var NormalizedExprLayer): bool =
    let lhsSourceCount = lhs.sourceCount
    let rhsSourceCount = rhs.sourceCount
    var aliasMarker: int32
    if lhsSourceCount == 0:
        aliasMarker = 1
    else:
        aliasMarker = 0
    rhs.sourceCount = aliasMarker
    let aliases = lhs.sourceCount == aliasMarker
    rhs.sourceCount = rhsSourceCount
    return aliases

fn NormalizedExprLayerMoveInto(out: var NormalizedExprLayer,
                               layer: var NormalizedExprLayer) =
    if normalizedExprLayerDescriptorsAlias(out, layer):
        panic("parser value expr: layer move source aliases destination descriptor")
    if out.valueExprTree != nil &&
       out.valueExprTree == layer.valueExprTree &&
       !out.valueExprTreeBorrowLease &&
       !layer.valueExprTreeBorrowLease:
        panic("parser value expr: layer move has duplicate owner descriptors")
    var destinationReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
    NormalizedExprLayerTerminalReleaseWithReceipt(
        out, destinationReleaseReceipt)
    out.sourceCount = layer.sourceCount
    out.exprs = layer.exprs
    out.exprNext = layer.exprNext
    out.scopes = layer.scopes
    out.questionResidualCount = layer.questionResidualCount
    out.exprLookup = layer.exprLookup
    out.valueExprTree = layer.valueExprTree
    out.valueExprTreeBorrowLease = layer.valueExprTreeBorrowLease
    # 幽灵零槽根修(判词 50): move-steal 后源侧逐字段 detach, 不再走整体
    # record reset(默认构造值+record 拷贝)。整体 reset 在自宿主后端的
    # 构造值+拷贝路径上会释放已移交 payload(双释->悬垂)或把全零记录写到
    # 错误地址(全零幽灵槽, 指纹=kind=If(序数0)/line=0/str 全空)。
    # detach 语义: 句柄已归 out, 源侧 seq 头清零, 源后续释放恒为 no-op;
    # destination release receipt、别名/重复 owner 守卫、borrowed 元数据
    # 提交合同全部保持不变。
    layer.sourceCount = 0
    layer.questionResidualCount = 0
    layer.exprs.len = 0
    layer.exprs.cap = 0
    layer.exprs.buffer = nil
    layer.exprNext.len = 0
    layer.exprNext.cap = 0
    layer.exprNext.buffer = nil
    layer.scopes.len = 0
    layer.scopes.cap = 0
    layer.scopes.buffer = nil
    layer.exprLookup.slots.len = 0
    layer.exprLookup.slots.cap = 0
    layer.exprLookup.slots.buffer = nil
    layer.exprLookup.buckets.len = 0
    layer.exprLookup.buckets.cap = 0
    layer.exprLookup.buckets.buffer = nil
    layer.valueExprTree = nil
    layer.valueExprTreeBorrowLease = false

fn NormalizedExprLayerCommitBorrowedMetadata(
        out: var NormalizedExprLayer,
        staged: var NormalizedExprLayer) =
    if normalizedExprLayerDescriptorsAlias(out, staged):
        panic("parser value expr: metadata commit aliases destination descriptor")
    if !staged.valueExprTreeBorrowLease ||
       staged.valueExprTree == nil ||
       staged.valueExprTree != out.valueExprTree:
        panic("parser value expr: transaction commit requires exact borrowed tree")
    ParserValueExprTreeReleaseBorrow(staged.valueExprTree)
    staged.valueExprTreeBorrowLease = false
    let ownerTree = out.valueExprTree
    let destinationBorrowLease = out.valueExprTreeBorrowLease
    out.valueExprTree = nil
    out.valueExprTreeBorrowLease = false
    var destinationMetadataReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
    NormalizedExprLayerTerminalReleaseWithReceipt(
        out, destinationMetadataReleaseReceipt)
    out.sourceCount = staged.sourceCount
    out.exprs = staged.exprs
    out.exprNext = staged.exprNext
    out.scopes = staged.scopes
    out.questionResidualCount = staged.questionResidualCount
    out.exprLookup = staged.exprLookup
    out.valueExprTree = ownerTree
    out.valueExprTreeBorrowLease = destinationBorrowLease
    # 幽灵零槽同族根修(判词 50/52): commit 已把 exprs/exprNext/scopes/
    # exprLookup 句柄与标量移交 out, 源侧不再走整体 record reset(默认构造
    # 值+record 拷贝)——该形状在自宿主后端会释放已共享 payload(双释->
    # 悬垂)或把全零记录写到错误地址(幽灵零槽)。detach 语义: seq 头清零,
    # tree/lease 置空, 源后续释放恒为 no-op; borrowed tree 释放/lease 撤销
    # 次序、alias/重复 owner 守卫、destination release receipt 全部不变。
    staged.sourceCount = 0
    staged.questionResidualCount = 0
    staged.exprs.len = 0
    staged.exprs.cap = 0
    staged.exprs.buffer = nil
    staged.exprNext.len = 0
    staged.exprNext.cap = 0
    staged.exprNext.buffer = nil
    staged.scopes.len = 0
    staged.scopes.cap = 0
    staged.scopes.buffer = nil
    staged.exprLookup.slots.len = 0
    staged.exprLookup.slots.cap = 0
    staged.exprLookup.slots.buffer = nil
    staged.exprLookup.buckets.len = 0
    staged.exprLookup.buckets.cap = 0
    staged.exprLookup.buckets.buffer = nil
    staged.valueExprTree = nil
    staged.valueExprTreeBorrowLease = false

fn NormalizedExprLayerReset(layer: var NormalizedExprLayer) =
    # Function-slice scratch retains capacity but must release every borrowed
    # or owned string before shrinking the logical expression column.
    for i in 0..<layer.exprs.len:
        layer.exprs[i].exprId = ""
        layer.exprs[i].sourcePath = ""
        layer.exprs[i].surfaceText = ""
        layer.exprs[i].callQualifier = ""
        layer.exprs[i].callCallee = ""
        layer.exprs[i].callTarget = ""
        layer.exprs[i].callTargetSourcePath = ""
        layer.exprs[i].callArgsText = ""
    setLen(layer.exprs, 0)
    setLen(layer.exprNext, 0)
    for i in 0..<layer.scopes.len:
        layer.scopes[i].sourcePath = ""
    setLen(layer.scopes, 0)
    for i in 0..<layer.exprLookup.slots.len:
        layer.exprLookup.slots[i] = 0
    setLen(layer.exprLookup.buckets, 0)
    layer.sourceCount = 0
    layer.questionResidualCount = 0
    if layer.valueExprTreeBorrowLease:
        ParserValueExprTreeReleaseBorrow(layer.valueExprTree)
    else:
        ParserValueExprTreeRelease(layer.valueExprTree)
    # Owner/borrow release does not clear the layer field. The next Reset
    # or TerminalRelease would otherwise release the same tree again.
    layer.valueExprTree = nil
    layer.valueExprTreeBorrowLease = false

fn NormalizedExprLayerPhysicalBufferCount(
        layer: var NormalizedExprLayer): int32 =
    var count: int32
    if layer.exprs.cap > 0: count = count + 1
    if layer.exprNext.cap > 0: count = count + 1
    if layer.scopes.cap > 0: count = count + 1
    if layer.exprLookup.slots.cap > 0: count = count + 1
    if layer.exprLookup.buckets.cap > 0: count = count + 1
    if layer.valueExprTree != nil &&
       !layer.valueExprTreeBorrowLease:
        if layer.valueExprTree.arena.capacityBytes > 0:
            count = count + 1
        let internReceipt =
            langintern.InternPoolOwnerReceiptRead(
                layer.valueExprTree.internPool)
        if internReceipt.liveCount < int64(0) ||
           internReceipt.liveCount > int64(5):
            panic("parser value expr: intern release receipt invalid")
        count = count + int32(internReceipt.liveCount)
    return count

fn NormalizedExprLayerRetainedBytes(
        layer: var NormalizedExprLayer): int64 =
    var total =
        int64(layer.exprs.cap) * int64(sizeof(NormalizedExpr)) +
        int64(layer.exprNext.cap) * int64(sizeof(int32)) +
        int64(layer.scopes.cap) * int64(sizeof(NormalizedScopeFact)) +
        int64(layer.exprLookup.slots.cap) * int64(sizeof(int32)) +
        int64(layer.exprLookup.buckets.cap) *
            int64(sizeof(NormalizedExprLookupBucket))
    for exprIndex in 0..<layer.exprs.len:
        total = total + int64(layer.exprs[exprIndex].exprId.len)
        total = total + int64(layer.exprs[exprIndex].sourcePath.len)
        total = total + int64(layer.exprs[exprIndex].surfaceText.len)
        total = total + int64(layer.exprs[exprIndex].callQualifier.len)
        total = total + int64(layer.exprs[exprIndex].callCallee.len)
        total = total + int64(layer.exprs[exprIndex].callTarget.len)
        total = total +
            int64(layer.exprs[exprIndex].callTargetSourcePath.len)
        total = total + int64(layer.exprs[exprIndex].callArgsText.len)
    for scopeIndex in 0..<layer.scopes.len:
        total = total + int64(layer.scopes[scopeIndex].sourcePath.len)
    if !layer.valueExprTreeBorrowLease:
        total = total +
            ParserValueExprTreeRetainedBytes(layer.valueExprTree)
    return total

fn NormalizedExprLayerStorageReleased(
        layer: var NormalizedExprLayer): bool =
    return layer.exprs.cap == 0 &&
           layer.exprNext.cap == 0 &&
           layer.scopes.cap == 0 &&
           layer.exprLookup.slots.cap == 0 &&
           layer.exprLookup.buckets.cap == 0 &&
           layer.valueExprTree == nil &&
           !layer.valueExprTreeBorrowLease

fn NormalizedExprLayerTerminalReleaseWithReceipt(
        layer: var NormalizedExprLayer,
        receipt: var NormalizedExprLayerTerminalReleaseReceipt) =
    if layer.valueExprTree != nil &&
       !layer.valueExprTreeBorrowLease &&
       layer.valueExprTree.borrowLeaseCount != 0:
        panic("parser value expr: terminal release has active borrow")
    receipt.releasedBufferCount =
        NormalizedExprLayerPhysicalBufferCount(layer)
    receipt.releasedBytes =
        NormalizedExprLayerRetainedBytes(layer)
    NormalizedExprLayerReset(layer)
    freeSeq(layer.exprs)
    freeSeq(layer.exprNext)
    freeSeq(layer.scopes)
    freeSeq(layer.exprLookup.slots)
    freeSeq(layer.exprLookup.buckets)
    # 幽灵零槽同族加固(判词 50/52): freeSeq 已把 5 个 seq 头清零, 此处不再
    # 走整体 record reset(默认构造值+record 拷贝)——valueExprTree 可能仍
    # 持有共享树指针, 全零记录拷贝在自宿主后端有落错址/误释放面。逐字段
    # detach 与 reset 值语义逐字段等值, receipt 三判定(storageReleased/
    # bufferCount/retainedBytes)与 panic 守卫一字不动。
    layer.sourceCount = 0
    layer.questionResidualCount = 0
    layer.exprs.len = 0
    layer.exprs.cap = 0
    layer.exprs.buffer = nil
    layer.exprNext.len = 0
    layer.exprNext.cap = 0
    layer.exprNext.buffer = nil
    layer.scopes.len = 0
    layer.scopes.cap = 0
    layer.scopes.buffer = nil
    layer.exprLookup.slots.len = 0
    layer.exprLookup.slots.cap = 0
    layer.exprLookup.slots.buffer = nil
    layer.exprLookup.buckets.len = 0
    layer.exprLookup.buckets.cap = 0
    layer.exprLookup.buckets.buffer = nil
    layer.valueExprTree = nil
    layer.valueExprTreeBorrowLease = false
    receipt.storageReleased =
        NormalizedExprLayerStorageReleased(layer)
    if !receipt.storageReleased ||
       NormalizedExprLayerPhysicalBufferCount(layer) != 0 ||
       NormalizedExprLayerRetainedBytes(layer) != int64(0):
        panic("parser value expr: terminal release incomplete")

fn ParsedSourceStubPhysicalBufferCount(
        parsed: var ParsedSourceStub): int32 =
    var count = NormalizedExprLayerPhysicalBufferCount(
        parsed.normalizedExprLayer)
    if parsed.ownerModulePaths.cap > 0:
        count = count + 1
    if parsed.importEdges.cap > 0:
        count = count + 1
    if parsed.orderedClosureSourcePaths.cap > 0:
        count = count + 1
    return count

fn ParsedSourceStubManagedTextCount(
        parsed: var ParsedSourceStub): int32 =
    var count: int32
    if parsed.workspaceRoot != "": count = count + 1
    if parsed.packageRoot != "": count = count + 1
    if parsed.packageId != "": count = count + 1
    if parsed.entrySourcePath != "": count = count + 1
    if parsed.sourcePath != "": count = count + 1
    if parsed.moduleStem != "": count = count + 1
    if parsed.syntaxTag != "": count = count + 1
    for i in 0..<parsed.ownerModulePaths.len:
        if parsed.ownerModulePaths[i] != "":
            count = count + 1
    for i in 0..<parsed.orderedClosureSourcePaths.len:
        if parsed.orderedClosureSourcePaths[i] != "":
            count = count + 1
    for i in 0..<parsed.importEdges.len:
        if parsed.importEdges[i].ownerModulePath != "":
            count = count + 1
        if parsed.importEdges[i].targetModulePath != "":
            count = count + 1
        if parsed.importEdges[i].targetSourcePath != "":
            count = count + 1
        if parsed.importEdges[i].importAlias != "":
            count = count + 1
        if parsed.importEdges[i].qualifier != "":
            count = count + 1
    return count

fn ParsedSourceStubRetainedBytes(
        parsed: var ParsedSourceStub): int64 =
    var total =
        NormalizedExprLayerRetainedBytes(parsed.normalizedExprLayer) +
        int64(parsed.ownerModulePaths.cap) * int64(sizeof(str)) +
        int64(parsed.importEdges.cap) * int64(sizeof(ImportEdge)) +
        int64(parsed.orderedClosureSourcePaths.cap) * int64(sizeof(str))
    total = total + int64(parsed.workspaceRoot.len)
    total = total + int64(parsed.packageRoot.len)
    total = total + int64(parsed.packageId.len)
    total = total + int64(parsed.entrySourcePath.len)
    total = total + int64(parsed.sourcePath.len)
    total = total + int64(parsed.moduleStem.len)
    total = total + int64(parsed.syntaxTag.len)
    for i in 0..<parsed.ownerModulePaths.len:
        total = total + int64(parsed.ownerModulePaths[i].len)
    for i in 0..<parsed.orderedClosureSourcePaths.len:
        total = total + int64(parsed.orderedClosureSourcePaths[i].len)
    for i in 0..<parsed.importEdges.len:
        total = total + int64(parsed.importEdges[i].ownerModulePath.len)
        total = total + int64(parsed.importEdges[i].targetModulePath.len)
        total = total + int64(parsed.importEdges[i].targetSourcePath.len)
        total = total + int64(parsed.importEdges[i].importAlias.len)
        total = total + int64(parsed.importEdges[i].qualifier.len)
    return total

fn ParsedSourceStubStorageReleased(
        parsed: var ParsedSourceStub): bool =
    return parsed.workspaceRoot == "" &&
           parsed.packageRoot == "" &&
           parsed.packageId == "" &&
           parsed.entrySourcePath == "" &&
           parsed.sourcePath == "" &&
           parsed.moduleStem == "" &&
           parsed.syntaxTag == "" &&
           parsed.ownerModulePaths.len == 0 &&
           parsed.ownerModulePaths.cap == 0 &&
           parsed.ownerModulePaths.buffer == nil &&
           parsed.importEdges.len == 0 &&
           parsed.importEdges.cap == 0 &&
           parsed.importEdges.buffer == nil &&
           parsed.orderedClosureSourcePaths.len == 0 &&
           parsed.orderedClosureSourcePaths.cap == 0 &&
           parsed.orderedClosureSourcePaths.buffer == nil &&
           NormalizedExprLayerStorageReleased(
               parsed.normalizedExprLayer)

fn ParsedSourceStubTerminalReleaseWithReceipt(
        parsed: var ParsedSourceStub,
        receipt: var ParsedSourceStubTerminalReleaseReceipt) =
    if (parsed.ownerModulePaths.cap > 0 &&
        (parsed.ownerModulePaths.buffer == nil ||
         memRefCount(parsed.ownerModulePaths.buffer) != 1)) ||
       (parsed.importEdges.cap > 0 &&
        (parsed.importEdges.buffer == nil ||
         memRefCount(parsed.importEdges.buffer) != 1)) ||
       (parsed.orderedClosureSourcePaths.cap > 0 &&
        (parsed.orderedClosureSourcePaths.buffer == nil ||
         memRefCount(parsed.orderedClosureSourcePaths.buffer) != 1)):
        panic("parser source stub: terminal storage is not uniquely owned")
    receipt.releasedBufferCount =
        ParsedSourceStubPhysicalBufferCount(parsed)
    receipt.releasedTextCount =
        ParsedSourceStubManagedTextCount(parsed)
    receipt.releasedBytes =
        ParsedSourceStubRetainedBytes(parsed)
    NormalizedExprLayerTerminalReleaseWithReceipt(
        parsed.normalizedExprLayer,
        receipt.normalizedExprLayer)
    parsed.workspaceRoot = ""
    parsed.packageRoot = ""
    parsed.packageId = ""
    parsed.entrySourcePath = ""
    parsed.sourcePath = ""
    parsed.moduleStem = ""
    parsed.syntaxTag = ""
    seqs.freeSeqStrRelease(parsed.ownerModulePaths)
    seqs.freeSeqStrRelease(parsed.orderedClosureSourcePaths)
    for i in 0..<parsed.importEdges.len:
        parsed.importEdges[i].ownerModulePath = ""
        parsed.importEdges[i].targetModulePath = ""
        parsed.importEdges[i].targetSourcePath = ""
        parsed.importEdges[i].importAlias = ""
        parsed.importEdges[i].qualifier = ""
    seqs.chengSeqFreeTyped(parsed.importEdges)
    receipt.storageReleased =
        ParsedSourceStubStorageReleased(parsed)
    if !receipt.storageReleased ||
       ParsedSourceStubPhysicalBufferCount(parsed) != 0 ||
       ParsedSourceStubManagedTextCount(parsed) != 0 ||
       ParsedSourceStubRetainedBytes(parsed) != int64(0):
        panic("parser source stub: terminal release incomplete")

fn NormalizedExprLayerClearExprIds(layer: var NormalizedExprLayer) =
    for i in 0..<layer.exprs.len:
        if layer.exprs[i].exprId == "":
            continue
        layer.exprs[i].exprId = ""

@borrows
fn NormalizedExprLayerAppend(layer: var NormalizedExprLayer,
                               sourcePath: str,
                               lineNumber: int32,
                               columnNumber: int32,
                               kind: NormalizedExprKind,
                               detailKind: NormalizedExprDetailKind,
                               surfaceText: str) =
    NormalizedExprLayerAppendSpan(layer,
                                    sourcePath,
                                    lineNumber,
                                    columnNumber,
                                    kind,
                                    detailKind,
                                    surfaceText,
                                    NormalizedExprEndColumn(columnNumber, surfaceText))

@borrows
fn NormalizedExprLayerAppendSpan(layer: var NormalizedExprLayer,
                                   sourcePath: str,
                                   lineNumber: int32,
                                   columnNumber: int32,
                                   kind: NormalizedExprKind,
                                   detailKind: NormalizedExprDetailKind,
                                   surfaceText: str,
                                   endColumnNumberRaw: int32) =
    var expr: NormalizedExpr
    expr.sourcePath = ParserTextSliceCopy(
        sourcePath, 0, sourcePath.len)
    expr.lineNumber = lineNumber
    expr.columnNumber = columnNumber
    expr.endLineNumber = lineNumber
    expr.endColumnNumber = NormalizedExprEndColumn(columnNumber, surfaceText)
    if endColumnNumberRaw >= expr.endColumnNumber:
        expr.endColumnNumber = endColumnNumberRaw
    expr.kind = kind
    expr.detailKind = detailKind
    expr.surfaceText = ParserTextSliceCopy(
        surfaceText, 0, surfaceText.len)
    expr.callSurfaceKind = NormalizedExprSurfaceCallNone
    expr.callResolved = false
    expr.callReason = NormalizedExprCallReasonNone
    expr.callQualifier = ""
    expr.callCallee = ""
    expr.callTarget = ""
    expr.callTargetSourcePath = ""
    expr.callTargetImportc = false
    expr.callPrefixStyle = false
    expr.callArgCount = 0
    expr.callArgsText = ""
    expr.valueExprCallNodeIndex = -1
    expr.originParserNodeId = -1
    expr.callArgValueRootStart = -1
    expr.callArgValueRootCount = 0
    expr.valueExprRootNodeIndex = -1
    expr.valueExprSpanStart = -1
    expr.valueExprSpanEnd = -1
    expr.valueExprStatementRole = ParserValueExprStatementInvalid
    expr.anchorTokenIndex = -1
    expr.lexicalScopeId = 0
    expr.suiteScopeId = -1
    expr.statementOrdinal = -1
    expr.lexicalOrdinal = -1
    expr.deferOwnerStatementOrdinal = -1
    if NormalizedExprLayerContainsExpr(layer, expr):
        return
    add(layer.exprs, expr)
    add(layer.exprNext, -1)
    if layer.exprs[layer.exprs.len - 1].kind == NormalizedExprIf &&
       layer.exprs[layer.exprs.len - 1].lineNumber == 0 &&
       layer.exprs[layer.exprs.len - 1].sourcePath == "":
        panic("parser value expr: A1 Span append produced zero slot")
    NormalizedExprLayerRememberExpr(layer, layer.exprs.len - 1)

@borrows
fn NormalizedExprLayerAppendCall(layer: var NormalizedExprLayer,
                                   sourcePath: str,
                                   lineNumber: int32,
                                   columnNumber: int32,
                                   surfaceText: str,
                                   callSurfaceKind: NormalizedExprSurfaceCallKind,
                                   callResolved: bool,
                                   callReason: NormalizedExprCallReason,
                                   callQualifier: str,
                                   callCallee: str,
                                   callTarget: str,
                                   callTargetSourcePath: str,
                                   callTargetImportc: bool,
                                   callArgsText: str,
                                   callArgCount: int32,
                                   callPrefixStyle: bool,
                                   endColumnNumberRaw: int32) =
    let normalizedTargetSourcePath = ParserNormalizePath(callTargetSourcePath)
    var expr: NormalizedExpr
    expr.sourcePath = ParserOwnedText(sourcePath)
    expr.lineNumber = lineNumber
    expr.columnNumber = columnNumber
    expr.endLineNumber = lineNumber
    expr.endColumnNumber = NormalizedExprEndColumn(columnNumber, surfaceText)
    if endColumnNumberRaw >= expr.endColumnNumber:
        expr.endColumnNumber = endColumnNumberRaw
    expr.kind = NormalizedExprCall
    expr.detailKind = NormalizedExprDetailNone
    expr.surfaceText = ParserOwnedText(surfaceText)
    expr.callSurfaceKind = callSurfaceKind
    expr.callResolved = callResolved
    expr.callReason = callReason
    expr.callQualifier = ParserOwnedText(callQualifier)
    expr.callCallee = ParserOwnedText(callCallee)
    expr.callTarget = ParserOwnedText(callTarget)
    expr.callTargetSourcePath = share(normalizedTargetSourcePath)
    expr.callTargetImportc = callTargetImportc
    expr.callPrefixStyle = callPrefixStyle
    expr.callArgCount = callArgCount
    expr.callArgsText = ParserOwnedText(callArgsText)
    expr.valueExprCallNodeIndex = -1
    expr.originParserNodeId = -1
    expr.callArgValueRootStart = -1
    expr.callArgValueRootCount = 0
    expr.valueExprRootNodeIndex = -1
    expr.valueExprSpanStart = -1
    expr.valueExprSpanEnd = -1
    expr.valueExprStatementRole = ParserValueExprStatementInvalid
    expr.anchorTokenIndex = -1
    expr.lexicalScopeId = 0
    expr.suiteScopeId = -1
    expr.statementOrdinal = -1
    expr.lexicalOrdinal = -1
    expr.deferOwnerStatementOrdinal = -1
    if NormalizedExprLayerContainsExpr(layer, expr):
        return
    expr.exprId = NormalizedExprMakeCallId(sourcePath,
                                            lineNumber,
                                            columnNumber,
                                            surfaceText,
                                            callSurfaceKind,
                                            callReason,
                                            callQualifier,
                                            callCallee,
                                            callTarget,
                                            normalizedTargetSourcePath,
                                            callTargetImportc)
    add(layer.exprs, expr)
    add(layer.exprNext, -1)
    if layer.exprs[layer.exprs.len - 1].kind == NormalizedExprIf &&
       layer.exprs[layer.exprs.len - 1].lineNumber == 0 &&
       layer.exprs[layer.exprs.len - 1].sourcePath == "":
        panic("parser value expr: A2 Call append produced zero slot")
    NormalizedExprLayerRememberExpr(layer, layer.exprs.len - 1)

