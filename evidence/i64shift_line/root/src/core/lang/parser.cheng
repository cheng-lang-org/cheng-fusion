@importc("driver_c_new_string")
fn ParserNewStringRaw(size: int32): cstring

var parserTraceInitialized: bool
var parserTracePath: str
var parserDebugStageInitialized: bool
var parserDebugStageEnabled: bool
var parserMemTraceInitialized: bool
var parserMemTraceEnabled: bool
var parserMemTraceSource: str
var parserMemTraceSourceIndex: int32 = -1
var parserProfileCheckpointInitialized: bool
var parserProfileCheckpointTrace: bool
var parserStrictCallSyntaxInitialized: bool
var parserStrictCallSyntaxEnabled: bool
var parserCasFetcherSet: bool
var parserCasFetcherImpl: cas.CasSourceFetcher
var parserCasLockEnsurerSet: bool
var parserCasLockEnsurerImpl: cas.CasLockEnsurer
# [ar2-scratch] AD1 facade audit latch (design
# .rebuild/ad1_line/ARENA_ROUTING_DESIGN.md §3.3): one-time env read, default
# zero output zero side effect.  Audit rounds run separately from measurement
# rounds (one env=1 per round).
var parserScratchAuditInitialized: bool
var parserScratchAuditEnabled: bool
# PERF-7: cheng-package.toml 是编译会话内不可变的依赖清单(pack/publish 等独立子
# 命令只写到各自的 cacheRoot/publishDir, 从不写回被编译项目自己的 packageRoot),
# 但全仓多处调用点(ParserPackageId/ParserSharedRoot/TypedExprSourcePackageRoot 等)
# 在一次编译里对同一 packageRoot 反复触发整文件 fopen 重读(dispatch_min 采样实测
# 单一路径在 150s 窗口内被 fopen 525 次)。按 packageRoot 做进程内存备忘录消除重复
# 磁盘读: 命中路径与未命中首次计算返回值完全一致, 纯读缓存, 无启发式/无降级。
var parserPackageManifestCacheRoots: str[]
var parserPackageManifestCacheTexts: str[]

# ---- CAS fetch-on-miss 注入槽 (特性开关语义, 非 fallback) ----
# 未注入 (parserCasFetcherSet=false) → 依赖 blob miss 走旧 cas.CasResolveDependencyPath
# (无网络自动拉, 字节等价现行为, 零回归 opt-in)。已注入 → 走 WithFetch: blob miss 时调
# 注入 fetcher 按 cid 网络拉源 → cid 自校验 → ingest; fetch 失败=硬错上抛, 绝不回落旧
# 磁盘路径 (WithFetch 内 fetch miss 直接 Err, cas_store.cheng:248)。生产 fetcher (QUIC
# 拉源 wrapper) 由 driver-bake 侧经 ParserSetCasFetcher 注入 (见 SLOT_DESIGN)。fn-value
# 派发 driver-gated (cold/stage3 不 lower 函数值调用), 仅经全后端 driver-bake 端到端验。
fn ParserSetCasFetcher(fetcher: cas.CasSourceFetcher) =
    parserCasFetcherSet = true
    parserCasFetcherImpl = fetcher

# ---- P5-S1 缺锁自举 ensurer 注入槽 (特性开关语义, 非 fallback; 同 fetcher 槽 driver-gated) ----
# 未注入 → 缺锁走旧硬错 (lock 无 cid = 配置错崩, 字节零回归)。已注入 → 外部包 pin channel 且 lock
# 缺该模块时, 经注入 ensurer 展开 channelId→head→manifest→lock (子进程零 QUIC), 失败硬错上抛。
# fn-value 派发 driver-gated (cold/stage3 不 lower), 仅经全后端 driver-bake 端到端验 (与 fetcher 槽同窗口)。
fn ParserSetCasLockEnsurer(ensurer: cas.CasLockEnsurer) =
    parserCasLockEnsurerSet = true
    parserCasLockEnsurerImpl = ensurer

fn ParserTraceInit() =
    parserTraceInitialized = true

fn ParserTraceStage(stage: str) =
    if false:
        os.WriteLine(os.Get_stderr(), stage)

fn ParserDebugStage(stage: str) =
    if !parserDebugStageInitialized:
        parserDebugStageInitialized = true
        parserDebugStageEnabled = os.GetEnv("CHENG_PARSER_DEBUG") == "1"
    if !parserMemTraceInitialized:
        parserMemTraceInitialized = true
        parserMemTraceEnabled = os.GetEnv("CHENG_PARSER_MEM_TRACE") == "1"
    if parserDebugStageEnabled:
        os.WriteLine(os.Get_stderr(), Fmt"debug_parser={stage}")
    if parserMemTraceEnabled:
        os.WriteLine(os.Get_stderr(),
                     Fmt"parser_mem stage={stage} src={parserMemTraceSource} rss={os.ProcessRssBytes()} live={system.MemLiveAllocations()}")
# [E1e] Pairing key for the in-parse stages.  `ParserDebugStage` prints the
# path field `parserMemTraceSource`, which is only written by the front-end
# profile phase (`parserBuildExprCallProfileSyntaxInto`), so it is stale for
# the pass-0 parse window.  The consumer sets this index per source instead,
# and the in-parse stages print it verbatim next to the release lines key.
fn ParserMemTraceSourceIndexSet(index: int32) =
    if !parserMemTraceInitialized:
        parserMemTraceInitialized = true
        parserMemTraceEnabled = os.GetEnv("CHENG_PARSER_MEM_TRACE") == "1"
    if parserMemTraceEnabled:
        parserMemTraceSourceIndex = index

# [E1-p0-release] Release-window reading for the pass-0 per-source tree.
# Same switch and same one-time latch as `ParserDebugStage` above
# (`CHENG_PARSER_MEM_TRACE`); the extra readings are what `rss` and `live`
# alone cannot separate, plus the parser row counters (token/node) that decide
# which per-row population matches the retained block count.  `src_index` is
fn ParserMemTraceArenaStage(stage: str,
                            sourceIndex: int32,
                            arenaUsed: int32,
                            arenaCapacity: int32,
                            internPayload: int64,
                            internCount: int32,
                            tokenCount: int32,
                            nodeCount: int32) =
    if !parserMemTraceInitialized:
        parserMemTraceInitialized = true
        parserMemTraceEnabled = os.GetEnv("CHENG_PARSER_MEM_TRACE") == "1"
    if parserMemTraceEnabled:
        os.WriteLine(os.Get_stderr(),
                     Fmt"parser_mem stage={stage} src_index={sourceIndex} rss={os.ProcessRssBytes()} live={system.MemLiveAllocations()} arena_used={arenaUsed} arena_cap={arenaCapacity} intern_payload={internPayload} intern_count={internCount} token_count={tokenCount} node_count={nodeCount}")

type
    ParsedSourceKind = enum
        ParsedOrdinarySource

    ParserExternalPackageRoot =
        # Import compatibility prefix (for example `codex`).  Semantic source
        # identity never consumes this alias.
        packageId: str
        # Producer-certified manifest package_id (for example
        # `cheng/codex`).  This is frozen with the root so downstream identity
        # validation is pure and never re-reads a mutable manifest.
        canonicalPackageId: str
        packageRoot: str
        channel: str
        # A verified managed mirror is consumed from these immutable bytes.
        # packageRoot remains a local module↔path mapper only; when this bit is
        # set no parser/CSG consumer may reopen a source from the filesystem.
        verifiedSnapshotRequired: bool
        verifiedSourcePaths: str[]
        verifiedSourceTexts: str[]

    ParserImportSpec =
        ownerModulePath: str
        targetModulePath: str
        importAlias: str
        importDeclarationSourceLocalRow: int32
        importItemSourceLocalRow: int32

    ImportEdge =
        # Parser-owned source/import coordinates.  The source-local rows are
        # assigned by the import syntax producer.  The global rows are bound
        # once, after the per-source value-expression trees are merged.
        ownerProducerSourceIndex: int32
        importDeclarationSourceLocalRow: int32
        importItemSourceLocalRow: int32
        importDeclarationRow: int32
        importItemRow: int32
        ownerModulePath: str
        targetModulePath: str
        targetSourcePath: str
        targetSourcePathLen: int32
        targetSourcePathFirstCode: int32
        targetSourcePathLastCode: int32
        targetSourcePathDotCount: int32
        targetSourcePathHash: int32
        targetProfileIndex: int32
        importAlias: str
        qualifier: str
        allowsUnqualifiedCall: bool
        resolved: bool

    NormalizedExprKind = enum
        NormalizedExprIf
        NormalizedExprRange
        NormalizedExprComprehension
        NormalizedExprStrFormat
        NormalizedExprResultIntrinsic
        NormalizedExprCall
        NormalizedExprTry
        NormalizedExprDefaultInit
        NormalizedExprConstructor
        NormalizedExprReturn
        NormalizedExprAssign
        NormalizedExprIfStmt
        NormalizedExprElifStmt
        NormalizedExprElseStmt
        NormalizedExprForStmt
        NormalizedExprMatchStmt
        NormalizedExprCaseStmt
        NormalizedExprWhileStmt
        NormalizedExprDeferStmt
        NormalizedExprBreakStmt
        NormalizedExprContinueStmt

    NormalizedScopeKind = enum
        NormalizedScopeRoot
        NormalizedScopeIndentedSuite
        NormalizedScopeInlineSuite
        NormalizedScopeDeferSuite

    NormalizedExprDetailKind = enum
        NormalizedExprDetailNone
        NormalizedExprDetailIfKeyword
        NormalizedExprDetailIfTernary
        NormalizedExprDetailTryPostfixQuestion
        NormalizedExprDetailRangeInclusive
        NormalizedExprDetailRangeExclusive
        NormalizedExprDetailComprehensionList
        NormalizedExprDetailStrFormatLiteral
        NormalizedExprDetailStrFormatCall
        NormalizedExprDetailResultOk
        NormalizedExprDetailResultErr
        NormalizedExprDetailResultValue
        NormalizedExprDetailResultError
        NormalizedExprDetailResultIsOk
        NormalizedExprDetailResultIsErr
        NormalizedExprDetailResultErrorInfoOf

    # Parser-normalized value provenance for builtin call surfaces.  TypedIR
    # consumes this semantic tag instead of reconstructing ownership from raw
    # callee text in a backend.
    ParserBuiltinValueSemantic = enum
        ParserBuiltinValueNone
        ParserBuiltinValueOwned

    NormalizedExprSurfaceCallKind = enum
        NormalizedExprSurfaceCallNone
        NormalizedExprSurfaceCallLocal
        NormalizedExprSurfaceCallExternal
        NormalizedExprSurfaceCallImportc
        NormalizedExprSurfaceCallMember

    NormalizedExprCallReason = enum
        NormalizedExprCallReasonNone
        NormalizedExprCallReasonUnknownQualifiedTarget
        NormalizedExprCallReasonShadowedQualifiedTarget
        NormalizedExprCallReasonAmbiguousExternalTarget
        NormalizedExprCallReasonAmbiguousQualifiedTarget
        NormalizedExprCallReasonUnknownExternalTarget
        NormalizedExprCallReasonUnknownCallTarget

    # Parser-owned value-expression authority for contextual call-argument
    # typing.  Call resolution consumes this tree instead of independently
    # reclassifying raw argument text.  Every edge points to a strictly smaller
    # source expression, so construction and recursive consumers terminate
    # without a depth limit.
    ParserValueExprKind = enum
        ParserValueExprInvalid
        ParserValueExprIdentifier
        ParserValueExprBoolLiteral
        ParserValueExprCharLiteral
        ParserValueExprStringLiteral
        ParserValueExprIntegerLiteral
        ParserValueExprFloatLiteral
        ParserValueExprNilLiteral
        ParserValueExprFmtLiteral
        ParserValueExprTupleLiteral
        ParserValueExprListLiteral
        ParserValueExprBraceLiteral
        ParserValueExprCall
        ParserValueExprSpaceCall
        ParserValueExprField
        ParserValueExprIndex
        ParserValueExprSlice
        ParserValueExprTry
        ParserValueExprUnary
        ParserValueExprBinary
        ParserValueExprTernary
        ParserValueExprIf
        ParserValueExprWhen
        ParserValueExprCase
        ParserValueExprCaseBranch
        ParserValueExprComprehension
        ParserValueExprFunctionLiteral
        ParserValueExprIteratorLiteral
        ParserValueExprTypeConversion
        ParserValueExprGrouped
        ParserValueExprBreakNode
        ParserValueExprContinueNode
        ParserValueExprDeferNode

    # Lexically-authoritative source regions bind non-value grammar surfaces
    # to the exact token stream. Structured producers such as Pattern and
    # TypeSyntax retain their own SoA nodes; a region is only their enclosing
    # syntax owner and must never be used as a text-parsing substitute.
    ParserValueExprRegionKind = enum
        ParserValueExprRegionInvalid
        ParserValueExprRegionModuleHeaderLine
        ParserValueExprRegionConceptTraitHeader
        ParserValueExprRegionAnnotationLine
        ParserValueExprRegionAnnotationArgs
        ParserValueExprRegionTypeDeclHeader
        ParserValueExprRegionTypeExprText
        ParserValueExprRegionTypeParamList
        ParserValueExprRegionParamType
        ParserValueExprRegionReturnType
        ParserValueExprRegionFieldDeclType
        ParserValueExprRegionPattern
        ParserValueExprRegionCaseArm
        ParserValueExprRegionLValue
        ParserValueExprRegionFieldBlock

    # Exact parser-owned role of a statement value root.  The anchor is the
    # statement operator/keyword token (for example `=` or `return`), not a
    # rediscovered byte pattern in a later compiler phase.
    ParserValueExprStatementRole = enum
        ParserValueExprStatementInvalid
        ParserValueExprStatementBindingInitializer
        ParserValueExprStatementAssignmentRhs
        ParserValueExprStatementReturnValue
        ParserValueExprStatementImplicitReturnValue
        ParserValueExprStatementYieldValue
        ParserValueExprStatementExpression
        ParserValueExprStatementCondition
        ParserValueExprStatementLoopSource
        ParserValueExprStatementParameterDefault
        ParserValueExprStatementTypeDefault
        ParserValueExprStatementWhereCondition
        ParserValueExprStatementCaseEntry
        ParserValueExprStatementCaseGuard

    # Compile-time integer expressions inside T[N] are also parser-owned AST,
    # not token ranges interpreted by TypeArena.  Children are exact int32
    # indexes and strictly smaller than their parent.
    ParserTypeConstExprKind = enum
        ParserTypeConstExprInvalid
        ParserTypeConstExprInteger
        ParserTypeConstExprUnaryPlus
        ParserTypeConstExprUnaryMinus
        ParserTypeConstExprAdd
        ParserTypeConstExprSubtract
        ParserTypeConstExprMultiply
        ParserTypeConstExprDivide
        ParserTypeConstExprModulo
        # [S1b step-3 (9)] A module `const` name used as a const-expression
        # leaf (C chain: cold_eval_i32_const_expr resolves a leaf through
        # symbols_find_const).  The node's token is the exact name token and
        # its integer value is the table's resolved int32, so every later
        # stage consumes a value, never a re-lookup.
        ParserTypeConstExprName

    ParserValueTokenKind = enum
        ParserValueTokenInvalid
        ParserValueTokenIdentifier
        ParserValueTokenInteger
        ParserValueTokenFloat
        ParserValueTokenString
        ParserValueTokenChar
        ParserValueTokenFmtString
        ParserValueTokenTrue
        ParserValueTokenFalse
        ParserValueTokenNil
        ParserValueTokenAwait
        ParserValueTokenIn
        ParserValueTokenNotIn
        ParserValueTokenIf
        ParserValueTokenElif
        ParserValueTokenElse
        ParserValueTokenWhen
        ParserValueTokenCase
        ParserValueTokenOf
        ParserValueTokenFor
        ParserValueTokenFn
        ParserValueTokenIterator
        ParserValueTokenWhere
        ParserValueTokenLet
        ParserValueTokenVar
        ParserValueTokenConst
        ParserValueTokenType
        ParserValueTokenReturn
        ParserValueTokenYield
        ParserValueTokenBreak
        ParserValueTokenContinue
        ParserValueTokenDefer
        ParserValueTokenMatch
        ParserValueTokenWhile
        ParserValueTokenBlock
        ParserValueTokenAsync
        ParserValueTokenMacro
        ParserValueTokenTemplate
        ParserValueTokenConcept
        ParserValueTokenTrait
        ParserValueTokenEnum
        ParserValueTokenRef
        ParserValueTokenSet
        ParserValueTokenTuple
        ParserValueTokenObject
        ParserValueTokenImport
        ParserValueTokenModule
        ParserValueTokenLeftParen
        ParserValueTokenRightParen
        ParserValueTokenLeftBracket
        ParserValueTokenRightBracket
        ParserValueTokenLeftBrace
        ParserValueTokenRightBrace
        ParserValueTokenComma
        ParserValueTokenColon
        ParserValueTokenSemicolon
        ParserValueTokenAt
        ParserValueTokenBacktick
        ParserValueTokenDot
        ParserValueTokenQuestion
        ParserValueTokenPlus
        ParserValueTokenMinus
        ParserValueTokenStar
        ParserValueTokenSlash
        ParserValueTokenPercent
        ParserValueTokenBang
        ParserValueTokenTilde
        ParserValueTokenDollar
        ParserValueTokenCaret
        ParserValueTokenAmp
        ParserValueTokenPipe
        ParserValueTokenArrow
        ParserValueTokenAssign
        ParserValueTokenEqual
        ParserValueTokenNotEqual
        ParserValueTokenLess
        ParserValueTokenLessEqual
        ParserValueTokenGreater
        ParserValueTokenGreaterEqual
        ParserValueTokenShiftLeft
        ParserValueTokenShiftRight
        ParserValueTokenLogicalAnd
        ParserValueTokenLogicalOr
        ParserValueTokenRangeInclusive
        ParserValueTokenRangeExclusive

    # Parser-owned structural type syntax.  These rows are syntax identities,
    # not resolved semantic TypeIds: names point at exact lexer tokens and all
    # composition is expressed by int32 child edges.  Later phases may resolve
    # them once, but must never rebuild this graph from source text.
    ParserTypeSyntaxKind = enum
        ParserTypeSyntaxInvalid
        ParserTypeSyntaxNominal
        ParserTypeSyntaxQualified
        ParserTypeSyntaxBracketApply
        ParserTypeSyntaxSeq
        ParserTypeSyntaxFixedArray
        ParserTypeSyntaxTuple
        ParserTypeSyntaxFunction
        ParserTypeSyntaxVarBorrow
        ParserTypeSyntaxAlias
        ParserTypeSyntaxObject
        ParserTypeSyntaxRefObject
        # `type Name =` is Cheng's implicit object declaration form.  The
        # producer row is anchored at the declared-name token because the RHS
        # is intentionally empty; its body fields point back to this row.
        ParserTypeSyntaxImplicitObject
        ParserTypeSyntaxEnum
        # Algebraic declarations are explicit TypeSyntax graphs.  The
        # Algebraic row owns ordered Variant children; each Variant owns the
        # exact field type rows from its optional payload.
        ParserTypeSyntaxVariant
        ParserTypeSyntaxAlgebraic
        # Parentheses are parser-owned syntax, not discarded trivia.  The
        # marker token is the exact `(`, the span ends at its matching `)`,
        # and the sole child is the grouped type expression.
        ParserTypeSyntaxGrouped
        # Postfix `?` is a structural unary type constructor.  Its exact
        # question token is carried in the TypeSyntax SoA; consumers must not
        # recover optionality from source text.
        ParserTypeSyntaxOptional

    ParserTypeSyntaxRootKind = enum
        ParserTypeSyntaxRootInvalid
        ParserTypeSyntaxRootFunctionParameter
        ParserTypeSyntaxRootFunctionReturn
        ParserTypeSyntaxRootTypeDeclarationRhs
        ParserTypeSyntaxRootFieldDeclaration
        ParserTypeSyntaxRootBindingAnnotation
        ParserTypeSyntaxRootGenericConstraint
        ParserTypeSyntaxRootGenericDefault

    # Canonical parser declaration producer kinds.  Enum values belong to the
    # one current sealed schema and migrate atomically with every consumer.
    ParserDeclarationKind = enum
        ParserDeclarationInvalid
        ParserDeclarationModule
        ParserDeclarationType
        ParserDeclarationFunction
        ParserDeclarationField
        ParserDeclarationParameter
        ParserDeclarationLocal
        ParserDeclarationConcept
        ParserDeclarationTrait

    ParserDeclarationLexicalScopeKind = enum
        ParserDeclarationLexicalScopeInvalid
        ParserDeclarationLexicalScopeSource
        ParserDeclarationLexicalScopeType
        ParserDeclarationLexicalScopeFunction
        ParserDeclarationLexicalScopeBlock

    # Parser-produced lexical binding identity.  `None` is a deliberate
    # unresolved identifier; resolved rows always name the exact declaration
    # producer and, for pattern bindings, the exact Pattern row.
    ParserValueExprBindingResolutionKind = enum
        ParserValueExprBindingResolutionNone
        ParserValueExprBindingResolutionParameter
        ParserValueExprBindingResolutionPattern

    ParserLexicalBindingIntroductionKind = enum
        ParserLexicalBindingIntroductionInvalid
        ParserLexicalBindingIntroductionParameterList
        ParserLexicalBindingIntroductionDeclaration
        ParserLexicalBindingIntroductionInitializer
        ParserLexicalBindingIntroductionPatternIterator
        ParserLexicalBindingIntroductionPatternEntry

    ParserPatternKind = enum
        ParserPatternInvalid
        ParserPatternBinding
        ParserPatternWildcard
        ParserPatternLiteral
        ParserPatternTuple
        ParserPatternSequence
        ParserPatternObject
        ParserPatternConstructor
        ParserPatternNamedField
        ParserPatternRange

    # A bare exported identifier has different grammar meaning in a
    # declaration pattern and a match pattern.  The parse context is carried
    # structurally through recursive pattern parsing so binding declarations
    # never infer declaration identity from capitalization, while match arms
    # retain exported variant literals and constructors.
    ParserPatternParseContext = enum
        ParserPatternParseInvalid
        ParserPatternParseBindingDeclaration
        ParserPatternParseMatchArm

    # Every Pattern root has exactly one structural owner. Child rows inherit
    # that authority through Pattern child CSR and therefore carry Invalid/-1.
    # Region owners cover binding/for/comprehension/match/case-statement
    # surfaces; value-node owners bind case-expression patterns directly to
    # their ParserValueExprCaseBranch row.
    ParserPatternOwnerKind = enum
        ParserPatternOwnerInvalid
        ParserPatternOwnerRegion
        ParserPatternOwnerValueNode

    # Parser-owned recursive annotation syntax. Annotation rows bind the
    # exact next source token as their target; argument composition is a
    # postorder int32 graph, never text split by an annotation consumer.
    ParserAnnotationArgKind = enum
        ParserAnnotationArgInvalid
        ParserAnnotationArgIdentifier
        ParserAnnotationArgNumber
        ParserAnnotationArgString
        ParserAnnotationArgCharacter
        ParserAnnotationArgBoolean
        ParserAnnotationArgList
        ParserAnnotationArgDict
        ParserAnnotationArgKeyValue

    # These rows are the parser-owned identity of grammar productions whose
    # surface only forwards to an existing declaration/statement/pattern
    # producer.  They do not duplicate an AST.  The exact selected grammar
    # arm and the typed child CSR are retained so a receipt consumer never
    # reconstructs dispatch from token text.
    ParserForwardingProductionKind = enum
        ParserForwardingProductionInvalid
        ParserForwardingProductionTopLevelDecl
        ParserForwardingProductionTopLevelCore
        ParserForwardingProductionTemplateBody
        ParserForwardingProductionStatement
        ParserForwardingProductionStatementCore
        ParserForwardingProductionMatchArm
        ParserForwardingProductionBlockStmt

    ParserForwardingProductionChildKind = enum
        ParserForwardingProductionChildInvalid
        ParserForwardingProductionChildForwardingProduction
        ParserForwardingProductionChildValueNode
        ParserForwardingProductionChildStatementRoot
        ParserForwardingProductionChildRegion
        ParserForwardingProductionChildToken
        ParserForwardingProductionChildDeclaration
        ParserForwardingProductionChildPattern
        ParserForwardingProductionChildAnnotation
        ParserForwardingProductionChildLexicalScope
        ParserForwardingProductionChildTypeSyntax

    ParserImportOriginSoA = ref object
        declarationCount: int32
        itemCount: int32
        moduleTokenCount: int32
        declarationProducerSourceIndexes: arenamod.ArenaArrayInt32
        declarationSourceLocalRows: arenamod.ArenaArrayInt32
        declarationKeywordTokenIndexes: arenamod.ArenaArrayInt32
        declarationSpanStarts: arenamod.ArenaArrayInt32
        declarationSpanEnds: arenamod.ArenaArrayInt32
        declarationItemStarts: arenamod.ArenaArrayInt32
        declarationItemCounts: arenamod.ArenaArrayInt32
        itemProducerSourceIndexes: arenamod.ArenaArrayInt32
        itemSourceLocalRows: arenamod.ArenaArrayInt32
        itemDeclarationRows: arenamod.ArenaArrayInt32
        itemAliasTokenIndexes: arenamod.ArenaArrayInt32
        itemSpanStarts: arenamod.ArenaArrayInt32
        itemSpanEnds: arenamod.ArenaArrayInt32
        itemModuleTokenStarts: arenamod.ArenaArrayInt32
        itemModuleTokenCounts: arenamod.ArenaArrayInt32
        itemPrefixTokenCounts: arenamod.ArenaArrayInt32
        moduleTokenIndexes: arenamod.ArenaArrayInt32

    # AD1 scratch facade handle (ar2 line): 16-byte value (offset/len/
    # capacity/generation) over the per-source scratch arena; contains no
    # arena reference (stale-safe shape, lessons.md:220).  Grep gate: this
    # type must never appear in a file other than parser.cheng and must
    # never be stored in a persistent structure's field.
    ParserScratchSeqInt32 = arenamod.ArenaArrayInt32

    ParserValueExprTree = ref object
        # One profile-level owner.  Nodes retain only source ids and spans;
        # strings are projected from the unique interned parser input.
        arena: arenamod.Arena
        # [ar2-scratch] AD1 per-source scratch arena (design decision point
        # 2): deliberately NOT tree.arena -- transient spans here would
        # distort the census/sourceArenaUsed accounting, strand bytes in the
        # middle of resident columns until tree release (lessons.md:194
        # bloat shape), and break the C2/replay column reconciliation.
        # Lazily created on the first facade reserve; released at every
        # tree.arena release point, so zero cost for unrouted trees.
        scratchArena: arenamod.Arena
        internPool: langintern.InternPool
        nodeCount: int32
        genericCount: int32
        rootCount: int32
        tokenCount: int32
        callEventCount: int32
        statementRootCount: int32
        regionCount: int32
        producerSourceCount: int32
        typeSyntaxCount: int32
        typeSyntaxChildCount: int32
        typeSyntaxBracketArgCount: int32
        typeGenericSymbolCount: int32
        typeGenericSymbolChildCount: int32
        typeEnumVariantCount: int32
        typeConstExprCount: int32
        importOrigins: ParserImportOriginSoA
        declarationCount: int32
        declarationFunctionCount: int32
        declarationLexicalScopeCount: int32
        lexicalBindingCount: int32
        lexicalBindingBucketCount: int32
        patternCount: int32
        patternChildCount: int32
        annotationCount: int32
        annotationArgCount: int32
        annotationArgRootCount: int32
        annotationArgChildCount: int32
        forwardingProductionCount: int32
        forwardingProductionChildCount: int32
        lifecycleState: int32
        # Exactly one producer owns the mutable storage.  Read-only consumers
        # take explicit leases; owner release is deferred until the final lease
        # closes, so no raw ref alias can double-free or observe freed storage.
        ownerAttached: bool
        borrowLeaseCount: int32
        appendCommitCount: int32
        appendNodeVisitCount: int64
        appendTokenVisitCount: int64
        cloneNodeVisitCount: int64
        cloneTokenVisitCount: int64
        # Execution-only parser admission.  It is set solely by the explicit
        # migration-source reader and is never inferred from path or bytes.
        migrationSourceSyntax: bool
        # Parse-time structural owners.  They are declaration rows, never
        # object identities, source positions, or names.
        activeModuleDeclarationRow: int32
        activeTypeDeclarationRow: int32
        activeFunctionDeclarationRow: int32
        # Exact declaration owner for concept/trait suites.  It is an int32
        # producer row, never a name or source-position approximation.
        activeConceptTraitDeclarationRow: int32
        activeFunctionRow: int32
        activeDeclarationLexicalScopeRow: int32
        # A declaration is not visible inside its own initializer.  This
        # exact declaration-row interval is active only while parsing that
        # initializer and is restored before returning to its caller.
        activePendingBindingDeclarationStart: int32
        activePendingBindingDeclarationCount: int32
        activePendingBindingLexicalScopeRow: int32
        activeForwardingProductionRow: int32
        forwardingProductionsSealed: bool
        lexicalBindingAuthoritySealed: bool
        structuralValidationPassed: bool
        # Populated only on a failed read and consumed before tree release.
        # `failureSpanExact=false` means the explicit source anchor [0,len).
        failureSpanExact: bool
        failureStartByte: int32
        failureEndByte: int32
        failureArtifact: diagnostic_failure.DiagnosticFailureArtifact
        kinds: arenamod.ArenaArrayInt32
        # Every structural node carries both domains explicitly.  The
        # aggregate index is its row in these SoA columns; source-local origin
        # is stable across forest append and is scoped by producerSourceIndex.
        nodeProducerSourceIndexes: arenamod.ArenaArrayInt32
        nodeSourceLocalIndexes: arenamod.ArenaArrayInt32
        sourceTextIds: arenamod.ArenaArrayInt32
        # Authoritative source byte length per sourceTextId, written at lex
        # time from the trusted source string length. Span projections and
        # forest-append remapping validate/copy against this int32 column,
        # never against a possibly ABI-polluted str view length.
        sourceTextLengths: arenamod.ArenaArrayInt32
        spanStarts: arenamod.ArenaArrayInt32
        spanEnds: arenamod.ArenaArrayInt32
        atomStarts: arenamod.ArenaArrayInt32
        atomEnds: arenamod.ArenaArrayInt32
        ownerStarts: arenamod.ArenaArrayInt32
        ownerEnds: arenamod.ArenaArrayInt32
        nameStarts: arenamod.ArenaArrayInt32
        nameEnds: arenamod.ArenaArrayInt32
        operatorStarts: arenamod.ArenaArrayInt32
        operatorEnds: arenamod.ArenaArrayInt32
        argumentNameStarts: arenamod.ArenaArrayInt32
        argumentNameEnds: arenamod.ArenaArrayInt32
        callArgsStarts: arenamod.ArenaArrayInt32
        callArgsEnds: arenamod.ArenaArrayInt32
        argumentRootStarts: arenamod.ArenaArrayInt32
        argumentRootCounts: arenamod.ArenaArrayInt32
        firstChilds: arenamod.ArenaArrayInt32
        childCounts: arenamod.ArenaArrayInt32
        nextSiblings: arenamod.ArenaArrayInt32
        parentNodeIndexes: arenamod.ArenaArrayInt32
        nodeStatementRootEventIndexes: arenamod.ArenaArrayInt32
        nodeLexicalScopeRows: arenamod.ArenaArrayInt32
        nodeBindingResolutionKinds: arenamod.ArenaArrayInt32
        nodeResolvedBindingDeclarationRows: arenamod.ArenaArrayInt32
        nodeResolvedBindingPatternRows: arenamod.ArenaArrayInt32
        explicitGenericStarts: arenamod.ArenaArrayInt32
        explicitGenericCounts: arenamod.ArenaArrayInt32
        explicitGenericSpanStarts: arenamod.ArenaArrayInt32
        explicitGenericSpanEnds: arenamod.ArenaArrayInt32
        regionKinds: arenamod.ArenaArrayInt32
        regionSourceTextIds: arenamod.ArenaArrayInt32
        regionSpanStarts: arenamod.ArenaArrayInt32
        regionSpanEnds: arenamod.ArenaArrayInt32
        regionAnchorTokenIndexes: arenamod.ArenaArrayInt32
        typeSyntaxKinds: arenamod.ArenaArrayInt32
        typeSyntaxSourceTextIds: arenamod.ArenaArrayInt32
        # Parser-owned source row.  Single-source trees use row 0; append/clone
        # remap by the exact producer-source offset.  Portable consumers join
        # this int32 row to the source receipt, never to sourcePath text.
        typeSyntaxProducerSourceIndexes: arenamod.ArenaArrayInt32
        # Parser-authored row inside the exact producer source.  Forest append
        # preserves this value verbatim; consumers must never reconstruct it
        # from encounter order.
        typeSyntaxSourceLocalRows: arenamod.ArenaArrayInt32
        typeSyntaxSpanStarts: arenamod.ArenaArrayInt32
        typeSyntaxSpanEnds: arenamod.ArenaArrayInt32
        typeSyntaxOwnerTokenIndexes: arenamod.ArenaArrayInt32
        typeSyntaxDeclarationOwnerTokenIndexes: arenamod.ArenaArrayInt32
        # Root-only declaration producer edge.  A type-declaration root owns
        # itself; a field root points at the exact type-declaration root that
        # was active in the parser's type-block control flow.  Non-root nodes
        # carry -1 and are reached from their owning root through child CSR.
        typeSyntaxDeclarationOwnerNodeIndexes: arenamod.ArenaArrayInt32
        typeSyntaxGenericSymbolStarts: arenamod.ArenaArrayInt32
        typeSyntaxGenericSymbolCounts: arenamod.ArenaArrayInt32
        typeSyntaxChildStarts: arenamod.ArenaArrayInt32
        typeSyntaxChildCounts: arenamod.ArenaArrayInt32
        typeSyntaxChildNodeIndexes: arenamod.ArenaArrayInt32
        typeSyntaxBracketArgStarts: arenamod.ArenaArrayInt32
        typeSyntaxBracketArgCounts: arenamod.ArenaArrayInt32
        typeSyntaxBracketArgTokenStarts: arenamod.ArenaArrayInt32
        typeSyntaxBracketArgTokenCounts: arenamod.ArenaArrayInt32
        # One ordered row per bracket token argument.  A non-negative entry is
        # the exact postorder TypeSyntax root for a structurally valid type
        # argument; -1 means this token range is not a type and must only be
        # consumed by an explicit const-expression authority.
        typeSyntaxBracketArgTypeNodeIndexes: arenamod.ArenaArrayInt32
        typeSyntaxBracketArgConstExprRootIndexes: arenamod.ArenaArrayInt32
        typeSyntaxNameTokenIndexes: arenamod.ArenaArrayInt32
        typeSyntaxFixedLengths: arenamod.ArenaArrayInt32
        typeSyntaxQuestionTokenIndexes: arenamod.ArenaArrayInt32
        typeSyntaxRootKinds: arenamod.ArenaArrayInt32
        # Ordered declaration-owned enum variants.  The per-TypeSyntax CSR is
        # non-empty only on ParserTypeSyntaxEnum declaration roots.  Payload
        # TypeSyntax is optional and uses -1 when the variant has no payload.
        typeSyntaxEnumVariantStarts: arenamod.ArenaArrayInt32
        typeSyntaxEnumVariantCounts: arenamod.ArenaArrayInt32
        typeEnumVariantProducerSourceIndexes: arenamod.ArenaArrayInt32
        typeEnumVariantDeclarationOwnerNodeIndexes: arenamod.ArenaArrayInt32
        typeEnumVariantDeclarationOwnerTokenIndexes: arenamod.ArenaArrayInt32
        typeEnumVariantNameTokenIndexes: arenamod.ArenaArrayInt32
        typeEnumVariantOrdinals: arenamod.ArenaArrayInt32
        typeEnumVariantPayloadTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        typeGenericSymbolProducerSourceIndexes: arenamod.ArenaArrayInt32
        typeGenericSymbolDeclarationOwnerTokenIndexes: arenamod.ArenaArrayInt32
        typeGenericSymbolNameTokenIndexes: arenamod.ArenaArrayInt32
        typeGenericSymbolOrdinals: arenamod.ArenaArrayInt32
        # Generic parameters are parser-owned rows.  Their full declaration
        # token span and exact owning TypeSyntax root survive source release;
        # optional constraint/default type expressions are ordered child CSR
        # edges (constraint first, default second), never reparsed text.
        typeGenericSymbolSpanStarts: arenamod.ArenaArrayInt32
        typeGenericSymbolSpanEnds: arenamod.ArenaArrayInt32
        # Every explicit declaration generic is owned by one exact
        # declaration row.  TypeSyntax ownership is a separate structural
        # edge used by the parsed constraint/default/type graph.
        typeGenericSymbolOwnerDeclarationRows: arenamod.ArenaArrayInt32
        typeGenericSymbolOwnerTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        typeGenericSymbolConstraintTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        typeGenericSymbolDefaultTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        typeGenericSymbolChildStarts: arenamod.ArenaArrayInt32
        typeGenericSymbolChildCounts: arenamod.ArenaArrayInt32
        typeGenericSymbolChildTypeSyntaxNodeIndexes: arenamod.ArenaArrayInt32
        # Canonical constant-expression AST columns.
        typeConstExprKinds: arenamod.ArenaArrayInt32
        typeConstExprProducerSourceIndexes: arenamod.ArenaArrayInt32
        typeConstExprTokenIndexes: arenamod.ArenaArrayInt32
        typeConstExprLeftChildIndexes: arenamod.ArenaArrayInt32
        typeConstExprRightChildIndexes: arenamod.ArenaArrayInt32
        typeConstExprIntegerValues: arenamod.ArenaArrayInt32
        # [S1b step-3 (9)] Module-level `const` bindings of THIS source, in
        # declaration order: the exact name token, whether the declared (or
        # inferred) type is int32, and the resolved int32 value.  `T[NAME]`
        # consults this table while the source is parsed -- the C chain's
        # symbols_find_const + cold_const_i32_value -- so a known const name is
        # never re-classified as a type argument.  The table is filled by one
        # pre-pass over the freshly lexed tokens, which is what makes a
        # forward-referencing `T[NAME]` (legal: T[N] only requires N to be a
        # compile-time constant) resolve exactly like a backward one.  Parse
        # phase state: nothing reads it after this source is parsed, so it is
        # deliberately not carried by ParserValueExprTreeAppendFrom.
        typeConstModuleNameTokens: arenamod.ArenaArrayInt32
        typeConstModuleInt32Flags: arenamod.ArenaArrayInt32
        typeConstModuleValues: arenamod.ArenaArrayInt32
        rootNodeIndexes: arenamod.ArenaArrayInt32
        callEventNodeIndexes: arenamod.ArenaArrayInt32
        statementRootNodeIndexes: arenamod.ArenaArrayInt32
        statementRootRoles: arenamod.ArenaArrayInt32
        # Exact parser identities for the statement anchor and, only for a
        # binding initializer or declaration default, the declaration rows
        # produced by that same parser transaction.  Later projections must
        # not recover either identity from line text.
        statementRootAnchorTokenIndexes: arenamod.ArenaArrayInt32
        statementRootBindingDeclarationStarts: arenamod.ArenaArrayInt32
        statementRootBindingDeclarationCounts: arenamod.ArenaArrayInt32
        statementRootAnchorLineNumbers: arenamod.ArenaArrayInt32
        statementRootAnchorColumnNumbers: arenamod.ArenaArrayInt32
        statementRootEndLineNumbers: arenamod.ArenaArrayInt32
        statementRootEndColumnNumbers: arenamod.ArenaArrayInt32
        tokenKinds: arenamod.ArenaArrayInt32
        tokenSourceTextIds: arenamod.ArenaArrayInt32
        # Token identity is producer-local, not source-text-derived.  The
        # lexical parent is -1 for the primary source stream and the exact
        # earlier Fmt token row for interpolation substreams.
        tokenProducerSourceIndexes: arenamod.ArenaArrayInt32
        tokenSourceLocalIndexes: arenamod.ArenaArrayInt32
        tokenLexicalParentIndexes: arenamod.ArenaArrayInt32
        tokenStarts: arenamod.ArenaArrayInt32
        tokenEnds: arenamod.ArenaArrayInt32
        tokenLineNumbers: arenamod.ArenaArrayInt32
        tokenColumnNumbers: arenamod.ArenaArrayInt32
        # Unified declaration producer stream.  Aggregate row is the column
        # index; sourceLocalDeclarationRow is stable across forest append.
        declarationProducerSourceIndexes: arenamod.ArenaArrayInt32
        declarationSourceLocalRows: arenamod.ArenaArrayInt32
        declarationKinds: arenamod.ArenaArrayInt32
        declarationNameTokenIndexes: arenamod.ArenaArrayInt32
        declarationOwnerRows: arenamod.ArenaArrayInt32
        declarationLexicalScopeRows: arenamod.ArenaArrayInt32
        declarationFunctionRows: arenamod.ArenaArrayInt32
        declarationTypeSyntaxRootIndexes: arenamod.ArenaArrayInt32
        # Exact forward identity for a parameter default expression.  The
        # reverse statement-root declaration authority must name the same
        # declaration row; -1 means this declaration has no default.
        declarationDefaultStatementRootRows: arenamod.ArenaArrayInt32
        # Ordered explicit type parameters owned by this declaration.
        declarationGenericSymbolStarts: arenamod.ArenaArrayInt32
        declarationGenericSymbolCounts: arenamod.ArenaArrayInt32
        # Exact declaration-owned suite scope. Function rows point at their
        # Function lexical scope; concept/trait rows point at their root Block
        # scope. Nested block scopes cannot impersonate either edge.
        declarationSuiteLexicalScopeRows: arenamod.ArenaArrayInt32
        declarationSpanStarts: arenamod.ArenaArrayInt32
        declarationSpanEnds: arenamod.ArenaArrayInt32
        declarationNameSpanStarts: arenamod.ArenaArrayInt32
        declarationNameSpanEnds: arenamod.ArenaArrayInt32
        declarationMutableFlags: arenamod.ArenaArrayInt32
        declarationExportedFlags: arenamod.ArenaArrayInt32
        declarationLexicalScopeProducerSourceIndexes: arenamod.ArenaArrayInt32
        declarationLexicalScopeSourceLocalRows: arenamod.ArenaArrayInt32
        declarationLexicalScopeKinds: arenamod.ArenaArrayInt32
        declarationLexicalScopeParentRows: arenamod.ArenaArrayInt32
        declarationLexicalScopeOwnerDeclarationRows: arenamod.ArenaArrayInt32
        # Exact primary-source UTF-8 byte range governed by this lexical
        # scope. Producers bind each row exactly once after its complete
        # control-flow range is known; no consumer reconstructs it from
        # declarations, lines, indentation, or text.
        declarationLexicalScopeSpanStarts: arenamod.ArenaArrayInt32
        declarationLexicalScopeSpanEnds: arenamod.ArenaArrayInt32
        # Hash-chained lexical symbol table keyed by exact (scope row, token
        # bytes).  Payload identities are int32 producer rows; visibility is
        # the first postorder node index created after registration.
        lexicalBindingBucketHeads: arenamod.ArenaArrayInt32
        lexicalBindingScopeRows: arenamod.ArenaArrayInt32
        lexicalBindingNameTokenIndexes: arenamod.ArenaArrayInt32
        lexicalBindingDeclarationRows: arenamod.ArenaArrayInt32
        lexicalBindingPatternRows: arenamod.ArenaArrayInt32
        lexicalBindingVisibleFromNodeIndexes: arenamod.ArenaArrayInt32
        lexicalBindingIntroductionKinds: arenamod.ArenaArrayInt32
        lexicalBindingIntroductionStatementRootRows: arenamod.ArenaArrayInt32
        lexicalBindingIntroductionValueNodeRows: arenamod.ArenaArrayInt32
        lexicalBindingVisibilityAnchorTokenIndexes: arenamod.ArenaArrayInt32
        lexicalBindingNextRows: arenamod.ArenaArrayInt32
        patternProducerSourceIndexes: arenamod.ArenaArrayInt32
        patternSourceLocalRows: arenamod.ArenaArrayInt32
        patternKinds: arenamod.ArenaArrayInt32
        patternNameTokenIndexes: arenamod.ArenaArrayInt32
        patternOwnerLexicalScopeRows: arenamod.ArenaArrayInt32
        patternOwnerKinds: arenamod.ArenaArrayInt32
        patternOwnerRows: arenamod.ArenaArrayInt32
        patternBindingDeclarationRows: arenamod.ArenaArrayInt32
        # Exact binding annotation edge.  Only a binding Pattern row and the
        # root of its parser transaction may carry the same TypeSyntax root;
        # every other Pattern row stores -1.
        patternTypeSyntaxRootIndexes: arenamod.ArenaArrayInt32
        patternSpanStarts: arenamod.ArenaArrayInt32
        patternSpanEnds: arenamod.ArenaArrayInt32
        patternChildStarts: arenamod.ArenaArrayInt32
        patternChildCounts: arenamod.ArenaArrayInt32
        patternChildNodeIndexes: arenamod.ArenaArrayInt32
        annotationProducerSourceIndexes: arenamod.ArenaArrayInt32
        annotationSourceLocalRows: arenamod.ArenaArrayInt32
        annotationNameTokenIndexes: arenamod.ArenaArrayInt32
        annotationTargetTokenIndexes: arenamod.ArenaArrayInt32
        annotationSpanStarts: arenamod.ArenaArrayInt32
        annotationSpanEnds: arenamod.ArenaArrayInt32
        annotationArgRootStarts: arenamod.ArenaArrayInt32
        annotationArgRootCounts: arenamod.ArenaArrayInt32
        annotationArgRootNodeIndexes: arenamod.ArenaArrayInt32
        annotationArgProducerSourceIndexes: arenamod.ArenaArrayInt32
        annotationArgSourceLocalRows: arenamod.ArenaArrayInt32
        annotationArgOwnerRows: arenamod.ArenaArrayInt32
        annotationArgKinds: arenamod.ArenaArrayInt32
        annotationArgTokenIndexes: arenamod.ArenaArrayInt32
        annotationArgSeparatorTokenIndexes: arenamod.ArenaArrayInt32
        annotationArgSpanStarts: arenamod.ArenaArrayInt32
        annotationArgSpanEnds: arenamod.ArenaArrayInt32
        annotationArgChildStarts: arenamod.ArenaArrayInt32
        annotationArgChildCounts: arenamod.ArenaArrayInt32
        annotationArgChildNodeIndexes: arenamod.ArenaArrayInt32
        forwardingProductionProducerSourceIndexes: arenamod.ArenaArrayInt32
        forwardingProductionSourceLocalRows: arenamod.ArenaArrayInt32
        forwardingProductionKinds: arenamod.ArenaArrayInt32
        forwardingProductionArmIndexes: arenamod.ArenaArrayInt32
        forwardingProductionOwnerRows: arenamod.ArenaArrayInt32
        forwardingProductionAnchorTokenIndexes: arenamod.ArenaArrayInt32
        forwardingProductionSpanStartTokenIndexes: arenamod.ArenaArrayInt32
        forwardingProductionSpanEndTokenIndexes: arenamod.ArenaArrayInt32
        forwardingProductionSpanStarts: arenamod.ArenaArrayInt32
        forwardingProductionSpanEnds: arenamod.ArenaArrayInt32
        # One exact non-forwarding authority is sufficient for each row.
        # Forwarding children are joined from ownerRows during sealing.
        forwardingProductionAuthorityKinds: arenamod.ArenaArrayInt32
        forwardingProductionAuthorityRows: arenamod.ArenaArrayInt32
        forwardingProductionAnnotationStarts: arenamod.ArenaArrayInt32
        forwardingProductionAnnotationCounts: arenamod.ArenaArrayInt32
        forwardingProductionChildStarts: arenamod.ArenaArrayInt32
        forwardingProductionChildCounts: arenamod.ArenaArrayInt32
        forwardingProductionChildKinds: arenamod.ArenaArrayInt32
        forwardingProductionChildRows: arenamod.ArenaArrayInt32
    NormalizedExpr =
        exprId: str
        sourcePath: str
        lineNumber: int32
        columnNumber: int32
        endLineNumber: int32
        endColumnNumber: int32
        kind: NormalizedExprKind
        detailKind: NormalizedExprDetailKind
        surfaceText: str
        callSurfaceKind: NormalizedExprSurfaceCallKind
        callResolved: bool
        callReason: NormalizedExprCallReason
        callQualifier: str
        callCallee: str
        callTarget: str
        callTargetSourcePath: str
        callTargetImportc: bool
        callPrefixStyle: bool
        callArgCount: int32
        callArgsText: str
        # Stable postorder node id in NormalizedExprLayer.valueExprTree.  The
        # typed layer consumes this id directly; it must never rediscover the
        # call or its argument boundaries from callArgsText.
        valueExprCallNodeIndex: int32
        # Immutable source-local parser Call/SpaceCall node id.  Unlike the
        # structural index above, this identity is never offset when source
        # trees are merged into a candidate forest.
        originParserNodeId: int32
        callArgValueRootStart: int32
        callArgValueRootCount: int32
        # Top-level statement value authority.  `valueExprRootNodeIndex` is a
        # postorder id in the layer tree; the absolute source span is retained
        # explicitly so multiline RHS text never has to be reconstructed from
        # physical source lines by TypedIR or a backend.
        valueExprRootNodeIndex: int32
        valueExprSpanStart: int32
        valueExprSpanEnd: int32
        valueExprStatementRole: ParserValueExprStatementRole
        # Frozen parser token row for statement/suite identity.  Receipt
        # consumers validate this row; they never recover it from line/column.
        anchorTokenIndex: int32
        lexicalScopeId: int32
        suiteScopeId: int32
        statementOrdinal: int32
        lexicalOrdinal: int32
        deferOwnerStatementOrdinal: int32
        spanStart: int32
        spanEnd: int32

    NormalizedScopeFact =
        sourcePath: str
        scopeId: int32
        sourceScopeId: int32
        parentScopeId: int32
        kind: NormalizedScopeKind
        ownerStatementOrdinal: int32
        ownerStatementRow: int32
        # Exact parser declaration row for declaration-owned suites (currently
        # indented routine bodies). This is mutually exclusive with a
        # statement owner and survives forest append as a rebased int32 row.
        ownerDeclarationRow: int32
        moduleRootAnchor: bool
        lexicalOrdinal: int32
        indentColumn: int32
        startLineNumber: int32
        startColumnNumber: int32
        endLineNumber: int32
        endColumnNumber: int32
        anchorTokenIndex: int32

    NormalizedExprLookupBucket =
        sourcePathLen: int32
        sourcePathFirstCode: int32
        sourcePathLastCode: int32
        lineNumber: int32
        columnNumber: int32
        kindCode: int32
        detailCode: int32
        surfaceLen: int32
        surfaceFirstCode: int32
        surfaceLastCode: int32
        head: int32
        pad: int32

    NormalizedExprLookupKey =
        sourcePathLen: int32
        sourcePathFirstCode: int32
        sourcePathLastCode: int32
        lineNumber: int32
        columnNumber: int32
        kindCode: int32
        detailCode: int32
        surfaceLen: int32
        surfaceFirstCode: int32
        surfaceLastCode: int32

    NormalizedExprLookup =
        slots: int32[]
        buckets: NormalizedExprLookupBucket[]

    NormalizedExprLayer =
        sourceCount: int32
        exprs: NormalizedExpr[]
        exprNext: int32[]
        scopes: NormalizedScopeFact[]
        questionResidualCount: int32
        exprLookup: NormalizedExprLookup
        valueExprTree: ParserValueExprTree
        valueExprTreeBorrowLease: bool

    NormalizedExprLayerTerminalReleaseReceipt =
        releasedBufferCount: int32
        releasedBytes: int64
        storageReleased: bool

    NormalizedExprLayerKindCounts =
        exprCount: int32
        ifCount: int32
        rangeCount: int32
        comprehensionCount: int32
        strFormatCount: int32
        resultIntrinsicCount: int32
        callCount: int32
        tryCount: int32
        defaultInitCount: int32
        constructorCount: int32
        returnCount: int32
        assignCount: int32
        ifStmtCount: int32
        elifStmtCount: int32
        elseStmtCount: int32
        forStmtCount: int32
        matchStmtCount: int32
        caseStmtCount: int32
        whileStmtCount: int32
        deferStmtCount: int32
        breakStmtCount: int32
        continueStmtCount: int32

    ParserStructuredStatementSeed =
        lineIndex: int32
        lineNumber: int32
        columnNumber: int32
        endLineNumber: int32
        endColumnNumber: int32
        kind: NormalizedExprKind
        surfaceText: str
        lexicalScopeId: int32
        suiteScopeId: int32
        statementOrdinal: int32
        lexicalOrdinal: int32
        deferOwnerStatementOrdinal: int32
        anchorTokenIndex: int32
        spanStart: int32
        spanEnd: int32

    ParserStructuredSourceFacts =
        built: bool
        sourcePath: str
        sourceLineCount: int32
        scopes: NormalizedScopeFact[]
        seeds: ParserStructuredStatementSeed[]
        lineScopeIds: int32[]
        lineInlineSuiteBodyColumns: int32[]
        lineInlineSuiteScopeIds: int32[]
        lineDeferOwnerOrdinals: int32[]
        lineInlineDeferBodyColumns: int32[]
        lineInlineDeferSuiteScopeIds: int32[]
        lineSeedStarts: int32[]
        lineSeedCounts: int32[]
        scopeBuildLineVisitCount: int64
        structuredBuildLineVisitCount: int64

    ParserStructuredSourceSlice =
        built: bool
        sourcePath: str
        lineStartNumber: int32
        lineEndNumber: int32
        scopes: NormalizedScopeFact[]
        seeds: ParserStructuredStatementSeed[]
        sourceScopeIds: int32[]
        sourceStatementOrdinals: int32[]
        lineScopeIds: int32[]
        lineInlineSuiteBodyColumns: int32[]
        lineInlineSuiteScopeIds: int32[]
        lineDeferOwnerOrdinals: int32[]
        lineInlineDeferBodyColumns: int32[]
        lineInlineDeferSuiteScopeIds: int32[]
        lineVisitCount: int64
        scopeVisitCount: int64
        seedVisitCount: int64
        applyExprVisitCount: int64

    ParserStructuredIntMap =
        slots: int32[]
        keys: int32[]
        values: int32[]

    ParsedSourceStub =
        workspaceRoot: str
        packageRoot: str
        packageId: str
        entrySourcePath: str
        sourcePath: str
        moduleStem: str
        syntaxTag: str
        sourceKind: ParsedSourceKind
        ownerModulePaths: str[]
        importEdges: ImportEdge[]
        orderedClosureSourcePaths: str[]
        normalizedExprLayer: NormalizedExprLayer
        hasCompilerTopLevel: bool
        mainFunctionPresent: bool
        unresolvedImportCount: int32

    ParsedSourceStubTerminalReleaseReceipt =
        releasedBufferCount: int32
        releasedTextCount: int32
        releasedBytes: int64
        normalizedExprLayer: NormalizedExprLayerTerminalReleaseReceipt
        storageReleased: bool

    NormalizedFunctionDecl =
        name: str
        lineIndex: int32
        signatureStartColumn: int32
        signatureEndLineIndex: int32
        signatureEndColumn: int32
        nameStartColumn: int32
        nameEndColumn: int32
        bodyStartLineIndex: int32
        bodyStartColumn: int32
        importc: bool
        importcAnnotationBound: bool
        explicitExportName: str
        surfaceKeyword: str
        ffiMapPtrArg: int32
        ffiMapLenArg: int32
        ffiOutPtrArgs: str
        abiInternal: bool
        ffiOwnedResultPresent: bool
        ffiOwnedResultFree: str
        borrowResult: bool
        threadBoundary: bool
        borrows: bool
        escapes: bool
        weak: bool
        trustedAbi: bool
        noAlloc: bool
        interruptHandler: bool
        keepExportBinding: bool
        # Exact parser-owned manual-consume effect.  Every row is the
        # producer-local declaration identity from ParserValueExprTree;
        # ordinals are retained only as an independently checked projection.
        manualConsumePresent: bool
        manualConsumeFunctionDeclarationRow: int32
        manualConsumeTargetParameterOrdinal: int32
        manualConsumeTargetParameterDeclarationRow: int32
        manualConsumeSourceParameterOrdinal: int32
        manualConsumeSourceParameterDeclarationRow: int32
        manualConsumeIdentityDigest: int64

    NormalizedFfiHandleEffect = enum
        NormalizedFfiHandleEffectInvalid
        NormalizedFfiHandleEffectProduce
        NormalizedFfiHandleEffectBorrow
        NormalizedFfiHandleEffectConsume

    NormalizedFfiHandleUnwind = enum
        NormalizedFfiHandleUnwindInvalid
        NormalizedFfiHandleUnwindNoUnwind

    # Parser-owned DOD/SoA authority for explicit FFI handle contracts.  A
    # function has at most one row; parameters are one canonical ordinal CSR.
    # Every identity is a producer-local declaration row, never text/line/name.
    NormalizedFfiHandleContractTable =
        functionDeclarationRows: int32[]
        annotationRows: int32[]
        unwindKinds: int32[]
        resultEffects: int32[]
        parameterStarts: int32[]
        parameterCounts: int32[]
        identityDigests: int64[]
        parameterOrdinals: int32[]
        parameterSourceLocalDeclarationRows: int32[]
        parameterEffects: int32[]

    # Exact boundary map from the parser's multiline-string rewrite back to
    # the immutable source bytes. Rewritten offsets are never published as
    # source offsets: consumers must prove every boundary through this map.
    ParserSourceRewriteCoordinateMap =
        originalTextLength: int32
        rewrittenTextLength: int32
        originalLineStarts: int32[]
        originalLineLengths: int32[]
        rewrittenLineStarts: int32[]
        multilineOpenColumns: int32[]
        multilineRewrittenEndColumns: int32[]
        multilineCloseLineIndexes: int32[]
        multilineOriginalEndColumns: int32[]

    NormalizedTypeDecl =
        name: str
        refObject: bool

    NormalizedExprCallProfile =
        sourcePath: str
        ownerModulePath: str
        migrationSourceSyntax: bool
        text: str
        lines: str[]
        decls: NormalizedFunctionDecl[]
        typeDecls: NormalizedTypeDecl[]
        importcCallNames: str[]
        localCallNames: str[]
        importEdges: ImportEdge[]
        maxQualifiedCallDepth: int32

    NormalizedExprResolvedCallTarget =
        sourcePath: str
        importc: bool
        reason: NormalizedExprCallReason

    ParserValueExprCallResolution =
        surfaceKind: NormalizedExprSurfaceCallKind
        resolved: bool
        reason: NormalizedExprCallReason
        targetSourcePath: str
        targetImportc: bool
        targetUsesCalleeText: bool

    ParserImportedTargetLookup =
        targetProfileIndex: int32
        reason: NormalizedExprCallReason

    ParserTextSeqCacheEntry =
        profileIndex: int32
        items: str[]

    ParserQualifiedTextSeqCacheEntry =
        profileIndex: int32
        prefix: str
        items: str[]

    ParserTextLookupKey =
        keyLen: int32
        firstCode: int32
        lastCode: int32
        dotCount: int32
        textHash: int32

    ParserTextLookupBucket =
        keyLen: int32
        firstCode: int32
        lastCode: int32
        dotCount: int32
        textHash: int32
        items: str[]

    ParserTextLookup =
        slots: int32[]
        buckets: ParserTextLookupBucket[]
        totalCount: int32

    # [tg-knife] Duplicate-name seen set over name tokens.  Same role as a
    # local ParserTextLookup used only for "already seen this exact name"
    # checks, but the table stores the name's own token index instead of an
    # owned clone of its text: hashing reads the bytes from the borrowed
    # interned source view and equality reuses the C2 span compare, so the
    # per-name CloneStrRange/ParserOwnedText materialization disappears.
    ParserNameSeenSet =
        slots: int32[]
        totalCount: int32

    ParserSourcePathIndexEntry =
        sourcePath: str
        profileIndex: int32

    ParserSourcePathIndexBucket =
        keyLen: int32
        firstCode: int32
        lastCode: int32
        dotCount: int32
        sourcePathHash: int32
        items: ParserSourcePathIndexEntry[]

    ParserSourcePathIndexLookup =
        slots: int32[]
        buckets: ParserSourcePathIndexBucket[]

type
    ParserProfileCallLookupCacheEntry =
        localLookup: ParserTextLookup
        importcLookup: ParserTextLookup

var
    parserActivePackageRoot: str

