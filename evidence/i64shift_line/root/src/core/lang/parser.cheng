@borrows
fn ParserValueExprTypeSyntaxAliasDeclarationRootWrapsTuple(
        tree: ParserValueExprTree,
        declarationOwnerNodeIndex: int32): bool =
    # [phaseB-parser] `type N = tuple[a: T, ...]` 的声明根是 Alias 包裹
    # Tuple（AppendTypeSyntaxRootInto 的 aliasDeclaration 包装）。仅这种
    # 别名声明根可以拥有 FieldDeclaration root；别名到标量/序列等的普通
    # 类型别名仍不得拥有字段声明。
    if ParserValueExprTypeSyntaxKindAt(
           tree, declarationOwnerNodeIndex) !=
           ParserTypeSyntaxAlias:
        return false
    let childStart = ParserValueExprTypeSyntaxColumnAt(
        tree, tree.typeSyntaxChildStarts, declarationOwnerNodeIndex)
    if ParserValueExprTypeSyntaxColumnAt(
           tree, tree.typeSyntaxChildCounts,
           declarationOwnerNodeIndex) != 1:
        return false
    return ParserValueExprTypeSyntaxKindAt(
        tree,
        arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.typeSyntaxChildNodeIndexes,
            childStart)) == ParserTypeSyntaxTuple

@borrows
fn ParserValueExprTypeSyntaxDeclarationOwnerEdgeValid(
        tree: ParserValueExprTree,
        nodeIndex: int32,
        declarationOwnerNodeIndex: int32): bool =
    if tree == nil ||
       nodeIndex < 0 || nodeIndex >= tree.typeSyntaxCount ||
       declarationOwnerNodeIndex < 0 ||
       declarationOwnerNodeIndex >= tree.typeSyntaxCount:
        return false
    let rootKind =
        ParserValueExprTypeSyntaxRootKindAt(tree, nodeIndex)
    if rootKind == ParserTypeSyntaxRootTypeDeclarationRhs:
        return declarationOwnerNodeIndex == nodeIndex
    if rootKind != ParserTypeSyntaxRootFieldDeclaration ||
       declarationOwnerNodeIndex >= nodeIndex:
        return false
    let ownerRootKind =
        ParserValueExprTypeSyntaxRootKindAt(
            tree, declarationOwnerNodeIndex)
    let ownerKind =
        ParserValueExprTypeSyntaxKindAt(
            tree, declarationOwnerNodeIndex)
    let topLevelObjectOwner =
        ownerRootKind == ParserTypeSyntaxRootTypeDeclarationRhs &&
        (ownerKind == ParserTypeSyntaxImplicitObject ||
         ownerKind == ParserTypeSyntaxObject ||
         ownerKind == ParserTypeSyntaxRefObject)
    # [phaseB-parser] 内联 tuple 具名元素的字段声明 root 的 owner 边：
    # object 缩进字段机制的精确同构（owner=所在内联类型声明根），见
    # ParserValueExprTypeSyntaxAliasDeclarationRootWrapsTuple。
    let topLevelTupleAliasOwner =
        ownerRootKind == ParserTypeSyntaxRootTypeDeclarationRhs &&
        ParserValueExprTypeSyntaxAliasDeclarationRootWrapsTuple(
            tree, declarationOwnerNodeIndex)
    let nestedObjectOwner =
        ownerRootKind == ParserTypeSyntaxRootFieldDeclaration &&
        (ownerKind == ParserTypeSyntaxObject ||
         ownerKind == ParserTypeSyntaxRefObject)
    return (topLevelObjectOwner || topLevelTupleAliasOwner ||
            nestedObjectOwner) &&
           ParserValueExprTypeSyntaxProducerSourceIndexAt(
               tree, nodeIndex) ==
               ParserValueExprTypeSyntaxProducerSourceIndexAt(
                   tree, declarationOwnerNodeIndex) &&
           ParserValueExprTypeSyntaxSourceIdAt(tree, nodeIndex) ==
               ParserValueExprTypeSyntaxSourceIdAt(
                   tree, declarationOwnerNodeIndex)

