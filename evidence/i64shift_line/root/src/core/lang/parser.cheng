@borrows
fn parserValueExprReadTreeFromTextMode(text: str,
                                       migrationSourceSyntax: bool,
                                       arenaReserveBytes: int32,
                                       arenaColumnCensus: int32[],
                                       tree: var ParserValueExprTree,
                                       err: var str): bool =
    if tree != nil:
        ParserValueExprTreeRelease(tree)
    ParserValueExprTreeEnsureActive(tree)
    # Exact-capacity hint: the forest merge measures each source tree's final
    # arena bytes in pass 0 and re-parses in pass 1. Reserving that measured
    # size here removes the geometric doubling reallocs (the 268MB+134MB
    # ArenaArrayInt32Add transients observed on the kernel self-bake).
    if arenaReserveBytes > 0:
        arenamod.ArenaReserveCapacity(tree.arena, arenaReserveBytes)
    # [U0-cut] Pass 0 measured this source's per-column final lengths.  A
    # non-empty census is that measurement, applied before the first append
    # so every column owns its exact final block and `ArenaArrayInt32Add`
    # never takes its grow branch.  An empty census is byte-for-byte the
    # previous behaviour, and every caller other than the streaming
    # materialization pass passes one.
    if arenaColumnCensus.len > 0:
        if !ParserValueExprTreeArenaColumnCensusApply(
               tree, arenaColumnCensus, 0, err):
            return false
    tree.producerSourceCount = 1
    tree.migrationSourceSyntax = migrationSourceSyntax
    tree.failureSpanExact = false
    tree.failureStartByte = 0
    tree.failureEndByte = text.len
    tree.activeDeclarationLexicalScopeRow =
        ParserValueExprAppendDeclarationLexicalScope(
            tree,
            ParserDeclarationLexicalScopeSource,
            -1,
            -1)
    var sourceTextId: int32
    var tokenStart: int32
    var tokenCount: int32
    ParserDebugStage(Fmt"read_pre_lex arena_used={arenamod.ArenaUsed(tree.arena)}")
    if !ParserValueExprLexSource(tree,
                                  text,
                                  sourceTextId,
                                  tokenStart,
                                  tokenCount,
                                  err):
        let anchorKind = tree.failureSpanExact ?
            diagnostic_failure.DiagnosticFailureAnchorSpan :
            diagnostic_failure.DiagnosticFailureAnchorSource
        var failureErr: str
        if !diagnostic_failure.DiagnosticFailureArtifactSealParserLocalInto(
               text,
               0,
               anchorKind,
               -1,
               -1,
               tree.failureStartByte,
               tree.failureEndByte,
               err,
               tree.failureArtifact,
               failureErr):
            panic(failureErr)
        parserValueExprTreeSealDiagnosticFailure(tree)
        return false
    ParserValueExprSetDeclarationLexicalScopeSpanBytes(
        tree,
        tree.activeDeclarationLexicalScopeRow,
        0,
        Int32(text.len))
    # [S1b step-3 (9)] Module const table, complete before the first statement
    # or type syntax is produced: a `T[NAME]` length resolves the same way
    # whether NAME is declared above or below the use.
    ParserDebugStage(Fmt"read_post_lex arena_used={arenamod.ArenaUsed(tree.arena)}")
    if !parserTypeSyntaxModuleConstCollectInto(
           tree, tokenStart, tokenCount, err):
        var scanFailureErr: str
        if !diagnostic_failure.DiagnosticFailureArtifactSealParserLocalInto(
               text,
               0,
               diagnostic_failure.DiagnosticFailureAnchorSource,
               -1,
               -1,
               0,
               text.len,
               err,
               tree.failureArtifact,
               scanFailureErr):
            panic(scanFailureErr)
        parserValueExprTreeSealDiagnosticFailure(tree)
        return false
    if parserMemTraceEnabled:
        ParserDebugStage(Fmt"p0_parse_pre_produce src_index={parserMemTraceSourceIndex}")
    ParserDebugStage(Fmt"read_post_consts arena_used={arenamod.ArenaUsed(tree.arena)}")
    if !ParserValueExprProduceStatementEvents(tree,
                                               tokenStart,
                                               tokenCount,
                                               err):
        var failureErr: str
        if !diagnostic_failure.DiagnosticFailureArtifactSealParserLocalInto(
               text,
               0,
               diagnostic_failure.DiagnosticFailureAnchorSource,
               -1,
               -1,
               0,
               text.len,
               err,
               tree.failureArtifact,
               failureErr):
            panic(failureErr)
        parserValueExprTreeSealDiagnosticFailure(tree)
        return false
    if parserMemTraceEnabled:
        ParserDebugStage(Fmt"p0_parse_post_produce src_index={parserMemTraceSourceIndex}")
    if !migrationSourceSyntax && ParserStrictCallSyntaxEnabled():
        for eventIndex in 0..<tree.callEventCount:
            let nodeIndex = ParserValueExprCallEventNodeAt(
                tree, eventIndex)
            if ParserValueExprNodeKindAt(tree, nodeIndex) !=
               ParserValueExprSpaceCall:
                continue
            let spanStart = ParserValueExprNodeSpanStartAt(
                tree, nodeIndex)
            let spanEnd = ParserValueExprNodeSpanEndAt(
                tree, nodeIndex)
            if spanStart < 0 || spanEnd < spanStart ||
               spanEnd > text.len:
                panic("parser value expr: strict SpaceCall span unavailable")
            var lineNumber: int32
            var columnNumber: int32
            var endLineNumber: int32
            var endColumnNumber: int32
            if !ParserValueExprCallPosition(
                   tree,
                   nodeIndex,
                   lineNumber,
                   columnNumber,
                   endLineNumber,
                   endColumnNumber):
                panic("parser value expr: strict SpaceCall position unavailable")
            let callName = ParserValueExprNodeNameText(
                tree, nodeIndex)
            err = Fmt"Space call syntax is removed in the elegant syntax profile; use {callName}(...) at line {lineNumber}:{columnNumber}"
            var failureErr: str
            if !diagnostic_failure.DiagnosticFailureArtifactSealParserLocalInto(
                   text,
                   0,
                   diagnostic_failure.DiagnosticFailureAnchorParserNode,
                   nodeIndex,
                   -1,
                   spanStart,
                   spanEnd,
                   err,
                   tree.failureArtifact,
                   failureErr):
                panic(failureErr)
            parserValueExprTreeSealDiagnosticFailure(tree)
            return false
    ParserDebugStage(Fmt"read_post_produce arena_used={arenamod.ArenaUsed(tree.arena)} intern={langintern.InternPoolCount(tree.internPool)} payload={langintern.InternPoolLogicalPayloadBytes(tree.internPool)}")
    ParserProduceAttrDump()
    parserForwardingProductionsSeal(tree)
    if !ParserValueExprTreeTokensStrictValidateInto(tree, err) ||
       !ParserValueExprTreeTypeSyntaxBracketArgsStrictValidateInto(
           tree, err) ||
       !ParserValueExprTreeGenericSymbolsStrictValidateInto(tree, err) ||
       !ParserValueExprTreeEnumVariantsStrictValidateInto(tree, err) ||
       !ParserValueExprTreeNodeOriginsStrictValidateInto(tree, err) ||
       !ParserValueExprTreeImportOriginsStrictValidateInto(tree, err) ||
       !ParserValueExprTreeDeclarationsStrictValidateInto(tree, err) ||
       !ParserValueExprTreeStatementRootsStrictValidateInto(tree, err) ||
       !ParserValueExprTreeAnnotationsStrictValidateInto(tree, err) ||
       !ParserValueExprTreePatternsStrictValidateInto(tree, err) ||
       !ParserValueExprTreeForwardingProductionsStrictValidateInto(
           tree, err) ||
       !ParserValueExprTreeLexicalBindingsStrictValidateInto(tree, err):
        var failureErr: str
        if !diagnostic_failure.DiagnosticFailureArtifactSealParserLocalInto(
               text,
               0,
               diagnostic_failure.DiagnosticFailureAnchorSource,
               -1,
               -1,
               0,
               text.len,
               err,
               tree.failureArtifact,
               failureErr):
            panic(failureErr)
        parserValueExprTreeSealDiagnosticFailure(tree)
        return false
    tree.lexicalBindingAuthoritySealed = true
    tree.structuralValidationPassed = true
    # [slab-k1] 分段重放/对拍/度量诊断 (env CHENG_PARSER_SEGMENT_DIAG=1;
    # 缺省零行为)。仅成功路径; 负例判词由夹具级恒等覆盖。
    if ParserSegmentDiagEnabled():
        ParserSegmentDiagRunFromTree(tree, text)
    err = ""
    return true


# ==== [slab-k1] parser 分段机制 (SLAB_DESIGN §5 刀 1, 纯新增) ====
# 段界 = produce 环静息点 (分派臂前、块闭包判定后的观察位) + 注解携带规则。
# LexSourceRange: 字节域 + 绝对行列基, token 坐标保持整源绝对值。
# 分段重放/对拍/fresh-arena 段度量诊断入口供刀 2 度量道消费。缺省 (env
# CHENG_PARSER_SEGMENT_DIAG != "1") 全部零读零写, 旧入口调用点零改动。
var parserSegmentDiagGate: int32 = 0
var parserSegmentDiagBounds: int32[]
# 段重放期间挂起观察器: 段内 produce 不得复入主解析的静息点记录
# (复入会重置/改写正在迭代的 bounds — 首轮诊断实证)。
var parserSegmentDiagSuspend: bool = false
# 主流行 token 数 (produce 起点快照): tree.tokenCount 在 produce 后含 Fmt
# 插值子流行, 段计划必须用主流坐标 (末段截断 lex 实证)。
var parserSegmentDiagMainTokens: int32 = 0
# 对拍家族主树分区游标 (0 tokens/1 nodes/2 decls/3 typeSyntax/4 regions/
# 5 annotations/6 statementRoots/7 genericSymbols/8 enumVariants/9 scopes/
# 10 patterns/11 callEvents)。
var parserSegmentDiagBases: int32[]

fn ParserSegmentDiagEnabled(): bool =
    if parserSegmentDiagGate == 0:
        parserSegmentDiagGate =
            os.GetEnv("CHENG_PARSER_SEGMENT_DIAG") == "1" ? 2 : 1
    return parserSegmentDiagGate == 2

# 静息点判据: 无开启块 (type/routine/binding) 且注解组闭合——`@` 行在
# pendingAnnotationCount == 0 时开启新组; 携带注解的目标声明行
# (boundAnnotationStart >= 0) 属于本组, 不是新段界 (SLAB_DESIGN §3.1)。
@borrows
fn ParserSegmentDiagObserveBoundary(tree: ParserValueExprTree,
                                    tokenStart: int32,
                                    cursor: int32,
                                    typeBlockColumn: int32,
                                    routineBlockColumn: int32,
                                    bindingBlockColumn: int32,
                                    boundAnnotationStart: int32,
                                    pendingAnnotationCount: int32,
                                    firstKind: ParserValueTokenKind) =
    if parserSegmentDiagSuspend:
        return
    if cursor == tokenStart:
        parserSegmentDiagBounds = []
        parserSegmentDiagMainTokens = tree.tokenCount
    if typeBlockColumn >= 0 || routineBlockColumn >= 0 ||
       bindingBlockColumn >= 0:
        return
    var fresh = false
    if firstKind == ParserValueTokenAt:
        fresh = pendingAnnotationCount == 0
    else:
        fresh = boundAnnotationStart < 0 && pendingAnnotationCount == 0
    if fresh:
        add(parserSegmentDiagBounds, cursor)

# 分段 lex: 整源文本 + 段字节域 + 绝对行列基。intern/sourceTextLengths 列
# 与 LexSource 同源语义 (整源长度), token 字节偏移保持整源绝对坐标。
@borrows
fn ParserValueExprLexSourceRange(tree: var ParserValueExprTree,
                                 source: str,
                                 spanStart: int32,
                                 spanLimit: int32,
                                 initialLineNumber: int32,
                                 initialColumnNumber: int32,
                                 tokenStartOut: var int32,
                                 tokenCountOut: var int32,
                                 err: var str): bool =
    ParserValueExprTreeEnsureActive(tree)
    let sourceTextId = langintern.Intern(tree.internPool,
                                         strings.CloneStr(source))
    if sourceTextId < 0 ||
       sourceTextId != arenamod.ArenaArrayInt32Len(
           tree.arena, tree.sourceTextLengths):
        panic("parser value expr: range lex source length column out of lockstep")
    arenamod.ArenaArrayInt32Add(tree.arena,
                                 tree.sourceTextLengths,
                                 source.len)
    return ParserValueExprLexSpan(tree,
                                  source,
                                  sourceTextId,
                                  spanStart,
                                  spanLimit,
                                  initialLineNumber,
                                  initialColumnNumber,
                                  -1,
                                  false,
                                  tokenStartOut,
                                  tokenCountOut,
                                  err)

# 段级重放: fresh arena (零 reserve 零 census = fresh-arena 段度量模式,
# 与 pass-0 度量同口径), lex 字节域 → module const 收集+主表播种 →
# produce 段 token → forwarding seal → 12 项 strict validate。
# 源级 header (module const 表) 按「主表名文本 → 段内同名 token」播种,
# 值/旗标逐项等于主表; 冲突由 register 既有 panic 守卫暴露。
@borrows
fn ParserSegmentDiagParseSegment(tree: ParserValueExprTree,
                                 text: str,
                                 byteStart: int32,
                                 byteLimit: int32,
                                 initialLine: int32,
                                 initialColumn: int32,
                                 segTreeOut: var ParserValueExprTree,
                                 err: var str): bool =
    var segTree: ParserValueExprTree
    ParserValueExprTreeEnsureActive(segTree)
    segTree.producerSourceCount = 1
    segTree.migrationSourceSyntax = tree.migrationSourceSyntax
    segTree.failureSpanExact = false
    segTree.failureStartByte = 0
    segTree.failureEndByte = text.len
    segTree.activeDeclarationLexicalScopeRow =
        ParserValueExprAppendDeclarationLexicalScope(
            segTree,
            ParserDeclarationLexicalScopeSource,
            -1,
            -1)
    var segTokenStart: int32
    var segTokenCount: int32
    if !ParserValueExprLexSourceRange(segTree,
                                      text,
                                      byteStart,
                                      byteLimit,
                                      initialLine,
                                      initialColumn,
                                      segTokenStart,
                                      segTokenCount,
                                      err):
        segTreeOut = segTree
        return false
    ParserValueExprSetDeclarationLexicalScopeSpanBytes(
        segTree,
        segTree.activeDeclarationLexicalScopeRow,
        0,
        Int32(text.len))
    if !parserTypeSyntaxModuleConstCollectInto(
           segTree, segTokenStart, segTokenCount, err):
        segTreeOut = segTree
        return false
    var constRow: int32
    while constRow < arenamod.ArenaArrayInt32Len(
            tree.arena, tree.typeConstModuleNameTokens):
        let mainNameToken = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeConstModuleNameTokens, constRow)
        let mainNameText = ParserValueExprTokenText(tree, mainNameToken)
        let mainInt32Flag = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeConstModuleInt32Flags, constRow) != 0
        let mainValue = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.typeConstModuleValues, constRow)
        var seedToken: int32 = -1
        var scan: int32
        while scan < segTokenCount:
            if ParserValueExprTokenTextEqualsText(segTree,
                                                  scan,
                                                  mainNameText):
                seedToken = scan
                break
            scan = scan + 1
        if seedToken >= 0:
            if !parserTypeSyntaxModuleConstRegister(segTree,
                                                    seedToken,
                                                    mainInt32Flag,
                                                    mainValue,
                                                    err):
                segTreeOut = segTree
                return false
        constRow = constRow + 1
    if !ParserValueExprProduceStatementEvents(segTree,
                                              segTokenStart,
                                              segTokenCount,
                                              err):
        segTreeOut = segTree
        return false
    parserForwardingProductionsSeal(segTree)
    # 段级 12 项 strict validate (与入口同链; SpaceCall 表面检查属入口
    # 判词级, 由整源解析承担, 段重放不重复)。
    if !ParserValueExprTreeTokensStrictValidateInto(segTree, err) ||
       !ParserValueExprTreeTypeSyntaxBracketArgsStrictValidateInto(
           segTree, err) ||
       !ParserValueExprTreeGenericSymbolsStrictValidateInto(segTree, err) ||
       !ParserValueExprTreeEnumVariantsStrictValidateInto(segTree, err) ||
       !ParserValueExprTreeNodeOriginsStrictValidateInto(segTree, err) ||
       !ParserValueExprTreeImportOriginsStrictValidateInto(segTree, err) ||
       !ParserValueExprTreeDeclarationsStrictValidateInto(segTree, err) ||
       !ParserValueExprTreeStatementRootsStrictValidateInto(segTree, err) ||
       !ParserValueExprTreeAnnotationsStrictValidateInto(segTree, err) ||
       !ParserValueExprTreePatternsStrictValidateInto(segTree, err) ||
       !ParserValueExprTreeForwardingProductionsStrictValidateInto(
           segTree, err) ||
       !ParserValueExprTreeLexicalBindingsStrictValidateInto(segTree, err):
        segTreeOut = segTree
        return false
    segTree.lexicalBindingAuthoritySealed = true
    segTree.structuralValidationPassed = true
    segTreeOut = segTree
    err = ""
    return true

fn ParserSegmentDiagNoteMismatch(segIndex: int32,
                                 family: int32,
                                 row: int32,
                                 colName: str,
                                 mainVal: int32,
                                 segVal: int32,
                                 mismatches: var int32) =
    if mismatches < 16:
        os.WriteLine(os.Get_stderr(),
                     Fmt"segment_diag_mismatch src={parserMemTraceSourceIndex} seg={segIndex} family={family} row={row} col={colName} main={mainVal} seg={segVal}")
    mismatches = mismatches + 1

# 段 vs 整源切片对拍: 家族行分区恒等 (P3)。比较列全部为绝对坐标
# (kind/span/line/col/role) 或家族内归一引用 (callEvent node 索引)。
# 排除列与理由: token/node/decl 树局部身份索引列 (sourceId/local/parent,
# 分区+计数恒等可推导); nodeLexicalScopeRows 与 binding 解析列
# (append 零消费, 跨段解析差异为设计内 §3.3 源级 header 项);
# typeConstExpr (主表 pre-produce 收集, 不随段分区)。
@borrows
fn ParserSegmentDiagCompareSegment(mainTree: ParserValueExprTree,
                                   segTree: ParserValueExprTree,
                                   segStart: int32,
                                   segLimit: int32,
                                   segIndex: int32,
                                   mismatches: var int32) =
    let segTokCount = segLimit - segStart
    os.WriteLine(os.Get_stderr(), Fmt"segment_diag_family src={parserMemTraceSourceIndex} seg={segIndex} family=0 tokens={segTokCount} segStart={segStart} segLimit={segLimit} bases0={parserSegmentDiagBases[0]} mainTokLen={arenamod.ArenaArrayInt32Len(mainTree.arena, mainTree.tokenKinds)} segTokLen={arenamod.ArenaArrayInt32Len(segTree.arena, segTree.tokenKinds)}")
    var i: int32
    # family 0: tokens (lex 期行; 段树尾部为 produce 追加的插值子流行)
    while i < segTokCount:
        let m = parserSegmentDiagBases[0] + i
        if i >= arenamod.ArenaArrayInt32Len(segTree.arena, segTree.tokenKinds):
            ParserSegmentDiagNoteMismatch(segIndex, 0, i, "segcol_tokenKinds",
                arenamod.ArenaArrayInt32Len(segTree.arena, segTree.tokenKinds),
                i, mismatches)
            break
        if m >= arenamod.ArenaArrayInt32Len(mainTree.arena, mainTree.tokenKinds):
            ParserSegmentDiagNoteMismatch(segIndex, 0, i, "partition_tokens",
                arenamod.ArenaArrayInt32Len(mainTree.arena, mainTree.tokenKinds), m, mismatches)
            break
        if arenamod.ArenaArrayInt32Get(mainTree.arena,
                                       mainTree.tokenKinds, m) !=
           arenamod.ArenaArrayInt32Get(segTree.arena,
                                       segTree.tokenKinds, i):
            ParserSegmentDiagNoteMismatch(segIndex, 0, i, "tokenKinds",
                arenamod.ArenaArrayInt32Get(mainTree.arena,
                                            mainTree.tokenKinds, m),
                arenamod.ArenaArrayInt32Get(segTree.arena,
                                            segTree.tokenKinds, i),
                mismatches)
        if arenamod.ArenaArrayInt32Get(mainTree.arena,
                                       mainTree.tokenStarts, m) !=
           arenamod.ArenaArrayInt32Get(segTree.arena,
                                       segTree.tokenStarts, i):
            ParserSegmentDiagNoteMismatch(segIndex, 0, i, "tokenStarts",
                arenamod.ArenaArrayInt32Get(mainTree.arena,
                                            mainTree.tokenStarts, m),
                arenamod.ArenaArrayInt32Get(segTree.arena,
                                            segTree.tokenStarts, i),
                mismatches)
        if arenamod.ArenaArrayInt32Get(mainTree.arena,
                                       mainTree.tokenEnds, m) !=
           arenamod.ArenaArrayInt32Get(segTree.arena,
                                       segTree.tokenEnds, i):
            ParserSegmentDiagNoteMismatch(segIndex, 0, i, "tokenEnds",
                arenamod.ArenaArrayInt32Get(mainTree.arena,
                                            mainTree.tokenEnds, m),
                arenamod.ArenaArrayInt32Get(segTree.arena,
                                            segTree.tokenEnds, i),
                mismatches)
        if arenamod.ArenaArrayInt32Get(mainTree.arena,
                                       mainTree.tokenLineNumbers, m) !=
           arenamod.ArenaArrayInt32Get(segTree.arena,
                                       segTree.tokenLineNumbers, i):
            ParserSegmentDiagNoteMismatch(segIndex, 0, i,
                "tokenLineNumbers",
                arenamod.ArenaArrayInt32Get(mainTree.arena,
                                            mainTree.tokenLineNumbers, m),
                arenamod.ArenaArrayInt32Get(segTree.arena,
                                            segTree.tokenLineNumbers, i),
                mismatches)
        if arenamod.ArenaArrayInt32Get(mainTree.arena,
                                       mainTree.tokenColumnNumbers, m) !=
           arenamod.ArenaArrayInt32Get(segTree.arena,
                                       segTree.tokenColumnNumbers, i):
            ParserSegmentDiagNoteMismatch(segIndex, 0, i,
                "tokenColumnNumbers",
                arenamod.ArenaArrayInt32Get(mainTree.arena,
                                            mainTree.tokenColumnNumbers, m),
                arenamod.ArenaArrayInt32Get(segTree.arena,
                                            segTree.tokenColumnNumbers, i),
                mismatches)
        i = i + 1
    parserSegmentDiagBases[0] = parserSegmentDiagBases[0] + segTokCount
    # family 1: nodes (kind + 绝对 span)
    let segNodeCount = segTree.nodeCount
    os.WriteLine(os.Get_stderr(), Fmt"segment_diag_family src={parserMemTraceSourceIndex} seg={segIndex} family=1 nodes={segTree.nodeCount}")
    i = 0
    while i < segNodeCount:
        let m = parserSegmentDiagBases[1] + i
        if i >= arenamod.ArenaArrayInt32Len(segTree.arena, segTree.kinds):
            ParserSegmentDiagNoteMismatch(segIndex, 1, i, "segcol_kinds",
                arenamod.ArenaArrayInt32Len(segTree.arena, segTree.kinds),
                i, mismatches)
            break
        if m >= mainTree.nodeCount:
            ParserSegmentDiagNoteMismatch(segIndex, 1, i, "partition_nodes",
                mainTree.nodeCount, m, mismatches)
            break
        if arenamod.ArenaArrayInt32Get(mainTree.arena, mainTree.kinds, m) !=
           arenamod.ArenaArrayInt32Get(segTree.arena, segTree.kinds, i):
            ParserSegmentDiagNoteMismatch(segIndex, 1, i, "nodeKinds",
                arenamod.ArenaArrayInt32Get(mainTree.arena,
                                            mainTree.kinds, m),
                arenamod.ArenaArrayInt32Get(segTree.arena,
                                            segTree.kinds, i),
                mismatches)
        if arenamod.ArenaArrayInt32Get(mainTree.arena,
                                       mainTree.spanStarts, m) !=
           arenamod.ArenaArrayInt32Get(segTree.arena,
                                       segTree.spanStarts, i):
            ParserSegmentDiagNoteMismatch(segIndex, 1, i, "nodeSpanStarts",
                arenamod.ArenaArrayInt32Get(mainTree.arena,
                                            mainTree.spanStarts, m),
                arenamod.ArenaArrayInt32Get(segTree.arena,
                                            segTree.spanStarts, i),
                mismatches)
        if arenamod.ArenaArrayInt32Get(mainTree.arena,
                                       mainTree.spanEnds, m) !=
           arenamod.ArenaArrayInt32Get(segTree.arena,
                                       segTree.spanEnds, i):
            ParserSegmentDiagNoteMismatch(segIndex, 1, i, "nodeSpanEnds",
                arenamod.ArenaArrayInt32Get(mainTree.arena,
                                            mainTree.spanEnds, m),
                arenamod.ArenaArrayInt32Get(segTree.arena,
                                            segTree.spanEnds, i),
                mismatches)
        i = i + 1
    parserSegmentDiagBases[1] = parserSegmentDiagBases[1] + segNodeCount
    # family 2: declarations (kind + span + name token 字节)
    let segDeclCount = segTree.declarationCount
    os.WriteLine(os.Get_stderr(), Fmt"segment_diag_family src={parserMemTraceSourceIndex} seg={segIndex} family=2 decls={segTree.declarationCount}")
    i = 0
    while i < segDeclCount:
        let m = parserSegmentDiagBases[2] + i
        if i >= arenamod.ArenaArrayInt32Len(segTree.arena, segTree.declarationKinds):
            ParserSegmentDiagNoteMismatch(segIndex, 2, i, "segcol_declarationKinds",
                arenamod.ArenaArrayInt32Len(segTree.arena, segTree.declarationKinds),
                i, mismatches)
            break
        if m >= mainTree.declarationCount:
            ParserSegmentDiagNoteMismatch(segIndex, 2, i, "partition_decls",
                mainTree.declarationCount, m, mismatches)
            break
        if arenamod.ArenaArrayInt32Get(mainTree.arena,
                                       mainTree.declarationKinds, m) !=
           arenamod.ArenaArrayInt32Get(segTree.arena,
                                       segTree.declarationKinds, i):
            ParserSegmentDiagNoteMismatch(segIndex, 2, i, "declKinds",
                arenamod.ArenaArrayInt32Get(mainTree.arena,
                                            mainTree.declarationKinds, m),
                arenamod.ArenaArrayInt32Get(segTree.arena,
                                            segTree.declarationKinds, i),
                mismatches)
        let mainName = arenamod.ArenaArrayInt32Get(
            mainTree.arena, mainTree.declarationNameTokenIndexes, m)
        let segName = arenamod.ArenaArrayInt32Get(
            segTree.arena, segTree.declarationNameTokenIndexes, i)
        if mainName - segStart != segName:
            ParserSegmentDiagNoteMismatch(segIndex, 2, i,
                "declNameRef",
                mainName - segStart, segName, mismatches)
        i = i + 1
    parserSegmentDiagBases[2] = parserSegmentDiagBases[2] + segDeclCount
    # family 3: typeSyntax (kind + span)
    let segSynCount = segTree.typeSyntaxCount
    os.WriteLine(os.Get_stderr(), Fmt"segment_diag_family src={parserMemTraceSourceIndex} seg={segIndex} family=3 typeSyntax={segTree.typeSyntaxCount}")
    i = 0
    while i < segSynCount:
        let m = parserSegmentDiagBases[3] + i
        if i >= arenamod.ArenaArrayInt32Len(segTree.arena, segTree.typeSyntaxKinds):
            ParserSegmentDiagNoteMismatch(segIndex, 3, i, "segcol_typeSyntaxKinds",
                arenamod.ArenaArrayInt32Len(segTree.arena, segTree.typeSyntaxKinds),
                i, mismatches)
            break
        if m >= mainTree.typeSyntaxCount:
            ParserSegmentDiagNoteMismatch(segIndex, 3, i, "partition_typeSyntax",
                mainTree.typeSyntaxCount, m, mismatches)
            break
        if arenamod.ArenaArrayInt32Get(mainTree.arena,
                                       mainTree.typeSyntaxKinds, m) !=
           arenamod.ArenaArrayInt32Get(segTree.arena,
                                       segTree.typeSyntaxKinds, i):
            ParserSegmentDiagNoteMismatch(segIndex, 3, i, "synKinds",
                arenamod.ArenaArrayInt32Get(mainTree.arena,
                                            mainTree.typeSyntaxKinds, m),
                arenamod.ArenaArrayInt32Get(segTree.arena,
                                            segTree.typeSyntaxKinds, i),
                mismatches)
        if arenamod.ArenaArrayInt32Get(mainTree.arena,
                                       mainTree.typeSyntaxSpanStarts, m) !=
           arenamod.ArenaArrayInt32Get(segTree.arena,
                                       segTree.typeSyntaxSpanStarts, i):
            ParserSegmentDiagNoteMismatch(segIndex, 3, i, "synSpanStarts",
                arenamod.ArenaArrayInt32Get(
                    mainTree.arena, mainTree.typeSyntaxSpanStarts, m),
                arenamod.ArenaArrayInt32Get(
                    segTree.arena, segTree.typeSyntaxSpanStarts, i),
                mismatches)
        i = i + 1
    parserSegmentDiagBases[3] = parserSegmentDiagBases[3] + segSynCount
    # family 4: regions (kind + span)
    let segRegionCount = segTree.regionCount
    os.WriteLine(os.Get_stderr(), Fmt"segment_diag_family src={parserMemTraceSourceIndex} seg={segIndex} family=4 regions={segTree.regionCount}")
    i = 0
    while i < segRegionCount:
        let m = parserSegmentDiagBases[4] + i
        if i >= arenamod.ArenaArrayInt32Len(segTree.arena, segTree.regionKinds):
            ParserSegmentDiagNoteMismatch(segIndex, 4, i, "segcol_regionKinds",
                arenamod.ArenaArrayInt32Len(segTree.arena, segTree.regionKinds),
                i, mismatches)
            break
        if m >= mainTree.regionCount:
            ParserSegmentDiagNoteMismatch(segIndex, 4, i, "partition_regions",
                mainTree.regionCount, m, mismatches)
            break
        if arenamod.ArenaArrayInt32Get(mainTree.arena,
                                       mainTree.regionKinds, m) !=
           arenamod.ArenaArrayInt32Get(segTree.arena,
                                       segTree.regionKinds, i):
            ParserSegmentDiagNoteMismatch(segIndex, 4, i, "regionKinds",
                arenamod.ArenaArrayInt32Get(mainTree.arena,
                                            mainTree.regionKinds, m),
                arenamod.ArenaArrayInt32Get(segTree.arena,
                                            segTree.regionKinds, i),
                mismatches)
        if arenamod.ArenaArrayInt32Get(mainTree.arena,
                                       mainTree.regionSpanStarts, m) !=
           arenamod.ArenaArrayInt32Get(segTree.arena,
                                       segTree.regionSpanStarts, i):
            ParserSegmentDiagNoteMismatch(segIndex, 4, i, "regionSpans",
                arenamod.ArenaArrayInt32Get(mainTree.arena,
                                            mainTree.regionSpanStarts, m),
                arenamod.ArenaArrayInt32Get(segTree.arena,
                                            segTree.regionSpanStarts, i),
                mismatches)
        i = i + 1
    parserSegmentDiagBases[4] = parserSegmentDiagBases[4] + segRegionCount
    # family 5: annotations (name/target token 字节)
    let segAnnCount = segTree.annotationCount
    os.WriteLine(os.Get_stderr(), Fmt"segment_diag_family src={parserMemTraceSourceIndex} seg={segIndex} family=5 annotations={segTree.annotationCount}")
    i = 0
    while i < segAnnCount:
        let m = parserSegmentDiagBases[5] + i
        if i >= arenamod.ArenaArrayInt32Len(segTree.arena, segTree.annotationNameTokenIndexes):
            ParserSegmentDiagNoteMismatch(segIndex, 5, i, "segcol_annotationNameTokenIndexes",
                arenamod.ArenaArrayInt32Len(segTree.arena, segTree.annotationNameTokenIndexes),
                i, mismatches)
            break
        if m >= mainTree.annotationCount:
            ParserSegmentDiagNoteMismatch(segIndex, 5, i, "partition_annotations",
                mainTree.annotationCount, m, mismatches)
            break
        let mainName = arenamod.ArenaArrayInt32Get(
            mainTree.arena, mainTree.annotationNameTokenIndexes, m)
        let segName = arenamod.ArenaArrayInt32Get(
            segTree.arena, segTree.annotationNameTokenIndexes, i)
        if mainName - segStart != segName:
            ParserSegmentDiagNoteMismatch(segIndex, 5, i, "annNameRef",
                mainName - segStart, segName, mismatches)
        let mainTarget = arenamod.ArenaArrayInt32Get(
            mainTree.arena, mainTree.annotationTargetTokenIndexes, m)
        let segTarget = arenamod.ArenaArrayInt32Get(
            segTree.arena, segTree.annotationTargetTokenIndexes, i)
        if mainTarget - segStart != segTarget:
            ParserSegmentDiagNoteMismatch(segIndex, 5, i, "annTargetRef",
                mainTarget - segStart, segTarget, mismatches)
        i = i + 1
    parserSegmentDiagBases[5] = parserSegmentDiagBases[5] + segAnnCount
    # family 6: statementRoots (role + anchor token 字节)
    let segRootCount = segTree.statementRootCount
    os.WriteLine(os.Get_stderr(), Fmt"segment_diag_family src={parserMemTraceSourceIndex} seg={segIndex} family=6 statementRoots={segTree.statementRootCount}")
    i = 0
    while i < segRootCount:
        let m = parserSegmentDiagBases[6] + i
        if i >= arenamod.ArenaArrayInt32Len(segTree.arena, segTree.statementRootRoles):
            ParserSegmentDiagNoteMismatch(segIndex, 6, i, "segcol_statementRootRoles",
                arenamod.ArenaArrayInt32Len(segTree.arena, segTree.statementRootRoles),
                i, mismatches)
            break
        if m >= mainTree.statementRootCount:
            ParserSegmentDiagNoteMismatch(segIndex, 6, i, "partition_statementRoots",
                mainTree.statementRootCount, m, mismatches)
            break
        if arenamod.ArenaArrayInt32Get(mainTree.arena,
                                       mainTree.statementRootRoles, m) !=
           arenamod.ArenaArrayInt32Get(segTree.arena,
                                       segTree.statementRootRoles, i):
            ParserSegmentDiagNoteMismatch(segIndex, 6, i, "rootRoles",
                arenamod.ArenaArrayInt32Get(mainTree.arena,
                                            mainTree.statementRootRoles, m),
                arenamod.ArenaArrayInt32Get(segTree.arena,
                                            segTree.statementRootRoles, i),
                mismatches)
        let mainAnchor = arenamod.ArenaArrayInt32Get(
            mainTree.arena, mainTree.statementRootAnchorTokenIndexes, m)
        let segAnchor = arenamod.ArenaArrayInt32Get(
            segTree.arena, segTree.statementRootAnchorTokenIndexes, i)
        if mainAnchor - segStart != segAnchor:
            ParserSegmentDiagNoteMismatch(segIndex, 6, i, "rootAnchorRef",
                mainAnchor - segStart, segAnchor, mismatches)
        i = i + 1
    parserSegmentDiagBases[6] = parserSegmentDiagBases[6] + segRootCount
    # family 7: genericSymbols (span)
    let segGenericCount = segTree.typeGenericSymbolCount
    os.WriteLine(os.Get_stderr(), Fmt"segment_diag_family src={parserMemTraceSourceIndex} seg={segIndex} family=7 genericSymbols={segTree.typeGenericSymbolCount}")
    i = 0
    while i < segGenericCount:
        let m = parserSegmentDiagBases[7] + i
        if i >= arenamod.ArenaArrayInt32Len(segTree.arena, segTree.typeGenericSymbolSpanStarts):
            ParserSegmentDiagNoteMismatch(segIndex, 7, i, "segcol_typeGenericSymbolSpanStarts",
                arenamod.ArenaArrayInt32Len(segTree.arena, segTree.typeGenericSymbolSpanStarts),
                i, mismatches)
            break
        if m >= mainTree.typeGenericSymbolCount:
            ParserSegmentDiagNoteMismatch(segIndex, 7, i, "partition_genericSymbols",
                mainTree.typeGenericSymbolCount, m, mismatches)
            break
        if arenamod.ArenaArrayInt32Get(
               mainTree.arena, mainTree.typeGenericSymbolSpanStarts, m) !=
           arenamod.ArenaArrayInt32Get(
               segTree.arena, segTree.typeGenericSymbolSpanStarts, i):
            ParserSegmentDiagNoteMismatch(segIndex, 7, i, "genericSpans",
                arenamod.ArenaArrayInt32Get(
                    mainTree.arena,
                    mainTree.typeGenericSymbolSpanStarts, m),
                arenamod.ArenaArrayInt32Get(
                    segTree.arena,
                    segTree.typeGenericSymbolSpanStarts, i),
                mismatches)
        i = i + 1
    parserSegmentDiagBases[7] = parserSegmentDiagBases[7] + segGenericCount
    # family 8: enumVariants (name token 字节)
    let segEnumCount = segTree.typeEnumVariantCount
    os.WriteLine(os.Get_stderr(), Fmt"segment_diag_family src={parserMemTraceSourceIndex} seg={segIndex} family=8 enumVariants={segTree.typeEnumVariantCount}")
    i = 0
    while i < segEnumCount:
        let m = parserSegmentDiagBases[8] + i
        if i >= arenamod.ArenaArrayInt32Len(segTree.arena, segTree.typeEnumVariantNameTokenIndexes):
            ParserSegmentDiagNoteMismatch(segIndex, 8, i, "segcol_typeEnumVariantNameTokenIndexes",
                arenamod.ArenaArrayInt32Len(segTree.arena, segTree.typeEnumVariantNameTokenIndexes),
                i, mismatches)
            break
        if m >= mainTree.typeEnumVariantCount:
            ParserSegmentDiagNoteMismatch(segIndex, 8, i, "partition_enumVariants",
                mainTree.typeEnumVariantCount, m, mismatches)
            break
        let mainName = arenamod.ArenaArrayInt32Get(
            mainTree.arena, mainTree.typeEnumVariantNameTokenIndexes, m)
        let segName = arenamod.ArenaArrayInt32Get(
            segTree.arena, segTree.typeEnumVariantNameTokenIndexes, i)
        if mainName - segStart != segName:
            ParserSegmentDiagNoteMismatch(segIndex, 8, i, "enumNameRef",
                mainName - segStart, segName, mismatches)
        i = i + 1
    parserSegmentDiagBases[8] = parserSegmentDiagBases[8] + segEnumCount
    # family 9: lexical scopes (kind; 主树 row 0 = 源作用域, 不入分区)
    let segScopeCount = segTree.declarationLexicalScopeCount - 1
    os.WriteLine(os.Get_stderr(), Fmt"segment_diag_family src={parserMemTraceSourceIndex} seg={segIndex} family=9 scopes={segTree.declarationLexicalScopeCount}")
    i = 0
    while i < segScopeCount:
        let m = parserSegmentDiagBases[9] + i
        if i + 1 >= arenamod.ArenaArrayInt32Len(
               segTree.arena, segTree.declarationLexicalScopeKinds):
            ParserSegmentDiagNoteMismatch(segIndex, 9, i, "segcol_scopes",
                arenamod.ArenaArrayInt32Len(
                    segTree.arena, segTree.declarationLexicalScopeKinds),
                i + 1, mismatches)
            break
        if m >= mainTree.declarationLexicalScopeCount:
            ParserSegmentDiagNoteMismatch(segIndex, 9, i, "partition_scopes",
                mainTree.declarationLexicalScopeCount, m, mismatches)
            break
        if arenamod.ArenaArrayInt32Get(
               mainTree.arena, mainTree.declarationLexicalScopeKinds,
               m) !=
           arenamod.ArenaArrayInt32Get(
               segTree.arena, segTree.declarationLexicalScopeKinds, i + 1):
            ParserSegmentDiagNoteMismatch(segIndex, 9, i, "scopeKinds",
                arenamod.ArenaArrayInt32Get(
                    mainTree.arena,
                    mainTree.declarationLexicalScopeKinds, m),
                arenamod.ArenaArrayInt32Get(
                    segTree.arena,
                    segTree.declarationLexicalScopeKinds, i + 1),
                mismatches)
        i = i + 1
    parserSegmentDiagBases[9] = parserSegmentDiagBases[9] + segScopeCount
    # family 10: patterns (count)
    parserSegmentDiagBases[10] = parserSegmentDiagBases[10] + segTree.patternCount
    # family 11: callEvents (node 索引家族内归一)
    let segCallCount = segTree.callEventCount
    os.WriteLine(os.Get_stderr(), Fmt"segment_diag_family src={parserMemTraceSourceIndex} seg={segIndex} family=11 callEvents={segTree.callEventCount}")
    i = 0
    while i < segCallCount:
        let m = parserSegmentDiagBases[11] + i
        if i >= arenamod.ArenaArrayInt32Len(segTree.arena, segTree.callEventNodeIndexes):
            ParserSegmentDiagNoteMismatch(segIndex, 11, i, "segcol_callEventNodeIndexes",
                arenamod.ArenaArrayInt32Len(segTree.arena, segTree.callEventNodeIndexes),
                i, mismatches)
            break
        if m >= mainTree.callEventCount:
            ParserSegmentDiagNoteMismatch(segIndex, 11, i, "partition_callEvents",
                mainTree.callEventCount, m, mismatches)
            break
        let mainNode = arenamod.ArenaArrayInt32Get(
            mainTree.arena, mainTree.callEventNodeIndexes, m)
        let segNode = arenamod.ArenaArrayInt32Get(
            segTree.arena, segTree.callEventNodeIndexes, i)
        if mainNode - parserSegmentDiagBases[1] + segNodeCount != segNode:
            ParserSegmentDiagNoteMismatch(segIndex, 11, i, "callNodes",
                mainNode, segNode + parserSegmentDiagBases[1] - segNodeCount,
                mismatches)
        i = i + 1
    parserSegmentDiagBases[11] = parserSegmentDiagBases[11] + segCallCount

# 分段重放/对拍/度量主入口: 静息点记录 (produce 观察位) 驱动, 逐段
# fresh-arena 重放 + 家族分区对拍 + 段度量读数 (字节/token/arena)。
# 读数只写 stderr (env 门内), 主树零改动。
@borrows
fn ParserSegmentDiagRunFromTree(tree: ParserValueExprTree, text: str) =
    if tree == nil || tree.tokenCount <= 0:
        return
    if parserSegmentDiagBounds.len <= 0 || parserSegmentDiagBounds[0] != 0:
        os.WriteLine(os.Get_stderr(),
                     Fmt"segment_diag_skip src={parserMemTraceSourceIndex} bounds={parserSegmentDiagBounds.len}")
        return
    parserSegmentDiagBases = []
    var family: int32
    while family < 12:
        add(parserSegmentDiagBases, 0)
        family = family + 1
    parserSegmentDiagBases[9] = 1
    var mismatchTotal: int32
    var maxSegBytes: int32 = 0
    var maxSegArena: int32 = 0
    var sumSegArena: int64 = 0
    let tokenTotal = parserSegmentDiagMainTokens
    if tokenTotal <= 0 || tokenTotal > tree.tokenCount:
        os.WriteLine(os.Get_stderr(),
                     Fmt"segment_diag_skip src={parserMemTraceSourceIndex} main_tokens={tokenTotal}")
        return
    # 快照段界计划: 观察器在段重放期已挂起, 快照进一步消除与全局的别名耦合。
    var planBounds: int32[]
    var planIndex: int32
    while planIndex < parserSegmentDiagBounds.len:
        add(planBounds, parserSegmentDiagBounds[planIndex])
        planIndex = planIndex + 1
    var segIndex: int32
    while segIndex < planBounds.len:
        let segStart = planBounds[segIndex]
        var segLimit: int32 = tokenTotal
        if segIndex + 1 < planBounds.len:
            segLimit = planBounds[segIndex + 1]
        let byteStart = ParserValueExprTokenStartAt(tree, segStart)
        var byteLimit: int32 = Int32(text.len)
        if segLimit < tokenTotal:
            byteLimit = ParserValueExprTokenStartAt(tree, segLimit)
        let lineAt = ParserValueExprTokenLineAt(tree, segStart)
        let colAt = ParserValueExprTokenColumnAt(tree, segStart)
        var segTree: ParserValueExprTree
        var segErr: str = ""
        parserSegmentDiagSuspend = true
        var segOk = ParserSegmentDiagParseSegment(tree,
                                                  text,
                                                  byteStart,
                                                  byteLimit,
                                                  lineAt,
                                                  colAt,
                                                  segTree,
                                                  segErr)
        parserSegmentDiagSuspend = false
        if !segOk:
            mismatchTotal = mismatchTotal + 1
            os.WriteLine(os.Get_stderr(),
                         Fmt"segment_diag_parse_fail src={parserMemTraceSourceIndex} seg={segIndex} bytes={byteLimit - byteStart} err={segErr}")
        else:
            var mismatches: int32
            ParserSegmentDiagCompareSegment(tree,
                                            segTree,
                                            segStart,
                                            segLimit,
                                            segIndex,
                                            mismatches)
            mismatchTotal = mismatchTotal + mismatches
            let segBytes = byteLimit - byteStart
            let segArena = arenamod.ArenaUsed(segTree.arena)
            if segBytes > maxSegBytes:
                maxSegBytes = segBytes
            if segArena > maxSegArena:
                maxSegArena = segArena
            sumSegArena = sumSegArena + Int64(segArena)
            os.WriteLine(os.Get_stderr(),
                         Fmt"segment_diag_seg src={parserMemTraceSourceIndex} seg={segIndex} tokens={segLimit - segStart} bytes={segBytes} arena={segArena} mismatches={mismatches}")
        if segTree != nil:
            ParserValueExprTreeRelease(segTree)
        segIndex = segIndex + 1
    os.WriteLine(os.Get_stderr(),
                 Fmt"segment_diag_src src={parserMemTraceSourceIndex} tokens={tokenTotal} segments={planBounds.len} max_seg_bytes={maxSegBytes} max_seg_arena={maxSegArena} sum_seg_arena={sumSegArena} mismatches={mismatchTotal}")

@borrows
fn ParserValueExprReadTreeFromText(text: str,
                                     tree: var ParserValueExprTree,
                                     err: var str): bool =
    var noColumnCensus: int32[]
    return parserValueExprReadTreeFromTextMode(
        text, false, 0, noColumnCensus, tree, err)

@borrows
fn ParserValueExprReadMigrationSourceTreeFromText(
        text: str,
        tree: var ParserValueExprTree,
        err: var str): bool =
    var noColumnCensus: int32[]
    return parserValueExprReadTreeFromTextMode(
        text, true, 0, noColumnCensus, tree, err)

@borrows
fn ParserValueExprReadTreeFromTextReserved(
        text: str,
        arenaReserveBytes: int32,
        arenaColumnCensus: int32[],
        tree: var ParserValueExprTree,
        err: var str): bool =
    return parserValueExprReadTreeFromTextMode(
        text, false, arenaReserveBytes, arenaColumnCensus, tree, err)

@borrows
fn ParserValueExprReadMigrationSourceTreeFromTextReserved(
        text: str,
        arenaReserveBytes: int32,
        arenaColumnCensus: int32[],
        tree: var ParserValueExprTree,
        err: var str): bool =
    return parserValueExprReadTreeFromTextMode(
        text, true, arenaReserveBytes, arenaColumnCensus, tree, err)

@borrows
fn parserMigrationElseIfRewriteSpansCollectInto(
        text: str,
        spanStartsOut: var int32[],
        spanEndsOut: var int32[],
        err: var str): bool =
    spanStartsOut = []
    spanEndsOut = []
    var normalizedText: str
    var coordinateMap: ParserSourceRewriteCoordinateMap
    let rewritten = ParserSourceHasMultilineString(text)
    if rewritten:
        if !ParserRewriteMultilineStringSourceTextWithCoordinateMap(
               text,
               normalizedText,
               coordinateMap,
               err):
            return false
    else:
        normalizedText = strings.CloneStr(text)
    var tree: ParserValueExprTree
    if !ParserValueExprReadMigrationSourceTreeFromText(normalizedText,
                                                        tree,
                                                        err):
        return false
    var spanStarts: int32[]
    var spanEnds: int32[]
    for tokenIndex in 0..<ParserValueExprTreeTokenCount(tree):
        var normalizedStart: int32
        var normalizedEnd: int32
        if !ParserValueExprMigrationElseIfSpanAt(
                tree,
                tokenIndex,
                ParserValueExprTreeTokenCount(tree),
                normalizedStart,
                normalizedEnd):
            continue
        var originalStart = normalizedStart
        var originalEnd = normalizedEnd
        if rewritten &&
           !ParserSourceRewriteSpanToOriginalInto(
               coordinateMap,
               text,
               normalizedText,
               normalizedStart,
               normalizedEnd,
               originalStart,
               originalEnd,
               err):
            ParserValueExprTreeRelease(tree)
            return false
        if originalStart < 0 || originalEnd <= originalStart ||
           originalEnd > text.len ||
           (spanEnds.len > 0 &&
            originalStart <= spanEnds[spanEnds.len - 1]):
            ParserValueExprTreeRelease(tree)
            err = "parser migration else-if: rewrite span order invalid"
            return false
        add(spanStarts, originalStart)
        add(spanEnds, originalEnd)
    ParserValueExprTreeRelease(tree)
    spanStartsOut = spanStarts
    spanEndsOut = spanEnds
    err = ""
    return true

@borrows
fn ParserMigrationElseIfRewriteSpansInto(
        text: str,
        spanStartsOut: var int32[],
        spanEndsOut: var int32[],
        err: var str): bool =
    return parserMigrationElseIfRewriteSpansCollectInto(
        text,
        spanStartsOut,
        spanEndsOut,
        err)

@borrows
fn ParserMigrationElseIfRewriteSpansValidateInto(
        text: str,
        spanStarts: int32[],
        spanEnds: int32[],
        err: var str): bool =
    var expectedStarts: int32[]
    var expectedEnds: int32[]
    if !parserMigrationElseIfRewriteSpansCollectInto(
            text,
            expectedStarts,
            expectedEnds,
            err):
        return false
    if spanStarts.len != spanEnds.len ||
       spanStarts.len != expectedStarts.len:
        err = "parser migration else-if: rewrite span count mismatch"
        return false
    for spanIndex in 0..<spanStarts.len:
        if spanStarts[spanIndex] != expectedStarts[spanIndex] ||
           spanEnds[spanIndex] != expectedEnds[spanIndex]:
            err = Fmt"parser migration else-if: rewrite span mismatch index={spanIndex}"
            return false
    err = ""
    return true

@borrows
fn ParserCallSurfaceFromOpenParen(lineRaw: str,
                                    openPos: int32,
                                    callArgsTextOut: var str,
                                    callArgCountOut: var int32,
                                    endColumnOut: var int32): bool =
    callArgsTextOut = ""
    callArgCountOut = 0
    endColumnOut = -1
    if openPos < 0 || openPos >= lineRaw.len:
        return false
    if lineRaw[openPos] != '(':
        return false
    let closePos = ParserFindMatchingParen(lineRaw, openPos)
    if closePos <= openPos:
        return false
    callArgsTextOut = ParserTextSliceCopy(lineRaw, openPos + 1, closePos - openPos - 1)
    callArgCountOut = ParserCountTopLevelArgs(callArgsTextOut)
    endColumnOut = closePos + 1
    return true

@borrows
fn ParserFunctionScopeDeclIndex(profile: NormalizedExprCallProfile,
                                  lineNumber: int32): int32 =
    var scopeIndex: int32 = -1
    for i in 0..<profile.decls.len:
        if profile.decls[i].importc:
            continue
        if profile.decls[i].lineIndex > lineNumber:
            break
        scopeIndex = i
    if scopeIndex < 0:
        return -1
    var endLine: int32 = 2147483647
    if scopeIndex + 1 < profile.decls.len:
        endLine = profile.decls[scopeIndex + 1].lineIndex - 1
    if lineNumber > endLine:
        return -1
    return scopeIndex

@borrows
fn ParserTernaryTopLevelQuestionPos(text: str): int32 =
    # 顶层空隔 `?`（三元起符，规范 1.3.4）位置; 无则 -1。postfix `x?` 的
    # `?` 前非空格自然排除; 括号/字符串内的 `?` 不入。
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    var inString = false
    var cursor = 0
    while cursor < text.len:
        let ch = text[cursor]
        if ch == Char(34):
            if !inString:
                inString = true
            elif cursor == 0 || text[cursor - 1] != Char(92):
                inString = false
            cursor = cursor + 1
            continue
        if inString:
            cursor = cursor + 1
            continue
        if ch == '(':
            parenDepth = parenDepth + 1
        elif ch == ')':
            parenDepth = parenDepth - 1
        elif ch == '[':
            bracketDepth = bracketDepth + 1
        elif ch == ']':
            bracketDepth = bracketDepth - 1
        elif ch == '{':
            braceDepth = braceDepth + 1
        elif ch == '}':
            braceDepth = braceDepth - 1
        elif ch == '?' && parenDepth == 0 && bracketDepth == 0 &&
             braceDepth == 0:
            if cursor > 0 && cursor + 1 < text.len &&
               text[cursor - 1] == ' ' && text[cursor + 1] == ' ':
                return cursor
        cursor = cursor + 1
    return -1

@borrows
fn ParserTernaryTopLevelColonPos(text: str, startFrom: int32): int32 =
    # 自 startFrom 起与三元 `?` 配对的顶层空隔 `:`（嵌套 `?`+1/`:`-1,
    # 归零者; 右结合 `a ? b : c ? d : e` 的 else 整体归外层）。无则 -1。
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    var inString = false
    var nestedQuestions: int32 = 1
    var cursor = startFrom
    while cursor < text.len:
        let ch = text[cursor]
        if ch == Char(34):
            if !inString:
                inString = true
            elif cursor == 0 || text[cursor - 1] != Char(92):
                inString = false
            cursor = cursor + 1
            continue
        if inString:
            cursor = cursor + 1
            continue
        if ch == '(':
            parenDepth = parenDepth + 1
        elif ch == ')':
            parenDepth = parenDepth - 1
        elif ch == '[':
            bracketDepth = bracketDepth + 1
        elif ch == ']':
            bracketDepth = bracketDepth - 1
        elif ch == '{':
            braceDepth = braceDepth + 1
        elif ch == '}':
            braceDepth = braceDepth - 1
        elif parenDepth == 0 && bracketDepth == 0 && braceDepth == 0:
            if ch == '?' && cursor + 1 < text.len &&
               text[cursor - 1] == ' ' && text[cursor + 1] == ' ':
                nestedQuestions = nestedQuestions + 1
            elif ch == ':' && cursor > 0 && cursor + 1 < text.len &&
                 text[cursor - 1] == ' ' && text[cursor + 1] == ' ':
                nestedQuestions = nestedQuestions - 1
                if nestedQuestions <= 0:
                    return cursor
        cursor = cursor + 1
    return -1

@borrows
fn ParserTextEqualsAt(text: str,
                        startRaw: int32,
                        expected: str): bool =
    let start = startRaw
    if start < 0:
        return false
    if expected.len <= 0:
        return false
    if start + expected.len > text.len:
        return false
    for i in 0..<expected.len:
        if text[start + i] != expected[i]:
            return false
    return true

@borrows
fn ParserTextRangeEquals(text: str,
                           startRaw: int32,
                           countRaw: int32,
                           expected: str): bool =
    let start = startRaw
    let count = countRaw
    if start < 0:
        return false
    if count != expected.len:
        return false
    if count <= 0:
        return false
    if start + count > text.len:
        return false
    if text[start] != expected[0]:
        return false
    if count == 1:
        return true
    if text[start + count - 1] != expected[count - 1]:
        return false
    for i in 1..<(count - 1):
        if text[start + i] != expected[i]:
            return false
    return true

@borrows
fn ParserTextEqualsExact(left: str,
                           right: str): bool =
    if left.len != right.len:
        return false
    if left.len <= 0:
        return true
    if left[0] != right[0]:
        return false
    if left.len == 1:
        return true
    if left[left.len - 1] != right[right.len - 1]:
        return false
    for i in 1..<(left.len - 1):
        if left[i] != right[i]:
            return false
    return true

@borrows
fn ParserIdentPrefixCountInRange(text: str,
                                   startRaw: int32,
                                   stopRaw: int32): int32 =
    var start = startRaw
    if start < 0:
        start = 0
    var stop = stopRaw
    if stop > text.len:
        stop = text.len
    if start >= stop:
        return 0
    var cursor = start
    while cursor < stop:
        if !ParserIsIdentChar(ParserCharAt(text, cursor)):
            break
        cursor = cursor + 1
    return cursor - start

@borrows
fn ParserBindingNameRange(lineRaw: str,
                            nameStartOut: var int32,
                            nameLenOut: var int32): bool =
    nameStartOut = -1
    nameLenOut = 0
    var cursor: int32
    cursor = ParserSkipInlineSpaces(lineRaw, cursor)
    var keywordLen: int32
    if ParserTextEqualsAt(lineRaw, cursor, "let"):
        keywordLen = 3
    elif ParserTextEqualsAt(lineRaw, cursor, "var"):
        keywordLen = 3
    elif ParserTextEqualsAt(lineRaw, cursor, "const"):
        keywordLen = 5
    if keywordLen <= 0:
        return false
    let afterKeyword = cursor + keywordLen
    if afterKeyword >= lineRaw.len || !ParserIsInlineSpace(lineRaw[afterKeyword]):
        return false
    cursor = ParserSkipInlineSpaces(lineRaw, afterKeyword)
    let nameStart = cursor
    while cursor < lineRaw.len:
        if !ParserIsIdentChar(lineRaw[cursor]):
            break
        cursor = cursor + 1
    if cursor <= nameStart:
        return false
    nameStartOut = nameStart
    nameLenOut = cursor - nameStart
    return true

@borrows
fn ParserBindingDeclarationIsMutable(lineRaw: str): bool =
    var nameStart: int32
    var nameLen: int32
    if !ParserBindingNameRange(lineRaw, nameStart, nameLen):
        return false
    var cursor: int32
    cursor = ParserSkipInlineSpaces(lineRaw, cursor)
    return ParserTextEqualsAt(lineRaw, cursor, "var") &&
           cursor + 3 < lineRaw.len &&
           ParserIsInlineSpace(lineRaw[cursor + 3])

@borrows
fn ParserLineBindingMatches(lineRaw: str,
                              expectedRaw: str): bool =
    let expected = ParserIdentPrefix(chengpath.PathTrim(expectedRaw))
    return ParserLineBindingMatchesExact(lineRaw, expected)

@borrows
fn ParserLineBindingMatchesExact(lineRaw: str,
                                   expected: str): bool =
    if expected == "":
        return false
    var nameStart: int32 = -1
    var nameLen: int32
    if !ParserBindingNameRange(lineRaw, nameStart, nameLen):
        return false
    if nameLen != expected.len:
        return false
    for i in 0..<nameLen:
        if lineRaw[nameStart + i] != expected[i]:
            return false
    return true

@borrows
fn ParserLineBindingMatchesTextRange(lineRaw: str,
                                       expectedText: str,
                                       expectedStart: int32,
                                       expectedLen: int32): bool =
    if expectedLen <= 0:
        return false
    if expectedStart < 0:
        return false
    if expectedStart + expectedLen > expectedText.len:
        return false
    var nameStart: int32 = -1
    var nameLen: int32
    if !ParserBindingNameRange(lineRaw, nameStart, nameLen):
        return false
    if nameLen != expectedLen:
        return false
    for i in 0..<nameLen:
        if lineRaw[nameStart + i] != expectedText[expectedStart + i]:
            return false
    return true

@borrows
fn ParserFunctionParamsContainBinding(lineRaw: str,
                                        expectedRaw: str): bool =
    let expected = ParserIdentPrefix(chengpath.PathTrim(expectedRaw))
    return ParserFunctionParamsContainBindingExact(lineRaw, expected)

@borrows
fn ParserFunctionParamsContainBindingExact(lineRaw: str,
                                             expected: str): bool =
    if expected == "":
        return false
    var openPos: int32 = -1
    openPos = ParserFindText(lineRaw, "(")
    if openPos < 0:
        return false
    var closePos: int32 = -1
    closePos = ParserFindMatchingParen(lineRaw, openPos)
    if closePos <= openPos:
        return false
    var itemStart = openPos + 1
    var depthParen: int32
    var depthBracket: int32
    var depthBrace: int32
    for i in itemStart..closePos:
        var itemStop = i
        var endItem = false
        if i >= closePos:
            itemStop = closePos
            endItem = true
        elif lineRaw[i] == ',' && depthParen == 0 && depthBracket == 0 && depthBrace == 0:
            itemStop = i
            endItem = true
        elif lineRaw[i] == '(':
            depthParen = depthParen + 1
        elif lineRaw[i] == ')':
            if depthParen > 0:
                depthParen = depthParen - 1
        elif lineRaw[i] == '[':
            depthBracket = depthBracket + 1
        elif lineRaw[i] == ']':
            if depthBracket > 0:
                depthBracket = depthBracket - 1
        elif lineRaw[i] == '{':
            depthBrace = depthBrace + 1
        elif lineRaw[i] == '}':
            if depthBrace > 0:
                depthBrace = depthBrace - 1
        if endItem:
            var cursor = ParserSkipInlineSpaces(lineRaw, itemStart)
            if ParserTextEqualsAt(lineRaw, cursor, "var"):
                let afterVar = cursor + 3
                if afterVar < itemStop && ParserIsInlineSpace(lineRaw[afterVar]):
                    cursor = ParserSkipInlineSpaces(lineRaw, afterVar)
            let nameStart = cursor
            while cursor < itemStop:
                if !ParserIsIdentChar(lineRaw[cursor]):
                    break
                cursor = cursor + 1
            let nameLen = cursor - nameStart
            if nameLen == expected.len && nameLen > 0:
                var matched = true
                for partIndex in 0..<nameLen:
                    if lineRaw[nameStart + partIndex] != expected[partIndex]:
                        matched = false
                        break
                if matched:
                    return true
            itemStart = i + 1
    return false

@borrows
fn ParserFunctionParamsContainBindingTextRange(lineRaw: str,
                                                 expectedText: str,
                                                 expectedStart: int32,
                                                 expectedLen: int32): bool =
    if expectedLen <= 0:
        return false
    if expectedStart < 0:
        return false
    if expectedStart + expectedLen > expectedText.len:
        return false
    var openPos: int32 = -1
    openPos = ParserFindText(lineRaw, "(")
    if openPos < 0:
        return false
    var closePos: int32 = -1
    closePos = ParserFindMatchingParen(lineRaw, openPos)
    if closePos <= openPos:
        return false
    var itemStart = openPos + 1
    var depthParen: int32
    var depthBracket: int32
    var depthBrace: int32
    for i in itemStart..closePos:
        var itemStop = i
        var endItem = false
        if i >= closePos:
            itemStop = closePos
            endItem = true
        elif lineRaw[i] == ',' && depthParen == 0 && depthBracket == 0 && depthBrace == 0:
            itemStop = i
            endItem = true
        elif lineRaw[i] == '(':
            depthParen = depthParen + 1
        elif lineRaw[i] == ')':
            if depthParen > 0:
                depthParen = depthParen - 1
        elif lineRaw[i] == '[':
            depthBracket = depthBracket + 1
        elif lineRaw[i] == ']':
            if depthBracket > 0:
                depthBracket = depthBracket - 1
        elif lineRaw[i] == '{':
            depthBrace = depthBrace + 1
        elif lineRaw[i] == '}':
            if depthBrace > 0:
                depthBrace = depthBrace - 1
        if endItem:
            var cursor = ParserSkipInlineSpaces(lineRaw, itemStart)
            if ParserTextEqualsAt(lineRaw, cursor, "var"):
                let afterVar = cursor + 3
                if afterVar < itemStop && ParserIsInlineSpace(lineRaw[afterVar]):
                    cursor = ParserSkipInlineSpaces(lineRaw, afterVar)
            let nameStart = cursor
            while cursor < itemStop:
                if !ParserIsIdentChar(lineRaw[cursor]):
                    break
                cursor = cursor + 1
            let nameLen = cursor - nameStart
            if nameLen == expectedLen && nameLen > 0:
                var matched = true
                for partIndex in 0..<nameLen:
                    if lineRaw[nameStart + partIndex] != expectedText[expectedStart + partIndex]:
                        matched = false
                        break
                if matched:
                    return true
            itemStart = i + 1
    return false

@borrows
fn ParserScopeHasVisibleBindingWithLines(profile: NormalizedExprCallProfile,
                                          lines: str[],
                                          scopeIndex: int32,
                                          lineNumber: int32,
                                          expectedRaw: str): bool =
    let expected = ParserIdentPrefix(chengpath.PathTrim(expectedRaw))
    return ParserScopeHasVisibleBindingExactWithLines(profile,
                                                       lines,
                                                       scopeIndex,
                                                       lineNumber,
                                                       expected)

@borrows
fn ParserScopeHasVisibleBindingExactWithLines(profile: NormalizedExprCallProfile,
                                               lines: str[],
                                               scopeIndex: int32,
                                               lineNumber: int32,
                                               expected: str): bool =
    if expected == "":
        return false
    if scopeIndex < 0 || scopeIndex >= profile.decls.len:
        return false
    let declLineIndex = profile.decls[scopeIndex].lineIndex
    if declLineIndex > 0 && declLineIndex <= lines.len:
        if ParserFunctionParamsContainBindingExact(lines[declLineIndex - 1], expected):
            return true
    var scanLine = declLineIndex + 1
    while scanLine < lineNumber && scanLine <= lines.len:
        if ParserLineBindingMatchesExact(lines[scanLine - 1], expected):
            return true
        scanLine = scanLine + 1
    return false

@borrows
fn ParserScopeHasVisibleBindingTextRangeWithLines(profile: NormalizedExprCallProfile,
                                                   lines: str[],
                                                   scopeIndex: int32,
                                                   lineNumber: int32,
                                                   expectedText: str,
                                                   expectedStart: int32,
                                                   expectedLen: int32): bool =
    if expectedLen <= 0:
        return false
    if scopeIndex < 0 || scopeIndex >= profile.decls.len:
        return false
    let declLineIndex = profile.decls[scopeIndex].lineIndex
    if declLineIndex > 0 && declLineIndex <= lines.len:
        if ParserFunctionParamsContainBindingTextRange(lines[declLineIndex - 1],
                                                         expectedText,
                                                         expectedStart,
                                                         expectedLen):
            return true
    var scanLine = declLineIndex + 1
    while scanLine < lineNumber && scanLine <= lines.len:
        if ParserLineBindingMatchesTextRange(lines[scanLine - 1],
                                               expectedText,
                                               expectedStart,
                                               expectedLen):
            return true
        scanLine = scanLine + 1
    return false

@borrows
fn ParserScopeHasVisibleBinding(profile: NormalizedExprCallProfile,
                                  scopeIndex: int32,
                                  lineNumber: int32,
                                  expectedRaw: str): bool =
    return ParserScopeHasVisibleBindingWithLines(profile,
                                                  profile.lines,
                                                  scopeIndex,
                                                  lineNumber,
                                                  expectedRaw)

@borrows
fn ParserScopeHasVisibleBindingExact(profile: NormalizedExprCallProfile,
                                       scopeIndex: int32,
                                       lineNumber: int32,
                                       expected: str): bool =
    return ParserScopeHasVisibleBindingExactWithLines(profile,
                                                       profile.lines,
                                                       scopeIndex,
                                                       lineNumber,
                                                       expected)

@borrows
fn ParserScopeHasVisibleBindingTextRange(profile: NormalizedExprCallProfile,
                                           scopeIndex: int32,
                                           lineNumber: int32,
                                           expectedText: str,
                                           expectedStart: int32,
                                           expectedLen: int32): bool =
    return ParserScopeHasVisibleBindingTextRangeWithLines(profile,
                                                           profile.lines,
                                                           scopeIndex,
                                                           lineNumber,
                                                           expectedText,
                                                           expectedStart,
                                                           expectedLen)

@borrows
fn ParserQualifiedTargetRootQualifierExact(target: str): str =
    if target == "":
        return ""
    let dotPos = ParserCallExprFirstDotExact(target)
    if dotPos <= 0:
        return ""
    return ParserTextSliceCopy(target, 0, dotPos)

@borrows
fn ParserQualifiedTargetRootQualifier(targetRaw: str): str =
    return ParserQualifiedTargetRootQualifierExact(chengpath.PathTrim(targetRaw))

@borrows
fn ParserQualifiedTargetQualifierChainExact(target: str): str =
    if target == "":
        return ""
    let dotPos = ParserCallExprLastDotExact(target)
    if dotPos <= 0:
        return ""
    return ParserTextSliceCopy(target, 0, dotPos)

@borrows
fn ParserQualifiedTargetQualifierChain(targetRaw: str): str =
    return ParserQualifiedTargetQualifierChainExact(chengpath.PathTrim(targetRaw))

@borrows
fn ParserQualifiedTargetShadowReasonExactWithLines(currentProfile: NormalizedExprCallProfile,
                                                     currentLines: str[],
                                                     lineNumber: int32,
                                                     target: str): NormalizedExprCallReason =
    let dotPos = ParserCallExprFirstDotExact(target)
    if dotPos <= 0:
        return NormalizedExprCallReasonNone
    var lexicalScanLine = lineNumber - 1
    while lexicalScanLine >= 1 && lexicalScanLine <= currentLines.len:
        let lineRaw = currentLines[lexicalScanLine - 1]
        if ParserLineBindingMatchesTextRange(lineRaw, target, 0, dotPos):
            return NormalizedExprCallReasonShadowedQualifiedTarget
        let firstToken = ParserSkipInlineSpaces(lineRaw, 0)
        if ParserTextEqualsAt(lineRaw, firstToken, "fn"):
            if ParserFunctionParamsContainBindingTextRange(lineRaw, target, 0, dotPos):
                return NormalizedExprCallReasonShadowedQualifiedTarget
            break
        lexicalScanLine = lexicalScanLine - 1
    let scopeIndex = ParserFunctionScopeDeclIndex(currentProfile, lineNumber)
    if ParserScopeHasVisibleBindingTextRangeWithLines(currentProfile,
                                                       currentLines,
                                                       scopeIndex,
                                                       lineNumber,
                                                       target,
                                                       0,
                                                       dotPos):
        return NormalizedExprCallReasonShadowedQualifiedTarget
    return NormalizedExprCallReasonNone

@borrows
fn ParserQualifiedTargetShadowReasonExact(currentProfile: NormalizedExprCallProfile,
                                            lineNumber: int32,
                                            target: str): NormalizedExprCallReason =
    return ParserQualifiedTargetShadowReasonExactWithLines(currentProfile,
                                                            currentProfile.lines,
                                                            lineNumber,
                                                            target)

fn ParserCallExprDetailExact(kind: str,
                               callee: str,
                               qualifier: str,
                               target: str,
                               resolved: bool,
                               reason: NormalizedExprCallReason,
                               targetSourcePath: str,
                               targetImportc: bool): str =
    let reasonText = ParserCallReasonText(reason)
    var pairCount: int32 = 3
    var totalLen: int32 = 5 + kind.len +
                          7 + callee.len +
                          7 + target.len
    if qualifier != "":
        pairCount = pairCount + 1
        totalLen = totalLen + 10 + qualifier.len
    if resolved:
        pairCount = pairCount + 1
        totalLen = totalLen + 10
    if reasonText != "":
        pairCount = pairCount + 1
        totalLen = totalLen + 7 + reasonText.len
    if targetSourcePath != "":
        pairCount = pairCount + 1
        totalLen = totalLen + 19 + targetSourcePath.len
    if targetImportc:
        pairCount = pairCount + 1
        totalLen = totalLen + 16
    totalLen = totalLen + (pairCount - 1)
    if totalLen <= 0:
        return ""
    var out = NewStringAlloc(totalLen)
    var writePos: int32
    var hasPairs: bool
    ParserAppendCallExprDetailPair(out, writePos, hasPairs, "kind", kind)
    ParserAppendCallExprDetailPair(out, writePos, hasPairs, "callee", callee)
    if qualifier != "":
        ParserAppendCallExprDetailPair(out, writePos, hasPairs, "qualifier", qualifier)
    ParserAppendCallExprDetailPair(out, writePos, hasPairs, "target", target)
    if resolved:
        ParserAppendCallExprDetailPair(out, writePos, hasPairs, "resolved", "1")
    if reasonText != "":
        ParserAppendCallExprDetailPair(out, writePos, hasPairs, "reason", reasonText)
    if targetSourcePath != "":
        ParserAppendCallExprDetailPair(out, writePos, hasPairs, "target_source_path", targetSourcePath)
    if targetImportc:
        ParserAppendCallExprDetailPair(out, writePos, hasPairs, "target_importc", "1")
    return out

fn ParserAppendCallExprDetailPair(out: var str,
                                    writePos: var int32,
                                    hasPairs: var bool,
                                    key: str,
                                    value: str) =
    if hasPairs:
        ParserWriteByteFast(out, writePos, 59)
    else:
        hasPairs = true
    ParserWriteTextFast(out, writePos, key)
    ParserWriteByteFast(out, writePos, 61)
    ParserWriteTextFast(out, writePos, value)

@borrows
fn ParserAppendCallExprsLineWithCurrentLines(sourcePath: str,
                                               lineNumber: int32,
                                               lineRaw: str,
                                               callLookup: var ParserTextLookup,
                                               detailKind: NormalizedExprSurfaceCallKind,
                                               currentProfile: var NormalizedExprCallProfile,
                                               currentProfileLines: var str[],
                                               profiles: var NormalizedExprCallProfile[],
                                               profileIndexLookup: var ParserSourcePathIndexLookup,
                                               profileCallLookupCache: var ParserProfileCallLookupCacheEntry[],
                                               layer: var NormalizedExprLayer) =
    if callLookup.totalCount <= 0:
        return
    var i: int32
    var inString = false
    var inChar = false
    while i < lineRaw.len:
        let ch = lineRaw[i]
        if !inChar && ch == Char(34) && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
            i = i + 1
            continue
        if !inString && ch == Char(39) && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
            i = i + 1
            continue
        if inString || inChar:
            i = i + 1
            continue
        if ch == Char(35):
            break
        if !ParserIsIdentChar(ch):
            i = i + 1
            continue
        var middleOfIdent = false
        if i > 0:
            middleOfIdent = ParserIsIdentChar(lineRaw[i - 1])
        if middleOfIdent:
            i = i + 1
            continue
        var stop = i
        while stop < lineRaw.len:
            if !ParserIsIdentChar(lineRaw[stop]):
                break
            stop = stop + 1
        if ParserPreviousTokenIsDeclKeyword(lineRaw, i):
            i = stop
            continue
        let nextPos = ParserCallOpenParenAfterName(lineRaw, stop)
        if nextPos < 0:
            i = stop
            continue
        let callName = ParserTextSliceFast(lineRaw, i, stop - i)
        if ParserCallExprUsesDedicatedNormalization(callName):
            i = stop
            continue
        var qualifierStart: int32 = -1
        var qualifierStop: int32 = -1
        var dottedStart: int32 = i
        if i > 1:
            let prevDotPos: int32 = i - 1
            if lineRaw[prevDotPos] == '.':
                qualifierStop = prevDotPos
                qualifierStart = prevDotPos
                while qualifierStart > 0:
                    let prevPos = qualifierStart - 1
                    if !ParserIsIdentChar(lineRaw[prevPos]):
                        break
                    qualifierStart = prevPos
                dottedStart = qualifierStart
                var scanningQualifierChain = true
                while scanningQualifierChain && dottedStart > 1:
                    let prevDot = dottedStart - 1
                    if lineRaw[prevDot] != '.':
                        scanningQualifierChain = false
                    else:
                        var prevStart = prevDot
                        while prevStart > 0:
                            let prevPos = prevStart - 1
                            if !ParserIsIdentChar(lineRaw[prevPos]):
                                break
                            prevStart = prevPos
                        if prevStart < prevDot:
                            dottedStart = prevStart
                        else:
                            scanningQualifierChain = false
        var qualifiedCallName = callName
        var dottedCallName = callName
        var qualifierText = ""
        if qualifierStart >= 0 && qualifierStop > qualifierStart:
            qualifierText = ParserTextSliceFast(lineRaw, qualifierStart, qualifierStop - qualifierStart)
            qualifiedCallName = ParserConcat3(qualifierText, ".", callName)
        if dottedStart < i:
            dottedCallName = ParserTextSliceFast(lineRaw, dottedStart, stop - dottedStart)
            qualifierText = ParserQualifiedTargetQualifierChainExact(dottedCallName)
        var matchedSurfaceText = ParserMatchKnownCallSurfaceTextBorrowed(callLookup,
                                                                          callName,
                                                                          qualifiedCallName,
                                                                          dottedCallName)
        if detailKind == NormalizedExprSurfaceCallExternal && !ParserTextEqualsExact(matchedSurfaceText, ""):
            let shadowReason = ParserQualifiedTargetShadowReasonExactWithLines(currentProfile,
                                                                                 currentProfileLines,
                                                                                 lineNumber,
                                                                                 matchedSurfaceText)
            if shadowReason != NormalizedExprCallReasonNone:
                matchedSurfaceText = ""
        if !ParserTextEqualsExact(matchedSurfaceText, ""):
            let ownedSurface = ParserOwnedText(matchedSurfaceText)
            var resolveSurfaceText = matchedSurfaceText
            if detailKind == NormalizedExprSurfaceCallExternal && !ParserTextEqualsExact(dottedCallName, callName):
                resolveSurfaceText = dottedCallName
            var callArgsText = ""
            var callArgCount: int32
            var endColumnNumber: int32 = -1
            let callSurfaceOk = ParserCallSurfaceFromOpenParen(lineRaw,
                                                                 nextPos,
                                                                 callArgsText,
                                                                 callArgCount,
                                                                 endColumnNumber)
            let _ = callSurfaceOk
            let resolvedTarget = ParserResolveCallTarget(currentProfile,
                                                           profiles,
                                                           profileIndexLookup,
                                                           profileCallLookupCache,
                                                           detailKind,
                                                          resolveSurfaceText,
                                                           callName)
            let resolved = resolvedTarget.sourcePath != ""
            NormalizedExprLayerAppendCall(layer,
                                            sourcePath,
                                            lineNumber,
                                            i + 1,
                                            ownedSurface,
                                            detailKind,
                                            resolved,
                                            resolvedTarget.reason,
                                            qualifierText,
                                            callName,
                                            resolveSurfaceText,
                                            resolvedTarget.sourcePath,
                                            resolvedTarget.importc,
                                            callArgsText,
                                            callArgCount,
                                            false,
                                            endColumnNumber)
        i = stop
    return

@borrows
fn ParserAppendResolvedExternalCallExprsLineWithCurrentLines(sourcePath: str,
                                                              lineNumber: int32,
                                                              lineRaw: str,
                                                              currentProfile: var NormalizedExprCallProfile,
                                                              currentProfileLines: var str[],
                                                              profiles: var NormalizedExprCallProfile[],
                                                              profileIndexLookup: var ParserSourcePathIndexLookup,
                                                              profileCallLookupCache: var ParserProfileCallLookupCacheEntry[],
                                                              layer: var NormalizedExprLayer) =
    var i: int32
    var inString = false
    var inChar = false
    while i < lineRaw.len:
        let ch = lineRaw[i]
        if !inChar && ch == Char(34) && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
            i = i + 1
            continue
        if !inString && ch == Char(39) && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
            i = i + 1
            continue
        if inString || inChar:
            i = i + 1
            continue
        if ch == Char(35):
            break
        if !ParserIsIdentChar(ch):
            i = i + 1
            continue
        var middleOfIdent = false
        if i > 0:
            middleOfIdent = ParserIsIdentChar(lineRaw[i - 1])
        if middleOfIdent:
            i = i + 1
            continue
        var stop = i
        while stop < lineRaw.len:
            if !ParserIsIdentChar(lineRaw[stop]):
                break
            stop = stop + 1
        if ParserPreviousTokenIsDeclKeyword(lineRaw, i):
            i = stop
            continue
        let nextPos = ParserCallOpenParenAfterName(lineRaw, stop)
        if nextPos < 0:
            i = stop
            continue
        let callName = ParserTextSliceFast(lineRaw, i, stop - i)
        if ParserCallExprUsesDedicatedNormalization(callName):
            i = stop
            continue
        var dottedStart = i
        var scanningQualifierChain = true
        while scanningQualifierChain && dottedStart > 1:
            let prevDot = dottedStart - 1
            if lineRaw[prevDot] != '.':
                scanningQualifierChain = false
            else:
                var prevStart = prevDot
                while prevStart > 0:
                    if !ParserIsIdentChar(lineRaw[prevStart - 1]):
                        break
                    prevStart = prevStart - 1
                if prevStart < prevDot:
                    dottedStart = prevStart
                else:
                    scanningQualifierChain = false
        var target = callName
        var qualifier = ""
        var externalCandidate = false
        if dottedStart < i:
            target = ParserTextSliceFast(lineRaw, dottedStart, stop - dottedStart)
            qualifier = ParserQualifiedTargetQualifierChainExact(target)
            let shadowReason = ParserQualifiedTargetShadowReasonExactWithLines(currentProfile,
                                                                                currentProfileLines,
                                                                                lineNumber,
                                                                                target)
            externalCandidate = shadowReason == NormalizedExprCallReasonNone &&
                                ParserProfileHasImportQualifier(currentProfile,
                                                                ParserQualifiedTargetRootQualifierExact(target))
        else:
            externalCandidate = !ParserCallProfileHasLocalCall(currentProfile, callName) &&
                                !ParserCallProfileHasImportcCall(currentProfile, callName) &&
                                !ParserCallNameIsBuiltinCallee(callName)
        if !externalCandidate:
            i = stop
            continue
        let resolvedTarget = ParserResolveCallTarget(currentProfile,
                                                     profiles,
                                                     profileIndexLookup,
                                                     profileCallLookupCache,
                                                     NormalizedExprSurfaceCallExternal,
                                                     target,
                                                     callName)
        let ambiguous = resolvedTarget.reason == NormalizedExprCallReasonAmbiguousExternalTarget ||
                        resolvedTarget.reason == NormalizedExprCallReasonAmbiguousQualifiedTarget
        # A qualified import call is a real external call site even when its
        # leaf cannot be resolved. Preserve that failure as a typed fact. Bare
        # unknown calls keep the legacy behavior and are not classified as
        # external merely because they have call syntax.
        if resolvedTarget.sourcePath == "" && !ambiguous && qualifier == "":
            i = stop
            continue
        var callArgsText = ""
        var callArgCount: int32
        var endColumnNumber: int32 = -1
        let callSurfaceOk = ParserCallSurfaceFromOpenParen(lineRaw,
                                                           nextPos,
                                                           callArgsText,
                                                           callArgCount,
                                                           endColumnNumber)
        let _ = callSurfaceOk
        NormalizedExprLayerAppendCall(layer,
                                      sourcePath,
                                      lineNumber,
                                      i + 1,
                                      target,
                                      NormalizedExprSurfaceCallExternal,
                                      resolvedTarget.sourcePath != "",
                                      resolvedTarget.reason,
                                      qualifier,
                                      callName,
                                      target,
                                      resolvedTarget.sourcePath,
                                      resolvedTarget.importc,
                                      callArgsText,
                                      callArgCount,
                                      false,
                                      endColumnNumber)
        i = stop
    return

@borrows
fn ParserAppendMemberCallExprsLine3WithCurrentLines(sourcePath: str,
                                                      lineNumber: int32,
                                                      lineRaw: str,
                                                      localCallLookup: var ParserTextLookup,
                                                      externalCallLookup: var ParserTextLookup,
                                                      importcCallLookup: var ParserTextLookup,
                                                      currentProfile: var NormalizedExprCallProfile,
                                                      currentProfileLines: var str[],
                                                      profiles: var NormalizedExprCallProfile[],
                                                      profileIndexLookup: var ParserSourcePathIndexLookup,
                                                      profileCallLookupCache: var ParserProfileCallLookupCacheEntry[],
                                                      externalCallsResolvedByGraph: bool,
                                                      layer: var NormalizedExprLayer) =
    var knownCount: int32 = localCallLookup.totalCount
    knownCount = knownCount + externalCallLookup.totalCount
    knownCount = knownCount + importcCallLookup.totalCount
    knownCount = knownCount + currentProfile.localCallNames.len
    knownCount = knownCount + currentProfile.importcCallNames.len
    if knownCount <= 0:
        return
    var i: int32
    var inString = false
    var inChar = false
    while i < lineRaw.len:
        let ch = lineRaw[i]
        if !inChar:
            if ch == Char(34):
                if !ParserQuoteIsEscaped(lineRaw, i):
                    inString = !inString
                    i = i + 1
                    continue
        if !inString:
            if ch == Char(39):
                if !ParserQuoteIsEscaped(lineRaw, i):
                    inChar = !inChar
                    i = i + 1
                    continue
        if inString:
            i = i + 1
            continue
        if inChar:
            i = i + 1
            continue
        if ch == Char(35):
            break
        if !ParserIsIdentChar(ch):
            i = i + 1
            continue
        let start = i
        var stop = i
        while stop < lineRaw.len:
            if !ParserIsIdentChar(lineRaw[stop]):
                break
            stop = stop + 1
        if ParserPreviousTokenIsDeclKeyword(lineRaw, start):
            i = stop
            continue
        let nextPos = ParserCallOpenParenAfterName(lineRaw, stop)
        if nextPos < 0:
            i = stop
            continue
        let callName = ParserTextSliceFast(lineRaw, start, stop - start)
        if ParserCallExprUsesDedicatedNormalization(callName):
            i = stop
            continue
        var qualifierStart: int32 = -1
        var qualifierStop: int32 = -1
        var dottedStart: int32 = start
        if start > 1:
            let prevDotPos: int32 = start - 1
            if lineRaw[prevDotPos] == '.':
                qualifierStop = prevDotPos
                qualifierStart = prevDotPos
                while qualifierStart > 0:
                    let prevPos = qualifierStart - 1
                    if !ParserIsIdentChar(lineRaw[prevPos]):
                        break
                    qualifierStart = prevPos
                dottedStart = qualifierStart
                var scanningQualifierChain = true
                while scanningQualifierChain:
                    if dottedStart <= 1:
                        scanningQualifierChain = false
                    else:
                        let prevDot = dottedStart - 1
                        if lineRaw[prevDot] != '.':
                            scanningQualifierChain = false
                        else:
                            var prevStart = prevDot
                            while prevStart > 0:
                                let prevPos = prevStart - 1
                                if !ParserIsIdentChar(lineRaw[prevPos]):
                                    break
                                prevStart = prevPos
                            if prevStart < prevDot:
                                dottedStart = prevStart
                            else:
                                scanningQualifierChain = false
        var dottedCallName = callName
        var qualifiedCallName = callName
        var qualifierText = ""
        if qualifierStart >= 0:
            if qualifierStop > qualifierStart:
                qualifierText = ParserTextSliceFast(lineRaw, qualifierStart, qualifierStop - qualifierStart)
                qualifiedCallName = ParserConcat3(qualifierText, ".", callName)
        if dottedStart < start:
            dottedCallName = ParserTextSliceFast(lineRaw, dottedStart, stop - dottedStart)
            qualifierText = ParserQualifiedTargetQualifierChainExact(dottedCallName)
        if dottedCallName != callName:
            let shadowReason = ParserQualifiedTargetShadowReasonExactWithLines(currentProfile,
                                                                                 currentProfileLines,
                                                                                 lineNumber,
                                                                                 dottedCallName)
            let rootQualifier = ParserQualifiedTargetRootQualifierExact(dottedCallName)
            let qualifierIsImport = ParserProfileHasImportQualifier(currentProfile, rootQualifier)
            if externalCallsResolvedByGraph && qualifierIsImport:
                # ParserAppendResolvedExternalCallExprsLine is authoritative
                # for imported qualifiers. Re-emitting here can turn one
                # ambiguous graph result into a conflicting direct-import hit.
                i = stop
                continue
            let matchedKnownCall = ParserMatchKnownCallSurfaceTextBorrowed3(localCallLookup,
                                                                             externalCallLookup,
                                                                             importcCallLookup,
                                                                             callName,
                                                                             qualifiedCallName,
                                                                             dottedCallName)
            var appendUnresolved = false
            var appendResolvedExternal = false
            var resolvedExternalTarget = ParserResolvedCallTargetEmpty()
            if shadowReason != NormalizedExprCallReasonNone:
                appendUnresolved = true
            if matchedKnownCall == "" && shadowReason == NormalizedExprCallReasonNone:
                if qualifierIsImport:
                    resolvedExternalTarget = ParserResolveCallTarget(currentProfile,
                                                                      profiles,
                                                                      profileIndexLookup,
                                                                      profileCallLookupCache,
                                                                      NormalizedExprSurfaceCallExternal,
                                                                      dottedCallName,
                                                                      callName)
                    if resolvedExternalTarget.sourcePath != "":
                        appendResolvedExternal = true
                    else:
                        appendUnresolved = true
                else:
                    appendUnresolved = true
            if appendResolvedExternal || appendUnresolved:
                var reasonText = NormalizedExprCallReasonUnknownQualifiedTarget
                if shadowReason != NormalizedExprCallReasonNone:
                    reasonText = shadowReason
                var unresolvedSurfaceKind = NormalizedExprSurfaceCallMember
                if appendResolvedExternal:
                    reasonText = NormalizedExprCallReasonNone
                    unresolvedSurfaceKind = NormalizedExprSurfaceCallExternal
                elif resolvedExternalTarget.reason != NormalizedExprCallReasonNone:
                    reasonText = resolvedExternalTarget.reason
                    if ParserProfileHasImportQualifier(currentProfile, ParserQualifiedTargetRootQualifierExact(dottedCallName)):
                        unresolvedSurfaceKind = NormalizedExprSurfaceCallExternal
                elif shadowReason == NormalizedExprCallReasonNone &&
                     ParserProfileHasImportQualifier(currentProfile, ParserQualifiedTargetRootQualifierExact(dottedCallName)):
                    unresolvedSurfaceKind = NormalizedExprSurfaceCallExternal
                var callArgsText = ""
                var callArgCount: int32
                var endColumnNumber: int32 = -1
                let callSurfaceOk = ParserCallSurfaceFromOpenParen(lineRaw,
                                                                     nextPos,
                                                                     callArgsText,
                                                                     callArgCount,
                                                                     endColumnNumber)
                let _ = callSurfaceOk
                NormalizedExprLayerAppendCall(layer,
                                                sourcePath,
                                                lineNumber,
                                                start + 1,
                                                dottedCallName,
                                                unresolvedSurfaceKind,
                                                appendResolvedExternal,
                                                reasonText,
                                                qualifierText,
                                                callName,
                                                dottedCallName,
                                                resolvedExternalTarget.sourcePath,
                                                resolvedExternalTarget.importc,
                                                callArgsText,
                                                callArgCount,
                                                false,
                                                endColumnNumber)
        else:
            var directKind = NormalizedExprSurfaceCallNone
            var directImportc = false
            for importcIndex in 0..<currentProfile.importcCallNames.len:
                if currentProfile.importcCallNames[importcIndex] == callName:
                    directKind = NormalizedExprSurfaceCallImportc
                    directImportc = true
                    break
            if directKind == NormalizedExprSurfaceCallNone:
                for localIndex in 0..<currentProfile.localCallNames.len:
                    if currentProfile.localCallNames[localIndex] == callName:
                        directKind = NormalizedExprSurfaceCallLocal
                        break
            if directKind != NormalizedExprSurfaceCallNone:
                var callArgsText = ""
                var callArgCount: int32
                var endColumnNumber: int32 = -1
                let callSurfaceOk = ParserCallSurfaceFromOpenParen(lineRaw,
                                                                     nextPos,
                                                                     callArgsText,
                                                                     callArgCount,
                                                                     endColumnNumber)
                let _ = callSurfaceOk
                NormalizedExprLayerAppendCall(layer,
                                                sourcePath,
                                                lineNumber,
                                                start + 1,
                                                callName,
                                                directKind,
                                                true,
                                                NormalizedExprCallReasonNone,
                                                "",
                                                callName,
                                                callName,
                                                sourcePath,
                                                directImportc,
                                                callArgsText,
                                                callArgCount,
                                                false,
                                                endColumnNumber)
            elif !externalCallsResolvedByGraph && !ParserCallNameIsBuiltinCallee(callName):
                var directExternalMatchCount: int32
                var directExternalSourcePath = ""
                var directExternalImportc = false
                for edgeIndex in 0..<currentProfile.importEdges.len:
                    let edge = currentProfile.importEdges[edgeIndex]
                    if !edge.resolved || !edge.allowsUnqualifiedCall:
                        continue
                    var targetProfileIndex = ParserImportEdgeTargetProfileIndex(edge, profileIndexLookup)
                    if targetProfileIndex < 0:
                        let normalizedTargetPath = ParserNormalizePath(edge.targetSourcePath)
                        for profileScan in 0..<profiles.len:
                            if ParserNormalizePath(profiles[profileScan].sourcePath) == normalizedTargetPath:
                                targetProfileIndex = profileScan
                                break
                    if targetProfileIndex < 0 || targetProfileIndex >= profiles.len:
                        continue
                    let targetProfile = profiles[targetProfileIndex]
                    var targetHasImportc = false
                    var targetHasLocal = false
                    for importcIndex in 0..<targetProfile.importcCallNames.len:
                        if targetProfile.importcCallNames[importcIndex] == callName:
                            targetHasImportc = true
                            break
                    for localIndex in 0..<targetProfile.localCallNames.len:
                        if targetProfile.localCallNames[localIndex] == callName:
                            targetHasLocal = true
                            break
                    if !targetHasImportc && !targetHasLocal:
                        continue
                    directExternalMatchCount = directExternalMatchCount + 1
                    directExternalSourcePath = targetProfile.sourcePath
                    directExternalImportc = targetHasImportc
                let externalTarget = ParserResolveUnqualifiedExternalCallTarget(currentProfile,
                                                                                 profiles,
                                                                                 profileIndexLookup,
                                                                                 profileCallLookupCache,
                                                                                 callName)
                if directExternalMatchCount > 0 ||
                   externalTarget.sourcePath != "" ||
                   externalTarget.reason != NormalizedExprCallReasonUnknownExternalTarget:
                    var externalResolved = externalTarget.sourcePath != ""
                    var externalReason = externalTarget.reason
                    var externalSourcePath = externalTarget.sourcePath
                    var externalImportc = externalTarget.importc
                    if directExternalMatchCount == 1:
                        externalResolved = true
                        externalReason = NormalizedExprCallReasonNone
                        externalSourcePath = directExternalSourcePath
                        externalImportc = directExternalImportc
                    elif directExternalMatchCount > 1:
                        externalResolved = false
                        externalReason = NormalizedExprCallReasonAmbiguousExternalTarget
                        externalSourcePath = ""
                        externalImportc = false
                    var callArgsText = ""
                    var callArgCount: int32
                    var endColumnNumber: int32 = -1
                    let callSurfaceOk = ParserCallSurfaceFromOpenParen(lineRaw,
                                                                         nextPos,
                                                                         callArgsText,
                                                                         callArgCount,
                                                                         endColumnNumber)
                    let _ = callSurfaceOk
                    NormalizedExprLayerAppendCall(layer,
                                                    sourcePath,
                                                    lineNumber,
                                                    start + 1,
                                                    callName,
                                                    NormalizedExprSurfaceCallExternal,
                                                    externalResolved,
                                                    externalReason,
                                                    "",
                                                    callName,
                                                    callName,
                                                    externalSourcePath,
                                                    externalImportc,
                                                    callArgsText,
                                                    callArgCount,
                                                    false,
                                                    endColumnNumber)
        i = stop
    return

@borrows
fn ParserMaxQualifiedCallDepthLines(lines: str[]): int32 =
    var maxDepth: int32
    for i in 0..<lines.len:
        let lineRaw = lines[i]
        if !ParserHasNonTrimChar(lineRaw):
            continue
        var pos: int32
        var inString = false
        var inChar = false
        while pos < lineRaw.len:
            let ch = lineRaw[pos]
            if !inChar && ch == Char(34) && !ParserQuoteIsEscaped(lineRaw, pos):
                inString = !inString
                pos = pos + 1
                continue
            if !inString && ch == Char(39) && !ParserQuoteIsEscaped(lineRaw, pos):
                inChar = !inChar
                pos = pos + 1
                continue
            if inString || inChar:
                pos = pos + 1
                continue
            if ch == Char(35):
                break
            if !ParserIsIdentChar(ch):
                pos = pos + 1
                continue
            let start = pos
            var stop = pos
            while stop < lineRaw.len:
                if !ParserIsIdentChar(lineRaw[stop]):
                    break
                stop = stop + 1
            let nextPos = ParserCallOpenParenAfterName(lineRaw, stop)
            if nextPos >= 0 && !ParserPreviousTokenIsDeclKeyword(lineRaw, start):
                let depth = ParserDottedQualifierDepth(lineRaw, start)
                if depth > maxDepth:
                    maxDepth = depth
            pos = stop
    return maxDepth

@borrows
fn ParserAppendComprehensionExprsLine(sourcePath: str,
                                        lineNumber: int32,
                                        lineRaw: str,
                                        layer: var NormalizedExprLayer) =
    for openPos in 0..<lineRaw.len:
        if lineRaw[openPos] != '[':
            continue
        var itemText = ""
        var bindingText = ""
        var sourceText = ""
        var filterText = ""
        var filterColumn = -1
        var endColumn = -1
        if !ParserParseListComprehensionAt(lineRaw,
                                             openPos,
                                             itemText,
                                             bindingText,
                                             sourceText,
                                             filterText,
                                             filterColumn,
                                             endColumn):
            continue
        NormalizedExprLayerAppendSpan(layer,
                                        sourcePath,
                                        lineNumber,
                                        openPos + 1,
                                        NormalizedExprComprehension,
                                        NormalizedExprDetailComprehensionList,
                                        "[for in]",
                                        endColumn)

@borrows
fn ParserImportcCallNamesFromDecls(decls: NormalizedFunctionDecl[],
                                     names: var str[]) =
    var out: str[]
    for i in 0..<decls.len:
        if !decls[i].importc:
            continue
        if decls[i].name == "":
            continue
        ParserAddUniqueText(out, decls[i].name)
    names = out

@borrows
fn ParserLocalCallNamesFromDecls(decls: NormalizedFunctionDecl[],
                                   names: var str[]) =
    var out: str[]
    for i in 0..<decls.len:
        if decls[i].importc:
            continue
        if decls[i].name == "":
            continue
        ParserAddUniqueText(out, decls[i].name)
    names = out

@borrows
fn parserBuildExprCallProfileSyntaxInto(
        sourcePathRaw: str,
        text: str,
        migrationSourceSyntax: bool,
        profile: var NormalizedExprCallProfile,
        err: var str): bool =
    parserMemTraceSource = sourcePathRaw
    ParserDebugStage("profile_enter")
    let sourcePath = ParserNormalizePath(sourcePathRaw)
    ParserDebugStage("profile_after_normalize")
    var normalizedText: str
    if !ParserRewriteMultilineStringSourceText(
           text, normalizedText, err):
        return false
    ParserDebugStage("profile_after_multiline")
    if sourcePath == "":
        err = "missing source path"
        return false
    profile = NormalizedExprCallProfile()
    profile.sourcePath = sourcePath
    profile.text = share(normalizedText)
    let lines = ParserSplitChar(normalizedText, '\n')
    ParserDebugStage("profile_after_split")
    profile.lines = share(lines)
    if !parserReadFunctionDeclsLinesMode(
            lines, migrationSourceSyntax, profile.decls, err):
        return false
    ParserDebugStage("profile_after_decls")
    if err != "":
        return false
    ParserReadNormalizedTypeDeclsLines(lines, profile.typeDecls)
    ParserDebugStage("profile_after_types")
    ParserImportcCallNamesFromDecls(profile.decls, profile.importcCallNames)
    ParserDebugStage("profile_after_importc_names")
    ParserLocalCallNamesFromDecls(profile.decls, profile.localCallNames)
    ParserDebugStage("profile_after_local_names")
    profile.maxQualifiedCallDepth = ParserMaxQualifiedCallDepthLines(lines)
    ParserDebugStage("profile_after_max_depth")
    err = ""
    return true

@borrows
fn ParserBuildExprCallProfileWithExternalPackageRoots(workspaceRootRaw: str,
                                                        packageRootRaw: str,
                                                        externalPackageRoots: ParserExternalPackageRoot[],
                                                        sourcePathRaw: str,
                                                        text: str,
                                                        profile: var NormalizedExprCallProfile,
                                                        err: var str): bool =
    let workspaceRoot = ParserNormalizePath(workspaceRootRaw)
    let packageRoot = ParserNormalizePath(packageRootRaw)
    if !parserBuildExprCallProfileSyntaxInto(
            sourcePathRaw, text, false, profile, err):
        return false
    profile.ownerModulePath =
        ParserSourcePathToModulePathWithExternalPackageRoots(
            workspaceRoot,
            packageRoot,
            externalPackageRoots,
            profile.sourcePath)
    if workspaceRoot != "" && packageRoot != "":
        ParserDebugStage("profile_before_import_edges")
        if !ParserReadImportEdgesLinesWithExternalPackageRoots(
                workspaceRoot,
                packageRoot,
                externalPackageRoots,
                profile.ownerModulePath,
                profile.lines,
                profile.importEdges,
                err):
            return false
        ParserDebugStage("profile_after_import_edges")
    err = ""
    return true

@borrows
fn parserExactImportEdgeSameIdentity(left: ImportEdge,
                                     right: ImportEdge): bool =
    return left.ownerProducerSourceIndex ==
               right.ownerProducerSourceIndex &&
           left.importDeclarationSourceLocalRow ==
               right.importDeclarationSourceLocalRow &&
           left.importItemSourceLocalRow ==
               right.importItemSourceLocalRow &&
           left.ownerModulePath == right.ownerModulePath &&
           left.targetModulePath == right.targetModulePath &&
           left.targetSourcePath == right.targetSourcePath &&
           left.importAlias == right.importAlias

@borrows
fn parserExactImportEdgeAllFieldsEqual(left: ImportEdge,
                                       right: ImportEdge): bool =
    return parserExactImportEdgeSameIdentity(left, right) &&
           left.targetSourcePathLen == right.targetSourcePathLen &&
           left.targetSourcePathFirstCode ==
               right.targetSourcePathFirstCode &&
           left.targetSourcePathLastCode ==
               right.targetSourcePathLastCode &&
           left.targetSourcePathDotCount ==
               right.targetSourcePathDotCount &&
           left.targetSourcePathHash == right.targetSourcePathHash &&
           left.targetProfileIndex == right.targetProfileIndex &&
           left.importDeclarationRow ==
               right.importDeclarationRow &&
           left.importItemRow == right.importItemRow &&
           left.qualifier == right.qualifier &&
           left.allowsUnqualifiedCall == right.allowsUnqualifiedCall &&
           left.resolved && right.resolved

@borrows
fn parserExactSourceIndex(sourcePaths: str[],
                          sourcePath: str): int32 =
    var found: int32 = -1
    for sourceIndex in 0..<sourcePaths.len:
        if sourcePaths[sourceIndex] != sourcePath:
            continue
        if found >= 0:
            return -2
        found = sourceIndex
    return found

# Immutable CompilerCSG profile entry.  Source identity and import joins come
# only from the sealed plan columns and the parser's exact module↔path map.
# It never reads a manifest, probes PathExists, or opens a source file.
@borrows
fn ParserBuildExprCallProfileExactInto(
        workspaceRootRaw: str,
        packageRootRaw: str,
        packageIdRaw: str,
        externalPackageRoots: ParserExternalPackageRoot[],
        sourcePathRaw: str,
        ownerModulePathRaw: str,
        text: str,
        sourceClosurePaths: str[],
        ownerModulePaths: str[],
        exactImportEdges: ImportEdge[],
        migrationSourceSyntax: bool,
        profile: var NormalizedExprCallProfile,
        err: var str): bool =
    profile = NormalizedExprCallProfile()
    let packageId = ParserManifestNormalizePackageId(packageIdRaw)
    var workspaceRoot: str
    var packageRoot: str
    var sourcePath: str
    if packageId == "" || packageId != packageIdRaw ||
       sourceClosurePaths.len <= 0 ||
       sourceClosurePaths.len != ownerModulePaths.len ||
       !ParserSourceIdentityLexicalPathInto(
           workspaceRootRaw, workspaceRoot) ||
       workspaceRoot != workspaceRootRaw ||
       !ParserSourceIdentityPathAbsolute(workspaceRoot) ||
       !ParserSourceIdentityLexicalPathInto(
           packageRootRaw, packageRoot) ||
       packageRoot != packageRootRaw ||
       !ParserSourceIdentityPathAbsolute(packageRoot) ||
       !ParserSourceIdentityLexicalPathInto(sourcePathRaw, sourcePath) ||
       sourcePath != sourcePathRaw ||
       !ParserSourceIdentityPathAbsolute(sourcePath):
        err = " parser: exact profile identity invalid"
        return false
    let sourceIndex = parserExactSourceIndex(sourceClosurePaths, sourcePath)
    var canonicalOwnerModulePath: str
    if sourceIndex < 0 || sourceIndex >= ownerModulePaths.len:
        err = " parser: exact profile source binding missing"
        return false
    if ParserSourceIdentityPathAbsolute(ownerModulePathRaw):
        # Root-out row: the exact identity is the canonical absolute source
        # file path; module derivation has no anchor for it by construction.
        if ownerModulePathRaw != sourcePath ||
           ownerModulePaths[sourceIndex] != ownerModulePathRaw:
            err = " parser: exact profile source binding missing"
            return false
    else:
        if ownerModulePaths[sourceIndex] != ownerModulePathRaw ||
           !ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
                workspaceRoot,
                packageRoot,
                packageId,
                externalPackageRoots,
                sourcePath,
                canonicalOwnerModulePath) ||
           canonicalOwnerModulePath != ownerModulePathRaw:
            err = " parser: exact profile source binding missing"
            return false
    if !parserBuildExprCallProfileSyntaxInto(
            sourcePath, text, migrationSourceSyntax, profile, err):
        return false
    profile.ownerModulePath = ParserOwnedText(ownerModulePathRaw)
    var importSpecs: ParserImportSpec[]
    if !ParserReadImportSpecsLines(
            ownerModulePathRaw, profile.lines, importSpecs, err):
        return false
    var expectedEdges: ImportEdge[]
    for specIndex in 0..<importSpecs.len:
        let spec = importSpecs[specIndex]
        var targetModulePath: str
        var targetSourcePath: str
        if spec.ownerModulePath != ownerModulePathRaw ||
           !ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
                workspaceRoot,
                packageRoot,
                packageId,
                externalPackageRoots,
                spec.targetModulePath,
                targetModulePath,
                targetSourcePath):
            err = Fmt" parser: exact profile import target identity invalid index={specIndex}"
            return false
        let targetSourceIndex = parserExactSourceIndex(
            sourceClosurePaths, targetSourcePath)
        if targetSourceIndex < 0 ||
           targetSourceIndex >= ownerModulePaths.len ||
           ownerModulePaths[targetSourceIndex] != targetModulePath:
            err = Fmt" parser: exact profile import target outside closure index={specIndex}"
            return false
        var edge: ImportEdge
        edge.ownerProducerSourceIndex = sourceIndex
        edge.importDeclarationSourceLocalRow =
            spec.importDeclarationSourceLocalRow
        edge.importItemSourceLocalRow =
            spec.importItemSourceLocalRow
        edge.importDeclarationRow = -1
        edge.importItemRow = -1
        edge.ownerModulePath = ParserOwnedText(ownerModulePathRaw)
        # Exact identity joins against the sealed plan columns, whose target
        # module path is the closure-canonical spelling (compatibility
        # spellings like `cheng/std/...` canonicalize to `std/...`).  Store
        # the canonical form, never the source-text spelling.
        edge.targetModulePath = ParserOwnedText(targetModulePath)
        edge.targetSourcePath = ParserOwnedText(targetSourcePath)
        edge.targetSourcePathLen = targetSourcePath.len
        edge.targetSourcePathFirstCode = Int32(targetSourcePath[0])
        edge.targetSourcePathLastCode =
            Int32(targetSourcePath[targetSourcePath.len - 1])
        edge.targetSourcePathDotCount =
            ParserTextLookupDotCount(targetSourcePath)
        edge.targetSourcePathHash =
            ParserTextLookupContentHash(targetSourcePath)
        edge.targetProfileIndex = targetSourceIndex
        edge.importAlias = chengpath.PathTrim(spec.importAlias)
        let aliasText = ParserIdentPrefix(edge.importAlias)
        if aliasText != "":
            edge.qualifier = aliasText
        else:
            let sourceStem = ParserFileStem(targetSourcePath)
            edge.qualifier = sourceStem != "" ? sourceStem :
                ParserLastPathPiece(targetModulePath)
        edge.allowsUnqualifiedCall = edge.importAlias == ""
        edge.resolved = true
        ParserAddUniqueImportEdge(expectedEdges, edge)
    var suppliedEdges: ImportEdge[]
    for edgeIndex in 0..<exactImportEdges.len:
        var supplied = exactImportEdges[edgeIndex]
        if supplied.ownerModulePath != ownerModulePathRaw:
            if supplied.ownerProducerSourceIndex != sourceIndex:
                continue
            supplied.ownerModulePath = ParserOwnedText(ownerModulePathRaw)
        if supplied.ownerProducerSourceIndex == sourceIndex &&
           supplied.targetModulePath == "":
            var recoveredSpecIndex: int32 = -1
            for specIndex in 0..<importSpecs.len:
                if importSpecs[specIndex].importDeclarationSourceLocalRow !=
                       supplied.importDeclarationSourceLocalRow ||
                   importSpecs[specIndex].importItemSourceLocalRow !=
                       supplied.importItemSourceLocalRow:
                    continue
                if recoveredSpecIndex >= 0:
                    err = Fmt" parser: exact profile import identity duplicated index={edgeIndex}"
                    return false
                recoveredSpecIndex = specIndex
            if recoveredSpecIndex >= 0:
                let spec = importSpecs[recoveredSpecIndex]
                supplied.targetModulePath = ParserOwnedText(spec.targetModulePath)
                if supplied.targetSourcePath == "":
                    var recoveredTargetModule: str
                    var recoveredTargetSource: str
                    if spec.ownerModulePath == ownerModulePathRaw &&
                       ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
                            workspaceRoot,
                            packageRoot,
                            packageId,
                            externalPackageRoots,
                            spec.targetModulePath,
                            recoveredTargetModule,
                            recoveredTargetSource):
                        supplied.targetSourcePath =
                            ParserOwnedText(recoveredTargetSource)
                        supplied.targetSourcePathLen =
                            recoveredTargetSource.len
                        supplied.targetSourcePathFirstCode =
                            Int32(recoveredTargetSource[0])
                        supplied.targetSourcePathLastCode =
                            Int32(recoveredTargetSource[
                                recoveredTargetSource.len - 1])
                        supplied.targetSourcePathDotCount =
                            ParserTextLookupDotCount(recoveredTargetSource)
                        supplied.targetSourcePathHash =
                            ParserTextLookupContentHash(recoveredTargetSource)
                if supplied.qualifier == "":
                    let aliasText = ParserIdentPrefix(supplied.importAlias)
                    if aliasText != "":
                        supplied.qualifier = aliasText
                    else:
                        let sourceStem = ParserFileStem(supplied.targetSourcePath)
                        supplied.qualifier = sourceStem != "" ? sourceStem :
                            ParserLastPathPiece(supplied.targetModulePath)
        var matchIndex: int32 = -1
        for expectedIndex in 0..<expectedEdges.len:
            if !parserExactImportEdgeSameIdentity(
                    supplied, expectedEdges[expectedIndex]):
                continue
            if matchIndex >= 0:
                err = Fmt" parser: exact profile import identity duplicated index={edgeIndex}"
                return false
            matchIndex = expectedIndex
        if matchIndex < 0:
            err = Fmt" parser: exact profile import edge split index={edgeIndex} identity owner={supplied.ownerModulePath} target={supplied.targetModulePath} local_decl={supplied.importDeclarationSourceLocalRow} local_item={supplied.importItemSourceLocalRow}"
            return false
        var expectedBound = expectedEdges[matchIndex]
        let boundTargetProfileIndex = expectedBound.targetProfileIndex
        expectedBound.importDeclarationRow =
            supplied.importDeclarationRow
        expectedBound.importItemRow = supplied.importItemRow
        expectedEdges[matchIndex] = expectedBound
        var suppliedBound = supplied
        suppliedBound.targetProfileIndex = boundTargetProfileIndex
        if !parserExactImportEdgeAllFieldsEqual(
                suppliedBound, expectedEdges[matchIndex]):
            err = Fmt" parser: exact profile import edge split index={edgeIndex} fields"
            return false
        add(suppliedEdges, share(suppliedBound))
    if suppliedEdges.len != expectedEdges.len:
        err = Fmt" parser: exact profile import edge coverage split expected={expectedEdges.len} supplied_kept={suppliedEdges.len} plan_edges={exactImportEdges.len} owner={ownerModulePathRaw}"
        return false
    profile.importEdges = suppliedEdges
    err = ""
    return true

fn ParserBuildExprCallProfile(workspaceRootRaw: str,
                                packageRootRaw: str,
                                sourcePathRaw: str,
                                text: str,
                                profile: var NormalizedExprCallProfile,
                                err: var str): bool =
    var externalPackageRoots: ParserExternalPackageRoot[]
    return ParserBuildExprCallProfileWithExternalPackageRoots(workspaceRootRaw,
                                                                packageRootRaw,
                                                                externalPackageRoots,
                                                                sourcePathRaw,
                                                                text,
                                                                profile,
                                                                err)

@borrows
@borrow_result
fn ParserImportEdgeQualifier(edge: ImportEdge): str =
    return edge.qualifier

@borrows
fn ParserImportEdgeAllowsUnqualifiedCall(edge: ImportEdge): bool =
    return edge.allowsUnqualifiedCall

@borrows
fn ParserQualifiedCallPrefixExact(prefix: str,
                                    qualifier: str): str =
    if prefix == "":
        return strings.CloneStr(qualifier)
    if qualifier == "":
        return strings.CloneStr(prefix)
    return ParserConcat3(prefix, ".", qualifier)

@borrows
fn ParserQualifiedCallPrefix(prefixRaw: str,
                               qualifierRaw: str): str =
    let prefix = chengpath.PathTrim(prefixRaw)
    let qualifier = chengpath.PathTrim(qualifierRaw)
    return ParserQualifiedCallPrefixExact(prefix, qualifier)

fn ParserResolvedCallTargetNew(sourcePathRaw: str,
                                 importc: bool,
                                 reasonRaw: NormalizedExprCallReason): NormalizedExprResolvedCallTarget =
    return ParserResolvedCallTargetNewExact(ParserNormalizePath(sourcePathRaw),
                                              importc,
                                              reasonRaw)

fn ParserResolvedCallTargetNewExact(sourcePath: str,
                                      importc: bool,
                                      reason: NormalizedExprCallReason): NormalizedExprResolvedCallTarget =
    var out: NormalizedExprResolvedCallTarget
    out.sourcePath = sourcePath
    out.importc = importc
    out.reason = reason
    return out

fn ParserResolvedCallTargetResolved(sourcePathRaw: str,
                                      importc: bool): NormalizedExprResolvedCallTarget =
    return ParserResolvedCallTargetNewExact(sourcePathRaw, importc, NormalizedExprCallReasonNone)

fn ParserResolvedCallTargetUnknown(reasonRaw: NormalizedExprCallReason): NormalizedExprResolvedCallTarget =
    return ParserResolvedCallTargetNewExact("", false, reasonRaw)

fn ParserResolvedCallTargetEmpty(): NormalizedExprResolvedCallTarget =
    return ParserResolvedCallTargetNewExact("", false, NormalizedExprCallReasonNone)

@borrows
fn ParserResolvedCallTargetSame(lhs: NormalizedExprResolvedCallTarget,
                                  rhs: NormalizedExprResolvedCallTarget): bool =
    if lhs.sourcePath != rhs.sourcePath:
        return false
    if lhs.importc != rhs.importc:
        return false
    if lhs.reason != rhs.reason:
        return false
    return true

fn ParserAppendUniqueResolvedCallTarget(out: var NormalizedExprResolvedCallTarget[],
                                          target: NormalizedExprResolvedCallTarget) =
    if target.sourcePath == "" || target.reason != NormalizedExprCallReasonNone:
        return
    for i in 0..<out.len:
        if ParserResolvedCallTargetSame(out[i], target):
            return
    add(out, target)

fn ParserImportedTargetLookupResolved(targetProfileIndex: int32): ParserImportedTargetLookup =
    var out: ParserImportedTargetLookup
    out.targetProfileIndex = targetProfileIndex
    out.reason = NormalizedExprCallReasonNone
    return out

fn ParserImportedTargetLookupUnknown(reasonRaw: NormalizedExprCallReason): ParserImportedTargetLookup =
    return ParserImportedTargetLookupUnknownExact(reasonRaw)

fn ParserImportedTargetLookupUnknownExact(reason: NormalizedExprCallReason): ParserImportedTargetLookup =
    var out: ParserImportedTargetLookup
    out.targetProfileIndex = -1
    out.reason = reason
    return out

@borrows
fn ParserCallProfileHasImportcCall(profile: NormalizedExprCallProfile,
                                     nameRaw: str): bool =
    let name = ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    if name == "":
        return false
    return ParserStringSeqContainsExact(profile.importcCallNames, name)

@borrows
fn ParserCallProfileHasLocalCall(profile: NormalizedExprCallProfile,
                                   nameRaw: str): bool =
    let name = ParserIdentPrefix(chengpath.PathTrim(nameRaw))
    if name == "":
        return false
    return ParserStringSeqContainsExact(profile.localCallNames, name)

@borrows
fn ParserCallProfileHasImportcCallExact(profiles: NormalizedExprCallProfile[],
                                          profileIndex: int32,
                                          cache: var ParserProfileCallLookupCacheEntry[],
                                          name: str): bool =
    if name == "":
        return false
    let cacheIndex = ParserProfileCallLookupCacheEnsureIndex(profiles, profileIndex, cache)
    if cacheIndex < 0:
        return false
    var lookup = cache[cacheIndex].importcLookup
    return ParserTextLookupContainsExactBorrowed(lookup, name)

@borrows
fn ParserCallProfileHasLocalCallExact(profiles: NormalizedExprCallProfile[],
                                        profileIndex: int32,
                                        cache: var ParserProfileCallLookupCacheEntry[],
                                        name: str): bool =
    if name == "":
        return false
    let cacheIndex = ParserProfileCallLookupCacheEnsureIndex(profiles, profileIndex, cache)
    if cacheIndex < 0:
        return false
    var lookup = cache[cacheIndex].localLookup
    return ParserTextLookupContainsExactBorrowed(lookup, name)

@borrows
fn ParserProfileCallLookupFlags(profiles: NormalizedExprCallProfile[],
                                  profileIndex: int32,
                                  cache: var ParserProfileCallLookupCacheEntry[],
                                  name: str,
                                  hasImportc: var bool,
                                  hasLocal: var bool): bool =
    hasImportc = false
    hasLocal = false
    if name == "":
        return false
    let cacheIndex = ParserProfileCallLookupCacheEnsureIndex(profiles, profileIndex, cache)
    if cacheIndex < 0:
        return false
    let entry = cache[cacheIndex]
    var importcLookup = entry.importcLookup
    var localLookup = entry.localLookup
    hasImportc = ParserTextLookupContainsExactBorrowed(importcLookup, name)
    hasLocal = ParserTextLookupContainsExactBorrowed(localLookup, name)
    return true

@borrows
fn ParserImportedTargetProfileIndexFrom(
        currentProfile: NormalizedExprCallProfile,
        profiles: NormalizedExprCallProfile[],
        profileIndexLookup: ParserSourcePathIndexLookup,
        qualifierChain: str,
        partStart: int32): ParserImportedTargetLookup =
    var partStop = partStart
    while partStop < qualifierChain.len:
        if qualifierChain[partStop] == '.':
            break
        partStop = partStop + 1
    let qualifierLen = ParserIdentPrefixCountInRange(
        qualifierChain, partStart, partStop)
    if qualifierLen <= 0:
        return ParserImportedTargetLookupUnknownExact(
            NormalizedExprCallReasonUnknownQualifiedTarget)
    var targetProfileIndex: int32 = -1
    var firstQualifierEdgeIndex: int32 = -1
    for edgeIndex in 0..<currentProfile.importEdges.len:
        let edgeQualifier =
            currentProfile.importEdges[edgeIndex].qualifier
        if !ParserTextRangeEquals(
               qualifierChain,
               partStart,
               qualifierLen,
               edgeQualifier):
            continue
        let normalizedEdgeTargetPath = ParserNormalizePath(
            currentProfile.importEdges[edgeIndex].targetSourcePath)
        if normalizedEdgeTargetPath != "":
            if firstQualifierEdgeIndex < 0:
                firstQualifierEdgeIndex = edgeIndex
            else:
                let firstNormalizedTargetPath = ParserNormalizePath(
                    currentProfile.importEdges[
                        firstQualifierEdgeIndex].targetSourcePath)
                if firstNormalizedTargetPath != normalizedEdgeTargetPath:
                    return ParserImportedTargetLookupUnknownExact(
                        NormalizedExprCallReasonAmbiguousQualifiedTarget)
        var candidateIndex =
            currentProfile.importEdges[edgeIndex].targetProfileIndex
        if candidateIndex < 0:
            candidateIndex = ParserImportEdgeTargetProfileIndex(
                currentProfile.importEdges[edgeIndex],
                profileIndexLookup)
        if candidateIndex < 0:
            let normalizedTargetPath = ParserNormalizePath(
                currentProfile.importEdges[edgeIndex].targetSourcePath)
            for profileScan in 0..<profiles.len:
                if ParserNormalizePath(profiles[profileScan].sourcePath) ==
                   normalizedTargetPath:
                    candidateIndex = profileScan
                    break
        if candidateIndex < 0:
            continue
        if targetProfileIndex < 0:
            targetProfileIndex = candidateIndex
            continue
        if targetProfileIndex != candidateIndex:
            return ParserImportedTargetLookupUnknownExact(
                NormalizedExprCallReasonAmbiguousQualifiedTarget)
    if targetProfileIndex < 0:
        return ParserImportedTargetLookupUnknownExact(
            NormalizedExprCallReasonUnknownQualifiedTarget)
    if partStop >= qualifierChain.len:
        return ParserImportedTargetLookupResolved(targetProfileIndex)
    return ParserImportedTargetProfileIndexFrom(
        profiles[targetProfileIndex],
        profiles,
        profileIndexLookup,
        qualifierChain,
        partStop + 1)

@borrows
fn ParserImportedTargetProfileIndex(
        currentProfile: NormalizedExprCallProfile,
        profiles: NormalizedExprCallProfile[],
        profileIndexLookup: ParserSourcePathIndexLookup,
        qualifierChainRaw: str): ParserImportedTargetLookup =
    let qualifierChain = qualifierChainRaw
    if qualifierChain == "":
        return ParserImportedTargetLookupUnknownExact(
            NormalizedExprCallReasonUnknownQualifiedTarget)
    return ParserImportedTargetProfileIndexFrom(
        currentProfile,
        profiles,
        profileIndexLookup,
        qualifierChain,
        0)

@borrows
fn ParserResolveQualifiedCallTarget(currentProfile: NormalizedExprCallProfile,
                                      profiles: NormalizedExprCallProfile[],
                                      profileIndexLookup: ParserSourcePathIndexLookup,
                                      profileCallLookupCache: var ParserProfileCallLookupCacheEntry[],
                                      targetRaw: str,
                                      calleeRaw: str): NormalizedExprResolvedCallTarget =
    let qualifier = ParserQualifiedTargetQualifierChainExact(targetRaw)
    let callee = ParserIdentPrefix(calleeRaw)
    if qualifier == "" || callee == "":
        return ParserResolvedCallTargetUnknown(NormalizedExprCallReasonUnknownQualifiedTarget)
    var exactQualifiedMatchCount: int32
    var exactQualifiedSourcePath = ""
    var exactQualifiedImportc = false
    for edgeIndex in 0..<currentProfile.importEdges.len:
        let edge = currentProfile.importEdges[edgeIndex]
        if edge.qualifier != qualifier:
            continue
        var candidateIndex: int32 = -1
        let normalizedTargetPath = ParserNormalizePath(edge.targetSourcePath)
        for profileScan in 0..<profiles.len:
            if ParserNormalizePath(profiles[profileScan].sourcePath) == normalizedTargetPath:
                candidateIndex = profileScan
                break
        if candidateIndex < 0 || candidateIndex >= profiles.len:
            continue
        let candidateProfile = profiles[candidateIndex]
        var candidateHasImportc = false
        var candidateHasLocal = false
        for importcIndex in 0..<candidateProfile.importcCallNames.len:
            if candidateProfile.importcCallNames[importcIndex] == callee:
                candidateHasImportc = true
                break
        for localIndex in 0..<candidateProfile.localCallNames.len:
            if candidateProfile.localCallNames[localIndex] == callee:
                candidateHasLocal = true
                break
        if !candidateHasImportc && !candidateHasLocal:
            continue
        exactQualifiedMatchCount = exactQualifiedMatchCount + 1
        let candidateSourcePath = candidateProfile.sourcePath
        exactQualifiedSourcePath = share(candidateSourcePath)
        exactQualifiedImportc = candidateHasImportc
    if exactQualifiedMatchCount == 1:
        return ParserResolvedCallTargetResolved(exactQualifiedSourcePath, exactQualifiedImportc)
    if exactQualifiedMatchCount > 1:
        return ParserResolvedCallTargetUnknown(NormalizedExprCallReasonAmbiguousQualifiedTarget)
    let targetLookup = ParserImportedTargetProfileIndex(currentProfile,
                                                          profiles,
                                                          profileIndexLookup,
                                                          qualifier)
    if targetLookup.targetProfileIndex < 0:
        var directQualifiedMatchCount: int32
        var directQualifiedSourcePath = ""
        var directQualifiedImportc = false
        for edgeIndex in 0..<currentProfile.importEdges.len:
            let edge = currentProfile.importEdges[edgeIndex]
            if edge.qualifier != qualifier:
                continue
            var candidateIndex = ParserImportEdgeTargetProfileIndex(edge, profileIndexLookup)
            if candidateIndex < 0:
                let normalizedTargetPath = ParserNormalizePath(edge.targetSourcePath)
                for profileScan in 0..<profiles.len:
                    if ParserNormalizePath(profiles[profileScan].sourcePath) == normalizedTargetPath:
                        candidateIndex = profileScan
                        break
            if candidateIndex < 0 || candidateIndex >= profiles.len:
                continue
            let candidateProfile = profiles[candidateIndex]
            var candidateHasImportc = false
            var candidateHasLocal = false
            for importcIndex in 0..<candidateProfile.importcCallNames.len:
                if candidateProfile.importcCallNames[importcIndex] == callee:
                    candidateHasImportc = true
                    break
            for localIndex in 0..<candidateProfile.localCallNames.len:
                if candidateProfile.localCallNames[localIndex] == callee:
                    candidateHasLocal = true
                    break
            if !candidateHasImportc && !candidateHasLocal:
                continue
            directQualifiedMatchCount = directQualifiedMatchCount + 1
            let candidateSourcePath = candidateProfile.sourcePath
            directQualifiedSourcePath = share(candidateSourcePath)
            directQualifiedImportc = candidateHasImportc
        if directQualifiedMatchCount == 1:
            return ParserResolvedCallTargetResolved(directQualifiedSourcePath, directQualifiedImportc)
        if directQualifiedMatchCount > 1:
            return ParserResolvedCallTargetUnknown(NormalizedExprCallReasonAmbiguousQualifiedTarget)
        return ParserResolvedCallTargetUnknown(targetLookup.reason)
    let targetProfile = profiles[targetLookup.targetProfileIndex]
    var hasImportc = false
    var hasLocal = false
    let foundTarget = ParserProfileCallLookupFlags(profiles,
                                                     targetLookup.targetProfileIndex,
                                                     profileCallLookupCache,
                                                     callee,
                                                     hasImportc,
                                                     hasLocal)
    if foundTarget && hasImportc:
        return ParserResolvedCallTargetResolved(
            share(targetProfile.sourcePath), true)
    if foundTarget && hasLocal:
        return ParserResolvedCallTargetResolved(
            share(targetProfile.sourcePath), false)
    for importcIndex in 0..<targetProfile.importcCallNames.len:
        if targetProfile.importcCallNames[importcIndex] == callee:
            return ParserResolvedCallTargetResolved(
                share(targetProfile.sourcePath), true)
    for localIndex in 0..<targetProfile.localCallNames.len:
        if targetProfile.localCallNames[localIndex] == callee:
            return ParserResolvedCallTargetResolved(
                share(targetProfile.sourcePath), false)
    let visibleTarget = ParserResolveUnqualifiedExternalCallTarget(targetProfile,
                                                                    profiles,
                                                                    profileIndexLookup,
                                                                    profileCallLookupCache,
                                                                    callee)
    if visibleTarget.sourcePath != "":
        return visibleTarget
    if visibleTarget.reason == NormalizedExprCallReasonAmbiguousExternalTarget:
        return ParserResolvedCallTargetUnknown(NormalizedExprCallReasonAmbiguousQualifiedTarget)
    var visibleQualifiedMatchCount: int32
    var visibleQualifiedSourcePath = ""
    var visibleQualifiedImportc = false
    for edgeIndex in 0..<targetProfile.importEdges.len:
        let edge = targetProfile.importEdges[edgeIndex]
        if !edge.allowsUnqualifiedCall:
            continue
        var candidateIndex = ParserImportEdgeTargetProfileIndex(edge, profileIndexLookup)
        if candidateIndex < 0:
            let normalizedTargetPath = ParserNormalizePath(edge.targetSourcePath)
            for profileScan in 0..<profiles.len:
                if ParserNormalizePath(profiles[profileScan].sourcePath) == normalizedTargetPath:
                    candidateIndex = profileScan
                    break
        if candidateIndex < 0 || candidateIndex >= profiles.len:
            continue
        let candidateProfile = profiles[candidateIndex]
        var candidateHasImportc = false
        var candidateHasLocal = false
        for importcIndex in 0..<candidateProfile.importcCallNames.len:
            if candidateProfile.importcCallNames[importcIndex] == callee:
                candidateHasImportc = true
                break
        for localIndex in 0..<candidateProfile.localCallNames.len:
            if candidateProfile.localCallNames[localIndex] == callee:
                candidateHasLocal = true
                break
        if !candidateHasImportc && !candidateHasLocal:
            continue
        visibleQualifiedMatchCount = visibleQualifiedMatchCount + 1
        let candidateSourcePath = candidateProfile.sourcePath
        visibleQualifiedSourcePath = share(candidateSourcePath)
        visibleQualifiedImportc = candidateHasImportc
    if visibleQualifiedMatchCount == 1:
        return ParserResolvedCallTargetResolved(visibleQualifiedSourcePath, visibleQualifiedImportc)
    if visibleQualifiedMatchCount > 1:
        return ParserResolvedCallTargetUnknown(NormalizedExprCallReasonAmbiguousQualifiedTarget)
    return ParserResolvedCallTargetUnknown(NormalizedExprCallReasonUnknownQualifiedTarget)

@borrows
fn ParserResolveUnqualifiedExternalCallTarget(currentProfile: NormalizedExprCallProfile,
                                                profiles: NormalizedExprCallProfile[],
                                                profileIndexLookup: ParserSourcePathIndexLookup,
                                                profileCallLookupCache: var ParserProfileCallLookupCacheEntry[],
                                                calleeRaw: str): NormalizedExprResolvedCallTarget =
    let callee = ParserIdentPrefix(calleeRaw)
    if callee == "":
        return ParserResolvedCallTargetUnknown(NormalizedExprCallReasonUnknownExternalTarget)
    var currentProfileIndex = ParserProfileIndexLookupForNormalizedSourcePathExact(profileIndexLookup,
                                                                                    currentProfile.sourcePath)
    if currentProfileIndex < 0:
        let normalizedCurrentPath = ParserNormalizePath(currentProfile.sourcePath)
        for profileScan in 0..<profiles.len:
            if ParserNormalizePath(profiles[profileScan].sourcePath) == normalizedCurrentPath:
                currentProfileIndex = profileScan
                break
    if currentProfileIndex < 0:
        return ParserResolvedCallTargetUnknown(NormalizedExprCallReasonUnknownExternalTarget)
    var visited: bool[] = ParserBoolSeqInit(profiles.len, false)
    visited[currentProfileIndex] = true
    var pending: int32[]
    add(pending, currentProfileIndex)
    var pendingIndex: int32
    var found: NormalizedExprResolvedCallTarget[]
    while pendingIndex < pending.len:
        let workingProfileIndex = pending[pendingIndex]
        pendingIndex = pendingIndex + 1
        for edgeIndex in 0..<profiles[workingProfileIndex].importEdges.len:
            if !profiles[workingProfileIndex].importEdges[edgeIndex].allowsUnqualifiedCall:
                continue
            var targetProfileIndex = profiles[workingProfileIndex].importEdges[edgeIndex].targetProfileIndex
            if targetProfileIndex < 0:
                targetProfileIndex = ParserImportEdgeTargetProfileIndex(profiles[workingProfileIndex].importEdges[edgeIndex],
                                                                         profileIndexLookup)
            if targetProfileIndex < 0:
                let normalizedTargetPath = ParserNormalizePath(profiles[workingProfileIndex].importEdges[edgeIndex].targetSourcePath)
                for profileScan in 0..<profiles.len:
                    if ParserNormalizePath(profiles[profileScan].sourcePath) == normalizedTargetPath:
                        targetProfileIndex = profileScan
                        break
            if targetProfileIndex < 0:
                continue
            if !visited[targetProfileIndex]:
                visited[targetProfileIndex] = true
                add(pending, targetProfileIndex)
            var hasImportc = false
            var hasLocal = false
            var foundTarget = false
            for importcIndex in 0..<profiles[targetProfileIndex].importcCallNames.len:
                if profiles[targetProfileIndex].importcCallNames[importcIndex] == callee:
                    hasImportc = true
                    foundTarget = true
                    break
            for localIndex in 0..<profiles[targetProfileIndex].localCallNames.len:
                if profiles[targetProfileIndex].localCallNames[localIndex] == callee:
                    hasLocal = true
                    foundTarget = true
                    break
            if !foundTarget:
                continue
            if hasImportc || hasLocal:
                ParserAppendUniqueResolvedCallTarget(found,
                                                       ParserResolvedCallTargetResolved(ParserOwnedText(profiles[targetProfileIndex].sourcePath),
                                                                                          hasImportc))
    if found.len <= 0:
        return ParserResolvedCallTargetUnknown(NormalizedExprCallReasonUnknownExternalTarget)
    if found.len > 1:
        return ParserResolvedCallTargetUnknown(NormalizedExprCallReasonAmbiguousExternalTarget)
    return ParserResolvedCallTargetNewExact(ParserOwnedText(found[0].sourcePath),
                                              found[0].importc,
                                              found[0].reason)

@borrows
fn ParserResolveCallTarget(currentProfile: NormalizedExprCallProfile,
                             profiles: NormalizedExprCallProfile[],
                             profileIndexLookup: ParserSourcePathIndexLookup,
                             profileCallLookupCache: var ParserProfileCallLookupCacheEntry[],
                             detailKind: NormalizedExprSurfaceCallKind,
                             targetRaw: str,
                             calleeRaw: str): NormalizedExprResolvedCallTarget =
    if detailKind == NormalizedExprSurfaceCallLocal:
        return ParserResolvedCallTargetResolved(
            share(currentProfile.sourcePath), false)
    if detailKind == NormalizedExprSurfaceCallImportc:
        return ParserResolvedCallTargetResolved(
            share(currentProfile.sourcePath), true)
    if detailKind != NormalizedExprSurfaceCallExternal:
        return ParserResolvedCallTargetUnknown(NormalizedExprCallReasonUnknownCallTarget)
    let target = targetRaw
    if ParserCallExprLastDotExact(target) >= 0:
        return ParserResolveQualifiedCallTarget(currentProfile,
                                                  profiles,
                                                  profileIndexLookup,
                                                  profileCallLookupCache,
                                                  target,
                                                  calleeRaw)
    return ParserResolveUnqualifiedExternalCallTarget(currentProfile,
                                                        profiles,
                                                        profileIndexLookup,
                                                        profileCallLookupCache,
                                                        calleeRaw)

fn ParserQualifiedCallDepth(prefixRaw: str): int32 =
    let prefix = chengpath.PathTrim(prefixRaw)
    if prefix == "":
        return 0
    var depth: int32 = 1
    for i in 0..<prefix.len:
        if prefix[i] == '.':
            depth = depth + 1
    return depth

@borrows
fn ParserAppendQualifiedCallNames(out: var str[],
                                    seen: var ParserTextLookup,
                                    prefixRaw: str,
                                    callNames: str[]) =
    let prefix = chengpath.PathTrim(prefixRaw)
    ParserAppendQualifiedCallNamesExact(out, seen, prefix, callNames)

@borrows
fn ParserAppendQualifiedCallNamesExact(out: var str[],
                                         seen: var ParserTextLookup,
                                         prefix: str,
                                         callNames: str[]) =
    if prefix == "":
        return
    let prefixWithDot = ParserConcat2(prefix, ".")
    for i in 0..<callNames.len:
        let callName = callNames[i]
        if callName == "":
            continue
        let qualifiedName = ParserConcat2(prefixWithDot, callName)
        ParserAppendUniqueLookupTextKey(out,
                                          seen,
                                          qualifiedName,
                                          ParserTextLookupKeyExact(qualifiedName))

fn ParserAppendDirectExternalCallNames(out: var str[],
                                         seen: var ParserTextLookup,
                                         callNames: str[]) =
    for i in 0..<callNames.len:
        let callName = strings.CloneStr(callNames[i])
        if callName == "":
            continue
        ParserAppendUniqueLookupTextKey(out, seen, callName, ParserTextLookupKeyExact(callName))

@borrows
fn ParserAppendVisibleDirectExternalCallNames(out: var str[],
                                                seen: var ParserTextLookup,
                                                callNames: str[],
                                                localLookup: ParserTextLookup,
                                                importcLookup: ParserTextLookup) =
    for i in 0..<callNames.len:
        let callName = callNames[i]
        if callName == "":
            continue
        if ParserCallNameIsBuiltinCallee(callName):
            continue
        if ParserTextLookupContainsExact(localLookup, callName):
            continue
        if ParserTextLookupContainsExact(importcLookup, callName):
            continue
        ParserAppendUniqueLookupTextExact(out, seen, share(callName))

@borrows
fn ParserCloneTextSeq(items: str[]): str[] =
    var out: str[]
    for i in 0..<items.len:
        add(out, strings.CloneStr(items[i]))
    return out

# `//`-aware 剥注释(见 ParserStripLineCommentSlashAware 定义处注释): 这是
# ParserJoinContinuationLines 的输入准备步骤, 早于续行判定运行。旧版只认 '#'
# 时, 纯 '//' 注释行原样存活进 codeLines, 之后被逐行结构判定(控制头关键字/冒号
# 扫描等)当代码文本处理, 与 ParserJoinContinuationLines 同族缺口, 需同步收口。
@borrows
fn ParserPrepareCodeLines(lines: str[]): str[] =
    var out: str[]
    for i in 0..<lines.len:
        let stripped = ParserStripLineCommentSlashAware(lines[i])
        add(out, strings.CloneStr(stripped))
    return out

fn ParserBoolSeqInit(count: int32,
                       value: bool): bool[] =
    var out: bool[]
    for i in 0..<count:
        add(out, value)
    return out

fn ParserCollectVisibleUnqualifiedExternalCallNamesRecursive(profiles: var NormalizedExprCallProfile[],
                                                               profileIndexLookup: var ParserSourcePathIndexLookup,
                                                               profileIndex: int32,
                                                               rootLocalLookup: ParserTextLookup,
                                                               rootImportcLookup: ParserTextLookup,
                                                               seen: var ParserTextLookup,
                                                               out: var str[]) =
    if profileIndex < 0 || profileIndex >= profiles.len:
        return
    var newOut: str[]
    var newSeen: ParserTextLookup
    newSeen.slots = []
    newSeen.buckets = []
    newSeen.totalCount = 0
    var visited: bool[] = ParserBoolSeqInit(profiles.len, false)
    visited[profileIndex] = true
    var pending: int32[]
    add(pending, profileIndex)
    var pendingIndex: int32
    while pendingIndex < pending.len:
        let currentIndex = pending[pendingIndex]
        pendingIndex = pendingIndex + 1
        for edgeIndex in 0..<profiles[currentIndex].importEdges.len:
            if profiles[currentIndex].importEdges[edgeIndex].allowsUnqualifiedCall:
                var targetProfileIndex = ParserImportEdgeTargetProfileIndex(profiles[currentIndex].importEdges[edgeIndex],
                                                                             profileIndexLookup)
                if targetProfileIndex < 0:
                    let normalizedTargetPath = ParserNormalizePath(profiles[currentIndex].importEdges[edgeIndex].targetSourcePath)
                    for profileScan in 0..<profiles.len:
                        if ParserNormalizePath(profiles[profileScan].sourcePath) == normalizedTargetPath:
                            targetProfileIndex = profileScan
                            break
                if targetProfileIndex >= 0:
                    ParserAppendVisibleDirectExternalCallNames(newOut,
                                                                 newSeen,
                                                                 profiles[targetProfileIndex].localCallNames,
                                                                 rootLocalLookup,
                                                                 rootImportcLookup)
                    ParserAppendVisibleDirectExternalCallNames(newOut,
                                                                 newSeen,
                                                                 profiles[targetProfileIndex].importcCallNames,
                                                                 rootLocalLookup,
                                                                 rootImportcLookup)
                    if !visited[targetProfileIndex]:
                        visited[targetProfileIndex] = true
                        add(pending, targetProfileIndex)
    out = newOut
    seen.slots = newSeen.slots
    seen.buckets = newSeen.buckets
    seen.totalCount = newSeen.totalCount

fn ParserCollectResolvedUnqualifiedExternalTargetsRecursive(profiles: var NormalizedExprCallProfile[],
                                                              profileIndexLookup: var ParserSourcePathIndexLookup,
                                                              profileIndex: int32,
                                                              calleeRaw: str,
                                                              out: var NormalizedExprResolvedCallTarget[]) =
    if profileIndex < 0 || profileIndex >= profiles.len:
        return
    let callee = ParserIdentPrefix(chengpath.PathTrim(calleeRaw))
    if callee == "":
        return
    var newOut: NormalizedExprResolvedCallTarget[]
    var visited: bool[] = ParserBoolSeqInit(profiles.len, false)
    visited[profileIndex] = true
    var pending: int32[]
    add(pending, profileIndex)
    var pendingIndex: int32
    while pendingIndex < pending.len:
        let currentIndex = pending[pendingIndex]
        pendingIndex = pendingIndex + 1
        for edgeIndex in 0..<profiles[currentIndex].importEdges.len:
            if profiles[currentIndex].importEdges[edgeIndex].allowsUnqualifiedCall:
                var targetProfileIndex = ParserImportEdgeTargetProfileIndex(profiles[currentIndex].importEdges[edgeIndex],
                                                                             profileIndexLookup)
                if targetProfileIndex < 0:
                    let normalizedTargetPath = ParserNormalizePath(profiles[currentIndex].importEdges[edgeIndex].targetSourcePath)
                    for profileScan in 0..<profiles.len:
                        if ParserNormalizePath(profiles[profileScan].sourcePath) == normalizedTargetPath:
                            targetProfileIndex = profileScan
                            break
                if targetProfileIndex >= 0:
                    var hasImportc = false
                    var hasLocal = false
                    for importcIndex in 0..<profiles[targetProfileIndex].importcCallNames.len:
                        if profiles[targetProfileIndex].importcCallNames[importcIndex] == callee:
                            hasImportc = true
                    for localIndex in 0..<profiles[targetProfileIndex].localCallNames.len:
                        if profiles[targetProfileIndex].localCallNames[localIndex] == callee:
                            hasLocal = true
                    if hasImportc || hasLocal:
                        ParserAppendUniqueResolvedCallTarget(newOut,
                                                               ParserResolvedCallTargetResolved(ParserOwnedText(profiles[targetProfileIndex].sourcePath),
                                                                                                  hasImportc))
                    if !visited[targetProfileIndex]:
                        visited[targetProfileIndex] = true
                        add(pending, targetProfileIndex)
    out = newOut

@borrows
fn ParserCachedVisibleUnqualifiedExternalCallNames(profiles: var NormalizedExprCallProfile[],
                                                     profileIndexLookup: var ParserSourcePathIndexLookup,
                                                     profileIndex: int32,
                                                     cache: var ParserTextSeqCacheEntry[]): str[] =
    for i in 0..<cache.len:
        let entry = cache[i]
        if entry.profileIndex == profileIndex:
            return share(entry.items)
    var out: str[]
    if profileIndex < 0:
        return out
    if profileIndex >= profiles.len:
        return out
    let rootProfile = profiles[profileIndex]
    let rootLocalLookup = ParserTextLookupBuildExact(rootProfile.localCallNames)
    let rootImportcLookup = ParserTextLookupBuildExact(rootProfile.importcCallNames)
    var seen: ParserTextLookup
    seen.slots = []
    seen.buckets = []
    seen.totalCount = 0
    ParserCollectVisibleUnqualifiedExternalCallNamesRecursive(profiles,
                                                                profileIndexLookup,
                                                                profileIndex,
                                                                rootLocalLookup,
                                                                rootImportcLookup,
                                                                seen,
                                                                out)
    var entry: ParserTextSeqCacheEntry
    entry.profileIndex = profileIndex
    entry.items = share(out)
    add(cache, entry)
    return out

@borrows
fn ParserCachedQualifiedExternalCallNames(profiles: var NormalizedExprCallProfile[],
                                            profileIndexLookup: var ParserSourcePathIndexLookup,
                                            profileIndex: int32,
                                            prefix: str,
                                            visibleNameCache: var ParserTextSeqCacheEntry[],
                                            cache: var ParserQualifiedTextSeqCacheEntry[]): str[] =
    for i in 0..<cache.len:
        let entry = cache[i]
        if entry.profileIndex != profileIndex:
            continue
        if entry.prefix == prefix:
            return share(entry.items)
    var out: str[]
    if profileIndex < 0:
        return out
    if profileIndex >= profiles.len:
        return out
    if prefix == "":
        return out
    let targetProfile = profiles[profileIndex]
    let visibleNames = ParserCachedVisibleUnqualifiedExternalCallNames(profiles,
                                                                         profileIndexLookup,
                                                                         profileIndex,
                                                                         visibleNameCache)
    var seen = ParserTextLookupInit(targetProfile.localCallNames.len +
                                      targetProfile.importcCallNames.len +
                                      visibleNames.len + 8)
    ParserAppendQualifiedCallNamesExact(out, seen, prefix, targetProfile.localCallNames)
    ParserAppendQualifiedCallNamesExact(out, seen, prefix, targetProfile.importcCallNames)
    ParserAppendQualifiedCallNamesExact(out, seen, prefix, visibleNames)
    var entry: ParserQualifiedTextSeqCacheEntry
    entry.profileIndex = profileIndex
    entry.prefix = share(prefix)
    entry.items = share(out)
    add(cache, entry)
    return out

fn ParserCollectExternalCallNamesRecursive(profiles: var NormalizedExprCallProfile[],
                                             profileIndexLookup: var ParserSourcePathIndexLookup,
                                             profileIndex: int32,
                                             prefix: str,
                                             prefixDepth: int32,
                                             maxQualifiedCallDepth: int32,
                                             activeProfileFlags: var bool[],
                                             visibleNameCache: var ParserTextSeqCacheEntry[],
                                             qualifiedNameCache: var ParserQualifiedTextSeqCacheEntry[],
                                             seen: var ParserTextLookup,
                                             out: var str[]) =
    if profileIndex < 0:
        return
    if profileIndex >= profiles.len:
        return
    let current = profiles[profileIndex]
    for edgeIndex in 0..<current.importEdges.len:
        let edge = current.importEdges[edgeIndex]
        var targetProfileIndex = ParserImportEdgeTargetProfileIndex(edge, profileIndexLookup)
        if targetProfileIndex < 0:
            let normalizedTargetPath = ParserNormalizePath(edge.targetSourcePath)
            for profileScan in 0..<profiles.len:
                if ParserNormalizePath(profiles[profileScan].sourcePath) == normalizedTargetPath:
                    targetProfileIndex = profileScan
                    break
        if targetProfileIndex < 0:
            continue
        if targetProfileIndex >= profiles.len:
            continue
        let qualifier = edge.qualifier
        if qualifier == "":
            continue
        let nextPrefix = ParserQualifiedCallPrefixExact(prefix, qualifier)
        let nextDepth = prefixDepth + 1
        if nextDepth > maxQualifiedCallDepth:
            continue
        let qualifiedNames = ParserCachedQualifiedExternalCallNames(profiles,
                                                                      profileIndexLookup,
                                                                      targetProfileIndex,
                                                                      nextPrefix,
                                                                      visibleNameCache,
                                                                      qualifiedNameCache)
        ParserAppendDirectExternalCallNames(out, seen, qualifiedNames)
        if nextDepth >= maxQualifiedCallDepth:
            continue
        if activeProfileFlags[targetProfileIndex]:
            continue
        activeProfileFlags[targetProfileIndex] = true
        ParserCollectExternalCallNamesRecursive(profiles,
                                                  profileIndexLookup,
                                                  targetProfileIndex,
                                                  nextPrefix,
                                                  nextDepth,
                                                  maxQualifiedCallDepth,
                                                  activeProfileFlags,
                                                  visibleNameCache,
                                                  qualifiedNameCache,
                                                  seen,
                                                  out)
        activeProfileFlags[targetProfileIndex] = false

fn ParserCollectExternalCallNames(profiles: var NormalizedExprCallProfile[],
                                    profileIndexLookup: var ParserSourcePathIndexLookup,
                                    profileIndex: int32,
                                    names: var str[]) =
    var visibleNameCache: ParserTextSeqCacheEntry[]
    var qualifiedNameCache: ParserQualifiedTextSeqCacheEntry[]
    ParserCollectExternalCallNamesCached(profiles,
                                           profileIndexLookup,
                                           profileIndex,
                                           visibleNameCache,
                                           qualifiedNameCache,
                                           names)

fn ParserCollectExternalCallNamesCached(profiles: var NormalizedExprCallProfile[],
                                          profileIndexLookup: var ParserSourcePathIndexLookup,
                                          profileIndex: int32,
                                          visibleNameCache: var ParserTextSeqCacheEntry[],
                                          qualifiedNameCache: var ParserQualifiedTextSeqCacheEntry[],
                                          names: var str[]) =
    var out: str[]
    if profileIndex < 0:
        names = out
        return
    if profileIndex >= profiles.len:
        names = out
        return
    var seen: ParserTextLookup
    seen.slots = []
    seen.buckets = []
    seen.totalCount = 0
    let visibleNames = ParserCachedVisibleUnqualifiedExternalCallNames(profiles,
                                                                         profileIndexLookup,
                                                                         profileIndex,
                                                                         visibleNameCache)
    ParserAppendDirectExternalCallNames(out, seen, visibleNames)
    var activeProfileFlags: bool[] = ParserBoolSeqInit(profiles.len, false)
    activeProfileFlags[profileIndex] = true
    ParserCollectExternalCallNamesRecursive(profiles,
                                              profileIndexLookup,
                                              profileIndex,
                                              "",
                                              0,
                                              profiles[profileIndex].maxQualifiedCallDepth,
                                              activeProfileFlags,
                                              visibleNameCache,
                                              qualifiedNameCache,
                                              seen,
                                              out)
    names = out

@borrows
fn ParserLineNeedsContinuation(textRaw: str): bool =
    # 契约: 调用方已 quote-aware 剥过注释 (全部 4 个调用点先过 ParserStripLineComment)。
    # 这里只 trim, 不再二次 quote-blind 剥 '#' — 否则拼入含 '#' 的字符串后
    # 下方 inString 扫描误判为未闭合, 提前停拼 (bail=707 主根的第二卡点)。
    let text = ParserTrimmedSliceRange(textRaw, 0, textRaw.len)
    if text == "":
        return false
    var parenDepth = 0
    var inString = false
    var inChar = false
    var ci = 0
    while ci < Len(text):
        let ch = text[ci]
        if inChar:
            if ch == '\\':
                ci = ci + 2
                continue
            if ch == '\'':
                inChar = false
        elif inString:
            if ch == '\\':
                ci = ci + 2
                continue
            if ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '\'':
            inChar = true
        elif ch == '(' || ch == '[':
            parenDepth = parenDepth + 1
        elif ch == ')' || ch == ']':
            parenDepth = parenDepth - 1
        ci = ci + 1
    if inString || inChar:
        return false
    if parenDepth > 0:
        return true
    # a match-arm header `Label =>` legitimately ends in `>` (the arrow) and owns
    # an indented body suite below it — it is NOT a dangling binary operator that
    # needs the next line joined. Joining it would swallow the arm's suite header
    # (e.g. a nested `match`) into the arm line and drop it as a statement.
    if Len(text) >= 2 && text[Len(text) - 1] == '>' && text[Len(text) - 2] == '=':
        return false
    let lastCh = text[Len(text) - 1]
    # 行尾 `=` 且前一字符是 `!`/`=`/`<`/`>`,构成二元比较 `!=` `==` `<=` `>=`,RHS 在续行。
    # 仅这四个续;裸 `=`(赋值/定义头 `fn F(): T =`,前字符为空格/标识符/`)`)与
    # 增量赋值 `+= -= *= /= %=`(前字符 +-*/%)均不命中,不误续(规避裸 `=` 续行把定义头
    # 与缩进体错误拼接的全树解析灾难)。
    if lastCh == '=' && Len(text) >= 2:
        let prevCh = text[Len(text) - 2]
        if prevCh == '!' || prevCh == '=' || prevCh == '<' || prevCh == '>':
            return true
    # 行尾成员访问点(`root.`, 成员名在续行, WA1 U1/U2 形): 触发续行。判定委托
    # ParserLineEndsWithMemberAccessDot: 排除 Range `..` 尾(B15 域)与浮点
    # 字面量 `1.` 尾; 输入已剥注释, 纯注释句点行剥后为空不触发。
    if ParserLineEndsWithMemberAccessDot(text):
        return true
    if lastCh == '|' || lastCh == '&' || lastCh == '+' || lastCh == '*' ||
       lastCh == '/' || lastCh == ',' || lastCh == '<' || lastCh == '>':
        return true
    return false

# 行尾成员访问点判定: `root.`(成员名在续行)。契约与 ParserLineNeedsContinuation
# 同: 输入已 quote-aware 剥注释。排除两类非成员点尾: Range `..`(倒数第二字符
# 也是 '.', B15 域, 拼入语义保持不变)与浮点字面量尾(`1.`, 点前是数字)。括号
# 未配平('('/'[' 未闭合)时返回 false——该形态由括号深度臂 owns 触发(已覆盖
# J1 形, B17 空白跳过消费), 点臂不改写其粘合, 既有单空格文本逐字节不变。
@borrows
fn ParserLineEndsWithMemberAccessDot(textRaw: str): bool =
    let text = ParserTrimmedSliceRange(textRaw, 0, textRaw.len)
    if Len(text) < 2:
        return false
    if text[Len(text) - 1] != '.':
        return false
    let prevCh = text[Len(text) - 2]
    if prevCh == '.':
        return false
    if prevCh >= '0' && prevCh <= '9':
        return false
    var parenDepth = 0
    var inString = false
    var inChar = false
    var ci = 0
    while ci < Len(text):
        let ch = text[ci]
        if inChar:
            if ch == '\\':
                ci = ci + 2
                continue
            if ch == '\'':
                inChar = false
        elif inString:
            if ch == '\\':
                ci = ci + 2
                continue
            if ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '\'':
            inChar = true
        elif ch == '(' || ch == '[':
            parenDepth = parenDepth + 1
        elif ch == ')' || ch == ']':
            parenDepth = parenDepth - 1
        ci = ci + 1
    if inString || inChar:
        return false
    return parenDepth <= 0

# `//`-aware 剥注释(见 ParserStripLineCommentSlashAware 定义处注释): 这是全编译
# 器唯一的、驱动"下一行是否续接进当前语句"的结构判定主路径(exprLayer/
# NormalizedExprLayer 构建的入口), 与 typed_expr.cheng 已修复的 5 处控制头续行
# 兜底消费点同族, 且是更早生效、遮蔽那 5 处兜底的主路径本身(w15-ctrlhdr 案卷已
# 定位)。旧版只认 '#' 剥注释: 纯 '//' 续行/尾注释剥不掉、原样当代码文本参与
# "是否需要续行"判定与被拼接的续行文本本身, 会把注释内容误判成语句的一部分或
# 让续行提前/延后截断。
#
# 第二处配套修复(单纯换剥注释函数不够, 实测验证才发现): 续行扫描中途撞上一条
# "剥注释后变空"的行时, 必须区分"原始行本就是空白行"(=真正的段落边界, 终止续
# 行, 既有语义不变)与"原始行是纯 `//`/`#` 注释行"(=只是插了一行注释, 不是语句
# 边界, 应跳过继续向后找真正的续行内容)。旧逻辑对两者一视同仁地 break, 纯注释
# 续行会把整个多行条件拦腰截断(如 `if f(x) &&` 后插一行 `// note` 再接
# `y > 1:`, 续行在注释处提前终止, 真正的 `y > 1:` 永远拼不进来), 与"该不该剥
# `//`"是同一条续行链路上前后相继的两个缺口, 必须一并收口才是完整解, 否则纯
# SlashAware 剥注释本身不产生任何可观测行为差异(mutation 不敏感)。
fn ParserJoinContinuationLineAt(linesRaw: var str[],
                                  lineIndex: int32,
                                  scanOut: var int32): str =
    let borrowedLine = linesRaw[lineIndex]
    var parts: str[]
    add(parts, share(borrowedLine))
    scanOut = lineIndex + 1
    if !ParserHasNonTrimChar(borrowedLine) ||
       !ParserLineNeedsContinuation(
           ParserStripLineCommentSlashAware(borrowedLine)):
        return strutil.Join(parts, " ")
    var scan = lineIndex + 1
    while scan < linesRaw.len &&
          ParserLineNeedsContinuation(
              ParserStripLineCommentSlashAware(
                  parts[parts.len - 1])):
        if !ParserHasNonTrimChar(linesRaw[scan]):
            break
        let contTrim =
            ParserTrimmedLineWithoutCommentQuoteAwareSlashAware(
                linesRaw[scan])
        if contTrim == "":
            scan = scan + 1
            continue
        add(parts, contTrim)
        scan = scan + 1
    scanOut = scan
    # 点边界无空格粘合: 成员点尾触发的续行与单行书写形逐字节同(`a.`+`b` →
    # `a.b`), 下游全部文本/节点消费点(qualified call head、字段路径、赋值
    # LHS 元数据、节点构建器)按既有单行形解析, 无需各自加空白跳过。括号
    # 深度臂/二元臂边界维持既有单空格粘合(J1 形文本逐字节不变)。
    var joined = parts[0]
    var partIndex = 1
    while partIndex < parts.len:
        if ParserLineEndsWithMemberAccessDot(
               ParserStripLineCommentSlashAware(parts[partIndex - 1])):
            joined = ParserConcat2(joined, parts[partIndex])
        else:
            joined = ParserConcat3(joined, " ", parts[partIndex])
        partIndex = partIndex + 1
    return joined

# 点邻空白挤压: 删除紧邻 `.` 的空格(quote-aware, 字符串/字符字面量内
# 不动)。assign LHS 规范化专用: 点尾续行 join 的空格粘合形(`a. v`)与
# 无空格粘合形(`a.v`)统一为单行书写形, 下游 LHS 文本消费点(字段路径
# 元数据、lvalue 构建、后端 assignFieldName 再推导)全部按单行形解析。
@borrows
fn ParserSqueezeDotAdjacentSpace(textRaw: str): str =
    let text = ParserTrimmedSliceRange(textRaw, 0, textRaw.len)
    if ParserFindText(text, ". ") < 0 && ParserFindText(text, " .") < 0:
        return text
    var out = ""
    var inString = false
    var inChar = false
    var ci = 0
    while ci < text.len:
        let ch = text[ci]
        if inChar:
            if ch == '\\':
                ci = ci + 2
                continue
            if ch == '\'':
                inChar = false
        elif inString:
            if ch == '\\':
                ci = ci + 2
                continue
            if ch == '"':
                inString = false
        elif ch == '"':
            inString = true
        elif ch == '\'':
            inChar = true
        elif ch == ' ':
            let drop = (ci > 0 && text[ci - 1] == '.') ||
                       (ci + 1 < text.len && text[ci + 1] == '.')
            if !drop:
                out = ParserConcat2(out,
                    ParserTextSliceCopy(text, ci, 1))
            ci = ci + 1
            continue
        out = ParserConcat2(out, ParserTextSliceCopy(text, ci, 1))
        ci = ci + 1
    return out

fn ParserJoinContinuationLines(linesRaw: var str[]): str[] =
    var out: str[]
    var skipUntil = -1
    for i in 0..<linesRaw.len:
        if i < skipUntil:
            add(out, "")
            continue
        var scan: int32
        let line = ParserJoinContinuationLineAt(
            linesRaw, i, scan)
        if scan > i + 1:
            skipUntil = scan
        add(out, line)
    return out

# 同 ParserJoinContinuationLines 的 `//`-aware + 注释行跳过收口, In-place 镜像
# 变体(两处调用点均已实测有独立消费者, 需同步)。
fn ParserJoinContinuationLinesInPlace(linesRaw: var str[]) =
    var skipUntil = -1
    for i in 0..<linesRaw.len:
        if i < skipUntil:
            linesRaw[i] = ""
            continue
        var scan: int32
        let line = ParserJoinContinuationLineAt(
            linesRaw, i, scan)
        if scan > i + 1:
            skipUntil = scan
        linesRaw[i] = line

@borrows
fn ParserStructuredKeywordHasStatementBoundary(lineRaw: str,
                                                 tokenStart: int32,
                                                 rangeStart: int32): bool =
    let prevPos = ParserPreviousNonSpaceCharPos(lineRaw, tokenStart)
    if prevPos < rangeStart:
        return true
    let prev = lineRaw[prevPos]
    if prev == ':' || prev == ';' || prev == '=':
        return true
    return prev == '>' && prevPos > rangeStart && lineRaw[prevPos - 1] == '='

@borrows
fn ParserFindStructuredStatementKeyword(lineRaw: str,
                                          keyword: str,
                                          searchStartRaw: int32): int32 =
    var searchStart = searchStartRaw
    if searchStart < 0:
        searchStart = 0
    var i = searchStart
    var inString = false
    var inChar = false
    while i < lineRaw.len:
        let ch = lineRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
            i = i + 1
            continue
        if !inString && ch == '\'' && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
            i = i + 1
            continue
        if inString || inChar:
            i = i + 1
            continue
        if !ParserIsIdentChar(ch):
            i = i + 1
            continue
        if i > 0 && ParserIsIdentChar(lineRaw[i - 1]):
            i = i + 1
            continue
        var stop = i + 1
        while stop < lineRaw.len && ParserIsIdentChar(lineRaw[stop]):
            stop = stop + 1
        if stop - i == keyword.len &&
           ParserTextRangeEquals(lineRaw, i, keyword.len, keyword) &&
           ParserStructuredKeywordHasStatementBoundary(lineRaw, i, searchStart):
            return i
        i = stop
    return -1

@borrows
fn ParserDeferForbiddenControl(lineRaw: str,
                                rangeStartRaw: int32,
                                rangeStopRaw: int32,
                                keywordOut: var str,
                                columnOut: var int32): bool =
    var rangeStart = rangeStartRaw
    if rangeStart < 0:
        rangeStart = 0
    var rangeStop = rangeStopRaw
    if rangeStop > lineRaw.len:
        rangeStop = lineRaw.len
    var i = rangeStart
    var inString = false
    var inChar = false
    while i < rangeStop:
        let ch = lineRaw[i]
        if !inChar && ch == '"' && !ParserQuoteIsEscaped(lineRaw, i):
            inString = !inString
            i = i + 1
            continue
        if !inString && ch == '\'' && !ParserQuoteIsEscaped(lineRaw, i):
            inChar = !inChar
            i = i + 1
            continue
        if inString || inChar:
            i = i + 1
            continue
        if !ParserIsIdentChar(ch):
            i = i + 1
            continue
        if i > rangeStart && ParserIsIdentChar(lineRaw[i - 1]):
            i = i + 1
            continue
        var stop = i + 1
        while stop < rangeStop && ParserIsIdentChar(lineRaw[stop]):
            stop = stop + 1
        let token = ParserTextSliceCopy(lineRaw, i, stop - i)
        var forbidden = token == "await"
        if token == "return" || token == "yield" || token == "break" ||
           token == "continue" || token == "defer":
            forbidden = ParserStructuredKeywordHasStatementBoundary(lineRaw, i, rangeStart)
        if forbidden:
            keywordOut = token
            columnOut = i + 1
            return true
        i = stop
    keywordOut = ""
    columnOut = -1
    return false

@borrows
fn parserLineOpensIndentedSuiteMode(lineRaw: str,
                                    migrationSourceSyntax: bool): bool =
    var start: int32
    var stop: int32
    if !ParserTrimmedCommentRangeSlashAware(lineRaw, start, stop):
        return false
    let last = lineRaw[stop - 1]
    if last == '=':
        let signatureEq = ParserFindTopLevelAssignmentEq(lineRaw)
        if signatureEq != stop - 1:
            return false
        if ParserLineRangeStartsWithStatementKeyword(lineRaw, start, stop, "fn") ||
           ParserLineRangeStartsWithStatementKeyword(lineRaw, start, stop, "iterator"):
            return true
        if ParserLineRangeStartsWithStatementKeyword(lineRaw, start, stop, "async"):
            let fnStart = ParserSkipInlineSpaces(lineRaw, start + Len("async"))
            return ParserLineRangeStartsWithStatementKeyword(lineRaw, fnStart, stop, "fn")
        return false
    var seed: ParserStructuredStatementSeed
    var delimiterPos: int32
    var inlineBodyStart: int32
    if last == ':' &&
       parserReadControlStmtSeedRangeMode(1,
                                           lineRaw,
                                           -1,
                                           migrationSourceSyntax,
                                           seed,
                                           delimiterPos,
                                           inlineBodyStart):
        return inlineBodyStart < 0
    if (last == ':' || last == '{' ||
        (last == '>' && stop - 2 >= start && lineRaw[stop - 2] == '=')) &&
       ParserReadMatchStmtSeedRange(1,
                                     lineRaw,
                                     -1,
                                     seed,
                                     delimiterPos,
                                     inlineBodyStart):
        return inlineBodyStart < 0
    if last != ':':
        return false
    let deferStart = ParserFindStructuredStatementKeyword(lineRaw, "defer", start)
    if deferStart < 0:
        return false
    var cursor = ParserSkipInlineSpaces(lineRaw, deferStart + Len("defer"))
    if cursor >= stop || lineRaw[cursor] != ':':
        return false
    cursor = ParserSkipInlineSpaces(lineRaw, cursor + 1)
    return cursor >= stop

@borrows
fn ParserLineOpensIndentedSuite(lineRaw: str): bool =
    return parserLineOpensIndentedSuiteMode(lineRaw, false)

fn ParserScopeSetEnd(layer: var NormalizedExprLayer,
                      scopeId: int32,
                      lineNumber: int32,
                      endColumnNumber: int32) =
    if scopeId < 0 || scopeId >= layer.scopes.len:
        return
    var scope = layer.scopes[scopeId]
    scope.endLineNumber = lineNumber
    scope.endColumnNumber = endColumnNumber
    layer.scopes[scopeId] = scope

fn ParserScopePropagateEnd(layer: var NormalizedExprLayer,
                            childScopeId: int32,
                            parentScopeId: int32) =
    if childScopeId < 0 || childScopeId >= layer.scopes.len ||
       parentScopeId < 0 || parentScopeId >= layer.scopes.len:
        return
    let child = layer.scopes[childScopeId]
    ParserScopeSetEnd(layer,
                       parentScopeId,
                       child.endLineNumber,
                       child.endColumnNumber)

@borrows
fn ParserScopeAppendChild(layer: var NormalizedExprLayer,
                           sourcePath: str,
                           parentScopeId: int32,
                           kind: NormalizedScopeKind,
                           ownerStatementOrdinal: int32,
                           indentColumn: int32,
                           startLineNumber: int32,
                           startColumnNumber: int32,
                           endLineNumber: int32,
                           endColumnNumber: int32,
                           scopeChildCounts: var int32[]): int32 =
    var lexicalOrdinal: int32
    if parentScopeId >= 0 && parentScopeId < scopeChildCounts.len:
        lexicalOrdinal = scopeChildCounts[parentScopeId]
        scopeChildCounts[parentScopeId] = lexicalOrdinal + 1
    let scopeId = NormalizedExprLayerAppendScope(layer,
                                                   sourcePath,
                                                   parentScopeId,
                                                   kind,
                                                   ownerStatementOrdinal,
                                                   lexicalOrdinal,
                                                   indentColumn,
                                                   startLineNumber,
                                                   startColumnNumber,
                                                   endLineNumber,
                                                   endColumnNumber)
    add(scopeChildCounts, 0)
    return scopeId

@borrows
fn ParserFunctionSuiteHeaderOwnersBuild(
        tree: ParserValueExprTree,
        lineCount: int32,
        declarationRows: var int32[],
        lexicalScopeRows: var int32[],
        err: var str): bool =
    setLen(declarationRows, lineCount)
    setLen(lexicalScopeRows, lineCount)
    for lineIndex in 0..<lineCount:
        declarationRows[lineIndex] = -1
        lexicalScopeRows[lineIndex] = -1
    # The text-only compatibility builder has no parser tree and therefore
    # cannot mint declaration identity. Production layers always carry the
    # active parser owner and take the exact path below.
    if tree == nil:
        err = ""
        return true
    if tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.producerSourceCount != 1:
        err = "parser function suite owner tree unavailable"
        return false
    for declarationRow in 0..<tree.declarationCount:
        if ParserDeclarationKind(arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               declarationRow)) != ParserDeclarationFunction:
            continue
        let suiteScopeRow = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationSuiteLexicalScopeRows,
            declarationRow)
        # Bodiless @importc declarations own no normalized suite.
        if suiteScopeRow < 0:
            continue
        let nameTokenIndex = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationNameTokenIndexes,
            declarationRow)
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationProducerSourceIndexes,
            declarationRow)
        if nameTokenIndex < 0 || nameTokenIndex >= tree.tokenCount ||
           producerSourceIndex != 0 ||
           ParserValueExprTokenProducerSourceIndexAt(
               tree, nameTokenIndex) != producerSourceIndex ||
           suiteScopeRow >= tree.declarationLexicalScopeCount ||
           ParserDeclarationLexicalScopeKind(
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationLexicalScopeKinds,
                   suiteScopeRow)) !=
               ParserDeclarationLexicalScopeFunction ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeOwnerDeclarationRows,
               suiteScopeRow) != declarationRow:
            err = "parser function suite owner identity invalid"
            return false
        let lineIndex = ParserValueExprTokenLineAt(
            tree, nameTokenIndex) - 1
        if lineIndex < 0 || lineIndex >= lineCount ||
           declarationRows[lineIndex] >= 0:
            err = "parser function suite header identity ambiguous"
            return false
        declarationRows[lineIndex] = declarationRow
        lexicalScopeRows[lineIndex] = suiteScopeRow
    err = ""
    return true

@borrows
fn ParserBuildLexicalScopeFacts(sourcePath: str,
                                 lines: var str[],
                                 layer: var NormalizedExprLayer,
                                 lineScopeIds: var int32[],
                                 lineIndents: var int32[],
                                 lineInlineLexicalScopeIds: var int32[],
                                 lineInlineSuiteScopeIds: var int32[],
                                 lineInlineNestedSuiteScopeIds: var int32[],
                                 lineInlineDeferLexicalScopeIds: var int32[],
                                 lineInlineDeferSuiteScopeIds: var int32[],
                                 scopeChildCounts: var int32[],
                                 lineVisitCount: var int64,
                                 err: var str): bool =
    lineVisitCount = 0
    let migrationSourceSyntax =
        layer.valueExprTree != nil &&
        layer.valueExprTree.migrationSourceSyntax
    var functionHeaderDeclarationRows: int32[]
    var functionHeaderLexicalScopeRows: int32[]
    if !ParserFunctionSuiteHeaderOwnersBuild(
            layer.valueExprTree,
            lines.len,
            functionHeaderDeclarationRows,
            functionHeaderLexicalScopeRows,
            err):
        return false
    var workLayer: NormalizedExprLayer
    workLayer.valueExprTree = layer.valueExprTree
    workLayer.valueExprTreeBorrowLease = true
    var newScopeChildCounts: int32[]
    setLen(lineScopeIds, lines.len)
    setLen(lineIndents, lines.len)
    for i in 0..<lines.len:
        lineScopeIds[i] = -1
        lineIndents[i] = -1
    var rootEndLine: int32 = 1
    var rootEndColumn: int32 = 1
    if lines.len > 0:
        rootEndLine = lines.len
        rootEndColumn = lines[lines.len - 1].len
        if rootEndColumn <= 0:
            rootEndColumn = 1
    let rootScopeId = NormalizedExprLayerAppendScope(workLayer,
                                                       sourcePath,
                                                       -1,
                                                       NormalizedScopeRoot,
                                                       -1,
                                                       0,
                                                       1,
                                                       1,
                                                       1,
                                                       rootEndLine,
                                                       rootEndColumn)
    add(newScopeChildCounts, 0)
    var scopeStack: int32[]
    var indentStack: int32[]
    add(scopeStack, rootScopeId)
    add(indentStack, 0)
    var pendingSuiteOpen = false
    var pendingSuiteParentScopeId = -1
    var pendingSuiteHeaderIndent: int32
    var pendingSuiteOwnerDeclarationRow: int32 = -1
    var pendingSuiteOwnerLexicalScopeRow: int32 = -1
    for i in 0..<lines.len:
        lineVisitCount = lineVisitCount + 1
        # str[] element reads are Borrowed views (spec 0.2.1); `line`
        # flows into non-var formals below, so materialize an owned copy.
        let line = strings.CloneStr(lines[i])
        if !ParserHasNonTrimChar(line):
            continue
        let indent = ParserLineIndent(line)
        lineIndents[i] = indent
        while indentStack.len > 1 && indent < indentStack[indentStack.len - 1]:
            ParserScopePropagateEnd(workLayer,
                                     scopeStack[scopeStack.len - 1],
                                     scopeStack[scopeStack.len - 2])
            setLen(indentStack, indentStack.len - 1)
            setLen(scopeStack, scopeStack.len - 1)
        if indent > indentStack[indentStack.len - 1]:
            let parentScopeId = scopeStack[scopeStack.len - 1]
            if pendingSuiteOpen &&
               pendingSuiteParentScopeId == parentScopeId &&
               indent > pendingSuiteHeaderIndent:
                let scopeId = ParserScopeAppendChild(workLayer,
                                                       sourcePath,
                                                       parentScopeId,
                                                       NormalizedScopeIndentedSuite,
                                                       -1,
                                                       indent + 1,
                                                       i + 1,
                                                       indent + 1,
                                                       i + 1,
                                                       line.len,
                                                       newScopeChildCounts)
                if (pendingSuiteOwnerDeclarationRow < 0) !=
                       (pendingSuiteOwnerLexicalScopeRow < 0):
                    panic("parser function suite owner columns split")
                if pendingSuiteOwnerDeclarationRow >= 0:
                    var scope = workLayer.scopes[scopeId]
                    scope.ownerDeclarationRow =
                        pendingSuiteOwnerDeclarationRow
                    scope.moduleRootAnchor = false
                    workLayer.scopes[scopeId] = scope
                add(scopeStack, scopeId)
                add(indentStack, indent)
        lineScopeIds[i] = scopeStack[scopeStack.len - 1]
        ParserScopeSetEnd(workLayer,
                           scopeStack[scopeStack.len - 1],
                           i + 1,
                           line.len)
        pendingSuiteOpen = parserLineOpensIndentedSuiteMode(
            line,
            migrationSourceSyntax)
        pendingSuiteParentScopeId = lineScopeIds[i]
        pendingSuiteHeaderIndent = indent
        pendingSuiteOwnerDeclarationRow = -1
        pendingSuiteOwnerLexicalScopeRow = -1
        if pendingSuiteOpen &&
           functionHeaderDeclarationRows[i] >= 0:
            pendingSuiteOwnerDeclarationRow =
                functionHeaderDeclarationRows[i]
            pendingSuiteOwnerLexicalScopeRow =
                functionHeaderLexicalScopeRows[i]
        # Inline suite scopes (single-line `if cond: action` bodies, inline
        # defer suites and their lexical scopes) must be allocated here, in
        # line walk order, so source scope ids stay monotonic with function
        # span order (structured source domain contract). The statement seed
        # finalization pass only binds owner statement ordinals onto these
        # pre-allocated scopes; it never appends scopes anymore.
        var inlineSeed: ParserStructuredStatementSeed
        var inlineDelimiterPos: int32
        var inlineBodyStart: int32
        var hasInlineSuiteStatement = parserReadControlStmtSeedRangeMode(
            i + 1,
            line,
            -1,
            migrationSourceSyntax,
            inlineSeed,
            inlineDelimiterPos,
            inlineBodyStart)
        if !hasInlineSuiteStatement:
            hasInlineSuiteStatement = ParserReadMatchStmtSeedRange(i + 1,
                                                                    line,
                                                                    -1,
                                                                    inlineSeed,
                                                                    inlineDelimiterPos,
                                                                    inlineBodyStart)
        if hasInlineSuiteStatement:
            # Stored for every matched suite statement: this returns the
            # line's physical scope (no allocation) unless the statement
            # sits past the first code column (one-line fn header shift).
            let inlineLexicalScopeId = ParserStructuredInlineLexicalScope(
                sourcePath,
                line,
                i,
                inlineSeed.columnNumber - 1,
                lineScopeIds[i],
                workLayer,
                newScopeChildCounts)
            lineInlineLexicalScopeIds[i] = inlineLexicalScopeId
            if inlineBodyStart >= 0:
                lineInlineSuiteScopeIds[i] = ParserScopeAppendChild(
                    workLayer,
                    sourcePath,
                    inlineLexicalScopeId,
                    NormalizedScopeInlineSuite,
                    -1,
                    inlineBodyStart + 1,
                    i + 1,
                    inlineBodyStart + 1,
                    i + 1,
                    line.len,
                    newScopeChildCounts)
        let deferStartPos = ParserFindStructuredStatementKeyword(
            line, "defer", 0)
        if deferStartPos >= 0:
            var deferCursor = ParserSkipInlineSpaces(
                line, deferStartPos + Len("defer"))
            if deferCursor < line.len && line[deferCursor] == ':':
                deferCursor = ParserSkipInlineSpaces(line, deferCursor + 1)
                var deferLexicalScopeId: int32 = -1
                if hasInlineSuiteStatement && inlineBodyStart >= 0 &&
                   deferStartPos >= inlineBodyStart:
                    deferLexicalScopeId = lineInlineSuiteScopeIds[i]
                if deferLexicalScopeId < 0:
                    deferLexicalScopeId = ParserStructuredInlineLexicalScope(
                        sourcePath,
                        line,
                        i,
                        deferStartPos,
                        lineScopeIds[i],
                        workLayer,
                        newScopeChildCounts)
                lineInlineDeferLexicalScopeIds[i] = deferLexicalScopeId
                if deferCursor < line.len:
                    lineInlineDeferSuiteScopeIds[i] = ParserScopeAppendChild(
                        workLayer,
                        sourcePath,
                        deferLexicalScopeId,
                        NormalizedScopeDeferSuite,
                        -1,
                        deferCursor + 1,
                        i + 1,
                        deferCursor + 1,
                        i + 1,
                        line.len,
                        newScopeChildCounts)
                    var nestedSeed: ParserStructuredStatementSeed
                    var nestedDelimiterPos: int32
                    var nestedBodyStart: int32
                    var hasNestedSuiteStatement = parserReadControlStmtSeedRangeMode(
                        i + 1,
                        line,
                        deferCursor,
                        migrationSourceSyntax,
                        nestedSeed,
                        nestedDelimiterPos,
                        nestedBodyStart)
                    if !hasNestedSuiteStatement:
                        hasNestedSuiteStatement = ParserReadMatchStmtSeedRange(
                            i + 1,
                            line,
                            deferCursor,
                            nestedSeed,
                            nestedDelimiterPos,
                            nestedBodyStart)
                    if hasNestedSuiteStatement && nestedBodyStart >= 0:
                        lineInlineNestedSuiteScopeIds[i] = ParserScopeAppendChild(
                            workLayer,
                            sourcePath,
                            deferLexicalScopeId,
                            NormalizedScopeInlineSuite,
                            -1,
                            nestedBodyStart + 1,
                            i + 1,
                            nestedBodyStart + 1,
                            i + 1,
                            line.len,
                            newScopeChildCounts)
    while scopeStack.len > 1:
        ParserScopePropagateEnd(workLayer,
                                 scopeStack[scopeStack.len - 1],
                                 scopeStack[scopeStack.len - 2])
        setLen(indentStack, indentStack.len - 1)
        setLen(scopeStack, scopeStack.len - 1)
    layer.scopes = workLayer.scopes
    workLayer.scopes = []
    workLayer.valueExprTree = nil
    workLayer.valueExprTreeBorrowLease = false
    scopeChildCounts = newScopeChildCounts
    err = ""
    return true

fn ParserNextLexicalStatementOrdinal(scopeStatementCounts: var int32[],
                                      scopeId: int32): int32 =
    while scopeStatementCounts.len <= scopeId:
        add(scopeStatementCounts, 0)
    let ordinal = scopeStatementCounts[scopeId]
    scopeStatementCounts[scopeId] = ordinal + 1
    return ordinal

fn ParserScopeMarkDeferSuite(layer: var NormalizedExprLayer,
                              scopeId: int32,
                              parentScopeId: int32,
                              ownerStatementOrdinal: int32,
                              indentColumn: int32,
                              startLineNumber: int32,
                              startColumnNumber: int32,
                              endLineNumber: int32,
                              endColumnNumber: int32) =
    if scopeId < 0 || scopeId >= layer.scopes.len:
        return
    var scope = layer.scopes[scopeId]
    scope.parentScopeId = parentScopeId
    scope.kind = NormalizedScopeDeferSuite
    scope.ownerStatementOrdinal = ownerStatementOrdinal
    scope.indentColumn = indentColumn
    scope.startLineNumber = startLineNumber
    scope.startColumnNumber = startColumnNumber
    scope.endLineNumber = endLineNumber
    scope.endColumnNumber = endColumnNumber
    layer.scopes[scopeId] = scope

@borrows
fn ParserValidateDeferBlockSuite(sourcePath: str,
                                  lines: var str[],
                                  headerLineIndex: int32,
                                  headerIndent: int32,
                                  migrationSourceSyntax: bool,
                                  firstBodyLineOut: var int32,
                                  lastBodyLineOut: var int32,
                                  err: var str): bool =
    var firstBodyLine = headerLineIndex + 1
    while firstBodyLine < lines.len && !ParserHasNonTrimChar(lines[firstBodyLine]):
        firstBodyLine = firstBodyLine + 1
    if firstBodyLine >= lines.len:
        err = Fmt"defer suite is empty at {sourcePath}:{headerLineIndex + 1}"
        return false
    let bodyIndent = ParserLineIndent(lines[firstBodyLine])
    if bodyIndent <= headerIndent:
        err = Fmt"defer suite requires an indented body at {sourcePath}:{firstBodyLine + 1}"
        return false
    var indentStack: int32[]
    add(indentStack, bodyIndent)
    var scan = firstBodyLine
    var lastBodyLine = firstBodyLine
    var previousOpensSuite = false
    while scan < lines.len:
        # str[] element reads are Borrowed views (spec 0.2.1); `line`
        # flows into non-var formals below (parserLineOpensIndentedSuiteMode,
        # ParserDeferForbiddenControl), so materialize an owned copy.
        let line = strings.CloneStr(lines[scan])
        if !ParserHasNonTrimChar(line):
            scan = scan + 1
            continue
        let indent = ParserLineIndent(line)
        if indent <= headerIndent:
            break
        if indent < bodyIndent:
            err = Fmt"defer suite indentation is invalid at {sourcePath}:{scan + 1}"
            return false
        let activeIndent = indentStack[indentStack.len - 1]
        if indent > activeIndent:
            if previousOpensSuite:
                add(indentStack, indent)
        elif indent < activeIndent:
            while indentStack.len > 1 && indent < indentStack[indentStack.len - 1]:
                setLen(indentStack, indentStack.len - 1)
            if indent != indentStack[indentStack.len - 1]:
                err = Fmt"defer suite indentation is invalid at {sourcePath}:{scan + 1}"
                return false
        var forbiddenKeyword = ""
        var forbiddenColumn: int32
        if ParserDeferForbiddenControl(line,
                                        indent,
                                        line.len,
                                        forbiddenKeyword,
                                        forbiddenColumn):
            err = Fmt"defer suite forbids '{forbiddenKeyword}' at {sourcePath}:{scan + 1}:{forbiddenColumn}"
            return false
        previousOpensSuite = parserLineOpensIndentedSuiteMode(
            line,
            migrationSourceSyntax)
        lastBodyLine = scan
        scan = scan + 1
    firstBodyLineOut = firstBodyLine
    lastBodyLineOut = lastBodyLine
    err = ""
    return true

@borrows
fn ParserStructuredInlineLexicalScope(sourcePath: str,
                                       lineRaw: str,
                                       lineIndex: int32,
                                       tokenStart: int32,
                                       physicalScopeId: int32,
                                       layer: var NormalizedExprLayer,
                                       scopeChildCounts: var int32[]): int32 =
    let firstCodeColumn = ParserLineIndent(lineRaw)
    if tokenStart <= firstCodeColumn:
        return physicalScopeId
    return ParserScopeAppendChild(layer,
                                    sourcePath,
                                    physicalScopeId,
                                    NormalizedScopeInlineSuite,
                                    -1,
                                    tokenStart + 1,
                                    lineIndex + 1,
                                    tokenStart + 1,
                                    lineIndex + 1,
                                    lineRaw.len,
                                    scopeChildCounts)

fn ParserScopeSetOwnerStatementOrdinal(layer: var NormalizedExprLayer,
                                         scopeId: int32,
                                         ownerStatementOrdinal: int32) =
    if scopeId < 0 || scopeId >= layer.scopes.len:
        return
    var scope = layer.scopes[scopeId]
    scope.ownerStatementOrdinal = ownerStatementOrdinal
    layer.scopes[scopeId] = scope

@borrows
fn ParserStructuredStatementSeedClone(seed: ParserStructuredStatementSeed): ParserStructuredStatementSeed =
    var out: ParserStructuredStatementSeed
    out.lineIndex = seed.lineIndex
    out.lineNumber = seed.lineNumber
    out.columnNumber = seed.columnNumber
    out.endLineNumber = seed.endLineNumber
    out.endColumnNumber = seed.endColumnNumber
    out.kind = seed.kind
    let surfaceText = seed.surfaceText
    out.surfaceText = share(surfaceText)
    out.lexicalScopeId = seed.lexicalScopeId
    out.suiteScopeId = seed.suiteScopeId
    out.statementOrdinal = seed.statementOrdinal
    out.lexicalOrdinal = seed.lexicalOrdinal
    out.deferOwnerStatementOrdinal = seed.deferOwnerStatementOrdinal
    out.anchorTokenIndex = seed.anchorTokenIndex
    out.spanStart = seed.spanStart
    out.spanEnd = seed.spanEnd
    return out

fn ParserStructuredStatementSeedFreezeAnchor(
        layer: var NormalizedExprLayer,
        seed: var ParserStructuredStatementSeed,
        err: var str): bool =
    let tree = layer.valueExprTree
    if tree == nil ||
       tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.producerSourceCount != 1:
        err = "structured statement parser anchor owner missing"
        return false
    var anchorTokenIndex = -1
    for tokenIndex in 0..<tree.tokenCount:
        if ParserValueExprTokenProducerSourceIndexAt(tree, tokenIndex) != 0 ||
           ParserValueExprTokenLineAt(tree, tokenIndex) != seed.lineNumber ||
           ParserValueExprTokenColumnAt(tree, tokenIndex) !=
               seed.columnNumber:
            continue
        if anchorTokenIndex >= 0:
            err = "structured statement parser anchor ambiguous"
            return false
        anchorTokenIndex = tokenIndex
    if anchorTokenIndex < 0:
        err = "structured statement parser anchor missing"
        return false
    seed.anchorTokenIndex = anchorTokenIndex
    seed.spanStart =
        ParserValueExprTokenStartAt(tree, anchorTokenIndex)
    seed.spanEnd =
        ParserValueExprTokenEndAt(tree, anchorTokenIndex)
    err = ""
    return true

@borrows
fn ParserFinalizeSuiteStatementSeed(sourcePath: str,
                                      codeLines: var str[],
                                      lineScopeIds: var int32[],
                                      lineIndex: int32,
                                      inlineSuiteBodyStart: int32,
                                      lexicalScopeOverride: int32,
                                      preAllocatedLexicalScopeId: int32,
                                      preAllocatedSuiteScopeId: int32,
                                      layer: var NormalizedExprLayer,
                                      scopeChildCounts: var int32[],
                                      scopeStatementCounts: var int32[],
                                      seeds: var ParserStructuredStatementSeed[],
                                      seed: var ParserStructuredStatementSeed,
                                      err: var str): bool =
    var lexicalScopeId = lexicalScopeOverride
    if lexicalScopeId < 0:
        if preAllocatedLexicalScopeId < 0:
            panic("parser inline lexical scope was not preallocated in line order")
        lexicalScopeId = preAllocatedLexicalScopeId
    let statementOrdinal = seeds.len
    let lexicalOrdinal = ParserNextLexicalStatementOrdinal(scopeStatementCounts,
                                                              lexicalScopeId)
    var suiteScopeId = -1
    if inlineSuiteBodyStart >= 0:
        if preAllocatedSuiteScopeId < 0:
            panic("parser inline suite scope was not preallocated in line order")
        suiteScopeId = preAllocatedSuiteScopeId
        ParserScopeSetOwnerStatementOrdinal(layer,
                                              suiteScopeId,
                                              statementOrdinal)
    else:
        var firstBodyLine = lineIndex + 1
        while firstBodyLine < codeLines.len && !ParserHasNonTrimChar(codeLines[firstBodyLine]):
            firstBodyLine = firstBodyLine + 1
        if firstBodyLine < codeLines.len &&
           ParserLineIndent(codeLines[firstBodyLine]) > ParserLineIndent(codeLines[lineIndex]):
            suiteScopeId = lineScopeIds[firstBodyLine]
        if suiteScopeId < 0 || suiteScopeId >= layer.scopes.len ||
           layer.scopes[suiteScopeId].parentScopeId != lexicalScopeId:
            err = Fmt"statement suite scope is missing at {sourcePath}:{lineIndex + 1}:{seed.columnNumber}"
            return false
        ParserScopeSetOwnerStatementOrdinal(layer, suiteScopeId, statementOrdinal)
    seed.lexicalScopeId = lexicalScopeId
    seed.suiteScopeId = suiteScopeId
    seed.statementOrdinal = statementOrdinal
    seed.lexicalOrdinal = lexicalOrdinal
    if !ParserStructuredStatementSeedFreezeAnchor(
            layer, seed, err):
        return false
    let storedSeed = ParserStructuredStatementSeedClone(seed)
    add(seeds, storedSeed)
    err = ""
    return true

@borrows
fn ParserAppendBreakContinueSeeds(sourcePath: str,
                                   lineRaw: str,
                                   lineIndex: int32,
                                   physicalScopeId: int32,
                                   inlineSuiteBodyStart: int32,
                                   inlineSuiteScopeId: int32,
                                   layer: var NormalizedExprLayer,
                                   scopeChildCounts: var int32[],
                                   scopeStatementCounts: var int32[],
                                   seeds: var ParserStructuredStatementSeed[],
                                   err: var str): bool =
    var searchStart: int32
    while searchStart < lineRaw.len:
        let breakPos = ParserFindStructuredStatementKeyword(lineRaw, "break", searchStart)
        let continuePos = ParserFindStructuredStatementKeyword(lineRaw, "continue", searchStart)
        var tokenStart = -1
        var kind = NormalizedExprBreakStmt
        var tokenLength: int32 = 5
        if breakPos >= 0 && (continuePos < 0 || breakPos < continuePos):
            tokenStart = breakPos
        elif continuePos >= 0:
            tokenStart = continuePos
            kind = NormalizedExprContinueStmt
            tokenLength = 8
        if tokenStart < 0:
            err = ""
            return true
        var lexicalScopeId = -1
        if inlineSuiteBodyStart >= 0 && tokenStart >= inlineSuiteBodyStart:
            lexicalScopeId = inlineSuiteScopeId
        if lexicalScopeId < 0:
            lexicalScopeId = ParserStructuredInlineLexicalScope(sourcePath,
                                                                  lineRaw,
                                                                  lineIndex,
                                                                  tokenStart,
                                                                  physicalScopeId,
                                                                  layer,
                                                                  scopeChildCounts)
        var seed: ParserStructuredStatementSeed
        seed.lineIndex = lineIndex
        seed.lineNumber = lineIndex + 1
        seed.columnNumber = tokenStart + 1
        seed.endLineNumber = lineIndex + 1
        seed.endColumnNumber = tokenStart + tokenLength
        seed.kind = kind
        if kind == NormalizedExprBreakStmt:
            seed.surfaceText = "break"
        else:
            seed.surfaceText = "continue"
        seed.lexicalScopeId = lexicalScopeId
        seed.suiteScopeId = -1
        seed.statementOrdinal = seeds.len
        seed.lexicalOrdinal = ParserNextLexicalStatementOrdinal(scopeStatementCounts,
                                                                  lexicalScopeId)
        seed.deferOwnerStatementOrdinal = -1
        if !ParserStructuredStatementSeedFreezeAnchor(
                layer, seed, err):
            return false
        add(seeds, seed)
        searchStart = tokenStart + tokenLength
    err = ""
    return true

@borrows
fn ParserBuildStructuredStatementFacts(sourcePath: str,
                                         codeLines: var str[],
                                         layer: var NormalizedExprLayer,
                                         seeds: var ParserStructuredStatementSeed[],
                                         lineScopeIds: var int32[],
                                         lineInlineSuiteBodyColumns: var int32[],
                                         lineInlineSuiteScopeIds: var int32[],
                                         lineDeferOwnerOrdinals: var int32[],
                                         lineInlineDeferBodyColumns: var int32[],
                                         lineInlineDeferSuiteScopeIds: var int32[],
                                         scopeBuildLineVisitCount: var int64,
                                         structuredBuildLineVisitCount: var int64,
                                         err: var str): bool =
    structuredBuildLineVisitCount = 0
    let migrationSourceSyntax =
        layer.valueExprTree != nil &&
        layer.valueExprTree.migrationSourceSyntax
    var lineIndents: int32[]
    var scopeChildCounts: int32[]
    var lineInlineLexicalScopeIds: int32[]
    var lineInlineNestedSuiteScopeIds: int32[]
    var lineInlineDeferLexicalScopeIds: int32[]
    setLen(lineInlineSuiteBodyColumns, codeLines.len)
    setLen(lineInlineSuiteScopeIds, codeLines.len)
    setLen(lineInlineLexicalScopeIds, codeLines.len)
    setLen(lineInlineNestedSuiteScopeIds, codeLines.len)
    setLen(lineDeferOwnerOrdinals, codeLines.len)
    setLen(lineInlineDeferBodyColumns, codeLines.len)
    setLen(lineInlineDeferLexicalScopeIds, codeLines.len)
    setLen(lineInlineDeferSuiteScopeIds, codeLines.len)
    for i in 0..<codeLines.len:
        lineInlineSuiteBodyColumns[i] = -1
        lineInlineSuiteScopeIds[i] = -1
        lineInlineLexicalScopeIds[i] = -1
        lineInlineNestedSuiteScopeIds[i] = -1
        lineDeferOwnerOrdinals[i] = -1
        lineInlineDeferBodyColumns[i] = -1
        lineInlineDeferLexicalScopeIds[i] = -1
        lineInlineDeferSuiteScopeIds[i] = -1
    if !ParserBuildLexicalScopeFacts(sourcePath,
                                      codeLines,
                                      layer,
                                      lineScopeIds,
                                      lineIndents,
                                      lineInlineLexicalScopeIds,
                                      lineInlineSuiteScopeIds,
                                      lineInlineNestedSuiteScopeIds,
                                      lineInlineDeferLexicalScopeIds,
                                      lineInlineDeferSuiteScopeIds,
                                      scopeChildCounts,
                                      scopeBuildLineVisitCount,
                                      err):
        return false
    var scopeStatementCounts: int32[]
    setLen(scopeStatementCounts, layer.scopes.len)
    for i in 0..<codeLines.len:
        structuredBuildLineVisitCount = structuredBuildLineVisitCount + 1
        if !ParserHasNonTrimChar(codeLines[i]):
            continue
        let line = codeLines[i]
        var physicalScopeId: int32
        if i < lineScopeIds.len && lineScopeIds[i] >= 0:
            physicalScopeId = lineScopeIds[i]
        var lineInlineSuiteBodyStart = -1
        var lineInlineSuiteScopeId = -1
        var statementSeed: ParserStructuredStatementSeed
        var suiteDelimiterPos: int32
        var inlineSuiteBodyStart: int32
        var hasSuiteStatement = parserReadControlStmtSeedRangeMode(
            i + 1,
            line,
            -1,
            migrationSourceSyntax,
            statementSeed,
            suiteDelimiterPos,
            inlineSuiteBodyStart)
        if !hasSuiteStatement:
            hasSuiteStatement = ParserReadMatchStmtSeedRange(i + 1,
                                                              line,
                                                              -1,
                                                              statementSeed,
                                                              suiteDelimiterPos,
                                                              inlineSuiteBodyStart)
        if hasSuiteStatement:
            if i < lineDeferOwnerOrdinals.len:
                statementSeed.deferOwnerStatementOrdinal = lineDeferOwnerOrdinals[i]
            if !ParserFinalizeSuiteStatementSeed(sourcePath,
                                                   codeLines,
                                                   lineScopeIds,
                                                   i,
                                                   inlineSuiteBodyStart,
                                                   -1,
                                                   lineInlineLexicalScopeIds[i],
                                                   lineInlineSuiteScopeIds[i],
                                                   layer,
                                                   scopeChildCounts,
                                                   scopeStatementCounts,
                                                   seeds,
                                                   statementSeed,
                                                   err):
                return false
            if inlineSuiteBodyStart >= 0:
                lineInlineSuiteBodyStart = inlineSuiteBodyStart
                lineInlineSuiteScopeId = statementSeed.suiteScopeId
                lineInlineSuiteBodyColumns[i] = inlineSuiteBodyStart + 1
                lineInlineSuiteScopeIds[i] = statementSeed.suiteScopeId
        let deferStart = ParserFindStructuredStatementKeyword(line, "defer", 0)
        if deferStart >= 0:
            var cursor = ParserSkipInlineSpaces(line, deferStart + Len("defer"))
            if cursor >= line.len || line[cursor] != ':':
                err = Fmt"defer syntax requires 'defer: suite' at {sourcePath}:{i + 1}:{deferStart + 1}"
                return false
            let colonPos = cursor
            cursor = ParserSkipInlineSpaces(line, cursor + 1)
            var lexicalScopeId = lineInlineDeferLexicalScopeIds[i]
            if lexicalScopeId < 0:
                panic("parser defer lexical scope was not preallocated in line order")
            let statementOrdinal = seeds.len
            let lexicalOrdinal = ParserNextLexicalStatementOrdinal(scopeStatementCounts,
                                                                      lexicalScopeId)
            var suiteScopeId = -1
            var endLineNumber = i + 1
            var endColumnNumber = colonPos + 1
            if cursor < line.len:
                var forbiddenKeyword = ""
                var forbiddenColumn: int32
                if ParserDeferForbiddenControl(line,
                                                cursor,
                                                line.len,
                                                forbiddenKeyword,
                                                forbiddenColumn):
                    err = Fmt"defer suite forbids '{forbiddenKeyword}' at {sourcePath}:{i + 1}:{forbiddenColumn}"
                    return false
                if lineInlineDeferSuiteScopeIds[i] < 0:
                    panic("parser defer suite scope was not preallocated in line order")
                suiteScopeId = lineInlineDeferSuiteScopeIds[i]
                ParserScopeSetOwnerStatementOrdinal(layer,
                                                      suiteScopeId,
                                                      statementOrdinal)
                endColumnNumber = line.len
                lineDeferOwnerOrdinals[i] = statementOrdinal
                lineInlineDeferBodyColumns[i] = cursor + 1
                lineInlineDeferSuiteScopeIds[i] = suiteScopeId
            else:
                var firstBodyLine: int32
                var lastBodyLine: int32
                if !ParserValidateDeferBlockSuite(sourcePath,
                                                   codeLines,
                                                   i,
                                                   ParserLineIndent(line),
                                                   migrationSourceSyntax,
                                                   firstBodyLine,
                                                   lastBodyLine,
                                                   err):
                    return false
                if firstBodyLine < 0 || firstBodyLine >= lineScopeIds.len:
                    err = Fmt"defer suite scope is missing at {sourcePath}:{i + 1}"
                    return false
                suiteScopeId = lineScopeIds[firstBodyLine]
                if suiteScopeId < 0 || suiteScopeId >= layer.scopes.len:
                    err = Fmt"defer suite scope is missing at {sourcePath}:{i + 1}"
                    return false
                endLineNumber = lastBodyLine + 1
                endColumnNumber = codeLines[lastBodyLine].len
                ParserScopeMarkDeferSuite(layer,
                                           suiteScopeId,
                                           lexicalScopeId,
                                           statementOrdinal,
                                           ParserLineIndent(codeLines[firstBodyLine]) + 1,
                                           firstBodyLine + 1,
                                           ParserLineIndent(codeLines[firstBodyLine]) + 1,
                                           endLineNumber,
                                           endColumnNumber)
                for bodyLine in firstBodyLine..lastBodyLine:
                    lineDeferOwnerOrdinals[bodyLine] = statementOrdinal
            var deferSeed: ParserStructuredStatementSeed
            deferSeed.lineIndex = i
            deferSeed.lineNumber = i + 1
            deferSeed.columnNumber = deferStart + 1
            deferSeed.endLineNumber = endLineNumber
            deferSeed.endColumnNumber = endColumnNumber
            deferSeed.kind = NormalizedExprDeferStmt
            deferSeed.surfaceText = "defer:"
            deferSeed.lexicalScopeId = lexicalScopeId
            deferSeed.suiteScopeId = suiteScopeId
            deferSeed.statementOrdinal = statementOrdinal
            deferSeed.lexicalOrdinal = lexicalOrdinal
            deferSeed.deferOwnerStatementOrdinal = -1
            if !ParserStructuredStatementSeedFreezeAnchor(
                    layer, deferSeed, err):
                return false
            add(seeds, deferSeed)
            if cursor < line.len:
                var nestedSeed: ParserStructuredStatementSeed
                var nestedDelimiterPos: int32
                var nestedBodyStart: int32
                var hasNestedSuite = parserReadControlStmtSeedRangeMode(
                    i + 1,
                    line,
                    cursor,
                    migrationSourceSyntax,
                    nestedSeed,
                    nestedDelimiterPos,
                    nestedBodyStart)
                if !hasNestedSuite:
                    hasNestedSuite = ParserReadMatchStmtSeedRange(i + 1,
                                                                   line,
                                                                   cursor,
                                                                   nestedSeed,
                                                                   nestedDelimiterPos,
                                                                   nestedBodyStart)
                if hasNestedSuite:
                    nestedSeed.deferOwnerStatementOrdinal = statementOrdinal
                    if !ParserFinalizeSuiteStatementSeed(sourcePath,
                                                           codeLines,
                                                           lineScopeIds,
                                                           i,
                                                           nestedBodyStart,
                                                           suiteScopeId,
                                                           -1,
                                                           lineInlineNestedSuiteScopeIds[i],
                                                           layer,
                                                           scopeChildCounts,
                                                           scopeStatementCounts,
                                                           seeds,
                                                           nestedSeed,
                                                           err):
                        return false
                    if nestedBodyStart >= 0:
                        lineInlineSuiteBodyStart = nestedBodyStart
                        lineInlineSuiteScopeId = nestedSeed.suiteScopeId
                        lineInlineSuiteBodyColumns[i] = nestedBodyStart + 1
                        lineInlineSuiteScopeIds[i] = nestedSeed.suiteScopeId
        if !ParserAppendBreakContinueSeeds(
                sourcePath,
                line,
                i,
                physicalScopeId,
                lineInlineSuiteBodyStart,
                lineInlineSuiteScopeId,
                layer,
                scopeChildCounts,
                scopeStatementCounts,
                seeds,
                err):
            return false
    err = ""
    return true

fn ParserStructuredIntMapReset(index: var ParserStructuredIntMap) =
    setLen(index.slots, 0)
    setLen(index.keys, 0)
    setLen(index.values, 0)

fn ParserStructuredIntMapSlot(index: var ParserStructuredIntMap,
                               key: int32,
                               found: var bool): int32 =
    found = false
    if key < 0 || index.slots.len <= 0:
        return -1
    var slot = key % index.slots.len
    var visited: int32
    while visited < index.slots.len:
        let rowPlusOne = index.slots[slot]
        if rowPlusOne <= 0:
            return slot
        let row = rowPlusOne - 1
        if row < 0 || row >= index.keys.len || row >= index.values.len:
            return -1
        if index.keys[row] == key:
            found = true
            return slot
        slot = slot + 1
        if slot >= index.slots.len:
            slot = 0
        visited = visited + 1
    return -1

fn ParserStructuredIntMapRehash(index: var ParserStructuredIntMap,
                                 capacityRaw: int32) =
    var capacity: int32 = 8
    while capacity < capacityRaw:
        capacity = capacity * 2
    var slots: int32[]
    setLen(slots, capacity)
    for row in 0..<index.keys.len:
        let key = index.keys[row]
        var slot = key % capacity
        while slots[slot] > 0:
            slot = slot + 1
            if slot >= capacity:
                slot = 0
        slots[slot] = row + 1
    index.slots = slots

fn ParserStructuredIntMapFind(index: var ParserStructuredIntMap,
                               key: int32): int32 =
    var found = false
    let slot = ParserStructuredIntMapSlot(index, key, found)
    if !found || slot < 0:
        return -1
    let row = index.slots[slot] - 1
    if row < 0 || row >= index.values.len:
        return -1
    return index.values[row]

fn ParserStructuredIntMapInsert(index: var ParserStructuredIntMap,
                                 key: int32,
                                 value: int32): bool =
    if key < 0 || value < 0:
        return false
    if index.slots.len <= 0:
        ParserStructuredIntMapRehash(index, 8)
    if index.keys.len * 2 >= index.slots.len:
        ParserStructuredIntMapRehash(index, index.slots.len * 2)
    var found = false
    let slot = ParserStructuredIntMapSlot(index, key, found)
    if slot < 0:
        return false
    if found:
        let row = index.slots[slot] - 1
        if row < 0 || row >= index.values.len:
            return false
        index.values[row] = value
        return true
    add(index.keys, key)
    add(index.values, value)
    index.slots[slot] = index.keys.len
    return true

fn ParserStructuredSourceFactsReset(facts: var ParserStructuredSourceFacts) =
    facts.sourcePath = ""
    for i in 0..<facts.scopes.len:
        var scope = facts.scopes[i]
        scope.sourcePath = ""
        facts.scopes[i] = scope
    for i in 0..<facts.seeds.len:
        var seed = facts.seeds[i]
        seed.surfaceText = ""
        facts.seeds[i] = seed
    facts = ParserStructuredSourceFacts()

fn ParserStructuredSourceSliceReset(slice: var ParserStructuredSourceSlice) =
    slice.sourcePath = ""
    for i in 0..<slice.scopes.len:
        var scope = slice.scopes[i]
        scope.sourcePath = ""
        slice.scopes[i] = scope
    for i in 0..<slice.seeds.len:
        var seed = slice.seeds[i]
        seed.surfaceText = ""
        slice.seeds[i] = seed
    slice = ParserStructuredSourceSlice()

fn ParserStructuredSourceFactsBuild(sourcePathRaw: str,
                                     sourceLines: var str[],
                                     facts: var ParserStructuredSourceFacts,
                                     err: var str): bool =
    if facts.built:
        err = "structured source facts already built; reset before rebuilding"
        return false
    ParserStructuredSourceFactsReset(facts)
    let sourcePath = ParserNormalizePath(sourcePathRaw)
    if sourcePath == "":
        err = "structured source facts require a source path"
        return false
    err = ""
    var scopeLayer: NormalizedExprLayer
    scopeLayer.sourceCount = 1
    var seeds: ParserStructuredStatementSeed[]
    var lineScopeIds: int32[]
    var lineInlineSuiteBodyColumns: int32[]
    var lineInlineSuiteScopeIds: int32[]
    var lineDeferOwnerOrdinals: int32[]
    var lineInlineDeferBodyColumns: int32[]
    var lineInlineDeferSuiteScopeIds: int32[]
    var scopeBuildLineVisitCount: int64
    var structuredBuildLineVisitCount: int64
    if !ParserBuildStructuredStatementFacts(sourcePath,
                                              sourceLines,
                                              scopeLayer,
                                              seeds,
                                              lineScopeIds,
                                              lineInlineSuiteBodyColumns,
                                              lineInlineSuiteScopeIds,
                                              lineDeferOwnerOrdinals,
                                              lineInlineDeferBodyColumns,
                                              lineInlineDeferSuiteScopeIds,
                                              scopeBuildLineVisitCount,
                                              structuredBuildLineVisitCount,
                                              err):
        NormalizedExprLayerReset(scopeLayer)
        ParserStructuredSourceFactsReset(facts)
        return false
    for scopeIndex in 0..<scopeLayer.scopes.len:
        if scopeLayer.scopes[scopeIndex].scopeId != scopeIndex ||
           scopeLayer.scopes[scopeIndex].sourceScopeId != scopeIndex:
            err = "structured source scope ids are not stable"
            NormalizedExprLayerReset(scopeLayer)
            ParserStructuredSourceFactsReset(facts)
            return false
    var lineSeedStarts: int32[]
    var lineSeedCounts: int32[]
    setLen(lineSeedStarts, sourceLines.len)
    setLen(lineSeedCounts, sourceLines.len)
    for lineIndex in 0..<sourceLines.len:
        lineSeedStarts[lineIndex] = -1
    var previousSeedLine = -1
    for seedIndex in 0..<seeds.len:
        let seed = seeds[seedIndex]
        if seed.statementOrdinal != seedIndex || seed.lineIndex < 0 ||
           seed.lineIndex >= sourceLines.len || seed.lineIndex < previousSeedLine:
            err = "structured source statement index is invalid"
            NormalizedExprLayerReset(scopeLayer)
            ParserStructuredSourceFactsReset(facts)
            return false
        if lineSeedStarts[seed.lineIndex] < 0:
            lineSeedStarts[seed.lineIndex] = seedIndex
        lineSeedCounts[seed.lineIndex] = lineSeedCounts[seed.lineIndex] + 1
        previousSeedLine = seed.lineIndex
    facts.sourcePath = sourcePath
    facts.sourceLineCount = sourceLines.len
    facts.scopes = scopeLayer.scopes
    scopeLayer.scopes = []
    facts.seeds = seeds
    facts.lineScopeIds = lineScopeIds
    facts.lineInlineSuiteBodyColumns = lineInlineSuiteBodyColumns
    facts.lineInlineSuiteScopeIds = lineInlineSuiteScopeIds
    facts.lineDeferOwnerOrdinals = lineDeferOwnerOrdinals
    facts.lineInlineDeferBodyColumns = lineInlineDeferBodyColumns
    facts.lineInlineDeferSuiteScopeIds = lineInlineDeferSuiteScopeIds
    facts.lineSeedStarts = lineSeedStarts
    facts.lineSeedCounts = lineSeedCounts
    facts.scopeBuildLineVisitCount = scopeBuildLineVisitCount
    facts.structuredBuildLineVisitCount = structuredBuildLineVisitCount
    facts.built = true
    err = ""
    return true

# Project the already-produced structured rows from one exact parser layer.
# This is the CSG slicing authority: it never reopens or reparses source text.
fn ParserStructuredSourceFactsBuildFromLayer(
        layer: var NormalizedExprLayer,
        sourceLineCount: int32,
        facts: var ParserStructuredSourceFacts,
        err: var str): bool =
    if facts.built:
        err = "structured source facts already built; reset before rebuilding"
        return false
    ParserStructuredSourceFactsReset(facts)
    if layer.sourceCount != 1 || layer.valueExprTree == nil ||
       sourceLineCount <= 0 ||
       layer.scopes.len <= 0:
        err = "structured source layer facts require one populated source"
        return false
    let sourcePath = layer.scopes[0].sourcePath
    if sourcePath == "":
        err = "structured source layer facts require a source path"
        return false
    for scopeIndex in 0..<layer.scopes.len:
        let scope = layer.scopes[scopeIndex]
        if scope.sourcePath != sourcePath || scope.scopeId != scopeIndex ||
           scope.sourceScopeId != scopeIndex ||
           scope.parentScopeId < -1 || scope.parentScopeId >= scopeIndex ||
           scope.startLineNumber <= 0 ||
           scope.endLineNumber < scope.startLineNumber ||
           scope.endLineNumber > sourceLineCount:
            err = "structured source layer scope authority invalid"
            ParserStructuredSourceFactsReset(facts)
            return false
        add(facts.scopes, NormalizedScopeFactClone(layer.scopes[scopeIndex]))
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        if expr.sourcePath != sourcePath || expr.lineNumber <= 0 ||
           expr.endLineNumber < expr.lineNumber ||
           expr.endLineNumber > sourceLineCount:
            err = "structured source layer expression authority invalid"
            ParserStructuredSourceFactsReset(facts)
            return false
        if !ParserNormalizedExprKindIsSidecarStructured(expr.kind):
            if expr.statementOrdinal >= 0 || expr.suiteScopeId >= 0:
                err = "ordinary source expression owns structured identity"
                ParserStructuredSourceFactsReset(facts)
                return false
            continue
        if expr.statementOrdinal != facts.seeds.len ||
           expr.lexicalScopeId < 0 ||
           expr.lexicalScopeId >= layer.scopes.len ||
           expr.suiteScopeId < -1 || expr.suiteScopeId >= layer.scopes.len ||
           expr.deferOwnerStatementOrdinal < -1 ||
           expr.deferOwnerStatementOrdinal >= expr.statementOrdinal:
            err = "structured source layer statement authority invalid"
            ParserStructuredSourceFactsReset(facts)
            return false
        var seed: ParserStructuredStatementSeed
        seed.lineIndex = expr.lineNumber - 1
        seed.lineNumber = expr.lineNumber
        seed.columnNumber = expr.columnNumber
        seed.endLineNumber = expr.endLineNumber
        seed.endColumnNumber = expr.endColumnNumber
        seed.kind = expr.kind
        seed.surfaceText = expr.surfaceText
        seed.lexicalScopeId = expr.lexicalScopeId
        seed.suiteScopeId = expr.suiteScopeId
        seed.statementOrdinal = expr.statementOrdinal
        seed.lexicalOrdinal = expr.lexicalOrdinal
        seed.deferOwnerStatementOrdinal = expr.deferOwnerStatementOrdinal
        add(facts.seeds, seed)
    for scopeIndex in 0..<facts.scopes.len:
        let owner = facts.scopes[scopeIndex].ownerStatementOrdinal
        let declarationOwner =
            facts.scopes[scopeIndex].ownerDeclarationRow
        if owner < -1 || owner >= facts.seeds.len ||
           declarationOwner < -1 ||
           declarationOwner >= layer.valueExprTree.declarationCount ||
           (owner >= 0 && declarationOwner >= 0):
            err = "structured source layer scope owner authority invalid"
            ParserStructuredSourceFactsReset(facts)
            return false
    facts.sourcePath = sourcePath
    facts.sourceLineCount = sourceLineCount
    # The exact parser already performed these source-linear visits.  Keep the
    # report attribution without running the legacy line scanner a second time.
    facts.scopeBuildLineVisitCount = Int64(sourceLineCount)
    facts.structuredBuildLineVisitCount = Int64(sourceLineCount)
    facts.built = true
    err = ""
    return true

fn ParserStructuredSourceSliceSelectScope(facts: var ParserStructuredSourceFacts,
                                           sourceScopeId: int32,
                                           scopeMap: var ParserStructuredIntMap,
                                           selectedSourceScopeIds: var int32[],
                                           visitCount: var int64,
                                           err: var str): bool =
    if sourceScopeId < 0:
        return true
    var chain: int32[]
    var current = sourceScopeId
    while current >= 0:
        if ParserStructuredIntMapFind(scopeMap, current) >= 0:
            break
        if current >= facts.scopes.len || facts.scopes[current].scopeId != current:
            err = "structured source slice references an invalid scope"
            return false
        add(chain, current)
        let parent = facts.scopes[current].parentScopeId
        if parent >= current:
            err = "structured source scope parent is not acyclic"
            return false
        current = parent
    var chainIndex = chain.len
    while chainIndex > 0:
        chainIndex = chainIndex - 1
        let selectedId = chain[chainIndex]
        let localId = selectedSourceScopeIds.len
        if !ParserStructuredIntMapInsert(scopeMap, selectedId, localId):
            err = "structured source scope index insertion failed"
            return false
        add(selectedSourceScopeIds, selectedId)
        visitCount = visitCount + 1
    return true

fn ParserStructuredSourceSliceMapRequired(index: var ParserStructuredIntMap,
                                           sourceId: int32,
                                           label: str,
                                           err: var str): int32 =
    if sourceId < 0:
        return -1
    let localId = ParserStructuredIntMapFind(index, sourceId)
    if localId < 0:
        err = ParserConcat3("structured source slice is missing ", label, " mapping")
    return localId

fn ParserStructuredSourceFactsSliceBuild(facts: var ParserStructuredSourceFacts,
                                          lineStartNumber: int32,
                                          lineEndNumber: int32,
                                          slice: var ParserStructuredSourceSlice,
                                          err: var str): bool =
    if slice.built:
        err = "structured source slice already built; reset before rebuilding"
        return false
    ParserStructuredSourceSliceReset(slice)
    if !facts.built:
        err = "structured source facts are not built"
        return false
    if lineStartNumber <= 0 || lineEndNumber < lineStartNumber ||
       lineEndNumber > facts.sourceLineCount:
        err = "structured source slice line range is invalid"
        return false
    err = ""
    var candidate: ParserStructuredSourceSlice
    candidate.sourcePath = facts.sourcePath
    candidate.lineStartNumber = lineStartNumber
    candidate.lineEndNumber = lineEndNumber
    let lineCount = lineEndNumber - lineStartNumber + 1
    setLen(candidate.lineScopeIds, lineCount)
    setLen(candidate.lineInlineSuiteBodyColumns, lineCount)
    setLen(candidate.lineInlineSuiteScopeIds, lineCount)
    setLen(candidate.lineDeferOwnerOrdinals, lineCount)
    setLen(candidate.lineInlineDeferBodyColumns, lineCount)
    setLen(candidate.lineInlineDeferSuiteScopeIds, lineCount)
    var scopeMap: ParserStructuredIntMap
    var statementMap: ParserStructuredIntMap
    var selectedSeedIndexes: int32[]
    for localLineIndex in 0..<lineCount:
        candidate.lineVisitCount = candidate.lineVisitCount + 1
        let sourceLineIndex = lineStartNumber - 1 + localLineIndex
        let sourceScopeId = facts.lineScopeIds[sourceLineIndex]
        let sourceInlineSuiteScopeId = facts.lineInlineSuiteScopeIds[sourceLineIndex]
        let sourceInlineDeferSuiteScopeId = facts.lineInlineDeferSuiteScopeIds[sourceLineIndex]
        candidate.lineScopeIds[localLineIndex] = sourceScopeId
        candidate.lineInlineSuiteBodyColumns[localLineIndex] =
            facts.lineInlineSuiteBodyColumns[sourceLineIndex]
        candidate.lineInlineSuiteScopeIds[localLineIndex] = sourceInlineSuiteScopeId
        candidate.lineDeferOwnerOrdinals[localLineIndex] =
            facts.lineDeferOwnerOrdinals[sourceLineIndex]
        candidate.lineInlineDeferBodyColumns[localLineIndex] =
            facts.lineInlineDeferBodyColumns[sourceLineIndex]
        candidate.lineInlineDeferSuiteScopeIds[localLineIndex] =
            sourceInlineDeferSuiteScopeId
        if !ParserStructuredSourceSliceSelectScope(facts,
                                                    sourceScopeId,
                                                    scopeMap,
                                                    candidate.sourceScopeIds,
                                                    candidate.scopeVisitCount,
                                                    err) ||
           !ParserStructuredSourceSliceSelectScope(facts,
                                                    sourceInlineSuiteScopeId,
                                                    scopeMap,
                                                    candidate.sourceScopeIds,
                                                    candidate.scopeVisitCount,
                                                    err) ||
           !ParserStructuredSourceSliceSelectScope(facts,
                                                    sourceInlineDeferSuiteScopeId,
                                                    scopeMap,
                                                    candidate.sourceScopeIds,
                                                    candidate.scopeVisitCount,
                                                    err):
            ParserStructuredSourceSliceReset(candidate)
            return false
        let seedStart = facts.lineSeedStarts[sourceLineIndex]
        let seedCount = facts.lineSeedCounts[sourceLineIndex]
        for lineSeedIndex in 0..<seedCount:
            let seedIndex = seedStart + lineSeedIndex
            if seedIndex < 0 || seedIndex >= facts.seeds.len:
                err = "structured source line seed range is invalid"
                ParserStructuredSourceSliceReset(candidate)
                return false
            let seed = facts.seeds[seedIndex]
            if seed.lineNumber < lineStartNumber || seed.endLineNumber > lineEndNumber:
                err = "structured statement escapes function slice range"
                ParserStructuredSourceSliceReset(candidate)
                return false
            let localStatementOrdinal = selectedSeedIndexes.len
            if !ParserStructuredIntMapInsert(statementMap,
                                              seed.statementOrdinal,
                                              localStatementOrdinal):
                err = "structured source statement index insertion failed"
                ParserStructuredSourceSliceReset(candidate)
                return false
            add(selectedSeedIndexes, seedIndex)
            add(candidate.sourceStatementOrdinals, seed.statementOrdinal)
            candidate.seedVisitCount = candidate.seedVisitCount + 1
            if !ParserStructuredSourceSliceSelectScope(facts,
                                                        seed.lexicalScopeId,
                                                        scopeMap,
                                                        candidate.sourceScopeIds,
                                                        candidate.scopeVisitCount,
                                                        err) ||
               !ParserStructuredSourceSliceSelectScope(facts,
                                                        seed.suiteScopeId,
                                                        scopeMap,
                                                        candidate.sourceScopeIds,
                                                        candidate.scopeVisitCount,
                                                        err):
                ParserStructuredSourceSliceReset(candidate)
                return false
    var localScopeChildCounts: int32[]
    setLen(localScopeChildCounts, candidate.sourceScopeIds.len)
    for localScopeId in 0..<candidate.sourceScopeIds.len:
        let sourceScopeId = candidate.sourceScopeIds[localScopeId]
        var scope = NormalizedScopeFactClone(facts.scopes[sourceScopeId])
        scope.scopeId = localScopeId
        scope.sourceScopeId = sourceScopeId
        scope.parentScopeId = ParserStructuredSourceSliceMapRequired(scopeMap,
                                                                      scope.parentScopeId,
                                                                      "scope parent",
                                                                      err)
        if err != "":
            ParserStructuredSourceSliceReset(candidate)
            return false
        if scope.parentScopeId >= 0:
            scope.lexicalOrdinal = localScopeChildCounts[scope.parentScopeId]
            localScopeChildCounts[scope.parentScopeId] =
                scope.lexicalOrdinal + 1
        else:
            scope.lexicalOrdinal = 0
        scope.ownerStatementOrdinal =
            ParserStructuredSourceSliceMapRequired(statementMap,
                                                    scope.ownerStatementOrdinal,
                                                    "scope owner statement",
                                                    err)
        if err != "":
            ParserStructuredSourceSliceReset(candidate)
            return false
        add(candidate.scopes, scope)
    var localStatementCountsByScope: int32[]
    setLen(localStatementCountsByScope, candidate.scopes.len)
    for localStatementOrdinal in 0..<selectedSeedIndexes.len:
        let sourceSeedIndex = selectedSeedIndexes[localStatementOrdinal]
        var seed = ParserStructuredStatementSeedClone(
            facts.seeds[sourceSeedIndex])
        seed.lexicalScopeId = ParserStructuredSourceSliceMapRequired(scopeMap,
                                                                      seed.lexicalScopeId,
                                                                      "statement lexical scope",
                                                                      err)
        seed.suiteScopeId = ParserStructuredSourceSliceMapRequired(scopeMap,
                                                                    seed.suiteScopeId,
                                                                    "statement suite scope",
                                                                    err)
        seed.deferOwnerStatementOrdinal =
            ParserStructuredSourceSliceMapRequired(statementMap,
                                                    seed.deferOwnerStatementOrdinal,
                                                    "defer owner statement",
                                                    err)
        if err != "" || seed.lexicalScopeId < 0 ||
           seed.lexicalScopeId >= localStatementCountsByScope.len:
            if err == "":
                err = "structured statement lexical scope is invalid"
            ParserStructuredSourceSliceReset(candidate)
            return false
        seed.statementOrdinal = localStatementOrdinal
        seed.lexicalOrdinal = localStatementCountsByScope[seed.lexicalScopeId]
        localStatementCountsByScope[seed.lexicalScopeId] = seed.lexicalOrdinal + 1
        add(candidate.seeds, seed)
    for localLineIndex in 0..<lineCount:
        candidate.lineScopeIds[localLineIndex] =
            ParserStructuredSourceSliceMapRequired(scopeMap,
                                                    candidate.lineScopeIds[localLineIndex],
                                                    "line lexical scope",
                                                    err)
        candidate.lineInlineSuiteScopeIds[localLineIndex] =
            ParserStructuredSourceSliceMapRequired(
                scopeMap,
                candidate.lineInlineSuiteScopeIds[localLineIndex],
                "line inline suite scope",
                err)
        candidate.lineInlineDeferSuiteScopeIds[localLineIndex] =
            ParserStructuredSourceSliceMapRequired(
                scopeMap,
                candidate.lineInlineDeferSuiteScopeIds[localLineIndex],
                "line inline defer scope",
                err)
        candidate.lineDeferOwnerOrdinals[localLineIndex] =
            ParserStructuredSourceSliceMapRequired(
                statementMap,
                candidate.lineDeferOwnerOrdinals[localLineIndex],
                "line defer owner statement",
                err)
        if err != "":
            ParserStructuredSourceSliceReset(candidate)
            return false
    ParserStructuredIntMapReset(scopeMap)
    ParserStructuredIntMapReset(statementMap)
    candidate.built = true
    slice = candidate
    err = ""
    return true

# Slice the exact structured identities already present in a full source
# layer.  Scope/sourceStatement rows remain the immutable source-domain keys;
# the cloned scope/seed rows are remapped only for the function-local layer.
fn ParserStructuredSourceFactsSliceBuildFromLayer(
        facts: var ParserStructuredSourceFacts,
        layer: var NormalizedExprLayer,
        lineStartNumber: int32,
        lineEndNumber: int32,
        slice: var ParserStructuredSourceSlice,
        err: var str): bool =
    if slice.built:
        err = "structured source slice already built; reset before rebuilding"
        return false
    ParserStructuredSourceSliceReset(slice)
    if !facts.built || layer.sourceCount != 1 ||
       lineStartNumber <= 0 || lineEndNumber < lineStartNumber ||
       lineEndNumber > facts.sourceLineCount:
        err = "structured source layer slice identity invalid"
        return false
    var candidate: ParserStructuredSourceSlice
    candidate.sourcePath = facts.sourcePath
    candidate.lineStartNumber = lineStartNumber
    candidate.lineEndNumber = lineEndNumber
    candidate.lineVisitCount = Int64(lineEndNumber - lineStartNumber + 1)
    var scopeMap: ParserStructuredIntMap
    var statementMap: ParserStructuredIntMap
    var selectedSeedIndexes: int32[]
    # Select contained scopes by immutable source row before visiting
    # expressions.  This keeps new scope ids monotonic across function slices,
    # including empty sibling suites that have no expression row of their own.
    for sourceScopeId in 0..<facts.scopes.len:
        let scope = facts.scopes[sourceScopeId]
        if scope.startLineNumber < lineStartNumber ||
           scope.endLineNumber > lineEndNumber:
            continue
        if !ParserStructuredSourceSliceSelectScope(
                facts,
                sourceScopeId,
                scopeMap,
                candidate.sourceScopeIds,
                candidate.scopeVisitCount,
                err):
            ParserStructuredSourceSliceReset(candidate)
            return false
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        if expr.sourcePath != facts.sourcePath:
            err = "structured source layer slice source mismatch"
            ParserStructuredSourceSliceReset(candidate)
            return false
        if expr.lineNumber < lineStartNumber || expr.lineNumber > lineEndNumber:
            continue
        if expr.endLineNumber > lineEndNumber:
            err = "structured statement escapes function slice range"
            ParserStructuredSourceSliceReset(candidate)
            return false
        if !ParserStructuredSourceSliceSelectScope(
                facts,
                expr.lexicalScopeId,
                scopeMap,
                candidate.sourceScopeIds,
                candidate.scopeVisitCount,
                err) ||
           !ParserStructuredSourceSliceSelectScope(
                facts,
                expr.suiteScopeId,
                scopeMap,
                candidate.sourceScopeIds,
                candidate.scopeVisitCount,
                err):
            ParserStructuredSourceSliceReset(candidate)
            return false
        if !ParserNormalizedExprKindIsSidecarStructured(expr.kind):
            continue
        if expr.statementOrdinal < 0 ||
           expr.statementOrdinal >= facts.seeds.len ||
           ParserStructuredIntMapFind(statementMap,
                                       expr.statementOrdinal) >= 0:
            err = "structured source layer statement selection invalid"
            ParserStructuredSourceSliceReset(candidate)
            return false
        let localStatementOrdinal = selectedSeedIndexes.len
        if !ParserStructuredIntMapInsert(statementMap,
                                          expr.statementOrdinal,
                                          localStatementOrdinal):
            err = "structured source statement index insertion failed"
            ParserStructuredSourceSliceReset(candidate)
            return false
        add(selectedSeedIndexes, expr.statementOrdinal)
        add(candidate.sourceStatementOrdinals, expr.statementOrdinal)
        candidate.seedVisitCount = candidate.seedVisitCount + Int64(1)
    if candidate.sourceScopeIds.len == 0:
        # An inline single-line Form-B function body exists only in the
        # parser token tree; the normalized layer has neither scope nor
        # expr rows for its line range.  Every slice must carry the domain
        # root (dense-0), so the first-function commit implicit-root guard
        # has a scope row to amortize into.
        if !ParserStructuredSourceSliceSelectScope(
                facts,
                0,
                scopeMap,
                candidate.sourceScopeIds,
                candidate.scopeVisitCount,
                err):
            ParserStructuredSourceSliceReset(candidate)
            return false
    var localScopeChildCounts: int32[]
    setLen(localScopeChildCounts, candidate.sourceScopeIds.len)
    for localScopeId in 0..<candidate.sourceScopeIds.len:
        let sourceScopeId = candidate.sourceScopeIds[localScopeId]
        var scope = NormalizedScopeFactClone(facts.scopes[sourceScopeId])
        scope.scopeId = localScopeId
        scope.sourceScopeId = sourceScopeId
        scope.parentScopeId = ParserStructuredSourceSliceMapRequired(
            scopeMap, scope.parentScopeId, "scope parent", err)
        scope.ownerStatementOrdinal = ParserStructuredSourceSliceMapRequired(
            statementMap,
            scope.ownerStatementOrdinal,
            "scope owner statement",
            err)
        if err != "":
            ParserStructuredSourceSliceReset(candidate)
            return false
        if scope.parentScopeId >= 0:
            scope.lexicalOrdinal =
                localScopeChildCounts[scope.parentScopeId]
            localScopeChildCounts[scope.parentScopeId] =
                scope.lexicalOrdinal + 1
        else:
            scope.lexicalOrdinal = 0
        add(candidate.scopes, scope)
    var localStatementCountsByScope: int32[]
    setLen(localStatementCountsByScope, candidate.scopes.len)
    for localStatementOrdinal in 0..<selectedSeedIndexes.len:
        let sourceStatementOrdinal =
            selectedSeedIndexes[localStatementOrdinal]
        var seed = ParserStructuredStatementSeedClone(
            facts.seeds[sourceStatementOrdinal])
        seed.lexicalScopeId = ParserStructuredSourceSliceMapRequired(
            scopeMap, seed.lexicalScopeId, "statement lexical scope", err)
        seed.suiteScopeId = ParserStructuredSourceSliceMapRequired(
            scopeMap, seed.suiteScopeId, "statement suite scope", err)
        seed.deferOwnerStatementOrdinal =
            ParserStructuredSourceSliceMapRequired(
                statementMap,
                seed.deferOwnerStatementOrdinal,
                "defer owner statement",
                err)
        if err != "" || seed.lexicalScopeId < 0 ||
           seed.lexicalScopeId >= localStatementCountsByScope.len:
            if err == "":
                err = "structured statement lexical scope is invalid"
            ParserStructuredSourceSliceReset(candidate)
            return false
        seed.statementOrdinal = localStatementOrdinal
        seed.lexicalOrdinal =
            localStatementCountsByScope[seed.lexicalScopeId]
        localStatementCountsByScope[seed.lexicalScopeId] =
            seed.lexicalOrdinal + 1
        add(candidate.seeds, seed)
    ParserStructuredIntMapReset(scopeMap)
    ParserStructuredIntMapReset(statementMap)
    candidate.built = true
    slice = candidate
    err = ""
    return true

fn ParserNormalizedExprKindIsSidecarStructured(kind: NormalizedExprKind): bool =
    return kind == NormalizedExprIfStmt || kind == NormalizedExprElifStmt ||
           kind == NormalizedExprElseStmt || kind == NormalizedExprForStmt ||
           kind == NormalizedExprMatchStmt || kind == NormalizedExprCaseStmt ||
           kind == NormalizedExprWhileStmt || kind == NormalizedExprDeferStmt ||
           kind == NormalizedExprBreakStmt || kind == NormalizedExprContinueStmt

fn ParserStructuredSourceSliceRemapExistingLayer(
        slice: var ParserStructuredSourceSlice,
        layer: var NormalizedExprLayer,
        err: var str): bool =
    if !slice.built || layer.sourceCount != 1 || layer.scopes.len > 0 ||
       layer.valueExprTree == nil || !layer.valueExprTreeBorrowLease:
        err = "structured source exact layer ownership invalid"
        return false
    var scopeMap: ParserStructuredIntMap
    var statementMap: ParserStructuredIntMap
    for localScopeId in 0..<slice.sourceScopeIds.len:
        if !ParserStructuredIntMapInsert(scopeMap,
                                          slice.sourceScopeIds[localScopeId],
                                          localScopeId):
            err = "structured source exact scope map invalid"
            return false
    for localStatementOrdinal in 0..<slice.sourceStatementOrdinals.len:
        if !ParserStructuredIntMapInsert(
                statementMap,
                slice.sourceStatementOrdinals[localStatementOrdinal],
                localStatementOrdinal):
            err = "structured source exact statement map invalid"
            return false
    # 括号扫描(前): merge 前的 layer 是否已含零值槽
    for scanIndex in 0..<layer.exprs.len:
        if layer.exprs[scanIndex].kind == NormalizedExprIf &&
           layer.exprs[scanIndex].lineNumber == 0 &&
           layer.exprs[scanIndex].sourcePath == "":
            panic("parser value expr: PRE-MERGE zero If slot found")

    var merged: NormalizedExprLayer
    merged.sourceCount = 1
    merged.questionResidualCount = layer.questionResidualCount
    for localScopeId in 0..<slice.scopes.len:
        add(merged.scopes, NormalizedScopeFactClone(slice.scopes[localScopeId]))
    var localStatementCountsByScope: int32[]
    setLen(localStatementCountsByScope, slice.scopes.len)
    var structuredStatementCount: int32
    var previousLine: int32 = -1
    for exprIndex in 0..<layer.exprs.len:
        var expr: NormalizedExpr
        NormalizedExprCloneInto(layer.exprs[exprIndex], expr)
        if expr.sourcePath != slice.sourcePath ||
           expr.lineNumber < slice.lineStartNumber ||
           expr.lineNumber > slice.lineEndNumber ||
           expr.lineNumber < previousLine:
            err = "structured source exact expression range invalid"
            return false
        expr.lexicalScopeId = ParserStructuredSourceSliceMapRequired(
            scopeMap, expr.lexicalScopeId, "expression lexical scope", err)
        expr.suiteScopeId = ParserStructuredSourceSliceMapRequired(
            scopeMap, expr.suiteScopeId, "expression suite scope", err)
        let sourceStatementOrdinal = expr.statementOrdinal
        expr.statementOrdinal = ParserStructuredSourceSliceMapRequired(
            statementMap,
            expr.statementOrdinal,
            "expression statement",
            err)
        expr.deferOwnerStatementOrdinal =
            ParserStructuredSourceSliceMapRequired(
                statementMap,
                expr.deferOwnerStatementOrdinal,
                "expression defer owner",
                err)
        if err != "" || expr.lexicalScopeId < 0 ||
           expr.lexicalScopeId >= slice.scopes.len:
            if err == "":
                err = "structured source exact expression scope invalid"
            return false
        if ParserNormalizedExprKindIsSidecarStructured(expr.kind):
            if sourceStatementOrdinal < 0 ||
               expr.statementOrdinal != structuredStatementCount:
                err = "structured source exact header order invalid"
                return false
            expr.lexicalOrdinal =
                localStatementCountsByScope[expr.lexicalScopeId]
            localStatementCountsByScope[expr.lexicalScopeId] =
                expr.lexicalOrdinal + 1
            structuredStatementCount = structuredStatementCount + 1
        elif sourceStatementOrdinal >= 0 || expr.suiteScopeId >= 0:
            err = "ordinary source expression owns structured identity"
            return false
        let before = merged.exprs.len
        NormalizedExprLayerAppendExisting(merged, expr)
        if merged.exprs.len != before + 1:
            err = "structured source exact expression duplicated"
            return false
        previousLine = expr.lineNumber
    if structuredStatementCount != slice.sourceStatementOrdinals.len ||
       merged.scopes.len != slice.sourceScopeIds.len:
        err = "structured source exact slice coverage incomplete"
        return false
    merged.valueExprTree = layer.valueExprTree
    merged.valueExprTreeBorrowLease = layer.valueExprTreeBorrowLease
    layer.valueExprTree = nil
    layer.valueExprTreeBorrowLease = false
    NormalizedExprLayerReset(layer)
    NormalizedExprLayerMoveInto(layer, merged)
    slice.applyExprVisitCount =
        slice.applyExprVisitCount + Int64(layer.exprs.len)
    ParserStructuredIntMapReset(scopeMap)
    ParserStructuredIntMapReset(statementMap)
    err = ""
    return true

fn ParserAnnotateExprFact(expr: var NormalizedExpr,
                           lexicalScopeId: int32,
                           inlineSuiteBodyColumn: int32,
                           inlineSuiteScopeId: int32,
                           deferOwnerStatementOrdinal: int32,
                           inlineDeferBodyColumn: int32,
                           inlineDeferSuiteScopeId: int32) =
    var factScopeId = lexicalScopeId
    var selectedInlineColumn = -1
    if inlineSuiteBodyColumn > 0 && expr.columnNumber >= inlineSuiteBodyColumn:
        factScopeId = inlineSuiteScopeId
        selectedInlineColumn = inlineSuiteBodyColumn
    var ownerOrdinal = deferOwnerStatementOrdinal
    if inlineDeferBodyColumn > 0:
        if expr.columnNumber >= inlineDeferBodyColumn:
            if inlineDeferBodyColumn >= selectedInlineColumn:
                selectedInlineColumn = inlineDeferBodyColumn
                factScopeId = inlineDeferSuiteScopeId
        else:
            ownerOrdinal = -1
    if inlineSuiteBodyColumn > selectedInlineColumn &&
       expr.columnNumber >= inlineSuiteBodyColumn:
        factScopeId = inlineSuiteScopeId
    expr.lexicalScopeId = factScopeId
    expr.deferOwnerStatementOrdinal = ownerOrdinal

fn ParserStructuredSourceSliceAppendToLayer(slice: var ParserStructuredSourceSlice,
                                             layer: var NormalizedExprLayer,
                                             err: var str): bool =
    if !slice.built:
        err = "structured source slice is not built"
        return false
    if layer.scopes.len > 0 || layer.sourceCount > 1:
        err = "structured source slice target already owns scope facts"
        return false
    err = ""
    var previousLine = -1
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        if expr.sourcePath != slice.sourcePath ||
           expr.lineNumber < slice.lineStartNumber ||
           expr.lineNumber > slice.lineEndNumber:
            err = "structured source slice target expression escapes range"
            return false
        if expr.lineNumber < previousLine:
            err = "structured source slice target expressions are not in source order"
            return false
        if ParserNormalizedExprKindIsSidecarStructured(expr.kind) ||
           expr.statementOrdinal >= 0 || expr.suiteScopeId >= 0:
            err = "structured source slice target already contains structured headers"
            return false
        previousLine = expr.lineNumber
    let existingExprCount = layer.exprs.len
    for exprIndex in 0..<existingExprCount:
        var expr = layer.exprs[exprIndex]
        let localLineIndex = expr.lineNumber - slice.lineStartNumber
        ParserAnnotateExprFact(expr,
                                slice.lineScopeIds[localLineIndex],
                                slice.lineInlineSuiteBodyColumns[localLineIndex],
                                slice.lineInlineSuiteScopeIds[localLineIndex],
                                slice.lineDeferOwnerOrdinals[localLineIndex],
                                slice.lineInlineDeferBodyColumns[localLineIndex],
                                slice.lineInlineDeferSuiteScopeIds[localLineIndex])
        layer.exprs[exprIndex] = expr
        if layer.exprs[exprIndex].kind == NormalizedExprIf && layer.exprs[exprIndex].lineNumber == 0 && layer.exprs[exprIndex].sourcePath == "":
            panic("parser value expr: W1 zero writeback idx={exprIndex} total={layer.exprs.len}")
    var merged: NormalizedExprLayer
    merged.sourceCount = 1
    merged.questionResidualCount = layer.questionResidualCount
    # Structured slicing rewrites metadata only.  Transfer the exact tree
    # owner/lease descriptor; resetting the old metadata carrier must not free
    # or clone the immutable parser authority.
    merged.valueExprTree = layer.valueExprTree
    merged.valueExprTreeBorrowLease = layer.valueExprTreeBorrowLease
    for scopeIndex in 0..<slice.scopes.len:
        add(merged.scopes, NormalizedScopeFactClone(slice.scopes[scopeIndex]))
    var exprCursor: int32
    var seedCursor: int32
    while exprCursor < layer.exprs.len || seedCursor < slice.seeds.len:
        var appendSeed = seedCursor < slice.seeds.len
        if appendSeed && exprCursor < layer.exprs.len:
            appendSeed = slice.seeds[seedCursor].lineNumber <=
                         layer.exprs[exprCursor].lineNumber
        if layer.exprs[exprCursor].kind == NormalizedExprIf &&
           layer.exprs[exprCursor].lineNumber == 0 &&
           layer.exprs[exprCursor].sourcePath == "":
            panic("parser value expr: ZERO SOURCE EXPR entering merge")
        if appendSeed:
            NormalizedExprLayerAppendStructuredStatement(merged,
                                                           slice.sourcePath,
                                                           slice.seeds[seedCursor])
        if merged.exprs.len > 0:
            let lastIdx = merged.exprs.len - 1
            if merged.exprs[lastIdx].kind == NormalizedExprIf &&
               merged.exprs[lastIdx].lineNumber == 0 &&
               merged.exprs[lastIdx].sourcePath == "":
                panic("parser value expr: APPEND produced zero If slot")
        if merged.exprs.len > 0:
            let lastIdx = merged.exprs.len - 1
            if merged.exprs[lastIdx].kind == NormalizedExprIf &&
               merged.exprs[lastIdx].lineNumber == 0 &&
               merged.exprs[lastIdx].sourcePath == "":
                panic("parser value expr: MERGE produced zero If slot in loop")
            for scanIndex in 0..<merged.exprs.len:
                if merged.exprs[scanIndex].kind == NormalizedExprIf &&
                   merged.exprs[scanIndex].lineNumber == 0 &&
                   merged.exprs[scanIndex].sourcePath == "":
                    panic("parser value expr: POST-MERGE zero If slot found")
            seedCursor = seedCursor + 1
        else:
            var expr = layer.exprs[exprCursor]
            NormalizedExprLayerAppendExisting(merged, expr)
            exprCursor = exprCursor + 1
    layer.valueExprTree = nil
    layer.valueExprTreeBorrowLease = false
    NormalizedExprLayerReset(layer)
    NormalizedExprLayerMoveInto(layer, merged)
    slice.applyExprVisitCount = slice.applyExprVisitCount + Int64(existingExprCount)
    err = ""
    return true

fn ParserAnnotateExprDelta(layer: var NormalizedExprLayer,
                            exprStartRaw: int32,
                            lexicalScopeId: int32,
                            inlineSuiteBodyColumn: int32,
                            inlineSuiteScopeId: int32,
                            deferOwnerStatementOrdinal: int32,
                            inlineDeferBodyColumn: int32,
                            inlineDeferSuiteScopeId: int32) =
    var exprStart = exprStartRaw
    if exprStart < 0:
        exprStart = 0
    if exprStart >= layer.exprs.len:
        return
    for exprIndex in exprStart..<layer.exprs.len:
        var expr = layer.exprs[exprIndex]
        ParserAnnotateExprFact(expr,
                                lexicalScopeId,
                                inlineSuiteBodyColumn,
                                inlineSuiteScopeId,
                                deferOwnerStatementOrdinal,
                                inlineDeferBodyColumn,
                                inlineDeferSuiteScopeId)
        layer.exprs[exprIndex] = expr
        if layer.exprs[exprIndex].kind == NormalizedExprIf && layer.exprs[exprIndex].lineNumber == 0 && layer.exprs[exprIndex].sourcePath == "":
            panic("parser value expr: W2 zero writeback idx={exprIndex} total={layer.exprs.len}")

@borrows
fn ParserAppendStructuredSeedsForLine(sourcePath: str,
                                       lineIndex: int32,
                                       seeds: var ParserStructuredStatementSeed[],
                                       nextSeed: var int32,
                                       layer: var NormalizedExprLayer) =
    while nextSeed < seeds.len && seeds[nextSeed].lineIndex < lineIndex:
        nextSeed = nextSeed + 1
    while nextSeed < seeds.len && seeds[nextSeed].lineIndex == lineIndex:
        NormalizedExprLayerAppendStructuredStatement(layer,
                                                       sourcePath,
                                                       seeds[nextSeed])
        nextSeed = nextSeed + 1

@borrows
fn ParserValueExprProfileHasName(names: str[], name: str): bool =
    for nameIndex in 0..<names.len:
        if names[nameIndex] == name:
            return true
    return false

const parserCallPosOrderCallName: int32 = 1
const parserCallPosOrderCallEnd: int32 = 2
const parserCallPosOrderTokenStart: int32 = 3
const parserCallPosOrderTokenEnd: int32 = 4

@borrows
fn parserValueExprCallPositionOrderLess(
        tree: ParserValueExprTree,
        mode: int32,
        order: int32[],
        leftPos: int32,
        rightPos: int32): bool =
    let left = order[leftPos]
    let right = order[rightPos]
    if mode == parserCallPosOrderTokenStart:
        let leftSource = ParserValueExprTokenSourceIdAt(tree, left)
        let rightSource = ParserValueExprTokenSourceIdAt(tree, right)
        if leftSource != rightSource:
            return leftSource < rightSource
        let leftStart = ParserValueExprTokenStartAt(tree, left)
        let rightStart = ParserValueExprTokenStartAt(tree, right)
        if leftStart != rightStart:
            return leftStart < rightStart
        return left < right
    if mode == parserCallPosOrderTokenEnd:
        let leftSource = ParserValueExprTokenSourceIdAt(tree, left)
        let rightSource = ParserValueExprTokenSourceIdAt(tree, right)
        if leftSource != rightSource:
            return leftSource < rightSource
        let leftEnd = ParserValueExprTokenEndAt(tree, left)
        let rightEnd = ParserValueExprTokenEndAt(tree, right)
        if leftEnd != rightEnd:
            return leftEnd < rightEnd
        return left < right
    let leftNode = ParserValueExprCallEventNodeAt(tree, left)
    let rightNode = ParserValueExprCallEventNodeAt(tree, right)
    let leftSource = ParserValueExprNodeSourceIdAt(tree, leftNode)
    let rightSource = ParserValueExprNodeSourceIdAt(tree, rightNode)
    if leftSource != rightSource:
        return leftSource < rightSource
    var leftKey: int32 = -1
    var rightKey: int32 = -1
    if mode == parserCallPosOrderCallName:
        leftKey = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.nameStarts, leftNode)
        rightKey = arenamod.ArenaArrayInt32Get(
            tree.arena, tree.nameStarts, rightNode)
    else:
        leftKey = ParserValueExprNodeSpanEndAt(tree, leftNode)
        rightKey = ParserValueExprNodeSpanEndAt(tree, rightNode)
    if leftKey != rightKey:
        return leftKey < rightKey
    return left < right

@borrows
fn parserValueExprCallPositionOrderSort(
        tree: ParserValueExprTree,
        mode: int32,
        order: var int32[]) =
    let count = order.len
    if count <= 1:
        return
    var start = (count - 2) / 2
    while start >= 0:
        var root = start
        while true:
            var child = root * 2 + 1
            if child >= count:
                break
            if child + 1 < count &&
               parserValueExprCallPositionOrderLess(
                   tree, mode, order, child, child + 1):
                child = child + 1
            if parserValueExprCallPositionOrderLess(
                   tree, mode, order, root, child):
                let swapValue = order[root]
                order[root] = order[child]
                order[child] = swapValue
                root = child
            else:
                break
        start = start - 1
    var end = count - 1
    while end > 0:
        let swapValue = order[0]
        order[0] = order[end]
        order[end] = swapValue
        end = end - 1
        var root = 0
        while true:
            var child = root * 2 + 1
            if child > end:
                break
            if child + 1 <= end &&
               parserValueExprCallPositionOrderLess(
                   tree, mode, order, child, child + 1):
                child = child + 1
            if parserValueExprCallPositionOrderLess(
                   tree, mode, order, root, child):
                let swapChild = order[root]
                order[root] = order[child]
                order[child] = swapChild
                root = child
            else:
                break

@borrows
fn parserValueExprCallPositionTokenIndexesBuild(
        tree: ParserValueExprTree,
        callOrder: int32[],
        tokenOrder: int32[],
        matchName: bool,
        outIndexes: var int32[]) =
    let eventCount = callOrder.len
    let tokenCount = tokenOrder.len
    for eventIndex in 0..<eventCount:
        outIndexes[eventIndex] = -1
    var tokenCursor = 0
    for queryPos in 0..<eventCount:
        let eventIndex = callOrder[queryPos]
        let nodeIndex = ParserValueExprCallEventNodeAt(
            tree, eventIndex)
        let sourceId = ParserValueExprNodeSourceIdAt(
            tree, nodeIndex)
        var queryKey: int32 = -1
        if matchName:
            queryKey = arenamod.ArenaArrayInt32Get(
                tree.arena, tree.nameStarts, nodeIndex)
        else:
            queryKey = ParserValueExprNodeSpanEndAt(tree, nodeIndex)
        var lastMatch = -1
        while tokenCursor < tokenCount:
            let tokenIndex = tokenOrder[tokenCursor]
            let tokenSource = ParserValueExprTokenSourceIdAt(
                tree, tokenIndex)
            if tokenSource < sourceId:
                tokenCursor = tokenCursor + 1
                continue
            if tokenSource > sourceId:
                break
            var tokenKey: int32 = -1
            if matchName:
                tokenKey = ParserValueExprTokenStartAt(tree, tokenIndex)
            else:
                tokenKey = ParserValueExprTokenEndAt(tree, tokenIndex)
            if tokenKey < queryKey:
                tokenCursor = tokenCursor + 1
                continue
            if tokenKey > queryKey:
                break
            lastMatch = tokenIndex
            tokenCursor = tokenCursor + 1
        outIndexes[eventIndex] = lastMatch

@borrows
fn parserValueExprCallPositionTokenRangesBuild(
        tree: ParserValueExprTree,
        primaryStarts: var int32[],
        primaryCounts: var int32[],
        childStarts: var int32[],
        childCounts: var int32[]) =
    let sourceCount = tree.producerSourceCount
    setLen(primaryStarts, sourceCount)
    setLen(primaryCounts, sourceCount)
    setLen(childStarts, sourceCount)
    setLen(childCounts, sourceCount)
    for sourceIndex in 0..<sourceCount:
        primaryStarts[sourceIndex] = 0
        primaryCounts[sourceIndex] = 0
        childStarts[sourceIndex] = 0
        childCounts[sourceIndex] = 0
    for tokenIndex in 0..<tree.tokenCount:
        let source = ParserValueExprTokenProducerSourceIndexAt(
            tree, tokenIndex)
        if source < 0 || source >= sourceCount:
            panic("parser value expr: token source row out of range")
        if ParserValueExprTokenLexicalParentIndexAt(
               tree, tokenIndex) < 0:
            primaryCounts[source] = primaryCounts[source] + 1
        else:
            childCounts[source] = childCounts[source] + 1
    var cursor = 0
    for sourceIndex in 0..<sourceCount:
        primaryStarts[sourceIndex] = cursor
        cursor = cursor + primaryCounts[sourceIndex]
        childStarts[sourceIndex] = cursor
        cursor = cursor + childCounts[sourceIndex]

@borrows
fn parserValueExprTokenIndexBinarySearch(
        tree: ParserValueExprTree,
        rangeStart: int32,
        rangeCount: int32,
        matchName: bool,
        key: int32): int32 =
    if rangeCount <= 0 || key < 0:
        return -1
    var low = rangeStart
    var high = rangeStart + rangeCount - 1
    var found = -1
    while low <= high:
        let mid = low + (high - low) / 2
        var midKey: int32 = -1
        if matchName:
            midKey = ParserValueExprTokenStartAt(tree, mid)
        else:
            midKey = ParserValueExprTokenEndAt(tree, mid)
        if midKey < key:
            low = mid + 1
        elif midKey > key:
            high = mid - 1
        else:
            found = mid
            low = mid + 1
    return found

@borrows
fn ParserValueExprCallPositionWithRanges(
        tree: ParserValueExprTree,
        nodeIndex: int32,
        primaryStarts: int32[],
        primaryCounts: int32[],
        childStarts: int32[],
        childCounts: int32[],
        lineOut: var int32,
        columnOut: var int32,
        endLineOut: var int32,
        endColumnOut: var int32): bool =
    lineOut = -1
    columnOut = -1
    endLineOut = -1
    endColumnOut = -1
    ParserValueExprRequireNode(tree, nodeIndex)
    let source = ParserValueExprNodeProducerSourceIndexAt(
        tree, nodeIndex)
    if source < 0 || source >= tree.producerSourceCount:
        panic("parser value expr: node source row out of range")
    let nameStart = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.nameStarts, nodeIndex)
    let nodeEnd = ParserValueExprNodeSpanEndAt(tree, nodeIndex)
    if nameStart < 0:
        return false
    let primaryStart = primaryStarts[source]
    let primaryCount = primaryCounts[source]
    let childStart = childStarts[source]
    let childCount = childCounts[source]
    var nameToken = parserValueExprTokenIndexBinarySearch(
        tree, primaryStart, primaryCount, true, nameStart)
    let childNameToken = parserValueExprTokenIndexBinarySearch(
        tree, childStart, childCount, true, nameStart)
    if childNameToken > nameToken:
        nameToken = childNameToken
    var endToken = parserValueExprTokenIndexBinarySearch(
        tree, primaryStart, primaryCount, false, nodeEnd)
    let childEndToken = parserValueExprTokenIndexBinarySearch(
        tree, childStart, childCount, false, nodeEnd)
    if childEndToken > endToken:
        endToken = childEndToken
    if nameToken < 0 || endToken < 0:
        return false
    lineOut = ParserValueExprTokenLineAt(tree, nameToken)
    columnOut = ParserValueExprTokenColumnAt(tree, nameToken)
    endLineOut = ParserValueExprTokenLineAt(tree, endToken)
    endColumnOut = ParserValueExprTokenColumnAt(tree, endToken)
    return true

@borrows
fn ParserValueExprCallPosition(tree: ParserValueExprTree,
                                 nodeIndex: int32,
                                 lineOut: var int32,
                                 columnOut: var int32,
                                 endLineOut: var int32,
                                 endColumnOut: var int32): bool =
    lineOut = -1
    columnOut = -1
    endLineOut = -1
    endColumnOut = -1
    ParserValueExprRequireNode(tree, nodeIndex)
    let sourceId = ParserValueExprNodeSourceIdAt(tree, nodeIndex)
    let nameStart = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.nameStarts, nodeIndex)
    let nodeEnd = ParserValueExprNodeSpanEndAt(tree, nodeIndex)
    if nameStart < 0:
        return false
    for tokenIndex in 0..<tree.tokenCount:
        if ParserValueExprTokenSourceIdAt(tree, tokenIndex) != sourceId:
            continue
        if ParserValueExprTokenStartAt(tree, tokenIndex) == nameStart:
            lineOut = ParserValueExprTokenLineAt(tree, tokenIndex)
            columnOut = ParserValueExprTokenColumnAt(tree, tokenIndex)
        if ParserValueExprTokenEndAt(tree, tokenIndex) == nodeEnd:
            endLineOut = ParserValueExprTokenLineAt(tree, tokenIndex)
            endColumnOut = ParserValueExprTokenColumnAt(tree, tokenIndex)
        if lineOut > 0 && endLineOut > 0:
            return true
    return false

fn ParserValueExprBindNormalizedCall(layer: var NormalizedExprLayer,
                                       nodeIndex: int32,
                                       exprStart: int32,
                                       endLineNumber: int32,
                                       endColumnNumber: int32) =
    if layer.exprs.len != exprStart + 1:
        panic("parser value expr: call event did not append exactly one fact")
    layer.exprs[exprStart].valueExprCallNodeIndex = nodeIndex
    layer.exprs[exprStart].originParserNodeId = nodeIndex
    layer.exprs[exprStart].callArgValueRootStart =
        ParserValueExprNodeArgumentRootStart(
            layer.valueExprTree, nodeIndex)
    layer.exprs[exprStart].callArgValueRootCount =
        ParserValueExprNodeArgumentRootCount(
            layer.valueExprTree, nodeIndex)
    layer.exprs[exprStart].endLineNumber = endLineNumber
    layer.exprs[exprStart].endColumnNumber = endColumnNumber

fn ParserValueExprBindDedicatedNormalizedCall(
        layer: var NormalizedExprLayer,
        nodeIndex: int32,
        callName: str,
        lineNumber: int32,
        columnNumber: int32,
        endLineNumber: int32,
        endColumnNumber: int32): bool =
    for exprIndex in 0..<layer.exprs.len:
        if layer.exprs[exprIndex].lineNumber != lineNumber ||
           layer.exprs[exprIndex].columnNumber != columnNumber ||
           layer.exprs[exprIndex].surfaceText != callName:
            continue
        if layer.exprs[exprIndex].kind != NormalizedExprResultIntrinsic &&
           layer.exprs[exprIndex].kind != NormalizedExprStrFormat:
            continue
        if layer.exprs[exprIndex].valueExprCallNodeIndex >= 0:
            panic("parser value expr: dedicated call fact bound more than once")
        var expr = layer.exprs[exprIndex]
        let callArgsText = ParserValueExprNodeCallArgsText(
            layer.valueExprTree, nodeIndex)
        let callArgCount = ParserValueExprNodeArgumentRootCount(
            layer.valueExprTree, nodeIndex)
        if ParserCountTopLevelArgs(callArgsText) != callArgCount:
            panic("parser value expr: dedicated call argument text/root cardinality drift")
        expr.callSurfaceKind = NormalizedExprSurfaceCallLocal
        expr.callResolved = true
        expr.callReason = NormalizedExprCallReasonNone
        expr.callCallee = share(callName)
        expr.callTarget = callName
        expr.callPrefixStyle = ParserValueExprNodeKindAt(
            layer.valueExprTree, nodeIndex) == ParserValueExprSpaceCall
        expr.callArgCount = callArgCount
        expr.callArgsText = callArgsText
        expr.valueExprCallNodeIndex = nodeIndex
        expr.originParserNodeId = nodeIndex
        expr.callArgValueRootStart = ParserValueExprNodeArgumentRootStart(
            layer.valueExprTree, nodeIndex)
        expr.callArgValueRootCount = ParserValueExprNodeArgumentRootCount(
            layer.valueExprTree, nodeIndex)
        expr.endLineNumber = endLineNumber
        expr.endColumnNumber = endColumnNumber
        layer.exprs[exprIndex] = expr
        if layer.exprs[exprIndex].kind == NormalizedExprIf && layer.exprs[exprIndex].lineNumber == 0 && layer.exprs[exprIndex].sourcePath == "":
            panic("parser value expr: W3 zero writeback idx={exprIndex} total={layer.exprs.len}")
        return true
    return false

fn ParserValueExprStatementAnchorHash(
        lineNumber: int32,
        columnNumber: int32,
        role: ParserValueExprStatementRole,
        bucketCount: int32): int32 =
    if lineNumber <= 0 || columnNumber <= 0 ||
       role == ParserValueExprStatementInvalid || bucketCount <= 0:
        return -1
    var hash = lineNumber * 1000003 + columnNumber * 97 + Int32(role)
    if hash < 0:
        hash = -hash
    return hash & (bucketCount - 1)

@borrows
fn ParserValueExprNormalizedStatementRole(
        expr: NormalizedExpr): ParserValueExprStatementRole =
    if expr.kind == NormalizedExprReturn:
        return ParserValueExprStatementReturnValue
    if expr.kind == NormalizedExprAssign:
        return ParserValueExprStatementAssignmentRhs
    if expr.kind == NormalizedExprIfStmt ||
       expr.kind == NormalizedExprElifStmt ||
       expr.kind == NormalizedExprWhileStmt ||
       expr.kind == NormalizedExprMatchStmt ||
       expr.kind == NormalizedExprCaseStmt:
        return ParserValueExprStatementCondition
    if expr.kind == NormalizedExprForStmt:
        return ParserValueExprStatementLoopSource
    # B6: break/continue/defer 行身份跟随本轮的终止语句根事件
    # (role=Expression, else 行记 Condition 同款先例)。
    if expr.kind == NormalizedExprBreakStmt ||
       expr.kind == NormalizedExprContinueStmt ||
       expr.kind == NormalizedExprDeferStmt:
        return ParserValueExprStatementExpression
    return ParserValueExprStatementInvalid

# A statement whose exact parser root is itself a call must carry that same
# node as its call origin.  ParserValueExprAppendNode registers every Call and
# SpaceCall node in the call-event sidecar, so the node kind is the producer
# authority; no source text or callee spelling participates in this binding.
@borrows
fn ParserValueExprBindRootCallIdentity(
        tree: ParserValueExprTree,
        rootNodeIndex: int32,
        expr: var NormalizedExpr) =
    let rootKind = ParserValueExprNodeKindAt(tree, rootNodeIndex)
    if rootKind != ParserValueExprCall &&
       rootKind != ParserValueExprSpaceCall:
        return
    let argumentRootStart = ParserValueExprNodeArgumentRootStart(
        tree, rootNodeIndex)
    let argumentRootCount = ParserValueExprNodeArgumentRootCount(
        tree, rootNodeIndex)
    if expr.valueExprCallNodeIndex >= 0:
        if expr.valueExprCallNodeIndex != rootNodeIndex:
            panic("parser value expr: statement root call identity conflict")
        if expr.originParserNodeId != rootNodeIndex:
            panic("parser value expr: statement root call origin conflict")
        if expr.callArgValueRootStart != argumentRootStart ||
           expr.callArgValueRootCount != argumentRootCount:
            panic("parser value expr: statement root call argument identity conflict")
    elif expr.callArgValueRootStart != -1 ||
         expr.callArgValueRootCount != 0:
        panic("parser value expr: call argument identity has no call origin")
    expr.valueExprCallNodeIndex = rootNodeIndex
    expr.originParserNodeId = rootNodeIndex
    expr.callArgValueRootStart = argumentRootStart
    expr.callArgValueRootCount = argumentRootCount

fn ParserValueExprBindStatementRootEvent(
        layer: var NormalizedExprLayer,
        exprIndex: int32,
        eventIndex: int32) =
    if exprIndex < 0 || exprIndex >= layer.exprs.len:
        panic("parser value expr: statement binding expression out of bounds")
    let rootNodeIndex = ParserValueExprStatementRootNodeAt(
        layer.valueExprTree, eventIndex)
    let role = ParserValueExprStatementRootRoleAt(
        layer.valueExprTree, eventIndex)
    var expr = layer.exprs[exprIndex]
    if expr.valueExprRootNodeIndex >= 0 &&
       expr.valueExprRootNodeIndex != rootNodeIndex:
        panic("parser value expr: normalized statement bound to two roots")
    expr.valueExprRootNodeIndex = rootNodeIndex
    expr.valueExprSpanStart = ParserValueExprNodeSpanStartAt(
        layer.valueExprTree, rootNodeIndex)
    expr.valueExprSpanEnd = ParserValueExprNodeSpanEndAt(
        layer.valueExprTree, rootNodeIndex)
    expr.valueExprStatementRole = role
    ParserValueExprBindRootCallIdentity(
        layer.valueExprTree, rootNodeIndex, expr)
    layer.exprs[exprIndex] = expr
    if layer.exprs[exprIndex].kind == NormalizedExprIf && layer.exprs[exprIndex].lineNumber == 0 && layer.exprs[exprIndex].sourcePath == "":
        panic("parser value expr: W4 zero writeback idx={exprIndex} total={layer.exprs.len}")

fn ParserValueExprBindEnclosingStatementRootEvent(
        layer: var NormalizedExprLayer,
        exprIndex: int32,
        eventIndex: int32) =
    if exprIndex < 0 || exprIndex >= layer.exprs.len ||
       eventIndex < 0 ||
       eventIndex >= layer.valueExprTree.statementRootCount:
        panic("parser value expr: enclosing statement binding out of bounds")
    var expr = layer.exprs[exprIndex]
    if expr.valueExprCallNodeIndex < 0 ||
       ParserValueExprNodeEnclosingStatementRootEventAt(
           layer.valueExprTree,
           expr.valueExprCallNodeIndex) != eventIndex:
        panic("parser value expr: enclosing statement binding authority mismatch")
    let rootNodeIndex = ParserValueExprStatementRootNodeAt(
        layer.valueExprTree, eventIndex)
    if expr.valueExprCallNodeIndex == rootNodeIndex:
        panic("parser value expr: direct statement root used enclosing binding")
    if expr.valueExprRootNodeIndex >= 0 &&
       expr.valueExprRootNodeIndex != rootNodeIndex:
        panic("parser value expr: nested call bound to two statement roots")
    expr.valueExprRootNodeIndex = rootNodeIndex
    expr.valueExprSpanStart = ParserValueExprNodeSpanStartAt(
        layer.valueExprTree, rootNodeIndex)
    expr.valueExprSpanEnd = ParserValueExprNodeSpanEndAt(
        layer.valueExprTree, rootNodeIndex)
    expr.valueExprStatementRole = ParserValueExprStatementRootRoleAt(
        layer.valueExprTree, eventIndex)
    layer.exprs[exprIndex] = expr
    if layer.exprs[exprIndex].kind == NormalizedExprIf && layer.exprs[exprIndex].lineNumber == 0 && layer.exprs[exprIndex].sourcePath == "":
        panic("parser value expr: W5 zero writeback idx={exprIndex} total={layer.exprs.len}")

# Bind parser statement roots to normalized facts in O(nodes + roots + facts).
# Exact call-node identity wins; non-call statement sidecars use the parser's
# keyword/operator anchor.  No RHS text comparison or source-line recovery is
# involved, including multiline assignments and return constructors.
fn ParserValueExprBindStatementRoots(layer: var NormalizedExprLayer) =
    let tree = layer.valueExprTree
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        panic("parser value expr: statement root binding requires active tree")

fn ParserValueExprStampSidecarRow(expr: var NormalizedExpr,
                                   nodeIndex: int32,
                                   role: ParserValueExprStatementRole,
                                   spanStart: int32,
                                   spanEnd: int32) =
    # 幽灵槽根修(判词 45): StampStrFormatFacts 函数本体内对
    # layer.exprs[i] 的 store——整体 struct 写回与逐字段直存两种形状——
    # 均被自宿主后端误编译为错址/清零写(W7X 探针: 整体写回时
    # target=468 zeroIdx=467, 改字段直存后 target=0/37 zeroIdx=target,
    # 受害者随代码布局漂移)。BindNormalizedCall 同形 helper(store 落在
    # 独立函数上下文)在同一二进制内被 EVEND 全量扫描证明写址正确,
    # 故把 stamp store 移入独立函数上下文。真根因=该函数上下文的
    # seq 元素 store 地址推导缺陷, 归 kernel 战役 emitter。
    expr.originParserNodeId = nodeIndex
    expr.valueExprRootNodeIndex = nodeIndex
    expr.valueExprStatementRole = role
    expr.valueExprSpanStart = spanStart
    expr.valueExprSpanEnd = spanEnd

# StrFormat fact rows are appended by the legacy line scanner with no parser
# node identity and role Invalid, so BindStatementRoots can never claim them
# (role gate) and the parser receipt rejects every file carrying any Fmt
# literal.  Stamp each unclaimed StrFormat row with the parser-owned FmtLiteral
# node at the same source anchor: the row's (line, column) IS the Fmt token's
# start, unique per position.  Role follows the literal's own statement-root
# event when it is itself a root (`return Fmt"..."`), else plain Expression.
fn ParserValueExprStampStrFormatFacts(layer: var NormalizedExprLayer) =
    let tree = layer.valueExprTree
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        panic("parser value expr: str format stamping requires active tree")
    # t2fix: 包含绑定端点缓存 (惰性一次性构建, 本函数三条接线跨调用复用)。
    # stamping 全程 tree 行只读 (绑定仅写 layer.exprs), 端点值构建一次恒定;
    # 空表 = 未构建, 由包含绑定臂首次调用时构建。见
    # ParserValueExprContainingEventEndpointsBuild 注释。
    var containmentStartLines: int32[]
    var containmentStartColumns: int32[]
    var containmentEndLines: int32[]
    var containmentEndColumns: int32[]
    for s1ScanIndex in 0..<layer.exprs.len:
        if layer.exprs[s1ScanIndex].kind == NormalizedExprIf &&
           layer.exprs[s1ScanIndex].lineNumber == 0 &&
           layer.exprs[s1ScanIndex].sourcePath == "":
            panic(Fmt"parser value expr: S1 zero slot at stamp entry idx={s1ScanIndex} total={layer.exprs.len} cap={layer.exprs.cap}")
    for nodeIndex in 0..<tree.nodeCount:
        if ParserValueExprNodeKindAt(tree, nodeIndex) !=
               ParserValueExprFmtLiteral:
            continue
        let sourceTextId = ParserValueExprNodeSourceIdAt(tree, nodeIndex)
        let spanStart = ParserValueExprNodeSpanStartAt(tree, nodeIndex)
        var lineNumber: int32
        var columnNumber: int32
        var anchored = false
        for tokenIndex in 0..<tree.tokenCount:
            if ParserValueExprTokenSourceIdAt(tree, tokenIndex) !=
                   sourceTextId:
                continue
            if ParserValueExprTokenStartAt(tree, tokenIndex) == spanStart:
                lineNumber = ParserValueExprTokenLineAt(tree, tokenIndex)
                columnNumber = ParserValueExprTokenColumnAt(tree, tokenIndex)
                anchored = true
                break
        if !anchored:
            continue
        var role = ParserValueExprStatementExpression
        let eventIndex = ParserValueExprNodeDirectStatementRootEventAt(
            tree, nodeIndex)
        if eventIndex >= 0:
            role = ParserValueExprStatementRootRoleAt(tree, eventIndex)
        for exprIndex in 0..<layer.exprs.len:
            if layer.exprs[exprIndex].kind != NormalizedExprStrFormat ||
               layer.exprs[exprIndex].lineNumber != lineNumber ||
               layer.exprs[exprIndex].columnNumber != columnNumber ||
               layer.exprs[exprIndex].valueExprRootNodeIndex >= 0:
                continue
            # 幽灵槽根修(判词 45): stamp store 移入独立函数上下文,
            # 见 ParserValueExprStampSidecarRow 注释。
            var sidecarExpr = layer.exprs[exprIndex]
            ParserValueExprStampSidecarRow(sidecarExpr,
                                            nodeIndex,
                                            role,
                                            ParserValueExprNodeSpanStartAt(
                                                tree, nodeIndex),
                                            ParserValueExprNodeSpanEndAt(
                                                tree, nodeIndex))
            layer.exprs[exprIndex] = sidecarExpr
    for s2ScanIndex in 0..<layer.exprs.len:
        if layer.exprs[s2ScanIndex].kind == NormalizedExprIf &&
           layer.exprs[s2ScanIndex].lineNumber == 0 &&
           layer.exprs[s2ScanIndex].sourcePath == "":
            panic(Fmt"parser value expr: S2 zero slot after W6 section idx={s2ScanIndex} total={layer.exprs.len} cap={layer.exprs.cap}")
    # IfStmt/ElseStmt 等 structured seed 只有 anchor token、没有 parser
    # node，receipt 对 kind=14 等一律拒。If/Elif/While 绑同行列条件根；
    # Else 继承同列最近先行 If/Elif 的节点（规范：else 不是独立语句）。
    if tree.statementRootCount > 0:
        for exprIndex in 0..<layer.exprs.len:
            if !ParserNormalizedExprKindIsSidecarStructured(
                   layer.exprs[exprIndex].kind) ||
               layer.exprs[exprIndex].valueExprRootNodeIndex >= 0:
                continue
            var expr = layer.exprs[exprIndex]
            if expr.kind == NormalizedExprIf && expr.lineNumber == 0 &&
               expr.sourcePath == "":
                panic(Fmt"parser value expr: R7 W7 read zero snapshot idx={exprIndex}")
            var nodeIndex = -1
            let role = ParserValueExprNormalizedStatementRole(expr)
            if role != ParserValueExprStatementInvalid:
                for eventIndex in 0..<tree.statementRootCount:
                    if ParserValueExprStatementRootRoleAt(
                           tree, eventIndex) != role ||
                       ParserValueExprStatementRootAnchorLineAt(
                           tree, eventIndex) != expr.lineNumber ||
                       ParserValueExprStatementRootAnchorColumnAt(
                           tree, eventIndex) != expr.columnNumber:
                        continue
                    nodeIndex = ParserValueExprStatementRootNodeAt(
                        tree, eventIndex)
                    break
            if nodeIndex < 0 &&
               (expr.kind == NormalizedExprElseStmt ||
                expr.kind == NormalizedExprElifStmt):
                for prev in 0..<exprIndex:
                    if (layer.exprs[prev].kind != NormalizedExprIfStmt &&
                        layer.exprs[prev].kind != NormalizedExprElifStmt) ||
                       layer.exprs[prev].columnNumber != expr.columnNumber ||
                       layer.exprs[prev].sourcePath != expr.sourcePath ||
                       layer.exprs[prev].lineNumber >= expr.lineNumber ||
                       layer.exprs[prev].valueExprRootNodeIndex < 0:
                        continue
                    nodeIndex = layer.exprs[prev].valueExprRootNodeIndex
            # W7X 根修(B4): 上面 `var expr = layer.exprs[exprIndex]` 的
            # 元素读拷贝被自宿主后端下成破坏性 move(拷贝后源槽清零; B4
            # 探针 census 实证 226/226 stamp 的 store 前快照 firstZero=
            # target, W6/W7 两段同款)。命中路径随后的整体写回会无条件
            # 修复源槽; 本 continue 是全循环唯一读后不写回的路径, 零槽
            # 由此泄漏给下一次 W7X 扫描(forest target=640 zeroIdx=639)。
            # 写回未修改的 expr 修复源槽; 健康二进制上是无观察效果的
            # 同值写回。真根因=托管 struct seq 元素读的破坏性 move 下沉
            # 缺陷, 归 kernel 战役 emitter(判词 45 同族)。
            if nodeIndex < 0:
                # B16 根修: 精确查找与 Else/Elif 继承臂都不中时走结构化包含
                # 绑定, 见 ParserValueExprBindRangeToContainingStatementEvent
                # 注释 (B16 扩形段)。跨行 if-ternary 绑定初式的 IfStmt 种子
                # 事实锚在 if token 真实行列 (种子取行产线无缺口), 所属语句
                # 根事件却锚在 let token (role=BindingInitializer) —— 事件锚
                # ≠事实锚, 精确查找必不中; 根表达式 span 覆盖事实 (line,col)
                # 即所属语句, 零/多命中维持 -1 原样交 receipt 定谳。
                # 调用前先写回修复源槽 (W7X 同款纪律: 循环顶部元素读拷贝被
                # 自宿主后端下成破坏性 move, 源槽清零; 包含臂在函数内按索引
                # 重读槽位, 不先修复会拿到 (0,0) 使包含全不中)。expr 单次
                # 消费: 双 store 会被烤制编译器 exact-owner 验证拒绝 (v2 实
                # 证); 不绑定路径槽位保持写回后的未修改值 (函数 false 路仅
                # 标量读, 不动槽)。
                layer.exprs[exprIndex] = expr
                if ParserValueExprBindRangeToContainingStatementEvent(
                       layer, exprIndex,
                       containmentStartLines, containmentStartColumns,
                       containmentEndLines, containmentEndColumns):
                    continue
                continue
            var stampedRole = role
            if stampedRole == ParserValueExprStatementInvalid:
                # Else 继承绑定的是先行 If/Elif 的条件根；ElseStmt 在权威
                # 映射中无独立 role（规范：else 不是独立语句），随条件根
                # 记 Condition。
                stampedRole = ParserValueExprStatementCondition
            ParserValueExprStampSidecarRow(expr,
                                            nodeIndex,
                                            stampedRole,
                                            ParserValueExprNodeSpanStartAt(
                                                tree, nodeIndex),
                                            ParserValueExprNodeSpanEndAt(
                                                tree, nodeIndex))
            layer.exprs[exprIndex] = expr
            for w7xScanIndex in 0..<layer.exprs.len:
                if layer.exprs[w7xScanIndex].kind == NormalizedExprIf &&
                   layer.exprs[w7xScanIndex].lineNumber == 0 &&
                   layer.exprs[w7xScanIndex].sourcePath == "":
                    panic(Fmt"parser value expr: W7X zero slot after writeback target={exprIndex} zeroIdx={w7xScanIndex} total={layer.exprs.len} cap={layer.exprs.cap}")

    for s3ScanIndex in 0..<layer.exprs.len:
        if layer.exprs[s3ScanIndex].kind == NormalizedExprIf &&
           layer.exprs[s3ScanIndex].lineNumber == 0 &&
           layer.exprs[s3ScanIndex].sourcePath == "":
            panic(Fmt"parser value expr: S3 zero slot after W7 section idx={s3ScanIndex} total={layer.exprs.len} cap={layer.exprs.cap}")
    if tree.statementRootCount <= 0:
        return
    var rootEventByNode: int32[]
    setLen(rootEventByNode, tree.nodeCount)
    for nodeIndex in 0..<rootEventByNode.len:
        rootEventByNode[nodeIndex] = -1
    if tree.statementRootCount > 1073741823:
        panic("parser value expr: statement root anchor index overflow")
    let requiredBucketCount = tree.statementRootCount * 2
    var bucketCount: int32 = 1
    while bucketCount < requiredBucketCount:
        if bucketCount > 1073741823:
            panic("parser value expr: statement root anchor index overflow")
        bucketCount = bucketCount * 2
    var bucketHeads: int32[]
    setLen(bucketHeads, bucketCount)
    for bucketIndex in 0..<bucketHeads.len:
        bucketHeads[bucketIndex] = -1
    var next: int32[]
    setLen(next, tree.statementRootCount)
    for eventIndex in 0..<tree.statementRootCount:
        let rootNodeIndex = ParserValueExprStatementRootNodeAt(tree,
                                                                eventIndex)
        if rootEventByNode[rootNodeIndex] >= 0:
            panic("parser value expr: node is root of two statement events")
        rootEventByNode[rootNodeIndex] = eventIndex
        let role = ParserValueExprStatementRootRoleAt(tree, eventIndex)
        let lineNumber = ParserValueExprStatementRootAnchorLineAt(
            tree, eventIndex)
        let columnNumber = ParserValueExprStatementRootAnchorColumnAt(
            tree, eventIndex)
        let bucket = ParserValueExprStatementAnchorHash(
            lineNumber, columnNumber, role, bucketCount)
        if bucket < 0:
            panic("parser value expr: invalid statement root anchor")
        next[eventIndex] = bucketHeads[bucket]
        bucketHeads[bucket] = eventIndex
    # EARLY 相位插桩 (零调用边字面量): 零值槽在绑定前已存在=merge 层产物;
    # 绑定后新出现=绑定层产物。
    for scanIndex in 0..<layer.exprs.len:
        if layer.exprs[scanIndex].lineNumber == 0 &&
           layer.exprs[scanIndex].kind == NormalizedExprIf:
            panic(Fmt"parser value expr: EARLY zero If slot before binding idx={scanIndex} total={layer.exprs.len} cap={layer.exprs.cap}")

    for exprIndex in 0..<layer.exprs.len:
        if layer.exprs[exprIndex].valueExprRootNodeIndex >= 0:
            if layer.exprs[exprIndex].valueExprStatementRole ==
                   ParserValueExprStatementInvalid:
                # 零值槽防御跳过: 上游生命周期缺陷产物无语义, 安全略过
                continue
            continue
        let callNodeIndex = layer.exprs[exprIndex].valueExprCallNodeIndex
        if callNodeIndex >= 0:
            if callNodeIndex >= rootEventByNode.len:
                panic("parser value expr: normalized call node out of bounds")
            let callRootEvent = rootEventByNode[callNodeIndex]
            if callRootEvent >= 0:
                ParserValueExprBindStatementRootEvent(layer,
                                                       exprIndex,
                                                       callRootEvent)
                continue
            let enclosingRootEvent =
                ParserValueExprNodeEnclosingStatementRootEventAt(
                    tree, callNodeIndex)
            if enclosingRootEvent >= 0:
                ParserValueExprBindEnclosingStatementRootEvent(
                    layer, exprIndex, enclosingRootEvent)
                continue
        let role = ParserValueExprNormalizedStatementRole(
            layer.exprs[exprIndex])
        if role == ParserValueExprStatementInvalid:
            # B19 根修: 表达式位的裸 if 关键字行 (行扫描 appendIfExprs 产物,
            # 锚=if token 真实行列) 零绑定路 —— role 映射 Invalid 使精确锚
            # 查找不运行; if 不在语句位则无 Condition 语句根事件
            # (StampConditionFact 无触发点); 物理行首是 let 则无 kind=12
            # 结构化种子 (B16 同位随绑无触发种子)。单行 `let x = if c: a
            # else: b` 形 root/origin 恒 -1 泄漏成 receipt 判词
            # (cleanup_cfg:15735 前沿)。接 B15 包含绑定臂 (B16 已扩形为
            # 任意锚事实): 根表达式 byte span 覆盖事实 (line,col) 的唯一
            # 语句根事件即所属语句, 经 ParserValueExprBindStatementRootEvent
            # 取得与 B15/B16 臂完全一致身份; 零/多命中维持 -1 原样交
            # receipt 定谳 (fail-closed 不夺判定权)。健康形 keyword 行已被
            # StampConditionFact 认领 (root>=0) 在本循环顶部跳过, 本臂只见
            # 未认领行。
            if layer.exprs[exprIndex].kind == NormalizedExprIf &&
               layer.exprs[exprIndex].detailKind ==
                   NormalizedExprDetailIfKeyword &&
               ParserValueExprBindRangeToContainingStatementEvent(
                   layer, exprIndex,
                   containmentStartLines, containmentStartColumns,
                   containmentEndLines, containmentEndColumns):
                continue
            continue
        let bucket = ParserValueExprStatementAnchorHash(
            layer.exprs[exprIndex].lineNumber,
            layer.exprs[exprIndex].columnNumber,
            role,
            bucketCount)
        if bucket < 0:
            panic("parser value expr: normalized statement anchor invalid")
        var eventIndex = bucketHeads[bucket]
        var matchedEvent: int32 = -1
        while eventIndex >= 0:
            if ParserValueExprStatementRootRoleAt(tree, eventIndex) == role &&
               ParserValueExprStatementRootAnchorLineAt(tree, eventIndex) ==
                   layer.exprs[exprIndex].lineNumber &&
               ParserValueExprStatementRootAnchorColumnAt(tree, eventIndex) ==
                   layer.exprs[exprIndex].columnNumber:
                if matchedEvent >= 0:
                    panic("parser value expr: duplicate statement root anchor")
                matchedEvent = eventIndex
            eventIndex = next[eventIndex]
        if matchedEvent >= 0:
            ParserValueExprBindStatementRootEvent(layer,
                                                   exprIndex,
                                                   matchedEvent)

    # Range (`a..<b` / `a..b`) 是表达式级归一化条目, 无独立语句根角色;
    # 其语句锚 = 出现该 range 的语句 (for 的 LoopSource / 生成式 / 赋值)。
    # 绑定用【字段级直写】——整 struct 拷贝读写含 str 字段 (托管 struct
    # 按值拷贝, 六墙族), 本轮实测疑似其副作用; int 字段间直传零拷贝。
    for rangeIndex in 0..<layer.exprs.len:
        if layer.exprs[rangeIndex].kind != NormalizedExprRange:
            continue
        if layer.exprs[rangeIndex].valueExprRootNodeIndex >= 0:
            continue
        let rangeLine = layer.exprs[rangeIndex].lineNumber
        var donorIndex: int32 = -1
        var donorCount: int32
        for donorScan in 0..<layer.exprs.len:
            let donorLine = layer.exprs[donorScan].lineNumber
            if donorLine != rangeLine:
                continue
            if layer.exprs[donorScan].valueExprRootNodeIndex < 0:
                continue
            let donorKind = layer.exprs[donorScan].kind
            if donorKind == NormalizedExprForStmt ||
               donorKind == NormalizedExprComprehension:
                donorIndex = donorScan
                donorCount = 1
                continue
            donorCount = donorCount + 1
        if donorIndex < 0 && donorCount == 1:
            var fallbackScan: int32
            while fallbackScan < layer.exprs.len:
                let donorLine2 = layer.exprs[fallbackScan].lineNumber
                let donorKind2 = layer.exprs[fallbackScan].kind
                if donorLine2 == rangeLine &&
                   layer.exprs[fallbackScan].valueExprRootNodeIndex >= 0 &&
                   donorKind2 != NormalizedExprRange:
                    donorIndex = fallbackScan
                fallbackScan = fallbackScan + 1
        if donorIndex < 0:
            # B15 根修: 跨行语句头的 Range 事实走结构化包含绑定, 见
            # ParserValueExprBindRangeToContainingStatementEvent 注释。
            if !ParserValueExprBindRangeToContainingStatementEvent(
                   layer, rangeIndex,
                   containmentStartLines, containmentStartColumns,
                   containmentEndLines, containmentEndColumns):
                continue
            continue
        if layer.exprs[donorIndex].valueExprStatementRole ==
               ParserValueExprStatementInvalid:
            continue
        layer.exprs[rangeIndex].valueExprRootNodeIndex =
            layer.exprs[donorIndex].valueExprRootNodeIndex
        layer.exprs[rangeIndex].valueExprSpanStart =
            layer.exprs[donorIndex].valueExprSpanStart
        layer.exprs[rangeIndex].valueExprSpanEnd =
            layer.exprs[donorIndex].valueExprSpanEnd
        layer.exprs[rangeIndex].valueExprStatementRole =
            layer.exprs[donorIndex].valueExprStatementRole
        if layer.exprs[rangeIndex].originParserNodeId < 0:
            layer.exprs[rangeIndex].originParserNodeId =
                layer.exprs[donorIndex].originParserNodeId

# t2fix: 包含判定端点的一次性索引化。原实现对每个语句根事件做全量 token
# 扫描 (事件数×token 数, 无早退), cleanup_cfg 规模源上每个未命中事实付出
# 秒级代价 —— t2_pre_observe 段 33s→853s+ 回归的唯一来源 (B15/B16/B19 三
# 接线共用本臂)。判定语义逐位不变: 端点值 = 原 token walk 的锁存值, 即
# 「同 sourceId 且 TokenStartAt==spanStart (终点: TokenEndAt==spanEnd) 的
# 最小 tokenIndex 行」的 (line,col); 构建一次 (token·log token + 事件),
# 之后每次包含判定 O(事件)。排序键 (sourceId, offset) + 稳定归并 (并列保持
# tokenIndex 升序) + 二分精确查找 ⇒ 对任意 token 行序都与原 walk 同值;
# 未反查到记 -1 (与原 walk 未命中同形)。tree 行在 stamping 全程只读
# (绑定仅写 layer.exprs), 缓存跨调用恒定。
@borrows
fn ParserValueExprEndpointTokenLookup(
        order: var int32[],
        keySources: var int32[],
        keyOffsets: var int32[],
        sourceId: int32,
        offset: int32): int32 =
    var low: int32
    var high: int32 = order.len
    while low < high:
        let middle = low + (high - low) / 2
        let tokenIndex = order[middle]
        if keySources[tokenIndex] < sourceId ||
           (keySources[tokenIndex] == sourceId &&
            keyOffsets[tokenIndex] < offset):
            low = middle + 1
        else:
            high = middle
    if low < order.len:
        let tokenIndex = order[low]
        if keySources[tokenIndex] == sourceId &&
           keyOffsets[tokenIndex] == offset:
            return tokenIndex
    return -1

# t2fix: (sourceId, offset) 键的稳定归并排序 —— 并列键保持原 tokenIndex
# 升序 (相等取左臂), 保证查找命中「最小 tokenIndex」与原 walk 首次锁存
# 同一行。自底向上, 辅助缓冲合并后回拷同区间; 尾部无右 run 的段不动。
@borrows
fn ParserValueExprEndpointOrderSort(
        order: var int32[],
        keySources: var int32[],
        keyOffsets: var int32[]) =
    let tokenTotal = order.len
    if tokenTotal < 2:
        return
    var merged: int32[]
    setLen(merged, tokenTotal)
    var width: int32 = 1
    while width < tokenTotal:
        var start: int32
        while start < tokenTotal - width:
            let mid = start + width
            var stop = start + (width * 2)
            if stop > tokenTotal:
                stop = tokenTotal
            var left = start
            var right = mid
            var out0 = start
            while left < mid && right < stop:
                let leftToken = order[left]
                let rightToken = order[right]
                if keySources[rightToken] < keySources[leftToken] ||
                   (keySources[rightToken] == keySources[leftToken] &&
                    keyOffsets[rightToken] < keyOffsets[leftToken]):
                    merged[out0] = rightToken
                    right = right + 1
                else:
                    merged[out0] = leftToken
                    left = left + 1
                out0 = out0 + 1
            while left < mid:
                merged[out0] = order[left]
                left = left + 1
                out0 = out0 + 1
            while right < stop:
                merged[out0] = order[right]
                right = right + 1
                out0 = out0 + 1
            var copyBack = start
            while copyBack < stop:
                order[copyBack] = merged[copyBack]
                copyBack = copyBack + 1
            start = start + (width * 2)
        width = width * 2

# t2fix: 端点表构建 —— 起点/终点两相, 共用 scratch (键两列 + 顺序一列,
# 3×token 行 int32, 函数退出即释)。事件表先全量填 -1 (含 rootNode<0 /
# span<0 的事件, 与原 walk 未解锁存同形), 再逐事件二分反查。
@borrows
fn ParserValueExprContainingEventEndpointsBuild(
        tree: ParserValueExprTree,
        startLinesOut: var int32[],
        startColumnsOut: var int32[],
        endLinesOut: var int32[],
        endColumnsOut: var int32[]) =
    if tree.tokenCount <= 0 || tree.statementRootCount <= 0:
        return
    var keySources: int32[]
    var keyOffsets: int32[]
    var order: int32[]
    setLen(keySources, tree.tokenCount)
    setLen(keyOffsets, tree.tokenCount)
    setLen(order, tree.tokenCount)
    setLen(startLinesOut, tree.statementRootCount)
    setLen(startColumnsOut, tree.statementRootCount)
    setLen(endLinesOut, tree.statementRootCount)
    setLen(endColumnsOut, tree.statementRootCount)
    var fillIndex: int32
    while fillIndex < tree.statementRootCount:
        startLinesOut[fillIndex] = -1
        startColumnsOut[fillIndex] = -1
        endLinesOut[fillIndex] = -1
        endColumnsOut[fillIndex] = -1
        fillIndex = fillIndex + 1
    var scan: int32
    while scan < tree.tokenCount:
        keySources[scan] = ParserValueExprTokenSourceIdAt(tree, scan)
        keyOffsets[scan] = ParserValueExprTokenStartAt(tree, scan)
        order[scan] = scan
        scan = scan + 1
    ParserValueExprEndpointOrderSort(order, keySources, keyOffsets)
    var eventIndex: int32
    while eventIndex < tree.statementRootCount:
        let rootNode = ParserValueExprStatementRootNodeAt(tree, eventIndex)
        if rootNode >= 0:
            let spanStartOffset = ParserValueExprNodeSpanStartAt(tree,
                                                                  rootNode)
            let spanEndOffset = ParserValueExprNodeSpanEndAt(tree, rootNode)
            if spanStartOffset >= 0 && spanEndOffset >= 0:
                let nodeSourceId = ParserValueExprNodeSourceIdAt(tree,
                                                                  rootNode)
                let startToken = ParserValueExprEndpointTokenLookup(
                    order, keySources, keyOffsets,
                    nodeSourceId, spanStartOffset)
                if startToken >= 0:
                    startLinesOut[eventIndex] = ParserValueExprTokenLineAt(
                        tree, startToken)
                    startColumnsOut[eventIndex] = ParserValueExprTokenColumnAt(
                        tree, startToken)
        eventIndex = eventIndex + 1
    scan = 0
    while scan < tree.tokenCount:
        keySources[scan] = ParserValueExprTokenSourceIdAt(tree, scan)
        keyOffsets[scan] = ParserValueExprTokenEndAt(tree, scan)
        order[scan] = scan
        scan = scan + 1
    ParserValueExprEndpointOrderSort(order, keySources, keyOffsets)
    eventIndex = 0
    while eventIndex < tree.statementRootCount:
        let rootNode = ParserValueExprStatementRootNodeAt(tree, eventIndex)
        if rootNode >= 0:
            let spanStartOffset = ParserValueExprNodeSpanStartAt(tree,
                                                                  rootNode)
            let spanEndOffset = ParserValueExprNodeSpanEndAt(tree, rootNode)
            if spanStartOffset >= 0 && spanEndOffset >= 0:
                let nodeSourceId = ParserValueExprNodeSourceIdAt(tree,
                                                                  rootNode)
                let endToken = ParserValueExprEndpointTokenLookup(
                    order, keySources, keyOffsets,
                    nodeSourceId, spanEndOffset)
                if endToken >= 0:
                    endLinesOut[eventIndex] = ParserValueExprTokenLineAt(
                        tree, endToken)
                    endColumnsOut[eventIndex] = ParserValueExprTokenColumnAt(
                        tree, endToken)
        eventIndex = eventIndex + 1

# B15 根修: 跨行语句头 Range 事实的结构化绑定兜底。行扫描播种与 donor
# 继承都以「同行」为窗口: `for x in` + 换行 `0..<n:` 的双物理行 for 头
# 里, LoopSource 语句根事件与 ForStmt 锚事实都在 for 关键字行, Range 事实
# 所在续行没有其他事实 —— donor 扫描窗为空 (探针轮 kd_b15probe 实测
# donor_count=0 donor_index=-1), root/origin 恒 -1, 泄漏成 compiler parser
# receipt 判词 (normalized expression parser node missing ... surface=<,
# cleanup_cfg:7028 前沿)。本臂把 donor 段注释的既有意图 (「其语句锚 =
# 出现该 range 的语句」) 结构化落地: 语句根事件的根表达式节点 span 覆盖
# Range 事实 (line, col) 时, 该事件即所属语句 —— 表达式根 span 两两不
# 相交, 覆盖者至多一个。节点 span 是 byte offset (与 TokenStartAt/
# TokenEndAt 同一坐标系, StampStrFormatFacts 的 token 锚定先例), 端点
# (line,col) 经同 sourceId 的 token walk 反查: 起点 TokenStartAt==spanStart,
# 终点 TokenEndAt==spanEnd (span 为半开区间, 终点锚定末 token 的排他端)。
# 命中即经 ParserValueExprBindStatementRootEvent 取得与同行 donor 路完全
# 一致的 root/span/role 身份 (含 root-call origin)。端点未反查到、零命中、
# 多重命中 (产线不变量破坏) 三种情形都维持 -1 原样交 receipt 定谳 (绑定
# 兜底不夺判定权, 不 panic)。
# B16 扩形: 本臂不再限于 Range 循环接线 —— W7 sidecar-structured 段的精确
# (line,col)+role 查找与 Else/Elif 继承臂都不中时同样调用本臂。函数本体
# 只消费事实索引的 (line,col) 并绑所属语句根事件, 对任意 anchor 事实同构;
# 探针轮 kd_b16probe 实证跨行 if-ternary 绑定初式 IfStmt 事实
# (line,col)=if token 真实行列, 全事件表唯一 contains=yes 即锚在 let
# token 的 BindingInitializer 事件。函数名保留 Range 首用史。
fn ParserValueExprBindRangeToContainingStatementEvent(
        layer: var NormalizedExprLayer,
        rangeIndex: int32,
        endpointStartLines: var int32[],
        endpointStartColumns: var int32[],
        endpointEndLines: var int32[],
        endpointEndColumns: var int32[]): bool =
    let tree = layer.valueExprTree
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        return false
    # t2fix: 空表 (未构建 / 事件表为空) 时构建一次; 端点缓存值与原内联
    # token walk 逐位同源 (最小 tokenIndex 锁存), 判定与 fail-closed 代码
    # 原样未动。
    if endpointStartLines.len != tree.statementRootCount:
        ParserValueExprContainingEventEndpointsBuild(
            tree, endpointStartLines, endpointStartColumns,
            endpointEndLines, endpointEndColumns)
    let rangeLine = layer.exprs[rangeIndex].lineNumber
    let rangeColumn = layer.exprs[rangeIndex].columnNumber
    var matchedEvent: int32 = -1
    var eventIndex: int32
    while eventIndex < tree.statementRootCount:
        let rootNode = ParserValueExprStatementRootNodeAt(tree, eventIndex)
        if rootNode >= 0:
            let spanStartOffset = ParserValueExprNodeSpanStartAt(tree, rootNode)
            let spanEndOffset = ParserValueExprNodeSpanEndAt(tree, rootNode)
            if spanStartOffset >= 0 && spanEndOffset >= 0:
                let startLine = endpointStartLines[eventIndex]
                let startColumn = endpointStartColumns[eventIndex]
                let endLine = endpointEndLines[eventIndex]
                let endColumn = endpointEndColumns[eventIndex]
                if startLine >= 0 && endLine >= 0 &&
                   startLine <= rangeLine && rangeLine <= endLine &&
                   (startLine != rangeLine || startColumn <= rangeColumn) &&
                   (endLine != rangeLine || rangeColumn <= endColumn):
                    if matchedEvent >= 0:
                        return false
                    matchedEvent = eventIndex
        eventIndex = eventIndex + 1
    if matchedEvent < 0:
        return false
    ParserValueExprBindStatementRootEvent(layer, rangeIndex, matchedEvent)
    # B16 同位随绑: 结构化种子经包含绑定取得语句身份时, 同 (line,col) 的
    # 裸 if 关键字行 (行扫描产物 NormalizedExprIf/DetailIfKeyword, 真实
    # token 坐标) 归属同一语句根事件 —— 该行健康形由 StampConditionFact 按
    # Condition 事件认领, 但种子走包含绑定的病形 (if 在表达式位, 所属事件
    # 是 BindingInitializer) 没有条件事件可认领它, 会原样泄漏成 receipt
    # 判词 (kind=1 面, 被 kind=12 种子遮掩的下一墙)。Range 事实 (line,col)
    # 处不可能同位存在 if 关键字行, 本段对 B15 接线自然零作用; 已认领行
    # (root>=0) 跳过, 每位至多一行。
    var keywordScan: int32
    while keywordScan < layer.exprs.len:
        if layer.exprs[keywordScan].kind == NormalizedExprIf &&
           layer.exprs[keywordScan].detailKind ==
               NormalizedExprDetailIfKeyword &&
           layer.exprs[keywordScan].lineNumber == rangeLine &&
           layer.exprs[keywordScan].columnNumber == rangeColumn &&
           layer.exprs[keywordScan].sourcePath ==
               layer.exprs[rangeIndex].sourcePath &&
           layer.exprs[keywordScan].valueExprRootNodeIndex < 0:
            ParserValueExprBindStatementRootEvent(layer,
                                                   keywordScan,
                                                   matchedEvent)
            return true
        keywordScan = keywordScan + 1
    return true

# Freeze statement/scope anchor rows while the parser-owned tree and its
# source-local coordinates are still in the same producer transaction.
# Downstream receipts consume these int32 rows directly.
fn ParserValueExprBindNormalizedStructureAnchors(
        layer: var NormalizedExprLayer,
        err: var str): bool =
    let tree = layer.valueExprTree
    if tree == nil ||
       tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.producerSourceCount != 1:
        err = "parser normalized structure: source tree unavailable"
        return false
    for exprIndex in 0..<layer.exprs.len:
        if !ParserNormalizedExprKindIsSidecarStructured(
                layer.exprs[exprIndex].kind) &&
           layer.exprs[exprIndex].kind != NormalizedExprReturn &&
           layer.exprs[exprIndex].kind != NormalizedExprAssign:
            continue
        var expr = layer.exprs[exprIndex]
        var anchorTokenIndex = -1
        if expr.valueExprRootNodeIndex >= 0:
            if expr.valueExprRootNodeIndex >= tree.nodeCount:
                err = "parser normalized structure: root node invalid"
                return false
            let eventIndex = ParserValueExprNodeDirectStatementRootEventAt(
                tree, expr.valueExprRootNodeIndex)
            if eventIndex < 0 ||
               eventIndex >= tree.statementRootCount:
                err = "parser normalized structure: root event missing"
                return false
            # 根事件的 anchor 是根语句自身的关键字（If 条件根 = if 关键
            # 字）。Else/Elif 继承绑定先行 If/Elif 条件根（规范：else 不是
            # 独立语句）时，本行身份是行自身关键字的 frozen anchor——seed
            # 生产者按行 (line, column) 精确冻结，下游 receipt 也按行自身
            # 行列校验 anchor。行自带 frozen anchor 时优先用它；Return/
            # Assign 等无自身关键字行仍取根事件 anchor。身份契约（边界/
            # producer 0/行列一致）对两种来源统一强制。
            if expr.anchorTokenIndex >= 0:
                anchorTokenIndex = expr.anchorTokenIndex
            else:
                anchorTokenIndex =
                    ParserValueExprStatementRootAnchorTokenAt(tree,
                                                              eventIndex)
            if expr.valueExprSpanStart < 0 ||
               expr.valueExprSpanEnd <= expr.valueExprSpanStart:
                err = "parser normalized structure: value span missing"
                return false
        else:
            anchorTokenIndex = expr.anchorTokenIndex
            if anchorTokenIndex < 0 ||
               expr.valueExprSpanStart < 0 ||
               expr.valueExprSpanEnd <= expr.valueExprSpanStart:
                err =
                    "parser normalized structure: frozen anchor missing"
                return false
        if anchorTokenIndex < 0 ||
           anchorTokenIndex >= tree.tokenCount ||
           ParserValueExprTokenProducerSourceIndexAt(
               tree, anchorTokenIndex) != 0 ||
           (expr.valueExprRootNodeIndex < 0 &&
            (expr.valueExprSpanStart !=
                 ParserValueExprTokenStartAt(tree, anchorTokenIndex) ||
             expr.valueExprSpanEnd !=
                 ParserValueExprTokenEndAt(tree, anchorTokenIndex))) ||
           ParserValueExprTokenLineAt(tree, anchorTokenIndex) !=
               expr.lineNumber ||
           ParserValueExprTokenColumnAt(tree, anchorTokenIndex) !=
               expr.columnNumber:
            err = "parser normalized structure: anchor identity drift"
            return false
        expr.anchorTokenIndex = anchorTokenIndex
        layer.exprs[exprIndex] = expr
        if layer.exprs[exprIndex].kind == NormalizedExprIf && layer.exprs[exprIndex].lineNumber == 0 && layer.exprs[exprIndex].sourcePath == "":
            panic("parser value expr: W8 zero writeback idx={exprIndex} total={layer.exprs.len}")
    for scopeIndex in 0..<layer.scopes.len:
        var scope = layer.scopes[scopeIndex]
        var anchorTokenIndex = -1
        if scope.ownerStatementOrdinal >= 0:
            if scope.ownerDeclarationRow != -1 ||
               scope.moduleRootAnchor:
                err =
                    "parser normalized structure: scope owner domains overlap"
                return false
            var ownerStatementRow = -1
            for exprIndex in 0..<layer.exprs.len:
                let expr = layer.exprs[exprIndex]
                if !ParserNormalizedExprKindIsSidecarStructured(expr.kind) ||
                   expr.statementOrdinal != scope.ownerStatementOrdinal:
                    continue
                if ownerStatementRow >= 0:
                    err =
                        "parser normalized structure: scope owner ambiguous"
                    return false
                ownerStatementRow = exprIndex
                anchorTokenIndex = expr.anchorTokenIndex
            if ownerStatementRow < 0:
                err = "parser normalized structure: scope owner missing"
                return false
            scope.ownerStatementRow = ownerStatementRow
        elif scope.ownerDeclarationRow >= 0:
            let declarationRow = scope.ownerDeclarationRow
            if declarationRow >= tree.declarationCount ||
               scope.ownerStatementOrdinal != -1 ||
               scope.ownerStatementRow != -1 ||
               scope.moduleRootAnchor ||
               ParserDeclarationKind(arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationKinds,
                   declarationRow)) != ParserDeclarationFunction:
                err =
                    "parser normalized structure: declaration scope owner invalid"
                return false
            let suiteScopeRow = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationSuiteLexicalScopeRows,
                declarationRow)
            if suiteScopeRow < 0 ||
               suiteScopeRow >= tree.declarationLexicalScopeCount ||
               ParserDeclarationLexicalScopeKind(
                   arenamod.ArenaArrayInt32Get(
                       tree.arena,
                       tree.declarationLexicalScopeKinds,
                       suiteScopeRow)) !=
                   ParserDeclarationLexicalScopeFunction ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   tree.declarationLexicalScopeOwnerDeclarationRows,
                   suiteScopeRow) != declarationRow:
                err =
                    "parser normalized structure: declaration suite identity drift"
                return false
            anchorTokenIndex = arenamod.ArenaArrayInt32Get(
                tree.arena,
                tree.declarationNameTokenIndexes,
                declarationRow)
            scope.ownerStatementRow = -1
        elif scope.parentScopeId < 0 &&
             scope.kind == NormalizedScopeRoot &&
             scope.moduleRootAnchor &&
             scope.ownerDeclarationRow == -1:
            if tree.tokenCount > 0 &&
               ParserValueExprTokenProducerSourceIndexAt(tree, 0) == 0 &&
               ParserValueExprTokenSourceLocalIndexAt(tree, 0) == 0:
                anchorTokenIndex = 0
            scope.ownerStatementRow = -1
        else:
            err =
                "parser normalized structure: scope owner identity missing"
            return false
        if anchorTokenIndex < 0 ||
           anchorTokenIndex >= tree.tokenCount:
            err = "parser normalized structure: scope anchor missing"
            return false
        scope.anchorTokenIndex = anchorTokenIndex
        layer.scopes[scopeIndex] = scope
    err = ""
    return true

fn ParserValueExprAnnotateFactForLine(layer: var NormalizedExprLayer,
                                        exprIndex: int32,
                                        lineNumber: int32,
                                        lineScopeIds: var int32[],
                                        lineInlineSuiteBodyColumns: var int32[],
                                        lineInlineSuiteScopeIds: var int32[],
                                        lineDeferOwnerOrdinals: var int32[],
                                        lineInlineDeferBodyColumns: var int32[],
                                        lineInlineDeferSuiteScopeIds: var int32[]) =
    let lineIndex = lineNumber - 1
    var lexicalScopeId: int32
    var inlineSuiteBodyColumn = -1
    var inlineSuiteScopeId = -1
    var deferOwnerStatementOrdinal = -1
    var inlineDeferBodyColumn = -1
    var inlineDeferSuiteScopeId = -1
    if lineIndex >= 0 && lineIndex < lineScopeIds.len &&
       lineScopeIds[lineIndex] >= 0:
        lexicalScopeId = lineScopeIds[lineIndex]
    if lineIndex >= 0 && lineIndex < lineInlineSuiteBodyColumns.len:
        inlineSuiteBodyColumn = lineInlineSuiteBodyColumns[lineIndex]
    if lineIndex >= 0 && lineIndex < lineInlineSuiteScopeIds.len:
        inlineSuiteScopeId = lineInlineSuiteScopeIds[lineIndex]
    if lineIndex >= 0 && lineIndex < lineDeferOwnerOrdinals.len:
        deferOwnerStatementOrdinal = lineDeferOwnerOrdinals[lineIndex]
    if lineIndex >= 0 && lineIndex < lineInlineDeferBodyColumns.len:
        inlineDeferBodyColumn = lineInlineDeferBodyColumns[lineIndex]
    if lineIndex >= 0 && lineIndex < lineInlineDeferSuiteScopeIds.len:
        inlineDeferSuiteScopeId = lineInlineDeferSuiteScopeIds[lineIndex]
    var expr = layer.exprs[exprIndex]
    ParserAnnotateExprFact(expr,
                            lexicalScopeId,
                            inlineSuiteBodyColumn,
                            inlineSuiteScopeId,
                            deferOwnerStatementOrdinal,
                            inlineDeferBodyColumn,
                            inlineDeferSuiteScopeId)
    layer.exprs[exprIndex] = expr
    if layer.exprs[exprIndex].kind == NormalizedExprIf && layer.exprs[exprIndex].lineNumber == 0 && layer.exprs[exprIndex].sourcePath == "":
        panic("parser value expr: W9 zero writeback idx={exprIndex} total={layer.exprs.len}")

# Materialize parser-native implicit-return candidates as ordinary normalized
# Return facts.  The row keeps the exact parser node/root/span and is later
# ignored for void functions by TypedIR; no synthetic `return ` source line is
# created in any phase.
@borrows
fn ParserValueExprAppendImplicitReturnFacts(
        sourcePath: str,
        eventIndex: int32,
        lineScopeIds: var int32[],
        lineInlineSuiteBodyColumns: var int32[],
        lineInlineSuiteScopeIds: var int32[],
        lineDeferOwnerOrdinals: var int32[],
        lineInlineDeferBodyColumns: var int32[],
        lineInlineDeferSuiteScopeIds: var int32[],
        layer: var NormalizedExprLayer) =
    let tree = layer.valueExprTree
    if ParserValueExprStatementRootRoleAt(tree, eventIndex) !=
           ParserValueExprStatementImplicitReturnValue:
        panic("parser value expr: implicit return append role mismatch")
    let rootNodeIndex = ParserValueExprStatementRootNodeAt(tree, eventIndex)
    let lineNumber = ParserValueExprStatementRootAnchorLineAt(tree, eventIndex)
    let columnNumber = ParserValueExprStatementRootAnchorColumnAt(
        tree, eventIndex)
    var expr: NormalizedExpr
    expr.exprId = NormalizedExprMakeId(
        sourcePath,
        lineNumber,
        columnNumber,
        NormalizedExprReturn,
        NormalizedExprDetailNone)
    expr.sourcePath = sourcePath
    expr.lineNumber = lineNumber
    expr.columnNumber = columnNumber
    expr.endLineNumber = ParserValueExprStatementRootEndLineAt(
        tree, eventIndex)
    expr.endColumnNumber = ParserValueExprStatementRootEndColumnAt(
        tree, eventIndex)
    expr.kind = NormalizedExprReturn
    expr.detailKind = NormalizedExprDetailNone
    expr.surfaceText = ParserValueExprNodeText(tree, rootNodeIndex)
    expr.callSurfaceKind = NormalizedExprSurfaceCallNone
    expr.callResolved = false
    expr.callReason = NormalizedExprCallReasonNone
    expr.callQualifier = ""
    expr.callCallee = ""
    expr.callTarget = ""
    expr.callTargetSourcePath = ""
    expr.callTargetImportc = false
    expr.callPrefixStyle = false
    expr.callArgCount = 0
    expr.callArgsText = ""
    expr.valueExprCallNodeIndex = -1
    expr.originParserNodeId = -1
    expr.callArgValueRootStart = -1
    expr.callArgValueRootCount = 0
    # 本行无自身关键字（wall8 守卫契约：无 frozen anchor 的 Return 行回退
    # 取根事件 anchor，行列/边界/producer 0 契约由守卫统一强制）。新值零
    # 初始化为 0，漏置会让守卫 `anchorTokenIndex >= 0` 臂把 0 误读为行自
    # 带 frozen anchor（劫持到 token 0 → anchor identity drift）。显式
    # 声明未冻结，与各 LayerAppend 生产者的 -1 拼写一致。
    expr.anchorTokenIndex = -1
    expr.valueExprRootNodeIndex = rootNodeIndex
    expr.valueExprSpanStart = ParserValueExprNodeSpanStartAt(
        tree, rootNodeIndex)
    expr.valueExprSpanEnd = ParserValueExprNodeSpanEndAt(
        tree, rootNodeIndex)
    expr.valueExprStatementRole =
        ParserValueExprStatementImplicitReturnValue
    ParserValueExprBindRootCallIdentity(
        layer.valueExprTree, rootNodeIndex, expr)
    expr.lexicalScopeId = 0
    expr.suiteScopeId = -1
    expr.statementOrdinal = -1
    expr.lexicalOrdinal = -1
    expr.deferOwnerStatementOrdinal = -1
    if NormalizedExprLayerContainsExpr(layer, expr):
        panic("parser value expr: duplicate implicit return fact")
    add(layer.exprs, expr)
    add(layer.exprNext, -1)
    if layer.exprs[layer.exprs.len - 1].kind == NormalizedExprIf &&
       layer.exprs[layer.exprs.len - 1].lineNumber == 0 &&
       layer.exprs[layer.exprs.len - 1].sourcePath == "":
        panic("parser value expr: A6 ImplicitReturn append produced zero slot")
    let exprIndex = layer.exprs.len - 1
    NormalizedExprLayerRememberExpr(layer, exprIndex)
    ParserValueExprAnnotateFactForLine(
        layer,
        exprIndex,
        lineNumber,
        lineScopeIds,
        lineInlineSuiteBodyColumns,
        lineInlineSuiteScopeIds,
        lineDeferOwnerOrdinals,
        lineInlineDeferBodyColumns,
        lineInlineDeferSuiteScopeIds)

@borrows
fn ParserValueExprAppendBindingInitializerFact(
        sourcePath: str,
        eventIndex: int32,
        layer: var NormalizedExprLayer) =
    let tree = layer.valueExprTree
    if ParserValueExprStatementRootRoleAt(tree, eventIndex) !=
           ParserValueExprStatementBindingInitializer:
        panic("parser value expr: binding initializer append role mismatch")
    let columnNumber = ParserValueExprStatementRootAnchorColumnAt(
        tree, eventIndex)
    let anchorToken = ParserValueExprStatementRootAnchorTokenAt(
        tree, eventIndex)
    let declarationStart =
        ParserValueExprStatementRootBindingDeclarationStartAt(
            tree, eventIndex)
    let declarationCount =
        ParserValueExprStatementRootBindingDeclarationCountAt(
            tree, eventIndex)
    if columnNumber <= 0 || anchorToken < 0 ||
       declarationStart < 0 || declarationCount <= 0 ||
       declarationStart > tree.declarationCount ||
       declarationCount > tree.declarationCount - declarationStart:
        panic("parser value expr: binding initializer declaration authority missing")
    let declarationSpanStart = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.declarationSpanStarts,
        declarationStart)
    let lhsEnd = ParserValueExprTokenStartAt(tree, anchorToken)
    let lhsText = chengpath.PathTrim(
        ParserValueExprProjectSpan(
            tree,
            ParserValueExprTokenSourceIdAt(tree, anchorToken),
            declarationSpanStart,
            lhsEnd))
    if lhsText == "":
        panic("parser value expr: binding initializer declaration surface missing")
    let rootNodeIndex = ParserValueExprStatementRootNodeAt(tree, eventIndex)
    let rhsText = ParserValueExprNodeText(tree, rootNodeIndex)
    let exprStart = layer.exprs.len
    NormalizedExprLayerAppendAssign(
        layer,
        share(sourcePath),
        ParserValueExprStatementRootAnchorLineAt(tree, eventIndex),
        columnNumber,
        lhsText,
        rhsText,
        ParserValueExprStatementRootEndColumnAt(tree, eventIndex))
    if layer.exprs.len != exprStart + 1:
        panic("parser value expr: duplicate binding initializer fact")
    var expr = layer.exprs[exprStart]
    expr.endLineNumber = ParserValueExprStatementRootEndLineAt(
        tree, eventIndex)
    expr.endColumnNumber = ParserValueExprStatementRootEndColumnAt(
        tree, eventIndex)
    expr.valueExprRootNodeIndex = rootNodeIndex
    expr.valueExprSpanStart = ParserValueExprNodeSpanStartAt(
        tree, rootNodeIndex)
    expr.valueExprSpanEnd = ParserValueExprNodeSpanEndAt(tree, rootNodeIndex)
    expr.valueExprStatementRole =
        ParserValueExprStatementBindingInitializer
    layer.exprs[exprStart] = expr
    if layer.exprs[exprStart].kind == NormalizedExprIf &&
       layer.exprs[exprStart].lineNumber == 0 &&
       layer.exprs[exprStart].sourcePath == "":
        panic(Fmt"parser value expr: A7 BindInit writeback zeroed slot idx={exprStart} total={layer.exprs.len}")

@borrows
fn ParserValueExprAppendAssignmentRhsFact(
        sourcePath: str,
        eventIndex: int32,
        lineRaw: str,
        layer: var NormalizedExprLayer) =
    let tree = layer.valueExprTree
    if ParserValueExprStatementRootRoleAt(tree, eventIndex) !=
           ParserValueExprStatementAssignmentRhs:
        panic("parser value expr: assignment append role mismatch")
    let columnNumber = ParserValueExprStatementRootAnchorColumnAt(
        tree, eventIndex)
    # LHS 按 lineRaw 上的顶层 `=` 切: 同行锚(既有全部语料形)与锚列切片
    # PathTrim 后逐字节同; 点尾续行 join 形(WA1 U2, `=` 在续行)的锚列是
    # 续行坐标, 对头行切片会截断 LHS(实测 lhs=`o.inne`), 顶层 `=` 搜索
    # 才给出完整 LHS。切出后再挤点邻空白, 使 LHS 与 join 粘合宽度无关
    # (`o.inner.v` / `o.inner. v` 统一为单行书写形 `o.inner.v`)。
    let assignEqPos = ParserFindTopLevelAssignmentEqFrom(lineRaw, 0)
    let lhsText = ParserSqueezeDotAdjacentSpace(
        chengpath.PathTrim(
            ParserTextSliceCopy(lineRaw, 0, assignEqPos)))
    if assignEqPos <= 0 || assignEqPos > lineRaw.len || lhsText == "":
        panic("parser value expr: assignment declaration surface missing")
    let rootNodeIndex = ParserValueExprStatementRootNodeAt(tree, eventIndex)
    let rhsText = ParserValueExprNodeText(tree, rootNodeIndex)
    let exprStart = layer.exprs.len
    NormalizedExprLayerAppendAssign(
        layer,
        share(sourcePath),
        ParserValueExprStatementRootAnchorLineAt(tree, eventIndex),
        columnNumber,
        lhsText,
        rhsText,
        ParserValueExprStatementRootEndColumnAt(tree, eventIndex))
    if layer.exprs.len != exprStart + 1:
        panic("parser value expr: duplicate assignment fact")
    var expr = layer.exprs[exprStart]
    expr.endLineNumber = ParserValueExprStatementRootEndLineAt(
        tree, eventIndex)
    expr.endColumnNumber = ParserValueExprStatementRootEndColumnAt(
        tree, eventIndex)
    expr.valueExprRootNodeIndex = rootNodeIndex
    expr.valueExprSpanStart = ParserValueExprNodeSpanStartAt(
        tree, rootNodeIndex)
    expr.valueExprSpanEnd = ParserValueExprNodeSpanEndAt(tree, rootNodeIndex)
    expr.valueExprStatementRole = ParserValueExprStatementAssignmentRhs
    layer.exprs[exprStart] = expr
    if layer.exprs[exprStart].kind == NormalizedExprIf &&
       layer.exprs[exprStart].lineNumber == 0 &&
       layer.exprs[exprStart].sourcePath == "":
        panic(Fmt"parser value expr: A8 AssignRhs writeback zeroed slot idx={exprStart} total={layer.exprs.len}")

# The legacy line scanner appends one bare `if` keyword row per conditional
# statement; the value-expr tree owns the same statement as a Condition root
# with the parsed condition node.  Upgrade the scanned row to tree identity
# (root node + spans + role) instead of leaving it node-less: the parser
# receipt requires every normalized expr to carry a parser-owned node.  Rows
# already stamped by an earlier Condition root (nested one-line `if` chains)
# are left alone so each root claims the next un-stamped row in source order.
@borrows
fn ParserValueExprStampConditionFact(
        sourcePath: str,
        eventIndex: int32,
        lineNumber: int32,
        layer: var NormalizedExprLayer) =
    let tree = layer.valueExprTree
    if ParserValueExprStatementRootRoleAt(tree, eventIndex) !=
           ParserValueExprStatementCondition:
        panic("parser value expr: condition stamp role mismatch")
    let rootNodeIndex = ParserValueExprStatementRootNodeAt(tree, eventIndex)
    for exprIndex in 0..<layer.exprs.len:
        if layer.exprs[exprIndex].kind != NormalizedExprIf ||
           layer.exprs[exprIndex].detailKind !=
               NormalizedExprDetailIfKeyword ||
           layer.exprs[exprIndex].lineNumber != lineNumber ||
           layer.exprs[exprIndex].sourcePath != sourcePath:
            continue
        if layer.exprs[exprIndex].valueExprRootNodeIndex >= 0 &&
           layer.exprs[exprIndex].valueExprStatementRole ==
               ParserValueExprStatementCondition:
            continue
        var expr = layer.exprs[exprIndex]
        expr.valueExprRootNodeIndex = rootNodeIndex
        expr.valueExprSpanStart = ParserValueExprNodeSpanStartAt(
            tree, rootNodeIndex)
        expr.valueExprSpanEnd = ParserValueExprNodeSpanEndAt(
            tree, rootNodeIndex)
        expr.valueExprStatementRole = ParserValueExprStatementCondition
        layer.exprs[exprIndex] = expr
        if layer.exprs[exprIndex].kind == NormalizedExprIf && layer.exprs[exprIndex].lineNumber == 0 && layer.exprs[exprIndex].sourcePath == "":
            panic("parser value expr: W10 zero writeback idx={exprIndex} total={layer.exprs.len}")
        return

fn ParserValueExprCallResolutionNew(
        surfaceKind: NormalizedExprSurfaceCallKind,
        resolved: bool,
        reason: NormalizedExprCallReason,
        targetSourcePath: str,
        targetImportc: bool,
        targetUsesCalleeText: bool): ParserValueExprCallResolution =
    var out: ParserValueExprCallResolution
    out.surfaceKind = surfaceKind
    out.resolved = resolved
    out.reason = reason
    out.targetSourcePath = targetSourcePath
    out.targetImportc = targetImportc
    out.targetUsesCalleeText = targetUsesCalleeText
    return out

@borrows
fn ParserResolveValueExprCallEvent(
        sourcePath: str,
        currentProfile: NormalizedExprCallProfile,
        profiles: NormalizedExprCallProfile[],
        profileIndexLookup: ParserSourcePathIndexLookup,
        profileCallLookupCache:
            var ParserProfileCallLookupCacheEntry[],
        externalCallLookup: var ParserTextLookup,
        callName: str,
        calleeText: str,
        qualifierText: str): ParserValueExprCallResolution =
    let localName = ParserValueExprProfileHasName(
        currentProfile.localCallNames, callName)
    let importcName = ParserValueExprProfileHasName(
        currentProfile.importcCallNames, callName)
    if qualifierText == "" && importcName:
        return ParserValueExprCallResolutionNew(
            NormalizedExprSurfaceCallImportc,
            true,
            NormalizedExprCallReasonNone,
            share(sourcePath),
            true,
            false)
    if qualifierText == "" && localName:
        return ParserValueExprCallResolutionNew(
            NormalizedExprSurfaceCallLocal,
            true,
            NormalizedExprCallReasonNone,
            share(sourcePath),
            false,
            false)
    if qualifierText != "" &&
       ParserProfileHasImportQualifier(
           currentProfile,
           ParserQualifiedTargetRootQualifierExact(calleeText)):
        var targetText = share(callName)
        let externalTarget = ParserResolveCallTarget(
            currentProfile,
            profiles,
            profileIndexLookup,
            profileCallLookupCache,
            NormalizedExprSurfaceCallExternal,
            calleeText,
            targetText)
        let externalSourcePath = externalTarget.sourcePath
        return ParserValueExprCallResolutionNew(
            NormalizedExprSurfaceCallExternal,
            externalSourcePath != "",
            externalTarget.reason,
            share(externalSourcePath),
            externalTarget.importc,
            true)
    if qualifierText != "" && (localName || importcName):
        if importcName:
            return ParserValueExprCallResolutionNew(
                NormalizedExprSurfaceCallImportc,
                true,
                NormalizedExprCallReasonNone,
                share(sourcePath),
                true,
                false)
        return ParserValueExprCallResolutionNew(
            NormalizedExprSurfaceCallLocal,
            true,
            NormalizedExprCallReasonNone,
            share(sourcePath),
            false,
            false)
    var targetText = share(callName)
    let externalTarget = ParserResolveUnqualifiedExternalCallTarget(
        currentProfile,
        profiles,
        profileIndexLookup,
        profileCallLookupCache,
        targetText)
    let externalSourcePath = externalTarget.sourcePath
    if externalSourcePath != "" ||
       externalTarget.reason !=
           NormalizedExprCallReasonUnknownExternalTarget ||
       ParserTextLookupContainsExactBorrowed(
           externalCallLookup, targetText):
        return ParserValueExprCallResolutionNew(
            NormalizedExprSurfaceCallExternal,
            externalSourcePath != "",
            externalTarget.reason,
            share(externalSourcePath),
            externalTarget.importc,
            false)
    if qualifierText != "":
        return ParserValueExprCallResolutionNew(
            NormalizedExprSurfaceCallMember,
            false,
            NormalizedExprCallReasonUnknownQualifiedTarget,
            "",
            false,
            true)
    if ParserCallNameIsBuiltinCallee(targetText):
        return ParserValueExprCallResolutionNew(
            NormalizedExprSurfaceCallLocal,
            true,
            NormalizedExprCallReasonNone,
            share(sourcePath),
            false,
            false)
    return ParserValueExprCallResolutionNew(
        NormalizedExprSurfaceCallLocal,
        false,
        NormalizedExprCallReasonUnknownCallTarget,
        "",
        false,
        false)

# Whole-struct load/store of NormalizedExpr can restore a zero snapshot and
# wipe token lines. Recover missing lines from the parser tree (CallPosition
# or statement-root token rows). Never invent a line.
@borrows
fn ParserValueExprStampMissingExprLinesFromTree(
        layer: var NormalizedExprLayer,
        err: var str): bool =
    let tree = layer.valueExprTree
    if tree == nil || tree.lifecycleState != ParserValueExprOwnerActive:
        err = "parser value expr: line stamp requires active tree"
        return false
    for exprIndex in 0..<layer.exprs.len:
        if layer.exprs[exprIndex].lineNumber > 0:
            continue
        var lineNumber: int32
        var columnNumber: int32
        var endLineNumber: int32
        var endColumnNumber: int32
        var recovered = false
        let callNode = layer.exprs[exprIndex].valueExprCallNodeIndex
        let originNode = layer.exprs[exprIndex].originParserNodeId
        let rootNode = layer.exprs[exprIndex].valueExprRootNodeIndex
        var positionNode = -1
        if layer.exprs[exprIndex].kind == NormalizedExprCall &&
           callNode >= 0:
            positionNode = callNode
        elif callNode > 0:
            positionNode = callNode
        elif originNode > 0:
            positionNode = originNode
        if positionNode >= 0 &&
           ParserValueExprCallPosition(tree,
                                        positionNode,
                                        lineNumber,
                                        columnNumber,
                                        endLineNumber,
                                        endColumnNumber):
            layer.exprs[exprIndex].lineNumber = lineNumber
            layer.exprs[exprIndex].columnNumber = columnNumber
            layer.exprs[exprIndex].endLineNumber = endLineNumber
            layer.exprs[exprIndex].endColumnNumber = endColumnNumber
            if layer.exprs[exprIndex].kind != NormalizedExprCall &&
               layer.exprs[exprIndex].kind != NormalizedExprStrFormat &&
               layer.exprs[exprIndex].kind != NormalizedExprResultIntrinsic:
                layer.exprs[exprIndex].kind = NormalizedExprCall
            recovered = true
        if !recovered &&
           rootNode > 0 &&
           (layer.exprs[exprIndex].kind == NormalizedExprReturn ||
            layer.exprs[exprIndex].kind == NormalizedExprAssign ||
            ParserNormalizedExprKindIsSidecarStructured(
                layer.exprs[exprIndex].kind)):
            let eventIndex = ParserValueExprNodeDirectStatementRootEventAt(
                tree, rootNode)
            if eventIndex >= 0:
                lineNumber = ParserValueExprStatementRootAnchorLineAt(
                    tree, eventIndex)
                columnNumber = ParserValueExprStatementRootAnchorColumnAt(
                    tree, eventIndex)
                endLineNumber = ParserValueExprStatementRootEndLineAt(
                    tree, eventIndex)
                endColumnNumber = ParserValueExprStatementRootEndColumnAt(
                    tree, eventIndex)
                if lineNumber > 0 && columnNumber > 0:
                    layer.exprs[exprIndex].lineNumber = lineNumber
                    layer.exprs[exprIndex].columnNumber = columnNumber
                    layer.exprs[exprIndex].endLineNumber = endLineNumber
                    layer.exprs[exprIndex].endColumnNumber = endColumnNumber
                    recovered = true
        if !recovered || layer.exprs[exprIndex].lineNumber <= 0:
            err = Fmt"parser value expr: expression line missing without token authority row={exprIndex} kind={NormalizedExprKindCode(layer.exprs[exprIndex].kind)} call={callNode} origin={originNode} root={rootNode}"
            return false
    err = ""
    return true

@borrows
fn ParserAppendValueExprCallEvents(sourcePath: str,
                                     currentProfile: NormalizedExprCallProfile,
                                     currentProfileLines: str[],
                                     profiles: NormalizedExprCallProfile[],
                                     profileIndexLookup: ParserSourcePathIndexLookup,
                                     profileCallLookupCache: var ParserProfileCallLookupCacheEntry[],
                                     externalCallLookup: var ParserTextLookup,
                                     lineScopeIds: var int32[],
                                     lineInlineSuiteBodyColumns: var int32[],
                                     lineInlineSuiteScopeIds: var int32[],
                                     lineDeferOwnerOrdinals: var int32[],
                                     lineInlineDeferBodyColumns: var int32[],
                                     lineInlineDeferSuiteScopeIds: var int32[],
                                     layer: var NormalizedExprLayer,
                                     err: var str): bool =
    let tree = layer.valueExprTree
    let eventCount = tree.callEventCount
    var primaryStarts: int32[]
    var primaryCounts: int32[]
    var childStarts: int32[]
    var childCounts: int32[]
    parserValueExprCallPositionTokenRangesBuild(
        tree,
        primaryStarts,
        primaryCounts,
        childStarts,
        childCounts)
    for eventIndex in 0..<eventCount:
        for evScanIndex in 0..<layer.exprs.len:
            if layer.exprs[evScanIndex].kind == NormalizedExprIf &&
               layer.exprs[evScanIndex].lineNumber == 0 &&
               layer.exprs[evScanIndex].sourcePath == "":
                panic(Fmt"parser value expr: EV zero slot at event={eventIndex} idx={evScanIndex} total={layer.exprs.len} cap={layer.exprs.cap}")
        let nodeIndex = ParserValueExprCallEventNodeAt(
            tree, eventIndex)
        let callName = ParserValueExprNodeNameText(
            tree, nodeIndex)
        if callName == "":
            continue
        let calleeText = ParserValueExprNodeAtomText(
            tree, nodeIndex)
        let ownerText = ParserValueExprNodeOwnerText(
            tree, nodeIndex)
        var lineNumber: int32
        var columnNumber: int32
        var endLineNumber: int32
        var endColumnNumber: int32
        if !ParserValueExprCallPositionWithRanges(
               tree,
               nodeIndex,
               primaryStarts,
               primaryCounts,
               childStarts,
               childCounts,
               lineNumber,
               columnNumber,
               endLineNumber,
               endColumnNumber):
            err = Fmt"parser value expr: call position unavailable callee={calleeText}"
            return false
        if ParserCallExprUsesDedicatedNormalization(callName):
            if !ParserValueExprBindDedicatedNormalizedCall(
                    layer,
                    nodeIndex,
                    callName,
                    lineNumber,
                    columnNumber,
                    endLineNumber,
                    endColumnNumber):
                err = Fmt"parser value expr: dedicated call fact unavailable callee={calleeText} line={lineNumber} column={columnNumber}"
                return false
            continue
        var targetText = share(callName)
        let qualifierText = ownerText
        let callResolution = ParserResolveValueExprCallEvent(
            share(sourcePath),
            currentProfile,
            profiles,
            profileIndexLookup,
            profileCallLookupCache,
            externalCallLookup,
            share(callName),
            share(calleeText),
            share(qualifierText))
        if callResolution.surfaceKind ==
               NormalizedExprSurfaceCallNone:
            panic("parser value expr: call resolution missing")
        let exprStart = layer.exprs.len
        let prefixStyle = ParserValueExprNodeKindAt(
            layer.valueExprTree, nodeIndex) == ParserValueExprSpaceCall
        let callSurfaceText = ParserValueExprNodeAtomText(
            layer.valueExprTree, nodeIndex)
        let targetSourcePath = callResolution.targetSourcePath
        let callArgumentRootCount =
            ParserValueExprNodeArgumentRootCount(
                layer.valueExprTree, nodeIndex)
        if callResolution.targetUsesCalleeText:
            NormalizedExprLayerAppendCall(
                layer,
                sourcePath,
                lineNumber,
                columnNumber,
                callSurfaceText,
                callResolution.surfaceKind,
                callResolution.resolved,
                callResolution.reason,
                share(qualifierText),
                targetText,
                calleeText,
                share(targetSourcePath),
                callResolution.targetImportc,
                ParserValueExprNodeCallArgsText(
                    layer.valueExprTree, nodeIndex),
                callArgumentRootCount,
                prefixStyle,
                endColumnNumber)
        else:
            NormalizedExprLayerAppendCall(
                layer,
                sourcePath,
                lineNumber,
                columnNumber,
                callSurfaceText,
                callResolution.surfaceKind,
                callResolution.resolved,
                callResolution.reason,
                share(qualifierText),
                calleeText,
                targetText,
                share(targetSourcePath),
                callResolution.targetImportc,
                ParserValueExprNodeCallArgsText(
                    layer.valueExprTree, nodeIndex),
                callArgumentRootCount,
                prefixStyle,
                endColumnNumber)
        for evAddScanIndex in 0..<layer.exprs.len:
            if layer.exprs[evAddScanIndex].kind == NormalizedExprIf &&
               layer.exprs[evAddScanIndex].lineNumber == 0 &&
               layer.exprs[evAddScanIndex].sourcePath == "":
                panic(Fmt"parser value expr: EVADD zero slot at event={eventIndex} idx={evAddScanIndex} total={layer.exprs.len} cap={layer.exprs.cap}")
        ParserValueExprBindNormalizedCall(layer,
                                           nodeIndex,
                                           exprStart,
                                           endLineNumber,
                                           endColumnNumber)
        ParserValueExprAnnotateFactForLine(
            layer,
            exprStart,
            lineNumber,
            lineScopeIds,
            lineInlineSuiteBodyColumns,
            lineInlineSuiteScopeIds,
            lineDeferOwnerOrdinals,
            lineInlineDeferBodyColumns,
            lineInlineDeferSuiteScopeIds)
        # CallPosition already proved these token rows. Field stores keep the
        # line if a later whole-struct write restores a zero snapshot.
        layer.exprs[exprStart].lineNumber = lineNumber
        layer.exprs[exprStart].columnNumber = columnNumber
        layer.exprs[exprStart].endLineNumber = endLineNumber
        layer.exprs[exprStart].endColumnNumber = endColumnNumber
        layer.exprs[exprStart].kind = NormalizedExprCall
    for evEndScanIndex in 0..<layer.exprs.len:
        if layer.exprs[evEndScanIndex].kind == NormalizedExprIf &&
           layer.exprs[evEndScanIndex].lineNumber == 0 &&
           layer.exprs[evEndScanIndex].sourcePath == "":
            panic(Fmt"parser value expr: EVEND zero slot idx={evEndScanIndex} total={layer.exprs.len} cap={layer.exprs.cap}")
    return true

@borrows
fn ParserReadNormalizedExprLayerFromTextWithKnownCallsAndProfilesCachedWithCurrentLines(sourcePathRaw: str,
                                                                                         text: str,
                                                                                         importcCallNames: str[],
                                                                                         localCallNames: str[],
                                                                                         externalCallNames: str[],
                                                                                         currentProfile: NormalizedExprCallProfile,
                                                                                         currentProfileLines: str[],
                                                                                         profiles: NormalizedExprCallProfile[],
                                                                                         profileIndexLookup: ParserSourcePathIndexLookup,
                                                                                         profileCallLookupCache: var ParserProfileCallLookupCacheEntry[],
                                                                                         layer: var NormalizedExprLayer,
                                                                                         err: var str): bool =
    var priorReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
    NormalizedExprLayerTerminalReleaseWithReceipt(
        layer, priorReleaseReceipt)
    let sourcePath = ParserNormalizePath(sourcePathRaw)
    var normalizedText: str
    if !ParserRewriteMultilineStringSourceText(
           text, normalizedText, err):
        return false
    if sourcePath == "":
        err = "missing source path"
        return false
    layer.sourceCount = 1
    var valueTreeRead: bool
    if currentProfile.migrationSourceSyntax:
        valueTreeRead = ParserValueExprReadMigrationSourceTreeFromText(
            normalizedText,
            layer.valueExprTree,
            err)
    else:
        valueTreeRead = ParserValueExprReadTreeFromText(normalizedText,
                                                         layer.valueExprTree,
                                                         err)
    if !valueTreeRead:
        var failureReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
        NormalizedExprLayerTerminalReleaseWithReceipt(
            layer, failureReleaseReceipt)
        return false
    var externalCallLookup = ParserTextLookupBuildExact(externalCallNames)
    var splitLinesForContinuation = ParserSplitChar(normalizedText, '\n')
    var preparedLinesForContinuation = ParserPrepareCodeLines(splitLinesForContinuation)
    var codeLines = ParserJoinContinuationLines(preparedLinesForContinuation)
    var typeDeclarationLineFlags: bool[]
    if !ParserValueExprTypeDeclarationHeaderLineFlagsInto(
           layer.valueExprTree,
           codeLines.len,
           typeDeclarationLineFlags,
           err):
        var failureReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
        NormalizedExprLayerTerminalReleaseWithReceipt(
            layer, failureReleaseReceipt)
        return false
    var structuredSeeds: ParserStructuredStatementSeed[]
    var lineScopeIds: int32[]
    var lineInlineSuiteBodyColumns: int32[]
    var lineInlineSuiteScopeIds: int32[]
    var lineDeferOwnerOrdinals: int32[]
    var lineInlineDeferBodyColumns: int32[]
    var lineInlineDeferSuiteScopeIds: int32[]
    var scopeBuildLineVisitCount: int64
    var structuredBuildLineVisitCount: int64
    # [phaseB-enum] enum 成员行不做 Result intrinsic 识别：`Ok`/`Err` 等成员
    # 名落在声明体成员行上时，行扫描器会把该裸名追加成
    # NormalizedExprResultIntrinsic 表达式行；该行在 value-expr 树中无声明
    # 节点，下游 compiler csg exact-declaration 域核对必挂
    # （"exact parser expression lacks declaration node"）。成员行号取自
    # value-expr 树的 enum 变体 CSR（精确 token 行号），不是行文本启发式。
    var enumMemberLineFlags: bool[]
    setLen(enumMemberLineFlags, codeLines.len)
    for typeSyntaxIndex in 0..<layer.valueExprTree.typeSyntaxCount:
        if ParserValueExprTypeSyntaxKindAt(layer.valueExprTree,
                                           typeSyntaxIndex) !=
               ParserTypeSyntaxEnum:
            continue
        let variantCount = ParserValueExprTypeSyntaxEnumVariantCountAt(
            layer.valueExprTree, typeSyntaxIndex)
        for variantOffset in 0..<variantCount:
            let nameToken = ParserValueExprTypeSyntaxEnumVariantNameTokenAt(
                layer.valueExprTree, typeSyntaxIndex, variantOffset)
            if nameToken < 0 || nameToken >= layer.valueExprTree.tokenCount:
                continue
            let memberLine = ParserValueExprTokenLineAt(layer.valueExprTree,
                                                        nameToken)
            if memberLine < 1 || memberLine > codeLines.len:
                continue
            enumMemberLineFlags[memberLine - 1] = true
    if !ParserBuildStructuredStatementFacts(sourcePath,
                                              codeLines,
                                              layer,
                                              structuredSeeds,
                                              lineScopeIds,
                                              lineInlineSuiteBodyColumns,
                                              lineInlineSuiteScopeIds,
                                              lineDeferOwnerOrdinals,
                                              lineInlineDeferBodyColumns,
                                              lineInlineDeferSuiteScopeIds,
                                              scopeBuildLineVisitCount,
                                              structuredBuildLineVisitCount,
                                              err):
        var failureReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
        NormalizedExprLayerTerminalReleaseWithReceipt(
            layer, failureReleaseReceipt)
        return false
    for mid0ScanIndex in 0..<layer.exprs.len:
        if layer.exprs[mid0ScanIndex].kind == NormalizedExprIf &&
           layer.exprs[mid0ScanIndex].lineNumber == 0 &&
           layer.exprs[mid0ScanIndex].sourcePath == "":
            panic(Fmt"parser value expr: MID0 zero slot after structured facts idx={mid0ScanIndex} total={layer.exprs.len}")
    var nextStructuredSeed: int32
    var nextValueExprStatementRoot: int32
    var inTypeBlock = false
    var typeBlockIndent: int32 = -1
    for i in 0..<codeLines.len:
        ParserAppendStructuredSeedsForLine(sourcePath,
                                            i,
                                            structuredSeeds,
                                            nextStructuredSeed,
                                            layer)
        let line = codeLines[i]
        if !ParserHasNonTrimChar(line):
            continue
        let lineNumber = i + 1
        let lineIndent: int32 = ParserLineIndent(line)
        if inTypeBlock && lineIndent <= typeBlockIndent:
            inTypeBlock = false
        if !ParserHasLeadingIndent(line):
            inTypeBlock = ParserLineTrimmedEquals(line, "type")
            if inTypeBlock:
                typeBlockIndent = lineIndent
        var redundantType = ""
        var redundantExpr = ""
        if ParserFindRedundantExplicitDefaultLine(line,
                                                    inTypeBlock,
                                                    currentProfile,
                                                    profiles,
                                                    redundantType,
                                                    redundantExpr):
            err = ParserRedundantExplicitDefaultError(redundantType, redundantExpr)
            var failureReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
            NormalizedExprLayerTerminalReleaseWithReceipt(
                layer, failureReleaseReceipt)
            return false
        let exprStart = layer.exprs.len
        # [phaseB-enum] enum 成员行关闭 Result intrinsic 行识别（见上方收集
        # 代码）：成员名是该行的声明身份，不是表达式。
        ParserAppendSimpleSurfaceExprsLine(sourcePath,
                                             lineNumber,
                                             line,
                                             true,
                                             true,
                                             !enumMemberLineFlags[i],
                                             layer)
        ParserAppendReturnStmtExprsLine(sourcePath, lineNumber, line, layer)
        var lineHasBindingInitializerRoot = false
        var lineHasAssignmentRoot = false
        # B6 根修: 语句根事件锚可能落在被逻辑续行 join 掉的源行上
        # (cleanup_cfg:7699 `plan.x[ ... i] = v` 的 `=` 在续行), 该事件的
        # 事实追加必须仍以锚行为行号 (freeze 身份契约: 行 (line,col) 与
        # 锚 token 一致), 故只在头行补齐守卫与追加, 不改单行语句路径。
        # 组界 = 头行槽到下一个非空槽 (空槽恰为 join 消耗行)。
        var groupEndSlot = i + 1
        while groupEndSlot < codeLines.len &&
              !ParserHasNonTrimChar(codeLines[groupEndSlot]):
            groupEndSlot = groupEndSlot + 1
        while nextValueExprStatementRoot <
                  layer.valueExprTree.statementRootCount &&
              ParserValueExprStatementRootAnchorLineAt(
                  layer.valueExprTree,
                  nextValueExprStatementRoot) < lineNumber:
            nextValueExprStatementRoot = nextValueExprStatementRoot + 1
        while nextValueExprStatementRoot <
                  layer.valueExprTree.statementRootCount &&
              ParserValueExprStatementRootAnchorLineAt(
                  layer.valueExprTree,
                  nextValueExprStatementRoot) == lineNumber:
            let statementRootRole = ParserValueExprStatementRootRoleAt(
                layer.valueExprTree,
                nextValueExprStatementRoot)
            if statementRootRole ==
                   ParserValueExprStatementBindingInitializer:
                lineHasBindingInitializerRoot = true
                ParserValueExprAppendBindingInitializerFact(
                    sourcePath,
                    nextValueExprStatementRoot,
                    layer)
            elif statementRootRole ==
                   ParserValueExprStatementImplicitReturnValue:
                ParserValueExprAppendImplicitReturnFacts(
                    sourcePath,
                    nextValueExprStatementRoot,
                    lineScopeIds,
                    lineInlineSuiteBodyColumns,
                    lineInlineSuiteScopeIds,
                    lineDeferOwnerOrdinals,
                    lineInlineDeferBodyColumns,
                    lineInlineDeferSuiteScopeIds,
                    layer)
            elif statementRootRole ==
                   ParserValueExprStatementAssignmentRhs:
                lineHasAssignmentRoot = true
                ParserValueExprAppendAssignmentRhsFact(
                    sourcePath,
                    nextValueExprStatementRoot,
                    line,
                    layer)
            elif statementRootRole ==
                   ParserValueExprStatementCondition:
                ParserValueExprStampConditionFact(
                    sourcePath,
                    nextValueExprStatementRoot,
                    lineNumber,
                    layer)
            nextValueExprStatementRoot = nextValueExprStatementRoot + 1
        # The parser-owned binding producer already appended the only
        # assignment represented by a binding-initializer statement root.
        # Appending the legacy line-scanned assignment as well would create a
        # second NormalizedExpr row without parser-node identity.
        # Type declarations already own an exact declaration row and
        # TypeSyntax root.  They are not executable assignments and must never
        # enter NormalizedExpr through the legacy line scanner.
        # B6: 预扫组内事件 (不消费游标), join 组扩展事件也压掉行扫描赋值
        # 兜底, 其事实在本行尾追加 (见组扩展追加块)。
        var b6GroupEventCursor = nextValueExprStatementRoot
        while b6GroupEventCursor <
                  layer.valueExprTree.statementRootCount &&
              ParserValueExprStatementRootAnchorLineAt(
                  layer.valueExprTree,
                  b6GroupEventCursor) <= groupEndSlot:
            let b6GroupRole = ParserValueExprStatementRootRoleAt(
                layer.valueExprTree,
                b6GroupEventCursor)
            if b6GroupRole == ParserValueExprStatementAssignmentRhs:
                lineHasAssignmentRoot = true
            elif b6GroupRole ==
                     ParserValueExprStatementBindingInitializer:
                lineHasBindingInitializerRoot = true
            b6GroupEventCursor = b6GroupEventCursor + 1
        if !lineHasBindingInitializerRoot &&
           !lineHasAssignmentRoot &&
           !typeDeclarationLineFlags[i]:
            ParserAppendAssignStmtExprsLine(
                sourcePath, lineNumber, line, layer)
        ParserAppendRangeExprsLine(sourcePath, lineNumber, line, layer)
        ParserAppendComprehensionExprsLine(sourcePath, lineNumber, line, layer)
        # B14 根修: join 组内 Fmt 事实按真实 token (line,col) 播种, 见
        # ParserAppendFmtExprsJoinGroupLine 注释 (B6 事件锚先例: 事实身份
        # (line,col) 必须等于锚 token 行列, joined 坐标系两不相等)。
        ParserAppendFmtExprsJoinGroupLine(sourcePath,
                                          preparedLinesForContinuation,
                                          i,
                                          groupEndSlot,
                                          layer)
        ParserAppendStringifyCallExprsLine(sourcePath,
                                             lineNumber,
                                             line,
                                             layer)
        if !ParserAppendDefaultInitExprsLine(sourcePath,
                                               lineNumber,
                                               line,
                                               currentProfile,
                                               profiles,
                                               layer,
                                               err):
            var failureReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
            NormalizedExprLayerTerminalReleaseWithReceipt(
                layer, failureReleaseReceipt)
            return false
        ParserAppendConstructorExprsLine(sourcePath,
                                           lineNumber,
                                           line,
                                           currentProfile,
                                           profiles,
                                           layer)
        # B6 根修: 组扩展事件 (锚行被 join 消耗) 的事实追加。行号 = 事件
        # 锚行 (AppendAssignmentRhsFact 原语义), 冻结身份契约的 (line,col)
        # = 锚 token 恒等成立; 追加时点在本行全部行扫描行之后, 层内行号
        # 源序不变量保持。
        while nextValueExprStatementRoot <
                  layer.valueExprTree.statementRootCount &&
              ParserValueExprStatementRootAnchorLineAt(
                  layer.valueExprTree,
                  nextValueExprStatementRoot) <= groupEndSlot:
            let b6TailRole = ParserValueExprStatementRootRoleAt(
                layer.valueExprTree,
                nextValueExprStatementRoot)
            if b6TailRole == ParserValueExprStatementBindingInitializer:
                lineHasBindingInitializerRoot = true
                ParserValueExprAppendBindingInitializerFact(
                    sourcePath,
                    nextValueExprStatementRoot,
                    layer)
            elif b6TailRole ==
                     ParserValueExprStatementImplicitReturnValue:
                ParserValueExprAppendImplicitReturnFacts(
                    sourcePath,
                    nextValueExprStatementRoot,
                    lineScopeIds,
                    lineInlineSuiteBodyColumns,
                    lineInlineSuiteScopeIds,
                    lineDeferOwnerOrdinals,
                    lineInlineDeferBodyColumns,
                    lineInlineDeferSuiteScopeIds,
                    layer)
            elif b6TailRole ==
                     ParserValueExprStatementAssignmentRhs:
                lineHasAssignmentRoot = true
                ParserValueExprAppendAssignmentRhsFact(
                    sourcePath,
                    nextValueExprStatementRoot,
                    line,
                    layer)
            elif b6TailRole == ParserValueExprStatementCondition:
                ParserValueExprStampConditionFact(
                    sourcePath,
                    nextValueExprStatementRoot,
                    lineNumber,
                    layer)
            nextValueExprStatementRoot = nextValueExprStatementRoot + 1
        var lineScopeId: int32
        var inlineSuiteBodyColumn = -1
        var inlineSuiteScopeId = -1
        var lineDeferOwnerOrdinal = -1
        var inlineDeferBodyColumn = -1
        var inlineDeferSuiteScopeId = -1
        if i < lineScopeIds.len && lineScopeIds[i] >= 0:
            lineScopeId = lineScopeIds[i]
        if i < lineInlineSuiteBodyColumns.len:
            inlineSuiteBodyColumn = lineInlineSuiteBodyColumns[i]
        if i < lineInlineSuiteScopeIds.len:
            inlineSuiteScopeId = lineInlineSuiteScopeIds[i]
        if i < lineDeferOwnerOrdinals.len:
            lineDeferOwnerOrdinal = lineDeferOwnerOrdinals[i]
        if i < lineInlineDeferBodyColumns.len:
            inlineDeferBodyColumn = lineInlineDeferBodyColumns[i]
        if i < lineInlineDeferSuiteScopeIds.len:
            inlineDeferSuiteScopeId = lineInlineDeferSuiteScopeIds[i]
        ParserAnnotateExprDelta(layer,
                                 exprStart,
                                 lineScopeId,
                                 inlineSuiteBodyColumn,
                                 inlineSuiteScopeId,
                                 lineDeferOwnerOrdinal,
                                 inlineDeferBodyColumn,
                                 inlineDeferSuiteScopeId)
    for mid1ScanIndex in 0..<layer.exprs.len:
        if layer.exprs[mid1ScanIndex].kind == NormalizedExprIf &&
           layer.exprs[mid1ScanIndex].lineNumber == 0 &&
           layer.exprs[mid1ScanIndex].sourcePath == "":
            panic(Fmt"parser value expr: MID1 zero slot after line loop idx={mid1ScanIndex} total={layer.exprs.len}")
    if !ParserAppendValueExprCallEvents(
            sourcePath,
            currentProfile,
            currentProfileLines,
            profiles,
            profileIndexLookup,
            profileCallLookupCache,
            externalCallLookup,
            lineScopeIds,
            lineInlineSuiteBodyColumns,
            lineInlineSuiteScopeIds,
            lineDeferOwnerOrdinals,
            lineInlineDeferBodyColumns,
            lineInlineDeferSuiteScopeIds,
            layer,
            err):
        var failureReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
        NormalizedExprLayerTerminalReleaseWithReceipt(
            layer, failureReleaseReceipt)
        return false
    ParserValueExprBindStatementRoots(layer)
    ParserValueExprStampStrFormatFacts(layer)
    if !ParserValueExprBindNormalizedStructureAnchors(layer, err):
        var failureReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
        NormalizedExprLayerTerminalReleaseWithReceipt(
            layer, failureReleaseReceipt)
        return false
    if !ParserValueExprStampMissingExprLinesFromTree(layer, err):
        var failureReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
        NormalizedExprLayerTerminalReleaseWithReceipt(
            layer, failureReleaseReceipt)
        return false
    layer.questionResidualCount = 0
    err = ""
    return true

# Shared-borrow one source profile and write independent owned parser
# arguments. The caller must not project profiles[i] in the same call
# that binds profiles as a var formal.
@borrows
fn ParserOwnedExprLayerReadInputsFromSourceProfile(
        profiles: NormalizedExprCallProfile[],
        profileIndex: int32,
        sourcePath: var str,
        text: var str,
        importcCallNames: var str[],
        localCallNames: var str[]) =
    if profileIndex < 0 || profileIndex >= profiles.len:
        panic("parser: owned expr-layer read inputs missing source profile")
    sourcePath = ParserOwnedText(profiles[profileIndex].sourcePath)
    text = ParserOwnedText(profiles[profileIndex].text)
    importcCallNames = ParserCloneTextSeq(profiles[profileIndex].importcCallNames)
    localCallNames = ParserCloneTextSeq(profiles[profileIndex].localCallNames)

@borrows
fn ParserReadNormalizedExprLayerFromTextWithKnownCallsAndProfilesCached(sourcePathRaw: str,
                                                                         text: str,
                                                                         importcCallNames: str[],
                                                                         localCallNames: str[],
                                                                         externalCallNames: str[],
                                                                         currentProfileIndex: int32,
                                                                         profiles: var NormalizedExprCallProfile[],
                                                                         profileIndexLookup: var ParserSourcePathIndexLookup,
                                                                         profileCallLookupCache: var ParserProfileCallLookupCacheEntry[],
                                                                         layer: var NormalizedExprLayer,
                                                                         err: var str): bool =
    if currentProfileIndex < 0 || currentProfileIndex >= profiles.len:
        panic("parser: cached expr-layer read missing source profile")
    var currentProfileLines = ParserCloneTextSeq(profiles[currentProfileIndex].lines)
    return ParserReadNormalizedExprLayerFromTextWithKnownCallsAndProfilesCachedWithCurrentLines(sourcePathRaw,
                                                                                                 text,
                                                                                                 importcCallNames,
                                                                                                 localCallNames,
                                                                                                 externalCallNames,
                                                                                                 profiles[currentProfileIndex],
                                                                                                 currentProfileLines,
                                                                                                 profiles,
                                                                                                 profileIndexLookup,
                                                                                                 profileCallLookupCache,
                                                                                                 layer,
                                                                                                 err)

@borrows
fn ParserReadNormalizedExprLayerFromTextWithKnownCallsAndProfilesWithCurrentLines(sourcePathRaw: str,
                                                                                    text: str,
                                                                                    importcCallNames: str[],
                                                                                    localCallNames: str[],
                                                                                    externalCallNames: str[],
                                                                                    currentProfile: var NormalizedExprCallProfile,
                                                                                    currentProfileLines: str[],
                                                                                    profiles: var NormalizedExprCallProfile[],
                                                                                    profileIndexLookup: var ParserSourcePathIndexLookup,
                                                                                    layer: var NormalizedExprLayer,
                                                                                    err: var str): bool =
    var profileCallLookupCache: ParserProfileCallLookupCacheEntry[]
    return ParserReadNormalizedExprLayerFromTextWithKnownCallsAndProfilesCachedWithCurrentLines(sourcePathRaw,
                                                                                                 text,
                                                                                                 importcCallNames,
                                                                                                 localCallNames,
                                                                                                 externalCallNames,
                                                                                                 currentProfile,
                                                                                                 currentProfileLines,
                                                                                                 profiles,
                                                                                                 profileIndexLookup,
                                                                                                 profileCallLookupCache,
                                                                                                 layer,
                                                                                                 err)

@borrows
fn ParserReadNormalizedExprLayerFromTextWithKnownCallsAndProfiles(sourcePathRaw: str,
                                                                    text: str,
                                                                    importcCallNames: str[],
                                                                    localCallNames: str[],
                                                                    externalCallNames: str[],
                                                                    currentProfile: var NormalizedExprCallProfile,
                                                                    profiles: var NormalizedExprCallProfile[],
                                                                    profileIndexLookup: var ParserSourcePathIndexLookup,
                                                                    layer: var NormalizedExprLayer,
                                                                    err: var str): bool =
    return ParserReadNormalizedExprLayerFromTextWithKnownCallsAndProfilesWithCurrentLines(sourcePathRaw,
                                                                                           text,
                                                                                           importcCallNames,
                                                                                           localCallNames,
                                                                                           externalCallNames,
                                                                                           currentProfile,
                                                                                           currentProfile.lines,
                                                                                           profiles,
                                                                                           profileIndexLookup,
                                                                                           layer,
                                                                                           err)

@borrows
fn parserReadNormalizedExprLayerFromTextWithKnownCallsMode(
        sourcePathRaw: str,
        text: str,
        importcCallNames: str[],
        localCallNames: str[],
        externalCallNames: str[],
        migrationSourceSyntax: bool,
        layer: var NormalizedExprLayer,
        err: var str): bool =
    var priorReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
    NormalizedExprLayerTerminalReleaseWithReceipt(
        layer, priorReleaseReceipt)
    var normalizedText: str
    if !ParserRewriteMultilineStringSourceText(
           text, normalizedText, err):
        return false
    var currentProfile: NormalizedExprCallProfile
    currentProfile.sourcePath = ParserNormalizePath(sourcePathRaw)
    currentProfile.ownerModulePath = ""
    currentProfile.migrationSourceSyntax = migrationSourceSyntax
    currentProfile.text = share(normalizedText)
    currentProfile.lines = ParserSplitChar(normalizedText, '\n')
    currentProfile.decls = []
    currentProfile.typeDecls = []
    currentProfile.importcCallNames = ParserCloneTextSeq(importcCallNames)
    currentProfile.localCallNames = ParserCloneTextSeq(localCallNames)
    currentProfile.importEdges = []
    currentProfile.maxQualifiedCallDepth = ParserMaxQualifiedCallDepthLines(currentProfile.lines)
    ParserReadNormalizedTypeDeclsLines(currentProfile.lines, currentProfile.typeDecls)
    var profiles: NormalizedExprCallProfile[]
    var profileIndexLookup = ParserSourcePathIndexLookupBuild(profiles)
    return ParserReadNormalizedExprLayerFromTextWithKnownCallsAndProfiles(sourcePathRaw,
                                                                            normalizedText,
                                                                            importcCallNames,
                                                                            localCallNames,
                                                                            externalCallNames,
                                                                            currentProfile,
                                                                            profiles,
                                                                            profileIndexLookup,
                                                                            layer,
                                                                            err)

@borrows
fn ParserReadNormalizedExprLayerFromTextWithKnownCalls(sourcePathRaw: str,
                                                         text: str,
                                                         importcCallNames: str[],
                                                         localCallNames: str[],
                                                         externalCallNames: str[],
                                                         layer: var NormalizedExprLayer,
                                                         err: var str): bool =
    return parserReadNormalizedExprLayerFromTextWithKnownCallsMode(
        sourcePathRaw,
        text,
        importcCallNames,
        localCallNames,
        externalCallNames,
        false,
        layer,
        err)

# Read-only over `sourcePathRaw` and `text`: both are only normalized/scanned
# and forwarded to readers that borrow them as well; neither is rebound,
# stored into `layer` or released here.  Without @borrows the default MOVE
# consumes the caller's strings, which makes a caller that feeds the same
# source twice (or feeds it from inside a loop) a double move.
@borrows
fn ParserReadNormalizedExprLayerFromText(sourcePathRaw: str,
                                           text: str,
                                           layer: var NormalizedExprLayer,
                                           err: var str): bool =
    var priorReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
    NormalizedExprLayerTerminalReleaseWithReceipt(
        layer, priorReleaseReceipt)
    let sourcePath = ParserNormalizePath(sourcePathRaw)
    if sourcePath == "":
        err = "missing source path"
        return false
    var decls: NormalizedFunctionDecl[]
    var declErr = ""
    if !ParserReadNormalizedFunctionDecls(text, decls, declErr):
        err = declErr
        return false
    var importcCallNames: str[]
    var localCallNames: str[]
    ParserImportcCallNamesFromDecls(decls, importcCallNames)
    ParserLocalCallNamesFromDecls(decls, localCallNames)
    return ParserReadNormalizedExprLayerFromTextWithKnownCalls(sourcePath,
                                                                 text,
                                                                 importcCallNames,
                                                                 localCallNames,
                                                                 [],
                                                                 layer,
                                                                 err)

fn ParserReadMigrationSourceNormalizedExprLayerFromText(
        sourcePathRaw: str,
        text: str,
        layer: var NormalizedExprLayer,
        err: var str): bool =
    var priorReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
    NormalizedExprLayerTerminalReleaseWithReceipt(
        layer, priorReleaseReceipt)
    let sourcePath = ParserNormalizePath(sourcePathRaw)
    if sourcePath == "":
        err = "missing source path"
        return false
    var decls: NormalizedFunctionDecl[]
    var declErr = ""
    if !ParserReadMigrationSourceFunctionDeclsLines(
           ParserSplitChar(text, '\n'), decls, declErr):
        err = declErr
        return false
    var importcCallNames: str[]
    var localCallNames: str[]
    ParserImportcCallNamesFromDecls(decls, importcCallNames)
    ParserLocalCallNamesFromDecls(decls, localCallNames)
    return parserReadNormalizedExprLayerFromTextWithKnownCallsMode(
        sourcePath,
        text,
        importcCallNames,
        localCallNames,
        [],
        true,
        layer,
        err)

fn ParserReadSimpleSurfaceStmtExprLayerFromText(sourcePath: str,
                                                 text: str,
                                                 exprLayer: var NormalizedExprLayer,
                                                 err: var str): bool =
    var priorReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
    NormalizedExprLayerTerminalReleaseWithReceipt(
        exprLayer, priorReleaseReceipt)
    exprLayer.sourceCount = 1
    var normalizedText: str
    if !ParserRewriteMultilineStringSourceText(
           text, normalizedText, err):
        var failureReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
        NormalizedExprLayerTerminalReleaseWithReceipt(
            exprLayer, failureReleaseReceipt)
        return false
    var splitLinesForContinuation = ParserSplitChar(normalizedText, '\n')
    var preparedLinesForContinuation = ParserPrepareCodeLines(splitLinesForContinuation)
    var lines = ParserJoinContinuationLines(preparedLinesForContinuation)
    var structuredSeeds: ParserStructuredStatementSeed[]
    var lineScopeIds: int32[]
    var lineInlineSuiteBodyColumns: int32[]
    var lineInlineSuiteScopeIds: int32[]
    var lineDeferOwnerOrdinals: int32[]
    var lineInlineDeferBodyColumns: int32[]
    var lineInlineDeferSuiteScopeIds: int32[]
    var scopeBuildLineVisitCount: int64
    var structuredBuildLineVisitCount: int64
    if !ParserBuildStructuredStatementFacts(sourcePath,
                                              lines,
                                              exprLayer,
                                              structuredSeeds,
                                              lineScopeIds,
                                              lineInlineSuiteBodyColumns,
                                              lineInlineSuiteScopeIds,
                                              lineDeferOwnerOrdinals,
                                              lineInlineDeferBodyColumns,
                                              lineInlineDeferSuiteScopeIds,
                                              scopeBuildLineVisitCount,
                                              structuredBuildLineVisitCount,
                                              err):
        var failureReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
        NormalizedExprLayerTerminalReleaseWithReceipt(
            exprLayer, failureReleaseReceipt)
        return false
    var nextStructuredSeed: int32
    for i in 0..<lines.len:
        ParserAppendStructuredSeedsForLine(sourcePath,
                                            i,
                                            structuredSeeds,
                                            nextStructuredSeed,
                                            exprLayer)
        # `//`-aware 剥注释: 同 ParserPrepareCodeLines 一族(见
        # ParserStripLineCommentSlashAware 定义处注释), 这是本函数(ParserJoin
        # ContinuationLines 的另一个平行入口)自己的逐行 strip 步骤。
        let line = ParserStripLineCommentSlashAware(lines[i])
        if !ParserHasNonTrimChar(line):
            continue
        let lineNumber = i + 1
        let exprStart = exprLayer.exprs.len
        ParserAppendSimpleSurfaceExprsLine(sourcePath,
                                            lineNumber,
                                            line,
                                            true,
                                            false,
                                            false,
                                            exprLayer)
        ParserAppendReturnStmtExprsLine(sourcePath, lineNumber, line, exprLayer)
        ParserAppendAssignStmtExprsLine(sourcePath, lineNumber, line, exprLayer)
        var lineScopeId: int32
        var inlineSuiteBodyColumn = -1
        var inlineSuiteScopeId = -1
        var lineDeferOwnerOrdinal = -1
        var inlineDeferBodyColumn = -1
        var inlineDeferSuiteScopeId = -1
        if i < lineScopeIds.len && lineScopeIds[i] >= 0:
            lineScopeId = lineScopeIds[i]
        if i < lineInlineSuiteBodyColumns.len:
            inlineSuiteBodyColumn = lineInlineSuiteBodyColumns[i]
        if i < lineInlineSuiteScopeIds.len:
            inlineSuiteScopeId = lineInlineSuiteScopeIds[i]
        if i < lineDeferOwnerOrdinals.len:
            lineDeferOwnerOrdinal = lineDeferOwnerOrdinals[i]
        if i < lineInlineDeferBodyColumns.len:
            inlineDeferBodyColumn = lineInlineDeferBodyColumns[i]
        if i < lineInlineDeferSuiteScopeIds.len:
            inlineDeferSuiteScopeId = lineInlineDeferSuiteScopeIds[i]
        ParserAnnotateExprDelta(exprLayer,
                                 exprStart,
                                 lineScopeId,
                                 inlineSuiteBodyColumn,
                                 inlineSuiteScopeId,
                                 lineDeferOwnerOrdinal,
                                 inlineDeferBodyColumn,
                                 inlineDeferSuiteScopeId)
    err = ""
    return true

fn ParserReadNormalizedExprLayerFromPath(sourcePathRaw: str,
                                           layer: var NormalizedExprLayer,
                                           err: var str): bool =
    var priorReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
    NormalizedExprLayerTerminalReleaseWithReceipt(
        layer, priorReleaseReceipt)
    let sourcePath: str = ParserNormalizePath(sourcePathRaw)
    if !ParserSourceExists(sourcePath):
        err = "source file missing"
        return false
    let text: str = chengpath.PathReadTextFileWithHandle(sourcePath)
    if text == "":
        err = "failed to read source"
        return false
    return ParserReadNormalizedExprLayerFromText(sourcePath, text, layer, err)

fn ParserStringSeqContains(items: str[], targetRaw: str): bool =
    let target = chengpath.PathTrim(targetRaw)
    for i in 0..<items.len:
        if ParserTextEqualsExact(items[i], target):
            return true
    return false

@borrows
fn ParserTextLookupDotCount(text: str): int32 =
    var count: int32
    var i: int32
    for i in i..<text.len:
        if text[i] == '.':
            count = count + 1
    return count

@borrows
fn ParserTextLookupContentHash(text: str): int32 =
    var h: int32
    var i: int32
    for i in i..<text.len:
        h = h * 131 + Int32(text[i])
    if h < 0:
        h = -h
    return h

# [tg-knife] Slot hash for a name token.  Byte-identical arithmetic to
# ParserTextLookupKeyExact + ParserTextLookupHash on the same bytes (same
# keyLen/first/last/dotCount/contentHash parts, same seed, multiplier and
# mixing); the only change is the bytes' provenance: read directly from the
# borrowed interned source view instead of a per-call CloneStrRange heap
# string.
@borrows
fn ParserNameSeenSetSlotHashForToken(tree: ParserValueExprTree,
                                       nameToken: int32): int64 =
    let spanStart = ParserValueExprTokenStartAt(tree, nameToken)
    let spanEnd = ParserValueExprTokenEndAt(tree, nameToken)
    let keyLen = spanEnd - spanStart
    if keyLen <= 0:
        return 0
    let text = langintern.LookupInternBorrowedText(
        tree.internPool,
        ParserValueExprTokenSourceIdAt(tree, nameToken))
    let firstCode = Int32(text[spanStart])
    let lastCode = Int32(text[spanEnd - 1])
    var dotCount: int32
    var h: int32
    var index: int32 = spanStart
    while index < spanEnd:
        let ch = text[index]
        if ch == '.':
            dotCount = dotCount + 1
        h = h * 131 + Int32(ch)
        index = index + 1
    if h < 0:
        h = -h
    return ParserTextLookupHash(keyLen,
                                  firstCode,
                                  lastCode,
                                  dotCount,
                                  h)

fn ParserNameSeenSetInit(minCap: int32): ParserNameSeenSet =
    var seen: ParserNameSeenSet
    seen.slots = []
    seen.totalCount = 0
    var cap: int32 = 32
    while cap < minCap:
        cap = cap * 2
    # [d5-presize] one setLen allocation, byte-identical all-zero window to
    # the per-add growth loop it replaces (same shape as
    # ParserTextLookupInit).
    setLen(seen.slots, cap)
    return seen

@borrows
fn ParserNameSeenSetGrow(tree: ParserValueExprTree,
                           seen: var ParserNameSeenSet) =
    # Same shape as ParserTextLookupRehash: build the fresh zeroed table,
    # re-place every stored entry, swap only after the old buffer is fully
    # consumed.  Re-placement recomputes each token's slot hash from the
    # borrowed interned view (identical arithmetic), so a grown table holds
    # exactly the same name set.
    let oldLen = seen.slots.len
    var nextCap: int32 = oldLen * 2
    if nextCap < 32:
        nextCap = 32
    var slots: int32[]
    setLen(slots, nextCap)
    let mask = nextCap - 1
    for slotIndex in 0..<oldLen:
        let storedPlus1 = seen.slots[slotIndex]
        if storedPlus1 == 0:
            continue
        let storedHash = ParserNameSeenSetSlotHashForToken(tree,
                                                             storedPlus1 - 1)
        var probe: int32 = Int32(storedHash & Int64(mask))
        while slots[probe] != 0:
            probe = (probe + 1) & mask
        slots[probe] = storedPlus1
    seen.slots = slots

# [tg-knife] Insert a name token into the seen set.  Returns false when a
# token with exactly equal name text is already present -- the same verdict
# ParserTextLookupInsertExact produced for the same inserts -- without
# materializing either the probe clone or the stored owned copy.
@borrows
fn ParserNameSeenSetInsert(tree: ParserValueExprTree,
                             seen: var ParserNameSeenSet,
                             nameToken: int32): bool =
    if nameToken < 0 || nameToken >= tree.tokenCount:
        return false
    if ParserValueExprTokenEndAt(tree, nameToken) -
           ParserValueExprTokenStartAt(tree, nameToken) <= 0:
        return false
    if (seen.totalCount + 1) * 10 >= seen.slots.len * 7:
        ParserNameSeenSetGrow(tree, seen)
    let mask = seen.slots.len - 1
    let slotHash = ParserNameSeenSetSlotHashForToken(tree, nameToken)
    var probe: int32 = Int32(slotHash & Int64(mask))
    var scanned: int32
    while scanned <= mask:
        let storedPlus1 = seen.slots[probe]
        if storedPlus1 == 0:
            seen.slots[probe] = nameToken + 1
            seen.totalCount = seen.totalCount + 1
            return true
        if ParserValueExprNameTokenTextEqualsToken(tree,
                                                     storedPlus1 - 1,
                                                     nameToken):
            return false
        probe = (probe + 1) & mask
        scanned = scanned + 1
    panic("parser name seen set: table full")

@borrows
fn ParserTextLookupKeyExact(text: str): ParserTextLookupKey =
    var key: ParserTextLookupKey
    key.keyLen = text.len
    if text == "":
        key.firstCode = 0
        key.lastCode = 0
        key.dotCount = 0
        key.textHash = 0
        return key
    key.firstCode = Int32(text[0])
    key.lastCode = Int32(text[text.len - 1])
    var dotCount: int32
    var h: int32
    var i: int32
    for i in i..<text.len:
        let ch = text[i]
        if ch == '.':
            dotCount = dotCount + 1
        h = h * 131 + Int32(ch)
    if h < 0:
        h = -h
    key.dotCount = dotCount
    key.textHash = h
    return key

fn ParserTextLookupInit(minCap: int32): ParserTextLookup =
    var lookup: ParserTextLookup
    lookup.slots = []
    lookup.buckets = []
    lookup.totalCount = 0
    var cap: int32 = 32
    while cap < minCap:
        cap = cap * 2
    # [d5-presize] the add loop grows the slot array through log2(cap)
    # doublings and leaks one superseded buffer per doubling (D4 verdict,
    # cheng_cold.c codegen_seq_i32_add growth path never frees the old
    # buffer).  setLen allocates exactly once and zero-fills the whole
    # window, byte-identical to the all-zero content the loop produced.
    # The periodic guard check collapses to one call before the fill.
    setLen(lookup.slots, cap)
    return lookup

fn ParserTextLookupHash(keyLen: int32,
                          firstCode: int32,
                          lastCode: int32,
                          dotCount: int32,
                          textHash: int32): int64 =
    var h: int64 = Int64(textHash)
    h = h * 131 + Int64(firstCode)
    h = h * 131 + Int64(lastCode)
    h = h * 131 + Int64(dotCount)
    h = h * 131 + Int64(keyLen)
    if h < 0:
        h = -h
    return h

@borrows
fn ParserTextLookupSlotForParts(lookup: ParserTextLookup,
                                  keyLen: int32,
                                  firstCode: int32,
                                  lastCode: int32,
                                  dotCount: int32,
                                  textHash: int32): int32 =
    if lookup.slots.len <= 0:
        return -1
    let mask = lookup.slots.len - 1
    var probe: int32 = Int32(ParserTextLookupHash(keyLen,
                                                    firstCode,
                                                    lastCode,
                                                    dotCount,
                                                    textHash) & Int64(mask))
    var scanned: int32
    while scanned <= mask:
        let bucketIndexPlus1 = lookup.slots[probe]
        if bucketIndexPlus1 == 0:
            return probe
        if lookup.buckets[bucketIndexPlus1 - 1].keyLen == keyLen &&
           lookup.buckets[bucketIndexPlus1 - 1].firstCode == firstCode &&
           lookup.buckets[bucketIndexPlus1 - 1].lastCode == lastCode &&
           lookup.buckets[bucketIndexPlus1 - 1].dotCount == dotCount &&
           lookup.buckets[bucketIndexPlus1 - 1].textHash == textHash:
            return probe
        probe = (probe + 1) & mask
        scanned = scanned + 1
    return -1

@borrows
fn ParserTextLookupSlotForKey(lookup: ParserTextLookup,
                                key: ParserTextLookupKey): int32 =
    return ParserTextLookupSlotForParts(lookup,
                                          key.keyLen,
                                          key.firstCode,
                                          key.lastCode,
                                          key.dotCount,
                                          key.textHash)

fn ParserTextLookupRehash(lookup: var ParserTextLookup,
                            newCap: int32) =
    var slots: int32[]
    # [d5-presize] same shape as ParserTextLookupInit: setLen allocates once
    # and zero-fills, identical content to the add(slots, 0) loop with zero
    # displaced buffers.
    setLen(slots, newCap)
    lookup.slots = slots
    for bucketIndex in 0..<lookup.buckets.len:
        let slot = ParserTextLookupSlotForParts(lookup,
                                                  lookup.buckets[bucketIndex].keyLen,
                                                  lookup.buckets[bucketIndex].firstCode,
                                                  lookup.buckets[bucketIndex].lastCode,
                                                  lookup.buckets[bucketIndex].dotCount,
                                                  lookup.buckets[bucketIndex].textHash)
        if slot >= 0:
            lookup.slots[slot] = bucketIndex + 1

fn ParserTextLookupGrow(lookup: var ParserTextLookup) =
    var nextCap: int32 = lookup.slots.len * 2
    if nextCap < 32:
        nextCap = 32
    ParserTextLookupRehash(lookup, nextCap)

@borrows
fn ParserTextLookupBucketIndexExact(lookup: ParserTextLookup,
                                      text: str): int32 =
    if text == "":
        return -1
    return ParserTextLookupBucketIndexKey(lookup, ParserTextLookupKeyExact(text))

@borrows
fn ParserTextLookupBucketIndexKey(lookup: ParserTextLookup,
                                    key: ParserTextLookupKey): int32 =
    if key.keyLen <= 0:
        return -1
    let slot = ParserTextLookupSlotForKey(lookup, key)
    if slot < 0:
        return -1
    let bucketIndexPlus1 = lookup.slots[slot]
    if bucketIndexPlus1 > 0:
        return bucketIndexPlus1 - 1
    return -1

fn ParserTextLookupEnsureBucket(lookup: var ParserTextLookup,
                                  text: str): int32 =
    if text == "":
        return -1
    return ParserTextLookupEnsureBucketKey(lookup, ParserTextLookupKeyExact(text))

@borrows
fn ParserTextLookupEnsureBucketKey(lookup: var ParserTextLookup,
                                     key: ParserTextLookupKey): int32 =
    if lookup.slots.len <= 0:
        lookup = ParserTextLookupInit(32)
    if (lookup.buckets.len + 1) * 10 >= lookup.slots.len * 7:
        ParserTextLookupGrow(lookup)
    let slot = ParserTextLookupSlotForKey(lookup, key)
    if slot < 0:
        return -1
    let existing = lookup.slots[slot]
    if existing > 0:
        return existing - 1
    var bucket: ParserTextLookupBucket
    bucket.keyLen = key.keyLen
    bucket.firstCode = key.firstCode
    bucket.lastCode = key.lastCode
    bucket.dotCount = key.dotCount
    bucket.textHash = key.textHash
    bucket.items = []
    add(lookup.buckets, bucket)
    lookup.slots[slot] = lookup.buckets.len
    return lookup.buckets.len - 1

@borrows
fn ParserTextLookupInsertExact(lookup: var ParserTextLookup,
                                 value: str): bool =
    if value == "":
        return false
    return ParserTextLookupInsertKey(lookup, value, ParserTextLookupKeyExact(value))

@borrows
fn ParserTextLookupInsertKey(lookup: var ParserTextLookup,
                               value: str,
                               key: ParserTextLookupKey): bool =
    if value == "" || key.keyLen <= 0:
        return false
    let bucketIndex = ParserTextLookupEnsureBucketKey(lookup, key)
    if bucketIndex < 0:
        return false
    for i in 0..<lookup.buckets[bucketIndex].items.len:
        if ParserTextEqualsExact(lookup.buckets[bucketIndex].items[i], value):
            return false
    add(lookup.buckets[bucketIndex].items, ParserOwnedText(value))
    lookup.totalCount = lookup.totalCount + 1
    return true

fn ParserTextLookupAddExact(lookup: var ParserTextLookup,
                              value: str) =
    let _ = ParserTextLookupInsertExact(lookup, value)

@borrows
fn ParserTextLookupAdd(lookup: var ParserTextLookup,
                         text: str) =
    let value = ParserOwnedText(chengpath.PathTrim(text))
    ParserTextLookupAddExact(lookup, value)

fn ParserTextLookupAddAll(lookup: var ParserTextLookup,
                            items: str[]) =
    for i in 0..<items.len:
        ParserTextLookupAdd(lookup, items[i])

@borrows
fn ParserTextLookupAddAllExact(lookup: var ParserTextLookup,
                                 items: str[]) =
    for i in 0..<items.len:
        let value = items[i]
        if value == "":
            continue
        let _ = ParserTextLookupInsertKey(lookup, value, ParserTextLookupKeyExact(value))

fn ParserTextLookupBuild(items: str[]): ParserTextLookup =
    var lookup = ParserTextLookupInit(items.len * 2 + 8)
    ParserTextLookupAddAll(lookup, items)
    return lookup

@borrows
fn ParserTextLookupBuildExact(items: str[]): ParserTextLookup =
    var lookup = ParserTextLookupInit(items.len * 2 + 8)
    ParserTextLookupAddAllExact(lookup, items)
    return lookup

@borrows
fn ParserTextLookupContainsExact(lookup: ParserTextLookup,
                                   target: str): bool =
    if target == "":
        return false
    return ParserTextLookupContainsKey(lookup, target, ParserTextLookupKeyExact(target))

@borrows
fn ParserTextLookupContainsKey(lookup: ParserTextLookup,
                                 value: str,
                                 key: ParserTextLookupKey): bool =
    if value == "" || key.keyLen <= 0:
        return false
    let bucketIndex = ParserTextLookupBucketIndexKey(lookup, key)
    if bucketIndex < 0:
        return false
    for i in 0..<lookup.buckets[bucketIndex].items.len:
        if ParserTextEqualsExact(lookup.buckets[bucketIndex].items[i], value):
            return true
    return false

@borrows
fn ParserTextLookupContainsExactBorrowed(lookup: ParserTextLookup,
                                           value: str): bool =
    if value == "":
        return false
    let keyLen = value.len
    if keyLen <= 0 || lookup.slots.len <= 0:
        return false
    let firstCode = Int32(value[0])
    let lastCode = Int32(value[keyLen - 1])
    let dotCount = ParserTextLookupDotCount(value)
    let textHash = ParserTextLookupContentHash(value)
    let mask = lookup.slots.len - 1
    var probe: int32 = Int32(ParserTextLookupHash(keyLen,
                                                    firstCode,
                                                    lastCode,
                                                    dotCount,
                                                    textHash) & Int64(mask))
    var scanned: int32
    var bucketIndex: int32 = -1
    while scanned <= mask:
        let bucketIndexPlus1 = lookup.slots[probe]
        if bucketIndexPlus1 == 0:
            return false
        let currentBucketIndex = bucketIndexPlus1 - 1
        if lookup.buckets[currentBucketIndex].keyLen == keyLen &&
           lookup.buckets[currentBucketIndex].firstCode == firstCode &&
           lookup.buckets[currentBucketIndex].lastCode == lastCode &&
           lookup.buckets[currentBucketIndex].dotCount == dotCount &&
           lookup.buckets[currentBucketIndex].textHash == textHash:
            bucketIndex = currentBucketIndex
            break
        probe = (probe + 1) & mask
        scanned = scanned + 1
    if bucketIndex < 0:
        return false
    for i in 0..<lookup.buckets[bucketIndex].items.len:
        if ParserTextEqualsExact(lookup.buckets[bucketIndex].items[i], value):
            return true
    return false

@borrows
fn ParserMatchKnownCallSurfaceTextBorrowed(callLookup: ParserTextLookup,
                                            callName: str,
                                            qualifiedCallName: str,
                                            dottedCallName: str): str =
    if dottedCallName != callName:
        if ParserTextLookupContainsExactBorrowed(callLookup, dottedCallName):
            return dottedCallName
    if qualifiedCallName != callName:
        if ParserTextLookupContainsExactBorrowed(callLookup, qualifiedCallName):
            return qualifiedCallName
    if dottedCallName != callName:
        return ""
    if ParserTextLookupContainsExactBorrowed(callLookup, callName):
        return callName
    return ""

@borrows
fn ParserMatchKnownCallSurfaceTextBorrowed3(localCallLookup: ParserTextLookup,
                                             externalCallLookup: ParserTextLookup,
                                             importcCallLookup: ParserTextLookup,
                                             callName: str,
                                             qualifiedCallName: str,
                                             dottedCallName: str): str =
    if dottedCallName != callName:
        if ParserTextLookupContainsAnyExactBorrowed(localCallLookup,
                                                     externalCallLookup,
                                                     importcCallLookup,
                                                     dottedCallName):
            return dottedCallName
    if qualifiedCallName != callName:
        if ParserTextLookupContainsAnyExactBorrowed(localCallLookup,
                                                     externalCallLookup,
                                                     importcCallLookup,
                                                     qualifiedCallName):
            return qualifiedCallName
    if dottedCallName != callName:
        return ""
    if ParserTextLookupContainsAnyExactBorrowed(localCallLookup,
                                                 externalCallLookup,
                                                 importcCallLookup,
                                                 callName):
        return callName
    return ""

@borrows
fn ParserSourcePathIndexLookupInit(minCap: int32): ParserSourcePathIndexLookup =
    var lookup: ParserSourcePathIndexLookup
    lookup.slots = []
    lookup.buckets = []
    var cap: int32 = 32
    while cap < minCap:
        cap = cap * 2
    # [d5-presize] same shape as ParserTextLookupInit: setLen allocates once
    # and zero-fills, identical content to the add(slots, 0) loop with zero
    # displaced buffers; guard check collapses to one call before the fill.
    setLen(lookup.slots, cap)
    return lookup

@borrows
fn ParserSourcePathIndexLookupSlotForParts(lookup: ParserSourcePathIndexLookup,
                                             keyLen: int32,
                                             firstCode: int32,
                                             lastCode: int32,
                                             dotCount: int32,
                                             sourcePathHash: int32): int32 =
    if lookup.slots.len <= 0:
        return -1
    let mask = lookup.slots.len - 1
    var probe: int32 = Int32(ParserTextLookupHash(keyLen,
                                                    firstCode,
                                                    lastCode,
                                                    dotCount,
                                                    sourcePathHash) & Int64(mask))
    var scanned: int32
    while scanned <= mask:
        let bucketIndexPlus1 = lookup.slots[probe]
        if bucketIndexPlus1 == 0:
            return probe
        if lookup.buckets[bucketIndexPlus1 - 1].keyLen == keyLen &&
           lookup.buckets[bucketIndexPlus1 - 1].firstCode == firstCode &&
           lookup.buckets[bucketIndexPlus1 - 1].lastCode == lastCode &&
           lookup.buckets[bucketIndexPlus1 - 1].dotCount == dotCount &&
           lookup.buckets[bucketIndexPlus1 - 1].sourcePathHash == sourcePathHash:
            return probe
        probe = (probe + 1) & mask
        scanned = scanned + 1
    return -1

fn ParserSourcePathIndexLookupRehash(lookup: var ParserSourcePathIndexLookup,
                                       newCap: int32) =
    var slots: int32[]
    # [d5-presize] same shape as ParserTextLookupRehash: setLen allocates
    # once and zero-fills, identical content to the add(slots, 0) loop with
    # zero displaced buffers.
    setLen(slots, newCap)
    lookup.slots = slots
    for bucketIndex in 0..<lookup.buckets.len:
        let slot = ParserSourcePathIndexLookupSlotForParts(lookup,
                                                             lookup.buckets[bucketIndex].keyLen,
                                                             lookup.buckets[bucketIndex].firstCode,
                                                             lookup.buckets[bucketIndex].lastCode,
                                                             lookup.buckets[bucketIndex].dotCount,
                                                             lookup.buckets[bucketIndex].sourcePathHash)
        if slot >= 0:
            lookup.slots[slot] = bucketIndex + 1

fn ParserSourcePathIndexLookupGrow(lookup: var ParserSourcePathIndexLookup) =
    var nextCap: int32 = lookup.slots.len * 2
    if nextCap < 32:
        nextCap = 32
    ParserSourcePathIndexLookupRehash(lookup, nextCap)

@borrows
fn ParserSourcePathIndexBucketIndexExact(lookup: ParserSourcePathIndexLookup,
                                           sourcePath: str): int32 =
    if sourcePath == "":
        return -1
    let keyLen = sourcePath.len
    let firstCode = Int32(sourcePath[0])
    let lastCode = Int32(sourcePath[keyLen - 1])
    let dotCount = ParserTextLookupDotCount(sourcePath)
    let sourcePathHash = ParserTextLookupContentHash(sourcePath)
    let slot = ParserSourcePathIndexLookupSlotForParts(lookup,
                                                         keyLen,
                                                         firstCode,
                                                         lastCode,
                                                         dotCount,
                                                         sourcePathHash)
    if slot < 0:
        return -1
    let bucketIndexPlus1 = lookup.slots[slot]
    if bucketIndexPlus1 > 0:
        return bucketIndexPlus1 - 1
    return -1

@borrows
fn ParserSourcePathIndexEnsureBucket(lookup: var ParserSourcePathIndexLookup,
                                       sourcePath: str): int32 =
    if lookup.slots.len <= 0:
        lookup = ParserSourcePathIndexLookupInit(32)
    if (lookup.buckets.len + 1) * 10 >= lookup.slots.len * 7:
        ParserSourcePathIndexLookupGrow(lookup)
    let keyLen = sourcePath.len
    let firstCode = Int32(sourcePath[0])
    let lastCode = Int32(sourcePath[keyLen - 1])
    let dotCount = ParserTextLookupDotCount(sourcePath)
    let sourcePathHash = ParserTextLookupContentHash(sourcePath)
    let slot = ParserSourcePathIndexLookupSlotForParts(lookup,
                                                         keyLen,
                                                         firstCode,
                                                         lastCode,
                                                         dotCount,
                                                         sourcePathHash)
    if slot < 0:
        return -1
    let existing = lookup.slots[slot]
    if existing > 0:
        return existing - 1
    var bucket: ParserSourcePathIndexBucket
    bucket.keyLen = keyLen
    bucket.firstCode = firstCode
    bucket.lastCode = lastCode
    bucket.dotCount = dotCount
    bucket.sourcePathHash = sourcePathHash
    bucket.items = []
    add(lookup.buckets, bucket)
    lookup.slots[slot] = lookup.buckets.len
    return lookup.buckets.len - 1

fn ParserSourcePathIndexLookupInsertExact(lookup: var ParserSourcePathIndexLookup,
                                            sourcePath: str,
                                            profileIndex: int32) =
    if sourcePath == "" || profileIndex < 0:
        return
    let bucketIndex = ParserSourcePathIndexEnsureBucket(lookup, sourcePath)
    if bucketIndex < 0:
        return
    let items = lookup.buckets[bucketIndex].items
    for i in 0..<items.len:
        if ParserTextEqualsExact(items[i].sourcePath, sourcePath):
            return
    var entry: ParserSourcePathIndexEntry
    entry.sourcePath = sourcePath
    entry.profileIndex = profileIndex
    add(lookup.buckets[bucketIndex].items, entry)

fn ParserSourcePathIndexLookupBuild(profiles: var NormalizedExprCallProfile[]): ParserSourcePathIndexLookup =
    var lookup = ParserSourcePathIndexLookupInit(profiles.len * 2 + 8)
    for i in 0..<profiles.len:
        ParserSourcePathIndexLookupInsertExact(lookup,
                                                 ParserNormalizePath(profiles[i].sourcePath),
                                                 i)
    return lookup

@borrows
fn ParserProfileIndexLookupForNormalizedSourcePathExact(lookup: ParserSourcePathIndexLookup,
                                                          sourcePath: str): int32 =
    if sourcePath == "":
        return -1
    let bucketIndex = ParserSourcePathIndexBucketIndexExact(lookup, sourcePath)
    if bucketIndex < 0:
        return -1
    let items = lookup.buckets[bucketIndex].items
    for i in 0..<items.len:
        if ParserTextEqualsExact(items[i].sourcePath, sourcePath):
            return items[i].profileIndex
    return -1

@borrows
fn ParserSourcePathIndexBucketIndexForImportEdgeTargetSourcePath(lookup: ParserSourcePathIndexLookup,
                                                                   edge: ImportEdge): int32 =
    return ParserSourcePathIndexBucketIndexExact(lookup, ParserNormalizePath(edge.targetSourcePath))

@borrows
fn ParserProfileIndexLookupForImportEdgeTargetSourcePath(lookup: ParserSourcePathIndexLookup,
                                                           edge: ImportEdge): int32 =
    let normalizedPath = ParserNormalizePath(edge.targetSourcePath)
    if normalizedPath == "":
        return -1
    let bucketIndex = ParserSourcePathIndexBucketIndexForImportEdgeTargetSourcePath(lookup, edge)
    if bucketIndex < 0:
        return -1
    let items = lookup.buckets[bucketIndex].items
    for i in 0..<items.len:
        if ParserTextEqualsExact(items[i].sourcePath, normalizedPath):
            return items[i].profileIndex
    return -1

@borrows
fn ParserImportEdgeTargetProfileIndex(edge: ImportEdge,
                                        profileIndexLookup: ParserSourcePathIndexLookup): int32 =
    if edge.targetProfileIndex >= 0:
        return edge.targetProfileIndex
    return ParserProfileIndexLookupForImportEdgeTargetSourcePath(profileIndexLookup, edge)

fn ParserBindImportEdgeTargetProfileIndices(profiles: var NormalizedExprCallProfile[],
                                              profileIndexLookup: var ParserSourcePathIndexLookup) =
    for profileIndex in 0..<profiles.len:
        var profile = profiles[profileIndex]
        for edgeIndex in 0..<profile.importEdges.len:
            var edge = profile.importEdges[edgeIndex]
            edge.targetProfileIndex = -1
            if edge.resolved:
                edge.targetProfileIndex = ParserProfileIndexLookupForImportEdgeTargetSourcePath(profileIndexLookup,
                                                                                                  edge)
                if edge.targetProfileIndex < 0:
                    let normalizedTargetPath = ParserNormalizePath(edge.targetSourcePath)
                    for targetIndex in 0..<profiles.len:
                        if ParserNormalizePath(profiles[targetIndex].sourcePath) == normalizedTargetPath:
                            edge.targetProfileIndex = targetIndex
                            break
            profile.importEdges[edgeIndex] = edge
        profiles[profileIndex] = profile

@borrows
fn ParserProfileIndexLookupForSourcePath(lookup: ParserSourcePathIndexLookup,
                                           sourcePathRaw: str): int32 =
    return ParserProfileIndexLookupForNormalizedSourcePathExact(lookup,
                                                                  ParserNormalizePath(sourcePathRaw))

@borrows
fn ParserBuildProfileCallLookups(profile: NormalizedExprCallProfile): ParserProfileCallLookupCacheEntry =
    var entry: ParserProfileCallLookupCacheEntry
    entry.localLookup = ParserTextLookupBuildExact(profile.localCallNames)
    entry.importcLookup = ParserTextLookupBuildExact(profile.importcCallNames)
    return entry

@borrows
fn ParserProfileCallLookupCacheEnsureIndex(profiles: NormalizedExprCallProfile[],
                                             profileIndex: int32,
                                             cache: var ParserProfileCallLookupCacheEntry[]): int32 =
    if profileIndex < 0:
        return -1
    if profileIndex >= profiles.len:
        return -1
    while cache.len <= profileIndex:
        var empty: ParserProfileCallLookupCacheEntry
        empty.localLookup.slots = []
        empty.localLookup.buckets = []
        empty.localLookup.totalCount = 0
        empty.importcLookup.slots = []
        empty.importcLookup.buckets = []
        empty.importcLookup.totalCount = 0
        add(cache, empty)
    let entry = cache[profileIndex]
    var shouldBuild = false
    if entry.localLookup.slots.len <= 0:
        if entry.importcLookup.slots.len <= 0:
            shouldBuild = true
    if shouldBuild:
        cache[profileIndex] = ParserBuildProfileCallLookups(profiles[profileIndex])
    return profileIndex

fn ParserAppendUniqueLookupTextExact(out: var str[],
                                       seen: var ParserTextLookup,
                                       value: str) =
    if value == "":
        return
    ParserAppendUniqueLookupTextKey(out, seen, value, ParserTextLookupKeyExact(value))

fn ParserAppendUniqueLookupTextKey(out: var str[],
                                     seen: var ParserTextLookup,
                                     value: str,
                                     valueKey: ParserTextLookupKey) =
    if value == "" || valueKey.keyLen <= 0:
        return
    if ParserTextLookupInsertKey(seen, value, valueKey):
        add(out, value)

fn ParserAppendUniqueLookupText(out: var str[],
                                  seen: var ParserTextLookup,
                                  text: str) =
    let value = chengpath.PathTrim(text)
    ParserAppendUniqueLookupTextExact(out, seen, value)

fn ParserMatchKnownCallSurfaceText(callLookup: ParserTextLookup,
                                     callName: str,
                                     qualifiedCallName: str,
                                     dottedCallName: str): str =
    let callNameKey = ParserTextLookupKeyExact(callName)
    let qualifiedCallNameKey = ParserTextLookupKeyExact(qualifiedCallName)
    let dottedCallNameKey = ParserTextLookupKeyExact(dottedCallName)
    return ParserMatchKnownCallSurfaceTextKeys(callLookup,
                                                 callName,
                                                 callNameKey,
                                                 qualifiedCallName,
                                                 qualifiedCallNameKey,
                                                 dottedCallName,
                                                 dottedCallNameKey)

fn ParserMatchKnownCallSurfaceTextKeys(callLookup: ParserTextLookup,
                                         callName: str,
                                         callNameKey: ParserTextLookupKey,
                                         qualifiedCallName: str,
                                         qualifiedCallNameKey: ParserTextLookupKey,
                                         dottedCallName: str,
                                         dottedCallNameKey: ParserTextLookupKey): str =
    if dottedCallName != callName &&
       ParserTextLookupContainsKey(callLookup,
                                     dottedCallName,
                                     dottedCallNameKey):
        return dottedCallName
    if qualifiedCallName != callName &&
       ParserTextLookupContainsKey(callLookup,
                                     qualifiedCallName,
                                     qualifiedCallNameKey):
        return qualifiedCallName
    if dottedCallName != callName:
        return ""
    if ParserTextLookupContainsKey(callLookup, callName, callNameKey):
        return callName
    return ""

@borrows
fn ParserProfileHasImportQualifier(profile: NormalizedExprCallProfile,
                                     qualifierRaw: str): bool =
    let qualifier = ParserIdentPrefix(chengpath.PathTrim(qualifierRaw))
    if qualifier == "":
        return false
    for i in 0..<profile.importEdges.len:
        if profile.importEdges[i].qualifier == qualifier:
            return true
    return false

@borrows
fn ParserStringSeqContainsExact(items: str[], target: str): bool =
    for i in 0..<items.len:
        if ParserTextEqualsExact(items[i], target):
            return true
    return false

fn ParserIsInlineSpace(ch: char): bool =
    let code = Int32(ch)
    if code == 32:
        return true
    if code == 9:
        return true
    return false

@borrows
fn ParserCharAt(text: str, idx: int32): char =
    return text[idx]

@borrows
@borrow_result
fn ParserFirstToken(textRaw: str): str =
    if textRaw == "":
        return ""
    var start: int32
    while start < textRaw.len:
        if !ParserIsInlineSpace(ParserCharAt(textRaw, start)):
            break
        start = start + 1
    var stop: int32 = start
    while stop < textRaw.len:
        if ParserIsInlineSpace(ParserCharAt(textRaw, stop)):
            break
        stop = stop + 1
    if stop <= start:
        return ""
    return ParserTextSliceFast(textRaw, start, stop - start)

@borrows
fn ParserIdentPrefix(text: str): str =
    var stop: int32
    for i in 0..<text.len:
        let ch = text[i]
        let digit = ch >= '0' && ch <= '9'
        let upper = ch >= 'A' && ch <= 'Z'
        let lower = ch >= 'a' && ch <= 'z'
        if digit || upper || lower || ch == '_':
            stop = i + 1
        else:
            break
    if stop <= 0:
        return ""
    return ParserOwnedTextRange(text, 0, stop)

@borrows
@borrow_result
fn ParserTextSliceFast(text: str,
                         startRaw: int32,
                         countRaw: int32): str =
    return StrSubView(text, startRaw, countRaw)

@borrows
fn ParserTextSliceCopy(text: str,
                       startRaw: int32,
                       countRaw: int32): str =
    ParserDebugStage("slice_copy_enter")
    if countRaw <= 0:
        return ""
    let textLen = text.len
    ParserDebugStage("slice_copy_after_len")
    if textLen <= 0:
        return ""
    var start = startRaw
    if start < 0:
        start = 0
    if start >= textLen:
        return ""
    var count = countRaw
    if start + count > textLen:
        count = textLen - start
    if count <= 0:
        return ""
    ParserDebugStage("slice_copy_after_data")
    if StrDataPtr(text) == nil:
        return ""
    return strings.CloneStrRange(text, start, count)

@borrows
fn ParserSplitChar(textRaw: str, sep: char): str[] =
    ParserDebugStage("split_enter")
    var out: str[]
    ParserSplitCharInto(textRaw, sep, out)
    ParserDebugStage("split_before_return")
    return out

@borrows
fn ParserSplitCharInto(textRaw: str, sep: char, out: var str[]) =
    ParserDebugStage("split_into_enter")
    let text = textRaw
    var partCount: int32 = 1
    for i in 0..<text.len:
        if text[i] == sep:
            partCount = partCount + 1
    ParserDebugStage("split_into_after_count_loop")
    setLen(out, partCount)
    ParserDebugStage("split_into_after_set_len")
    var start: int32
    var outIndex: int32
    for i in 0..<text.len:
        if text[i] == sep:
            let count = i - start
            if count > 0:
                out[outIndex] = ParserOwnedTextRange(text, start, count)
            else:
                out[outIndex] = ""
            outIndex = outIndex + 1
            start = i + 1
    if start <= text.len:
        let count = text.len - start
        if count > 0:
            out[outIndex] = ParserOwnedTextRange(text, start, count)
        else:
            out[outIndex] = ""
    ParserDebugStage("split_into_done")

fn ParserJoinSlash(items: str[]): str =
    var out = buffer.NewByteBuffer()
    let slash: str = "/"
    var wrote = false
    for i in 0..<items.len:
        if items[i] == "":
            continue
        if wrote:
            buffer.AppendText(out, slash)
        buffer.AppendText(out, items[i])
        wrote = true
    return rawbytes.BytesToString(buffer.ToBytes(out))

@borrows
fn ParserStartsWith(textRaw: str, prefixRaw: str): bool =
    let text = chengpath.PathTrim(share(textRaw))
    # T13 根修: prefix 不可 trim —— PathTrim 会吃掉 "var "/"let "/"fn " 等
    # 词边界字面量前缀的尾随空格 ("var " 退化 3 字符 "var"), 致任何前 3 字符
    # 恰为 var 的普通标识符 (如 varI32ParamNames) 被误判命中 "var " 前缀。
    # text 侧保留 trim (既有正确行为, 与 ParserStartsWithExact 的区别只在此)。
    let prefix = prefixRaw
    if prefix.len > text.len:
        return false
    for i in 0..<prefix.len:
        if text[i] != prefix[i]:
            return false
    return true

@borrows
fn ParserStartsWithExact(text: str, prefix: str): bool =
    if prefix.len > text.len:
        return false
    for i in 0..<prefix.len:
        if text[i] != prefix[i]:
            return false
    return true

fn ParserLineStartsWith(lineRaw: str, prefix: str): bool =
    return ParserStartsWith(lineRaw, prefix)

@borrows
fn ParserFindText(text: str, needle: str): int32 =
    if needle.len <= 0:
        return 0
    if needle.len == 1:
        let target = needle[0]
        for i in 0..<text.len:
            if text[i] == target:
                return i
        return -1
    if text.len < needle.len:
        return -1
    for i in 0..<(text.len - needle.len + 1):
        var matched = true
        for j in 0..<needle.len:
            if text[i + j] != needle[j]:
                matched = false
                break
        if matched:
            return i
    return -1

@borrows
fn ParserArgIndexFromName(name: str): int32 =
    if !ParserStartsWithExact(name, "arg"):
        return -1
    let numPart = chengpath.TextSlice(name, 3, name.len - 3)
    if numPart.len <= 0:
        return -1
    if numPart.len > 1 && numPart[0] == '0':
        return -1
    var val: int32
    for i in 0..<numPart.len:
        let ch = numPart[i]
        if ch < '0' || ch > '9':
            return -1
        let digit = Int32(ch - '0')
        if val > (2147483647 - digit) / 10:
            return -1
        val = val * 10 + digit
    return val

@borrows
fn ParserHasLeadingIndent(lineRaw: str): bool =
    if Len(lineRaw) <= 0:
        return false
    let head = Int32(lineRaw[0])
    return head == 32 || head == 9

@borrows
fn ParserNormalizedAnnotationKnownFunctionName(name: str): bool =
    return name == "compiler_top_level" ||
           name == "exportc" ||
           name == "exported" ||
           name == "importc" ||
           name == "ffi_map" ||
           name == "ffi_out_ptrs" ||
           name == "abi_internal" ||
           name == "ffi_owned_result" ||
           name == "borrow_result" ||
           name == "thread_boundary" ||
           name == "borrows" ||
           name == "escapes" ||
           name == "weak" ||
           name == "trusted_abi" ||
           name == "no_alloc" ||
           name == "interrupt_handler" ||
           name == "keep_export_binding" ||
           name == "manual_consume" ||
           name == "ffi_handle"

const
    ParserFunctionAnnotationThreadBoundary: int32 = 1
    ParserFunctionAnnotationBorrows: int32 = 2
    ParserFunctionAnnotationEscapes: int32 = 4
    ParserFunctionAnnotationWeak: int32 = 8
    ParserFunctionAnnotationTrustedAbi: int32 = 16
    ParserFunctionAnnotationNoAlloc: int32 = 32
    ParserFunctionAnnotationInterruptHandler: int32 = 64
    ParserFunctionAnnotationKeepExportBinding: int32 = 128
    ParserFunctionAnnotationBorrowResult: int32 = 256
    ParserFunctionAnnotationManualConsume: int32 = 512
    ParserFunctionAnnotationMask: int32 = 1023

fn ParserNormalizedFunctionManualConsumeIdentityDigest(
        functionDeclarationRow: int32,
        targetParameterOrdinal: int32,
        targetParameterDeclarationRow: int32,
        sourceParameterOrdinal: int32,
        sourceParameterDeclarationRow: int32): int64 =
    var digest: int64 = 2166136261
    digest = (digest * 16777619 +
              Int64(functionDeclarationRow) + 1) % 2147483647
    digest = (digest * 16777619 +
              Int64(targetParameterOrdinal) + 1) % 2147483647
    digest = (digest * 16777619 +
              Int64(targetParameterDeclarationRow) + 1) % 2147483647
    digest = (digest * 16777619 +
              Int64(sourceParameterOrdinal) + 1) % 2147483647
    digest = (digest * 16777619 +
              Int64(sourceParameterDeclarationRow) + 1) % 2147483647
    return digest

@borrows
fn ParserNormalizedFunctionManualConsumeIdentityValid(
        decl: NormalizedFunctionDecl): bool =
    if !decl.manualConsumePresent:
        return decl.manualConsumeFunctionDeclarationRow == -1 &&
               decl.manualConsumeTargetParameterOrdinal == -1 &&
               decl.manualConsumeTargetParameterDeclarationRow == -1 &&
               decl.manualConsumeSourceParameterOrdinal == -1 &&
               decl.manualConsumeSourceParameterDeclarationRow == -1 &&
               decl.manualConsumeIdentityDigest == 0
    if decl.manualConsumeFunctionDeclarationRow < 0 ||
       decl.manualConsumeTargetParameterOrdinal < 0 ||
       decl.manualConsumeTargetParameterDeclarationRow < 0 ||
       decl.manualConsumeSourceParameterOrdinal < 0 ||
       decl.manualConsumeSourceParameterDeclarationRow < 0 ||
       decl.manualConsumeTargetParameterOrdinal ==
           decl.manualConsumeSourceParameterOrdinal ||
       decl.manualConsumeTargetParameterDeclarationRow ==
           decl.manualConsumeSourceParameterDeclarationRow:
        return false
    return decl.manualConsumeIdentityDigest ==
        ParserNormalizedFunctionManualConsumeIdentityDigest(
            decl.manualConsumeFunctionDeclarationRow,
            decl.manualConsumeTargetParameterOrdinal,
            decl.manualConsumeTargetParameterDeclarationRow,
            decl.manualConsumeSourceParameterOrdinal,
            decl.manualConsumeSourceParameterDeclarationRow)

@borrows
fn ParserNormalizedFunctionAnnotationFlags(
        decl: NormalizedFunctionDecl): int32 =
    var flags: int32
    if decl.threadBoundary:
        flags = flags | ParserFunctionAnnotationThreadBoundary
    if decl.borrows:
        flags = flags | ParserFunctionAnnotationBorrows
    if decl.escapes:
        flags = flags | ParserFunctionAnnotationEscapes
    if decl.weak:
        flags = flags | ParserFunctionAnnotationWeak
    if decl.trustedAbi:
        flags = flags | ParserFunctionAnnotationTrustedAbi
    if decl.noAlloc:
        flags = flags | ParserFunctionAnnotationNoAlloc
    if decl.interruptHandler:
        flags = flags | ParserFunctionAnnotationInterruptHandler
    if decl.keepExportBinding:
        flags = flags | ParserFunctionAnnotationKeepExportBinding
    if decl.borrowResult:
        flags = flags | ParserFunctionAnnotationBorrowResult
    if !ParserNormalizedFunctionManualConsumeIdentityValid(decl):
        return -1
    if decl.manualConsumePresent:
        flags = flags | ParserFunctionAnnotationManualConsume
    return flags

@borrows
fn ParserNormalizedFunctionAnnotationFlagsValid(flags: int32): bool =
    if flags < 0 || (flags & ParserFunctionAnnotationMask) != flags:
        return false
    if (flags & ParserFunctionAnnotationBorrows) != 0 &&
       (flags & ParserFunctionAnnotationEscapes) != 0:
        return false
    return (flags & ParserFunctionAnnotationBorrows) == 0 ||
           (flags & ParserFunctionAnnotationManualConsume) == 0

@borrows
fn ParserNormalizedAnnotationRegisteredName(name: str): bool =
    return ParserNormalizedAnnotationKnownFunctionName(name) ||
           name == "profile"

@borrows
fn ParserNormalizedAnnotationArgKindAt(
        tree: ParserValueExprTree,
        row: int32): ParserAnnotationArgKind =
    if row < 0 || row >= tree.annotationArgCount:
        return ParserAnnotationArgInvalid
    return ParserAnnotationArgKind(arenamod.ArenaArrayInt32Get(
        tree.arena, tree.annotationArgKinds, row))

@borrows
fn ParserNormalizedAnnotationArgChildAt(
        tree: ParserValueExprTree,
        row: int32,
        offset: int32): int32 =
    if row < 0 || row >= tree.annotationArgCount:
        return -1
    let childStart = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.annotationArgChildStarts, row)
    let childCount = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.annotationArgChildCounts, row)
    if offset < 0 || offset >= childCount:
        return -1
    return arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.annotationArgChildNodeIndexes,
        childStart + offset)

@borrows
fn ParserNormalizedAnnotationRootCountAt(
        tree: ParserValueExprTree,
        annotationRow: int32): int32 =
    if annotationRow < 0 || annotationRow >= tree.annotationCount:
        return -1
    return arenamod.ArenaArrayInt32Get(
        tree.arena, tree.annotationArgRootCounts, annotationRow)

@borrows
fn ParserNormalizedAnnotationRootAt(
        tree: ParserValueExprTree,
        annotationRow: int32,
        offset: int32): int32 =
    let rootCount = ParserNormalizedAnnotationRootCountAt(
        tree, annotationRow)
    if offset < 0 || offset >= rootCount:
        return -1
    let rootStart = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.annotationArgRootStarts, annotationRow)
    return arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.annotationArgRootNodeIndexes,
        rootStart + offset)

@borrows
fn ParserNormalizedAnnotationIdentifierInto(
        tree: ParserValueExprTree,
        argRow: int32,
        out: var str): bool =
    out = ""
    if ParserNormalizedAnnotationArgKindAt(tree, argRow) !=
           ParserAnnotationArgIdentifier:
        return false
    let token = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.annotationArgTokenIndexes, argRow)
    if token < 0 || token >= tree.tokenCount:
        return false
    out = ParserValueExprTokenText(tree, token)
    return out != ""

@borrows
fn ParserNormalizedAnnotationStringInto(
        tree: ParserValueExprTree,
        argRow: int32,
        out: var str): bool =
    out = ""
    if ParserNormalizedAnnotationArgKindAt(tree, argRow) !=
           ParserAnnotationArgString:
        return false
    let token = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.annotationArgTokenIndexes, argRow)
    if token < 0 || token >= tree.tokenCount:
        return false
    let quoted = ParserValueExprTokenText(tree, token)
    if quoted.len < 2 || quoted[0] != '"' ||
       quoted[quoted.len - 1] != '"':
        return false
    out = ParserTextSliceCopy(quoted, 1, quoted.len - 2)
    return true

@borrows
fn ParserNormalizedAnnotationKeyValueInto(
        tree: ParserValueExprTree,
        argRow: int32,
        keyOut: var str,
        valueRowOut: var int32): bool =
    keyOut = ""
    valueRowOut = -1
    if ParserNormalizedAnnotationArgKindAt(tree, argRow) !=
           ParserAnnotationArgKeyValue:
        return false
    let keyRow = ParserNormalizedAnnotationArgChildAt(tree, argRow, 0)
    let valueRow = ParserNormalizedAnnotationArgChildAt(tree, argRow, 1)
    if keyRow < 0 || valueRow < 0 ||
       !ParserNormalizedAnnotationIdentifierInto(
           tree, keyRow, keyOut):
        return false
    valueRowOut = valueRow
    return true

@borrows
fn ParserNormalizedAnnotationExactStringRootInto(
        tree: ParserValueExprTree,
        annotationRow: int32,
        out: var str): bool =
    out = ""
    if ParserNormalizedAnnotationRootCountAt(
           tree, annotationRow) != 1:
        return false
    return ParserNormalizedAnnotationStringInto(
        tree,
        ParserNormalizedAnnotationRootAt(tree, annotationRow, 0),
        out)

@borrows
fn ParserNormalizedAnnotationExactKeyStringInto(
        tree: ParserValueExprTree,
        annotationRow: int32,
        requiredKey: str,
        out: var str): bool =
    out = ""
    if ParserNormalizedAnnotationRootCountAt(
           tree, annotationRow) != 1:
        return false
    var key: str
    var valueRow: int32
    if !ParserNormalizedAnnotationKeyValueInto(
           tree,
           ParserNormalizedAnnotationRootAt(tree, annotationRow, 0),
           key,
           valueRow) ||
       key != requiredKey:
        return false
    return ParserNormalizedAnnotationStringInto(tree, valueRow, out)

@borrows
fn ParserNormalizedAnnotationExactKeyIdentifierInto(
        tree: ParserValueExprTree,
        annotationRow: int32,
        requiredKey: str,
        out: var str): bool =
    out = ""
    if ParserNormalizedAnnotationRootCountAt(
           tree, annotationRow) != 1:
        return false
    var key: str
    var valueRow: int32
    if !ParserNormalizedAnnotationKeyValueInto(
           tree,
           ParserNormalizedAnnotationRootAt(tree, annotationRow, 0),
           key,
           valueRow) ||
       key != requiredKey:
        return false
    return ParserNormalizedAnnotationIdentifierInto(tree, valueRow, out)

@borrows
fn ParserNormalizedAnnotationFfiMapInto(
        tree: ParserValueExprTree,
        annotationRow: int32,
        ptrArgOut: var int32,
        lenArgOut: var int32): bool =
    ptrArgOut = -1
    lenArgOut = -1
    if ParserNormalizedAnnotationRootCountAt(
           tree, annotationRow) != 2:
        return false
    let first = ParserNormalizedAnnotationRootAt(
        tree, annotationRow, 0)
    let second = ParserNormalizedAnnotationRootAt(
        tree, annotationRow, 1)
    if ParserNormalizedAnnotationArgKindAt(tree, first) ==
           ParserAnnotationArgIdentifier &&
       ParserNormalizedAnnotationArgKindAt(tree, second) ==
           ParserAnnotationArgIdentifier:
        var ptrText: str
        var lenText: str
        if !ParserNormalizedAnnotationIdentifierInto(
               tree, first, ptrText) ||
           !ParserNormalizedAnnotationIdentifierInto(
               tree, second, lenText):
            return false
        ptrArgOut = ParserArgIndexFromName(ptrText)
        lenArgOut = ParserArgIndexFromName(lenText)
        return ptrArgOut >= 0 && lenArgOut >= 0
    var seenPtr = false
    var seenLen = false
    for offset in 0..<2:
        let root = ParserNormalizedAnnotationRootAt(
            tree, annotationRow, offset)
        var key: str
        var valueRow: int32
        var value: str
        if !ParserNormalizedAnnotationKeyValueInto(
               tree, root, key, valueRow) ||
           !ParserNormalizedAnnotationIdentifierInto(
               tree, valueRow, value):
            return false
        let argIndex = ParserArgIndexFromName(value)
        if argIndex < 0:
            return false
        if key == "ptr" && !seenPtr:
            ptrArgOut = argIndex
            seenPtr = true
        elif key == "len" && !seenLen:
            lenArgOut = argIndex
            seenLen = true
        else:
            return false
    return seenPtr && seenLen

@borrows
fn ParserNormalizedAnnotationFfiOutPtrsInto(
        tree: ParserValueExprTree,
        annotationRow: int32,
        out: var str): bool =
    out = ""
    let rootCount = ParserNormalizedAnnotationRootCountAt(
        tree, annotationRow)
    if rootCount <= 0:
        return false
    for offset in 0..<rootCount:
        var value: str
        if !ParserNormalizedAnnotationIdentifierInto(
               tree,
               ParserNormalizedAnnotationRootAt(
                   tree, annotationRow, offset),
               value):
            return false
        let argIndex = ParserArgIndexFromName(value)
        if argIndex < 0:
            return false
        if out == "":
            out = IntToStr(argIndex)
        else:
            out = ParserConcat3(out, ",", IntToStr(argIndex))
    return out != ""

@borrows
fn ParserNormalizedFunctionAnnotationTargetDeclarationRow(
        tree: ParserValueExprTree,
        annotationRow: int32): int32 =
    if annotationRow < 0 || annotationRow >= tree.annotationCount:
        return -1
    let targetToken = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.annotationTargetTokenIndexes, annotationRow)
    if targetToken < 0 || targetToken >= tree.tokenCount:
        return -1
    let targetProducer = ParserValueExprTokenProducerSourceIndexAt(
        tree, targetToken)
    let targetStart = ParserValueExprTokenStartAt(tree, targetToken)
    var found: int32 = -1
    for declarationRow in 0..<tree.declarationCount:
        if ParserDeclarationKind(arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               declarationRow)) != ParserDeclarationFunction ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationProducerSourceIndexes,
               declarationRow) != targetProducer ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationSpanStarts,
               declarationRow) != targetStart:
            continue
        if found >= 0:
            return -1
        found = declarationRow
    return found

@borrows
fn ParserNormalizedFunctionDeclarationRowTopLevel(
        tree: ParserValueExprTree,
        declarationRow: int32): bool =
    if declarationRow < 0 || declarationRow >= tree.declarationCount ||
       ParserDeclarationKind(arenamod.ArenaArrayInt32Get(
           tree.arena,
           tree.declarationKinds,
           declarationRow)) != ParserDeclarationFunction:
        return false
    let ownerRow = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.declarationOwnerRows, declarationRow)
    if ownerRow == -1:
        return true
    return ownerRow >= 0 && ownerRow < tree.declarationCount &&
           ParserDeclarationKind(arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               ownerRow)) == ParserDeclarationModule

@borrows
fn ParserNormalizedFunctionDeclarationStartToken(
        tree: ParserValueExprTree,
        declarationRow: int32): int32 =
    if !ParserNormalizedFunctionDeclarationRowTopLevel(
           tree, declarationRow):
        return -1
    let producer = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.declarationProducerSourceIndexes,
        declarationRow)
    let spanStart = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.declarationSpanStarts,
        declarationRow)
    var found: int32 = -1
    for tokenIndex in 0..<tree.tokenCount:
        if ParserValueExprTokenProducerSourceIndexAt(
               tree, tokenIndex) != producer ||
           ParserValueExprTokenStartAt(tree, tokenIndex) != spanStart:
            continue
        if found >= 0:
            return -1
        found = tokenIndex
    return found

@borrows
fn ParserNormalizedFunctionAnnotationTargetDeclExact(
        tree: ParserValueExprTree,
        annotationRow: int32,
        decls: NormalizedFunctionDecl[]): int32 =
    let targetDeclarationRow =
        ParserNormalizedFunctionAnnotationTargetDeclarationRow(
            tree, annotationRow)
    if !ParserNormalizedFunctionDeclarationRowTopLevel(
           tree, targetDeclarationRow):
        return -1
    var normalizedIndex: int32
    var found: int32 = -1
    for declarationRow in 0..<tree.declarationCount:
        if !ParserNormalizedFunctionDeclarationRowTopLevel(
               tree, declarationRow):
            continue
        let declarationStartToken =
            ParserNormalizedFunctionDeclarationStartToken(
                tree, declarationRow)
        if declarationStartToken < 0 ||
           ParserValueExprTokenKindAt(
               tree, declarationStartToken) != ParserValueTokenFn:
            continue
        if normalizedIndex >= decls.len:
            return -1
        if declarationRow == targetDeclarationRow:
            found = normalizedIndex
        normalizedIndex = normalizedIndex + 1
    if normalizedIndex != decls.len:
        return -1
    return found

@borrows
fn ParserNormalizedFunctionAnnotationTargetDecl(
        tree: ParserValueExprTree,
        annotationRow: int32,
        decls: NormalizedFunctionDecl[]): int32 =
    if annotationRow < 0 || annotationRow >= tree.annotationCount:
        return -1
    let targetToken = arenamod.ArenaArrayInt32Get(
        tree.arena, tree.annotationTargetTokenIndexes, annotationRow)
    if targetToken < 0 || targetToken >= tree.tokenCount:
        return -1
    let targetLine = ParserValueExprTokenLineAt(tree, targetToken)
    let targetColumn = ParserValueExprTokenColumnAt(tree, targetToken) - 1
    var found: int32 = -1
    for declIndex in 0..<decls.len:
        if decls[declIndex].lineIndex != targetLine ||
           decls[declIndex].signatureStartColumn != targetColumn:
            continue
        if found >= 0:
            return -1
        found = declIndex
    return found

@borrows
fn ParserNormalizedFunctionParameterIdentityInto(
        tree: ParserValueExprTree,
        functionDeclarationRow: int32,
        parameterName: str,
        ordinalOut: var int32,
        sourceLocalDeclarationRowOut: var int32): bool =
    ordinalOut = -1
    sourceLocalDeclarationRowOut = -1
    if parameterName == "" ||
       !ParserNormalizedFunctionDeclarationRowTopLevel(
           tree, functionDeclarationRow):
        return false
    let functionProducer = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.declarationProducerSourceIndexes,
        functionDeclarationRow)
    var ordinal: int32
    var matched = false
    for declarationRow in 0..<tree.declarationCount:
        if ParserDeclarationKind(arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               declarationRow)) != ParserDeclarationParameter ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationOwnerRows,
               declarationRow) != functionDeclarationRow:
            continue
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationProducerSourceIndexes,
               declarationRow) != functionProducer:
            return false
        let parameterNameToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.declarationNameTokenIndexes,
            declarationRow)
        if ParserValueExprTokenText(tree, parameterNameToken) ==
               parameterName:
            if matched:
                return false
            ordinalOut = ordinal
            sourceLocalDeclarationRowOut =
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.declarationSourceLocalRows,
                    declarationRow)
            matched = true
        ordinal = ordinal + 1
    return matched

fn ParserNormalizedFfiHandleContractTableReset(
        table: var NormalizedFfiHandleContractTable) =
    setLen(table.functionDeclarationRows, 0)
    setLen(table.annotationRows, 0)
    setLen(table.unwindKinds, 0)
    setLen(table.resultEffects, 0)
    setLen(table.parameterStarts, 0)
    setLen(table.parameterCounts, 0)
    setLen(table.identityDigests, 0)
    setLen(table.parameterOrdinals, 0)
    setLen(table.parameterSourceLocalDeclarationRows, 0)
    setLen(table.parameterEffects, 0)

fn ParserNormalizedFfiHandleEffectFromIdentifier(
        text: str): NormalizedFfiHandleEffect =
    if text == "produce":
        return NormalizedFfiHandleEffectProduce
    if text == "borrow":
        return NormalizedFfiHandleEffectBorrow
    if text == "consume":
        return NormalizedFfiHandleEffectConsume
    return NormalizedFfiHandleEffectInvalid

fn ParserNormalizedFfiHandleUnwindFromIdentifier(
        text: str): NormalizedFfiHandleUnwind =
    if text == "no_unwind":
        return NormalizedFfiHandleUnwindNoUnwind
    return NormalizedFfiHandleUnwindInvalid

@borrows
fn ParserNormalizedFunctionParameterAtOrdinalInto(
        tree: ParserValueExprTree,
        functionDeclarationRow: int32,
        requiredOrdinal: int32,
        sourceLocalDeclarationRowOut: var int32): bool =
    sourceLocalDeclarationRowOut = -1
    if requiredOrdinal < 0 ||
       !ParserNormalizedFunctionDeclarationRowTopLevel(
           tree, functionDeclarationRow):
        return false
    let functionProducer = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.declarationProducerSourceIndexes,
        functionDeclarationRow)
    var ordinal: int32
    for declarationRow in 0..<tree.declarationCount:
        if ParserDeclarationKind(arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationKinds,
               declarationRow)) != ParserDeclarationParameter ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationOwnerRows,
               declarationRow) != functionDeclarationRow:
            continue
        if arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationProducerSourceIndexes,
               declarationRow) != functionProducer:
            return false
        if ordinal == requiredOrdinal:
            sourceLocalDeclarationRowOut =
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.declarationSourceLocalRows,
                    declarationRow)
            return sourceLocalDeclarationRowOut >= 0
        ordinal = ordinal + 1
    return false

fn ParserNormalizedFfiHandleDigestStep(
        digestRaw: int64,
        value: int32): int64 =
    return (digestRaw * 16777619 + Int64(value) + 1) % 2147483647

@borrows
fn ParserNormalizedFfiHandleContractIdentityDigest(
        functionDeclarationRow: int32,
        annotationRow: int32,
        unwindKind: int32,
        resultEffect: int32,
        parameterOrdinals: int32[],
        parameterDeclarationRows: int32[],
        parameterEffects: int32[]): int64 =
    if functionDeclarationRow < 0 || annotationRow < 0 ||
       parameterOrdinals.len != parameterDeclarationRows.len ||
       parameterOrdinals.len != parameterEffects.len:
        return 0
    var digest: int64 = 2166136261
    digest = ParserNormalizedFfiHandleDigestStep(digest, 0x46464948)
    digest = ParserNormalizedFfiHandleDigestStep(
        digest, functionDeclarationRow)
    digest = ParserNormalizedFfiHandleDigestStep(digest, annotationRow)
    digest = ParserNormalizedFfiHandleDigestStep(digest, unwindKind)
    digest = ParserNormalizedFfiHandleDigestStep(digest, resultEffect)
    digest = ParserNormalizedFfiHandleDigestStep(
        digest, parameterOrdinals.len)
    for index in 0..<parameterOrdinals.len:
        digest = ParserNormalizedFfiHandleDigestStep(
            digest, parameterOrdinals[index])
        digest = ParserNormalizedFfiHandleDigestStep(
            digest, parameterDeclarationRows[index])
        digest = ParserNormalizedFfiHandleDigestStep(
            digest, parameterEffects[index])
    return digest

@borrows
fn ParserNormalizedFfiHandleContractAppendInto(
        tree: ParserValueExprTree,
        annotationRow: int32,
        functionDeclarationRow: int32,
        importc: bool,
        table: var NormalizedFfiHandleContractTable,
        err: var str): bool =
    if !importc ||
       !ParserNormalizedFunctionDeclarationRowTopLevel(
           tree, functionDeclarationRow):
        err = "parser annotation: @ffi_handle requires importc"
        return false
    let functionProducer = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.declarationProducerSourceIndexes,
        functionDeclarationRow)
    let annotationProducer = arenamod.ArenaArrayInt32Get(
        tree.arena,
        tree.annotationProducerSourceIndexes,
        annotationRow)
    if functionProducer != annotationProducer ||
       functionDeclarationRow < 0 || annotationRow < 0:
        err = "parser annotation: @ffi_handle owner identity invalid"
        return false
    for row in 0..<table.functionDeclarationRows.len:
        if table.functionDeclarationRows[row] == functionDeclarationRow:
            err = "parser annotation: duplicate @ffi_handle"
            return false
    let rootCount = ParserNormalizedAnnotationRootCountAt(
        tree, annotationRow)
    if rootCount <= 0:
        err = "parser annotation: @ffi_handle requires unwind=no_unwind"
        return false
    var unwindKind: int32
    var resultEffect: int32
    var parameterOrdinals: int32[]
    var parameterDeclarationRows: int32[]
    var parameterEffects: int32[]
    for rootOffset in 0..<rootCount:
        let root = ParserNormalizedAnnotationRootAt(
            tree, annotationRow, rootOffset)
        var key: str
        var valueRow: int32
        var value: str
        if !ParserNormalizedAnnotationKeyValueInto(
               tree, root, key, valueRow) ||
           !ParserNormalizedAnnotationIdentifierInto(
               tree, valueRow, value):
            err = "parser annotation: invalid @ffi_handle role"
            return false
        if key == "unwind":
            let unwind =
                ParserNormalizedFfiHandleUnwindFromIdentifier(value)
            if unwindKind != 0 ||
               unwind != NormalizedFfiHandleUnwindNoUnwind:
                err = "parser annotation: invalid @ffi_handle unwind"
                return false
            unwindKind = Int32(unwind)
            continue
        let effect = ParserNormalizedFfiHandleEffectFromIdentifier(value)
        if key == "result":
            if resultEffect != 0 ||
               effect != NormalizedFfiHandleEffectProduce:
                err = "parser annotation: invalid @ffi_handle result"
                return false
            resultEffect = Int32(effect)
            continue
        let parameterOrdinal = ParserArgIndexFromName(key)
        if parameterOrdinal < 0 ||
           parameterOrdinal >= tree.declarationCount ||
           (effect != NormalizedFfiHandleEffectBorrow &&
            effect != NormalizedFfiHandleEffectConsume):
            err = "parser annotation: invalid @ffi_handle parameter role"
            return false
        var parameterDeclarationRow: int32
        if !ParserNormalizedFunctionParameterAtOrdinalInto(
               tree,
               functionDeclarationRow,
               parameterOrdinal,
               parameterDeclarationRow):
            err = "parser annotation: @ffi_handle parameter row missing"
            return false
        for parameterIndex in 0..<parameterOrdinals.len:
            if parameterOrdinals[parameterIndex] == parameterOrdinal:
                err = "parser annotation: duplicate @ffi_handle parameter"
                return false
        add(parameterOrdinals, parameterOrdinal)
        add(parameterDeclarationRows, parameterDeclarationRow)
        add(parameterEffects, Int32(effect))
    if unwindKind != Int32(NormalizedFfiHandleUnwindNoUnwind):
        err = "parser annotation: @ffi_handle requires unwind=no_unwind"
        return false
    for index in 1..<parameterOrdinals.len:
        var cursor = index
        while cursor > 0 &&
              parameterOrdinals[cursor] < parameterOrdinals[cursor - 1]:
            let ordinal = parameterOrdinals[cursor - 1]
            parameterOrdinals[cursor - 1] = parameterOrdinals[cursor]
            parameterOrdinals[cursor] = ordinal
            let declarationRow = parameterDeclarationRows[cursor - 1]
            parameterDeclarationRows[cursor - 1] =
                parameterDeclarationRows[cursor]
            parameterDeclarationRows[cursor] = declarationRow
            let parameterEffect = parameterEffects[cursor - 1]
            parameterEffects[cursor - 1] = parameterEffects[cursor]
            parameterEffects[cursor] = parameterEffect
            cursor = cursor - 1
    let digest = ParserNormalizedFfiHandleContractIdentityDigest(
        functionDeclarationRow,
        annotationRow,
        unwindKind,
        resultEffect,
        parameterOrdinals,
        parameterDeclarationRows,
        parameterEffects)
    if digest == 0:
        err = "parser annotation: @ffi_handle identity invalid"
        return false
    add(table.functionDeclarationRows, functionDeclarationRow)
    add(table.annotationRows, annotationRow)
    add(table.unwindKinds, unwindKind)
    add(table.resultEffects, resultEffect)
    add(table.parameterStarts, table.parameterOrdinals.len)
    add(table.parameterCounts, parameterOrdinals.len)
    add(table.identityDigests, digest)
    for index in 0..<parameterOrdinals.len:
        add(table.parameterOrdinals, parameterOrdinals[index])
        add(table.parameterSourceLocalDeclarationRows,
            parameterDeclarationRows[index])
        add(table.parameterEffects, parameterEffects[index])
    err = ""
    return true

fn ParserNormalizedFfiHandleContractTableCanonicalize(
        table: var NormalizedFfiHandleContractTable) =
    var order: int32[]
    for row in 0..<table.functionDeclarationRows.len:
        add(order, row)
    for index in 1..<order.len:
        var cursor = index
        while cursor > 0 &&
              table.functionDeclarationRows[order[cursor]] <
                  table.functionDeclarationRows[order[cursor - 1]]:
            let prior = order[cursor - 1]
            order[cursor - 1] = order[cursor]
            order[cursor] = prior
            cursor = cursor - 1
    var canonical: NormalizedFfiHandleContractTable
    for orderIndex in 0..<order.len:
        let row = order[orderIndex]
        let parameterStart = table.parameterStarts[row]
        let parameterCount = table.parameterCounts[row]
        add(canonical.functionDeclarationRows,
            table.functionDeclarationRows[row])
        add(canonical.annotationRows, table.annotationRows[row])
        add(canonical.unwindKinds, table.unwindKinds[row])
        add(canonical.resultEffects, table.resultEffects[row])
        add(canonical.parameterStarts, canonical.parameterOrdinals.len)
        add(canonical.parameterCounts, parameterCount)
        add(canonical.identityDigests, table.identityDigests[row])
        for parameterOffset in 0..<parameterCount:
            let parameterRow = parameterStart + parameterOffset
            add(canonical.parameterOrdinals,
                table.parameterOrdinals[parameterRow])
            add(canonical.parameterSourceLocalDeclarationRows,
                table.parameterSourceLocalDeclarationRows[parameterRow])
            add(canonical.parameterEffects,
                table.parameterEffects[parameterRow])
    table = canonical

@borrows
fn ParserNormalizedFfiHandleContractTableStrictValid(
        table: NormalizedFfiHandleContractTable): bool =
    let contractCount = table.functionDeclarationRows.len
    if table.annotationRows.len != contractCount ||
       table.unwindKinds.len != contractCount ||
       table.resultEffects.len != contractCount ||
       table.parameterStarts.len != contractCount ||
       table.parameterCounts.len != contractCount ||
       table.identityDigests.len != contractCount ||
       table.parameterSourceLocalDeclarationRows.len !=
           table.parameterOrdinals.len ||
       table.parameterEffects.len != table.parameterOrdinals.len:
        return false
    var parameterCursor: int32
    for row in 0..<contractCount:
        if table.functionDeclarationRows[row] < 0 ||
           table.annotationRows[row] < 0 ||
           table.unwindKinds[row] != Int32(NormalizedFfiHandleUnwindNoUnwind) ||
           (row > 0 && table.functionDeclarationRows[row - 1] >=
                       table.functionDeclarationRows[row]) ||
           table.parameterStarts[row] != parameterCursor ||
           table.parameterCounts[row] < 0:
            return false
        let resultEffect = table.resultEffects[row]
        if resultEffect != Int32(NormalizedFfiHandleEffectInvalid) &&
           resultEffect != Int32(NormalizedFfiHandleEffectProduce):
            return false
        var ordinals: int32[]
        var declarationRows: int32[]
        var effects: int32[]
        for offset in 0..<table.parameterCounts[row]:
            let parameterRow = parameterCursor + offset
            if parameterRow < 0 ||
               parameterRow >= table.parameterOrdinals.len:
                return false
            let ordinal = table.parameterOrdinals[parameterRow]
            let declarationRow =
                table.parameterSourceLocalDeclarationRows[parameterRow]
            let effect = table.parameterEffects[parameterRow]
            if ordinal < 0 || declarationRow < 0 ||
               (offset > 0 &&
                table.parameterOrdinals[parameterRow - 1] >= ordinal) ||
               (effect != Int32(NormalizedFfiHandleEffectBorrow) &&
                effect != Int32(NormalizedFfiHandleEffectConsume)):
                return false
            add(ordinals, ordinal)
            add(declarationRows, declarationRow)
            add(effects, effect)
        if resultEffect == Int32(NormalizedFfiHandleEffectInvalid) &&
           table.parameterCounts[row] == 0:
            return false
        if table.identityDigests[row] !=
           ParserNormalizedFfiHandleContractIdentityDigest(
               table.functionDeclarationRows[row],
               table.annotationRows[row],
               table.unwindKinds[row],
               resultEffect,
               ordinals,
               declarationRows,
               effects):
            return false
        parameterCursor = parameterCursor + table.parameterCounts[row]
    return parameterCursor == table.parameterOrdinals.len

@borrows
fn ParserBuildNormalizedFfiHandleContractsInto(
        tree: ParserValueExprTree,
        decls: NormalizedFunctionDecl[],
        table: var NormalizedFfiHandleContractTable,
        err: var str): bool =
    ParserNormalizedFfiHandleContractTableReset(table)
    if tree == nil:
        err = "parser annotation: @ffi_handle tree missing"
        return false
    for annotationRow in 0..<tree.annotationCount:
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.annotationNameTokenIndexes,
            annotationRow)
        if !ParserValueExprTokenTextEqualsText(tree, nameToken,
                                               "ffi_handle"):
            continue
        let declIndex = ParserNormalizedFunctionAnnotationTargetDeclExact(
            tree, annotationRow, decls)
        let functionDeclarationRow =
            ParserNormalizedFunctionAnnotationTargetDeclarationRow(
                tree, annotationRow)
        if declIndex < 0 ||
           declIndex >= decls.len ||
           !ParserNormalizedFfiHandleContractAppendInto(
               tree,
               annotationRow,
               functionDeclarationRow,
               decls[declIndex].importc,
               table,
               err):
            ParserNormalizedFfiHandleContractTableReset(table)
            if err == "":
                err = "parser annotation: @ffi_handle build failed"
            return false
    ParserNormalizedFfiHandleContractTableCanonicalize(table)
    if !ParserNormalizedFfiHandleContractTableStrictValid(table):
        ParserNormalizedFfiHandleContractTableReset(table)
        err = "parser annotation: @ffi_handle table invalid"
        return false
    err = ""
    return true

@borrows
fn ParserNormalizedAnnotationManualConsumeInto(
        tree: ParserValueExprTree,
        annotationRow: int32,
        functionDeclarationRow: int32,
        targetOrdinalOut: var int32,
        targetDeclarationRowOut: var int32,
        sourceOrdinalOut: var int32,
        sourceDeclarationRowOut: var int32): bool =
    targetOrdinalOut = -1
    targetDeclarationRowOut = -1
    sourceOrdinalOut = -1
    sourceDeclarationRowOut = -1
    if ParserNormalizedAnnotationRootCountAt(
           tree, annotationRow) != 2:
        return false
    let targetRoot = ParserNormalizedAnnotationRootAt(
        tree, annotationRow, 0)
    let sourceRoot = ParserNormalizedAnnotationRootAt(
        tree, annotationRow, 1)
    var targetKey: str
    var targetValueRow: int32
    var sourceKey: str
    var sourceValueRow: int32
    var targetName: str
    var sourceName: str
    if !ParserNormalizedAnnotationKeyValueInto(
           tree,
           targetRoot,
           targetKey,
           targetValueRow) ||
       targetKey != "target" ||
       !ParserNormalizedAnnotationIdentifierInto(
           tree, targetValueRow, targetName) ||
       !ParserNormalizedAnnotationKeyValueInto(
           tree,
           sourceRoot,
           sourceKey,
           sourceValueRow) ||
       sourceKey != "source" ||
       !ParserNormalizedAnnotationIdentifierInto(
           tree, sourceValueRow, sourceName) ||
       targetName == sourceName:
        return false
    if !ParserNormalizedFunctionParameterIdentityInto(
           tree,
           functionDeclarationRow,
           targetName,
           targetOrdinalOut,
           targetDeclarationRowOut) ||
       !ParserNormalizedFunctionParameterIdentityInto(
           tree,
           functionDeclarationRow,
           sourceName,
           sourceOrdinalOut,
           sourceDeclarationRowOut):
        return false
    return targetOrdinalOut != sourceOrdinalOut &&
           targetDeclarationRowOut != sourceDeclarationRowOut

@borrows
fn ParserNormalizedFunctionDeclClone(
        src: NormalizedFunctionDecl): NormalizedFunctionDecl =
    var out: NormalizedFunctionDecl
    out.name = strings.CloneStr(src.name)
    out.lineIndex = src.lineIndex
    out.signatureStartColumn = src.signatureStartColumn
    out.signatureEndLineIndex = src.signatureEndLineIndex
    out.signatureEndColumn = src.signatureEndColumn
    out.nameStartColumn = src.nameStartColumn
    out.nameEndColumn = src.nameEndColumn
    out.bodyStartLineIndex = src.bodyStartLineIndex
    out.bodyStartColumn = src.bodyStartColumn
    out.importc = src.importc
    out.importcAnnotationBound = src.importcAnnotationBound
    out.explicitExportName = strings.CloneStr(src.explicitExportName)
    out.surfaceKeyword = strings.CloneStr(src.surfaceKeyword)
    out.ffiMapPtrArg = src.ffiMapPtrArg
    out.ffiMapLenArg = src.ffiMapLenArg
    out.ffiOutPtrArgs = strings.CloneStr(src.ffiOutPtrArgs)
    out.abiInternal = src.abiInternal
    out.ffiOwnedResultPresent = src.ffiOwnedResultPresent
    out.ffiOwnedResultFree = strings.CloneStr(src.ffiOwnedResultFree)
    out.borrowResult = src.borrowResult
    out.threadBoundary = src.threadBoundary
    out.borrows = src.borrows
    out.escapes = src.escapes
    out.weak = src.weak
    out.trustedAbi = src.trustedAbi
    out.noAlloc = src.noAlloc
    out.interruptHandler = src.interruptHandler
    out.keepExportBinding = src.keepExportBinding
    out.manualConsumePresent = src.manualConsumePresent
    out.manualConsumeFunctionDeclarationRow =
        src.manualConsumeFunctionDeclarationRow
    out.manualConsumeTargetParameterOrdinal =
        src.manualConsumeTargetParameterOrdinal
    out.manualConsumeTargetParameterDeclarationRow =
        src.manualConsumeTargetParameterDeclarationRow
    out.manualConsumeSourceParameterOrdinal =
        src.manualConsumeSourceParameterOrdinal
    out.manualConsumeSourceParameterDeclarationRow =
        src.manualConsumeSourceParameterDeclarationRow
    out.manualConsumeIdentityDigest = src.manualConsumeIdentityDigest
    return out

@borrows
fn ParserApplySimpleFunctionAnnotationsLinewiseInto(
        lines: str[],
        decls: var NormalizedFunctionDecl[],
        handled: var bool,
        err: var str): bool =
    # [MEM-EXACT] @borrows/@borrow_result 无参函数注解的行级快路径: 大源
    # (primary_object_plan 886 / typed_expr 1184 / compiler_csg 530 条) 不再
    # 为应用注解建整棵 ParserValueExprTree (该树 arena 是 profiles 相
    # VM_ALLOCATE ~500MB 瞬态的主源). 任何其他注解/带参/行内形态一律
    # handled=false 回退全量树, 语义与 ParserApplyNormalizedFunctionAnnotationsInto
    # 对齐.
    handled = true
    var borrowsFlags: bool[]
    var borrowResultFlags: bool[]
    setLen(borrowsFlags, decls.len)
    setLen(borrowResultFlags, decls.len)
    for flagIndex in 0..<decls.len:
        borrowsFlags[flagIndex] = false
        borrowResultFlags[flagIndex] = false
    var pendingBorrows: bool
    var pendingBorrowResult: bool
    var pendingAny: bool
    var declCursor: int32
    var lineIndex: int32
    while lineIndex < lines.len:
        let lineRaw = lines[lineIndex]
        var lineStart: int32
        var lineStop: int32
        if ParserTrimmedLineRange(lineRaw, lineStart, lineStop):
            if lineStart < lineStop && !ParserHasLeadingIndent(lineRaw):
                if lineRaw[lineStart] == '#':
                    lineIndex = lineIndex + 1
                    continue
                if lineRaw[lineStart] == '@':
                    var nameStart = lineStart + 1
                    while nameStart < lineStop &&
                          (lineRaw[nameStart] == ' ' || lineRaw[nameStart] == '\t'):
                        nameStart = nameStart + 1
                    var nameStop = nameStart
                    while nameStop < lineStop && ParserIsIdentChar(lineRaw[nameStop]):
                        nameStop = nameStop + 1
                    let name = ParserTextSliceFast(lineRaw,
                                                   nameStart,
                                                   nameStop - nameStart)
                    var rest = nameStop
                    while rest < lineStop &&
                          (lineRaw[rest] == ' ' || lineRaw[rest] == '\t'):
                        rest = rest + 1
                    var noArgs = rest >= lineStop
                    if !noArgs && lineRaw[rest] == '#':
                        noArgs = true
                    if !noArgs && rest + 1 < lineStop &&
                       lineRaw[rest] == '/' && lineRaw[rest + 1] == '/':
                        noArgs = true
                    if !noArgs:
                        handled = false
                        return true
                    if name == "borrows":
                        pendingBorrows = true
                        pendingAny = true
                    elif name == "borrow_result":
                        pendingBorrowResult = true
                        pendingAny = true
                    else:
                        handled = false
                        return true
                    lineIndex = lineIndex + 1
                    continue
                # top-level non-annotation line: it must be the pending
                # annotation target function, otherwise fall back.
                if declCursor < decls.len &&
                   decls[declCursor].lineIndex == lineIndex + 1:
                    if pendingAny:
                        if pendingBorrows:
                            if decls[declCursor].escapes ||
                               decls[declCursor].manualConsumePresent:
                                handled = false
                                return true
                            borrowsFlags[declCursor] = true
                        if pendingBorrowResult:
                            borrowResultFlags[declCursor] = true
                        pendingBorrows = false
                        pendingBorrowResult = false
                        pendingAny = false
                    declCursor = declCursor + 1
                elif pendingAny:
                    handled = false
                    return true
        lineIndex = lineIndex + 1
    if pendingAny:
        handled = false
        return true
    for applyIndex in 0..<decls.len:
        if borrowsFlags[applyIndex]:
            decls[applyIndex].borrows = true
        if borrowResultFlags[applyIndex]:
            decls[applyIndex].borrowResult = true
    err = ""
    return true

fn ParserApplyNormalizedFunctionAnnotationsInto(
        text: str,
        migrationSourceSyntax: bool,
        decls: var NormalizedFunctionDecl[],
        err: var str): bool =
    var tree: ParserValueExprTree
    var noColumnCensus: int32[]
    if !parserValueExprReadTreeFromTextMode(
           text, migrationSourceSyntax, 0, noColumnCensus, tree, err):
        ParserValueExprTreeRelease(tree)
        return false
    for annotationRow in 0..<tree.annotationCount:
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.annotationNameTokenIndexes,
            annotationRow)
        let name = ParserValueExprTokenText(tree, nameToken)
        if !ParserNormalizedAnnotationRegisteredName(name):
            ParserValueExprTreeRelease(tree)
            err = ParserConcat3(
                "parser annotation: unregistered @",
                name,
                "")
            return false
        if !ParserNormalizedAnnotationKnownFunctionName(name):
            continue
        var declIndex: int32
        if name == "manual_consume" || name == "ffi_handle":
            declIndex =
                ParserNormalizedFunctionAnnotationTargetDeclExact(
                    tree, annotationRow, decls)
        else:
            declIndex = ParserNormalizedFunctionAnnotationTargetDecl(
                tree, annotationRow, decls)
        if declIndex < 0:
            ParserValueExprTreeRelease(tree)
            err = ParserConcat3(
                "parser annotation: function target missing for @",
                name,
                "")
            return false
        if name == "ffi_handle":
            # The unique read-only contract builder runs after every function
            # annotation has been applied, so source order cannot change ABI
            # eligibility or contract identity.  Must skip BEFORE the decl
            # copy below: `var decl = decls[declIndex]` moves the managed
            # struct out of the array element, and a continue without the
            # write-back leaves the slot's managed fields dropped (V1 实证
            # decls[0] 被掏空 → @ffi_handle requires importc 误判)。
            continue
        var decl = ParserNormalizedFunctionDeclClone(decls[declIndex])
        if name == "compiler_top_level":
            var value: str
            if decl.explicitExportName != "" ||
               !ParserNormalizedAnnotationExactKeyStringInto(
                   tree,
                   annotationRow,
                   "export_name",
                   value):
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: invalid @compiler_top_level"
                return false
            decl.explicitExportName = value
        elif name == "exportc" || name == "exported":
            var value: str
            if decl.explicitExportName != "" ||
               !ParserNormalizedAnnotationExactStringRootInto(
                   tree, annotationRow, value):
                ParserValueExprTreeRelease(tree)
                err = ParserConcat3(
                    "parser annotation: invalid @", name, "")
                return false
            decl.explicitExportName = value
        elif name == "importc":
            var value: str
            if !decl.importcAnnotationBound ||
               decl.surfaceKeyword == "importc fn" ||
               !ParserNormalizedAnnotationExactStringRootInto(
                   tree, annotationRow, value) ||
               value == "":
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: invalid @importc"
                return false
            decl.importc = true
        elif name == "ffi_map":
            if decl.ffiMapPtrArg >= 0 || decl.ffiMapLenArg >= 0 ||
               !ParserNormalizedAnnotationFfiMapInto(
                   tree,
                   annotationRow,
                   decl.ffiMapPtrArg,
                   decl.ffiMapLenArg):
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: invalid @ffi_map"
                return false
        elif name == "ffi_out_ptrs":
            if decl.ffiOutPtrArgs != "" ||
               !ParserNormalizedAnnotationFfiOutPtrsInto(
                   tree, annotationRow, decl.ffiOutPtrArgs):
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: invalid @ffi_out_ptrs"
                return false
        elif name == "abi_internal":
            if decl.abiInternal ||
               ParserNormalizedAnnotationRootCountAt(
                   tree, annotationRow) != 0:
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: invalid @abi_internal"
                return false
            decl.abiInternal = true
        elif name == "ffi_owned_result":
            if decl.ffiOwnedResultPresent ||
               !ParserNormalizedAnnotationExactKeyIdentifierInto(
                   tree,
                   annotationRow,
                   "free",
                   decl.ffiOwnedResultFree):
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: invalid @ffi_owned_result"
                return false
            decl.ffiOwnedResultPresent = true
        elif name == "borrow_result":
            if decl.borrowResult ||
               ParserNormalizedAnnotationRootCountAt(
                   tree, annotationRow) != 0:
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: invalid @borrow_result"
                return false
            if decl.importc:
                ParserValueExprTreeRelease(tree)
                err = "@borrow_result is only valid on Cheng function declarations"
                return false
            decl.borrowResult = true
        elif name == "thread_boundary":
            if decl.threadBoundary ||
               ParserNormalizedAnnotationRootCountAt(
                   tree, annotationRow) != 0:
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: invalid @thread_boundary"
                return false
            decl.threadBoundary = true
        elif name == "borrows":
            if decl.borrows || decl.escapes ||
               decl.manualConsumePresent ||
               ParserNormalizedAnnotationRootCountAt(
                   tree, annotationRow) != 0:
                var reason: str
                if decl.borrows:
                    reason = "duplicate @borrows on this declaration"
                elif decl.escapes:
                    reason = "@borrows conflicts with @escapes"
                elif decl.manualConsumePresent:
                    reason = "@borrows conflicts with @manual_consume"
                else:
                    reason = "@borrows takes no arguments"
                ParserValueExprTreeRelease(tree)
                err = Fmt"parser annotation: invalid @borrows on fn {decl.name} at line {decl.lineIndex}: {reason}"
                return false
            decl.borrows = true
        elif name == "escapes":
            if decl.escapes || decl.borrows ||
               ParserNormalizedAnnotationRootCountAt(
                   tree, annotationRow) != 0:
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: invalid @escapes"
                return false
            decl.escapes = true
        elif name == "weak":
            if decl.weak ||
               ParserNormalizedAnnotationRootCountAt(
                   tree, annotationRow) != 0:
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: invalid @weak"
                return false
            decl.weak = true
        elif name == "trusted_abi":
            if decl.trustedAbi ||
               ParserNormalizedAnnotationRootCountAt(
                   tree, annotationRow) != 0:
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: invalid @trusted_abi"
                return false
            decl.trustedAbi = true
        elif name == "no_alloc":
            if decl.noAlloc ||
               ParserNormalizedAnnotationRootCountAt(
                   tree, annotationRow) != 0:
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: invalid @no_alloc"
                return false
            decl.noAlloc = true
        elif name == "interrupt_handler":
            if decl.interruptHandler ||
               ParserNormalizedAnnotationRootCountAt(
                   tree, annotationRow) != 0:
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: invalid @interrupt_handler"
                return false
            decl.interruptHandler = true
        elif name == "keep_export_binding":
            if decl.keepExportBinding ||
               ParserNormalizedAnnotationRootCountAt(
                   tree, annotationRow) != 0:
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: invalid @keep_export_binding"
                return false
            decl.keepExportBinding = true
        elif name == "manual_consume":
            let functionDeclarationRow =
                ParserNormalizedFunctionAnnotationTargetDeclarationRow(
                    tree, annotationRow)
            var targetOrdinal: int32
            var targetDeclarationRow: int32
            var sourceOrdinal: int32
            var sourceDeclarationRow: int32
            if decl.manualConsumePresent || decl.borrows ||
               !ParserNormalizedFunctionDeclarationRowTopLevel(
                   tree, functionDeclarationRow) ||
               !ParserNormalizedAnnotationManualConsumeInto(
                   tree,
                   annotationRow,
                   functionDeclarationRow,
                   targetOrdinal,
                   targetDeclarationRow,
                   sourceOrdinal,
                   sourceDeclarationRow):
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: invalid @manual_consume"
                return false
            decl.manualConsumePresent = true
            decl.manualConsumeFunctionDeclarationRow =
                arenamod.ArenaArrayInt32Get(
                    tree.arena,
                    tree.declarationSourceLocalRows,
                    functionDeclarationRow)
            decl.manualConsumeTargetParameterOrdinal = targetOrdinal
            decl.manualConsumeTargetParameterDeclarationRow =
                targetDeclarationRow
            decl.manualConsumeSourceParameterOrdinal = sourceOrdinal
            decl.manualConsumeSourceParameterDeclarationRow =
                sourceDeclarationRow
            decl.manualConsumeIdentityDigest =
                ParserNormalizedFunctionManualConsumeIdentityDigest(
                    decl.manualConsumeFunctionDeclarationRow,
                    targetOrdinal,
                    targetDeclarationRow,
                    sourceOrdinal,
                    sourceDeclarationRow)
            if !ParserNormalizedFunctionManualConsumeIdentityValid(decl):
                ParserValueExprTreeRelease(tree)
                err = "parser annotation: @manual_consume identity invalid"
                return false
        decls[declIndex] = decl
    var ffiHandleContracts: NormalizedFfiHandleContractTable
    if !ParserBuildNormalizedFfiHandleContractsInto(
           tree, decls, ffiHandleContracts, err):
        ParserValueExprTreeRelease(tree)
        return false
    ParserValueExprTreeRelease(tree)
    err = ""
    return true

@borrows
fn ParserSourceTextFromLines(lines: str[]): str =
    var out = buffer.NewByteBuffer()
    for lineIndex in 0..<lines.len:
        if lineIndex > 0:
            buffer.AppendText(out, "\n")
        buffer.AppendText(out, lines[lineIndex])
    return rawbytes.BytesToString(buffer.ToBytes(out))

@borrows
fn ParserTopLevelFunctionPrefixLenKeywordExact(line: str,
                                                 keyword: var str): int32 =
    if ParserStartsWithExact(line, "importc fn "):
        keyword = "fn"
        return Len("importc fn ")
    if ParserStartsWithExact(line, "fn "):
        keyword = "fn"
        return Len("fn ")
    if ParserStartsWithExact(line, "func "):
        keyword = "func"
        return Len("func ")
    if ParserStartsWithExact(line, "proc "):
        keyword = "proc"
        return Len("proc ")
    if ParserStartsWithExact(line, "method "):
        keyword = "method"
        return Len("method ")
    if ParserStartsWithExact(line, "converter "):
        keyword = "converter"
        return Len("converter ")
    keyword = ""
    return 0

fn ParserTopLevelFunctionPrefixLenKeywordRange(lineRaw: str,
                                                 lineStart: int32,
                                                 lineStop: int32,
                                                 keyword: var str): int32 =
    if lineStart + Len("importc fn ") <= lineStop &&
       ParserTextRangeEquals(lineRaw, lineStart, Len("importc fn "), "importc fn "):
        keyword = "fn"
        return Len("importc fn ")
    if lineStart + Len("fn ") <= lineStop &&
       ParserTextRangeEquals(lineRaw, lineStart, Len("fn "), "fn "):
        keyword = "fn"
        return Len("fn ")
    if lineStart + Len("func ") <= lineStop &&
       ParserTextRangeEquals(lineRaw, lineStart, Len("func "), "func "):
        keyword = "func"
        return Len("func ")
    if lineStart + Len("proc ") <= lineStop &&
       ParserTextRangeEquals(lineRaw, lineStart, Len("proc "), "proc "):
        keyword = "proc"
        return Len("proc ")
    if lineStart + Len("method ") <= lineStop &&
       ParserTextRangeEquals(lineRaw, lineStart, Len("method "), "method "):
        keyword = "method"
        return Len("method ")
    if lineStart + Len("converter ") <= lineStop &&
       ParserTextRangeEquals(lineRaw, lineStart, Len("converter "), "converter "):
        keyword = "converter"
        return Len("converter ")
    keyword = ""
    return 0

@borrows
fn ParserTopLevelFunctionKeywordExact(line: str): str =
    var keyword: str
    let prefixLen = ParserTopLevelFunctionPrefixLenKeywordExact(line, keyword)
    if prefixLen < 0:
        return ""
    return keyword

fn ParserTopLevelFunctionKeyword(lineRaw: str): str =
    if ParserHasLeadingIndent(lineRaw):
        return ""
    let line = chengpath.PathTrim(lineRaw)
    return ParserTopLevelFunctionKeywordExact(line)

@borrows
fn ParserFunctionNameFromTrimmedLineWithPrefix(line: str,
                                                 prefixLen: int32): str =
    if prefixLen <= 0:
        return ""
    if prefixLen >= line.len:
        return ""
    var start = prefixLen
    while start < line.len:
        if !ParserIsInlineSpace(line[start]):
            break
        start = start + 1
    if start >= line.len:
        return ""
    var stop = start
    while stop < line.len:
        if !ParserIsIdentChar(line[stop]):
            break
        stop = stop + 1
    if stop <= start:
        return ""
    return ParserTextSliceCopy(line, start, stop - start)

@borrows
fn ParserFunctionNameFromTrimmedRangeWithPrefix(lineRaw: str,
                                                  lineStart: int32,
                                                  lineStop: int32,
                                                  prefixLen: int32): str =
    if prefixLen <= 0:
        return ""
    let startBase = lineStart + prefixLen
    if startBase >= lineStop:
        return ""
    var start = startBase
    while start < lineStop:
        let code = Int32(lineRaw[start])
        if code != 32 && code != 9:
            break
        start = start + 1
    if start >= lineStop:
        return ""
    var stop = start
    while stop < lineStop:
        let code = Int32(lineRaw[stop])
        let digit = code >= 48 && code <= 57
        let upper = code >= 65 && code <= 90
        let lower = code >= 97 && code <= 122
        if !(digit || upper || lower || code == 95):
            break
        stop = stop + 1
    if stop <= start:
        return ""
    return ParserTextSliceCopy(lineRaw, start, stop - start)

fn ParserFunctionNameFromTrimmedRangeWithPrefixInto(lineRaw: str,
                                                     lineStart: int32,
                                                     lineStop: int32,
                                                     prefixLen: int32,
                                                     out: var str): bool =
    out = ""
    if prefixLen <= 0:
        return false
    let startBase = lineStart + prefixLen
    if startBase >= lineStop:
        return false
    var start = startBase
    while start < lineStop:
        let code = Int32(lineRaw[start])
        if code != 32 && code != 9:
            break
        start = start + 1
    if start >= lineStop:
        return false
    let name = ParserIdentPrefix(ParserTextSliceFast(lineRaw,
                                                     start,
                                                     lineStop - start))
    if name == "":
        return false
    out = name
    return out.len > 0

fn ParserFunctionNameFromTrimmedLine(line: str): str =
    var keyword: str
    let prefixLen = ParserTopLevelFunctionPrefixLenKeywordExact(line, keyword)
    return ParserFunctionNameFromTrimmedLineWithPrefix(line, prefixLen)

fn ParserFunctionNameFromLine(lineRaw: str): str =
    if ParserHasLeadingIndent(lineRaw):
        return ""
    let line = chengpath.PathTrim(lineRaw)
    return ParserFunctionNameFromTrimmedLine(line)

@borrows
fn ParserFunctionSignatureDelimiterLinesInto(
        lines: str[],
        firstLineIndex: int32,
        firstColumn: int32,
        delimiterLineIndex: var int32,
        delimiterColumn: var int32): bool =
    var parenDepth: int32
    var bracketDepth: int32
    var braceDepth: int32
    for lineIndex in firstLineIndex..<lines.len:
        let lineRaw = lines[lineIndex]
        var lineStart: int32
        var lineStop: int32
        if !ParserTrimmedCommentRangeSlashAware(lineRaw,
                                                 lineStart,
                                                 lineStop):
            continue
        var cursor = lineIndex == firstLineIndex ? firstColumn : lineStart
        var inString = false
        var inChar = false
        while cursor < lineStop:
            let ch = lineRaw[cursor]
            if !inChar && ch == '"' &&
               !ParserQuoteIsEscaped(lineRaw, cursor):
                inString = !inString
                cursor = cursor + 1
                continue
            if !inString && ch == '\'' &&
               !ParserQuoteIsEscaped(lineRaw, cursor):
                inChar = !inChar
                cursor = cursor + 1
                continue
            if inString || inChar:
                cursor = cursor + 1
                continue
            if ch == '(':
                parenDepth = parenDepth + 1
            elif ch == ')':
                parenDepth = parenDepth - 1
            elif ch == '[':
                bracketDepth = bracketDepth + 1
            elif ch == ']':
                bracketDepth = bracketDepth - 1
            elif ch == '{':
                braceDepth = braceDepth + 1
            elif ch == '}':
                braceDepth = braceDepth - 1
            elif ch == '=' && parenDepth == 0 &&
                 bracketDepth == 0 && braceDepth == 0:
                var previous: char
                var next: char
                if cursor > 0:
                    previous = lineRaw[cursor - 1]
                if cursor + 1 < lineStop:
                    next = lineRaw[cursor + 1]
                if previous != '=' && previous != '!' && previous != '<' &&
                   previous != '>' && next != '=' && next != '>':
                    delimiterLineIndex = lineIndex
                    delimiterColumn = cursor
                    return true
            if parenDepth < 0 || bracketDepth < 0 || braceDepth < 0:
                return false
            cursor = cursor + 1
        if inString || inChar:
            return false
    return false

@borrows
fn ParserNormalizedImportcTargetColumnsLinewiseInto(
        lines: str[],
        lineCount: int32,
        targetColumns: var int32[],
        handled: var bool,
        err: var str): bool =
    # [MEM-EXACT] 行级 @importc 目标提取快路径: 只处理“独立单行 @importc(...)
    # 注解 + 其后跳过空白/注释/其他注解后的首行是顶层 fn/importc fn”这一
    # 保守形态; 任何不确定形态置 handled=false, 调用方回退全量树解析。
    # 大源 (typed_expr/primary_object_plan/parser) 全是该形态, 因此不再建整棵
    # ParserValueExprTree.
    targetColumns = []
    setLen(targetColumns, lineCount)
    for lineIndex in 0..<lineCount:
        targetColumns[lineIndex] = -1
    handled = true
    var lineIndex: int32
    while lineIndex < lineCount:
        let lineRaw = lines[lineIndex]
        var lineStart: int32
        var lineStop: int32
        if !ParserTrimmedLineRange(lineRaw, lineStart, lineStop):
            lineIndex = lineIndex + 1
            continue
        if lineStart >= lineStop:
            lineIndex = lineIndex + 1
            continue
        if ParserHasLeadingIndent(lineRaw):
            lineIndex = lineIndex + 1
            continue
        if lineRaw[lineStart] != '@':
            lineIndex = lineIndex + 1
            continue
        var nameStart = lineStart + 1
        while nameStart < lineStop &&
              (lineRaw[nameStart] == ' ' || lineRaw[nameStart] == '\t'):
            nameStart = nameStart + 1
        if !(nameStart + Len("importc") <= lineStop &&
             ParserTextRangeEquals(lineRaw, nameStart, Len("importc"), "importc")):
            lineIndex = lineIndex + 1
            continue
        let afterName = nameStart + Len("importc")
        # 只接受单行良构 @importc(...); 行内出现 fn 或缺少括号即回退.
        var hasOpen = false
        var hasClose = false
        var inlineFn = false
        var scan = afterName
        while scan < lineStop:
            let ch = lineRaw[scan]
            if ch == '(':
                hasOpen = true
            elif ch == ')':
                hasClose = true
            elif scan + Len("fn ") <= lineStop &&
                 ParserTextRangeEquals(lineRaw, scan, Len("fn "), "fn "):
                inlineFn = true
            scan = scan + 1
        if inlineFn || !hasOpen || !hasClose:
            handled = false
            return true
        # 找下一条顶层声明行, 跳过空白/注释/其他注解.
        var declLine = lineIndex + 1
        var targetFound = false
        while declLine < lineCount:
            let declRaw = lines[declLine]
            var declStart: int32
            var declStop: int32
            if !ParserTrimmedLineRange(declRaw, declStart, declStop):
                declLine = declLine + 1
                continue
            if declStart >= declStop:
                declLine = declLine + 1
                continue
            if ParserHasLeadingIndent(declRaw):
                handled = false
                return true
            let first = declRaw[declStart]
            if first == '@':
                declLine = declLine + 1
                continue
            if first == '#' ||
               (declStart + 1 < declStop && first == '/' &&
                (declRaw[declStart + 1] == '/' ||
                 declRaw[declStart + 1] == '*')):
                declLine = declLine + 1
                continue
            if declStart + Len("importc fn ") <= declStop &&
               ParserTextRangeEquals(declRaw, declStart,
                                     Len("importc fn "), "importc fn "):
                targetColumns[declLine] = declStart
                targetFound = true
                break
            if declStart + Len("fn ") <= declStop &&
               ParserTextRangeEquals(declRaw, declStart,
                                     Len("fn "), "fn "):
                targetColumns[declLine] = declStart
                targetFound = true
                break
            # 注解附着到非函数声明或无法证明形态: 回退全量树解析.
            handled = false
            return true
        if !targetFound:
            handled = false
            return true
        lineIndex = declLine + 1
    err = ""
    return true

@borrows
fn ParserNormalizedImportcTargetColumnsInto(
        text: str,
        migrationSourceSyntax: bool,
        lineCount: int32,
        targetColumns: var int32[],
        err: var str): bool =
    targetColumns = []
    setLen(targetColumns, lineCount)
    for lineIndex in 0..<lineCount:
        targetColumns[lineIndex] = -1
    var tree: ParserValueExprTree
    var noColumnCensus: int32[]
    if !parserValueExprReadTreeFromTextMode(
           text, migrationSourceSyntax, 0, noColumnCensus, tree, err):
        ParserValueExprTreeRelease(tree)
        return false
    for annotationRow in 0..<tree.annotationCount:
        let nameToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.annotationNameTokenIndexes,
            annotationRow)
        if !ParserValueExprTokenTextEqualsText(tree, nameToken, "importc"):
            continue
        let targetToken = arenamod.ArenaArrayInt32Get(
            tree.arena,
            tree.annotationTargetTokenIndexes,
            annotationRow)
        if targetToken < 0 || targetToken >= tree.tokenCount:
            ParserValueExprTreeRelease(tree)
            err = "parser annotation: @importc target token missing"
            return false
        let targetLine = ParserValueExprTokenLineAt(tree, targetToken) - 1
        let targetColumn =
            ParserValueExprTokenColumnAt(tree, targetToken) - 1
        if targetLine < 0 || targetLine >= lineCount ||
           targetColumn < 0 || targetColumns[targetLine] >= 0:
            ParserValueExprTreeRelease(tree)
            err = "parser annotation: @importc target coordinate invalid"
            return false
        targetColumns[targetLine] = targetColumn
    ParserValueExprTreeRelease(tree)
    err = ""
    return true

@borrows
fn parserReadFunctionDeclsLinesMode(
        lines: str[],
        migrationSourceSyntax: bool,
        decls: var NormalizedFunctionDecl[],
        err: var str): bool =
    var emptyDecls: NormalizedFunctionDecl[]
    decls = emptyDecls
    let lineCount = lines.len
    var importcTargetColumns: int32[]
    var importcLinewiseHandled: bool
    if !ParserNormalizedImportcTargetColumnsLinewiseInto(
           lines,
           lineCount,
           importcTargetColumns,
           importcLinewiseHandled,
           err):
        return false
    if !importcLinewiseHandled:
        if !ParserNormalizedImportcTargetColumnsInto(
               ParserSourceTextFromLines(lines),
               migrationSourceSyntax,
               lineCount,
               importcTargetColumns,
               err):
            return false
    var outDecls: NormalizedFunctionDecl[]
    var i: int32
    while i < lineCount:
        let lineIndex = i
        i = i + 1
        let lineRaw = lines[lineIndex]
        var lineStart: int32
        var lineStop: int32
        if !ParserTrimmedLineRange(lineRaw, lineStart, lineStop):
            continue
        if ParserHasLeadingIndent(lineRaw):
            continue
        if lineRaw[lineStart] == '@':
            continue
        var prefixLen: int32
        var unsupportedKeyword: str
        if lineStart + Len("importc fn ") <= lineStop &&
           ParserTextRangeEquals(lineRaw, lineStart, Len("importc fn "), "importc fn "):
            prefixLen = Len("importc fn ")
        elif lineStart + Len("fn ") <= lineStop &&
             ParserTextRangeEquals(lineRaw, lineStart, Len("fn "), "fn "):
            prefixLen = Len("fn ")
        elif lineStart + Len("func ") <= lineStop &&
             ParserTextRangeEquals(lineRaw, lineStart, Len("func "), "func "):
            unsupportedKeyword = "func"
        elif migrationSourceSyntax &&
             lineStart + Len("proc ") <= lineStop &&
             ParserTextRangeEquals(
                lineRaw, lineStart, Len("proc "), "proc "):
            prefixLen = Len("proc ")
        elif lineStart + Len("proc ") <= lineStop &&
             ParserTextRangeEquals(lineRaw, lineStart, Len("proc "), "proc "):
            unsupportedKeyword = "proc"
        elif migrationSourceSyntax &&
             lineStart + Len("method ") <= lineStop &&
             ParserTextRangeEquals(
                lineRaw, lineStart, Len("method "), "method "):
            prefixLen = Len("method ")
        elif lineStart + Len("method ") <= lineStop &&
             ParserTextRangeEquals(lineRaw, lineStart, Len("method "), "method "):
            unsupportedKeyword = "method"
        elif migrationSourceSyntax &&
             lineStart + Len("converter ") <= lineStop &&
             ParserTextRangeEquals(
                lineRaw, lineStart, Len("converter "), "converter "):
            prefixLen = Len("converter ")
        elif lineStart + Len("converter ") <= lineStop &&
             ParserTextRangeEquals(lineRaw, lineStart, Len("converter "), "converter "):
            unsupportedKeyword = "converter"
        elif lineStart + Len("pub fn ") <= lineStop &&
             ParserTextRangeEquals(lineRaw, lineStart, Len("pub fn "), "pub fn "):
            # 'pub' is not part of the language (export is by-case); reject loudly
            # instead of silently dropping the declaration and emptying the module.
            unsupportedKeyword = "pub"
        if prefixLen <= 0 && unsupportedKeyword == "":
            continue
        if unsupportedKeyword != "":
            err = ParserConcat3("unsupported top-level function alias '", unsupportedKeyword, "'")
            return false
        var nameStart = lineStart + prefixLen
        while nameStart < lineStop:
            let code = Int32(lineRaw[nameStart])
            if code != 32 && code != 9:
                break
            nameStart = nameStart + 1
        # Backtick operator name: `[]=`, `[]`, `%`, `$`, etc.
        var functionName = ""
        var nameSurfaceStart = nameStart
        var nameSurfaceEnd: int32
        if nameStart < lineStop && Int32(lineRaw[nameStart]) == 96:
            var btClose = nameStart + 1
            while btClose < lineStop && Int32(lineRaw[btClose]) != 96:
                btClose = btClose + 1
            if btClose > nameStart + 1 && btClose < lineStop:
                functionName = ParserTextSliceCopy(lineRaw, nameStart + 1, btClose - nameStart - 1)
                nameSurfaceStart = nameStart + 1
                nameSurfaceEnd = btClose
        if functionName == "":
            functionName = ParserIdentPrefix(ParserTextSliceFast(lineRaw,
                                                                  nameStart,
                                                                  lineStop - nameStart))
            nameSurfaceEnd = nameStart + functionName.len
        if functionName == "":
            continue
        let inlineImportc = prefixLen == Len("importc fn ")
        let structuralImportc =
            lineIndex >= 0 && lineIndex < importcTargetColumns.len &&
            importcTargetColumns[lineIndex] == lineStart
        var decl: NormalizedFunctionDecl
        decl.name = functionName
        decl.lineIndex = lineIndex + 1
        decl.signatureStartColumn = lineStart
        decl.nameStartColumn = nameSurfaceStart
        decl.nameEndColumn = nameSurfaceEnd
        decl.importc = inlineImportc || structuralImportc
        decl.signatureEndLineIndex = decl.lineIndex
        decl.signatureEndColumn = lineStop
        decl.bodyStartLineIndex = -1
        decl.bodyStartColumn = -1
        decl.importcAnnotationBound = structuralImportc
        decl.ffiMapPtrArg = -1
        decl.ffiMapLenArg = -1
        decl.manualConsumePresent = false
        decl.manualConsumeFunctionDeclarationRow = -1
        decl.manualConsumeTargetParameterOrdinal = -1
        decl.manualConsumeTargetParameterDeclarationRow = -1
        decl.manualConsumeSourceParameterOrdinal = -1
        decl.manualConsumeSourceParameterDeclarationRow = -1
        decl.manualConsumeIdentityDigest = 0
        if !decl.importc:
            var bodyEqualsLineIndex: int32
            var bodyEqualsColumn: int32
            if ParserFunctionSignatureDelimiterLinesInto(
                   lines,
                   lineIndex,
                   lineStart,
                   bodyEqualsLineIndex,
                   bodyEqualsColumn):
                decl.signatureEndLineIndex = bodyEqualsLineIndex + 1
                decl.signatureEndColumn = bodyEqualsColumn + 1
                decl.bodyStartLineIndex = bodyEqualsLineIndex + 1
                decl.bodyStartColumn = bodyEqualsColumn + 1
                let bodyLine = lines[bodyEqualsLineIndex]
                var bodyLineStart: int32
                var bodyLineStop: int32
                let _ = ParserTrimmedCommentRangeSlashAware(
                    bodyLine,
                    bodyLineStart,
                    bodyLineStop)
                while decl.bodyStartColumn < bodyLineStop &&
                      ParserIsTrimChar(bodyLine[decl.bodyStartColumn]):
                    decl.bodyStartColumn = decl.bodyStartColumn + 1
                if i < bodyEqualsLineIndex + 1:
                    i = bodyEqualsLineIndex + 1
        if inlineImportc:
            decl.surfaceKeyword = "importc fn"
        else:
            decl.surfaceKeyword = "fn"
        add(outDecls, decl)
    var simpleAnnotationsHandled: bool
    if !ParserApplySimpleFunctionAnnotationsLinewiseInto(
           lines,
           outDecls,
           simpleAnnotationsHandled,
           err):
        return false
    if !simpleAnnotationsHandled:
        if !ParserApplyNormalizedFunctionAnnotationsInto(
               ParserSourceTextFromLines(lines),
               migrationSourceSyntax,
               outDecls,
               err):
            return false
    decls = outDecls
    err = ""
    return true

@borrows
fn ParserReadNormalizedFunctionDeclsLines(
        lines: str[],
        decls: var NormalizedFunctionDecl[],
        err: var str): bool =
    return parserReadFunctionDeclsLinesMode(
        lines, false, decls, err)

@borrows
fn ParserReadMigrationSourceFunctionDeclsLines(
        lines: str[],
        decls: var NormalizedFunctionDecl[],
        err: var str): bool =
    return parserReadFunctionDeclsLinesMode(
        lines, true, decls, err)

# Read-only over `textRaw`: it is only rewritten into the freshly owned local
# `text`; it is never rebound, stored or released here.
@borrows
fn ParserReadNormalizedFunctionDecls(textRaw: str,
                                       decls: var NormalizedFunctionDecl[],
                                       err: var str): bool =
    var text: str
    if !ParserRewriteMultilineStringSourceText(textRaw, text, err):
        return false
    let lines = ParserSplitChar(text, '\n')
    return ParserReadNormalizedFunctionDeclsLines(lines, decls, err)

@borrows
fn ParserReadNormalizedFfiHandleContracts(
        textRaw: str,
        table: var NormalizedFfiHandleContractTable,
        err: var str): bool =
    ParserNormalizedFfiHandleContractTableReset(table)
    var text: str
    if !ParserRewriteMultilineStringSourceText(textRaw, text, err):
        return false
    var decls: NormalizedFunctionDecl[]
    if !ParserReadNormalizedFunctionDecls(text, decls, err):
        return false
    var tree: ParserValueExprTree
    var noColumnCensus: int32[]
    if !parserValueExprReadTreeFromTextMode(text, false, 0, noColumnCensus, tree, err):
        ParserValueExprTreeRelease(tree)
        return false
    # Test-only convenience entry. Production consumers already own the exact
    # ParserValueExprTree and call ParserBuildNormalizedFfiHandleContractsInto.
    if !ParserBuildNormalizedFfiHandleContractsInto(
           tree, decls, table, err):
        ParserValueExprTreeRelease(tree)
        return false
    ParserValueExprTreeRelease(tree)
    err = ""
    return true

@borrows
fn ParserNormalizedFfiHandleContractCount(
        table: NormalizedFfiHandleContractTable): int32 =
    return table.functionDeclarationRows.len

@borrows
fn ParserNormalizedFfiHandleContractFunctionDeclarationRowAt(
        table: NormalizedFfiHandleContractTable,
        row: int32): int32 =
    if row < 0 || row >= table.functionDeclarationRows.len:
        return -1
    return table.functionDeclarationRows[row]

@borrows
fn ParserNormalizedFfiHandleContractAnnotationRowAt(
        table: NormalizedFfiHandleContractTable,
        row: int32): int32 =
    if row < 0 || row >= table.annotationRows.len:
        return -1
    return table.annotationRows[row]

@borrows
fn ParserNormalizedFfiHandleContractUnwindKindAt(
        table: NormalizedFfiHandleContractTable,
        row: int32): NormalizedFfiHandleUnwind =
    if row < 0 || row >= table.unwindKinds.len:
        return NormalizedFfiHandleUnwindInvalid
    return NormalizedFfiHandleUnwind(table.unwindKinds[row])

@borrows
fn ParserNormalizedFfiHandleContractResultEffectAt(
        table: NormalizedFfiHandleContractTable,
        row: int32): NormalizedFfiHandleEffect =
    if row < 0 || row >= table.resultEffects.len:
        return NormalizedFfiHandleEffectInvalid
    return NormalizedFfiHandleEffect(table.resultEffects[row])

@borrows
fn ParserNormalizedFfiHandleContractParameterCountAt(
        table: NormalizedFfiHandleContractTable,
        row: int32): int32 =
    if row < 0 || row >= table.parameterCounts.len:
        return -1
    return table.parameterCounts[row]

@borrows
fn ParserNormalizedFfiHandleContractParameterOrdinalAt(
        table: NormalizedFfiHandleContractTable,
        row: int32,
        parameterOffset: int32): int32 =
    if row < 0 || row >= table.parameterCounts.len ||
       parameterOffset < 0 || parameterOffset >= table.parameterCounts[row]:
        return -1
    return table.parameterOrdinals[
        table.parameterStarts[row] + parameterOffset]

@borrows
fn ParserNormalizedFfiHandleContractParameterDeclarationRowAt(
        table: NormalizedFfiHandleContractTable,
        row: int32,
        parameterOffset: int32): int32 =
    if row < 0 || row >= table.parameterCounts.len ||
       parameterOffset < 0 || parameterOffset >= table.parameterCounts[row]:
        return -1
    return table.parameterSourceLocalDeclarationRows[
        table.parameterStarts[row] + parameterOffset]

@borrows
fn ParserNormalizedFfiHandleContractParameterEffectAt(
        table: NormalizedFfiHandleContractTable,
        row: int32,
        parameterOffset: int32): NormalizedFfiHandleEffect =
    if row < 0 || row >= table.parameterCounts.len ||
       parameterOffset < 0 || parameterOffset >= table.parameterCounts[row]:
        return NormalizedFfiHandleEffectInvalid
    return NormalizedFfiHandleEffect(table.parameterEffects[
        table.parameterStarts[row] + parameterOffset])

@borrows
fn ParserNormalizedFfiHandleContractIdentityDigestAt(
        table: NormalizedFfiHandleContractTable,
        row: int32): int64 =
    if row < 0 || row >= table.identityDigests.len:
        return 0
    return table.identityDigests[row]

@borrows
fn ParserReadNormalizedFunctionDeclsLinesValue(lines: str[],
                                                 err: var str): NormalizedFunctionDecl[] =
    var outDecls: NormalizedFunctionDecl[]
    var ok: bool
    ok = ParserReadNormalizedFunctionDeclsLines(lines, outDecls, err)
    if ok == false:
        return outDecls
    return outDecls

@borrows
fn ParserContainsCompilerPrefix(lineRaw: str): bool =
    let line = chengpath.PathTrim(lineRaw)
    if ParserStartsWithExact(line, "import "):
        return true
    if ParserStartsWithExact(line, "type"):
        return true
    if ParserTopLevelFunctionKeywordExact(line) != "":
        return true
    if ParserStartsWithExact(line, "iterator "):
        return true
    if ParserStartsWithExact(line, "const "):
        return true
    if ParserStartsWithExact(line, "let "):
        return true
    if ParserStartsWithExact(line, "var "):
        return true
    return false

fn ParserModulePathTail(modulePath: str, skipCount: int32): str =
    let modulePathTrim = chengpath.PathTrim(modulePath)
    let parts = ParserSplitChar(modulePathTrim, '/')
    var out: str[]
    for i in skipCount..<parts.len:
        let rawPiece = parts[i]
        let piece = chengpath.PathTrim(rawPiece)
        if piece != "":
            add(out, piece)
    return ParserJoinSlash(out)

@borrows
fn ParserModulePathTailExact(modulePath: str, skipCount: int32): str =
    if modulePath == "":
        return ""
    var out = buffer.NewByteBuffer()
    let slash: str = "/"
    var wrote = false
    var pieceIndex: int32
    var start: int32
    var cursor: int32
    while cursor <= modulePath.len:
        let atEnd = cursor >= modulePath.len
        var stop = false
        if atEnd:
            stop = true
        elif modulePath[cursor] == '/':
            stop = true
        if !stop:
            cursor = cursor + 1
            continue
        if pieceIndex >= skipCount && cursor > start:
            if wrote:
                buffer.AppendText(out, slash)
            buffer.AppendText(out, ParserTextSliceCopy(modulePath, start, cursor - start))
            wrote = true
        pieceIndex = pieceIndex + 1
        start = cursor + 1
        cursor = cursor + 1
    return rawbytes.BytesToString(buffer.ToBytes(out))

fn ParserPathSlash(pathRaw: str): str =
    return ParserJoinSlash(ParserSplitChar(pathRaw, '\\'))

fn ParserRelWithoutExt(pathRaw: str): str =
    let path = ParserPathSlash(ParserNormalizePath(pathRaw))
    if path.len >= 6 && chengpath.TextSlice(path, path.len - 6, 6) == ".cheng":
        return chengpath.TextSlice(path, 0, path.len - 6)
    return path

@borrows
fn ParserSharedPackageRoot(workspaceRootRaw: str): str =
    let envRoot = ParserNormalizePath(os.GetEnv("CHENG_ROOT"))
    if envRoot != "":
        if ParserPackageId(envRoot) == "cheng":
            return envRoot
    let workspaceRoot = ParserNormalizePath(workspaceRootRaw)
    if workspaceRoot == "":
        return ""
    if ParserPackageId(workspaceRoot) == "cheng":
        return workspaceRoot
    let sharedRoot = ParserSharedRoot(workspaceRoot)
    if sharedRoot != "":
        return sharedRoot
    return ""

@borrows
fn ParserSharedBuiltinSourceRoot(workspaceRootRaw: str): str =
    let envRoot = ParserNormalizePath(os.GetEnv("CHENG_ROOT"))
    if envRoot != "":
        return envRoot
    return ParserNormalizePath(workspaceRootRaw)

@borrows
fn ParserSharedBuiltinModulePathToSourcePath(sharedSourceRootRaw: str,
                                               modulePathRaw: str): str =
    let sharedSourceRoot = ParserNormalizePath(sharedSourceRootRaw)
    let modulePath = chengpath.PathTrim(share(modulePathRaw))
    if sharedSourceRoot == "" || modulePath == "":
        return ""
    if ParserStartsWithExact(modulePath, "std/") && modulePath.len > 4:
        let rel: str = ParserTextSliceCopy(modulePath, 4, modulePath.len - 4)
        return ParserConcat3(ParserConcat2(sharedSourceRoot, "/src/std/"), rel, ".cheng")
    if ParserStartsWithExact(modulePath, "cheng/std/") && modulePath.len > 10:
        let rel: str = ParserTextSliceCopy(modulePath, 10, modulePath.len - 10)
        return ParserConcat3(ParserConcat2(sharedSourceRoot, "/src/std/"), rel, ".cheng")
    if ParserStartsWithExact(modulePath, "runtime/") && modulePath.len > 8:
        let rel: str = ParserTextSliceCopy(modulePath, 8, modulePath.len - 8)
        return ParserConcat3(ParserConcat2(sharedSourceRoot, "/src/runtime/"), rel, ".cheng")
    if ParserStartsWithExact(modulePath, "cheng/runtime/") && modulePath.len > 14:
        let rel: str = ParserTextSliceCopy(modulePath, 14, modulePath.len - 14)
        return ParserConcat3(ParserConcat2(sharedSourceRoot, "/src/runtime/"), rel, ".cheng")
    return ""

fn ParserSharedBuiltinSourcePathToModulePath(sharedSourceRootRaw: str,
                                               sourcePathRaw: str): str =
    let sharedSourceRoot = ParserNormalizePath(sharedSourceRootRaw)
    let sourcePath = ParserNormalizePath(sourcePathRaw)
    if sharedSourceRoot == "" || sourcePath == "":
        return ""
    let stdPrefix: str = ParserConcat2(sharedSourceRoot, "/src/std/")
    if ParserStartsWithExact(sourcePath, stdPrefix):
        let rel: str = ParserRelWithoutExt(chengpath.TextSlice(sourcePath,
                                                                stdPrefix.len,
                                                                sourcePath.len - stdPrefix.len))
        if rel == "":
            return "std"
        return ParserConcat2("std/", rel)
    let runtimePrefix: str = ParserConcat2(sharedSourceRoot, "/src/runtime/")
    if ParserStartsWithExact(sourcePath, runtimePrefix):
        let rel: str = ParserRelWithoutExt(chengpath.TextSlice(sourcePath,
                                                                runtimePrefix.len,
                                                                sourcePath.len - runtimePrefix.len))
        if rel == "":
            return "runtime"
        return ParserConcat2("runtime/", rel)
    return ""

@borrows
fn ParserModulePathToSourcePathPreparedWithExternalPackageRoots(workspaceRoot: str,
                                                                  packageRoot: str,
                                                                  sharedPackageRoot: str,
                                                                  packageId: str,
                                                                  packagePrefix: str,
                                                                  externalPackageRoots: ParserExternalPackageRoot[],
                                                                  modulePath: str): str =
    if modulePath == "":
        return ""
    let sharedBuiltinSourcePath = ParserSharedBuiltinModulePathToSourcePath(ParserSharedBuiltinSourceRoot(workspaceRoot),
                                                                              modulePath)
    if sharedBuiltinSourcePath != "":
        return sharedBuiltinSourcePath
    let packageBuiltinSourcePath = ParserSharedBuiltinModulePathToSourcePath(packageRoot,
                                                                              modulePath)
    if packageBuiltinSourcePath != "":
        return packageBuiltinSourcePath
    let activePackageBuiltinSourcePath = ParserSharedBuiltinModulePathToSourcePath(parserActivePackageRoot,
                                                                                    modulePath)
    if activePackageBuiltinSourcePath != "":
        return activePackageBuiltinSourcePath
    let workspaceBuiltinSourcePath = ParserSharedBuiltinModulePathToSourcePath(workspaceRoot,
                                                                                modulePath)
    if workspaceBuiltinSourcePath != "":
        return workspaceBuiltinSourcePath
    let cwdBuiltinSourcePath = ParserSharedBuiltinModulePathToSourcePath(ParserNormalizePath(os.GetCurrentDir()),
                                                                          modulePath)
    if cwdBuiltinSourcePath != "":
        return cwdBuiltinSourcePath
    var externalPackageRoot = ""
    var externalPackageId = ""
    var externalPackagePrefix = ""
    if ParserExternalPackageRootByModulePath(modulePath,
                                               externalPackageRoots,
                                               externalPackageRoot,
                                               externalPackageId,
                                               externalPackagePrefix):
        let rel = chengpath.TextSlice(modulePath,
                                     externalPackagePrefix.len,
                                     modulePath.len - externalPackagePrefix.len)
        # libp2p P0 CAS 挂载: 工作区源磁盘优先 (上方分支), 外部依赖经内容库 resolver。
        # CHENG_CAS_ROOT 空 → 返回 diskPath (CAS 未启用, 字节等价现行为, 零回归 opt-in);
        # 设了 → 依赖走 lock→cid→CAS.get→物化; miss/corruption = 硬错崩 (带 cid, 不回磁盘)。
        let diskPath = ParserConcat3(ParserConcat2(externalPackageRoot, "/src/"), rel, ".cheng")
        # P5-S1 主干 (缺锁自举): 外部包在消费方 cheng-package.toml pin 了 channel 且 lock 缺该
        # 模块 cid → 经注入 ensurer 展开 channelId→head→manifest→lock (子进程零 QUIC, 内部自证+
        # 验签+请求绑定+撤销并集)。展开后 lock 已含各模块 cid, 下方 resolve 正常按 cid 拉源。ensurer
        # 幂等 (lock 已含该模块 → no-op); 任一步失败 (head 验签败/headCid 不匹配/manifest 非法行/
        # cid 拉不到) = 硬错上抛, 绝不静默跳过。未注入 ensurer / 无 channel pin / storeRoot 空 →
        # 跳过, 行为字节零回归 (增量特性, 非 fallback)。fn-value 派发 driver-gated (见 ParserSetCasLockEnsurer)。
        let casStoreRoot = os.GetEnvDefault("CHENG_CAS_ROOT", "")
        if parserCasLockEnsurerSet && casStoreRoot != "":
            var channelPin = ""
            if ParserExternalPackageChannelByModulePath(modulePath, externalPackageRoots, channelPin):
                var ensureRes: Result[bool] = parserCasLockEnsurerImpl(channelPin, ParserOwnedText(modulePath), casStoreRoot)
                if IsErr(ensureRes):
                    system.Panic(Error(ensureRes))
        if parserCasFetcherSet:
            # 注入态: blob miss → 经注入 fetcher 按 cid 网络拉源 + cid 自校验 + ingest;
            # fetch 失败 = 硬错上抛 (WithFetch 内直接 Err, 绝不回落旧磁盘路径)。
            let fetched = cas.CasResolveDependencyPathWithFetch(
                os.GetEnvDefault("CHENG_CAS_ROOT", ""),
                ParserOwnedText(modulePath),
                diskPath,
                parserCasFetcherImpl)
            if IsErr(fetched):
                system.Panic(Error(fetched))
            return Value(fetched)
        # 未注入态: 网络自动拉关 (特性开关), 依赖 miss 硬错崩 (旧行为, 字节零回归)。
        let resolved = cas.CasResolveDependencyPath(
            os.GetEnvDefault("CHENG_CAS_ROOT", ""),
            ParserOwnedText(modulePath),
            diskPath)
        if IsErr(resolved):
            system.Panic(Error(resolved))
        return Value(resolved)
    if packageId != "" && modulePath.len > packageId.len && ParserStartsWithExact(modulePath, packagePrefix):
        let rel: str = chengpath.TextSlice(modulePath,
                                          packagePrefix.len,
                                          modulePath.len - packagePrefix.len)
        return ParserConcat3(ParserConcat2(packageRoot, "/src/"), rel, ".cheng")
    if sharedPackageRoot != "" &&
       ParserStartsWithExact(modulePath, "cheng/") &&
       modulePath.len > 6:
        let rel: str = ParserModulePathTailExact(modulePath, 1)
        return ParserConcat3(ParserConcat2(sharedPackageRoot, "/src/"), rel, ".cheng")
    return ""

fn ParserModulePathToSourcePathPrepared(workspaceRoot: str,
                                          packageRoot: str,
                                          sharedPackageRoot: str,
                                          packageId: str,
                                          packagePrefix: str,
                                          modulePath: str): str =
    var externalPackageRoots: ParserExternalPackageRoot[]
    return ParserModulePathToSourcePathPreparedWithExternalPackageRoots(workspaceRoot,
                                                                          packageRoot,
                                                                          sharedPackageRoot,
                                                                          packageId,
                                                                          packagePrefix,
                                                                          externalPackageRoots,
                                                                          modulePath)

fn ParserModulePathToSourcePathWithExternalPackageRoots(workspaceRootRaw: str,
                                                          packageRootRaw: str,
                                                          externalPackageRoots: ParserExternalPackageRoot[],
                                                          modulePathRaw: str): str =
    let workspaceRoot: str = ParserNormalizePath(workspaceRootRaw)
    let packageRoot: str = ParserNormalizePath(packageRootRaw)
    let modulePath: str = chengpath.PathTrim(modulePathRaw)
    let sharedPackageRoot: str = ParserSharedPackageRoot(workspaceRoot)
    let packageId: str = ParserPackageId(packageRoot)
    let packagePrefix: str = ParserConcat2(packageId, "/")
    return ParserModulePathToSourcePathPreparedWithExternalPackageRoots(workspaceRoot,
                                                                          packageRoot,
                                                                          sharedPackageRoot,
                                                                          packageId,
                                                                          packagePrefix,
                                                                          externalPackageRoots,
                                                                          modulePath)

fn ParserModulePathToSourcePath(workspaceRootRaw: str, packageRootRaw: str, modulePathRaw: str): str =
    var externalPackageRoots: ParserExternalPackageRoot[]
    return ParserModulePathToSourcePathWithExternalPackageRoots(workspaceRootRaw,
                                                                  packageRootRaw,
                                                                  externalPackageRoots,
                                                                  modulePathRaw)

@borrows
fn ParserSourcePathToModulePathWithExternalPackageRoots(workspaceRootRaw: str,
                                                          packageRootRaw: str,
                                                          externalPackageRoots: ParserExternalPackageRoot[],
                                                          sourcePathRaw: str): str =
    let workspaceRootInput = ParserOwnedText(workspaceRootRaw)
    let workspaceRoot: str = ParserNormalizePath(workspaceRootInput)
    let packageRoot: str = ParserOwnedText(packageRootRaw)
    let sourcePath: str = ParserOwnedText(sourcePathRaw)
    let sharedBuiltinModulePath =
        ParserSharedBuiltinSourcePathToModulePath(
            ParserSharedBuiltinSourceRoot(
                ParserOwnedText(workspaceRoot)),
            ParserOwnedText(sourcePath))
    if sharedBuiltinModulePath != "":
        return sharedBuiltinModulePath
    let packageBuiltinModulePath =
        ParserSharedBuiltinSourcePathToModulePath(
            ParserOwnedText(packageRoot),
            ParserOwnedText(sourcePath))
    if packageBuiltinModulePath != "":
        return packageBuiltinModulePath
    let workspaceBuiltinModulePath =
        ParserSharedBuiltinSourcePathToModulePath(
            ParserOwnedText(workspaceRoot),
            ParserOwnedText(sourcePath))
    if workspaceBuiltinModulePath != "":
        return workspaceBuiltinModulePath
    let activePackageBuiltinModulePath =
        ParserSharedBuiltinSourcePathToModulePath(
            ParserOwnedText(parserActivePackageRoot),
            ParserOwnedText(sourcePath))
    if activePackageBuiltinModulePath != "":
        return activePackageBuiltinModulePath
    let cwdBuiltinModulePath =
        ParserSharedBuiltinSourcePathToModulePath(
            ParserNormalizePath(os.GetCurrentDir()),
            ParserOwnedText(sourcePath))
    if cwdBuiltinModulePath != "":
        return cwdBuiltinModulePath
    let packagePrefix: str =
        ParserConcat2(ParserOwnedText(packageRoot), "/src/")
    if ParserStartsWithExact(sourcePath, packagePrefix):
        let rel: str = ParserRelWithoutExt(chengpath.TextSlice(sourcePath,
                                                                packagePrefix.len,
                                                                sourcePath.len - packagePrefix.len))
        let packageId: str = ParserPackageId(packageRoot)
        if rel == "":
            return packageId
        return ParserConcat3(packageId, "/", rel)
    let sharedPackageRoot: str = ParserSharedPackageRoot(workspaceRoot)
    let sharedPrefix: str = ParserConcat2(sharedPackageRoot, "/src/")
    if sharedPackageRoot != "" && ParserStartsWithExact(sourcePath, sharedPrefix):
        let rel: str = ParserRelWithoutExt(chengpath.TextSlice(sourcePath,
                                                                sharedPrefix.len,
                                                                sourcePath.len - sharedPrefix.len))
        if rel == "":
            return "cheng"
        return ParserConcat2("cheng/", rel)
    var externalPackageRoot = ""
    var externalPackageId = ""
    if ParserExternalPackageRootBySourcePath(
                                               ParserOwnedText(sourcePath),
                                               ParserExternalPackageRootsClone(
                                                   externalPackageRoots),
                                               externalPackageRoot,
                                               externalPackageId):
        let externalPrefix: str = ParserConcat2(externalPackageRoot, "/src/")
        let rel: str = ParserRelWithoutExt(chengpath.TextSlice(sourcePath,
                                                                externalPrefix.len,
                                                                sourcePath.len - externalPrefix.len))
        if rel == "":
            return externalPackageId
        return ParserConcat3(externalPackageId, "/", rel)
    return ParserFileStem(sourcePath)

# Source-bundle identity must not inherit the permissive import resolver's
# active-package/CWD aliases or basename fallback.  This normalizer is lexical:
# it removes duplicate separators and dot segments, resolves parent segments,
# and rejects an escape above the supplied path root.  It deliberately does not
# consult the filesystem, so identity is stable across machines and symlinks.
@borrows
fn ParserSourceIdentityLexicalPathInto(pathRaw: str, out: var str): bool =
    out = ""
    if pathRaw == "":
        return false
    let path = chengpath.PathHostFilePath(ParserOwnedText(pathRaw))
    if path == "":
        return false
    let posixAbsolute = path[0] == '/' || path[0] == '\\'
    var driveAbsolute = false
    if path.len >= 3:
        if path[1] == ':' && (path[2] == '/' || path[2] == '\\'):
            driveAbsolute = true
    var cursor: int32
    if driveAbsolute:
        cursor = 3
    var parts: str[]
    while cursor < path.len:
        while cursor < path.len && (path[cursor] == '/' || path[cursor] == '\\'):
            cursor = cursor + 1
        if cursor >= path.len:
            break
        let partStart = cursor
        while cursor < path.len && path[cursor] != '/' && path[cursor] != '\\':
            cursor = cursor + 1
        let part = ParserOwnedTextRange(path, partStart, cursor - partStart)
        if part == "" || part == ".":
            continue
        if part == "..":
            if parts.len <= 0:
                return false
            setLen(parts, parts.len - 1)
            continue
        add(parts, part)
    let joined = strutil.Join(parts, "/")
    if driveAbsolute:
        let drive = ParserOwnedTextRange(path, 0, 2)
        if joined == "":
            out = ParserConcat3(drive, "/", "")
        else:
            out = ParserConcat3(drive, "/", joined)
    elif posixAbsolute:
        if joined == "":
            out = "/"
        else:
            out = ParserConcat3("/", joined, "")
    else:
        out = joined
    return out != ""

@borrows
fn ParserSourceIdentityPathAbsolute(path: str): bool =
    if path == "":
        return false
    if path[0] == '/':
        return true
    if path.len >= 3:
        return path[1] == ':' && path[2] == '/'
    return false

@borrows
fn ParserSourceIdentityModuleTextValid(text: str): bool =
    if text == "" || text[0] == '/' || text[text.len - 1] == '/':
        return false
    if text.len >= 3 && text[1] == ':' && text[2] == '/':
        return false
    var partStart: int32
    for i in 0..<text.len:
        let ch = text[i]
        let code = Int32(ch) & 255
        if code < 32 || code == 127 || ch == '\\' || ch == ' ':
            return false
        if ch != '/':
            continue
        if i <= partStart:
            return false
        let part = chengpath.TextSlice(text, partStart, i - partStart)
        if part == "." || part == "..":
            return false
        partStart = i + 1
    if partStart >= text.len:
        return false
    let tail = chengpath.TextSlice(text, partStart, text.len - partStart)
    return tail != "." && tail != ".."

@borrows
fn ParserSourceIdentityAppendOwner(ownerRoots: var str[],
                                    ownerPackageIds: var str[],
                                    ownerChannels: var str[],
                                    ownerKinds: var int32[],
                                    rootRaw: str,
                                    packageIdRaw: str,
                                    channelRaw: str,
                                    kind: int32): bool =
    var root: str
    if !ParserSourceIdentityLexicalPathInto(rootRaw, root) ||
       !ParserSourceIdentityPathAbsolute(root):
        return false
    let packageId = ParserManifestNormalizePackageId(packageIdRaw)
    let channelText = chengpath.PathTrim(share(channelRaw))
    if channelText != "" && !ParserChannelHexValid(channelText):
        return false
    let channel = strutil.ToLowerAscii(channelText)
    if !ParserSourceIdentityModuleTextValid(packageId) ||
       packageId == "std" || packageId == "runtime" ||
       packageId == "cheng/std" || packageId == "cheng/runtime":
        return false
    for ownerIndex in 0..<ownerRoots.len:
        if ownerRoots[ownerIndex] == root:
            if ownerPackageIds[ownerIndex] != packageId ||
               ownerChannels[ownerIndex] != channel ||
               ownerKinds[ownerIndex] != kind:
                return false
            return true
        if ownerPackageIds[ownerIndex] == packageId:
            # A module path must identify one physical package root regardless
            # of external-root ordering.
            return false
    add(ownerRoots, root)
    add(ownerPackageIds, packageId)
    add(ownerChannels, channel)
    add(ownerKinds, kind)
    return true

@borrows
fn ParserSourceIdentitySourcePrefix(root: str): str =
    if root == "/":
        return "/src/"
    return strutil.Join([share(root), "/src/"], "")

@borrows
fn ParserSourceIdentitySourceFromOwner(root: str, rel: str): str =
    if root == "/":
        return strutil.Join(["/src/", share(rel), ".cheng"], "")
    return strutil.Join(
        [share(root), "/src/", share(rel), ".cheng"], "")

@borrows
fn ParserSourceIdentityImportPrefixCompatible(importPrefix: str,
                                                canonicalPackageId: str): bool =
    if importPrefix == canonicalPackageId:
        return true
    if ParserStartsWithExact(canonicalPackageId, "cheng/") &&
       canonicalPackageId.len > 6:
        return importPrefix == chengpath.TextSlice(canonicalPackageId,
                                                   6,
                                                   canonicalPackageId.len - 6)
    return false

@borrows
fn ParserSourceIdentityModuleRoundTrips(ownerRoots: str[],
                                         ownerPackageIds: str[],
                                         sourcePath: str,
                                         modulePath: str): bool =
    var selectedOwner: int32 = -1
    var rel: str
    if ParserStartsWithExact(modulePath, "std/") && modulePath.len > 4:
        rel = strutil.Join(["std/",
                            chengpath.TextSlice(modulePath, 4, modulePath.len - 4)],
                           "")
        for ownerIndex in 0..<ownerRoots.len:
            if ownerPackageIds[ownerIndex] == "cheng":
                if selectedOwner >= 0:
                    return false
                selectedOwner = ownerIndex
    elif ParserStartsWithExact(modulePath, "runtime/") && modulePath.len > 8:
        rel = strutil.Join(["runtime/",
                            chengpath.TextSlice(modulePath, 8, modulePath.len - 8)],
                           "")
        for ownerIndex in 0..<ownerRoots.len:
            if ownerPackageIds[ownerIndex] == "cheng":
                if selectedOwner >= 0:
                    return false
                selectedOwner = ownerIndex
    else:
        var bestPackageIdLen: int32 = -1
        for ownerIndex in 0..<ownerRoots.len:
            let packagePrefix = strutil.Join([ParserOwnedText(ownerPackageIds[ownerIndex]), "/"], "")
            if modulePath.len <= packagePrefix.len ||
               !ParserStartsWithExact(modulePath, packagePrefix):
                continue
            if ownerPackageIds[ownerIndex].len < bestPackageIdLen:
                continue
            if ownerPackageIds[ownerIndex].len == bestPackageIdLen:
                return false
            bestPackageIdLen = ownerPackageIds[ownerIndex].len
            selectedOwner = ownerIndex
        if selectedOwner >= 0:
            let prefixLen = ownerPackageIds[selectedOwner].len + 1
            rel = chengpath.TextSlice(modulePath,
                                      prefixLen,
                                      modulePath.len - prefixLen)
    if selectedOwner < 0 || rel == "" ||
       !ParserSourceIdentityModuleTextValid(rel):
        return false
    var resolvedSource: str
    if !ParserSourceIdentityLexicalPathInto(
            ParserSourceIdentitySourceFromOwner(ownerRoots[selectedOwner], rel),
            resolvedSource):
        return false
    return resolvedSource == sourcePath

@borrows
fn ParserSourceIdentityConsiderModuleOwnerCandidate(
        modulePath: str,
        importPrefix: str,
        canonicalPackageId: str,
        sourceRelPrefix: str,
        ownerIndex: int32,
        bestPrefixLen: var int32,
        selectedOwner: var int32,
        selectedCanonicalModule: var str,
        selectedRel: var str): bool =
    let prefix = strutil.Join([ParserOwnedText(importPrefix), "/"], "")
    if modulePath.len <= prefix.len ||
       !ParserStartsWithExact(modulePath, prefix):
        return true
    let rel = chengpath.TextSlice(modulePath,
                                  prefix.len,
                                  modulePath.len - prefix.len)
    if !ParserSourceIdentityModuleTextValid(rel):
        return false
    let canonicalModule = strutil.Join([ParserOwnedText(canonicalPackageId), "/", ParserOwnedText(rel)], "")
    if !ParserSourceIdentityModuleTextValid(canonicalModule):
        return false
    if importPrefix.len < bestPrefixLen:
        return true
    let sourceRel = strutil.Join([ParserOwnedText(sourceRelPrefix), ParserOwnedText(rel)], "")
    if !ParserSourceIdentityModuleTextValid(sourceRel):
        return false
    if importPrefix.len == bestPrefixLen:
        return selectedOwner == ownerIndex &&
               selectedCanonicalModule == canonicalModule &&
               selectedRel == sourceRel
    bestPrefixLen = importPrefix.len
    selectedOwner = ownerIndex
    selectedCanonicalModule = canonicalModule
    selectedRel = sourceRel
    return true

# Strict source identity resolver.  Unlike the ordinary import compatibility
# resolver, every accepted source has one producer-certified owner root and a
# unique reverse module mapping.  No manifest re-read, activePackageRoot, CWD,
# CHENG_ROOT, CAS, shortest root, alias, or basename fallback participates.
@borrows
fn ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
        workspaceRootRaw: str,
        packageRootRaw: str,
        currentPackageIdRaw: str,
        externalPackageRoots: ParserExternalPackageRoot[],
        sourcePathRaw: str,
        outModulePath: var str): bool =
    outModulePath = ""
    var packageRoot: str
    if !ParserSourceIdentityLexicalPathInto(packageRootRaw, packageRoot) ||
       !ParserSourceIdentityPathAbsolute(packageRoot):
        return false
    var workspaceRoot: str
    if !ParserSourceIdentityLexicalPathInto(workspaceRootRaw, workspaceRoot) ||
       !ParserSourceIdentityPathAbsolute(workspaceRoot):
        return false
    var sourcePath: str
    if !ParserSourceIdentityLexicalPathInto(sourcePathRaw, sourcePath):
        return false
    if !ParserSourceIdentityPathAbsolute(sourcePath):
        if !ParserSourceIdentityLexicalPathInto(
                strutil.Join([ParserOwnedText(packageRoot), "/", ParserOwnedText(sourcePath)], ""),
                sourcePath):
            return false

    var ownerRoots: str[]
    var ownerPackageIds: str[]
    var ownerChannels: str[]
    var ownerKinds: int32[]
    let packageId = ParserManifestNormalizePackageId(currentPackageIdRaw)
    if packageId == "" ||
       !ParserSourceIdentityAppendOwner(ownerRoots,
                                        ownerPackageIds,
                                        ownerChannels,
                                        ownerKinds,
                                        packageRoot,
                                        packageId,
                                        "",
                                        2):
        return false
    if workspaceRoot != packageRoot:
        if !ParserSourceIdentityAppendOwner(ownerRoots,
                                            ownerPackageIds,
                                            ownerChannels,
                                            ownerKinds,
                                            workspaceRoot,
                                            "cheng",
                                            "",
                                            1):
            return false
    for externalIndex in 0..<externalPackageRoots.len:
        var externalRoot: str
        if !ParserSourceIdentityLexicalPathInto(
                externalPackageRoots[externalIndex].packageRoot,
                externalRoot):
            return false
        let canonicalPackageId = ParserManifestNormalizePackageId(
            externalPackageRoots[externalIndex].canonicalPackageId)
        let importPrefix = ParserManifestNormalizePackageId(
            externalPackageRoots[externalIndex].packageId)
        if !ParserSourceIdentityModuleTextValid(importPrefix) ||
           !ParserSourceIdentityImportPrefixCompatible(importPrefix,
                                                        canonicalPackageId) ||
           !ParserSourceIdentityAppendOwner(ownerRoots,
                                            ownerPackageIds,
                                            ownerChannels,
                                            ownerKinds,
                                            externalRoot,
                                            canonicalPackageId,
                                            externalPackageRoots[externalIndex].channel,
                                            3):
            return false

    var selectedOwner: int32 = -1
    var selectedPrefix: str
    var selectedRootLen: int32 = -1
    for ownerIndex in 0..<ownerRoots.len:
        let sourcePrefix = ParserSourceIdentitySourcePrefix(ownerRoots[ownerIndex])
        if sourcePath.len <= sourcePrefix.len + 6 ||
           !ParserStartsWithExact(sourcePath, sourcePrefix):
            continue
        if ownerRoots[ownerIndex].len < selectedRootLen:
            continue
        if ownerRoots[ownerIndex].len == selectedRootLen:
            return false
        selectedOwner = ownerIndex
        selectedPrefix = sourcePrefix
        selectedRootLen = ownerRoots[ownerIndex].len
    if selectedOwner < 0 || sourcePath.len < 6:
        return false
    let extension = chengpath.TextSlice(sourcePath, sourcePath.len - 6, 6)
    if extension != ".cheng":
        return false
    let relLen = sourcePath.len - selectedPrefix.len - 6
    if relLen <= 0:
        return false
    let rel = chengpath.TextSlice(sourcePath, selectedPrefix.len, relLen)
    if !ParserSourceIdentityModuleTextValid(rel):
        return false
    var modulePath: str
    if ownerPackageIds[selectedOwner] == "cheng" &&
       ParserStartsWithExact(rel, "std/") && rel.len > 4:
        modulePath = strutil.Join(["std/",
                                   chengpath.TextSlice(rel, 4, rel.len - 4)],
                                  "")
    elif ownerPackageIds[selectedOwner] == "cheng" &&
         ParserStartsWithExact(rel, "runtime/") && rel.len > 8:
        modulePath = strutil.Join(["runtime/",
                                   chengpath.TextSlice(rel, 8, rel.len - 8)],
                                  "")
    else:
        modulePath = strutil.Join([ParserOwnedText(ownerPackageIds[selectedOwner]), "/", ParserOwnedText(rel)], "")
    if !ParserSourceIdentityModuleTextValid(modulePath) ||
       !ParserSourceIdentityModuleRoundTrips(ownerRoots,
                                              ownerPackageIds,
                                              sourcePath,
                                              modulePath):
        return false
    outModulePath = modulePath
    return true

# Pure inverse of the strict source-identity resolver.  The input may use a
# producer-certified external import prefix, but both outputs are canonical.
# Resolution depends only on the supplied frozen roots and proves the selected
# source by running the exact forward mapping back to the canonical module.
@borrows
fn ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
        workspaceRootRaw: str,
        packageRootRaw: str,
        currentPackageIdRaw: str,
        externalPackageRoots: ParserExternalPackageRoot[],
        modulePathRaw: str,
        outCanonicalModulePath: var str,
        outSourcePath: var str): bool =
    outCanonicalModulePath = ""
    outSourcePath = ""
    if !ParserSourceIdentityModuleTextValid(modulePathRaw):
        return false
    var packageRoot: str
    if !ParserSourceIdentityLexicalPathInto(packageRootRaw, packageRoot) ||
       !ParserSourceIdentityPathAbsolute(packageRoot):
        return false
    var workspaceRoot: str
    if !ParserSourceIdentityLexicalPathInto(workspaceRootRaw, workspaceRoot) ||
       !ParserSourceIdentityPathAbsolute(workspaceRoot):
        return false

    var ownerRoots: str[]
    var ownerPackageIds: str[]
    var ownerChannels: str[]
    var ownerKinds: int32[]
    let packageId = ParserManifestNormalizePackageId(currentPackageIdRaw)
    if packageId == "" ||
       !ParserSourceIdentityAppendOwner(ownerRoots,
                                        ownerPackageIds,
                                        ownerChannels,
                                        ownerKinds,
                                        packageRoot,
                                        packageId,
                                        "",
                                        2):
        return false
    if workspaceRoot != packageRoot:
        if !ParserSourceIdentityAppendOwner(ownerRoots,
                                            ownerPackageIds,
                                            ownerChannels,
                                            ownerKinds,
                                            workspaceRoot,
                                            "cheng",
                                            "",
                                            1):
            return false
    for externalIndex in 0..<externalPackageRoots.len:
        var externalRoot: str
        if !ParserSourceIdentityLexicalPathInto(
                externalPackageRoots[externalIndex].packageRoot,
                externalRoot):
            return false
        let canonicalPackageId = ParserManifestNormalizePackageId(
            externalPackageRoots[externalIndex].canonicalPackageId)
        let importPrefix = ParserManifestNormalizePackageId(
            externalPackageRoots[externalIndex].packageId)
        if !ParserSourceIdentityModuleTextValid(importPrefix) ||
           !ParserSourceIdentityImportPrefixCompatible(importPrefix,
                                                        canonicalPackageId) ||
           !ParserSourceIdentityAppendOwner(ownerRoots,
                                            ownerPackageIds,
                                            ownerChannels,
                                            ownerKinds,
                                            externalRoot,
                                            canonicalPackageId,
                                            externalPackageRoots[externalIndex].channel,
                                            3):
            return false

    var selectedOwner: int32 = -1
    var selectedCanonicalModule: str
    var selectedRel: str
    var bestPrefixLen: int32 = -1
    var chengOwner: int32 = -1
    for ownerIndex in 0..<ownerPackageIds.len:
        if ownerPackageIds[ownerIndex] == "cheng":
            if chengOwner >= 0:
                return false
            chengOwner = ownerIndex
        if !ParserSourceIdentityConsiderModuleOwnerCandidate(
                modulePathRaw,
                ownerPackageIds[ownerIndex],
                ownerPackageIds[ownerIndex],
                "",
                ownerIndex,
                bestPrefixLen,
                selectedOwner,
                selectedCanonicalModule,
                selectedRel):
            return false
    if chengOwner >= 0:
        # `cheng/std/...` and `cheng/runtime/...` are public compatibility
        # spellings for builtin modules.  They select the same certified Cheng
        # owner as their canonical `std/...` / `runtime/...` identities; the
        # longer exact prefix makes this mapping unambiguous against `cheng/...`.
        if !ParserSourceIdentityConsiderModuleOwnerCandidate(
                modulePathRaw,
                "cheng/std",
                "std",
                "std/",
                chengOwner,
                bestPrefixLen,
                selectedOwner,
                selectedCanonicalModule,
                selectedRel):
            return false
        if !ParserSourceIdentityConsiderModuleOwnerCandidate(
                modulePathRaw,
                "cheng/runtime",
                "runtime",
                "runtime/",
                chengOwner,
                bestPrefixLen,
                selectedOwner,
                selectedCanonicalModule,
                selectedRel):
            return false
        if !ParserSourceIdentityConsiderModuleOwnerCandidate(
                modulePathRaw,
                "std",
                "std",
                "std/",
                chengOwner,
                bestPrefixLen,
                selectedOwner,
                selectedCanonicalModule,
                selectedRel):
            return false
        if !ParserSourceIdentityConsiderModuleOwnerCandidate(
                modulePathRaw,
                "runtime",
                "runtime",
                "runtime/",
                chengOwner,
                bestPrefixLen,
                selectedOwner,
                selectedCanonicalModule,
                selectedRel):
            return false
    for externalIndex in 0..<externalPackageRoots.len:
        var externalRoot: str
        if !ParserSourceIdentityLexicalPathInto(
                externalPackageRoots[externalIndex].packageRoot,
                externalRoot):
            return false
        let canonicalPackageId = ParserManifestNormalizePackageId(
            externalPackageRoots[externalIndex].canonicalPackageId)
        let importPrefix = ParserManifestNormalizePackageId(
            externalPackageRoots[externalIndex].packageId)
        var externalOwner: int32 = -1
        for ownerIndex in 0..<ownerRoots.len:
            if ownerRoots[ownerIndex] == externalRoot &&
               ownerPackageIds[ownerIndex] == canonicalPackageId:
                if externalOwner >= 0:
                    return false
                externalOwner = ownerIndex
        if externalOwner < 0 ||
           !ParserSourceIdentityConsiderModuleOwnerCandidate(
                modulePathRaw,
                importPrefix,
                canonicalPackageId,
                "",
                externalOwner,
                bestPrefixLen,
                selectedOwner,
                selectedCanonicalModule,
                selectedRel):
            return false
    if selectedOwner < 0 || selectedRel == "" ||
       selectedCanonicalModule == "":
        return false
    var sourcePath: str
    if !ParserSourceIdentityLexicalPathInto(
            ParserSourceIdentitySourceFromOwner(ownerRoots[selectedOwner],
                                                selectedRel),
            sourcePath) ||
       !ParserSourceIdentityPathAbsolute(sourcePath):
        return false
    var roundTripModule: str
    if !ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
            workspaceRoot,
            packageRoot,
            packageId,
            externalPackageRoots,
            sourcePath,
            roundTripModule) ||
       roundTripModule != selectedCanonicalModule:
        return false
    outCanonicalModulePath = selectedCanonicalModule
    outSourcePath = sourcePath
    return true

@borrows
fn ParserSourcePathToModulePath(workspaceRootRaw: str, packageRootRaw: str, sourcePathRaw: str): str =
    var externalPackageRoots: ParserExternalPackageRoot[]
    return ParserSourcePathToModulePathWithExternalPackageRoots(workspaceRootRaw,
                                                                  packageRootRaw,
                                                                  externalPackageRoots,
                                                                  sourcePathRaw)

@borrows
fn ParserHasCompilerTopLevel(textRaw: str): bool =
    var text: str
    var err = ""
    if !ParserRewriteMultilineStringSourceText(textRaw, text, err):
        return false
    let lines = ParserSplitChar(text, '\n')
    let decls = ParserReadNormalizedFunctionDeclsLinesValue(lines, err)
    if err == "" && decls.len > 0:
        return true
    for i in 0..<lines.len:
        if ParserContainsCompilerPrefix(lines[i]):
            return true
    return false

fn parserMainFunctionPresentMode(textRaw: str,
                                 migrationSourceSyntax: bool): bool =
    var text: str
    var err = ""
    if !ParserRewriteMultilineStringSourceText(textRaw, text, err):
        return false
    let lines = ParserSplitChar(text, '\n')
    var decls: NormalizedFunctionDecl[]
    if !parserReadFunctionDeclsLinesMode(
            lines, migrationSourceSyntax, decls, err):
        return false
    for i in 0..<decls.len:
        if decls[i].importc:
            continue
        if decls[i].name == "main":
            return true
    return false

fn ParserMainFunctionPresent(textRaw: str): bool =
    return parserMainFunctionPresentMode(textRaw, false)

fn ParserMigrationSourceMainFunctionPresent(textRaw: str): bool =
    return parserMainFunctionPresentMode(textRaw, true)

fn ParserAppendImportEdgeWithExternalPackageRoots(workspaceRoot: str,
                                                    packageRoot: str,
                                                    externalPackageRoots: ParserExternalPackageRoot[],
                                                    ownerModulePath: str,
                                                    modulePathRaw: str,
                                                    importAliasRaw: str,
                                                    edges: var ImportEdge[],
                                                    err: var str): bool =
    let normalizedWorkspaceRoot = ParserNormalizePath(workspaceRoot)
    let normalizedPackageRoot = ParserNormalizePath(packageRoot)
    let modulePath = chengpath.PathTrim(modulePathRaw)
    let importAlias = chengpath.PathTrim(importAliasRaw)
    let sharedPackageRoot: str = ParserSharedPackageRoot(normalizedWorkspaceRoot)
    let packageId: str = ParserPackageId(normalizedPackageRoot)
    let packagePrefix: str = ParserConcat2(packageId, "/")
    return ParserAppendImportEdgePreparedWithExternalPackageRoots(normalizedWorkspaceRoot,
                                                                    normalizedPackageRoot,
                                                                    sharedPackageRoot,
                                                                    packageId,
                                                                    packagePrefix,
                                                                    externalPackageRoots,
                                                                    ownerModulePath,
                                                                    modulePath,
                                                                    importAlias,
                                                                    edges,
                                                                    err)

fn ParserDirectImportSourcePathWithExternalPackageRoots(
        normalizedWorkspaceRoot: str,
        normalizedPackageRoot: str,
        externalPackageRoots: ParserExternalPackageRoot[],
        modulePath: str): str =
    if normalizedPackageRoot != "":
        if modulePath.len > 4 &&
           ParserStartsWithExact(modulePath, "std/"):
            let rel = ParserOwnedTextRange(
                modulePath, 4, modulePath.len - 4)
            return ParserConcat4(
                normalizedPackageRoot, "/src/std/", rel, ".cheng")
        if modulePath.len > 10 &&
           ParserStartsWithExact(modulePath, "cheng/std/"):
            let rel = ParserOwnedTextRange(
                modulePath, 10, modulePath.len - 10)
            return ParserConcat4(
                normalizedPackageRoot, "/src/std/", rel, ".cheng")
        if modulePath.len > 8 &&
           ParserStartsWithExact(modulePath, "runtime/"):
            let rel = ParserOwnedTextRange(
                modulePath, 8, modulePath.len - 8)
            return ParserConcat4(
                normalizedPackageRoot, "/src/runtime/", rel, ".cheng")
        if modulePath.len > 14 &&
           ParserStartsWithExact(modulePath, "cheng/runtime/"):
            let rel = ParserOwnedTextRange(
                modulePath, 14, modulePath.len - 14)
            return ParserConcat4(
                normalizedPackageRoot, "/src/runtime/", rel, ".cheng")
        if modulePath.len > 11 &&
           ParserStartsWithExact(modulePath, "cheng/core/"):
            let rel = ParserOwnedTextRange(
                modulePath, 6, modulePath.len - 6)
            return ParserConcat4(
                normalizedPackageRoot, "/src/", rel, ".cheng")
    return ParserModulePathToSourcePathWithExternalPackageRoots(
        normalizedWorkspaceRoot,
        normalizedPackageRoot,
        externalPackageRoots,
        modulePath)

fn ParserAppendImportEdgeDirectWithExternalPackageRoots(workspaceRoot: str,
                                                         packageRoot: str,
                                                         externalPackageRoots: ParserExternalPackageRoot[],
                                                         ownerModulePath: str,
                                                         modulePathRaw: str,
                                                         importAliasRaw: str,
                                                         edges: var ImportEdge[],
                                                         err: var str): bool =
    let normalizedWorkspaceRoot = ParserNormalizePath(workspaceRoot)
    let normalizedPackageRoot = ParserNormalizePath(packageRoot)
    let modulePath = chengpath.PathTrim(modulePathRaw)
    let importAlias = chengpath.PathTrim(importAliasRaw)
    if modulePath == "":
        err = " parser: malformed import"
        return false
    let sourcePath =
        ParserDirectImportSourcePathWithExternalPackageRoots(
            share(normalizedWorkspaceRoot),
            share(normalizedPackageRoot),
            externalPackageRoots,
            share(modulePath))
    let resolved = ParserSourceExists(sourcePath)
    var edge: ImportEdge
    edge.ownerProducerSourceIndex = -1
    edge.importDeclarationSourceLocalRow = -1
    edge.importItemSourceLocalRow = -1
    edge.importDeclarationRow = -1
    edge.importItemRow = -1
    edge.ownerModulePath = ParserOwnedText(ownerModulePath)
    edge.targetModulePath = ParserOwnedText(modulePath)
    edge.targetSourcePath = ParserOwnedText(sourcePath)
    edge.targetSourcePathLen = sourcePath.len
    if sourcePath == "":
        edge.targetSourcePathFirstCode = 0
        edge.targetSourcePathLastCode = 0
        edge.targetSourcePathDotCount = 0
        edge.targetSourcePathHash = 0
    else:
        edge.targetSourcePathFirstCode = Int32(sourcePath[0])
        edge.targetSourcePathLastCode = Int32(sourcePath[sourcePath.len - 1])
        edge.targetSourcePathDotCount = ParserTextLookupDotCount(sourcePath)
        edge.targetSourcePathHash = ParserTextLookupContentHash(sourcePath)
    edge.targetProfileIndex = -1
    edge.importAlias = importAlias
    edge.qualifier = ""
    let aliasText = ParserIdentPrefix(edge.importAlias)
    if aliasText != "":
        edge.qualifier = aliasText
    else:
        let sourceStem =
            ParserFileStem(ParserOwnedText(edge.targetSourcePath))
        if sourceStem != "":
            edge.qualifier = sourceStem
        else:
            edge.qualifier = ParserLastPathPiece(
                ParserOwnedText(edge.targetModulePath))
    edge.allowsUnqualifiedCall = edge.importAlias == ""
    edge.resolved = resolved
    add(edges, edge)
    err = ""
    return true

fn ParserAppendImportEdge(workspaceRoot: str,
                            packageRoot: str,
                            ownerModulePath: str,
                            modulePathRaw: str,
                            importAliasRaw: str,
                            edges: var ImportEdge[],
                            err: var str): bool =
    var externalPackageRoots: ParserExternalPackageRoot[]
    return ParserAppendImportEdgeWithExternalPackageRoots(workspaceRoot,
                                                            packageRoot,
                                                            externalPackageRoots,
                                                            ownerModulePath,
                                                            modulePathRaw,
                                                            importAliasRaw,
                                                            edges,
                                                            err)

fn ParserAppendImportEdgePreparedWithExternalPackageRoots(workspaceRoot: str,
                                                            packageRoot: str,
                                                            sharedPackageRoot: str,
                                                            packageId: str,
                                                            packagePrefix: str,
                                                            externalPackageRoots: ParserExternalPackageRoot[],
                                                            ownerModulePath: str,
                                                            modulePath: str,
                                                            importAlias: str,
                                                            edges: var ImportEdge[],
                                                            err: var str): bool =
    if modulePath == "":
        err = " parser: malformed import"
        return false
    let sourcePath = ParserModulePathToSourcePathPreparedWithExternalPackageRoots(workspaceRoot,
                                                                                    packageRoot,
                                                                                    sharedPackageRoot,
                                                                                    packageId,
                                                                                    packagePrefix,
                                                                                    externalPackageRoots,
                                                                                    modulePath)
    let resolved = ParserSourceExists(sourcePath)
    var edge: ImportEdge
    edge.ownerProducerSourceIndex = -1
    edge.importDeclarationSourceLocalRow = -1
    edge.importItemSourceLocalRow = -1
    edge.importDeclarationRow = -1
    edge.importItemRow = -1
    edge.ownerModulePath = ParserOwnedText(ownerModulePath)
    edge.targetModulePath = ParserOwnedText(modulePath)
    edge.targetSourcePath = ParserOwnedText(sourcePath)
    edge.targetSourcePathLen = sourcePath.len
    if sourcePath == "":
        edge.targetSourcePathFirstCode = 0
        edge.targetSourcePathLastCode = 0
        edge.targetSourcePathDotCount = 0
        edge.targetSourcePathHash = 0
    else:
        edge.targetSourcePathFirstCode = Int32(sourcePath[0])
        edge.targetSourcePathLastCode = Int32(sourcePath[sourcePath.len - 1])
        edge.targetSourcePathDotCount = ParserTextLookupDotCount(sourcePath)
        edge.targetSourcePathHash = ParserTextLookupContentHash(sourcePath)
    edge.targetProfileIndex = -1
    edge.importAlias = importAlias
    edge.qualifier = ""
    let aliasText = ParserIdentPrefix(edge.importAlias)
    if aliasText != "":
        edge.qualifier = aliasText
    else:
        let sourceStem =
            ParserFileStem(ParserOwnedText(edge.targetSourcePath))
        if sourceStem != "":
            edge.qualifier = sourceStem
        else:
            edge.qualifier = ParserLastPathPiece(
                ParserOwnedText(edge.targetModulePath))
    edge.allowsUnqualifiedCall = edge.importAlias == ""
    edge.resolved = resolved
    add(edges, edge)
    err = ""
    return true

fn ParserAppendImportEdgePrepared(workspaceRoot: str,
                                    packageRoot: str,
                                    sharedPackageRoot: str,
                                    packageId: str,
                                    packagePrefix: str,
                                    ownerModulePath: str,
                                    modulePath: str,
                                    importAlias: str,
                                    edges: var ImportEdge[],
                                    err: var str): bool =
    var externalPackageRoots: ParserExternalPackageRoot[]
    return ParserAppendImportEdgePreparedWithExternalPackageRoots(workspaceRoot,
                                                                    packageRoot,
                                                                    sharedPackageRoot,
                                                                    packageId,
                                                                    packagePrefix,
                                                                    externalPackageRoots,
                                                                    ownerModulePath,
                                                                    modulePath,
                                                                    importAlias,
                                                                    edges,
                                                                    err)

@borrows
fn ParserAppendImportSpec(ownerModulePathRaw: str,
                          targetModulePathRaw: str,
                          importAliasRaw: str,
                          importDeclarationSourceLocalRow: int32,
                          importItemSourceLocalRow: int32,
                          specs: var ParserImportSpec[],
                          err: var str): bool =
    let ownerModulePath = chengpath.PathTrim(share(ownerModulePathRaw))
    let targetModulePath = chengpath.PathTrim(share(targetModulePathRaw))
    let importAlias = chengpath.PathTrim(share(importAliasRaw))
    if targetModulePath == "" ||
       importDeclarationSourceLocalRow < 0 ||
       importItemSourceLocalRow < 0:
        err = " parser: malformed import"
        return false
    var spec: ParserImportSpec
    spec.ownerModulePath = ParserOwnedText(ownerModulePath)
    spec.targetModulePath = ParserOwnedText(targetModulePath)
    spec.importAlias = ParserOwnedText(importAlias)
    spec.importDeclarationSourceLocalRow =
        importDeclarationSourceLocalRow
    spec.importItemSourceLocalRow = importItemSourceLocalRow
    add(specs, spec)
    err = ""
    return true

# Syntax-only import parser.  It owns no package/world state and performs no
# source mapping, manifest lookup, CWD lookup, or filesystem existence probe.
# Edge builders below consume this same parser so grouped and `as` grammar has
# one implementation.
@borrows
fn ParserReadOneImportSpecLine(ownerModulePath: str,
                               rawLine: str,
                               importDeclarationSourceLocalRow: int32,
                               importItemSourceLocalRowBase: int32,
                               specs: var ParserImportSpec[],
                               err: var str): bool =
    var importTailStart: int32 = -1
    var importTailStop: int32 = -1
    if !ParserImportLineTailRange(rawLine, importTailStart, importTailStop):
        err = ""
        return true
    let importTail = ParserTrimmedSliceRange(rawLine,
                                              importTailStart,
                                              importTailStop)
    let asMarker = " as "
    let asPos = ParserFindText(importTail, asMarker)
    var importSpec: str
    var importAlias: str
    if asPos >= 0:
        importSpec = ParserTrimmedSliceRange(importTail, 0, asPos)
        let aliasTailStart = asPos + Len(asMarker)
        if aliasTailStart < importTail.len:
            let aliasTail = ParserTrimmedSliceRange(importTail,
                                                      aliasTailStart,
                                                      importTail.len)
            importAlias = ParserIdentPrefix(aliasTail)
    else:
        importSpec = importTail
    let groupedOpenPos = ParserFindText(importSpec, "/[")
    if groupedOpenPos >= 0:
        if importAlias != "":
            err = " parser: grouped import alias unsupported"
            return false
        let groupedClosePos = ParserFindText(importSpec, "]")
        if groupedClosePos < 0 || groupedClosePos != importSpec.len - 1:
            err = " parser: malformed grouped import"
            return false
        let groupPrefix = ParserTrimmedSliceRange(importSpec,
                                                   0,
                                                   groupedOpenPos)
        let groupItemsText = chengpath.TextSlice(
            importSpec,
            groupedOpenPos + 2,
            groupedClosePos - (groupedOpenPos + 2))
        if groupPrefix == "" || groupItemsText == "":
            err = " parser: malformed grouped import"
            return false
        var appended: bool
        var start: int32
        var itemPos: int32
        while itemPos <= Len(groupItemsText):
            let atEnd = itemPos >= Len(groupItemsText)
            var stop: bool
            if atEnd:
                stop = true
            elif groupItemsText[itemPos] == ',':
                stop = true
            if !stop:
                itemPos = itemPos + 1
                continue
            let item = ParserTrimmedSliceRange(groupItemsText, start, itemPos)
            if Len(item) > 0:
                if !ParserAppendImportSpec(
                        ParserOwnedText(ownerModulePath),
                        ParserConcat3(
                            ParserOwnedText(groupPrefix),
                            "/",
                            ParserOwnedText(item)),
                        "",
                        importDeclarationSourceLocalRow,
                        importItemSourceLocalRowBase + specs.len,
                        specs,
                        err):
                    return false
                appended = true
            start = itemPos + 1
            itemPos = itemPos + 1
        if !appended:
            err = " parser: malformed grouped import"
            return false
        err = ""
        return true
    return ParserAppendImportSpec(ownerModulePath,
                                  importSpec,
                                  importAlias,
                                  importDeclarationSourceLocalRow,
                                  importItemSourceLocalRowBase + specs.len,
                                  specs,
                                  err)

@borrows
fn ParserReadImportSpecsLines(ownerModulePath: str,
                              lines: str[],
                              specs: var ParserImportSpec[],
                              err: var str): bool =
    specs = []
    var importDeclarationSourceLocalRow: int32
    for lineIndex in 0..<lines.len:
        let itemStart = specs.len
        if !ParserReadOneImportSpecLine(
                ownerModulePath,
                lines[lineIndex],
                importDeclarationSourceLocalRow,
                0,
                specs,
                err):
            return false
        if specs.len > itemStart:
            importDeclarationSourceLocalRow =
                importDeclarationSourceLocalRow + 1
    err = ""
    return true

@borrows
fn ParserLineRangeStartsImport(text: str,
                               lineStart: int32,
                               lineEnd: int32): bool =
    if lineStart < 0 || lineEnd < lineStart || lineEnd > text.len:
        panic("parser: import line range invalid")
    var importStart = lineStart
    while importStart < lineEnd && ParserIsTrimChar(text[importStart]):
        importStart = importStart + 1
    if lineEnd - importStart < 7:
        return false
    return text[importStart] == 'i' &&
           text[importStart + 1] == 'm' &&
           text[importStart + 2] == 'p' &&
           text[importStart + 3] == 'o' &&
           text[importStart + 4] == 'r' &&
           text[importStart + 5] == 't' &&
           text[importStart + 6] == ' '

@borrows
fn ParserReadImportSpecs(ownerModulePath: str,
                         textRaw: str,
                         specs: var ParserImportSpec[],
                         err: var str): bool =
    var text: str
    if !ParserRewriteMultilineStringSourceText(textRaw, text, err):
        return false
    specs = []
    var lineStart: int32
    var lineIndex: int32
    var importDeclarationSourceLocalRow: int32
    while lineStart <= text.len:
        var lineEnd = lineStart
        while lineEnd < text.len && text[lineEnd] != '\n':
            lineEnd = lineEnd + 1
        if ParserLineRangeStartsImport(text, lineStart, lineEnd):
            let rawLine = chengpath.TextSlice(text,
                                              lineStart,
                                              lineEnd - lineStart)
            let itemStart = specs.len
            if !ParserReadOneImportSpecLine(
                    ownerModulePath,
                    rawLine,
                    importDeclarationSourceLocalRow,
                    0,
                    specs,
                    err):
                return false
            if specs.len <= itemStart:
                err = " parser: import declaration owns no item"
                return false
            importDeclarationSourceLocalRow =
                importDeclarationSourceLocalRow + 1
        if lineEnd >= text.len:
            break
        lineStart = lineEnd + 1
        lineIndex = lineIndex + 1
    err = ""
    return true

@borrows
fn ParserReadOneImportEdgeLineWithExternalPackageRoots(workspaceRoot: str,
                                                        packageRoot: str,
                                                        externalPackageRoots: ParserExternalPackageRoot[],
                                                        ownerModulePath: str,
                                                        rawLine: str,
                                                        importDeclarationSourceLocalRow: int32,
                                                        edges: var ImportEdge[],
                                                        err: var str): bool =
    var specs: ParserImportSpec[]
    let importItemSourceLocalRowBase = edges.len
    if !ParserReadOneImportSpecLine(
            ownerModulePath,
            rawLine,
            importDeclarationSourceLocalRow,
            importItemSourceLocalRowBase,
            specs,
            err):
        return false
    for specIndex in 0..<specs.len:
        let specOwnerModulePath =
            ParserOwnedText(specs[specIndex].ownerModulePath)
        let specTargetModulePath =
            ParserOwnedText(specs[specIndex].targetModulePath)
        let specImportAlias =
            ParserOwnedText(specs[specIndex].importAlias)
        if !ParserAppendImportEdgeDirectWithExternalPackageRoots(
                ParserOwnedText(workspaceRoot),
                ParserOwnedText(packageRoot),
                ParserExternalPackageRootsClone(
                    externalPackageRoots),
                specOwnerModulePath,
                specTargetModulePath,
                specImportAlias,
                edges,
                err):
            return false
        var edge = edges[edges.len - 1]
        edge.importDeclarationSourceLocalRow =
            specs[specIndex].importDeclarationSourceLocalRow
        edge.importItemSourceLocalRow =
            specs[specIndex].importItemSourceLocalRow
        edges[edges.len - 1] = edge
    err = ""
    return true

@borrows
fn ParserReadImportEdgesLinesWithExternalPackageRoots(workspaceRoot: str,
                                                        packageRoot: str,
                                                        externalPackageRoots: ParserExternalPackageRoot[],
                                                        ownerModulePath: str,
                                                        lines: str[],
                                                        edges: var ImportEdge[],
                                                        err: var str): bool =
    edges = []
    var importDeclarationSourceLocalRow: int32
    for i in 0..<lines.len:
        let itemStart = edges.len
        if !ParserReadOneImportEdgeLineWithExternalPackageRoots(
                workspaceRoot,
                packageRoot,
                externalPackageRoots,
                ownerModulePath,
                lines[i],
                importDeclarationSourceLocalRow,
                edges,
                err):
            return false
        if edges.len > itemStart:
            importDeclarationSourceLocalRow =
                importDeclarationSourceLocalRow + 1
    err = ""
    return true

@borrows
fn ParserReadImportEdgesLines(workspaceRoot: str,
                                packageRoot: str,
                                ownerModulePath: str,
                                lines: str[],
                                edges: var ImportEdge[],
                                err: var str): bool =
    var externalPackageRoots: ParserExternalPackageRoot[]
    return ParserReadImportEdgesLinesWithExternalPackageRoots(workspaceRoot,
                                                                packageRoot,
                                                                externalPackageRoots,
                                                                ownerModulePath,
                                                                lines,
                                                                edges,
                                                                err)

@borrows
fn ParserReadImportEdgesWithExternalPackageRoots(workspaceRoot: str,
                                                   packageRoot: str,
                                                   externalPackageRoots: ParserExternalPackageRoot[],
                                                   ownerModulePath: str,
                                                   textRaw: str,
                                                   edges: var ImportEdge[],
                                                   err: var str): bool =
    let ownedWorkspaceRoot = ParserOwnedText(workspaceRoot)
    let ownedPackageRoot = ParserOwnedText(packageRoot)
    let ownedExternalPackageRoots =
        ParserExternalPackageRootsClone(externalPackageRoots)
    let ownedOwnerModulePath = ParserOwnedText(ownerModulePath)
    let ownedTextRaw = ParserOwnedText(textRaw)
    var text: str
    if !ParserRewriteMultilineStringSourceText(ownedTextRaw, text, err):
        return false
    edges = []
    var lineStart: int32
    var lineIndex: int32
    var importDeclarationSourceLocalRow: int32
    while lineStart <= text.len:
        var lineEnd = lineStart
        while lineEnd < text.len && text[lineEnd] != '\n':
            lineEnd = lineEnd + 1
        if ParserLineRangeStartsImport(text, lineStart, lineEnd):
            let rawLine = chengpath.TextSlice(text,
                                              lineStart,
                                              lineEnd - lineStart)
            if !ParserReadOneImportEdgeLineWithExternalPackageRoots(
                    ParserOwnedText(ownedWorkspaceRoot),
                    ParserOwnedText(ownedPackageRoot),
                    ParserExternalPackageRootsClone(
                        ownedExternalPackageRoots),
                    ParserOwnedText(ownedOwnerModulePath),
                    rawLine,
                    importDeclarationSourceLocalRow,
                    edges,
                    err):
                return false
            importDeclarationSourceLocalRow =
                importDeclarationSourceLocalRow + 1
        if lineEnd >= text.len:
            break
        lineStart = lineEnd + 1
        lineIndex = lineIndex + 1
    err = ""
    return true

fn ParserReadImportEdges(workspaceRoot: str,
                           packageRoot: str,
                           ownerModulePath: str,
                           textRaw: str,
                           edges: var ImportEdge[],
                           err: var str): bool =
    var externalPackageRoots: ParserExternalPackageRoot[]
    return ParserReadImportEdgesWithExternalPackageRoots(workspaceRoot,
                                                           packageRoot,
                                                           externalPackageRoots,
                                                           ownerModulePath,
                                                           textRaw,
                                                           edges,
                                                           err)

fn ImportEdgeTargetSourcePath(edge: ImportEdge): str =
    return edge.targetSourcePath

fn ParserAddUniqueImportEdge(edges: var ImportEdge[],
                               edge: ImportEdge) =
    if edge.ownerProducerSourceIndex < 0 ||
       edge.importDeclarationSourceLocalRow < 0 ||
       edge.importItemSourceLocalRow < 0:
        panic("parser: import edge exact origin missing")
    for i in 0..<edges.len:
        if edges[i].ownerProducerSourceIndex !=
               edge.ownerProducerSourceIndex ||
           edges[i].importDeclarationSourceLocalRow !=
               edge.importDeclarationSourceLocalRow ||
           edges[i].importItemSourceLocalRow !=
               edge.importItemSourceLocalRow:
            continue
        return
    add(edges, edge)

@borrows
fn ParserBindImportEdgeOriginRows(
        edges: var ImportEdge[],
        tree: ParserValueExprTree,
        sourcePaths: str[],
        ownerModulePaths: str[],
        err: var str): bool =
    if tree == nil ||
       tree.lifecycleState != ParserValueExprOwnerActive ||
       tree.importOrigins == nil ||
       sourcePaths.len <= 0 ||
       sourcePaths.len != ownerModulePaths.len ||
       tree.producerSourceCount != sourcePaths.len:
        err = "parser: import edge origin owner unavailable"
        return false
    let origins = tree.importOrigins
    if edges.len != origins.itemCount:
        err = "parser: import edge origin coverage mismatch"
        return false
    var usedItems: bool[]
    setLen(usedItems, origins.itemCount)
    for edgeIndex in 0..<edges.len:
        var edge = edges[edgeIndex]
        if edge.ownerProducerSourceIndex < 0 ||
           edge.ownerProducerSourceIndex >= sourcePaths.len ||
           edge.importDeclarationSourceLocalRow < 0 ||
           edge.importItemSourceLocalRow < 0 ||
           edge.importDeclarationRow != -1 ||
           edge.importItemRow != -1 ||
           edge.ownerModulePath !=
               ownerModulePaths[edge.ownerProducerSourceIndex]:
            err = "parser: import edge source-local identity invalid"
            return false
        var importItemRow = -1
        for candidateRow in 0..<origins.itemCount:
            if arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   origins.itemProducerSourceIndexes,
                   candidateRow) != edge.ownerProducerSourceIndex ||
               arenamod.ArenaArrayInt32Get(
                   tree.arena,
                   origins.itemSourceLocalRows,
                   candidateRow) != edge.importItemSourceLocalRow:
                continue
            if importItemRow >= 0:
                err = "parser: import edge item row ambiguous"
                return false
            importItemRow = candidateRow
        if importItemRow < 0 || usedItems[importItemRow]:
            err = "parser: import edge item row missing"
            return false
        let importDeclarationRow =
            arenamod.ArenaArrayInt32Get(
                tree.arena,
                origins.itemDeclarationRows,
                importItemRow)
        if importDeclarationRow < 0 ||
           importDeclarationRow >= origins.declarationCount ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               origins.declarationProducerSourceIndexes,
               importDeclarationRow) != edge.ownerProducerSourceIndex ||
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               origins.declarationSourceLocalRows,
               importDeclarationRow) !=
               edge.importDeclarationSourceLocalRow:
            err = "parser: import edge declaration row mismatch"
            return false
        let targetProducerSourceIndex = edge.targetProfileIndex
        if targetProducerSourceIndex < 0 ||
           targetProducerSourceIndex >= ownerModulePaths.len ||
           sourcePaths[targetProducerSourceIndex] !=
               edge.targetSourcePath ||
           ownerModulePaths[targetProducerSourceIndex] !=
               edge.targetModulePath:
            err = "parser: import edge target row missing"
            return false
        usedItems[importItemRow] = true
        edge.importDeclarationRow = importDeclarationRow
        edge.importItemRow = importItemRow
        edges[edgeIndex] = edge
    for itemRow in 0..<usedItems.len:
        if !usedItems[itemRow]:
            err = "parser: import edge origin item unconsumed"
            return false
    err = ""
    return true

@borrows
fn ParserAddUniqueText(items: var str[],
                         text: str) =
    let value = chengpath.PathTrim(text)
    ParserAddUniqueTextExact(items, value)

@borrows
fn ParserAddUniqueTextExact(items: var str[],
                              value: str) =
    if value == "":
        return
    for i in 0..<items.len:
        if ParserTextEqualsExact(items[i], value):
            return
    add(items, strings.CloneStr(value))

@borrows
fn ParserCollectClosureWithExternalPackageRoots(workspaceRoot: str,
                                                  packageRoot: str,
                                                  externalPackageRoots: ParserExternalPackageRoot[],
                                                  sourcePathRaw: str,
                                                  seen: var str[],
                                                  ordered: var str[],
                                                  importEdges: var ImportEdge[],
                                                  unresolved: var int32,
                                                  err: var str): bool =
    ParserTraceStage("collect_closure_enter")
    var newSeen: str[]
    var newOrdered: str[]
    var newImportEdges: ImportEdge[]
    unresolved = 0
    let sourcePath: str = chengpath.PathTrim(ParserOwnedText(sourcePathRaw))
    ParserTraceStage("collect_closure_after_source_trim")
    if sourcePath == "":
        err = " parser: missing closure source path"
        seen = newSeen
        ordered = newOrdered
        importEdges = newImportEdges
        return false
    if !ParserSourceExistsWithExternalPackageRoots(sourcePath,
                                                    externalPackageRoots):
        err = " parser: missing source"
        seen = newSeen
        ordered = newOrdered
        importEdges = newImportEdges
        return false
    add(newSeen, ParserOwnedText(sourcePath))
    add(newOrdered, ParserOwnedText(sourcePath))
    var seenCount: int32 = 1
    var scanPos: int32
    while scanPos < newOrdered.len:
        ParserTraceStage("collect_closure_loop_top")
        let currentSourcePath = newOrdered[scanPos]
        scanPos = scanPos + 1
        ParserTraceStage("collect_closure_before_read")
        var rawText: str
        var readErr: str
        if !ParserSourceTextWithExternalPackageRootsInto(
                currentSourcePath,
                externalPackageRoots,
                rawText,
                readErr):
            err = readErr
            seen = newSeen
            ordered = newOrdered
            importEdges = newImportEdges
            return false
        ParserTraceStage("collect_closure_after_read")
        let ownerModulePath = ParserSourcePathToModulePathWithExternalPackageRoots(workspaceRoot,
                                                                                     packageRoot,
                                                                                     externalPackageRoots,
                                                                                     currentSourcePath)
        ParserTraceStage("collect_closure_after_owner_module")
        var edges: ImportEdge[]
        var edgeErr: str
        ParserTraceStage("collect_closure_before_import_edges")
        if !ParserReadImportEdgesWithExternalPackageRoots(workspaceRoot,
                                                          packageRoot,
                                                          externalPackageRoots,
                                                          ownerModulePath,
                                                          rawText,
                                                          edges,
                                                          edgeErr):
            err = edgeErr
            seen = newSeen
            ordered = newOrdered
            importEdges = newImportEdges
            return false
        ParserTraceStage("collect_closure_after_import_edges")
        for i in 0..<edges.len:
            ParserTraceStage("collect_closure_edge_loop_top")
            var edge = edges[i]
            edge.ownerProducerSourceIndex = scanPos - 1
            let childSourcePath = edge.targetSourcePath
            if childSourcePath == "" ||
               !ParserSourceExistsWithExternalPackageRoots(
                    childSourcePath,
                    externalPackageRoots):
                edge.targetProfileIndex = -1
                ParserAddUniqueImportEdge(newImportEdges, edge)
                unresolved = unresolved + 1
            else:
                var targetProducerSourceIndex = -1
                for seenIndex in 0..<seenCount:
                    if ParserTextEqualsExact(newSeen[seenIndex], childSourcePath):
                        targetProducerSourceIndex = seenIndex
                        break
                if targetProducerSourceIndex < 0:
                    targetProducerSourceIndex = seenCount
                    add(newSeen, ParserOwnedText(childSourcePath))
                    add(newOrdered, ParserOwnedText(childSourcePath))
                    seenCount = seenCount + 1
                edge.targetProfileIndex = targetProducerSourceIndex
                ParserAddUniqueImportEdge(newImportEdges, edge)
    seen = newSeen
    ordered = newOrdered
    importEdges = newImportEdges
    err = ""
    return true

fn ParserCollectClosure(workspaceRoot: str,
                          packageRoot: str,
                          sourcePathRaw: str,
                          seen: var str[],
                          ordered: var str[],
                          importEdges: var ImportEdge[],
                          unresolved: var int32,
                          err: var str): bool =
    var externalPackageRoots: ParserExternalPackageRoot[]
    return ParserCollectClosureWithExternalPackageRoots(workspaceRoot,
                                                          packageRoot,
                                                          externalPackageRoots,
                                                          sourcePathRaw,
                                                          seen,
                                                          ordered,
                                                          importEdges,
                                                          unresolved,
                                                          err)

@borrows
fn ParserReadNormalizedExprLayerForSourceClosureWithExternalPackageRoots(workspaceRoot: str,
                                                                           packageRoot: str,
                                                                           externalPackageRoots: ParserExternalPackageRoot[],
                                                                           ordered: str[],
                                                                           exprLayer: var NormalizedExprLayer,
                                                                           err: var str): bool =
    var priorReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
    NormalizedExprLayerTerminalReleaseWithReceipt(
        exprLayer, priorReleaseReceipt)
    var sourceProfiles: NormalizedExprCallProfile[]
    for i in 0..<ordered.len:
        var sourceText: str
        if !ParserSourceTextWithExternalPackageRootsInto(
                ordered[i],
                externalPackageRoots,
                sourceText,
                err):
            var failureReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
            NormalizedExprLayerTerminalReleaseWithReceipt(
                exprLayer, failureReleaseReceipt)
            return false
        var profile: NormalizedExprCallProfile
        var profileErr = ""
        if !ParserBuildExprCallProfileWithExternalPackageRoots(workspaceRoot,
                                                                 packageRoot,
                                                                 externalPackageRoots,
                                                                 ordered[i],
                                                                 sourceText,
                                                                 profile,
                                                                 profileErr):
            err = profileErr
            var failureReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
            NormalizedExprLayerTerminalReleaseWithReceipt(
                exprLayer, failureReleaseReceipt)
            return false
        add(sourceProfiles, profile)
    var profileIndexLookup = ParserSourcePathIndexLookupBuild(sourceProfiles)
    ParserBindImportEdgeTargetProfileIndices(sourceProfiles, profileIndexLookup)
    var externalVisibleNameCache: ParserTextSeqCacheEntry[]
    var externalQualifiedNameCache: ParserQualifiedTextSeqCacheEntry[]
    var profileCallLookupCache: ParserProfileCallLookupCacheEntry[]
    for i in 0..<sourceProfiles.len:
        if os.GetEnv("CHENG_TRACE_PARSE_SOURCE") == "1":
            os.WriteLine(os.Get_stdout(), strutil.Join(["parse_source ", ParserOwnedText(sourceProfiles[i].sourcePath)], ""))
        var sourceExprLayer = NormalizedExprLayer()
        var sourceExternalCallNames: str[]
        ParserCollectExternalCallNamesCached(sourceProfiles,
                                               profileIndexLookup,
                                               i,
                                               externalVisibleNameCache,
                                               externalQualifiedNameCache,
                                               sourceExternalCallNames)
        var ownedSourcePath: str
        var ownedText: str
        var ownedImportcCallNames: str[]
        var ownedLocalCallNames: str[]
        ParserOwnedExprLayerReadInputsFromSourceProfile(
            sourceProfiles,
            i,
            ownedSourcePath,
            ownedText,
            ownedImportcCallNames,
            ownedLocalCallNames)
        if !ParserReadNormalizedExprLayerFromTextWithKnownCallsAndProfilesCached(ownedSourcePath,
                                                                                  ownedText,
                                                                                  ownedImportcCallNames,
                                                                                  ownedLocalCallNames,
                                                                                  sourceExternalCallNames,
                                                                                  i,
                                                                                  sourceProfiles,
                                                                                  profileIndexLookup,
                                                                                  profileCallLookupCache,
                                                                                  sourceExprLayer,
                                                                                  err):
            err = ParserConcat4(" parser: ", ownedSourcePath, ": ", err)
            var sourceFailureReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
            NormalizedExprLayerTerminalReleaseWithReceipt(
                sourceExprLayer, sourceFailureReleaseReceipt)
            var aggregateFailureReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
            NormalizedExprLayerTerminalReleaseWithReceipt(
                exprLayer, aggregateFailureReleaseReceipt)
            return false
        NormalizedExprLayerAdd(exprLayer, sourceExprLayer)
        var sourceReleaseReceipt: NormalizedExprLayerTerminalReleaseReceipt
        NormalizedExprLayerTerminalReleaseWithReceipt(
            sourceExprLayer, sourceReleaseReceipt)
    err = ""
    return true

@borrows
fn ParseOrdinarySourceStubCoreWithExternalPackageRoots(packageRootRaw: str,
                                                        sourcePathRaw: str,
                                                        externalPackageRoots: ParserExternalPackageRoot[],
                                                      buildExprLayer: bool,
                                                      parsed: var ParsedSourceStub,
                                                      err: var str): bool =
    ParserDebugStage("stub_core_enter")
    ParserTraceStage("parse_stub_enter")
    let packageRoot: str = ParserNormalizePath(packageRootRaw)
    ParserDebugStage("stub_core_after_package_root_normalize")
    let sourcePath: str = ParserNormalizePath(sourcePathRaw)
    ParserDebugStage("stub_core_after_source_path_normalize")
    ParserTraceStage("parse_stub_after_normalize")
    var ownedActivePackageRoot = ParserOwnedText(packageRoot)
    parserActivePackageRoot = ownedActivePackageRoot
    ParserDebugStage("stub_core_after_active_package_root")
    if len(sourcePath) <= 0:
        err = " parser: missing source path"
        return false
    ParserDebugStage("stub_core_after_source_nonempty")
    let workspaceRoot: str = ParserWorkspaceRoot(packageRoot)
    let packageId: str = ParserPackageId(packageRoot)
    let moduleStem: str = ParserSourcePathToModulePathWithExternalPackageRoots(workspaceRoot,
                                                                                 packageRoot,
                                                                                 externalPackageRoots,
                                                                                 sourcePath)
    ParserDebugStage("stub_core_after_static_fields")
    ParserTraceStage("parse_stub_before_read_root")
    var rawRootText: str
    if !ParserSourceTextWithExternalPackageRootsInto(
            sourcePath,
            externalPackageRoots,
            rawRootText,
            err):
        return false
    ParserDebugStage("stub_core_after_read_root_raw")
    ParserDebugStage("stub_core_after_owned_text")
    ParserTraceStage("parse_stub_after_read_root")
    var rootText: str
    ParserDebugStage("stub_core_after_root_text_var")
    ParserTraceStage("parse_stub_before_multiline_rewrite")
    if !ParserRewriteMultilineStringSourceText(
           rawRootText, rootText, err):
        return false
    ParserTraceStage("parse_stub_after_multiline_rewrite")
    ParserDebugStage("stub_core_after_multiline_check")
    if !buildExprLayer:
        ParserDebugStage("stub_core_header_fast_path_enter")
        var mainPresent = false
        if rootText.len >= 7:
            for scan in 0..rootText.len - 7:
                if rootText[scan] == 'f' &&
                   rootText[scan + 1] == 'n' &&
                   rootText[scan + 2] == ' ' &&
                   rootText[scan + 3] == 'm' &&
                   rootText[scan + 4] == 'a' &&
                   rootText[scan + 5] == 'i' &&
                   rootText[scan + 6] == 'n':
                    mainPresent = true
                    break
        ParserDebugStage("stub_core_header_fast_path_after_main_scan")
        var ordered: str[]
        add(ordered, share(sourcePath))
        var ownerModulePaths: str[]
        add(ownerModulePaths, share(moduleStem))
        var importEdges: ImportEdge[]
        var exprLayer = NormalizedExprLayer()
        parsed.workspaceRoot = workspaceRoot
        parsed.packageRoot = packageRoot
        parsed.packageId = packageId
        parsed.entrySourcePath = share(sourcePath)
        parsed.sourcePath = sourcePath
        parsed.moduleStem = moduleStem
        parsed.syntaxTag = "cheng_normalized_source"
        parsed.sourceKind = ParsedOrdinarySource
        parsed.ownerModulePaths = ownerModulePaths
        parsed.importEdges = importEdges
        parsed.orderedClosureSourcePaths = ordered
        parsed.normalizedExprLayer = exprLayer
        parsed.hasCompilerTopLevel = mainPresent
        parsed.mainFunctionPresent = mainPresent
        parsed.unresolvedImportCount = 0
        err = ""
        ParserDebugStage("stub_core_header_fast_path_done")
        return true
    ParserDebugStage("stub_core_after_root_text_nonempty")
    ParserTraceStage("parse_stub_before_root_decls")
    var rootLines: str[]
    ParserSplitCharInto(rootText, '\n', rootLines)
    ParserDebugStage("stub_core_after_root_split")
    if rootLines.len > 0:
        let firstRootLine = rootLines[0]
        if len(firstRootLine) >= 0:
            ParserDebugStage("stub_core_after_root_line_access")
    let rootDecls = ParserReadNormalizedFunctionDeclsLinesValue(rootLines, err)
    ParserDebugStage("stub_core_after_root_decls_value")
    ParserTraceStage("parse_stub_after_root_decls")
    if err != "":
        return false
    var seen: str[]
    var ordered: str[]
    var importEdges: ImportEdge[]
    var unresolved: int32
    ParserTraceStage("parse_stub_before_collect_closure")
    if !ParserCollectClosureWithExternalPackageRoots(workspaceRoot,
                                                       packageRoot,
                                                       externalPackageRoots,
                                                       sourcePath,
                                                       seen,
                                                       ordered,
                                                       importEdges,
                                                       unresolved,
                                                       err):
        return false
    ParserTraceStage("parse_stub_after_collect_closure")
    var exprLayer = NormalizedExprLayer()
    if buildExprLayer:
        ParserTraceStage("parse_stub_before_expr_layer")
        if !ParserReadNormalizedExprLayerForSourceClosureWithExternalPackageRoots(workspaceRoot,
                                                                                   packageRoot,
                                                                                   externalPackageRoots,
                                                                                   ordered,
                                                                                   exprLayer,
                                                                                   err):
            return false
        ParserTraceStage("parse_stub_after_expr_layer")
    var ownerModulePaths: str[]
    ParserTraceStage("parse_stub_before_owner_modules")
    for i in 0..<ordered.len:
        ParserAddUniqueText(ownerModulePaths,
                              ParserSourcePathToModulePathWithExternalPackageRoots(workspaceRoot,
                                                                                    packageRoot,
                                                                                    externalPackageRoots,
                                                                                    ordered[i]))
    ParserTraceStage("parse_stub_after_owner_modules")
    if !ParserBindImportEdgeOriginRows(
            importEdges,
            exprLayer.valueExprTree,
            ordered,
            ownerModulePaths,
            err):
        return false
    parsed.workspaceRoot = workspaceRoot
    parsed.packageRoot = packageRoot
    parsed.packageId = packageId
    parsed.entrySourcePath = share(sourcePath)
    parsed.sourcePath = sourcePath
    parsed.moduleStem = moduleStem
    parsed.syntaxTag = "cheng_normalized_source"
    parsed.sourceKind = ParsedOrdinarySource
    parsed.ownerModulePaths = ownerModulePaths
    parsed.importEdges = importEdges
    parsed.orderedClosureSourcePaths = ordered
    parsed.normalizedExprLayer = exprLayer
    parsed.hasCompilerTopLevel = ParserHasCompilerTopLevel(rootText)
    parsed.mainFunctionPresent = false
    for i in 0..<rootDecls.len:
        if rootDecls[i].importc:
            continue
        if rootDecls[i].name == "main":
            parsed.mainFunctionPresent = true
    parsed.unresolvedImportCount = unresolved
    ParserTraceStage("parse_stub_done")
    err = ""
    return true

@borrows
fn ParseOrdinarySourceHeaderStubCoreNoExternalPackageRoots(packageRootRaw: str,
                                                          sourcePathRaw: str,
                                                          parsed: var ParsedSourceStub,
                                                          err: var str): bool =
    ParserDebugStage("header_core_enter")
    let packageRoot: str = ParserNormalizePath(packageRootRaw)
    let sourcePath: str = ParserNormalizePath(sourcePathRaw)
    var ownedActivePackageRoot = ParserOwnedText(packageRoot)
    parserActivePackageRoot = ownedActivePackageRoot
    if len(sourcePath) <= 0:
        err = " parser: missing source path"
        return false
    let workspaceRoot: str = ParserWorkspaceRoot(packageRoot)
    let packageId: str = ParserPackageId(packageRoot)
    let moduleStem: str = ParserSourcePathToModulePath(workspaceRoot, packageRoot, sourcePath)
    let rawRootTextRaw = chengpath.PathReadTextFileWithHandle(sourcePath)
    let rootText: str = ParserOwnedText(rawRootTextRaw)
    ParserDebugStage("header_core_after_read")
    var mainPresent = false
    if rootText.len >= 7:
        for scan in 0..rootText.len - 7:
            if rootText[scan] == 'f' &&
               rootText[scan + 1] == 'n' &&
               rootText[scan + 2] == ' ' &&
               rootText[scan + 3] == 'm' &&
               rootText[scan + 4] == 'a' &&
               rootText[scan + 5] == 'i' &&
               rootText[scan + 6] == 'n':
                mainPresent = true
                break
    ParserDebugStage("header_core_after_main_scan")
    var ordered: str[]
    add(ordered, share(sourcePath))
    ParserDebugStage("header_core_after_ordered_singleton")
    var ownerModulePaths: str[]
    var importEdges: ImportEdge[]
    var exprLayer = NormalizedExprLayer()
    ParserDebugStage("header_core_after_empty_fields")
    parsed.workspaceRoot = workspaceRoot
    parsed.packageRoot = packageRoot
    parsed.packageId = packageId
    parsed.entrySourcePath = share(sourcePath)
    parsed.sourcePath = sourcePath
    parsed.moduleStem = moduleStem
    parsed.syntaxTag = "cheng_normalized_source"
    parsed.sourceKind = ParsedOrdinarySource
    parsed.ownerModulePaths = ownerModulePaths
    parsed.importEdges = importEdges
    parsed.orderedClosureSourcePaths = ordered
    parsed.normalizedExprLayer = exprLayer
    parsed.hasCompilerTopLevel = mainPresent
    parsed.mainFunctionPresent = mainPresent
    parsed.unresolvedImportCount = 0
    err = ""
    ParserDebugStage("header_core_done")
    return true

@borrows
fn ParseOrdinarySourceHeaderStubNoExternalPackageRoots(packageRootRaw: str,
                                                       sourcePathRaw: str,
                                                       parsed: var ParsedSourceStub,
                                                       err: var str): bool =
    ParserDebugStage("header_no_external_wrapper_enter")
    return ParseOrdinarySourceHeaderStubCoreNoExternalPackageRoots(packageRootRaw,
                                                                  sourcePathRaw,
                                                                  parsed,
                                                                  err)

@borrows
fn ParseOrdinarySourceHeaderStubWithExternalPackageRoots(packageRootRaw: str,
                                                          sourcePathRaw: str,
                                                          externalPackageRoots: ParserExternalPackageRoot[],
                                                          parsed: var ParsedSourceStub,
                                                          err: var str): bool =
    ParserDebugStage("header_wrapper_enter")
    externalPackageRoots
    return ParseOrdinarySourceHeaderStubCoreNoExternalPackageRoots(packageRootRaw,
                                                                  sourcePathRaw,
                                                                  parsed,
                                                                  err)

@borrows
fn ParseOrdinarySourceStubWithExternalPackageRoots(packageRootRaw: str,
                                                     sourcePathRaw: str,
                                                     externalPackageRoots: ParserExternalPackageRoot[],
                                                     parsed: var ParsedSourceStub,
                                                     err: var str): bool =
    let buildExprLayer = true
    return ParseOrdinarySourceStubCoreWithExternalPackageRoots(packageRootRaw,
                                                                sourcePathRaw,
                                                                externalPackageRoots,
                                                                buildExprLayer,
                                                                parsed,
                                                                err)

@borrows
fn ParseOrdinarySourceStub(packageRootRaw: str,
                             sourcePathRaw: str,
                             parsed: var ParsedSourceStub,
                             err: var str): bool =
    var externalPackageRoots: ParserExternalPackageRoot[]
    return ParseOrdinarySourceStubWithExternalPackageRoots(packageRootRaw,
                                                             sourcePathRaw,
                                                             externalPackageRoots,
                                                             parsed,
                                                             err)
