# B2 候选 — typed_expr 上游建 rhsNodeIndex (ghost-with-dead-wire).
#
# Status: SCAFFOLD / GHOST-WITH-DEAD-WIRE (lesson e4550c1b5 applied).
# Env gate CHENG_TYPED_EXPR_RHS_NODE_INDEX_BUILD=1 default off.
#
# Design source: bail=44 子根因 — stmt.rhsNodeIndex=-1 致 r3DrillCallNode=-1
# (commit f978f9be1 docs lock-in). 当前 backend primary_object_plan.cheng
# :18514 r3DrillCallNode = stmt.rhsNodeIndex 时若值为 -1, R3 drill 无法
# 顺 operand0 链到真 CallExpr → PrimaryBodyIrStatementCallArgNodeIndexAt
# 查不到 indexed-member arg 节点 → 落 bail=44 poison.
#
# Companion: 上游 typed_expr 在构造 TypedExprIrStatement 时, 对含
# indexed-member arg 的 let_call (var x = foo(arr[i].field)) 显式填
# stmt.rhsNodeIndex = callNode 的 node index. 让 backend R3 drill 看到
# 非 -1 起点, 顺链找到 CallExpr 再取 arg.
#
# Algorithm (dry-run simulation, P3-ghost):
#   1. 检查 stmt.kind ∈ {LetCall, Call, IfCall} — 只这三类有 callNode.
#   2. 检查 callNode.opKind ∈ {CallExpr, LogNot, Neg} — Neg/LogNot 可包
#      CallExpr (drill 兼容). 非这三类记 skippedKind++.
#   3. 检查 stmt.rhsNodeIndex 当前值 — 若 >= 0 记 alreadyHasRhsIndex++
#      (无需修, 跳过); 若 == -1 进入候选检查.
#   4. 浅检查 callNode operand0/1/2 — 若其中任一指向有效 node index
#      (>= 0), 视作含 arg 表达式 → wouldBuildRhsIndex++ (真 P4 apply
#      把 stmt.rhsNodeIndex 写成 callNode.nodeIndex).
#   5. 若所有 operand 都 < 0, 记 noOperandArgs++.
#
# Real apply (P4 cross-session): 在 TypedExprBuildIrFromExprLayer 的
# let_call/call 路径里, 检测 stmt.rhsNodeIndex == -1 且 callNode 真存在
# 时, 把 stmt.rhsNodeIndex 设成 callNode 的 node index. 让 backend
# R3 drill 看到非 -1 起点, 顺链找到 CallExpr 再取 arg → bail=44 解.
#
# Wiring plan (P4+):
#   1. lowering_plan dead-wire (本提交) 把模块拉进 cold compiler 闭包.
#   2. TypedExprBuildIrFromExprLayer (typed_expr.cheng:22955) 在写
#      stmt.rhsNodeIndex 之前 env-gate 调用 BuildRhsNodeIndexForIndexedMemberArg
#      统计候选数; P5 落真 mutation (var stmt 真改).
#   3. bail=44 census 降到 0 → bootstrap fp 漂 → §12.2 cross-session baseline.

import cheng/core/lang/typed_expr as texpr
import std/os
import std/strings

type
    RhsNodeIndexBuildResult =
        inspectedStmts: int32
        skippedKind: int32
        alreadyHasRhsIndex: int32
        wouldBuildRhsIndex: int32
        noOperandArgs: int32

fn TypedExprRhsNodeIndexCallNodeKindCandidate(opKind: texpr.TypedExprIrOpKind): bool =
    if opKind == texpr.TypedExprIrOpCallExpr:
        return true
    if opKind == texpr.TypedExprIrOpLogNot:
        return true
    if opKind == texpr.TypedExprIrOpNeg:
        return true
    return false

fn TypedExprRhsNodeIndexStmtKindCandidate(kind: texpr.TypedExprIrStatementKind): bool =
    if kind == texpr.TypedExprIrStmtLetCall:
        return true
    if kind == texpr.TypedExprIrStmtCall:
        return true
    if kind == texpr.TypedExprIrStmtIfCall:
        return true
    return false

fn TypedExprBuildRhsNodeIndexForIndexedMemberArg(stmt: var texpr.TypedExprIrStatement,
                                                   callNode: texpr.TypedExprIrNode): RhsNodeIndexBuildResult =
    var result: RhsNodeIndexBuildResult
    result.inspectedStmts = 1
    result.skippedKind = 0
    result.alreadyHasRhsIndex = 0
    result.wouldBuildRhsIndex = 0
    result.noOperandArgs = 0

    if !TypedExprRhsNodeIndexStmtKindCandidate(stmt.kind):
        result.skippedKind = 1
        return result
    if !TypedExprRhsNodeIndexCallNodeKindCandidate(callNode.opKind):
        result.skippedKind = 1
        return result

    if stmt.rhsNodeIndex >= 0:
        result.alreadyHasRhsIndex = 1
        return result

    var hasOperand = false
    if callNode.operand0NodeIndex >= 0:
        hasOperand = true
    elif callNode.operand1NodeIndex >= 0:
        hasOperand = true
    elif callNode.operand2NodeIndex >= 0:
        hasOperand = true

    if hasOperand:
        # P3 dry-run: real P4 apply would set
        #   stmt.rhsNodeIndex = callNode.nodeIndex
        # so backend R3 drill (primary_object_plan.cheng:18514) sees a
        # non-(-1) start and can walk operand0 chain to the real CallExpr.
        result.wouldBuildRhsIndex = 1
    else:
        result.noOperandArgs = 1
        # P1 producer (early gate): callNode 无 operand = receiver chain 空
        # (indexed-member arg 在节点路径丢失最常见的根因) — 写 stmt.rhsBailReason
        # 直接 (stmt 是 var-param).  注意只在 rhsBailReason 当前为 None 时
        # 覆盖, 避免压住已有更精确的 root cause.  Consumer (dispatch_min
        # 1808/4127 + FAIL_TRACE 4 站) 据此能区分 "receiver chain 缺失"
        # 与一般 WholeCallNoTrace.
        if stmt.rhsBailReason == texpr.RhsBailNone:
            stmt.rhsBailReason = texpr.RhsBailReceiverChainEmpty

    let _gate = os.GetEnv("CHENG_TYPED_EXPR_RHS_NODE_INDEX_BUILD")
    if _gate == "1":
        var _line: str = "[typed-expr-rhs-node-index-build] inspected="
        _line = _line + strings.IntToStr(result.inspectedStmts)
        _line = _line + " skipped_kind="
        _line = _line + strings.IntToStr(result.skippedKind)
        _line = _line + " already_has="
        _line = _line + strings.IntToStr(result.alreadyHasRhsIndex)
        _line = _line + " would_build="
        _line = _line + strings.IntToStr(result.wouldBuildRhsIndex)
        _line = _line + " no_operand="
        _line = _line + strings.IntToStr(result.noOperandArgs)
        # P1 consumer (dry-run consistency check): 把 noOperandArgs=1 映回
        # RhsBailReceiverChainEmpty, 与早 gate (line:106) 的 producer 一致
        # 性校验.  Via texpr helper (15-case): env-gated stderr only, 0
        # 控制流改动.
        _line = _line + " rhs_bail_label="
        _line = _line + texpr.TypedExprIrRhsBailReasonLabel(stmt.rhsBailReason)
        os.WriteLine(os.GetStderr(), _line)

    return result

fn TypedExprBuildRhsNodeIndexResultWouldBuild(result: RhsNodeIndexBuildResult): int32 =
    return result.wouldBuildRhsIndex

fn TypedExprBuildRhsNodeIndexResultAlreadyHas(result: RhsNodeIndexBuildResult): int32 =
    return result.alreadyHasRhsIndex

fn TypedExprBuildRhsNodeIndexResultSkippedKind(result: RhsNodeIndexBuildResult): int32 =
    return result.skippedKind
