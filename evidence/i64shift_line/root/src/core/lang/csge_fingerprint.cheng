# csge_fingerprint — csg_e 跨文件增量化 spec Commit B: 内容/接口指纹纯值层。
# spec: docs/beat-c-csge-incremental-spec.md §2.1 (L0 sourceContentHash / L1
# sourceInterfaceHash) + §2.4 (编解码器规模参照 backend2_frag_codec.cheng)。
#
# 铁律 (镜像 backend2_cid.cheng 头注): 纯函数, 零编译器状态, 不 import
# typed_expr.cheng / compiler_csg.cheng (单向依赖, typed_expr.cheng 调用本文件,
# 反向 import 会成环)。域隔离字节编码 (LE 长度前缀框架, 消 concat 歧义)。
#
# 排序: sourceInterfaceHash 的每组输入 (函数签名/类型字段/枚举值/importc/import
# 边/module const) 在哈希前排序, 消除 Phase M 扫描顺序扰动 (spec §2.1 "排序后的")。

import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

fn CsgeFingerprintAppendU32(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)

@borrows
fn CsgeFingerprintAppendText(buf: var layout.ByteBuf, text: str) =
    CsgeFingerprintAppendU32(buf, len(text))
    for i in 0..<len(text):
        layout.ByteBufAppendByte(buf, text[i])

# 一行的多个字段各自长度前缀后拼接成一个 token: 无歧义 (逐字段自描述长度),
# 可直接当排序键使用 (不需要另外的行内分隔符)。
fn CsgeFingerprintRowToken(fields: str[]): str =
    var buf: layout.ByteBuf = layout.ByteBufInit(64)
    for i in 0..<fields.len:
        CsgeFingerprintAppendText(buf, fields[i])
    var encoded = layout.ByteBufToBytes(buf)
    let token = rawbytes.BytesToString(encoded)
    rawbytes.BytesFree(encoded)
    layout.ByteBufFree(buf)
    return token

@borrows
fn csgeFingerprintStrLess(a: str, b: str): bool =
    var n = len(a)
    if len(b) < n:
        n = len(b)
    for i in 0..<n:
        let ca = int32(a[i]) & 255
        let cb = int32(b[i]) & 255
        if ca != cb:
            return ca < cb
    return len(a) < len(b)

# 插入排序 (镜像 backend2_cid.cheng Backend2SortStrings — 域是单 source 的声明面
# 行集合, N 小, 决定性, 不带比较器依赖)。
@borrows
fn CsgeFingerprintSortRows(rows: str[]): str[] =
    var out: str[]
    for i in 0..<rows.len:
        add(out, strings.CloneStr(rows[i]))
    for i in 1..<out.len:
        var j = i
        while j > 0 && csgeFingerprintStrLess(out[j], out[j - 1]):
            let tmp = strings.CloneStr(out[j - 1])
            out[j - 1] = strings.CloneStr(out[j])
            out[j] = tmp
            j = j - 1
    return out

fn CsgeFingerprintNewBuf(): layout.ByteBuf =
    return layout.ByteBufInit(256)

# 排序后按 (count, row...) 追加一组同类声明面行, 组间/组内均长度前缀, 顺序无关。
fn CsgeFingerprintAppendSortedGroup(buf: var layout.ByteBuf, rows: str[]) =
    let sorted = CsgeFingerprintSortRows(rows)
    CsgeFingerprintAppendU32(buf, sorted.len)
    for i in 0..<sorted.len:
        CsgeFingerprintAppendText(buf, sorted[i])

fn CsgeFingerprintFinalizeHex(buf: var layout.ByteBuf): str =
    let digest = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return layout.FixedBytes32Hex(digest)

# L0: sourceContentHash = sha256(规范化后的原始文件字节) (spec §2.1)。调用方在
# 文本已在内存里的时刻 (Phase M rewrite 之后、split 之前) 传入, 不新增 I/O。
fn CsgeSourceContentHash(normalizedText: str): str =
    var buf: layout.ByteBuf = layout.ByteBufInit(len(normalizedText) + 64)
    CsgeFingerprintAppendText(buf, "cheng.csge.sourcecontent")
    CsgeFingerprintAppendText(buf, normalizedText)
    return CsgeFingerprintFinalizeHex(buf)
