# csge_manifest_codec — csg_e 跨文件增量化 spec Commit C: read-set manifest 的
# 持久化编解码器。spec: docs/beat-c-csge-incremental-spec.md §3.4 Commit C
# ("存储层 + 编解码器, 无接线") + §2.4 (线格式规模/纪律参照 backend2_frag_codec.cheng)。
#
# 状态: 纯加法, 不接入主构建路径——Commit B 的 TypedExprReadSetManifestFlush
# (typed_expr.cheng) 完全不变, 本文件当前没有任何调用点。落地一个可独立验证的
# encode/decode/写盘/读盘往返层, 供未来 Commit D/E 的接线工作直接复用。
#
# 铁律: 纯函数, 不 import typed_expr.cheng/compiler_csg.cheng (单向依赖, 同
# csge_fingerprint.cheng 头注)。二进制 LE u32 tag 框架 (镜像
# backend2_frag_codec.cheng "malformed = 硬崩, 绝不静默产垃圾"): 版本头
# magic+version+fieldCount, 逐字段 tag 前缀, 长度前缀消 concat 歧义——不沿用
# Commit B 诊断文本输出里的 tab/分号拼接 (那是给人 cat 看的临时诊断格式,
# 分号/制表符出现在路径里时有歧义; 本文件是要落盘复用的持久层, 必须结构化)。
#
# 确定性: encode 前对 source rows 按 sourcePath、function rows 按
# (sourcePath, functionName) 排序, 且每个 function row 内部的 externalDeps
# 也排序——与 Commit B sourceInterfaceHash 的排序纪律一致 (csge_fingerprint.cheng
# "排序后的" 同一口径), 消除构建期扫描/命中顺序扰动, 故同一份逻辑 manifest 内容
# 无论构建期产生顺序如何, 编出的字节必然相同 (spec §2.5 门②"warm 命中恒等" 的
# 必要前提)。
#
# 解码契约: 文件不存在/不可读 = 常规 miss (bool 返回 false + err, 非崩溃);
# 文件存在但字节损坏 (magic/version/fieldCount/tag 不符或长度越界) = panic 硬崩,
# 绝不返回半截/默认数据 (spec §2.5 门⑤ "故障注入必须 panic, 不能静默吃错缓存"
# 同一纪律, 镜像 backend2_frag_codec.cheng Decode)。

import std/os
import std/strings
import std/result
import std/rawbytes
import cheng/core/lang/csge_fingerprint as csgefp

const
    csgeManifestCodecMagic: int32 = 0x474d5343        # "CSMG" 简记 (csg_e manifest), LE
    csgeManifestCodecVersion: int32 = 1
    csgeManifestCodecFieldCount: int32 = 2             # sourceRows 组 / functionRows 组

type
    CsgeManifestSourceRow =
        sourcePath: str
        contentHash: str
        interfaceHash: str

    CsgeManifestFunctionRow =
        sourcePath: str
        functionName: str
        externalDeps: str[]

# ---- 排序 (镜像 csge_fingerprint.cheng csgeFingerprintStrLess/CsgeFingerprintSortRows:
# 域是单次 build 的 manifest 行集合, N 小, 决定性, 不带比较器依赖) ----

@borrows
fn csgeManifestStrLess(a: str, b: str): bool =
    var n = len(a)
    if len(b) < n:
        n = len(b)
    for i in 0..<n:
        let ca = int32(a[i]) & 255
        let cb = int32(b[i]) & 255
        if ca != cb:
            return ca < cb
    return len(a) < len(b)

@borrows
fn csgeManifestCloneSourceRow(row: CsgeManifestSourceRow): CsgeManifestSourceRow =
    var out: CsgeManifestSourceRow
    out.sourcePath = strings.CloneStr(row.sourcePath)
    out.contentHash = strings.CloneStr(row.contentHash)
    out.interfaceHash = strings.CloneStr(row.interfaceHash)
    return out

@borrows
fn csgeManifestCloneFunctionRow(row: CsgeManifestFunctionRow): CsgeManifestFunctionRow =
    var out: CsgeManifestFunctionRow
    out.sourcePath = strings.CloneStr(row.sourcePath)
    out.functionName = strings.CloneStr(row.functionName)
    out.externalDeps = CsgeManifestSortStrings(row.externalDeps)
    return out

@borrows
fn CsgeManifestSortStrings(items: str[]): str[] =
    var out: str[]
    for i in 0..<items.len:
        add(out, strings.CloneStr(items[i]))
    for i in 1..<out.len:
        var j = i
        while j > 0 && csgeManifestStrLess(out[j], out[j - 1]):
            let tmp = strings.CloneStr(out[j - 1])
            out[j - 1] = strings.CloneStr(out[j])
            out[j] = tmp
            j = j - 1
    return out

@borrows
fn CsgeManifestSortSourceRows(rows: CsgeManifestSourceRow[]): CsgeManifestSourceRow[] =
    var out: CsgeManifestSourceRow[]
    for i in 0..<rows.len:
        add(out, csgeManifestCloneSourceRow(rows[i]))
    for i in 1..<out.len:
        var j = i
        while j > 0 && csgeManifestStrLess(out[j].sourcePath, out[j - 1].sourcePath):
            let tmp = csgeManifestCloneSourceRow(out[j - 1])
            out[j - 1] = csgeManifestCloneSourceRow(out[j])
            out[j] = tmp
            j = j - 1
    return out

@borrows
fn csgeManifestFunctionRowKey(row: CsgeManifestFunctionRow): str =
    var fields: str[]
    add(fields, strings.CloneStr(row.sourcePath))
    add(fields, strings.CloneStr(row.functionName))
    return csgefp.CsgeFingerprintRowToken(fields)

# 排序前先把每行内部的 externalDeps 也排好序 (行内顺序无关性, 见文件头注确定性段落)。
@borrows
fn CsgeManifestSortFunctionRows(rows: CsgeManifestFunctionRow[]): CsgeManifestFunctionRow[] =
    var out: CsgeManifestFunctionRow[]
    for i in 0..<rows.len:
        var row = rows[i]
        row.externalDeps = CsgeManifestSortStrings(row.externalDeps)
        add(out, row)
    for i in 1..<out.len:
        var j = i
        while j > 0 && csgeManifestStrLess(csgeManifestFunctionRowKey(out[j]), csgeManifestFunctionRowKey(out[j - 1])):
            let tmp = csgeManifestCloneFunctionRow(out[j - 1])
            out[j - 1] = csgeManifestCloneFunctionRow(out[j])
            out[j] = tmp
            j = j - 1
    return out

# ---- LE u32 原语 (镜像 backend2_frag_codec.cheng Backend2CodecPutU32/ReadU32) ----

fn csgeManifestCodecPutU32(b: var rawbytes.BytesBuilder, value: int32) =
    rawbytes.BytesBuilderAppendByte(b, value & 255)
    rawbytes.BytesBuilderAppendByte(b, (value >> 8) & 255)
    rawbytes.BytesBuilderAppendByte(b, (value >> 16) & 255)
    rawbytes.BytesBuilderAppendByte(b, (value >> 24) & 255)

fn csgeManifestCodecReadU32(buf: rawbytes.Bytes, cursor: var int32): int32 =
    if cursor < 0 || cursor + 4 > rawbytes.BytesLen(buf):
        panic("csge_manifest_codec_read_u32_overrun")
    let b0 = rawbytes.BytesGet(buf, cursor)
    let b1 = rawbytes.BytesGet(buf, cursor + 1)
    let b2 = rawbytes.BytesGet(buf, cursor + 2)
    let b3 = rawbytes.BytesGet(buf, cursor + 3)
    cursor = cursor + 4
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

@borrows
fn csgeManifestCodecPutStr(b: var rawbytes.BytesBuilder, s: str) =
    csgeManifestCodecPutU32(b, len(s))
    if len(s) > 0:
        let view = rawbytes.BytesFromString(s)
        rawbytes.BytesBuilderAppend(b, view)

fn csgeManifestCodecReadStr(buf: rawbytes.Bytes, cursor: var int32): str =
    let n = csgeManifestCodecReadU32(buf, cursor)
    if n < 0 || cursor + n > rawbytes.BytesLen(buf):
        panic("csge_manifest_codec_str_len_overrun")
    if n <= 0:
        return ""
    let view = rawbytes.BytesSliceView(buf, cursor, n)
    cursor = cursor + n
    return rawbytes.BytesToString(view)

fn csgeManifestCodecExpectTag(buf: rawbytes.Bytes, cursor: var int32, tag: int32) =
    if csgeManifestCodecReadU32(buf, cursor) != tag:
        panic("csge_manifest_codec_field_tag_mismatch")

# ---- encode: 排序后写出 (确定性, 见文件头注) ----

@borrows
fn CsgeManifestEncode(sourceRows: CsgeManifestSourceRow[],
                       functionRows: CsgeManifestFunctionRow[]): rawbytes.Bytes =
    let sortedSources = CsgeManifestSortSourceRows(sourceRows)
    let sortedFunctions = CsgeManifestSortFunctionRows(functionRows)
    var b: rawbytes.BytesBuilder = rawbytes.BytesBuilderNew(256)
    csgeManifestCodecPutU32(b, csgeManifestCodecMagic)
    csgeManifestCodecPutU32(b, csgeManifestCodecVersion)
    csgeManifestCodecPutU32(b, csgeManifestCodecFieldCount)
    csgeManifestCodecPutU32(b, 1)
    csgeManifestCodecPutU32(b, sortedSources.len)
    for i in 0..<sortedSources.len:
        csgeManifestCodecPutStr(b, sortedSources[i].sourcePath)
        csgeManifestCodecPutStr(b, sortedSources[i].contentHash)
        csgeManifestCodecPutStr(b, sortedSources[i].interfaceHash)
    csgeManifestCodecPutU32(b, 2)
    csgeManifestCodecPutU32(b, sortedFunctions.len)
    for i in 0..<sortedFunctions.len:
        csgeManifestCodecPutStr(b, sortedFunctions[i].sourcePath)
        csgeManifestCodecPutStr(b, sortedFunctions[i].functionName)
        let deps = sortedFunctions[i].externalDeps
        csgeManifestCodecPutU32(b, deps.len)
        for j in 0..<deps.len:
            csgeManifestCodecPutStr(b, deps[j])
    return rawbytes.BytesBuilderFinish(b)

# ---- decode: malformed 一律 panic 硬崩 (见文件头"解码契约") ----

fn CsgeManifestDecode(buf: rawbytes.Bytes,
                       outSourceRows: var CsgeManifestSourceRow[],
                       outFunctionRows: var CsgeManifestFunctionRow[]) =
    var cursor: int32
    if csgeManifestCodecReadU32(buf, cursor) != csgeManifestCodecMagic:
        panic("csge_manifest_codec_bad_magic")
    if csgeManifestCodecReadU32(buf, cursor) != csgeManifestCodecVersion:
        panic("csge_manifest_codec_bad_version")
    if csgeManifestCodecReadU32(buf, cursor) != csgeManifestCodecFieldCount:
        panic("csge_manifest_codec_bad_field_count")
    csgeManifestCodecExpectTag(buf, cursor, 1)
    let sourceCount = csgeManifestCodecReadU32(buf, cursor)
    if sourceCount < 0:
        panic("csge_manifest_codec_source_count_negative")
    outSourceRows = []
    for i in 0..<sourceCount:
        var row: CsgeManifestSourceRow
        row.sourcePath = csgeManifestCodecReadStr(buf, cursor)
        row.contentHash = csgeManifestCodecReadStr(buf, cursor)
        row.interfaceHash = csgeManifestCodecReadStr(buf, cursor)
        add(outSourceRows, row)
    csgeManifestCodecExpectTag(buf, cursor, 2)
    let functionCount = csgeManifestCodecReadU32(buf, cursor)
    if functionCount < 0:
        panic("csge_manifest_codec_function_count_negative")
    outFunctionRows = []
    for i in 0..<functionCount:
        var row: CsgeManifestFunctionRow
        row.sourcePath = csgeManifestCodecReadStr(buf, cursor)
        row.functionName = csgeManifestCodecReadStr(buf, cursor)
        let depCount = csgeManifestCodecReadU32(buf, cursor)
        if depCount < 0:
            panic("csge_manifest_codec_dep_count_negative")
        var deps: str[]
        for j in 0..<depCount:
            add(deps, csgeManifestCodecReadStr(buf, cursor))
        row.externalDeps = deps
        add(outFunctionRows, row)
    if cursor != rawbytes.BytesLen(buf):
        panic("csge_manifest_codec_trailing_bytes")

# round-trip 断言: 编→解→再编逐字节等 (镜像 Backend2FragmentRoundTripAssert)。
fn CsgeManifestRoundTripAssert(sourceRows: CsgeManifestSourceRow[],
                                functionRows: CsgeManifestFunctionRow[]) =
    var enc1 = CsgeManifestEncode(sourceRows, functionRows)
    var decodedSources: CsgeManifestSourceRow[]
    var decodedFunctions: CsgeManifestFunctionRow[]
    CsgeManifestDecode(enc1, decodedSources, decodedFunctions)
    var enc2 = CsgeManifestEncode(decodedSources, decodedFunctions)
    if !rawbytes.BytesEqual(enc1, enc2):
        panic("csge_manifest_codec_roundtrip_byte_mismatch")
    rawbytes.BytesFree(enc1)
    rawbytes.BytesFree(enc2)

# ---- 落盘/读盘 (env 门控同 Commit B: CHENG_CSGE_READSET_MANIFEST) ----
# 文件缺失/不可读 = 常规 miss (bool=false, err 填诊断信息, 不 panic); 文件存在但
# 内容损坏 = 走 CsgeManifestDecode 的 panic 硬崩契约 (不在此处 catch/降级)。

fn CsgeManifestWriteFile(path: str,
                          sourceRows: CsgeManifestSourceRow[],
                          functionRows: CsgeManifestFunctionRow[],
                          err: var str): bool =
    if path == "":
        err = "csge_manifest_codec: empty path"
        return false
    var enc = CsgeManifestEncode(sourceRows, functionRows)
    var writeRes: Result[bool] = os.WriteFileBytesResult(path, enc)
    rawbytes.BytesFree(enc)
    if IsErr(writeRes):
        err = "csge_manifest_codec: write failed: " + path
        return false
    return true

fn CsgeManifestReadFile(path: str,
                         outSourceRows: var CsgeManifestSourceRow[],
                         outFunctionRows: var CsgeManifestFunctionRow[],
                         err: var str): bool =
    if path == "" || !os.FileExists(path):
        err = "csge_manifest_codec: file missing: " + path
        return false
    var readRes: Result[rawbytes.Bytes] = os.ReadFileBytesResult(path)
    if IsErr(readRes):
        err = "csge_manifest_codec: read failed: " + path
        return false
    let buf = Value(readRes)
    CsgeManifestDecode(buf, outSourceRows, outFunctionRows)
    return true
