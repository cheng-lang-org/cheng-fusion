# typed_expr 跨模块类型全局注册 (ghost-with-dead-wire).
#
# Status: SCAFFOLD / GHOST-WITH-DEAD-WIRE (lesson e4550c1b5 applied).
# Env gate CHENG_GLOBAL_TYPE_REGISTRY_TRACE=1 default off.
#
# Design source: op-lane 剩 2 条 bail=44 (rsaBigBitLenVar/rsaBigHalfDigitCount)
# 真根因 = typed_expr 类型注册非全局; rsa.cheng 跨模块查 bigint.BigInt 失败,
# bigint 在 bigint.cheng 注册的 typedef 只对本源文件可见 (typeLayout* 列按
# sourcePath 隔离), backend 在 rsa.cheng 上下文里取不到 BigInt 的 layout
# size → bigint 列 r3 drill 落 bail=44 poison.
#
# Companion: 上游 typed_expr 把 typeLayoutSourcePaths / typeLayoutNames /
# typeLayoutSizeBytes 三列聚合成 (typeName -> [entries]) 反向索引, 标记
# 跨源同名 typedef. 真 P4 apply 把这个索引塞回 backend lookup, 让 rsa.cheng
# 上下文查 BigInt 时先命中全局表再回退本源 (single-source 仍是首选, 多源
# 则按 cross-module 路径走).
#
# Algorithm (dry-run simulation, P3-ghost):
#   1. 遍历 typedIr.typeLayoutNames.len, 三列并行读 (name, source, size).
#   2. 累计 totalRegistered++.
#   3. 同名再遇 (registry.entries 已有 typeName 且 sourcePath 不同) 标
#      cross-module=true, 计数 crossModuleHits++.
#   4. 单 source 同名 typedef 视为 redeclare (skipRedeclare++), 不进 entries.
#   5. trace 行 stderr-gate stderr 把核心计数打出来 (IntToStr 拼).
#
# Real apply (P4 cross-session):
#   - 把 GlobalTypeRegistryResult.entries 暴露成 backend lookup 表
#     (typeName -> {sourcePath, layoutBytes}) 替代每源独立 typeLayout* 扫描.
#   - rsa.cheng 上下文查 BigInt 走全局表先命中 bigint.cheng 的 entry, 拿到
#     正确的 layoutBytes, bigint 列 r3 drill 不再落 bail=44.
#
# Wiring plan (P4+):
#   1. lowering_plan dead-wire (本提交) 把模块拉进 cold compiler 闭包.
#   2. backend 类型 lookup 路径加入 env-gate 真实查询此 registry, P5 落
#      真覆盖 (替换原 per-source typeLayout 扫描).
#   3. bail=44 census 剩余 2 条降到 0 → op-lane bail=44 战役收尾.

import cheng/core/lang/typed_expr as texpr
import std/os
import std/strings

type
    GlobalTypeRegistryEntry =
        typeName: str
        sourcePath: str
        layoutBytes: int32
        crossModule: bool

    GlobalTypeRegistryResult =
        entries: GlobalTypeRegistryEntry[]
        totalRegistered: int32
        crossModuleHits: int32
        skipRedeclare: int32
        skipEmptyName: int32

@borrows
fn TypedExprGlobalTypeRegistryFindEntry(entries: var GlobalTypeRegistryEntry[],
                                          typeName: str): int32 =
    for i in 0..<entries.len:
        if entries[i].typeName == typeName:
            return int32(i)
    return int32(-1)

fn TypedExprGlobalTypeRegistryBuild(typedIr: var texpr.TypedExprIr): GlobalTypeRegistryResult =
    var out: GlobalTypeRegistryResult
    out.totalRegistered = 0
    out.crossModuleHits = 0
    out.skipRedeclare = 0
    out.skipEmptyName = 0

    for i in 0..<typedIr.typeLayoutNames.len:
        let typeName = typedIr.typeLayoutNames[i]
        if typeName == "":
            out.skipEmptyName = out.skipEmptyName + 1
            continue
        var sourcePath: str
        if i < typedIr.typeLayoutSourcePaths.len:
            sourcePath = typedIr.typeLayoutSourcePaths[i]
        var layoutBytes: int32
        if i < typedIr.typeLayoutSizeBytes.len:
            layoutBytes = typedIr.typeLayoutSizeBytes[i]

        let existingIndex = TypedExprGlobalTypeRegistryFindEntry(out.entries, typeName)
        if existingIndex < 0:
            var entry: GlobalTypeRegistryEntry
            entry.typeName = typeName
            entry.sourcePath = sourcePath
            entry.layoutBytes = layoutBytes
            entry.crossModule = false
            add(out.entries, entry)
            out.totalRegistered = out.totalRegistered + 1
        else:
            let existing = out.entries[existingIndex]
            if existing.sourcePath != sourcePath && sourcePath != "":
                # 同名 typedef 出现在不同源文件 → 跨模块 (BigInt 多重定义场景).
                # P4 真 apply 把 entries[existingIndex].crossModule=true 写回,
                # ghost dry-run 仅计数; entries 数组只记首登记, 跨源信号靠
                # crossModuleHits 计数体现.
                out.crossModuleHits = out.crossModuleHits + 1
            else:
                # 同源同名 typedef 视作 redeclare (parser 已合并, 多余项跳过).
                out.skipRedeclare = out.skipRedeclare + 1

    let _gate = os.GetEnv("CHENG_GLOBAL_TYPE_REGISTRY_TRACE")
    if _gate == "1":
        var _line: str = "[typed-expr-global-type-registry] total="
        _line = _line + strings.IntToStr(out.totalRegistered)
        _line = _line + " cross_module="
        _line = _line + strings.IntToStr(out.crossModuleHits)
        _line = _line + " redeclare="
        _line = _line + strings.IntToStr(out.skipRedeclare)
        _line = _line + " empty_name="
        _line = _line + strings.IntToStr(out.skipEmptyName)
        os.WriteLine(os.GetStderr(), _line)

    return out

fn TypedExprGlobalTypeRegistryTotal(r: GlobalTypeRegistryResult): int32 =
    return r.totalRegistered

fn TypedExprGlobalTypeRegistryCrossModule(r: GlobalTypeRegistryResult): int32 =
    return r.crossModuleHits

fn TypedExprGlobalTypeRegistryLookupLayoutBytes(r: GlobalTypeRegistryResult,
                                                  typeName: str): int32 =
    for i in 0..<r.entries.len:
        if r.entries[i].typeName == typeName:
            return r.entries[i].layoutBytes
    return int32(-1)
