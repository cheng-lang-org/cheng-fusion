        consumedFlags: int32[]

    TypedExprIrFunctionFragment =
        sourcePath: str
        functionName: str
        signatureLineNumber: int32
        endLineNumber: int32
        bodyLineNumber: int32
        returnType: str
        returnExpr: str
        resultExprClass: int32
        borrowsArguments: bool
        returnNodeIndex: int32 = -1
        scopeStart: int32
        scopeCount: int32
        valueDefinitionCount: int32
        valueDefinitionGroupCount: int32
        valueDefinitionTypeArenaArtifactCid: str
        statements: TypedExprIrStatementsFragment
        nodes: TypedExprIrNodesFragment
        scopes: TypedExprIrScopesFragment
        valueDefinitions: TypedExprIrValueDefinitionsFragment
        valueDefinitionGroups: TypedExprIrValueDefinitionGroupsFragment


fn tefcPutU32(b: var rawbytes.BytesBuilder, value: int32) =
    rawbytes.BytesBuilderAppendByte(b, value & 255)
    rawbytes.BytesBuilderAppendByte(b, (value >> 8) & 255)
    rawbytes.BytesBuilderAppendByte(b, (value >> 16) & 255)
    rawbytes.BytesBuilderAppendByte(b, (value >> 24) & 255)

fn tefcReadU32(buf: rawbytes.Bytes, cursor: var int32): int32 =
    if cursor < 0 || cursor + 4 > rawbytes.BytesLen(buf):
        panic("typed_expr_frag_codec_read_u32_overrun")
    let b0 = rawbytes.BytesGet(buf, cursor)
    let b1 = rawbytes.BytesGet(buf, cursor + 1)
    let b2 = rawbytes.BytesGet(buf, cursor + 2)
    let b3 = rawbytes.BytesGet(buf, cursor + 3)
    cursor = cursor + 4
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)

@borrows
fn tefcPutStr(b: var rawbytes.BytesBuilder, s: str) =
    tefcPutU32(b, len(s))
    if len(s) > 0:
        let view = rawbytes.BytesFromString(s)
        rawbytes.BytesBuilderAppend(b, view)

fn tefcReadStr(buf: rawbytes.Bytes, cursor: var int32): str =
    let n = tefcReadU32(buf, cursor)
    if n < 0 || cursor + n > rawbytes.BytesLen(buf):
        panic("typed_expr_frag_codec_str_len_overrun")
    if n <= 0:
        return ""
    let view = rawbytes.BytesSliceView(buf, cursor, n)
    cursor = cursor + n
    return rawbytes.BytesToString(view)

fn tefcExpectTag(buf: rawbytes.Bytes, cursor: var int32, tag: int32) =
    if tefcReadU32(buf, cursor) != tag:
        panic("typed_expr_frag_codec_field_tag_mismatch")


@borrows
fn tefcPutStrColumn(b: var rawbytes.BytesBuilder, tag: int32, items: str[]) =
    tefcPutU32(b, tag)
    tefcPutU32(b, items.len)
    for i in 0..<items.len:
        tefcPutStr(b, items[i])

fn tefcReadStrColumn(buf: rawbytes.Bytes, cursor: var int32, tag: int32): str[] =
    tefcExpectTag(buf, cursor, tag)
    let n = tefcReadU32(buf, cursor)
    if n < 0:
        panic("typed_expr_frag_codec_str_column_count_negative")
    var out: str[]
    for i in 0..<n:
        add(out, tefcReadStr(buf, cursor))
    return out

@borrows
fn tefcPutI32Column(b: var rawbytes.BytesBuilder, tag: int32, items: int32[]) =
    tefcPutU32(b, tag)
    tefcPutU32(b, items.len)
    for i in 0..<items.len:
        tefcPutU32(b, items[i])

fn tefcReadI32Column(buf: rawbytes.Bytes, cursor: var int32, tag: int32): int32[] =
    tefcExpectTag(buf, cursor, tag)
    let n = tefcReadU32(buf, cursor)
    if n < 0:
        panic("typed_expr_frag_codec_i32_column_count_negative")
    var out: int32[]
    for i in 0..<n:
        add(out, tefcReadU32(buf, cursor))
    return out

@borrows
fn tefcPutBoolColumn(b: var rawbytes.BytesBuilder, tag: int32, items: bool[]) =
    tefcPutU32(b, tag)
    tefcPutU32(b, items.len)
    for i in 0..<items.len:
        var v: int32
        if items[i]:
            v = 1
        tefcPutU32(b, v)

fn tefcReadBoolColumn(buf: rawbytes.Bytes, cursor: var int32, tag: int32): bool[] =
    tefcExpectTag(buf, cursor, tag)
    let n = tefcReadU32(buf, cursor)
    if n < 0:
        panic("typed_expr_frag_codec_bool_column_count_negative")
    var out: bool[]
    for i in 0..<n:
        add(out, tefcReadU32(buf, cursor) != 0)
    return out

fn tefcRequireColumnLen(actual: int32, expected: int32, columnName: str) =
    if actual != expected:
        panic("typed_expr_frag_codec_column_length_mismatch:" + columnName)


@borrows
fn TypedExprIrStatementsFragmentEncodeInto(b: var rawbytes.BytesBuilder, f: TypedExprIrStatementsFragment) =
    tefcPutStrColumn(b, 3, f.sourcePathIds)
    tefcPutStrColumn(b, 4, f.functionNameIds)
    tefcPutI32Column(b, 5, f.statementIndexs)
    tefcPutI32Column(b, 6, f.lineNumbers)
    tefcPutI32Column(b, 7, f.columnNumbers)
    tefcPutI32Column(b, 8, f.lineIndents)
    tefcPutI32Column(b, 9, f.enclosingIfLineNumbers)
    tefcPutStrColumn(b, 10, f.enclosingIfConditionTextIds)
    tefcPutStrColumn(b, 11, f.exprIdIds)
    tefcPutI32Column(b, 12, f.kinds)
    tefcPutI32Column(b, 13, f.callKinds)
    tefcPutI32Column(b, 14, f.detailKinds)
    tefcPutStrColumn(b, 15, f.surfaceTextIds)
    tefcPutStrColumn(b, 16, f.bindingNameIds)
    tefcPutStrColumn(b, 17, f.resultTypeIds)
    tefcPutI32Column(b, 18, f.conditionKinds)
    tefcPutStrColumn(b, 19, f.conditionLhsTextIds)
    tefcPutStrColumn(b, 20, f.conditionRhsTextIds)
    tefcPutStrColumn(b, 21, f.conditionLiteralTextIds)
    tefcPutStrColumn(b, 22, f.assignRootNameIds)
    tefcPutStrColumn(b, 23, f.assignRootTypeIds)
    tefcPutStrColumn(b, 24, f.assignRootSourcePathIds)
    tefcPutBoolColumn(b, 25, f.assignRootGlobalFlags)
    tefcPutI32Column(b, 26, f.assignPlaceKinds)
    tefcPutStrColumn(b, 27, f.assignFieldNameIds)
    tefcPutStrColumn(b, 28, f.assignFieldTypeIds)
    tefcPutI32Column(b, 29, f.assignFieldOffsetBytes)
    tefcPutI32Column(b, 30, f.assignFieldSizeBytes)
    tefcPutI32Column(b, 31, f.assignFieldAlignBytes)
    tefcPutStrColumn(b, 32, f.assignValueRootNameIds)
    tefcPutStrColumn(b, 33, f.assignValueRootTypeIds)
    tefcPutStrColumn(b, 34, f.assignValueFieldNameIds)
    tefcPutStrColumn(b, 35, f.assignValueFieldTypeIds)
    tefcPutI32Column(b, 36, f.assignValueFieldOffsetBytes)
    tefcPutI32Column(b, 37, f.assignValueFieldSizeBytes)
    tefcPutI32Column(b, 38, f.assignValueFieldAlignBytes)
    tefcPutI32Column(b, 39, f.assignValueOpKinds)
    tefcPutStrColumn(b, 40, f.assignValueLhsTextIds)
    tefcPutStrColumn(b, 41, f.assignValueRhsTextIds)
    tefcPutI32Column(b, 42, f.assignValueRhsConsts)
    tefcPutBoolColumn(b, 43, f.assignValueRhsHasConsts)
    tefcPutStrColumn(b, 44, f.callQualifierIds)
    tefcPutStrColumn(b, 45, f.callCalleeIds)
    tefcPutStrColumn(b, 46, f.callTargetIds)
    tefcPutStrColumn(b, 47, f.callTargetSourcePathIds)
    tefcPutBoolColumn(b, 48, f.callTargetImportcs)
    tefcPutI32Column(b, 49, f.callArgCounts)
    tefcPutStrColumn(b, 50, f.callArgsTextIds)
    tefcPutStrColumn(b, 51, f.callArgTypesTextIds)
    tefcPutI32Column(b, 52, f.callArgNodeStarts)
    tefcPutI32Column(b, 53, f.callArgNodeCounts)
    tefcPutI32Column(b, 54, f.rhsNodeIndexs)
    tefcPutI32Column(b, 55, f.rhsBailReasons)
    tefcPutI32Column(b, 56, f.callSurfaceKinds)
    tefcPutI32Column(b, 57, f.endLineNumbers)
    tefcPutI32Column(b, 58, f.endColumnNumbers)
    tefcPutI32Column(b, 59, f.forStartNodeIndexs)
    tefcPutI32Column(b, 60, f.assignIndexNodeIndexs)
    tefcPutI32Column(b, 61, f.loweringModes)
    tefcPutI32Column(b, 62, f.returnKinds)
    tefcPutBoolColumn(b, 63, f.returnRoots)

fn TypedExprIrStatementsFragmentDecodeFrom(buf: rawbytes.Bytes, cursor: var int32): TypedExprIrStatementsFragment =
    var f: TypedExprIrStatementsFragment
    f.sourcePathIds = tefcReadStrColumn(buf, cursor, 3)
    let n = f.sourcePathIds.len
    f.functionNameIds = tefcReadStrColumn(buf, cursor, 4)
    tefcRequireColumnLen(f.functionNameIds.len, n, "functionNameIds")
    f.statementIndexs = tefcReadI32Column(buf, cursor, 5)
    tefcRequireColumnLen(f.statementIndexs.len, n, "statementIndexs")
    f.lineNumbers = tefcReadI32Column(buf, cursor, 6)
    tefcRequireColumnLen(f.lineNumbers.len, n, "lineNumbers")
    f.columnNumbers = tefcReadI32Column(buf, cursor, 7)
    tefcRequireColumnLen(f.columnNumbers.len, n, "columnNumbers")
    f.lineIndents = tefcReadI32Column(buf, cursor, 8)
    tefcRequireColumnLen(f.lineIndents.len, n, "lineIndents")
    f.enclosingIfLineNumbers = tefcReadI32Column(buf, cursor, 9)
    tefcRequireColumnLen(f.enclosingIfLineNumbers.len, n, "enclosingIfLineNumbers")
    f.enclosingIfConditionTextIds = tefcReadStrColumn(buf, cursor, 10)
    tefcRequireColumnLen(f.enclosingIfConditionTextIds.len, n, "enclosingIfConditionTextIds")
    f.exprIdIds = tefcReadStrColumn(buf, cursor, 11)
    tefcRequireColumnLen(f.exprIdIds.len, n, "exprIdIds")
    f.kinds = tefcReadI32Column(buf, cursor, 12)
    tefcRequireColumnLen(f.kinds.len, n, "kinds")
    f.callKinds = tefcReadI32Column(buf, cursor, 13)
    tefcRequireColumnLen(f.callKinds.len, n, "callKinds")
    f.detailKinds = tefcReadI32Column(buf, cursor, 14)
    tefcRequireColumnLen(f.detailKinds.len, n, "detailKinds")
    f.surfaceTextIds = tefcReadStrColumn(buf, cursor, 15)
    tefcRequireColumnLen(f.surfaceTextIds.len, n, "surfaceTextIds")
    f.bindingNameIds = tefcReadStrColumn(buf, cursor, 16)
    tefcRequireColumnLen(f.bindingNameIds.len, n, "bindingNameIds")
    f.resultTypeIds = tefcReadStrColumn(buf, cursor, 17)
    tefcRequireColumnLen(f.resultTypeIds.len, n, "resultTypeIds")
    f.conditionKinds = tefcReadI32Column(buf, cursor, 18)
    tefcRequireColumnLen(f.conditionKinds.len, n, "conditionKinds")
    f.conditionLhsTextIds = tefcReadStrColumn(buf, cursor, 19)
    tefcRequireColumnLen(f.conditionLhsTextIds.len, n, "conditionLhsTextIds")
    f.conditionRhsTextIds = tefcReadStrColumn(buf, cursor, 20)
    tefcRequireColumnLen(f.conditionRhsTextIds.len, n, "conditionRhsTextIds")
    f.conditionLiteralTextIds = tefcReadStrColumn(buf, cursor, 21)
    tefcRequireColumnLen(f.conditionLiteralTextIds.len, n, "conditionLiteralTextIds")
    f.assignRootNameIds = tefcReadStrColumn(buf, cursor, 22)
    tefcRequireColumnLen(f.assignRootNameIds.len, n, "assignRootNameIds")
    f.assignRootTypeIds = tefcReadStrColumn(buf, cursor, 23)
    tefcRequireColumnLen(f.assignRootTypeIds.len, n, "assignRootTypeIds")
    f.assignRootSourcePathIds = tefcReadStrColumn(buf, cursor, 24)
    tefcRequireColumnLen(f.assignRootSourcePathIds.len, n, "assignRootSourcePathIds")
    f.assignRootGlobalFlags = tefcReadBoolColumn(buf, cursor, 25)
    tefcRequireColumnLen(f.assignRootGlobalFlags.len, n, "assignRootGlobalFlags")
    f.assignPlaceKinds = tefcReadI32Column(buf, cursor, 26)
    tefcRequireColumnLen(f.assignPlaceKinds.len, n, "assignPlaceKinds")
    f.assignFieldNameIds = tefcReadStrColumn(buf, cursor, 27)
    tefcRequireColumnLen(f.assignFieldNameIds.len, n, "assignFieldNameIds")
    f.assignFieldTypeIds = tefcReadStrColumn(buf, cursor, 28)
    tefcRequireColumnLen(f.assignFieldTypeIds.len, n, "assignFieldTypeIds")
    f.assignFieldOffsetBytes = tefcReadI32Column(buf, cursor, 29)
    tefcRequireColumnLen(f.assignFieldOffsetBytes.len, n, "assignFieldOffsetBytes")
    f.assignFieldSizeBytes = tefcReadI32Column(buf, cursor, 30)
    tefcRequireColumnLen(f.assignFieldSizeBytes.len, n, "assignFieldSizeBytes")
    f.assignFieldAlignBytes = tefcReadI32Column(buf, cursor, 31)
    tefcRequireColumnLen(f.assignFieldAlignBytes.len, n, "assignFieldAlignBytes")
    f.assignValueRootNameIds = tefcReadStrColumn(buf, cursor, 32)
    tefcRequireColumnLen(f.assignValueRootNameIds.len, n, "assignValueRootNameIds")
    f.assignValueRootTypeIds = tefcReadStrColumn(buf, cursor, 33)
    tefcRequireColumnLen(f.assignValueRootTypeIds.len, n, "assignValueRootTypeIds")
    f.assignValueFieldNameIds = tefcReadStrColumn(buf, cursor, 34)
    tefcRequireColumnLen(f.assignValueFieldNameIds.len, n, "assignValueFieldNameIds")
    f.assignValueFieldTypeIds = tefcReadStrColumn(buf, cursor, 35)
    tefcRequireColumnLen(f.assignValueFieldTypeIds.len, n, "assignValueFieldTypeIds")
    f.assignValueFieldOffsetBytes = tefcReadI32Column(buf, cursor, 36)
    tefcRequireColumnLen(f.assignValueFieldOffsetBytes.len, n, "assignValueFieldOffsetBytes")
    f.assignValueFieldSizeBytes = tefcReadI32Column(buf, cursor, 37)
    tefcRequireColumnLen(f.assignValueFieldSizeBytes.len, n, "assignValueFieldSizeBytes")
    f.assignValueFieldAlignBytes = tefcReadI32Column(buf, cursor, 38)
    tefcRequireColumnLen(f.assignValueFieldAlignBytes.len, n, "assignValueFieldAlignBytes")
    f.assignValueOpKinds = tefcReadI32Column(buf, cursor, 39)
    tefcRequireColumnLen(f.assignValueOpKinds.len, n, "assignValueOpKinds")
    f.assignValueLhsTextIds = tefcReadStrColumn(buf, cursor, 40)
    tefcRequireColumnLen(f.assignValueLhsTextIds.len, n, "assignValueLhsTextIds")
    f.assignValueRhsTextIds = tefcReadStrColumn(buf, cursor, 41)
    tefcRequireColumnLen(f.assignValueRhsTextIds.len, n, "assignValueRhsTextIds")
    f.assignValueRhsConsts = tefcReadI32Column(buf, cursor, 42)
    tefcRequireColumnLen(f.assignValueRhsConsts.len, n, "assignValueRhsConsts")
    f.assignValueRhsHasConsts = tefcReadBoolColumn(buf, cursor, 43)
    tefcRequireColumnLen(f.assignValueRhsHasConsts.len, n, "assignValueRhsHasConsts")
    f.callQualifierIds = tefcReadStrColumn(buf, cursor, 44)
    tefcRequireColumnLen(f.callQualifierIds.len, n, "callQualifierIds")
    f.callCalleeIds = tefcReadStrColumn(buf, cursor, 45)
    tefcRequireColumnLen(f.callCalleeIds.len, n, "callCalleeIds")
    f.callTargetIds = tefcReadStrColumn(buf, cursor, 46)
    tefcRequireColumnLen(f.callTargetIds.len, n, "callTargetIds")
    f.callTargetSourcePathIds = tefcReadStrColumn(buf, cursor, 47)
    tefcRequireColumnLen(f.callTargetSourcePathIds.len, n, "callTargetSourcePathIds")
    f.callTargetImportcs = tefcReadBoolColumn(buf, cursor, 48)
    tefcRequireColumnLen(f.callTargetImportcs.len, n, "callTargetImportcs")
    f.callArgCounts = tefcReadI32Column(buf, cursor, 49)
    tefcRequireColumnLen(f.callArgCounts.len, n, "callArgCounts")
    f.callArgsTextIds = tefcReadStrColumn(buf, cursor, 50)
    tefcRequireColumnLen(f.callArgsTextIds.len, n, "callArgsTextIds")
    f.callArgTypesTextIds = tefcReadStrColumn(buf, cursor, 51)
    tefcRequireColumnLen(f.callArgTypesTextIds.len, n, "callArgTypesTextIds")
    f.callArgNodeStarts = tefcReadI32Column(buf, cursor, 52)
    tefcRequireColumnLen(f.callArgNodeStarts.len, n, "callArgNodeStarts")
    f.callArgNodeCounts = tefcReadI32Column(buf, cursor, 53)
    tefcRequireColumnLen(f.callArgNodeCounts.len, n, "callArgNodeCounts")
    f.rhsNodeIndexs = tefcReadI32Column(buf, cursor, 54)
    tefcRequireColumnLen(f.rhsNodeIndexs.len, n, "rhsNodeIndexs")
    f.rhsBailReasons = tefcReadI32Column(buf, cursor, 55)
    tefcRequireColumnLen(f.rhsBailReasons.len, n, "rhsBailReasons")
    f.callSurfaceKinds = tefcReadI32Column(buf, cursor, 56)
    tefcRequireColumnLen(f.callSurfaceKinds.len, n, "callSurfaceKinds")
    f.endLineNumbers = tefcReadI32Column(buf, cursor, 57)
    tefcRequireColumnLen(f.endLineNumbers.len, n, "endLineNumbers")
    f.endColumnNumbers = tefcReadI32Column(buf, cursor, 58)
    tefcRequireColumnLen(f.endColumnNumbers.len, n, "endColumnNumbers")
    f.forStartNodeIndexs = tefcReadI32Column(buf, cursor, 59)
    tefcRequireColumnLen(f.forStartNodeIndexs.len, n, "forStartNodeIndexs")
    f.assignIndexNodeIndexs = tefcReadI32Column(buf, cursor, 60)
    tefcRequireColumnLen(f.assignIndexNodeIndexs.len, n, "assignIndexNodeIndexs")
    f.loweringModes = tefcReadI32Column(buf, cursor, 61)
    tefcRequireColumnLen(f.loweringModes.len, n, "loweringModes")
    f.returnKinds = tefcReadI32Column(buf, cursor, 62)
    tefcRequireColumnLen(f.returnKinds.len, n, "returnKinds")
    f.returnRoots = tefcReadBoolColumn(buf, cursor, 63)
    tefcRequireColumnLen(f.returnRoots.len, n, "returnRoots")
    return f


@borrows
fn TypedExprIrNodesFragmentEncodeInto(b: var rawbytes.BytesBuilder, f: TypedExprIrNodesFragment) =
    tefcPutStrColumn(b, 64, f.sourcePathIds)
    tefcPutStrColumn(b, 65, f.functionNameIds)
    tefcPutI32Column(b, 66, f.nodeIndexs)
    tefcPutI32Column(b, 67, f.lineNumbers)
    tefcPutI32Column(b, 68, f.opKinds)
    tefcPutStrColumn(b, 69, f.resultTypeIds)
    tefcPutStrColumn(b, 70, f.surfaceTextIds)
    tefcPutI32Column(b, 71, f.paramSlots)
    tefcPutStrColumn(b, 72, f.paramNameIds)
    tefcPutI32Column(b, 73, f.operand0NodeIndexs)
    tefcPutI32Column(b, 74, f.operand1NodeIndexs)
    tefcPutI32Column(b, 75, f.operand2NodeIndexs)
    tefcPutStrColumn(b, 76, f.literalTextIds)
    tefcPutStrColumn(b, 77, f.callTargetIds)
    tefcPutStrColumn(b, 78, f.callTargetSourcePathIds)
    tefcPutBoolColumn(b, 79, f.callTargetImportcs)
    tefcPutI32Column(b, 80, f.fieldOffsetBytes)
    tefcPutI32Column(b, 81, f.fieldSizeBytes)
    tefcPutI32Column(b, 82, f.elemSizeBytes)

fn TypedExprIrNodesFragmentDecodeFrom(buf: rawbytes.Bytes, cursor: var int32): TypedExprIrNodesFragment =
    var f: TypedExprIrNodesFragment
    f.sourcePathIds = tefcReadStrColumn(buf, cursor, 64)
    let n = f.sourcePathIds.len
    f.functionNameIds = tefcReadStrColumn(buf, cursor, 65)
    tefcRequireColumnLen(f.functionNameIds.len, n, "nodes.functionNameIds")
    f.nodeIndexs = tefcReadI32Column(buf, cursor, 66)
    tefcRequireColumnLen(f.nodeIndexs.len, n, "nodes.nodeIndexs")
    f.lineNumbers = tefcReadI32Column(buf, cursor, 67)
    tefcRequireColumnLen(f.lineNumbers.len, n, "nodes.lineNumbers")
    f.opKinds = tefcReadI32Column(buf, cursor, 68)
    tefcRequireColumnLen(f.opKinds.len, n, "nodes.opKinds")
    f.resultTypeIds = tefcReadStrColumn(buf, cursor, 69)
    tefcRequireColumnLen(f.resultTypeIds.len, n, "nodes.resultTypeIds")
    f.surfaceTextIds = tefcReadStrColumn(buf, cursor, 70)
    tefcRequireColumnLen(f.surfaceTextIds.len, n, "nodes.surfaceTextIds")
    f.paramSlots = tefcReadI32Column(buf, cursor, 71)
    tefcRequireColumnLen(f.paramSlots.len, n, "nodes.paramSlots")
    f.paramNameIds = tefcReadStrColumn(buf, cursor, 72)
    tefcRequireColumnLen(f.paramNameIds.len, n, "nodes.paramNameIds")
    f.operand0NodeIndexs = tefcReadI32Column(buf, cursor, 73)
    tefcRequireColumnLen(f.operand0NodeIndexs.len, n, "nodes.operand0NodeIndexs")
    f.operand1NodeIndexs = tefcReadI32Column(buf, cursor, 74)
    tefcRequireColumnLen(f.operand1NodeIndexs.len, n, "nodes.operand1NodeIndexs")
    f.operand2NodeIndexs = tefcReadI32Column(buf, cursor, 75)
    tefcRequireColumnLen(f.operand2NodeIndexs.len, n, "nodes.operand2NodeIndexs")
    f.literalTextIds = tefcReadStrColumn(buf, cursor, 76)
    tefcRequireColumnLen(f.literalTextIds.len, n, "nodes.literalTextIds")
    f.callTargetIds = tefcReadStrColumn(buf, cursor, 77)
    tefcRequireColumnLen(f.callTargetIds.len, n, "nodes.callTargetIds")
    f.callTargetSourcePathIds = tefcReadStrColumn(buf, cursor, 78)
    tefcRequireColumnLen(f.callTargetSourcePathIds.len,
                         n,
                         "nodes.callTargetSourcePathIds")
    f.callTargetImportcs = tefcReadBoolColumn(buf, cursor, 79)
    tefcRequireColumnLen(f.callTargetImportcs.len,
                         n,
                         "nodes.callTargetImportcs")
    f.fieldOffsetBytes = tefcReadI32Column(buf, cursor, 80)
    tefcRequireColumnLen(f.fieldOffsetBytes.len, n, "nodes.fieldOffsetBytes")
    f.fieldSizeBytes = tefcReadI32Column(buf, cursor, 81)
    tefcRequireColumnLen(f.fieldSizeBytes.len, n, "nodes.fieldSizeBytes")
    f.elemSizeBytes = tefcReadI32Column(buf, cursor, 82)
    tefcRequireColumnLen(f.elemSizeBytes.len, n, "nodes.elemSizeBytes")
    return f

@borrows
fn TypedExprIrStatementsScopeColumnsEncodeInto(
        b: var rawbytes.BytesBuilder,
        f: TypedExprIrStatementsFragment) =
    tefcPutI32Column(b, 83, f.lexicalScopeIds)
    tefcPutI32Column(b, 84, f.suiteScopeIds)
    tefcPutI32Column(b, 85, f.statementOrdinals)
    tefcPutI32Column(b, 86, f.lexicalOrdinals)
    tefcPutI32Column(b, 87, f.deferOwnerStatementOrdinals)

fn TypedExprIrStatementsScopeColumnsDecodeFrom(
        buf: rawbytes.Bytes,
        cursor: var int32,
        f: var TypedExprIrStatementsFragment) =
    let n = f.sourcePathIds.len
    f.lexicalScopeIds = tefcReadI32Column(buf, cursor, 83)
    tefcRequireColumnLen(f.lexicalScopeIds.len, n, "lexicalScopeIds")
    f.suiteScopeIds = tefcReadI32Column(buf, cursor, 84)
    tefcRequireColumnLen(f.suiteScopeIds.len, n, "suiteScopeIds")
    f.statementOrdinals = tefcReadI32Column(buf, cursor, 85)
    tefcRequireColumnLen(f.statementOrdinals.len, n, "statementOrdinals")
    f.lexicalOrdinals = tefcReadI32Column(buf, cursor, 86)
    tefcRequireColumnLen(f.lexicalOrdinals.len, n, "lexicalOrdinals")
    f.deferOwnerStatementOrdinals = tefcReadI32Column(buf, cursor, 87)
    tefcRequireColumnLen(f.deferOwnerStatementOrdinals.len,
                         n,
                         "deferOwnerStatementOrdinals")

@borrows
fn TypedExprIrScopesFragmentEncodeInto(b: var rawbytes.BytesBuilder,
                                        f: TypedExprIrScopesFragment) =
    tefcPutI32Column(b, 90, f.scopeIds)
    tefcPutI32Column(b, 91, f.parentScopeIds)
    tefcPutI32Column(b, 92, f.kinds)
    tefcPutI32Column(b, 93, f.ownerStatementOrdinals)
    tefcPutI32Column(b, 94, f.lexicalOrdinals)
    tefcPutI32Column(b, 95, f.startLineNumbers)
    tefcPutI32Column(b, 96, f.startColumnNumbers)
    tefcPutI32Column(b, 97, f.endLineNumbers)
    tefcPutI32Column(b, 98, f.endColumnNumbers)

fn TypedExprIrScopesFragmentDecodeFrom(buf: rawbytes.Bytes,
                                        cursor: var int32): TypedExprIrScopesFragment =
    var f: TypedExprIrScopesFragment
    f.scopeIds = tefcReadI32Column(buf, cursor, 90)
    let n = f.scopeIds.len
    f.parentScopeIds = tefcReadI32Column(buf, cursor, 91)
    tefcRequireColumnLen(f.parentScopeIds.len, n, "scopes.parentScopeIds")
    f.kinds = tefcReadI32Column(buf, cursor, 92)
    tefcRequireColumnLen(f.kinds.len, n, "scopes.kinds")
    f.ownerStatementOrdinals = tefcReadI32Column(buf, cursor, 93)
    tefcRequireColumnLen(f.ownerStatementOrdinals.len,
                         n,
                         "scopes.ownerStatementOrdinals")
    f.lexicalOrdinals = tefcReadI32Column(buf, cursor, 94)
    tefcRequireColumnLen(f.lexicalOrdinals.len, n, "scopes.lexicalOrdinals")
    f.startLineNumbers = tefcReadI32Column(buf, cursor, 95)
    tefcRequireColumnLen(f.startLineNumbers.len, n, "scopes.startLineNumbers")
    f.startColumnNumbers = tefcReadI32Column(buf, cursor, 96)
