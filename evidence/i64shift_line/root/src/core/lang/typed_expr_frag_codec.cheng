    tefcRequireColumnLen(
        frag.statements.valueExprRootNodeIndexes.len,
        statementCount,
        "valueExprRootNodeIndexes")
    frag.statements.valueExprSpanStarts =
        tefcReadI32Column(buf, cursor, 117)
    tefcRequireColumnLen(
        frag.statements.valueExprSpanStarts.len,
        statementCount,
        "valueExprSpanStarts")
    frag.statements.valueExprSpanEnds =
        tefcReadI32Column(buf, cursor, 118)
    tefcRequireColumnLen(
        frag.statements.valueExprSpanEnds.len,
        statementCount,
        "valueExprSpanEnds")
    frag.statements.valueExprStatementRoles =
        tefcReadI32Column(buf, cursor, 119)
    tefcRequireColumnLen(
        frag.statements.valueExprStatementRoles.len,
        statementCount,
        "valueExprStatementRoles")
    let nodeCount = frag.nodes.sourcePathIds.len
    frag.nodes.originParserNodeIds =
        tefcReadI32Column(buf, cursor, 120)
    tefcRequireColumnLen(
        frag.nodes.originParserNodeIds.len,
        nodeCount,
        "nodes.originParserNodeIds")
    frag.nodes.syntheticOriginKinds =
        tefcReadI32Column(buf, cursor, 121)
    tefcRequireColumnLen(
        frag.nodes.syntheticOriginKinds.len,
        nodeCount,
        "nodes.syntheticOriginKinds")
    frag.nodes.spanAuthorityKinds =
        tefcReadI32Column(buf, cursor, 122)
    tefcRequireColumnLen(
        frag.nodes.spanAuthorityKinds.len,
        nodeCount,
        "nodes.spanAuthorityKinds")
    frag.nodes.resultTypeProofKinds =
        tefcReadI32Column(buf, cursor, 123)
    tefcRequireColumnLen(
        frag.nodes.resultTypeProofKinds.len,
        nodeCount,
        "nodes.resultTypeProofKinds")
    frag.nodes.resultTypeManagedFlags =
        tefcReadBoolColumn(buf, cursor, 124)
    tefcRequireColumnLen(
        frag.nodes.resultTypeManagedFlags.len,
        nodeCount,
        "nodes.resultTypeManagedFlags")
    frag.nodes.resultTypeSendFlags =
        tefcReadBoolColumn(buf, cursor, 125)
    tefcRequireColumnLen(
        frag.nodes.resultTypeSendFlags.len,
        nodeCount,
        "nodes.resultTypeSendFlags")
    frag.nodes.resultTypeSyncFlags =
        tefcReadBoolColumn(buf, cursor, 126)
    tefcRequireColumnLen(
        frag.nodes.resultTypeSyncFlags.len,
        nodeCount,
        "nodes.resultTypeSyncFlags")
    frag.valueDefinitions.producerSourceIndexes =
        tefcReadI32Column(buf, cursor, 127)
    let definitionCount =
        frag.valueDefinitions.producerSourceIndexes.len
    frag.valueDefinitions.declarationSourceLocalRows =
        tefcReadI32Column(buf, cursor, 128)
    tefcRequireColumnLen(
        frag.valueDefinitions.declarationSourceLocalRows.len,
        definitionCount,
        "valueDefinitions.declarationSourceLocalRows")
    frag.valueDefinitions.patternSourceLocalRows =
        tefcReadI32Column(buf, cursor, 129)
    tefcRequireColumnLen(
        frag.valueDefinitions.patternSourceLocalRows.len,
        definitionCount,
        "valueDefinitions.patternSourceLocalRows")
    frag.valueDefinitions.typedFunctionIndexes =
