        surfaceTextIds: str[]
        paramSlots: int32[]
        paramNameIds: str[]
        paramMutableFlags: bool[]
        operand0NodeIndexs: int32[]
        operand1NodeIndexs: int32[]
        operand2NodeIndexs: int32[]
        literalTextIds: str[]
        callTargetIds: str[]
        callTargetSourcePathIds: str[]
        callTargetSignatureLineNumbers: int32[]
        callTargetImportcs: bool[]
        callKinds: int32[]
        callDeclarationIndexes: int32[]
        funcRefTargetDomains: int32[]
        funcRefCallDeclarationRows: int32[]
        fieldTypeSourcePathIds: str[]
        fieldOffsetBytes: int32[]
        fieldSizeBytes: int32[]
        fieldAlignBytes: int32[]
        elemSizeBytes: int32[]
        bindingParserProducerSourceIndexes: int32[]
        bindingDeclarationSourceLocalRows: int32[]
        bindingPatternSourceLocalRows: int32[]
        bindingValueDefinitionRows: int32[]
        producedValueDefinitionRows: int32[]
        ownerStatementIndexes: int32[]

    TypedExprIrScopesFragment =
        scopeIds: int32[]
        parentScopeIds: int32[]
        kinds: int32[]
        ownerStatementOrdinals: int32[]
        lexicalOrdinals: int32[]
        startLineNumbers: int32[]
        startColumnNumbers: int32[]
        endLineNumbers: int32[]
        endColumnNumbers: int32[]

    TypedExprIrValueDefinitionsFragment =
        originKinds: int32[]
