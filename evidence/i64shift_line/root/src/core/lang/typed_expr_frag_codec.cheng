        callArgCounts: int32[]
        callArgsTextIds: str[]
        callArgTypesTextIds: str[]
        valueExprCallNodeIndexes: int32[]
        valueExprArgRootStarts: int32[]
        valueExprArgRootCounts: int32[]
        valueExprRootNodeIndexes: int32[]
        valueExprSpanStarts: int32[]
        valueExprSpanEnds: int32[]
