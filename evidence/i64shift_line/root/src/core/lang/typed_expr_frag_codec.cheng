        "valueDefinitionGroups.bindingCounts")
    frag.nodes.ownerStatementIndexes =
        tefcReadI32Column(buf, cursor, 158)
    tefcRequireColumnLen(
        frag.nodes.ownerStatementIndexes.len,
        nodeCount,
        "nodes.ownerStatementIndexes")
    frag.nodes.paramMutableFlags =
        tefcReadBoolColumn(buf, cursor, 159)
    tefcRequireColumnLen(
        frag.nodes.paramMutableFlags.len,
        nodeCount,
        "nodes.paramMutableFlags")
    frag.statements.assignLvalueNodeIndexs =
        tefcReadI32Column(buf, cursor, 160)
    tefcRequireColumnLen(
        frag.statements.assignLvalueNodeIndexs.len,
        frag.statements.sourcePathIds.len,
        "statements.assignLvalueNodeIndexs")
    frag.nodes.funcRefTargetDomains =
        tefcReadI32Column(buf, cursor, 161)
    tefcRequireColumnLen(
        frag.nodes.funcRefTargetDomains.len,
        nodeCount,
        "nodes.funcRefTargetDomains")
    frag.nodes.funcRefCallDeclarationRows =
        tefcReadI32Column(buf, cursor, 162)
    tefcRequireColumnLen(
        frag.nodes.funcRefCallDeclarationRows.len,
        nodeCount,
        "nodes.funcRefCallDeclarationRows")
    frag.statements.bindingTargetDefinitionRows =
        tefcReadI32Column(buf, cursor, 163)
    tefcRequireColumnLen(
        frag.statements.bindingTargetDefinitionRows.len,
        frag.statements.sourcePathIds.len,
        "statements.bindingTargetDefinitionRows")
    tefcExpectTag(buf, cursor, 164)
    let borrowsArguments = tefcReadU32(buf, cursor)
    if borrowsArguments != 0 && borrowsArguments != 1:
        panic("typed_expr_frag_codec_borrows_arguments_invalid")
    frag.borrowsArguments = borrowsArguments == 1

@borrows
fn TypedExprIrStatementsFragmentRequireShape(f: TypedExprIrStatementsFragment) =
    let n = f.sourcePathIds.len
    tefcRequireColumnLen(f.functionNameIds.len, n, "functionNameIds")
    tefcRequireColumnLen(f.statementIndexs.len, n, "statementIndexs")
    tefcRequireColumnLen(f.endLineNumbers.len, n, "endLineNumbers")
    tefcRequireColumnLen(f.endColumnNumbers.len, n, "endColumnNumbers")
    tefcRequireColumnLen(f.lexicalScopeIds.len, n, "lexicalScopeIds")
    tefcRequireColumnLen(f.suiteScopeIds.len, n, "suiteScopeIds")
    tefcRequireColumnLen(f.statementOrdinals.len, n, "statementOrdinals")
    tefcRequireColumnLen(f.lexicalOrdinals.len, n, "lexicalOrdinals")
    tefcRequireColumnLen(f.deferOwnerStatementOrdinals.len, n, "deferOwnerStatementOrdinals")
    tefcRequireColumnLen(f.callTargetSignatureLineNumbers.len,
                         n,
                         "callTargetSignatureLineNumbers")
    tefcRequireColumnLen(
        f.valueExprCallNodeIndexes.len, n, "valueExprCallNodeIndexes")
    tefcRequireColumnLen(
        f.valueExprArgRootStarts.len, n, "valueExprArgRootStarts")
    tefcRequireColumnLen(
        f.valueExprArgRootCounts.len, n, "valueExprArgRootCounts")
    tefcRequireColumnLen(
        f.valueExprRootNodeIndexes.len, n, "valueExprRootNodeIndexes")
    tefcRequireColumnLen(
        f.valueExprSpanStarts.len, n, "valueExprSpanStarts")
    tefcRequireColumnLen(
        f.valueExprSpanEnds.len, n, "valueExprSpanEnds")
    tefcRequireColumnLen(
        f.valueExprStatementRoles.len, n, "valueExprStatementRoles")
    tefcRequireColumnLen(f.callArgNodeStarts.len, n, "callArgNodeStarts")
    tefcRequireColumnLen(f.callArgNodeCounts.len, n, "callArgNodeCounts")
    tefcRequireColumnLen(f.rhsNodeIndexs.len, n, "rhsNodeIndexs")
    tefcRequireColumnLen(f.forStartNodeIndexs.len, n, "forStartNodeIndexs")
    tefcRequireColumnLen(
        f.assignIndexNodeIndexs.len, n, "assignIndexNodeIndexs")
    tefcRequireColumnLen(
        f.assignLvalueNodeIndexs.len, n, "assignLvalueNodeIndexs")
    tefcRequireColumnLen(
        f.bindingTargetDefinitionRows.len, n,
        "bindingTargetDefinitionRows")
    tefcRequireColumnLen(f.kinds.len, n, "kinds")

@borrows
fn TypedExprIrScopesFragmentRequireShape(f: TypedExprIrScopesFragment) =
    let n = f.scopeIds.len
    tefcRequireColumnLen(f.parentScopeIds.len, n, "scopes.parentScopeIds")
    tefcRequireColumnLen(f.kinds.len, n, "scopes.kinds")
    tefcRequireColumnLen(f.ownerStatementOrdinals.len, n, "scopes.ownerStatementOrdinals")
    tefcRequireColumnLen(f.lexicalOrdinals.len, n, "scopes.lexicalOrdinals")
    tefcRequireColumnLen(f.startLineNumbers.len, n, "scopes.startLineNumbers")
    tefcRequireColumnLen(f.startColumnNumbers.len, n, "scopes.startColumnNumbers")
    tefcRequireColumnLen(f.endLineNumbers.len, n, "scopes.endLineNumbers")
    tefcRequireColumnLen(f.endColumnNumbers.len, n, "scopes.endColumnNumbers")

@borrows
fn TypedExprIrNodesFragmentRequireShape(f: TypedExprIrNodesFragment) =
    let n = f.sourcePathIds.len
    tefcRequireColumnLen(f.functionNameIds.len, n, "nodes.functionNameIds")
    tefcRequireColumnLen(f.nodeIndexs.len, n, "nodes.nodeIndexs")
    tefcRequireColumnLen(
        f.originParserNodeIds.len, n, "nodes.originParserNodeIds")
    tefcRequireColumnLen(
        f.syntheticOriginKinds.len, n, "nodes.syntheticOriginKinds")
    tefcRequireColumnLen(
        f.spanAuthorityKinds.len, n, "nodes.spanAuthorityKinds")
    tefcRequireColumnLen(f.opKinds.len, n, "nodes.opKinds")
    tefcRequireColumnLen(f.exprClasses.len, n, "nodes.exprClasses")
    tefcRequireColumnLen(
        f.resultTypeProofKinds.len, n, "nodes.resultTypeProofKinds")
    tefcRequireColumnLen(
        f.resultTypeManagedFlags.len, n, "nodes.resultTypeManagedFlags")
    tefcRequireColumnLen(
        f.resultTypeSendFlags.len, n, "nodes.resultTypeSendFlags")
    tefcRequireColumnLen(
        f.resultTypeSyncFlags.len, n, "nodes.resultTypeSyncFlags")
    tefcRequireColumnLen(
        f.paramMutableFlags.len, n, "nodes.paramMutableFlags")
    tefcRequireColumnLen(
        f.lastUseMoveValueDefIds.len,
        n,
        "nodes.lastUseMoveValueDefIds")
    tefcRequireColumnLen(
        f.bindingParserProducerSourceIndexes.len,
        n,
        "nodes.bindingParserProducerSourceIndexes")
    tefcRequireColumnLen(
        f.bindingDeclarationSourceLocalRows.len,
        n,
        "nodes.bindingDeclarationSourceLocalRows")
    tefcRequireColumnLen(
        f.bindingPatternSourceLocalRows.len,
        n,
        "nodes.bindingPatternSourceLocalRows")
    tefcRequireColumnLen(
        f.bindingValueDefinitionRows.len,
        n,
        "nodes.bindingValueDefinitionRows")
    tefcRequireColumnLen(
        f.producedValueDefinitionRows.len,
        n,
        "nodes.producedValueDefinitionRows")
    tefcRequireColumnLen(
        f.ownerStatementIndexes.len,
        n,
        "nodes.ownerStatementIndexes")
    tefcRequireColumnLen(
        f.structuralTypeIds.len, n, "nodes.structuralTypeIds")
    tefcRequireColumnLen(
        f.operand0NodeIndexs.len, n, "nodes.operand0NodeIndexs")
    tefcRequireColumnLen(
        f.operand1NodeIndexs.len, n, "nodes.operand1NodeIndexs")
    tefcRequireColumnLen(
        f.operand2NodeIndexs.len, n, "nodes.operand2NodeIndexs")
    tefcRequireColumnLen(f.callTargetIds.len, n, "nodes.callTargetIds")
    tefcRequireColumnLen(f.callTargetSourcePathIds.len,
                         n,
                         "nodes.callTargetSourcePathIds")
    tefcRequireColumnLen(f.callTargetSignatureLineNumbers.len,
                         n,
                         "nodes.callTargetSignatureLineNumbers")
    tefcRequireColumnLen(f.callTargetImportcs.len,
                         n,
                         "nodes.callTargetImportcs")
    tefcRequireColumnLen(f.callKinds.len,
                         n,
                         "nodes.callKinds")
    tefcRequireColumnLen(f.callDeclarationIndexes.len,
                         n,
                         "nodes.callDeclarationIndexes")
    tefcRequireColumnLen(f.funcRefTargetDomains.len,
                         n,
                         "nodes.funcRefTargetDomains")
    tefcRequireColumnLen(f.funcRefCallDeclarationRows.len,
                         n,
                         "nodes.funcRefCallDeclarationRows")
    tefcRequireColumnLen(f.fieldTypeSourcePathIds.len,
                         n,
                         "nodes.fieldTypeSourcePathIds")
    tefcRequireColumnLen(f.fieldAlignBytes.len,
                         n,
                         "nodes.fieldAlignBytes")

@borrows
fn TypedExprIrValueDefinitionsFragmentRequireShape(
        f: TypedExprIrValueDefinitionsFragment) =
    let n = f.producerSourceIndexes.len
    tefcRequireColumnLen(
        f.originKinds.len, n, "valueDefinitions.originKinds")
    tefcRequireColumnLen(
        f.sourceLocalNodeIndexes.len,
        n,
        "valueDefinitions.sourceLocalNodeIndexes")
    tefcRequireColumnLen(
        f.declarationSourceLocalRows.len,
        n,
        "valueDefinitions.declarationSourceLocalRows")
    tefcRequireColumnLen(
        f.patternSourceLocalRows.len,
        n,
        "valueDefinitions.patternSourceLocalRows")
    tefcRequireColumnLen(
        f.typedFunctionIndexes.len,
        n,
        "valueDefinitions.typedFunctionIndexes")
    tefcRequireColumnLen(
        f.definingTypedNodeIndexes.len,
        n,
        "valueDefinitions.definingTypedNodeIndexes")
    tefcRequireColumnLen(
        f.exactTypeIds.len,
        n,
        "valueDefinitions.exactTypeIds")
    tefcRequireColumnLen(
        f.ownerships.len,
        n,
        "valueDefinitions.ownerships")
    tefcRequireColumnLen(
        f.proofKinds.len,
        n,
        "valueDefinitions.proofKinds")
    tefcRequireColumnLen(
        f.groupRows.len,
        n,
        "valueDefinitions.groupRows")

@borrows
fn TypedExprIrValueDefinitionGroupsFragmentRequireShape(
        f: TypedExprIrValueDefinitionGroupsFragment) =
    let n = f.producerSourceIndexes.len
    tefcRequireColumnLen(
        f.parserProducerSourceIndexes.len,
        n,
        "valueDefinitionGroups.parserProducerSourceIndexes")
    tefcRequireColumnLen(
        f.initializerRootSourceLocalNodeIndexes.len,
        n,
        "valueDefinitionGroups.initializerRootSourceLocalNodeIndexes")
    tefcRequireColumnLen(
        f.bindingOffsets.len,
        n,
        "valueDefinitionGroups.bindingOffsets")
    tefcRequireColumnLen(
        f.bindingCounts.len,
        n,
        "valueDefinitionGroups.bindingCounts")
    tefcRequireColumnLen(
        f.typedFunctionIndexes.len,
        n,
        "valueDefinitionGroups.typedFunctionIndexes")
    tefcRequireColumnLen(
        f.declarationSourceLocalRows.len,
        n,
        "valueDefinitionGroups.declarationSourceLocalRows")
    tefcRequireColumnLen(
        f.patternSourceLocalRows.len,
        n,
        "valueDefinitionGroups.patternSourceLocalRows")
    tefcRequireColumnLen(
        f.definitionRows.len,
        n,
        "valueDefinitionGroups.definitionRows")
    tefcRequireColumnLen(
        f.consumedFlags.len,
        n,
        "valueDefinitionGroups.consumedFlags")

fn tefcPositionAtOrBefore(lhsLine: int32,
                           lhsColumn: int32,
                           rhsLine: int32,
                           rhsColumn: int32): bool =
    if lhsLine < rhsLine:
        return true
    if lhsLine > rhsLine:
        return false
    return lhsColumn <= rhsColumn

@borrows
fn tefcMarkStatementOwnerRoot(
        frag: TypedExprIrFunctionFragment,
        statementIndex: int32,
        rootNodeIndex: int32,
        rootObserved: var bool[]) =
    if rootNodeIndex == -1:
        return
    if rootNodeIndex < 0 ||
       rootNodeIndex >= frag.nodes.nodeIndexs.len ||
       frag.nodes.ownerStatementIndexes[rootNodeIndex] !=
           statementIndex:
        panic("typed_expr_frag_codec_statement_root_owner_invalid")
    rootObserved[rootNodeIndex] = true

@borrows
fn tefcValueDefinitionOwnershipMatchesNode(
        frag: TypedExprIrFunctionFragment,
        originKind: int32,
        definingNodeIndex: int32,
        ownership: int32): bool =
    if definingNodeIndex < 0 ||
       definingNodeIndex >= frag.nodes.nodeIndexs.len:
        return false
    let nodeOwnership = frag.nodes.exprClasses[definingNodeIndex]
    if originKind !=
           int32(texpr.TypedExprValueDefinitionOriginParameter):
        return ownership == nodeOwnership
    if frag.nodes.opKinds[definingNodeIndex] !=
           int32(texpr.TypedExprIrOpParamRef):
        return false
    let managed =
        frag.nodes.resultTypeManagedFlags[definingNodeIndex]
    let mutableFlag = frag.nodes.paramMutableFlags[definingNodeIndex]
    if nodeOwnership == int32(texpr.TypedExprExprUnmanaged):
        return !managed &&
               ownership == int32(texpr.TypedExprExprUnmanaged)
    if nodeOwnership != int32(texpr.TypedExprExprBorrowed):
        return false
    if mutableFlag || frag.borrowsArguments:
        return ownership == int32(texpr.TypedExprExprBorrowed)
    return managed && ownership == int32(texpr.TypedExprExprOwned)

@borrows
fn TypedExprIrFunctionFragmentValidate(frag: TypedExprIrFunctionFragment) =
    TypedExprIrStatementsFragmentRequireShape(frag.statements)
    TypedExprIrNodesFragmentRequireShape(frag.nodes)
    TypedExprIrScopesFragmentRequireShape(frag.scopes)
    TypedExprIrValueDefinitionsFragmentRequireShape(
        frag.valueDefinitions)
    TypedExprIrValueDefinitionGroupsFragmentRequireShape(
        frag.valueDefinitionGroups)
    if frag.sourcePath == "" || frag.functionName == "" ||
       frag.signatureLineNumber <= 0 ||
       frag.bodyLineNumber < frag.signatureLineNumber ||
       frag.endLineNumber < frag.bodyLineNumber ||
       frag.returnType == "":
        panic("typed_expr_frag_codec_function_authority_invalid")
    if frag.scopeStart != 0 || frag.scopeCount <= 0 ||
       frag.scopeCount != frag.scopes.scopeIds.len:
        panic("typed_expr_frag_codec_function_scope_range_invalid")
    if frag.resultExprClass != int32(texpr.TypedExprExprOwned) &&
       frag.resultExprClass != int32(texpr.TypedExprExprBorrowed):
        panic("typed_expr_frag_codec_function_result_expr_class_invalid")
    if frag.returnNodeIndex < -1 ||
       frag.returnNodeIndex >= frag.nodes.nodeIndexs.len:
        panic("typed_expr_frag_codec_function_return_node_not_local")
    let definitionCount =
        frag.valueDefinitions.producerSourceIndexes.len
    let groupCount =
        frag.valueDefinitionGroups.producerSourceIndexes.len
    if frag.valueDefinitionCount != definitionCount ||
       frag.valueDefinitionGroupCount != groupCount ||
       frag.valueDefinitionTypeArenaArtifactCid.len != 64:
        panic("typed_expr_frag_codec_value_definition_coverage_invalid")
    var valueDefinitionTypeArenaBound: bool
    for index in 0..<frag.valueDefinitionTypeArenaArtifactCid.len:
        if frag.valueDefinitionTypeArenaArtifactCid[index] != '0':
            valueDefinitionTypeArenaBound = true
    let statementCount = frag.statements.sourcePathIds.len
    var ownerRootObserved: bool[]
    var ownerHasParent: bool[]
    setLen(ownerRootObserved, frag.nodes.sourcePathIds.len)
    setLen(ownerHasParent, frag.nodes.sourcePathIds.len)
    for statementIndex in 0..<statementCount:
        tefcMarkStatementOwnerRoot(
            frag,
            statementIndex,
            frag.statements.rhsNodeIndexs[statementIndex],
            ownerRootObserved)
        # valueExprRootNodeIndexes/valueExprCallNodeIndexes are immutable rows
        # in the parser forest, not TypedIR node identities. Their producer and
        # source-local coordinates are validated by the parser authority path.
        tefcMarkStatementOwnerRoot(
            frag,
            statementIndex,
            frag.statements.callArgNodeStarts[statementIndex],
            ownerRootObserved)
        tefcMarkStatementOwnerRoot(
            frag,
            statementIndex,
            frag.statements.forStartNodeIndexs[statementIndex],
            ownerRootObserved)
        tefcMarkStatementOwnerRoot(
            frag,
            statementIndex,
            frag.statements.assignLvalueNodeIndexs[statementIndex],
            ownerRootObserved)
        tefcMarkStatementOwnerRoot(
            frag,
            statementIndex,
            frag.statements.assignIndexNodeIndexs[statementIndex],
            ownerRootObserved)
    for nodeIndex in 0..<frag.nodes.sourcePathIds.len:
        if frag.nodes.nodeIndexs[nodeIndex] != nodeIndex:
            panic("typed_expr_frag_codec_node_index_not_dense")
        let operand0 = frag.nodes.operand0NodeIndexs[nodeIndex]
        let operand1 = frag.nodes.operand1NodeIndexs[nodeIndex]
        let operand2 = frag.nodes.operand2NodeIndexs[nodeIndex]
        if operand0 < -1 || operand0 >= nodeIndex ||
           operand1 < -1 || operand1 >= nodeIndex ||
           operand2 < -1 || operand2 >= nodeIndex:
            panic("typed_expr_frag_codec_node_operand_not_local")
        let ownerStatementIndex =
            frag.nodes.ownerStatementIndexes[nodeIndex]
        if ownerStatementIndex < -1 ||
           ownerStatementIndex >= statementCount:
            panic("typed_expr_frag_codec_node_owner_statement_invalid")
        if (ownerStatementIndex >= 0 &&
            (frag.nodes.sourcePathIds[nodeIndex] !=
                frag.statements.sourcePathIds[ownerStatementIndex] ||
            frag.nodes.functionNameIds[nodeIndex] !=
                frag.statements.functionNameIds[
                    ownerStatementIndex])) ||
           (operand0 >= 0 &&
            frag.nodes.ownerStatementIndexes[operand0] !=
                ownerStatementIndex) ||
           (operand1 >= 0 &&
            frag.nodes.ownerStatementIndexes[operand1] !=
                ownerStatementIndex) ||
           (operand2 >= 0 &&
            frag.nodes.ownerStatementIndexes[operand2] !=
                ownerStatementIndex):
            panic("typed_expr_frag_codec_node_owner_statement_drift")
        if operand0 >= 0:
            ownerHasParent[operand0] = true
        if operand1 >= 0:
            ownerHasParent[operand1] = true
        if operand2 >= 0:
            ownerHasParent[operand2] = true
        let target = frag.nodes.callTargetIds[nodeIndex]
        let targetSource = frag.nodes.callTargetSourcePathIds[nodeIndex]
        let targetSignatureLineNumber =
            frag.nodes.callTargetSignatureLineNumbers[nodeIndex]
        let declarationIndex = frag.nodes.callDeclarationIndexes[nodeIndex]
        let funcRefTargetDomain =
            frag.nodes.funcRefTargetDomains[nodeIndex]
        let funcRefCallDeclarationRow =
            frag.nodes.funcRefCallDeclarationRows[nodeIndex]
        let callKind = frag.nodes.callKinds[nodeIndex]
        if (target == "") != (targetSource == ""):
            panic("typed_expr_frag_codec_node_call_owner_incomplete")
        if targetSignatureLineNumber < 0 ||
           (target == "" && targetSignatureLineNumber != 0) ||
           (frag.nodes.callTargetImportcs[nodeIndex] &&
            targetSignatureLineNumber != 0):
            panic("typed_expr_frag_codec_node_call_identity_invalid")
        if frag.nodes.opKinds[nodeIndex] != int32(texpr.TypedExprIrOpCallExpr) &&
           (target != "" || targetSource != "" ||
            targetSignatureLineNumber != 0 ||
            frag.nodes.callTargetImportcs[nodeIndex] ||
            callKind != int32(texpr.TypedExprCallNone) ||
            declarationIndex != -1):
            panic("typed_expr_frag_codec_non_call_node_has_call_owner")
        if callKind < int32(texpr.TypedExprCallNone) ||
           callKind > int32(texpr.TypedExprCallProjection):
            panic("typed_expr_frag_codec_call_kind_invalid")
        if declarationIndex >= 0 &&
           callKind != int32(texpr.TypedExprCallNone):
            panic("typed_expr_frag_codec_declaration_call_has_intrinsic_kind")
        if callKind != int32(texpr.TypedExprCallNone) &&
           (target != "" || targetSource != "" ||
            targetSignatureLineNumber != 0 ||
            frag.nodes.callTargetImportcs[nodeIndex]):
            panic("typed_expr_frag_codec_intrinsic_call_has_declaration_identity")
        if frag.nodes.opKinds[nodeIndex] ==
               int32(texpr.TypedExprIrOpCallExpr) &&
           declarationIndex < 0 && target == "" &&
           callKind == int32(texpr.TypedExprCallNone):
            panic("typed_expr_frag_codec_call_identity_missing")
        if declarationIndex < -1:
            panic("typed_expr_frag_codec_call_declaration_index_invalid")
        if frag.nodes.opKinds[nodeIndex] ==
               int32(texpr.TypedExprIrOpFuncRef):
            if funcRefTargetDomain !=
                   int32(
                       texpr.TypedExprFuncRefTargetDomainCallDeclaration) ||
               funcRefCallDeclarationRow < 0:
                panic("typed_expr_frag_codec_funcref_identity_missing")
        elif funcRefTargetDomain !=
                 int32(texpr.TypedExprFuncRefTargetDomainNone) ||
             funcRefCallDeclarationRow != -1:
            panic("typed_expr_frag_codec_non_funcref_has_target_identity")
        let isFieldNode =
            frag.nodes.opKinds[nodeIndex] == int32(texpr.TypedExprIrOpFieldGet)
        if isFieldNode &&
           (frag.nodes.fieldTypeSourcePathIds[nodeIndex] == "" ||
            frag.nodes.fieldOffsetBytes[nodeIndex] < 0 ||
            frag.nodes.fieldSizeBytes[nodeIndex] <= 0 ||
            frag.nodes.fieldAlignBytes[nodeIndex] <= 0):
            panic("typed_expr_frag_codec_field_node_authority_invalid")
        if !isFieldNode && frag.nodes.fieldTypeSourcePathIds[nodeIndex] != "":
            panic("typed_expr_frag_codec_non_field_node_has_field_owner")
        let exprClass = frag.nodes.exprClasses[nodeIndex]
        if exprClass < int32(texpr.TypedExprExprUnknown) ||
           exprClass > int32(texpr.TypedExprExprUnmanaged):
            panic("typed_expr_frag_codec_node_expr_class_invalid")
        let typeProofKind =
            frag.nodes.resultTypeProofKinds[nodeIndex]
        if frag.nodes.originParserNodeIds[nodeIndex] < -1 ||
           frag.nodes.syntheticOriginKinds[nodeIndex] < 0 ||
           frag.nodes.spanAuthorityKinds[nodeIndex] < 0 ||
           typeProofKind <
               texpr.TypedExprSnapshotTypeProofNone ||
           typeProofKind >
               texpr.TypedExprSnapshotTypeProofAggregate ||
           (typeProofKind ==
                texpr.TypedExprSnapshotTypeProofNone &&
            (frag.nodes.resultTypeManagedFlags[nodeIndex] ||
             frag.nodes.resultTypeSendFlags[nodeIndex] ||
             frag.nodes.resultTypeSyncFlags[nodeIndex])):
            panic("typed_expr_frag_codec_node_proof_invalid")
        let lastUseMoveValueDefId =
            frag.nodes.lastUseMoveValueDefIds[nodeIndex]
        if lastUseMoveValueDefId != -1:
            panic("typed_expr_frag_codec_last_use_move_producer_unavailable")
        let bindingProducer =
            frag.nodes.bindingParserProducerSourceIndexes[nodeIndex]
        let bindingDeclaration =
            frag.nodes.bindingDeclarationSourceLocalRows[nodeIndex]
        let bindingPattern =
            frag.nodes.bindingPatternSourceLocalRows[nodeIndex]
        let bindingDefinition =
            frag.nodes.bindingValueDefinitionRows[nodeIndex]
        let bindingOp = frag.nodes.opKinds[nodeIndex]
        if bindingOp != int32(texpr.TypedExprIrOpParamRef) &&
           frag.nodes.paramMutableFlags[nodeIndex]:
            panic("typed_expr_frag_codec_non_param_mutable_authority")
        let producedDefinition =
            frag.nodes.producedValueDefinitionRows[nodeIndex]
        let originParserNodeId =
            frag.nodes.originParserNodeIds[nodeIndex]
        if producedDefinition < -1 ||
           producedDefinition >= definitionCount ||
           (producedDefinition >= 0 &&
            frag.valueDefinitions.definingTypedNodeIndexes[
                producedDefinition] != nodeIndex):
            panic("typed_expr_frag_codec_produced_definition_invalid")
        if bindingProducer == -1 && bindingDeclaration == -1 &&
           bindingPattern == -1 && bindingDefinition == -1:
            if originParserNodeId >= 0 &&
               (bindingOp == int32(texpr.TypedExprIrOpParamRef) ||
                bindingOp == int32(texpr.TypedExprIrOpLocalRef)):
                panic("typed_expr_frag_codec_source_binding_missing")
            continue
        if (bindingOp != int32(texpr.TypedExprIrOpParamRef) &&
            bindingOp != int32(texpr.TypedExprIrOpLocalRef)) ||
           bindingProducer < 0 || bindingDeclaration < 0 ||
           originParserNodeId < 0 ||
           frag.nodes.syntheticOriginKinds[nodeIndex] !=
               texpr.TypedExprSyntheticOriginNone ||
           frag.nodes.spanAuthorityKinds[nodeIndex] !=
               texpr.TypedExprSpanAuthorityParserNode:
            panic("typed_expr_frag_codec_binding_origin_invalid")
        if bindingOp == int32(texpr.TypedExprIrOpParamRef):
            if bindingPattern != -1 ||
               bindingDefinition < 0 ||
               bindingDefinition >= definitionCount ||
               frag.valueDefinitions.originKinds[bindingDefinition] !=
                   int32(
                       texpr.TypedExprValueDefinitionOriginParameter):
                panic("typed_expr_frag_codec_parameter_binding_rows_invalid")
            continue
        if bindingOp != int32(texpr.TypedExprIrOpLocalRef) ||
           bindingPattern < 0 || bindingDefinition < 0 ||
           bindingDefinition >= definitionCount:
            panic("typed_expr_frag_codec_local_binding_rows_invalid")
        let bindingGroup =
            frag.valueDefinitions.groupRows[bindingDefinition]
        if frag.valueDefinitions.declarationSourceLocalRows[
               bindingDefinition] != bindingDeclaration ||
           frag.valueDefinitions.patternSourceLocalRows[
               bindingDefinition] != bindingPattern ||
           bindingGroup < 0 || bindingGroup >= groupCount ||
           frag.valueDefinitionGroups.parserProducerSourceIndexes[
               bindingGroup] != bindingProducer ||
           frag.valueDefinitionGroups.definitionRows[
               bindingGroup] != bindingDefinition:
            panic("typed_expr_frag_codec_local_binding_definition_drift")
    for definitionRow in 0..<definitionCount:
        let definingNodeIndex =
            frag.valueDefinitions.definingTypedNodeIndexes[
                definitionRow]
        let ownership =
            frag.valueDefinitions.ownerships[definitionRow]
        let proofKind =
            frag.valueDefinitions.proofKinds[definitionRow]
        let originKind =
            frag.valueDefinitions.originKinds[definitionRow]
        let sourceLocalNodeIndex =
            frag.valueDefinitions.sourceLocalNodeIndexes[
                definitionRow]
        let groupRow =
            frag.valueDefinitions.groupRows[definitionRow]
        if frag.valueDefinitions.producerSourceIndexes[
               definitionRow] < 0 ||
           frag.valueDefinitions.typedFunctionIndexes[
               definitionRow] != 0 ||
           definingNodeIndex < 0 ||
           definingNodeIndex >= frag.nodes.nodeIndexs.len ||
           frag.nodes.producedValueDefinitionRows[
               definingNodeIndex] != definitionRow ||
           (valueDefinitionTypeArenaBound &&
            frag.valueDefinitions.exactTypeIds[definitionRow] < 0) ||
           (!valueDefinitionTypeArenaBound &&
            frag.valueDefinitions.exactTypeIds[definitionRow] != -1) ||
           ownership <= int32(texpr.TypedExprExprUnknown) ||
           ownership > int32(texpr.TypedExprExprUnmanaged) ||
           proofKind < texpr.TypedExprSnapshotTypeProofNone ||
           proofKind > texpr.TypedExprSnapshotTypeProofAggregate ||
           frag.valueDefinitions.exactTypeIds[definitionRow] !=
               frag.nodes.structuralTypeIds[definingNodeIndex] ||
           !tefcValueDefinitionOwnershipMatchesNode(
               frag, originKind, definingNodeIndex, ownership) ||
           proofKind !=
               frag.nodes.resultTypeProofKinds[definingNodeIndex]:
            panic("typed_expr_frag_codec_value_definition_invalid")
        if originKind ==
               int32(texpr.TypedExprValueDefinitionOriginParameter):
            if sourceLocalNodeIndex != -1 ||
               frag.valueDefinitions.declarationSourceLocalRows[
                   definitionRow] < 0 ||
               frag.valueDefinitions.patternSourceLocalRows[
                   definitionRow] != -1 ||
               groupRow != -1:
                panic("typed_expr_frag_codec_parameter_definition_invalid")
        elif originKind ==
                 int32(
                     texpr.TypedExprValueDefinitionOriginBindingInitializer):
            if sourceLocalNodeIndex < 0 ||
               frag.valueDefinitions.declarationSourceLocalRows[
                   definitionRow] < 0 ||
               frag.valueDefinitions.patternSourceLocalRows[
                   definitionRow] < 0 ||
               groupRow < 0 || groupRow >= groupCount ||
               frag.valueDefinitionGroups.definitionRows[groupRow] !=
                   definitionRow:
                panic("typed_expr_frag_codec_binding_definition_invalid")
        elif originKind ==
                 int32(texpr.TypedExprValueDefinitionOriginCallResult):
            if sourceLocalNodeIndex < 0 ||
               frag.valueDefinitions.declarationSourceLocalRows[
                   definitionRow] != -1 ||
               frag.valueDefinitions.patternSourceLocalRows[
                   definitionRow] != -1 ||
               groupRow != -1 ||
               frag.nodes.opKinds[definingNodeIndex] !=
                   int32(texpr.TypedExprIrOpCallExpr):
                panic("typed_expr_frag_codec_call_result_definition_invalid")
        elif originKind ==
                 int32(
                     texpr.TypedExprValueDefinitionOriginManagedTemporary):
            if sourceLocalNodeIndex < 0 ||
               frag.valueDefinitions.declarationSourceLocalRows[
                   definitionRow] != -1 ||
               frag.valueDefinitions.patternSourceLocalRows[
                   definitionRow] != -1 ||
               groupRow != -1 ||
               ownership != int32(texpr.TypedExprExprOwned) ||
               !frag.nodes.resultTypeManagedFlags[definingNodeIndex] ||
               frag.nodes.originParserNodeIds[definingNodeIndex] !=
                   sourceLocalNodeIndex ||
               frag.nodes.syntheticOriginKinds[definingNodeIndex] !=
                   texpr.TypedExprSyntheticOriginNone ||
               frag.nodes.spanAuthorityKinds[definingNodeIndex] !=
                   texpr.TypedExprSpanAuthorityParserNode ||
               !texpr.TypedExprIrOpIsExactManagedTemporaryProducer(
                   texpr.TypedExprIrOpKind(
                       frag.nodes.opKinds[definingNodeIndex])):
                panic("typed_expr_frag_codec_managed_temporary_definition_invalid")
        else:
            panic("typed_expr_frag_codec_value_definition_origin_invalid")
        if frag.nodes.resultTypeManagedFlags[definingNodeIndex] &&
           proofKind == texpr.TypedExprSnapshotTypeProofNone:
            panic("typed_expr_frag_codec_managed_value_proof_missing")
        let ownerStatementIndex =
            frag.nodes.ownerStatementIndexes[definingNodeIndex]
        # [w48] decl-local 零值定义模板（typed_expr w24/w34 detached NilPtr
        # 载体，裸 `var n: Node` 家族的声明性定义）是离语句载体：定义于声明
        # 语句本身而非任何表达式求值，owner=-1 与参数行同族（参数豁免臂的
        # 声明性对应物）。放行臂与生产侧内部审计
        # TypedExprValueDefinitionAuthorityStrictValidateInto 的
        # detachedZeroDeclarationTemplate 指纹逐列同款（BindingInitializer
        # origin + owner=-1 + NilPtr + parser origin=-1 + Desugared +
        # NoSource）；任一列不符仍走下方原判词，零弱化。
        let detachedZeroDeclarationTemplate =
            originKind ==
                int32(
                    texpr.TypedExprValueDefinitionOriginBindingInitializer) &&
            ownerStatementIndex == -1 &&
            frag.nodes.opKinds[definingNodeIndex] ==
                int32(texpr.TypedExprIrOpNilPtr) &&
            frag.nodes.originParserNodeIds[definingNodeIndex] == -1 &&
            frag.nodes.syntheticOriginKinds[definingNodeIndex] ==
                texpr.TypedExprSyntheticOriginDesugared &&
            frag.nodes.spanAuthorityKinds[definingNodeIndex] ==
                texpr.TypedExprSpanAuthorityNoSource
        if !detachedZeroDeclarationTemplate &&
           ((originKind ==
                int32(
                    texpr.TypedExprValueDefinitionOriginParameter) &&
            ownerStatementIndex != -1) ||
           (originKind !=
                int32(
                    texpr.TypedExprValueDefinitionOriginParameter) &&
            ownerStatementIndex < 0)):
            panic("typed_expr_frag_codec_value_definition_owner_statement_invalid")
    for nodeIndex in 0..<frag.nodes.sourcePathIds.len:
        if frag.nodes.ownerStatementIndexes[nodeIndex] >= 0 &&
           !ownerRootObserved[nodeIndex] &&
           !ownerHasParent[nodeIndex]:
            panic("typed_expr_frag_codec_node_owner_statement_disconnected")
    seqs.FreeSeq(ownerRootObserved)
    seqs.FreeSeq(ownerHasParent)
    var previousInitializerRootSourceLocalNodeIndex: int32 = -1
    var previousPatternSourceLocalRow: int32 = -1
    var previousBindingOffset: int32 = -1
    var previousBindingCount: int32
    for groupRow in 0..<groupCount:
        let initializerRootSourceLocalNodeIndex =
            frag.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes[
                groupRow]
        let patternSourceLocalRow =
            frag.valueDefinitionGroups.patternSourceLocalRows[groupRow]
        let bindingOffset =
            frag.valueDefinitionGroups.bindingOffsets[groupRow]
        let bindingCount =
            frag.valueDefinitionGroups.bindingCounts[groupRow]
        if initializerRootSourceLocalNodeIndex <
               previousInitializerRootSourceLocalNodeIndex ||
           bindingOffset < 0 || bindingCount <= 0 ||
           bindingOffset >= bindingCount ||
           (initializerRootSourceLocalNodeIndex ==
                previousInitializerRootSourceLocalNodeIndex &&
            (patternSourceLocalRow <= previousPatternSourceLocalRow ||
             bindingOffset != previousBindingOffset + 1 ||
             bindingCount != previousBindingCount)) ||
           (initializerRootSourceLocalNodeIndex >
                previousInitializerRootSourceLocalNodeIndex &&
            (bindingOffset != 0 ||
             (previousInitializerRootSourceLocalNodeIndex >= 0 &&
              previousBindingOffset != previousBindingCount - 1))):
            panic("typed_expr_frag_codec_value_definition_root_csr_invalid")
        if frag.valueDefinitionGroups.producerSourceIndexes[
               groupRow] < 0 ||
           frag.valueDefinitionGroups.parserProducerSourceIndexes[
               groupRow] < 0 ||
           frag.valueDefinitionGroups.typedFunctionIndexes[
               groupRow] != 0 ||
           frag.valueDefinitionGroups.declarationSourceLocalRows[
               groupRow] < 0 ||
           frag.valueDefinitionGroups.patternSourceLocalRows[
               groupRow] < 0 ||
           frag.valueDefinitionGroups.definitionRows[groupRow] < 0 ||
           frag.valueDefinitionGroups.definitionRows[groupRow] >=
               definitionCount ||
           frag.valueDefinitionGroups.consumedFlags[groupRow] != 1 ||
           frag.valueDefinitions.originKinds[
               frag.valueDefinitionGroups.definitionRows[groupRow]] !=
               int32(
                   texpr.TypedExprValueDefinitionOriginBindingInitializer) ||
           frag.valueDefinitions.groupRows[
               frag.valueDefinitionGroups.definitionRows[groupRow]] !=
               groupRow ||
           frag.valueDefinitions.producerSourceIndexes[
               frag.valueDefinitionGroups.definitionRows[groupRow]] !=
               frag.valueDefinitionGroups.producerSourceIndexes[
                   groupRow] ||
           frag.valueDefinitions.declarationSourceLocalRows[
               frag.valueDefinitionGroups.definitionRows[groupRow]] !=
               frag.valueDefinitionGroups.declarationSourceLocalRows[
                   groupRow] ||
           frag.valueDefinitions.patternSourceLocalRows[
               frag.valueDefinitionGroups.definitionRows[groupRow]] !=
               frag.valueDefinitionGroups.patternSourceLocalRows[
                   groupRow]:
            panic("typed_expr_frag_codec_value_definition_group_invalid")
        previousInitializerRootSourceLocalNodeIndex =
            initializerRootSourceLocalNodeIndex
        previousPatternSourceLocalRow = patternSourceLocalRow
        previousBindingOffset = bindingOffset
        previousBindingCount = bindingCount
    if groupCount > 0 &&
       previousBindingOffset != previousBindingCount - 1:
        panic("typed_expr_frag_codec_value_definition_root_csr_incomplete")
    var ordinalRows: int32[]
    setLen(ordinalRows, statementCount)
    for i in 0..<statementCount:
        ordinalRows[i] = -1
    var structuredStatementCount: int32
    for i in 0..<statementCount:
        if frag.statements.statementIndexs[i] != i:
            panic("typed_expr_frag_codec_statement_index_not_dense")
        if frag.statements.sourcePathIds[i] != frag.sourcePath ||
           frag.statements.functionNameIds[i] != frag.functionName:
            panic("typed_expr_frag_codec_statement_identity_mismatch")
        let callArgNodeStart = frag.statements.callArgNodeStarts[i]
        let callArgNodeCount = frag.statements.callArgNodeCounts[i]
        if callArgNodeCount < 0 ||
           (callArgNodeCount == 0 &&
            (callArgNodeStart < -1 ||
             callArgNodeStart > frag.nodes.nodeIndexs.len)) ||
           (callArgNodeCount > 0 &&
            (callArgNodeStart < 0 ||
             callArgNodeStart + callArgNodeCount >
                 frag.nodes.nodeIndexs.len)):
            panic("typed_expr_frag_codec_statement_node_range_not_local")
        let rhsNodeIndex = frag.statements.rhsNodeIndexs[i]
        let forStartNodeIndex = frag.statements.forStartNodeIndexs[i]
        let assignLvalueNodeIndex =
            frag.statements.assignLvalueNodeIndexs[i]
        let assignIndexNodeIndex =
            frag.statements.assignIndexNodeIndexs[i]
        if rhsNodeIndex < -1 ||
           rhsNodeIndex >= frag.nodes.nodeIndexs.len ||
           forStartNodeIndex < -1 ||
           forStartNodeIndex >= frag.nodes.nodeIndexs.len ||
           assignLvalueNodeIndex < -1 ||
           assignLvalueNodeIndex >= frag.nodes.nodeIndexs.len ||
           assignIndexNodeIndex < -1 ||
           assignIndexNodeIndex >= frag.nodes.nodeIndexs.len:
            panic("typed_expr_frag_codec_statement_node_index_not_local")
        if frag.statements.kinds[i] ==
               int32(texpr.TypedExprIrStmtAssign):
            if assignLvalueNodeIndex < 0:
                panic("typed_expr_frag_codec_assignment_lvalue_missing")
            let lvalueOp = frag.nodes.opKinds[assignLvalueNodeIndex]
            if lvalueOp != int32(texpr.TypedExprIrOpLocalRef) &&
               lvalueOp != int32(texpr.TypedExprIrOpParamRef) &&
               lvalueOp != int32(texpr.TypedExprIrOpFieldGet) &&
               lvalueOp != int32(texpr.TypedExprIrOpIndexGet):
                panic("typed_expr_frag_codec_assignment_lvalue_not_writable")
            if lvalueOp == int32(texpr.TypedExprIrOpIndexGet):
                if assignIndexNodeIndex !=
                       frag.nodes.operand1NodeIndexs[
                           assignLvalueNodeIndex]:
                    panic("typed_expr_frag_codec_assignment_index_identity_mismatch")
        elif assignLvalueNodeIndex != -1:
            panic("typed_expr_frag_codec_non_assignment_lvalue_present")
        let bindingTargetDefinitionRow =
            frag.statements.bindingTargetDefinitionRows[i]
        if bindingTargetDefinitionRow < -1 ||
           bindingTargetDefinitionRow >= definitionCount:
            panic("typed_expr_frag_codec_statement_binding_target_invalid")
        let callTarget = frag.statements.callTargetIds[i]
        let callTargetSource = frag.statements.callTargetSourcePathIds[i]
        let callTargetSignatureLineNumber =
            frag.statements.callTargetSignatureLineNumbers[i]
        if (callTarget == "") != (callTargetSource == "") ||
           (frag.statements.callTargetImportcs[i] && callTarget == ""):
            panic("typed_expr_frag_codec_statement_call_owner_incomplete")
        if callTargetSignatureLineNumber < 0 ||
           (callTarget == "" && callTargetSignatureLineNumber != 0) ||
           (frag.statements.callTargetImportcs[i] &&
            callTargetSignatureLineNumber != 0):
            panic("typed_expr_frag_codec_statement_call_identity_invalid")
        let rhsIsDirectCall =
            rhsNodeIndex >= 0 &&
            frag.nodes.opKinds[rhsNodeIndex] ==
                int32(texpr.TypedExprIrOpCallExpr)
        if rhsIsDirectCall:
            if callTarget != frag.nodes.callTargetIds[rhsNodeIndex] ||
               callTargetSource !=
                   frag.nodes.callTargetSourcePathIds[rhsNodeIndex] ||
               callTargetSignatureLineNumber !=
                   frag.nodes.callTargetSignatureLineNumbers[
                       rhsNodeIndex] ||
               frag.statements.callTargetImportcs[i] !=
                   frag.nodes.callTargetImportcs[rhsNodeIndex]:
                panic("typed_expr_frag_codec_statement_direct_call_owner_mismatch")
        elif (frag.statements.kinds[i] ==
                  int32(texpr.TypedExprIrStmtLocalDecl) ||
              frag.statements.kinds[i] ==
                  int32(texpr.TypedExprIrStmtAssign) ||
              frag.statements.kinds[i] ==
                  int32(texpr.TypedExprIrStmtReturn)) &&
             (callTarget != "" || callTargetSource != "" ||
              callTargetSignatureLineNumber != 0 ||
              frag.statements.callTargetImportcs[i]):
            panic("typed_expr_frag_codec_non_call_statement_has_call_owner")
        if frag.statements.lineNumbers[i] <= 0 ||
           frag.statements.columnNumbers[i] <= 0 ||
           frag.statements.endLineNumbers[i] <= 0 ||
           frag.statements.endColumnNumbers[i] <= 0 ||
           !tefcPositionAtOrBefore(frag.statements.lineNumbers[i],
                                   frag.statements.columnNumbers[i],
                                   frag.statements.endLineNumbers[i],
                                   frag.statements.endColumnNumbers[i]):
            panic("typed_expr_frag_codec_statement_span_invalid")
        let lexicalScopeId = frag.statements.lexicalScopeIds[i]
        if lexicalScopeId < 0 || lexicalScopeId >= frag.scopeCount:
            panic("typed_expr_frag_codec_statement_lexical_scope_invalid")
        let statementOrdinal = frag.statements.statementOrdinals[i]
        if statementOrdinal >= 0:
            if statementOrdinal >= statementCount || ordinalRows[statementOrdinal] >= 0 ||
               frag.statements.lexicalOrdinals[i] < 0:
                panic("typed_expr_frag_codec_statement_ordinal_invalid")
            ordinalRows[statementOrdinal] = i
            structuredStatementCount = structuredStatementCount + 1
        elif frag.statements.lexicalOrdinals[i] >= 0:
            panic("typed_expr_frag_codec_lexical_ordinal_without_statement")
    for ordinal in 0..<structuredStatementCount:
        if ordinalRows[ordinal] < 0:
            panic("typed_expr_frag_codec_statement_ordinals_not_dense")

    var childCounts: int32[]
    setLen(childCounts, frag.scopeCount)
    for scopeIndex in 0..<frag.scopeCount:
        if frag.scopes.scopeIds[scopeIndex] != scopeIndex ||
           frag.scopes.startLineNumbers[scopeIndex] <= 0 ||
           frag.scopes.startColumnNumbers[scopeIndex] <= 0 ||
           frag.scopes.endLineNumbers[scopeIndex] <= 0 ||
           frag.scopes.endColumnNumbers[scopeIndex] <= 0 ||
           !tefcPositionAtOrBefore(frag.scopes.startLineNumbers[scopeIndex],
                                   frag.scopes.startColumnNumbers[scopeIndex],
                                   frag.scopes.endLineNumbers[scopeIndex],
                                   frag.scopes.endColumnNumbers[scopeIndex]):
            panic("typed_expr_frag_codec_scope_identity_or_span_invalid")
        let kind = frag.scopes.kinds[scopeIndex]
        if kind < int32(parser.NormalizedScopeRoot) ||
           kind > int32(parser.NormalizedScopeDeferSuite):
            panic("typed_expr_frag_codec_scope_kind_invalid")
        if scopeIndex == 0:
            if frag.scopes.parentScopeIds[scopeIndex] != -1 ||
               kind != int32(parser.NormalizedScopeRoot) ||
               frag.scopes.ownerStatementOrdinals[scopeIndex] != -1 ||
               frag.scopes.lexicalOrdinals[scopeIndex] != 0:
                panic("typed_expr_frag_codec_root_scope_invalid")
            continue
        let parentScopeId = frag.scopes.parentScopeIds[scopeIndex]
        if parentScopeId < 0 || parentScopeId >= scopeIndex ||
           frag.scopes.lexicalOrdinals[scopeIndex] != childCounts[parentScopeId] ||
           !tefcPositionAtOrBefore(frag.scopes.startLineNumbers[parentScopeId],
                                   frag.scopes.startColumnNumbers[parentScopeId],
                                   frag.scopes.startLineNumbers[scopeIndex],
                                   frag.scopes.startColumnNumbers[scopeIndex]) ||
           !tefcPositionAtOrBefore(frag.scopes.endLineNumbers[scopeIndex],
                                   frag.scopes.endColumnNumbers[scopeIndex],
                                   frag.scopes.endLineNumbers[parentScopeId],
                                   frag.scopes.endColumnNumbers[parentScopeId]):
            panic("typed_expr_frag_codec_child_scope_invalid")
        childCounts[parentScopeId] = childCounts[parentScopeId] + 1
        let ownerOrdinal = frag.scopes.ownerStatementOrdinals[scopeIndex]
        if ownerOrdinal >= 0:
            if ownerOrdinal >= structuredStatementCount || ordinalRows[ownerOrdinal] < 0 ||
               frag.statements.suiteScopeIds[ordinalRows[ownerOrdinal]] != scopeIndex:
                panic("typed_expr_frag_codec_scope_owner_invalid")

    for i in 0..<statementCount:
        let suiteScopeId = frag.statements.suiteScopeIds[i]
        let statementOrdinal = frag.statements.statementOrdinals[i]
        if suiteScopeId >= 0:
            if suiteScopeId >= frag.scopeCount || statementOrdinal < 0 ||
               frag.scopes.ownerStatementOrdinals[suiteScopeId] != statementOrdinal:
                panic("typed_expr_frag_codec_statement_suite_owner_invalid")
        let deferOwnerOrdinal = frag.statements.deferOwnerStatementOrdinals[i]
        if deferOwnerOrdinal >= 0:
            if deferOwnerOrdinal >= structuredStatementCount ||
               ordinalRows[deferOwnerOrdinal] < 0 ||
               frag.statements.kinds[ordinalRows[deferOwnerOrdinal]] !=
                   int32(texpr.TypedExprIrStmtDefer):
                panic("typed_expr_frag_codec_defer_owner_invalid")


@borrows
fn tefcEncodeBody(frag: TypedExprIrFunctionFragment): rawbytes.Bytes =
    TypedExprIrFunctionFragmentValidate(frag)
    var body: rawbytes.BytesBuilder = rawbytes.BytesBuilderNew(4096)
    tefcPutU32(body, 1)
    tefcPutStr(body, frag.sourcePath)
    tefcPutU32(body, 2)
    tefcPutStr(body, frag.functionName)
    TypedExprIrStatementsFragmentEncodeInto(body, frag.statements)
    TypedExprIrNodesFragmentEncodeInto(body, frag.nodes)
    TypedExprIrStatementsScopeColumnsEncodeInto(body, frag.statements)
    tefcPutU32(body, 88)
    tefcPutU32(body, frag.scopeStart)
    tefcPutU32(body, 89)
    tefcPutU32(body, frag.scopeCount)
    TypedExprIrScopesFragmentEncodeInto(body, frag.scopes)
    TypedExprIrCallIdentityColumnsEncodeInto(body,
                                             frag.statements,
                                             frag.nodes)
    TypedExprIrNodeFieldAlignColumnEncodeInto(body, frag.nodes)
    TypedExprIrOwnershipAuthorityEncodeInto(body, frag)
    TypedExprIrCompleteFunctionAuthorityEncodeInto(body, frag)
    return rawbytes.BytesBuilderFinish(body)

@borrows
fn tefcChecksumOf(bodyBytes: rawbytes.Bytes): rawbytes.Bytes =
    let digest: layout.FixedBytes32 = hash256.Sha256Fixed(layout.ByteSpanFromBytes(bodyBytes))
    return layout.FixedBytes32ToBytes(digest)

@borrows
fn TypedExprIrFunctionFragmentEncode(frag: TypedExprIrFunctionFragment): rawbytes.Bytes =
    var bodyBytes: rawbytes.Bytes = tefcEncodeBody(frag)
    var checksumBytes: rawbytes.Bytes = tefcChecksumOf(bodyBytes)
    var b: rawbytes.BytesBuilder = rawbytes.BytesBuilderNew(rawbytes.BytesLen(bodyBytes) + 64)
    tefcPutU32(b, typedExprFragCodecMagic)
    tefcPutU32(b, typedExprFragCodecFieldCount)
    rawbytes.BytesBuilderAppend(b, checksumBytes)
    rawbytes.BytesBuilderAppend(b, bodyBytes)
    rawbytes.BytesFree(checksumBytes)
    rawbytes.BytesFree(bodyBytes)
    return rawbytes.BytesBuilderFinish(b)

fn TypedExprIrFunctionFragmentDecode(buf: rawbytes.Bytes, cursor: var int32): TypedExprIrFunctionFragment =
    if tefcReadU32(buf, cursor) != typedExprFragCodecMagic:
        panic("typed_expr_frag_codec_bad_magic")
    if tefcReadU32(buf, cursor) != typedExprFragCodecFieldCount:
        panic("typed_expr_frag_codec_bad_field_count")
    if cursor < 0 || cursor + typedExprFragCodecChecksumSize > rawbytes.BytesLen(buf):
        panic("typed_expr_frag_codec_checksum_truncated")
    var checksumBytes: rawbytes.Bytes = rawbytes.BytesSlice(
        buf, cursor, typedExprFragCodecChecksumSize)
    cursor = cursor + typedExprFragCodecChecksumSize
    let bodyLen = rawbytes.BytesLen(buf) - cursor
    if bodyLen < 0:
        panic("typed_expr_frag_codec_checksum_truncated")
    let bodyView: rawbytes.Bytes = rawbytes.BytesSliceView(buf, cursor, bodyLen)
    var recomputedBytes: rawbytes.Bytes = tefcChecksumOf(bodyView)
    let checksumOk = rawbytes.BytesEqual(checksumBytes, recomputedBytes)
    rawbytes.BytesFree(checksumBytes)
    rawbytes.BytesFree(recomputedBytes)
    if !checksumOk:
        panic("typed_expr_frag_codec_checksum_mismatch")
    var frag: TypedExprIrFunctionFragment
    tefcExpectTag(buf, cursor, 1)
    frag.sourcePath = tefcReadStr(buf, cursor)
    tefcExpectTag(buf, cursor, 2)
    frag.functionName = tefcReadStr(buf, cursor)
    frag.statements = TypedExprIrStatementsFragmentDecodeFrom(buf, cursor)
    frag.nodes = TypedExprIrNodesFragmentDecodeFrom(buf, cursor)
    TypedExprIrStatementsScopeColumnsDecodeFrom(buf, cursor, frag.statements)
    tefcExpectTag(buf, cursor, 88)
    frag.scopeStart = tefcReadU32(buf, cursor)
    tefcExpectTag(buf, cursor, 89)
    frag.scopeCount = tefcReadU32(buf, cursor)
    frag.scopes = TypedExprIrScopesFragmentDecodeFrom(buf, cursor)
    TypedExprIrCallIdentityColumnsDecodeFrom(buf,
                                             cursor,
                                             frag.statements,
                                             frag.nodes)
    TypedExprIrNodeFieldAlignColumnDecodeFrom(buf, cursor, frag.nodes)
    TypedExprIrOwnershipAuthorityDecodeFrom(buf, cursor, frag)
    TypedExprIrCompleteFunctionAuthorityDecodeFrom(buf, cursor, frag)
    TypedExprIrFunctionFragmentValidate(frag)
    return frag

@borrows
fn TypedExprIrFunctionFragmentRoundTripAssert(frag: TypedExprIrFunctionFragment) =
    var enc1 = TypedExprIrFunctionFragmentEncode(frag)
    var cursor: int32
    let decoded = TypedExprIrFunctionFragmentDecode(enc1, cursor)
    if cursor != rawbytes.BytesLen(enc1):
        panic("typed_expr_frag_codec_roundtrip_trailing_bytes")
    var enc2 = TypedExprIrFunctionFragmentEncode(decoded)
    if !rawbytes.BytesEqual(enc1, enc2):
        panic("typed_expr_frag_codec_roundtrip_byte_mismatch")
    rawbytes.BytesFree(enc1)
    rawbytes.BytesFree(enc2)


@borrows
fn tefcLookupOrPanic(pool: langintern.InternPool, id: langintern.InternId): str =
    let res = langintern.LookupInternOwnedCopy(pool, id)
    if IsErr(res):
        panic("typed_expr_frag_codec_extract_invalid_intern_id")
    return Value(res)

fn tefcFunctionLocalOptionalNodeIndex(
        globalNodeIndex: int32,
        functionNodeStart: int32,
        functionNodeCount: int32): int32 =
    if globalNodeIndex == -1:
        return -1
    if globalNodeIndex < functionNodeStart ||
       globalNodeIndex >= functionNodeStart + functionNodeCount:
        panic("typed_expr_frag_codec_cross_function_node_index")
    return globalNodeIndex - functionNodeStart

fn tefcFunctionLocalNodeRangeStart(
        globalNodeStart: int32,
        rangeCount: int32,
        functionNodeStart: int32,
        functionNodeCount: int32): int32 =
    if rangeCount < 0:
        panic("typed_expr_frag_codec_node_range_count_negative")
    if rangeCount == 0 && globalNodeStart == -1:
        return -1
    if globalNodeStart < functionNodeStart ||
       globalNodeStart > functionNodeStart + functionNodeCount ||
       globalNodeStart + rangeCount >
           functionNodeStart + functionNodeCount:
        panic("typed_expr_frag_codec_cross_function_node_range")
    return globalNodeStart - functionNodeStart

@borrows
fn TypedExprIrExtractStatementsFragment(
        ir: texpr.TypedExprIr,
        start: int32,
        count: int32,
        functionNodeStart: int32,
        functionNodeCount: int32,
        functionDefinitionStart: int32,
        functionDefinitionCount: int32): TypedExprIrStatementsFragment =
    if start < 0 || count < 0 || start + count > ir.statements2_sourcePathIds.len:
        panic("typed_expr_frag_codec_extract_statements_out_of_bounds")
    var out: TypedExprIrStatementsFragment
    for i in 0..<count:
        let idx = start + i
        add(out.sourcePathIds, tefcLookupOrPanic(ir.internPool, ir.statements2_sourcePathIds[idx]))
        add(out.functionNameIds, tefcLookupOrPanic(ir.internPool, ir.statements2_functionNameIds[idx]))
        add(out.statementIndexs, i)
        add(out.lineNumbers, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineNumbers, idx))
        add(out.columnNumbers, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_columnNumbers, idx))
        add(out.endLineNumbers, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_endLineNumbers, idx))
        add(out.endColumnNumbers, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_endColumnNumbers, idx))
        add(out.lexicalScopeIds, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lexicalScopeIds, idx))
        add(out.suiteScopeIds, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_suiteScopeIds, idx))
        add(out.statementOrdinals, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_statementOrdinals, idx))
        add(out.lexicalOrdinals, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lexicalOrdinals, idx))
        add(out.deferOwnerStatementOrdinals, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_deferOwnerStatementOrdinals, idx))
        add(out.lineIndents, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_lineIndents, idx))
        add(out.enclosingIfLineNumbers, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_enclosingIfLineNumbers, idx))
        add(out.enclosingIfConditionTextIds, tefcLookupOrPanic(ir.internPool, ir.statements2_enclosingIfConditionTextIds[idx]))
        add(out.exprIdIds, tefcLookupOrPanic(ir.internPool, ir.statements2_exprIdIds[idx]))
        add(out.kinds, int32(ir.statements2_kinds[idx]))
        add(out.callKinds, int32(ir.statements2_callKinds[idx]))
        add(out.detailKinds, int32(ir.statements2_detailKinds[idx]))
        add(out.surfaceTextIds, tefcLookupOrPanic(ir.internPool, ir.statements2_surfaceTextIds[idx]))
        add(out.bindingNameIds, tefcLookupOrPanic(ir.internPool, ir.statements2_bindingNameIds[idx]))
        add(out.resultTypeIds, tefcLookupOrPanic(ir.internPool, ir.statements2_resultTypeIds[idx]))
        add(out.conditionKinds, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_conditionKinds, idx))
        add(out.conditionLhsTextIds, tefcLookupOrPanic(ir.internPool, ir.statements2_conditionLhsTextIds[idx]))
        add(out.conditionRhsTextIds, tefcLookupOrPanic(ir.internPool, ir.statements2_conditionRhsTextIds[idx]))
        add(out.conditionLiteralTextIds, tefcLookupOrPanic(ir.internPool, ir.statements2_conditionLiteralTextIds[idx]))
        add(out.assignRootNameIds, tefcLookupOrPanic(ir.internPool, ir.statements2_assignRootNameIds[idx]))
        add(out.assignRootTypeIds, tefcLookupOrPanic(ir.internPool, ir.statements2_assignRootTypeIds[idx]))
        add(out.assignRootSourcePathIds, tefcLookupOrPanic(ir.internPool, ir.statements2_assignRootSourcePathIds[idx]))
        add(out.assignRootGlobalFlags, ir.statements2_assignRootGlobalFlags[idx])
        add(out.assignPlaceKinds, int32(ir.statements2_assignPlaceKinds[idx]))
        add(out.assignFieldNameIds, tefcLookupOrPanic(ir.internPool, ir.statements2_assignFieldNameIds[idx]))
        add(out.assignFieldTypeIds, tefcLookupOrPanic(ir.internPool, ir.statements2_assignFieldTypeIds[idx]))
        add(out.assignFieldOffsetBytes, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_assignFieldOffsetBytes, idx))
        add(out.assignFieldSizeBytes, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_assignFieldSizeBytes, idx))
        add(out.assignFieldAlignBytes, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_assignFieldAlignBytes, idx))
        add(out.assignValueRootNameIds, tefcLookupOrPanic(ir.internPool, ir.statements2_assignValueRootNameIds[idx]))
        add(out.assignValueRootTypeIds, tefcLookupOrPanic(ir.internPool, ir.statements2_assignValueRootTypeIds[idx]))
        add(out.assignValueFieldNameIds, tefcLookupOrPanic(ir.internPool, ir.statements2_assignValueFieldNameIds[idx]))
        add(out.assignValueFieldTypeIds, tefcLookupOrPanic(ir.internPool, ir.statements2_assignValueFieldTypeIds[idx]))
        add(out.assignValueFieldOffsetBytes, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_assignValueFieldOffsetBytes, idx))
        add(out.assignValueFieldSizeBytes, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_assignValueFieldSizeBytes, idx))
        add(out.assignValueFieldAlignBytes, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_assignValueFieldAlignBytes, idx))
        add(out.assignValueOpKinds, int32(ir.statements2_assignValueOpKinds[idx]))
        add(out.assignValueLhsTextIds, tefcLookupOrPanic(ir.internPool, ir.statements2_assignValueLhsTextIds[idx]))
        add(out.assignValueRhsTextIds, tefcLookupOrPanic(ir.internPool, ir.statements2_assignValueRhsTextIds[idx]))
        add(out.assignValueRhsConsts, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_assignValueRhsConsts, idx))
        add(out.assignValueRhsHasConsts, ir.statements2_assignValueRhsHasConsts[idx])
        add(out.callQualifierIds, tefcLookupOrPanic(ir.internPool, ir.statements2_callQualifierIds[idx]))
        add(out.callCalleeIds, tefcLookupOrPanic(ir.internPool, ir.statements2_callCalleeIds[idx]))
        add(out.callTargetIds, tefcLookupOrPanic(ir.internPool, ir.statements2_callTargetIds[idx]))
        add(out.callTargetSourcePathIds, tefcLookupOrPanic(ir.internPool, ir.statements2_callTargetSourcePathIds[idx]))
        add(out.callTargetSignatureLineNumbers,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.statements2_callTargetSignatureLineNumbers,
                idx))
        add(out.callTargetImportcs, ir.statements2_callTargetImportcs[idx])
        add(out.callArgCounts, arenamod.ArenaArrayInt32Get(ir.arena, ir.statements2_callArgCounts, idx))
        add(out.callArgsTextIds, tefcLookupOrPanic(ir.internPool, ir.statements2_callArgsTextIds[idx]))
        add(out.callArgTypesTextIds, tefcLookupOrPanic(ir.internPool, ir.statements2_callArgTypesTextIds[idx]))
        add(out.valueExprCallNodeIndexes,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.statements2_valueExprCallNodeIndexes,
                idx))
        add(out.valueExprArgRootStarts,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.statements2_valueExprArgRootStarts,
                idx))
        add(out.valueExprArgRootCounts,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.statements2_valueExprArgRootCounts,
                idx))
        add(out.valueExprRootNodeIndexes,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.statements2_valueExprRootNodeIndexes,
                idx))
        add(out.valueExprSpanStarts,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.statements2_valueExprSpanStarts,
                idx))
        add(out.valueExprSpanEnds,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.statements2_valueExprSpanEnds,
                idx))
        add(out.valueExprStatementRoles,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.statements2_valueExprStatementRoles,
                idx))
        let callArgNodeCount = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.statements2_callArgNodeCounts, idx)
        add(out.callArgNodeStarts,
            tefcFunctionLocalNodeRangeStart(
                arenamod.ArenaArrayInt32Get(
                    ir.arena, ir.statements2_callArgNodeStarts, idx),
                callArgNodeCount,
                functionNodeStart,
                functionNodeCount))
        add(out.callArgNodeCounts, callArgNodeCount)
        add(out.rhsNodeIndexs,
            tefcFunctionLocalOptionalNodeIndex(
                arenamod.ArenaArrayInt32Get(
                    ir.arena, ir.statements2_rhsNodeIndexs, idx),
                functionNodeStart,
                functionNodeCount))
        add(out.rhsBailReasons, int32(ir.statements2_rhsBailReasons[idx]))
        add(out.callSurfaceKinds, int32(ir.statements2_callSurfaceKinds[idx]))
        add(out.forStartNodeIndexs,
            tefcFunctionLocalOptionalNodeIndex(
                arenamod.ArenaArrayInt32Get(
                    ir.arena, ir.statements2_forStartNodeIndexs, idx),
                functionNodeStart,
                functionNodeCount))
        add(out.assignLvalueNodeIndexs,
            tefcFunctionLocalOptionalNodeIndex(
                arenamod.ArenaArrayInt32Get(
                    ir.arena,
                    ir.statements2_assignLvalueNodeIndexs,
                    idx),
                functionNodeStart,
                functionNodeCount))
        add(out.assignIndexNodeIndexs,
            tefcFunctionLocalOptionalNodeIndex(
                arenamod.ArenaArrayInt32Get(
                    ir.arena, ir.statements2_assignIndexNodeIndexs, idx),
                functionNodeStart,
                functionNodeCount))
        # [wall72] 绑定目标定义行按 valueDefinitions 函数本地坐标重基
        # （与 nodes.bindingValueDefinitionRows 同一族）；越界即 fail-closed。
        let globalBindingTargetDefinition =
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.statements2_bindingTargetDefinitionRows,
                idx)
        var localBindingTargetDefinition: int32 = -1
        if globalBindingTargetDefinition >= 0:
            if globalBindingTargetDefinition < functionDefinitionStart ||
               globalBindingTargetDefinition >=
                   functionDefinitionStart + functionDefinitionCount:
                panic("typed_expr_frag_codec_statement_binding_target_not_local")
            localBindingTargetDefinition =
                globalBindingTargetDefinition - functionDefinitionStart
        add(out.bindingTargetDefinitionRows, localBindingTargetDefinition)
        add(out.loweringModes, int32(ir.statements2_loweringModes[idx]))
        add(out.returnKinds, int32(ir.statements2_returnKinds[idx]))
        add(out.returnRoots, ir.statements2_returnRoots[idx])
    return out

@borrows
fn TypedExprIrExtractNodesFragment(
        ir: texpr.TypedExprIr,
        start: int32,
        count: int32,
        statementStart: int32,
        statementCount: int32,
        definitionStart: int32,
        definitionCount: int32): TypedExprIrNodesFragment =
    if start < 0 || count < 0 || start + count > ir.nodes2_sourcePathIds.len:
        panic("typed_expr_frag_codec_extract_nodes_out_of_bounds")
    var out: TypedExprIrNodesFragment
    for i in 0..<count:
        let idx = start + i
        add(out.sourcePathIds, tefcLookupOrPanic(ir.internPool, ir.nodes2_sourcePathIds[idx]))
        add(out.functionNameIds, tefcLookupOrPanic(ir.internPool, ir.nodes2_functionNameIds[idx]))
        add(out.nodeIndexs, i)
        add(out.lineNumbers, arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_lineNumbers, idx))
        add(out.originParserNodeIds,
            arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_originParserNodeIds, idx))
        add(out.syntheticOriginKinds,
            arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_syntheticOriginKinds, idx))
        add(out.spanAuthorityKinds,
            arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_spanAuthorityKinds, idx))
        add(out.opKinds, int32(ir.nodes2_opKinds[idx]))
        add(out.exprClasses, int32(ir.nodes2_exprClasses[idx]))
        add(out.resultTypeProofKinds,
            arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_resultTypeProofKinds, idx))
        add(out.resultTypeManagedFlags,
            ir.nodes2_resultTypeManagedFlags[idx])
        add(out.resultTypeSendFlags,
            ir.nodes2_resultTypeSendFlags[idx])
        add(out.resultTypeSyncFlags,
            ir.nodes2_resultTypeSyncFlags[idx])
        let globalLastUseMoveValueDefId =
            arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_lastUseMoveValueDefIds, idx)
        if globalLastUseMoveValueDefId != -1:
            panic("typed_expr_frag_codec_last_use_move_producer_unavailable")
        add(out.lastUseMoveValueDefIds, -1)
        add(out.bindingParserProducerSourceIndexes,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_bindingParserProducerSourceIndexes,
                idx))
        add(out.bindingDeclarationSourceLocalRows,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_bindingDeclarationSourceLocalRows,
                idx))
        add(out.bindingPatternSourceLocalRows,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_bindingPatternSourceLocalRows,
                idx))
        let globalBindingDefinition =
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_bindingValueDefinitionRows,
                idx)
        var localBindingDefinition: int32 = -1
        if globalBindingDefinition >= 0:
            if globalBindingDefinition < definitionStart ||
               globalBindingDefinition >=
                   definitionStart + definitionCount:
                panic("typed_expr_frag_codec_binding_definition_not_local")
            localBindingDefinition =
                globalBindingDefinition - definitionStart
        add(out.bindingValueDefinitionRows,
            localBindingDefinition)
        let globalProducedDefinition =
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_producedValueDefinitionRows,
                idx)
        var localProducedDefinition: int32 = -1
        if globalProducedDefinition >= 0:
            if globalProducedDefinition < definitionStart ||
               globalProducedDefinition >=
                   definitionStart + definitionCount:
                panic("typed_expr_frag_codec_produced_definition_not_local")
            localProducedDefinition =
                globalProducedDefinition - definitionStart
        add(out.producedValueDefinitionRows,
            localProducedDefinition)
        let globalOwnerStatementIndex =
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_ownerStatementIndexes,
                idx)
        var localOwnerStatementIndex: int32 = -1
        if globalOwnerStatementIndex >= 0:
            if globalOwnerStatementIndex < statementStart ||
               globalOwnerStatementIndex >=
                   statementStart + statementCount:
                panic("typed_expr_frag_codec_node_owner_statement_not_local")
            localOwnerStatementIndex =
                globalOwnerStatementIndex - statementStart
        add(out.ownerStatementIndexes, localOwnerStatementIndex)
        add(out.structuralTypeIds,
            arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_structuralTypeIds, idx))
        add(out.resultTypeIds, tefcLookupOrPanic(ir.internPool, ir.nodes2_resultTypeIds[idx]))
        add(out.surfaceTextIds, tefcLookupOrPanic(ir.internPool, ir.nodes2_surfaceTextIds[idx]))
        add(out.paramSlots, arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_paramSlots, idx))
        add(out.paramNameIds, tefcLookupOrPanic(ir.internPool, ir.nodes2_paramNameIds[idx]))
        add(out.paramMutableFlags, ir.nodes2_paramMutableFlags[idx])
        add(out.operand0NodeIndexs,
            tefcFunctionLocalOptionalNodeIndex(
                arenamod.ArenaArrayInt32Get(
                    ir.arena, ir.nodes2_operand0NodeIndexs, idx),
                start, count))
        add(out.operand1NodeIndexs,
            tefcFunctionLocalOptionalNodeIndex(
                arenamod.ArenaArrayInt32Get(
                    ir.arena, ir.nodes2_operand1NodeIndexs, idx),
                start, count))
        add(out.operand2NodeIndexs,
            tefcFunctionLocalOptionalNodeIndex(
                arenamod.ArenaArrayInt32Get(
                    ir.arena, ir.nodes2_operand2NodeIndexs, idx),
                start, count))
        add(out.literalTextIds, tefcLookupOrPanic(ir.internPool, ir.nodes2_literalTextIds[idx]))
        add(out.callTargetIds,
            tefcLookupOrPanic(ir.internPool, ir.nodes2_callTargetIds[idx]))
        add(out.callTargetSourcePathIds,
            tefcLookupOrPanic(ir.internPool,
                              ir.nodes2_callTargetSourcePathIds[idx]))
        add(out.callTargetSignatureLineNumbers,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_callTargetSignatureLineNumbers,
                idx))
        add(out.callTargetImportcs, ir.nodes2_callTargetImportcs[idx])
        add(out.callKinds, int32(ir.nodes2_callKinds[idx]))
        add(out.callDeclarationIndexes,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_callDeclarationIndexes,
                idx))
        add(out.funcRefTargetDomains,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_funcRefTargetDomains,
                idx))
        add(out.funcRefCallDeclarationRows,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_funcRefCallDeclarationRows,
                idx))
        add(out.fieldTypeSourcePathIds,
            tefcLookupOrPanic(ir.internPool,
                              ir.nodes2_fieldTypeSourcePathIds[idx]))
        add(out.fieldOffsetBytes, arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_fieldOffsetBytes, idx))
        add(out.fieldSizeBytes, arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_fieldSizeBytes, idx))
        add(out.fieldAlignBytes, arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_fieldAlignBytes, idx))
        add(out.elemSizeBytes, arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_elemSizeBytes, idx))
    return out

@borrows
fn TypedExprIrExtractScopesFragment(ir: texpr.TypedExprIr,
                                     start: int32,
                                     count: int32): TypedExprIrScopesFragment =
    if start < 0 || count < 0 || start + count > ir.scopes2_scopeIds.len:
        panic("typed_expr_frag_codec_extract_scopes_out_of_bounds")
    var out: TypedExprIrScopesFragment
    for i in 0..<count:
        let idx = start + i
        add(out.scopeIds, arenamod.ArenaArrayInt32Get(ir.arena, ir.scopes2_scopeIds, idx))
        add(out.parentScopeIds, arenamod.ArenaArrayInt32Get(ir.arena, ir.scopes2_parentScopeIds, idx))
        add(out.kinds, int32(ir.scopes2_kinds[idx]))
        add(out.ownerStatementOrdinals, arenamod.ArenaArrayInt32Get(ir.arena, ir.scopes2_ownerStatementOrdinals, idx))
        add(out.lexicalOrdinals, arenamod.ArenaArrayInt32Get(ir.arena, ir.scopes2_lexicalOrdinals, idx))
        add(out.startLineNumbers, arenamod.ArenaArrayInt32Get(ir.arena, ir.scopes2_startLineNumbers, idx))
        add(out.startColumnNumbers, arenamod.ArenaArrayInt32Get(ir.arena, ir.scopes2_startColumnNumbers, idx))
        add(out.endLineNumbers, arenamod.ArenaArrayInt32Get(ir.arena, ir.scopes2_endLineNumbers, idx))
        add(out.endColumnNumbers, arenamod.ArenaArrayInt32Get(ir.arena, ir.scopes2_endColumnNumbers, idx))
    return out

@borrows
fn TypedExprIrExtractValueDefinitionFragments(
        ir: texpr.TypedExprIr,
        typedFunctionIndex: int32,
        nodeStart: int32,
        nodeCount: int32,
        definitionStart: int32,
        definitionCount: int32,
        groupStart: int32,
        groupCount: int32,
        definitionsOut: var TypedExprIrValueDefinitionsFragment,
        groupsOut: var TypedExprIrValueDefinitionGroupsFragment) =
    if definitionStart < 0 || definitionCount < 0 ||
       definitionStart + definitionCount >
           ir.valueDefinitions_producerSourceIndexes.len ||
       groupStart < 0 || groupCount < 0 ||
       groupStart + groupCount >
           ir.valueDefinitionGroups_producerSourceIndexes.len:
        panic("typed_expr_frag_codec_value_definition_group_range_invalid")
    for localDefinitionRow in 0..<definitionCount:
        let definitionRow =
            definitionStart + localDefinitionRow
        if arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitions_typedFunctionIndexes,
               definitionRow) != typedFunctionIndex:
            panic("typed_expr_frag_codec_value_definition_owner_invalid")
        let globalGroupRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitions_groupRows,
            definitionRow)
        var localGroupRow: int32 = -1
        if globalGroupRow >= 0:
            if globalGroupRow < groupStart ||
               globalGroupRow >= groupStart + groupCount:
                panic("typed_expr_frag_codec_value_definition_group_not_local")
            localGroupRow = globalGroupRow - groupStart
        add(definitionsOut.originKinds,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_originKinds,
                definitionRow))
        add(definitionsOut.producerSourceIndexes,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_producerSourceIndexes,
                definitionRow))
        add(definitionsOut.sourceLocalNodeIndexes,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_sourceLocalNodeIndexes,
                definitionRow))
        add(definitionsOut.declarationSourceLocalRows,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_declarationSourceLocalRows,
                definitionRow))
        add(definitionsOut.patternSourceLocalRows,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_patternSourceLocalRows,
                definitionRow))
        add(definitionsOut.typedFunctionIndexes, 0)
        add(definitionsOut.definingTypedNodeIndexes,
            tefcFunctionLocalOptionalNodeIndex(
                arenamod.ArenaArrayInt32Get(
                    ir.arena,
                    ir.valueDefinitions_definingTypedNodeIndexes,
                    definitionRow),
                nodeStart,
                nodeCount))
        add(definitionsOut.exactTypeIds,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_exactTypeIds,
                definitionRow))
        add(definitionsOut.ownerships,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_ownerships,
                definitionRow))
        add(definitionsOut.proofKinds,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_proofKinds,
                definitionRow))
        add(definitionsOut.groupRows, localGroupRow)
    for localGroupRow in 0..<groupCount:
        let groupRow = groupStart + localGroupRow
        let groupFunctionIndex = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitionGroups_typedFunctionIndexes,
            groupRow)
        let definitionRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.valueDefinitionGroups_definitionRows,
            groupRow)
        if groupFunctionIndex != typedFunctionIndex ||
           definitionRow < definitionStart ||
           definitionRow >= definitionStart + definitionCount ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitions_typedFunctionIndexes,
               definitionRow) != typedFunctionIndex ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.valueDefinitions_groupRows,
               definitionRow) != groupRow:
            panic("typed_expr_frag_codec_value_definition_identity_invalid")
        let definitionProducerSourceIndex =
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_producerSourceIndexes,
                definitionRow)
        let definitionDeclarationRow =
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_declarationSourceLocalRows,
                definitionRow)
        let definitionPatternRow =
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_patternSourceLocalRows,
                definitionRow)
        let groupProducerSourceIndex =
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitionGroups_producerSourceIndexes,
                groupRow)
        let groupDeclarationRow =
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitionGroups_declarationSourceLocalRows,
                groupRow)
        let groupPatternRow =
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitionGroups_patternSourceLocalRows,
                groupRow)
        if definitionProducerSourceIndex !=
               groupProducerSourceIndex ||
           definitionDeclarationRow != groupDeclarationRow ||
           definitionPatternRow != groupPatternRow:
            panic("typed_expr_frag_codec_value_definition_join_invalid")
        add(groupsOut.producerSourceIndexes,
            groupProducerSourceIndex)
        add(groupsOut.parserProducerSourceIndexes,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitionGroups_parserProducerSourceIndexes,
                groupRow))
        add(groupsOut.initializerRootSourceLocalNodeIndexes,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitionGroups_initializerRootSourceLocalNodeIndexes,
                groupRow))
        add(groupsOut.bindingOffsets,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitionGroups_bindingOffsets,
                groupRow))
        add(groupsOut.bindingCounts,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitionGroups_bindingCounts,
                groupRow))
        add(groupsOut.typedFunctionIndexes, 0)
        add(groupsOut.declarationSourceLocalRows, groupDeclarationRow)
        add(groupsOut.patternSourceLocalRows, groupPatternRow)
        add(groupsOut.definitionRows,
            definitionRow - definitionStart)
        add(groupsOut.consumedFlags,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitionGroups_consumedFlags,
                groupRow))

@borrows
fn TypedExprIrFunctionFragmentExtract(
        ir: texpr.TypedExprIr,
        typedFunctionIndex: int32): TypedExprIrFunctionFragment =
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >= ir.functions2_sourcePathIds.len ||
       typedFunctionIndex >= ir.functions2_functionNameIds.len ||
       typedFunctionIndex >= ir.functions2_resultExprClasses.len ||
       typedFunctionIndex >= ir.functions2_borrowsArguments.len ||
       typedFunctionIndex >= ir.functions2_statementStarts.len ||
       typedFunctionIndex >= ir.functions2_statementCounts.len ||
       typedFunctionIndex >= ir.functions2_scopeStarts.len ||
       typedFunctionIndex >= ir.functions2_scopeCounts.len ||
       typedFunctionIndex >= ir.functions2_nodeStarts.len ||
       typedFunctionIndex >= ir.functions2_nodeCounts.len ||
       typedFunctionIndex >= ir.functions2_signatureLineNumbers.len ||
       typedFunctionIndex >= ir.functions2_endLineNumbers.len ||
       typedFunctionIndex >= ir.functions2_bodyLineNumbers.len ||
       typedFunctionIndex >= ir.functions2_returnTypeIds.len ||
       typedFunctionIndex >= ir.functions2_returnExprIds.len ||
       typedFunctionIndex >= ir.functions2_returnNodeIndexs.len ||
       typedFunctionIndex >=
           ir.functions2_valueDefinitionStarts.len ||
       typedFunctionIndex >=
           ir.functions2_valueDefinitionCounts.len ||
       typedFunctionIndex >=
           ir.functions2_valueDefinitionGroupStarts.len ||
       typedFunctionIndex >=
           ir.functions2_valueDefinitionGroupCounts.len:
        panic("typed_expr_frag_codec_extract_function_row_invalid")
    let sourcePath = tefcLookupOrPanic(
        ir.internPool, ir.functions2_sourcePathIds[typedFunctionIndex])
    let functionName = tefcLookupOrPanic(
        ir.internPool, ir.functions2_functionNameIds[typedFunctionIndex])
    let statementStart = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.functions2_statementStarts, typedFunctionIndex)
    let statementCount = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.functions2_statementCounts, typedFunctionIndex)
    let scopeStart = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.functions2_scopeStarts, typedFunctionIndex)
    let scopeCount = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.functions2_scopeCounts, typedFunctionIndex)
    let nodeStart = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.functions2_nodeStarts, typedFunctionIndex)
    let nodeCount = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.functions2_nodeCounts, typedFunctionIndex)
    let definitionStart = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.functions2_valueDefinitionStarts,
        typedFunctionIndex)
    let definitionCount = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.functions2_valueDefinitionCounts,
        typedFunctionIndex)
    let groupStart = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.functions2_valueDefinitionGroupStarts,
        typedFunctionIndex)
    let groupCount = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.functions2_valueDefinitionGroupCounts,
        typedFunctionIndex)
    var out: TypedExprIrFunctionFragment
    out.sourcePath = sourcePath
    out.functionName = functionName
    out.signatureLineNumber = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.functions2_signatureLineNumbers,
        typedFunctionIndex)
    out.endLineNumber = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.functions2_endLineNumbers,
        typedFunctionIndex)
    out.bodyLineNumber = arenamod.ArenaArrayInt32Get(
        ir.arena,
        ir.functions2_bodyLineNumbers,
        typedFunctionIndex)
    let returnType = tefcLookupOrPanic(
        ir.internPool,
        ir.functions2_returnTypeIds[typedFunctionIndex])
    out.returnType = returnType
    let returnExpr = tefcLookupOrPanic(
        ir.internPool,
        ir.functions2_returnExprIds[typedFunctionIndex])
    out.returnExpr = returnExpr
    out.resultExprClass =
        int32(ir.functions2_resultExprClasses[typedFunctionIndex])
    out.borrowsArguments =
        ir.functions2_borrowsArguments[typedFunctionIndex]
    out.returnNodeIndex = tefcFunctionLocalOptionalNodeIndex(
        arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.functions2_returnNodeIndexs,
            typedFunctionIndex),
        nodeStart,
        nodeCount)
    out.scopeStart = 0
    out.scopeCount = scopeCount
    out.valueDefinitionCount = definitionCount
    out.valueDefinitionGroupCount = groupCount
    let valueDefinitionTypeArenaArtifactCid =
        layout.FixedBytes32Hex(
            ir.valueDefinitionTypeArenaArtifactCid)
    out.valueDefinitionTypeArenaArtifactCid =
        valueDefinitionTypeArenaArtifactCid
    let statements = TypedExprIrExtractStatementsFragment(
        ir, statementStart, statementCount, nodeStart, nodeCount,
        definitionStart, definitionCount)
    out.statements = statements
    let nodes = TypedExprIrExtractNodesFragment(
        ir,
        nodeStart,
        nodeCount,
        statementStart,
        statementCount,
        definitionStart,
        definitionCount)
    out.nodes = nodes
    let scopes =
        TypedExprIrExtractScopesFragment(ir, scopeStart, scopeCount)
    out.scopes = scopes
    TypedExprIrExtractValueDefinitionFragments(
        ir,
        typedFunctionIndex,
        nodeStart,
        nodeCount,
        definitionStart,
        definitionCount,
        groupStart,
        groupCount,
        out.valueDefinitions,
        out.valueDefinitionGroups)
    TypedExprIrFunctionFragmentValidate(out)
    return out

fn TypedExprFragReinternColumn(pool: langintern.InternPool, items: str[]): langintern.InternId[] =
    var out: langintern.InternId[]
    for i in 0..<items.len:
        add(out, langintern.Intern(pool, items[i]))
    return out
