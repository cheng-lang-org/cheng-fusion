        # 函数本地坐标；-1=无绑定目标定义身份）。
        bindingTargetDefinitionRows: int32[]
        loweringModes: int32[]
        returnKinds: int32[]
        returnRoots: bool[]

    TypedExprIrNodesFragment =
        sourcePathIds: str[]
        functionNameIds: str[]
        nodeIndexs: int32[]
        lineNumbers: int32[]
        originParserNodeIds: int32[]
        syntheticOriginKinds: int32[]
