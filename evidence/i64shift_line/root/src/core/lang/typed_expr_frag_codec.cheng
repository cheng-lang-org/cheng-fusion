@borrows
fn TypedExprIrCallIdentityColumnsEncodeInto(
        b: var rawbytes.BytesBuilder,
        statements: TypedExprIrStatementsFragment,
        nodes: TypedExprIrNodesFragment) =
    tefcPutI32Column(b, 99, statements.callTargetSignatureLineNumbers)
    tefcPutI32Column(b, 100, nodes.callTargetSignatureLineNumbers)

fn TypedExprIrCallIdentityColumnsDecodeFrom(
        buf: rawbytes.Bytes,
        cursor: var int32,
        statements: var TypedExprIrStatementsFragment,
        nodes: var TypedExprIrNodesFragment) =
    statements.callTargetSignatureLineNumbers =
        tefcReadI32Column(buf, cursor, 99)
    tefcRequireColumnLen(
        statements.callTargetSignatureLineNumbers.len,
        statements.sourcePathIds.len,
        "callTargetSignatureLineNumbers")
    nodes.callTargetSignatureLineNumbers =
        tefcReadI32Column(buf, cursor, 100)
    tefcRequireColumnLen(nodes.callTargetSignatureLineNumbers.len,
                         nodes.sourcePathIds.len,
                         "nodes.callTargetSignatureLineNumbers")

@borrows
fn TypedExprIrNodeFieldAlignColumnEncodeInto(
        b: var rawbytes.BytesBuilder,
        nodes: TypedExprIrNodesFragment) =
    tefcPutI32Column(b, 101, nodes.fieldAlignBytes)
    tefcPutStrColumn(b, 102, nodes.fieldTypeSourcePathIds)
    tefcPutI32Column(b, 103, nodes.exprClasses)

fn TypedExprIrNodeFieldAlignColumnDecodeFrom(
        buf: rawbytes.Bytes,
        cursor: var int32,
        nodes: var TypedExprIrNodesFragment) =
    nodes.fieldAlignBytes = tefcReadI32Column(buf, cursor, 101)
    tefcRequireColumnLen(nodes.fieldAlignBytes.len,
                         nodes.sourcePathIds.len,
                         "nodes.fieldAlignBytes")
    nodes.fieldTypeSourcePathIds = tefcReadStrColumn(buf, cursor, 102)
    tefcRequireColumnLen(nodes.fieldTypeSourcePathIds.len,
                         nodes.sourcePathIds.len,
                         "nodes.fieldTypeSourcePathIds")
    nodes.exprClasses = tefcReadI32Column(buf, cursor, 103)
    tefcRequireColumnLen(nodes.exprClasses.len,
                         nodes.sourcePathIds.len,
                         "nodes.exprClasses")

@borrows
fn TypedExprIrOwnershipAuthorityEncodeInto(
        b: var rawbytes.BytesBuilder,
        frag: TypedExprIrFunctionFragment) =
    tefcPutU32(b, 104)
    tefcPutU32(b, frag.resultExprClass)
    tefcPutI32Column(b, 105, frag.nodes.callDeclarationIndexes)

fn TypedExprIrOwnershipAuthorityDecodeFrom(
        buf: rawbytes.Bytes,
        cursor: var int32,
        frag: var TypedExprIrFunctionFragment) =
    tefcExpectTag(buf, cursor, 104)
    frag.resultExprClass = tefcReadU32(buf, cursor)
    frag.nodes.callDeclarationIndexes = tefcReadI32Column(buf, cursor, 105)
    tefcRequireColumnLen(frag.nodes.callDeclarationIndexes.len,
                         frag.nodes.sourcePathIds.len,
                         "nodes.callDeclarationIndexes")

@borrows
fn TypedExprIrCompleteFunctionAuthorityEncodeInto(
        b: var rawbytes.BytesBuilder,
        frag: TypedExprIrFunctionFragment) =
    tefcPutU32(b, 106)
    tefcPutU32(b, frag.signatureLineNumber)
    tefcPutU32(b, 107)
    tefcPutU32(b, frag.endLineNumber)
    tefcPutU32(b, 108)
    tefcPutU32(b, frag.bodyLineNumber)
    tefcPutU32(b, 109)
    tefcPutStr(b, frag.returnType)
    tefcPutU32(b, 110)
    tefcPutStr(b, frag.returnExpr)
    tefcPutU32(b, 111)
    tefcPutU32(b, frag.returnNodeIndex)
    tefcPutU32(b, 112)
    tefcPutU32(b, frag.valueDefinitionGroupCount)
    tefcPutI32Column(
        b, 113, frag.statements.valueExprCallNodeIndexes)
    tefcPutI32Column(
        b, 114, frag.statements.valueExprArgRootStarts)
    tefcPutI32Column(
        b, 115, frag.statements.valueExprArgRootCounts)
    tefcPutI32Column(
        b, 116, frag.statements.valueExprRootNodeIndexes)
    tefcPutI32Column(b, 117, frag.statements.valueExprSpanStarts)
    tefcPutI32Column(b, 118, frag.statements.valueExprSpanEnds)
    tefcPutI32Column(
        b, 119, frag.statements.valueExprStatementRoles)
    tefcPutI32Column(b, 120, frag.nodes.originParserNodeIds)
    tefcPutI32Column(b, 121, frag.nodes.syntheticOriginKinds)
    tefcPutI32Column(b, 122, frag.nodes.spanAuthorityKinds)
    tefcPutI32Column(b, 123, frag.nodes.resultTypeProofKinds)
    tefcPutBoolColumn(b, 124, frag.nodes.resultTypeManagedFlags)
    tefcPutBoolColumn(b, 125, frag.nodes.resultTypeSendFlags)
    tefcPutBoolColumn(b, 126, frag.nodes.resultTypeSyncFlags)
    tefcPutI32Column(
        b, 127, frag.valueDefinitions.producerSourceIndexes)
    tefcPutI32Column(
        b, 128, frag.valueDefinitions.declarationSourceLocalRows)
    tefcPutI32Column(
        b, 129, frag.valueDefinitions.patternSourceLocalRows)
    tefcPutI32Column(
        b, 130, frag.valueDefinitions.typedFunctionIndexes)
    tefcPutI32Column(
        b, 131, frag.valueDefinitions.definingTypedNodeIndexes)
    tefcPutI32Column(b, 132, frag.valueDefinitions.exactTypeIds)
    tefcPutI32Column(b, 133, frag.valueDefinitions.ownerships)
    tefcPutI32Column(b, 134, frag.valueDefinitions.proofKinds)
    tefcPutI32Column(
        b, 135, frag.valueDefinitionGroups.producerSourceIndexes)
    tefcPutI32Column(
        b, 136,
        frag.valueDefinitionGroups.parserProducerSourceIndexes)
    tefcPutI32Column(
        b, 137,
        frag.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes)
    tefcPutI32Column(
        b, 138, frag.valueDefinitionGroups.typedFunctionIndexes)
    tefcPutI32Column(
        b, 139,
        frag.valueDefinitionGroups.declarationSourceLocalRows)
    tefcPutI32Column(
        b, 140, frag.valueDefinitionGroups.patternSourceLocalRows)
    tefcPutI32Column(
        b, 141, frag.valueDefinitionGroups.definitionRows)
    tefcPutI32Column(
        b, 142, frag.valueDefinitionGroups.consumedFlags)
    tefcPutU32(b, 143)
    tefcPutStr(b, frag.valueDefinitionTypeArenaArtifactCid)
    tefcPutI32Column(b, 144, frag.nodes.structuralTypeIds)
    tefcPutI32Column(b, 145, frag.nodes.callKinds)
    tefcPutI32Column(b, 146, frag.nodes.lastUseMoveValueDefIds)
    tefcPutI32Column(
        b, 147, frag.nodes.bindingParserProducerSourceIndexes)
    tefcPutI32Column(
        b, 148, frag.nodes.bindingDeclarationSourceLocalRows)
    tefcPutI32Column(
        b, 149, frag.nodes.bindingPatternSourceLocalRows)
    tefcPutI32Column(
        b, 150, frag.nodes.bindingValueDefinitionRows)
    tefcPutI32Column(b, 151, frag.valueDefinitions.groupRows)
    tefcPutI32Column(
        b, 152, frag.nodes.producedValueDefinitionRows)
    tefcPutI32Column(b, 153, frag.valueDefinitions.originKinds)
    tefcPutI32Column(
        b, 154, frag.valueDefinitions.sourceLocalNodeIndexes)
    tefcPutU32(b, 155)
    tefcPutU32(b, frag.valueDefinitionCount)
    tefcPutI32Column(
        b, 156, frag.valueDefinitionGroups.bindingOffsets)
    tefcPutI32Column(
        b, 157, frag.valueDefinitionGroups.bindingCounts)
    tefcPutI32Column(
        b, 158, frag.nodes.ownerStatementIndexes)
    tefcPutBoolColumn(
        b, 159, frag.nodes.paramMutableFlags)
    # Trailing extension: preserve the shipped 3..159 tag layout.
    tefcPutI32Column(
        b, 160, frag.statements.assignLvalueNodeIndexs)
    tefcPutI32Column(
        b, 161, frag.nodes.funcRefTargetDomains)
    tefcPutI32Column(
        b, 162, frag.nodes.funcRefCallDeclarationRows)
    tefcPutI32Column(
        b, 163, frag.statements.bindingTargetDefinitionRows)
    tefcPutU32(b, 164)
    tefcPutU32(b, frag.borrowsArguments ? 1 : 0)

fn TypedExprIrCompleteFunctionAuthorityDecodeFrom(
        buf: rawbytes.Bytes,
        cursor: var int32,
        frag: var TypedExprIrFunctionFragment) =
    tefcExpectTag(buf, cursor, 106)
    frag.signatureLineNumber = tefcReadU32(buf, cursor)
    tefcExpectTag(buf, cursor, 107)
    frag.endLineNumber = tefcReadU32(buf, cursor)
    tefcExpectTag(buf, cursor, 108)
    frag.bodyLineNumber = tefcReadU32(buf, cursor)
    tefcExpectTag(buf, cursor, 109)
    frag.returnType = tefcReadStr(buf, cursor)
    tefcExpectTag(buf, cursor, 110)
    frag.returnExpr = tefcReadStr(buf, cursor)
    tefcExpectTag(buf, cursor, 111)
    frag.returnNodeIndex = tefcReadU32(buf, cursor)
    tefcExpectTag(buf, cursor, 112)
    frag.valueDefinitionGroupCount = tefcReadU32(buf, cursor)
    let statementCount = frag.statements.sourcePathIds.len
    frag.statements.valueExprCallNodeIndexes =
        tefcReadI32Column(buf, cursor, 113)
    tefcRequireColumnLen(
        frag.statements.valueExprCallNodeIndexes.len,
